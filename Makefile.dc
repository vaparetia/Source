    $(ENG)/System/CSyncEvent.cpp \
    $(ENG)/System/CSystemVar.cpp \
    $(ENG)/System/CTaskQueue.cpp \
    $(ENG)/System/CThread.cpp \
    $(ENG)/System/DCCOsContext.cpp \
    $(ENG)/System/DCCStopWatch.cpp \
    $(ENG)/System/DCCSyncCriticalSection.cpp \
    \
    $(ENG)/Math/CAxisAngle.cpp \
    $(ENG)/Math/CFilteredRandom.cpp \
    $(ENG)/Math/CHalfFloat.cpp \
