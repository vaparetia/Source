    $(ENG)/Resource/CResourceManager.cpp \
    $(ENG)/Resource/CResourcePool.cpp \
    $(ENG)/Resource/IResourcePool.cpp \
    \
    $(ENG)/Streams/CDiskInputStream.cpp \
    $(ENG)/Streams/CDiskOutputStream.cpp \
