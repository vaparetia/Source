    $(RND)/Frontend/CRenderViewport.cpp \
    $(RND)/Frontend/RenderObject/CDrawableMasterRenderEntity.cpp \
    $(RND)/Frontend/RenderObject/CDrawableRenderEntity.cpp \
    $(RND)/Frontend/RenderObject/CLightRenderEntity.cpp \
    $(RND)/Frontend/RenderObject/CMeshChunkRenderEntity.cpp \
    $(RND)/Frontend/RenderObject/CMeshRenderEntity.cpp \
    $(RND)/Frontend/RenderObject/CRenderBounds.cpp \
    $(RND)/Frontend/RenderObject/CRenderObject.cpp \
    \
    $(RND)/Material/CCompiledShaderCache.cpp \
    $(RND)/Material/CCompiledShaderCacheTypes.cpp \
    $(RND)/Material/ProgShader/CShaderParameterBuffer.cpp \
    $(RND)/Material/ProgShader/PSCShader.cpp \
    $(RND)/Material/ProgShader/PSCShader_Factory.cpp \
    $(RND)/Material/ProgShader/Shaders/CUnlitGeneric.cpp \
    $(RND)/Material/ProgShader/Shaders/CVertexLitGeneric.cpp \
    $(RND)/Material/ProgShader/Shaders/PSCDefaultShader.cpp \
    $(RND)/Material/ProgShader/Shaders/PSCMovieShader.cpp \
    $(RND)/Material/ProgShader/Shaders/PSShaderHelpers.cpp \
    \
    $(RND)/Primitive/CMesh.cpp \
    $(RND)/Primitive/CMeshBuffers.cpp \
    $(RND)/Primitive/CMeshChunk.cpp \
    $(RND)/Primitive/CSkinnedMesh.cpp \
    $(RND)/Primitive/ProgShader/PSCMesh.cpp \
    $(RND)/Primitive/ProgShader/PSCMeshBuffers.cpp \
    $(RND)/Primitive/ProgShader/PSCMeshChunk.cpp \
    $(RND)/Primitive/ProgShader/PSCSkinnedMesh.cpp \
    \
    $(RND)/ShaderObjects/CGameObjectComponentPropertiesShader.cpp \
    $(RND)/ShaderObjects/CShaderObjectFactory.cpp \
    $(RND)/ShaderObjects/Properties/PropertiesClasses.cpp \
    $(RND)/ShaderObjects/Shader/ICGLdrShader.cpp \
    \
    $(RND)/CDebugDraw.cpp \
    $(RND)/CMTXFont.cpp

# -----------------------------------------------------------------------
# Object file list
# -----------------------------------------------------------------------
ALL_SRCS := $(ENG_SRCS) $(RND_SRCS)
OBJS     := $(patsubst $(CURDIR)/%.cpp,$(OBJDIR)/%.o,$(ALL_SRCS))

# -----------------------------------------------------------------------
# Targets
# -----------------------------------------------------------------------
# -----------------------------------------------------------------------
# Host syntax-check — uses system g++ instead of sh-elf cross-compiler.
# No SH-4 binaries produced; catches C++ type errors across the whole tree.
# -----------------------------------------------------------------------
MOCK_KOS  := $(CURDIR)/build/kos_mock
HC_INCS   := -I$(MOCK_KOS) -I$(BPE_ROOT)/Source -I$(BPE_ROOT)/Source/Engine \
             -I$(BPE_ROOT)/Source/ExtLibraries/Boost/include
HC_DEFS   := -D__DREAMCAST__ -DMGS_VERSION=2 -DENGINE_EXPORTS -DRENDERER_EXPORTS
HC_FLAGS  := -std=c++14 -fsyntax-only -w -Wno-deprecated $(HC_INCS) $(HC_DEFS)

.PHONY: all clean compile-check host-check

all: $(TARGET)

# Phase 1 convenience: just compile, don't link (catches errors faster)
compile-check: $(OBJS)
	@echo "Compile check passed: $(words $(OBJS)) translation units OK"

$(TARGET): $(OBJS)
	$(CXX) $(KOS_LDFLAGS) -o $@ $(OBJS) $(KOS_LIBS)
	$(OBJCOPY) -R .stack -O binary $@ $(TARGET:.elf=.bin)
	@echo "Built $(TARGET)"

$(OBJDIR)/%.o: $(CURDIR)/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -MMD -MP -c $< -o $@

# Pull in generated dependency files
-include $(OBJS:.o=.d)

host-check:
	@echo "Running host syntax-check with system g++ ($(words $(ALL_SRCS)) files)..."
	@fail=0; \
	for f in $(ALL_SRCS); do \
	    g++ $(HC_FLAGS) $$f 2>&1 | sed "s|^|$$f: |"; \
	    [ $${PIPESTATUS[0]} -eq 0 ] || fail=1; \
	done; \
	[ $$fail -eq 0 ] && echo "Host syntax-check passed." || { echo "Host syntax-check FAILED."; exit 1; }

clean:
	rm -rf $(OBJDIR) $(TARGET) $(TARGET:.elf=.bin)
	@echo "Clean done"
