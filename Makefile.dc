# Makefile.dc — KallistiOS build for the MGS2 Dreamcast port
#
# Prerequisites:
#   A working KallistiOS toolchain with environ.sh sourced, e.g.:
#     source /opt/toolchains/dc/kos/environ.sh
#
# Usage:
#   make -f Makefile.dc          # build
#   make -f Makefile.dc clean    # clean
#
# Phase 1 goal: Engine + Renderer layers compile clean for sh-elf-g++.
# Game logic (bp/shared, mgs2x/) is added in Phase 2+.

TARGET  := mgs2dc.elf
OBJDIR  := build/dc
BPE_ROOT := $(CURDIR)/bp

# -----------------------------------------------------------------------
# Compiler — provided by KOS environ.sh
# -----------------------------------------------------------------------
CXX     := $(KOS_CCPLUS)
CC      := $(KOS_CC)
OBJCOPY := $(KOS_OBJCOPY)

# -----------------------------------------------------------------------
# Flags
# -----------------------------------------------------------------------
INCS := \
    -I$(BPE_ROOT)/Source \
    -I$(BPE_ROOT)/Source/Engine \
    -I$(BPE_ROOT)/Source/ExtLibraries/Boost/include

DEFS := \
    -DMGS_VERSION=2 \
    -DENGINE_EXPORTS \
    -DRENDERER_EXPORTS

# KOS_CFLAGS contains the SH-4 target flags (-ml -m4-single -O2 etc.) set by environ.sh.
# KOS uses a single KOS_CFLAGS for both C and C++; we add -fno-exceptions -fno-rtti here.
# -w suppresses warnings from the engine codebase (not our Dreamcast stubs) for Phase 1.
CXXFLAGS := $(KOS_CFLAGS) -fno-exceptions -fno-rtti -w $(INCS) $(DEFS)
CFLAGS   := $(KOS_CFLAGS) -w $(INCS) $(DEFS)

# -----------------------------------------------------------------------
# Engine sources
# -----------------------------------------------------------------------
ENG := $(BPE_ROOT)/Source/Engine

ENG_SRCS := \
