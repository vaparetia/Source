    $(ENG)/Basics/CEventLog.cpp \
    $(ENG)/Basics/CStringExtras.cpp \
    \
    $(ENG)/System/CDirList.cpp \
    $(ENG)/System/CFileUtils.cpp \
    $(ENG)/System/CGuid.cpp \
    $(ENG)/System/COsContext.cpp \
    $(ENG)/System/CProfileMarker.cpp \
    $(ENG)/System/CStopWatch.cpp \
    $(ENG)/System/CSyncEvent.cpp \
    $(ENG)/System/CSystemVar.cpp \
    $(ENG)/System/CTaskQueue.cpp \
    $(ENG)/System/CThread.cpp \
    $(ENG)/System/DCCOsContext.cpp \
    $(ENG)/System/DCCStopWatch.cpp \
    $(ENG)/System/DCCSyncCriticalSection.cpp \
    \
    $(ENG)/Math/CAxisAngle.cpp \
    $(ENG)/Math/CFilteredRandom.cpp \
    $(ENG)/Math/CHalfFloat.cpp \
    $(ENG)/Math/CMatrix34.cpp \
    $(ENG)/Math/CMatrix3.cpp \
    $(ENG)/Math/CMatrix4.cpp \
    $(ENG)/Math/CMayaSpline.cpp \
    $(ENG)/Math/CPerlinNoise.cpp \
    $(ENG)/Math/CQuaternion.cpp \
    $(ENG)/Math/CRandom.cpp \
    $(ENG)/Math/CSpline.cpp \
    $(ENG)/Math/CVector2.cpp \
    $(ENG)/Math/CVector3.cpp \
    $(ENG)/Math/CVector4.cpp \
    $(ENG)/Math/MathUtils.cpp \
    $(ENG)/Math/NEulerAngles.cpp \
    \
    $(ENG)/Graphics/CColor.cpp \
    $(ENG)/Graphics/CColorf.cpp \
    $(ENG)/Graphics/CFrustumPlanes.cpp \
    $(ENG)/Graphics/CIndexArray.cpp \
    $(ENG)/Graphics/CLight.cpp \
    $(ENG)/Graphics/CMatrixStack.cpp \
    $(ENG)/Graphics/CSphericalHarmonics.cpp \
    $(ENG)/Graphics/CSphericalHarmonics3.cpp \
    $(ENG)/Graphics/CSphericalHarmonicsHelper.cpp \
    $(ENG)/Graphics/CTextureUtil.cpp \
    $(ENG)/Graphics/CVertexArray.cpp \
    \
    $(ENG)/Memory/CMemoryAllocator.cpp \
    \
    $(ENG)/Mechanics/CCRC.cpp \
    $(ENG)/Mechanics/CStringTable.cpp \
    $(ENG)/Mechanics/HashUtils.cpp \
    $(ENG)/Mechanics/TinyXml/tinystr.cpp \
    $(ENG)/Mechanics/TinyXml/tinyxml.cpp \
    $(ENG)/Mechanics/TinyXml/tinyxmlerror.cpp \
    $(ENG)/Mechanics/TinyXml/tinyxmlparser.cpp \
    \
    $(ENG)/Resource/CBaseResourceFactoryLoadItem.cpp \
    $(ENG)/Resource/CResId.cpp \
    $(ENG)/Resource/CResourceCache.cpp \
    $(ENG)/Resource/CResourceFactory.cpp \
    $(ENG)/Resource/CResourceManager.cpp \
    $(ENG)/Resource/CResourcePool.cpp \
    $(ENG)/Resource/IResourcePool.cpp \
    \
    $(ENG)/Streams/CDiskInputStream.cpp \
    $(ENG)/Streams/CDiskOutputStream.cpp \
    $(ENG)/Streams/CGrowableMemoryOutStream.cpp \
    $(ENG)/Streams/CInputStream.cpp \
    $(ENG)/Streams/CLabeledOffsetStream.cpp \
    $(ENG)/Streams/CLinearCopyStream.cpp \
    $(ENG)/Streams/CMemoryInputStream.cpp \
    $(ENG)/Streams/COutputStream.cpp \
    \
    $(ENG)/Collision/CCollisionMesh.cpp \
    \
    $(ENG)/Primitives/BPEIntersection.cpp \
    $(ENG)/Primitives/CAABox.cpp \
    \
    $(ENG)/GameObjectSystem/CBaseGameManager.cpp \
    $(ENG)/GameObjectSystem/CGameObject.cpp \
    $(ENG)/GameObjectSystem/CGameObjectComponent.cpp \
    $(ENG)/GameObjectSystem/CGameObjectComponentProperties.cpp \
    $(ENG)/GameObjectSystem/CGameObjectDebugLog.cpp \
    $(ENG)/GameObjectSystem/CGameObjectGlobalData.cpp \
    $(ENG)/GameObjectSystem/CGameObjectMessage.cpp \
    $(ENG)/GameObjectSystem/CGameObjectMessageHandler.cpp \
    $(ENG)/GameObjectSystem/CGameObjectMessageProperties.cpp \
    $(ENG)/GameObjectSystem/CGameObjectProperties.cpp \
    $(ENG)/GameObjectSystem/CGameObjectPropertiesPackage.cpp \
    $(ENG)/GameObjectSystem/CGameObjectPropertiesPackageEntry.cpp \
    $(ENG)/GameObjectSystem/CGameObjectRegisteredComponentGroupObjectFactories.cpp \
    $(ENG)/GameObjectSystem/CGameObjectRegisteredMessageObjectFactories.cpp \
    $(ENG)/GameObjectSystem/CObjectList.cpp \
    $(ENG)/GameObjectSystem/GameObjectUtils.cpp \
    $(ENG)/GameObjectSystem/TGameObjectTypes.cpp \
    \
    $(ENG)/Input/CInputGenerator.cpp \
    \
    $(ENG)/Evaluators/IEvaluator.cpp

# -----------------------------------------------------------------------
# Renderer sources
# -----------------------------------------------------------------------
RND := $(BPE_ROOT)/Source/Renderer/Base

RND_SRCS := \
    $(RND)/StdAfx.cpp \
    \
    $(RND)/Backend/CRenderBackend.cpp \
    $(RND)/Backend/CRenderHWAllocator.cpp \
    $(RND)/Backend/CTexture.cpp \
    $(RND)/Backend/DC/DCCRenderBackend.cpp \
    $(RND)/Backend/DC/DCCTexture.cpp \
    \
    $(RND)/Frontend/CLightState.cpp \
    $(RND)/Frontend/CRenderer.cpp \
    $(RND)/Frontend/CRenderViewport.cpp \
    $(RND)/Frontend/RenderObject/CDrawableMasterRenderEntity.cpp \
    $(RND)/Frontend/RenderObject/CDrawableRenderEntity.cpp \
    $(RND)/Frontend/RenderObject/CLightRenderEntity.cpp \
    $(RND)/Frontend/RenderObject/CMeshChunkRenderEntity.cpp \
    $(RND)/Frontend/RenderObject/CMeshRenderEntity.cpp \
    $(RND)/Frontend/RenderObject/CRenderBounds.cpp \
    $(RND)/Frontend/RenderObject/CRenderObject.cpp \
    \
    $(RND)/Material/CCompiledShaderCache.cpp \
    $(RND)/Material/CCompiledShaderCacheTypes.cpp \
    $(RND)/Material/ProgShader/CShaderParameterBuffer.cpp \
    $(RND)/Material/ProgShader/PSCShader.cpp \
    $(RND)/Material/ProgShader/PSCShader_Factory.cpp \
    $(RND)/Material/ProgShader/Shaders/PSCDefaultShader.cpp \
    $(RND)/Material/ProgShader/Shaders/PSCMovieShader.cpp \
    $(RND)/Material/ProgShader/Shaders/PSShaderHelpers.cpp \
    \
    $(RND)/Primitive/CMesh.cpp \
    $(RND)/Primitive/CMeshBuffers.cpp \
    $(RND)/Primitive/CMeshChunk.cpp \
    $(RND)/Primitive/CSkinnedMesh.cpp \
    $(RND)/Primitive/ProgShader/PSCMesh.cpp \
    $(RND)/Primitive/ProgShader/PSCMeshBuffers.cpp \
    $(RND)/Primitive/ProgShader/PSCMeshChunk.cpp \
    \
    $(RND)/ShaderObjects/CGameObjectComponentPropertiesShader.cpp \
    $(RND)/ShaderObjects/CShaderObjectFactory.cpp \
    $(RND)/ShaderObjects/Properties/PropertiesClasses.cpp \
    $(RND)/ShaderObjects/Shader/ICGLdrShader.cpp \
    $(RND)/ShaderObjects/Shader/CCPLdrShaderDefaultShader.cpp \
    \
    $(RND)/CDebugDraw.cpp \
    $(RND)/CMTXFont.cpp

# -----------------------------------------------------------------------
# DC platform entry point (cross-compile only; excluded from host-check
# because it includes <kos.h> which is not available on the host)
# -----------------------------------------------------------------------
DC_MAIN_SRC := $(ENG)/System/DC/DCMain.cpp
DC_MAIN_OBJ := $(patsubst $(CURDIR)/%.cpp,$(OBJDIR)/%.o,$(DC_MAIN_SRC))

# -----------------------------------------------------------------------
# Zlib C sources (compiled with CC; excluded from host-check)
# -----------------------------------------------------------------------
ZLIB := $(ENG)/Mechanics/zlib

ZLIB_SRCS := \
    $(ZLIB)/adler32.c \
    $(ZLIB)/compress.c \
    $(ZLIB)/crc32.c \
    $(ZLIB)/deflate.c \
    $(ZLIB)/infback.c \
    $(ZLIB)/inffast.c \
    $(ZLIB)/inflate.c \
    $(ZLIB)/inftrees.c \
    $(ZLIB)/trees.c \
    $(ZLIB)/uncompr.c \
    $(ZLIB)/zutil.c

ZLIB_OBJS := $(patsubst $(CURDIR)/%.c,$(OBJDIR)/%.o,$(ZLIB_SRCS))

# -----------------------------------------------------------------------
# Object file lists
# ALL_SRCS / OBJS  — C++ engine+renderer sources (used by host-check + compile-check)
# ALL_LINK_OBJS    — everything that goes into the linked ELF
# -----------------------------------------------------------------------
ALL_SRCS := $(ENG_SRCS) $(RND_SRCS)
OBJS     := $(patsubst $(CURDIR)/%.cpp,$(OBJDIR)/%.o,$(ALL_SRCS))

ALL_LINK_OBJS := $(OBJS) $(DC_MAIN_OBJ) $(ZLIB_OBJS)

# -----------------------------------------------------------------------
# Targets
# -----------------------------------------------------------------------
# -----------------------------------------------------------------------
# Host syntax-check — uses system g++ instead of sh-elf cross-compiler.
# No SH-4 binaries produced; catches C++ type errors across the whole tree.
# -----------------------------------------------------------------------
MOCK_KOS  := $(CURDIR)/build/kos_mock
HC_INCS   := -I$(MOCK_KOS) -I$(BPE_ROOT)/Source -I$(BPE_ROOT)/Source/Engine \
             -I$(BPE_ROOT)/Source/ExtLibraries/Boost/include
HC_DEFS   := -D__DREAMCAST__ -DMGS_VERSION=2 -DENGINE_EXPORTS -DRENDERER_EXPORTS
HC_FLAGS  := -std=c++14 -fsyntax-only -w -Wno-deprecated $(HC_INCS) $(HC_DEFS)

# -----------------------------------------------------------------------
# Docker build — Phase 2 cross-compilation inside KallistiOS toolchain image.
# Avoids the GCC 16 / safe-ctype.h conflict on Fedora 44: the container
# runs Ubuntu 22.04 with GCC 11 as the host compiler.
#
# One-time image build (30-60 min):
#   docker build -f Dockerfile.kos -t mgs2-dreamcast-sdk .
# -----------------------------------------------------------------------
DC_IMAGE  := mgs2-dreamcast-sdk
DC_ENV    := source /opt/toolchains/dc/kos/environ.sh
DC_RUN    := docker run --volume=$(CURDIR):/work:z --userns=keep-id --rm $(DC_IMAGE)

# -----------------------------------------------------------------------
# Flycast emulator (load ELF directly — no disc image needed)
# -----------------------------------------------------------------------
FLYCAST := $(HOME)/Downloads/flycast-x86_64.AppImage

# -----------------------------------------------------------------------
# GDI disc image for USB-GDROM hardware testing
# Requires image rebuilt after Dockerfile.kos disc-tools additions:
#   docker build -f Dockerfile.kos -t mgs2-dreamcast-sdk .
# -----------------------------------------------------------------------
DISC_DIR := $(CURDIR)/build/disc

.PHONY: all clean compile-check host-check flycast \
        docker-build docker-clean docker-shell docker-image-check docker-link \
        docker-disc disc-gdi-finalize

all: $(TARGET)

# Phase 2: compile all C++ engine+renderer sources for SH4 (no link)
compile-check: $(OBJS)
	@echo "Compile check passed: $(words $(OBJS)) translation units OK"

# Phase 3: full link into a KOS ELF (includes zlib + DCMain entry point)
# DC_LIBS adds -lstdc++ to KOS's group for std::string, operator new/delete,
# __cxa_guard_acquire/release, and std::_Rb_tree_* used by the engine.
DC_LIBS := -Wl,--start-group -lstdc++ -lkallisti -lm -lc -lgcc -Wl,--end-group

$(TARGET): $(ALL_LINK_OBJS)
	$(CXX) $(KOS_LDFLAGS) -o $@ $(ALL_LINK_OBJS) $(DC_LIBS)
	$(OBJCOPY) -R .stack -O binary $@ $(TARGET:.elf=.bin)
	@echo "Built $(TARGET)"

$(OBJDIR)/%.o: $(CURDIR)/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -MMD -MP -c $< -o $@

# C sources (zlib) — compiled with CC, same KOS flags
$(OBJDIR)/%.o: $(CURDIR)/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -MMD -MP -c $< -o $@

# Pull in generated dependency files
-include $(ALL_LINK_OBJS:.o=.d)

host-check:
	@echo "Running host syntax-check with system g++ ($(words $(ALL_SRCS)) files)..."
	@fail=0; \
	for f in $(ALL_SRCS); do \
	    g++ $(HC_FLAGS) $$f 2>&1 | sed "s|^|$$f: |"; \
	    [ $${PIPESTATUS[0]} -eq 0 ] || fail=1; \
	done; \
	[ $$fail -eq 0 ] && echo "Host syntax-check passed." || { echo "Host syntax-check FAILED."; exit 1; }

clean:
	rm -rf $(OBJDIR) $(TARGET) $(TARGET:.elf=.bin)
	@echo "Clean done"

# Compile all engine sources for SH4 inside the KOS container.
# Requires the image to be built first (docker build -f Dockerfile.kos -t $(DC_IMAGE) .)
docker-build: docker-image-check
	$(DC_RUN) bash -c "$(DC_ENV) && make -j$$(nproc) -f /work/Makefile.dc compile-check"

docker-clean: docker-image-check
	$(DC_RUN) bash -c "make -f /work/Makefile.dc clean"

# Drop into a shell with the full KOS environment active.
# Sources environ.sh so KOS_CCPLUS, KOS_CFLAGS, etc. are all set.
docker-shell: docker-image-check
	docker run --volume=$(CURDIR):/work:z --userns=keep-id --rm -it $(DC_IMAGE) \
	    bash -c "$(DC_ENV) && cd /work && exec bash"

# Attempt a full link inside the KOS container to expose undefined symbols.
docker-link: docker-image-check
	$(DC_RUN) bash -c "$(DC_ENV) && make -j$$(nproc) -f /work/Makefile.dc all"

docker-image-check:
	@docker image inspect $(DC_IMAGE) >/dev/null 2>&1 || { \
	    echo ""; \
	    echo "Docker image '$(DC_IMAGE)' not found."; \
	    echo "Build it first (takes 30-60 min):"; \
	    echo "  docker build -f Dockerfile.kos -t $(DC_IMAGE) ."; \
	    echo ""; \
	    exit 1; \
	}

# Launch Flycast with the ELF directly — no disc image required.
flycast: $(TARGET)
	$(FLYCAST) $(TARGET)

# Build a bootable GDI disc image for USB-GDROM hardware testing.
#
# Output: build/disc/disc.gdi + track01.bin + track02.bin + track03.bin
# Copy all four files to your USB-GDROM drive in a folder named MGS2DC/.
#
# Requires image rebuilt with disc utilities (adds ~2 min to build time):
#   docker build -f Dockerfile.kos -t $(DC_IMAGE) .
docker-disc: docker-image-check $(TARGET)
	mkdir -p $(DISC_DIR)/data
	$(DC_RUN) bash -c " \
	    scramble /work/mgs2dc.bin /work/build/disc/data/1ST_READ.BIN && \
	    makeip /work/scripts/dc_ip.txt /work/build/disc/IP.BIN && \
	    genisoimage \
	        -C 0,45000 \
	        -V MGS2DC \
	        -G /work/build/disc/IP.BIN \
	        -r -J -l \
	        -o /work/build/disc/track03.bin \
	        /work/build/disc/data/"
	$(MAKE) -f Makefile.dc disc-gdi-finalize

# Writes the silent lead-in tracks and disc.gdi descriptor.
# Runs on the host (no Docker needed) after docker-disc creates track03.bin.
disc-gdi-finalize:
	dd if=/dev/zero bs=2048 count=300 of=$(DISC_DIR)/track01.bin 2>/dev/null
	dd if=/dev/zero bs=2048 count=1   of=$(DISC_DIR)/track02.bin 2>/dev/null
	printf '3\n1 0 4 2048 track01.bin 0\n2 0 0 0 track02.bin 0\n3 45000 4 2048 track03.bin 0\n' \
	    > $(DISC_DIR)/disc.gdi
	@echo ""
	@echo "GDI image ready in $(DISC_DIR)/"
	@echo "Copy these files to a MGS2DC/ folder on your USB-GDROM drive:"
	@echo "  disc.gdi  track01.bin  track02.bin  track03.bin"
