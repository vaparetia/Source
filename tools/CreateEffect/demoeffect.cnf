effect "血 壁血（常駐）" [NewBloodWall]<id:0x7007><add_src : "chi01msu.bmp">
{ 
	int name    { %% = MaxInputGetEffectName( "名前", 0 ) ; } ;
	int map		{ %% = DM_GetCurrentMap(); };
} "これをセットしてから起動を呼んでください";

