effect "血 敵兵滲み血" [NewOozeBloodDemo]<id : 0x7000 >
{
	int name    { %% = MaxInputGetEffectName( "名前", 0 ) ; } ;

	void *objs  {
		link = &MaxInputGetLink( "適応オブジェクト", 0  ) ;
