	};

	int   model   { %% = MaxInputStrCode( "CV2モデル", 0, "sna_def"/*default*/, "cv2" ) ; } ;
}"指定したオブジェクトに滲み血を発生させることができるように\nキャラクタを起動。滲み血エフェクトをかけるオブジェクトは\nマルチテクスチャシングルウェイトモデルであり、\n同名のＣＶ２データファイルが必要になるので注意\n指定したオブジェクトに対して滲み血エフェクトキャラを起動し、そのキャラに対してメッセージを送ってください\n" ;

mesg "血 敵兵滲み血" 滲み血発生[0] $i:基本関節番号 $i:滲み発生Ｘ座標 $i:滲み発生Ｙ座標 $i:滲み発生Ｚ座標 $i:有効半径 "メッセージを送ることで指定した中心から広がるように頂点カラーを変更する。\n一度設定した色はプログラム終了まで持続する。\n基準ジョイント番号には実際に色を付けたい関節の番号を\n指定するようにしてください。（頭、腕など）" ;

effect "血 任意血" [NewBlood_Demo]<id : 0x7001 >
{
	FMATRIX *world {
		link = &MaxInputGetLink( "リンク", 0  ) ;
		handle = DM_GetObjectHandle( link->vx );
		%% = DM_GetObjectMatrix(handle,link->vy);
