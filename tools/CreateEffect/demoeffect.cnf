/*

	利用可能な 型の種類	
		char short int long
		u_char u_short u_int u_long
		float void
		FVECTOR SVECTOR IVECTOR FMATRIX

	2000/08/10	T.Morita
	$Id: demoeffect.cnf,v 1.1 2001/11/30 04:19:40 usr04098 Exp $

*/

// C++ comment can use

#include "demosce.h"
#include "demomax.h"
#include "demo.h"

/*
  現在あるオプション
	<id : 数字>	必ず全てのキャラに一意なものをつける。その際
	<no_birth>	キャラを生まずにそのフレームに関数が呼ばれるもの
			(全画面 環境光、全画面 平行光など)
	<efct_on  : メッセージID>	表示メッセージを登録することで可視コントローラで制御できるようになる
	<efct_off : メッセージID>	非表示メッセージを登録することで可視コントローラで制御できるようになる
			これらは、efct_on と efct_offでセットとなる。
	<add_src : "ファイル名,ファイル名">	srcに自動的に追加される。必ず使うモデルや
			テクスチャーを書き入れる。ファイルが複数ある場合は、スペースまたはカンマで区切る。
			ファイル名は、パスなしの拡張子付き。

*/




/**************************************************************************************

	デモシステム系    id 0xfff00

****************************************************************************************/
effect "システム 文字出し" [DM_DebugPrint]<id : 0xfff00 ><no_birth>
{
	char *message {
		%% = MaxInputString( "表示内容", 0 ) ;
	} ;
} "入力した内容を開始フレームの時にテレビ画面に表示させる。\n当然、英数字のみが表示可能な文字である。" ;

effect "システム プロック呼出し" [DM_ExecProc]<id : 0xfff01 ><no_birth>
{
	int  proc_id {
		%% = MaxInputStrCode( "GCL中のプロック名", 0, ""/*default*/, "" ) ;
	} ;
} "GCLに記述してあるプロックを実行する。これを使えばdelayが必要なくなる。\nこれを使うには、GCLのデモデーモンを起動するところに-pにて実行するプロックを記述しておく必要がある。最大16個まで記述することが可能。" ;

effect "システム クリッピング調整" [DM_SetClipParam]<id : 0xfff02 ><no_birth>
{
	float  near {
		%% = MaxInputFloat( "nearクリップ(mm)", 0,  50.0f/*default*/ ) ;
	} ;
	float  far {
		%% = MaxInputFloat( "farクリップ(mm)", 0,  65536.0F*20.0F/*default*/ ) ;
	} ;
} "クリッピングの設定を変えます。単位は、PS2と同じミリメートルです。" ;

effect "システム ３０フレーム再生" [NewDemoFrameCountCall]<id : 0xfff03 >
{
	int   name  { %% = MaxInputGetEffectName( "名前", 0 ) ; } ;
	int   start { %% = MaxInputGetKeyRangeMax( "フレーム最大", 0 ) ; } ;
	int   end   { %% = MaxInputGetKeyRangeMin( "フレーム最小", 0 ) ; } ;
} "引数は存在しません。エフェクトを置いた所が30フレーム表示となります。30フレームで表示するので、ヒキツリが1フレームごとに起こる場合などには有効です。" ;



/**************************************************************************************

	水飛沫 系    id 0x100〜0x104

****************************************************************************************/
effect "水飛沫 モーション連動" [NewSplashMotion_Demo] <id:0x100> <add_src : "splash05_alp.bmp" >
{
	void *objs  {
		link = &MaxInputGetLink( "リンク", 0 ) ;
		handle = DM_GetObjectHandle( link->vx ) ;
		%% = DM_GetObjectDgObjs( handle ) ;
	} ;
	float step_limit { %% = MaxInputSlideBarF( "ステップリミット", 0, 0.0f, 100.0f, 10, 5.0f/*deflaut*/ ) ; } ;
	int   life
	{
		max = MaxInputGetKeyRangeMax( "フレーム最大", 0 ) ;
		min = MaxInputGetKeyRangeMin( "フレーム最小", 0 ) ;
		%% = (max-min) ;
	} ;
} "モーションによって大きく動いた関節点から水飛沫を発生させる。前のフレームの関節点からの距離を調べ、一定以上離れた場合に出る。\n  対象オブジェ：：リンク制御で指定。\n  ステップリミット：：前フレームとどれだけ離れていれば発生させるか\n  寿命：：トラックビューでフレーム数指定" ;

effect "水飛沫 風紋" [NewSplashRipple_Demo] <id:0x101> <add_src : "splash05_alp.bmp" >
{
	FVECTOR *center   { %% = &MaxInputFVector( "中心位置", 1,  0.0f,0.0f,0.0f/*default*/ ) ; } ;
	float   radius    { %% = MaxInputFloat( "発生半径", 0, 200.0f ) ; } ;
	float   direction { %% = MaxInputSlideBarF( "方向", 4, 0, 360, 8, 0.0f/*default*/ ) ; } ;
	float   angle     { %% = MaxInputSlideBarF( "角度差分", 4, 0, 180, 4, 30.0f/*default*/  ) ; } ;
	float   size      { %% = MaxInputFloat( "大きさ", 0, 200.0f/*default*/  ) ; } ;
	int     multiple  { %% = MaxInputSlideBarI( "発生個数", 0, 10, 150, 10, 10/*default*/ ) ; } ;
	int	time
	{
		max = MaxInputGetKeyRangeMax( "フレーム最大", 0 ) ;
		min = MaxInputGetKeyRangeMin( "フレーム最小", 0 ) ;
		%% = (max-min) ;
	} ;
} "単発水飛沫を系統立てて呼ぶエフェクト。自殺キャラ。\n発生円内に円弧状に発生し、外周に向かって移動を繰り返す。\n  中心位置：：発生円の中心（高さＹの水平面のみから発生する）\n  発生半径：：発生円の最大半径\n  方向：：Ｙ軸回転角度(°単位)\n  角度差分：：`方向'からの＋−(°単位)\n  大きさ：：水飛沫自体の大きさ\n  発生個数：：発生させる円弧内の水飛沫の数 \nトラックビューで発生させ続けるフレーム数を指定（その後自殺する）" ;

effect "水飛沫 単発" [NewSplashParts_Demo] <id:0x102> <add_src : "splash05_alp.bmp , t.bmp" >
{
	FVECTOR *center  { %% = &MaxInputFVector( "中心位置", 1,  0.0f,0.0f,0.0f/*default*/ ) ; } ;
	SVECTOR *rot     { %% = &MaxInputSVector( "回転", 2,  0.0f,0.0f,0.0f/*default*/ ) ; } ;
	float   intense  { %% = MaxInputFloat( "大きさ", 0,  100.0f ) ; } ;
} "発生場所から発生方向（Ｚ軸基準）に水飛沫が飛ぶ。強さは単位フレームに進む距離を現し、大きさもそれに比例する。重力計算あり。" ;

effect "水飛沫 足元" [NewFootSplash] <id:0x103> <add_src : "splash05_alp.bmp" >
{
	void  *object {
		link = &MaxInputGetLink( "リンク", 0 ) ;
		handle = DM_GetObjectHandle( link->vx ) ;
		%% = DM_GetObjectObject( handle ) ;
	} ;
	void *control {
		%% = DM_GetObjectControl( handle ) ;
	} ;
} "キャラの足の上下に合わせて足元水飛沫を表示する。一つで両足分を管理する。リンク制御でキャラを指定" ;

effect "水飛沫 身体" [NewBodySplash3] <id:0x104> <add_src : "splash05_alp.bmp" >
{
	void *objs    {
		link = &MaxInputGetLink( "リンク", 0 ) ;
		handle = DM_GetObjectHandle( link->vx ) ;
		%% = DM_GetObjectDgObjs( handle ) ;
	} ;
	void *control {
		%% = DM_GetObjectControl( handle ) ;
	} ;
	int   model   { %% = MaxInputStrCode( "CV2モデル", 0, "sna_skl3"/*default*/, "cv2" ) ; } ;
	int   name    { %% = MaxInputGetEffectName( "名前", 0 ) ; } ;
} "身体全体から（風上方向の点に）ペラ水飛沫を発生。一関節当たりの個数が決まっているので注意。要CV２モデル。キャラはリンク制御で指定する。" ;

mesg "水飛沫 身体" 非表示[0] "飛沫の表示を取り止めます" ;
mesg "水飛沫 身体" 表示[1] "飛沫の表示を始めます" ;
mesg "水飛沫 身体" 終了[2] "飛沫を終了します" ;

effect "水飛沫 落下" [NewDiveSplash_Parent] <id:0x105>
{
	FVECTOR	*center { %% = &MaxInputFVector( "位置", 1,  0.0f,0.0f,0.0f ); };
}"どっぽーん飛沫\nこのキャラで多重呼びしています。";

mesg "水飛沫 ホロ" 飛沫ＯＦＦ[11] "chara プットホロオブジェの水しぶきを消す" ;
mesg "水飛沫 ホロ" 飛沫ＯＮ[12]   "chara プットホロオブジェの水しぶきをつける" ;


/**************************************************************************************

	メッセージ    id 0x8000

****************************************************************************************/
effect "メッセージ" [DM_SendEffectMessage] <id:0x8000><no_birth>
{
	int name    { %% = MaxInputGetInt( "名前", 0 ) ; } ;
	int data0   { %% = MaxInputGetInt( "データ０", 0 ) ; } ;
	int data1   { %% = MaxInputGetInt( "データ１", 0 ) ; } ;
	int data2   { %% = MaxInputGetInt( "データ２", 0 ) ; } ;
	int data3   { %% = MaxInputGetInt( "データ３", 0 ) ; } ;
	int data4   { %% = MaxInputGetInt( "データ４", 0 ) ; } ;
	int data5   { %% = MaxInputGetInt( "データ５", 0 ) ; } ;
	int data6   { %% = MaxInputGetInt( "データ６", 0 ) ; } ;
	int data7   { %% = MaxInputGetInt( "データ７", 0 ) ; } ;
	int command { %% = MaxInputGetInt( "コマンド", 0 ) ; } ;
	int num     { %% = MaxInputMessage( "個数", 0 ) ; } ;
} ;


/**************************************************************************************

	モデル系    id 0x4000

****************************************************************************************/
effect "頂点ストリームアニメ" [NewPutSTanimeObjectCall] <id:0x4000> 
{
	int name	{ %% = MaxInputGetEffectName( "名前", 0 ) ; } ;
	int model	{ %% = MaxInputStrCode( "XSI,KMS,CV2モデル", 0, "d00a_divewire"/*default*/, "xsi" ) ; } ;
	void *obj	{
		link = &MaxInputGetLink( "リンク", 0 ) ;
		handle = DM_GetObjectHandle( link->vx );
		%% = DM_GetObjectDgObj( handle, link->vy );
	} ;
	FVECTOR *pos    { %% = &MaxInputFVector( "位置", 1,  0.0f,0.0f,0.0f/*default*/ ) ; } ;
	SVECTOR *rot    { %% = &MaxInputSVector( "回転", 2,  0.0f,0.0f,0.0f/*default*/ ) ; } ;
	FVECTOR *scale  { %% = &MaxInputFVector( "スケール", 3,  1.0f,1.0f,1.0f/*default*/ ) ; } ;
	FVECTOR *bound_u{ %% = &MaxInputFVector( "バウンド最大", 0, 10000.0f,10000.0f,10000.0f/*default*/ ) ; } ;
	FVECTOR *bound_l{ %% = &MaxInputFVector( "バウンド最小", 0, -10000.0f,-10000.0f,-10000.0f/*default*/ ) ; } ;
	int mode	{ %% = MaxInputComboBox( "モード", 0, "普通再生=1&繰返し再生=2", "普通再生" ) ; } ;
} "モデル名（必須） KMS, ANM, CV2 が必要 名前は共通\nリンク制御によってオブジェクトにリンクします。\n  位置：：ローカル位置\n  回転：：ローカル回転（°単位）\n  スケール：：1.0を等バイトする大きさ\n  バウンド：：再生時に最大状態のバウンダリを指定します。\n  再生モード：：再生＝１ 繰返し表示＝２\n再生は、起動時に必ず掛かります。" ;

mesg "頂点ストリームアニメ" 停止[0] "アニメーションが止まります（ポーズ状態）" ;
mesg "頂点ストリームアニメ" 再生[1] "アニメーションが再開します（再生）" ;
mesg "頂点ストリームアニメ" 終了[2] "キャラを終了します。" ;
mesg "頂点ストリームアニメ" 再生スピード変更[3] $i:スピード "スピードを変更します。遅くにしかなりません。2を入れると2倍遅くなります。整数倍に遅くすることが出来ます。" ;
mesg "頂点ストリームアニメ" 再生レイト変更[4] $i:レイト "再生レイトを変更します。4096を1/30secに換算した値です。つまり、大きくすると速くなり小さくすると遅くなります。1から4096までしか入りません。デフォルトの値は、2048(1/60sec)です。" ;


effect "タバコ" [NewCigarette_Demo] <id:14>
{
	int      name     { %% = MaxInputGetEffectName( "名前", 0 ) ; } ;
	FMATRIX *world    {
		link = &MaxInputGetLink( "リンク", 0 ) ;
		handle = DM_GetObjectHandle( link->vx );
		%% = DM_GetObjectMatrix( handle, link->vy );
	} ;
	FMATRIX *sna_head {
		link = &MaxInputHumanNum( "スネーク頭", 0 ) ;
		handle = DM_GetObjectHandle( link->vx );
		%% = DM_GetObjectMatrix( handle, link->vy );
	} ;
	FMATRIX *sna_rhand{
		link = &MaxInputHumanNum( "スネーク右手", 0 ) ;
		handle = DM_GetObjectHandle( link->vx );
		%% = DM_GetObjectMatrix( handle, link->vy );
	} ;
	float    force    { %% = MaxInputFloat( "投げる強さ", 0,  50.0f/*default*/ ) ; } ;
	FVECTOR *dir      { %% = &MaxInputFVector( "回転", 2,   0.0f,0.0f,0.0f/*default*/ ) ; } ;
} ;
mesg "タバコ" 移動係数調節[0]   $i:速度係数   "10000で1.0fの速度。\n" ;
mesg "タバコ" タバコを吸う[1]   $i:フレーム数 "明るいままのフレーム数。\n" ;
mesg "タバコ" タバコを吐く[2]   $i:フレーム数 "煙を口から出すフレーム数。\n" ;
mesg "タバコ" タバコを投げる[3] "このフレームの瞬間にタバコが投げ出される。\n" ;
mesg "タバコ" タバコを終了[4]   "エフェクトを終了。\n" ;
mesg "タバコ" リンクの切替え[5] "リンク先を切替える。\n" ;

effect "モデル 映り込み" [DM_SendEffectMessage] <id:0x4001><no_birth>
{
	int name    { %% = MaxInputStrCode( "送り先", 0,  "映り込み", "" ); } ;
	int data0   { %% = MaxInputStrCode( "追加キャラ", 0,  "sna_def", "kms" ); } ;
	int data1   { %% = 0; };
	int data2   { %% = 0; };
	int data3   { %% = 0; };
	int data4   { %% = 0; };
	int data5   { %% = 0; };
	int data6   { %% = 0; };
	int data7   { %% = 0; };
	int command { %% = MaxInputComboBox( "モード", 0, "追加=0&削除=1", "追加" ); };
	int num     { %% = 2; };

}"鏡面映り込みキャラ";



effect "モデル 補間残像" [NewInterPoly_Demo] <id:0x4002>
{
	FVECTOR		*pos0 {
		link = &MaxInputHumanNum( "始点１", 0 ) ;
		handle = DM_GetObjectHandle( link->vx );
		%% = DM_GetObjectPos( handle, link->vy );
	};

	FVECTOR		*pos1 {
		link = &MaxInputHumanNum( "始点２", 0 ) ;
		handle = DM_GetObjectHandle( link->vx );
		%% = DM_GetObjectPos( handle, link->vy );
	};

	int			disp_f {
		%% = MaxInputSlideBarI( "頂点保存数", 0, 0, 16, 1,  8 );
	};

	SVECTOR		*color {
		col = &MaxInputSelectColor("色",0,128,128,128,128);
		DM_IVecToSVector( col, &cols );
		%% = &cols;
	};

}"ナイフの残像などに使用。\n２点で決まる線分の描く平面を、頂点を補完して滑らかに表示する。\n「保存フレーム数」を大きくすると過去の残像を長く残す。\n";

/**************************************************************************************

	物理シミュレーション系    id 0x3000

****************************************************************************************/
effect "物理シム・バンダナ" [NewRopeModel3_called] <id:0x3000>
{
	int model_name    { %% = MaxInputStrCode( "KMSモデル", 0, "sna_bdn1"/*default*/, "kms" ) ; } ;
	int sample_num    { %% = MaxInputSlideBarI( "動きの種類", 0, 0, 1, 1,  0/*default*/ )+2 ; } ;
	void *object      {
		link = &MaxInputGetLink( "リンク", 0 ) ;
		handle = DM_GetObjectHandle( link->vx );
		%% = DM_GetObjectObject( handle );
	} ;
	int objnum        { %% = link->vy ; } ;
	FVECTOR *pos      { %% = &MaxInputFVector( "位置", 1,   0.0f,0.0f,0.0f/*default*/ ) ; } ;
	SVECTOR *rot      { %% = &MaxInputSVector( "回転", 2,   0.0f,0.0f,0.0f/*default*/ ) ; } ;
	float oval_param  { %% = MaxInputSlideBarF( "当たり倍率", 0, 0.5f, 2.0f, 10,  1.0f/*default*/ ) ; } ;
	int collision_flag{ %% = 1 ; } ;
	int visible_flag  { %% = 1 ; } ;
	int mode          { %% = 0 ; } ;
} "バンダナの動きを計算、表示するキャラです。\n以下パラメータの説明\n位置  取り付ける場所のローカル座標値\n回転  取り付けるモデルのローカルの回転値\n当たり倍率   当たりをより大きく取りたい場合に調整します。だいたい、1.00fから1.50fまでの値を使用。\nスネークのバンダナは、2本あるので`動きの種類'および`モデル'を変えて表示させて下さい。sna_bdn1、sna_bdn2がバンダナのモデルです。" ;

effect "物理シム・ワイヤー" [NewRopeModel3_called] <id:0x3002>
{
	int model_name    { %% = MaxInputStrCode( "KMSモデル", 0, ""/*default*/, "kms" ) ; } ;
	int sample_num    { %% = 0 ; } ;
	void *object      {
		link = &MaxInputGetLink( "リンク", 0 ) ;
		handle = DM_GetObjectHandle( link->vx );
		%% = DM_GetObjectObject( handle );
	} ;
	int objnum        { %% = link->vy ; } ;
	FVECTOR *pos      { %% = &MaxInputFVector( "位置", 1,   0.0f,0.0f,0.0f/*default*/ ) ; } ;
	SVECTOR *rot      { %% = &MaxInputSVector( "回転", 2,   0.0f,0.0f,0.0f/*default*/ ) ; } ;
	float oval_param  { %% = MaxInputSlideBarF( "当たり倍率", 0, 0.5f, 2.0f, 10,  1.0f/*default*/ ) ; } ;
	int collision_flag{ %% = 1 ; } ;
	int visible_flag  { %% = 1 ; } ;
	int mode          { %% = 0 ; } ;
} "ワイヤーの動きを計算、表示するキャラです。\n以下パラメータの説明\n位置  取り付ける場所のローカル座標値\n回転  取り付けるモデルのローカルの回転値\n当たり倍率   当たりをより大きく取りたい場合に調整します。だいたい、1.00fから1.50fまでの値を使用。" ;

