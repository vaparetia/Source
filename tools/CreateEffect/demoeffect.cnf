effect "コントラスト" [NewContrast_Demo]<id : 0x009 ><no_birth>
{
	int r {
		col = &MaxInputSelectColor( "最終色", 0,  0,0,0,128/*default*/ ) ;
		%% = col->vx ;
	} ;
	int g { %% = col->vy ; } ;
	int b { %% = col->vz ; } ;
	int a { %% = col->vw ; } ;

	int nega_posi_flag { %% = MaxInputComboBox( "モード", 0, "ポジ=0&ネガ=1", "ポジ" ) ; } ;

	int time
	{
		max = MaxInputGetKeyRangeMax( "フレーム最大", 0 ) ;
		min = MaxInputGetKeyRangeMin( "フレーム最小", 0 ) ;
		%% = (max-min) ;
	} ;
} "「現在のコントラスト値を初期色として」最終色まで、指定フレームで変化する。\nαの値は「ＲＧＢ共通の」傾き（伸長率）。\nα=128で等倍。α=0で（ポジの場合）真っ黒。α=255で２倍。" ;


effect "コントラストカット" [NewContrastForce_Demo]<id : 0x00a ><no_birth>
{
	int ini_r {
		col = &MaxInputSelectColor( "初期色", 0,  0,0,0,128/*default*/ ) ;
		%% = col->vx ;
	} ;
	int ini_g { %% = col->vy ; } ;
	int ini_b { %% = col->vz ; } ;
	int ini_a { %% = col->vw ; } ;

	int r {
		col = &MaxInputSelectColor( "最終色", 0,  0,0,0,128/*default*/ ) ;
		%% = col->vx ;
	} ;
	int g { %% = col->vy ; } ;
	int b { %% = col->vz ; } ;
	int a { %% = col->vw ; } ;

	int nega_posi_flag { %% = MaxInputComboBox( "モード", 0, "ポジ=0&ネガ=1", "ポジ" ) ; } ;

	int time
	{
		max = MaxInputGetKeyRangeMax( "フレーム最大", 0 ) ;
		min = MaxInputGetKeyRangeMin( "フレーム最小", 0 ) ;
		%% = (max-min) ;
	} ;
} "「指定した初期色から」最終色まで、指定フレームで変化する。\nαの値は「ＲＧＢ共通の」傾き（伸長率）。\nα=128で等倍。α=0で（ポジの場合）真っ黒。α=255で２倍。" ;




