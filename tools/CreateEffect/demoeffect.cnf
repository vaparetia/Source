effect "煙 煙型ブラー" [NewSmokeBlurEffect]<id : 0x7100>
{
	FMATRIX	*world {		
		link = &MaxInputGetLink( "リンク", 0 ) ;
		handle = DM_GetObjectHandle( link->vx );
		%% = DM_GetObjectMatrix( handle, link->vy );
	};
	int	start_speed { %% = MaxInputInt( "初期スピード", 0,  150 );};
	int end_speed { %% = MaxInputInt( "最終スピード", 0,  80 );};
	int	start_size { %% = MaxInputInt( "初期サイズ", 0,  200 );};
	int end_size { %% = MaxInputInt( "最終サイズ", 0, 400 );};
	int	spot_size { %% = MaxInputInt( "出現位置半径", 0, 200 );};
	int spot_angle {
		angle = MaxInputSlideBarF("最大放射角",0,0.0f,359.9f,0.1f,60.0f);
//		if(angle == 360.0f) angle = 0.0f;
		%% = 4096.0f * angle/360.0f;
	};
	int n_prims { %% = MaxInputInt( "最大パーティクル数", 0, 64 );};
	int interval { %% = MaxInputInt( "噴射間隔", 0, 1 );};
	int color {
		col = &MaxInputSelectColor("色",0,129,129,129,0);
		%% = ((col->vx)|(col->vy*256)|(col->vz*256*256));
	};
	int flag {%% =  MaxInputListBox( "各種フラグ", 0, "デバッグ表示=0x01&初期位置固定=0x02",0x00);};
}"煙状にブラーをかけるエフェクトを作成しました\nエフェクトがかかっているかどうかが判別しにくい場合は一度デバッグ表示をＯＮ\nにして確認して見てください\n指定マトリクスに追従してＺ軸方向に対してブラーパーティクルを連続的に生成する\n１つのパーティクルの寿命はn_preim*invervalフレームとなる\n" ;


effect "煙 汎用" [NewCommonSmoke]<id : 0x7101>
{
	FVECTOR	*center { %% = &MaxInputFVector("発生元", 1, 0.0f, 0.0f, 0.0f); };
	float	radius { %% = MaxInputFloat( "発生半径", 0, 0.0f ); };
	int		col_r {
		col = &MaxInputSelectColor("色",0,128,128,128,128);
		%% = col->vx;
	};
	int		col_g { %% = col->vy; };
	int		col_b { %% = col->vz; };
	int		col_a { %% = col->vw; };

	int life { 
		max = MaxInputGetKeyRangeMax( "フレーム最大", 0 ) ;
		min = MaxInputGetKeyRangeMin( "フレーム最小", 0 ) ;
		%% = (max-min) ;
	};
	int mode  { %% = MaxInputComboBox( "歪みタイプ", 0, "加算=0&減算=1&加算平均=2&減算平均=3", "加算" ) ; } ;

}"汎用煙です。\nライフの１/５でアルファ値マックス\nその後減ります\n";


