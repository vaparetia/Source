	int collision_flag{ %% = 1 ; } ;
	int visible_flag  { %% = 1 ; } ;
	int mode          { %% = 1 ; } ;
} "髪の毛の動きを計算、表示するキャラです。\n以下パラメータの説明\n位置  取り付ける場所のローカル座標値\n回転  取り付けるモデルのローカルの回転値\n当たり倍率   当たりをより大きく取りたい場合に調整します。だいたい、1.00fから1.50fまでの値を使用。" ;

