	int time { 
		max = MaxInputGetKeyRangeMax( "フレーム最大", 0 ) ;
		min = MaxInputGetKeyRangeMin( "フレーム最小", 0 ) ;
		%% = (max-min) ;
	};
	int pat { %% = MaxInputInt( "パターン（未使用）", 0, 0 ); };
}"マトリクスに追従する形で、任意の時間、任意のサイズで放出。\n呼び出し時に与えたフォースはマトリクスによって毎フレーム再計算され、\n（位置だけでなく）方向も追従する。" ;

