effect "視線制御" [NewEyeControl] <id:0x100d>
{
	int name       { %% = MaxInputGetEffectName( "名前", 0 ) ; } ;

	void  *body {
		link = &MaxInputGetLink( "人", 0 ) ;
		handle = DM_GetObjectHandle( link->vx ) ;
		%% = DM_GetObjectObject( handle ) ;
	};

	void *target {
		link = &MaxInputHumanNum( "注視のオブジェクト", 0 );
		handle = DM_GetObjectHandle( link->vx );
		%% = DM_GetObjectMatrix( handle, link->vy );
	};
	FVECTOR *rmax {
		DM_GetRotToRadVec(&temp0,
				MaxInputSlideBarF( "右目最大角度Ｘ", 0, -180.0f, 180.0f, 1.0f, 10.0f/*defualt*/ ),
				MaxInputSlideBarF( "右目最大角度Ｙ", 0, -180.0f, 180.0f, 1.0f, 20.0f/*defualt*/ ),
				0.0f,0.0f);
		%% = &temp0;

	};
	FVECTOR *rmin {
		DM_GetRotToRadVec(&temp1,
				MaxInputSlideBarF( "右目最小角度Ｘ", 0, -180.0f, 180.0f, 1.0f, -10.0f/*defualt*/ ),
				MaxInputSlideBarF( "右目最小角度Ｙ", 0, -180.0f, 180.0f, 1.0f, -15.0f/*defualt*/ ),
				0.0f,0.0f);
		%% = &temp1;
	};
	FVECTOR *lmax {
		DM_GetRotToRadVec(&temp2,
				MaxInputSlideBarF( "左目最大角度Ｘ", 0, -180.0f, 180.0f, 1.0f, 10.0f/*defualt*/ ),
				MaxInputSlideBarF( "左目最大角度Ｙ", 0, -180.0f, 180.0f, 1.0f, 15.0f/*defualt*/ ),
				0.0f,0.0f);
		%% = &temp2;
	};
	FVECTOR *lmin {
		DM_GetRotToRadVec(&temp3,
				MaxInputSlideBarF( "左目最小角度Ｘ", 0, -180.0f, 180.0f, 1.0f, -10.0f/*defualt*/ ),
				MaxInputSlideBarF( "左目最小角度Ｙ", 0, -180.0f, 180.0f, 1.0f, -20.0f/*defualt*/ ),
				0.0f,0.0f);
		%% = &temp3;
	};
	int		flag {%%=0;};

}"リンクでキャラを指定して、ダミーのオブジェクトを\n注視するエフェクトです。\n角度は０度が正面です。\n横方向がＹで縦がＸです。\n" ;

effect "人体 海兵隊" [NewDemoArkms]<id:0x100f><add_src:"w04a_us_def.kls">
{
	void *object  {
		link = &MaxInputGetLink( "着せ替えオブジェクト", 0  ) ;
		handle = DM_GetObjectHandle( link->vx );
		%% = DM_GetObjectObject( handle );
	} ;
	int   frame { 
		%% = MaxInputSlideBarI( "海兵隊タイプ", 0, 0, 17, 1, 0 ) ;
	} ;

} "リンク先のモデルを指定した海兵隊のオブジェクトに替えることが出来ます。海兵隊の種類は、18種類あります。０から１７までの値を入れて決めて下さい。注）黒人のモデルだけは、スペキュラーが入っているので別モデルです。" ;


effect "人体 モーションモデル" [NewSigPutModel2]<id:0x100e><efct_on : 8><efct_off : 7>
{
	int	name	{ %% = MaxInputGetEffectName( "名前", 0 ) ; } ;
	int	where	{ %% = DM_GetCurrentMap() ; } ;
	int	dir	{ %% = MaxInputSlideBarF( "モデルの方向(360°単位)", 0, -180.0f, 180.0f, 10,  0.0f/*default*/ ) * 4096/360 ; } ;
	FVECTOR *pos   { %% = &MaxInputFVector( "モデルを置く場所", 1,   0.0f,0.0f,0.0f/*default*/ ) ; } ;
	int	model	{ %% = MaxInputStrCode( "シングルモデル名(KMS)", 0,  "sna_def"/*default*/, "kms" ) ; } ;
	int	motion	{ %% = MaxInputStrCode( "モーションファイル名(MAR)", 0,  "snake"/*default*/, "mar" ) ; } ;
	int	mot_num	{ %% = MaxInputInt( "モーション番号", 0,  0/*default*/ ) ; } ;

	int	status	{ %% = MaxInputListBox( "各種フラグ", 0,"水平移動を無視=0x01&重力処理無し=0x02&壁アタリ判定無し=0x04&モーション停止で待機 (mesgで再生開始)=0x08&再生開始時に座標をリセット=0x10&モーション補完無し=0x20&プリシェード=0x40", 0x5a ) ; } ;

} "指定したシングルモデルに対し、MARファイルに含まれるモーションを再生することが出来ます。再生は、繰返し表示されます。\n推奨する使いかたとして、ステータスの「モーション停止で待機」を立てて起動して、再生開始の所で「モーション再生」のメッセージを送ります。繰返し表示を行ないたくない場合、「終了判定」というメッセージで再生させます。\n各種フラグについて\n  水平移動を無視=モーションで移動していてもモデルは、移動せずに再生する\n  重力処理無し=モデルは、落ちることなく再生する。ハザードがない場合いつまでも落ち続ける\n  壁アタリ判定無し=壁ハザードがあっても反応しない\n  モーション停止で待機=0フレームを表示し、そのまま待機状態にはいる。メッセージを受けることで再生を開始できる\n  再生開始時に座標をリセット=再生を開始する時、再び元の位置に戻る。歩きなどを再生すると元の位置に戻ってくれる\n  モーション補完無し=モーションを切替えた時に補間されない。場面が変わった時などに有効\n  プリシェード=プリシェードモデルで表示される。これを立てなければシェードになる。" ;


mesg "人体 モーションモデル" モーション再生[1] $i:モーション番号 "指定した番号のモーションの再生を開始します。番号は、MAR内に書かれているモーションの順番です。" ;
mesg "人体 モーションモデル" モーション進む[2] "現在再生している番号の次の番号のモーションを再生します" ;
mesg "人体 モーションモデル" モーション戻る[3] "現在再生している番号の前の番号のモーションを再生します" ;
mesg "人体 モーションモデル" 初期座標[4] "初期座標に戻します。" ;
mesg "人体 モーションモデル" 回転[5]  $i:方向  "初期方向を変更します。４０９６を３６０°とした値を入れて下さい。" ;
mesg "人体 モーションモデル" 終了判定[6]  $i:モーション番号 "指定した番号のモーションを再生し、モーションが終了の際に終了フレームのまま停止します。";
mesg "人体 モーションモデル" 非表示[7] "モデルを非表示にします。" ;
mesg "人体 モーションモデル" 表示[8] "モデルを表示します。" ;



