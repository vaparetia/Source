#
# セグメンテーション用の閾値
#
# 以下のパラメータは、音素セグメンテーションおよび音素群ラベリングに
# 使用される閾値である。
#
# 各種判定に用いられる値は次の通り
#
#	Ci	零次メルケプストラム係数
#	Zi	零交差数
#	Vi	有声音検出パラメータ
#	Ai	零次メルケプストラム時間変化
#	Ei	スペクトル包絡時間変化
#	Fi	零交差数時間変化
#
DIC:		/usr/local/share/vsc/

# 有声音の検出に関係する閾値
Tvl:	   -2	# Vi がこの値未満なら、非有声音(無音or無声音)として認識
Tvh:	   0	# Vi がこの値より大きいなら、有声音として認識

Ta1:       0.12
Ta2:       0.18
Ta3:       0.25

Te1:       0.6
Te2:       1.5

Td:        0.3

Tcl:      -3.5
Tch:      -2.5
Tzl:      55
Tzh:     100

Ts:        2.5
Tf:        0.5
Tf2:       8.0
