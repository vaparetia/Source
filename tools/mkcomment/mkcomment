    $output .= "</TD></TR>\n" ;


    $output .= "<TR><TD>\n" ;
    $output .= "<H2><B>[関連]</B></H2>" ;
    $output .= "</TD></TR>\n" ;

    $output .= "<TR><TD></TD><TD COLSPAN=3>\n" ;
    $output .= "<SELECT NAME=relate SIZE=10 MULTIPLE>" ;
    push( @funcout, $output ) ;
    $output  = "</SELECT>" ;

    $output .= "</TD></TR>\n" ;

    $output .= "<TR><TD></TD><TD>\n" ;
    $output .= "<INPUT TYPE=SUBMIT VALUE=\"更新\">" ;
    $output .= "</TD></TR>\n" ;

    $output .= "</TABLE>\n" ;

    $output .= "</FORM><HR>\n" ;

    push( @funcout, $output ) ;
}


