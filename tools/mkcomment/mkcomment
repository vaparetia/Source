#
# Subroutines
#
#
#

sub get_token
{
    local $word ;
    local $ll ;

#特殊文字を取る
    $line =~ s/^[ \t\n\r]*// ;
    while( $line eq "" )
    {
	last if ( not $line = <CM> ) ;
	$line =~ s/^[ \t]*// ;
	$line =~ s/[\n\r]*//g ;

#	printf( "[$line] line %d\n", ++$ll ) ;
    }
    $token_prv = $token ;
    $token     = $line  ;

    #プリプロセッサの情報
    if ( $line =~ m/^#/ )
    {
	$file  = $line ;
	$file  =~ s/.*"(.*)".*/$1/ ;
	$line  = "" ;
	return $id = $TOKEN_CPP ;
    }

    #文字列リテラルなの？
    if ( $line =~ m/^".*"/ )
    {
	$line  =~ s/^(".*")// ;
	$token =~ s/^(".*").*/$1/ ;

	return $id = $TOKEN_LIT ;
    }

    if ( $line =~ m/^"/ )
    {
	$line = "" ;
	while( $line !~ /"/ )
	{
	    last if ( not $line = <CM> ) ;
	    $token .= $line ;
	}
	$line =~ s/[\n\r]*//g ;
	$line  =~ s/^([^"]*")// ;
	$token =~ s/^("[^"]*").*/$1/ ;

	return $id = $TOKEN_LIT ;
    }

    #区切り文字？
    foreach $word ( @OPERAND )
    {
	if ( index( $line, $word ) == 0 )
	{
	    $line  = substr( $line, length($word) ) ;
	    $token = $word ;

	    $brkt_level++ if ( $token eq "{" || $token eq "[" ) ;
	    $brkt_level-- if ( $token eq "}" || $token eq "]"  ) ;

	    return $id = $TOKEN_SEP ;
	}
    }

    #キーワードですか？
    $token =~ s/^([a-zA-Z_][a-zA-Z0-9_]*).*/$1/ ;
    foreach $word ( @KEYWORD )
    {
	if ( $word eq $token )
	{
	    $line  = substr( $line, length($word) ) ;
	    $token = $word ;

	    $keys_prv = $keys_now ;
	    $keys_now = $token    ;

	    return $id = $TOKEN_KEY ;
	}
    }

    #それとも型ですか？
    foreach $word ( @TYPES )
    {
	if ( $word eq $token )
	{
	    $line  = substr( $line, length($word) ) ;
	    $token = $word ;
            $token = "<A HREF=$TYPES_FILE{$word}#$word>$word</A>"
		      if ( $TYPES_IDX{$word} > $N_TYPES ) ;

	    $type_prv = $type_now ;
	    $type_now = $token    ;

	    return $id = $TOKEN_TYP ;
	}
    }
    $token = $line  ;

    #数字？
    if ( $line =~ m/^0[xX][0-9]/ ) #HEX数字
    {
	$line  =~ s/^(0[xX][0-9]+)// ;
	$token =~ s/^(0[xX][0-9]+).*/$1/ ;
	return $id = $TOKEN_NUM ;
    }
    if ( $line =~ m/^[0-9]/ ) #10進数 浮動少数
    {
	$line  =~ s/^([.e0-9]*)// ;
	$token =~ s/^([.e0-9]*).*/$1/ ;
	return $id = $TOKEN_NUM ;
    }

    #残りはIDでしょ
    if ( $line =~ m/^[a-zA-Z_]/ )
    {
	$line  =~ s/^([a-zA-Z_][a-zA-Z0-9_]*)// ;
	$token =~ s/^([a-zA-Z_][a-zA-Z0-9_]*).*/$1/ ;

	$name_prv = $name_now ;
	$name_now = $token ;

	return $id = $TOKEN_ID ;
    }

    die "Illeagal token[$line]\n" if ( length($line) > 0 ) ;

    return $id = $TOKEN_EOF ;
}

sub fork
{
    local $pid ;

    unless ( $pid = fork )
    {
	exec( $_[0] ) ;
	exit 0 ;
    }
    waitpid( $pid, 0 ) ;
}

