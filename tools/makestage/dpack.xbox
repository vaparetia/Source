	if ( -d "$src/$file" )
	{
	    &dir_cp_work( "$src/$file","-BR", "trn" ) ;
	}
	elsif ( -e "$src/$file" )
	{
	    &dar_cp_work( "$src/$file" ) if ( $file =~ m/.dar$/ ) ;
	    if ( $file =~ m/.bmp$/ && $file =~ m/_add|_sub|_hlf|_alp|_bld/ && $file !~ m/_ovl/ )
	    {
		&cp( $file, $src, "$work_dir/trn" ) ;
		$trn_flg = 1 ;
	    }
	}
	else
	{
	    print MYOUT "Err: Cannot find $src/$file\n" ;
	    &fork( "echo 'Err: Cannot find $src/$file'>> err.log" ) ;
	    &fork( "echo 'Err: Cannot find $src/$file'>> $log_file" )  if ( $log_file ) ;
	}
    }
    &fork( "rm -f $work_dir/cur/*" ) ;

    return $FLG_FLUSH_TRN ;
}

sub com_packta()
{
    local @cmd = @_ ;
    local @files, $file, $dir, $src, $dst ;

    $xti_file =  $cmd[1]   ;
    $xti_file =~ s/[\/]+([^\/]+)[\/]*$/$1/ ;
    $xti_file =~ s/\..*// ;

    print MYOUT "start packing $xti_file.xti as tranparency.\n" ;
    &fork( "echo '------------------------Start Packtrnall ($xti_file.xti)------------------------'>> $log_file" )  if ( $log_file ) ;

    splice( @cmd, 0, 2 ) ;
    foreach $file ( @cmd )
    {
	$src = "$src_dir/$file" ;
	$src  =~ s/\/[^\/]*$// ;
	$file =~ s/.*\/([^\/]+)$/$1/ ;
	if ( -d "$src/$file" )
	{
	    &dir_cp_work( "$src/$file", "-BR", "tra" ) ;
	}
	elsif ( -e "$src/$file" )
	{
	    if ( $file =~ m/.dar$/ )
	    {
		&dar_cp_work( "$src/$file" ) ;
		$trn_flg = 1 ;
	    }
	    if ( $file =~ m/.bmp$/ )
	    {
		&cp( $file, $src, "$work_dir/trn" ) ;
		$trn_flg = 1 ;
	    }
	}
	else
	{
	    print MYOUT "Err: Cannot find $src/$file\n" ;
	    &fork( "echo 'Err: Cannot find $src/$file'>> err.log" ) ;
	    &fork( "echo 'Err: Cannot find $src/$file'>> $log_file" )  if ( $log_file ) ;
	}
    }
    print MYOUT "done.\n" ;

    return $FLG_FLUSH_NON ;
}









###########################################
#
#
#
# SUBROUTINES
# コピールーチン群
# 
#
#
#
sub cp()
{
    local( $src, $src_d, $dst_d ) = @_ ;
    local $ext=$src ;

    $ext  =~ s/^.*\.// ;
    return "" if ( $ext eq "kls" ) ;
    $dst = &cp_bmp( $src, $src_d, $dst_d ) if ( $ext eq "bmp" ) ;
    $dst = &cp_oth( $src, $src_d, $dst_d ) if ( $ext ne "bmp" ) ;

    return $dst ;
}

#Copy a file
sub cp_oth()
{
    local( $src, $src_d, $dst_d ) = @_ ;
    local $dst=$src, $file=$src, $ext=$src ;

    $ext  =~ s/^.*\.// ;
    $file =~ s/\..*$// ;

# Check Rename
    $dst = $ren_file{$dst} if ( $ren_file{$dst} ) ;

# File already existed, do not copy
    if ( $checked{$dst} == 1 )
    {
	&fork( "echo '<<<<Already checked file ($dst)>>>>' >> $log_file" ) if ( $log_file ) ;
	return "" ;
    }
    $checked{$dst} = 1 ;

# Check same resident file or not
    if ( &search_cache( $dst ) )
    {
	printf( "Warning: <$dst> are already in resident\n" ) ;
    }
# Check StrCode
    else
    {
	&chk_strcode( $file, $ext ) ;
    }

    if ( $lst_flg )
    {
	print "$src_d/$dst\n" ;
    }
    else
    {
# Copy the file
#	die "<$dst> has already existed.Duplicate name.\n" if ( -e "$dst_d/$dst" && $src_d ne $dst_d ) ;
	&fork( "mv $src_d/$src $dst_d/$dst" ) if ( $src_d eq $dst_d && $src ne $dst ) ;
	&fork( "echo 'mv $src_d/$src $dst_d/$dst' >> $log_file" ) if ( $src_d eq $dst_d && $src ne $dst && $log_file ) ;
	&fork( "cp $src_d/$src $dst_d/$dst" ) if ( $src_d ne $dst_d ) ;
	&fork( "echo 'cp $src_d/$src $dst_d/$dst' >> $log_file" ) if ( $src_d ne $dst_d && $log_file ) ;

# Combine Kmx and Tri
	if ( $ext eq "kmx" ||  $ext eq "evx" )
	{
	    local $head, $log ;

	    $log = $log_file ? $log_file : "/dev/null" ;
	    $head = $ext eq "kmx" ? "KMX" : "EVX" ;
	    print MYOUT "$head<$dst> XTI<$xti_file>\n"       if ( !$kms_file{$dst} ) ;
	    print MYOUT "$head<$dst> XTI<$kms_file{$dst}>\n" if (  $kms_file{$dst} ) ;
	    &fork( "kms_util -t $xti_file $dst_d/$dst >> $log"     ) if ( !$kms_file{$dst} ) ;
	    &fork( "kms_util -t $kms_file{$dst} $dst_d/$dst >>$log") if (  $kms_file{$dst} ) ;

	}

#IDバッティングを回避
	if ( $ext eq "kmx" && $txrcmd_file{$dst} )
	{
	    #print "id_change.xbox $work_dir/$dst $txrcmd_file{$dst}\n" ;
	    &fork( "id_change.xbox $work_dir/$dst $txrcmd_file{$dst}" ) ;
	}
#EVXを新フォーマットに変換
	if ( $ext eq "evx" )
	{
	    &fork( "evm_conv.xbox $work_dir/$dst" ) ;
	}
    }

# .residentフラグが立っている
    &add_cache( $src_file, $dst ) if ( $resd_flg ) ;

    return $dst ;
}

#Copy a file
sub cp_bmp()
{
    local( $src, $src_d, $dst_d ) = @_ ;
    local $dst=$src, $file=$src, $ext=$src ;

    $ext  =~ s/^.*\.// ;
    $file =~ s/\..*$// ;

# Check Rename
    if ( $txrren_file{$dst} )
    {
	print "\tTEX($dst -> $txrren_file{$dst})\n" ;

	$txrcmd_file{$xti_file} = "-o $dst -n $txrren_file{$dst}";
	$dst = $txrren_file{$dst} ;
    }

# File already existed, do not copy
    if ( $src_d !~ "/dar" )
    {
	if ( $checked{$dst} == 1 )
	{
	    &fork( "echo '<<<<Warning checked file ($dst)>>>>' >> $log_file" ) if ( $log_file ) ;
	    # return "" ; とりあえずイラナそうなのでとった 2001.6.6
	}
	$checked{$dst} = 1 ;
    }
    else
    {
	if ( $tex_checked{"$dst_d/$dst"} == 1 )
	{
	    &fork( "echo '<<<<Warning checked file ($dst)>>>>' >> $log_file" ) if ( $log_file ) ;
	    # return ; とりあえずイラナそうなのでとった 2001.6.6
	}
	$tex_checked{"$dst_d/$dst"} = 1 ;
    }
# Check StrCode
    &chk_strcode( $file, $ext ) ;

    if ( $lst_flg )
    {
	print "$src_d/$src\n" ;
    }
    else
    {
# Copy the file
	&fork( "mv $src_d/$src $dst_d/$dst" ) if ( $src_d eq $dst_d && $src ne $dst ) ;
	&fork( "echo 'mv $src_d/$src $dst_d/$dst' >> $log_file" ) if ( $src_d eq $dst_d && $src ne $dst && $log_file ) ;
	&fork( "cp $src_d/$src $dst_d/$dst" ) if ( $src_d ne $dst_d ) ;
	&fork( "echo 'cp $src_d/$src $dst_d/$dst' >> $log_file" ) if ( $src_d ne $dst_d && $log_file ) ;
    }
    return $dst ;
}




###########################################
#
#
#
# SUBROUTINES
# キャッシュ ルーチン群（階層ごとすべてをコピー）
# 
#
#
#

sub add_cache()
{
    local ( $file, $string ) = @_ ;
    local $flg = 1 ;

    $string =~ s/^[ \t]+// ;
    $string =~ s/[ \t]+$// ;
    open( CACH_OLD, $cach_file ) ;
    open( CACH_NEW, "> $cach_file.new" ) ;
    foreach( <CACH_OLD> )
    {
	print( CACH_NEW ) ;
	print( CACH_NEW "$string\n") , $flg=0 if ( $flg &&  $_ =~ $file ) ;
    }
    close( CACH_OLD ) ;
    close( CACH_NEW ) ;
    &fork( "mv $cach_file.new $cach_file" ) ;
}


sub clear_cache()
{
    local ( $file ) = @_ ;
    local $flg = 0, $new = 0 ;

    &fork( "touch $cach_file" ) if ( ! -e $cach_file ) ;

    open( CACH_OLD, $cach_file ) ;
    open( CACH_NEW, "> $cach_file.new" ) ;
    foreach( <CACH_OLD> )
    {
	next if ( $flg>=2 && $_ =~ $file ) ;
	$flg |=2, if ( $flg==1 && $_ =~ $file && $_ =~ "end" ) ;
	print CACH_NEW if ( $flg != 1 ) ;
	$flg |=1, if ( $flg==0 && $_ =~ $file && $_ =~ "begin" ) ;
    }
    print CACH_NEW "  $file -- begin --  \n" if ( !($flg & 1) ) ;
    print CACH_NEW "  $file -- end --  \n"   if ( !($flg & 2) ) ;
    close( CACH_OLD ) ;
    close( CACH_NEW ) ;
    &fork( "mv $cach_file.new $cach_file" ) ;
}

sub search_cache()
{
    local ( $pattern ) = @_ ;
    local $cmd_line ;

    die "There is no residents-file (.cache) !!\nPlease, make it first.\n" if ( ! -e $cach_file ) ;

    foreach( @residents )
    {
	$cmd_line  = "sed -n -e '/$_.*begin/,/$_.*end/p' $cach_file |" ;
	$cmd_line .= "grep $pattern |" ;

	open( CACH, $cmd_line ) ;
	foreach( <CACH> )
	{
	    return 1 if ( !/^ / && /^$pattern/ ) ;
	}
	close( CACH ) ;
    }

    return  0 ;
}

#レジデントをチェック用に入れる
sub check_cache()
{
    local ( $res_name ) = @_ ;
    local $cmd_line, $file, $ext ;
    local $no_res = 1 ;

    die "There is no residents-file (.cache) !!\nPlease, make it first.\n" if ( ! -e $cach_file ) ;

    $cmd_line  = "sed -n -e '/$res_name .*begin/,/$res_name .*end/p' $cach_file |" ;
    open( CACH, $cmd_line ) ;
    foreach( <CACH> )
    {
	if ( !/^ / && ! /^\./ )
	{
	    chop( $_ ) ;
	    $ext  = $_ ;
	    $file = $_ ;

	    $ext  =~ s/^.*\.// ;
	    $file =~ s/\..*$// ;

	    &chk_strcode_res( $file, $ext ) ;
	    $no_res = 0 ;
	}
    }
    close( CACH ) ;
    die "Err: No resident named <$res_name>. Please make <$res_name>\n" if ( $no_res ) ;

    return  0 ;
}

sub listup_cache()
{
    die "There is no residents-file (.cache) !!\nPlease, make it first.\n" if ( ! -e $cach_file ) ;

    foreach( @residents )
    {
	open( CACH, "sed -n -e '/$_.*begin/,/$_.*end/p' $cach_file |" ) ;
	foreach( <CACH> )
	{
	    print if ( !m/--/ ) ;
	}
	close( CACH ) ;
    }

    return  0 ;
}




###########################################
#
#
#
# SUBROUTINES
# dir_cp_??? ルーチン群（階層ごとすべてをコピー）
# 
#
#
#


#Copy DAR directories
sub dar_cp_work()
{
    local ( $src ) = @_ ;
    local $kms = $src ;
    local $evm = $src ;
    local $flg = $FLG_FLUSH_NON ;
    local $temp ;

#XTIとKMSを結びつけるためにkms_texとkms_fileで記憶する。
    $kms =~ s/.*\/([^\/]+).dar$/$1.kmx/ ;
    return 0 if ( $kms_tex{$kms} ) ;
    $evm =~ s/.*\/([^\/]+).dar$/$1.evx/ ;
    return 0 if ( $kms_tex{$evm} ) ;
#マークしておく（これで2度と同じ名前では来ない）
    $kms_tex{$evm} = $kms_tex{$kms} = 1 ;

    #コモデル用のテクスチャー？
    if ( $src =~ /_cm.dar$/ || $xti_file =~ /_cm$/ )
    {
	$kms_file{$ren_file{$kms}} = "comdl".$qar_name if (  $ren_file{$kms} ) ;
	$kms_file{          $kms } = "comdl".$qar_name if ( !$ren_file{$kms} ) ;
	$kms_file{$ren_file{$evm}} = "comdl".$qar_name if (  $ren_file{$evm} ) ;
	$kms_file{          $evm } = "comdl".$qar_name if ( !$ren_file{$evm} ) ;
	&fork( "dar xl$work_dir/dar $src" ) ;
	$flg = &dir_cp_work( "$work_dir/dar", "-B", "cmd" ) if ( !$lst_flg ) ;
	&fork( "rm -f $work_dir/dar/*" ) ;
    }
    else
    {
	#このDARファイルがIDバッティングを回避するためのものかどうか
	foreach $bmp ( keys %txrren_file )
	{
	    open( CHECK, "dar tv $src | grep $bmp |" ) ;
	    $temp = "-o $bmp -n $txrren_file{$bmp}";
	    if ( <CHECK> )
	    {
		$txrcmd_file{$ren_file{$kms}} = $temp if (  $ren_file{$kms} ) ;
		$txrcmd_file{          $kms } = $temp if ( !$ren_file{$kms} ) ;
		$txrcmd_file{$ren_file{$evm}} = $temp if (  $ren_file{$evm} ) ;
		$txrcmd_file{          $evm } = $temp if ( !$ren_file{$evm} ) ;
	    }
	    close( CHECK ) ;
	}

	#リネーム対処
	$kms_file{$ren_file{$kms}} = $xti_file if (  $ren_file{$kms} ) ;
	$kms_file{          $kms } = $xti_file if ( !$ren_file{$kms} ) ;
	$kms_file{$ren_file{$evm}} = $xti_file if (  $ren_file{$evm} ) ;
	$kms_file{          $evm } = $xti_file if ( !$ren_file{$evm} ) ;

	#DARのテンポラリディレクトリへの展開
	&fork( "dar xl$work_dir/dar $src" ) ;

	#BMPをテンポラリディレクトリから然るべきディレクトリに振り分け
	$flg = &dir_cp_work( "$work_dir/dar", "-B", "all" ) if ( !$lst_flg ) ;

	#テンポラリディレクトリを掃除
	&fork( "rm -f $work_dir/dar/*" ) ;
    }
    return $flg ;
}

#Copy directories
sub dir_cp_work()
{
    local ( $dir, $ls_opt, $mode ) = @_ ;
    local $l_dir = "" , $src, $i ;
    local $flg = $FLG_FLUSH_NON ;

    open( LST, "$ls_cmd $ls_opt $dir | grep -v '/\$' |" ) ;

    $dir =~ s/\/[^\/]*\*$// ;
    foreach $i ( <LST> )
    {
	chop( $_ = $i ) ;
	next if ( m/^[ \t]*$/ ) ;

	$l_dir = $_, $l_dir =~ s/:$//, next if ( $_ =~ /:$/ ) ;
	$src = $l_dir ? $l_dir : $dir ;
	s/.*\/([^\/]+)$/$1/ ;

	$flg = &mode_cp_anm( $_, $src, $flg ) if ( $mode eq "anm" ) ; #XSI→ANMを生成してコピー
	$flg = &mode_cp_cvd( $_, $src, $flg ) if ( $mode eq "cvd" ) ; #CVXのコピー
	$flg = &mode_cp_rol( $_, $src, $flg ) if ( $mode eq "rol" ) ; #ROLのコピー
	next if ( /\.xsi$/ ) ;

# 11/24/99 K.Kano
	next if ( /\.cvd$/ ) ;
	next if ( /\.cv2$/ ) ;
	next if ( /\.rol$/ ) ;
	next if ( /\.l2d$/ ) ;

	next if ( /\.cvx$/ ) ;
	next if ( /\.kms$/ ) ;
	next if ( /\.evm$/ ) ;

	next if ( /\.cvy$/ ) ;
	next if ( /\.evy$/ ) ;
	next if ( /\.kmy$/ ) ;

	$flg = &mode_cp_trn( $_, $src, $flg ) if ( $mode eq "trn" ) ; #半透明のXTIを作る
	$flg = &mode_cp_tra( $_, $src, $flg ) if ( $mode eq "tra" ) ; #強制半透明のXTIを作る
	$flg = &mode_cp_bmp( $_, $src, $flg ) if ( $mode eq "bmp" ) ; #自動的に判別してXTIを作る
	$flg = &mode_cp_cmd( $_, $src, $flg ) if ( $mode eq "cmd" ) ; #コモデル用のXTIを作る
	$flg = &mode_cp_all( $_, $src, $flg ) if ( $mode eq "all" ) ; #そのほか全てのコピー
    }
    close LST ;
    return $flg ;
}

#Copy a CVD file
sub mode_cp_cvd()
{
    local ( $file, $src, $flg ) = @_ ;

    $_ = $file ;

    &cp( $_, $src, $work_dir ) if ( /\.cvx$/ ) ;
    return $flg ;
}


#Copy a ROL file
sub mode_cp_rol()
{
    local ( $file, $src, $flg ) = @_ ;

    $_ = $file ;

    &cp( $_, $src, $work_dir ) if ( /\.rol$/ ) ;
    return $flg ;
}


#Copy a ANM file
sub mode_cp_anm()
{
    local ( $file, $src, $flg ) = @_ ;

    $_ = $file ;
    if ( /\.xsi$/ )
    {
	s/\.xsi// ;
	print MYOUT "\t$_.anm  " ;
	&fork( "st_anime.xbox $src/$_.xsi $work_dir/tmp$_.anm $src/$_.cvx $anm_flg | grep frames" ) and
	    die "Error st_anime.xbox!!:$!\n" ;
	&fork( "lzsh e $work_dir/tmp$_.anm $work_dir/$_.anm" ) and die "Error lzsh!!:$!\n" ;
	&fork( "rm -f $work_dir/tmp$_.anm" ) ;
	&cp( "$_.anm", $work_dir, $work_dir ) ;
    }
    return $flg ;
}

#Copy a BMP file as transparacy
sub mode_cp_trn()
{
    local ( $_, $src, $flg ) = @_ ;

    if ( /\.dar$/ )
    {
	&dar_cp_work( "$src/$_" ) ;
	$flg = $FLG_FLUSH_TRN ;
    }
    elsif ( /\.bmp$/ && /_add|_sub|_hlf|_alp|_bld/ && !/_ovl/ )
    {
	&cp( $_, $src, "$work_dir/trn" ) ;
	$trn_flg = 1 ;
	$flg = $FLG_FLUSH_TRN ;
    }
    return $flg ;
}

#Copy a BMP file as transparacy(from trnall command)
sub mode_cp_tra()
{
    local ( $_, $src, $flg ) = @_ ;

    if ( /\.dar$/ )
    {
	$trn_flg = 1 ;
	&dar_cp_work( "$src/$_" ) ;
	$flg = $FLG_FLUSH_TRN ;
    }
    elsif ( /\.bmp$/ )
    {
	&cp( $_, $src, "$work_dir/trn" ) ;
	$trn_flg = 1 ;
	$flg = $FLG_FLUSH_TRN ;
    }
    return $flg ;
}

#Copy a BMP file as Co-Model XTI
sub mode_cp_cmd()
{
    local ( $_, $src, $flg ) = @_ ;

    if ( /\.dar$/ )
    {
	&dar_cp_work( "$src/$_" ) ;
    }
    elsif ( /\.bmp$/ )
    {
	&cp( $_, $src, "$work_dir/cmd" ) ;
	$cmd_flg = 1 ;
	$flg = $FLG_FLUSH_CMD ;
    }
    return $flg ;
}

#Copy a BMP file.
sub mode_cp_bmp()
{
    local ( $_, $src, $flg ) = @_ ;

    if ( /\.dar$/ )
    {
	&dar_cp_work( "$src/$_" ) ;
	$flg = $FLG_FLUSH_BMP ;
    }
    elsif ( /\.bmp$/ )
    {
	&cp( $_, $src, "$work_dir/cur" )             if (  /_ovl/ || !/_add|_sub|_hlf|_alp|_bld/ ) ;
	&cp( $_, $src, "$work_dir/trn" ), $trn_flg=1 if ( !/_ovl/ &&  /_add|_sub|_hlf|_alp|_bld/ ) ;
	$flg = $FLG_FLUSH_BMP ;
    }
    return $flg ;
}


#Copy files.
sub mode_cp_all()
{
    local ( $_, $src, $flg ) = @_ ;

    if ( /\.vib$/ )
    {
	$var_flag = 1 ;
	&cp( $_, $src, "$work_dir/var" ) ;
    }
    elsif ( /\.dar$/ )
    {
	&dar_cp_work( "$src/$_" ) ;
	$flg = $FLG_FLUSH_BMP ;
    }
    elsif ( /\.bmp$/ )
    {
	&cp( $_, $src, "$work_dir/cur" )             if (  /_ovl/ || !/_add|_sub|_hlf|_alp|_bld/ ) ;
	&cp( $_, $src, "$work_dir/trn" ), $trn_flg=1 if ( !/_ovl/ &&  /_add|_sub|_hlf|_alp|_bld/ ) ;
	$flg = $FLG_FLUSH_BMP ;
    }
    else
    {
	&cp( $_, $src, $work_dir ) ;
    }
    return $flg ;
}





###########################################
#
#
#
# StrCode Output SUBROUTINES
# サブルーチン群
# 
#
#
#
sub out_strcode()
{
    my ( $dir ) = @_ ;

    &fork( "id_check $dir | sed -e 's/^.*\\///' >> $dst_dir/idlist.txt" ) ;
}


###########################################
#
#
#
# SUBROUTINES
# サブルーチン群
# 
#
#
#
sub chk_strcode()
{
    my ( $file, $ext ) = @_ ;
    local %codes, $code ;


    $code = &strcode($file) ;
#print MYOUT "$file($ext) stcode = $code\n" ;
    die "$codes{$code.$ext} and $_[0] have same strcode($code)\n" if ( $codes{$code.$ext} ) ;
    die "$res_codes{$code.$ext} in resident and $_[0] have same strcode($code)\n" if ( $res_codes{$code.$ext} ) ;
    $codes{$code.$ext} = $_[0] ;
}

sub chk_strcode_res()
{
    my ( $file, $ext ) = @_ ;
    local %codes, $code ;

    $code = &strcode($file) ;
#print MYOUT "$file($ext) stcode = $code\n" ;
    die "$res_codes{$code.$ext} in resident and $_[0] have same strcode($code)\n" if ( $res_codes{$code.$ext} ) ;
    $res_codes{$code.$ext} = $_[0] ;
}

sub print_strcode()
{
    foreach( keys %res_codes )
    {
	print "$res_codes{$_} : $_\n" ;
    }

    foreach( keys %codes )
    {
	print "$codes{$_} : $_\n" ;
    }
}

sub strcode()
{
    my ( $string ) = @_ ;
    my $len, $BITLEN = 24 ;
    my $id, $mask ;

    $id  = 0 ;
    $len = length( $string )-1 ;
    $mask = (1 << $BITLEN)-1 ;
    foreach $i (0..$len)
    {
	$id = ( $id << 5 ) | ($id >> ($BITLEN-5) ) ;
	$id += ord( substr( $string, $i,1 ) ) ;
	$id &= $mask ;
    }
    $id = 1 if ( $id == 0 ) ;

    return $id ;
}


sub id_rename
{
    foreach( keys %txrcmd_file )
    {
	if ( not -e "$work_dir/$_" )
	{
	    die "Cannot find kmx-file<$_> to rename.\n" ;
	}
	&fork( "id_change $work_dir/$_ $txrcmd_file{$_}" ) ;
    }
}

sub fork
{
    my $pid ;
    my $command = $_[0] ;

    return 0 if ( $lst_flg && $_[0] !~ m/^rm/ ) ;

    if ( $log_file ) {
	open( LOG, ">> $log_file" ) ;
	print LOG "cmd ($command)\n" ;
	close LOG ;
    }

#コマンドに関するすべての拡張子をKMS->KMXに変える
    $commad =~ s/\.kms/\.kmx/g ;

    unless ( $pid = fork )
    {
        exec( $command ) ;
        exit 0 ;
    }
    waitpid( $pid, 0 ) ;

    return $? ;
}

sub search_com()
{
    local ( $string, @cmd ) = @_, $i ;

    for( $i=0 ; $i <= $#cmd ; $i++ )
    {
	return $i if ( $cmd[$i] eq $string ) ;
    }
    return -1 ;
}
