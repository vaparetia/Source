						-a 200 \
						-i 0 -1 0 0 \
						-s $3


				}else{
					chara カメラ設定 サブカメラ１ \
						-c 0 \
						-b -32000,5000,-32000 32000,5500,32000 \
						-l -32000,-32000,-7000 32000,32000,32000 \
						-r 120,(4096 - 1900),0 \
						-f 6000 \
						-a 200 \
						-i 3 -1 0 0 \
						-s $3

				}

			}


//２Ｆ階段奥（東西）
		trap ca026 d:PLAYER \
			-camera \
			-mask ？ \
			-exec {

				if($4 < 0){
					chara カメラ設定 サブカメラ２ \
						-c 1 \
						-p -16880,9310,-14570 \
						-t -16519,1745,-17082 \
						-a 154 \
						-i 0 0 0 0 \
						-s $3

				}else{
					chara カメラ設定 サブカメラ２ \
						-c 1 \
						-p 16880,9310,-14570 \
						-t 16519,1745,-17082 \
						-a 154 \
						-i 0 0 0 0 \
						-s $3

				}

			}




//２Ｆ〜３Ｆ左舷階段
		trap ca010l d:PLAYER \
			-camera \
			-mask いる \
			-exec {

					chara カメラ設定 サブカメラ１ \
						-c 0 \
						-b -32000,-32000,-5000 -13000,32000,32000 \
						-l -32000,-32000,-32000 32000,32000,32000 \
						-r 100,2000,0 \
						-f 10000 \
						-a 200 \
						-i 3 -1 0 0 \
						-s $3

			}


//２Ｆ〜３Ｆ右舷階段
		trap ca010r d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {

					chara カメラ設定 サブカメラ１ \
						-c 0 \
						-b 13000,-32000,-5000 32000,32000,32000 \
						-l -32000,-32000,-32000 32000,32000,32000 \
						-r 100,(4096 - 2000),0 \
