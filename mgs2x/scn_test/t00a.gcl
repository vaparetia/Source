///command ネットワークコールバック設定 -s セッションスタート -I メンバーログイン

chara マップ 甲板 -k w00a 0 0 0 -h w00a 0 -l w00a

command マップ設定 甲板 -set {
	@プレイヤー設定	//
	@船首モデル設定
	@甲板敵兵セット
	@カメラ設定
	@甲板カメラ設定
//	@甲板ビヨンド設定
	@処理落ち対処
//chara テストシナリオ テストシナリオ
}
command マップ表示 -add 甲板


///command 仮シナリオ





// プレイヤー 
// ------------------------------------
proc プレイヤー設定 {
#if 0
	chara うそスネーク d:PLAYER -p 4839, 0, 16224 -d 0, 1024, 0
#else
#if 1
	chara プレイヤー d:PLAYER \
					-m sna_def \
					-a snake \
					-p 4839 0 16224 \
					-d 0, 1024, 0 \
					-l 4000 \
					-f 0x00000001 \
					-s 0 \
					-o sna_w00a \
					-i 0 
	chara ロープモデル３ バンダナ１ \
		-n sna_bdn1 \
		-d 1 \
		-y d:PLAYER \
		-z 12 \
		-x 0,60,-90 \
		-m 12 \
		-p 250 \
		-k 350 \
		-o 110 \
		-f 1

	chara ロープモデル３ バンダナ２ \
		-n sna_bdn2 \
		-d 1 \
		-y d:PLAYER \
		-z 12 \
		-x 0,50,-90 \
		-m 22 \
		-p 250 \
		-k 350 \
		-o 110 \
		-f 1

#else
	chara ネット対応プレイヤー d:PLAYER \
					-m sna_def \
					-a snake \
					-p 4839 0 16224 \
//					-p 0 0 0 \
					-d 0, 1024, 0 \
					-l 4000 \
					-f 0x00000001 \
					-s 0 \
					-o sna_w00a \
					-i 0 
	command スタート同期カウンタ

	chara ネットゴール ゴール \
			-p 0 500 9000 \
			-d 2000 \
			-w 2000 

	chara ネット敵テスト ネット敵 \
			-p 0 1000 9000 \
			-d 0 
#endif
#endif
}

//###################################################################################
//									船首モデル設定
//###################################################################################


	proc 船首モデル設定 {
		print '艦首モデル設定'

		chara プットオブジェ 船首１ -m w00_f1 -r 0 0 0 -p 0 0 -180000  -l w00a -s 100 100 100
		chara プットオブジェ 船首２ -m w00_f2 -r 0 0 0 -p 0 0 -120000  -l w00a -s 100 100 100
		chara プットオブジェ 船首３ -m w00_f3 -r 0 0 0 -p 0 0 -60000  -l w00a -s 100 100 100
		chara プットオブジェ 船首４ -m w00_f4 -r 0 0 0 -p 0 0 0  -l w00a -s 100 100 100

		chara プットオブジェ ウィンドラス -m w00a_winch -r 0 0 0 -p 0 0 0  -l w00a -s 100 100 100

	}


//###################################################################################
//									カメラ設定
//###################################################################################

	// カメラ設定 
	// ------------------------------------
	proc カメラ設定 {
		print 'default camera setting'

			chara カメラ ステージカメラ	-c 0 -l 3 -p 0 
			chara カメラ サブカメラ１	-c 0 -l 2 -p 50 
			chara カメラ サブカメラ２	-c 0 -l 2 -p 40 
			chara カメラ サブカメラ３	-c 0 -l 2 -p 30 
			chara カメラ ビヨンドカメラ	-c 0 -l 2 -p 20 
			chara カメラ ロードカメラ	-c 0 -l 2 -p 10 //水密ドアロード用にしか使ってません

			// デフォルトカメラ
			chara カメラ設定 ステージカメラ \
				-c 0 \	
				-b -32000,-17000,-80750 32000,32000,0 \
				-l -32000,-17000,-80750 32000,32000,0 \
				-r 640,2048,0 \
				-f 4000 \
				-a 200 \
				-i 1 -1 0 0 \
				-s 1
	}


	proc 甲板カメラ設定 {
		print 'kanpan camera setting'


//甲板南部１（最後尾）
		trap ca000 d:PLAYER \
			-camera \
			-mask いる \
			-exec {
				@CS_スムーズカメラ $6 8000 20000 350 100
				eval( $i:補完ＲＸ = $i:CS_結果１ ) 
				@CS_スムーズカメラ $4 -6000 6000 1920 2176
				eval( $i:補完ＲＹ = $i:CS_結果１ ) 
				chara カメラ設定 サブカメラ１ \
					-c 0 \	
					-b -32000,   500,-32000 32000,32000,32000 \
					-l -32000,   500,-32000 32000,32000,32000 \
//					-r $i:補完ＲＸ,$i:補完ＲＹ,0 \
					-r 390,$i:補完ＲＹ,0 \
					-f 8000 \
					-a 200 \
					-i 1 -1 0 0 \
					-s $3
			}

//甲板南部２
		trap ca001 d:PLAYER \
			-camera \
			-mask いる \
			-exec {

				eval( $i:割合Ｚ = ($6 + 1000) / 90 );
				eval( $i:補完ＲＸ = 1020 - 670 * $i:割合Ｚ / 100 );
				eval( $i:割合Ｘ = ($4 + 6000) / 120 );
				eval( $i:補完ＲＹ = ( 2048 -  ( 2048 - ( 1920 + 256 * $i:割合Ｘ / 100 )) * $i:割合Ｚ / 100 ) )	;

				@CS_スムーズカメラ昇順 $5 500 2000 5900 7000

				eval( $w:補完距離 = $i:CS_結果１ )

				chara カメラ設定 サブカメラ１ \
					-c 0 \ 
					-b -32000,500,-32000 32000,32000,32000 \
					-l -32000,500,-32000 32000,32000,32000 \
					-r $i:補完ＲＸ,$i:補完ＲＹ,0 \
					-f 8000 \
					-a 200 \
					-i 2 -1 0 0 \
					-s $3

			}


//左舷クレーン脇
		trap ca027l d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {
				chara カメラ設定 サブカメラ１ \
					-c 1 \ 
					-p -8466,4825,1999 \
					-t -9274,3078,-887 \
					-a 145 \
					-i 0 -1 0 0 \
					-s $3

			}

//右舷クレーン脇
		trap ca027r d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {
				chara カメラ設定 サブカメラ１ \
					-c 1 \ 
					-p 8466,4825,1999 \
					-t 9274,3078,-887 \
					-a 145 \
					-i 0 -1 0 0 \
					-s $3

			}


//甲板南部３＆階段
		trap ca002 d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {

				if( $4 < 0 ){
					eval( $i:補完ＢＸ１ = -32000 )
					eval( $i:補完ＢＸ２ = -8100 )
					eval( $i:補完ＬＸ１ = -32000 )
					eval( $i:補完ＬＸ２ = -8200 )

				}else{
					eval( $i:補完ＢＸ１ = 8100 )
					eval( $i:補完ＢＸ２ = 32000 )
					eval( $i:補完ＬＸ１ = 8200 )
					eval( $i:補完ＬＸ２ = 32000 )

				}

				if($4 > -11000 && $4 < 11000 && $6 > -2000){	//クレーン横から降りてきたときだけ。
					eval($w:カメラ補完方式 = 0)
				}else{
					eval($w:カメラ補完方式 = 3)
				}

				@CS_スムーズカメラ $6 -1000 -5000 1020 640
				eval( $i:補完ＲＸ = $i:CS_結果１ ) ;
				chara カメラ設定 サブカメラ１ \
					-c 0 \	
					-b $i:補完ＢＸ１,500,-32000 $i:補完ＢＸ２,7000,-1500 \
//					-b $i:補完ＢＸ１,500,-32000 $i:補完ＢＸ２,5900,-1500 \
					-l $i:補完ＬＸ１,500,-32000 $i:補完ＬＸ２,32000,-1600 \
					-r $i:補完ＲＸ,2048,0 \
					-f 8000 \
//					-f 5900 \
					-a 200 \
					-i $w:カメラ補完方式 -1 0 0 \
					-s $3
			}

//甲板南部４（屋根アリ）

		trap ca003 d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {


				if( $4 < 0 ){
					chara カメラ設定 サブカメラ２ \
						-c 0 \
						-b -14800,2000,-32000 -14100,32000,32000 \
						-l -32000,-32000,-32000 32000,32000,32000 \
						-r 60,2400,0 \
						-f 4000 \
						-a 200 \
						-i 3 -1 0 0 \
						-o 30 \
						-s $3 \
						-E 1 30 \ 			//$f:スライドタイプ $w:スライド待ち時間 \
							7000 4000 \ 		//$i:スライド距離１ $i:スライド距離２ \
							50 				//$i:スライドスピード [$i:スライドフラグ]

				}else{
					chara カメラ設定 サブカメラ２ \
						-c 0 \
						-b 14100,2000,-32000  14800,32000,32000 \
						-l -32000,-32000,-32000 32000,32000,32000 \
						-r 60,( 4096 - 2400 ),0 \
						-f 4000 \
						-a 200 \
						-i 2 -1 0 0 \
						-o 30 \
						-s $3 \
						-E 1 30 \ 			//$f:スライドタイプ $w:スライド待ち時間 \
							7000 4000 \ 		//$i:スライド距離１ $i:スライド距離２ \
							50 				//$i:スライドスピード [$i:スライドフラグ]

				}

			}



//左舷死体遺棄場所（屋根アリ）
		trap ca020l d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {
				chara カメラ設定 サブカメラ３ \
					-c 1 \
					-p -18108,4722,-8975 \
					-t -17958,1244,-10756 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3
			}

//右舷死体遺棄場所（屋根アリ）
		trap ca020r d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {
				chara カメラ設定 サブカメラ３ \
					-c 1 \
					-p 18108,4722,-8975 \
					-t 17958,1244,-10756 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3
			}


//左舷甲板４奥（屋根アリ）
		trap ca021l d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {
				chara カメラ設定 サブカメラ３ \
					-c 1 \
					-p -19562,5124,-15194 \
					-t -19021,1581,-17606 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3
			}

//右舷甲板４奥（屋根アリ）
		trap ca021r d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {
				chara カメラ設定 サブカメラ３ \
					-c 1 \
					-p 19562,5124,-15194 \
					-t 19021,1581,-17606 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3
			}


//１Ｆ階段西
		trap ca004l d:PLAYER \
			-camera \
			-mask ？ \
			-exec {
				if ( $5 < 2000 && $4 > -11000 ) {	//階段の下除外するため

					/* 階段を下から上に昇る */
					chara カメラ設定 サブカメラ３ \
						-c 0 \
						-b -13224,4164,331 -13224,4164,331 \
						-l -32000,-32000,-32000 32000,32000,32000 \
						-f 8000 \
						-a 200 \
						-i 3 -1 0 0 \
						-z 0x00700000 \		//遊びなしカメラ
						-s $3

				} else if( $5 > 2000 ){

					/* 階段を上から下へ降りる */
					chara カメラ設定 サブカメラ３ \
						-c 1 \
						-p -12206,6958,-991 \
						-t -11325,813,-4727 \
						-a 200 \
						-i 3 -1 0 0 \
						-s $3

				}

