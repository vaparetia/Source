	none_drop_start,	/*0*/
	sna_non_drop_start_behind_t,
	none_drop,
	none_drop_r,
	none_drop_l,
	none_drop_end_fence,	/*5*/
	none_drop_end_wall,
	none_drop_idle_tired,
	non_elude_fall_start,
	non_elude_fall,
	non_elude_fall_damage,	/*10*/
	non_elude_fall_out,
	non_elude_fall_normal,
	non_drop_dam,
	non_drop_pullup_start,
	non_drop_pullup_idle,	/*15*/
	non_drop_pullup_end,
	non_jump_up,
	non_jump_down_start,
	non_jump_down_loop,
	non_jump_down_end,	/*20*/
	non_jump_up_behind,
	non_carry_body_throw1,
};

