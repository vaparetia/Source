	proc 甲板船首ＯＮ{
				mesg プットオブジェ 船首１ on
				mesg プットオブジェ 船首２ on
				mesg プットオブジェ 船首３ on
				mesg プットオブジェ 船首４ on
	}

	proc 甲板船首ＯＦＦ{
				mesg プットオブジェ 船首１ off
				mesg プットオブジェ 船首２ off
				mesg プットオブジェ 船首３ off
				mesg プットオブジェ 船首４ off
	}


//###################################################################################
//									ビヨンド設定
//###################################################################################

	proc 甲板ビヨンド設定 {
		print '甲板ビヨンド設定'


// ３F南廊下
		// ------------------
			trap by000 d:PLAYER \
				-mask いる \
				-button d:ACTION_BUTTON \		//ビヨンドボタン
				-state 0,4 \	//立ち状態or張り付き
				-exec {
					mesg プレイヤー d:PLAYER shadow 0
					@南向きビヨンド発動 by000 8000 $4 -2750 2750 0x00002
				}
			trap by000 d:PLAYER \
				-camera \
				-mask いる \
				-state 6 \	// 強制モーション中
