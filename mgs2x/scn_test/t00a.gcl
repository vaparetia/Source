}

//###################################################################################
//									甲板敵兵設定
//###################################################################################
	// 甲板敵兵セット

#define	左舷通常巡回		0
#define	右舷通常巡回		1
#define	右舷長距離巡回		2
#define	３Ｆ全体巡回		3
#define	３Ｆハード警戒		4
#define	３Ｆノーマル警戒	6
#define	３Ｆイージー警戒	7
#define	攻撃兵右舷待機		5
#define	攻撃兵左舷待機		8
#define	攻撃兵警戒巡回		9

	proc 警備兵０ {
		//左舷１Ｆ
		chara 警備兵 敵兵:01 -r d:左舷通常巡回 -n 0 -d -8750,0,-4500 甲板
		//右舷２Ｆ
		chara 警備兵 敵兵:02 -r d:右舷通常巡回 -n 0 -d 12500,3000,-9750 甲板
		//最後尾３Ｆ
		chara 警備兵 敵兵:03 -r d:３Ｆノーマル警戒 -n 1 -d -6500,6000,3000 甲板
	}


	proc 警備兵コマンダー {
		chara 警備コマンダー wccomm -e { 警備兵０ }
	}

	proc 攻撃兵０{
		chara アタッカー 攻撃兵 \
			-r 5 \				//$b:初期ルート \
			-c	9 \
			-e	0 				// $w:装備タイプ
	}

	proc 攻撃兵コマンダー{
		chara 攻撃コマンダー 攻撃コマンダー \
			-e { 攻撃兵０ } \
			-wait	(60*3) \	//危険開始時の出動遅らせ時間
			-avoidwait (60*5) \	//回避モードで始まる場合のみ有効
			-status	0
	}

	proc 甲板敵兵セット {
		print '甲板敵兵セット設定'

		chara コマンダー 敵兵セット \
			-w 警備兵コマンダー \
			-a 攻撃兵コマンダー \
			-r -18500,0,-17000 甲板 18500,0,-17000 甲板 \
			-c -8750,0,-2000 甲板 8750,0,-2000 甲板 0,6000,6500 甲板 0,0,8500 甲板

	}
