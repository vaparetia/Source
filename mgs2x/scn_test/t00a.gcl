					-l -32000,-32000,-32000 32000,32000,32000 \
					-r 120,2000,0 \
					-f 10000 \
					-a 200 \
					-i 2 -1 0 0 \
					-s $3
			}


//３Ｆ右舷(階段上がったところ)

		trap ca006r d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {

				chara カメラ設定 サブカメラ１ \
					-c 0 \
					-b 13000,-32000,-5000 32000,9000,32000 \
					-l -32000,-32000,-32000 32000,32000,32000 \
					-r 120,(4096 - 2000),0 \
					-f 10000 \
					-a 200 \
					-i 2 -1 0 0 \
					-s $3

			}
		


//３Ｆ踊り場
		trap ca007 d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {
				if ( $4 < 0 ) { eval( $i:補完ＲＹ = 2000 ) ;
				} else { 	eval( $i:補完ＲＹ = 4096 - 2000 ) }

				@CS_スムーズカメラ昇順 $6 -12000 -3000 9000 11000 
				eval( $i:補完ＢＹ = $i:CS_結果１ ) 

				chara カメラ設定 サブカメラ１ \
					-c 0 \
					-b -32000,-32000,-32000 32000,$i:補完ＢＹ,32000 \
					-l -32000,-32000,-32000 32000,32000,32000 \
					-r 200,$i:補完ＲＹ,0 \
					-f 10000 \
					-a 200 \
					-i 2 -1 0 0 \
					-s $3
			}




//３Ｆ縦通路
		trap ca008 d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {
				if ( $4 < 0 ) { eval( $i:補完ＲＹ = 2048 - 150 ) ;
				} else { 	eval( $i:補完ＲＹ = 2048 + 150 ) ;}
				eval( $i:割合Ｚ = (( $6 + 5000 ) / 100 ));
//				eval( $i:補完ＲＸ = 100 * $i:割合Ｚ / 100 );
				eval( $i:補完ＲＸ = 200 );
				eval( $w:補完Ｔ = 6000 - 1500 * $i:割合Ｚ / 100 );


				chara カメラ設定 サブカメラ１ \
					-c 0 \
					-b -32000 -32000 -32000 32000 32000 32000 \
					-l -32000 -32000 -32000 32000 32000 32000 \
					-r $i:補完ＲＸ,$i:補完ＲＹ,0 \
					-f $w:補完Ｔ \
					-a 200 \
					-i 2 -1 0 0 \
					-s $3 \
					-E 1 120 \
						7000 5000 \
						1


//	-slidE $f:スライドタイプ $w:スライド待ち時間 \
//	       $i:スライド距離１ $i:スライド距離２ \
//	       $i:スライドスピード [$i:スライドフラグ]

// スライドカメラ設定方法
// スライドタイプ：０／１ − 左右タイプ／前後タイプ
// スライド待ち時間：スライドするまでの待ちフレーム数
// スライド距離１・２：左右タイプの場合 左右スライド距離
//		       前後タイプの場合 接近距離、離れた距離
// スライドスピード：そのまんま
// スライドフラグ ：
//		1にしておくと、入った時スライドしていない状態から始まります。

			}

//３Ｆ横通路
		trap ca009 d:PLAYER \
			-camera \
			-mask いる \
			-exec {

				@CS_左右スライドカメラ $4 1800 90 $i:カメラ位置Ｘ 
				eval( $i:カメラ位置Ｘ = $i:CS_結果１ )
				if( $i:カメラ位置Ｘ < -5490 ) { eval( $i:カメラ位置Ｘ = -5490 ) }
				if( $i:カメラ位置Ｘ >  5490 ) { eval( $i:カメラ位置Ｘ =  5490 ) }

				chara カメラ設定 サブカメラ１ \
					-c 1 \
					-p $i:カメラ位置Ｘ ( $5 + 3000 ) ($6 + 5000) \
					-t $i:カメラ位置Ｘ ($5 + 1000) $6 \
					-a 200 \
					-i 2 -1 0 0 \
					-s $3 \
					-E 0 90 \
						2000 2000 \
						1

/*
				@CS_左右スライドカメラ $4 1800 90 $i:カメラ位置Ｘ 
				eval( $i:カメラ位置Ｘ = $i:CS_結果１ )
				if( $i:カメラ位置Ｘ < -5490 ) { eval( $i:カメラ位置Ｘ = -5490 ) }
				if( $i:カメラ位置Ｘ >  5490 ) { eval( $i:カメラ位置Ｘ =  5490 ) }

				chara カメラ設定 サブカメラ１ \
					-c 1 \
					-p $i:カメラ位置Ｘ ( $5 + 1000 ) ($6 + 4500) \
					-t $i:カメラ位置Ｘ $5 $6 \
					-a 200 \
					-i 2 -1 0 0 \
					-s $3 \
					-E 0 90 \
						2000 2000 \
						1
*/

			}

//		trap ca009 d:PLAYER -mask 出る -proc CS_左右スライドカメラ後処理
			




//甲板南部１（最後尾）
		trap ca000 d:PLAYER \
			-mask ？ \
			-exec {

				if( $3 == 入る ){
					eval( $f:甲板スネークca000にいる = 1 )

				}else{
					eval( $f:甲板スネークca000にいる = 0 )

				}

			}




	}


