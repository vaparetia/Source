proc セッションスタート{
}

proc メンバーログイン $:メンバＩＤ {

	eval( $i:tmp = $:メンバＩＤ )
#if 0
	command マップ設定 甲板 -set {
		chara ネット対応プレイヤー d:PLAYER \
						-m sna_def \
						-a snake \
						-p 4839 0 16224 \
						-d 0, 1024, 0 \
						-l 4000 \
						-f 0x00000001 \
						-s 0 \
						-o sna_w00a \
						-i 0 \
						-E $i:tmp
	}
#else
	command マップ設定 甲板 -set {
		chara うそスネーク d:PLAYER -p 4839 0 16224 \
						-d 0, 1024, 0 \
						-E $i:tmp
	}
