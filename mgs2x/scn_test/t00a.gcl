				-exec {

					chara カメラ設定 ビヨンドカメラ \
						-c 1 \
						-p 13363,6171,5058 \
						-t 11604,1049,2477 \
						-a 200 \
						-i 0 -1 0 0 \
						-s $3


				}



//左舷クレーン南側
		// ------------------
			trap by022l d:PLAYER \
				-mask いる \
				-and \
				-dir 0,256 2048,256 \
				-button d:ACTION_BUTTON d:ACTION_BUTTON \		//ビヨンドボタン
				-state 0,4 \	//立ち状態or張り付き
				-exec {

					mesg プレイヤー d:PLAYER shadow 0


					@南向きビヨンド発動 by022l 4000 $4 -11750 -9000 0x000002

#if d:すぐおりエルード
					chara delay ディレイ -time 110 -exec {

							command パッド操作 \
								-press d:PAD_B 		// 指定ボタンをそのフレームだけおしたことにする
					}

#endif


				}

