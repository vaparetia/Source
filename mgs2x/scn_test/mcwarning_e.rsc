/*
	ファイル名		mcwarning_e.rsc
	作成日			2001/08/06
	作者			K.Kano
	説明			起動直後に出るメモリーカード警告メッセージ
					ZOEのソースからそのまま持ってきた
	$Id: mcwarning_e.rsc,v 1.1 2002/02/01 06:08:31 usr01475 Exp $
*/

resource メモリーカード警告メッセージ {
// 0
空き無し:
	'There is insufficient space|'
	'on the MEMORY CARD (PS2).'
	'At least ?KB of free space|'
	'is needed to save your game.|'
	'Will you start the game as it is?'

// 1
カード無し:
	'There is no MEMORY CARD (PS2)|'
	'inserted.|'
	'At least ?KB of free space|'
	'is needed to save your game.|'
	'Will you start the game as it is?'

// 2
エラー:
	'There was an error when detecting|'
	'the MEMORY CARD (PS2).|'
	'At least ?KB of free space|'
	'is needed to save your game.|'
	'Will you start the game as it is?'

// 3
はい:
	'Yes'

// 4
いいえ:
	'No'
};
