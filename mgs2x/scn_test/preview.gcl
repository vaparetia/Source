//#include "preview.gcl"

print 'pre1'


proc 人間キャラの影作成 {
	// 影投影モデル -m 影投影専用モデル -p 設置位置
	chara 影投影モデル 影投影モデル -m stage -p 0,3,0

	// 影管理 -t 光源タイプ -l 光源距離(並行光源時のみ有効) -p 並行光源方向直接指定
	chara 影管理 影管理 -t 0 -l 6000
}


chara マップ プレビュー -k null -h stage,0 -l stage

command マップ設定 プレビュー -set {
	print 'pre2'

	chara カメラ ステージカメラ	-c 0 -l 3 -p 0 

	chara プレビューカメラ preview

	print 'pre3'

	chara カメラ設定 ステージカメラ \
		-c 0 \	
		-b -32000,-32000,-32000 32000,32000,32000 \
		-l -32000,-32000,-32000 32000,32000,32000 \	
		-r 512,2048,0 \
		-f 8000 \
		-a 200 \
		-i 1 -1 0 0 \
		-s 1

	print 'pre4'

	chara プレイヤー スネーク \
		-m raiden \
		-a snake \
		-p 0,2000,0 \
		-d 0,2048,0 \
		-l 4000 \
		-f 0x00000000 \
		-s 0

#if 0
	chara ヌルオブジェ ヘリ \
		-x 5000,5000,5000 \
		-r 0,0,0 \
		-m raiden \
		-a motion \
		-n 0

	chara ヌルオブジェ 顔アニメスネーク \
		-x 3000,0,6000 \
		-r 0,0,0 \
		-m raiden \
		-a motion \
		-n 0
#endif


	chara プレビュー環境用オブジェすり替え オブジェすり替え１ \
		-x -3000,1000,3000 \
		-r 0,0,0

	chara プレビュー環境用オブジェすり替え オブジェすり替え２ \
		-x 0,1000,3000 \
		-r 0,0,0

	chara プレビュー環境用オブジェすり替え オブジェすり替え３ \
		-x 3000,1000,3000 \
		-r 0,0,0


	chara プレビュー環境用頂点アニメ 頂点アニメ１ \
		-x 0,0,6000 \
		-r 0,0,0

	chara プレビュー環境用頂点アニメ 頂点アニメ２ \
		-o 2 \
		-n 12

	@人間キャラの影作成
} 

command マップ表示 -show プレビュー

