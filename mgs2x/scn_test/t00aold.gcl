//###################################################################################
//									仮トラップ設定
//###################################################################################


proc 仮トラップ設定{

	trap Zangou0 d:PLAYER \
		-mask 入る \
		-exec {
			mesg ネット敵テスト ネット敵 塹壕攻撃開始 d:PLAYER
			mesg ネット敵テスト ネット敵２ 塹壕攻撃開始 d:PLAYER
			mesg ネット敵その２ 普通敵１ 塹壕攻撃開始 d:PLAYER
		}
	trap Zangou0 d:PLAYER \
		-mask 出る \
		-exec {
			mesg ネット敵テスト ネット敵 攻撃開始 d:PLAYER
			mesg ネット敵テスト ネット敵２ 攻撃開始 d:PLAYER
		}

	trap Zangou1 d:PLAYER \
		-mask 入る \
		-exec {
			mesg ネット敵テスト ネット敵 塹壕攻撃開始 d:PLAYER
			mesg ネット敵テスト ネット敵２ 塹壕攻撃開始 d:PLAYER
		}
	trap Zangou1 d:PLAYER \
		-mask 出る \
		-exec {
			mesg ネット敵テスト ネット敵 攻撃開始 d:PLAYER
			mesg ネット敵テスト ネット敵２ 攻撃開始 d:PLAYER
		}

	trap  Zone_of_die d:PLAYER \
		-mask 入る \
		-exec {
			print 'Zone_of_die'
			mesg ネット敵テスト ネット敵 攻撃停止 d:PLAYER
			mesg ネット敵テスト ネット敵２ 攻撃停止 d:PLAYER
			mesg ネット敵テスト ネット敵 逝ってよし
			mesg ネット敵テスト ネット敵２ 逝ってよし
//			mesg ネット敵テスト ネット敵 攻撃開始 d:PLAYER
//			mesg ネット敵テスト ネット敵２ 攻撃開始 d:PLAYER
		}
}


//###################################################################################
//									跳弾番号設定
//###################################################################################

proc 跳弾番号設定 {
	print 'Tyoudan setting'
	// ------------------------------------
		command 跳弾ノーマル -n 0
		command 跳弾ノーマル -n 1
		command 跳弾ノーマル -n 2
		command 跳弾ノーマル -n 12
		command 跳弾ノーマル -n 13
		command 跳弾ノーマル -n 14
		command 跳弾ノーマル -n 15
}





	