// プレイヤー 
// ------------------------------------
proc プレイヤー設定 {
	print 'stage t00a'

	chara ネット対応プレイヤー d:PLAYER \
					-m sna_def rai_def_mt gbs_defDXT2 gbs_defDXT2\
					-a snake \
					-p 2000 1000 -6000 \
						-8000 2000 -5000 \
						-5000 2000 -5000 \
						-6000 2000 -5000 \
					-d 0, 0, 0 \
					-l 4000 \
					-f 0x00000001 \
					-s 0 \
					-o sna_w00a \
					-i 0 

	command スタート同期カウンタ

	chara ネットゴール ゴール \
			-p 26000, 26000, -48000 \
			-w 3000 \
			-d 3000 

#if 1
	chara ネット敵テスト ネット敵 \
			-p 5000, 10000, -31000 \
			-d 0 

	chara ネット敵テスト ネット敵２ \
			-p 9000, 10000, -31000 \
			-d 0 

	chara ネット敵その２ 普通敵１ \
			-p 1000, 10000, -31000 \
			-d 0 


#endif
	
	@仮トラップ設定
}



// カメラ設定 
// ------------------------------------
proc カメラ設定 {
	print 'camera setting'

	chara カメラ ステージカメラ		-c 0 -l 3 -p 0 
	chara カメラ 塹壕カメラ０		-c 0 -l 2 -p 30 
	chara カメラ 塹壕カメラ下０		-c 0 -l 2 -p 20 

	chara カメラ 駆け抜けカメラ０１	-c 0 -l 2 -p 30 

	chara カメラ 塹壕カメラ１		-c 0 -l 2 -p 30 
	chara カメラ 塹壕カメラ下１		-c 0 -l 2 -p 20 

	chara カメラ 駆け抜けカメラ１２	-c 0 -l 2 -p 30 

	chara カメラ 砲座へ突撃カメラ	-c 0 -l 2 -p 30 
	chara カメラ 砲座カメラ			-c 0 -l 2 -p 30 
	chara カメラ 階段前カメラ		-c 0 -l 2 -p 30 
	
	chara カメラ 階段左カメラ		-c 0 -l 2 -p 20 
	chara カメラ 階段右カメラ		-c 0 -l 2 -p 20 	


	
	chara カメラ設定 ステージカメラ \
		-c 0 \	
		-b -62000,   500,-62000 62000,62000,62000 \
		-l -62000,   500,-62000 62000,62000,62000 \
		-r 390,2048,0 \
		-f 18000 \
		-a 200 \
		-i 1 -1 0 0 \
		-s 1

}
	

proc 塹壕カメラ設定 {
	print 'zangou camera setting'

	trap Zangou0 d:PLAYER \
		-camera \
		-mask ＊ \
		-exec {
			chara カメラ設定 塹壕カメラ０ \
			-c 0 \	
			-b -62000, 1000,-62000 62000,62000,62000 \
			-l -62000, 1000,-62000 62000,62000,62000 \
			-r 50,2048,0 \
			-f 6026 \
			-a 190 \
			-i 1 -1 0 0 \
			-s $3
		}

	trap Zangou1 d:PLAYER \
		-camera \
		-mask ＊ \
		-exec {
			chara カメラ設定 塹壕カメラ１ \
			-c 0 \	
			-b -62000, 1000,-62000 62000,62000,62000 \
			-l -62000, 1000,-62000 62000,62000,62000 \
			-r 50,2048,0 \
			-f 6026 \
			-a 190 \
#if 0
			-r 76,2048,0 \
			-f 6750 \
			-a 200 \
#endif
			-i 1 -1 0 0 \
			-s $3
		}

	trap ZangouDown0 d:PLAYER \
		-camera \
		-mask ＊ \
		-exec {
			chara カメラ設定 塹壕カメラ下０ \
			-c 0 \	
			-b -62000, 1000,-62000 62000,62000,62000 \
			-l -62000, 1000,-62000 62000,62000,62000 \
			-r 672,2048,0 \
			-f 10290 \
			-a 200 \
			-i 1 -1 0 0 \
			-s $3
		}

	trap ZangouDown1 d:PLAYER \
		-camera \
		-mask ＊ \
		-exec {
			chara カメラ設定 塹壕カメラ下１ \
			-c 0 \	
			-b -62000, 1000,-62000 62000,62000,62000 \
			-l -62000, 1000,-62000 62000,62000,62000 \
			-r 672,2048,0 \
			-f 10290 \
			-a 200 \
			-i 1 -1 0 0 \
			-s $3
		}

	trap HouzaSaka d:PLAYER \
		-camera \
		-mask ＊ \
		-exec {
			chara カメラ設定 砲座へ突撃カメラ \
			-c 0 \	
			-b -62000, 1000,-62000 62000,62000,62000 \
			-l -62000, 1000,-62000 62000,62000,62000 \
			-r 48,2206,0 \
			-f 10401 \
			-a 190 \
#if 0
			-r 180,2172,0 \
			-f 13000 \
			-a 273 \
#endif
			-i 1 -1 0 0 \
			-s $3
		}

	trap HouzaFloor d:PLAYER \
		-camera \
		-mask ＊ \
		-exec {
			chara カメラ設定 砲座カメラ \
			-c 0 \	
			-b -62000, 1000,-62000 62000,62000,62000 \
			-l -62000, 1000,-62000 62000,62000,62000 \
			-r 266,2048,0 \
			-f 16300 \
			-a 240 \
			-i 1 -1 0 0 \
			-s $3
		}

	trap KaidanMae d:PLAYER \
		-camera \
		-mask ＊ \
		-exec {
			chara カメラ設定 階段前カメラ \
			-c 0 \	
			-b -62000, 1000,-62000 62000,62000,62000 \
			-l -62000, 1000,-62000 62000,62000,62000 \
			-r 60,1999,0 \
			-f 14852 \
			-a 238 \
			-i 1 -1 0 0 \
			-s $3
		}


	trap KaidanHidari d:PLAYER \
		-camera \
		-mask ＊ \
		-exec {
			chara カメラ設定 階段左カメラ \
			-c 0 \	
			-b -62000, 1000,-62000 62000,62000,62000 \
			-l -62000, 1000,-62000 62000,62000,62000 \
			-r 627,1774,0 \
			-f 8500 \
			-a 200 \
			-i 1 -1 0 0 \
			-s $3
		}




