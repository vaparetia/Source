			'w32a' mv_w28a_w32a_0
			'w32b' mv_w32a_w32b_0
			'w41a-1' mv_w24d_w41a_0
			'w41a-AFTER_GOUMON' mv_init_GOUMONGO
			'w42a' mv_w41a_w42a_0
			'w43a' mv_w42a_w43a_0
			'w44a' mv_w43a_w44a_0
			'w45a' mv_w44a_w45a_0
