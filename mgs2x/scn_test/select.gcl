//
//	select.gcl
//
#include "varinit.h"
#include "sload.h"

//シナリオ班環境のみデバッグ入れるびっち。
#if d:MGS2_SCN
	#ifdef d:EU_TRIAL
		#include "cdc_debug.h"
	#else
	//ＸＸＸＸＸＸＸＸＸＸＸＸＸｘ
		#include "cdc_debug.h"
		#include "cdc_debug_p.h"
	#endif
#endif

#include "vox_test.h"

if ( $w:プログラム結果 == 9999 ) {
	/* デバッグリセットからSELECTにきた */
	eval ( $w:プログラム結果 = 0 )
	eval ( $b:res_mode = d:RES_SELECT )

	command 変数初期化
	eval($w:ゲーム設定 = d:LEVEL_NORMAL)
	@タンカー編ストーリーフラグ初期化
	@プラント編ストーリーフラグ初期化
	@グローバル変数初期化 $w:ゲーム設定
	@プレイヤー初期設定 $w:ゲーム設定 スネーク
	@プレイヤー初期設定 $w:ゲーム設定 ライデン
}

if( $f:sound_test ){
	@vox_test
	eval( $f:sound_test = 0 );

	return;
}

proc mv_vox_test {
	eval( $f:sound_test = 1 );
	load 'select' -r 'r_tnk0'
}

proc mv_ending_0 {
	eval( $i:プレイヤー初期Ｘ位置 = 0 ) ;
	eval( $i:プレイヤー初期Ｙ位置 = 0 ) ;
	eval( $i:プレイヤー初期Ｚ位置 = 0 ) ;
	load "ending" -r r_plt0 ;
}

proc set_lang_english {
	eval( $w:言語 = d:LANG_ENGLISH );
	command 字幕言語設定
	chara delay リスタートディレイ \
		-time 30 \
		-exec {
			restart -save
		}
}

proc set_lang_french {
	eval( $w:言語 = d:LANG_FRENCH );
	command 字幕言語設定
	chara delay リスタートディレイ \
		-time 30 \
		-exec {
			restart -save
		}
}

proc set_lang_german {
	eval( $w:言語 = d:LANG_GERMANY );
	command 字幕言語設定
	chara delay リスタートディレイ \
		-time 30 \
		-exec {
			restart -save
		}
}

proc set_lang_italian {
	eval( $w:言語 = d:LANG_ITALY );
	command 字幕言語設定
	chara delay リスタートディレイ \
		-time 30 \
		-exec {
