//静止スポットライトとの連動をします

command 光源消し[NewCom_DestroyLight] \
	-pos     $v:場所 \
	-radius  $i:半径   // 省略すると4000.0f(投光器の消す半径)
//光源を消します

chara スポット雨[NewSpotRain] $s:名前 \
        -ratio  $i:コーン角度 \
	-sphere $i:有効範囲 \
	-to     $v:目標位置 \
        -from   $v:場所
mesg スポット雨 $s:名前 消す[0]

//現在未使用
chara プット箱型オブジェ[NewPutBoxObject] $s:名前 \
	-l $s:光源 \
        -m $s:モデル名 ... \
	-p $i:パラメータ ... \
	-f $i:フラグ
//パラメータの詳細
// 向きx 向きy  位置x 位置y 位置z
//を1セットとしてモデルの個数分だけ用意する
// フラグは以下のものがあり、ビットを立てることによりその機能を選択できる
//	0x00000001 移動あり(衝撃により移動する。)
//	0x00000002 回転あり(衝撃により回転する。なしの場合はY軸回転のみ)
//	0x00000004 ハザードあり(移動回転の際 周りのハザードを見る、なしの場合は最初だけ)
//	0x00000008 密度あり(モデルの大きさに動きが比例)
//	0x00000010 箱同士の当たりあり(未完成)
//	0x00000020 光源計算あり

//現在未使用
chara プット箱型ハザード[NewPutDynamicHzxBox] $s:名前 \
        -m $s:モデル名 ... \
	-p $i:パラメータ ...
//パラメータの詳細
// 向きx 向きy  位置x 位置y 位置z
//を1セットとしてモデルの個数分だけ用意する




// 指定したSEを鳴らす
chara プットＳＥ鳴らし[NewPutSeSound] $s:名前 \
	-sound    $i:ＳＥコード ... \  // ＳＥコードを羅列する
	-mode     $i:モード         \  // 鳴らし方を決める
	-interval $i:間隔フレーム   \  // 間隔のフレームを決める
	-pos      $v:鳴らす位置        // 鳴らす位置を決める(必須)
// w00c の旗の音は、-poswだけでうまくなります
// -mode は以下のものがある
//	0	ランダムに鳴らす



//ソリダス戦 専用キャラ
//
chara プット壊れビル窓[NewBuildingWindow] $s:名前 \
	-target $v:最大点  $v:最小点  \
	-model  $s:壊れ窓モデル名 ... \
	-pos    $v:場所     /* 欲しい数だけ繰り返す */



//フォーチュン戦 専用キャラ
//
chara ボスフォーチュン[NewFortune] $s:名前 \
        -model $s:シングルモデル名 $s:マルチモデル名 \
        -pos   $v:出現位置 \
        -dir   $v:出現方向 \
        -proC  $p:プロック群 ... \
        -voice $t:ストリーム音声 ... \
        -flag  $i:各種フラグ

//-proc は以下の順番に書くこと
//	弾避けのカット			フォーチュンに向かった弾を撃った時
//	グレネード不発カット		フォーチュンに向かってグレネードを投げた時
//	フォークリフトのカット		フォークリフトのカット（未使用）
//	エレベータスイッチのカット	スイッチカット見せのプロック
//	エレベータが下がる		エレベータに降りろメッセージを出すため
//	ゲームエンド			フォーチュンにかった時

mesg ボスフォーチュン $s:名前 マルチウェイト表示[2]
mesg ボスフォーチュン $s:名前 シングルウェイト表示[3]
//呼ばれた瞬間にシングル／マルチの表示に切り替わります

mesg ボスフォーチュン $s:名前 フォーチュン静止[4] $i:姿勢 $i:方向
//姿勢は、立ち（０）しゃがみ（１）ビハインド立ち（２）ビハインドしゃがみ（３）の何れかです。
//方向は。３６０°を４０９６で
mesg ボスフォーチュン $s:名前 フォーチュン静止解除[5]
//「フォーチュン静止」と同フレームに呼び出しても解除しないので注意して下さい。
mesg ボスフォーチュン $s:名前 フォーチュン強制移動[6] $i:Ｘ座標変数 $i:Ｙ座標変数 $i:Ｚ座標変数
//強制的に指定先に走って移動します
mesg ボスフォーチュン $s:名前 フォーチュン瞬間移動[7] $i:Ｘ座標変数 $i:Ｙ座標変数 $i:Ｚ座標変数 $i:方向
//その瞬間に指定先に移動します
mesg ボスフォーチュン $s:名前 全機能停止[8] $i:停止フレーム数
//指定したフレーム数だけ全機能を停止する（モーションの再生も）
//256フレーム以上は禁止
mesg ボスフォーチュン $s:名前 デモスキップ可能[9]
//カットインデモをスキップできるようになる
mesg ボスフォーチュン $s:名前 デモ開始[10]
//カットインデモの重複を避けるため デモ開始プロックにはこのメッセージを入れること
mesg ボスフォーチュン $s:名前 デモ終了[11]
//カットインデモの重複を避ける デモ終了プロックにはこのメッセージを入れること
mesg ボスフォーチュン $s:名前 スローモーション再生開始[12]
//フォーチュンの再生スピードを遅くする
mesg ボスフォーチュン $s:名前 スローモーション再生終了[13]
//フォーチュンの再生スピードを元に戻す

//フォーチュンの現在の位置をとります
command ゲットフォーチュン座標[NewGetFortunePos] \
	$r:Ｘ座標変数 $r:Ｙ座標変数 $r:Ｚ座標変数
command ゲットフォーチュン弾座標[NewGetFortuneBulletPos] \
	$r:Ｘ座標変数 $r:Ｙ座標変数 $r:Ｚ座標変数
command ゲットフォーチュングレネード座標[NewGetFortuneBombPos] \
	$r:Ｘ座標変数 $r:Ｙ座標変数 $r:Ｚ座標変数
command フォーチュン索敵初期化[FRT_AIM_InitAimSpot] //最初の方に入れて下さい。


chara フォーチュン戦ライデン隠れオブジェ[NewFortHideObject] $s:名前 \
        -light $s:光源 \
        -flag  $i:フラグ \
        -type  $i:タイプ \
	-phAse $i:壊れフェーズ \
	-move  $i:相対登録順 \
	-slide $v:ずり落ち場所 \
	-proC  $p:プロック ... \
        -rot   $i:向き \
        -pos   $v:場所

//オプションの順序は、上の通り-typeから-posを繰り返して記述して
// -flag -lightは、最初に一度だけ書いて下さい。
// -flag に１を入れるとフォーチュンがいなくても上がります。
//    1 フォーチュンがいなくても上がる
//    2 壊れ物維持
//    4 当たりなし機能
//あと順繰りに入れていけば複数おけます。
// -slide 下のコンテナが壊されてずり落ちる場合にその位置を指定する。下
//のコンテナが何であるかは -modeで指定する。
// -move 指定したコンテナをずり落す。指定の仕方は、自分を0として登録順
// にいくつ離れているかを指定する。例えば一つ前なら -mode -1を指定する。
// -slideと-modeは、下のフラグを立てるのを忘れずに！！

// タイプは、下のdefineをお使い下さい
#define FRT_WOODEN_1M    0x0001
#define FRT_WOODEN_BRK   0x0002
#define FRT_CONTAINER1A  0x0003 /* 全く壊れていない */
#define FRT_CONTAINER1B  0x0004 /* あと1発で壊れる  */
#define FRT_CONTAINER1C  0x0005 /* 壊れ切った後     */
#define FRT_CONTAINER1D  0x0006 /* 壊れ切った後     */
#define FRT_CONTAINER2A  0x0007 /* 全く壊れていない */
#define FRT_CONTAINER2B  0x0008 /* 穴のみ  */
#define FRT_CONTAINER2C  0x0009 /* 穴のみ  */
#define FRT_CONTAINER2D  0x000a /* 穴のみ  */
#define FRT_CONTAINER2E  0x000b /* 上部が飛ぶ */
#define FRT_CONTAINER2F  0x000c /* 上部が飛ぶ */
#define FRT_CONTAINER2G  0x000d /* 半壊 */
#define FRT_CONTAINER2H  0x000e /* ほぼ全壊 */
#define FRT_CONTAINER2I  0x000f /* 全壊 */
#define FRT_EXPL_CAN_A   0x0010
#define FRT_EXPL_CAN_B   0x0011
#define FRT_EXPL_CAN_C   0x0012
#define FRT_EXPL_CAN_BRK 0x0013
#define FRT_FORKLIFT_A   0x0014 /* 全く壊れていない */
#define FRT_FORKLIFT_B   0x0015 /* あと1発で壊れる  */
#define FRT_FORKLIFT_C   0x0016 /* 壊れ切った後     */
#define FRT_FORKLIFT_D   0x0017 /* 壊れ切った後     */
#define FRT_EXPL_DRUM_RA 0x0018 /* 全く壊れていない */
#define FRT_EXPL_DRUM_RB 0x0019 /* 火花飛び         */
#define FRT_EXPL_DRUM_RC 0x001a /* 爆発             */
#define FRT_EXPL_DRUM_RK 0x001b /* 爆発             */
#define FRT_CONTAINER1E  0x001c /* 全く壊れていない(傾き壊れ) */
#define FRT_CONTAINER1F  0x001d /* あと1発で壊れる  */
#define FRT_CONTAINER1G  0x001e /* 壊れ切った後     */
#define FRT_EXPL_DRUM_LA 0x001f /* 全く壊れていない */
#define FRT_EXPL_DRUM_LB 0x0020 /* 火花飛び         */
#define FRT_EXPL_DRUM_LC 0x0021 /* 爆発             */
#define FRT_EXPL_DRUM_LK 0x0022 /* 爆発             */
#define FRT_CONTAINER1H  0x0023 /* 全く壊れていない(不滅) */
#define FRT_CONTAINER1I  0x0024 /* あと1発で壊れる  */

//タイプに付随させてフラグ管理もしています。
#define FRT_SHADOW0      0x00000000 /* 影優先上げ       */
#define FRT_SHADOW1      0x00000100 /* 影優先上げ       */
#define FRT_SHADOW2      0x00000200 /* 影優先上げ       */
#define FRT_SHADOW3      0x00000300 /* 影優先上げ       */
#define FRT_SHADOW4      0x00000400 /* 影優先上げ レベル上げ  */
#define FRT_SYNMETRY     0x00001000 /* 左右反転         */
#define FRT_SLIDEOFF     0x00002000 /* ずり落ちる       */
#define FRT_ON_ME        0x00004000 /* ずり落ちブロックが上にある */
#define FRT_UPPER_DECK   0x00008000 /* 上にある */

//フォーチュン  おわり

chara フォーチュン戦揺れライト[NewFortHangLight] $s:名前 \
        -model    $s:ハンガーモデル $s:ライトモデル  $s:壊れライトモデル \
	-volume   $s:ライトコモデル  $s:ボリュームモデル \
        -pos      $v:位置 \
        -rot      $v:向き \
	-light    $s:光源 \
	-brk_flag $i:壊れフラグ \
	-hazard   $i:ハザードＩＤ \
	-flag     $i:フラグ
//現在、フラグは未使用
//ライトコモデルは、光の洩れを加算で表現されているもの
//ボリュームモデルは、光のモワモワ感が出ているもの
mesg フォーチュン戦揺れライト $s:名前 ライト管理[0] $i:フラグ（天井君の返り値）
command フォーチュン戦揺れライト壊れフラグ取得[NewCom_FRT_HNG_GetBreakFlag] \
	-name $s:名前 -flag $r:壊れフラグ


chara フォーチュン戦壁ライト[NewFortWallLight] $s:名前 \
        -model    $s:ライトモデル $s:銃壊れモデル \
		  $s:ふっ飛び壊れモデル $s:ライトコモデル \
        -pos      $v:位置 \
        -rot      $v:向き \
	-light    $s:光源 \
	-brk_flag $i:壊れフラグ \
	-hazard   $i:ハザードＩＤ \
	-flag     $i:フラグ
//現在、フラグは 0x10 が X座標シンメトリ
//ライトコモデルは、光の洩れを加算で表現されているもの

chara フォーチュン戦巻き上げ煙 [NewFortDynamicFlow] $s:名前 \
	-b $i:バンダリ ... \		// XYZ のセット２つ
	-s $i:パーティクルサイズ

chara フォーチュン戦オイル燃え [NewOilSpread] $s:名前 \
	-life $i:燃えの寿命 \
	-time $i:広がる時間 \
	-lifT $i:底上げの高さ（パカパカ防止） \
	-pos  $v:広がり位置

chara フォーチュン戦プットモーション [NewFortPutMotion] $s:名前 \
	-kms_model  $s:シングルモデル \
	-evm_model  $s:マルチモデル \
	-mar_motion $s:モーション（ＭＡＲ） \
	-motion_Num $i:モーション番号 \
	-rotation   $v:回転 \
	-position   $v:位置 \
	-prOc       $p:プロック \
	-flag       $i:フラグ
//フラグに FRT_MOTION_STOP を立てておけば再生は開始されず1フレーム目のポーズで止まる
//プロックは、モーションの一番最後のフレームで呼ばれます。
//コントロールがないので当たりを見ることが出来ませんが
//かなり軽々のキャラです。（フォーチュン戦に限ったキャラではありません）
#define    FRT_MOTION_NOMOVE  0x0001 //再生しても場所が動かない
#define    FRT_MOTION_LOOP    0x0002 //ループ再生
#define    FRT_MOTION_STOP    0x0004 //再生停止
mesg フォーチュン戦プットモーション $s:名前 回転設定[0] $i:Ｘ軸回転角 $i:Ｙ軸回転角 $i:Ｚ軸回転角
mesg フォーチュン戦プットモーション $s:名前 位置設定[1] $i:Ｘ座標 $i:Ｙ座標 $i:Ｚ座標
mesg フォーチュン戦プットモーション $s:名前 再生停止[2]
mesg フォーチュン戦プットモーション $s:名前 再生開始[3] $i:モーション番号 $i:補間レート
mesg フォーチュン戦プットモーション $s:名前 繰返し再生開始[4] $i:モーション番号 $i:補間レート


chara フォーチュン戦昇降機スイッチ [NewFortElevatorButton] $s:名前 \
	-up   $v:上ボタン位置 \
	-down $v:下ボタン位置 \
	-mode $i:初期ボタン
//-modeは１で上ボタンが押されている状態
//-modeは０で下ボタンが押されている状態
mesg フォーチュン戦昇降機スイッチ $s:名前 上ボタンを押す[0]
mesg フォーチュン戦昇降機スイッチ $s:名前 下ボタンを押す[1]
mesg フォーチュン戦昇降機スイッチ $s:名前 緑に点灯[2]
mesg フォーチュン戦昇降機スイッチ $s:名前 赤に点灯[3]

chara フォーチュン戦昇降機 [NewPutElevator] $s:名前 \
	-e_Model   $s:昇降機モデル \
	-e_Top     $v:昇降機上端位置 \
	-e_Bottom  $v:昇降機下端位置 \
	-e_Pos     $v:昇降機初期位置 \
	-e_Rot     $v:昇降機回転 \
	-e_Dir     $i:昇降機速度向き＋かー \
	-prOc      $p:プロック ... \
	-trap      $s:トラップ ... \
	-name      $s:搭乗者の名前 \
	-kms_model $s:搭乗シングルモデル \
	-evm_model $s:搭乗マルチモデル \
	-motion    $s:搭乗モデルモーション（ＭＡＲ） \
	-rotation  $v:搭乗モデル回転 \
	-position  $v:搭乗モデル位置 \
	-vib_always \
	-flag      $i:フラグ
// -kms_model から -position までは、昇降機に載っている物。
// -kms_model から -positionの順に載せたい個数分だけ指定する
// evm の場合は、モーションが要る kmsも要るので悪しからず
//位置、回転は、昇降機での相対位置(昇降機モデルの中心位置)
//シャッターは、閉じた状態で二つの扉がくっつく位置を入れて下さい。
//-e_dir は昇降機の昇降状態を示します。１以上なら上昇 ０未満なら下降
//(省略可)
//-e_pos は昇降機の初期位置です。(省略可)
// 必要データは w11a2_shatter.kms w11_shatter.mar で固定です。どうして
//も変えたい場合は、森田まで
//-proc は 上昇可能プロック 到着プロック をこの順に指定下さい。
//     上昇可能プロック  シャッターが閉じ始める瞬間（敵兵がいない時）に呼ばれます
//     到着プロック      到着しシャッターが開き始める瞬間に呼ばれます
//-trap は 起動トラップ 敵兵チェックトラップ をこの順に指定下さい。
//      起動トラップ          プレーヤーがこのトラップにはいると起動します
//      敵兵チェックトラップ  敵兵ががこのトラップにはいると起動しません
// -vib_always プレーヤーが昇降機に乗っていなくても振動する
//-flag は以下のものを指定します。複数指定の場合は orして指定して下さい。
#define FRT_ELV_W11     0x0001   //w11?で使う場合に指定します(下側)
#define FRT_ELV_W12     0x0002   //w12?で使う場合に指定します(上側)
#define FRT_ELV_OPEN    0x0280   //シャッターが開いた状態（つまりはエレベータはいる）
#define FRT_ELV_CLOSE   0x0300   //シャッターが閉じた状態（つまりはエレベータはいない）

mesg フォーチュン戦昇降機 $s:名前 下がる[0] // スイッチ＆シャッターの連動無し
mesg フォーチュン戦昇降機 $s:名前 上がる[1] // スイッチ＆シャッターの連動無し
mesg フォーチュン戦昇降機 $s:名前 モーション停止[2] // 搭乗物のモーションを一時停止
mesg フォーチュン戦昇降機 $s:名前 モーション再生[3] // 搭乗物のモーションを再生開始
mesg フォーチュン戦昇降機 $s:名前 降下[4]   // スイッチ＆シャッターの連動あり
mesg フォーチュン戦昇降機 $s:名前 上昇[5]   // スイッチ＆シャッターの連動あり
mesg フォーチュン戦昇降機 $s:名前 強制振動ＯＮ[8]   // 振動を強制的にする
mesg フォーチュン戦昇降機 $s:名前 強制振動ＯＦＦ[9] // 振動はプレーヤーの時のみ

//昇降機の現在の位置を取得します
command フォーチュン戦昇降機位置取得[NewComPUT_ELV_GetPos]
//昇降機内のボムを全て消去します
command フォーチュン戦昇降機ボム消去[NewComPUT_ELV_EraseBomb]



chara フォーチュン戦天井崩れ [NewFortCeiling] $s:名前 \
	-model $s:壊れ前天井モデル $s:壊れ後天井モデル \
	-pos   $v:位置 \
	-prOc  $p:壊れ呼出プロック \
	-break $s:瓦礫モデル名  $s:瓦礫モーション名  $i:瓦礫モーション番号  $v:瓦礫位置 \
	-aim   $v:標的位置
// -aim   は ５個まで
// -break は ３個まで
mesg フォーチュン戦天井崩れ $s:名前 表示管理[1] $i:フラグ（天井君の返り値）
command フォーチュン戦天井崩れ表示管理[NewCom_FRT_CEL_Control] $i:フラグ（天井君の返り値）




//手繋ぎイベント 狙撃イベント 専用キャラ
//
chara エマ・ロッカーの中にいる[NewEmmaLocker] $s:名前 \
        -pos      $v:出現位置 \
	-voice    $i:音声SE ...
//ロッカーの中から物音に反応して声を発します。
//音声は、3つまでしか取りません。 複数指定した場合は、ランダムになります。

chara エマ・エメリッヒ[NewEmma] $s:名前 \
        -model    $s:シングルモデル名 $s:マルチモデル名 \
        -pos      $v:出現位置 \
        -dir      $i:出現方向 \
        -route    $i:ルート番号 $i:ポイント番号 \
	-hide     $v:隠れ場所 ... \
        -proC     $p:プロック群 ... \
        -faR      $s:ＦＡＲファイル（顔アニメ用） \
        -damAge   $i:銃ダメージ $i:爆発系ダメージ \
        -speed    $i:移動スピード \
        -voice    $d:音声リソース \ //「include emavoice.h」を入れること
        -vitaLity $i:ＭＡＸライフ ... \
        -flag     $i:各種フラグ \
	-sTage    $i:ステージＩＤ \     // 下のデファインを使って下さい。
	-idcarD   $i:ＩＤ存在フラグ \   // IDカードなし
	-hate_Slater \              // 舟虫がいるので近付いたらhideに逃げる
	-no_Glasses \               // 眼鏡を掛けません
	-no_Idcard                  // IDカードなし

// -idcard は、フラグを渡して、ＩＤカードの装備を制御できます。
// -no_idcard は、ＩＤカード無しです。 -idcardより優先してしまいます。
// -no_glasses あ、眼鏡が取れます。

//-vitality はマックス値（メーターに反映）を入れ、現在のライフがあれば
//入れて下さい。つまり、使いかたは、
//  -vitality マックス値
//  -vitality マックス値 現在値
//の何れかになります。
//-dir は、エマの初期方向を表し、単位は４０９６ラジアンです。y軸方向の
//みの回転です。それ以外の挙動は、現在制御できません。
//-speed は、移動速度をして出来ます。デフォルトの移動を１００として入
//力して下さい。つまり倍の速度で出したい場合は、２００を入力して下さい。
//-hide には、隠れ場所を指定できます。エマを置いていってしまった場合に
//いる場所です。舟虫の避難場所にもなります。
//
//-voiceには、かならずinclude emavoice.hを記述し以下のようにGCLの方に
//書き入れるようにして下さい。
//	-voice [emma_voice:vox_list]
//ストリーム音声は、list/emma_vox.lssが内容ですが、プログラムと同期し
//ておりますので勝手には追加市内で下さい。
//
//-proc には、
//	ゲームオーバープロック		エマによってゲームオーバーになったとき呼ばれるプロック
//	狙撃イベントプロック×15個	狙撃イベントの各ノードで呼ばれるプロック
//	狙撃イベントプロック×2個	それぞれ、敵が攻撃し始め、敵攻撃終了したとき呼ばれる
//の順番に -proc の場所に書いていく。プロックが要らない場合は、プログ
//ラマ要相談です。
//-flag は、source/user/morita/emma/include/emma_flag.h のフラグを立て
//ることで初期状態としてその効果を得ることが出来る。狙撃イベントの時で
//は、かならずd:ema_t:EMA_F_EVENT_SNIPEを立てなければならない。
//
//-stage は以下のデファインを使うように宜しくお願い致します。
#define    EMA_STG_W28A 0
#define    EMA_STG_W25D 1
#define    EMA_STG_W31B 2
#define    EMA_STG_W31D 3
#define    EMA_STG_W31F 4
// これを設定していたして頂くことで、エマがステージことにいってはなら
//ない場所に行かなくなります。主にドアの向こう。向うに飛ばされてしまっ
//たエマも自力で戻ってきます。
// 手繋ぎエマの場合は「command プラグインエマ手繋ぎ -motion rai_ee」
//を必ず「chara エマ・エメリッヒ」のあとに入れるようにして下さい。プレー
//ヤーとエマが必ず起動している必要があります。

mesg エマ・エメリッヒ $s:名前 待機[4] /* 非表示、無処理 */
mesg エマ・エメリッヒ $s:名前 復帰[5] /* 表示、処理開始 */
mesg エマ・エメリッヒ $s:名前 無敵開始[6] /* 無敵は、桟橋に乗り降りすると解除されてしまう */
mesg エマ・エメリッヒ $s:名前 無敵終了[7] /* 無敵解除状態でも送ってOK。しかし昇降時は送るべからず */
mesg エマ・エメリッヒ $s:名前 ダメージ[8] $i:ダメージ量 /* ダメージを食らう */
mesg エマ・エメリッヒ $s:名前 強制瞬間移動[9] $i:Ｘ座標変数 $i:Ｙ座標変数 $i:Ｚ座標変数 /*エマを瞬間的に指定位置に移動させる */
mesg エマ・エメリッヒ $s:名前 回復可能[10]       /* エマの自動回復を許可（狙撃イベントのみ） */
mesg エマ・エメリッヒ $s:名前 回復不可能[11]     /* エマの自動回復を拒否（狙撃イベントのみ） */
mesg エマ・エメリッヒ $s:名前 強制手繋ぎ解除[12] /* 強制的に手を外します       */
mesg エマ・エメリッヒ $s:名前 スタン有効[13]     /* スタンが効くようになります */
mesg エマ・エメリッヒ $s:名前 スタン無効[14]     /* スタンが効かなくなります   */
mesg エマ・エメリッヒ $s:名前 強制目覚まし[15]     /* 強制的に起きます(起きるモーションが出ます)   */
mesg エマ・エメリッヒ $s:名前 強制手繋ぎ[16]       /* 強制的に手を繋ぎます(確実に手を繋がすのは毎フレーム呼ぶこと)   */
mesg エマ・エメリッヒ $s:名前 強制隠れ位置移動[17] /* 強制的に隠れます。現在の位置から最も近い隠れ場所に瞬間移動します。 */
mesg エマ・エメリッヒ $s:名前 セットライフ[18] $i:ライフ値 /* ライフをセットします。 */
mesg エマ・エメリッヒ $s:名前 強制方向指定[19] $i:角度 /* 強制的に指定した向きに方向を変えます */
mesg エマ・エメリッヒ $s:名前 振動オン[20]     /* 振動を開始します */
mesg エマ・エメリッヒ $s:名前 振動オフ[21]     /* 振動をしません   */
mesg エマ・エメリッヒ $s:名前 プロック実行[22] $p:プロック /* 指定したプロックを実行します */
mesg エマ・エメリッヒ $s:名前 狙撃用待機[23] /* 狙撃用 非表示、無処理(ゲージを消さない) */
mesg エマ・エメリッヒ $s:名前 狙撃用復帰[24] /* 狙撃用 表示、処理開始 */

mesg エマ・エメリッヒ $s:名前 手繋ぎ不可能[25] /* 手繋ぎ用 手繋ぎ不可能(強制的に手も離す) */
mesg エマ・エメリッヒ $s:名前 手繋ぎ可能[26]   /* 手繋ぎ用 手繋ぎ可能 */
mesg エマ・エメリッヒ $s:名前 背中Ｃ４落す[27] /* 背中についているＣ４を落す */
mesg エマ・エメリッヒ $s:名前 徘徊不可能[28] /* 手繋ぎ用 徘徊不可能(危険時に歩かなくなる) */
mesg エマ・エメリッヒ $s:名前 徘徊可能[29]   /* 手繋ぎ用 徘徊可能  (危険時に歩かなくなる) */

command ゲットエマ座標[NewEMA_CommandGetPosition] $r:Ｘ座標変数 $r:Ｙ座標変数 $r:Ｚ座標変数
command ゲットエマ足元座標[NewEMA_CommandGetFloor] $r:Ｘ座標変数 $r:Ｙ座標変数 $r:Ｚ座標変数
//エマの現在の位置を得ることができる
command ゲットエマライフ[NewEMA_CommandGetLife] $r:変数
//エマの現在の位置を得ることができる
command ゲットエマ手繋ぎ状況[NewEMA_CommandGetLink] $r:変数
//エマとライデンの手繋ぎ状況が分かる
//0: 繋いでいない
//1: 手を繋いで静止
//2: 手を繋いで歩く
//3: 手を繋いで走る
//4: 手を繋いでしゃがむ
command ゲットエマ状態[NewEMA_CommandGetState] $r:状態変数
//エマの状況が分かります。分かる状況は以下のものです。
#define EMA_F_DO_NOTHING        0  /*何もしていません*/
#define EMA_F_I_AM_FAINTED      1  /*気絶中*/
#define EMA_F_I_AM_SLEEPING     2  /*眠り中*/
#define EMA_F_I_SAT_DOWN        3  /*座っています*/
#define EMA_F_ATTKED_BY_PLAYER  4  /*プレーヤーに攻撃された*/
#define EMA_F_ATTKED_BY_OTHERS  5  /*プレーヤー以外に攻撃された*/
#define EMA_F_I_DISLIKE_WORMS   6  /*虫をいやがっている最中*/
#define EMA_F_I_AM_CAPTURED     7  /*首締められている*/

//音声用コマンド
//基本的にエマのプログラムでならされる。ダメージを受けた場合など優先順
//位を付けた状態で鳴らすためのコマンドスネーク側か絵馬側かで呼び分ける
//必要がある
command 狙撃EmaStream[NewEMA_CommandStreamPlayEma] $t:音声ID -p $p:プロック
command 狙撃SnaStream[NewEMA_CommandStreamPlaySna] $t:音声ID -p $p:プロック
command 狙撃StreamStop[NewEMA_CommandStreamStop] $i:音声ハンドラ
command 指向性マイク音量パン[NewEMA_CommandGetMiceVolPan] \
	$i:位置Ｘ $i:位置Ｙ $i:位置Ｚ \  // 取りたいマイクの位置を指定
	$r:音量 ...                  // 取得する音量とパンを指定する


//強制的にエマを移動します。
//1フレーム遅れません。エマを
command  エマ強制瞬間移動[NewEMA_CommandForceMove] $i:位置Ｘ $i:位置Ｙ $i:位置Ｚ


//狙撃イベント用

chara 狙撃イベント設置クレイモア[NewEmmaClaymore] $s:名前 \
	-position $v:位置 \
	-rotate $v:回転 \
	-flag $i:フラグ \
	-prOc $p:終了プロック

chara ボス狙撃ヴァンプ[NewSniperVamp] $s:名前 \
        -model    $s:シングルモデル名 $s:マルチモデル名 \
        -pos      $v:出現位置 \           /* 出現位置 */
        -dir      $i:出現方向 \           /* 出現方向 */
        -proC     $p:プロック群 ... \     /* 下に説明あり */
        -voice    $t:ストリーム音声 ... \ /* 今の所ありません ので指定しなくてもOKです */
        -vitaLity $i:ＭＡＸライフ ... \   /* ライフ 及び M9 に反映されます */
	-hang     $i:首締め間隔時間 \     /* ヴァンプがエマを首締める間隔を0.1sec単位で指定 */
        -damAge   $i:銃ダメージ ... \     /* 銃ダメージ 麻酔ダメージ */
        -flag     $i:各種フラグ
//-vitalityはマックス値（メーターに反映）を入れ、現在のライフがあれば
//入れて下さい。つまり使いかたは、-vitality マックス値 or
//                                -vitality マックス値 現在値
//-dir ヴァンプの体の向きを表します。方向は、４０９６ラジアンです。y軸
//方向のみの回転です。
//-proc は、以下のものがあります。
//	ゲームエンドプロック	ヴァンプを倒した時に呼ばれる
//	以上
//-flag は、source/user/morita/vamp/include/vamp_flag.h のフラグを立て
//ることで初期状態としてその効果を得ることが出来る。
//-voice ストリーム音声、現在何もありません
//-hang 首締め間隔時間を指定します。0.1sec単位での指定です。首締めは、
//ある程度時間が立つと解けてしまうので気を付けてください
//-damage 銃ダメージ や 麻酔ダメージ を指定します。ダメージ数を指定す
//るのではなく、何回当たると死ぬかを指定します。

mesg ボス狙撃ヴァンプ $s:名前 非表示[0]           /*非表示にしアクトも止める*/

mesg ボス狙撃ヴァンプ $s:名前 表示[1]             /*表示にしアクトも再開    */
mesg ボス狙撃ヴァンプ $s:名前 エマを首締め開始[2] /*エマの首を強制的に締める(エマが既に居る場合のみ)*/

