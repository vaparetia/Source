	-joint	$i:間接番号

mesg 体舟虫 $s:name 這う[0]
mesg 体舟虫 $s:name 落とす[1]


chara 六角フェード[NewScrHexFade] $s:名前 \
	-time	$i:フェード時間 \	//大体になります。デフォルト100
	-mode	$i:インアウト \		//0:フェードin 1:フェードout
	-proc	$p:終了プロック \
	-col	$i:Ｒ $i:Ｇ $i:Ｂ \
	-ex								//これがあるとロードのフェードより強くなります

mesg 六角フェード $s:name 殺す[0]

