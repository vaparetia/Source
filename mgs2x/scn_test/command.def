/*2000.09.12 植原さんから引継ぎ*/


/*吉良さんへ引き渡し*/
chara レーダー[NewRadar] $s:名前 \
	-dir $i:角度
mesg レーダー $s:名前 off[0]
mesg レーダー $s:名前 on[1]

command レーダーズーム設定[NewRadarZoomRateControl] $i:ズームレート（1000が1.0）

chara タイマー[NewTimer] $s:名前 \
	-time $i:タイム \ /*NTSCフレーム数で指定(1分の場合3600)*/
	-proc $p:終了プロック \ /*タイム０の時に実行*/
	-mode $i:モード \
	-status	$i:ステータス
/*status */
#define TMR_WAIT		(0x01)	//一時停止状態で起動
#define TMR_INVISIVLE	(0x02)	//非表示状態で起動
#define TMR_DISP_ZERO	(0x08)	//タイムゼロになっても表示しつづける

/*mode*/
#define TMR_MIN		(0)	//分表示付き
#define TMR_SEC		(1)	//秒表示

mesg タイマー $s:名前 停止[0]
mesg タイマー $s:名前 開始[1]
mesg タイマー $s:名前 加算[2] $iタイム
mesg タイマー $s:名前 表示切り替え[3] $i:モード
/*表示切り替え ０−消す １−表示*/

command ゲット残りタイム[NewGetLeftTime]
command タイマー加算[NewAddLeftTime] -time $i:タイム  /*NTSCフレーム数で指定(1分の場合3600)*/
command セットタイマーステータス[NewSetTimerStatus] -s $i:ステータス
command アンセットタイマーステータス[NewUnsetTimerStatus] -s $i:ステータス
command タイマーエンド[NewTimerEnd] /*タイマー終了 この場合終了procは呼ばない*/
command ゲットタイマーステータス[NewGetTimerStatus]



/*ボスラッシュ用 カウントアップタイマー*/
chara ボスタイマー[NewTimer2] $s:名前 \
	-time $i:タイム \ /*NTSCフレーム数で指定(1分の場合3600)*/
	-mode $i:モード \
	-status	$i:ステータス


command ボスゲット残りタイム[NewGetLeftTime2]
command ボスタイマー加算[NewAddLeftTime2] -time $i:タイム  /*NTSCフレーム数で指定(1分の場合3600)*/
command ボスセットタイマーステータス[NewSetTimerStatus2] -s $i:ステータス
command ボスアンセットタイマーステータス[NewUnsetTimerStatus2] -s $i:ステータス
command ボスタイマーエンド[NewTimerEnd2] /*タイマー終了*/
command ボスゲットタイマーステータス[NewGetTimerStatus2]
command ボスゲットラップタイム[NewGetLapTime]

chara レーダー光点[NewSigRadPoint] $s:名前 \
	-pos $v:座標 \
	-col $w:色 /*色というかモード*/
#define		RADAR_COLOR_RED		0 /* ピーター用 */
#define		RADAR_COLOR_NODE	1 /* ノード用*/
mesg レーダー光点 $s:名前 kill[-1]


chara 攻撃コマンダー[NewAtCommander] $s:名前 \
	-e $p:アタッカーproc ... \
	-cover $i:エリア数 $v:遮蔽物 ... \
	-status	$i:ステータス \
	-wait	$i:待機時間 \			/*危険開始時の出動遅らせ時間*/
	-avoidwait $i:回避待機時間 \	/*回避モードで始まる場合のみ有効*/
	-video $w:ビデオ用モード
//	-cover $i:遮蔽エリア数 棚などの数
//$v:遮蔽物 ... \ /*座標二つ一組でひとつのエリアを設定*/
//	-status	$i:ステータス \
#define	AT_COM_WARP	(0x01)	//危険モード開始時にワープ
mesg 攻撃コマンダー $s:名前 ステータスセット[1] $i:フラグ


chara アタッカー[NewSigAttacker] $s:名前 \
	-r $b:初期ルート \
	-n $b:初期ノード \
	-s $i:ステータス \
	-i $w:視力 ... \
	-h $w:聴力 \
	-l $w:ライフ値 \
	-f $w:気絶値 \
	-e $w:装備タイプ \
	-d $v:守備位置 $s:マップ \
	-o $v:待避位置 \ /*守備位置に他の兵が近い時に使用*/
	-c $b:探索ルート \
	-v $w:声優 \
	-q $p:アイテムプロック $b:確率 ...2 \
	-a $p:ホールドアップアイテムプロック $b:確率 ...2 \
	-b $s:サポートする兵の名前 \ //サポート兵モードのみ有効
	-j $p:アイテムプロック $d:VERYEASY  $d:EASY  $d:NORMAL  $d:HARD  $d:EXTREME
// 装備タイプ
#define ENE_EQUIP_TYPE_NORMAL		0	// 標準
#define ENE_EQUIP_TYPE_SHIELD		1	// 盾
#define ENE_EQUIP_TYPE_LIGHT_SHIELD	2	// ライト付き盾
#define ENE_EQUIP_TYPE_SHOTGUN		3	// ショットガン
#define ENE_EQUIP_TYPE_HITECH_1		4	// ハイテク兵基本

mesg アタッカー $s:名前 ルート変更[1] $i:ルート番号
mesg アタッカー $s:名前 アクション終了[2]
mesg アタッカー $s:名前 警戒ルート変更[4] $i:ルート番号

chara 長廊下兵[NewSigDefender] $s:名前 \
	-q $p:アイテムプロック $b:確率 ...2 \
	-a $p:ホールドアップアイテムプロック $b:確率 ...2 \
	-j $p:アイテムプロック $d:VERYEASY  $d:EASY  $d:NORMAL  $d:HARD  $d:EXTREME \
	-r $b:初期ルート \
	-s $w:ステータス \
	-i $w:視力 ... \
	-l $w:ライフ値 \
	-f $w:気絶値 \
	-e $w:装備タイプ \
	-b $b:個別ＢＧＭ \
	-type $b:種類 \
	-proc $p:死亡時proc ...
// type:０左舷位置自動、１左舷位置mesg指定 ２右舷守備 ３右舷後方
mesg 長廊下兵 $s:名前 守備開始[0]
mesg 長廊下兵 $s:名前 追跡開始[1]
mesg 長廊下兵 $s:名前 ワープ[2] $i:位置Ｘ $i:位置Ｙ $i:位置Ｚ $s:マップ
mesg 長廊下兵 $s:名前 ルート変更[3] $i:ルート番号
mesg 長廊下兵 $s:名前 モード変更[4] $i:モード番号
mesg 長廊下兵 $s:名前 初期待機[5]
mesg 長廊下兵 $s:名前 守備位置設定[6] $i:位置番号
mesg 長廊下兵 $s:名前 ワープ無しルート変更[7] $i:ルート番号


chara 長廊下コマンダー[NewDefCommander] $s:名前 \
	-e $p:長廊下兵proc ... \
	-map $s:マップ ... \
	-defense $i:守備地点設定 ... \
	-type $b:タイプ設定 \
	-proc $p:proc ... \
	-final $v:位置判定基準 ... \
	-light $v:目標照明座標 ... \
	-count $i:照明破壊時間
mesg 長廊下コマンダー $s:名前 ライト破壊[1]  $i:番号
mesg 長廊下コマンダー $s:名前 再発生所替え[2] $i:場所番号

//ライトが破壊されたことを敵兵に通知
//守備地点は、Ｘ座標、Ｙ座標、Ｚ座標、アクション番号
//を一組としてポイント数分設定。最大6点。
//アクション番号	０ 右手攻撃 上下
//					１ 右手攻撃 下段
//					２ 左手攻撃 上下
//					３ 左手攻撃 下段
//マップも6箇所 各守備座標と同じ順番にそれぞれのマップ名を設定
//タイプは0左舷用と1右舷用


chara 天狗兵コマンダー[NewTngCommander] $s:名前 \
	-e $p:天狗兵proc ... \
	-type $b:タイプ設定 \ //0でw42用 1でw44w45用
	-defense $i:守備地点設定 ... \ //w42では無効
	-final $v:位置判定基準 ... \ //w42では無効
	-res  $v:再発生位置 ... \ //w42では無効
	-proc $p:全滅プロック \ //w42では無効
