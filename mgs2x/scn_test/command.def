	-c $w:輝度値
mesg 雨 $s:名前 オフ[0]
mesg 雨 $s:名前 オン[1]
mesg 雨 $s:名前 殺す[2]
mesg 雨 $s:名前 kill[-1]
mesg 雨 $s:名前 パーセンテージ[3] $i:シナリオＭＡＸを１００とする


