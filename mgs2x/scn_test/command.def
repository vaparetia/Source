chara ボスラッシュテロップ表示[NewSK_BossTelop] $s:名前 \
	-m $i:表示モード \
	-b $i:闘うボス名 \
	-n $p:終了時proc \
	-p $i:プレイヤー情報 

/* 説明
	表示モード
		0 : BOSS NAME + READY
		1 : FIGHT
		2 : WIN - Normal
		3 : WIN - Finish
	闘うボス名
		0 : オルガ
		1 : ファットマン
		2 : ハリアー
		3 : ヴァンプ
		4 : RAY
		5 : ソリダス
	プレイヤー情報 
		0 : Snake
		1 : Raiden
*/

