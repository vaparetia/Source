#define	STATE_CHAFF 0x00000010 // チャフ発動中
#define	STATE_STUN 0x00000020 // スタングレネード発動中
#define	STATE_CUT_IN 0x00000040 // カットインカメラ中
#define	STATE_PAUSE_DISABLE 0x00000200 // ポーズできない
