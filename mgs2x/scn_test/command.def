chara サイファ[NewCypher]  $s:名前	\
	-destroy	\ /* 一回破壊されたらデストロイアクター */
	-route		$i:ルート	$b:ノード\
	-xran		$i:横視野角	\ /*省略可*/
	-yran		$i:縦視野角	\ /*省略可*/
	-type		$i:タイプ	\/*0-NORMAL,1-GUN*/
	-i		$w:視力	...	\/*4つまで 通常 危険 警戒 回避 の順 */
	-speed		$i:最高速度	\ /*初期値80*/
	-kinkyuspeed	$i:緊急時最高速度 \ /* 省略可能 初期値 speedと同じ*/
	-fkasoku	$i:通常加速力 $i:緊急加速力\ /*初期値 200*/
	-skipFlag	$i:ショートカット	\ /*1:する  デフォルト 0:しない*/
	-wallcheck	$i:壁チェック		\ /*1:する  デフォルト 0:しない*/
	-active		$i:待機状態		\ /*1:待機  2:スーパーアンリアル  デフォルト 0:待機しない*/
	-proc		$p:破壊時プロック	\
	-touChaku	$p:到着プロック	$i:ルート番号 $i:ノード番号 \
	-zidouset	$i:待機ルート $i:中継ルート $i:追跡ルート \
	-noreturn	\ /* zidouset で追跡ルートに来た時にもどらない設定 */
	-life		$i:復活回数\/* zidouset 必須 待機ルートで復活 その危険モード中の復活回数*/
	-maxlife	$i:全体復活回数	\/* 全体の復活回数 life,maxlife 共に -1 で無限復活*/
	-emma		\ /* エマをターゲットに含める */
	-b		$i:高度 \ /*ハイポジション 追跡ルートで指定分高度を上げる 基本的にガンサイファ用*/
	-home		$i:帰宅場所 ...
