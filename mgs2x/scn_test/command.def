//---------------------------------------------------------------------
// 高部管理分
// <Takabe>

// ====== 実験関連キャラクタ定義
chara 高部実験プログラム[NewTestProgram] $s:名前
chara てすと[NewPrimTestProgram] $s:name
chara Prim2TestProgram[NewPrim2TestProgram] $s:名前
chara EvmTestProgram[NewEvmObjectTest] $s:name
chara DmapackTestProgram[NewDmapackTestProgram] $s:name
chara BlurTestProgram[NewBlurTest] $s:name
chara MenuPrintTest[NewMenuPrintTest] $s:name
chara ModelTest[NewModelTestProgram] $s:name
chara PatchTestProgram[NewPatchTestProgram] $s:name
chara ObjectPutTestProgram[NewTestObjectSet] $s:name \
	-pos $v:中心座標 -rot $v:初期向き -model $s:モデルＩＤ
chara ObjectPutTestProgram2[NewTestObject2Set] $s:name \
	-pos $v:中心座標 -rot $v:初期向き -model $s:モデルＩＤ
//chara IKDoll[NewInversKinematicTest] $s:name -pos $v:中心座標 -rot $v:初期向き
chara AnmtexTestProgram[NewTestAnmtexSet] $s:name -t $s:tri_id $s:tex_id -a $s:anmtex_id
command VRAM初期化[NewVramInitialize]
command メモリオフセット初期化[NewAllocDummyMemory]
chara モデル表示パフォーマンステスト[NewModelPerformanceTest] $s:name \
	-n $w:Ｘ配置数 $w:Ｚ配置数 \
	-d $w:Ｘ配置間隔 $w:Ｚ配置間隔 \
	-m $s:モデル名 $w:モデルタイプ（０：ＫＭＳ、１：ＥＶＭ） \
	-f $w:フラグ
// ====== 実験関連キャラクタ定義終了

chara 影投影モデル[NewShadowDrawObjectSet] $s:名前 \
	-model $s:影投影専用モデル \
	-pos $v:設置位置
// 影投影用モデルを設置する
// 「スポットライト投影モデル」キャラとは排他である

chara 影投影モデル２[NewShadowDrawObject2Set] $s:名前 \
	-ctrl $s:影投影を重ねるコントロール名
mesg 影投影モデル２ $s:名前 kill[-1]
// 影投影用モデルを指定したコントロールの保持するオブジェクトに重ねて設置する
// 「スポットライト投影モデル」キャラとは排他である

chara スポットライト投影モデル[NewSpotDrawObjectSet] $s:名前 \
	-model $s:影投影専用モデル \
	-pos $v:設置位置
// スポット投影用モデルを設置する
// 「影投影モデル」キャラとは排他である

chara 静止スポットライト設置[NewPutStaticSpotLight] $s:名前 \
	-pos $v:設置位置 \
	-dir $v:光源方向（自動的に正規化される） \
	-range $w:有効距離 \
	-angle $b:円錐角度（１度単位で、最大は１８０未満） \
	-color $b:光源色（赤） $b:光源色（緑） $b:光源色（青） \
	-fadeproc $p:フェードイン・アウト用コールバック \
	-option $i:オプションフラグ
mesg 静止スポットライト設置 $s:名前 on[1]
mesg 静止スポットライト設置 $s:名前 off[0]
mesg 静止スポットライト設置 $s:名前 fadein[2] $w:カウント（１／３００秒単位）
mesg 静止スポットライト設置 $s:名前 fadeout[3] $w:カウント（１／３００秒単位）
// スポットライトを設置する
// . . . .
// 同じ名前の「スポットライト投影モデル」を予め置いていないと効果がない
// フェードイン・アウトには終了検出用のコールバック用procを設定可能
// オプションフラグ詳細
//  0x0001:-dir指定を方向ベクトルではなく回転ベクトルとして認識
//  0x0002:OFF状態で起動する（デフォルトはONで起動）
//  0x0004:キャラに反映するライトを置かない（スポットライト投影のみに）
//  0x0010:高速画角切替え（おそらく使用しない）
//  0x0020:レイブン影用Y軸回転アニメーション
//  0x8000:デバッグ機能ＯＮ（２コンＬ１を押しながら操作）

command 壁床効果音設定[NewSetExchangeSeCode] \
	-id $b:変換テーブルID（０〜１２７） \
	-type $b:属性設定（０：床、１：壁） \
	-se $i:変換対象コード \
	-data $w:音コード $b:ノイズ音量 ...2 \	// 必ず８セット書くこと
	-clear // 内部のリストを全てクリアする（普通は使用しない）
// ノイズ音量定義
#enum {
	NOISE_ZERO ,
	NOISE_LOCKER_CLOSE ,	/* ロッカー閉まる音 */
	NOISE_MIC_QUEST ,	/* マイクで質問 */
	NOISE_HOLD ,
	NOISE_DEC ,	/* 拳銃デコック */
	NOISE_SS ,	/* 至近距離なら反応で白？ */
	NOISE_S,
	NOISE_CHOUDAN,	/* 跳弾御 */
	NOISE_SCREAM,
	NOISE_MM,
	NOISE_M,
	NOISE_L,
	NOISE_LL
};
// 壁床の効果音鳴らし分け用リストを作成する
// １回のコマンドで１つだけセットする（複数設定する場合には複数記述）
// 変換対象コード１つに対し、音コードは壁床属性番号に対応しているため
// 必ず８つ必要すること。
// また、変換テーブルIDはプレイヤーキャラやコマンダーキャラの様な
// 効果音を発生させるキャラに渡す必要があります。このID毎に違うもの
// 設定し、敵キャラにこの固有のIDを渡すことによりキャラ毎に異なる
// SEをならすことも可能です。

chara 遠景ぼかし[NewFarFocusEffectSet] $s:name \
	-plane	$b:最大描画枚数 \
	-near	$i:ぼかし最小距離 \
	-far	$i:ぼかし最大距離 \
	-enable // 起動時にオン
mesg 遠景ぼかし $s:名前 off[0]
mesg 遠景ぼかし $s:名前 on[1]
mesg 遠景ぼかし $s:名前 set[2] $w:補間時間 $b:補間タイプ $i:ぼかし最小距離 $i:ぼかし最大距離
// 最大距離と最小距離との間を最大描画枚数で指定した段階でぼかす
// メッセージにより途中で補間しながら影響距離を変更できる
// このときの補間時間は1/60秒単位ではなく1/300秒単位なので注意すること

chara 近景ぼかし[NewNearFocusEffectSet] $s:name \
	-plane	$b:最大描画枚数 \
	-near	$i:ぼかし最大距離 \
	-far	$i:ぼかし最小距離 \
	-enable // 起動時にオン
mesg 近景ぼかし $s:名前 off[0]
mesg 近景ぼかし $s:名前 on[1]
mesg 近景ぼかし $s:名前 set[2] $w:補間時間 $b:補間タイプ $i:ぼかし最大距離 $i:ぼかし最小距離
// 最大距離と最小距離との間を最大描画枚数で指定した段階でぼかす
// メッセージにより途中で補間しながら影響距離を変更できる
// このときの補間時間は1/60秒単位ではなく1/300秒単位なので注意すること

chara 鏡面モデル管理[NewMirrorControl] $s:name \
	-pos	$v:鏡面座標 \
	-axis	$b:反点軸		// 0:X軸反点 1:Y軸反点 2:Z軸反点
mesg 鏡面モデル管理 $s:名前 add[0] $s:追加キャラ
mesg 鏡面モデル管理 $s:名前 del[1] $s:削除キャラ
// 指定した座標で指定した軸方向に反転したモデルを生成する
// メッセージにより追加、削除ができるので部屋の入口のトラップなどに
// 引っかけて使用すると良い

chara 臨時顔アニメキャラ[NewE3FaceAnimationSet] $s:name \
	-chara	$s:キャラクタ名
mesg 臨時顔アニメキャラ $s:名前 モーション再生[0] $s:モーション名 $w:補間時間
mesg 臨時顔アニメキャラ $s:名前 視線変更[1] $w:タイプ [$w:補間時間 $v:注目座標]
// E３素材取り専用マルチウェイトエンベロープモデル顔アニメキャラ
// メッセージによりコントロールする（時間は全て1/300秒単位）
// ＜モーション再生コマンド捕捉＞
//  モーション名にはrmtファイルのファイル名を指定
// ＜視線変更コマンド捕捉＞
//  $w:タイプ = -1 視線はモーションに依存（補間時間、注目座標の指定は必要なし）
//            =  0 絶対座標による注目座標指定
//            =  1 頭部モデルからの相対座標による注目座標指定
//            =  2 カメラ目線（注目座標の指定は必要なし）
//

chara 顔アニメキャラ[NewFaceAnimationSet] $s:name \
	-fanim	$s:フェイスアニメファイル指定 \
	-chara	$s:キャラクタ名
mesg 顔アニメキャラ $s:名前 モーション再生[0] $s:モーション名
mesg 顔アニメキャラ $s:名前 視線変更[1] $w:タイプ [$w:補間時間 $v:注目座標]
// マルチウェイトエンベロープモデル顔アニメキャラ
// メッセージによりコントロールする（時間は全て1/300秒単位）
// ＜視線変更コマンド捕捉＞
//  $w:タイプ = -1 視線はモーションに依存（補間時間、注目座標の指定は必要なし）
//            =  0 絶対座標による注目座標指定
//            =  1 頭部モデルからの相対座標による注目座標指定
//            =  2 カメラ目線（注目座標の指定は必要なし）
//

chara スポットライト背景イメージ指定[NewSpotLightImageSet] $s:name \
	-image $s:テクスチャ名（raw形式イメージなので注意！（RGBARGBA・・・））\
	-file $s:ＩＰＵデータ名（stm形式をraw形式にリネームしたもの）\
	-movie $t:ムービー指定（ＩＰＵ形式ストリーム） \
	-proc $p:終了コールバック（ムービー指定を行ったときのみ）
mesg スポットライト背景イメージ指定 $s:名前 停止[0]
mesg スポットライト背景イメージ指定 $s:名前 イメージ変更[1]
mesg スポットライト背景イメージ指定 $s:名前 ムービー再生[2] $t:ムービー指定（ＩＰＵ形式ストリーム）
mesg スポットライト背景イメージ指定 $s:名前 テクスチャ許可[3] $w:オン・オフ指定
// スポットライト投影のプリミティブ描画のスポットライト模様の変わりに
// 使用する背景イメージを指定する
// IPUストリームによるムービーも再生可能
// IPUストリーム再生時に再生開始直後は$1=0、再生終了後直後は$1=1が設定され
// コールバックが呼ばれる
// オプションに-image,-file,-movieのいずれの指定も行わない場合はミックスストリーム
// モードになり、他のストリーム内に存在するＩＰＵストリームデータを参照しに行く
// （＝このキャラ自身はストリームの管理を行わずに、データのみを奪う。デモなどに使用）

chara 嵐の川波[NewStormyRiverWaveSet] $s:name \
	-tex $s:ＴＲＩファイル名 $s:テクスチャ名 $s:波頭テクスチャ \
	-pos $v:中心座標 \
	-ambient $b:ローカル環境光Ｒ $b:ローカル環境光Ｇ $b:ローカル環境光Ｂ \
	-color $b:ローカル並行光Ｒ $b:ローカル並行光Ｇ $b:ローカル並行光Ｂ \
	-dir $v:ローカル並行光ベクトル \
	-invisible $v:非表示バウンディング最小値 $v:非表示バウンディング最大値
mesg 嵐の川波 $s:名前 水しぶき発生[0] $s:キャラ名
// タンカー編用波オブジェクト
// テクスチャはこの波プログラム専用のテクスチャ単体でPACK_ALLしたTRIファイルが必要なので注意
// メッセージを送るとそのキャラが着水した場合に水しぶきを発生させることができる。

#if 0
chara キラキラ水面[NewReflectionWaterSurfaceSet] $s:name \
	-tex $s:ＴＲＩファイル名 $s:テクスチャ名 \
	-pos $v:中心座標 \
	-invisible $v:非表示バウンディング最小値 $v:非表示バウンディング最大値
mesg キラキラ水面 $s:名前 水しぶき発生[0] $s:キャラ名
// 室内用水面オブジェクト
// テクスチャはこの波プログラム専用のテクスチャ単体でPACK_ALLしたTRIファイルが必要なので注意
// このキャラは使わない
#endif

chara キラキラ水面２[NewReflectionWaterSurface2Set] $s:name \
	-tex $s:ＴＲＩファイル名 $s:テクスチャ名 \
	-pos $v:中心座標 \
	-force $w:波影響倍率（デフォルト＝１０） \
	-ctrl \	// これをつけると水面コントロールキャラによる水面高さの変更が可能に
	-alpha_blend \	// 強制５０％半透明
	-invisible $v:非表示バウンディング最小値 $v:非表示バウンディング最大値
mesg キラキラ水面２ $s:名前 波発生源追加[0] $s:キャラ名
mesg キラキラ水面２ $s:名前 波発生源削除[1] $s:キャラ名
mesg キラキラ水面２ $s:名前 表示位置移動[256] $v:座標
mesg キラキラ水面２ $s:名前 波影響倍率[257] $w:倍率（デフォルト＝１０）
// 室内用水面オブジェクト
// テクスチャはこの波プログラム専用のテクスチャ単体でPACK_ALLしたTRIファイルが必要なので注意
// メッセージを送るとそのキャラの動きによって水面に波が立つ。

chara 通路用水面[NewPassageWaterSet] $s:name \
	-tex $s:ＴＲＩファイル名 $s:テクスチャ名 \
	-pos $v:中心座標 \
	-num $w:Ｘ配置数 $w:Ｚ配置数 \
	-force $w:波影響倍率（デフォルト＝１０） \
	-wave $w:隣接影響スピード $w:減衰スピード $w:最小振幅力 \
	-scale $w:スケール（２５６で１倍）\
	-ctrl \	// これをつけると水面コントロールキャラによる水面高さの変更が可能に
	-alpha_blend \	// 強制５０％半透明
	-invisible $v:非表示バウンディング最小値 $v:非表示バウンディング最大値
mesg 通路用水面 $s:名前 波発生源追加[0] $s:キャラ名
mesg 通路用水面 $s:名前 波発生源削除[1] $s:キャラ名
mesg 通路用水面 $s:名前 表示位置移動[256] $v:座標
mesg 通路用水面 $s:名前 波影響倍率[257] $w:倍率（デフォルト＝１０）
mesg 通路用水面 $s:名前 開始[258]
mesg 通路用水面 $s:名前 停止[259]
// 室内用水面オブジェクト
// テクスチャはこの波プログラム専用のテクスチャ単体でPACK_ALLしたTRIファイルが必要なので注意
// メッセージを送るとそのキャラの動きによって水面に波が立つ。
// 開始／停止メッセージで処理を完全に停止させることができる
// 大きさは１倍のときに約１０ｍ四方になる

chara プラント海面[NewSeaSurfaceSet] $s:name \
	-single_mode \	// シングルテクスチャモード
	-bumpmap_mode \	// バンプマップモード
	-light_enable \		// ステージライト反映
	-tex $s:ＴＲＩファイル名 $s:テクスチャ名 $s:テクスチャ名 \
	-pos $v:中心座標 \
	-wave $w:隣接影響スピード $w:減衰スピード $w:最小振幅力 \
	-details_wave $w:隣接影響スピード $w:減衰スピード $w:最小振幅力 \
	-invisible $v:非表示バウンディング最小値 $v:非表示バウンディング最大値 \
	-rotate $w:環境マップ基準の回転 \
	-alpha_blend \	// 強制５０％半透明
	-flag $w:フラグ
mesg プラント海面 $s:名前 表示状態[2] $b:ＯＮ・ＯＦＦ
mesg プラント海面 $s:名前 slepp[3]
mesg プラント海面 $s:名前 wake[4]
mesg プラント海面 $s:名前 上下運動計算処理[5] $b:ＯＮ・ＯＦＦ
mesg プラント海面 $s:名前 表示位置移動[256] $v:座標
mesg プラント海面 $s:名前 テクスチャ変更[257] $s:テクスチャ名 ...
// テクスチャはこの波プログラム専用のテクスチャ単体でPACK_ALLしたTRIファイルが必要なので注意
// -waveオプションで指定する波アニメーションパラメータはデバッグモードで調整ができる
// -details_waveオプションは-waveより細かく指定可能(1~10000)
// テクスチャ変更は基本的にはデモ用です。
// 「sleep」メッセージを送ることで計算処理を止めることが出来ます。
// 「wake」メッセージか他のメッセージを送ることで目覚めます。
// $b:ＯＮ・ＯＦＦは 0:OFF, 1:ON と指定してください

chara 浮き橋[NewFlotingBridgeSet] $s:name \
	-pos $v:始点座標 $v:終点座標 \
	-n $w:配置個数 \
	-model $s:モデル名 \
	-flag $w:フラグ
mesg 浮き橋 $s:name 動的床強制更新禁止[0]
mesg 浮き橋 $s:name 動的床強制更新開始[1]
mesg 浮き橋 $s:name 表示状態[2] $b:ＯＮ・ＯＦＦ // ( 0:off 1:on )
// キャラ「プラント海面」が起動していなければならない。（w32a用）
// 指定した２点間に指定した個数の足場モデルを海面に浮かせる
// 浮き橋の上にＮＰＣなどを乗らせる場合には「動的床強制更新開始」
// メッセージを送らなければならない。動的床強制更新は処理が重たいので
// 必要がなくなったら「動的床強制更新禁止」メッセージを送る必要がある

chara プラント海面ハリアー戦[NewSeaSurfaceHarrierSet] $s:name \
	-single_mode \	// シングルテクスチャモード
	-bumpmap_mode \	// バンプマップモード
	-light_enable \		// ステージライト反映
	-tex $s:ＴＲＩファイル名 $s:テクスチャ名 $s:テクスチャ名 \
	-pos $v:中心座標 \
	-wave $w:隣接影響スピード $w:減衰スピード $w:最小振幅力 \
	-details_wave $w:隣接影響スピード $w:減衰スピード $w:最小振幅力 \
	-invisible $v:非表示バウンディング最小値 $v:非表示バウンディング最大値 \
	-rotate $w:環境マップ基準の回転 \
	-alpha_blend \	// 強制５０％半透明
	-flag $w:フラグ
mesg プラント海面ハリアー戦 $s:名前 表示状態[2] $b:ＯＮ・ＯＦＦ
mesg プラント海面ハリアー戦 $s:名前 slepp[3]
mesg プラント海面ハリアー戦 $s:名前 wake[4]
mesg プラント海面ハリアー戦 $s:名前 表示位置移動[256] $v:座標
mesg プラント海面ハリアー戦 $s:名前 テクスチャ変更[257] $s:テクスチャ名 ...
// ※ハリアー戦専用のプラント海面です※
// テクスチャはこの波プログラム専用のテクスチャ単体でPACK_ALLしたTRIファイルが必要なので注意
// -waveオプションで指定する波アニメーションパラメータはデバッグモードで調整ができる
// -details_waveオプションは-waveより細かく指定可能(1~10000)
// テクスチャ変更は基本的にはデモ用です。
// 「sleep」メッセージを送ることで計算処理を止めることが出来ます。
// 「wake」メッセージか他のメッセージを送ることで目覚めます。


chara 巨大海面[NewHugeSeaSurfaceSet] $s:name \
	-mipmap $b:最大ＬＯＤレベル $i:基準Ｚ値 $b:ＬＯＤ変化補正 \
	-tex $s:ＴＲＩファイル名 $s:テクスチャ名 ...1 \	// テクスチャ名は指定したＬＯＤレベル分必要！
	-pos $v:中心座標 \
	-size $i:基本サイズＸ $i:基本サイズＺ \	// 省略すると400000 400000
	-offset $w:パッチ曲面用ＬＯＤオフセット \	// -2~+2ぐらいの範囲で指定すること
	-light_enable \	// ステージライト反映
	-flag $w:フラグ
mesg 巨大海面 $s:名前 表示状態[2] $b:ＯＮ・ＯＦＦ
mesg 巨大海面 $s:名前 表示位置移動[256] $v:座標
// テクスチャには手動で変換を行ったTRIファイルが必要なので注意（dpackでは構築できない）
// ミップマップテクスチャは256x256以下のサイズで、基本サイズに対して１６回リピートして
// 貼り付けられる。
// 従って256x256のテクスチャがNxN四方にマッピングされる場合には基準Ｚ値2N、
// 基本サイズ16N,16Nとなるような値を設定するのが望ましい。

chara 影管理[NewShadowControl] $s:name \
	-type $b:光源タイプ \
	-length $i:光源距離（並行光源時のみ有効） \
	-parallel $v:並行光源方向直接指定（省略するとステージライトと同じになる） \
	-alpha $b:影濃度（平行光源時のみ有効０〜１２８まで）
mesg 影管理 $s:名前 add[0] $s:追加キャラ [$s:投影モデル名指定]
mesg 影管理 $s:名前 del[1] $s:削除キャラ
mesg 影管理 $s:名前 demo_add[2] $s:追加キャラ [$s:投影モデル名指定]
mesg 影管理 $s:名前 parallel[3] $v:並行光源方向指定
// 光源タイプ
//   0:無限遠並行光源（ステージの平行光に対して）
//   1:点光源エミュレーション（影フラグのついた点光源に対して）
// メッセージにより追加、削除ができるので部屋の入口のトラップなどに
// 引っかけて使用すると良い
// 投影モデル名指定を指定することで特定の投影モデルのみに投影することが可能
// また、すでに影を表示しているキャラに対してさらにaddでメッセージを
// 送ると投影モデル名のみの変更が可能です。

chara	ＲＡＹサーバー設置[NewPDRayServerSet] $s:name \
	-num $i:基準破壊数 \
	-proc $p:終了Proc \
	-flag $w:フラグ
// 量産型ＲＡＹ設置よりも先に起動してください
// 終了Procは基準破壊数に相当するダメージをＲＡＹに与えた場合に呼ばれる

chara	ＲＡＹステージ環境設定[NewPDRayStageEnvironmentSet] $s:name \
	-flag $w:フラグ
// デモでゲーム中と同じ環境を実現するキャラです。
// これは「ＲＡＹサーバー設置」キャラの内部でも呼ばれるためＲＡＹ戦
// ゲーム時には呼ばないようにしてください

chara	量産型ＲＡＹ設置[NewPDRaySet] $s:name \
	-pos $v:設置座標 \
	-dir $v:初期方向 \
	-resource $s:モデル $s:モーション \
	-end_proc $p:終了proc
// 終了procは実際には死んだときではなく、ライフが0になった直後に
// 呼ばれるので注意。（デモにつなぐため）

chara 真鏡面[NewTrueMirror] $s:name \
	-pos	$v:鏡面座標 \
	-axis	$b:反点軸 \		// 0:X軸反点 1:Y軸反点 2:Z軸反点
	-normal	$v:鏡面面の法線直接指定 \
	-enable // 起動時からＯＮに（デフォルトはＯＦＦで起動）
mesg 真鏡面 $s:name off[0]
mesg 真鏡面 $s:name on[1]
// 子画面との併用は不可！！
// -axis オプションと -normal オプションは排他なので注意
// -axis 0 と -normal 1,0,0 は同じ結果になる
// -axis 1 と -normal 0,1,0 は同じ結果になる
// -axis 2 と -normal 0,0,1 は同じ結果になる

chara アニメテクスチャセット[NewAnmtexSet] $s:name \
	-tex $s:ＴＲＩＩＤ $s:テクスチャＩＤ \
	-anmtex $s:アニメテクスチャＩＤ \
	-interval $w:再生間隔（デフォルト＝１） \
	-flag $w:各種フラグ
mesg アニメテクスチャセット $s:名前 start[0]	// 再生処理を再開
mesg アニメテクスチャセット $s:名前 stop[1]		// 再生処理を停止
mesg アニメテクスチャセット $s:名前 step[2]		// １フレームのみアニメーションを進ませる
// アニメテクスチャデータはdpackのanmtexコマンドで
// FIXの.BMPファイルから.rat形式データを生成する必要がある
// フラグ説明
//  0x0001:ループ再生
//  0x0002:停止状態で起動


chara ファットマン死体ＩＫ補正[NewFatmanPuppetIKSupportSet] $s:name \
	-chara $s:ファットマンのキャラ名

chara 偽ゲームオーバー画面[NewFakeGameOverSet] $s:name \
	-time $w:消滅までの時間（１／３００秒単位） \
	-x $s:TRI_ID $s:FAILD_TEX_ID $s:CONTINUE_TEX_ID $s:EXIT_TEX_ID \
	-proc $p:終了Proc \
	-vox $t:ジングル音声 \
	-flag $w:フラグ
// 表示に必要なテクスチャを指定する必要があります。とりあえず
// pack_all fake_gameover.tri \
//		2D/game_over/over_failed_alp_ovl.bmp \
//		2D/game_over/over_exit_alp_ovl.bmp \
//		2D/game_over/over_cont_alp_ovl.bmp
// と.srcに記述し、オプションに以下を指定すれば出ます
// -x fake_gameover over_failed_alp_ovl over_cont_alp_ovl over_exit_alp_ovl


chara ユーザードックタグ[NewUserDogtagSet] $s:name \
	-tri_id $s:ＴＲＩファイルＩＤ \
	-debug \
	-flag $w:フラグ
// このキャラを起動することでそのステージにおいてエンディング用ドックタグの
// バンプマップテクスチャをユーザー情報に書き換えます。このキャラ自体は
// モデルを表示する機能を持っているわけではないのでデモ上で普通にモデルを
// 出すことで効果を確認することが出来ます。
// -tri_idオプションはステージ構築時にドックタグ用テクスチャを別のＴＲＩと
// 一緒にパックした場合に使用します。デフォルトは"dogtag_mh_mt"です。
// -debug オプションは強制的にユーザー情報を設定します。デモの確認時などに
// 使用してください。但し、このオプションを残したままゲームに組み込むのは
// ＜絶対＞にやらないようお願いします。
// フラグは現在未使用


chara ＩＰＵ表示パネル[NewIPUDisplayPanelSet] $s:name \
	-tex $s:ＴＲＩ＿ＩＤ $s:テクスチャ \
	-uv $w:Ｕ０ $w:Ｖ０ $w:Ｕ１ $w:Ｖ１ \
	-num $w:表示枚数 \
	-pos $v:左上座標 $v:右上座標 $v:左下座標 $v:右下座標 ...12
// テクスチャはこのキャラ専用にダミーのＴＲＩを用意する必要がある
// ＵＶ値の指定は左上と右下を４０９６を１．０とみなして設定する
// -uv 0,512,4096,3584


// </Takabe>
// <libdg>

command カメラ視界チェック[NewViewCheckCommand] \
	-camera $b:カメラフラグ \
	-pos $v:チェック座標 \
	-bound $v:バウンディング座標０ $v:バウンディング座標１
// チェック座標もしくはバウンディングがカメラの視界内に入っているかをチェックする
// 視界内に全て、もしくは一部が入っている場合に１が返り、そうでなければ０が返る
// カメラフラグは以下のビットフラグの論理和で指定する
// 0x01 - メインカメラ
// 0x02 - サブカメラ
// 0x04 - ＜予約＞
// 0x08 - ＜予約＞
// 座標でのチェックとバウンディングでのチェックはどちか一方のみ有効なので注意！

command メインスクリーンサイズ変更[NewScreenSizeChange] \
	-scale $w:スケール
// メイン画面の描画領域サイズを強制的に変更する（使用には十分注意すること）
// スケールは1~256で指定し、256で通常の大きさになる

command クリッププレーン変更[NewChangeClipPlaneCommand] \
	-near $i:ニア距離 \
	-far $i:ファー距離
// ニア距離の変更は不具合が多発する可能性があるので基本的には使用禁止とする
// オプションを指定しなければデフォルト値が適用される
// near default : 50
// far default : 65536 * 20

command ステージライトＯＮＯＦＦ[NewSwitchLightCommand] \
	-change $b:ＯＮＯＦＦ指定 \
	-sphere $v:中心座標 $w:影響半径 \
	-bound $v:最大座標 $v:最小座標
// -change は０で消灯１で点灯させることが出来ます。省略時は０と見なします
// -sphere と -bound オプションは排他です。どちらかのみを使用してください
// 実際にプリシェードの再計算を行うので頻繁には使用しないでください
// 一部の光源タイプへの対応が不完全なので注意してください。

// </libdg>
// <mode/menu>

chara メニューフナムシ[NewMenuShipwormSet] $s:名前 \
	-speed $w:レーション食いつぶしスピード（秒単位）
mesg メニューフナムシ $s:名前 remove[0]
mesg メニューフナムシ $s:名前 transfer[1]
// transferメッセージで取り付き開始
// removeメッセージで強制的に排除することも可能

command メニューフナムシ取り付き状態取得[NewGetShipwormStatus]
// メニューにフナムシが取り付いている場合に１を返します

command 装備メニュー制御[NewEquipMenuControl] \
	-mic_mode $b:マイク説明状態（１で拡張説明を有効に）

command 装備自動選択セット[NewSetAutoSelect] \
	-item $w:選択アイテム装備 \
	-weapon $w:選択武器装備
// このコマンドでセットした後で装備メニューウィンドウを開くと
// 自動的にカーソルが指定した装備に移動する

chara	自動メニュー選択マネージャー[NewAutoMenuSelectManagerSet] $s:name \
	-pad $w:検出パッド指定（デフォルトはＲ３） \
	-num $w:最大指定数 \
	-command $b:タイプ（０：アイテム、１：武器） $w:装備 ...2
// 指定した検出パッドが押された時点で装備メニューの自動選択が発動します
// 但しメニューを開くこと自体はユーザー（パッドデモ）側で行ってください
// -commandは-numオプションで指定した数だけ必ず指定してください

// </mode/menu>
// <demo>

chara デモ再生実験[NewPolygonDemoFile] $s:名前 \
	-d 'ファイル名' \
	-wait
mesg デモ再生実験 $s:名前 起動[0]
// ファイルからデモを起動
// -waitオプションをつけることでメッセージが発行されるまで再生を開始しない
// （但し実際にはメッセージは受けとらない）

// </demo>
//---------------------------------------------------------------------


//---------------------------------------------------------------------
//岡嶋 okajima

chara プラント明滅ライト[NewPutTexturePlant] $s:名前 \
	-t $s:テクスチャ名 \
	-p $v:中心座標 ...\
	-u $v:回転中心 \ // 全体を回転させる中心座標XYZ(default:0,0,0)
	-r $i:Ｙ軸回転（４０９６系） \ // 全体を回転させる角度(default:0)
	-c $i:Ｒ $i:Ｇ $i:Ｂ $i:α ...4\
	-s $i:サイズ \
	-f $i:点滅フレーム（ＮＴＳＣ準拠）// 指定しない、もしくは０以下でつきっぱなし
// １６枚以上になるなら、もう一個キャラを呼んで下さい
mesg プラント明滅ライト $s:名前 ＯＦＦ[0]
mesg プラント明滅ライト $s:名前 ＯＮ[1]


chara ノード端末ディスプレイ[NewNodeLamp] $s:名前 \
	-r $i:Ｙ軸回転（４０９６系） \
	-p $i:中心座標 ... //

command 泡色変更[NewBubbleManyColorSet] $i:カラー
//0xRRGGBBAA で 表現
//0x00000000 で デフォルトに戻る
// 参考）デフォルト 0x60668020

chara ３Ｄビュー[NewView3d] $s:名前

chara 水中濁り[NewGasInWater] $s:名前 \
	-m $i:モード \ // （デフォルト 0）0：加算 1：減算 2：α加算 3 α減算
	-c $i:色（ＲＧＢα） ... // （デフォルト128,196,255,32）
mesg 水中濁り $s:名前 オフ[0]
mesg 水中濁り $s:名前 オン[1]
mesg 水中濁り $s:名前 殺す[2]
mesg 水中濁り $s:名前 kill[-1]


chara ライデン水中マスクの泡[NewRaidenMaskBubbleScn] $s:名前 \
	-n $s:キャラネーム
mesg ライデン水中マスクの泡 $s:名前 オフ[0]
mesg ライデン水中マスクの泡 $s:名前 オン[1]
mesg ライデン水中マスクの泡 $s:名前 殺す[2]
mesg ライデン水中マスクの泡 $s:名前 kill[-1]


chara 垂直水飛沫[NewAutoSplushVertical_Scn] $s:名前 \
	-p $i:中心座標のＸＺ２つ ... \ // Ｙは水面になる
	-w $i:幅 \
	-i $i:強さ


chara 天井照り返し[NewWaterReflect] $s:名前 \
	-r $i:法線（４０９６系、ＸＹＺ指定） ... \
	-p $i:中心座標 ... \
	-w $i:幅 \
	-h $i:高さ \
	-m $i:モード \ // ０：全面等価、１：上フェード
	-a $i:α \ // 0~255：指定無しで255
	-b $i:α   // 0~255：指定無しで255
// -a は モード０で全面の、モード１で最大のαを意味する
// -b は モード１で必用で最小のαを意味する

chara 壁照り返し[NewWaterReflectWall] $s:名前 \
	-r $i:法線（４０９６系、ＸＹＺ指定） ... \
	-p $i:中心座標 ... \
	-w $i:幅 \
	-h $i:高さ \
	-m $i:モード \ // ０：全面等価、１：上フェード
	-a $i:α \ // 0~255：指定無しで255
	-b $i:α   // 0~255：指定無しで255
// -a は モード０で全面の、モード１で最大のαを意味する
// -b は モード１で必用で最小のαを意味する

chara ドアランプ[NewDoorLamp] $s:名前 \
	-r $i:Ｙ軸回転（４０９６系） \
	-p $i:中心座標 ... // 階数表示部分の中央の座標
mesg ドアランプ $s:名前 ＯＦＦ[0]
mesg ドアランプ $s:名前 赤[1]
mesg ドアランプ $s:名前 赤点滅[2] $i:点滅時間（フレーム指定：NTSC基準） // 時間経過後「赤」になる。-1 で点滅しっぱなし
mesg ドアランプ $s:名前 青[3]
mesg ドアランプ $s:名前 破壊[4]
mesg ドアランプ $s:名前 黄[5]
mesg ドアランプ $s:名前 黄点滅[6] $i:点滅時間（フレーム指定：NTSC基準） // 時間経過後「黄」になる-1 で点滅しっぱなし

chara エレベータパネル制御[NewElavatorLamp] $s:名前 \
	-k $i:種類 \ // 0（１Ｆ・Ｂ１・Ｂ２） 1（１Ｆ・Ｂ１）
	-i $i:現在の階数 \ // セット時の表示部とパネル選択の階数
	-r $i:Ｙ軸回転（４０９６系） \
	-p $i:中心座標 ... \	// 階数表示部分の中央の座標
	-c $i:パネルの色 ... // （デフォルト48,48,48）
mesg エレベータパネル制御 $s:名前 １Ｆ[0]
mesg エレベータパネル制御 $s:名前 Ｂ１[1]
mesg エレベータパネル制御 $s:名前 Ｂ２[2]

chara バンププール[NewPoolWaterComplex] $s:名前 \
	-b $i:バンダリ ... \		// XZ のセット２つ
	-n $s:キャラネーム

chara 位置固定波紋[NewRippleStable] $s:名前 \
	-n $i:場所の数 \
	-p $i:中心座標 ... 		// 注意！！[XZ データ数２個]が１セット
// 高さは水面に合わされる

chara 詳細水飛沫[NewDropBodySplushScn] $s:名前 \
	-n $s:キャラネーム \
	-c $s:ＣＶ２モデルネーム
//n,c 共に必ず必要

chara 泡で波紋管理[NewRipBubbleMan] $s:名前 \
	-n $s:キャラネーム

chara 爆発[NewBombEffectScn] $s:名前 \
	-p $i:中心座標 ... 		// XYZ データ数３個


chara 漏電火花[NewShortSparkLine] $s:名前 \
	-p $i:中心座標 ... 		// XYZ データ数３個
mesg 漏電火花 $s:名前 オフ[0]
mesg 漏電火花 $s:名前 オン[1]
mesg 漏電火花 $s:名前 殺す[2]
mesg 漏電火花 $s:名前 kill[-1]


chara スリット光[NewSlitLight] $s:名前 \
	-p $i:中心座標 ... \		// XYZ データ数３個
	-n $i:法線 ... \		// XYZ データ数３個
	-d $i:光線の絶対方向 ... \	// XYZ データ数３個
	-l $i:光線の到達距離

chara スリット光２[NewSlitLight2] $s:名前 \
	-p $i:中心座標 ... \		// XYZ データ数３個
	-n $i:法線 ... \		// XYZ データ数３個
	-d $i:光線の絶対方向 ... \	// XYZ データ数３個
	-l $i:光線の到達距離

chara 水面監視水飛沫[NewCheckWaterLevel] $s:名前 \
	-n $s:キャラネーム
mesg 水面監視水飛沫 $s:名前 オフ[0]
mesg 水面監視水飛沫 $s:名前 オン[1]
mesg 水面監視水飛沫 $s:名前 殺す[2]
mesg 水面監視水飛沫 $s:名前 kill[-1]

chara 濁流[NewPassingSplash] $s:名前 \
	-n $i:ルート中心 ... \	// （XYZW の４つ。wは幅）を任意のセット数（３２まで）
	-h $i:高さ \
	-p $i:種類 \ // ０：主流用 １：周辺ガス用 ２：パーティクル用
	-s $i:サイズ
mesg 濁流 $s:名前 殺す[0]
mesg 濁流 $s:名前 kill[-1]

chara 床照り返し管理[NewFloorLightMan] $s:名前

chara 水面に落下物の水飛沫[NewDiveSplashScn] $s:名前 \
	-p $i:中心座標 ... \			// XYZ データ数３個：水面上の点
	-f $i:タンカー座標系の時１を指定	// 発生後手前に移動する

chara 波紋管理[NewRippleMan] $s:名前

chara 水飛沫管理[NewSplushMan] $s:名前

chara 連続発生線状泡[NewBubbleLineScn] $s:名前 \
	-p $i:発生場所 ...			// XYZ データ数３個
mesg 連続発生線状泡 $s:名前 オフ[0]
mesg 連続発生線状泡 $s:名前 オン[1]
mesg 連続発生線状泡 $s:名前 殺す[2]
mesg 連続発生線状泡 $s:名前 kill[-1]

chara カメラダスト[NewDustOnCamera] $s:名前 \
	-i $i:不可視起動 \ // ０以外で不可視
	-col $i:ＲＧＢ ... \
	-n $i:ダストの量 // 512*n
mesg カメラダスト $s:名前 オフ[0]
mesg カメラダスト $s:名前 オン[1]

chara エリアダスト[NewDustArea] $s:名前 \
	-p $i:２点指定：発生領域 ... \	// XYZ データ数３個×２＝６個
	-i $i:不可視起動 \ // ０以外で不可視
	-col $i:ＲＧＢ ... \
	-n $i:ダストの量 // 512*n
mesg エリアダスト $s:名前 オフ[0]
mesg エリアダスト $s:名前 オン[1]

chara カメラ泡[NewBubbleOnCamera] $s:名前 \
	-i $i:不可視起動 \ // ０以外で不可視
	-col $i:ＲＧＢ ... \
	-n $i:ダストの量 // 512*n
mesg カメラ泡 $s:名前 オフ[0]
mesg カメラ泡 $s:名前 オン[1]

chara 窓からの光 [NewWindowLight] $s:名前 \
	-p $i:窓枠中心座標 ... \			// XYZ データ数３個
	-r $i:回転（４０９６系） ... \		// XY  ２
	-s $i:縦幅、横幅 ... \				// ２
	-t $i:光源位置 ... \				// XYZ ３
	-l $i:光到達距離 \					// １
	-c $i:ＲＧＢα ...					// ＲＧＢα ４

chara 巻き上げ煙 [NewDynamicFlow] $s:名前 \
	-b $i:バンダリ ... \		// XYZ のセット２つ
	-s $i:パーティクルサイズ

chara カメラ前曇り [NewSteamOnCameraScenario] $s:名前 \
	-t $i:消えるまでのフレーム数（ＮＴＳＣ基準）デフォルト600
mesg カメラ前曇り $s:名前 殺す[-1]

chara 任意稲光 [NewFreeThunder] $s:名前 \
	-x $i:画面の中心をゼロとしたＸ座標（始点） \ // -4096(LEFT ) 〜 4096(RIGHT)
	-y $i:画面の中心をゼロとしたＹ座標（始点） \ // -4096(UPPER) 〜 4096(LOWER)
	-u $i:画面の中心をゼロとしたＸ座標（終点） \ // -4096(LEFT ) 〜 4096(RIGHT)
	-v $i:画面の中心をゼロとしたＹ座標（終点）   // -4096(UPPER) 〜 4096(LOWER)
// 上限下限とも制限しないので、画面の外を設定可能


chara 速度可変 [NewSlowDown] $s:名前 \
	-l $i:繰り返しの数 \ // -1 で 常駐
	-t $i:スキップ
mesg 速度可変 $s:名前 スキップ変更[0] $i:フレームスキップ数
//[フレームスキップ数]が１で通常
// 1 : 100%
// 2 :  50%
// 3 :  33%
// 4 :  25%
// ・・・

command マッキー音[NewMakkyRainSet] $i:ＳＥナンバー
// 0:常駐ＯＦＦ
// 1:常駐雨音ＯＮ

chara 斜め回転床水飛沫 [NewSplashRotate] $s:名前 \
	-n $i:量 \			// ３２枚の何倍？
	-p $i:場所 ... \	// ＸＹＺの ３つ
	-r $i:向き ... \	// Ｘ回転、Ｙ回転 の２つ
	-w $i:幅 ... 		// 回転前のＸ幅、Ｙ幅（厚みに相当）、Ｚ幅 の ３つ
mesg 斜め回転床水飛沫 $s:名前 オフ[0]
mesg 斜め回転床水飛沫 $s:名前 オン[1]
mesg 斜め回転床水飛沫 $s:名前 殺す[2]
mesg 斜め回転床水飛沫 $s:名前 kill[-1]

chara 壁消火器 [NewExtinguisherMini] $s:名前 \
	-p $v:場所 \
	-b $i:バンダリ ... \	// XYZ のセット２つ
	-i $i:赤外線センサーに有効 \// １で有効
	-e $p:破壊時実行プロック \ //
	-d $i:デバグ // １でデバグターゲットが見える

chara 消火器 [NewExtinguisher] $s:名前 \
	-r $v:向き \
	-p $v:場所 \
	-l $s:光源 \
	-b $i:バンダリ ... \	// XYZ のセット２つ
	-i $i:赤外線センサーに有効 \// １で有効
	-e $p:破壊時実行プロック \ //
	-d $i:デバグ // １でデバグターゲットが見える

command セットファークリップ[NewFarClipParamSet] $i:near $i:far

chara スローパラメータ制御 [NewSlowParamMan] $s:名前 \
	-s $i:パーセント
//-s は １００でデフォルトと同等
mesg スローパラメータ制御 $s:名前 パーセント[0] $i:パーセント $i:変化フレーム
//      １００でデフォルトと同等


//chara ジョージワシントン橋のライン補強[NewGWB_Lines] $s:名前
chara ジョージワシントン橋のライン補強モデル[NewGWB_LinesModel] $s:名前

chara アイテム[NewItemBox] $s:名前 \
	-m $s:マップ名直接指定 \ // 通常は指定しない
	-b $b:発生パターン \ // 0:その場発生 1:その場に弾んで発生 2:ランダム方向に発射（収得不可の可能性アリ）
	-p $v:（必須）発生位置 \
	-k $s:（必須）本体モデル名 \
	-s $s:（必須）影モデル名 \
	-l $s:ラベルモデル名 \	// 無くてもよい
	-f $b:（必須）アイテム・武器の区別 \ // （x実行時 に $1 で返る）
	-i $b:（必須）中身のID \             // （x実行時 に $2 で返る）
	-n $b:（必須）個数 \                 // （x実行時 に $3 で返る）
	-h $w:高さ \		// 影からの高さ
	-e $p:取得時実行関数 \
	-z $p:自然消滅時実行関数 \
	-r $i:飛沫：０でなし、１であり、設定しなければなし \
	-g '文字列' \ //収得時メッセージ。無ければデフォルトメッセージを表示。
	-x { アイテム取られ時実行プロック } \
	-t $i:ドッグタグ名前 \ // ドッグタグ以外は設定しない（収得時の表示用）
	-u $w:ドッグタグＩＤ   // ドッグタグ以外は設定しない（x実行時 に $5 で返る）
//キャラの名前は（x実行時 に $4 で返る）
// -e -x は どちらか一方のみ指定。
// -f を指定するかしないかは自由。
// -e -f -x ともに、出力として
//         $1 に アイテム・武器の区別
//         $2 に 中身のＩＤ
//         $3 に 個数
//         $4 に 名前
// を返す。
mesg アイテム $s:名前 オフ[0]
mesg アイテム $s:名前 オン[1]
mesg アイテム $s:名前 殺す[2]
mesg アイテム $s:名前 影だけオフ[3]
mesg アイテム $s:名前 床監視開始[4]
mesg アイテム $s:名前 kill[-1]

command アイテム収得可能範囲設定[OK_ResetGetBoundary] \
	$i:Ｘ軸幅 \ // デフォルト  300 (2001.7/3現在)
	$i:Ｙ軸幅 \ // デフォルト 1500 (2001.7/3現在)
