// メモリーカード警告画面
chara メモリーカード警告画面[NewMCCheckScr] $s:名前 \
	-d $s:レイアウトデータ名 \
	-p $p:終了プロシージャー


chara コナミロゴ表示[NewTitleKonami] $s:名前 \
	-t $i:フェードイン時間 $i:表示時間 $i:フェードアウト時間 \
	-p $p:終了プロシージャー \
	-b $s:ＴＲＩファイル名 $s:テクスチャ名
//
// 時間関係は、全て1/60を基準としている。
// PALであった場合、プログラム内部で補正しNTSCと同じ時間になるようにしている。
// デフォルトは、-t 64 64 64を使っている。
//
// proc 終了プロシージャー $:返り値
//   0 ... 通常終了
//   1 ... なにかボタンを押された場合
//


chara ＫＣＥＪロゴ表示[NewTitleKcej] $s:名前 \
	-t $i:フェードイン時間 $i:表示時間 $i:フェードアウト時間 \
	-p $p:終了プロシージャー
//
// 時間関係は、全て1/60を基準としている。
// PALであった場合、プログラム内部で補正しNTSCと同じ時間になるようにしている。
// デフォルトは、-t 64 64 64を使っている。
//
// proc 終了プロシージャー $:返り値
//   0 ... 通常終了
//   1 ... なにかボタンを押された場合
//


chara タイトル画面マネージャー[NewTitleScrMan] $s:名前 \
	-d $s:レイアウトデータ名 [$s:顔レイアウトデータ名] \
	-p $p:終了プロシージャー \
	-b $s:ノード画面バックグラウンドキャラ名 \
	-f $i:顔フラグ
//
// -p $p:終了プロシージャー
// タイトルの表示が終了した場合(タイムアウト、STARTを押された場合)に
// 呼び出される。
//
// proc 終了プロシージャー $:モード
// モード  0 ... STARTを押されて終了
//         1 ... タイムアウト
//

mesg タイトル画面マネージャー $s:名前 kill[-1]


chara ゲームセレクト画面マネージャー[NewSelScrMan] $s:名前 \
	-d $s:レイアウトデータ名 \
	-p $p:選択処理プロシージャー名 \
	-b $s:ノード画面バックグラウンドキャラ名 \
	-s $i:スタートするモード（０＝通常、１＝ＳＰＥＣＩＡＬ）

mesg ゲームセレクト画面マネージャー $s:名前 kill[-1]

mesg ゲームセレクト画面マネージャー $s:名前 ret_by_ok[1]
mesg ゲームセレクト画面マネージャー $s:名前 ret_by_cancel[2]

//
// -p $p:選択処理プロシージャー名
// 選択画面が終了した時に呼び出されるプロシージャーを指定する
//
// proc 選択処理プロシージャー $:画面番号 $:引数１ $:引数２ $:引数３ $:引数４ $:引数５
// 画面番号 -1 ... ゲームセレクト画面でキャンセルされた等で、
//                 ゲームセレクト画面マネージャーの実行が終了した場合
//
//           0 ... ゲームセレクト
//                 引数１ ... 選択された項目
//
//           1 ... New Game
//                 引数１ ... スタートするゲームモード
//                 引数２ ... 難易度
//                 引数３ ... 敵に発見されたらゲームオーバーか否か
//                 引数４ ... 井上喜久子アンケートの選択肢
//

chara ロードゲーム画面マネージャー[NewLoadGameScr] $s:名前 \
	-d $s:レイアウトデータ名 \
	-p $p:選択処理プロシージャー名 \
	-b $s:ノード画面バックグラウンドキャラ名

mesg ロードゲーム画面マネージャー $s:名前 kill[-1]
mesg ロードゲーム画面マネージャー $s:名前 ret_by_ok[1]
mesg ロードゲーム画面マネージャー $s:名前 ret_by_cancel[2]


chara セーブゲーム画面マネージャー[NewSaveGameScr] $s:名前 \
	-d $s:レイアウトデータ名 \
	-p $p:選択処理プロシージャー名 \
	-i $s:アイコン名

mesg セーブゲーム画面マネージャー $s:名前 kill[-1]


chara オプション画面マネージャー[NewOptionScr] $s:名前 \
	-d $s:レイアウトデータ名 \
	-p $p:選択処理プロシージャー名 \
	-b $s:ノード画面バックグラウンドキャラ名
// proc 選択処理プロシージャー
// 特に返り値なし
//

chara スペシャル画面マネージャー[NewSpecialScr] $s:名前 \
	-d $s:レイアウトデータ名 \
	-p $p:選択処理プロシージャー名 \
	-s $i:スタートカーソル位置 \
	-g $f:デバッグフラグ
// proc 選択処理プロシージャー $:返り値
// $:返り値  0,1,2,3,4,5,6  メニュー選択
//           -1             キャンセル終了
//

chara ボスラッシュ選択画面[NewBossrushScr] $s:名前 \
	-d $s:レイアウトデータ名 \
	-p $p:選択処理プロシージャー名
// proc 選択処理プロシージャー $:返り値
// $:返り値  0,1	  メニュー選択
//           -1       キャンセル終了
//

chara ローポリ劇場選択画面[NewTheaterScr] $s:名前 \
	-d $s:レイアウトデータ名 \
	-p $p:選択処理プロシージャー名 \
	-s $i:スタートカーソル位置指定 $i:キャスト１カーソル位置指定 \
	   $i:キャスト２カーソル位置指定 $i:キャスト３カーソル位置指定 $i:キャスト４カーソル位置指定 \
	-f $i:項目非表示フラグ ...

// proc 選択処理プロシージャー $:返り値 $:キャスト１ $:キャスト２ $:キャスト３ $:キャスト４
// $:返り値  -1       キャンセル終了
//           その他   デモ番号
//

#enum {
	CAST_RAIDEN=0x00000001,
	CAST_SOLIDUS=0x00000002,
	CAST_SNAKE=0x00000004,
	CAST_OCELOT=0x00000008,
	CAST_VAMP=0x00000010,
	CAST_FORTUNE=0x00000020,
	CAST_ROSE=0x00000040,
	CAST_MGS1_SNAKE=0x00000080,
	CAST_MGS1_OCELOT=0x00000100,
	CAST_BUSINESS_MAN=0x00000200,
	CAST_OL=0x00000400,
	CAST_OBACHAN=0x00000800,
	CAST_GOL_SOLDIER_HI=0x00001000,
	CAST_NINJA=0x00002000,

	EXCAST_GOL_SOLDIER=0x00004000,
	EXCAST_OLGA=0x00008000,
	EXCAST_GOL=0x00010000,
	EXCAST_SCOTT=0x00020000,
	EXCAST_SEALS=0x00040000,
	EXCAST_PRISKIN=0x00080000,
};


chara クリアデータロード後のゲーム開始画面[NewClearedGameMenuScr] $s:名前 \
	-d $s:レイアウトデータ名 \
	-p $p:選択処理プロシージャー名 \
	-b $s:ノード画面バックグラウンドキャラ名

//
// -p $p:選択処理プロシージャー名
// 選択画面が終了した時に呼び出されるプロシージャーを指定する
//
// proc 選択処理プロシージャー $:画面番号 $:引数１ $:引数２ $:引数３ $:引数４ $:引数５
// 画面番号  0 ... キャンセル終了
//
//           1 ... ゲームスタート
//                 引数１ ... スタートするゲームモード
//                 引数２ ... 難易度
//                 引数３ ... 敵に発見されたらゲームオーバーか否か
//                 これらの値は。終了時にセーブデータの方に反映されています。
//                 ですので、何か特別な処理を行う場合のために用意してあります。
//


command ローカルリソース設定[ComLocalResourceSet] \
	-string $s:参照ID $d:リソース ...2 \
	-binary $s:参照ID $d:リソース ...2
// 常駐リソース設定と同じ使い方。ステージごとに設定する場合のために作成
// リソースは、[RESOURCE:*]と記述することで、プログラムはその先頭番号が取れる。
// 参照IDはstringとbinaryで重ならないこと。


command タンカー編取得済みドッグタグ数[ComNTankerDogtags]
command タンカー編総ドッグタグ数[ComMaxTankerDogtags]
command プラント編取得済みドッグタグ数[ComNPlantDogtags]
command プラント編総ドッグタグ数[ComMaxPlantDogtags]


chara 新クリアコード表示[NewClearCodeScr] $s:名前 \
	-p $p:処理終了後実行するプロシージャー名 \
	-m $i:モード選択 \
	-c $i:クリアコード１ $i:クリアコード２ $i:クリアコード３ $i:クリアコード４
// モード
// 0 ... タンカー編
// 1 ... プラント編
// 2 ... タンカー＆プラント編


chara 取得アイテム表示[NewGetNewItemScr] $s:名前 \
	-p $p:処理終了後実行するプロシージャー名 \
	-i $i:アイテム番号 \
	-s $f:一番最初に立ち上げる時このフラグを１にする

// アイテム番号
// 0 ... バンダナ
// 1 ... タンカーデジカメ
// 2 ... プラントデジカメ
// 3 ... デジカメ
// 4 ... タンカーステルス
// 5 ... プラントステルス
// 6 ... カツラ(茶)
// 7 ... カツラ(オレンジ)
// 8 ... カツラ(青)


chara セーブ確認画面[NewConfirmSaveScr] $s:名前 \
	-p $p:処理終了後実行するプロシージャー名 \
	-s $s:リソース名
// リソース名は、ending.gclでは「セーブ確認文」というのを用意してある。
// リソースの内容は、ending.rscに記述してある。
//
// 処理終了後実行するプロシージャーは、返り値としてユーザーが選択した
// 選択肢を受け取れるようにしてある。( 0=Yes / 1=No )
// proc プロシージャー $:返り値 {
//            :
//            :
// }
//

command ロードデータの秒単位タイムスタンプ[ComGetLoaddataTime]
// ゲームをスタートするためにロードしたファイルの日付を
// 秒単位に直して返します。2000/1/1 0:00:00が基準です。

command 現在の秒単位時間[ComGetNowTime]
// 現在の日付を秒単位に直して返します。2000/1/1 0:00:00が基準です。

// オプションフラグの一時保存
command オプションフラグの内容を保存[ComStoreOptions]
command 保存していたオプションフラグを戻す[ComLoadOptions]

command ＰＳ２から言語設定を取り出す[ComGetLanguage]


