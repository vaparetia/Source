// デバッグ用
chara レイアウトテスト[NewLayoutTest] $s:name \
			-l $s:レイアウト名  \
			-i $s:初期化アクション \
			-p $s:再生アクション

//
// ノード画面関連
//
chara ノードシステム[NewNodeDaemon] $s:name \
				-skin $s:スキン名 \
				-proc $p:proc_id \
				-file $t:レイアウト等データ

command ノード画面起動[NewNode] -map -name -black $i:暗転フラグ

#define NODE_FLAG_BLACK_IN   0x0001   // 暗転状態から開始する
#define NODE_FLAG_BLACK_OUT  0x0002   // 暗転状態で終了する

//
// 顔アニメマネージャ
//
chara 顔アニメマネージャ[NewFaceManager] $s:name



// レーダ: 爆弾センサ
chara 爆弾検知領域[NewBombArea] $s:name \
				-trap $s:トラップ名 \
				-rgb $i:red $i:green $i:blue \
				-mode $i:センサモード

// 検知領域の消去。消去所要時間が負の値ならデフォルトの時間で消去。
// 消去所要時間は 1/300秒単位で指定(PAL 対応のため)
mesg 爆弾検知領域 $s:name 消去[0] $i:消去所要時間

// センサモード 0 : bomb_mode 1 : water_mode by koba4 2001/05/31

chara レーダ上動画[NewRadarMovie] $s:name  \
				-data $t:動画名 \
				-chanl $i:表示チャネル \
				-rgba $i:Red $i:Green $i:Blue $i:Alpha \
				-pos $i:表示X $i:表示Y \
				-size $i:表示W $i:表示H \
				-movie $i:動画W $i:動画H \
				-finaly $p:proc_id


//
// 全体マップ表示
//
chara 全体マップ表示[NewAllMapChild] $s:name  \
				     -s $s:レイアウト名 \
				     -p $p:ポイント表示アクション名

mesg 全体マップ表示 $s:name レイアウト設定[0] $s:レイアウト名
mesg 全体マップ表示 $s:name アクション設定[1] $s:アクション名
mesg 全体マップ表示 $s:name 表示設定[2] $s:レイアウト名 $s:アクション名

chara 全体マップ表示3D[NewMap3D] $s:name \
				-player $s:プレイヤ位置ラベル \
				-model $d:マップモデルテーブル

//
// 床亀甲プラズマ
//
chara 亀甲床[NewBlinkFloor] $s:name \
				-size $i:外接円半径  \
				-prims $i:プリミティブ数 \
				-vertex $i:最大頂点数 \
				-time $i:消去までの時間 \
				-alpha $i:最大アルファ値 \
				-color $i:R $i:G $i:B \
				-maxpoint $i:最大発生点数 \
				-user $i:プレイヤ用プリミティブ数 \
				-region $i:x $i:z $i:r \
				-floor


//
// 円筒テクスチャオブジェクト
//
chara 円筒テクスチャ[NewCylinderImage] $s:name \
		-alpha $i:最大アルファ値 \
		-O $i:x $i:y $i:z  \  // 起点
		-r $i:半径  \
		-posy $i:起点からのy位置 \
		-width $i:テクスチャ幅 \
		-height $i:テクスチャ高さ \
		-inner $i:中心角4096 \
		-tex $s:TRI名称 $s:テクスチャ名称 \
		-spin $i:初期角 $i:一周所要時間 \		// 軸回転
		-vertical $i:開始y $i:終了y $i:所要時間 \	// 軸沿い上下
		-xzscale $i:開始半径 $i:終了半径 $i:所要時間 \	// 半径変更
		-yscale $i:開始高さ $i:終了高さ $i:所要時間 \	// 上下幅変更
		-uvanim $i:所要時間 \
			$i:開始U $i:開始幅 $i:開始V $i:開始高さ \
			$i:終了U $i:終了幅 $i:終了V $i:終了高さ \
		-lookup	\					// プレイヤ同期
		-blink  \  					// 点滅
		-Rot $i:X軸回転 $i:Y軸回転 $i:Z軸回転 \		// 中心軸回転
		-pLate            // 円筒ではなく、円筒に対する接面として作成

mesg 円筒テクスチャ $s:name アルファ設定[0] $i:アルファ値
mesg 円筒テクスチャ $s:name アルファリセット[1]


chara 空中文字[NewBlinkCylinderTexture] $s:name \
		-alpha $i:最大アルファ値 \
		-O $i:x $i:y $i:z  \  // 起点
		-r $i:半径  \
		-posy $i:起点からのy位置 \
		-width $i:テクスチャ幅 \
		-height $i:テクスチャ高さ \
		-inner $i:中心角4096 \
		-tex $s:TRI名称 \
			$s:枠テクスチャ名 \
			$s:文字テクスチャ名 \
		-chr $i:x比 $i:y比 $i:w比 $i:h比 \
		-spin $i:初期角 $i:一周所要時間 \		// 軸回転
		-vertical $i:開始y $i:終了y $i:所要時間 \	// 軸沿い上下
		-xzscale $i:開始半径 $i:終了半径 $i:所要時間 \	// 半径変更
		-yscale $i:開始高さ $i:終了高さ $i:所要時間 \	// 上下幅変更
		-uvanim $i:所要時間 \
			$i:開始U $i:開始幅 $i:開始V $i:開始高さ \
			$i:終了U $i:終了幅 $i:終了V $i:終了高さ \
		-bgTex  $s:背景テクスチャ名 \
		-bguv   $i:所要時間 \
			$i:開始U $i:開始幅 $i:開始V $i:開始高さ \
			$i:終了U $i:終了幅 $i:終了V $i:終了高さ \
		-lookup  \	// プレイヤ同期
		-Rot	$i:X軸回転 $i:Y軸回転 $i:Z軸回転  \	// 中心軸回転
		-pLate	// 円筒ではなく、円筒に対する接面として作成


mesg 空中文字 $s:name アルファ設定[0] $i:アルファ値
mesg 空中文字 $s:name アルファリセット[1]

chara 回転モデル[NewSpinModel] $s:name \
		-O $i:x $i:y $i:z  \  // 起点
		-posz $i:起点からのz位置 \
		-spin $i:初期角 $i:一周所要時間 \		// 軸回転
		-vertical $i:開始y $i:終了y $i:所要時間 \	// 軸沿い上下
		-model $s:モデル名称  \                         // 使用モデル名
		-lookup	\					// プレイヤ同期
		-Rot $i:X軸回転 $i:Y軸回転 $i:Z軸回転		// 中心軸回転


//
// タンカー編 画像転送端末
//
chara 画像転送端末[NewPhotoTerminal] $s:name \
					-skin $s:レイアウト名 \
					-file $t:ファイル名

command 転送端末起動[AccessPhotoTerm] -call $C:転送処理コード -Cold -p [$p:proc_id]


//
// プラント編携帯端末
//
chara 携帯端末[NewMobileDaemon] $s:name \
			-skin $s:レイアウト名 \
			-file $t:ファイル名 \
			-time $i:最大待ち受け時間 $i:装備時着信時間

command 携帯呼出[AccessMobile] -reset -call $C:呼出処理コード -p [$p:proc_id]

//
// 「command 携帯呼び出し -reset」で、携帯呼び出しをキャンセルします。
//


//
// リップシンク関係。作ったけど使ってない。
//
command リップシンクドライバ[GM_StreamLipDriverInit]

chara 顔アニメ[NewFaceMotionSet] $s:name \
        -chara $s:キャラクタ名 \
	-a $d:顔アニメモーションパーツ群

mesg 顔アニメ $s:名前 表情設定[0] $s:モーション名 $w:レート $w:補間時間
mesg 顔アニメ $s:名前 表情ニュートラル[1] $w:補間時間
mesg 顔アニメ $s:名前 口パク強度[2] $w:強度
mesg 顔アニメ $s:名前 強制目パチ[3] $w:目パチ回数
mesg 顔アニメ $s:名前 自動目パチ禁止[4]
mesg 顔アニメ $s:名前 自動目パチ許可[5]

//---------------------------------------------------------------------
// スクール	/user/okajima

chara 課題雛形[NewLesson] $s:名前


//---------------------------------------------------------------------
// 柴田	/user/shibata

chara タイトル[NewGameTitle_Trial] $s:name \
	-eproc $p:終了proc \
	-rproc $p:雨降りproc \
	-sproc $p:雨ストップproc \
	-proc  $p:スペシャルへ \
	-mode  $i:ワーニング \
	-k $w:英語版フラグ \
	-data $d:レーダー説明 ... \
	-log $d:ミッションログ ... \
	-flag $i:クリアコードあり \
	-tane $i:種 \
	-code $i:元データ ...

//startでeprocを呼び出して終了
//雨rproc

chara トゥービーコンテニュード[NewToBeContinued] $s:name \
	-proc $p:終了proc \
	-radio $t:ラジオドラマ

chara クリアコード表示[NewClearCode] $s:name \
	-proc $p:終了proc \
	-eng  $f:英語版フラグ \
	-seed $i:エンコードシード値 \
	-data $i:元データ ...

//終了プロックを呼び出して死にます。

chara シネマスクリーン[NewCinemaScreen] $s:name \
	-top $i:上のピクセル数 \
	-bottom $i:下のピクセル数 \
	-ftime $i:フェードのフレーム数	//デフォルト値（ゼロは駄目）

mesg シネマスクリーン $s:名前 フェードアウト[0] $i:フェードのフレーム数		//ゼロでデフォルト値
mesg シネマスクリーン $s:名前 フェードイン[1] $i:フェードのフレーム数		//ゼロでデフォルト値
mesg シネマスクリーン $s:名前 kill[2]

chara ２Ｄスプライト表示[New2DSprite] $s:name \
	-tri $s:ＴＲＩコード \
	-x $s:ＴＥＸコード \
	-pos $i:座標Ｘ $i:座標Ｙ \
	-size $i:サイズＷ $i:サイズＨ \
	-b $i:スケール ... \
	-count $i:カウント ... \
	-alp $i:アルファ \
	-flag $i:フラグ \
	-l			//ロックフラグ（２Ｄスプライト表示＿ポーズ）
mesg ２Ｄスプライト表示 $s:名前 kill[-1]

//座標ＸＹ(0,0)<->(512,384)g
//サイズＷＨ(0,0)<->(512,384)
//スケールｗｈ（１００００で１．０）なしだと１．０
//カウント0　フェードインタイム
//カウント1　ウェイト
//カウント2　フェードインアウト
//デフォルト左上
#define SPRT2D_FLAG_RIGHT 	0x0001	//右寄せ
#define SPRT2D_FLAG_BOTTOM 	0x0002	//下寄せ
#define SPRT2D_FLAG_CENTER 	0x0010	//中心合わせ
#define SPRT2D_FLAG_ALPHA 	0x0000	//アルファモード
#define SPRT2D_FLAG_ADD 	0x1000		//加算
#define SPRT2D_FLAG_SUB 	0x2000		//減算


chara ２Ｄスプライト表示＿ポーズ[New2DSprite_Pause] $s:name \
	-tri $s:ＴＲＩコード \
	-x $s:ＴＥＸコード \
	-pos $i:座標Ｘ $i:座標Ｙ \
	-size $i:サイズＷ $i:サイズＨ \
	-b $i:スケール ... \
	-alp $i:アルファ \
	-flag $i:フラグ

mesg ２Ｄスプライト表示＿ポーズ $s:名前 kill[-1]

chara テロップ表示君[NewRunTelop_Trial] $s:name

mesg テロップ表示君 $s:名前 表示開始[0] $i:Ｘ座標 $i:Ｙ座標 $i:テロップ番号

chara 窓雨 [NewWindowRain] $s:名前 \
	-c $i:中心の座標 ... \
	-s $i:縦と横 ... \
	-r $i:例によってＹＸＺ順回転（Ｚ＝０が無難） ... \
	-m $i:モード設定すると粒なし

chara 水溜り管理[NewPuddle] $s:name \
	-n_obj $i:波紋発生キャラ数 \
	-obj   $s:キャラネーム ...

mesg 水溜り管理 $s:名前 入る[0] $s:キャラ名
mesg 水溜り管理 $s:名前 出る[1] $s:キャラ名


chara 操作説明表示[NewOpenCntrlExp] $s:name \
	-eng $f:英語版フラグ

chara ３Ｄスプライト表示[NewGeneralSprite_Scn] $s:name \
	-tex $s:ＴＥＸコード \
	-pos $i:座標Ｘ $i:座標Ｙ $i:Ｚ座標 \
	-size $i:サイズＷ $i:サイズＨ \
	-col $i:ＲＧＢＡ ... \
	-mode $i:ＴＥＸモード \
	-f $i:カメラ方向シフト値

mesg ３Ｄスプライト表示 $s:名前 ＯＮ[0]
mesg ３Ｄスプライト表示 $s:名前 ＯＦＦ[1]

//ＴＥＸモード
#define GSPRT_MODE_FOG		0x00200000	// フォグが掛かる
#define GSPRT_MODE_TEX		0x00000000	// 描画モード　テクスチャーそのまま　起動時のみ
#define GSPRT_MODE_ADD		0x00010000	// 描画モード　加算　起動時のみ
#define GSPRT_MODE_SUB		0x00020000	// 描画モード　減算　起動時のみ
#define GSPRT_MODE_ALPHA	0x00030000	// 描画モード　アルファ　起動時のみ

chara スペシャルメニュー[NewSpecialMenu] $s:name \
	-flag $i:見たかどうかフラグ \
	-end $p:エンドプロック \
	-data $p:ムービープロック $d:説明文 $d:題名 $w:キーデータ ...4

mesg スペシャルメニュー $s:name ムービー終了[0]

chara 英語版スペシャルメニュー[NewSpecialMenu_Eng] $s:name \
	-flag $i:見たかどうかフラグ \
	-end $p:エンドプロック \
	-data $p:ムービープロック $d:説明文 $d:題名 $w:キーデータ ...4

mesg 英語版スペシャルメニュー $s:name ムービー終了[0]


chara スペシャルメニューページ付き[NewSpecialMenu_Page] $s:name \
	-flag $i:見たかどうかフラグ \
	-end $p:エンドプロック \
	-data $p:ムービープロック $d:題名 $b:改行フラグ $w:キーデータ $d:説明文 ...

mesg スペシャルメニューページ付き $s:name ムービー終了[0]

chara 昼空ドーム[NewPlantSkyMain] $s:name \
	-col $w:ＲＧＢ ... \
	-pos $i:座標 ...

chara 汎用空[NewSkyUtil] $s:name \
	-col $w:ＲＧＢ ... \
	-pos $i:座標 ... \
	-b   $i:ボトムサイズ \
	-l   $i:スケール \
	-f	 $i:フラグ \
	-t	 $i:雲テクスチャー数 $s:ＴＥＸ名前 $i:カラー $i:カラー $i:カラー $i:移動割合 ...5 \
	-m	 $i:補助モデル数 $s:ＭＤＬ名前 $i:カラー $i:カラー $i:カラー $i:移動割合 $i:ＲＯＴ ...6

mesg 汎用空 $s:name 表示[0]
mesg 汎用空 $s:name 非表示[1]

#define		SKY_FLAGS_NO_MOVE	0x0001
#define		SKY_FLAGS_NO_BASE	0x0002
#define		SKY_FLAGS_NO_CLOUD	0x0004
#define		SKY_FLAGS_CAMERA	0x0008

// -c	color RGBA
// -p	pos
// -b	size
// -l	scale
// -f	flags	(cloud_inv sky_inv cloud_move)
// -t	テクスチャー数	max 4
//		(名前) * テクスチャー数
// -m	モデル数			max 4
//		(名前 + R + G + B) * モデル数

chara 太陽[NewPlantSunMain] $s:名前 \
	-l $i:スケール \
	-p $i:位置 ... \	// 位置
	-f $i:方向 ... \	// 原点からこの位置に向かって光が射す
	-a $i:アルファ \
	-w $i:幅 \
	-h $i:高さ \
	-t $s:テクスチャー \
	-g $w:グループ番号 \
	-c $w:Ｒ $w:Ｇ $w:Ｂ $w:Ａ		//キラキラの色指定しなければキラキラ起動しません。

mesg 太陽 $s:name 表示[0]
mesg 太陽 $s:name 非表示[1]

chara 水中カメラ[NewScrWater] $s:名前 \
	-col $i:ＲＧＢ ... \	//ＲＧＢ
	-warp $i:ピクセル		//ずらし最大ピクセル数


chara 陽炎[NewScrShimmer] $s:名前 \
	-h $i:高さ		//カメラとこの高さで強度が変わります

chara メタルレイの目[NewRayEye_Scn] $s:名前 \
	-ray_name $s:レイの名前 \
	-mode $i:モード		//(未対応)0:最初からアクティヴ 1:メッセージで起動アニメーションのちアクティヴ

command 水位設定[NewWaterLevelControl] -lv $i:水位 \
	-s $i:水跳弾番号 // デフォルト無し。SD_A_RICOCH08 or SD_A_RICOCH06

