// 田中(信) /user/nobu

command デモモデルリネーム追加[NewCom_AddRenameList] \
	-rename_Kms $s:変更元ＩＤ $s:変更先ＩＤ ... \
	-rename_Evm $s:変更元ＩＤ $s:変更先ＩＤ ...
//このコマンドは、デモより先に指定して下さい。
// 変更元ＩＤ と 変更先ＩＤ を一組として、書き並べて下さい。KMSに関し
//ては-rename_kmsを使い、EVMに関しては、-rename_evmを使用するようにし
//て下さい。２つ一組として書き並べないとうまく動きませんので御了承を。


command デモローポリ劇場[NewCom_AddRenameList] \
	-change $s:変更元ＩＤ $s:元拡張子 $s:変更先ＩＤ $s:先拡張子 \
	-arkms  $s:変更元ＩＤ $s:元拡張子 $i:ＡＲＫＭＳＩＤ $i:タイプ $i:装備フラグ \
	-equip  $s:装備する人のモデル $i:フラグ 

//このコマンドは、デモより先に指定して下さい。
//-changeは、ローポリ劇場用のオプションです。一つずつかいて下さい。拡
//張子は、evm kmsと子文字で表記するようにお願い致します

//-arkms は、モデルを、ARKMSのモデルに変更するコマンドです。IDには、下
//のIDを使って下さい
#define DM_ARKMS_MARINES      1
#define DM_ARKMS_NYPD         2
#define DM_ARKMS_CITY_FEMALE  3  //タイプは１３種類
#define DM_ARKMS_CITY_MALE    4  //タイプは９６種類
#define DM_ARKMS_HOSTAGE      5  //タイプは１１種類
#define DM_ARKMS_CITY_OLDLADY 6  //タイプは１２を入れて下さい。

//-equipは、デフォルトの装備を変更した時や、装備させたくない時に使いま
//す。モデルの指定は、必ず変更後のモデルを指定して下さい。フラグは、各
//キャラごとに違いますので下のdefineをお使い下さい。
#define DM_EQUIP_DEFAULT  0x80000000  //デフォルト装備
#define DM_EQUIP_NOTHING  0x40000000  //装備無し

//必ず銃を装備させる(右手)
#define DM_EQUIP_WEAPON   0x20000000

//フォーチュン装備フラグ
#define DM_EQUIP_FORT_GUN 0x00000800 //フォーチュンのみ リニアガン装備

//海兵隊の装備フラグ
#define DM_EQUIP_MARINE_CAP     0x0001 //海兵隊装備 帽子
#define DM_EQUIP_MARINE_GLASSES 0x0002 //海兵隊装備 サングラス
#define DM_EQUIP_MARINE_HELMET  0x0004 //海兵隊装備 ヘルメット
#define DM_EQUIP_MARINE_PHONE   0x0008 //海兵隊装備 ヘッドフォン
#define DM_EQUIP_MARINE_M4_KATA 0x0010 //海兵隊装備 Ｍ４肩
#define DM_EQUIP_MARINE_M4_TE   0x0020 //海兵隊装備 Ｍ４右手
#define DM_EQUIP_MARINE_M9_TE   0x0040 //海兵隊装備 Ｍ９２右手

//ＮＹ市民女性専用 装備フラグ
#define DM_EQUIP_SKIRT_A     0x10000 //ＮＹ市民女性 スカート細身のみ
#define DM_EQUIP_SKIRT_B     0x20000 //ＮＹ市民女性 スカートおばちゃん用
#define DM_EQUIP_NY_F_HAIR_A1 0x0001 //ＮＹ市民女性 頭部飾りA1
#define DM_EQUIP_NY_F_HAIR_A2 0x0002 //ＮＹ市民女性 頭部飾りA2
#define DM_EQUIP_NY_F_HAIR_A3 0x0004 //ＮＹ市民女性 頭部飾りA3
#define DM_EQUIP_NY_F_HAIR_A4 0x0008 //ＮＹ市民女性 頭部飾りA4
#define DM_EQUIP_NY_F_HAIR_A5 0x0010 //ＮＹ市民女性 頭部飾りA5
#define DM_EQUIP_NY_F_HAIR_B1 0x0020 //ＮＹ市民女性 頭部飾りB1
#define DM_EQUIP_NY_F_HAIR_B2 0x0040 //ＮＹ市民女性 頭部飾りB2
#define DM_EQUIP_NY_F_HAIR_B3 0x0080 //ＮＹ市民女性 頭部飾りB3
#define DM_EQUIP_NY_F_HAIR_B4 0x0100 //ＮＹ市民女性 頭部飾りB4
#define DM_EQUIP_NY_F_HAIR_B5 0x0200 //ＮＹ市民女性 頭部飾りB5
#define DM_EQUIP_NY_F_BROUSE1 0x0400 //ＮＹ市民女性 女性用ブラウスA
#define DM_EQUIP_NY_F_BROUSE2 0x0800 //ＮＹ市民女性 女性用ブラウスB
#define DM_EQUIP_NY_F_BROUSE3 0x1000 //ＮＹ市民女性 女性用ブラウスC
#define DM_EQUIP_NY_F_BROUSE4 0x2000 //ＮＹ市民女性 女性用ブラウスD

//ＮＹ市民男性専用 装備フラグ
#define DM_EQUIP_NY_M_HAIR1   0x0001 //ＮＹ市民男性  髪の毛 茶色 0
#define DM_EQUIP_NY_M_HAIR2   0x0002 //ＮＹ市民男性  髪の毛 金色 1
#define DM_EQUIP_NY_M_HAIR3   0x0004 //ＮＹ市民男性  髪の毛 白色 2
#define DM_EQUIP_NY_M_HAIR4   0x0008 //ＮＹ市民男性  髪の毛 ハゲ 3
#define DM_EQUIP_NY_M_SHIRT1  0x0010 //ＮＹ市民男性  シャツ黒 4
#define DM_EQUIP_NY_M_SHIRT2  0x0020 //ＮＹ市民男性  シャツ青 5
#define DM_EQUIP_NY_M_TIE1    0x0040 //ＮＹ市民男性  ネクタイ黄色 6
#define DM_EQUIP_NY_M_TIE2    0x0080 //ＮＹ市民男性  ネクタイ茶色 7
#define DM_EQUIP_NY_M_GLASSES 0x0100 //ＮＹ市民男性  眼鏡 8
#define DM_EQUIP_NY_M_BAG1    0x0200 //ＮＹ市民男性  バッグ 右手 9
#define DM_EQUIP_NY_M_BAG2    0x0400 //ＮＹ市民男性  バッグ 左手 10
#define DM_EQUIP_NY_M_BAG3    0x0800 //ＮＹ市民男性  バッグ 右肩
#define DM_EQUIP_NY_M_BAG4    0x1000 //ＮＹ市民男性  バッグ 左肩
#define DM_EQUIP_NY_M_BAG5    0x2000 //ＮＹ市民男性  バッグ 右肩
#define DM_EQUIP_NY_M_BAG6    0x4000 //ＮＹ市民男性  バッグ 左肩

//ゴル装備
#define	DM_EQUIP_GOL_HLST	 0x00000001     /* 銃のホルスター         */
#define	DM_EQUIP_GOL_KNIF	 0x00000002     /* コンバットナイフ       */
#define	DM_EQUIP_GOL_KNIFCASE	 0x00000004     /* コンバットナイフ鞘のみ */
#define	DM_EQUIP_GOL_MAG	 0x00000008     /* マガジン     */
#define	DM_EQUIP_GOL_BACKPACK	 0x00000010     /* バックパック */
#define	DM_EQUIP_GOL_RADIO	 0x00000020     /* 無線機       */
#define	DM_EQUIP_GOL_NSIGHT	 0x00000040     /* ナイトビジョンゴーグル */
#define	DM_EQUIP_GOL_NSIGHT_OPEN 0x00000200     /* ゴーグル上げている */
#define	DM_EQUIP_GOL_WEAPON	 0x00000080     /* 武器無し           */
#define	DM_EQUIP_GOL_WPFREE	 0x00000100     /* 武器ぶら下げる     */
#define	DM_EQUIP_GOL_GPS	 0x00002000	/* プラントゴル兵     */
#define	DM_EQUIP_GOL_GPA	 0x00004000	/* プラント攻撃ゴル兵 */
//天狗装備
#define	DM_EQUIP_GOL_TNGGUN	 0x00008000	/* 銃天狗             */
#define	DM_EQUIP_GOL_TNGKATANA	 0x00010000	/* 刀天狗             */
#define	DM_EQUIP_GOL_SAYA	 0x00020000	/* 刀鞘               */



// chara デモアクトデバッグ[NewDemoActDebug] $s:名前 \
// 本番用：シナリオ班はこれに書き換えて下さい
chara demo[NewPolygonDemoStart] $s:名前 \
	-i $E:symbol \			// ストリーミング用t:シンボル
	-p $p:プロック ... \	// デモデータから呼び出されるproc列
	-rename_Kms $s:変更元ＩＤ $s:変更先ＩＤ ... \
	-rename_Evm $s:変更元ＩＤ $s:変更先ＩＤ ... \
	-no_State_demo		\		// SEを禁止しない(STATE_DEMOを立てない)
	-next $p:proc	\		// 終了時に呼び出されるproc
	-begin $p:proc \		// 開始1フレーム前に呼び出されるproc
	-undraw $b:flag \			// 画面更新を止めるフラグ
							// 0x01:開始0x02終了0x03デフォルト
	-camera $i:flag		// カメラの属性を指定

// -rename_kms  変更元ＩＤ 変更先ＩＤ ...
// -rename_evm  変更元ＩＤ 変更先ＩＤ ...
// 変更元ＩＤ と 変更先ＩＤ を一組として、書き並べて下さい。KMSに関し
//ては-rename_kmsを使い、EVMに関しては、-rename_evmを使用するようにし
//て下さい。２つ一組として書き並べないとうまく動きませんので御了承を。


#define DEMO_NO_UNDRAW		0x00
#define DEMO_UNDRAW_BEGIN	0x01
#define DEMO_UNDRAW_END		0x02

// 田中追加。カメラ属性指定用
#define DEMO_CAMERA_NO_RESET    0x0001	// CAM_FLAG_PAD_ADJUST_NO_RESETを追加

// デモ班作成時用：デモ班はこれで作成して下さい
chara デモアクトデバッグ[NewPolygonDemoStart] $s:名前 \
	-i $E:symbol \			// ストリーミング用t:シンボル
	-p $p:プロック ... \	// デモデータから呼び出されるproc列
	-rename_Kms $s:変更元ＩＤ $s:変更先ＩＤ ... \
	-rename_Evm $s:変更元ＩＤ $s:変更先ＩＤ ... \
	-next $p:proc \			// 終了時に呼び出されるproc
	-begin $p:proc \		// 開始時に呼び出されるproc
	-undraw $b:flag		\	// 画面更新を止めるフラグ
	-camera $i:flag \		// カメラの属性を指定
	\						// 0x01:開始0x02終了0x03デフォルト
	-d 'E文字列' \			// ここから下はデバッグ用
	-l \
	-s '文字列' \
	-e $i:エフェクトリスト表示時間 \
	-v $i:デモ表示初期状態設定 \
	-f $i:30フレームカウンタのベースタイム \
	-t $i:タイミングカウンタ

// d オプションはデモファイル名の文字列
// l オプションはデモをループさせるかどうかを指定するが、デバッグ版のみの機能です。
// s オプションはデモ中に文字列を表示させる場合に指定します。デバッグ版のみの機能です。
// e オプションはデモ中に実行されたエフェクトをテキスト表示します。表示するテキストは lst ファイルの記述されています。
// v オプションはデバッグ表示の初期状態を設定します。
// f オプションは30フレームカウンタの初期タイムを設定します。
// t オプションは最初に指定の秒数だけカウンタダウンしたのちデモを再生するようにします。
// p オプションは、プロックをエフェクト側から呼び出すためのもの。リスト化したプロックリストの何番目という形で指定する。
// -camera はデモのカメラの属性を指定できる。カメラ属性のデフォルトは次の通り。
//		デフォルト(DEBUG_MODE)：CAM_FLAG_FIX | CAM_FLAG_PAUSE_NO_STOP
//		デフォルト            ：CAM_FLAG_FIX

// -rename_kms  変更元ＩＤ 変更先ＩＤ ...
// -rename_evm  変更元ＩＤ 変更先ＩＤ ...
// 変更元ＩＤ と 変更先ＩＤ を一組として、書き並べて下さい。KMSに関し
//ては-rename_kmsを使い、EVMに関しては、-rename_evmを使用するようにし
//て下さい。２つ一組として書き並べないとうまく動きませんので御了承を。


