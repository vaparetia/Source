	-flag   $i:フラグ \
	-thick  $i:ガラスの厚み（ｍｍ） \
	-size   $i:大きさ（１００） \  // デフォルト100
	-number $i:指定個数 \
	-point  $v:位置１ $v:位置２
// -point を指定個数分だけ繰り返して指定する。
mesg ガラス弾痕 $s:名前 on[1]
mesg ガラス弾痕 $s:名前 off[0]


