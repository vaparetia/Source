//---------------------------------------------------------------------
//森田

// バウンドチェックしてするための機構を初期化します stdch.hに入れる必
// 要あり
command エフェクトバウンド初期化[UTL_EFT_InitBound]

// バウンドを追加します。初期化フラグを使い分けることで複数のバウンディ
//ングを登録することが出来ます。
command エフェクトバウンド追加[UTL_EFT_AddBoundFromGCL] \
	$i:バウンド１Ｘ $i:バウンド１Ｙ $i:バウンド１Ｚ \  /* バウンド位置は対角の頂点を入力 */
	$i:バウンド２Ｘ $i:バウンド２Ｙ $i:バウンド２Ｚ \
	$i:初期化フラグ                                    /* １だと新規として０だと追加登録できる */

// 対応しているエフェクトは、バウンドチェックして消します
command エフェクトバウンド実行[UTL_EFT_ExecCallback]




//中心位置から10ユニットずつ前後左右に広がります。(デフォルト 0,-2000, 0)
//うねり周期は、0 厳禁。周期なので大きいほど遅くなります。(デフォルト 256)
chara 波面[NewOceanWave] $s:名前 \
	-s $w:うねり周期 \
	-t $s:テクスチャ名 \
	-p $v:中心位置 \
	-n $i:波涛個数 \           //（最大5個）
	-no_sOund \   // 音を鳴らしたくない
	-b $i:位置パラメータ ... \ // posx, posy, posz, size, roty, alpha
	-x $i:非表示領域位置X $i:非表示領域位置Z $i:非表示領域幅X $i:非表示領域奥行Z \
	-w $i:ブロック数（X） $i:ブロック数（Z）
// posx posz 波涛出現位置
// posy      波涛発生高さの条件
// size      波涛の高さ
// roty      波涛の向き（4096 = 360deg）
// alpha     波涛のα調整（-薄い  +濃い）

chara ブレットバリア[NewBulletBarriar] $s:名前 \
        -mode $i:モード \
	-flag $i:フラグ \
        -pos  $v:発射位置
//見えない所から銃が撃ってきてふっ飛ぶキャラです。
//モードは、関係なし
mesg ブレットバリア $s:名前 領域に入る[0]
mesg ブレットバリア $s:名前 領域を出る[1]


