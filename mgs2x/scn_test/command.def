	-unit 		$i:プリミティブ数 	\
	-vert 		$i:頂点数 		\
	-nring		$i:輪っか本体数		\
	-pos		$v:初期位置		\
	-fally		$i:リセットする高さ	\
	-rot		$v:初期方向		\
	-offset		$v:初期オフセット	\
	-ang		$v:初期拡散角度		\
	-initspd	$i:初期速度		\
	-speed		$i:目標速度		\
	-binitsize	$i:初期サイズ		\
	-daimsize	$i:目標サイズ		\
	-color		$i:色			\
