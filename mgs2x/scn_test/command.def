// 國部 /user/kunibe

chara テスト螺旋煙[NewSpiralSmokeScn] $s:名前 \
	-radius		$i:半径 \	// 螺旋半径 標準 800
	-pos		$v:位置 \	// 基本中心位置
	-flag 		$i:フラグ 	// テクスチャ加算フラグ  1 : 加算  0 : 減算

chara テスト昇り煙[NewRisingSmokeScn] $s:名前 \
	-radius		$i:半径 \	// 煙半径 500
	-pos		$v:位置		// 発生位置

chara 電灯虫[NewFlyingWarmScn] $s:名前 \
	-n		$i:匹数 \ 	// ４以上は４単位で（１、２、３、４、８、１２・・・）
	-p		$v:位置 \	// ライト位置 ->> プレイヤー誘導時は無視
	-b		$i:フラグ \	// 下のバウンディングボックスで壁との当たり見るか  1 : 判定あり, 0 : 判定なし
	-s		$v:バウンド１ \	// 最小ボックス座標
	-l		$v:バウンド２	// 最大ボックス座標

mesg 電灯虫 $s:名前 ノーマル[0]		// デフォルト
mesg 電灯虫 $s:名前 人誘導[1] $s:コントロール名
mesg 電灯虫 $s:名前 物誘導[2] $s:コントロール名
mesg 電灯虫 $s:名前 インビジブル[2]
mesg 電灯虫 $s:名前 キル[3]
mesg 電灯虫 $s:名前 壁当たりon[4]
mesg 電灯虫 $s:名前 壁当たりoff[5]

chara ステージ置き炎[NewStageFireScn] $s:名前 \
	-pos		$v:発生位置 \
	-status		$i:ステータス \ // 0 : 通常、1 : 消火後、2 : 消えない 
	-prOc		$p:壁消しプロック \
	-exec 		{ $:Ｘ位置 $:Ｙ位置 $:Ｚ位置 } \
	-flag 		$i:壁フラグ \	// 0 : 壁なし, 1 : 壁あり
	-xwidth		$i:壁Ｘ方向幅 \	// default : 250
	-zwidth		$i:壁Ｚ方向幅 	// default : 250

mesg ステージ置き炎 &s:名前 表示[0]	// 通常状態。処理して表示する。
mesg ステージ置き炎 &s:名前 非表示[1]	// 非表示状態。処理もカットする。
mesg ステージ置き炎 &s:名前 キル[2]	// キャラ殺す


chara 電撃床[NewElectricFloor] $s:名前
mesg 電撃床 $s:名前 キル[0]

chara ドアパネル電撃[NewDoorPannelSpark] $s:名前 \
	-pos		$v:中心位置 \
	-rot		$v:回転角度 \
	-width		$i:幅 \
	-height		$i:高さ \
	-mode		$i:SEモード \ // 0 : 範囲指定なしノーマルカーブ, 1 : 範囲指定ノーマルカーブ
	-length		$i:SE範囲     // SEモードで範囲指定にしたときのみ必ず指定

chara 電源パネル破壊エフェクト[NewPowerPannelSpark] $s:名前


chara 連絡橋爆発[NewBridgeExplosionScn] $s:名前
mesg 連絡橋爆発 $s:名前 終了[0]


chara 天狗兵ステージモニターW42a[NewTengMonitorControlW42a] $s:名前
chara 天狗兵ステージモニターW44a[NewTengMonitorControlW44a] $s:名前
chara 天狗兵ステージモニター[NewTengMonitorControl] $s:名前	// W45a
mesg 天狗兵ステージモニター $s:名前 ビジブル[0] $i:モニターID		// 指定IDのモニター群をビジブルにする
mesg 天狗兵ステージモニター $s:名前 インビジブル[1] $i:モニターID	// 指定IDのモニター群をインビジブルにする
mesg 天狗兵ステージモニター $s:名前 キル[2]				// 全モニター消去


//---------------------------------------------------------------------
// 奥田 /user/okuta

// 爆弾設置ポイントは難易度4段階、パターン32段階、１パターンあたり8個まで
// type は上位16ビットが難易度、パターン設定,下位16ビットが設置タイプを持ちます
// 各種定義文はw20c_fat.gclで
// rot は 0〜4096で与える(4096 == 360度)

// 対ビハインド用タイプフラグ
#define FAT_BH_DIR_UD 		0x00000003	// ビハインド方向が縦のデータ
#define FAT_BH_DIR_LR 		0x0000000C	// ビハインド方向が横のデータ
#define FAT_BH_VALID_B  	0x00000010	// 背面位置移動可能
#define FAT_BH_VALID_C  	0x00000020	// 対角位置移動可能
#define FAT_BH_VALID_BC		0x00000030	//
#define FAT_BH_VALID_S  	0x00000040	// 攻撃位置移動可能
#define FAT_BH_VALID_BS		0x00000050	//
#define FAT_BH_VALID_CS		0x00000060	//
#define FAT_BH_VALID_BCS	0x00000070	//
#define FAT_BH_VALID_H  	0x00000080	// ハードモード用位置移動可能
#define FAT_BH_VALID_BH		0x00000090	//
#define FAT_BH_VALID_CH		0x000000A0	//
#define FAT_BH_VALID_BCH	0x000000B0	//
#define FAT_BH_VALID_SH		0x000000C0	//
#define FAT_BH_VALID_BSH	0x000000D0	//
#define FAT_BH_VALID_CSH	0x000000E0	//
#define FAT_BH_VALID_BCSH	0x000000F0	//

#enum{ // GCLに渡すファットマン情報 :: procFatInfoコール時に渡される値
FAT_GCLINFO_PHASE_BOMB,		// 爆弾フェーズ開始
FAT_GCLINFO_PHASE_DEMINE,	// 解体フェーズ開始
FAT_GCLINFO_PHASE_SHOOT,	// 銃撃フェーズ開始
FAT_GCLINFO_STARTUP_BOMB,	// Ｃ４爆弾起動
FAT_GCLINFO_CLEAR_BOMB,		// Ｃ４爆弾解体完了
FAT_GCLINFO_GAME_CLEAR,		// ファットマン戦終了
FAT_GCLINFO_FALL,		// ファットマン転倒
}
// -cparamはファットマンのゲーム中のパラメーターを設定する
// [ 体力 ][ブラストスーツ耐久値:何発で倒れるか][耐久値回復フレーム:何フレームで回復するか][攻撃力割合:Normalを100として]の順
// -edifficultは爆弾設置レベルを耐久力の何％で切り分けるかを設定します( 25, 30, 20, 25)
//
chara ファットマン[NewFatman] $s:名前 \
	-s 		$i:判別用ID番号 \
	-p 		$v:初期位置 \
	-d		$i:初期Ｙ方向 \
	-cparam		$i:パラメーター ... \
	-hdifficult	$i:爆弾難度レート ... \
	-mkamome	$s:カモメマネージャ \
	-over 		$p:C4爆発ゲームオーバープロシージャ \
	-ubombover	$p:C4狙撃爆発ゲームオーバープロシージャ \
	-kill 		$p:ファットマン倒しプロシージャ \
	-endknock 	$p:ファットマン眠らせ倒しプロシージャ \
	-ginfo  	$p:ファットマン情報プロシージャ \
	-vox 		$t:ストリーム音声 ... \
	-flagvox 	$i:ストリーム音声再生フラグ ... \
	-len_vox 	$t:ストリーム音声長さ ... \
	-jputnum	$i:爆弾設定 ... \
	-index 		$i:爆弾設置ポイントインデックス ... \
	-type 		$i:爆弾設置ポイント種類 ... \
	-nmtrap 	$s:爆弾設置ポイントトラップ名 ... \
	-bmpos 		$v:爆弾設置ポイント位置 ... \
	-aimpos 	$v:爆弾設置ファットマン立ち位置 ... \
	-qrotindex	$i:爆弾設置ポイント回転情報インデックス ... \
	-rot 		$v:爆弾設置ポイント回転 ...

mesg ファットマン $s:名前 初回設置[0] $i:制限時間 $i:設置1 ...

command ファットマン非表示[NewCmdFatInvisible]
command ファットマン表示[NewCmdFatVisible]

#enum{ // 反応
PREZ_REACT_BASE,		// しゃがむorあしあげ
PREZ_REACT_BEHIND,		// 張りつき
PREZ_REACT_SIDESTEP,  		// 横飛び
PREZ_REACT_TUMBLE,		// 転倒
PREZ_REACT_SPECIAL,		// スライディングorサマーソルト
}

chara ニキータイベント大統領[NewPrezNikita] $s:名前 \
	-pos 		$v:初期位置 \
	-yrot		$i:初期Y回転量 \
	-hp		$i:現在耐久値 \
	-maxhp		$i:最大耐久値 \
	-over 		$p:大統領死亡ゲームオーバープロシージャ \
	-sknock 	$p:初回ノック反応プロシージャ \
	-vox 		$t:ストリーム音声 ... \
	-flagvox 	$i:ストリーム音声再生フラグ ... \
	-len_vox 	$t:ストリーム音声長さ ... \
	-dist 		$i:ニキータ反応距離 \
	-bomb 		$i:爆発音反応距離 \
	-noise 		$v:聞き耳ポイント ... \
	-wdir 		$v:聞き耳方向 ... \
	-eave 		$i:聞き耳時間 \
	-relay		$v:中継ぎポイント \
	-keepeye 	$i:注目時間 \
	-conf 		$v:パニックに陥って逃げる位置 ... \
	-time		$i:パニック時間 \
	-area		$i:逃げエリア ... \
	-iplayback	$i:反応 ... \
	-gtrap		$s:ノイズ検知トラップ
command ニキータイベント大統領難易度取得[NewGclGetPrezLevel] $r:難易度
command ニキータイベント大統領耐久値取得[NewGclGetPrezLife] $r:耐久値
mesg ニキータイベント大統領 $s:名前 寝かせる[0]           $i:X座標 $i:Y座標 $i:Z座標 $i:向き
mesg ニキータイベント大統領 $s:名前 ルート変更[1] 	  $i:ルート番号
mesg ニキータイベント大統領 $s:名前 ルート変更クイック[2] $i:ルート番号

#enum{ // かもめマネージャの基本思考
KMNG_BASE_NORMAL, 	// 基本状態:特徴なし
KMNG_BASE_LIGHT,	// 基本状態:計算量少ないver
KMNG_BASE_BARDY, 	// 基本状態:ずうずうしい
KMNG_BASE_ESCAPE, 	// 基本状態:敏感
KMNG_BASE_ANGRY, 	// 基本状態:怒り
}
#enum{ // カモメ初期位置特殊指定
KMM_IPOS_LINE  = 0x00000200,	// 線指定
KMM_IPOS_AREA  = 0x00000400,	// エリア指定
}
#enum{ // カモメ飛行エリア指定方式
KMM_FLYA_TRAP  = 0x00000100,	// トラップ指定
KMM_FLYA_BOUND = 0x00000200,	// バウンディングボックス指定
}
#enum{ // カモメモーション
KMM_MOT_IDLE,		// アイドリング
KMM_MOT_IDLE02,		// アイドリング２
KMM_MOT_FLYING_START,	// 飛び開始
KMM_MOT_FLYING,		// 飛び
KMM_MOT_FLYING_END,	// 飛び終了
KMM_MOT_FLYING02,	// 飛び２
KMM_MOT_FLYING03_START,	// 飛び３開始
KMM_MOT_FLYING03,	// 飛び３
KMM_MOT_FLYING03_END,	// 飛び３終了
KMM_MOT_HOVER,		// 滑空
KMM_MOT_HOVER02,	// 滑空２
KMM_MOT_FLYAWAY,	// 飛び去り
KMM_MOT_FLYAWAY_QUICK,	// 飛び去り
KMM_MOT_LANDING,	// 着地
KMM_MOT_WALK_START,	// 歩き
KMM_MOT_WALK_END,	// 歩き終わり
KMM_MOT_WALK_A,		// 歩き１
KMM_MOT_WALK_B,		// 歩き２
KMM_MOT_PICK_A,		// つつき１
KMM_MOT_PICK_B,		// つつき２
KMM_MOT_SURPRISE,	// 驚き
KMM_MOT_SURPRISE_BACK,	// 驚き後退
KMM_MOT_ATTACK_A,	// 攻撃１
KMM_MOT_ATTACK_B,	// 攻撃２
KMM_MOT_ATTACK_C,	// 攻撃３
KMM_MOT_DAM1_START,	// 上空でのダメージ
KMM_MOT_DEAD,		// 死亡
KMM_MOT_DAM1_END,	// 接地
KMM_MOT_FALL,		// 落ちる
KMM_MOT_DAM2_START,	// 低空でのダメージ
KMM_MOT_DAM2,		// ダメージ
KMM_MOT_DAM2_END,	// 接地
KMM_MOT_FALL2,		// 落ちる
KMM_MOT_SLEEP1,		// 寝る
KMM_MOT_SLEEP2,		// 寝る
KMM_MOT_WAKE_HIGH,	// 起きる
KMM_MOT_WAKE_LOW,	// 起きる
KMM_MOT_MAX,		// 最大数
}
#enum{ // カモメ初期ルーチン
KMM_INITTHK_REST,	// 羽やすめ
KMM_INITTHK_FLYAWAY,	// 飛び立ち
KMM_INITTHK_FLYING,	// 飛行
KMM_INITTHK_FLIPFLOP,	// ばたつき
KMM_INITTHK_GROUNDREST,	// 地面で羽やすめ
}
// -wdmgproc : カモメがダメージを受けた時に呼ぶプロシージャ
// $1 == 0 で 死亡、 $1 == 1 で眠り $1 == 2 で気絶
chara かもめマネージャ[NewKamomeManager] $s:名前 \
	-qpigeon	$i:ハトモードフラグ \
	-xlod		$i:ＬＯＤ切替え距離 \
	-datamdl	$s:モデルデータ名 ... \
	-name		$s:かもめの名前 ... \
	-seed		$i:ランダム用シード \
	-base		$i:基本ルーチン \
	-wdmgproc	$p:カモメがダメージを受けた時に呼ぶプロシージャ \
	-zspeed		$i:平均速度 \
	-gspeed		$i:死亡時落下速度 \
	-eraseh		$i:死亡時に消去する高さ \
	-cdanna		$s:フン許可トラップ \
	-unitpos	$i:初期位置指定用フラグ ... \
	-pos 		$v:初期位置 ...\
	-linepos 	$v:線指定型初期位置 ...\
	-farea		$v:エリア指定型初期位置 ...\
	-yrot		$i:初期Ｙ回転量 ...\
	-traparea	$s:飛行エリアトラップ列 ... \
	-areadata	$v:飛行エリアバウンド列 ... \
	-indexarea	$i:飛行エリアインデックス ... \
	-mot		$i:初期モーション ... \
	-routine	$i:初期思考 ...

mesg かもめマネージャ $s:名前 全かもめ指定線上着地[1] $i:始点X $i:始点Y $i:始点Z $i:終点X $i:終点Y $i:終点Z $i:割合 $i:ディレイ幅
mesg かもめマネージャ $s:名前 全かもめ指定エリア上着地[2] $i:中心X $i:中心Y $i:中心Z $i:X幅 $i:Y幅 $i:Z幅 $i:ディレイ幅
mesg かもめマネージャ $s:名前 全かもめ飛行[3] $i:ディレイ幅
mesg かもめマネージャ $s:名前 全かもめ攻撃[4] $i:ディレイ幅 $s:攻撃対象名前
mesg かもめマネージャ $s:名前 全かもめ頭上付随[5] $i:ディレイ幅 $s:付随対象名前
mesg かもめマネージャ $s:名前 全かもめ集合トラップ[6] $i:注視X $i:注視Y $i:注視Z $s:集合トラップ名前 $i:ディレイ幅
mesg かもめマネージャ $s:名前 全かもめ集合エリア[7] $i:注視X $i:注視Y $i:注視Z $i:始点X $i:始点Y $i:始点Z $i:終点X $i:終点Y $i:終点Z $i:ディレイ幅
mesg かもめマネージャ $s:名前 全かもめ緊急離陸[8] $i:ディレイ幅
mesg かもめマネージャ $s:名前 全かもめ死亡[9] $i:ディレイ幅
mesg かもめマネージャ $s:名前 トラップ内エリア変更[10] $s:検索トラップ名 $s:変更先トラップ名 $i:ディレイ幅
mesg かもめマネージャ $s:名前 指定球内エリア変更[11] $i:中心X $i:中心Y $i:中心Z $i:半径 $s:変更先トラップ名 $i:ディレイ幅
mesg かもめマネージャ $s:名前 エルード妨害線指定[12] $s:指定トラップ $i:始点X $i:始点Y $i:始点Z $i:終点X $i:終点Y $i:終点Z $i:割合 $i:ランダム割合 $i:待機時間最小 $i:待機時間最大 $i:ディレイ幅
mesg かもめマネージャ $s:名前 指定数集合[13] $i:カモメ数 $i:注視X $i:注視Y $i:注視Z $i:始点X $i:始点Y $i:始点Z $i:終点X $i:終点Y $i:終点Z $i:ディレイ幅
mesg かもめマネージャ $s:名前 指定トラップ内集合[14] $s:検索トラップ名前 $i:集合させる数 $i:注視X $i:注視Y $i:注視Z $s:集合トラップ名前 $i:ディレイ幅
mesg かもめマネージャ $s:名前 指定エリア内集合[15] $i:検索最小X $i:検索最小Y $i:検索最小Z $i:検索最大X $i:検索最大Y $i:検索最大Z \
	                                           $i:集合させる数 $i:注視点X $i:注視点Y $i:注視点Z $s:集合トラップ名前 $i:ディレイ幅
mesg かもめマネージャ $s:名前 指定球内緊急離陸[16] $i:中心X $i:中心Y $i:中心Z $i:半径 $s:変更先トラップ名 $i:飛行速度 $i:ディレイ幅
mesg かもめマネージャ $s:名前 指定球内緊急散開[17] $i:中心X $i:中心Y $i:中心Z $i:半径 $s:変更先トラップ名 $i:飛行速度 $i:ディレイ幅
mesg かもめマネージャ $s:名前 指定トラップ内緊急離陸[18] $s:検索トラップ $s:変更先トラップ名 $i:飛行速度 $i:ディレイ幅
mesg かもめマネージャ $s:名前 指定トラップ内緊急散開[19] $s:検索トラップ $s:変更先トラップ名 $i:飛行速度 $i:ディレイ幅

mesg かもめマネージャ $s:名前 指定球内搾取線着地[20] $i:着地させる匹数 $i:中心X $i:中心Y $i:中心Z $i:半径 $i:始点X $i:始点Y $i:始点Z $i:終点X $i:終点Y $i:終点Z $i:着地時間最小 $i:着地時間最大 $i:ディレイ幅
mesg かもめマネージャ $s:名前 指定トラップ内搾取線着地[21] $i:着地させる匹数 $s:検索トラップ $i:始点X $i:始点Y $i:始点Z $i:終点X $i:終点Y $i:終点Z $i:着地時間最小 $i:着地時間最大 $i:ディレイ幅

