	-pos 		$v:初期位置 \
	-yrot		$i:初期Y回転量 \
	-hp		$i:体力 \
	-blankmin	$i:喋りブランク最小値 \
	-cblankmax	$i:喋りブランク最大値 \
	-vox 		$t:ストリーム音声 ... \
	-flagvox 	$i:ストリーム音声再生フラグ ... \
	-len_vox 	$t:ストリーム音声長さ ...

mesg オウム $s:名前 喋りON[0]
mesg オウム $s:名前 喋りOFF[1]
