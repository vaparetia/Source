//重野 /user/sigeno shigeno
/*ドッグタグ取得フラグセット*/
command ドッグタグフラグセット[NewSIG_SetDogTagFlag] $w:番号
/*名前からドッグタグ取得セット*/
command ドッグタグ取得セット[SIG_SetDogTagFlagName] $d:名前
command ドッグタグゼロクリア[SIG_DogTagZeroClear] 
