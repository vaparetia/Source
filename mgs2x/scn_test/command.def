	-ch_map $s:マップ名 \
	-group $b:グループ番号 \
	-proc $p:初影縛りプロック

chara シネマスクリーンＥ３[NewCinemaScreen_e3] $s:name \
	-top $i:上のピクセル数 \
	-bottom $i:下のピクセル数 \
	-ftime $i:フェードのフレーム数	//デフォルト値（ゼロは駄目）

mesg シネマスクリーンＥ３ $s:名前 フェードアウト[0] $i:フェードのフレーム数		//ゼロでデフォルト値
mesg シネマスクリーンＥ３ $s:名前 フェードイン[1] $i:フェードのフレーム数		//ゼロでデフォルト値
mesg シネマスクリーンＥ３ $s:名前 kill[2]

chara エマ虫[NewEmmaSlater] $s:名前 \
	-group $b:グループ番号 \
	-atrap $s:移動可能トラップ名 \
	-trap $s:トラップ名 \
	-n_rfg $i:逃げトラップセット数 \
	-refuge $s:逃げトラップ名 $s:逃げトラップ名 ...2

mesg エマ虫 $s:name 表示[0]
mesg エマ虫 $s:name 非表示[1]


chara デモ虫[NewDemoSlater] $s:名前 \
	-group $b:グループ番号 \
	-atrap $s:移動可能トラップ名 \
	-trap $s:トラップ名 \
	-n_rfg $i:逃げトラップセット数 \
	-refuge $s:逃げトラップ名 $s:逃げトラップ名 ...2

mesg デモ虫 $s:name 表示[0]
mesg デモ虫 $s:name 非表示[1]
mesg デモ虫 $s:name 起動[2] $i:フナ虫番号<0<=>31>
mesg デモ虫 $s:name 撤収[3] $i:フナ虫番号<0<=>31> $i:逃げトラップ番号<0<=>n_rfg-1>
mesg デモ虫 $s:name 複数起動[4] $i:フナ虫番号１<0<=>31> $i:フナ虫番号２<0<=>31>
mesg デモ虫 $s:name 複数撤収[5] $i:フナ虫番号１<0<=>31> $i:フナ虫番号２<0<=>31> $i:逃げトラップ番号<0<=>n_rfg-1>


chara フナ虫リーダー[NewAllSlater] $s:名前 \
	-n_obj  $i:チェックキャラ数 \
	-obj    $s:キャラネーム ... \
	-flag	$i:フラグ \
	-pos    $i:Ｘ座標 $i:Ｙ座標 $i:Ｚ座標 \		//中心
	-wide   $i:横幅 $i:縦幅 \					//幅
	-rot    $w:Ｘ回転 $w:Ｙ回転 $w:Ｚ回転 \		//回転
	-nRfg   $i:逃げ込みエリア数 \
	-rEfuge $i:横オフセット $i:縦オフセット $i:横幅 $i:縦幅 \	//
	-escape $i:横オフセット $i:縦オフセット $i:横幅 $i:縦幅	\	//-nRfg個
	-debug

#define		ALLSLT_FLAG_NO_STOMP	0x0001		//踏み潰さない（壁にいる奴は立ててください）
#define		ALLSLT_FLAG_NO_SPRAY	0x0002		//スプレー鬼逃げしない

chara 舟虫[NewSeaSlater] $s:名前 \
	-group $i:グループ数 \
	-in_group $i:グループ内個体数 \
	-data $i:横オフセット $i:縦オフセット $i:横幅		//リーダーの（-wide）内を指定

mesg 舟虫 $s:name 表示[0]
mesg 舟虫 $s:name 非表示[1]


chara 船虫踏み潰し管理[NewCheckSlater] $s:名前 \
	-group $b:グループ番号 \
	-atrap $s:移動可能トラップ名 \
	-n_obj $i:チェックキャラ数 \
	-obj   $s:キャラネーム ...

chara 潰れふなむし[NewTrampleSlater] $s:名前

chara 浮遊紙[NewFlowPaper] $s:名前 \
	-c $i:チェックキャラ数 \
	-o $s:チェックキャラ名 ... \
	-n $i:紙キャラ数 \
	-m $s:モデル名 \		//ここから複数
	-group $b:グループ番号 \
	-trap $s:トラップ名

mesg 浮遊紙 $s:name 表示[0]
mesg 浮遊紙 $s:name 非表示[1]

chara 水中血[NewBloodWater_Scn] $s:名前 \
	-p $i:ＸＹＺ ... \
	-r $i:ＲＯＴ ... \
	-f $i:初期速度 \
	-m $i:モード \			//お問い合わせ
	-d $b:デバッグフラグ	//無くてもいい

#define		BLDWTR_MODE_NORM	0	//ノーマル
#define		BLDWTR_MODE_SOYS	1	//醤油
#define		BLDWTR_MODE_ORNG	2	//オレンジ
#define		BLDWTR_MODE_PLY1	3	//プレイヤー用少量
#define		BLDWTR_MODE_PLY2	4	//プレイヤー用多量

chara 汎用アニメポリゴン[NewGeneralPoly_Scn] $s:名前 \
	-tex $s:ＴＥＸコード \
	-mode $i:モード \
	-divi $i:横分割数 $i:縦分割数 \
	-n_ply $b:ポリゴン数（１６まで）\
		-color $b:Ｒ $b:Ｇ $b:Ｂ $b:Ａ \
		-init $b:初期テクスチャ位置 \
		-pos $i:Ｘ $i:Ｙ $i:Ｚ ...3		//ここは４つ

mesg 汎用アニメポリゴン $s:name 表示[0]
mesg 汎用アニメポリゴン $s:name 非表示[1]
mesg 汎用アニメポリゴン $s:name 切り替え[2] $i:ポリゴン番号 $i:テクスチャ位置
mesg 汎用アニメポリゴン $s:name ＡＬＰ変更[3] $i:ポリゴン番号 $i:時間 $i:Ａ

#define GPOLY_MODE_FOG		0x0010	// フォグが掛かる
#define GPOLY_MODE_TEX		0x0000	// 描画モード　テクスチャーそのまま
#define GPOLY_MODE_ADD		0x0001	// 描画モード　加算
#define GPOLY_MODE_SUB		0x0002	// 描画モード　減算
#define GPOLY_MODE_ALPHA	0x0003	// 描画モード　アルファ

chara 全薬莢コントロール[NewEnbControl] $s:名前 \
	-n_emb $i:表示最大薬莢数 \
	-ratios $i:ＵＳＰ割合 \
			$i:グロック割合 \
			$i:ソコム割合 \
			$i:ファマス割合 \
			$i:Ｐ９０割合 \
			$i:Ｍ４Ａ１割合 \
			$i:アバカン割合 \
			$i:ＡＫＳ割合 \
			$i:ＰＳＧ割合 \
			$i:スパス割合 \
			$i:ＭＥＣＡ割合 \		//カメラとかの
			$i:Ｍ４割合 \
			$i:Ｍ４グレネード割合	//デモのみ

//各割合の合計を表示最大薬莢数と同じにして下さい
//前は一種類が３２個でした。

chara トイレ流れ[NewWcFlush_Scn] $s:名前 \
	-pos    $i:Ｘ座標 $i:Ｙ座標 $i:Ｚ座標		//中心

mesg トイレ流れ $s:name 表示[0]
