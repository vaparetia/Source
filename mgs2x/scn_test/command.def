			$r:怒りフラグ /*1:怒り中 0:怒ってない*/
/*	現在ルートは 0, 1, 2, 3 の４つ	*/
command ゲットカサッカライフ[NewKac_CommandGetKasLife] \
			$r:残りライフ
/*	０〜１００で表現 MAX:１００	*/
