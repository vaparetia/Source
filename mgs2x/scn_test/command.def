//壊れ用 当たりのハザードＩＤ
//以下壊れ物キャラにおいてハザードＩＤに使用するためのフラグ
#define BRK_HZD_W01A1_STAIRWAY  1
#define BRK_HZD_W01A1_BAR       2
#define BRK_HZD_W01A1_TV_SPACE1 3
#define BRK_HZD_W01A1_TV_SPACE2 4
#define BRK_HZD_W01F_STAIRWAY   1
#define BRK_HZD_W01F_BAR        2
#define BRK_HZD_W01F_TV_SPACE1  3
#define BRK_HZD_W01F_TV_SPACE2  4
#define BRK_HZD_W01D_STORAGE    5
#define BRK_HZD_W01D_KITCHEN    6
#define BRK_HZD_W01D_DINING_L   7
#define BRK_HZD_W01D_DINING_R   8
#define BRK_HZD_W01D_DINING     9
#define BRK_HZD_W01F_BAR2       10
#define BRK_HZD_W01F_BAR3       11

#define BRK_HZD_W11C_FORTUNE     12
#define BRK_HZD_W16A_KITCHEN     13
#define BRK_HZD_W16A_SINK        14
#define BRK_HZD_W16A_DASHBOARD   15
#define BRK_HZD_W16A_LRG_GLASS   16
#define BRK_HZD_W16A_TOILET_MEN   17
#define BRK_HZD_W16A_TOILET_WOMEN 18
#define BRK_HZD_W16A_DINING_TBL0 19
#define BRK_HZD_W16A_DINING_TBL1 20
#define BRK_HZD_W16A_DINING_TBL2 21
#define BRK_HZD_W16A_LOCKER      22
#define BRK_HZD_W16A_CABINET     23
#define BRK_HZD_W24B_REFRESH     24
#define BRK_HZD_W24B_BOTTLE_KEEP 25
#define BRK_HZD_W24C_PARTY_TABLE 26
#define BRK_HZD_W24C_SPEECH_STG  27
#define BRK_HZD_W24D_COMP_ROOM1  28
#define BRK_HZD_W24D_COMP_ROOM2  29


chara プット壊れオブジェ[NewPutBreakObject] $s:名前 \
	-model    $s:壊れ前モデル名 $s:壊れ後モデル名 ... \
	-param    $i:パラメータ ... \
	-light    $s:光源 \
	-number   $i:物体の数 \
	-radius   $i:物体の半径 \
	-stable   $i:安定度 \
	-explode  $i:破裂度 $i:破裂時の跳ね度 \
        -hAzard   $i:ハザードＩＤ \
	-human    $i:登録できる足の人数 \
	-box      $s:箱のモデル \
	-geometry $i:箱のパラメータ ... \
	-dust     $i:カス出しモード \
	-brk_sE   $i:壊れの時のSE \
	-drp_Se   $i:落ちるの時のSE \
	-proC     $p:壊れぷロック \
	-Broken   $f:壊れフラグ \
	-flag     $i:フラグ
// -model   壊れ前のモデル 壊れ後のモデル [壊れかすのコモデル (なくてもいい)]
//	の順番に指定する
// -light   指定するとプリシェードで、なければシェードで表示する。
// -param px,py,pz, rx,ry,rz  ... （必須）
//	px,py,pz 初期位置
//	rx,ry,rz 初期角度
// -number  物体の数（必須）
// -explode 破裂度 0〜100目安（事実上上限はない） 破裂時の跳ね度 0〜100目安
// -radius  物体の大きさ(半径) なければ幅をモデルより自動的に検出する
// -stable  物体の安定度 0〜100  大きければ安定性大
// -hazard  壊れ当たりを指定する。BRK_HZD_????で定義されている物を使うこと
// -human   登録した人の足に物体が反応する（登録はメッセージで）
// -dust    カスを出すモード
//	0 はカボチャのカス
//	1 はガラスのカス
// -flag    フラグは、以下の意味をなす。（必須）
//	BRK_COLLISION	物体同士の当たり(sphereの球形当たり)を見る
//	BRK_STRICT_FLR  ポリゴンの形通りに床に接する（少し重い、頂点数に比例）
//	BRK_ROLLOVER    動く時には転がる
//	BRK_NO_GRAVITY  本体に重力なし
//	BRK_STABLE_X    X軸に対し安定している
//	BRK_STABLE_Y    Y軸に対し安定している
//	BRK_STABLE_Z    Z軸に対し安定している
//	BRK_NO_BOXSHOW  箱の表示なし
//	BRK_NO_BOXTRG   箱のターゲット及び当たり無し
//      BRK_RND_DRP_SE  落ちた時にランダムにSEを鳴らす（ランダム幅は４）
//      BRK_RND_BRK_SE  壊れた時にランダムにSEを鳴らす（ランダム幅は４）
#define BRK_COLLISON    0x00000001
#define BRK_STRICT_FLR  0x00000002
#define BRK_ROLLOVER    0x00000004
#define BRK_NO_GRAVITY  0x00000008
#define BRK_STABLE_X    0x00000010
#define BRK_STABLE_Y    0x00000020
#define BRK_STABLE_Z    0x00000040
#define	BRK_NO_BOXSHOW  0x00000080
#define BRK_NO_BOXTRG   0x00000100
#define BRK_RND_DRP_SE  0x00000200
#define BRK_RND_BRK_SE  0x00000400
#define BRK_BRK_SPREAD  0x00000800
#define BRK_NO_KICK     0x00001000
mesg プット壊れオブジェ $s:名前 foot[0] $i:オブジェクトへのポインタ
//このメッセージにより 登録した人の足に物体が反応するようになる
//0 ならプレーヤの足を登録する
mesg プット壊れオブジェ $s:名前 もう壊れている[1]


chara プットテレビオブジェ[NewPutTVObject] $s:名前 \
        -model $s:モデル名 \
        -speed $i:画面スクロールスピード \ //デフォルト 100
	-proC   $p:壊れぷロック \
	-Broken $f:壊れフラグ \
        -light $s:光源 \
        -rot   $v:向き \
        -pos   $v:場所
//-broken を１にすると壊れた状態から始まります。プロックとフラグを併用
//してうまく利用し下さい。

mesg プットテレビオブジェ $s:名前 もう壊れている[1]



chara プットカンニング台オブジェ[NewPutSpeechObject] $s:名前 \
        -model $s:モデル名 $s:破片モデル名 \
        -rot   $v:向き \
        -pos   $v:場所
//カンニング台



chara プット旗オブジェ[NewPutFlagObject] $s:名前 \
        -model $s:アニメモデル名 \
        -rot   $i:向き $i:大揺れ角速度 $i:着弾角度 \
        -pos   $v:場所

//modelに指定するアニメモデルはKMSとCV2が必要です。必ずSRCにいれてくだ
//さい。アニメモデルと言えばデザイナーに分かります。要は、キーレフレー
//ム化したモデルのことです。
//-rot について
//	向きは、初期状態の旗の向きを表します。(w25aで推奨-256)
//	大揺れ角速度は、旗めくメッセージのときにその速度で揺れます(推奨512)
//	着弾角度は、弾が当たったときに着弾角度まで揺れます(推奨128)
mesg プット旗オブジェ $s:名前 旗めく[0]   /* 旗めきます */




chara プット制御室モニター[NewPutMonitor] $s:名前 \
	-flag  $i:壊れフラグ \
	-proc  $p:プロック
// W12b専用キャラ
// １８個のモニターを切替えながら変わります。撃ったら壊れます。
// 画面に映している内容を変えたい場合は、森田まで...
//-procは、プロック 引数に$1が現在の壊れ状況を示すものです。プロック内
//で、シナリオ変数の壊れフラグに代入する用にして下さい。
//-flagは、壊れフラグです。シナリオの変数を入れて下さい。



//chara 壊れコンピュータ系のフラグに、共通して使えるもの
// -flagは、壊れフラグは以下のものです。
// -procは、プロック 引数に$1が現在の壊れ状況を示すものです。プロック
//内で、シナリオ変数の壊れフラグに代入する用にして下さい。
chara 壊れコンピュータW12B[NewBreakComputerW12b] $s:名前 \
	-flag  $i:壊れフラグ \
	-proc  $p:プロック
chara 壊れコンピュータW24D[NewBreakComputerW24d] $s:名前 \
	-flag  $i:壊れフラグ \
	-proc  $p:プロック
mesg 壊れコンピュータW24D $s:名前 画面切替え[0] $i:画面番号
//名前を必ず 「エロコンピュータ画面１」と「エロコンピュータ画面２」に
//して下さい。「エロコンピュータ画面１」は中央の方で、「エロコンピュー
//タ画面２」は、左側の方です。
//画面番号は０、１は普通画面 ２、３がエロ画面です。


chara プット壊れ通気口[NewPutVentObject] $s:名前 \
	-model $s:壊れ前 $s:壊れ中 $s:壊れ後 \
	-pos   $v:位置 \
	-rot   $v:回転 \
	-life  $i:半壊で耐える回数 \
	-state $i:壊れ状態 \
	-prOc  $p:プロック
// -modelに壊れモデルKMSを３つ指定して下さい。壊れ前、少し壊れた、完全
//に壊れた状態のモデルです。
// -procに指定したプロックは引数付で呼ばれます。$1に名前 $2に状態が入
//ります。状態は、上のモデル順にして0,1,2で入ります。つまり完全に壊れ
//た場合2が入ります。
// -life  は、半壊状態を維持する回数です。(デフォルトは２です)
// -state は、金網の開始する状態を指定します。以下の通りです。
//    0   壊れていない
//    1   半壊
//    2   全壊


chara 自動販売機[NewVendingMachine] $s:名前 \
	-hazard    $i:ハザードＩＤ \
	-light     $s:光源 \
	-flag      $i:フラグ \
	-can_Num   $i:缶の総数 \   //つまり自動販売機の数で割ったのが一つあたりに出る缶の量
	-can_Model $s:缶のモデル $s:缶壊れモデル \
	-number    $i:自動販売機の数 \
        -model     $s:自動販売機モデル $s:自動販売機壊れモデル \ // ここから複数指定（必ず最初）
        -pos       $v:自動販売機の場所     \
        -rot       $v:自動販売機の向き     \
	-proC      $p:自動販売機プロック   \
	-Broken    $f:自動販売機壊れフラグ \
	-end                                                     // ここから複数指定（必ず最後）
//現在、フラグは未使用

//自動販売機を複数個設置する場合は、-numberに設置する数を入れ、-model
//から-endを繰り返し指定して下さい。

//-broken を１にすると壊れた状態から始まります。プロックとフラグを併用
//してうまく利用し下さい。
mesg  自動販売機 $s:名前 もう壊れている[1]


chara プット書類オブジェ[NewPutFileObject] $s:名前 \
        -model  $s:重ねモデル $s:一枚モデル ... \
	-hazard $i:ハザードＩＤ \
	-light  $s:光源 \
	-proC   $p:壊れぷロック \
	-Broken $f:壊れフラグ \
	-flag   $i:フラグ \
	-number $i:書類数 \
        -pos    $v:場所 \     // ここから複数指定（必ず最初）
        -rot    $v:回転       // ここから複数指定（必ず最後）
//現在、フラグは未使用

//-broken を１にすると壊れた状態から始まります。プロックとフラグを併用
//してうまく利用し下さい。
mesg  プット書類オブジェ $s:名前 もう壊れている[1]


chara プット封筒オブジェ[NewPutFedralExObject] $s:名前 \
        -number $i:雑誌の数 \         //雑誌の数 は 1以上を入れること
        -model  $s:封筒モデル \     //封筒モデル：1オブジェ
        -break  $s:埃コモデル \       //コモデル：2オブジェ
        -proC   $p:壊れぷロック \     //撃たれた時に呼ばれる
        -hazard $i:ハザードＩＤ \     //上の「壊れ用 当たりのハザードＩＤ」を使うこと
        -light  $s:光源 \             //ステージの光源ファイル名
        -Broken $f:壊れフラグ \       //
        -type   $i:テクスチャー種類 \ //ここから複数指定（必ず最初）
        -pos    $v:場所 \             //位置
        -rot    $i:Ｙ軸回転 \         //向き
        -Height $i:静止Ｙ位置         //ここまで複数指定（必ず最後）

//複数指定の場合は -pos から -height までを -number の指定した回数だけ
//繰り返す。その際 必ず最初に-posのオプションを指定し最後に-heightオプ
//ションを指定すること
//-break,-numberと-hazardは一つでいいです。一つでいいオプションは、先
//に指定して下さい。

//-broken を１にすると壊れた状態から始まります。プロックとフラグを併用
//してうまく利用し下さい。

mesg プット封筒オブジェ $s:名前 もう壊れている[1]



chara プット雑誌オブジェ[NewPutMagazineObject] $s:名前 \
	-number $i:雑誌の数 \                     //雑誌の数 は 1以上を入れること
        -break  $s:ページモデル  $s:埃コモデル \  //ページモデル：2オブジェ コモデル：2オブジェ
        -hazard $i:ハザードＩＤ \
        -model  $s:壊れ前モデル $s:壊れモデル \   //壊れ前：1オブジェ、壊れモデル：2間接オブジェ
        -pos    $v:場所 \
        -rot    $v:向き \
	-type   $i:テクスチャー種類 \					// 0 -> 8
	-proC   $p:壊れぷロック \
	-Height $i:静止Ｙ位置 \
	-Broken $f:壊れフラグ \
        -light  $s:光源
//複数指定の場合は modelからlightまでをnumberの指定した回数だけ繰り返す。
//その際modelを必ず最初にlightを最後にすること
//-break,-numberと-hazardは一つでいいです。

//-broken を１にすると壊れた状態から始まります。プロックとフラグを併用
//してうまく利用し下さい。

mesg プット雑誌オブジェ $s:名前 もう壊れている[1]
command ゲット雑誌オブジェ座標[ComGetMagazinePos] $i:テクスチャー種類 $r:Ｘ座標変数 $r:Ｙ座標変数 $r:Ｚ座標変数 $r:有効フラグ


chara プット植物オブジェ[NewPutTreeObject] $s:名前 \
        -m $s:モデル名 \
        -b $s:葉のモデル名 \
        -r $v:向き \
        -p $v:場所 \
        -l $s:光源 \
	-proC   $p:壊れぷロック \
	-Broken $f:壊れフラグ \
        -s $v:スケール
//植物で親子関係を持ったモデルの木で、葉っぱを散らせることが出来る
mesg プット植物オブジェ $s:名前 もう壊れている[1]
//-broken を１にすると壊れた状態から始まります。プロックとフラグを併用
//してうまく利用し下さい。


chara プットガラスオブジェ[NewPutGlassObject] $s:名前 \
        -model   $s:モデル名（ＣＶ２） ... \
        -texture $s:壊れ前テクスチャー名 $s:壊れ後テクスチャー名 ... \
        -rot     $v:向き \
        -pos     $v:場所 \
	-flag    $i:フラグ \
	-thicK   $i:厚さ \
	-hazarD  $i:ハザードＩＤ \
        -prOc    $p:壊れプロック \
	-Broken  $f:壊れフラグ
//-textureは、pack_trnallで半透明のTRIに入れて下さい。壊れ前のテクスチャー
//でモデル名に貼られます。一発でも当たると壊れ後のテクスチャーで表示さ
//れます。両方とも同じ解像度（大きさ）にすることをお勧めします。
//-model は、必ずZ方向に対して平たくなるようにして下さい。原点置きモデ
//ルは、使用出来ません。モデルの中心に原点が来るようなモデルにしてシナ
//リオ側で回転させて配置するようにして下さい。平たくなくても構いません
//が、いろいろな理由でうまく表示できない可能性があります。
//モデルは、cv2の頂点＆法線のみで結構です。KMSは要りません。破片コモデ
//ルは、KMSのみ要ります
//-broken を１にすると壊れた状態から始まります。プロックとフラグを併用
//してうまく利用し下さい。
//-flagを

#define BRK_GLS_DEBUG  0x00001  //デバッグ用のターゲットが出ます。
#define BRK_GLS_HAZARD 0x00002  //プレーヤーが手を出さなくなります

//-thickは、ガラスの厚みを設定できます。しなければ10mmです。

mesg プットガラスオブジェ $s:名前 割れる[0]
mesg プットガラスオブジェ $s:名前 もう壊れている[1]



chara プット大ガラスオブジェ[NewPutBigGlassObject] $s:名前 \
        -m $s:モデル名 $s:破片モデル名  $s:壊れモデル名 \
        -r $v:向き \
        -p $v:場所 \
        -l $s:光源 \
        -c $p:壊れプロック \
	-Broken $f:壊れフラグ \
        -s $v:スケール
//-broken を１にすると壊れた状態から始まります。プロックとフラグを併用
//してうまく利用し下さい。
mesg プット大ガラスオブジェ $s:名前 割れる[0]
mesg プット大ガラスオブジェ $s:名前 もう壊れている[1]


chara プットアイスボックスオブジェ[NewPutIceboxObject] $s:名前 \
        -model  $s:ボックスモデル $s:壊れボックスモデル $s:氷モデル \
        -rot    $v:向き \
        -pos    $v:場所 \
        -hazard $i:ハザードＩＤ ... \
        -flag   $i:フラグ \
	-proC   $p:壊れぷロック \
	-Broken $f:壊れフラグ \
        -number $i:氷の数
//-broken を１にすると壊れた状態から始まります。プロックとフラグを併用
//してうまく利用し下さい。
mesg プットアイスボックスオブジェ $s:名前 もう壊れている[1]

chara プット瓶オブジェ[NewPutBottleObject] $s:名前 \
        -m $s:モデル名 ... \
        -b $s:壊れモデル名 ... \
        -r $v:向き \
        -p $v:場所 ... \
        -l $s:光源 \
        -h $i:ハザードＩＤ \
        -s $i:当たり情報 ... \
	-proC   $p:壊れぷロック ... \
	-Broken $f:半分壊れフラグ $f:壊れフラグ \
	-n $i:瓶の数
//-broken を１にすると壊れた状態から始まります。プロックとフラグを併用
//してうまく利用し下さい。
// 当たり情報は、以下の規則を守ること
//	-s ハザードの数 ハザードの種類 各ハザードの引数 ... ハザードの種類 各ハザードの引数 ...
// ハザードの数 ： ハザード情報に必要なメモリ数（すべてのハザードに必要なメモリ数）
// ハザードの種類 ：
//	 [0] 円盤当たり   [メモリ] 1 [引数] 半径 位置X 位置Y 位置Z
//	 [1] 長方形当たり [メモリ] 2 [引数] 最小位置X 最小位置Y 最小位置Z 最大位置X 最大位置Y 最大位置Z
//	 [2] 筒形当たり   [メモリ] 2 [引数] 最小位置X 最小位置Y 最小位置Z 最大位置X 最大位置Y 最大位置Z
// つまり以下のような記述になる
//	-s 3,  0 200,19000,1000,-13000  1 19000,0,-13000, 20000,1000,-12000,
// 円盤当たりを半径20cmの（19000,1000,-13000）に位置させ、
// 直方体あたりを (19000,0,-13000) と ( 20000,1000,-12000) の対角にしたものを置く という意味になる
#define BOTTLE_HZD_DISK   0
#define BOTTLE_HZD_BOX    1
#define BOTTLE_HZD_TUNNEL 2
#define BOTTLE_HZD_DEBUG  255
#define BOTTLE_TUNNEL_XAXIS 0
#define BOTTLE_TUNNEL_YAXIS 1
#define BOTTLE_TUNNEL_ZAXIS 2

#define WINE_BOTTLE1 0
#define WINE_BOTTLE2 1
#define WINE_BOTTLE3 2
#define WINE_BOTTLE4 3
#define WINE_BOTTLE5 4
#define WINE_BOTTLE6 5
#define WINE_BOTTLE7 6
#define WATER_GLASS1 7
#define WINE_GLASS1  8

//半分が壊れオブジェになっている
mesg プット瓶オブジェ $s:名前 もう半分壊れている[1]
//全てが壊れオブジェになっている
mesg プット瓶オブジェ $s:名前 もう壊れている[2]


//現在未使用
chara プットロッカーオブジェ[NewPutLockerObject] $s:名前 \
        -m $s:モデル名 \
        -r $v:向き \
        -p $v:場所 \
        -l $s:光源 \
        -s $v:スケール

chara プットポテトオブジェ[NewPutPotatoObject] $s:名前 \
        -m $s:モデル名 $s:壊れモデル名 \
        -l $s:光源 \
        -n $i:ポテトの数 \
        -b $s:箱モデル名 \
        -r $i:箱の向き（Ｙ軸回転） $i:向き最大値 $i:向き最小値 \
        -s $v:箱のサイズ \
        -p $v:箱の位置 \
	-h $i:登録できる足の数 \
	-type   $i:中身の種類 \ /* じゃがいも:0 りんご:1 */
	-hazarD $i:ハザードＩＤ \
	-proC   $p:壊れぷロック \
	-Broken $f:壊れフラグ \
	-f $i:フラグ
#define POTATO_FALL_BOTHSIDE  0x00000001
//デフォルトは、片方にしか倒れない
//向きは、4096を360°として計算して下さい。
//-broken を１にすると壊れた状態から始まります。プロックとフラグを併用
//してうまく利用し下さい。
mesg プットポテトオブジェ $s:名前 foot[0] $i:オブジェクトへのポインタ（０ならプレーヤの足）
mesg プットポテトオブジェ $s:名前 もう壊れている[1]


chara プット揺れオブジェ[NewPutRadleObject] $s:名前 \
        -flag  $i:フラグ \	
        -model $s:モデル名 \ //ここから複数指定（必ず最初）
        -scale $v:スケール \
	-sounD $i:サウンドＩＤ \
        -rot   $v:向き     \
        -pos   $v:場所     \ //ここまで複数指定（必ず最後）
	-end
//ぶら下がって当てたら揺れるもの
//複数指定の場合は -modelから -end までを指定して下さい。


chara プット落下オブジェ[NewPutSwingObject] $s:名前 \
        -flag  $i:フラグ \
        -model $s:モデル名 \
        -rot   $v:向き \
	-proC  $p:プロック \ /* 落ちる瞬間(メッセージor弾など)に呼ばれます */
        -pos   $v:場所
//ぶら下がって当てたら揺れ、ある程度(銃３発 爆発1発)当てていると落下してしまう
mesg プット落下オブジェ $s:名前 落下[0]      //落下が開始します
mesg プット落下オブジェ $s:名前 揺らす[1]    //ゆれが開始します（落下はしません）


chara プット筒物転がりオブジェ[NewPutRollObject] $s:名前 \
	-number $i:個数 \
	-hazard $i:ハザードＩＤ \
	-proC   $p:壊れぷロック \
	-Broken $f:壊れフラグ \
        -model  $s:モデル名 \
        -rol    $v:向き \
        -pos    $v:場所 \
	-limit  $v:安定角度
//[機能] 筒状の倒れたら転がるもの
//
//  複数指定の場合は modelからlimitまでをnumberの指定した回数だけ繰り返す。
//  その際modelを必ず最初にlimitを最後にすること
//
//  -numberと-hazardは一つでいいです。
//
//  安定角度は 3つ 指定可能。意味ない角度は-1にしてください。
mesg  プット筒物転がりオブジェ $s:名前 もう壊れている[1]

chara プット皿オブジェ[NewPutPlateObject] $s:名前 \
        -model  $s:重ねモデル $s:一枚モデル $s:壊れモデル ... \
	-hazard $i:ハザードＩＤ \
	-number $i:皿の数 \
        -param  $i:重ね数 $v:向き $v:位置 ... \
	-light  $s:光源 \
	-proC   $p:壊れぷロック \
	-Broken $f:壊れフラグ \
	-flag   $i:フラグ
//現在、フラグは未使用
//-broken を１にすると壊れた状態から始まります。プロックとフラグを併用
//してうまく利用し下さい。
mesg  プット皿オブジェ $s:名前 もう壊れている[1]

chara プット紙オブジェ[NewPutPaperObject] $s:名前 \
        -model  $s:重ねモデル $s:一枚モデル $s:壊れモデル ... \
	-hazard $i:ハザードＩＤ \
	-number $i:紙の数 \
        -param  $v:場所 ... \
	-light  $s:光源 \
	-proC   $p:壊れぷロック \
	-Broken $f:壊れフラグ \
	-flag   $i:フラグ
//-param は、位置（X、Y、Z） 回転（X、Y、Z）を一組として -numberの数だ
//け指定すること。
//-broken を１にすると壊れた状態から始まります。プロックとフラグを併用
//してうまく利用し下さい。
//現在、フラグは未使用。

mesg  プット紙オブジェ $s:名前 もう壊れている[1]



chara プット揺れライト[NewPutHangLight] $s:名前 \
        -model $s:モデル \
        -pos   $v:位置 \
        -rot   $v:向き \
	-light $s:光源 \
	-flag  $i:フラグ
//現在、フラグは未使用
mesg プット揺れライト $s:名前 ライト管理[0] $i:フラグ（天井君の返り値）



//現在未使用
chara プット飛沫オブジェ[NewPutSplashObject] $s:名前 \
	-m $s:オブジェクト名 \
	-r $v:向き \
	-p $v:場所 \
	-s $v:スケール


chara プット頂点アニメオブジェ[NewPutVanimeObject] $s:名前 \
        -m $s:モデル名 \
        -b $i:ベースフレーム数 \
        -w $i:ランダムビット幅 \
        -r $v:向き \
        -p $v:場所 \
        -l $s:光源
//表示用のKMSとCV2は同じ名前になっている
//各モデル毎の頂点アニメフレーム数は、（ベースフレーム数）＋（乱数）＆（1<<（ビット幅）―１）
//となる
// 光源を指定しないことでシェードモードになります（ほとんどの場合がこっちになるはず）。

mesg プット頂点アニメオブジェ $s:名前 非表示[0] /*モデルを消す*/
mesg プット頂点アニメオブジェ $s:名前 表示[1]   /*モデルを表示する*/


chara プットストリーム頂点アニメオブジェ[NewPutSTanimeObject] $s:名前 \
        -m $s:モデル名 \
	-a $s:アニメデータ ... \
        -t $i:再生速度 \
        -b $v:バウンダリ最大 $v:バウンダリ最小 \
        -s $v:スケール \
        -r $v:向き \
        -p $v:場所
//バウンダリは、モデルを正しく表示させるために、前もって動く量を計算しその範囲を与える必要がある
//表示用のKMSとCV2は同じ名前になっている
//再生速度は、２５６を１フレームとし １フレームおきに再生するには、１２８を入れる。
//デフォルトは１２８。０および２５６以上の数は厳禁！！！


chara ターゲットプロック[NewTargetProc] $s:名前 \
	-target     $v:ターゲット位置上端 $v:ターゲット位置下端 \
	-flag       $i:デバッグフラグ \
        -proc       $p:プロック
// 爆発系の弾が当たった時にプロックが呼ばれます。
// ターゲットの指定は上端と下端で、対角線上に位置した点をそれぞれ指定
//して下さい。
// -target を複数個置くことで、複数のターゲットを指定することができま
//す。
// -flag を１にするとターゲットにワイヤーフレームが出ます。


chara プットスポットライトオブジェ[NewPutSpotLightObject] $s:名前 \
        -m $s:モデル名 $s:壊れモデル名 ... \
        -n $s:スポットライトキャラ名 \
	-t $v:ターゲット位置  $i:大きさ ... \
	-s $v:ターゲットサイズ \  /* 指定した場合のみこのサイズが反映 */
        -r $v:向き \
	-l $s:光源 \
        -f $i:フラグ \
        -b $p:壊れプロック \
        -p $v:場所

//-m モデルは、壊れモデルの後に消す用のモデルを追加可能である。そのモ
//デルがない場合、「ライト点灯」「ライト消灯」のメッセージは、利用不可
//能となります。
//大きさの後に影響範囲を付けることが出来る。単位はmm
//以下のフラグを付けることで付加機能を付けられる。
#define BRK_LGT_SHOWTRGT   0x00000001 //ターゲットにフレームを付ける(デバッグ用)
#define BRK_LGT_PUTW00B    0x00000002 //w00b,w00c用のボンボリを付ける
#define BRK_LGT_PUTW03A    0x00000004 //w03a用のボンボリを付ける
#define BRK_LGT_VOLSHADOW  0x00000100 //ボリューミックシャドウに反応する
#define BRK_LGT_NOEFFECT   0x00000200 //壊れた時にエフェクトを出さない
#define BRK_LGT_OBJ_TARGET 0x00000400 //モデルのターゲットを
#define BRK_LGT_OBJ_OFFSET 0x00000800 //原点置きモデルである
#define BRK_LGT_OBJ_FITALL 0x00001000 //モデルの中心にすべてをずらす(つまり、ちゃんとするということ)
//-t オプションでターゲットの位置や大きさを決めることが出来る。爆発用
//のターゲットも指定が可能
// -t 位置(ベクトル)
//    銃用のターゲットの大きさ(一辺の長さ)
//    lt2のライトを消す半径
//    爆発用のターゲットの大きさ(一辺の長さ)指定しなければ爆発で壊れない
//-s オプションを指定するとターゲット大きさがXYZで指定できる（上より優先）
mesg プットスポットライトオブジェ $s:名前 ライト消す[0]     //壊れ後モデルで、光源ごと消す(つまり破壊)
mesg プットスポットライトオブジェ $s:名前 ライト点ける[1]   //壊れ前モデルで、光源をつける(つまり修理)
mesg プットスポットライトオブジェ $s:名前 ライト点灯[5]     //光源のみ消す（消しモデルに変更される）
mesg プットスポットライトオブジェ $s:名前 ライト消灯[6]     //光源のみつける（点灯モデルに変更される）
mesg プットスポットライトオブジェ $s:名前 オブジェ不可視[2] //モデルを非表示
mesg プットスポットライトオブジェ $s:名前 オブジェ可視[3]   //モデルを表示
mesg プットスポットライトオブジェ $s:名前 ライト管理[4] $i:フラグ（天井君の返り値）

command プットスポットライトオブジェライト管理[NewCom_BRK_SPLGT_LightMessage] \
	-n $s:名前 \
	-f $i:フラグ（天井君の返り値）
command プットスポットライトオブジェライト消す[NewCom_BRK_SPLGT_BreakMessage] \
	-n $s:名前



chara 頂点アニメブラー[NewVanimeBuller] $s:名前 \
        -model     $s:モデル名 \
        -base      $i:ベースフレーム数 \
        -width     $i:ランダムビット幅 \
        -speed     $i:移動スピード \
        -rot_speed $i:回転スピード \
        -direction $v:向き \
	-flag      $i:フラグ \
        -pos       $v:場所
//flagの解説
// 奇数番号は、黄色のステルスになります。
// 0 : 一回分だけ最後までアニメーションし、消えます。
// 1 : デバッグモード
// 2 : 繰返し１（最後のフレームから最初のフレームに行きなり飛びます）
// 4 : 繰返し２（最後のフレームから最初のフレームに滑らかにアニメーションします）
//表示用のKMSとCV2は同じ名前になっている
//各モデル毎の頂点アニメフレーム数は、（ベースフレーム数）＋（乱数）＆（1<<（ビット幅）―１）
//となる


chara デモ弾丸[NewDemoBullet] $s:名前 \
        -model     $s:モデル名 \
        -speed     $i:移動スピード \
        -rot_speed $i:回転スピード \
        -direction $v:向き \
        -pos       $v:場所 \
        -flag      $i:表示フラグ
//表示用のKMSとCV2は同じ名前になっている
//各モデル毎の頂点アニメフレーム数は、（ベースフレーム数）＋（乱数）＆（1<<（ビット幅）―１）
//となる
//表示フラグ 0非表示／1表示




//オルガ戦 専用キャラ
//
chara ボスオルガ[NewOrga] $s:名前 \
        -m $s:モデル名 \
        -a $s:モーション名 \
        -p $v:出現位置 \
        -d $v:出現方向 \
        -s $b:出現時姿勢 \
        -h $p:カメラプロック ... \
        -c $i:スネーク銃 $i:スネーク手榴弾 $i:オルガへのダメージ ... \
        -v $t:ストリーム音声 ... \
        -f $i:各種フラグ
//-h は、カメラ切替え用のプロックです。
// ホロ撃ち（必須）  ホロを飛ばすために隠れて撃つ時
// 死に（必須）      オルガを倒した
// グレネードなげ    グレネードをスネークに向かって投げる時
// めくら撃ち 乱射   物陰からスネークを見ずに乱射する時
// アンチエルード    スネークがエルードした時に撃つ
// とんぼ返り        側転から狙われたときに出る発動する
// 側転              ダメージを多く受けた時に側転をして移動し始める
// ダメージ          ダメージを受けた時
// 覗き込み          警戒している覗き込みをしたとき（移動の前後に発動する可能性あり）
// スライディング    スライディングをするとき（移動する際、近くを狙われると発動する可能性あり）
// マシンガンな奴    ステップ前に入ってきたときに撃ちまくる
// 挑発              止まっている時間が長く,低い隠れ場所にいるときする
// ホロ舞う          ホロが飛び去る何れかのときに必ず呼ばれる
// ライフ１／２      ライフが１／２になったときのみに呼ばれる
// ライフ１／４      ライフが１／４になったときのみに呼ばれる
// ライフ１／８      ライフが１／８になったときのみに呼ばれる
// ライフ３／４      ライフが３／４になったときのみに呼ばれる
// スネークすき間    スネークがすき間から撃っているとき（移動してから）
// 人生語り最初始め      オルガが人生を語る（１番めのセリフ）
// 人生語り最初終り      オルガが人生を語る（１番めのセリフ）
// 人生語り最後始め      オルガが人生を語る（４番めのセリフ）
// 人生語り最後終り      オルガが人生を語る（４番めのセリフ）

//-c は、ダメージ調整用パラメータです。
// スネーク銃：    オルガがUSPでスネークを撃った時のスネークのダメージ量（５）
// スネーク手榴弾：オルガのグレネードがスネークに当たった時のスネークのダメージ量（１０）
// スネーク手榴弾：オルガのグレネードがスネークに当たった時のスネークのダメージ半径
// スネーク手榴弾：オルガのグレネードがスネークに当たった時のスネークのふっ飛び半径
// オルガへのダメージ：以下の順序で登録される
//    頭  ：デフォルト ３２
//    心臓：デフォルト ３２
//    右腕：デフォルト ８
//    右肩：デフォルト ８
//    左腕：デフォルト ８
//    左肩：デフォルト ８
//    右腿：デフォルト ８
//    右脛：デフォルト ８
//    左腿：デフォルト ８
//    左脛：デフォルト ８
//    腹  ：デフォルト １０

//各種フラグに該当するもの
#define ORGA_NOBODYSPLASH 0x00001
#define ORGA_NOFOOTSHADOW 0x00002
#define ORGA_NOBODYSHADOW 0x00004
#define ORGA_BODYSPECULAR 0x00008
#define ORGA_HAIRMOVE     0x00010

mesg ボスオルガ $s:名前 snake_hide[1] $i:隠れ場所ＩＤ
mesg ボスオルガ $s:名前 snake_unhide[0]
mesg ボスオルガ $s:名前 スネーク階段入る[3]
mesg ボスオルガ $s:名前 スネーク階段出る[4]

mesg ボスオルガ $s:名前 デバッグアクション[255] $i:アクション番号
//アクション番号1  0to1 回転移動     ORG_ActionRolloutRun
//アクション番号2  0to1 しゃがみ走り ORG_ActionCrowRun
//アクション番号3  1to0 しゃがみ走り ORG_ActionCrowRun
//アクション番号4  0to1 飛び込み前転 ORG_ActionTumbleRun
//アクション番号5  1to0 飛び込み前転 ORG_ActionTumbleRun
//アクション番号6  0to1 飛び込み前転 ORG_ActionTumbleDash
//アクション番号7  1to0 飛び込み前転 ORG_ActionTumbleDash
//アクション番号8  0to1 走り激撃ち   ORG_ActionAimmingDashWithRage
//アクション番号9  0to1 走り撃ち     ORG_ActionAimmingDash
//アクション番号10 1to0 走り激撃ち   ORG_ActionAimmingDashWithRage
//アクション番号11 1to0 走り撃ち     ORG_ActionAimmingDash
//アクション番号12 0to1 スライヂング ORG_ActionRunSliding
//アクション番号13 1to0 スライヂング ORG_ActionRunSliding
//アクション番号14 0to1 側転移動     ORG_ActionRolling
//アクション番号15 1to0 側転移動     ORG_ActionRolling

mesg ボスオルガ $s:名前 マルチウェイト表示[6]
mesg ボスオルガ $s:名前 シングルウェイト表示[7]
//呼ばれた瞬間にシングル／マルチの表示に切り替わります

mesg ボスオルガ $s:名前 オルガ静止[8] $i:姿勢 $i:方向
//姿勢は、立ち（０）しゃがみ（１）ビハインド立ち（２）ビハインドしゃがみ（３）の何れかです。
//方向は。３６０°を４０９６で
mesg ボスオルガ $s:名前 オルガ静止解除[9]
//「オルガ静止」と同フレームに呼び出しても解除しないので注意して下さい。
mesg ボスオルガ $s:名前 オルガ強制移動[10] $i:Ｘ座標変数 $i:Ｙ座標変数 $i:Ｚ座標変数
//強制的に指定先に走って移動します
mesg ボスオルガ $s:名前 オルガ瞬間移動[11] $i:Ｘ座標変数 $i:Ｙ座標変数 $i:Ｚ座標変数 $i:方向
//その瞬間に指定先に移動します
mesg ボスオルガ $s:名前 回避無効[12]
//オルガがリセットおよび回避をしなくなる
mesg ボスオルガ $s:名前 回避有効[13]
//オルガがリセットおよび回避が出来るようになる
mesg ボスオルガ $s:名前 全機能停止[14] $i:停止フレーム数
//指定したフレーム数だけ全機能を停止する（モーションの再生も）
//256フレーム以上は禁止
mesg ボスオルガ $s:名前 デモスキップ可能[15]
//カットインデモをスキップできるようになる
mesg ボスオルガ $s:名前 デモ開始[16]
//カットインデモの重複を避けるため デモ開始プロックにはこのメッセージを入れること
mesg ボスオルガ $s:名前 デモ終了[17]
//カットインデモの重複を避ける デモ終了プロックにはこのメッセージを入れること

command ゲットオルガ座標[NewGetOrgaPos] $r:Ｘ座標変数 $r:Ｙ座標変数 $r:Ｚ座標変数
command ゲットオルガ目的地[NewGetOrgaSrcDst] $r:目的地 $r:現在地
command ゲットオルガフラグ[NewGetOrgaFlag] $r:フラグ
command ゲットオルガライフ[NewGetOrgaLife] $r:ライフ
command ゲットオルガ行動フラグ[NewGetOrgaActFlag] $r:フラグ
command ゲットホロ状況[NewGetHoloStatus] $r:ステータス

