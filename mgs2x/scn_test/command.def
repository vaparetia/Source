chara 浮遊物[NewDust] $s:名前 \
	-group $b:グループ番号 \
	-trap $s:トラップ名 \
	-m $s:モデル名 \
	-y $b:モデルモード
mesg 浮遊物 $s:name 表示[0]
mesg 浮遊物 $s:name 非表示[1]

#define PET_MODE_NORMAL	0
#define PET_MODE_BIG	1
#define PET_MODE_SMALL	2

//-----モデル名対応表------//
//wtd_petbottle_mt  --> ペットボトル大
//wtd_smallpet_mt   --> ペットボトル小
//wtd_papercup      --> プラスチックコップ
//wtd_vul_figure    --> バルカン人形
//-----モデルモード対応表------//
//0 : バルカン人形、紙コップ等、中身が出てこないタイプのもの
//1 : ペットボトル大
//2 : ペットボトル小
//現在、モデルの場所はトラップのcenterに置かれ、角度はランダムで選択されるようになっている

chara あきかん[NewKan] $s:名前 \
	-p $v:出現位置 \
	-c $i:浮かびモード \   // 0 ->浮き , 1 -> 沈み
	-d $i:沈んでいるとき範囲 \
	-w $i:滝の存在フラグ \ // 0 -> OFF , 1 -> ON (書かなければ 0 )
	-m $s:モデル名
mesg あきかん $s:name 表示[0]
mesg あきかん $s:name 非表示[1]
//-----浮かびモード内容-----
// 0 : 水に浮かんでいる
// 1 : 水に沈んでいる
//また、出現位置の Y 座標は無視される。

chara くもるガラス設定[NewGlassMistMain] $s:名前 \
	-p $v:中心座標 \
	-w $i:幅 \
	-h $i:高さ \
	-x $v:法線ベクトル
//曇る側のガラス、カガミのパラメータを入れる
//ガラスの場合のような両面が曇る場合もどちらか片方の法線をいれてください

