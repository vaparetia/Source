command ファイル交換処理[PL_COM_ExchangeCache] \
	-e $s:ファイル１ $s:ファイル２ \		//evm
	-k $s:ファイル１ $s:ファイル２ 			//kms
// キャッシュのすげかえをする

chara カツラテクスチャ差し替え管理[NewWigTexReplaceActorScn] $s:名前 \
	-item $i:アイテム番号

chara 髭剃りスネークテクスチャ入れ替え[NewShavedSnakeTexReplaceActorScn] $s:名前

command シナリオ前武器変更[PL_COM_ChangePrevWeaponScn] \
	-number $i:武器番号

command シナリオ前装備変更[PL_COM_ChangePrevItemScn] \
	-number $i:アイテム番号

//次にシナリオで武器、アイテムが変更されたときに、有効になります。

command	ブレード振りチェック[PL_COM_BladeSlashCheck]
//振り中なら１を返す

command ブレード壁チェックなし[PL_COM_BladeNoCheckSegment]
command ブレード壁チェックあり[PL_COM_BladeNoCheckSegmentCancel]

command ブレードエフェクトオン[PL_COM_BladeEffectOn]
command ブレードエフェクトオフ[PL_COM_BladeEffectOff]

command 装備ダンボール破壊[PL_COM_DestroyBox]

command サイト表示制御[PL_COM_SightOnOff] \
	-switch $s:on／off

command 弾水飛沫処理[PL_COM_BulletSplashDaemon]

command	プレイヤー床高さ取得[PL_COM_FloorHeight] \
	-current
//-current が指定されていると、現在に床高さ
//指定されてないと、最後に立っていた床高さ

//武器アイテム全とられ
command	武器アイテム取られ[GM_COM_SnatchEquip]
command 武器アイテム取り返し[GM_COM_RegainEquip]

//ゴルキャップあり／なし設定
command	ゴルキャップあり[PL_COM_GolCapOn]
command	ゴルキャップなし[PL_COM_GolCapOff]

//ミサイル不発処理
command ミサイル不発処理機構オン[PL_COM_FallBulletSystemOn]

//ダミープレイヤー
chara	ダミープレイヤー[NewDummyPlayer] $s:名前 \
	-m $s:モデル名（２１関節を指定すること） \
	-p $v:位置

//シナリオゲームオーバー
command ゲームオーバー処理開始[GM_GameOverStartScn] \
		-exec { ゲームオーバー処理 } \
		-proc $p:ゲームオーバー処理 \
		-load

//-exec と -proc はどちらか一つ
//-load があると、ゲームオーバーだがロードが出来る
//（ゲームオーバーポリデモロード用）

command ゲームオーバー処理終了[GM_GameOverEndScn]

//Ｏ２ゲージ
chara	Ｏ２ゲージ[NewO2Gage] $s:名前 \
	-max $i:最大値 \
	-start_value $i:開始時値（省略するとＭＡＸ） \
	-length $i:ゲージ長さ（指定なしのときはＯ２最大／１５）

command Ｏ２ゲージ表示[PL_COM_VisibleO2Gage]
command Ｏ２ゲージ非表示[PL_COM_InvisibleO2Gage]
command Ｏ２ゲージ回復力設定[PL_COM_SetRecoverValue] $i:回復力

//ニキータタイマー設定
command ニキータタイマー設定[NewSetNikitaTimer] -time $i:時間

command ミサイル移動範囲設定[PL_COM_SetMissileBounding] \
	$i:Ｘ最小 $i:Ｙ最小 $i:Ｚ最小 $i:Ｘ最大 $i:Ｙ最大 $i:Ｚ最大

//プレイヤーパッド振動 指定モーション開始時に振動起動
chara プレイヤー振動[NewSetPlayerVibration] $s:名前 \
	-marfile $s:モーションファイル名（ｍａｒ） \
	-order $i:モーションファイル内での順番 \
	-vib_file $s:振動ファイル名（ｖｉｂ）

//影投影ハザード
command	影投影ハザード[NewShadowDropHazard] \
	-name $s:マップ名 \
	-group $b:グループ番号

//スポットライト投影ハザード
command スポットライト投影ハザード[NewSpotDropHazard] \
	-name $s:マップ名 \
	-group $b:グループ番号

//マップ名を省略すると、現在のマップが使用される


//ＵＳＰを構えたら自動でライトＯＮ
command ＵＳＰライトＯＮ[NewUSPLightOn]

//ハンドガン主観射程設定
command 主観射程距離設定[NewSetSubjectShotLen] -len $i:距離

//ゲーム中のキャラをマルチウェイトモデルにする。
chara マルチウェイトキャラ[NewMultiweightChara] $s:名前 \
		-name $s:マルチウェイトモデルとすげ替えるキャラ \
		-model $s:マルチウェイトモデル名

//ＬＯＤ制御
chara ＬＯＤ制御[NewLoDControl] $s:名前 \
		-name $s:ＬＯＤ制御するキャラ \
		-type $b:ＬＯＤタイプ \
		-model $s:モデル ... \ // HIGH <-----> LOW （４つまで）
		-value $i:ＬＯＤ制御値 ... \
		-vAlue2 $i:ＬＯＤ制御値２ ...

//ＬＯＤタイプ
//	0 : プレイヤー状態に依存（状態は、トラップの項のenumと同じ）
//  1 : カメラからの距離に依存
//	2 : 0 + 1	: -value で、プレイヤー状態をチェック
//				: -vAlue2で、距離をチェック

//白い息
chara 白息[NewCharaBreath] $s:名前 \
	-name $s:息を出すキャラ名 \
	-object $b:息を出す関節番号 \
	-shift $v:上の関節中心から息出し位置へのシフト量 \
	-interval $w:息間隔
mesg 白息 $s:名前 on[ 0 ]
mesg 白息 $s:名前 off[ 1 ]

//跳弾・弾痕登録
//壁・床の音番号に対応した跳弾・弾痕エフェクトの登録

//ノーマル：担当はおかじ
command 跳弾ノーマル[NewEntryNewSpark] -n $b:登録番号
command 跳弾ＳＥのみ[NewEntrySparkOnlySE] -n $b:登録番号

//パイプ水蒸気：担当はおかじ
command	跳弾水蒸気小[NewEntrySteamAttackTargetSmall] -n $b:登録番号
command	跳弾水蒸気中[NewEntrySteamAttackTargetMiddle] -n $b:登録番号
command	跳弾水蒸気大[NewEntrySteamAttackTargetLarge] -n $b:登録番号
//弾痕ノーマル：担当は森田さん
command 弾痕ノーマル[NewEntryWallScar] -n $b:登録番号
command 弾痕じゃじゃじゃ[NewEntryWallJajaja] -n $b:登録番号

//カメラにチェック面（四角形）を設定
//チェック面は最大１６まで
command カメラチェック面ワーク確保[NewMallocCameraSquareWork]
command カメラチェック面登録[NewSetCheckSquareOfCamera] \
	-points $v:頂点１ $v:頂点２ $v:頂点３ $v:頂点４ \	//時計周りに設定
	-far $i:画面を占める率 \
	-pRoc $p:撮影時プロック \
	-x_range $i:許容Ｘ角度範囲（デフォルト640） \
	-y_range $i:許容Ｙ角度範囲（デフォルト320）

//-far 画面を占める率 とは？
//画面を占める率（％）がこの数字以下だった場合、
//「遠すぎる」と判断される。

//プロックの引数（＄１）
//0 : ＮＧ ／ 4点のうち画面外の点があり、
//		      判定面の中心が画面の中心から３０％以上離れている。
//1 : ＮＧ ／ 「近すぎる」画面外の点があるが、
//		      判定面の中心が画面の中心から３０％以内である。
//				もしくは、画面全部が、チェック面内である。
//2 : ＮＧ ／ 4点は全て画面内だが、当たりがあって見えない点がある。
//
//3 : ＮＧ ／ 「遠すぎる」全て画面内だが、
//				-farで指定した範囲より表示範囲が小さい。
//4 : ＯＫ

//カメラにキャラが映っているか判定
//チェックキャラは最大８まで。
//キャラの起動より後に記述すること
command カメラチェックキャラワーク確保[NewMallocCameraCharaWork]
command カメラチェックキャラ登録[NewSetCheckCharaOfCamera] \
	-name $s:チェックするキャラの名前 \
	-joint $b:チェックする関節番号 \
	-far $i:画面を占める率 \
	-proc $p:撮影時プロック

//プロックの引数（＄１）
//0 : ＮＧ
//1 : ＯＫ

command カメラチェックキャラ削除[NewDeleteCheckCharaOfCamera] \
	-name $s:削除するキャラの名前

command カメラ撮影時プロック[NewSetCameraProc] \
	-proc $p:カメラ撮影時プロック

//隠し君
chara 隠し君[NewHideMan] $s:名前

//実験君
chara 木偶人形[NewDekuDoll] $s:名前

//実験カメラ
chara キャラカメラ[NewCharaTraceCamera] $s:名前 \
	-c $s:追従キャラ名 \
	-s $v:シフト量 \
	-r $v:回転角度

//Ｃ４爆発メッセージ
mesg Ｃ４ $s:名前 bomb[0]

//プロックの連続実行
chara プロック連続実行[NewExecProcContinual] $s:名前 \
	-proc $p:プロック \
	-exec { 実行ブロック } \
	-time $i:連続実行フレーム数（マイナス値を指定するといつまでも）\
	-end_pRoc $p:終了プロック \
	-end_eXec { 実行ブロック }

//proc, exec はどちらか一つ
//$1として、残り回数が渡される
//end_proc, end_exec もどちらかひとつ
//引数はありません

mesg プロック連続実行 $s:名前 kill[0]

chara 解体Ｃ４[NewSetKaitaiC4] $s:名前 \
	-position $v:位置 \
	-rotate $v:回転 \
	-type $b:タイプ（０／１：臭いあり／なし） \
	-state $b:初期状態（０／１：通常／凍結） \
	-enemy $s:つける敵の名前 $i:関節番号 \
	-model $s:モデル名（指定がなければデフォルト） \
	-ice_model $s:凍結エフェクト用モデル（指定がなければデフォルト） \
	-siZe $v:大きさ（指定がなければデフォルト） \
	-lamp_shift $v:ランプの位置（指定がなければデフォルト） \
	-prOc $p:プロック \
	-big  $i:大きさ /* 10 = 1.0 */

//プロックの$1には、$s:名前が入る
//プロックが呼ばれるのは状態に変化があったとき＆ステージ終了時
//プロックの$2には、爆発時($2==0)、凍結時($2==1)、通常時($2==2)が入る
//-enemyを使うとき、-positionには、その敵の腰からの相対ベクトルを入れる。

//スプレーが効く、効かないの設定
mesg 解体Ｃ４ $s:名前 spray_check[0] $i:１：効く／０：効かない

//解体Ｃ４爆破
mesg 解体Ｃ４ $s:名前 blast[1]		//指定解体Ｃ４を爆破

chara 設置クレイモア[NewScenarioClaymore] $s:名前 \
	-position $v:位置 \
	-rotate $v:回転 \
	-flag $i:フラグ \
	-prOc $p:終了プロック

//終了プロックは $1 に、
//	0 : 爆破せずにステージ終了（ロード、リスタート）
//	1 : 爆発した。
//  2 : 回収された。
//が入る。

//フラグは
//	0x0001 : デバッグターゲット表示

//ジャンプ時重力セット
command ジャンプ時重力セット[PL_COM_SetJumpGravity] \
	-gravity $i:重力

//ライデン跳びの重力をセットします。
//処理的には、ライデンに、（デフォルト＋$i:重力）の高さ移動量が
//設定されるようになります。
//フレーム毎に０リセットされるので、毎フレーム設定する必要があります。
//より遠くまで飛べるようにしたいときには正の値を、
//飛ばしたくないときには負の値をセットしてください。

//潜水ゴーグル
chara 潜水ゴーグル[NewDivingGoggles] $s:名前 \
	-model $s:モデル名

mesg 潜水ゴーグル $s:名前 on[0]
mesg 潜水ゴーグル $s:名前 off[1]

//主観時にゴーグル主観モデルを表示する
//デフォルトは on

//トラップの大きさにターゲット発生
chara ターゲットトラップ[NewTargetTrap] $s:名前 \
	-map $s:マップ名 \
	-trap $s:トラップ名 \
	-proc $p:ヒット時実行プロック

//procの引数
//	$1 : 攻撃の種類。現在は以下の通り
//		0 : プレイヤーのキック
//		1 : Ｍ９、ＰＳＧ１−Ｔ
//		2 : ＰＳＧ１
//		3 : ニキータ
//		4 : スティンガー

mesg ターゲットトラップ $s:名前 kill[0]

//テストエマ
command テストエマ初期位置[NewComEETestSetStartPos] \
	-position $v:位置 \
	-rotate $v:方向

//主観カメラ乗っ取り
command	主観カメラ乗っ取り[PL_COM_OverrideSubjectCamera] \
	-target $v:注視点 \
	-rotate $v:角度

//注視点と角度は、どちらか片方のみ有効
//毎フレーム指定

command	イントルード主観カメラ補正[PL_COM_IntrudeSubjectCameraPositionMove] \
	-len $i:補正距離（省略すると1000）\
	-se $i:補正時ＳＥ（金網でガン！となる等） \
	-inout $i:０オフ／１オン

//-inoutの引数には、カメラ設定のように、$3を使用できます。
//「入る」はオンで「出る」はオフになります。

//爆発系管理メッセージ

mesg 爆発系管理 $s:名前 消去[0] [$i:武器番号]
mesg 爆発系管理 $s:名前 非表示[1] [$i:武器番号]
mesg 爆発系管理 $s:名前 爆発禁止[2] [$i:武器番号]
mesg 爆発系管理 $s:名前 爆発[3] [$i:武器番号]
mesg 爆発系管理 $s:名前 操作不能[4] [$i:武器番号]

//爆発系武器の弾を管理
//$s:名前 には 必ず 爆発系管理 を指定してください。
//爆発系武器とは、グレネード、チャフ、スタン、ＲＧＢ、スティンガー、ニキータ
//				  Ｃ４、クレイモアは除く。（要望があればいれます）
//武器番号を設定しないと、すべての爆発系弾に処理が行われます。

//まだ、ニキータのみ対応。順次対応予定。

//トラップビハインドシステム

command	トラップビハインド登録[HZX_AddTrapBehind] \
	-trap_name $s:トラップ名 \
	-map $s:マップ名 \
	-camera $i:注視点Ｘ $i:注視点Ｙ $i:注視点Ｚ $i:位置Ｘ $i:位置Ｙ $i:位置Ｚ \ //通常
	-right $i:注視点Ｘ $i:注視点Ｙ $i:注視点Ｚ $i:位置Ｘ $i:位置Ｙ $i:位置Ｚ \	//右覗き
	-left $i:注視点Ｘ $i:注視点Ｙ $i:注視点Ｚ $i:位置Ｘ $i:位置Ｙ $i:位置Ｚ \	//左覗き
	-dir $i:方向 \
	-flag $f:フラグ（未対応）

command トラップビハインド削除[HZX_RemoveTrapBehind] \
	-trap_name $s:トラップ名

//トラップをビハインドトラップとして登録できる。
//１ステージに４つまで。
//-dirで方向指定ビハインドにできる。

command スプレー当たり判定拡大[PL_SprayCheckWide]
command スプレー当たり判定通常[PL_SprayCheckNormal]

//スプレーの当たり判定を変更します。
//「拡大」は一度呼んだら拡大しっぱなしです。
//「通常」に戻すのを忘れないようにしてください。
//リスタートで「通常」に戻ります。

//---------------------------------------------------------------------
//是角 /user/korekado

//interupt.c
command セットゾーンフラグ[GM_SetZoneFlagForScn] \
	$i:フラグ $i:Ｘ座標変数 $i:Ｙ座標変数 $i:Ｚ座標変数

command アンセットゾーンフラグ[GM_UnSetZoneFlagForScn] \
	$i:フラグ $i:Ｘ座標変数 $i:Ｙ座標変数 $i:Ｚ座標変数

#define HZX_ZONE_ZINTRPT	0x01	/* ゾーン通行止め */
#define HZX_ZONE_SAFE		0x02	/* プレイヤー逃げ場所 */

//control.c
command コントロール座標取得[GM_GetPosForGCL] \
	$s:名前 $r:Ｘ座標変数 $r:Ｙ座標変数 $r:Ｚ座標変数

command コントロール方向取得[GM_GetDirForGCL] \
	$s:名前 $r:方向

/* 倒れている状態を計算 １ならあお向け０ならうつぶせ*/
command 倒れ状態取得[GM_GetFallTypeForGCL] \
	$s:名前 $r:倒れ状態

//g_sound.c
command 再生ＢＧＭ取得[GM_GetSngCode]

/*音のモード*/
#enum {
	VOLPARAM_SEMODE_NORMAL,	/* 俯瞰時はカメラターゲット、主観時はカメラ位置を中心に計算 */
	VOLPARAM_GM_SEMODE_BOMB,		/* 遠くても必ず少しは聞こえる */
	VOLPARAM_GM_SEMODE_REAL,		/* 主観やビハインドになったときだけ聞こえる */
} ;
/*画面の種類*/
#enum {
	SE_VOLPARAM_NORMAL_VIEW,	/*通常画面*/
	SE_VOLPARAM_OWN_VIEW,		/*主観モード画面*/
	SE_VOLPARAM_DEMO_VIEW,		/*デモ画面*/
} ;

command セット音量パラメータ[GM_SetVolumeParam] \
	$i:モード \
	$i:画面種類 \
	$w:有効角度 \			/* 0〜360 */
	$i:内側計算最小距離 \
	$i:内側計算最大距離 \
	$i:内側最小距離時音量 \	/* 0〜63 */
	$i:内側中心距離時音量 \	/* 0〜63 */
	$i:内側最大距離時音量 \	/* 0〜63 */
	$w:減衰最大角 \			/* 0〜360 */
	$i:外側計算最小距離 \
	$i:外側計算最大距離 \
	$i:外側最小距離時音量 \	/* 0〜63 */
	$i:外側中心距離時音量 \	/* 0〜63 */
	$i:外側最大距離時音量 \	/* 0〜63 */
	$i:パン係数				/* 100標準 */


command セットマイクパラメータ[GM_SetMicParam] \
	$i:モード \
	$w:有効角度 \			/* 0〜4095 */
	$i:内側計算最小距離 \
	$i:内側計算最大距離 \
	$i:内側最小距離時音量 \	/* 0〜63 */
	$i:内側最大距離時音量 \	/* 0〜63 */
	$w:減衰最大角 \			/* 0〜4095 */
	$i:外側計算最小距離 \
	$i:外側計算最大距離 \
	$i:外側最小距離時音量 \	/* 0〜63 */
	$i:外側最大距離時音量 \	/* 0〜63 */
	$i:パン係数				/* 100標準 */

// SE_MODE_BOMB の デフォルト値
//	COS(10度)
//	4000
//  12000
