//enemem.c
command セット敵兵メモリー[ENEMEM_GclSet] \
	$s:ステージ \
	$s:マップＩＤ \
	$s:名前 \
	$i:場所Ｘ \
	$i:場所Ｙ \
	$i:場所Ｚ \
	$w:方向 \
	$w:ステータス \
	$w:ポーズ \
	$w:残りダウン時間 \
	$w:気絶値 \
	$w:ライフ \
	$w:部位ダメージ \
	$w:アイテム

//使用例
//	command セット敵兵メモリー w01a １Ｆ廻廊部 警備兵:01 6000 500 6000 0 \
//	 	d:ENEMEM_ST_SLEEP d:ENEMEM_PS_FRONT d:SLEEP_TIME_4 $w:敵標準気絶 $w:敵標準体力 0 0

command 敵兵メモリー更新[ENEMEM_GclRenewMemory] \
	$s:ステージ \
	$i:ステージ経過時間 \
	$i:ロード回数

command 敵兵メモリーリセット[ENEMEM_GclReset] \
	$s:ステージ \
	$s:名前

command 敵兵メモリーオールリセット[ENEMEM_GclAllReset]

command 敵兵メモリー読み取り[ENEMEM_GclGet] \
	$s:ステージ \
	$s:名前 \
	$r:マップID \
	$r:X座標 \
	$r:Y座標 \
	$r:Z座標 \
	$r:方向 \
	$r:ステータス \
	$r:ポーズ \
	$r:タイム \
	$r:気絶値 \
	$r:ライフ値 \
	$r:部位ダメージ \
	$r:アイテム
//対象者がいれば１をいなければ０を返す

command 敵兵メモリーコピー[ENEMEM_GclCopy] \
	$s:コピー元ステージ \
	$s:コピー元名前 \
	$s:コピー先ステージ \
	$s:コピー先名前 \
	$s:コピー先マップID \
	[$i:X座標 \
	$i:Y座標 \
	$i:Z座標]

//対象者がいれば１をいなければ０を返す
//座標はなければコピー元の位置

// ステータス
#enum {
	ENEMEM_ST_NORMAL,
	ENEMEM_ST_SLEEP,	/* 眠り */
	ENEMEM_ST_FAINT,	/* 気絶 */
	ENEMEM_ST_HELL,		/* 彼の世 */
	ENEMEM_ST_HOLDUP,	/* ホールドアップ */
};
// ポーズ
#enum {
	ENEMEM_PS_NORMAL,
	ENEMEM_PS_FRONT,	/* 仰向け */
	ENEMEM_PS_BACK,		/* うつ伏せ */
	ENEMEM_PS_WALL,		/* 壁もたれ */
	ENEMEM_PS_LOCKER,	/* ロッカー */
};

// 残りダウン時間
#ifdef d:PAL
#define FAINT_TIME_1		( (((60*30)*5/6)/3)-1 )	/* 星一つ */
#define FAINT_TIME_2		( (((60*30)*5/6)*2/3)-1 )	/* 星二つ */
#define FAINT_TIME_3		( (60*30)*5/6 )			/* 星三つ */

#define SLEEP_TIME_1		( ((60*60)*5/6)-1 )	/* Z１こ*/
#define SLEEP_TIME_2		( ((60*60*2)*5/6)-1 )	/* Z２こ*/
#define SLEEP_TIME_3		( ((60*60*3)*5/6)-1 )	/* Z３こ*/
#define SLEEP_TIME_4		( (60*60*4)*5/6 )	/* Z４こ*/
#else
#define FAINT_TIME_1		599		/* ( ((60*30)/3)-1 )	星一つ */
#define FAINT_TIME_2		1199	/* ((60*30)*2/3)-1 )	星二つ */
#define FAINT_TIME_3		1800 	/* (60*30) )			星三つ */

#define SLEEP_TIME_1		3599	/* ( (60*60)-1 )	Z１こ*/
#define SLEEP_TIME_2		7199	/* ( (60*60*2)-1 )	Z２こ*/
#define SLEEP_TIME_3		10799	/* ( (60*60*3)-1 )	Z３こ*/
#define SLEEP_TIME_4		14400	/* ( (60*60*4) )	Z４こ*/
#endif





chara コマンダー[NewCommander] $s:名前 \
	-w $p:警備コマンダーproc ... \
	-a $p:攻撃コマンダーproc ... \
	-r $v:復活場所 $s:マップＩＤ ...4 \
	-c $v:待機場所 $s:マップＩＤ ...4 \
	-p $w:クリアリングエリア $w:ルート $w:ポイント $p:プロック ...4 \
	-v $d:音声 ... \
	-x $d:司令官危険音声 ... \
	-y $d:司令官警戒音声 ... \
	-g $b:銃ライト \
	-m $i:危険モード \
	-z $i:麻酔持続時間 \
	-o $i:気絶持続時間 \
	-b $i:危険モードでの復活人数 \
	-k $i:そのステージでの復活人数 \
	-t $i:サイファー危険モードでの復活数 \
	-u $i:サイファーそのステージでの復活数 \
	-e $w:ルート $w:ポイント $p:プロック ...3 \
	-f $w:ルート $w:ポイント $t:音声 $t:音声時間 ...4 \
	-j $b:エリア $b:ルート $w:ポイント $t:音声 $t:音声時間 ...5 \
	-l $p:コマンダープロック ... \
	-s $i:ステージ種別 \
	-d $s:マップ \
	-h $i:警戒時間
	

/* n */


//	-s $i:ステージ種別
#define ENE_STAGE_TOILET			0x00000001	/* ロッカーではなくトイレステージ */
#define ENE_STAGE_NPC_EMMA			0x00000002	/* NPCエマ出現ステージ */
#define ENE_STAGE_NPC_SNAKE			0x00000004	/* NPCスネークステージ */
#define ENE_STAGE_GPS				0x00000010	/* 都市迷彩兵ステージ */
#define ENE_STAGE_NO_STRM			0x00000020	/* 音声無しステージ */
#define ENE_STAGE_ALERT2SNEAK		0x00000040	/* 危険モード後、潜入モード */
#define ENE_STAGE_SEARCH_MAX		0x00000080	/* 警戒モード、ＭＡＸスタート */
#define ENE_STAGE_GOVER_STOPSTR		0x00000100	/* ゲームオーバーフラグが立つと台詞カット */
#define ENE_STAGE_NO_ACCIDENT		0x00000200	/* アクシデント無し */
#define ENE_STAGE_NO_COMMANDER		0x00000400	/* コマンダー無し */
#define ENE_STAGE_NO_WC_GOVER		0x00000800	/* 発見即ゲームオーバーフラグ無視 */
#define ENE_STAGE_CROWD_PEOPLE		0x00001000	/* 大人数ステージ */


mesg コマンダー $s:名前 視界オフ[0]
mesg コマンダー $s:名前 視界オン[1]
mesg コマンダー $s:名前 待機所替え[2] $i:待機所番号
mesg コマンダー $s:名前 警戒体制変更[3] $i:警戒体制番号
mesg コマンダー $s:名前 引き釣られ兵消す[4]
mesg コマンダー $s:名前 危険レベル減らない[5]
mesg コマンダー $s:名前 危険レベル減る[6]
mesg コマンダー $s:名前 警戒レベル減らない[7]
mesg コマンダー $s:名前 警戒レベル減る[8]
mesg コマンダー $s:名前 クリアリングエリアスキップオン[9] $i:エリア番号
mesg コマンダー $s:名前 クリアリングエリアスキップオフ[10] $i:エリア番号
/* 普通はクリアリングエリアに元気な敵兵がいる場合、そのクリアリングエリアは
	スキップされる。これを無視してクリアリングエリアチェックをさせるには次のコマンド */
mesg コマンダー $s:名前 クリアリング敵兵チェックスキップオン[11] $i:エリア番号
mesg コマンダー $s:名前 クリアリング敵兵チェックスキップオフ[12] $i:エリア番号

mesg コマンダー $s:名前 聴力オフ[13]
mesg コマンダー $s:名前 聴力オン[14]


