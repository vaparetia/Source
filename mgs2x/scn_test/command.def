	-yran $i:縦視野角 \ /*省略可*/
	-i $w:視力 \
	-speed $i:最高速度 \ /*初期値80*/
	-touChaku	$p:到着プロック	$i:ルート番号 $i:ノード番号 \
	-brakeproc $p:破壊時プロック	\
	-guntime $i:射撃時間定数 $i:射撃時間乱数 $i:休み時間定数 $i:休み時間乱数
mesg 狙撃サイファ $s:名前 ルート変更[1] $i:ルート番号 $i:ノード番号
mesg 狙撃サイファ $s:名前 視界設定[33] $i:フラグ /*0:見える 1:見えない*/
mesg 狙撃サイファ $s:名前 スタート[258]
/*	射撃関連の時間単位 フレーム 1sec=60f				*/
/*	破壊時プロック: 破壊時に実行		    $1に名前	省略可	*/

/*====================カメラ系共通=======================*/
/*
振り中心角省略時は支柱方向が中心 初期方向は中心角度から相対指定
壊れ実行ブロック	引数１:	名前
			引数２:	壊れ種類 ステータスと同様に、
				破壊状態１ 銃でやられた
				破壊状態２ 爆散
ステータスフラグ (0x00) 通常状態
ステータスフラグ (0x01) 破壊状態１ 銃でやられた
ステータスフラグ (0x02) 破壊状態２ 爆散*/
#define PLANT_CAMERA_NORMAL		0x00
#define PLANT_CAMERA_BROKEN		0x01
#define PLANT_CAMERA_VANISH		0x02


chara 監視カメラ[NewSvCamera] $s:名前	\
	-pos $v:設置場所		\
	-rot $v:支柱部方向		\ /*ＸＹ値のみ有効*/
	-dir $i:振り幅			\ /*片側角度*/
	-alertdir $i:緊急振り幅		\ /*片側角度*/
	-center $i:振り中心角 $i:初期方向\ /*初期方向は符号付き相対指定*/
	-xran $i:縦視野角		\ /*省略可 512*/
	-yran $i:横視野角		\ /*省略可 512*/
	-i  $w:視力 ...			\ /*4つまで 通常 危険 警戒 回避 の順 */
	-status $i:ステータスフラグ	\
	-wait $i:首振り待ち時間		\ /*単位 フレーム 省略可 10*/
	-vc_radar $i:レーダー範囲上限 $i:レーダー範囲下限	\
	-exec { 実行ブロック }		  /*破壊時*/
mesg 監視カメラ $s:名前 視界オフ[1]
mesg 監視カメラ $s:名前 視界オン[2]

chara プラントカメラ[NewSvPlantCamera]  $s:名前 \
	-pos $v:設置場所 \
	-rot $v:支柱部方向 \ /*ＸＹ値のみ有効*/
	-dir $i:振り幅 \ /*片側角度*/
	-alertdir $i:緊急振り幅 \ /*片側角度*/
	-center $i:振り中心角 $i:初期方向 \ /*初期方向は符号付き相対指定*/
	-xran $i:縦視野角 \ /*省略可 512*/
	-yran $i:横視野角 \ /*省略可 512*/
	-i  $w:視力 ...			\ /*4つまで 通常 危険 警戒 回避 の順 */
	-status $i:ステータスフラグ \
	-wait $i:首振り待ち時間 \ /*単位 フレーム 省略可 10*/
	-vc_radar $i:レーダー範囲上限 $i:レーダー範囲下限	\
	-exec { 実行ブロック } /*破壊時*/
mesg プラントカメラ $s:名前 視界オフ[1]
mesg プラントカメラ $s:名前 視界オン[2]

chara ガンカメラ[NewGunCamera]  $s:名前 \
	-pos $v:設置場所 \
	-rot $v:初期方向 \ /*ＸＹ値のみ有効*/
	-dir $i:振り幅 \
	-alertdir $i:緊急振り幅 \ /*片側角度*/
	-center $i:振り中心角 $i:初期方向 \ /*初期方向は符号付き相対指定*/
	-xran $i:横視野角 \ /*省略可*/
	-yran $i:縦視野角 \ /*省略可*/
	-i $w:視力 ...	  \		/*省略可*/
	-status $i:ステータスフラグ \
	-wait $i:首振り待ち時間 \ /*単位 フレーム 省略可 10*/
	-exec { 実行ブロック } \/*破壊時*/
	-niktime $i:ニキータ破壊時間
 /* 大統領イベント専用 省略可						*/
 /* 発見後に指定時間経過すると破壊される 単位：１秒=300 デフォルト 600	*/


