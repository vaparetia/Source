#define	PUT_OBJ_D_HAZARD		0x00000008	/* モデルのバウンディングに動的壁セット */
#define	PUT_OBJ_TRANS_SCALE	0x00000010	/* トランスにスケールをかける */
#define	PUT_OBJ_NO_PRESHADE	0x00000020	/* プレイシェードしない */
#define	PUT_OBJ_AUTOREPAINT	0x00000040	/* オートリペイント */
#define	PUT_OBJ_NOFOG			0x00000080	/* フォグ効かない */
#define PUT_OBJ_THERMAL		0x00000100		// 赤外線ゴーグル反応
#define	PUT_OBJ_STAGE_ROTATE	0x00000200	/* ステージモデル（トランス付き）を回転 */
#define	PUT_OBJ_STATUS_NV			0x00000400	/* 暗視ゴーグルに反応 */




