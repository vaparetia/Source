/*
プロックはセットした順に 「通常発見時」「プロジェクタ1で発見時」「プロジェクタ2で発見時」
に呼ばれます
プロジェクタには "chara 静止スポットライト設置" で設定した場所と方向を入れてください
プロジェクタは２つまで。
*/

command ゲット船倉兵座標[HLD_GetHoldPosition] \
	$s:敵兵名 $r:Ｘ座標変数 $r:Ｙ座標変数 $r:Ｚ座標変数

chara 天井君[NewCeiling] $s:名前 \
	-m $s:オブジェクト名 -p $v:場所  -l $s:光源 -v $p:表示切替えプロック -h $i:高さ \
	-c $v:チェック座標 ...3 -a $b:チェック軸 ...1 \
	-n $v:チェック軸方向直接指定 ...3 \
	-e $w:チェック面数 $b:チェックモード//（0:論理積,1:論理和）

mesg 天井君 $s:名前 常に表示[1]
mesg 天井君 $s:名前 常に表示ＯＦＦ[2]

// -h と -c,-a,-n 及び -a と -n は共に排他オプションです
// -h を使う場合はそれだけで完結（従来と同様）
// -c を使う場合は -a もしくは -n でチェック軸の方向を指定（指定しないとY-になる）
// -c で指定する座標は判定を行なう平面上の任意の座標です
// （意味的にはその座標をチェック方向に越えると表示ONになる）
// -a に指定する値
// 0 ... X軸方向+でチェック
// 1 ... X軸方向-でチェック
// 2 ... Y軸方向+でチェック
// 3 ... Y軸方向-でチェック （デフォルト）
// 4 ... Z軸方向+でチェック
// 5 ... Z軸方向-でチェック
// -n はチェック方向直接指定。チェック方向のベクトルを指定。これを使うと斜めなども指定できる
// -a 3 は -n 0,-100,0 と同義である
// -c を使う場合には -e を指定することで複数の面でチェックすることができます。
// その場合複数の面チェック結果を論理和か論理積のどちらで判断するか決めることができます。


chara サウンドマネージャー[NewSoundManager] $s:名前 \
			-pak $i:サウンドパック番号 \
//			-b $i:BGM -a $i:常駐ＳＥ -e $i:ＳＥ -w $i:ＷＡＶＥ ... \
			-s $i:ステータス
mesg サウンドマネージャー $s:名前 SD_CODE[0] $i:サウンドコード

chara ＢＧＭマネージャー[NewBGMManager] $s:名前 \
			-s $i:ステータス
mesg ＢＧＭマネージャー $s:名前 SD_SNEAK_AUTO[0] $i:オートフェーダーコード
mesg ＢＧＭマネージャー $s:名前 潜入でもフェードアウトしない[1]

command ＳＥセットモード[GM_SeSetModeGcl] -s $w:音番号 -p $v:発生場所  -m $w:モード
command セットノイズ[GM_SetNoiseGcl] -n $w:ノイズ種類 -p $v:発生場所  -m $s:マップ
command セットサウンドコード[GM_SdSetGcl] -c $i:サウンドコード
command ロードサウンドパック[GM_LoadPack] -p $i:サウンドパック番号
command ＳＥセットＶＰ[GM_SeSetVolPanGcl] -s $w:音番号 -v $w:ヴォリューム -p $w:パン
/*
音量：0x00 〜 0x3f(最大)
パン：0x00(左) 〜 0x20(真中) 〜 0x3f(右)
*/

chara 死体君[NewCorpGcl] $s:名前 -m $s:モデル名 -d $w:ポーズ -p $v:場所 -r $v:方向 \
			 -n $w:初期モーション番号  -s $i:ステータス -e $s:マルチウェイトモデル \
			 -q $p:アイテムプロック $b:確率 ...2 -f $v:掴みシフト ...3 -a $s:far名 \
			 -j $p:アイテムプロック $d:VERYEASY  $d:EASY  $d:NORMAL  $d:HARD  $d:EXTREME \
			 -b $p:プロック ...

#define	CORPS_ST_EVM			0x00000001	/* マルチテクスチャ */
#define	CORPS_ST_ZZZ			0x00000002	/* Zzz */
#define	CORPS_ST_PIYO			0x00000004	/* piyopiyo */
#define	CORPS_ST_SPRAY			0x00000008	/* 水飛沫 */
#define	CORPS_ST_OOZ			0x00000010	/* にじみ血あり */
#define	CORPS_ST_LIVE			0x00000020	/* 生きている */
#define	CORP_STATUS_SHADOW		0x00000040	/* スポットライトかげ */
#define	CORP_STATUS_NOBLOOD		0x00000080	/* 出血無し */
#define	CORP_STATUS_NOHIT		0x00000100	/* あたり無し */


mesg 死体君 $s:名前 kill[-1]

chara ＢＧＭ風音[NewWindNoise] $s:名前 -s $i:天候

#define	BGM_WINDNOISE_WEATHER_RAIN	(0)
#define	BGM_WINDNOISE_WEATHER_FAIN	(1)

chara ＢＧＭフェーダー[NewBgmFader] $s:名前 	\
	-t $i:トラック番号 -a $v:場所 $v:サイズ $s:マップ名  ...7 -s  $i:ステータス


