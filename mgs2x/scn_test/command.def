chara テストボックス[NewTestBox] $s:名前 \
	-p $v:出現位置 \
	-r $v:方向 \
	-e $p:エンドプロック \
	-m $s:モデル名

chara 複数赤外線[NewIrs2] $s:名前 \
    -p $v:スイッチ座標 $v:スイッチ方向 $s:スイッチ名前 ...7 \
	-n $i:スイッチの数 \
	-a $v:センサー座標 $v:センサー方向 ...6 \
	-b $i:センサーのセット数（１セット２個） \
    -e $p:赤外線接触proc \
    -s $p:スイッチ破壊時proc \
	-m $s:モデル名 ... \
	-l $s:張り付け先名 $s:張り付け元名 $i:パーツID ...3 \
	-o $i:張り付けの数 \
	-sinGle $p:個別のプロック ... \
    -d $i:１を指定すると下部のセンサー無し（50cmの隙間ができる）必ず指定してください ...1

mesg 複数赤外線 $s:名前 on[1]
mesg 複数赤外線 $s:名前 off[0]
mesg サイファ死亡 $s:名前 kill[3] \
				  $s:サイファの名前
mesg 複数赤外線 $s:名前 all_kill[4]
mesg 複数赤外線 $s:名前 single_die[8] \
		$s:破壊対象の名前

command 複数赤外線破壊ステータス[SK_ScnDestoryBox] \ /* その番号の物が壊されていたら 1 */
	-num $i:番号 //(複数赤外線に登録した順番が番号になる  0,1,2.....）

command 複数赤外線破壊ステータス２[SK_ScnBeforeDestroyBox] // 最後に壊したstrcodeがかえってくる

chara スティンガー[NewStgScnSight] $s:名前
mesg スティンガー $s:名前 kill[1]

command スティンガー性能[NewStingerFlag] \
	-t $i:回転スピード \
	-m $i:最大スピード \
	-p $i:加速度 \
	-d $i:吸い込み力 \
	-life $i:飛行時間 \
	-s $v:初期速度          // 必須 default 0 , -250 , 0

command スティンガーサイト性能[NewStingerSightFlag] \
	-l $i:デフォルトロックサイズ

command 武器ライト[NewSKLightEff] \
	-t $i:添付ライト

command タンカーカメラステータス[NewTdgCameraStatus] \
	-d $i:格納場所変数

command タンカーカメラステータス初期化[NewTdgCameraStatusOff] \
	-f $i:消したいフレーム

command タンカーカメラステータス取得[NewTdgCameraFrameStatusGet] \
	-f $i:ステータスの欲しいフレーム

command タンカーカメラ初期化[NewTdgCameraInitialize] \
	-strcode $s:貼り付ける絵 \ // default 真っ黒
	-frame $i:対象フレーム

