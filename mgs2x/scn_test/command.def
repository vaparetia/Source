//ステータスフラグ設定は以下のとおり
#define	PUT_MOT_NO_MOVE		(0x0001)	//モーションの水平移動量を無視
#define	PUT_MOT_WAIT		(0x0008)	//モーション停止で待機 (mesgで再生開始)
#define	PUT_MOT_POS_RESET	(0x0010)	//再生開始時に座標をリセット
#define	PUT_MOT_NO_INTERP	(0x0020)	//モーション補完無し
#define	PUT_MOT_PRESHADE	(0x0040)	//プリシェード使用
#define	PUT_MOT_INVISIBLE	(0x0080)	//非表示で起動（再生mesgで表示開始）
#define	PUT_MOT_THERMAL		(0x0100)	//赤外線ゴーグル反応
#define	PUT_MOT_BOUND		(0x0200)	//デバッグ用表示
#define	PUT_MOT_RADARPOINT	(0x0800)	//レーダー光点

