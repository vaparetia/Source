	-size $i:大きさ \
	-alpha $i:アルファ \
	-g $w:グループ番号

mesg レンズフレア $s:name アルファ変更[2] $i:アルファ値 $i:時間

chara プロトヴァンプ[NewSuperVamp] $s:名前 \
	-pos $v:初期位置 \
	-vox $t:ストリーム音声 $t:ストリーム音声長さ ...2 \
	-end $p:終了プロック

