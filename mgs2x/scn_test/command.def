//
// コマンド定義ファイル
//
// $Id: command.def,v 1.1 2002/02/01 06:08:31 usr01475 Exp $
//
// システム関数

if ( 式 ) { 実行ブロック } -else { 実行ブロック }
return [$i:返り値]

eval ( 式 )

// デバッグ用

print * ...

// システム起動処理

start

restart -save

// 変数のセーブ
command varsave[NewSaveVariable] [$r:変数名 ...]
// 変数名を省略した場合は全変数セーブ。配列は要素を１つずつ。

// セーブ領域からのリード
command save_var_read[NewReadSavedVariable] $r:変数名
// 値を返す

// ロードしたデータからリスタート
command load_restart[NewLoadRestart]

// ロードしたデータを戻すだけ。リスタートはしない
command store_loadedvar[ComStoreLoadedVariable]

command プロダクトコード設定[ComSetProductCode] 'プロダクトコード'


// 言語
//あえてアメリカとイギリスを分けてみた（今は中身は一緒） */
#enum {
	LANG_JAPANESE			= 0,		//日本
	LANG_ENGLISH		    = 1,		//英語
	LANG_ENGLISH_USA		= 1,		//亜米利加
	LANG_ENGLISH_ENGLAND	= 1,		//英吉利
	LANG_FRENCH				= 2,		//仏蘭西
	LANG_GERMANY			= 3,		//独逸
	LANG_ITALY				= 4,		//伊太利亜
	LANG_SPANISH			= 5,		//西班牙
	LANG_KOREAN				= 6,		//韓国
} ;

// ゲームレベル
// 必ずデファイン名を用いる事！直値禁止！
#enum {
	LEVEL_VERY_EASY_JPN     = 10,
	LEVEL_EASY_JPN          = 20,
	LEVEL_NORMAL_JPN        = 30,
	LEVEL_HARD_JPN          = 40,
	LEVEL_EXTREME_JPN       = 50,
} ;

#enum {
	LEVEL_VERYEASY			= d:LEVEL_VERY_EASY_JPN,
	LEVEL_EASY				= d:LEVEL_EASY_JPN,
	LEVEL_NORMAL			= d:LEVEL_NORMAL_JPN,
	LEVEL_HARD				= d:LEVEL_HARD_JPN,
	LEVEL_EXTREME			= d:LEVEL_EXTREME_JPN,
	LEVEL_E_EXTREME			= 60,
} ;
#endif

// システムコンフィグ定義（ GM_Configuration ）
#enum {
	CONFIG_VIBRATION_OFF 	= 	0x0001,	/* 振動ＯＦＦ */
	CONFIG_CAPTION_OFF  	= 	0x0002,	/* 字幕ＯＦＦ */
	CONFIG_RADAR_OFF 		= 	0x0004,	/* レーダーＯＦＦ */
	CONFIG_BLOOD_OFF		= 	0x0008,	/* 血ＯＦＦ */
	CONFIG_SOUND_MONAURAL	= 	0x0010,	/* モノラル */
	CONFIG_RADAR_OFF_INTRUDE = 	0x0020,	/* イントルード時レーダーＯＦＦ */
	CONFIG_SHUKAN_REVERSE =		0x0040,	/* 主観操作反転 */
	CONFIG_OLD_TYPE_MENU	=	0x0080,	/* 旧式メニュー */
	CONFIG_WATERUD_REVERSE =	0x0100,	/* 水中上下操作反転 */
	CONFIG_MENU_QCHANGE_EX	=	0x0200,	/* 拡張クイックチェンジ */
	CONFIG_SOUND_5_1CHANL	=	0x0400,	/* 5.1chanlサウンド対応 */
	CONFIG_END_IF_FOUND		=	0x0800,	/* 見つかったらゲームオーバー */
	CONFIG_STORY_TANKER 	= 	0x1000,	/* タンカー編。ビットが立ってなければプラント編 */
	CONFIG_TANKER_CLEARED	=	0x2000, /* このプレイでタンカー編をクリアしている */
	CONFIG_PLAYTIME_STOP	=	0x4000, /* PLAYTIMEカウンタを止める */
} ;

// アラートモード定義( GM_AlertMode )
#enum {
	ALERT_MODE_SNEAK = 0,	/* 潜入モード */
	ALERT_MODE_ALERT,		/* 危険モード */
	ALERT_MODE_AVOID,		/* 回避モード */
	ALERT_MODE_SEARCH		/* 探索モード */
} ;

// プレイヤーフラグ定義( GM_PlayerStateFlag )
#enum {
	PL_START_STATE_BLOOD =		0x0001,			/* 出血中 */
	PL_START_STATE_BLADE_OUT =	0x0002,			/* ブレード抜いている */
	PL_START_STATE_BLADE_INV =	0x0004,			/* ブレードさかさ */
	PL_SOCOM_SPPRSR_ATTACHED =  0x0010,			/* ソコムにサプレッサがついている */
	PL_AK_SPPRSR_ATTACHED =  	0x0020,			/* AKにサプレッサがついている */
	PL_GBSCAP_EXIST =			0x0040,			/* ゴル兵装にキャップが付いている */
	PL_USP_SPPRSR_ATTACHED =	0x0080,			/* ＵＳＰにサプレッサが付いている */
	PL_FACE_WOUNDED =			0x0100,			/* 顔にキズがある */
	PL_SHOWERED =				0x0200,			/* おしっこかけられた */
	PL_GAVE_SHAVER_TO_SNAKE =	0x0400,			/* スネークに髭剃り渡した */
} ;

/* クリアコードフラグ GM_ClearCodeFlag */
#enum {
	CLEAR_SPECIAL_ITEM_USED =	0x0020,		/* 特殊アイテム使ってクリア */
	CLEAR_MUGENBANDANA_USED =	0x0100,		/* 無限バンダナ使った */
	CLEAR_MUGENWIG_USED		=	0x0200,		/* 無限かつら使った */
	CLEAR_WIG_A_USED		=	0x0400,		/* Ｏ２かつら使った */
	CLEAR_WIG_B_USED		=	0x0800,		/* 握力かつら使った */
	CLEAR_STEALTH_USED		=	0x1000,		/* ステルス使った */
	CLEAR_RADAR_USED		=	0x2000,		/* レーダー使った */
} ;

/* クリア後フラグ GM_ClearFlag */
#enum {
	CLEARED_TANKER			=	0x0001,		/* タンカークリア */	
	CLEARED_PLANT				=	0x0002,		/* プラントクリア */
	CLEARED_TANKER_PLANT		=	0x0004,		/* タンカー＆プラントクリア */
	CLEARED_SUNGLASSES_PLAYING=	0x0010,		/* サングラスモードプレイ */
	CLEARED_SUNGLASSES_PLAYED=	0x0020,		/* サングラスモードプレイ済 */
} ;

/* タイトルメニュー設定 GM_TitleMenuStatus */
#enum {
	TITLE_MENU_STORY_SEL_MASK      = 0x0003, /* タイトルで選ばれたものを記録しておく */
	TITLE_MENU_STORY_SEL_1ST       = 0x0000, /* タイトルで"1ST TIME"が選ばれた */
	TITLE_MENU_STORY_SEL_TANKER    = 0x0001, /* タイトルで"TANKER"が選ばれた */
	TITLE_MENU_STORY_SEL_PLANT     = 0x0002, /* タイトルで"PLANT"が選ばれた */
	TITLE_MENU_STORY_SEL_TANDP     = 0x0003, /* タイトルで"TANKER & PLANT"が選ばれた */

	TITLE_MENU_TANKER_CLEARD       = 0x0004, /* タンカー編をクリア済み */
	TITLE_MENU_PLANT_CLEARD        = 0x0008, /* プラント編をクリア済み */

	TITLE_MENU_LOOKED_PREV_STORY_1 = 0x0010, /* 'Previous Story'の一つ目を既にみた */
	TITLE_MENU_LOOKED_PREV_STORY_2 = 0x0020, /* 'Previous Story'の二つ目を既にみた */

	TITLE_MENU_OPTION_CHANGED      = 0x0100, /* オプションが変更された */
	TITLE_MENU_SCRADJ_CHANGED      = 0x0200, /* スクリーンアジャストが変更された */
	TITLE_MENU_START_FROM_LOAD     = 0x0400, /* ロードして始めた場合のフラグ */
	TITLE_MENU_DISPED_MCWARNING    = 0x0800, /* タイトルの最初でメモリーカードのチェックをした */
	TITLE_MENU_DISPED_FIRST_MESSAGE = 0x1000, /* タイトルで哀悼文を表示済み */
	TITLE_MENU_DISPED_WARNING_VIOLENCE = 0x1000, /* タイトルで暴力表現の警告を表示済み */
};

// システムコールバック
command システムコールバック[NewSystemCallback] \
	-load $p:ロードがかかった（restartは含まず） \
	-restart $p:リスタートがかかった \
	-gameover $p:ゲームオーバーロゴが開始される直線 \
	-continue $p:ゲームオーバー後コンティニューされた \
	-item $p:アイテムが変更された \
	-weapon $p:武器が変更された \
	-exit $p:ゲームオーバー後ＥＸＩＴ \
	-dead $p:プレイヤー死亡直後 \
	-start_alert_mode $p:アラートモード：モード開始 \
	-quit_alert_mode $p:アラートモード：モード終了 \
	-active_map_change $p:表示マップ切り替え（主画面）//$1に表示マップＩＤ

//メニュー状態操作
command メニュー設定[NewSetMenuStatus] \
	-menu $s:on／off \			//武器・アイテムメニューのオンオフ
	-gage $s:on／off \			//ゲージのオンオフ
	-radar $s:on／off \			//レーダーのオンオフ
	-node_access $s:on／off \ 	//ノードアクセスの済／未
	-subwin $s:on／off \ 		//子画面のオンオフ
	-vibrate $s:on／off \ 		//振動のオンオフ
	-rAdio $s:on／off \ 		//無線の許可／不許可
	-pause $s:on／off \			//ポーズの許可／不許可
	-jamming $s:on／off \ 		//電波障害中／電波障害解除
	-disable_menu $s:on／off	//メニューオープンの許可／不許可

//ゲーム状況に応じて、各種メニューのオンオフを設定する。
//コンフィグ設定ではないので、ステージリセットでクリアされる。
//（デフォルトはすべてＯＮ）
// node_access は off がデフォルト

//武器、アイテムのＮｏＵｓｅ設定
command	不可装備設定[PL_COM_SetNoUse] \
	-weapon $i:武器番号 ... \
	-item $i:アイテム番号 ... \
	-cancel			//設定リセット

//シナリオデモ設定
command シナリオデモ開始[NewStartScenarioDemo]
command シナリオデモ終了[NewEndScenarioDemo]

//ゲームオーバー処理中かどうかをチェックする
//ゲームオーバー処理中なら１が返る。
command ゲームオーバーチェック[GM_COM_IsGameOver]

// ゲームオーバー音声セット
command ゲームオーバー音声設定[NewSetGameOverVox] \
	-vox $T:サウンドコード

// パッド関係

command パッド操作[NewPadControl] \
	-which $b:パッド番号 \		// パッド番号（０が１コン、１が２コン。省略時は１コン。）
	-release \			// パッドリリース
	-mask $i:ボタン指定 \		// 指定ボタンをマスク( 指定ビットを1にするとそのボタンは無効になる）
	-press $i:ボタン指定 \		// 指定ボタンをそのフレームだけおしたことにする
	-cancel [$i:モード] 		// 0:リリースもマスクも解除。1:リリースのみ解除。2:マスクのみ解除
					//   省略時は０と同じ

//パッドの状態を操作する。
// -release, -mask, -press, -cancel はどれか一つのみ設定すること

command パッドチェック[NewPadCheck] \
	-which $b:パッド番号 \
	-direct \		//リリースされたりしていても情報がとれる。
	-press \		//押された
	-status \		//押されている
	-release \		//離された
	-no_use			//パッドリリース状態にある

//パッドの状態を返す
//-press,-status,-releaseはどれか一つを指定
//-which を省略すると １コンを指定したことになる。
//
// たとえば、１コンの○が押されたかどうかは、
// command パッドチェック -which 0 -press
// if ( $status & d:PAD_A ) { }
// とすれば取得できる。

//ボタン定義
#define PAD_U	0x1000	//十字キー上
#define PAD_D	0x4000	//下
#define PAD_L	0x8000	//左
#define PAD_R	0x2000	//右
#define PAD_A	0x0020	//○
#define PAD_B	0x0040	//×
#define PAD_X	0x0010	//△
#define PAD_Y	0x0080	//□

#define PAD_L1	0x0004
#define PAD_R1	0x0008
#define PAD_L2	0x0001
#define PAD_R2	0x0002

#define PAD_STA	0x0800	//START
#define PAD_SEL	0x0100	//SELECT

#define PAD_AL	0x0200	//アナログ左押し込み
#define PAD_AR	0x0400	//アナログ右押し込み

//振動
chara パッド振動[NewPadVibrationScn] $s:名前 \
	-vibfile $s:振動バイナリファイル名

//パッドデモ再生
chara パッドデモ[NewPadDemoPlay] $s:名前 \
	-which $b:パッド番号（省略すると１コン） \
	-file $s:パッドデモファイル（.rpd） \
	-end_proc $p:終了プロック

mesg パッドデモ $s:名前 start[0]
mesg パッドデモ $s:名前 stop[1]
mesg パッドデモ $s:名前 kill[2]

// ステージロード

load 'ステージ名' \
	 -s $b:タイプ \					// ロードタイプ
	 -change $s:gcxコード \			// それ以降のgcxを指定の????.gcxにする。
	 -no_save [$i:する／しない] \	// 指定すると変数をセーブしない
	 -gameover \					// 指定するとゲームオーバー中でもロード
	 -resident '常駐ステージ名'		// 常駐データ入れ替え後、ステージロード

preseek 'ステージ名'

//-no_saveの使い方
//後に、何も指定しないか、1を指定すると、セーブ「しない」
//                        0を指定すると、セーブ「する」

// シナリオポーズ
// ボスラッシュの開始／終了専用のつもりなので
// 他で使用しないこと！！！
command	ポーズセット[GM_COM_PauseOn]
command	ポーズリセット[GM_COM_PauseOff]

/*
	各キャラクタ定義
	担当別に区切る
*/

//---------------------------------------------------------------------
// 植原

// 汎用関数

// rand: 返り値($status, $?)に、値を返す。 (`command rand 10`)も可能。
command rand[NewRand] $i:最大値

command foreach[NewForeach] -argc $i:引数の数 -repeat $i:繰返し回数 \
	 -data * ... -exec { 実行ブロック }
// 繰返し実行。 実行ブロックには、$1,$2...で[$i:引数の数]個のデータが渡される。
// -value には、 $i:引数の数 * $i:繰返し回数のデータが必要

command sound[NewSound] -x $i:サウンドコード -w
		// -w をつけるとロード完了までまつ

command 配列セット[NewArraySet] $r:変数 * ...

chara delay[NewDelay] $s:名前 -time $i:時間 -exec { 実行ブロック } \
	 -proc $p:proc \
	 -arg $i:実行ブロックへのパラメータ ...
// 時間は 1/60 単位
mesg delay $s:名前 kill[-1]

command sin[NewGclSin] $w:角度（４０９６）		// 返り値は-4096から4096
command cos[NewGclCos] $w:角度（４０９６）		// 返り値は-4096から4096
command atan[NewGclAtan] $w:X移動量 $w:Y移動量	// 返り値は0から4096
command abs[NewGclAbs] $i:数値
command VecLen[NewGclVecLen] $i:x0 $i:y0 $i:z0 $i:x1 $i:y1 $i:z1

command assert[NewGclAssert] $i:評価式 [ 'アサート文字列' ]

command 現在時刻取得[NewGclGetRTC]		// 返り値は、[時]*60+[分]

// オブジェクト

chara MGSシステム初期化[NewGameInit] $s:名前 \
	 -debug $f:デバッグモード許可

command フォント初期化[NewFontInit]

command 変数初期化[NewGclVarClear]

command 字幕言語設定[NewGclLangUpdate]

command 常駐リソース設定[NewResidentResourceSet] \
	-string $d:リソース $i:参照ID ...2 \
	-binary $d:リソース $i:参照ID ...2
// リソースは、[RESOURCE:*]と記述することで、プログラムはその先頭番号が取れる。
// 参照IDはstringとbinaryで重ならないこと。

command 常駐領域設定[NewResidentAreaSet] $s:ID $i:サイズ

command 解析封じ変数移動[NewGclVariableMove]

chara select[NewSelect] $s:名前 \
	-s '文字列' $p:proc ...2

chara sound_test[NewSoundTest] $s:名前 \
	-s 'VC文字列' $T:VOXコード ...2

chara ドア[NewDoor] $s:名前 \
	-m $s:オブジェクト名 \
	-d $v:向き \
	-p $v:場所 \
	-slide $i:スライド量 \
	-time $i:時間 \
	-between $s:マップ名１ $s:マップ名２ \
	-card_level $i:カードレベル（省略すると０） \
	-lAmp $s:ドアランプキャラの名前（４つまで） ... \
	-alert $i:アラートモードで開かなくなる場合は１ \
	-light $s:影ＩＤ（対象スポットライト名） \
	-hazard_width $i:壁の大きさ（省略するとモデルの大きさにあわせる） \
	-w_door $s:両開き用のもう一つのオブジェクト $i:スライド量 \
	-seNo $b:音番号 \
	-exec { $:開閉フラグ }
// マップ名１.２はそのドアが境界になっているマップの名前
// 省略すると、command マップ設定 で設定されたマップが用いられる。

// 対象スポットライトを指定すると、そのライトが作る影がドアに投影される。

// $:開閉フラグ は、0(閉まり切った) or 1(開き始めた)

mesg ドア $s:名前 open[1] [$s:メッセージ発行キャラ]
mesg ドア $s:名前 入る[1] [$s:メッセージ発行キャラ]
mesg ドア $s:名前 close[2] [$s:メッセージ発行キャラ]
mesg ドア $s:名前 出る[2] [$s:メッセージ発行キャラ]

mesg ドア $s:名前 on[3]
mesg ドア $s:名前 off[4]
mesg ドア $s:名前 visible[5] $i:フラグ
mesg ドア $s:名前 locked[6] 	//これ以降開けられない

mesg ドア $s:名前 openstart[7] 	//開いた状態からスタート


//visibleを指定したときのフラグには、
//可視、不可視フラグが入る
//たとえば、天井君切り替えプロックの$1など。

chara サブ画面[NewTs_SubWindow_S] $s:名前 -w $w:x0 $w:y0 $w:x1 $w:y1
// 座標設定は無効。
// ２つ以上出せない。

mesg サブ画面 $s:名前 on[1]
mesg サブ画面 $s:名前 off[0]

/*2000.09.12 レーダーを重野管理に移動*/

chara 字幕[NewJimaku] $s:名前 '文字列'

// マップ

chara マップ接合[NewMapConnect] $s:名前 $s:マップ１ $s:マップ２ -type $i:接合タイプ
mesg マップ接合 $s:名前 on[1]
mesg マップ接合 $s:名前 off[0]

//接合タイプ
//	0 : ドアタイプ（デフォルト）
//  1 : ドアなしタイプ

command 即時マップ接合変更[GM_COM_ChangeMapConnectStatus] $s:名前 $s:on／off
//即時型マップ接合変更処理

// USBキーボードを使ったデバッグ用コマンド

chara USBキーボード実行[NewKbdExec]	$s:名前 \
	-e $b:キーコード { 実行ブロック }
// キーコードはusbkbd.hに定義してあります。
// -e は複数指定可能

// デバッグ用ポーズ

chara デバッグポーズ[NewDebugPause] $s:名前 'STRING' -p $p:proc -exec {}
// STRINGを表示してポーズをかけ、○ボタンが押されたらprocを実行

// 無線システム

chara 無線システム[NewCodecDaemon] $s:名前 -player $s:プレイヤ骨格名
// 名前は、"Codec"固定

// 無線のメモリー呼出リストを、GCL 側から登録する
command 無線メモリー設定[CodecMemCallSet] \
		-area $i:登録エリア -freq $w:周波数 -name $i:名前リソース番号 \
		-reset

command 無線設定[NewCodec] \
	-base $w:周波数 $C:無線コード \
	-over $i:入る／出る $w:周波数 $C:無線コード \
	-call $w:周波数 $C:無線コード $w:呼び出しタイプ [$p:proc_id] \
	-reset \
	-allclear \
	-f $w:フェードオプション \
	-d \
	-conT $w:周波数 $C:継続無線コード ...2 \
	-contC -speech $i:スイッチ

command 無線状態[CodecStatus]

command 無線メモリーリセット[CODEC_MemCallReset]


// 呼び出しタイプは、
#define CODEC_CALL		2	// CALL
#define CODEC_DEMO		3	// CALLから強制移行
#define CODEC_DIRECT	4	// CALLなしで強制移行

// フェードオプション
#define CODEC_IN_FADE    9	// フェードで無線モードに入る
#define CODEC_OUT_FADE   6	// フェードで無線モードから出る
#define CODEC_IO_FADE    3	// フェードで無線モードに出入りする

//
// フェード/アクション制御のマクロ定数は、以下の命名法則に従う。
//
//  CODEC_I_<無線in時の挙動>_O_<無線out時の挙動>
//
//  <挙動>
//     NO        フェード、枠アクションともに無し
//     FD        フェードのみ。枠アクションは無し
//     AC        枠アクションのみ。フェードは無し
//     FA        フェード、枠アクションともに有り
//
#define CODEC_I_NO_O_NO  0x0000
#define CODEC_I_NO_O_FD  0x0002
#define CODEC_I_NO_O_AC  0x0008
#define CODEC_I_NO_O_FA  0x000a

#define CODEC_I_FD_O_NO  0x0001
#define CODEC_I_FD_O_FD  0x0003
#define CODEC_I_FD_O_AC  0x0009
#define CODEC_I_FD_O_FA  0x000b

#define CODEC_I_AC_O_NO  0x0004
#define CODEC_I_AC_O_FD  0x0006
#define CODEC_I_AC_O_AC  0x000c
#define CODEC_I_AC_O_FA  0x000e

#define CODEC_I_FA_O_NO  0x0005
#define CODEC_I_FA_O_FD  0x0007
#define CODEC_I_FA_O_AC  0x000d
#define CODEC_I_FA_O_FA  0x000f

#define CODEC_FDIN_BREAK  0x0010  // フェードインを暗転状態から開始
#define CODEC_FDOUT_BREAK 0x0020  // フェードアウトを暗転状態で終了
#define CODEC_NO_ALARM    0x0040  // CALL/DEMO の呼び出し音を鳴らさない
#define CODEC_NO_ICON     0x0080  // CALL/DEMO のアイコンを表示しない


// ストリーミング用

command Stream[NewStreamSet] $t:VOXコード -p $p:終了proc -w -c $b:チャンネル \
	-action $p:アクションproc -menustop -ipu
	// -w は、初期読み込み後、stream startがくるまで停止
	// 終了procには、$1で中断したかどうかがわたる（0:正常終了、1:中断)
	// アクションproc は、$:ストリームID $:話者名 $:アクションコード
	// -ipuをつけるとipuStreamを再生

// 以下のcommandは、このcommandの返り値(int)を使ってアクセス。

command StreamStart[NewStreamStart] $i:StreamCode
	// -wで初期読み込み後停止しているstreamをスタート
command StreamStop[NewStreamStop] $i:StreamCode
	// ストリームの強制停止
command StreamStopAll[NewStreamStopAll]
	// すべてのストリームの強制停止
command StreamIsPlay[NewStreamIsPlay]
	// ストリームが何本再生中かを返す
command StreamSetPan[NewStreamSetPan] $i:StreamCode -p $b:パン -v $b:ボリューム
	// ストリームにパンとボリュームを設定する。
	// pan 0(左)-0x20(中)-0x3F(右), vol 0-0x3F

command StreamStatus[NewStreamStatus] $i:StreamCode
	// 以下の値を返す。d:STREAM:WAITのように参照。

command StreamPauseControl[NewStreamPauseControl] -channel $i:channel -on -oFf
	// -on, -off のどちらかを指定。onでPAUSE_ON

command 字幕制御[NewJimakuControl] -hide -y $i:Y座標 -disable
	// -hide : 消す
	// -y : Y座標の移動
	// -disable : ロード時など、出ているのを消して、すべて禁止する。
	//            リスタートしないと再開しない。

#enum STREAM {
	INIT_WAIT = -2,		// 初期化後CD読み込み開始待ち
	INIT = -1,			// 初期CD読み込み中
	WAIT = 0,			// -w でのWAIT状態
	PLAY = 1,			// 再生中
	READ_END = 2,		// CD読み取りは最後まで終った
	END = 3				// 終了
};

// --- デモ、ストリーミングキャンセルチェック

chara デモキャンセルチェック[NewPadCancel] $s:名前 -p $proc
// ×ボタンかスタートボタンか押されて(離されたら)procを呼び出す。
mesg デモキャンセルチェック $s:名前 kill[-1]

// --- ムービー

//chara PSS再生[NewUnusedChara] $s:名前 -name 'PSSFILE' -proc $p:終了proc \
//	-top $w:x $w:y

chara MOVIE再生[NewMpegPssMovieStr] $s:名前 -file $T:番号 -proc $p:終了proc \
	-top $w:x $w:y -size $w:width $w:height -pRio $i:プライオリティ -repeat

chara エンディング[NewEnding] $s:名前 -telop $s:テロップデータ \
			-file $T:番号 -proc $p:終了proc


//---------------------------------------------------------------------

//園山 M.Sonoyama

//-------- マップ関連 ------------------------------------------------

//マップシステム
chara マップ[NewSetMap] $s:名前 \
	-k $s:モデル名 [$v:セット位置] \
	-h $s:ハザード [$b:開始グループ] \
	-g $b:ハザードグループナンバー \	//不使用
	-l $s:ライト \
	-s $s:影投影モデル名 [$v:セット位置]	//廃止

command	マップ設定[NewMapAbout] $s:名前 ... \
		-set { キャラセット }

command	マップ表示[NewShowMap] -add $s:名前 ... -delete $s:名前 ... \
                               -show $s:名前 ...

command マップ表示チェック[NewCheckMapIsDisplay] \
	-which $i:チャンネル（省略すると０） \
	-map $s:マップ名
//1が返ると表示中

//キャラのマップを変更する
command キャラマップチェンジ[GM_ComMapChange] \
	-name $s:キャラの名前 \
	-map $s:変更先マップ名

//追加ＨＺＸグループ関連

//追加ＨＺＸグループを登録
command 追加ＨＺＸグループ登録[NewHzxSetGroupAdd] \
	-hzx_id $b:元になるグループ番号 \
	-add_id $b:追加するグループ番号

//追加ＨＺＸグループを削除
command 追加ＨＺＸグループ削除[NewHzxResetGroupAdd] \
	-hzx_id $b:元になるグループ番号 \
	-add_id $b:削除するグループ番号

//-------- カメラ関連 ------------------------------------------------
// CAMERA

//カメラ
chara カメラ[NewCamera] $s:名前 \
	-c $b:チャンネル番号 \
	-l $b:カメラレベル \
	-p $b:優先度

//シナリオカメラは最大16個までおける。

//チャンネル番号 ：
//	０：通常画面 １：小窓
//
//カメラレベル ：
//	０：カットインカメラ（主観より強） 強
//	１：カットインカメラ（主観より弱、ビハインドより強） ↑
//	２：エリアカメラ		   ↓
//	３：ステージデフォルトカメラ	   弱
//
//優先度 ：
//	エリアカメラに有効
//	数字が小さい程優先度高

// カメラの設定をする
chara カメラ設定[NewSetCamera] $s:名前 \
	-c $b:カメラタイプ \
	-b $v:バウンド小 $v:バウンド大 \
	-l $v:リミット小 $v:リミット大 \
	-p $v:カメラ位置 \
	-t $v:ターゲット位置 \
	-r $v:カメラ角度 \
	-f $i:カメラトラック \
	-a $w:カメラ画角 \
	-i $w:カメラ補完方法（ＩＮ） $w:カメラ補完方法（ＯＵＴ） \
	   $w:補完時間（ＩＮ） $w:補完時間（ＯＵＴ） \
	-d $f:パッドフラグ \
	-z $i:各種フラグ \
	-k $f:ＫＩＬＬ \
	-s $i:０オフ／１オン \
	-o $w:ＯＮになるまでの待ち時間 \
	-slidE $f:スライドタイプ $w:スライド待ち時間 \
	       $i:スライド距離１ $i:スライド距離２ \
	       $i:スライドスピード [$i:スライドフラグ] \
	-iNterp_time $i:内部補完時間

// フラグ
#define	CAMERA_NO_PAD_ADJUST		0x00000400	//パッド調整に影響を及ぼさない
#define	CAMERA_CUT_IN				0x00010000	//カットインカメラ
#define	CAMERA_NO_CUSHION			0x00700000	//遊びなしカメラ
#define	CAMERA_BOUNDCHANGE_QUICK	0x01000000	//バウンド変更を即時に反映
#define	CAMERA_INTERP_CAMERA		0x02000000	//補完カメラ設定
#define	CAMERA_NO_BLASTCAMERA		0x04000000	//爆発カメラ揺れを禁止
#define	CAMERA_LIMITBOUND_EXIST		0x08000000	//ＦＩＸだけどリミットがある

// -b -l は必要に応じて設定。
// -p -t -r はタイプに応じて使用するものが取得
// される。
// 省略したオプションは、前回設定を引き継ぐ。
//
//カメラタイプ ：
//	０：上俯瞰追従型（トラックと角度を指定）
//	１：位置・角度固定型（ターゲット位置とカメラ位置を指定）
//	２：位置固定、追従型（カメラ位置を指定）
//	３：位置固定、Ｘ角度追従型（カメラ位置を指定）※未作成
//	４：ターゲット固定、プレイヤー追従カメラ（ターゲットとトラックを指定）
//	５：位置固定、Ｙ回転固定、追従型（カメラ位置と回転を指定）

// 補完方法
// −１：指定なし ０：一瞬 １：補完シューン ２：補完ウニョーン
//   ３：補完ウーニャーン  ４：一定時間で
// 補完時間は４番指定のとき有効
// 補完（ＩＮ）の指定は必須。
// ２つのカメラ間の補完方法は、ＯＵＴ側カメラのＯＵＴ補完関数が指定してある
// 場合にはその関数を使用し、指定がない場合には、ＩＮ側カメラの
// ＩＮ補完関数を使用するようになっている。
//
// パッドフラグ
// このフラグを指定しておくと、
// パッドの上が画面の上になるように自動調節する。

// スライドカメラ設定方法
// スライドタイプ：０／１ − 左右タイプ／前後タイプ
// スライド待ち時間：スライドするまでの待ちフレーム数
// スライド距離１・２：左右タイプの場合 左右スライド距離
//		       前後タイプの場合 接近距離、離れた距離
// スライドスピード：そのまんま
// スライドフラグ ：
//		1にしておくと、入った時スライドしていない状態から始まります。

// 補完カメラの設定方法
// 補完カメラとは？
//		設定したカメラに指定フレーム数かけて移動するカメラ。
//		例として、オルガ戦のパンカメラ。
// 設定方法
//		-z に d:CAMERA_INTERP_CAMERA を指定。さらに
//		-interp_time に補完フレーム数を指定。

chara カメラ上下振動[NewCameraOscillation] $s:名前 \
	-a $w:振幅 \
	-c $w:周期（フレーム数）
// カメラの位置−ターゲットベクトルを
// 上下に単振動させる。
// 主観時は、無効

command カメラ上下振動スイッチ[NewCameraSwingMode] \
	-which $b:画面番号（０：主画面、１：子画面） \
	-mode $s:on／off
// 上記、カメラ上下振動の一時的なＯＮ／ＯＦＦに使用する。

//カメラ状態をチェックする。
//ＯＮになっていれば１を返す。
command	カメラ状態[NewCameraSwitchCheck] -s $s:カメラ名

command カメラマップ設定[NewSetChanlTargetMap] \
	-chanl $b:チャンネル（メイン：０子画面：１） \
	-map $s:マップ名

command カメラランダム振動[PL_COM_VibCamera] \
	-level $i:振動の大きさ
//振動時間は振動の大きさに比例します。

chara シナリオカメラ振動[PL_CHARA_ScnVibCamera] $s:名前 \
	-xlevel $i:Ｘ方向ランダムＭＡＸ値 \
	-ylevel $i:Ｙ方向ランダムＭＡＸ値 \
	-time $i:継続時間 \
	-mode $i:モード

mesg シナリオカメラ振動 $s:名前 kill[0]

//モード
//0 : ランダムＭＡＸ値一定
//1 : ランダムＭＡＸ値は時間とともに減少

//-------- プレイヤー ----------------------------------------------------
//PLAYER

chara プレイヤー[NewRaiden] $s:名前 \
	-model $s:モデル名 \
	-archive $s:モーション名 \
	-position $v:出現位置 \
	-direction $v:出現方向 \
	-level $w:出現位置床高さ \ 	//廃止
	-stance $b:出現時姿勢 \
	-other_mar $s:強制モーション用モーションファイル名 \
	-id_table $b:ＳＥ変換テーブルＩＤ \
	-homing $i:ホーミング距離 $i:ホーミング角度 \
	-aRm_evm $s:主観腕ＥＶＭモデル \
	-flags $i:各種フラグ 

// 出現時姿勢 ： ０／１／２／３ ： 立ち／しゃがみ／匍匐／イントルード

//各種フラグ ： どんどん追加される。かな？

#define PLY_SPLASH		0x00000001 //体足水飛沫あり
#define	PLY_NO_FOOT_SHADOW	0x00000002 //足影なし
#define	PLY_IS_SNAKE		0x00000010	//プレイヤーはスネーク
#define	PLY_IS_RAIDEN		0x00000020	//プレイヤーはライデン

//「プレイヤーはスネーク（ライデン）」について、
// この指定がなければ、$s:名前 で判定する。
// $s:名前 が 「ライデン」ならライデン、それ以外ならスネークになる。
// -flags に d:PLY_SNAKE(d:PLY_RAIDEN) が指定されていれば、
// 強制的にスネーク（ライデン）になる。
// （あくまでも、プログラム的にスネーク（ライデン）として扱う、という意味。
	 モデル、モーションなどは、ちゃんと設定してください。）

//プレイヤーメッセージ一覧（詳細は各項）
//
//mesg プレイヤー $s:名前 motion[0] 		強制モーション
//mesg プレイヤー $s:名前 position[1] 		強制位置移動
//mesg プレイヤー $s:名前 position2[2] 		強制位置移動２
//mesg プレイヤー $s:名前 menu[3] 			メニューＯＮ／ＯＦＦ
//mesg プレイヤー $s:名前 beyond_trap[4]	エルードトラップ指定
//mesg プレイヤー $s:名前 locker[5] 		ロッカーモード
//mesg プレイヤー $s:名前 wt_door[6] 		水密ドアモード
//mesg プレイヤー $s:名前 ladder[7]			はしごモード
//mesg プレイヤー $s:名前 shadow[8] 		足影ＯＮ／ＯＦＦ
//mesg プレイヤー $s:名前 headmark[9] 		赤びっくり
//mesg プレイヤー $s:名前 stance[10] 		強制姿勢制御
//mesg プレイヤー $s:名前 water[11]			水中モード
//mesg プレイヤー $s:名前 run[12] 			強制移動
//mesg プレイヤー $s:名前 beltconv[13] 		ベルトコンベア乗り降り
//mesg プレイヤー $s:名前 rotate[14] 		Ｙ方向セット
//mesg プレイヤー $s:名前 evpanel[15]		エレベータパネル
//mesg プレイヤー $s:名前 fall[16]			落下
//mesg プレイヤー $s:名前 snakearm_liftup[17]	プログラム専用
//mesg プレイヤー $s:名前 kageshibari[18]	プログラム専用
//mesg プレイヤー $s:名前 superblow[19]		強制吹っ飛ばし真下落し（ハリアー専用）

//-------- 強制モーション

mesg プレイヤー $s:名前 motion[0] \
	$i:モーション番号 \
	$i:初期方向 \
	$i:終了方向 \
	$i:終了姿勢 \
	$i:フラグ \
	[$i:開始時Ｘ座標 $i:開始時Ｚ座標 $i:開始時Ｙ座標]

//開始時座標指定は、ＸＺＹの順なので注意！
//ＸＺを指定して、Ｙを省略も可能

//フラグ定義（随時追加）
#enum {
    FA_NO_CHECK_SEG	= 0x00000001,	/* 壁見ない */
    FA_NO_CHECK_FLR	= 0x00000002,	/* 床見ない == 重力処理しない */
    FA_NO_CHECK_TRP	= 0x00000004,	/* トラップ見ない */
    FA_NO_RECHECK_TRP	= 0x00000008,	/* トラップチェック再開しない */
    FA_USE_DEFAULT	= 0x00000100,	/* デフォルトのmarから指定 */
    FA_NO_WEAPON        = 0x00000200,   /* 装備武器を非表示 */
	FA_NO_INTERP 	= 0x00000400,	/* モーション補完なし */
	FA_USE_NOW_HEIGHT =	0x00001000,	/* 無理やり今の高さからはじめる */
	FA_ELUDE_FALL_SPECIAL = 0x00002000,	/* エルード落下中特殊 */
	FA_BOX_EXIST =		0x00008000,	/* ダンボール外さない */
	FA_DIRECT_MOVE =    0x00010000,	/* 強制移動用、ゾーンを使用せず一直線に移動する。*/
	FA_STAGESTART =		0x00020000,	/* ステージ開始時の強制モーション／移動であることを明示 */
} ;

//初期方向、終了方向、終了姿勢については、
// -1 を指定することで、強制モーション直前の
//値になります。
//終了時姿勢 ： ０−立ち、１−しゃがみ、２−匍匐
//終了時姿勢に ４ を指定すると、終了後ビヨンドモード
//			   １１ を指定すると、終了後水中モード
//以下のdefineを使うとよい。

#define	FA_END_STAND 		0
#define	FA_END_SQUAT		1
#define	FA_END_GROUND		2
#define	FA_END_ELUDE		4
#define	FA_END_DOWN_FACE	5	//うつぶせダウン
#define	FA_END_DOWN_BACK	6	//あおむけダウン
#define	FA_END_SWIM		11

//「エルード落下中特殊」は、
//エルード再つかまりのときのみの使用とする。

command	強制モーション終了プロック[NewForceActEndProc] \
	-motion $i:モーション番号 \
	-proc $p:プロック \
	-args $i:引数 ...

//強制モーションが終了したときに呼ぶプロックを設定できます。
//モーション番号の設定がない場合には、直後の強制モーション終了時に
//呼ばれます。
//プロックの第一引数には、下に記述する「モード」が入ります。
//このプロックは一度実行されるとクリアされるので、
//毎回呼ぶ場合には、その都度設定しなおす必要があります。
//引数は４つまで指定できます($2〜$5で取得できます)

command 強制モーションプロック[NewForceActProc] \
	-proc $p:プロック \
	-exec { $:Ｘ位置 $:Ｙ位置 $:Ｚ位置 $:経過時間 $:モード $:状態 } \
	-flag $i:フラグ

// -proc と -exec はどちらか一つ
// -flag に 0x0001 を指定すると、強制モーション中毎フレーム実行されるようになる。
// -flag に 0x0002 を指定すると、終了時にも実行されるようになる。
//                               強制モーション終了プロック」と共存はできない。
//このプロックは強制が終了するとクリアされる。
//
//状態は、入る、いる、出るの３つ

//強制モーションプロックと強制モーション終了プロックの
//適用範囲は、現在、

//・強制モーション
//・強制移動
//・強制姿勢変更
//・はしごつかまり／離し
//・エルード入りモーション／出るモーション発動／落下

//です。

//プロックに渡される引数の「モード」は、
//以下のようになっています。

#enum {
	FA_PROCMODE_MOTION 		= 0,		//強制モーション
	FA_PROCMODE_RUN    		= 1,		//強制移動
	FA_PROCMODE_STANCE 		= 2,		//強制姿勢変更
	FA_PROCMODE_LADDER_IN 	= 3,		//はしごつかまり
	FA_PROCMODE_LADDER_OUT 	= 4,		//はしご離し
	FA_PROCMODE_ELUDE_IN 	= 5,		//エルード開始
	FA_PROCMODE_ELUDE_OUT 	= 6,		//エルード戻り
	FA_PROCMODE_ELUDE_FALL 	= 7			//エルード落下開始
} ;

command 強制モーションキャンセル[NewForceActCancel]

command 強制モーションループ回数設定[PL_COM_SetForceActLoop] \
	-loop $i:ループ回数
//強制モーションのループ回数を設定する。
//強制モーションメッセージの直後に記述してください。
//無限回数設定というのはないので、かなり大きな数を設定することで
//対処してください。
//「強制モーションキャンセル」で終了させてください。

//-------- 強制姿勢制御

command プラグイン姿勢制御[NewPluginStance]

mesg プレイヤー $s:名前 stance[10] \
	$i:姿勢 \
	$i:初期方向 \
	$i:終了方向 \
	$i:フラグ
//各パラメータの意味は強制モーション設定と同じ

//-------- 強制移動

command プラグイン強制移動[NewPluginForceRunMove]

mesg プレイヤー $s:名前 run[12] \
	$i:目標Ｘ $i:目標Ｙ $i:目標Ｚ \
	$w:モーション \
	$w:終了方向 \
	$i:フラグ \
	[$p:終了プロック]

//各パラメータの意味は強制モーション設定と同じ
//フラグに関しては、以下が有効
//	FA_NO_WEAPON
//	FA_NO_CHECK_SEG
//	FA_NO_CHECK_FLR
//	FA_NO_CHECK_TRP
//	FA_NO_RECHECK_TRP
//  FA_DIRECT_MOVE
//	FA_NO_INTERP

//モーションは、
//０：立ち歩き、１：立ち走り、２：立ちダッシュ（廃止）
//３：匍匐前進、４：匍匐前進（速）５：ダンボール
//−１ ： 今のままで
//匍匐の時、壁のめり込み回避はできないので注意。

//-------- 強制位置セット
mesg プレイヤー $s:名前 position[1] \
	$i:位置Ｘ $i:位置Ｙ $i:位置Ｚ

mesg プレイヤー $s:名前 position2[2] \
	$w:軸 $i:位置 [$w:軸 $i:位置 $w:軸 $i:位置]
// position2は、軸ごとの移動（Ｘ軸のみ、など）
// 軸 ： ０／１／２ ： Ｘ軸／Ｙ軸／Ｚ軸

mesg プレイヤー $s:名前 rotate[14] $w:方向

//-------- エルード設定
mesg プレイヤー $s:名前 beyond[3] \
	$b:静止モーション \
	$b:移動モーション右 \
	$b:移動モーション左 \
	$b:戻りモーション \
	$b:床チェックする関節番号 \
	$w:開始時向き \
	$w:終了時向き \
	$i:フラグ \
	[$b:戻りモーション（壁有り） \
	 $b:戻り時に壁チェックする関節番号（省略時は右膝）\
	 $b:静止モーション（疲れ）]

//パラメータ数がオーバーしてしまったので
//command にします。
command エルード設定[NewSetEludeParam] \
	-values $b:静止モーション \
			$b:移動モーション右 \
			$b:移動モーション左 \
			$b:戻りモーション \
			$b:床チェックする関節番号 \
			$w:開始時向き \
			$w:終了時向き \
			$i:フラグ \
			$b:戻りモーション（壁有り） \
			$b:戻り時に壁チェックする関節番号（省略時は右膝）\
			$b:静止モーション（疲れ） \
			$b:落下モーション（落ちはじめ） \
			$b:落下中モーション \
			$b:落下してダメージ \
			$b:落下して死亡 \
			$b:落下しても無事着地 \
			$b:撃たれダメージ \
			[$b:懸垂開始 \
			 $b:懸垂静止 \
			 $b:懸垂終了]

//※※強制モーション用mar必須！！
//
//フラグ定義
//
#enum {
    BY_CHECK_FLOOR = 		0x00000000,	/* 床からエッジ検出（廃止） */
    BY_CHECK_SEGMENT = 		0x00000001,	/* 壁からエッジ検出（廃止） */
    BY_NOFOOTSHADOW = 		0x00000002,	/* 足影なし */
	BY_FALL_DEAD =			0x00000004,	/* 落ちたら死ぬぜ */
	BY_CANNOT_FALL =		0x00000008,	/* パッド操作での落下禁止 */
	BY_NO_STAMP =			0x00000010,	/* ふみつけなし（低いエルードなど） */
	BY_FALL_IMMEDIATELY = 	0x00000020,	/* すぐ降りエルード */
	BY_NO_MOVE_LR =			0x00000040,	/* 左右移動なし */
	BY_DEC_GRIP_FAST =		0x00000080,	/* グリップ減少速度大 */
	BY_RESET_HEIGHT =		0x00002000,	/* 戻り時高さ補正 */
	BY_NO_RETURNSTAMP =		0x00004000,	/* 戻り時踏み付けなし */
} ;

command エルード移動範囲設定[NewSetEludeRange] \
	-x_range $i:Ｘ最小 $i:Ｘ最大 \
	-z_range $i:Ｚ最小 $i:Ｚ最大

//※エルード設定の後に記述すること

mesg プレイヤー $s:名前 beyond_trap[4] $s:トラップ名

//-------- 強制吹っ飛ばし

command プラグイン強制吹っ飛ばし[NewPluginSuperBlow]

mesg プレイヤー $s:名前 superblow[19] \
	$i:ダメージ値 \
	$i:初速度Ｘ $i:初速度Ｙ $i:初速度Ｚ

//ハリアー戦専用
//どんな状態であろうとも真上にふっとばす。

//-------- はだか

command はだかモードセット[PL_COM_SetNudeMode]

//はだか制限つきプレイヤーモードにする
//プレイヤー起動前に実行すること

//-------- 水中モード

command プラグイン水中[NewPluginWaterModeTest]

command 水中設定[NewWaterModeSettingTest] \
	-horizon $i:水平面高さ \
	-motion $s:モーションファイル

command 新プラグイン水中[NewPluginWaterMode] \
	-zone_group $i:カメラ追従用ゾーンのグループ番号 \
	-height $i:カメラ追従高さ（デフォルト１６５０）

command 新水中設定[NewWaterModeSetting] \
	-horizon $i:水平面高さ \
	-motion $s:モーションファイル \
	-elude2water $i:エルード落下から水中にはいる時のモーション番号 \
	-dead2water $i:エルード死亡落下で水中に入った時のゲームオーバーモーション番号 \
	-flag $i:フラグ

//$i:エルード落下から水中にはいる時のモーション番号 は、
//chara プレイヤー に設定する強制モーションファイルの中の番号。
//ここの、-motion $s:モーションファイル 内の番号ではないので注意！

mesg プレイヤー $s:名前 water[11] $s:モード $i:モーション番号 $i:開始方向 \
			[$i:開始Ｘ位置 $i:開始Ｚ位置 $i:開始Ｙ位置]

//モードに設定する行動種類
//入る			: 強制モーションで水に入る
//出る			: 強制モーションで水から入る
//水底から		: 水底立ちからスタート。モーション番号は無視。
//				  出入り時プロックは呼ばれません。
//水中から		: 水中泳ぎ静止姿勢からスタート。モーション番号は無視。
//				  出入り時プロックは呼ばれません。
//水面から		: 水面立ち泳ぎからスタート。モーション番号は無視。
//				  出入り時プロックは呼ばれません。
//階段入る		: 階段走りで入る。モーション番号の欄に移動距離を設定してください。
//階段出る		: 階段走りで出る。モーション番号の欄に移動距離を設定してください。

command 水中出入り時プロック[PL_COM_SetProcWaterInOut] \
	-in_proc $p:入り開始 $p:入り完了 \
	-out_proc $p:出る開始 $p:出る完了
//新プラグイン水中コマンドの後に設定すること

//フラグ定義
#enum {
	WATER_FLAG_NORMAL		= 	0x0000,
	WATER_FLAG_AUTO_ROTATE	=	0x0001,		//角度自動調節機能付き
	WATER_FLAG_NO_ZONE_TRACE =	0x0002,		//ゾーンを使用した追従をしない
	WATER_FLAG_NO_FLOOR		=	0x0004,		//底なし（w11)
} ;

chara 息継ぎポイント管理[NewBreathPointManager] $s:名前

command 息継ぎポイント登録[NewAddBreathPoint] \
	-position $v:座標

chara 水中機雷[NewWaterMine] $s:名前 \
	-map $s:マップ名 \
	-position $v:位置 \
	-rotate $v:回転 \
	-rOute $i:ルート番号 \
	-speed $i:移動スピード \
	-pRoc $p:終了プロック

//終了プロックの引数は
// $1 : 名前
// $2 : 状態（０：未爆破、１：爆発済）

chara 水中エマ[NewEESwim] $s:名前 \
	-model $s:モデル名 \
	-moTion $s:モーション名 \
	-start_mode $i:初期状態 \
	-life $i:現在値 $i:最大値 \
	-o2 $i:最大値 \
	-card $f:カードあり／なし \
	-force_act_motion $s:強制モーション用モーションファイル \
	-procs $p:プロック ...

//-card 
//オプション無し OR -card 1 ： カードあり
//-card 0 					： カードなし

//初期状態 ：
//		0 : off状態
//		1 : くっつき状態

//プロック
//１：	エマ死亡時プロック

mesg 水中エマ $s:名前 on[0]		//処理開始
mesg 水中エマ $s:名前 off[1]	//処理停止＆非表示
mesg 水中エマ $s:名前 position[2] $i:方向 [$i:軸 $i:位置 $i:軸 $i:位置 $i:軸 $i:位置]
//最初に方向を指定できる他はプレイヤーの position2 と同じ
mesg 水中エマ $s:名前 motion[3] $i:モーション番号 $i:終了時モード \
		$p:開始時プロック $p:終了時プロック $i:フラグ

//水中エマ強制モーション
//水中に入る／出る時に使用する。
//終了時モード :
//		0 : 水面立ち泳ぎしがみつき
//		1 : off状態にする

mesg 水中エマ $s:名前 wt_door[4]
mesg 水中エマ $s:名前 階段入出[5]

command 水中エマライフセット[EE_COM_SetLife] -v $i:ライフ値
command 水中エマライフゲット[EE_COM_GetLife]
command	水中エマＯ２ゲット[EE_COM_GetO2]

//-------- ロッカーモード
mesg プレイヤー $s:名前 locker[5] \
	$s:ロッカーの名前 $i:そのロッカーの状態 \
	$w:外からロッカーに正対した方向 $w:方向幅 \
	[$i:ロッカー位置Ｘ $i:ロッカー位置Ｚ]

//-------- 水密ドアモード
mesg プレイヤー $s:名前 wt_door[6] \
	$s:水密ドアの名前 $i:そのドアの状態 \
	$w:ドアに正対した方向 $w:方向幅 \
	$i:ドア位置Ｘ $i:ドア位置Ｚ \
	[$f:開け方向]

//開け方向 ０：引き １：押し 省略時は「引き」

//-------- はしごモード

//強制モーションｍａｒ必須！！

command プラグインはしご[NewPluginLadder]

command はしご設定[NewSetupLadder] \
	-limit	$i:はしご下限 $i:はしご上限 \
	-basic  $b:はしご静止モーション右手上 \
			$b:はしご静止モーション左手上 \
			$b:はしご登りループ \
			$b:はしご降りループ \
			[$b:はしごダメージ右手上 \
	 		 $b:はしごダメージ左手上 \
			 $b:はしご落下開始右手上 \
			 $b:はしご落下開始左手上 \
			 $b:はしご落下ループ \
			 $b:はしご落下終了] \
	-start  $b:はしご開始モーション \
			$v:はしご開始モーション発動位置 \
			$w:発動時向き \
	-end	$b:はしご終了モーション \
			$v:はしご終了モーション発動位置 \
			$w:終了時向き

mesg プレイヤー $s:名前 ladder[7]

//はしご手モーフィング管理
chara はしごプレイヤー手モーフィング管理[NewLadderPlayerHandMofingManager] $s:名前 \
		-patterns			$b:右パターン数 $b:左パターン数 \
		-right_hand_cv2		$s:右手用パターン ... \
		-left_hand_cv2		$s:左手用パターン ... \
		-timing_r			$i:切り替えタイミング右 ... \
		-tIming_l			$i:切り替えタイミング左 ...

command はしごプレイヤー手モーフィングタイミング設定[NewSetLadderPlayerHandMofingTiming] \
		-timing_r			$i:切り替えタイミング右 ... \
		-tIming_l			$i:切り替えタイミング左 ...

//切り替えタイミングの書き方
//		３つの数で１セット	0,24,2	（モーション番号、フレーム、切り替えパターン）
//		モーション番号の定義：	０：はしご静止モーション右手上
//								１：はしご静止モーション左手上
//								２：はしご登りループ
//								３：はしご降りループ
//								４：はしご開始モーション
//								５：はしご終了モーション

//-------- ベルトコンベア

command プラグインベルトコンベア[NewPluginBeltConveyer]

mesg プレイヤー $s:名前 beltconv[13] \
	$s:乗り場マップ $s:乗り場トラップ台 $s:乗り場トラップベルト $w:乗り向き \
	$s:降り場マップ $s:降り場トラップ台 $s:降り場トラップベルト $w:降り向き \
	[$i:降り場トラップベルトでの待ち時間]

//降り場トラップベルトでの待ち時間
//降りポイントに到着後、この待ち時間の間に降りる方向にパッドを入れると
//ベルトを降りる。-1を指定すると自動で勝手に降りる。（デフォルトは-1）

command ベルトコンベア時プロック設定[NewSetPlayerBeltConveyerProc] \
	-proc $p:プロック

//プロックの$1引数
//0 : 乗り開始 1 : 乗り終了 2:降り開始 3:降り終了
//4 : 降りポイント到着 5:降りポイントで降りずに再稼動時
// $2には降り開始時のみ、トラップ名が入る。

command プレイヤーベルトコンベア上チェック[PL_COM_CheckPlayerOnBelt]
//プレイヤーがベルトコンベア上のとき１を返す

//-------- おまけ

mesg プレイヤー $s:名前 shadow[8] $f:ＯＮ／ＯＦＦ
//影の表示・非表示
//１がＯＮ、０がＯＦＦ

mesg プレイヤー $s:名前 headmark[9]

//-------- プレイヤー関連キャラ

chara ダンボール柄トラップ設定[NewCheckBoxHidden] $s:名前 \
	-name $s:プレイヤーの名前 \
	-traps $i:アイテム番号（equip.h） $s:トラップ名 ...

//[$i:アイテム番号,$s:トラップ名 ] の組み合わせを４つまで指定できます。

//-------- プレイヤー関連コマンド
//PL_COMMAND

mesg プレイヤー $s:名前 menu[3] $s:on／off
// onで表示
// offで非表示

command	PlayerStatus[NewGetPlayerStatus] -f $w:チェックしたい状態 ...
//チェックしたい状態は下記（トラップのプレイヤー状態）と同じ。
//羅列することでＯＲが可能。

command プレイヤー状態取得[NewGetPlayerStateFlag] -d

//上に代わるもの
//実行結果と下記フラグの＆をとるとプレイヤーの状態がわかる

#enum {
	PFLAG_INTRUDE =			0x0008,		/* イントルード */
	PFLAG_SUBJECT =			0x0010,		/* 主観 */
	PFLAG_CAUTION =			0x0020,		/* 張り付き */
	PFLAG_ELUDE =			0x0040,		/* エルード */
	PFLAG_LOCKER =			0x0080,		/* ロッカー*/
	PFLAG_LADDER = 			0x0100,		/* はしご */
	PFLAG_ENEMY_PULL =		0x0200,		/* 死体引き摺り */
	PFLAG_WATER =			0x0400,		/* 水中 */
	PFLAG_BEHIND =			0x0800,		/* ビハインドカメラ中 */
	PFLAG_DIAZEPAM =		0x1000,		/* ジアゼパム中 */
	PFLAG_PEEP_R =			0x2000,		/* 覗き込み右最大 */
	PFLAG_PEEP_L =			0x4000,		/* 覗き込み左最大 */
	PFLAG_BLOOD =			0x8000,		/* 流血 */
	PFLAG_WALK =			0x00010000,	/* 歩き */
	PFLAG_RUN =				0x00020000,	/* 走り */
	PFLAG_BOX =				0x00040000,	/* ダンボール */
	PFLAG_WATER_SURFACE =	0x00080000,	/* 水中モードで、カメラは水面上 */
	PFLAG_NO_BREATH =		0x00100000,	/* 無呼吸状態 */
	PFLAG_SNAKE =			0x00200000,	/* スネークである */
	PFLAG_ROLLING =			0x00400000,	/* ローリング */
	PFLAG_DAMAGED =			0x00800000,	/* ダメージＡＮＤダウン中 */
	PFLAG_ELUDING =			0x01000000,	/* エルード静止ＯＲ左右移動ＯＲ懸垂 */
	PFLAG_SQUAT =			0x02000000,	/* しゃがみ中 */
	PFLAG_GROUND =			0x04000000,	/* ほふく中ＯＲダウン中 */
	PFLAG_ENEMY_HANG =		0x08000000,	/* 首締め中 */
	PFLAG_NIKITA_ALIVE =	0x10000000,	/* ニキータ飛行中 */
	PFLAG_ELUDE_FALL =		0x20000000,	/* エルード落下中 */
} ;

//-dが「ついていない」と、上記フラグのうち
//(PFLAG_DIAZEPAM|PFLAG_PEEP_R|PFLAG_PEEP_L|PFLAG_BLOOD|PFLAG_SNAKE|PFLAG_NIKITA_ALIVE)
//は無視されます。（これらのフラグが欲しいときは-dを「つける」）

command プレイヤーマップ名[NewGetPlayerMapName]
//現在プレイヤーのいるマップのＳＴＲＣＯＤＥを返す

command プレイヤー無敵セット[NewPlayerSetInvincible]
command プレイヤー無敵解除[NewPlayerResetInvincible]

command プレイヤー瞬殺[NewKillPlayer] \
	-name $s:プレイヤー名 \
	-blow 					//これがあると「吹っ飛び」

command プレイヤー死体歩き[NewCorpseWalk]

command プレイヤーモーション振動ＯＦＦ[NewPlayerMotionVibOff]

command プレイヤーライフ値操作[PL_COM_VitalityAdjust] \
	-type $i:タイプ（０：０になれば死ぬ。１：最低１は残る） \
	-mode $i:モード（０：無敵中は減らない（デフォルト）。１：無敵中でも減る） \
	-value $i:調整値

chara プレイヤー主観範囲設定[PL_CHARA_SetSubjectLimit] $s:名前 \
	-range $i:最小角度 $i:最大角度

//左右回転範囲を制限します。０〜４０９５で指定してください。

command プレイヤー不可視[PL_COM_InvisiblePlayer]
command プレイヤー不可視解除[PL_COM_VisiblePlayer]
//シナリオデモ中に、カメラの前にプレイヤーが入るとマズい場合に使ってください。

command プレイヤー死体上立たせ[PL_COM_OnCorpseStand]
//死体上で匍匐していたら立たせる

command プレイヤー張付きはしゃがみだけ[PL_COM_CautionSquatOnly]
//立ちの張付きを禁止します。
//毎フレーム実行してください。（trap ならば 「いる」で実行）

//-------- 主観デモ ------------------------------------------------------

chara	主観デモプレイヤー[NewSubjectDemoPlayer] $s:名前 \
	-kms $s:ＫＭＳモデル \
	-evm $s:ＥＶＭモデル \
	-mar $s:モーションファイル \
	-position $v:初期位置 \
	-rotate $v:初期方向

//通常プレイヤーとの共存は不可
//Ｘ角度は、-1023〜1023の間で指定すること。

mesg 主観デモプレイヤー $s:名前 position[0] $i:Ｘ位置 $i:Ｚ位置 [$i:Ｙ位置]

mesg 主観デモプレイヤー $s:名前 rotate[1] $i:Ｘ角度 $i:Ｙ角度 [$i:強制モード]	//-1で無視

mesg 主観デモプレイヤー $s:名前 motion[2] $i:モーション番号 $i:動作
//$i:動作
//	0	:	モーションをリピート
//	1	:	モーションが終了したら、その状態で止める
//	2	:	モーションが終了したら、０番モーションになり、その後０番をリピート

mesg 主観デモプレイヤー $s:名前 ry_limit[3] $i:左回転限界 $i:右回転限界
//主観カメラの左右の振り角度の限界を相対角度で設定する。
//たとえば、左に９０度、右に４５度までは回れる場合、
//ry_limit 1024 512
//と書けばいい。負の値を設定しないこと。
//デフォルトは、 1024 1024

mesg 主観デモプレイヤー $s:名前 rx_limit[4] $i:下回転限界 $i:上回転限界
//主観カメラの上下の振り角度の限界を相対角度で設定する。
//デフォルトは、 640 800

//-------- ロッカー ------------------------------------------------------

chara ロッカー管理[NewLockerDaemon] $s:名前 \
	-n_lockers $w:ロッカー最大数 \
	-type $f:ロッカータイプ（廃止）

command ロッカーモーション[NewSetLockerMotion] \
	-motion $s:ロッカー開閉モーション

command プレイヤーロッカーモーション[NewSetPlayerLockerMotion] \
	-motion $s:プレイヤーのロッカー開閉モーション

chara ロッカー[NewLocker] $s:名前 \
	-kms $s:モデル \
	-body $s:箱モデル（省略すると扉のみ） \
	-position $v:位置 \
	-rotate $v:回転 \
	-down_rot $v:倒れたときの角度 \
	-doWn_shift $v:倒れたときのシフト量 \
	-state $i:初期状態 \
	-loAd_state $i:前回の状態（上の初期状態よりこちらを優先） \
	-code $w:ドア動作ＳＥコード $w:ドア閉まるＳＥコード（廃止） \
	-flag $i:フラグ \
	-light $s:影ＩＤ（スポットライト名） \
	-name_of_spotlight $s:対応スポットライト名（廃止） \
	-exec { $:トリガ $:実行キャラ $:行動 } \
	-prOc $p:呼び出しプロック \ //$:トリガ $:実行キャラ $:行動 $:ロッカー名前 \
	-seNo $i:壁音番号 \
	-seFloor $i:倒れ時床音番号 \
	-gravure $v:キス音発生範囲最小 $v:キス音発生範囲最大 \
			 $v:胸範囲最小 $v:胸範囲最大 \
			 $v:秘所範囲最小 $v:秘所範囲最大

//フラグ
#define	LOCKER_FLAG_SHADOWDROP	0x0001 	//扉の影が投影される（廃止）
#define	LOCKER_FLAG_SELFSUBJECT	0x0002	//内部でもオートで主観にはならない（廃止）
#define	LOCKER_FLAG_SHADOWWRITE	0x0004	//扉に影が投影される
#define	LOCKER_FLAG_DOWNOUTSIDE 0x0008	//開かないが、扉がこわれたときは外側に倒れる
#define	LOCKER_FLAG_TOILET		0x1000	//トイレである

//-code を省略するとデフォルトのコードが使われる。

//-exec と -prOc はどちらか一つ。
//$1に開始時／終了時 = 1／0 が入る。
//$2は実行キャラクタ名
//$3は以下の通り
//$4はロッカーの名前
//  0:外から開けた
//  1:外から閉めた
//  2:内から開けた
//  3:内から閉めた
//  4:壊れて開いた
//  5:死体を入れて閉める
//  6:内部でコンコンした
//	7:壊れた（壊れた開いたときは、4番と同フレームで呼ばれる）
//	8:ステージ終了時
//	9:傾いた

//開けられる向きとは、プレイヤーがそのロッカーに正対したときの
//プレイヤーの向き。

//初期状態は以下の値で指定
#enum {
    LOCKER_STATE_CLOSE =        0x0001, /* しまっている */
    LOCKER_STATE_OPEN =         0x0002, /* 開いている */
    LOCKER_STATE_CORPSE_IN = 	0x0020,	/* 死体が入っている */
    LOCKER_STATE_ENEMY_IN = 	0x0040, /* 気絶兵が入っている */
	LOCKER_STATE_BROKEN =		0x2000,	/* 壊れている */
    LOCKER_STATE_DESTROY =		0x4000,	/* 開けられない／閉められない */
	LOCKER_STATE_POSTER =		0x00010000,	/* ポスターあり */
	LOCKER_STATE_NO_OPEN_SEG =	0x00040000	/* 開いているときの扉プレイヤーあたりなくす */
} ;

//呼び出しプロックの引数は検討中
//次のパターンを数字で返すといいかも。

//プレイヤー外から開ける／閉める
//プレイヤー中から開ける／閉める
//プレイヤー気絶兵入れる／死体入れる
//敵兵クリアリング時開ける／閉める
//敵兵中から開ける
//死体ｏｒ気絶兵中から転がり出てくる

mesg ロッカー $s:名前 open[ 0 ] $s:操作キャラ $f:外／内＝０／１ [$b:モーション]
mesg ロッカー $s:名前 close[ 1 ] $s:操作キャラ $f:外／内＝０／１ [$b:モーション]
mesg ロッカー $s:名前 put_enemy[ 2 ]
mesg ロッカー $s:名前 put_corpse[ 3 ]
mesg ロッカー $s:名前 open_end[ 4 ]
mesg ロッカー $s:名前 close_end[ 4 ]
mesg ロッカー $s:名前 rotate[ 5 ] $i:手の位置Ｘ $i:手の位置Ｚ $i:下駄
mesg ロッカー $s:名前 rotate2[ 6 ] $w:相対回転角度

//指定ロッカーの状態（開いている、しまっているなど）
command ロッカー状態[NewLockerStatus] -n $s:名前

// 結果の見方
// $status & 0x0001	: 閉じている
// $status & 0x0002	: 開いている
// $status & 0x2000 : 扉が外れている

//つながりロッカー
command ロッカー接合[NewLockerConnection] \
	-connection $s:プレイヤーが中に入った状態で右側に当たるロッカー \
	       	 	$s:プレイヤーが中に入った状態で左側に当たるロッカー
//ロッカー接合指定は、1ステージに４つまで

//-------- 水密ドア  -----------------------------------------------------

chara 水密ドア管理[NewWatertightDoorManager] $s:名前 \
	-n_doors $b:最大ドア数 \
	-motions $s:プレイヤーモーション $s:ドアモーション $s:ハンドルモーション \
	-seNo $b:ノック音番号 \
	-adjusts $i:左軸ドア引き時プレイヤー位置調整Ｘ \
		     $i:左軸ドア引き時プレイヤー位置調整Ｚ \
			 $i:左軸ドア押し時プレイヤー位置調整Ｘ \
		     $i:左軸ドア押し時プレイヤー位置調整Ｚ \
			 $i:右軸ドア引き時プレイヤー位置調整Ｘ \
		     $i:右軸ドア引き時プレイヤー位置調整Ｚ \
			 $i:右軸ドア押し時プレイヤー位置調整Ｘ \
		     $i:右軸ドア押し時プレイヤー位置調整Ｚ

//motions指定がない場合はプログラムで動かす

chara 水密ドア[NewWatertightDoor] $s:名前 \
	-kms $s:ハンドル無しモデル $s:ハンドルモデル \
	-position $v:位置 \
	-rotate $v:回転 \
	-type $f:ドアタイプ \	  //０：左軸 １：右軸 省略時は０
	-exec { $:トリガ $:実行キャラ } \
	-prOc $p:呼び出しプロック \ //$:トリガ $:実行キャラ
	-flag $i:フラグ \
	-seNo $b:ノック音番号 \
	-hazard $v:プレイヤー当たり壁点１ $v:プレイヤー当たり壁点２

//execのコールされるタイミングとトリガ
// 開け終わったとき     ： トリガ ０
// 取っ手をつかんだとき ： トリガ １
// 取っ手を離したとき   ： トリガ ２
// 開き始めのとき		： トリガ ３
// 閉まりきったとき		： トリガ ４

//フラグ
#enum {
	WT_DOOR_FLAG_NORMAL		= 0x0000,
	WT_DOOR_FLAG_NOT_OPEN	= 0x0001,	//開かない
	WT_DOOR_FLAG_OPEN_START = 0x0002	//開いた状態からスタート
} ;


mesg 水密ドア $s:名前 hold[ 0 ] $s:操作キャラ [$i:ハンドルモーション番号]
mesg 水密ドア $s:名前 rotate[ 1 ] $w:回転角度（相対）	//廃止
mesg 水密ドア $s:名前 open[ 2 ] 						//シナリオで開ける（モーション不使用）
mesg 水密ドア $s:名前 hold_end[ 3 ]
mesg 水密ドア $s:名前 open_end[ 4 ] $s:操作キャラ
mesg 水密ドア $s:名前 rotate2[ 5 ] 						//廃止
mesg 水密ドア $s:名前 door_rotate[ 6 ] 					//廃止
mesg 水密ドア $s:名前 door_rotate2[ 7 ] 				//廃止
mesg 水密ドア $s:名前 door_rotate3[ 8 ] 				//廃止
mesg 水密ドア $s:名前 open_start[ 9 ] $s:操作キャラ [$i:ドアモーション番号]
mesg 水密ドア $s:名前 not_open[ 10 ] $s:操作キャラ [$i:ハンドルモーション番号]
mesg 水密ドア $s:名前 close[ 12 ] 	//ドアを閉める
mesg 水密ドア $s:名前 handle[ 13 ] $f:on／off	// onで表示 offで非表示

//指定ドアの状態を返す
command 水密ドア状態[NewWatertightDoorStatus] -n $s:名前

//プレイヤーの水密ドア時
//手モーフィング管理
chara 水密ドアプレイヤー手モーフィング管理[NewWtDoorPlayerHandMofingManager] $s:名前 \
		-patterns			$b:右パターン数 $b:左パターン数 \
		-right_hand_cv2		$s:右手用パターン ... \
		-left_hand_cv2		$s:左手用パターン ... \
		-timing_r			$i:切り替えタイミング右 ... \
		-tIming_l			$i:切り替えタイミング左 ...

//切り替えタイミングの書き方
//		３つの数で１セット	0,24,2	（モーション番号、フレーム、切り替えパターン）
//		モーション番号の定義：	０：取っ手まわし（正面）
//								１：掴んで引く（左軸）
//								２：掴んで押す（左軸）
//								３：掴んで引く（右軸）
//								４：掴んで押す（右軸）
//								５：取っ手まわし（裏面）
//								６：開けられない

command 水密ドアハンドル２回転時プロックコール[PL_COM_WtDoorHandle2TurnProc] \
	-proc $p:プロック
//一度プロックが呼ばれるとプロックはリセットされます。

//-------- 自動ジャンプ --------------------------------------------------

command プラグイン自動ジャンプ[NewPluginAutoJump]

command 自動ジャンプ設定[NewAutoJumpSetting] \
	-motions $i:ジャンプアップ \
			 $i:ジャンプダウンスタート \
			 $i:ジャンプダウンループ \
		   	 $i:ジャンプダウンエンド \
		     [$i:ジャンプアップ張り付きから] \
	-trap $s:処理をするトラップ名（省略するといつも処理する） \
	-climb_height $i:登れる高さ $i:高さ幅 \
	-dir $w:登り降り角度 \
	-flag $i:フラグ \
	-proc $p:プロック	//$:動作

// motions は強制モーションmar内でのモーション番号
// $:動作 は 0:登り開始 1:登り終了 2:降り開始 3:降り終了
// 登り降り角度が指定してあると、ジャンプ時に、
// 指定dirと指定dir+2048のうち、近いほうを向く

command 自動ジャンプ角度[NewSetAutoJumpDir] -dir $w:角度
//上の登り降り角度設定のみ版


// フラグ
// 0x0001	:	前方に壁があったらジャンプしない

//-------- 落とし穴 --------------------------------------------------

chara 崩落床[NewFallFloor] $s:名前 \
	-position $v:位置 \
	-rotate $v:方向 \
	-mAp $s:マップ名 \
	-model $s:モデル名 ... \
	-mOtion $s:落下モーションファイル名 $i:落下モーション番号 \
	-hazard $v:床座標 ... \
	-seNo $i:床ＳＥ番号 \
	-status $f:状態（０／１：落ちる前／落ちた後） \
	-fall_time $i:キャラが乗ってから落ちるまでの時間（フレーム数（自動ＰＡＬ化）） \
	-fall_paTtern $i:落ちパターン（０〜７、−１でランダム） \
	-se_Pattern $i:ＳＥパターン（０〜１） \
	-pRoc $p:崩落開始時プロック（誰かが乗って落下のときコール） \
	-faLl_proc $p:崩落開始時プロック（どんな落下でもコール）
	
//-model モデル名 赤外線用モデル名
// を指定して下さい。指定しない場合は赤外線ゴーグルを装備しても映りません。
//
//-motion の指定がないときは適当に落ちる
//崩落開始時プロックの$1に崩落させたキャラ名が入る。
//（メッセージで落ちたときは０が入る。）
//-se_pattern 落ちる時の音がかわる
//-fall_pattern 落ちかたの指定
//          0 :左前端 以下1点がついた状態のように
//          1 :右前端
//          2 :左後端
//          3 :右後端
//          4 :左端   以下蝶番のように
//          5 :前端
//          6 :後端
//          7 :右端

mesg 崩落床 $s:名前 fall[0]

//崩落床の状態取得
command 崩落床状態取得[Command_GetFallFloorStatus] \
	-name $s:名前

//0: 誰も乗ったことがない
//1: 誰かが一度のってへこんでいる
//2: すでに落ちている

command プラグイン落下[NewPluginFall]

mesg プレイヤー $s:名前 fall[16] \
	$i:落下開始モーション \
	$i:落下ループモーション \
	$i:落下終了モーション \
	$i:落下終了高さ \
	$i:フラグ $p:落下開始プロック $p:落下終了プロック

//強制モーションmar内に落下セットを持っておく。
//落下終了モーションをつけない場合は、落下終了高さまで
//落下したら終了する。

//フラグ
// 0x0001 :	落ちてもゲームオーバーじゃない
// 0x0002 : 足影ＯＦＦ
// 0x0004 : 落下開始モーションはループモーションと同じ（開始モーション無し）
// 0x0008 : 「うわー」言わない
// 0x0010 : 落下終了高さに達したら即座にゲームーオーバー画面に行く

//-------- ベルトコンベア --------------------------------------------------

command ベルトコンベア管理[NewBeltConveyerManager] \
	-n $i:ベルト最大数 \
	-lamp $s:ランプキャラの名前 $i:ランプの数

command ベルトコンベア登録[NewSetBeltConveyer] \
	-trap $s:トラップ名 \
	-route $i:キャラクタルート番号 $i:ルート内ポイント番号０ $i:ルート内ポイント番号１ \
	-next $i:次のキャラクタルート番号 $i:次のポイント番号 \
	-speed $i:移動スピード \
	-chara $s:対象キャラ \
	-item $i:アイテム番号 \
	-area $i:エリア番号（環境ＳＥ設定に使用）

//-trapで指定した、トラップ内のオブジェクトを
//-routeで指定したポイント１まで移動させる。
//移動ベクトルは、ポイント０→ポイント１

//-nextの、次のキャラクタルートとポイントとは、
//ポイント１に到達した後に向かうポイントのこと。
//指定が無い場合は、ポイント１と同じルートの次のポイントが
//指定される。

//対象キャラは省略可能。
//対象キャラを変えた別ルートを設定することで、分岐させられる。
//アイテム番号は、charaがプレイヤーとみなされる場合のみ有効。
//被っているダンボールによってルートを変えられる。

command ベルトコンベア動作[NewSetBeltConveyerMode] \
	-move [$i:加速時間（秒）] \			//動かす
	-stop [$i:減速時間（秒）]			//停止する
//-move と -stop はどちらか一つ
//加速時間を設定すると、その時間で最高速に達する。
//減速時間を設定すると、その時間で減速して停止する。

command ベルトコンベア荷物管理[NewBeltObjectManager]

chara	ベルトコンベア荷物[NewBeltObject] $s:名前 \
	-model $s:モデル名 \
	-break_model $s:壊れモデル（省略または０指定で壊れモデルなし） \
	-type $i:種別（０：紙箱、１：鉄箱） \
	-position $v:位置 \
	-rotate $v:回転 \
	-flag $i:フラグ

//壊れモデル
//指定があると、爆発を受けたらモデル切り替え
//指定がないと、爆発を受けたらモデル消し

//種別の違い
//紙箱 ： 跳弾しない。弾痕がつく。紙破片がでる。
//鉄箱 ： 跳弾する。弾痕がつく。破片がでない。

//フラグ定義
#enum {
	BELTOBJ_FLAG_C4 = 1			//解体Ｃ４がくっつく
} ;

mesg ベルトコンベア荷物 $s:名前 position[0] $i:Ｘ位置 $i:Ｙ位置 $i:Ｚ位置
mesg ベルトコンベア荷物 $s:名前 map[1] $s:マップ名

command トラップ内荷物チェック[NewBeltObjCheckInsideTrap] \
	-map $s:マップ名 \
	-trap $s:チェックするトラップ名

chara ベルトコンベアベルト[NewBeltConveyerBelt] $s:名前 \
	-model $s:モデル名 \
	-texture $s:テクスチャ名 \
	-position $v:開始位置 $v:終了位置 \
	-speed $i:移動スピード \
	-stAtus $i:初期状態（０：停止、１：動作）

//ベルトを動かす
mesg ベルトコンベアベルト $s:名前 start[0]

//ベルトを止める
mesg ベルトコンベアベルト $s:名前 stop[1]

//ベルトコンベア状態取得
// ０：稼動中、１：停止中
command ベルトコンベア状態取得[PL_COM_GetBeltConvStatus]

//-------- エレベータ --------------------------------------------------

command プラグインエレベータ[NewPluginElevator]

mesg プレイヤー $s:名前 evpanel[15] $s:入る／出る $i:方向

//エレベータ内でのパネル操作プラグインです。
//仕様：
//	エレベータ内部にプレイヤーしかいない状態でかつ
//	危険モードでなければ、パネル操作モードに入ることができる。
//	パネル操作モード中に、危険モードになるが、エレベータ内に敵が入ってくると
//	強制的にパネル操作モードを抜ける。

chara エレベータ[NewElevator] $s:名前 \
	-map $s:マップ名 \
	-tYpe $i:種類 \ // 0（１Ｆ・Ｂ１・Ｂ２） 1（１Ｆ・Ｂ１）
	-floor $i:パネルが最初に光っている階数 \ // 上から順に、0,1,2
	-door1 $s:モデル名１ $v:位置１ $i:方向１ $i:スライド距離１ $i:開閉時間１ \
	-dOor2 $s:モデル名２ $v:位置２ $i:方向２ $i:スライド距離２ $i:開閉時間２ \
	-wall $v:扉透明壁位置１ $v:扉透明壁位置２ $i:扉透明壁高さ \
	-close_time $i:開ききってから閉まるまでの時間（秒）\
	-trap $s:エレベータ箱トラップ名 $s:パネル操作トラップ名 \
	-cAmera $v:パネルカメラ位置 $v:パネルカメラ注視点 \
	-panel_proc $p:パネル操作決定時プロック \
	-npc_name $s:ＮＰＣの名前 \
	-paneL_chara_name $s:パネル制御キャラの名前 \
	-seNo $b:音番号 \
	-laMp_chara_name $s:ドアランプキャラの名前

//エレベータ仕様
//
//openメッセージが来ると、指定した時間（指定がない場合はランダム）経つと開く。
//開いている状態で、エレベータの中に誰かいるときは閉まらない。
//指定時間経過後、中に誰もいないときは閉まる。
//closeメッセージが来ると、強制的に閉まる。
//パネル操作決定時プロックの$1に、どれを決定したかが入る。

mesg エレベータ $s:名前 open[0] $i:開くまでの時間 $p:開き開始時プロック $p:開き終了時プロック
//開くまでの時間に負数を指定すると、ランダムになります。

mesg エレベータ $s:名前 close[1] $p:閉まり開始時プロック $p:閉まり終了時プロック
//強制的に閉めます。普段は使わないでしょう。

mesg エレベータ $s:名前 stagestart[2]
//ステージ開始時にパネルモードから始めるとき、これを送信

mesg エレベータ $s:名前 alwaysopen[3]
//開きっぱなしにする。
//closeメッセージでなら閉めることが出来る。

mesg エレベータ $s:名前 loadclose[4] $p:閉まり開始時プロック $p:閉まり終了時プロック
//閉めたあとロードする場合には、closeでなくこちらを使ってください。

command エレベータ状態取得[PL_COM_GetElevatorStatus]
//エレベータの状態を取得
//0 : 閉じている
//1 : 開き中、または開き待ち中
//2 : 閉じ中
//4 : 開いている

//-------- くしゃみ --------------------------------------------------

command プラグインくしゃみ[NewPluginSneeze]

command プレイヤー風邪引かせ[NewPlayerSetCold] \
	-time $i:くしゃみ間隔（秒）

command プレイヤー風邪治し[NewPlayerRecoverCold]
command プレイヤーくしゃみ発動[PL_COM_Sneeze]

//-------- ブレード --------------------------------------------------

command プラグインブレード[NewPluginBlade] -motion $s:モーションファイル

//-------- 影縛り --------------------------------------------------

command プラグイン影縛り[NewPluginKageshibari]
mesg プレイヤー $s:名前 kageshibari[18] $i:時間

//-------- エマと手繋ぎ --------------------------------------------------

command プラグインエマ手繋ぎ[NewPluginGraspEE] -motion $s:モーションファイル

//-------- 透明壁・床 ----------------------------------------------------

chara 透明壁[NewDynamicSegment] $s:名前 \
	-position $i:頂点１Ｘ $i:頂点１Ｙ $i:頂点１Ｚ $i:頂点１高さ \
		  $i:頂点２Ｘ $i:頂点２Ｙ $i:頂点２Ｚ $i:頂点２高さ \
	-attribute $i:アトリビュート \
	-direct \
	-seNo $i:ＳＥ番号 \
	-map $s:マップ名

//透明壁は、defaultで、「壁こんこんならない」「スプレーつかない」「弾痕つかない」
//「レーダー映らない」「敵ＩＫチェックしない」属性が付きます。
// -direct オプションを付けると、このデフォルト設定は無効になります。

chara 透明床[NewDynamicFloor] $s:名前 \
	-position $i:頂点１Ｘ $i:頂点１Ｙ $i:頂点１Ｚ \
		  $i:頂点２Ｘ $i:頂点２Ｙ $i:頂点２Ｚ \
		  $i:頂点３Ｘ $i:頂点３Ｙ $i:頂点３Ｚ \
		  [$i:頂点４Ｘ $i:頂点４Ｙ $i:頂点４Ｚ] \
	-n_points $b:頂点数（３ｏｒ４） \
	-attribute $i:アトリビュート \
	-direct \
	-seNo $i:ＳＥ番号 \
	-map $s:マップ名

mesg 透明壁 $s:名前 kill[0]
mesg 透明壁 $s:名前 on[1]
mesg 透明壁 $s:名前 off[2]
mesg 透明壁 $s:名前 move[3] $i:頂点１Ｘ $i:頂点１Ｙ $i:頂点１Ｚ $i:頂点１高さ \
	 	  	    $i:頂点２Ｘ $i:頂点２Ｙ $i:頂点２Ｚ $i:頂点２高さ
mesg 透明壁 $s:名前 rotate[4] $b:回転モード $i:Ｙ回転
mesg 透明壁 $s:名前 shift[5] $i:シフト量Ｘ $i:シフト量Ｙ $i:シフト量Ｚ

mesg 透明床 $s:名前 kill[0]
mesg 透明床 $s:名前 on[1]
mesg 透明床 $s:名前 off[2]
mesg 透明床 $s:名前 move[3] $i:頂点１Ｘ $i:頂点１Ｙ $i:頂点１Ｚ \
	 	  	    $i:頂点２Ｘ $i:頂点２Ｙ $i:頂点２Ｚ \
	 	  	    $i:頂点３Ｘ $i:頂点３Ｙ $i:頂点３Ｚ \
	 	  	    [$i:頂点４Ｘ $i:頂点４Ｙ $i:頂点４Ｚ]
mesg 透明床 $s:名前 rotate[4] $b:回転モード \
				$i:回転ベクトルＸ $i:回転ベクトルＹ $i:回転ベクトルＺ
mesg 透明床 $s:名前 shift[5] $i:シフト量Ｘ $i:シフト量Ｙ $i:シフト量Ｚ

//回転ベクトルは絶対角度指定
//回転モードについて
//透明壁の場合：０ - 回転中心は頂点１と頂点２の中点
//		１ - 回転中心は頂点１
//		２ - 回転中心は頂点２
//回転ベクトルはＹ成分のみ有効

//透明床の場合：０ - 回転中心は重心
//		１〜４ - 回転中心は頂点１〜４
//		５〜８ - 回転中心は頂点１２頂点２３頂点３４頂点４１の中点


//透明壁属性
#define HZX_SEG_ALL	      0x0000	/* 全ての当たりをチェックする */
#define HZX_SEG_NO_PLAYER     0x0010	/* プレイヤーの当たりチェックをしない */
#define HZX_SEG_NO_ENEMY      0x0020	/* 敵兵の当たりチェックをしない */
#define HZX_SEG_NO_BULLET     0x0040	/* ショットの当たりをチェックしない */
#define HZX_SEG_NO_MISSILE    0x0080	/* ミサイル系の当たり判定をしない */
#define HZX_SEG_NO_C4         0x0100	/* C4爆弾がセットできない */
#define HZX_SEG_NO_RECOIL     0x0200	/* ショットが跳弾しない */
#define HZX_SEG_NO_HARITSUKI  0x0400	/* 張り付かない */
#define HZX_SEG_NO_DISP_RADAR 0x0800	/* レーダーに写らない */
#define HZX_SEG_NO_BULLETHOLE 0x1000	/* 弾痕つかない */
#define HZX_SEG_NO_SPRAY      0x2000	/* スプレーつかない */
#define	HZX_SEG_NO_ENEMY_IK	  0x4000	/* 敵ＩＫチェックしない */
#define	HZX_SEG_NO_ENEMY_EYES 0x00010000	/* 敵兵視線通り抜ける */
#define HZX_SEG_NO_KNOCK_SE   0x00020000	/* 壁コンコンならない */
#define	HZX_SEG_ATR_ALL		0x00f3fff0		/* ここを変えるときはlibhzx.hも変えましょう */

//透明床属性
#define HZX_FLOOR_NO_PLAYER           	0x0010	/* プレイヤーの当たりチェックをしない */
#define HZX_FLOOR_NO_ENEMY            	0x0020	/* 敵兵の当たりチェックをしない */
#define HZX_FLOOR_NO_BULLET           	0x0040	/* ショットの当たりをチェックしない */
#define HZX_FLOOR_NO_MISSILE          	0x0080	/* ミサイル系の当たり判定をしない */
#define HZX_FLOOR_NO_C4              	0x0100	/* C4爆弾がセットできない */
#define HZX_FLOOR_NO_RECOIL           	0x0200	/* ショットが跳弾しない */
#define HZX_FLOOR_NO_CLAYMORE     	0x0400	/* クレイモアがセットできない */
#define HZX_FLOOR_NO_BLOOD            	0x0800	/* 血痕つかない */
#define HZX_FLOOR_NO_BULLETHOLE  	0x1000	/* 弾痕つかない */
#define HZX_FLOOR_NO_SPRAY            	0x2000	/* スプレーつかない */
#define HZX_FLOOR_IK 			0x4000	/* インバース・キネマティクスを適用する */
#define HZX_FLOOR_STEP               	0x8000	/* ここの床は階段である */
#define	HZX_FLOOR_NO_ENEMY_EYES			0x00010000	/* 敵兵視線通りぬける */
#define	HZX_FLOOR_ATR_ALL	0x0003fff0 /* ここを変えるときはlibhzx.hも変えましょう */

//イベント壁
//通常状態でないと通り抜けられない壁
chara イベント壁[NewEventWall] $s:名前 \
	-position $i:頂点１Ｘ $i:頂点１Ｙ $i:頂点１Ｚ $i:頂点１高さ \
			  $i:頂点２Ｘ $i:頂点２Ｙ $i:頂点２Ｚ $i:頂点２高さ
mesg イベント壁 $s:名前 kill[0]

//-------- トラップ ------------------------------------------------------

trap $s:トラップ名 $s:キャラクタ \	//？で全キャラクタ
	-mask $s:入る／出る／いる／？／＊ \
	//設定ブロックを実行するタイミング。？で入る／出るの２つ共（いる以外）。
	-and \				//Andモード
	-dir $w:プレイヤー方向 $w:幅 ... \	//0〜4096、+-512の範囲指定
	-wHich $b:ボタンを見るパッド番号 \ //0が１コン 1が２コン
	-button $w:ボタン ... \		//下記参照
	-key $i:パッド ... \
	-state $w:プレイヤー状態 ... \	//下記参照
	-time $w:ディレイタイム \	//実行までの待ち時間（未対応）
	-item $w:アイテム ... \		//アイテム切り替え時にもチェック
	-weapon $w:武器 ... \		//武器切り替え時にもチェック
	-aLert $b:アラートモード \	//アラートモード切り替え時にもチェック
	-camera \			//カメラトラップであることを明示
	-mIssile \			//ミサイル専用トラップであることを明示
	-mApconnect \		//マップ接合トラップであることを明示
	-proc $p:実行関数 \		// exec、procはどちらか一方
	-exec { $:トラップ名 $:キャラ名 $:トリガ $:X $:Y $:Z }

//mask :
// ？は、「入る／出る」
// ＊は、「いる／出る」をあらわす
//
//...での羅列は、３つまで可能
//<<-and オプションがない場合>>
//３つの or になる。
//たとえば、「立ちかしゃがみの時」という指定は、-state 0,1 で可能
//
//<<-and オプションがある場合>>
//全チェックのAndをORしたチェックになる。（なんだそりゃ）
//たとえば、
//”「立ち状態」で「方向0方向幅256」で「○ボタンが押された時」”または、
//”「張り付き状態」で「方向2048方向幅256」で「ボタンは関係ない」”の
//どちらかが成立する場合、というような指定をしたい時、
//
//  trap 名前 キャラ -mask ＊ \
//	-and \
//	-state  d:TRP_STATE_STAND, d:TRP_STATE_CAUTION \
//	-dir    0,256              2048,256 \
//	-button 0,                 -1
//と記述することで実現できる。

//
//button :
//０：○ １：□ ２：× ３：△
//-keyとの併用は不可。

//key :
//d:PAD_A等で指定できる。
//-button との併用は不可。

//-cameraオプションのついているトラップに引っかかるようにするには
//キャラのCONTROL初期化時に、
//	GM_ConfigControlCameraTrapCheck( CONTROL * )
//をコールする必要があります。

//state 一覧
#enum {
	TRP_STATE_STAND = 0,				//通常立ち状態
	TRP_STATE_SQUAT,					//しゃがみ
	TRP_STATE_GROUND,					//匍匐、ダウン
	TRP_STATE_SUBJECT,					//主観
	TRP_STATE_CAUTION,					//張り付き
	TRP_STATE_ELUDE,					//エルード
	TRP_STATE_FORCE,					//強制モーション、強制走り
	TRP_STATE_LOCKER,					//ロッカー
	TRP_STATE_BEHINDCAMERA_ENABLE,		//ビハインド可能
	TRP_STATE_LADDER,					//はしご
	TRP_STATE_ENEMY_PULL,				//死体引き摺り
	TRP_STATE_WATER,					//水中
	TRP_STATE_BEHIND,					//ビハインドカメラ中
	TRP_STATE_ROLLING,					//転がり中
	TRP_STATE_INTRUDE,					//イントルード中
	TRP_STATE_BOX,						//ダンボール中
	TRP_STATE_WATER_SURFACE,			//水面付近泳ぎ
	TRP_STATE_ELUDE_FALL				//エルード落下中
} ;

// 実行部に渡される引数
// $1:トラップ名 $2:キャラ名 $3:入る／出る／いる
// $4,$5,$6 : キャラの座標(x,y,z)
// $7 : ”出る”種別
//			0 : トラップから出た
//			1 : トラップ内だが、条件不成立により”出た”

//トラップＯＮ／ＯＦＦ切り替え
command トラップ切り替え[NewTrapSwitchCommand] \
	-trap $s:トラップ名 \
	-switch $f:ＯＮ／ＯＦＦ

// 1 : ＯＮ
// 0 : ＯＦＦ

//シナリオトラップ生成
chara シナリオトラップ[NewDynamicTrapScn] $s:名前 \
	-bound $i:最小Ｘ $i:最小Ｙ $i:最小Ｚ \
	       $i:最大Ｘ $i:最大Ｙ $i:最大Ｚ \
	-attribute $i:アトリビュート \
	-map $s:マップ

//アトリビュート
#enum {
 	HZX_TRP_ATR_NO_CHECK = 0x0002	//チェックしない
} ;

//トラップイベント削除
//	シナリオのtrap記述を無効にします。
//	hzx内のトラップを消去するわけではありません。
command トラップ削除[NewRemoveTrapBind] \
	-name $s:トラップ名 ...

//マップチェンジトラップ
command マップチェンジトラップ登録[GM_ComSetMapChangeTrap] \
	-trap $s:トラップ名 \
	-map $s:現在マップ名 $s:変更先マップ名 \
	-chara $s:対象キャラクタ（全キャラの場合は省略）

//-------- ソリダス --------------------------------------------------------

chara ソリダス[NewSolidus] $s:名前 \
	-model $s:モデル名 ... \
	-evm $s:ＥＶＭモデル名 \
	-cv2 $s:ＣＶ２名 ... \
	-moTion $s:モーション名 \
	-position $v:初期位置 \
	-rotate $v:初期方向 \
	-start_mode $i:スタートモード \
	-life $i:初期ライフ $i:ライフ最大 \
	-prOc $p:各種プロック ... \
	-mAp_center $v:マップ中心 \
	-jump_bound $i:ジャンプバウンディング小Ｘ $i:ジャンプバウンディング小Ｚ \
			    $i:ジャンプバウンディング大Ｘ $i:ジャンプバウンディング大Ｚ \
	-flag $i:各種フラグ \
	-caPtion $d:字幕リソース ... \
	-captIontime $i:字幕開始時間 ... 

//各種プロック
//	１：クリア時プロック
//	２：蛇手外し開始
//	３：蛇手外し終了

chara 二体表示カメラ[NewBetweenCamera] $s:名前 \
	-names $s:キャラ１ $s:キャラ２ \
	-position $v:初期カメラ位置 \
	-rotate $v:初期カメラ角度（ＸＹのみ） \
	-track $i:初期カメラ距離 \
	-min_track $i:カメラ最小距離 \
	-bound $v:バウンド最小 $v:バウンド最大 \
	-limit $v:リミット最小 $v:リミット最大 \
	-angle $i:画角×１００

command プレイヤー主観腕壊れ手錠[PL_COM_SubjectArmChain]

//デモ用蛇手
chara デモ蛇手[NewDemoSnakeArm] $s:名前 \
	-model $s:モデル（ＥＶＭ） \
	-mOtion $s:モーションファイル \
	-parent $s:親キャラ名 \
	-unit $i:くっつける関節番号 \
	-pRoc $p:モーション終了プロック \
	-shadow $s:影モデル（ＫＭＳ）

//モーション終了プロックの$1にモーション番号が入ります。
//影モデルを指定すると影がでます。

mesg デモ蛇手 $s:名前 motion[0] $i:モーション番号
mesg デモ蛇手 $s:名前 flow[1] $i:１：オン／０：オフ

command デモ蛇手つかみ位置取得[PL_COM_GetDemoSnakeArmHangPos] \
	$r:Ｘ座標変数 $r:Ｙ座標変数 $r:Ｚ座標変数

//-------- その他 ----------------------------------------------------------

command ＳＥ字幕登録[GM_COM_AddSeJimaku] \
	-seno $i:ＳＥコード \
	-resource $d:字幕リソース

command ボスラッシュモードセット[GM_COM_SetBossSurvivalStatus]
//「ボスラッシュモード状態」をゲームステータスにセット

