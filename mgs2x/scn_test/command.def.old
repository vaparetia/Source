//
// コマンド定義ファイル
//
// $Id: command.def.old,v 1.1 2002/02/01 06:08:31 usr01475 Exp $
//

// システム関数

if ( 式 ) { 実行ブロック } -else { 実行ブロック }
return [$i:返り値]

eval ( 式 )

// デバッグ用

print * ...

// システム起動処理

start

restart -save

// 変数のセーブ
command varsave[NewSaveVariable] [$r:変数名 ...]
// 変数名を省略した場合は全変数セーブ。配列は要素を１つずつ。

// 言語
//あえてアメリカとイギリスを分けてみた（今は中身は一緒） */
#enum {
	LANG_JAPANESE			= 0,		//日本
	LANG_ENGLISH		    = 1,		//英語
	LANG_ENGLISH_USA		= 1,		//亜米利加	
	LANG_ENGLISH_ENGLAND	= 1,		//英吉利
	LANG_FRENCH				= 2,		//仏蘭西
	LANG_GERMANY			= 3,		//独逸
	LANG_ITALY				= 4,		//伊太利亜
	LANG_SPANISH			= 5			//西班牙
} ;

// ゲームレベル
// 必ずデファイン名を用いる事！直値禁止！

#ifdef JAPANESE
#enum {
	LEVEL_VERYEASY			= 10,
	LEVEL_EASY				= 20,
	LEVEL_NORMAL			= 30,
	LEVEL_HARD				= 40,
	LEVEL_EXTREME			= 50
} ;
#endif
#ifdef ENGLISH
#enum {
	LEVEL_VERYEASY			= 10,
	LEVEL_EASY				= 20,
	LEVEL_NORMAL			= 30,
	LEVEL_HARD				= 40,
	LEVEL_EXTREME			= 50
} ;
#endif

// システムコンフィグ定義（ GM_Configuration ）
#enum {
	CONFIG_VIBRATION_OFF 	= 	0x0001,	/* 振動ＯＦＦ */
	CONFIG_CAPTION_OFF  	= 	0x0002,	/* 字幕ＯＦＦ */
	CONFIG_RADAR_OFF 		= 	0x0004,	/* レーダーＯＦＦ */
	CONFIG_BLOOD_OFF		= 	0x0008,	/* 血ＯＦＦ */
	CONFIG_SOUND_MONAURAL	= 	0x0010,	/* モノラル */
	CONFIG_RADAR_OFF_INTRUDE = 	0x0020,	/* イントルード時レーダーＯＦＦ */
	CONFIG_SHUKAN_REVERSE =		0x0040,	/* 主観操作反転 */
	GM_CONFIG_OLD_TYPE_MENU		=	0x0080	/* 旧式メニュー */
} ;

// アラートモード定義( GM_AlertMode )
#enum {
	ALERT_MODE_SNEAK = 0,	/* 潜入モード */
	ALERT_MODE_ALERT,		/* 危険モード */
	ALERT_MODE_AVOID,		/* 回避モード */
	ALERT_MODE_SEARCH		/* 探索モード */
} ;

// システムコールバック
command システムコールバック[NewSystemCallback] \
	-load $p:ロードがかかった（restartは含まず） \
	-restart $p:リスタートがかかった \
	-gameover $p:ゲームオーバーロゴが開始される直線 \
	-continue $p:ゲームオーバー後コンティニューされた \
	-item $p:アイテムが変更された \
	-weapon $p:武器が変更された \
	-exit $p:ゲームオーバー後ＥＸＩＴ \
	-dead $p:プレイヤー死亡直後 \
	-active_map_change $p:表示マップ切り替え（主画面）//$1に表示マップＩＤ

//メニュー状態操作
command メニュー設定[NewSetMenuStatus] \
	-menu $s:on／off \			//武器・アイテムメニューのオンオフ
	-gage $s:on／off \			//ゲージのオンオフ
	-radar $s:on／off \			//レーダーのオンオフ、ジャミング
	-subwin $s:on／off \ 		//子画面のオンオフ
	-vibrate $s:on／off \ 		//振動のオンオフ
	-rAdio $s:on／off \ 		//無線の許可／不許可
	-pause $s:on／off \			//ポーズの許可／不許可
	-jamming $s:on／off \ 		//電波障害中／電波障害解除
	-disable_menu $s:on／off	//メニューオープンの許可／不許可

//ゲーム状況に応じて、各種メニューのオンオフを設定する。
//コンフィグ設定ではないので、ステージリセットでクリアされる。
//（デフォルトはすべてＯＮ）

//シナリオデモ設定
command シナリオデモ開始[NewStartScenarioDemo]
command シナリオデモ終了[NewEndScenarioDemo]

// ゲームオーバー音声セット
command ゲームオーバー音声設定[NewSetGameOverVox] \
	-vox $T:サウンドコード

// パッド関係 

command パッド操作[NewPadControl] \
	-which $b:パッド番号 \		// パッド番号（０が１コン、１が２コン。省略時は１コン。）
	-release \			// パッドリリース
	-mask $i:ボタン指定 \		// 指定ボタンをマスク( 指定ビットを1にするとそのボタンは無効になる）
	-press $i:ボタン指定 \		// 指定ボタンをそのフレームだけおしたことにする
	-cancel [$i:モード] 		// 0:リリースもマスクも解除。1:リリースのみ解除。2:マスクのみ解除
					//   省略時は０と同じ

//パッドの状態を操作する。
// -release, -mask, -press, -cancel はどれか一つのみ設定すること

command パッドチェック[NewPadCheck] \
	-which $b:パッド番号 \
	-direct \		//リリースされたりしていても情報がとれる。
	-press \		//押された
	-status \		//押されている
	-release		//離された

//パッドの状態を返す
//-press,-status,-releaseはどれか一つを指定
//-which を省略すると １コンを指定したことになる。
//
// たとえば、１コンの○が押されたかどうかは、
// command パッドチェック -which 0 -press
// if ( $status & d:PAD_A ) { }
// とすれば取得できる。

//ボタン定義
#define PAD_U	0x1000	//十字キー上
#define PAD_D	0x4000	//下
#define PAD_L	0x8000	//左
#define PAD_R	0x2000	//右
#define PAD_A	0x0020	//○
#define PAD_B	0x0040	//×
#define PAD_X	0x0010	//△
#define PAD_Y	0x0080	//□

#define PAD_L1	0x0004
#define PAD_R1	0x0008
#define PAD_L2	0x0001
#define PAD_R2	0x0002

#define PAD_STA	0x0800	//START
#define PAD_SEL	0x0100	//SELECT

#define PAD_AL	0x0200	//アナログ左押し込み
#define PAD_AR	0x0400	//アナログ右押し込み

//振動
chara パッド振動[NewPadVibrationScn] $s:名前 \
	-vibfile $s:振動バイナリファイル名

//パッドデモ再生
chara パッドデモ[NewPadDemoPlay] $s:名前 \
	-which $b:パッド番号（省略すると１コン） \
	-file $s:パッドデモファイル（.rpd） \
	-end_proc $p:終了プロック 

mesg パッドデモ $s:名前 start[0]
mesg パッドデモ $s:名前 stop[1]
mesg パッドデモ $s:名前 kill[2]
    	
// ステージロード

load 'ステージ名' \
	 -s $b:タイプ \				// ロードタイプ
	 -no_save \					// 指定すると変数をセーブしない
	 -resident '常駐ステージ名'	// 常駐データ入れ替え後、ステージロード

/*
	各キャラクタ定義
	担当別に区切る
*/

//--------------------------------------------------------------------- 
// 植原

// 汎用関数

// rand: 返り値($status, $?)に、値を返す。 (`command rand 10`)も可能。
command rand[NewRand] $i:最大値

command foreach[NewForeach] -argc $i:引数の数 -repeat $i:繰返し回数 \
	 -data * ... -exec { 実行ブロック }
// 繰返し実行。 実行ブロックには、$1,$2...で[$i:引数の数]個のデータが渡される。
// -value には、 $i:引数の数 * $i:繰返し回数のデータが必要

command sound[NewSound] -x $i:サウンドコード -w
		// -w をつけるとロード完了までまつ

command 配列セット[NewArraySet] $r:変数 * ...

chara delay[NewDelay] $s:名前 -time $i:時間 -exec { 実行ブロック } \
	 -proc $p:proc \
	 -arg $i:実行ブロックへのパラメータ ...
// 時間は 1/60 単位
mesg delay $s:名前 kill[-1]

command sin[NewGclSin] $w:角度（４０９６）		// 返り値は-4096から4096
command cos[NewGclCos] $w:角度（４０９６）		// 返り値は-4096から4096
command atan[NewGclAtan] $w:X移動量 $w:Y移動量	// 返り値は0から4096
command abs[NewGclAbs] $i:数値
command VecLen[NewGclVecLen] $i:x0 $i:y0 $i:z0 $i:x1 $i:y1 $i:z1

command assert[NewGclAssert] $i:評価式 [ 'アサート文字列' ]

command 現在時刻取得[NewGclGetRTC]		// 返り値は、[時]*60+[分]

// オブジェクト

chara MGSシステム初期化[NewGameInit] $s:名前 \
	 -debug $f:デバッグモード許可

command フォント初期化[NewFontInit]

command 変数初期化[NewGclVarClear]

command 常駐リソース設定[NewResidentResourceSet] \
	-string $d:リソース $i:参照ID ...2 \
	-binary $d:リソース $i:参照ID ...2
// リソースは、[RESOURCE:*]と記述することで、プログラムはその先頭番号が取れる。
// 参照IDはstringとbinaryで重ならないこと。

chara select[NewSelect] $s:名前 \
	-s '文字列' $p:proc ...2

chara ドア[NewDoor] $s:名前 -m $s:オブジェクト名 -d $v:向き -p $v:場所 \
	-slide $i:スライド量 -time $i:時間 \
	-between $s:マップ名１ $s:マップ名２ \
	-exec { $:開閉フラグ }
// マップ名１.２はそのドアが境界になっているマップの名前
// 省略すると、command マップ設定 で設定されたマップが用いられる。

// $:開閉フラグ は、0(閉まり切った) or 1(開き始めた)

mesg ドア $s:名前 open[1]
mesg ドア $s:名前 入る[1]
mesg ドア $s:名前 close[2]
mesg ドア $s:名前 出る[2]

mesg ドア $s:名前 on[3]
mesg ドア $s:名前 off[4]
mesg ドア $s:名前 visible[5] $i:フラグ

//visibleを指定したときのフラグには、
//可視、不可視フラグが入る
//たとえば、天井君切り替えプロックの$1など。

chara サブ画面[NewTs_SubWindow_S] $s:名前 -w $w:x0 $w:y0 $w:x1 $w:y1
// 座標設定は無効。
// ２つ以上出せない。

mesg サブ画面 $s:名前 on[1]
mesg サブ画面 $s:名前 off[0]

/*2000.09.12 レーダーを重野管理に移動*/

chara 字幕[NewJimaku] $s:名前 '文字列'

// マップ

chara マップ接合[NewMapConnect] $s:名前 $s:マップ１ $s:マップ２
mesg マップ接合 $s:名前 on[1]
mesg マップ接合 $s:名前 off[0]

// USBキーボードを使ったデバッグ用コマンド

chara USBキーボード実行[NewKbdExec]	$s:名前 \
	-e $b:キーコード { 実行ブロック }
// キーコードはusbkbd.hに定義してあります。
// -e は複数指定可能

// デバッグ用ポーズ

chara デバッグポーズ[NewDebugPause] $s:名前 'STRING' -p $p:proc
// STRINGを表示してポーズをかけ、○ボタンが押されたらprocを実行

// 無線システム

chara 無線システム[NewCodecDaemon] $s:名前
// 名前は、"Codec"固定

command 無線設定[NewCodec] \
	-base $w:周波数 $C:無線コード \
	-over $i:入る／出る $w:周波数 $C:無線コード \
	-call $w:周波数 $C:無線コード $w:呼び出しタイプ [$p:proc_id] \
	-reset \
	-allclear \
	-f $w:フェードオプション \
	-d

// 呼び出しタイプは、
#define CODEC_CALL		2	// CALL
#define CODEC_DEMO		3	// CALLから強制移行
#define CODEC_DIRECT	4	// CALLなしで強制移行

// フェードオプション
#define CODEC_IN_FADE    9	// フェードで無線モードに入る
#define CODEC_OUT_FADE   6	// フェードで無線モードから出る
#define CODEC_IO_FADE    3	// フェードで無線モードに出入りする

//
// フェード/アクション制御のマクロ定数は、以下の命名法則に従う。
//
//  CODEC_I_<無線in時の挙動>_O_<無線out時の挙動>
//
//  <挙動>
//     NO        フェード、枠アクションともに無し
//     FD        フェードのみ。枠アクションは無し
//     AC        枠アクションのみ。フェードは無し
//     FA        フェード、枠アクションともに有り
//
#define CODEC_I_NO_O_NO  0x0000
#define CODEC_I_NO_O_FD  0x0002
#define CODEC_I_NO_O_AC  0x0008
#define CODEC_I_NO_O_FA  0x000a

#define CODEC_I_FD_O_NO  0x0001
#define CODEC_I_FD_O_FD  0x0003
#define CODEC_I_FD_O_AC  0x0009
#define CODEC_I_FD_O_FA  0x000b

#define CODEC_I_AC_O_NO  0x0004
#define CODEC_I_AC_O_FD  0x0006
#define CODEC_I_AC_O_AC  0x000c
#define CODEC_I_AC_O_FA  0x000e

#define CODEC_I_FA_O_NO  0x0005
#define CODEC_I_FA_O_FD  0x0007
#define CODEC_I_FA_O_AC  0x000d
#define CODEC_I_FA_O_FA  0x000f

#define CODEC_FDIN_BREAK  0x0010  // フェードインを暗転状態から開始
#define CODEC_FDOUT_BREAK 0x0020  // フェードアウトを暗転状態で終了


// ストリーミング用

command Stream[NewStreamSet] $T:VOXコード -p $p:終了proc -w -c $b:チャンネル \
	-action $p:アクションproc -menustop
	// -w は、初期読み込み後、stream startがくるまで停止
	// 終了procには、$1で中断したかどうかがわたる（0:正常終了、1:中断)
	// アクションproc は、$:ストリームID $:話者名 $:アクションコード

// 以下のcommandは、このcommandの返り値(int)を使ってアクセス。

command StreamStart[NewStreamStart] $i:StreamCode
	// -wで初期読み込み後停止しているstreamをスタート
command StreamStop[NewStreamStop] $i:StreamCode
	// ストリームの強制停止
command StreamStopAll[NewStreamStopAll]
	// すべてのストリームの強制停止
command StreamIsPlay[NewStreamIsPlay]
	// ストリームが何本再生中かを返す
command StreamSetPan[NewStreamSetPan] $i:StreamCode -p $b:パン -v $b:ボリューム
	// ストリームにパンとボリュームを設定する。
	// pan 0(左)-0x20(中)-0x3F(右), vol 0-0x3F

command StreamStatus[NewStreamStatus] $i:StreamCode
	// 以下の値を返す。d:STREAM:WAITのように参照。

#enum STREAM {
	INIT_WAIT = -2,		// 初期化後CD読み込み開始待ち
	INIT = -1,			// 初期CD読み込み中
	WAIT = 0,			// -w でのWAIT状態
	PLAY = 1,			// 再生中
	READ_END = 2,		// CD読み取りは最後まで終った
	END = 3				// 終了
};

// --- デモ、ストリーミングキャンセルチェック

chara デモキャンセルチェック[NewPadCancel] $s:名前 -p $proc
// ×ボタンかスタートボタンか押されて(離されたら)procを呼び出す。
mesg デモキャンセルチェック $s:名前 kill[-1]

// --- ムービー

chara PSS再生[NewMpegPssMovie] $s:名前 -name 'PSSFILE' -proc $p:終了proc \
	-top $w:x $w:y

chara MOVIE再生[NewMpegPssMovieStr] $s:名前 -file $t:番号 -proc $p:終了proc \
	-top $w:x $w:y

//--------------------------------------------------------------------- 

//園山 M.Sonoyama

//-------- マップ関連 ------------------------------------------------

//マップシステム
chara マップ[NewSetMap] $s:名前 \
	-k $s:モデル名 [$v:セット位置] \
	-h $s:ハザード [$b:開始グループ] \			
	-g $b:ハザードグループナンバー \	//不使用
	-l $s:ライト \
	-s $s:影投影モデル名 [$v:セット位置]	//廃止

command	マップ設定[NewMapAbout] $s:名前 ... \
		-set { キャラセット }

command	マップ表示[NewShowMap] -add $s:名前 ... -delete $s:名前 ... \
                               -show $s:名前 ...			      

command マップ表示チェック[NewCheckMapIsDisplay] \
	-which $i:チャンネル（省略すると０） \
	-map $s:マップ名
//1が返ると表示中

//キャラのマップを変更する
command キャラマップチェンジ[GM_ComMapChange] \
	-name $s:キャラの名前 \
	-map $s:変更先マップ名

//追加ＨＺＸグループ関連

//追加ＨＺＸグループを登録
command 追加ＨＺＸグループ登録[NewHzxSetGroupAdd] \
	-hzx_id $b:元になるグループ番号 \
	-add_id $b:追加するグループ番号

//追加ＨＺＸグループを削除
command 追加ＨＺＸグループ削除[NewHzxResetGroupAdd] \
	-hzx_id $b:元になるグループ番号 \
	-add_id $b:削除するグループ番号

//-------- カメラ関連 ------------------------------------------------
// CAMERA

//カメラ
chara カメラ[NewCamera] $s:名前 \
	-c $b:チャンネル番号 \
	-l $b:カメラレベル \
	-p $b:優先度

//シナリオカメラは最大16個までおける。

//チャンネル番号 ：
//	０：通常画面 １：小窓
//
//カメラレベル ：
//	０：カットインカメラ（主観より強） 強
//	１：カットインカメラ（主観より弱） ↑
//	２：エリアカメラ		   ↓
//	３：ステージデフォルトカメラ	   弱
//
//優先度 ：
//	エリアカメラに有効
//	数字が小さい程優先度高

// カメラの設定をする
chara カメラ設定[NewSetCamera] $s:名前 \
	-c $b:カメラタイプ \
	-b $v:バウンド小 $v:バウンド大 \
	-l $v:リミット小 $v:リミット大 \
	-p $v:カメラ位置 \
	-t $v:ターゲット位置 \
	-r $v:カメラ角度 \
	-f $w:カメラトラック \
	-a $w:カメラ画角 \
	-i $w:カメラ補完方法（ＩＮ） $w:カメラ補完方法（ＯＵＴ） \
	   $w:補完時間（ＩＮ） $w:補完時間（ＯＵＴ） \
	-d $f:パッドフラグ \
	-z $i:各種フラグ \
	-k $f:ＫＩＬＬ \
	-s $i:０オフ／１オン \
	-o $w:ＯＮになるまでの待ち時間 \
	-slidE $f:スライドタイプ $w:スライド待ち時間 \
	       $i:スライド距離１ $i:スライド距離２ \
	       $i:スライドスピード [$i:スライドフラグ] \
	-iNterp_time $i:内部補完時間

// フラグ
#define	CAMERA_NO_PAD_ADJUST		0x00000400	//パッド調整に影響を及ぼさない
#define	CAMERA_CUT_IN				0x00010000	//カットインカメラ
#define	CAMERA_NO_CUSHION			0x00700000	//遊びなしカメラ
#define	CAMERA_BOUNDCHANGE_QUICK	0x01000000	//バウンド変更を即時に反映
#define	CAMERA_INTERP_CAMERA		0x02000000	//補完カメラ設定
	
// -b -l は必要に応じて設定。
// -p -t -r はタイプに応じて使用するものが取得
// される。
// 省略したオプションは、前回設定を引き継ぐ。
//
//カメラタイプ ：
//	０：上俯瞰追従型（トラックと角度を指定）
//	１：位置・角度固定型（ターゲット位置とカメラ位置を指定）
//	２：位置固定、追従型（カメラ位置を指定）
//	３：位置固定、Ｘ角度追従型（カメラ位置を指定）※未作成
//	４：ターゲット固定、プレイヤー追従カメラ（ターゲットとトラックを指定）
//	５：位置固定、Ｙ回転固定、追従型（カメラ位置と回転を指定）

// 補完方法
// −１：指定なし ０：一瞬 １：補完シューン ２：補完ウニョーン 
//   ３：補完ウーニャーン  ４：一定時間で 
// 補完時間は４番指定のとき有効
// 補完（ＩＮ）の指定は必須。
// ２つのカメラ間の補完方法は、ＯＵＴ側カメラのＯＵＴ補完関数が指定してある
// 場合にはその関数を使用し、指定がない場合には、ＩＮ側カメラの
// ＩＮ補完関数を使用するようになっている。
//
// パッドフラグ 
// このフラグを指定しておくと、
// パッドの上が画面の上になるように自動調節する。

// スライドカメラ設定方法
// スライドタイプ：０／１ − 左右タイプ／前後タイプ
// スライド待ち時間：スライドするまでの待ちフレーム数
// スライド距離１・２：左右タイプの場合 左右スライド距離
//		       前後タイプの場合 接近距離、離れた距離
// スライドスピード：そのまんま
// スライドフラグ ：
//		1にしておくと、入った時スライドしていない状態から始まります。

// 補完カメラの設定方法
// 補完カメラとは？
//		設定したカメラに指定フレーム数かけて移動するカメラ。
//		例として、オルガ戦のパンカメラ。
// 設定方法
//		-z に d:CAMERA_INTERP_CAMERA を指定。さらに
//		-interp_time に補完フレーム数を指定。

chara カメラ上下振動[NewCameraOscillation] $s:名前 \
	-a $w:振幅 \
	-c $w:周期（フレーム数） 
// カメラの位置−ターゲットベクトルを
// 上下に単振動させる。
// 主観時は、無効

command カメラ上下振動スイッチ[NewCameraSwingMode] \
	-which $b:画面番号（０：主画面、１：子画面） \
	-mode $s:on／off
// 上記、カメラ上下振動の一時的なＯＮ／ＯＦＦに使用する。

//カメラ状態をチェックする。
//ＯＮになっていれば１を返す。
command	カメラ状態[NewCameraSwitchCheck] -s $s:カメラ名

command カメラマップ設定[NewSetChanlTargetMap] \
	-chanl $b:チャンネル（メイン：０子画面：１） \
	-map $s:マップ名

//-------- プレイヤー ----------------------------------------------------
//PLAYER

chara プレイヤー[NewRaiden] $s:名前 \
	-model $s:モデル名 \
	-archive $s:モーション名 \
	-position $v:出現位置 \
	-direction $v:出現方向 \
	-level $w:出現位置床高さ \ 	//廃止
	-stance $b:出現時姿勢 \
	-other_mar $s:強制モーション用モーションファイル名 \
	-id_table $b:ＳＥ変換テーブルＩＤ \
	-homing $i:ホーミング距離 $i:ホーミング角度 \
	-flags $i:各種フラグ 

// 出現時姿勢 ： ０／１／２／３ ： 立ち／しゃがみ／匍匐／イントルード

//各種フラグ ： どんどん追加される。かな？

#define PLY_SPLASH		0x00000001 //体足水飛沫あり
#define	PLY_NO_FOOT_SHADOW	0x00000002 //足影なし

//プレイヤーメッセージ一覧（詳細は各項）
//
//mesg プレイヤー $s:名前 motion[0] 		強制モーション
//mesg プレイヤー $s:名前 position[1] 		強制位置移動
//mesg プレイヤー $s:名前 position2[2] 		強制位置移動２
//mesg プレイヤー $s:名前 menu[3] 			メニューＯＮ／ＯＦＦ
//mesg プレイヤー $s:名前 beyond_trap[4]	エルードトラップ指定
//mesg プレイヤー $s:名前 locker[5] 		ロッカーモード
//mesg プレイヤー $s:名前 wt_door[6] 		水密ドアモード
//mesg プレイヤー $s:名前 ladder[7]			はしごモード
//mesg プレイヤー $s:名前 shadow[8] 		足影ＯＮ／ＯＦＦ
//mesg プレイヤー $s:名前 headmark[9] 		赤びっくり
//mesg プレイヤー $s:名前 stance[10] 		強制姿勢制御
//mesg プレイヤー $s:名前 water[11]			水中モード
//mesg プレイヤー $s:名前 run[12] 			強制移動
//mesg プレイヤー $s:名前 beltconv[13] 		ベルトコンベア乗り降り
//mesg プレイヤー $s:名前 rotate[14] 		Ｙ方向セット
//mesg プレイヤー $s:名前 evpanel[15]		エレベータパネル
//mesg プレイヤー $s:名前 fall[16]			落下

//-------- 強制モーション

mesg プレイヤー $s:名前 motion[0] \
	$i:モーション番号 \
	$i:初期方向 \
	$i:終了方向 \
	$i:終了姿勢 \
	$i:フラグ \
	[$i:開始時Ｘ座標 $i:開始時Ｚ座標 $i:開始時Ｙ座標] 

//開始時座標指定は、ＸＺＹの順なので注意！
//ＸＺを指定して、Ｙを省略も可能

//フラグ定義（随時追加）
#enum {
    FA_NO_CHECK_SEG	= 0x00000001,	/* 壁見ない */
    FA_NO_CHECK_FLR	= 0x00000002,	/* 床見ない == 重力処理しない */
    FA_NO_CHECK_TRP	= 0x00000004,	/* トラップ見ない */
    FA_NO_RECHECK_TRP	= 0x00000008,	/* トラップチェック再開しない */
    FA_USE_DEFAULT	= 0x00000100,	/* デフォルトのmarから指定 */
    FA_NO_WEAPON        = 0x00000200,   /* 装備武器を非表示 */
	FA_NO_INTERP 	= 0x00000400,	/* モーション補完なし */
	FA_USE_NOW_HEIGHT =	0x00001000,	/* 無理やり今の高さからはじめる */
	FA_DIRECT_MOVE =    0x00010000,	/* 強制移動用、ゾーンを使用せず一直線に移動する。*/
} ;

//初期方向、終了方向、終了姿勢については、
// -1 を指定することで、強制モーション直前の
//値になります。
//終了時姿勢 ： ０−立ち、１−しゃがみ、２−匍匐
//終了時姿勢に ４ を指定すると、終了後ビヨンドモード
//			   １１ を指定すると、終了後水中モード
//以下のdefineを使うとよい。

#define	FA_END_STAND 	0
#define	FA_END_SQUAT	1
#define	FA_END_GROUND	2
#define	FA_END_ELUDE	4
#define	FA_END_SWIM		11

command	強制モーション終了プロック[NewForceActEndProc] \
	-motion $i:モーション番号 \
	-proc $p:プロック

//強制モーションが終了したときに呼ぶプロックを設定できます。
//モーション番号の設定がない場合には、直後の強制モーション終了時に
//呼ばれます。
//プロックの第一引数には、下に記述する「モード」が入ります。
//このプロックは一度実行されるとクリアされるので、
//毎回呼ぶ場合には、その都度設定しなおす必要があります。

command 強制モーションプロック[NewForceActProc] \
	-proc $p:プロック \
	-exec { $:Ｘ位置 $:Ｙ位置 $:Ｚ位置 $:経過時間 $:モード $:状態 } \
	-flag $i:フラグ 

// -proc と -exec はどちらか一つ
// -flag に 0x0001 を指定すると、強制モーション中毎フレーム実行されるようになる。
// -flag に 0x0002 を指定すると、終了時にも実行されるようになる。
//                               強制モーション終了プロック」と共存はできない。
//このプロックは強制が終了するとクリアされる。
//
//状態は、入る、いる、出るの３つ

//強制モーションプロックと強制モーション終了プロックの
//適用範囲は、現在、

//・強制モーション
//・強制移動
//・強制姿勢変更
//・はしごつかまり／離し
//・エルード入りモーション／出るモーション発動／落下

//です。

//プロックに渡される引数の「モード」は、
//以下のようになっています。

#enum {
	FA_PROCMODE_MOTION 		= 0,		//強制モーション
	FA_PROCMODE_RUN    		= 1,		//強制移動
	FA_PROCMODE_STANCE 		= 2,		//強制姿勢変更
	FA_PROCMODE_LADDER_IN 	= 3,		//はしごつかまり
	FA_PROCMODE_LADDER_OUT 	= 4,		//はしご離し
	FA_PROCMODE_ELUDE_IN 	= 5,		//エルード開始
	FA_PROCMODE_ELUDE_OUT 	= 6,		//エルード戻り
	FA_PROCMODE_ELUDE_FALL 	= 7			//エルード落下開始
} ;

command 強制モーションキャンセル[NewForceActCancel]

//-------- 強制姿勢制御

command プラグイン姿勢制御[NewPluginStance]

mesg プレイヤー $s:名前 stance[10] \
	$i:姿勢 \
	$i:初期方向 \
	$i:終了方向 \
	$i:フラグ
//各パラメータの意味は強制モーション設定と同じ

//-------- 強制移動

command プラグイン強制移動[NewPluginForceRunMove]

mesg プレイヤー $s:名前 run[12] \
	$i:目標Ｘ $i:目標Ｙ $i:目標Ｚ \
	$w:モーション \
	$w:終了方向 \
	$i:フラグ \
	[$p:終了プロック]

//各パラメータの意味は強制モーション設定と同じ
//フラグに関しては、以下が有効
//	FA_NO_WEAPON
//	FA_NO_CHECK_SEG
//	FA_NO_CHECK_FLR
//	FA_NO_CHECK_TRP
//	FA_NO_RECHECK_TRP
//  FA_DIRECT_MOVE

//モーションは、
//０：立ち歩き、１：立ち走り、２：立ちダッシュ
//３：匍匐前進、４：匍匐前進（速）５：ダンボール（予定）
//−１ ： 今のままで
//匍匐の時、壁のめり込み回避はできないので注意。

//-------- 強制位置セット 
mesg プレイヤー $s:名前 position[1] \
	$i:位置Ｘ $i:位置Ｙ $i:位置Ｚ

mesg プレイヤー $s:名前 position2[2] \
	$w:軸 $i:位置 [$w:軸 $i:位置 $w:軸 $i:位置]
// position2は、軸ごとの移動（Ｘ軸のみ、など）
// 軸 ： ０／１／２ ： Ｘ軸／Ｙ軸／Ｚ軸

mesg プレイヤー $s:名前 rotate[14] $w:方向

//-------- エルード設定
mesg プレイヤー $s:名前 beyond[3] \
	$b:静止モーション \
	$b:移動モーション右 \
	$b:移動モーション左 \	
	$b:戻りモーション \
	$b:床チェックする関節番号 \
	$w:開始時向き \
	$w:終了時向き \
	$i:フラグ \
	[$b:戻りモーション（壁有り） \
	 $b:戻り時に壁チェックする関節番号（省略時は右膝）\
	 $b:静止モーション（疲れ）]

//パラメータ数がオーバーしてしまったので
//command にします。
command エルード設定[NewSetEludeParam] -values \
	$b:静止モーション \
	$b:移動モーション右 \
	$b:移動モーション左 \	
	$b:戻りモーション \
	$b:床チェックする関節番号 \
	$w:開始時向き \
	$w:終了時向き \
	$i:フラグ \
	$b:戻りモーション（壁有り） \
	$b:戻り時に壁チェックする関節番号（省略時は右膝）\
	$b:静止モーション（疲れ） \
	$b:落下モーション（落ちはじめ） \
	$b:落下中モーション \
	$b:落下してダメージ \
	$b:落下して死亡 \
	$b:落下しても無事着地 \
	$b:撃たれダメージ \
	[$b:懸垂開始 \
	 $b:懸垂静止 \
	 $b:懸垂終了]

//※※強制モーション用mar必須！！
//
//フラグ定義
//	
#enum {
    BY_CHECK_FLOOR = 		0x00000000,	/* 床からエッジ検出（廃止） */
    BY_CHECK_SEGMENT = 		0x00000001,	/* 壁からエッジ検出（廃止） */
    BY_NOFOOTSHADOW = 		0x00000002,	/* 足影なし */
	BY_FALL_DEAD =			0x00000004,	/* 落ちたら死ぬぜ */
	BY_CANNOT_FALL =		0x00000008,	/* パッド操作での落下禁止 */
	BY_NO_STAMP =			0x00000010,	/* ふみつけなし（低いエルードなど） */
	BY_FALL_IMMEDIATELY = 	0x00000020,	/* すぐ降りエルード */
	BY_NO_MOVE_LR =			0x00000040,	/* 左右移動なし */
	BY_DEC_GRIP_FAST =		0x00000080	/* グリップ減少速度大 */
} ;

command エルード移動範囲設定[NewSetEludeRange] \
	-x_range $i:Ｘ最小 $i:Ｘ最大 \
	-z_range $i:Ｚ最小 $i:Ｚ最大

//※エルード設定の後に記述すること

mesg プレイヤー $s:名前 beyond_trap[4] $i:トラップ名

//-------- 水中モード

command プラグイン水中[NewPluginWaterModeTest]

command 水中設定[NewWaterModeSettingTest] \
	-horizon $i:水平面高さ \
	-motion $s:モーションファイル

command 新プラグイン水中[NewPluginWaterMode] \
	-zone_group $i:カメラ追従用ゾーンのグループ番号 \
	-height $i:カメラ追従高さ（デフォルト１６５０）

command 新水中設定[NewWaterModeSetting] \
	-horizon $i:水平面高さ \
	-motion $s:モーションファイル \
	-elude2water $i:エルード落下から水中にはいる時のモーション番号 \
	-flag $i:フラグ

mesg プレイヤー $s:名前 water[11] $s:入る／出る $i:モーション番号 $i:開始方向 \
			[$i:開始Ｘ位置 $i:開始Ｚ位置 $i:開始Ｙ位置]

//フラグ定義 
#enum {
	WATER_FLAG_NORMAL		= 	0x0000,
	WATER_FLAG_AUTO_ROTATE	=	0x0001,		//角度自動調節機能付き
	WATER_FLAG_NO_ZONE_TRACE =	0x0002		//ゾーンを使用した追従をしない
} ;

chara 息継ぎポイント管理[NewBreathPointManager] $s:名前 

command 息継ぎポイント登録[NewAddBreathPoint] \
	-position $v:座標 

chara 水中機雷[NewWaterMine] $s:名前 \
	-map $s:マップ名 \
	-position $v:位置 \
	-rotate $v:回転 \
	-rOute $i:ルート番号 \
	-speed $i:移動スピード

chara 水中エマ[NewEESwim] $s:名前 

//-------- ロッカーモード
mesg プレイヤー $s:名前 locker[5] \
	$s:ロッカーの名前 $i:そのロッカーの状態 \
	$w:外からロッカーに正対した方向 $w:方向幅 \
	[$i:ロッカー位置Ｘ $i:ロッカー位置Ｚ]

//-------- 水密ドアモード
mesg プレイヤー $s:名前 wt_door[6] \
	$s:水密ドアの名前 $i:そのドアの状態 \
	$w:ドアに正対した方向 $w:方向幅 \
	$i:ドア位置Ｘ $i:ドア位置Ｚ \
	[$f:開け方向]

//開け方向 ０：引き １：押し 省略時は「引き」

//-------- はしごモード

//強制モーションｍａｒ必須！！

command プラグインはしご[NewPluginLadder]

command はしご設定[NewSetupLadder] \
	-limit	$i:はしご下限 $i:はしご上限 \ 
	-basic  $b:はしご静止モーション右手上 \
			$b:はしご静止モーション左手上 \
			$b:はしご登りループ \
			$b:はしご降りループ \
			[$b:はしごダメージ右手上 \
	 		 $b:はしごダメージ左手上 \
			 $b:はしご落下開始右手上 \
			 $b:はしご落下開始左手上 \
			 $b:はしご落下ループ \
			 $b:はしご落下終了] \
	-start  $b:はしご開始モーション \
			$v:はしご開始モーション発動位置 \
			$w:発動時向き \
	-end	$b:はしご終了モーション \
			$v:はしご終了モーション発動位置 \
			$w:終了時向き

mesg プレイヤー $s:名前 ladder[7]

//はしご手モーフィング管理
chara はしごプレイヤー手モーフィング管理[NewLadderPlayerHandMofingManager] $s:名前 \
		-patterns			$b:右パターン数 $b:左パターン数 \
		-right_hand_cv2		$s:右手用パターン ... \
		-left_hand_cv2		$s:左手用パターン ... \
		-timing_r			$i:切り替えタイミング右 ... \
		-tIming_l			$i:切り替えタイミング左 ... 

command はしごプレイヤー手モーフィングタイミング設定[NewSetLadderPlayerHandMofingTiming] \
		-timing_r			$i:切り替えタイミング右 ... \
		-tIming_l			$i:切り替えタイミング左 ... 		

//切り替えタイミングの書き方 
//		３つの数で１セット	0,24,2	（モーション番号、フレーム、切り替えパターン）
//		モーション番号の定義：	０：はしご静止モーション右手上
//								１：はしご静止モーション左手上 
//								２：はしご登りループ
//								３：はしご降りループ
//								４：はしご開始モーション
//								５：はしご終了モーション

//-------- ベルトコンベア

command プラグインベルトコンベア[NewPluginBeltConveyer]

mesg プレイヤー $s:名前 beltconv[13] \
	$s:乗り場マップ $s:乗り場トラップ台 $s:乗り場トラップベルト $w:乗り向き \
	$s:降り場マップ $s:降り場トラップ台 $s:降り場トラップベルト $w:降り向き

command ベルトコンベア時プロック設定[NewSetPlayerBeltConveyerProc] \
	-proc $p:プロック 

//プロックの$1引数
//0 : 乗り開始 1 : 乗り終了 2:降り開始 3:降り終了

//-------- おまけ

mesg プレイヤー $s:名前 shadow[8] $f:ＯＮ／ＯＦＦ
//影の表示・非表示
//１がＯＮ、０がＯＦＦ

mesg プレイヤー $s:名前 headmark[9] 

//-------- プレイヤー関連キャラ

chara ダンボール柄トラップ設定[NewCheckBoxHidden] $s:名前 \
	-name $s:プレイヤーの名前 \
	-traps $i:アイテム番号（equip.h） $s:トラップ名 ...

//[$i:アイテム番号,$s:トラップ名 ] の組み合わせを４つまで指定できます。

//-------- プレイヤー関連コマンド
//PL_COMMAND

mesg プレイヤー $s:名前 menu[3] $s:on／off
// onで表示
// offで非表示

command	PlayerStatus[NewGetPlayerStatus] -f $w:チェックしたい状態 ...
//チェックしたい状態は下記（トラップのプレイヤー状態）と同じ。
//羅列することでＯＲが可能。

command プレイヤー状態取得[NewGetPlayerStateFlag]
//上に代わるもの
//実行結果と下記フラグの＆をとるとプレイヤーの状態がわかる
#enum {
	PFLAG_INTRUDE =			0x0008,		/* イントルード */
	PFLAG_SUBJECT =			0x0010,		/* 主観 */
	PFLAG_CAUTION =			0x0020,		/* 張り付き */
	PFLAG_ELUDE =			0x0040,		/* エルード */
	PFLAG_LOCKER =			0x0080,		/* ロッカー */
	PFLAG_LADDER = 			0x0100,		/* はしご */
	PFLAG_ENEMY_PULL =		0x0200,		/* 死体引き摺り */
	PFLAG_WATER =			0x0400,		/* 水中 */
	PFLAG_BEHIND =			0x0800,		/* ビハインドカメラ中 */
	PFLAG_DIAZEPAM =		0x1000,		/* ジアゼパム中 */
	PFLAG_PEEP_R =			0x2000,		/* 覗き込み右最大 */
	PFLAG_PEEP_L =			0x4000,		/* 覗き込み左最大 */
	PFLAG_BLOOD =			0x8000,		/* 流血 */
	PFLAG_WALK =			0x00010000,	/* 歩き */
	PFLAG_RUN =				0x00020000,	/* 走り */
	PFLAG_BOX =				0x00040000,	/* ダンボール */
	PFLAG_WATER_SURFACE =	0x00080000,	/* 水中モードで、カメラは水面上 */
	PFLAG_NO_BREATH =		0x00100000,	/* 無呼吸状態 */
	PFLAG_SNAKE =			0x00200000	/* スネークである */
} ;

command プレイヤーマップ名[NewGetPlayerMapName]
//現在プレイヤーのいるマップのＳＴＲＣＯＤＥを返す

command プレイヤー無敵セット[NewPlayerSetInvincible]
command プレイヤー無敵解除[NewPlayerResetInvincible]

command プレイヤー瞬殺[NewKillPlayer] \
	-name $s:プレイヤー名 \
	-blow 					//これがあると「吹っ飛び」

command プレイヤー死体歩き[NewCorpseWalk] 

command プレイヤーモーション振動ＯＦＦ[NewPlayerMotionVibOff]

//-------- 主観デモ ------------------------------------------------------

chara	主観デモプレイヤー[NewSubjectDemoPlayer] $s:名前 \
	-kms $s:ＫＭＳモデル \
	-evm $s:ＥＶＭモデル \
	-mar $s:モーションファイル \
	-position $v:初期位置 \
	-rotate $v:初期方向 

//通常プレイヤーとの共存は不可

mesg 主観デモプレイヤー $s:名前 position[0] $i:Ｘ位置 $i:Ｚ位置 [$i:Ｙ位置]

mesg 主観デモプレイヤー $s:名前 rotate[1] $i:Ｘ角度 $i:Ｙ角度	//-1で無視

mesg 主観デモプレイヤー $s:名前 motion[2] $i:モーション番号 $i:動作
//$i:動作
//	0	:	モーションをリピート
//	1	:	モーションが終了したら、その状態で止める
//	2	:	モーションが終了したら、０番モーションになり、その後０番をリピート

//-------- ロッカー ------------------------------------------------------

chara ロッカー管理[NewLockerDaemon] $s:名前 \
	-n_lockers $w:ロッカー最大数 \
	-type $f:ロッカータイプ（廃止）

command ロッカーモーション[NewSetLockerMotion] \
	-motion $s:ロッカー開閉モーション

command プレイヤーロッカーモーション[NewSetPlayerLockerMotion] \
	-motion $s:プレイヤーのロッカー開閉モーション

chara ロッカー[NewLocker] $s:名前 \
	-kms $s:モデル \
	-body $s:箱モデル（省略すると扉のみ） \
	-position $v:位置 \
	-rotate $v:回転 \
	-down_rot $v:倒れたときの角度 \
	-doWn_shift $v:倒れたときのシフト量 \
	-state $i:初期状態 \
	-code $w:ドア動作ＳＥコード $w:ドア閉まるＳＥコード（廃止） \
	-flag $i:フラグ \
	-light $s:スポットライト名 \
	-name_of_spotlight $s:対応スポットライト名 \
	-exec { $:トリガ $:実行キャラ $:行動 } \
	-prOc $p:呼び出しプロック \ //$:トリガ $:実行キャラ $:行動 \
	-seNo $i:壁音番号 \
	-gravure $v:キス音発生範囲最小 $v:キス音発生範囲最大 \
			 $v:胸範囲最小 $v:胸範囲最大 \
			 $v:秘所範囲最小 $v:秘所範囲最大

//フラグ
#define	LOCKER_FLAG_SHADOWDROP	0x0001 	//扉の影が投影される（廃止）
#define	LOCKER_FLAG_SELFSUBJECT	0x0002	//内部でもオートで主観にはならない
#define	LOCKER_FLAG_SHADOWWRITE	0x0004	//扉に影が投影される
#define	LOCKER_FLAG_TOILET		0x1000	//トイレである

//-code を省略するとデフォルトのコードが使われる。

//-exec と -prOc はどちらか一つ。
//$1に開始時／終了時 = 1／0 が入る。
//$2は実行キャラクタ名
//$3は以下の通り
//  0:外から開けた
//  1:外から閉めた
//  2:内から開けた
//  3:内から閉めた
//  4:壊れて開いた
//  5:死体を入れて閉める

//開けられる向きとは、プレイヤーがそのロッカーに正対したときの
//プレイヤーの向き。

//初期状態は以下の値で指定 
#enum {
    LOCKER_STATE_CLOSE =        0x0001, /* しまっている */
    LOCKER_STATE_OPEN =         0x0002, /* 開いている */
    LOCKER_STATE_CORPSE_IN = 	0x0020,	/* 死体が入っている */
    LOCKER_STATE_ENEMY_IN = 	0x0040, /* 気絶兵が入っている */
    LOCKER_STATE_DESTROY =		0x4000,	/* 開けられない／閉められない */
	LOCKER_STATE_POSTER =		0x00010000,	/* ポスターあり */
	LOCKER_STATE_NO_OPEN_SEG =	0x00040000	/* 開いているときの扉プレイヤーあたりなくす */
} ;

//呼び出しプロックの引数は検討中
//次のパターンを数字で返すといいかも。

//プレイヤー外から開ける／閉める
//プレイヤー中から開ける／閉める
//プレイヤー気絶兵入れる／死体入れる
//敵兵クリアリング時開ける／閉める
//敵兵中から開ける
//死体ｏｒ気絶兵中から転がり出てくる

mesg ロッカー $s:名前 open[ 0 ] $s:操作キャラ $f:外／内＝０／１ [$b:モーション]
mesg ロッカー $s:名前 close[ 1 ] $s:操作キャラ $f:外／内＝０／１ [$b:モーション]
mesg ロッカー $s:名前 put_enemy[ 2 ]
mesg ロッカー $s:名前 put_corpse[ 3 ]
mesg ロッカー $s:名前 open_end[ 4 ]
mesg ロッカー $s:名前 close_end[ 4 ]
mesg ロッカー $s:名前 rotate[ 5 ] $i:手の位置Ｘ $i:手の位置Ｚ $i:下駄
mesg ロッカー $s:名前 rotate2[ 6 ] $w:相対回転角度

//指定ロッカーの状態（開いている、しまっているなど）
command ロッカー状態[NewLockerStatus] -n $s:名前 

// 結果の見方
// $status & 0x0001	: 閉じている
// $status & 0x0002	: 開いている
// $status & 0x2000 : 扉が外れている

//つながりロッカー
command ロッカー接合[NewLockerConnection] \
	-connection $s:プレイヤーが中に入った状態で右側に当たるロッカー \
	       	 	$s:プレイヤーが中に入った状態で左側に当たるロッカー 
//ロッカー接合指定は、1ステージに４つまで

//-------- 水密ドア  -----------------------------------------------------

chara 水密ドア管理[NewWatertightDoorManager] $s:名前 \
	-n_doors $b:最大ドア数 \
	-motions $s:プレイヤーモーション $s:ドアモーション $s:ハンドルモーション \
	-adjusts $i:左軸ドア引き時プレイヤー位置調整Ｘ \
		     $i:左軸ドア引き時プレイヤー位置調整Ｚ \
			 $i:左軸ドア押し時プレイヤー位置調整Ｘ \
		     $i:左軸ドア押し時プレイヤー位置調整Ｚ \
			 $i:右軸ドア引き時プレイヤー位置調整Ｘ \
		     $i:右軸ドア引き時プレイヤー位置調整Ｚ \
			 $i:右軸ドア押し時プレイヤー位置調整Ｘ \
		     $i:右軸ドア押し時プレイヤー位置調整Ｚ 

//motions指定がない場合はプログラムで動かす

chara 水密ドア[NewWatertightDoor] $s:名前 \
	-kms $s:ハンドル無しモデル $s:ハンドルモデル \
	-position $v:位置 \
	-rotate $v:回転 \
	-type $f:ドアタイプ \	  //０：左軸 １：右軸 省略時は０
	-exec { $:トリガ $:実行キャラ } \
	-prOc $p:呼び出しプロック \ //$:トリガ $:実行キャラ 
	-flag $i:フラグ \
	-hazard $v:プレイヤー当たり壁点１ $v:プレイヤー当たり壁点２
	
//execのコールされるタイミングとトリガ
// 開け終わったとき     ： トリガ ０
// 取っ手をつかんだとき ： トリガ １
// 取っ手を離したとき   ： トリガ ２
// 開き始めのとき		： トリガ ３
// 閉まりきったとき		： トリガ ４

//フラグ
#enum {
	WT_DOOR_FLAG_NOT_OPEN	= 0x0001,	//開かない
	WT_DOOR_FLAG_OPEN_START = 0x0002	//開いた状態からスタート
} ;


mesg 水密ドア $s:名前 hold[ 0 ] $s:操作キャラ [$i:ハンドルモーション番号]
mesg 水密ドア $s:名前 rotate[ 1 ] $w:回転角度（相対）	//廃止
mesg 水密ドア $s:名前 open[ 2 ] 						//シナリオで開ける（モーション不使用）
mesg 水密ドア $s:名前 hold_end[ 3 ] 
mesg 水密ドア $s:名前 open_end[ 4 ] $s:操作キャラ
mesg 水密ドア $s:名前 rotate2[ 5 ] 						//廃止
mesg 水密ドア $s:名前 door_rotate[ 6 ] 					//廃止
mesg 水密ドア $s:名前 door_rotate2[ 7 ] 				//廃止
mesg 水密ドア $s:名前 door_rotate3[ 8 ] 				//廃止
mesg 水密ドア $s:名前 open_start[ 9 ] $s:操作キャラ [$i:ドアモーション番号]
mesg 水密ドア $s:名前 not_open[ 10 ] $s:操作キャラ [$i:ハンドルモーション番号]
mesg 水密ドア $s:名前 close[ 12 ] 	//開いた状態からスタートしたドアを閉めるメッセージ
mesg 水密ドア $s:名前 handle[ 13 ] $f:on／off	// onで表示 offで非表示

//指定ドアの状態を返す
command 水密ドア状態[NewWatertightDoorStatus] -n $s:名前

//プレイヤーの水密ドア時
//手モーフィング管理
chara 水密ドアプレイヤー手モーフィング管理[NewWtDoorPlayerHandMofingManager] $s:名前 \
		-patterns			$b:右パターン数 $b:左パターン数 \
		-right_hand_cv2		$s:右手用パターン ... \
		-left_hand_cv2		$s:左手用パターン ... \
		-timing_r			$i:切り替えタイミング右 ... \
		-tIming_l			$i:切り替えタイミング左 ... 

//切り替えタイミングの書き方 
//		３つの数で１セット	0,24,2	（モーション番号、フレーム、切り替えパターン）
//		モーション番号の定義：	０：取っ手まわし（正面）
//								１：掴んで引く（左軸）
//								２：掴んで押す（左軸）
//								３：掴んで引く（右軸）
//								４：掴んで押す（右軸）
//								５：取っ手まわし（裏面）
//								６：開けられない


//-------- 自動ジャンプ --------------------------------------------------

command プラグイン自動ジャンプ[NewPluginAutoJump] 

command 自動ジャンプ設定[NewAutoJumpSetting] \
	-motions $i:ジャンプアップ \
			 $i:ジャンプダウンスタート \
			 $i:ジャンプダウンループ \
		   	 $i:ジャンプダウンエンド \
		     [$i:ジャンプアップ張り付きから] \
	-trap $s:処理をするトラップ名（省略するといつも処理する） \
	-climb_height $i:登れる高さ $i:高さ幅 \
	-dir $w:登り降り角度 \
	-flag $i:フラグ \
	-proc $p:プロック	//$:動作 

// motions は強制モーションmar内でのモーション番号
// $:動作 は 0:登り開始 1:登り終了 2:降り開始 3:降り終了
// 登り降り角度が指定してあると、ジャンプ時に、
// 指定dirと指定dir+2048のうち、近いほうを向く

command 自動ジャンプ角度[NewSetAutoJumpDir] -dir $w:角度
//上の登り降り角度設定のみ版


// フラグ
// 0x0001	:	前方に壁があったらジャンプしない

//-------- 落とし穴 --------------------------------------------------

chara 崩落床[NewFallFloor] $s:名前 \
	-position $v:位置 \
	-rotate $v:方向 \
	-mAp $s:マップ名 \
	-model $s:モデル名 \
	-mOtion $s:落下モーションファイル名 $i:落下モーション番号 \
	-hazard $v:床座標 ... \
	-fall_time $i:キャラが乗ってから落ちるまでの時間（フレーム数（自動ＰＡＬ化）） \
	-pRoc $p:崩落開始時プロック
		
//-motion の指定がないときは適当に落ちる
//崩落開始時プロックの$1に崩落させたキャラ名が入る。
//（メッセージで落ちたときは０が入る。）

mesg 崩落床 $s:名前 fall[0]

command プラグイン落下[NewPluginFall]

mesg プレイヤー $s:名前 fall[16] \
	$i:落下開始モーション \
	$i:落下ループモーション \
	$i:落下終了モーション \
	$i:落下終了高さ \
	$i:フラグ $p:落下開始プロック $p:落下終了プロック

//強制モーションmar内に落下セットを持っておく。
//落下終了モーションをつけない場合は、落下終了高さまで
//落下したら終了する。

//フラグ
// 0x0001 :	落ちてもゲームオーバーじゃない
// 0x0002 : 足影ＯＦＦ

//-------- ベルトコンベア --------------------------------------------------

command ベルトコンベア管理[NewBeltConveyerManager] \
	-n $i:ベルト最大数 

command ベルトコンベア登録[NewSetBeltConveyer] \
	-trap $s:トラップ名 \
	-route $i:キャラクタルート番号 $i:ルート内ポイント番号０ $i:ルート内ポイント番号１ \
	-next $i:次のキャラクタルート番号 $i:次のポイント番号 \
	-speed $i:移動スピード \
	-chara $s:対象キャラ 

//-trapで指定した、トラップ内のオブジェクトを
//-routeで指定したポイント１まで移動させる。
//移動ベクトルは、ポイント０→ポイント１

//-nextの、次のキャラクタルートとポイントとは、
//ポイント１に到達した後に向かうポイントのこと。
//指定が無い場合は、ポイント１と同じルートの次のポイントが
//指定される。

//対象キャラは省略可能。
//対象キャラを変えた別ルートを設定することで、分岐させられる。

command ベルトコンベア動作[NewSetBeltConveyerMode] \
	-move \			//動かす
	-stop 			//停止する
//-move と -stop はどちらか一つ

command ベルトコンベア荷物管理[NewBeltObjectManager] 

chara	ベルトコンベア荷物[NewBeltObject] $s:名前 \
	-model $s:モデル名 \
	-position $v:位置 \
	-rotate $v:回転 

mesg ベルトコンベア荷物 $s:名前 position[0] $i:Ｘ位置 $i:Ｙ位置 $i:Ｚ位置
mesg ベルトコンベア荷物 $s:名前 map[1] $s:マップ名

command トラップ内荷物チェック[NewBeltObjCheckInsideTrap] \
	-map $s:マップ名 \
	-trap $s:チェックするトラップ名

//-------- エレベータ --------------------------------------------------

command プラグインエレベータ[NewPluginElevator] 

mesg プレイヤー $s:名前 evpanel[15] $s:入る／出る $i:方向

//エレベータ内でのパネル操作プラグインです。
//仕様：
//	エレベータ内部にプレイヤーしかいない状態でかつ
//	危険モードでなければ、パネル操作モードに入ることができる。
//	パネル操作モード中に、危険モードになるが、エレベータ内に敵が入ってくると
//	強制的にパネル操作モードを抜ける。

chara エレベータ[NewElevator] $s:名前 \
	-map $s:マップ名 \
	-door1 $s:モデル名１ $v:位置１ $i:方向１ $i:スライド距離１ $i:開閉時間１ \
	-dOor2 $s:モデル名２ $v:位置２ $i:方向２ $i:スライド距離２ $i:開閉時間２ \
	-wall $v:扉透明壁位置１ $v:扉透明壁位置２ $i:扉透明壁高さ \
	-close_time $i:開ききってから閉まるまでの時間（秒）\
	-trap $s:エレベータ箱トラップ名 $s:パネル操作トラップ名 \
	-cAmera $v:パネルカメラ位置 $v:パネルカメラ注視点 \
	-panel_proc $p:パネル操作決定時プロック 
	
//エレベータ仕様
//
//openメッセージが来ると、指定した時間（指定がない場合はランダム）経つと開く。
//開いている状態で、エレベータの中に誰かいるときは閉まらない。
//指定時間経過後、中に誰もいないときは閉まる。
//closeメッセージが来ると、強制的に閉まる。
//パネル操作決定時プロックの$1に、どれを決定したかが入る。

mesg エレベータ $s:名前 open[0] $i:開くまでの時間 $p:開き開始時プロック $p:開き終了時プロック
//開くまでの時間に負数を指定すると、ランダムになります。

mesg エレベータ $s:名前 close[1] $p:閉まり開始時プロック $p:閉まり終了時プロック
//強制的に閉めます。普段は使わないでしょう。

mesg エレベータ $s:名前 stagestart[2]
//ステージ開始時にパネルモードから始めるとき、これを送信

//-------- くしゃみ --------------------------------------------------

command プラグインくしゃみ[NewPluginSneeze]

command プレイヤー風邪引かせ[NewPlayerSetCold] \
	-time	$i:くしゃみ間隔（秒）

command プレイヤー風邪直し[NewPlayerRecoverCold]

//-------- ブレード --------------------------------------------------

command プラグインブレード[NewPluginBlade] -motion $s:モーションファイル

//-------- エマと手繋ぎ --------------------------------------------------

command プラグインエマ手繋ぎ[NewPluginGraspEE] -motion $s:モーションファイル

//-------- 透明壁・床 ----------------------------------------------------

chara 透明壁[NewDynamicSegment] $s:名前 \
	-position $i:頂点１Ｘ $i:頂点１Ｙ $i:頂点１Ｚ $i:頂点１高さ \
		  $i:頂点２Ｘ $i:頂点２Ｙ $i:頂点２Ｚ $i:頂点２高さ \
	-attribute $i:アトリビュート \
	-map $s:マップ名

chara 透明床[NewDynamicFloor] $s:名前 \
	-position $i:頂点１Ｘ $i:頂点１Ｙ $i:頂点１Ｚ \
		  $i:頂点２Ｘ $i:頂点２Ｙ $i:頂点２Ｚ \
		  $i:頂点３Ｘ $i:頂点３Ｙ $i:頂点３Ｚ \
		  [$i:頂点４Ｘ $i:頂点４Ｙ $i:頂点４Ｚ] \
	-n_points $b:頂点数（３ｏｒ４） \
	-attribute $i:アトリビュート \
	-map $s:マップ名

mesg 透明壁 $s:名前 kill[0]
mesg 透明壁 $s:名前 on[1]
mesg 透明壁 $s:名前 off[2]
mesg 透明壁 $s:名前 move[3] $i:頂点１Ｘ $i:頂点１Ｙ $i:頂点１Ｚ $i:頂点１高さ \
	 	  	    $i:頂点２Ｘ $i:頂点２Ｙ $i:頂点２Ｚ $i:頂点２高さ
mesg 透明壁 $s:名前 rotate[4] $b:回転モード $i:Ｙ回転
mesg 透明壁 $s:名前 shift[5] $i:シフト量Ｘ $i:シフト量Ｙ $i:シフト量Ｚ

mesg 透明床 $s:名前 kill[0]
mesg 透明床 $s:名前 on[1]
mesg 透明床 $s:名前 off[2]
mesg 透明床 $s:名前 move[3] $i:頂点１Ｘ $i:頂点１Ｙ $i:頂点１Ｚ \
	 	  	    $i:頂点２Ｘ $i:頂点２Ｙ $i:頂点２Ｚ \
	 	  	    $i:頂点３Ｘ $i:頂点３Ｙ $i:頂点３Ｚ \
	 	  	    [$i:頂点４Ｘ $i:頂点４Ｙ $i:頂点４Ｚ]
mesg 透明床 $s:名前 rotate[4] $b:回転モード \
				$i:回転ベクトルＸ $i:回転ベクトルＹ $i:回転ベクトルＺ
mesg 透明床 $s:名前 shift[5] $i:シフト量Ｘ $i:シフト量Ｙ $i:シフト量Ｚ

//回転ベクトルは絶対角度指定
//回転モードについて
//透明壁の場合：０ - 回転中心は頂点１と頂点２の中点
//		１ - 回転中心は頂点１
//		２ - 回転中心は頂点２
//回転ベクトルはＹ成分のみ有効

//透明床の場合：０ - 回転中心は重心
//		１〜４ - 回転中心は頂点１〜４
//		５〜８ - 回転中心は頂点１２頂点２３頂点３４頂点４１の中点


//透明壁属性
#define HZX_SEG_ALL	      0x0000	/* 全ての当たりをチェックする */
#define HZX_SEG_NO_PLAYER     0x0010	/* プレイヤーの当たりチェックをしない */
#define HZX_SEG_NO_ENEMY      0x0020	/* 敵兵の当たりチェックをしない */
#define HZX_SEG_NO_BULLET     0x0040	/* ショットの当たりをチェックしない */
#define HZX_SEG_NO_MISSILE    0x0080	/* ミサイル系の当たり判定をしない */
#define HZX_SEG_NO_C4         0x0100	/* C4爆弾がセットできない */
#define HZX_SEG_NO_RECOIL     0x0200	/* ショットが跳弾しない */
#define HZX_SEG_NO_HARITSUKI  0x0400	/* 張り付かない */
#define HZX_SEG_NO_DISP_RADAR 0x0800	/* レーダーに写らない */
#define HZX_SEG_NO_BULLETHOLE 0x1000	/* 弾痕つかない */
#define HZX_SEG_NO_SPRAY      0x2000	/* スプレーつかない */
#define	HZX_SEG_NO_ENEMY_EYES 0x00010000	/* 敵兵視線通り抜ける */
#define HZX_SEG_NO_KNOCK_SE   0x00020000	/* 壁コンコンならない */

//透明床属性
#define HZX_FLOOR_NO_PLAYER           	0x0010	/* プレイヤーの当たりチェックをしない */
#define HZX_FLOOR_NO_ENEMY            	0x0020	/* 敵兵の当たりチェックをしない */
#define HZX_FLOOR_NO_BULLET           	0x0040	/* ショットの当たりをチェックしない */
#define HZX_FLOOR_NO_MISSILE          	0x0080	/* ミサイル系の当たり判定をしない */
#define HZX_FLOOR_NO_C4              	0x0100	/* C4爆弾がセットできない */
#define HZX_FLOOR_NO_RECOIL           	0x0200	/* ショットが跳弾しない */
#define HZX_FLOOR_NO_CLAYMORE     	0x0400	/* クレイモアがセットできない */
#define HZX_FLOOR_NO_BLOOD            	0x0800	/* 血痕つかない */
#define HZX_FLOOR_NO_BULLETHOLE  	0x1000	/* 弾痕つかない */
#define HZX_FLOOR_NO_SPRAY            	0x2000	/* スプレーつかない */
#define HZX_FLOOR_IK 			0x4000	/* インバース・キネマティクスを適用する */
#define HZX_FLOOR_STEP               	0x8000	/* ここの床は階段である */
#define	HZX_FLOOR_NO_ENEMY_EYES			0x00010000	/* 敵兵視線通りぬける */

//イベント壁
//通常状態でないと通り抜けられない壁
chara イベント壁[NewEventWall] $s:名前 \
	-position $i:頂点１Ｘ $i:頂点１Ｙ $i:頂点１Ｚ $i:頂点１高さ \
			  $i:頂点２Ｘ $i:頂点２Ｙ $i:頂点２Ｚ $i:頂点２高さ
mesg イベント壁 $s:名前 kill[0]

//-------- トラップ ------------------------------------------------------

trap $s:トラップ名 $s:キャラクタ \	//？で全キャラクタ 
	-mask $s:入る／出る／いる／？／＊ \	
	//設定ブロックを実行するタイミング。？で入る／出るの２つ共（いる以外）。
	-and \				//Andモード
	-dir $w:プレイヤー方向 $w:幅 ... \	//0〜4096、+-512の範囲指定	
	-wHich $b:ボタンを見るパッド番号 \ //0が１コン 1が２コン
	-button $w:ボタン ... \		//下記参照
	-key $i:パッド ... \		
	-state $w:プレイヤー状態 ... \	//下記参照
	-time $w:ディレイタイム \	//実行までの待ち時間（未対応）
	-item $w:アイテム ... \		//アイテム切り替え時にもチェック
	-weapon $w:武器 ... \		//武器切り替え時にもチェック
	-aLert $b:アラートモード \	//アラートモード切り替え時にもチェック
	-camera \			//カメラトラップであることを明示
	-proc $p:実行関数 \		// exec、procはどちらか一方
	-exec { $:トラップ名 $:キャラ名 $:トリガ $:X $:Y $:Z }

//mask :
// ？は、「入る／出る」
// ＊は、「いる／出る」をあらわす
//
//...での羅列は、３つまで可能
//<<-and オプションがない場合>>
//３つの or になる。
//たとえば、「立ちかしゃがみの時」という指定は、-state 0,1 で可能
//
//<<-and オプションがある場合>>
//全チェックのAndをORしたチェックになる。（なんだそりゃ）
//たとえば、
//”「立ち状態」で「方向0方向幅256」で「○ボタンが押された時」”または、
//”「張り付き状態」で「方向2048方向幅256」で「ボタンは関係ない」”の
//どちらかが成立する場合、というような指定をしたい時、
//
//  trap 名前 キャラ -mask ＊ \
//	-and \
//	-state  d:TRP_STATE_STAND, d:TRP_STATE_CAUTION \
//	-dir    0,256              2048,256 \
//	-button 0,                 -1
//と記述することで実現できる。

//
//button :
//０：○ １：□ ２：× ３：△
//-keyとの併用は不可。

//key :
//d:PAD_A等で指定できる。
//-button との併用は不可。

//state
//0 立ち 1 しゃがみ 2 匍匐  3 主観  4 張り付き 5 エルード中
//6 強制モーション 7 ロッカーモード 8 ビハインドカメラＯＫ
//現在ここまで。

//-cameraオプションのついているトラップに引っかかるようにするには
//キャラのCONTROL初期化時に、
//	GM_ConfigControlCameraTrapCheck( CONTROL * )
//をコールする必要があります。

#enum {
	TRP_STATE_STAND = 0,				//通常立ち状態
	TRP_STATE_SQUAT,					//しゃがみ
	TRP_STATE_GROUND,					//匍匐、ダウン
	TRP_STATE_SUBJECT,					//主観
	TRP_STATE_CAUTION,					//張り付き
	TRP_STATE_ELUDE,					//エルード
	TRP_STATE_FORCE,					//強制モーション、強制走り
	TRP_STATE_LOCKER,					//ロッカー
	TRP_STATE_BEHINDCAMERA_ENABLE,		//ビハインド可能
	TRP_STATE_LADDER,					//はしご
	TRP_STATE_ENEMY_PULL,				//死体引き摺り
	TRP_STATE_WATER,					//水中
	TRP_STATE_BEHIND,					//ビハインドカメラ中
	TRP_STATE_ROLLING,					//転がり中
	TRP_STATE_INTRUDE,					//イントルード中
	TRP_STATE_BOX,						//ダンボール中
	TRP_STATE_WATER_SURFACE				//水面付近泳ぎ
} ;

// 実行部に渡される引数
// $1:トラップ名 $2:キャラ名 $3:入る／出る／いる 
// $4,$5,$6 : キャラの座標(x,y,z)

//トラップＯＮ／ＯＦＦ切り替え
command トラップ切り替え[NewTrapSwitchCommand] \
	-trap $s:トラップ名 \
	-switch $f:ＯＮ／ＯＦＦ 

// 1 : ＯＮ 
// 0 : ＯＦＦ 

//シナリオトラップ生成
chara シナリオトラップ[NewDynamicTrapScn] $s:名前 \
	-bound $i:最小Ｘ $i:最小Ｙ $i:最小Ｚ \
	       $i:最大Ｘ $i:最大Ｙ $i:最大Ｚ \
	-attribute $i:アトリビュート \
	-map $s:マップ

//アトリビュート
#enum {
 	HZX_TRP_ATR_NO_CHECK = 0x0002	//チェックしない
} ;

//トラップイベント削除
//	シナリオのtrap記述を無効にします。
//	hzx内のトラップを消去するわけではありません。
command トラップ削除[NewRemoveTrapBind] \
	-name $s:トラップ名 ...

//マップチェンジトラップ
command マップチェンジトラップ登録[GM_ComSetMapChangeTrap] \
	-trap $s:トラップ名 \
	-map $s:現在マップ名 $s:変更先マップ名 \
	-chara $s:対象キャラクタ（全キャラの場合は省略）

//-------- その他 ----------------------------------------------------------

//シナリオゲームオーバー
command ゲームオーバー処理開始[GM_GameOverStartScn] \
		-exec { ゲームオーバー処理 } \
		-proc $p:ゲームオーバー処理

//-exec と -proc はどちらか一つ

command ゲームオーバー処理終了[GM_GameOverEndScn]

//Ｏ２ゲージ
chara	Ｏ２ゲージ[NewO2Gage] $s:名前 \
	-max $i:最大値

//ニキータタイマー設定
command ニキータタイマー設定[NewSetNikitaTimer] -time $i:時間

//プレイヤーパッド振動 指定モーション開始時に振動起動
chara プレイヤー振動[NewSetPlayerVibration] $s:名前 \
	-marfile $s:モーションファイル名（ｍａｒ） \
	-order $i:モーションファイル内での順番 \
	-vib_file $s:振動ファイル名（ｖｉｂ）

//影投影ハザード
command	影投影ハザード[NewShadowDropHazard] \
	-name $s:マップ名 \
	-group $b:グループ番号

//スポットライト投影ハザード
command スポットライト投影ハザード[NewSpotDropHazard] \
	-name $s:マップ名 \
	-group $b:グループ番号 

//マップ名を省略すると、現在のマップが使用される


//ＵＳＰを構えたら自動でライトＯＮ
command ＵＳＰライトＯＮ[NewUSPLightOn]

//ハンドガン主観射程設定
command 主観射程距離設定[NewSetSubjectShotLen] -len $i:距離

//ゲーム中のキャラをマルチウェイトモデルにする。
chara マルチウェイトキャラ[NewMultiweightChara] $s:名前 \
		-name $s:マルチウェイトモデルとすげ替えるキャラ \
		-model $s:マルチウェイトモデル名

//ＬＯＤ制御
chara ＬＯＤ制御[NewLoDControl] $s:名前 \
		-name $s:ＬＯＤ制御するキャラ \
		-type $b:ＬＯＤタイプ \
		-model $s:モデル ... \ // HIGH <-----> LOW （４つまで）
		-value $i:ＬＯＤ制御値 ...

//ＬＯＤタイプ
//	0 : プレイヤー状態に依存（状態は、トラップの項のenumと同じ）
//  1 : カメラからの距離に依存

//白い息
chara 白息[NewCharaBreath] $s:名前 \
	-name $s:息を出すキャラ名 \
	-object $b:息を出す関節番号 \
	-shift $v:上の関節中心から息出し位置へのシフト量 \
	-interval $w:息間隔 
mesg 白息 $s:名前 on[ 0 ]
mesg 白息 $s:名前 off[ 1 ]

//跳弾・弾痕登録
//壁・床の音番号に対応した跳弾・弾痕エフェクトの登録

//ノーマル：担当はおかじ
command 跳弾ノーマル[NewEntryNewSpark] -n $b:登録番号
command 跳弾ＳＥのみ[NewEntrySparkOnlySE] -n $b:登録番号

//パイプ水蒸気：担当はおかじ
command	跳弾水蒸気小[NewEntrySteamAttackTargetSmall] -n $b:登録番号 
command	跳弾水蒸気中[NewEntrySteamAttackTargetMiddle] -n $b:登録番号 
command	跳弾水蒸気大[NewEntrySteamAttackTargetLarge] -n $b:登録番号 
//弾痕ノーマル：担当は森田さん
command 弾痕ノーマル[NewEntryWallScar] -n $b:登録番号
command 弾痕じゃじゃじゃ[NewEntryWallJajaja] -n $b:登録番号

//カメラにチェック面（四角形）を設定
//チェック面は最大１６まで
command カメラチェック面ワーク確保[NewMallocCameraSquareWork] 
command カメラチェック面登録[NewSetCheckSquareOfCamera] \
	-points $v:頂点１ $v:頂点２ $v:頂点３ $v:頂点４ \	//時計周りに設定
	-far $i:画面を占める率 \
	-pRoc $p:撮影時プロック

//-far 画面を占める率 とは？
//画面を占める率（％）がこの数字以下だった場合、
//「遠すぎる」と判断される。

//プロックの引数（＄１）
//0 : ＮＧ ／ 4点のうち画面外の点があり、
//		      判定面の中心が画面の中心から３０％以上離れている。
//1 : ＮＧ ／ 「近すぎる」画面外の点があるが、
//		      判定面の中心が画面の中心から３０％以内である。
//				もしくは、画面全部が、チェック面内である。
//2 : ＮＧ ／ 4点は全て画面内だが、当たりがあって見えない点がある。
//
//3 : ＮＧ ／ 「遠すぎる」全て画面内だが、
//				-farで指定した範囲より表示範囲が小さい。
//4 : ＯＫ

//カメラにキャラが映っているか判定
//チェックキャラは最大８まで。
//キャラの起動より後に記述すること
command カメラチェックキャラワーク確保[NewMallocCameraCharaWork]
command カメラチェックキャラ登録[NewSetCheckCharaOfCamera] \
	-name $s:チェックするキャラの名前 \
	-joint $b:チェックする関節番号 \
	-far $i:画面を占める率 \
	-proc $p:撮影時プロック

//プロックの引数（＄１）
//0 : ＮＧ
//1 : ＯＫ

command カメラ撮影時プロック[NewSetCameraProc] \
	-proc $p:カメラ撮影時プロック

//隠し君
chara 隠し君[NewHideMan] $s:名前

//実験君
chara 木偶人形[NewDekuDoll] $s:名前

//実験カメラ
chara キャラカメラ[NewCharaTraceCamera] $s:名前 \
	-c $s:追従キャラ名 \
	-s $v:シフト量 \
	-r $v:回転角度 

//Ｃ４爆発メッセージ
mesg Ｃ４ $s:名前 bomb[0]

//プロックの連続実行
chara プロック連続実行[NewExecProcContinual] $s:名前 \
	-proc $p:プロック \
	-exec { 実行ブロック } \
	-time $i:連続実行フレーム数（マイナス値を指定するといつまでも）\
	-end_pRoc $p:終了プロック \
	-end_eXec { 実行ブロック }

//proc, exec はどちらか一つ
//$1として、残り回数が渡される
//end_proc, end_exec もどちらかひとつ
//引数はありません

mesg プロック連続実行 $s:名前 kill[0]

chara 解体Ｃ４[NewSetKaitaiC4] $s:名前 \
	-position $v:位置 \
	-rotate $v:回転 \
	-type $b:タイプ（０／１：臭いあり／なし） \
	-state $b:初期状態（０／１：通常／凍結） \
	-enemy $s:つける敵の名前 $i:関節番号 \
	-prOc $p:プロック

//プロックの$1には、$s:名前が入る
//プロックが呼ばれるのは状態に変化があったとき＆ステージ終了時
//プロックの$2には、爆発時($2==0)、凍結時($2==1)、通常時($2==2)が入る
//-enemyを使うとき、-positionには、その敵の腰からの相対ベクトルを入れる。

chara 設置クレイモア[NewScenarioClaymore] $s:名前 \
	-position $v:位置 \
	-rotate $v:回転 \
	-prOc $p:終了プロック

//終了プロックは $1 に、
//	0 : 爆破せずにステージ終了（ロード、リスタート）
//	1 : 爆発した。
//  2 : 回収された。
//が入る。

//テストエマ
command テストエマ初期位置[NewComEETestSetStartPos] \
	-position $v:位置 \
	-rotate $v:方向

//--------------------------------------------------------------------- 
//是角 /user/korekado

chara コマンダー[NewCommander] $s:名前 \
	-w $p:警備コマンダーproc ... \
	-a $p:攻撃コマンダーproc ... \
	-r $v:復活場所 $s:マップＩＤ ...4 \
	-c $v:待機場所 $s:マップＩＤ ...4 \
	-p $w:クリアリングエリア $w:ルート $w:ポイント $p:プロック ...4 \
	-v $d:音声 ... \
	-x $d:司令官危険音声 ... \
	-y $d:司令官警戒音声 ... \
	-g $b:銃ライト \
	-m $i:危険モード \
	-z $i:麻酔持続時間 \
	-b $i:危険モードでの復活人数 

mesg コマンダー $s:名前 視界オフ[0]
mesg コマンダー $s:名前 視界オン[1]
mesg コマンダー $s:名前 待機所替え[2] $i:待機所番号
mesg コマンダー $s:名前 警戒体制変更[3] $i:警戒体制番号
mesg コマンダー $s:名前 引き釣られ兵消す[4]

command セットクリアリング[COM_SetClearingData] \
	-p $w:クリアリングエリア $w:ルート $w:ポイント $p:プロック ...4 \
	-i $w:ルート指定 ...

command チェンジクリアリングルート[COM_ChangeClearingRoot] \
	$s:敵兵名 -r $w:チェンジルート -p $w:チェンジポイント番号

command クリアリングキャンセル[COM_ClearingCancel]

command クリアリングから通常回避へ[COM_ClearingGoNormal]

command ゲット敵兵座標[COM_GetEnemyPos] \
	$s:敵兵名 $r:Ｘ座標変数 $r:Ｙ座標変数 $r:Ｚ座標変数

command ゲット敵兵状態[COM_GetEnemyStatus] \
	$s:敵兵名 $r:敵兵状態

command ゲット敵兵状態２[COM_GetEnemyStatus2] \
	$s:敵兵名 $r:敵兵状態

command ゲット敵兵状態拡張版[COM_GetEnemyStSt] \
	$s:敵兵名 $r:敵兵状態

command ゲット敵兵アクション[COM_GetEnemyAction] \
	$s:敵兵名 $r:ルート番号 $r:ポイント番号 $r:アクション番号

command ゲット捕まえられ兵の名前[COM_GetCaptureModelName] $r:敵兵モデル名

command ゲット捕まえられ兵の本当の名前[COM_GetCaptureName] $r:敵兵モデル名

chara 警備コマンダー[NewWcCommander] $s:名前 \
	-e $p:警備兵proc ...

chara 警備兵[NewWatcher] $s:名前 -r $b:初期ルート -n $b:初期ノード -d $v:初期守備位置 $s:マップ \
								-s $w:ステータス -i $w:視力 ... -l $w:ライフ値 -f $w:気絶値 \
								-e $p:終了proc ... -b $b:個別ＢＧＭ -h $w:聴力 -v $w:声優\
								-q $p:アイテムプロック $b:確率 ...2 \
								-a $p:ホールドアップアイテムプロック $b:確率 ...2 \
								-w $p:気づいた時プロック

mesg 警備兵 $s:名前 ルート変更[1] $i:ルート番号 $i:守備位置Ｘ $i:守備位置Ｙ $i:守備位置Ｚ $s:マップ [$i:ポイント番号]

/* 敵兵共通メッセージ */
mesg 敵兵共通 $s:名前 トラップ影ＯＮ[256]
mesg 敵兵共通 $s:名前 トラップ影ＯＦＦ[257]

mesg 敵兵共通 $s:名前 アクションスタート[258]

//mesg 警備兵 $s:名前 ルート変更[1] $i:ルート番号 $i:守備位置Ｘ $i:守備位置Ｙ $i:守備位置Ｚ

// ステータス	1で２１関節兵の実験モード

//chara 攻撃兵[NewAttacker] $s:名前 -r $b:初期ルート

chara サポート兵[NewSupport] $s:名前 -r $b:初期ルート -b $s:サポートする兵の名前 -s $w:ステータス \
								 -i $w:視力 ... -l $w:ライフ値 -f $w:気絶値 -e $p:終了proc ... \
								  -h $w:聴力 -q $p:プロック $b:確率 ...2 -v $w:声優
//	サポート兵は必ずサポートする兵より後にセットすること

chara プットオブジェ[NewPutObject] $s:名前 -m $s:オブジェクト名 ... -r $v:向き -p $v:場所  -l $s:光源 \
									-s $v:スケール  -f $w:フラグ  -t $i:ＬＯＤ閾値 ...
mesg プットオブジェ $s:名前 off[0]
mesg プットオブジェ $s:名前 on[1]
mesg プットオブジェ $s:名前 turn[2] $i:Ｘ軸方向 $i:Ｙ軸方向 $i:Ｚ軸方向
mesg プットオブジェ $s:名前 move[3] $i:位置Ｘ $i:位置Ｙ $i:位置Ｚ
mesg プットオブジェ $s:名前 preshade[4] 
mesg プットオブジェ $s:名前 kill[5] 

//スケールは１００が標準の大きさ、２倍にしたかったら２００、半分なら５０
chara プットモデル[NewPutModel] $s:名前 -m $s:オブジェクト名 ... -r $v:向き -p $v:場所  -l $s:光源 \
									-s $v:スケール  -f $w:フラグ  -t $i:ＬＯＤ閾値 ...

chara 船倉兵[NewHoldEnemy] $s:名前 	\
	-a $s:名前 $v:場所 $v:方向 $w:モデル番号 $w:スケール $w:モーション $w:アイテム ...11 \
	-t $i:ＬＯＤ閾値 ... -s $v:みるべき場所 ... \
	-c $v:場所 $w:向き $s:カメラマン名 $s:ターゲット名 ...6 \
	-w $w:最初の見つめる場所 \ /* 0:プロジェクタ1 1:プロジェクタ２ 2:スコット */
	-m $w:モード \
	-b $p:パンツプロック \
	-e $p:プロック ... -p $v:プロジェクター場所 $v:方向 $w:視野 ...7

mesg 船倉兵 $s:名前 通常状態[0]
mesg 船倉兵 $s:名前 スクリーン２[2]
mesg 船倉兵 $s:名前 スコットを見る[16]
mesg 船倉兵 $s:名前 スクリーン１[17]

mesg 船倉兵 $s:名前 右を向け[3]
mesg 船倉兵 $s:名前 左を向け[4]
mesg 船倉兵 $s:名前 後を向け[5]
mesg 船倉兵 $s:名前 前を向け[6]

mesg 船倉兵 $s:名前 右に銃を向けろ[7]
mesg 船倉兵 $s:名前 左に銃を向けろ[8]
mesg 船倉兵 $s:名前 後に銃を向けろ[9]
mesg 船倉兵 $s:名前 前に銃を向けろ[10]

mesg 船倉兵 $s:名前 右に首を向けろ[11]
mesg 船倉兵 $s:名前 左に首を向けろ[12]
mesg 船倉兵 $s:名前 下に首を向けろ[13]
mesg 船倉兵 $s:名前 前に首を向けろ[14]
mesg 船倉兵 $s:名前 上に首を向けろ[15]

mesg 船倉兵 $s:名前 アメリカンジョーク[18]


mesg 船倉兵 $s:名前 ライターを落とせ[64] $s:兵隊名前 $i:発生場所Ｘ $i:発生場所Ｙ $i:発生場所Ｚ

mesg 船倉兵 $s:名前 プロジェクタ１動け[66]
mesg 船倉兵 $s:名前 プロジェクタ２動け[67]
mesg 船倉兵 $s:名前 プロジェクタ１止まれ[68]
mesg 船倉兵 $s:名前 プロジェクタ２止まれ[69]

mesg 船倉兵 $s:名前 ルート変更[ 1 ] $i:ルート番号 $i:ポイント番号

/*	
プロックはセットした順に 「通常発見時」「プロジェクタ1で発見時」「プロジェクタ2で発見時」
に呼ばれます
プロジェクタには "chara 静止スポットライト設置" で設定した場所と方向を入れてください
プロジェクタは２つまで。
*/

command ゲット船倉兵座標[HLD_GetHoldPosition] \
	$s:敵兵名 $r:Ｘ座標変数 $r:Ｙ座標変数 $r:Ｚ座標変数

chara 天井君[NewCeiling] $s:名前 \
	-m $s:オブジェクト名 -p $v:場所  -l $s:光源 -v $p:表示切替えプロック -h $i:高さ \
	-c $v:チェック座標 -a $b:チェック軸 \
	-n $v:チェック軸方向直接指定

mesg 天井君 $s:名前 常に表示[1]
mesg 天井君 $s:名前 常に表示ＯＦＦ[2]

// -h と -c,-a,-n 及び -a と -n は共に排他オプションです
// -h を使う場合はそれだけで完結（従来と同様）
// -c を使う場合は -a もしくは -n でチェック軸の方向を指定（指定しないとY-になる）
// -c で指定する座標は判定を行なう平面上の任意の座標です
// （意味的にはその座標をチェック方向に越えると表示ONになる）
// -a に指定する値
// 0 ... X軸方向+でチェック
// 1 ... X軸方向-でチェック
// 2 ... Y軸方向+でチェック
// 3 ... Y軸方向-でチェック （デフォルト）
// 4 ... Z軸方向+でチェック
// 5 ... Z軸方向-でチェック
// -n はチェック方向直接指定。チェック方向のベクトルを指定。これを使うと斜めなども指定できる
// -a 3 は -n 0,-100,0 と同義である


chara サウンドマネージャー[NewSoundManager] $s:名前 \
			-pak $i:サウンドパック番号 \
//			-b $i:BGM -a $i:常駐ＳＥ -e $i:ＳＥ -w $i:ＷＡＶＥ ... \
			-s $i:ステータス
mesg サウンドマネージャー $s:名前 SD_CODE[0] $i:サウンドコード
mesg サウンドマネージャー $s:名前 SD_AUTO[1] $i:サウンドコード

chara ＢＧＭマネージャー[NewBGMManager] $s:名前 \
			-s $i:ステータス
mesg ＢＧＭマネージャー $s:名前 SD_SNEAK_AUTO[0] $i:オートフェーダーコード

command ＳＥセットモード[GM_SeSetModeGcl] -s $w:音番号 -p $v:発生場所  -m $w:モード
command セットノイズ[GM_SetNoiseGcl] -n $w:ノイズ種類 -p $v:発生場所  -m $s:マップ
command セットサウンドコード[GM_SdSetGcl] -c $i:サウンドコード

chara 死体君[NewCorpGcl] $s:名前 -m $s:モデル名 -d $w:ポーズ -p $v:場所 -r $v:方向 \
			 -n $w:初期モーション番号  -s $i:ステータス -e $s:マルチウェイトモデル \
			 -q $p:プロック $b:確率 ...2

mesg 死体君 $s:名前 kill[-1]

chara ＢＧＭ風音[NewWindNoise] $s:名前 

chara ＢＧＭフェーダー[NewBgmFader] $s:名前 	\
	-t $i:トラック番号 -a $v:場所 $v:サイズ $s:マップ名  ...7 -s  $i:ステータス


command ゲットゲームステータス[GM_GetGameStatusForScn] \
	$r:ゲームステータス

chara ＮＰＣサンプル君[NewNPCSample] $s:名前 -s $i:スピード -p $v:場所

mesg 死体君 $s:名前 モードチェンジ[0] $i:モード $i:ゾーン
//モード 0:ノーマル
//モード 1:ゾーンへ移動


#enum {
	STATE_GAMEOVER  =	0x80000000		/* ゲームオーバー処理中 */
} ;
//--------------------------------------------------------------------- 
// 高部管理分
// <Takabe>

// ====== 実験関連キャラクタ定義
chara 高部実験プログラム[NewTestProgram] $s:名前
chara てすと[NewPrimTestProgram] $s:name
chara Prim2TestProgram[NewPrim2TestProgram] $s:名前
chara EvmTestProgram[NewEvmObjectTest] $s:name
chara DmapackTestProgram[NewDmapackTestProgram] $s:name
chara BlurTestProgram[NewBlurTest] $s:name
chara MenuPrintTest[NewMenuPrintTest] $s:name
chara ModelTest[NewModelTestProgram] $s:name
chara PatchTestProgram[NewPatchTestProgram] $s:name
chara IKDoll[NewInversKinematicTest] $s:name -pos $v:中心座標 -rot $v:初期向き
command VRAM初期化[NewVramInitialize]
// ====== 実験関連キャラクタ定義終了

chara 影投影モデル[NewShadowDrawObjectSet] $s:名前 \
	-model $s:影投影専用モデル \
	-pos $v:設置位置
// 影投影用モデルを設置する
// 「スポットライト投影モデル」キャラとは排他である

chara スポットライト投影モデル[NewSpotDrawObjectSet] $s:名前 \
	-model $s:影投影専用モデル \
	-pos $v:設置位置
// スポット投影用モデルを設置する
// 「影投影モデル」キャラとは排他である

chara 静止スポットライト設置[NewPutStaticSpotLight] $s:名前 \
	-pos $v:設置位置 \
	-dir $v:光源方向（自動的に正規化される） \
	-range $w:有効距離 \
	-angle $b:円錐角度（１度単位で、最大は１８０未満） \
	-color $b:光源色（赤） $b:光源色（緑） $b:光源色（青） \
	-fadeproc $p:フェードイン・アウト用コールバック \
	-option $i:オプションフラグ
mesg 静止スポットライト設置 $s:名前 on[1]
mesg 静止スポットライト設置 $s:名前 off[0]
mesg 静止スポットライト設置 $s:名前 fadein[2] $w:カウント（１／３００秒単位）
mesg 静止スポットライト設置 $s:名前 fadeout[3] $w:カウント（１／３００秒単位）
// スポットライトを設置する
// . . . .
// 同じ名前の「スポットライト投影モデル」を予め置いていないと効果がない
// フェードイン・アウトには終了検出用のコールバック用procを設定可能
// オプションフラグ詳細
//  0x0001:-dir指定を方向ベクトルではなく回転ベクトルとして認識
//  0x0002:OFF状態で起動する（デフォルトはONで起動）
//  0x0004:キャラに反映するライトを置かない（スポットライト投影のみに）
//  0x0010:高速画角切替え（おそらく使用しない）
//  0x0020:レイブン影用Y軸回転アニメーション
//  0x8000:デバッグ機能ＯＮ（２コンＬ１を押しながら操作）

command 壁床効果音設定[NewSetExchangeSeCode] \
	-id $b:変換テーブルID（０〜１２７） \
	-type $b:属性設定（０：床、１：壁） \
	-se $i:変換対象コード \
	-data $w:音コード $b:ノイズ音量 ...2 \	// 必ず８セット書くこと
	-clear // 内部のリストを全てクリアする（普通は使用しない）
// ノイズ音量定義
#enum {
	NOISE_ZERO ,
	NOISE_HOLD ,
	NOISE_DEC ,	/* 拳銃デコック */
	NOISE_SS ,	/* 至近距離なら反応で白？ */
	NOISE_S,
	NOISE_CHOUDAN,	/* 跳弾御 */
	NOISE_SCREAM,
	NOISE_MM,
	NOISE_M,
	NOISE_L,
	NOISE_LL
};
// 壁床の効果音鳴らし分け用リストを作成する
// １回のコマンドで１つだけセットする（複数設定する場合には複数記述）
// 変換対象コード１つに対し、音コードは壁床属性番号に対応しているため
// 必ず８つ必要すること。
// また、変換テーブルIDはプレイヤーキャラやコマンダーキャラの様な
// 効果音を発生させるキャラに渡す必要があります。このID毎に違うもの
// 設定し、敵キャラにこの固有のIDを渡すことによりキャラ毎に異なる
// SEをならすことも可能です。

chara 遠景ぼかし[NewFarFocusEffectSet] $s:name \
	-plane	$b:最大描画枚数 \
	-near	$i:ぼかし最小距離 \
	-far	$i:ぼかし最大距離 \
	-enable // 起動時にオン
mesg 遠景ぼかし $s:名前 off[0]
mesg 遠景ぼかし $s:名前 on[1]
mesg 遠景ぼかし $s:名前 set[2] $w:補間時間 $b:補間タイプ $i:ぼかし最小距離 $i:ぼかし最大距離
// 最大距離と最小距離との間を最大描画枚数で指定した段階でぼかす
// メッセージにより途中で補間しながら影響距離を変更できる
// このときの補間時間は1/60秒単位ではなく1/300秒単位なので注意すること

chara 近景ぼかし[NewNearFocusEffectSet] $s:name \
	-plane	$b:最大描画枚数 \
	-near	$i:ぼかし最大距離 \
	-far	$i:ぼかし最小距離 \
	-enable // 起動時にオン
mesg 近景ぼかし $s:名前 off[0]
mesg 近景ぼかし $s:名前 on[1]
mesg 近景ぼかし $s:名前 set[2] $w:補間時間 $b:補間タイプ $i:ぼかし最大距離 $i:ぼかし最小距離
// 最大距離と最小距離との間を最大描画枚数で指定した段階でぼかす
// メッセージにより途中で補間しながら影響距離を変更できる
// このときの補間時間は1/60秒単位ではなく1/300秒単位なので注意すること

chara 鏡面モデル管理[NewMirrorControl] $s:name \
	-pos	$v:鏡面座標 \
	-axis	$b:反点軸		// 0:X軸反点 1:Y軸反点 2:Z軸反点
mesg 鏡面モデル管理 $s:名前 add[0] $s:追加キャラ
mesg 鏡面モデル管理 $s:名前 del[1] $s:削除キャラ
// 指定した座標で指定した軸方向に反転したモデルを生成する
// メッセージにより追加、削除ができるので部屋の入口のトラップなどに
// 引っかけて使用すると良い

chara 臨時顔アニメキャラ[NewE3FaceAnimationSet] $s:name \
	-chara	$s:キャラクタ名
mesg 臨時顔アニメキャラ $s:名前 モーション再生[0] $s:モーション名 $w:補間時間
mesg 臨時顔アニメキャラ $s:名前 視線変更[1] $w:タイプ [$w:補間時間 $v:注目座標]
// E３素材取り専用マルチウェイトエンベロープモデル顔アニメキャラ
// メッセージによりコントロールする（時間は全て1/300秒単位）
// ＜モーション再生コマンド捕捉＞
//  モーション名にはrmtファイルのファイル名を指定
// ＜視線変更コマンド捕捉＞
//  $w:タイプ = -1 視線はモーションに依存（補間時間、注目座標の指定は必要なし）
//            =  0 絶対座標による注目座標指定
//            =  1 頭部モデルからの相対座標による注目座標指定
//            =  2 カメラ目線（注目座標の指定は必要なし）
//  

chara 顔アニメキャラ[NewFaceAnimationSet] $s:name \
	-fanim	$s:フェイスアニメファイル指定 \
	-chara	$s:キャラクタ名
mesg 顔アニメキャラ $s:名前 モーション再生[0] $s:モーション名
mesg 顔アニメキャラ $s:名前 視線変更[1] $w:タイプ [$w:補間時間 $v:注目座標]
// マルチウェイトエンベロープモデル顔アニメキャラ
// メッセージによりコントロールする（時間は全て1/300秒単位）
// ＜視線変更コマンド捕捉＞
//  $w:タイプ = -1 視線はモーションに依存（補間時間、注目座標の指定は必要なし）
//            =  0 絶対座標による注目座標指定
//            =  1 頭部モデルからの相対座標による注目座標指定
//            =  2 カメラ目線（注目座標の指定は必要なし）
//  

chara スポットライト背景イメージ指定[NewSpotLightImageSet] $s:name \
	-image $s:テクスチャ名（raw形式イメージなので注意！（RGBARGBA・・・））\
	-file $s:ＩＰＵデータ名（stm形式をraw形式にリネームしたもの）\
	-movie $t:ムービー指定（ＩＰＵ形式ストリーム） \
	-proc $p:コールバック
mesg スポットライト背景イメージ指定 $s:名前 停止[0]
mesg スポットライト背景イメージ指定 $s:名前 イメージ変更[1]
mesg スポットライト背景イメージ指定 $s:名前 ムービー再生[2] $t:ムービー指定（ＩＰＵ形式ストリーム）
// スポットライト投影のプリミティブ描画のスポットライト模様の変わりに
// 使用する背景イメージを指定する
// IPUストリームによるムービーも再生可能
// IPUストリーム再生時に再生開始直後は$1=0、再生終了後直後は$1=1が設定され
// コールバックが呼ばれる

chara 嵐の川波[NewStormyRiverWaveSet] $s:name \
	-tex $s:ＴＲＩファイル名 $s:テクスチャ名 $s:波頭テクスチャ \
	-pos $v:中心座標 \
	-ambient $b:ローカル環境光Ｒ $b:ローカル環境光Ｇ $b:ローカル環境光Ｂ \
	-color $b:ローカル並行光Ｒ $b:ローカル並行光Ｇ $b:ローカル並行光Ｂ \
	-dir $v:ローカル並行光ベクトル \
	-invisible $v:非表示バウンディング最小値 $v:非表示バウンディング最大値
mesg 嵐の川波 $s:名前 水しぶき発生[0] $s:キャラ名
// タンカー編用波オブジェクト
// テクスチャはこの波プログラム専用のテクスチャ単体でPACK_ALLしたTRIファイルが必要なので注意
// メッセージを送るとそのキャラが着水した場合に水しぶきを発生させることができる。

#if 0
chara キラキラ水面[NewReflectionWaterSurfaceSet] $s:name \
	-tex $s:ＴＲＩファイル名 $s:テクスチャ名 \
	-pos $v:中心座標 \
	-invisible $v:非表示バウンディング最小値 $v:非表示バウンディング最大値
mesg キラキラ水面 $s:名前 水しぶき発生[0] $s:キャラ名
// 室内用水面オブジェクト
// テクスチャはこの波プログラム専用のテクスチャ単体でPACK_ALLしたTRIファイルが必要なので注意
// このキャラは使わない
#endif

chara キラキラ水面２[NewReflectionWaterSurface2Set] $s:name \
	-tex $s:ＴＲＩファイル名 $s:テクスチャ名 \
	-pos $v:中心座標 \
	-force $w:波影響倍率（デフォルト＝１０） \
	-ctrl \	// これをつけると水面コントロールキャラによる水面高さの変更が可能に
	-invisible $v:非表示バウンディング最小値 $v:非表示バウンディング最大値
mesg キラキラ水面２ $s:名前 波発生源追加[0] $s:キャラ名
mesg キラキラ水面２ $s:名前 波発生源削除[1] $s:キャラ名
mesg キラキラ水面２ $s:名前 表示位置移動[256] $v:座標
mesg キラキラ水面２ $s:名前 波影響倍率[257] $w:倍率（デフォルト＝１０）
// 室内用水面オブジェクト
// テクスチャはこの波プログラム専用のテクスチャ単体でPACK_ALLしたTRIファイルが必要なので注意
// メッセージを送るとそのキャラの動きによって水面に波が立つ。

chara プラント海面[NewSeaSurfaceSet] $s:name \
	-tex $s:ＴＲＩファイル名 $s:テクスチャ名 $s:テクスチャ名 \
	-pos $v:中心座標 \
	-invisible $v:非表示バウンディング最小値 $v:非表示バウンディング最大値
mesg プラント海面 $s:名前 表示位置移動[256] $v:座標
// テクスチャはこの波プログラム専用のテクスチャ単体でPACK_ALLしたTRIファイルが必要なので注意

chara 浮き橋[NewFlotingBridgeSet] $s:name \
	-pos $v:始点座標 $v:終点座標 \
	-n $w:配置個数 \
	-model $s:モデル名 \
	-flag $w:フラグ
mesg 浮き橋 $s:name 動的床強制更新禁止[0]
mesg 浮き橋 $s:name 動的床強制更新開始[1]
// キャラ「プラント海面」が起動していなければならない。（w32a用）
// 指定した２点間に指定した個数の足場モデルを海面に浮かせる
// 浮き橋の上にＮＰＣなどを乗らせる場合には「動的床強制更新開始」
// メッセージを送らなければならない。動的床強制更新は処理が重たいので
// 必要がなくなったら「動的床強制更新禁止」メッセージを送る必要がある

chara 影管理[NewShadowControl] $s:name \
	-type $b:光源タイプ \
	-length $i:光源距離（並行光源時のみ有効）
mesg 影管理 $s:名前 add[0] $s:追加キャラ [$s:投影モデル名指定]
mesg 影管理 $s:名前 del[1] $s:削除キャラ
// 光源タイプ
//   0:無限遠並行光源（ステージの平行光に対して）
//   1:点光源エミュレーション（影フラグのついた点光源に対して）
// メッセージにより追加、削除ができるので部屋の入口のトラップなどに
// 引っかけて使用すると良い
// 投影モデル名指定を指定することで特定の投影モデルのみに投影することが可能
// また、すでに影を表示しているキャラに対してさらにaddでメッセージを
// 送ると投影モデル名のみの変更が可能です。


// </Takabe>
// <libdg>

command カメラ視界チェック[NewViewCheckCommand] \
	-camera $b:カメラフラグ \
	-pos $v:チェック座標 \
	-bound $v:バウンディング座標０ $v:バウンディング座標１ 
// チェック座標もしくはバウンディングがカメラの視界内に入っているかをチェックする
// 視界内に全て、もしくは一部が入っている場合に１が返り、そうでなければ０が返る
// カメラフラグは以下のビットフラグの論理和で指定する
// 0x01 - メインカメラ
// 0x02 - サブカメラ
// 0x04 - ＜予約＞
// 0x08 - ＜予約＞
// 座標でのチェックとバウンディングでのチェックはどちか一方のみ有効なので注意！

command メインスクリーンサイズ変更[NewScreenSizeChange] \
	-scale $w:スケール
// メイン画面の描画領域サイズを強制的に変更する（使用には十分注意すること）
// スケールは1~256で指定し、256で通常の大きさになる

// </libdg>
// <mode/menu>

chara メニューフナムシ[NewMenuShipwormSet] $s:名前 \
	-speed $w:レーション食いつぶしスピード（秒単位）
mesg メニューフナムシ $s:名前 remove[0]
mesg メニューフナムシ $s:名前 transfer[1]
// transferメッセージで取り付き開始
// removeメッセージで強制的に排除することも可能

// </mode/menu>
// <demo>

chara デモ再生実験[NewPolygonDemoFile] $s:名前 \
	-d 'ファイル名' \
	-wait 
mesg デモ再生実験 $s:名前 起動[0]
// ファイルからデモを起動
// -waitオプションをつけることでメッセージが発行されるまで再生を開始しない
// （但し実際にはメッセージは受けとらない）

// </demo>
//--------------------------------------------------------------------- 


