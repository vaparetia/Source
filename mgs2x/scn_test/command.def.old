//--------------------------------------------------------------------- 
//森田

//中心位置から10ユニットずつ前後左右に広がります。(デフォルト 0,-2000, 0)
//うねり周期は、0 厳禁。周期なので大きいほど遅くなります。(デフォルト 256)
chara 波面[NewOceanWave] $s:名前 \
	-s $w:うねり周期 \
	-t $s:テクスチャ名 \
	-p $v:中心位置 \
	-n $i:波涛個数 \           //（最大5個）
	-no_sOund \   // 音を鳴らしたくない
	-b $i:位置パラメータ ... \ // posx, posy, posz, size, roty, alpha
	-x $i:非表示領域位置X $i:非表示領域位置Z $i:非表示領域幅X $i:非表示領域奥行Z \
	-w $i:ブロック数（X） $i:ブロック数（Z）
// posx posz 波涛出現位置
// posy      波涛発生高さの条件
// size      波涛の高さ
// roty      波涛の向き（4096 = 360deg）
// alpha     波涛のα調整（-薄い  +濃い）

chara ブレットバリア[NewBulletBarriar] $s:名前 \
        -mode $i:モード \
        -pos  $v:発射位置
//見えない所から銃が撃ってきてふっ飛ぶキャラです。
//モードは、関係なし
mesg ブレットバリア $s:名前 領域に入る[0]
mesg ブレットバリア $s:名前 領域を出る[1]


chara 弾痕[NewWallScarBase] $s:名前 \
        -u $i:ユニット数
mesg 弾痕 $s:名前 on[1]
mesg 弾痕 $s:名前 off[0]

chara ゴキブリ[NewCockRoach] $s:名前 \
	-model       $s:ゴキブリモデル名 \
	-emerge_spot $v:発生位置 ... \
	-hiding_spot $v:隠れ位置 ... \
	-number      $i:ゴキブリの数 \
	-flag        $i:フラグ



//壊れ用 当たりのハザードＩＤ
//以下壊れ物キャラにおいてハザードＩＤに使用するためのフラグ
#define BRK_HZD_W01A1_STAIRWAY  1
#define BRK_HZD_W01A1_BAR       2
#define BRK_HZD_W01A1_TV_SPACE1 3
#define BRK_HZD_W01A1_TV_SPACE2 4
#define BRK_HZD_W01F_STAIRWAY   1
#define BRK_HZD_W01F_BAR        2
#define BRK_HZD_W01F_TV_SPACE1  3
#define BRK_HZD_W01F_TV_SPACE2  4
#define BRK_HZD_W01D_STORAGE    5
#define BRK_HZD_W01D_KITCHEN    6
#define BRK_HZD_W01D_DINING_L   7
#define BRK_HZD_W01D_DINING_R   8
#define BRK_HZD_W01D_DINING     9
#define BRK_HZD_W01F_BAR2       10
#define BRK_HZD_W01F_BAR3       11

#define BRK_HZD_W11C_FORTUNE    12


chara プット壊れオブジェ[NewPutBreakObject] $s:名前 \
	-model    $s:壊れ前モデル名 $s:壊れ後モデル名 ... \
	-param    $i:パラメータ ... \
	-light    $s:光源 \
	-number   $i:物体の数 \
	-radius   $i:物体の半径 \
	-stable   $i:安定度 \
	-explode  $i:破裂度 $i:破裂時の跳ね度 \
        -hAzard   $i:ハザードＩＤ \
	-human    $i:登録できる足の人数 \
	-box      $s:箱のモデル \
	-geometry $i:箱のパラメータ ... \
	-dust     $i:カス出しモード \
	-brk_sE   $i:壊れの時のSE \
	-drp_Se   $i:落ちるの時のSE \
	-proC     $p:壊れぷロック \
	-Broken   $f:壊れフラグ \
	-flag     $i:フラグ
// -model   壊れ前のモデル 壊れ後のモデル [壊れかすのコモデル (なくてもいい)]
//	の順番に指定する
// -light   指定するとプリシェードで、なければシェードで表示する。
// -param px,py,pz, rx,ry,rz  ... （必須）
//	px,py,pz 初期位置
//	rx,ry,rz 初期角度
// -number  物体の数（必須）
// -explode 破裂度 0〜100目安（事実上上限はない） 破裂時の跳ね度 0〜100目安
// -radius  物体の大きさ(半径) なければ幅をモデルより自動的に検出する
// -stable  物体の安定度 0〜100  大きければ安定性大
// -hazard  壊れ当たりを指定する。BRK_HZD_????で定義されている物を使うこと
// -human   登録した人の足に物体が反応する（登録はメッセージで）
// -dust    カスを出すモード
//	0 はカボチャのカス
//	1 はガラスのカス
// -flag    フラグは、以下の意味をなす。（必須）
//	BRK_COLLISION	物体同士の当たり(sphereの球形当たり)を見る
//	BRK_STRICT_FLR  ポリゴンの形通りに床に接する（少し重い、頂点数に比例）
//	BRK_ROLLOVER    動く時には転がる
//	BRK_NO_GRAVITY  本体に重力なし
//	BRK_STABLE_X    X軸に対し安定している
//	BRK_STABLE_Y    Y軸に対し安定している
//	BRK_STABLE_Z    Z軸に対し安定している
//	BRK_NO_BOXSHOW  箱の表示なし
//	BRK_NO_BOXTRG   箱のターゲット及び当たり無し
//      BRK_RND_DRP_SE  落ちた時にランダムにSEを鳴らす（ランダム幅は４）
//      BRK_RND_BRK_SE  壊れた時にランダムにSEを鳴らす（ランダム幅は４）
#define BRK_COLLISON    0x00000001
#define BRK_STRICT_FLR  0x00000002
#define BRK_ROLLOVER    0x00000004
#define BRK_NO_GRAVITY  0x00000008
#define BRK_STABLE_X    0x00000010
#define BRK_STABLE_Y    0x00000020
#define BRK_STABLE_Z    0x00000040
#define	BRK_NO_BOXSHOW  0x00000080
#define BRK_NO_BOXTRG   0x00000100
#define BRK_RND_DRP_SE  0x00000200
#define BRK_RND_BRK_SE  0x00000400
mesg プット壊れオブジェ $s:名前 foot[0] $i:オブジェクトへのポインタ
//このメッセージにより 登録した人の足に物体が反応するようになる
//0 ならプレーヤの足を登録する
mesg プット壊れオブジェ $s:名前 もう壊れている[1]


