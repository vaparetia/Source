//岡嶋 okajima

chara 漏電火花[NewShortSparkLine] $s:名前 \
	-p $i:中心座標 ... 		// XYZ データ数３個


chara スリット光[NewSlitLight] $s:名前 \
	-p $i:中心座標 ... \		// XYZ データ数３個
	-n $i:法線 ... \		// XYZ データ数３個
	-d $i:光線の絶対方向 ... \	// XYZ データ数３個
	-l $i:光線の到達距離

chara 水面監視水飛沫[NewCheckWaterLevel] $s:名前 \
	-n $s:キャラネーム

chara 濁流[NewPassingSplash] $s:名前 \
	-n $i:ルート中心 ... \	// （XYZW の４つ。wは幅）を任意のセット数（３２まで）
	-h $i:高さ \
	-p $i:種類 \ // ０：主流用 １：周辺ガス用 ２：パーティクル用
	-s $i:サイズ

chara 床照り返し管理[NewFloorLightMan] $s:名前

chara 水面に落下物の水飛沫[NewDiveSplashScn] $s:名前 \
	-p $i:中心座標 ... \			// XYZ データ数３個：水面上の点
	-f $i:タンカー座標系の時１を指定	// 発生後手前に移動する

chara 泡で波紋管理[NewRipBubbleMan] $s:名前

chara 波紋管理[NewRippleMan] $s:名前

chara 水飛沫管理[NewSplushMan] $s:名前

chara 連続発生線状泡[NewBubbleLineScn] $s:名前 \
	-p $i:発生場所 ...			// XYZ データ数３個

chara カメラダスト[NewDustOnCamera] $s:名前 \
	-i $i:不可視起動  // ０以外で不可視
mesg カメラダスト $s:名前 オフ[0]
mesg カメラダスト $s:名前 オン[1]

chara カメラ泡[NewBubbleOnCamera] $s:名前 \
	-i $i:不可視起動  // ０以外で不可視
mesg カメラ泡 $s:名前 オフ[0]
mesg カメラ泡 $s:名前 オン[1]

chara 窓からの光 [NewWindowLight] $s:名前 \
	-p $i:窓枠中心座標 ... \			// XYZ データ数３個
	-r $i:回転（４０９６系） ... \		// XY  ２
	-s $i:縦幅、横幅 ... \				// ２
	-t $i:光源位置 ... \				// XYZ ３
	-l $i:光到達距離 \					// １
	-c $i:ＲＧＢα ...					// ＲＧＢα ４

chara 巻き上げ煙 [NewDynamicFlow] $s:名前 \
	-b $i:バンダリ ... \		// XYZ のセット２つ
	-s $i:パーティクルサイズ

chara カメラ前曇り [NewSteamOnCameraScenario] $s:名前 \
	-t $i:消えるまでのフレーム数（ＮＴＳＣ基準）デフォルト600

chara 任意稲光 [NewFreeThunder] $s:名前 \
	-x $i:画面の中心をゼロとしたＸ座標（始点） \ // -4096(LEFT ) 〜 4096(RIGHT)
	-y $i:画面の中心をゼロとしたＹ座標（始点） \ // -4096(UPPER) 〜 4096(LOWER)
	-u $i:画面の中心をゼロとしたＸ座標（終点） \ // -4096(LEFT ) 〜 4096(RIGHT)
	-v $i:画面の中心をゼロとしたＹ座標（終点）   // -4096(UPPER) 〜 4096(LOWER)
// 上限下限とも制限しないので、画面の外を設定可能


chara 速度可変 [NewSlowDown] $s:名前 \
	-l $i:繰り返しの数 \
	-t $i:スキップ

command マッキー音[NewMakkyRainSet] $i:ＳＥナンバー
// 0:常駐ＯＦＦ
// 1:常駐雨音ＯＮ

chara 斜め回転床水飛沫 [NewSplashRotate] $s:名前 \
	-n $i:量 \			// ３２枚の何倍？
	-p $i:場所 ... \	// ＸＹＺの ３つ
	-r $i:向き ... \	// Ｘ回転、Ｙ回転 の２つ
	-w $i:幅 ... 		// 回転前のＸ幅、Ｙ幅（厚みに相当）、Ｚ幅 の ３つ
mesg 斜め回転床水飛沫 $s:名前 オフ[0]
mesg 斜め回転床水飛沫 $s:名前 オン[1]
mesg 斜め回転床水飛沫 $s:名前 殺す[2]
mesg 斜め回転床水飛沫 $s:名前 kill[-1]

chara 壁消火器 [NewExtinguisherMini] $s:名前 \
	-p $v:場所 \
	-b $i:バンダリ ... \	// XYZ のセット２つ
	-i $i:赤外線センサーに有効 \// １で有効
	-d $i:デバグ // １でデバグターゲットが見える

chara 消火器 [NewExtinguisher] $s:名前 \
	-r $v:向き \
	-p $v:場所 \
	-l $s:光源 \
	-b $i:バンダリ ... \	// XYZ のセット２つ
	-i $i:赤外線センサーに有効 \// １で有効
	-d $i:デバグ // １でデバグターゲットが見える

command セットファークリップ[NewFarClipParamSet] $i:near $i:far

chara スローパラメータ制御 [NewSlowParamMan] $s:名前 \
	-s $i:パーセント
//-s は １００でデフォルトと同等
mesg スローパラメータ制御 $s:名前 パーセント[0] $i:パーセント $i:変化フレーム
//      １００でデフォルトと同等


//chara ジョージワシントン橋のライン補強[NewGWB_Lines] $s:名前
chara ジョージワシントン橋のライン補強モデル[NewGWB_LinesModel] $s:名前

chara アイテム[NewItemBox] $s:名前 \
	-b $b:発生パターン \ // 0:その場発生 1:その場に弾んで発生 2:ランダム方向に発射（収得不可の可能性アリ）
	-p $v:（必須）発生位置 \
	-k $s:（必須）本体モデル名 \
	-s $s:（必須）影モデル名 \
	-l $s:ラベルモデル名 \	// 無くてもよい
	-f $b:（必須）アイテム・武器の区別 \
	-i $b:（必須）中身のID \
	-n $b:（必須）個数 \
	-h $w:高さ \		// 影からの高さ
	-e $p:取得時実行関数 \
	-r $i:０でなし、１であり、設定しなければなし \
	-g '文字列' \ //収得時メッセージ。無ければデフォルトメッセージを表示。
	-x { 実行ブロック }
// -e -x は どちらか一方のみ指定。
// -e -x ともに、出力として
//         $1 に アイテム・武器の区別
//         $2 に 中身のＩＤ
//         $3 に 個数
//         $4 に 名前
// を返す。
mesg アイテム $s:名前 オフ[0]
mesg アイテム $s:名前 オン[1]
mesg アイテム $s:名前 殺す[2]
mesg アイテム $s:名前 影だけオフ[3]
mesg アイテム $s:名前 kill[-1]


chara くるくる物体 [NewRotateY_Object] $s:名前 \
	-k $s:モデル名 \ // 必ず指定する
	-p $v:中心の座標 \
	-r $i:回転速度 \ // 4096=360°系。１フレームに回転する角度を指定。
	-s $i:水飛沫ＯＮ・ＯＦＦ \ // 1 を指定したらモデルに外接する最小直方体の上面に水飛沫
	-f $i:カメラから何mmからフェードしはじめるか \ //default:3000
	-l $i:カメラから何mmでクリッピングするか \     //default:10000
	-d $i:ユニット数 \ // ユニット数（1unit=32polygons:max_unit=16）
	   $i:水平の位置ランダム幅 \
	   $i:上方位置ランダム幅 \
	   $i:色の強度（α）

chara ライン水飛沫 [NewLineSplash] $s:名前 \
	-n $i:データ数 \
	-f $i:カメラから何mmからフェードしはじめるか \ //default:3000
	-l $i:カメラから何mmでクリッピングするか \     //default:10000
	-d $i:ユニット数 \ // ユニット数（1unit=32polygons:max_unit=16）
	   $i:水平の位置ランダム幅 \
	   $i:上方位置ランダム幅 \
	   $i:色の強度（α） \
	   $v:線分の端点２つ ...
mesg ライン水飛沫 $s:名前 オフ[0]
mesg ライン水飛沫 $s:名前 オン[1]
mesg ライン水飛沫 $s:名前 殺す[2]
mesg ライン水飛沫 $s:名前 kill[-1]

chara 落下水飛沫[NewSplashFall_Scn] $s:名前 \
	-l $i:２点指定ライン ... \	// XYZ のセット２つ
	-s $i:落下方向 \		// ０）直角右回転に落下 １）直角左回転に落下
	-n $i:水飛沫の数 \		// １フレームに出す数
	-t $i:サウンドのトラックＮｏ    // 省略可
// -l オプションの１つ目から２つ目へに向かってをベクトルと見て
//（その時Ｙは見ず、上から見たときを考える）、
// それからの -s オプション方向に落下させる
// ぶっちゃけた話、実行して壁の内側に出てるようなら -s を変えれば済む。
mesg 落下水飛沫 $s:名前 オフ[0]
mesg 落下水飛沫 $s:名前 オン[1]
mesg 落下水飛沫 $s:名前 殺す[2]
mesg 落下水飛沫 $s:名前 kill[-1]

chara 床水飛沫[NewSplashFloor_Scn] $s:名前 \
	-b $i:バンダリ ... \	// XYZ のセット２つ
	-n $i:水飛沫の数	// １フレームに出す数
mesg 床水飛沫 $s:名前 オフ[0]
mesg 床水飛沫 $s:名前 オン[1]
mesg 床水飛沫 $s:名前 殺す[2]
mesg 床水飛沫 $s:名前 kill[-1]

chara コントラスト[NewContrast_Scn] $s:名前 \
	-c $i:ＲＧＢα ... \	//最初にＲＧＢを引いた後にαを掛ける。(α=128で１倍)
	-n $i:ネガポジ \	//０：ポジティブ １：ネガティブ
	-t $i:変化フレーム	//変化完了までのフレーム数

chara フェードインアウト [NewFadeInOut_Scn] $s:名前 \
	-i $i:初期ＲＧＢα ... \		//設定するとこのＲＧＢαから始まる
	-c $i:ＲＧＢα ... \		//目標のＲＧＢα
	-t $i:変化フレーム \		//変化完了までのフレーム数
	-p $p:移行時間後起動proc \
	-s $i:設定されればプライオリティを低く設定

/*
chara フェード [NewFadeInOutScn] $s:名前 \
	-m $i:加算減算 \	//0:加算 1:減算
	-c $v:初期ＲＧＢα \	//設定するとこのＲＧＢαから始まる
	-f $i:フェードモード \	//0:fade_in 1:fade_out
	-v $i:バリエーション \	//0:full 1:center 2:drop
