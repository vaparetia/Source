// 回転度 4096 = 360度
chara   赤外線[NewIRS] $s:名前 \
	    -p $v:スイッチ座標 $v:センサー１ $v:センサー２ \
	    -r $v:スイッチ回転 $v:センサー１ $v:センサー２ \
	    -e $p:赤外線接触proc \
	    -s $p:スイッチ破壊時proc \
	    -a $i:１を指定すると下部のセンサー無し（50cmの隙間ができる）
mesg    赤外線 $s:名前 on[1]
mesg    赤外線 $s:名前 off[0]

