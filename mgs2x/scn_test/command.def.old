//重野 /user/sigeno shigeno
/*2000.09.12 植原さんから引継ぎ*/
chara レーダー[NewRadar] $s:名前 \
	-dir $i:角度
mesg レーダー $s:名前 off[0]
mesg レーダー $s:名前 on[1]

chara タイマー[NewTimer] $s:名前 \
	-time $iタイム \ /*NTSCフレーム数で指定(1分の場合3600)*/
	-proc $p:終了プロック \ /*タイム０の時に実行*/
	-status	$i:ステータス 
/*status */
//ST_STOP (0x01) 一時停止状態で起動
mesg タイマー $s:名前 停止[0]
mesg タイマー $s:名前 開始[1]
mesg タイマー $s:名前 加算[2] $iタイム


command ゲット残りタイム[NewGetLeftTime]
command タイマー加算[NewAddLeftTime] -time $iタイム  /*NTSCフレーム数で指定(1分の場合3600)*/


chara 攻撃コマンダー[NewAtCommander] $s:名前 \
	-e $p:アタッカーproc ... \
	-cover $i:エリア数 $v:遮蔽物 ... \ 
	-status	$i:ステータス \
	-wait	$i:待機時間 \
	-video $w:ビデオ用モード 
//	-cover $i:遮蔽エリア数 棚などの数
//$v:遮蔽物 ... \ /*座標二つ一組でひとつのエリアを設定*/
//	-status	$i:ステータス \
//		0x01	危険モード開始時にワープ
mesg 攻撃コマンダー $s:名前 ステータスセット[1] $i:フラグ


chara アタッカー[NewSigAttacker] $s:名前 \
	-r $b:初期ルート \
	-s $w:ステータス \
	-i $w:視力 ... \
	-l $w:ライフ値 \
	-f $w:気絶値 \
	-e $w:装備タイプ \
	-d $v:守備位置 $s:マップ \
	-o $v:待避位置 \ /*守備位置に他の兵が近い時に使用*/
	-q $p:プロック $b:確率 ...2 \
	-c $b:探索ルート \
	-v $w:声優
// 装備タイプ	０標準 １盾 ２ライト付き盾 3ショットガン

mesg アタッカー $s:名前 ルート変更[1] $i:ルート番号

chara 長廊下兵[NewSigDefender] $s:名前 \
	-r $b:初期ルート \
	-s $w:ステータス \
	-i $w:視力 ... \
	-l $w:ライフ値 \
	-f $w:気絶値 \
	-e $w:装備タイプ \
	-b $b:個別ＢＧＭ \
	-type $b:種類 \
	-proc $p:死亡時proc ... \
	-a	$w:照準ぶれ幅 
// type:０左舷位置自動、１左舷位置mesg指定 ２右舷守備 ３右舷後方
mesg 長廊下兵 $s:名前 守備開始[0] 
mesg 長廊下兵 $s:名前 追跡開始[1] 
mesg 長廊下兵 $s:名前 ワープ[2] $i:位置Ｘ $i:位置Ｙ $i:位置Ｚ $s:マップ
mesg 長廊下兵 $s:名前 ルート変更[3] $i:ルート番号 
mesg 長廊下兵 $s:名前 モード変更[4] $i:モード番号 
mesg 長廊下兵 $s:名前 初期待機[5] 
mesg 長廊下兵 $s:名前 守備位置設定[6] $i:位置番号 


chara 長廊下コマンダー[NewDefCommander] $s:名前 \
	-e $p:長廊下兵proc ... \
	-map $s:マップ ... \
	-defense $i:守備地点設定 ... \
	-type $b:タイプ設定 \
	-proc $p:proc ... \
	-final $v:位置判定基準 ... \
	-light $v:目標照明座標 ... \
	-count $i:照明破壊時間
mesg 長廊下コマンダー $s:名前 ライト破壊[1]  $i:番号 
mesg 長廊下コマンダー $s:名前 再発生所替え[2] $i:場所番号

//ライトが破壊されたことを敵兵に通知
//守備地点は、Ｘ座標、Ｙ座標、Ｚ座標、アクション番号
//を一組としてポイント数分設定。最大6点。
//アクション番号	０ 右手攻撃 上下
//					１ 右手攻撃 下段
//					２ 左手攻撃 上下
//					３ 左手攻撃 下段
//マップも6箇所 各守備座標と同じ順番にそれぞれのマップ名を設定
//タイプは0左舷用と1右舷用



chara 天狗兵Ａ[NewSigTengA] $s:名前 \
	-r $b:初期ルート \
	-s $w:ステータス \
	-i $w:視力 ... \
	-h $w:聴力 -v \
	-l $w:ライフ値 \
	-f $w:気絶値 \
	-e $w:装備タイプ \
	-type $b:種類 \
	-proc $p:死亡時proc ... \
	-a	$w:照準ぶれ幅 
// type:０左舷位置自動、１左舷位置mesg指定 ２右舷守備 ３右舷後方
mesg 天狗兵Ａ $s:名前 ルート変更[3] $i:ルート番号 
//mesg 天狗兵Ａ $s:名前 ワープ[2] $i:位置Ｘ $i:位置Ｙ $i:位置Ｚ $s:マップ
chara 天狗兵コマンダー[NewTngCommander] $s:名前 \
	-e $p:天狗兵proc ... \
	-defense $i:守備地点設定 ... \
	-final $v:位置判定基準 ... \
	-type $b:タイプ設定 \
	-res  $v:再発生位置 ... \
	-sub $s:目標名前   /*サポートスネークの名前*/

//-defense 守備地点は ルート番号 ,再発生場所番号,
//			行動開始レベル の順。


mesg 天狗兵コマンダー $s:名前 レベルＵＰ[1] $i:レベル 
mesg 天狗兵コマンダー $s:名前 危険開始[2] 


chara 天狗兵Ｂ[NewSigTengB] $s:名前 \
	-r $b:初期ルート \
	-s $w:ステータス \
	-i $w:視力 ... \
	-h $w:聴力 -v \
	-l $w:ライフ値 \
	-f $w:気絶値 \
	-e $w:装備タイプ \
	-type $b:種類 \
	-proc $p:死亡時proc ... \
	-a	$w:照準ぶれ幅 



/*エマ狙撃イベント用*/
chara 海上巡回兵[NewW32Defender] $s:名前 \
	-r $b:初期ルート \
	-s $w:ステータス \
	-i $w:視力 ... \
	-l $w:ライフ値 \
	-t $s:目標名前 \ /*エマのシナリオ上の名前*/
	-f $w:気絶値 
mesg 海上巡回兵 $s:名前 ルート変更[1] $i:ルート番号 $i:ポイント番号

/************************/
chara	ジャンプ地点[NewSetJumpPos]  $s:名前 \
			-up $v:上階座標 \
			-down $v:下階座標 

chara ロッカー死体[NewLockerCP] $s:名前 \
	-pos $v:配置座標 \
	-dir $i:方向 \
	-kms $s:モデル名 \
	-mar $s:モーションファイル名 \
	-number $i:モーション番号 
mesg ロッカー死体 $s:名前 倒れ[0] 
//	kmsとmarとnumberは省略可 
//省略時はtnc_def.kms locker_cp.mar 0番がそれぞれ指定されます

chara プットモーションモデル[NewSigPutModelEvm] $s:名前 \
	-pos $v:配置座標 \
	-dir $i:方向 \
	-kms $s:KMSモデル名 \ /*evmを表示する場合はダミーKMSが必要*/
	-evm $s:EVMモデル名 \ /*KMSを表示する場合は不要*/
	-mar $s:モーションファイル名 \
	-number $i:基本モーション番号 \ /*省略時０*/
	-item	$s:装備モデル名 $i:関節番号 \ /*オブジェを付随*/
	-proC $p:終了時プロック \ /*終了判定モードでの再生時のみ有効*/
	-status	$w:ステータス 
//ステータスフラグ設定は以下のとおり
//(0x01) モーションの水平移動量を無視
//(0x02) 廃止
//(0x04) 廃止
//(0x08) モーション停止で待機 (mesgで再生開始)
//(0x10) 再生開始時に座標をリセット
//(0x20) モーション補完無し
//(0x40) プリシェード使用
//(0x80) 非表示で起動（再生mesgで表示開始）

mesg プットモーションモデル $s:名前 モーション再生[1] $i:番号
mesg プットモーションモデル $s:名前 モーション進む[2] 
mesg プットモーションモデル $s:名前 モーション戻る[3] 
mesg プットモーションモデル $s:名前 初期座標[4] 
mesg プットモーションモデル $s:名前 回転[5]  $i:方向
mesg プットモーションモデル $s:名前 終了判定[6]  $i:番号
mesg プットモーションモデル $s:名前 非表示[7] 
mesg プットモーションモデル $s:名前 表示[8] 

//mesg 終了判定 (終了判定付き再生と呼ぶべきか？)
//指定されたモーションを再生終了後に静止。
//通常 -numberで指定された基本モーションを繰り返し、mesgを受信すると
//そのモーションを再生。終了すると再び基本モーションのループに入る


chara ルートデモ人形[NewSigRouteModel] $s:名前 \
	-route $i:ルート $b:ノード \ 
	-kms $s:KMSモデル名 \ /*EVMを表示する場合はダミーKMSが必要*/
	-evm $s:EVMモデル名 \ /*KMSを表示する場合は不要*/
	-mar $s:モーションファイル名 \
	-number $i:移動モーション番号 \ 
	-item	$s:装備モデル名 $i:関節番号 
mesg ルートデモ人形 $s:名前 ルート変更[1] $i:ルート番号 
mesg ルートデモ人形 $s:名前 kill[-1]


chara 沈没タンカー[NewSigSinkTanker] $s:名前 \
	-pos $v:配置座標 \
	-dir $i:方向 \
	-kms $s:KMSモデル名 \ 
	-mar $s:モーションファイル名 \
	-number $i:モーション番号 \ 
	-scale	$i:倍率 \
	-light    $s:光源 

mesg 沈没タンカー $s:名前 再生[1] 


/*指定された順にモーション再生後プロック呼んで消滅*/
chara デモ人形[NewDemoDoll] $s:名前 \
	-pos $v:配置座標 \
	-dir $i:方向 \
	-kms $s:KMSモデル名 \	/*code 優先*/
	-code $i:モデルSTRCODE \ /*KMS とどちらか使用 */
	-mar $s:モーションファイル名 \
	-list	$i:再生順番 ... \ /*最大8個*/
	-end $p:終了時プロック \
	-status	$w:ステータス /*現在無効*/
/*3次元ルート巡回オブジェクト*/
chara	プットルートオブジェ[NewRoute3d]  $s:名前 \
	-route $i:ルート番号 \
	-kms $s:KMSモデル名 \
	-speed $i:移動速度 \
	-flag $i:フラグ



