//里吉 /user/satoyoshi satoyoshi
/*2001.1.15 重野さんから引継ぎ*/
//フラグ (0x01) 複数パーツモデル

chara サイファ[NewCypher]  $s:名前 \
	-route $i:ルート $b:ノード \ 
	-xran $i:横視野角 \ /*省略可*/
	-yran $i:縦視野角 \ /*省略可*/
	-type $i:タイプ \ /*0-NORMAL,1-GUN*/
	-i $w:視力 \
	-speed $i:最高速度 /*初期値80*/
mesg サイファ $s:名前 ルート変更[1] $i:ルート番号 $i:ノード番号 
mesg サイファ $s:名前 スタート[258] 

chara 監視カメラ[NewSvCamera]  $s:名前 \
	-pos $v:設置場所 \
	-rot $v:支柱部方向 \ /*ＸＹ値のみ有効*/
	-dir $i:振り幅 \ /*片側角度*/
	-center $i:振り中心角 $i:初期方向 \ /*初期方向は符号付き相対指定*/
	-xran $i:縦視野角 \ /*省略可 512*/
	-yran $i:横視野角 \ /*省略可 512*/
	-i $w:視力 /*省略可*/ \
	-status $i:ステータスフラグ \
	-exec { 実行ブロック } /*破壊時*/

/*
振り中心角省略時は支柱方向が中心 初期方向は中心角度から相対指定
ステータスフラグ (0x01) 破壊状態１
*/
mesg 監視カメラ $s:名前 視界オフ[1] 
mesg 監視カメラ $s:名前 視界オン[2] 

chara ガンカメラ[NewGunCamera]  $s:名前 \
	-pos $v:設置場所 \
	-rot $v:初期方向 \ /*ＸＹ値のみ有効*/
	-dir $i:振り幅 \
	-xran $i:横視野角 \ /*省略可*/
	-yran $i:縦視野角 \ /*省略可*/
	-i $w:視力 /*省略可*/

chara ハリアー[NewHarrier]  $s:名前
chara 装備品セット[NewEquipment]  $s:名前

chara ルート表示 [NewDebugRouteViewer] $s:名前 
//これを起動することによりデバッグメニューから
//巡回ルート及びクリアリングルートの可視化が行えるようになります。

/*--------------これ以降実験用非公式キャラ----------------*/

/*パッド操作でproc実行*/
/*paddef.h のincludeが必要*/
chara デバッグパッドプロック[NewSigPadProc] $s:名前 \
	-proc $p:実行プロック ... \
	-key $i:キー番号 ... \
	-cont $i:パッド番号 

chara 安地みるみる君[NewSigZoneView] $s:名前 

//--------------------------------------------------------------------- 

// 狩野 K.Kano


chara ロープモデル[NewRopeModel] $s:名前 \
	-n $s:モデル名 \
	-d $i:サンプルデータ番号 \
	-x $v:OBJ0表示位置 \
	-r $v:モデルの回転 \
	-m $i:各OBJの重さ \
	-p $i:風の影響の割合 \
	-k $i:速度に対する抵抗の割合 \
	-e $i:壁に対する反発係数 \
	-l $i:壁検出距離 \
	-f $i:当たり判定を行なうかどうかのフラグ \
	-h $i:バンダナモード（０）か髪の毛モード（１）か

chara ロープモデル２[NewRopeModel2] $s:名前 \
	-n $s:モデル名 \
	-d $i:サンプルデータ番号 \
	-x $v:OBJ0表示位置 \
	-r $v:モデルの回転 \
	-m $i:各OBJの重さ \
	-p $i:風の影響の割合 \
	-k $i:速度に対する抵抗の割合 \
	-s $i:元位置に戻そうとするバネの定数 \
	-t $i:OBJの動く範囲の全長に対する割合 \
	-e $i:壁に対する反発係数 \
	-l $i:壁検出距離 \
	-f $i:当たり判定を行なうかどうかのフラグ

chara ロープモデル３[NewRopeModel3] $s:名前 \
	-n $s:モデル名 \
	-d $i:サンプルデータ番号 \
	-b $s:バウンディングボックスによる当たり判定に使うモデル \
	-y $s:つける相手の名前 \
	-z $i:つける場所のOBJ番号 \
	-x $v:ローカル座標上でのつける位置 \
	-r $v:モデルの回転 \
	-m $i:各OBJの重さ \
	-p $i:風の影響の割合 \
	-k $i:速度に対する抵抗の割合 \
	-o $i:楕円球当たり判定用パラメータ \
	-f $i:当たり判定を行なうかどうかのフラグ \
	-h $i:バンダナモード（０）か髪の毛モード（１）か \
	-v // 強制表示フラグ

mesg ロープモデル３ $s:名前 visible[0] $i:モード

chara ロープサーバー[NewRopeServer] $s:名前 \
	-s $i:登録可能サイズ

chara ロープ登録[NewRegistRope] $s:名前 \
	-n $s:モデル名 \
	-d $i:サンプルデータ番号 \
	-b $s:バウンディングボックスによる当たり判定に使うモデル \
	-y $s:つける相手の名前 \
	-z $i:つける場所のOBJ番号 \
	-x $v:ローカル座標上でのつける位置 \
	-r $v:モデルの回転 \
	-m $i:各OBJの重さ \
	-p $i:風の影響の割合 \
	-k $i:速度に対する抵抗の割合 \
	-o $i:楕円球当たり判定用パラメータ \
	-f $i:当たり判定を行なうかどうかのフラグ \
	-h $i:バンダナモード（０）か髪の毛モード（１）か \
	-v // 強制表示フラグ


// m ... グラム単位
// p ... 1/100000単位
// k ... 1/100000単位
// s ... 1/100000単位
// t ... 0-10000(0.00% - 100.00%)
// e ... 0-1000(0.0% - 100.0%)
// l ... 1000 = 1 meter
// o ... 0-100-(0.00 - 1.00 -)
// f ... 0 or 1
// 計算式  f = p * windv - k * v
//         a = f/m
//         v'= v + a
//         x'= x + v'

// 解説
// -m OBJ一個一個がどの程度の質量を持っているか指定します。
// 　 これを大きくすると、質量が大きくなりますので、動かしにくく止まりにくい
// 　 物体になります。
// 
// -p 風がどの程度OBJに影響を与えるかを指定します。
// 　 これを大きくすると、風がOBJを押す力が強くなります。
// 
// -k 今現在の速度を止めようとする力の割合を指定します。
// 　 これを大きくすると、OBJは空気抵抗のようなものを強く受けますので、
// 　 振動しにくくなります。
// 
// -s OBJを元位置にもどすために設定した、ばねの強さを指定します。
// 　 これを大きくしますと、元に戻ろうとする力が強くなりますので、
// 　 振幅が小さくなります。また、ばねには振動しようとする性質が
// 　 ありますので、振動しやすくなり、止まりにくくなります。
// 
// -e 壁にぶつかった時に、ぶつかった時の速度の何%が跳ね返りの速度になるかを
// 　 指定します。これを大きくしますと、壁がゴムのようにOBJを跳ね返すように
// 　 なります。
// 
// -l 壁にぶつかったと判定する距離です。壁当たりにどの程度近づいたら
// 　 壁に当たったと判定されるかを指定します。壁の厚みに相当します。

// サンプルデータでの設定値
// 0を指定した場合:
// 　　　　-m 100 \
// 　　　　-p 1000 \
// 　　　　-k 10000 \
// 　　　　-s 1000 \
// 　　　　-t 3000 \
// 　　　　-e 100 \
// 　　　　-l 200 \
// 
// 1を指定した場合:
// 　　　　-m 10 \
// 　　　　-p 1000 \
// 　　　　-k 200 \
// 　　　　-s 50 \
// 　　　　-t 1000 \
// 　　　　-e 100 \
// 　　　　-l 100 \



chara 髪の毛モデル[NewHairModel] $s:名前 \
	-n $s:モデル名 \
	-d $i:サンプルデータ番号 \
	-b $s:バウンディングボックスによる当たり判定に使うモデル \
	-y $s:つける相手の名前 \
	-z $i:つける場所のOBJ番号 ... \
	-x $v:ローカル座標上でのつける位置 \
	-r $v:モデルの回転 \
	-m $i:各OBJの重さ \
	-p $i:風の影響の割合 \
	-k $i:速度に対する抵抗の割合 \
	-a $i:曲がりを正すパラメータの割合 \
	-o $i:楕円球当たり判定用パラメータ \
	-w $i:全体の移動値の何割を無視するかのパラメータ \
	-f $i:当たり判定を行なうかどうかのフラグ \
	-c $i:当たり判定を行うオブジェの数 $i:オブジェ番号 ... \
	-q $i:ライトの影響をアンビエント主体にするフラグ \
	-v // 強制表示フラグ

mesg 髪の毛モデル $s:名前 visible[0] $i:フラグ
mesg 髪の毛モデル $s:名前 パラメータチェンジ[1] $i:サンプルデータ番号
mesg 髪の毛モデル $s:名前 ライトフラグチェンジ[2] $i:ライトフラグ


chara マルチウェイト髪の毛モデル[NewEvmHairModel] $s:名前 \
	-n $s:モデル名 \
	-d $i:サンプルデータ番号 \
	-b $s:バウンディングボックスによる当たり判定に使うモデル \
	-y $s:つける相手の名前 \
	-z $i:つける場所のOBJ番号 ... \
	-x $v:ローカル座標上でのつける位置 \
	-r $v:モデルの回転 \
	-m $i:各OBJの重さ \
	-p $i:風の影響の割合 \
	-k $i:速度に対する抵抗の割合 \
	-a $i:曲がりを正すパラメータの割合 \
	-o $i:楕円球当たり判定用パラメータ \
	-w $i:全体の移動値の何割を無視するかのパラメータ \
	-f $i:当たり判定を行なうかどうかのフラグ \
	-c $i:当たり判定を行うオブジェの数 $i:オブジェ番号 ... \
	-q $i:ライトの影響をアンビエント主体にするフラグ \
	-v // 強制表示フラグ

mesg マルチウェイト髪の毛モデル $s:名前 visible[0] $i:フラグ
mesg マルチウェイト髪の毛モデル $s:名前 パラメータチェンジ[1] $i:サンプルデータ番号
mesg マルチウェイト髪の毛モデル $s:名前 ライトフラグチェンジ[2] $i:ライトフラグ

// 解説
//
// m, p, k, e, l, o, fに関してはロープと同じ
// a ... 1/100単位
// w ... 0-100 (0.00 - 1.00)
//
// -a 各関節が初期状態の曲がり具合に戻ろうとする力を調節します。
//
// -w 全体が移動した場合、それをどの程度無視して計算を行うかの割合です。
//    100にすると完全に移動は無視され、回転のみが反映されることになります。
//


