タンカーデジタルカメラ:
	'YOU GOT A "CAMERA".YOU CAN USE IT|IN THE "TANKER EPISODE".'
プラントデジタルカメラ:
	'YOU GOT A "CAMERA".YOU CAN USE IT|IN THE "PLANT EPISODE".'
デジタルカメラ:
	'YOU GOT A "CAMERA".'
タンカーステルス:
	'YOU GOT A "STEALTH".YOU CAN USE IT|IN THE "TANKER EPISODE".'
プラントステルス:
	'YOU GOT A "STEALTH".YOU CAN USE IT|IN THE "PLANT EPISODE".'
カツラ茶:
	'YOU GOT A "WIG(BROWN)".YOU CAN USE IT|IN THE "PLANT EPISODE".'
カツラ橙:
	'YOU GOT A "WIG(ORANGE)".YOU CAN USE IT|IN THE "PLANT EPISODE".'
カツラ青:
	'YOU GOT A "WIG(BLUE)".YOU CAN USE IT|IN THE "PLANT EPISODE".'

};


#endif


#ifdef d:PAL

resource アイテム取得時の文書フランス語 {

バンダナ:
	{Tu as un bandana. Tu peux l'utiliser|dans l'&'episode du tanker.}
タンカーデジタルカメラ:
	{Tu as une cam&'era. Tu peux l'utiliser|dans l'&'episode du tanker.}
プラントデジタルカメラ:
	{Tu as une cam&'era. Tu peux l'utiliser|dans l'&'episode du la plateforme.}
デジタルカメラ:
	{Tu as une cam&'era.}
タンカーステルス:
	{Tu as un camouflage optique. Tu peux l'utiliser|dans l'&'episode du tanker.}
プラントステルス:
	{Tu as un camouflage optique. Tu peux l'utiliser|dans l'&'episode du la plateforme.}
カツラ茶:
	{Tu as un perruque(chatain). Tu peux l'utiliser|dans l'&'episode du la plateforme.}
カツラ橙:
	{Tu as un perruque(orange). Tu peux l'utiliser|dans l'&'episode du la plateforme.}
カツラ青:
	{Tu as un perruque(bleue). Tu peux l'utiliser|dans l'&'episode du la plateforme.}

};

resource アイテム取得時の文書ドイツ語 {

バンダナ:
	{Du hast eine Bandana. Du kannst sie in|der Episode im Tanker einsetzen.}
タンカーデジタルカメラ:
	{Du hast eine Kamera. Du kannst sie in|der Episode im Tanker einsetzen.}
プラントデジタルカメラ:
	{Du hast eine Bandana. Du kannst sie in|der Episode im Anlage einsetzen.}
デジタルカメラ:
	{Du hast eine Kamera.}
タンカーステルス:
	{Du hast eine Stealth-Tarnung. Du kannst sie in|der Episode im Tanker einsetzen.}
プラントステルス:
	{Du hast eine Stealth-Tarnung. Du kannst sie in|der Episode im Anlage einsetzen.}
カツラ茶:
	{Du hast eine braune Per&~ucke. Du kannst sie in|der Episode im Anlage einsetzen.}
カツラ橙:
	{Du hast eine orange Per&~ucke. Du kannst sie in|der Episode im Anlage einsetzen.}
カツラ青:
	{Du hast eine blaue Per&~ucke. Du kannst sie in|der Episode im Anlage einsetzen.}

};

resource アイテム取得時の文書イタリア語 {

バンダナ:
	'Hai una "BANDANA". Puoi usarla nell\'|'
	'"Episodio TANKER".'
タンカーデジタルカメラ:
	'Hai una "TELECAMERA". Puoi usarla nell\'|'
	'"Episodio TANKER".'
プラントデジタルカメラ:
	'Hai una "TELECAMERA". Puoi usarla nell\'|'
	'"Episodio INSTALLAZIONE".'
デジタルカメラ:
	'Hai una "TELECAMERA".'
タンカーステルス:
	'Hai una "MIMETICA". Puoi usarla nell\'|'
	'"Episodio TANKER".'
プラントステルス:
	'Hai una "MIMETICA". Puoi usarla nell\'|'
	'"Episodio INSTALLAZIONE".'
カツラ茶:
	'Hai una "PARRUCCA MARRONE". Puoi usarla|'
	'nell\' "Episodio INSTALLAZIONE".'
カツラ橙:
	'Hai una "PARRUCCA ARANCIONE". Puoi usarla|'
	'nell\' "Episodio INSTALLAZIONE".'
カツラ青:
	'Hai una "PARRUCCA BLU". Puoi usarla nell\'|'
	'"Episodio INSTALLAZIONE".'

};

resource アイテム取得時の文書スペイン語 {

バンダナ:
	// 'YOU GOT A "BANDANA".YOU CAN USE IT|IN THE "TANKER EPISODE".'
	'Tienes una "BANDANA". Puedes usarla en el|'
	'"EP&`ISODIO DEL CARGUERO".'
タンカーデジタルカメラ:
	// 'YOU GOT A "CAMERA".YOU CAN USE IT|IN THE "TANKER EPISODE".'
	'Tienes una "CAMERA". Puedes usarla en el|'
	'"EP&`ISODIO DEL CARGUERO".'
プラントデジタルカメラ:
	// 'YOU GOT A "CAMERA".YOU CAN USE IT|IN THE "PLANT EPISODE".'
	'Tienes una "CAMERA". Puedes usarla en el|'
	'"EP&`ISODIO DE LA PLANTA".'
デジタルカメラ:
	// 'YOU GOT A "CAMERA".'
	'Tienes una "CAMERA".'
タンカーステルス:
	// 'YOU GOT A "STEALTH".YOU CAN USE IT|IN THE "TANKER EPISODE".'
	'Tienes una "&\'OPTICO". Puedes usarla en el|'
	'"EP&`ISODIO DEL CARGUERO".'
プラントステルス:
	// 'YOU GOT A "STEALTH".YOU CAN USE IT|IN THE "PLANT EPISODE".'
	'Tienes una "&\'OPTICO". Puedes usarla en el|'
	'"EP&`ISODIO DE LA PLANTA".'
カツラ茶:
	// 'YOU GOT A "WIG(BROWN)".YOU CAN USE IT|IN THE "PLANT EPISODE".'
	'Tienes una "PELUCA(BRONCE)". Puedes usarla en el|'
	'"EP&`ISODIO DE LA PLANTA".'
カツラ橙:
	// 'YOU GOT A "WIG(ORANGE)".YOU CAN USE IT|IN THE "PLANT EPISODE".'
	'Tienes una "PELUCA(NARANJA)". Puedes usarla en el|'
	'"EP&`ISODIO DE LA PLANTA".'
カツラ青:
	// 'YOU GOT A "WIG(BLUE)".YOU CAN USE IT|IN THE "PLANT EPISODE".'
	'Tienes una "PELUCA(AZUL)". Puedes usarla en el|'
	'"EP&`ISODIO DE LA PLANTA".'
};

#endif


resource スネークセリフ {
// タンカー編用
01:
	$t:{ t:vc122102, },
	//スネーク　「何をする！」
02:
	$t:{ t:vc122103, },
	// スネーク　「ふざけたことをするな！」
03:
	$t:{ t:vc122104, },
	// スネーク　「何のつもりだ！」

// プラント編用
27:
	$t:{ t:vc122414, },
	// スネーク　　「これを使え！」
28:
	$t:{ t:vc122415, },
	// スネーク　　「ライデン、受け取れ！」
29:
	$t:{ t:vc122416, },
	// スネーク　　「ライデン、アイテムだ！」
};



#ifdef d:JAPANESE

resource セーブ確認文 {
確認:
	'セーブしますか？'
};

#endif


#ifdef d:ENGLISH

resource セーブ確認文 {
確認:
	'Save ?'

はい:
	'Yes'
いいえ:
	'No'
};

#endif

#ifdef d:PAL

resource セーブ確認文フランス語 {
確認:
	'Sauvegarder ?'

はい:
	'Oui'
いいえ:
	'Non'
};

resource セーブ確認文ドイツ語 {
確認:
	'Speichern ?'

はい:
	'Ja'
いいえ:
	'Nein'
};

resource セーブ確認文イタリア語 {
確認:
	'Salvare ?'

はい:
	{S&`i}
いいえ:
	'No'
};

resource セーブ確認文スペイン語 {
確認:
	'&~? Guardar ?'

はい:
	{S&`i}
いいえ:
	'No'
};

#endif


/// koba4
resource 結果画面用アイテム名 {
バンダナ:
	'BANDANA' , 
ステルス:
	'STEALTH' ,
カツラ茶:
	'WIG (BROWN)' ,
カツラ橙:
	'WIG (ORANGE)' ,
カツラ青:
	'WIG (BLUE)' ,
};


#ifdef d:NTSC

command ローカルリソース設定 \
	-string アイテム取得時メッセージ[アイテム取得時の文書:*] \
			セーブ確認文[セーブ確認文:*] \
			アイテム名[結果画面用アイテム名:*] \
	-binary スネークおまけセリフ[スネークセリフ:*]

#endif


#ifdef d:PAL

if ( $w:言語 == d:LANG_FRENCH ){
	command ローカルリソース設定 \
		-string アイテム取得時メッセージ[アイテム取得時の文書フランス語:*] \
				セーブ確認文[セーブ確認文フランス語:*] \
				アイテム名[結果画面用アイテム名:*] \
		-binary スネークおまけセリフ[スネークセリフ:*]
} else if ( $w:言語 == d:LANG_GERMANY ){
	command ローカルリソース設定 \
		-string アイテム取得時メッセージ[アイテム取得時の文書ドイツ語:*] \
				セーブ確認文[セーブ確認文ドイツ語:*] \
				アイテム名[結果画面用アイテム名:*] \
		-binary スネークおまけセリフ[スネークセリフ:*]
} else if ( $w:言語 == d:LANG_ITALY ){
	command ローカルリソース設定 \
		-string アイテム取得時メッセージ[アイテム取得時の文書イタリア語:*] \
				セーブ確認文[セーブ確認文イタリア語:*] \
				アイテム名[結果画面用アイテム名:*] \
		-binary スネークおまけセリフ[スネークセリフ:*]
} else if ( $w:言語 == d:LANG_SPANISH ){
	command ローカルリソース設定 \
		-string アイテム取得時メッセージ[アイテム取得時の文書スペイン語:*] \
				セーブ確認文[セーブ確認文スペイン語:*] \
				アイテム名[結果画面用アイテム名:*] \
		-binary スネークおまけセリフ[スネークセリフ:*]
} else {
	command ローカルリソース設定 \
		-string アイテム取得時メッセージ[アイテム取得時の文書:*] \
				セーブ確認文[セーブ確認文:*] \
				アイテム名[結果画面用アイテム名:*] \
		-binary スネークおまけセリフ[スネークセリフ:*]
}

#endif
