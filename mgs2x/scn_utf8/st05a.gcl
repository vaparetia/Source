// ------------------------------------
// 各gclで必要なdefine
// ------------------------------------
// モード
#define		STAGE_VR 		1		// 共通プロック切り分け用
#define		VR_STREAKING	1		// 共通プロック切り分け用

// ステージ名
#define		STAGE_ST01A		1		// 共通プロック切り分け用

// 敵兵、ＮＰＣ状況（薬莢を呼び分けるのに必要）
#define		ENE_P_GOL		1		// 都市迷彩ゴル兵
#define		ENE_SHOT		1		// ショットガン兵
#define		ENE_HIGH_TECH	1		// ハイテク兵
#define		ENE_SHIELD		1		// 盾兵

// オブジェクト

// ------------------------------------
// 各種スイッチ用define
// ------------------------------------
// デバッグ関係
#ifdef	d:FIX_MODE
	#define		DEBUG_CHARA		0		// デバッグキャラ全体(FIX時は0)
#else
	#define		DEBUG_CHARA		0		// デバッグキャラ全体
#endif
#define		CHARA_CAMERA	0		// キャラ追従カメラ
#define		TARGET_CHARA	敵兵:01	// キャラ追従カメラのターゲット
#define		SCREENSHOT		0		// スクリーンショット
#define		USB_KEY			0		// USBキーボード


// ------------------------------------
// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME			st08a
#define		KMS_NAME			vs08a
#define		TONBO_KMS_NAME		vs08a_tonbo
#define		LINE_KMS_NAME		vs08a_line

// キャラクター関係
#define		PLAYER		ライデン

// ------------------------------------
// 敵兵音声
// ------------------------------------

// ------------------------------------
// 敵兵ルート番号
// ------------------------------------
enum E_R {
	敵増援出現ポイント		= 0, // ゴールのところ。
	雷電道１,
	雷電道２,
	雷電道３,
	雷電道４,
	雷電道５,
	雷電道６,
};
// ＶＲウィンドウ ストリーキング
#define WINDOW_STREAKING_ST05A		[VRMSG_J:VRM_STR_st05a] [VRMSG_E:VRM_STR_st05a] [VRMSG_G:VRM_STR_st05a] \	// 日、英、独
									[VRMSG_F:VRM_STR_st05a] [VRMSG_I:VRM_STR_st05a] [VRMSG_S:VRM_STR_st05a] \	// 仏、伊、西
									[VRMSG_K:VRM_STR_st05a] \															// 韓
									p:ＶＲステージ開始時処理 5								// 終了プロック

#define	WATCHER_STATUS		d:ENE_STATUS_NORMAL 7000 2000 -34000 ストリーキング５面
#define ATTACKER_STATUS		d:E_R:敵増援出現ポイント d:ENE_STATUS_NORMAL d:ENE_EQUIP_TYPE_NORMAL


// ------------------------------------
// include
// ------------------------------------
#include "rai_st01a.mh"		// 強制モーションリスト
#include "stdch.h"
#include "enevoice.h"
#include "a_stdproc.h"		// アナザーミッション設定ファイル
#include "sload.h"
#include "sound.h"
#include "item_info.h"
#include "a_item_info.h"
#include "ene_item.h"
#include "vr_common.h"		// ＶＲステージ共通で使用するプロック
#include "camproc.h"
#include "st_common.h"
#include "vs08a_common.h"
#if d:USB_KEY
	#include "usbkbd.h"
#endif
// ------------------------------------
// マップ設定
// ------------------------------------
chara マップ ストリーキング５面 -k d:KMS_NAME -h d:HZX_NAME,0 -l $s:ＶＲライトファイル名

command マップ設定 ストリーキング５面 -set {
	// ローカルの初期化
	// ------------------------------------
	@ローカル変数初期化		// ローカルで使用する変数で初期化をする場合はここで

	// ＶＲで必要な基本プロックのセット(vr_common.hで定義)
	// サウンドの基本パック、ＶＲの基本システム、プレイヤー、ゴール等を設定します
	// ※このプロックを使用する時は「ＶＲクリア時処理」というプロックが必要です
	// ＶＲ共通プロックセット	$:スネークファイル $:雷電ファイル $:クリア条件フラグ
	//							$:ゴールＸ $:ゴールＹ $:ゴールＺ $:タイマー初期値
	//	VR_GOAL_TARGET	/*的全滅でゴールが開く*/
	//	VR_GOAL_FREE	/*ゴールが最初から開いてる*/
	//	VR_GOAL_ENEMY	/*敵全滅でゴールが開く*/
	//	VR_GOAL_SNEAK	/*潜入モード中はゴールが開く*/
	//	VR_GOAL_TIME	/*タイマーがゼロになるとゴールが開く*/
	//	VR_GOAL_SCN		/*シナリオ定義キャラ戦闘不能でゴールが開く*/
	// ------------------------------------
	@ストリーキングプロックセット sna_st01a rai_st01a d:VR_GOAL_FREE 7000 2000 -34000 // vr_sne_common.h

	// ＶＲウィンドウの設定
	// ------------------------------------
	@ストリーキング５面ＶＲウィンドウ設定

	// クリア時に呼ばれるものの設定
	// ------------------------------------
	eval ( $$i:ＶＲクリアフラグ = d:VRCLR_NO_RETRY ) ;
	@ＶＲクリア設定 p:load_st01a p:load_st01a

	// ステージに引かれるライン
	// ------------------------------------
	@ＶＲアウトライン d:KMS_NAME d:TONBO_KMS_NAME d:LINE_KMS_NAME

	// 設定値を変更する場合は以下のプロック内で設定
	// ------------------------------------
	@設定値変更				// 敵兵や的のパラメータをステージ限定で変える時はここで
	@プラグイン設定			// プレイヤーのプラグインがいる時はここで
//	@エルード設定			// 裸にエルードは過激です。
	// 敵兵・的関係の設定
	// ------------------------------------
	@コマンダー設定
	@監視カメラ設置

	// ＢＧＭの設定(プレイヤー→敵兵→BGMの順で呼ぶ)
	// ------------------------------------
	@ＢＧＭ設定

	// アイテムの設定
	// ------------------------------------
	@アイテム設定

	// 光源、オブジェクト、カメラ関連の設定
	// ------------------------------------
/*
	default...

	朝Ｎ = 0,
	朝Ｆ = 50000,
	夕Ｎ = -3000,
	夕Ｆ = 40000,
	夜Ｎ = -500,
	夜Ｆ = 18000
*/
	@ＶＲフォグ設定 d:VR_FOG:朝Ｎ d:VR_FOG:朝Ｆ -5000 60000 -2000 40000
	@カメラセット					// chara カメラとベースのカメラを設定
	@vs08aカメラ設定				// ステージ固有のカメラ設定がいる時はこのプロックで
	@ＶＲキャラ用ライト設置			// 必ず最後に設定
#if d:DEBUG_CHARA
//	@デバッグキャラセット
#endif
}

//初期マップの表示
command マップ表示 -show ストリーキング５面


// 各proc設定
//-------------------------------------------------------------------------------------
// 全マップ共通
proc ストリーキング５面ＶＲウィンドウ設定 {
	#if d:DEBUG_PRINT
		print 'vr_window_set'
	#endif

	@ＶＲストリーキングウィンドウ設定	d:WINDOW_STREAKING_ST05A


	// ＶＲウィンドウを表示する
	mesg ＶＲウィンドウ ＶＲウィンドウ君 開く

	// スタート時とクリア時に使用するカットインカメラ
	chara カメラ カットインカメラ		-c 0 -l 0 -p  0

	// スタート時のカメラ(必要な場合)
	chara カメラ設定 カットインカメラ \
		-c 1 \
		-p 7010,8223,-30710 -t 7000,2000,-34000 \
		-r 707,2050,0 -f 7039 \
		-a 200 \
		-i 0 -1 0 0 \
		-s 1
/*
面白。
-p 4344,108575,465599 -t 4344,105880,455975 \
-r 178,2048,0 -f 9994 \
-a 20 \
*/
}

//------------------------------------------------------------
// ステージ開始時処理
//------------------------------------------------------------
proc ＶＲステージ開始時処理 {
	#if d:DEBUG_PRINT
		print 'game_start!!!!!'
	#endif

	// プレイヤーやパッドの制御等を行う a_stdproc.hで定義
	@全ミッション共通ステージ開始時処理

	// カメラワークスタート(必要な場合)
	// 全体図
	chara カメラ設定 カットインカメラ \
		-c 1 \
		-p 7000,19891,19971 -t 7000,-9738,-28278 \
		-r 359,2048,0 -f 56620 \
		-a 200 \
		-i 4 4 d:START_CAMERA_CHANGE_TIME d:START_CAMERA_CHANGE_TIME \
		-s 1

	chara delay ディレイ \
		-time d:START_CAMERA_CHANGE_TIME \
		-exec {
			chara カメラ設定 カットインカメラ -s -1
		}
}

// ------------------------------------
// クリア時の処理
// ------------------------------------
proc ＶＲクリア時処理 {
	#if d:DEBUG_PRINT
		print 'clear'
	#endif
	// 強制モーションを発動
	@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_2 0

	// クリア時にカメラアングルを変える
	chara カメラ設定 クリア時カメラ \
		-c 1 \
		-p 6144,3624,-38000 -t 7208,3015,-33991 \
		-r 95,169,0 -f 4192 \
		-a 200 \
		-i 2 2 0 0 \
		-s 1
}

// ------------------------------------
// パラメータ系の変更
// ------------------------------------
// ローカル変数初期化
// ------------------------------------
proc ローカル変数初期化 {
	#if d:DEBUG_PRINT
		print 'localvar_init'
	#endif
	$$i:裸ライデンタイム = $i:A_ストリーキングミッションタイム;
	#if d:DEBUG_PRINT// このステージから始まった場合(デバッグ用)
		if( $$i:裸ライデンタイム == 0 ){
			$$i:裸ライデンタイム = (60*60*99);
		}
		print '裸ライデンタイム' ($$i:裸ライデンタイム/3600)'min'
	#endif
}
// 設定値を変更
// ------------------------------------
proc 設定値変更 {
	#if d:DEBUG_PRINT
		print 'status_set'
	#endif
}
// プラグインプログラム
// ------------------------------------
proc プラグイン設定 {
	#if d:DEBUG_PRINT
		print 'plugin_set'
	#endif
}
// ------------------------------------
// 敵兵や的の処理
// ------------------------------------
// 敵兵に関する設定
//-------------------------------------
proc 警備兵セット {
	#if d:DEBUG_PRINT
		print 'watcher_set'
	#endif
	// 裸雷電時の敵配置
	//  ノード番号注意。0から始まってないのもあるですYO!
	@VR_警備兵 敵兵:01 d:E_R:雷電道１	0 d:WATCHER_STATUS
	@VR_警備兵 敵兵:02 d:E_R:雷電道２	3 d:WATCHER_STATUS
	@VR_警備兵 敵兵:03 d:E_R:雷電道３	4 d:WATCHER_STATUS
	@VR_警備兵 敵兵:04 d:E_R:雷電道４	0 d:WATCHER_STATUS
	@VR_警備兵 敵兵:05 d:E_R:雷電道５	0 d:WATCHER_STATUS
}

proc 攻撃兵セット {
	#if d:DEBUG_PRINT
		print 'attacker_set'
	#endif
	// 雷電時の敵配置
	@VR_探索攻撃兵		攻撃兵:01 d:ATTACKER_STATUS d:E_R:雷電道６
	@VR_サポート攻撃兵	攻撃兵:02 d:ATTACKER_STATUS 敵兵:01

}

proc 警備兵コマンダー {
	#if d:DEBUG_PRINT
		print 'wccomm_set'
	#endif

	chara 警備コマンダー wccomm -e {警備兵セット}
}

proc 攻撃兵コマンダー {
	#if d:DEBUG_PRINT
		print 'atcomm_set'
	#endif
	chara 攻撃コマンダー atcomm -e {攻撃兵セット}
}

proc コマンダー設定 {
	#if d:DEBUG_PRINT
		print 'commander_set'
	#endif

	chara コマンダー 敵兵セット \
		-w 警備兵コマンダー \
		-a 攻撃兵コマンダー \
		-d ストリーキング５面 \
		-r 7000,2000,-34000 ストリーキング５面 \
		-c 7000,2000,-34000 ストリーキング５面 \
		-v [ene_vr_voice:01] \
		-z $i:敵標準麻酔持続 \
		-h $i:標準警戒時間 \
		-o $i:敵標準気絶持続 \
		-s (d:ENE_STAGE_GPS | d:ENE_STAGE_VR_ANOTHER ) \
		-b 0 \
		-m d:ALERT_MODE_SENNYU
}

proc 監視カメラ設置 {
	#if d:DEBUG_PRINT
		print 'svc_camera'
	#endif
	//簡易監視カメラ 		名前       		位置 				取付縦 横 中心角 初期角	 振り幅	flg	首振り待ち時間
	@vs08a_簡易監視カメラ ゴール階段左		4500 2700 -26000 	600    0 	  3640 100		 420 	0 	60
//	@vs08a_簡易監視カメラ ゴール階段左		9500 2700 -26000 	600    0 	  3640 0		 600 	0 	60
}


