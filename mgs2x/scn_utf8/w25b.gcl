	// 子画面設定 
	// ------------------------------------
	proc 子画面設定 {
		#if d:DEBUG_PRINT
			print 'sub_camera_set'
		#endif
		chara サブ画面 子画面 \
			-w (512-d:SUB_MARGIN-d:SUB_WIDTH),d:SUB_MARGIN (512-d:SUB_MARGIN),(d:SUB_HEIGHT+d:SUB_MARGIN)
	}

	// ステージカメラ設定 
	// ------------------------------------
	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif
		chara カメラ ステージカメラ		-c 0 -l 3 -p 0 
		chara カメラ 小部屋カメラ		-c 0 -l 2 -p 40
		chara カメラ 通路カメラ			-c 0 -l 2 -p 35
		chara カメラ 小部屋強カメラ		-c 0 -l 2 -p 33
		chara カメラ ビヨンドカメラ		-c 0 -l 2 -p 30
		chara カメラ サイファカメラ		-c 0 -l 2 -p 25
		chara カメラ モーションカメラ		-c 0 -l 2 -p 20
		chara カメラ カットインカメラ		-c 0 -l 2 -p 10
		chara カメラ ロードカメラ		-c 0 -l 2 -p 5

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \	
			-b d:CAM_MIN,      500,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
