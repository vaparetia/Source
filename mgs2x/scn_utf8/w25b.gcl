	// ＢＧＭ
	// ------------------------------------
	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT 
			print 'bgm_set'
		#endif
		chara ＢＧＭマネージャー ＢＧＭマネ
		chara ＢＧＭ風音 風音 \
			-s d:BGM_WINDNOISE_WEATHER_FAIN
		@サウンド効果音設定
	}

	// 入出トラップ
	// ------------------------------------
	proc ロードプロック {
		#if d:DEBUG_PRINT 
			print 'load_proc'
		#endif
		// 次のステージが潜入モードならばBGMをフェードアウト
		if ( `command 再生ＢＧＭ取得` != d:SNG_PLAY_04 && $w:スタートアラートモード == d:ALERT_MODE_SENNYU) {
			command セットサウンドコード -c d:SNG_FOUTS_S		//ＢＧＭフェードアウト
		} else if ( `command 再生ＢＧＭ取得` != d:SNG_PLAY_05 && $w:スタートアラートモード == d:ALERT_MODE_KAIHI) {
			command セットサウンドコード -c d:SNG_FOUTS_S		//ＢＧＭフェードアウト
		}
		if ($s:呼び出しプロック == mv_w25b_w25c_0) {
			// ＫＬ連絡橋へ
			@mv_w25b_w25c_0
		}
	}

	proc ロード設定 {
		#if d:DEBUG_PRINT 
			print 'load_set'
		#endif

		// タイトロープ２へ
		trap ld001 d:PLAYER \
			-mask 入る \
			-key d:PAD_ACTION \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 1 ) {
					preseek 'w25c'
					@w25b専用ステージ終了時処理 41000 -3000 -196125 1024 mv_w25b_w25c_0 d:DEFAULT_M_TYPE d:wn_Ｌ脚外周
				}
			}
	}

	proc マップ切り替え設定 {
		#if d:DEBUG_PRINT 
			print 'map_change'
		#endif

		print 'map change! #01 -> #02 -----------------======================'

		trap ev002 d:PLAYER \
			-mask 入る \
			-exec {
				#if d:DEBUG_PRINT
					print 'map change! #01 -> #02 -------------------------------------------'
				#endif
				print 'map change! #01 -> #02 -------------------------------------------'
				command キャラマップチェンジ -name d:PLAYER -map タイトロープ２
				// 処理を軽くするためステージ置き炎を軽減
				mesg ステージ置き炎 fire2 キル ;
				command 全体マップリアルタイム設定 -p d:ＧＬ連絡橋マップ
			}
	}

	// オブジェクト設置
	// ------------------------------------
	proc オブジェクト設置 {
		#if d:DEBUG_PRINT
			print 'w25b_object_set'
		#endif
		chara プットオブジェ 掴まり棒 -m d:KMS_NAMEP -r 0,-284,0 -p 3000,0,-144350  -l d:LT2_NAME 
	}

	// 背景設置
	// ------------------------------------
	proc 背景設置 {
		#if d:DEBUG_PRINT
			print 'w25b_sea_set'
		#endif
		chara プラント海面 plant_sea \
			-single_mode \	// シングルテクスチャモード
			-tex oil d_oil_sea_alp_ovl_mod0222 d_oil_ref_add_alp_ovl_mod1120 \
			-pos 0,-40000,-180000 \
			-w 1 2 3 \
			-l 
		chara 拡張海表示 sea_serface_ex		\
			-t	d_oil_sea_alp_ovl_mod0222	\
			-pos	0,-40000,-180000
		mesg プラント海面 plant_sea 上下運動計算処理 0
		@昼空（レンズフレア指定） 0 -40000 -180000 -2700 -3100 -2700 2
		@風基本設定
	}

	// リアル影
	// ------------------------------------
	proc リアル影設置 {
		#if d:DEBUG_PRINT
			print 'real_shadow'
		#endif
		// 影投影モデル -m 影投影専用モデル -p 設置位置
		chara 影投影モデル 影投影モデル -m d:KMS_NAME0 -p -3,6,-3

		// 影管理 -t 光源タイプ -l 光源距離(並行光源時のみ有効) -p 並行光源方向直接指定
		chara 影管理 影管理 -t 0 -l 6000 -p -2700 -3100 -2700
		mesg 影管理 影管理 add d:PLAYER 影投影モデル
	}

	// アイテム
	// ------------------------------------
	proc アイテム設置 {
		#if d:DEBUG_PRINT
			print 'item_set'
		#endif
		@弾薬_ＰＳＧ１_初期設置 ＰＳＧ１弾 -1500 -5250 -156000 0
		
		if ( $w:武器弾数Ｒ[d:武器:ＰＳＧ１－Ｔ] >= 0 ) {	/* 持ってたら出す */
			@弾薬_ＰＳＧ１－Ｔ_初期設置 ＰＳＧ１－Ｔ弾 499 -3500 -163597 0
		} else {
			@弾薬_ＰＳＧ１_初期設置 ＰＳＧ１弾 499 -3500 -163597 0
		}
		@レーション_初期設置 レーション 8375  -3875 -145000 0	// パイプ上

		if (( $w:プレイヤーフラグ & d:PL_AK_SPPRSR_ATTACHED ) || ( $w:アイテム数Ｒ[ d:アイテム:ＡＫサプレッサ ] > 0 )) {
			// AKサプレッサを装備済みか入手状態
			@弾薬_ＡＫＳ_初期設置 ＡＫサプレッサ弾 -2000 -4000 -163125 0	// 炎の向こう
		} else {
			// 上記以外
			@ＡＫサプレッサ_初期設置 ＡＫサプレッサ -2000 -4000 -163125 0	// 炎の向こう
		}

		// ユーザーを崩落階段へ誘う「餌」
		@レーション_初期設置 落下予定特殊レーション -3250  -4250 -147000 0	// 崩落階段の上
	}
	proc アイテム取得時番号設定 $:ボックス名 {
		#if d:DEBUG_PRINT
			print 'item_no_set'
		#endif
		/* このステージへ帰ってくることは出来ないため再セット処理不要 */
	}


