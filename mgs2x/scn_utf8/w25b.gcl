// 以下デバッグ専用proc
// -----------------------------------------------------------------------------------
// デバッグキャラ
// ------------------------------------
proc デバッグキャラセット {
	#if d:DEBUG_PRINT
		print 'debug_chara_set'
	#endif

	#if d:CHARA_CAMERA
		chara キャラカメラ 敵兵カメラ \
			-c d:TARGET_CHARA \
			-s -920,610,200 \
			-r -200,1024,0 
	#endif

	#if d:SCREENSHOT
		chara スクリーンショット shot
	#endif

	#if d:USB_KEY
		chara USBキーボード実行 test \
			-e d:KBD_ESC {
				mesg プレイヤー d:PLAYER position -5500, -13000, -500
			} \
	#endif
	#if d:FALLDOWN_RESET
		trap ev001 d:PLAYER \
			-mask 入る \
			-exec {
				@ジャンプ落下死発動 0x0004 -41000
			}
	#endif

	// 消えない炎
	trap ev007 d:PLAYER -mask 入る -exec {
		if ( $f:侵入禁止炎設置済み == 0 ) {
			eval( $f:侵入禁止炎設置済み = 1 ) ;
			chara ステージ置き炎 fire3a -f 1 -s 2 -pos   4250 -4000 -163750  -xwidth 250 -zwidth 750 
			chara ステージ置き炎 fire3b -f 1 -s 2 -pos   4250 -4000 -163000  -xwidth 250 -zwidth 750 
		}
	}

	trap ev008a d:PLAYER -mask ？ -exec {
		command プレイヤー状態取得 ;
		if($status & d:PFLAG_RUN) {
			#ifndef PAL
				@プレイヤーツルリン 3072 -18
			#else
				@プレイヤーツルリン 3072 -20
			#endif
		}
	}
	trap ev008b d:PLAYER -mask ？ -exec {
		command プレイヤー状態取得 ;
		if($status & d:PFLAG_RUN) {
			#ifndef PAL
				@プレイヤーツルリン 1024 18
			#else
				@プレイヤーツルリン 1024 20
			#endif
		}
	}
	trap ev008c d:PLAYER -mask ？ -exec {
		command プレイヤー状態取得 ;
		if($status & d:PFLAG_RUN) {
			#ifndef PAL
				@プレイヤーツルリン 3072 -18
			#else
				@プレイヤーツルリン 3072 -20
			#endif
		}
	}

	trap ev009 d:PLAYER -mask ？ -exec {
		if ( $3 == 入る ) {
			// パイプの上はダンボール系禁止
			command	不可装備設定 -item 	d:アイテム:ダンボール, \
							d:アイテム:ダンボールＢ, \
							d:アイテム:ダンボールＣ, \
							d:アイテム:濡れダンボール, \
							d:アイテム:ダンボールＤ, \
							d:アイテム:ダンボールＥ 
		} else {
			command	不可装備設定 -cancel			//設定リセット
		}
	}
	trap ev004 d:PLAYER -mask 入る -exec {
		if ( !$f:w25b_デモカット再生済み ) {
			if ( $w:ゲーム設定 >= d:LEVEL_EASY ) {
				command パッド操作 -release
				chara delay 遅延 -time (1*60) -exec {
					@敵兵デモ発動
				}
			}
		}
	}
}
proc 敵兵デモ発動 {
	if ( $f:w25b_デモカット再生済み == 0 && $w:アラートモード == d:ALERT_MODE_SENNYU ) {
		eval( $f:w25b_デモカット再生済み = 1 ) ;
		chara delay 敵兵デモ遅延 -time 60 -exec {
			// 敵兵始動
			mesg 敵兵共通 敵兵:01 永久アンリアルＯＦＦ
			mesg 敵兵共通 敵兵:02 永久アンリアルＯＦＦ
			//mesg サイファ サイファー:01 アンセットアンリアル
			// 敵兵デモ終了後、通常巡回ルートへ復帰
			chara delay 敵兵通常ルート移動遅延 -time (10*60) -exec {
				mesg タイトロープ兵 敵兵:01 ルート変更 0 0
				mesg タイトロープ兵 敵兵:02 ルート変更 1 0
			}
			// デモカメラ準備
			if ( $w:ゲーム設定 >= d:LEVEL_EASY ) {
				@シナリオカメラデモフラグ変更 (d:SDEMO_CINEMASCREEN_ON | d:SDEMO_CANCEL_ENABLE | d:SDEMO_RADAR_OFF | d:SDEMO_PAD_DISABLE) 1 (5*60)
				@シナリオカメラデモ（シネマ） 14 $i:カメラＸ位置,$i:カメラＹ位置,$i:カメラＺ位置,$i:注視点Ｘ位置,$i:注視点Ｙ位置,$i:注視点Ｚ位置,200  37110,3287,-196562 38080,-259,-206571 200
			} else if ( $w:ゲーム設定 >= d:LEVEL_NORMAL ) {
				@シナリオカメラデモフラグ変更 (d:SDEMO_CINEMASCREEN_ON | d:SDEMO_CANCEL_ENABLE | d:SDEMO_RADAR_OFF | d:SDEMO_PAD_DISABLE) 1 (10*60)
				@シナリオカメラデモ（シネマ） 14 $i:カメラＸ位置,$i:カメラＹ位置,$i:カメラＺ位置,$i:注視点Ｘ位置,$i:注視点Ｙ位置,$i:注視点Ｚ位置,200  37110,3287,-196562 38080,-259,-206571 200
			}
		}
	}
}

proc プレイヤーツルリン $:p_角度 $:p_横滑り速度 {
	command	強制モーション終了プロック -proc ツルリン終了 
	mesg プレイヤー d:PLAYER motion d:モーションリスト:non_slip $:p_角度 $:p_角度 d:FA_END_DOWN_BACK 0
	eval( $i:横滑り座標 = $i:プレイヤー位置Ｘ ) ;
	eval( $i:横滑り速度 = $:p_横滑り速度 )
	chara プロック連続実行 横滑り移動用 -proc 横滑り移動
}
proc 横滑り移動 {
	command	プレイヤー床高さ取得 -current 
	if ( $status < -6875 ) {
		command 強制モーションキャンセル
		@ツルリン終了
	}
	mesg プレイヤー d:PLAYER position2 0 $i:横滑り座標
	eval( $i:横滑り座標 = $i:横滑り座標 + $i:横滑り速度 ) ;
}
proc ツルリン終了 {
	mesg プロック連続実行 横滑り移動用 kill ;
}


proc 崩落床セット {
	// ------------------------------------
	// 崩れ落ちそうな階段
	chara プット落下オブジェ 崩落階段 \
	        -model w25b_step00 \
	        -rot   0,0,-100 \
	        -pos   -3000, -1500, -150000 \
		-proc  階段落下開始

	trap ev010 d:PLAYER -mask ？ -exec {
		if ( $3 == 入る ) {
			// 入ったら揺らして、一定時間内にトラップから出ない場合は崩落
			mesg プット落下オブジェ 崩落階段 揺らす
			chara delay 崩落遅延 -time (4*60) -exec {
				mesg プット落下オブジェ 崩落階段 落下
				chara delay 崩落遅延２ -time 30 -exec {
					chara カメラ設定 ビヨンドカメラ -s -1
				}
			}
			chara カメラ設定 ビヨンドカメラ \
				-c 0 \
				-b -320000 -320000 -320000 320000 320000 320000 \
				-l -320000 -320000 -320000 320000 320000 320000 \
				-r 436,1802,0 -f 7122 \
				-a 200 \
				-i 1 1 0 0 -s 1
		} else {
			print 'ev010 out -----------------------------------'
			mesg プット落下オブジェ 崩落階段 落下
			chara カメラ設定 ビヨンドカメラ -s -1
		}
	}


	chara 崩落床 崩落床手前１ \
		-position (12514+680) (-1842+113) (-169493-175) \
		-rotate 100 -338 60 \
		-model w25b_fl01 w25b_trap_dammy1\
		-hazard 12514 -1842 -169493 \
			13374 -1755 -168989 \
			13862 -1605 -169848 \
			13003 -1691 -170352 \
		-map タイトロープ１ \
		-status 0 \
		-fall_time (30*3) \
		-se_pattern 0 \
		-fall_pattern 2 \
		-proc 崩落床手前落下
	chara 崩落床 崩落床手前２ \
		-position (12025+680) (-1992+113) (-168633-175) \
		-rotate 100 -338 60 \
		-model w25b_fl01  w25b_trap_dammy1\
		-hazard 12025 -1992 -168633 \
			12885 -1905 -168130 \
			13374 -1755 -168989 \
			12514 -1842 -169493 \
		-map タイトロープ１ \
		-status 0 \
		-se_pattern 1 \
		-fall_pattern 0 \
		-fall_time (30*3) \
		-proc 崩落床手前落下

	trap fa001 d:PLAYER -mask ？ -exec {
			if ( $3 == 入る ) {
				eval( $b:w25b崩落床手前スイッチ = 1 ) ;
			} else {
				if ( $b:w25b崩落床手前スイッチ == 1 ) {
					if ( $i:プレイヤー位置Ｚ < -169500 ) {
						/* 手前に戻った場合は落とさない */
						mesg 崩落床 崩落床手前１ fall
						mesg 崩落床 崩落床手前２ fall
					} else {
						eval( $b:w25b崩落床手前スイッチ = 0 )
					}
				} else {
					eval( $b:w25b崩落床手前スイッチ = 0 )
				}
			}
	}
	trap fa002 d:PLAYER -mask ？ -exec {
			if ( $3 == 入る ) {
				eval( $b:w25b崩落床中央スイッチ = 1 ) ;
			} else {
				if ( $b:w25b崩落床中央スイッチ == 1 ) {
					if ( $i:プレイヤー位置Ｚ < -171465 ) {
						/* 手前に戻った場合は落とさない */
						mesg 崩落床 崩落床中央１ fall
						mesg 崩落床 崩落床中央２ fall
					} else {
						eval( $b:w25b崩落床中央スイッチ = 0 )
					}
				} else {
					eval( $b:w25b崩落床中央スイッチ = 0 )
				}
			}
	}
	trap fa003 d:PLAYER -mask ？ -exec {
			if ( $3 == 入る ) {
				eval( $b:w25b崩落床奥スイッチ = 1 ) ;
			} else {
				if ( $b:w25b崩落床奥スイッチ == 1 ) {
					if ( $i:プレイヤー位置Ｚ < -175579 ) {
						/* 手前に戻った場合は落とさない */
						mesg 崩落床 崩落床奥１ fall
						mesg 崩落床 崩落床奥２ fall
					} else {
						eval( $b:w25b崩落床奥スイッチ = 0 )
					}
				} else {
					eval( $b:w25b崩落床奥スイッチ = 0 )
				}
			}
	}

	trap fa001 d:PLAYER -mask いる -exec {
		command 崩落床状態取得 -name 崩落床手前１
		eval( $b:崩落床手前１状態 = $status ) ;
		command 崩落床状態取得 -name 崩落床手前２
		eval( $b:崩落床手前２状態 = $status ) ;
			//0: 誰も乗ったことがない
			//1: 誰かが一度のってへこんでいる
			//2: すでに落ちている
		if (( $f:w25b崩落床シナリオカメラ != 1 ) && (( $b:崩落床手前１状態 == 1) || ( $b:崩落床手前２状態 == 1))) {
			eval( $f:w25b崩落床シナリオカメラ = 1 ) ;
			command varsave $f:w25b崩落床シナリオカメラ ;	/* コンティニュー後はもう出ない */
			@シナリオカメラデモフラグ変更 (d:SDEMO_CINEMASCREEN_ON | d:SDEMO_CANCEL_ENABLE | d:SDEMO_RADAR_OFF | d:SDEMO_PAD_DISABLE) 1 30
			@シナリオカメラデモ 14 $i:カメラＸ位置,$i:カメラＹ位置,$i:カメラＺ位置,$i:注視点Ｘ位置,$i:注視点Ｙ位置,$i:注視点Ｚ位置,200 \
				15029,-1216,-166992 7997,-4327,-174377 200
		}
	}



	// ------------------------------------
	chara 崩落床 崩落床中央１ \
		-position (13980+680) ,(-1391+113) ,(-172071-175) \
		-rotate 100 -338 60 \
		-model w25b_fl01  w25b_trap_dammy1\
		-hazard ((13491+14469)/2) ((-1541-1240)/2) ((-171212-172931)/2) \
			((14351+15328)/2) ((-1454-1153)/2) ((-170708-172427)/2) \
			15328 -1153 -172427 \
			14469 -1240 -172931 \
		-map タイトロープ１ \
		-status 0 \
		-se_pattern 0 \
		-fall_pattern 2 \
		-fall_time (30*3) \
		-proc 崩落床中央落下
	chara 崩落床 崩落床中央２ \
		-position (13491+680) ,(-1541+113) ,(-171212-175) \
		-rotate 100 -338 60 \
		-model w25b_fl01  w25b_trap_dammy1\
		-hazard 13491 -1541 -171212 \
			14351 -1454 -170708 \
			((14351+15328)/2) ((-1454-1153)/2) ((-170708-172427)/2) \
			((13491+14469)/2) ((-1541-1240)/2) ((-171212-172931)/2) \
		-map タイトロープ１ \
		-status 0 \
		-se_pattern 1 \
		-fall_pattern 5 \
		-fall_time (30*3) \
		-proc 崩落床中央落下

	trap fa002 d:PLAYER -mask いる -exec {
		command 崩落床状態取得 -name 崩落床中央１
		eval( $b:崩落床中央１状態 = $status ) ;
		command 崩落床状態取得 -name 崩落床中央２
		eval( $b:崩落床中央２状態 = $status ) ;
			//0: 誰も乗ったことがない
			//1: 誰かが一度のってへこんでいる
			//2: すでに落ちている
		if (( $f:w25b崩落床シナリオカメラ != 1 ) && (( $b:崩落床中央１状態 == 1) || ( $b:崩落床中央２状態 == 1))) {
			eval( $f:w25b崩落床シナリオカメラ = 1 ) ;
			@シナリオカメラデモフラグ変更 (d:SDEMO_CINEMASCREEN_ON | d:SDEMO_CANCEL_ENABLE | d:SDEMO_RADAR_OFF | d:SDEMO_PAD_DISABLE) 1 30
			@シナリオカメラデモ 14 $i:カメラＸ位置,$i:カメラＹ位置,$i:カメラＺ位置,$i:注視点Ｘ位置,$i:注視点Ｙ位置,$i:注視点Ｚ位置,200  \
				17186,-602,-169456  9035,-3714,-175579 200
		}
	}

	// ------------------------------------
	chara 崩落床 崩落床奥１ \
		-position (16423+680),(-639+113),(-176368-175) \
		-rotate 100 -338 60 \
		-model w25b_fl01  w25b_trap_dammy1\
		-hazard 16423 -639 -176369 \
			17283 -552 -175865 \
			17771 -401 -176724 \
			16912 -488 -177228 \
		-map タイトロープ１ \
		-status 0 \
		-se_pattern 0 \
		-fall_pattern 4 \
		-fall_time (30*3) \
		-proc 崩落床奥落下
	chara 崩落床 崩落床奥２ \
		-position (15934+680) ,(-789+113) ,(-175509-175) \
		-rotate 100 -338 60 \
		-model w25b_fl01  w25b_trap_dammy1\
		-hazard 15934 -789 -175509 \
			16794 -702 -175005 \
			17283 -552 -175865 \
			16423 -639 -176369 \
		-map タイトロープ１ \
		-status 0 \
		-se_pattern 1 \
		-fall_pattern 0 \
		-fall_time (30*3) \
		-proc 崩落床奥落下

	trap fa003 d:PLAYER -mask いる -exec {
		command 崩落床状態取得 -name 崩落床奥１
		eval( $b:崩落床奥１状態 = $status ) ;
		command 崩落床状態取得 -name 崩落床奥２
		eval( $b:崩落床奥２状態 = $status ) ;
			//0: 誰も乗ったことがない
			//1: 誰かが一度のってへこんでいる
			//2: すでに落ちている
		if (( $f:w25b崩落床シナリオカメラ != 1 ) && (( $b:崩落床奥１状態 == 1) || ( $b:崩落床奥２状態 == 1))) {
			eval( $f:w25b崩落床シナリオカメラ = 1 ) ;
			@シナリオカメラデモフラグ変更 (d:SDEMO_CINEMASCREEN_ON | d:SDEMO_CANCEL_ENABLE | d:SDEMO_RADAR_OFF | d:SDEMO_PAD_DISABLE) 1 30
			@シナリオカメラデモ 14 $i:カメラＸ位置,$i:カメラＹ位置,$i:カメラＺ位置,$i:注視点Ｘ位置,$i:注視点Ｙ位置,$i:注視点Ｚ位置,200  \
				19098,105,-174351,13080,-2840,-179108 200
		}
	}
}
proc 崩落床手前落下 {
	#if d:DEBUG_PRINT
		print 'w25b_FALL_1'
	#endif
	mesg 崩落床 崩落床手前１ fall
	mesg 崩落床 崩落床手前２ fall
	mesg プレイヤー d:PLAYER position 13000,$i:プレイヤー位置Ｙ,-169250
	@ジャンプ落下死発動 0x0004 -41000
}
proc 崩落床中央落下 {
	#if d:DEBUG_PRINT
		print 'w25b_FALL_2'
	#endif
	mesg 崩落床 崩落床中央１ fall
	mesg 崩落床 崩落床中央２ fall
	mesg プレイヤー d:PLAYER position 14500,$i:プレイヤー位置Ｙ,-171875
	@ジャンプ落下死発動 0x0004 -41000
}
proc 崩落床奥落下 {
	#if d:DEBUG_PRINT
		print 'w25b_FALL_3'
	#endif
	mesg 崩落床 崩落床奥１ fall
	mesg 崩落床 崩落床奥２ fall
	mesg プレイヤー d:PLAYER position 16875,$i:プレイヤー位置Ｙ,-176250
	@ジャンプ落下死発動 0x0004 -41000
}
proc 階段落下開始 {
	#if d:DEBUG_PRINT
		print 'Step fall'
	#endif
	// アイテムがまだあれば落下開始
	mesg アイテム 落下予定特殊レーション 床監視開始
}

// ジャンプ落下死開始処理 (fall.h内部よりコールされる)
proc ジャンプ落下死開始処理 {
	eval( $w:ゲームオーバーカメラ回転値 = 2048) ;
	chara プロック連続実行 ゲームオーバー時のカメラ回転 -proc ゲームオーバーカメラ回転
	command ゲームオーバー背景設定 \
		-t gmov \
		-s dekisi_alp_ovl \
		-m 1
	@ゲームオーバー開始処理
}
proc  ゲームオーバーカメラ回転 {
	eval( $w:ゲームオーバーカメラ回転値 = ($w:ゲームオーバーカメラ回転値 + 2) & 4095 ) ;
	chara カメラ設定 カットインカメラ \
			-c 0 \
			-b d:CAM_MIN,-8500,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,-40000,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 3800,$w:ゲームオーバーカメラ回転値,0 -f 4340 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1
}

//  ゲームオーバー終了処理 (fall.h内部よりコールされる)
proc ゲームオーバー終了処理 {
	chara パッド振動 落下振動 -vibfile drop_sea
}

proc w25b専用ステージ終了時処理 $:目標位置Ｘ $:目標位置Ｙ $:目標位置Ｚ $:終了時方向 $:終了時プロック $:モーションタイプ $:表示文字 {
	// 梯子を上りながらのステージ切り替えを行うための特殊なステージ終了
	#if d:DEBUG_PRINT 
		print 'w25b special stage_end'
	#endif

	// 二重呼び防止のためにフラグを寝かす
	eval($f:ロードチェックＯＮフラグ = 0);

	// 次のステージへのアラートモード引継
	if ($w:ゲーム設定 <= d:LEVEL_EASY) {
		// easyより易しいレベルはロードすると潜入モード
		eval( $w:スタートアラートモード = d:ALERT_MODE_SENNYU );
	} else {
		if ($w:アラートモード == d:ALERT_MODE_KIKEN && $i:アラートレベル < 1024) {
			// 危険モード時(危険値MAXは除く)は回避モードまで下げる
			eval( $w:スタートアラートモード = d:ALERT_MODE_KAIHI );
		} else {
			eval( $w:スタートアラートモード = $w:アラートモード );
		}
	}

	if ($w:アラートモード != d:ALERT_MODE_KIKEN) {
		// 敵兵の視界オフ
		mesg コマンダー 敵兵セット 視界オフ
	}
	
	// 無線機からのコールがあった場合キャンセルをかける
	command 無線設定 -reset

	@特殊装備解除

	// パッド操作を奪う(無線やポーズもフラグをたてなければ不許可にする)
	command パッド操作 -release
	command メニュー設定 -menu off -gage off -radar off -subwin off -radio off -pause off

	// *********** ここからが梯子のぼりのための特別処理 ***************
	mesg プレイヤー d:PLAYER motion d:モーションリスト:non_ladder_up_c_start  1365 -1 0 \
		( d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT ) \
		40870 -196047 -2000
	mesg プレイヤー d:PLAYER motion d:モーションリスト:non_ladder_up_loop  -1 -1 0 \
		( d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT ) 
	mesg プレイヤー d:PLAYER motion d:モーションリスト:non_ladder_up_loop  -1 -1 0 \
		( d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT ) 
	mesg プレイヤー d:PLAYER motion d:モーションリスト:non_ladder_up_loop  -1 -1 0 \
		( d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT ) 
	chara カメラ設定 モーションカメラ \
		-c 1 \
		-p 37844,-3047,-192831 -t 39320,-2100,-194460 \
		-r -265,1568,0 -f 2393 \
		-a 200 \
		-i 0 -1 0 0 \
		-s 1
	// *********** ここまでが梯子のぼりのための特別処理 ***************

	eval($s:呼び出しプロック = $:終了時プロック);

	chara delay ステージ名表示ディレイ \
		-time 40 \
		-arg $:表示文字 \
		-exec {
			@ステージ名表示（終了時） $1
		}

	chara delay フェード遅延 -time 120 -exec {
		chara フェードインアウト フェードアウト \
			-c 0,0,0 128 \
			-t d:FADEOUT_TIME \		
			-p ロードプロック \
			-s 10
	}
}

proc w25b専用ステージ開始時処理 {
			// パッド操作を奪う(無線やポーズも不許可にする)
			command パッド操作 -release
			command メニュー設定 -radio off -pause off 

			// フェードインスタート(フェードの強さを弱める)
			chara フェードインアウト フェードイン \
				-i 0,0,0 128 \
				-c 0,0,0 0 \
				-t d:FADEIN_TIME -s 10

			// 前のステージの表示に文字を重ねる
			@ステージ名表示 d:wn_ＬＧ連絡橋

			command	強制モーション終了プロック \
				-proc 強制モーション終了時処理 

			mesg プレイヤー d:PLAYER motion d:モーションリスト:non_ladder_down_c_end  1365 -1 0 \
				( d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT ) \
				40970 -196047 -1500
}

proc w25b側ロード時カメラ設定 {
	chara カメラ設定 ロードカメラ \
		-c 1 \
		-p 41583,-100,-193889 -t 41002,-1711,-196041 \
		-r 408,2220,0 -f 2750 \
		-a 200 \
		-i 0 1 0 0 \
		-s 1

	chara プロック連続実行 カメラ戻し管理人 \
		-proc カメラ戻し管理
}
proc カメラ戻し管理 {
	command パッドチェック \
		-no_use
	if ($status != 1) {
		chara カメラ設定 ロードカメラ \
			-s -1
		mesg プロック連続実行 カメラ戻し管理人 kill
	}
}
proc 強制モーション終了時処理 {
	command パッド操作 -cancel
	command メニュー設定 -radio on -pause on
	eval($f:ロードチェックＯＮフラグ = 1);
}
