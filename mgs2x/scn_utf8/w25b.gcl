		#endif
		#if d:SMOKE
			chara テスト昇り煙 smoke \
				-radius 500 \
				-pos    8500 -4750 -144500
			chara テスト昇り煙 smoke \
				-radius 500 \
				-pos     125 -1250 -164000
			chara テスト昇り煙 smoke \
				-radius 500 \
