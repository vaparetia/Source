command 追加ＨＺＸグループ登録 -hzx_id 2 -add_id 25		// サブスタンスからＨＩ連絡橋を追加しました。2002.07.18 by 吉池

chara	マップ接合 タイトロープ１／２接合 タイトロープ１ タイトロープ２
chara	マップ接合 兆弾当たり結合 タイトロープ１ 兆弾専用グループ
mesg	マップ接合 タイトロープ１／２接合 on
mesg	マップ接合 兆弾当たり結合 on

command マップ設定 タイトロープ１ タイトロープ２ -set {
	@サウンド設定	// データは最初に呼ぶ
	@レーダー設定
	@常駐キャラ設定
	@共通シネマスクリーンセット
	@ローカル変数初期化
	@プラグイン設定
	@特殊装備解除
	@プレイヤー設定
	@コマンダー設定
	@ＢＧＭ設定	// プレイヤー→敵兵→BGMの順で呼ぶ
	@ロード設定
	@マップ切り替え設定
	@背景設置
	@オブジェクト設置
//	@リアル影設置
	@アイテム設置
	@フォグ設定
	@エフェクト設定
	@カメラセット
	@w25bカモメ配置
	@ＤＧ連絡橋破壊ビヨンド設定
	@タイトロープ１ジャンプ設定
	@タイトロープ１カメラ設定
	@キャラ用ライト設置		// マップ設定の最後に呼ぶ
	@サイファー設置
	@デバッグキャラセット
	
	if ( $s:登場ポイント == sp_w25a_w25b_0 ) {
		@プラント編全体マップ設定 d:ＤＧ連絡橋マップ	// stdproc.hで定義
	} else {
		@プラント編全体マップ設定 d:ＧＬ連絡橋マップ	// stdproc.hで定義
	}

}

command マップ設定 タイトロープ１ -set {
	if( $s:登場ポイント == sp_w25a_w25b_0 ) {
		@崩落床セット
	}
}

command マップ設定 タイトロープ２ -set {
	@ＤＧ連絡橋破壊ビヨンド設定２
}

// 無線用include ※位置は動かさないこと
#include "w25b_cdc.ch"


// 全てのセットが終わったところでフェードイン
if( $s:登場ポイント == sp_w25a_w25b_0 ) {
	// 破壊前ＤＧ連絡橋から
	//初期マップの表示
	command マップ表示 -show タイトロープ１
	command マップ表示 -show タイトロープ２
	// 全てのセットが終わったところでフェードイン
	@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:NO_MOVE_TYPE 0 0 0 d:wn_ＤＧ連絡橋
} else if( $s:登場ポイント == sp_w25c_w25b_0 ) {
	// タイトロープ後半から
	//初期マップの表示
	command マップ表示 -show タイトロープ１
	command マップ表示 -show タイトロープ２
	// 全てのセットが終わったところでフェードイン
	@w25b専用ステージ開始時処理
	@w25b側ロード時カメラ設定
}




// 各proc設定
//-------------------------------------------------------------------------------------
// 全マップ共通
	// サウンド
	// ------------------------------------
	proc サウンド設定 {
		#if d:DEBUG_PRINT 
			print 'sound_set'
		#endif

		chara サウンドマネージャー ＳＤマネ -pak 0
		@サウンド効果音設定 ;
		@弾痕跳弾設定
	}

	// 弾痕跳弾関係の設定
	// ------------------------------------
	proc 弾痕跳弾設定 {
		#if d:DEBUG_PRINT 
			print 'recoil_set'
		#endif

		command 弾痕ノーマル -n 0	// 通常
		command 弾痕ノーマル -n 1	// 階段、通常
		command 弾痕ノーマル -n 2	// 鉄板
		command 弾痕ノーマル -n 3	// 鉄筋
		command 弾痕ノーマル -n 4	// ダンボール
		command 弾痕ノーマル -n 5	// 木箱
		command 弾痕ノーマル -n 6	// パイプ中
		command 弾痕ノーマル -n 7	// パイプ大

		command 跳弾ノーマル -n 0
		command 跳弾ノーマル -n 1
		command 跳弾ノーマル -n 2
		command 跳弾ノーマル -n 3
		command 跳弾ノーマル -n 5
		command 跳弾水蒸気中 -n 6
		command 跳弾水蒸気大 -n 7
	}

	// レーダー
	// ------------------------------------
	proc レーダー設定 {
		#if d:DEBUG_PRINT 
			print 'menu set'
		#endif
		if ($w:ゲーム設定 <= d:LEVEL_VERYEASY) {
			@レーダーオンオフチェック 1
		} else {
			@レーダーオンオフチェック 0
		}
	}

	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT 
			print 'localvar_init'
		#endif
	}

	// ポリデモ
	// ------------------------------------
	// ノード端末
	// ------------------------------------

	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif

		#if d:JP_MOTION
			command プラグイン自動ジャンプ
		#endif
		command プラグイン落下
	}

	// プレイヤー 
	// ------------------------------------
	proc プレイヤー設定 {

		#if d:SHORTCUT
		eval($i:プレイヤー初期Ｘ位置 = 17495)
		eval($i:プレイヤー初期Ｙ位置 = 369 )
		eval($i:プレイヤー初期Ｚ位置 = -182785)
		#endif

		#if d:DEBUG_PRINT
			print 'player_set'
		#endif

		#if d:RAIDEN
			chara プレイヤー d:PLAYER \
				-p $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,$i:プレイヤー初期Ｚ位置 \
				-d 0,$i:プレイヤー初期方向,0 \
				-s 0 \
				-m rai_def -a raiden -o rai_w25b 
			@ライデン髪の毛設定 d:NORMAL_HAIR
			@プレイヤーＬＯＤ設定 d:C_DISTANCE_TYPE 4000

		#else if d:SNAKE
			chara プレイヤー d:PLAYER \
				-p $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,$i:プレイヤー初期Ｚ位置 \
				-d 0,$i:プレイヤー初期方向,0 \
				-s 0 \
				-m sna_def -a snake -o rai_common

				//バンダナ
				chara ロープモデル３ バンダナ１ \
					-n sna_bdn1 -d 1 \
					-y スネーク -z 12 -x 0,60,-90 -m 12 \
					-p 250 -k 350 -o 110 -f 1

				chara ロープモデル３ バンダナ２ \
					-n sna_bdn2 -d 1 \
					-y スネーク -z 12 -x 0,50,-90 -m 22 \
					-p 250 -k 350 -o 110 -f 1
		#endif
	}

	// 敵兵 
	// ------------------------------------
	proc タイト兵０ {
		#if d:DEBUG_PRINT
			print 'watcher_set'
		#endif
		
		if ($w:ゲーム設定 >= d:LEVEL_NORMAL) { /* 新ノーマル（イージー）以上のみ出現 */
			if ($f:w25bタイトロープ兵１死亡フラグ != 1) {
				// w25cからきた場合は状態継承
				// 敵兵セット前に置く
				if ( $s:直前のエリア == w25c ) {
					command 敵兵メモリーコピー \
						w25c \
						敵兵:03 \
						w25b \
						敵兵:01 \
						タイトロープ２ 
				}
				if ( $f:w25b_デモカット再生済み == 1 ) {
					eval( $b:w25b初期ルート１ = 0 ) ;
				} else {
					eval( $b:w25b初期ルート１ = 5 ) ;
				}
				if($w:ゲーム設定 > d:LEVEL_EXTREME) {
					// EExtremeでは、PSG1の発射音が聞こえる
					eval($w:タイトロープ兵聴力 = $w:敵標準聴力 * 3)
				} else {
					eval($w:タイトロープ兵聴力 = $w:敵標準聴力)
				}
				chara タイトロープ兵 敵兵:01 \
					-r $b:w25b初期ルート１ \
					-d 35695 169 -200710 \
					-p \
						32220 269 -198360 \
					//	28645 269 -196410 \
					//	25345 269 -194410 \
						21645 269 -192385 \
					-i d:ENE_SNEAK_SIGHT_W25,d:ENE_ALERT_SIGHT_W25,d:ENE_SNEAK_SIGHT_W25,d:ENE_SNEAK_SIGHT_W25 \ //視力
					-l $w:敵標準体力 -h $w:敵標準聴力 -f $w:敵標準気絶 \
					-mode 3 \
					-b 1 \
					-s 0x02 \
					-end w25bタイトロープ兵１死亡
				if ( $s:直前のエリア != w25c ) {
					mesg 敵兵共通 敵兵:01 永久アンリアルＯＮ
				}
			}
		}
		if ($w:ゲーム設定 >= d:LEVEL_EASY) { /* 新ハード（ノーマル）以上のみ出現 */
			if ($f:w25bタイトロープ兵２死亡フラグ != 1) {
				// w25cからきた場合は状態継承
				// 敵兵セット前に置く
				if ( $s:直前のエリア == w25c ) {
					command 敵兵メモリーコピー \
						w25c \
						敵兵:04 \
						w25b \
						敵兵:02 \
						タイトロープ２ 
				}
				if ( $f:w25b_デモカット再生済み == 1 ) {
					eval( $b:w25b初期ルート２ = 1 ) ;
				} else {
					eval( $b:w25b初期ルート２ = 6 ) ;
				}
				if($w:ゲーム設定 > d:LEVEL_EXTREME) {
					// EExtremeでは、PSG1の発射音が聞こえる
					eval($w:タイトロープ兵聴力 = $w:敵標準聴力 * 4)
				} else {
					eval($w:タイトロープ兵聴力 = $w:敵標準聴力)
				}
				chara タイトロープ兵 敵兵:02 \
					-r $b:w25b初期ルート２ \
					-d 33620 169 -199485 \
					-p \
					//	30320 269 -197335 \
						26995 269 -195435 \
						23670 269 -193485 \
					//	20020 269 -191385 \
					-i d:ENE_SNEAK_SIGHT_W25,d:ENE_ALERT_SIGHT_W25,d:ENE_SNEAK_SIGHT_W25,d:ENE_SNEAK_SIGHT_W25 \ //視力
					-l $w:敵標準体力 -h $w:タイトロープ兵聴力 -f $w:敵標準気絶 \
					-mode 3 \
					-b 1 \
					-s 0x02 \
					-end w25bタイトロープ兵２死亡
				if ( $s:直前のエリア != w25c ) {
					mesg 敵兵共通 敵兵:02 永久アンリアルＯＮ
				}
			}
		}
	}
	proc w25bタイトロープ兵１死亡 { eval( $f:w25bタイトロープ兵１死亡フラグ = 1 ) ; }
	proc w25bタイトロープ兵２死亡 { eval( $f:w25bタイトロープ兵２死亡フラグ = 1 ) ; }

