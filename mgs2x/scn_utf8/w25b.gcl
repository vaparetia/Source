	resource ghq_area_alert_voice {
	w25b:
		$t{
			// PLAREA0
			t:vc049009	// 指揮官「了解！敵を殲滅せよ！」
			-1
		}
	}

	resource ghq_caution_voice {
	w25b:
		$t{
			// PLAREA0
			t:vc040601,	// 指揮官　　「了解！僧院警戒を強化せよ！」
			-2,
			t:vc040065,	// 指揮官　　「どうした、応答しろ！」
			-1
		}
	}



	proc コマンダー設定 {
		#if d:DEBUG_PRINT
			print 'commander_set'
		#endif

		// タイト兵０で敵兵が一人も出ないとコマンダーの中が空になってしまい落ちてしまうため対処
		// 2002.07.01 吉池
		local $$:タイト兵起動したフラグ;

		if ($w:ゲーム設定 >= d:LEVEL_NORMAL) { /* 新ノーマル（イージー）以上のみ出現 */
			if ( $f:w25bタイトロープ兵１死亡フラグ == 1 && $f:w25bタイトロープ兵２死亡フラグ == 1 ) {
				$$:タイト兵起動したフラグ = 0;
			} else {
				$$:タイト兵起動したフラグ = 1;
			}
		} else if ( $w:ゲーム設定 >= d:LEVEL_EASY ) {
			if ( $f:w25bタイトロープ兵２死亡フラグ == 1 ) {
				$$:タイト兵起動したフラグ = 0;
			} else {
				$$:タイト兵起動したフラグ = 1;
			}
		} else {
			$$:タイト兵起動したフラグ = 0;
		}

		if ( $$:タイト兵起動したフラグ == 1 ) {
			chara コマンダー 敵兵セット \
				-w タイト兵コマンダー \
				-m $w:スタートアラートモード \
				-r 40125,0,-203250 タイトロープ２ \
				-c 40125,0,-203250 タイトロープ２ \
				-v [ene_plant_voice:04] \
				-x [ghq_area_alert_voice:w25b] \
				-y [ghq_caution_voice:w25b] \
				-f 5 2 t:vc045052 t:vc045052_len \
				   6 1 t:vc045051 t:vc045051_len \
				-s d:ENE_STAGE_GPS \
				-z $i:敵標準麻酔持続 \
				-b $w:敵標準再発生数 \
				-h $i:標準警戒時間 // 警戒時間←ここの行を追加する。
		} else {
			chara コマンダー 敵兵セット \
				-m $w:スタートアラートモード \
				-r 40125,0,-203250 タイトロープ２ \
				-c 40125,0,-203250 タイトロープ２ \
				-v [ene_plant_voice:04] \
				-x [ghq_area_alert_voice:w25b] \
				-y [ghq_caution_voice:w25b] \
				-f 5 2 t:vc045052 t:vc045052_len \
				   6 1 t:vc045051 t:vc045051_len \
				-s d:ENE_STAGE_GPS \
				-z $i:敵標準麻酔持続 \
				-b $w:敵標準再発生数 \
				-h $i:標準警戒時間 // 警戒時間←ここの行を追加する。
		}
	}
