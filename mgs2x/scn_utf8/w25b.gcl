				-pos   -136 -8185 -156498

			chara ステージ置き炎 fire2 -f 1 -proc 炎消火１ -pos    -780 -3775 -162500 -xwidth 250 -zwidth 646 	// Ｇ脚出入口を閉鎖
			eval( $f:ステージ置き炎燃焼１ = 1 );
			chara ステージ置き炎 fire2 -f 0 -proc 炎消火２ -pos    -750 -3562 -163646 -xwidth 250 -zwidth 500 	// Ｇ脚出入口を閉鎖
			eval( $f:ステージ置き炎燃焼２ = 1 );
			chara ステージ置き炎 fire2 -f 1 -proc 炎消火３ -pos    -780 -3450 -165046 -xwidth 250 -zwidth 900 	// Ｇ脚出入口を閉鎖
			eval( $f:ステージ置き炎燃焼３ = 1 );
			chara ステージ置き炎 fire2 -f 0 -proc 炎消火４ -pos    -400   500 -137750 -xwidth 250 -zwidth 250 	// Ｄ脚出入口を閉鎖（hzxに常駐当たりあり）
			eval( $f:ステージ置き炎燃焼４ = 1 );
			chara ステージ置き炎 fire2 -f 0 -proc 炎消火５ -pos     400   500 -137750 -xwidth 250 -zwidth 250 	// Ｄ脚出入口を閉鎖（hzxに常駐当たりあり）
			eval( $f:ステージ置き炎燃焼５ = 1 );
			chara ステージ置き炎 fire  -f 1 -proc 炎消火６ -pos    -625  -750 -148250 -xwidth 900 -zwidth 225 	// ＤＧ連絡橋の上
			eval( $f:ステージ置き炎燃焼６ = 1 );
			chara ステージ置き炎 fire2 -f 0 -proc 炎消火７ -pos   -1500  -750 -148170 -xwidth 500 -zwidth 225 	// ＤＧ連絡橋の上
			eval( $f:ステージ置き炎燃焼７ = 1 );
			chara ステージ置き炎 fire  -f 1 -proc 炎消火８ -pos   -2150  -750 -148230 -xwidth 700 -zwidth 250 	// ＤＧ連絡橋の上
			eval( $f:ステージ置き炎燃焼８ = 1 );
			chara ステージ置き炎 fire  -f 1 -proc 炎消火９ -pos   13750  1250 -188000 -xwidth 250 -zwidth 250 	// Ｇ脚のＬ脚側出入口
			eval( $f:ステージ置き炎燃焼９ = 1 );
			// 注意）"fire2"という名前になっている「炎」は、タイトロープ２へ移行した時点で処理軽減のため消火します。
		#endif
