				-k d:KMS_NAME2 \
				-k d:KMS_NAME3 \
				-k d:KMS_NAME4 \
				-k d:KMS_NAME5 \
				-k d:KMS_NAME6 \
				-k d:KMS_NAME7 \
				-k d:KMS_NAME8 \
				-k d:KMS_NAME9 \
				-k d:KMS_NAMEA \
				-k d:KMS_NAMEB \
				-k d:KMS_NAMEC \
				-k d:KMS_NAMED \
				-k d:KMS_NAMEE \
				-k d:KMS_NAMEF \
				-k d:KMS_NAMEG \
				-k d:KMS_NAMEH \
				-k d:KMS_NAMEI \
				-k d:KMS_NAMEJ \
				-k d:KMS_NAMEK \
				-k d:KMS_NAMEL \
				-k d:KMS_NAMEM \
				-k d:KMS_NAMEN \
				-k d:KMS_NAMEO \
				-k d:KMS_NAMEQ \
				-h d:HZX_NAME,0 -l d:LT2_NAME
chara マップ タイトロープ２ 	-k d:KMS_NAME1 -h d:HZX_NAME,1 -l d:LT2_NAME

command 追加ＨＺＸグループ登録 -hzx_id 2 -add_id 3
command 追加ＨＺＸグループ登録 -hzx_id 2 -add_id 4
command 追加ＨＺＸグループ登録 -hzx_id 2 -add_id 5
command 追加ＨＺＸグループ登録 -hzx_id 2 -add_id 6
command 追加ＨＺＸグループ登録 -hzx_id 2 -add_id 7
command 追加ＨＺＸグループ登録 -hzx_id 2 -add_id 8
command 追加ＨＺＸグループ登録 -hzx_id 2 -add_id 9
command 追加ＨＺＸグループ登録 -hzx_id 2 -add_id 10
command 追加ＨＺＸグループ登録 -hzx_id 2 -add_id 11
command 追加ＨＺＸグループ登録 -hzx_id 2 -add_id 12
command 追加ＨＺＸグループ登録 -hzx_id 2 -add_id 13
command 追加ＨＺＸグループ登録 -hzx_id 2 -add_id 14
command 追加ＨＺＸグループ登録 -hzx_id 2 -add_id 15
command 追加ＨＺＸグループ登録 -hzx_id 2 -add_id 16
command 追加ＨＺＸグループ登録 -hzx_id 2 -add_id 17
command 追加ＨＺＸグループ登録 -hzx_id 2 -add_id 18
command 追加ＨＺＸグループ登録 -hzx_id 2 -add_id 19
command 追加ＨＺＸグループ登録 -hzx_id 2 -add_id 20
command 追加ＨＺＸグループ登録 -hzx_id 2 -add_id 21
command 追加ＨＺＸグループ登録 -hzx_id 2 -add_id 22
command 追加ＨＺＸグループ登録 -hzx_id 2 -add_id 23
