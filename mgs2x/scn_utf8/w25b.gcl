	// ------------------------------------
	// ビヨンド設定
	// ------------------------------------
	proc ＤＧ連絡橋破壊ビヨンド設定 {
		#if d:DEBUG_PRINT
			print 'w25b_beyond_set'
		#endif

		// ca0**を例外的に使用して、片手エルードを実現（トラップの重なり問題でやむなく）
		trap ca001 d:PLAYER -mask ＊ -exec {
			command	プレイヤー床高さ取得 -current 
			if($status > -5000) {
				command プレイヤー状態取得 ;
				if(($status == 0) \
				|| ($status & d:PFLAG_WALK) \
				|| ($status & d:PFLAG_SUBJECT) \
				|| ($status & d:PFLAG_DAMAGED)) {
					// 歩きで入った
					command	プレイヤー床高さ取得
					if ( `@斜め片手ビヨンド発動 ca001 $4 $6 10900 -164700 12800 -168100 (d:BY_NOFOOTSHADOW | d:BY_FALL_DEAD | d:BY_NO_STAMP)` == 0 ) {
						if ( `@斜め片手ビヨンド発動 ca001 $4 $6 13800 -169800 14300 -170700 (d:BY_NOFOOTSHADOW | d:BY_FALL_DEAD | d:BY_NO_STAMP)` == 0 ) {
							if ( `@斜め片手ビヨンド発動 ca001 $4 $6 15300 -172400 16800 -175000 (d:BY_NOFOOTSHADOW | d:BY_FALL_DEAD | d:BY_NO_STAMP)` == 0 ) {
								if ( `@斜め片手ビヨンド発動 ca001 $4 $6 17700 -176700 19200 -179300 (d:BY_NOFOOTSHADOW | d:BY_FALL_DEAD | d:BY_NO_STAMP)` == 0 ) {
								}
							}
						}
					}
				}
			}
		}
		trap ca001 d:PLAYER \
			-camera \
			-mask ＊ \
			-state 6 \	// 強制モーション中
			-exec {
				command プレイヤー状態取得 ;
				if (( $status & d:PFLAG_ELUDE ) || ( $3 == 出る)) {
					chara カメラ設定 モーションカメラ \
						-c 0 \
						-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
						-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
						-r 3744,2593,0 -f 8221 \
						-a 200 \
						-i 0 0 0 0 \
						-s $3
				}
			}
		trap ca001 d:PLAYER \
			-camera \
			-mask ？ \
			-state 5 \	// エルード中
