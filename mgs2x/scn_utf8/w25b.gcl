// 各マップ別設定
// ------------------------------------
// タイトロープ１
	// 天井設置
	// ------------------------------------
	proc タイトロープ１天井設置 {
		#if d:DEBUG_PRINT
			print 'w25b0_ceil_set'
		#endif
	}


	// 強制モーション用トラップ
	// ------------------------------------
	// ジャンプ設定
	// ------------------------------------
	proc タイトロープ１ジャンプ設定 {
		#if d:DEBUG_PRINT
			print 'w25b_jump_set'
		#endif
		trap ky001 d:PLAYER \
			-mask 入る \
			-exec {
				@ジャンプ発動 ky001 1000 350
			}
		trap ky002 d:PLAYER \
			-mask 入る \
			-exec {
				@ジャンプ発動 ky002 1000 350
			}
		trap ky003 d:PLAYER \
			-mask 入る \
			-exec {
				// 飛び降りモーション発動用なので
				// 登れる高さは不可能値とする
				@ジャンプ発動 ky003 9999 1	
			}
	}

	// 各種カメラの設定
	// ------------------------------------
	proc タイトロープ１カメラ設定 {
		#if d:DEBUG_PRINT
			print 'w25b_camera_set'
		#endif

#define CUSHION 350
#define MAX_VEC_LENGTH 6400
		trap ca002 d:PLAYER -mask ＊ -exec {
			if( $3 == いる ) {
				command プレイヤーマップ名
				if ( $status == タイトロープ２ ) {
					eval( $i:ca002プレイヤーＸ座標 = $4 ) ;
					eval( $i:ca002プレイヤーＹ座標 = $5 ) ;
					eval( $i:ca002プレイヤーＺ座標 = $6 ) ;
					if ( $f:ca002サイファー状態 == 1 ) {
						@サイファー距離検査		// 距離にあわせてカメラ呼び分け
					} else  {
						@プレイヤー単独特殊カメラ	// プレイヤーだけいる
					}
				} else {
					@特殊カメラ消去				// プレイヤーがマップ違い
				}
			} else {
				@特殊カメラ消去					// プレイヤーが出た
			}
		}
		trap ca002 サイファー:01 -mask ＊ -exec {
			if( $3 == いる ) {
				eval( $f:ca002サイファー状態 = 1 ) ;
				eval( $i:ca002サイファーＸ座標 = $4 ) ;
				eval( $i:ca002サイファーＹ座標 = $5 ) ;
				eval( $i:ca002サイファーＺ座標 = $6 ) ;
			} else {
				eval( $f:ca002サイファー状態 = 0 ) ;
			}
		}

		// GL連絡橋(梯子下)
		trap ca003 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 小部屋カメラ \
					-c 1 \	
					-p 39708 525 -191893 \
					-t 40871 -1866 -195665 \
					-r 355,1853,0 -f 4615 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3
			}
		// シェル1シェル２連絡橋
		trap ca005 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				if ( $6 <= -143724 ) {
					@CS_スムーズカメラ２ $6 -151458 -143724 980 300 5500 8500
					eval( $i:補完ＲＸ = $i:CS_結果１ );
					if  ( $i:補完ＲＸ > 980 ) { eval( $i:補完ＲＸ = 980 ) } 
					eval( $w:トラック補完 = $i:CS_結果２ );
				} else {
					eval( $i:補完ＲＸ = 300 ) ;
					eval( $w:トラック補完 = 8500 ) ;
				}
				chara カメラ設定 小部屋カメラ \
					-c 0 \	
					-b -1772,-320000,-320000 320000 320000 -136432 \
					-l -245,-320000,-320000 320000 320000 -142580 \
					-r $i:補完ＲＸ,1900,0 \
					-f $w:トラック補完 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3
			}
		// てすり（大ジャンプ後）
		trap ca006 d:PLAYER \
			-mask ？ \
			-camera \
			-state d:TRP_STATE_CAUTION \
			-exec {
				chara カメラ設定 小部屋カメラ \
					-c 1 \	
					-p -2117,-555,-155994 -t -1949,-10133,-159401 \
					-r 801,2016,0 -f 10167 \
					-a 200 \
					-i 3 2 0 0 \
					-s $3
			}
		// 落下給水タンク付近
		trap ca007 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 小部屋カメラ \
					-c 1 \	
					-p -1315,8031,-135464 -t -197,912,-138812 \
					-r 724,1838,0 -f 7946 \
					-a 262 \
					-i 0 0 0 0 \
					-s $3
			}

		// タイトロープ２落下後付近
		trap ca016 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 小部屋強カメラ \
					-c 1 \	
					-p 21784,1285,-179261 -t 18533,-3285,-185125 \
					-r 390,2378,0 -f 8114 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3
			}

		// 張付きアングル換え
		// ------------------------------------
		trap ca100 d:PLAYER -mask ？ -camera -dir 1024,512 -state d:TRP_STATE_BEHINDCAMERA_ENABLE \
			-exec {
				chara カメラ設定 カットインカメラ \
					-c 0 \
					-b -320000 -320000 -320000 320000 320000 320000 \
					-l -320000 -320000 -320000 320000 320000 320000 \
					-r 1020,$i:カメラ角度Ｙ,0 -f 6400 \
					-a 200 \
					-i 2 -1 0 0 \
					-s $3
			}
		trap ca101 d:PLAYER -mask ？ -camera -dir 3072,512 -state d:TRP_STATE_BEHINDCAMERA_ENABLE \
			-exec {
				chara カメラ設定 カットインカメラ \
					-c 0 \
					-b -320000 -320000 -320000 320000 320000 320000 \
					-l -320000 -320000 -320000 320000 320000 320000 \
					-r 1020,$i:カメラ角度Ｙ,0 -f 6400 \
					-a 200 \
					-i 2 -1 0 0 \
					-s $3
			}
		trap ca102 d:PLAYER -mask ？ -camera -dir 2048,512 -state d:TRP_STATE_BEHINDCAMERA_ENABLE \
			-exec {
				chara カメラ設定 カットインカメラ \
					-c 0 \
					-b -320000 -320000 -320000 320000 320000 320000 \
					-l -320000 -320000 -320000 320000 320000 320000 \
					-r 1020,$i:カメラ角度Ｙ,0 -f 6400 \
					-a 200 \
					-i 2 -1 0 0 \
					-s $3
			}
		trap ca103 d:PLAYER -mask ？ -camera -dir 0,512 -state d:TRP_STATE_BEHINDCAMERA_ENABLE \
			-exec {
				chara カメラ設定 カットインカメラ \
					-c 0 \
					-b -320000 -320000 -320000 320000 320000 320000 \
					-l -320000 -320000 -320000 320000 320000 320000 \
					-r 1020,$i:カメラ角度Ｙ,0 -f 6400 \
					-a 200 \
					-i 2 -1 0 0 \
					-s $3
			}
	}

proc 共通シネマスクリーンセット {
	chara シネマスクリーン シネマ \
		-top d:CINEMA_BELT_UPPER \
		-bottom d:CINEMA_BELT_LOWER \
		-ftime 30	//デフォルト値（ゼロは駄目）
}

proc サイファー距離検査 {
	command VecLen \
		$i:ca002プレイヤーＸ座標 \
		$i:ca002プレイヤーＹ座標 \
		$i:ca002プレイヤーＺ座標 \
		$i:ca002サイファーＸ座標 \
		$i:ca002サイファーＹ座標 \
		$i:ca002サイファーＺ座標
	if ( $status < d:MAX_VEC_LENGTH ) {
		// 一定距離内にいる
		@サイファー追跡特殊カメラ
	} else {
		// 一定距離離れた
		@プレイヤー単独特殊カメラ
	}
}

proc サイファー追跡特殊カメラ {
	eval( $i:ca002サイファカメラＸ注視 = ( $i:ca002プレイヤーＸ座標 + $i:ca002サイファーＸ座標 ) / 2 );
	eval( $i:ca002サイファカメラＹ注視 = ( $i:ca002プレイヤーＹ座標 + $i:ca002サイファーＹ座標 ) / 2 );
	eval( $i:ca002サイファカメラＺ注視 = ( $i:ca002プレイヤーＺ座標 + $i:ca002サイファーＺ座標 ) / 2 );
	if ( $f:ca002初期化不必要フラグ == 0 ) {
		eval( $f:ca002初期化不必要フラグ = 1 ) ;
		eval( $i:中心ca002サイファカメラＸ注視 = $i:ca002サイファカメラＸ注視 );
		eval( $i:中心ca002サイファカメラＹ注視 = $i:ca002サイファカメラＹ注視 );
		eval( $i:中心ca002サイファカメラＺ注視 = $i:ca002サイファカメラＺ注視 );
	}
	if (( $i:ca002サイファカメラＸ注視 > ($i:中心ca002サイファカメラＸ注視 + d:CUSHION )) || ( $i:ca002サイファカメラＸ注視 < ($i:中心ca002サイファカメラＸ注視 - d:CUSHION ))) {
		eval( $i:差分ca002サイファカメラＸ注視 = $i:前回ca002サイファカメラＸ注視 - $i:ca002サイファカメラＸ注視 );
		eval( $i:中心ca002サイファカメラＸ注視 = $i:中心ca002サイファカメラＸ注視 - $i:差分ca002サイファカメラＸ注視 );
	}
	if (( $i:ca002サイファカメラＹ注視 > ($i:中心ca002サイファカメラＹ注視 + d:CUSHION )) || ( $i:ca002サイファカメラＹ注視 < ($i:中心ca002サイファカメラＹ注視 - d:CUSHION ))) {
		eval( $i:差分ca002サイファカメラＹ注視 = $i:前回ca002サイファカメラＹ注視 - $i:ca002サイファカメラＹ注視 );
		eval( $i:中心ca002サイファカメラＹ注視 = $i:中心ca002サイファカメラＹ注視 - $i:差分ca002サイファカメラＹ注視 );
	}
	if (( $i:ca002サイファカメラＺ注視 > ($i:中心ca002サイファカメラＺ注視 + d:CUSHION )) || ( $i:ca002サイファカメラＺ注視 < ($i:中心ca002サイファカメラＺ注視 - d:CUSHION ))) {
		eval( $i:差分ca002サイファカメラＺ注視 = $i:前回ca002サイファカメラＺ注視 - $i:ca002サイファカメラＺ注視 );
		eval( $i:中心ca002サイファカメラＺ注視 = $i:中心ca002サイファカメラＺ注視 - $i:差分ca002サイファカメラＺ注視 );
	}
	chara カメラ設定 サイファカメラ \
		-c 1 \
		-p ($i:中心ca002サイファカメラＸ注視+6000),($i:中心ca002サイファカメラＹ注視+4000),($i:中心ca002サイファカメラＺ注視+6000) \
		-t $i:中心ca002サイファカメラＸ注視,$i:中心ca002サイファカメラＹ注視,$i:中心ca002サイファカメラＺ注視 \
		-a 200 \
		-i 0 -1 0 0 \
		-s 1
	eval( $i:前回ca002サイファカメラＸ注視 = $i:ca002サイファカメラＸ注視 );
	eval( $i:前回ca002サイファカメラＹ注視 = $i:ca002サイファカメラＹ注視 );
	eval( $i:前回ca002サイファカメラＺ注視 = $i:ca002サイファカメラＺ注視 );
}

proc プレイヤー単独特殊カメラ {
	eval( $i:cpx =  $i:プレイヤー位置Ｘ +  519 )
	eval( $i:cpy =  $i:プレイヤー位置Ｙ + 8036 )
	eval( $i:cpz =  $i:プレイヤー位置Ｚ + 8822 )
	eval( $i:ctx =  $i:プレイヤー位置Ｘ + 1285 )
	eval( $i:cty =  $i:プレイヤー位置Ｙ + 2754 )
	eval( $i:ctz =  $i:プレイヤー位置Ｚ -  404 )
	chara カメラ設定 通路カメラ \
		-c 1 \
		-p $i:cpx,$i:cpy,$i:cpz \
		-t $i:ctx,$i:cty,$i:ctz  \
		-a 250 \
		-i 0 -1 0 0 \
		-s 1
	chara カメラ設定 サイファカメラ -s -1
}
proc 特殊カメラ消去 {
	chara カメラ設定 通路カメラ -s -1 ;
	chara カメラ設定 サイファカメラ -s -1 ;
}






