			chara テスト昇り煙 smoke \
				-radius 500 \
				-pos    -625 -250 -148250
			chara テスト昇り煙 smoke \
				-radius 500 \
				-pos    -1500 -250 -148250
			chara テスト昇り煙 smoke \
				-radius 500 \
				-pos    -2500 -250 -148250
			chara テスト昇り煙 smoke \
				-radius 500 \
				-pos    -625 -250 -148250
			chara テスト昇り煙 smoke \
				-radius 500 \
				-pos    5125 -3500 -141500
			chara テスト昇り煙 smoke \
				-radius 750 \
				-pos    10212 -7706 -164555
			chara テスト昇り煙 smoke \
				-radius 850 \
				-pos    -8903 -5071 -164199
			chara テスト昇り煙 smoke \
				-radius 1000 \
				-pos    -10593 1332 -170657
			chara テスト昇り煙 smoke \
				-radius 800 \
				-pos    3500 -4000 -163200
			chara テスト昇り煙 smoke \
				-radius 850 \
				-pos    18204 -831 -186533
			chara テスト昇り煙 smoke \
				-radius 700 \
				-pos    6850 -8000 -164599
