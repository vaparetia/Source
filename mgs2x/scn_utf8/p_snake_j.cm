//dv}//v
}//d

//ＬＩＦＥまんたんで楽 h //e
resource PS_水中＿ＬＩＦＥまんたん {
//vox t:vc211511 {
プリスキン_000: {
＃｛ＬＩＦＥ、ライフ｝＃が＃｛ＦＵＬＬ、フル｝＃の際には＃｛Ｏ２、オーツー｝＃ゲージの
減り具合も比較的、ゆっくりになる。
レーションを上手く使え。
}
//dv}//v
}//d


//野戦服の使い方 h //e
resource PS_野戦服足跡隠し {
//vox t:vc211521 {
プリスキン_000: {
スカルキャップがなければ
敵に化けるのはもう無理だな。
}
プリスキン_001: {
だがスカルキャップがなくなっただけで
他は全く同じ装備だとも言える……。
軍靴もな。
}
プリスキン_002: {
足跡が残る所で敵の＃｛野戦服、Ｂ．Ｄ．Ｕ｝＃を装備して
いれば足跡を敵に怪しまれることは
なくなるはずだ。
}
プリスキン_003: {
憶えておいてもいいだろう。
}
//dv}//v
}//d

//エアバースト h //e
resource PS_エアバースト {
//vox t:vc211531 {
プリスキン_000: {
ＲＧＢ６のグレネードは着弾しなくても
ＲＧＢ６を装備から外すとその時点で
爆発する。
}
プリスキン_001: {
これがエアバーストだ。グレネードを
空中の任意の地点で爆発させることが
できる。憶えておけ。
}
//dv}//v
}//d
//エルード戻りキック h //e
//＊ムービー t //e
resource PS_かねきっく {
//vox t:vc211541 {
プリスキン_000: {
エルードから這い上がる時の反動を
利用すれば敵を気絶させることもできる。
手すりの近くに敵がいる時に狙ってみろ。
}
//dv}//v
}//d

//エルードキャッチ h //e
//＊ムービー t //e
resource PS_かねきゃっち {
//vox t:vc211551 {
プリスキン_000: {
エルードから飛び降りる途中に
つかめそうな場所があったら＃｛△、アクション｝＃ボタンを
押してみるといい。
}
プリスキン_001: {
上手くすればつかまることができる
だろう。多少方向がずれていても
大丈夫だ。いろいろ試してみろ。
}
//dv}//v
}//d
//エルード踏み h //e
//＊ムービー t //e
resource PS_エルード踏み {
//vox t:vc211561 {
プリスキン_000: {
エルードから敵の真上に落下すれば、
敵を一撃で気絶させることができる。
主観で真下を見ながら狙ってみろ。
}
//dv}//v
}//d
//部位攻撃 h //e
resource PS_敵の部位攻撃 {
//vox t:vc211571 {
プリスキン_000: {
時と場合によって
敵を狙う部位を考えるんだ。
}
プリスキン_001: {
とくかく相手を倒すには
中枢神経系を破壊する……。
}
プリスキン_002: {
相手の運動機能を奪うだけなら、
運動機能を破壊する……。
}
プリスキン_003: {
相手を失血させるなら、
循環器系を破壊する……。
}
プリスキン_004: {
無線通信を妨害するなら、
無線機を破壊する。
}
プリスキン_005: {
その状況で一番効果的な攻撃をしろ。
それが生き残る秘訣だ。頭を使え。
いいな。
}
//dv}//v
}//d

//冷却スプレー h //e
resource PS_爆弾解体中＿冷却スプレー {
//vox t:vc211581 {
プリスキン_000: {
冷却スプレーはそのまま武器にもなる。
敵兵の顔に噴きつければ、しばらく目が
効かなくなる。
}
プリスキン_001: {
物は使いよう、ということだ。
戦場で生きのびたければ
工夫を忘れないことだな。
}
//dv}//v
}//d

//敵兵からのアイテム入手
resource PS_ゆすりアイテム搾取 {
//vox t:vc211591 {
プリスキン_000: {
倒した敵の体を＃｛□、武器｝＃ボタンで動かすと
アイテムボックスが出て来ることがある。
余裕があれば試してみろ。
}
//dv}//v
}//d

//ホールドアップ搾取 h //e
resource PS_ホールドアップ＿搾取 {
//vox t:vc211601 {
プリスキン_000: {
敵をホールドアップさせた後、
上手くやればアイテムを奪うことも
できるだろう。
}
プリスキン_001: {
ホールドアップからしか取得できない
アイテムもあるはずだ。
いろいろ試してみろ。
}
//dv}//v
}//d



//★後回し会話 d //e
//主観パンチ h //e
resource PS_主観パンチ {
//vox t:vc211611 {
プリスキン_000: {
近接戦闘の基本は格闘だ。＃｛○、パンチ｝＃ボタンで
出すパンチは主観でも放つことができる。
試してみろ。
}
//dv}//v
}//d
//ローリング活用 h //e
resource PS_ローリング活用 {
//vox t:vc211621 {
プリスキン_000: {
走りながら＃｛×、ホフク｝＃ボタンで出せる
ローリングを活用するんだ。
}
プリスキン_001: {
短い距離ならジャンプできるし、
上手く当てれば敵を吹き飛ばす
こともできる。
}
プリスキン_002: {
歩くと足音が鳴る床を
飛び越すのにも使えるだろう。
}
//dv}//v
}//d
//敵兵人質 h //e
resource PS_敵兵人質 {
//vox t:vc211631 {
プリスキン_000: {
首絞めで敵を捕まえていれば、
敵は仲間を撃つことを恐れて
攻撃をためらうだろう。
}
プリスキン_001: {
その間に逃げるのも手だ。
憶えておけ。
}
//dv}//v
}//d

//走り撃ち h //e
resource PS_走り撃ち１ {
//vox t:vc211641 {
プリスキン_000: {
銃を構えて左スティックを入れながら
Ｌ１ボタンか＃｛×、ホフク｝＃ボタンを押しっぱなしに
すれば銃を構えたまま移動できる。
}
//dv}//v
}//d
resource PS_走り撃ち２ {
//vox t:vc211642 {
プリスキン_000: {
Ｌ１ボタンを押しっぱなしにすれば、
銃を構えたまま移動することができる。
}
//dv}//v
}//d
resource PS_走り撃ち３ {
//vox t:vc211643 {
プリスキン_000: {
敵中突破を行う時には有効なはずだ。
憶えておくといいだろう。
}
//dv}//v
}//d

//Ｃ４連鎖爆発 h //e
resource PS_Ｃ４連鎖爆発 {
//vox t:vc211651 {
プリスキン_000: {
複数のＣ４を近距離に設置すれば１回の
起爆で連鎖して爆発させることができる。
上手くトラップを作るんだ。
}
//dv}//v
}//d

//防弾装備にグレネード h //e
resource PS_防弾装備にグレネード {
//vox t:vc211661 {
プリスキン_000: {
防弾装備を身につけた相手も
グレネードの爆風と破片までは
防げない。
}
プリスキン_001: {
グレネードを使えば戦闘を有利に
進められるはずだ。憶えておけ。
}
//dv}//v
}//d

//ニキータスピードアップ h //e
resource PS_ニキータスピードアップ {
//vox t:vc211671 {
プリスキン_000: {
リモコンミサイルは操作しなければ
飛行速度が上がる。
}
プリスキン_001: {
これを使えばリモコンミサイルを
より遠くまで飛ばすことができる
はずだ。
}
プリスキン_002: {
ミサイルの塔載燃料には限りがある
からな。無駄な操作はさけるんだ。
}
//dv}//v
}//d

//しゃがめば見つからない場所 h //e
resource PS_しゃがみ遮蔽物 {
//vox t:vc211681 {
プリスキン_000: {
背の低い遮蔽物には、しゃがめば
隠れられる物もある。そこから
ビハインドや飛び出し撃ちも可能だ。
}
プリスキン_001: {
まわりの物を全て利用しろ。
それが生き残る秘訣だ。
}
//dv}//v
}//d
//タクティカルリロード h //e
resource PS_タクティカルリロード {
//vox t:vc211691 {
プリスキン_000: {
銃撃戦で敵の目の前に飛び出した途端に
弾切れを起こしたら洒落にならんぞ。
タクティカル・リロードを使うんだ。
}
プリスキン_001: {
銃を一度装備から外すとマガジンの最大
数まで装弾する。Ｒ２ボタンのクイック
チェンジを使えば楽にできるはずだ。
}
//dv}//v
}//d



//Ｃ脚 d //e
//女子便所 h //e
resource PS_Ｃ脚女子トイレ {
//vox t:vc211701 {
プリスキン_000: {
雷電……お前、どこにいるんだ？
}
ライデン_001: {
いや、これは……。
}
プリスキン_002: {
なに、恥じることはない。
任務達成にはあらゆる手段を
尽くす必要がある。
}
ライデン_003: {
プリスキン……。
}
プリスキン_004: {
俺も昔はよく入ったもんだ……。
}
ライデン_005: {
……え？
}
//dv}//v
}//d



//シェル２中央棟 d //e
resource PS_シェル２中央棟＿濾過装置うんちく１ {
//vox t:vc211711 {
プリスキン_000: {
雷電、気をつけろ。
生物反応槽に落ちれば命はないぞ。
}
//dv}//v
}//d
resource PS_シェル２中央棟＿濾過装置うんちく２ {
//vox t:vc211721 {
オタコン_000: {
ああ。生物反応槽では微生物を使った
汚水処理を行っているんだ。
}
オタコン_001: {
その微生物の活性を保つために
常に大量の酸素が注入されている。
}
オタコン_002: {
だから水の比重がとても軽くなって
いるんだ。人間が浮かぶことはできない。
沈んでしまうんだ。
}
オタコン_003: {
落ちたら溺れるしかないだろう。
絶対に落ちるんじゃないよ、いいね。
}
//dv}//v
}//d


//ストーリー依存 d //e
//ヴァンプの事 h //e
resource PS_ヴァンプ１ {
//vox t:vc211731 {
プリスキン_000: {
デッドセルの１人。ヴァンプは
ルーマニア出身のナイフ使いだ。
腕前は……見ての通りだな。
}
プリスキン_001: {
幼い頃に一家で教会に行った時に
爆弾テロに巻き込まれて家族を
失っている。
}
プリスキン_002: {
奴は胸に教会の十字架が刺さった
ままの状態で、まる二日間瓦礫の
下に放置されていたそうだ。
}
プリスキン_003: {
その間、奴は流れ出た自分と家族の血を
なめて渇きを癒し、命をつないでいた
らしい。
}
プリスキン_004: {
血をすするようになったのは
それからだそうだ。
}
ライデン_005: {
それで＃｛吸血鬼、ヴァンパイア｝＃……か。
}
プリスキン_006: {
ああ。ちなみにヴァンパイアではなく
ヴァンプと呼ばれているのは、
奴がバイセクシャルだからだ。
}
//dv}//v
}//d
//ヴァンプとフォーチュンの関係を聞いていない場合 t //e
resource PS_ヴァンプ２ {
//vox t:vc211741 {
プリスキン_000: {
２年前に事故死した海兵隊司令官、
スコット・ドルフの愛人だったという
噂もある。
}
プリスキン_001: {
スコット・ドルフはデッドセルの
リーダー、フォーチュンの父親でも
あるな。
}
ライデン_002: {
フォーチュンの父親？
だが奴は彼女とも……。
}
プリスキン_003: {
ふん。よく観察しているな。
新米にしてはたいした余裕だ。
}
ライデン_004: {
いや……。
}
//dv}//v
}//d
resource PS_ヴァンプとフォーチュン {
//vox t:vc211751 {
プリスキン_000: {
そう。お前の見立てどおり、ヴァンプと
フォーチュンは関係があるらしい。
まあ恋人とは少し違うようだが。
}
ライデン_001: {
じゃあ、何だ？
友達？
}
プリスキン_002: {
それも違うだろうな。まあ人の絆なんて
よそからは測れんものさ。
}
ライデン_003: {
しかし……
自分の父親と寝ていた男だろ？
}
プリスキン_004: {
母親と寝ていたのなら良かったのか？
}
ライデン_005: {
……。
}
プリスキン_006: {
向こうもお前に理解してもらおうなんて
思ってはいまい。
くだらんことは気にするな。
}
ライデン_007: {
……。
}
//dv}//v
}//d
//ヴァンプ遭遇直後の場合 t //e
resource PS_ヴァンプ遭遇直後 {
//vox t:vc211761 {
ライデン_000: {
ところであんた、
奴と会ったことがあるのか？
}
プリスキン_001: {
いや。
}
ライデン_002: {
だが奴はあんたを知っているよう
だった……。
}
プリスキン_003: {
確かに……まさか……？
}
ライデン_004: {
何だ？
}
プリスキン_005: {
いや。デッドセルは言った通り凶人の
集団だ。奴等の言うことをいちいち
真に受けない方がいい。気にするな。
}
//dv}//v
}//d


//他のデッドセルの事 h //e
resource PS_デッドセル１ {
//vox t:vc211771 {
ライデン_000: {
デッドセルについて
もう少し教えてくれないか？
}
//dv}//v
}//d
resource PS_デッドセル２ {
//vox t:vc211781 {
プリスキン_000: {
デッドセルは＃｛ＳＥＡＬＳ、シールズ｝＃とは
言っても影の部隊だった。
}
ライデン_001: {
ああ。
政府の重要施設を抜き打ちで
奇襲する部隊、だったか？
}
プリスキン_002: {
そうだ。
元々は米軍設備の保安システムを
チェックするために設立されたんだ。
}
プリスキン_003: {
前の大統領、ジョージ・シアーズの
肝入りでな。
}
プリスキン_004: {
デルタフォースや＃｛ＳＥＡＬＳ、シールズ｝＃といった、
対テロリスト部隊の対極に位置する
闇の組織……。
}
ライデン_005: {
奴等は初めから……その……。
}
プリスキン_006: {
凶人の集団。
}
ライデン_007: {
ああ。
それだったのか？
}
プリスキン_008: {
いや。リーダーだったジャクソン大佐。
フォーチュンと言われている女の旦那が
投獄されたあたりからだろうな。
}
ライデン_009: {
投獄？
一体何を？
}
プリスキン_010: {
汚職。
公金の横領。
}
ライデン_011: {
軍人としては不名誉極まりないな。
}
プリスキン_012: {
世間の反応もお前と同じだったよ。
だがデッドセルの連中はそれを
冤罪と信じて疑わなかったようだ。
}
プリスキン_013: {
何度か上層部に掛け合ったりもしたよう
だが、なぜか再審理は行われなかった。
}
ライデン_014: {
本当に冤罪だったのか？
}
プリスキン_015: {
さあな。真相は闇の中だ。
しかし事実はどうあれ、結果として
デッドセルの名は地に落ちた……。
}
ライデン_016: {
……で、そのジャクソン大佐は
どうなったんだ？
}
プリスキン_017: {
レブンワース刑務所に収監されていた。
}
ライデン_018: {
いた？
出所したのか？
}
プリスキン_019: {
ああ。この世からな。
}
ライデン_020: {
え？
}
プリスキン_021: {
獄死したんだ。
衰弱死だったそうだが。
}
プリスキン_022: {
リーダーを失うのと同時に
奴等は歯止めも見境も
なくしたらしい。
}
プリスキン_023: {
それ以来デッドセルは先鋭化を続け
手のつけられない暴走をはじめた……。
}
ライデン_024: {
そのあげくがこのテロか？
}
プリスキン_025: {
そうかもな。
}
//dv}//v
}//d


//フォーチュンについて h //e
resource PS_フォーチュン１ {
//vox t:vc211792 {
ライデン_000: {
あの妙な女については何か知ってるか？
}
プリスキン_001: {
フォーチュンのことか？
デッドセルのリーダーだ。
}
プリスキン_002: {
本名、ヘレナ・ドルフ・ジャクソン。
}
プリスキン_003: {
通称、＃｛幸運の女神、フォーチュン｝＃……。
}
ライデン_003: {
幸運の女神？
}
プリスキン_004: {
そうとでも言うしかないだろう。
何しろ弾が当たらないんだ。
}
ライデン_005: {
……。
}
プリスキン_006: {
だがその幸運は私生活の不運と
引き換えにしたものだと彼女は
言ってるらしい。
}
ライデン_007: {
不運？
}
プリスキン_008: {
海兵隊司令官だった父親が死に、デッド
セルのリーダーだった旦那のジャクソン
大佐も横領でムショ送りになった。
}
プリスキン_009: {
まもなく夫の死と義理の息子の服役に
耐えかねたのか、母親が自殺。
}
プリスキン_010: {
フォーチュン自身もそのショックで
当時三ヶ月だった子供を流産。
とどめに夫もその数ヶ月後に獄死。
}
プリスキン_011: {
つまり父親の死からたった半年ほどの
間に彼女は家族と、それまで頼りにして
いた現実の全てを失ったという訳だ。
}
ライデン_012: {
……ひどい話だな。
}
プリスキン_013: {
だが彼女は悲嘆にくれる代わりに
軍に入った。
}
ライデン_014: {
どうして？
}
プリスキン_015: {
さあな。復讐かも知れん。彼女は
夫の服役を冤罪だと信じていたらしい。
誰かにはめられた、と。
}
プリスキン_016: {
とにかく訓練を終える頃には既に彼女は
あの恐るべき強運を身につけていた
らしい。
}
プリスキン_017: {
そのために悪魔と取り引きしたとも
言われている。
}
ライデン_018: {
悪魔……？
}
プリスキン_019: {
すぐにその力は知れ渡り、遂には死んだ
夫が率いていたデッドセルのリーダーに
収まったという訳だ。
}
//dv}//v
}//d
//ヴァンプとフォーチュン聞いていない場合 t //e
resource PS_フォーチュン２ {
//vox t:vc211801 {
プリスキン_000: {
信望の厚かった元リーダーの未亡人だ。
暫定的にデッドセルをまとめていた
ヴァンプも喜んで彼女を迎えたらしい。
}
プリスキン_001: {
ま、奴にとっては元恋人の娘でも
あった訳だが。
}
ライデン_002: {
ヴァンプとフォーチュンの母親が？
}
プリスキン_003: {
いや、父親の方だ。
バイセクシャルなんだよ。
}
ライデン_004: {
ぐ！いや待て。
だがヴァンプとフォーチュンは……。
}
プリスキン_005: {
ふん。
つまらんことに鼻がきくんだな。
}
ライデン_006: {
いや……。
}
//dv}//v
}//d
//ヴァンプとフォーチュンへ t //e


//大統領警備隊の事 h //e
resource PS_大統領警護隊１ {
//vox t:vc211811 {
プリスキン_000: {
ゴルルコビッチの部隊と違う装備の
奴等は元大統領警護隊の連中だ。
}
プリスキン_001: {
奴等はシークレットサービスの中でも
精鋭と言われる、大統領警備課のＣＡＴ、
＃｛対襲撃部隊、カウンター・アサルト・チーム｝＃の経験者達だ。
}
プリスキン_002: {
お前よりも実戦経験は豊富だろうな。
}
プリスキン_003: {
奴等の装備は前世紀末から陸軍で
開発されていたランドウォリアー・
システムを基にしている。
}
プリスキン_004: {
お前もフォース２１にいたなら知って
いるだろう。情報処理・通信能力と
生存性を向上させた新世代歩兵装備だ。
}
プリスキン_005: {
歩兵をネットワーク端末の１つとして
位置づけ、その機能を満たすために
設計されている。
}
プリスキン_006: {
ヘルメット・マウント・ディスプレイ
には各センサーや地図、指揮所からの
指示・指令等様々な情報が表示される。
}
プリスキン_007: {
データリンクを通じて自分や味方の
現在位置、再集結地点等をビデオや
画像で知ることも可能だ。
}
プリスキン_008: {
その他、各種照準システム、バイオ
センサー、ＧＰＳ受信機、各種情報処理
機器等を装備している。
}
ライデン_009: {
ああ。だが実用化には装備の重量や
電子機器を動かすバッテリーの
持続時間が問題になっていたはずだ。
}
プリスキン_010: {
そうだったな。だがバッテリーの
問題は銃撃にも耐え、液漏れしない
膜状バッテリーの開発で解決された。
}
プリスキン_011: {
重量の問題も＃｛国防省付属機関先進研究局、ＤＡＲＰＡ｝＃で開発されていた外骨格技術の
＃｛人力増幅機能、ヒューマン・ストレングス・アンプリフィケーション｝＃を使って補っている。
}
プリスキン_012: {
一見鈍重だが動きは素早いぞ。
}
//dv}//v
}//d
resource PS_大統領警護隊２ {
//vox t:vc211821 {
プリスキン_000: {
元大統領警備隊の連中は全身を
セラミックプレート入りの防弾装備で
覆っている。
}
プリスキン_001: {
頭部以外への攻撃は有効ではないだろう。
主観攻撃で頭を狙うんだ。
}
プリスキン_002: {
まあ、敵に見つかりさえしなければ
奴等とはやりあわずにすむはずだ。
それにこしたことはない。
}
//dv}//v
}//d

//サイファーうんちく h //e
resource PS_サイファー１ {
//vox t:vc211831 {
プリスキン_000: {
そこに飛んでいるのはサイファー。
陸上／海上監視・通信支援用の
円盤型＃｛無人偵察機、ＵＡＶ｝＃だ。
}
プリスキン_001: {
奇妙な形をしているが安定性は高い。
３．５ｍほどの隙間しかない場所での
垂直離着陸が可能だ。
}
プリスキン_002: {
完全自律動作でマンサイズ・
ターゲットの捕捉・追跡ができる。
}
//dv}//v
}//d
//二回目以降 t //e
resource PS_サイファー２ {
//vox t:vc211841 {
プリスキン_000: {
チャフを使えばサイファーのセンサーを
撹乱できるだろう。行動を妨害し、
指揮所へのデータ送信も阻止できる。
}
//dv}//v
}//d
resource PS_サイファー３ {
//vox t:vc211851 {
プリスキン_000: {
サイファーは機の状況とミッション
データをデータリンクで指揮所に
送信している。
}
プリスキン_001: {
サイファーに見つかることは
敵に見つかることと同じだ。
視界には入らないように気をつけろ。
}
//dv}//v
}//d


//ＳＥＡＬＳについて h //e
resource PS_ＳＥＡＬＳ {
//vox t:vc211861 {
ライデン_000: {
プリスキン、＃｛ＳＥＡＬ１０、シール・テン｝＃のブラボー・
チームが全滅した……。
}
プリスキン_001: {
そうか。
}
ライデン_002: {
そうかって？
あんたの仲間だろ？
}
プリスキン_003: {
ああ、残念なことだ。
}
ライデン_004: {
……全ては俺を潜入させるための
陽動作戦だったらしい。知ってたか？
}
プリスキン_005: {
いや……。
だがありそうな話ではあるな。
}
ライデン_006: {
……随分冷たいんだな。
自分の仲間が＃－
}
プリスキン_007: {
じゃあ、お前は俺の仲間を殺した
クソ野郎だ、と言えばいいのか？
}
プリスキン_008: {
それともお前のせいじゃないとでも
言ってほしいのか？
}
ライデン_009: {
そんな……。
}
プリスキン_010: {
悪いが俺にはお前の罪悪感だか
自己憐憫だかにつきあってる
暇はないんだ。
}
プリスキン_011: {
そんなものは自分で処理しとけ。
甘えるな。
}
//dv}//v
}//d


//海軍大佐とブラックケースについて h //e
resource PS_海軍大佐１ {
//vox t:vc211871 {
ライデン_000: {
プリスキン、あんた海軍大佐に
注目してたな。何かあるのか？
}
//dv}//v
}//d
//海軍大佐の図のムービー t //e
resource PS_海軍大佐２ {
//vox t:vc211881 {
プリスキン_000: {
ああ。手錠が切断されていただろう。
その先にあったはずの物がな……。
}
ライデン_001: {
何だ？
}
プリスキン_002: {
おそらく……いや、何でもない。
気にするな。
}
//dv}//v
}//d
//気にするなの後 t //e
resource PS_気にするな {
//vox t:vc211891 {
ライデン_000: {
あのな、そういう言い方されて
どうやれば気にしないで
すむって言うんだ？
}
プリスキン_001: {
そうだな。
気にしなければいいんじゃないか？
}
ライデン_002: {
な……！
}
プリスキン_003: {
ふん。じゃあな。
}
//dv}//v
}//d

//スネークの事 h //e
resource PS_プリスキン自身 {
//vox t:vc211901 {
ライデン_000: {
プリスキン……あんたほんとに
＃｛ＳＥＡＬＳ、シールズ｝＃なのか？
}
プリスキン_001: {
そう言っただろう。
}
ライデン_002: {
だが……。
}
プリスキン_003: {
何だ？
}
ライデン_004: {
いや……。
}
プリスキン_005: {
ふん。作戦行動中に余計なことを
考えていると死ぬぞ。
自分の任務に集中しろ。いいな。
}
//dv}//v
}//d


//オルガデモ後 d //e
//オルガ h //e
resource PS_オルガ {
//vox t:vc211911 {
プリスキン_000: {
雷電、
あのオルガという女には気をつけろ。
}
プリスキン_001: {
オルガ・ゴルルコビッチ。元＃｛参謀本部、ＧＲＵ｝＃
情報総局でスペツナズの隊長も務めた
セルゲイ・ゴルルコビッチ大佐の娘……。
}
プリスキン_002: {
彼女が『ビッグ・シェル』の中を
うろついているゴルルコビッチ大佐の
私兵部隊のリーダーだ。
}
プリスキン_003: {
父親の組織した部隊を彼の死後受け継ぎ、
完全に掌握している。
}
プリスキン_004: {
彼女の父親、ゴルルコビッチ大佐は
旧ソ連であらゆる軍人の目標として
尊敬を集めていた人物だったらしい。
}
ライデン_005: {
そんな軍人がなぜ私兵部隊を？
}
プリスキン_006: {
連邦の崩壊によって、たくさんの
軍人が食い扶持を失った。
}
プリスキン_007: {
その中には、いきなり世間に放り出され、
行く当てもなく途方にくれる連中も
多かったらしい。
}
プリスキン_008: {
大佐はそんな奴等の身柄を
引き受けたんだ。
}
プリスキン_009: {
そして傭兵部隊を組織し、世界各地の
紛争地帯を転戦した。ロシアの再興を
夢見ながらな。
}
プリスキン_010: {
シャドーモセス事件で大佐がリキッド・
スネークの蜂起に部隊を合流させようと
していたという話もあるが……。
}
プリスキン_011: {
それも＃｛祖国、ロージナ｝＃の再建を目論んでのこと
だったらしい。
}
プリスキン_012: {
リキッドの腹心だったオセロットとは
旧ソ連時代からの仲らしいな。
}
プリスキン_013: {
オルガはそんな父親の持っていた
軍人としての優れた資質を受け継ぎ、
それを伸ばしてきたようだ。
}
プリスキン_014: {
言わば戦場で生まれ育った女。
見た目通り気も強い。
デートに誘うには覚悟がいるだろうな。
}
ライデン_015: {
何か、会ったことがあるような
口振りだな。
}
プリスキン_016: {
いいや。そんなことはない。
とにかくあの女には気をつけろ。
いいな。
}
//dv}//v
}//d



//忍者接触後 h //e
//忍者 h //e
resource PS_ファットマン戦後＿忍者 {
//vox t:vc211921 {
ライデン_000: {
プリスキン、聞こえるか？
}
プリスキン_001: {
どうした、雷電？
}
ライデン_002: {
実は……忍者の格好をした男に出会った。
}
プリスキン_003: {
忍者？
}
ライデン_004: {
ああ。
心当たりは？
}
プリスキン_005: {
いや……ない。
お前、そのコスプレ野郎を信じるのか？
}
ライデン_006: {
他に手がかりもないんだ。
大佐も奴の言うことに従えと……。
}
プリスキン_007: {
ふん。
聞き分けの良いことだな。
}
プリスキン_008: {
だがこれだけは言っておく。シャドー
モセスで公になった忍者はもう存在
しない。お前が会ったのは奴ではない。
}
ライデン_009: {
なぜそう言い切れる？
}
プリスキン_010: {
ありえないからだ。
}
ライデン_011: {
……。
}
プリスキン_012: {
気をつけろよ。
いいな。
}
//dv}//v
}//d

//エイムズについて h //e
resource PS_ファットマン戦後＿エイムズ {
//vox t:vc211931 {
ライデン_000: {
プリスキン、エイムズという
シークレット・サービスについて
何か知らないか？
}
プリスキン_001: {
エイムズ？
}
ライデン_002: {
知っているのか？
}
プリスキン_003: {
いや……。
}
ライデン_004: {
何か知っているのなら……。
}
プリスキン_005: {
いや、まさかな。人違いだろう。
気にするな。
}
//dv}//v
}//d

//エイムズ後 d //e
//エイムズについて h //e
resource PS_エイムズ後＿エイムズ {
//vox t:vc211941 {
プリスキン_000: {
そういえばエイムズと言う名、どこかで
聞いたと思ったんだが＃｛国防情報局、ＤＩＡ｝＃という
ことはやはりナスターシャの元旦那だ。
}
ライデン_001: {
ナスターシャ？
ナスターシャ・ロマネンコか？
『シャドーモセスの真実』を書いた？
}
プリスキン_002: {
ああ。シャドーモセスの時はいろいろと
サポートしてくれた。
}
プリスキン_003: {
事件のあと、フィランソロピーの
組織にも一役買ってくれている。
}
ライデン_004: {
彼女は今？
}
プリスキン_005: {
さてな。だがヘビースモーカーで
あることには変わりない。
}
//dv}//v
}//d

//ＯＵＴＥＲ　ＨＥＡＶＥＮについて h //e
resource PS_アウターヘブン {
//vox t:vc211951 {
ライデン_000: {
あんた、＃｛ＯＵＴＥＲ、アウター｝＃ ＃｛ＨＥＡＶＥＮ、ヘヴン｝＃と
いうのを聞いたことがあるか？
}
プリスキン_001: {
＃｛ＯＵＴＥＲ、アウター｝＃ ＃｛ＨＥＡＶＥＮ、ヘヴン｝＃！？
}
ライデン_002: {
知っているのか？
}
プリスキン_003: {
いや……。
それがどうかしたのか？
}
ライデン_004: {
テロリストのボスが口にしたんだ。
＃｛ＯＵＴＥＲ、アウター｝＃ ＃｛ＨＥＡＶＥＮ、ヘヴン｝＃再興まで
あと少しだ、と……。
}
プリスキン_005: {
……そうか……。
}
ライデン_006: {
何か知っているか？
}
プリスキン_007: {
いや。だが奴等が何を望むにせよ、
どうせろくでもないものに違いない。
……思うようにさせる訳にはいかん。
}
ライデン_008: {
……ああ……そうだな……。
}
//dv}//v
}//d

//赤外線センサー d //e
//セムテックスうんちく h //e
resource PS_セムテックスうんちく {
//vox t:vc211961 {
プリスキン_000: {
そのトラップに使われてる爆薬は
セムテックス。Ｃ４と同じような
プラスティック爆薬だ。
}
プリスキン_001: {
旧チェコスロバキアで開発され、
冷戦時代には「テロリストのＣ４」とも
呼ばれた。
}
プリスキン_002: {
ＲＤＸとＰＥＴＮでできた、扱いやすく
強力な爆薬だ。あたり一面木っ端微塵に
なるぞ。絶対に爆発させるな。

}
//dv}//v
}//d

//ハリアー戦中 d //e
//ハリアーうんちく h //e
resource PS_ハリアー戦＿ハリアー {
//vox t:vc211971 {
オタコン_000: {
ハリアー２は世界初の実用Ｖ／ＳＴＯＬ
攻撃機ハリアーの発展型だ。
}
オタコン_001: {
機体側面にあるエンジンノズルの
推力線を変えることで垂直短距離
離着陸を可能にしている。
}
オタコン_002: {
ハリアー２はハリアーに比べてエンジン
吹出し口の改良等でペイロードが
かなり拡大してるんだ。
}
オタコン_003: {
そのおかげで武装も大幅に増えている。
}
オタコン_004: {
胴体パイロンに２５ｍｍ機関砲ポッドを
装備。
}
オタコン_005: {
両翼に対地攻撃用ロケット弾、
空対空ミサイル、クラスター爆弾の
各種ポッドを装備している。
}
オタコン_006: {
当然小火器なんかで撃ち落とせる
相手じゃない。スティンガーを使うんだ。
}
//dv}//v
}//d
//ハリアークラスター爆弾 h //e
resource PS_ハリアー戦＿クラスター爆弾１ {
//vox t:vc211981 {
オタコン_000: {
雷電、ハリアーのクラスター爆弾に
気をつけてくれ。
}
オタコン_001: {
クラスター爆弾は非誘導爆弾の一種で
弾体内部に数十から数百の小型爆弾を
内蔵した広域攻撃兵器だ。
}
オタコン_002: {
投下されると時限信管等で起爆。
内壁が爆発・分離して子弾を
広範囲にばらまく。
}
//dv}//v
}//d
//二回目以降 t //e
resource PS_ハリアー戦＿クラスター爆弾２ {
//vox t:vc211991 {
オタコン_000: {
クラスター爆弾の攻撃範囲はすごく広い。
撃たれたらすぐに連絡橋の下の階に
逃げるんだ。いいね。
}
//dv}//v
}//d
//ハリアーアムラーム h //e
resource PS_ハリアー戦＿アムラーム１ {
//vox t:vc212001 {
オタコン_000: {
そのハリアー２は中距離空対空ミサイル、
アムラームを装備している。
}
オタコン_001: {
アムラームはスパローの後継として
設計されたアクティブ・ホーミング・
ミサイルだ。
}
オタコン_002: {
目標近くへ接近し終端誘導段階になると
アクティブ・シーカーで目標をロック
オンして完全自律モードで飛行する。
}
オタコン_003: {
つまり発射後に誘導を必要としないんだ。
いわゆる「撃ちっぱなし」。
}
オタコン_004: {
ミサイル発射後の即時離脱が可能に
なって母機の生還確率が上がるって
いう利点がある。
}
オタコン_005: {
アムラームは機動性もアクティブ・
シーカーの性能も高い。一度撃たれたら
回避するのは難しいだろう。
}
ライデン_006: {
どうすれば？
}
オタコン_007: {
チャフ・グレネードを使えばいい。
}
オタコン_008: {
アムラームはＥＣＭへの耐性も
強化されていて電子妨害をかけても
その発信源に向かって誘導をかけて来る。
}
オタコン_009: {
でもそれは対航空機の話だ。
人間相手にそこまで精密な誘導は
できないはず。
}
//dv}//v
}//d
//二回目以降 t //e
resource PS_ハリアー戦＿アムラーム２ {
//vox t:vc {
オタコン_000: {
チャフ・グレネードを使えば
充分撹乱できるだろう。アムラームを
撃たれたらチャフを使うんだ。
}
//dv}//v
}//d
//没かね？ＸＸＸＸＸＸＸＸ
//ハリアー機銃 h //e
resource PS_ハリアー戦＿機銃１ {
//vox t:vc212021 {
オタコン_000: {
ハリアー２は胴体パイロンに
２５ｍｍ機銃ポッドを装備している。
}
オタコン_001: {
発射速度は毎分３８００発。
砲口初速は秒速１０００ｍ以上。
まともに食らったらダメだ。
}
//dv}//v
}//d
//二回目以降 t //e
resource PS_ハリアー戦＿機銃２ {
//vox t:vc212031 {
オタコン_000: {
ハリアーが機銃を撃ってきたら
すぐに遮蔽物に隠れるんだ。いいね。
}

}//d
//ロケットランチャー h //e
resource PS_ハリアー戦＿ロケット１ {
//vox t:vc212041 {
オタコン_000: {
ハリアー２は両翼に対地攻撃用の
ロケット弾ポッドも装備している。
}
//dv}//v
}//d
resource PS_ハリアー戦＿ロケット２ {
//vox t:vc212051 {
オタコン_000: {
ロケット弾は無誘導だ。撃たれても
すぐにその場から移動すれば回避できる。
でも爆風には気をつけて。
}
//dv}//v
}//d


//カサッカうんちく h //e
resource PS_ハリアー戦＿カサッカ {
//vox t:vc212061 {
オタコン_000: {
僕等が乗っているヘリはＫａ－６０
カサッカ。ロシア・カモフ設計局製の
軍用多目的ヘリコプターだ。
}
オタコン_001: {
歩兵・武器弾薬の輸送、負傷兵の後送、
攻撃ヘリのためのターゲット捕捉、
全天候偵察等、様々な任務に対応可能。
}
オタコン_002: {
先進アビオニクスと電子装備を
追加すれば無線・電子妨害作戦や
特殊任務にも耐えられるんだ。
}
オタコン_003: {
戦闘時の生存性がかなり重視されていて、
主要システムは冗長性を持った造りに
なってる。
}
オタコン_004: {
＃｛回転翼、ローター｝＃は複数の穴が開いても機能するし、
燃料タンクにはポリウレタンが充填して
あって爆発の危険性を少なくしてある。
}
オタコン_005: {
とは言っても、ハリアーに対して
まともに対抗できる訳じゃない。
君の援護をするのが精一杯だと思う。
}
オタコン_006: {
あまり期待はしないでくれ。
ハリアーは君が撃墜するんだ。
頼む。
}
//dv}//v
}//d



//ハリアー戦後 d //e
//メタルギア拡散について h //e
resource PS_メタルギア拡散 {
//vox t:vc212071 {
オタコン_000: {
大統領の言った通りメタルギア＃｛ＲＡＹ、レイ｝＃は
対メタルギア兵器として作られた物だ。
}
オタコン_001: {
シャドーモセス事件で、オセロットは
メタルギア＃｛ＲＥＸ、レックス｝＃と新型核弾頭の演習
データが入ったディスクを持ち帰った。
}
オタコン_002: {
でもそれだけじゃない。
彼はそれを売って回ったんだ。
核保有国だけじゃなく第三国にまでね。
}
オタコン_003: {
データを手に入れた国はそれを元にして
それぞれメタルギアの開発を始めている。
}
オタコン_004: {
どうなると思う？メタルギアの亜種が
世界中に溢れたら？また核抑止の時代が
訪れかねない。
}
オタコン_005: {
僕等がフィランソロピーを組織した
理由もそこにあるんだ。
}
オタコン_006: {
フォーチュンの父親でもある
海兵隊司令官スコット・ドルフも
そのあたりを危惧していたらしい。
}
オタコン_007: {
だからメタルギアに対抗する
兵器としてメタルギア＃｛ＲＡＹ、レイ｝＃の
開発を進めていたんだ。
}
オタコン_008: {
勿論、単独で海からの接敵・攻撃・
離脱を可能にするメタルギア＃｛ＲＡＹ、レイ｝＃は
抜本的な戦術転換すらもたらす兵器だ。
}
オタコン_009: {
緊急即応部隊としての重要性が薄れて
きたと言われる海兵隊に権益を取り戻すっ
ていう目的もあったんだろうけどね。
}
//dv}//v
}//d


//水中機雷うんちく h //e
resource PS_水中機雷＿うんちく {
//vox t:vc212081 {
プリスキン_000: {
その水中機雷は加速度や水圧の変化・
体温等を感知する複合センサーを
内蔵していると思われる。
}
プリスキン_001: {
少し触れただけでも爆発するぞ。
気をつけるんだ。
}
//dv}//v
}//d

//ピーターの死体近く h //e
resource PS_ピーター死体 {
//vox t:vc212091 {
ライデン_000: {
スネーク、スティルマンだ。
スティルマンがここに……。
}
プリスキン_001: {
そうか……。
}
ライデン_002: {
俺を待っていた……。
}
プリスキン_003: {
……ああ。
}
//dv}//v
}//d


//ヴァンプ戦 d //e
//影縫いについて h //e
resource PS_ヴァンプ戦＿影縫い１ {
//vox t:vc212101 {
ライデン_000: {
奴のナイフが影に刺さると
体が動かなくなるんだ！
}
プリスキン_001: {
影縫い？
忍術か？
}
オタコン_002: {
いや、多分一種の催眠術だろうね。
}
ライデン_003: {
催眠術？
}
オタコン_004: {
ああ。ナイフを投げる瞬間の声と動きや
刃に当たる光の反射を利用して
強烈な暗示をかけているんだと思う。
}
ライデン_005: {
どうすればいい！？
}
オタコン_006: {
暗示自体を無効にするのは難しいだろう。
影にナイフを刺されないように
気をつけるしかないね。
}
//dv}//v
}//d
resource PS_ヴァンプ戦＿影縫い２ {
//vox t:vc212111 {
プリスキン_000: {
雷電、自分の影にも気をつけろ。
奴の投げたナイフが影に刺されば
しばらく体が動かなくなる。
}
プリスキン_001: {
体が動かなくなったら、とにかく
左スティックとボタンを連打して
呪縛を断ち切るしかない。
}
//dv}//v
}//d
resource PS_ヴァンプ戦＿影縫い３ {
//vox t:vc212121 {
プリスキン_000: {
ライトを壊せば影自体が出なくなる。
奴に影を縫われる恐れもなくなるだろう。
ライトを壊せ。
}
//dv}//v
}//d

//赤外線ゴーグル使え h //e
resource PS_ヴァンプ戦＿水中赤外線ゴーグル {
//vox t:vc212131 {
プリスキン_000: {
奴が水中に潜ったら＃｛赤外線、サーマル｝＃ゴーグルを
装備するんだ。
}
プリスキン_001: {
そうすれば奴がどこにいるか、わかる。
グレネードを投げ込め。
}
//dv}//v
}//d

//ヴァンプ戦後 d //e
//純粋水爆 h //e
resource PS_ヴァンプ戦後＿純粋水爆 {
//vox t:vc212141 {
ライデン_000: {
ヴァンプが言っていた
純粋水爆というのは？
}
オタコン_001: {
純粋水爆は核融合反応を発生させるのに
核爆発を使わない核兵器だ。
}
オタコン_002: {
純粋水爆の動作原理には２種類あって、
そのうち我が国で研究されているのは
「レーザー慣性圧縮方式」という方式。
}
オタコン_003: {
原理的にはレーザー核融合と同じだ。
}
オタコン_004: {
重水素と三重水素を極低温で固化した
燃料ペレットに高出力のレーザーを
照射する。
}
オタコン_005: {
するとペレットの表面が蒸発、
その反作用でペレットは内向きに
圧縮される。
}
オタコン_006: {
それでペレットの中心部が核融合の
閉じこめ条件を満たす高温・高圧に
到達して、核融合反応が生じるんだ。
}
オタコン_007: {
前世紀末から研究は進んでいたんだけど、
超高出力レーザーの小型化は上手く
いかずにいたはず……。
}
オタコン_008: {
それがもう実用段階にあったとはね……。
}
//dv}//v
}//d


//エマ救出後 d //e
//エマとオタコンの会話１ h //e
resource PS_エマ救出後＿兄妹喧嘩１＿１ {
//vox t:vc212151 {
オタコン_000: {
いいかい、雷電。
エマと話させてくれ？
}
ライデン_001: {
喧嘩はよせよ。
}
オタコン_002: {
ああ、わかってる。
}
//dv}//v
}//d
resource PS_エマ救出後＿兄妹喧嘩１＿２ {
//vox t:vc212161 {
オタコン_000: {
ＥＥかい？
}
エマ_001: {
ええ。何？
}
オタコン_002: {
どうして、兵器開発なんかに
手を貸したんだ？
}
エマ_003: {
……。
}
オタコン_004: {
多くの人が傷つくんだ、
大勢の人が死ぬんだぞ。
}
オタコン_005: {
家や街が破壊される……
何世紀にも渡って汚染される。
核兵器の恐ろしさは知ってるはずだ？
}
オタコン_006: {
僕達の呪われた家系も。
ＥＥ……どうしてなんだ？
}
エマ_007: {
あなたは私を捨てた。
私を地獄に突き落とした……。
}
オタコン_008: {
あれは仕方がなかったんだ。
}
エマ_009: {
違うわ。あのプールでの事故……。
あなたはあれ以来、私を見ると
心が痛んだ。
}
エマ_010: {
だから楽な道を選んだのよ。
私の顔を見ずにすむ道をね。
}
エマ_011: {
そうなれば……もう毎朝、
責任を感じることもない。
}
エマ_012: {
あなたは逃げたのよ。
目の前の苦しみから逃れるために。
}
オタコン_013: {
ＥＥ……そうじゃない。
}
エマ_014: {
あなたは私を捨てた。
自分を楽にするため……。
}
オタコン_015: {
違う。
僕が家を出たのは……。
}
エマ_016: {
お兄ちゃんも犯罪者よ。
そうじゃないの？
}
オタコン_017: {
僕が犯罪者？
}
エマ_018: {
私、知ってる。
あなたはネットの口座を操作して……。
}
オタコン_019: {
それは＃－
}
エマ_020: {
偉そうなこと言っても、
ただのクラッカーじゃない！？
}
オタコン_021: {
違う。目的のためにちょっと能力を
使ってるだけだ。
}
エマ_022: {
はっ！目的って何？
正義！？
}
オタコン_023: {
平和のためさ。僕はスネークとは違う。
銃を持って、戦ったりはできない。
だから、僕ができることをやってる。
}
エマ_024: {
見事な自己正当化だこと。
犯罪者やめて弁護士にでもなったら？
}
プリスキン_025: {
そこまでにしておけ……。
}
//dv}//v
}//d

//エマオタコン兄妹喧嘩２ h //e
resource PS_エマ救出後＿兄妹喧嘩２＿１ {
//vox t:vc212171 {
プリスキン_000: {
どうした、雷電？
}
ライデン_001: {
ああ。
}
エマ_002: {
どいて！
ちょっといいかな？
}
プリスキン_003: {
オタコンか？
}
エマ_004: {
うん……。
}
プリスキン_005: {
今、代わる。
}
//dv}//v
}//d
resource PS_エマ救出後＿兄妹喧嘩２＿２ {
//vox t:vc212181 {
オタコン_000: {
ああ、何だい？
}
エマ_001: {
これまで科学者はずっと戦争に
荷担してきた。あなた、そのことに
ついてはどう思ってるの？
}
オタコン_002: {
確かに、戦争は科学の進歩を促進させる
絶好の機会ではある。しかし、そこに
落とし穴がある。
}
オタコン_003: {
僕等、科学者は職業倫理を
ちゃんと持つことが必要だ。
}
オタコン_004: {
現代科学の悲劇は、スポンサーが政府、
軍にあるということだ。
}
エマ_005: {
何言ってるの！？
原爆も水爆も大学や民間企業が
運営する研究所から生まれたのよ。
}
エマ_006: {
ロスアラモスもローレンス・リバモア
研究所も大学による運営だったでしょ。
}
オタコン_007: {
兵器開発と大学……一見不似合いに
思えるかも知れないが、科学には
自由な情報交換が必要なんだ。
}
エマ_008: {
オッペンハイマー博士の意志ね？
}
オタコン_009: {
でも、僕は……科学と兵器開発を
別次元で考えていた。
}
オタコン_010: {
そうなんだ。僕は僕の研究成果が
不幸を招くなんて考えもしなかった。
あのシャドーモセス事件まではね。
}
エマ_011: {
私は後悔なんてしてない。
}
オタコン_012: {
そこなんだ。核の脅威は僕達科学者が
一番知ってる。僕等が守るしかないんだ。
国家や政治に利用されてはいけない。
}
オタコン_013: {
人間と核は共存できない。原子核反応を
扱える者が存在するとすれば、
「宇宙」だけだよ。
}
エマ_014: {
私を理解してくれたのは科学だけだった。
私を評価してくれたのは政府だけだった。
それのどこが悪いの！！ねぇ！！
}
プリスキン_015: {
そこまでだ。
}
//dv}//v
}//d

//エマオタコン兄妹喧嘩３ h //e
resource PS_エマ救出後＿兄妹喧嘩３＿１ {
//vox t:vc212191 {
ライデン_000: {
スネーク……。
}
エマ_001: {
ちょっと代わって！
}
ライデン_002: {
ああ……。
}
プリスキン_003: {
オタコンなら、俺が代わりに聞く。
あいつは今、手が離せない。
}
エマ_004: {
え？
……ええ……。
}
//dv}//v
}//d
resource PS_エマ救出後＿兄妹喧嘩３＿２ {
//vox t:vc212201 {
プリスキン_000: {
どういう用件だ？
}
エマ_001: {
兄は間違っている。
科学は世の中のためにあるんじゃない。
}
プリスキン_002: {
じゃあ、何のためにあるんだ？
}
エマ_003: {
科学は個人のためにあるのよ。
私にとっては自分の夢を実現させる
ためにあるの。
}
プリスキン_004: {
自分の欲のためにか？
}
エマ_005: {
欲がないと、夢は実現できない。
}
プリスキン_006: {
その夢は何だ？
}
エマ_007: {
兄への復讐、兄を打ち負かすこと。
}
プリスキン_008: {
復讐？
}
エマ_009: {
私を捨てたことを後悔させる。
兄が間違っていることを
思い知らせてやる。
}
プリスキン_010: {
くだらん理由だ……。
}
ライデン_011: {
……それくらいにしておこう。
}
エマ_012: {
くだらないですって？
これが私の目標、私の生き甲斐……。
}
エマ_013: {
兄は間違っている。
兄は国に利用されただけ。惨めな男。
今もあなた達に利用されているだけ。
}
エマ_014: {
私は科学を逆に利用する。
自分の想いを遂げるために。
}
プリスキン_015: {
馬鹿な。それこそが科学者が
踏み入ってはいけない領域だ。
}
エマ_016: {
そう！私は兄への復讐のために悪魔に
身を売ったの。私はあいつを絶対に
許さない！！
}
プリスキン_017: {
聞かなかったことにする。
}
エマ_018: {
いいえ！
あいつにちゃんと言っといてよ！
私は……。
}
プリスキン_019: {
エマ！
}
エマ_020: {
！？
}
プリスキン_021: {
心にもないことは口にしない方がいいぞ。
}
エマ_022: {
……。
}
プリスキン_023: {
それくらいにしておけ。
}
エマ_024: {
うん……。
}
ライデン_025: {
……。
}
//dv}//v
}//d

//狙撃イベント d //e
//雷電から撃たれた２ h //e
resource PS_エマ狙撃＿撃たれた２ {
//vox t:vc212211 {
プリスキン_000: {
雷電、お前どこを狙っている！？
ちゃんとエマを援護しろ！！
}
//dv}//v
}//d
//雷電から撃たれた３ h //e
resource PS_エマ狙撃＿撃たれた３ {
//vox t:vc212221 {
プリスキン_000: {
その距離から俺に当てるとはなかなか
いい腕じゃないか、あぁ！？
雷電！今度は敵を狙うんだ。いいな！！
}
//dv}//v
}//d
//雷電から撃たれた４ h //e
resource PS_エマ狙撃＿撃たれた４ {
//vox t:vc212231 {
プリスキン_000: {
雷電！
ふざけるのもいい加減にしろ！！
}
//dv}//v
}//d


//狙撃後 d //e
//エマの状態について h //e
resource PS_狙撃後＿エマ傷１ {
//vox t:vc212241 {
ライデン_000: {
エマの具合は……？
}
プリスキン_001: {
……良くない。ここでは詳しい診察は
できんが、筋膜の損傷が皮膚創と
同じくらい大きい。
}
ライデン_002: {
つまり？
}
//dv}//v
}//d
resource PS_狙撃後＿エマ傷２ {
//vox t:vc212251 {
プリスキン_000: {
腸管や腸間膜まで損傷している可能性が
あるということだ。加えて出血も多い。
既に血圧が低下し始めている。
}
プリスキン_001: {
本来なら開腹して処置しなければ
ならないところだが……ここではな……。
}
プリスキン_002: {
応急処置は施したが、それが精一杯だ。
もうあまり時間はないだろう。
急いでくれ。
}
//dv}//v
}//d

//ＧＷのセキュリティー h //e
resource PS_ＧＷの防壁 {
//vox t:vc212261 {
オタコン_000: {
ちょっとだけ調べてみたんだけど……。
}
オタコン_001: {
アーセナルギアのセキュリティ・
システムは生物の免疫応答を模した
異物排除機構を採用しているようだ。
}
オタコン_002: {
システム内部には多数の異物感知
エージェントが定期巡回していて、
全体が常に監視されている。
}
オタコン_003: {
異物感知エージェントは異物を
発見するとその情報を抗体生産
システムに伝達する。
}
オタコン_004: {
そこで抗体エージェントと呼ばれる
プログラムが自律的に生産され、その
異物を除去・もしくは無力化するんだ。
}
オタコン_005: {
その上『Ｇ．Ｗ』の物理的・論理的本体
である光ニューラルネットとそれ以外の
一般ネットの間には強固な障壁がある。
}
オタコン_006: {
ビット・ブレイン・バリアーと
呼ばれるフィルタリング・システムが
異物の流入を徹底的に防ぐんだ。
}
オタコン_007: {
このシステムのせいで外部からの攻撃は
極めて難しくなっている。準備もなし
ではちょっと手が出せないね……。
}
//dv}//v
}//d
//フォックスダイについて h //e
resource PS_フォックスダイ {
//vox t:vc212271 {
オタコン_000: {
雷電。ＥＥに君の持ってる
ディスクのことを聞いてみた。
}
オタコン_001: {
基本的にはコンピュータ・ワーム・
プログラムの集合体だ。
}
オタコン_002: {
それぞれのワームは『Ｇ．Ｗ』を
構成するデータ単位を模倣した
構造をしているらしい。
}
オタコン_003: {
『Ｇ．Ｗ』の異物感知エージェントも
それを非自己と認識できず、免疫反応が
起こるのを防ぐことができるんだそうだ。
}
オタコン_004: {
だから『Ｇ．Ｗ』本体を囲む
ビット・ブレイン・バリアーも
通り抜けることができる。
}
オタコン_005: {
ワームはニューラルネット内に
入り込むと周りのニューロンを
変成させるらしい。
}
オタコン_006: {
変成したニューロンは硬化して
ニューラルネットとして機能しなくなる。
}
オタコン_007: {
時間とともにニューロンは変成し
死滅していって、やがて全体が
意味消失を起こす。
}
オタコン_008: {
それで言語障害、記憶の欠落等の症状を
引き起こしたあと自己を保てなくなって
機能を停止するって仕組みらしい。
}
//dv}//v
}//d

//拷問後合流後 d //e
//ステルス迷彩スネーク h //e
resource PS_ＮＰＣスネーク＿ステルス迷彩スネーク {
//vox t:vc212281 {
プリスキン_000: {
雷電、どうした？
}
ライデン_001: {
スネーク、あんたどこにいるんだ？
}
プリスキン_002: {
ああ、お前の目には見えないかもな。
俺は今ステルス迷彩を使っている。
}
ライデン_003: {
ステルス迷彩？
}
プリスキン_004: {
オタコンが持って来てくれた。
}
ライデン_005: {
そんな物を持ってたのか？
なぜ言ってくれない？
}
プリスキン_006: {
それは＃－
}
ライデン_007: {
聞かれなかったからか？
}
プリスキン_008: {
よくわかってるじゃないか。
お前の目には見えないかも知れんが
ちゃんと援護している。心配するな。
}
//dv}//v
}//d


//武器うんちく d //e
//ＰＳＧ１ h //e
resource PS_ＰＳＧ１ {
//vox t:vc212291 {
プリスキン_000: {
ＰＳＧ１は対テロリスト専用の
＃｛自動狙撃銃、オート・スナイパー・ライフル｝＃だ。
}
プリスキン_001: {
ガス作動式ではなくローラーロッキング
式の閉鎖機構を採用して、完全なフリー
フローティング・バレルを実現している。
}
プリスキン_002: {
これによって自動ライフルにも関わらず
ボルトアクションの狙撃銃に匹敵する
精度を実現しているという訳だ。
}
プリスキン_003: {
約２７０ｍの射距離、５発で５０ｍｍ
というグルーピングを出すことができる。
世界最高の狙撃銃の１つといえるだろう。
}
プリスキン_004: {
ＰＳＧ１はＶＲ訓練でも使っただろうが、
その時とは扱いが違う点がいくつか
あるから憶えておけ。
}
プリスキン_005: {
まず、そのＰＳＧ１には倍率を
変更できる特製のスコープが
装備されている。
}
プリスキン_006: {
精密に狙う必要がある場合はズームイン、
広い視界を確保する必要がある場合は
ズームアウトするといいだろう。
}
プリスキン_007: {
さらに＃｛伏せ姿勢、プローン・ポジション｝＃以外にも立ちや
しゃがみの状態からも構えられる
ようになった。
}
プリスキン_008: {
ただし安定性をかく姿勢では
手ぶれが大きくなる。
}
プリスキン_009: {
精密狙撃を行う場合はホフクして
＃｛伏せ姿勢、プローン・ポジション｝＃をとった方がいいだろう。
}
//dv}//v
}//d
//ＰＳＧ１Ｔ h //e
resource PS_ＰＳＧ１Ｔ {
//vox t:vc212301 {
プリスキン_000: {
お前の持っているＰＳＧ１－Ｔは
ＰＳＧ１の銃身を交換して麻酔弾
発射用に改造した物だ。
}
プリスキン_001: {
扱いは通常のＰＳＧ１と変わらない。
違うのは敵の命を奪わずにすませられる
ということだけだ。
}
プリスキン_002: {
使う使わないはお前次第だな。
}
//dv}//v
}//d

//Ｍ４ h //e
resource PS_Ｍ４ {
//vox t:vc212311 {
プリスキン_000: {
Ｍ４を手に入れたようだな。
＃｛米特殊作戦コマンド、ＵＳ．ＳＯＣＯＭ｝＃で正式採用されて
いるアサルトカービン銃だ。
}
プリスキン_001: {
第二次大戦中に使用された
Ｍ１カービンの流れをくんでいる。
}
プリスキン_002: {
Ｍ４とは米軍に４番目に正式採用された
カービンという意味がある。
}
プリスキン_003: {
基本的にはＭ１６Ａ２をベースに
特殊部隊向けの改良を加え
発展させた物だ。
}
プリスキン_004: {
装弾数は３０発。
５．５６ｍｍ×４５のＳＳ１０９弾を
使用する。
}
プリスキン_005: {
ちなみにカービンは騎兵銃つまり短銃身
のライフルのことだ。憶えて……憶えて
おいてもあまり役には立たないかもな。
}
//dv}//v
}//d

//スプレー h //e
resource PS_冷却スプレー１ {
//vox t:vc212321 {
プリスキン_000: {
冷却スプレーを持っているな。
それを使えばファットマンの仕掛けた
Ｃ４を冷却処理できるはずだ。
}
プリスキン_001: {
装備すると自動的に主観で構え、
＃｛□、武器｝＃ボタンを押している間、
スプレーを噴霧する。
}
プリスキン_002: {
噴霧された冷却剤は空気に触れると
ゲル状に変質して爆弾に吸着、
低温を保ち続けるようになっている。
}
プリスキン_003: {
充分に噴きつけてＣ４を冷却剤で
覆ってしまえば融けてしまうことは
ないということだ。
}
プリスキン_004: {
つまり一度冷却に成功すれば、
もうそのＣ４が爆発することは
ないと考えていい。
}
プリスキン_005: {
中身は充分入っているようだから
なくなる心配はないだろう。
そこは気にするな。
}
プリスキン_006: {
ただしスプレーを装備している間は
移動ができなくなる。
}
プリスキン_007: {
冷却中に敵が接近して来たらすぐに
装備から外して隠れた方がいいだろうな。
}
プリスキン_008: {
Ｃ４の冷却処理以外にも上手く使えば
敵をひるませたりすることもできる
はずだ。憶えておけ。
}
//dv}//v
}//d


//クレイモア h //e
resource PS_クレイモア１ {
//vox t:vc212331 {
プリスキン_000: {
クレイモア地雷を持っているな。
クレイモアは地上に敷設して使う
指向性地雷だ。
}
プリスキン_001: {
主な用途は待ち伏せや陣地防御だが、
軽車両等のソフトスキン・ターゲットに
対しても用いられる。
}
//dv}//v
}//d
resource PS_クレイモア２ {
//vox t:vc212341 {
プリスキン_000: {
そのクレイモア地雷は、ステルス
迷彩機能を搭載しているタイプだ。
敷設するとすぐに姿を消す。
}
プリスキン_001: {
敷設後は地雷探知器か＃｛赤外線、サーマル｝＃ゴーグルを
使わなければ位置を特定することは
できないだろう。
}
プリスキン_002: {
敷設されるとステルス迷彩と同時に
対人センサーが起動する。
}
//dv}//v
}//d
resource PS_クレイモア３ {
//vox t:vc212351 {
プリスキン_000: {
前方から人間の接近を感知すると、起爆。多数の破片と鉄球を飛散させて扇形の
有効加害ゾーンを形成する。
}
プリスキン_001: {
ただしそのセンサーに＃｛敵味方識別機能、ＩＦＦ｝＃は
付いていない。
}
プリスキン_002: {
自分で仕掛けたクレイモアに
引っかかるような真似はするな。
}
プリスキン_003: {
敷設されたクレイモア地雷は
ホフクで近づけば回収できる。
}
プリスキン_004: {
自分が仕掛けた物だけでなく、
敵が敷設した物も入手できるはずだ。
憶えておけ。
}
//dv}//v
}//d

//Ｃ４ h //e
resource PS_Ｃ４ {
//vox t:vc212361 {
プリスキン_000: {
Ｃ４を装備しているな。
優秀な軍用プラスティック爆薬だ。
}
プリスキン_001: {
組成は９１％のＲＤＸと９％の
不活性可塑性材。
白色の粘土状をしている。
}
プリスキン_002: {
ＴＮＴ爆薬の１．３倍以上の性能を持つ
爆薬だが化学的には非常に安定している。
}
プリスキン_003: {
点火装置によって起爆されない限り
熱や衝撃を加えても爆発することはない。
}
プリスキン_004: {
お前の無線式発火装置にはスクランブラ
と暗号化機能も備えられている。妨害
電波等で誤爆する恐れもないだろう。
}
プリスキン_005: {
＃｛□、武器｝＃ボタンでセットしてから＃｛○、パンチ｝＃ボタンで
爆破だが、自分で爆発に巻き込まれる
ようなヘマはするなよ。
}
//dv}//v
}//d

//マイク h //e
resource PS_指向性マイク {
//vox t:vc212371 {
プリスキン_000: {
指向性マイクを使っているな。
通常なら聞こえないような
微かな音も拾うことができるだろう。
}
プリスキン_001: {
前面から入射する音のみを拾うよう
指向性を鋭くした超指向性マイクだ。
}
プリスキン_002: {
音を拾えるのはマイクを向けた
方向だけだということを憶えておけ。
}
プリスキン_003: {
小型アンプも内蔵しているから、
音源にきちんと向ければ相手の
心音まで聞き取れるはずだ。
}
//dv}//v
}//d

//ＲＧＢ６ h //e
resource PS_ＲＧＢ６ {
//vox t:vc212381 {
プリスキン_000: {
ＲＧＢ６を装備しているな。
クロアチア製の４０ｍｍ６連発
グレネードランチャーだ。
}
プリスキン_001: {
ＶＲ訓練には、なかった武器だろう。
}
プリスキン_002: {
ＲＧＢ６にはドライビング・スプリングの
力で回転するリボルバー式シリンダーに
６発のグレネードを装填できる。
}
プリスキン_003: {
投擲用手榴弾よりも狙いがつけやすい
はずだ。防弾装備を着た相手や遮蔽物に
隠れた相手には有効だろう。
}
プリスキン_004: {
弾道が放物線を描くことを憶えておけ。
発射角度に注意して狙った場所に
着弾させられるようにするんだ。
}
//dv}//v
}//d
//聞いていなければエアバースト説明へ t //e


//スティンガー h //e
resource PS_スティンガー {
//vox t:vc212391 {
プリスキン_000: {
スティンガーは携帯用＃｛地対空ミサイル、ＳＡＭ｝＃だ。
}
プリスキン_001: {
ロックオンして発射すれば
赤外線シーカーヘッドで
その目標を自動的に追尾する。
}
プリスキン_002: {
しかし、そのスティンガーは旧式の
＃｛対対抗策、カウンター・カウンター・メジャー｝＃が不充分なタイプだ。
}
プリスキン_003: {
フレアを撃たれるとミサイルの
シーカーが欺瞞されてしまうかも知れん。
憶えておけ。
}
//dv}//v
}//d

//リモコンミサイル h //e
resource PS_リモコンミサイル {
//vox t:vc212401 {
プリスキン_000: {
リモコンミサイルを手に入れたな。
通称ニキータミサイル。無線誘導の
シーカー付き飛翔体だ。
}
プリスキン_001: {
マイクロ飛行体技術を応用した偵察用
ミサイルで、弾頭に搭載されたＣＣＤ
カメラからの映像を見ながら操作できる。
}
プリスキン_002: {
偵察用と言っても弾頭には少量の炸薬が
装填されている。遠距離からの攻撃にも
使えるだろう。
}
プリスキン_003: {
発射後にリモコンミサイルを装備から
外せばその場で爆発させることもできる。
}
プリスキン_004: {
ミサイルの操作中は移動ができなくなることを憶えておけ。ミサイルの燃料切れ
にも注意するんだ。
}
プリスキン_005: {
ＶＲ訓練とは違い操作は主観のみだ。
＃｛俯瞰、フカン｝＃での操作はできないから戸惑うなよ。
ＶＲと実戦は違うものだ。
}
//dv}//v
}//d

//手投げグレネード h //e
resource PS_手投げグレネード {
//vox t:vc212411 {
プリスキン_000: {
グレネードを持ってるな。
投擲用の対人破片手榴弾だ。
}
プリスキン_001: {
爆発すると同時に弾体が破片になって
飛び散り、爆風と破片で敵を倒す。
}
プリスキン_002: {
炸薬にはコンポジットＢを使用している。
ＴＮＴ４０％とＲＤＸ６０％で、できた
混合爆薬だ。
}
プリスキン_003: {
＃｛□、武器｝＃ボタンを押すと構え、＃｛□、武器｝＃ボタンを
離すと投げる。＃｛□、武器｝＃ボタンを押した時の
強さで投擲距離が変わるぞ。
}
プリスキン_004: {
爆発するまで約５秒だ。この５秒と
投擲距離を使いこなすことが重要だ。
いいな。
}
//dv}//v
}//d

//スタン h //e
resource PS_スタングレネード {
//vox t:vc212421 {
プリスキン_000: {
スタン・グレネードを持っているな。
スタン・グレネードは閃光と轟音で
人間の見当識を失わせる非殺傷兵器だ。
}
プリスキン_001: {
炸裂すると瞬間的に２５０万カンデラ
以上の閃光と１６０デシベル以上の
轟音を発生させる。
}
プリスキン_002: {
わかりやすく言えば警察用フラッシュ
ライトの１２０倍以上の光と、ジェット
機の離陸ほどの爆音ということになるな。
}
プリスキン_003: {
同時に２７００℃ほどの高温も発するが
ミリセカンド単位の話だ。
発火の可能性はないと思っていい。
}
プリスキン_004: {
同じく爆発音の発生時間もミリセカンド単位の間だから、恒久的な聴覚障害に
なる恐れはない。
}
プリスキン_005: {
使用すれば敵は意識を失うが、
それだけだ。殺傷能力はないと
いうことを憶えておけよ。
}
//dv}//v
}//d
//チャフ h //e
resource PS_チャフグレネード {
//vox t:vc212431 {
プリスキン_000: {
チャフ・グレネードを握っているな。
敵の電子機器の妨害及び無線封鎖が
可能な携帯用電子戦兵器だ。
}
プリスキン_001: {
点火装置が発火すると微量の爆薬で
多数のチャフ片と＃｛小型妨害電波発信機、ミニ・アクティブ・ジャマー｝＃を
散布する。
}
プリスキン_002: {
電子機器はしばらくの間、
使い物にならなくなるはずだ。
}
プリスキン_003: {
だが憶えておかなければいけないのは、
レーダー等、お前の装備も影響を
受けてしまうことだ。
}
プリスキン_004: {
自分も電子機器を使っている時は
気をつけろ。
}
//dv}//v
}//d

//マガジン h //e
resource PS_マガジン {
//vox t:vc212441 {
プリスキン_000: {
お前が手に持っているマガジンは
ハンドガンや自動小銃の空弾倉だ。
＃｛□、武器｝＃ボタンを押すと構え、離すと投げる。
}
プリスキン_001: {
投げつけたところで敵を倒せる訳じゃ
ないが、気を引くぐらいはできるだろう。
}
プリスキン_002: {
＃｛□、武器｝＃ボタンを押した時の強さで
投げる距離が変わる。
}
プリスキン_003: {
主観で構えて、狙った所に落とせる
ようにしておけば役に立つかも知れんな。
}
//dv}//v
}//d
//麻酔銃 h //e
resource PS_麻酔銃１ {
//vox t:vc212451 {
プリスキン_000: {
お前が持っているのはサプレッサー
付きの麻酔銃だ。命中させれば
敵を眠らせることができるだろう。
}
プリスキン_001: {
麻酔弾は当たった場所によって
効果が現われるまでの時間が
変わって来るということを憶えておけ。
}
プリスキン_002: {
一発で眠らせたいなら頭や心臓、
急所に当てろ。主観攻撃でよく狙うんだ。
}
//dv}//v
}//d
//タンカー編をやっている場合 t //e
resource PS_麻酔銃２ {
//vox t:vc212461 {
ライデン_000: {
この改造銃、どこかで見た気が
するんだが……。
}
プリスキン_001: {
ああ。２年前にソリッド・スネークが
使っていたのと同じ物らしいな。
}
プリスキン_002: {
例のテロ以来、奴のファンが作ったとか
いう改造銃が結構出回ったらしい。
それもその１つだろう。
}
//dv}//v
}//d
resource PS_麻酔銃３ {
//vox t:vc212471 {
プリスキン_000: {
その麻酔銃本体は米軍の制式拳銃Ｍ９を
麻酔弾用に改造した物だ。
}
プリスキン_001: {
麻酔弾は着弾すると、その衝撃を使って
弾体後部で薬品を混合し、ガスを
発生させる。
}
プリスキン_002: {
そのガスの圧力でピストンを押し、
相手に麻酔薬を注入する訳だな。
}
プリスキン_003: {
要するに小さな注射器を
発射するような物と考えればいい。
}
プリスキン_004: {
Ｍ９は麻酔銃だ。敵を眠らせるだけで
倒せる訳じゃない、ということを
憶えておけよ。
}
//dv}//v
}//d
//ソーコム h //e
resource PS_ソーコム１ {
//vox t:vc212481 {
プリスキン_000: {
ソーコム・ピストルを装備しているな。
＃｛米特殊作戦コマンド、ＵＳ．ＳＯＣＯＭ｝＃用攻撃拳銃として
作られた４５口径自動拳銃だ。
}
プリスキン_001: {
ストッピングパワーに優れた
４５ＡＣＰ弾を使用する。
装弾数は１２発だ。
}
プリスキン_002: {
作動不良間発砲可能弾数は平均６０００
発以上、＃｛射弾５発の平均集弾半径、ファイブラウンド・ショットグループ｝＃は
１．４インチ。
}
プリスキン_003: {
少々でかいが信頼できる銃だ。
＃｛レーザー、Ｌ｝＃・＃｛エイミング、Ａ｝＃・＃｛モジュール、Ｍ｝＃も
装備している。
}
//dv}//v
}//d
//サプレッサーない場合 t //e
resource PS_ソーコム２ {
//vox t:vc212491 {
プリスキン_000: {
サプレッサーも装着可能だ。
サプレッサーを付ければ銃声を
消すことができる。探してみるといい。
}
//dv}//v
}//d

//サプレッサー装備している場合 t //e
resource PS_ソーコム＿サプレッサー２ {
//vox t:vc212501 {
プリスキン_000: {
サプレッサーも装備しているようだな。
}
//dv}//v
}//d
resource PS_ソーコム＿サプレッサー２＿１ {
//vox t:vc212511 {
プリスキン_000: {
ソーコムにサプレッサーを
装備しているな。
}
//dv}//v
}//d
resource PS_ソーコム＿サプレッサー３ {
//vox t:vc212521 {
プリスキン_000: {
サプレッサーは多層＃｛隔壁、チェンバー｝＃で発射ガスの
速度を減速して発射音と発射炎を
減少させる物だ。
}
プリスキン_001: {
内部のバッフルを湿らせた状態で
約３８デシベルの減音効果がある。
}
プリスキン_002: {
そのサプレッサーは回転させて
１０ヶ所のポジションに固定可能だ。
}
プリスキン_003: {
それで着弾点を調整するという
機能なんだが……これは別に憶えて
おかなくてもいい。
}
プリスキン_004: {
もう調整はすんでいるようだからな。
サプレッサー装着前と同じ感覚で
扱えるだろう。
}
プリスキン_005: {
銃声で敵に発見されることはなくなる
だろうが、倒れた仲間を見つければ
敵も警戒を強化するに違いない。
}
プリスキン_006: {
弾薬には限りもある。
無闇な戦闘はさけろよ。
}
//dv}//v
}//d


//装備品 d //e
//エロ本 h //e
resource PS_エロ本 {
//vox t:vc212531 {
プリスキン_000: {
雷電、良い物を持ってるじゃないか。
}
ライデン_001: {
いやこれは＃－
}
プリスキン_002: {
なに、否定することはない。
戦場でもそれくらいの心意気は
あった方がいいだろう。
}
ライデン_003: {
……。
}
プリスキン_004: {
使い方は……まあ決まってるだろうが、
それ以外にもやり方次第では敵の注意を
そらしたりできるかも知れんな……。
}
//dv}//v
}//d


//たばこ h //e
resource PS_たばこ {
//vox t:vc212541 {
プリスキン_000: {
俺が渡した煙草、ちゃんと持ってる
ようだな。
}
ライデン_001: {
実はずっと禁煙していたんだが……。
}
プリスキン_002: {
なるほど。
では禁煙をやめるいいきっかけに
なったんじゃないか？
}
ライデン_003: {
……。
}
プリスキン_004: {
冗談だ。喫煙が体に良くないことは
事実だからな。吸いたくなければ
吸わない方がいいだろう。
}
プリスキン_005: {
だが戦場では煙草も喫煙以外にいろいろ
使い道があるはずだ。持っているだけ
なら損はしない。
}
プリスキン_006: {
装備品は最大限に利用しろ。
ちょっとした工夫で道は開けるものだ。
}
//dv}//v
}//d

//敵兵服 h //e
resource PS_敵兵服 {
//vox t:vc212551 {
プリスキン_000: {
敵の＃｛野戦服、Ｂ．Ｄ．Ｕ｝＃を着てるな。
なかなか似合ってるじゃないか。
}
ライデン_001: {
からかわないでくれ。
これでも結構びびってるんだ。
いつ見破られるかって……。
}
プリスキン_002: {
大丈夫だ。過敏になるな。
お前なら歩き方でばれる
心配もなかろうしな。
}
ライデン_003: {
歩き方？
何のことだ？
}
プリスキン_004: {
ふふん。何でもない。
気にするな。
}
プリスキン_005: {
だが、お前が着てるのは
かなりサイズが小さいようだな。
}
プリスキン_006: {
敵と接触したりすると拍子で
装備から外れてしまうかも知れん。
注意した方がいいだろう。
}
プリスキン_007: {
本来は体にフィットする物が支給される
もんだが、今回はそうもいくまい。
服に動きをあわせてもらうしかないな。
}
//dv}//v
}//d

//ダンボール h //e
resource PS_ダンボール１ {
//vox t:vc212561 {
プリスキン_000: {
ダンボール箱を装備してるな。
ダンボール箱は敵の目をあざむく最高の
偽装と言える。＃｛潜入任務、スニーキング・ミッション｝＃の必需品だ。
}
ライデン_001: {
そうなのか？
}
プリスキン_002: {
勿論だ！
ダンボール箱に命を救われたという
工作員は古来より数知れない。
}
ライデン_003: {
みんな……これを使ってきたのか？
}
プリスキン_004: {
当たり前だ！ダンボール箱をいかに
使いこなすかが任務の成否を決定する
と言っても過言ではないだろう。
}
ライデン_005: {
……。
}
プリスキン_006: {
ただし、いかにダンボール箱といえど
素材は紙だ。手荒い扱いをすると
すぐ駄目になるぞ。
}
//dv}//v
}//d
//ダンボールスネークを銃撃してダンボールを剥がしている場合 t //e
resource PS_ダンボール２ {
//vox t:vc212571 {
プリスキン_000: {
俺もお前のせいで
いくつか失ってしまった……。
}
ライデン_001: {
何だって？
}
プリスキン_002: {
いや。気にするな。
}
//dv}//v
}//d
resource PS_ダンボール３ {
//vox t:vc212581 {
プリスキン_000: {
とにかくダンボール箱は大事に使え。
丁寧に扱えばダンボール箱も
きっとお前に応えてくれる。
}
プリスキン_001: {
真心をこめて使うんだ。
必要なのはダンボール箱に対する愛情。
粗略な扱いは許さんぞ。いいな。
}
ライデン_002: {
……ああ。
}
//dv}//v
}//d

//生体センサー h //e
resource PS_生体センサー {
//vox t:vc212591 {
プリスキン_000: {
生体センサーを使っているな。
それを装備すれば、敵の接近を振動で
感じ取ることができる。
}
プリスキン_001: {
生体電磁波や心臓の鼓動を感知する
センサーだ。敵が接近すればするほど
振動も大きくなる。
}
プリスキン_002: {
便利な装備品だが、生体センサーを
装備している間は他の振動は感じなく
なるということは憶えておけ。
}
プリスキン_003: {
何かを得れば何かを失う。人生とは
そんなものだ。状況に応じて使うか
使わないかを決めるといい。
}
//dv}//v
}//d

//地雷探知器 h //e
resource PS_地雷探知器１ {
//vox t:vc212601 {
プリスキン_000: {
地雷探知器を装備してるな。
肉眼では見えないクレイモア地雷の
位置をレーダー上に表示する探知器だ。
}
プリスキン_001: {
そいつは通常の地雷探知器ではない。
＃｛自律微少スケール化学実験室、ミュー・ケム・ラブ｝＃で開発
された技術を採用した最新型だ。
}
プリスキン_002: {
金属探知ではなく主に化学探知器を
利用したシステムになっている。
}
プリスキン_003: {
地雷の金属ケースではなく、
爆発物が放出する爆発性分子を
検出するということだ。
}
プリスキン_004: {
親父さんから渡されたＣ４の『匂い』を
探知するセンサーと基本原理は同じだな。
}
プリスキン_005: {
だから俺達がいるような金属構造物の
中でも正確に地雷の位置を検出できる、
という訳だ。
}
//dv}//v
}//d
//レーダー使用不能状態 t //e
resource PS_地雷探知器２ {
//vox t:vc212611 {
プリスキン_000: {
しかしレーダーを使用可能にしなければ
使っても意味がないぞ。憶えておけ。
}
//dv}//v
}//d

//センサーＡ h //e
resource PS_センサーＡ１ {
//vox t:vc212621 {
プリスキン_000: {
親父さんから渡されたセンサーＡを
使ってるな。
}
プリスキン_001: {
Ｃ４に限らず爆発物は特有の
爆発性分子を大気中に放出し
続けている。
}
プリスキン_002: {
そのセンサーＡは＃｛イオン易動性分光測定、ＩＳＭ｝＃
という技術を使ってその分子クラスター
を検知する探知器だ。
}
プリスキン_003: {
早い話がＣ４が発する『匂い』を
嗅ぎつけるということだな。
}
プリスキン_004: {
検知された『匂い』は雲のような形で
レーダー上に表示される。
Ｃ４は必ずその近くにあるはずだ。
}
//dv}//v
}//d
resource PS_センサーＡ２ {
//vox t:vc212631 {
プリスキン_000: {
このセンサーは特殊なチューニングが
施されているようだ。
}
プリスキン_001: {
ファットマンがサインとして振りかける
香水とＣ４の『匂い』を混合した化学
シグネチャに特化した調整だな。
}
プリスキン_002: {
だから俺達がＣ４を仕掛けても
反応はしないだろう。
}
//dv}//v
}//d
//爆弾解体後 t //e
resource PS_センサーＡ３ {
//vox t:vc212641 {
プリスキン_000: {
充分役に立ってくれたが、
もう使うことはないかも知れんな。
}
//dv}//v
}//d

//センサーＢ h //e
resource PS_センサーＢ１ {
//vox t:vc212651 {
プリスキン_000: {
センサーＢを装備しているな。
ファットマンが仕掛けた『匂い』の
しないＣ４を探知できるセンサーだ。
}
プリスキン_001: {
爆発性分子を化学探知するセンサーＡ
とは違い、中性子を放射して閉鎖された物体の中の爆発物を検知する。
}
プリスキン_002: {
『匂い』、つまり爆発性分子が
拡散しないよう厳重にシールされた
Ｃ４も発見することができるだろう。
}
プリスキン_003: {
中性子は物体を通過する際、その中に
含有される水素含有物質との相互作用に
よって後方散乱を起こす。
}
プリスキン_004: {
この後方散乱を放射線検出器で測定し、
値を分析して爆発物の存在を特定する
という仕組みだ。
}
プリスキン_005: {
装備するだけで自動的に周囲の走査を
行ってくれる。同じエリアに爆発物を
発見すれば警告音が鳴る。
}
プリスキン_006: {
警告音の間隔が短くなればそれだけ
爆弾に近づいているということだ。
憶えておけ。
}
//dv}//v
}//d
resource PS_センサーＢ２ {
//vox t:vc212661 {
プリスキン_000: {
このセンサーはファットマンの
使うＣ４にしか反応しないように
調整してあるらしい。
}
プリスキン_001: {
ファットマンが使うＣ４と俺達が使う
Ｃ４の組成は微妙に異なるようだ。多分
ワックスの材質か何かが違うんだろう。
}
プリスキン_002: {
親父さんが調整に時間をかけていたのは
このあたりだったのかも知れんな。
}
//dv}//v
}//d
resource PS_センサーＢ３ {
//vox t:vc212671 {
プリスキン_000: {
だがＣ４は全て処理し終わっているし、
ファットマンも、もういない。
このセンサーを使う必要はないだろう。
}
//dv}//v
}//d

//双眼鏡 h //e
resource PS_双眼鏡１ {
//vox t:vc212681 {
プリスキン_000: {
双眼鏡を使ってるな。
オートフォーカス、ズーム機能装備。
軍用のハイエンドモデルだ。
}
//dv}//v
}//d
//拷問以前のみ t //e
resource PS_双眼鏡２ {
//vox t:vc212691 {
プリスキン_000: {
特に『ビッグ・シェル』外部では
役に立つだろう。
}
//dv}//v
}//d
resource PS_双眼鏡３ {
//vox t:vc212701 {
プリスキン_000: {
遠方から敵を早期発見できれば
先手を打つことができる。＃｛潜入任務、スニーキング・ミッション｝＃に
敵地偵察は不可欠だ。よく憶えておけ。
}
//dv}//v
}//d

//カメラ h //e
resource PS_カメラ {
//vox t:vc212711 {
プリスキン_000: {
カメラを使う気か？
言うまでもなく、そいつを使えば
写真を撮ることができる。
}
プリスキン_001: {
ズーム機能も付いているし、
オートフォーカスだからピントを
気にする必要もないだろう。
}
プリスキン_002: {
使いべりもしないはずだ。
いろいろ試してみろ。
}
//dv}//v
}//d

//暗視ゴーグル h //e
resource PS_暗視ゴーグル {
//vox t:vc212721 {
プリスキン_000: {
暗視ゴーグルを使っているな。
暗視ゴーグルを装備すれば暗い場所でも
視界を確保することができるだろう。
}
プリスキン_001: {
暗視ゴーグルは＃｛映像増幅装置、イメージ・インテンシファイア｝＃で
かすかな光を電子的に増幅して
映像化する暗視装置だ。
}
プリスキン_002: {
暗視装置が登場したのは１９４０年代。
それ以来、改良が進み感度も解像度も
上がっている。
}
プリスキン_003: {
お前が使っているのは
暗視ゴーグルとしては
第四世代にあたる物だ。
}
//dv}//v
}//d
//赤外線ゴーグル h //e
resource PS_赤外線ゴーグル１ {
//vox t:vc212731 {
プリスキン_000: {
＃｛赤外線、サーマル｝＃ゴーグルを使ってるな。
熱源の分布を映像化して暗所での
視界を確保する暗視装置だ。
}
プリスキン_001: {
その＃｛赤外線、サーマル｝＃ゴーグルの解像度は
４０万画素以上、雑音等価温度差は
０．０５℃以下。
}
プリスキン_002: {
電荷転送能力の高い二次元固体撮像素子
方式を採用しているおかげだな。
}
プリスキン_003: {
ステルス迷彩を施された
クレイモア地雷を見ることも
できるだろう。憶えておけ。
}
//dv}//v
}//d
//ドッグタグ持っている場合 t //e
resource PS_赤外線ゴーグル２ {
//vox t:vc212741 {
プリスキン_000: {
敵兵士の首のあたりをよく見れば、
ドッグタグを持っているかどうかも
わかるかも知れんな。
}
//dv}//v
}//d

//レーション h //e
resource PS_レーション {
//vox t:vc212751 {
プリスキン_000: {
レーションを装備してるな。
レーションは＃｛ＬＩＦＥ、ライフ｝＃を一定量回復
できる軍用携帯糧食だ。
}
プリスキン_001: {
ウィンドウで選択して＃｛○、決定｝＃ボタンを
押せば、その場で使って＃｛ＬＩＦＥ、ライフ｝＃を
回復する。
}
プリスキン_002: {
装備しておけば、お前の＃｛ＬＩＦＥ、ライフ｝＃が
ゼロになった瞬間、自動的に使用して
＃｛ＬＩＦＥ、ライフ｝＃を回復することもできる。
}
プリスキン_003: {
レーションは単なる携帯食品ではない。
兵士は戦場でもっとも高価で重要な
戦闘単位の１つと言える。
}
プリスキン_004: {
その機能を維持するために
米軍調理開発研究所が総力を
上げて研究開発した代物だ。
}
プリスキン_005: {
カロリーを重視しつつ栄養バランスは
周到に考えられているし、フリーズ
ドライ方式で小型軽量、日持ちもする。
}
プリスキン_006: {
要するに、よくできた食い物だと
いうことだ。まあ彼女の手料理には
負けるだろうがな。
}
ライデン_007: {
うーむ……。
}
プリスキン_008: {
どうした？
}
ライデン_009: {
……ここだけの話にしてくれるか？
}
プリスキン_010: {
何だ？
}
ライデン_011: {
俺は……できることならローズの
手料理よりもずっとこのレーションで
過ごしたい。
}
プリスキン_012: {
……お前、意外と苦労してるんだな。
}
//dv}//v
}//d

//止血剤 h //e
resource PS_止血剤 {
//vox t:vc212761 {
プリスキン_000: {
止血材を装備してるな。出血している
時にウィンドウで選んで＃｛○、決定｝＃ボタンを
押せば、出血を止めることができる。
}
プリスキン_001: {
その止血材はアルギン酸塩繊維で
できたシート状の吸収パッド。
いわゆるアルギネート材だ。
}
プリスキン_002: {
アルギン酸塩繊維は血液や体液と接触
すると親水コロイドがゲル化して湿潤
環境を作り出し、傷の治癒を促進する。
}
プリスキン_003: {
吸収量も吸収速度も速いのが特徴だ。
止血効果は高いぞ。
}
//dv}//v
}//d

//ジアゼパム h //e
resource PS_ジアゼパム {
//vox t:vc212771 {
プリスキン_000: {
ペンタゼミンを持ってるな。ウィンドウ
で選んで＃｛○、決定｝＃ボタンで使えば狙撃銃を
扱う時の手ぶれを止めることができる。
}
プリスキン_001: {
ペンタゼミンはうつ病や自律神経失調症
の治療に使われるベンゾジアゼピン系の
抗不安薬だ。
}
プリスキン_002: {
鎮静作用に加えて筋弛緩作用、
抗けいれん作用もある。
それで手ぶれが止まるという訳だ。
}
プリスキン_003: {
別にペンタゼミン自体に船酔いを止める
効能がある訳じゃない。憶えておけよ。
}
ライデン_004: {
船酔い？
何を言ってるんだ？
}
プリスキン_005: {
信念が科学的効能を凌駕する場合も
あるということだ。
}
ライデン_006: {
一体……？
}
プリスキン_007: {
気にするな。
}
//dv}//v
}//d


//ボディアーマー h //e
resource PS_ボディアーマー {
//vox t:vc212781 {
プリスキン_000: {
ボディ・アーマーを着てるな。
それを装備していればダメージを
かなり抑えられるはずだ。
}
プリスキン_001: {
ボディ・アーマーには高機能高分子
素材を応用した特殊繊維が織り込まれて
いる。
}
プリスキン_002: {
特殊繊維が着弾した弾丸にまとわりつき、
運動エネルギーを吸収・伝播して
ダメージを抑えるというような仕組みだ。
}
プリスキン_003: {
だがあくまでダメージを抑えるだけで
ゼロにできる訳じゃない。
過信はするなよ。
}
//dv}//v
}//d

resource PS_ＡＫ１ {
//vox t:vc212791 {
プリスキン_000: {
ＡＫＳ－７４Ｕを装備してるな。
}
//dv}//v
}//d
resource PS_ＡＫ２ {
//vox t:vc212801 {
プリスキン_000: {
敵の＃｛野戦服、Ｂ．Ｄ．Ｕ｝＃を着てＡＫを装備すれば
敵兵士に変装できるだろう。
}
//dv}//v
}//d
resource PS_ＡＫ３ {
//vox t:vc212811 {
プリスキン_000: {
ＡＫは操作が簡単で精度・信頼性ともに
極めて高いライフルだ。
}
プリスキン_001: {
それはＡＫが世界各国でライセンス生産、
コピーされている事実からも明らか
だろう。
}
プリスキン_002: {
新型ライフルを設計する際の
参考とされることも、しばしばだ。
}
プリスキン_003: {
イスラエルのガリルやフィンランドの
ヴァルメ等もＡＫの基本構造を踏襲して
設計されている。
}
プリスキン_004: {
お前が持っているのはＡＫＳ－７４を
特殊部隊向けに小型化したタイプだ。
}
プリスキン_005: {
ストックを伸ばしても全長は
７２６ｍｍしかない。
}
プリスキン_006: {
狭い場所でも戦闘の妨げには
ならない、ということだな。
}
//dv}//v
}//d
//サプレッサー装備していない場合 t //e
resource PS_ＡＫ＿サプレッサーない {
//vox t:vc212812 {
プリスキン_000: {
ＡＫにはサプレッサーを装備することも
できる。サプレッサーがあれば、
銃声を気にする必要はなくなるだろう。
}
//dv}//v
}//d
//サプレッサー装備している場合 t //e
resource PS_ＡＫ＿サプレッサーある {
//vox t:vc212813 {
プリスキン_000: {
サプレッサーも装備してるな。
発砲しても銃声で敵に気づかれる
心配はないだろう。
}
//dv}//v
}//d

resource PS_ＡＫ４ {
//vox t:vc212821 {
プリスキン_000: {
憶えておくべきなのは、ＡＫを装備して
いるのはシェル１中央棟の連中だけだ、
ということだ。
}
プリスキン_001: {
他の奴等はロシア陸軍の正式ライフル
ＡＮ９４を装備している。
}
プリスキン_002: {
つまりシェル１中央棟以外では
ＡＫを使った変装は通用しない
ということだ。忘れるなよ。
}
//dv}//v
}//d


//ソーコムの一言うんちく h //e
resource PS_ソーコム＿コックアンドロック {
//vox t:vc212831 {
プリスキン_000: {
お前に渡したソーコムの
トリガーメカニズムは基本的に
ダブルアクションになっている。
}
プリスキン_001: {
だが用兵側からは撃鉄を上げたまま安全
装置をかけるコック・アンド・ロックも
可能なことが要求されたんだ。
}
プリスキン_002: {
人質救出作戦等ではコンマ１秒を争い、
かつ非常な射撃精度が必要になる。
}
プリスキン_003: {
初弾ダブルアクションから次弾以降
シングルアクションへの移行が
伴うことを、彼等は嫌ったんだ。
}
プリスキン_004: {
コック・アンド・ロック。つまり撃鉄を
起こした状態で、セイフティをかける
ことで、初弾発射をより速やかに行う。
}
プリスキン_005: {
それには「時間を稼ぐ」という意味も
あるが、コンバットシューティングを
念頭に置いた場合より重要なことがある。
}
プリスキン_006: {
初弾もシングルアクションにすることに
よって初弾とそれ以降のトリガープルが
同じになるんだ。
}
プリスキン_007: {
それによって、よりスムーズな連射を
行うことができるようになる、
という訳だな。
}
//dv}//v
}//d

//再追加 d //e
resource PS_プラント偽装 {
//vox t:vc212841 {
オタコン_000: {
『ビッグ・シェル』全体が
偽装だっていう話は本当だ。
}
ライデン_001: {
オタコン？
}
オタコン_002: {
スネークにもあちこち調べてもらった。確かに海洋除染施設としての設備を
備えてはいるけどフル稼動はしていない。
}
オタコン_003: {
そもそも、あの事件から２年も経つのに
原油が回収しきれていないというのが
おかしいだろ？
}
オタコン_004: {
勿論、どこの報道機関もそんなこと
伝えないけどね。多分、どこかから
原油を運んで来て補充してるんだと思う。
}
オタコン_005: {
君の聞かされてたプラントが爆発したら
有毒化学物質が発生するっていう話も
かなり変だ。多分本当じゃないだろう。
}
オタコン_006: {
情報は高度に隠蔽されてる。奴等に
とって、新型メタルギアはそれくらいの
手間とカネをかける価値があるんだろう。
}
ライデン_007: {
すっかり騙されていたって訳か……。
}
オタコン_008: {
いや、君の上官だって知らなかったんだ
と思うよ。そう言ってるんだろ。
}
ライデン_009: {
大佐にじゃない！
あんた達にだ。
}
オタコン_010: {
え？騙してなんかいないよ。
言わなかっただけじゃないか。
}
ライデン_011: {
……。
}
オタコン_012: {
はは。面白い人だな、君って。
スネークの言ってた通りだ。
}
ライデン_013: {
……奴は何て？
}
オタコン_014: {
単純軟弱石頭。
}
ライデン_015: {
……たんじゅんなんじゃく……。
}
オタコン_016: {
あ、いや悪い意味じゃないと思うよ。
}
ライデン_017: {
どこが！悪意の塊じゃないか！
あいつの方こそ嘘つきの役立たずの
ひねくれ者のカッコつけのスカした＃－
}
オタコン_018: {
雷電、僕は彼の友達だ。
スネークのことはよく知ってる。
彼は断じてそんな男じゃない。
}
ライデン_019: {
はっ、どうだか？
}
オタコン_020: {
それに……スネークについて君も知って
おいた方がいいと思うことが１つある。
}
ライデン_021: {
何だ？
}
オタコン_022: {
今、隣りにいる。
}
ライデン_023: {
……あんたの？
}
オタコン_024: {
ああ。
}
ライデン_025: {
話も？
}
オタコン_026: {
聞いてる。
}
プリスキン_027: {
……。
}
ライデン_028: {
に、任務に戻る……。
}
//dv}//v
}//d

resource PS_ばぐっち {
プリスキン_000: {
ばぐるなぁ！！
}
}//d


resource PS_無言 {
プリスキン_000: {
……。
}
}//d

resource PS_ＮＰＣスネーク意識なし {
プリスキン_000: {
……。
}
}//d


resource PS_ＡＫ入手時ＣＡＬＬ {
//vox t:vc212792 {
プリスキン_000: {
ＡＫを手に入れたようだな。
}
//dv}//v
}//d

