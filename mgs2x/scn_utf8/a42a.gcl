//-----------------------------------------------------------------------------
// スイッチ

//	ステージ用define
// ------------------------------------
#define		STAGE_W42A 			1

#define		STAGE_PLANT			1
#define		STAGE_ALT			1	//	オルタナティブ系のステージでは全て定義する。ゲームオーバーなどで使用
#define		ANOTHER				1	//	VR,オルタナティブ双方で定義。a_stdproc.hで定義されているため、stdch.h内では、使用することができない


#define ENE_TNG 1



#define RAIDEN     1
#if d:RAIDEN
#define PLAYER     ライデン
#else
#define PLAYER     スネーク
#endif

#define ENEMY_SET    1			// 敵兵の配置
#define STAGE_END    1			// ロードプロック
#define START_CAMERA 1		// ステージ開始時のカメラ

#define SCREENSHOT   0			// スクリーンショット
#define KEYBOARD     0			// ＵＳＢキーボード

//-----------------------------------------------------------------------------
// マップ関係

#define HZX_NAME   a42a
#define LT2_NAME   w42a

#define KMS_NAME0  w42a
#define KMS_NAME1  w41a_dammy
#define KMS_NAME2  w43a_dammy
#define KMS_NAME3  w42a_efct
#define KMS_NAME4  w42a_rbn_ring

#define OBJ_NAME1  w42a_pdray_high
#define OBJ_NAME2  w42a_pdray_low

#define DOOR_NAME1 w42a_dr_left
#define DOOR_NAME2 w42a_dr_right



//	司令官音声
resource ghq_caution_voice {
	w42a:
		$t{
			t:vc040601,	// 指揮官　　「」
			-2,
			t:vc049066,	// 指揮官　　「どうしたんだ」
			-1
		}
}



//	ドア設定用ステージ内ローカル変数(a_mode.hよりも先に定義する)
dim $$b:ドアフラグ[ 2 ]
dim $$s:ドアモデル名[ 4 ]

command	配列セット $$b:ドアフラグ[0] {
	0,	0
}
command	配列セット $$s:ドアモデル名[0] {
	0,	0,	0,	0
}



