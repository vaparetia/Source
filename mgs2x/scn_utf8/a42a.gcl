proc スタートカメラセット {
#if d:DEBUG_PRINT
	print '*** Start Camera Set ***'
#endif

	if ($s:登場ポイント == 拷問部屋から) {
		@ロードカメラ１
	} else if ($s:登場ポイント == 丸通路から) {
		@ロードカメラ２
	}

}

proc スタートカメラオフ {
#if d:DEBUG_PRINT
	print '*** Start Camera Off ***'
#endif

	chara カメラ設定 モーションカメラ -s 0
}

//	インテグラル
proc ロードカメラ１ {
	chara カメラ設定 モーションカメラ \
		-c 1 \
		-p 12685,2617,-9931 \
		-t 9013,1634,-10697 \
		-a 200 \
		-i 0 2 0 0 \
		-s 1
}

//	インテグラル
proc ロードカメラ２ {
		chara カメラ設定 モーションカメラ \
			-c 1 \
			-p 25509,6390,-60032 \
			-t 30880,5262,-63052 \
			-a 200 \
			-i 0 2 0 0 \
			-s 1
}

//-----------------------------------------------------------------------------
// ロード設定
proc ロード設定 {
#if d:DEBUG_PRINT
	print '*** Load Set ***'
#endif

	// @ステージ終了時処理 目標位置  終了時方向  呼び出しプロックに入る  入ってゆく姿勢

	// 拷問部屋へ (w41a)
	trap ld001 d:PLAYER \
		-mask 入る \
		-exec {
			if ($f:ロードチェックＯＮフラグ == 1) {
				@ロードカメラ１
				preseek 'a41a'
				@ステージ終了時処理（ステージ名表示） 5000 0 -10250 3072 mv_a42a_a41a_0 d:DEFAULT_M_TYPE d:wn_アーセナルギア胃
			}
		}

	// 第一通路へ (w43a)
	trap ld002 d:PLAYER \
		-mask 入る \
		-exec {
			if ($f:ロードチェックＯＮフラグ == 1) {
				@ロードカメラ２
				preseek 'a43a'
				@ステージ終了時処理（ステージ名表示） 33500 4000 -62500 1024 mv_a42a_a43a_0 d:DEFAULT_M_TYPE d:wn_アーセナルギア上行結腸
			}
		}

}

proc ロードプロック {
#if d:DEBUG_PRINT
	print '*** Load Proc ***'
#endif

	if($s:呼び出しプロック == mv_a42a_a41a_0) {
		// 拷問部屋へ
		@mv_a42a_a41a_0

	} else if($s:呼び出しプロック == mv_a42a_a43a_0) {
		if($w:アラートモード != d:ALERT_MODE_SENNYU) {
			command セットサウンドコード -c d:SNG_FOUTS_S
		}
		// 第一通路へ
		@mv_a42a_a43a_0
	}
}

//=============================================================================
// ステージ進入時処理
//=============================================================================

proc ステージ進入時処理 {
#if d:DEBUG_PRINT
	print '*** Stage Start Proc ***'
#endif

	//	拷問部屋から
	if ($s:登場ポイント == 拷問部屋から) {
		@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:SL_DOOR_TYPE 拷問部屋へのドア 2000 \
		d:DEFAULT_M_TYPE d:wn_アーセナルギア空腸
	//	丸通路から
	} else if ($s:登場ポイント == 丸通路から) {
		@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:SL_DOOR_TYPE 第一通路へのドア 2500 \
		d:DEFAULT_M_TYPE d:wn_アーセナルギア空腸
	}

}
