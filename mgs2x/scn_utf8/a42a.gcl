// アナザー用でマップ設定前に設定する
// ------------------------------------
@アナザー用マップ定義前設定


//=============================================================================
// メイン
//=============================================================================

chara マップ 第一メタルハンガー \
	-k d:KMS_NAME0 \
	-h d:HZX_NAME, 0 \
	-l d:LT2_NAME


command マップ設定 第一メタルハンガー -set {
	// サウンド、キャラクターのセット
	@常駐キャラ設定
	@A_プレイヤー設定 sna_a42a rai_a42a
	@亀甲床設定
	@息設定
}

// アナザー用でマップ設定後に設定する
// ------------------------------------
@アナザー用マップ定義後設定

command マップ設定 第一メタルハンガー -set {
	@SS_跳弾弾痕設定
// マップ切り替え、ロード、ドア
// ------------------------------------
	@ドア設定
	@ロード設定

// ステージ、オブジェクト関連
// ------------------------------------
	@その他オブジェクト設定
	@ジャンプ設定

	@カメラ設定

/*
	if ($f:w41a_ノードフラグ == 1) {
		@プラント編全体マップ設定 d:アーセナルギア空腸
	} else {
		@ポーズ時ステージ名表示設定 d:wn_アーセナルギア空腸
	}
*/

	@SS_フォグ_キャラ用ライト設定
}

command マップ表示 -show 第一メタルハンガー

@ステージ進入時処理






//=============================================================================
// プロシージャ
//=============================================================================

//=============================================================================
// 基本設定
//=============================================================================

//-----------------------------------------------------------------------------
// 息設定
proc 息設定 {
	// 白息
	chara 白息 プレイヤー息 \
		-name     d:PLAYER \
		-object   12 \
		-shift    0,-30,130 \
		-interval 136
	mesg 白息 プレイヤー息 on
}
// 亀甲床設定
proc 亀甲床設定 {
	// 亀甲床
	chara 亀甲床 亀甲床 \
		-prims  128 \
		-alpha  7 \
		-vertex 5 \
		-user   64 \
		-time   150
}

//=============================================================================
// ビヨンド、ジャンプ
//=============================================================================

//-----------------------------------------------------------------------------
// ジャンプ設定
proc ジャンプ設定 {
#if d:DEBUG_PRINT
	print '*** Jump Set ***'
#endif

	command プラグイン自動ジャンプ
	@ジャンプ発動 ky001 1000 50

	trap ca106 d:PLAYER \
		-mask 入る \
		-camera \								//カメラトラップであることを明示
		-exec {
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p 14251,3326,-33554 \
				-t 16665,2165,-36926 \
				-a 200 \
				-i 0 2 0 0 \
				-s 1

			chara delay ディレイ -time 45 -exec {
				chara カメラ設定 モーションカメラ -s 0
			}
		}
}

//=============================================================================
// オブジェクト
//=============================================================================

//-----------------------------------------------------------------------------
// ドア設定
proc ドア設定 {
#if d:DEBUG_PRINT
	print '*** Door Set ***'
#endif
/*
	@ドアモデル名セット $:配列番号 \
		$:ドア名１				$:ドア名２				$:ドア名３ \
		$:ドア名４				$:ドア名５
		d:DOOR_FLAG_CLOSE 		d:DOOR_FLAG_OPEN		d:DOOR_FLAG_ENEMY_ONLY
		d:DOOR_FLAG_CLOSE_LEVEL	d:DOOR_FLAG_OPEN_LEVEL

	@A_ドア開閉追加設定 $:ドア名 $:フラグ $:ドア位置Ｘ $:ドア位置Ｙ $:ドア位置Ｚ $:ドア回転 $:ドアスライド幅
*/
	//	拷問部屋へのドア
	//	アーセナルドアは両開きのためフラグ１つでモデル２つを管理する
	@ドアモデル名セット 0 d:DOOR_NAME1 d:DOOR_NAME1 d:DOOR_NAME1 d:DOOR_NAME1 d:DOOR_NAME1
	switch ( $$b:ドアフラグ[0] ) {
		case ( d:DOOR_FLAG_CLOSE ) {
			$$s:ドアモデル名[2] = d:DOOR_NAME2;
		}
		case ( d:DOOR_FLAG_OPEN ) {
			$$s:ドアモデル名[2] = d:DOOR_NAME2;
		}
		case ( d:DOOR_FLAG_ENEMY_ONLY ) {
			$$s:ドアモデル名[2] = d:DOOR_NAME2;
		}
		case ( d:DOOR_FLAG_CLOSE_LEVEL ) {
			$$s:ドアモデル名[2] = d:DOOR_NAME2;
		}
		case ( d:DOOR_FLAG_OPEN_LEVEL ) {
			$$s:ドアモデル名[2] = d:DOOR_NAME2;
		}
	}

	@A_ドア開閉追加設定 拷問部屋へのドア $$b:ドアフラグ[0] 6875 0 -11000 3072 d:SD_SLIDE_INSIDE

	//	第一通路へのドア
	//	アーセナルドアは両開きのためフラグ１つでモデル２つを管理する
	@ドアモデル名セット 1 d:DOOR_NAME1 d:DOOR_NAME1 d:DOOR_NAME1 d:DOOR_NAME1 d:DOOR_NAME1
	switch ( $$b:ドアフラグ[1] ) {
		case ( d:DOOR_FLAG_CLOSE ) {
			$$s:ドアモデル名[3] = d:DOOR_NAME2;
		}
		case ( d:DOOR_FLAG_OPEN ) {
			$$s:ドアモデル名[3] = d:DOOR_NAME2;
		}
		case ( d:DOOR_FLAG_ENEMY_ONLY ) {
			$$s:ドアモデル名[3] = d:DOOR_NAME2;
		}
		case ( d:DOOR_FLAG_CLOSE_LEVEL ) {
			$$s:ドアモデル名[3] = d:DOOR_NAME2;
		}
		case ( d:DOOR_FLAG_OPEN_LEVEL ) {
			$$s:ドアモデル名[3] = d:DOOR_NAME2;
		}
	}

	@A_ドア開閉追加設定  第一通路へのドア $$b:ドアフラグ[1] 31625 4000 -63250 3072 d:SD_SLIDE_INSIDE


	// ドア
	//   -m オブジェクト名  -d 向き  -p 場所  -slide スライド量  -time 時間  -between マップ名１ マップ名２  -exec { $:開閉フラグ }

	//	拷問部屋へのドア
	chara ドア 拷問部屋へのドア \
		-m $$s:ドアモデル名[0] \
		-d 0 3072 0 \
		-p 6875 0 -11000 \
		-s d:SD_SLIDE_ARSENAL_LEFT \
		-t d:SD_OPEN_TIME \
		-b 第一メタルハンガー 第一メタルハンガー \
		-w $$s:ドアモデル名[2] d:SD_SLIDE_ARSENAL_RIGHT \
		-hazard_width 1500 \
		-exec {
			if(!($:開閉フラグ)) {
				mesg プットオブジェ 拷問部屋ロード部 off		// ロード部モデル
			} else {
				mesg プットオブジェ 拷問部屋ロード部 on			// ロード部モデル
			}
		}
	@主観禁止壁 拷問部屋へのドア壁 6875 0 -11000 3072 d:SD_SLIDE_INSIDE

	trap dr001 ？ -mask ？ \
		-exec {
			if($3 == 入る) {
				mesg ドア 拷問部屋へのドア open $2
			} else if($3 == 出る) {
				mesg ドア 拷問部屋へのドア close $2
			}
		}
	trap dr001 d:PLAYER -mask ？ \
		-state d:TRP_STATE_SUBJECT \
		-exec {
			if($3 == 入る) {
				mesg 透明壁 拷問部屋へのドア壁 on
			} else if($3 == 出る) {
				mesg 透明壁 拷問部屋へのドア壁 off
			}
		}

	//	第一通路へのドア
	chara ドア 第一通路へのドア \
		-m $$s:ドアモデル名[1] \
		-d 0 3072 0 \
		-p 31625 4000 -63250 \
		-s d:SD_SLIDE_ARSENAL_LEFT \
		-t d:SD_OPEN_TIME \
		-b 第一メタルハンガー 第一メタルハンガー \
		-w $$s:ドアモデル名[3] d:SD_SLIDE_ARSENAL_RIGHT \
		-hazard_width 1500 \
		-exec {
			if(!($:開閉フラグ)) {
				mesg プットオブジェ 第一通路ロード部 off		// ロード部モデル
			} else {
				mesg プットオブジェ 第一通路ロード部 on			// ロード部モデル
			}
		}
	@主観禁止壁  第一通路へのドア壁 31625 4000 -63250 3072 d:SD_SLIDE_INSIDE

	trap dr002 ？ -mask ？ \
		-exec {
			if($3 == 入る) {
				mesg ドア 第一通路へのドア open $2
			} else if($3 == 出る) {
				mesg ドア 第一通路へのドア close $2
			}
		}
	trap dr002 d:PLAYER -mask ？ \
		-state d:TRP_STATE_SUBJECT \
		-exec {
			if($3 == 入る) {
				mesg 透明壁 第一通路へのドア壁 on
			} else if($3 == 出る) {
				mesg 透明壁 第一通路へのドア壁 off
			}
		}
}

//-----------------------------------------------------------------------------
// デモ共用オブジェクト設定
proc デモ共用オブジェクト設定 {
#if d:DEBUG_PRINT
	print '*** Demo Object Set ***'
#endif

	//---------------------------------------------------------
	// 量産メタル
	chara プットオブジェ 量産メタルＡ \
		-m d:OBJ_NAME2 \
		-r 0,2048,0 \
		-p 3000,0,-25750 \
		-s 100,100,100 \
		-l d:LT2_NAME
	chara プットオブジェ 量産メタルＢ \
		-m d:OBJ_NAME2 \
		-r 0,2048,0 \
		-p 3000,0,-37750 \
		-s 100,100,100 \
		-l d:LT2_NAME
	chara プットオブジェ 量産メタルＣ \
		-m d:OBJ_NAME2 \
		-r 0,2048,0 \
		-p 3000,0,-49750 \
		-s 100,100,100 \
		-l d:LT2_NAME
	chara プットオブジェ 量産メタルＤ \
		-m d:OBJ_NAME2 \
		-r 0,0,0 \
		-p 24000,0,-25750 \
		-s 100,100,100 \
		-l d:LT2_NAME
	chara プットオブジェ 量産メタルＥ \
		-m d:OBJ_NAME2 \
		-r 0,0,0 \
		-p 24000,0,-37750 \
		-s 100,100,100 \
		-l d:LT2_NAME
	chara プットオブジェ 量産メタルＦ \
		-m d:OBJ_NAME1 \
		-r 0,0,0 \
		-p 24000,0,-49750 \
		-s 100,100,100 \
		-l d:LT2_NAME

	//---------------------------------------------------------
	// リボン
	@SS_プットオブジェ リボン d:KMS_NAME3

	//---------------------------------------------------------
	// 回転リボン
	chara 回転モデル 回転モデル \
		-O        13500 6000 -25625 \	// 起点
		-posz     0 \
		-spin     0 (300 * 60 * 4) \	// 軸回転
		-model    d:KMS_NAME4			// 使用モデル名

	chara 回転モデル 回転モデル \
		-O        13500 6000 -25625 \	// 起点
		-posz     -12000 \
		-spin     0 (-300 * 60 * 4) \	// 軸回転
		-model    d:KMS_NAME4			// 使用モデル名

	chara 回転モデル 回転モデル \
		-O        13500 6000 -25625 \	// 起点
		-posz     -24000 \
		-spin     0 (300 * 60 * 4) \	// 軸回転
		-model    d:KMS_NAME4			// 使用モデル名

	//---------------------------------------------------------
	// 天狗兵ステージモニターW42a
	chara 天狗兵ステージモニターW42a モニター

}

//-----------------------------------------------------------------------------
// その他オブジェクト設定
proc その他オブジェクト設定 {
#if d:DEBUG_PRINT
	print '*** Object Set ***'
#endif

	//---------------------------------------------------------
	// デモ共用オブジェクト
	@デモ共用オブジェクト設定

	//---------------------------------------------------------
	// ロード部モデル
	@SS_プットオブジェ  拷問部屋ロード部 d:KMS_NAME1
	mesg プットオブジェ 拷問部屋ロード部 off
	@SS_プットオブジェ  第一通路ロード部 d:KMS_NAME2
	mesg プットオブジェ 第一通路ロード部 off
}

//=============================================================================
// フォグ、カメラ、ロード
//=============================================================================

//-----------------------------------------------------------------------------
// フォグ設定
proc フォグ設定 {
#if d:DEBUG_PRINT
	print '*** Fog Set ***'
#endif

	chara フォグ 霧 -c 3 18 11 -n -4000 -f 35000 -z
}

//-----------------------------------------------------------------------------
// カメラ設定
proc カメラ設定 {
#if d:DEBUG_PRINT
	print '*** Camera Set ***'
#endif

	// カメラ
	//   -c チャンネル番号  -l カメラレベル  -p 優先度
	//
	//   シナリオカメラは最大16個までおける。
	//   チャンネル番号 ：
	//       ０：通常画面 １：小窓
	//   カメラレベル ：
	//       ０：カットインカメラ（主観より強） 強
	//       １：カットインカメラ（主観より弱） ↑
	//       ２：エリアカメラ		   ↓
	//       ３：ステージデフォルトカメラ	   弱
	//   優先度 ：
	//       エリアカメラに有効
	//       数字が小さい程優先度高
	chara カメラ ステージカメラ		-c 0 -l 3 -p  0
	chara カメラ サブカメラ１		-c 0 -l 2 -p 50
	chara カメラ サブカメラ２		-c 0 -l 2 -p 40
	chara カメラ サブカメラ３		-c 0 -l 2 -p 30
	chara カメラ モーションカメラ	-c 0 -l 2 -p 20
	chara カメラ でもデモカメラ		-c 0 -l 0 -p  0

	// カメラ設定
	//   -c カメラタイプ  -b バウンド小 バウンド大  -l リミット小 リミット大  -p カメラ位置  -t ターゲット位置  -r カメラ角度  -f カメラトラック  -a カメラ画角  -i カメラ補完方法（ＩＮ） カメラ補完方法（ＯＵＴ） 補完時間（ＩＮ） 補完時間（ＯＵＴ）  -d パッドフラグ  -z 各種フラグ  -k ＫＩＬＬ  -s ０オフ／１オン  -o ＯＮになるまでの待ち時間  -E スライドタイプ スライド待ち時間 スライド距離１ スライド距離２ スライドスピード [スライドフラグ]  -N 内部補完時間
	//
	//   -b -l は必要に応じて設定。-p -t -r はタイプに応じて使用するものが取得される。省略したオプションは、前回設定を引き継ぐ。
	//   フラグ：
	//       CAMERA_CUT_IN (カットインカメラ) CAMERA_NO_CUSHION (遊びなしカメラ) CAMERA_BOUNDCHANGE_QUICK (バウンド変更を即時に反映) CAMERA_INTERP_CAMERA (補完カメラ設定)
	//   カメラタイプ：
	//       ０：上俯瞰追従型（トラックと角度を指定） １：位置・角度固定型（ターゲット位置とカメラ位置を指定） ２：位置固定、追従型（カメラ位置を指定） ３：位置固定、Ｘ角度追従型（カメラ位置を指定） ４：ターゲット固定、プレイヤー追従カメラ（ターゲットとトラックを指定）
	//   補完方法：
	//       －１：指定なし ０：一瞬 １：補完シューン ２：補完ウニョーン ３：補完ウーニャーン ４：一定時間で
	//       補完時間は４番指定のとき有効。補完（ＩＮ）の指定は必須。２つのカメラ間の補完方法は、ＯＵＴ側カメラのＯＵＴ補完関数が指定してある場合にはその関数を使用し、指定がない場合には、ＩＮ側カメラのＩＮ補完関数を使用するようになっている。
	//   パッドフラグ：
	//       このフラグを指定しておくと、パッドの上が画面の上になるように自動調節する。
	//   スライドカメラ設定方法：
	//       スライドタイプ (０／１ － 左右タイプ／前後タイプ) スライド待ち時間 (スライドするまでの待ちフレーム数) スライド距離１・２ (左右タイプの場合 左右スライド距離。前後タイプの場合 接近距離、離れた距離) スライドスピード (そのまんま) スライドフラグ (1にしておくと、入った時スライドしていない状態から始まります。)
	//   補完カメラの設定方法：
	//       補完カメラとは？ － 設定したカメラに指定フレーム数かけて移動するカメラ。例として、オルガ戦のパンカメラ。
	//       設定方法 － -z に d:CAMERA_INTERP_CAMERA を指定。さらに -interp_time に補完フレーム数を指定。

	// デフォルトカメラ
	chara カメラ設定 ステージカメラ \
		-c 0 \
		-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
		-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
		-r 200,2048,0 \
