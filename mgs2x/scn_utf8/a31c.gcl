// 以下仮キャラ用proc
// -----------------------------------------------------------------------------------
// 仮キャラ
// ------------------------------------
	// 照り返しエフェクトの設定
	// ------------------------------------
	proc 照り返しエフェクト設定 {
		#if d:DEBUG_PRINT
			print 'w31c0_terikaesi_effect_set'
		#endif

		// 南北用
		command foreach -argc 4 -repeat 6 \
			-data { \
					{ 2048 , -8500 , -245500 , -246000 } \
					{ 2048 , -11500 , -245500 , -246000 } \
					{ 2048 , -14500 , -245500 , -246000 } \
					{ 0 , -14500 , -233000 , -232500 } \
					{ 0 , -11500 , -233000 , -232500 } \
					{ 0 , -5500 , -233000 , -232500 } \
				} \
				-exec { \
					chara 天井照り返し 天井照り返し \
						-r 1024 $1 0 \
						-p $2 -3000 $3 \
						-w 1300 \
						-h 1000 \
						-m 0 \
						-a 32

					chara 壁照り返し 壁照り返し \
						-r 0 $1 0 \
						-p $2 -4500 $4 \
						-w 1300 \
						-h 2000 \
						-m 1 \
						-a 64 \
						-b 0
				}

		// 東西用
		command foreach -argc 4 -repeat 8 \
			-data { \
					{ 3072 , -16250 , -243750 , -16750 } \
					{ 3072 , -16250 , -240750 , -16750 } \
					{ 3072 , -16250 , -237750 , -16750 } \
					{ 3072 , -16250 , -234750 , -16750 } \
					{ 1024 , -3750 , -243750 , -3250 } \
					{ 1024 , -3750 , -240750 , -3250 } \
					{ 1024 , -3750 , -237750 , -3250 } \
					{ 1024 , -3750 , -234750 , -3250 } \
				} \
				-exec { \
					chara 天井照り返し 天井照り返し \
						-r 1024 $1 0 \
						-p $2 -3000 $3 \
						-w 1300 \
						-h 1000 \
						-m 0 \
						-a 32

					chara 壁照り返し 壁照り返し \
						-r 0 $1 0 \
						-p $4 -4500 $3 \
						-w 1300 \
						-h 2000 \
						-m 1 \
						-a 64 \
						-b 0
				}

	}













// 以下デバッグ専用proc
// -----------------------------------------------------------------------------------
// デバッグキャラ
// ------------------------------------
proc デバッグキャラセット {
	#if d:DEBUG_PRINT
		print 'debug_chara_set'
	#endif

	#if d:CHARA_CAMERA
		chara キャラカメラ 敵兵カメラ \
			-c d:TARGET_CHARA \
			-s -920,610,200 \
			-r -200,1024,0
	#endif

	#if d:SCREENSHOT
		chara スクリーンショット shot
	#endif

	#if d:USB_KEY
		chara USBキーボード実行 test \
			-e d:KBD_ESC {
				mesg プレイヤー d:PLAYER position -5500, -13000, -500
			} \
			-e d:KPD_1 {
				print '水中エフェクト オン'
				mesg カメラ泡     泡ぶくマン オン
				mesg カメラダスト ダストマン オン
			} \
			-e d:KPD_2 {
				print '水中エフェクト オフ'
				mesg カメラ泡     泡ぶくマン オフ
				mesg カメラダスト ダストマン オフ
			}
	#endif
}
