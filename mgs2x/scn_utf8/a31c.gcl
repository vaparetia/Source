// 各gclで必要なdefine
// ------------------------------------
// モード
#define		STAGE_PLANT		1		// 共通プロック切り分け用
#define		STAGE_ALT		1		// オルタナティブミッション切り分け用
// ステージ名
#define		STAGE_W31C		1		// 共通プロック切り分け用
// 敵兵、ＮＰＣ状況（薬莢を呼び分けるのに必要）


// 各種スイッチ用define
// ------------------------------------
// 入出トラップ
#define		STAGE_END		1		// ステージ終了時処理を使用可にする
// カメラ関係
#define		START_CAMERA	1		// ステージ開始時のカメラ
#define		WATER_CAMERA	1		// 水中モード時のカメラをオフにする
#define		WATER_CAMERA2	1		// 入水カメラ
// オブジェ関係
#define		WATER			1		// 水面
#define		LOCKER			1		// ロッカー
#define		LOCKER_CLOSE	0		// ロッカー開閉フラグ
#define		LOCKER_OPEN		1		// ロッカー開閉フラグ

// 水中モード関連
#define	WATER_MODE			1		// 水中モード基本キャラ設定を使用するのに必要
#define VAMP_WATER_SURFACE	-7000	// 水面の高さ(ヴァンププール)
#define WATER_SURFACE		-6550	// 水面の高さ(エマロッカー部屋外)
#define EMMA_WATER_SURFACE	-7150	// 水面の高さ(エマロッカー部屋内)
#define	WATER_CAMERA_ZONE	1		// 追従カメラが使用するゾーンのあるグループ番号(必要があれば定義する)
#define	CAMERA_BUBBLE_NUM	3		// カメラ泡の個数(いらない場合は定義しない)
#define	CAMERA_DUST_NUM		10		// カメラダストの個数(いらない場合は定義しない)
// アイテム
#define		ITEM			1

// デバッグ関係
#ifdef	d:FIX_MODE
	#define		DEBUG_CHARA		0		// デバッグキャラ全体(FIX時は0)
	#define		NO_NEXT_STAGE	0		// ヴァンプ戦終了後処理しない
#else
	#define		DEBUG_CHARA		1		// デバッグキャラ全体
	#define		NO_NEXT_STAGE	0		// ヴァンプ戦終了後処理しない
#endif
#define		CHARA_CAMERA	0		// キャラ追従カメラ
#define		TARGET_CHARA	敵兵:01	// キャラ追従カメラのターゲット
#define		SCREENSHOT		0		// スクリーンショット
#define		USB_KEY			0		// USBキーボード


// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME		w31c
#define		KMS_NAME0		w31c0
#define		KMS_NAME1		w31c1
#define		CEIL_NAME0		w31c0r
#define		CEIL_NAME1		w31c1r
#define		DOOR_NAME_LV0	dr_free
#define		DOOR_NAME_LV4	dr_lv4_00
#define		LT2_NAME		w31c

// キャラクター関係
#define		PLAYER		ライデン	// モーションができるまで名前はスネーク

// ローカル変数

// アイテム番号（アイテムが多いのでenumで）
enum I_NO {
	M9_R01 = 0,
	RGB6_R01,
	SOCOM_R01,
	M4_R01,
	M4_R02,
	AKS_R01,
	PSG1T_R01,
	RATION_01,
	RATION_02,
	RATION_03,
	C4_01,
	C4_02,
	MAG_01,
	DIAZE_01
}



// include
// ------------------------------------
#include "rai_w31c.mh"		// 強制モーションリスト
#include "stdch.h"
