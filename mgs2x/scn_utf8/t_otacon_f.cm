//○仕様 d //e
//・ルードの仕方。h //e
resource TO_エルード１の１__f {
//＊ムービー t //e
オタコン_000: {
Quand tu es pr&`es d'un garde-fou pouvant
&^etre escalad&'e, appuie sur la touche Action
pour te suspendre de l'autre c&^ot&'e.
}
//	<<<ENGLISH>>>
//	Push the Action button near
//	a scalable railing to hang off
//	the other side.

/*乗り越えられる手すりの近くで
＃｛△、アクション｝＃ボタンを押すと、その手すりの
向こう側にぶらさがることが出来る。
*/
}


resource TO_エルード１の２__f {
//＊ムービー t //e
オタコン_000: {
C'est une Suspension.
}
//	<<<ENGLISH>>>
//	This is called Hanging.
//<ページ数変更>
オタコン_000_1: {
Tu peux l'utiliser pour te d&'eplacer, te
cacher et m&^eme pour des man&@euvres
dans le dos de l'ennemi.
}
//	<<<ENGLISH>>>
//	You can use it to move around,
//	hide, and even maneuver around
//	an enemy's back.

/*これをエルードっていうんだ。
移動だけじゃなく、隠れたり敵の背後を
とったりするのにも使えるはずだ。
*/
}


resource TO_エルード２の１__f {
//＊ムービー t //e
オタコン_000: {
Pendant la Suspension, tu peux actionner
le joystick analogique gauche ou les
touches L2 et R2 pour te d&'eplacer vers
la gauche ou la droite.
}
//	<<<ENGLISH>>>
//	You can move left and right while
//	Hanging by moving the left analog
//	stick or using the L2 and R2 buttons.

/*
You can move the left analog stick
or use the L2 and R2 buttons to
move left and right while hanging.
エルード中は左スティックの左右か
Ｌ２ボタン、Ｒ２ボタンで左右に
移動出来る。
*/
}


resource TO_エルード２の２__f {
//＊ムービー t //e
オタコン_000: {
Quand tu es pr&^et &`a te remettre d'aplomb,
appuie de nouveau sur la touche Action.
}
//	<<<ENGLISH>>>
//	When you're ready to pull yourself
//	up, just push the Action button again.

/*這い上がりたくなったら、
もう一度＃｛△、アクション｝＃ボタンを押せばいい。
*/
}



resource TO_エルード３の１__f {
//＊ムービー t //e
オタコン_000: {
Pendant la Suspension,
une Jauge de GRIP appara&^it
sous la Jauge de LIFE.
}
//	<<<ENGLISH>>>
//	A Grip Gauge appears below
//	the Life Gauge during Hanging.

/*あと、エルード中は＃｛ＬＩＦＥ、ライフ｝＃ゲージの
下に＃｛握力、グリップ｝＃ゲージが表示されるんだ。
*/

オタコン_001: {
La Jauge de GRIP indique ton degr&'e de
prise et diminue r&'eguli&`erement ＃－
}
//	<<<ENGLISH>>>
//	The Grip Gauge indicates how
//	tightly you are holding on,
//<ページ数変更>
オタコン_001_1: {
tant que tu restes en mode de Suspension.
}
//	<<<ENGLISH>>>
//	and steadily decreases as long
//	as you are in Hanging mode.

/*＃｛握力、グリップ｝＃ゲージは君の握力を表していて、
エルードしている間、少しずつ減って
いく。
*/
}


resource TO_エルード３の２__f {
//＊ムービー t //e
オタコン_000: {
Lorsque la Jauge de GRIP tombe &`a z&'ero,
tu n'es plus en mesure de t'agripper.
}
//	<<<ENGLISH>>>
//	When the Grip Gauge goes to
//	zero, you won't be able to hold
//	on anymore.
//<ページ数変更>
オタコン_000_1: {
Tu dois donc te hisser avant de tomber.
}
//	<<<ENGLISH>>>
//	You need to hoist yourself
//	up before you fall off.

/*＃｛握力、グリップ｝＃ゲージが無くなったら、つかまっていられなくなって下に落ちてしまう。
そうなる前に這い上がった方がいいね。
*/
}


resource TO_エルード４の１__f {
//＠×か、ホフクか //e
//＊ムービー t //e
オタコン_000: {
Pour faire une chute libre, appuie sur la
touche Annuler pendant que tu es en
Suspension.
}
/*エルード中に＃｛×、ホフク｝＃ボタンを押すと、
真下に飛び降りる。
Push the Crawl button
while Hanging to jump
down straight below.
*/
}


resource TO_エルード４の２__f {
//＊ムービー t //e
オタコン_000: {
Si tu es trop loin du sol, tu perdras un peu
de LIFE.
}
//	<<<ENGLISH>>>
//	If the ground is too far
//	below, you'll lose some
//	LIFE.
//<ページ数変更>
オタコン_000_1: {
Il se peut m&^eme que tu succombes, dans
certaines circonstances. Fais attention.
}
//	<<<ENGLISH>>>
//	In some places, you won't
//	make it at all. Be careful
//	of that.

/*でも高過ぎる所から落ちたら＃｛ＬＩＦＥ、ライフ｝＃が
減るし、場所によっては助からないかも
しれない。気をつけてくれ。
*/

//＠エルード自殺可能？ //e
}//d


//・段差上り（上れる場所近くでも発生）h //e
//＊ムービー t //e
resource TO_段差上り__f {
オタコン_000: {
S'il y a des objets &`a hauteur de hanche, tu
pourras les escalader ou monter dessus en
appuyant sur la touche Action.
}
//	<<<ENGLISH>>>
//	If it's about waist-high, you'll be
//	able to climb up or over things
//	with the Action button.
//<ページ数変更>
オタコン_000_1: {
Ne l'oublie pas !
}
//	<<<ENGLISH>>>
//	Keep that in mind.

/*腰くらいの高さのものなら、
＃｛△、アクション｝＃ボタンを押せばよじ登ることが出来る。
忘れないでくれ。
*/

}//d


//・主観攻撃（左右ステップ、背伸び）h //e
resource TO_主観攻撃１の１__f {
//＊ムービー t //e
オタコン_000: {
S&'electionne avoir s&'electionn&'e une arme,
puis passe en Observation &`a la premi&`ere
personne.
}
//	<<<ENGLISH>>>
//	Change to First Person View
//	with a weapon selected.
//<ページ数変更>
オタコン_000_1: {
Pour viser, appuie sur la touche Arme. Tu
seras alors pr&^et &`a attaquer en Observation
&`a la premi&`ere personne.
}
//	<<<ENGLISH>>>
//	Once you aim your weapon with
//	the Weapon button, you're ready
//	to attack in First Person View.

/*武器を装備した状態で主観にして、
＃｛□、武器｝＃ボタンで武器を構えれば、
主観攻撃が出来る。
*/
}


resource TO_主観攻撃１の２__f {
//＊ムービー t //e
オタコン_000: {
L'Observation &`a la premi&`ere personne
d'attaque permet de tirer vers le haut ou le
