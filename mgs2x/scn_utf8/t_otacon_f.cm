*/

}//d
//＠構え下ろしは拳銃だけ？ //e


//・流血で見つかる h //e
//＠敵の血痕に敵は反応しない //e
resource TO_血痕見つかる__f {
オタコン_000: {
Snake, si tu es bless&'e lors d'une attaque
ennemie, tes chances d'&^etre captur&'e
augmenteront.
}
//	<<<ENGLISH>>>
//	Snake, if you sustain damage from
//	enemy attacks, it could increase
//	your chances of capture.
//<ページ数変更>
オタコン_000_1: {
Tes taches de sang risquent de conduire
l'ennemi jusqu'&`a toi.
}
//	<<<ENGLISH>>>
//	The bloodstains would
//	lead them right to you.

/*スネークが敵の攻撃を受けたら血が
飛び散る。血の跡が残るからそれが敵に
見つかったら面倒なことになるだろう。
*/

オタコン_001: {
Voil&`a une autre raison d'&'eviter tout risque
de confrontation avec l'ennemi.
}
//	<<<ENGLISH>>>
//	That's another reason you should
//	stay away from trouble as much
//	as possible.

/*血を流すようなことは出来るだけ
さけたほうがいい。
*/

}//d


//・止血条件 h //e
//＠流血止血仕様未満？回復は静止？ //e
resource TO_流血止血条件出血状態__f {
//血が出ている時 t //e
オタコン_000: {
Snake, tu saignes !?
}
//	<<<ENGLISH>>>
//	Snake, are you bleeding!?

/*スネーク、出血してるのかい！？*/
}


resource TO_流血止血条件__f {
オタコン_001: {
Si ta jauge de LIFE baisse au point
de devenir rouge, ton saignement
ne s'arr&^etera pas.
}
//	<<<ENGLISH(2)>>>
//	If your Life Gauge is down to the
//	point where it's red, the bleeding
//	won't stop.

/*＃｛ＬＩＦＥ、ライフ｝＃ゲージが赤くなるまで減ると
血が止まらなくなるんだ。
*/

オタコン_002: {
Tant que tu saigneras, ta jauge
de LIFE continuera &`a diminuer
progressivement.
}
//	<<<ENGLISH>>>
//	As long as you're bleeding,
//	your Life Gauge will keep
//	dropping gradually.
//<ページ数変更>
オタコン_002_1: {
En outre, tes taches de sang risquent de
te faire rep&'erer par l'ennemi.
}
//	<<<ENGLISH>>>
//	Besides that, the bloodstains
//	could put the enemy on your
//	trail.

/*出血してる間は＃｛ＬＩＦＥ、ライフ｝＃も少しずつ
減っていくし、血痕を敵に見つけられて
追跡されるかもしれない。
*/

オタコン_003: {
Pour arr&^eter de saigner, tu dois mettre ton
corps au repos jusqu'&`a ce que ta jauge de
LIFE redevienne verte.
}
//	<<<ENGLISH(2)>>>
//	The only way to stop the bleeding
//	for good is to let your body recover
//	until the Life Gauge is green.
//<ページ数変更>
オタコン_003_1: {
Pour cela, le mieux est de manger des
rations.
}
//	<<<ENGLISH>>>
//	Rations are the best
//	way to do that.

/*完全に血を止めるには＃｛ＬＩＦＥ、ライフ｝＃ゲージが
緑色に戻るまで回復させるしかない。
回復にはレーションが一番いいね。
*/

オタコン_004: {
Quand tu saignes, essaie de t'accroupir ou
de te mettre en position de Ramper et
reste immobile.
}
//	<<<ENGLISH>>>
//	Try to crouch down or assume Crawl
//	position and stay still while you're
//	bleeding.
//<ページ数変更>
オタコン_004_1: {
Ta jauge de LIFE remontera
petit &`a petit.
}
//	<<<ENGLISH>>>
//	Your LIFE will recover bit by bit.

/*でも出血してる間はしゃがむかホフク
するかして、じっと止まっていれば
少しずつ＃｛ＬＩＦＥ、ライフ｝＃が回復するんだ。
*/

オタコン_005: {
Si possible, &'evite de bouger jusqu'&`a ce que
le saignement ait cess&'e.
}
//	<<<ENGLISH>>>
//	I'd recommend that you stay in
//	hiding until the bleeding stops,
//	if possible.

/*血が止まるまでどこかで隠れているのも
いいかもしれない。
*/
}


resource TO_流血止血条件止血剤__f {
オタコン_000: {
Tu peux &'egalement mettre un pansement
de gel pour emp&^echer de perdre
davantase de sang, mais il s'agit d'une
mesure d'urgence.
}
//	<<<ENGLISH>>>
//	You can also use the gel bandage
//	to prevent further blood loss, but
//	this is an emergency measure only.
//<ページ数変更>
オタコン_000_1: {
Si tu le d&'es&'electionnes pour te munir d'un
autre &'equipement, tu retourneras au point
de d&'epart. Ne l'oublie pas.
}
//	<<<ENGLISH>>>
//	If you deselect it as your current
//	equipment, you're back to square
//	one. Keep that in mind.

/*止血剤を装備すれば血は止まるけど、
あくまで応急処置だ。装備から外したら
また出血してしまう。気をつけてくれ。
*/

//＠流血回復は静止か？ //e
}//d



//・部位ダメージの違い（麻酔の効き方）h //e
resource TO_麻酔効き方__f {
オタコン_000: {
Snake, l'effet des salves anesth&'esiantes du
M9 varie selon l'endroit du corps touch&'e.
}
//	<<<ENGLISH>>>
//	Snake, the M9's anaesthetic rounds
//	have different effects depending
//	on where it hits.

/*スネーク、Ｍ９の麻酔弾は、
敵のどこに当たったかによって
効き方が変わってくるんだ。
*/

オタコン_001: {
Si tu le touches &`a la t&^ete ou dans la r&'egion
du coeur, l'ennemi sera imm&'ediatement
assomm&'e.
}
//	<<<ENGLISH(2)>>>
//	If you manage to land them on the
//	head or the heart area, the enemy
//	will go down immediately.
//<ページ数変更>
オタコン_001_1: {
Mais si tu le touches aux mains ou aux
pieds, l'anesth&'esique agira plus lentement.
}
//	<<<ENGLISH>>>
//	If it's hands or feet, it may take
//	a while for the anaesthetic to
//	take effect.

/*頭や心臓に当てれば敵はすぐに倒れるし、
手や足だったら麻酔が効くまで
少し時間がかかる。
*/

オタコン_002: {
Essaie d'utiliser l'Observation &`a la premi&`ere
personne pour viser avec plus de
pr&'ecision.
}
//	<<<ENGLISH>>>
//	Try using the First Person View
//	to aim with higher accuracy.

/*主観攻撃でよく狙った方がいいね。
*/

}//d



//・転がり h //e
resource TO_飛び込み前転__f {
//＊ムービー t //e
オタコン_000: {
Tout en courant, appuie sur la touche
Ramper pour faire une culbute et une
roulade vers l'avant.
}
//	<<<ENGLISH>>>
//	Push the Crawl button as you're
//	running to go into a tumble and
//	a forward roll.

/*走りながら＃｛×、ホフク｝＃ボタンを押すと
飛び込み前転が出来る。
*/

オタコン_001: {
Fais-en bon usage : utilise-la pour passer
rapidement d'une cachette &`a l'autre, par
exemple.
}
//	<<<ENGLISH>>>
//	Make good use of it -- maybe
//	when you need to move from
//	cover to cover quickly?

/*物陰から物陰に素早く移動したりする
時とかにうまく使ってくれ。
*/

}//d


//・そろそろ歩き h //e
resource TO_そろそろ歩き__f {
オタコン_000: {
Si tu diminues l'angle d'inclinaison de ton
joystick analogique gauche, tu pourras
marcher plus lentement et plus
furtivement.
}
//	<<<ENGLISH>>>
//	If you tilt the left analog stick at
//	a smaller angle, you'll be able to
//	walk more slowly and stealthily.

/*左スティックの倒し具合を少しにすれば、
忍び足で歩ける。
*/

オタコン_001: {
La rapidit&'e n'est pas tout. Essaie d'adopter
ce type de marche sur les surfaces
bruyantes.
}
//	<<<ENGLISH>>>
//	Speed isn't everything.
//	Try moving over noisy
//	surfaces this way.

/*移動速度は遅くなるけど足音が
しないから、歩くと音が鳴ってしまう
床の上では役に立つはずだ。
*/

}//d


//・死体は隠さなければいけない h //e
resource TO_死体隠せ__f {
オタコン_000: {
Snake, quand tu descends un ennemi, ne
le laisse pas sur place. Ce n'est pas
recommand&'e.
}
//	<<<ENGLISH>>>
//	Snake, don't just take out enemies
//	and leave them there. That's a bad
//	idea.

/*スネーク、敵を倒してもそれだけで
安心しちゃダメだ。倒した敵を
そのままにしておくのはマズイ。
*/

オタコン_001: {
Si elles trouvent leurs copains par terre,
les sentinelles donneront s&^urement
l'alarme.
}
//	<<<ENGLISH>>>
//	Finding their dead friends on
//	the ground will probably make
//	sentries raise an alarm.

/*倒れた仲間を敵が見つけたら、
当然警戒態勢を強化するはずだからね。
*/

オタコン_002: {
Une r&'egl&'e son compte &`a un ennemi, va
cacher son cadavre.
}
//	<<<ENGLISH>>>
//	Once you've dealt with someone, put
//	the body somewhere out of sight.

/*倒した敵の体はどこか人目につかない
場所に隠した方がいい。
*/

}//d


//・死体引きずり方法 h //e
resource TO_死体引きずり方法１__f {
オタコン_000: {
Pour d&'eplacer les cadavres, tra&^ine-les.
}
//	<<<ENGLISH>>>
//	Bodies can be moved to
//	another location by dragging.

/*倒れた敵は引きずって
移動させることが出来るんだ。
*/
}


resource TO_死体引きずり方法２__f {
//＊ムービー t //e
オタコン_000: {
V&'erifie qu'aucune arme n'est s&'electionn&'ee.
Ensuite, appuie sur la touche Arme, pr&`es
du cadavre, pour le saisir.
}
//	<<<ENGLISH>>>
//	First, make sure no weapon is
//	selected. Then push the Weapon
//	button near the body to grab it.

/*やり方は、倒れた敵の体の近くで、
武器を装備せずに＃｛□、武器｝＃ボタンを押せば、
敵の体を抱える。
*/

オタコン_001: {
Il faut que tu aies le cadavre en main pour
pouvoir le tra&^iner.
}
//	<<<ENGLISH>>>
//	As long as you have a hold on the
//	body, you'll be able to drag it.
//<ページ数変更>
オタコン_001_1: {
Rel&^ache ensuite la touche Arme.
}
//	<<<ENGLISH>>>
//	Let go of the Weapon
//	button when you're done.

/*これで＃｛□、武器｝＃ボタンを押している間、
敵を引きずることが出来る。
離す時は＃｛□、武器｝＃ボタンを離せばいい。
*/
}

resource TO_死体引きずり方法３__f {
オタコン_000: {
Il est malvenu de laisser les cadavres sur
place.
}
//	<<<ENGLISH>>>
//	It's a bad idea to leave enemies
//	where they've fallen.
//<ページ数変更>
オタコン_000_1: {
Cache-les pour que personne ne puisse les
voir.
}
//	<<<ENGLISH>>>
//	Hide the bodies to make
//	sure no one sees them.

/*倒した敵をそのままにしておくのは
マズイからね。人目につかない場所に
隠すんだ。
*/

}//d



//・死体硬直 h //e
resource TO_死体硬直１__f {
オタコン_000: {
D&`es que tu as tu&'e un ennemi, je te
recommande de cacher son corps le plus
rapidement possible.
}
//	<<<ENGLISH>>>
//	I recommend you hide the enemy's
//	body as soon as you've taken them
//	down.

/*スネーク、倒した敵の体は
すぐ隠すようにした方が良い。
*/
}

/*<vc014502>*/
resource TO_死体硬直２__f {
オタコン_000: {
Les ennemis sous tranquillisant et ceux qui
sont inconscients se r&'eveilleront t&^ot ou
tard.
}
//	<<<ENGLISH>>>
//	The tranquilized and unconscious
//	enemies will wake up sooner or
//	later.
//<ページ数変更>
オタコン_000_1: {
Quant aux soldats que tu as tu&'es, ils vont
se raidir et il sera momentan&'ement
impossible de les bouger.
}
//	<<<ENGLISH>>>
//	As for soldiers you've killed,
//	the body will become too stiff
//	to move in a short while.

/*眠ったり気絶したりしてる敵はすぐに
起き上がってくるし、そうでない敵も
しばらくすると硬直して動かせなくなる。
*/

オタコン_001: {
Ne l'oublie pas !
}
//	<<<ENGLISH(2)>>>
//	Keep that in mind.

/*注意してくれ。*/
}//d


//・ロッカー死体隠し h //e
resource TO_死体ロッカー隠し__f {
//＊ムービー t //e
オタコン_000: {
Tu peux &'egalement cacher les cadavres
dans un casier m&'etallique.
}
//	<<<ENGLISH>>>
//	You can also hide the
//	enemy's body in a locker.

/*ロッカーの中に倒した敵の体を
隠すことも出来る。
*/

オタコン_001: {
Il te suffit pour cela d'ouvrir un casier et
d'y tra&^iner le cadavre.
}
//	<<<ENGLISH>>>
//	All you have to do is open the
//	locker and drag the body there.

/*やり方はロッカーを開けて、
そこまで敵の体を引きずっていけばいい。
*/

}//d

//・部位ダメージの違い（銃弾） h //e
resource TO_部位ダメージ銃１__f {
オタコン_000: {
Les munitions du pistolet et les autres
salves ont des effets diff&'erents selon
le point d'impact des balles.
}
//	<<<ENGLISH>>>
//	The handgun ammunition and other
//	live rounds have different effects
//	depending on where the bullet hits.

/*ハンドガンとかの弾は、
敵の体のどこに当たるかによって、
与えるダメージが違うんだ。
*/

オタコン_001: {
Si tu le touches &`a sa main,
l'ennemi ne pourra plus s'en servir.
}
//	<<<ENGLISH>>>
//	If you hit the hand, the enemy
//	won't be able to use it,
//<ページ数変更>
オタコン_001_1: {
Une salve dans la jambe et les pieds et il
ne pourra plus bouger.
}
//	<<<ENGLISH>>>
//	and a round to the leg and feet
//	will take away their mobility.
//<ページ数変更>
オタコン_001_2: {
Mais si tu r&'eussis &`a le toucher &`a la t&^ete ou
dans la r&'egion du coeur, l'ennemi tombera
comme une mouche.
}
//	<<<ENGLISH>>>
//	If you manage to land them on the
//	head or the heart area, the enemy
//	will go down immediately.

/*手を撃てば敵は手が使えなくなるし、
足を撃てば歩けなくなる。
頭や心臓を狙えば一発で倒せるよ。
*/
}

resource TO_部位ダメージ銃２__f {
オタコン_000: {
D&'etruis la radio sur la hanche droite de
l'ennemi, vers l'arri&`ere, pour l'emp&^echer de
demander des renforts.
}
//	<<<ENGLISH>>>
//	Destroy the radio on their right
//	hip, to the back, to prevent the
//	enemy from calling for backup.
//<ページ数変更>
オタコン_000_1: {
Pour viser avec pr&'ecision, mets-toi en
Observation &`a la premi&`ere personne.
}
//	<<<ENGLISH>>>
//	Use the First Person View when
//	you need to aim accurately.

/*腰の右後ろにある無線機を撃って壊せば、
敵が応援を呼ぶのを防ぐことも出来る。
状況に応じて、主観攻撃でよく狙うんだ。
*/
}//d


//・ビハインド覗き、ＬＲ移動 h //e
resource TO_ビハインド覗き__f {
//＊ムービー t //e
オタコン_000: {
Quand tu es en Vue en coin, appuie sur
les touches L2 ou R2 pour bouger la t&^ete
et jeter un bref coup d'&@eil dans cette
direction.
}
//	<<<ENGLISH>>>
//	Push the L2 or R2 button while in
//	Corner View to move your head and
//	take a quick look in that direction.

/*ビハインドの時にＬ２ボタンもしくは
Ｒ２ボタンを押すと物陰から頭を出して
その方向を覗き込むことが出来る。
*/

オタコン_001: {
Tu peux voir plus loin en Vue en coin,
mais tu risques davantage d'&^etre rep&'er&'e.
}
//	<<<ENGLISH>>>
//	You'll be able to see farther in
//	Corner View, but there's a greater
//	chance of being discovered.
//<ページ数変更>
オタコン_001_1: {
Ne l'oublie pas.
}
//	<<<ENGLISH>>>
//	Keep that in mind.

/*ビハインドするより遠くまで見えるけど、
頭を出すから敵に見つかりやすくなる。
そこは気をつけてくれ。
*/

}//d

//・ビハインド飛び出し（立ったまま、座ったまま） h //e
resource TO_ビハインド飛び出し１__f {
//＊ムービー t //e
オタコン_000: {
Si tu s&'electionnes une arme pendant que
tu es en Vue en coin,
}
//	<<<ENGLISH>>>
//	If you have a weapon selected
//	while in Corner View,
//<ページ数変更>
オタコン_000_1: {
appuie sur la touche Arme pour sortir de ta
cachette et viser.
}
//	<<<ENGLISH>>>
//	push the Weapon button to jump
//	out of concealment and aim your
//	weapon.

/*武器を装備してビハインドしている時に
＃｛□、武器｝＃ボタンを押すと、物陰から素早く
飛び出して武器を構えることが出来る。
*/
}


resource TO_ビハインド飛び出し２__f {
//＊ムービー t //e
オタコン_000: {
Tu peux effectuer cette man&@euvre debout
ou accroupi. &~Qa peut &^etre utile pendant les
&'echanges de tirs.
}
//	<<<ENGLISH>>>
//	You can use this while you're
//	standing or crouching. It should
//	help during gunfights.

/*立ったままでも、しゃがんだ状態でも
可能だ。銃撃戦の時にうまく使ってくれ。
*/

}//d

//・ビハインド中右スティック h //e
resource TO_ビハインド中右スティック__f {
//＊ムービー t //e
オタコン_000: {
Quand tu es en Vue en coin, actionne le
joystick analogique droit pour regarder
dans cette direction.
}
//	<<<ENGLISH>>>
//	Move the right analog stick
//	while in Corner View to look
//	in that direction.

/*ビハインド中に右スティックを動かせば
その方向を伺うことが出来る。
*/

オタコン_001: {
A la diff&'erence des touches L2 et R2,
}
//	<<<ENGLISH(2)>>>
//	The difference between this
//	and using L2 and R2 buttons
//<ページ数変更>
オタコン_001_1: {
cette man&@euvre te prot&`ege
des &'eventuels tirs ennemis.
}
//	<<<ENGLISH>>>
//	is that you won't be exposing
//	yourself to possible enemy fire.
//<ページ数変更>
オタコン_001_2: {
Mais ton angle de vision est
n&'eanmoins plus limit&'e.
}
//	<<<ENGLISH>>>
//	At the same time, because
//	you are staying in the same
//	position,
//<ページ数変更>
オタコン_001_3: {
Mais ton angle de vision est n&'eanmoins
plus limit&'e.
}
//	<<<ENGLISH>>>
//	your range of vision
//	is more limited.

/*Ｌ２ボタン、Ｒ２ボタンの覗き込みと
違って体を乗り出さないぶん安全だ。
見える範囲は少なくなるけどね。
*/

}//d

//・影が見つかること h //e
resource TO_影伸び１__f {
//＊ムービー t //e
オタコン_000: {
Snake, dans certains endroits, la lumi&`ere
allonge ton ombre et la rend plus facile &`a
rep&'erer.
}
//	<<<ENGLISH>>>
//	Snake, in some locations, the
//	lighting makes your shadow
//	longer and more noticeable.

/*スネーク、照明の具合によっては
影が大きく伸びてしまう場所がある。
そういう所では、影にも注意してくれ。
*/
}


resource TO_影伸び２__f {
オタコン_000: {
L'ennemi risque de voir ton ombre, prends
garde.
}
//	<<<ENGLISH>>>
//	The enemy might spot your shadow,
//	so you'll want to watch out.
//<ページ数変更>
オタコン_000_1: {
Les tournants et les coins sont
particuli&`erement dangereux.
}
//	<<<ENGLISH>>>
//	Turns and corners are
//	especially dangerous.

/*伸びた影を敵に見つけられてしまう
ことがあるかもしれないからね。
特に曲がり角では気をつけた方が良い。
*/

オタコン_001: {
L'ennemi a le m&^eme probl&`eme. Si tu voies
l'ombre de quelqu'un s' avancer, ne prends
pas de risques inutiles.
}
//	<<<ENGLISH>>>
//	But the same holds for the enemy.
//	If you spot someone's shadow ahead,
//	you can avoid unnecessary risks.

/*でも、敵の影も同じように伸びるから、
人影を見つけたら近づかないように
すれば無用な危険をさけられるはずだ。
*/

}//d

//・不審物で見つかる（壊れ物） h //e
resource TO_不審物__f {
//＊ムービー t //e
オタコン_000: {
Ne casse rien, si possible. Tout signe
d'infiltration risque d'&'eveiller les soup&~qons
de l'ennemi.
}
//	<<<ENGLISH>>>
//	Don't break things if you can help
//	it. Any sign of infiltration will
//	put the enemy on a lookout.
//<ページ数変更>
オタコン_000_1: {
Sois prudent.
}
//	<<<ENGLISH>>>
//	Exercise caution.

/*物はあまり壊したりしない方がいい。
潜入の痕跡を発見されると、当然敵に
警戒されるからね。気をつけてくれ。
*/

}//d


//・探索モード h //e
resource TO_探索モード__f {
オタコン_000: {
M&^eme si tu r&'eussis &`a semer l'ennemi,
}
//	<<<ENGLISH>>>
//	Even if you've successfully thrown
//	the enemy off your trail,
//<ページ数変更>
オタコン_000_1: {
ne baisse la garde d&`es lors que quelqu'un
t'a rep&'er&'e.
}
//	<<<ENGLISH>>>
//	don't ever relax your guard
//	once you've been spotted.

/*一度見つかったら、例え逃げ切っても
安心しちゃダメだ。
*/

オタコン_001: {
Ils te chercheront et la s&'ecurit&'e sera
renforc&'ee.
}
//	<<<ENGLISH>>>
//	They'll be looking for you,
//	and security will be tighter.
//<ページ数変更>
オタコン_001_1: {
Ne sous-estime pas &`a quoi tu
t'affrontes.
}
//	<<<ENGLISH>>>
//	Don't underestimate what
//	you're up against.

/*敵は君を探して警戒を強化するはず
だからね。注意してくれ。
*/
//＠探索モード仕様 //e

}//d

//・クリアリング（初クリアリングは強制ＣＡＬＬ？） h //e
resource TO_クリアリング１__f {
//ＣＡＬＬ時 t //e
オタコン_000: {
Snake, cache-toi imm&'ediatement ! Des
groupes de recherche ennemis sont en
route. C'est une Evacuation.
}
//	<<<ENGLISH>>>
//	Snake, get yourself out of sight
//	now! Enemy search parties are
//	on the way. It's a Clearing.

/*スネーク、早くどこかに隠れるんだ！
敵は君を徹底的に探し出そうとしてる。
クリアリングだ。
*/
}


resource TO_クリアリング２__f {
オタコン_000: {
Tu n'as pas affaire &`a des sentinelles.
}
//	<<<ENGLISH>>>
//	These aren't sentries
//	you're dealing with;
//<ページ数変更>
オタコン_000_1: {
Ils te cherchent et savent pertinemment
que tu veux leur &'echapper.
}
//	<<<ENGLISH>>>
//	they're searching for you, and they
//	know you don't want to be found.

/*敵が呼んだ増援部隊は一度侵入者を
見失っても簡単にはあきらめない。君が
隠れていそうな場所まで探しに来るんだ。
*/

オタコン_001: {
Creuse-toi la t&^ete pour trouver une bonne
cachette.
}
//	<<<ENGLISH>>>
//	You can't make some feeble
//	attempt at concealment.
//<ページ数変更>
オタコン_001_1: {
Assure-toi que tu es parfaitement cach&'e &`a
un endroit qu'ils n'auront pas l'id&'ee
d'inspecter.
}
//	<<<ENGLISH>>>
//	Make sure you're completely hidden
//	in some place they wouldn't think
//	of searching.

/*中途半端な隠れ方じゃ見つかってしまう。
どこか見つかりにくい場所に
身を隠すんだ。いいね。
*/
//＠クリアリング仕様。見つかる条件。 //e

}//d


//・銃撃戦の戦い方 h //e
resource TO_銃撃戦１__f {
オタコン_000: {
Si tu es rep&'er&'e et que cela d&'eg&'en&`ere en
&'echange de tirs,
}
//	<<<ENGLISH>>>
//	If you're spotted and it comes
//	down to an exchange of gunfire,
//<ページ数変更>
オタコン_000_1: {
ne reste pas &`a d&'ecouvert. Couvre-toi le
plus vite possible.
}
//	<<<ENGLISH>>>
//	don't stand out in the
//	open. Find cover ASAP.

/*万一、敵に見つかって銃撃戦になったら
遮蔽物に隠れながら戦うんだ。無防備に
体をさらしてはいけない。
*/
}


//＊ムービー t //e
resource TO_銃撃戦２__f {
オタコン_000: {
Mitraille l'ennemi en te hissant sur tes
pieds, depuis ta cachette, pour bien viser
ta cible.
}
//	<<<ENGLISH>>>
//	Strafe and stretch up from your
//	concealed position to get a good
//	shot on target
//<ページ数変更>
オタコン_000_1: {
Pour cela, mets-toi en Observation &`a la
premi&`ere personne.
}
//	<<<ENGLISH>>>
//	while in First Person View.

/*隠れながら左右ステップや伸び上がりを
使って主観攻撃で応戦してくれ。
*/

オタコン_001: {
S'ils arrivent en masse, tu ne pourras pas
les repousser, tout Snake que tu es.
}
//	<<<ENGLISH(2)>>>
//	But if they come at you in droves,
//	even you won't be able to fend
//	them off.
//<ページ数変更>
オタコン_001_1: {
Evite &`a tout prix de te faire rep&'erer.
}
//	<<<ENGLISH>>>
//	You need to avoid
//	discovery at all costs.

/*でも一度に大勢で来られたら、
いくら君でも太刀打ち出来ないだろう。
見つからないのが一番だからね。
*/

}//d


//・敵の無線連絡 h //e
resource TO_敵の無線連絡１__f {
//＊ムービー
オタコン_000: {
D&`es qu'un soldat ennemi t'aura rep&'er&'e, il
demandera des renforts par radio.
}
//	<<<ENGLISH>>>
//	As soon as you're spotted by
//	an enemy soldier, he'll call for
//	backup on his radio.
//<ページ数変更>
オタコン_000_1: {
Apr&`es quoi tu auras une meute &`a tes
trousses.
}
//	<<<ENGLISH>>>
//	The search party that's going to
//	show up as a result is a tough
//	bunch.

/*敵は君を見つけると無線で仲間を呼ぶ。
それでやって来る増援部隊はかなり
手強いはずだ。
*/
}


resource TO_敵の無線連絡２__f {
//＊ムービー t //e
オタコン_000: {
Tout d'abord, ils ont de meilleurs
&'equipements que toi, dont un gilet d'armes.

}
//	<<<ENGLISH>>>
//	For one thing, they have better
//	equipment, like body armor.
//<ページ数変更>
オタコン_000_1: {
Mais surtout, ils ont re&~qu une formation
pouss&'ee en recherche et annihilation.
}
//	<<<ENGLISH>>>
//	But the main thing is that they're
//	highly trained in search-and-
//	destroy types of activities.

/*＃｛防弾衣、ボディ・アーマー｝＃とか、一般の兵士よりも
上の装備も持ってるし、何より彼らは
戦闘馴れしている。
*/

オタコン_001: {
Ils d&'ebarquerons et attaqueront en groupe.
N'essaie pas de les prendre de front.
}
//	<<<ENGLISH>>>
//	They'll come as a team and attack
//	as a team. Don't try to take them
//	straight on.

/*チームで攻撃してくるから、
いくら君でも一人でまともに
やりあうのは危ないと思う。
*/
}


resource TO_敵の無線連絡３の１__f {
オタコン_000: {
Si tu te fais rep&'erer, tu dois emp&^echer la
sentinelle d'appeler des renforts.
}
//	<<<ENGLISH>>>
//	If you're spotted, you need to stop
//	the sentry from calling for backup.

/*万一敵に見つかったら、
仲間を呼ばれないようにした方が良いね。
*/
}


resource TO_敵の無線連絡３の２__f {
オタコン_000: {
Descends la sentinelle avant qu'elle ait le
temps de faire un appel radio.
}
//	<<<ENGLISH>>>
//	Take him down before he has
//	the chance to use the radio.

/*無線で仲間を呼ぶ前にその敵を倒せば、
増援部隊とは戦わずに済むはずだ。
*/
}



resource TO_敵の無線連絡４__f {
オタコン_000: {
Tu peux &'egalement faire sauter la grenade
chaff pour brouiller la transmission ＃－
}
//	<<<ENGLISH>>>
//	You can also break out the chaff
//	grenade and interfere with the
//	message transmission
//<ページ数変更>
オタコン_000_1: {
et emp&^echer la diffusion des alertes.
}
//	<<<ENGLISH>>>
//	to prevent any alerts
//	from being issued.

/*チャフ・グレネードを使って無線を
妨害しても、敵が応援を呼ぶのを
防げる。
*/
}


resource TO_敵の無線連絡５__f {
//＊ムービー t //e
オタコン_000: {
Si tu d&'etruis la radio, la sentinelle ne
pourra pas demander de l'aide.
}
//	<<<ENGLISH>>>
//	If you take out the radio,
//	the sentry will have no way
//	of calling for help.

/*無線機を壊せば敵は応援を呼べなくなる
はずだ。
*/

オタコン_001: {
Les radios se portent derri&`ere la hanche
droite. Tu devrais pouvoir les d&'egommer
en Observation &`a la premi&`ere personne.
}
//	<<<ENGLISH>>>
//	Radios are worn behind the right
//	hip. You should be able to target
//	it in First Person View.

/*敵は無線機を腰の右後ろにつけてる。
主観攻撃で狙えば撃ち抜けるだろう。
*/
}


resource TO_敵の無線連絡６__f {
オタコン_000: {
Si la sentinelle r&'eussit &`a demander des
renforts, cache-toi avant qu'ils n'arrivent.
}
//	<<<ENGLISH>>>
//	If he does manage to call for backup,
//	get yourself in deep hiding before
//	they arrive.

/*もしも仲間を呼ばれてしまったら、
増援部隊が到着する前に隠れた方が
いいね。
*/

}//d


//・増援部隊強い h //e
resource TO_増援部隊__f {
オタコン_000: {
Les renforts portent tous un gilet d'armes.
}
//	<<<ENGLISH>>>
//	The reinforcements are
//	all wearing body armor.
//<ページ数変更>
オタコン_000_1: {
Tu devras tirer plusieurs fois avant de
pouvoir endommager les parties du corps
ainsi prot&'eg&'ees.
}
//	<<<ENGLISH>>>
//	It'll take several shots before
//	the rounds do any damage to
//	the protected regions of the body.

/*敵の増援部隊は＃｛防弾衣、ボディ・アーマー｝＃を着てる。
＃｛防弾衣、ボディ・アーマー｝＃で守られてる部分は何発か当て
なければダメージを与えられないんだ。
*/

オタコン_001: {
Mais il suffit de tirer une bonne fois dans
la t&^ete. Pour bien viser, mets-toi en
Observation &`a la premi&`ere personne
d'attaque.
}
//	<<<ENGLISH>>>
//	But only a single head shot
//	is needed. Aim well while
//	attacking in First Person View.

/*でも頭を狙えば一発だ。
主観攻撃で頭を狙ってくれ。
*/

}//d


//・ヒドゥンポイントの説明 h //e
resource TO_ヒドゥンポイント__f {
オタコン_000: {
Tu te feras moins rep&'erer dans l'obscurit&'e.
}
//	<<<ENGLISH>>>
//	You'll be less likely to
//	be spotted in the dark.
//<ページ数変更>
オタコン_000_1: {
Mais &~qa ne marchera pas pendant les
&'evacuations. Trouve autre chose!
}
//	<<<ENGLISH>>>
//	But this won't work during
//	a Clearing, so I recommend
//	you try something else.

/*暗がりにいれば、敵も君を見つけにくい
はずだ。でもクリアリングの時は
見つかってしまうから気をつけてくれよ。
*/
//＠ヒドゥンって暗いところで見つかる？ //e
}
/**/


//・マガジン投げ(持ってる時のみ) h //e
resource TO_マガジン投げ__f {
//＊ムービー t //e
オタコン_000: {
S&'electionne le chargeur et lance-le &`a l'aide
de la touche Arme.
}
//	<<<ENGLISH>>>
//	Select the magazine and throw
//	it using the Weapon button.
//<ページ数変更>
オタコン_000_1: {
Le bruit de sa chute attirera les soldats
ennemis vers lui.
}
//	<<<ENGLISH>>>
//	The noise will draw enemy
//	soldiers toward wherever
//	the magazine lands.

/*マガジンは装備して＃｛□、武器｝＃ボタンで
投げられるんだ。マガジンが床に落ちた
時の音で敵をおびき寄せたり出来る。
*/

オタコン_001: {
La force d'actionnement de la touche
d&'eterminera la longueur de la trajectoire du
chargeur.
}
//	<<<ENGLISH(2)>>>
//	How strong you push the button
//	determines how large a swing
//	you take.
//<ページ数変更>
オタコン_001_1: {
Mets-toi en Observation &`a la premi&`ere
personne et essaie de lancer le chargeur le
plus loin possible de toi.
}
//	<<<ENGLISH>>>
//	Take aim using First Person View
//	and try to land it where it will lure
//	the enemy away.

/*＃｛□、武器｝＃ボタンを押す強さで投擲距離が変わる。
主観攻撃で狙って、うまく敵を誘導
出来るポイントへ落とすんだ。
*/

}//d

resource TO_ホールドアップ__f {
//＊ムービー t //e
オタコン_000: {
Pour maintenir un ennemi &`a vue,
approche-toi de lui par derri&`ere apr&`es avoir
pr&'epar&'e ton pistolet.
}
//	<<<ENGLISH(2)>>>
//	You can hold someone at gunpoint
//	by getting behind his back with your
//	gun ready.
//<ページ数変更>
オタコン_000_1: {
Apr&`es cela, il t'incombe de d&'ecider du sort
des otages n'opposant aucune r&'esistance.
}
//	<<<ENGLISH>>>
//	What you choose to do with a
//	hostage making no resistance
//	after that is up to you.

/*敵の後ろから銃を突き付ければ、敵を
ホールドアップさせられる。その後、
無抵抗の相手をどうするかは君次第だ。
*/
}//d


//・懸垂で握力アップ後 ＣＡＬＬ？ h //e
resource TO_懸垂握力アップ後__f {
オタコン_000: {
Bravo, Snake ! On dirait que ces pompes
ont servi &`a quelque chose ! Ta force de
prise augmente !
}
//	<<<ENGLISH>>>
//	Congrats, Snake! Looks like those
//	pull-ups were worth it. Your grip
//	strength is up!

/*スネーク、おめでとう！
懸垂で体を鍛えた甲斐があったね。
握力が上がったよ！！
*/

}//d




//○前からある仕様 d //e
//・武器・アイテム装備方法 d //e
resource TO_武器装備品装備法１__f {
オタコン_000: {
Pour t'&'equiper d'une arme, appuie sur la
touche R2 pour passer en mode Arme.
}
//	<<<ENGLISH>>>
//	When you need to arm yourself with
//	a weapon, push down on the R2
//	button to enter the Weapon mode.

/*武器を装備するには、まず、
Ｒ２ボタンを押しっぱなしにして
武器モードにするんだ。
*/

オタコン_001: {
Tu vois ces ic&^ones d'armes ?
}
//	<<<ENGLISH(2)>>>
//	You see those weapon icons?
//<ページ数変更>
オタコン_001_1: {
Pour en s&'electionner une, actionne
le joystick analogique gauche vers
le haut et vers ＃－
}
//	<<<ENGLISH>>>
//	Select the one you want by moving
//	the left analog stick up and down...
//<ページ数変更>
オタコン_001_2: {
le bas jusqu'&`a ce que tu voies la m&^eme
ic&^one que celle en bas, &`a droite.
}
//	<<<ENGLISH>>>
//	and matching up the icon
//	to the lower right spot.

/*武器のアイコンが表示されるだろ。
その中から使いたい武器を左スティック
の上下で選んで右下に合わせるんだ。
*/

オタコン_002: {
Si tu poss&`edes plusieurs armes du m&^eme
type, elles seront toutes affich&'ees en rang.
}
//	<<<ENGLISH>>>
//	If you have several weapons
//	of the same type, they'll be
//	displayed in a row.

/*同じ系統の武器をいくつか持っている
時はアイコンが横に並んで表示される。
*/

オタコン_003: {
S&'electionne celle que tu veux en
actionnant le joystick analogique gauche
vers la droite ＃－
}
//	<<<ENGLISH>>>
//	Select the one you want by
//	moving the left analog stick
//	right and left
//<ページ数変更>
オタコン_003_1: {
ou vers la gauche et en pla&~qant l'ic&^one tout
&`a droite.
}
//	<<<ENGLISH>>>
//	and placing the icon
//	to the far right spot.

/*その中から使いたい武器を
左スティックの左右で一番右に
合わせてくれ。
*/

オタコン_004: {
Pour t'&'equiper de cette arme, rel&^ache
ensuite la touche R2.
}
//	<<<ENGLISH(2)>>>
//	Then let go of the R2 button to
//	arm yourself with the weapon.

/*そこでＲ２ボタンを離せば、
その武器を装備出来るってわけさ。
*/

オタコン_005: {
Si tu veux tout savoir sur l'utilisation d'une
arme,
}
//	<<<ENGLISH(2)>>>
//	If you need to know the finer points
//	of using each of the weapons,
//<ページ数変更>
オタコン_005_1: {
consulte la fen&^etre de guidage.
}
//	<<<ENGLISH>>>
//	just take a look at the
//	guidance window.

/*それぞれの武器の詳しい使い方は
ウィンドウの中の説明を読んでくれ。
*/
}


resource TO_武器装備品装備法２__f {
オタコン_000: {
Pour s&'electionner des objets tels que des
rations,
}
//	<<<ENGLISH(2)>>>
//	If it's items, like rations,
//	that you need to select,
//<ページ数変更>
オタコン_000_1: {
par exemple, proc&`ede de m&^eme, mais avec
la touche L2.
}
//	<<<ENGLISH>>>
//	just follow the same procedure,
//	but with the L2 button.

/*レーションとかの装備品を
装備したい時はＬ２ボタンで
同じことをすればいい。
*/

}//d

resource TO_武器装備品装備法従来型１__f {
オタコン_000: {
Pour t'&'equiper d'une arme, maintiens la
touche R2 enfonc&'ee pour passer en mode
Arme.
}
//	<<<ENGLISH>>>
//	When you need to arm yourself with
//	a weapon, hold down on the R2 button
//	to enter the Weapon mode.

/*武器を装備するには、まず、
Ｒ２ボタンを押しっぱなしにして
武器モードにするんだ。
*/

オタコン_001: {
Tu vois ces ic&^ones d'armes ?
}
//	<<<ENGLISH(2)>>>
//	You see those weapon icons?
//<ページ数変更>
オタコン_001_1: {
Pour en s&'electionner une, actionne le
joystick analogique gauche vers le haut et
le bas jusqu'&`a ce que ＃－
}
//	<<<ENGLISH>>>
//	Select the one you want by moving
//	the left analog stick up and down...
//<ページ数変更>
オタコン_001_2: {
tu voies la m&^eme ic&^one que celle qui se
trouve en bas, &`a droite.
}
//	<<<ENGLISH>>>
//	and matching up the icon
//	to the lower right spot.

/*武器のアイコンが表示されるだろ。
その中から使いたい武器を左スティック
の上下で選んで右下に合わせるんだ。
*/

オタコン_002: {
Rel&^ache ensuite la touche R2 pour
t'&'equiper de l'arme.
}
//	<<<ENGLISH(2)>>>
//	Then let go of the R2 button to
//	arm yourself with the weapon.

/*そこでＲ２ボタンを離せば、
その武器を装備出来るってわけさ。
*/

オタコン_003: {
Si tu veux tout savoir sur l'utilisation d'une
arme,
}
//	<<<ENGLISH(2)>>>
//	If you need to know the finer points
//	of using each of the weapons,
//<ページ数変更>
オタコン_003_1: {
consulte la fen&^etre de guidage.
}
//	<<<ENGLISH>>>
//	just take a look at the
//	guidance window.

/*それぞれの武器の詳しい使い方は
ウィンドウの中の説明を読んでくれ。
*/

}
/**/

resource TO_武器装備品装備法従来型２__f {
オタコン_000: {
Pour s&'electionner des objets tels que des
rations,
}
//	<<<ENGLISH(2)>>>
//	If it's items like rations
//	that you need to select,
//<ページ数変更>
オタコン_000_1: {
par exemple, proc&`ede de m&^eme,
mais avec la touche L2.
}
//	<<<ENGLISH>>>
//	just follow the same procedure,
//	but with the L2 button.

/*レーションとかの装備品を
装備したい時はＬ２ボタンで
同じことをすればいい。
*/

}


//・無線ＣＡＬＬ。一度も任意ＣＡＬＬ受信していない時 h //e
resource TO_無線ＣＡＬＬ__f {
オタコン_000: {
Snake, quand j'aurai quelque chose
d'urgent &`a te dire, je te pr&'eviendrai par le
Codec.
}
//	<<<ENGLISH>>>
//	Snake, when I have something
//	urgent to tell you, I'll raise you
//	on the Codec.

/*スネーク、僕の方から緊急に伝えたい
ことがある場合はＣＡＬＬする。
*/

オタコン_001: {
Quand tu voies le signe de CALL,
appuie sur la touche SELECT
pour recevoir, d'accord ?
}
//	<<<ENGLISH>>>
//	When you see the CALL sign, hit
//	the SELECT button to receive,
//	all right?

/*ＣＡＬＬサインが出たら、
ＳＥＬＥＣＴボタンを押して
受信するんだ。いいね。
*/

}//d


//・パンチ・キック h //e
resource TO_パンチキック__f {
//＊ムービー t //e
オタコン_000: {
Snake, une fois que tu es assez pr&`es de
l'ennemi pour combattre au corps &`a corps,
ne te sers plus de tes armes.
}
//	<<<ENGLISH(2)>>>
//	Snake, once you get close enough
//	for Close Quarters Combat, forget
//	the weapons.
//<ページ数変更>
オタコン_000_1: {
Appuie sur la touche Coup de poing pour
d&'ecocher un coup de poing. Apr&`es tout,
c'est une m&'ethode efficace et peu
bruyante.
}
//	<<<ENGLISH>>>
//	Push the Punch button to take
//	a swing; punching is an effective,
//	noiseless way to take out enemies.

/*スネーク、接近戦になったら格闘だ。
＃｛○、パンチ｝＃ボタンでパンチが出せる。
音を立てずに攻撃出来るはずだ。
*/

オタコン_001: {
Appuie plusieurs fois sur la touche Coup
de poing pour combiner des attaques et
rouer l'adversaire de coups.
}
//	<<<ENGLISH>>>
//	Hit the Punch button repeatedly to
//	unleash combo attacks and pummel
//	the enemy.
//<ページ数変更>
オタコン_001_1: {
Tu peux aussi utiliser l'Observation &`a la
premi&`ere personne.
}
//	<<<ENGLISH>>>
//	You can also use the
//	First Person View.

/*＃｛○、パンチ｝＃ボタンを連打すれば＃｛連続技、コンボ｝＃になって
敵を吹き飛ばせるし、主観攻撃も出来る。
*/

オタコン_002: {
De toute &'evidence, tu auras tout &`a gagner
&`a &'eviter ce genre de confrontation.
}
//	<<<ENGLISH>>>
//	Of course, the biggest favor you
//	can do yourself is to avoid getting
//	in melee situations altogether.

/*でも一番いいのは、接近戦になるような
局面はさけることだ。
*/

}//d

//・投げ h //e
resource TO_投げ__f {
//＊ムービー t //e
オタコン_000: {
Tant que tu n'as pas d'arme s&'electionn&'ee,
}
//	<<<ENGLISH>>>
//	As long as you have
//	no weapons selected,
//<ページ数変更>
オタコン_000_1: {
tu peux balancer l'ennemi &`a l'aide
de la touche Arme et du joystick
analogique gauche.
}
//	<<<ENGLISH>>>
//	you can throw an enemy with
//	the Weapon button and the left
//	analog stick.
//<ページ数変更>
オタコン_000_2: {
Pour ce faire, approche-toi de lui et
actionne ces commandes en m&^eme temps.
}
//	<<<ENGLISH>>>
//	Just get in close and hit these
//	controls at the same time.

/*武器を装備していない時は投げ技が使え
る。やり方は敵の近くで左スティックを
入れながら＃｛□、武器｝＃ボタンを押せばいい。
*/

オタコン_001: {
Ils se retrouveront ensuite au sol et tu
pourras peut-&^etre leur d&'ecocher un coup
fatal.
}
//	<<<ENGLISH>>>
//	They'll be down on the ground
//	afterwards, and you may even
//	able to knock them unconscious.

/*敵を地面に倒せるし、うまくすれば
気絶させることも出来るはずだ。
*/

}//d


//・首絞め h //e
resource TO_首締め１__f {
//＊ムービー t //e
オタコン_000: {
Si tu n'es pas arm&'e, tu peux &'egalement
pratiquer l'&'etranglement.
}
//	<<<ENGLISH>>>
//	The other attack option when
//	you're unarmed is the chokehold.

/*スネーク、武器を装備していない時は、
投げ技の他にも敵の首を絞めることが
出来る。
*/
}


resource TO_首締め２__f {
オタコン_000: {
Approche-toi de l'ennemi par derri&`ere et
appuie sur la touche Arme ＃－
}
//	<<<ENGLISH>>>
//	Move in close to the enemy
//	from behind and push the
//	Weapon button
//<ページ数変更>
オタコン_000_1: {
sans actionner le joystick analogique
gauche.
}
//	<<<ENGLISH>>>
//	without moving the
//	left analog stick.

/*首を絞めるには、敵の後ろから
近づいて左スティックを入れずに
＃｛□、武器｝＃ボタンを押すんだ。
*/

オタコン_001: {
Appuie plusieurs fois sur la touche Arme
pour lui briser le cou.
}
//	<<<ENGLISH>>>
//	Hit the Weapon button repeatedly
//	to break the enemy's neck.
//<ページ数変更>
オタコン_001_1: {
Maintiens la touche enfonc&'ee pour te
d&'eplacer et le tra&^iner.
}
//	<<<ENGLISH>>>
//	Keep it pushed down if you want
//	to move around and drag him away
//	with you.

/*そのまま＃｛□、武器｝＃ボタンを連打すれば、
敵を倒せる。押しっぱなしにすれば
敵を引きずって移動することも出来る。
*/
}


resource TO_首締め３__f {
オタコン_000: {
N'oublie pas que cette man&@euvre doit &^etre
accomplie par derri&`ere.
}
//	<<<ENGLISH>>>
//	Remember, you can only
//	do this from the back.
//<ページ数変更>
オタコン_000_1: {
Il est impossible de faire une prise
d'&'etranglement face &`a l'ennemi.
Fais attention.
}
//	<<<ENGLISH>>>
//	You can't perform a chokehold
//	while facing someone. Be careful.

/*でも気をつけてくれ。敵の正面からじゃ
首は絞められない。首絞めを仕掛ける
時は必ず相手の後ろに回りこむんだ。
*/

}//d


//・壁コンコン h //e
resource TO_張り付きコンコン１__f {
//＊ムービー t //e
オタコン_000: {
Actionne le joystick analogique gauche
dans la direction du mur et maintiens-le en
place pour te plaquer contre le mur.
}
//	<<<ENGLISH(2)>>>
//	Move the left analog stick in the
//	direction of a wall and keep it there
//	to flatten yourself against the wall.

/*壁の方向に向かって左スティックを
押しっぱなしにすると、壁に張り付ける。
*/
}

resource TO_張り付きコンコン２__f {
//＊ムービー t //e
オタコン_000: {
Appuie sur la touche Coup pour donner
un coup dans le mur et faire diversion.
}
//	<<<ENGLISH>>>
//	Push the Punch button while in
//	that position to knock on the
//	wall and create a diversion.

/*壁に張り付いている時に＃｛○、パンチ｝＃ボタンを
押せば、壁を叩いて物音を立てることが
出来るんだ。
*/
}


resource TO_張り付きコンコン３__f {
//＊ムービー t //e
オタコン_000: {
Si tu t'y prends bien, tu parviendras
peut-&^etre &`a faire partir les sentinelles de
leurs postes.
}
//	<<<ENGLISH(2)>>>
//	If you plan carefully, you'll
//	be able to lure sentries away
//	from their posts.

/*うまくやれば持ち場から動こうとしない
敵をおびき寄せたりすることも出来る
はずだ。
*/

}//d



//・普通のビハインド h //e
resource TO_普通のビハインド１__f {
//＊ムービー t //e
オタコン_000: {
Lorsque tu es plaqu&'e contre une surface
derri&`ere un coin, tu es en Vue en coin.
}
//	<<<ENGLISH(2)>>>
//	When you're flattened against a
//	surface behind a corner, you're
//	in Corner View.
//<ページ数変更>
オタコン_000_1: {
Tu peux alors voir au-del&`a du coin.
}
//	<<<ENGLISH>>>
//	You'll be able to survey the area
//	without exposing yourself.

/*物陰の角に張り付くとビハインドモード
になる。自分は隠れながら曲がり角の
先とかを覗くことが出来るんだ。
*/
}


resource TO_普通のビハインド２__f {
//＊ムービー t //e
オタコン_000: {
La Vue en coin permet de jeter un coup
d'&@eil vers l'avant, avec les touches L2
et R2,
}
//	<<<ENGLISH>>>
//	The Corner View lets you take a look
//	ahead with the L2 and R2 buttons,
//<ページ数変更>
オタコン_000_1: {
ou de sauter hors de ta cachette, apr&`es
avoir pr&'epar&'e ton arme.
}
//	<<<ENGLISH>>>
//	or you can jump out with
//	your weapon ready.

/*ビハインドモードからはＬ２ボタン、
Ｒ２ボタンで覗き込みをしたり、
武器を構えて飛び出したり出来る。
*/

オタコン_001: {
Sache en tirer parti.
}
//	<<<ENGLISH>>>
//	Take advantage of
//	all the action.

/*うまく使ってくれ。
*/

}//d


//・イントルード h //e
resource TO_イントルード１__f {
オタコン_000: {
Utilise l'option Ramper pour te glisser sous
des bureaux et d'autres objets.
}
//	<<<ENGLISH>>>
//	Use Crawl to get under
//	desks and other objects.
//<ページ数変更>
オタコン_000_1: {
En espace clos, tu es en Point de vue
d'intrusion.
}
//	<<<ENGLISH>>>
//	Once you're in enclosed space,
//	you'll be in Intrusion View.

/*机の下とかにはホフクで潜り込める。
そうやって狭い所に入り込んだ時は
イントルードモードになるんだ。
*/
}


resource TO_イントルード２__f {
オタコン_000: {
En Point de vue d'intrusion, actionne le
joystick analogique gauche vers le haut
pour avancer l'avant,
}
//	<<<ENGLISH>>>
//	In Intrusion View, you move forward
//	with the left analog stick Up, back
//	with Down,
//<ページ数変更>
オタコン_000_1: {
vers le bas pour reculer et vers la gauche
ou la droite pour aller dans ces directions.
}
//	<<<ENGLISH>>>
//	and left or right with the
//	corresponding directions.

/*イントルードモードの時は
左スティックの上で前進、下で後退、
左右でその方向を向く。
*/

オタコン_001: {
Pour regarder autour de toi ou viser avec
pr&'ecision, appuie sur la touche
'Observation &`a la premi&`ere personne'.
}
//	<<<ENGLISH>>>
//	Use the First Person View button
//	to take a look around or aim with
//	precision.

/*主観ボタンを使えばまわりを見渡せるし、
銃を撃つことも出来る。
*/
}


resource TO_イントルード３__f {
オタコン_000: {
Si quelqu'un rep&`ere ta cachette, tu risques
de te faire attaquer.
}
//	<<<ENGLISH>>>
//	But if someone catches sight of
//	you while you hide, you could be
//	attacked.
//<ページ数変更>
オタコン_000_1: {
L'intrusion ne te prot&'egera pas contre les
&'evacuations non plus.
}
//	<<<ENGLISH>>>
//	It's no guarantee against
//	a Clearing either.

/*でも隠れるところを敵に見られたら
攻撃されることもあるし、クリアリング
の時は見つかってしまうこともある。
*/

オタコン_001: {
L'intrusion n'offre pas de protection
absolue. Ne l'oublie pas.
}
//	<<<ENGLISH>>>
//	Entering Intrusion state doesn't
//	mean you're absolutely safe.
//	Keep that in mind.

/*イントルードに逃げ込めば
安全ってわけじゃないってことだ。
気をつけてくれ。
*/

}//d


//・匍匐 h //e
resource TO_ホフク１__f {
//＊ムービー t //e
オタコン_000: {
Snake, appuie sur la touche Ramper pour
t'accroupir.
}
//	<<<ENGLISH(2)>>>
//	Snake, push the Crawl button
//	to crouch down.
//<ページ数変更>
オタコン_000_1: {
Fais ce geste chaque fois que tu te caches
derri&`ere des objets bas.
}
//	<<<ENGLISH>>>
//	You'll definitely need it when
//	you're taking cover behind low
//	objects.

/*スネーク、＃｛×、ホフク｝＃ボタンを押すとしゃがむ
ことが出来る。低い遮蔽物に隠れる時は
しゃがまなきゃダメだ。
*/
}


resource TO_ホフク２__f {
//＊ムービー t //e
オタコン_000: {
Une fois accroupi, appuie sur le joystick
analogique gauche pour ramper dans cette
direction.
}
//	<<<ENGLISH>>>
//	Use the left analog stick while
//	you're crouching to crawl in
//	that direction.
//<ページ数変更>
オタコン_000_1: {
Pour te relever debout, appuie de nouveau
sur la touche Ramper.
}
//	<<<ENGLISH>>>
//	Push the Crawl button
//	again to stand up.

/*しゃがんでる時に左スティックを押すと、
その方向にホフクする。立ち上がるには
もう一度＃｛×、ホフク｝＃ボタンを押せばいい。
*/
}


resource TO_ホフク３__f {
//＊ムービー t //e
オタコン_000: {
Tu as tout int&'er&^et &`a ramper quand tu veux
te d&'eplacer sans faire de bruit ou quand tu
veux passer sous un objet.
}
//	<<<ENGLISH>>>
//	Crawling is your best bet when you
//	need to move silently, or get under
//	something.

/*足音を立てたくない時や、机の下とかに
潜り込みたい時はホフクすればいい。
*/
}


resource TO_ホフク４__f {
オタコン_000: {
Tu peux utiliser ton pistolet en position
couch&'ee. Cela est utile pour les attaques
furtives.
}
//	<<<ENGLISH>>>
//	You can fire a handgun from
//	prone position. It's a good
//	stealth attack.

/*ハンドガンならホフクしながらでも
撃つことが出来る。隠れながら攻撃
したい時には役立つと思う。
*/

}//d

//・アイテムボックス h //e
resource TO_アイテムボックス１__f {
オタコン_000: {
Chaque fois que tu vois une Bo&^ite d'objets,
je te conseille de la prendre.
}
//	<<<ENGLISH>>>
//	Whenever you see an Item
//	Box, you should acquire it.
//<ページ数変更>
オタコン_000_1: {
Rapproche-toi pour voir ce que c'est.
}
//	<<<ENGLISH>>>
//	Take a closer look to
//	see what the Item is.

/*アイテムボックスを見かけたら
入手した方が良い。何のアイテムかは、
よく見れば書いてあると思う。
*/
}


resource TO_アイテムボックス２__f {
//＊ムービー t //e
オタコン_000: {
Chaque fois que tu descends un ennemi,
cache-toi et v&'erifie qu'il n'a pas de Bo&^ite
d'objets.
}
//	<<<ENGLISH>>>
//	When you take out an enemy, move
//	his body out of the way and check
//	for an Item Box.
//<ページ数変更>
オタコン_000_1: {
Ne la laisse pas sur place.
}
//	<<<ENGLISH>>>
//	Don't leave it behind.

/*敵を倒して、その体を動かすと
アイテムボックスを出すことがある。
それを手に入れるのも忘れないようにね。
*/

}//d

resource TO_アイテムボックス３__f {
//＊ムービー t //e
オタコン_000: {
Chaque fois que tu descends un ennemi,
tu peux voir appara&^itre une Bo&^ite d'objets.
Ne la laisse pas sur place.
}
//	<<<ENGLISH>>>
//	When you take out an enemy,
//	an Item Box may appear.
//	Don't leave it behind.

/*敵を倒すとアイテムボックスを
出すことがある。それを手に入れるのも
忘れないようにね。
*/

}//d



//○その他 d //e
//・隠密行動せよ。 h //e
resource TO_発見されるな__f {
オタコン_000: {
Snake, ne te fais pas rep&'erer par l'ennemi.

}
//	<<<ENGLISH>>>
//	Snake, don't let the
//	enemy spot you.
//<ページ数変更>
オタコン_000_1: {
D&`es qu'une sentinelle t'aura vu, elle
appellera des renforts et tu te feras avoir.
}
//	<<<ENGLISH>>>
//	Once you've been discovered by a
//	sentry, he'll call in reinforcements
//	and there will be an attack.

/*スネーク、敵に見つからないように
してくれよ。敵は君を見つけたら、
当然仲間を呼んで攻撃してくる。
*/

オタコン_001: {
M&^eme toi tu ne fais pas le poids contre ce
type d'assaut organis&'e.
}
//	<<<ENGLISH>>>
//	Even you're no match for that
//	level of organized assault.
//<ページ数変更>
オタコン_001_1: {
N'oublie pas qu'ils ont de meilleures armes
que toi !
}
//	<<<ENGLISH>>>
//	They have better weapons
//	too, remember?

/*組織的に攻撃されたら、いくら君でも
勝ち目はない。武装は向こうの方が
上だしね。
*/

オタコン_002: {
Nous ne sommes pas des terroristes, vu ?

}
//	<<<ENGLISH>>>
//	We aren't terrorists, okay?
//<ページ数変更>
オタコン_002_1: {
Evite les confrontations inutiles et
reste discret. Compris ?
}
//	<<<ENGLISH>>>
//	Avoid unnecessary confrontations
//	and go for total stealth. All right?

/*僕らはテロリストじゃない。
無用な戦闘はさけてくれ。
あくまでも隠密行動だ。いいね。
*/

}//d



//★デフォルト会話。当該アイテムを装備している時一回目のみ発生 d //e
//武器 d //e
//・Ｍ９ h //e
resource TO_Ｍ９__f {
オタコン_000: {
Tu as dans les mains un Beretta M-92F
modifi&'e, con&~qu pour tirer des salves de
tranquillisant.
}
//	<<<ENGLISH>>>
//	What you're wielding right now
//	is a converted Beretta M-92F,
//	designed to fire tranquilizer rounds.
//<ページ数変更>
オタコン_000_1: {
Toute cible touch&'ee perdra connaissance.
}
//	<<<ENGLISH>>>
//	A direct hit will knock
//	the target unconscious.

/*君が装備してるのはベレッタＭ９２Ｆを
改造した麻酔銃だ。命中すれば敵を
眠らせることが出来るよ。
*/


オタコン_001: {
Ces salves sont comme des petites
seringues.
}
//	<<<ENGLISH(2)>>>
//	Think of those rounds
//	as tiny syringes.

/*麻酔弾は簡単に言えば小さな注射器
みたいなものだ。
*/

オタコン_002: {
&`A l'impact, deux produits chimiques se
m&'elangent dans la shell.
}
//	<<<ENGLISH>>>
//	The impact of the round causes
//	the mixing of two chemicals in
//	the shell.
//<ページ数変更>
オタコン_002_1: {
Le gaz ainsi produit comprime un petit
piston ＃－
}
//	<<<ENGLISH>>>
//	The resulting gas compresses
//	a tiny piston＃－
//<ページ数変更>
オタコン_002_2: {
et injecte le tranquillisant dans la peau, par
l'embout de la balle.
}
//	<<<ENGLISH>>>
//	and injects the tranquilizer in the
//	bullet's tip into the target's skin.

/*着弾時の慣性で薬品を混合してガスを
発生させ、そのガスでピストンを押して、
対象に麻酔を注入する仕組みになってる。
*/

オタコン_003: {
L'effet du tranquillisant agit &`a plus ou
moins longue &'ech&'eance, selon l'endroit
touch&'e par la balle.
}
//	<<<ENGLISH(2)>>>
//	The tranquilizer's effects are felt
//	at different times depending on
//	where the bullet lands.

/*麻酔弾は当たる場所によって、
麻酔が効くまでの時間が
変わってくるんだ。
*/

オタコン_004: {
Les tirs touchant la t&^ete ou le c&@eur
agissent imm&'ediatement.
}
//	<<<ENGLISH(2)>>>
//	A head or heart shot will
//	take effect immediately,
//<ページ数変更>
オタコン_004_1: {
Par contre, si tu tires dans les pieds ou
dans les mains, l'effet prendra plus de
temps.
}
//	<<<ENGLISH>>>
//	but a round that hits somewhere
//	like feet or hands will take a while.
//<ページ数変更>
オタコン_004_2: {
Pour une pr&'ecision optimale, utilise
l'Observation &`a la premi&`ere personne
d'attaque.
}
//	<<<ENGLISH>>>
//	Use the First Person View
//	Attack for maximum accuracy.

/*頭や心臓なら早いし手足なら時間が
かかる。主観攻撃でうまく狙ってくれ。
*/

オタコン_005: {
Le pistolet est muni d'un silencieux.
L'ennemi ne risque pas d'&^etre alert&'e par le
bruit des tirs.
}
//	<<<ENGLISH>>>
//	The gun is fitted with a suppressor,
//	so there is no need to worry about
//	alerting the enemy with the noise.

/*サプレッサー装備だから銃声で敵に
見つかったりすることもないはずだ。
*/

オタコン_006: {
Comme le M9 est un pistolet tranquillisant,
il est d'usage assez limit&'e.
}
//	<<<ENGLISH(2)>>>
//	But since it is a tranquilizer
//	gun, the M9 has its limitations.
//<ページ数変更>
オタコン_006_1: {
Il sert uniquement &`a mettre l'ennemi HS,
ne l'oublie pas !
}
//	<<<ENGLISH>>>
//	All it can do is knock the enemy
//	unconscious. Keep that in mind.

/*でもあくまでＭ９は麻酔銃だ。
敵を眠らせるだけで倒せるわけじゃない。
気をつけてくれ。
*/

}//d

//・ＵＳＰ h //e
resource TO_ＵＳＰ１__f {
オタコン_000: {
Snake, ton pistolet est un USP.
}
//	<<<ENGLISH>>>
//	Snake, that handgun
//	of yours is a USP.

/*スネーク、君が装備してるハンドガンは
ＵＳＰだね。
*/

オタコン_001: {
L'USP existe en divers calibres, du 9 au 45
mm.
}
//	<<<ENGLISH>>>
//	The USP comes in a variety of
//	calibers, from a 9mm to a .45.
//<ページ数変更>
オタコン_001_1: {
Le tien est un 9 mm, avec 15 salves par
chargeur.
}
//	<<<ENGLISH>>>
//	Yours is a 9mm, with 15
//	rounds per magazine.

/*ＵＳＰは９ｍｍとか４５口径とか色々な
バリエントがあるんだけど、君のは
口径９ｍｍ、装弾数１５発のモデルだ。
*/

}


//製品版のみ t //e
resource TO_ＵＳＰ２__f {
オタコン_000: {
Il est &'egalement muni d'une torche, pour
les tirs de nuit.
}
//	<<<ENGLISH>>>
//	It's also equipped with a flashlight
//	for nighttime shooting.
//<ページ数変更>
オタコン_000_1: {
Quand tu es dans l'obscurit&'e, s&'electionne
l'USP et vise pour allumer la lumi&`ere.
}
//	<<<ENGLISH>>>
//	In the dark, select the USP
//	and aim to turn on the light.

/*フラッシュライトもついてるね。
暗いところでＵＳＰを装備して
構えればライトがつくはずだ。
*/
}



resource TO_ＵＳＰ３__f {
オタコン_000: {
Contrairement au M9, l'USP n'a pas de
silencieux.
}
//	<<<ENGLISH>>>
//	Unlike the M9, the USP isn't
//	suppressor-equipped.
//<ページ数変更>
オタコン_000_1: {
Tes tirs risquent de faire accourir les
renforts, attention.
}
//	<<<ENGLISH>>>
//	The gunshots may bring enemy
//	reinforcements running, so be
//	careful.

/*でもＭ９と違ってサプレッサーは
付いてないから、発砲すれば当然
銃声がする。撃つ時には注意してくれ。
*/
//ＸＸＸＸＸ //e

}//d



//・チャフ h //e
resource TO_チャフ__f {
オタコン_000: {
H&'e, tu as une grenade chaff.
}
//	<<<ENGLISH>>>
//	Hey, you have a chaff grenade.
//<ページ数変更>
オタコン_000_1: {
Tu peux l'utiliser pour brouiller
temporairement les communications ＃－
}
//	<<<ENGLISH>>>
//	You can use that to interfere
//	with enemy radio communications...
//<ページ数変更>
オタコン_000_2: {
radio et les appareils &'electroniques de
l'ennemi.
}
//	<<<ENGLISH>>>
//	and electronic devices
//	for a short time.

/*チャフ・グレネードを持ってるね。
それを使えば少しの間、敵の無線や
電子機器を妨害することが出来る。
*/

オタコン_001: {
La grenade chaff disperse des fibres de
verre ou de plastique recouvertes de m&'etal
ou d'aluminium,
}
//	<<<ENGLISH>>>
//	The chaff grenade is a weapon
//	that disperses aluminum foil or
//	metalcoated glass
//<ページ数変更>
オタコン_001_1: {
pour brouiller les radars ennemis.
}
//	<<<ENGLISH>>>
//	and plastic fibers to
//	confuse the enemy radar.

/*チャフはアルミ箔とか金属コーティング
したガラスやプラスティック繊維を散布
してレーダーを妨害する電子戦兵器だ。
*/

オタコン_002: {
Ce que tu as est une version portative des
lanceurs de particules ＃－
}
//	<<<ENGLISH>>>
//	What you have is a portable
//	application of the chaff-
//	launchers
//<ページ数変更>
オタコン_002_1: {
m&'etalliques avions de chasse.
}
//	<<<ENGLISH>>>
//	built into fighter planes.

/*君が持ってるのは戦闘機とかに
搭載されるチャフ・ディスペンサーを
携行用に小型化したものだね。
*/

オタコン_003: {
Lorsqu'elle explose, la grenade diffuse de
minuscules particules m&'etalliques ＃－
}
//	<<<ENGLISH>>>
//	When detonated, the grenade
//	releases tiny chaff pieces
//<ページ数変更>
オタコン_003_1: {
ainsi que des brouilleurs actifs
miniaturis&'es, &`a l'aide d'une petite quantit&'e
d'explosifs.
}
//	<<<ENGLISH>>>
//	as well as miniaturized active
//	jammers using a small amount
//	of explosives.

/*点火装置が発火すると微量の爆薬で
多数のチャフ片と同時に
＃｛小型妨害電波発信機、ミニ・アクティブ・ジャマー｝＃を散布する。
*/

オタコン_004: {
Cette grenade ne peut cr&'eer ni des
couloirs ni des nuages de paillettes
m&'etalliques de grande &'echelle,
}
//	<<<ENGLISH>>>
//	The grenade can't create full-scale
//	chaff corridors or chaff clouds,
//<ページ数変更>
オタコン_004_1: {
mais elle forme une zone de brouillage
radar assez grande pour l'usage
individuel.
}
//	<<<ENGLISH>>>
//	but will form a Radar Cross
//	Section area large enough for
//	single-personnel use.

/*大規模なチャフ＃｛回廊、コリドー｝＃やチャフ雲は作り出
せないけど個人用としては充分な大きさ
の＃｛レーダー有効反射面積、ＲＣＳ｝＃を形成出来る。
*/

オタコン_005: {
Cette arme ne sert qu' au brouillage
&'electronique.
}
//	<<<ENGLISH>>>
//	This weapon is for electronic
//	interference only, though.
//<ページ数変更>
オタコン_005_1: {
Elle est sans effet sur l' ennemi.
}
//	<<<ENGLISH>>>
//	It has no effect on
//	enemy personnel.

/*でもあくまでも電子妨害用の手榴弾
だから、それで敵を倒すことは出来ない。
注意してくれ。
*/

}//d

//・スタン h //e
resource TO_スタン__f {
オタコン_000: {
La grenade paralysante dans ton
&'equipement sert &`a paralyser l'ennemi sans
pour autant le tuer.
}
//	<<<ENGLISH>>>
//	The stun grenade in your equipment
//	is for incapacitating enemies without
//	killing them.

/*スタン・グレネードを装備してるね。
それを使えば敵を殺さずに気絶させる
ことが出来る。
*/

オタコン_001: {
Ce sont des armes non mortelles qui font
perdre connaissance en diffusant
un &'eclair ＃－
}
//	<<<ENGLISH>>>
//	Stun grenades are non-lethal
//	weapons that knock out enemy
//	personnel
//<ページ数変更>
オタコン_001_1: {
lumineux intense et un son assourdissant.
}
//	<<<ENGLISH>>>
//	with an intense flash of
//	light and a burst of sound.

/*スタン・グレネードは強烈な光と音を
発生させて人間を傷つけずに無力化する
＃｛非殺傷兵器、ノン・リーサル・ウェポン｝＃だ。
*/

オタコン_002: {
Une fois la grenade lanc&'ee, un d&'etonateur
programm&'e &'ejecte une cartouche ＃－
}
//	<<<ENGLISH>>>
//	Once the grenade is airborne,
//	a timed detonator ejects an
//	internal cartridge＃－
//<ページ数変更>
オタコン_002_1: {
interne gr&^ace &`a une petite quantit&'e
d'explosif.
}
//	<<<ENGLISH>>>
//	using a small amount
//	of explosives.

/*投擲後、時限点火装置が作動すると、
微量の火薬で内蔵のカートリッジが
撃ち出される。
*/

オタコン_003: {
La cartouche explose alors et &'emet un
&'eclair d'une intensit&'e de plus d'un million
de bougies,
}
//	<<<ENGLISH>>>
//	The cartridge then explodes, and
//	releases a flash rated at over a
//	million candlepower,
//<ページ数変更>
オタコン_003_1: {
accompagn&'e d'une explosion de plus de
200 d&'ecibels.
}
//	<<<ENGLISH>>>
//	with an accompanying bang
//	of over 200 decibels.
//<ページ数変更>
オタコン_003_2: {
L'&'eclair et l'explosion font temporairement
disjoncter les perceptions sensorielles de l'
&^etre humain.
}
//	<<<ENGLISH>>>
//	The combinations of the flash and
//	the bang temporarily overwhelms
//	human sensory perceptions.

/*カートリッジは１００万カンデラ以上の
閃光と２００デシベル以上の爆音を放出
して爆発し、人間の感覚を失わせるんだ。
*/

オタコン_004: {
Il n'y a aucun lancement de projectile.
Cette arme ne fait que paralyser l'ennemi,
elle ne le blesse pas. Ne l'oublie pas.
}
//	<<<ENGLISH>>>
//	There are no projectiles released,
//	so it can only knock out enemies,
//	not wound them. Keep that in mind.

/*体を傷つける破片は飛び散らないから、
敵を気絶させるだけでダメージを
負わせることは出来ない。注意してくれ。
*/

}//d

