//・レーション h //e
resource TO_レーション__f {
オタコン_000: {
Tu as donc des rations, maintenant. Gr&^ace
&`a ces aliments militaires,
}
//	<<<ENGLISH>>>
//	So you've got rations now.
//	These are military food supplies,
//<ページ数変更>
オタコン_000_1: {
tu pourras r&'ecup&'erer un peu de LIFE.
}
//	<<<ENGLISH>>>
//	and allow you to recover
//	some LIFE with use.

/*レーションを装備してるね。
軍用の携帯糧食で、使うと＃｛ＬＩＦＥ、ライフ｝＃を
