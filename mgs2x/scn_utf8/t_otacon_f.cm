*/

オタコン_004: {
Elles se conservent gr&^ace par une
lyophilisation sp&'eciale mise au point
par le NROC.
}
//	<<<ENGLISH>>>
//	They use a special freeze-drying
//	methods developed by NROC.
//<ページ数変更>
オタコン_004_1: {
Elles sont compactes, portatives et durent
des semaines.
}
//	<<<ENGLISH>>>
//	They're compact, portable,
//	and last for weeks.

/*＃｛米軍調理開発研究所、ＮＲＯＣ｝＃が開発した
フリーズドライ方式を使っていて、小型
軽量で日持ちもするように出来てるんだ。
*/


}//d


//・軍用止血剤 h //e
resource TO_止血剤１__f {
オタコン_000: {
Tu as des pansements de gel, je vois.
}
//	<<<ENGLISH>>>
//	You've picked up
//	gel bandages, I see.
//<ページ数変更>
オタコン_000_1: {
Si tu saignes, s&'electionne le pansement
comme &'equipement pour stopper le
saignement.
}
//	<<<ENGLISH>>>
//	When you're bleeding, select
//	the bandage as an equipment
//	to stop the blood.

/*止血剤を装備してるね。出血してる時に
