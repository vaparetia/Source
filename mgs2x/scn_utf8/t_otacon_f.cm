}
/*＃｛俯瞰、フカン｝＃でも主観でも出来るから、
有効に使ってくれ。
You can use this feature from
First Person View or from Top
View as well.
*/

}//d

resource TO_階段魔人__f {
オタコン_000: {
Snake, ils t'ont tendu une embuscade en
haut des escaliers ! 
}
//	<<<ENGLISH>>>
//	Snake, they're waiting to ambush
//	you on top of the stairs!
//<ページ数変更>
オタコン_000_1: {
Tu ne pourras pas monter tant qu'ils
tireront d'en haut.
}
//	<<<ENGLISH>>>
//	There's no way you can make it up
//	while being sniped from above.

/*スネーク、階段の上に敵が待ち伏せ
してる！上から狙い撃ちされたら、
