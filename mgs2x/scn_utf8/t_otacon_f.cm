//装備 d //e
//・軍用双眼鏡 h //e
resource TO_双眼鏡__f {
オタコン_000: {
C'est bien, tu as des jumelles. Tu vas
pouvoir observer le territoire ennemi de
loin.
}
//	<<<ENGLISH>>>
//	Good, you have a pair of binoculars.
