オタコン_000_1: {
Tu peux viser la t&^ete ou les pieds de
l'ennemi.
}
//	<<<ENGLISH>>>
//	you can aim for the enemy's
//	head or even feet.

/*主観攻撃を使えば、上や下にも撃てるし、
敵の足や頭を狙うことも出来るんだ。
*/
}


resource TO_主観攻撃２の１__f {
//＊ムービー t //e
オタコン_000: {
Les touches L2 et R2 te permettent de
mitrailler l'ennemi lorsque tu es en
Observation &`a la premi&`ere personne
d'attaque.
}
//	<<<ENGLISH>>>
//	The L2 and R2 buttons let you
//	strafe during First Person Attacks.
//<ページ数変更>
オタコン_000_1: {
Tu peux &'egalement t'accroupir en appuyant
sur la touche Ramper.
}
//	<<<ENGLISH>>>
//	You can crouch, too,
//	with the Crawl button.

/*主観攻撃中にもＬ２ボタン、
Ｒ２ボタンで左右ステップしたり、
＃｛×、ホフク｝＃ボタンでしゃがんだり出来る。
*/
}


resource TO_主観攻撃２の２__f {
//＊ムービー t //e
オタコン_000: {
Une fois que tu ma&^itriseras tous les
mouvements, tu pourras sauter hors de ta
cachette,
}
//	<<<ENGLISH>>>
//	Once you've mastered all the moves,
//	you'll be able to do things like jump
//	out from concealment,
//
//<ページ数変更>
オタコン_000_1: {
tirer sur une cible et te soustraire de
nouveau &`a la vue de l'ennemi.
}
//	<<<ENGLISH>>>
//	fire at a target, and then drop
//	out of the enemy's view again.

/*うまく使えば、遮蔽物に隠れながら、
相手の隙を見て飛び出して撃って
また隠れるとか出来るはずだ。
*/
}//d

//・銃を構えてゆっくりおろす h //e
resource TO_銃を構えて下ろす１__f {
オタコン_000: {
En appuyant sur la touche Arme, tu peux
viser avec ton pistolet,
}
//	<<<ENGLISH>>>
//	You can aim the handgun
//	with the Weapon button,
//<ページ数変更>
オタコン_000_1: {
puis l'abaisser sans tirer en rel&^achant
lentement la touche.
}
//	<<<ENGLISH>>>
//	then lower it without firing
//	if you let go of the button
//	slowly.

/*ハンドガンは＃｛□、武器｝＃ボタンで構えても、
ゆっくり＃｛□、武器｝＃ボタンを離せば
発砲せずに銃を下ろすことが出来る。
*/
}


resource TO_銃を構えて下ろす２__f {
オタコン_000: {
Tu &'economise as tes munitions. Et, ce
genre de man&@euvre est sussi utile chaque
fois que tu d&'esarmes un ennemi &`a bout
portant.
}
//	<<<ENGLISH>>>
//	It saves ammunition, and besides,
//	it could be useful after you've
//	disarmed an enemy at gunpoint.

/*弾を無駄に使わずに済むし、
敵をホールドアップさせた後
なんかでも役立つと思う。
*/

}//d
//＠構え下ろしは拳銃だけ？ //e


//・武器を構えてゆっくりおろす h //e
resource TO_武器を構えて下ろす１__f {
オタコン_000: {
En appuyant sur la touche Arme, tu peux
viser avec ton arme,
}
//	<<<ENGLISH>>>
//	You can aim a weapon with
//	the Weapon button,
//<ページ数変更>
オタコン_000_1: {
puis l'abaisser sans tirer en rel&^achant
lentement la touche.
}
//	<<<ENGLISH>>>
//	then lower it without using
//	it if you let go of the button
