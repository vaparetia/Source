*/
}

//流血条件聞いてない場合 流血条件 t e//

resource TO_止血剤２__f {
オタコン_000: {
C' est un bandage &`a base d'alginate.
}
//	<<<ENGLISH>>>
//	The bandage is a type
//	of alginate dressing.
//<ページ数変更>
オタコン_000_1: {
D&`es qu'il entre au contact du sang ou de
liquides, ce tampon hyper-absorbant les
coagule.
}
//	<<<ENGLISH>>>
//	It's a highly absorbent pad
//	that gels blood and other
//	fluids on contact.

/*その止血剤はいわゆるアルギネート材
だ。血液や体液を吸収してゲル化する
