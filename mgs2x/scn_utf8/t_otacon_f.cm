//＠カメラの仕様ボタンは固定？ //e
//没ＸＸＸＸＸＸＸＸＸＸＸＸｘ
resource TO_カメラ使い方２__f {
オタコン_000: {
L'appareil photo est facile &`a utiliser.
}
