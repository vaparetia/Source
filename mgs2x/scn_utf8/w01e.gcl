proc スネークの場所によってＢＧＭを変調させるセット {

	trap ev002 d:PLAYER \
		-mask 入る \
		-exec {
print 'FADE_IN_1'
			//mesg ＢＧＭマネージャー ＢＧＭ SD_SNEAK_AUTO d:SD_AUTO_FADER1
			mesg サウンドマネージャー ＳＤマネ SD_CODE d:SD_AUTO_FADER1
		}
	trap ev003 d:PLAYER \
		-mask 入る \
		-exec {
print 'FADE_IN_2'
			//mesg ＢＧＭマネージャー ＢＧＭ SD_SNEAK_AUTO d:SD_AUTO_FADER2
			mesg サウンドマネージャー ＳＤマネ SD_CODE d:SD_AUTO_FADER2
		}
	trap ev004 d:PLAYER \
		-mask 入る \
		-exec {
print 'FADE_IN_3'
			//mesg ＢＧＭマネージャー ＢＧＭ SD_SNEAK_AUTO d:SD_AUTO_FADER3
