// メインアングル
// ------------------------------------
proc 五階カメラセット１ {
	trap ca005 d:PLAYER \
		-mask ＊ \
		-camera \
		-exec {

			@CS_スムーズカメラ昇順 $6 -19000 -17000 17677 17935
				eval( $i:補完ＰＹ= $i:CS_結果１ )

			@CS_スムーズカメラ昇順 $6 -19000 -17000 -16787 -17161
				eval( $i:補完ＰＺ= $i:CS_結果１ )

			@CS_スムーズカメラ昇順 $6 -19000 -17000 15077 15050
				eval( $i:補完ＴＹ= $i:CS_結果１ )

			@CS_スムーズカメラ昇順 $6 -19000 -17000 -18041 -17258
				eval( $i:補完ＴＺ= $i:CS_結果１ )

			if( $4 > 3750 ){
				eval( $i:補完ＰＸ = 3750 )
			}else if( $4 < -3750 ){
				eval( $i:補完ＰＸ = -3750 )
			}else{
				eval( $i:補完ＰＸ = $4 )
			}



			chara カメラ設定 サブカメラ１ \
				-c 1 \
				-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ -t $i:補完ＰＸ,$i:補完ＴＹ,$i:補完ＴＺ \
				-r 1002,2048,0 -f 2887 \
				-a 200 \
				-i 1 -1 0 0 \
				-s $3

	}
}

// 階段へ続く通路
// ------------------------------------
proc 五階カメラセット２ {
trap ca001 スネーク \
	-mask ＊ \
	-camera \
	-exec {
			if( $6 < -16000 ) {
				eval( $w:補完方式 = 0 )		// 北から進入
			}else{
				eval( $w:補完方式 = 1 )		// 南の階段から進入
			}

			chara カメラ設定 サブカメラ１ \
				-c 0 \
				-b 1500 10000 -15000  1500 20000 15000 \
				-l 1500 10000 -15000  1500 20000 15000 \
				-r 315,2048,0 -f 1405 \
				-a 200 \
				-i $w:補完方式 -1 0 0 \
				-slide 1 10 2000 2000 30 0 \
				-s $3
	}
}


proc 完全補完カメラ $:比較対象 $:距離小 $:距離大 $:ＰＸ１ $:ＰＸ２ $:ＰＹ１ $:ＰＹ２ $:ＰＺ１ $:ＰＺ２ $:ＴＸ１ $:ＴＸ２ $:ＴＹ１ $:ＴＹ２ $:ＴＺ１ $:ＴＺ２{
	@CS_スムーズカメラ昇順 $:比較対象 $:距離小 $:距離大 $:ＰＸ１ $:ＰＸ２
		eval( $i:補完ＰＸ= $i:CS_結果１ )
	@CS_スムーズカメラ昇順 $:比較対象 $:距離小 $:距離大 $:ＰＹ１ $:ＰＹ２
		eval( $i:補完ＰＹ= $i:CS_結果１ )
	@CS_スムーズカメラ昇順 $:比較対象 $:距離小 $:距離大 $:ＰＺ１ $:ＰＺ２
		eval( $i:補完ＰＺ= $i:CS_結果１ )
	@CS_スムーズカメラ昇順 $:比較対象 $:距離小 $:距離大 $:ＴＸ１ $:ＴＸ２
		eval( $i:補完ＴＸ= $i:CS_結果１ )
	@CS_スムーズカメラ昇順 $:比較対象 $:距離小 $:距離大 $:ＴＹ１ $:ＴＹ２
		eval( $i:補完ＴＹ= $i:CS_結果１ )
	@CS_スムーズカメラ昇順 $:比較対象 $:距離小 $:距離大 $:ＴＺ１ $:ＴＺ２
		eval( $i:補完ＴＺ= $i:CS_結果１ )
}

// 四階へ（強制モーション）
// ------------------------------------
proc 五階カメラセット５ {
trap ca004 スネーク \
	-mask ＊ \
	-camera \
	-exec {
/*
			if($3 == 入る) {
				mesg プットオブジェ 階段天井 on
			} else if($3 == 出る) {
				mesg プットオブジェ 階段天井 off
			}
*/

#if 0
			chara カメラ設定 サブカメラ１ \
				-c 1 \
				-p 1421,9957,-10289 \
				-t 1484,12733,-13240 \
//				-p 1665,14486,-14665 \
//				-t 1450,12943,-12680 \
				-r 926,2182,0 \
				-a 200 \
				-i 1 -1 0 0 \
				-s $3
#else
/*
-p 1504,14913,-12438 -t 1519,12681,-13164 \
-r 819,2034,0 -f 2347 \
-a 200 \

-p 1504,14060,-11632 -t 1519,11841,-12379 \
-r 812,2035,0 -f 2341 \
-a 200 \
*/
			@完全補完カメラ $6	-13500 -11500  \
								1504 1504 \
								14913 14060 \
								-12438 -11632 \
								1519 1519 \
								12681 11841 \
								-13164 -12379

			chara カメラ設定 サブカメラ１ \
				-c 1 \
				-p $i:補完ＰＸ $i:補完ＰＹ $i:補完ＰＺ \
				-t $i:補完ＴＸ $i:補完ＴＹ $i:補完ＴＺ \
				-r 819,2034,0 -f 2347 \
				-a 200 \
				-i 1 -1 0 0 \
				-s $3
#endif
	}
}

// ドアおよびステージロード
// ------------------------------------
proc クルクルドアセット {
	chara 水密ドア管理 ドア管理人 -n 2 \
		-seno 1 \
		-motions sna_hatch hatch_door_sna hatch_handle_sna
		//-adjusts 10,50 0,0 0,50 0,50

	eval($i:水密ドア_dr000_Ｘ座標 = -5950)
	eval($i:水密ドア_dr000_Ｚ座標 = -16525)

// 左舷水密ドアセット
	if( $s:登場ポイント == w00c左舷から来た ) {
		chara 水密ドア 水密君_左 \
			-kms w00_sdr_l w00_sdr_handle \ // w00_sdr_l = 左軸。w00_sdr_r = 右軸。
			-position $i:水密ドア_dr000_Ｘ座標,12000,$i:水密ドア_dr000_Ｚ座標 \
			-rotate 0,3072,0 \
			-flag d:WT_DOOR_FLAG_OPEN_START \
			-hazard -5800,12000,-16750 -5800,12000,-15200 \
			-proc ロード_左舷ウイングへの移動
	} else {
		chara 水密ドア 水密君_左 \
			-kms w00_sdr_l w00_sdr_handle \ // w00_sdr_l = 左軸。w00_sdr_r = 右軸。
			-position $i:水密ドア_dr000_Ｘ座標,12000,$i:水密ドア_dr000_Ｚ座標 \
			-rotate 0,3072,0 \
			-hazard -5800,12000,-16750 -5800,12000,-15200 \
			-proc ロード_左舷ウイングへの移動
	}

	trap dr000 スネーク \
		-dir 3072 256 \
		-mask いる \
		-button d:ACTION_BUTTON \
		-state 0 \
		-exec {
			command 水密ドア状態 -n 水密君_左
			mesg プレイヤー スネーク \
				wt_door 水密君_左 $status 3072,3560 $i:水密ドア_dr000_Ｘ座標,$i:水密ドア_dr000_Ｚ座標
			}


	trap dr000 スネーク \
		-mask ？ \
		-state 6 \
		//-dir 3072 256 \
		-exec {
			chara カメラ設定 サブカメラ２ \
				-c 1 \
				-p -4719,15746,-15374 -t -5107,12662,-16476 \
				-r 788,2269,0 -f 3298 \
				-a 220 \
				-i 1 1 0 0 \
				-s $3
			}


// 右舷最初はの開かないドア
	if( $f:global_右水密ドア開くイベント == 0 ) {
		chara 水密ドア 水密君_右 \
			-kms w00_sdr_r w00_sdr_handle \
			-position 5950,12000,-16525 \
			-rotate 0,3072,0 \
			-type 1 \
			-exec { } \
			-hazard 5800,12000,-16750 5800,12000,-15200 \
			-flag d:WT_DOOR_FLAG_NOT_OPEN

		trap dr001 d:PLAYER \
			-mask いる \
			-button d:ACTION_BUTTON \
			-state 0 \
			-exec {
				eval($f:rft_w01e開かない水密扉開けた = 1)	//fukushima
				command 水密ドア状態 -n 水密君_右
				mesg プレイヤー d:PLAYER wt_door 水密君_右 $status 1024,1024 5950,-16525
			}

		trap dr001 d:PLAYER \
			-mask ？ \
			-state 6 \
			-exec {
				chara カメラ設定 サブカメラ２ \
					-c 1 \
					-p 4659,15719,-15340 -t 5186,13635,-16159 \
					-r 739,1675,0 -f 2300 \
					-a 220 \
					-i 1 1 0 0 \
					-s $3
			}
	}else{
		if( $s:登場ポイント == w00c右舷から来た ) {
			chara 水密ドア 水密君_右 \
				-kms w00_sdr_r w00_sdr_handle \
				-position 5950,12000,-16525 \
				-rotate 0,3072,0 \
				-type 1 \
				-hazard 5800,12000,-16750 5800,12000,-15200 \
				-flag d:WT_DOOR_FLAG_OPEN_START \
				-proc ロード_右舷ウイングへの移動
		} else {
			chara 水密ドア 水密君_右 \
				-kms w00_sdr_r w00_sdr_handle \
				-position 5950,12000,-16525 \
				-rotate 0,3072,0 \
				-type 1 \
				-hazard 5800,12000,-16750 5800,12000,-15200 \
				-proc ロード_右舷ウイングへの移動
		}

		trap dr001 d:PLAYER \
			-mask いる \
			-button d:ACTION_BUTTON \
			-state 0 \
			-exec {
				eval($f:rft_w01e開かない水密扉開けた = 1)	//fukushima
				command 水密ドア状態 -n 水密君_右
				mesg プレイヤー d:PLAYER wt_door 水密君_右 $status 1024,1024 5950,-16525
			}
		trap dr001 d:PLAYER \
			-mask ？ \
			-state 6 \
			-exec {
				chara カメラ設定 サブカメラ２ \
					-c 1 \
					-p 4659,15719,-15340 -t 5186,13635,-16159 \
					-r 739,1675,0 -f 2300 \
					-a 220 \
					-i 1 1 0 0 \
					-s $3
			}

	}
}



// 入出トラップ
// ------------------------------------
// このプロック名は予約。
proc ロードプロック {
	if ($s:呼び出しプロック == mv_w01e_w01d_0) {
		command セットサウンドコード -c d:SNG_FOUTS_S
		@mv_w01e_w01d_0
	} else if ($s:呼び出しプロック == mv_w01e_w00b_1) {
		command セットサウンドコード -c d:SNG_FOUTS_S
		@mv_w01e_w00b_1
	} else if ($s:呼び出しプロック == mv_w01e_w00c_0) {
		command セットサウンドコード -c d:SNG_FOUTS_S
		@mv_w01e_w00c_0
	} else if ($s:呼び出しプロック == mv_w01e_w00c_1) {
		command セットサウンドコード -c d:SNG_FOUTS_S
		@mv_w01e_w00c_1
	}
}

// 四階へのロード
proc ロード_四階へ移動 {

	trap ld000 d:PLAYER \
		-mask 入る \
		-exec {
			preseek 'w01d'
			@ステージ終了時処理（ステージ名表示） 1500 8500 -11000 0 mv_w01e_w01d_0 d:M_TYPE:NO_CHANGE d:wn_船橋四階居住区
			eval($i:w01d_直前のマップ = 5)
		}
}

// ロード_左舷ウイングへの移動
proc ロード_左舷ウイングへの移動 $:トリガ $:実行キャラ {
#if d:LOAD_LEFT
	// 開いたとき
	if ($:トリガ == 0) {
		if($w:t_story < d:ST_T05a1Dオルガ戦前ポリゴンデモ終了) {
			print 'オルガ戦へ'
			preseek 'w00b'
			@ステージ終了時処理 -7450 12000 -16000 3072 mv_w01e_w00b_1 d:DEFAULT_M_TYPE
		} else {
			print 'オルガ戦後'
			preseek 'w00c'
			@ステージ終了時処理（ステージ名表示） -7450 12000 -16000 3072 mv_w01e_w00c_0 d:DEFAULT_M_TYPE d:wn_航海甲板左舷ウイング
		}
	} else if ( $:トリガ == 3 ) {
		// 水密ドアが開き始めたら隙間風を吹かしＳＥをコールする
		chara delay ディレイ -time 45 -exec {
			command ＳＥセットモード -s d:se_code:SD_A_DRORAIN1 -p -5750 12000 -16000 -m 0
			mesg ローカル風 隙間風 オン
		}

		chara カメラ設定 サブカメラ３ \
			-c 1 \
			-p -4719,15746,-15374 -t -5107,12662,-16476 \
			-r 787,2270,0 -f 3297 \
			-a 220 \
			-i 1 1 0 0 \
			-s 1
	}
#endif
}

// ロード_右舷ウイングへの移動
proc ロード_右舷ウイングへの移動 $:トリガ $:実行キャラ {
#if d:LOAD_RIGHT
	// 開いたとき
	if ($:トリガ == 0) {
		preseek 'w00c'
		@ステージ終了時処理（ステージ名表示） 7450 12000 -16000 1024 mv_w01e_w00c_1 d:DEFAULT_M_TYPE d:wn_航海甲板右舷ウイング
	}else if ( $:トリガ == 3 ) {
		// 水密ドアが開き始めたら隙間風を吹かしＳＥをコールする
		chara delay ディレイ -time 45 -exec {
			command ＳＥセットモード -s d:se_code:SD_A_DRORAIN1 -p 5750 12000 -16000 -m 0
			mesg ローカル風 隙間風 オン
		}

		chara カメラ設定 サブカメラ３ \
			-c 1 \
			-p 4659,15719,-15340 -t 5186,13635,-16159 \
			-r 739,1675,0 -f 2300 \
			-a 220 \
			-i 1 1 0 0 \
			-s 1
	}
#endif
}


proc アイテム取得時番号設定 $:ボックス名 {
#if d:DEBUG_PRINT
	print 'item_no_set'
#endif

	if($:ボックス名 == レーション) {
		eval($b:w01e_取得ロード回数[0] = $w:グローバルロード回数);
	} else if ($:ボックス名 == 弾薬ＵＳＰ) {
		eval($b:w01e_取得ロード回数[1] = $w:グローバルロード回数);
	}

#if d:DEBUG_PRINT
	print $:ボックス名
	print $w:グローバルロード回数
#endif
}

proc アイテムセット {
	if( $w:ゲーム設定 <= d:LEVEL_EASY ){
		@アイテム再セットチェック $b:w01e_取得ロード回数[0]
		if ($f:再セットフラグ) {
			@レーション_初期設置 レーション -4500,12000,-15750 0
		}
	}

	@アイテム再セットチェック $b:w01e_取得ロード回数[1]
	if ($f:再セットフラグ) {
		// ＵＳＰを持っていたらセットする
		if( $w:武器最大数[ d:武器:ＵＳＰ ] ) {
			@弾薬_ＵＳＰ_初期設置 弾薬ＵＳＰ 4817,12000,-18682 0
		}
	}
}

// 以下は主に、体験版用セット

proc 階段部斜め天井セット {
	chara プットオブジェ 階段天井 -m w01er2 -r 0 0 0 \
		-p 0 0 0 \
		-l w01e \
		-s 100 100 100
	// 最初はオフ
	//mesg プットオブジェ 階段天井 off
	mesg プットオブジェ 階段天井 on
/*
trap ca001 スネーク \
	-mask ＊ \
	-exec {
		if($i:カメラＺ位置 > -12400) {
			if($f:w01e_階段部斜め天井){
				eval($f:w01e_階段部斜め天井 = 0)
				mesg プットオブジェ 階段天井 off
			}
		} else {
			if(!$f:w01e_階段部斜め天井){
				eval($f:w01e_階段部斜め天井 = 1)
				mesg プットオブジェ 階段天井 on
			}
		}
	}
*/
}
proc オルガ無線かけているモーションセット {
	if($w:t_story < d:ST_T05a1Dオルガ戦前ポリゴンデモ終了) {
		chara プットモーションモデル オルガ無線かけている \
			-pos -15000 12750 -14500 \
			-dir 3072 \
			-kms org_def_sh_mt \ /*evmを表示する場合はダミーKMSが必要*/
	//		-evm $s:EVMモデル名 \ /*KMSを表示する場合は不要*/
			-mar org_w01e \
	//		-number $i:基本モーション番号 \ /*省略時０*/
	//		-item	org_radio 6 \ /*オブジェを付随*/
	//		-item	usp 6 \ /*オブジェを付随*/
			-status	0x04 // 壁アタリ判定無し

		chara 装備品Ｃ 軍帽 \
			-n demo_org_hut \
			-y オルガ無線かけている \
			-z 12 \
			-x 0 0 0 \
			-r 0 0 0 \
			-f 1

		chara 装備品Ｃ 無線機 \
			-n org_radio_forhand \
			-y オルガ無線かけている \
			-z 6 \
			-x 0 0 0 \
			-r 0 0 0 \
			-f 1

		chara 装備品Ｃ オルガＵＳＰホルスター \
			-n org_gbhlst \
			-y オルガ無線かけている \
			-z 0 \
			-x -110 90 55 \
			-r (0*4096/360) (-55*4096/360) (-20*4096/360) \
			-f 1

		chara 装備品Ｃ オルガスカウトナイフ \
			-n org_sk_cover \
			-y オルガ無線かけている \
			-z 0 \
			-x 76 90 107 \
			-r (0*4096/360) (8*4096/360) (15*4096/360) \
			-f 1

		chara 身体水飛沫 無線オルガ \
			-n オルガ無線かけている \
			-c org_sgl \
			-l 8000 5000 \
			-s 100
		// -n -c のオプションが無いとダメ
		// -l -s は 無くてよい。
		// -l:(8000 5000) が 目安。
		// -s:100でデフォルト等倍
	}
}



// ビヨンド設定
// ------------------------------------

proc シネマスクリーンセット {
	chara シネマスクリーン シネマ \
		-top d:CINEMA_BELT_UPPER \
		-bottom d:CINEMA_BELT_LOWER \
		-ftime 60	//デフォルト値（ゼロは駄目）
	mesg シネマスクリーン シネマ フェードアウト 1
}

// デバッグキャラ
// ------------------------------------
proc スクリーンショット使用 {
	chara スクリーンショット スクリーンショット
}

proc ＵＳＢキーボード {
#if d:MY_DEBUG
	chara USBキーボード実行 kao \
		-e d:KPD_1 {
						print 'kpd 1'
						eval( $s:登場ポイント = デモから来た )
						command varsave
				   }
#endif
}