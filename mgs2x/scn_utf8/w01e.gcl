// デバッグ
#ifdef d:FIX_MODE
	#define MY_DEBUG	0		// デバッグ
#else
	#define MY_DEBUG	0		// デバッグ
#endif

// レーダー用
#define STAGE_TANKER			1	// タンカー用レーダー

// プラグイン
#define LD_FADEOUT				1
#define STAGE_END				1
#define PAN_CAMERA				1

// エフェクト
#define SOUND					1	// サウンド
#define STAGE_W01E				1	// サウンド用ディファイン
#define YURE					1	// 上下揺れ

#define KIRISAME 				0	// 霧雨。あるいは恒常的に不要？
#define OLD_WINDOW_RAIN 		1	// グミ窓雨を使う。
#define	DRAFT					1	// ドアが開いたときの隙間風
#define UTURIKOMI				1	// 映り込みセット


#define	LOAD_LEFT				1	// 左（オルガステージ）へロード
#define	LOAD_RIGHT				1	// 右舷へロード


#include "sna_w01e.mh"

#include "stdch.h"
#include "sload.h"
#include "sound.h"
#include "enevoice.h"
