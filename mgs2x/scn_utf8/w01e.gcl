proc 雨セット {
	chara 位置指定雨 rain_左 \
		-n 6 \
		-c 90 \
		-b -10000 18000 -26000 -7000 10000 -15000
	chara 位置指定雨 rain_中央 \
		-n 10 \
		-c 90 \
		-b -7000 18000 -26000 7500 10000 -23000
	chara 位置指定雨 rain_右 \
		-n 6 \
		-c 90 \
		-b 7500 18000 -26000 11000 10000 -15000

	trap ev000 スネーク \
		-mask いる \
		-state 3 \ // 主観の時だけ（キリ無いので、BHでは対応せず）
		-exec {
			if($w:プレイヤー方向 > (2048 + 512)){
				mesg 位置指定雨 rain_右 オフ
			} else {
				mesg 位置指定雨 rain_右 オン
			}

			if($w:プレイヤー方向 < (2048 - 512)){
				mesg 位置指定雨 rain_左 オフ
			} else {
				mesg 位置指定雨 rain_左 オン
			}
		}
}

