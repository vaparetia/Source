// 常駐キャラ初期化関係
// ------------------------------------
@常駐キャラ設定

// 変数初期化関係
// ------------------------------------

//eval($w:ビハインド角度 = 360)

// マップ
// ------------------------------------
chara マップ 五階 -k w01e -h w01e -l w01e
chara 天井君 天井 -m w01er -h 14688 -p 0,0,0  -l w01e


// マップ設定 ステージ共通
// ------------------------------------
command マップ設定 \
	五階 -s {
#if d:MGS2_DEMO
		chara デモアクトデバッグ demodebug  -i t:t -d 't' -l  -v 0

		@船首オブジェセット
		@タンカーぼんぼりセット

		@箱の上
		@クルー死体セット

		@クルクルドアセット

		@天球_新空_新雷セット

		@雨セット
		@窓雨セット
		@波面セット
		@霧雨_フォグセット
		@川岸のぼかし
		@下階層水飛沫セット

		@マンハッタンセット
		//@投光器セット
		@床面映り込みスネーク

		//@遠近ぼかしセット

		@各種カメラ作成
		@五階カメラセット１

		@階段部斜め天井セット
#else


	if( $w:t_story == d:ST_操舵室無線機デモ終了 ) {
	// デモ再生の場合
		@オルガデモ再生プロック
		@床面映り込みスネーク
		@下階層水飛沫セット

	} else {
	// ゲームステージの場合

		@プレイヤーセット
		@ポーズ時ステージ名表示設定 d:wn_船橋五階操舵室

		@サウンドマネージャーセット
		//@ＢＧＭマネージャーセット
		@潜入曲を鳴らす
		@スネークの場所によってＢＧＭを変調させるセット

		@上下揺れ_風制御セット

		@映り込みセット

		@ドアからの隙間風

		@各種カメラ作成
		@五階カメラセット１
		@五階カメラセット２
		@五階カメラセット５
		@ロード_四階へ移動
		@アイテムセット
		@オルガ無線かけているモーションセット

		@シナリオデモキャラセット

		@タンカーデジカメ写真判定

	#if d:MY_DEBUG
		@スクリーンショット使用
		@ＵＳＢキーボード
	#endif

	}

	// 共通要素
	@タンカーぼんぼりセット
	@船首オブジェセット
	@箱の上
	@クルー死体セット

	@クルクルドアセット

	@天球_新空_新雷セット

	@雨セット
	@窓雨セット
	@波面セット
	@霧雨_フォグセット
	@川岸のぼかし

	@マンハッタンセット
	@投光器セット
	//@遠近ぼかしセット

	@階段部斜め天井セット

	@飛沫鉄箱１ //下・右から１番目
	@飛沫鉄箱３ //上・左端の鉄箱（斜め）
	@飛沫木箱１ //下・右から１番目
	@飛沫木箱２ //下・右から２番目
	@飛沫木箱３ //下・左奥
	@飛沫木箱４ //下・左端の木箱
	@飛沫鉄箱２ //上・右から２番目 鉄箱３と４は統合した
	@飛沫鉄箱４ //上・右から２番目 鉄箱３と４は統合した
	@飛沫鉄箱６ //階段前のスネーク前進防止鉄箱

#endif

}

/****************************************************************************************************/
// 無線gclのインクルード。必ずマップ設定と、showコマンドの間に置くこと
/****************************************************************************************************/
#include "w01e_cdc.ch"

/****************************************************************************************************/
/*	初期マップ表示																					*/
/****************************************************************************************************/
	command マップ表示 -show 五階

/****************************************************************************************************/
// ステージ開始時処理
/****************************************************************************************************/
	if( $s:登場ポイント == デモから来た ) {
		print 'デモから来た'

		eval($w:t_story = d:ST_T04a1D艦橋カモフ発見ポリゴンデモ終了)

		@ロード時フェードイン

//		eval($w:デモ発動前プレイヤーアイテム = $w:アイテム)
		eval($w:デモ発動前プレイヤー武器 = $w:武器)
//		eval($w:アイテム = d:アイテム:素手 )
		eval($w:武器 = d:武器:素手)

		// ステルスをとる
		if( $w:アイテム == d:アイテム:ステルス ) {
			eval( $f:w01e_ステルスつけてたフラグ = 1 )
			eval($w:アイテム = d:アイテム:素手 )
		}

		command パッド操作 -release
		//mesg ＢＧＭマネージャー ＢＧＭ SD_SNEAK_AUTO d:SD_AUTO_FADER3
		mesg サウンドマネージャー ＳＤマネ SD_CODE d:SD_AUTO_FADER3
		@操舵室調査シナリオデモセット

	}else if( $s:登場ポイント == w01dから来た ) {
		print 'w01dから来た'
		@ステージ開始時処理（ステージ名表示） \
			d:LOAD_TYPE:NO_MOVE_TYPE \
			三階から来た \
			1 \
			d:DEFAULT_M_TYPE \
			d:wn_船橋五階操舵室
	} else if( $s:登場ポイント == w00c左舷から来た ) {
		print 'w00c左舷から来た'
		@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:WT_DOOR_TYPE 水密君_左 1700 d:DEFAULT_M_TYPE d:wn_船橋五階操舵室
		@カメラ曇り
		chara カメラ設定 サブカメラ２ \
			-c 1 \
			-p -4719,15746,-15374 -t -5107,12662,-16476 \
			-r 787,2270,0 -f 3297 \
			-a 220 \
			-i 1 1 0 0 \
			-s 1

		chara キャラ付随水飛抹 スネーク飛沫 \
			-nconcname d:PLAYER \
			-addone 32 \
			-time d:CHARA_SPLASH_TIME \
			-rgbadd 0x40404030 \
			-gbsub 0x40404030


		chara delay ディレイ -time 2 -exec {
			print '風ふけふけ'
			mesg ローカル風 隙間風 オン
			command ＳＥセットモード -s d:se_code:SD_A_DRCRAIN1 -p -5750 12000 -16000 -m 0
		}
		chara delay ディレイ -time 100 -exec {
			mesg ローカル風 隙間風 オフ
		}

	} else if( $s:登場ポイント == w00c右舷から来た ) {
		print 'w00c右舷から来た'
		@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:WT_DOOR_TYPE 水密君_右 1700 d:DEFAULT_M_TYPE d:wn_船橋五階操舵室
		@カメラ曇り
		chara カメラ設定 サブカメラ２ \
			-c 1 \
			-p 4659,15719,-15340 -t 5186,13635,-16159 \
			-r 739,1675,0 -f 2300 \
			-a 220 \
			-i 1 1 0 0 \
			-s 1

		chara キャラ付随水飛抹 スネーク飛沫 \
			-nconcname d:PLAYER \
			-addone 32 \
			-time d:CHARA_SPLASH_TIME \
			-rgbadd 0x40404030 \
			-gbsub 0x40404030

		mesg ローカル風 隙間風 オン
		chara delay ディレイ -time 2 -exec {
			command ＳＥセットモード -s d:se_code:SD_A_DRCRAIN1 -p 5750 12000 -16000 -m 0
		}
		chara delay ディレイ -time 100 -exec {
			mesg ローカル風 隙間風 オフ
		}
	} else if( $s:登場ポイント == 操舵室無線機デモ終了 ) {

		command メニュー設定 -menu off -gage off -radar off -subwin off -radio off -pause off

	} else if( $s:登場ポイント == オルガデモ終了 ) {
		chara フェードインアウト フェードイン \
			-i 0,0,0 128 \
			-c 0,0,0 0 \
			-t d:FADEIN_TIME \
			-p オルガデモ終了後プロック

		command パッド操作 -release

//		eval( $w:アイテム = $w:デモ発動前プレイヤーアイテム )
		eval( $w:武器 = $w:デモ発動前プレイヤー武器 )

		// ステルス戻す
		if( $f:w01e_ステルスつけてたフラグ == 1 ) {
			eval($w:アイテム = d:アイテム:ステルス )
		}
	}

/************************************************************************************************/
// 操舵室調査デモ																				*/
/************************************************************************************************/

	proc 操舵室調査シナリオデモセット {
print '操舵室調査シナリオデモセット'
		eval($w:t_story = d:ST_操舵室調査シナリオデモ開始)
		eval( $s:登場ポイント = 操舵室調査シナリオデモ開始)

		command 無線設定 -reset

		eval( $s:登場ポイント = 操舵室調査デモ終了 )

		command パッド操作 -release
		command プレイヤー無敵セット
		mesg シネマスクリーン シネマ フェードアウト 1
		command メニュー設定 -menu off -gage off -radar off -subwin off -radio off -pause off

		// カメラアングルの変更
		chara カメラ設定 サブカメラ２ \
			-c 1 \
			-p 261,13593,-18411 -t -516,13329,-19887 \
			-r 102,2364,0 -f 1689 \
			-a 200 \
			-i 1 -1 0 0 \
			-s 1

		// 操舵を調べるスネーク
		mesg プレイヤー d:PLAYER motion \
			d:モーションリスト:sna_non_operation_w01e \
			2048 2048 0 \
			0x00001000 \	//フラグ
			-700 -19580 13024


		// 強制無線開始
		chara delay ディレイ -time 500 -exec {
			/*
			// 強制無線をかけられるようにする
			command メニュー設定 -radio on
			chara delay ディレイ -time 60 -exec {
				@rt_強制ＣＡＬＬ_04a0R操舵室無線機デモ
			}
			*/
			@PR操舵室調査シナリオデモプロック終了
		}
/*
		// モーションが長いので途中で終了
		chara delay ディレイ -time 543 -exec {
			command 強制モーションキャンセル
		}
*/

		// キャンセルプロックの登録
		chara デモキャンセルチェック CH操舵デモキャンセル \
			-p PR操舵デモキャンセル


		// 終了プロックの登録
		command	強制モーション終了プロック \
			-motion 0 \
			-proc PR操舵室調査シナリオデモプロック終了

	}

	// 操舵室デモ終了
	proc PR操舵室調査シナリオデモプロック終了 {
print 'PR操舵室調査シナリオデモプロック終了'
		eval($w:t_story = d:ST_操舵室調査シナリオデモ終了)

		// キャンセルコールバック関数を殺す
		mesg デモキャンセルチェック CH操舵デモキャンセル kill

		// 強制モーション終了後、パッド操作が戻されている可能性があるので再びリリース
		command パッド操作 -release

		// カメラを元に戻す
//		chara カメラ設定 サブカメラ２ -s -1

/*
		// スネークの位置をパッドデモの開始位置まで飛ばす
		mesg プレイヤー d:PLAYER position -497 13028 -19702
*/

		// 強制無線をかけられるようにする
		command メニュー設定 -radio on

		// 強制無線開始
		chara delay ディレイ -time 1 -exec {
			@rt_強制ＣＡＬＬ_04a0R操舵室無線機デモ
		}
	}

	// 操舵室デモキャンセル
	proc PR操舵デモキャンセル {
print 'PR操舵デモキャンセル'
/*
		chara フェードインアウト フェードアウト \
			-c 0,0,0 128 \
			-t d:FADEOUT_TIME \
			-p PR操舵デモキャンセル後
*/
		command 強制モーションキャンセル
	}

/*
	proc PR操舵デモキャンセル後 {
print 'PR操舵デモキャンセル後'
		command 強制モーションキャンセル

		chara フェードインアウト フェードイン \
			-i 0,0,0 128 \
			-c 0,0,0 0 \
			-t d:FADEIN_TIME \
		command 強制モーションキャンセル
	}
*/
/************************************************************************************************/
// 強制無線																						*/
/************************************************************************************************/

	proc rt_強制ＣＡＬＬ_04a0R操舵室無線機デモ終了 {
print 'rt_強制ＣＡＬＬ_04a0R操舵室無線機デモ終了'

		eval($w:t_story = d:ST_操舵室無線機デモ終了)
		eval( $s:登場ポイント = 操舵室無線機デモ終了)

		eval($f:global_polygon_demo = 1)

		restart -save

		//@PRオルガパッドデモ
	}

proc オルガ発見デモプロック {
	restart -save
}
/************************************************************************************************/
// オルガパッドデモ																				*/
/************************************************************************************************/

	// デモを再生するプロック
	proc デモ再生_t04a2D {
#if d:デモ前五秒間待ち
		chara デモアクトデバッグ demodebug  -i t:t04a2D -d 't04a2D' -s 't04a2D' \
			-next ld_next_stage
#else
		chara demo デモ再生 \
			-i t:t04a2D \			// ストリーミング用t:シンボル pre_orga_1st_half (前半)
			-next ld_next_stage		// 終了時に呼び出されるproc
#endif
	}

	proc オルガデモ再生プロック {

		// ポリデモ中
		eval($f:global_polygon_demo = 1)

		@シネマスクリーンセット
		mesg シネマスクリーン シネマ フェードアウト 1

#if d:デモ前五秒間待ち
		eval($w:t_story = d:ST_操舵室無線機デモ終了)
		@global_五秒待ちセット
		if($f:global_デバッグポーズ通過){
			@デモ再生_t04a2D
		}
#else
		@デモモデル差し替え処理
		@デモ再生_t04a2D
#endif

		chara デモキャンセルチェック デモキャンセル \
			-p デモキャンセル
	}

	// デモ終了時に呼び出されるプロック
	proc ld_next_stage {
		if ( `command ゲームオーバーチェック` == 0 ) {
			mesg デモキャンセルチェック デモキャンセル kill

			// ポリデモじゃなくなります。
			eval($f:global_polygon_demo = 0)

			eval($w:t_story = d:ST_操舵室退出シナリオデモ開始)
			eval($s:登場ポイント = オルガデモ終了 )

			eval( $i:プレイヤー初期Ｘ位置 = -850 )
			eval( $i:プレイヤー初期Ｙ位置 = 13024 )
			eval( $i:プレイヤー初期Ｚ位置 = -19731 )
			eval( $i:プレイヤー初期方向 = 3342 )

			mesg シネマスクリーン シネマ フェードイン 1

			chara delay ディレイ \
				-time 1 \
				-exec{
					restart -save
				}
		}
	}

	// デモキャンセル時に呼び出されるプロック
	proc デモキャンセル {

		chara フェードインアウト フェードアウト \
			-c 0,0,0 128 \
			-t d:FADEOUT_TIME \
			-p オルガデモキャンセルプロック
	}

	proc オルガデモキャンセルプロック {
		command StreamStopAll
	}

	proc オルガデモ終了後プロック {
		command パッド操作 -cancel
	}

/*****************************************************************************************/

proc 下階層水飛沫セット {
	chara ライン水飛沫 柵水飛沫 \
		-n 13 \
		-d \
		   2 20 5 64 -12000 13000 -19900 -6000 13000 -19900 \
		   2 20 5 64 -19850 13750 -19900 -12000 13750 -19900 \
		   2 20 5 64 -19850 13750 -19950 -19850 13750 -14150 \
		   2 20 5 64 -19850 13750 -14150 -12000 13750 -12100 \
		   1 20 5 64 -11950 13000 -12000 -11950 13000 -9100 \
		   1 20 5 64 11950 13000 -12000 11950 13000 -9100 \
		   2 20 5 64 -11950 13000 -9100 -6950 13000 -9100 \
		   2 20 5 64 11950 13000 -9100 6950 13000 -9100 \
		   1 20 5 64 -6950 13000 -9100 -6950 13000 -7100 \
		   1 20 5 64 6950 13000 -9100 6950 13000 -7100 \
		   3 20 5 64 -6950 13000 -7100 6950 13000 -7100 \
		   1 1050 15 96 -13000 13750 -18150 -13000 13750 -18150 \
		   1 520 15 96 -13750 15000 -14500 -13750 15000 -14000
}

// 箱への水飛沫
proc 飛沫鉄箱１{
	chara ライン水飛沫 line_splash \
		-n 1 \
		-l 5000 \
		-d 1 1025 50 64 -10250 13100 -19000 -9750 13100 -19000
}
proc 飛沫木箱１{
	chara ライン水飛沫 line_splash \
		-n 1 \
		-l 5000 \
		-d 1 1025 50 96 -10000 13100 -16000 -10000 13100 -16000
}
proc 飛沫木箱２{
	chara ライン水飛沫 line_splash \
		-n 1 \
		-l 5000 \
		-d 1 1025 50 96 -10000 13100 -14800 -10000 13100 -14800
}
proc 飛沫鉄箱２{
	chara 斜め回転床水飛沫 飛沫鉄箱２ \
		-n 2 \			// ３２枚の何倍？
