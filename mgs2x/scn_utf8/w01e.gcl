	chara 鏡面モデル管理 床面映り込み \
		-pos 0,12000,0 \
		-axis 1 // Y軸反転

	//mesg 鏡面モデル管理 床面映り込み add スネーク
	trap ev007 d:PLAYER \
	-mask ？ \
	-exec {
		if( $3 == 入る ) {
			mesg 鏡面モデル管理 床面映り込み add スネーク
		}else if( $3 == 出る ){
			mesg 鏡面モデル管理 床面映り込み del スネーク
		}
	}
#endif
}

