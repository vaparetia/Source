proc rp_ＳＡＶＥデフォルトセット:02 {
	selectmenu  2 -m  { 
		[ＳＡＶＥ選択肢__f:セーブする] 
		[ＳＡＶＥ選択肢__f:セーブしない] 
	}
	eval($w:rfp_ＳＡＶＥ選択肢返り値 = $status)
	print 'ぐあだららじょぶ$w:rfp_ＳＡＶＥ選択肢返り値:' $w:rfp_ＳＡＶＥ選択肢返り値
}

proc rt_ＳＡＶＥデフォルトセット:02 {
print 'ほげほほほ'
	#ifdef d:EU_TRIAL
	selectmenu  1 -m  { 
		[ＳＡＶＥ選択肢__f:セーブしない] 
	}
	eval($w:rft_ＳＡＶＥ選択肢返り値 = 1)
	#else
	selectmenu  2 -m  { 
		[ＳＡＶＥ選択肢__f:セーブする] 
		[ＳＡＶＥ選択肢__f:セーブしない] 
	}
	#endif
	eval($w:rft_ＳＡＶＥ選択肢返り値 = $status)
print 'ぷにょあよあああ'
}

proc rp_ＳＡＶＥさせないセット:02 {
	selectmenu  2 -m  { 
		[ＳＡＶＥ選択肢__f:セーブさせない] 
		[ＳＡＶＥ選択肢__f:セーブしない] 
	}
	eval($w:rfp_ＳＡＶＥ選択肢返り値 = $status)
	print 'ぐあだららじょぶ$w:rfp_ＳＡＶＥ選択肢返り値:' $w:rfp_ＳＡＶＥ選択肢返り値
}

