//
//	t_demo_j.ct
//	タンカー編デモ無線日本語版のtalk文を集めたものだったらどうするよ？まぢでさ！？
//
//	2000/11/29	T.Fukushima
//	$Id: t_demo_j.ct,v 1.14 2002/06/07 09:53:01 usr01475 Exp $

proc vc050101:07{
vox t:vc050101 {
@rt_うなづきデフォルト
	talk スネーク 標準 -m {
		[T_00b1Rオープニング無線機デモ:スネーク_000]
		//こちらスネーク、
		//聞こえるか、オタコン？
	}
	talk オタコン 標準 -m {
		[T_00b1Rオープニング無線機デモ:オタコン_001]
		//ああ僕だよ、スネーク。
		//聞こえる……。
	}

	talk スネーク 標準 -m {
		[T_00b1Rオープニング無線機デモ:スネーク_002]
		//……待たせたな。
		//＃｛潜入、スニーク｝＃ポイントに到着……。
	}

	talk オタコン 標準 -m {
		[T_00b1Rオープニング無線機デモ:オタコン_003]
		//うまくいったかい？
	}

	talk スネーク 標準 -m {
		[T_00b1Rオープニング無線機デモ:スネーク_004]
		//着地の衝撃でステルス迷彩が壊れた。
	}

@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[T_00b1Rオープニング無線機デモ:オタコン_005]
		//随分こき使ってきたからね……。
		//悪いけど我慢してくれ。
		//軍じゃないんだ。
	}

	talk スネーク 標準 -m {
		[T_00b1Rオープニング無線機デモ:スネーク_006]
		//ああ。いつまでも＃｛ステルス迷彩、こんなもの｝＃に
		//頼るつもりはない。
	}

	talk オタコン 標準 -m {
		[T_00b1Rオープニング無線機デモ:オタコン_007]
		//だけど民間のいいところもあるだろ？
		//プライバシーは守られてるし……。
	}

	talk スネーク 標準 -m {
		[T_00b1Rオープニング無線機デモ:スネーク_008]
		//変な薬も盛られずに済むしな。
	}

@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[T_00b1Rオープニング無線機デモ:オタコン_009]
		//ナオミの事……？
	}

	talk スネーク 標準 -m {
		[T_00b1Rオープニング無線機デモ:スネーク_010]
		//うるさい見張り役がいないのも気が楽だ。
	}

	talk オタコン 標準 -m {
		[T_00b1Rオープニング無線機デモ:オタコン_011]
		//メイ・リンか……。
		//また彼女に頼んでおくよ。
		//＃｛ＮＡＴＩＣＫ、ナティック｝＃の新兵器。
	}

	talk スネーク 標準 -m {
		[T_00b1Rオープニング無線機デモ:スネーク_012]
		//＃｛陸軍兵士システムセンター、ＮＡＴＩＣＫ｝＃からの
		//横流しか。彼女に伝えておいてくれ。
	}
@rt_うなづきデフォルト

	talk スネーク 標準 -m {
		[T_00b1Rオープニング無線機デモ:スネーク_013]
		//いずれはバレる。
		//早いうちに手を引くようにな。
	}

	talk オタコン 標準 -m {
		[T_00b1Rオープニング無線機デモ:オタコン_014]
		//それもそうだね……。
		//じゃあスネーク、本題に入るよ。
	}
}
}

proc vc050204:07 {
vox t:vc050204 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[T_00b1Rオープニング無線機デモ:オタコン_015]
		//シャドーモセス事件の後、メタルギアの
		//技術情報が＃｛闇市場、ブラックマーケット｝＃で密売されたよね。
	}

	talk スネーク 標準 -m {
		[T_00b1Rオープニング無線機デモ:スネーク_016]
		//オセロットの仕業だ。
	}

	talk オタコン 標準 -m {
		[T_00b1Rオープニング無線機デモ:オタコン_017]
		//ああ。それで全世界にメタルギアの
		//亜種が拡散した。
	}

	talk スネーク 標準 -m {
		[T_00b1Rオープニング無線機デモ:スネーク_018]
		//いまや核武装国にとって、
		//メタルギアは特別な兵器ではない。
	}

@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[T_00b1Rオープニング無線機デモ:オタコン_019]
		//今回の新型はそれらに対抗する為に
		//設計されたものらしい。水陸両用の
		//対メタルギア兵器……。
	}

	talk スネーク 標準 -m {
		[T_00b1Rオープニング無線機デモ:スネーク_020]
		//それで新型は海兵隊の所属って訳か……？
	}
}
}


proc vc050301:07 {
vox t:vc050301 {
	talk スネーク 標準 -m {
		[T_03b1Rカモフ登場後無線機デモ体験版:スネーク_000]
	}

	talk オタコン 標準 -m {
		[T_03b1Rカモフ登場後無線機デモ体験版:オタコン_001]
	}

	talk スネーク 標準 -m {
		[T_03b1Rカモフ登場後無線機デモ体験版:スネーク_002]
	}

	talk オタコン 標準 -m {
		[T_03b1Rカモフ登場後無線機デモ体験版:オタコン_003]
	}

	talk オタコン 標準 -m {
		[T_03b1Rカモフ登場後無線機デモ体験版:オタコン_004]
	}

	talk スネーク 標準 -m {
		[T_03b1Rカモフ登場後無線機デモ体験版:スネーク_005]
	}
}
}

// added by S.Hirano 01/03/02
// modified by Fukushimia 01/05/14
proc vc050302:07 {
vox t:vc050302 {
@rt_うなづきデフォルト
	talk スネーク 標準 -m {
		[T_03b1Rカモフ登場後無線機デモ製品版:スネーク_000]
		//奴等の正体を調べる必要があるな。
	}

	talk オタコン 標準 -m {
		[T_03b1Rカモフ登場後無線機デモ製品版:オタコン_001]
		//そんなもの飛ばしてるなんて、
		//どこかの軍隊かな？
	}

	talk スネーク 標準 -m {
		[T_03b1Rカモフ登場後無線機デモ製品版:スネーク_002]
		//いや、そうとも言えない。
		//民間型のＫＡ-６２かもしれない。
	}

@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[T_03b1Rカモフ登場後無線機デモ製品版:オタコン_003]
		//いいかい、スネーク。
		//必要なのはメタルギア開発の
		//証拠写真だ。
	}

	talk オタコン 標準 -m {
		[T_03b1Rカモフ登場後無線機デモ製品版:オタコン_004]
		//それさえあればいい。
		//あとはＮＧＯのＨＰに掲載して
		//情報を公開する……。
	}

	talk オタコン 標準 -m {
		[T_03b1Rカモフ登場後無線機デモ製品版:オタコン_005]
		//いいね、手荒な真似は
		//しないでくれよ。
	}

	talk スネーク 標準 -m {
		[T_03b1Rカモフ登場後無線機デモ製品版:スネーク_006]
		//わかった、努力する。
	}

@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[T_03b1Rカモフ登場後無線機デモ製品版:オタコン_007]
		//シャドーモセスの時とは違うんだ。
		//何かあったらすぐ連絡してくれ。
	}
	talk オタコン 標準 -m {
		[T_03b1Rカモフ登場後無線機デモ製品版:オタコン_008]
		//周波数は１４１．１２だ。
	}

	talk スネーク 標準 -m {
		[T_03b1Rカモフ登場後無線機デモ製品版:スネーク_009]
		//データの記録はどうする？
	}

	talk オタコン 標準 -m {
		[T_03b1Rカモフ登場後無線機デモ製品版:オタコン_010]
		//僕がするよ。
		//＃｛記録、セーブ｝＃用の専用回線は１４０．９６……。
	}

@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[T_03b1Rカモフ登場後無線機デモ製品版:オタコン_011]
		//メイ・リンじゃなくて残念だけど。
	}

	talk オタコン 標準 -m {
		[T_03b1Rカモフ登場後無線機デモ製品版:オタコン_012]
		//＃｛記録、セーブ｝＃したい時はこっちに無線して
		//くれればいい。
	}

	talk スネーク 標準 -m {
		[T_03b1Rカモフ登場後無線機デモ製品版:スネーク_013]
		//ああ……。
	}

@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[T_03b1Rカモフ登場後無線機デモ製品版:オタコン_014]
		//ベラザノ橋を越えた所で待ってる。
		//それまでに離脱するんだ。
	}

	talk スネーク 標準 -m {
		[T_03b1Rカモフ登場後無線機デモ製品版:スネーク_015]
		//また連絡する。
	}

}//v
}//d


proc vc050401:07{
vox t:vc050401 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[T_04a0R操舵室無線機デモ:オタコン_000]
		//スネーク、その船の行き先は
		//分かったかい？
	}

	talk スネーク 標準 -m {
		[T_04a0R操舵室無線機デモ:スネーク_001]
		//ああ。北緯三十五度、西経五十八度の
		//あたりのようだ。
	}

	talk オタコン 標準 -m {
		[T_04a0R操舵室無線機デモ:オタコン_002]
		//バミューダ島の沖、８００キロ位か。
		//大西洋のど真ん中……。
	}

@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[T_04a0R操舵室無線機デモ:オタコン_003]
		//新型メタルギアは単独演習が可能なほど
		//完成してるのか……？
	}

	talk オタコン 標準 -m {
		[T_04a0R操舵室無線機デモ:オタコン_004]
		//それにそのあたりは海軍第二艦隊の
		//作戦海域からも外れてる。完全に
		//海兵隊独自のプロジェクトってことだね。
	}

	talk オタコン 標準 -m {
		[T_04a0R操舵室無線機デモ:オタコン_005]
		//……ということは新型メタルギアは
		//海軍の支援なしで単独作戦行動を
		//行う性能を持っている……？
	}

@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[T_04a0R操舵室無線機デモ:オタコン_006]
		//うん、まあ詳しいデータは後で分析する
		//ことにするよ。スネークは次に船倉に
		//行ってメタルギア本体を……。
	}

	talk スネーク 標準 -m {
		[T_04a0R操舵室無線機デモ:スネーク_007]
		//？
	}
}
}


// 新規作成分
proc vc080101:07 {
vox t:vc080101 {
@rt_うなづきデフォルト
	talk スネーク 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ１:スネーク_000]
		//オタコン、船は奴等の手に
		//落ちたようだ。
	}

	talk スネーク 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ１:スネーク_001]
		//連中、兵装はロシア製だが、
		//身元がわかるようなものは何もない。
	}

	talk オタコン 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ１:オタコン_002]
		//僕の方ではつかめたよ。
	}

	talk スネーク 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ１:スネーク_003]
		//何？
	}

@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ１:オタコン_004]
		//さっきの男の正体がわかったんだ。
	}

	talk スネーク 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ１:スネーク_005]
		//誰だ？
	}

	talk オタコン 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ１:オタコン_006]
		//セルゲイ・ゴルルコビッチ。
	}

	talk スネーク 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ１:スネーク_007]
		//ゴルルコビッチ！
		//……オセロットが手を組んでいた？
	}

}
}

// 新規作成分
//むびＸＸＸＸＸＸＸＸＸ
proc vc080102:07 {
movie t:vc080102 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ２:オタコン_008]
		//そうだよ。シャドーモセスで
		//オセロットが合流しようとしていた
		//元ＧＲＵの大佐……。
	}

	talk スネーク 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ２:スネーク_009]
		//奴等がメタルギアを……。
	}

	talk オタコン 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ２:オタコン_010]
		//状況が変わった。
		//もう単純にはいきそうもないよ。
	}

	talk スネーク 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ２:スネーク_011]
		//確かに。俺も今、サイファーらしき
		//＃｛無人偵察機、ＵＡＶ｝＃を見た。
	}

@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ２:オタコン_012]
		//海兵隊のサイファーＴ？
	}

	talk スネーク 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ２:スネーク_013]
		//いや。陸軍のだ。
	}
}//v
}//d

proc vc080201:07 {
vox t:vc080201 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ２:オタコン_014]
		//海兵隊にロシア兵、それに陸軍……？
	}

	talk スネーク 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ２:スネーク_015]
		//お前の言うとおり、単純ではなくなって
		//きたようだな。
	}

	talk オタコン 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ２:オタコン_016]
		//……スネーク……実は……。
	}

	talk スネーク 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ２:スネーク_017]
		//何かあるのか？
	}

@rt_騙された＿否＿騙したな系デフォルト 100
@rt_うなづきデフォルト＿是

	talk オタコン 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ２:オタコン_018]
		//今回の新型メタルギアのネタ
		//なんだけど……いつもみたいに、
		//独自に得た情報じゃないんだ。
	}

	talk スネーク 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ２:スネーク_019]
		//それじゃ？
	}

	talk オタコン 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ２:オタコン_020]
		//タレコミなんだ……匿名の。
	}

	talk スネーク 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ２:スネーク_021]
		//匿名？ そんな情報を信じるような
		//お前じゃないはず？
	}

@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ２:オタコン_022]
		//実は……
		//僕には妹がいるんだ。
		//血の繋がらない……。
	}

	talk オタコン 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ２:オタコン_023]
		//一緒に暮らしたのはたった二年だけど。
	}

	talk スネーク 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ２:スネーク_024]
		//初めて聞くな。それで……。
	}

	talk オタコン 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ２:オタコン_025]
		//タレコミメールの発信名に『ＥＥ』と
		//あったんだ……。
	}

	talk スネーク 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ２:スネーク_026]
		//ＥＥ？
	}

@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ２:オタコン_027]
		//エマっていう名前なんだけど、
		//僕はＥＥって呼んでた。
	}

	talk スネーク 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ２:スネーク_028]
		//エマ・エメリッヒ？
	}

	talk オタコン 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ２:オタコン_029]
		//そうだよ。懐かしい響きだった……。
	}

	talk オタコン 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ２:オタコン_030]
		//偶然かもしれないけど、
		//気になって……。
	}

@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ２:オタコン_030_2]
		//妹の事を知ってる人間は
		//ほとんどいないんだ。
	}

	talk スネーク 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ２:スネーク_031]
		//彼女とは？
	}

	talk オタコン 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ２:オタコン_032]
		//もう十何年も会ってない。
	}

	talk スネーク 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ２:スネーク_033]
		//罠だと思うか？
		//俺達をおびき寄せる……？
	}

@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ２:オタコン_034]
		//わからない。ただ……タレコミの後、
		//ペンタゴンのファイルに潜り込んで
		//裏は取ったんだ……。
	}

	talk スネーク 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ２:スネーク_035]
		//わかった……。
	}

	talk オタコン 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ２:オタコン_036]
		//すまない……スネーク。
		//気をつけてね。
	}

	talk スネーク 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ２:スネーク_037]
		//ＵＳＰを手に入れた。
		//これで奴等と対等だ。
	}

	talk スネーク 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ２:スネーク_038]
		//弾倉は空だが、海兵隊のＭ９と同じ
		//９ミリ弾を使う。弾はどこかで補給
		//できるだろう。
	}

	talk スネーク 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ２:スネーク_039]
		//フラッシュライトも装備されている。
	}

@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ２:オタコン_040]
		//でも、銃声には注意してね。
	}

	talk スネーク 標準 -m {
		[T_06b1Rオルガ戦勝利後無線機デモ２:スネーク_041]
		//ああ。
	}
}//v
}//d


// 新規作成分
proc vc080301:07 {
vox t:vc080301 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[T_09b1R船倉無線機デモ１:オタコン_000]
		//スネーク、まだかい？
		//船倉に進入した？
	}

	talk スネーク 標準 -m {
		[T_09b1R船倉無線機デモ１:スネーク_001]
		//予定より手間取っている……。
		//既にベラザノ橋を通過した。
	}

	talk オタコン 標準 -m {
		[T_09b1R船倉無線機デモ１:オタコン_002]
		//わかった。＃｛回収、リカバリー｝ポイントを
		//変更するよ。
	}

	talk スネーク 標準 -m {
		[T_09b1R船倉無線機デモ１:スネーク_003]
		//航路を変更するつもりかもしれん。
	}

@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[T_09b1R船倉無線機デモ１:オタコン_004]
		//なんだって？
	}

	talk スネーク 標準 -m {
		[T_09b1R船倉無線機デモ１:スネーク_005]
		//上への出口が塞がれた……。
	}

	talk オタコン 標準 -m {
		[T_09b1R船倉無線機デモ１:オタコン_006]
		//連中、どうするつもりなんだ。
	}

	talk スネーク 標準 -m {
		[T_09b1R船倉無線機デモ１:スネーク_007]
		//奴等の手にメタルギアが渡れば
		//大変な事になる……。
	}

}
}

