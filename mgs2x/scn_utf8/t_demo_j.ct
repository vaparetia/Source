//いろいろわかれたーよＸＸＸＸＸＸＸＸＸＸ
// 新規作成分
proc vc080401:07 {
vox t:vc080401 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[T_10b1R船倉無線機デモ２:オタコン_000]
		//スネーク、もう一度確認するね。
	}

	talk オタコン 標準 -m {
		[T_10b1R船倉無線機デモ２:オタコン_001]
		//カメラで新型メタルギアの
		//写真を撮ってくれ。
	}

	talk オタコン 標準 -m {
		[T_10b1R船倉無線機デモ２:オタコン_002]
		//政府がシラを切れないような
		//証拠写真を頼む。
	}

@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[T_10b1R船倉無線機デモ２:オタコン_003]
		//写真は四枚欲しい。
	}

	talk オタコン 標準 -m {
		[T_10b1R船倉無線機デモ２:オタコン_004]
		//メタルギアを右斜め前、正面、
		//左斜め前の三方向から撮ったものと、
		//海兵隊のマーキングのアップだ。
	}

	talk スネーク 標準 -m {
		[T_10b1R船倉無線機デモ２:スネーク_005]
		//マーキング？
	}
}//v
}//d

proc vc080402:07{
movie t:vc080402 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[T_10b1R船倉無線機デモ２:オタコン_006]
		//メタルギアのどこかに海兵隊の
		//所属であることを表す＃｛ＭＡＲＩＮＥＳ、マリーンズ｝
		//っていうマーキングがあるはずなんだ。
	}

	talk オタコン 標準 -m {
		[T_10b1R船倉無線機デモ２:オタコン_007]
		//それがはっきり写っているのが一枚
		//欲しい。言い逃れされないためにね。
	}
}//v
}//d

proc vc080403:07 {
vox t:vc080403 {
@rt_うなづきデフォルト
	talk スネーク 標準 -m {
		[T_10b1R船倉無線機デモ２:スネーク_008]
		//わかった。
	}

	talk オタコン 標準 -m {
		[T_10b1R船倉無線機デモ２:オタコン_009]
		//……実はあと一つ問題があって。
	}

	talk スネーク 標準 -m {
		[T_10b1R船倉無線機デモ２:スネーク_010]
		//遠慮せずに言え。
		//厄介事が増えることには馴れている。
	}

@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[T_10b1R船倉無線機デモ２:オタコン_011]
		//誰かが僕らの通信をモニターしてる
		//気配があるんだ。
	}

	talk スネーク 標準 -m {
		[T_10b1R船倉無線機デモ２:スネーク_012]
		//何者だ？
	}

	talk オタコン 標準 -m {
		[T_10b1R船倉無線機デモ２:オタコン_013]
		//わからない。
	}

	talk オタコン 標準 -m {
		[T_10b1R船倉無線機デモ２:オタコン_014]
		//だけどモニターしてるだけで
		//妨害しようって様子はないんだ。
		//それがかえって不気味で……。
	}

	talk スネーク 標準 -m {
		[T_10b1R船倉無線機デモ２:スネーク_015]
		//さっきのサイファーとも関係が？
	}

@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[T_10b1R船倉無線機デモ２:オタコン_016]
		//どうかな。
	}

	talk オタコン 標準 -m {
		[T_10b1R船倉無線機デモ２:オタコン_017]
		//とりあえずバースト通信の暗号化
		//プロトコルを別のに切り替えてる。
	}

	talk オタコン 標準 -m {
		[T_10b1R船倉無線機デモ２:オタコン_018]
		//あと、念の為に写真の送信経路を
		//変えたいんだ。
	}
	talk スネーク 標準 -m {
		[T_10b1R船倉無線機デモ２:スネーク_019]
		//この無線を使わずに写真を
		//送るってことか？
	}
}//v
}//d

proc vc080404:07{
movie t:vc080404 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[T_10b1R船倉無線機デモ２:オタコン_020]
		//そう。船倉の一番奥、メタルギアがある
		//ブロックの南東にコンピュータが一台
		//置いてある。
	}

	talk オタコン 標準 -m {
		[T_10b1R船倉無線機デモ２:オタコン_021]
		//そこから写真を送信出来るように
		//細工しておいた。
	}
}//v
}//d

proc vc080405:07 {
vox t:vc080405 {
@rt_うなづきデフォルト
	talk スネーク 標準 -m {
		[T_10b1R船倉無線機デモ２:スネーク_022]
		//細工？ どうやったんだ？
	}

	talk オタコン 標準 -m {
		[T_10b1R船倉無線機デモ２:オタコン_023]
		//軍事ネットワークのリンク１６経由で
		//その＃｛ＷＳ、ワークステーション｝に侵入して＃－
	}

@rt_うんちく＿否＿わからん系デフォルト 100
@rt_うんちく＿是＿詳しいな系デフォルト 50
	talk オタコン 標準 -m {
		[T_10b1R船倉無線機デモ２:オタコン_024]
		//システムの一部を書き換えて
		//僕が作った特製のアプリを
		//リモート・インストールして……。
	}

	talk スネーク 標準 -m {
		[T_10b1R船倉無線機デモ２:スネーク_025]
		//面倒なことを……。
	}

	talk オタコン 標準 -m {
		[T_10b1R船倉無線機デモ２:オタコン_026]
		//いや、やり方は簡単だよ。スネークは
		//マシンの前で＃｛△、アクション｝＃ボタンを押す
		//だけでいい。
	}

	talk オタコン 標準 -m {
		[T_10b1R船倉無線機デモ２:オタコン_027]
		//それでアプリが自動的に立ち上がって
		//写真のデータを読み取り、分割後暗号化
		//する。
	}

	talk オタコン 標準 -m {
		[T_10b1R船倉無線機デモ２:オタコン_028]
		//データは偽装されたパケットに
		//格納されて……。
	}

	talk スネーク 標準 -m {
		[T_10b1R船倉無線機デモ２:スネーク_029]
		//わかった。
		//写真を撮ったらコンピュータの前で
		//＃｛△、アクション｝＃ボタンを押せば良いんだな。
	}

@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[T_10b1R船倉無線機デモ２:オタコン_030]
		//うん、まあ、そうだ。
	}

	talk オタコン 標準 -m {
		[T_10b1R船倉無線機デモ２:オタコン_031]
		//それと……注意して欲しいのは、
		//既に演説が始まってる。
	}

	talk オタコン 標準 -m {
		[T_10b1R船倉無線機デモ２:オタコン_032]
		//演説が終わるまでに撮影しないと
		//発見されるよ、いいね？
	}

	talk スネーク 標準 -m {
		[T_10b1R船倉無線機デモ２:スネーク_033]
		//どれくらい余裕があるんだ？
	}

@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[T_10b1R船倉無線機デモ２:オタコン_034]
		//今日の司令官の原稿をハックした。
		//だいたい７分てところだ。
	}

	talk オタコン 標準 -m {
		[T_10b1R船倉無線機デモ２:オタコン_035]
		//アドリブがなければだけど……。
	}

	talk スネーク 標準 -m {
		[T_10b1R船倉無線機デモ２:スネーク_036]
		//７分がタイムリミットか。
	}

	talk オタコン 標準 -m {
		[T_10b1R船倉無線機デモ２:オタコン_037]
		//スネーク、写真だけだよ。
	}

	talk スネーク 標準 -m {
		[T_10b1R船倉無線機デモ２:スネーク_038]
		//この数だ。
		//そんな気は起こしようもない。
	}

	talk スネーク 標準 -m {
		[T_10b1R船倉無線機デモ２:スネーク_039]
		//しかし、奴等に＃｛新型、アレ｝を
		//渡すわけにもいかない。
	}

@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[T_10b1R船倉無線機デモ２:オタコン_040]
		//そうだけど、まずは写真を……。
	}

	talk スネーク 標準 -m {
		[T_10b1R船倉無線機デモ２:スネーク_041]
		//わかった。
		//後の事はそれから考える。
	}

	talk オタコン 標準 -m {
		[T_10b1R船倉無線機デモ２:オタコン_042]
		//それじゃ、見つからないようにね。
	}

}//v
}//d

