		(d:_CS_E___LV1_+05), (d:_CT_NW__LV1_+06), (d:_CS_N___LV2_+07), (d:_CT_SW__LV1_+08), (d:_CS_S___LV1_+09), (d:_CT_NE__LV1_+10), (d:_B3_T1__LV1_+02), (d:_D2_S___LV1_+02), \
		(d:_CS_W___LV1_+05), (d:_CT_SE__LV1_+06), (d:_CS_E___LV1_+07), (d:_CT_NW__LV1_+08), (d:_CS_N___LV2_+09), (d:_CT_SW__LV1_+10), (d:_B3_T2__LV1_+00), (d:_D2_S___LV1_+01), \
		(d:_CT_NW__LV1_+05), (d:_CS_S___LV1_+06), (d:_CT_NE__LV1_+07), (d:_CS_W___LV1_+08), (d:_CT_SE__LV1_+09), (d:_CS_E___LV1_+10), (d:_B3_S1__LV1_+00), (d:_D2_S___LV1_+00), \
		(d:_CT_SE__LV1_+05), (d:_CS_N___LV2_+06), (d:_CT_SW__LV1_+07), (d:_CS_S___LV1_+08), (d:_CT_NE__LV1_+09), (d:_CS_W___LV1_+10), (d:_B3_S1__LV1_+02), (d:_D2_T___LV1_+01), \
		(d:_CT_NE__LV1_+05), (d:_CS_E___LV1_+06), (d:_CT_NW__LV1_+07), (d:_CS_N___LV2_+08), (d:_CT_SW__LV1_+09), (d:_CS_S___LV1_+10), (d:_B3_S2__LV1_+01), (d:_D2_T___LV1_+00), \
