		(d:_CS_S___LV1_+09), (d:_CS_W___LV1_+03), (d:_CS_E___LV1_+03), (d:_CT_SW__LV1_+04), (d:_CT_NW__LV1_+04), (d:_B2_S1__LV1_+04), (d:_B3_S1__LV1_+04), (d:_B3_T1__LV1_+02), \
		(d:_CS_S___LV1_+10), (d:_CS_W___LV1_+07), (d:_CS_E___LV1_+10), (d:_CT_SW__LV1_+03), (d:_CT_NW__LV1_+03), (d:_B2_S1__LV1_+03), (d:_B3_S1__LV1_+05), (d:_B3_S2__LV1_+00), \
		(d:_CT_SE__LV1_+10), (d:_CS_W___LV1_+10), (d:_CS_E___LV1_+07), (d:_CT_SW__LV1_+10), (d:_CT_NW__LV1_+09), (d:_B2_S1__LV1_+02), (d:_B3_S1__LV1_+06), (d:_B3_S2__LV1_+01), \
