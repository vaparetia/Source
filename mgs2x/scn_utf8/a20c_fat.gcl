//=============================================================================
// メイン
//=============================================================================

//-----------------------------------------------------------------------------
// ＦＡＴ難易度設定

proc ＦＡＴ難易度設定 {
#if d:DEBUG_PRINT
	print '*** FAT Game Level Set ***'
#endif

	// ＨＡＲＤ
	eval($i:w20c_ＦＡＴ耐久値             =    4)
	eval($i:w20c_ＦＡＴ耐久値回復フレーム =   60)
	eval($i:w20c_ＦＡＴ体力               =  384)
	eval($i:w20c_ＦＡＴ攻撃力割合         =  110)
	eval($i:w20c_ＦＡＴ爆弾難度レート１   =   10)
	eval($i:w20c_ＦＡＴ爆弾難度レート２   =   10)
	eval($i:w20c_ＦＡＴ爆弾難度レート３   =   40)
	eval($i:w20c_ＦＡＴ爆弾難度レート４   =   40)
	eval($i:w20c_ＦＡＴ爆弾設置最低数     =    3)
	eval($i:w20c_ＦＡＴ爆弾設置最大数     =    4)
	eval($i:w20c_ＦＡＴタイマーベース値   = 1500)
	eval($i:w20c_ＦＡＴタイマー加算値     =  900)
}

//-----------------------------------------------------------------------------
// Ｃ４撃ったらゲームオーバー

proc Ｃ４撃ったらゲームオーバー {
#if d:DEBUG_PRINT
	print '*** C4 Shot Game Over ***'
#endif

	@Ｃ４爆発ゲームオーバー処理 $3 $4 $5
}

//-----------------------------------------------------------------------------
// Ｃ４爆発ゲームオーバー

proc Ｃ４爆発ゲームオーバー {
#if d:DEBUG_PRINT
	print '*** C4 Explode Game Over ***'
#endif

	@Ｃ４爆発ゲームオーバー処理 $1 $2 $3
}

//-----------------------------------------------------------------------------
// Ｃ４爆発ゲームオーバー処理

proc Ｃ４爆発ゲームオーバー処理 $:Ｘ座標 $:Ｙ座標 $:Ｚ座標 {
#if d:DEBUG_PRINT
	print '*** C4 Explode Game Over Routine ***'
#endif

	if(`command ゲームオーバーチェック` == 1) {
		return
	}

	command ファットマン非表示
	command カモメ非表示
	command プレイヤー不可視

	if($:Ｚ座標 < -106000) {
		// ドラム缶１
								chara カメラ設定 でもデモカメラ -c 1 -a 200 -i 0 0 0 0 -s 1 \
									-p 46620,19645,-104729 -t 48977,11996,-107866

	} else if($:Ｚ座標 < -101000) {
		if($:Ｘ座標 < 50000) {
			// コンテナ１－１
