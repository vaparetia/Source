		// 北半分
		(d:_CS_S___LV1_+00), (d:_CT_NE__LV1_+01), (d:_CS_W___LV1_+02), (d:_CT_SE__LV1_+03), (d:_CS_E___LV1_+04), (d:_B1_S1__LV1_+00), (d:_B2_T1__LV1_+00), (d:_D1_S___LV1_+00), \
		(d:_CT_NW__LV1_+00), (d:_CS_N___LV2_+01), (d:_CT_SW__LV1_+02), (d:_CS_S___LV1_+03), (d:_CT_NE__LV1_+04), (d:_B1_S1__LV1_+01), (d:_B2_T1__LV1_+01), (d:_D1_S___LV1_+01), \
		(d:_CS_W___LV1_+00), (d:_CT_SE__LV1_+01), (d:_CS_E___LV1_+02), (d:_CT_NW__LV1_+03), (d:_CS_N___LV2_+04), (d:_B1_S1__LV1_+02), (d:_B2_T1__LV1_+02), (d:_D1_S___LV1_+02), \
		(d:_CT_SW__LV1_+00), (d:_CS_S___LV1_+01), (d:_CT_NE__LV1_+02), (d:_CS_W___LV1_+03), (d:_CT_SE__LV1_+04), (d:_B1_S1__LV1_+03), (d:_B2_S1__LV1_+00), (d:_D1_S___LV1_+03), \
		(d:_CS_E___LV1_+00), (d:_CT_NW__LV1_+01), (d:_CS_N___LV2_+02), (d:_CT_SW__LV1_+03), (d:_CS_S___LV1_+04), (d:_B1_S1__LV1_+04), (d:_B2_S1__LV1_+01), (d:_D1_S___LV1_+04), \
