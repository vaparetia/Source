/*警備が厳重なのもうなずけるわね。
*/
//dv}//v
}//d

//シェル２中央棟の役割について h //e
resource PC_シェル２中央棟機能説明__i {
//vox t:vc266501 {
ローズ_000: {
Al centro di Shell 2 risiede il vero sistema
di filtrazione, o almeno ci risiedeva.
}
//	<<<ENGLISH>>>
//	The Shell 2 Core is where the
//	actual filtration system resides,
//	or at least it used to.
//<ページ数変更>
ローズ_000_1: {
Ora &`e molto pi&`u piccolo che in passato.
}
//	<<<ENGLISH>>>
//	Now it's just a shadow
//	of its former self.

/*シェル２中央棟は汚染海水を除染する
システムの本体……だった。
今は見る影もないけど……。
*/
ローズ_001: {
Qui si filtrava l'acqua mista al greggio,
}
//	<<<ENGLISH>>>
//	Here water mixed with
//	crude oil was filtered＃－
//<ページ数変更>
ローズ_001_1: {
usando batteri nella decomposizione
microbica degli idrocarburi.
}
//	<<<ENGLISH>>>
//	using antagonist bacteria in
//	the microbial decomposition
//	of hydrocarbons.

/*炭化水素分解細菌等の微生物を使って、
くみ上げた原油混じりの海水を
除染する施設。
*/
ローズ_002: {
Sotto il primo piano seminterrato c'&`e
una gigantesca vasca per questo processo.

}
//	<<<ENGLISH>>>
//	Below the first floor basement is
//	a gigantic vat for this purpose.
//<ページ数変更>
ローズ_002_1: {
Poi per&`o si &`e rotta ed ha inondato l'intero
piano.
}
//	<<<ENGLISH>>>
//	What happened was that this
//	vat broke and flooded the floor.

/*Ｂ１以下はそのための巨大な水槽に
なっていたの。それが壊れて浸水
してるってわけね。
*/
ローズ_003: {
Il primo piano, che non &`e stato inondato,
contiene l'impianto di depurazione dell'aria,
}
//	<<<ENGLISH>>>
//	The first floor, which is not flooded,
//	houses the air purification facility＃－
//<ページ数変更>
ローズ_003_1: {
che elimina la puzza dell'acqua inquinata.
}
//	<<<ENGLISH>>>
//	that eliminates the stench
//	from the polluted water.

/*浸水していない１Ｆは汚染海水の悪臭を
除去するための空気清浄施設。
*/
ローズ_004: {
Manhattan &`e proprio dietro a noi, sai. 
Ci sono tutte le ragioni per essere cauti.
}
//	<<<ENGLISH>>>
//	Manhattan is right in our backyard
//	here, you know. There's plenty of
//	reason to be cautious.

/*マンハッタンのすぐ近くだもの。
気を使うことが多いみたいね。
*/
//dv}//v
}//d

