}//d

//鳥を殺し過ぎた h //e
resource PC_鳥殺し過ぎ__i {
//vox t:vc261031 {
大佐_000: {
Raiden! Ma che fai, ti diverti a torturare
animali indifesi, ora?
}
//	<<<ENGLISH>>>
