*/
//dv}//v
}//d

//シェル１中央棟１Ｆ d //e
//変装していない状態 h //e
resource PC_シェル１中央棟＿変装してない__i {
//vox t:vc261611 {
大佐_000: {
Raiden, il corridoio &`e troppo stretto.
}
//	<<<ENGLISH>>>
//	Raiden, the corridor is too narrow.
//<ページ数変更>
大佐_000_1: {
L&`i non hai nessuna copertura, in
pi&`u  ci sono parecchie telecamere
di sorveglianza.
}
//	<<<ENGLISH>>>
//	You'll have absolutely no cover and
//	there are multiple surveillance
//	cameras in place.

/*ライデン、その狭い通路では身を隠す
場所がまるでない。監視カメラも多数
