//<ページ数変更>
大佐_000_1: {
Vai invece a sud, al Supporto L.
}
//	<<<ENGLISH>>>
//	Go south to Strut L instead.

/*ライデン、そっちはＫ脚の入口だ。
入れそうもないし行く必要もない。
そこから南のＬ脚に向かってくれ。
*/
//dv}//v
}//d


//シェル２中央棟１Ｆ(w31a) d //e
