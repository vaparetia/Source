}//d
resource PC_変装＿ＡＫ装備__i {
//vox t:vc263291 {
大佐_000: {
Se porti l'equipaggiamento standard,
attirerai dei sospetti.
}
//	<<<ENGLISH>>>
//	It will look suspicious
//	if you're not carrying
//	the standard equipment.

/*敵兵士と同じ武器を装備していなければ
怪しまれるぞ。
*/
大佐_001: {
Tutto il personale al centro porta gli
AK-74U.
}
//	<<<ENGLISH>>>
//	All personnel in the core are
//	equipped with AK-74U's.
//<ページ数変更>
大佐_001_1: {
Seleziona il tuo AK quando sei travestito
da nemico.
}
//	<<<ENGLISH>>>
//	Select your own AK when
//	you're in disguise.

/*中央棟の敵兵士は武器として
