resource PC_サイファー１__i {
//vox t:vc261061 {
大佐_000: {
Il Cypher &`e una specie di velivolo
robotizzato di sorveglianza.
}
//	<<<ENGLISH>>>
//	The Cypher is a type of unmanned
//	surveillance craft.
//<ページ数変更>
大佐_000_1: {
Informa le pattuglie se scopre un intruso.
}
//	<<<ENGLISH>>>
//	It will alert the patrols upon
//	discovering an intruder.
//<ページ数変更>
大佐_000_2: {
Se un Cypher ti individua, i rinforzi
nemici non si faranno attendere.
}
//	<<<ENGLISH>>>
//	If you're spotted by one,
//	the reinforcements will
//	come running.

/*サイファーは無人偵察機の一種だ。
