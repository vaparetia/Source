*/
//dv}//v
}//d

//ロッカー室前の息継ぎポイントにて h //e
resource PC_エマのぞき__i {
//vox t:vc262331 {
ライデン_000: {
Colonnello, vede quello che vedo io?
}
//	<<<ENGLISH>>>
//	Colonel, are you seeing
//	what I'm seeing?

/*大佐、ここから見えるのが……。
*/
