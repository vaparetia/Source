*/
//dv}//v
}//d

//ノード接続後 h //e
resource PC_海底ドック昇降機前ノード接続後１__i {
//vox t:vc260701 {
大佐_000: {
Raiden, l'ascensore sta scendendo.
Ma ci vorranno ancora alcuni minuti.
}
//	<<<ENGLISH>>>
//	Raiden, the elevator is on its way
//	down. It will be a few more minutes
//	before it gets there, however.

/*ライデン、昇降機は下へ向かっている。
だが到着にはもう少し時間がかかり
