*/
//dv}//v
}//d


//初めての敵兵。対処の初歩の初歩 h //e
resource PC_戦闘＿素手__i {
//vox t:vc264721 {
大佐_000: {
Finora non hai acquisito armi. 
}
//	<<<ENGLISH>>>
//	You haven't acquired
//	any weapons yet.
//<ページ数変更>
大佐_000_1: {
Se ti vedi costretto a un combattimento,
dovrai fare affidamento solo sulle tue mani.
}
//	<<<ENGLISH>>>
//	If it comes down to combat
//	situations, you will have to
//	rely on your bare hands.

/*君はまだ武器を手に入れていない。
戦闘になったら素手で切り抜ける
しかないぞ。
*/
//dv}//v
}//d
resource PC_戦闘＿パンチ__i {
//vox t:vc264731 {
大佐_000: {
Il pugno &`e la base del combattimento corpo
a corpo. Premi il tasto Pugno.
}
//	<<<ENGLISH>>>
//	The punch is the basis
//	of hand-to-hand combat.
//	Push the Punch button.

/*素手で敵と戦う場合の基本はパンチだ。
