//	The bomb disposal expert is
//	somewhere in Strut C where
//	you currently are.
//<ページ数変更>
大佐_000_1: {
Trovalo e chiedi il suo aiuto.
}
//	<<<ENGLISH>>>
//	Locate him and request
//	his assistance.

/*君がいるＣ脚のどこかに爆弾処理の
