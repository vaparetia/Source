大佐_003_1: {
Dirigiti al primo piano nel centro di Shell 2.
}
//	<<<ENGLISH>>>
//	Head for the first floor
//	of Shell 2's core.

/*ライデン、任務に集中しろ。
今は大統領救出に集中するんだ。
シェル２中央棟の１Ｆに向かえ。
*/
//dv}//v
}//d

//ブラックケースについて h //e
resource PC_エイムズ死後＿ブラックケース１__i {
//vox t:vc266041 {
ライデン_000: {
Pensi che Ames dicesse la verit&`a sulla
valigetta?
}
//	<<<ENGLISH>>>
//	Do you think Ames was telling
//	the truth about the football?

/*エイムズの言っていたブラックケースの
話……本当なんだろうか。
*/
大佐_001: {
Rosemary.
}
/*ローズ君。*/
ローズ_002: {
Ricevuto. Jack, ora controllo subito.
}
//	<<<ENGLISH>>>
//	Roger that. Jack, I'll
//	look into it for you.

/*わかりました。
ジャック、調べてみるから。
*/
//dv}//v
}//d
//ブラックケース しばらくしてから h //e
