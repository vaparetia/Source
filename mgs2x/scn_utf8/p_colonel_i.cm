*/
ローズ_001: {
Se segui i sostegni rimasti, tenendoti
sospeso,
}
//	<<<ENGLISH>>>
//	If you follow the remaining
//	supports while Hanging,
//<ページ数変更>
ローズ_001_1: {
dovresti poter raggiungere il punto
proprio sopra il condotto.
}
//	<<<ENGLISH>>>
//	you should be able to reach
//	the spot right above the pipe.

/*残った支柱をエルードで渡っていけば、
その上までいけそうじゃない？
*/
//dv}//v
}//d

resource PC_ＤＧ連絡橋＿渡り方エルードズバリ２__i {
//vox t:vc261971 {
大佐_000: {
Quando sei in Sospensione, vai al punto
