agli infrarossi sul ponte che collega le due
Shell.
}
//	<<<ENGLISH(2)>>>
//	between the two Shells
//	is deactivated.

/*シェル１シェル２連絡橋に仕掛けられた
赤外線センサーのトラップを無効に
しなければシェル２には渡れまい。
*/
//dv}//v
}//d
