//	It's being kept in cold storage.
//	It will be circulated back into
//	your body when you return.

/*冷凍保存している。
帰還後に入れ替える手筈だ。
*/
//dv}//v
}//d
//無線機ウィンドウにライデンが出血しているゲーム映像。足下に赤い血が流血している。 t //e
resource PC_流血説明２__i {
//vox t:vc264691 {
大佐_000: {
Se l'indicatore della LIFE scende
alla zona rossa, non potrai fermare
il sangue da solo. 
}
//	<<<ENGLISH>>>
//	If the Life Gauge drops to the
//	red zone, you won't be able to
//	stop the bleeding by yourself.
//<ページ数変更>
大佐_000_1: {
Stai attento: le macchie di sangue possono
insospettire il nemico.
}
//	<<<ENGLISH>>>
//	Bloodstains can give your presence
//	away to the enemy; be careful.

/*ＬＩＦＥゲージが赤くなるまで減ると
