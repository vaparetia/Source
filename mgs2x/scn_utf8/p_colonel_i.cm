//	At least use a picture
//	of me instead!

/*せめて私の写真にして！
*/
ライデン_007: {
Cos...?
}
//	<<<ENGLISH>>>
//	Wha...?

/*え？*/
ローズ_008: {
Voglio dire...
}
//	<<<ENGLISH(2)>>>
//	I mean...

/*あ……。*/
大佐_009: {
Io disapprovo nel modo
pi&`u assoluto.
}
//	<<<ENGLISH>>>
//	...I completely disapprove...

/*……全く度し難い……。*/
//dv}//v
}//d


