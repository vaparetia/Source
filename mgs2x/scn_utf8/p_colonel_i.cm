Cosa significa tutto questo?
}
//	<<<ENGLISH>>>
//	What does that mean?

/*どういうことだ？*/
ローズ_006: {
Ho trovato solo "Ames"; 
solo questa parola.
}
//	<<<ENGLISH>>>
//	All I found out was "Ames,"
//	just that one word.

/*わからない。わかったのはエイムズ。
その一語だけ。
*/
ライデン_007: {
...
}
/*……。*/
//dv}//v
}//d
resource PC_エイムズ４__i {
//vox t:vc266011 {
