//ＭＧＳの台詞をしゃべる１ h //e
resource PC_発狂＿ＭＧＳ１__i {
//vox t:vc266551 {
大佐_000: {
Il Presidente Baker dovrebbe trovarsi a
sud della breccia che hai fatto nel muro.
}
//	<<<ENGLISH>>>
//	President Baker should be somewhere
