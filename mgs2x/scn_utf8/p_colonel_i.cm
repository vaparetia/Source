resource PC_ヴァンプ戦後＿ロッカー室１__i {
//vox t:vc264091 {
ライデン_000: {
Colonnello, sono nello spogliatoio, ma non
c'&`e anima viva.
}
//	<<<ENGLISH>>>
//	Colonel, I'm in the locker
//	room but there's no one here.

/*大佐、ロッカールームに着いたが
誰もいない……。
*/
ローズ_001: {
Che sia andata da qualche altra parte...?
}
//	<<<ENGLISH>>>
//	Could she have gone
//	somewhere else...?

/*まさかもう別の場所に……？
*/
大佐_002: {
Non credo.
}
//	<<<ENGLISH>>>
//	I don't think so.

