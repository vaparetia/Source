*/
大佐_001: {
Dirigiti al primo piano del centro di Shell 2.
}
//	<<<ENGLISH>>>
//	Head for the first floor
//	of the Shell 2 Core.
//<ページ数変更>
大佐_001_1: {
Sbrigati - prendi contatto col Presidente
prima che riconfermi il codice di lancio
nucleare.
}
//	<<<ENGLISH>>>
//	Hurry -- get in touch with the
//	President before the nuclear
//	launch code is reconfirmed.

/*シェル２中央棟１Ｆに向かうんだ。
核発射コードの再確認がなされる前に
大統領と接触しろ。急げ。
*/
//dv}//v
}//d

resource PC_水中＿息継ぎポイント＿光__i {
//vox t:vcxxx0625 {
大佐_000: {
Ai punti dove c'&`e aria arriva luce.
Probabilmente la luce arriva fino al
pavimento.
}
//	<<<ENGLISH>>>
//	Some light is shining down at the spots
//	where there is air. The light probably
//	reaches down to the floor.
//<ページ数変更>
大佐_000_1: {
Tieni d'occhio quella luce.
}
//	<<<ENGLISH>>>
//	Keep an eye out for that light.

/*空気が残っている場所は上の階から
光が漏れている。水底まで光が
さしているはずだ。光に注意しろ。
*/
//dv}//v
}//d

resource PC_水中＿息継ぎポイント＿レーダー１__i {
//vox t:vcxxx0625 {
大佐_000: {
I punti in cui &`e rimasta aria sono stati
ricavati dai dati sulla mappa del nodo
}
//	<<<ENGLISH>>>
//	The places where the air is trapped
//	have been inferred from the node's
//	map data,
//<ページ数変更>
大佐_000_1: {
e dovrebbero apparire sul tuo radar.
}
//	<<<ENGLISH>>>
//	and should appear on your radar.

/*ノードのマップデータから空気が残って
いる場所を推定し、レーダーへ表示する
ようにしておいた。
*/
//dv}//v
}//d

resource PC_水中＿息継ぎポイント＿レーダー２__i {
//vox t:vcxxx0625 {
大佐_000: {
C'&`e aria nei punti azzurri
sul tuo radar.
}
//	<<<ENGLISH>>>
//	There's air at the light blue
//	locations on your radar.
//<ページ数変更>
大佐_000_1: {
Dovresti riuscire a risalire per prendere
aria l&`a. Fai attenzione al radar e procedi.
}
//	<<<ENGLISH>>>
//	You should be able to come up
//	for air there. Pay attention to
//	the radar and move on.

/*レーダー上で青白く光っている場所には
空気がある。浮上すれば息継ぎが出来る
はずだ。レーダーをよく見ながら進め。
*/
//dv}//v
}//d

resource PC_エマ救出後＿Ｌ脚向かえ__i {
//vox t:vcxxx0625 {
大佐_000: {
Raiden, vai al Supporto L insieme ad
Emma.
}
//	<<<ENGLISH>>>
//	Raiden, go with
//	Emma to Strut L.
//<ページ数変更>
大佐_000_1: {
Se esci dal centro di Shell 2 e ti dirigi a
sud sul ponte di collegamento KL, arriverai
al Supporto L.
}
//	<<<ENGLISH>>>
//	If you exit the Shell 2 Core and
//	head south on the KL connecting
//	bridge, you'll get to Strut L.
//<ページ数変更>
大佐_000_2: {
Non c'&`e tempo!
Datti una mossa!
}
//	<<<ENGLISH>>>
//	There's no time!
//	Move it!

/*ライデン、エマと共にＬ脚に向かえ。
シェル２中央棟を出てＫＬ連絡橋を南に
進めばＬ脚に着く。時間がないぞ。急げ。
*/
//dv}//v
}//d

resource PC_ヴァンプ狙撃＿頭狙え__i {
//vox t:vcxxx0625 {
大佐_000: {
Raiden, Emma &`e in pericolo. Elimina
immediatamente Vamp!
}
//	<<<ENGLISH>>>
//	Raiden, Emma's in danger.
//	Take out Vamp now!

/*ライデン、エマが危ない。
早くヴァンプを倒せ！
*/
大佐_001: {
Se lo colpisci alla testa lo  danneggerai
gravemente. Mira alla testa!
}
//	<<<ENGLISH>>>
//	You'll do serious damage with
//	a head shot. Aim for his head!

/*頭を狙撃すれば大きなダメージを
与えられるはずだ。奴の頭を狙え！
*/
//dv}//v
}//d



resource PC_Ｅ脚ハシゴ__i {
//vox t:vcxxx0625 {
大佐_000: {
Raiden, la barriera anti-petrolio che hai
passato &`e sul fondo della scala.
}
//	<<<ENGLISH>>>
//	Raiden, the Oil Fence you crossed
//	is at the bottom of that ladder.

/*ライデン、そのハシゴの下は君が
今渡って来たオイルフェンスだ。
*/
大佐_001: {
Non hai tempo per tornare sul fondo del
Supporto E.
}
//	<<<ENGLISH>>>
//	You don't have the time to go
//	back to the bottom of Strut E.
//<ページ数変更>
大佐_001_1: {
Vai subito alla Sala dei computer al piano
B2 nel centro di Shell 1. Siamo intesi?
}
//	<<<ENGLISH>>>
//	Hurry to the Computer Room
//	on B2 in the Shell 1 Core.
//	Understood?

/*Ｅ脚下部に戻っている暇はないぞ。
一刻も早くシェル１中央棟Ｂ２の
電算室に向かうんだ。いいな。
*/
//dv}//v
}//d


//またまた追加
resource PC_その脚部のＣ４解除した__i {
//vox t:vcxxx0625 {
大佐_000: {
Raiden, sembra che in quell'area non ci
siano altre C4. Procedi oltre.
}
//	<<<ENGLISH>>>
//	Raiden, there seem to be
//	no more C4's in that area.
//	Move on to another area.

/*ライデン、そのエリアにもうＣ４は
残っていないようだ。他のエリアに
向かえ。
*/
//dv}//v
}//d

resource PC_人質部屋＿敵兵定時連絡２__i {
//vox t:vcxxx0625 {
大佐_000: {
Le guardie che sorvegliano gli ostaggi sono
in regolare contatto con altri terroristi.
}
//	<<<ENGLISH>>>
//	The guards in charge of
//	the hostages are in regular
//	contact with other terrorists.

/*人質の見張りをしている敵兵士は
定期的に仲間と連絡をとりあっている。
*/
大佐_001: {
Se questi contatti regolari si dovessero
interrompere, scoprirebbero la  tua
presenza.
}
//	<<<ENGLISH>>>
//	If regular contact is cut off, that
//	means they would discover your
//	presence.
//<ページ数変更>
大佐_001_1: {
Non potrai mai farcela se il nemico ti
dovesse accerchiare in quell'area.
}
//	<<<ENGLISH>>>
//	There's no way you can survive
//	if you are surrounded by the
//	enemy in that area.

/*定期連絡が途絶えることは君の潜入が
発覚することを意味する。そのエリアで
敵に囲まれれば到底助からないぞ。
*/
大佐_002: {
Non distruggere le radio del nemico. Usa la
granata chaff antiradar per creare
interferenza. Hai capito?
}
//	<<<ENGLISH>>>
//	Do not destroy enemy radios or
//	use your Chaff to interfere with
//	their regular contact. Got it?

/*そのエリアでは敵の無線機を壊したり
チャフを使って定期連絡を妨害しては
ならない。いいな。
*/
//dv}//v
}//d

resource PC_ハリアー戦＿レーダー__i {
//vox t:vcxxx0625 {
大佐_000: {
Non farti prendere dal panico, anche se
perdi di vista l'Harrier. Studia il radar.
}
//	<<<ENGLISH>>>
//	Don't panic, even if you lose
//	sight of the Harrier. Look at
//	your radar.

/*ライデン、ハリアーを見失っても
慌てるな。レーダーを見るんだ。
*/
大佐_001: {
Il radar &`e stato adattato per mostrare la
posizione dell'Harrier.
}
//	<<<ENGLISH>>>
//	The radar has been modified
//	to show where the Harrier is.
//<ページ数変更>
大佐_001_1: {
Usa il radar e localizza l'Harrier.
}
//	<<<ENGLISH>>>
//	Use the radar and locate
//	the Harrier's position.

/*ハリアーのいる方向が表示されるように
調整しておいた。レーダーを使って
ハリアーの位置をつかめ。
*/
//dv}//v
}//d


resource PC_ヴァンプ戦＿ナイフ弾ける__i {
//vox t:vcxxx0625 {
大佐_000: {
Puoi abbattere i coltelli lanciati da Vamp.
Prendi la mira nella Visuale Soggettiva.
}
//	<<<ENGLISH>>>
//	You can shoot down the knives
//	Vamp throws. Aim at them in
//	First Person View.

/*ヴァンプの投げるナイフは銃で撃てば
撃ち落とすことが出来る。主観攻撃で
狙え。
*/
//dv}//v
}//d



//おもしろ追加
resource PC_マイク入手時ＣＡＬＬ__i {
//vox t:vc263252 {
大佐_000: {
Hai il microfono direzionale.
}
//	<<<ENGLISH>>>
//	You have the directional microphone.

/*指向性マイクを手に入れたな。
それで人質の心音を聞くことが出来る。
*/
大佐_001: {
Secondo le nostre informazioni, Ames ha
un pacemaker.
}
//	<<<ENGLISH>>>
//	According to our information,
//	Ames has a pacemaker.
//<ページ数変更>
大佐_001_1: {
Il suo battito cardiaco dovrebbe essere
facilmente distinguibile.
}
//	<<<ENGLISH>>>
//	This should make his cardiac
//	pattern fairly distinct.
//<ページ数変更>
大佐_001_2: {
Usa il microfono direzionale per
localizzarlo.
}
//	<<<ENGLISH>>>
//	Use the directional microphone
//	to locate it.

/*エイムズは心臓にペースメイカーを埋め
込んでいるらしい。心音が違うはずだ。
それを指向性マイクで聞き分けるんだ。
*/
//dv}//v
}//d
