/*ライデン、どこに行く？
エマを援護するんだ。
ＰＳＧ１でエマの進路を切り開け。
*/
//dv}//v
}//d

//Ｅ脚狙撃後 h //e
//エマの血痕 h //e
resource PC_エマ狙撃後＿エマ血痕__i {
//vox t:vc262361 {
ライデン_000: {
Oh, maledizione...
}
//	<<<ENGLISH>>>
//	Oh damn...

/*これは……。*/
大佐_001: {
S&`i. Emma non se la passa troppo bene.
}
//	<<<ENGLISH>>>
//	Yes. Emma's not doing so well.

/*ああ。
エマの怪我は相当重いようだな……。*/
ライデン_002: {
...
}
/*……。*/
ローズ_003: {
Jack - tu hai fatto il possibile.
}
//	<<<ENGLISH>>>
//	Jack -- you did your best.

/*ジャック……。
あなたは精一杯やったわ……。*/
大佐_004: {
Raiden, Emma ti aspetta alla sala
dei computer del livello B2, nel centro
di Shell 1. Vacci subito.
}
//	<<<ENGLISH>>>
//	Raiden, Emma is waiting for you
//	in the B2 level computer room of
//	Shell 1's core. Get over there.

/*ライデン、エマはシェル１中央棟Ｂ２の
電算室で君を待っているはずだ。急げ。
*/
ライデン_005: {
...Ricevuto.
}
