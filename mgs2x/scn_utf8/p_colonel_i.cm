//<ページ数変更>
大佐_000_1: {
Dirigiti invece verso il centro di Shell 2,
dove tengono il Presidente.
}
//	<<<ENGLISH>>>
//	Head for the core of Shell 2,
//	where the President is.

/*ライデン、Ｋ脚には入れそうもない。
