あまり得策ではないだろうな。
*/
//dv}//v
}//d

//エルード回避 h //e
resource PC_サイファー回避＿エルード１__i {
//vox t:vc261101 {
大佐_000: {
Raiden, devi tenerti fuori dal campo visivo
del Cypher. Non puoi permetterti di finire
catturato.
}
//	<<<ENGLISH>>>
//	Raiden, you need to stay out of
//	the Cypher's field of vision. You
