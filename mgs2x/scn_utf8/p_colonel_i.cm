resource PC_流血説明４__i {
//vox t:vc264711 {
大佐_000: {
Puoi anche acquattarti o strisciare e stare
completamente immobile per un po'.
}
//	<<<ENGLISH>>>
//	You can also go into a crouch
//	or crawl and stay completely
