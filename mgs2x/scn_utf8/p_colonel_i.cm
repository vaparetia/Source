*/
//dv}//v
}//d

//ガンサイファー h //e
resource PC_Ｌ脚外周＿ガンサイファー__i {
//vox t:vc262111 {
大佐_000: {
Raiden, attento. Quest'area &`e
sorvolata da Cypher armati.
}
//	<<<ENGLISH>>>
//	Raiden, look out. There are
//	airborne Gun Cyphers in the
//	area.

/*ライデン、気をつけろ。
そのあたりにはガンサイファーが
