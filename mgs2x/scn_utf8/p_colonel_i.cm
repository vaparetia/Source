}
//	<<<ENGLISH>>>
//	Raiden, the high-voltage current
//	flowing to the floor in front of
//	the room＃－
//<ページ数変更>
大佐_000_1: {
tengono il Presidente &`e stata disattivata.
}
//	<<<ENGLISH>>>
//	that the President's being
//	held in has been cut off.

/*ライデン、大統領が捕らえられている
部屋の前に流されていた高圧電流は
