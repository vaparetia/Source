/*ＲＧＢ６をうまく使うんだ。*/
//dv}//v
}//d
resource PC_ハリアー戦＿基本戦法下階__i {
//vox t:vc263721 {
大佐_000: {
Il livello inferiore ti offre maggiore
copertura 
}
//	<<<ENGLISH>>>
//	The lower level offers more cover.
//<ページ数変更>
大佐_000_1: {
e l&`i potrai schivare meglio gli attacchi
dell'Harrier.Per&`o la tua mira non sar&`a 
molto buona.
}
//	<<<ENGLISH>>>
