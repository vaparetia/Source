*/
//dv}//v
}//d

resource PC_サイファー回避＿破壊２__i {
//vox t:vc261091 {
大佐_000: {
Ma i nemici potrebbero arrivare,
per controllare perch&'e il segnale
si &`e interrotto.
}
//	<<<ENGLISH>>>
//	However, enemy personnel may
//	come and investigate the signal
//	termination.
//<ページ数変更>
大佐_000_1: {
La distruzione non &`e il metodo migliore
in questi casi.
}
//	<<<ENGLISH>>>
//	Destruction is not the soundest
//	method to use.

/*だがサイファーからの連絡が途絶えると
