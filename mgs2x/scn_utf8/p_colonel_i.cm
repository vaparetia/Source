水中の暗い所では赤外線ゴーグルを使え。
*/
//dv}//v
}//d


//風邪引くよ h //e
resource PC_水中＿風邪__i {
//vox t:vc262311 {
ローズ_000: {
Jack, tutto a posto? Senti freddo?
}
//	<<<ENGLISH>>>
//	Jack, is everything all right?
//	Are you cold?

/*ジャック、大丈夫？
なんだか寒そうだけど？
*/
ライデン_001: {
No, io - et-etc&`i&`i&`i&`i!
}
//	<<<ENGLISH(2)>>>
//	No no, I'm -- Ah-choo!

/*いや、大丈夫……ハクション！*/
