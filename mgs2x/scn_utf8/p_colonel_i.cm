}
//	<<<ENGLISH>>>
//	Raiden, take Emma and head for
//	Strut L. Strut L is on the south
//	end of that KL connecting bridge.

/*ライデン、エマを連れてＬ脚に
向かってくれ。Ｌ脚はそのＫＬ連絡橋の
南側だ。
*/
//dv}//v
}//d

//Ｌ脚内部にいる場合 h //e
resource PC_Ｌ脚＿南行け__i {
//vox t:vc264351 {
