}
//	<<<ENGLISH>>>
//	Try Hanging, and keep an
//	eye on the Grip Gauge!

/*手すりにぶらさがってサイファーを
やりすごすんだ。エルードを使え。
握力ゲージに気をつけろ。
*/
//dv}//v
}//d

