}//d

//見つかると即ゲームオーバー h //e
resource PC_人質＿見つかるな１__i {
//vox t:vc261901 {
大佐_000: {
Raiden, tieniti sempre coperto a tutti i
costi, in quella sala per conferenze.
}
//	<<<ENGLISH>>>
//	Raiden, retain your cover at all
//	costs inside that conference hall.
//<ページ数変更>
大佐_000_1: {
Ci sono una sola entrata
e una sola uscita.
}
//	<<<ENGLISH>>>
//	There's only one way in
//	and out of the area.

/*ライデン、その集会場では絶対に
見つかるなよ。そのエリアには
出入口が一つしかない。
*/
//dv}//v
}//d
resource PC_人質＿見つかるな２__i {
//vox t:vc261911 {
大佐_000: {
Se ti scoprono all'interno, bloccheranno
l'uscita e chiameranno rinforzi.
}
//	<<<ENGLISH>>>
//	If you're discovered inside,
//	they'll cut off your retreat
//	and call in the reinforcements.
//<ページ数変更>
大佐_000_1: {
Non ce la farai ad uscire vivo.
}
//	<<<ENGLISH>>>
//	You won't make it out of the room.

/*そこで敵に見つかったら退路を
断たれた上に増援部隊を呼ばれる。
とても切り抜けることは出来ないだろう。
*/
大佐_001: {
Se ti scoprono la missione &`e fallita.
}
//	<<<ENGLISH>>>
//	The mission will be over
//	if you're discovered.
//<ページ数変更>
大佐_001_1: {
Ora travestiti e cerca Ames senza
insospettire il nemico.
}
//	<<<ENGLISH>>>
//	Don your disguise and look
//	for Ames while deflecting
//	the enemy's suspicion.

/*見つかったら終わりだ。変装して、敵の
目をあざむきならがエイムズを探すんだ。
いいな。
*/
//dv}//v
}//d

//敵は定期連絡してる h //e
resource PC_人質＿敵兵定時連絡__i {
//vox t:vc261921 {
大佐_000: {
Raiden, sembra che le guardie che
sorvegliano gli ostaggi
}
//	<<<ENGLISH>>>
//	Raiden, it looks like the guards
//	in charge of the hostages＃－
//<ページ数変更>
大佐_000_1: {
siano regolarmente in contatto
con altri terroristi.
}
//	<<<ENGLISH>>>
//	are in regular contact
//	with other terrorists.

/*ライデン、人質の見張りをしている
敵兵士は定期的に仲間と連絡をとって
いるようだ。*/
大佐_001: {
Anche un intervento temporaneo
contro una guardia interromperebbe
le comunicazioni
}
//	<<<ENGLISH>>>
//	Even a temporary measure
//	against a guard will disrupt
//	communications＃－
//<ページ数変更>
大佐_001_1: {
e informerebbe il nemico della tua
presenza. Non tramortire le guardie
in quest'area.
}
//	<<<ENGLISH>>>
//	and alert the enemy to your
//	presence. Refrain from knocking
//	any guards out inside this area.

/*気絶させたり眠らせたりして定期連絡が
途絶えると見つかるぞ。そのエリアでは
敵に一切手を出すな。
*/
//dv}//v
}//d

//人質殺してはいけない h //e
//一回目のみ t //e
resource PC_人質＿人質殺すな１__i {
//vox t:vc261931 {
大佐_000: {
Non dovrei dirti questo, Raiden,
ma sappi che ti
}
//	<<<ENGLISH>>>
//	I shouldn't have to tell you this
//	Raiden, but for the record,
//<ページ数変更>
大佐_000_1: {
&`e proibito fare del male a qualsiasi
ostaggio.
}
//	<<<ENGLISH>>>
//	you are forbidden to harm
//	any of the hostages.

/*ライデン、わかっていると思うが、
人質を傷つけたりするなよ。
*/
ローズ_001: {
Tu comunque non faresti mai una cosa
del genere, giusto?
}
//	<<<ENGLISH>>>
//	You wouldn't do a thing
//	like that anyway, right?

/*言われなくてもそんなヒドイこと
しないわよね？
*/
//dv}//v
}//d
resource PC_人質＿人質殺すな２__i {
//vox t:vc261941 {
大佐_000: {
Le guardie stanno sorvegliando gli ostaggi.
}
//	<<<ENGLISH>>>
//	The guards are keeping watch
//	over the hostages.
//<ページ数変更>
大佐_000_1: {
Se a uno di loro succede qualcosa,
capiranno che nella sala c'&`e un intruso.
}
//	<<<ENGLISH>>>
//	If something happens to even one
//	of them, they'll realize that an
//	intruder is in the room.

/*敵は人質を見張っている。人質に
異状が起きれば、すぐに侵入者がいると
気づくはずだ。
*/
大佐_001: {
Quel posto &`e una trappola per topi
se ti smascherano e circondano.
}
//	<<<ENGLISH>>>
//	That place is a death trap
//	if you're unmasked and
//	surrounded.
//<ページ数変更>
大佐_001_1: {
Non fare del male, ripeto, non alzare
un dito sugli ostaggi.
}
//	<<<ENGLISH>>>
//	Do not, I repeat, do not harm
//	the hostages in any way.

/*その集会場で敵に発見され、
包囲されればとても助からん。
いいか、人質は絶対に傷つけるなよ。
*/
//dv}//v
}//d





//シェル１シェル２連絡橋 d //e
resource PC_ＤＧ連絡橋＿渡り方飛びズバリ１__i {
//vox t:vc261951 {
大佐_000: {
Raiden, se salti lontano il pi&`u possibile
dovresti riuscire a raggiungere l'altro lato.
}
//	<<<ENGLISH>>>
//	Raiden, if you jump as far as
//	you can, you could reach the
//	other side.
//<ページ数変更>
大佐_000_1: {
Cerca di rotolare per saltare proprio
dall'orlo.
}
//	<<<ENGLISH>>>
//	Try rolling to take off
//	from the very edge.

/*ライデン、そこから思いきり飛べば
向こう側に届くんじゃないか？ぎりぎり
から踏み切ってローリングをしてみろ。
*/
//dv}//v
}//d

//パイプ方面 h //e
resource PC_ＤＧ連絡橋＿渡り方エルードズバリ１__i {
//vox t:vc261961 {
大佐_000: {
Raiden, guarda in basso e a destra.
}
//	<<<ENGLISH>>>
//	Raiden, look down and
//	to your right.
//<ページ数変更>
大佐_000_1: {
C'&`e un condotto per la circolazione
dell'acqua contaminata.
}
//	<<<ENGLISH>>>
//	There's a pipe down there
//	for circulating contaminated
//	seawater.

/*ライデン、右下の方を見てみろ。
くみ上げた汚染海水を循環させるための
