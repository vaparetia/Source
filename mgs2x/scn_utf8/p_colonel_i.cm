}
//	<<<ENGLISH>>>
//	there's a door that leads to
//	the AB connecting bridge.
//<ページ数変更>
大佐_000_2: {
Attraversa il ponte per andare
sul Supporto B. Sbrigati!
}
//	<<<ENGLISH>>>
//	Cross the bridge to get
//	to Strut B. Hurry!

/*Ａ脚１Ｆの北西にある扉から
ＡＢ連絡橋に出られる。ＡＢ連絡橋を
渡りきればＢ脚だ。急げ！
*/
//dv}//v
}//d

//ＡＢ連絡橋に居る場合 t//e
