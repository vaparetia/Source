//	Raiden, didn't you hear what
//	the SEALs said? The President
//	is in trouble. Head for Strut B.

/*ライデン、ＳＥＡＬＳの無線を
聞いただろう？大統領が危ない。
Ｂ脚へ向かってくれ。
*/
//dv}//v
}//d


//Ａ脚共通 t//e
resource PC_Ｂ脚に急げ３__i {
