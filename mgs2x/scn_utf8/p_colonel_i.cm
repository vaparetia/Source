}//d


//制御装置はいろいろなところにある h  //e
resource PC_ＤＧ連絡橋＿赤外線センサー＿制御装置場所１__i {
//vox t:vc263531 {
大佐_000: {
Non puoi disattivare il sensore agli IR se
prima non distruggi le unit&`a di controllo.
}
//	<<<ENGLISH>>>
//	The IR sensor cannot be taken
//	offline until all the control units
//	are destroyed.

/*全ての制御装置を破壊しなければ
赤外線センサーを無効にすることは
出来ない。
*/
大佐_001: {
Se il sensore &`e ancora attivo, vuol dire che
rimangono ancora unit&`a di controllo intatte.
}
//	<<<ENGLISH>>>
//	If the sensor is still live, it
//	means there are control units
//	you haven't touched somewhere.

/*センサーが生きていると言うことは
どこかにまだ破壊していない制御装置が
あるということだ。
*/
//dv}//v
}//d
resource PC_ＤＧ連絡橋＿赤外線センサー＿制御装置場所２__i {
//vox t:vc263541 {
大佐_000: {
Raiden, non hai ancora distrutto tutte le
unit&`a di controllo.
}
//	<<<ENGLISH>>>
//	Raiden, you haven't destroyed
//	all the control units yet.
//<ページ数変更>
大佐_000_1: {
Usa la Visuale Soggettiva o il mirino del
fucile per guardarti intorno.
}
//	<<<ENGLISH>>>
//	Use the First Person View or
//	the sniper scope to look around.

/*ライデン、まだ破壊していない
制御装置があるぞ。主観やスコープで
まわりをよく見渡してみるんだ。
*/
//dv}//v
}//d
//爆弾撃つな h //e
resource PC_ＤＧ連絡橋＿赤外線センサー＿爆弾撃つな__i {
//vox t:vc263551 {
大佐_000: {
Raiden, il Semtex &`e provvisto di sensori
sensibili agli urti.
}
//	<<<ENGLISH>>>
//	Raiden, the Semtex is equipped
//	with shock sensors.

/*ライデン、セムテックスには衝撃を
感知するセンサーが取り付けられている。
*/
大佐_001: {
Se colpisci il Semtex - anche con dei
proiettili - il sensore si attiva
}
//	<<<ENGLISH>>>
//	Any blow to the Semtex
//	-- gunfire included --
//	will set off the sensor...
//<ページ数変更>
大佐_001_1: {
ed avvia una reazione a catena che fa
detonare tutte le bombe.
}
//	<<<ENGLISH>>>
//	and start a chain reaction that
//	will detonate all the bombs.

/*銃で撃ったりしたらセンサーが起動し、
全てのセムテックスが連動して
爆発するぞ。
*/
大佐_002: {
Se questo dovesse succedere, siamo
spacciati. Mira solo alle unit&`a di controllo.
}
//	<<<ENGLISH>>>
//	We'll be finished if that were
//	to happen. Aim only for the
//	control units.

/*そうなったら終わりだ。
制御装置だけを狙うんだ。
*/
//dv}//v
}//d

//ＤＧ連絡橋以外の場所 h //e
resource PC_ＤＧ連絡橋＿以外の場所１__i {
