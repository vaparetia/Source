		command foreach -argc 1 -repeat 3 \
			-data { \
				{0},{1},{2} \
			} \
			-exec {
				command 追加ＨＺＸグループ登録 \
					-hzx_id $1 \
					-add_id 3
			}
*/


	}































//###################################################################################
//									天井君設定
//###################################################################################

	proc シェル１中央棟Ｂ１天井設置 {
		#if d:DEBUG_PRINT
			print 'w24b_ceil_set'
		#endif

		//網膜センサーデモのときは天井君なし
		if($w:p_story < d:ST:P038_01_S01網膜チェック１シナリオデモ１開始 &&  $s:登場ポイント != sp_w24c_w24b_0 ){
			eval($i:天井君Ｙリミット = 32000)
		}else{
			eval($i:天井君Ｙリミット = -1000)
		}

		chara 天井君 シェル１中央棟Ｂ１廊下天井 -m d:CEIL_NAME0 -h $i:天井君Ｙリミット -p 0,0,0 -l d:LT2_NAME

		chara 天井君 シェル１中央棟Ｂ１倉庫天井 -m d:CEIL_NAME1 -h -1000 -p 0,0,0 -l d:LT2_NAME
		chara 天井君 シェル１中央棟Ｂ１リフレッシュ天井 -m d:CEIL_NAME2 -h -1000 -p 0,0,0 -l d:LT2_NAME

		chara 天井君 北側壁 \
			-m w24b0_wall1 -p 0 0 0  -l d:LT2_NAME \
			-c 0 0 -70500 -a 5

		chara 天井君 南側壁 \
			-m w24b0_wall2 -p 0 0 0  -l d:LT2_NAME \
			-c 0 0 -63300 -a 5


	}













//###################################################################################
//									エレベータ設置
//###################################################################################


proc 強制ドアクローズ終了_1Fへ {
	#if d:DEBUG_PRINT
		print 'w24b_load_go'
	#endif

	if( $f:ロードチェックＯＮフラグ == 1 ) {
	// シェル１中央棟１Ｆへ
		preseek 'w24a'
		@ステージ終了時処理（ステージ名表示） 0 0 0 0 mv_w24b_w24a_0 d:NO_MOVE_M_TYPE d:wn_シェル１中央棟１Ｆ
	}
}


proc 強制ドアクローズ終了_B2へ {
	#if d:DEBUG_PRINT
		print 'w24b_load_go'
	#endif

	if( $f:ロードチェックＯＮフラグ == 1 ) {
	// シェル１中央棟Ｂ２へ
		preseek 'w24d'
		@ステージ終了時処理（ステージ名表示） 0 0 0 0 mv_w24b_w24d_0 d:NO_MOVE_M_TYPE d:wn_シェル１中央棟Ｂ２電算室
	}
}










//###################################################################################
//									ロードマップ設置
//###################################################################################


	proc ロード部屋設置 {
		#if d:DEBUG_PRINT
			print 'ロード部屋設置'
		#endif

		chara プットオブジェ ロード部屋 -m w24b_w24c -r 0,0,0 -p 0,0,0 -l d:LT2_NAME

		mesg プットオブジェ ロード部屋 off

	}








//###################################################################################
//									ロッカー設定
//###################################################################################


	proc ロッカー設置 {
		#if d:DEBUG_PRINT
			print 'w24b_locker_set'
		#endif

		chara ロッカー管理 管理人さん -n 6

		command ロッカーモーション -motion locker
		command プレイヤーロッカーモーション -motion sna_locker


		// 休憩室一番左
		command foreach -argc 1 -repeat 6 \
			-data { \
				{0},{1},{2},{3},{4},{5} \
			} \
			-exec{
				@壊れ物再セットチェック $b:w24b_破壊ロード回数[$1]
				if($f:再セットフラグ) {
					eval($i:w24b_ロッカー状態[$1] = 0)
				}
			}





		// 休憩室一番左
		chara ロッカー ロッカー:01 \
			-kms w24b1_locker_dr1 \
			-p -10050,-4500,-68750 \
			-r 0,0,0 \
			-s 0 \
			-seno    1 \	// 壁音番号
			-sefloor 4 \	// 倒れ時床音番号
			-flag d:LOCKER_STATE_CLOSE \
			-load_state $i:w24b_ロッカー状態[0] \
			-exec {
				@ロッカー再セットチェック処理 0 $4 $3
			}

		trap lk001 d:PLAYER \
			-and \
			-mask いる \
			-state d:TRP_STATE_STAND,d:TRP_STATE_CAUTION \
			-dir 2048,512 0,512 \
			-button d:ACTION_BUTTON,-1 \
			-exec {
				command ロッカー状態 -n ロッカー:01
				mesg プレイヤー d:PLAYER locker ロッカー:01 $status 2048,512 -10050,-68750
			}

		trap lk001 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_FORCE \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p -9523,419,-66466 \
					-t -10342,-2986,-68320 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3
			}

		// 休憩室左から２番目
		chara ロッカー ロッカー:02 \
			-kms w24b1_locker_dr1 \
			-p -9050,-4500,-68750 \
			-r 0,0,0 \
			-s 0 \
			-seno    1 \	// 壁音番号
			-sefloor 4 \	// 倒れ時床音番号
			-flag d:LOCKER_STATE_OPEN \
			-load_state $i:w24b_ロッカー状態[1] \
			-exec {
				@ロッカー再セットチェック処理 1 $4 $3
			}

		trap lk002 d:PLAYER \
			-and \
			-mask いる \
			-state d:TRP_STATE_STAND,d:TRP_STATE_CAUTION \
			-dir 2048,512 0,512 \
			-button d:ACTION_BUTTON,-1 \
			-exec {
				command ロッカー状態 -n ロッカー:02
				mesg プレイヤー d:PLAYER locker ロッカー:02 $status 2048,512 -9050,-68750
			}

		trap lk002 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_FORCE \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p -8814,237,-66449 \
					-t -9637,-3164,-68305 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3
			}

		// 休憩室右から２番目
		chara ロッカー ロッカー:03 \
			-kms w24b1_locker_dr1 \
			-p -8050,-4500,-68750 \
			-r 0,0,0 \
			-s 0 \
			-seno    1 \	// 壁音番号
			-sefloor 4 \	// 倒れ時床音番号
			-flag d:LOCKER_STATE_CLOSE \
			-load_state $i:w24b_ロッカー状態[2] \
			-exec {
				@ロッカー再セットチェック処理 2 $4 $3
			}

		trap lk003 d:PLAYER \
			-and \
			-mask いる \
			-state d:TRP_STATE_STAND,d:TRP_STATE_CAUTION \
			-dir 2048,512 0,512 \
			-button d:ACTION_BUTTON,-1 \
			-exec {
				command ロッカー状態 -n ロッカー:03
				mesg プレイヤー d:PLAYER locker ロッカー:03 $status 2048,512 -8050,-68750
			}

		trap lk003 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_FORCE \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p -7864,60,-66533 \
					-t -8662,-3380,-68326 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3
			}

		// 休憩室一番右
		chara ロッカー ロッカー:04 \
			-kms w24b1_locker_dr1 \
			-p -7050,-4500,-68750 \
			-r 0,0,0 \
			-s d:LOCKER_STATE_DESTROY \	//ここだけ開けたとき壁に接するかららしい。
			-seno    1 \	// 壁音番号
			-sefloor 4 \	// 倒れ時床音番号
			-flag d:LOCKER_STATE_CLOSE \
			-load_state $i:w24b_ロッカー状態[3] \
			-exec {
				@ロッカー再セットチェック処理 3 $4 $3
			}
		trap lk004 d:PLAYER \
			-and \
			-mask いる \
			-state d:TRP_STATE_STAND,d:TRP_STATE_CAUTION \
			-dir 2048,512 0,512 \
			-button d:ACTION_BUTTON,-1 \
			-exec {
				command ロッカー状態 -n ロッカー:04
				mesg プレイヤー d:PLAYER locker ロッカー:04 $status 2048,512 -7050,-68750
			}
		trap lk004 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_FORCE \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p -7152,-44,-66652 \
					-t -7955,-3480,-68449 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3
			}

		// ノード部屋左
		chara ロッカー ロッカー:05 \
			-kms w24b1_locker_dr2 \
			-p 5200,-4500,-73500 \
			-r 0,0,0 \
			-s 0 \
			-seno    1 \	// 壁音番号
			-sefloor 4 \	// 倒れ時床音番号
			-flag d:LOCKER_STATE_CLOSE \
			-load_state $i:w24b_ロッカー状態[4] \
			-exec {
				@ロッカー再セットチェック処理 4 $4 $3
			}
		trap lk005 d:PLAYER \
			-and \
			-mask いる \
			-state d:TRP_STATE_STAND,d:TRP_STATE_CAUTION \
			-dir 2048,512 0,512 \
			-button d:ACTION_BUTTON,-1 \
			-exec {
				command ロッカー状態 -n ロッカー:05
				mesg プレイヤー d:PLAYER locker ロッカー:05 $status 2048,512 5200,-73500
			}
		trap lk005 d:PLAYER \
			-mask ？ \
			-state 6 \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 5685,-364,-71250 \
					-t 4947,-2977,-73130 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3
			}

		// ノード部屋右
		chara ロッカー ロッカー:06 \
			-kms w24b1_locker_dr2 \
			-p 6200,-4500,-73500 \
			-r 0,0,0 \
			-s 0 \
			-down_rot 0,4000,0 \	//$v:倒れたときの角度 \
			-W 200,0,-200 \	//$v:倒れたときのシフト量
			-seno		1 \	// 壁音番号
			-sefloor	4 \	// 倒れ時床音番号
			-flag d:LOCKER_STATE_CLOSE \
			-load_state $i:w24b_ロッカー状態[5] \
			-exec {
				@ロッカー再セットチェック処理 5 ロッカー:06 $3
			}

		trap lk006 d:PLAYER \
			-and \
			-mask いる \
			-state d:TRP_STATE_STAND,d:TRP_STATE_CAUTION \
			-dir 2048,512 0,512 \
			-button d:ACTION_BUTTON,-1 \
			-exec {
				command ロッカー状態 -n ロッカー:06
				mesg プレイヤー d:PLAYER locker ロッカー:06 $status 2048,512 6200,-73500
			}

		trap lk006 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_FORCE \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 6820,-277,-71067 \
					-t 5947,-2885,-72892 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3
			}


	}



	proc ロッカー再セットチェック処理 $:ロッカー番号 $:ロッカー名 $:もひ {
		if(($3 != 6) && ($3 != 8)) {
			// 状態変化時
			eval($b:w24b_破壊ロード回数[$1] = $w:グローバルロード回数);
		} else if($3 == 8) {
			// ステージ終了時
			command ロッカー状態 -n $2
			eval($i:w24b_ロッカー状態[$1] = $status)
		}
	}







//###################################################################################
//									リフレッシュ草設置
//###################################################################################

	proc リフレッシュ草設置 {
		#if d:DEBUG_PRINT
			print 'リフレッシュ草設置'
			print 'grass_set'
		#endif

	/*
	w24b2
	樹木の座標

	ソファー側
	回転Y位置XYV
	1 Y-40 X-11375 Y-4405 Z-73137
	2 Y-65 X-11450 Y-4430 Z-72687
	3 Y-25 X-11375 Y-4455 Z-72250
	4 Y 65 X-11350 Y-4430 Z-71862
	5 Y  0 X-11375 Y-4480 Z-71262
	6 Y-45 X-11400 Y-4480 Z-70737
	自販機側
	*/

		chara プット植物オブジェ 揺れポプラ \
			-m tree_00 \
			-b tree_01 \
			-r 0 (4096*40/360) 0 \
			-p -11375,-4405,-73137 \
			-l d:LT2_NAME \
			-s 100 100 100 \
			-broken $f:w24b＿壊れフラグ＿ポプラ＿１ \
			-proc セット壊れフラグ＿ポプラ＿１

		chara プット植物オブジェ 揺れポプラ \
			-m tree_00 \
			-b tree_01 \
			-r 0 (4096*(-65)/360) 0 \
			-p -11450,-4430,-72678 \
			-l d:LT2_NAME \
			-s 100 100 100 \
			-broken $f:w24b＿壊れフラグ＿ポプラ＿２ \
			-proc セット壊れフラグ＿ポプラ＿２

		chara プット植物オブジェ 揺れポプラ \
			-m tree_00 \
			-b tree_01 \
			-r 0 (4096*(-25)/360) 0 \
			-p -11375,-4455,-72250 \
			-l d:LT2_NAME \
			-s 100 100 100 \
			-broken $f:w24b＿壊れフラグ＿ポプラ＿３ \
			-proc セット壊れフラグ＿ポプラ＿３

		chara プット植物オブジェ 揺れポプラ \
			-m tree_00 \
			-b tree_01 \
			-r 0 (4096*65/360) 0 \
			-p -11350,-4430,-71862 \
			-l d:LT2_NAME \
			-s 100 100 100 \
			-broken $f:w24b＿壊れフラグ＿ポプラ＿４ \
			-proc セット壊れフラグ＿ポプラ＿４

		chara プット植物オブジェ 揺れポプラ \
			-m tree_00 \
			-b tree_01 \
			-r 0 0 0 \
			-p -11375,-4480,-71262 \
			-l d:LT2_NAME \
			-s 100 100 100 \
			-broken $f:w24b＿壊れフラグ＿ポプラ＿５ \
			-proc セット壊れフラグ＿ポプラ＿５

		chara プット植物オブジェ 揺れポプラ \
			-m tree_00 \
			-b tree_01 \
			-r 0 (4096*(-45)/360) 0 \
			-p -11400,-4480,-70737 \
			-l d:LT2_NAME \
			-s 100 100 100 \
			-broken $f:w24b＿壊れフラグ＿ポプラ＿６ \
			-proc セット壊れフラグ＿ポプラ＿６




	}



	proc セット壊れフラグ＿ポプラ＿１ {
		eval( $f:w24b＿壊れフラグ＿ポプラ＿１ = 1 )
	}

	proc セット壊れフラグ＿ポプラ＿２ {
		eval( $f:w24b＿壊れフラグ＿ポプラ＿２ = 1 )
	}

	proc セット壊れフラグ＿ポプラ＿３ {
		eval( $f:w24b＿壊れフラグ＿ポプラ＿３ = 1 )
	}

	proc セット壊れフラグ＿ポプラ＿４ {
		eval( $f:w24b＿壊れフラグ＿ポプラ＿４ = 1 )
	}

	proc セット壊れフラグ＿ポプラ＿５ {
		eval( $f:w24b＿壊れフラグ＿ポプラ＿５ = 1 )
	}

	proc セット壊れフラグ＿ポプラ＿６ {
		eval( $f:w24b＿壊れフラグ＿ポプラ＿６ = 1 )
	}




//###################################################################################
//									ノード端末設定
//###################################################################################



proc ノード接続時プロック {

#if d:DEBUG_PRINT
	print 'node_set'
#endif

// 必ず必要。フラグの初期化はvarinit.hですでに行っています。
	eval($f:ノードフラグ = $f:w24b_ノードフラグ);
	eval($f:ノードフラグ = $f:w24c_ノードフラグ);
}



// 接続したフラグをたてたりする
proc ノード接続後プロック {
#if d:DEBUG_PRINT
	print 'node_event_go'
#endif

	eval($f:w24b_ノードフラグ = 1);
	eval($f:w24c_ノードフラグ = 1);

	command メニュー設定 -node_access on

// 接続後に何かイベントを起こしたい場合は以下に記入

}





//###################################################################################
//									鏡面モデル設定
//###################################################################################


	proc 鏡面モデル設定 {

		print '鏡面モデル設定'

		chara 鏡面モデル管理 床面映り込み \
			-pos 0,-4500,0 \
			-axis 1 // Y軸反転

/*
		mesg 鏡面モデル管理 床面映り込み add d:PLAYER

		mesg 鏡面モデル管理 床面映り込み add 攻撃兵:01
		mesg 鏡面モデル管理 床面映り込み add 攻撃兵:02
		mesg 鏡面モデル管理 床面映り込み add 攻撃兵:03

		mesg 鏡面モデル管理 床面映り込み add いけす攻撃兵:04
		mesg 鏡面モデル管理 床面映り込み add いけす攻撃兵:05
		mesg 鏡面モデル管理 床面映り込み add いけす攻撃兵:06

		mesg 鏡面モデル管理 床面映り込み add センサー敵兵
*/

		//リフレッシュルーム鏡面モデル管理
		trap ev_mirror ？ \
			-mask ？ \
			-exec {
				if($2 != センサー敵兵 && $2 != おしつけられ警備兵 && $2 != おしつけられ攻撃兵){
					if($3 == 入る){
						mesg 鏡面モデル管理 床面映り込み add $2
					}else{
						mesg 鏡面モデル管理 床面映り込み del $2
					}
				}
			}




	}









//###################################################################################
//									カメラ設定
//###################################################################################


	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0
		chara カメラ サブカメラ１		-c 0 -l 2 -p 50
		chara カメラ サブカメラ２		-c 0 -l 2 -p 40
		chara カメラ サブカメラ３		-c 0 -l 2 -p 30
		chara カメラ モーションカメラ	-c 0 -l 2 -p 20
		chara カメラ ノードカメラ		-c 0 -l 1 -p 20
		chara カメラ クリアリングカメラ	-c 1 -l 2 -p 0

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 750,2048,0 \
			-f 6500 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}








	proc 廊下カメラ設定 {
		#if d:DEBUG_PRINT
			print 'w24b_camera_set'
		#endif

		// エレベーター内
		trap ca001 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ２ \
					-c 1 \
					-p -64,1156,-73855 \
					-t -64,-3504,-74954 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3
			}

		// エレベーター前
		trap ca002 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ１ \
					-c 0 \
					-b -2000,d:CAM_MIN,d:CAM_MIN 2500,5500,-70850 \
					-l -2000,d:CAM_MIN,-72150 2500,-3400,-72150 \
					-r 850,2048,0 \
					-f 5000 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3 \
					-slide 0 30 1000 1000 60 1
			}

		// 南北通路
		trap ca003 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {

				@CS_スムーズカメラ昇順 $6 -70500 -68000 -3000 -9400
				eval( $i:補完ＢＸ１ = $i:CS_結果１ );

				@CS_スムーズカメラ昇順 $6 -70500 -66000 -2600 -4292
				eval( $i:補完ＢＸ２ = $i:CS_結果１ );

				@CS_スムーズカメラ昇順 $6 -69000 -66000 150 357
				eval( $i:補完ＲＸ = $i:CS_結果１ );

				@CS_スムーズカメラ昇順 $6 -70500 -68000 7500 4775
				eval( $w:補完距離 = $i:CS_結果１ );

				@CS_スムーズカメラ昇順 $6 -70500 -66000 200 160
				eval( $w:補完画角 = $i:CS_結果１ );

				chara カメラ設定 サブカメラ１ \
					-c 0 \
					-b $i:補完ＢＸ１,-2500,d:CAM_MIN $i:補完ＢＸ２,-500,-61000 \
					-l $i:補完ＢＸ１,d:CAM_MIN,d:CAM_MIN $i:補完ＢＸ２,-3000,-65092 \
					-r $i:補完ＲＸ,2048,0 \
					-f $w:補完距離 \
					-a $w:補完画角 \
					-i 2 -1 0 0 \
					-s $3



			}




		// 休憩室前
		trap ca004 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {

				chara カメラ設定 サブカメラ１ \
					-c 0 \
					-b -9400,-300,d:CAM_MIN -4292,-300,-61000 \
					-l -9400,-2900,d:CAM_MIN -4292,-300,-65092 \
					-r 357,2048,0 \
					-f 4775 \
					-a 160 \
					-i 2 -1 0 0 \
					-s $3
					//-slide 0 10 500 500 60 0


			}


		// 休憩室前南側はりつき
		trap ca004 d:PLAYER \
			-mask ＊ \
			-camera \
			-dir 2048,256 \
			-state d:TRP_STATE_BEHINDCAMERA_ENABLE \
			-exec {

				if($4 < -10000){
					eval($i:補完ＰＸ = -10000)
				}else if($4 > -2800){
					eval($i:補完ＰＸ = -2800)
				}else{
					eval($i:補完ＰＸ = $4)
				}

				chara カメラ設定 サブカメラ２ \
					-c 1 \
					-p $i:補完ＰＸ,1208,-63569 \
					-t $i:補完ＰＸ,-1263,-64225 \
					-a 200 \
					-i 2 -1 0 0 \
					-s $3

			}








	}


	proc リフレッシュルームカメラ設定 {

		// 休憩室
		trap ca005 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {

				chara カメラ設定 サブカメラ１ \
					-c 0 \
					-b -8500,d:CAM_MIN,-70000 -7000,d:CAM_MAX,-66500 \
					-l -8500,d:CAM_MIN,d:CAM_MIN -7000,d:CAM_MAX,-67800 \
					-r 640,2048,0 \
					-f 6500 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3
			}


		// 休憩室ロッカーそば
		trap ca007 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				if($3 == いる && $w:アラートモード == d:ALERT_MODE_SENNYU){
					chara カメラ設定 サブカメラ２ \
						-c 1 \
						-p -8187,1222,-65972 \
						-t -8297,-3710,-70198 \
						-a 173 \
						-i 2 2 0 0 \
						-s $3
				}else{
					chara カメラ設定 サブカメラ２ \
						-s -1
				}
			}


	}


	proc ノード部屋カメラ設定 {


		// ノード部屋
		trap ca006 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ１ \
					-c 1 \
					-p 6166,2149,-70862 \
					-t 6169,-4005,-72688 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3
			}

		// イントルードそば
		trap ca008 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ２ \
					-c 1 \
					-p 7524,-1968,-70657 \
					-t 7526,-4000,-70956 \
					-a 200 \
					-i 2 2 0 0 \
					-s $3
			}

	}









//###################################################################################
//									網膜センサー電撃
//###################################################################################


	proc 網膜センサー電撃 {
		#if d:DEBUG_PRINT
			print 'パネル電撃セット'
			print 'dengeki_set'
		#endif

		chara ドアパネル電撃 電撃パネル君 \
			-pos		-1500,-2750,-67500 \
			-rot		0,1024,0 \
			-width		500 \
			-height		1000

	}



//###################################################################################
//								網膜センサーロード設定
//###################################################################################


	proc 網膜センサー覗き込みデモ強制終了 {
		command 強制モーションキャンセル
	}


	proc 網膜センサー覗き込みデモ終了 {

		eval($f:網膜センサーロード中 = 0)

		mesg デモキャンセルチェック デモキャンセル kill

		mesg delay 網膜センサーデモディレイ kill
//		command 強制モーションキャンセル

		@シナリオデモ終了処理

	}


	proc 網膜センサーロード設定 {

		#if d:DEBUG_PRINT
			print '網膜センサーロード設定'
			print 'eye_sensor'
		#endif

		eval($f:網膜センサーロード中 = 0)



		//ライデン覗き込み
		trap ev000 d:PLAYER \
			-mask 入る \
			-state d:TRP_STATE_STAND \
			-dir 1024,256 \
			-button d:ACTION_BUTTON \
			-exec {

				if($w:アラートモード == d:ALERT_MODE_SENNYU && !$f:網膜センサーロード中){

					@rp_w24b_網膜センサー覗き込み時無線系処理＿ライデンが自分で覗きやがったぶりんちょ

					@シナリオデモ開始処理
					mesg コマンダー 敵兵セット 視界オン

					chara デモキャンセルチェック デモキャンセル \
						-p 網膜センサー覗き込みデモ強制終了

					command 強制モーション終了プロック \
						-motion d:モーションリスト:rai_non_eye_sensor_self_w24b \
						-proc 網膜センサー覗き込みデモ終了

					mesg プレイヤー d:PLAYER motion \
						d:モーションリスト:rai_non_eye_sensor_self_w24b \
						1024 \
						-1 \
						0 \
						(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_WEAPON) \
						(-1400 - 600) -67500 (-4500 + 950)//x,z,yの順

					chara delay 網膜センサーデモディレイ -time 300 -exec{
						@網膜センサーＳＥ処理 0
					}

					chara delay 網膜センサーデモディレイ -time 420 -exec{
						print 'アナウンス「網膜パターンが一致しません」'
						eval( $i:STREAM_ID = `%Stream t:vc103802` );
					}

					chara delay 網膜センサーデモディレイ -time 390 -exec{
						mesg プットオブジェ 網膜センサーランプ赤 off
						chara delay 網膜センサーデモディレイ -time 30 -exec{
							mesg プットオブジェ 網膜センサーランプ赤 on
							chara delay 網膜センサーデモディレイ -time 30 -exec{
								mesg プットオブジェ 網膜センサーランプ赤 off
								chara delay 網膜センサーデモディレイ -time 30 -exec{
									mesg プットオブジェ 網膜センサーランプ赤 on
								}
							}
						}
					}



				}

			}



		//ライデン覗き込み発見されたら強制終了
		trap ev000 d:PLAYER \
			-mask いる \
			-state d:TRP_STATE_FORCE \
			-dir 1024,256 \
			-exec {

				if(!$f:網膜センサーロード中){
					command ゲットゲームステータス \
						$i:ゲームステータス

					if($i:ゲームステータス & 0x00000001){
					// 発見～危険モードの間

						print 'キャンセル発動'

						@網膜センサー覗き込みデモ強制終了
					}
				}

			}


		trap ev000 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_FORCE \
			-dir 1024,256 \
			-exec {

				chara カメラ設定 サブカメラ３ \
					-c 1 \
					-p -2986,-347,-65770 \
					-t -1511,-3284,-67004 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3

			}



#ifdef JAPANESE
		eval( $w:ローカル変数Ｗ２ = 2048 );
#else
		if($w:ゲーム設定 <= d:LEVEL_EASY){
			eval( $w:ローカル変数Ｗ２ = 2048 );
		}else{
			eval( $w:ローカル変数Ｗ２ = 700 );
		}
#endif

		//押し付けられ処理
		trap ev000 d:PLAYER \
			-mask いる \
			-state d:TRP_STATE_STAND \
			-dir 1024,$w:ローカル変数Ｗ２ \
			-exec {

				if(!$f:網膜センサーロード中){
					command ゲット捕まえられ兵の本当の名前 $s:敵兵名

					if($s:敵兵名 == 攻撃兵:01 \
					|| $s:敵兵名 == 攻撃兵:02 \
					|| $s:敵兵名 == 攻撃兵:03 \
					|| $s:敵兵名 == いけす攻撃兵:04 \
					|| $s:敵兵名 == いけす攻撃兵:05 \
					|| $s:敵兵名 == いけす攻撃兵:06 \
					|| $s:敵兵名 == いけす攻撃兵:07 \
					|| $s:敵兵名 == いけす攻撃兵:08 \
					){
						if($s:敵兵名 != 0){
							command ゲット敵兵状態拡張版 \
								$s:敵兵名 $i:敵兵状態
/*
							状態
							0x00000004	// 首締められている
							0x00000008	// ひきづられている
*/
							if(($w:アラートモード == d:ALERT_MODE_SENNYU || $w:アラートモード == d:ALERT_MODE_TANSAKU) && ($i:敵兵状態 & 0x00000004)){
								print '敵兵つかまってドアオープン！！！！！！！！'
								@網膜センサーロード開始
							}
						}
					}
				}

			}


		//死体、眠り、気絶を持ってきたとき
		trap ev000 d:PLAYER \
			-mask 入る \
			-state d:TRP_STATE_ENEMY_PULL \
			-dir 1024,$w:ローカル変数Ｗ２ \
			-exec {
				command ＳＥセットモード -s d:SD_S_BUZZER01 -p -1500,-3000,-67500 -m 0	 //カードキーＮＧブザー1
			}


		chara プットモーションモデル おしつけられ警備兵 \
			-pos (-1400 - 1319),(-4500),(-67500 + 94) \
			-dir 1024 \
			-kms gbs_def \
			-mar gbs_sensor \
			-number  d:センサーモーションリスト:gbs_idle \ /*省略時０*/
//			-item	$s:装備モデル名 $i:関節番号 \ /*オブジェを付随*/
			-C 網膜センサーおしつけられ終了 \	//$p:終了時プロック
			-status	(d:PUT_MOT_WAIT | d:PUT_MOT_NO_INTERP | d:PUT_MOT_INVISIBLE | d:PUT_MOT_THERMAL)


		chara プットモーションモデル おしつけられ攻撃兵 \
			-pos (-1400 - 1319),(-4500),(-67500 + 94) \
			-dir 1024 \
			-kms gba_def_mt \
			-mar gbs_sensor \
			-number  d:センサーモーションリスト:gbs_idle \ /*省略時０*/
			//-item	$s:装備モデル名 $i:関節番号 \ /*オブジェを付随*/
			-C 網膜センサーおしつけられ終了 \	//$p:終了時プロック
			-status	(d:PUT_MOT_WAIT | d:PUT_MOT_NO_INTERP | d:PUT_MOT_INVISIBLE | d:PUT_MOT_THERMAL)




	}





	proc 網膜センサーロード開始 {

		eval($f:網膜センサーロード中 = 1)

		@シナリオデモ開始処理

		//chara delay 網膜センサーロードディレイ -time 30 -exec{

			chara delay 網膜センサーデモディレイ -time 2 -exec{
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p -2634,-1311,-67767 \
					-t -112,-5242,-66812 \
					-a 173 \
					-i 0 0 0 0 \
					-s 1
			}

			chara delay 網膜センサーデモディレイ -time 53 -exec{
				chara パッド振動 振動君 \
					-vibfile biometrix
			}

			//おしつけライデン
			mesg プレイヤー d:PLAYER motion \
				d:モーションリスト:rai_non_eye_sensor_gbs_w24b \
				1024 \
				-1 \
				0 \
				(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_WEAPON | d:FA_NO_INTERP) \
				(-1400 - 1065) (-67500 + 489) (-4500 + 950)//x,z,yの順

			chara delay 網膜センサーデモディレイ -time 120 -exec{

				chara カメラ設定 ノードカメラ \
					-c 1 \
					-p -3169,-1129,-68380 \
					-t -265,-4766,-67355 \
					-a 160 \
					-i 0 0 0 0 \
					-s 1

				chara カメラ設定 ノードカメラ \
					-c 1 \
					-p -3180,-1129,-66362 \
					-t -265,-4766,-67355 \
					-a 160 \
					-z d:CAMERA_INTERP_CAMERA \ //補完カメラフラグを指定。
					-interp_time 600 \ 			//補完時間を指定
					-s 1


				@網膜センサーＳＥ処理 1
			}

			chara delay 網膜センサーデモディレイ -time 210 -exec{
				print 'アナウンス「網膜パターンを照合しました。どうぞ、お入りください」'
				eval( $i:STREAM_ID = `%Stream t:vc103801` );
			}

			chara delay 網膜センサーロードディレイ -time 210 -exec{
				mesg プットオブジェ 網膜センサーランプ赤 off
				mesg プットオブジェ 網膜センサーランプ青 on
			}


			mesg 敵兵共通 攻撃兵 永久アンリアルＯＮ
			mesg 敵兵共通 いけす攻撃兵 永久アンリアルＯＮ

			//おしつけられ敵兵
			if($s:敵兵名 == 攻撃兵:01 || $s:敵兵名 == 攻撃兵:02 || $s:敵兵名 == 攻撃兵:03 ){
				mesg プットモーションモデル おしつけられ警備兵 終了判定 \
					d:センサーモーションリスト:gbs_forced
			}else{
				mesg プットモーションモデル おしつけられ攻撃兵 終了判定 \
					d:センサーモーションリスト:gbs_forced
			}

		//}

	}





	proc 網膜センサーおしつけられ終了 {

		mesg ドア 人質部屋ドア open

		chara delay 網膜センサーロードディレイ -time 240 -exec{

			chara カメラ設定 ノードカメラ \
				-s -1

			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p -3267,-1076,-67573 \
				-t -2375,-2563,-67304 \
				-a 138 \
				-i 0 0 0 0 \
				-s 1

			mesg プレイヤー d:PLAYER position \
				-2000 -4000 -66250

			if($w:p_story < d:ST:P039_01_P01人質部屋潜入１ポリゴンデモ１開始){
				eval($w:p_story = d:ST:P039_01_P01人質部屋潜入１ポリゴンデモ１開始)
/*
				if ( $w:アイテム == d:アイテム:ゴル兵制服 ) {
					preseek "r_plt4"
				} else {
					preseek "d036p03"
				}
*/
				if ( $w:アイテム == d:アイテム:ゴル兵制服 ) {
					preseek "r_plt4"
				} else {
					preseek "d036p03"
				}

				@ステージ終了時処理 0 -4500 -66250 1024 人質部屋潜入１ポリゴンデモ１呼び出し d:DEFAULT_M_TYPE
			}else{
				preseek 'w24c'
				@ステージ終了時処理（ステージ名表示） 0 -4500 -66250 1024 mv_w24b_w24c_0 d:DEFAULT_M_TYPE d:wn_シェル１中央棟Ｂ１集会場
			}

		}


	}






	proc 網膜センサーＳＥ処理 $:可否 {

		eval($w:w24b_網膜センサーカウンタ = 0)

		command ＳＥセットモード -s d:se_code:SD_S_EYECHK01 -p -1500,-3000,-67500 -m 0	//網膜チェックスタート

		chara delay 網膜センサーデモディレイ -time 20 -arg $:可否 -exec{

			if($1 == 3){
				eval( $w:ローカル変数Ｗ１ = 30 );
			}else{
				eval( $w:ローカル変数Ｗ１ = 50 );
			}

			if($w:w24b_網膜センサーカウンタ <= $w:ローカル変数Ｗ１){

				command ＳＥセットモード -s d:se_code:SD_S_EYESCN01 -p -1500,-3000,-67500 -m 0	//網膜チェックスタート
				eval($w:w24b_網膜センサーカウンタ = $w:w24b_網膜センサーカウンタ + 8)

				return 8

			}else{
				if($1 == 1 || $1 == 3){
					print '成功音'
					command ＳＥセットモード -s d:se_code:SD_S_EYEOK01 -p -1500,-3000,-67500 -m 0	//網膜チェック成功
				}else{
					print '失敗音'
					command ＳＥセットモード -s d:se_code:SD_S_EYENOT01 -p -1500,-3000,-67500 -m 0	//網膜チェック失敗
				}
				return 0

			}

		}

	}






//###################################################################################
//								網膜センサーデモ設定
//###################################################################################


	proc 網膜センサーデモ設定 {


		if($w:p_story < d:ST:P038_01_S01網膜チェック１シナリオデモ１開始 &&  $s:登場ポイント != sp_w24c_w24b_0 ){
			chara ルートデモ人形 センサー敵兵 \
				-route 8 0 \
				-kms gbs_def \ /*EVMを表示する場合はダミーKMSが必要*/
				-mar gbs_sensor \
				-weapon 3 \
				-status 0x02 \		//(0x02) レーダー視界表示
				-number d:センサーモーションリスト:gbs_walk


			chara パッドデモ ライデン網膜センサー覗き込み \
				-file w24b_eyesensor \
#if d:MOTION_RECORDER
				-end_proc モショレコ終了
#else
				-end_proc 網膜センサーデモ終了
#endif






			//廊下に出たので起動
			trap ca002 d:PLAYER \
				-mask 入る \
				-exec {
					@網膜センサーデモ起動
				}


			eval($w:網膜センサー敵兵をみつけたカウンター = 0)

			//敵兵見たので起動
			trap ca001 d:PLAYER \
				-mask いる \
				-state d:TRP_STATE_SUBJECT,d:TRP_STATE_BEHIND \
				-exec {
					if(`%カメラ視界チェック -camera 0x03 \
						-pos -2420 -4000 -67570` == 1){

						if($w:網膜センサー敵兵をみつけたカウンター > 120 || (`%パッドチェック -which 0 -status` & d:PAD_Y) ){
							@網膜センサーデモ起動

						}else{
							eval($w:網膜センサー敵兵をみつけたカウンター = $w:網膜センサー敵兵をみつけたカウンター + 1)
						}

					}

				}


		}



#if d:MOTION_RECORDER
/*
		trap ca002 d:PLAYER \
			-mask 入る \
			-dir 2048,256 \
			-state d:TRP_STATE_CAUTION \
			-exec {

				chara delay ディレイ -time 90 -exec{
					@網膜センサーデモ発動
				}

			}
*/
#endif




#if d:DEFORCUS
		chara 近景ぼかし 強力近景ぼかし \
			-plane	20 \
			-near	0 \
			-far	4000

		chara 遠景ぼかし 強力遠景ぼかし \
			-plane 20 \
			-near 3000 \
			-far 5000


		//自動的にＯＦＦで登場

#endif


	}



	proc 網膜センサーデモ起動 {

		if(`%ゲームオーバーチェック` == 0 && $w:p_story < d:ST:P038_01_S01網膜チェック１シナリオデモ１開始){

			eval($w:p_story = d:ST:P038_01_S01網膜チェック１シナリオデモ１開始)
			print '$w:p_story = d:ST:P038_01_S01網膜チェック１シナリオデモ１開始'


			@シナリオデモ開始処理

			mesg プレイヤー d:PLAYER stance \
				0 \
				0 \
				0 \
				d:FA_NO_WEAPON

			chara demo 網膜センサーカメラデモ \
				-S \		// SEを禁止しない(STATE_DEMOを立てない)
				-i t:scndemo_w24b \
				-begin 網膜センサーデモスタート直前処理 \
				-next 網膜センサー終了処理 \
				-undraw d:DEMO_NO_UNDRAW



		}

	}



	proc モショレコ終了 {
		mesg モーションレコーダー モショレコライデン rec_stop
		@シナリオデモ終了処理
	}



	proc 網膜センサーデモスタート直前処理 {

		chara デモキャンセルチェック デモキャンセル \
			-p 網膜センサーデモ終了

		chara フェードインアウト フェードイン \
			-i 0,0,0 128 \
			-c 0,0,0 0 \
			-t d:FADEIN_TIME

		mesg パッドデモ ライデン網膜センサー覗き込み start

		chara delay ディレイ -time 1 -exec{
			@網膜センサーデモ発動
		}


	}



	proc 網膜センサーデモ終了 {

		mesg デモキャンセルチェック デモキャンセル kill

		command セットサウンドコード -c d:SNG_FOUTS_S		//ＢＧＭフェードアウト

		chara フェードインアウト フェードアウト \
			-i 0 0 0 0 \		//設定するとこのＲＧＢαから始まる
			-c 0 0 0 128 \		//目標のＲＧＢα
			-t d:FADEOUT_TIME \
			-p 網膜センサーフェードアウト終了
	}


	proc 網膜センサーフェードアウト終了 {
		eval( $i:プレイヤー初期Ｘ位置 = $i:プレイヤー位置Ｘ ) ;
		eval( $i:プレイヤー初期Ｙ位置 = $i:プレイヤー位置Ｙ ) ;
		eval( $i:プレイヤー初期Ｚ位置 = $i:プレイヤー位置Ｚ ) ;
		eval( $i:プレイヤー初期方向 = $w:プレイヤー方向 ) ;
		eval( $s:登場ポイント = 網膜センサーデモ後リスタート ) ;

		eval($w:p_story = d:ST:P038_01_S01網膜チェック１シナリオデモ１終了)
		print '$w:p_story = d:ST:P038_01_S01網膜チェック１シナリオデモ１終了'

		command varsave $w:p_story

		restart
	}





	proc 網膜センサーデモ発動 {


#if	d:MOTION_RECORDER
		print 'モチョン録音！！'
		mesg モーションレコーダー モショレコ敵兵 rec_start
		mesg モーションレコーダー モショレコライデン rec_start

#endif




#if 0
		chara カメラ設定 モーションカメラ \
			-c 1 \
			-p -2066,-358,-61599 \
			-t -1273,-3809,-65820 \
			-a 168 \
			-i 0 0 0 0 \
			-s 1
#endif

		print 'ルート1に変更'
		mesg ルートデモ人形 センサー敵兵 ルート変更 1



//焦点を近景から遠景へ
/*
		mesg 遠景ぼかし 強力遠景ぼかし on
		chara delay 網膜センサーデモディレイ -time 150 -exec{
			mesg 遠景ぼかし 強力遠景ぼかし set (149 * 5) 0 40000 80000
			chara delay 網膜センサーデモディレイ -time 150 -exec {
				mesg 遠景ぼかし 強力遠景ぼかし off
			}

			mesg 近景ぼかし 強力近景ぼかし on

			chara delay 網膜センサーデモディレイ -time 1 -exec {
				mesg 近景ぼかし 強力近景ぼかし set (149 * 5) 0 1000 5000
			}
		}
*/
//焦点を近景から遠景へ





		chara delay 網膜センサーデモディレイ -time 270 -exec{
			@網膜センサーＳＥ処理 3
		}

		chara delay 網膜センサーデモディレイ -time 300 -exec{
			print 'アナウンス「網膜パターンを照合しました。どうぞ、お入りください」'
			eval( $i:STREAM_ID = `%Stream t:vc103801` );
		}

		chara delay 網膜センサーデモディレイ -time 330 -exec{
			mesg プットオブジェ 網膜センサーランプ赤 off
			mesg プットオブジェ 網膜センサーランプ青 on

		}

		chara delay 網膜センサーデモディレイ -time 360 -exec{


			mesg ドア 人質部屋ドア open

			chara delay 網膜センサーデモディレイ -time 240 -exec{

				mesg ドア 人質部屋ドア close
				mesg プットオブジェ 網膜センサーランプ青 off
				mesg プットオブジェ 網膜センサーランプ赤 on

				chara delay 網膜センサーデモディレイ -time 90 -proc 網膜センサーデモ終了


				eval($b:シェル１Ｂ１巡回中敵兵 = 0)

			}

		}


	}




	proc 網膜センサー終了処理 {
		mesg デモキャンセルチェック デモキャンセル kill

		mesg 近景ぼかし 敵兵発見近景ぼかし off

//		chara カメラ設定 モーションカメラ \
//			-s -1

#if d:MOTION_RECORDER
		mesg モーションレコーダー モショレコ敵兵 rec_stop
#endif

		mesg 鏡面モデル管理 床面映り込み del センサー敵兵

		chara delay ディレイ -time 1 -exec{
			mesg ルートデモ人形 センサー敵兵 kill
		}



	}











//###################################################################################
//								警報デモ設定
//###################################################################################


	proc 警報デモステップ１ {

		chara デモキャンセルチェック デモキャンセル \
			-p 警戒デモキャンセル

		print '放送「侵入者をシェルで発見！警戒レベルを強化！」'
		//eval( $i:STREAM_ID = `%Stream t:vc104101 -p 警戒デモステップ２` );
		eval( $i:STREAM_ID = `%Stream t:vc104101 -p 警戒デモ後強制無線開始` );



//		@警戒カメラ１

//		chara delay 警戒デモディレイ -time 300 -exec{

			@警戒カメラ２

			chara delay 警戒デモディレイ -time 300 -exec{

				@警戒カメラ３

			}

//		}


	}


	proc 警戒デモステップ２ {

		if($1 == 0){
			print '放送「繰り返す…」'
			eval( $i:STREAM_ID = `%Stream t:vc104102 -p 警戒デモステップ３` );
		}

	}



	proc 警戒デモステップ３ {

		if($1 == 0){
			chara カメラ設定 モーションカメラ \
				-s -1

			print '放送「侵入者をシェルで発見！警戒レベルを強化！」'
			eval( $i:STREAM_ID = `%Stream t:vc104101 -p 警戒デモ後デモステップ３終了`);

/*
			chara delay 警戒デモディレイ -time 120 -exec{
				%セットサウンドコード -c d:STR1_FADE_OUT	//ストリーミングch.1のフェードアウト
				%セットサウンドコード -c d:STR2_FADE_OUT	//ストリーミングch.2のフェードアウト
			}
*/

		}


	}

	proc 警戒デモ後デモステップ３終了 {
		if($1 == 0){
			@警戒デモ後強制無線開始
		}
	}


	proc 警戒デモキャンセル {

		chara カメラ設定 モーションカメラ \
			-s -1

		mesg アタッカー 攻撃兵:01 ルート変更 d:アタッカー警戒北廊下巡回
		mesg アタッカー 攻撃兵:02 ルート変更 d:西側巡回
//		mesg 警備兵 敵兵:01 ルート変更 d:西側巡回 9000 -6500 -67000 シェル１中央棟Ｂ１
//		mesg 警備兵 敵兵:02 ルート変更 d:アタッカー東待機 9000 -6500 -67000 シェル１中央棟Ｂ１

		@警戒デモ後強制無線開始
	}



	proc 警戒デモ後強制無線開始 {


		mesg デモキャンセルチェック デモキャンセル kill

		mesg delay 警戒デモディレイ kill


		eval($w:p_story = d:ST:P041_02_R01エイムズ死亡後２無線デモ１開始)
		print '$w:p_story = ST:P041_02_R01エイムズ死亡後２無線デモ１開始'

		/* ライデン		「大佐、エイムズが死んだ。心臓発作のようだった」 */

		@rt_P041_02_R01エイムズ死亡後２無線デモ１

	}






	//網膜センサーから回転
	proc 警戒カメラ１ {

		chara カメラ設定 モーションカメラ \
			-c 1 \
			-p -2159,-1187,-64019 \
			-t -5497,-4373,-65014 \
			-a 112 \
			-i 0 -1 0 0 \
			-s 1


		chara delay 警戒デモディレイ -time 1 -exec{

			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p -2159,-1187,-64019 \
				-t -3312,-4373,-67305 \
				-a 112 \
				-z d:CAMERA_INTERP_CAMERA \ //補完カメラフラグを指定。
				-interp_time 300 \ 			//補完時間を指定
				-s 1


		}



	}



	//床をなめてノード部屋入口映す
	proc 警戒カメラ２ {

		chara カメラ設定 モーションカメラ \
			-c 1 \
			-p -3370,-4385,-69618 \
			-t 1006,-3746,-69853 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1

		chara カメラ設定 モーションカメラ \
			-c 1 \
			-p -3483,-4385,-71757 \
			-t 1164,-3746,-72007 \
			-a 300 \
			-z d:CAMERA_INTERP_CAMERA \ //補完カメラフラグを指定。
			-interp_time 400 \ 			//補完時間を指定
			-s 1



		chara delay 警戒デモディレイ -time 180 -exec{
			print '攻撃兵０１ルート変更！！！'
//			mesg 警備兵 敵兵:02 ルート変更 d:アタッカー警戒北廊下巡回 9000 -6500 -67000 シェル１中央棟Ｂ１
//			mesg アタッカー 攻撃兵:01 警戒ルート変更 d:アタッカー警戒北廊下巡回
			mesg アタッカー 攻撃兵:01 ルート変更 d:アタッカー警戒北廊下巡回

		}


	}





	//リフレッシュルームパン
	proc 警戒カメラ３ {

		chara カメラ設定 モーションカメラ \
			-c 1 \
			-p -6665,-1272,-66424 \
			-t -5642,-3035,-70733 \
			-a 200 \
			-i 0 0 0 0 \
			-s 1



		chara カメラ設定 モーションカメラ \
			-c 1 \
			-p -9135,-1146,-69111 \
			-t -10415,-3750,-72889 \
			-a 200 \
			-z d:CAMERA_INTERP_CAMERA \ //補完カメラフラグを指定。
			-interp_time 300 \ //補完時間を指定
			-s 1

		chara delay 警戒デモディレイ -time 301 -exec{
			chara カメラ設定 モーションカメラ \
				-s -1
		}

		chara delay 警戒デモディレイ -time 180 -exec{
			mesg アタッカー 攻撃兵:02 ルート変更 d:西側巡回
			//mesg 警備兵 敵兵:01 ルート変更 d:西側巡回 9000 -6500 -67000 シェル１中央棟Ｂ１
		}





	}



//###################################################################################
//								西側マップ接合管理
//###################################################################################

	proc 西側マップ接合管理 {

		trap ev2000 d:PLAYER \
			-mask ？ \
			-A \		//マップ接合
			-exec {

				if($3 == 入る){
					mesg マップ接合 西側マップ接合 on
				}else{
					if(!$f:w24b_西側マップ接合禁止){
						mesg マップ接合 西側マップ接合 off
					}
				}

			}


	}


