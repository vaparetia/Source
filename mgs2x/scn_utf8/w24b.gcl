	proc クリアリングカメラ２突入 {

	#if d:CLEAR_CAMERA
print '突入！！'

		command カメラマップ設定 \
			-chanl 1 \                // １が子画面
			-map ノード部屋


		eval($w:補完画角 = 278)

		chara delay クリアリング突入ディレイ -time 1 -exec{


			if($w:補完画角 > 150){
				eval($w:補完画角 = $w:補完画角 - 1)
			}

			chara カメラ設定 クリアリングカメラ \
				-c 1 \
				-p 7490,-1042,-70649 \
				-t 3593,-4042,-72500 \
				-a $w:補完画角 \
				-i 0 -1 0 0 \
				-s 1

			if($w:アラートモード == d:ALERT_MODE_KAIHI){
				return 1
			}else{
				return 0
			}

		}


		#if d:SUB_CAMERA
			mesg サブ画面 子画面 on
		#endif

	#endif
	}





