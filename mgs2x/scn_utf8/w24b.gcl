//###################################################################################
//									ドア設定
//###################################################################################


	proc ドア設置 {
		#if d:DEBUG_PRINT
			print 'slide_door_set'
		#endif

		@ドアランプ設定 ノード部屋ドアランプ 3072 4125 -4500 -72500 0


		chara ドア ノード部屋ドア \
			-m d:DOOR_NAME \
			-d 0,3072,0 \
			-p 4125,-4500,-72500 \
			-slide d:SD_SLIDE_INSIDE \
			-time d:SD_OPEN_TIME \
			-A ノード部屋ドアランプ \
			-between シェル１中央棟Ｂ１ ノード部屋 \
			-exec {
				if( $:開閉フラグ == 0 ){
					mesg マップ接合 東側マップ接合 off
				} else {
					mesg マップ接合 東側マップ接合 on
				}
			}
		trap dr001 ？ \
			-mask ？ \
			-exec {
				if($3==入る){
					mesg ドア ノード部屋ドア open
				}else{
					mesg ドア ノード部屋ドア close
				}
			}


		trap dr001_behind d:PLAYER \
			-mask ？ \
			-dir 1024,256 \
			-state d:TRP_STATE_BEHINDCAMERA_ENABLE \
			-exec {
				if($3==入る){
					mesg ドア ノード部屋ドア open
				}else{
					mesg ドア ノード部屋ドア close
				}
			}


		chara ドア 人質部屋ドア \
			-m d:DOOR_NAME_LOAD \
			-d 0,3072,0 \
			-p -1325,-4500,-67000 \
			-slide d:SD_SLIDE_INSIDE \
			-time d:SD_OPEN_TIME \
			-between シェル１中央棟Ｂ１ シェル１中央棟Ｂ１ \
			-exec {
				if( $:開閉フラグ == 0 ){
					mesg プットオブジェ ロード部屋 off
				} else {
					mesg プットオブジェ ロード部屋 on
				}
			}

/*
		trap dr002 ？ \
			-mask ？ \
			-exec {
				if($3==入る){
					mesg ドア 人質部屋ドア open
				}else{
					mesg ドア 人質部屋ドア close
				}
			}
*/




		trap dr002 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_FORCE \
			-dir 3072,256 \
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p -3415,-1198,-64052 \
					-t -1013,-3594,-67408 \
					-a 162 \
					-i 0 -1 0 0 \
					-s $3
			}

		chara プットオブジェ 網膜センサーランプ青 -m w24b0_lamp_on -r 0 0 0 \
			-s 100,100,100 \
			-p 0 0 0 -l w24b

		mesg プットオブジェ 網膜センサーランプ青 off


		chara プットオブジェ 網膜センサーランプ赤 -m w24b0_lamp_off -r 0 0 0 \
			-s 100,100,100 \
			-p 0 0 0 -l w24b





	}








//###################################################################################
//									ドア設定
//###################################################################################

	proc イントルード金網設定 {
		#if d:DEBUG_PRINT
			print 'イントルード金網設定'
			print 'INTRUDE_KANAAMI'
		#endif

		trap fence_000 d:PLAYER \
			-mask ＊ \
			-dir 1024,256 \	//方向指定
			-exec {
				command イントルード主観カメラ補正 \
					-se d:se_code:SD_P_HEADNET1 \
					-len 1000 \
					-inout $3
			}
	}



//###################################################################################
//									ドア設定
//###################################################################################


	proc アイテム設置 {
		#if d:DEBUG_PRINT
			print 'item_set'
			print 'アイテム設置'
		#endif



		//ノード部屋ロッカー内
		@アイテム再セットチェック $b:w24b_取得ロード回数[0]
		if ($f:再セットフラグ) {
			@レーション_初期設置 レーション１ 5750 -4500 -73750 0
		}


		//廊下南端
		@アイテム再セットチェック $b:w24b_取得ロード回数[1]
		if ($f:再セットフラグ) {
			@弾薬_Ｍ４_初期設置 弾薬_Ｍ４１ -11250,-4500,-64000 0
		}



		//リフレッシュロッカー内
		@アイテム再セットチェック $b:w24b_取得ロード回数[2]
		if ($f:再セットフラグ) {
			@弾薬_ソコム_初期設置 弾薬_ソコム１ -8500,-4500,-69100 0
		}


		//リフレッシュロッカー内
		@アイテム再セットチェック $b:w24b_取得ロード回数[3]
		if ($f:再セットフラグ) {
			@スタン_初期設置 スタン１ -10500,-4500,-69100 0
		}





	}


	proc アイテム取得時番号設定 $:ボックス名 {
	#if d:DEBUG_PRINT
		print 'item_no_set'
	#endif

		if($:ボックス名 == レーション１) {
			eval($b:w24b_取得ロード回数[0] = $w:グローバルロード回数);

		} else if ($:ボックス名 == 弾薬_Ｍ４１) {
			eval($b:w24b_取得ロード回数[1] = $w:グローバルロード回数);

		} else if ($:ボックス名 == 弾薬_ソコム１) {
			eval($b:w24b_取得ロード回数[2] = $w:グローバルロード回数);

		} else if ($:ボックス名 == スタン１) {
			eval($b:w24b_取得ロード回数[3] = $w:グローバルロード回数);

		}

		#if d:DEBUG_PRINT
			print $:ボックス名
			print $w:グローバルロード回数
		#endif



	}













//###################################################################################
//									ロード退場
//###################################################################################

	proc ロードプロック {
		#if d:DEBUG_PRINT
			print 'load_proc'
		#endif

		if($s:呼び出しプロック == 人質部屋潜入１ポリゴンデモ１呼び出し){
			command セットサウンドコード -c d:SNG_FOUTS_S		//ＢＧＭフェードアウト

			eval($f:rfp_w24b_網膜センサー通過した = 1)

			if ( $w:アイテム == d:アイテム:ゴル兵制服 ) {
				load "d036p03" -r 'r_plt4'
			} else {
				load "d036p03" -r 'r_plt0'
			}


		}else if ($s:呼び出しプロック == mv_w24b_w24a_0) {
			// １Ｆへ
			@mv_w24b_w24a_0

		} else if ($s:呼び出しプロック == mv_w24b_w24c_0) {
			command セットサウンドコード -c d:SNG_FOUTS_S		//ＢＧＭフェードアウト

			// 人質部屋へ
			@mv_w24b_w24c_0


		} else if ($s:呼び出しプロック == mv_w24b_w24d_0) {
			// Ｂ３へ
			@mv_w24b_w24d_0

		}
	}

	proc ロード設定 {
		#if d:DEBUG_PRINT
			print 'load_set'
		#endif

		trap ld002 d:PLAYER \
			-mask 入る \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 1 ) {
					//人質部屋へ
					@ステージ終了時処理 0 -4500 -66250 1024 mv_w24b_w24c_0 d:DEFAULT_M_TYPE
				}
			}


	}




















//###################################################################################
//								エフェクト設定
//###################################################################################


	// フォグ
	// ------------------------------------
	proc フォグ設定 {
		#if d:DEBUG_PRINT
			print 'フォグ設定'
		#endif

		chara フォグ 霧\
			-c 50,69,50 \
			-n 0 \
			-f 33000


	}

	// キャラ用光源(マップの設置が終わってから設定することで、キャラだけに光を当てる)
	// ------------------------------------
	proc キャラ用ライト設置 {
		#if d:DEBUG_PRINT
			print 'chara_light_set'
		#endif

		chara 環境光 環境光源 \
			 -c 40 67 62

		chara 平行光 平行光源 \
			 -c 80 85 90 \
			 -p 2400 -3000 -3200
	}

	// エフェクト関係
	// -----------------------------------
	proc エフェクト設定 {
		#if d:DEBUG_PRINT
			print 'effect_set'
		#endif

		#if d:BLUR
			chara ブラー ブラー
		#endif

		#if d:Z_MANAGER
			chara Ｚフォーカス管理 Z_manager
			mesg Ｚフォーカス管理 Z_manager パラメータ 5000 30
		#endif

		#if d:BODY_SHADOW
			chara ＯＦＦ制御 off_man
			mesg ＯＦＦ制御 off_man ボディシャドウＯＦＦ
		#endif







	// 跳弾番号設定
	// ------------------------------------
		command 跳弾ノーマル -n 0
		command 跳弾ノーマル -n 1
		command 跳弾ノーマル -n 2
		command 跳弾ノーマル -n 3
		command 跳弾ノーマル -n 4
		command 跳弾ＳＥのみ -n 6
		command 跳弾ＳＥのみ -n 7

		command 弾痕ノーマル -n 0
		command 弾痕ノーマル -n 1
		command 弾痕ノーマル -n 2
		command 弾痕ノーマル -n 3
		command 弾痕ノーマル -n 4
		command 弾痕ノーマル -n 6
		command 弾痕ノーマル -n 7







		chara シネマスクリーン シネマ -top d:CINEMA_BELT_UPPER -bottom d:CINEMA_BELT_LOWER -ftime 30



//レーダーアタリ処理
