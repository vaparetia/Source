		// 警備兵３足音
		command 壁床効果音設定 -id 3 -type 0 -se d:SD_P_FOOTL01 \ // -dataオプションは必ず８セット書くこと
			-data	d:se_code:SD_E_EFOOT_1L3,d:NOISE_ZERO \
