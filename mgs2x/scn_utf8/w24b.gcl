	proc 子画面設定 {
	#if d:SUB_CAMERA
		chara サブ画面 子画面 \
			-w (512-d:SUB_MARGIN-d:SUB_WIDTH),d:SUB_MARGIN (512-d:SUB_MARGIN),(d:SUB_HEIGHT+d:SUB_MARGIN)
	#endif
	}



	proc クリアリングカメラＯＦＦ {

	#if d:CLEAR_CAMERA
		#if d:SUB_CAMERA
			mesg サブ画面 子画面 off
		#endif
			chara カメラ設定 クリアリングカメラ \
				-s -1

	#endif

		mesg delay クリアリング自販機そばディレイ kill

		eval( $f:w24b_西側マップ接合禁止 = 0 );

		if($w:アラートモード != d:ALERT_MODE_KIKEN){
			eval($f:w24bリフレッシュクリアリング中 = 0)
		}

	}



	//クリアリングの前にみんな元気かを調べる
	proc みんな元気かチェック $:人数 {
		print 'health_check!!!!!!!!!!!!'
		print 'みんなー元気かー！！！？？？？？'
		print '今日のチェックは'$1'人！！！！！！'

		eval( $i:ローカル変数Ｉ１ = 0 );

		command foreach -argc 3 -repeat 6 \
			-data { \
				{1,$1,攻撃兵:01}
				{2,$1,攻撃兵:02}
				{3,$1,攻撃兵:03}
				{4,$1,いけす攻撃兵:04}
				{5,$1,いけす攻撃兵:05}
				{6,$1,いけす攻撃兵:06}
			} \
			-exec{ \
				command ゲット敵兵状態 $3 $i:敵兵状態
				if($1 <= $2){
					eval($i:ローカル変数Ｉ１ = ($i:ローカル変数Ｉ１ | $i:敵兵状態))
				}
			}

/*
		($i:敵兵状態 & 0x80106004) == 0

		0x00000004	//倒れ状態
		0x00002000	//捕まえられている
		0x00004000	//気絶中
		0x00100000	//起き上がり中
		0x80000000	//死亡

		のどれでもない。
*/
		if(($i:ローカル変数Ｉ１ & 0x00106004) != 0){
			print 'clear cancel!!!!!'
			print 'あらまほしけれ！！！だれか元気じゃないなーー！！！！！'
			command クリアリングキャンセル
		}else{
			print 'you all are healthy!!!!!!!!!!!!'
			print 'みいんなええ子や！！！！'
		}

	}






