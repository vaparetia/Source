// マップ設定
// ------------------------------------

//人質イベント後は網膜センサーが壊れモデルになる
if($w:p_story >= d:ST:P040_09_P05エイムズ発見９ポリゴンデモ５終了){
	eval($s:w24b_網膜センサーモデル名 = w24b0_ms01)
}else{
	eval($s:w24b_網膜センサーモデル名 = w24b0_ms00)
}

chara マップ シェル１中央棟Ｂ１ -k d:KMS_NAME0 -k $s:w24b_網膜センサーモデル名 -h d:HZX_NAME,0 -l d:LT2_NAME
chara マップ ノード部屋 -k d:KMS_NAME1 -h d:HZX_NAME,1 -l d:LT2_NAME
chara マップ リフレッシュルーム -k d:KMS_NAME2 -h d:HZX_NAME,2 -l d:LT2_NAME

chara マップ接合 西側マップ接合 シェル１中央棟Ｂ１ リフレッシュルーム
chara マップ接合 東側マップ接合 シェル１中央棟Ｂ１ ノード部屋




command マップ設定 シェル１中央棟Ｂ１ ノード部屋 リフレッシュルーム -set {

#if d:SOUND
	@サウンド設定	// データは最初に呼ぶ
#endif
#if d:NODE
	@ノード端末設定 1024
	@レーダーオンオフチェック $f:w24b_ノードフラグ		//常駐キャラより先に呼ぶ
#endif
	@常駐キャラ設定
	@ローカル変数初期化
	@設定値変更
	@プレイヤー設定
#if d:ENEMY
	@コマンダー設定
#endif
#if d:SV_CAMERA
	@監視カメラ設定
#endif
#if d:BGM
	@ＢＧＭ設定	// プレイヤー→敵兵→BGMの順で呼ぶ
#endif
#if d:ITEM
	@アイテム設置
#endif
#if d:LOAD_TRAP
	@ロード設定
#endif
#if d:FOG
	@フォグ設定
#endif
#if d:EFFECT
	@エフェクト設定
#endif
	@カメラセット
	@子画面設定
#if d:CHARA_CEIL
	@シェル１中央棟Ｂ１天井設置
#endif


#if d:LOCKER
	@ロッカー設置
#endif









}



command マップ設定 シェル１中央棟Ｂ１ -set {
#if d:ELEVATOR_SET
	@エレベーター設置 シェル１中央棟Ｂ１	// stdproc.hで定義
#endif
	@ロード部屋設置
	@廊下カメラ設定

#if d:RETINAL_SENCOR
	if($w:p_story >= d:ST:P040_09_P05エイムズ発見９ポリゴンデモ５終了){
		@網膜センサー電撃
	}else{
		@網膜センサーロード設定
		@網膜センサーデモ設定
	}
#endif

	@主観禁止壁 主観禁止壁君 -1325 -4500 -67000 3072 d:SD_SLIDE_INSIDE		//stdproc.h




}

command マップ設定 シェル１中央棟Ｂ１ ノード部屋 -set {
#if d:SLIDE_DOOR
	@ドア設置
#endif
#if d:INTRUDE_KANAAMI
	@イントルード金網設定
#endif
}


command マップ設定 ノード部屋 -set {
	@ノード部屋カメラ設定
}

command マップ設定 リフレッシュルーム -set {
#if d:GRASS
	@リフレッシュ草設置
#endif
	@リフレッシュルームカメラ設定
#if d:FRAGILE
	@壊れ雑誌
	//@壊れ物設定
#endif
}


command マップ設定 シェル１中央棟Ｂ１ ノード部屋 リフレッシュルーム -set {
	@西側マップ接合管理
#if d:CHARA_LIGHT
	@キャラ用ライト設置		// マップ設定の最後に呼ぶ
#endif
#if d:DEBUG_CHARA
	@デバッグキャラセット
#endif
#if d:MIRROR
	@鏡面モデル設定
#endif

	@プラント編全体マップ設定 d:シェル１中央棟マップ	// stdproc.hで定義
	//@ポーズ時ステージ名表示設定 d:wn_シェル１中央棟Ｂ１

}








// 無線用include ※位置は動かさないこと
#include "w24b_cdc.ch"
#include "p_force_cdc.ch"




//初期マップの表示
command マップ表示 -show シェル１中央棟Ｂ１

// 全てのセットが終わったところでフェードイン
if( $s:登場ポイント == sp_w24a_w24b_0 ){
	// １Ｆから
	// 全てのセットが終わったところでフェードイン

	@ステージ開始時処理（エレベーター） d:wn_シェル１中央棟Ｂ１

} else if( $s:登場ポイント == sp_w24c_w24b_0 ){
	// 人質部屋から


	if($w:p_story > d:ST:P041_02_R01エイムズ死亡後２無線デモ１終了){
		// 全てのセットが終わったところでフェードイン
		mesg プットオブジェ 網膜センサーランプ青 off
		mesg プットオブジェ 網膜センサーランプ赤 on
		@ロード時フェードイン

	}else if($w:p_story >= d:ST:P040_09_P05エイムズ発見９ポリゴンデモ５終了){

		@シナリオデモ開始処理

		mesg プットオブジェ 網膜センサーランプ赤 off
		mesg プットオブジェ 網膜センサーランプ青 on

		chara delay ディレイ -time 90 -exec{
			mesg プットオブジェ 網膜センサーランプ青 off
			mesg プットオブジェ 網膜センサーランプ赤 on

			@警報デモステップ１

		}


		// 全てのセットが終わったところでフェードイン
		@ステージ開始時処理（ステージ名表示）\
			 d:LOAD_TYPE:SL_DOOR_TYPE 人質部屋ドア 2000 d:DEFAULT_M_TYPE \
			 d:wn_シェル１中央棟Ｂ１


	}else{	//人質イベント前に人質部屋から戻ってきたとき。

		mesg プットオブジェ 網膜センサーランプ赤 off
		mesg プットオブジェ 網膜センサーランプ青 on

		chara delay ディレイ -time 90 -exec{
			mesg プットオブジェ 網膜センサーランプ青 off
			mesg プットオブジェ 網膜センサーランプ赤 on
		}

		// 全てのセットが終わったところでフェードイン
		@ステージ開始時処理（ステージ名表示）\
			 d:LOAD_TYPE:SL_DOOR_TYPE 人質部屋ドア 2000 d:DEFAULT_M_TYPE \
			 d:wn_シェル１中央棟Ｂ１

	}



} else if( $s:登場ポイント == sp_w24d_w24b_0 ){
	// Ｂ３から
	// 全てのセットが終わったところでフェードイン
	@ステージ開始時処理（エレベーター） d:wn_シェル１中央棟Ｂ１


}else if($s:登場ポイント == 網膜センサーデモ後リスタート){
	// 全てのセットが終わったところでフェードイン
	@ロード時フェードイン

}


proc スタートカメラセット {
	#if d:DEBUG_PRINT
	print 'start_camera_set'
	#endif

}


proc スタートカメラオフ {
	#if d:DEBUG_PRINT
	print 'start_camera_off'
	#endif

	if($w:p_story >= d:ST:P040_09_P05エイムズ発見９ポリゴンデモ５終了 && $w:p_story < d:ST:P041_02_R01エイムズ死亡後２無線デモ１開始){
		command パッド操作 -release
	}

}






// 各proc設定
//-------------------------------------------------------------------------------------
// 全マップ共通

	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT
			print 'localvar_init'
		#endif


		eval( $f:w24b_西側マップ接合禁止 = 0 );
		eval($f:w24bリフレッシュクリアリング中 = 0)

		if($w:p_story >= d:ST:P040_09_P05エイムズ発見９ポリゴンデモ５終了 && $w:p_story < d:ST:P041_02_R01エイムズ死亡後２無線デモ１開始){
			eval($w:アイテム数Ｒ[d:アイテム:カード] = 3);
			eval( $w:アイテム = d:アイテム:ゴル兵制服 )
		}

	}

	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT
			print 'status_set'
		#endif
	}

	// ポリデモ
	// ------------------------------------
	// ノード端末
	// ------------------------------------


















//###################################################################################
//								プレイヤー設定
//###################################################################################

	proc プレイヤー設定 {
		#if d:DEBUG_PRINT
			print 'player_set'
		#endif

		#if d:RAIDEN
			if($w:p_story < d:ST:P040_09_P05エイムズ発見９ポリゴンデモ５終了){
				print 'ゴルキャップあり'
				command ゴルキャップあり
			}else{
				print 'ゴルキャップなし'
				command ゴルキャップなし
			}



			chara プレイヤー d:PLAYER \
				-p $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,$i:プレイヤー初期Ｚ位置 \
				-d 0,$i:プレイヤー初期方向,0 \
				-s 0 \
				-m rai_def -a raiden -o rai_w24b \
				-i 0

			@ライデン髪の毛設定 d:NORMAL_HAIR


			//網膜センサーデモのときはハイポリのまま
			if($w:p_story < d:ST:P038_01_S01網膜チェック１シナリオデモ１開始){
				@プレイヤーＬＯＤ設定 d:C_DISTANCE_TYPE 10000
			}else{
				@プレイヤーＬＯＤ設定 d:C_DISTANCE_TYPE 6000
				//@プレイヤーＬＯＤ設定 d:P_STATE_TYPE d:TRP_STATE_BEHIND
			}



		#endif
	}
















//###################################################################################
//									敵兵設定
//###################################################################################

#define	アタッカー東待機			0
#define	アタッカー西待機			10
#define	通常巡回					4
#define	通常巡回ＨＡＲＤ			23
#define	西側巡回					3
#define	リフレッシュ南待機			5
#define	リフレッシュ自販機前待機	6
#define	リフレッシュ椅子前待機		7
#define	アタッカー警戒北廊下巡回	13
#define	警戒デモ用東待機			14
#define	警戒南廊下右向き待機		15
#define	警戒南廊下左向き待機		16
#define	ノード部屋居眠り			22

#define	攻撃兵警戒１				17
#define	攻撃兵警戒２				18
#define	攻撃兵警戒３				19
#define	攻撃兵警戒４				20
#define	攻撃兵警戒５				21



	proc 警備兵０ {
		#if d:DEBUG_PRINT
			print 'guard_set'
		#endif


	}









	proc サポート兵 {
		#if d:DEBUG_PRINT
			print 'support_set'
		#endif

//		chara サポート兵 敵兵:31 -r 0 -s 1 -b 敵兵:02
//		chara サポート兵 敵兵:32 -r 0 -s 1 -b 敵兵:03
	}






	proc 攻撃兵０ {
		#if d:DEBUG_PRINT
			print 'attacker_set'
		#endif

		if($w:ゲーム設定 <= d:LEVEL_NORMAL){
			eval($w:w24b_敵兵気絶 = $w:敵標準気絶 * 2)
		}else{
			eval($w:w24b_敵兵気絶 = $w:敵標準気絶)
		}

		if($w:p_story < d:ST:P040_09_P05エイムズ発見９ポリゴンデモ５終了){

			chara アタッカー 攻撃兵:01 -r d:リフレッシュ南待機 \
				-s d:ENE_STATUS_CONVERT \
				-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
				-l $w:敵標準体力 -h $w:敵標準聴力 -f $w:w24b_敵兵気絶 \
				-j ドッグタグ_敵兵 [dogtag:plt_w24b_guard_ve_01] \
					[dogtag:plt_w24b_guard_ea_01] [dogtag:plt_w24b_guard_no_01] \
					[dogtag:plt_w24b_guard_ha_01] [dogtag:plt_w24b_guard_vh_01] \
				-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
				-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
				-e d:ENE_EQUIP_TYPE_NORMAL

			chara アタッカー 攻撃兵:02 -r d:リフレッシュ自販機前待機 \
				-s d:ENE_STATUS_CONVERT \
				-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
				-l $w:敵標準体力 -h $w:敵標準聴力 -f $w:w24b_敵兵気絶 \
				-j ドッグタグ_敵兵 [dogtag:plt_w24b_guard_ve_02] \
					[dogtag:plt_w24b_guard_ea_02] [dogtag:plt_w24b_guard_no_02] \
					[dogtag:plt_w24b_guard_ha_02] [dogtag:plt_w24b_guard_vh_02] \
				-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
				-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
				-e d:ENE_EQUIP_TYPE_NORMAL

			chara アタッカー 攻撃兵:03 -r d:リフレッシュ椅子前待機 \
				-s d:ENE_STATUS_CONVERT \
				-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
				-l $w:敵標準体力 -h $w:敵標準聴力 -f $w:w24b_敵兵気絶 \
				-j ドッグタグ_敵兵 [dogtag:plt_w24b_guard_ve_03] \
					[dogtag:plt_w24b_guard_ea_03] [dogtag:plt_w24b_guard_no_03] \
					[dogtag:plt_w24b_guard_ha_03] [dogtag:plt_w24b_guard_vh_03] \
				-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
				-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
				-e d:ENE_EQUIP_TYPE_NORMAL



		}else if($w:p_story < d:ST:P041_02_R01エイムズ死亡後２無線デモ１終了){

			print '人質イベント後デモ用攻撃兵'

			chara アタッカー 攻撃兵:01 -r d:警戒デモ用東待機 \
				-s d:ENE_STATUS_CONVERT \
				-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
				-l $w:敵標準体力 -h $w:敵標準聴力 -f $w:w24b_敵兵気絶 \
				-j ドッグタグ_敵兵 [dogtag:plt_w24b_guard_ve_01] \
					[dogtag:plt_w24b_guard_ea_01] [dogtag:plt_w24b_guard_no_01] \
					[dogtag:plt_w24b_guard_ha_01] [dogtag:plt_w24b_guard_vh_01] \
				-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
				-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
				-e d:ENE_EQUIP_TYPE_NORMAL

			chara アタッカー 攻撃兵:02 -r d:リフレッシュ自販機前待機 \
				-s d:ENE_STATUS_CONVERT \
				-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
				-l $w:敵標準体力 -h $w:敵標準聴力 -f $w:w24b_敵兵気絶 \
				-j ドッグタグ_敵兵 [dogtag:plt_w24b_guard_ve_02] \
					[dogtag:plt_w24b_guard_ea_02] [dogtag:plt_w24b_guard_no_02] \
					[dogtag:plt_w24b_guard_ha_02] [dogtag:plt_w24b_guard_vh_02] \
				-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
				-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
				-e d:ENE_EQUIP_TYPE_NORMAL

			chara アタッカー 攻撃兵:03 -r d:リフレッシュ南待機 \
				-s d:ENE_STATUS_CONVERT \
				-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
				-l $w:敵標準体力 -h $w:敵標準聴力 -f $w:w24b_敵兵気絶 \
				-j ドッグタグ_敵兵 [dogtag:plt_w24b_guard_ve_03] \
					[dogtag:plt_w24b_guard_ea_03] [dogtag:plt_w24b_guard_no_03] \
					[dogtag:plt_w24b_guard_ha_03] [dogtag:plt_w24b_guard_vh_03] \
				-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
				-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
				-e d:ENE_EQUIP_TYPE_NORMAL


		}else{

			print '人質イベント後攻撃兵'

			if($s:登場ポイント == 人質イベント後無線後){
				chara アタッカー 攻撃兵:01 -r d:アタッカー警戒北廊下巡回 \
					-s d:ENE_STATUS_CONVERT \
					-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
					-l $w:敵標準体力 -h $w:敵標準聴力 -f $w:w24b_敵兵気絶 \
					-j ドッグタグ_敵兵 [dogtag:plt_w24b_guard_ve_01] \
						[dogtag:plt_w24b_guard_ea_01] [dogtag:plt_w24b_guard_no_01] \
						[dogtag:plt_w24b_guard_ha_01] [dogtag:plt_w24b_guard_vh_01] \
					-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
					-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
					-e d:ENE_EQUIP_TYPE_NORMAL

			}else{	//エレベータからきたときは居眠り
				chara アタッカー 攻撃兵:01 -r d:ノード部屋居眠り \
					-s d:ENE_STATUS_CONVERT \
					-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
					-l $w:敵標準体力 -h $w:敵標準聴力 -f $w:w24b_敵兵気絶 \
					-j ドッグタグ_敵兵 [dogtag:plt_w24b_guard_ve_01] \
						[dogtag:plt_w24b_guard_ea_01] [dogtag:plt_w24b_guard_no_01] \
						[dogtag:plt_w24b_guard_ha_01] [dogtag:plt_w24b_guard_vh_01] \
					-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
					-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
					-e d:ENE_EQUIP_TYPE_NORMAL

			}

			chara アタッカー 攻撃兵:02 -r d:西側巡回 \
				-s d:ENE_STATUS_CONVERT \
				-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
				-l $w:敵標準体力 -h $w:敵標準聴力 -f $w:w24b_敵兵気絶 \
				-j ドッグタグ_敵兵 [dogtag:plt_w24b_guard_ve_02] \
					[dogtag:plt_w24b_guard_ea_02] [dogtag:plt_w24b_guard_no_02] \
					[dogtag:plt_w24b_guard_ha_02] [dogtag:plt_w24b_guard_vh_02] \
				-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
				-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
				-e d:ENE_EQUIP_TYPE_NORMAL

			chara アタッカー 攻撃兵:03 -r d:リフレッシュ南待機 \
				-s d:ENE_STATUS_CONVERT \
				-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
				-l $w:敵標準体力 -h $w:敵標準聴力 -f $w:w24b_敵兵気絶 \
				-j ドッグタグ_敵兵 [dogtag:plt_w24b_guard_ve_03] \
					[dogtag:plt_w24b_guard_ea_03] [dogtag:plt_w24b_guard_no_03] \
					[dogtag:plt_w24b_guard_ha_03] [dogtag:plt_w24b_guard_vh_03] \
				-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
				-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
				-e d:ENE_EQUIP_TYPE_NORMAL



		}

		if($w:p_story < d:ST:P040_09_P05エイムズ発見９ポリゴンデモ５終了){
			command foreach -argc 3 -repeat 5 \
				-data { \
					{0,いけす攻撃兵:04,d:攻撃兵警戒１}
					{1,いけす攻撃兵:05,d:攻撃兵警戒２}
					{2,いけす攻撃兵:06,d:攻撃兵警戒３}
					{3,いけす攻撃兵:07,d:攻撃兵警戒４}
					{4,いけす攻撃兵:08,d:攻撃兵警戒５}
				} \
				-exec{ \
					if(($w:ゲーム設定 >= d:LEVEL_NORMAL && $1 <= 1) || $w:ゲーム設定 >= d:LEVEL_HARD){
						chara アタッカー $2 -r d:アタッカー西待機 -c $3 \
							-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
							-l $w:敵標準体力 -h $w:敵標準聴力 -f $w:w24b_敵兵気絶
					}
				}
		}
	}


	proc 警備兵コマンダー {
		#if d:DEBUG_PRINT
			print 'wccomm_set'
		#endif

		#if d:SUPPORT
			chara 警備コマンダー wccomm -e {警備兵０ サポート兵}
		#else
			chara 警備コマンダー wccomm -e {警備兵０}
		#endif
	}

	proc 攻撃兵コマンダー {
		#if d:DEBUG_PRINT
			print 'atcomm_set'
		#endif

		chara 攻撃コマンダー atcomm -e 攻撃兵０ \
			-avoidwait 600	//回避モードで始まる場合のみ有効*

	}








#if 1
	resource ghq_area_alert_voice {
