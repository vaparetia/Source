	resource ghq_caution_voice {
	w24b:
		$t{
			// PLAREA0 リフレッシュルーム
			t:vc040397,	//指揮官「了解。シェル１中央棟Ｂ１に増員を送る。リフレッシュルームの警戒を強化しろ」
			t:vc040398,	//指揮官「了解。シェル１中央棟Ｂ１、リフレッシュルームを増員する。警備を強化せよ」
			// PLAREA1 網膜センサー
			t:vc040399,	//指揮官「了解。シェル１中央棟Ｂ１、網膜センサー付近に増員を送る。警戒を強化せよ」
			t:vc040400,	//指揮官「了解。シェル１中央棟Ｂ１を増員する。網膜センサー付近を警戒強化せよ」
			t:vc040401,	//指揮官「了解。シェル１中央棟Ｂ１を増員する。ホール集会場への入口を固めろ」
			t:vc040402,	//指揮官「了解。シェル１中央棟Ｂ１、ホール集会場への入口付近に増員を送る。警戒を強化せよ」
			t:vc040403,	//指揮官「了解。シェル１中央棟Ｂ１を増員する。警戒を強化せよ」
			t:vc040404,	//指揮官「了解。シェル１中央棟Ｂ１に増員を送る。警備を強化せよ」
			-2,
			t:vc040433,	// 指揮官　　「シェル１中央棟Ｂ１との連絡が途絶えた」
			-1 // PLAREA0の登録終了
		}
	}





	proc コマンダー設定 {
		#if d:DEBUG_PRINT
			print 'commander_set'
		#endif



		if($w:p_story < d:ST:P038_01_S01網膜チェック１シナリオデモ１開始 &&  $s:登場ポイント != sp_w24c_w24b_0 ){

		}else{

			if($s:登場ポイント == 網膜センサーデモ後リスタート){
				eval($w:スタートアラートモード = d:ALERT_MODE_SENNYU)
			}

			if($w:p_story < d:ST:P040_09_P05エイムズ発見９ポリゴンデモ５終了){
				print '人質イベント前コマンダー'
				command 敵兵メモリーオールリセット

			}else{
				if($s:登場ポイント == sp_w24c_w24b_0){
					eval($w:スタートアラートモード = d:ALERT_MODE_TANSAKU)
					eval($i:ステージ種別 = ($i:ステージ種別 | d:ENE_STAGE_SEARCH_MAX))
				}
			}

			if($w:ゲーム設定 <= d:LEVEL_NORMAL){
				eval($i:通常巡回ルート番号 = d:通常巡回)
			}else{
				eval($i:通常巡回ルート番号 = d:通常巡回ＨＡＲＤ)
			}

			chara コマンダー 敵兵セット \
//				-w 警備兵コマンダー \		//	いないので必要なし
				-a 攻撃兵コマンダー \
				-m $w:スタートアラートモード \
				-r 4750,-4500,-72750 ノード部屋 -10500,-4500,-70750 リフレッシュルーム \
				-c 4750,-4500,-72750 ノード部屋 -10500,-4500,-70750 リフレッシュルーム \
				-e	d:通常巡回 22 敵兵巡回交代プロック \
					d:通常巡回ＨＡＲＤ 16 敵兵巡回交代プロック \
				-f	d:通常巡回 22 t:vc041034 t:vc041034_len \		//敵兵Ｂ「異状なし」
					d:通常巡回ＨＡＲＤ 16 t:vc041034 t:vc041034_len \		//敵兵Ｂ「異状なし」
				//-j 1 7 4 t:vc045007 t:vc045007_len \				//敵兵Ｂ「警備を続けるぞ」ロッカークリアリングキャンセル
				-s $i:ステージ種別 \
				-v [ene_plant_voice:01] \
				-x [ghq_area_alert_voice:w24b] \
				-y [ghq_caution_voice:w24b] \
				-z $i:敵標準麻酔持続 \
				-o $i:敵標準気絶持続 \
				-b $w:敵標準再発生数 \
				-h $i:標準警戒時間 \
				-p 	-1,-1,-1,警戒ルート移行プロック \
					0,-1,-1,リフレッシュルームクリアリング初期設定 \
					1,-1,-1,ノード部屋クリアリング初期設定 \
					2,-1,-1,おもしろクリアリング初期設定 \
					-2,-2,-2,クリアリングカメラＯＦＦ


			if($w:ゲーム設定 <= d:LEVEL_NORMAL || $w:p_story >= d:ST:P040_09_P05エイムズ発見９ポリゴンデモ５終了){
				print '人質イベント後おもしろクリアリング禁止'
				mesg コマンダー 敵兵セット クリアリングエリアスキップオン 2
			}

			//if($w:ゲーム設定 <= d:LEVEL_EASY){
				mesg コマンダー 敵兵セット クリアリング敵兵チェックスキップオン 0	//敵兵がいてもクリアリングに突入
				mesg コマンダー 敵兵セット クリアリング敵兵チェックスキップオン 1	//敵兵がいてもクリアリングに突入
			//}

		}







//待機所変更
		if($i:プレイヤー初期Ｚ位置 > -69000){
			print '待機所変更０'
			mesg コマンダー 敵兵セット 待機所替え 0
			mesg アタッカー いけす攻撃兵 ルート変更 d:アタッカー東待機

		}else{
			print '待機所変更１'
			mesg コマンダー 敵兵セット 待機所替え 1
			mesg アタッカー いけす攻撃兵 ルート変更 d:アタッカー西待機

		}



		trap en001 d:PLAYER \
			-mask 出る \
			-exec {

				if($6 > -69000){
					print '待機所変更０'
					mesg コマンダー 敵兵セット 待機所替え 0
					mesg アタッカー いけす攻撃兵 ルート変更 d:アタッカー東待機
				}else{
					print '待機所変更１'
					mesg コマンダー 敵兵セット 待機所替え 1
					mesg アタッカー いけす攻撃兵 ルート変更 d:アタッカー西待機
				}

			}




// 敵兵ルートチェンジ
		if($w:p_story < d:ST:P040_09_P05エイムズ発見９ポリゴンデモ５終了){

			if($w:p_story >= d:ST:P038_01_S01網膜チェック１シナリオデモ１終了){
				mesg アタッカー 攻撃兵:01 ルート変更 $i:通常巡回ルート番号
				eval($b:シェル１Ｂ１巡回中敵兵 = 0)
			}

		}


		if($w:スタートアラートモード == d:ALERT_MODE_SENNYU){
			eval($f:警戒モード中 = 0)
		}else{
			eval($f:警戒モード中 = 1)
		}

		chara delay 警戒モードチェックディレイ -time 1 -exec{

			if($w:アラートモード == d:ALERT_MODE_TANSAKU && !$f:警戒モード中){
				print '警戒モードに移行！！！'
				eval($f:警戒モード中 = 1)
				mesg アタッカー 攻撃兵:01 ルート変更 d:アタッカー警戒北廊下巡回
				mesg アタッカー 攻撃兵:02 ルート変更 d:警戒南廊下右向き待機
				mesg アタッカー 攻撃兵:03 ルート変更 d:警戒南廊下左向き待機

			}else if($w:アラートモード == d:ALERT_MODE_SENNYU && $f:警戒モード中){
				print '潜入モードに移行！！！'
				eval($f:警戒モード中 = 0)

				if($w:p_story < d:ST:P040_09_P05エイムズ発見９ポリゴンデモ５終了){
					if($b:シェル１Ｂ１巡回中敵兵 == 0){
						mesg アタッカー 攻撃兵:01 ルート変更 $i:通常巡回ルート番号
						mesg アタッカー 攻撃兵:02 ルート変更 d:リフレッシュ自販機前待機
						mesg アタッカー 攻撃兵:03 ルート変更 d:リフレッシュ椅子前待機
					}else if($b:シェル１Ｂ１巡回中敵兵 == 1){
						mesg アタッカー 攻撃兵:01 ルート変更 d:リフレッシュ南待機
						mesg アタッカー 攻撃兵:02 ルート変更 $i:通常巡回ルート番号
						mesg アタッカー 攻撃兵:03 ルート変更 d:リフレッシュ椅子前待機
					}else{
						mesg アタッカー 攻撃兵:01 ルート変更 d:リフレッシュ南待機
						mesg アタッカー 攻撃兵:02 ルート変更 d:リフレッシュ自販機前待機
						mesg アタッカー 攻撃兵:03 ルート変更 $i:通常巡回ルート番号
					}

				}else{
					mesg アタッカー 攻撃兵:01 ルート変更 d:ノード部屋居眠り
					mesg アタッカー 攻撃兵:02 ルート変更 d:リフレッシュ自販機前待機
					mesg アタッカー 攻撃兵:03 ルート変更 d:リフレッシュ椅子前待機

				}

			}

			return -1

		}












	//強襲クリアリング用
		trap ca005 d:PLAYER \
			-mask 出る \
			-exec {
				eval($f:w24bリフレッシュクリアリング中 = 0)
			}






	}





#define 敵兵チェンジディレイタイム 360


	//こいつはコマンダーから呼び出されている
	proc 敵兵巡回交代プロック {

		if($b:シェル１Ｂ１巡回中敵兵 == 0){
			mesg アタッカー 攻撃兵:01 ルート変更 5

			chara delay 敵兵ルートチェンジディレイ -time d:敵兵チェンジディレイタイム -exec{
				mesg アタッカー 攻撃兵:02 ルート変更 $i:通常巡回ルート番号
				eval($b:シェル１Ｂ１巡回中敵兵 = 1)
			}
		}else if($b:シェル１Ｂ１巡回中敵兵 == 1){
			mesg アタッカー 攻撃兵:02 ルート変更 6

			chara delay 敵兵ルートチェンジディレイ -time d:敵兵チェンジディレイタイム -exec{
				mesg アタッカー 攻撃兵:03 ルート変更 $i:通常巡回ルート番号
				eval($b:シェル１Ｂ１巡回中敵兵 = 2)
			}
		}else if($b:シェル１Ｂ１巡回中敵兵 == 2){
			mesg アタッカー 攻撃兵:03 ルート変更 7

			chara delay 敵兵ルートチェンジディレイ -time d:敵兵チェンジディレイタイム -exec{
				mesg アタッカー 攻撃兵:01 ルート変更 $i:通常巡回ルート番号
				eval($b:シェル１Ｂ１巡回中敵兵 = 0)
			}
		}
	}




	proc 警戒ルート移行プロック {
		print '警戒ルート移行するよ！！！！！！'
		eval($f:警戒モード中 = 1)
		mesg アタッカー 攻撃兵:01 ルート変更 d:アタッカー警戒北廊下巡回
		mesg アタッカー 攻撃兵:02 ルート変更 d:警戒南廊下右向き待機
		mesg アタッカー 攻撃兵:03 ルート変更 d:警戒南廊下左向き待機
	}



