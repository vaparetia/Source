		eval($w:補完画角 = 75)

		chara delay クリアリング通路ディレイ -time 1 -exec{

			if($w:補完画角 < 377 && $w:アラートモード == d:ALERT_MODE_KAIHI){
				eval($w:補完画角 = $w:補完画角 + 1)

