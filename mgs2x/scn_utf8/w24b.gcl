	proc おもしろクリアリング初期設定 {
		print 'おもしろクリアリングスタート！！！'


		command セットクリアリング \
			-p	2,-1,-1 おもしろみんな元気かチェック \
				2,0,0 おもしろクリアリングスタートカメラ \
				2,3,1 おもしろ入口集合 \
				2,4,2 おもしろ縦廊下 \
				2,3,6 おもしろセンサー前 \
				2,4,6 おもしろキャンセルチェック１ \
				2,3,8 おもしろ全員集合 \
				2,0,6 おもしろロッカー前 \
				2,5,18 おもしろ最終突入前 \
				2,5,19 おもしろキャンセルチェック２ \
				2,5,22 おもしろ追い込み \
				2,4,22 アタッカー４クリア \
				2,6,28 アタッカー６クリア \
				2,7,25 アタッカー７クリア \
				2,5,26 アタッカー５クリア \
				2,2,21 アタッカー２クリア \
				2,1,19 アタッカー１クリア \
				2,0,18 アタッカー０振り返り \
				2,0,20 アタッカー０クリア \
			-i	0,1,2,3,4,5,6,7

	}

	proc おもしろみんな元気かチェック {
		@みんな元気かチェック 6
	}





