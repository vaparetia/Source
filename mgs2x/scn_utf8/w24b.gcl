			-map リフレッシュルーム


		chara delay クリアリング横歩きディレイ -time 1 -exec{

			command ゲット敵兵座標 攻撃兵:01 $i:敵兵Ｘ $i:敵兵Ｙ $i:敵兵Ｚ

			chara カメラ設定 クリアリングカメラ \
				-c 1 \
				-p $i:敵兵Ｘ,-2434,-65999 \
				-t $i:敵兵Ｘ,-4725,-72000 \
				-a 141 \
				-i 0 -1 0 0 \
				-s 1

			if($w:アラートモード == d:ALERT_MODE_KAIHI){
				return 1
			}else{
				return 0
			}

		}


		#if d:SUB_CAMERA
			mesg サブ画面 子画面 on
		#endif

	#endif
	}




