	proc リフレッシュルームクリアリング初期設定 {

		print 'リフレッシュルームクリアリングスタート！！！'

		@みんな元気かチェック 3

		if(!$f:w24bリフレッシュクリアリング中){
			eval($f:w24bリフレッシュクリアリング中 = 1)

			command セットクリアリング \
				-p	0,0,0	クリアリングカメラ１リフレッシュ入口１ \
					0,0,1	クリアリングカメラ１リフレッシュ入口２ \
					0,1,2	クリアリングカメラ１ロッカー前 \
					0,0,8	クリアリングカメラ１横歩き \
					0,0,11	クリアリングカメラ１通路 \
					0,1,12	クリアリングカメラ１自販機そば \
				-i	0,1,11,2,12,13,14,15

		}else{	//強襲クリアリング

			//奥側
			if($i:プレイヤー位置Ｚ < -69500){
				command セットクリアリング \
					-p	0,0,0	クリアリングカメラ１通路 \
						0,9,3	クリアリングカメラ１自販機そば \
					-i	9,10,11,2,12,13,14,15

			//入口側
			}else{
				command セットクリアリング \
					-p	0,0,0	クリアリングカメラ１リフレッシュ入口１ \
						0,5,1	クリアリングカメラ１リフレッシュ入口２ \
						0,5,7	クリアリングカメラ１突入通路 \
						0,6,8	クリアリングカメラ１突入自販機そば \
					-i	5,6,11,2,12,13,14,15

			}

		}




	}









