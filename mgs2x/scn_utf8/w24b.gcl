// 各種スイッチ用define
// ------------------------------------
#define		STAGE_PLANT		1
#define		STAGE_W24B		1							//通信機・デジカメ用

// サウンド
#define		SOUND			1		// サウンドデータは最初に呼ぶ
#define		BGM				1		// BGMは敵兵コマンダーの後に呼ぶ
// デモ
#define		DEMO			0
// ノード端末
// キャラクター関係
#define		RAIDEN			1		// SNAKEとは排他
#define		SNAKE			0
#define		ENEMY			1		// コマンダーと警備兵(敵を出すときは必須)
#define		SUPPORT			0		// サポート兵
#define		ATTACKER		1		// 攻撃兵
#define		SHIELD			0		// 盾兵(1) or 通常攻撃兵(0)


// 監視カメラ関係
#define		SV_CAMERA		0		// 監視カメラ
// ドア
#define		WT_DOOR			0		// 水密ドア
#define		SLIDE_DOOR		1		// スライドドア
// 入出トラップ
#define		LOAD_TRAP		1
#define		STAGE_END		1		// ステージ終了時処理を使用可にする
#define		RETINAL_SENCOR	1

#define		START_CAMERA	1		// ステージ開始時のカメラ


// フォグ
#define		FOG				1
// エフェクト関係
#define		EFFECT			1		// エフェクト全般
#define		BLUR			0		// ブラー
#define		Z_MANAGER		0		// Ｚフォーカス管理(敵のライト等で仕様)
#define		BODY_SHADOW		0		// 敵のライトによって出る影
#define		DEFORCUS		1		// ぼかし

// 子画面
#define		SUB_CAMERA		1
// カメラ関係
#define		CLEAR_CAMERA	1		// クリアリング専用カメラ(要子画面)


// 天井
#define		CHARA_CEIL		1		// 天井君

// エレベーター
#define		SHELL			0		//シェル１
#define		ELEVATOR_SET	1		//エレベーター設置を有効にするのに必要
#define		ELEVATOR_Y		-4500	//エレベーターをＹ軸にいくつずらすか(１Ｆは0 シェル１Ｂ１は-4000 シェル２Ｂ１は-4500 Ｂ２は-12000 )
#define		ELEVATOR_Z		0		//エレベーターをＺ軸にいくつずらすか(シェル１は0 シェル２は-180000)
#define		ELV_B1			1





// ノード端末
#define		NODE			1
// ライト関係
#define		SPOT_LIGHT		0		// スポットライト
#define		CHARA_LIGHT		1		// キャラ専用ライト
// オブジェ関係
#define		LOCKER			1		// ロッカー
#define		NODE			1
// アイテム
#define		ITEM			1
// 鏡面モデル
#define		MIRROR			1
// 草設定
#define		GRASS			1
//壊れ物
#define		FRAGILE			1

#define		INTRUDE_KANAAMI	1

// デバッグ関係
#ifdef	d:FIX_MODE
	#define		DEBUG_CHARA		0		// デバッグキャラ全体(FIX時は0)
#else
	#define		DEBUG_CHARA		1		// デバッグキャラ全体
#endif
#define		CHARA_CAMERA	0		// キャラ追従カメラ
#define		TARGET_CHARA	敵兵:01	// キャラ追従カメラのターゲット
#define		SCREENSHOT		0		// スクリーンショット
#define		USB_KEY			0		// USBキーボード
#define		おもしろクリアリング	1
#define		MOTION_RECORDER			0

// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME			w24b
#define		KMS_NAME0			w24b0	//廊下
#define		KMS_NAME1			w24b1	//倉庫
#define		KMS_NAME2			w24b2	//リフレッシュルーム
#define		CEIL_NAME0			w24b0r	//廊下天井
#define		CEIL_NAME1			w24b1r	//倉庫天井
#define		CEIL_NAME2			w24b2r	//リフレッシュルーム天井
//#define		DOOR_NAME			w24b_dr01
//#define		DOOR_NAME_LOAD		w24b_dr02		// ロード用
#define		DOOR_NAME			dr_free				//	共通
#define		DOOR_NAME_LOAD		dr_free				//	共通

#define		LT2_NAME			w24b



// キャラクター関係
#if d:RAIDEN
	#define		PLAYER		ライデン	// モーションができるまで名前はスネーク
#else
	#define		PLAYER		スネーク
#endif

// ローカル変数








// モーションリスト関係

enum センサーモーションリスト {
	gbs_walk = 0,
	gbs_sensor_ok,
	gbs_idle,
	gbs_forced
}





// include
