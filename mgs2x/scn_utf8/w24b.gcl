					-t -5417,-4054,-68059 \
					-a $w:補完画角 \
					-i 0 -1 0 0 \
					-s 1

				return 1

			}else{
				return 0
			}


		}


		#if d:SUB_CAMERA
			mesg サブ画面 子画面 on
		#endif

	#endif
	}






