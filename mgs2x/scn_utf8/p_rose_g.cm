//ＳＡＶＥ失敗 d //e
//メモリーカードがない h //e
resource PR_ＳＡＶＥ失敗＿メモリーカードない__g {
//vox t:vc250331 {
ローズ_000: {
Jack, es ist keine MEMORY CARD (PS2) 
im MEMORY CARD-Steckplatz.
}
/*ジャック、ＭＥＭＯＲＹ ＣＡＲＤ
差込口に“PlayStation2”専用メモリー
カードが刺さってないわ。
Jack, there's no MEMORY CARD
(PlayStation&@R2) in the MEMORY
CARD slot.
*/
ローズ_001: {
Du ben&~otigst eine MEMORY CARD (PS2), 
um speichern zu k&~onnen.
}
/*記録するには“PlayStation2”専用
メモリーカードが必要なんですって。
You need a MEMORY CARD
(PlayStation&@R2) to save with.
*/
ローズ_002: {
Kannst Du die MEMORY CARD (PS2) 
in den MEMORY CARD-Steckplatz 
einlegen?
}
/*ＭＥＭＯＲＹ ＣＡＲＤ差込口に
“PlayStation2”専用メモリーカードを
セットして。
Could you insert the MEMORY CARD
(PlayStation&@R2) in the MEMORY CARD
slot?
*/
//dv}//v
}//d
//空き領域がない h //e
resource PR_ＳＡＶＥ失敗＿空き領域ない__g {
//vox t:vc250341 {
ローズ_000: {
Sorry, Jack, aber Du hast
nicht genug freien Speicherplatz
auf der MEMORY CARD (PS2).
}
/*ジャック、ごめんなさい。
“PlayStation2”専用メモリーカードに
空き領域がないみたい。
I'm sorry, Jack, but there isn't
enough free space on the MEMORY
CARD (PlayStation&@R2).
*/
ローズ_001: {
Ich konnte die Daten nicht speichern.
}
/*記録出来なかったわ。
I couldn't save the data.
*/
//dv}//v
}//d

//フォーマットしようとしない h //e
resource PR_ＳＡＶＥ失敗＿フォーマットしようとしない__g {
