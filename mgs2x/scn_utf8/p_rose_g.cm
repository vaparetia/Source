//美人さんには美人さんの悩みがあるらしい h //e
resource PR_ＳＡＶＥ後＿美人さん１__g {
//vox t:vc250791 {
ローズ_000: {
Wei&~st Du, Jack, Es gibt da etwas,
was mich manchmal st&~ort.
}
//	<<<ENGLISH(2)>>>
//	You know, Jack...there's something
//	that bugs me sometimes...

/*ね、ジャック。
時々疑問に思うことがあるんだけど……。
*/
ライデン_001: {
Was?
}
//	<<<ENGLISH(2)>>>
//	What?

/*なんだ？*/
ローズ_002: {
Warum bist Du mit mir zusammen.
}
//	<<<ENGLISH>>>
//	Why are you going out with me?

/*あなた、どうして私とつきあってるの？*/
ライデン_003: {
Was?
}
//	<<<ENGLISH(2)>>>
//	Huh?

/*は？*/
ローズ_004: {
Weil ich sch&~on bin?
}
//	<<<ENGLISH>>>
//	Is it because I'm beautiful?

/*私が美人だから？*/
ライデン_005: {
Warum stellst Du mir pl&~otzlich all diese
