}
/*ふーん。いいけど。
その前に何か言うことあるんじゃない？
Hmph. Fine. Don't you have
something you want to say
before that?
*/
ライデン_004: {
Cio&`e?
}
/*何を？
Like what?
*/
ローズ_005: {
...
}
/*……
...
*/
//dv}//v
}//d

resource PR_ＳＡＶＥ前＿怒らせた後３__i {
//vox t:vc250661 {
