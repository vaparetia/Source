}
/*そういう聞かれ方して後の方って応える
奴いると思うか？
Do you really think anyone
would say "your reputation"?
*/
ローズ_012: {
...
}
/*……
...
*/
ライデン_013: {
Scherzo, scherzo. Certo che mi piaci 
per quella che sei. Giuro.
}
/*冗談だよ。俺が好きなのは君自身だ。
嘘じゃない。
I'm just joking. Of course
I like you for you. Honest
truth.
*/
ローズ_014: {
Davvero...? Grazie.
}
/*そう……ありがとう。
Really...thank you.
*/
//dv}//v
}//d


//仕事も大事 h //e
resource PR_ＳＡＶＥ後＿仕事も大事__i {
//vox t:vc250811 {
