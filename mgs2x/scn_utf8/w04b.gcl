//###################################################################################
//									ビヨンド設定
//###################################################################################



proc 船倉２ビヨンド設定 {
	print 'beyond_set'
	print 'ビヨンド設定'

//エルード東側
	trap by100 d:PLAYER \
		-mask いる \
		-button d:ACTION_BUTTON \		//ビヨンドボタン
		-state 0,4 \	//立ち状態or張り付き
		-exec {

			mesg プレイヤー d:PLAYER shadow 0

			@西向きビヨンド発動 by100 10070 $6 -19500 500 \
				d:BY_FALL_DEAD
		}



	//強制モーション中（両端）
	trap by100 d:PLAYER \
		-camera \
		-mask いる \
		-state 6 \
		-dir 3072,256 \	//方向指定
		-exec {
			if($6 > -7000){
				chara カメラ設定 ビヨンドカメラ \
					-c 1 \
					-p 7463,-5421,-4039 \
					-t 10764,-9600,-1927 \
					-a 200 \
					-i 1 -1 0 0 \
					-s $3

			}else{
				chara カメラ設定 ビヨンドカメラ \
					-c 1 \
					-p 8567,-5810,-19054 \
					-t 11562,-10687,-19072 \
					-a 200 \
					-i 1 -1 0 0 \
					-s $3

			}

		}





	//ぶら下がり中
	trap by100 d:PLAYER \
		-camera \
		-mask ＊ \
		-state 5 \
		-dir 1024 256 \	//方向指定
		-exec {


			if( $6 > -2001 ){

				chara カメラ設定 ビヨンドカメラ \
					-c 1 \
					-p 9748,-5727,-478 \
					-t 9727,-9527,-953 \
					-a 200 \
					-i 3 -1 0 0 \
					-s $3

			}else if( $6 < -18000 ){

