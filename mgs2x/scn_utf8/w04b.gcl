					-i 1 -1 0 0 \
					-s $3

			}



//右舷スクリーン下はりつき右側
		trap ca110 d:PLAYER \
			-camera \
			-mask ？ \
			-dir 2048,256 \
			-state d:TRP_STATE_BEHINDCAMERA_ENABLE \
			-exec {

				chara カメラ設定 ビヨンドカメラ \
					-c 1 \
					-p 11613,-13969,-25250 \
					-t 11184,-14584,-24310 \
					-a 200 \
					-i 1 -1 0 0 \
					-s $3

			}




//両サイドカメラ
		trap ca1000 d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {


				if($6 < -14000){
					@CS_スムーズカメラ昇順 $6 -18000 -14000 6097 7152
					eval($i:補完ＰＸ１ = $i:CS_結果１)

					@CS_スムーズカメラ昇順 $6 -18000 -14000 -10612 -9968
					eval($i:補完ＰＹ１ = $i:CS_結果１)

					@CS_スムーズカメラ昇順 $6 -18000 -14000 -11223 -4890
					eval($i:補完ＰＺ１ = $i:CS_結果１)


					@CS_スムーズカメラ昇順 $6 -18000 -14000 6386 6518
					eval($i:補完ＴＸ１ = $i:CS_結果１)

					@CS_スムーズカメラ昇順 $6 -18000 -14000 -17534 -13695
					eval($i:補完ＴＹ１ = $i:CS_結果１)

					@CS_スムーズカメラ昇順 $6 -18000 -14000 -20521 -12529
					eval($i:補完ＴＺ１ = $i:CS_結果１)


				}else{

					@CS_スムーズカメラ昇順 $6 -14000 -2000 7152 6938
					eval($i:補完ＰＸ１ = $i:CS_結果１)

					@CS_スムーズカメラ昇順 $6 -14000 -2000 -9968 -9932
					eval($i:補完ＰＹ１ = $i:CS_結果１)

					@CS_スムーズカメラ昇順 $6 -14000 -2000 -4890 -565
					eval($i:補完ＰＺ１ = $i:CS_結果１)


					@CS_スムーズカメラ昇順 $6 -14000 -2000 6518 6871
					eval($i:補完ＴＸ１ = $i:CS_結果１)

					@CS_スムーズカメラ昇順 $6 -14000 -2000 -13695 -19709
					eval($i:補完ＴＹ１ = $i:CS_結果１)

					@CS_スムーズカメラ昇順 $6 -14000 -2000 -12529 -2183
					eval($i:補完ＴＺ１ = $i:CS_結果１)

				}

				@CS_スムーズカメラ昇順 $4 -5000 5000 (-$i:補完ＰＸ１) $i:補完ＰＸ１
				eval($i:補完ＰＸ = $i:CS_結果１)

				@CS_スムーズカメラ昇順 $4 -5000 5000 (-$i:補完ＴＸ１) $i:補完ＴＸ１
				eval($i:補完ＴＸ = $i:CS_結果１)


				//手前両サイド
				if($6 > -4000 && $4 > 9000){

					@CS_スムーズカメラ昇順 $4 9000 11000 $i:補完ＰＸ 9500
					eval($i:補完ＰＸ = $i:CS_結果１)

					@CS_スムーズカメラ昇順 $4 9000 11000 $i:補完ＴＸ 9500
					eval($i:補完ＴＸ = $i:CS_結果１)

				}else if($6 > -4000 && $4 < -9000){

					@CS_スムーズカメラ降順 $4 -9000 -11000 $i:補完ＰＸ -9500
					eval($i:補完ＰＸ = $i:CS_結果１)

					@CS_スムーズカメラ降順 $4 -9000 -11000 $i:補完ＴＸ -9500
					eval($i:補完ＴＸ = $i:CS_結果１)


				}




				chara カメラ設定 サブカメラ１ \
					-c 1 \
					-p $i:補完ＰＸ,$i:補完ＰＹ１,$i:補完ＰＺ１ \
					-t $i:補完ＴＸ,$i:補完ＴＹ１,$i:補完ＴＺ１ \
					-a 170 \
					-i 1 -1 0 0 \
					-s $3

			}


	}



