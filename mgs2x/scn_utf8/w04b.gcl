					-p 9481,-4760,-18359 \
					-t 9738,-9456,-19009 \
					-a 200 \
					-i 3 -1 0 0 \
					-s $3

			}else{

				if( $6 > -5000 ){
					eval($i:補完ＰＹ = -5761 )

				}else{
					eval($i:補完ＰＹ = -1000 )

				}

				eval($i:補完ＰＺ = $6 + 2000 )
				eval($i:補完ＴＺ = $6 )

				chara カメラ設定 ビヨンドカメラ \
					-c 1 \
					-p 9000,$i:補完ＰＹ,$i:補完ＰＺ \
					-t 9750,-10000,$i:補完ＴＺ \
					-a 200 \
					-i 3 -1 0 0 \
					-s $3

			}


		}

/*
	trap by100 d:PLAYER \
		-camera \
		-mask ＊ \
		-state 5 \
		-dir 1024 256 \	//方向指定
		-exec {
			@CS_スムーズカメラ昇順 $6 -6000 -4000 -470 640
