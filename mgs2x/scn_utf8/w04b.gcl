//###################################################################################

	// ぼかしセット
	// ------------------------------------
	proc ぼかしセット {
		print 'ぼかし設定'

		chara 遠景ぼかし far_deforcus \
			-plane	4 \
			-near	4000 \
			-far	9000

		chara 近景ぼかし near_deforcus \
			-plane	3 \
			-near	0 \
			-far	3000


		@船倉敵兵発見ぼかし設定	//発見時カメラ用。w04.hにあります。


	}





//###################################################################################
//									透明壁設定
//###################################################################################


	proc 船倉２透明壁設定{
		print '透明壁設定'

			chara 透明壁 地下ピット西側 \
				-position -12000 -17000 -2500 2000 \
					-10500 -17000 -2500 2000 \
				-attribute (d:HZX_SEG_NO_BULLET|d:HZX_SEG_NO_MISSILE|d:HZX_SEG_NO_C4|d:HZX_SEG_NO_RECOIL|d:HZX_SEG_NO_HARITSUKI|d:HZX_SEG_NO_DISP_RADAR|d:HZX_SEG_NO_BULLETHOLE|d:HZX_SEG_NO_SPRAY|d:HZX_SEG_NO_ENEMY_EYES)

			chara 透明壁 地下ピット西側 \
				-position -10500 -17000 -4000 2000 \
					-10500 -17000 -2500 2000 \
				-attribute (d:HZX_SEG_NO_BULLET|d:HZX_SEG_NO_MISSILE|d:HZX_SEG_NO_C4|d:HZX_SEG_NO_RECOIL|d:HZX_SEG_NO_HARITSUKI|d:HZX_SEG_NO_DISP_RADAR|d:HZX_SEG_NO_BULLETHOLE|d:HZX_SEG_NO_SPRAY|d:HZX_SEG_NO_ENEMY_EYES)

			mesg 透明壁 地下ピット西側 off


			chara 透明壁 地下ピット東側 \
				-position 12000 -17000 -2500 2000 \
					10500 -17000 -2500 2000 \
				-attribute (d:HZX_SEG_NO_BULLET|d:HZX_SEG_NO_MISSILE|d:HZX_SEG_NO_C4|d:HZX_SEG_NO_RECOIL|d:HZX_SEG_NO_HARITSUKI|d:HZX_SEG_NO_DISP_RADAR|d:HZX_SEG_NO_BULLETHOLE|d:HZX_SEG_NO_SPRAY|d:HZX_SEG_NO_ENEMY_EYES)

			chara 透明壁 地下ピット東側 \
				-position 10500 -17000 -4000 2000 \
					10500 -17000 -2500 2000 \
				-attribute (d:HZX_SEG_NO_BULLET|d:HZX_SEG_NO_MISSILE|d:HZX_SEG_NO_C4|d:HZX_SEG_NO_RECOIL|d:HZX_SEG_NO_HARITSUKI|d:HZX_SEG_NO_DISP_RADAR|d:HZX_SEG_NO_BULLETHOLE|d:HZX_SEG_NO_SPRAY|d:HZX_SEG_NO_ENEMY_EYES)


			mesg 透明壁 地下ピット東側 off




			chara 透明壁 敵兵視界遮蔽 \
				-position -10250 -17000 -10500 2000 \
					-7750 -17000 -10500 2000 \
				-attribute (d:HZX_SEG_NO_BULLET|d:HZX_SEG_NO_MISSILE|d:HZX_SEG_NO_C4|d:HZX_SEG_NO_RECOIL|d:HZX_SEG_NO_PLAYER|d:HZX_SEG_NO_DISP_RADAR|d:HZX_SEG_NO_BULLETHOLE|d:HZX_SEG_NO_SPRAY)








			chara 透明壁 プロジェクタ透明壁 \
				-position 1000 -17000 0 2000 \
					1000 -17000 -1500 2000 \
				-attribute (d:HZX_SEG_NO_BULLET|d:HZX_SEG_NO_MISSILE|d:HZX_SEG_NO_C4|d:HZX_SEG_NO_RECOIL|d:HZX_SEG_NO_DISP_RADAR|d:HZX_SEG_NO_BULLETHOLE|d:HZX_SEG_NO_SPRAY)

			chara 透明壁 プロジェクタ透明壁 \
				-position -1000 -17000 0 2000 \
					-1000 -17000 -1500 2000 \
				-attribute (d:HZX_SEG_NO_BULLET|d:HZX_SEG_NO_MISSILE|d:HZX_SEG_NO_C4|d:HZX_SEG_NO_RECOIL|d:HZX_SEG_NO_DISP_RADAR|d:HZX_SEG_NO_BULLETHOLE|d:HZX_SEG_NO_SPRAY)


			chara 透明壁 プロジェクタ透明壁 \
				-position 1000 -17000 -1500 2000 \
					-1000 -17000 -1500 2000 \
				-attribute (d:HZX_SEG_NO_BULLET|d:HZX_SEG_NO_MISSILE|d:HZX_SEG_NO_C4|d:HZX_SEG_NO_RECOIL|d:HZX_SEG_NO_DISP_RADAR|d:HZX_SEG_NO_BULLETHOLE|d:HZX_SEG_NO_SPRAY)




	}












//###################################################################################
//							演説ドッキリ系スタート条件チェック
//###################################################################################


proc 演説ドッキリ系スタート条件チェック{
		print '演説ドッキリ系スタート条件チェック'


//左チェック
		trap ev001_l d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_BEHIND,d:TRP_STATE_INTRUDE \
			-exec {
				if($3 == 入る){
					print '左ドッキリＯＫ'
					eval($s:ドッキリ系スタート = 左)
				}else{
					print 'ドッキリ不可'
					eval($s:ドッキリ系スタート = 不可)
				}

			}



//右チェック
		trap ev001_r d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_BEHIND,d:TRP_STATE_INTRUDE \
			-exec {
				if($3 == 入る){
					print '右ドッキリＯＫ'
					eval($s:ドッキリ系スタート = 右)
				}else{
					print 'ドッキリ不可'
					eval($s:ドッキリ系スタート = 不可)
				}

			}




//後ろチェック
		trap ev001_r d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_BEHIND \
			-dir 0,256 \	//方向指定
			-exec {
				if($3 == 入る){
					print '後ろドッキリＯＫ'
					eval($s:ドッキリ系スタート = 後ろ)
				}else{
					print 'ドッキリ不可'
					eval($s:ドッキリ系スタート = 不可)
				}

			}




}




//###################################################################################
//									心霊写真設定
//###################################################################################



proc 心霊写真設定 {
	print 'ghost_photo'
	print '心霊写真設定'


	chara プットオブジェ プロジェクタ心霊写真 \
		-m w04b1_shinrei \
		-r 0 0 0 \
		-p 0 0 0 \
		-l w04b \
		-f d:PUT_OBJ_THERMAL


	mesg プットオブジェ プロジェクタ心霊写真 off

	eval($f:心霊写真登場中 = 0)

	trap ca1000 d:PLAYER \
		-mask ＊ \
		-exec {
			if($3 == いる && $w:アイテム == d:アイテム:タンカー編カメラ){

				command パッド操作 -mask d:PAD_Y

				command パッドチェック -which 0 -direct -press
				if($status & d:PAD_Y){

					command パッド操作 -press d:PAD_Y

					if($f:第二船倉プロジェクタ方向 == 0 && !$f:w04b_今暗い && !$f:心霊写真登場中 && `%rand 3` == 0){
						print '呼ばれて飛び出てジャジャジャジャーン！！！！！'
						mesg プットオブジェ プロジェクタ心霊写真 on
						eval($f:心霊写真登場中 = 1)

						chara delay ディレイ -time 1 -exec{
							mesg プットオブジェ プロジェクタ心霊写真 off
							chara delay ディレイ -time 1 -exec{
								eval($f:心霊写真登場中 = 0)
							}
						}
					}
				}

			}else{
				command パッド操作 -cancel 2		//マスクのみ解除
			}


		}


}



//###################################################################################
//									マップ接続設定
//###################################################################################


	proc ロードプロック {
		print 'ロードプロック設定'

		command セットサウンドコード -c d:SNG_FOUTS_S		//ＢＧＭフェードアウト

		if ($s:呼び出しプロック == mv_w04b_w04a_0) {
			@mv_w04b_w04a_0
		} else if ($s:呼び出しプロック == mv_w04b_w04a_1) {
			@mv_w04b_w04a_1
		} else if ($s:呼び出しプロック == mv_w04b_w04a_2) {
			@mv_w04b_w04a_2
		} else if ($s:呼び出しプロック == mv_w04b_w04a_3) {
			@mv_w04b_w04a_3

		} else if ($s:呼び出しプロック == mv_w04b_w04c_0) {
			@mv_w04b_w04c_0
		} else if ($s:呼び出しプロック == mv_w04b_w04c_1) {
			@mv_w04b_w04c_1
		} else if ($s:呼び出しプロック == mv_w04b_w04c_2) {
			@mv_w04b_w04c_2
		} else if ($s:呼び出しプロック == mv_w04b_w04c_3) {
			@mv_w04b_w04c_3

		} else if ($s:呼び出しプロック == mv_w04b_d11t_0) {
			@mv_w04b_d11t_0
		} else if ($s:呼び出しプロック == mv_w04b_d11t_1) {
			@mv_w04b_d11t_1
		} else if ($s:呼び出しプロック == mv_w04b_d11t_2) {
			@mv_w04b_d11t_2
		} else if ($s:呼び出しプロック == mv_w04b_d11t_3) {
			@mv_w04b_d11t_3

		} else if ($s:呼び出しプロック == mv_w04b_w04c_4) {
			@mv_w04b_w04c_4

		} else if ($s:呼び出しプロック == mv_w04b_d11t_4) {
			@mv_w04b_d11t_4

		}

	}



	proc マップ接続{

