// マップ設定
// ------------------------------------
chara マップ 船倉２ -k w04b1 0 0 0 -h w04b 0 -l w04b
chara マップ 通路１ -k w04b2 0 0 0 -h w04b 1 -l w04b
chara マップ 通路２ -k w04b3 0 0 0 -h w04b 2 -l w04b

chara マップ接合 船倉接合１ 通路１ 船倉２
chara マップ接合 船倉接合２ 船倉２ 通路２

command マップ設定 船倉２ 通路１ 通路２ -set {
	/* サウンドマネージャー＞敵兵コマンダー＞ＢＧＭマネージャー
	   の順番は、遵守すること */
		@サウンドマネージャー設定
		@レーダーアタリ設定
		@常駐キャラ設定
		@エフェクト設定
		@プレイヤー設定
		@カメラ設定
		@ぼかしセット
		@マップ接続
		@演説音声小さめに	//w04.hの中
#if d:debug_timer
		@船倉タイマー演算
#endif
#if d:CTDOWN_TIMER
		@船倉タイマー起動
#endif

}

command マップ設定 通路１ 船倉２ -set {
		@ドア設置／通路１－船倉２
}
command マップ設定 船倉２ 通路２ -set {
		@ドア設置／船倉２－通路２
}

command マップ設定 船倉２ -set {
		@船倉２カメラ設定
		@船倉２ビヨンド設定
	#if d:AUTO_JUMP
		@船倉１ｍジャンプ設定
	#endif
		@船倉２箱設置

		@第一第二船倉キャラクタ専用ライトセット		//w04.hにある

		#if d:SEALS_1_FG
			@船倉２海兵隊セット
			@船倉物音カメラ		//w04.hの中
		#endif
		@船倉ライター落とし兵イベント
		#if d:SUB_CAMERA
		@子画面設定
		#endif
		@プロジェクタライト設定
		@手動プロジェクタチェンジ

		@船倉２透明壁設定
		#if d:PITHOLE
			@船倉２西側地下はしご設定
			@船倉２東側地下はしご設定
		#endif
		@演説ドッキリ系スタート条件チェック
		#if d:GHOST
			@心霊写真設定
		#endif
		#if d:SNEEZE
			@船倉くしゃみ設定		//w04.hにある
		#endif

}
command マップ設定 通路１ -set {
		@船倉２カメラ設定	//ロード場所変更のため
//		@通路１カメラ設定
}
command マップ設定 通路２ -set {
		@通路２カメラ設定
		@主観禁止壁設定
}

command マップ設定 船倉２ 通路１ 通路２ -set {
		@船倉２演説ボリューム制御
		@サウンド設定
		@タンカーデジカメ写真判定		//dcam_tanker.hの中にあります。
		//@タンカー編全体マップ設定 d:第二船倉マップ
		@ポーズ時ステージ名表示設定 d:wn_第二船倉
}

//※※通信機のincludeは移動させないこと！！※※
#include "w04b_cdc.ch"


//初期マップの表示
command マップ表示 	-add 船倉２

	eval( $f:船倉２西側地下ピットふた開いた = 0 )
	eval( $f:船倉２東側地下ピットふた開いた = 0 )
	eval($w:船倉物音カメラフレーム数 = 0)
	eval($f:船倉ステージ移動直後 = 1)
	eval($s:ドッキリ系スタート = 不可)
	eval($b:船倉プロジェクタ手動チェンジ回数 = 0)
	eval($f:w04b_今暗い = 0)
	eval($b:船倉デジカメ撮影つぶやき中 = 0)
	eval($w:船倉演説イベント中 = 0)
	eval($f:ローカルフラグ１ = 0)			//ダークゾーン出し入れ用
	eval($f:ゲームオーバー処理終了呼ばれた = 0)
	eval($b:船倉デジカメ撮影つぶやき中 = 0)

if($f:第二船倉プロジェクタチェンジデモカメラ中){
	print 'すぐロードに入ったのでフラグ「$f:第二船倉プロジェクタチェンジデモカメラ中」を寝かせる！！！！'
	eval($f:第二船倉プロジェクタチェンジデモカメラ中 = 0)
	eval($f:第二船倉プロジェクタチェンジ見た = 1)
	command varsave $f:第二船倉プロジェクタチェンジ見た
}




//w04cから来たときは通路に現れるため、通路を表示させる
if($i:プレイヤー初期Ｚ位置 < -20000){
	mesg マップ接合 船倉接合２ on
}



@第２船倉ロード進入時処理









	proc レーダーアタリ設定 {

		#if d:RADAR
			chara レーダー レーダー

			if($f:レーダーフラグ){
				mesg レーダー レーダー on
			} else {
				mesg レーダー レーダー off
			}

		#endif



	}










//###################################################################################
//									エフェクト設定
//###################################################################################

	// エフェクト設定
	// ------------------------------------
	proc エフェクト設定 {
		print 'エフェクト設定'

		#if d:SCREENSHOT
			chara スクリーンショット scrshot
		#endif
		#if d:KEYBOARD
			chara USBキーボード実行 keyboard \
				-e d:KBD_ESC {	mesg 臨時顔アニメキャラ アニメキャラ モーション再生 normal 30
						mesg 臨時顔アニメキャラ アニメキャラ 視線変更 -1 } \
				-e d:KBD_F1  {	mesg 臨時顔アニメキャラ アニメキャラ モーション再生 test_01 30 } \
				-e d:KBD_F2  {	mesg 臨時顔アニメキャラ アニメキャラ モーション再生 test_02 30 } \
				-e d:KBD_F3  {	mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_teeth 30 } \
				-e d:KBD_F4  {	mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_scream 0 } \
				-e d:KBD_F5  {	mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_relax 30 } \
				-e d:KBD_F6  {	mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_surprise 30 } \
				-e d:KBD_F7  {	mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_sigh 30 } \
				-e d:KBD_F10 {	mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_teeth 30
							  chara delay カメラディレイ -time 20 \
								-exec { mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_surprise 20
								}
							  chara delay カメラディレイ -time 40 \
								-exec { mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_teeth 20
								}
							} \
				-e d:KBD_F11 {	mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_teeth 20
							  chara delay カメラディレイ -time 30 \
								-exec { mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_relax 20
								}
							  chara delay カメラディレイ -time 60 \
								-exec { mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_surprise 20
								}
							  chara delay カメラディレイ -time 90 \
								-exec {	mesg 臨時顔アニメキャラ アニメキャラ モーション再生  normal 20
								}
							} \

				-e d:KBD_F12 {	mesg 臨時顔アニメキャラ アニメキャラ 視線変更 2 } \
				-e d:KBD_F8  {	mesg プレイヤー d:PLAYER shadow 1 } \
				-e d:KBD_F9  {	mesg プレイヤー d:PLAYER shadow 0 } \
				-e d:KPD_0   { 	mesg 遠景ぼかし far_deforcus off
						mesg 近景ぼかし near_deforcus  off } \
				-e d:KPD_1   {	mesg 遠景ぼかし far_deforcus  off } \
				-e d:KPD_2   {	mesg 遠景ぼかし far_deforcus  on  } \
				-e d:KPD_3   {	mesg 遠景ぼかし far_deforcus  set 300 0 6000 9000 } \
				-e d:KPD_4   {	mesg 近景ぼかし near_deforcus off } \
				-e d:KPD_5   {	mesg 近景ぼかし near_deforcus on  } \
				-e d:KPD_6   {	mesg 近景ぼかし near_deforcus set 300 0 0 5000 }
		#endif


#if 1
		print 'フォグフォグ君！！'

		chara フォグ fog \
			 -c 0 10 15 \
			 -n -5000 \
			 -f 50000
#else
		chara フォグ fog \
			 -c 0 0 1 \
			 -n 0 \
			 -f 50000
#endif



		chara シネマスクリーン シネマ \
			-top d:CINEMA_BELT_UPPER \
			-bottom d:CINEMA_BELT_LOWER \
			-ftime 30



	// 跳弾番号設定
	// ------------------------------------
		command 跳弾ノーマル -n 0
		command 跳弾ノーマル -n 1
		command 跳弾ノーマル -n 2
		command 跳弾ノーマル -n 3
		command 跳弾ノーマル -n 4
		command 弾痕ノーマル -n 0
		command 弾痕ノーマル -n 1
		command 弾痕ノーマル -n 2
		command 弾痕ノーマル -n 3
		command 弾痕ノーマル -n 4





//レーダーアタリ処理
		print 'レーダーアタリ追加'
		command foreach -argc 1 -repeat 3 \
			-data { \
				{0},{1},{2} \
			} \
			-exec {
				command 追加ＨＺＸグループ登録 \
					-hzx_id $1 \
					-add_id 9
			}


		trap ev010 d:PLAYER \
			-mask ？ \
			-exec {
				if($3 == 入る){
					command 追加ＨＺＸグループ登録 \
						-hzx_id 0 \
						-add_id 8
				}else{
					command 追加ＨＺＸグループ削除 \
						-hzx_id 0 \
						-add_id 8
				}
			}


	}










//###################################################################################
//									サウンド設定
//###################################################################################


	proc サウンドマネージャー設定 {
#if d:SOUND_FG
		print 'サウンドマネージャー設定'
		chara サウンドマネージャー ＳＤマネ -pak 0
#endif
	}


	proc サウンド設定 {
		#if d:SOUND_FG

		print 'サウンド設定'

		//ここはゲームオーバーデモのために特殊
#if 1
		command セットサウンドコード -c d:SNG_PLAY_05
#else
		chara ＢＧＭマネージャー ＢＧＭマネ
#endif

#if 1
		@サウンド効果音設定
#else

		//スネーク
		// 左足音
		command 壁床効果音設定 -id 0 -type 0 \
			-se		d:SD_P_FOOTL01 \
			-data	d:se_code:SD_P_FOOT_01L,d:NOISE_ZERO \
					d:se_code:SD_P_FOOT_02L,d:NOISE_ZERO \
					d:se_code:SD_P_FOOT_03L,d:NOISE_ZERO \
					d:se_code:SD_P_FOOT_04L,d:NOISE_ZERO \
					d:se_code:SD_P_FOOT_02L,d:NOISE_S \
					d:se_code:SD_P_FOOT_01L,d:NOISE_ZERO \
					d:se_code:SD_P_FOOT_01L,d:NOISE_ZERO \
					d:se_code:SD_P_FOOT_01L,d:NOISE_ZERO

		// 右足音
		command 壁床効果音設定 -id 0 -type 0 \
			-se 	d:SD_P_FOOTR01 \
			-data	d:se_code:SD_P_FOOT_01R,d:NOISE_ZERO \
					d:se_code:SD_P_FOOT_02R,d:NOISE_ZERO \
					d:se_code:SD_P_FOOT_03R,d:NOISE_ZERO \
					d:se_code:SD_P_FOOT_04R,d:NOISE_ZERO \
					d:se_code:SD_P_FOOT_02R,d:NOISE_S \
					d:se_code:SD_P_FOOT_01R,d:NOISE_ZERO \
					d:se_code:SD_P_FOOT_01R,d:NOISE_ZERO \
					d:se_code:SD_P_FOOT_01R,d:NOISE_ZERO

			// ホフク左
			command 壁床効果音設定 \
				-id 0 \
				-type 0 \
				-se		d:SD_P_HOFUKU05 \
				-data	d:SD_P_HOFUKU05,d:NOISE_ZERO \
						d:SD_P_HOFUKU05,d:NOISE_ZERO \
						d:SD_P_HOFUKU05,d:NOISE_ZERO \
						d:SD_P_HOFUKU05,d:NOISE_ZERO \
						d:SD_P_HOFUKU05,d:NOISE_ZERO \
						d:se_code:SD_P_INTLUDE1,d:NOISE_ZERO \
						d:SD_P_HOFUKU05,d:NOISE_ZERO \
						d:SD_P_HOFUKU05,d:NOISE_ZERO


			// ホフク右
			command 壁床効果音設定 \
				-id 0 \
				-type 0 \
				-se		d:SD_P_HOFUKU06 \
				-data	d:SD_P_HOFUKU06,d:NOISE_ZERO \
						d:SD_P_HOFUKU06,d:NOISE_ZERO \
						d:SD_P_HOFUKU06,d:NOISE_ZERO \
						d:SD_P_HOFUKU06,d:NOISE_ZERO \
						d:SD_P_HOFUKU06,d:NOISE_ZERO \
						d:se_code:SD_P_INTLUDE2,d:NOISE_ZERO \
						d:SD_P_HOFUKU06,d:NOISE_ZERO \
						d:SD_P_HOFUKU06,d:NOISE_ZERO


		// 壁叩き -dataオプションは必ず８セット書くこと
		command 壁床効果音設定 \
			-id		0 \
			-type	1 \
			-se		d:SD_P_WALL02 \
			-data	d:se_code:SD_A_WALLM01,d:NOISE_ZERO \ // 通常
					d:se_code:SD_A_WALLM02,d:NOISE_ZERO \ // 鉄筋
					d:se_code:SD_A_WALLM03,d:NOISE_ZERO \ // 鉄板
					d:se_code:SD_A_WALLM04,d:NOISE_S \	  // 木
					d:se_code:SD_A_WALLM05,d:NOISE_ZERO \ // ダンボール
					d:se_code:SD_A_WALLM01,d:NOISE_ZERO \
					d:se_code:SD_A_WALLM01,d:NOISE_ZERO \
					d:se_code:SD_A_WALLM01,d:NOISE_ZERO

		// 床跳弾音
		command 壁床効果音設定 \
			-id 0 \
			-type 0 \
			-se d:SD_W_RICOCH02 \
			-data	d:se_code:SD_A_RICOCH01,d:NOISE_ZERO \ // 跳弾１－１ 通常
					d:se_code:SD_A_RICOCH02,d:NOISE_ZERO \ // 跳弾２－１ 鉄筋
					d:se_code:SD_A_RICOCH03,d:NOISE_ZERO \ // 跳弾３－１ 鉄板
					d:se_code:SD_A_RICOCH04,d:NOISE_S \	   // 跳弾４－１ 木
					d:se_code:SD_A_RICOCH05,d:NOISE_ZERO \ // 跳弾５－１ ダンボール
					d:se_code:SD_A_RICOCH02,d:NOISE_ZERO \
					d:se_code:SD_A_RICOCH02,d:NOISE_ZERO \
					d:se_code:SD_A_RICOCH02,d:NOISE_ZERO	// 必ず８セット書くこと

		// 壁跳弾音
		command 壁床効果音設定 \
			-id 0 \
			-type 1 \
			-se d:SD_W_RICOCH02 \
			-data	d:se_code:SD_A_RICOCH01,d:NOISE_ZERO \ // 跳弾１－１ 通常
					d:se_code:SD_A_RICOCH02,d:NOISE_ZERO \ // 跳弾２－１ 鉄筋
					d:se_code:SD_A_RICOCH03,d:NOISE_ZERO \ // 跳弾３－１ 鉄板
					d:se_code:SD_A_RICOCH04,d:NOISE_S \	   // 跳弾４－１ 木
					d:se_code:SD_A_RICOCH05,d:NOISE_ZERO \ // 跳弾５－１ ダンボール
					d:se_code:SD_A_RICOCH02,d:NOISE_ZERO \
					d:se_code:SD_A_RICOCH02,d:NOISE_ZERO \
					d:se_code:SD_A_RICOCH02,d:NOISE_ZERO	// 必ず８セット書くこと








		// 警備兵１足音
		command 壁床効果音設定 -id 1 -type 0 -se d:SD_P_FOOTL01 \ // -dataオプションは必ず８セット書くこと
			-data	d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
					d:se_code:SD_E_EFOOT_2L1,d:NOISE_ZERO \
					d:se_code:SD_E_EFOOT_3L1,d:NOISE_ZERO \
					d:se_code:SD_E_EFOOT_4L1,d:NOISE_ZERO \
					330,d:NOISE_ZERO \
					330,d:NOISE_ZERO \
					330,d:NOISE_ZERO \
					330,d:NOISE_ZERO

		command 壁床効果音設定 -id 1 -type 0 -se d:SD_P_FOOTR01 \ // -dataオプションは必ず８セット書くこと
			-data	d:se_code:SD_E_EFOOT_1R1,d:NOISE_ZERO \
					d:se_code:SD_E_EFOOT_2R1,d:NOISE_ZERO \
					d:se_code:SD_E_EFOOT_3R1,d:NOISE_ZERO \
					d:se_code:SD_E_EFOOT_4R1,d:NOISE_ZERO \
					330,d:NOISE_ZERO \
					330,d:NOISE_ZERO \
					330,d:NOISE_ZERO \
					330,d:NOISE_ZERO

		// 警備兵２足音
		command 壁床効果音設定 -id 2 -type 0 -se d:SD_P_FOOTL01 \ // -dataオプションは必ず８セット書くこと
			-data	d:se_code:SD_E_EFOOT_1L2,d:NOISE_ZERO \
					d:se_code:SD_E_EFOOT_2L2,d:NOISE_ZERO \
					d:se_code:SD_E_EFOOT_3L2,d:NOISE_ZERO \
					d:se_code:SD_E_EFOOT_4L2,d:NOISE_ZERO \
					330,d:NOISE_ZERO \
					330,d:NOISE_ZERO \
					330,d:NOISE_ZERO \
					330,d:NOISE_ZERO

		command 壁床効果音設定 -id 2 -type 0 -se d:SD_P_FOOTR01 \ // -dataオプションは必ず８セット書くこと
			-data	d:se_code:SD_E_EFOOT_1R2,d:NOISE_ZERO \
					d:se_code:SD_E_EFOOT_2R2,d:NOISE_ZERO \
					d:se_code:SD_E_EFOOT_3R2,d:NOISE_ZERO \
					d:se_code:SD_E_EFOOT_4R2,d:NOISE_ZERO \
					330,d:NOISE_ZERO \
					330,d:NOISE_ZERO \
					330,d:NOISE_ZERO \
					330,d:NOISE_ZERO

		// 警備兵３足音
		command 壁床効果音設定 -id 3 -type 0 -se d:SD_P_FOOTL01 \ // -dataオプションは必ず８セット書くこと
			-data	d:se_code:SD_E_EFOOT_1L3,d:NOISE_ZERO \
					d:se_code:SD_E_EFOOT_2L3,d:NOISE_ZERO \
					d:se_code:SD_E_EFOOT_3L3,d:NOISE_ZERO \
					d:se_code:SD_E_EFOOT_4L3,d:NOISE_ZERO \
					330,d:NOISE_ZERO \
					330,d:NOISE_ZERO \
					330,d:NOISE_ZERO \
					330,d:NOISE_ZERO

		command 壁床効果音設定 -id 3 -type 0 -se d:SD_P_FOOTR01 \ // -dataオプションは必ず８セット書くこと
			-data	d:se_code:SD_E_EFOOT_1R3,d:NOISE_ZERO \
					d:se_code:SD_E_EFOOT_2R3,d:NOISE_ZERO \
					d:se_code:SD_E_EFOOT_3R3,d:NOISE_ZERO \
					d:se_code:SD_E_EFOOT_4R3,d:NOISE_ZERO \
					330,d:NOISE_ZERO \
					330,d:NOISE_ZERO \
					330,d:NOISE_ZERO \
					330,d:NOISE_ZERO

		// 警備兵４足音
		command 壁床効果音設定 -id 4 -type 0 -se d:SD_P_FOOTL01 \ // -dataオプションは必ず８セット書くこと
			-data	d:se_code:SD_E_EFOOT_1L4,d:NOISE_ZERO \
					d:se_code:SD_E_EFOOT_2L4,d:NOISE_ZERO \
					d:se_code:SD_E_EFOOT_3L4,d:NOISE_ZERO \
					d:se_code:SD_E_EFOOT_4L4,d:NOISE_ZERO \
					330,d:NOISE_ZERO \
					330,d:NOISE_ZERO \
					330,d:NOISE_ZERO \
					330,d:NOISE_ZERO

		command 壁床効果音設定 -id 4 -type 0 -se d:SD_P_FOOTR01 \ // -dataオプションは必ず８セット書くこと
			-data	d:se_code:SD_E_EFOOT_1R4,d:NOISE_ZERO \
					d:se_code:SD_E_EFOOT_2R4,d:NOISE_ZERO \
					d:se_code:SD_E_EFOOT_3R4,d:NOISE_ZERO \
					d:se_code:SD_E_EFOOT_4R4,d:NOISE_ZERO \
					330,d:NOISE_ZERO \
					330,d:NOISE_ZERO \
					330,d:NOISE_ZERO \
					330,d:NOISE_ZERO
#endif



		#endif
	}







//###################################################################################
//									プレイヤー設定
//###################################################################################

	proc プレイヤー設定 {
			print 'プレイヤー設定'

			if( $s:登場ポイント == ダクト ){
				eval( $b:プレイヤー初期状態 = 2 )

			}else{
				eval( $b:プレイヤー初期状態 = 0 )

			}


			print '$s:登場ポイント'$s:登場ポイント

			chara プレイヤー d:PLAYER \
//				-p 3000,-17900,-8000 \//地下
//				-p 10800,-18000,-3000 \//地下ピット
				-p $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,$i:プレイヤー初期Ｚ位置 \
				-d 0,$i:プレイヤー初期方向,0 \
				-s $b:プレイヤー初期状態 \
				-i 0 \
				-m sna_def -a snake -o sna_w04


				//バンダナ
				chara ロープモデル３ バンダナ１ \
					-n sna_bdn1 \
					-d 1 \
					-y d:PLAYER \
					-z 12 \
					-x 0,60,-90 \
					-m 12 \
					-p 250 \
					-k 350 \
					-o 110 \
					-f 1

				chara ロープモデル３ バンダナ２ \
					-n sna_bdn2 \
					-d 1 \
					-y d:PLAYER \
					-z 12 \
					-x 0,50,-90 \
					-m 22 \
					-p 250 \
					-k 350 \
					-o 110 \
					-f 1

				//はしごモード追加
				command プラグインはしご
				command はしご設定 \
					-b 	d:モーションリスト:non_ladder_idle_loop,\
						d:モーションリスト:non_ladder_idle_loop_l,\
						d:モーションリスト:non_ladder_up_loop,\
						d:モーションリスト:non_ladder_down_loop
		#if d:MULTI_MODEL
			chara マルチウェイトキャラ マルチ \
				-name d:PLAYER \
				-model sna_mmt

			chara 臨時顔アニメキャラ アニメキャラ \
				-chara	d:PLAYER
		#endif

			//@プレイヤーＬＯＤ設定 d:P_STATE_TYPE d:TRP_STATE_BEHIND
			@プレイヤーＬＯＤ設定 d:C_DISTANCE_TYPE 6000

	}






//###################################################################################
//									プロジェクタ設定
//###################################################################################

	//プロジェクタ光設定
	// ------------------------------------

	proc プロジェクタライト設定 {
		print 'プロジェクタライト設定'

		if($i:プレイヤー初期Ｘ位置 > 0){
			eval($f:第二船倉プロジェクタ方向 = 0)		//0は右、1は左
			eval($w:第二船倉右プロジェクタステータス = 0x0001)
			eval($w:第二船倉左プロジェクタステータス = 0x0003)
		}else{
			eval($f:第二船倉プロジェクタ方向 = 1)		//0は右、1は左
			eval($w:第二船倉右プロジェクタステータス = 0x0003)
			eval($w:第二船倉左プロジェクタステータス = 0x0001)
		}


		//プロジェクタ右
		chara スポットライト投影モデル プロジェクタライト右 \
			-m w04b1_k1 \
			-p 0,0,0


		chara 静止スポットライト設置 プロジェクタライト右 \
			-pos 630,-15600,-1300 \
			-dir -150,1930,0 \
			-range 30000 \
			-angle 14 \
			-color 255,255,255 \
			-option $w:第二船倉右プロジェクタステータス

		chara プロジェクタライト プロジェクタライト右 \
			-p 630,-15600,-1300 \
			-d 4000,-10000,-22000


		//プロジェクタ左
		chara スポットライト投影モデル プロジェクタライト左 \
			-m w04b1_k2 \
			-p 0,0,0


		chara 静止スポットライト設置 プロジェクタライト左 \
			-pos -630,-15600,-1300 \
			-dir -154,2192,0 \
			-range 30000 \
			-angle 16 \
			-color 255,255,255 \
			-option $w:第二船倉左プロジェクタステータス



		chara プロジェクタライト プロジェクタライト左 \
			-p -630,-15600,-1300 \
			-d -4000,-10000,-22000



		if($f:第二船倉プロジェクタ方向 == 0){
			print 'プロジェクタ右がＯＮです。'
			mesg プロジェクタライト プロジェクタライト左 オフ
			mesg 船倉兵 SEALS_1 プロジェクタ２止まれ
			mesg 船倉兵 SEALS_1 スクリーン１

		}else{	//左の場合
			print 'プロジェクタ左がＯＮです。'
			mesg プロジェクタライト プロジェクタライト右 オフ
			mesg 船倉兵 SEALS_1 プロジェクタ１止まれ
			mesg 船倉兵 SEALS_1 スクリーン２

		}


		chara スポットライト投影モデル 椎名まおプロジェクタ \
			-m w04b1_k1 \
			-p 0,0,0

		chara プロジェクタライト 椎名まおプロジェクタ右 \
			-p 630,-15600,-1300 \
			-d 4000,-10000,-22000

		chara プロジェクタライト 椎名まおプロジェクタ左 \
			-p -630,-15600,-1300 \
			-d -4000,-10000,-22000

		mesg プロジェクタライト 椎名まおプロジェクタ右 オフ
		mesg プロジェクタライト 椎名まおプロジェクタ左 オフ

		chara 静止スポットライト設置 椎名まおプロジェクタ \
			-pos 0,-15600,-1300 \
			-dir -154,2048,0 \
			-range 32000 \
			-angle 24 \
			-color 200,200,200 \
			-option 0x0003




		//影判定用
		command 影投影ハザード \
			-name 船倉２ \
			-group 7




#if d:movie
		chara スポットライト背景イメージ指定 テストムービー
#endif





		@プロジェクタ自動チェンジ設定




		//右舷前部でのみつかり防止対策(一番右前の)
		//スクリーンは左、ev006にいる状態で60*40フレームを超えたらチェンジ許可
		trap ev006 d:PLAYER \
			-mask ＊ \
			-exec{

				if($3 == いる && $f:第二船倉プロジェクタ方向 == 1 && $f:見つかり防止スクリーンチェンジ許可した == 0){
					if(!$f:見つかり防止スクリーンチェンジ許可した){
						print '右舷スクリーンの側なので船倉演説イベント中'
						eval($w:船倉演説イベント中 = $w:船倉演説イベント中 + 1)
						chara delay 見つかり防止ディレイ \
							-time (60 * 30) \
							-exec{
								if($f:見つかり防止スクリーンチェンジ許可した){
									eval($w:船倉演説イベント中 = $w:船倉演説イベント中 - 1)
									eval($f:見つかり防止スクリーンチェンジ許可した = 0)
								}
							}
					}
					eval($f:見つかり防止スクリーンチェンジ許可した = 1)


				}else if($3 == 出る){
					mesg delay 見つかり防止ディレイ kill
					if($f:見つかり防止スクリーンチェンジ許可した){
						eval($w:船倉演説イベント中 = $w:船倉演説イベント中 - 1)
						eval($f:見つかり防止スクリーンチェンジ許可した = 0)
					}

				}

			}




		eval($f:w04b_今床下イントルード中 = 0)

		//イントルードではプロジェクタの明暗影響受けないように
		trap ev008 d:PLAYER \
			-mask ？ \
			-exec {
				if($3 == 入る){
					chara フェードインアウト フェードイン \
						-i 0 0 0 d:プロジェクタ暗さ度合い \		//設定するとこのＲＧＢαから始まる
						-c 0 0 0 0 \		//目標のＲＧＢα
						-t 1

					eval($f:w04b_今床下イントルード中 = 1)

				}else{
					eval($f:w04b_今床下イントルード中 = 0)

					if($f:w04b_今暗い){
						chara フェードインアウト フェードアウト \
							-c 0 0 0 d:プロジェクタ暗さ度合い \		//目標のＲＧＢα
							-t 1
					}

				}

			}




	}



	proc プロジェクタ自動チェンジ設定 {

//プロジェクタ左右切り替え処理

		chara delay ディレイ -time 1 -exec{
			if($w:船倉演説イベント中 > 0){
				print '$w:船倉演説イベント中 ='$w:船倉演説イベント中
			}
			return 1
		}

		@プロジェクタ自動チェンジ


		//船倉中央に行こうとすると発生
		trap ev011 d:PLAYER \
			-mask 入る \
			-exec{
				if(`%ゲームオーバーチェック` == 0 && !$f:第二船倉プロジェクタチェンジ見た && !$f:第二船倉プロジェクタチェンジデモカメラ中 && $w:船倉物音カメラフレーム数 == 0){
					@第二船倉プロジェクタチェンジデモカメラ
				}
			}

	}


	proc プロジェクタ自動チェンジ {
		chara delay プロジェクタディレイ -time (60 * 5) -exec{

			if($w:船倉演説イベント中 <= 0 && `%ゲームオーバーチェック` == 0){
				print '$w:船倉演説イベント中 ='$w:船倉演説イベント中
				print 'プロジェクタチェンジ開始しまーす。'

				if(!$f:第二船倉プロジェクタチェンジ見た && $i:プレイヤー初期Ｙ位置 < -15000){
					if(!$f:第二船倉プロジェクタチェンジデモカメラ中 && !$f:ローカルフラグ１){	//$f:ローカルフラグ１は、物音反応のために使用しています。
						@第二船倉プロジェクタチェンジデモカメラ
					}
				}else{
					@第二船倉プロジェクタチェンジ

				}

				return (60 * (20 + `%rand 11`))

			}else{

				print 'プロジェクタチェンジできませ－ン。'
				return 120

			}

		}
	}






	proc 第二船倉プロジェクタチェンジ{

		eval($s:ドッキリ系スタート = 不可)		//首体操・ドッキリ禁止

		chara delay プロジェクタディレイ -time 60 -exec{

			if($f:第二船倉プロジェクタ方向 == 0){
				@第二船倉プロジェクタ左にチェンジ 0

			}else{
				@第二船倉プロジェクタ右にチェンジ 0

			}
		}

	}






	proc 第二船倉プロジェクタ左にチェンジ $:チェンジスピード {

		if(`%ゲームオーバーチェック` == 0){
			print 'プロジェクタ左にチェンジ'

			mesg 船倉兵 SEALS_1 プロジェクタ１止まれ

			mesg 静止スポットライト設置 プロジェクタライト右 off
			mesg プロジェクタライト プロジェクタライト右 オフ

			if($:チェンジスピード == 0){

				@部屋暗くする処理

				chara delay プロジェクタディレイ \
					-time (60 * 3) \
					-exec{
						if(`%ゲームオーバーチェック` == 0){
							eval($f:第二船倉プロジェクタ方向 = 1)

							mesg 船倉兵 SEALS_1 プロジェクタ２動け
							mesg 静止スポットライト設置 プロジェクタライト左 fadein 300
							mesg プロジェクタライト プロジェクタライト左 ゆっくりオン

							@部屋明るくする処理

							if($f:第二船倉プロジェクタチェンジデモカメラ中){
								eval($w:第二船倉兵遅れタイム = 15)
							}else{
								eval($w:第二船倉兵遅れタイム = 60 * 2)
							}

							chara delay プロジェクタディレイ \
								-time $w:第二船倉兵遅れタイム \
								-exec{
									if(`%ゲームオーバーチェック` == 0){
										mesg 船倉兵 SEALS_1 スクリーン２
									}
								}
						}

					}


			}else{
				eval($f:第二船倉プロジェクタ方向 = 1)

				mesg 静止スポットライト設置 プロジェクタライト左 on
				mesg プロジェクタライト プロジェクタライト左 オン

				mesg 船倉兵 SEALS_1 プロジェクタ２動け
				mesg 船倉兵 SEALS_1 スクリーン２

				@部屋明るくする処理

			}

		}


	}




	proc 第二船倉プロジェクタ右にチェンジ $:チェンジスピード {

		if(`%ゲームオーバーチェック` == 0){
			print 'プロジェクタ右にチェンジ'

			mesg 船倉兵 SEALS_1 プロジェクタ２止まれ

			mesg 静止スポットライト設置 プロジェクタライト左 off
			mesg プロジェクタライト プロジェクタライト左 オフ


			if($:チェンジスピード == 0){

				@部屋暗くする処理

				chara delay プロジェクタディレイ \
					-time (60 * 3) \
					-exec{

						if(`%ゲームオーバーチェック` == 0){
							eval($f:第二船倉プロジェクタ方向 = 0)

							mesg 船倉兵 SEALS_1 プロジェクタ１動け
							mesg 静止スポットライト設置 プロジェクタライト右 fadein 300
							mesg プロジェクタライト プロジェクタライト右 ゆっくりオン

							@部屋明るくする処理

							if($f:第二船倉プロジェクタチェンジデモカメラ中){
								eval($w:第二船倉兵遅れタイム = 15)
							}else{
								eval($w:第二船倉兵遅れタイム = 60 * 2)
							}

							chara delay プロジェクタディレイ \
								-time $w:第二船倉兵遅れタイム \
								-exec{
									if(`%ゲームオーバーチェック` == 0){
										mesg 船倉兵 SEALS_1 スクリーン１
									}
								}
						}
				}


			}else{
				eval($f:第二船倉プロジェクタ方向 = 0)

				mesg 静止スポットライト設置 プロジェクタライト右 on
				mesg プロジェクタライト プロジェクタライト右 オン

				mesg 船倉兵 SEALS_1 プロジェクタ１動け
				mesg 船倉兵 SEALS_1 スクリーン１


				@部屋明るくする処理

			}
		}
	}



	proc 部屋暗くする処理 {
		eval($f:w04b_今暗い = 1)
		if($i:カメラＺ位置 > -24000 && !$f:w04b_今床下イントルード中 && (`%ゲームオーバーチェック` == 0) && ($f:ロードチェックＯＮフラグ == 1)){
			chara フェードインアウト フェードアウト \
				-c 0 0 0 d:プロジェクタ暗さ度合い \		//目標のＲＧＢα
				-s 143 \			//プライオリティ
				-t 30
		}
	}


	proc 部屋明るくする処理 {
		eval($f:w04b_今暗い = 0)
		if($i:カメラＺ位置 > -24000 && !$f:w04b_今床下イントルード中 && (`%ゲームオーバーチェック` == 0) && ($f:ロードチェックＯＮフラグ == 1)){
			chara フェードインアウト フェードイン \
				-i 0 0 0 d:プロジェクタ暗さ度合い \		//設定するとこのＲＧＢαから始まる
				-c 0 0 0 0 \		//目標のＲＧＢα
				-s 143 \			//プライオリティ
				-t 30
		}
	}






//###################################################################################
//						プロジェクタチェンジデモカメラ
//###################################################################################


	proc ゲームステータスチェック {

		command ゲットゲームステータス \
			$i:ゲームステータス

		if($i:ゲームステータス & 0x00000001){
			// 発見～危険モードの間
			return 1
		}else{
			return 0
		}
	}


	proc 第二船倉プロジェクタチェンジデモカメラ {

		eval($f:第二船倉プロジェクタチェンジデモカメラ中 = 1)


		command セットタイマーステータス -s d:TMR_WAIT

#if 1
		command シナリオデモ開始
		command 無線設定 -reset
		command メニュー設定 -menu off -gage off -radar off -subwin off
		command パッド操作 -release
		command プレイヤー無敵セット
		//mesg コマンダー 敵兵セット 視界オフ
		mesg コマンダー 敵兵セット 聴力オフ
		@特殊装備解除
		mesg シネマスクリーン シネマ フェードアウト 0
#else
		@シナリオデモ開始処理
#endif

		if($i:プレイヤー位置Ｘ > -1500 && $i:プレイヤー位置Ｘ < 1500){
			if( $i:プレイヤー位置Ｘ < 0){
				mesg プレイヤー d:PLAYER position2 0 -1500
			}else{
				mesg プレイヤー d:PLAYER position2 0 1500
			}
		}


		chara デモキャンセルチェック デモキャンセル \
			-p プロジェクタチェンジデモカメラキャンセル処理

		chara delay チェンジデモカメラディレイ -time 1 -exec{
			if((`%ゲームオーバーチェック` == 0) && (`@ゲームステータスチェック` == 0)){		// 発見～危険モードの間
				return 1
			}else{
				@プロジェクタチェンジデモカメラキャンセル処理
				return 0
			}
		}

		chara カメラ設定 パンカメラ \
			-c 1 \
			-p 312,-12469,-8761 \
			-t 344,-13385,-6871 \
			-a 200 \
			-i 0 0 0 0 \
			-s 1

		chara カメラ設定 パンカメラ \
			-c 1 \
			-p 352,-13619,-6384 \
			-t 384,-14531,-4494 \
			-a 200 \
			-z d:CAMERA_INTERP_CAMERA \ //補完カメラフラグを指定。
			-interp_time 119 \ 			//補完時間を指定
			-s 1


		chara delay チェンジデモカメラディレイ２ -time (120 + 60) -exec{
			@第二船倉プロジェクタチェンジ
		}

		chara delay チェンジデモカメラディレイ２ -time 580 -exec{
			eval($f:第二船倉プロジェクタチェンジデモカメラ中 = 0)
			eval($f:第二船倉プロジェクタチェンジ見た = 1)
			command varsave $f:第二船倉プロジェクタチェンジ見た
		}

		chara delay チェンジデモカメラディレイ -time 120 -exec{

			chara カメラ設定 パンカメラ \
				-c 1 \
				-p -1031,-15672,751 \
				-t -576,-15775,-1292 \
				-a 170 \
				-i 0 0 0 0 \
				-s 1

			chara カメラ設定 パンカメラ \
				-c 1 \
				-p 1003,-14755,1678 \
				-t 741,-14659,-381 \
				-a 170 \
				-z d:CAMERA_INTERP_CAMERA \ //補完カメラフラグを指定。
				-interp_time 219 \ 			//補完時間を指定
				-s 1


			chara delay チェンジデモカメラディレイ -time 220 -exec{
				chara カメラ設定 パンカメラ \
					-c 1 \
					-p -268,-15679,-7128 \
					-t -352,-14337,-13987 \
					-a 170 \
					-i 0 0 0 0 \
					-s 1

				chara カメラ設定 パンカメラ \
					-c 1 \
					-p 500,-15679,-7128 \
					-t -352,-14337,-13987 \
					-a 170 \
					-z d:CAMERA_INTERP_CAMERA \ //補完カメラフラグを指定。
					-interp_time 239 \ 			//補完時間を指定
					-s 1
			}


			chara delay チェンジデモカメラディレイ \
				-time 461 \
				-exec{
					@プロジェクタチェンジデモカメラ終了処理
				}

		}




	}



	proc プロジェクタチェンジデモカメラキャンセル処理 {

		@プロジェクタチェンジデモカメラ終了処理

		mesg delay チェンジデモカメラディレイ kill


	}



	proc プロジェクタチェンジデモカメラ終了処理 {

		@シナリオデモ終了処理

		chara delay キャンセルディレイ -time 2 -exec {
			chara カメラ設定 パンカメラ \
				-s -1
		}

		mesg デモキャンセルチェック デモキャンセル kill

		mesg タイマー タイマー 開始



	}



//###################################################################################
//								子画面設定
//###################################################################################

	proc 子画面設定 {
		chara サブ画面 子画面 \
			-w (512-d:SUB_MARGIN-d:SUB_WIDTH),d:SUB_MARGIN (512-d:SUB_MARGIN),(d:SUB_HEIGHT+d:SUB_MARGIN)
	}



//###################################################################################
//							手動プロジェクタチェンジ
//###################################################################################



	proc 手動プロジェクタチェンジ {
		print '手動プロジェクタチェンジ'

//左舷側から
		trap ev002 d:PLAYER \
			-mask 入る \
			-state d:TRP_STATE_STAND \
			-dir 1024,256 \
			-button d:ACTION_BUTTON \
 			-exec{

				if(!$f:w04b_椎名まおムービー中){
					command パッド操作 -release
					command プレイヤー無敵セット
					mesg コマンダー 敵兵セット 視界オフ

					@プロジェクタチェンジアクション左

					chara delay 手動プロジェクタチェンジディレイ \
						-time 50 \
						-exec {
							@第二船倉プロジェクタ手動チェンジ
						}

					// モーションが長いので途中で終了
					chara delay 手動プロジェクタチェンジディレイ \
						-time 120 \
						-exec {
							if(`%ゲームオーバーチェック` == 0 && !$f:w04b_椎名まおムービー中){
								command 強制モーションキャンセル
								command パッド操作 -cancel
								command プレイヤー無敵解除
								mesg コマンダー 敵兵セット 視界オン
							}
						}
				}

			}






//右舷側から
		trap ev003 d:PLAYER \
			-mask 入る \
			-state d:TRP_STATE_STAND \
			-dir 3072,256 \
			-button d:ACTION_BUTTON \
 			-exec{

				if(!$f:w04b_椎名まおムービー中){

					command パッド操作 -release
					command プレイヤー無敵セット
					mesg コマンダー 敵兵セット 視界オフ

					@プロジェクタチェンジアクション右

					chara delay 手動プロジェクタチェンジディレイ \
						-time 50 \
						-exec {
							@第二船倉プロジェクタ手動チェンジ
						}

					// モーションが長いので途中で終了
					chara delay 手動プロジェクタチェンジディレイ -time 120 -exec {
						if(`%ゲームオーバーチェック` == 0 && !$f:w04b_椎名まおムービー中){
							command 強制モーションキャンセル
							command パッド操作 -cancel
							command プレイヤー無敵解除
							mesg コマンダー 敵兵セット 視界オン
						}
					}
				}

			}






		trap ev004 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_FORCE \
			-dir 1024,256 3072,256 \	//方向指定
			-exec{

				if($3 == 入る){
					print 'プロジェクタチェンジ中なので$w:船倉演説イベント中'
					eval($f:第二船倉プロジェクタチェンジ見た = 1)
					eval($w:船倉演説イベント中 = $w:船倉演説イベント中 + 1)
				}else{
					eval($w:船倉演説イベント中 = $w:船倉演説イベント中 - 1)
				}

				if(!$f:w04b_椎名まおムービー中){
					if($3 == 入る){
						chara カメラ設定 ビヨンドカメラ \
							-c 1 \
							-p 0,-15207,3556 \
							-t 0,-15106,-371 \
							-a 200 \
							-i 0 0 0 0 \
							-s 1
					}else if($3 == 出る){
						chara カメラ設定 ビヨンドカメラ \
							-s -1
					}
				}

			}



	}



	proc プロジェクタチェンジアクション左 {
		mesg プレイヤー d:PLAYER motion \
			d:モーションリスト:sna_non_zap_w04a_w04b \
			1024 \
			1024 \
			0 \
			(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_WEAPON) \
			-1300 -500
	}


	proc プロジェクタチェンジアクション右 {
		mesg プレイヤー d:PLAYER motion \
			d:モーションリスト:sna_non_zap_w04a_w04b \
			3072 \
			3072 \
			0 \
			(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_WEAPON) \
			1400 -500
	}


	proc 第二船倉プロジェクタ手動チェンジ {

		if($b:船倉プロジェクタ手動チェンジ回数 < 100){
			eval($b:船倉プロジェクタ手動チェンジ回数 = $b:船倉プロジェクタ手動チェンジ回数 + 1)
		}

		if(!$f:第二船倉プロジェクタチェンジ見た){
			eval($f:第二船倉プロジェクタチェンジ見た = 1)
			command varsave $f:第二船倉プロジェクタチェンジ見た
		}

		mesg delay プロジェクタディレイ kill

		if($b:船倉プロジェクタ手動チェンジ回数 == 7 && !$f:椎名まおムービー見た){
			eval($f:椎名まおムービー見た = 1)
			command varsave $f:椎名まおムービー見た
			command StreamStopAll

			chara delay ディレイ -time 1 -exec{
				if(`%StreamIsPlay` == 0){
					if(`%ゲームオーバーチェック` == 0){
						//command ゲームオーバー処理開始 -exec {
							@椎名まおムービースタート
						//}
					}
					return 0
				}else{
					return 1
				}
			}

		}else{
			if($b:船倉プロジェクタ手動チェンジ回数 == 7){
				mesg 船倉兵 船倉兵:a1 ルート変更 3 0
			}

			//チェンジタイマーをリセットして呼びなおし
			chara delay ディレイ -time 2 -exec{
				chara delay プロジェクタディレイ -time (60*20) -proc プロジェクタ自動チェンジ
			}

			if($f:第二船倉プロジェクタ方向 == 0){
				@第二船倉プロジェクタ左にチェンジ 1
			}else{
				@第二船倉プロジェクタ右にチェンジ 1
			}

		}



	}







	proc 椎名まおムービースタート {

		eval($w:船倉演説イベント中 = 100)
		eval($f:w04b_椎名まおムービー中 = 1)

		@シナリオデモ開始処理

		eval( $w:武器 = d:武器:素手 )


		mesg 透明壁 プロジェクタ透明壁 off

		mesg delay プロジェクタディレイ kill


		command セットタイマーステータス -s d:TMR_WAIT

		mesg タイマー タイマー 表示切り替え 0

		mesg 船倉兵 SEALS_1 スクリーン１

		mesg プロジェクタライト プロジェクタライト右 オフ
		mesg プロジェクタライト プロジェクタライト左 オフ

		mesg 静止スポットライト設置 プロジェクタライト右 off
		mesg 静止スポットライト設置 プロジェクタライト左 off

		mesg プロジェクタライト 椎名まおプロジェクタ右 オン
		mesg 静止スポットライト設置 椎名まおプロジェクタ on


		chara delay 椎名まおディレイ -time 2 -exec{
			eval( $i:STREAM_MOVIE_ID = `%Stream t:vc070200 -action 椎名まおムービーチェンジ -p 椎名まおムービー終了 -c 1 -ipu` );

			%StreamSetPan $i:STREAM_MOVIE_ID -v 0x20
				// ストリームにパンとボリュームを設定する。
				// pan 0(左)-0x20(中)-0x3F(右), vol 0-0x3F

		}


		chara カメラ設定 ビヨンドカメラ \
			-c 1 \
			-p 0,-15207,3556 \
			-t 0,-15106,-371 \
			-a 200 \
			-i 0 0 0 0 \
			-s 1


	}


	proc 椎名まおムービーチェンジ $:ストリームＩＤ $:話者名 $:アクションコード {

		//まお左登場
		if($:アクションコード == 10){
			print '最初のチェンジ'
			if($i:プレイヤー位置Ｘ > 0){
				@プロジェクタチェンジアクション右
			}else{
				@プロジェクタチェンジアクション左
			}


			chara delay ディレイ -time 60 -exec{
				chara スポットライト投影モデル 椎名まおプロジェクタ \
					-m w04b1_k2 \
					-p 0,0,0

				mesg プロジェクタライト 椎名まおプロジェクタ左 オン

				mesg 船倉兵 SEALS_1 スクリーン２
			}

		//まお右登場
		}else if($:アクションコード == 20){
			if($i:プレイヤー位置Ｘ > 0){
				@プロジェクタチェンジアクション右
			}else{
				@プロジェクタチェンジアクション左
			}

/*
			chara delay ディレイ -time 30 -exec{
				chara カメラ設定 ビヨンドカメラ \
					-c 1 \
					-p 889,-15703,-4295 \
					-t 754,-14739,-8093 \
					-a 200 \
					-i 0 0 0 0 \
					-s 1
			}
*/

			chara delay ディレイ -time 60 -exec{
				mesg 船倉兵 SEALS_1 スクリーン１
			}

		//まお左登場
		}else if($:アクションコード == 30){
			if($i:プレイヤー位置Ｘ > 0){
				@プロジェクタチェンジアクション右
			}else{
				@プロジェクタチェンジアクション左
			}

			chara カメラ設定 ビヨンドカメラ \
				-c 1 \
				-p 0,-15207,3556 \
				-t 0,-15106,-371 \
				-a 200 \
				-i 0 0 0 0 \
				-s 1

			chara delay ディレイ -time 60 -exec{
				mesg 船倉兵 SEALS_1 スクリーン２
			}

		//まお右登場
		}else if($:アクションコード == 40){
			if($i:プレイヤー位置Ｘ > 0){
				@プロジェクタチェンジアクション右
			}else{
				@プロジェクタチェンジアクション左
			}

			chara delay ディレイ -time 60 -exec{
				mesg 船倉兵 SEALS_1 スクリーン１
			}

		//まお左登場
		}else if($:アクションコード == 50){
			if($i:プレイヤー位置Ｘ > 0){
				@プロジェクタチェンジアクション右
			}else{
				@プロジェクタチェンジアクション左
			}

			chara delay ディレイ -time 60 -exec{
				mesg 船倉兵 SEALS_1 スクリーン２
			}

		//まお両側登場
		}else if($:アクションコード == 60){
			if($i:プレイヤー位置Ｘ > 0){
				@プロジェクタチェンジアクション右
			}else{
				@プロジェクタチェンジアクション左
			}

			eval($f:w04b_椎名うろうろ方向 = 0)

			chara delay ディレイ -time 60 -exec{
				if($f:w04b_椎名うろうろ方向 == 0){
					mesg 船倉兵 SEALS_1 スクリーン１
					eval($f:w04b_椎名うろうろ方向 = 1)
				}else{
					mesg 船倉兵 SEALS_1 スクリーン２
					eval($f:w04b_椎名うろうろ方向 = 0)
				}

				return (60 + `%rand 30`)
			}


		//スコット両側登場
		}else if($:アクションコード == 70){
			if($i:プレイヤー位置Ｘ > 0){
				@プロジェクタチェンジアクション右
			}else{
				@プロジェクタチェンジアクション左
			}

			mesg delay ディレイ kill

			chara delay 船倉兵ビックリディレイ -time 90 -exec{
#ifdef JAPANESE
				mesg コマンダー 敵兵セット 視界オフ
				mesg コマンダー 敵兵セット 聴力オフ
#endif
				mesg 船倉兵 SEALS_1 後に銃を向けろ
				chara delay ディレイ -time 60 -exec{
					@椎名まおムービー終了
				}
			}

		}


	}



	proc 椎名まおムービー終了 {
		command ゲームオーバー処理開始 -exec {
			command ゲームオーバー処理終了
		}
	}






//###################################################################################
//									地下はしご設定
//###################################################################################

/*
地下ハッチ移動量
フタ開け
	922,24,941
またぎ移動
	945,16,932

*/

	proc 船倉２西側地下はしご設定{
		print '西側地下はしご設定'

//西側
		chara プットモーションモデル 西側ハッチ \
			-pos -11500,-17000,-3000 \	//$v:配置座標
			-dir 0 \					//$i:方向
			-kms hatch \				//$s:KMSモデル名
			-mar hatch_w04 \			//$s:モーションファイル名
			-number 0 \					//$i:基本モーション番号 ...
			-status	0x0e 				//$w:ステータス
//			-status	0x02 0x04 0x08		//$w:ステータス

				/*ステータスフラグ設定は以下のとおり
					(0x01) モーションの水平移動量を無視
					(0x02) 重力処理無し
					(0x04) 壁アタリ判定無し
					(0x08) メッセージ受信までモーション停止
				*/




//跳弾アタリ追加
		command 追加ＨＺＸグループ登録 \
			-hzx_id 0 \
			-add_id 3



	//地下はしご西・上部用設定
		//----------------------


		//北側から
		trap la302h_left d:PLAYER -mask 入る -button d:ACTION_BUTTON -dir 2048,256 \
			-state d:TRP_STATE_STAND \
			-exec {

				mesg 透明壁 地下ピット西側 on

				@南側から西地下ピットに下りる

			}



		//東側から
		trap la302h_front d:PLAYER -mask 入る -button d:ACTION_BUTTON -dir 3072,256 \
			-state d:TRP_STATE_STAND \
			-exec {

				if( $f:船倉２西側地下ピットふた開いた == 0 ){
					//フタを開けて南側に移動
					mesg プレイヤー d:PLAYER motion \
						d:モーションリスト:sna_non_ladder_hatch_open_c2l \
						3072 \
						-1 \
						0 \
						(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_WEAPON) \
						-10078 -2990 -15970	//x,z,yの順

					mesg プットモーションモデル 西側ハッチ 終了判定 3
					eval( $f:船倉２西側地下ピットふた開いた = 1 )
					@西側ハッチオープン跳弾アタリ変更

				}else{

					//南側に移動
					mesg プレイヤー d:PLAYER motion \
						d:モーションリスト:sna_non_ladder_hatch_c2l \
						3072 \
						-1 \
						0 \
						(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_WEAPON) \
						-10055 -2982 -15970	//x,z,yの順

				}

				mesg 透明壁 地下ピット西側 on

				@南側から西地下ピットに下りる

			}





		//はしご中カメラ
		trap la302_force d:PLAYER -mask ？ -state d:TRP_STATE_FORCE \
			-exec {

				chara カメラ設定 ビヨンドカメラ \
					-c 1 \
					-p -10888,-14175,-2175 \
					-t -11119,-15769,-2794 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3

				if($3 == 入る){
					print '地下ピットハシゴ中なので$w:船倉演説イベント中'
					eval($w:船倉演説イベント中 = $w:船倉演説イベント中 + 1)
				}else{
					eval($w:船倉演説イベント中 = $w:船倉演説イベント中 - 1)
				}

			}

		//はしご影消去
		trap la302_force d:PLAYER -mask いる \
			-state d:TRP_STATE_LADDER,d:TRP_STATE_FORCE \
			-exec {
				mesg プレイヤー d:PLAYER shadow 0
			}
		trap la302_force d:PLAYER -mask いる \
			-state d:TRP_STATE_STAND \
			-exec {
				mesg プレイヤー d:PLAYER shadow 1
			}


	//地下はしご西・下部用設定
		//----------------------

#if d:ピット自動脱出	//w04.hで定義
		//下から自動脱出
		trap la302l d:PLAYER \
			-mask いる \
			-exec{

				if( $4 < -10600 && !$f:船倉２西側地下ピットふた開いた){

					eval( $f:船倉２西側地下ピットふた開いた = 1 )
					@西側ハッチオープン跳弾アタリ変更

					mesg 透明壁 地下ピット西側 on

					//フタ開けて
					mesg プレイヤー d:PLAYER motion \
						d:モーションリスト:sna_non_ladder_open2hatch_l \
						3072 \
						-1 \
						0 \
						(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT | d:FA_NO_WEAPON) \
						-10850 -3000 -18000	//x,z,yの順

					mesg プットモーションモデル 西側ハッチ 終了判定 5

				}

			}
#endif

		trap la302l d:PLAYER -mask 入る -button d:ACTION_BUTTON -dir 3072,256 \
			-state d:TRP_STATE_STAND \
			-exec {

				mesg 透明壁 地下ピット西側 on


				if( $f:船倉２西側地下ピットふた開いた == 0 ){

					//フタ開けて
					mesg プレイヤー d:PLAYER motion \
						d:モーションリスト:sna_non_ladder_open2hatch_l \
						3072 \
						-1 \
						0 \
						(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT | d:FA_NO_WEAPON) \
						-10850 -3000 -18000	//x,z,yの順

					mesg プットモーションモデル 西側ハッチ 終了判定 5
					eval( $f:船倉２西側地下ピットふた開いた = 1 )
					@西側ハッチオープン跳弾アタリ変更

				}else{

					//昇って
					mesg プレイヤー d:PLAYER motion \
						d:モーションリスト:non_ladder_up_c_start \
						3072 \
						-1 \
						0 \
						(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_WEAPON) \
						-10850 -3000 -18470	//x,z,yの順

					//上に到着
					mesg プレイヤー d:PLAYER motion \
						d:モーションリスト:sna_non_ladder_up2hatch_l \
						-1 \
						-1 \
						0 \
						(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT | d:FA_NO_WEAPON)

				}

			}

	}




	proc 南側から西地下ピットに下りる{
//		mesg プレイヤー d:PLAYER position \
//			-11000 -15970 -2050

		if( $f:船倉２西側地下ピットふた開いた == 0 ){


			//フタ開けて
			mesg プレイヤー d:PLAYER motion \
				d:モーションリスト:sna_non_ladder_hatch_open_l \
				2048 \
				-1 \
				0 \
				(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_WEAPON) \
				-11000 -2050 -15970	//x,z,yの順

			//ふた開け連動
			mesg プットモーションモデル 西側ハッチ 終了判定 1
			eval( $f:船倉２西側地下ピットふた開いた = 1 )
			@西側ハッチオープン跳弾アタリ変更

		}

		//降りて
		mesg プレイヤー d:PLAYER motion \
			d:モーションリスト:sna_non_ladder_hatch2down_l \
			2048 \
			-1 \
			0 \
			(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_WEAPON) \
			-11000 -2050 -15970	//x,z,yの順

		//着地
		mesg プレイヤー d:PLAYER motion \
			d:モーションリスト:non_ladder_down_c_end \
			-1 \
			-1 \
			0 \
			(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT | d:FA_NO_WEAPON)

#if d:ピットで自動ホフク
		mesg プレイヤー d:PLAYER stance \
			0 \
			-1 \
			1024 \
			(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT | d:FA_NO_WEAPON)


		mesg プレイヤー d:PLAYER stance \
			2 \
			-1 \
			1024 \
			(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT | d:FA_NO_WEAPON)
#endif


	}





















	proc 船倉２東側地下はしご設定{
		print '東側地下はしご設定'


//東側
		chara プットモーションモデル 東側ハッチ \
			-pos 11500,-17000,-3000 \	//$v:配置座標
			-dir 2048 \					//$i:方向
			-kms hatch \				//$s:KMSモデル名
			-mar hatch_w04 \			//$s:モーションファイル名
			-number 1 \					//$i:基本モーション番号 ...
			-status	0x0e 				//$w:ステータス
//			-status	0x02 0x04 0x08		//$w:ステータス

				/*ステータスフラグ設定は以下のとおり
					(0x01) モーションの水平移動量を無視
					(0x02) 重力処理無し
					(0x04) 壁アタリ判定無し
					(0x08) メッセージ受信までモーション停止
				*/





//跳弾アタリ追加
		command 追加ＨＺＸグループ登録 \
			-hzx_id 0 \
			-add_id 5





	//地下はしご東・上部用設定
		//----------------------


		//南側から
		trap la303h_right d:PLAYER -mask 入る -button d:ACTION_BUTTON -dir 2048,256 \
			-state d:TRP_STATE_STAND \
			-exec {

				mesg 透明壁 地下ピット東側 on

				@南側から東地下ピットに下りる

			}



		//西側から
		trap la303h_front d:PLAYER -mask 入る -button d:ACTION_BUTTON -dir 1024,256 \
			-state d:TRP_STATE_STAND \
			-exec {

				if( $f:船倉２東側地下ピットふた開いた == 0 ){
					//フタを開けて南側に移動
					mesg プレイヤー d:PLAYER motion \
						d:モーションリスト:sna_non_ladder_hatch_open_c2r \
						1024 \
						-1 \
						0 \
						(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_WEAPON) \
						10048 -2990 -15970	//x,z,yの順
//						10000 -3000 -16000	//x,z,yの順

					mesg プットモーションモデル 東側ハッチ 終了判定 2
					eval( $f:船倉２東側地下ピットふた開いた = 1 )
					@東側ハッチオープン跳弾アタリ変更

				}else{

					//南側に移動
					mesg プレイヤー d:PLAYER motion \
						d:モーションリスト:sna_non_ladder_hatch_c2r \
						1024 \
						-1 \
						0 \
						(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_WEAPON) \
						10025 -2982 -15970	//x,z,yの順
//						10000 -3000 -16000	//x,z,yの順

				}

				mesg 透明壁 地下ピット東側 on

				@南側から東地下ピットに下りる

			}






		//はしご中カメラ
		trap la303_force d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_FORCE \
			-exec {
				chara カメラ設定 ビヨンドカメラ \
					-c 1 \
					-p 10888,-14175,-2175 \
					-t 11119,-15769,-2794 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3

				if($3 == 入る){
					print 'ハシゴ中なので$w:船倉演説イベント中 = 1'
					eval($w:船倉演説イベント中 = $w:船倉演説イベント中 + 1)
				}else{
					print '$w:船倉演説イベント中 = 0'
					eval($w:船倉演説イベント中 = $w:船倉演説イベント中 - 1)
				}

			}

		//はしご影消去
		trap la303_force d:PLAYER -mask いる \
			-state d:TRP_STATE_LADDER,d:TRP_STATE_FORCE \
			-exec {
				mesg プレイヤー d:PLAYER shadow 0
			}
		trap la303_force d:PLAYER -mask いる \
			-state d:TRP_STATE_STAND \
			-exec {
				mesg プレイヤー d:PLAYER shadow 1
			}


	//地下はしご東・下部用設定
		//----------------------


#if d:ピット自動脱出
		//下から自動脱出
		trap la303l d:PLAYER \
			-mask いる \
			-exec{

				if( $4 > 10600 && !$f:船倉２東側地下ピットふた開いた){

					eval( $f:船倉２東側地下ピットふた開いた = 1 )
					@東側ハッチオープン跳弾アタリ変更

					mesg 透明壁 地下ピット東側 on

					//フタ開けて
					mesg プレイヤー d:PLAYER motion \
						d:モーションリスト:sna_non_ladder_open2hatch_r \
						1024 \
						-1 \
						0 \
						(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT | d:FA_NO_WEAPON) \
						10850 -3000 -18000	//x,z,yの順

					mesg プットモーションモデル 東側ハッチ 終了判定 4

				}

			}
#endif


		trap la303l d:PLAYER -mask 入る -button d:ACTION_BUTTON -dir 1024,256 \
			-state d:TRP_STATE_STAND \
			-exec {

				mesg 透明壁 地下ピット東側 on

				if( $f:船倉２東側地下ピットふた開いた == 0 ){

					//フタ開けて
					mesg プレイヤー d:PLAYER motion \
						d:モーションリスト:sna_non_ladder_open2hatch_r \
						1024 \
						-1 \
						0 \
						(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT | d:FA_NO_WEAPON) \
						10850 -3000 -18000	//x,z,yの順

					mesg プットモーションモデル 東側ハッチ 終了判定 4
					eval( $f:船倉２東側地下ピットふた開いた = 1 )
					@東側ハッチオープン跳弾アタリ変更

				}else{

					mesg プレイヤー d:PLAYER position \
						10850 -18470 -3000

					//昇って
					mesg プレイヤー d:PLAYER motion \
						d:モーションリスト:non_ladder_up_c_start \
						1024 \
						-1 \
						0 \
						(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_WEAPON) \
						10850 -3000 -18470	//x,z,yの順


					//上に到着
					mesg プレイヤー d:PLAYER motion \
						d:モーションリスト:sna_non_ladder_up2hatch_r \
						-1 \
						-1 \
						0 \
						(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT | d:FA_NO_WEAPON)

				}

			}




	}





	proc 南側から東地下ピットに下りる{
//		mesg プレイヤー d:PLAYER position \
//			11000 -15970 -2050

		if( $f:船倉２東側地下ピットふた開いた == 0 ){


			//フタ開けて
			mesg プレイヤー d:PLAYER motion \
				d:モーションリスト:sna_non_ladder_hatch_open_r \
				2048 \
				-1 \
				0 \
				(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_WEAPON) \
				10970 -2050 -15970	//x,z,yの順

			//ふた開け連動
			mesg プットモーションモデル 東側ハッチ 終了判定 0
			eval( $f:船倉２東側地下ピットふた開いた = 1 )
			@東側ハッチオープン跳弾アタリ変更

		}

		//降りて
		mesg プレイヤー d:PLAYER motion \
			d:モーションリスト:sna_non_ladder_hatch2down_r \
			2048 \
			-1 \
			0 \
			(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_WEAPON) \
			10970 -2050 -15970 	//x,z,yの順

		//着地
		mesg プレイヤー d:PLAYER motion \
			d:モーションリスト:non_ladder_down_c_end \
			-1 \
			-1 \
			0 \
			(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT | d:FA_NO_WEAPON)

#if d:ピットで自動ホフク
		mesg プレイヤー d:PLAYER stance \
			d:FA_END_STAND \
			-1 \
			3072 \
			(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT | d:FA_NO_WEAPON)

		mesg プレイヤー d:PLAYER stance \
			d:FA_END_GROUND \
			-1 \
			3072 \
			(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT | d:FA_NO_WEAPON)
#endif

	}








//本当は開ききってからアタリ追加しなくちゃいけないけど、ここは危険モードないから大丈夫でしょ。
	proc 西側ハッチオープン跳弾アタリ変更 {

		command 追加ＨＺＸグループ削除 \
			-hzx_id 0 \
			-add_id 3

		command 追加ＨＺＸグループ登録 \
			-hzx_id 0 \
			-add_id 4


	}





	proc 東側ハッチオープン跳弾アタリ変更 {

		command 追加ＨＺＸグループ削除 \
			-hzx_id 0 \
			-add_id 5

		command 追加ＨＺＸグループ登録 \
			-hzx_id 0 \
			-add_id 6


	}















//###################################################################################
//									船倉２カメラ設定
//###################################################################################

	// カメラ設定
	// ------------------------------------
	proc カメラ設定 {
		print 'カメラ設定'

		chara カメラ ステージカメラ	-c 0 -l 3 -p 0
		chara カメラ サブカメラ１	-c 0 -l 2 -p 50
		chara カメラ サブカメラ２	-c 0 -l 2 -p 40
		chara カメラ サブカメラ３	-c 0 -l 2 -p 30
		chara カメラ サブカメラ４	-c 0 -l 2 -p 25
		chara カメラ ビヨンドカメラ	-c 0 -l 2 -p 20
		chara カメラ カットインカメラ -c 0 -l 0 -p 40
		chara カメラ クリアリングカメラ	-c 1 -l 2 -p 0

		// デフォルトカメラ

#if 1
		chara カメラ設定 ステージカメラ \
			-c 0 \
			-b -11500,-17000,-80750 11500,-9550,-1000 \
			-l -11500,-17000,-80750 11500,-100,-1100 \
			-r 640,2048,0 \
			-f 7000 \
			-a 200 \
			-i 1 -1 0 0 \
