//###################################################################################
//									海兵隊設定
//###################################################################################

#define	左舷巡回		1
#define	右舷巡回		2


	proc 船倉２海兵隊 {


		if($w:ゲーム設定 <= d:LEVEL_EASY){
			chara 船倉兵 SEALS_1 -a { \
			#include "w04b_seals_matrix.h"		//船倉兵の配列（共通）
			} \
			#include "w04b_seals_param.h"

		}else if($w:ゲーム設定 == d:LEVEL_NORMAL){
			chara 船倉兵 SEALS_1 -a { \
			#include "w04b_seals_matrix.h"		//船倉兵の配列（共通）
			//船倉兵:a0,{0,0,d:右舷巡回},{0,2048,0 },		18,	100, 2, 0x0024 \
			船倉兵:a1,{0,0,d:左舷巡回},{0,2048,0 },		18,	100, 2, 0x0024 \
			} \
			#include "w04b_seals_param.h"
			-j	船倉兵:a1 ドッグタグ_敵兵 [dogtag:dummy] \
					[dogtag:dummy] [dogtag:tnk_w04b_guard_no_01] \
					[dogtag:tnk_w04b_guard_ha_01] [dogtag:tnk_w04b_guard_vh_01] \
				船倉兵:9a ドッグタグ_敵兵 [dogtag:dummy] \
					[dogtag:dummy] [dogtag:tnk_w04b_guard_no_02] \
					[dogtag:tnk_w04b_guard_ha_02] [dogtag:tnk_w04b_guard_vh_02]

		}else{
			chara 船倉兵 SEALS_1 -a { \
			#include "w04b_seals_matrix.h"		//船倉兵の配列（共通）
			船倉兵:a0,{0,0,d:右舷巡回},{0,2048,0 },		18,	100, 2, 0x0024 \
			船倉兵:a1,{0,0,d:左舷巡回},{0,2048,0 },		18,	100, 2, 0x0024 \

			} \
			#include "w04b_seals_param.h"
			-j	船倉兵:a1 ドッグタグ_敵兵 [dogtag:dummy] \
					[dogtag:dummy] [dogtag:tnk_w04b_guard_no_01] \
					[dogtag:tnk_w04b_guard_ha_01] [dogtag:tnk_w04b_guard_vh_01] \
				船倉兵:a0 ドッグタグ_敵兵 [dogtag:dummy] \
					[dogtag:dummy] [dogtag:tnk_w04b_guard_no_02] \
					[dogtag:tnk_w04b_guard_ha_02] [dogtag:tnk_w04b_guard_vh_02]

		}







	}


	proc げろっぱ{
		print 'なんにもねんだよバーカ！！！！'
	}


//チェックの順番としては、ライター発見→最初の一人発見→敵兵発見

//proc 敵兵発見は"w04.h"の中にあります。


	proc プロジェクタ１ {
		if(`%ゲームオーバーチェック` == 0 && $f:ロードチェックＯＮフラグ){
			print 'プロジェクタに映ってもた'

			mesg プレイヤー d:PLAYER stance \
				d:FA_END_STAND \
				-1 \
				-1 \
				d:FA_BOX_EXIST
				//d:FA_NO_INTERP

			chara delay プロジェクタ映った -time 2 -exec{

				command ゲームオーバー処理開始 -load -exec {

					command セットタイマーステータス -s d:TMR_WAIT

					command メニュー設定 \
						-gage off \
						-radar off \
						-subwin off \
						-radio off \
						-pause off


					command 無線設定 -reset

					command パッド操作 \
						-release


					eval($w:船倉演説イベント中 = 100)


					chara カメラ設定 ビヨンドカメラ \
						-c 1 \
						-p 124,-15507,-27 \
						-t 124,-14951,-4373 \
						-a 200 \
						-i 2 -1 0 0 \
						-s 1

					chara delay プロジェクタ映った \
						-time 120 \
						-p 船倉敵兵発見ゲームオーバー

				}
			}
		}
	}

	proc プロジェクタ２ {
		if(`%ゲームオーバーチェック` == 0 && $f:ロードチェックＯＮフラグ){
			print 'プロジェクタに映ってもた'

			mesg プレイヤー d:PLAYER stance \
				d:FA_END_STAND \
				-1 \
				-1 \
				d:FA_BOX_EXIST
				//d:FA_NO_INTERP

			chara delay プロジェクタ映った -time 2 -exec{

				command ゲームオーバー処理開始 -load -exec {
					print 'プロジェクタに映ってもた'

					command セットタイマーステータス -s d:TMR_WAIT

					command メニュー設定 \
						-gage off \
						-radar off \
						-subwin off \
						-radio off \
						-pause off


					command 無線設定 -reset

					command パッド操作 \
						-release


					eval($w:船倉演説イベント中 = 100)


					chara カメラ設定 ビヨンドカメラ \
						-c 1 \
						-p -124,-15507,-27 \
						-t -124,-14951,-4373 \
						-a 200 \
						-i 2 -1 0 0 \
						-s 1

					chara delay プロジェクタ映った \
						-time 300 \
						-p 船倉敵兵発見ゲームオーバー

				}
			}
		}
	}

	proc 船倉２海兵隊セット {
		print '海兵隊セット'

		chara コマンダー 敵兵セット -w 	船倉２海兵隊 \
			-z $i:敵標準麻酔持続 \
			-o $i:敵標準気絶持続 \
			-s (d:ENE_STAGE_CROWD_PEOPLE | d:ENE_STAGE_NO_WC_GOVER) \
			-v [ene_tank_voice:01]
	}

//proc 船倉兵物音反応は"w04.h"の中にあります。


//proc ライターのぞき発見は"w04.h"の中にあります。






//###################################################################################
//							船倉１ライター落とし兵イベント
//###################################################################################

	proc 船倉ライター落とし兵イベント {
		print 'ライター落とし兵イベント'

		//ライター兵影投影
		chara スポットライト投影モデル ライター兵床下投影 \
			-m w04b1_k3 \
			-p 0,0,0


		chara 静止スポットライト設置 ライター兵床下投影 \
			-pos 2500,-11000,-7000 \
			-dir 1024,0,0 \
			-range 30000 \
			-angle 14 \
			-color 70,70,70 \
			-option 0x0003


		chara プロジェクタライト ライター兵床下投影 \
			-p 2500,-11000,-7000 \
			-d 1024,0,0



		chara 静止スポットライト設置 ライター兵床下投影 \
			-pos -2500,-11000,-7000 \
			-dir 1024,0,0 \
			-range 30000 \
			-angle 14 \
			-color 70,70,70 \
			-option 0x0003


		chara プロジェクタライト ライター兵床下投影 \
			-p -2500,-11000,-7000 \
			-d 1024,0,0



		mesg プロジェクタライト ライター兵床下投影 オフ





		//ホフクしてると起動
		trap ev005 d:PLAYER \
			-mask 入る \
			-exec {

				if($w:ライター１目撃チェック == 0){
					eval($w:ライター１目撃チェック = 1)

					if($4 > 0){
						mesg 船倉兵 SEALS_1 ライターを落とせ 船倉兵:74 2500 -17250 -7000
					}else{
						mesg 船倉兵 SEALS_1 ライターを落とせ 船倉兵:71 -2500 -17250 -7000
					}

				}

			}




//ダクトの中ではプロジェクタのムービーをストップ
		trap ev007 d:PLAYER \
			-mask ？ \
			-exec {

				if($3 == 入る){
					if($w:ライター１目撃チェック == 0){
						print 'ライター兵投影オン！！'
						eval($b:ライター落とし兵影あり中 = 1)

						mesg スポットライト背景イメージ指定 テストムービー テクスチャ許可 0
						mesg プロジェクタライト ライター兵床下投影 オン
					}
				}else{
					print 'ライター兵投影オフ！！'
					eval($b:ライター落とし兵影あり中 = 0)

					mesg スポットライト背景イメージ指定 テストムービー テクスチャ許可 1
					mesg プロジェクタライト ライター兵床下投影 オフ

				}

			}




	}



	proc ライター落とし兵音声再生 {
		chara delay ディレイ -time 89 -exec{
			command メニュー設定 -A off		//通信機禁止
			eval($i:落としちまった音声コード = `%Stream t:vc045021 -p 落としちまった終了 -c 0` );
			print '海兵隊員Ｄ「あ、ライターが……あきらめるか……」'
		}
	}




































//###################################################################################
//									船倉２箱設置
//###################################################################################

proc 船倉２箱設置{
	print '箱設置'


//左舷中盤
	chara プットオブジェ 鉄箱１ -m w04_box3 -r 0 0 0 \
		-p -8500 -17000 -9750 -l w04b

	chara プットオブジェ 鉄箱１ -m w04_box3 -r 0 (4096-125) 0 \
		-p -8500 -16000 -9750 -l w04b




	chara プットオブジェ スピーカーボックス -m w04_box -r 0 1024 0 \
		-s 100,120,100 \
		-p -9500 -17000 -15500 -l w04b


	chara プットオブジェ スピーカー -m w04_box2 -r 0 2048 0 \
		-p -5000 -17000 -3000 -l w04b

	chara プットオブジェ スピーカー -m w04_box2 -r 0 2048 0 \
		-p 3000 -17000 -3000 -l w04b


//リモコン
	chara プットオブジェ プロジェクタリモコン -m remocon -r 0 100 0 \
		-s 200,300,200 \
		-p -800 -16000 -400 -l w04b

	chara プットオブジェ プロジェクタリモコン -m remocon -r 0 0 0 \
		-s 200,300,200 \
		-p 800 -16000 -500 -l w04b


}


//###################################################################################
//									ドア設定
//###################################################################################

	// ドアオブジェクト
	// ------------------------------------
	proc ドア設置／通路１－船倉２ {
		print 'ドア設置／通路１－船倉２'

		mesg マップ接合 船倉接合１ on

		chara ドア 右舷ドア１２ \
			-m w04_dr \
			-d 0,2048,0 \
			-p 8750,-17000,50 \
			-slide 1600 \
			-between 船倉２ 通路１\
			-time d:SD_OPEN_TIME

		trap dr200 ？ -mask ？ \
			-exec {
				if ( $3 == 入る ) {
					mesg ドア 右舷ドア１２ open
				}else{
					mesg ドア 右舷ドア１２ close
				}
			}

		chara ドア 右舷ドア１２奥 \
			-m w04_dr \
			-d 0,0,0 \
			-p 7250,-17000,4450 \
			-slide 1600 \
			-time d:SD_OPEN_TIME


		chara ドア 左舷ドア１２ \
			-m w04_dr \
			-d 0,2048,0 \
			-p -7250,-17000,50 \
			-slide 1600 \
			-between 船倉２ 通路１\
			-time d:SD_OPEN_TIME

		trap dr201 ？ -mask ？ \
			-exec {
				if ( $3 == 入る ) {
					mesg ドア 左舷ドア１２ open
				}else{
					mesg ドア 左舷ドア１２ close
				}
			}

		chara ドア 左舷ドア１２奥 \
			-m w04_dr \
			-d 0,0,0 \
			-p -8750,-17000,4450 \
			-slide 1600 \
			-time d:SD_OPEN_TIME


		chara ドア 右舷上部ドア１２ \
			-m w04_dr \
			-d 0,2048,0 \
			-p 11750,-9000,50 \
			-slide 1600 \
			-between 船倉２ 通路１\
			-time d:SD_OPEN_TIME

		trap dr202 ？ -mask ？ \
			-exec {
				if ( $3 == 入る ) {
					mesg ドア 右舷上部ドア１２ open
				}else{
					mesg ドア 右舷上部ドア１２ close
				}


			}

		chara ドア 右舷上部ドア１２奥 \
			-m w04_dr \
			-d 0,0,0 \
			-p 10250,-9000,4450 \
			-slide 1600 \
			-time d:SD_OPEN_TIME


		chara ドア 左舷上部ドア１２ \
			-m w04_dr \
			-d 0,2048,0 \
			-p -10250,-9000,50 \
			-slide 1600 \
			-between 船倉２ 通路１\
			-time d:SD_OPEN_TIME


		trap dr203 ？ -mask ？ \
			-exec {
				if ( $3 == 入る ) {
					mesg ドア 左舷上部ドア１２ open
				}else{
					mesg ドア 左舷上部ドア１２ close
				}
			}

		chara ドア 左舷上部ドア１２奥 \
			-m w04_dr \
			-d 0,0,0 \
			-p -11750,-9000,4450 \
			-slide 1600 \
			-time d:SD_OPEN_TIME


	}

