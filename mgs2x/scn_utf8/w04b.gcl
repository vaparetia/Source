//地下中央
		trap ca300 d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {
					if($6 < -8000){


						if($w:ライター１目撃チェック == 20000){	//ライター落としのときのカメラ

							@CS_スムーズカメラ昇順 $6 -15000 -10000 3603 4096
							eval($i:補完ＲＸ = $i:CS_結果１)

							@CS_スムーズカメラ昇順 $6 -15000 -13000 2110 7000
							eval($w:補完距離 = $i:CS_結果１)

							@CS_スムーズカメラ昇順 $6 -15000 -10000 250 200
							eval($w:補完画角 = $i:CS_結果１)


							if($4 > 0){
								@CS_スムーズカメラ昇順 $4 3000 4000 $i:補完ＲＸ 4096
								eval($i:補完ＲＸ = $i:CS_結果１)

								@CS_スムーズカメラ昇順 $4 3000 4000 $w:補完距離 7000
								eval($w:補完距離 = $i:CS_結果１)

								@CS_スムーズカメラ昇順 $4 3000 4000 $w:補完画角 200
								eval($w:補完画角 = $i:CS_結果１)

								eval( $i:補完ＢＸ１ = 2050 )
								eval( $i:補完ＢＸ２ = 3050 )

							}else{

								@CS_スムーズカメラ昇順 $4 -4000 -3000 4096 $i:補完ＲＸ
								eval($i:補完ＲＸ = $i:CS_結果１)

								@CS_スムーズカメラ昇順 $4 -4000 -3000 7000 $w:補完距離
								eval($w:補完距離 = $i:CS_結果１)

								@CS_スムーズカメラ昇順 $4 -4000 -3000 200 $w:補完画角
								eval($w:補完画角 = $i:CS_結果１)


								eval( $i:補完ＢＸ１ = -3050 )
								eval( $i:補完ＢＸ２ = -2050 )
							}

							chara カメラ設定 サブカメラ１ \
								-c 0 \
								-b $i:補完ＢＸ１,-18900,-80750 $i:補完ＢＸ２,-17250,-6600 \
								-l -32000,-17500,-80750 32000,32000,0 \
								-r $i:補完ＲＸ,2048,0 \
								-f $w:補完距離 \
								-a $w:補完画角 \
								-i 1 3 0 0 \
								-s $3

						}else{

							if($4 > 0){
								eval( $i:補完ＢＸ１ = 2050 )
								eval( $i:補完ＢＸ２ = 3050 )
							}else{
								eval( $i:補完ＢＸ１ = -3050 )
								eval( $i:補完ＢＸ２ = -2050 )
							}


							chara カメラ設定 サブカメラ１ \
								-c 0 \
								-b $i:補完ＢＸ１,-32000,-80750 $i:補完ＢＸ２,-17250,-5500 \
								-l -32000,-17500,-80750 32000,32000,0 \
								-r 640,2048,0 \
								-f 7000 \
								-a 200 \
								-i 2 3 0 0 \
								-s $3


						}


					}else{

