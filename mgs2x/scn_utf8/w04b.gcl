// 調整用Define
// ------------------------------------
#define STAGE_TANKER	1
#define STAGE_W04B		1							//通信機・デジカメ用

#define	PLAYER		スネーク
#define	RADAR		0
#define SCREENSHOT	0
#define KEYBOARD	0
#define SOUND_FG	1
#define SEALS_1_FG	1
#define ENE_T_GOL	1	// タンカー編ゴル兵薬莢
#define MULTI_MODEL	0		/* E3ビデオ用特別仕様(2000.4.8) */
#define PITHOLE		1
#define LD_FADEOUT	1
#define PAN_CAMERA	1
#define STAGE_END	1
#define ピット自動脱出	1
#define ピットで自動ホフク	0
#define debug_timer	0
#define movie		1
#define CTDOWN_TIMER	1
#define	デバッグ演説スタート	0
#define	SUB_CAMERA		1
#define IN_RAIL_HZD	1				//エルード位置補正
#define	AUTO_JUMP	1
#define	GHOST		1
#define	SNEEZE		1
#define	プロジェクタ暗さ度合い	80
#define 船倉最下部天井バウンド		-9560



// include
// ------------------------------------
#include "sna_w04.mh"	//強制モーションリスト
#include "stdch.h"
#include "sload.h"
#include "beyond.h"
#include "jump.h"
#include "sound.h"
