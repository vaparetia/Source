	// アーセナル
	proc アーセナルセット {
		// フェデラルホールステージと同じプリシェードでＯＫ？
//↓↓↓↓↓
//		@フェデラルホールステージ用平環光セット
//↑↑↑↑↑
		chara プットオブジェ アーセナルギア \
			-m w60a_amg -r 0,0,0 \
			-p 0,0,0 -s 1000,1000,1000 \
			-l d:LT2_NAME -f 0x0010

//↓↓↓↓↓
//		@ＮＹ突入ステージの平環光へ戻す

		// 最初はオフしておく
//		mesg プットオブジェ アーセナルギア off
//↑↑↑↑↑
	}

	proc アーセナルオン {
		mesg プットオブジェ アーセナルギア on
	}
	proc アーセナルオフ {
		mesg プットオブジェ アーセナルギア off
	}

