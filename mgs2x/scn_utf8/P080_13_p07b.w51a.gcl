	proc ベラザノ橋セット {
		@ベラザノ橋ハイレゾ版セット
		@ベラザノ橋ノーマルセット
	}

	proc ベラザノ橋ハイレゾ版セット {
	// P001ではローレゾ版を使用している
		chara プットオブジェ ベラザノ橋_w10a_1_hi_reso \
			-m w10a_1_hi_reso -r 0,0,0 -p 0,0,0 \
			-s 1000,1000,1000 -l d:LT2_NAME_100 \
			-f 0x0010
		chara プットオブジェ ベラザノ橋_w10a_2_hi_reso \
			-m w10a_2_hi_reso -r 0,0,0 -p 0,0,0 \
			-s 1000,1000,1000 -l d:LT2_NAME_100 \
			-f 0x0010
		chara プットオブジェ ベラザノ橋_w10a_3_hi_reso \
			-m w10a_3_hi_reso -r 0,0,0 -p 0,0,0 \
			-s 1000,1000,1000 -l d:LT2_NAME_100 \
			-f 0x0010
		chara プットオブジェ ベラザノ橋_w10a_4_hi_reso \
			-m w10a_4_hi_reso -r 0,0,0 -p 0,0,0 \
			-s 1000,1000,1000 -l d:LT2_NAME_100 \
			-f 0x0010
		chara プットオブジェ ベラザノ橋_w10a_7_hi_reso \
			-m w10a_7_hi_reso -r 0,0,0 -p 0,0,0 \
			-s 1000,1000,1000 -l d:LT2_NAME_100 \
			-f 0x0010
	}

	proc ベラザノ橋ノーマルセット {
	// 地面の残り
		chara プットオブジェ ベラザノ橋_w10a_5 \
			-m w10a_5 -r 0,0,0 -p 0,0,0 \
			-s 1000,1000,1000 -l d:LT2_NAME_100 \
			-f 0x0010

	// 橋モデル
		chara プットオブジェ ベラザノ橋_w10a_6 \
			-m w10a_6 -r 0,0,0 -p 0,0,0 \
			-s 1000,1000,1000 -l d:LT2_NAME_100 \
			-f 0x0010

	// これだけ１０倍表示する。
		chara プットオブジェ ベラザノ橋_w10a_8 \
			-m w10a_8 -r 0,0,0 -p 0,0,0 \
			-s 100,100,100 -l d:LT2_NAME_100 \
			-f 0x0010
	}
	proc ベラザノ橋関連オフ {
		mesg プットオブジェ ベラザノ橋_w10a_1_hi_reso off
		mesg プットオブジェ ベラザノ橋_w10a_2_hi_reso off
		mesg プットオブジェ ベラザノ橋_w10a_3_hi_reso off
		mesg プットオブジェ ベラザノ橋_w10a_4_hi_reso off
		mesg プットオブジェ ベラザノ橋_w10a_7_hi_reso off

		mesg プットオブジェ ベラザノ橋_w10a_5 off
		mesg プットオブジェ ベラザノ橋_w10a_6 off
		mesg プットオブジェ ベラザノ橋_w10a_8 off
	}
	proc ベラザノ橋関連オン {
		mesg プットオブジェ ベラザノ橋_w10a_1_hi_reso on
		mesg プットオブジェ ベラザノ橋_w10a_2_hi_reso on
		mesg プットオブジェ ベラザノ橋_w10a_3_hi_reso on
		mesg プットオブジェ ベラザノ橋_w10a_4_hi_reso on
		mesg プットオブジェ ベラザノ橋_w10a_7_hi_reso on

		mesg プットオブジェ ベラザノ橋_w10a_5 on
		mesg プットオブジェ ベラザノ橋_w10a_6 on
		mesg プットオブジェ ベラザノ橋_w10a_8 on
	}

	proc ベラザノ橋マンハッタン切り替え {
		// ベラザノ橋を非表示
		mesg プットオブジェ ベラザノ橋_w10a_1_hi_reso off
		mesg プットオブジェ ベラザノ橋_w10a_2_hi_reso off
		mesg プットオブジェ ベラザノ橋_w10a_3_hi_reso off
		mesg プットオブジェ ベラザノ橋_w10a_4_hi_reso off
		mesg プットオブジェ ベラザノ橋_w10a_7_hi_reso off

		mesg プットオブジェ ベラザノ橋_w10a_5 off
		mesg プットオブジェ ベラザノ橋_w10a_6 off
		mesg プットオブジェ ベラザノ橋_w10a_8 off

		// マンハッタン遠景を表示
		mesg プットオブジェ w60a_1 on
		mesg プットオブジェ w60a_2 on
		mesg プットオブジェ w60a_3 on
		mesg プットオブジェ w60a_4 on
		mesg プットオブジェ w60a_5 on
		mesg プットオブジェ w60a_6 on
		mesg プットオブジェ w60a_8 on

		// マンハッタン壊れ前陸地を表示
		mesg プットオブジェ w60a_7 on
	}

	// 2001/08/09 Uehara Masatoshi 追加
	proc 海面セット {
		chara 巨大海面 seaseasea \
			-mipmap 3 50000 0 \
			-size 400000 400000 \
			-light_enable \
			-tex w10a_sea \
			w10a_sea03_256_alp_ovl \
			w10a_sea03_128_alp_ovl \
			w10a_sea03_64_alp_ovl \
			w10a_sea03_32_alp_ovl \
			-pos 60000,0,-200000
	}
