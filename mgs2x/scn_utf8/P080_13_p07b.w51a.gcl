#include "sea_surface.h"

// 各種スイッチ用define
// ------------------------------------
#define		SCREENSHOT		0		// スクリーンショット
#define		USB_KEY			0		// USBキーボード


// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME			d00a3
#define		LT2_NAME			w61a
#define		LT2_NAME_100		w62a_scale10_am700
//↓↓↓↓↓
//#define		LT2_NAME_W24D		w24d
//↑↑↑↑↑

#if d:PLANT_DEMO_ALL_SKIP
	#define		DEMO_SKIP_ENABLE 1
#else
	#define		DEMO_SKIP_ENABLE 0
#endif

#if d:USB_KEY
	#include "usbkbd.h"
#endif


// マップ設定
// ------------------------------------
chara マップ アーセナルギア上 -h d:HZX_NAME,0 -l d:LT2_NAME_100

command マップ設定 アーセナルギア上 -set {
	// デモ環境かどうか。
	#if d:MGS2_DEMO
chara デモアクトデバッグ demodebug  -i t:test01 -d 'test01' -l   \
			-p ダミープロック \	// 2001/08/09 Uehara Masatoshi
			   ベラザノ橋マンハッタン切り替え
//↓↓↓↓↓
//			-p マンハッタン遠景オフ マンハッタン遠景オン \
//			   マンハッタン壊れ前陸地オフ マンハッタン壊れ前陸地オン \
//			   マンハッタン壊れ後陸地オン \
//			   ベラザノ橋関連オフ ベラザノ橋関連オン \
//			   フェ・ホールオン フェ・ホールオフ \
//			   アーセナルオン アーセナルオフ

		/* デモ班環境では無条件でオフ、って関係ないか？じつは */
//		eval($w:武器弾数Ｒ[d:武器:ブレード] = 0);
//↑↑↑↑↑

	#else
		@ポリデモ再生

	#endif

	@常駐キャラ設定						// stdch.hで定義

	// ステージ、オブジェクト関連
	// ------------------------------------
	// 共通して使用するもの
	@デモ開始時シネマスクリーンセット	// demo_stdproc.hで定義
	@フォグ設定
	@マンハッタン遠景セット
	@マンハッタン壊れ前陸地
	@空セット
	@海面セット		// 2001/08/09 Uehara Masatoshi
	@ベラザノ橋セット
//	@マンハッタン壊れ後陸地
//	@アーセナルセット

//	chara delay ディレイ -time 400 -exec{ @ベラザノ橋マンハッタン切り替え }

//	@フェデラルホールステージセット
} 

//初期マップの表示
command マップ表示 -show アーセナルギア上


// ポリデモ処理
// ------------------------------------
	proc ポリデモ再生 {
		#if d:DEBUG_PRINT
			print 'polydemo_start!!  p_story ='
			print $w:p_story
		#endif

		chara デモキャンセルチェック デモキャンセル \
			-p ポリデモキャンセル

		if($w:p_story == d:ST:P080_13_P08ＡＧ浮上１３ｂポリゴンデモ７ｂ開始) {
//↓↓↓↓↓
			/* p080_05_p03 から p080_28_p12 までのデモ中では、
			ライデンは刀を持たせない。
			ここの前のステージ(w51a)で０にしているが、念のため
			再度０にしておく。
			デモからゲームに戻る際に刀を持たせる（＝装備数を１に
			戻す） */
//			eval($w:武器弾数Ｒ[d:武器:ブレード] = 0);
//↑↑↑↑↑

			/* アーセナル暴走　都市破壊シーン（後半） */

			// デモ特有の変数代入
			eval( $s:d_num = P080_13_p08 );

			@デモモデル差し替え処理
			chara demo デモ再生 \
//				-i t:data_dummy_raiden \
				-i t:p080_13_p08 \
				-p ダミープロック \		// 2001/08/09 Uehara Masatoshi
			       ベラザノ橋マンハッタン切り替え \
//↓↓↓↓↓
//				-p マンハッタン遠景オフ マンハッタン遠景オン \
//				   マンハッタン壊れ前陸地オフ マンハッタン壊れ前陸地オン \
//				   マンハッタン壊れ後陸地オン \
//				   ベラザノ橋関連オフ ベラザノ橋関連オン \
//				   フェ・ホールオン フェ・ホールオフ \
//				   アーセナルオン アーセナルオフ \
//↑↑↑↑↑
				-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
				-next ポリデモ終了
		}
	}


	// 終了proc
	// ------------------------------------
	proc ポリデモ終了 {
		#if d:DEBUG_PRINT
			print 'polydemo_end!!  d_num ='
			print $s:d_num
		#endif

		@デモ終了時シネマスクリーンオフ
		mesg デモキャンセルチェック デモキャンセル kill
		eval( $w:p_story = d:ST:P080_13_P08ＡＧ浮上１３ｂポリゴンデモ７ｂ終了 );
		eval( $w:p_story = d:ST:P080_14_P08ＡＧ浮上１４ポリゴンデモ８開始 );
		chara delay ディレイ -time 1 -exec{ @mv_P080_14_P08_0 }
	}


// 各proc設定
//-------------------------------------------------------------------------------------
// 全マップ共通
	// フォグ
	// ------------------------------------
	proc フォグ設定 {
		#if d:DEBUG_PRINT
			print 'fog_set'
		#endif

		// w60a_scale100 のフォグ値
		chara フォグ 霧\
			-c 35, 40, 41 \
			-n -350000 \
			-f  290000
	}


	// ステージ本体設置
	proc マンハッタン遠景セット {
		// ビル
		chara プットオブジェ w60a_1 \
			-m w60a_1 -r 0,0,0 -p 0,0,0 \
			-s 1000,1000,1000 -l d:LT2_NAME_100 \
			-f 0x0010
		chara プットオブジェ w60a_2 \
			-m w60a_2 -r 0,0,0 -p 0,0,0 \
			-s 1000,1000,1000 -l d:LT2_NAME_100 \
			-f 0x0010
		chara プットオブジェ w60a_3 \
			-m w60a_3 -r 0,0,0 -p 0,0,0 \
			-s 1000,1000,1000 -l d:LT2_NAME_100 \
			-f 0x0010
		chara プットオブジェ w60a_4 \
			-m w60a_4 -r 0,0,0 -p 0,0,0 \
			-s 1000,1000,1000 -l d:LT2_NAME_100 \
			-f 0x0010
		chara プットオブジェ w60a_5 \
			-m w60a_5 -r 0,0,0 -p 0,0,0 \
			-s 1000,1000,1000 -l d:LT2_NAME_100 \
			-f 0x0010
		chara プットオブジェ w60a_6 \
			-m w60a_6 -r 0,0,0 -p 0,0,0 \
			-s 1000,1000,1000 -l d:LT2_NAME_100 \
			-f 0x0010
		chara プットオブジェ w60a_8 \
			-m w60a_8 -r 0,0,0 -p 0,0,0 \
			-s 1000,1000,1000 -l d:LT2_NAME_100 \
			-f 0x0010

		// 最初はオフしておく
		mesg プットオブジェ w60a_1 off
		mesg プットオブジェ w60a_2 off
		mesg プットオブジェ w60a_3 off
		mesg プットオブジェ w60a_4 off
		mesg プットオブジェ w60a_5 off
		mesg プットオブジェ w60a_6 off
		mesg プットオブジェ w60a_8 off
	}

	proc マンハッタン遠景オフ {
		mesg プットオブジェ w60a_1 off
		mesg プットオブジェ w60a_2 off
		mesg プットオブジェ w60a_3 off
		mesg プットオブジェ w60a_4 off
		mesg プットオブジェ w60a_5 off
		mesg プットオブジェ w60a_6 off
		mesg プットオブジェ w60a_8 off
	}
	proc マンハッタン遠景オン {
		mesg プットオブジェ w60a_1 on
		mesg プットオブジェ w60a_2 on
		mesg プットオブジェ w60a_3 on
		mesg プットオブジェ w60a_4 on
		mesg プットオブジェ w60a_5 on
		mesg プットオブジェ w60a_6 on
		mesg プットオブジェ w60a_8 on
	}

	proc マンハッタン壊れ前陸地 {
	// 陸地
		chara プットオブジェ w60a_7 \
			-m w60a_7 -r 0,0,0 -p 0,0,0 \
			-s 1000,1000,1000 -l d:LT2_NAME_100 \
			-f 0x0010
		// 最初はオフしておく
		mesg プットオブジェ w60a_7 off
	}
	proc マンハッタン壊れ前陸地オフ {
		mesg プットオブジェ w60a_7 off
	}
	proc マンハッタン壊れ前陸地オン {
		mesg プットオブジェ w60a_7 on
	}

	proc マンハッタン壊れ後陸地 {
		// 陸地
		chara プットオブジェ vw60a_9 \
			-m vw60a_9 -r 0,0,0 -p 0,0,0 \
			-s 1000,1000,1000 -l d:LT2_NAME_100 \
			-f 0x0010
		// 最初はオフしておく
//		mesg プットオブジェ vw60a_9 on
	}
	proc マンハッタン壊れ後陸地オン {
		mesg プットオブジェ vw60a_9 on
	}

	// w60a というのは小井土さん側で付けている、ＮＹ突入ステージの名前。
	proc 空セット {
		#if d:DEBUG_PRINT
			print 'w60a_sky_wall'
		#endif

		chara 汎用空 空_w60a_sky_wall \
			-c 12 18 22 \
			-pos 0 0 0 \ 
			-f 0 \ // 0
			-l (32*10) \
			-t 0 0 0 0 0 0 \
			-m 2 \
				w60a_sky_wall1 91 65 52 0  0\
				w60a_sky_wall2 157 133 126 0 0
	}

