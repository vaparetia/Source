// 入出トラップ
// ------------------------------------
// このプロック名は予約。
proc ロードプロック {
	if ($s:呼び出しプロック == mv_w01c_w01d_0) {
		@mv_w01c_w01d_0
	} else if ($s:呼び出しプロック == mv_w01c_w01b_0) {
		@mv_w01c_w01b_0
	} else if ($s:呼び出しプロック == mv_w01c_w01b_1) {
		@mv_w01c_w01b_1
	}
}



// 四階へ
proc ロード_四階へ移動 {
	trap ld000 d:PLAYER \
		-mask 入る \
		-exec {
			preseek 'w01d'
			@ステージ終了時処理（ステージ名表示） 900 9000 -19000 2048 mv_w01c_w01d_0 d:DEFAULT_M_TYPE d:wn_船橋四階居住区
			eval($i:w01d_直前のマップ = 3)
	}
}

proc ロード_左舷二階へ移動 {
	trap ld001 d:PLAYER \
		-mask 入る \
		-exec {
			if( $f:ロードチェックＯＮフラグ == 1 ) {
				chara カメラ設定 サブカメラ３ \
					-c 1 \
					-p -10361,10417,-12600 -t -10382,7643,-13825 \
					-r 752,2060,0 -f 3032 \
					-a 160 \
					-i 3 0 0 0 \
					-s 1
				preseek 'w01b'
				@ステージ終了時処理（ステージ名表示） -11250 3000 -9750 0 mv_w01c_w01b_0 d:DEFAULT_M_TYPE d:wn_船橋二階居住区左舷
			}

	}
}

