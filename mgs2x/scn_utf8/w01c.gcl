proc アイテム取得時番号設定 $:ボックス名 {
#if d:DEBUG_PRINT
	print 'item_no_set'
#endif

	if($:ボックス名 == レーション) {
		eval($b:w01c_取得ロード回数[0] = $w:グローバルロード回数);
	} else if ($:ボックス名 == チャフ) {
		eval($b:w01c_取得ロード回数[1] = $w:グローバルロード回数);
	}

#if d:DEBUG_PRINT
	print $:ボックス名
	print $w:グローバルロード回数
#endif
}

proc アイテムセット {
	if( $w:ゲーム設定 <= d:LEVEL_NORMAL ){
		@アイテム再セットチェック $b:w01c_取得ロード回数[0]
		if ($f:再セットフラグ) {
			@レーション_初期設置 レーション 9500 6000 -16250 0	 	// イントルードの中
		}
	}

	@アイテム再セットチェック $b:w01c_取得ロード回数[1]
	if ($f:再セットフラグ) {
		@チャフ_初期設置 チャフ -1500 6200 -18160 0 				// ロッカーの中
	}

print $b:w01c_取得ロード回数[0]
print $b:w01c_取得ロード回数[1]

}

proc 壊れライトセット {
	chara プットスポットライトオブジェ 蛍光灯モデル１ \
		-m w01c_lit1a w01c_lit1b \
		-t 11260,8650,-16050 60 2200 \
		-l w01c \
		-p 11260,8650,-16050
//		-f d:BRK_LGT_SHOWTRGT
	chara プットスポットライトオブジェ 蛍光灯モデル２ \
		-m w01c_lit1a w01c_lit1b \
		-t -11260,8650,-16050 60 2200 \
		-l w01c \
		-p -11260,8650,-16050
//		-f d:BRK_LGT_SHOWTRGT
}

proc 四階への階段前踊り場の壁消去セット {
	chara プットオブジェ 階段前壁 \
		-m w01c_wall \
		-r 0 0 0 \
		-p 0 0 0 \
		-l w01c

	trap ev002 スネーク \
		-mask ＊ \
		-exec {
			if($i:カメラＺ位置 > -12500) {
				if(/*$f:w01d_南端壁存在*/0){
					eval($f:w01c_階段前壁存在 = 0)
					mesg プットオブジェ 階段前壁 off
				}
			} else {
				if(/*!$f:w01d_南端壁存在*/1){
					eval($f:w01c_階段前壁存在 = 1)
					mesg プットオブジェ 階段前壁 on
				}
			}
		}
}

proc 監視カメラセット {
	// 難易度毎に縦視野角と振りを変える
	if ($w:ゲーム設定 == d:LEVEL_VERYEASY) {
		eval($i:振り幅   =   0)
		eval($i:横視野角 = 256)
	} else if ($w:ゲーム設定 == d:LEVEL_EASY) {
		eval($i:振り幅   =   0)
		eval($i:横視野角 = 256)
	} else if ($w:ゲーム設定 == d:LEVEL_NORMAL) {
		eval($i:振り幅   =   0)
		eval($i:横視野角 = 256)
	} else if ($w:ゲーム設定 == d:LEVEL_HARD) {
		eval($i:振り幅   = 256)
		eval($i:横視野角 = 480)
	//} else if ($w:ゲーム設定 == d:LEVEL_EXTREME) {
	} else {
		eval($i:振り幅   = 256)
		eval($i:横視野角 = 480)
	}

	@カメラ再セットチェック $b:w01c_カメラ破壊ロード回数[0]
	if ( $f:再セットフラグ == d:TRUE ) {
		eval( $b:w01c_カメラ破壊フラグ[0] = 0 );
	}

	chara 監視カメラ 監視カメラ中央 \
		-pos -5500 8500 -14500 \
		-rot 400 0 0 \ 				/*ＸＹ値のみ有効*/
		-center 350 0 \
		-dir $i:振り幅 \
		-xran 512 \ 				/*省略可*/
		-yran $i:横視野角 \ 		/*省略可*/
		-i 4000 \					/*省略可*/
		//-status $f:w01c_監視カメラ破壊フラグ \
		-status $b:w01c_カメラ破壊フラグ[0] \
		-exec {
			//eval($f:w01c_監視カメラ破壊フラグ = 1)
			eval( $b:w01c_カメラ破壊ロード回数[0] = $w:グローバルロード回数);
			eval( $b:w01c_カメラ破壊フラグ[0] = $2 );
		}

	chara 鏡面モデル管理 壁面映り込み \
		-pos 0,0,-14500 \
		-axis 2 // Z軸反転
	mesg 鏡面モデル管理 壁面映り込み add 監視カメラ中央

}

