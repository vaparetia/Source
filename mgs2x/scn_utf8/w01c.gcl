		d:wn_船橋三階居住区
}

//===================================

#if 0

	@ボス戦アイテム補給初期化

	@ボス戦アイテム補給フラグリセット

	@ボス戦アイテム補給 1 Ｍ９弾薬 10000 6000 -15550
	@ボス戦アイテム補給 2 ＵＳＰ弾薬 10000 6000 -15550

// init.gclに記述。
proc ボス戦アイテム補給初期化 {
	dim $f:unique_number[20];
}

// 各ボス戦で必ず呼ぶ。
proc ボス戦アイテム補給フラグリセット {
	eval($b:i = 0) ;
	%foreach -repeat 20 -exec {
		eval($f:unique_number[$b:i] = 0);
		eval($b:i = $b:i + 1 );
	}
}

proc ボス戦アイテム補給 $:固有番号 $:アイテム名 $:Ｘ座標 $:Ｙ座標 $:Ｚ座標 {

/*
	$:固有番号		$1
	$:アイテム名	$2
	$:Ｘ座標		$3
	$:Ｙ座標		$4
	$:Ｚ座標		$5
*/

	// 固有番号の代入
	eval($w:u_n = $:固有番号)

	// アイテム情報の代入
	// equip.h 参照
	if($:アイテム名 == Ｍ９弾薬) {
		eval($w:アイテム種別／名称 = d:武器:Ｍ９)
		eval($s:アイテムボックス種類 = handgun_amo_ibox)
		eval($s:アイテムボックスラベル種類 = m92_amo_label)
		eval($w:アイテム種別／種別 = d:アイテム種別:武器弾)

	} else if($:アイテム名 == ＵＳＰ弾薬) {
		eval($w:アイテム種別／名称 = d:武器:ＵＳＰ)
		eval($s:アイテムボックス種類 = handgun_amo_ibox)
		eval($s:アイテムボックスラベル種類 = usp_amo_label)
		eval($w:アイテム種別／種別 = d:アイテム種別:武器弾)

	} else if($:アイテム名 == ソコム弾薬) {
		eval($w:アイテム種別／名称 = d:武器:ソコム)
		eval($s:アイテムボックス種類 = handgun_amo_ibox)
		eval($s:アイテムボックスラベル種類 = scm_amo_label)
		eval($w:アイテム種別／種別 = d:アイテム種別:武器弾)

	} else if($:アイテム名 == ファマス弾薬) {
		eval($w:アイテム種別／名称 = d:武器:ファマス)
		eval($s:アイテムボックス種類 = rifle_amo_ibox)
		eval($s:アイテムボックスラベル種類 = fms_amo_label)
		eval($w:アイテム種別／種別 = d:アイテム種別:武器弾)

	} else if($:アイテム名 == ＰＳＧ１弾薬) {
		eval($w:アイテム種別／名称 = d:武器:ＰＳＧ１)
		eval($s:アイテムボックス種類 = rifle_amo_ibox)
		eval($s:アイテムボックスラベル種類 = psg_amo_label)
		eval($w:アイテム種別／種別 = d:アイテム種別:武器弾)

	} else if($:アイテム名 == ＳＰＰ１Ｍ弾薬) {
		eval($w:アイテム種別／名称 = d:武器:ＳＰＰ１Ｍ)
		eval($s:アイテムボックス種類 = handgun_amo_ibox)
		eval($s:アイテムボックスラベル種類 = spp_amo_label)
		eval($w:アイテム種別／種別 = d:アイテム種別:武器弾)

	} else if($:アイテム名 == ＲＧＢ６弾薬) {
		eval($w:アイテム種別／名称 = d:武器:ＲＧＢ６)
		eval($s:アイテムボックス種類 = launcher_amo_ibox)
		eval($s:アイテムボックスラベル種類 = rgb_amo_label)
		eval($w:アイテム種別／種別 = d:アイテム種別:武器弾)

	} else if($:アイテム名 == ニキータ弾薬) {
		eval($w:アイテム種別／名称 = d:武器:ニキータ)
		eval($s:アイテムボックス種類 = launcher_amo_ibox)
		eval($s:アイテムボックスラベル種類 = nkt_amo_label)
		eval($w:アイテム種別／種別 = d:アイテム種別:武器弾)

	} else if($:アイテム名 == スティンガー弾薬) {
		eval($w:アイテム種別／名称 = d:武器:スティンガー)
		eval($s:アイテムボックス種類 = launcher_amo_ibox)
		eval($s:アイテムボックスラベル種類 = stg_amo_label)
		eval($w:アイテム種別／種別 = d:アイテム種別:武器弾)

	} else if($:アイテム名 == クレイモア) {
		eval($w:アイテム種別／名称 = d:武器:クレイモア)
		eval($s:アイテムボックス種類 = grenade_ibox)
		eval($s:アイテムボックスラベル種類 = clm_label)
		eval($w:アイテム種別／種別 = d:アイテム種別:武器弾)

	} else if($:アイテム名 == Ｃ４) {
		eval($w:アイテム種別／名称 = d:武器:Ｃ４)
		eval($s:アイテムボックス種類 = grenade_ibox)
		eval($s:アイテムボックスラベル種類 = cfr_label)
		eval($w:アイテム種別／種別 = d:アイテム種別:武器弾)

	} else if($:アイテム名 == チャフ) {
		eval($w:アイテム種別／名称 = d:武器:チャフ)
		eval($s:アイテムボックス種類 = grenade_ibox)
		eval($s:アイテムボックスラベル種類 = cgr_label)
		eval($w:アイテム種別／種別 = d:アイテム種別:武器弾)

	} else if($:アイテム名 == スタン) {
		eval($w:アイテム種別／名称 = d:武器:スタン)
		eval($s:アイテムボックス種類 = grenade_ibox)
		eval($s:アイテムボックスラベル種類 = sgr_label)
		eval($w:アイテム種別／種別 = d:アイテム種別:武器弾)

	} else if($:アイテム名 == グレネード) {
		eval($w:アイテム種別／名称 = d:武器:グレネード)
		eval($s:アイテムボックス種類 = grenade_ibox)
		eval($s:アイテムボックスラベル種類 = gre_label )
		eval($w:アイテム種別／種別 = d:アイテム種別:武器弾)

	}

/*
	} else if($:アイテム名 == レーション) {
		eval($w:アイテム種別／名称 = d:アイテム:レーション)
		eval($s:アイテムボックス種類 = ration_ibox)
		eval($s:アイテムボックスラベル種類 = rtn_label)
		eval($w:アイテム種別／種別 = d:アイテム種別:アイテム)

	} else if($:アイテム名 == トライパック) {
		eval($w:アイテム種別／名称 = d:アイテム:トライパック)
		eval($s:アイテムボックス種類 = ration_ibox)
		eval($s:アイテムボックスラベル種類 = trp_label)
		eval($w:アイテム種別／種別 = d:アイテム種別:アイテム)

	} else if($:アイテム名 == 止血剤) {
		eval($w:アイテム種別／名称 = d:アイテム:止血剤)
		eval($s:アイテムボックス種類 = medicine_ibox)
		eval($s:アイテムボックスラベル種類 = sbs_label)
		eval($w:アイテム種別／種別 = d:アイテム種別:アイテム)

	} else if($:アイテム名 == ジアゼパム) {
		eval($w:アイテム種別／名称 = d:アイテム:ジアゼパム)
		eval($s:アイテムボックス種類 = medicine_ibox)
		eval($s:アイテムボックスラベル種類 = dzp_label)
		eval($w:アイテム種別／種別 = d:アイテム種別:アイテム)
	}
*/

	// 初期化
	// （予備）弾薬がステージ上に存在しているかどうかのフラグ。0で存在しない、を示す。
	//eval($f:unique_number[$w:u_n] = 0)

	// 処理
	chara プロック連続実行 アイテム状況監視 \
		-exec {

			if($f:unique_number[$w:u_n] == 0) {
				if($w:武器弾数[$w:アイテム種別／名称] == 0){
					if(`command カメラ視界チェック -camera 0x03 \
						-bound ($:Ｘ座標-50) ($:Ｙ座標-50) ($:Ｚ座標-50) \
							   ($:Ｘ座標+50) ($:Ｙ座標+50) ($:Ｚ座標+50)` == 0){
								chara アイテム アイテムボックス \
									-b 0 \
									-p $:Ｘ座標 $:Ｙ座標 $:Ｚ座標 \
									-k $s:アイテムボックス種類 \
									-l $s:アイテムボックスラベル種類 \
									-f $w:アイテム種別／種別 \
									-i $w:u_n \ // アイテムの固有ID（何か使い道あるか？）
									-n 1 \
									-h 300 \
									-x { $f:unique_number[$w:u_n] = 0) } // アイテム取ったら、存在しなくなったことに。

								// 弾薬がステージ上に出現（存在）しましたよ。の意味。
								eval($f:unique_number[$w:u_n] = 1)

					}
				}
			}

		} \
		-time -1 // 監視はずっと続ける

}

#endif

