// マップ
chara マップ 三階 -k w01c -h w01c -l w01c
chara 天井君 天井 -m w01cr -h 8750 -p 0,0,0  -l w01c


// マップ設定
command マップ設定 \
	三階 -s {
	@常駐キャラ設定
	@サウンドマネージャーセット		// サウンドマネージャー＞敵兵コマンダー＞ＢＧＭマネージャー

	@プレイヤーセット
	@ポーズ時ステージ名表示設定 d:wn_船橋三階居住区

	@敵兵セット
	@敵兵ルートチェンジセット
	@攻撃兵待機ルートチェンジセット
	@ＢＧＭマネージャーセット

	@各種カメラ作成
	@子画面設定

	@デフォルトカメラセット

	@三階カメラ１

	@三階カメラ２

	@三階カメラ３

	@三階カメラ４

	@三階カメラ５

	@三階カメラ６_二階へ（左）

	@三階カメラ７_二階へ（右）
	@三階カメラ８_南端カメラ下張り付き

	@床面映り込みセット
	@シナリオデモキャラセット

#if d:MY_DEBUG
	@ＵＳＢキーボード
	@スクリーンショット使用
#endif

#ifdef d:LOAD
	@ロード_四階へ移動
	@ロード_左舷二階へ移動
	//@ロード_右舷二階へ移動
#endif

	@アイテムセット
	@壊れライトセット
	@四階への階段前踊り場の壁消去セット

	@監視カメラセット

	@消火器セット
	@ロッカーセット
	@５０ｃｍ隙間用透明壁
	@イントルード主観カメラ補正設置

	@タンカーデジカメ写真判定

} // <command マップ設定 三階>の閉じカッコ


