proc 床面映り込みセット {
print '人物映り込み000'
	chara 鏡面モデル管理 床面映り込み \
		-pos 0,6000,0 \
		-axis 1 // Y軸反転

	trap ev100 ？ \
		-mask ？ \
		-exec {
			if($3 == 入る) {
				mesg 鏡面モデル管理 床面映り込み add $2
