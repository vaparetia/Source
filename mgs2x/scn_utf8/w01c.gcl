// 食堂表示
	command マップ表示 -show 三階

// キャラクタ専用ライトセットは、マップのshowより後！！
	@キャラクタ専用ライトセット

// スタート時処理
//	@ロード時フェードイン
if( $s:登場ポイント == w01bから来た三階左舷 ) {
	if( $f:w01c_パッドデモ＿フラグ == 0 && ( $w:アラートモード == 0 ) && !($f:オルガ戦後デモ終了した) ) {
		@ステージ開始時処理（デモ表示） \
			d:LOAD_TYPE:NO_DOOR_TYPE \
			左舷三階 \
			1000 \
			d:DEFAULT_M_TYPE \
			d:wn_船橋三階居住区左舷 \
			w01c_paddemo_1 \
			d:ALL_OFF \
			-9474 7000 -14779 3072 \
			d:P_F_STANCE_STAND

		eval( $f:w01c_パッドデモ＿フラグ = 1 )
		#if d:VAR_SAVE
			command varsave $f:w01c_パッドデモ＿フラグ
		#endif
	}else{
		@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:NO_DOOR_TYPE 左舷三階 1000 d:DEFAULT_M_TYPE d:wn_船橋三階居住区左舷
	}

} else {
	@ステージ開始時処理（ステージ名表示） \
		d:LOAD_TYPE:NO_DOOR_TYPE \
		四階から来た \
		1400 \
