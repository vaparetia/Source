// プレイヤー
// ------------------------------------
proc プレイヤーセット {
print 'player_000'
chara プレイヤー スネーク \
		-m sna_def \
		-a snake \
		-p $i:プレイヤー初期Ｘ位置 $i:プレイヤー初期Ｙ位置 $i:プレイヤー初期Ｚ位置 \
		-d 0,$i:プレイヤー初期方向,0 \
//		-p -11224 6660 -13622 \ // 起動時のぞき込みをするための値。
//		-d 0,3072,0 \ // 起動時のぞき込みをするための値。
		-l 2800 \
		-s 0 \
		-i 0


print 'player_001'
//バンダナ
	chara ロープモデル３ バンダナ１ \
		-n sna_bdn1 \
		-d 1 \
		-y スネーク \
		-z 12 \
		-x 0,60,-90 \
		-m 12 \
		-p 250 \
		-k 350 \
		-o 110 \
		-f 1

print 'player_002'
	chara ロープモデル３ バンダナ２ \
		-n sna_bdn2 \
		-d 1 \
		-y スネーク \
		-z 12 \
		-x 0,50,-90 \
		-m 20 \
		-p 250 \
		-k 350 \
		-o 110 \
		-f 1

	@プレイヤーＬＯＤ設定 d:C_DISTANCE_TYPE 6000
}

// キャラクタ専用ライト関係
proc キャラクタ専用ライトセット{
	chara 環境光 環境光 \
		 -c 60,60,60

	chara 平行光 平行光 \
		 -c 100,100,80 \
		 -d 959,2048,0

	chara フォグ フォグ \
		 -c 40,35,20 \
		 -n 0 \
		 -f 25000
}

/***************************************************************************************************/
// 敵兵
/***************************************************************************************************/

/***************/
// 攻撃兵
	proc 攻撃兵１ {
		if( $s:登場ポイント == w01bから来た三階左舷 ) {
			eval( $b:ローカル変数Ｂ１ = 3 )
		} else {
			eval( $b:ローカル変数Ｂ１ = 8 )
		}

		if( $f:オルガ戦後デモ終了した == 1 ) {
			eval( $b:ローカル変数Ｂ２ = 10 )
		} else {
			eval( $b:ローカル変数Ｂ２ = 5 )
		}

		chara アタッカー 攻撃兵:01 \
			-r $b:ローカル変数Ｂ１ \
			-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
			-l $w:敵標準体力 \
			-h $w:敵標準聴力 \
			-f $w:敵標準気絶 \
			-e 1 \
			-c $b:ローカル変数Ｂ２ \		// 探索ルート
			-q 止血剤_敵兵 15 \
			-d 3700 9000 -15050 三階
	}

	proc 攻撃兵 {
		@攻撃兵１
	}

/***************/
// 警備兵
	proc 警備兵１ $:敵兵名 $:ルート {
		chara 警備兵 $:敵兵名 \
			-r $:ルート -n 0 \
			-d 6000,6000,-13750 三階 \
			-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
			-l $w:敵標準体力 -f $w:敵標準気絶 -h $w:敵標準聴力 \
			-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
			-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
			-j ドッグタグ_敵兵	[ dogtag:dummy ] \
								[ dogtag:dummy ] \
								[ dogtag:tnk_w01c_guard_no_01 ] \
								[ dogtag:tnk_w01c_guard_ha_01 ] \
								[ dogtag:tnk_w01c_guard_vh_01 ]
	}

	proc 警備兵 {
		//if( $w:ゲーム設定 == d:LEVEL_EXTREME ) {
		if( $w:ゲーム設定 >= d:LEVEL_EXTREME ) {
			@警備兵１ 警備兵:01 9
		} else {
			@警備兵１ 警備兵:01 7
		}
	}

proc 警備兵コマンダー {
	chara 警備コマンダー wccomm -e 警備兵
}
proc 攻撃兵コマンダー {
	chara 攻撃コマンダー atcomm -e 攻撃兵
}


// コマンダー危険時音声
resource ghq_area_alert_voice {
	w01c:
		$t{
			t:vc040017, //「了解。応援部隊、船橋三階居住区へ向かえ、左舷を固めろ」
			t:vc040018, //「了解。応援を船橋三階左舷に派遣する。敵を包囲せよ。」
			-2,
			t:vc040019, //「了解。応援部隊、船橋三階の居住区に向かえ。階段を守れ。」
			t:vc04001a, //「了解。バックアップ、船橋三階の階段へ向かえ。敵の前進を阻止せよ！」
			-2,
			t:vc04001b, //「了解。応援部隊、船橋三階へ急行。右舷を固めろ。」
			t:vc04001c, //「了解。増援部隊、船橋三階右舷に向かえ。敵を包囲せよ。」
			-1
		}
	}
// コマンダー警戒時音声
resource ghq_caution_voice {
	w01c:
		$t{
			t:vc040043,	// 「了解。船橋三階居住区に増員。階段を固めろ」
			-2,
			// 連絡が途絶えた時の音声
			t:vc04006c, // 「船橋三階居住区との連絡が途絶えた。」
			-3,
			t:vc040603,
			-1	// 全ての登録終了
		}
	}

proc 敵兵セット {
	if( $f:オルガ戦後デモ終了した && ( $w:ゲーム設定 >= d:LEVEL_NORMAL )) {
		chara コマンダー 敵兵セット \
			-a 攻撃兵コマンダー \
			-w 警備兵コマンダー \
			-m $w:スタートアラートモード \
			-r 200,9000,-14925 三階 \
			-c 200,9000,-14925 三階 \
			-x [ghq_area_alert_voice:w01c] \
			-y [ghq_caution_voice:w01c] \
			-v [ene_tank_voice:01] \	// 警備兵のいるステージ
			-g 1 \
			-b $w:敵標準再発生数 \
			-z $i:敵標準麻酔持続 \
			-h $i:標準警戒時間 \
			-o $i:敵標準気絶持続
	}else{
		chara コマンダー 敵兵セット \
			-a 攻撃兵コマンダー \
			-m $w:スタートアラートモード \
			-r 200,9000,-14925 三階 \
			-c 200,9000,-14925 三階 \
			-x [ghq_area_alert_voice:w01c] \
			-y [ghq_caution_voice:w01c] \
			-v [ene_tank_voice:02] \	// 攻撃兵のみステージ
			-g 1 \
			-b $w:敵標準再発生数 \
			-z $i:敵標準麻酔持続 \
			-h $i:標準警戒時間 \
			-o $i:敵標準気絶持続
	}
}



