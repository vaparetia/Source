// カメラ設定
// ------------------------------------
proc 各種カメラ作成 {
	chara カメラ ステージカメラ	-c 0 -l 3 -p 0
	chara カメラ カットインカメラ -c 0 -l 0 -p 40
	chara カメラ サブカメラ１	-c 0 -l 2 -p 30
	chara カメラ サブカメラ２	-c 0 -l 2 -p 20
	chara カメラ サブカメラ３	-c 0 -l 2 -p 10
}

// 子画面設定
proc 子画面設定 {
	chara サブ画面 子画面
}

// デフォルトカメラ
proc デフォルトカメラセット {
	chara カメラ設定 ステージカメラ \
		-c 0 \
		-b -32000,-32000,-32000 32000,32000,32000 \
		-l -32000,-32000,-32000 32000,32000,32000 \
		-r 640,2048,0 \
		-f 6000 \
		-a 200 \
		-i 1 -1 0 0 \
		-s 1
}

// 各カメラ
//---------------------------------------------------------------
// 四階への階段
proc 三階カメラ１ {
	trap ca000 スネーク \
		-mask ＊ \
		-camera \
		-exec {
/*
			chara カメラ設定 サブカメラ１ \
				-c 1 \
				-p -556,8311,-12636 \
				-t -912,7293,-16089 \
				-a 160 \
				-i 0 -1 0 0 \
				-d 1 \
				-s $3
*/
			@完全補完カメラ $6	-15250 -14500 \
								-772 -293 \
								8609 10486 \
								-10304 -12773 \
								-354 -293 \
								7425 7425 \
								-13913 -13847

			chara カメラ設定 サブカメラ１ \
				-c 1 \
				-p $i:補完ＰＸ $i:補完ＰＹ $i:補完ＰＺ \
				-t $i:補完ＴＸ $i:補完ＴＹ $i:補完ＴＺ \
				-r 205,2048,0 -f 3845 \
				-a 200 \
				-i 2 2 0 0 \
				-s $3
		}
}

// 中央廊下（左右）
proc 三階カメラ２ {
	trap ca001 スネーク \
		-mask ＊ \
		-camera \
		-exec {
			chara カメラ設定 サブカメラ１ \
				-c 0 \
				-b -7700,10486,-12773 7700,10486,-12773 \
				-l -7700,-32000,-13847 7700,32000,-13847 \
				-r 240,2048,0 \
				-f 6000 \
				-a 170 \
				-i 0 -1 0 0 \
				-s $3 \
				-slide 0 30 1000 1000 45 1
		}
}

// 左端の小部屋
proc 三階カメラ３ {
	trap ca004 スネーク \
		-mask ＊ \
		-camera \
		-exec {
			chara カメラ設定 サブカメラ１ \
				-c 1 \
				-p -10361,10417,-12600 -t -10382,7643,-13825 \
				-r 753,2059,0 -f 3032 \
				-a 160 \
				-i 0 -1 0 0 \
				-s $3
	}
}

// 右端の小部屋
proc 三階カメラ４ {
	trap ca005 スネーク \
		-mask ＊ \
		-camera \
		-exec {
			chara カメラ設定 サブカメラ１ \
				-c 1 \
				-p 10361,10417,-12600 -t 10382,7643,-13825 \
				-r 753,2037,0 -f 3032 \
				-a 160 \
				-i 0 -1 0 0 \
				-s $3
		}
}

proc 完全補完カメラ $:比較対象 $:距離小 $:距離大 $:ＰＸ１ $:ＰＸ２ $:ＰＹ１ $:ＰＹ２ $:ＰＺ１ $:ＰＺ２ $:ＴＸ１ $:ＴＸ２ $:ＴＹ１ $:ＴＹ２ $:ＴＺ１ $:ＴＺ２{
	@CS_スムーズカメラ昇順 $:比較対象 $:距離小 $:距離大 $:ＰＸ１ $:ＰＸ２
		eval( $i:補完ＰＸ= $i:CS_結果１ )
	@CS_スムーズカメラ昇順 $:比較対象 $:距離小 $:距離大 $:ＰＹ１ $:ＰＹ２
		eval( $i:補完ＰＹ= $i:CS_結果１ )
	@CS_スムーズカメラ昇順 $:比較対象 $:距離小 $:距離大 $:ＰＺ１ $:ＰＺ２
		eval( $i:補完ＰＺ= $i:CS_結果１ )
	@CS_スムーズカメラ昇順 $:比較対象 $:距離小 $:距離大 $:ＴＸ１ $:ＴＸ２
		eval( $i:補完ＴＸ= $i:CS_結果１ )
	@CS_スムーズカメラ昇順 $:比較対象 $:距離小 $:距離大 $:ＴＹ１ $:ＴＹ２
		eval( $i:補完ＴＹ= $i:CS_結果１ )
	@CS_スムーズカメラ昇順 $:比較対象 $:距離小 $:距離大 $:ＴＺ１ $:ＴＺ２
		eval( $i:補完ＴＺ= $i:CS_結果１ )
}

// 中央の小部屋
proc 三階カメラ５ {
	trap ca006 スネーク \
		-mask ＊ \
		-camera \
		-exec {
			@完全補完カメラ $6	-15250 -14500 \
								-772 -293 \
								8609 10486 \
								-10304 -12773 \
								-354 -293 \
								7425 7425 \
								-13913 -13847

			chara カメラ設定 サブカメラ１ \
				-c 1 \
				-p $i:補完ＰＸ $i:補完ＰＹ $i:補完ＰＺ \
				-t $i:補完ＴＸ $i:補完ＴＹ $i:補完ＴＺ \
				-r 205,2048,0 -f 3845 \
				-a 200 \
				-i 2 2 0 0 \
				-s $3
		}
}

// 二階への階段（左）
proc 三階カメラ６_二階へ（左） {
	trap ca002 スネーク \
		-mask ＊ \
		-camera \
		-exec {
			#if 1
				@CS_スムーズカメラ昇順 $6 -14824 -13545 10450 10511

				eval($i:補完ＰＹ = $i:CS_結果１)

				chara カメラ設定 サブカメラ１ \
					-c 0 \
					-b -10396,$i:補完ＰＹ,-13530 -10396,$i:補完ＰＹ,-13530 \
					-l -10396,7553,-14824 -10396,7553,-13545 \
					-a 170 \
					-i 0 -1 0 0 \
					-s $3
			#else
					chara カメラ設定 サブカメラ１ \
						-c 1 \
						-p -11338,9000,-14492 \
						-t -11200,6950,-13243 \
						-a 170 \
						-i 0 -1 0 0 \
						-s $3
			#endif
		}
}

