// サウンド
// ------------------------------------
proc サウンドマネージャーセット {
#if d:SOUND
	chara サウンドマネージャー ＳＤマネ -pak 0

	@サウンド効果音設定

	command 弾痕ノーマル -n 0
	command 弾痕ノーマル -n 1
	command 弾痕ノーマル -n 2
	command 弾痕ノーマル -n 3
	command 弾痕ノーマル -n 4

	command 跳弾ノーマル -n 0
	command 跳弾ノーマル -n 1
	command 跳弾ノーマル -n 2
	command 跳弾ノーマル -n 3
	command 跳弾ノーマル -n 4

	// 水蒸気の番号設定
	command 弾痕ノーマル -n 5
	command 弾痕ノーマル -n 6
	command 弾痕ノーマル -n 7
	command 跳弾水蒸気小 -n 5
	command 跳弾水蒸気中 -n 6
	command 跳弾水蒸気大 -n 7

#endif
}

proc ＢＧＭマネージャーセット {
	chara ＢＧＭマネージャー ＢＧＭ
	//-s $i:ステータス
}

proc ５０ｃｍ隙間用透明壁 {

	@東西５０ｃｍ幅透明壁設置 ５０ｃｍ隙間壁 11375 6000 -15000 2000

