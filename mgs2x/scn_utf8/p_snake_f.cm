//	detector in Strut F.

/*地雷探知機ならＦ脚にあるはずだ。*/
//dv}//v
}//d

//一回目のみ t //e
resource PS_地雷探知器のありか３__f {
//vox t:vc210051 {
ライデン_000: {
Comment le sais-tu ?
}
//	<<<ENGLISH>>>
//	How do you know?

/*なぜわかる？*/
プリスキン_001: {
Il suffit de r&'efl&'echir. Eux non plus ne
voient pas ces mines Claymore,
m&^eme s'ils les ont pos&'ees.
}
//	<<<ENGLISH>>>
//	Use your head. They can't see those
//	Claymore mines either, even if they
//	did the planting.

//<ページ数変更>
プリスキン_001_1: {
Ils leur faut donc un d&'etecteur de mines.
}
//	<<<ENGLISH>>>
//	So they need to keep a
//	mine detector handy.

/*考えてみろ。クレイモアを仕掛けた
奴らも地雷が見えないんだ。探知機を
そばにおいておくに違いない。
*/
ライデン_002: {
Je n'y aurais pas pens&'e. Tu as raison.
}
//	<<<ENGLISH>>>
//	I wouldn't have thought
//	of that. You're right.

/*凄い読みだな。*/
プリスキン_003: {
Ils ne vous l'ont sans doute pas appris
pendant votre formation en RV,
}
//	<<<ENGLISH>>>
//	I don't think they taught you
//	this in all that VR training,
//<ページ数変更>
プリスキン_003_1: {
mais l'intuition aussi &~qa compte au combat
}
//	<<<ENGLISH>>>
//	but intuition counts for
//	something in battle.
//<ページ数変更>
プリスキン_003_2: {
pour d&'etecter le danger. Tu piges ?
}
//	<<<ENGLISH>>>
//	Use your wits and senses to
//	detect the danger. Got it?

/*ＶＲ訓練では教わっていないようだが、
戦場では勘が大切なんだ。理屈ではなく、
全神経で危険を感じ取れ。いいな。
*/
//dv}//v
}//d

