*/
オタコン_001: {
Avec une vitesse de tir de 3 800 balles
par minute,
}
//	<<<ENGLISH>>>
//	With a firing speed of 3,800
//	rounds per minute,
//<ページ数変更>
オタコン_001_1: {
les balles partent &`a une vitesse initiale
de plus de 1 000 m&`etres par seconde.
}
//	<<<ENGLISH>>>
//	rounds are launched at an initial
//	velocity of over 1,000 meters per
