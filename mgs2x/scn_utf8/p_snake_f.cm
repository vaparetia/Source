}
//	<<<ENGLISH>>>
//	How much longer is this
//	guy going to sleep...?

/*いつまで寝てるつもりだ……？*/
//dv}//v
}//d
//寝ているつっこみ h //e
resource PS_寝ている４__f {
//vox t:vc210231 {
ライデン_000: {
J'aimerais bien &^etre aussi cool...
}
//	<<<ENGLISH>>>
//	Wish I were that relaxed...

/*呑気なものだ……。*/
//dv}//v
}//d
//寝ているつっこみ h //e
