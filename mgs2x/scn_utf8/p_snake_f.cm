*/
//dv}//v
}//d
//一回目のみ t //e
resource PS_シェル２中央棟＿水中機雷２__f {
//vox t:vc210121 {
ライデン_000: {
Pourquoi y aurait-il une mine ici ?
}
//	<<<ENGLISH>>>
//	Why would there be a mine here?

/*なぜこんなところに水中機雷があるんだ？*/
プリスキン_001: {
Parce que quelqu'un en a pos&'e une.
}
//	<<<ENGLISH>>>
//	Because someone planted one.

/*誰かが仕掛けたからだろう。*/
オタコン_002: {
Et ce type qui courait sur l'eau ?
C'&'etait peut-&^etre lui.
}
//	<<<ENGLISH>>>
//	What about that guy who was
//	running on water? Could have
//	been him.

/*あいつじゃないか？
水面を走っていた男……。*/
プリスキン_003: {
Regarde bien derri&`ere toi.
Il est peut-&^etre l&`a en embuscade.
}
//	<<<ENGLISH>>>
//	You'd better watch your back.
//	He may be waiting to ambush.

/*気をつけたほうがいいな。
待ち伏せしているかもしれん。*/
ライデン_004: {
D'accord...
}
//	<<<ENGLISH>>>
//	OK...

/*……ああ……。*/
//dv}//v
}//d
