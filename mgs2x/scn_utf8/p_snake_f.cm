}//d

//カサッカ死亡寸前１ h //e
resource PS_ハリアー戦＿カサッカ死亡寸前１__f {
//vox t:vc210701 {
プリスキン_000: {
Raiden, &~qa pourrait aller mieux ici.
Ce serait le moment de se d&'ebarrasser
de ce Harrier.
}
//	<<<ENGLISH>>>
//	Raiden, we're not doing so well up
