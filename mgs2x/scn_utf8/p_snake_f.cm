*/
プリスキン_001: {
Ces lunettes ont une r&'esolution de plus
de 400 000 pixels
}
//	<<<ENGLISH>>>
//	The goggles have a resolution
//	of over 400,000 pixels,
//<ページ数変更>
プリスキン_001_1: {
et un diff&'erentiel thermique de bruit
&'equivalent inf&'erieur &`a 0,05℃.
}
