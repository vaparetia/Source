/*ライデン、こっちはかなり危ない状況だ。
早くハリアーを落としてくれ。*/
//dv}//v
}//d
//カサッカ死亡寸前２ h //e
resource PS_ハリアー戦＿カサッカ死亡寸前２__f {
//vox t:vc210711 {
ライデン_000: {
&~Qa va vous deux !?
}
//	<<<ENGLISH>>>
//	Are you two all right!?

/*大丈夫か！？*/
プリスキン_001: {
D&'esol&'e, Raiden, mais &`a moins que tu
