覚えておけ。
*/
//dv}//v
}//d
resource PS_センサーＢ２__f {
//vox t:vc212661 {
プリスキン_000: {
Ce d&'etecteur est r&'egl&'e pour d&'etecter
uniquement le C4 employ&'e par Fatman .
}
//	<<<ENGLISH>>>
//	This sensor is adjusted to respond
//	only to the C4 used by Fatman.

/*このセンサーはファットマンの使う
