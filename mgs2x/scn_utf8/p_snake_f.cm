//<ページ数変更>
プリスキン_000_1: {
de s&'ecurit&'e sp&'eciale du Pr&'esident.
}
//	<<<ENGLISH>>>
//	are the President's special
//	security unit.

/*敵に見つかると駆けつけてくる
増援部隊は元大統領警護隊の連中だ。
*/
プリスキン_001: {
C'est la cr&`eme des Services Secrets
et ils ont d&'ej&`a servi dans le CAT,
}
//	<<<ENGLISH>>>
//	They are the cream of the Secret
//	Service, and have previously served
