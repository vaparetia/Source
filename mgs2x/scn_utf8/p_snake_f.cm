*/
プリスキン_002: {
Tu peux &'egalement sauter pour enjamber
des lattes de plancher qui craquent.
}
//	<<<ENGLISH>>>
//	You can also jump over any
//	floorboards that creak every
//	time you take a step.

/*歩くと足音が鳴る床を飛び越すのにも
使えるだろう。
*/
//dv}//v
}//d
