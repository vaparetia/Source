Il doit y avoir un d&'etecteur de mines
au niveau B1 de l'Etai E.
}
//	<<<ENGLISH(2)>>>
//	There should be a mine detector
//	on Floor B1 of Strut E.

/*地雷探知機ならＥ脚のＢ１にあるはずだ。*/
//dv}//v
}//d
resource PS_地雷探知器のありか２＿２__f {
//vox t:vc210031 {
プリスキン_000: {
Il doit y avoir un d&'etecteur de mines
au 1er &'etage de l'Etai E.
}
//	<<<ENGLISH(2)>>>
//	There should be a mine detector
//	on the first floor of Strut E.

/*地雷探知機ならＥ脚の１Ｆにあるはずだ。*/
//dv}//v
}//d
resource PS_地雷探知器のありか２＿３__f {
//vox t:vc210041 {
プリスキン_000: {
Il doit y avoir un d&'etecteur de mines
dans l'Etai F.
}
//	<<<ENGLISH>>>
