//dv}//v
}//d
//二回目以降 t //e
resource PS_サイファー２__f {
//vox t:vc211841 {
プリスキン_000: {
Tu peux fausser les d&'etecteurs du Cypher
avec des particules m&'etalliques.
}
//	<<<ENGLISH>>>
//	You can confuse the Cypher's
//	sensors with chaff.
//<ページ数変更>
プリスキン_000_1: {
Cela l'immobilisera et emp&^echera
la transmission de donn&'ees au contr&^oleur.
}
//	<<<ENGLISH>>>
//	This not only blocks its movement,
//	but also prevents data transmission
//	to its controller.

/*チャフを使えばサイファーのセンサーを
