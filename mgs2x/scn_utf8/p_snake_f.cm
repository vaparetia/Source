//★P012_02_R01フォーチュン遭遇２無線デモ１終了＜フラグ＜P014_01_P01ピーター遭遇１ポリゴンデモ１開始 d //e
//寝ている間に通信した場合 h //e
resource PS_寝ている間に通信した__f {
//vox t:vc210241 {
ライデン_000: {
Bonjour, Lieutenant J.G. Pliskin.
Tu as bien dormi ?
}
//	<<<ENGLISH>>>
//	Good morning, Lieutenant J.G.
//	Pliskin. Did you sleep well?

/*おはよう、プリスキン中尉。
良いお目覚めで。*/
プリスキン_001: {
Ouais, merci. Super.
Je me sens vraiment mieux.
}
//	<<<ENGLISH>>>
//	Yeah, thank you. I'm good,
//	feeling much better.

/*ああ……。ありがとう。
体調も戻った。
もう大丈夫だ。*/
//dv}//v
}//d



//フォーチュンの設定 h //e
resource PS_フォーチュン＿死なない__f {
//vox t:vc210251 {
ライデン_000: {
Ne va-t-elle donc pas mourir ?
}
//	<<<ENGLISH>>>
//	Why won't that woman die?

/*あの女、なぜ死なない？*/
プリスキン_001: {
Elle n'attend que &~qa - la mort. Elle
l'accueillerait &`a bras ouverts si elle
venait la lib&'erer.
}
//	<<<ENGLISH>>>
//	She yearns for death. She would
//	welcome it with open arms if it
//	came to set her free.

/*あの女は死を歓迎している。
死が自分を開放しにくる時を
待ち望んでいるんだ。*/
プリスキン_002: {
Ceux qui n'ont pas peur de la mort
finissent par y &'echapper.
}
//	<<<ENGLISH>>>
//	People who have no fear of
//	death end up eluding it.
//<ページ数変更>
プリスキン_002_1: {
Mais plus tu as peur de la mort,
plus tu la fr&^oles de pr&`es.
}
//	<<<ENGLISH>>>
//	And the more terrified you are of
//	dying, the closer you find yourself
//	to it.

/*死への恐怖がない人間程、生へ近づく。
死を恐れれば、それだけ死に近づく。
*/
//dv}//v
}//d


//眠りプリスキンを殴っている場合 h //e
resource PS_睡眠中殴られた１__f {
//vox t:vc210261 {
プリスキン_000: {
Dis, pendant que je dormais,
tout de suite... tu...
}
//	<<<ENGLISH>>>
//	While I was sleeping just
//	now -- Did you --

/*お前……さっき俺が休んでる間……。*/
ライデン_001: {
Comment... !?
}
//	<<<ENGLISH>>>
//	Uh -- !?

/*え！？*/
プリスキン_002: {
Hum. Non, rien.
}
//	<<<ENGLISH>>>
//	Hmph. Forget it.

/*ふん。まあいい。*/
ライデン_003: {
...
}
//	<<<ENGLISH>>>
//	Whew...

/*……。（ほっ）*/
//dv}//v
}//d


//★P014_16_G01ピーター遭遇１６ゲーム１終了＜フラグ＜P015_01_R1爆弾解体最初の一つ１無線デモ１開始 d //e
//爆弾解体ヒント１ h //e
resource PS_爆弾解体中＿敵排除のススメ１＿１__f {
//vox t:vc210271 {
プリスキン_000: {
Ne t'excite pas, Raiden. Il vaut mieux se
d&'ebarrasser de l'ennemi en premier puis
chercher la bombe.
}
//	<<<ENGLISH>>>
//	Raiden, don't get yourself worked
//	up. It's safer to take out the enemy
//	first, then look for the bomb.

/*ライデン、焦るんじゃないぞ。
先に敵を倒してそれから爆弾を
探す方が安全だ。*/
//dv}//v
}//d

resource PS_爆弾解体中＿敵排除のススメ１＿２__f {
//vox t:vc210281 {
プリスキン_000: {
Et ne songe pas &`a chercher la bombe en
regardant par dessus ton &'epaule pour voir
si l'ennemi suit.
}
//	<<<ENGLISH>>>
//	Don't even think about searching
//	for the bomb while looking over
//	your shoulder for the enemy.

/*敵を警戒しながら、爆弾を探す
なんてことは考えない方がいい。*/
プリスキン_001: {
Commence par les assommer ou
descends-les directement.
}
//	<<<ENGLISH>>>
//	Knock them unconscious or
//	take them out altogether first.

/*敵を眠らせるなり、倒すなりして、
排除しておくんだ。*/
//dv}//v
}//d

//爆弾解体ヒント２ h //e
resource PS_爆弾解体中＿敵排除のススメ２__f {
//vox t:vc210291 {
プリスキン_000: {
On dirait que des sentinelles ennemies
couvrent le p&'erim&`etre de d&'efense de
chaque &'etai.
}
//	<<<ENGLISH>>>
//	Looks like the enemy sentries have
//	the defensive perimeters of each
//	strut covered.

/*敵の見張りは各脚の守備範囲を
受け持っているようだ。*/
プリスキン_001: {
Tu ne risques rien tant qu'ils ne
demandent pas de renforts par radio,
mais si on te remarque, file.
}
//	<<<ENGLISH>>>
//	You'll be safe as long as they
//	don't radio for more men, but
//	if you're spotted, run for it.
//<ページ数変更>
プリスキン_001_1: {
Cache-toi et attends que les renforts
partent.
}
//	<<<ENGLISH>>>
//	Find a good concealment and
//	wait until the backup leaves.

/*無線連絡されない限り安全だが、
発見されたらすぐに逃げろ。どこかに
身を潜めて、増援部隊をやり過ごすんだ。
*/
プリスキン_002: {
Crois-moi, tu ne pourras pas d&'esamorcer
de bombe tant que tu les auras &`a tes
trousses.
}
//	<<<ENGLISH>>>
//	You won't be able to defuse the
//	bombs while you're being chased
//	down, believe me.

/*敵に追われながら爆弾を処理するなんて
お前には無理な話だろう。*/
//dv}//v
}//d


//爆弾解体催促 h //e
resource PS_爆弾解体中＿催促１__f {
//vox t:vc210301 {
プリスキン_000: {
Une premi&`ere bombe de faite, Raiden.
Et toi, o&`u en es-tu ?
}
//	<<<ENGLISH>>>
//	Raiden, I've frozen the first
//	bomb. How are you doing?

/*ライデン、１つ目の爆弾を凍結した！
そっちは？*/
ライデン_001: {
Rien pour le moment...
}
//	<<<ENGLISH>>>
//	Nothing yet...

/*まだだ……。*/
ピーター_002: {
Pliskin, o&`u se trouvait l'explosif
exactement ?
}
//	<<<ENGLISH>>>
//	Pliskin, what was the exact
//	location of the explosive?

/*プリスキン、爆弾の設置されていた
状況を教えてくれ。*/
プリスキン_003: {
L'h&'eliport. Derri&`ere des
marchandises.
}
//	<<<ENGLISH(2)>>>
//	The heliport on Strut H.
//	It was behind some cargo.
//<ページ数変更>
プリスキン_003_1: {
Je pensais que j'aurais des ennuis avec
les patrouilles, mais &~qa s'est fait tout seul.
}
//	<<<ENGLISH>>>
//	Thought I was going to have
//	some trouble with the patrols,
//	but it was an easy job.

/*Ｈ脚のヘリポート。荷物の影に
仕掛けられていた。
見張りが厄介だったが、楽勝だった。
*/
ピーター_004: {
Je vois...
}
//	<<<ENGLISH>>>
//	I see...

/*そうか……。（なにかおかしい）*/
プリスキン_005: {
Qu'est-ce qu'il y a ?
}
//	<<<ENGLISH(2)>>>
//	What's the matter?

/*どうかしたのか？*/
ピーター_006: {
Rien, rien. Pliskin,
reste vigilant, c'est tout.
}
//	<<<ENGLISH>>>
//	Nothing, really. Pliskin, just
//	don't let your guard down.
//<ページ数変更>
ピーター_006_1: {
Ne baisse pas la garde m&^eme quand tu
penses avoir d&'esamorc&'e l'explosif.
}
//	<<<ENGLISH>>>
//	Don't relax even after you
//	think you've defused it.

/*
いや。なんでもない。
プリスキン、気を抜くなよ。
解体後の安心感は禁物だ。
*/
プリスキン_007: {
Je sais.
Raiden, la Shell 1 est toute &`a toi.
}
//	<<<ENGLISH>>>
//	I know that. Raiden,
//	Shell 1's all yours.

/*わかってる。
ライデン、シェル１を頼むぞ。*/
ライデン_008: {
Bien s&^ur...
}
//	<<<ENGLISH>>>
//	Sure...

/*ああ……。*/
//dv}//v
}//d


