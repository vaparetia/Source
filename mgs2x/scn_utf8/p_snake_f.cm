//ＤＧ連絡橋以外 h //e
resource PS_ＤＧ連絡橋以外__f {
//vox t:vc210511 {
プリスキン_000: {
Pour acc&'eder &`a la Shell 2, tu devras
d&'esactiver les capteurs &`a infrarouge
sur la passerelle  entre
}
//	<<<ENGLISH>>>
//	In order to get to Shell 2, you'll
//	have to disable the IR sensors
//	on the connecting bridge＃－
//<ページ数変更>
プリスキン_000_1: {
les Shell 1 et 2.
}
//	<<<ENGLISH>>>
//	between Shells 1 and 2.

/*シェル２に渡るにはシェル１シェル２
連絡橋の赤外線センサーを無効にする
しかない。
*/
//dv}//v
}//d
//ＰＳＧ１ある場合 t //e
resource PS_ＤＧ連絡橋以外＿ＰＳＧ１ある__f {
