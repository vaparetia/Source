/*急いでくれ。*/
//dv}//v
}//d


//ストーリー依存 d //e
//★P010_10_P05ヴァンプ遭遇１０ポリゴンデモ５終了＜フラグ＜P012_01_P01フォーチュン遭遇１ポリゴンデモ１開始 d //e
