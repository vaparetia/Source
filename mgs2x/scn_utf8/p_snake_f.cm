/*海鳥の影に制御装置が隠れているんじゃ
ないか？海鳥をどかすんだ。まわりに
何発か撃ち込んでみろ。
*/
//dv}//v
}//d

//旗の後ろ h //e
resource PS_ＤＧ連絡橋＿旗ヒント__f {
//vox t:vc210581 {
プリスキン_000: {
Je crois avoir vu un drapeau par l&`a.
Il flottait dans une nouvelle direction
d&`es que le vent tournait...
}
//	<<<ENGLISH>>>
//	I remember seeing a flag there.
//	It kept whipping in different
//	directions as the wind changed...

/*そういえば、旗が立ってたのを
憶えている。風向きによってなびく
方向が変わったな……。*/
//dv}//v
}//d
resource PS_ＤＧ連絡橋＿旗ズパリ１__f {
//vox t:vc210591 {
プリスキン_000: {
Regarde bien derri&`ere le drapeau.
Tu devrais voir une unit&'e de commande.
}
//	<<<ENGLISH>>>
//	Take a careful look behind the flag,
//	and you should see a control unit.

/*旗の後ろをよく見るんだ。
制御装置が隠れているぞ。*/
//dv}//v
}//d
resource PS_ＤＧ連絡橋＿旗ズパリ２__f {
//vox t:vc210601 {
プリスキン_000: {
Tu pourrais tirer &`a travers le drapeau,
mais je ne te le conseille pas.
}
//	<<<ENGLISH>>>
//	You could shoot the control unit
//	through the flag, but I wouldn't
