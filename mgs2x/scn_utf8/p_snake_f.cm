//暗視ゴーグル h //e
resource PS_暗視ゴーグル__f {
//vox t:vc212721 {
プリスキン_000: {
Avec ces lunettes de vision nocturne,
tu verras dans le noir.
}
//	<<<ENGLISH>>>
//	Those night vision goggles
//	will let you see in the dark.

/*暗視ゴーグルを使っているな。
暗視ゴーグルを装備すれば暗い場所でも
