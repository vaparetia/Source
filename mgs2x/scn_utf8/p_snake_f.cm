//dv}//v
}//d

//ニキータスピードアップ h //e
resource PS_ニキータスピードアップ__f {
//vox t:vc211671 {
プリスキン_000: {
Moins tu le manipuleras, plus ton missile
t&'el&'eguid&'e ira vite.
}
//	<<<ENGLISH>>>
//	The less you manipulate a
//	remote-controlled missile,
//	the faster it'll travel.

/*リモコンミサイルは操作しなければ
飛行速度が上がる。*/
プリスキン_001: {
Souviens-t'en et tu pourras envoyer ton
missile t&'el&'eguid&'e sur une plus longue
distance.
}
//	<<<ENGLISH>>>
//	Use this and you'll be able to
//	deliver your remote-controlled
//	missile over a greater distance.

/*これを使えばリモコンミサイルをより
遠くまで飛ばすことが出来るはずだ。
*/
プリスキン_002: {
Sache que la port&'ee d'un missile est
limit&'ee par la capacit&'e de son r&'eservoir.
}
//	<<<ENGLISH>>>
//	Remember that the missile's range
//	is limited by its fuel capacity.
//<ページ数変更>
プリスキン_002_1: {
N'oublie jamais qu'une manoeuvre inutile,
c'est du carburant gaspill&'e.
}
//	<<<ENGLISH>>>
//	Always remember that unnecessary
//	maneuvers can cost you fuel.

/*ミサイルの塔載燃料には限りがある
からな。無駄な操作はさけるんだ。
*/
//dv}//v
}//d

//しゃがめば見つからない場所 h //e
resource PS_しゃがみ遮蔽物__f {
//vox t:vc211681 {
プリスキン_000: {
Tu peux te cacher derri&`ere certains objets
en t'accroupissant.
}
//	<<<ENGLISH>>>
//	You can hide behind certain
//	objects by crouching low.
//<ページ数変更>
プリスキン_000_1: {
Penses-y quand tu es sous
le feu de l'ennemi,
}
//	<<<ENGLISH>>>
//	It's a move that provides
//	cover from enemy fire＃－
//<ページ数変更>
プリスキン_000_2: {
pour voir en Vue en coin ou pour attaquer
en sortant d'une cachette.
}
//	<<<ENGLISH>>>
//	and also allows you to see
//	in Corner View or to do a
//	Jump-out shot.

/*背の低い遮蔽物にはしゃがめば
隠れられるものもある。そこから
ビハインドや飛び出し撃ちも可能だ。
*/
プリスキン_001: {
Ta survie d&'epend de l'usage que tu fais
des objets qui t'entourent.
}
//	<<<ENGLISH>>>
//	Your survival depends on how
//	you use the objects around you.

/*まわりのものを全て利用しろ。
それが生き残る秘訣だ。
*/

//dv}//v
}//d
//タクティカルリロード h //e
resource PS_タクティカルリロード__f {
//vox t:vc211691 {
プリスキン_000: {
Se trouver &`a court de munitions au beau
milieu d'un combat, &~qa peut &^etre g&^enant.
}
//	<<<ENGLISH>>>
//	Running out of ammunition in
//	the middle of a fire fight can
//	be embarrassing.
//<ページ数変更>
プリスキン_000_1: {
Alors pense &`a la fonction Rechargement
tactique.
}
//	<<<ENGLISH>>>
//	That's why you want to use
//	the Tactical Reload feature.

/*銃撃戦で敵の目の前に飛び出した途端に
弾切れを起こしたら洒落にならんぞ。
タクティカル・リロードを使うんだ。
*/
プリスキン_001: {
D&`es que tu te d&'es&'equipes d'une arme,
}
//	<<<ENGLISH>>>
//	Once you remove a weapon
//	from its equip status,
//<ページ数変更>
プリスキン_001_1: {
elle se recharge automatiquement.
}
//	<<<ENGLISH>>>
//	it will be fully reloaded
//	automatically.
//<ページ数変更>
プリスキン_001_2: {
C'est simple : il suffit d'appuyer
sur la touche R2 pour changer
d'&'equipement rapidement.
}
//	<<<ENGLISH>>>
//	You can easily do this by using
//	the R2 button to change equipment
//	quickly.

/*銃を一度装備から外すとマガジンの最大
数まで装弾する。Ｒ２ボタンのクイック
チェンジを使えば楽に出来るはずだ。
*/
//dv}//v
}//d



//Ｃ脚 d //e
//女子便所 h //e
resource PS_Ｃ脚女子トイレ__f {
//vox t:vc211701 {
プリスキン_000: {
Raiden... o&`u es-tu ?
}
//	<<<ENGLISH(2)>>>
//	Raiden... where are you?

/*ライデン……お前、どこにいるんだ？*/
