//<ページ数変更>
オタコン_001_2: {
En d'autres termes, &'evites-les.
}
//	<<<ENGLISH>>>
//	In other words, don't get shot.

/*発射速度は毎分３８００発。
砲口初速は秒速１０００ｍ以上。
