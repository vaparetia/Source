resource PS_サイファー１__f {
//vox t:vc211831 {
プリスキン_000: {
Cette soucoupe volante l&`a devant toi,
c'est le 'Cypher'.
}
//	<<<ENGLISH>>>
//	What you see flying before
//	you is a "Cypher."
//<ページ数変更>
プリスキン_000_1: {
C'est un v&'ehicule a&'erien inhabit&'e
de surveillance et
}
//	<<<ENGLISH>>>
//	It's a saucer-type UAV for
//	surveillance and communication
//	support of＃－
//<ページ数変更>
プリスキン_000_2: {
de communication terrestre et marine.
}
//	<<<ENGLISH>>>
//	land and marine operations.

/*そこに飛んでいるのはサイファー。
陸上／海上監視・通信支援用の円盤型
ＵＡＶだ。
*/
プリスキン_001: {
&~Qa peut para&^itre &'etonnant,
mais il est tr&`es stable.
}
//	<<<ENGLISH>>>
//	It may look strange,
//	but it's very stable.
//<ページ数変更>
プリスキン_001_1: {
Le Cypher peut d&'ecoller et atterrir
&`a la verticale dans
}
//	<<<ENGLISH>>>
//	The Cypher is capable of vertical
//	take-offs and landings in tight
//	areas＃－
//<ページ数変更>
プリスキン_001_2: {
des espaces de pas plus de 3,5 m&`etres.
}
//	<<<ENGLISH>>>
//	measuring as small
//	as 3.5 meters.

/*奇妙な形をしているが安定性は高い。
