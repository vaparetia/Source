//<ページ数変更>
プリスキン_000_1: {
Va &`a la passerelle entre les Shell 1 et 2.
}
//	<<<ENGLISH>>>
//	Head to the connecting bridge
//	between Shells 1 and 2.

/*そのＰＳＧ１なら赤外線センサーの
制御装置を破壊できるだろう。
シェル１シェル２連絡橋に向かえ。
*/
//dv}//v
}//d

//没では？ＸＸＸＸＸＸＸＸｘ
//工夫して撃て！ h //e
resource PS_ＤＧ連絡橋＿ハンドガン__f {
//vox t:vc210531 {
プリスキン_000: {
Je crois qu'on ne pourra d&'egommer
certaines de ces unit&'es de commande
qu'au pistolet.
}
//	<<<ENGLISH>>>
//	Looks like some of those control
//	units can't be reached except with
