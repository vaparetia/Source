resource PS_防弾装備にグレネード__f {
//vox t:vc211661 {
プリスキン_000: {
Les &'equipements pare-balles ne
prot&'egeront pas tes ennemis d'une
explosion de grenade ou d'obus.
}
//	<<<ENGLISH>>>
//	Bulletproof equipment will not
