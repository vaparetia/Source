//	I... um... I...

/*いや、これは……。*/
プリスキン_002: {
Allons, tu es en mission...
}
//	<<<ENGLISH>>>
//	What're you embarrassed about?

プリスキン_002_1: {
Ce n'est pas le moment de faire
des mani&`eres !
}
//	<<<ENGLISH>>>
//	You're on a mission...
//	anything goes!

/*なに、恥じることはない。
任務達成にはあらゆる手段を尽くす
必要がある。
*/
ライデン_003: {
Pliskin...
}
//	<<<ENGLISH>>>
//	Pliskin...

/*プリスキン……。*/
プリスキン_004: {
A moi aussi, &~qa m'est arriv&'e d'y aller...
}
//	<<<ENGLISH>>>
//	I've snuck into similar places
//	in the past myself...

/*俺も昔はよく入ったもんだ……。*/
ライデン_005: {
Hein... ?
}
//	<<<ENGLISH>>>
//	Huh...?

/*……え？*/
//dv}//v
}//d



//シェル２中央棟 d //e
resource PS_シェル２中央棟＿濾過装置うんちく１__f {
//vox t:vc211711 {
プリスキン_000: {
Fais attention, Raiden.
}
//	<<<ENGLISH>>>
//	Be careful, Raiden.

プリスキン_000_1: {
Tu es mort si tu tombes dans la cuve
&`a r&'eaction vitale.
}
//	<<<ENGLISH>>>
//	You're a dead man if you fall
//	into the Life Reaction Tank.

/*ライデン、気を付けろ。
生物反応槽に落ちれば命はないぞ。*/
//dv}//v
}//d
resource PS_シェル２中央棟＿濾過装置うんちく２__f {
//vox t:vc211721 {
オタコン_000: {
Je sais. La cuve &`a r&'eaction vitale &'epure
l'eau pollu&'ee &`a l'aide de micro-organismes.
}
//	<<<ENGLISH>>>
//	That's right. The Life Reaction
//	Tank cleanses polluted water
//	with microorganisms.

/*ああ。生物反応槽では微生物を使った
汚水処理を行っているんだ。*/
オタコン_001: {
Pour activer ces organismes, on les pompe
avec de grands volumes d'oxyg&`ene.
}
//	<<<ENGLISH>>>
//	These organisms are activated by
//	pumping them with large volumes
//	of oxygen.

/*その微生物の活性を保つために常に
大量の酸素が注入されている。*/
オタコン_002: {
La densit&'e de l'eau y est donc tr&`es faible,
ce qui veut dire qu'il est impossible de
flotter.
}
//	<<<ENGLISH>>>
//	As a result, the water's specific
//	gravity is extremely light, making
//	it impossible to remain afloat.

/*だから水の比重がとても軽くなって
いるんだ。人間が浮かぶことは出来ない。
沈んでしまうんだ。*/
オタコン_003: {
Si tu tombes dedans, tu n'en sortiras pas.
}
//	<<<ENGLISH>>>
//	Once you fall in, you'll
//	never come up.

/*落ちたら溺れるしかないだろうだろう。
絶対に落ちるんじゃないよ、いいね。
*/
//dv}//v
}//d


//ストーリー依存 d //e
//ヴァンプの事 h //e
resource PS_ヴァンプ１__f {
//vox t:vc211731 {
プリスキン_000: {
Vamp est membre de la Dead Cell.
}
//	<<<ENGLISH(2)>>>
//	Vamp is a member of Dead Cell.
//<ページ数変更>
プリスキン_000_1: {
Il est n&'e en Roumanie et comme tu le sais,
}
//	<<<ENGLISH>>>
//	Born in Romania, his
//	specialty is knives.
//<ページ数変更>
プリスキン_000_2: {
sa sp&'ecialit&'e, ce sont les couteaux.
}
//	<<<ENGLISH>>>
//	But I guess you
//	know that by now.

/*デッドセルの一人。ヴァンプは
ルーマニア出身のナイフ使いだ。
腕前は……見ての通りだな。
*/
プリスキン_001: {
Il a perdu sa famille quand il &'etait petit.
}
//	<<<ENGLISH>>>
//	When he was just a kid, he lost
//	his family to a terrorist bomb＃－
//<ページ数変更>
プリスキン_001_1: {
Des terroristes ont fait sauter une bombe
dans l'&'eglise o&`u ils allaient.
}
//	<<<ENGLISH>>>
//	that went off in a church
//	they were attending.

/*幼い頃に一家で教会に行った時に
爆弾テロに巻き込まれて家族を
失っている。
*/
プリスキン_002: {
Vamp est rest&'e enseveli sous
les gravats pendant
}
//	<<<ENGLISH>>>
//	His body pierced by a crucifix,
//<ページ数変更>
プリスキン_002_1: {
deux jours avant qu'on le retrouve,
le corps transperc&'e par un crucifix.
}
//	<<<ENGLISH>>>
//	Vamp was buried under the rubble
//	for two days before he was finally
//	rescued.

/*奴は胸に教会の十字架が刺さった
ままの状態でまる二日間瓦礫の下に
放置されていたそうだ。
*/
プリスキン_003: {
S'il a pu survivre pendant ces deux jours,
}
//	<<<ENGLISH>>>
//	During those two days,

プリスキン_003_1: {
c'est en buvant le sang des siens pour
&'etancher sa soif.
}
//	<<<ENGLISH>>>
//	he survived by feeding on
//	the blood of his family to
//	quench his thirst.

/*その間、奴は流れ出た自分と家族の血を
なめて渇きを癒し、命をつないでいた
らしい。
*/
プリスキン_004: {
C'est comme &~qa qu'il a pris go&^ut au sang...
}
//	<<<ENGLISH>>>
//	That was how he acquired
//	a taste for blood...

/*血をすするようになったのは
それからだそうだ。*/
ライデン_005: {
C'est donc pour cela qu'on l'appelle
"Vamp"...
}
//	<<<ENGLISH>>>
//	So that's why they
//	call him "Vamp"...

/*それで吸血鬼……か。
*/
プリスキン_006: {
Non. 'Vamp', &~qa veut aussi dire femme
fatale, en anglais. Il est bisexuel...
}
//	<<<ENGLISH(2)>>>
//	No. "Vamp" isn't for vampire.
//	It's because he's bisexual...

/*ああ。ちなみにヴァンパイアではなく
ヴァンプと呼ばれているのは奴が
バイセクシャルだからだ。
*/
//dv}//v
}//d
//ヴァンプとフォーチュンの関係を聞いていない場合 t //e
resource PS_ヴァンプ２__f {
//vox t:vc211741 {
プリスキン_000: {
Il para&^it que Vamp &'etait l'amant
de Scott Dolph,
}
//	<<<ENGLISH>>>
//	Rumor has it Vamp was
//	the lover of Scott Dolph,
//<ページ数変更>
プリスキン_000_1: {
le commandant des Marines mort
accidentellement il y a deux ans.
}
//	<<<ENGLISH>>>
//	the Marine Commandant who
//	accidentally died two years ago.

/*２年前に事故死した海兵隊司令官、
スコット・ドルフの愛人だったという
噂もある。
*/
プリスキン_001: {
Scott Dolph &'etait &'egalement le p&`ere
de Fortune, le chef de la Dead Cell.
}
//	<<<ENGLISH>>>
//	Scott Dolph was also the father
//	of Fortune, the Dead Cell leader.

/*スコット・ドルフはデッドセルの
リーダー、フォーチュンの父親でも
あるな。
*/
ライデン_002: {
Le p&`ere de Fortune ?
Mais Fortune et Vamp...
}
//	<<<ENGLISH>>>
//	Fortune's old man?
//	But Fortune and Vamp...

/*フォーチュンの父親？
だが奴は彼女とも……。
*/
プリスキン_003: {
Ah, tu as remarqu&'e ?
}
//	<<<ENGLISH(2)>>>
//	You noticed, eh?

プリスキン_003_1: {
Pas mal pour un bleu...
}
//	<<<ENGLISH>>>
//	Not bad for a rookie...

/*ふん。よく観察しているな。
新米にしてはたいした余裕だ。
*/
ライデン_004: {
Hein... bon.
}
//	<<<ENGLISH>>>
//	Uh... right.

/*いや……*/
//dv}//v
}//d
resource PS_ヴァンプとフォーチュン__f {
//vox t:vc211751 {
プリスキン_000: {
Vamp et Fortune sont en effet tr&`es
proches.
}
//	<<<ENGLISH>>>
//	As you say, Vamp and
//	Fortune are very close.
//<ページ数変更>
プリスキン_000_1: {
Pas des amants, mais tr&`es proches...
}
//	<<<ENGLISH>>>
//	Not lovers, but very
//	close...

/*そう。お前の見立てどおり、ヴァンプと
フォーチュンは肉体関係があるらしい。
まあ恋人とは少し違うようだが。
*/
ライデン_001: {
Des amis ?
}
//	<<<ENGLISH>>>
//	Friends?

/*じゃあなんだ？友達？*/
プリスキン_002: {
Non. Plus que &~qa.
}
//	<<<ENGLISH>>>
//	No. There's more to their
//	relationship than that.

/*それも違うだろうな。
まあ人の絆なんてよそからは
測れんものさ。
*/
ライデン_003: {
Mais Vamp &'etait l'amant de son p&`ere !
}
//	<<<ENGLISH>>>
//	But Vamp was her father's lover!

/*しかし……自分の父親と寝ていた男だろ？*/
プリスキン_004: {
Tu crois qu'il aurait &'et&'e mieux qu'il soit
l'amant de sa m&`ere ?
}
//	<<<ENGLISH>>>
//	Would it have been better
//	if it was with her mother?

/*母親と寝ていたのなら良かったのか？*/
ライデン_005: {
Eh bien...
}
//	<<<ENGLISH>>>
//	Well...

/*……。*/
プリスキン_006: {
A mon avis, ils se moquent de ce que tu
penses. Retourne donc &`a la mission.
}
//	<<<ENGLISH(2)>>>
//	I don't really think they
//	care what you think.
//	Focus on the mission.

/*向こうもお前に理解してもらおうなんて
思ってはいまい。
くだらんことは気にするな。
*/
ライデン_007: {
...
}
//	<<<ENGLISH>>>
//	...

/*……。
*/
//dv}//v
}//d
//ヴァンプ遭遇直後の場合 t //e
resource PS_ヴァンプ遭遇直後__f {
//vox t:vc211761 {
ライデン_000: {
A propos, est-ce que tu l'as rencontr&'e ?
}
//	<<<ENGLISH>>>
//	By the way, have you ever
//	met the guy before?

/*ところであんた、奴と会ったことが
あるのか？
*/
プリスキン_001: {
Non.
}
//	<<<ENGLISH>>>
//	No.

/*いや。*/
ライデン_002: {
Il avait pourtant l'air de te conna&^itre...
}
//	<<<ENGLISH>>>
//	But he seemed to know you...

/*だが奴はあんたを知っているよう
だった……。*/
プリスキン_003: {
Heu, en fait... non,
}
//	<<<ENGLISH>>>
//	Right. Well, I... no...

プリスキン_003_1: {
&~qa ne se peut pas...
}
//	<<<ENGLISH>>>
//	...it can't be...

/*確かに……まさか……。
*/
ライデン_004: {
Quoi ?
}
//	<<<ENGLISH>>>
//	What?

/*なんだ？*/
プリスキン_005: {
Rien.
}
//	<<<ENGLISH>>>
//	Nothing.
//<ページ数変更>
プリスキン_005_1: {
Je t'ai dit que la Dead Cell
est un groupe de tar&'es...
}
//	<<<ENGLISH>>>
//	I told you that Dead
//	Cell is a group of madmen...
//<ページ数変更>
プリスキン_005_2: {
Je ne prendrais pas tout ce qu'ils
disent au s&'erieux.
}
//	<<<ENGLISH>>>
//	I wouldn't take anything
//	they say very seriously.

/*いや。デッドセルは言った通り凶人の
集団だ。奴等の言うことをいちいち真に
受けない方がいい。気にするな。
*/
//dv}//v
}//d


//他のデッドセルの事 h //e
resource PS_デッドセル１__f {
//vox t:vc211771 {
ライデン_000: {
Dis-m'en un peu plus sur la Dead Cell.
}
//	<<<ENGLISH>>>
//	Tell me a little more
//	about Dead Cell.

/*デッドセルについて
もう少し教えてくれないか？*/
//dv}//v
}//d
resource PS_デッドセル２__f {
//vox t:vc211781 {
プリスキン_000: {
La Dead Cell &'etait une unit&'e
fant&^ome du SEAL.
}
//	<<<ENGLISH>>>
//	Dead Cell was a shadow unit
//	within the SEALS organization.

/*デッドセルはＳＥＡＬＳとは
言っても影の部隊だった。*/
ライデン_001: {
Qui organisait des raids surprises sur
les organes vitaux du gouvernement.
}
//	<<<ENGLISH>>>
//	Right. They handled surprise
//	raids on vital government
//	facilities, didn't they?

/*ああ。政府の重要施設を抜き打ちで
奇襲する部隊、だったか？*/
プリスキン_002: {
Oui. Elle avait &'et&'e cr&'e&'ee pour contr&^oler
le syst&`eme de s&'ecurit&'e militaire du pays.
}
//	<<<ENGLISH>>>
//	Yes. They were originally put
//	together to check the nation's
//	military security system.

/*そうだ。
元々は米軍設備の保安システムを
チェックするために設立されたんだ。
*/
プリスキン_003: {
C'&'etait une invention de l'ex-pr&'esident
George Sears...
}
//	<<<ENGLISH>>>
//	The unit was the brainchild of
//	ex-president George Sears...

/*前の大統領、ジョージ・シアーズの
肝いりでな。
*/
プリスキン_004: {
La Dead Cell &'etait une unit&'e secr&`ete
exactement
}
//	<<<ENGLISH>>>
//	Dead Cell was a secret unit
//	positioned at the opposite
//	end of＃－
//<ページ数変更>
プリスキン_004_1: {
&`a l'oppos&'e d'organisations antiterroristes
telles que Delta Force et SEAL.
}
//	<<<ENGLISH>>>
//	anti-terrorist outfits such
//	as Delta Force and SEALS.

/*デルタフォースやＳＥＡＬＳといった、
対テロリスト部隊の対極に位置する
闇の組織……。
*/
ライデン_005: {
A-t-elle toujours &'et&'e un...
}
//	<<<ENGLISH>>>
//	Were they always a...

/*奴等は初めから……その……*/
プリスキン_006: {
... groupe de tar&'es ?
}
//	<<<ENGLISH>>>
//	...group of madmen?


/*凶人の集団。*/
ライデン_007: {
Oui.
}
//	<<<ENGLISH>>>
//	Yeah.

/*ああ。それだったのか？*/
プリスキン_008: {
Non. &~Qa a commenc&'e avec l'incarc&'eration
du Colonel Jackson, le mari de Fortune.
}
//	<<<ENGLISH>>>
//	No. They got weird when Colonel
//	Jackson -- Fortune's husband --
//	was sent to jail.

/*いや。リーダーだったジャクソン大佐……
フォーチュンと言われている女の旦那が
投獄されたあたりからだろうな。
*/
ライデン_009: {
Pourquoi a-t-il &'et&'e incarc&'er&'e ?
}
//	<<<ENGLISH>>>
//	Sent to jail? For what?

/*投獄？一体何を？*/
プリスキン_010: {
Corruption.
D&'etournement de fonds publics.
}
//	<<<ENGLISH>>>
//	Corruption. He misappropriated
//	government funds.

/*汚職。公金の横領。*/
ライデン_011: {
Il l'avait cherch&'e, on dirait...
}
//	<<<ENGLISH>>>
//	Sounds like he deserved it...

/*軍人としては不名誉極まりないな。*/
プリスキン_012: {
C'est ce que tout le monde pensait.
Sauf les membres de la Dead Cell.
}
//	<<<ENGLISH>>>
//	That's what everybody else thought.
//	Except for the members of Dead Cell.
//<ページ数変更>
プリスキン_012_1: {
Pour eux, le Colonel avait
&'et&'e accus&'e &`a tort.
}
//	<<<ENGLISH>>>
//	They felt the Colonel
//	was falsely accused.

/*世間の反応もお前と同じだったよ。
だがデッドセルの連中はそれを冤罪と
信じて疑わなかったようだ。
*/
プリスキン_013: {
Le fait est qu'ils ont port&'e l'affaire tr&`es
haut. Mais ils n'ont jamais pu faire rouvrir
le dossier.
}
//	<<<ENGLISH>>>
//	Fact is, they took the case to the
//	powers that be. But they never
//	managed to reopen the case.

/*何度か上層部に掛け合ったりもしたよう
だが、なぜか再審理は行われなかった。
*/
ライデン_014: {
Y avait-il du vrai dans ce qu'ils disaient ?
}
//	<<<ENGLISH>>>
//	Was there any truth
//	to their claim?

/*本当に冤罪だったのか？*/
プリスキン_015: {
Comment le savoir ? Quoi qu'il en soit,
le nom de la Dead Cell &'etait terni.
}
//	<<<ENGLISH>>>
//	Who knows?  Whatever the
//	situation is, Dead Cell's name
//	was tainted.

/*さあな。真相は闇の中だ。
しかし事実はどうあれ、結果として
デッドセルの名は地に落ちた……。
*/
ライデン_016: {
Et le Colonel Jackson... ?
}
//	<<<ENGLISH>>>
//	And Colonel Jackson...?

/*……で、そのジャクソン大佐は
どうなったんだ？*/
プリスキン_017: {
D&'etenu &`a Leavenworth...
}
//	<<<ENGLISH>>>
//	He was being held
//	at Leavenworth...

/*レブンワース刑務所に収監されていた。*/
ライデン_018: {
Est-ce que... est-ce qu'il a &'et&'e lib&'er&'e ?
}
//	<<<ENGLISH>>>
//	"Was"...meaning he's
//	been released?



/*いた？
出所したのか？
*/
プリスキン_019: {
S'il l'on veut… Il est mort.
}
//	<<<ENGLISH>>>
//	Well... in a manner of
//	speaking. The Colonel's
//	dead.

/*ああ。この世からな。*/
ライデン_020: {
Oh.
}
//	<<<ENGLISH>>>
//	Oh.

/*え？*/
プリスキン_021: {
Il semblerait qu'il se soit laiss&'e mourir
en prison.
}
//	<<<ENGLISH>>>
//	Apparently he lost the will
//	to live and died in prison.

/*獄死したんだ。衰弱死だったそうだが。*/
プリスキン_022: {
Les membres de la Dead Cell ont disjonct&'e
apr&`es avoir perdu leur chef.
}
//	<<<ENGLISH>>>
//	The members of Dead Cell
//	snapped with the loss of their
//	leader.

/*リーダーを失うのと同時に
奴等は歯止めも見境も
なくしたらしい。
*/
プリスキン_023: {
Ils ont compl&`etement chang&'e et sont
devenus incontr&^olables.
}
//	<<<ENGLISH>>>
//	They underwent a radical change
//	and became uncontrollable.

/*それ以来デッドセルは先鋭化を続け
手のつけられない暴走をはじめた……。
*/
ライデン_024: {
Et c'est pour cela qu'ils ont mont&'e
cette op&'eration terroriste ?
}
//	<<<ENGLISH>>>
//	And that's why they undertook
//	this terrorist operation?

/*そのあげくがこのテロか？
*/
プリスキン_025: {
C'est une raison comme une autre...
}
//	<<<ENGLISH>>>
//	Seems as good a reason as any...

/*そうかもな。*/
//dv}//v
}//d


//フォーチュンについて h //e
resource PS_フォーチュン１__f {
//vox t:vc211791 {
ライデン_000: {
Que sais-tu de cette femme &'etrange ?
}
//	<<<ENGLISH>>>
//	What do you know about
//	that strange woman?

/*あの妙な女については何か知っているか？
*/
プリスキン_001: {
Tu veux dire Fortune ?
C'est la chef de la Dead Cell.
}
//	<<<ENGLISH>>>
//	You mean Fortune? She's
//	the Dead Cell leader.

/*フォーチュンのことか？
デッドセルのリーダーだ。
*/
プリスキン_002: {
Son vrai nom est Helena Dolph Jackson...
ou Dame Chance, pour les intimes.
}
//	<<<ENGLISH>>>
//	Her real name is Helena Dolph
//	Jackson... known to her friends
//	as Lady Luck.

/*本名、ヘレナ・ドルフ・ジャクソン。
通称、幸運の女神……。
*/
ライデン_003: {
Dame Chance ?
}
//	<<<ENGLISH>>>
//	Lady Luck?

/*幸運の女神？*/
プリスキン_004: {
Oui. Parce qu'on dirait que les balles
l'&'evitent au combat.
}
//	<<<ENGLISH>>>
//	Yeah. She got the name because
//	bullets seem to veer away from
//	her in battle.

/*そうとでも言うしかないだろう。
何しろ弾が当たらないんだ。
*/
ライデン_005: {
...
}
//	<<<ENGLISH>>>
//	...

/*……。
*/
プリスキン_006: {
Elle aurait dit que si elle a de la chance
au combat, c'est parce qu'elle n'en a
pas eu beaucoup dans sa vie...
}
//	<<<ENGLISH>>>
//	People have heard her say that her
//	fortune in battle was payback for
//	the lousy luck she's had in life...

/*だがその幸運は私生活の不運と
引き換えにしたものだと彼女は
言っているらしい。
*/
ライデン_007: {
C'est-&`a-dire ?
}
//	<<<ENGLISH>>>
//	Lousy luck?

/*不運？*/
プリスキン_008: {
La mort de son p&`ere,
le commandant des Marines...
}
//	<<<ENGLISH>>>
//	The death of her father,
//	the Marine commander...
//<ページ数変更>
プリスキン_008_1: {
La condamnation de son mari,
le chef de la Dead Cell...
}
//	<<<ENGLISH>>>
//	The conviction of husband and Dead
//	Cell leader, Colonel Jackson...

/*海兵隊司令官だった父親が死に、デッド
セルのリーダーだった旦那のジャクソン
大佐も横領でムショ送りになった。
*/
プリスキン_009: {
Apr&`es quoi il y a eu le suicide de sa m&`ere,
}
//	<<<ENGLISH>>>
//	These events were followed
//	by her mother's suicide --
//<ページ数変更>
プリスキン_009_1: {
qui n'a pas support&'e la perte de son mari,
plus le fait qu'il y ait un condamn&'e dans
la famille...
}
//	<<<ENGLISH>>>
//	the loss of a husband and the idea
//	of a convict in the family apparently
//	took her over the edge...

/*まもなく夫の死と義理の息子の服役に
耐えかねたのか、母親が自殺。
*/
プリスキン_010: {
Fortune &'etait enceinte de trois mois
&`a l'&'epoque et le suicide de sa m&`ere
}
//	<<<ENGLISH>>>
//	Fortune was three months pregnant
//	at the time and the shock of her
//	mother's death＃－
//<ページ数変更>
プリスキン_010_1: {
l'a tellement choqu&'ee qu'elle
en a perdu son enfant.
}
//	<<<ENGLISH>>>
//	led to the loss of her child.
//<ページ数変更>
プリスキン_010_2: {
Et quelques mois plus tard, son mari
mourait en prison...
}
//	<<<ENGLISH>>>
//	Add to this her husband's death
//	in prison a few months later and...

/*フォーチュン自身もそのショックで当時
三ヶ月だった子供を流産。
とどめに夫もその数ヶ月後に獄死。
*/
プリスキン_011: {
En r&'esum&'e, dans les six mois qui suivirent
la mort de son p&`ere,
}
//	<<<ENGLISH>>>
//	To sum it up, in the six
//	months after her father's
//	death,
//<ページ数変更>
プリスキン_011_1: {
elle a perdu sa famille et tout ce qui
comptait pour elle.
}
//	<<<ENGLISH>>>
//	she lost her family and
//	everything that mattered
//	in her life.

/*つまり父親の死からたった半年程の間に
彼女は家族と、それまで頼りにしていた
現実の全てを失ったというわけだ。
*/
ライデン_012: {
Eh bien, elle en a bav&'e...
}
//	<<<ENGLISH>>>
//	Geez, she's had it rough...

/*……ひどい話だな。*/
プリスキン_013: {
Oui. Mais elle s'est vite remise.
Elle est entr&'ee dans l'arm&'ee.
}
//	<<<ENGLISH>>>
//	Yeah. The thing is, she didn't
//	grieve long. Instead, she joined
//	the military.

/*だが彼女は悲嘆にくれるかわりに
軍に入った。
*/
ライデン_014: {
Pourquoi ?
}
//	<<<ENGLISH>>>
//	Now why's that?

/*どうして？*/
プリスキン_015: {
Comment le savoir ?
Pour se venger, je suppose.
}
//	<<<ENGLISH>>>
//	Do I look psychic?
//	My best guess is
//	revenge.
//<ページ数変更>
プリスキン_015_1: {
Elle est convaincue que son mari
a &'et&'e victime d'un coup mont&'e...
}
//	<<<ENGLISH>>>
//	I heard that she firmly believed
//	that her husband was framed...

/*さあな。復讐かもしれん。彼女は夫の
服役を冤罪だと信じていたらしい。
誰かにはめられた、と。
*/
プリスキン_016: {
Quoi qu'il en soit...
une fois sa formation termin&'ee,
}
//	<<<ENGLISH>>>
//	Anyway... by the time she
//	came out of basic training,

//<ページ数変更>
プリスキン_016_1: {
elle avait d&'ej&`a prouv&'e plusieurs fois qu'elle
avait une chance inhabituelle.
}
//	<<<ENGLISH>>>
//	she'd proven many times over
//	that she was "gifted" with an
//	unusual streak of luck.

/*とにかく訓練を終える頃には彼女は
あの恐るべき強運を身につけていた。
*/
プリスキン_017: {
Certains disent qu'elle a vendu son &^ame
pour &~qa.
}
//	<<<ENGLISH>>>
//	In fact, some say she
//	sold her soul for it.

/*そのために悪魔と取り引きしたとも
言われている。
*/
ライデン_018: {
Son &^ame ?
}
//	<<<ENGLISH>>>
//	Her soul?

/*悪魔……？*/
プリスキン_019: {
Sa chance incroyable lui a valu d'&^etre
nomm&'ee &`a la t&^ete
}
//	<<<ENGLISH>>>
//	Her uncanny luck earned
//	her a reputation that led
//	to her appointment＃－
//<ページ数変更>
プリスキン_019_1: {
de l'organisation de son mari,
la Dead Cell.
}
//	<<<ENGLISH>>>
//	as the head of her husband's
//	unit, Dead Cell.

/*すぐにその力は知れ渡り、遂には死んだ
夫が率いていたデッドセルのリーダーに
収まったというわけだ。
*/
//dv}//v
}//d
//ヴァンプとフォーチュン聞いていない場合 t //e
resource PS_フォーチュン２__f {
//vox t:vc211801 {
プリスキン_000: {
Elle est la veuve de l'ancien et tant
appr&'eci&'e chef de la Dead Cell.
}
//	<<<ENGLISH>>>
//	She's the widow of Dead Cell's
//	former beloved leader.
//<ページ数変更>
プリスキン_000_1: {
Il para&^it que Vamp l'a accueillie &`a bras
ouverts. Il &'etait le chef provisoire de
la Dead Cell &`a l'&'epoque.
}
//	<<<ENGLISH>>>
//	I'd heard that she was welcomed
//	with open arms by Vamp, who was
//	the temporary leader at the time.

/*信望の厚かった元リーダーの未亡人だ。
暫定的にデッドセルをまとめていた
ヴァンプも喜んで彼女を迎えたらしい。
*/
プリスキン_001: {
Pour Vamp, c'&'etait &'egalement
la fille de son ex...
}
//	<<<ENGLISH>>>
//	For Vamp, it also meant welcoming
//	the daughter of his former lover...

/*ま、奴にとっては元恋人の娘でもあった
わけだが。
*/
ライデン_002: {
Vamp et la m&`ere de Fortune...?
}
//	<<<ENGLISH(2)>>>
//	Vamp and Fortune's mother...?

/*ヴァンプとフォーチュンの母親が？*/
プリスキン_003: {
Non. Vamp et le p&`ere de Fortune...
Vamp est bisexuel.
}
//	<<<ENGLISH>>>
//	No. Vamp and Fortune's
//	father... Vamp's bisexual.

/*いや、父親の方だ。
バイセクシャルなんだよ。
*/
ライデン_004: {
Oh... Attends.
Je pensais que Vamp et Fortune...
}
//	<<<ENGLISH>>>
//	Oh... Wait a sec. I thought
//	Vamp and Fortune...

/*ぐ！いや待て。
だがヴァンプとフォーチュンは……
*/
プリスキン_005: {
Tu as remarqu&'e, hein ?
}
//	<<<ENGLISH(2)>>>
//	You noticed, eh?

/*ふん。つまらんことに鼻がきくんだな。*/
ライデン_006: {
Heu... oui.
}
//	<<<ENGLISH>>>
//	Uh... yeah.

/*いや……。*/
//dv}//v
}//d
