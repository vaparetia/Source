// ------------------------------------
// 各gclで必要なdefine
// ------------------------------------
// 共通プロック切り分け用
#define		STAGE_VR		1		// モード
#define		STAGE_WP63A		1		// ステージ名
#define		VR_WEAPON		1		// VRステージの呼び分け

#define		STAGE_START		1		// ステージ開始直後処理


// ------------------------------------
// 各種スイッチ用define
// ------------------------------------
// デバッグ関係
#ifdef	d:FIX_MODE
	#define		DEBUG_CHARA		0		// デバッグキャラ全体(FIX時は0)
#else
	#define		DEBUG_CHARA		0		// デバッグキャラ全体
#endif
#define		CHARA_CAMERA	0		// キャラ追従カメラ
#define		TARGET_CHARA	敵兵:01	// キャラ追従カメラのターゲット
#define		SCREENSHOT		0		// スクリーンショット
#define		USB_KEY			0		// USBキーボード


// ------------------------------------
// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME			ws63a
#define		KMS_NAME			ws63a
#define		TONBO_KMS_NAME		ws63a_tonbo
#define		LINE_KMS_NAME		ws63a_line

// キャラクター関係
#define		PLAYER		ライデン


// ------------------------------------
// ローカル変数
// ------------------------------------


// ------------------------------------
// 的ルート番号
// ------------------------------------
enum M_R {
	//	ニキータ３面用
//	共通ルート０ = 0,	// 欠番
	ライデンルート１ = 1,
	ライデンルート２, ライデンルート３,

	スネークルート４, スネークルート５, スネークルート６, スネークルート７, スネークルート８,

	プリスキンルート９, プリスキンルート１０, プリスキンルート１１, プリスキンルート１２, プリスキンルート１３,

	タキシードルート１４, タキシードルート１５, タキシードルート１６,

	前作スネークルート１７, 前作スネークルート１８, 前作スネークルート１９, 前作スネークルート２０, 前作スネークルート２１,
}


// ------------------------------------
// include
// ------------------------------------

#include "rai_wp63a.mh"		// 強制モーションリスト

#include "stdch.h"			// 常駐キャラ
