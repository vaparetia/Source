#include "a_stdproc.h"		// アナザーミッション設定ファイル
#include "sload.h"			// ロード関数
#include "sound.h"
#include "item_info.h"
//#include "ene_item.h"
#include "jump.h"			// 自動ジャンプ関係
#include "vr_common.h"		// ＶＲステージ共通で使用するプロック

#if d:USB_KEY
	#include "usbkbd.h"
#endif



// ------------------------------------
// マップ設定
// ------------------------------------
chara マップ 武器訓練ニキータ３面 -k d:KMS_NAME -h d:HZX_NAME,0 -l $s:ＶＲライトファイル名

command マップ設定 武器訓練ニキータ３面 -set {
	// ローカルの初期化
	// ------------------------------------
	@ローカル変数初期化		// ローカルで使用する変数で初期化をする場合はここで

	// ＶＲで必要な基本プロックのセット(vr_common.hで定義)
	// サウンドの基本パック、ＶＲの基本システム、プレイヤー、ゴール等を設定します
	// ※このプロックを使用する時は「ＶＲクリア時処理」というプロックが必要です
	// ------------------------------------
	@ＶＲ共通プロックセット sna_wp63a rai_wp63a d:VR_GOAL_TARGET -2000 -1000 14000

	// ＶＲウィンドウの設定
	// ------------------------------------
	@武器訓練ニキータ３面ＶＲウィンドウ設定

	// クリア時に呼ばれるものの設定
	// ------------------------------------
	@ＶＲクリア設定 p:load_wp64a p:load_wp63a

	// ステージに引かれるライン
	// ------------------------------------
	@ＶＲアウトライン d:KMS_NAME d:TONBO_KMS_NAME d:LINE_KMS_NAME

	// 設定値を変更する場合は以下のプロック内で設定
	// ------------------------------------
	@設定値変更				// 敵兵や的のパラメータをステージ限定で変える時はここで
	@プラグイン設定			// プレイヤーのプラグインがいる時はここで
	@ジャンプ設定

	// 的関係の設定
	// ------------------------------------
	@ＶＲ標的ニキータ３面設定				// ＶＲシステム起動後に呼ぶ

	// ＢＧＭの設定(プレイヤー→敵兵→BGMの順で呼ぶ。的の場合は関係ないがとりあえずここに)
	// ------------------------------------
	@ＢＧＭ設定

	// アイテムの設定
	// ------------------------------------
	@アイテム設定

	// 光源、オブジェクト、カメラ関連の設定
	// ------------------------------------
	@ＶＲフォグ設定 d:VR_FOG:朝Ｎ d:VR_FOG:朝Ｆ d:VR_FOG:夕Ｎ d:VR_FOG:夕Ｆ d:VR_FOG:夜Ｎ d:VR_FOG:夜Ｆ
	@カメラセット						// chara カメラとベースのカメラを設定
	@武器訓練ニキータ３面カメラ設定	// ステージ固有のカメラ設定がいる時はこのプロックで
	@ＶＲキャラ用ライト設置				// vr_common.hに定義。必ず最後に設定
#if d:DEBUG_CHARA
//	@デバッグキャラセット
#endif

}

//初期マップの表示
command マップ表示 -show 武器訓練ニキータ３面


//###################################################################################
//									各proc設定
//###################################################################################



//###################################################################################
//									全マップ共通
//###################################################################################
	// ------------------------------------
	// 全マップ共通
	// ------------------------------------
	//------------------------------------------------------------
	// ＶＲウィンドウの設定と表示
	//------------------------------------------------------------
	proc 武器訓練ニキータ３面ＶＲウィンドウ設定 {
		#if d:DEBUG_PRINT
			print 'vr_window_set'
		#endif

		@ＶＲウィンドウ設定	[VRMSG_J:VRM_WPN_NKT_wp63a] [VRMSG_E:VRM_WPN_NKT_wp63a] [VRMSG_G:VRM_WPN_NKT_wp63a] \	// 日、英、独
							[VRMSG_F:VRM_WPN_NKT_wp63a] [VRMSG_I:VRM_WPN_NKT_wp63a] [VRMSG_S:VRM_WPN_NKT_wp63a] \	// 仏、伊、西
							[VRMSG_K:VRM_WPN_NKT_wp63a] \															// 韓
							p:ＶＲステージ開始時処理								// 終了プロック


		// ＶＲウィンドウを表示する
		mesg ＶＲウィンドウ ＶＲウィンドウ君 開く

		// スタート時とクリア時に使用するカットインカメラ
		chara カメラ カットインカメラ		-c 0 -l 0 -p 0

		// スタート時のカメラ(必要な場合)
		chara カメラ設定 カットインカメラ \
			-c 1 \	
			-p -2000,3500,19500 -t -2000,-1000,14000 \
			-r 450,2048,0 -f 7000 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1
	}

	//------------------------------------------------------------
	// ステージ開始時処理
	//------------------------------------------------------------
	proc ＶＲステージ開始時処理 {
		#if d:DEBUG_PRINT
			print 'game_start!!!!!'
		#endif

		// プレイヤーやパッドの制御等を行う a_stdproc.hで定義
		@全ミッション共通ステージ開始時処理

		// カメラワークスタート(必要な場合)
		// 全体図
		chara カメラ設定 カットインカメラ \
			-c 1 \	
			-p -1000,23000,31500 -t -1000,17250,24500 \
			-r 450,2048,0 -f 8000 \
			-a 200 \
			-i 4 4 d:START_CAMERA_CHANGE_TIME d:START_CAMERA_CHANGE_TIME \
			-s 1

		chara delay ディレイ \
			-time d:START_CAMERA_CHANGE_TIME \
			-exec {
				chara カメラ設定 カットインカメラ -s -1
			}
	}

	// ------------------------------------
	// クリア時の処理
	// ------------------------------------
	proc ＶＲクリア時処理 {
		#if d:DEBUG_PRINT
			print 'clear'
		#endif

		// 強制モーションを発動
		@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_1 3748

		// クリア時にカメラアングルを変える
		chara カメラ設定 クリア時カメラ \
			-c 1 \
			-p -4200,700,17250 -t -2250,250,13800 \
			-r 75,1700,0 -f 4000 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}

	//------------------------------------------------------------
	// ステージ開始直後処理
	//------------------------------------------------------------
	proc ゲーム開始直後処理 {
		// 初期配置標的の起動（command ＶＲステージスタート の起動直後に行う必要がある）
		@ＶＲ初期配置標的ニキータ３面設定
	}


	// ------------------------------------
	// パラメータ系の変更
	// ------------------------------------
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT
			print 'localvar_init'
		#endif

		//	的管理用各種フラグを初期化する
//		$$i:標的フラグＡ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NO_GHOST );
//		$$i:標的フラグＢ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST );
//		$$i:標的フラグＣ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    );
		$$i:標的フラグＤ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST                  | d:VR_TRG_WAIT );
//		$$i:標的フラグＥ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST | d:VR_TRG_WAIT );
//		$$i:標的フラグＦ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    | d:VR_TRG_WAIT );
//		$$i:標的フラグＧ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST                  | d:VR_TRG_WAIT | d:VR_TRG_CIRCLE );
//		$$i:標的フラグＨ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST | d:VR_TRG_WAIT | d:VR_TRG_CIRCLE );
//		$$i:標的フラグＩ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    | d:VR_TRG_WAIT | d:VR_TRG_CIRCLE );
//		$$i:標的フラグＪ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST                  | d:VR_TRG_WAIT | d:VR_TRG_NO_APPEAR_EF );
//		$$i:標的フラグＫ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST | d:VR_TRG_WAIT | d:VR_TRG_NO_APPEAR_EF );
//		$$i:標的フラグＬ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    | d:VR_TRG_WAIT | d:VR_TRG_NO_APPEAR_EF );
	}

	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT
			print 'status_set'
		#endif

		// 初期装備の設定
		$w:アイテム数Ｒ[ d:アイテム:双眼鏡 ] = 1
		$w:武器弾数Ｒ[ d:武器:ニキータ ] = 18
		$w:武器 = d:武器:ニキータ

		// ニキータ防止
		command ミサイル移動範囲設定 -110000 -110000 -110000 110000 110000 110000
	}

	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif

		command プラグイン自動ジャンプ

	}

	// 台登り
	// ------------------------------------
	proc ジャンプ設定 {
		#if d:DEBUG_PRINT
			print 'jump_set'
		#endif

		trap ky001 d:PLAYER \
			-mask 入る \
			-exec {
				@ジャンプ発動 ky001 1000 10
			}
	}



//###################################################################################
//									 的兵
//###################################################################################

	// ------------------------------------
	// ニキータ３面
	// ------------------------------------
	// 敵兵や的の処理
	// ------------------------------------
	proc ＶＲ標的ニキータ３面設定 {

		// ライデンを選択
		if ( $s:選択プレイヤー == ライデン ) {

			command foreach -argc 2 -repeat 3 \
			-data { \
				// 的名,     ルート
				// act 1 ----------
				{ 移動的:01, d:M_R:ライデンルート１ }\
				{ 移動的:02, d:M_R:ライデンルート２ }\
				{ 移動的:03, d:M_R:ライデンルート３ }\
			} \
			-exec { \
				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグＤ \
					-route $2
			}

		// スネークを選択
		} else if ( $s:選択プレイヤー == スネーク ) {

			command foreach -argc 2 -repeat 5 \
			-data { \
				// 的名,     ルート
				// act 1 ----------
				{ 移動的:01, d:M_R:スネークルート４ }\
				{ 移動的:02, d:M_R:スネークルート５ }\
				{ 移動的:03, d:M_R:スネークルート６ }\
				{ 移動的:04, d:M_R:スネークルート７ }\
				{ 移動的:05, d:M_R:スネークルート８ }\
			} \
			-exec { \
				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグＤ \
					-route $2
			}

		// プリスキンを選択
		} else if ( $s:選択プレイヤー == プリスキン ) {

			command foreach -argc 2 -repeat 5 \
			-data { \
				// 的名,     ルート
				// act 1 ----------
				{ 移動的:01, d:M_R:プリスキンルート９   }\
				{ 移動的:02, d:M_R:プリスキンルート１０ }\
				{ 移動的:03, d:M_R:プリスキンルート１１ }\
				{ 移動的:04, d:M_R:プリスキンルート１２ }\
				{ 移動的:05, d:M_R:プリスキンルート１３ }\
			} \
			-exec { \
				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグＤ \
					-route $2
			}

		// タキシードスネークを選択
		} else if ( $s:選択プレイヤー == タキシードスネーク ) {

			command foreach -argc 2 -repeat 3 \
			-data { \
				// 的名,     ルート
				// act 1 ----------
				{ 移動的:01, d:M_R:タキシードルート１４ }\
				{ 移動的:02, d:M_R:タキシードルート１５ }\
				{ 移動的:03, d:M_R:タキシードルート１６ }\
			} \
			-exec { \
				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグＤ \
					-route $2
			}

		//	前作スネークを選択
		} else if ( $s:選択プレイヤー == 前作スネーク ) {

			command foreach -argc 2 -repeat 5 \
			-data { \
				// 的名,     ルート
				// act 1 ----------
				{ 移動的:01, d:M_R:前作スネークルート１７ }\
				{ 移動的:02, d:M_R:前作スネークルート１８ }\
				{ 移動的:03, d:M_R:前作スネークルート１９ }\
				{ 移動的:04, d:M_R:前作スネークルート２０ }\
				{ 移動的:05, d:M_R:前作スネークルート２１ }\
			} \
			-exec { \
				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグＤ \
					-route $2
			}

		}

	}

	proc ＶＲ初期配置標的ニキータ３面設定 {
		// 共通標的 （主にライデン）
		mesg ＶＲ的共通 移動的:01 移動開始
		mesg ＶＲ的共通 移動的:02 移動開始
		mesg ＶＲ的共通 移動的:03 移動開始

		// 他キャラ選択時の追加標的s
		// スネーク or プリスキン or 前作スネーク
		if ( ($s:選択プレイヤー == スネーク) || ($s:選択プレイヤー == プリスキン) || ($s:選択プレイヤー == 前作スネーク) ) {
			mesg ＶＲ的共通 移動的:04 移動開始
			mesg ＶＲ的共通 移動的:05 移動開始
		}
	}


//###################################################################################
//									 ＢＧＭ
//###################################################################################

	// ------------------------------------
	// ＢＧＭの設定
	// ------------------------------------
	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT
			print 'bgm_set'
		#endif

		chara ＢＧＭマネージャー ＢＧＭマネ
	}


//###################################################################################
//									 アイテム
