					mesg ＶＲ的共通 移動的:38 移動開始
					mesg ＶＲ的共通 移動的:39 移動開始
				}

			// act 6 ----------
			} else if ( ($1 == 移動的:31) || ($1 == 移動的:32) || ($1 == 移動的:33) || \
						($1 == 移動的:34) || ($1 == 移動的:35) || ($1 == 移動的:36) || \
						($1 == 移動的:37) || ($1 == 移動的:38) || ($1 == 移動的:39) ) {
				$$b:act_6_破壊数カウント = $$b:act_6_破壊数カウント + 1

			// act 7 ----------
			} else if ( ($1 == 移動的:40) || ($1 == 移動的:41) || ($1 == 移動的:42) ) {
				$$b:act_7_破壊数カウント = $$b:act_7_破壊数カウント + 1

			// act 8 ----------
			} else if ( ($1 == 移動的:43) || ($1 == 移動的:44) || ($1 == 移動的:45) || ($1 == 移動的:46) || \
						($1 == 移動的:47) || ($1 == 移動的:48) || ($1 == 移動的:49) || ($1 == 移動的:50) || \
						($1 == 移動的:51) || ($1 == 移動的:52) || ($1 == 移動的:53) || ($1 == 移動的:54) || \
						($1 == 移動的:55) || ($1 == 移動的:56) ) {
				$$b:act_8_破壊数カウント = $$b:act_8_破壊数カウント + 1
				if ( $$b:act_8_破壊数カウント == 10 ){
					mesg ＶＲ的共通 移動的:53 移動開始
					mesg ＶＲ的共通 移動的:54 移動開始
					mesg ＶＲ的共通 移動的:55 移動開始
					mesg ＶＲ的共通 移動的:56 移動開始
				}
			}

			if ( ($$b:act_1_破壊数カウント + $$b:act_2_破壊数カウント + $$b:act_3_破壊数カウント + $$b:act_4_破壊数カウント + \
				  $$b:act_5_破壊数カウント + $$b:act_6_破壊数カウント + $$b:act_7_破壊数カウント ) == 42) {
				mesg ＶＲ的共通 移動的:43 移動開始
			}

			// ラスボス ----------
			if ( ($$b:act_1_破壊数カウント + $$b:act_2_破壊数カウント + $$b:act_3_破壊数カウント + $$b:act_4_破壊数カウント + \
				  $$b:act_5_破壊数カウント + $$b:act_6_破壊数カウント + $$b:act_7_破壊数カウント + $$b:act_8_破壊数カウント) == 56) {
				mesg ＶＲ的共通 移動的:57 移動開始
				mesg ＶＲ的共通 移動的:58 移動開始
				mesg ＶＲ的共通 移動的:59 移動開始
				mesg ＶＲ的共通 移動的:60 移動開始
				mesg ＶＲ的共通 移動的:61 移動開始
			}
			if ( $1 == 移動的:57 ){
				command foreach -argc 1 -repeat 4 \
				-data { \
					// 的名
					{ 移動的:58 }\
					{ 移動的:59 }\
					{ 移動的:60 }\
					{ 移動的:61 }\
				} \
				-exec { \
					mesg ＶＲ的共通 $1 消滅
				}
			}

		}

	}

	// ルート変更処理
	// ------------------------------------
	proc ＶＲルート変更マシンガン５面処理 {

		// ライデン or タキシードスネークを選択
		if ( ($s:選択プレイヤー == ライデン) ||  ($s:選択プレイヤー == タキシードスネーク) ) {

			// act 2 ----------
			if ( $1 == 移動的:08 ) {
					mesg ＶＲ移動的 移動的:08 即ルート変更 d:M_R:ライデンルート１２
			} else if ( $1 == 移動的:09 ) {
					mesg ＶＲ移動的 移動的:09 即ルート変更 d:M_R:ライデンルート１３
			} else if ( $1 == 移動的:10 ) {
					mesg ＶＲ移動的 移動的:10 即ルート変更 d:M_R:ライデンルート１４
			} else if ( $1 == 移動的:11 ) {
					mesg ＶＲ移動的 移動的:11 即ルート変更 d:M_R:ライデンルート１５
			}

		// スネーク or プリスキンを選択
		} else if ( ($s:選択プレイヤー == スネーク) || ($s:選択プレイヤー == プリスキン) ) {

			// act 2 ----------
			if ( $1 == 移動的:09 ) {
					mesg ＶＲ移動的 移動的:09 即ルート変更 d:M_R:スネークルート６７
			} else if ( $1 == 移動的:10 ) {
					mesg ＶＲ移動的 移動的:10 即ルート変更 d:M_R:スネークルート６８
			} else if ( $1 == 移動的:11 ) {
					mesg ＶＲ移動的 移動的:11 即ルート変更 d:M_R:スネークルート６９
			} else if ( $1 == 移動的:12 ) {
					mesg ＶＲ移動的 移動的:12 即ルート変更 d:M_R:スネークルート７０
			} else if ( $1 == 移動的:13 ) {
					mesg ＶＲ移動的 移動的:13 即ルート変更 d:M_R:スネークルート７１
			}

		// 前作スネークを選択
		} else if ( $s:選択プレイヤー == 前作スネーク ) {

			// 現状ではスネークルートを流用
			// act 2 ----------
			if ( $1 == 移動的:09 ) {
					mesg ＶＲ移動的 移動的:09 即ルート変更 d:M_R:前作スネークルート１２５
			} else if ( $1 == 移動的:10 ) {
					mesg ＶＲ移動的 移動的:10 即ルート変更 d:M_R:前作スネークルート１２６
			} else if ( $1 == 移動的:11 ) {
					mesg ＶＲ移動的 移動的:11 即ルート変更 d:M_R:前作スネークルート１２７
			} else if ( $1 == 移動的:12 ) {
					mesg ＶＲ移動的 移動的:12 即ルート変更 d:M_R:前作スネークルート１２８
			} else if ( $1 == 移動的:13 ) {
					mesg ＶＲ移動的 移動的:13 即ルート変更 d:M_R:前作スネークルート１２９
			}

		}
	}

	// 起動タイミング制御処理
	// ------------------------------------
	proc ＶＲ起動開始マシンガン５面処理 {

		// ライデン or タキシードスネークを選択
		if ( ($s:選択プレイヤー == ライデン) ||  ($s:選択プレイヤー == タキシードスネーク) ) {

			// act 4 ----------
			if ( ($1 == 移動的:16) || ($1 == 移動的:19) ) {
				mesg ＶＲ的共通 移動的:17 移動開始
				mesg ＶＲ的共通 移動的:20 移動開始
			} else if ( ($1 == 移動的:17) || ($1 == 移動的:20) ) {
				mesg ＶＲ的共通 移動的:18 移動開始
				mesg ＶＲ的共通 移動的:21 移動開始
			}
			// act 8 ----------
			if ( $1 == 移動的:40 ) {
				mesg ＶＲ的共通 移動的:41 移動開始
			} else if ( $1 == 移動的:41 ) {
				mesg ＶＲ的共通 移動的:42 移動開始
			} else if ( $1 == 移動的:42 ) {
				mesg ＶＲ的共通 移動的:43 移動開始
			} else if ( $1 == 移動的:43 ) {
				mesg ＶＲ的共通 移動的:44 移動開始
			} else if ( $1 == 移動的:44 ) {
				mesg ＶＲ的共通 移動的:45 移動開始
			} else if ( $1 == 移動的:45 ) {
				mesg ＶＲ的共通 移動的:46 移動開始
			} else if ( $1 == 移動的:46 ) {
				mesg ＶＲ的共通 移動的:47 移動開始
			}

		// スネーク or プリスキンを選択
		} else if ( ($s:選択プレイヤー == スネーク) || ($s:選択プレイヤー == プリスキン) ) {

			// act 4 ----------
			if ( ($1 == 移動的:19) || ($1 == 移動的:22) ) {
				mesg ＶＲ的共通 移動的:20 移動開始
				mesg ＶＲ的共通 移動的:23 移動開始
			} else if ( ($1 == 移動的:20) || ($1 == 移動的:23) ) {
				mesg ＶＲ的共通 移動的:21 移動開始
				mesg ＶＲ的共通 移動的:24 移動開始
			}

			// act 8 ----------
			if ( $1 == 移動的:43 ) {
				mesg ＶＲ的共通 移動的:44 移動開始
			} else if ( $1 == 移動的:44 ) {
				mesg ＶＲ的共通 移動的:45 移動開始
			} else if ( $1 == 移動的:45 ) {
				mesg ＶＲ的共通 移動的:46 移動開始
			} else if ( $1 == 移動的:46 ) {
				mesg ＶＲ的共通 移動的:47 移動開始
			} else if ( $1 == 移動的:47 ) {
				mesg ＶＲ的共通 移動的:48 移動開始
			} else if ( $1 == 移動的:48 ) {
				mesg ＶＲ的共通 移動的:49 移動開始
			} else if ( $1 == 移動的:49 ) {
				mesg ＶＲ的共通 移動的:50 移動開始
			} else if ( $1 == 移動的:50 ) {
				mesg ＶＲ的共通 移動的:51 移動開始
			} else if ( $1 == 移動的:51 ) {
				mesg ＶＲ的共通 移動的:52 移動開始
			}

		// 前作スネークを選択
		} else if ( $s:選択プレイヤー == 前作スネーク ) {

			// 現状ではスネークルートを流用
			// act 4 ----------
			if ( ($1 == 移動的:19) || ($1 == 移動的:22) ) {
				mesg ＶＲ的共通 移動的:20 移動開始
				mesg ＶＲ的共通 移動的:23 移動開始
			} else if ( ($1 == 移動的:20) || ($1 == 移動的:23) ) {
				mesg ＶＲ的共通 移動的:21 移動開始
				mesg ＶＲ的共通 移動的:24 移動開始
			}

			// act 8 ----------
			if ( $1 == 移動的:43 ) {
				mesg ＶＲ的共通 移動的:44 移動開始
			} else if ( $1 == 移動的:44 ) {
				mesg ＶＲ的共通 移動的:45 移動開始
			} else if ( $1 == 移動的:45 ) {
				mesg ＶＲ的共通 移動的:46 移動開始
			} else if ( $1 == 移動的:46 ) {
				mesg ＶＲ的共通 移動的:47 移動開始
			} else if ( $1 == 移動的:47 ) {
				mesg ＶＲ的共通 移動的:48 移動開始
			} else if ( $1 == 移動的:48 ) {
				mesg ＶＲ的共通 移動的:49 移動開始
			} else if ( $1 == 移動的:49 ) {
				mesg ＶＲ的共通 移動的:50 移動開始
			} else if ( $1 == 移動的:50 ) {
				mesg ＶＲ的共通 移動的:51 移動開始
			} else if ( $1 == 移動的:51 ) {
				mesg ＶＲ的共通 移動的:52 移動開始
			}

		}
	}


	// 敵兵や的の処理
	// ------------------------------------
	proc ＶＲ標的マシンガン５面設定 {

		// ライデン or タキシードスネークを選択
		if ( ($s:選択プレイヤー == ライデン) ||  ($s:選択プレイヤー == タキシードスネーク) ) {

			// 通常及びルート変更する標的
			command foreach -argc 6 -repeat 43 \
			-data { \
				// 的名,     フラグ,             ルート,   変更ノード, 起動ノード, スピード
				// act 1 ----------
				{ 移動的:01, $$i:標的フラグＯ２, d:M_R:ライデンルート１,   0, 0,  50 }\
				{ 移動的:02, $$i:標的フラグＣ１, d:M_R:ライデンルート２,   0, 0, 125 }\
				{ 移動的:03, $$i:標的フラグＣ１, d:M_R:ライデンルート３,   0, 0, 125 }\
				{ 移動的:04, $$i:標的フラグＣ１, d:M_R:ライデンルート４,   0, 0,  25 }\
				{ 移動的:05, $$i:標的フラグＣ１, d:M_R:ライデンルート５,   0, 0,  25 }\
				{ 移動的:06, $$i:標的フラグＣ１, d:M_R:ライデンルート６,   0, 0,  25 }\
				{ 移動的:07, $$i:標的フラグＣ１, d:M_R:ライデンルート７,   0, 0,  25 }\
				// act 2 ----------
				{ 移動的:08, $$i:標的フラグＣ４, d:M_R:ライデンルート８,   2, 0,  50 }\
				{ 移動的:09, $$i:標的フラグＣ４, d:M_R:ライデンルート９,   2, 0,  50 }\
				{ 移動的:10, $$i:標的フラグＣ４, d:M_R:ライデンルート１０, 2, 0,  50 }\
				{ 移動的:11, $$i:標的フラグＣ４, d:M_R:ライデンルート１１, 2, 0,  50 }\
				// act 4 ----------
				{ 移動的:16, $$i:標的フラグＯ１, d:M_R:ライデンルート２０, 0, 1, 250 }\
				{ 移動的:17, $$i:標的フラグＯ１, d:M_R:ライデンルート２１, 0, 1, 250 }\
				{ 移動的:18, $$i:標的フラグＯ１, d:M_R:ライデンルート２２, 0, 1, 250 }\
				{ 移動的:19, $$i:標的フラグＯ１, d:M_R:ライデンルート２３, 0, 1, 250 }\
				{ 移動的:20, $$i:標的フラグＯ１, d:M_R:ライデンルート２４, 0, 1, 250 }\
				{ 移動的:21, $$i:標的フラグＯ１, d:M_R:ライデンルート２５, 0, 1, 250 }\
				// act 5 ----------
				{ 移動的:22, $$i:標的フラグＯ１, d:M_R:ライデンルート２６, 0, 0, 250 }\
				{ 移動的:23, $$i:標的フラグＯ１, d:M_R:ライデンルート２７, 0, 0, 250 }\
				{ 移動的:24, $$i:標的フラグＯ１, d:M_R:ライデンルート２８, 0, 0, 250 }\
				{ 移動的:25, $$i:標的フラグＯ１, d:M_R:ライデンルート２９, 0, 0, 250 }\
				{ 移動的:26, $$i:標的フラグＯ１, d:M_R:ライデンルート３０, 0, 0, 250 }\
				{ 移動的:27, $$i:標的フラグＯ１, d:M_R:ライデンルート３１, 0, 0, 250 }\
				// act 6 ----------
				{ 移動的:28, $$i:標的フラグＯ２, d:M_R:ライデンルート３２, 0, 0, 250 }\
				{ 移動的:29, $$i:標的フラグＯ２, d:M_R:ライデンルート３３, 0, 0, 250 }\
				{ 移動的:30, $$i:標的フラグＯ１, d:M_R:ライデンルート３４, 0, 0,  50 }\
				{ 移動的:31, $$i:標的フラグＯ２, d:M_R:ライデンルート３５, 0, 0,  50 }\
				{ 移動的:32, $$i:標的フラグＯ１, d:M_R:ライデンルート３６, 0, 0,  50 }\
				{ 移動的:33, $$i:標的フラグＯ１, d:M_R:ライデンルート３７, 0, 0,  50 }\
				{ 移動的:34, $$i:標的フラグＯ２, d:M_R:ライデンルート３８, 0, 0,  50 }\
				{ 移動的:35, $$i:標的フラグＯ１, d:M_R:ライデンルート３９, 0, 0,  50 }\
				{ 移動的:36, $$i:標的フラグＯ２, d:M_R:ライデンルート４０, 0, 0, 100 }\
				// act 7 ----------
				{ 移動的:37, $$i:標的フラグＯ１, d:M_R:ライデンルート４１, 0, 0, 100 }\
				{ 移動的:38, $$i:標的フラグＯ１, d:M_R:ライデンルート４２, 0, 0, 100 }\
				{ 移動的:39, $$i:標的フラグＯ１, d:M_R:ライデンルート４３, 0, 0, 100 }\
				// act 8 （前半）
				{ 移動的:40, $$i:標的フラグＣ１, d:M_R:ライデンルート４７, 0, 1,  75 }\
				{ 移動的:41, $$i:標的フラグＣ１, d:M_R:ライデンルート４７, 0, 1,  75 }\
				{ 移動的:42, $$i:標的フラグＣ１, d:M_R:ライデンルート４７, 0, 1,  75 }\
				{ 移動的:43, $$i:標的フラグＣ１, d:M_R:ライデンルート４７, 0, 1,  75 }\
				{ 移動的:44, $$i:標的フラグＣ１, d:M_R:ライデンルート４９, 0, 1,  75 }\
				{ 移動的:45, $$i:標的フラグＣ１, d:M_R:ライデンルート５０, 0, 1,  75 }\
				{ 移動的:46, $$i:標的フラグＣ１, d:M_R:ライデンルート５１, 0, 1,  75 }\
				{ 移動的:47, $$i:標的フラグＣ１, d:M_R:ライデンルート５２, 0, 1,  75 }\
			} \
			-exec { \
				if( $s:選択プレイヤー == タキシードスネーク ) {
					$$b:標的セット数 = $$b:標的セット数 + 1;
					if( $$b:標的セット数 % 2 ) {
						$$i:標的フラグ = ( $2 | d:VR_TRG_HIDESTART );
					} else {
						$$i:標的フラグ = ( $2 | d:VR_TRG_VISIBLESTART );
					}
				} else {
					$$i:標的フラグ = $2;
				}

				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグ \
					-route $3 \
					-c ＶＲ標的破壊マシンガン５面処理 \
					-x ＶＲルート変更マシンガン５面処理 $3 $4 \
					   ＶＲ起動開始マシンガン５面処理 $3 $5 \
					-speed $6
			}

			// 自転及び公転する標的
			command foreach -argc 8 -repeat 11 \
			-data { \
				// 的名,     フラグ,               ルート,   公転速度, 初期公転位置, 公転半径, 自転速度, スピード
				// act 3 ----------
				{ 移動的:12, $$i:標的フラグＯ２, d:M_R:ライデンルート１６,    0,   0,     0, 4096, 250 }\
				{ 移動的:13, $$i:標的フラグＣ１, d:M_R:ライデンルート１７,    0,   0,     0, 1024,  25 }\
				{ 移動的:14, $$i:標的フラグＣ１, d:M_R:ライデンルート１８,    0,   0,     0, 1024,  25 }\
				{ 移動的:15, $$i:標的フラグＣ１, d:M_R:ライデンルート１９,    0,   0,     0, 1024,  25 }\
				// act 8 （後半）
				{ 移動的:48, $$i:標的フラグＣ５, d:M_R:ライデンルート４８,  768,    0, 2000,    0,   0 }\
