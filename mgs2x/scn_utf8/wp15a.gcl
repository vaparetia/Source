					-flag $$i:標的フラグ \
					-route $3 \
					-c ＶＲ標的破壊マシンガン５面処理 \
					-x ＶＲルート変更マシンガン５面処理 $3 $4 \
					   ＶＲ起動開始マシンガン５面処理 $3 $5 \
					-speed $6
			}

			// 自転及び公転する標的
			command foreach -argc 9 -repeat 14 \
			-data { \
				// 的名,     フラグ,               ルート,   公転速度, 初期公転位置, 公転半径, Ｙシフト, 自転速度, スピード
				// act 3 ----------
				{ 移動的:14, $$i:標的フラグＯ２, d:M_R:前作スネークルート１３０,    0,   0,     0,    0, 4096, 300 }\
				{ 移動的:15, $$i:標的フラグＣ１, d:M_R:前作スネークルート１３１,    0,   0,     0,    0, 1024,  45 }\
				{ 移動的:16, $$i:標的フラグＣ１, d:M_R:前作スネークルート１３２,    0,   0,     0,    0, 1024,  45 }\
				{ 移動的:17, $$i:標的フラグＣ１, d:M_R:前作スネークルート１３３,    0,   0,     0,    0, 1024,  45 }\
				{ 移動的:18, $$i:標的フラグＣ１, d:M_R:前作スネークルート１３４,    0,   0,     0,    0, 1024,  45 }\
				// act 8 （後半）
				{ 移動的:53, $$i:標的フラグＣ５, d:M_R:前作スネークルート１６３, 1024,    0, 4000,    0,    0,   0 }\
				{ 移動的:54, $$i:標的フラグＣ５, d:M_R:前作スネークルート１６３, 1024, 1024, 4000,    0,    0,   0 }\
				{ 移動的:55, $$i:標的フラグＣ５, d:M_R:前作スネークルート１６３, 1024, 2048, 4000,    0,    0,   0 }\
				{ 移動的:56, $$i:標的フラグＣ５, d:M_R:前作スネークルート１６３, 1024, 3072, 4000,    0,    0,   0 }\
				// ラスボス ----------
				{ 移動的:57, $$i:標的フラグＨ,   d:M_R:前作スネークルート１６９,    0,    0,    0,    0, 1024,  25 }\
				{ 移動的:58, $$i:標的フラグＴ,   d:M_R:前作スネークルート１６９, 2048,    0, 1750, -300, 4096,  25 }\
				{ 移動的:59, $$i:標的フラグＴ,   d:M_R:前作スネークルート１６９, 2048, 1024, 1750, -250, 4096,  25 }\
				{ 移動的:60, $$i:標的フラグＴ,   d:M_R:前作スネークルート１６９, 2048, 2048, 1750, -200, 4096,  25 }\
				{ 移動的:61, $$i:標的フラグＴ,   d:M_R:前作スネークルート１６９, 2048, 3072, 1750, -150, 4096,  25 }\
			} \
			-exec { \
				// 前作スネークは順番を逆にする
				if( ($2 != $$i:標的フラグＯ２) && ($2 != $$i:標的フラグＨ) && ($2 != $$i:標的フラグＴ) ) {
					$$b:標的セット数 = $$b:標的セット数 + 1;
					if( $$b:標的セット数 % 2 ) {
						$$i:標的フラグ = ( $2 | d:VR_TRG_VISIBLESTART );
					} else {
						$$i:標的フラグ = ( $2 | d:VR_TRG_HIDESTART );
					}
				} else {
					$$i:標的フラグ = $2;
				}

				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグ \
					-route $3 \
					-kouten	$4 $5 $6 \
					-yshift 0 $7 0 \
					-dir 0 $8 \
					-c ＶＲ標的破壊マシンガン５面処理 \
					-speed $9
			}

		}

	}

	proc ＶＲ初期配置標的マシンガン５面設定 {
		// 共通標的 （主にライデン）
		mesg ＶＲ的共通 移動的:01 移動開始
		mesg ＶＲ的共通 移動的:02 移動開始
		mesg ＶＲ的共通 移動的:03 移動開始
		mesg ＶＲ的共通 移動的:04 移動開始
		mesg ＶＲ的共通 移動的:05 移動開始
		mesg ＶＲ的共通 移動的:06 移動開始
		mesg ＶＲ的共通 移動的:07 移動開始

		// 他キャラ選択時の追加標的s
		if ( ($s:選択プレイヤー == スネーク) || ($s:選択プレイヤー == プリスキン) || ($s:選択プレイヤー == 前作スネーク) ){
			mesg ＶＲ的共通 移動的:08 移動開始
		}
	}

	proc ＡＣＴ７トラップ起動 {
		trap ac7_tp1 d:PLAYER \
			-mask いる \
			-exec {

				if( ($b:ＡＣＴ７トラップ起動制御 == 0) && ($$b:act_6_破壊数カウント == 9) ){
					// ライデン or タキシードスネークを選択
					if ( ($s:選択プレイヤー == ライデン) ||  ($s:選択プレイヤー == タキシードスネーク) ) {
						mesg ＶＲ移動的 移動的:37 ルート変更 d:M_R:ライデンルート４４
						mesg ＶＲ移動的 移動的:38 ルート変更 d:M_R:ライデンルート４５
						mesg ＶＲ移動的 移動的:39 ルート変更 d:M_R:ライデンルート４６
					// スネーク or プリスキンを選択
					} else if ( ($s:選択プレイヤー == スネーク) || ($s:選択プレイヤー == プリスキン) ) {
						mesg ＶＲ移動的 移動的:40 ルート変更 d:M_R:スネークルート１０１
						mesg ＶＲ移動的 移動的:41 ルート変更 d:M_R:スネークルート１０２
						mesg ＶＲ移動的 移動的:42 ルート変更 d:M_R:スネークルート１０３
					// 前作スネークを選択
					} else if ( $s:選択プレイヤー == 前作スネーク ) {
						// 現状ではスネークルートを流用
						mesg ＶＲ移動的 移動的:40 ルート変更 d:M_R:前作スネークルート１５９
						mesg ＶＲ移動的 移動的:41 ルート変更 d:M_R:前作スネークルート１６０
						mesg ＶＲ移動的 移動的:42 ルート変更 d:M_R:前作スネークルート１６１
					}
					$b:ＡＣＴ７トラップ起動制御 = 1
				}
			}

	}


//###################################################################################
//									 ＢＧＭ
//###################################################################################

	// ------------------------------------
	// ＢＧＭの設定
	// ------------------------------------
	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT
			print 'bgm_set'
		#endif

		chara ＢＧＭマネージャー ＢＧＭマネ
	}


//###################################################################################
//									 アイテム
//###################################################################################

	// ------------------------------------
	// アイテムの設定
