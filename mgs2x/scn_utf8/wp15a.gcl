// ------------------------------------
// マップ設定
// ------------------------------------
chara マップ 武器訓練マシンガン５面 -k d:KMS_NAME -h d:HZX_NAME,0 -l $s:ＶＲライトファイル名

command マップ設定 武器訓練マシンガン５面 -set {
	// ローカルの初期化
	// ------------------------------------
	@ローカル変数初期化		// ローカルで使用する変数で初期化をする場合はここで

	// ＶＲで必要な基本プロックのセット(vr_common.hで定義)
	// サウンドの基本パック、ＶＲの基本システム、プレイヤー、ゴール等を設定します
	// ※このプロックを使用する時は「ＶＲクリア時処理」というプロックが必要です
	// ------------------------------------
	@ＶＲ共通プロックセット sna_wp15a rai_wp15a d:VR_GOAL_TARGET 6000 2000 -15000

	// ＶＲウィンドウの設定
	// ------------------------------------
	@武器訓練マシンガン５面ＶＲウィンドウ設定

	// クリア時に呼ばれるものの設定
	// ------------------------------------
	@ＶＲクリア設定 p:load_select p:load_wp15a

	// ステージに引かれるライン
	// ------------------------------------
	@ＶＲアウトライン d:KMS_NAME d:TONBO_KMS_NAME d:LINE_KMS_NAME

	// 設定値を変更する場合は以下のプロック内で設定
	// ------------------------------------
	@設定値変更				// 敵兵や的のパラメータをステージ限定で変える時はここで
	@プラグイン設定			// プレイヤーのプラグインがいる時はここで

	// 的関係の設定
	// ------------------------------------
	@ＶＲ標的マシンガン５面設定				// ＶＲシステム起動後に呼ぶ
	@ＡＣＴ７トラップ起動

	// ＢＧＭの設定(プレイヤー→敵兵→BGMの順で呼ぶ。的の場合は関係ないがとりあえずここに)
	// ------------------------------------
	@ＢＧＭ設定

	// アイテムの設定
	// ------------------------------------
	@アイテム設定

	// 光源、オブジェクト、カメラ関連の設定
	// ------------------------------------
	@ＶＲフォグ設定 d:VR_FOG:朝Ｎ d:VR_FOG:朝Ｆ d:VR_FOG:夕Ｎ d:VR_FOG:夕Ｆ d:VR_FOG:夜Ｎ d:VR_FOG:夜Ｆ
	@カメラセット						// chara カメラとベースのカメラを設定
	@武器訓練マシンガン５面カメラ設定	// ステージ固有のカメラ設定がいる時はこのプロックで
	@ＶＲキャラ用ライト設置				// vr_common.hに定義。必ず最後に設定
#if d:DEBUG_CHARA
//	@デバッグキャラセット
#endif

}

//初期マップの表示
command マップ表示 -show 武器訓練マシンガン５面


//###################################################################################
//									各proc設定
//###################################################################################



//###################################################################################
//									全マップ共通
//###################################################################################
	// ------------------------------------
	// 全マップ共通
	// ------------------------------------
	//------------------------------------------------------------
	// ＶＲウィンドウの設定と表示
	//------------------------------------------------------------
	proc 武器訓練マシンガン５面ＶＲウィンドウ設定 {
		#if d:DEBUG_PRINT
			print 'vr_window_set'
		#endif

		@ＶＲウィンドウ設定	[VRMSG_J:VRM_WPN_ASR_wp15a] [VRMSG_E:VRM_WPN_ASR_wp15a] [VRMSG_G:VRM_WPN_ASR_wp15a] \	// 日、英、独
							[VRMSG_F:VRM_WPN_ASR_wp15a] [VRMSG_I:VRM_WPN_ASR_wp15a] [VRMSG_S:VRM_WPN_ASR_wp15a] \	// 仏、伊、西
							[VRMSG_K:VRM_WPN_ASR_wp15a] \															// 韓
							p:ＶＲステージ開始時処理								// 終了プロック


		// ＶＲウィンドウを表示する
		mesg ＶＲウィンドウ ＶＲウィンドウ君 開く

		// スタート時とクリア時に使用するカットインカメラ
		chara カメラ カットインカメラ		-c 0 -l 0 -p 0

		// スタート時のカメラ(必要な場合)
		chara カメラ設定 カットインカメラ \
			-c 1 \	
			-p 6000,8600,-12650 -t 6000,2000,-15000 \
			-r 800,2048,0 -f 7000 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1
	}

	//------------------------------------------------------------
	// ステージ開始時処理
	//------------------------------------------------------------
	proc ＶＲステージ開始時処理 {
		#if d:DEBUG_PRINT
			print 'game_start!!!!!'
		#endif

		// プレイヤーやパッドの制御等を行う a_stdproc.hで定義
		@全ミッション共通ステージ開始時処理

		// カメラワークスタート(必要な場合)
		// 全体図
		chara カメラ設定 カットインカメラ \
			-c 1 \	
			-p 0,20000,35000 -t 0,13850,24700 \
			-r 350,2048,0 -f 12000 \
			-a 200 \
			-i 4 4 d:START_CAMERA_CHANGE_TIME d:START_CAMERA_CHANGE_TIME \
			-s 1

		chara delay ディレイ \
			-time d:START_CAMERA_CHANGE_TIME \
			-exec {
				chara カメラ設定 カットインカメラ -s -1
			}
	}

	// ------------------------------------
	// クリア時の処理
	// ------------------------------------
	proc ＶＲクリア時処理 {
		#if d:DEBUG_PRINT
			print 'clear'
		#endif

		// 強制モーションを発動
//		@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_2 407
		@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_2 682

		// クリア時にカメラアングルを変える
		chara カメラ設定 クリア時カメラ \
			-c 1 \
//			-p 8580,3320,-10600 -t 5660,3320,-14650 \
//			-r 0,2455,0 -f 5000 \
			-p 9100,3000,-13000 -t 5650,3050,-15000 \
			-r 4088,2730,0 -f 4000 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}

	//------------------------------------------------------------
	// ステージ開始直後処理
	//------------------------------------------------------------
	proc ゲーム開始直後処理 {
		// 初期配置標的の起動（command ＶＲステージスタート の起動直後に行う必要がある）
		@ＶＲ初期配置標的マシンガン５面設定
	}



	// ------------------------------------
	// パラメータ系の変更
	// ------------------------------------
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT
			print 'localvar_init'
		#endif

		// 的管理用各種フラグを初期化する
		$$b:act_1_破壊数カウント = 0;
		$$b:act_2_破壊数カウント = 0;
		$$b:act_3_破壊数カウント = 0;
		$$b:act_4_破壊数カウント = 0;
		$$b:act_5_破壊数カウント = 0;
		$$b:act_6_破壊数カウント = 0;
		$$b:act_7_破壊数カウント = 0;
		$$b:act_8_破壊数カウント = 0;
		$$b:act_9_破壊数カウント = 0;

		$$b:標的セット数 = 0;
		$$i:標的フラグ = 0;

		$$b:ＡＣＴ７トラップ起動制御 = 0

		// 他の担当ステージとは文法が違うので注意。
		$$i:標的フラグＣ１ = ( d:VR_TRG_CROSS | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_WAIT )
		$$i:標的フラグＣ２ = ( d:VR_TRG_CROSS | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_WAIT | d:VR_TRG_BLAST  )
		$$i:標的フラグＣ３ = ( d:VR_TRG_CROSS | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_WAIT | d:VR_TRG_NG     )
		$$i:標的フラグＣ４ = ( d:VR_TRG_CROSS | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_WAIT | d:VR_TRG_DIR    )
		$$i:標的フラグＣ５ = ( d:VR_TRG_CROSS | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_WAIT | d:VR_TRG_CIRCLE )

		$$i:標的フラグＯ１ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_WAIT )
		$$i:標的フラグＯ２ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_WAIT | d:VR_TRG_BLAST )
		$$i:標的フラグＯ３ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_WAIT | d:VR_TRG_NG    )

		$$i:標的フラグＨ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_WAIT  )
		$$i:標的フラグＴ = ( d:VR_TRG_OCT | d:VR_TRG_FL_MARK | d:VR_TRG_WAIT | d:VR_TRG_NG | d:VR_TRG_CIRCLE )
	}

	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT
			print 'status_set'
		#endif

		// 初期装備の設定
		if ( $s:選択プレイヤー == ライデン ) {
			// ライデン系を選択
			$w:武器弾数Ｒ[ d:武器:Ｍ４ ] = 991
			$w:武器 = d:武器:Ｍ４
		} else {
			// スネーク系を選択
			$w:武器弾数Ｒ[ d:武器:ＡＫＳ ] = 991
			$w:武器 = d:武器:ＡＫＳ
//			$w:アイテム = d:アイテム:ＡＫサプレッサ
		}

	}
	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif
	}



//###################################################################################
//									 的兵
//###################################################################################

	// ------------------------------------
	// マシンガン５面
	// ------------------------------------

	// 破壊時処理
	// ------------------------------------
	proc ＶＲ標的破壊マシンガン５面処理 {

		// ライデン or タキシードスネークを選択
		if ( ($s:選択プレイヤー == ライデン) ||  ($s:選択プレイヤー == タキシードスネーク) ) {

			// act 1 ----------
