block codec RPD_P004_02_R01_ノード初接続２無線デモ１ 14085 d:大佐無線２潜水ライデン {
	@rp_無線デフォルト前処理
	//eval($f:rfp_タンカーやった = 1)
	@rpd_潜水ライデン顔設定１
	@rpd_大佐顔設定１
	@rpd_顔表示
	
	@vc110401
	if($w:タンカー編クリア回数 >= 1){
		@vc110402
	}else {
		@vc110403
	}

	//むうび
	@vc110407

	@vc110404
	//ローズさん登場
command セットサウンドコード -c d:SNG_FOUTP_S
	@vc110405
	//周波数代え！ＸＸＸ
	setfreq 14096
	wait 300
	@vc110406
	@rp_短縮ダイアル＿ローズセット
}

