proc rpd_どこの爆弾ですか {
	if($s:エリア == "w12b") {
		@rp_PP_爆弾報告＿場所＿Ａ脚１
		@rp_PP_爆弾報告＿場所＿Ａ脚２

	}else if($s:エリア == "w12a") {
		@rp_PP_爆弾報告＿場所＿Ａ脚１

	}else if($s:エリア == "w14a") {
		@rp_PP_爆弾報告＿場所＿Ｂ脚１
		@rp_PP_爆弾報告＿場所＿Ｂ脚２
		
	}else if($s:エリア == "w16b"){
		@rp_PP_爆弾報告＿場所＿Ｃ脚１
		@rp_PP_爆弾報告＿場所＿Ｃ脚２

	}else if($s:エリア == "w18a") {
		@rp_PP_爆弾報告＿場所＿Ｄ脚１
		if($w:ゲーム設定 <= d:LEVEL_HARD){
			@rp_PP_爆弾報告＿場所＿Ｄ脚２
		}
	}else if($s:エリア == "w20a") {
		@rp_PP_爆弾報告＿場所＿Ｅ脚１
		@rp_PP_爆弾報告＿場所＿Ｅ脚２

	}else if( ($s:エリア == "w20b") || ($s:エリア == "w20c") ){
		@rp_PP_爆弾報告＿場所＿Ｅ脚屋上１
		@rp_PP_爆弾報告＿場所＿Ｅ脚屋上ハリアー

	}else if($s:エリア == "w22a") {
		@rp_PP_爆弾報告＿場所＿Ｆ脚１
		@rp_PP_爆弾報告＿場所＿Ｆ脚２
	}
}




