//P001_02_R01_オープニング潜入２無線デモ１
block codec RPD_P001_02_R01_オープニング潜入２無線デモ１ 14085 d:大佐無線２潜水ライデン {
//	eval($f:rfp_タンカーやった = 1)
	@rpd_潜水ライデン顔設定１
	@rpd_大佐顔設定１
	@rpd_顔表示
	@rp_無線デフォルト前処理
	
	@vc110101
	if($w:タンカー編クリア回数 >= 1){
		@vc110102
		@vc110103
	}else {
		@vc110104
	}
	@vc110105
	@vc110106
	//昇降機むぅび
	@vc110107
	@vc110108
	eval($w:p_story = d:ST:P001_02_R01オープニング潜入２無線デモ１終了)
	@rp_短縮ダイアル＿大佐セット
}


