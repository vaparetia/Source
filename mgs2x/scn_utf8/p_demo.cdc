block codec RPD_P023_01_R01_爆弾解体最後の一つ１無線デモ１ 14025 d:ピーター＿プリスキン {
	@rp_無線デフォルト前処理
	@rpd_ライデン顔設定１
	@rpd_ピーター顔設定１
	@rpd_顔表示

	@vc112301

	//センサーＢ持っていない場合ＸＸＸＸＸ
	if($w:アイテム数Ｒ[d:アイテム:センサーＢ] <= 0) {
		@vc112302
	//持っている場合ＸＸＸＸ
	}else {
		@rp_PP_センサーＢ＿割り込み用
		eval($f:rfp_爆弾解体最後の一つ時センサーＢ持ってた = 1)
	}

	@vc112303	//使えるのか……ここで試した……

	//センサーＢ持っていない場合ＸＸＸＸＸ
	if($w:アイテム数Ｒ[d:アイテム:センサーＢ] <= 0) {
		@vc112304	//私のいた貯蔵庫に……
	}

	@rpd_プリスキン顔表示
	@vc112305

}

block codec RPD_P024_01_R01_爆弾解体センサーＢ入手１無線デモ１ 14025 d:ピーター＿プリスキン {
	@rp_無線デフォルト前処理
	@rpd_ライデン顔設定１
	@rpd_ピーター顔設定１
	@rpd_顔表示

	//センサーＢをここで入手した場合
	if(!$f:rfp_爆弾解体最後の一つ時センサーＢ持ってた) {
		@vc112401
	}
	
	@vc112407
	//SE鳴らす？分けなくても良い？ＸＸＸＸＸＸＸ
	@vc112406

	if($w:ゲーム設定 >= d:LEVEL_EXTREME){
		//難易度別分岐 カウント２００ ＸＸＸＸＸＸｘ
		@vc112402
	
	}else if($w:ゲーム設定 >= d:LEVEL_HARD){
		//難易度別分岐 カウント３００ ＸＸＸＸＸＸｘ
		@vc112403
	}else {
		//難易度別分岐 カウント４００ ＸＸＸＸＸＸｘ
		@vc112404
	}
	@vc112405
	if($f:センサーＢ無線中にフェードアウト処理する){
		command セットサウンドコード -c d:SNG_FOUTS_S
	}
}


