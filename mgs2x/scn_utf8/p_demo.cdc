block codec RPD_P070_10_R01_ＡＧ起動１０無線機デモ１ 14096 d:大佐無線１ {
	@rp_無線デフォルト前処理
	@rpd_ライデン顔設定デフォルト
	noise 1 1
	@rpd_ローズ顔設定１
	@rpd_顔表示

	@vc117001
	//セーブするしない選択肢ＸＸＸＸＸＸＸＸｘ
//	@vc_p_dummy_save
	@rp_ＳＡＶＥデフォルトセット
	eval($f:P070_10_R01_ＡＧ起動１０無線機デモ１後から始めます = 1)
	eval( $w:現ステージ番号 = d:ステージ名:シェル１中央棟Ｂ２電算室 );
	command varsave 

	//ＳＡＶＥする選んだ場合
	if($w:rfp_ＳＡＶＥ選択肢返り値 == 0){
		savemode
		eval($b:rfp_ＳＡＶＥした結果 = $status)
	}
	if( ($w:rfp_ＳＡＶＥ選択肢返り値 == 0) && ($b:rfp_ＳＡＶＥした結果 == 0) ){
		@vc117002

	//ＳＡＶＥしなかった
	}else {
		@rp_PR_無言ローズ
	}
	//ＳＡＶＥしない場合は適当
	eval($f:P070_10_R01_ＡＧ起動１０無線機デモ１後から始めます = 0)
	command varsave $f:P070_10_R01_ＡＧ起動１０無線機デモ１後から始めます
}


