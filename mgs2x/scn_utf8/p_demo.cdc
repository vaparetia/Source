block codec RPD_P011_01_R01_ＢＣ連絡橋ＣＡＬＬ１無線デモ１ 14085 d:大佐無線１ {
	@rp_無線デフォルト前処理
	@rpd_ライデン顔設定１
	@rpd_ローズ顔設定１
	@rpd_顔表示

	@vc111101

	//セーブしますか選択ＸＸＸＸＸＸＸｘ
//	@vc_p_dummy_save
	eval($f:w14aローズからの無線を受信済み = 1)
	eval($f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:ＢＣ連絡橋ＣＡＬＬ１無線デモ] = 1)
	command varsave  $f:w14aローズからの無線を受信済み $f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:ＢＣ連絡橋ＣＡＬＬ１無線デモ]
	@rp_ＳＡＶＥデフォルトセット
	if($w:rfp_ＳＡＶＥ選択肢返り値 == 0){
		@rp_ＳＡＶＥ実体
	}
	@vc111102
}



