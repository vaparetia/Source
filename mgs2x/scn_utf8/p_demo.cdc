	@rpd_裸ライデン顔設定１
	@rpd_ローズ顔設定１
	@rpd_顔表示
	
	eval($w:p_story =  d:ST:P070_23_R04ＡＧ起動２３無線機デモ４終了)
	//	プレイヤー初期位置を代入
	eval($i:プレイヤー初期Ｘ位置 = -2000)
	eval($i:プレイヤー初期Ｚ位置 = -3400)
	//	リスタートかけてゲームに戻る
	eval ($f:w41a_主観デモ完全終了フラグ = d:TRUE)
	eval ($s:登場ポイント = 拷問直後)
	command varsave 

	@vc117031
	eval($f:w41a_主観デモ完全終了フラグ = 0)
	command varsave
}


