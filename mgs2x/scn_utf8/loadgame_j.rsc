resource ロードゲームリソース {
// 0
メモリーカードが見つからなかった:
	'メモリーカード(PS2)が見つかりません',

// 1
メモリーカードにファイルが無い:
	'ファイルが見つかりません',

// 2
確認:
	'これでよろしいですか？',

// 3
ファイルロード:
	'ファイルのロード中',

// 4
成功:
	'ファイルのロードが正常に終了しました',

// 5
失敗:
	'ファイルのロード中にエラーが発生しました',
};
