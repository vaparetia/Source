//				d:武器:スタン \			// 11
//				d:武器:マイク \			// 12
//				d:武器:ブレード,		// 13
//				d:武器:凍結スプレー \	// 14
//				d:武器:ＡＫＳ \			// 15
//				d:武器:マガジン \		// 16
//				d:武器:グレネード \		// 17
