// 各種スイッチ用define
// ------------------------------------
// サウンド
#define		SOUND			1		// サウンドデータは最初に呼ぶ
#define		BGM				1		// BGMは敵兵コマンダーの後に呼ぶ
// キャラクター関係
#define		RAIDEN			1		// SNAKEとは排他
#define		SNAKE			0
#define		ENEMY			0		// コマンダーと警備兵(敵を出すときは必須)
#define		SUPPORT			0		// サポート兵
#define		ATTACKER		0		// 攻撃兵
#define		SHIELD			0		// 盾兵(1) or 通常攻撃兵(0)
// 監視カメラ関係
#define		CYPHER			0		// サイファー
// ドア
#define		SLIDE_DOOR		0		// スライドドア
// 入出トラップ
#define		LOAD_TRAP		0
#define		STAGE_END		0		// ステージ終了時処理を使用可にする
// フォグ
#define		FOG				1
// エフェクト関係
#define		EFFECT			0		// エフェクト全般
#define		BLUR			0		// ブラー
#define		Z_MANAGER		0		// Ｚフォーカス管理(敵のライト等で仕様)
#define		BODY_SHADOW		0		// 敵のライトによって出る影
// 子画面
#define		SUB_CAMERA		0
// カメラ関係
#define		CLEAR_CAMERA	0		// クリアリング専用カメラ(要子画面)

// 天井
#define		CHARA_CEIL		0		// 天井君
// 透明壁
#define		TR_WALL			0		// シナリオ置きの透明壁
// ライト関係
#define		SPOT_LIGHT		0		// スポットライト
// オブジェ関係

// ボス関係
#define		METAL			1		// メタル

// アイテム
#define		ITEM			0
// 強制モーション
#define		BY_MOTION		1		// ビヨンドモーション

// デバッグ関係
#ifdef	d:FIX_MODE
	#define		DEBUG_CHARA		0		// デバッグキャラ全体(FIX時は0)
#else
	#define		DEBUG_CHARA		0		// デバッグキャラ全体
#endif
#define		CHARA_CAMERA	0		// キャラ追従カメラ
#define		TARGET_CHARA	敵兵:01	// キャラ追従カメラのターゲット
#define		SCREENSHOT		0		// スクリーンショット
#define		USB_KEY			0		// USBキーボード


// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME			w46a
#define		KMS_NAME0			w46a
#define		LT2_NAME			w46a

// キャラクター関係
#if d:RAIDEN
	#define		PLAYER		ライデン	// モーションができるまで名前はスネーク
#else
	#define		PLAYER		スネーク
#endif

//	薬莢系

//	ステージ系
#define			STAGE_W46A			1

#define			STAGE_PLANT			1	//	プラント編

#define			POLYDEMO_LOAD		1

// ローカル変数
//	$f:w46a_メタル登場フラグ				//	メタルが登場したかどうかのフラグ

//	$i:w46a_メタル戦終了撃墜数				//	メタル戦を終了させるために必要な撃墜数
//	$f:w46a_スティンガー弾01フラグ			//	アイテム再発生用のフラグ
//	$f:w46a_スティンガー弾02フラグ			//	アイテム再発生用のフラグ
//	$f:w46a_スティンガー弾03フラグ			//	アイテム再発生用のフラグ
//	$f:w46a_スティンガー弾04フラグ			//	アイテム再発生用のフラグ
//	$f:w46a_スティンガー弾05フラグ			//	アイテム再発生用のフラグ
//	$f:w46a_スティンガー弾06フラグ			//	アイテム再発生用のフラグ

//	$f:w46a_レーション01フラグ				//	アイテム再発生用のフラグ
//	$b:w46a_レーションカウント				//	レーションの再発生制限用

//	$i:w46a_メタル戦撃墜数					//	メタル撃墜数

// include
// ------------------------------------
#include "stdch.h"
#include "sload.h"
//#include "beyond.h"
#include "sound.h"
#include "enevoice.h"
#include "item_info.h"
#include "obl_trap.h"

#if d:USB_KEY
	#include "usbkbd.h"
#endif

#include "w46a_d_common.h"	//	デモ／ゲーム共通プロック

#include "boss_stdproc.h"	//	ボスラッシュ用


// マップ設定

//	ボスラッシュ以外のとき
#ifndef d:BOSS_MODE

// ------------------------------------
chara マップ メタル戦ステージ	\
	-k d:KMS_NAME0 \
	-h d:HZX_NAME,0 \
	-l d:LT2_NAME

// 平野追加。デモ再生用ヘッダ。この位置を変えないこと。
#include "polydemo_w46a.h"

command マップ設定 メタル戦ステージ -set {

	// 平野追加。デモ呼び分け用。
	if ($s:d_num == not_demo) {
		#if d:SOUND	
		@サウンド設定	// データは最初に呼ぶ
		#endif
	}
	@常駐キャラ設定

	// 平野追加。デモ呼び分け用。
	if ($s:d_num == not_demo) {
		@ローカル変数初期化
		@設定値変更
		@プラグイン設定
		@プレイヤー設定
		@亀甲床設定
		@刀設定
		#if d:BGM	
		@ＢＧＭ設定	// プレイヤー→敵兵→BGMの順で呼ぶ
		#endif

		#if d:METAL
		@メタル戦設定
		#endif

		#if d:FOG
		@フォグ設定
		#endif
		#if d:EFFECT
		@エフェクト設定
		#endif
		@息設定
		@空設定
		@もやもや管理
		@雷管理
//		@仮ステージ設定
		@アイテム設定
		@カメラセット
		@メタル戦ステージカメラ設定
		#if d:DEBUG_CHARA
		@デバッグキャラセット
		#endif

		@インタラクティブデモ１設定
//			@仮デモ設定
		@レーダーオフ設定
		@装備禁止設定

		if ($f:w41a_ノードフラグ == 1) {
			@プラント編全体マップ設定  d:アーセナルギア直腸	//	全体マップ表示
		} else {
			@ポーズ時ステージ名表示設定 d:wn_アーセナルギア直腸	//	ポーズ時ステージ名表示
		}

		@キャラ用ライト設定		// マップ設定の最後に呼ぶ

		// ボスラッシュ用extern宣言。任意のマップ設定の中に入れておけばＯＫ
		@ボスラッシュ開始時キャラ設定
	}
}

// 無線用include ※位置は動かさないこと
#include "w46a_cdc.ch"

//初期マップの表示
command マップ表示 -show メタル戦ステージ

// 全てのセットが終わったところでフェードイン
	// 平野追加。デモ呼び分け用。
	if($s:d_num == not_demo){
		@メタル戦開始時処理
	} else {
	//	フェードインはデモ任せ
/*
		chara フェードインアウト フェードイン \
			-i 0,0,0 128 \
			-c 0,0,0 0 \
			-t d:FADEIN_TIME
*/
	}

#endif

//###################################################################################
//									各proc設定
//###################################################################################



//###################################################################################
//									全マップ共通
//###################################################################################
	proc サウンド設定 {
		#if d:DEBUG_PRINT 
			print 'sound_set'
		#endif
		chara サウンドマネージャー ＳＤマネ -pak 0

		@サウンド効果音設定
		command 弾痕ノーマル -n 0
		command 跳弾ノーマル -n 0
	}

	proc ローカル変数初期化 {
//	ボスラッシュ以外は
#ifndef d:BOSS_MODE
		#if d:DEBUG_PRINT 
			print 'localvar_init'
		#endif
		eval ($f:w46a_スティンガー弾01フラグ = d:FALSE)
		eval ($f:w46a_スティンガー弾02フラグ = d:FALSE)
		eval ($f:w46a_スティンガー弾03フラグ = d:FALSE)
		eval ($f:w46a_スティンガー弾04フラグ = d:FALSE)
		eval ($f:w46a_スティンガー弾05フラグ = d:FALSE)
		eval ($f:w46a_スティンガー弾06フラグ = d:FALSE)
		eval ($f:w46a_レーション01フラグ = d:FALSE)
//		eval ($b:w46a_レーションカウント = 0)
		eval ($i:w46a_メタル戦撃墜数 = 0)

		//	デモ後特殊装備外す
		@デモ後武器アイテム制御 d:デモ後前を継続 d:デモ後特殊装備なし

		//	武器をソーコムかＭ９に変える
		//	Ｍ９だったら
		if ($w:武器 == d:武器:Ｍ９) {
			eval ($w:武器 = d:武器:Ｍ９)
			eval ( $w:プレイヤーフラグ = $w:プレイヤーフラグ & ~d:PL_START_STATE_BLADE_OUT )
		//	Ｍ９以外だったら
		} else {
			//	武器をソーコムに変える
			if ($w:武器 != d:武器:ソコム) {
				eval ($w:武器 = d:武器:ソコム)
				eval ( $w:プレイヤーフラグ = $w:プレイヤーフラグ & ~d:PL_START_STATE_BLADE_OUT )
			}
		}

//	ボスラッシュ時の処理
#else
		eval ($f:w46a_スティンガー弾01フラグ = d:FALSE)
		eval ($f:w46a_スティンガー弾02フラグ = d:FALSE)
		eval ($f:w46a_スティンガー弾03フラグ = d:FALSE)
		eval ($f:w46a_スティンガー弾04フラグ = d:FALSE)
		eval ($f:w46a_スティンガー弾05フラグ = d:FALSE)
		eval ($f:w46a_スティンガー弾06フラグ = d:FALSE)
		eval ($f:w46a_レーション01フラグ = d:FALSE)
//		eval ($b:w46a_レーションカウント = 0)
		eval ($i:w46a_メタル戦撃墜数 = 0)

		//	すぐにRAYが登場
		eval($f:w46a_メタル登場フラグ = d:TRUE)

		//	ねんのためプレイヤー登場位置再代入
		eval( $s:登場ポイント = メタル戦開始)
		eval( $i:プレイヤー初期Ｘ位置 = 0 )
		eval( $i:プレイヤー初期Ｙ位置 = 4000 )
		eval( $i:プレイヤー初期Ｚ位置 = -2000 )
		eval ($i:プレイヤー初期方向 = 2048)
#endif
	}

	proc 設定値変更 {
		#if d:DEBUG_PRINT 
			print 'status_set'
		#endif

		command スティンガー性能 \
			-life 240 \
			-s 0,-250 ,0


		if ($w:ゲーム設定 == d:LEVEL_VERYEASY) {
				//	メタル戦を終了させるために必要な撃墜数
				eval ($i:w46a_メタル戦終了撃墜数 = 3)

		} else if ($w:ゲーム設定 == d:LEVEL_EASY) {
				//	メタル戦を終了させるために必要な撃墜数
//				eval ($i:w46a_メタル戦終了撃墜数 = 3)
				eval ($i:w46a_メタル戦終了撃墜数 = 5)

		} else if ($w:ゲーム設定 == d:LEVEL_NORMAL) {
				//	メタル戦を終了させるために必要な撃墜数
//				eval ($i:w46a_メタル戦終了撃墜数 = 5)
				eval ($i:w46a_メタル戦終了撃墜数 = 7)

		} else if ($w:ゲーム設定 == d:LEVEL_HARD) {
				//	メタル戦を終了させるために必要な撃墜数
				eval ($i:w46a_メタル戦終了撃墜数 = 10)

		} else if ($w:ゲーム設定 >= d:LEVEL_EXTREME) {
				//	メタル戦を終了させるために必要な撃墜数
				eval ($i:w46a_メタル戦終了撃墜数 = 20)

		}


	}
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif
		command プラグインブレード -m rai_blade
	}

//###################################################################################
//									 プレイヤー
//###################################################################################

	proc プレイヤー設定 {
		#if d:DEBUG_PRINT
			print 'player_set'
		#endif

		#if d:RAIDEN
			chara プレイヤー d:PLAYER \
				-p $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,$i:プレイヤー初期Ｚ位置 \
				-d 0,$i:プレイヤー初期方向,0 \
				-s 0 \
				-m rai_def -a raiden -o rai_w46a \
				-f d:PLY_NO_FOOT_SHADOW

				//髪の毛
				@ライデン髪の毛設定 d:NORMAL_HAIR

				//	ＬＯＤ機能
				@プレイヤーＬＯＤ設定 d:C_DISTANCE_TYPE 5000

		#else if d:SNAKE
			chara プレイヤー d:PLAYER \
				-p $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,$i:プレイヤー初期Ｚ位置 \
				-d 0,$i:プレイヤー初期方向,0 \
				-s 0 \
				-m sna_def -a snake -o rai_w46a

				//バンダナ
				chara ロープモデル３ バンダナ１ \
					-n sna_bdn1 \
					-d 1 \
					-y スネーク \
					-z 12 \
					-x 0,60,-90 \
					-m 12 \
					-p 250 \
					-k 350 \
					-o 110 \
					-f 1

				chara ロープモデル３ バンダナ２ \
					-n sna_bdn2 \
					-d 1 \
					-y スネーク \
					-z 12 \
					-x 0,50,-90 \
					-m 22 \
					-p 250 \
					-k 350 \
					-o 110 \
					-f 1
		#endif
	}



//###################################################################################
//								武器設定
//###################################################################################

	proc 刀設定 {
		eval ( $w:武器最大数Ｒ[ d:武器:ブレード ] = 1 )
		eval ( $w:武器弾数Ｒ[ d:武器:ブレード ] = 1 )
//		eval ( $w:武器最大数[ d:武器:ブレード ] = 1 )
//		eval ( $w:武器弾数[ d:武器:ブレード ] = 1 )
	}



//###################################################################################
//								敵兵
//###################################################################################

	proc メタル戦設定 {

		if ($f:w46a_メタル登場フラグ == d:TRUE) {
			#if d:DEBUG_PRINT
			print 'set pdray'
			#endif
//	日本語版以降こちらを使う
#if 1
			chara	ＲＡＹサーバー設置 ray_server \
				-num $i:w46a_メタル戦終了撃墜数 \
				-proc メタル破壊２
#else
			chara	ＲＡＹサーバー設置 ray_server
#endif
	//		レイ配置
			chara 量産型ＲＡＹ設置 ray1 \
				-pos 0,0,-400000 \
				-dir 0,0,0 \
				-end_proc メタル破壊 \
				-resource pdray_def_mt pdray

			chara 量産型ＲＡＹ設置 ray2 \
				-pos 10000,0,-380000 \
				-dir 0,0,0 \
				-end_proc メタル破壊 \
				-resource pdray_def_mt pdray
			chara 量産型ＲＡＹ設置 ray3 \
				-pos -10000,0,-390000 \
				-dir 0,0,0 \
				-end_proc メタル破壊 \
				-resource pdray_def_mt pdray

			chara 量産型ＲＡＹ設置 ray4 \
				-pos 20000,0,-360000 \
				-dir 0,0,0 \
				-end_proc メタル破壊 \
				-resource pdray_def_mt pdray
			chara 量産型ＲＡＹ設置 ray5 \
				-pos -20000,0,-370000 \
				-dir 0,0,0 \
				-end_proc メタル破壊 \
				-resource pdray_def_mt pdray

			chara 量産型ＲＡＹ設置 ray6 \
				-pos 30000,0,-340000 \
				-dir 0,0,0 \
				-end_proc メタル破壊 \
				-resource pdray_def_mt pdray
			chara 量産型ＲＡＹ設置 ray7 \
				-pos -30000,0,-350000 \
				-dir 0,0,0 \
				-end_proc メタル破壊 \
				-resource pdray_def_mt pdray

			chara 量産型ＲＡＹ設置 ray8 \
				-pos 40000,0,-320000 \
				-dir 0,0,0 \
				-end_proc メタル破壊 \
				-resource pdray_def_mt pdray
			chara 量産型ＲＡＹ設置 ray9 \
				-pos -40000,0,-330000 \
				-dir 0,0,0 \
				-end_proc メタル破壊 \
				-resource pdray_def_mt pdray

			chara 量産型ＲＡＹ設置 ray10 \
				-pos 50000,0,-300000 \
				-dir 0,0,0 \
				-end_proc メタル破壊 \
				-resource pdray_def_mt pdray
			chara 量産型ＲＡＹ設置 ray11 \
				-pos -50000,0,-310000 \
				-dir 0,0,0 \
				-end_proc メタル破壊 \
				-resource pdray_def_mt pdray

			chara 量産型ＲＡＹ設置 ray12 \
				-pos 60000,0,-280000 \
				-dir 0,0,0 \
				-end_proc メタル破壊 \
				-resource pdray_def_mt pdray
			chara 量産型ＲＡＹ設置 ray13 \
				-pos -60000,0,-290000 \
				-dir 0,0,0 \
				-end_proc メタル破壊 \
				-resource pdray_def_mt pdray

			chara 量産型ＲＡＹ設置 ray14 \
				-pos 70000,0,-260000 \
				-dir 0,0,0 \
				-end_proc メタル破壊 \
				-resource pdray_def_mt pdray
			chara 量産型ＲＡＹ設置 ray15 \
				-pos -70000,0,-270000 \
				-dir 0,0,0 \
				-end_proc メタル破壊 \
				-resource pdray_def_mt pdray

			chara 量産型ＲＡＹ設置 ray16 \
				-pos 80000,0,-240000 \
				-dir 0,0,0 \
				-end_proc メタル破壊 \
				-resource pdray_def_mt pdray
			chara 量産型ＲＡＹ設置 ray17 \
				-pos -80000,0,-250000 \
				-dir 0,0,0 \
				-end_proc メタル破壊 \
				-resource pdray_def_mt pdray

			chara 量産型ＲＡＹ設置 ray18 \
				-pos 90000,0,-220000 \
				-dir 0,0,0 \
				-end_proc メタル破壊 \
				-resource pdray_def_mt pdray
			chara 量産型ＲＡＹ設置 ray19 \
				-pos -90000,0,-230000 \
				-dir 0,0,0 \
				-end_proc メタル破壊 \
				-resource pdray_def_mt pdray

			chara 量産型ＲＡＹ設置 ray20 \
				-pos 100000,0,-200000 \
