//###################################################################################
//									 カメラ
//###################################################################################

	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0 
		chara カメラ メインカメラ		-c 0 -l 2 -p 50

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \	
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 126,2048,0 -f 10000 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}

	proc メタル戦ステージカメラ設定 {
		
		// カメラ
		if  ($w:p_story < d:ST:P079_03_P02ＲＡＹ戦前３ポリゴンデモ２終了) {
			trap ca001 d:PLAYER \
				-camera \
				-mask ？\
				-exec {
					chara カメラ設定 メインカメラ \
						-c 0 \	
						-b d:CAM_MIN,4934,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
//						-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
						-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,5246,d:CAM_MAX \
						-r 3981,1883,0 -f 3540 \
						-a 200 \
						-i 2 2 0 0 \
						-z d:CAMERA_NO_CUSHION \
						-s $3
				}
		}
	}

//###################################################################################
//									デモ設定
//###################################################################################

	proc インタラクティブデモ１設定 {
		if ($w:p_story < d:ST:P079_02_I01ＲＡＹ戦前２インタラクティブ移動可能デモ１開始) {
			//	ストーリーフラグを立てる
			eval ($w:p_story = d:ST:P079_02_I01ＲＡＹ戦前２インタラクティブ移動可能デモ１開始)

			//	ストリーム再生
			eval ( $i:STREAM_ID = `%Stream t:vc107901 -p インタラクティブデモ１終了` )
			chara delay ディレイ -time 1 -exec{
				if($i:STREAM_ID < 0){
					eval ( $i:STREAM_ID = `%Stream t:vc107901 -p インタラクティブデモ１終了` )
					return 1
				}else{
					return 0
				}
			}

			//	無線機　ポーズには入れない
			command メニュー設定 \
				-radio off -pause off

			//	デジカメは選べない
			command	不可装備設定 \
				-item \
				d:アイテム:デジカメ

/*
//	キャンセルはさせない
			//	キャンセル可
			chara デモキャンセルチェック インタラクティブデモ１キャンセル -p インタラクティブデモ１終了
*/
		}
	}
	proc インタラクティブデモ１終了 {
		if(`command ゲームオーバーチェック` == 1) {
			return
		}

		mesg デモキャンセルチェック インタラクティブデモ１キャンセル kill
		//	ストーリーフラグを立てる
		eval ($w:p_story = d:ST:P079_02_I01ＲＡＹ戦前２インタラクティブ移動可能デモ１終了)

		//	メタル登場フラグを立てる
		eval ($f:w46a_メタル登場フラグ = d:TRUE)

		//	プレイヤー登場位置再代入
		eval( $s:登場ポイント = メタル戦開始)
		eval( $i:プレイヤー初期Ｘ位置 = 0 )
		eval( $i:プレイヤー初期Ｙ位置 = 4000 )
		eval( $i:プレイヤー初期Ｚ位置 = -2000 )
		eval ($i:プレイヤー初期方向 = 2048)

		if($w:アイテム == d:アイテム:ゴル兵制服){
			//	ストーリーフラグを立ててロードでデモへ
			@ポリゴンデモロード d:ST:P079_03_P02ＲＡＹ戦前３ポリゴンデモ２開始
		} else {
			//	ストーリーフラグを立ててリスタートでデモへ
			@ポリゴンデモスタート d:ST:P079_03_P02ＲＡＹ戦前３ポリゴンデモ２開始
		}

	}

	proc ポリデモロードスタート {
		if ($w:p_story <= d:ST:P079_03_P02ＲＡＹ戦前３ポリゴンデモ２開始) {
			//	レジデント５へ読み替える
			load "w46a" -r 'r_plt5'
		} else {
			//	別ステージへ
			@mv_w46a_d080p01_0
		}
	}



	proc メタル破壊 {
	//	日本語版以降こちらは使わない
	#if 0
		print 'HAKAI_HAKAI_HAKAI_HAKAI_HAKAI_HAKAI_HAKAI_HAKAI_HAKAI_HAKAI_HAKAI_HAKAI_HAKAI_HAKAI_HAKAI' 
		print '$i:w46a_メタル戦終了撃墜数' $i:w46a_メタル戦終了撃墜数

		eval($i:w46a_メタル戦撃墜数 = $i:w46a_メタル戦撃墜数 + 1 )
		print '$i:w46a_メタル戦撃墜数' $i:w46a_メタル戦撃墜数

		if ($i:w46a_メタル戦撃墜数 == $i:w46a_メタル戦終了撃墜数) {
			@メタル戦終了

		//	全て倒しても終了（保険のため）
		} else if ($i:w46a_メタル戦撃墜数 == 25) {
			@メタル戦終了
		}
	#endif
	}

	proc メタル破壊２ {
		@メタル戦終了
	}


	proc メタル戦終了判定 {
		chara プロック連続実行 メタル戦終了管理 \
			-exec {
				//	ステージ上のアイテムがすべてなくなった
				if ( ($f:w46a_スティンガー弾01フラグ == 0) && ($f:w46a_スティンガー弾02フラグ == 0) && \
					 ($f:w46a_スティンガー弾03フラグ == 0) && ($f:w46a_スティンガー弾04フラグ == 0) && \
					 ($f:w46a_スティンガー弾05フラグ == 0) && ($f:w46a_スティンガー弾06フラグ == 0) ) {

					//	スティンガーの弾数がゼロのとき
					if ($w:武器弾数Ｒ[ d:武器:スティンガー  ] == 0) {
							@メタル戦終了
					}
					
				}
			}
	}

	proc メタル戦終了 {
//	ボスラッシュ以外は
#ifndef d:BOSS_MODE
		//	体力はマックスまで回復
		eval ($w:体力 =$w:体力最大)
		//	アイテム収得可能範囲を元に戻す
		command アイテム収得可能範囲設定 \
			300 \ // デフォルト  300 (2001.7/3現在)
			1500 \ // デフォルト 1500 (2001.7/3現在)
			300   // デフォルト  300 (2001.7/3現在)
		//	ＢＧＭフェードアウト
		mesg サウンドマネージャー ＳＤマネ SD_CODE d:SNG_FOUTS_S

		//	ストーリーフラグを立ててロードでデモへ
		@ポリゴンデモロード d:ST:P080_01_P01ＡＧ浮上１ポリゴンデモ１開始
		//	先読み
		preseek 'd080p01'

//	ボスラッシュ時の処理
#else
		@ボスラッシュ終了時処理
#endif
	}


	proc 仮デモ設定 {
		if ($w:p_story < d:ST:P079_02_I01ＲＡＹ戦前２インタラクティブ移動可能デモ１開始) {
			//	ストーリーフラグを立てる
			eval ($w:p_story = d:ST:P079_02_I01ＲＡＹ戦前２インタラクティブ移動可能デモ１開始)
			//	仮インタラクティブデモ
			chara デバッグポーズ インタラクティブデモ１ 'INTARACTIVE_DEMO1' -p インタラクティブデモ１終了
		} else if ($w:p_story < d:ST:P080_01_P01ＡＧ浮上１ポリゴンデモ１開始) {
			//	メタル戦
			chara デバッグポーズ メタル戦 'VS METAL' -p メタル戦終了
		}
	}



