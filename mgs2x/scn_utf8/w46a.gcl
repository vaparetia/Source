				d:武器:雑誌				// 21
	}





// 以下デバッグ専用proc
// -----------------------------------------------------------------------------------
// デバッグキャラ
// ------------------------------------
proc デバッグキャラセット {
	#if d:DEBUG_PRINT
		print 'debug_chara_set'
	#endif

	#if d:CHARA_CAMERA
		chara キャラカメラ 敵兵カメラ \
			-c d:TARGET_CHARA \
			-s -920,610,200 \
			-r -200,1024,0 
	#endif

	#if d:SCREENSHOT
		chara スクリーンショット shot
	#endif

	#if d:USB_KEY
		chara USBキーボード実行 test \
			-e d:KBD_ESC {	
				mesg プレイヤー d:PLAYER position -5500, -13000, -500
			} \
	#endif

	// 実験用ＲＡＹ（2001.2.15 松花追加）
/*
	#if d:DEBUG_PRINT
	print 'Ray1_test'
	#endif
	chara プットオブジェ Ray1_test -m ryousan_metal -r 0,0,0 -p       0,0,-30000 -s 100,100,100 -l d:LT2_NAME -f 0x20
	chara プットオブジェ Ray2_test -m ryousan_metal -r 0,0,0 -p  10000,0,-20000 -s 100,100,100 -l d:LT2_NAME -f 0x20
	chara プットオブジェ Ray3_test -m ryousan_metal -r 0,0,0 -p -10000,0,-30000 -s 100,100,100 -l d:LT2_NAME -f 0x20

	chara プロック連続実行 Ray1_test_move \
		-time -1 \
		-exec {
			eval( $w:実験ＲＡＹ１角度   = (($w:実験ＲＡＹ１角度   +  5) & 4095) );
			eval( $w:実験ＲＡＹ１角度２ = (($w:実験ＲＡＹ１角度２ +  8) & 4095) );
			eval( $i:実験ＲＡＹ１Ｙ軸方向 = (($i:実験ＲＡＹ１Ｙ軸方向 - 2) & 4095) );
			eval( $i:実験ＲＡＹ１位置Ｘ   = (`command cos $w:実験ＲＡＹ１角度`) * 3 );
			eval( $i:実験ＲＡＹ１位置Ｙ   = 0 );
			eval( $i:実験ＲＡＹ１位置Ｚ   = (`command sin $w:実験ＲＡＹ１角度２`) * 3 - 30000 );
			mesg プットオブジェ Ray1_test turn 0 $i:実験ＲＡＹ１Ｙ軸方向 0
			mesg プットオブジェ Ray1_test move $i:実験ＲＡＹ１位置Ｘ $i:実験ＲＡＹ１位置Ｙ $i:実験ＲＡＹ１位置Ｚ
		}
	chara プロック連続実行 Ray2_test_move \
		-time -1 \
		-exec {
			eval( $w:実験ＲＡＹ２角度   = (($w:実験ＲＡＹ２角度   -  4) & 4095) );
			eval( $w:実験ＲＡＹ２角度２ = (($w:実験ＲＡＹ２角度２ -  6) & 4095) );
			eval( $i:実験ＲＡＹ２Ｙ軸方向 = (($i:実験ＲＡＹ２Ｙ軸方向 + 3) & 4095) );
			eval( $i:実験ＲＡＹ２位置Ｘ   = (`command cos $w:実験ＲＡＹ２角度`) * 4 + 10000);
			eval( $i:実験ＲＡＹ２位置Ｙ   = 0 );
			eval( $i:実験ＲＡＹ２位置Ｚ   = (`command sin $w:実験ＲＡＹ２角度２`) * 4 - 30000 );
			mesg プットオブジェ Ray2_test turn 0 $i:実験ＲＡＹ２Ｙ軸方向 0
			mesg プットオブジェ Ray2_test move $i:実験ＲＡＹ２位置Ｘ $i:実験ＲＡＹ２位置Ｙ $i:実験ＲＡＹ２位置Ｚ
		}
	chara プロック連続実行 Ray3_test_move \
		-time -1 \
		-exec {
			eval( $w:実験ＲＡＹ３角度   = (($w:実験ＲＡＹ３角度   -  6) & 4095) );
			eval( $w:実験ＲＡＹ３角度２ = (($w:実験ＲＡＹ３角度２ +  8) & 4095) );
			eval( $i:実験ＲＡＹ３Ｙ軸方向 = (($i:実験ＲＡＹ３Ｙ軸方向 + 1) & 4095) );
			eval( $i:実験ＲＡＹ３位置Ｘ   = (`command cos $w:実験ＲＡＹ３角度`) * 5 - 10000 );
			eval( $i:実験ＲＡＹ３位置Ｙ   = 0 );
			eval( $i:実験ＲＡＹ３位置Ｚ   = (`command sin $w:実験ＲＡＹ３角度２`) * 5 - 30000 );
			mesg プットオブジェ Ray3_test turn 0 $i:実験ＲＡＹ３Ｙ軸方向 0
			mesg プットオブジェ Ray3_test move $i:実験ＲＡＹ３位置Ｘ $i:実験ＲＡＹ３位置Ｙ $i:実験ＲＡＹ３位置Ｚ
		}

	chara プットモーションモデル Ray1_test -p 0,0,-40000 -d 0 -k pdray_def_mt -m w46a_metal \
	-n 0 

	chara プットモーションモデル Ray2_test -p 70000,0,-32000 -d 3584 -k pdray_def_mt -m w46a_metal \
	-n 0 

	chara プットモーションモデル Ray3_test -p -70000,0,-32000 -d 512 -k pdray_def_mt -m w46a_metal \
	-n 0 

	chara プットオブジェ Ray4_test -m ryousan_metal -r 0,2048,0 -p 0,0, 28000 -s 100,100,100 -l d:LT2_NAME -f 0x20

*/

}
