	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT 
			print 'bgm_set'
		#endif

	//	ボス戦では必要なし
	//	chara ＢＧＭマネージャー ＢＧＭマネ
	}


//###################################################################################
//									 開始時処理
//###################################################################################

	proc インタラクティブデモ開始時処理 {
		@特殊装備解除

		// パッド操作を奪う(無線やポーズも不許可にする)
		command パッド操作 -release
		command メニュー設定 -radio off -pause off

		// フェードインスタート
		chara フェードインアウト フェードイン \
			-i 0,0,0 128 \
			-c 0,0,0 0 \
			-t (d:FADEIN_TIME*2)

		chara delay パッドディレイ \
			-time (d:FADEIN_TIME*2) \
			-e {
				//	無線　ポーズは不可のまま
				command パッド操作 -cancel
				eval($f:ロードチェックＯＮフラグ = 1);
			}

	}

	proc メタル戦開始時処理 {
		if( $s:登場ポイント == sp_w45a_w46a_0 ) {
			@インタラクティブデモ開始時処理
		} else {
			@ステージ開始時処理	 d:LOAD_TYPE:NO_MOVE_TYPE  -1 -1 -1
		}
	}

//###################################################################################
//									 ロード
//###################################################################################


//###################################################################################
//									 オブジェクト
//###################################################################################

	proc 空設定 {
		chara 新空 cloud \
			-m w00_sky
	}

	proc 仮ステージ設定 {
		chara プットオブジェ stage_test -m d:KMS_NAME0 -r 0,0,0 -p 0,-2000,0  -s 200 100 200 -l d:LT2_NAME
	}


//###################################################################################
//									アイテム
//###################################################################################

	proc アイテム設定 {
		#if d:DEBUG_PRINT
			print 'item_set'
		#endif

		//	デバッグ用
#if 0
		eval ($w:武器弾数Ｒ[ d:武器:スティンガー ] = 21)
		eval ($w:アイテム数Ｒ[ d:アイテム:レーション ] = 0)

#endif

			//	このステージは取り難いのでアイテムを取り易くする
			command アイテム収得可能範囲設定 \
					1000 \ // デフォルト  300 (2001.7/3現在)
					1500 \ // デフォルト 1500 (2001.7/3現在)
					1000   // デフォルト  300 (2001.7/3現在)

				trap ca001 d:PLAYER \
					-mask いる \
					-exec {
						//	スティンガー弾配置
						//	左上
						if ($f:w46a_スティンガー弾01フラグ == 0) {
							if ($w:武器弾数Ｒ[ d:武器:スティンガー  ] <= 20) {
								if (`command カメラ視界チェック -camera 0x03 \
									-bound -8500,4000,-12500 -7500,5000,-11500` == 0) {

									 	chara アイテム アイテムボックス \
											-b 0 \
											-p -8000,4000,-12000 \
											-k launcher_amo_ibox \			// モデル：箱本体
											-s launcher_amo_ibox_sh \		// モデル：箱影
											-l stg_amo_label \				// モデル：ラベル
											-f d:アイテム種別:武器弾 \
											-i d:武器:スティンガー \
											-n 10 \
											-h d:シナリオの高さ \
											-x { eval ($f:w46a_スティンガー弾01フラグ = 0) }

									// 弾薬がステージ上に出現（存在）しましたよ。
									eval ($f:w46a_スティンガー弾01フラグ = 1)
								}
							}
						}
						//	右上
						if ($f:w46a_スティンガー弾02フラグ == 0) {
							if ($w:武器弾数Ｒ[ d:武器:スティンガー  ] <= 20) {
								if (`command カメラ視界チェック -camera 0x03 \
									-bound 7500,4000,-12500 8500,5000,-11500` == 0) {

									chara アイテム アイテムボックス \
										-b 0 \
										-p 8000,4000,-12000 \
										-k launcher_amo_ibox \			// モデル：箱本体
										-s launcher_amo_ibox_sh \		// モデル：箱影
										-l stg_amo_label \				// モデル：ラベル
										-f d:アイテム種別:武器弾 \
										-i d:武器:スティンガー \
										-n 10 \
										-h d:シナリオの高さ \
										-x { eval ($f:w46a_スティンガー弾02フラグ = 0) }

									// 弾薬がステージ上に出現（存在）しましたよ。
									eval ($f:w46a_スティンガー弾02フラグ = 1)
								}
							}
						}
						//	左
						if ($f:w46a_スティンガー弾03フラグ == 0) {
							if ($w:武器弾数Ｒ[ d:武器:スティンガー  ] <= 20) {
								if (`command カメラ視界チェック -camera 0x03 \
									-bound -14500,4000,-500 -13500,5000,500` == 0) {

									 chara アイテム アイテムボックス \
										-b 0 \
										-p -14000,4000,0 \
										-k launcher_amo_ibox \			// モデル：箱本体
										-s launcher_amo_ibox_sh \		// モデル：箱影
										-l stg_amo_label \				// モデル：ラベル
										-f d:アイテム種別:武器弾 \
										-i d:武器:スティンガー \
										-n 10 \
										-h d:シナリオの高さ \
										-x { eval ($f:w46a_スティンガー弾03フラグ = 0) }

									// 弾薬がステージ上に出現（存在）しましたよ。
									eval ($f:w46a_スティンガー弾03フラグ = 1)
								}
							}
						}
						//	右
						if ($f:w46a_スティンガー弾04フラグ == 0) {
							if ($w:武器弾数Ｒ[ d:武器:スティンガー  ] <= 20) {
								if (`command カメラ視界チェック -camera 0x03 \
									-bound 13500,4000,-500 14500,5000,500` == 0) {

								 	chara アイテム アイテムボックス \
										-b 0 \
										-p 14000,4000,0 \
										-k launcher_amo_ibox \			// モデル：箱本体
										-s launcher_amo_ibox_sh \		// モデル：箱影
										-l stg_amo_label \				// モデル：ラベル
										-f d:アイテム種別:武器弾 \
										-i d:武器:スティンガー \
										-n 10 \
										-h d:シナリオの高さ \
										-x { eval ($f:w46a_スティンガー弾04フラグ = 0) }

									// 弾薬がステージ上に出現（存在）しましたよ。
									eval ($f:w46a_スティンガー弾04フラグ = 1)
								}
							}
						}
						//	左下
						if ($f:w46a_スティンガー弾05フラグ == 0) {
							if ($w:武器弾数Ｒ[ d:武器:スティンガー  ] <= 20) {
								if (`command カメラ視界チェック -camera 0x03 \
									-bound -8500,4000,11500 -7500,5000,12500` == 0) {

									chara アイテム アイテムボックス \
										-b 0 \
										-p -8000,4000,12000 \
										-k launcher_amo_ibox \			// モデル：箱本体
										-s launcher_amo_ibox_sh \		// モデル：箱影
										-l stg_amo_label \				// モデル：ラベル
										-f d:アイテム種別:武器弾 \
										-i d:武器:スティンガー \
										-n 10 \
										-h d:シナリオの高さ \
										-x { eval ($f:w46a_スティンガー弾05フラグ = 0) }

									// 弾薬がステージ上に出現（存在）しましたよ。
									eval ($f:w46a_スティンガー弾05フラグ = 1)
								}
							}
						}
						//	右下
						if ($f:w46a_スティンガー弾06フラグ == 0) {
							if ($w:武器弾数Ｒ[ d:武器:スティンガー  ] <= 20) {
								if (`command カメラ視界チェック -camera 0x03 \
									-bound 7500,4000,11500 8500,5000,12500` == 0) {

								 	chara アイテム アイテムボックス \
										-b 0 \
										-p 8000,4000,12000 \
										-k launcher_amo_ibox \			// モデル：箱本体
										-s launcher_amo_ibox_sh \		// モデル：箱影
										-l stg_amo_label \				// モデル：ラベル
										-f d:アイテム種別:武器弾 \
										-i d:武器:スティンガー \
										-n 10 \
										-h d:シナリオの高さ \
										-x { eval ($f:w46a_スティンガー弾06フラグ = 0) }

									// 弾薬がステージ上に出現（存在）しましたよ。
									eval ($f:w46a_スティンガー弾06フラグ = 1)
								}
							}
						}

						//	レーション
						//	イージー以下は無限
						if ($w:ゲーム設定 <= d:LEVEL_EASY) {
							if ($f:w46a_レーション01フラグ == 0) {
								if ($w:アイテム数Ｒ[ d:アイテム:レーション  ] <= 1) {
									if (`command カメラ視界チェック -camera 0x03 \
										-bound -500,4000,-500 500,5000,500` == 0) {

									 	chara アイテム アイテムボックス \
											-b 0 \
											-p 0,4000,0 \
											-k ration_ibox \			// モデル：箱本体
											-s ration_ibox_sh \			// モデル：箱影
											-l rtn_label \				// モデル：ラベル
											-f d:アイテム種別:アイテム \
											-i d:アイテム:レーション \
											-n 1 \
											-h d:シナリオの高さ \
											-x { eval ($f:w46a_レーション01フラグ = 0) }

										// レーションがステージ上に出現（存在）しましたよ。
										eval ($f:w46a_レーション01フラグ = 1)
									}
								}
							}
						//	ノーマルは３個まで
						} else if ($w:ゲーム設定 == d:LEVEL_NORMAL) {
							if ($b:w46a_レーションカウント < 3) {
								if ($f:w46a_レーション01フラグ == 0) {
									if ($w:アイテム数Ｒ[ d:アイテム:レーション  ] <= 1) {
										if (`command カメラ視界チェック -camera 0x03 \
											-bound -500,4000,-500 500,5000,500` == 0) {

										 	chara アイテム アイテムボックス \
												-b 0 \
												-p 0,4000,0 \
												-k ration_ibox \			// モデル：箱本体
												-s ration_ibox_sh \			// モデル：箱影
												-l rtn_label \				// モデル：ラベル
												-f d:アイテム種別:アイテム \
												-i d:アイテム:レーション \
												-n 1 \
												-h d:シナリオの高さ \
												-x { eval ($f:w46a_レーション01フラグ = 0) }

											// レーションがステージ上に出現（存在）しましたよ。
											eval ($f:w46a_レーション01フラグ = 1)
											eval ($b:w46a_レーションカウント = $b:w46a_レーションカウント + 1) 
										}
									}
								}
							}
						//	ハードは２個まで
						} else if ($w:ゲーム設定 == d:LEVEL_HARD) {
							if ($b:w46a_レーションカウント < 2) {
								if ($f:w46a_レーション01フラグ == 0) {
									if ($w:アイテム数Ｒ[ d:アイテム:レーション  ] <= 1) {
										if (`command カメラ視界チェック -camera 0x03 \
											-bound -500,4000,-500 500,5000,500` == 0) {

										 	chara アイテム アイテムボックス \
												-b 0 \
												-p 0,4000,0 \
												-k ration_ibox \			// モデル：箱本体
												-s ration_ibox_sh \			// モデル：箱影
												-l rtn_label \				// モデル：ラベル
												-f d:アイテム種別:アイテム \
												-i d:アイテム:レーション \
												-n 1 \
												-h d:シナリオの高さ \
												-x { eval ($f:w46a_レーション01フラグ = 0) }

											// レーションがステージ上に出現（存在）しましたよ。
											eval ($f:w46a_レーション01フラグ = 1)
											eval ($b:w46a_レーションカウント = $b:w46a_レーションカウント + 1) 
										}
									}
								}
							}
						//	エクストリームは１個のみ
						} else if ($w:ゲーム設定 == d:LEVEL_EXTREME) {
							if ($b:w46a_レーションカウント < 1) {
								if ($f:w46a_レーション01フラグ == 0) {
									// レーションがステージ上に出現（存在）しましたよ。
										eval ($f:w46a_レーション01フラグ = 1)
										eval ($b:w46a_レーションカウント = $b:w46a_レーションカウント + 1)
print '########################################################################EXTREME_RATION'
									chara アイテム アイテムボックス \
										-b 0 \
										-p 0,4000,0 \
										-k ration_ibox \			// モデル：箱本体
										-s ration_ibox_sh \			// モデル：箱影
										-l rtn_label \				// モデル：ラベル
										-f d:アイテム種別:アイテム \
										-i d:アイテム:レーション \
										-n 1 \
										-h d:シナリオの高さ
								}
							}
						}

					}

	}




