proc rto_生体センサー:02  {
vox t:vc091401 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_生体センサー__f:オタコン_000]
		//生体センサーを使っているね。
		//人間の鼓動や微弱な生体電磁波を
		//検知して振動に変換するデバイスだ。
	}
	talk オタコン 標準 -m {
		[TO_生体センサー__f:オタコン_000_1]
		//生体センサーを使っているね。
		//人間の鼓動や微弱な生体電磁波を
		//検知して振動に変換するデバイスだ。
	}
	talk オタコン 標準 -m {
		[TO_生体センサー__f:オタコン_000_2]
		//生体センサーを使っているね。
		//人間の鼓動や微弱な生体電磁波を
		//検知して振動に変換するデバイスだ。
	}
	talk オタコン 標準 -m {
		[TO_生体センサー__f:オタコン_001]
		//敵が接近すると振動して知らせてくれる。
		//振動が強いほど敵が近くにいるって
		//ことだ。
	}
	talk オタコン 標準 -m {
		[TO_生体センサー__f:オタコン_001_1]
		//敵が接近すると振動して知らせてくれる。
		//振動が強いほど敵が近くにいるって
		//ことだ。
	}
	talk オタコン 標準 -m {
		[TO_生体センサー__f:オタコン_002]
		//ただ、生体センサーを使ってる間は
		//センサーが発生させる振動しか感じ取れ
		//なくなるってことは覚えておいてくれ。
	}
	talk オタコン 標準 -m {
		[TO_生体センサー__f:オタコン_002_1]
		//ただ、生体センサーを使ってる間は
		//センサーが発生させる振動しか感じ取れ
		//なくなるってことは覚えておいてくれ。
	}
//dv
}//v
}//d

