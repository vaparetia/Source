			}
			if( !$b:A_爆弾解体終了状態フラグ[d:bm:Ｃ４_ビル１Ｆ階段下] ){
				mesg 爆弾検知領域 解体Ｃ４もや:02 アルファ変更 d:２つ違う d:もやもや変化時間//	 解体Ｃ４:02 d:Ｃ４_ビル１Ｆ階段下
			}
			if( !$b:A_爆弾解体終了状態フラグ[d:bm:倉庫窓からの爆弾] ){
				mesg 爆弾検知領域 解体Ｃ４もや:04 アルファ変更 d:２つ違う d:もやもや変化時間//	 解体Ｃ４:04 d:Ｃ４_倉庫窓からの爆弾
			}
			if( !$b:A_爆弾解体終了状態フラグ[d:bm:倉庫天井下] ){
