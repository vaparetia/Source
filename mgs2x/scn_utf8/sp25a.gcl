			}
			if( !$b:A_爆弾解体終了状態フラグ[d:bm:倉庫２Ｆ行き止まり] ){
				mesg 爆弾検知領域 解体Ｃ４もや:07 アルファ変更 d:同じとこ d:もやもや変化時間//	 解体Ｃ４:07 d:Ｃ４_倉庫２Ｆ行き止まり
			}
			if( !$b:A_爆弾解体終了状態フラグ[d:bm:ビル３Ｆ跳び柱爆弾] ){
				mesg 爆弾検知領域 解体Ｃ４もや:09 アルファ変更 d:１つ違う d:もやもや変化時間//	 解体Ｃ４:09 d:Ｃ４_ビル３Ｆ跳び柱爆弾
			}
		}else if( $s:選択プレイヤー == スネーク ){// スネーク
			if( !$b:A_爆弾解体終了状態フラグ[d:bm:スタート地点下天井] ){
				mesg 爆弾検知領域 解体Ｃ４もや:01 アルファ変更 d:同じとこ d:もやもや変化時間//	 解体Ｃ４:01 d:Ｃ４_スタート地点下天井
			}
			if( !$b:A_爆弾解体終了状態フラグ[d:bm:Ｃ４_ビル１Ｆ階段下] ){
				mesg 爆弾検知領域 解体Ｃ４もや:02 アルファ変更 d:１つ違う d:もやもや変化時間//	 解体Ｃ４:02 d:Ｃ４_ビル１Ｆ階段下
			}
			if( !$b:A_爆弾解体終了状態フラグ[d:bm:倉庫窓からの爆弾] ){
				mesg 爆弾検知領域 解体Ｃ４もや:04 アルファ変更 d:１つ違う d:もやもや変化時間//	 解体Ｃ４:04 d:Ｃ４_倉庫窓からの爆弾
			}
			if( !$b:A_爆弾解体終了状態フラグ[d:bm:倉庫天井下] ){
				mesg 爆弾検知領域 解体Ｃ４もや:06 アルファ変更 d:同じとこ d:もやもや変化時間//	 解体Ｃ４:06 d:Ｃ４_倉庫天井下
			}
			if( !$b:A_爆弾解体終了状態フラグ[d:bm:ビル２Ｆ床下爆弾] ){
				mesg 爆弾検知領域 解体Ｃ４もや:08 アルファ変更 d:同じとこ d:もやもや変化時間//	 解体Ｃ４:08 d:Ｃ４_ビル２Ｆ床下爆弾
			}
		}else{
			print 'だれ？'
		}
	}

	proc ３Ｆもやもや設定{
		if( $s:選択プレイヤー == ライデン ){
			if( !$b:A_爆弾解体終了状態フラグ[d:bm:ビル１Ｆ南西窓脇] ){
				mesg 爆弾検知領域 解体Ｃ４もや:03 アルファ変更 d:２つ違う d:もやもや変化時間//	 解体Ｃ４:03 d:Ｃ４_ビル１Ｆ南西窓脇
