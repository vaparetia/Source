			}
			if( !$b:A_爆弾解体終了状態フラグ[d:bm:ビル３Ｆ跳び柱爆弾] ){
				mesg 爆弾検知領域 解体Ｃ４もや:09 アルファ変更 d:同じとこ d:もやもや変化時間//	 解体Ｃ４:09 d:Ｃ４_ビル３Ｆ跳び柱爆弾
			}
