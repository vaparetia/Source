proc シネマスクリーンセット  {
	chara シネマスクリーン シネマ \
		-top d:CINEMA_BELT_UPPER \
		-bottom d:CINEMA_BELT_LOWER \
		-ftime 60	//デフォルト値（ゼロは駄目）
	mesg シネマスクリーン シネマ フェードアウト 1
}


// 全マップ共通
	// ドア＆マップ切り替え関係
	// ------------------------------------

	proc ドア設置 {
/*
		chara プットオブジェ エレベーター前右 \
			-m d:DOOR_NAME1 \
			-r 0,1024,0 \
			-p 4125,-12000,-69500 \
			-s 100,100,100 \
			-l d:LT2_NAME
*/
		chara プットオブジェ エレベーター前左 \
			-m d:DOOR_NAME1 \
			-r 0,1024,0 \
			-p -4125,-12000,-69500 \
			-s 100,100,100 \
			-l d:LT2_NAME
	}

	// フォグ
	// ------------------------------------
	proc 電算室フォグ設定 {
		chara フォグ 霧\
			-c 65, 50, 50 \
			-n 1000 \
			-f 30000
	}

	// エフェクト関係
	// -----------------------------------
	proc エフェクト設定 {
		//	chara ブラー ブラー

		//	chara Ｚフォーカス管理 Z_manager
//			mesg Ｚフォーカス管理 Z_manager パラメータ 5000 30

			chara ＯＦＦ制御 off_man
			mesg ＯＦＦ制御 off_man ボディシャドウＯＦＦ
	}



// 各マップ別設定
// ------------------------------------
// シェル１中央棟Ｂ３電算室

	// ステージモデルセット
	// ------------------------------------
	proc シェル１中央棟Ｂ３電算室ステージ本体設置 {
