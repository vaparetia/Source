// 夜海面のライト変更
proc 夜デモでの平環光セット {
	chara 環境光 環境光 \
		 -c 16 61 68
	chara 平行光 平行光 \
		 -c 80 71 65 \
		 -p -3130 -3884 -335
}

proc 夜デモでの平環光セット終了_元の値に復帰 {
	// w32b.lt2 の値
	chara 環境光 環境光 \
		 -c 26 44 49
	chara 平行光 平行光 \
		 -c 64 71 65 \
		 -p -3130 -3884 -335
}

proc w24dステージの平環光の値へ復帰 {
	// w24d.lt2 の値
	chara 環境光 環境光 \
		 -c 40 50 50
	chara 平行光 平行光 \
		 -c 60 65 70 \
		 -p 0 -4000 -3000
}

proc プラント海面異常発生セット {
print 'プラント海面異常発生セット_000'
	@夜デモでの平環光セット
	// sea_surface.h の値をそのままコピーした。
	eval($s:プラント海面のＴＲＩ名 = n_oil)
	eval($s:プラント海面の海面ＴＥＸ名 = n_oil_sea_alp_ovl_mod0022)
	eval($s:プラント海面の環境マップＴＥＸ名 = n_oil_ref_add_alp_ovl_mod1120)
	eval($w:プラント海面の隣接影響スピード = 2)
	eval($w:プラント海面の減衰スピード = 2)
	eval($w:プラント海面の最小振幅力 = 6)
	eval($i:プラント海面のＸ座標 = 75000)
	eval($i:プラント海面のＹ座標 = -40000)
	eval($i:プラント海面のＺ座標 = -150000)
	chara プラント海面 プラント海面セット \
		-l \
		-tex $s:プラント海面のＴＲＩ名 $s:プラント海面の海面ＴＥＸ名 $s:プラント海面の環境マップＴＥＸ名 \
		-pos $i:プラント海面のＸ座標,$i:プラント海面のＹ座標,$i:プラント海面のＺ座標 \
		-wave $w:プラント海面の隣接影響スピード,$w:プラント海面の減衰スピード,$w:プラント海面の最小振幅力
	@w24dステージの平環光の値へ復帰

print 'プラント海面異常発生セット_001'
	// 起動時はオフ
	mesg プラント海面 プラント海面セット 表示状態 0
print 'プラント海面異常発生セット_002'
}
proc プラント海面異常オン {
	mesg プラント海面 プラント海面セット 表示状態 1
}
proc プラント海面異常オフ {
	mesg プラント海面 プラント海面セット 表示状態 0
}

