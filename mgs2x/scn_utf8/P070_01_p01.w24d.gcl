			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME

		// これは壁
		chara プットオブジェ 南側壁 \
			-m w24d2_wall \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME
	}

	// 夕焼け設置
	// ------------------------------------
	proc 夕焼けセット {
		chara 太陽 ソル \
			-p 75000 -40000 -150000 \    //中心の位置
			-f -1000 -210 -4500
	}

	proc 太陽表示 {
		mesg 太陽 ソル 表示
	}
	proc 太陽非表示 {
		mesg 太陽 ソル 非表示
	}

	proc デモ空設定１ {
		chara 汎用空 空 \
			-c 7 31 37 \
			-pos 75000,-40000,-150000 \ //　各ステージの空の位置
			-f 0 \
			-l 32 \
			-t 4 \
				sky_n1_alp 198 54 42 50 \
				sky_n2_alp 125 44 34 50 \
				0 0 0 0 0 \
				sky_n4_alp 154 73 53 50 \
			-m 1 \
				n_sky_wall1 47 35 21 -100 0
	}

	proc デモ空設定２ {
		chara 汎用空 空 \
			-c 50 47 38 \
			-pos 52000 -40000 -210000 \ //　各ステージの空の位置
			-f 0 \
			-l 32 \
			-t 4 \
				sky_e1_alp 116 106 96 50 \
				sky_e2_alp 94 89 79 50 \
				0 0 0 0 0 \
				sky_e4_alp 78 73 66 50 \
			-m 4 \
				w32a_sky_wall1 47 35 21 -100 0 \
				w32a_sky_wall2 177 106 55 0 -400 \
				w32a_sky_wall3 157 114 58 0 -900 \
				w24d_sky_wall4 143 100 50 0 0
	}

	// 浮き橋
	// ------------------------------------
	proc 浮き橋セット {
		chara 浮き橋 bridge_1 \
			-pos 57875,-40000,-206625 98125,-40000,-183375 \
			-n 10 \
			-model oilfence

		chara 浮き橋 bridge_2 \
			-p 104000,-40000,-173250 104000,-40000,-126750 \
			-n 10 \
			-model oilfence

		chara 浮き橋 bridge_3 \
			-p 98125,-40000,-116500 57875 -40000 -93250 \
			-n 10 \
			-model oilfence
	}

