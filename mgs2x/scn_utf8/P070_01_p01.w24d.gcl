			-m d:KMS_NAME0 \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME

		chara プットオブジェ ステージ本体１ \
			-m d:KMS_NAME1 \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME

		chara プットオブジェ ステージ本体２ \
			-m d:KMS_NAME2 \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME

		chara プットオブジェ ステージ本体３ \
			-m d:KMS_NAME3 \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME

		chara プットオブジェ ステージ本体４ \
			-m d:KMS_NAME3 \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME
	}

	// 天井設置
	// ------------------------------------
	proc シェル１中央棟Ｂ３電算室天井設置 {
		chara プットオブジェ エレベーター前天井 \
			-m d:CEIL_NAME0 \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME

		chara プットオブジェ アーセナル前天井 \
			-m d:CEIL_NAME1 \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME

		chara プットオブジェ 電算室天井 \
			-m d:CEIL_NAME2 \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME

		chara プットオブジェ 電算室床 \
			-m d:CEIL_NAME3 \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME

		chara プットオブジェ エレベーター天井 \
			-m elv_2r \
