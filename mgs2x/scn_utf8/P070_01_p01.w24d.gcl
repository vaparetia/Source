// [追加] 2001/08/30 Uehara Masatoshi
proc リアル影セット {
	chara 影投影モデル ホールの影もでる \
		-m w24d0k \
		-p 0 0 0

	chara 影投影モデル 廊下の影もでる \
		-m w24d1k \
		-p 0 0 0

	chara 影投影モデル 電算室の影もでる \
		-m w24d2k \
		-p 0 0 0

	chara 影管理 影かんり \
		-t 0 \
		-p -100 -1000 100

	if ($s:d_num == P070_01_p01) {
		mesg 影管理 影かんり demo_add "iro_def スネーク01" 電算室の影もでる	// スネーク
		mesg 影管理 影かんり demo_add "rai_def ライデン01" 電算室の影もでる	// ライデン
		mesg 影管理 影かんり demo_add "otc_def オタコン01" 電算室の影もでる	// オタコン
		mesg 影管理 影かんり demo_add "ema_addhand エマ01" 電算室の影もでる	// エマ
	} else if ($s:d_num == P070_03_p03) {
		mesg 影管理 影かんり demo_add "iro_def スネーク01" 電算室の影もでる	// スネーク
		mesg 影管理 影かんり demo_add "rai_def ライデン01" 電算室の影もでる	// ライデン
		mesg 影管理 影かんり demo_add "otc_def オタコン01" 電算室の影もでる	// オタコン
		mesg 影管理 影かんり demo_add "ema_addhand エマ01" 電算室の影もでる	// エマ
		mesg 影管理 影かんり demo_add "otc_glass オタコン眼鏡01" 電算室の影もでる	// オタコンのメがね
	} else if ($s:d_num == P070_05_p05) {
		mesg 影管理 影かんり demo_add "iro_def スネーク01" 電算室の影もでる	// スネーク
		mesg 影管理 影かんり demo_add "rai_def ライデン01" 電算室の影もでる	// ライデン
		mesg 影管理 影かんり demo_add "otc_def オタコン01" 電算室の影もでる	// オタコン
		mesg 影管理 影かんり demo_add "ema_def エマ01"     電算室の影もでる	// エマ
		mesg 影管理 影かんり demo_add "par_def オウム抱かれ" 電算室の影もでる	// オウム
	} else if ($s:d_num == P070_07_p06) {
		// ELVホール壁へ影を映す為専用
		chara 影管理 ホール壁の影かんり \
			-t 0 \
			-a 96 \
			-p -100 -1000 300

		mesg 影管理 影かんり demo_add iro_def	// スネーク
		mesg 影管理 影かんり demo_add rai_def	// ライデン
		mesg 影管理 影かんり demo_add "ema_def エマ01" 電算室の影もでる	// エマ
	} else if ($s:d_num == P070_09_p08) {
		mesg 影管理 影かんり demo_add iro_def 廊下の影もでる	// スネーク
		mesg 影管理 影かんり demo_add rai_def 廊下の影もでる	// ライデン
		mesg 影管理 影かんり demo_add org_tng 廊下の影もでる	// オルガ忍者
	}
}

proc オタコン影オン{
	mesg 影管理 影かんり demo_add otc_def
	mesg 影管理 影かんり demo_add par_def
}
proc オタコン影オフ{
	mesg 影管理 影かんり del otc_def
	mesg 影管理 影かんり del par_def
}
// ※以下２つのprocは、P070_07_p06以外では絶対に使用しない事！
proc ホール壁オタコン影オン{
	mesg 影管理 ホール壁の影かんり demo_add otc_def
	mesg 影管理 ホール壁の影かんり demo_add par_def
}
proc ホール壁オタコン影オフ{
	mesg 影管理 ホール壁の影かんり del otc_def
	mesg 影管理 ホール壁の影かんり del par_def
}

// 以下デバッグ専用proc
// -----------------------------------------------------------------------------------
// デバッグキャラ
// ------------------------------------
proc デバッグキャラセット {

	#if d:USB_KEY
		chara USBキーボード実行 test \
			-e d:KPD_0 {	// フラグ初期化
					   } \
			-e d:KPD_1 {
							//mesg プレイヤー d:PLAYER position 9000, -9000, -222000
					   } \
			-e d:KPD_2 {
							//mesg プレイヤー d:PLAYER position 9000, -10000, -22200
					   } \
			-e d:KPD_3 {
						//mesg プレイヤー d:PLAYER position 9000, -10000, -22200
					   } \
			-e d:KPD_MINUS {
							command プレイヤー無敵セット
							mesg コマンダー 敵兵セット 視界オフ
					   } \
			-e d:KPD_PLUS {
							command プレイヤー無敵解除
							mesg コマンダー 敵兵セット 視界オン
					   }
	#endif
}

