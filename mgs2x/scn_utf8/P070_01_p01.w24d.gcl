// 各gclで必要なdefine
// ------------------------------------
// モード
#define		STAGE_PLANT		1		// 共通プロック切り分け用
#define		DEMO_STAGE		1		// デモステージかどうかで起動するキャラを切り分ける

// 各種スイッチ用define
// ------------------------------------
// オブジェ関係
#define		SCREENSHOT		0		// スクリーンショット
#define		USB_KEY			0		// USBキーボード

#define		開発中です		0 // 	// 沈みきった夕日場面を再生する場合。


// 各種設定用define
// ------------------------------------
// マップ関係
//#define		HZX_NAME			w24d
#define		HZX_NAME			d00a3
#define		KMS_NAME0			w24d0
#define		KMS_NAME1			w24d1_a
#define		KMS_NAME2			w24d1_b
#define		KMS_NAME3			w24d2
#define		KMS_NAME4			w24d2_wall
#define		CEIL_NAME0			w24d0r
#define		CEIL_NAME1			w24d1r
#define		CEIL_NAME2			w24d2r
#define		CEIL_NAME3			w24d2_tes_sita_v01
#define		DOOR_NAME1			w24d_dr01
#define		DOOR_NAME_ELV_1		elv_dr1			// エレベータ用１
#define		DOOR_NAME_ELV_2		elv_dr2			// エレベータ用２
#define		LT2_NAME			w24d
#define		LT2_NAME_W32B			w32b


// ローカル変数


// include
// ------------------------------------
#include "5sec_bfr_demo.h"
#include "demo_vardef.h"
#include "demo_stdch.h"
#include "demo_stdch2.h"
#include "story.h"
#include "sload.h"

#include "p_force_cdc.ch"

// 実験
#include "sea_surface.h"

#if d:USB_KEY
	#include "usbkbd.h"
#endif

#if d:PLANT_DEMO_ALL_SKIP
	#define		DEMO_SKIP_ENABLE 1
#else
	#define		DEMO_SKIP_ENABLE 0
#endif

#if d:開発中です
	// 沈みきった夕日場面を再生する場合。
	eval($w:p_story = d:ST:P070_03_P03ＡＧ起動３ポリゴンデモ３終了)
#endif

#if d:MGS2_DEMO
	#define DEMO_SET_STAGE 1	// 再生するステージを切り替える
								// 0 : p070_01_01
								// 1 : p070_02_02
								// 2 : p070_03_03
								// 3 : p070_04_04
								// 4 : p070_05_05
								// 5 : p070_07_06
								// 6 : p070_09_08
								// 7 : 他(?)
#endif

/***************************************************************************************************/
// マップ起動
/***************************************************************************************************/
// デモによってライトを分ける
// ＜↓↓↓同期せよ↓↓↓＞
if(d:ST:P070_03_P03ＡＧ起動３ポリゴンデモ３終了 <= $w:p_story && \
					$w:p_story < d:ST:P070_04_P04ＡＧ起動４ポリゴンデモ４開始) {
	chara マップ シェル１中央棟Ｂ３電算室 	-h d:HZX_NAME,0 \
											-l d:LT2_NAME_W32B
} else {
	chara マップ シェル１中央棟Ｂ３電算室 	-h d:HZX_NAME,0 \
											-l d:LT2_NAME
}

/***************************************************************************************************/
// マップ設定
/***************************************************************************************************/

command マップ設定 シェル１中央棟Ｂ３電算室 -set {

//	デモ環境かゲーム環境かで起動を読み分ける。
// ------------------------------------
#if d:MGS2_DEMO

#if d:SCREENSHOT
	chara スクリーンショット shot
#endif

chara デモアクトデバッグ demodebug  -i t:p070_02_p02 -d 'p070_02_p02' -l  -s 'p070_02_p02'  \
		-p プラント海面異常オン プラント海面異常オフ 太陽表示 太陽非表示 \
		   オタコン影オン オタコン影オフ ホール壁オタコン影オン ホール壁オタコン影オフ \
		   エレベータホール映り込みオン エレベータホール映り込みオフ \
		   階段床面映り込みオン 階段床面映り込みオフ \
		   ＡＧエレベータ前映り込みオン ＡＧエレベータ前映り込みオフ



	// 電算室デモ再生のために。
	eval($w:p_story = d:ST:P070_02_P02ＡＧ起動２ポリゴンデモ２終了)

	if (d:DEMO_SET_STAGE == 0) {
		eval($s:d_num = P070_01_p01)
	} else if (d:DEMO_SET_STAGE == 1) {
		eval($s:d_num = P070_02_p02)
	} else if (d:DEMO_SET_STAGE == 2) {
		eval($s:d_num = P070_03_p03)
	} else if (d:DEMO_SET_STAGE == 3) {
		eval($s:d_num = P070_04_p04)
	} else if (d:DEMO_SET_STAGE == 4) {
		eval($s:d_num = P070_05_p05)
	} else if (d:DEMO_SET_STAGE == 5) {
		eval($s:d_num = P070_07_p06)
	} else if (d:DEMO_SET_STAGE == 6) {
		eval($s:d_num = P070_09_p08)
	} else {
//		eval($s:d_num = P070_01_p01)
	}

/*
#if d:開発中です
	eval($s:d_num = P070_04_p04)
#else
	eval($s:d_num = P070_02_p02)
#endif
*/

#else

// 実際の再生
//-----------------------------------------------------------
	// 実際のデモ再生の方も、ストーリーフラグで変える
	if($w:p_story == d:ST:P070_01_P01ＡＧ起動１ポリゴンデモ１開始) {
		print '$w:p_story = ST:P070_01_P01ＡＧ起動１ポリゴンデモ１開始'

		/* エマ死にそう　逢いたかった… */

		// デモ特有の変数代入
		eval($s:d_num = P070_01_p01)

		// ナイトビジョンと赤外線ゴーグルは海面キラキラを消してしまうので、
		// 装備していたらはずしてしまう。
		if ( ($w:アイテム == d:アイテム:暗視ゴーグル) || \
			 ($w:アイテム == d:アイテム:サーマルゴーグル) ) {
			eval($w:アイテム = d:アイテム:素手);
		}

		@デモモデル差し替え処理
		proc デモ再生_P070_01_p01 {
			chara demo デモ再生 \
				-i t:p070_01_p01 \
				-p プラント海面異常オン プラント海面異常オフ \
				   エレベータホール映り込みオン エレベータホール映り込みオフ \
				   階段床面映り込みオン 階段床面映り込みオフ \
				   ＡＧエレベータ前映り込みオン ＡＧエレベータ前映り込みオフ \
				-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
				-next P070_01_p01終了
		}

		@デモ再生_P070_01_p01

	} else if(d:ST:P070_01_P01ＡＧ起動１ポリゴンデモ１終了 <= $w:p_story && \
					$w:p_story < d:ST:P070_02_P02ＡＧ起動２ポリゴンデモ２開始) {
		eval($w:p_story = d:ST:P070_02_P02ＡＧ起動２ポリゴンデモ２開始)
		print '$w:p_story = ST:P070_02_P02ＡＧ起動２ポリゴンデモ２開始'

		/* 沈む夕日その１ */

		// デモ特有の変数代入
		eval($s:d_num = P070_02_p02)

		@デモモデル差し替え処理
		proc デモ再生_P070_02_p02 {
			chara demo デモ再生 \
				-i t:p070_02_p02 \
				-p 太陽表示 太陽非表示 \
				   エレベータホール映り込みオン エレベータホール映り込みオフ \
				   階段床面映り込みオン 階段床面映り込みオフ \
				   ＡＧエレベータ前映り込みオン ＡＧエレベータ前映り込みオフ \
				-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
				-next P070_02_p02終了
		}

		@デモ再生_P070_02_p02

	} else if(d:ST:P070_02_P02ＡＧ起動２ポリゴンデモ２終了 <= $w:p_story && \
					$w:p_story < d:ST:P070_03_P03ＡＧ起動３ポリゴンデモ３開始) {
		eval($w:p_story = d:ST:P070_03_P03ＡＧ起動３ポリゴンデモ３開始)
		print '$w:p_story = ST:P070_03_P03ＡＧ起動３ポリゴンデモ３開始'

		/* エマ死亡 */

		// デモ特有の変数代入
		eval($s:d_num = P070_03_p03)

		@デモモデル差し替え処理
		proc デモ再生_P070_03_p03 {
			chara demo デモ再生 \
				-i t:p070_03_p03 \
				-p エレベータホール映り込みオン エレベータホール映り込みオフ \
				   階段床面映り込みオン 階段床面映り込みオフ \
				   ＡＧエレベータ前映り込みオン ＡＧエレベータ前映り込みオフ \
				-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
				-next P070_03_p03終了
		}

		@デモ再生_P070_03_p03

	// ＜↑↑↑同期せよ↑↑↑＞
	} else if(d:ST:P070_03_P03ＡＧ起動３ポリゴンデモ３終了 <= $w:p_story && \
					$w:p_story < d:ST:P070_04_P04ＡＧ起動４ポリゴンデモ４開始) {
		eval($w:p_story = d:ST:P070_04_P04ＡＧ起動４ポリゴンデモ４開始)
		print '$w:p_story = ST:P070_04_P04ＡＧ起動４ポリゴンデモ４開始'

		/* 沈む夕日その２　沈みきった夕日 */

		// デモ特有の変数代入
		eval($s:d_num = P070_04_p04)

		@デモモデル差し替え処理
		proc デモ再生_P070_04_p04 {
			chara demo デモ再生 \
				-i t:p070_04_p04 \
				-p エレベータホール映り込みオン エレベータホール映り込みオフ \
				   階段床面映り込みオン 階段床面映り込みオフ \
				   ＡＧエレベータ前映り込みオン ＡＧエレベータ前映り込みオフ \
				-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
				-next P070_04_p04終了
		}

		@デモ再生_P070_04_p04

	} else if(d:ST:P070_04_P04ＡＧ起動４ポリゴンデモ４終了 <= $w:p_story && \
					$w:p_story < d:ST:P070_05_P05ＡＧ起動５ポリゴンデモ５開始) {
		eval($w:p_story = d:ST:P070_05_P05ＡＧ起動５ポリゴンデモ５開始)
		print '$w:p_story = ST:P070_05_P05ＡＧ起動５ポリゴンデモ５開始'

		/* オウム出場　ビッグシェル切り離し館内放送 */

		// デモ特有の変数代入
		eval($s:d_num = P070_05_p05)

		@デモモデル差し替え処理
		proc デモ再生_P070_05_p05 {
			chara demo デモ再生 \
				-i t:p070_05_p05 \
				-p エレベータホール映り込みオン エレベータホール映り込みオフ \
				   階段床面映り込みオン 階段床面映り込みオフ \
				   ＡＧエレベータ前映り込みオン ＡＧエレベータ前映り込みオフ \
				-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
				-next P070_05_p05終了
		}

		@デモ再生_P070_05_p05

	} else if(d:ST:P070_05_P05ＡＧ起動５ポリゴンデモ５終了 <= $w:p_story && \
					$w:p_story < d:ST:P070_06_M01ＡＧ起動６ムービーデモ１開始) {
/*
		eval($w:p_story = d:ST:P070_06_M01ＡＧ起動６ムービーデモ１開始)
		print '$w:p_story = ST:P070_06_M01ＡＧ起動６ムービーデモ１開始'

		//ウルフの映像

		// デモ特有の変数代入
		eval($s:d_num = P070_06_m01)

		#if 1
			chara デバッグポーズ pause 'MOVIE_P070_06_m01' -p P070_06_m01終了
		#else
			// 無線
			// P070_06_m01終了
		#endif
*/
	} else if(d:ST:P070_06_M01ＡＧ起動６ムービーデモ１終了 <= $w:p_story && \
					$w:p_story < d:ST:P070_07_P06ＡＧ起動７ポリゴンデモ６開始) {
		eval($w:p_story = d:ST:P070_07_P06ＡＧ起動７ポリゴンデモ６開始)
		print '$w:p_story = ST:P070_07_P06ＡＧ起動７ポリゴンデモ６開始'

		/* オタコン、エレベーターで去る */

		// デモ特有の変数代入
		eval($s:d_num = P070_07_p06)

		@デモモデル差し替え処理
		proc デモ再生_P070_07_p06 {
			chara demo デモ再生 \
				-i t:p070_07_p06 \
				-p エレベータホール映り込みオン エレベータホール映り込みオフ \
				   階段床面映り込みオン 階段床面映り込みオフ \
				   ＡＧエレベータ前映り込みオン ＡＧエレベータ前映り込みオフ \
				   オタコン影オン オタコン影オフ ホール壁オタコン影オン ホール壁オタコン影オフ \
				-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
				-next P070_07_p06終了
		}

		@デモ再生_P070_07_p06
/*
	// mpeg専用ステージにしてもロードするので元に戻してポリデモにした

	// 以下は名前はポリデモだが、mpegに変更となった。
	} else if(d:ST:P070_07_P06ＡＧ起動７ポリゴンデモ６終了 <= $w:p_story && \
					$w:p_story < d:ST:P070_08_P07ＡＧ起動８ポリゴンデモ７開始) {
		eval($w:p_story = d:ST:P070_08_P07ＡＧ起動８ポリゴンデモ７開始)
		print '$w:p_story = ST:P070_08_P07ＡＧ起動８ポリゴンデモ７開始'

// d001p01 ステージに、夜の空とライト、海を出してmpeg化する。
#if 1
		// シェル１の遠景。

		// デモ特有の変数代入
		eval($s:d_num = P070_08_p07)

		#if 1
			chara デバッグポーズ pause 'MOVIE_P070_08_p07' -p P070_08_p07終了
		#else
			// ムービー
			// P070_08_p07終了
		#endif
#endif
*/
	} else if(d:ST:P070_08_P07ＡＧ起動８ポリゴンデモ７終了 <= $w:p_story && \
					$w:p_story < d:ST:P070_09_P08ＡＧ起動９ポリゴンデモ８開始) {
		eval($w:p_story = d:ST:P070_09_P08ＡＧ起動９ポリゴンデモ８開始)
		print '$w:p_story = ST:P070_09_P08ＡＧ起動９ポリゴンデモ８開始'

		/* オルガ出現　ライデンは当て身を食わされる */

		// デモ特有の変数代入
		eval($s:d_num = P070_09_p08)

		@デモモデル差し替え処理
		proc デモ再生_P070_09_p08 {
			chara demo デモ再生 \
				-i t:p070_09_p08 \
				-p エレベータホール映り込みオン エレベータホール映り込みオフ \
				   階段床面映り込みオン 階段床面映り込みオフ \
				   ＡＧエレベータ前映り込みオン ＡＧエレベータ前映り込みオフ \
				-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
				-next P070_09_p08終了
		}

		@デモ再生_P070_09_p08

// d070p09 新設のため、外す。
#if 0
	} else if(d:ST:P070_09_P08ＡＧ起動９ポリゴンデモ８終了 <= $w:p_story && \
					$w:p_story < d:ST:P070_10_R01ＡＧ起動１０無線機デモ１開始) {
		eval($w:p_story = d:ST:P070_10_R01ＡＧ起動１０無線機デモ１開始)
		print '$w:p_story = ST:P070_10_R01ＡＧ起動１０無線機デモ１開始'

		/* ローズ強制コール　セーブするかしないか聞いてくる */

		// デモ特有の変数代入
		eval($s:d_num = P070_10_r01)

		#if 0
			chara デバッグポーズ pause 'CODEC_P070_10_r01' -p P070_10_r01終了
		#else
			@rt_P070_10_R01ＡＧ起動１０無線機デモ１
			/* P070_10_r01終了 */
			/*
			eval($w:p_story = d:ST:P070_10_R01ＡＧ起動１０無線機デモ１終了)
			// 拷問部屋へ。polydemo_w41a.h でいきなりムービーを始めるために、
			//もう一個ストーリーフラグを進めておく。
			eval($w:p_story = d:ST:P070_11_M02ＡＧ起動１１ムービーデモ２開始)
			@mv_w24d_w41a_0
			*/
		#endif

#endif

	}


#endif


// 以下、諸々セット
//-----------------------------------------------------------

	// デモによって表示するステージが全く異なるのでこうする。
	// プラントのデモ(w32a相当)
	@常駐キャラ設定						// stdch.hで定義
	if($s:d_num == P070_02_p02 || \
	   $s:d_num == P070_04_p04){

		// 海面とフォグ（後には汎用空も？）
		// 沈み行く夕日
		if($s:d_num == P070_02_p02) {
			command 水位設定 -lv -40000

			@プラント海面セット 夕方狙撃イベント w32a 1
			@プラントステージでのフォグセット 夕方狙撃イベント 0

		// 完全に沈んだ夕日
		} else if($s:d_num == P070_04_p04) {
			@夜デモでの平環光セット // 夜デモ(P070_04_p04)のみ
			@プラント海面セット 夜 w32b 1
			@夜デモでの平環光セット終了_元の値に復帰 // 夜デモ(P070_04_p04)のみ

			@プラントステージでのフォグセット 夜 0
			@衝突防止警告灯
		}

		//  空も別の物を出す。
		if($s:d_num == P070_04_p04) {
			@デモ空設定１
/*
			// かつ、夜デモでは以下を追加して出す。
			chara プットオブジェ 追加で出す夜空 \
				-m n_sky_wall1 -r 0,0,0 \
				-p 75000,-40000,-150000 -s 100,100,100 \
				-l d:LT2_NAME
*/
		} else {
//			@プラントステージでの汎用空セット 夕方狙撃イベント w32b
			@デモ空設定２
			@夕焼けセット
		}

		@浮き橋セット
		@w32aステージモデルセット
		@w32a_プラント本体セット

	// 電算室のデモ(w24d相当)
	} else {
		@電算室フォグ設定
		@ドア設置
		@シェル１中央棟Ｂ３電算室ステージ本体設置
		@シェル１中央棟Ｂ３電算室天井設置
		@エレベーター設置
		@ロッカー設置
		@プラント海面異常発生セット
//		@鳥篭

		@エレベータホール床面映り込み
		@階段床面映り込み
		@ＡＧエレベータ前床面映り込み

		@ドアランプセット
		@アーセナルランプセット

		// リアル影セット
		if (($s:d_num == P070_01_p01) || \
			($s:d_num == P070_03_p03) || \
			($s:d_num == P070_05_p05) || \
			($s:d_num == P070_07_p06) || \
			($s:d_num == P070_09_p08)) {
			@リアル影セット
		}

	}


	// 無線ではシネマスクリーン起動しない
	if($s:d_num != P070_10_r01){
		@シネマスクリーンセット
	}
	@エフェクト設定
print '電算室のデモ電算室のデモ電算室のデモ_009'

	// ウイルス投入映像
	if($s:d_num == P070_01_p01){
		@ウイルス投入スクリーン映像セット
print '電算室のデモ電算室のデモ電算室のデモ_010'
	}

	chara デモキャンセルチェック デモキャンセル \
		-p demo_cancel
print '電算室のデモ電算室のデモ電算室のデモ_011'
}

//初期マップの表示
command マップ表示 -show シェル１中央棟Ｂ３電算室



// 各proc設定
//-------------------------------------------------------------------------------------

//-------------------------------------------------------------------------------------
// デモデモ再生関連のプロック
//-----------------------------------------------------------
// これはデバッグ用
proc restart_proc {
	restart
}

proc dummy_proc {}

proc null {}

proc demo_cancel {
	command StreamStopAll
}

proc P070_01_p01終了 {
	@デモ終了時シネマスクリーンオフ
	mesg デモキャンセルチェック デモキャンセル kill
	#if d:DEMO_SKIP_ENABLE
		eval($w:p_story = d:ST:P070_09_P08ＡＧ起動９ポリゴンデモ８終了)
		print '$w:p_story = d:ST:P070_09_P08ＡＧ起動９ポリゴンデモ８終了'
	#else
		print '$w:p_story = d:ST:P070_01_P01ＡＧ起動１ポリゴンデモ１終了'
		eval($w:p_story = d:ST:P070_01_P01ＡＧ起動１ポリゴンデモ１終了)
	#endif

	chara delay ディレイ \
		-time 1 \
		-exec{
			restart
		}
}

