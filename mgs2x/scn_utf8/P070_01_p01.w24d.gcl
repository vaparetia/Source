			-pos 0,-14000,0 \ //
			-axis 1 // Y軸反転
	}
}
proc ＡＧエレベータ前床面映り込み {
	if(($s:d_num == P070_07_p06) || ($s:d_num == P070_09_p08)){
		chara 鏡面モデル管理 ＡＧエレベータ前床面映り込み管理 \
			-pos 0,-16000,0 \ //
