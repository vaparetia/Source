					mesg ＶＲ的共通 移動的:24 移動開始
					mesg ＶＲ的共通 移動的:25 移動開始
				} else if ( $1 == 移動的:30 ) {
					mesg ＶＲ的共通 移動的:20 移動開始
					mesg ＶＲ的共通 移動的:21 移動開始
					mesg ＶＲ的共通 移動的:26 移動開始
				}

			} else if ( ($1 == 移動的:31) || ($1 == 移動的:32) || ($1 == 移動的:33) || ($1 == 移動的:34) ||\
						($1 == 移動的:35) || ($1 == 移動的:36) ) {
				$$b:act_5_破壊数カウント = $$b:act_5_破壊数カウント + 1
				if ( $$b:act_5_破壊数カウント == 6 ){ 
