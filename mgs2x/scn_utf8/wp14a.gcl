// ------------------------------------
// マップ設定
// ------------------------------------
chara マップ 武器訓練マシンガン４面 -k d:KMS_NAME -h d:HZX_NAME,0 -l $s:ＶＲライトファイル名

command マップ設定 武器訓練マシンガン４面 -set {
	// ローカルの初期化
	// ------------------------------------
	@ローカル変数初期化		// ローカルで使用する変数で初期化をする場合はここで

	// ＶＲで必要な基本プロックのセット(vr_common.hで定義)
	// サウンドの基本パック、ＶＲの基本システム、プレイヤー、ゴール等を設定します
	// ※このプロックを使用する時は「ＶＲクリア時処理」というプロックが必要です
	// ------------------------------------
	@ＶＲ共通プロックセット sna_wp14a rai_wp14a d:VR_GOAL_TARGET 0 0 -20000

	// ＶＲウィンドウの設定
	// ------------------------------------
	@武器訓練マシンガン４面ＶＲウィンドウ設定

	// クリア時に呼ばれるものの設定
	// ------------------------------------
	@ＶＲクリア設定 p:load_wp15a p:load_wp14a

	// ステージに引かれるライン
	// ------------------------------------
	@ＶＲアウトライン d:KMS_NAME d:TONBO_KMS_NAME d:LINE_KMS_NAME

	// 設定値を変更する場合は以下のプロック内で設定
	// ------------------------------------
	@設定値変更				// 敵兵や的のパラメータをステージ限定で変える時はここで
	@プラグイン設定			// プレイヤーのプラグインがいる時はここで

	// 的関係の設定
	// ------------------------------------
	@ＶＲ標的マシンガン４面設定				// ＶＲシステム起動後に呼ぶ
	@ＡＣＴ６トラップ起動

	// ＢＧＭの設定(プレイヤー→敵兵→BGMの順で呼ぶ。的の場合は関係ないがとりあえずここに)
	// ------------------------------------
	@ＢＧＭ設定

	// アイテムの設定
	// ------------------------------------
	@アイテム設定

	// 光源、オブジェクト、カメラ関連の設定
	// ------------------------------------
	@ＶＲフォグ設定 d:VR_FOG:朝Ｎ 55000 -10000 53000 -12000 50000
	@カメラセット						// chara カメラとベースのカメラを設定
	@武器訓練マシンガン４面カメラ設定	// ステージ固有のカメラ設定がいる時はこのプロックで
	@ＶＲキャラ用ライト設置				// vr_common.hに定義。必ず最後に設定
#if d:DEBUG_CHARA
//	@デバッグキャラセット
#endif
}

//初期マップの表示
command マップ表示 -show 武器訓練マシンガン４面


//###################################################################################
//									各proc設定
//###################################################################################



//###################################################################################
//									全マップ共通
//###################################################################################
	// ------------------------------------
	// 全マップ共通
	// ------------------------------------
	//------------------------------------------------------------
	// ＶＲウィンドウの設定と表示
	//------------------------------------------------------------
	proc 武器訓練マシンガン４面ＶＲウィンドウ設定 {
		#if d:DEBUG_PRINT
			print 'vr_window_set'
		#endif

		@ＶＲウィンドウ設定	[VRMSG_J:VRM_WPN_ASR_wp14a] [VRMSG_E:VRM_WPN_ASR_wp14a] [VRMSG_G:VRM_WPN_ASR_wp14a] \	// 日、英、独
							[VRMSG_F:VRM_WPN_ASR_wp14a] [VRMSG_I:VRM_WPN_ASR_wp14a] [VRMSG_S:VRM_WPN_ASR_wp14a] \	// 仏、伊、西
							[VRMSG_K:VRM_WPN_ASR_wp14a] \															// 韓
							p:ＶＲステージ開始時処理								// 終了プロック


		// ＶＲウィンドウを表示する
		mesg ＶＲウィンドウ ＶＲウィンドウ君 開く

		// スタート時とクリア時に使用するカットインカメラ
		chara カメラ カットインカメラ		-c 0 -l 0 -p 0

		// スタート時のカメラ(必要な場合)
		chara カメラ設定 カットインカメラ \
			-c 1 \	
			-p 0,6600,-17650 -t 0,0,-20000 \
			-r 800,2048,0 -f 7000 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1
	}

	//------------------------------------------------------------
	// ステージ開始時処理
	//------------------------------------------------------------
	proc ＶＲステージ開始時処理 {
		#if d:DEBUG_PRINT
			print 'game_start!!!!!'
		#endif

		// プレイヤーやパッドの制御等を行う a_stdproc.hで定義
		@全ミッション共通ステージ開始時処理

		// カメラワークスタート(必要な場合)
		// 全体図

		chara カメラ設定 カットインカメラ \
			-c 1 \	
			-p 0,40000,10000 -t 0,28560,6375 \
			-r 825,2048,0 -f 12000 \
			-a 200 \
			-i 4 4 d:START_CAMERA_CHANGE_TIME d:START_CAMERA_CHANGE_TIME \
			-s 1

		chara delay ディレイ \
			-time d:START_CAMERA_CHANGE_TIME \
			-exec {
				chara カメラ設定 カットインカメラ -s -1
			}
	}

	// ------------------------------------
	// クリア時の処理
	// ------------------------------------
	proc ＶＲクリア時処理 {
		#if d:DEBUG_PRINT
			print 'clear'
		#endif

		// 強制モーションを発動
		@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_1 1777

		// クリア時にカメラアングルを変える
		chara カメラ設定 クリア時カメラ \
			-c 1 \
			-p 2000,2470,-23450 -t 470,1260,-20000 \
			-r 200,3825,0 -f 4000 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}

	//------------------------------------------------------------
	// ステージ開始直後処理
	//------------------------------------------------------------
	proc ゲーム開始直後処理 {
		// 初期配置標的の起動（command ＶＲステージスタート の起動直後に行う必要がある）
		@ＶＲ初期配置標的マシンガン４面設定
	}


	// ------------------------------------
	// パラメータ系の変更
	// ------------------------------------
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT
			print 'localvar_init'
		#endif

		//	的管理用各種フラグを初期化する
		$$b:act_1_破壊数カウント = 0;
		$$b:act_2_破壊数カウント = 0;
		$$b:act_3_破壊数カウント = 0;
		$$b:act_4_破壊数カウント = 0;
		$$b:act_5_破壊数カウント = 0;

		$$b:標的セット数 = 0;
		$$i:標的フラグ = 0;

		$$b:ＡＣＴ６トラップ起動制御 = 0;

//		$$i:標的フラグＡ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NO_GHOST );
//		$$i:標的フラグＢ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST );
//		$$i:標的フラグＣ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    );
		$$i:標的フラグＤ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST                  | d:VR_TRG_WAIT );
		$$i:標的フラグＥ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST | d:VR_TRG_WAIT );
//		$$i:標的フラグＦ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    | d:VR_TRG_WAIT );
//		$$i:標的フラグＧ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST                  | d:VR_TRG_WAIT | d:VR_TRG_CIRCLE );
//		$$i:標的フラグＨ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST | d:VR_TRG_WAIT | d:VR_TRG_CIRCLE );
//		$$i:標的フラグＩ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    | d:VR_TRG_WAIT | d:VR_TRG_CIRCLE );
		$$i:標的フラグＪ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST                  | d:VR_TRG_WAIT | d:VR_TRG_NO_APPEAR_EF );
		$$i:標的フラグＫ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST | d:VR_TRG_WAIT | d:VR_TRG_NO_APPEAR_EF );
//		$$i:標的フラグＬ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    | d:VR_TRG_WAIT | d:VR_TRG_NO_APPEAR_EF );
	}

	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT
			print 'status_set'
		#endif

		// 初期装備の設定
		if ( $s:選択プレイヤー == ライデン ) {
			// ライデン系を選択
			$w:武器弾数Ｒ[ d:武器:Ｍ４ ] = 700
			$w:武器 = d:武器:Ｍ４
		} else {
			// スネーク系を選択
			$w:武器弾数Ｒ[ d:武器:ＡＫＳ ] = 700
			$w:武器 = d:武器:ＡＫＳ
//			$w:アイテム = d:アイテム:ＡＫサプレッサ
		}

	}

	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif
	}



//###################################################################################
//									 的兵
//###################################################################################

	// ------------------------------------
	// マシンガン４面
	// ------------------------------------

	// 破壊時処理
	// ------------------------------------
	proc ＶＲ標的破壊マシンガン４面処理 {

		/* 共通 */
		if ( ($1 == 移動的:01) || ($1 == 移動的:02) || ($1 == 移動的:03) || ($1 == 移動的:04) || \
			 ($1 == 移動的:05) || ($1 == 移動的:06) ) {
			$$b:act_1_破壊数カウント = $$b:act_1_破壊数カウント + 1

			if ( $$b:act_1_破壊数カウント == 6 ){
				mesg ＶＲ的共通 移動的:27 移動開始
				mesg ＶＲ的共通 移動的:28 移動開始
				mesg ＶＲ的共通 移動的:29 移動開始
				mesg ＶＲ的共通 移動的:30 移動開始
				mesg ＶＲ的共通 移動的:31 移動開始
				mesg ＶＲ的共通 移動的:32 移動開始
				mesg ＶＲ的共通 移動的:33 移動開始
				mesg ＶＲ的共通 移動的:34 移動開始
				mesg ＶＲ的共通 移動的:35 移動開始
				mesg ＶＲ的共通 移動的:36 移動開始
			}

		} else if ( ($1 == 移動的:07) || ($1 == 移動的:08) || ($1 == 移動的:09) || ($1 == 移動的:10) ||\
					($1 == 移動的:11) || ($1 == 移動的:12) || ($1 == 移動的:13) || ($1 == 移動的:14) ) {
			$$b:act_2_破壊数カウント = $$b:act_2_破壊数カウント + 1
		}

		if ( ($$b:act_1_破壊数カウント + $$b:act_2_破壊数カウント) == 1 ){ 
			mesg ＶＲ的共通 移動的:07 移動開始
		} else if ( ($$b:act_1_破壊数カウント + $$b:act_2_破壊数カウント) == 2 ){
			mesg ＶＲ的共通 移動的:08 移動開始
		} else if ( ($$b:act_1_破壊数カウント + $$b:act_2_破壊数カウント) == 3 ){
			mesg ＶＲ的共通 移動的:09 移動開始
		} else if ( ($$b:act_1_破壊数カウント + $$b:act_2_破壊数カウント) == 4 ){
			mesg ＶＲ的共通 移動的:10 移動開始
		} else if ( ($$b:act_1_破壊数カウント + $$b:act_2_破壊数カウント) == 5 ){
			mesg ＶＲ的共通 移動的:11 移動開始
		} else if ( ($$b:act_1_破壊数カウント + $$b:act_2_破壊数カウント) == 6 ){
			mesg ＶＲ的共通 移動的:12 移動開始
		} else if ( ($$b:act_1_破壊数カウント + $$b:act_2_破壊数カウント) == 7 ){
