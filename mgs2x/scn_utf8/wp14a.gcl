					mesg ＶＲ的共通 移動的:25 移動開始
					mesg ＶＲ的共通 移動的:26 移動開始
				}
			}

			if ( ($$b:act_1_破壊数カウント + $$b:act_2_破壊数カウント + $$b:act_3_破壊数カウント) == 18  ){ 
				mesg ＶＲ的共通 移動的:37 移動開始
				mesg ＶＲ的共通 移動的:38 移動開始
				mesg ＶＲ的共通 移動的:39 移動開始
				mesg ＶＲ的共通 移動的:40 移動開始
			}

		// スネーク or プリスキンを選択
		} else if ( ($s:選択プレイヤー == スネーク) || ($s:選択プレイヤー == プリスキン) ) {

			if ( ($1 == 移動的:15) || ($1 == 移動的:16) || ($1 == 移動的:17) || ($1 == 移動的:18) ){
				$$b:act_3_破壊数カウント = $$b:act_3_破壊数カウント + 1

			} else if ( ($1 == 移動的:19) || ($1 == 移動的:20) || ($1 == 移動的:21) || ($1 == 移動的:22) ||\
				 ($1 == 移動的:23) || ($1 == 移動的:24) || ($1 == 移動的:25) || ($1 == 移動的:26) ||\
				 ($1 == 移動的:27) || ($1 == 移動的:28) || ($1 == 移動的:29) || ($1 == 移動的:30) ) {
				$$b:act_4_破壊数カウント = $$b:act_4_破壊数カウント + 1

				if ( $1 == 移動的:27 ) {
					mesg ＶＲ的共通 移動的:19 移動開始
					mesg ＶＲ的共通 移動的:20 移動開始
					mesg ＶＲ的共通 移動的:26 移動開始
				} else if ( $1 == 移動的:28 ) {
					mesg ＶＲ的共通 移動的:21 移動開始
					mesg ＶＲ的共通 移動的:25 移動開始
					mesg ＶＲ的共通 移動的:26 移動開始
				} else if ( $1 == 移動的:29 ) {
					mesg ＶＲ的共通 移動的:19 移動開始
					mesg ＶＲ的共通 移動的:24 移動開始
					mesg ＶＲ的共通 移動的:26 移動開始
				} else if ( $1 == 移動的:30 ) {
					mesg ＶＲ的共通 移動的:21 移動開始
					mesg ＶＲ的共通 移動的:23 移動開始
					mesg ＶＲ的共通 移動的:26 移動開始
				}

			} else if ( ($1 == 移動的:31) || ($1 == 移動的:32) || ($1 == 移動的:33) || ($1 == 移動的:34) ||\
						($1 == 移動的:35) || ($1 == 移動的:36) ) {
				$$b:act_5_破壊数カウント = $$b:act_5_破壊数カウント + 1
				if ( $$b:act_5_破壊数カウント == 2 ){
					mesg ＶＲ的共通 移動的:25 移動開始
					mesg ＶＲ的共通 移動的:26 移動開始
				} else if ( $$b:act_5_破壊数カウント == 6 ){
					mesg ＶＲ的共通 移動的:19 移動開始
					mesg ＶＲ的共通 移動的:20 移動開始
					mesg ＶＲ的共通 移動的:21 移動開始
					mesg ＶＲ的共通 移動的:22 移動開始
					mesg ＶＲ的共通 移動的:23 移動開始
					mesg ＶＲ的共通 移動的:24 移動開始
				}
			}

			if ( ($$b:act_1_破壊数カウント + $$b:act_2_破壊数カウント + $$b:act_3_破壊数カウント) == 18  ){ 
				mesg ＶＲ的共通 移動的:37 移動開始
				mesg ＶＲ的共通 移動的:38 移動開始
				mesg ＶＲ的共通 移動的:39 移動開始
				mesg ＶＲ的共通 移動的:40 移動開始
				mesg ＶＲ的共通 移動的:41 移動開始
				mesg ＶＲ的共通 移動的:42 移動開始
			}

		// 前作スネークを選択
		} else if ( $s:選択プレイヤー == 前作スネーク ) {

			if ( ($1 == 移動的:15) || ($1 == 移動的:16) || ($1 == 移動的:17) || ($1 == 移動的:18) ){
				$$b:act_3_破壊数カウント = $$b:act_3_破壊数カウント + 1

			} else if ( ($1 == 移動的:19) || ($1 == 移動的:20) || ($1 == 移動的:21) || ($1 == 移動的:22) ||\
				 ($1 == 移動的:23) || ($1 == 移動的:24) || ($1 == 移動的:25) || ($1 == 移動的:26) ||\
				 ($1 == 移動的:27) || ($1 == 移動的:28) || ($1 == 移動的:29) || ($1 == 移動的:30) ) {
				$$b:act_4_破壊数カウント = $$b:act_4_破壊数カウント + 1

				if ( $1 == 移動的:27 ) {
					mesg ＶＲ的共通 移動的:19 移動開始
					mesg ＶＲ的共通 移動的:20 移動開始
					mesg ＶＲ的共通 移動的:26 移動開始
				} else if ( $1 == 移動的:28 ) {
					mesg ＶＲ的共通 移動的:19 移動開始
					mesg ＶＲ的共通 移動的:20 移動開始
					mesg ＶＲ的共通 移動的:21 移動開始
				} else if ( $1 == 移動的:29 ) {
					mesg ＶＲ的共通 移動的:20 移動開始
					mesg ＶＲ的共通 移動的:21 移動開始
					mesg ＶＲ的共通 移動的:23 移動開始
				} else if ( $1 == 移動的:30 ) {
					mesg ＶＲ的共通 移動的:23 移動開始
					mesg ＶＲ的共通 移動的:24 移動開始
					mesg ＶＲ的共通 移動的:25 移動開始
				}

			} else if ( ($1 == 移動的:31) || ($1 == 移動的:32) || ($1 == 移動的:33) || ($1 == 移動的:34) ||\
						($1 == 移動的:35) || ($1 == 移動的:36) ) {
				$$b:act_5_破壊数カウント = $$b:act_5_破壊数カウント + 1
				if ( $$b:act_5_破壊数カウント == 2 ){
					mesg ＶＲ的共通 移動的:19 移動開始
					mesg ＶＲ的共通 移動的:20 移動開始
					mesg ＶＲ的共通 移動的:23 移動開始
				} else if ( $$b:act_5_破壊数カウント == 6 ){
					mesg ＶＲ的共通 移動的:21 移動開始
					mesg ＶＲ的共通 移動的:22 移動開始
					mesg ＶＲ的共通 移動的:24 移動開始
					mesg ＶＲ的共通 移動的:25 移動開始
					mesg ＶＲ的共通 移動的:26 移動開始
				}
			}

			if ( ($$b:act_1_破壊数カウント + $$b:act_2_破壊数カウント + $$b:act_3_破壊数カウント) == 18  ){ 
				mesg ＶＲ的共通 移動的:37 移動開始
				mesg ＶＲ的共通 移動的:38 移動開始
				mesg ＶＲ的共通 移動的:39 移動開始
				mesg ＶＲ的共通 移動的:40 移動開始
				mesg ＶＲ的共通 移動的:41 移動開始
				mesg ＶＲ的共通 移動的:42 移動開始
			}

		}

	}

	// 敵兵や的の処理
	// ------------------------------------
	proc ＶＲ標的マシンガン４面設定 {

		// ライデン or タキシードスネークを選択
		if ( ($s:選択プレイヤー == ライデン) ||  ($s:選択プレイヤー == タキシードスネーク) ) {

			command foreach -argc 4 -repeat 40 \
			-data { \
				// 的名,     フラグ,             ルート,                スピード
				// act 1 ----------
				{ 移動的:01, $$i:標的フラグＤ, d:M_R:ライデンルート１,     0 }\
				{ 移動的:02, $$i:標的フラグＤ, d:M_R:ライデンルート２,     0 }\
				{ 移動的:03, $$i:標的フラグＤ, d:M_R:ライデンルート３,     0 }\
				{ 移動的:04, $$i:標的フラグＤ, d:M_R:ライデンルート４,     0 }\
				{ 移動的:05, $$i:標的フラグＤ, d:M_R:ライデンルート５,     0 }\
				{ 移動的:06, $$i:標的フラグＤ, d:M_R:ライデンルート６,     0 }\
				// act 2 ----------
				{ 移動的:07, $$i:標的フラグＪ, d:M_R:ライデンルート７,   250 }\
				{ 移動的:08, $$i:標的フラグＪ, d:M_R:ライデンルート８,   250 }\
				{ 移動的:09, $$i:標的フラグＪ, d:M_R:ライデンルート９,   250 }\
				{ 移動的:10, $$i:標的フラグＪ, d:M_R:ライデンルート１０, 250 }\
				{ 移動的:11, $$i:標的フラグＪ, d:M_R:ライデンルート１１, 250 }\
				{ 移動的:12, $$i:標的フラグＪ, d:M_R:ライデンルート１２, 250 }\
				{ 移動的:13, $$i:標的フラグＪ, d:M_R:ライデンルート１３, 250 }\
				{ 移動的:14, $$i:標的フラグＪ, d:M_R:ライデンルート１４, 250 }\
				// act 3 ----------
				{ 移動的:15, $$i:標的フラグＪ, d:M_R:ライデンルート１５, 250 }\
				{ 移動的:16, $$i:標的フラグＪ, d:M_R:ライデンルート１６, 250 }\
				{ 移動的:17, $$i:標的フラグＪ, d:M_R:ライデンルート１７, 250 }\
				{ 移動的:18, $$i:標的フラグＪ, d:M_R:ライデンルート１８, 250 }\
				// act 4 ----------
				{ 移動的:19, $$i:標的フラグＫ, d:M_R:ライデンルート１９, 250 }\
				{ 移動的:20, $$i:標的フラグＫ, d:M_R:ライデンルート２０, 250 }\
				{ 移動的:21, $$i:標的フラグＫ, d:M_R:ライデンルート２１, 250 }\
				{ 移動的:22, $$i:標的フラグＫ, d:M_R:ライデンルート２２, 250 }\
				{ 移動的:23, $$i:標的フラグＫ, d:M_R:ライデンルート２３, 250 }\
				{ 移動的:24, $$i:標的フラグＫ, d:M_R:ライデンルート２４, 250 }\
				{ 移動的:25, $$i:標的フラグＫ, d:M_R:ライデンルート２５, 250 }\
				{ 移動的:26, $$i:標的フラグＫ, d:M_R:ライデンルート２６, 250 }\
				{ 移動的:27, $$i:標的フラグＥ, d:M_R:ライデンルート２７,   0 }\
				{ 移動的:28, $$i:標的フラグＥ, d:M_R:ライデンルート２８,   0 }\
				{ 移動的:29, $$i:標的フラグＥ, d:M_R:ライデンルート２９,   0 }\
				{ 移動的:30, $$i:標的フラグＥ, d:M_R:ライデンルート３０,   0 }\
				// act 5 ----------
				{ 移動的:31, $$i:標的フラグＤ, d:M_R:ライデンルート３１,  75 }\
				{ 移動的:32, $$i:標的フラグＤ, d:M_R:ライデンルート３２,  75 }\
				{ 移動的:33, $$i:標的フラグＤ, d:M_R:ライデンルート３３,  75 }\
				{ 移動的:34, $$i:標的フラグＤ, d:M_R:ライデンルート３４,  75 }\
				{ 移動的:35, $$i:標的フラグＤ, d:M_R:ライデンルート３５,  75 }\
				{ 移動的:36, $$i:標的フラグＤ, d:M_R:ライデンルート３６,  75 }\
				// act 6 ----------
				{ 移動的:37, $$i:標的フラグＤ, d:M_R:ライデンルート３７,  75 }\
				{ 移動的:38, $$i:標的フラグＤ, d:M_R:ライデンルート３８,  75 }\
				{ 移動的:39, $$i:標的フラグＤ, d:M_R:ライデンルート３９,  75 }\
				{ 移動的:40, $$i:標的フラグＤ, d:M_R:ライデンルート４０,  75 }\
			} \
			-exec { \
				if( $s:選択プレイヤー == タキシードスネーク ) {
					if( ( $2 != $$i:標的フラグＥ ) && ( $2 != $$i:標的フラグＫ ) ) {
						$$b:標的セット数 = $$b:標的セット数 + 1;
						if( $$b:標的セット数 % 2 ) {
							$$i:標的フラグ = ( $2 | d:VR_TRG_HIDESTART );
						} else {
							$$i:標的フラグ = ( $2 | d:VR_TRG_VISIBLESTART );
						}
					} else {
						// 爆発的を消すほど甘くはない
						$$i:標的フラグ = $2;
					}
				} else {
					$$i:標的フラグ = $2;
				}

				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグ \
					-route $3 \
					-c ＶＲ標的破壊マシンガン４面処理 \
					-speed $4
			}

		// スネーク or プリスキンを選択
		} else if ( ($s:選択プレイヤー == スネーク) || ($s:選択プレイヤー == プリスキン) ) {

			command foreach -argc 4 -repeat 42 \
			-data { \
				// 的名,     フラグ,             ルート,                スピード
				// act 1 ----------
				{ 移動的:01, $$i:標的フラグＤ, d:M_R:スネークルート４５,   0 }\
				{ 移動的:02, $$i:標的フラグＤ, d:M_R:スネークルート４６,   0 }\
				{ 移動的:03, $$i:標的フラグＤ, d:M_R:スネークルート４７,   0 }\
				{ 移動的:04, $$i:標的フラグＤ, d:M_R:スネークルート４８,   0 }\
				{ 移動的:05, $$i:標的フラグＤ, d:M_R:スネークルート４９,   0 }\
				{ 移動的:06, $$i:標的フラグＤ, d:M_R:スネークルート５０,   0 }\
				// act 2 ----------
				{ 移動的:07, $$i:標的フラグＪ, d:M_R:スネークルート５１, 250 }\
				{ 移動的:08, $$i:標的フラグＪ, d:M_R:スネークルート５２, 250 }\
				{ 移動的:09, $$i:標的フラグＪ, d:M_R:スネークルート５３, 250 }\
				{ 移動的:10, $$i:標的フラグＪ, d:M_R:スネークルート５４, 250 }\
				{ 移動的:11, $$i:標的フラグＪ, d:M_R:スネークルート５５, 250 }\
				{ 移動的:12, $$i:標的フラグＪ, d:M_R:スネークルート５６, 250 }\
				{ 移動的:13, $$i:標的フラグＪ, d:M_R:スネークルート５７, 250 }\
				{ 移動的:14, $$i:標的フラグＪ, d:M_R:スネークルート５８, 250 }\
				// act 3 ----------
				{ 移動的:15, $$i:標的フラグＪ, d:M_R:スネークルート５９, 250 }\
				{ 移動的:16, $$i:標的フラグＪ, d:M_R:スネークルート６０, 250 }\
				{ 移動的:17, $$i:標的フラグＪ, d:M_R:スネークルート６１, 250 }\
				{ 移動的:18, $$i:標的フラグＪ, d:M_R:スネークルート６２, 250 }\
				// act 4 ----------
				{ 移動的:19, $$i:標的フラグＫ, d:M_R:スネークルート６３, 250 }\
				{ 移動的:20, $$i:標的フラグＫ, d:M_R:スネークルート６４, 250 }\
				{ 移動的:21, $$i:標的フラグＫ, d:M_R:スネークルート６５, 250 }\
				{ 移動的:22, $$i:標的フラグＫ, d:M_R:スネークルート６６, 250 }\
				{ 移動的:23, $$i:標的フラグＫ, d:M_R:スネークルート６７, 250 }\
				{ 移動的:24, $$i:標的フラグＫ, d:M_R:スネークルート６８, 250 }\
				{ 移動的:25, $$i:標的フラグＫ, d:M_R:スネークルート６９, 250 }\
				{ 移動的:26, $$i:標的フラグＫ, d:M_R:スネークルート７０, 250 }\
				{ 移動的:27, $$i:標的フラグＥ, d:M_R:スネークルート７１,   0 }\
				{ 移動的:28, $$i:標的フラグＥ, d:M_R:スネークルート７２,   0 }\
				{ 移動的:29, $$i:標的フラグＥ, d:M_R:スネークルート７３,   0 }\
				{ 移動的:30, $$i:標的フラグＥ, d:M_R:スネークルート７４,   0 }\
				// act 5 ----------
				{ 移動的:31, $$i:標的フラグＤ, d:M_R:スネークルート７５,  75 }\
				{ 移動的:32, $$i:標的フラグＤ, d:M_R:スネークルート７６,  75 }\
				{ 移動的:33, $$i:標的フラグＤ, d:M_R:スネークルート７７,  75 }\
				{ 移動的:34, $$i:標的フラグＤ, d:M_R:スネークルート７８,  75 }\
				{ 移動的:35, $$i:標的フラグＤ, d:M_R:スネークルート７９,  75 }\
				{ 移動的:36, $$i:標的フラグＤ, d:M_R:スネークルート８０,  75 }\
				// act 6 ----------
				{ 移動的:37, $$i:標的フラグＤ, d:M_R:スネークルート８１, 100 }\
				{ 移動的:38, $$i:標的フラグＤ, d:M_R:スネークルート８２, 100 }\
				{ 移動的:39, $$i:標的フラグＤ, d:M_R:スネークルート８３, 100 }\
				{ 移動的:40, $$i:標的フラグＤ, d:M_R:スネークルート８４, 100 }\
				{ 移動的:41, $$i:標的フラグＤ, d:M_R:スネークルート８５, 100 }\
				{ 移動的:42, $$i:標的フラグＤ, d:M_R:スネークルート８６, 100 }\
			} \
			-exec { \
				if( $s:選択プレイヤー == プリスキン ) {
					if( ( $2 != $$i:標的フラグＥ ) && ( $2 != $$i:標的フラグＫ ) ) {
						$$b:標的セット数 = $$b:標的セット数 + 1;
						if( $$b:標的セット数 % 2 ) {
							$$i:標的フラグ = ( $2 | d:VR_TRG_HIDESTART );
						} else {
							$$i:標的フラグ = ( $2 | d:VR_TRG_VISIBLESTART );
						}
					} else {
						// 爆発的を消すほど甘くはない
						$$i:標的フラグ = $2;
					}
				} else {
					$$i:標的フラグ = $2;
				}

				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグ \
					-route $3 \
					-c ＶＲ標的破壊マシンガン４面処理 \
					-speed $4
			}

		//	前作スネークを選択
		} else if ( $s:選択プレイヤー == 前作スネーク ) {

			command foreach -argc 4 -repeat 42 \
			-data { \
				// 的名,     フラグ,             ルート,                   スピード
				// act 1 ----------
				{ 移動的:01, $$i:標的フラグＤ, d:M_R:前作スネークルート９３,     0 }\
				{ 移動的:02, $$i:標的フラグＤ, d:M_R:前作スネークルート９４,     0 }\
				{ 移動的:03, $$i:標的フラグＤ, d:M_R:前作スネークルート９５,     0 }\
				{ 移動的:04, $$i:標的フラグＤ, d:M_R:前作スネークルート９６,     0 }\
				{ 移動的:05, $$i:標的フラグＤ, d:M_R:前作スネークルート９７,     0 }\
				{ 移動的:06, $$i:標的フラグＤ, d:M_R:前作スネークルート９８,     0 }\
				// act 2 ----------
				{ 移動的:07, $$i:標的フラグＪ, d:M_R:前作スネークルート９９,   250 }\
				{ 移動的:08, $$i:標的フラグＪ, d:M_R:前作スネークルート１００, 250 }\
				{ 移動的:09, $$i:標的フラグＪ, d:M_R:前作スネークルート１０１, 250 }\
				{ 移動的:10, $$i:標的フラグＪ, d:M_R:前作スネークルート１０２, 250 }\
				{ 移動的:11, $$i:標的フラグＪ, d:M_R:前作スネークルート１０３, 250 }\
				{ 移動的:12, $$i:標的フラグＪ, d:M_R:前作スネークルート１０４, 250 }\
				{ 移動的:13, $$i:標的フラグＪ, d:M_R:前作スネークルート１０５, 250 }\
				{ 移動的:14, $$i:標的フラグＪ, d:M_R:前作スネークルート１０６, 250 }\
				// act 3 ----------
				{ 移動的:15, $$i:標的フラグＪ, d:M_R:前作スネークルート１０７, 250 }\
				{ 移動的:16, $$i:標的フラグＪ, d:M_R:前作スネークルート１０８, 250 }\
				{ 移動的:17, $$i:標的フラグＪ, d:M_R:前作スネークルート１０９, 250 }\
				{ 移動的:18, $$i:標的フラグＪ, d:M_R:前作スネークルート１１０, 250 }\
				// act 4 ----------
				{ 移動的:19, $$i:標的フラグＫ, d:M_R:前作スネークルート１１１, 250 }\
				{ 移動的:20, $$i:標的フラグＫ, d:M_R:前作スネークルート１１２, 250 }\
				{ 移動的:21, $$i:標的フラグＫ, d:M_R:前作スネークルート１１３, 250 }\
				{ 移動的:22, $$i:標的フラグＫ, d:M_R:前作スネークルート１１４, 250 }\
				{ 移動的:23, $$i:標的フラグＫ, d:M_R:前作スネークルート１１５, 250 }\
				{ 移動的:24, $$i:標的フラグＫ, d:M_R:前作スネークルート１１６, 250 }\
				{ 移動的:25, $$i:標的フラグＫ, d:M_R:前作スネークルート１１７, 250 }\
				{ 移動的:26, $$i:標的フラグＫ, d:M_R:前作スネークルート１１８, 250 }\
				{ 移動的:27, $$i:標的フラグＥ, d:M_R:前作スネークルート１１９,   0 }\
				{ 移動的:28, $$i:標的フラグＥ, d:M_R:前作スネークルート１２０,   0 }\
				{ 移動的:29, $$i:標的フラグＥ, d:M_R:前作スネークルート１２１,   0 }\
				{ 移動的:30, $$i:標的フラグＥ, d:M_R:前作スネークルート１２２,   0 }\
				// act 5 ----------
				{ 移動的:31, $$i:標的フラグＤ, d:M_R:前作スネークルート１２３,  75 }\
				{ 移動的:32, $$i:標的フラグＤ, d:M_R:前作スネークルート１２４,  75 }\
				{ 移動的:33, $$i:標的フラグＤ, d:M_R:前作スネークルート１２５,  75 }\
				{ 移動的:34, $$i:標的フラグＤ, d:M_R:前作スネークルート１２６,  75 }\
				{ 移動的:35, $$i:標的フラグＤ, d:M_R:前作スネークルート１２７,  75 }\
				{ 移動的:36, $$i:標的フラグＤ, d:M_R:前作スネークルート１２８,  75 }\
				// act 6 ----------
				{ 移動的:37, $$i:標的フラグＤ, d:M_R:前作スネークルート１２９, 125 }\
				{ 移動的:38, $$i:標的フラグＤ, d:M_R:前作スネークルート１３０, 125 }\
				{ 移動的:39, $$i:標的フラグＤ, d:M_R:前作スネークルート１３１, 125 }\
				{ 移動的:40, $$i:標的フラグＤ, d:M_R:前作スネークルート１３２, 125 }\
				{ 移動的:41, $$i:標的フラグＤ, d:M_R:前作スネークルート１３３, 125 }\
				{ 移動的:42, $$i:標的フラグＤ, d:M_R:前作スネークルート１３４, 125 }\
			} \
			-exec { \
				if( ( $2 != $$i:標的フラグＥ ) && ( $2 != $$i:標的フラグＫ ) ) {
					// 前作スネークは順番を逆にする
					$$b:標的セット数 = $$b:標的セット数 + 1;
					if( $$b:標的セット数 % 2 ) {
						$$i:標的フラグ = ( $2 | d:VR_TRG_VISIBLESTART );
					} else {
						$$i:標的フラグ = ( $2 | d:VR_TRG_HIDESTART );
					}
				} else {
					// 爆発的を消すほど甘くはない
					$$i:標的フラグ = $2;
				}

				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグ \
					-route $3 \
					-c ＶＲ標的破壊マシンガン４面処理 \
					-speed $4
			}

		}

	}

	proc ＡＣＴ６トラップ起動 {
		trap at1 ？ \
			-mask いる \
			-exec {

				if( ($$b:ＡＣＴ６トラップ起動制御 == 0) && (($$b:act_1_破壊数カウント + $$b:act_2_破壊数カウント + $$b:act_3_破壊数カウント) == 18) ){
					// ライデン or タキシードスネークを選択
					if ( ($s:選択プレイヤー == ライデン) ||  ($s:選択プレイヤー == タキシードスネーク) ) {
						mesg ＶＲ移動的 移動的:37 即ルート変更 d:M_R:ライデンルート４１
						mesg ＶＲ移動的 移動的:38 即ルート変更 d:M_R:ライデンルート４２
						mesg ＶＲ移動的 移動的:39 即ルート変更 d:M_R:ライデンルート４３
						mesg ＶＲ移動的 移動的:40 即ルート変更 d:M_R:ライデンルート４４
					// スネーク or プリスキンを選択
					} else if ( ($s:選択プレイヤー == スネーク) || ($s:選択プレイヤー == プリスキン) ) {
						mesg ＶＲ移動的 移動的:37 即ルート変更 d:M_R:スネークルート８７
						mesg ＶＲ移動的 移動的:38 即ルート変更 d:M_R:スネークルート８８
						mesg ＶＲ移動的 移動的:39 即ルート変更 d:M_R:スネークルート８９
						mesg ＶＲ移動的 移動的:40 即ルート変更 d:M_R:スネークルート９０
						mesg ＶＲ移動的 移動的:41 即ルート変更 d:M_R:スネークルート９１
						mesg ＶＲ移動的 移動的:42 即ルート変更 d:M_R:スネークルート９２
					// 前作スネークを選択
					} else if ( $s:選択プレイヤー == 前作スネーク ) {
						// 現状ではスネークルートを流用
						mesg ＶＲ移動的 移動的:37 即ルート変更 d:M_R:前作スネークルート１３５
						mesg ＶＲ移動的 移動的:38 即ルート変更 d:M_R:前作スネークルート１３６
						mesg ＶＲ移動的 移動的:39 即ルート変更 d:M_R:前作スネークルート１３７
						mesg ＶＲ移動的 移動的:40 即ルート変更 d:M_R:前作スネークルート１３８
						mesg ＶＲ移動的 移動的:41 即ルート変更 d:M_R:前作スネークルート１３９
						mesg ＶＲ移動的 移動的:42 即ルート変更 d:M_R:前作スネークルート１４０
					}
					$$b:ＡＣＴ６トラップ起動制御 = 1
				}

			}
	}

	proc ＶＲ初期配置標的マシンガン４面設定 {
		// 共通標的
		mesg ＶＲ的共通 移動的:01 移動開始
		mesg ＶＲ的共通 移動的:02 移動開始
		mesg ＶＲ的共通 移動的:03 移動開始
		mesg ＶＲ的共通 移動的:04 移動開始
		mesg ＶＲ的共通 移動的:05 移動開始
		mesg ＶＲ的共通 移動的:06 移動開始
	}


//###################################################################################
//									 ＢＧＭ
//###################################################################################

	// ------------------------------------
	// ＢＧＭの設定
	// ------------------------------------
	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT
			print 'bgm_set'
		#endif

		chara ＢＧＭマネージャー ＢＧＭマネ
	}


//###################################################################################
//									 アイテム
//###################################################################################

	// ------------------------------------
	// アイテムの設定
	// ------------------------------------
	// 再発生が必要な時は以下のプロックの中を記述する
	// ------------------------------------
	proc アイテム取得時番号設定 $:ボックス名 {
		#if d:DEBUG_PRINT
			print 'item_no_set'
		#endif
	}
	// アイテムの設置
	// ------------------------------------
	proc アイテム設定 {
		#if d:DEBUG_PRINT
			print 'item_set'
		#endif
	}



//###################################################################################
//									 エフェクト
//###################################################################################

	// ------------------------------------
	// 光源関係
	// ------------------------------------
	// フォグ
	// ------------------------------------
	// キャラ用光源(マップの設置が終わってから設定することで、キャラだけに光を当てる)
	// ------------------------------------



//###################################################################################
//									 カメラ
//###################################################################################
	// ------------------------------------
	// カメラ関係の設定
	// ------------------------------------
	// ステージカメラ設定
	// ------------------------------------
	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'chara_camera & stage_camera_set'
		#endif

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0
		chara カメラ メインカメラ		-c 0 -l 2 -p 40
		chara カメラ クリア時カメラ		-c 0 -l 0 -p 10

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 300,2048,0 \
			-f 9000 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}
	// ステージ固有のカメラ設定
	// ------------------------------------
	proc 武器訓練マシンガン４面カメラ設定 {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif

		command foreach -argc 1 -repeat 19 \
		-data { \
			{ ca001 }\
			{ ca002 }\
			{ ca003 }\
			{ ca004 }\
			{ ca005 }\
			{ ca006 }\
			{ ca007 }\
			{ ca008 }\
			{ ca009 }\
			{ ca010 }\
			{ ca011 }\
			{ ca012 }\
			{ ca013 }\
			{ ca014 }\
			{ ca015 }\
			{ ca016 }\
			{ ca017 }\
			{ ca018 }\
			{ ca019 }\
		} \
		-exec { \

			trap $1 d:PLAYER \
				-mask ？ \
				-exec {
					chara カメラ設定 メインカメラ \
						-c 0 \
						-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
						-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
						-r 850,2048,0 -f 9000 \
						-a 200 \
						-i 3 3 0 0 \
						-s $3
				}

			}

	}



//###################################################################################
//									 その他
//###################################################################################


// -----------------------------------------------------------------------------------
// 以下デバッグ専用proc
// -----------------------------------------------------------------------------------
// デバッグキャラ
// ------------------------------------
proc デバッグキャラセット {
	#if d:DEBUG_PRINT
		print 'debug_chara_set'
	#endif

	#if d:CHARA_CAMERA
		chara キャラカメラ 敵兵カメラ \
			-c d:TARGET_CHARA \
			-s -920,610,200 \
			-r -200,1024,0
	#endif

	#if d:SCREENSHOT
		chara スクリーンショット shot
	#endif

	#if d:USB_KEY
		chara USBキーボード実行 test \
			-e d:KBD_ESC {
				mesg プレイヤー d:PLAYER position -5500, -13000, -500
			} \
	#endif
}

