}//d


//天狗通路Ａ h //e
resource PO_天狗通路Ａ＿北東行け__e {
//vox t:vc240101 {
オタコン_000: {
Raiden, Snake's waiting. He's outside
the door on the northeast section of
the second floor.
}//<ページ数変更>
オタコン_000_1: {
Hurry up!
}
/*ライデン、スネークが待ってる。
二階の北東にある扉の先だ。急いで！
*/
//dv}//v
}//d

//裸注意 h //e
resource PO_裸注意＿操作制限１__e {
//vox t:vc240111 {
オタコン_000: {
Raiden, you'd better meet up with
Snake and get your gear back fast.
}
/*ライデン、早くスネークと合流して
装備をもらった方がいい。
*/
オタコン_001: {
You won't be able to choke,
kick, hang or throw like that.
}
/*その格好じゃ首絞めもキックも
エルードも投げも出来ないだろ？
*/
//dv}//v
}//d

//風邪状態 h //e
resource PO_裸注意＿風邪１__e {
//vox t:vc240121 {
オタコン_000: {
Raiden, did you catch
a cold or something?
}
/*ライデン、ひょっとして風邪でも
ひいてるんじゃないか？
*/
ライデン_001: {
Of course not!
I'm... AH-CHOO!
}
/*いや、そんなことは……ハックション！*/
オタコン_002: {
I knew it. Serves you right
for running around like that.
}
/*やっぱり。そんな格好してるからだよ。
*/
ライデン_003: {
I didn't exactly have
a choice... CHOO!!
}
/*俺だって好きでしてるわけじゃ……
ハックション！
*/
オタコン_004: {
Bless you.
}
/*お大事に。*/
//dv}//v
}//d
//二回目以降 t //e
resource PO_裸注意＿風邪２__e {
//vox t:vc240131 {
オタコン_000: {
You'll have to do something
about that cold.
}//<ページ数変更>
オタコン_000_1: {
If you can't stop sneezing, you're
an open invitation to everyone
within earshot.
}
/*風邪は何とかした方がいいね。
そうひっきりなしにクシャミしてたんじゃ
敵に見つかってしまう。
*/
オタコン_001: {
Take some cold medication.
And get something to wrap
up in at least.
}
/*風邪薬を飲めば何とかなるだろう。
とりあえず何か羽織るのもいいかもね。
*/
//dv}//v
}//d

//裸時はダメージも大きい h //e
resource PO_裸注意＿ダメージ__e {
//vox t:vc240141 {
オタコン_000: {
Raiden, you can't protect
yourself like this.
}//<ページ数変更>
