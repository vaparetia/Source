// キャラクター関係
#if d:RAIDEN
	#define		PLAYER		ライデン	// モーションができるまで名前はスネーク
#else
	#define		PLAYER		スネーク
#endif

#define ENE_SNEAK_SIGHT_W25		3000
#define ENE_ALERT_SIGHT_W25		8000

