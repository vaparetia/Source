//-----------------------------------------------------------------------------
// ドア設定
proc ドア設定 {
#if d:DEBUG_PRINT
	print '*** Door Set ***'
#endif

	// ドア
	//   -m オブジェクト名  -d 向き  -p 場所  -slide スライド量  -time 時間  -between マップ名１ マップ名２  -exec { $:開閉フラグ }

	// ＡＢ連絡橋へのドア
	chara ドア ＡＢ連絡橋へのドア \
		-m d:DOOR_NAME1 \
		-d 0 3072 0 \
		-p -44125 0 -20000 \
		-s 2000 \
		-t 10 \
		-exec {
			if(!($:開閉フラグ)) {
			} else {
			}
		}
	trap dr001 ？ -mask ＊ \
		-exec {
			if($3 == 入る) {
				mesg ドア ＡＢ連絡橋へのドア open
			} else if($3 == 出る) {
				mesg ドア ＡＢ連絡橋へのドア close
			}
		}

	// ＢＣ連絡橋へのドア
	chara ドア ＢＣ連絡橋へのドア \
		-m d:DOOR_NAME1 \
		-d 0 0 0 \
		-p -55500 0 -43625 \
		-s 2000 \
		-t 10 \
		-exec {
			if(!($:開閉フラグ)) {
			} else {
			}
		}
	trap dr002 ？ -mask ＊ \
		-exec {
			if($3 == 入る) {
				mesg ドア ＢＣ連絡橋へのドア open
			} else if($3 == 出る) {
				mesg ドア ＢＣ連絡橋へのドア close
			}
		}

	// 部屋西側のドア
	chara ドア 部屋西側のドア \
		-m d:DOOR_NAME2 \
		-d 0 1024 0 \
		-p -53375 0 -24500 \
		-s 2000 \
		-t 10 \
		-b 廊下 変電室 \
		-exec {
			if(!($:開閉フラグ)) {
					mesg マップ接合 Ｂ脚接合１ off
			} else {
					mesg マップ接合 Ｂ脚接合１ on
			}
		}
	trap dr003 ？ -mask ＊ \
		-exec {
			if($3 == 入る) {
				mesg ドア 部屋西側のドア open
			} else if($3 == 出る) {
				mesg ドア 部屋西側のドア close
			}
		}

	// 部屋北側のドア
	chara ドア 部屋北側のドア \
		-m d:DOOR_NAME2 \
		-d 0 2048 0 \
		-p -49750 0 -39125 \
		-s 2000 \
		-t 10 \
		-b 変電室 廊下 \
		-exec {
			if(!($:開閉フラグ)) {
					mesg マップ接合 Ｂ脚接合２ off
			} else {
					mesg マップ接合 Ｂ脚接合２ on
			}
		}
	trap dr004 ？ -mask ＊ \
		-exec {
			if($3 == 入る) {
				mesg ドア 部屋北側のドア open
			} else if($3 == 出る) {
				mesg ドア 部屋北側のドア close
			}
		}
}

//-----------------------------------------------------------------------------
// ロッカー設定
proc ロッカー設定 {
#if d:DEBUG_PRINT
	print '*** Locker Set ***'
#endif

	// ロッカー
	chara ロッカー管理 管理人さん -n 7
	command ロッカーモーション -motion locker
	command プレイヤーロッカーモーション -motion sna_locker

	// 左ロッカー
	chara ロッカー ロッカー:01 \
		-kms d:DOOR_NAME3 \
		-p (-50000 - 50),0,-42875 \
		-r 0,0,0 \
		-s 0 \
		-flag 0x0001 \
		-exec {
		}
	trap lk001 d:PLAYER \
		-and \
		-mask いる \
		-state 0,4 \
		-dir 2048,512 0,512 \
		-button d:ACTION_BUTTON,-1 \
		-exec {
			command ロッカー状態 -n ロッカー:01
			mesg プレイヤー d:PLAYER locker ロッカー:01 $status 2048,512 (-50000 - 50),-42875
		}
	trap lk001 d:PLAYER \
		-mask ？ \
		-state 6 \
		-camera \			//カメラトラップであることを明示
		-exec {
//			chara カメラ設定 モーションカメラ \
//				-c 1 \
//				-p -6001,-12155,-50157 -t -7742,-14455,-52144 \
//				-r 467,2517,0 -f 3503 \
//				-a 230 \
//				-i 0 2 0 0 \
//				-s $3
		}

	// 中ロッカー
	chara ロッカー ロッカー:02 \
		-kms d:DOOR_NAME3 \
		-p (-49000 - 50),0,-42875 \
		-r 0,0,0 \
		-s 0 \
		-flag 0x0001 \
		-exec {
		}
	trap lk002 d:PLAYER \
		-and \
		-mask いる \
		-state 0,4 \
		-dir 2048,512 0,512 \
		-button d:ACTION_BUTTON,-1 \
		-exec {
			command ロッカー状態 -n ロッカー:02
			mesg プレイヤー d:PLAYER locker ロッカー:02 $status 2048,512 (-49000 - 50),-42875
		}

	// 右ロッカー
	chara ロッカー ロッカー:03 \
		-kms d:DOOR_NAME3 \
		-p (-48000 - 50),0,-42875 \
		-r 0,0,0 \
		-s 0 \
		-flag 0x0001 \
		-exec {
		}
	trap lk003 d:PLAYER \
		-and \
		-mask いる \
		-state 0,4 \
		-dir 2048,512 0,512 \
		-button d:ACTION_BUTTON,-1 \
		-exec {
			command ロッカー状態 -n ロッカー:03
			mesg プレイヤー d:PLAYER locker ロッカー:03 $status 2048,512 (-48000 - 50),-42875
		}

	// 廊下変電盤上
	chara ロッカー ロッカー:04 \
		-kms d:DOOR_NAME6 \
		-p -57000,0,(-34750 + 50) \
		-r 0,1024,0 \
		-s 0 \
		-flag 0x0001 \
		-exec {
		}
	trap lk004 d:PLAYER \
		-and \
		-mask いる \
		-state 0 \
		-dir 3072,512 \
		-button d:ACTION_BUTTON \
		-exec {
			command ロッカー状態 -n ロッカー:04
			mesg プレイヤー d:PLAYER locker ロッカー:04 $status 3072,512 -57000,(-34750 + 50)
		}

	// 廊下変電盤下
	chara ロッカー ロッカー:05 \
		-kms d:DOOR_NAME6 \
		-p -57000,0,(-28750 + 50) \
		-r 0,1024,0 \
		-s 0 \
		-flag 0x0001 \
		-exec {
		}
	trap lk005 d:PLAYER \
		-and \
		-mask いる \
		-state 0 \
		-dir 3072,512 \
		-button d:ACTION_BUTTON \
		-exec {
			command ロッカー状態 -n ロッカー:05
			mesg プレイヤー d:PLAYER locker ロッカー:05 $status 3072,512 -57000,(-28750 + 50)
		}

	// 部屋変電盤上
	chara ロッカー ロッカー:06 \
		-kms d:DOOR_NAME5 \
		-p -52875,0,(-38750 + 50) \
		-r 0,1024,0 \
		-s d:LOCKER_STATE_OPEN \
		-flag 0x0001 \
		-exec {
		}
	trap lk006 d:PLAYER \
		-and \
		-mask いる \
		-state 0 \
		-dir 3072,512 \
		-button d:ACTION_BUTTON \
		-exec {
			command ロッカー状態 -n ロッカー:06
			mesg プレイヤー d:PLAYER locker ロッカー:06 $status 3072,512 -52875,(-38750 + 50)
		}

	// 部屋変電盤下
	chara ロッカー ロッカー:07 \
		-kms d:DOOR_NAME4 \
		-p -52875,0,(-37750 + 50) \
		-r 0,1024,0 \
		-s 0 \
		-flag 0x0001 \
		-exec {
		}
	trap lk007 d:PLAYER \
		-and \
		-mask いる \
		-state 0 \
		-dir 3072,512 \
		-button d:ACTION_BUTTON \
		-exec {
			command ロッカー状態 -n ロッカー:07
			mesg プレイヤー d:PLAYER locker ロッカー:07 $status 3072,512 -52875,(-37750 + 50)
		}

}

