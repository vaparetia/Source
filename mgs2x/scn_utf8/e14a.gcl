	print '*** Watcher Commander ***'
#endif

	chara 警備コマンダー wccomm -e { 警備兵３ サポート兵１ }
}

proc 攻撃兵コマンダー {
#if d:DEBUG_PRINT 
	print '*** Attacker Commander ***'
#endif

	chara 攻撃コマンダー atcomm -e { 攻撃兵１ }
}

proc 敵兵設定 {
#if d:DEBUG_PRINT
	print '*** Enemy Set ***'
#endif

	if(d:_ストーリー進行度 > 2)
	{
		// コマンダー
		//   -w 警備コマンダーproc  -a 攻撃コマンダーproc  -r 復活場所 マップＩＤ  -c 待機場所 マップＩＤ  -v 音声  -m 危険モード  -p クリアリングエリア ルート ポイント プロック  -x 司令官危険音声  -y 司令官警戒音声  -g 銃ライト  -z 麻酔持続時間  -b 危険モードでの復活人数 
		chara コマンダー ステージ敵兵セット \
			-w 警備兵コマンダー \
			-a 攻撃兵コマンダー \
			-r -52750,0,-45250 廊下 -42500,0,-21250 廊下 \
			-c -52750,0,-45250 廊下 -42500,0,-21250 廊下 \
			-v [ene_tank_voice:01] \
			-m $w:スタートアラートモード
	}
}

