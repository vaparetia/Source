#define STAGE_END  1			// ロードプロック
#define NODE       1			// ノード

#define SCREENSHOT 0			// スクリーンショット
#define KEYBOARD   1			// ＵＳＢキーボード

//-----------------------------------------------------------------------------
// マップ関係
#define HZX_NAME      w14a
#define LT2_NAME      w14a

#define KMS_NAME0     w14a0				// 廊下
#define KMS_NAME1     w14a0r			// 廊下天井
#define KMS_NAME2     w14a1				// 変電室
#define KMS_NAME3     w14a1r			// 変電室天井
#define KMS_NAME4     w14a1_sdw			// 影投影モデル

#define DOOR_NAME1    w14a_dr00			// 連絡橋への扉
#define DOOR_NAME2    w14a_dr01			// 脚内の扉
#define DOOR_NAME3    neo_locker_door	// ロッカー扉
#define DOOR_NAME4    w14a_hdr01		// 変電盤扉１
#define DOOR_NAME5    w14a_hdr02		// 変電盤扉２
#define DOOR_NAME6    w14a_hdr03		// 変電盤扉３

#define SHADOW_NAME1  vw14a0_obj00		// SEAL AC 死体影
#define SHADOW_NAME2  vw14a0_obj01		// SEAL B 死体影
#define SHADOW_NAME3  vw14a1_obj00		// 大佐死体有り影
