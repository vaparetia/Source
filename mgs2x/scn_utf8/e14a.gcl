		-m d:OBJECT_NAME11 \
		-r 0,0,0 \
		-p -50000,0,-30000 \
		-s 100,100,100 \
		-l d:LT2_NAME
	chara プットオブジェ フェンスｂ０３ \
		-m d:OBJECT_NAME12 \
		-r 0,0,0 \
		-p -50000,0,-30000 \
		-s 100,100,100 \
		-l d:LT2_NAME

	// 天井オブジェクト
	chara プットオブジェ 天井オブジェクト \
		-m d:OBJECT_NAME1 \
		-r 0,0,0 \
		-p -50000,0,-30000 \
		-s 100,100,100 \
		-l d:LT2_NAME

	// スリット光
	//   -p 中心座標  -n 法線  -d 光線の絶対方向  -l 光線の到達距離
	chara スリット光２ スリット光 \
		-p -45500 4687 -34750 \
		-n 1 0 0 \
		-d -1000 -750 0 \
		-l 3000
	chara スリット光２ スリット光 \
		-p -45500 4687 -32750 \
		-n 1 0 0 \
		-d -1000 -750 0 \
		-l 3000
	chara スリット光２ スリット光 \
		-p -45500 4687 -30750 \
		-n 1 0 0 \
		-d -1000 -750 0 \
		-l 3000
	chara スリット光２ スリット光 \
		-p -45500 4687 -28750 \
		-n 1 0 0 \
		-d -1000 -750 0 \
		-l 3000
	chara スリット光２ スリット光 \
		-p -45500 4687 -26750 \
		-n 1 0 0 \
		-d -1000 -750 0 \
		-l 3000

	// 漏電火花
	//   -p 中心座標
	chara 漏電火花 漏電火花 -p -50659 2439 -28877

	// 影投影モデル -m 影投影専用モデル -p 設置位置
	chara 影投影モデル 影投影モデル -m d:KMS_NAME4 -p 0,0,0

	// 影管理 -t 光源タイプ -l 光源距離(並行光源時のみ有効) -p 並行光源方向直接指定
	chara 影管理 影管理 -t 0 -l 6000 -p -1563,-1998,758

	trap ca101 ？ -mask ？ \
	-exec {
		if( $3 == 入る ){
			mesg 影管理 影管理 add $2 影投影モデル
		}else{
			mesg 影管理 影管理 del $2
		}
	}
}





//=============================================================================
// フォグ、カメラ、ロード
//=============================================================================

//-----------------------------------------------------------------------------
// キャラ用ライト設定
proc キャラ用ライト設定 {
	#if d:DEBUG_PRINT
		print '*** Chara Light Set ***'
	#endif

	chara 環境光 環境光源 \
		 -c 25 39 34

	chara 平行光 平行光源 \
		 -c 113 113 97 \
		 -p -3800 -2800 -1400
}

//-----------------------------------------------------------------------------
// フォグ設定
proc フォグ設定 {
#if d:DEBUG_PRINT
	print '*** Fog Set ***'
#endif

	// フォグ
	//   -c ＲＧＢカラー  -n ＮＥＡＲ値  -f ＦＡＲ値
	chara フォグ 霧\
		-c 16, 38, 41 \
		-n -1000 \
		-f 38000
}

//-----------------------------------------------------------------------------
// カメラ設定
proc カメラ設定 {
#if d:DEBUG_PRINT
	print '*** Camera Set ***'
#endif

	// カメラ
	//   -c チャンネル番号  -l カメラレベル  -p 優先度
	//
	//   シナリオカメラは最大16個までおける。
	//   チャンネル番号 ：
	//       ０：通常画面 １：小窓
	//   カメラレベル ：
	//       ０：カットインカメラ（主観より強） 強
	//       １：カットインカメラ（主観より弱） ↑
	//       ２：エリアカメラ		   ↓
	//       ３：ステージデフォルトカメラ	   弱
	//   優先度 ：
	//       エリアカメラに有効
	//       数字が小さい程優先度高
	chara カメラ ステージカメラ	-c 0 -l 3 -p 0
	chara カメラ サブカメラ１	-c 0 -l 2 -p 50
	chara カメラ サブカメラ２	-c 0 -l 2 -p 40
	chara カメラ サブカメラ３	-c 0 -l 2 -p 30
	chara カメラ ビヨンドカメラ	-c 0 -l 2 -p 20
	chara カメラ ロードカメラ	-c 0 -l 2 -p 10		// 水密ドア ロード用にしか使ってません

	// カメラ設定
	//   -c カメラタイプ  -b バウンド小 バウンド大  -l リミット小 リミット大  -p カメラ位置  -t ターゲット位置  -r カメラ角度  -f カメラトラック  -a カメラ画角  -i カメラ補完方法（ＩＮ） カメラ補完方法（ＯＵＴ） 補完時間（ＩＮ） 補完時間（ＯＵＴ）  -d パッドフラグ  -z 各種フラグ  -k ＫＩＬＬ  -s ０オフ／１オン  -o ＯＮになるまでの待ち時間  -E スライドタイプ スライド待ち時間 スライド距離１ スライド距離２ スライドスピード [スライドフラグ]  -N 内部補完時間
	//
	//   -b -l は必要に応じて設定。-p -t -r はタイプに応じて使用するものが取得される。省略したオプションは、前回設定を引き継ぐ。
	//   フラグ：
	//       CAMERA_CUT_IN (カットインカメラ) CAMERA_NO_CUSHION (遊びなしカメラ) CAMERA_BOUNDCHANGE_QUICK (バウンド変更を即時に反映) CAMERA_INTERP_CAMERA (補完カメラ設定)
	//   カメラタイプ：
	//       ０：上俯瞰追従型（トラックと角度を指定） １：位置・角度固定型（ターゲット位置とカメラ位置を指定） ２：位置固定、追従型（カメラ位置を指定） ３：位置固定、Ｘ角度追従型（カメラ位置を指定） ４：ターゲット固定、プレイヤー追従カメラ（ターゲットとトラックを指定）
	//   補完方法：
	//       －１：指定なし ０：一瞬 １：補完シューン ２：補完ウニョーン ３：補完ウーニャーン ４：一定時間で
	//       補完時間は４番指定のとき有効。補完（ＩＮ）の指定は必須。２つのカメラ間の補完方法は、ＯＵＴ側カメラのＯＵＴ補完関数が指定してある場合にはその関数を使用し、指定がない場合には、ＩＮ側カメラのＩＮ補完関数を使用するようになっている。
	//   パッドフラグ：
	//       このフラグを指定しておくと、パッドの上が画面の上になるように自動調節する。
	//   スライドカメラ設定方法：
	//       スライドタイプ (０／１ － 左右タイプ／前後タイプ) スライド待ち時間 (スライドするまでの待ちフレーム数) スライド距離１・２ (左右タイプの場合 左右スライド距離。前後タイプの場合 接近距離、離れた距離) スライドスピード (そのまんま) スライドフラグ (1にしておくと、入った時スライドしていない状態から始まります。)
	//   補完カメラの設定方法：
	//       補完カメラとは？ － 設定したカメラに指定フレーム数かけて移動するカメラ。例として、オルガ戦のパンカメラ。
	//       設定方法 － -z に d:CAMERA_INTERP_CAMERA を指定。さらに -interp_time に補完フレーム数を指定。

	// デフォルトカメラ
	chara カメラ設定 ステージカメラ \
		-c 0 \
		-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
		-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
		-r 850,2048,0 \
		-f 5500 \
		-a 200 \
		-i 1 -1 0 0 \
		-s 1

	// 部屋の中
	trap ca101 d:PLAYER \
		-camera -mask ？ \
		-exec {
			chara カメラ設定 サブカメラ１ \
				-c 0 \
				-b -51000,d:CAM_MIN,-36000 -45000,d:CAM_MAX,-23000 \
				-l -51000,d:CAM_MIN,-39000 -45000,d:CAM_MAX,-24000 \
				-r 700,2048,0 \
				-f 5500 \
				-a 200 \
				-i 0 0 0 0 \
				-s $3
		}

	// 南側廊下
	trap ca001 d:PLAYER \
		-camera -mask ？ \
		-exec {
			chara カメラ設定 サブカメラ１ \
				-c 0 \
				-b -54750,d:CAM_MIN,d:CAM_MIN -46000,d:CAM_MAX,-15800 \
				-l -54750,d:CAM_MIN,d:CAM_MIN -46000,d:CAM_MAX,-20500 \
				-r 120,2048,0 \
				-f 4640 \
				-a 200 \
				-i 2 2 0 0 \
				-s $3
		}

	// 西側廊下
	trap ca002 d:PLAYER \
		-camera -mask ？ \
		-exec {
			chara カメラ設定 サブカメラ１ \
				-c 0 \
				-b -54750,d:CAM_MIN,d:CAM_MIN -54750,d:CAM_MAX,-15800 \
				-l -54750,d:CAM_MIN,d:CAM_MIN -54750,d:CAM_MAX,-20500 \
				-r 120,2048,0 \
				-f 4640 \
				-a 200 \
				-i 0 -1 0 0 \
				-s $3
		}

	// 北側廊下
	trap ca003 d:PLAYER \
		-camera -mask ？ \
		-exec {
			chara カメラ設定 サブカメラ１ \
				-c 0 \
				-b -55000,6000,-40000      -49750,d:CAM_MAX,-40000 \
				-l -55000,d:CAM_MIN,-41000 -49750,d:CAM_MAX,-41000 \
				-r 450,2048,0 \
				-f 5500 \
				-a 200 \
				-i 0 -1 0 0 \
				-s $3
		}
}

//-----------------------------------------------------------------------------
// ロード設定
proc ロード設定 {
#if d:DEBUG_PRINT
	print '*** Load Set ***'
#endif

	// @ステージ終了時処理 目標位置  終了時方向  呼び出しプロックに入る  入ってゆく姿勢

	// ＡＢ連絡橋へ (w13a)
	trap ld001 d:PLAYER \
		-mask 入る \
		-exec {
			if($f:ロードチェックＯＮフラグ == 1) {
				@ステージ終了時処理 -42250 0 -19250 1024 mv_w14a_w13a_0 d:DEFAULT_M_TYPE
			}
		}

	// ＢＣ連絡橋へ (w15a)
	trap ld002 d:PLAYER \
		-mask 入る \
		-exec {
			if($f:ロードチェックＯＮフラグ == 1) {
				@ステージ終了時処理 -54750 0 -45500 2048 mv_w14a_w15a_0 d:DEFAULT_M_TYPE
			}
		}
}

proc ロードプロック {
#if d:DEBUG_PRINT
	print '*** Load Proc ***'
#endif

	if($s:呼び出しプロック == mv_w14a_w13a_0) {
		// ＡＢ連絡橋へ
		@mv_e43a
	} else if($s:呼び出しプロック == mv_w14a_w15a_0) {
		// ＢＣ連絡橋へ
		@mv_e43a
	}
}





//=============================================================================
// ステージ進入時処理
//=============================================================================

proc ステージ進入時処理 {
#if d:DEBUG_PRINT
	print '*** Stage Start Proc ***'
#endif

	// @ステージ開始時処理 タイプ(スライドドア、水密ドア、何もなし)   ドアの名前   移動距離   状態(前のステージ状態、走り、歩き)
	if($s:登場ポイント == sp_w13a_w14a_0) {
		@ステージ開始時処理 d:LOAD_TYPE:SL_DOOR_TYPE ＡＢ連絡橋へのドア 2000 d:DEFAULT_M_TYPE
	} else if($s:登場ポイント == sp_w15a_w14a_0) {
		@ステージ開始時処理 d:LOAD_TYPE:SL_DOOR_TYPE ＢＣ連絡橋へのドア 2000 d:DEFAULT_M_TYPE
	}
}

proc E3撮影用 {
	chara マルチウェイトキャラ マルチ \
		-name d:PLAYER \
		-model sna_def_mh

	chara 臨時顔アニメキャラ アニメキャラ \
		-chara	d:PLAYER
}
proc ＵＳＢキーボードセット {
		chara USBキーボード実行 ＵＳＢキーボード \
				-e d:KBD_R	{ 	command メニュー設定 -menu on -gage on -radar on -subwin on	} \
				-e d:KBD_T	{	command メニュー設定 -menu off -gage off -radar off -subwin off	} \
				-e d:KBD_F9 {
					//mesg 警備兵 警備兵Ａ ルート変更 27 -5000,3000,-9000 １Fリフレッシュルーム
				} \
				-e d:KPD_0	{ restart } \
				-e d:KPD_PLUS		{ mesg  プットオブジェ これも天井 on } \
				-e d:KPD_MINUS		{ mesg  プットオブジェ これも天井 off } \
				-e d:KPD_ENTER		{ mesg Ｃ４ Ｃ４ bomb } \
				-e d:KBD_ESC {	mesg 臨時顔アニメキャラ アニメキャラ モーション再生 normal 30
								mesg delay カメラディレイ kill
								mesg 臨時顔アニメキャラ アニメキャラ 視線変更 -1
								mesg 遠景ぼかし 遠景ぼかし１ off
								mesg 遠景ぼかし 遠景ぼかし２ off
								mesg 遠景ぼかし 遠景ぼかし３ off
								mesg 近景ぼかし 近景ぼかし１ off
								mesg 近景ぼかし 近景ぼかし２ off
								mesg 近景ぼかし 近景ぼかし３ off
							} \
				-e d:KBD_F1	{ mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_speech_a 30 } \
				-e d:KBD_F2 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_speech_i 30 } \
				-e d:KBD_F3 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_speech_u 30 } \
				-e d:KBD_F4 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_speech_e 30 } \
				-e d:KBD_F5 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_speech_o 30 } \
				-e d:KBD_F6 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_speech_n 30 } \
				-e d:KBD_F7 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_teeth 30 } \
				-e d:KBD_F8 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_scream 0 } \
				-e d:KBD_F9 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_relax 30 } \
				-e d:KBD_F10{ mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_surprise 30 } \
				-e d:KBD_F11{ mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_sigh 30 } \
				-e d:KBD_F12{ mesg 臨時顔アニメキャラ アニメキャラ 視線変更 2 } \
				-e d:KBD_Q	{ mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_tension 30 } \
				-e d:KBD_W	{
							  chara delay カメラディレイ \
								-time 1 \
								-exec {
									mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_exciting 30
									return 60
								}
							} \
				-e d:KBD_E	{ mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_pain 30 } \
				-e d:KBD_R	{ mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_T12a1D71 30 } \
				-e d:KBD_T	{
								mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 120 -7707,-3929,-14119
								chara delay カメラディレイ \
									-time 90 \
									-exec {
										mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 60 6710,-3960,-18261
									}
							} \
				-e d:KBD_Y	{
							mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_sneeze 0
							//mesg プレイヤー d:PLAYER motion d:モーションリスト:sna_m9_behind_squat_r_sneez_e3 \
							//	 -1 -1 -1 0x00000004
							} \
				-e d:KBD_U	{ mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_teeth 30
							  chara delay カメラディレイ \
								-time 20 \
								-exec {
										mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_surprise 20
								}
							  chara delay カメラディレイ \
								-time 40 \
								-exec {
										mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_teeth 20
								}
							} \
				-e d:KBD_I	{ mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_teeth 20
							  chara delay カメラディレイ \
								-time 30 \
								-exec {
										mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_relax 20
								}
							  chara delay カメラディレイ \
								-time 60 \
								-exec {
										mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_surprise 20
								}
							  chara delay カメラディレイ \
								-time 90 \
								-exec {
										mesg 臨時顔アニメキャラ アニメキャラ モーション再生  normal 20
								}
							} \
				-e d:KBD_O	{
								mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 90 \
										($i:プレイヤー位置Ｘ-1000),($i:プレイヤー位置Ｙ-200),($i:プレイヤー位置Ｚ+3000)
								chara delay カメラディレイ \
									-time 90 \
									-exec {
										mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 90 \
										($i:プレイヤー位置Ｘ+1000),($i:プレイヤー位置Ｙ-200),($i:プレイヤー位置Ｚ+3000)
									}
								chara delay カメラディレイ \
									-time 180 \
									-exec {
										mesg 臨時顔アニメキャラ アニメキャラ 視線変更 -1
									}
							} \
				-e d:KBD_P	{
							  chara delay カメラディレイ \
								-time 1 \
								-exec {
		//								command ゲット敵兵座標 敵兵:01 $i:敵兵Ｘ $i:敵兵Ｙ $i:敵兵Ｚ
		//								mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 5 $i:敵兵Ｘ $i:敵兵Ｙ $i:敵兵Ｚ
		//								return 5
								}
							} \
				-e d:KBD_1 { mesg 遠景ぼかし 遠景ぼかし１ on } \
				-e d:KBD_2 { mesg 遠景ぼかし 遠景ぼかし２ on } \
				-e d:KBD_3 { mesg 遠景ぼかし 遠景ぼかし３ on } \
				-e d:KBD_4 { mesg 近景ぼかし 近景ぼかし１ on } \
				-e d:KBD_5 { mesg 近景ぼかし 近景ぼかし２ on } \
				-e d:KBD_6 { mesg 近景ぼかし 近景ぼかし３ on } \
				-e d:KPD_MINUS {
								mesg プレイヤー スネーク position \
								2966 2000 -15180
							} \
				-e d:KPD_NUMLOCK {
						mesg プット大ガラスオブジェ でかガラス 割れる
				} \
				-e d:KPD_7 {
					mesg プレイヤー スネーク shadow 1
				} \
				-e d:KPD_8 {
					mesg プレイヤー スネーク shadow 0
				} \
				-e d:KBD_L {
									mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_teeth 40
									chara delay カメラディレイ \
										-time 20 \
										-exec {
												mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_tension 30
										}
				} \
				-e d:KBD_A {
					mesg プレイヤー d:PLAYER position 1000 1000 5000
					command プレイヤー無敵セット
					mesg コマンダー 敵兵セット 視界オフ
				 } \
				-e d:KBD_0 { restart }
		#endif
	}
