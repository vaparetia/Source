//=============================================================================
// メイン
//=============================================================================

chara マップ 廊下   -k d:KMS_NAME0 -h d:HZX_NAME, 0 -l d:LT2_NAME
chara マップ 変電室 -k d:KMS_NAME2 -h d:HZX_NAME, 1 -l d:LT2_NAME

chara マップ接合 Ｂ脚接合１ 廊下 変電室
chara マップ接合 Ｂ脚接合２ 廊下 変電室

command マップ設定 廊下 変電室 -set {

	//----- 基本設定
	@サウンド設定
	@常駐キャラ設定				// ヘッダーに定義
	@プレイヤー設定
	@E3撮影用
	@ＵＳＢキーボードセット
#if d:ENEMY_SET
	@敵兵設定
#endif
	@ＢＧＭ設定

	//----- オブジェクト
	@ドア設定
	@ロッカー設定
	@アイテム設定
	@爆弾解体設定

	//----- フォグ、カメラ、ロード
	@キャラ用ライト設定
	@フォグ設定
	@カメラ設定
	@ロード設定
}

command マップ設定 廊下 -set {

	//----- ビヨンド、ジャンプ
	@ビヨンド設定_廊下
	@ジャンプ設定_廊下

	//----- オブジェクト
	@監視カメラ設定_廊下
	@天井君設定_廊下
	@壊れ物設定_廊下
	@その他オブジェクト設定_廊下
}

command マップ設定 変電室 -set {

	//----- ビヨンド、ジャンプ
	@ビヨンド設定_変電室
	@ジャンプ設定_変電室

	//----- オブジェクト
	@ノード端末設定 3072
	@天井君設定_変電室
	@壊れ物設定_変電室
	@その他オブジェクト設定_変電室
}

#include "cdc_common.h"			// ※※ 通信機の include は移動させないこと！！ ※※

command マップ表示 -show 廊下

@ステージ進入時処理





