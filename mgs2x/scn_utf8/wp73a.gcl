//###################################################################################
//									 ライデン　的設定
//###################################################################################

//////////////////////////
//	ブレード３面用
//////////////////////////

	//	スタート処理
	proc ライデン的３面スタート処理 {
		mesg ＶＲ的共通 移動的:01 移動開始

	}

	//	破壊時処理
	proc ライデン的３面破壊処理 {
		//	ルーム１
		if ($1 == 移動的:01) {
			mesg ＶＲ的共通 移動的:02 移動開始
			mesg ＶＲ的共通 移動的:03 移動開始

		} else if ( ($1 == 移動的:02) || ($1 == 移動的:03) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 2) {
				mesg ＶＲ的共通 移動的:04 移動開始
				mesg ＶＲ的共通 移動的:05 移動開始
				mesg ＶＲ的共通 移動的:06 移動開始

				eval ($$i:的起動フラグ = 0)
			}

		} else if ( ($1 == 移動的:04) || ($1 == 移動的:05) || ($1 == 移動的:06) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 3) {
				mesg ＶＲ的共通 移動的:07 移動開始
				mesg ＶＲ的共通 移動的:08 移動開始
				mesg ＶＲ的共通 移動的:09 移動開始
				mesg ＶＲ的共通 移動的:10 移動開始

				eval ($$i:的起動フラグ = 0)
			}

		//	ルーム２
		} else if (	($1 == 移動的:07) || ($1 == 移動的:08) || ($1 == 移動的:09) || \
					($1 == 移動的:10) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 4) {
				mesg ＶＲ的共通 移動的:11 移動開始
				mesg ＶＲ的共通 移動的:12 移動開始
				mesg ＶＲ的共通 移動的:13 移動開始
				mesg ＶＲ的共通 移動的:14 移動開始
				mesg ＶＲ的共通 移動的:15 移動開始
				mesg ＶＲ的共通 移動的:16 移動開始
				mesg ＶＲ的共通 移動的:17 移動開始

				eval ($$i:的起動フラグ = 0)
			}

		//	ルーム３
		} else if ( ($1 == 移動的:11) || ($1 == 移動的:12) || ($1 == 移動的:13) || \
					($1 == 移動的:14) || ($1 == 移動的:15) || ($1 == 移動的:16) || \
					($1 == 移動的:17) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 7) {
				mesg ＶＲ的共通 移動的:18 移動開始

				eval ($$i:的起動フラグ = 0)
			}
		} else if ($1 == 移動的:18) {
			mesg ＶＲ的共通 移動的:19 移動開始
			mesg ＶＲ的共通 移動的:20 移動開始

		} else if ( ($1 == 移動的:19) || ($1 == 移動的:20) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 2) {
				mesg ＶＲ的共通 移動的:21 移動開始
				mesg ＶＲ的共通 移動的:22 移動開始
				mesg ＶＲ的共通 移動的:23 移動開始
				mesg ＶＲ的共通 移動的:24 移動開始
				mesg ＶＲ的共通 移動的:25 移動開始
				mesg ＶＲ的共通 移動的:26 移動開始
				mesg ＶＲ的共通 移動的:27 移動開始

				mesg ＶＲ的共通 移動的:28 移動開始
				mesg ＶＲ的共通 移動的:29 移動開始
				mesg ＶＲ的共通 移動的:30 移動開始

				eval ($$i:的起動フラグ = 0)
			}

		}

	}

	//	的配置
	proc ライデン的３面設定 {

	//	@ＶＲ標的基本設定 \
	//	$:p_名前 $:p_的ステータス $:p_ルート $:p_ノード $:p_破壊プロック $:p_初期方向 $:p_自転速度 $:p_的スピード

		//	ルーム１
		@ＶＲ標的基本設定 \
		移動的:01 $$i:的ステータス d:３面的ルート:移部屋１＿０ 1 p:武器訓練ブレード３面ＶＲ標的破壊処理 0 0 $$i:的スピード

		@ＶＲ標的基本設定 \
		移動的:02 $$i:的ステータス d:３面的ルート:移部屋１＿１ 0 p:武器訓練ブレード３面ＶＲ標的破壊処理 0 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:03 $$i:的ステータス d:３面的ルート:移部屋１＿２ 0 p:武器訓練ブレード３面ＶＲ標的破壊処理 0 0 $$i:的スピード

		@ＶＲ標的基本設定 \
		移動的:04 $$i:的ステータス d:３面的ルート:移部屋１＿３ 0 p:武器訓練ブレード３面ＶＲ標的破壊処理 0 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:05 $$i:的ステータス d:３面的ルート:移部屋１＿４ 0 p:武器訓練ブレード３面ＶＲ標的破壊処理 0 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:06 $$i:的ステータス d:３面的ルート:移部屋１＿５ 0 p:武器訓練ブレード３面ＶＲ標的破壊処理 0 0 $$i:的スピード

		@ＶＲ標的基本設定 \
		移動的:07 $$i:的ステータス d:３面的ルート:移部屋１＿６ 0 p:武器訓練ブレード３面ＶＲ標的破壊処理 0 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:08 $$i:的ステータス d:３面的ルート:移部屋１＿７ 0 p:武器訓練ブレード３面ＶＲ標的破壊処理 0 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:09 $$i:的ステータス d:３面的ルート:移部屋１＿８ 0 p:武器訓練ブレード３面ＶＲ標的破壊処理 0 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:10 $$i:的ステータス d:３面的ルート:移部屋１＿９ 0 p:武器訓練ブレード３面ＶＲ標的破壊処理 0 0 $$i:的スピード

		//	ルーム２
		@ＶＲ標的基本設定 \
		移動的:11 $$i:的ステータス d:３面的ルート:移部屋２＿０ 0 p:武器訓練ブレード３面ＶＲ標的破壊処理 0 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:12 $$i:的ステータス d:３面的ルート:移部屋２＿１ 0 p:武器訓練ブレード３面ＶＲ標的破壊処理 0 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:13 $$i:的ステータス d:３面的ルート:移部屋２＿２ 0 p:武器訓練ブレード３面ＶＲ標的破壊処理 0 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:14 $$i:的ステータス d:３面的ルート:移部屋２＿３ 0 p:武器訓練ブレード３面ＶＲ標的破壊処理 0 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:15 $$i:的ステータス d:３面的ルート:移部屋２＿４ 0 p:武器訓練ブレード３面ＶＲ標的破壊処理 0 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:16 $$i:的ステータス d:３面的ルート:移部屋２＿５ 0 p:武器訓練ブレード３面ＶＲ標的破壊処理 0 0 $$i:的スピード
		@ＶＲ標的基本設定 \
