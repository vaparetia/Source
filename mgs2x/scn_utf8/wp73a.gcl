	//	スタート処理
	proc ライデン的４面スタート処理 {
		mesg ＶＲ的共通 移動的:01 移動開始

	}

	//	破壊時処理
	proc ライデン的４面破壊処理 {
		//	ルーム１
		if ($1 == 移動的:01) {
			mesg ＶＲ的共通 移動的:02 移動開始	/*	NG	*/
			mesg ＶＲ的共通 移動的:03 移動開始

		} else if ($1 == 移動的:03) {
			mesg ＶＲ的共通 移動的:04 移動開始
			mesg ＶＲ的共通 移動的:05 移動開始

		} else if ( ($1 == 移動的:04) || ($1 == 移動的:05) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 2) {
				mesg ＶＲ的共通 移動的:06 移動開始
				mesg ＶＲ的共通 移動的:07 移動開始	/*	NG	*/

				eval ($$i:的起動フラグ = 0)
			}

		} else if ($1 == 移動的:06) {
			mesg ＶＲ的共通 移動的:08 移動開始	/*	NG	*/
			mesg ＶＲ的共通 移動的:09 移動開始
			mesg ＶＲ的共通 移動的:10 移動開始	/*	NG	*/

		} else if ($1 == 移動的:09) {
			mesg ＶＲ的共通 移動的:11 移動開始
			mesg ＶＲ的共通 移動的:12 移動開始
			mesg ＶＲ的共通 移動的:13 移動開始	/*	NG	*/
			mesg ＶＲ的共通 移動的:14 移動開始
			mesg ＶＲ的共通 移動的:15 移動開始	/*	NG	*/
			mesg ＶＲ的共通 移動的:16 移動開始	/*	NG	*/
			mesg ＶＲ的共通 移動的:17 移動開始
			mesg ＶＲ的共通 移動的:18 移動開始

		} else if (	($1 == 移動的:11) || ($1 == 移動的:12) || ($1 == 移動的:14) || \
					($1 == 移動的:17) || ($1 == 移動的:18) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 5) {
				mesg ＶＲ的共通 移動的:19 移動開始	/*	NG	*/
				mesg ＶＲ的共通 移動的:20 移動開始	/*	NG	*/
				mesg ＶＲ的共通 移動的:21 移動開始	/*	NG	*/
				mesg ＶＲ的共通 移動的:22 移動開始	/*	NG	*/
				mesg ＶＲ的共通 移動的:23 移動開始

				eval ($$i:的起動フラグ = 0)

			}

		}

	}

