				mesg ＶＲ的共通 移動的:37 移動開始	/*	NG	*/
				mesg ＶＲ的共通 移動的:38 移動開始	/*	NG	*/
				mesg ＶＲ的共通 移動的:39 移動開始	/*	NG	*/

				mesg ＶＲ的共通 移動的:40 移動開始

				eval ($$i:的起動フラグ = 0)
			}

		}

	}

