// ------------------------------------
// マップ設定
// ------------------------------------
chara マップ 武器訓練ブレード３面 -k d:KMS_NAME -h d:HZX_NAME,0 -l $s:ＶＲライトファイル名

command マップ設定 武器訓練ブレード３面 -set {
	// ローカルの初期化
	// ------------------------------------
	@ローカル変数初期化		// ローカルで使用する変数で初期化をする場合はここで

	// ＶＲで必要な基本プロックのセット(vr_common.hで定義)
	// サウンドの基本パック、ＶＲの基本システム、プレイヤー、ゴール等を設定します
	// ※このプロックを使用する時は「ＶＲクリア時処理」というプロックが必要です
	// ＶＲ共通プロックセット	$:スネークファイル $:雷電ファイル
	//							$:ゴールＸ $:ゴールＹ $:ゴールＺ
	//	VR_GOAL_TARGET	/*的全滅でゴールが開く*/
	//	VR_GOAL_FREE	/*ゴールが最初から開いてる*/
	//	VR_GOAL_ENEMY	/*敵全滅でゴールが開く*/
	//	VR_GOAL_SNEAK	/*潜入モード中はゴールが開く*/
	//	VR_GOAL_TIME	/*タイマーがゼロになるとゴールが開く*/
	// ------------------------------------
#ifndef	d:WP74A
	@ＶＲ共通プロックセット sna_wp73a rai_wp73a d:VR_GOAL_TARGET 0 2000 -41000	//	ブレード３面用
#else
	@ＶＲ共通プロックセット sna_wp74a rai_wp74a d:VR_GOAL_TARGET 0 2000 -41000		//	ブレード４面用
#endif

	// カメラ設定
	@カメラセット					// chara カメラとベースのカメラを設定

	// ＶＲウィンドウの設定
	// ------------------------------------
	@武器訓練ブレード３面ＶＲウィンドウ設定

//@ＶＲクリア設定 $:ＮＥＸＴＳＴＡＧＥプロック $:ＴＲＹＡＧＡＩＮプロック $:ＥＸＩＴプロック
#ifndef	d:WP74A
	@ＶＲクリア設定 p:load_wp74a p:A_ＲＥＴＲＹプロック
#else
	@ＶＲクリア設定 p:load_wp75a p:A_ＲＥＴＲＹプロック
#endif

	// ステージに引かれるライン
	// ------------------------------------
	@ＶＲアウトライン d:KMS_NAME d:TONBO_KMS_NAME d:LINE_KMS_NAME

	// 設定値を変更する場合は以下のプロック内で設定
	// ------------------------------------
	@設定値変更				// 敵兵や的のパラメータをステージ限定で変える時はここで
	@プラグイン設定			// プレイヤーのプラグインがいる時はここで

	// 的関係の設定
	// ------------------------------------
#ifndef	d:WP74A
	@武器訓練ブレード３面ＶＲ標的設定				// ＶＲシステム起動後に呼ぶ　ブレード３面用
#else
	@武器訓練ブレード４面ＶＲ標的設定				// ＶＲシステム起動後に呼ぶ　ブレード４面用
#endif

	// ＢＧＭの設定(プレイヤー→敵兵→BGMの順で呼ぶ。的の場合は関係ないがとりあえずここに)
	// ------------------------------------
	@ＢＧＭ設定

	// アイテムの設定
	// ------------------------------------
	@アイテム設定

	// 光源、オブジェクト、カメラ関連の設定
	// ------------------------------------
	@ＶＲフォグ設定 \
		d:VR_FOG:朝Ｎ d:VR_FOG:朝Ｆ d:VR_FOG:夕Ｎ d:VR_FOG:夕Ｆ \
		d:VR_FOG:夜Ｎ 45000	// vr_common.hに定義
//	@フォグテスト							//	暫定処置
	@武器訓練ブレード３面カメラ設定		// ステージ固有のカメラ設定がいる時はこのプロックで
	@ＶＲキャラ用ライト設置					// vr_common.hに定義。必ず最後に設定

#if d:DEBUG_CHARA
//	@デバッグキャラセット
#endif

	@ジャンプ設定

}

//初期マップの表示
command マップ表示 -show 武器訓練ブレード３面


//###################################################################################
//									各proc設定
//###################################################################################



//###################################################################################
//									全マップ共通
//###################################################################################
	// ------------------------------------
	// 全マップ共通
	// ------------------------------------
	// ------------------------------------
	// クリア時の処理
	// ------------------------------------
	proc ＶＲクリア時処理 {
		#if d:DEBUG_PRINT
			print 'clear'
		#endif

#ifdef	d:WP74A
		//	ＮＧ的を消す
		@武器訓練ブレード４面ＶＲ標的ゴール処理
#endif

		// 強制モーションを発動
		@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_1 2048

		// クリア時にカメラアングルを変える
		chara カメラ設定 カットインカメラ \
			-c 1 \
			-p 354,3424,-44625 -t 354,3123,-40561 \
			-r -41,0,0 -f 4690 \
			-a 200 \
			-i 1 1 0 0 \
			-s 1

	}



	// ------------------------------------
	// パラメータ系の変更
	// ------------------------------------
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT
			print 'localvar_init'
		#endif

		//	的フラグを初期化する
		eval ($$i:的起動フラグ = 0)

		//	的ステータスを初期化する
		eval ($$i:的基本ステータス = 0);
		eval ($$i:的ステータス = 0)

		//	的スピードを初期化する
		eval ($$i:的スピード = 0)

		//	的セット数を初期化する
		eval ($$b:的セット数 = 0);

		//	ＮＧ的点滅周期を初期化する
		eval ($$i:点き周期 = 0);
		eval ($$i:消え周期 = 0);

	}
	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT
			print 'status_set'
		#endif

		// 初期装備の設定
		/*	@ＶＲ共通プロックセット内で設定	*/

	}
	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif

		/*	@ＶＲ共通プロックセット内で設定	*/

	}



//###################################################################################
//									 総合　的設定
//###################################################################################

//////////////////////////
//	基本的プロック
//////////////////////////

	// 移動的プロック
	// ------------------------------------
	proc ＶＲ標的基本設定 \
	$:p_名前 $:p_的ステータス $:p_ルート $:p_ノード $:p_破壊プロック $:p_初期方向 $:p_自転速度 $:p_的スピード {

		//	点滅用処理
		@点滅割り振り設定 $:p_名前

		//	プリスキンかタキシードスネークのＮＧ的は点滅周期が違う
		if( ($s:選択プレイヤー == プリスキン) || \
			($s:選択プレイヤー == タキシードスネーク) && \
			($:p_的ステータス & d:VR_TRG_NG) ) {
			chara	ＶＲ移動的 $:p_名前 \
				-flag ($$i:的基本ステータス | $:p_的ステータス) \
				-route $:p_ルート $:p_ノード \
				-c $:p_破壊プロック \
				-dir $:p_初期方向 $:p_自転速度 \
				-v $$i:点き周期 $$i:消え周期 \
				-speed $:p_的スピード

		//	それ以外は
		} else {
			chara	ＶＲ移動的 $:p_名前 \
				-flag ($$i:的基本ステータス | $:p_的ステータス) \
				-route $:p_ルート $:p_ノード \
				-c $:p_破壊プロック \
				-dir $:p_初期方向 $:p_自転速度 \
			-speed $:p_的スピード
		}

	}

	proc ＶＲ標的基本設定（ルートプロックつき） \
	$:p_名前 $:p_的ステータス $:p_ルート $:p_ノード $:p_破壊プロック \
	$:p_ルートプロック１ $:p_ルート１ $:p_ノード１ $:p_ルートプロック２ $:p_ルート２ $:p_ノード２ \
	$:p_初期方向 $:p_自転速度 $:p_的スピード {

		//	点滅用処理
		@点滅割り振り設定 $:p_名前

		//	プリスキンかタキシードスネークのＮＧ的は点滅周期が違う
		if( ($s:選択プレイヤー == プリスキン) || \
			($s:選択プレイヤー == タキシードスネーク) && \
			($:p_的ステータス & d:VR_TRG_NG) ) {
			chara	ＶＲ移動的 $:p_名前 \
				-flag ($$i:的基本ステータス | $:p_的ステータス) \
				-route $:p_ルート $:p_ノード \
				-c $:p_破壊プロック \
				-x	$:p_ルートプロック１ $:p_ルート１ $:p_ノード１ \
					$:p_ルートプロック２ $:p_ルート２ $:p_ノード２ \
				-dir $:p_初期方向 $:p_自転速度 \
				-v $$i:点き周期 $$i:消え周期 \
				-speed $:p_的スピード

		//	それ以外は
		} else {
			chara	ＶＲ移動的 $:p_名前 \
				-flag ($$i:的基本ステータス | $:p_的ステータス) \
				-route $:p_ルート $:p_ノード \
				-c $:p_破壊プロック \
				-x	$:p_ルートプロック１ $:p_ルート１ $:p_ノード１ \
					$:p_ルートプロック２ $:p_ルート２ $:p_ノード２ \
				-dir $:p_初期方向 $:p_自転速度 \
				-speed $:p_的スピード
		}

	}

	proc ＶＲ標的基本設定（シフトつき） \
	$:p_名前 $:p_的ステータス $:p_ルート $:p_ノード $:p_破壊プロック $:p_シフトＸ $:p_シフトＹ $:p_シフトＺ $:p_初期方向 $:p_自転速度 $:p_的スピード {

		//	点滅用処理
		@点滅割り振り設定 $:p_名前

		//	プリスキンかタキシードスネークのＮＧ的は点滅周期が違う
		if( ($s:選択プレイヤー == プリスキン) || \
			($s:選択プレイヤー == タキシードスネーク) && \
			($:p_的ステータス & d:VR_TRG_NG) ) {
			chara	ＶＲ移動的 $:p_名前 \
				-flag ($$i:的基本ステータス | $:p_的ステータス | d:VR_TRG_ABSSHIFT) \	//	絶対座標シフト
				-route $:p_ルート $:p_ノード \
				-c $:p_破壊プロック \
				-yshift $:p_シフトＸ $:p_シフトＹ $:p_シフトＺ \
				-dir $:p_初期方向 $:p_自転速度 \
				-v $$i:点き周期 $$i:消え周期 \
				-speed $:p_的スピード

		//	それ以外は
		} else {
			chara	ＶＲ移動的 $:p_名前 \
				-flag ($$i:的基本ステータス | $:p_的ステータス | d:VR_TRG_ABSSHIFT) \	//	絶対座標シフト
				-route $:p_ルート $:p_ノード \
				-c $:p_破壊プロック \
				-yshift $:p_シフトＸ $:p_シフトＹ $:p_シフトＺ \
				-dir $:p_初期方向 $:p_自転速度 \
				-speed $:p_的スピード
		}

	}

//////////////////////////
//	点滅割り振り設定
//////////////////////////
	proc 点滅割り振り設定 $:p_名前 {
		//	プリスキンかタキシードスネークは、点滅する
		if( ($s:選択プレイヤー == プリスキン) || \
			($s:選択プレイヤー == タキシードスネーク) ) {
			//	的セット数をカウントする
			$$b:的セット数 = $$b:的セット数 + 1;

//	ブレード３面
#ifndef d:WP74A
			@ブレード３面点滅割り振り設定 $:p_名前

//	ブレード４面
#else
			@ブレード４面点滅割り振り設定 $:p_名前
#endif
		//	そのほかのキャラは点滅しない
		} else {
			eval ($$i:的基本ステータス = $$i:的基本ステータス)
		}

	}

	//	基本点滅割り振り設定
	proc 基本点滅割り振り設定 {
		//	奇数ならば（＝的セット数が割り切れなければ）、消え状態からスタート
		if( $$b:的セット数 % 2 ) {
			eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)

		//	偶数ならば（＝的セット数が割り切れれば）、点き状態からスタート
		} else {
			eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
		}
	}
	

	//	ブレード３面例外的措置
	proc ブレード３面点滅割り振り設定 $:p_名前 {
		//	ＮＧ的点滅周期（念のため）
		$$i:点き周期 = 120;
		$$i:消え周期 = 120;

		//	プリスキンの場合
		if ($s:選択プレイヤー == プリスキン) {
			if ($:p_名前 == 移動的:01) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			} else if ($:p_名前 == 移動的:02) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ($:p_名前 == 移動的:03) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			} else if ($:p_名前 == 移動的:04) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ( ($:p_名前 == 移動的:05) || ($:p_名前 == 移動的:06) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)

			} else if ($:p_名前 == 移動的:13) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			} else if ( ($:p_名前 == 移動的:13) || ($:p_名前 == 移動的:22) || \
						($:p_名前 == 移動的:23) || ($:p_名前 == 移動的:26) || \
						($:p_名前 == 移動的:27) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ( ($:p_名前 == 移動的:20) || ($:p_名前 == 移動的:21) || \
						($:p_名前 == 移動的:24) || ($:p_名前 == 移動的:25) || \
						($:p_名前 == 移動的:28) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)

			//	それ以外の的は
			} else {
				@基本点滅割り振り設定
			}

		//	タキシードの場合
		} else {
			if ($:p_名前 == 移動的:01) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			} else if ( ($:p_名前 == 移動的:06) || ($:p_名前 == 移動的:07) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ( ($:p_名前 == 移動的:08) || ($:p_名前 == 移動的:09) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			} else if ($:p_名前 == 移動的:10) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ($:p_名前 == 移動的:11) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ($:p_名前 == 移動的:12) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ($:p_名前 == 移動的:13) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			
			} else if ($:p_名前 == 移動的:14) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ($:p_名前 == 移動的:15) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ( ($:p_名前 == 移動的:16) || ($:p_名前 == 移動的:17) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ( ($:p_名前 == 移動的:18) || ($:p_名前 == 移動的:20) || \
						($:p_名前 == 移動的:21) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ( ($:p_名前 == 移動的:19) || ($:p_名前 == 移動的:22) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			} else if ( ($:p_名前 == 移動的:27) || ($:p_名前 == 移動的:25) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ( ($:p_名前 == 移動的:23) || ($:p_名前 == 移動的:29) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ( ($:p_名前 == 移動的:28) || ($:p_名前 == 移動的:26) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ( ($:p_名前 == 移動的:24) || ($:p_名前 == 移動的:30) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			//	それ以外の的は
			} else {
				@基本点滅割り振り設定
			}
		}
	}

	//	ブレード４面例外的措置
	proc ブレード４面点滅割り振り設定 $:p_名前 {
		//	ＮＧ的点滅周期
		$$i:点き周期 = 120;
		$$i:消え周期 = 120;

		//	プリスキンの場合
		if ($s:選択プレイヤー == プリスキン) {
			if ($:p_名前 == 移動的:10) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			} else if ($:p_名前 == 移動的:16) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			} else if ($:p_名前 == 移動的:21) {
					eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)

			} else if ($:p_名前 == 移動的:22) {
					eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			//	それ以外の的は
			} else {
				//	奇数ならば（＝的セット数が割り切れなければ）、点き状態からスタート
				if( $$b:的セット数 % 2 ) {
					eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

				//	偶数ならば（＝的セット数が割り切れれば）、消え状態からスタート
				} else {
					eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
				}
			}

			//	以下のＮＧ的は例外周期で点滅する
			if ( ($$b:的セット数 >= 20) && ($$b:的セット数 <= 23) ) {
				//	ＮＧ的点滅周期
				$$i:点き周期 = 60;
				$$i:消え周期 = 120;
			}
		
		//	タキシードの場合
		} else {
			if ($:p_名前 == 移動的:01) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			} else if ( ($:p_名前 == 移動的:06) || ($:p_名前 == 移動的:07) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ( ($:p_名前 == 移動的:08) || ($:p_名前 == 移動的:09) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			} else if ($:p_名前 == 移動的:10) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ($:p_名前 == 移動的:11) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ($:p_名前 == 移動的:12) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ($:p_名前 == 移動的:13) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)

			} else if ($:p_名前 == 移動的:15) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ( ($:p_名前 == 移動的:17) || ($:p_名前 == 移動的:18) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ( ($:p_名前 == 移動的:19) || ($:p_名前 == 移動的:20) || \
						($:p_名前 == 移動的:21) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)

			} else if ($:p_名前 == 移動的:22) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ( ($:p_名前 == 移動的:23) || ($:p_名前 == 移動的:24) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ( ($:p_名前 == 移動的:25) || ($:p_名前 == 移動的:26) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ( ($:p_名前 == 移動的:27) || ($:p_名前 == 移動的:28) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ($:p_名前 == 移動的:29) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			//	それ以外の的は
			} else {
				@基本点滅割り振り設定
			}

			//	以下のＮＧ的は例外周期で点滅する
			if ( ($$b:的セット数 >= 22) && ($$b:的セット数 <= 29) ) {
			print '#################NG_EXCEPTION'$:p_名前
				//	ＮＧ的点滅周期
				$$i:点き周期 = 60;
				$$i:消え周期 = 120;
			}

		}
	}


//////////////////////////
//	ブレード３面用
//////////////////////////

	//	スタート処理
	// ------------------------------------
	proc 武器訓練ブレード３面ＶＲ標的スタート処理 {
		//	ライデンを選択
		if ($s:選択プレイヤー == ライデン) {
			@ライデン的３面スタート処理

		//	スネークを選択
		} else if ($s:選択プレイヤー == スネーク) {
			@スネーク的３面スタート処理

		//	プリスキンを選択
		} else if ($s:選択プレイヤー == プリスキン) {
			@プリスキン的３面スタート処理

		//	タキシードスネークを選択（スネークとコンパチ）
		} else if ($s:選択プレイヤー == タキシードスネーク) {
			@スネーク的３面スタート処理

		//	前作スネークを選択
		} else if ($s:選択プレイヤー == 前作スネーク) {
			@前作スネーク的３面スタート処理

		//	忍者を選択
		} else if ($s:選択プレイヤー == 刀ライデン) {
			@忍者的３面スタート処理
		}

	}

	// 破壊時処理
	// ------------------------------------
	proc 武器訓練ブレード３面ＶＲ標的破壊処理 {
		//	ライデンを選択
		if ($s:選択プレイヤー == ライデン) {
			@ライデン的３面破壊処理 $1

		//	スネークを選択
		} else if ($s:選択プレイヤー == スネーク) {
			@スネーク的３面破壊処理 $1

		//	プリスキンを選択
		} else if ($s:選択プレイヤー == プリスキン) {
			@プリスキン的３面破壊処理 $1

		//	タキシードスネークを選択（スネークとコンパチ）
		} else if ($s:選択プレイヤー == タキシードスネーク) {
			@スネーク的３面破壊処理 $1

		//	前作スネークを選択
		} else if ($s:選択プレイヤー == 前作スネーク) {
			@前作スネーク的３面破壊処理 $1

		//	忍者を選択
		} else if ($s:選択プレイヤー == 刀ライデン) {
			@忍者的３面破壊処理 $1
		}

	}

	// 的配置
	// ------------------------------------
	proc 武器訓練ブレード３面ＶＲ標的設定 {
		eval ($$i:的ステータス = ($$i:的ステータス | d:VR_TRG_KATANA | d:VR_TRG_WAIT | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST) )

		//	ライデンを選択
		if ($s:選択プレイヤー == ライデン) {
			eval ($$i:的スピード = 50)
			@ライデン的３面設定

		//	スネークを選択
		} else if ($s:選択プレイヤー == スネーク) {
			eval ($$i:的スピード = 30)
			@スネーク的３面設定

		//	プリスキンを選択
		} else if ($s:選択プレイヤー == プリスキン) {
			eval ($$i:的スピード = 50)
			@プリスキン的３面設定

		//	タキシードスネークを選択（スネークとコンパチ）
		} else if ($s:選択プレイヤー == タキシードスネーク) {
			eval ($$i:的スピード = 30)
			@スネーク的３面設定

		//	前作スネークを選択
		} else if ($s:選択プレイヤー == 前作スネーク) {
			eval ($$i:的スピード = 30)
			@前作スネーク的３面設定

		//	忍者を選択
		} else if ($s:選択プレイヤー == 刀ライデン) {
			eval ($$i:的スピード = 50)
			@忍者的３面設定
		}

	}



