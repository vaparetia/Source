	//	スタート処理
	proc 忍者的４面スタート処理 {
		mesg ＶＲ的共通 移動的:01 移動開始
		mesg ＶＲ的共通 移動的:02 移動開始

	}

	//	破壊時処理
	proc 忍者的４面破壊処理 {
		//	ルーム１
		if ( ($1 == 移動的:01)|| ($1 == 移動的:02) )  {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 2) {
				mesg ＶＲ的共通 移動的:03 移動開始
				mesg ＶＲ的共通 移動的:04 移動開始
				mesg ＶＲ的共通 移動的:05 移動開始	/*	NG	*/

				eval ($$i:的起動フラグ = 0)
			}

		} else if ( ($1 == 移動的:03) || ($1 == 移動的:04) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 2) {
				mesg ＶＲ的共通 移動的:06 移動開始	/*	NG	*/
				mesg ＶＲ的共通 移動的:07 移動開始
				mesg ＶＲ的共通 移動的:08 移動開始

				eval ($$i:的起動フラグ = 0)
			}

		} else if ( ($1 == 移動的:07) || ($1 == 移動的:08) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 2) {
				mesg ＶＲ的共通 移動的:09 移動開始
				mesg ＶＲ的共通 移動的:10 移動開始	/*	NG	*/
				mesg ＶＲ的共通 移動的:11 移動開始

				eval ($$i:的起動フラグ = 0)
			}

		} else if ( ($1 == 移動的:09) || ($1 == 移動的:11) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 2) {
				mesg ＶＲ的共通 移動的:12 移動開始	/*	NG	*/
				mesg ＶＲ的共通 移動的:13 移動開始
				mesg ＶＲ的共通 移動的:14 移動開始	/*	NG	*/

				mesg ＶＲ的共通 移動的:15 移動開始	/*	NG	*/
				mesg ＶＲ的共通 移動的:16 移動開始
				mesg ＶＲ的共通 移動的:17 移動開始	/*	NG	*/

				eval ($$i:的起動フラグ = 0)
			}

		} else if ( ($1 == 移動的:13) || ($1 == 移動的:16) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 2) {
				mesg ＶＲ的共通 移動的:18 移動開始

				mesg ＶＲ的共通 移動的:19 移動開始	/*	NG	*/
				mesg ＶＲ的共通 移動的:20 移動開始

				mesg ＶＲ的共通 移動的:21 移動開始
				mesg ＶＲ的共通 移動的:22 移動開始	/*	NG	*/

				mesg ＶＲ的共通 移動的:23 移動開始
				mesg ＶＲ的共通 移動的:24 移動開始	/*	NG	*/
				mesg ＶＲ的共通 移動的:25 移動開始

				mesg ＶＲ的共通 移動的:26 移動開始
				mesg ＶＲ的共通 移動的:27 移動開始

				mesg ＶＲ的共通 移動的:28 移動開始	/*	NG	*/
				mesg ＶＲ的共通 移動的:29 移動開始

				mesg ＶＲ的共通 移動的:30 移動開始	/*	NG	*/
				mesg ＶＲ的共通 移動的:31 移動開始

				eval ($$i:的起動フラグ = 0)
			}

		} else if ( ($1 == 移動的:18) || ($1 == 移動的:20) || ($1 == 移動的:21) || \
					($1 == 移動的:23) || ($1 == 移動的:25) || ($1 == 移動的:26) || \
					($1 == 移動的:27) || ($1 == 移動的:29) || ($1 == 移動的:31) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 9) {
				mesg ＶＲ的共通 移動的:32 移動開始	/*	NG	*/
				mesg ＶＲ的共通 移動的:33 移動開始	/*	NG	*/
				mesg ＶＲ的共通 移動的:34 移動開始	/*	NG	*/
				mesg ＶＲ的共通 移動的:35 移動開始	/*	NG	*/

