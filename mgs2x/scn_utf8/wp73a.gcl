//////////////////////////

	//	スタート処理
	proc 前作スネーク的４面スタート処理 {
		mesg ＶＲ的共通 移動的:01 移動開始
		mesg ＶＲ的共通 移動的:02 移動開始
		mesg ＶＲ的共通 移動的:03 移動開始

	}

	//	破壊時処理
	proc 前作スネーク的４面破壊処理 {
		if ($1 == 移動的:02) {
			mesg ＶＲ的共通 移動的:04 移動開始	/*	NG	*/
			mesg ＶＲ的共通 移動的:05 移動開始

		} else if ($1 == 移動的:05) {
			mesg ＶＲ的共通 移動的:06 移動開始
			mesg ＶＲ的共通 移動的:07 移動開始
			mesg ＶＲ的共通 移動的:08 移動開始
			mesg ＶＲ的共通 移動的:09 移動開始	/*	NG	*/
			mesg ＶＲ的共通 移動的:10 移動開始	/*	NG	*/
			mesg ＶＲ的共通 移動的:11 移動開始	/*	NG	*/
			
		} else if ( ($1 == 移動的:06) || ($1 == 移動的:07) || ($1 == 移動的:08) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 3) {
				mesg ＶＲ的共通 移動的:12 移動開始	/*	NG	*/
				mesg ＶＲ的共通 移動的:13 移動開始	/*	NG	*/
				mesg ＶＲ的共通 移動的:14 移動開始
				mesg ＶＲ的共通 移動的:15 移動開始

				eval ($$i:的起動フラグ = 0)
			}

		} else if ( ($1 == 移動的:14) || ($1 == 移動的:15) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 2) {
				mesg ＶＲ的共通 移動的:16 移動開始
				mesg ＶＲ的共通 移動的:17 移動開始
				mesg ＶＲ的共通 移動的:18 移動開始	/*	NG	*/
				mesg ＶＲ的共通 移動的:19 移動開始	/*	NG	*/
				mesg ＶＲ的共通 移動的:20 移動開始
				mesg ＶＲ的共通 移動的:21 移動開始
				mesg ＶＲ的共通 移動的:22 移動開始

				eval ($$i:的起動フラグ = 0)
			}

		} else if (	($1 == 移動的:16) || ($1 == 移動的:17) || ($1 == 移動的:20) || \
					($1 == 移動的:21) || ($1 == 移動的:22) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 5) {
				mesg ＶＲ的共通 移動的:23 移動開始
				mesg ＶＲ的共通 移動的:24 移動開始
				mesg ＶＲ的共通 移動的:25 移動開始
				mesg ＶＲ的共通 移動的:26 移動開始
				mesg ＶＲ的共通 移動的:27 移動開始
				mesg ＶＲ的共通 移動的:28 移動開始
				mesg ＶＲ的共通 移動的:29 移動開始
				mesg ＶＲ的共通 移動的:30 移動開始
				mesg ＶＲ的共通 移動的:31 移動開始
				mesg ＶＲ的共通 移動的:32 移動開始
				mesg ＶＲ的共通 移動的:33 移動開始	/*	NG	*/

				eval ($$i:的起動フラグ = 0)
			}

		}

	}

	//	ゴール処理
	proc 前作スネーク的４面ゴール処理 {
		//	ＮＧ的を消す
		mesg ＶＲ的共通 移動的:04 消滅

		mesg ＶＲ的共通 移動的:09 消滅
