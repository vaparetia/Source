	//	的配置
	proc 忍者的４面設定 {

	//	@ＶＲ標的基本設定 \
	//	$:p_名前 $:p_的ステータス $:p_ルート $:p_ノード $:p_破壊プロック $:p_初期方向 $:p_自転速度 $:p_的スピード

		//	ルーム１
		@ＶＲ標的基本設定 \
		移動的:01 $$i:的ステータス d:４面的ルート:移部屋１＿忍０ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 0 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:02 $$i:的ステータス d:４面的ルート:移部屋１＿忍１ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 0 0 $$i:的スピード

		@ＶＲ標的基本設定 \
		移動的:03 $$i:的ステータス d:４面的ルート:移部屋１＿忍２ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 0 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:04 $$i:的ステータス d:４面的ルート:移部屋１＿忍３ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 0 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:05 ($$i:的ステータス | d:VR_TRG_NG) d:４面的ルート:移部屋１＿忍４ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 0 0 $$i:的スピード

		@ＶＲ標的基本設定 \
		移動的:06 ($$i:的ステータス | d:VR_TRG_NG) d:４面的ルート:移部屋１＿忍５ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 0 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:07 $$i:的ステータス d:４面的ルート:移部屋１＿忍６ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 0 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:08 $$i:的ステータス d:４面的ルート:移部屋１＿忍７ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 0 0 $$i:的スピード

		@ＶＲ標的基本設定 \
		移動的:09 $$i:的ステータス d:４面的ルート:移部屋１＿忍８ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 0 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:10 ($$i:的ステータス | d:VR_TRG_NG) d:４面的ルート:移部屋１＿忍９ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 0 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:11 $$i:的ステータス d:４面的ルート:移部屋１＿忍１０ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 0 0 $$i:的スピード

		@ＶＲ標的基本設定 \
		移動的:12 ($$i:的ステータス | d:VR_TRG_NG) d:４面的ルート:移部屋１＿忍１１ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 1024 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:13 $$i:的ステータス d:４面的ルート:移部屋１＿忍１２ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 1024 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:14 ($$i:的ステータス | d:VR_TRG_NG) d:４面的ルート:移部屋１＿忍１３ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 1024 0 $$i:的スピード

		@ＶＲ標的基本設定 \
		移動的:15 ($$i:的ステータス | d:VR_TRG_NG) d:４面的ルート:移部屋１＿忍１４ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 1024 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:16 $$i:的ステータス d:４面的ルート:移部屋１＿忍１５ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 1024 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:17 ($$i:的ステータス | d:VR_TRG_NG) d:４面的ルート:移部屋１＿忍１６ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 1024 0 $$i:的スピード

		//	ルーム２
		@ＶＲ標的基本設定 \
		移動的:18 $$i:的ステータス d:４面的ルート:移部屋２＿忍０ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 0 0 $$i:的スピード

		@ＶＲ標的基本設定 \
		移動的:19 ($$i:的ステータス | d:VR_TRG_NG) d:４面的ルート:移部屋２＿忍２ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 0 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:20 $$i:的ステータス d:４面的ルート:移部屋２＿忍３ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 0 0 $$i:的スピード

		@ＶＲ標的基本設定 \
		移動的:21 $$i:的ステータス d:４面的ルート:移部屋２＿忍４ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 0 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:22 ($$i:的ステータス | d:VR_TRG_NG) d:４面的ルート:移部屋２＿忍５ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 0 0 $$i:的スピード

		@ＶＲ標的基本設定 \
		移動的:23 $$i:的ステータス d:４面的ルート:移部屋２＿忍６ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 0 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:24 ($$i:的ステータス | d:VR_TRG_NG) d:４面的ルート:移部屋２＿忍７ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 0 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:25 $$i:的ステータス d:４面的ルート:移部屋２＿忍８ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 0 0 $$i:的スピード

		@ＶＲ標的基本設定 \
		移動的:26 $$i:的ステータス d:４面的ルート:移部屋２＿忍９ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 0 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:27 $$i:的ステータス d:４面的ルート:移部屋２＿忍１０ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 0 0 $$i:的スピード

		@ＶＲ標的基本設定 \
		移動的:28 ($$i:的ステータス | d:VR_TRG_NG) d:４面的ルート:移部屋２＿忍１１ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 0 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:29 $$i:的ステータス d:４面的ルート:移部屋２＿忍１２ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 0 0 $$i:的スピード

		@ＶＲ標的基本設定 \
		移動的:30 ($$i:的ステータス | d:VR_TRG_NG) d:４面的ルート:移部屋２＿忍１３ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 0 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:31 $$i:的ステータス d:４面的ルート:移部屋２＿忍１４ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 0 0 $$i:的スピード

		//	ルーム３
		@ＶＲ標的基本設定 \
		移動的:32 ($$i:的ステータス | d:VR_TRG_NG) d:４面的ルート:移部屋３＿忍２０ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 1024 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:33 ($$i:的ステータス | d:VR_TRG_NG) d:４面的ルート:移部屋３＿忍２１ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 1024 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:34 ($$i:的ステータス | d:VR_TRG_NG) d:４面的ルート:移部屋３＿忍２２ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 1024 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:35 ($$i:的ステータス | d:VR_TRG_NG) d:４面的ルート:移部屋３＿忍２３ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 1024 0 $$i:的スピード

		@ＶＲ標的基本設定 \
		移動的:36 ($$i:的ステータス | d:VR_TRG_NG) d:４面的ルート:移部屋３＿忍２４ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 1024 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:37 ($$i:的ステータス | d:VR_TRG_NG) d:４面的ルート:移部屋３＿忍２５ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 1024 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:38 ($$i:的ステータス | d:VR_TRG_NG) d:４面的ルート:移部屋３＿忍２６ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 1024 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:39 ($$i:的ステータス | d:VR_TRG_NG) d:４面的ルート:移部屋３＿忍２７ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 1024 0 $$i:的スピード

		@ＶＲ標的基本設定 \
		移動的:40 $$i:的ステータス d:４面的ルート:移部屋３＿忍２８ 0 p:武器訓練ブレード４面ＶＲ標的破壊処理 0 0 $$i:的スピード

	}



