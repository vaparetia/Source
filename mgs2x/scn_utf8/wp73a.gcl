	// ------------------------------------
	// ＢＧＭの設定
	// ------------------------------------
	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT
			print 'bgm_set'
		#endif

		chara ＢＧＭマネージャー ＢＧＭマネ
	}


//###################################################################################
//									 アイテム
//###################################################################################

	// ------------------------------------
	// アイテムの設定
	// ------------------------------------
	// 再発生が必要な時は以下のプロックの中を記述する
	// ------------------------------------
	proc アイテム取得時番号設定 $:ボックス名 {
		#if d:DEBUG_PRINT
			print 'item_no_set'
		#endif
	}
	// アイテムの設置
	// ------------------------------------
	proc アイテム設定 {
		#if d:DEBUG_PRINT
			print 'item_set'
		#endif
	}



//###################################################################################
//									 エフェクト
//###################################################################################

	proc フォグテスト {
		#if d:DEBUG_PRINT
			print 'fog_set'
		#endif

		if ( $b:ＶＲ起動時間帯 == d:VR_TIME:朝 ) {
			chara フォグ 霧 \
				-c 45, 48, 52 \
				-n 0 \
				-f 50000
		} else if ( $b:ＶＲ起動時間帯 == d:VR_TIME:夕方 ) {
			chara フォグ 霧 \
				-c 139, 100, 52 \
				-n -3000 \
				-f 40000
		} else if ( $b:ＶＲ起動時間帯 == d:VR_TIME:夜 ) {
			chara フォグ 霧 \
				-c 20, 30, 35 \
				-n -500 \
				-f 18000

		} else {
			chara フォグ 霧 \
				-c 45, 48, 52 \
				-n 0 \
				-f 50000
		}

	}

//###################################################################################
//									 カメラ
//###################################################################################
	// ------------------------------------
	// カメラ関係の設定
	// ------------------------------------
	// ステージカメラ設定
	// ------------------------------------
	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'chara_camera & stage_camera_set'
		#endif

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0
		chara カメラ メインカメラ		-c 0 -l 2 -p 40
		chara カメラ サブカメラ			-c 0 -l 2 -p 30
		chara カメラ カットインカメラ	-c 0 -l 0 -p 0

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 350,2048,0 \
			-f 11000 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}
	// ステージ固有のカメラ設定
	// ------------------------------------
	proc 武器訓練ブレード３面カメラ設定 {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif

		//---------------------
		// 通常のステージカメラ
		//---------------------
		trap ca001 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 メインカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 350,2048,0 \
					-f 11000 \
					-a 200 \
					-i 2 2 0 0 \
					-s $3
			}

		//	ルーム１階段
		trap ca002 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				//	１ｍ以下、またはローリング中以外は
				if ( ($5 < 1000) || !(`command プレイヤー状態取得` & d:PFLAG_ROLLING) ) {
					chara カメラ設定 サブカメラ \
						-c 0 \
						-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
						-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
						-r 600,2048,0 \
						-f 11000 \
						-a 200 \
						-i 2 2 0 0 \
						-s $3
				//	１ｍ以上でローリングした場合は何もしない
				} else {
					chara カメラ設定 サブカメラ \
						-s 0
				}
			}

		//	ルーム２階段
		trap ca003 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				//	１ｍ以下、またはローリング中以外は
				if ( ($5 < 1000) || !(`command プレイヤー状態取得` & d:PFLAG_ROLLING) ) {
					chara カメラ設定 サブカメラ \
						-c 0 \
						-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
						-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
						-r 600,2048,0 \
						-f 11000 \
						-a 200 \
						-i 2 2 0 0 \
						-s $3
				//	１ｍ以上でローリングした場合は何もしない
				} else {
					chara カメラ設定 サブカメラ \
						-s 0
				}
			}

		//	ルーム２手前オブジェクト裏
		trap ca004 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				//	１ｍ以下、またはローリング中以外は
				if ( ($5 < 1000) || !(`command プレイヤー状態取得` & d:PFLAG_ROLLING) ) {
					chara カメラ設定 サブカメラ \
						-c 0 \
						-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
						-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
						-r 600,2048,0 \
						-f 11000 \
						-a 200 \
						-i 2 2 0 0 \
						-s $3
				//	１ｍ以上でローリングした場合は何もしない
				} else {
					chara カメラ設定 サブカメラ \
						-s 0
				}
			}

		//	ルーム２奥オブジェクト裏
		trap ca005 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				//	１ｍ以上でローリングした場合は何もしない
				if ( ($5 < 1000) || !(`command プレイヤー状態取得` & d:PFLAG_ROLLING) ) {
					chara カメラ設定 サブカメラ \
						-c 0 \
						-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
						-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
						-r 800,2048,0 \
						-f 11000 \
						-a 200 \
						-i 2 2 0 0 \
						-s $3
				//	１ｍ以上でローリングした場合は何もしない
				} else {
					chara カメラ設定 サブカメラ \
						-s 0
				}
			}

	}



//###################################################################################
//									ＶＲウィンドウの設定と表示
//###################################################################################

	//------------------------------------------------------------
	// ＶＲウィンドウの設定と表示
	//------------------------------------------------------------
	proc 武器訓練ブレード３面ＶＲウィンドウ設定 {
	#if d:DEBUG_PRINT
		print 'vr_window_set-weapon blade LEVEL 3/4'
	#endif

		//	ＶＲウィンドウの設定。各言語のリソースと終了プロックが引数
		//	リソースはvr_window_j.h等で定義(a_stdproc.hでinclude済み)
		//	プロック名を引数にする場合は先頭にp:をつけること！
	
#ifndef	d:WP74A
		@ＶＲウィンドウ設定	\		//	ブレード３面用
			[VRMSG_J:VRM_WPN_HFB_wp73a] [VRMSG_E:VRM_WPN_HFB_wp73a] [VRMSG_G:VRM_WPN_HFB_wp73a] \	//	日、英、独
			[VRMSG_F:VRM_WPN_HFB_wp73a] [VRMSG_I:VRM_WPN_HFB_wp73a] [VRMSG_S:VRM_WPN_HFB_wp73a] \	//	仏、伊、西
			[VRMSG_K:VRM_WPN_HFB_wp73a] \												//	韓
			p:武器訓練ブレード３面ステージ開始時処理								//	終了プロック
#else
		@ＶＲウィンドウ設定	\		//	ブレード４面用
			[VRMSG_J:VRM_WPN_HFB_wp74a] [VRMSG_E:VRM_WPN_HFB_wp74a] [VRMSG_G:VRM_WPN_HFB_wp74a] \	//	日、英、独
			[VRMSG_F:VRM_WPN_HFB_wp74a] [VRMSG_I:VRM_WPN_HFB_wp74a] [VRMSG_S:VRM_WPN_HFB_wp74a] \	//	仏、伊、西
			[VRMSG_K:VRM_WPN_HFB_wp74a] \												//	韓
			p:武器訓練ブレード３面ステージ開始時処理								//	終了プロック
#endif

		//	ＶＲウィンドウを表示する(名前はＶＲウィンドウ君で固定)
		mesg ＶＲウィンドウ ＶＲウィンドウ君 開く

		//	スタート時とクリア時に使用するカットインカメラ
		//	自分でカメラを定義する際にはなるべくロード時に起動する
		chara カメラ設定 カットインカメラ \
			-c 1 \
			-p 410,6842,-32002 -t 410,1216,-41454 \
			-r 350,2048,0 -f 10999 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1
	}


	//------------------------------------------------------------
	// ステージ開始時処理(ＶＲウィンドウが閉じた後行う処理)
	//------------------------------------------------------------
	proc 武器訓練ブレード３面ステージ開始時処理 {
	#if d:DEBUG_PRINT
		print 'game_start!!!!!'
	#endif

		//	プレイヤーやパッドの制御等を行う a_stdproc.hで定義
		@全ミッション共通ステージ開始時処理

		//	カメラワークスタート(必要な場合)
		//	全体図（補間のフレーム数は全て統一するためdefineで固定）
		chara カメラ設定 カットインカメラ \
			-c 1 \
			-p 847,14665,-10168 -t 847,5056,-15515 \
			-r 693,2048,0 -f 10997 \
			-a 200 \
			-i 4 4 d:START_CAMERA_CHANGE_TIME d:START_CAMERA_CHANGE_TIME \
			-s 1

		chara delay ディレイ \
			-time d:START_CAMERA_CHANGE_TIME \
			-exec {
				//	カメラの補間が終わった直後にステージカメラへ移行する
				chara カメラ設定 カットインカメラ -s -1
			}

	}


	proc ゲーム開始直後処理 {
	#if d:DEBUG_PRINT
		print '##########################################################'
	#endif
		//	的をスタートさせる
#ifndef	d:WP74A
		@武器訓練ブレード３面ＶＲ標的スタート処理		//	ブレード３面用
#else
		@武器訓練ブレード４面ＶＲ標的スタート処理		//	ブレード４面用
#endif
	}


//###################################################################################
//									 その他
//###################################################################################

	proc ジャンプ設定 {
		#if d:DEBUG_PRINT
			print '１ｍジャンプ設定'
		#endif

		command プラグイン自動ジャンプ

		trap jp001 d:PLAYER \
			-mask いる \
			-exec {
				@ジャンプ発動 jp001 1000 10
			}
	}


// -----------------------------------------------------------------------------------
// 以下デバッグ専用proc
// -----------------------------------------------------------------------------------
// デバッグキャラ
// ------------------------------------
proc デバッグキャラセット {
	#if d:DEBUG_PRINT
		print 'debug_chara_set'
	#endif

	#if d:CHARA_CAMERA
		chara キャラカメラ 敵兵カメラ \
			-c d:TARGET_CHARA \
			-s -920,610,200 \
			-r -200,1024,0
	#endif

	#if d:SCREENSHOT
		chara スクリーンショット shot
	#endif

	#if d:USB_KEY
		chara USBキーボード実行 test \
			-e d:KBD_ESC {
				mesg プレイヤー d:PLAYER position -5500, -13000, -500
			} \
	#endif
}

