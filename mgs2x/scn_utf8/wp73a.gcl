			}

		} else if ( ($1 == 移動的:04) || ($1 == 移動的:05) || ($1 == 移動的:06) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 3) {
				mesg ＶＲ的共通 移動的:07 移動開始
				mesg ＶＲ的共通 移動的:08 移動開始
