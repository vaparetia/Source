// ------------------------------------
// 各gclで必要なdefine
// ------------------------------------
// モード
#define		STAGE_VR		1	//	VRステージは全て定義する。ゲームオーバーなどで使用
#define		VR_WEAPON		1
#define		ANOTHER			1	//	VR,オルタナティブ双方で定義。a_stdproc.hで定義されているため、stdch.h内では、使用することができない
#define		STAGE_START		1	//	ゲーム開始直後処理を有効にするため
#define		BLADE_STAGE		1	//	刀ステージ明示（刀装備セットを呼ぶため）
//	#define		CUSTOM_TRG_BLINK	1	//	vr_common.hで共通で設定している点滅周期を外す
#define		CUSTOM_TRG_SPEED	1	//	vr_common.hで共通で設定しているスピード調整を外す

// ステージ名
#ifndef	d:WP74A
	#define		STAGE_WP73A		1	//	ブレード３面
#else
	#define		STAGE_WP74A		1	//	ブレード４面
#endif

// 敵兵、ＮＰＣ状況（薬莢を呼び分けるのに必要）
