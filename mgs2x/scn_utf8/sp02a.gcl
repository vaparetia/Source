					$$w:方向 = 0;
				} else {
					$$w:方向 = 2048;
				}

				if( `@エルード落下キャッチ by251 $1 -63000 $4 $5 -7000 $$w:方向 d:BY_NOFOOTSHADOW` == 1 || \
					`@エルード落下キャッチ by231 $1 -63000 $4 $5 -7000 $$w:方向 d:BY_NOFOOTSHADOW` == 1 ) {
					$f:落下キャッチ成功フラグ = 1;
				} else {
					$f:落下キャッチ成功フラグ = 0;
				}
			}
		d:バー北向きエルード時カメラ("/TRAPNAME/by221/");
		d:バー南向きエルード時カメラ("/TRAPNAME/by221/");

		trap by222 d:PLAYER \
			-mask いる \
			-key d:PAD_X \
			-state d:TRP_STATE_ELUDE_FALL \
			-exec {
				if ( $6 < -17000 ) {
					$$w:方向 = 0;
				} else {
					$$w:方向 = 2048;
				}

				if( `@エルード落下キャッチ by232 $1 -63000 $4 $5 -17000 $$w:方向 d:BY_NOFOOTSHADOW` == 1 ) {
					$f:落下キャッチ成功フラグ = 1;
				} else {
					$f:落下キャッチ成功フラグ = 0;
				}
			}
		d:バー北向きエルード時カメラ("/TRAPNAME/by222/");
		d:バー南向きエルード時カメラ("/TRAPNAME/by222/");


		// バー1Fのエルード
		//---------------------------------
		trap by211 d:PLAYER \
			-mask いる \
			-key d:PAD_X \
			-state d:TRP_STATE_ELUDE_FALL \
			-exec {
				if ( $4 < 4250 ) {
					$$w:方向 = 1024;
				} else {
					$$w:方向 = 3072;
				}

				if( `@エルード落下キャッチ by233 $1 -67000 4250 $5 $6 $$w:方向 d:BY_NOFOOTSHADOW` == 1 || \
					`@エルード落下キャッチ by221 $1 -67000 4250 $5 $6 $$w:方向 d:BY_NOFOOTSHADOW` == 1 || \
					`@エルード落下キャッチ by222 $1 -67000 4250 $5 $6 $$w:方向 d:BY_NOFOOTSHADOW` == 1 ) {
					$f:落下キャッチ成功フラグ = 1;
				} else {
					$f:落下キャッチ成功フラグ = 0;
				}
			}
		d:バー東向きエルード時カメラ("/TRAPNAME/by211/");
		d:バー西向きエルード時カメラ("/TRAPNAME/by211/");

	}



	// ------------------------------------
	// 敵兵や的の処理
	// ------------------------------------
	proc ＶＲ機雷設定 {
		#if d:DEBUG_PRINT 
			print 'vr_bomb_set'
		#endif

		if ( $s:選択プレイヤー == スネーク ) {
			command foreach -argc 2 -repeat 8 \
				-data { \
						{ 機雷:01, 0 } \
						{ 機雷:02, 1 } \
						{ 機雷:03, 2 } \
						{ 機雷:04, 3 } \
						{ 機雷:05, 4 } \
						{ 機雷:06, 5 } \
						{ 機雷:07, 6 } \
						{ 機雷:08, 7 } \
					} \
					-exec { \
						chara	ＶＲ移動的 $1 \
							-flag ( d:VR_TRG_MINE | d:VR_TRG_FL_MARK ) \
							-route $2 \
							-speed 50
					}
		}
	}

	// ------------------------------------
	// ＢＧＭの設定
	// ------------------------------------
	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT 
			print 'bgm_set'
		#endif

		chara ＢＧＭマネージャー ＢＧＭマネ
	}


	// ------------------------------------
	// アイテムの設定
	// ------------------------------------
	// 再発生が必要な時は以下のプロックの中を記述する
	// ------------------------------------
	proc アイテム取得時番号設定 $:ボックス名 {
		#if d:DEBUG_PRINT
			print 'item_no_set'
		#endif
	}
	// アイテムの設置
	// ------------------------------------
	proc アイテム設定 {
		#if d:DEBUG_PRINT 
			print 'item_set'
		#endif
	}



	// ------------------------------------
	// その他オブジェクト関係
	// ------------------------------------
	proc 落下死設定 {
		trap de001 d:PLAYER \
			-mask 入る \
			-exec {
				@ジャンプ落下死発動 0x0004 -90000
			}

		trap de002 d:PLAYER \
			-mask 入る \
			-exec {
				if ( $6 < -15000 ) {
					mesg プレイヤー d:PLAYER position2 2 -15000
				}
				
				@ジャンプ落下死発動 0x0004 -90000
			}
	}
	
	// ジャンプ落下死発動から呼ばれるプロック
	proc ジャンプ落下死開始処理 {
		#if d:DEBUG_PRINT
			print 'jump_gameover_start'
		#endif

		chara カメラ設定 クリア時カメラ \
			-c 0 \	
			-b d:CAM_MIN,-66000,d:CAM_MIN d:CAM_MAX,-67750,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 768,2172,0 -f 6154 \
			-a 200 \
			-a 200 \
			-i 0 0 0 0 \
			-s 1

		@ゲームオーバー開始処理
	}

	// 最終的に落ちたときに呼ばれるプロック（サウンドや振動を呼ぶ）
	proc ゲームオーバー終了処理 {
	}

	// ------------------------------------
	// 光源関係
	// ------------------------------------


	// ------------------------------------
	// カメラ関係の設定 
	// ------------------------------------
	// ステージカメラ設定 
	// ------------------------------------
	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'chara_camera & stage_camera_set'
		#endif

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0 
		chara カメラ メインカメラ		-c 0 -l 2 -p 40
		chara カメラ サブカメラ			-c 0 -l 2 -p 30
		chara カメラ モーションカメラ	-c 0 -l 2 -p 20
		chara カメラ サブカメラ２			-c 0 -l 2 -p 10
		chara カメラ クリア時カメラ		-c 0 -l 0 -p 10

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \	
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 700,2048,0 \
			-f 7000 \
			-a 200 \
			-z d:CAMERA_NO_CUSHION \
			-i 2 2 0 0 \
			-s 1
	}
	// ステージ固有のカメラ設定 
	// ------------------------------------
	proc アスレチックカメラ設定 {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif

		//---------------------
		// 通常のステージカメラ
		//---------------------
		// ビルの上のステージカメラ
		trap ca001 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 メインカメラ \
					-c 0 \	
					-b 2000,d:CAM_MIN,d:CAM_MIN	 3000,d:CAM_MAX,d:CAM_MAX \
					-l 2000,1500,d:CAM_MIN		 3000,d:CAM_MAX,d:CAM_MAX \
					-r 700,2048,0 \
					-f 8000 \
					-a 200 \
					-z d:CAMERA_NO_CUSHION \
					-i 2 2 0 0 \
					-s $3
			}

		// ゴール前のカメラ（モーションカメラよりも強いカメラで上書きする）
		trap ca002 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ２ \
					-c 0 \	
					-b 4000,d:CAM_MIN,d:CAM_MIN	 6000,d:CAM_MAX,-14250 \
					-l 4000,-69500,d:CAM_MIN	 6000,d:CAM_MAX,-17500 \
					-r 700,2048,0 \
					-f 6000 \
					-a 200 \
					-i 2 2 0 0 \
					-s $3
			}

		//-------------------------
		// 手すりへの張り付きカメラ
		//-------------------------
		// ビルの手すり
		trap ca101 d:PLAYER \
			-mask ？ \
			-dir 2048 512 \
			-state d:TRP_STATE_CAUTION \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ \
					-c 0 \	
					-b 2000,d:CAM_MIN,d:CAM_MIN	 3000,d:CAM_MAX,d:CAM_MAX \
					-l 2000,1500,d:CAM_MIN		 3000,d:CAM_MAX,d:CAM_MAX \
					-r 825,2048,0 \
					-f 6000 \
					-a 200 \
					-z d:CAMERA_NO_CUSHION \
					-i 3 3 0 0 \
					-s $3
			}

		// ビル屋上西の壁
		trap ca102 d:PLAYER \
			-mask ？ \
			-dir 1024 512 \
			-state d:TRP_STATE_CAUTION \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ \
					-c 0 \	
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN 0,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,1500,d:CAM_MIN		 0,d:CAM_MAX,d:CAM_MAX \
					-r 825,2048,0 \
					-f 6000 \
					-a 200 \
					-z d:CAMERA_NO_CUSHION \
					-i 3 3 0 0 \
					-s $3
			}

		// ビルの屋上北の壁
		trap ca103 d:PLAYER \
			-mask ？ \
			-dir 0 512 \
			-state d:TRP_STATE_CAUTION \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ \
					-c 0 \	
					-b 2000,d:CAM_MIN,d:CAM_MIN	 3000,d:CAM_MAX,-4500 \
					-l 2000,1500,d:CAM_MIN		 3000,d:CAM_MAX,-5750 \
					-r 900,2048,0 \
					-f 7000 \
					-a 200 \
					-z d:CAMERA_NO_CUSHION \
					-i 3 3 0 0 \
					-s $3
			}

		// ビル屋上東の壁
		trap ca104 d:PLAYER \
			-mask ？ \
			-dir 3072 512 \
			-state d:TRP_STATE_CAUTION \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ \
					-c 0 \	
					-b 5000,d:CAM_MIN,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l 5000,1500,d:CAM_MIN		 d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 825,2048,0 \
					-f 6000 \
					-a 200 \
					-z d:CAMERA_NO_CUSHION \
					-i 3 3 0 0 \
					-s $3
			}
	}





// -----------------------------------------------------------------------------------
// 以下デバッグ専用proc
// -----------------------------------------------------------------------------------
// デバッグキャラ
// ------------------------------------
proc デバッグキャラセット {
	#if d:DEBUG_PRINT
		print 'debug_chara_set'
	#endif

	#if d:CHARA_CAMERA
		chara キャラカメラ 敵兵カメラ \
			-c d:TARGET_CHARA \
			-s -920,610,200 \
			-r -200,1024,0 
	#endif

	#if d:SCREENSHOT
		chara スクリーンショット shot
	#endif

	#if d:USB_KEY
		chara USBキーボード実行 test \
			-e d:KBD_1 {	
				chara プロック連続実行 絶対エルードＯＫ処理 -time -1 -exec {
					$$b:エルードボタンチェック = $$b:エルードボタンチェック + 1;

					if ( $$b:エルードボタンチェック == 3 ) {
						command パッド操作 -press d:PAD_X;
						$$b:エルードボタンチェック = 0;
					}
				}
			} \
			-e d:KBD_2 {	
				mesg プレイヤー d:PLAYER position 5000, -13000, -18000
			} \
			-e d:KBD_ESC {	
				print 'mesg プロック連続実行 絶対エルードＯＫ処理 kill'
				mesg プロック連続実行 絶対エルードＯＫ処理 kill
			} \
	#endif
}
