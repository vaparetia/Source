// ------------------------------------
// 各gclで必要なdefine
// ------------------------------------
// モード
#define		STAGE_VR		1		// 共通プロック切り分け用
// ステージ名
#define		STAGE_SP02A		1		// 共通プロック切り分け用
// オブジェクト
#define		SD_LOCKER_FLR	4		// ロッカー扉SE番号(倒れバージョン)
#define		SD_LOCKER_HZD	4		// ロッカー扉SE番号(扉バージョン)

// ------------------------------------
// 各種スイッチ用define
// ------------------------------------
// デバッグ関係
#ifdef	d:FIX_MODE
	#define		DEBUG_CHARA		0		// デバッグキャラ全体(FIX時は0)
#else
	#define		DEBUG_CHARA		1		// デバッグキャラ全体
	$$b:エルードボタンチェック = 0;
#endif
#define		CHARA_CAMERA	0		// キャラ追従カメラ
#define		TARGET_CHARA	敵兵:01	// キャラ追従カメラのターゲット
#define		SCREENSHOT		0		// スクリーンショット
#define		USB_KEY			1		// USBキーボード


// ------------------------------------
// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME			sp02a
#define		KMS_NAME0			sp02a0
#define		KMS_NAME1			sp02a1
#define		TONBO_KMS_NAME0		sp02a0_tonbo
#define		TONBO_KMS_NAME1		sp02a1_tonbo
#define		LINE_KMS_NAME0		sp02a0_line
#define		LINE_KMS_NAME1		sp02a1_line

// キャラクター関係
#define		PLAYER		ライデン


// ------------------------------------
// ゴールの位置
// ------------------------------------
#define	GOAL_POS_SP02A		5000 -71000 -20000

// ------------------------------------
// ＶＲウィンドウのリソース等
// ------------------------------------
#define	SP02A_WINDOW_RES [VRMSG_J:VRM_VRT_sp02a] [VRMSG_E:VRM_VRT_sp02a] [VRMSG_G:VRM_VRT_sp02a] \	// 日、英、独
						 [VRMSG_F:VRM_VRT_sp02a] [VRMSG_I:VRM_VRT_sp02a] [VRMSG_S:VRM_VRT_sp02a] \	// 仏、伊、西
						 [VRMSG_K:VRM_VRT_sp02a] \															// 韓
						 p:ＶＲステージ開始時処理		// 終了プロック


// ------------------------------------
// include
// ------------------------------------
#include "rai_sp02a.mh"		// 強制モーションリスト
#include "stdch.h"
#include "a_stdproc.h"			// アナザーミッション設定ファイル
#include "sload.h"
#include "sound.h"
#include "jump.h"
#include "fall.h"
#include "beyond.h"
#include "item_info.h"
#include "vr_common.h"		// ＶＲステージ共通で使用するプロック

#if d:USB_KEY
	#include "usbkbd.h"
#endif

// ------------------------------------
// マップ設定
// ------------------------------------
chara マップ アスレチック -k d:KMS_NAME0 -k d:KMS_NAME1 -h d:HZX_NAME,0 -l $s:ＶＲライトファイル名

command マップ設定 アスレチック -set {
	// ローカルの初期化
	// ------------------------------------
	@ローカル変数初期化		// ローカルで使用する変数で初期化をする場合はここで
	// 設定値を変更する場合は以下のプロック内で設定
	// ------------------------------------
	@設定値変更				// 敵兵や的のパラメータをステージ限定で変える時はここで

	// ＶＲで必要な基本プロックのセット(vr_common.hで定義)
	// サウンドの基本パック、ＶＲの基本システム、プレイヤー、ゴール等を設定します
	// ※このプロックを使用する時は「ＶＲクリア時処理」というプロックが必要です
	// ＶＲ共通プロックセット	$:スネークファイル $:雷電ファイル $:クリア条件フラグ
	//							$:ゴールＸ $:ゴールＹ $:ゴールＺ $:タイマー初期値
	//	VR_GOAL_TARGET	/*的全滅でゴールが開く*/
	//	VR_GOAL_FREE	/*ゴールが最初から開いてる*/
	//	VR_GOAL_ENEMY	/*敵全滅でゴールが開く*/
	//	VR_GOAL_SNEAK	/*潜入モード中はゴールが開く*/
	//	VR_GOAL_TIME	/*タイマーがゼロになるとゴールが開く*/
	// ------------------------------------
	@ＶＲ共通プロックセット sna_sp02a rai_sp02a d:VR_GOAL_FREE d:GOAL_POS_SP02A

	// ＶＲウィンドウの設定
	// ------------------------------------
	@アスレチックＶＲウィンドウ設定

	// クリア時に呼ばれるものの設定
	// ------------------------------------
	@ＶＲクリア設定 p:load_sp06a p:A_ＲＥＴＲＹプロック

	// ステージに引かれるライン
	// ------------------------------------
	@ＶＲアウトライン d:KMS_NAME0 d:TONBO_KMS_NAME0 d:LINE_KMS_NAME1

	// プレイヤーの設定
	// ------------------------------------
	@プラグイン設定
	@エルード設定

	// 敵兵・的関係の設定
	// ------------------------------------
	@ＶＲ機雷設定

	// ＢＧＭの設定(プレイヤー→敵兵→BGMの順で呼ぶ)
	// ------------------------------------
	@ＢＧＭ設定

	// アイテムの設定
	// ------------------------------------

	// 光源、オブジェクト、カメラ関連の設定
	// ------------------------------------
	@ＶＲフォグ設定 -10000 85000 -12000 90000 -8000 85000
	@落下死設定
	@カメラセット					// chara カメラとベースのカメラを設定
	@アスレチックカメラ設定		// ステージ固有のカメラ設定がいる時はこのプロックで
	@ＶＲキャラ用ライト設置				// 必ず最後に設定
#if d:DEBUG_CHARA
	@デバッグキャラセット
#endif
}

//初期マップの表示
command マップ表示 -show アスレチック


proc hoge {
 @hogegeo
}

// 各proc設定
//-------------------------------------------------------------------------------------
// 全マップ共通
	//------------------------------------------------------------
	// ＶＲウィンドウの設定と表示
	//------------------------------------------------------------
	proc アスレチックＶＲウィンドウ設定 {
		#if d:DEBUG_PRINT
			print 'vr_window_set'
		#endif

		@ＶＲウィンドウ設定	d:SP02A_WINDOW_RES

		// ＶＲウィンドウを表示する
		mesg ＶＲウィンドウ ＶＲウィンドウ君 開く

		// スタート時とクリア時に使用するカットインカメラ
		chara カメラ カットインカメラ		-c 0 -l 0 -p  0

		// スタート時のカメラ(必要な場合)
		chara カメラ設定 カットインカメラ \
			-c 1 \	
			-p 5000,-67620,-14387 -t 5000,-69866,-18542 \
			-r 323,2048,0 -f 4723 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1
	}

	//------------------------------------------------------------
	// ステージ開始時処理
	//------------------------------------------------------------
	proc ＶＲステージ開始時処理 {
		#if d:DEBUG_PRINT
			print 'game_start!!!!!'
		#endif

		// プレイヤーやパッドの制御等を行う a_stdproc.hで定義
		@全ミッション共通ステージ開始時処理

		// カメラワークスタート(必要な場合)
		// 全体図
		chara カメラ設定 カットインカメラ \
			-c 1 \	
			-p 5000,30192,-3240 -t 5000,-71000,-20000 \
			-r 917,2048,0 -f 102571 \
			-a 200 \
			-i 4 4 d:START_CAMERA_CHANGE_TIME d:START_CAMERA_CHANGE_TIME \
			-s 1

		chara delay ディレイ \
			-time d:START_CAMERA_CHANGE_TIME \
			-exec {
				chara カメラ設定 カットインカメラ -s -1
			}
	}

	// ------------------------------------
	// クリア時の処理
	// ------------------------------------
	proc ＶＲクリア時処理 {
		#if d:DEBUG_PRINT 
			print 'clear'
		#endif

		// 強制モーションを発動
		@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_1 2048

		// クリア時にカメラアングルを変える
		chara カメラ設定 クリア時カメラ \
			-c 1 \	
			-p 6237,-71080,-22417 -t 5067,-69577,-19047 \
			-r 3836,3878,0 -f 3871 \
			-a 200 \
			-i 1 0 0 0 \
			-s 1
	}



	// ------------------------------------
	// パラメータ系の変更
	// ------------------------------------
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT 
			print 'localvar_init'
		#endif

		// このステージで使用するローカル変数
		$$w:方向 = 0;
	}
	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT 
			print 'status_set'
		#endif

		command 配列セット $w:スネークグリップ最大[0] {
			1000, 3600, 5400, 0
		}

		command 配列セット $w:ライデングリップ最大[0] {
			1300, 3600, 5400, 0
		}
	}



	// ------------------------------------
	// プレイヤーに関する設定
	//-------------------------------------
	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif

		command プラグイン落下
	}

	//-------------------------------------
	// エルード
	// ------------------------------------
#define	プレイヤー落下キャッチ時移動Ｘ	if ( $4 < (X_MIN+250) ) { \
									mesg プレイヤー d:PLAYER position2 0 (X_MIN+250) \
								} else if ( $4 > (X_MAX-250) ) { \
									mesg プレイヤー d:PLAYER position2 0 (X_MAX-250) \
								}

#define	プレイヤー落下キャッチ時移動Ｚ	if ( $6 < (Z_MIN+250) ) { \
									mesg プレイヤー d:PLAYER position2 2 (Z_MIN+250) \
								} else if ( $6 > (Z_MAX-250) ) { \
									mesg プレイヤー d:PLAYER position2 2 (Z_MAX-250) \
								}

#define		ビルエルード時カメラ	trap TRAPNAME d:PLAYER \
										-mask ＊ \
										-state 5 \
										-dir 2048 256 \
										-camera \
										-exec { \
											if ( !(`command プレイヤー状態取得` & d:PFLAG_ELUDE_FALL)) { \
												chara カメラ設定 モーションカメラ \
													-c 0 \
													-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
													-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
													-r 750,2048,0 -f 6000 \
													-a 200 \
													-i 0 -1 0 0 \
													-z d:CAMERA_NO_CUSHION \
													-s $3 \
											} else { \
												chara カメラ設定 モーションカメラ -s 0 \
											} \
										}

#define		バー北向きエルード時カメラ	trap TRAPNAME d:PLAYER \
											-mask ＊ \
											-state 5 \
											-dir 2048 256 \
											-camera \
											-exec { \
												if ( !(`command プレイヤー状態取得` & d:PFLAG_ELUDE_FALL)) { \
													chara カメラ設定 モーションカメラ \
														-c 0 \
														-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
														-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
														-r 820,2048,0 -f 6000 \
														-a 200 \
														-i 0 -1 0 0 \
														-z d:CAMERA_NO_CUSHION \
														-s $3 \
												} else { \
													chara カメラ設定 モーションカメラ -s 0 \
												} \
											}

#define		バー南向きエルード時カメラ	trap TRAPNAME d:PLAYER \
											-mask ＊ \
											-state 5 \
											-dir 0 256 \
											-camera \
											-exec { \
												if ( !(`command プレイヤー状態取得` & d:PFLAG_ELUDE_FALL)) { \
													chara カメラ設定 モーションカメラ \
														-c 0 \
														-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
														-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
														-r 785,2048,0 -f 6000 \
														-a 200 \
														-i 0 -1 0 0 \
														-z d:CAMERA_NO_CUSHION \
														-s $3 \
												} else { \
													chara カメラ設定 モーションカメラ -s 0 \
												} \
											}

#define		バー東向きエルード時カメラ	trap TRAPNAME d:PLAYER \
											-mask ＊ \
											-state 5 \
											-dir 1024 256 \
											-camera \
											-exec { \
												if ( !(`command プレイヤー状態取得` & d:PFLAG_ELUDE_FALL)) { \
													chara カメラ設定 モーションカメラ \
														-c 0 \
														-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
														-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
														-r 750,2048,0 -f 6000 \
														-a 200 \
														-i 0 -1 0 0 \
														-z d:CAMERA_NO_CUSHION \
														-s $3 \
												} else { \
													chara カメラ設定 モーションカメラ -s 0 \
												} \
											}

#define		バー西向きエルード時カメラ	trap TRAPNAME d:PLAYER \
											-mask ＊ \
											-state 5 \
											-dir 3072 256 \
											-camera \
											-exec { \
												if ( !(`command プレイヤー状態取得` & d:PFLAG_ELUDE_FALL)) { \
													chara カメラ設定 モーションカメラ \
														-c 0 \
														-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
														-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
														-r 750,2048,0 -f 6000 \
														-a 200 \
														-i 0 -1 0 0 \
														-z d:CAMERA_NO_CUSHION \
														-s $3 \
												} else { \
													chara カメラ設定 モーションカメラ -s 0 \
												} \
											}

	proc エルード設定 {
		#if d:DEBUG_PRINT
			print 'beyond_set'
		#endif

		// 屋上レベルのエルード
		//---------------------------------
		trap by101 d:PLAYER \
			-mask いる \
			-key d:PAD_ACTION \	//アクションボタン
			-state 0,4 \		//立ち状態or張り付き
			-exec {
				@南向きビヨンド発動 by101 0 $4 250 4750 d:BY_NOFOOTSHADOW
			}
		trap by101 d:PLAYER \
			-mask いる \
			-state 6 \
			-dir 0 256 \	//方向指定
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 378,2267,0 -f 6035 \
					-a 200 \
					-i 0 -1 0 0 \
					-s 1
			}
		trap by101 d:PLAYER \
			-mask ？ \
			-state 5 \
			-dir 2048 256 \	//方向指定
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 750,2048,0 -f 6000 \
					-a 200 \
					-i 3 2 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}


		// 9Fのエルード
		//---------------------------------
		trap by191 d:PLAYER \	// 落下キャッチ
			-mask いる \
			-key d:PAD_X \
			-state d:TRP_STATE_ELUDE_FALL \
			-exec {
				if(	`@エルード落下キャッチ by101 $1 -3000 $4 $5 0 2048 d:BY_NOFOOTSHADOW` == 1 ){
					d:プレイヤー落下キャッチ時移動Ｘ("/X_MIN/1000/","/X_MAX/4000/");
					$f:落下キャッチ成功フラグ = 1;
				} else {
					$f:落下キャッチ成功フラグ = 0;
				}
			}
		d:ビルエルード時カメラ("/TRAPNAME/by191/");


		// 8Fのエルード
		//---------------------------------
		// 左側の窓
		trap by181 d:PLAYER \	// 落下キャッチ
			-mask いる \
			-key d:PAD_X \
			-state d:TRP_STATE_ELUDE_FALL \
			-exec {
				if(	`@エルード落下キャッチ by101 $1 -7000 $4 $5 0 2048 d:BY_NOFOOTSHADOW` == 1 || \
					`@エルード落下キャッチ by191 $1 -7000 $4 $5 0 2048 d:BY_NOFOOTSHADOW` == 1 ){
					d:プレイヤー落下キャッチ時移動Ｘ("/X_MIN/1000/","/X_MAX/2000/");
					$f:落下キャッチ成功フラグ = 1;
				} else {
					$f:落下キャッチ成功フラグ = 0;
				}
			}
		d:ビルエルード時カメラ("/TRAPNAME/by181/");

		// 右側の窓
		trap by182 d:PLAYER \	// 落下キャッチ
			-mask いる \
			-key d:PAD_X \
			-state d:TRP_STATE_ELUDE_FALL \
			-exec {
				if(	`@エルード落下キャッチ by101 $1 -7000 $4 $5 0 2048 d:BY_NOFOOTSHADOW` == 1 || \
					`@エルード落下キャッチ by191 $1 -7000 $4 $5 0 2048 d:BY_NOFOOTSHADOW` == 1 ){
					d:プレイヤー落下キャッチ時移動Ｘ("/X_MIN/3000/","/X_MAX/4000/");
					$f:落下キャッチ成功フラグ = 1;
				} else {
					$f:落下キャッチ成功フラグ = 0;
				}
			}
		d:ビルエルード時カメラ("/TRAPNAME/by182/");


		// 7Fのエルード
		//---------------------------------
		trap by171 d:PLAYER \	// 落下キャッチ
			-mask いる \
			-key d:PAD_X \
			-state d:TRP_STATE_ELUDE_FALL \
			-exec {
				if(	`@エルード落下キャッチ by101 $1 -11000 $4 $5 0 2048 d:BY_NOFOOTSHADOW` == 1 || \
					`@エルード落下キャッチ by191 $1 -11000 $4 $5 0 2048 d:BY_NOFOOTSHADOW` == 1 || \
					`@エルード落下キャッチ by181 $1 -11000 $4 $5 0 2048 d:BY_NOFOOTSHADOW` == 1 ){
					d:プレイヤー落下キャッチ時移動Ｘ("/X_MIN/1000/","/X_MAX/3000/");
					$f:落下キャッチ成功フラグ = 1;
				} else {
					$f:落下キャッチ成功フラグ = 0;
