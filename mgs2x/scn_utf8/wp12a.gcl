// ------------------------------------
// 的ルート番号
// ------------------------------------
enum M_R {
	//	マシンガン２面用
//	共通ルート０ = 0,	// 欠番

	共通ルート３８ = 38,
	共通ルート３９,

	ライデンルート４０, ライデンルート４１, ライデンルート４２, ライデンルート４３, ライデンルート４４,
	ライデンルート４５, ライデンルート４６, ライデンルート４７, ライデンルート４８, ライデンルート４９,
	ライデンルート５０, ライデンルート５１,

	スネークルート５２, スネークルート５３, スネークルート５４, スネークルート５５, スネークルート５６,
	スネークルート５７, スネークルート５８, スネークルート５９, スネークルート６０, スネークルート６１,
	スネークルート６２, スネークルート６３, スネークルート６４, スネークルート６５,

	前作スネークルート６６, 前作スネークルート６７, 前作スネークルート６８, 前作スネークルート６９, 前作スネークルート７０,
	前作スネークルート７１, 前作スネークルート７２, 前作スネークルート７３, 前作スネークルート７４, 前作スネークルート７５,
	前作スネークルート７６, 前作スネークルート７７, 前作スネークルート７８, 前作スネークルート７９, 前作スネークルート８０,
	前作スネークルート８１, 前作スネークルート８２, 前作スネークルート８３, 前作スネークルート８４, 前作スネークルート８５,
	前作スネークルート８６, 前作スネークルート８７, 前作スネークルート８８, 前作スネークルート８９,
}


