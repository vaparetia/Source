/**************************************************************************************************/
//	define
/**************************************************************************************************/
// デバッグ用
#ifdef d:FIX_MODE
	#define MY_DEBUG	0		// デバッグ
	#define ASSERT		0		// Assert関数使用
#else
	#define MY_DEBUG	0		// デバッグ
	#define ASSERT		0		// Assert関数使用
#endif

// レーダー用
#define STAGE_PLANT		1		// プラントレーダー
// 薬莢
#define ENE_T_GOL		1		// タンカー編ゴル兵
#define ENE_SHOT		1		// ショットガン兵
#define ENE_SHIELD		1		// 盾兵
#define GUN_MECA		1		// ガンカメ ガンサイファー

// 各種スイッチ用define
#define NODE			1		// ノード端末


// サウンド
#define SOUND			1		// サウンドデータは最初に呼ぶ
#define STAGE_W24A		1		// サウンド用ディファイン
#define BGM				1		// BGMは敵兵コマンダーの後に呼ぶ
// デモ
#define		SCENARIO_DEMO	1		// シナリオデモ

// キャラクター関係
#define RAIDEN			1		// SNAKEとは排他
#define SNAKE			0

// エレベーター
#define ELEVATOR_SET	1
#define ELEVATOR_Y		0
#define ELEVATOR_Z		0
#define ELV_1F			1
#define ELE_CHECK		1		// 変装チェック stdproc.h で使用
#define SHELL			0		// エレベーター用 シェル1

// 爆弾用
#define CTDOWN_TIMER_P	1

// 監視カメラ関係
#define SV_CAMERA		1		// 監視カメラ
// ドア
#define WT_DOOR			0		// 水密ドア
#define SLIDE_DOOR		1		// スライドドア
#define ELV_DOOR		0		// エレベータードア

// 入出トラップ
#define LOAD_TRAP		1
#define STAGE_END		1		// ステージ終了時処理を使用可にする

// エフェクト関係
#define FOG				1		// フォグ
#define EFFECT			1		// エフェクト全般
#define MIRROR			1		// 鏡面モデル
#define BLUR			0		// ブラー
#define Z_MANAGER		0		// Ｚフォーカス管理(敵のライト等で仕様)
#define BODY_SHADOW		0		// 敵のライトによって出る影
// カメラ関係
#define SUB_CAMERA		0		// 子画面
#define CLEAR_CAMERA	0		// クリアリング専用カメラ(要子画面)
#define CLE_CAMERA		1

#define CHARA_CEIL		1		// 天井君
#define WALL			1		// 手前壁
#define ELEVATOR		1		// エレベーター
#define TR_WALL			1		// シナリオ置きの透明壁
#define SPOT_LIGHT		0		// スポットライト
#define LOCKER			1		// ロッカー
#define ITEM			1		// アイテム
#define JP_MOTION		1		// ジャンプモーション


/***************************************************************************************************/
// 各種設定用define
/***************************************************************************************************/
// マップ関係
#define		HZX_NAME			w24a
#define		DOOR_NAME_ELV_1		elv_dr1			// エレベータ用１
#define		DOOR_NAME_ELV_2		elv_dr2			// エレベータ用２
#define		LT2_NAME			w24a

// キャラクター関係
#if d:RAIDEN
	#define		PLAYER		ライデン
#else
	#define		PLAYER		スネーク
#endif

// ローカル変数


// include
// ------------------------------------
#include "rai_w24a.mh"		// 強制モーションリスト
#include "stdch.h"
#include "sload.h"
#include "jump.h"
#include "sound.h"
#include "enevoice.h"
#include "item_info.h"
#include "camproc.h"
#include "node_res.h"
#include "ene_item.h"

#if d:MY_DEBUG
	#include "usbkbd.h"
#endif

/***************************************************************************************************/
// 注意事項
/***************************************************************************************************/
/* コメント
	c001C c002C はエレベーター前俯瞰カメラで使用（現在削除可能）
*/

/***************************************************************************************************/
// マップ
/***************************************************************************************************/

	/////////
	// 廻廊部

	if( $w:p_story < d:ST:P069_04_R02ヴァンプ狙撃終了４無線機デモ２終了 ) {
		// 昼
		chara マップ シェル１中央棟１Ｆ \
									-k w24a0 \
									-k w24a_21a \		// ロードポイント
									-h d:HZX_NAME,0 \
									-l d:LT2_NAME
	} else {
		// 夜
		chara マップ シェル１中央棟１Ｆ \
									-k w24a0 \
									-k w24a_21b \		// ロードポイント
									-h d:HZX_NAME,0 \
									-l d:LT2_NAME
	}

	/////////
	// 小部屋
	chara マップ シェル１中央棟小部屋 \
								-k w24a1 \
								-h d:HZX_NAME,1 \
								-l d:LT2_NAME

	chara マップ接合 シェル１中央棟１Ｆ／シェル１中央棟小部屋左 シェル１中央棟１Ｆ シェル１中央棟小部屋
	chara マップ接合 シェル１中央棟１Ｆ／シェル１中央棟小部屋右 シェル１中央棟１Ｆ シェル１中央棟小部屋

// 位置変更不可
#if	d:シナリオデモカメラアングル作成
	#include "scn_demo_prvw.h"
#endif

/***************************************************************************************************/
// マップ設定
/***************************************************************************************************/

command マップ設定 シェル１中央棟１Ｆ シェル１中央棟小部屋 -set {
#if d:SOUND
	@サウンド設定	// データは最初に呼ぶ
#endif
	@レーダーオンオフチェック $f:w24a_ノードフラグ		// 常駐より前に
	@常駐キャラ設定
	@ローカル変数初期化
	@設定値変更
	@プラグイン設定
	@プレイヤー設定
	@プラント編全体マップ設定 d:シェル１中央棟マップ	// stdproc.hで定義

	if( $w:p_story < d:ST:P069_04_R02ヴァンプ狙撃終了４無線機デモ２終了 ) {
		@コマンダー設定
	}

#if d:BGM
	@ＢＧＭ設定	// プレイヤー→敵兵→BGMの順で呼ぶ
#endif

#if d:SCENARIO_DEMO
	@シナリオデモキャラセット
#endif
#if d:WALL
	@手前壁
#endif
#if d:SLIDE_DOOR
	@ドア設置
#endif

#if d:LOAD_TRAP
	@ロード設定
#endif
#if d:ITEM
	@アイテム設置
#endif

#if d:EFFECT
	@エフェクト設定
#endif

	@カメラセット

#if d:CLE_CAMERA
	@子画面設定
#endif

#if d:CHARA_CEIL
	@シェル１中央棟１Ｆ天井設置
#endif

#if d:JP_MOTION
	@シェル１中央棟１Ｆジャンプ設定
#endif
	@シェル１中央棟１Ｆカメラ設定

	#if d:MY_DEBUG
		@デバッグキャラセット
	#endif

#if d:FOG
	@フォグ設定
#endif

	//@レーダー当たり追加登録

	if( $w:p_story == d:ST:P069_04_R02ヴァンプ狙撃終了４無線機デモ２終了 ) {
		@ふな虫起動
	}

	@爆弾タイマー設置
}

command マップ設定 シェル１中央棟１Ｆ -set {
	#if d:SV_CAMERA
		@監視カメラ設定
	#endif
	#if d:ELEVATOR
		@エレベーター設置 シェル１中央棟１Ｆ
		@エマ狙撃後エレベータを開けておく
	#endif
		@主観禁止壁設置
}

command マップ設定 シェル１中央棟小部屋 -set {
	@ノード端末設定 1024

	#if d:TR_WALL
		@５０ｃｍ隙間透明壁設置
	#endif
	#if d:LOCKER
		@ロッカー設置
	#endif
		@消火器設置

	//@レーダー当たり追加登録
}


command マップ設定 シェル１中央棟１Ｆ シェル１中央棟小部屋 -set {
	@毎フレーム処理		// 最後に置く事
}

/***************************************************************************************************/
// 無線用include ※位置は動かさないこと
/***************************************************************************************************/
#include "w24a_cdc.ch"
#include "p_force_cdc.ch"

/***************************************************************************************************/
// ステージ開始時処理
/***************************************************************************************************/
	command マップ表示 -show シェル１中央棟１Ｆ		// 初期マップの表示
	@キャラ用ライト設置								// マップ表示の後に行うことでキャラだけにライトを当てる

	// 全てのセットが終わったところでフェードイン
	if( $s:登場ポイント == sp_w15a_w24a_0 ) {
	//////////////////
	// ＢＣ連絡橋から
		#if 0
			@ステージ開始時処理 \
					d:LOAD_TYPE:SL_DOOR_TYPE \
					１Ｆ左ドア \
					2000 \
					d:DEFAULT_M_TYPE
		#else
			#if d:ASSERT
				command assert ( d:FALSE ) 'unexpected load point'
			#endif
		#endif
	} else if( $s:登場ポイント == sp_w21a_w24a_0 ) {
	/////////////////
	// ＥＦ連絡橋から
		@ステージ開始時処理（ステージ名表示） \
					d:LOAD_TYPE:SL_DOOR_TYPE \
					１Ｆ右ドア \
					2000 \
					d:DEFAULT_M_TYPE \
					d:wn_シェル１中央棟１Ｆ

	} else if( ($s:登場ポイント == sp_w24d_w24a_0) || ($s:登場ポイント == sp_w24b_w24a_0) ) {
	/////////////////////////////
	// エレベーター ( w24d,w24b ) から
		@ステージ開始時処理（エレベーター） d:wn_シェル１中央棟１Ｆ

	} else {
		#if d:ASSERT
			command assert ( d:FALSE ) 'unexpected load point'
		#endif
	}

/***************************************************************************************************/
// 主観禁止壁設置
/***************************************************************************************************/
	proc 主観禁止壁設置 {
		// 主観覗き込み禁止処理
		chara 透明壁 覗きこみ禁止壁Ｒ \
			-position	19250,-1500,-55750,2000 \
						19250,-1500,-54250,2000 \
			-attribute	( d:HZX_SEG_ATR_ALL & ~(d:HZX_SEG_NO_PLAYER ))

		mesg 透明壁 覗きこみ禁止壁Ｒ off

		trap dr002 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_SUBJECT \
			-exec {
				if( $3 == 入る ) {
					mesg 透明壁 覗きこみ禁止壁Ｒ on
				} else {
					mesg 透明壁 覗きこみ禁止壁Ｒ off
				}
			}

	}
/***************************************************************************************************/
// サウンド
/***************************************************************************************************/
	proc サウンド設定 {
		#if d:DEBUG_PRINT
			print 'sound_set'
		#endif

		chara サウンドマネージャー ＳＤマネ -pak 0
		@サウンド効果音設定

		command 弾痕ノーマル -n 0
		command 弾痕ノーマル -n 1
		command 弾痕ノーマル -n 2
		command 弾痕ノーマル -n 3
		command 弾痕ノーマル -n 4

		command 跳弾ノーマル -n 0
		command 跳弾ノーマル -n 1
		command 跳弾ノーマル -n 2
		command 跳弾ノーマル -n 3
		command 跳弾ノーマル -n 4

		command 弾痕ノーマル -n 5
		command 弾痕ノーマル -n 6
		command 跳弾水蒸気小 -n 5
		command 跳弾水蒸気中 -n 6

		command 弾痕ノーマル -n 7
		command 跳弾ＳＥのみ -n 7

	}

	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT
			print 'localvar_init'
		#endif
	}

	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT
			print 'status_set'
		#endif
	}

/***************************************************************************************************/
// ノード処理
/***************************************************************************************************/
	proc ノード接続時プロック {
		#if d:DEBUG_PRINT
			print 'node_set'
		#endif
		eval( $f:ノードフラグ = $f:w24a_ノードフラグ );
	}

	proc ノード接続後プロック {
		#if d:DEBUG_PRINT
			print 'node_event_go'
		#endif
		eval($f:w24a_ノードフラグ = 1);
		command メニュー設定 -node_access on
	}

/***************************************************************************************************/
// プラグインプログラム
/***************************************************************************************************/
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif

		#if d:JP_MOTION
			command プラグイン自動ジャンプ
		#endif
	}

/***************************************************************************************************/
// プレイヤー
/***************************************************************************************************/
	proc プレイヤー設定 {
		#if d:DEBUG_PRINT
			print 'player_set'
		#endif

		#if d:RAIDEN
			chara プレイヤー d:PLAYER \
				-p $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,$i:プレイヤー初期Ｚ位置 \
				-d 0,$i:プレイヤー初期方向,0 \
				-s 0 \
				-m rai_def -a raiden -o rai_w24a
				//-f d:PLY_NO_FOOT_SHADOW

			// 髪の毛
			@ライデン髪の毛設定 d:NORMAL_HAIR

			@プレイヤーＬＯＤ設定 d:C_DISTANCE_TYPE 6000
		#endif

	}

/***************************************************************************************************/
// 監視カメラの設定
/***************************************************************************************************/
	proc 監視カメラ_入口 {
		chara プラントカメラ カメラ:02 \
			-pos 16000 1500 -56500 \
			-rot 500 4096 0 \ 	// ＸＹ値のみ有効
			-center 3750 0 \
			-dir 128 \
			-xran 256 \
			-yran 256 \
			-i 5000 \
			-status $b:w24a_カメラ破壊フラグ[1] \
			-exec {
				eval( $b:w24a_カメラ破壊ロード回数[1] = $w:グローバルロード回数);
				eval( $b:w24a_カメラ破壊フラグ[1] = $2 );
			}
	}
	proc 監視カメラ_右通路_北 {
		chara プラントカメラ カメラ:03 \
			-pos 11750 3000 -70400 \
			-rot 600 3072 0 \ 	// ＸＹ値のみ有効
			-center 3584 3072 \	// $i:振り中心角 $i:初期方向
			-dir 512 \
			-xran 256 \
			-yran 256 \
			-i 6000 \
			-status $b:w24a_カメラ破壊フラグ[2] \
			-exec {
				eval( $b:w24a_カメラ破壊ロード回数[2] = $w:グローバルロード回数);
				eval( $b:w24a_カメラ破壊フラグ[2] = $2 );
			}
	}
	proc 監視カメラ_右通路_真中 {
		chara プラントカメラ カメラ:04 \
			-pos 9250 3000 -63750 \
			-rot 700 1024 0 \ 	// ＸＹ値のみ有効
			-center 1024 1024 \	// $i:振り中心角 $i:初期方向
			-dir 768 \
			-xran 256 \
			-yran 256 \
			-i 5000 \
			-status $b:w24a_カメラ破壊フラグ[3] \
			-exec {
				eval( $b:w24a_カメラ破壊ロード回数[3] = $w:グローバルロード回数);
				eval( $b:w24a_カメラ破壊フラグ[3] = $2 );
			}
	}

	proc 監視カメラ_右通路_南 {
		chara プラントカメラ カメラ:05 \
			-pos 9250 3000 -49250 \
			-rot 700 1024 0 \ 	// ＸＹ値のみ有効
			-center 768 768 \	// $i:振り中心角 $i:初期方向
			-dir 768 \
			-xran 256 \
			-yran 256 \
			-i 5000 \
			-status $b:w24a_カメラ破壊フラグ[4] \
			-exec {
				eval( $b:w24a_カメラ破壊ロード回数[4] = $w:グローバルロード回数);
				eval( $b:w24a_カメラ破壊フラグ[4] = $2 );
			}
	}

	proc 監視カメラ_左通路 {
		chara プラントカメラ カメラ:01 \
			-pos -9125 3000 -55000 \
			-rot 500 3072 0 \ /*ＸＹ値のみ有効*/
			-center 3072 0 \
			-dir 768 \
			-xran 256 \ 	// 省略可
			-yran 256 \ 	// 省略可
			-i 5000 \		// 省略可
			-status $b:w24a_カメラ破壊フラグ[0] \
			-exec {
				eval( $b:w24a_カメラ破壊ロード回数[0] = $w:グローバルロード回数);
				eval( $b:w24a_カメラ破壊フラグ[0] = $2 );
			}
	}

	proc 監視カメラ設定 {
		#if d:DEBUG_PRINT
			print 'w24a_sv_camera_set'
		#endif

		if( $w:p_story >= d:ST:P069_04_R02ヴァンプ狙撃終了４無線機デモ２終了 ) {
			eval ($b:w24a_カメラ破壊フラグ[0] = d:PLANT_CAMERA_BROKEN)
			eval ($b:w24a_カメラ破壊フラグ[1] = d:PLANT_CAMERA_BROKEN)
			eval ($b:w24a_カメラ破壊フラグ[2] = d:PLANT_CAMERA_BROKEN)
			eval ($b:w24a_カメラ破壊フラグ[3] = d:PLANT_CAMERA_BROKEN)
			eval ($b:w24a_カメラ破壊フラグ[4] = d:PLANT_CAMERA_BROKEN)
		} else {
			@カメラ再セットチェック $b:w24a_カメラ破壊ロード回数[0]
			if ($f:再セットフラグ) {
				eval ($b:w24a_カメラ破壊フラグ[0] = d:FALSE)
			}
			@カメラ再セットチェック $b:w24a_カメラ破壊ロード回数[1]
			if ($f:再セットフラグ) {
				eval ($b:w24a_カメラ破壊フラグ[1] = d:FALSE)
			}
			@カメラ再セットチェック $b:w24a_カメラ破壊ロード回数[2]
			if ($f:再セットフラグ) {
				eval ($b:w24a_カメラ破壊フラグ[2] = d:FALSE)
			}
			@カメラ再セットチェック $b:w24a_カメラ破壊ロード回数[3]
			if ($f:再セットフラグ) {
				eval ($b:w24a_カメラ破壊フラグ[3] = d:FALSE)
			}
			@カメラ再セットチェック $b:w24a_カメラ破壊ロード回数[4]
			if ($f:再セットフラグ) {
				eval ($b:w24a_カメラ破壊フラグ[4] = d:FALSE)
			}
		}

		if( $w:ゲーム設定 == d:LEVEL_VERYEASY ) {
			@監視カメラ_右通路_南
		} else if( $w:ゲーム設定 == d:LEVEL_EASY ) {
			@監視カメラ_右通路_南
			@監視カメラ_入口
		} else if( $w:ゲーム設定 == d:LEVEL_NORMAL ) {
			@監視カメラ_右通路_南
			@監視カメラ_入口
			@監視カメラ_右通路_北
		} else if( $w:ゲーム設定 == d:LEVEL_HARD ) {
			@監視カメラ_右通路_南
			@監視カメラ_入口
			@監視カメラ_右通路_北
			@監視カメラ_左通路
		//} else if( $w:ゲーム設定 == d:LEVEL_EXTREME ) {
		} else {
			@監視カメラ_右通路_南
			@監視カメラ_入口
			@監視カメラ_右通路_北
			@監視カメラ_左通路
			@監視カメラ_右通路_真中
		}

		// 変装チェック用カメラ
		chara 非破壊カメラ 変装チェックカメラ \
			-pos 3000,2500,-73000 \
			-rot  0,0,0 \		/*ＸＹ値のみ有効*/
			-head 400,3548,0	/*ＸＹ値のみ有効*/

		if( $w:p_story >= d:ST:P069_04_R02ヴァンプ狙撃終了４無線機デモ２終了 ) {
			mesg 非破壊カメラ 変装チェックカメラ 消灯
		}
	}

/***************************************************************************************************/
// 警備兵
/***************************************************************************************************/

// 警備兵守備ポイント
	// 小部屋中央
	#define DEF_X_1	-10500
	#define DEF_Y_1	0
	#define DEF_Z_1	-55500
	// 左北角
	#define DEF_X_2	-10500
	#define DEF_Y_2	0
	#define DEF_Z_2	-69500
	// 右北門
	#define DEF_X_3	10500
	#define DEF_Y_3	0
	#define DEF_Z_3	-69500
	// 中央エレベーター前
	#define DEF_X_4	10500
	#define DEF_Y_4	0
	#define DEF_Z_4	-55000

	/////////////////////
	// 警備兵たち
		// 左舷守備兵
		proc 警備兵１ $:ルート $:守備位置Ｘ $:守備位置Ｙ $:守備位置Ｚ $:守備区域 {
			chara 警備兵 警備兵:01 \
				-r $:ルート -n 0 \
				-d $:守備位置Ｘ $:守備位置Ｙ $:守備位置Ｚ $:守備区域 \
				-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
				-l $w:敵標準体力 -h $w:敵標準聴力 -f $w:敵標準気絶 \
				-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
				-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
				-j ドッグタグ_敵兵	[ dogtag:plt_w24a_guard_ve_01 ] \
									[ dogtag:plt_w24a_guard_ea_01 ] \
									[ dogtag:plt_w24a_guard_no_01 ] \
									[ dogtag:plt_w24a_guard_ha_01 ] \
									[ dogtag:plt_w24a_guard_vh_01 ]
		}
		// 右舷守備兵Ｒ
		proc 警備兵２ $:ルート $:守備位置Ｘ $:守備位置Ｙ $:守備位置Ｚ $:守備区域 {
			chara 警備兵 警備兵:02 \
				-r $:ルート -n 0 \
				-d $:守備位置Ｘ $:守備位置Ｙ $:守備位置Ｚ $:守備区域 \
				-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
				-l $w:敵標準体力 -h $w:敵標準聴力 -f $w:敵標準気絶 \
				-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
				-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
				-j ドッグタグ_敵兵	[ dogtag:plt_w24a_guard_ve_02 ] \
									[ dogtag:plt_w24a_guard_ea_02 ] \
									[ dogtag:plt_w24a_guard_no_02 ] \
									[ dogtag:plt_w24a_guard_ha_02 ] \
									[ dogtag:plt_w24a_guard_vh_02 ]
		}
		// 右舷守備兵Ｌ
		proc 警備兵３ $:ルート $:守備位置Ｘ $:守備位置Ｙ $:守備位置Ｚ $:守備区域 {
			chara 警備兵 警備兵:03 \
				-r $:ルート -n 0 \
				-d $:守備位置Ｘ $:守備位置Ｙ $:守備位置Ｚ $:守備区域 \
				-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
				-l $w:敵標準体力 -h $w:敵標準聴力 -f $w:敵標準気絶 \
				-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
				-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
				-j ドッグタグ_敵兵	[ dogtag:plt_w24a_guard_ve_03 ] \
									[ dogtag:plt_w24a_guard_ea_03 ] \
									[ dogtag:plt_w24a_guard_no_03 ] \
									[ dogtag:plt_w24a_guard_ha_03 ] \
									[ dogtag:plt_w24a_guard_vh_03 ]
		}

		proc 警備兵４ $:ルート $:守備位置Ｘ $:守備位置Ｙ $:守備位置Ｚ $:守備区域 {
			chara 警備兵 警備兵:04 \
				-r $:ルート -n 0 \
				-d $:守備位置Ｘ $:守備位置Ｙ $:守備位置Ｚ $:守備区域 \
				-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
				-l $w:敵標準体力 -h $w:敵標準聴力 -f $w:敵標準気絶 \
				-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
				-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
				-j ドッグタグ_敵兵	[ dogtag:dummy ] \
									[ dogtag:dummy ] \
									[ dogtag:plt_w24a_guard_no_04 ] \
									[ dogtag:plt_w24a_guard_ha_04 ] \
									[ dogtag:plt_w24a_guard_vh_04 ]
		}

	/////////////////////
	// 警備兵プロック
	proc 警備兵０ {
		#if d:DEBUG_PRINT
			print 'watcher_set'
		#endif
		/*******************************************************************************************/
		// VERYEASY
		/*******************************************************************************************/
		if($w:ゲーム設定 <= d:LEVEL_VERYEASY) {
			if( $w:p_story < d:ST:P041_02_R01エイムズ死亡後２無線デモ１終了 ) {
				@警備兵１	1	d:DEF_X_1 d:DEF_Y_1 d:DEF_Z_1	シェル１中央棟１Ｆ
				@警備兵２	2	d:DEF_X_2 d:DEF_Y_2 d:DEF_Z_2	シェル１中央棟１Ｆ
				@警備兵３	3	d:DEF_X_3 d:DEF_Y_3 d:DEF_Z_3	シェル１中央棟１Ｆ
			} else {
				//@警備兵１	1	d:DEF_X_1 d:DEF_Y_1 d:DEF_Z_1	シェル１中央棟１Ｆ
				@警備兵２	2	d:DEF_X_2 d:DEF_Y_2 d:DEF_Z_2	シェル１中央棟１Ｆ
				@警備兵３	4	d:DEF_X_3 d:DEF_Y_3 d:DEF_Z_3	シェル１中央棟１Ｆ
			}
		/*******************************************************************************************/
		// EASY
		/*******************************************************************************************/
		} else if($w:ゲーム設定 <= d:LEVEL_EASY) {
			if( $w:p_story < d:ST:P041_02_R01エイムズ死亡後２無線デモ１終了 ) {
				@警備兵１	1	d:DEF_X_1 d:DEF_Y_1 d:DEF_Z_1	シェル１中央棟１Ｆ
				@警備兵２	2	d:DEF_X_2 d:DEF_Y_2 d:DEF_Z_2	シェル１中央棟１Ｆ
				@警備兵３	3	d:DEF_X_3 d:DEF_Y_3 d:DEF_Z_3	シェル１中央棟１Ｆ
			} else {
				@警備兵１	1	d:DEF_X_1 d:DEF_Y_1 d:DEF_Z_1	シェル１中央棟１Ｆ
				@警備兵２	2	d:DEF_X_2 d:DEF_Y_2 d:DEF_Z_2	シェル１中央棟１Ｆ
				@警備兵３	4	d:DEF_X_3 d:DEF_Y_3 d:DEF_Z_3	シェル１中央棟１Ｆ
			}
		/*******************************************************************************************/
		// NORMAL
		/*******************************************************************************************/
		} else if($w:ゲーム設定 <= d:LEVEL_NORMAL) {
			if( $w:p_story < d:ST:P041_02_R01エイムズ死亡後２無線デモ１終了 ) {
				@警備兵１	1	d:DEF_X_1 d:DEF_Y_1 d:DEF_Z_1	シェル１中央棟１Ｆ
				@警備兵２	2	d:DEF_X_2 d:DEF_Y_2 d:DEF_Z_2	シェル１中央棟１Ｆ
				@警備兵３	3	d:DEF_X_3 d:DEF_Y_3 d:DEF_Z_3	シェル１中央棟１Ｆ
				@警備兵４	5	d:DEF_X_4 d:DEF_Y_4 d:DEF_Z_4	シェル１中央棟１Ｆ
			} else {
				@警備兵１	1	d:DEF_X_1 d:DEF_Y_1 d:DEF_Z_1	シェル１中央棟１Ｆ
				@警備兵２	2	d:DEF_X_2 d:DEF_Y_2 d:DEF_Z_2	シェル１中央棟１Ｆ
				@警備兵３	4	d:DEF_X_3 d:DEF_Y_3 d:DEF_Z_3	シェル１中央棟１Ｆ
				@警備兵４	5	d:DEF_X_4 d:DEF_Y_4 d:DEF_Z_4	シェル１中央棟１Ｆ
			}
		/*******************************************************************************************/
		// HARD
		/*******************************************************************************************/
		} else if($w:ゲーム設定 <= d:LEVEL_HARD) {
			if( $w:p_story < d:ST:P041_02_R01エイムズ死亡後２無線デモ１終了 ) {
				@警備兵１	1	d:DEF_X_1 d:DEF_Y_1 d:DEF_Z_1	シェル１中央棟１Ｆ
				@警備兵２	2	d:DEF_X_2 d:DEF_Y_2 d:DEF_Z_2	シェル１中央棟１Ｆ
				@警備兵３	3	d:DEF_X_3 d:DEF_Y_3 d:DEF_Z_3	シェル１中央棟１Ｆ
				@警備兵４	5	d:DEF_X_4 d:DEF_Y_4 d:DEF_Z_4	シェル１中央棟１Ｆ
			} else {
				@警備兵１	1	d:DEF_X_1 d:DEF_Y_1 d:DEF_Z_1	シェル１中央棟１Ｆ
				@警備兵２	2	d:DEF_X_2 d:DEF_Y_2 d:DEF_Z_2	シェル１中央棟１Ｆ
				@警備兵３	4	d:DEF_X_3 d:DEF_Y_3 d:DEF_Z_3	シェル１中央棟１Ｆ
				@警備兵４	5	d:DEF_X_4 d:DEF_Y_4 d:DEF_Z_4	シェル１中央棟１Ｆ
			}
		/*******************************************************************************************/
		// EXTREME or EUROPEAN_EXTREME
		/*******************************************************************************************/
		} else {
			if( $w:p_story < d:ST:P041_02_R01エイムズ死亡後２無線デモ１終了 ) {
				@警備兵１	1	d:DEF_X_1 d:DEF_Y_1 d:DEF_Z_1	シェル１中央棟１Ｆ
				@警備兵２	2	d:DEF_X_2 d:DEF_Y_2 d:DEF_Z_2	シェル１中央棟１Ｆ
				@警備兵３	3	d:DEF_X_3 d:DEF_Y_3 d:DEF_Z_3	シェル１中央棟１Ｆ
				@警備兵４	5	d:DEF_X_4 d:DEF_Y_4 d:DEF_Z_4	シェル１中央棟１Ｆ
			} else {
				@警備兵１	1	d:DEF_X_1 d:DEF_Y_1 d:DEF_Z_1	シェル１中央棟１Ｆ
				@警備兵２	2	d:DEF_X_2 d:DEF_Y_2 d:DEF_Z_2	シェル１中央棟１Ｆ
				@警備兵３	4	d:DEF_X_3 d:DEF_Y_3 d:DEF_Z_3	シェル１中央棟１Ｆ
				@警備兵４	5	d:DEF_X_4 d:DEF_Y_4 d:DEF_Z_4	シェル１中央棟１Ｆ
			}
		}
	}

	proc 攻撃兵０ {
		#if d:DEBUG_PRINT
			print 'attacker_set'
		#endif

		chara アタッカー 攻撃兵:01 \
					-r 6 -c 10 \
					-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
					-l $w:敵標準体力 \
					-h $w:敵標準聴力 \
					-f $w:敵標準気絶 \
					-e d:ENE_EQUIP_TYPE_SHOTGUN

		chara アタッカー 攻撃兵:02 \
					-r 7 -c 11 \
					-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
					-l $w:敵標準体力 \
					-h $w:敵標準聴力 \
					-f $w:敵標準気絶 \
					-e d:ENE_EQUIP_TYPE_SHOTGUN

		chara アタッカー 攻撃兵:03 \
					-r 8 -c 12 \
					-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
					-l $w:敵標準体力 \
					-h $w:敵標準聴力 \
					-f $w:敵標準気絶 \
					-e d:ENE_EQUIP_TYPE_SHIELD

		chara アタッカー 攻撃兵:04 \
					-r 9 -c 13 \
					-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
					-l $w:敵標準体力 \
					-h $w:敵標準聴力 \
					-f $w:敵標準気絶 \
					-e d:ENE_EQUIP_TYPE_SHIELD
	}


	proc 警備兵コマンダー {
		#if d:DEBUG_PRINT
			print 'wccomm_set'
		#endif

		chara 警備コマンダー wccomm -e {警備兵０}
	}

	proc 攻撃兵コマンダー {
		#if d:DEBUG_PRINT
			print 'atcomm_set'
		#endif

		chara 攻撃コマンダー atcomm -avoidwait 300 -e 攻撃兵０
	}

resource ghq_area_alert_voice {
	w24a:
		$t{
			t:vc040234,	// 了解。バックアップをシェル１中央棟１Ｆエレベータ前に派遣する！奴を逃がすな！
			t:vc040235,	// 了解。増援部隊、シェル１中央棟１Ｆに向かえ！エレベータ前を固めろ！
			t:vc040240,	// 了解。増援部隊、シェル１中央棟１Ｆに向かえ！敵を逃がすな！
			t:vc040241,	// 了解。応援部隊をシェル１中央棟１Ｆに送る！敵を仕留めろ！
			-2,
			t:vc040236,	// 了解。増援部隊、シェル１中央棟１Ｆに急行！倉庫を包囲せよ！
			t:vc040237,	// 了解。応援部隊をシェル１中央棟１Ｆ倉庫に送る！敵を逃がすな！
			-2,
			t:vc040238,	// 了解。増援部隊をシェル１中央棟・ＥＦ連絡橋への扉付近に派遣する！侵入者を逃がすな！
			t:vc040239,	// 了解。応援部隊、シェル１中央棟へ向かえ！ＥＦ連絡橋への扉を守れ！
			-1
		}
	}

resource ghq_caution_voice {
	w24a:
		$t{
			t:vc040390, // 了解。シェル１中央棟１Ｆに増員を送る。エレベータ前を固めろ
			t:vc040391, // 了解。シェル１中央棟１Ｆエレベータ前を増員。警備を強化しろ
			t:vc040392, // 了解。シェル１中央棟１Ｆ倉庫を増員。警備を強化しろ
			t:vc040393, // 了解。シェル１中央棟１Ｆを増員。倉庫の警戒を強化しろ
			t:vc040394, // 了解。シェル１中央棟１Ｆ・ＥＦ連絡橋への扉付近を増員する。警備を強化しろ
			t:vc040395, // 了解。シェル１中央棟に増員を送る。ＥＦ連絡橋への扉を固めろ
			t:vc040396, // 了解。シェル１中央棟１Ｆに増員を派遣する。警備を強化しろ
			-2,	// 連絡が途絶えたときの確認要請台詞
			t:vc040432, // シェル１中央棟１Ｆとの連絡が途絶えた
			-3, // カメラ系が異常を発見したときの確認要請台詞
			t:vc040612,
			-1
		}
}
	proc コマンダー設定 {
		#if d:DEBUG_PRINT
			print 'commander_set'
		#endif
/*
		// エイムズ後は警戒モードでスタート
		if( $w:p_story >= d:ST:P041_02_R01エイムズ死亡後２無線デモ１終了 ) {
			eval( $w:スタートアラートモード = d:ALERT_MODE_TANSAKU )
		}
*/
		// CALL前は必ず潜入モードにする
		if( (!$f:rfp_スネークの遺体の話聞いた) && ($w:p_story < d:ST:P037_01_R01スネークの遺体１無線デモ１開始) ){
			eval($w:スタートアラートモード = d:ALERT_MODE_SENNYU)
		}

		chara コマンダー 敵兵セット \
			-w 警備兵コマンダー \
			-a 攻撃兵コマンダー \
			-m $w:スタートアラートモード \
//			-r 25000,-1500,-61000 シェル１中央棟１Ｆ \		// この座標は壁のど真ん中で危険なためずらします 2002.09.04 吉池
			-r 25000,-1500,-60500 シェル１中央棟１Ｆ \
			-c 22000,-1500,-60000 シェル１中央棟１Ｆ \
			-x [ghq_area_alert_voice:w24a] \
			-y [ghq_caution_voice:w24a] \
			-v [ene_plant_voice:01] \
			-p	 0,-1,-1 クリアリング初期設定 \
				-2,-2,-2 クリアリングカメラＯＦＦ \
			-z $i:敵標準麻酔持続 \
			-b $w:敵標準再発生数 \
			-h $i:標準警戒時間 \
			-o $i:敵標準気絶持続

		// エイムズ後は警戒レベル減らない
/*
		if( $w:p_story >= d:ST:P041_02_R01エイムズ死亡後２無線デモ１終了 ) {
			chara delay ディレイ -time 1 -exec{
				mesg コマンダー 敵兵セット 警戒レベル減らない
			}
		}
*/
		trap now_clearing d:PLAYER \
			-mask 出る \
			-exec {
				print '出ました'
				//mesg サブ画面 子画面 off
				@クリアリングカメラＯＦＦ
			}
	}



/***************************************************************************************************/
// クリアリング関連
/***************************************************************************************************/
	/*
	command セットクリアリング \
				-p $w:クリアリングエリア $w:ルート $w:ポイント $p:プロック ...4 \
				-i $w:ルート指定 ...
	*/

	proc クリアリングエリア内チェック {
		if( $i:プレイヤー位置Ｘ > -5250 && $i:プレイヤー位置Ｘ < 5250 ) {
			return 1;
		} else {
			return 0;
		}
	}

	proc クリアリング初期設定 {
		command rand 3
		print $status
		if( $status == 0 ) {
			command セットクリアリング \
				-p	0,0,1,クリアリングカメラ001 \
					0,0,4,クリアリングカメラ002 \
					0,0,10,クリアリングカメラ003 \
					0,0,17,クリアリングカメラ004 \
				-i	0,1,2,3
		} else if( $status == 1 ){
			command セットクリアリング \
				-p	0,4,1,クリアリングカメラ001 \
					0,4,4,クリアリングカメラ002 \
					0,4,10,クリアリングカメラ004 \
				-i	4,5,2,3
		} else {
			command セットクリアリング \
				-p	0,6,1,クリアリングカメラ002 \
					0,6,9,クリアリングカメラ003 \
					0,6,18,クリアリングカメラ004 \
				-i	6,7,2,3
		}
	}


	proc クリアリングカメラ001{
		#if d:CLE_CAMERA
			if( `@クリアリングエリア内チェック` ) {
				chara カメラ設定 クリアリングカメラ \
					-c 1 \
					-p 11092,4649,-46375 -t 6424,630,-48093 \
					-r 443,2842,0 -f 6395 \
					-a 200 \
					-i 0 -1 0 0 \
					-s 1

				command カメラマップ設定 \
					-chanl 1 \		// １が子画面
					-map シェル１中央棟１Ｆ

				mesg サブ画面 子画面 on
			}
		#endif
	}

	proc クリアリングカメラ002{
		#if d:CLE_CAMERA
			if( `@クリアリングエリア内チェック` ) {
				chara カメラ設定 クリアリングカメラ \
					-c 1 \
					-p -5337,4900,-46564 -t -1237,1919,-48167 \
					-r 388,1267,0 -f 5317 \
					-a 200 \
					-i 0 -1 0 0 \
					-s 1

				command カメラマップ設定 \
					-chanl 1 \		// １が子画面
					-map シェル１中央棟小部屋

				mesg サブ画面 子画面 on
			}
		#endif
	}

	proc クリアリングカメラ003{
		#if d:CLE_CAMERA
			if( `@クリアリングエリア内チェック` ) {
				chara カメラ設定 クリアリングカメラ \
					-c 1 \
					-p 4824,5379,-53424 -t 1939,3405,-52005 \
					-r 359,3370,0 -f 3772 \
					-a 200 \
					-i 0 -1 0 0 \
					-s 1

				command カメラマップ設定 \
					-chanl 1 \		// １が子画面
					-map シェル１中央棟小部屋

				mesg サブ画面 子画面 on
			}
		#endif
	}

	proc クリアリングカメラ004{
		#if d:CLE_CAMERA
			if( `@クリアリングエリア内チェック` ) {
				chara カメラ設定 クリアリングカメラ \
					-c 1 \
					-p -4034,4156,-50215 -t 2759,1087,-52379 \
					-r 265,1225,0 -f 7762 \
					-a 200 \
					-i 0 -1 0 0 \
					-s 1

				command カメラマップ設定 \
					-chanl 1 \		// １が子画面
					-map シェル１中央棟小部屋

				mesg サブ画面 子画面 on
			}
		#endif
	}

	proc クリアリングカメラＯＦＦ {
		#if d:CLE_CAMERA
			mesg サブ画面 子画面 off
			chara カメラ設定 クリアリングカメラ -s 0
		#endif
	}

	// ＢＧＭ
	// ------------------------------------
	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT
			print 'bgm_set'
		#endif

		if( $w:p_story >= d:ST:P069_04_R02ヴァンプ狙撃終了４無線機デモ２終了 ) {
			mesg サウンドマネージャー ＳＤマネ SD_CODE d:SNG_PLAY_06
		} else {
			chara ＢＧＭマネージャー ＢＧＭマネ
		}

	}

/***************************************************************************************************/
// 手前壁
/***************************************************************************************************/
	proc 手前壁 {
		#if d:DEBUG_PRINT
			print 'wall'
		#endif
		chara 天井君 南壁１ -m w24a0_wall1 -a 5 -c 0 0 -68150 -p 0,0,0 -l d:LT2_NAME
		chara 天井君 南壁２ -m w24a0_wall2 -a 5 -c 0 0 -46250 -p 0,0,0 -l d:LT2_NAME
	}

/***************************************************************************************************/
// ドア＆マップ切り替え関係
/***************************************************************************************************/

	// ロードドア
	proc ドア設置 {
		#if d:DEBUG_PRINT
			print 'slide_door_set'
		#endif
		// ドアの外のロード用モデル
		//chara プットオブジェ ロードモデル -m w24a_21a -r 0,0,0 -p 0,0,0 -s 100,100,100 -l w24a

	////////////////////
	// 左ドア（開かない）
		@ドアランプ設定 １Ｆ左ドアランプ d:EAST -19125 -1500 -54250 0
		chara ドア １Ｆ左ドア \
			-m w24a_dr00 \
			-d 0,1024,0 \
			-p -19125,-1500,-54250 \
			-slide d:SD_SLIDE_OUTSIDE \
			-time d:SD_OPEN_TIME \
			-lamp １Ｆ左ドアランプ \
			-card_level 9999 \
			-between シェル１中央棟１Ｆ シェル１中央棟１Ｆ \
			-exec {
			}
		trap dr001 ？ \
			-mask ？ \
			-exec {
					if($3==入る){
						//mesg ドア １Ｆ左ドア open
						command ＳＥセットモード -s d:SD_S_BUZZER01 -p -17000 0 -55000 -m 0

					}else{
						//mesg ドア １Ｆ左ドア close
					}
			}

		// 破壊エフェクト
		@壊れドアエフェクト設定 ドアパネル破壊エフェクト \
			1024 -19125,-1500,-54250 0



	////////////////////
	// 右ドア（w24a_21a）
		@ドアランプ設定 １Ｆ右ドアランプ d:EAST 19125 -1500 -54250 1

		chara ドア １Ｆ右ドア \
			-m w24a_dr00 \
			-d 0,d:EAST,0 \
			-p 19125,-1500,-54250 \
			-slide d:SD_SLIDE_OUTSIDE \
			-time d:SD_OPEN_TIME \
			-card_level 2 \
			-lamp １Ｆ右ドアランプ \
			-between シェル１中央棟１Ｆ シェル１中央棟１Ｆ \
			-exec {
			}
		trap dr002 ？ \
			-mask ？ \
			-exec {
				if($3==入る){
					mesg ドア １Ｆ右ドア open $2
				}else{
					mesg ドア １Ｆ右ドア close $2
				}
			}

	/////////////
	// 倉庫ドア
		@ドアランプ設定 １Ｆ倉庫左ドア d:WEST -5125 0 (-46750-1500) 2

		chara ドア 倉庫左ドア \
			-m dr_free \
			-d 0,d:WEST,0 \
			-p -5125,0,(-46750-1500) \
			-slide d:SD_SLIDE_INSIDE \
			-time d:SD_OPEN_TIME \
			-lamp １Ｆ倉庫左ドア \
//			-mapconnect \
			-between シェル１中央棟１Ｆ シェル１中央棟小部屋 \
			-exec {
				if( $:開閉フラグ == 0 ){
					mesg マップ接合 シェル１中央棟１Ｆ／シェル１中央棟小部屋左 off
				} else {
					mesg マップ接合 シェル１中央棟１Ｆ／シェル１中央棟小部屋左 on
				}
			}
		trap dr003 ？ \
			-mask ？ \
			-exec {
					if($3==入る){
						mesg ドア 倉庫左ドア open
					}else{
						mesg ドア 倉庫左ドア close
					}
			}

		@ドアランプ設定 １Ｆ倉庫右ドア d:WEST 5125 0 (-46750-1500) 2
		chara ドア 倉庫右ドア \
			-m dr_free \
			-d 0,d:WEST,0 \
			-p 5125,0,(-46750-1500) \
			-slide d:SD_SLIDE_INSIDE \
			-time d:SD_OPEN_TIME \
			-lamp １Ｆ倉庫右ドア \
//			-mapconnect \
			-between シェル１中央棟小部屋 シェル１中央棟１Ｆ \
			-exec {
				if( $:開閉フラグ == 0 ){
					mesg マップ接合 シェル１中央棟１Ｆ／シェル１中央棟小部屋右 off
				} else {
					mesg マップ接合 シェル１中央棟１Ｆ／シェル１中央棟小部屋右 on
				}
			}
		trap dr004 ？ \
			-mask ？ \
			-exec {
					if($3==入る){
						mesg ドア 倉庫右ドア open
					}else{
						mesg ドア 倉庫右ドア close
					}
			}
	}

	// 入出トラップ
	// ------------------------------------
	proc ロードプロック {
		#if d:DEBUG_PRINT
			print 'load_proc'
		#endif

		if ( $s:呼び出しプロック == mv_w24a_w15a_0 ) {
			// ＢＣ連絡橋へ
			@mv_w24a_w15a_0
		} else if ( $s:呼び出しプロック == mv_w24a_w21a_0 ) {
			// ＥＦ連絡橋へ
			if( $w:p_story >= d:ST:P069_04_R02ヴァンプ狙撃終了４無線機デモ２終了 ) {
				command セットサウンドコード -c d:SNG_FOUTS_S
			}
			@mv_w24a_w21a_0
		} else if ( $s:呼び出しプロック == mv_w24a_w24b_0 ) {
			// シェル１中央棟Ｂ１へ
			@mv_w24a_w24b_0
		} else if ( $s:呼び出しプロック == mv_w24a_w24d_0 ) {
			@mv_w24a_w24d_0
		}
	}

	proc ロード設定 {
		#if d:DEBUG_PRINT
			print 'load_set'
		#endif

	#if 0
		trap ld001 d:PLAYER \
			-mask 入る \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 1 ) {
					// ＢＣ連絡橋へ
					preseek 'w15a'
					@ステージ終了時処理 -19500 -1500 -55000 3072 mv_w24a_w15a_0 d:DEFAULT_M_TYPE
				}
			}
	#endif
		trap ld002 d:PLAYER \
			-mask 入る \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 1 ) {
					// ＥＦ連絡橋へ
					@爆弾タイマー残り時間保存

					preseek 'w21a'
					@ステージ終了時処理（ステージ名表示） 20500 -1500 -55000 1024 \
										mv_w24a_w21a_0 d:DEFAULT_M_TYPE d:wn_ＥＦ連絡橋
				}
			}
	}

/***************************************************************************************************/
// アイテム
/***************************************************************************************************/
#define item_エロ雑誌				0
#define	item_ソコムサプレッサー		1
#define item_Ｍ４弾					2
#define item_Ｍ９弾					3
#define item_チャフ					4
#define item_ソコム弾				5

#define item_エイムズ後_Ｍ９弾		6
#define item_エイムズ後_ソコム弾	7

#define item_Ｃ４					8
#define item_クレイモア				9

#define item_ＡＫＳ					10


	proc アイテム取得時番号設定 $:ボックス名 {
		#if d:DEBUG_PRINT
			print 'item_no_set'
		#endif

		// エロ雑誌
		if( $:ボックス名 == エロ雑誌 ) {
			eval( $b:w24a_取得ロード回数[ d:item_エロ雑誌 ] = $w:グローバルロード回数 );
		// ソコムサプレッサー
		} else if( $:ボックス名 == ソコムサプレッサー ) {
			eval( $b:w24a_取得ロード回数[ d:item_ソコムサプレッサー ] = $w:グローバルロード回数 );
		// Ｍ４弾
		} else if( $:ボックス名 == Ｍ４弾 ) {
			eval( $b:w24a_取得ロード回数[ d:item_Ｍ４弾 ] = $w:グローバルロード回数 );
		// Ｍ９弾
		} else if( $:ボックス名 == Ｍ９弾 ) {
			eval( $b:w24a_取得ロード回数[ d:item_Ｍ９弾 ] = $w:グローバルロード回数 );
		// チャフ
		} else if( $:ボックス名 == チャフ ) {
			eval( $b:w24a_取得ロード回数[ d:item_チャフ ] = $w:グローバルロード回数 );
		// ソコム弾
		} else if( $:ボックス名 == ソコム弾 ) {
			eval( $b:w24a_取得ロード回数[ d:item_ソコム弾 ] = $w:グローバルロード回数 );
		// エイムズ後_Ｍ９
		} else if( $:ボックス名 == エイムズ後_Ｍ９弾 ) {
			eval( $b:w24a_取得ロード回数[ d:item_エイムズ後_Ｍ９弾 ] = $w:グローバルロード回数 );
		// エイムズ後_ソコム弾
		} else if( $:ボックス名 == エイムズ後_ソコム弾 ) {
			eval( $b:w24a_取得ロード回数[ d:item_エイムズ後_ソコム弾 ] = $w:グローバルロード回数 );
		// Ｃ４
		} else if( $:ボックス名 == Ｃ４ ) {
			eval( $b:w24a_取得ロード回数[ d:item_Ｃ４ ] = $w:グローバルロード回数 );
		// クレイモア
		} else if( $:ボックス名 == クレイモア ) {
			eval( $b:w24a_取得ロード回数[ d:item_クレイモア ] = $w:グローバルロード回数 );
		// ＡＫＳ
		} else if( $:ボックス名 == クレイモア ) {
			eval( $b:w24a_取得ロード回数[ d:item_ＡＫＳ ] = $w:グローバルロード回数 );
		}
	}


	proc アイテム設置 {
		#if d:DEBUG_PRINT
			print 'item_set'
		#endif

		// エロ雑誌 ロッカー 左から２
		if( `@アイテム再セットチェック $b:w24a_取得ロード回数[ d:item_エロ雑誌 ]` ) {
			@雑誌_初期設置 エロ雑誌 -750 0 -45800 d:アイテム水飛沫無
		}

		// ソコムサプレッサー ロッカー 左から５
		if( $w:アイテム数Ｒ[ d:アイテム:ソコムサプレッサ ] == 0 ) {
			@ソコムサプレッサ_初期設置 ソコムサプレッサー 2250 0 -45825 d:アイテム水飛沫無
		}

		// Ｍ４弾
		if( `@アイテム再セットチェック $b:w24a_取得ロード回数[ d:item_Ｍ４弾 ]` ) {
			@弾薬_Ｍ４_初期設置 Ｍ４弾 -3750 0 -53250 d:アイテム水飛沫無
		}

		// Ｍ９弾
		if( `@アイテム再セットチェック $b:w24a_取得ロード回数[ d:item_Ｍ９弾 ]` ) {
			@弾薬_Ｍ９_初期設置 Ｍ９弾 -3750 0 -51250 d:アイテム水飛沫無
		}

		// チャフ
		if( `@アイテム再セットチェック $b:w24a_取得ロード回数[ d:item_チャフ ]` ) {
			@チャフ_初期設置 チャフ -1000 1000 -52000 d:アイテム水飛沫無
		}

		// ソコム弾
		if( `@アイテム再セットチェック $b:w24a_取得ロード回数[ d:item_ソコム弾 ]` ) {
			@弾薬_ソコム_初期設置 ソコム弾 -18500 -1500 -55750 d:アイテム水飛沫無
		}

		if( ($w:p_story >= d:ST:P041_02_R01エイムズ死亡後２無線デモ１終了) && \
			($w:p_story < d:ST:P069_04_R02ヴァンプ狙撃終了４無線機デモ２終了)	) {
			// エイムズ後_Ｍ９弾
			if( `@アイテム再セットチェック $b:w24a_取得ロード回数[ d:item_エイムズ後_Ｍ９弾 ]` ) {
				@弾薬_Ｍ９_初期設置 エイムズ後_Ｍ９弾 15750 -1500 -55750 d:アイテム水飛沫無
			}

			// エイムズ後_ソコム弾
			if( `@アイテム再セットチェック $b:w24a_取得ロード回数[ d:item_エイムズ後_ソコム弾 ]` ) {
				@弾薬_ソコム_初期設置 エイムズ後_ソコム弾 17250 -1500 -55750 d:アイテム水飛沫無
			}
		}

		// Ｃ４ ロッカー 左から１
		if( `@アイテム再セットチェック $b:w24a_取得ロード回数[ d:item_Ｃ４ ]` ) {
			@Ｃ４_初期設置 Ｃ４ -1750 0 -45825 d:アイテム水飛沫無
		}
		// クレイモア	左から４
		if( `@アイテム再セットチェック $b:w24a_取得ロード回数[ d:item_クレイモア ]` ) {
			@クレイモア_初期設置 クレイモア 1250 0 -45825 d:アイテム水飛沫無
		}
		// ＡＫＳ
		if($w:ゲーム設定 == d:LEVEL_VERYEASY) {
			if( `@アイテム再セットチェック $b:w24a_取得ロード回数[ d:item_ＡＫＳ ]` ) {
				@ＡＫＳ_初期設置 ＡＫＳ 2500 0 -49750 d:アイテム水飛沫無 ＡＫＳ弾薬
			}
		}

	}

/***************************************************************************************************/
// フォグ
/***************************************************************************************************/
	proc フォグ設定 {
		#if d:DEBUG_PRINT
			print 'fog_set'
		#endif

		chara フォグ 霧\
			-c 50, 75, 50 \
			-n 3000 \
			-f 40000
	}

	proc キャラ用ライト設置 {
		#if d:DEBUG_PRINT
			print 'chara_light_set'
		#endif

		chara 環境光 環境光源 \
			 -c 64 64 64

		chara 平行光 平行光源 \
			 -c 128 128 128 \
			 -p -2500 -3500 -2500
	}
/***************************************************************************************************/
// エフェクト関係
/***************************************************************************************************/
	proc エフェクト設定 {
		#if d:DEBUG_PRINT
			print 'effect_set'
		#endif

		#if d:BLUR
			chara ブラー ブラー
		#endif

		#if d:Z_MANAGER
			chara Ｚフォーカス管理 Z_manager
			mesg Ｚフォーカス管理 Z_manager パラメータ 5000 30
		#endif

		#if d:BODY_SHADOW
			chara ＯＦＦ制御 off_man
			mesg ＯＦＦ制御 off_man ボディシャドウＯＦＦ
		#endif

		#if d:MIRROR
			chara 鏡面モデル管理 床面映り込み \
				-pos 0,-50,0 \
				-axis 1 // Y軸反転
			trap mirror ？ -mask ？ \
			-exec {
				if( $3 == 入る ){
					mesg 鏡面モデル管理 床面映り込み add $2
				}else{
					mesg 鏡面モデル管理 床面映り込み del $2
				}
			}

		#endif
	}

// 各マップ別設定
// ------------------------------------
/***************************************************************************************************/
// 天井設置
/***************************************************************************************************/
	proc シェル１中央棟１Ｆ天井設置 {
		#if d:DEBUG_PRINT
			print 'w24a0_ceil_set'
		#endif

		chara 天井君 シェル１中央棟１Ｆ天井 -m w24a0r -h 3750 -p 0,0,0 -l d:LT2_NAME
		chara 天井君 シェル１中央棟小部屋天井 -m w24a1r -h 3750 -p 0,0,0 -l d:LT2_NAME
	}

/***************************************************************************************************/
// エレベーター設置
/***************************************************************************************************/

	proc 強制ドアクローズ終了_B1へ {
		#if d:DEBUG_PRINT
			print 'w31b_load_go'
		#endif

		if( $f:ロードチェックＯＮフラグ == 1 ) {
			preseek 'w24b'
			@ステージ終了時処理（ステージ名表示） 0 0 0 0 mv_w24a_w24b_0 d:NO_MOVE_M_TYPE d:wn_シェル１中央棟Ｂ１
		}
	}

	proc 強制ドアクローズ終了_B2へ {
		#if d:DEBUG_PRINT
			print 'no_load_go'
		#endif

		if( $f:ロードチェックＯＮフラグ == 1 ) {
			preseek 'w24d'
			@ステージ終了時処理（ステージ名表示） 0 0 0 0 mv_w24a_w24d_0 d:NO_MOVE_M_TYPE d:wn_シェル１中央棟Ｂ２電算室
		}
	}

	proc エレベータボタン押した終了 {
		print 'エレベータボタン押した終了'
			@Prエレベータボタン押したモーション終了
			chara カメラ設定 モーションカメラ -s -1
	}

	proc Prエレベータボタン押したモーション終了 {
		print 'Prエレベータボタン押したモーション終了'
		command パッド操作 -cancel
		@変装チェック
	}

	proc 変装イベント実行可能チェック {
		command ゲットゲームステータス $i:ゲームステータス
		if( !( $i:ゲームステータス & ( d:STATE_DETECT | d:STATE_CHAFF ) ) \
								&& ( $w:アラートモード != d:ALERT_MODE_KIKEN ) \
								&& ( $w:アラートモード != d:ALERT_MODE_KAIHI ) ) {
			if( `command エレベータ状態取得` == 0 ) {
				return 1
			}
		} else {
			return 0
		}
	}

	proc 変装チェック {

		print 'check'
		if( `@変装イベント実行可能チェック` ) {
			// ストリームデモを開始しても大丈夫かチェック
			if( `command StreamIsPlay` < 2 ) {
				print 'ストリームチェックＯＫです'
				@シナリオストリームデモ開始処理
				// 変装チェックデモでは敵兵の視界はON
				mesg コマンダー 敵兵セット 視界オン

				chara demo エレベータ変装チェックデモ -p ストリームカメラ開始処理 \
					-i t:scndemo_w24a \
					-no_state_demo \
					-begin エレベータ変装チェックデモ開始 \
					-next エレベータ変装チェックデモ終了 \
					-undraw 0

				eval( $i:STREAM_ID = $status );

			} else {
				if( ($w:武器 == d:武器:ＡＫＳ) && ( $w:アイテム == d:アイテム:ゴル兵制服 ) ) {
					print 'ストリームは２つ使用されています  変装は正しいのでドアオープン'
					mesg エレベータ 中央棟エレベーター open 60 エレベータードアオープン開始 エレベータードアオープン終了
					print '緑ランプもつけましょう'
					mesg 非破壊カメラ 変装チェックカメラ 緑点灯
				} else {
					print 'ストリームは２つ使用されています  変装間違ってます'
					mesg 非破壊カメラ 変装チェックカメラ 不正解ＳＥ
				}
			}
		}else{
			//mesg 非破壊カメラ 変装チェックカメラ 消灯
			command エレベータ状態取得
			if( $status == 0 ) {
				print 'エレベータは  閉じている'
				mesg 非破壊カメラ 変装チェックカメラ 赤色ランプ
			} else if( $status == 1 ) {
				print 'エレベータは  開き中、または開き待ち中'
				mesg 非破壊カメラ 変装チェックカメラ 緑色ランプ
			} else if( $status == 2 ) {
				print 'エレベータは  閉じ中'
				mesg 非破壊カメラ 変装チェックカメラ 赤色ランプ
			} else if( $status == 4 ) {
				command ゲットゲームステータス $i:ゲームステータス

				if( $i:ゲームステータス & d:STATE_CHAFF ) {
					print 'エレベータ  開き  チャフ'
					mesg 非破壊カメラ 変装チェックカメラ 赤色ランプ
				} else if( $w:アラートモード == d:ALERT_MODE_KIKEN ) {
					print 'エレベータ  開き  危険モード'
					mesg 非破壊カメラ 変装チェックカメラ 赤色ランプ
				} else if( $w:アラートモード == d:ALERT_MODE_KAIHI ) {
					print 'エレベータ  開き  回避モード'
					mesg 非破壊カメラ 変装チェックカメラ 赤色ランプ
				} else {
					print 'エレベータ  開き  潜入 OR 警戒'
					// エマ死亡デモ前はランプは変更しない
					if( $w:p_story < d:ST:P069_04_R02ヴァンプ狙撃終了４無線機デモ２終了 ) {
						mesg 非破壊カメラ 変装チェックカメラ 緑色ランプ
					}
				}
			} else {
				print 'そんな値は入らないはず？？'
				print '$status'$status
			}
			chara カメラ設定 シナリオカメラ -s -1
		}
	}

	proc エレベータ変装チェックデモ開始 {
		// MAXのデータから呼んでもらう予定（土田君に確認）
		//@ストリームカメラ開始処理

		chara デモキャンセルチェック Ch変装チェックキャンセル -p Pr変装チェックキャンセル

		@安全確認監視

		// チェック点灯
		chara delay 変装チェックカメラ点灯ディレイ -time 40 -exec {
			print 'ちかちか'
			mesg 非破壊カメラ 変装チェックカメラ ちかちか
		}
		chara delay 変装チェックカメラ点灯ディレイ -time 80 -exec {
			print '点滅'
			mesg 非破壊カメラ 変装チェックカメラ 点滅
		}

		if( ($w:武器 == d:武器:ＡＫＳ) && ( $w:アイテム == d:アイテム:ゴル兵制服 ) ) {
			print '変装OK'
			chara delay 変装チェックカメラ点灯ディレイ -time 280 -exec {
				print '緑点灯'
				mesg 非破壊カメラ 変装チェックカメラ 緑点灯
			}
			chara delay 変装チェックカメラ点灯ディレイ -time 360 -exec {
				print 'エレベータ 開け'
				mesg エレベータ 中央棟エレベーター open 1 エレベータードアオープン開始 エレベータードアオープン終了

				chara プロック連続実行 エレベータチェック -time -1 -exec {
					command エレベータ状態取得
					if( $status == 2 ) {
						print 'エレベータ閉じた  赤ランプ点灯'
						mesg 非破壊カメラ 変装チェックカメラ 赤色ランプ
						mesg プロック連続実行 エレベータチェック kill
					}
				}
			}
		} else {
			chara delay 変装チェックカメラ点灯ディレイ -time 280 -exec {
				print '間違った変装です'
				mesg 非破壊カメラ 変装チェックカメラ 赤点灯
			}
			chara delay 変装チェックカメラ点灯ディレイ -time 360 -exec {
				print 'ブッブー'
				mesg 非破壊カメラ 変装チェックカメラ 不正解ＳＥ
			}
		}
	}

	proc エレベータ変装チェックデモ終了 {
		if ( `command ゲームオーバーチェック` == 0 ) {
			mesg デモキャンセルチェック Ch変装チェックキャンセル kill
			@シナリオデモ終了処理
		}
	}

	proc 安全確認監視 {
		chara プロック連続実行 安全確認連続実行 -time -1 -exec {
			command ゲットゲームステータス $i:ゲームステータス

			if( ( $i:ゲームステータス & d:STATE_DETECT ) \
							|| ( $w:アラートモード == d:ALERT_MODE_KIKEN ) \
							|| ( $w:アラートモード == d:ALERT_MODE_KAIHI ) \
							|| ( $i:ゲームステータス & d:STATE_CHAFF ) ) {

				print ( $i:ゲームステータス & d:STATE_DETECT ) ':発見から危険'
				print ( $w:アラートモード == d:ALERT_MODE_KIKEN ) ':危険'
				print ( $i:ゲームステータス & d:STATE_CHAFF ) ':チャフ'

				print '安全確認監視  危険です'
				mesg プロック連続実行 安全確認連続実行 kill
				@Pr変装チェックキャンセル終了処理
				mesg 非破壊カメラ 変装チェックカメラ 赤色ランプ
			}
		}
	}

	proc Pr変装チェックキャンセル {

		@Pr変装チェックキャンセル終了処理

		if( ($w:武器 == d:武器:ＡＫＳ) && ( $w:アイテム == d:アイテム:ゴル兵制服 ) ) {
			print 'キャンセルされて緑色'
			mesg エレベータ 中央棟エレベーター open 60 エレベータードアオープン開始 エレベータードアオープン終了
			mesg 非破壊カメラ 変装チェックカメラ 緑色ランプ
		} else {
			print 'キャンセルされて赤色'
			mesg 非破壊カメラ 変装チェックカメラ 不正解ＳＥ
		}
	}

	proc Pr変装チェックキャンセル終了処理 {
		//command StreamStopAll
		command StreamStop $i:STREAM_ID
		mesg delay 変装チェックカメラ点灯ディレイ kill
//		mesg 非破壊カメラ 変装チェックカメラ 消灯
	}

	proc エマ狙撃後エレベータを開けておく {
		if( $w:p_story >= d:ST:P069_04_R02ヴァンプ狙撃終了４無線機デモ２終了 ) {
			mesg エレベータ 中央棟エレベーター alwaysopen
			trap demo d:PLAYER \
				-mask 入る \
				-exec {
					if (`command ゲームオーバーチェック` == 0 ) {
						@シナリオデモ開始処理
						// タイマー停止
						command セットタイマーステータス -s d:TMR_WAIT

						mesg プレイヤー d:PLAYER run 0 0 -74250 \
							1 \ // 走り移動
							2048 \
							( d:FA_NO_INTERP | d:FA_BOX_EXIST ) \
							エレベータクローズしてデモへ

						chara delay ロードディレイ -time 1 -exec {
							chara カメラ設定 シナリオカメラ \
								-c 1 \
								-p -476,2128,-69591 -t 106,1206,-73779 \
								-r 140,1958,0 -f 4328 \
								-a 200 \
								-i 0 0 0 0 \
								-s 1
						}
					}
				}
		}
	}
	proc エレベータクローズしてデモへ {
		mesg エレベータ 中央棟エレベーター close ダミープロック フェードアウトプロック

		command セットサウンドコード -c d:SNG_FOUTS_S
	}

	proc フェードアウトプロック {
		chara フェードインアウト フェードアウト \
			-c 0,0,0 128 \
			-t d:FADEOUT_TIME \
			-p エマ死亡デモへ
	}

	proc エマ死亡デモへ {
		@mv_P070_01_P01_0
	}

/***************************************************************************************************/
// ロッカー関係
/***************************************************************************************************/
	proc ロッカーチェック $:番号 {
		@壊れ物再セットチェック $b:w24a_破壊ロード回数[$:番号]
		if($f:再セットフラグ) {
			eval($i:w24a_ロッカーロード回数[$:番号] = 0)
		}
	}

	proc ロッカー状態保存 $:番号 $:行動 $:ロッカー名 {
		if(($:行動 != 6) && ($:行動 != 8)) {
			// 状態変化時
			eval($b:w24a_破壊ロード回数[$:番号] = $w:グローバルロード回数);
		} else if($:行動 == 8) {
			// ステージ終了時
			command ロッカー状態 -n $:ロッカー名
			eval($i:w24a_ロッカーロード回数[$:番号] = $status)
		}
	}

	proc ロッカー設置 {
		#if d:DEBUG_PRINT
			print 'w24a_locker_set'
		#endif

		chara ロッカー管理 管理人さん -n 9
		command ロッカーモーション -motion locker
		command プレイヤーロッカーモーション -motion sna_locker

	///////////////////
	// 北側

		// 左側一番上
		@ロッカーチェック 0
		chara ロッカー ロッカー:01 \
			//-kms neo_locker_door \
			-kms w24a1_locker1_dr \
			-seno 4 \
			-sefloor 4 \
			-p -3500,0,-53700 \
			-r 0,1024,0 \
			-down_shift -200 0 0 \
			-s d:LOCKER_STATE_DESTROY \
			-f d:LOCKER_FLAG_DOWNOUTSIDE \
			-load_state $i:w24a_ロッカーロード回数[0] \
			-exec {
				@ロッカー状態保存 0 $3 $4
			}
		trap lk001 d:PLAYER \
			-and \
			-mask いる \
			-state 0,4 \
			-dir 3072,512 1024,512 \
			-button d:ACTION_BUTTON,-1 \
			-exec {
				command ロッカー状態 -n ロッカー:01
				mesg プレイヤー d:PLAYER locker ロッカー:01 $status 3072,512 -3400,-51950
			}
		trap lk001 d:PLAYER \
			-mask ？ \
			-state 6 \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 261,4510,-50961 -t -2116,2144,-52347 \
					-r 463,2728,0 -f 3629 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3
			}

		// 左側中央 アイズポスター
		@ロッカーチェック 1
		chara ロッカー ロッカー:02 \
			-kms w24a1_eyes3_dr \
			-seno 4 \
			-sefloor 4 \
			-p -3500,0,-52700 \
			-r 0,1024,0 \
			-down_shift -200 0 0 \
//			-s d:LOCKER_STATE_POSTER \
			-g 	-250,700,0 -750,1700,0 \
				-300,1250,0 -600,1550,0 \
				-350,850,0 -550,1100,0 \
			-load_state $i:w24a_ロッカーロード回数[1] \
			-exec {
				@ロッカー状態保存 1 $3 $4
			}
		trap lk002 d:PLAYER \
			-and \
			-mask いる \
			-state 0,4 \
			-dir 3072,512 1024,512 \
			-button d:ACTION_BUTTON,-1 \
			-exec {
				command ロッカー状態 -n ロッカー:02
				mesg プレイヤー d:PLAYER locker ロッカー:02 $status 3072,512 -3400,-50950
			}
		trap lk002 d:PLAYER \
			-mask ？ \
			-state 6 \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p -16,4391,-50287 -t -2236,1902,-51712 \
					-r 493,2700,0 -f 3627 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3
			}

		// 左側一番右
		@ロッカーチェック 2
		chara ロッカー ロッカー:03 \
			-kms w24a1_locker3_dr \
			-seno 4 \
			-sefloor 4 \
			-p -3500,0,-51700 \
			-r 0,1024,0 \
			-down_shift -200 0 0 \
			-s 0 \
			-load_state $i:w24a_ロッカーロード回数[2] \
			-exec {
				@ロッカー状態保存 2 $3 $4
			}
		trap lk003 d:PLAYER \
			-and \
			-mask いる \
			-state 0,4 \
			-dir 3072,512 1024,512 \
			-button d:ACTION_BUTTON,-1 \
			-exec {
				command ロッカー状態 -n ロッカー:03
				mesg プレイヤー d:PLAYER locker ロッカー:03 $status 3072,512 -3400,-49950
			}
		trap lk003 d:PLAYER \
			-mask ？ \
			-state 6 \
			-camera \			// カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p -680,4391,-48772 -t -2303,1913,-50858 \
					-r 491,2479,0 -f 3623 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3
			}


	////////////////
	// 南側

		// 下側一番左
		@ロッカーチェック 3
		chara ロッカー ロッカー:04 \
			-kms w24a1_locker1_dr \
			-seno 4 \
			-sefloor 4 \
			-p (-2450+250),0,-46125 \
			-r 0,2048,0 \
			-s 0 \
			-load_state $i:w24a_ロッカーロード回数[3] \
			-exec {
				@ロッカー状態保存 3 $3 $4
			}
		trap lk004 d:PLAYER \
			-and \
			-mask いる \
			-state 0,4 \
			-dir 0,512 2048,512 \
			-button d:ACTION_BUTTON,-1 \
			-exec {
				command ロッカー状態 -n ロッカー:04
				mesg プレイヤー d:PLAYER locker ロッカー:04 $status 0,512 (-2450+250),-46100
			}
		trap lk004 d:PLAYER \
			-mask ？ \
			-state 6 \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p -289,3730,-50386 -t -1950,1570,-47074 \
					-r 344,3793,0 -f 4288 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3
			}

		// 下側左から２番目
		@ロッカーチェック 4
		chara ロッカー ロッカー:05 \
			-kms w24a1_locker3_dr \
			-seno 4 \
			-sefloor 4 \
			-p (-1450+250),0,-46125 \
			-r 0,2048,0 \
			-s 0 \
			-load_state $i:w24a_ロッカーロード回数[4] \
			-exec {
				@ロッカー状態保存 4 $3 $4
			}
		trap lk005 d:PLAYER \
			-and \
			-mask いる \
			-state 0,4 \
			-dir 0,512 2048,512 \
			-button d:ACTION_BUTTON,-1 \
			-exec {
				command ロッカー状態 -n ロッカー:05
				mesg プレイヤー d:PLAYER locker ロッカー:05 $status 0,512 (-1450+250),-46100
			}
		trap lk005 d:PLAYER \
			-mask ？ \
			-state 6 \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 901,3386,-50066 -t -902,1393,-47160 \
					-r 344,3734,0 -f 3958 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3
			}

		// 下側左から３番目	アイズポスター
		@ロッカーチェック 5
		chara ロッカー ロッカー:06 \
			-kms w24a1_eyes2_dr \
			-seno 4 \
			-sefloor 4 \
			-p (-450+250),0,-46125 \
			-r 0,2048,0 \
//			-s ( d:LOCKER_STATE_POSTER ) \
			-g 	-250,700,0 -750,1700,0 \
				-300,1250,0 -600,1550,0 \
				-350,850,0 -550,1100,0 \
			-flag d:LOCKER_FLAG_DOWNOUTSIDE \
			-load_state $i:w24a_ロッカーロード回数[5] \
			-exec {
				@ロッカー状態保存 5 $3 $4
			}
		trap lk006 d:PLAYER \
			-and \
			-mask いる \
			-state 0,4 \
			-dir 0,512 2048,512 \
			-button d:ACTION_BUTTON,-1 \
			-exec {
				command ロッカー状態 -n ロッカー:06
				mesg プレイヤー d:PLAYER locker ロッカー:06 $status 0,512 (-450+250),-46100
			}
		trap lk006 d:PLAYER \
			-mask ？ \
			-state 6 \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 1641,3415,-49572 -t -76,1192,-46786 \
					-r 389,3736,0 -f 3956 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3
			}

		// 下側右から３番目
		@ロッカーチェック 6
		chara ロッカー ロッカー:07 \
			-kms w24a1_locker2_dr \
			-seno 4 \
			-sefloor 4 \
			-p (550+250),0,-46125 \
			-r 0,2048,0 \
			-s 0 \
			-load_state $i:w24a_ロッカーロード回数[6] \
			-exec {
				@ロッカー状態保存 6 $3 $4
			}
		trap lk007 d:PLAYER \
			-and \
			-mask いる \
			-state 0,4 \
			-dir 0,512 2048,512 \
			-button d:ACTION_BUTTON,-1 \
			-exec {
				command ロッカー状態 -n ロッカー:07
				mesg プレイヤー d:PLAYER locker ロッカー:07 $status 0,512 (550+250),-46100
			}
		trap lk007 d:PLAYER \
			-mask ？ \
			-state 6 \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 2784,3175,-49061 -t 1072,952,-46273 \
					-r 389,3737,0 -f 3955 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3
			}

		// 下側右から２番目	// アイズポスター
		@ロッカーチェック 7
		chara ロッカー ロッカー:08 \
			//-kms w24a1_locker1_dr \
			-kms w24a1_eyes1_dr \
			-seno 4 \
			-sefloor 4 \
			-p (1550+250),0,-46125 \
			-r 0,2048,0 \
			-s 0 \
			-load_state $i:w24a_ロッカーロード回数[7] \
			-exec {
				@ロッカー状態保存 7 $3 $4
			}
		trap lk008 d:PLAYER \
			-and \
			-mask いる \
			-state 0,4 \
			-dir 0,512 2048,512 \
			-button d:ACTION_BUTTON,-1 \
			-exec {
				command ロッカー状態 -n ロッカー:08
				mesg プレイヤー d:PLAYER locker ロッカー:08 $status 0,512 (1550+250),-46100
			}
		trap lk008 d:PLAYER \
			-mask ？ \
			-state 6 \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 3453,2983,-49758 -t 2050,1568,-47074 \
					-r 285,3782,0 -f 3343 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3
			}


		// 下側一番右
		@ロッカーチェック 8
		chara ロッカー ロッカー:09 \
			-kms w24a1_locker2_dr \
			-seno 4 \
			-sefloor 4 \
			-p (2550+250),0,-46125 \
			-r 0,2048,0 \
			-s 0 \
			-load_state $i:w24a_ロッカーロード回数[8] \
			-exec {
				@ロッカー状態保存 8 $3 $4
			}
		trap lk009 d:PLAYER \
			-and \
			-mask いる \
			-state 0,4 \
			-dir 0,512 2048,512 \
			-button d:ACTION_BUTTON,-1 \
			-exec {
				command ロッカー状態 -n ロッカー:09
				mesg プレイヤー d:PLAYER locker ロッカー:09 $status 0,512 (2550+250),-46100
			}
		trap lk009 d:PLAYER \
			-mask ？ \
			-state 6 \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 3945,3410,-48329 -t 3050,1566,-47074 \
					-r 570,3692,0 -f 2403 \
					-a 200 \
