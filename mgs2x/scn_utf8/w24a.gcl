	// 強制モーション用トラップ
	// ------------------------------------
	// ジャンプ設定
	// ------------------------------------
	proc シェル１中央棟１Ｆジャンプ設定 {
		#if d:DEBUG_PRINT
			print 'w24a_jump_set'
		#endif

		trap ky001 d:PLAYER \
			-mask 入る \
			-exec {
				@ジャンプ発動 ky001 1000 10
			}
	}

	// 透明壁の設定
	// ------------------------------------
	proc ５０ｃｍ隙間透明壁設置 {
		#if d:DEBUG_PRINT
			print 'w24a_tr_wall_set'
		#endif

		@南北５０ｃｍ幅透明壁設置 中央左側 -1400 0 -54000 2000
		@南北５０ｃｍ幅透明壁設置 中央右側 1600 0 -54000 2000

		trap wallto d:PLAYER \
			-mask ？ \
			//-state d:TRP_STATE_CAUTION \
			-state d:TRP_STATE_BEHINDCAMERA_ENABLE \
			-exec {
					if ($3 == 入る) {
						mesg 透明壁 中央左側 off
						mesg 透明壁 中央右側 off
					} else {
						mesg 透明壁 中央左側 on
						mesg 透明壁 中央右側 on
					}
				}

		trap wallto d:PLAYER \
			-mask * \
			-camera \
			-dir 0 256 \
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p $4,8525,-52179 -t $4,1422,-53055 \
					-r 944,2048,0 -f 7157 \
					-a 307 \
					-i 2 2 0 0 \
					-s $3
			}

	}

/***************************************************************************************************/
// 消火器設置
/***************************************************************************************************/

	proc 消火器設置 {
		chara 消火器 消火器１ \
			-r 0 1024 0 \
			-p -3400 0 -45650 \
			-l w24a \
			-b (-3400-2000) 0 -50000 \
			   (-3400+8000) 2000 -45650
	}

/***************************************************************************************************/
// 子画面設定
/***************************************************************************************************/
	proc 子画面設定 {
		#if d:DEBUG_PRINT
			print 'sub_camera_set'
		#endif

		//chara サブ画面 子画面 -w (512-d:SUB_MARGIN-d:SUB_WIDTH),d:SUB_MARGIN (512-d:SUB_MARGIN),(d:SUB_HEIGHT+d:SUB_MARGIN)
		chara サブ画面 子画面
	}

/***************************************************************************************************/
// 各種カメラの設定
/***************************************************************************************************/

	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0
		chara カメラ 通路カメラ１		-c 0 -l 2 -p 50
		chara カメラ 通路カメラ０		-c 0 -l 2 -p 40
		chara カメラ モーションカメラ	-c 0 -l 2 -p 30
		chara カメラ ノードカメラ		-c 0 -l 2 -p 20
		chara カメラ シナリオカメラ		-c 0 -l 2 -p 10

		chara カメラ クリアリングカメラ	-c 1 -l 2 -p 0

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 750,2048,0 \
			-f 6500 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}

	proc シェル１中央棟１Ｆカメラ設定 {
		#if d:DEBUG_PRINT
			print 'w24a_camera_set'
		#endif

	// 右舷
		// 右舷ロード通路
		trap c001R d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				/*
					-p 13182,4999,-53809 -t 13182,775,-55133 \
					-r 826,2048,0 -f 4426 \
					-a 200 \

					-p 17271,4996,-53803 -t 17271,775,-55133 \
					-r 825,2048,0 -f 4425 \
					-a 200 \
				*/
				chara カメラ設定 通路カメラ１ \
					-c 0 \
					-b 13182,4999,-53809  17271,4996,-53803 \
					-l 13182,775,-55133  17271,775,-55133 \
					-r 823,2048,0 -f 4440 \
					-a 200 \
					-i 0 0 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// 右舷南北通路
		trap c002R d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				if( $3 == 入る ) {
					if( $6 > -50000 ) {
						eval( $w:補完方式 = 3 )		// 北から進入した場合の値は代入されている
					}
				}
				chara カメラ設定 通路カメラ１ \
					-c 0 \
					-b 10159,2000,/*-56139*/d:CAM_MIN  10159,2000,-43454 \
					-l 10159,1400,/*-63706*/d:CAM_MIN  10159,1400,-51021 \
					-r 89,2048,0 -f 8991 \
					-a 200 \
					-i $w:補完方式 -1 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-slide 1 0 10000 7500 80 0 \
					-s $3
			}

		// 右舷 南小通路
		trap c003R d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				if( $3 == 入る ) {
					eval( $i:進入位置Ｘ = $i:前フレーム位置Ｘ )
				}
				if( $i:進入位置Ｘ < 5125 ) {
					eval( $w:補完方式 = 0 )
				} else {
					eval( $w:補完方式 = 3 )
				}

				if( $4 > 9250 ) {
					@CS_スムーズカメラ昇順 $4 9250 11250 8000 10159
					eval( $i:補完ＢＸ１ = $i:CS_結果１ )
				} else {
					eval( $i:補完ＢＸ１ = 6726 )
				}

				if( $4 < 7000 ) {
					@CS_スムーズカメラ昇順 $4 5750 7000 6726 8000
					eval( $i:補完ＢＸ２ = $i:CS_結果１ )
				} else {
					eval( $i:補完ＢＸ２ = 10159 )
				}

				chara カメラ設定 通路カメラ１ \
					-c 0 \
					-b $i:補完ＢＸ１,2000,-56139  $i:補完ＢＸ２,2000,-43454 \
					-l $i:補完ＢＸ１,1400,-63706  $i:補完ＢＸ２,1400,-51021 \
					-r 89,2048,0 -f 8991 \
					-a 200 \
					-i $w:補完方式 -1 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-slide 0 0 1000 1000 50 0 \
					-s $3
			}

		// 右舷 角
		trap c004R d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				if( $3 == 入る)	{
					eval( $i:進入位置Ｘ = $i:前フレーム位置Ｘ )
				}

				if( $i:進入位置Ｘ < 9250 ) {
					// ca002のカメラに同調
					chara カメラ設定 通路カメラ１ \
						-c 0 \
						-b 10159,2000,/*-56139*/d:CAM_MIN  10159,2000,-43454 \
						-l 10159,1400,/*-63706*/d:CAM_MIN  10159,1400,-51021 \
						-r 89,2048,0 -f 8991 \
						-a 200 \
						-i 0 -1 0 0 \
						-z d:CAMERA_NO_CUSHION \
						-slide 1 0 10000 7500 80 0 \
						-s $3

					eval( $w:補完方式 = 3 ) 	// ca002で使用
					eval( $w:補完方式１ = 0 ) 	// c001Cで使用
				} else {
					// c001Cのカメラに同調
					chara カメラ設定 通路カメラ１ \
						-c 0 \
						-b -10060,6567,-68598  10060,6567,-68598 \
						-l -10060,1520,-69970  10060,1520,-69970 \
						-r 851,2048,0 -f 5230 \
						-a 200 \
						-i 0 -1 0 0 \
						-slide 0 20 1500 1500 80 \
						-s $3

					eval( $w:補完方式 = 0 ) 	// ca002で使用
					eval( $w:補完方式１ = 3 ) 	// c001Cで使用
				}
			}

		// 張り付き時のカメラ
		trap c003R d:PLAYER \
			-mask ？ \
			-camera \
			-dir 2048 256 \
			//-state d:TRP_STATE_CAUTION \
			-state d:TRP_STATE_BEHINDCAMERA_ENABLE \
			-exec {
				chara カメラ設定 通路カメラ０ \
					-c 0 \
					-b 6833,7019,-46513  9443,7019,-46513 \
					-l 6833,763,-48152  9458,763,-48152 \
					-r 863,2042,0 -f 6472 \
					-a 200 \
					-i 2 2 0 0 \
					-s $3
			}

		// 匍匐時のカメラ
		trap c003R d:PLAYER \
			-mask ？ \
			-camera \
			-state d:TRP_STATE_GROUND \
			-exec {
				chara カメラ設定 通路カメラ０ \
					-c 0 \
					-b 7164,2383,-43305  9745,2383,-43305 \
					-l 7164,1234,-46800  9745,1234,-46800 \
					-r 863,2042,0 -f 6472 \
					-a 200 \
					-i 3 3 0 0 \
					-s $3
			}

	// 左舷
		// 左舷ロード通路
		trap c001L d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 通路カメラ１ \
					-c 0 \
					-b -17011,5542,-53738  -13560,5538,-53730 \
					-l -17011,-332,-55649  -13560,-332,-55649 \
					-r 818,2048,0 -f 6176 \
					-a 200 \
					-i 0 0 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// 左舷南北通路
		trap c002L d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				if( $3 == 入る ) {
					if( $6 > -50000 ) {
						eval( $w:補完方式 = 3 )		// 北から進入した場合の値は代入されている
					}
				}
				chara カメラ設定 通路カメラ１ \
					-c 0 \
					-b -10159,2000,d:CAM_MIN  -10159,2000,-43454 \
					-l -10159,1400,d:CAM_MIN  -10159,1400,-51021 \
					-r 89,2048,0 -f 8991 \
					-a 200 \
					-i $w:補完方式 -1 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-slide 1 0 10000 7500 80 0 \
					-s $3
			}

		// 左舷 南小通路
		trap c003L d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				if( $3 == 入る ) {
					eval( $i:進入位置Ｘ = $i:前フレーム位置Ｘ )
				}

				if( $i:進入位置Ｘ > -5125 ) {
					eval( $w:補完方式 = 0 )
				} else {
					eval( $w:補完方式 = 3 )
				}

				if( $4 < -9250 ) {
					@CS_スムーズカメラ昇順 $4  -11250 -9250  -10159 -8000
					eval( $i:補完ＢＸ１ = $i:CS_結果１ )
				} else {
					eval( $i:補完ＢＸ１ = -6726 )
				}

				if( $4 > -7000 ) {
					@CS_スムーズカメラ昇順 $4  -7000 -5750  -8000 -6726
					eval( $i:補完ＢＸ２ = $i:CS_結果１ )
				} else {
					eval( $i:補完ＢＸ２ = -10159 )
				}

				chara カメラ設定 通路カメラ１ \
					-c 0 \
					-b $i:補完ＢＸ２,2000,-56139  $i:補完ＢＸ１,2000,-43454 \
					-l $i:補完ＢＸ２,1400,-63706  $i:補完ＢＸ１,1400,-51021 \
					-r 89,2048,0 -f 8991 \
					-a 200 \
					-i $w:補完方式 -1 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-slide 0 0 1000 1000 50 0 \
					-s $3
			}


		// 張り付き時のカメラ
		trap c003L d:PLAYER \
			-mask ？ \
			-camera \
			-dir 2048 256 \
			//-state d:TRP_STATE_CAUTION \
			-state d:TRP_STATE_BEHINDCAMERA_ENABLE \
			-exec {
				chara カメラ設定 通路カメラ０ \
					-c 0 \
					-b -9443,7019,-46513  -6833,7019,-46513 \
					-l -9458,763,-48152  -6833,763,-48152 \
					-r 863,2042,0 -f 6472 \
					-a 200 \
					-i 2 2 0 0 \
					-s $3
			}

		// 匍匐時のカメラ
		trap c003L d:PLAYER \
			-mask ？ \
			-camera \
			-state d:TRP_STATE_GROUND \
			-exec {
				chara カメラ設定 通路カメラ０ \
					-c 0 \
					-b -9745,2383,-43305  -7164,2383,-43305 \
					-l -9745,1234,-46800  -7164,1234,-46800 \
					-r 863,2042,0 -f 6472 \
					-a 200 \
					-i 3 3 0 0 \
					-s $3
			}

		// 左舷 角
		trap c004L d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				if( $3 == 入る)	{
					eval( $i:進入位置Ｘ = $i:前フレーム位置Ｘ )
				}

				if( $i:進入位置Ｘ > -9250 ) {
					// ca002のカメラに同調
					chara カメラ設定 通路カメラ１ \
						-c 0 \
						-b -10159,2000,d:CAM_MIN  -10159,2000,-43454 \
						-l -10159,1400,d:CAM_MIN  -10159,1400,-51021 \
						-r 89,2048,0 -f 8991 \
						-a 200 \
						-i 0 -1 0 0 \
						-z d:CAMERA_NO_CUSHION \
						-slide 1 0 10000 7500 80 0 \
						-s $3

					eval( $w:補完方式 = 3 ) 	// ca002で使用
					eval( $w:補完方式１ = 0 ) 	// c001Cで使用
				} else {
					// c001Cのカメラに同調
					chara カメラ設定 通路カメラ１ \
						-c 0 \
						-b -10060,6567,-68598  10060,6567,-68598 \
						-l -10060,1520,-69970  10060,1520,-69970 \
						-r 851,2048,0 -f 5230 \
						-a 200 \
						-i 0 -1 0 0 \
						-slide 0 20 1500 1500 80 \
						-s $3

					eval( $w:補完方式 = 0 ) 	// ca002で使用
					eval( $w:補完方式１ = 3 ) 	// c001Cで使用
				}
			}

	///////////////////
	// 中央
		// エレベーター前通路
		trap c003C d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				chara カメラ設定 通路カメラ１ \
					-c 0 \
					-b -10060 6665 -68489  10060 6665 -68489 \
					-l -10060 1520 -70026  10060 d:CAM_MAX -70026 \
					-r 835,2048,0 -f 5558 \
					-a 200 \
					-i $w:補完方式１ -1 0 0 \
					-slide 0 20 1500 1500 80 \
					-s $3
			}

		// エレベーター前広場
		trap c004C d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ昇順 $6 -71750 -70750 685 835
				eval( $i:補完ＲＸ = $i:CS_結果１ )

				@CS_スムーズカメラ昇順 $6 -71750 -70750 -67650 -68489
				eval( $i:補完ＰＺ = $i:CS_結果１ )

				chara カメラ設定 通路カメラ１ \
					-c 0 \
					-b -2355 6787 $i:補完ＰＺ  2355 d:CAM_MAX $i:補完ＰＺ \
					-l -2355 1520 -71277  2355 d:CAM_MAX d:CAM_MAX \
					-r $i:補完ＲＸ,2048,0 -f 5558 \
					-a 200 \
					-i 3 3 0 0 \
					-s $3
			}


		// エレベーター内
		trap c005C d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				chara カメラ設定 通路カメラ０ \
					-c 1 \
					-p 69,6597,-74299 -t 69,163,-75143 \
					-r 939,2048,0 -f 6489 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3
			}

	//////////////////////
	// 倉庫カメラ

		// 手前通路
		trap c001S d:PLAYER \
			-mask * \
			-camera \
			-exec {
				if( $3 == 入る ) {
					eval( $i:進入位置Ｚ = $i:前フレーム位置Ｚ )
				}
				if( $i:進入位置Ｚ > -48750 ) {
					eval( $w:補完方式 = 0 )
				} else {
					eval( $w:補完方式 = 2 )
				}

				chara カメラ設定 通路カメラ０ \
				-c 0 \
				-b -3000 d:CAM_MIN d:CAM_MIN  3000 d:CAM_MAX -46629 \
				-l -3000 d:CAM_MIN d:CAM_MIN  3000 d:CAM_MAX -47645 \
				-r 914,2048,0 -f 6000 \
				-a 200 \
				-i $w:補完方式 -1 0 0 \
				-slide 0 1 0 0 1 \
				-s $3
			}

		// 奥倉庫
		trap c002S d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				chara カメラ設定 通路カメラ１ \
					-c 0 \
					-b -1149 d:CAM_MIN -47942  1149 d:CAM_MAX d:CAM_MAX \
					-l -1149 d:CAM_MIN -51154  1149 d:CAM_MAX d:CAM_MAX \
					-r 840,2048,0 -f 7158 \
					-a 200 \
					-i 2 2 0 0 \
					-s $3
			}

		// 匍匐時のカメラ
		trap c003S d:PLAYER \
			-mask * \
			-camera \
			-state d:TRP_STATE_GROUND \
			-exec {
				/*
				if( $4 > 3918 ) {
					eval( $i:補完ＰＸ = 3918 )
				} else if( $4 < -3918 ) {
					eval( $i:補完ＰＸ = -3918 )
				} else {
					eval( $i:補完ＰＸ = $4 )
				}
				chara カメラ設定 通路カメラ１ \
					-c 1 \
					-p $i:補完ＰＸ,407,-46083 -t $i:補完ＰＸ,-971,-52403 \
					-r 140,2048,0 -f 6468 \
					-a 165 \
					-i 2 2 0 0 \
					-s $3
				*/

				/*
				-p 3330,2606,-46121 -t 3330,435,-49668 \
				-r 358,2048,0 -f 4158 \
				-a 200 \
				*/

				if( $4 > 3330 ) {
					eval( $i:補完ＰＸ = 3330 )
				} else if( $4 < -3918 ) {
					eval( $i:補完ＰＸ = -3330 )
				} else {
					eval( $i:補完ＰＸ = $4 )
				}
				chara カメラ設定 通路カメラ１ \
					-c 1 \
					-p $i:補完ＰＸ,2606,-46121 -t $i:補完ＰＸ,435,-49668 \
					-r 358,2048,0 -f 4158 \
					-a 200 \
					-i 2 2 0 0 \
					-s $3
			}

		// 張り付き時のカメラ 北側から
		trap c003S d:PLAYER \
			-mask * \
			-camera \
			//-state d:TRP_STATE_CAUTION \
			-state d:TRP_STATE_BEHINDCAMERA_ENABLE \
			-dir 2048 256 \
			-exec {
				if( $4 > 1828 ) {
					eval( $i:補完ＰＸ = 1828 )
				} else if( $4 < -1828 ) {
					eval( $i:補完ＰＸ = -1828 )
				} else {
					eval( $i:補完ＰＸ = $4 )
				}
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p $i:補完ＰＸ,8363,-46838 -t $i:補完ＰＸ,1374,-48374 \
					-r 883,2048,0 -f 7156 \
					-a 200 \
					-i 2 2 0 0 \
					-s $3
			}

		// 張り付き時のカメラ 南側から
		trap c004S d:PLAYER \
			-mask * \
			-camera \
			//-state d:TRP_STATE_CAUTION \
			-state d:TRP_STATE_BEHINDCAMERA_ENABLE \
			-dir 0 256 \
			-exec {
				if( $4 > 3842 ) {
					eval( $i:補完ＰＸ = 3842 )
				} else if( $4 < -3842 ) {
					eval( $i:補完ＰＸ = -3842 )
				} else {
					eval( $i:補完ＰＸ = $4 )
				}
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p $i:補完ＰＸ,3034,-46092 -t $i:補完ＰＸ,1704,-48665 \
					-r 311,2048,0 -f 2896 \
					-a 200 \
					-i 2 2 0 0 \
					-s $3
			}
//#endif
	}

