// 以下デバッグ専用proc
// -----------------------------------------------------------------------------------
// デバッグキャラ
// ------------------------------------
	proc デバッグキャラセット {
	#if d:DEBUG_PRINT
		print 'debug_chara_set'
	#endif

	#if d:MY_DEBUG
		chara スクリーンショット shot

		chara USBキーボード実行 test \
			-e d:KPD_0 {	// フラグ初期化
					   } \
			-e d:KPD_1 {	// ポジション移動１
							mesg プレイヤー d:PLAYER position 9000, -9000, -222000
					   } \
			-e d:KPD_2 {	// ポジション移動２
							//mesg プレイヤー d:PLAYER position 9000, -10000, -22200
					   } \
			-e d:KPD_3 {	// ポジション移動３
						//mesg プレイヤー d:PLAYER position 9000, -10000, -22200
					   } \
			-e d:KPD_MINUS {
							command プレイヤー無敵セット
							mesg コマンダー 敵兵セット 視界オフ
					   } \
			-e d:KPD_PLUS {
							command プレイヤー無敵解除
							mesg コマンダー 敵兵セット 視界オン
					   }
		#endif
	}




