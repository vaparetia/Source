proc rp_ＳＡＶＥデフォルトセット:04 {
	selectmenu  2 -m  { 
		[ＳＡＶＥ選択肢__i:セーブする] 
		[ＳＡＶＥ選択肢__i:セーブしない] 
	}
	eval($w:rfp_ＳＡＶＥ選択肢返り値 = $status)
	print 'ぐあだららじょぶ$w:rfp_ＳＡＶＥ選択肢返り値:' $w:rfp_ＳＡＶＥ選択肢返り値
}

proc rt_ＳＡＶＥデフォルトセット:04 {
	#ifdef d:EU_TRIAL
	selectmenu  1 -m  { 
		[ＳＡＶＥ選択肢__i:セーブしない] 
	}
	eval($w:rft_ＳＡＶＥ選択肢返り値 = 1)
	#else
print 'ほげほほほ'
	selectmenu  2 -m  { 
		[ＳＡＶＥ選択肢__i:セーブする] 
		[ＳＡＶＥ選択肢__i:セーブしない] 
	}
	eval($w:rft_ＳＡＶＥ選択肢返り値 = $status)
	#endif
print 'ぷにょあよあああ'
}

proc rp_ＳＡＶＥさせないセット:04 {
	selectmenu  2 -m  { 
		[ＳＡＶＥ選択肢__i:セーブさせない] 
		[ＳＡＶＥ選択肢__i:セーブしない] 
	}
	eval($w:rfp_ＳＡＶＥ選択肢返り値 = $status)
	print 'ぐあだららじょぶ$w:rfp_ＳＡＶＥ選択肢返り値:' $w:rfp_ＳＡＶＥ選択肢返り値
}

