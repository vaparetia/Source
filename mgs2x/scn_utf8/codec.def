	// 無線機 command.def

#include "photo.def"
#include "mobile.def"

block codec $s:無線ブロック $i:周波数 $t:顔データ { 実行ブロック }

vox $t:音声ファイル { 実行ブロック }
movie $t:動画ファイル { 実行ブロック }

talk $s:キャラ名 $s:グラフィック名 -m '文字列' ...



bugface $i:表示サイド $s:話者識別子 \
	-span $i:切替最低間隔 $i:時間誤差最大 \  // 時間は 1/300秒単位で指定
	-face $s:胸像モデル ...

bugeyes $i:表示サイド $i:白目スイッチ
// 白目スイッチが 1 のとき、白目を剥く。
// 白目スイッチを 0 にするか、新たにface/bugface を実行するまで続く。

face $i:表示サイド $s:胸像モデル $s:話者識別子
object $i:表示サイド \
	$s:オブジェクトモデル \
	$s:話者識別子 \
	$i:オブジェクト番号 \
	$i:基準関節番号

hair $i:表示サイド \
	-n $s:モデル名 \
	-d $i:サンプルデータ番号 \
	-b $s:バウンディングボックスによる当たり判定に使うモデル \
	-o $i:楕円球当たり判定用パラメータ \
	-q $i:ライトの影響をアンビエント主体にするフラグ \
	-noWind // このオプションがある場合は、ステージの風に影響されない

eyeclose $i:表示サイド $s:目閉じモーション名

cancelmtn $i:表示サイド $s:モーション  $i:補間時間
lightvec $i:表示サイド $i:光源X $i:光源Y $i:光源Z
lightcol $i:表示サイド $i:赤 $i:緑 $i:青
ambientcol $i:表示サイド $i:赤 $i:緑 $i:青
defmtn $i:表示サイド $s:デフォルトモーション

mindvoice $i:是否 $t:弱い $t:やや弱め $t:普通 $t:強め
minden		// うなづき許可(デフォルト)
mindds		// うなづき禁止

tracecamera $i:表示サイド $i:スイッチ  // 0:禁止(デフォルト) / 1:許可
facecamera $i:表示サイド $i:far $i:zoom $i:heading $i:pan $i:pitch $i:gain
facelimit $i:表示サイド $i:zoom $i:right $i:left $i:upper $i:lower
facedelay $i:表示サイド $i:spin_delay $i:zoom_delay

memregist $i:登録エリア $i:リソース番号 $i:周波数
getmemfreq $i:登録エリア

rand $i:最大値
prefreq
setfreq $i:周波数     // 表示周波数を設定(変更)
callcount

dispen
dispds

// プレイヤ名定義(この名前でテキストが表示されている間は mindvoice 禁止)
player $s:プレイヤ名

// 無線中選択。
// 選択肢は現実的には行数分程度まで。
// $status には、選択された項目の番号(0～) が入る。
// キャンセルされたら $status = -1 になる。
// 無線中クイズとかできるかも。
selectmenu $i:選択肢数 -s $i:初期選択項目 -m '項目文字列' ...

// セーブモードに入る
savemode

wait $i:待ち時間	// 時間待ち

vibration $i:type -time $i:持続時間	// 振動開始/終了
// $i:type に -1 を入れると強制終了
// $i:type は、低周波の強さ。高周波は振動中ずっと。

vibplay $s:振動ファイル名
// ステージデータ中の振動データに従ってコントローラを振動させる。


// 画面を揺らす(爆発の衝撃等)
earthq $i:スイッチ -time $i:持続時間 -amp $i:振幅
// $i:スイッチは、1 で ON, 0 で OFF.
// -time $i:持続時間 を指定すると、指定した時間が経過後、時動的に止まる。
// 指定しなければ止めるまで動きっぱなし。時間は 1/300秒で指定。
// -amp $i:振幅 を指定すると、地震の揺れの最大値(正位置からの最大移動量)を
// 設定できる。揺れを大きくしたい場合は大きな値を指定する。デフォルトは 16。


// 任意ノイズ表示
noise $i:表示サイド $i:スイッチ -time $i:表示時間

// $i:スイッチ は、1 でノイズ発生、0 でノイズ消去。
// ノイズ発生時、-time オプションで $i:表示時間 を指定すると、
// その時間だけノイズを表示し、その後は時動的に消去される。
// 表示時間を指定しない場合は、ノイズを消去するまでノイズが発生したままになる。

#include "command.def"

