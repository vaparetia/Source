	// アイテム
	// ------------------------------------
#ifndef d:BOSS_MODE
	proc アイテム取得時番号設定 $:ボックス名 {
		#if d:DEBUG_PRINT
			print 'item_no_set'
		#endif

		if ( $:ボックス名 == レーション:01 ) {
			eval( $f:アイテム再セット１ = 0 );
		} else if ( $:ボックス名 == レーション:02 ) {
			eval( $f:アイテム再セット２ = 0 );
		}
	}
#endif

	proc アイテム設置 {
		#if d:DEBUG_PRINT
			print 'item_set'
		#endif

		if ( $w:ゲーム設定 == d:LEVEL_NORMAL ) {
			@レーション_初期設置 レーション:01 1000 17625 21000 0
		} else if ( $w:ゲーム設定 <= d:LEVEL_EASY ) {
			@レーション_初期設置 レーション:01 1000 17625 21000 0
			eval( $f:アイテム再セット１ = 1 );
			@レーション_初期設置 レーション:02 12250 15125 3500 0
			eval( $f:アイテム再セット２ = 1 );

			trap ev001 d:PLAYER \
				-mask いる \
				-exec {
					if( ( $w:アイテム数Ｒ[d:アイテム:レーション] < 1 ) \
						&& (`command カメラ視界チェック -camera 0x01 \
								-bound (1000-1000) (17625) (21000-1000) \
								       (1000+1000) (18625) (21000+1000)` == 0)){

						if($f:アイテム再セット１ == 0) {
							@レーション_初期設置 レーション:01 1000 17625 21000 0
							eval( $f:アイテム再セット１ = 1 );
						}
					}

					if( ( $w:アイテム数Ｒ[d:アイテム:レーション] < 1 ) \
						&& (`command カメラ視界チェック -camera 0x01 \
								-bound (12250-1000) (15125) (3500-1000) \
								       (12250+1000) (16125) (3500+1000)` == 0)){

						if($f:アイテム再セット２ == 0) {
							@レーション_初期設置 レーション:02 12250 15125 3500 0
							eval( $f:アイテム再セット２ = 1 );
						}
					}
				}
		}


	}


	// フォグ
	// ------------------------------------
	proc フォグ設定 {
		#if d:DEBUG_PRINT
			print 'fog_set'
		#endif

		chara フォグ 霧\
			-c 120, 130, 116 \
			-n -3000 \
			-f 160000 
	}

	// キャラ用光源(マップの設置が終わってから設定することで、キャラだけに光を当てる)
	// ------------------------------------
	proc キャラ用ライト設置 {
		#if d:DEBUG_PRINT
			print 'chara_light_set'
		#endif

		chara 環境光 環境光源 \
			 -c 39 55 46

		chara 平行光 平行光源 \
			 -c 29 44 54 \
			 -p -4600 -800 -1600
	}

	// エフェクト関係
	// -----------------------------------
	// 子画面設定 
	// ------------------------------------
	proc 子画面設定 {
		#if d:DEBUG_PRINT
			print 'sub_camera_set'
		#endif

		chara サブ画面 子画面 \
			-w (512-d:SUB_MARGIN-d:SUB_WIDTH),d:SUB_MARGIN (512-d:SUB_MARGIN),(d:SUB_HEIGHT+d:SUB_MARGIN)
	}

	// ステージカメラ設定 
	// ------------------------------------
	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0 
		chara カメラ モーションカメラ		-c 0 -l 1 -p 1 

		chara カメラ プログラムデモカメラ -c 0 -l 1 -p 0

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \	
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 340,2048,0 \
			-f 10000 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}


	// ビヨンド設定
	// ------------------------------------
	proc フェデラルホールビヨンド設定 {
		#if d:DEBUG_PRINT
			print 'w61a_beyond_set'
		#endif

		// 東側
		trap by001 d:PLAYER \
			-mask 入る \
			-exec {
				@東向き柵なしビヨンド発動 by001 12500 $6 3000 23000 15250 (d:BY_NOFOOTSHADOW | d:BY_NO_STAMP)
				// バグ防止のためトラップを広く張ったので移動範囲をこちらで設定
				command エルード移動範囲設定 -x_range 12500 12500 -z_range 3000 23000
			}
		trap by001 d:PLAYER \
			-mask いる \
			-state 6 \
			-dir 1024 256 \	//方向指定
			-camera \		//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 791,2252,0 -f 8508 \
					-a 200 \
					-i 0 -1 0 0 \
					-s 1
			}
		trap by001 d:PLAYER \
			-mask ？ \
			-state 5 \
			-dir 3072 256 \	//方向指定
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 26,2162,0 -f 7803 \
					-a 276 \
					-i 3 2 0 0 \
					-s $3 \
					-z d:CAMERA_NO_CUSHION
			}


		// 南側
		trap by002 d:PLAYER \
			-mask 入る \
			-exec {
				@南向き片手ビヨンド発動 by002 23000 $4 -1000 12500 ((-(2750*$4)/12500)+18000) (d:BY_NOFOOTSHADOW | d:BY_NO_STAMP)
			}

		trap by002 d:PLAYER \
			-mask いる \
			-state 6 \
			-dir 0 256 \	//方向指定
			-camera \		//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 683,2110,0 -f 6731 \
					-a 200 \
					-i 0 -1 0 0 \
					-s 1
			}
		trap by002 d:PLAYER \
			-mask ？ \
			-state 5 \
			-dir 2048 256 \	//方向指定
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 4089,2065,0 -f 7342 \
					-a 250 \
					-i 3 2 0 0 \
					-s $3 \
					-z d:CAMERA_NO_CUSHION
			}
	}


	// 体力０で落下死設定
	// ------------------------------------
	proc 体力０で落下死設定 {
		#if d:DEBUG_PRINT
			print 'fall_motion_change'
		#endif

		// 体力０でトラップ内に入ったらモーションを強引にチェンジしてカメラをつける
		// バグ防止のため体力があってエルード以外で落下したとき強引に死亡にする処理も追加する 2002.02.27
		trap de001 d:PLAYER \
			-mask ＊ \
			-exec {
				if ( $w:体力 <= 0 ) {
					if ( $3 == 入る ) {
						#if d:DEBUG_PRINT
							print 'de001-体力０で落ちました'
						#endif
						mesg プレイヤー d:PLAYER rotate 3072			//	それ以外はその向きのまま

						mesg プレイヤー d:PLAYER fall \
							d:モーションリスト:non_elude_fall \
							d:モーションリスト:non_elude_fall \
							d:モーションリスト:non_elude_fall_out \
							0 \	//	この高さまで落ちたらゲームオーバー終了処理が呼ばれる
							0x0004 \
							NULL \
							NULL
					}

					if ( $6 <= 11000 && $6 >= 5000 ) {
						#if d:DEBUG_PRINT
							print 'de001-落下死カメラ箱の上'
						#endif
						// 箱の上にうまく落ちてしまった
						@落下死カメラ東側箱の上 1 $5
					} else {
						#if d:DEBUG_PRINT
							print 'de001-落下死カメラ東側'
						#endif
						@落下死カメラ東側 1 $5
					}
					
				} else {
					// エルードトラップに入らず落下してきた場合は強引にゲームオーバーにする
					if ( (`command ゲームオーバーチェック` == 0) && ($5 < 14000) ) {
						command プレイヤー状態取得
						if ( ((!($status & d:PFLAG_ELUDE))&&(!($status & d:PFLAG_ELUDE_FALL))) ) {
							#if d:DEBUG_PRINT
								print 'de001-体力がある状態で落ちました'
							#endif
							mesg プレイヤー d:PLAYER rotate 3072			//	それ以外はその向きのまま

							mesg プレイヤー d:PLAYER fall \
								d:モーションリスト:non_elude_fall \
								d:モーションリスト:non_elude_fall \
								d:モーションリスト:non_elude_fall_out \
								0 \	//	この高さまで落ちたらゲームオーバー終了処理が呼ばれる
								0x0004 \
								NULL \
								NULL

							if ( $6 <= 11000 && $6 >= 5000 ) {
								// 箱の上にうまく落ちてしまった
								@落下死カメラ東側箱の上 1 $5
							} else {
								@落下死カメラ東側 1 $5
							}
						}
					}
				}
			}

		trap de002 d:PLAYER \
			-mask ＊ \
			-exec {
				if ( $w:体力 <= 0 ) {
					if ( $3 == 入る ) {
						#if d:DEBUG_PRINT
							print 'de001-体力０で落ちました'
						#endif
						mesg プレイヤー d:PLAYER rotate 2048			//	それ以外はその向きのまま

						mesg プレイヤー d:PLAYER fall \
							d:モーションリスト:non_elude_fall \
							d:モーションリスト:non_elude_fall \
							d:モーションリスト:non_elude_fall_out \
							0 \	//	この高さまで落ちたらゲームオーバー終了処理が呼ばれる
							0x0004 \
							NULL \
							NULL
					}

					@落下死カメラ南側

				} else {
					// エルードトラップに入らず落下してきた場合は強引にゲームオーバーにする
					if ( (`command ゲームオーバーチェック` == 0) && ($5 < 14000) ) {
						command プレイヤー状態取得
						if ( ((!($status & d:PFLAG_ELUDE))&&(!($status & d:PFLAG_ELUDE_FALL))) ) {
							#if d:DEBUG_PRINT
								print 'de001-体力がある状態で落ちました'
							#endif
							mesg プレイヤー d:PLAYER rotate 2048			//	それ以外はその向きのまま

							mesg プレイヤー d:PLAYER fall \
								d:モーションリスト:non_elude_fall \
								d:モーションリスト:non_elude_fall \
								d:モーションリスト:non_elude_fall_out \
								0 \	//	この高さまで落ちたらゲームオーバー終了処理が呼ばれる
								0x0004 \
								NULL \
								NULL

							@落下死カメラ南側
						}
					}
				}
			}
	}

	// 落下死カメラ設定
	// ------------------------------------
	proc 落下死カメラ設定 {
		#if d:DEBUG_PRINT
			print 'fall_camera_set'
		#endif

		// 東側
		trap de001 d:PLAYER \
			-mask いる \
			-state d:TRP_STATE_ELUDE_FALL \
			-exec {
				if ( $6 <= 11000 && $6 >= 5000 ) {
					// 箱の上にうまく落ちてしまった
					@落下死カメラ東側箱の上 $3 $5
				} else {
					@落下死カメラ東側 $3 $5
				}
			}


		// 南側
		trap de002 d:PLAYER \
			-mask いる \
			-state d:TRP_STATE_ELUDE_FALL \
			-exec {
				@落下死カメラ南側
			}
	}

	proc 落下死カメラ東側箱の上 $:入る出るフラグ $:プレイヤーＹ位置 {

		@CS_スムーズカメラ降順 $:プレイヤーＹ位置 14200 8000 15266 15122
		eval( $i:補完ＰＸ = $i:CS_結果１ );
		@CS_スムーズカメラ降順 $:プレイヤーＹ位置 14200 8000 23389 10352
		eval( $i:補完ＰＹ = $i:CS_結果１ );
		@CS_スムーズカメラ降順 $:プレイヤーＹ位置 14200 8000 43583 43323
		eval( $i:補完ＰＺ = $i:CS_結果１ );

		@CS_スムーズカメラ降順 $:プレイヤーＹ位置 14200 8000 5967 5918
		eval( $i:補完ＴＸ = $i:CS_結果１ );
		@CS_スムーズカメラ降順 $:プレイヤーＹ位置 14200 8000 17454 16945
		eval( $i:補完ＴＹ = $i:CS_結果１ );
		@CS_スムーズカメラ降順 $:プレイヤーＹ位置 14200 8000 20016 19893
		eval( $i:補完ＴＺ = $i:CS_結果１ );

		chara カメラ設定 モーションカメラ \
			-c 1 \	
			-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ -t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ \
			-r 106,2300,0 -f 20782 \
			-a 200 \
			-i 0 0 0 0 \
			-z d:CAMERA_NO_CUSHION \
			-s $:入る出るフラグ
	}

	proc 落下死カメラ東側 $:入る出るフラグ $:プレイヤーＹ位置 {

		@CS_スムーズカメラ降順 $:プレイヤーＹ位置 14200 1000 15077 14689
		eval( $i:補完ＰＸ = $i:CS_結果１ );
		@CS_スムーズカメラ降順 $:プレイヤーＹ位置 14200 1000 17887 1992
		eval( $i:補完ＰＹ = $i:CS_結果１ );
		@CS_スムーズカメラ降順 $:プレイヤーＹ位置 14200 1000 44085 42447
		eval( $i:補完ＰＺ = $i:CS_結果１ );

		@CS_スムーズカメラ降順 $:プレイヤーＹ位置 14200 1000 7346 7427
		eval( $i:補完ＴＸ = $i:CS_結果１ );
		@CS_スムーズカメラ降順 $:プレイヤーＹ位置 14200 1000 14523 8084
		eval( $i:補完ＴＹ = $i:CS_結果１ );
		@CS_スムーズカメラ降順 $:プレイヤーＹ位置 14200 1000 25090 23958
		eval( $i:補完ＴＺ = $i:CS_結果１ );

		chara カメラ設定 モーションカメラ \
			-c 1 \	
			-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ -t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ \
			-r 106,2300,0 -f 20782 \
			-a 200 \
			-i 0 0 0 0 \
			-z d:CAMERA_NO_CUSHION \
			-s $:入る出るフラグ
	}

	proc 落下死カメラ南側 {
		chara カメラ設定 モーションカメラ \
			-c 0 \	
			-b -6270,2174,30936 -6270,2174,30936 \
			-l 6820,8525,19722 8968,20229,20739 \
			-r 3877,1400,0 -f 21782 \
			-a 322 \
			-z d:CAMERA_NO_CUSHION \
			-i 0 0 0 0 \
			-s 1
	}


