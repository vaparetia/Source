// 各gclで必要なdefine
// ------------------------------------
// モード
#define		STAGE_PLANT		1		// 共通プロック切り分け用
// ステージ名
#define		STAGE_W61A		1		// 共通プロック切り分け用
// 敵兵、ＮＰＣ状況（薬莢を呼び分けるのに必要）


// 各種スイッチ用define
// ------------------------------------
// サウンド
#define		SOUND			1		// サウンドデータは最初に呼ぶ
// デモ
#define		DEMO			0
#define		POLYDEMO_LOAD	1		// ポリゴンデモロードを使用するのに必要
// キャラクター関係
#define		RAIDEN			1		// SNAKEとは排他
// ドア
// 入出トラップ
// フォグ
#define		FOG				1
// ライト関係
#define		CHARA_LIGHT		1		// キャラ専用ライト
// エフェクト関係
// 子画面
#define		SUB_CAMERA		0
// カメラ関係
// アイテム
#define		ITEM			1		// アイテム
// 強制モーション
#define		BY_MOTION		1		// ビヨンドモーション

// デバッグ関係
#ifdef	d:FIX_MODE
	#define		DEBUG_CHARA		0		// デバッグキャラ全体(FIX時は0)
#else
	#define		DEBUG_CHARA		0		// デバッグキャラ全体
#endif
#define		SCREENSHOT		0		// スクリーンショット


// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME		w61a
#define		KMS_NAME0		w61a
#define		KMS_NAME1		w61a_other1
#define		FLAG_NAME		w61a_flag
#define		POLE_NAME		w61a_flag_pole
#define		GW_NAME			w61a_gw_statue
#define		LT2_NAME		w61a

// キャラクター関係
#if d:RAIDEN
	#define		PLAYER		ライデン	// モーションができるまで名前はスネーク
#else
	#define		PLAYER		スネーク
#endif

// ローカル変数


// include
// ------------------------------------
#include "rai_w61a.mh"		// 強制モーションリスト
#include "stdch.h"
#include "sload.h"
#include "beyond.h"
#include "beyond2.h"
#include "beyond3.h"
#include "sound.h"
#include "item_info.h"
#include "w61a_common.h"
#include "boss_stdproc.h"
#include "cap_resource.h"


#ifndef d:BOSS_MODE
// マップ設定
// ------------------------------------
chara マップ フェデラルホール -k d:KMS_NAME0 -k d:GW_NAME -h d:HZX_NAME,0 -l d:LT2_NAME

command マップ設定 フェデラルホール -set {

	@常駐キャラ設定
	#if d:SOUND	
		@サウンド設定	// データは最初に呼ぶ
	#endif

	@ローカル変数初期化
	@設定値変更
	@プラグイン設定
	@ポーズ時ステージ名表示設定 d:wn_フェデラルホール
	@シナリオデモキャラセット
	@アイテム状態制御
	@プレイヤー設定
	@ソリダスセット
	@遠景設定
	@フェデラルホール旗設置
	@ビル窓設置

	#if d:ITEM
		@アイテム設置
	#endif
	#if d:FOG
		@フォグ設定
	#endif
	#if d:BY_MOTION
		@フェデラルホールビヨンド設定
	#endif
	@カメラセット
	@体力０で落下死設定
	@落下死カメラ設定
	#if d:CHARA_LIGHT
		@キャラ用ライト設置
	#endif

	// ボスラッシュ用extern宣言
	@ボスラッシュ開始時キャラ設定

	#if d:DEBUG_CHARA
	//	@デバッグキャラセット
	#endif
}

#include "w61a_cdc.ch"

// ゲーム時
if( $s:登場ポイント == sp_init_w61a_0 ) {
	//初期マップの表示
	command マップ表示 -show フェデラルホール
	// 全てのセットが終わったところでフェードイン
	// フェードインが終わるまではパッドリリース
	command パッド操作 -release
	eval($f:ロードチェックＯＮフラグ = 1);
	chara フェードインアウト フェードイン \
		-i 255,255,255 128 \
		-c 0,0,0 0 \
		-t d:FADEIN_TIME \
		-s 10

	mesg シネマスクリーン シネマ フェードアウト 1
	command メニュー設定 -menu off -gage off
	chara delay シネマディレイ \
		-time 10 \
		-exec {
			mesg シネマスクリーン シネマ フェードイン (d:FADEIN_TIME-10)
		}
	chara delay パッドディレイ \
		-time d:FADEIN_TIME \
		-exec {
				command メニュー設定 -menu on -gage on
				command パッド操作 -cancel
		}
}

#endif



// 各proc設定
//-------------------------------------------------------------------------------------
// 全マップ共通
	// サウンド
	// ------------------------------------
	proc サウンド設定 {
		#if d:DEBUG_PRINT 
			print 'sound_set'
		#endif

		chara サウンドマネージャー ＳＤマネ -pak 0
		mesg サウンドマネージャー ＳＤマネ SD_CODE d:SNG_PLAY_01
		@サウンド効果音設定
	}

	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT 
			print 'localvar_init'
		#endif

		eval($f:アイテム再セット１ = 0);
		eval($f:アイテム再セット２ = 0);
	}

	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT 
			print 'status_set'
		#endif

		command メニュー設定 -radar off

		// モーションを変えるため、危険モードにする
		$w:アラートモード = d:ALERT_MODE_ALERT;
	}

	// ポリデモ
	// ------------------------------------

	//
	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif

		command プラグイン落下
	}

	// アイテム状態を調整する
	// ------------------------------------
	proc アイテム状態制御 {
		#if d:DEBUG_PRINT
			print 'player_item_set'
		#endif

		#ifndef d:BOSS_MODE
		// 通常ゲームのとき
			eval ( $w:w61a_レーション所持数 = $w:アイテム数Ｒ[ d:アイテム:レーション ] );
			eval ( $w:w61a_防弾チョッキ所持数 = $w:アイテム数Ｒ[ d:アイテム:防弾チョッキ ] );
			eval ( $w:w61a_止血剤所持数 = $w:アイテム数Ｒ[ d:アイテム:止血剤 ] );
			eval ( $w:w61a_デジカメ所持数 = $w:アイテム数Ｒ[ d:アイテム:デジカメ ] );
			eval ( $w:w61a_ステルス所持数 = $w:アイテム数Ｒ[ d:アイテム:ステルス ] );
			eval ( $w:w61a_無限カツラ所持数 = $w:アイテム数Ｒ[ d:アイテム:無限カツラ ] );
			eval ( $w:w61a_カツラＡ所持数 = $w:アイテム数Ｒ[ d:アイテム:カツラＡ ] );
			eval ( $w:w61a_カツラＢ所持数 = $w:アイテム数Ｒ[ d:アイテム:カツラＢ ] );
			eval ( $w:w61a_カツラＣ所持数 = $w:アイテム数Ｒ[ d:アイテム:カツラＣ ] );
			eval ( $w:w61a_カツラＤ所持数 = $w:アイテム数Ｒ[ d:アイテム:カツラＤ ] );
			eval ( $w:w61a_ドッグタグ所持数 = $w:アイテム数Ｒ[ d:アイテム:ドッグタグ ] );

			command	武器アイテム取られ
			
			// 武器のセット
			eval ( $w:プレイヤーフラグ = $w:プレイヤーフラグ | 0x0002 )
			eval ( $w:武器 = d:武器:ブレード )
			eval ( $w:武器最大数Ｒ[ d:武器:ブレード ] = 1 )
			eval ( $w:武器弾数Ｒ[ d:武器:ブレード ] = 1 )
			eval ( $w:武器最大数[ d:武器:ブレード ] = 1 )
			eval ( $w:武器弾数[ d:武器:ブレード ] = 1 )			
			command プラグインブレード -m rai_blade	

			// アイテムのセット
			eval ( $w:アイテム数Ｒ[ d:アイテム:レーション ] = $w:w61a_レーション所持数 );
			eval ( $w:アイテム数Ｒ[ d:アイテム:防弾チョッキ ] = $w:w61a_防弾チョッキ所持数 );
			eval ( $w:アイテム数Ｒ[ d:アイテム:止血剤 ] = $w:w61a_止血剤所持数 );
			eval ( $w:アイテム数Ｒ[ d:アイテム:デジカメ ] = $w:w61a_デジカメ所持数 );
			eval ( $w:アイテム数Ｒ[ d:アイテム:ステルス ] = $w:w61a_ステルス所持数 );
			eval ( $w:アイテム数Ｒ[ d:アイテム:無限カツラ ] = $w:w61a_無限カツラ所持数 );
			eval ( $w:アイテム数Ｒ[ d:アイテム:カツラＡ ] = $w:w61a_カツラＡ所持数 );
			eval ( $w:アイテム数Ｒ[ d:アイテム:カツラＢ ] = $w:w61a_カツラＢ所持数 );
			eval ( $w:アイテム数Ｒ[ d:アイテム:カツラＣ ] = $w:w61a_カツラＣ所持数 );
			eval ( $w:アイテム数Ｒ[ d:アイテム:カツラＤ ] = $w:w61a_カツラＤ所持数 );
			eval ( $w:アイテム数Ｒ[ d:アイテム:ドッグタグ ] = $w:w61a_ドッグタグ所持数 );
			// 100%もっているので変数は用意しない
			eval ( $w:アイテム数Ｒ[ d:アイテム:ゴル兵制服 ] = 1 );
			@デモ後武器アイテム制御 d:デモ後前を継続 d:デモ後特殊装備なし
		#else
		// ボスモードのとき
			if ( $s:ボスラッシュプレイヤー == スネーク ) {
				eval ( $w:w61a_レーション所持数 = $w:アイテム数[ d:アイテム:レーション ] );
				eval ( $w:w61a_止血剤所持数 = $w:アイテム数[ d:アイテム:止血剤 ] );

				command	武器アイテム取られ
				
				// 武器のセット
				eval ( $w:プレイヤーフラグ = $w:プレイヤーフラグ | 0x0002 )

				// アイテムのセット
				eval ( $w:アイテム数[ d:アイテム:レーション ] = $w:w61a_レーション所持数 );
				eval ( $w:アイテム数[ d:アイテム:止血剤 ] = $w:w61a_止血剤所持数 );
			} else {
				eval ( $w:w61a_レーション所持数 = $w:アイテム数Ｒ[ d:アイテム:レーション ] );
				eval ( $w:w61a_防弾チョッキ所持数 = $w:アイテム数Ｒ[ d:アイテム:防弾チョッキ ] );
				eval ( $w:w61a_止血剤所持数 = $w:アイテム数Ｒ[ d:アイテム:止血剤 ] );
				eval ( $w:w61a_デジカメ所持数 = $w:アイテム数Ｒ[ d:アイテム:デジカメ ] );
				eval ( $w:w61a_ステルス所持数 = $w:アイテム数Ｒ[ d:アイテム:ステルス ] );
				eval ( $w:w61a_無限カツラ所持数 = $w:アイテム数Ｒ[ d:アイテム:無限カツラ ] );
				eval ( $w:w61a_カツラＡ所持数 = $w:アイテム数Ｒ[ d:アイテム:カツラＡ ] );
				eval ( $w:w61a_カツラＢ所持数 = $w:アイテム数Ｒ[ d:アイテム:カツラＢ ] );
				eval ( $w:w61a_カツラＣ所持数 = $w:アイテム数Ｒ[ d:アイテム:カツラＣ ] );
				eval ( $w:w61a_カツラＤ所持数 = $w:アイテム数Ｒ[ d:アイテム:カツラＤ ] );
				eval ( $w:w61a_ドッグタグ所持数 = $w:アイテム数Ｒ[ d:アイテム:ドッグタグ ] );

				command	武器アイテム取られ
				
				// 武器のセット
				$w:プレイヤーフラグ = ( $w:プレイヤーフラグ | d:PL_START_STATE_BLADE_OUT );		// 刀抜いている
				$w:プレイヤーフラグ = ( $w:プレイヤーフラグ & ~(d:PL_START_STATE_BLADE_INV) );	// 峰うちじゃない
				eval ( $w:武器 = d:武器:ブレード )
				eval ( $w:武器最大数Ｒ[ d:武器:ブレード ] = 1 )
				eval ( $w:武器弾数Ｒ[ d:武器:ブレード ] = 1 )
				eval ( $w:武器最大数[ d:武器:ブレード ] = 1 )
				eval ( $w:武器弾数[ d:武器:ブレード ] = 1 )			
				command プラグインブレード -m rai_blade	

				// アイテムのセット
				eval ( $w:アイテム数Ｒ[ d:アイテム:レーション ] = $w:w61a_レーション所持数 );
				eval ( $w:アイテム数Ｒ[ d:アイテム:防弾チョッキ ] = $w:w61a_防弾チョッキ所持数 );
				eval ( $w:アイテム数Ｒ[ d:アイテム:止血剤 ] = $w:w61a_止血剤所持数 );
				eval ( $w:アイテム数Ｒ[ d:アイテム:デジカメ ] = $w:w61a_デジカメ所持数 );
				eval ( $w:アイテム数Ｒ[ d:アイテム:ステルス ] = $w:w61a_ステルス所持数 );
				eval ( $w:アイテム数Ｒ[ d:アイテム:無限カツラ ] = $w:w61a_無限カツラ所持数 );
				eval ( $w:アイテム数Ｒ[ d:アイテム:カツラＡ ] = $w:w61a_カツラＡ所持数 );
				eval ( $w:アイテム数Ｒ[ d:アイテム:カツラＢ ] = $w:w61a_カツラＢ所持数 );
				eval ( $w:アイテム数Ｒ[ d:アイテム:カツラＣ ] = $w:w61a_カツラＣ所持数 );
				eval ( $w:アイテム数Ｒ[ d:アイテム:カツラＤ ] = $w:w61a_カツラＤ所持数 );
				eval ( $w:アイテム数Ｒ[ d:アイテム:ドッグタグ ] = $w:w61a_ドッグタグ所持数 );
			}
		#endif
	}

	// プレイヤー 
	// ------------------------------------
	proc プレイヤー設定 {
		#if d:DEBUG_PRINT
			print 'player_set'
		#endif

		chara プレイヤー d:PLAYER \
			-p $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,$i:プレイヤー初期Ｚ位置 \
//			-p 4605,$i:プレイヤー初期Ｙ位置,8288 \
			-d 0,$i:プレイヤー初期方向,0 \
//			-d 0,0,0 \
			-s 0 \
			-m rai_def -a raiden -o rai_w61a

			// 髪の毛
		@ライデン髪の毛設定 d:NORMAL_HAIR

		@プレイヤーＬＯＤ設定 d:C_DISTANCE_TYPE 6000
		
		//壊れた手錠
		chara ロープモデル３ ライデンの壊れた手錠右 \
	        -n demo_tjo_rai_broken_r \
	        -y ライデン \
	        -z 5 \
	        -d 4 \
	        -h 1

	    chara ロープモデル３ ライデンの壊れた手錠左 \
	        -n demo_tjo_rai_broken_l \
	        -y ライデン \
	        -z 9 \
	        -d 4 \
	        -h 1		

		command プレイヤー主観腕壊れ手錠

		chara Ｏ２ゲージ Ｏ２ -max 3500 -length d:O2_GAGE
	}


	// ソリダス関連
	// ------------------------------------
	proc ソリダスセット {
		#ifndef d:BOSS_MODE
		// 通常ゲームのソリダス
			chara ソリダス ソリダス \
				-model sol_vanim_0_sh_mt \
				-evm sol_def_face_mh_mt \	
				-cv2 sol_vanim_0_sh_mt sol_vanim_1_sh_mt \
				-motion solidus \
				-position 4167,20000,12509 \
				-rotate 0,2048,0 \
				-start_mode 0 \
				-life 75 75 \
				-proc ソリダス戦勝利プロック \
					  ソリダス蛇手外し位置移動開始 \
				 	  ソリダス蛇手外し開始 \
				 	  ソリダス蛇手外し終了 \
				-map_center 6250,16625,13500 \
				-jump_bound 250,5000 10750,21000 \
				-flag 0 \
				-caption [ソリダス字幕リソース:さすがだな] \
						 [ソリダス字幕リソース:ここからだ] \
						 [ソリダス字幕リソース:さすがだなＧ] \
						 [ソリダス字幕リソース:ここからだＧ] \
					     [ソリダス字幕リソース:さすがだなＦ] \
						 [ソリダス字幕リソース:ここからだＦ] \
					     [ソリダス字幕リソース:さすがだなＩ] \
						 [ソリダス字幕リソース:ここからだＩ] \
					     [ソリダス字幕リソース:さすがだなＳ] \
						 [ソリダス字幕リソース:ここからだＳ] \
						 [ソリダス字幕リソース:さすがだなＪ] \
						 [ソリダス字幕リソース:ここからだＪ] \
#ifdef d:ENGLISH
				-captiontime 0 60 220 
#elif d:JAPANESE
				-captiontime 0 100 220 
#endif
		#else
		// ボスラッシュモードのソリダス
			if ( $s:ボスラッシュプレイヤー == スネーク ) {
				eval( $i:ソリダスライフ = 40 );
			} else {
				eval( $i:ソリダスライフ = 75 );
			}

			chara ソリダス ソリダス \
				-model sol_vanim_0_sh_mt \
				-evm sol_def_face_mh_mt \	
				-cv2 sol_vanim_0_sh_mt sol_vanim_1_sh_mt \
				-motion solidus \
				-position 4167,20000,12509 \
				-rotate 0,2048,0 \
				-start_mode 0 \
				-life $i:ソリダスライフ $i:ソリダスライフ \
				-proc ソリダス戦勝利プロック \
					  ソリダス蛇手外し位置移動開始 \
				 	  ソリダス蛇手外し開始 \
				 	  ソリダス蛇手外し終了 \
				-map_center 6250,16625,13500 \
				-jump_bound 250,5000 10750,21000 \
				-flag 0 \
				-caption [ソリダス字幕リソース:さすがだな] \
						 [ソリダス字幕リソース:ここからだ] \
						 [ソリダス字幕リソース:さすがだなＧ] \
						 [ソリダス字幕リソース:ここからだＧ] \
					     [ソリダス字幕リソース:さすがだなＦ] \
						 [ソリダス字幕リソース:ここからだＦ] \
					     [ソリダス字幕リソース:さすがだなＩ] \
						 [ソリダス字幕リソース:ここからだＩ] \
					     [ソリダス字幕リソース:さすがだなＳ] \
						 [ソリダス字幕リソース:ここからだＳ] \
						 [ソリダス字幕リソース:さすがだなＪ] \
						 [ソリダス字幕リソース:ここからだＪ] \
#ifdef d:ENGLISH
				-captiontime 0 60 220 
#elif d:JAPANESE
				-captiontime 0 100 220
#endif
		#endif

			chara 二体表示カメラ ボス戦カメラ \
				-names d:PLAYER ソリダス \
				-position 10406,20000,9732 \
				-rotate 167,3072,0 \
				-track 6032 \
				-min_track 4000 \
				-bound 50,0,1550 12450,50000,50000 \
				-limit 500,0,2000 12000,50000,50000 \
				-angle 200

		// 欧州、韓国はＳＥ字幕が入る
		#ifdef d:EU || d:KOREA
			#ifdef d:EU
			// 欧州版では言語選択があるためにこのコマンドを使う(:01とかで定義プロックを変えられる)
				command 字幕言語設定
			#endif
			@ソリダスＳＥ字幕リソース
		#endif

	}



	proc ソリダス戦勝利プロック {
		#ifndef d:BOSS_MODE
		// 通常ゲームの場合
			mesg サウンドマネージャー ＳＤマネ SD_CODE d:SNG_FOUTS_S
			command 無線設定 -reset
			command パッド操作 -release
			command プレイヤー無敵セット
			mesg コマンダー 敵兵セット 視界オフ
			//eval ( $w:p_story = d:ST:P082_01_P01エンディング１ポリゴンデモ１開始 );
			eval( $f:デモ直後フラグ = 1 );

			// フェードインスタート
			if($w:アイテム == d:アイテム:ゴル兵制服){
				preseek 'r_plt5'
			} else {
				preseek 'd082p01'
			}
			chara フェードインアウト フェードアウト \
				-c 255,255,255 128 \
				-t d:FADEOUT_TIME \
				-p ポリデモロードスタート \
				-s 10

			chara delay シネマディレイ \
				-time 1 \
				-exec {
					chara シネマスクリーン シネマ -top d:CINEMA_BELT_UPPER -bottom d:CINEMA_BELT_LOWER -ftime d:C_FADE_TIME
					mesg シネマスクリーン シネマ フェードアウト (d:FADEOUT_TIME-5)
				}

			command メニュー設定 -menu off -gage off
		#else
		// ボスラッシュモードの場合
			@ボスラッシュ終了時処理
		#endif
	}

	proc ポリデモロードスタート {
		#if d:DEBUG_PRINT
			print '*** Poly-Demo Load Start ***'
		#endif
		if (`command ゲームオーバーチェック` == 0 ) {		
			eval ( $w:p_story = d:ST:P082_01_P01エンディング１ポリゴンデモ１開始 );
		}
		if ( $w:アイテム == d:アイテム:ゴル兵制服 ) {
			load "d082p01" -r 'r_plt5'
 		} else {
			load "d082p01"
		}
	}

	proc ソリダス蛇手外し位置移動開始 {
		if (`command ゲームオーバーチェック` == 0 ) {
			@シナリオデモ開始処理
		}
	}

	proc ソリダス蛇手外し開始 {
		if (`command ゲームオーバーチェック` == 0 ) {
			//@シナリオデモ開始処理
			if ( $1 == 0 ) {
					chara カメラ設定 プログラムデモカメラ \
						-c 1 \
						-p 5891,17688,6254 -t 5942,17717,3904 \
						-r 4088,2034,0 -f 2350 \
						-a 200 \
						-i 2 2 0 0 \
						-s 1 \
						-z d:CAMERA_CUT_IN
			} else {
					chara カメラ設定 プログラムデモカメラ \
						-c 1 \
						-p 5493,16864,17556 -t 6040,17616,20286 \
						-r 3924,129,0 -f 2884 \
						-a 200 \
						-i 2 2 0 0 \
						-s 1 \
						-z d:CAMERA_CUT_IN
			}
		}
	}

	proc ソリダス蛇手外し終了 {
		@シナリオデモ終了処理
		// 勝利プロックでフェードアウトよりもプライオリティを高くするために一回killして起動しなおす。
		mesg シネマスクリーン シネマ kill
		chara カメラ設定 プログラムデモカメラ -s -1
		#ifndef d:BOSS_MODE
			if (`command ゲームオーバーチェック` == 0 ) {
				@rp_愛国説教ＣＡＬＬ	//愛国ＣＡＬＬ
			}
		#endif
	}

