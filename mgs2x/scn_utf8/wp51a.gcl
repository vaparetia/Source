// ------------------------------------
// 各gclで必要なdefine
// ------------------------------------
// 共通プロック切り分け用
#define		STAGE_VR		1		// モード
#define		STAGE_WP51A		1		// ステージ名
#define		VR_WEAPON		1		// VRステージの呼び分け

#define		STAGE_START		1		// ステージ開始直後処理


// ------------------------------------
// 各種スイッチ用define
// ------------------------------------
// デバッグ関係
#ifdef	d:FIX_MODE
	#define		DEBUG_CHARA		0		// デバッグキャラ全体(FIX時は0)
#else
	#define		DEBUG_CHARA		0		// デバッグキャラ全体
#endif
#define		CHARA_CAMERA	0		// キャラ追従カメラ
#define		TARGET_CHARA	敵兵:01	// キャラ追従カメラのターゲット
#define		SCREENSHOT		0		// スクリーンショット
#define		USB_KEY			0		// USBキーボード


// ------------------------------------
// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME			ws51a
#define		KMS_NAME			ws51a
#define		TONBO_KMS_NAME		ws51a_tonbo
#define		LINE_KMS_NAME		ws51a_line

// キャラクター関係
#define		PLAYER		ライデン


// ------------------------------------
// ローカル変数
// ------------------------------------


// ------------------------------------
// 的ルート番号
// ------------------------------------
enum M_R {
	//	スティンガー１面用
//	ライデンルート０ = 0,	// 欠番
	ライデンルート１ = 1,

	スネークルート２, スネークルート３, スネークルート４,

	前作スネークルート５, 前作スネークルート６, 前作スネークルート７, 前作スネークルート８, 前作スネークルート９,
}


// ------------------------------------
// include
// ------------------------------------

#include "rai_wp51a.mh"		// 強制モーションリスト

