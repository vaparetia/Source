// ------------------------------------
// マップ設定
// ------------------------------------
chara マップ 武器訓練スティンガー１面 -k d:KMS_NAME -h d:HZX_NAME,0 -l $s:ＶＲライトファイル名

command マップ設定 武器訓練スティンガー１面 -set {
	// ローカルの初期化
	// ------------------------------------
	@ローカル変数初期化		// ローカルで使用する変数で初期化をする場合はここで

	// ＶＲで必要な基本プロックのセット(vr_common.hで定義)
	// サウンドの基本パック、ＶＲの基本システム、プレイヤー、ゴール等を設定します
	// ※このプロックを使用する時は「ＶＲクリア時処理」というプロックが必要です
	// ------------------------------------
	@ＶＲ共通プロックセット sna_wp51a rai_wp51a d:VR_GOAL_TARGET 0 0 -2000

	// ＶＲウィンドウの設定
	// ------------------------------------
	@武器訓練スティンガー１面ＶＲウィンドウ設定

	// クリア時に呼ばれるものの設定
	// ------------------------------------
	@ＶＲクリア設定 p:load_wp52a p:load_wp51a

	// ステージに引かれるライン
	// ------------------------------------
	@ＶＲアウトライン d:KMS_NAME d:TONBO_KMS_NAME d:LINE_KMS_NAME

	// 設定値を変更する場合は以下のプロック内で設定
	// ------------------------------------
	@設定値変更				// 敵兵や的のパラメータをステージ限定で変える時はここで
	@プラグイン設定			// プレイヤーのプラグインがいる時はここで
	@エルード設定
	@ジャンプ設定

	// 的関係の設定
	// ------------------------------------
	@ＶＲ標的スティンガー１面設定				// ＶＲシステム起動後に呼ぶ

	// ＢＧＭの設定(プレイヤー→敵兵→BGMの順で呼ぶ。的の場合は関係ないがとりあえずここに)
	// ------------------------------------
	@ＢＧＭ設定

	// アイテムの設定
	// ------------------------------------
	@アイテム設定

	// 光源、オブジェクト、カメラ関連の設定
	// ------------------------------------
	@スティンガー１面落下死設定
	@ＶＲフォグ設定 d:VR_FOG:朝Ｎ d:VR_FOG:朝Ｆ d:VR_FOG:夕Ｎ d:VR_FOG:夕Ｆ -5000 40000
	@カメラセット						// chara カメラとベースのカメラを設定
	@武器訓練スティンガー１面カメラ設定	// ステージ固有のカメラ設定がいる時はこのプロックで
	@ＶＲキャラ用ライト設置				// vr_common.hに定義。必ず最後に設定
#if d:DEBUG_CHARA
//	@デバッグキャラセット
#endif

}

//初期マップの表示
command マップ表示 -show 武器訓練スティンガー１面


//###################################################################################
//									各proc設定
//###################################################################################



//###################################################################################
//									全マップ共通
//###################################################################################
	// ------------------------------------
	// 全マップ共通
	// ------------------------------------
	//------------------------------------------------------------
	// ＶＲウィンドウの設定と表示
	//------------------------------------------------------------
	proc 武器訓練スティンガー１面ＶＲウィンドウ設定 {
		#if d:DEBUG_PRINT
			print 'vr_window_set'
		#endif

		@ＶＲウィンドウ設定	[VRMSG_J:VRM_WPN_STG_wp51a] [VRMSG_E:VRM_WPN_STG_wp51a] [VRMSG_G:VRM_WPN_STG_wp51a] \	// 日、英、独
							[VRMSG_F:VRM_WPN_STG_wp51a] [VRMSG_I:VRM_WPN_STG_wp51a] [VRMSG_S:VRM_WPN_STG_wp51a] \	// 仏、伊、西
							[VRMSG_K:VRM_WPN_STG_wp51a] \															// 韓
							p:ＶＲステージ開始時処理								// 終了プロック


		// ＶＲウィンドウを表示する
		mesg ＶＲウィンドウ ＶＲウィンドウ君 開く

		// スタート時とクリア時に使用するカットインカメラ
		chara カメラ カットインカメラ		-c 0 -l 0 -p 0

		// スタート時のカメラ(必要な場合)
		chara カメラ設定 カットインカメラ \
			-c 1 \	
			-p 0,6600,360 -t 0,0,-2000 \
			-r 800,2048,0 -f 7000 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1
	}

	//------------------------------------------------------------
	// ステージ開始時処理
	//------------------------------------------------------------
	proc ＶＲステージ開始時処理 {
		#if d:DEBUG_PRINT
			print 'game_start!!!!!'
		#endif

		// プレイヤーやパッドの制御等を行う a_stdproc.hで定義
		@全ミッション共通ステージ開始時処理

		// カメラワークスタート(必要な場合)
		// 全体図
		chara カメラ設定 カットインカメラ \
			-c 1 \	
			-p 0,20000,25000 -t 0,13850,14700 \
			-r 350,2048,0 -f 12000 \
			-a 200 \
			-i 4 4 d:START_CAMERA_CHANGE_TIME d:START_CAMERA_CHANGE_TIME \
			-s 1

		chara delay ディレイ \
			-time d:START_CAMERA_CHANGE_TIME \
			-exec {
				chara カメラ設定 カットインカメラ -s -1
			}
	}

	// ------------------------------------
	// クリア時の処理
	// ------------------------------------
	proc ＶＲクリア時処理 {
		#if d:DEBUG_PRINT
			print 'clear'
		#endif

		// 強制モーションを発動
		@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_1 3748

		// クリア時にカメラアングルを変える
		chara カメラ設定 クリア時カメラ \
			-c 1 \
			-p -2250,1500,1300 -t -250,1100,-2150 \
			-r 65,1700,0 -f 4000 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}

	//------------------------------------------------------------
	// ステージ開始直後処理
	//------------------------------------------------------------
	proc ゲーム開始直後処理 {
		// 初期配置標的の起動（command ＶＲステージスタート の起動直後に行う必要がある）
		@ＶＲ初期配置標的スティンガー１面設定
	}


	// ------------------------------------
	// パラメータ系の変更
	// ------------------------------------
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT
			print 'localvar_init'
		#endif

		// 的管理用各種フラグを初期化する
		$$b:標的セット数 = 0;
		$$i:標的フラグ = 0;

//		$$i:標的フラグＡ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST );
//		$$i:標的フラグＢ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST );
//		$$i:標的フラグＣ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    );
		$$i:標的フラグＤ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST                  | d:VR_TRG_WAIT );
//		$$i:標的フラグＥ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST | d:VR_TRG_WAIT );
//		$$i:標的フラグＦ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    | d:VR_TRG_WAIT );
//		$$i:標的フラグＧ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST                  | d:VR_TRG_WAIT | d:VR_TRG_CIRCLE );
//		$$i:標的フラグＨ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST | d:VR_TRG_WAIT | d:VR_TRG_CIRCLE );
//		$$i:標的フラグＩ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    | d:VR_TRG_WAIT | d:VR_TRG_CIRCLE );
//		$$i:標的フラグＪ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST                  | d:VR_TRG_WAIT | d:VR_TRG_NO_APPEAR_EF );
//		$$i:標的フラグＫ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST | d:VR_TRG_WAIT | d:VR_TRG_NO_APPEAR_EF );
//		$$i:標的フラグＬ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    | d:VR_TRG_WAIT | d:VR_TRG_NO_APPEAR_EF );
	}

	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT
			print 'status_set'
		#endif

		// 初期装備の設定
		$w:武器弾数Ｒ[ d:武器:スティンガー ] = 24

//		$w:武器 = d:武器:スティンガー
		command シナリオ前武器変更	-number d:武器:スティンガー
	}

	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif

		command プラグイン自動ジャンプ
		command プラグイン落下
	}

	// エルード
	// ------------------------------------
	proc エルード設定 {
		#if d:DEBUG_PRINT
		print 'beyond_set'
	#endif

		trap by001 d:PLAYER \
			-mask 入る \
			-exec {
				command プレイヤー状態取得 ;
				if( ($status == 0) || \
					($status & d:PFLAG_WALK) || \
					($status & d:PFLAG_DAMAGED) || \
					($status & d:PFLAG_SUBJECT) ) {
					@南向き柵なしビヨンド発動 by001 1000 $4 4000 6000 0 (d:BY_NOFOOTSHADOW | d:BY_NO_STAMP)
					command エルード移動範囲設定 -x_range 4250 5750
				}
			}
		trap by001 d:PLAYER \
			-mask いる \
			-state d:TRP_STATE_FORCE \
			-dir 0 256 \	//方向指定
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,500 d:CAM_MAX,d:CAM_MAX,12000 \
					-l d:CAM_MIN,d:CAM_MIN,1500 d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 650,2250,0 \
					-f 4000 \
					-a 200 \
					-i 0 -1 0 0 \
					-s 1

			}
		trap by001 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_ELUDE \
			-dir 2048 256 \	//方向指定
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,1000,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,12000 \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 200,2250,0 \
					-f 7000 \
					-a 230 \
					-i 2 3 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}
	}

	proc スティンガー１面落下死設定 {

		// エルード落下死
		trap de001 d:PLAYER \
			-mask 入る \
			-state d:TRP_STATE_ELUDE_FALL \
			-exec {
//				@落下死処理
				@ジャンプ落下死発動 0x0004 -6000
			}

		// 通常落下死
		trap de002 d:PLAYER \
			-mask 入る \
			-exec {
				// エルード状態以外でトラップに入る
				if ( !(`command プレイヤー状態取得` & d:PFLAG_ELUDE) ) {
					#if d:DEBUG_PRINT
						print 'プレイヤー状態はエルード以外。'
					#endif

					// 位置補正用一時変数
					if( 2000 > $i:プレイヤー位置Ｚ ){ // 壁面に近い場合は距離を離す
						eval( $i:プレイヤー初期Ｚ位置 = 2000 );
					} else {
						eval( $i:プレイヤー初期Ｚ位置 = $i:プレイヤー位置Ｚ );
					}
					mesg プレイヤー d:PLAYER position $i:プレイヤー位置Ｘ,$i:プレイヤー位置Ｙ,$i:プレイヤー初期Ｚ位置

					@ジャンプ落下死発動 0x0004 -1000
				}
			}

		// ゲームオーバー終了用
		trap de003 d:PLAYER \
			-mask 入る \
			-state d:TRP_STATE_ELUDE_FALL \
			-exec {
				if(`%ゲームオーバーチェック` == 0 ){
					command ゲームオーバー処理終了
				}
			}
	}

	// ジャンプ落下死開始処理
	// @ジャンプ落下死発動内で使用される(fall.h)
	proc ジャンプ落下死開始処理{

		chara カメラ設定 クリア時カメラ \
			-c 0 \
			-b d:CAM_MIN,1000,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,12000 \
			-l d:CAM_MIN,-65000,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 950,2048,0 \
			-f 7000 \
			-a 200 \
			-i 2 -1 0 0 \
			-z d:CAMERA_NO_CUSHION \
			-s 1

		@ゲームオーバー開始処理
	}
	// ゲームオーバー終了処理
	proc ゲームオーバー終了処理{
	}

