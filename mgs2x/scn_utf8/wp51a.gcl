	// 台登り
	// ------------------------------------
	proc ジャンプ設定 {
		#if d:DEBUG_PRINT
			print 'jump_set'
		#endif

		trap ky001 d:PLAYER \
			-mask 入る \
			-exec {
				@ジャンプ発動 ky001 1000 10
			}
	}



//###################################################################################
//									 的兵
//###################################################################################

	// ------------------------------------
	// スティンガー１面
	// ------------------------------------
	// 敵兵や的の処理
	// ------------------------------------
	proc ＶＲ標的スティンガー１面設定 {

		// ライデン or タキシードスネークを選択
		if ( ($s:選択プレイヤー == ライデン) ||  ($s:選択プレイヤー == タキシードスネーク) ) {

			if( $s:選択プレイヤー == タキシードスネーク) {
				$$i:標的フラグ = ( $$i:標的フラグＤ | d:VR_TRG_HIDESTART );
			} else {
				$$i:標的フラグ = $$i:標的フラグＤ;
			}

			// act 1 ----------
			chara ＶＲ移動的 移動的:01 \
				-flag $$i:標的フラグ \
				-route d:M_R:ライデンルート１ \
				-dir 0 1024

		// スネーク or プリスキンを選択
		} else if ( ($s:選択プレイヤー == スネーク) || ($s:選択プレイヤー == プリスキン) ) {

			command foreach -argc 2 -repeat 3 \
			-data { \
				// 的名,     ルート
				// act 1 ----------
				{ 移動的:01, d:M_R:スネークルート２ }\
				{ 移動的:02, d:M_R:スネークルート３ }\
				{ 移動的:03, d:M_R:スネークルート４ }\
			} \
			-exec { \
				if( $s:選択プレイヤー == プリスキン ) {
					$$b:標的セット数 = $$b:標的セット数 + 1;
					if( $$b:標的セット数 % 2 ) {
						$$i:標的フラグ = ( $$i:標的フラグＤ | d:VR_TRG_HIDESTART );
					} else {
						$$i:標的フラグ = ( $$i:標的フラグＤ | d:VR_TRG_VISIBLESTART );
					}
				} else {
					$$i:標的フラグ = $$i:標的フラグＤ;
				}

				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグ \
					-route $2 \
					-dir 0 1024
			}

		//	前作スネークを選択
		} else if ( $s:選択プレイヤー == 前作スネーク ) {

			command foreach -argc 2 -repeat 1 \
			-data { \
				// 的名,     ルート
				// act 1 ----------
				{ 移動的:01, d:M_R:前作スネークルート５ }\
//				{ 移動的:02, d:M_R:前作スネークルート６ }\
//				{ 移動的:03, d:M_R:前作スネークルート７ }\
//				{ 移動的:04, d:M_R:前作スネークルート８ }\
//				{ 移動的:05, d:M_R:前作スネークルート９ }\
			} \
			-exec { \
				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグＤ \
					-route $2 \
					-dir 0 1024
			}

		}

	}

	proc ＶＲ初期配置標的スティンガー１面設定 {
		// 共通標的 （主にライデン）
		mesg ＶＲ的共通 移動的:01 移動開始

		// 他キャラ選択時の追加標的s
		// スネーク or プリスキン
		if ( ($s:選択プレイヤー == スネーク) || ($s:選択プレイヤー == プリスキン) ) {
			mesg ＶＲ的共通 移動的:02 移動開始
			mesg ＶＲ的共通 移動的:03 移動開始
			mesg ＶＲ的共通 移動的:04 移動開始
		}
	}


//###################################################################################
//									 ＢＧＭ
//###################################################################################

	// ------------------------------------
	// ＢＧＭの設定
	// ------------------------------------
	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT
			print 'bgm_set'
		#endif

		chara ＢＧＭマネージャー ＢＧＭマネ
	}


//###################################################################################
//									 アイテム
//###################################################################################

	// ------------------------------------
	// アイテムの設定
	// ------------------------------------
	// 再発生が必要な時は以下のプロックの中を記述する
	// ------------------------------------
	proc アイテム取得時番号設定 $:ボックス名 {
		#if d:DEBUG_PRINT
			print 'item_no_set'
		#endif
	}
	// アイテムの設置
	// ------------------------------------
	proc アイテム設定 {
		#if d:DEBUG_PRINT
			print 'item_set'
		#endif
	}



//###################################################################################
//									 エフェクト
//###################################################################################

	// ------------------------------------
	// 光源関係
	// ------------------------------------
	// フォグ
	// ------------------------------------
	// キャラ用光源(マップの設置が終わってから設定することで、キャラだけに光を当てる)
	// ------------------------------------



//###################################################################################
//									 カメラ
//###################################################################################
	// ------------------------------------
	// カメラ関係の設定
	// ------------------------------------
	// ステージカメラ設定
	// ------------------------------------
	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'chara_camera & stage_camera_set'
		#endif

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0
		chara カメラ メインカメラ		-c 0 -l 2 -p 40
		chara カメラ モーションカメラ	-c 0 -l 2 -p 30
		chara カメラ クリア時カメラ		-c 0 -l 0 -p 10

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,12000 \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 150,2048,0 \
			-f 9000 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}
	// ステージ固有のカメラ設定
	// ------------------------------------
	proc 武器訓練スティンガー１面カメラ設定 {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif
	}



//###################################################################################
//									 その他
//###################################################################################


// -----------------------------------------------------------------------------------
// 以下デバッグ専用proc
// -----------------------------------------------------------------------------------
// デバッグキャラ
// ------------------------------------
proc デバッグキャラセット {
	#if d:DEBUG_PRINT
		print 'debug_chara_set'
	#endif

	#if d:CHARA_CAMERA
		chara キャラカメラ 敵兵カメラ \
			-c d:TARGET_CHARA \
			-s -920,610,200 \
			-r -200,1024,0
	#endif

	#if d:SCREENSHOT
		chara スクリーンショット shot
	#endif

	#if d:USB_KEY
		chara USBキーボード実行 test \
			-e d:KBD_ESC {
				mesg プレイヤー d:PLAYER position -5500, -13000, -500
			} \
	#endif
}

