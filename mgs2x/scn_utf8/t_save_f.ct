		[TO_ＳＡＶＥ後初めて__f:スネーク_008]
	}

	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ後初めて__f:オタコン_009]
	}

	talk スネーク 標準 -m {
		[TO_ＳＡＶＥ後初めて__f:スネーク_010]
	}
} //v
}

