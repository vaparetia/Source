				eval($w:rfp_PR_ＳＡＶＥ後特殊会話 = d:RP_ＳＡＶＥ後会話:しばらくＳＡＶＥしてない)
				eval($f:rfp_PR_ＳＡＶＥ後特殊会話再生します = 1)

		//出てはいけない条件ＸＸＸＸＸＸＸＸＸＸ
		}else if((	($w:アイテム == d:アイテム:ダンボール) || \
				($w:アイテム == d:アイテム:ダンボールＢ) || \
				($w:アイテム == d:アイテム:ダンボールＣ) || \
				($w:アイテム == d:アイテム:濡れダンボール) || \
				($w:アイテム == d:アイテム:ダンボールＤ) || \
				($w:アイテム == d:アイテム:ダンボールＥ) ) && \
			(!$f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:ダンボール]) && \
			(!$f:rfp_ローズさん落込んでます) ){

				eval($f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:ダンボール] = 1)
				eval($w:rfp_PR_ＳＡＶＥ後特殊会話 = d:RP_ＳＡＶＥ後会話:ダンボール)
				eval($f:rfp_PR_ＳＡＶＥ後特殊会話再生します = 1)

		}else if(($w:アイテム == d:アイテム:ゴル兵制服) && \
					(!$f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:変装]) && \
					(!$f:rfp_ローズさん落込んでます) ){
				eval($f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:変装] = 1)
				eval($w:rfp_PR_ＳＡＶＥ後特殊会話 = d:RP_ＳＡＶＥ後会話:変装)
				eval($f:rfp_PR_ＳＡＶＥ後特殊会話再生します = 1)

		}else if(($w:アイテム == d:アイテム:煙草) && \
					(!$f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:煙草])  && \
					(!$f:rfp_ローズさん落込んでます) ){
				eval($f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:煙草] = 1)
				eval($w:rfp_PR_ＳＡＶＥ後特殊会話 = d:RP_ＳＡＶＥ後会話:煙草)
				eval($f:rfp_PR_ＳＡＶＥ後特殊会話再生します = 1)

		}else if(($w:武器 == d:武器:雑誌) && \
					(!$f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:エロ本])  && \
					(!$f:rfp_ローズさん落込んでます) ){
				eval($f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:エロ本] = 1)
				eval($w:rfp_PR_ＳＡＶＥ後特殊会話 = d:RP_ＳＡＶＥ後会話:エロ本)
				eval($f:rfp_PR_ＳＡＶＥ後特殊会話再生します = 1)

		//わりとてきとーＸＸＸＸＸＸＸＸＸｘ
		}else if( ( d:ST:P005_05_R02ライデン昇降機上昇５無線デモ２終了 <= $w:p_story && \
					$w:p_story < d:ST:P014_01_P01ピーター遭遇１ポリゴンデモ１開始 ) && \
					(!$f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:しばらくしてから]) ){
				eval($f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:しばらくしてから] = 1)
				eval($w:rfp_PR_ＳＡＶＥ後特殊会話 = d:RP_ＳＡＶＥ後会話:しばらくしてから)
				eval($f:rfp_PR_ＳＡＶＥ後特殊会話再生します = 1)

		//わりとてきとーＸＸＸＸＸＸＸＸＸｘ
		}else if( ( d:ST:P005_05_R02ライデン昇降機上昇５無線デモ２終了 <= $w:p_story && \
					$w:p_story < d:ST:P058_01_P01エマ救出１ポリゴンデモ１開始 ) && \
					(!$f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:帰還パーティー]) && \
					(!$f:rfp_ローズさん落込んでます) ){
				eval($f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:帰還パーティー] = 1)
				eval($w:rfp_PR_ＳＡＶＥ後特殊会話 = d:RP_ＳＡＶＥ後会話:帰還パーティー)
				eval($f:rfp_PR_ＳＡＶＥ後特殊会話再生します = 1)

		}else if( ( d:ST:P035_01_R01ファットマン爆弾解体終了１無線デモ１終了 <= $w:p_story && \
					$w:p_story < d:ST:P058_01_P01エマ救出１ポリゴンデモ１開始 ) && \
					(!$f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:新鮮]) && \
					(!$f:rfp_ローズさん落込んでます) ){
				eval($f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:新鮮] = 1)
				eval($w:rfp_PR_ＳＡＶＥ後特殊会話 = d:RP_ＳＡＶＥ後会話:新鮮)
				eval($f:rfp_PR_ＳＡＶＥ後特殊会話再生します = 1)

		//エラーでばぐっち！
		}else {
			@rpr_ＳＡＶＥ後会話フラグクリア
		}

	}else {
		@rpr_ＳＡＶＥ後会話フラグクリア
	}
}


