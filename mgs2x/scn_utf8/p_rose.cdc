proc rpr_PR_未ＳＡＶＥ終了＿落込み {

	if(!$f:rfp_PR_未ＳＡＶＥ終了＿落込み１聞いた) {
		@rp_PR_未ＳＡＶＥ終了＿落込み１
		eval($f:rfp_PR_未ＳＡＶＥ終了＿落込み１聞いた = 1)
	
	}else if( ($w:p_story < d:ST:P070_01_P01ＡＧ起動１ポリゴンデモ１開始) && \
				(!$f:rfp_PR_未ＳＡＶＥ終了＿落込み２聞いた) ){
		@rp_PR_未ＳＡＶＥ終了＿落込み２
		eval($f:rfp_PR_未ＳＡＶＥ終了＿落込み２聞いた = 1)
	
	}else if(!$f:rfp_PR_未ＳＡＶＥ終了＿落込み３聞いた){
		@rp_PR_未ＳＡＶＥ終了＿落込み３
		eval($f:rfp_PR_未ＳＡＶＥ終了＿落込み３聞いた = 1)

	}else if(!$f:rfp_PR_未ＳＡＶＥ終了＿落込み４聞いた){
		@rp_PR_未ＳＡＶＥ終了＿落込み４
		eval($f:rfp_PR_未ＳＡＶＥ終了＿落込み４聞いた = 1)
	
	}else {
		rand 4
		eval($w:rfp_rand = $status)
		if($w:rfp_rand < 1){
			@rp_PR_未ＳＡＶＥ終了＿落込み１

		}else if( ($w:rfp_rand < 2) && \
					($w:p_story < d:ST:P070_01_P01ＡＧ起動１ポリゴンデモ１開始) ){
			@rp_PR_未ＳＡＶＥ終了＿落込み２

		}else if($w:rfp_rand < 3){
			@rp_PR_未ＳＡＶＥ終了＿落込み３

		}else{
			@rp_PR_未ＳＡＶＥ終了＿落込み４
		}
	}
}

proc rpr_PR_ＳＡＶＥ後＿ご機嫌ななめ {
	//ＳＡＶＥしなかった
	if( ( ($w:rfp_ＳＡＶＥ選択肢返り値 != 0)  || \
		  ( ($w:rfp_ＳＡＶＥ選択肢返り値 == 0) && ($b:rfp_ＳＡＶＥした結果 == 1) ) ) && \
		(!$f:rfp_PR_未ＳＡＶＥ終了＿喧嘩直後１聞いた) ) {
		@rp_PR_未ＳＡＶＥ終了＿喧嘩直後１
		eval($f:rfp_PR_未ＳＡＶＥ終了＿喧嘩直後１聞いた = 1)
	
	}else if(!$f:rfp_PR_未ＳＡＶＥ終了＿喧嘩直後２聞いた){
		@rp_PR_未ＳＡＶＥ終了＿喧嘩直後２
		eval($f:rfp_PR_未ＳＡＶＥ終了＿喧嘩直後２聞いた = 1)
	
	}else if(!$f:rfp_PR_未ＳＡＶＥ終了＿喧嘩直後３聞いた){
		@rp_PR_未ＳＡＶＥ終了＿喧嘩直後３
		eval($f:rfp_PR_未ＳＡＶＥ終了＿喧嘩直後３聞いた = 1)

	}else if(!$f:rfp_PR_未ＳＡＶＥ終了＿喧嘩直後４聞いた){
		@rp_PR_未ＳＡＶＥ終了＿喧嘩直後４
		eval($f:rfp_PR_未ＳＡＶＥ終了＿喧嘩直後４聞いた = 1)
	
	}else {
		rand 4
		eval($w:rfp_rand = $status)
		if( ($w:rfp_rand < 1) && \
			( ($w:rfp_ＳＡＶＥ選択肢返り値 != 0)  || \
			  ( ($w:rfp_ＳＡＶＥ選択肢返り値 == 0) && ($b:rfp_ＳＡＶＥした結果 == 1) ) ) ){
			@rp_PR_未ＳＡＶＥ終了＿喧嘩直後１

		}else if($w:rfp_rand < 2){
			@rp_PR_未ＳＡＶＥ終了＿喧嘩直後２

		}else if($w:rfp_rand < 3){
			@rp_PR_未ＳＡＶＥ終了＿喧嘩直後３

		}else{
			@rp_PR_未ＳＡＶＥ終了＿喧嘩直後４
		}
	}
}

proc rpr_PR_ソリダス戦中＿ＳＡＶＥ前 {
	if(!$f:rfp_PR_ソリダス戦中＿ＳＡＶＥ前１聞いた) {
		@rp_PR_ソリダス戦中＿ＳＡＶＥ前１
		eval($f:rfp_PR_ソリダス戦中＿ＳＡＶＥ前１聞いた = 1)
	
	}else if(!$f:rfp_PR_ソリダス戦中＿ＳＡＶＥ前２聞いた) {
		@rp_PR_ソリダス戦中＿ＳＡＶＥ前２
		eval($f:rfp_PR_ソリダス戦中＿ＳＡＶＥ前２聞いた = 1)
	
	}else {
		rand 2
		eval($w:rfp_rand = $status)
		if($w:rfp_rand < 1){
			@rp_PR_ソリダス戦中＿ＳＡＶＥ前１
		}else {
			@rp_PR_ソリダス戦中＿ＳＡＶＥ前２
		}
	}
}


proc rpr_PR_ソリダス戦中＿ＳＡＶＥ後 {
	if(!$f:rfp_PR_ソリダス戦中＿ＳＡＶＥ後１聞いた) {
		@rp_PR_ソリダス戦中＿ＳＡＶＥ後１＿１
		@rp_PR_ソリダス戦中＿ＳＡＶＥ後１＿２
		eval($f:rfp_PR_ソリダス戦中＿ＳＡＶＥ後１聞いた = 1)
	
	}else if(!$f:rfp_PR_ソリダス戦中＿ＳＡＶＥ後２聞いた) {
		@rp_PR_ソリダス戦中＿ＳＡＶＥ後２＿１
		@rp_PR_ソリダス戦中＿ＳＡＶＥ後２＿２
		eval($f:rfp_PR_ソリダス戦中＿ＳＡＶＥ後２聞いた = 1)
	
	}else {
		rand 2
		eval($w:rfp_rand = $status)
		if($w:rfp_rand < 1){
			@rp_PR_ソリダス戦中＿ＳＡＶＥ後１＿１
		}else {
			@rp_PR_ソリダス戦中＿ＳＡＶＥ後２＿１
		}
	}
}

proc rpr_PR_ＳＡＶＥ前＿ご機嫌ななめ {
	//初怒り
	if(!$f:rfp_PR_ＳＡＶＥ前＿怒らせた後１聞いた){
		eval($f:rfp_PR_ＳＡＶＥ前＿怒らせた後１聞いた = 1)
		@rp_PR_ＳＡＶＥ前＿怒らせた後１
		@rp_ＳＡＶＥさせないセット
/*
		selectmenu  2 -m  { 
			[ＳＡＶＥ選択肢:セーブさせない] 
			[ＳＡＶＥ選択肢:セーブしない] 
		}
*/
		@rp_PR_ＳＡＶＥ前＿怒らせた後２
		@rp_PR_ＳＡＶＥ前＿怒らせた後３
		eval($f:rfp_PR_ローズさんが激怒してます！ = 0)
		command varsave $f:rfp_PR_ＳＡＶＥ前＿怒らせた後１聞いた $f:rfp_PR_ローズさんが激怒してます！

	//怒りデフォルト
	}else {
		@rpr_PR_ＳＡＶＥ前＿喧嘩直後
	}
}



proc rpr_ＳＡＶＥ前デフォルト {
	if(d:ST:P073_01_R01通路Ａ１無線機デモ１終了 <= $w:p_story && \
		$w:p_story < d:ST:P080_28_P12ＡＧ浮上２８ポリゴンデモ１２終了 ){
			@rp_PR_無言ローズ
			eval($f:rfp_PR_ＳＡＶＥ前フラグ処理する = 0)

	//拷問開放デモ無線前
	}else if( (d:ST:P070_21_P12ＡＧ起動２１ポリゴンデモ１２終了 <= $w:p_story && \
				$w:p_story < d:ST:P070_23_R04ＡＧ起動２３無線機デモ４終了) && \
				(!$f:rfp_w41a_拘束開放されました) ){
			@rp_PR_無言ローズ
			eval($f:rfp_PR_ＳＡＶＥ前フラグ処理する = 0)
			eval($f:rfp_P070_23_R04ＡＧ起動２３無線機デモ４再生します = 1) 

		eval($w:p_story =  d:ST:P070_23_R04ＡＧ起動２３無線機デモ４終了)
		//	プレイヤー初期位置を代入
		eval($i:プレイヤー初期Ｘ位置 = -2000)
		eval($i:プレイヤー初期Ｚ位置 = -3400)
		//	リスタートかけてゲームに戻る
		eval ($f:w41a_主観デモ完全終了フラグ = d:TRUE)
		eval ($s:登場ポイント = 拷問直後)
		command varsave 

	//ボス戦中等
	}else if( \
			 (d:ST:P028_01_P01爆弾解体後フォーチュン再登場１ポリゴンデモ１終了 <= $w:p_story && \
			 	$w:p_story < d:ST:P029_01フォーチュン戦終了) || \
			 (d:ST:P032_01_P01ファットマン登場１ポリゴンデモ１終了 <= $w:p_story && \
			 	$w:p_story < d:ST:P035_01_R01ファットマン爆弾解体終了１無線デモ１開始) || \
			 (d:ST:P045_01_P01ハリアー登場１ポリゴンデモ１終了 <= $w:p_story && \
			 	$w:p_story < d:ST:P046_01_P01ハリアー戦勝利１ポリゴンデモ１開始) || \
			 (d:ST:P055_04_P03ヴァンプ戦前４ポリゴンデモ３終了 <= $w:p_story && \
			 	$w:p_story < d:ST:P057_01_P01ヴァンプ戦終了１ポリゴンデモ１開始) || \
			 (d:ST:P068_01_P01ヴァンプ狙撃前１ポリゴンデモ１終了 <= $w:p_story && \
			 	$w:p_story < d:ST:P069_01_P01ヴァンプ狙撃終了１ポリゴンデモ１開始) || \
			 (`@rp_緊張してください`) ){
				@rpr_PR_ＳＡＶＥ前＿緊迫
				eval($f:rfp_PR_ＳＡＶＥ前フラグ処理する = 0)


	}else if(d:ST:P080_28_P12ＡＧ浮上２８ポリゴンデモ１２終了 <= $w:p_story && \
		$w:p_story < d:ST:P082_01_P01エンディング１ポリゴンデモ１開始 ){
			@rpr_PR_ソリダス戦中＿ＳＡＶＥ前
			eval($f:rfp_PR_ＳＡＶＥ前フラグ処理する = 0)

	}else if($f:rfp_PR_ローズさんが激怒してます！){
		@rpr_PR_ＳＡＶＥ前＿ご機嫌ななめ
		eval($f:rfp_PR_ＳＡＶＥ前フラグ処理する = 0)

	}else if($f:rfp_ローズさん落込んでます){
			@rpr_PR_ＳＡＶＥ前＿落込み
			eval($f:rfp_PR_ＳＡＶＥ前フラグ処理する = 1)

			if( ($w:p_story == d:ST:P070_23_R04ＡＧ起動２３無線機デモ４終了) && \
				(!$f:w41a_主観デモ完全終了フラグ) ){
				eval($f:w41a_主観デモ完全終了フラグ = 1)
				command varsave $f:w41a_主観デモ完全終了フラグ

			}


	}else {
		@rpr_PR_ＳＡＶＥ前＿普通
		eval($f:rfp_PR_ＳＡＶＥ前フラグ処理する = 1)
	}
}


proc rpr_ＳＡＶＥ後会話フラグクリア {
	eval($w:rfp_PR_ＳＡＶＥ後特殊会話 = 0)
	eval($f:rfp_PR_ＳＡＶＥ後特殊会話再生します = 0)
	eval($f:rfp_PR_ＳＡＶＥ前フラグ処理する = 0)
}


proc rpr_ＳＡＶＥ前フラグ処理 {
	//ダンボール会話
	//無線一回目
	if( ($w:rfp_callcount <= 1) || (`prefreq` != 14096) ){
		if( (d:ST:P058_08_P04エマ救出８ポリゴンデモ４終了 <= $w:p_story && \
			$w:p_story < d:ST:P065_01_P01エマＬ脚１ポリゴンデモ１開始) && \
			($f:エマ存在フラグ) ){
			command ゲットエマ手繋ぎ状況 $b:rfp_エマ手つなぎ状況
		}
		//押し入り,	//P052_01_R01_ローズ無線１無線機デモ１
		if( ( d:ST:P049_12_R05大統領１２無線機デモ５終了 <= $w:p_story && \
					$w:p_story < d:ST:P065_01_P01エマＬ脚１ポリゴンデモ１開始 ) && \
					(!$f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:押し入り]) ){
				eval($f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:押し入り] = 1)
				eval($w:rfp_PR_ＳＡＶＥ後特殊会話 = d:RP_ＳＡＶＥ後会話:押し入り)
				eval($f:rfp_PR_ＳＡＶＥ後特殊会話再生します = 1)

		}else if( ( d:ST:P049_12_R05大統領１２無線機デモ５終了 <= $w:p_story && \
					$w:p_story < d:ST:P065_01_P01エマＬ脚１ポリゴンデモ１開始 ) && \
					($f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:押し入り]) && \
					(!$f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:押し入り後]) ){
				eval($f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:押し入り後] = 1)
				eval($w:rfp_PR_ＳＡＶＥ後特殊会話 = d:RP_ＳＡＶＥ後会話:押し入り後)
				eval($f:rfp_PR_ＳＡＶＥ後特殊会話再生します = 1)

		//すねーくのいたいってやつ
		}else if( ( d:ST:P036_13_R04忍者登場１３無線デモ４終了 <= $w:p_story && \
					$w:p_story < d:ST:P038_01_S01網膜チェック１シナリオデモ１開始 ) && \
					(!$f:rfp_スネークの遺体の話聞いた) && \
					(!$f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:スネークの遺体]) ){
				eval($f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:スネークの遺体] = 1)
				eval($w:rfp_PR_ＳＡＶＥ後特殊会話 = d:RP_ＳＡＶＥ後会話:スネークの遺体)
				eval($f:rfp_スネークの遺体の話聞いた = 1)
				command varsave $f:rfp_スネークの遺体の話聞いた
				eval($f:rfp_PR_ＳＡＶＥ後特殊会話再生します = 1)

		}else if( (d:ST:P035_01_R01ファットマン爆弾解体終了１無線デモ１終了 <= $w:p_story && \
					$w:p_story <  d:ST:P036_01_P01忍者登場１ポリゴンデモ１開始) && \
					($f:rfp_PC_ファットマン戦後＿最終爆弾ズバリ聞いた) && \
					(!$f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:忍者登場前＿ローズ助けられ]) ){
				eval($f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:忍者登場前＿ローズ助けられ] = 1)
				eval($w:rfp_PR_ＳＡＶＥ後特殊会話 = d:RP_ＳＡＶＥ後会話:忍者登場前＿ローズ助けられ)
				eval($f:rfp_PR_ＳＡＶＥ後特殊会話再生します = 1)

		//プリスキン嫉妬
		}else if( ( ( d:ST:P035_01_R01ファットマン爆弾解体終了１無線デモ１終了 <= $w:p_story && \
						$w:p_story < d:ST:P038_01_S01網膜チェック１シナリオデモ１開始) || \
					( d:ST:P042_01_R01シェル１シェル２連絡橋１無線デモ１終了 <= $w:p_story && \
						$w:p_story < d:ST:P044_01_R01赤外線センサークリア１無線デモ１開始) ) && \
					(!$f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:プリスキン嫉妬]) && \
					(!$f:rfp_ローズさん落込んでます) ){
				eval($f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:プリスキン嫉妬] = 1)
				eval($w:rfp_PR_ＳＡＶＥ後特殊会話 = d:RP_ＳＡＶＥ後会話:プリスキン嫉妬)
				eval($f:rfp_PR_ＳＡＶＥ後特殊会話再生します = 1)

		}else if( ( d:ST:P035_01_R01ファットマン爆弾解体終了１無線デモ１終了 <= $w:p_story && \
					$w:p_story < d:ST:P058_01_P01エマ救出１ポリゴンデモ１開始 ) && \
					(!$f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:キライな話題]) && \
					(!$f:rfp_ローズさん落込んでます) ){
				eval($f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:キライな話題] = 1)
				eval($w:rfp_PR_ＳＡＶＥ後特殊会話 = d:RP_ＳＡＶＥ後会話:キライな話題)
				eval($f:rfp_PR_ＳＡＶＥ後特殊会話再生します = 1)

		}else if( ( d:ST:P035_01_R01ファットマン爆弾解体終了１無線デモ１終了 <= $w:p_story && \
					$w:p_story < d:ST:P058_01_P01エマ救出１ポリゴンデモ１開始 ) && \
					($f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:キライな話題]) && \
					(!$f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:欲張り]) && \
					(!$f:rfp_ローズさん落込んでます) ){
				eval($f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:欲張り] = 1)
				eval($w:rfp_PR_ＳＡＶＥ後特殊会話 = d:RP_ＳＡＶＥ後会話:欲張り)
				eval($f:rfp_PR_ＳＡＶＥ後特殊会話再生します = 1)

		//P011_01_R01_ＢＣ連絡橋ＣＡＬＬ１無線デモ１＿２ってやつ
		}else if( ( d:ST:P005_05_R02ライデン昇降機上昇５無線デモ２終了 <= $w:p_story && \
					$w:p_story < d:ST:P032_01_P01ファットマン登場１ポリゴンデモ１開始 ) && \
					(!$f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:ＢＣ連絡橋ＣＡＬＬ１無線デモ]) && \
					(!$f:w14aローズからの無線を受信済み)  && \
					(!$f:rfp_ローズさん落込んでます) ){
				eval($f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:ＢＣ連絡橋ＣＡＬＬ１無線デモ] = 1)
				eval($f:w14aローズからの無線を受信済み = 1)
				command varsave $f:w14aローズからの無線を受信済み
				eval($w:rfp_PR_ＳＡＶＥ後特殊会話 = d:RP_ＳＡＶＥ後会話:ＢＣ連絡橋ＣＡＬＬ１無線デモ)
				eval($f:rfp_PR_ＳＡＶＥ後特殊会話再生します = 1)

		//Ｃ脚女子トイレピーター前,大佐と連動
		}else if( ( d:ST:P012_02_R01フォーチュン遭遇２無線デモ１終了 <= $w:p_story && \
					$w:p_story < d:ST:P014_01_P01ピーター遭遇１ポリゴンデモ１開始 ) && \
					( ($s:エリア == "w16a") && ($f:rfp_女子トイレにいます) ) && \
					(!$f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:Ｃ脚女子トイレピーター前]) && \
					(!$f:rfp_ローズさん落込んでます) ){
				eval($f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:Ｃ脚女子トイレピーター前] = 1)
				eval($w:rfp_PR_ＳＡＶＥ後特殊会話 = d:RP_ＳＡＶＥ後会話:Ｃ脚女子トイレピーター前)
				eval($f:rfp_PR_ＳＡＶＥ後特殊会話再生します = 1)

		//オルガうんちく 発動許可後 ５分
		}else if( ($f:rfp_PC_Ｅ脚オルガ聞いた) && \
					( ( ($i:プレイタイム - $i:rfp_イベント開始時刻２) / d:FRAME_RATE ) >= 300 ) && \
					(!$f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:オルガうんちく])  && \
					(!$f:rfp_ローズさん落込んでます) ){
				eval($f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:オルガうんちく] = 1)
				eval($w:rfp_PR_ＳＡＶＥ後特殊会話 = d:RP_ＳＡＶＥ後会話:オルガうんちく)
				eval($f:rfp_PR_ＳＡＶＥ後特殊会話再生します = 1)

		//ピーター詳細 発動許可後 ５分
		}else if( ($f:rfp_PC_ピーター聞いた) && \
					( ( ($i:プレイタイム - $i:rfp_PC_ピーター聞いた時刻) / d:FRAME_RATE ) >= 300 ) && \
				(d:ST:P014_15_P07ピーター遭遇１５ポリゴンデモ７終了 <= $w:p_story && \
					$w:p_story < d:ST:P022_01_R01爆弾解体最後から二つ目１無線デモ１開始) && \ 
				(!$f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:ピーター詳細])  && \
					(!$f:rfp_ローズさん落込んでます) ){
				eval($f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:ピーター詳細] = 1)
				eval($w:rfp_PR_ＳＡＶＥ後特殊会話 = d:RP_ＳＡＶＥ後会話:ピーター詳細)
				eval($f:rfp_PR_ＳＡＶＥ後特殊会話再生します = 1)

		//怪奇箱男詳細 発動許可後 ５分
		}else if( ($f:rfp_PC_怪奇箱男１聞いた) && \
					( ( ($i:プレイタイム - $i:rfp_PC_怪奇箱男１聞いた時刻) / d:FRAME_RATE ) >= 300 ) && \
				(d:ST:P014_15_P07ピーター遭遇１５ポリゴンデモ７終了 <= $w:p_story && \
					$w:p_story < d:ST:P022_01_R01爆弾解体最後から二つ目１無線デモ１開始) && \ 
				(!$f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:怪奇箱男])  && \
					(!$f:rfp_ローズさん落込んでます) ){
				eval($f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:怪奇箱男] = 1)
				eval($w:rfp_PR_ＳＡＶＥ後特殊会話 = d:RP_ＳＡＶＥ後会話:怪奇箱男)
				eval($f:rfp_PR_ＳＡＶＥ後特殊会話再生します = 1)

		//ミスターＸ詳細詳細 発動許可後 ５分
		}else if( ($f:rfp_PC_ミスターＸ聞いた) && \
					( ( ($i:プレイタイム - $i:rfp_PC_ミスターＸ聞いた開始時刻) / d:FRAME_RATE ) >= 300 ) && \
				(d:ST:P014_15_P07ピーター遭遇１５ポリゴンデモ７終了 <= $w:p_story && \
					$w:p_story < d:ST:P022_01_R01爆弾解体最後から二つ目１無線デモ１開始) && \ 
				(!$f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:ミスターＸ詳細])  && \
					(!$f:rfp_ローズさん落込んでます) ){
				eval($f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:ミスターＸ詳細] = 1)
				eval($w:rfp_PR_ＳＡＶＥ後特殊会話 = d:RP_ＳＡＶＥ後会話:ミスターＸ詳細)
				eval($f:rfp_PR_ＳＡＶＥ後特殊会話再生します = 1)

		//ファットマン詳細詳細 発動許可後 ５分
		}else if( ($f:rfp_PC_ファットマンについて１聞いた) && \
					( ( ($i:プレイタイム - $i:rfp_PC_ファットマンについて１聞いた時刻) / d:FRAME_RATE ) >= 300 ) && \
				(d:ST:P014_15_P07ピーター遭遇１５ポリゴンデモ７終了 <= $w:p_story && \
					$w:p_story < d:ST:P032_01_P01ファットマン登場１ポリゴンデモ１開始) && \
				(!$f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:ファットマン詳細])  && \
					(!$f:rfp_ローズさん落込んでます) ){
				eval($f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:ファットマン詳細] = 1)
				eval($w:rfp_PR_ＳＡＶＥ後特殊会話 = d:RP_ＳＡＶＥ後会話:ファットマン詳細)
				eval($f:rfp_PR_ＳＡＶＥ後特殊会話再生します = 1)

		//エイムズ詳細 発動許可後 ５分
		}else if( ($f:rfp_PC_エイムズ聞いた) && \
					( ( ($i:プレイタイム - $i:rfp_PC_エイムズ聞いた時刻) / d:FRAME_RATE ) >= 300 ) && \
				(d:ST:P036_13_R04忍者登場１３無線デモ４終了 <= $w:p_story && \
					$w:p_story < d:ST:P040_01_P01エイムズ発見１ポリゴンデモ１開始) && \
				(!$f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:エイムズ詳細])  && \
					(!$f:rfp_ローズさん落込んでます) ){
				eval($f:rfp_ＳＡＶＥ後会話聞いた[d:RP_ＳＡＶＥ後会話:エイムズ詳細] = 1)
				eval($w:rfp_PR_ＳＡＶＥ後特殊会話 = d:RP_ＳＡＶＥ後会話:エイムズ詳細)
				eval($f:rfp_PR_ＳＡＶＥ後特殊会話再生します = 1)

