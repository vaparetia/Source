proc rpr_ＳＡＶＥしたデフォルト {
	if($f:rfp_PR_ＳＡＶＥ後特殊会話再生します){

		if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:ダンボール){
			@rp_PR_ＳＡＶＥ後＿ダンボール

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:変装){
			@rpr_PR_ＳＡＶＥ後＿変装

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:スネークの遺体){
			@rpr_スネークの遺体

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:煙草){
			@rpr_PR_ＳＡＶＥ後＿煙草

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:エロ本){
			@rpr_PR_ＳＡＶＥ後＿エロ本

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:殺した){
			@rpr_PR_ＳＡＶＥ後＿殺した

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:ＢＣ連絡橋ＣＡＬＬ１無線デモ){
			@rpr_ＢＣ連絡橋ＣＡＬＬ１無線デモ

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:Ｃ脚女子トイレピーター前){
			@rpr_Ｃ脚女子トイレピーター前

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:オルガうんちく){
			@rpr_オルガうんちく

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:ピーター詳細){
			@rpr_ピーター詳細

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:怪奇箱男){
			@rpr_怪奇箱男

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:ミスターＸ詳細){
			@rpr_ミスターＸ詳細

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:ファットマン詳細){
			@rpr_ファットマン詳細

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:エイムズ詳細){
			@rpr_エイムズ詳細

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:ブラックケース詳細){
			@rpr_ブラックケース詳細

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:ヴァンプ詳細){
			@rpr_ヴァンプ詳細

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:フォーチュン詳細){
			@rpr_フォーチュン詳細

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:帰還パーティー){
			@rpr_PR_ＳＡＶＥ後＿帰還パーティー

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:しばらくしてから ){
			@rpr_PR_ＳＡＶＥ後＿しばらくしてから

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:爆弾解体中ローズその１ ){
			@rpr_爆弾解体中ローズその１

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:爆弾解体中ローズその３ ){
			@rpr_爆弾解体中ローズその３
			command varsave $f:rfp_爆弾解体中ローズその３聞いた

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:爆弾解体中ローズその２ ){
			@rpr_爆弾解体中ローズその２

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:忍者登場前＿ローズ助けられ ){
			@rpr_PC_忍者登場前＿ローズ助けられ
			

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:爆弾解体中スネーク ){
			@rpr_PR_ＳＡＶＥ後＿爆弾解体中スネーク

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:ピーター死直後 ){
			@rpr_PR_ＳＡＶＥ後＿ピーター死直後

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:プリスキン嫉妬 ){
			@rpr_PR_ＳＡＶＥ後＿プリスキン嫉妬

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:ピーター歩けました ){
			@rpr_PR_ＳＡＶＥ後＿ピーター歩けました

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:エマと手つなぎ ){
			@rpr_PR_ＳＡＶＥ後＿エマと手つなぎ

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:エマライデンローズ無線１無線機デモ ){
			@rpr_PR_ＳＡＶＥ後＿エマライデンローズ無線１無線機デモ

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:愛国 ){
			@rpr_PR_ＳＡＶＥ後＿愛国

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:大佐会ったことない ){
			@rpr_PR_ＳＡＶＥ後＿大佐会ったことない

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:しばらくＳＡＶＥしてない ){
			@rpr_PR_ＳＡＶＥ後＿しばらくＳＡＶＥしてない

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:天狗通路Ａ ){
			@rpr_PR_ＳＡＶＥ後＿天狗通路Ａ
			@rp_ローズさんが落込みました

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:少年兵後 ){
			@rpr_PR_ＳＡＶＥ後＿少年兵後
			@rp_ローズさんが落込みました

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:新鮮 ){
			@rpr_PR_ＳＡＶＥ後＿新鮮

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:明日何の日 ){
			@rpr_PR_ＳＡＶＥ後＿明日何の日

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:キライな話題 ){
			@rpr_PR_ＳＡＶＥ後＿キライな話題

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:欲張り ){
			@rpr_PR_ＳＡＶＥ後＿欲張り

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:美人さん ){
			@rpr_PR_ＳＡＶＥ後＿美人さん

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:仕事も大事 ){
			@rpr_PR_ＳＡＶＥ後＿仕事も大事

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:押し入り ){
			@rpr_PR_ＳＡＶＥ後＿押し入り
			@rp_ローズさんが落込みました

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:押し入り後 ){
			@rpr_PR_ＳＡＶＥ後＿押し入り後
			@rp_ローズさんが落込みました

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:立ち入り禁止 ){
			@rpr_PR_ＳＡＶＥ後＿立ち入り禁止
			@rp_ローズさんが落込みました

		}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:つらそう ){
			@rpr_PR_ＳＡＶＥ後＿つらそう
			@rp_ローズさんが落込みました

		//エラーでばぐっち
		}else {
			if($f:rfp_ローズさん落込んでます){
				@rpr_PR_未ＳＡＶＥ終了＿落込み
			}else {
				@rpr_PR_未ＳＡＶＥ終了
			}
		}
	
		command varsave $f:rfp_ＳＡＶＥ後会話聞いた[$w:rfp_PR_ＳＡＶＥ後特殊会話]

	}else {
		if($f:rfp_ローズさん落込んでます){
			@rpr_PR_未ＳＡＶＥ終了＿落込み
		}else {
			@rpr_PR_未ＳＡＶＥ終了
		}
	}

	@rpr_ＳＡＶＥ後会話フラグクリア
}


proc rpr_PR_未ＳＡＶＥ終了 {
	@rpr_PR_未ＳＡＶＥ終了＿普通
}


proc rpr_ＳＡＶＥしなかったデフォルト {
	@rpr_PR_未ＳＡＶＥ終了＿普通
}

proc rpr_ＳＡＶＥエラー時フラグクリア処理 {
	if($f:rfp_PR_ＳＡＶＥ後特殊会話再生します){
		eval($f:rfp_ＳＡＶＥ後会話聞いた[$w:rfp_PR_ＳＡＶＥ後特殊会話] = 0)
	}
	if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:ＢＣ連絡橋ＣＡＬＬ１無線デモ){
		eval($f:w14aローズからの無線を受信済み = 0)
		command varsave $f:w14aローズからの無線を受信済み

	}else if($w:rfp_PR_ＳＡＶＥ後特殊会話 == d:RP_ＳＡＶＥ後会話:スネークの遺体){
		eval($f:rfp_スネークの遺体の話聞いた = 0)
		command varsave $f:rfp_スネークの遺体の話聞いた
	}
	
	eval($f:rfp_PR_ＳＡＶＥ後特殊会話再生します = 0)
	command varsave $f:rfp_ＳＡＶＥ後会話聞いた[$w:rfp_PR_ＳＡＶＥ後特殊会話]
}


proc rpr_ローズデフォルト {
	@rpd_ライデン顔設定デフォルト
	//らっちー状態
	if(d:ST:P073_01_R01通路Ａ１無線機デモ１終了 <= $w:p_story && \
		$w:p_story < d:ST:P080_28_P12ＡＧ浮上２８ポリゴンデモ１２終了 ){
		noise 0 1 
	}
	@rpd_ローズ顔設定１
	@rpd_顔表示
	//怒り……$f:rfp_PR_ローズさんが激怒してます！
	//落込み……$f:rfp_ローズさん落込んでます
	@rp_ローズさんご機嫌判定
	@rpr_ＳＡＶＥ前デフォルト

	//ＳＡＶＥ選択肢表示
	@rp_ＳＡＶＥデフォルトセット
	//ＳＡＶＥした
	if($w:rfp_ＳＡＶＥ選択肢返り値 == 0){
		if($f:rfp_PR_ＳＡＶＥ前フラグ処理する){
			@rpr_ＳＡＶＥ前フラグ処理
			command varsave $f:rfp_ＳＡＶＥ後会話聞いた[$w:rfp_PR_ＳＡＶＥ後特殊会話]
		}
		savemode
		eval($b:rfp_ＳＡＶＥした結果 = $status)
		print 'だふぁくららよぼ:' $b:rfp_ＳＡＶＥした結果
	}


	//ＳＡＶＥメニュー後

	//ＳＡＶＥするしないに関係ない人達
	//ソリダス戦中
	if(d:ST:P073_01_R01通路Ａ１無線機デモ１終了 <= $w:p_story && \
		$w:p_story < d:ST:P080_28_P12ＡＧ浮上２８ポリゴンデモ１２終了 ){
			@rp_PR_無言ローズ

	//拷問開放前
	}else if( (d:ST:P070_21_P12ＡＧ起動２１ポリゴンデモ１２終了 <= $w:p_story && \
				$w:p_story <= d:ST:P070_23_R04ＡＧ起動２３無線機デモ４終了) && \
				($f:rfp_P070_23_R04ＡＧ起動２３無線機デモ４再生します) && \
				(!$f:rfp_w41a_拘束開放されました) ){
			@rpr_P070_23_R04_ＡＧ起動２３無線機デモ４

			eval($f:w41a_主観デモ完全終了フラグ = 0)
			eval($f:rfp_P070_23_R04ＡＧ起動２３無線機デモ４再生します = 0)
			command varsave $f:w41a_主観デモ完全終了フラグ $f:rfp_P070_23_R04ＡＧ起動２３無線機デモ４再生します
			
//			command varsave
//			eval($w:p_story = d:ST:P070_23_R04ＡＧ起動２３無線機デモ４終了)


	//ちょートクシュ処理
	}else if( ($w:p_story == d:ST:P070_23_R04ＡＧ起動２３無線機デモ４終了) && \
				($f:w41a_主観デモ完全終了フラグ) && (!$f:rfp_w41a_拘束開放されました) ){
		eval($f:w41a_主観デモ完全終了フラグ = 0)
		command varsave $f:w41a_主観デモ完全終了フラグ
		@rpr_PR_未ＳＡＶＥ終了＿落込み


	}else if( \
			 (d:ST:P028_01_P01爆弾解体後フォーチュン再登場１ポリゴンデモ１終了 <= $w:p_story && \
			 	$w:p_story < d:ST:P029_01フォーチュン戦終了) || \
			 (d:ST:P032_01_P01ファットマン登場１ポリゴンデモ１終了 <= $w:p_story && \
			 	$w:p_story < d:ST:P035_01_R01ファットマン爆弾解体終了１無線デモ１開始) || \
			 (d:ST:P045_01_P01ハリアー登場１ポリゴンデモ１終了 <= $w:p_story && \
			 	$w:p_story < d:ST:P046_01_P01ハリアー戦勝利１ポリゴンデモ１開始) || \
			 (d:ST:P055_04_P03ヴァンプ戦前４ポリゴンデモ３終了 <= $w:p_story && \
			 	$w:p_story < d:ST:P057_01_P01ヴァンプ戦終了１ポリゴンデモ１開始) || \
			 (d:ST:P068_01_P01ヴァンプ狙撃前１ポリゴンデモ１終了 <= $w:p_story && \
			 	$w:p_story < d:ST:P069_01_P01ヴァンプ狙撃終了１ポリゴンデモ１開始) || \
			 	(`@rp_緊張してください`) ){
			@rpr_PR_未ＳＡＶＥ終了＿緊迫

	}else if(d:ST:P080_28_P12ＡＧ浮上２８ポリゴンデモ１２終了 <= $w:p_story && \
		$w:p_story < d:ST:P082_01_P01エンディング１ポリゴンデモ１開始 ){
			@rpr_PR_ソリダス戦中＿ＳＡＶＥ後

	}else if($f:rfp_PR_ローズさんが激怒してます！){
		@rpr_PR_ＳＡＶＥ後＿ご機嫌ななめ

	//ＳＡＶＥするしないに関係ある人達
	}else {
		//ＳＡＶＥした
		if( ($w:rfp_ＳＡＶＥ選択肢返り値 == 0) && ($b:rfp_ＳＡＶＥした結果 == 0) ){
			@rpr_ＳＡＶＥしたデフォルト

		}else if($f:rfp_ローズさん落込んでます){
			@rpr_PR_未ＳＡＶＥ終了＿落込み

		#ifdef d:XBOX
		//その他エラー
		}else if( ($w:rfp_ＳＡＶＥ選択肢返り値 == 0) && ($b:rfp_ＳＡＶＥした結果 >= 2) ){
			@rp_PR_ＳＡＶＥ失敗＿その他エラー
			@rpr_ＳＡＶＥエラー時フラグクリア処理

		#else
		//キャンセル終了
		}else if( ($w:rfp_ＳＡＶＥ選択肢返り値 == 0) && ($b:rfp_ＳＡＶＥした結果 == 1) ){
			@rpr_ＳＡＶＥしなかったデフォルト
			@rpr_ＳＡＶＥエラー時フラグクリア処理

		//空きなし
		}else if(($w:rfp_ＳＡＶＥ選択肢返り値 == 0) && ($b:rfp_ＳＡＶＥした結果 == 2) ){
			@rp_PR_ＳＡＶＥ失敗＿空き領域ない
			@rpr_ＳＡＶＥエラー時フラグクリア処理

		//メモリーカードなし
		}else if(($w:rfp_ＳＡＶＥ選択肢返り値 == 0) && ($b:rfp_ＳＡＶＥした結果 == 3) ){
			@rp_PR_ＳＡＶＥ失敗＿メモリーカードない
			@rpr_ＳＡＶＥエラー時フラグクリア処理

		//その他エラー
		}else if( ($w:rfp_ＳＡＶＥ選択肢返り値 == 0) && ($b:rfp_ＳＡＶＥした結果 == 4) ){
			@rp_PR_ＳＡＶＥ失敗＿その他エラー
			@rpr_ＳＡＶＥエラー時フラグクリア処理
		#endif

		//ＳＡＶＥしてない
		}else {
			@rpr_ＳＡＶＥしなかったデフォルト
			@rpr_ＳＡＶＥエラー時フラグクリア処理
		}
	}
	eval($w:rfp_ＳＡＶＥ選択肢返り値 = 0)
	eval($b:rfp_ＳＡＶＥした結果 = 0)
}


block codec RPR_ローズデフォルト 14096 d:大佐無線１ {
	@rp_無線デフォルト前処理＿ローズ
	@rpr_ローズデフォルト
}


/*
block codec RPR_ローズデフォルト＿ゴルルコ兵マスクあり 14096 d:大佐無線４ゴルルコ兵マスクありライデン {
	@rp_無線デフォルト前処理＿ローズ
	@rpr_ローズデフォルト
}
*/

block codec RPR_ローズデフォルト＿裸ライデン 14096 d:大佐無線３裸ライデン {
	@rp_無線デフォルト前処理＿ローズ
	@rpr_ローズデフォルト
	@rp_まお封じ
}

block codec RPR_ローズデフォルト＿潜水ライデン 14096 d:大佐無線２潜水ライデン {
	@rp_無線デフォルト前処理＿ローズ
	@rpr_ローズデフォルト
}







//モーション班用デバッグスクリプトェウァアアアア
#if d:MGS2_SCN
#include "p_rose_dbg.h"
#endif
