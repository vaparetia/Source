proc rp_無線デフォルト前処理＿ローズ {
	@rp_無線デフォルト前処理
	if(`prefreq` != 14096){
		eval($w:rfp_callcount = 1)
	}
}

proc rpr_P070_23_R04_ＡＧ起動２３無線機デモ４ {
	@vc117031
}



proc rpr_PR_ＳＡＶＥ前＿普通 {
	if(!$f:rfp_PR_ＳＡＶＥ前＿普通１聞いた) {
		@rp_PR_ＳＡＶＥ前＿普通１
		eval($f:rfp_PR_ＳＡＶＥ前＿普通１聞いた = 1)
	
	}else if(!$f:rfp_PR_ＳＡＶＥ前＿普通２聞いた){
		@rp_PR_ＳＡＶＥ前＿普通２
		eval($f:rfp_PR_ＳＡＶＥ前＿普通２聞いた = 1)
	
	}else if(!$f:rfp_PR_ＳＡＶＥ前＿普通３聞いた){
		@rp_PR_ＳＡＶＥ前＿普通３
		eval($f:rfp_PR_ＳＡＶＥ前＿普通３聞いた = 1)

	}else if(!$f:rfp_PR_ＳＡＶＥ前＿普通４聞いた){
		@rp_PR_ＳＡＶＥ前＿普通４
		eval($f:rfp_PR_ＳＡＶＥ前＿普通４聞いた = 1)
	
	}else {
		rand 4
		eval($w:rfp_rand = $status)
		if($w:rfp_rand < 1){
			@rp_PR_ＳＡＶＥ前＿普通１

		}else if($w:rfp_rand < 2){
			@rp_PR_ＳＡＶＥ前＿普通２

		}else if($w:rfp_rand < 3){
			@rp_PR_ＳＡＶＥ前＿普通３

		}else{
			@rp_PR_ＳＡＶＥ前＿普通４
		}
	}
}


