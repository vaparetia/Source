/* -------------------------------

強制無線機デモ用にゃろーんむきゃ。
$Id: t_demo_g.cm,v 1.10 2001/11/18 07:25:20 usr01098 Exp $

---------------------------------*/
resource T_00b1Rオープニング無線機デモ__g {
スネーク_000: {
Hier ist Snake. Kannst Du mich h&~oren,
Otacon?
}
//	<<<ENGLISH>>>
//	This is Snake.
//	Do you read me, Otacon?

/*
こちらスネーク、
聞こえるか、オタコン？
*/
オタコン_001: {
Laut und deutlich, Snake.
}
//	<<<ENGLISH>>>
//	Loud and clear, Snake.

/*ああ僕だよ、スネーク。
聞こえる……。*/
スネーク_002: {
Hab' Dich schmoren lassen, was? 
Ich befinde mich am Einsatzpunkt.
}
//	<<<ENGLISH(2)>>>
//	Kept you waiting, huh?
//	I'm at the "sneak point."

/*……待たせたな。
＃｛潜入、スニーク｝＃ポイントに到着……。*/
オタコン_003: {
L&~auft alles nach Plan?
}
//	<<<ENGLISH>>>
//	Everything going okay?

/*うまくいったかい？
*/
スネーク_004: {
Die Stealth-Tarnung ist kaputt.
Landeaufprall.
}
//	<<<ENGLISH>>>
//	The stealth camo's busted.
//	Landing impact.

/*着地の衝撃でステルス迷彩が壊れた。*/
オタコン_005: {
Wir haben sie zu oft benutzt. Tut mir leid,
aber damit mu&~st Du klarkommen. 
}
//	<<<ENGLISH(2)>>>
//	We must have overused it.
//	Sorry, but you're gonna
//	have to deal with it.

/*随分こき使ってきたからね……。
悪いけど我慢してくれ。
*/
//<ページ数変更>
オタコン_005_1: {
Du bist nicht mehr beim Milit&~ar.
}
//	<<<ENGLISH>>>
//	You're not in the
//	military anymore.

/*
軍じゃないんだ。
*/
スネーク_006: {
Genau. Ich hatte es nicht vor, mich auf
diesen Schnickschnack zu verlassen.
}
//	<<<ENGLISH>>>
//	Right. I didn't plan on relying
//	on this gadget anyway.

/*ああ。いつまでも＃｛ステルス迷彩、こんなもの｝＃に
頼るつもりはない。*/
オタコン_007: {
Die Privatwirtschaft ist nicht schlecht,
was? Diskretion garantiert.
}
//	<<<ENGLISH>>>
//	The private sector's not so bad,
//	is it? Privacy guaranteed...

/*だけど民間のいいところもあるだろ？
プライバシーは守られてるし……。*/
スネーク_008: {
Ich bin zufrieden, solange ich keine
weiteren unerw&~unschten Geschenke kriege.
}
//	<<<ENGLISH>>>
//	I'm happy as long as no one
//	gives me any more unwanted
//	gifts.

/*変な薬も盛られずに済むしな。*/
オタコン_009: {
Du meinst die Sache mit Naomi?
}
//	<<<ENGLISH>>>
//	You mean that thing with Naomi?

/*ナオミの事……？*/
スネーク_010: {
Ich vermisse die Quasselstrippe jedenfalls
nicht.
}
//	<<<ENGLISH>>>
//	And I can't say I miss
//	the chattering nanny.

/*うるさい見張り役がいないのも気が楽だ。*/
オタコン_011: {
Mei Ling ist nicht so &~ubel. Da f&~allt mir
ein, ich mu&~s mich bei ihr melden
}
//	<<<ENGLISH>>>
//	Mei Ling's not so bad. That
//	reminds me, I have to get in
//	touch with her again

/*メイ・リンか……。
また彼女に頼んでおくよ。*/
//<ページ数変更>
オタコン_011_1: {
wegen der neuen Natik Flashware.
}
//	<<<ENGLISH>>>
//	about that new Natik flashware.

/*
＃｛ＮＡＴＩＣＫ、ナティック｝＃の新兵器。
*/
スネーク_012: {
La&~st ihr wieder Spielzeug aus dem SSCEN
(U.S. Army Soldier Systems Center)
verschwinden? Richte ihr aus:
}
//	<<<ENGLISH>>>
//	Diverting toys from the SSCEN (U.S.
//	Army Soldier Systems Center) again?
//	Give her a message from me:

/*＃｛陸軍兵士システムセンター、ＮＡＴＩＣＫ｝＃からの
横流しか。彼女に伝えておいてくれ。*/
スネーク_013: {
Das fliegt fr&~uher oder sp&~ater auf.
}
//	<<<ENGLISH>>>
//	someone will find out
//	sooner or later.

/*いずれはバレる。*/
//<ページ数変更>
スネーク_013_1: {
Sie f&~ahrt besser damit, anzunehmen, da&~s
es fr&~uher passiert und h&~ort damit auf,
solange sie noch sicher ist.
}
//	<<<ENGLISH>>>
//	She's better off assuming
//	it's sooner and quit while
//	she's safe.

/*早いうちに手を引くようにな。*/
オタコン_014: {
Wie wahr. Ok, Snake, jetzt aber an die
Arbeit!
}
//	<<<ENGLISH>>>
//	Too true. Okay, Snake,
//	let's get to work.

/*それもそうだね……。
じゃあスネーク、本題に入るよ。*/
オタコン_015: {
Du wei&~st, da&~s die Pl&~ane f&~ur Metal Gear
nach Shadow Moses auf dem
Schwarzmarkt verkauft wurden?
}
//	<<<ENGLISH>>>
//	You know how the technical specs of
//	Metal Gear were sold on the black
//	market after Shadow Moses?

/*シャドーモセス事件の後、メタルギアの
技術情報が＃｛闇市場、ブラックマーケット｝＃で密売されたよね。*/
スネーク_016: {
Ocelot sorgt doch nur daf&~ur, da&~s.
}
//	<<<ENGLISH>>>
//	All Ocelot's doing...

/*オセロットの仕業だ。*/
オタコン_017: {
Genau. Und nun hat jeder Staat, jede
Gruppe und Internetfirma ihre eigene
Version von Metal Gear.
}
//	<<<ENGLISH>>>
//	Exactly. And now every state,
//	group and dotcom has its own
//	version of Metal Gear.

/*ああ。それで全世界にメタルギアの
亜種が拡散した。*/
スネーク_018: {
Nicht gerade eine Geheimwaffe f&~ur die
heutigen Atomm&~achte.
}
//	<<<ENGLISH>>>
//	Not exactly a classified weapon
//	for today's nuclear powers.

/*いまや核武装国にとって、
メタルギアは特別な兵器ではない。*/
オタコン_019: {
Der Neue scheint entwickelt worden zu
sein, um alle anderen Modelle
auszuradieren.
}
//	<<<ENGLISH>>>
//	This new one seems to have been
//	designed to wipe the floor with
//	all the other models.

/*今回の新型はそれらに対抗する為に
設計されたものらしい。*/
//<ページ数変更>
オタコン_019_1: {
Die Berichte stimmen nur darin &~uberein,
da&~s es sich um ein Anti-Metal
Gear-Amphibienfahrzeug handelt.
}
//	<<<ENGLISH>>>
//	The only consistent description is
//	that it's an amphibious, anti-Metal
//	Gear vehicle...

/*水陸両用の
対メタルギア兵器……。*/
スネーク_020: {
Das erkl&~art, warum das Marinekorps
zust&~andig ist.
}
//	<<<ENGLISH>>>
//	That explains why this one is
//	under Marine Corps jurisdiction.

/*それで新型は海兵隊の所属って訳か……？*/

}//d


resource T_03b1Rカモフ登場後無線機デモ体験版__g {
スネーク_000: {
Wir brauchen einen Hinweis, wer sie sind.
}
//	<<<ENGLISH>>>
//	We need to get a fix
//	on who they are.

/*奴等の正体を調べる必要があるな。
*/
オタコン_001: {
Ihrem Bef&~orderungsmittel nach, k&~onnten
sie eine Art Milit&~arkommando sein.
}
//	<<<ENGLISH>>>
//	Judging by their transport,
//	aren't they some kind of
//	military commandos?

/*そんなもの飛ばしてるなんて、
どこかの軍隊かな？
*/
スネーク_002: {
Nicht zwangsl&~aufig. Es k&~onnte der KA-62,
das zivile Modell, sein.
}
//	<<<ENGLISH>>>
//	Not necessarily. It could be
//	the KA-62, the civil model.

/*いや、そうとも言えない。
民間型のＫＡ-６２かもしれない。
*/
オタコン_003: {
Das ist nicht wie auf Shadow Moses. Ruf'
mich, wenn sich was tut.
}
//	<<<ENGLISH>>>
//	This isn't like Shadow Moses.
//	Reach me if anything happens.

/*シャドーモセスの時とは違うんだ。
何かあったらすぐ連絡してくれ。
*/
オタコン_004: {
Ich warte kurz hinter der Verrazano-Br&~ucke
auf Dich. Bis dahin mu&~st Du vom Schiff
sein.
}
//	<<<ENGLISH>>>
//	I'll be waiting just past the
//	Verrazano Bridge. You need
//	to be off that ship by then.

/*ベラザノ橋を越えた所で待ってる。
それまでに離脱するんだ。
*/
スネーク_005: {
Ich r&~uhre mich.
}
//	<<<ENGLISH(2)>>>
//	I'll be in touch.

/*また連絡する。
*/
}//d


resource T_03b1Rカモフ登場後無線機デモ製品版__g {
スネーク_000: {
Wir brauchen einen Hinweis, wer sie sind.
}
//	<<<ENGLISH>>>
//	We need to get a fix
//	on who they are.

/*奴等の正体を調べる必要があるな。*/
オタコン_001: {
Ihrem Bef&~orderungsmittel nach, k&~onnten
sie eine Art Milit&~arkommando sein.
}
//	<<<ENGLISH>>>
//	Judging by their transport,
//	aren't they some kind of
//	military commandos?

/*そんなもの飛ばしてるなんて、
どこかの軍隊かな？*/
スネーク_002: {
Nicht zwangsl&~aufig. Es k&~onnte der KA-62,
das zivile Modell, sein.
}
//	<<<ENGLISH>>>
//	Not necessarily. It could be
//	the KA-62, the civil model.

/*いや、そうとも言えない。
民間型のＫＡ-６２かもしれない。*/
オタコン_003: {
H&~or mal, Snake, wir brauchen eigentlich
nur einen fotografischen Beweis f&~ur Metal
Gear.
}
//	<<<ENGLISH(2)>>>
//	Look, Snake, all we need is
//	the photographic evidence
//	of Metal Gear.

/*いいかい、スネーク。
必要なのはメタルギア開発の
証拠写真だ。*/
オタコン_004: {
Wenn wir die Fotos haben, stellen wir sie
online und machen die ganze Sache publik.
}
//	<<<ENGLISH>>>
//	As long as we have those,
//	we can put it online and blow
//	the whole thing wide open.

/*それさえあればいい。
あとはＮＧＯのＨＰに掲載して
情報を公開する……。*/
オタコン_005: {
Also kein Feuerwerk, okay?
}
//	<<<ENGLISH>>>
//	So no pyrotechnics, okay?

/*いいね、手荒な真似は
しないでくれよ。*/
スネーク_006: {
Alles klar, Ich tu' mein Bestes.
}
//	<<<ENGLISH>>>
//	All right.
//	I'll do my best.

/*わかった、努力する。*/
オタコン_007: {
Das ist nicht wie auf Shadow Moses. Ruf'
mich, wenn sich was tut.
}
//	<<<ENGLISH>>>
//	This isn't like Shadow Moses.
//	Reach me if anything happens.

/*シャドーモセスの時とは違うんだ。
何かあったらすぐ連絡してくれ。*/
オタコン_008: {
Meine Frequenz ist 141,12.
}
//	<<<ENGLISH(2)>>>
//	The frequency is 141.12.

/*周波数は１４１．１２だ。*/
スネーク_009: {
Wie nehme ich Kontakt auf und speichere
meine Fortschritte?
}
//	<<<ENGLISH>>>
//	How can I check in and
//	save my progress?

/*データの記録はどうする？*/
オタコン_010: {
Ich werde es tun. Daf&~ur wurde eine
Frequenz reserviert -- 140,96.
}
//	<<<ENGLISH(2)>>>
//	I'll do it. There's a frequency
//	set aside for it -- 140.96. 

/*僕がするよ。
＃｛記録、セーブ｝＃用の専用回線は１４０．９６……。*/
オタコン_011: {
Diesmal leider ohne Mei Ling.
}
//	<<<ENGLISH>>>
//	Sorry, but no Mei Ling this time.

/*メイ・リンじゃなくて残念だけど。
*/
オタコン_012: {
Ruf mich &~ubers Codec, wenn Du speichern
willst.
}
//	<<<ENGLISH>>>
//	Call me on the Codec
//	when you want to save.

/*＃｛記録、セーブ｝＃したい時はこっちに無線して
くれればいい。*/
スネーク_013: {
Verstanden.
}
//	<<<ENGLISH(2)>>>
//	Got it.

/*ああ……。*/
オタコン_014: {
Ich warte kurz hinter der Verrazano-Br&~ucke
auf Dich. Bis dahin mu&~st Du vom Schiff
sein.
}
//	<<<ENGLISH>>>
//	I'll be waiting just past the
//	Verrazano Bridge. You need
//	to be off that ship by then.

/*ベラザノ橋を越えた所で待ってる。
それまでに離脱するんだ。*/
スネーク_015: {
Ich r&~uhre mich.
}
//	<<<ENGLISH(2)>>>
//	I'll be in touch.

/*また連絡する。あと、字幕がずれて
いるのは音声再収録後に直るらしいぞ。
今は気にするな。*/
}//d


resource T_04a0R操舵室無線機デモ__g {
オタコン_000: {
Snake, wei&~st Du schon, wohin das Schiff
f&~ahrt?
}
//	<<<ENGLISH>>>
//	Snake, did you find out
//	where that ship is headed?

/*スネーク、その船の行き先は
分かったかい？*/
スネーク_001: {
Ich hab's vor mir - 35ster L&~angengrad,
Breitengrad etwa 58.
}
//	<<<ENGLISH>>>
//	I'm looking at it -- 35 degrees
//	longitude, latitude around 58.

/*ああ。北緯三十五度、西経五十八度の
あたりのようだ。*/
オタコン_002: {
Mehr als 500 Meilen von der K&~uste
der Bermudas drau&~sen in der Mitte
des Atlantiks.
}
//	<<<ENGLISH(2)>>>
//	More than 500 miles off the coast
//	of the Bermudas, out in the middle
//	of the Atlantic...

/*バミューダ島の沖、８００キロ位か。
大西洋のど真ん中……。*/
オタコン_003: {
Der Prototyp ist also fertig f&~ur die
Einzeltests - er ist tats&~achlich kampfbereit.
}
//	<<<ENGLISH(2)>>>
//	So the prototype is ready for
//	solo testing -- it's basically
//	combat-worthy.

/*新型メタルギアは単独演習が可能なほど
完成してるのか……？*/
オタコン_004: {
Das Gebiet befindet sich auch au&~serhalb
des Einsatzbereichs der Zweiten Flotte.
}
//	<<<ENGLISH>>>
//	That area is outside the Second
//	Fleet's operational range, too.

//<ページ数変更>
オタコン_004_1: {
Es mu&~s sich um ein Solo-Projekt des
Marinekorps handeln
}
//	<<<ENGLISH(2)>>>
//	It must be a stand-alone Marine
//	Corps project -- which means
//	this prototype Metal Gear＃－

/*それにそのあたりは海軍第二艦隊の作戦
海域からも外れてる。完全に海兵隊独自
のプロジェクトってことだね。
*/
オタコン_005: {
das bedeutet, dieser Metal Gear-Prototyp
mu&~s f&~ur einen unabh&~angigen Einsatz
entwickelt worden sein, ohne die Hilfe der
Navy.
}
//	<<<ENGLISH>>>
//	must be designed for independent
//	deployment, without any Naval
//	assistance...

/*……ということは新型メタルギアは
海軍の支援なしで単独作戦行動を
行う性能を持っている……？*/
オタコン_006: {
F&~ur Analysen ist sp&~ater Zeit.
}
//	<<<ENGLISH>>>
//	Anyway, analysis can
//	wait till later.

/*うん、まあ詳しいデータは後で分析する
ことにするよ。*/
//<ページ数変更>
オタコン_006_1: {
Snake, Du mu&~st runter zu den
Frachtr&~aumen und den neuen Metal
}
//	<<<ENGLISH>>>
//	Snake, you need to go down
//	to the holds and locate the
//	actual Metal...

/*スネークは次に船倉に
行ってメタルギア本体を……。*/
スネーク_007: {
!?
}
//	<<<ENGLISH>>>

/*？*/
}//d

 

// 新規作成分
resource T_06b1Rオルガ戦勝利後無線機デモ１__g {
スネーク_000: {
Otacon, sie scheinen das Schiff unter
Kontrolle zu haben.
}
//	<<<ENGLISH(2)>>>
//	Otacon, the ship appears
//	to be under their control.

/*オタコン、船は奴等の手に
落ちたようだ。*/
スネーク_001: {
Die Ausr&~ustung der M&~anner ist russisch,
aber ich konnte noch nichts &~uber ihre
Herkunft in Erfahrung bringen.
}
//	<<<ENGLISH>>>
//	The men have Russian gear, but
//	I haven't been able to find out
//	anything else about their origin.

/*連中、兵装はロシア製だが、身元が
わかるようなものは何もない。*/
オタコン_002: {
Ich wei&~s, wer sie sind.
}
//	<<<ENGLISH>>>
//	I know who they are.

/*僕の方ではつかめたよ。*/
スネーク_003: {
Wirklich?
}
//	<<<ENGLISH(2)>>>
//	You do?

/*何？*/
オタコン_004: {
Wir haben den alten Mann identifiziert.
}
//	<<<ENGLISH>>>
//	We've ID'd the old man.

/*さっきの男の正体がわかったんだ。*/
スネーク_005: {
Wer ist er?
}
//	<<<ENGLISH>>>
//	Who is he?

/*誰だ？*/
オタコン_006: {
Sergei Gurlukovich.
}
//	<<<ENGLISH(2)>>>
//	Sergei Gurlukovich.

/*セルゲイ・ゴルルコビッチ。*/
スネーク_007: {
Gurlukovich! Einer von Ocelots
Verb&~undeten?
}
//	<<<ENGLISH>>>
//	Gurlukovich...!
//	One of Ocelot's allies?

} //d

resource T_06b1Rオルガ戦勝利後無線機デモ２__g {
/*ゴルルコビッチ！
……オセロットが手を組んでいた？*/
オタコン_008: {
Ja. Der GRU-Oberst. Ihn sollte Ocelots
Treffen, nach Shadow Moses.
}
//	<<<ENGLISH>>>
//	Yeah... The GRU colonel. He's the
//	one Ocelot was supposed to meet
//	up with, after Shadow Moses...

/*そうだよ。シャドーモセスで
オセロットが合流しようとしていた
元ＧＲＵの大佐……。*/
スネーク_009: {
Sie sind hinter Metal Gear her.
}
//	<<<ENGLISH>>>
//	They're after Metal Gear...

/*奴等がメタルギアを……。*/
オタコン_010: {
Jetzt sieht alles anders aus. Das wird nicht
so einfach, wie wir dachten.
}
//	<<<ENGLISH>>>
//	Everything's changed.
//	This is not going to be
//	as simple as we thought.

/*状況が変わった。
もう単純にはいきそうもないよ。*/
スネーク_011: {
Das kannst Du laut sagen. Ich hab' gerade
eine &~Uberwachungsanlage gesehen, es sah
wie eine CYPHER aus.
}
//	<<<ENGLISH>>>
//	You could say that. I saw a
//	surveillance remote just now,
//	it looked like the Cypher.

/*確かに。俺も今、サイファーらしき
＃｛無人偵察機、ＵＡＶ｝＃を見た。*/
オタコン_012: {
Eine CYPHER-T der Marine?
}
//	<<<ENGLISH>>>
//	A Marine Cypher-T?

/*海兵隊のサイファーＴ？*/
スネーク_013: {
Nein, Armee.
}
//	<<<ENGLISH>>>
//	No, Army.

/*いや。陸軍のだ。*/
オタコン_014: {
Erst die Marines, dann die Russen --
und jetzt die Armee?
}
//	<<<ENGLISH>>>
//	First the Marines, then the
//	Russians -- now the Army...?

/*海兵隊にロシア兵、それに陸軍……？*/
スネーク_015: {
Du hast recht, das wird nicht ganz einfach.
}
//	<<<ENGLISH>>>
//	You're right, this isn't
//	going to be simple.

/*お前の言うとおり、単純ではなくなって
きたようだな。*/
オタコン_016: {
Snake, es gibt da etwas, was ich Dir
beichten mu&~s.
}
//	<<<ENGLISH>>>
//	Snake -- There's something
//	I have to tell you.

/*……スネーク……実は……。*/
スネーク_017: {
Was?
}
//	<<<ENGLISH(2)>>>
//	What?

/*何かあるのか？*/
オタコン_018: {
Wir haben diese Infos - &~uber den neuen
Metal Gear - nicht allein ausgegraben.
Nicht wie sonst.}
//	<<<ENGLISH>>>
//	We didn't dig up this info -- about
//	the new Metal Gear -- on our own.
//	Not like usual...

/*今回の新型メタルギアのネタ
なんだけど……いつもみたいに、
独自に得た情報じゃないんだ。*/
スネーク_019: {
Wie habt Ihr's denn rausgefunden?
}
//	<<<ENGLISH>>>
//	How did you find out, then?

/*それじゃ？*/
オタコン_020: {
Es war ein Tip. Ein anonymer Hinweis.
}
//	<<<ENGLISH>>>
//	It was a tip. An anonymous tip.

/*タレコミなんだ……匿名の。*/
スネーク_021: {
Anonym? Darauf hast Du doch nie etwas
gegeben - warum gerade jetzt?
}
//	<<<ENGLISH>>>
//	Anonymous? You've never trusted
//	those -- why would you start now?

/*匿名？ そんな情報を信じるような
お前じゃないはず？*/
オタコン_022: {
Ich, &~ah - Ich habe eine kleine
Schwester. Eine Stiefschwester.
Wir haben verschiedene Eltern.
}
//	<<<ENGLISH>>>
//	I, ah -- I have a younger sister.
//	A stepsister. We have different
//	parents...

/*実は……僕には妹がいるんだ。
血の繋がらない……。*/
オタコン_023: {
Wir waren nur zwei Jahre zusammen.
}
//	<<<ENGLISH>>>
//	I only knew her for two years.

/*一緒に暮らしたのはたった二年だけど。*/
スネーク_024: {
Du hast sie noch nie zuvor erw&~ahnt.
Also?
}
//	<<<ENGLISH(2)>>>
//	You've never mentioned
//	her before. So...?

/*初めて聞くな。それで……。*/
オタコン_025: {
Der Hinweis kam von 'E.E.'.
}
//	<<<ENGLISH>>>
//	The sender of the tip was "E.E."

/*タレコミメールの発信名に『ＥＥ』と
あったんだ……。*/
スネーク_026: {
'E.E.'?
}
//	<<<ENGLISH>>>
//	"E.E."?


/*ＥＥ？*/
オタコン_027: {
Ihr Name ist Emma, aber ich nannte sie
immer 'E.E.'.
}
//	<<<ENGLISH>>>
//	Her name is Emma, but I
//	always called her "E.E."...

/*エマっていう名前なんだけど、
僕はＥＥって呼んでた。*/
スネーク_028: {
Emma Emmerich?
}
//	<<<ENGLISH(2)>>>
//	Emma Emmerich?

/*エマ・エメリッヒ？*/
オタコン_029: {
Ja. Das erregte meine Aufmerksamkeit,
wei&~st Du?
}
//	<<<ENGLISH>>>
//	Yeah. It just caught
//	my eye, you know?
//	

/*そうだよ。懐かしい響きだった……。*/
オタコン_030: {
Ich dachte, es w&~are ein Zufall, aber ich
mu&~ste immer daran denken.
}
//	<<<ENGLISH>>>
//	I figured it was a coincidence,
//	but I couldn't get it out of my
//	mind.

/*偶然かもしれないけど、
気になって……。*/
//<ページ数変更>
オタコン_030_1: {
Ich w&~u&~ste nicht, wer von ihr wissen
k&~onnte.
}
//	<<<ENGLISH>>>
//	There's really no one out
//	there who knows about her.

/*妹の事を知ってる人間は
ほとんどいないんだ。*/
スネーク_031: {
Wann hast Du sie zum letzen Mal
gesehen?
}
//	<<<ENGLISH>>>
//	When was the last
//	time you saw her?

/*彼女とは？*/
オタコン_032: {
Das ist &~uber 10 Jahre her.
}
//	<<<ENGLISH>>>
//	Over 10 years ago.

/*もう十何年も会ってない。*/
スネーク_033: {
Du denkst, es ist eine Falle. Um uns
hierher zu locken?
}
//	<<<ENGLISH>>>
//	You think it's a trap?
//	To lure us out here...?

/*罠だと思うか？
俺達をおびき寄せる……？*/
オタコン_034: {
Keine Ahnung. Nachdem ich den Tip
bekam, brach ich in das Pentagon-System
ein, um eine Best&~atigung zu erhalten.
}
//	<<<ENGLISH>>>
//	I don't know. After I got the tip,
//	I did break into the Pentagon
//	system to get confirmation.

/*わからない。ただ……タレコミの後、
ペンタゴンのファイルに潜り込んで
裏は取ったんだ……。*/
スネーク_035: {
Verstehe.
}
//	<<<ENGLISH(2)>>>
//	Okay...

/*わかった……。*/
オタコン_036: {
Sei vorsichtig, Snake. Vielleicht hab' ich's
vermasselt.
}
//	<<<ENGLISH>>>
//	Watch your back, Snake.
//	Maybe I screwed up.

/*すまない……スネーク。
気をつけてね。*/
スネーク_037: {
Ich habe eine USP mit Licht; jetzt kann ich
es mit ihnen aufnehmen.
}
//	<<<ENGLISH>>>
//	I've got a light-equipped USP;
//	I can take them on now.

/*ＵＳＰを手に入れた。
これで奴等と対等だ。*/
スネーク_038: {
Ich habe zwar keine Munition, aber sie
braucht 9mm-Patronen, genau wie die M9
der Marines. Ich werde schon welche
finden.
}
//	<<<ENGLISH>>>
//	There's no ammo, but it takes a
//	9mm, just like the Marines' M9. I'll
//	find those somewhere around here.

/*弾倉は空だが、海兵隊のＭ９と同じ
９ミリ弾を使う。弾はどこかで補給
できるだろう。*/
/* light-equipped で包含している。
スネーク_039: {
フラッシュライトも装備されている。
}
*/
オタコン_040: {
Mach' nicht zuviel Krach mit dem Ding.
}
//	<<<ENGLISH>>>
//	Don't raise too much
//	racket with that thing.

/*でも、銃声には注意してね。*/
スネーク_041: {
Verstanden.
}
//	<<<ENGLISH>>>
//	I hear you.

/*ああ。*/
}//d


// 新規作成分
resource T_09b1R船倉無線機デモ１__g {
オタコン_000: {
Snake, bist Du drin? Hast Du's bis zu den
Frachtr&~aumen geschafft?
}
//	<<<ENGLISH>>>
//	Snake, are you in yet? Have
//	you made it to the holds?

/*スネーク、まだかい？
船倉に進入した？*/
スネーク_001: {
Es dauert l&~anger, als ich dachte. Wir
haben die Verrazano-Br&~ucke schon
passiert.
}
//	<<<ENGLISH>>>
//	It's taking longer than I expected.
//	We've already passed the Verrazano
//	Bridge.

/*予定より手間取っている……。
既にベラザノ橋を通過した。*/
オタコン_002: {
Gut. Wir werden einen anderen Treffpunkt
nutzen.
}
//	<<<ENGLISH>>>
//	All right. We'll use
//	another recovery point.

/*わかった。＃｛回収、リカバリー｝ポイントを
変更するよ。*/
スネーク_003: {
Sie k&~onnten vorhaben, den Kurs zu
&~andern.
}
//	<<<ENGLISH>>>
//	They may be planning
//	to change course.

/*航路を変更するつもりかもしれん。*/
オタコン_004: {
Was?
}
//	<<<ENGLISH(2)>>>
//	What?

/*なんだって？*/
スネーク_005: {
Die Ausg&~ange zum Deck sind alle
versiegelt.
}
//	<<<ENGLISH>>>
//	The exits to the deck
//	are all sealed.

/*上への出口が塞がれた……。*/
オタコン_006: {
Was haben sie vor?
}
//	<<<ENGLISH>>>
//	What are they planning?

/*連中、どうするつもりなんだ。*/
スネーク_007: {
Wenn sie Metal Gear in die Finger kriegen,
sieht es mit uns b&~ose aus.
}
//	<<<ENGLISH>>>
//	If they get Metal Gear,
//	we're going right off the
//	fringe.

/*奴等の手にメタルギアが渡れば
大変な事になる……。*/
} //d


// 新規作成分
resource T_10b1R船倉無線機デモ２__g {
オタコン_000: {
Ok, Snake. La&~s' uns das Ganze nochmal
durchgehen.
}
//	<<<ENGLISH>>>
//	OK, Snake. Let's go over
//	this one more time.

/*スネーク、もう一度確認するね。*/
オタコン_001: {
Nimm' die Kamera, um fotografische
Beweise f&~ur die Existenz des
Metal Gear-Prototypen festzuhalten.
}
//	<<<ENGLISH(2)>>>
//	Use this camera to get
//	photographic evidence
//	of the Metal Gear prototype.

/*カメラで新型メタルギアの写真を
撮るんだ。*/
オタコン_002: {
Zieh' los und mach' Fotos, die eine
deutlichere Sprache sprechen als die
glaubhaftesten Dementi der Regierung.
}
//	<<<ENGLISH>>>
//	Now, do your thing and take
//	pictures that speak louder than
//	the government's plausible denials.

/*政府がシラを切れない
ような証拠写真を頼む。*/
/* この台詞は無しになったのでは？？？
スネーク_007: {
できるだけ接近してみる。
}
*/
オタコン_003: {
Wir brauchen vier Fotos:
}
//	<<<ENGLISH>>>
//	We need four shots:

オタコン_003_1: {
Metal Gear von vorn, rechts und links
sowie
}
//	<<<ENGLISH>>>
//	Metal Gear from the front,
//	front-right, and front-left,

/*写真は四枚欲しい。メタルギアを
右、前、左の三方向から撮ったものと、*/
オタコン_004: {
eine Nahaufnahme des Marinekorps-Logos.
}
//	<<<ENGLISH>>>
//	and a close-up of
//	the Marine Corps marking.

/*海兵隊のマーキングのアップだ。*/
スネーク_005: {
Logo?
}
//	<<<ENGLISH>>>
//	Marking?

/*マーキング？*/
オタコン_006: {
Auf dem Rumpf von Metal Gear m&~u&~ste das
Logo 'MARINES' sein.
}
//	<<<ENGLISH>>>
//	There should be a "MARINES"
//	insignia on the body of Metal
//	Gear.

/*メタルギアのどこかに海兵隊の
所属であることを表す＃｛ＭＡＲＩＮＥＳ、マリーンズ｝
っていうマーキングがあるはずなんだ。*/
オタコン_007: {
Mal sehen, ob jemand eine Erkl&~arung f&~ur
ein deutliches Foto davon findet!
}
//	<<<ENGLISH>>>
//	Just let someone try
//	explaining away a clear
//	shot of that.

/* 廃止？？？？？
/*それがはっきり写っているのが一枚
欲しい。言い逃れされないためにね。*/
オタコン_012: {
Sobald Du die Fotos hast, &~ubertrage sie
verschl&~usselt mit dem Codec.
}
//	<<<ENGLISH>>>
//	As soon as you have the images,
//	use the Codec to transmit them
//	in an encrypted burst.

/*撮影できたら、無線機でバースト送信
してくれ。*/
//<ページ数変更>
オタコン_012_1: {
Wenn sie ok sind, sehen wir weiter.
}
//	<<<ENGLISH>>>
//	If they make the grade,
//	we'll go from there.

/*うまく撮れてたら次の指示を
出すよ。*/
廃止？？？？？ */
スネーク_008: {
Alles klar.
}
//	<<<ENGLISH(2)>>>
//	All right.

/*わかった。*/
オタコン_009: {
Da ist nur noch eine Kleinigkeit.
}
//	<<<ENGLISH>>>
//	There's actually
//	one little thing...

/*……実はあと一つ問題があって。*/
スネーク_010: {
Spuck's einfach aus. Ich bin's gewohnt,
da&~s etwas schiefgeht.
}
//	<<<ENGLISH>>>
//	Just spit it out.
//	I'm used to things
//	going wrong.

/*遠慮せずに言え。
厄介事が増えることには馴れている。*/
オタコン_011: {
Es sieht so aus, als w&~urde jemand unsere
&~Ubertragung abh&~oren.}
//	<<<ENGLISH>>>
//	It looks like someone's
//	monitoring our transmission.

/*誰かが僕らの通信をモニターしてる
気配があるんだ。*/
スネーク_012: {
Wer?
}
//	<<<ENGLISH>>>
//	Who?

/*何者だ？*/
オタコン_013: {
Keine Ahnung. Sie beobachten nur, es
w&~urde mich fertig machen,
}
//	<<<ENGLISH>>>
//	I don't have a clue. All they're
//	doing is watching -- it would
//	creep me out less

/*わからない。だけどモニターしてる
だけで妨害しようって様子はないんだ。*/
オタコン_014: {
wenn sie versuchten, unsere
Kommunikation zu manipulieren.
}
//	<<<ENGLISH>>>
//	if they tried to interfere
//	with our communications.

/*それがかえって不気味で……。*/
スネーク_015: {
K&~onnte das etwas mit der Cypher zu tun
haben, die wir sahen?
}
//	<<<ENGLISH>>>
//	Could it have something to
//	do with that Cypher we saw?

/*さっきのサイファーとも関係が？*/
オタコン_016: {
Vielleicht. Ich habe erst mal das
Verschl&~usselungsprotokoll f&~ur unsere
&~Ubertragung ge&~andert.
}
//	<<<ENGLISH>>>
//	Maybe. I've switched the encryption
//	protocol for our burst transmission
//	for now.

/*どうかな。
とりあえずバースト通信の暗号化
プロトコルを別のに切り替えてる。*/
オタコン_018: {
Jetzt m&~ochte ich versuchen, die Fotos auf
einem anderen Weg zu &~ubertragen.
Vorsichtshalber.
}
//	<<<ENGLISH>>>
//	What I want to do is use a
//	different method for sending
//	those photos, just in case.

/*あと、念の為に写真の送信経路を
変えたいんだ。*/
スネーク_019: {
Anstatt den Codec zu benutzen?
}
//	<<<ENGLISH>>>
//	Instead of using the Codec?

/*この無線を使わずに写真を
送るってことか？*/
オタコン_020: {
Genau. In der s&~ud&~ostlichen Ecke des
Blocks, in dem sich Metal Gear befindet,
steht eine Workstation.
}
//	<<<ENGLISH>>>
//	Exactly. There's a workstation in
//	the southeast corner of the block
//	where Metal Gear is housed.

/*そう。船倉の一番奥、メタルギアがある
ブロックの南東にコンピュータが一台
置いてある。
*/
オタコン_021: {
Ich habe daf&~ur gesorgt, da&~s Du die Fotos
von diesem Rechner aus verschicken
kannst.
}
//	<<<ENGLISH>>>
//	I've made arrangements so that
//	you can send the pictures from
//	the machine.

/*そこから写真を送信出来るように
細工しておいた。*/
スネーク_022: {
'Daf&~ur gesorgt'?
}
//	<<<ENGLISH>>>
//	"Arrangements"?


/*細工？ どうやったんだ？*/
オタコン_023: {
Ich habe mich &~uber Link-16 ins interne
U.S.-Milit&~arnetzwerk eingeschmuggelt.
}
//	<<<ENGLISH>>>
//	I hitched a ride on Link-16
//	into U.S. military's proprietary
//	network.

/*軍事ネットワークのリンク１６経由で
その＃｛ＷＳ、ワークステーション｝に侵入して*/
オタコン_024: {
Schaffte es, die Workstation zu knacken,
einen Teil der Systemsoftware zu
&~uberschreiben,
}
//	<<<ENGLISH>>>
//	Managed to get into that workstation
//	and overwrote a part of the system
//	software＃－

/*システムの
一部を書き換えて＃－*/
//<ページ数変更>
オタコン_024_1: {
und konnte so ein kleines
selbstgeschriebenes Programm installieren.
}
//	<<<ENGLISH>>>
//	so I could remote-install
//	a little app I wrote...

/*僕が作った特製のアプリを
リモート・インストールして……。*/
スネーク_025: {
Warum sollte man sich mit so was
Kompliziertem rumschlagen.
}
//	<<<ENGLISH>>>
//	Why bother with anything
//	that complicated...

/*面倒なことを……。*/
オタコン_026: {
Nein, das ist echt ganz einfach.
}
//	<<<ENGLISH(2)>>>
//	No, it's pretty simple, really.

/*いや、やり方は簡単だよ。*/
//<ページ数変更>
オタコン_026_1: {
Du mu&~st Dich nur vor den Rechner stellen
und die Aktionstaste dr&~ucken.
}
//	<<<ENGLISH>>>
//	Look, all you have to do is stand
//	in front of the machine and push
//	the Action button.

/*スネークは
マシンの前でアクションボタンを押す
だけでいい。*/
オタコン_027: {
Das Programm startet automatisch, l&~adt
die Bilddaten von Deiner Kamera herunter,
}
//	<<<ENGLISH>>>
//	The app will automatically launch
//	and download the image data from
//	the camera,

/*それでアプリが自動的に立ち上がって
写真のデータを読み取り、*/
//<ページ数変更>
オタコン_027_1: {
teilt die Dateien und verschl&~usselt sie
individuell.
}
//	<<<ENGLISH>>>
//	split the files and encrypt
//	them individually.

/*分割後暗号化
する。*/
オタコン_028: {
Die Datenpakete k&~onnen dann getarnt
werden als -
}
//	<<<ENGLISH>>>
//	The data packets can
//	then masquerade as...

/*データは偽装されたパケットに
格納されて……。*/
スネーク_029: {
Ok, ok. Ich mu&~s also nur vor dem
Computer die Aktionstaste dr&~ucken,
}
//	<<<ENGLISH>>>
//	OK, OK. So all I have to do is
//	push the Action button in front
//	of the computer＃－

//<ページ数変更>
スネーク_029_1: {
wenn ich die Fotos habe, richtig?
}
//	<<<ENGLISH>>>
//	once I have the pictures, right?

/*わかった。
写真を撮ったらコンピュータの前で
アクションボタンを押せば良いんだな。*/
オタコン_030: {
Ja, sicher, so kann man es auch sagen.
}
//	<<<ENGLISH>>>
//	Well, sure, if you
//	put it that way.

/*うん、まあ、そうだよ。*/
オタコン_031: {
Noch etwas.
}
//	<<<ENGLISH>>>
//	And one more thing...

/*それと……注意して欲しいのは、*/
//<ページ数変更>
オタコン_031_1: {
Der Kommandant hat bereits mit seiner
Ansprache begonnen. Du mu&~st die Fotos
haben, bevor er sie beendet hat.
}
//	<<<ENGLISH>>>
//	The Commandant's already begun
//	his speech, but you need to get the
//	pictures before he's done talking.

/*既に演説が始まってる。
演説が終わるまでに撮影しないと*/
オタコン_032: {
Sonst werden sie Dich entdecken. Ok?
}
//	<<<ENGLISH>>>
//	Otherwise, they'll spot you. OK?

/*発見されるよ、いいね？*/
スネーク_033: {
Wieviel Zeit habe ich?
}
//	<<<ENGLISH>>>
//	How much time do I have?

/*どれくらい余裕があるんだ？*/
オタコン_034: {
Ich hab' mich in seine pers&~onlichen
Dateien gehackt und mir seine Ansprache
angesehen.
}
//	<<<ENGLISH(2)>>>
//	I hacked into his personal
//	files and took a look at the
//	text of that speech.

/*今日の司令官の原稿をハックした。*/
オタコン_035: {
Ich sch&~atze, Du hast noch f&~unf Minuten -
vielleicht etwas l&~anger, wenn er noch ein
oder zwei Witze einstreut.
}
//	<<<ENGLISH>>>
//	I'd say you have seven more
//	minutes -- longer if he throws
//	in a joke or two.

/*だいたい１０分てところだ。
アドリブがなければだけど……。*/
スネーク_036: {
Ganze sieben Minuten Zeit, ja?
}
//	<<<ENGLISH>>>
//	A seven-minute time limit, huh?

/*１０分がタイムリミットか。*/
オタコン_037: {
Denk' dran, Snake, nur die Fotos, ok?
}
//	<<<ENGLISH>>>
//	Remember, Snake,
//	just the photos, OK?

/*スネーク、写真だけだよ。*/
スネーク_038: {
Bei den Risiken, werde ich nichts
Un&~uberlegtes tun.
}
//	<<<ENGLISH>>>
//	With these kinds of odds,
//	I won't be making any sudden
//	moves.

/*この数だ。そんな気は
起こしようもない。*/
スネーク_039: {
Wir k&~onnen trotzdem nicht zulassen, da&~s
Metal Gear entf&~uhrt wird.
}
//	<<<ENGLISH>>>
//	But that doesn't mean we can
//	just let Metal Gear be hijacked.

/*しかし、奴等に＃｛新型、アレ｝を
渡すわけにもいかない。*/
オタコン_040: {
Ok, ok, aber zuerst die Fotos.
}
//	<<<ENGLISH>>>
//	Okay, okay, but
//	first, the photos...

/*そうだけど、まずは写真を……。*/
スネーク_041: {
Alles klar. Wir k&~ummern uns um den Rest,
wenn es soweit ist.
}
//	<<<ENGLISH>>>
//	All right. We'll deal with
//	the rest when we get there.

/*わかった。後の事はそれから考える。*/
オタコン_042: {
Halt' Dich bedeckt!
}
//	<<<ENGLISH>>>
//	Stay low.

/*それじゃ、見つからないようにね。*/
/*
スネーク_043: {
The elevator is inactive.
I'm using the ladder.
}
//昇降機が動かない。
//梯子で降りる……。
*/

