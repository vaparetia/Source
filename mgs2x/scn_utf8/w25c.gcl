chara	マップ接合 タイトロープ１／２接合 タイトロープ１ タイトロープ２
mesg	マップ接合 タイトロープ１／２接合 on

command マップ設定 タイトロープ１ タイトロープ２ -set {
	@サウンド設定	// データは最初に呼ぶ
	@レーダー設定
	@常駐キャラ設定
	@共通シネマスクリーンセット
	@ローカル変数初期化
	@設定値変更
	@プラグイン設定
	@プレイヤー設定
	@コマンダー設定
	@ＢＧＭ設定	// プレイヤー→敵兵→BGMの順で呼ぶ
	@ドア設置
	@ロード設定
	@マップ切り替え設定
	@海面設置
	@フォグ設定
	@w25cカモメ配置
	@カメラセット
	@ＤＧ連絡橋破壊ビヨンド設定
	@タイトロープ１カメラ設定
	@w25cd共通カメラ設定
	@キャラ用ライト設置		// マップ設定の最後に呼ぶ
	@w25cd落下死亡処理
	@サイファー4人衆起動		// タイトロープ２に属するサイファの起動
	@デバッグキャラセット

	if( $s:登場ポイント == sp_w25b_w25c_0 ) {
		@プラント編全体マップ設定 d:Ｌ脚マップ		// stdproc.hで定義
	} else {
		@プラント編全体マップ設定 d:ＫＬ連絡橋マップ	// stdproc.hで定義
	}
}
command マップ設定 タイトロープ１ -set {
	@エフェクト設定
	@おしっこ兵制御
	@しゃがまないと入れない設定
	@サイファー設置１
	@崩落床設定
}

command マップ設定 タイトロープ２ -set {
	@主観禁止壁設定
	@w25cd共通エルード設定
	@アイテム設置
	@サイファー設置２
}

// 無線用include ※位置は動かさないこと
#include "w25c_cdc.ch"


// このステージに来るのは、ストーリー的にはエマ救出前と確定している

// 全てのセットが終わったところでフェードイン
if( $s:登場ポイント == sp_w25b_w25c_0 ) {
	// タイトロープ前半から
	//初期マップの表示
	command マップ表示 -show タイトロープ１
	// 全てのセットが終わったところでフェードイン
	command	不可装備設定 -item 	d:アイテム:ダンボール, \
					d:アイテム:ダンボールＢ, \
					d:アイテム:ダンボールＣ, \
					d:アイテム:濡れダンボール, \
					d:アイテム:ダンボールＤ, \
					d:アイテム:ダンボールＥ 
	@w25c専用ステージ開始時処理
	@w25c側ロード時カメラ設定
} else if( $s:登場ポイント == sp_w25b_w25c_1 ) {
	// デバッグ用途中から
	//初期マップの表示
	command マップ表示 -show タイトロープ１
	// 全てのセットが終わったところでフェードイン
	@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:NO_MOVE_TYPE 0 0 0 d:wn_ＫＬ連絡橋
} else if( $s:登場ポイント == sp_w31a_w25c_0 ) {
	// シェル２中央棟から
	//初期マップの表示
	command マップ表示 -show タイトロープ１
	// 全てのセットが終わったところでフェードイン
	@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:SL_DOOR_TYPE 中央棟へのドア 2250 d:DEFAULT_M_TYPE d:wn_ＫＬ連絡橋
	@中央棟ロード時カメラ設定;
}

proc w25c専用ステージ開始時処理 {
			@特殊装備解除
			// パッド操作を奪う(無線やポーズも不許可にする)
			command パッド操作 -release
			command メニュー設定 -radio off -pause off 

			// フェードインスタート(フェードの強さを弱める)
			chara フェードインアウト フェードイン \
				-i 0,0,0 128 \
				-c 0,0,0 0 \
				-t d:FADEIN_TIME -s 10

			print 'STAGE NAME DISP START'
			// 前のステージの表示に文字を重ねる
			@ステージ名表示 d:wn_Ｌ脚外周
			print 'STAGE NAME DISP END'

			command	強制モーション終了プロック \
				-proc ロード強制モーション終了

			mesg プレイヤー d:PLAYER motion d:モーションリスト:non_ladder_up_r_end  1365 -1 0 \
				( d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT ) \
				41160 -195850 0
/*
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p 40755,5742,-193117 -t 40967,181,-196192 \
				-r 694,2003,0 -f 6358 \
				-a 200 \
				-i 0 -1 0 0 \
				-s 1
*/
			chara delay パッドディレイ \
				-time d:FADEIN_TIME \
				-exec {
				}
}
proc ロード強制モーション終了 {
	command パッド操作 -cancel
	command メニュー設定 -radio on -pause on
	eval($f:ロードチェックＯＮフラグ = 1);
}

proc w25c専用ステージ終了時処理 $:目標位置Ｘ $:目標位置Ｙ $:目標位置Ｚ $:終了時方向 $:終了時プロック $:モーションタイプ $:表示文字 {
	// 梯子を上りながらのステージ切り替えを行うための特殊なステージ終了
	#if d:DEBUG_PRINT 
		print 'w25b special stage_end'
	#endif

	// 二重呼び防止のためにフラグを寝かす
	eval($f:ロードチェックＯＮフラグ = 0);

	// 次のステージへのアラートモード引継
	if ($w:ゲーム設定 <= d:LEVEL_EASY) {
		// easyより易しいレベルはロードすると潜入モード
		eval( $w:スタートアラートモード = d:ALERT_MODE_SENNYU );
	} else {
		if ($w:アラートモード == d:ALERT_MODE_KIKEN && $i:アラートレベル < 1024) {
			// 危険モード時(危険値MAXは除く)は回避モードまで下げる
			eval( $w:スタートアラートモード = d:ALERT_MODE_KAIHI );
		} else {
			eval( $w:スタートアラートモード = $w:アラートモード );
		}
	}

	if ($w:アラートモード != d:ALERT_MODE_KIKEN) {
		// 敵兵の視界オフ
		mesg コマンダー 敵兵セット 視界オフ
	}
	// 無線機からのコールがあった場合キャンセルをかける
	command 無線設定 -reset
	@特殊装備解除

	// パッド操作を奪う(無線やポーズもフラグをたてなければ不許可にする)
	command パッド操作 -release
	command メニュー設定 -menu off -gage off -radar off -subwin off -radio off -pause off

	// *********** ここからが梯子おりのための特別処理 ***************
	mesg プレイヤー d:PLAYER motion d:モーションリスト:non_ladder_down_r_start  (1365+1024) -1 0 \
		( d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT ) \
		41320 -195450 1000
	mesg プレイヤー d:PLAYER motion d:モーションリスト:non_ladder_down_loop  -1 -1 0 \
		( d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT ) 
	mesg プレイヤー d:PLAYER motion d:モーションリスト:non_ladder_down_loop  -1 -1 0 \
		( d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT ) 
	mesg プレイヤー d:PLAYER motion d:モーションリスト:non_ladder_down_loop  -1 -1 0 \
		( d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT ) 

	chara カメラ設定 モーションカメラ \
		-c 1 \
		-p 41155,4646,-195316 -t 41152,868,-195858 \
		-r 931,2052,0 -f 3817 \
		-a 200 \
		-i 0 -1 0 0 \
		-s 1

	// *********** ここまでが梯子のぼりのための特別処理 ***************

	chara delay ステージ名表示ディレイ \
		-time 40 \
		-arg $:表示文字 \
		-exec {
			@ステージ名表示（終了時） $1
		}

	eval($s:呼び出しプロック = $:終了時プロック);
	chara delay フェード遅延 -time 120 -exec {
		chara フェードインアウト フェードアウト \
			-c 0,0,0 128 \
			-t d:FADEOUT_TIME \		
			-p ロードプロック \
			-s 10
	}
}


// 各proc設定
