// 以下デバッグ専用proc
// -----------------------------------------------------------------------------------
// デバッグキャラ
// ------------------------------------
proc デバッグキャラセット {
	#if d:DEBUG_PRINT
		print 'debug_chara_set'
	#endif

	#if d:CHARA_CAMERA
		chara キャラカメラ 敵兵カメラ \
			-c d:TARGET_CHARA \
			-s -920,610,200 \
			-r -200,1024,0 
	#endif

	#if d:SCREENSHOT
		chara スクリーンショット shot
	#endif

	#if d:USB_KEY
		chara USBキーボード実行 test \
			-e d:KBD_ESC {	
				mesg プレイヤー d:PLAYER position -5500, -13000, -500
			} \
	#endif
}
proc w25c側ロード時カメラ設定 {
	chara カメラ設定 ロードカメラ \
		-c 1 \
		-p 38674,-1640,-196886 -t 41260,908,-195697 \
		-r 3620,743,0 -f 3820 \
		-a 200 \
		-i 0 1 0 0 \
		-s 1

	chara プロック連続実行 カメラ戻し管理人 \
		-proc カメラ戻し管理
}

proc 強制モーション終了時処理 {
	command パッド操作 -cancel
	command メニュー設定 -radio on -pause on
	eval($f:ロードチェックＯＮフラグ = 1);
}



