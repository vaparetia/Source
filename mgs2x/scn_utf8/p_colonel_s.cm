//イントルード説明 h //e
resource PC_イントルード１__s {
//vox t:vc260061{
大佐_000: {
Cuando te arrastres por un sitio
muy estrecho, la c&'amara pasar&'a
autom&'aticamente a la visi&'on Intrusi&'on.
}
//	<<<ENGLISH>>>
//	Whenever you crawl into a narrow
//	space, the camera will automati-
//	cally switch to Intrusion View.

/*狭い所に入り込んだ時は、自動的に
イントルードカメラになる。
*/
//dv}//v
}//d

resource PC_イントルード２__s {
//vox t:vc260071 {
大佐_000: {
Pulsa el joystick anal&'ogico izquierdo
para ir hacia delante,
}
//	<<<ENGLISH>>>
//	Push the left analog stick
//	up to move forward, down
//	to move back.
//<ページ数変更>
大佐_000_1: {
hacia abajo para ir hacia atr&'as, hacia
la izquierda o la derecha para girar en
esa direcci&'on.
}
//	<<<ENGLISH>>>
//	Push left and right to turn
//	in those directions.

/*左スティックの上で前進、下で後退、
左右はそれぞれの方向を向く。
*/
//dv}//v
}//d

resource PC_イントルード３__s {
//vox t:vc260081 {
大佐_000: {
No pierdas de vista al enemigo
y avanza todo el tiempo en secreto.
}
//	<<<ENGLISH>>>
//	Keep an eye on the enemy
//	and proceed under cover
//	at all times.
//<ページ数変更>
大佐_000_1: {
No te puedes permitir el lujo
de ser descubierto.
}
//	<<<ENGLISH>>>
//	You absolutely cannot afford
//	to be spotted.

/*敵の様子を伺いつつ、身を隠しながら
進むんだ。絶対に見つかるんじゃないぞ。
*/
//dv}//v
}//d

resource PC_イントルード＿銃撃てる__s {
//vox t:vc260091 {
大佐_000: {
A diferencia de los entrenamientos de RV,
cuando est&'es en la visi&'on Intrusi&'on podr&'as
utilizar tu arma. Recu&'erdalo.
}
//	<<<ENGLISH>>>
//	Unlike in VR training, you can use
//	your gun from Intrusion View in
//	the field. Keep that in mind.

/*ＶＲ訓練の時とは違いイントルード
カメラの時でも銃を撃つことが出来る。
忘れるなよ。
*/
//dv}//v
}//d
resource PC_イントルード＿危険性__s {
//vox t:vc260101 {
大佐_000: {
La visi&'on Intrusi&'on no garantiza
tu seguridad. Si te descubren,
te atacar&'an.
}
//	<<<ENGLISH>>>
//	Intrusion View does not guarantee
//	your safety. If you're spotted, you
//	will be attacked.

/*イントルードは決して安全と言うわけ
ではない。敵に発見されれば当然
攻撃を受ける。
*/
大佐_001: {
Evita ser descubierto cuando pases
a la posici&'on de Intrusi&'on.
}
//	<<<ENGLISH>>>
//	Make sure you're not spotted
//	sliding into Intrusion position.

/*潜り込むところを敵に見られないように
気をつけろ。
*/
大佐_002: {
Adem&'as puede que una patrulla rastree
la zona en la que te est&'es escondiendo
en la visi&'on Intrusi&'on.
}
//	<<<ENGLISH>>>
//	A patrol could also start checking
//	the spot where you're likely to be
//	hiding in Intrusion View.

/*イントルードで隠れていても敵が
覗き込んでくる時もあるだろう。
*/
大佐_003: {
En ese caso, permanece escondido
y cambia de escondite para que
el enemigo no te descubra.
}
//	<<<ENGLISH>>>
//	In that case, remain in Intrusion
//	and keep moving to stay out of
//	the enemy's sight.

/*その時はイントルードで移動しながら
敵の視線をかわさなければならない。
*/
大佐_004: {
La visi&'on Intrusi&'on no es un para&'iso
terrenal. &~?Lo entiendes?
}
//	<<<ENGLISH>>>
//	The Intrusion View is
//	no free lunch. Got that?

/*イントルードでも油断するんじゃないぞ。
いいな。
*/
//dv}//v
}//d


//泳ぎ、落ちたらＣＡＬＬ h //e
