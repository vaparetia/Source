//主観攻撃 h //e
resource PC_主観攻撃１__s {
//vox t:vc264871 {
大佐_000: {
Selecciona un arma y pasa a la visi&'on
Primera Persona pulsando el bot&'on R1.
}
//	<<<ENGLISH>>>
//	Select a weapon and switch
//	to First Person View with
//	the R1 button.
//<ページ数変更>
大佐_000_1: {
Podr&'as atacar en la Visi&'on Primera
Persona si pulsas el bot&'on Arma.
}
//	<<<ENGLISH>>>
//	You can now execute a First
//	Person View attack with the
//	Weapon button.

/*武器を装備して、Ｒ１ボタンで
主観カメラにすれば、□ボタンで
主観攻撃が出来る。
*/
//dv}//v
}//d
resource PC_主観攻撃２__s {
//vox t:vc264881 {
大佐_000: {
En Visi&'on Primera Persona, apuntar&'as
con m&'as precisi&'on a la cabeza,
}
//	<<<ENGLISH>>>
//	In First Person View, you'll
//	specifically be able to target
//	the head,
