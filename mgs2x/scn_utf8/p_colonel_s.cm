/*どういう意味だ？*/
大佐_004: {
Vale, escucha. &'Esta es la verdad.
}
//	<<<ENGLISH>>>
//	Okay, listen.
//	Here are the facts.

/*いいか。事実はこれだ。
*/
大佐_005: {
El conocido terrorista Solid Snake
hundi&'o un tanque
}
