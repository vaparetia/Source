//<ページ数変更>
大佐_000_1: {
C&'ogela.
}
//	<<<ENGLISH>>>
//	Don't forget to retrieve it.

/*見つからずに敵を倒すと
アイテムボックスを出すことがある。
忘れずに回収しておくんだ。
*/
//dv}//v
}//d


//ホールドアップ h //e
resource PC_ホールドアップ１__s {
//vox t:vc260961 {
大佐_000: {
Ac&'ercate al enemigo sin ser descubierto
y utiliza tu pistola antes de que pueda
reaccionar.
}
//	<<<ENGLISH>>>
//	Approach the enemy undetected
//	and train your gun on him before
