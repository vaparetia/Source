*/
//dv}//v
}//d


//初めての敵兵。対処の初歩の初歩 h //e
resource PC_戦闘＿素手__s {
//vox t:vc264721 {
大佐_000: {
Todav&'ia no has conseguido ning&'un arma.
}
//	<<<ENGLISH>>>
//	You haven't acquired
