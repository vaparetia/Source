大佐_002: {
Podr&'as despistar al enemigo.
}
//	<<<ENGLISH>>>
//	It could be used as a ploy
//	to lure the enemy in.

/*敵をおびき寄せるのに役立つかもな。
*/
//dv}//v
}//d



//武器・アイテム装備方法 h //e
resource PC_武器装備品装備法１__s {
//vox t:vc265061 {
大佐_000: {
Para seleccionar un arma, pulsa y mant&'en
pulsado el bot&'on R2 y abre la Ventana de
Armas.
}
//	<<<ENGLISH>>>
//	To select a weapon, push and
//	hold the R2 button and open
//	the Weapons Window.
//<ページ数変更>
大佐_000_1: {
Ver&'as expuestos los iconos de armas.
}
//	<<<ENGLISH>>>
//	You will see an array
//	of weapon icons.

/*武器を装備するには、Ｒ２ボタンを
押しっぱなしにして武器ウィンドウを
開け。武器のアイコンが表示される。
*/
大佐_001: {
Selecciona el arma con el joystick
anal&'ogico izquierdo hacia arriba y abajo.
}
//	<<<ENGLISH>>>
//	Select the desired weapon by
//	moving the left analog stick
//	up and down.
//<ページ数変更>
大佐_001_1: {
El icono seleccionado aparecer&'a
en la parte inferior derecha.
}
//	<<<ENGLISH>>>
//	The chosen icon will
//	appear in the lower right.

/*その中から使いたい武器を
左スティックの上下で選んで
右下に合わせるんだ。
*/
大佐_002: {
Habr&'as notado una peque&~na diferencia
con los entrenamientos de RV,
}
//	<<<ENGLISH>>>
//	You may notice a slight difference
//	from the VR training mode --
//<ページ数変更>
大佐_002_1: {
las armas de la misma clase aparecen
en la misma fila.
}
//	<<<ENGLISH>>>
//	any weapons you have from the
//	same class are displayed on the
//	same row.

/*ＶＲ訓練と少し違うのは同じ系統の
武器をいくつか持っている場合、
アイコンが横に並んで表示されることだ。
*/
大佐_003: {
Podr&'as seleccionar un arma de una fila
moviendo el joystick anal&'ogico izquierdo
hacia la izquierda y derecha.
}
//	<<<ENGLISH>>>
//	You can select a weapon out of the
//	row by moving the left analog stick
//	left and right.
//<ページ数変更>
大佐_003_1: {
El arma seleccionado deber&'ia de aparecer
en la parte derecha.
}
//	<<<ENGLISH>>>
//	The selected weapon should
//	appear to the far right.

/*横に並んでいる武器の中から使いたい
ものを左スティックの左右で選んで
一番右に合わせろ。
*/
大佐_004: {
Suelta el bot&'on R2 y el arma que hayas
seleccionado estar&'a en tu mano.
}
//	<<<ENGLISH>>>
//	Let go of the R2 button and
//	the selected weapon will be
//	in your hand.

/*そこでＲ２ボタンを離せば、
君の手に選んだ武器が握られている
はずだ。
*/
大佐_005: {
Sigue las instrucciones para
la utilizaci&'on de cada arma.
}
//	<<<ENGLISH>>>
//	Follow the window instructions
//	on how to use each weapon.

/*それぞれの武器の使い方は、
ウィンドウに表示される説明に
従ってくれ。
*/
//dv}//v
}//d

resource PC_武器装備品装備法２__s {
//vox t:vc265071 {
