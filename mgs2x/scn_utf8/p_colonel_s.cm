//	But Colonel, there's
//	nowhere to hide...

/*しかし大佐、ここには隠れられる場所が
無い……。
*/
ローズ_002: {
Jack, sal de ah&'i.
}
//	<<<ENGLISH>>>
//	Jack, snap out of it.

/*ジャック、弱気にならないで。*/
//dv}//v
}//d
