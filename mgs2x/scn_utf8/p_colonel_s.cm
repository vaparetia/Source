//<ページ数変更>
大佐_000_1: {
arriba, abajo, izquierda y derecha.
}
//	<<<ENGLISH>>>
//	left and right movement of
//	the left analog stick.

/*水面を泳いでいる時は左スティックの
上下左右でそれぞれの方向に泳ぐことが
出来る。
*/
//dv}//v
}//d
