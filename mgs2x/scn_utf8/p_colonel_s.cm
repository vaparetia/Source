//銃は撃つと音がする注意 h //e
resource PC_銃入手注意__s {
//vox t:vc262651 {
大佐_000: {
Veo que has conseguido una pistola.
}
//	<<<ENGLISH>>>
//	I see you've acquired a gun.

/*銃を手に入れたな。*/
ライデン_001: {
Me la dio Pliskin.
}
//	<<<ENGLISH>>>
//	Pliskin gave it to me.

/*ああ。プリスキンがくれた。*/
大佐_002: {
No conf&'ies en ese hombre...
Pero la pistola parece que est&'a bien.
}
//	<<<ENGLISH>>>
//	Don't trust that man...
//	But the gun itself seems
//	all right.

/*あの男は信用できんが……
銃自体は信用しても良いだろう。
*/
大佐_003: {
Sin embargo, no tiene un silenciador.
}
//	<<<ENGLISH>>>
//	However, it's not equipped
//	with a suppressor.
//<ページ数変更>
大佐_003_1: {
Si disparas, el ruido alertar&'a al enemigo
que est&'e lo suficientemente ＃－
}
//	<<<ENGLISH>>>
//	If you fire it, the noise will
//	be loud enough to alert any
//	enemy personnel＃－
//<ページ数変更>
大佐_003_2: {
cerca como para o&'ir el disparo.
}
//	<<<ENGLISH>>>
//	within hearing distance
//	to your presence.

/*だがその銃はサプレッサーを装着して
いない。撃てば当然銃声がするぞ。
銃声を敵に聞かれれば発見されてしまう。
*/
大佐_004: {
La infiltraci&'on es para hacerte invisible.
}
//	<<<ENGLISH>>>
//	Infiltration is the art of making
//	your presence invisible.
//<ページ数変更>
大佐_004_1: {
Evita, siempre que puedas, luchar.
}
//	<<<ENGLISH>>>
//	Try not to end up in a situation
//	where you need to rely on firepower.
//<ページ数変更>
大佐_004_2: {
S&'olo deber&'as luchar cuando sea
absolutamente necesario.
}
//	<<<ENGLISH>>>
//	Combat must be avoided
//	unless absolutely necessary.

/*潜入任務の基本は隠密行動だ。まず銃を
使うような局面に陥らないことをこころ
がけろ。戦闘は可能な限り避けるんだ。
*/
//dv}//v
}//d



//★P011_01_R01ＢＣ連絡橋ＣＡＬＬ１無線デモ１終了＜フラグ＜P012_01_P01フォーチュン遭遇１ポリゴンデモ１開始 d //e

