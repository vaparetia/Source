//dv}//v
}//d





//ハリアー戦後 d //e
//スネークについて h //e
resource PC_ハリアー戦後＿スネーク__s {
//vox t:vc266191 {
ライデン_000: {
Coronel, despu&'es de todo
Pliskin es Snake.
}
//	<<<ENGLISH>>>
//	Colonel, Pliskin was
//	Snake after all.

/*大佐、プリスキンはやはりスネーク
だった……。
*/
大佐_001: {
Bueno, seg&'un &'el.
}
//	<<<ENGLISH>>>
//	According to him.

/*奴いわく、な。*/
ライデン_002: {
&~?Qu&'e?
}
//	<<<ENGLISH(2)>>>
//	What?

/*なんだって？*/
大佐_003: {
Escucha Raiden, repito,
&'el no forma parte de la simulaci&'on.
}
//	<<<ENGLISH>>>
//	Listen, Raiden. I'll say it again.
