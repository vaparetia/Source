Bueno aunque la verdad hay muy pocos
trabajadores, ya que todo est&'a muy
automatizado.
}
//	<<<ENGLISH>>>
//	That being said, almost all systems are
//	completely automated, so there aren't
//	many workers to be found.

/*といっても、『ビッグ・シェル』は
全システムがほぼ自動化されているから
職員の数は少ないんだけど。
*/
//dv}//v
}//d


//Ｄ脚の役割について h //e
resource PC_Ｄ脚機能説明__s {
//vox t:vc266441 {
ローズ_000: {
El Soporte D es el dep&'osito de
sedimentaci&'on No 1.
}
//	<<<ENGLISH>>>
//	Strut D is Sediment Pool No. 1.
//<ページ数変更>
ローズ_000_1: {
En este lugar el agua contaminada
permanece en reposo,
}
//	<<<ENGLISH>>>
//	It's a facility where extracted
//	polluted water is stored without
