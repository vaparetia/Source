*/
大佐_001: {
Ten cuidado, no le mates.
}
//	<<<ENGLISH>>>
//	Don't knock the man out either.
//	Be careful.

/*敵兵士の意識を失わせては駄目だ。
注意しろ。
*/
//dv}//v
}//d
