}
//	<<<ENGLISH>>>
//	Unlike in VR training, you can
//	fight in First Person View also.
//	Use that to your advantage.

/*ＶＲ訓練とは違って主観でも攻撃できる。
うまく使うんだ。
*/
//dv}//v
}//d
//投げ h //e
resource PC_戦闘＿投げ__s {
//vox t:vc264741 {
大佐_000: {
Cuando no tengas ning&'un arma
seleccionada, ac&'ercate al enemigo.
Podr&'as tirarle si pulsas el bot&'on Arma.
}
//	<<<ENGLISH>>>
//	Move in close to the enemy when you
//	have no weapons selected. You can
//	throw him with the Weapon button.

/*武器を装備していない場合のみ、
敵に接近して□ボタンで投げ技が使える。
*/
大佐_001: {
Si tiras al enemigo le causar&'as m&'as da&~nos
que si le das un pu&~netazo. Recu&'erdalo.
}
//	<<<ENGLISH>>>
//	The throw inflicts greater damage
//	than the punch. Keep that in mind.

/*パンチよりも大きなダメージを
与えることが出来るぞ。
*/
//dv}//v
}//d
