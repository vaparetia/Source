//<ページ数変更>
大佐_002_1: {
Pero no te conf&'ies.
}
//	<<<ENGLISH>>>
//	Don't let your guard down, though.

/*奴の目的は分からんが彼が君を
助けようとしていることは確かだ。
だが油断はするなよ。
*/
//dv}//v
}//d

