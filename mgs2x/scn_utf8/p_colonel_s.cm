*/
//dv}//v
}//d

//探索モード h //e
resource PC_探索モード__s {
//vox t:vc265031 {
大佐_000: {
Raiden, cuando te descubran, no podr&'as
relajarte aunque ya te hayan dejado de
seguir.
}
//	<<<ENGLISH>>>
//	Once you're spotted, Raiden, you
//	cannot afford to relax even after
