大佐_000_1: {
los pies y otras partes estrat&'egicas.
}
//	<<<ENGLISH>>>
//	feet and other
//	strategic areas.
//<ページ数変更>
大佐_000_2: {
Tambi&'en podr&'as apuntar a zonas
inaccesibles desde el punto de vista
est&'andar,
}
//	<<<ENGLISH>>>
//	You can also aim your strike in
//	directions not available from
//	the regular point of view:
//<ページ数変更>
大佐_000_3: {
como por encima de la cabeza,
desde abajo, etc.
}
//	<<<ENGLISH>>>
//	overhead, straight
//	down and so on.

/*主観攻撃ならば敵の頭や足などを
狙うことが出来る。上や下など俯瞰では
攻撃出来ない方向にも攻撃出来る。
*/
//dv}//v
}//d
//＊ムービー t //e
resource PC_主観攻撃＿左右ステップ１__s {
//vox t:vc264891 {
大佐_000: {
En un ataque en Visi&'on Primera Persona,
puedes bombardear hacia la izquierda y
derecha pulsando el bot&'on L2 o R2.
}
//	<<<ENGLISH>>>
//	You can strafe left and right even
//	during a First Person View attack
//	by pushing the L2 or R2 buttons.
//<ページ数変更>
大佐_000_1: {
Si pulsas el bot&'on Gatear podr&'as
agacharte.
}
//	<<<ENGLISH>>>
//	Also, the Crawl button will
//	let you go into a crouch.

/*主観攻撃中にもＬ２ボタン、Ｒ２ボタン
を押せば左右にステップし、×ボタンを
押せばしゃがむことが出来る。
*/
大佐_001: {
Pulsa el bot&'on L2 y el bot&'on R2 al
mismo tiempo para ponerte de puntillas.
}
//	<<<ENGLISH>>>
//	Push the L2 and R2 buttons at
//	the same time to stretch up on
//	your toes.

/*Ｌ２ボタンとＲ２ボタンを動じに押せば
背伸びをすることも可能だ。
*/
大佐_002: {
Es muy &'util cuando quieras luchar contra
un enemigo desde detr&'as de un objeto.
Util&'izalo.
}
//	<<<ENGLISH>>>
//	This is a useful move when
//	engaging the enemy from
//	behind cover. Explore it.

/*遮蔽物に隠れながらの銃撃戦では
