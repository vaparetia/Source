//エマの座り込み h //e
resource PC_エマ手つなぎ＿座り込み１__s {
//vox t:vc264221 {
大佐_000: {
Raiden, &~?c&'omo est&'a Emma?
}
//	<<<ENGLISH>>>
//	Raiden, how's Emma doing?

/*ライデン、エマの様子はどうだ？*/
ライデン_001: {
Las piernas no le responden muy bien.
La droga que le ha dado Ocelot todav&'ia
le est&'a haciendo efecto.
}
//	<<<ENGLISH>>>
//	She's pretty shaky on her feet.
//	Whatever Ocelot drugged her with,
//	it's still having an effect on her.

/*オセロットに打たれた薬物の影響が
まだ残っているようだ。足元がかなり
おぼつかない。
*/
ローズ_002: {
Pobrecita. Cu&'idala, &~?vale?
}
//	<<<ENGLISH>>>
//	Poor thing.
//	Look after her, okay?

/*かわいそう。守ってあげてね。
*/
ライデン_003: {
Lo intentar&'e.
}
//	<<<ENGLISH>>>
//	I'll try.

/*わかってる。*/
//dv}//v
}//d
resource PC_エマ手つなぎ＿座り込み２__s {
//vox t:vc264231 {
大佐_000: {
No puede andar sola por las drogas que
todav&'ia hay en su sistema.
}
//	<<<ENGLISH>>>
//	She can't even walk by herself
//	because of the drugs in her system.
//<ページ数変更>
大佐_000_1: {
&~?Has visto como se sienta
cuando le sueltas la mano?
}
//	<<<ENGLISH>>>
//	See how she has to sit down
//	when you let go of her hand?

/*薬物の影響で、エマは一人で歩くことも
ままならない。君が手を離すと、彼女は
その場に座り込んでしまうだろう。
*/
大佐_001: {
Si tienes que soltarle la mano, aseg&'urate
