//赤外線センサー h //e
resource PC_ＥＦ連絡橋＿赤外線センサー１__s {
//vox t:vc261261 {
大佐_000: {
Ten cuidado Raiden. Hay trampas de
sensores de infrarrojos en ese lugar.
}
//	<<<ENGLISH>>>
//	Watch out, Raiden. There are
//	IR sensor traps in that location.

/*ライデン、気をつけろ。
そこには赤外線センサーが
仕掛けられている。*/
//dv}//v
}//d
resource PC_ＥＦ連絡橋＿赤外線センサー＿触るな１__s {
//vox t:vc261271 {
ライデン_000: {
&~?Sensores de infrarrojos?
}
//	<<<ENGLISH>>>
//	Infrared sensors?

/*赤外線センサー？*/
大佐_001: {
S&'i. Una trampa bomba conectada
a explosivos pl&'asticos.
}
//	<<<ENGLISH>>>
//	Right. A booby trap connected
//	to plastic explosives.

/*そう。
プラスティック爆弾と連動した
トラップだ。
*/
//dv}//v
}//d
resource PC_ＥＦ連絡橋＿赤外線センサー＿触るな２__s {
//vox t:vc261281 {
大佐_000: {
Si pasas por un rayo infrarrojo,
se producir&'a una explosi&'on de una
cantidad considerable de Semtex.
}
//	<<<ENGLISH>>>
//	Crossing an IR beam will trigger
//	the detonation of a critical
//	amount of Semtex.
//<ページ数変更>
大佐_000_1: {
No cometas ning&'un error, o acabar&'as
frito. Evita pasar por los rayos.
}
//	<<<ENGLISH>>>
//	You will be killed, make no mistake
//	about it. Avoid contact with the
//	beams at all cost.

/*赤外線に触れれば大量のセムテックスが
爆発する。そうなれば命はないぞ。
赤外線には絶対に触れるな。
*/
//dv}//v
}//d

resource PC_ＥＦ連絡橋＿赤外線センサー＿制御装置破壊１__s {
//vox t:vc261291 {
大佐_000: {
Hay demasiados rayos infrarrojos, no
podr&'as pasar por all&'i sin ser descubierto.
}
//	<<<ENGLISH>>>
//	There are too many beams in
//	place for you to get past the
//	sensor undetected.

/*だが赤外線に触れずにセンサーの間を
抜けることは出来ないだろうだろう。
赤外線の本数が多すぎる。
*/
ライデン_001: {
&~?Y qu&'e puedo hacer?
}
//	<<<ENGLISH>>>
//	What should I do?

/*どうすれば？*/
大佐_002: {
Tendr&'as que desactivar el sensor.
}
//	<<<ENGLISH>>>
//	You'll have to take the
//	sensor itself offline.

/*センサー自体を無効にするしかないな。
*/
//dv}//v
}//d

resource PC_ＥＦ連絡橋＿赤外線センサー＿制御装置破壊__s {
//vox t:vc261301 {
大佐_000: {
Destruye la unidad de control del sensor.
}
//	<<<ENGLISH>>>
//	Take out the control unit
//	on the sensor.
//<ページ数変更>
大佐_000_1: {
Al lado de los explosivos, ver&'as
una unidad con una luz verde
parpadeante.
}
//	<<<ENGLISH>>>
//	You should be able to see a unit
//	with a blinking green light next
//	to the explosives.
//<ページ数変更>
大佐_000_2: {
&'Esa es la unidad de control.
}
//	<<<ENGLISH>>>
//	That's the control unit.

/*センサーの制御装置を破壊するんだ。
爆弾の近くに緑色に点滅するランプの
ついた装置がある。それが制御装置だ。
*/
大佐_001: {
Los sensores de infrarrojos dejar&'an
de funcionar tras destruir la unidad
de control.
}
//	<<<ENGLISH>>>
//	With the control unit destroyed,
//	the IR sensor will cease to function.
//<ページ数変更>
大佐_001_1: {
Dispara a la unidad de control.
}
//	<<<ENGLISH>>>
//	Shoot out the control unit.

/*制御装置を破壊すれば赤外線センサーは
機能を停止する。制御装置を銃で
撃ち抜くんだ。
*/
//dv}//v
}//d
resource PC_ＥＦ連絡橋＿赤外線センサー４__s {
//vox t:vc261311 {
大佐_000: {
La pistola tranquilizadora no sirve
para hacerlo.
}
//	<<<ENGLISH>>>
//	The tranquilizer gun
//	won't do the job.

/*麻酔銃では破壊できんから気をつけろ。
*/
//dv}//v
}//d
resource PC_ＥＦ連絡橋＿赤外線センサー５__s {
//vox t:vc261321 {
大佐_000: {
Hagas lo que hagas, no toques el Semtex.
}
//	<<<ENGLISH>>>
//	Whatever you do, don't
//	touch the Semtex.
//<ページ数変更>
大佐_000_1: {
Puede que haya otro detonador
que lo haga explotar.
}
//	<<<ENGLISH>>>
//	Assume that there's another
//	detonator that responds to shock.

/*間違ってセムテックスを撃つなよ。
衝撃が加わると爆発する仕掛けが
されていると考えた方がいい。
*/
大佐_001: {
Destruye la unidad de control
que tiene una luz verde.
}
//	<<<ENGLISH>>>
//	Take out only the control unit
//	with the green light.
//<ページ数変更>
大佐_001_1: {
Pasa a la visi&'on Primera Persona
y apunta con precisi&'on.
}
//	<<<ENGLISH>>>
//	Go to First Person View and aim
//	with as much precision as you can.

/*緑色のランプがついた制御装置だけを
撃ち抜くんだ。主観攻撃でよく狙え。
*/
//dv}//v
}//d

//クリア条件 h //e
resource PC_ＥＦ連絡橋＿赤外線センサー＿クリア__s {
//vox t:vc261331 {
大佐_000: {
Tras destruir todas las unidades
de control, los rayos infrarrojos
desaparecer&'an.
}
//	<<<ENGLISH>>>
//	Once you take out every control
//	unit, the IR beams will disappear.

/*制御装置を全て機能停止させれば
赤外線は消える。
*/
大佐_001: {
Si todav&'ia ves alg&'un rayo, es que hay
alguna otra unidad de control que no has
destruido.
}
//	<<<ENGLISH>>>
//	If you still see an intact beam,
//	that means you've left a control
//	unit untouched.

/*赤外線がまだ残っているとしたら、
破壊していない制御装置がどこかに
あるということだ。
*/
大佐_002: {
Destruye todas las unidades de control.
}
//	<<<ENGLISH>>>
//	Take every control unit offline.

/*制御装置を全て破壊しろ。*/
//dv}//v
}//d
//工夫して撃て h //e
resource PC_ＥＦ連絡橋＿赤外線センサー＿工夫狙い__s {
//vox t:vc261341 {
大佐_000: {
No todas las unidades de control
est&'an en lugares visibles.
}
//	<<<ENGLISH>>>
//	Not all control units are
//	in a highly visible spot.
//<ページ数変更>
大佐_000_1: {
Mira bien en visi&'on Primera Persona.
}
//	<<<ENGLISH>>>
//	Use the First Person View
//	to take a good look.

/*制御装置は分かりやすい場所に
設置されているとは限らない。
主観でよく探すんだ。
*/
大佐_001: {
En visi&'on Primera Persona pulsa
los botones R2 y L2 al mismo tiempo
para ponerte de puntillas.
}
//	<<<ENGLISH>>>
//	Push the R2 and L2 buttons
//	simultaneously in First Person
//	View to stretch up on your toes.

/*主観カメラ中にＲ２ボタンと
Ｌ２ボタンを同時に押せば背伸びが
出来る。
*/
大佐_002: {
Tambi&'en te puedes agachar y gatear
si pulsas el bot&'on Gatear.
}
//	<<<ENGLISH>>>
//	You can also crouch down and
//	crawl by using the Crawl button.
//<ページ数変更>
大佐_002_1: {
Cambia tu punto de vista y
mira bien por los alrededores.
}
//	<<<ENGLISH>>>
//	Change your vantage point and
//	conduct a thorough search.

/*他にも×ボタンでしゃがんだり、
ホフクしたり、いろいろ視点を変えて
探してみろ。
*/
大佐_003: {
Utiliza todos tus recursos para encontrar
todas las unidades de control, incluso las
m&'as inaccesibles.
}
//	<<<ENGLISH>>>
//	Use your skills and you should be
//	able to deal with control units in
//	hard-to-reach spots.

/*狙いにくい場所にある制御装置も
工夫すれば必ず撃てるはずだ。
*/
//dv}//v
}//d
//赤外線見方 h //e
resource PC_ＥＦ連絡橋＿赤外線センサー＿たばこ__s {
//vox t:vc261351 {
大佐_000: {
Los rayos infrarrojos no se pueden
ver a simple vista.
}
//	<<<ENGLISH>>>
//	Infrared is usually invisible
//	to the naked eye.
//<ページ数変更>
大佐_000_1: {
Sin embargo, hay gve haber alguna
forma de verlos.
}
//	<<<ENGLISH>>>
//	There should, however, be
//	a way to make it visible.

/*赤外線は通常、肉眼で見ることは
出来ない。だが見えるようにする
方法はあるはずだ。
*/
ローズ_001: {
Prueba con los objetos que tienes.
}
//	<<<ENGLISH>>>
//	You could experiment
//	with what you have.

/*装備品をいろいろ試してみたら？
*/
//dv}//v
}//d
//見方ズバリ h //e
resource PC_ＥＦ連絡橋＿赤外線センサー＿たばこズバリ__s {
//vox t:vc261361 {
大佐_000: {
Echa el humo de tu cigarro en la zona
en la que crees que hay rayos infrarrojos.
}
//	<<<ENGLISH>>>
//	Blow some cigarette smoke on
//	the likely spot to see if there
//	are any IR beams.
//<ページ数変更>
大佐_000_1: {
Selecciona los cigarros cerca
de un sensor de infrarrojos.
}
//	<<<ENGLISH>>>
//	Select the cigarettes
//	near an IR sensor.

/*煙草の煙を吹きかければどこに赤外線が
通っているかわかるはずだ。赤外線
センサーの近くで煙草を装備してみろ。
*/
//dv}//v
}//d


//うみどり h //e
resource PC_赤外線センサー＿海鳥１__s {
//vox t:vc261371 {
大佐_000: {
Raiden, cuidado con los p&'ajaros.
}
//	<<<ENGLISH>>>
//	Raiden, watch out for the birds.
//<ページ数変更>
大佐_000_1: {
Si alguno de ellos vuela a trav&'es de
un rayo infrarrojo, el Semtex explotar&'a.
}
//	<<<ENGLISH>>>
//	If one of them manages to fly
//	through an IR beam, the Semtex
//	will detonate.

/*ライデン、海鳥に気をつけろ。
飛び立った海鳥が赤外線に触れても
セムテックスは爆発するぞ
*/
//dv}//v
}//d
resource PC_赤外線センサー＿海鳥２__s {
//vox t:vc261381 {
大佐_000: {
No les asustes. Oc&'upate de los p&'ajaros
antes de acercarte a ellos.
}
//	<<<ENGLISH>>>
//	Don't startle them. Do something
//	about the birds before you get
//	close to the flock.

/*海鳥を驚かせないようにするんだ。。
近づく時はあらかじめ海鳥をなんとか
しておいた方がいい。
*/
//dv}//v
}//d
resource PC_赤外線センサー＿海鳥＿麻酔銃__s {
//vox t:vc261391 {
ローズ_000: {
&~?Por qu&'e no utilizas la pistola
tranquilizadora para dormirlos?
}
//	<<<ENGLISH>>>
//	How about using the tranquilizer
//	gun to knock them out?

/*麻酔銃で眠ってもらったらどう？
*/
//dv}//v
}//d


//ガンサイファー h //e
resource PC_ガンサイファー１__s {
//vox t:vc261401 {
大佐_000: {
Raiden, hay un Gun Cypher volando
por los alrededores.
}
//	<<<ENGLISH>>>
//	Raiden, there's a Gun Cypher
//	flying over there.
//<ページ数変更>
大佐_000_1: {
No son naves Cypher UAV normales.
Est&'an armados. Ten cuidado.
}
//	<<<ENGLISH>>>
//	Those aren't the normal Cypher
//	UAV's. These are armed. Watch
//	out.

/*ライデン、ガンサイファーが飛んでいる。
通常のサイファーとは違い、機銃を
装備した攻撃型のＵＡＶだ。気をつけろ。
*/
//dv}//v
}//d
resource PC_ガンサイファー＿チャフ__s {
//vox t:vc261411 {
大佐_000: {
Puedes neutralizar los Gun Cypher
temporalmente.
}
//	<<<ENGLISH>>>
//	Gun Cyphers can be put out
//	of commission temporarily.
//<ページ数変更>
大佐_000_1: {
Utiliza el chaff para interferir
con los sensores electr&'onicos.
}
//	<<<ENGLISH>>>
//	Use the chaff to interfere with
//	their electronic sensors.

/*チャフを使って電子装置を撹乱すれば、
しばらくの間ガンサイファーの動きを
止めることが出来るはずだ。
*/
//dv}//v
}//d
resource PC_ガンサイファー＿撃墜__s {
//vox t:vc261421 {
大佐_000: {
Puedes destruir los Gun Cypher
si apuntas a la zona del ventilador.
Apunta en la visi&'on Primera Persona.
}
//	<<<ENGLISH>>>
//	You can shoot Gun Cyphers down
//	if you target the fan section or its
//	gun. Aim in First Person View.

/*ガンサイファーを撃ち落とすには
機銃部分かファンを破壊すればいい。
主観攻撃でよく狙うんだ。
*/
//dv}//v
}//d

//Ｅ脚 d //e
//ベルトコンベア 荷物に隠れながら進め h //e
resource PC_Ｅ脚１Ｆ＿ベルトコンベア＿荷物に隠れろ１__s {
//vox t:vc261431 {
大佐_000: {
