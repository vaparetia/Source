}//d



//エイムズについて h //e
resource PC_エイムズ１__s {
//vox t:vc265971 {
ライデン_000: {
Coronel, &~?qui&'en es realmente Ames?
}
//	<<<ENGLISH(2)>>>
//	Colonel, who's that person Ames?

/*大佐、エイムズというのは何者なんだ？*/
//dv}//v
}//d
resource PC_エイムズ２__s {
//vox t:vc265981 {
ローズ_000: {
He mirado la lista de los miembros
del Servicio Secreto del Presidente.
}
//	<<<ENGLISH>>>
//	I checked the roster of Secret
//	Service members serving the
//	President.
//<ページ数変更>
ローズ_000_1: {
Hab&'ia uno que se llamaba Ames.
}
//	<<<ENGLISH>>>
//	There was definitely a person
//	on the list named Ames.

/*大統領に随伴したシークレットサービス
の名簿を調べてみた。確かにエイムズっ
ていういう名前があるわ。
*/
大佐_001: {
As&'i que lo que nos dijo el Ninja,
no era mentira.
}
//	<<<ENGLISH>>>
//	So what that Ninja said, then,
//	was not a lie after all.

/*あの忍者の言ったことは嘘ではなかった
ということだな。
*/
ライデン_002: {
Seg&'un esa lista.
Rose, &~?tienes m&'as informaci&'on?
}
//	<<<ENGLISH>>>
//	As far as the roster goes, no.
//	Rose, do you have any other
//	information?

/*リストの上ではな。
ローズ、他に情報は？
*/
ローズ_003: {
No, voy a investigarle ahora mismo.
}
//	<<<ENGLISH>>>
//	All right. I'll look
//	into it for you.

/*わかった。調べてみる。
*/
ライデン_004: {
Conf&'io en ti.
}
//	<<<ENGLISH(2)>>>
//	I'm counting on you.

/*頼む。*/
//dv}//v
}//d
//エイムズしばらくしてから h //e
resource PC_エイムズ２＿２__s {
//vox t:vc265991 {
大佐_000: {
Raiden, Rosemary tiene informaci&'on
sobre Ames.
}
//	<<<ENGLISH>>>
//	Raiden, Rosemary has
//	a report for you, on Ames.

/*ライデン、ローズ君から報告がある。
エイムズについてだ。
*/
//dv}//v
}//d
resource PC_エイムズ３__s {
//vox t:vc266001 {
ローズ_000: {
&~?Jack? Es sobre Ames.
}
//	<<<ENGLISH>>>
//	Jack? It's about Ames.

/*ジャック？
エイムズのことだけど……。*/
ライデン_001: {
&~?Has descubierto algo?
}
//	<<<ENGLISH(2)>>>
//	Did you find anything?

/*何かわかったか？*/
ローズ_002: {
S&'i. Que no hay nada que encontrar.
}
//	<<<ENGLISH>>>
//	Yeah. Only that there
//	is nothing to find.

/*ええ。
何もわからないってことがわかった。
*/
ライデン_003: {
&~?Qu&'e?
}
//	<<<ENGLISH(2)>>>
//	What?

/*なんだって？*/
ローズ_004: {
No hay ni un informe sobre &'el. Ni su
n&'umero de la seguridad social, ni su
direcci&'on, ni su pasado...
}
//	<<<ENGLISH>>>
//	There is not a single record.
//	Let alone his social security
//	number, address, or background,
//<ページ数変更>
ローズ_004_1: {
ni siquiera he encontrado su sexo,
edad o nombre completo...
}
//	<<<ENGLISH>>>
//	I couldn't even find Ames'
//	gender, age, or full name...

/*記録が何もないの。社会保障番号や
住所、経歴はおろか、性別も年齢も
フルネームさえ……。
*/
ライデン_005: {
&~?Qu&'e quieres decir?
}
//	<<<ENGLISH>>>
//	What does that mean?

/*どういうことだ？*/
ローズ_006: {
Lo &'unico que he encontrado es "Ames",
s&'olo esa palabra.
}
//	<<<ENGLISH>>>
//	All I found out was "Ames,"
//	just that one word.

/*わからない。わかったのはエイムズ。
その一語だけ。
*/
ライデン_007: {
...
}
/*……。*/
//dv}//v
}//d
resource PC_エイムズ４__s {
//vox t:vc266011 {
大佐_000: {
De todas formas, Ames nos puede llevar
hasta el Presidente.
}
//	<<<ENGLISH>>>
//	Even still, Ames is our way
//	to the President. We'll have
//	to make contact.
//<ページ数変更>
大佐_000_1: {
Ponte en contacto con &'el.
Ve al S&'otano B1 del N&'ucleo
del Shell 1.
}
//	<<<ENGLISH>>>
//	Head for Floor B1 in
//	the core of Shell 1.

/*それでも大統領への手がかりはエイムズ
だけだ。接触してみるしかない。
シェル１中央棟のＢ１に向かうんだ。
*/
//dv}//v
}//d

//核について h //e
resource PC_核について__s {
//vox t:vc266021 {
ライデン_000: {
Coronel, esas historias que dicen que
Metal Gear est&'a dentro del Big Shell...
}
//	<<<ENGLISH>>>
//	Colonel -- the stories about
//	a Metal Gear within the Big
//	Shell...

/*大佐、この『ビッグ・シェル』に
