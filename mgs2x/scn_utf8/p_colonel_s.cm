}//d

//タンカー事件について。 h //e
resource PC_タンカー事件について１__s {
//vox t:vc265621 {
大佐_000: {
Ese accidente que ocurri&'o aqu&'i hace
dos a&~nos, el tanque se hundi&'o y...
}
//	<<<ENGLISH>>>
//	That tanker accident that happened
//	over there two years ago; the tanker
//	sank and...

/*二年前、そこで起こったタンカー沈没
