}//d
//スコープ t //e
resource PC_ＤＧ連絡橋＿赤外線センサー＿ＰＳＧ１スコープ__s {
//vox t:vc263511 {
大佐_000: {
Los PSG1 est&'an equipados con un zoom.
}
//	<<<ENGLISH>>>
//	The PSG1's scope is equipped
//	with a zoom function.

/*ＰＳＧ１のスコープにはズーム機能が
