//しゃがんで流血回復ムービー t //e
resource PC_流血説明４__s {
//vox t:vc264711 {
大佐_000: {
Tambi&'en puedes agacharte o gatear y
quedarte quieto durante un rato.
}
//	<<<ENGLISH>>>
//	You can also go into a crouch
//	or crawl and stay completely
