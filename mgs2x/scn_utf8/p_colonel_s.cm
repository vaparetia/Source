}//d

//壊れ物壊すな h //e
resource PC_コワレモノ__s {
//vox t:vc265021 {
大佐_000: {
Raiden, la clave en las misiones de
infiltraci&'on es pasar desapercibido.
}
//	<<<ENGLISH>>>
//	Raiden, covertness is the keystone
//	of sneaking missions.
//<ページ数変更>
大佐_000_1: {
No dejes ning&'un rastro de tu presencia,
deja todo como lo has encontrado.
}
//	<<<ENGLISH>>>
//	It's unwise to leave any trace
//	of your presence, so I suggest
//	you leave those things intact.

/*ライデン、潜入任務の基本は隠密行動に
