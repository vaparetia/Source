//一回目のみ t //e
resource PC_ファットマン戦＿頭狙え２__s {
//vox t:vc263071 {
ローズ_000: {
&~?Un traje antiexplosivos?
}
//	<<<ENGLISH>>>
//	A blast suit?

/*ボムブラストスーツ？*/
ライデン_001: {
Es un traje protector para
la desactivaci&'on de bombas.
}
//	<<<ENGLISH>>>
