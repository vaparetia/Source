大佐_000: {
Kawanishi-Noseguchi, Kinunobebashi,
Takiyama, Uguisunomori,
}//<ページ数変更>
大佐_000_1: {
Tsuzumigataki, Tada, Hirano,
Ichinotorii, Uneno, Yamashita,
}//<ページ数変更>
大佐_000_2: {
Sasabe, Kofudai, Tokiwadai,
Myoukenguchi.
}
/*川西能勢口、絹延橋、滝山、鴬の森、
皷滝、多田、平野、一の鳥居、畦野、
山下、笹部、光風台、ときわ台、妙見口。
*/
//dv}//v
}//d


//デフォルト操作説明系 d //e

//プラント外部でリモコン装備時 h //e
resource PC_リモコンミサイル使えない１__s {
//vox t:vc266261 {
大佐_000: {
Raiden, en las partes exteriores
del Big Shell no podr&'as usar los
misiles por control remoto.
}
/*ライデン、リモコンミサイルは
『ビッグ・シェル』内部でしか
使えないぞ。
Raiden, remote-controlled missiles
cannot be used outside the Big Shell.
*/
//dv}//v
}//d
//一回目のみ t //e
resource PC_リモコンミサイル使えない２__s {
//vox t:vc266271 {
ライデン_000: {
&~?Por qu&'e?
}
//	<<<ENGLISH>>>
//	Why?

/*なぜだ？*/
大佐_001: {
Porque hay interferencias. Hay
interferencias electr&'onicas que
rodean al Big Shell.
}
//	<<<ENGLISH>>>
//	The signal will be scrambled.
//	There's electronic interference
//	surrounding the Big Shell.

/*妨害電波だ。『ビッグ・シェル』
周辺一帯に電子妨害がかけられている。
*/
ライデン_002: {
&~?Obra de los terroristas?
}
//	<<<ENGLISH>>>
//	Done by the terrorists?

/*テロリスト達が？*/
大佐_003: {
Igual. Para prevenir cualquier UAV
u otro tipo de investigaci&'on.
}
//	<<<ENGLISH>>>
//	Perhaps. Probably to prevent
//	any UAV or other searches by us.

/*おそらくな。我々がＵＡＶ等で偵察を
行うのを阻止するつもりなのだろう。
*/
ライデン_004: {
Pero ellos tambi&'en utilizan Radios
y Cyphers, &~?no?
}
//	<<<ENGLISH>>>
//	But they use radios and
//	Cyphers too, right?

/*しかし奴等も無線やサイファーを
使っている？
*/
大佐_005: {
Por supuesto. Pero no lo han programado
para que haga interferencias con los
diferentes canales que ellos utilizan.
}
//	<<<ENGLISH>>>
//	Of course. They wouldn't set it
//	up to interfere with the several
//	channels that they are using.
//<ページ数変更>
大佐_005_1: {
S&'olo afectan a tus misiles
por control remoto.
}
//	<<<ENGLISH>>>
//	The only thing affected is your
//	remote-controlled missile.

/*当然だ。自分達で使用する周波数帯に
まで妨害をかけるわけがない。影響を
受けるのは君のリモコンミサイルだけだ。
*/
大佐_006: {
Pero por suerte, las interferencias
no son muy fuertes.
}
//	<<<ENGLISH>>>
//	Fortunately the interference
//	isn't too strong.

/*だが幸いなことに妨害電波はそれほど
強くない。
*/
大佐_007: {
As&'i que cuando est&'es dentro del Big
Shell podr&'as utilizar los misiles por
control remoto.
}
//	<<<ENGLISH>>>
//	While inside the Big Shell you
//	should have no problem using
//	a remote-controlled missile.

/*『ビッグ・シェル』内部なら問題なく
リモコンミサイルも使えるはずだ。
*/
//dv}//v
}//d

