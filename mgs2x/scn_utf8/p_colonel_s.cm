○ボタンか×ボタンを押せばいい。
*/
//dv}//v
}//d
resource PC_水中＿水面＿潜航２__s {
//vox t:vc260141 {
大佐_000: {
Pulsa el bot&'on Pu&~netazo
para sumergirte en el agua.
}
//	<<<ENGLISH(2)>>>
