en Visi&'on Primera Persona.
}
//	<<<ENGLISH>>>
//	Use the First Person
//	View to aim carefully.

/*頭や心臓に当てれば即座に昏倒させる
ことが出来る。主観攻撃でよく狙うんだ。
*/
//dv}//v
}//d

//部位ダメージ h //e
resource PC_部位ダメージ__s {
//vox t:vc264931 {
大佐_000: {
Dependiendo del lugar
en el que den las balas,
el efecto de las pistolas
}
//	<<<ENGLISH>>>
