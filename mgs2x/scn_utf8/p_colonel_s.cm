//	doing there, with that?

/*ライデン、そんなところで……
そんなものを持って……。
*/
ローズ_001: {
&~!No me lo puedo creer! &~?En qu&'e
est&'as pensando? &~?&~!Mientras est&'as
trabajando!?
}
//	<<<ENGLISH>>>
//	I don't believe it! What are
//	you thinking? And during
//	your duties!?

/*ホントに信じられない！
何考えてるの！？
任務中でしょ！！
*/
大佐_002: {
Lo desapruebo totalmente.
}
//	<<<ENGLISH(2)>>>
//	I highly disapprove.

/*度し難いな……。*/
ローズ_003: {
&~?&~!Todos nosotros haciendo todo
lo posible para ayudarte, y t&'u...!?
}
//	<<<ENGLISH>>>
//	Even though everyone of us
//	is scrambling to do our best
//	to support you... this!?

/*みんなあなたのことサポートしようって
必死にがんばってるのに！
*/
ローズ_004: {
&~?Y qu&'e vas a hacer exactamente?
&~?Babear mirando las fotos de esas
mujeres?
}
//	<<<ENGLISH>>>
//	And what exactly are you going
//	to do? Drool over pictures of
//	voluptuous girls?

/*当のあなたときたら何！？
そこで一体何するつもり！？
プリプリの女の子の写真握りしめて！！
*/
大佐_005: {
Exactamente...
}
//	<<<ENGLISH>>>
//	Exactly...


/*その通り……。*/
ローズ_006: {
&~!Podr&'ias por lo menos
utilizar mi foto!
}
//	<<<ENGLISH>>>
//	At least use a picture
//	of me instead!

/*せめて私の写真にして！
*/
ライデン_007: {
&~?Qu&'e...?
}
//	<<<ENGLISH>>>
//	Wha...?


/*え？*/
ローズ_008: {
Quiero decir...
}
//	<<<ENGLISH(2)>>>
//	I mean...

/*あ……。*/
大佐_009: {
... Estoy totalmente en contra...
}
//	<<<ENGLISH>>>
//	...I completely disapprove...

/*……全く度し難い……。*/
//dv}//v
}//d


