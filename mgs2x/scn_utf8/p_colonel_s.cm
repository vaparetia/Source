}
//	<<<ENGLISH>>>
//	Raiden, you can climb onto anything
//	up to about waist-high with the
//	Action button.
//<ページ数変更>
大佐_000_1: {
Te ser&'a muy &'util.
}
//	<<<ENGLISH>>>
//	It should come in useful.

/*ライデン、腰くらいの高さのものは
△ボタンを押せば上に登ることが
出来る。うまく使うんだ。
*/
//dv}//v
}//d

//エルード h //e
//＊ムービー t //e
resource PC_エルード１の１__s {
//vox t:vc260341 {
大佐_000: {
Si ves alguna barandilla que te llegue
a la altura de la cintura, pulsa el bot&'on
Acci&'on cuando est&'es cerca.
}
//	<<<ENGLISH>>>
//	If you see an approximately
//	waist-high railing, push the
//	Action button near it.
