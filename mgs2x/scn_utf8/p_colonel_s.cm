//★P034_01_P01ファットマン死亡１ポリゴンデモ１終了＜フラグ＜P035_01_R01ファットマン爆弾解体終了１無線デモ１開始 d //e
//ファットマン最後の爆弾 h //e
//一回目のみ t //e
resource PC_ファットマン戦後＿最終爆弾１__s {
//vox t:vc263161 {
ライデン_000: {
Coronel, &~?d&'onde est&'a esa bomba?
}
//	<<<ENGLISH>>>
//	Colonel, where's that bomb?

/*大佐、爆弾はどこにある？*/
大佐_001: {
No lo s&'e. Rastrea la zona.
}
//	<<<ENGLISH>>>
//	We have no information on that.
//	Sweep the area.

/*わからん、とにかく探すしかない。
*/
ローズ_002: {
&~!Date prisa Jack!
}
//	<<<ENGLISH(2)>>>
//	Hurry, Jack!

/*急いで、ジャック！*/
//dv}//v
}//d
resource PC_ファットマン戦後＿最終爆弾２__s {
//vox t:vc263171 {
大佐_000: {
La bomba est&'a en alg&'un lugar del
helipuerto. Haz todo lo que tengas
que hacer para encontrarla.
}
//	<<<ENGLISH>>>
//	The bomb has to be somewhere
//	on the heliport. Use whatever
//	means necessary to locate it.

/*爆弾は必ずヘリポートのどこかに
あるはずだ。なんとかして探し出すんだ。
*/
//dv}//v
}//d
//最終爆弾ヒント h //e
resource PC_ファットマン戦後＿最終爆弾ヒント１__s {
//vox t:vc263181 {
大佐_000: {
Raiden, &~?has encontrado ya la bomba?
}
//	<<<ENGLISH>>>
//	Raiden, have you located
//	the bomb yet?

/*ライデン、爆弾は見つかったか？
*/
ライデン_001: {
No, todav&'ia no...
}
//	<<<ENGLISH>>>
//	No, not yet...

/*いや、まだだ……。*/
ローズ_002: {
&~!Date prisa Jack!
&~!No nos queda mucho tiempo!
}
//	<<<ENGLISH>>>
//	Hurry, Jack! We don't
//	have a lot of time left!

/*急いで、ジャック！時間がないわ！
*/
//dv}//v
}//d
//最終爆弾ヒント h //e
resource PC_ファットマン戦後＿最終爆弾ヒント２__s {
//vox t:vc263191 {
大佐_000: {
No ha tenido tiempo de esconderla,
tiene que estar cerca de &'el.
}
//	<<<ENGLISH>>>
//	He wouldn't have had the time to
//	find a good hiding place; it must
//	be somewhere near him.
//<ページ数変更>
大佐_000_1: {
Echa un vistazo.
}
//	<<<ENGLISH>>>
//	Take a closer look.

/*凝った場所にしかける時間があったとは
思えん。おそらく奴の近くだ。
よく探してみるんだ。
*/
//dv}//v
}//d

//最終爆弾ズバリ h //e
resource PC_ファットマン戦後＿最終爆弾ズバリ__s {
//vox t:vc263201 {
大佐_000: {
&~?Raiden, la bomba?
}
//	<<<ENGLISH>>>
//	Raiden, the bomb?

/*ライデン、爆弾は？*/
ライデン_001: {
Todav&'ia nada...
}
//	<<<ENGLISH>>>
//	Nothing yet...

/*まだだ……。*/
大佐_002: {
D&'onde est&'a esa maldita...
Ya queda muy poco tiempo.
}
//	<<<ENGLISH>>>
//	Where is that damned thing...
//	we're running out of time.

/*一体どこに……もう時間がないぞ。
*/
ローズ_003: {
&~?Has mirado debajo del cuerpo
de Fatman?
}
//	<<<ENGLISH>>>
//	Have you checked under
//	Fatman's body?

/*ファットマンの体の下は？
*/
ライデン_004: {
&~?Qu&'e? Claro que no.
No puede estar ah&'i.
}
//	<<<ENGLISH>>>
//	What? Of course not.
//	It can't be there.

/*なんだって？
そんなわけないだろ。
*/
ローズ_005: {
Eso no lo sabes.
}
//	<<<ENGLISH>>>
//	You don't know that.

/*わからないじゃない。*/
ライデン_006: {
&~?Y c&'omo sabes t&'u que puede estar ah&'i?
}
//	<<<ENGLISH>>>
//	OK, what evidence do you
//	have that it's there?

/*根拠は？
*/
ローズ_007: {
Por intuici&'on, &~?vale?
}
//	<<<ENGLISH>>>
//	Just a hunch, all right?

/*ないけど。*/
ライデン_008: {
Mira Rose, s&'e lo que estoy haciendo,
y es mi vida la que est&'a en peligro.
}
//	<<<ENGLISH>>>
//	Look Rose -- I know what
//	I'm doing, and this is my
//	life on the line.
//<ページ数変更>
ライデン_008_1: {
T&'u no tienes experiencia en este
tipo de trabajo, as&'i que...
}
//	<<<ENGLISH>>>
//	You don't have any experience
//	in this type of work, so ju...

/*……ふぅ……ローズ……。
素人は黙っててくれ。
こっちは命がかかってるんだ。
*/
ローズ_009: {
...
}
/*……。*/
大佐_010: {
Raiden, no hagas caso omiso a una buena
sugerencia. Compru&'ebalo.
}
//	<<<ENGLISH>>>
//	Raiden, don't turn down a good
//	suggestion when you hear one.
//	Check it out.

/*ライデン、そう言わずに
とりあえず調べてみたらどうだ。
*/
//dv}//v
}//d


//★P035_01_R01ファットマン爆弾解体終了１無線デモ１終了＜フラグ＜P036_01_P01忍者登場１ポリゴンデモ１開始 d //e
//ヘリポートから下りろ h //e
resource PC_忍者登場前＿ヘリポート__s {
//vox t:vc263211 {
大佐_000: {
Raiden, vuelve a la mision
de rescatar al Presidente.
}
//	<<<ENGLISH>>>
//	Raiden, let's get back to the
//	task of rescuing the President.
//<ページ数変更>
大佐_000_1: {
Dir&'igete hacia el N&'ucleo
del Shell 1 e investiga la zona.
}
//	<<<ENGLISH>>>
//	Head to the core of Shell 1
//	and investigate the area.

/*ライデン、大統領救出任務に戻れ。
まだ調べていないシェル１中央棟に
向かうんだ。
*/
//dv}//v
}//d

//ローズに爆弾位置を教えてもらった場合 h //e
resource PC_忍者登場前＿ローズ助けられ__s {
//vox t:vc263221 {
ローズ_000: {
&~?Jack?
}
//	<<<ENGLISH(2)>>>
//	Jack?

/*ジャック？*/
ライデン_001: {
&~?Eh? &~?Qu&'e?
}
//	<<<ENGLISH>>>
//	-- what?

/*……なんだ？*/
ローズ_002: {
Sabes a lo que me refiero.
}
//	<<<ENGLISH>>>
//	You know what I'm talking about.

/*またとぼけて。*/
ライデン_003: {
Vale, vale. Ten&'ias raz&'on, la bomba estaba
donde t&'u dijiste. &~!Me has salvado la vida!
}
//	<<<ENGLISH>>>
//	All right, all right. The bomb was
//	where you guessed it would be. You
//	were right, and you saved my butt!

/*……わかったよ。確かに爆弾は君の
言った場所に仕掛けてあった。君が
正しかった。君のおかげで助かった！
*/
ローズ_004: {
Siempre y cuando seas consciente de ello.
}
//	<<<ENGLISH>>>
//	As long as you realize that.

/*わかればよろしい。*/
ライデン_005: {
La verdad es que me sorprendi&'o bastante.
Nunca pens&'e que la iba encontrar all&'i...
}
//	<<<ENGLISH>>>
//	I was pretty surprised though.
//	I never expected to find it
//	where I did...

/*しかし意外だったよ。
本当に君の言った通りだったとは……。
*/
ローズ_006: {
Mm, &~?piensas que no tengo ni idea, eh?
}
//	<<<ENGLISH>>>
//	Hm, you must think I'm
//	pretty clueless, huh?

/*ふーん。
それ、私は役に立たないって思って
たってこと？
*/
ライデン_007: {
&~!Claro que no! Y adem&'as, he aprendido a
valorar la intuici&'on femenina.
}
//	<<<ENGLISH>>>
//	Of course not! And I have
//	a pretty healthy respect for
//	the woman's intuition thing now.

/*いや、そういうわけじゃないが。
女の勘って奴はあなどれないな、と。
*/
ローズ_008: {
Eso es de lo m&'as machista, &~?sabes?
}
//	<<<ENGLISH>>>
//	That is such a sexist thing
//	to say, you know that?

/*その言い方、何か女性差別的。
*/
ライデン_009: {
Venga, no te enfades.
Ya te he pedido perd&'on.
}
//	<<<ENGLISH>>>
//	Come on, don't be mad.
//	I apologized already.

/*いちいち突っかからないでくれ。
あやまったじゃないか……。
*/
ローズ_010: {
No te preocupes, te estoy tomando el pelo.
}
//	<<<ENGLISH>>>
//	Don't sweat it -- I'm
//	just messing with ya.

/*ふふ。うそ。冗談よ。
気にしないで。
*/
ローズ_011: {
Quiero que te des cuenta de que te puedo
ayudar y de que me preocupo por ti.
}
//	<<<ENGLISH>>>
//	I want you to recognize that I can
//	help you through this thing -- and
//	that I care about you.

/*……私もあなたの役に立つって……
あなたのこと本当に心配してるって
認めてもらいたかっただけ……。
*/
ライデン_012: {
Rose...
}
//	<<<ENGLISH(2)>>>
//	Rose...

/*ローズ……。*/
ローズ_013: {
&~?No te des por vencido, eh?
}
//	<<<ENGLISH>>>
//	Hang in there, okay?

/*がんばってね。*/
//dv}//v
}//d

//★P036_13_R04忍者登場１３無線デモ４終了＜フラグ＜P037_01_R01スネークの遺体１無線デモ１開始 d //e
