}
//	<<<ENGLISH>>>
//	Lieutenant J.G. Pliskin would know
//	this kind of thing, wouldn't he?

/*プリスキン中尉ならどこにあるか
知ってるんじゃないかしら？
*/
//dv}//v
}//d
