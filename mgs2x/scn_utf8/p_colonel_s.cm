//オセロットはなぜ大統領を殺したのか？ h //e
resource PC_大統領後＿なぜ大統領を殺したのか__s {
//vox t:vc266211 {
ライデン_000: {
Coronel, &~?por qu&'e mat&'o
Ocelot al Presidente?
}
//	<<<ENGLISH>>>
//	Colonel, why did Ocelot
//	murder the President?

/*大佐、なぜオセロットは大統領を
殺したんだろう？
*/
大佐_001: {
Porque no estar&'ian de acuerdo.
}
//	<<<ENGLISH>>>
//	They disagreed, probably.

/*仲間割れじゃないか？*/
ライデン_002: {
... justo lo mismo.
}
//	<<<ENGLISH>>>
//	...Exactly the same.

/*……似てないか？*/
大佐_003: {
&~?Qu&'e?
}
//	<<<ENGLISH(2)>>>
//	What?

/*何だって？*/
ライデン_004: {
Como en el incidente de Shadow Moses.
}
//	<<<ENGLISH>>>
//	As the Shadow Moses incident.

/*シャドーモセス事件とだ。*/
大佐_005: {
No seas tonto.
}
//	<<<ENGLISH>>>
//	Don't be foolish.

/*馬鹿な……。*/
ライデン_006: {
&~?Est&'as seguro de eso? La muerte
de Ames, la presencia del Ninja,
}
//	<<<ENGLISH>>>
//	Are you sure about that?
//	Ames' death, appearance
//	of the Ninja,
//<ページ数変更>
ライデン_006_1: {
la muerte del Presidente
y ahora ese virus...
}
//	<<<ENGLISH>>>
//	the President's death,
//	and now the virus...

/*そう言い切れるか？
エイムズの死、忍者の出現、大統領の死、
そしてウィルス……。
*/
大佐_007: {
Est&'as sacando conclusiones err&'oneas.
}
//	<<<ENGLISH>>>
//	You're reading too
//	much into things.

/*考え過ぎだ。
*/
ローズ_008: {
S&'i, Jack, est&'as muy cansado.
}
//	<<<ENGLISH>>>
//	That's right, Jack,
//	you're tired.

/*そうよ、ジャック。
あなたは疲れてるの。
*/
ライデン_009: {
...
}
/*……。*/
大佐_010: {
Raiden, no pierdas el tiempo pensando
en cosas in&'utiles.
}
//	<<<ENGLISH>>>
//	Raiden, don't waste your time
//	thinking unnecessary thoughts.
//<ページ数変更>
大佐_010_1: {
Es mejor que te concentres en llevar
a cabo tus obligaciones.
}
//	<<<ENGLISH>>>
//	Invest all your energy instead
//	in carrying out your duties.

/*ライデン、余計なことは考えるな。
任務を遂行することに全力を注ぐんだ。
いいな。
*/
//dv}//v
}//d


//タンカー編整理後 d //e
//スネークのこと h //e
resource PC_大統領後＿スネーク__s {
//vox t:vc266221 {
ライデン_000: {
Coronel, &~?has o&'ido la verdad
sobre el incidente de Shadow Moses?
}
//	<<<ENGLISH>>>
//	Colonel, did you hear the truth
//	about the Shadow Moses incident?

/*大佐、聞いたか、シャドーモセスの
真実を？
*/
大佐_001: {
&~?Eh? S&'i...
}
//	<<<ENGLISH(2)>>>
//	Yeah.

/*ああ。*/
ライデン_002: {
Snake no era un terrorista.
}
//	<<<ENGLISH>>>
//	Snake wasn't a terrorist.

/*スネークはテロリストではなかった。*/
ローズ_003: {
Pareces entusiasmado.
}
//	<<<ENGLISH>>>
//	You look thrilled.

/*うれしそうね？*/
ライデン_004: {
&~?Eh? S&'i...
}
//	<<<ENGLISH>>>
//	Huh? Yeah...

/*ん？ああ……。*/
大佐_005: {
&~?As&'i que te crees todo
lo que te ha dicho?
}
//	<<<ENGLISH>>>
//	So you just believe everything
//	that he told you then?

/*それで君はあの男の言ったことを
そのまま信じているのか？
*/
ライデン_006: {
&~?Qu&'e has dicho?
}
//	<<<ENGLISH>>>
//	What did you say?

/*なんだって？*/
大佐_007: {
No conf&'ies en &'el.
No forma parte de la simulaci&'on.
}
//	<<<ENGLISH>>>
//	Don't trust him.
//	He isn't in the simulation.

/*奴を信用するな。
奴はシミュレーションには入っていない。
*/
ライデン_008: {
&~?Otra vez la simulaci&'on?
&~?De qu&'e est&'as hablando exactamente?
}
//	<<<ENGLISH>>>
//	Simulation again?
//	What exactly are
//	you talking about?

/*またシミュレーションか？
一体どういうことなんだ？
*/
大佐_009: {
No conf&'ies en &'el. Lleva a cabo tus
obligaciones lo mejor que puedas. &~?Lo
entiendes Raiden?
}
//	<<<ENGLISH>>>
//	Don't put your trust in him. Just carry
//	out your duties to the best of your
//	abilities. Do you understand, Raiden?

/*奴を頼るな。君の力で任務を
遂行するんだ。いいな。ライデン。
*/
//dv}//v
}//d

