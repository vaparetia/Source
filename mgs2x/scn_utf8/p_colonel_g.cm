Ich meine --
}
//	<<<ENGLISH(2)>>>
//	I mean...

/*あ……。*/
大佐_009: {
-- gar nicht guthei&~sen.
}
//	<<<ENGLISH>>>
//	...I completely disapprove...

/*……全く度し難い……。*/
//dv}//v
}//d


