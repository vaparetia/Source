*/
//dv}//v
}//d

//天狗通路Ａ d //e
//量産型ＲＡＹについて h //e
resource PC_天狗通路Ａ＿メタル１__g {
//vox t:vc262421 {
ライデン_000: {
Oberst, ist das -- ?
}
//	<<<ENGLISH>>>
//	Colonel, is this -- ?

/*大佐、ここにあるのが……。*/
大佐_001: {
Genau, der ber&~uhmte Metal Gear,
in Serie hergestellt.
}
//	<<<ENGLISH>>>
//	Right, the famous mass-production
//	Metal Gear.
//<ページ数変更>
大佐_001_1: {
Der gesamte Abschnitt scheint eine
Wartungsstra&~se f&~ur Metal Gears zu
beherbergen.
}
//	<<<ENGLISH>>>
//	That entire section seems to
//	house a maintenance line for
//	Metal Gears.

/*ああ。例の量産型メタルギアだろう。
そこはメタルギアの整備ラインに
なっているらしいな。
*/
ローズ_002: {
Jack.
}
//	<<<ENGLISH>>>
//	Jack...

/*ジャック……。*/
ライデン_003: {
Mir geht es gut.
}
//	<<<ENGLISH>>>
//	...I'm all right.

/*……ああ、大丈夫だ。*/
//dv}//v
}//d
resource PC_天狗通路Ａ＿メタル２__g {
//vox t:vc262431 {
大佐_000: {
Diese in Serie hergestellten Metal Gears
werden derzeit eingestellt. Sie stellen
keine Bedrohung dar.
}
//	<<<ENGLISH>>>
//	Those mass-production Metal Gears
//	are in adjustment phase. They're
//	not a threat.

/*その量産型メタルギアは整備中だ。
動き出す心配はないだろう。
*/
大佐_001: {
Aber es ist durchaus m&~oglich, da&~s
irgendwo vor Dir ein einsatzf&~ahiger
Metal Gear steht. Pa&~s auf.
}
//	<<<ENGLISH>>>
//	But it's entirely possible that
//	there's an operational Metal Gear
//	somewhere ahead. Stay focused.

/*だがその先に稼動しているメタルギアが
いないとは限らん。注意するんだ。
*/
//dv}//v
}//d



