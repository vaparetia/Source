//ＭＧＳの台詞をしゃべる３ h //e
resource PC_発狂＿ＭＧＳ３__g {
//vox t:vc266571 {
大佐_000: {
Snake, sie haben beide Detonationscodes
eingegeben.
}
//	<<<ENGLISH>>>
//	Snake, they've input
