resource PC_発狂＿ムービー__g {
//vox t:vc264661 {
大佐_000: {
Raiden, es gibt &~Arger! Schau mal,
was da im Fernsehen l&~auft.
}
//	<<<ENGLISH>>>
//	Raiden, we're in trouble!
//	Look at what's on TV!

/*ライデン、大変だっ！
ＴＶに切り替えてみろ！
*/
//dv}//v
}//d


//★P073_05_S01通路Ａ５シナリオデモ１終了＜フラグ＜P074_01_P01通路Ａ刀後１ポリゴンデモ１開始 d //e
