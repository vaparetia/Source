//dv}//v
}//d


//女子便所 h //e
//ピーター遭遇前 h //e
resource PC_Ｃ脚女子トイレピーター前__g {
//vox t:vc265321 {
ローズ_000: {
Das darf doch wohl nicht wahr sein, Jack.
Wei&~st Du, wo Du da bist?
}
//	<<<ENGLISH>>>
//	I can't believe you, Jack.
//	Do you know what that
//	place is?

/*信じられない。
ジャック、そこがどこだかわかってるの？
*/
ライデン_001: {
&~Ah, ich dachte ja nur, der Lehrmeister f&~ur
Sprengstoffr&~aumung k&~onnte vielleicht hier
sein.
}
//	<<<ENGLISH>>>
//	Err, I just thought maybe
//	the bomb disposal instructor
//	might be in there...

/*いや、爆弾処理の教官がいるかと……。
*/
ローズ_002: {
Warum sollte er sich dort aufhalten?
}
//	<<<ENGLISH>>>
//	Why would he be in there?

/*いるわけないでしょ。*/
ライデン_003: {
Wer wei&~s. Er hat sich von seiner Truppe
entfernt und --
}
//	<<<ENGLISH>>>
//	You never know.
//	He's AWOL, and...

/*わからないじゃないか。
異常事態なんだし……。
*/
ローズ_004: {
Auch wenn er sich unerlaubt entfernt hat,
w&~urde ein normaler Mann nicht in eine
Damentoilette gehen.
}
//	<<<ENGLISH>>>
//	Even AWOL, a normal guy
//	wouldn't go into a woman's
//	bathroom!
//<ページ数変更>
ローズ_004_1: {
Nur Du bringst das fertig!
}
//	<<<ENGLISH>>>
//	You're the only one
//	I know who would!

/*異常事態でも普通の男の人は
女性用トイレになんか入りません！
そんなのあなただけ！
*/
ローズ_005: {
Du benimmst Dich -- &~ah -- sehr
merkw&~urdig!
}
//	<<<ENGLISH>>>
//	You're, like, really strange!

/*っていうか、あなたが異常！！*/
大佐_006: {
Rosemary, beruhige Dich.
}
//	<<<ENGLISH>>>
//	Rosemary, settle down.

/*ローズ君、落ち着いてくれ。*/
ローズ_007: {
Aber --
}
//	<<<ENGLISH>>>
//	But...

/*ですが……。*/
大佐_008: {
Schon gut, Raiden. Rosemary hat Recht.
Such lieber woanders.
}
//	<<<ENGLISH>>>
//	It's all right. Raiden, Rosemary
//	is right. You should probably
