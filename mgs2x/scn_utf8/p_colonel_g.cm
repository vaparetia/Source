resource PC_シェル２中央棟１Ｆ＿ダクト__g {
//vox t:vc262201 {
大佐_000: {
Raiden, das Rohr f&~uhrt zu dem Raum, in
dem der Pr&~asident gefangengehalten wird.
}
//	<<<ENGLISH>>>
//	Raiden, that duct leads into the
