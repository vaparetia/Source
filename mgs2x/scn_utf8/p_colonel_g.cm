resource PC_サイファー回避＿破壊１__g {
//vox t:vc261081 {
大佐_000: {
Zerst&~or die Kamera am Cypher, dann
kannst Du den ganzen Cypher erledigen.
}
//	<<<ENGLISH>>>
//	Cyphers can be taken out
//	by destroying its camera.

/*サイファーはカメラ部分を破壊すれば
撃墜することが出来る。
*/
//dv}//v
}//d

resource PC_サイファー回避＿破壊２__g {
//vox t:vc261091 {
大佐_000: {
Aber feindliche Soldaten k&~onnten die
Signalunterbrechung untersuchen.
}
//	<<<ENGLISH>>>
//	However, enemy personnel may
//	come and investigate the signal
//	termination.
//<ページ数変更>
大佐_000_1: {
Zerst&~orung ist nicht das cleverste
Verfahren.
}
//	<<<ENGLISH>>>
//	Destruction is not the soundest
//	method to use.

/*だがサイファーからの連絡が途絶えると
敵が確認にやってくるかもしれない。
あまり得策ではないだろうな。
*/
//dv}//v
}//d

//エルード回避 h //e
resource PC_サイファー回避＿エルード１__g {
//vox t:vc261101 {
大佐_000: {
Raiden, Du mu&~st au&~serhalb des
Cypher-Sichtfeldes bleiben. Du kannst
es Dir nicht leisten erwischt zu werden.
}
//	<<<ENGLISH>>>
//	Raiden, you need to stay out of
//	the Cypher's field of vision. You
//	can't afford to be apprehended.

/*ライデン、サイファーに発見されると
まずい。サイファーの視界に入らない
ように隠れるんだ。
*/
ライデン_001: {
Aber Oberst, hier kann man sich nirgends
verstecken.
}
//	<<<ENGLISH>>>
//	But Colonel, there's
//	nowhere to hide...

/*しかし大佐、ここには隠れられる場所が
無い……。
*/
ローズ_002: {
Jack, rei&~s Dich zusammen.
}
//	<<<ENGLISH>>>
//	Jack, snap out of it.

/*ジャック、弱気にならないで。*/
//dv}//v
}//d
