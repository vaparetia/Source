Kawanishi-Noseguchi, Kinunobebashi,
Takiyama, Uguisunomori,
}
//	<<<ENGLISH>>>
//	Kawanishi-Noseguchi, Kinunobebashi,
//	Takiyama, Uguisunomori,
//<ページ数変更>
大佐_000_1: {
Tsuzumigataki, Tada, Hirano, Ichinotorii,
Uneno, Yamashita,
}
//	<<<ENGLISH>>>
//	Tsuzumigataki, Tada, Hirano,
//	Ichinotorii, Uneno, Yamashita,
//<ページ数変更>
大佐_000_2: {
Sasabe, Kofudai, Tokiwadai, Myoukenguchi.
}
//	<<<ENGLISH>>>
//	Sasabe, Kofudai, Tokiwadai,
//	Myoukenguchi.

/*川西能勢口、絹延橋、滝山、鴬の森、
皷滝、多田、平野、一の鳥居、畦野、
