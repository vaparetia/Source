}
//	<<<ENGLISH>>>
//	Guide a remote-controlled missile
//	through the duct and destroy the
//	power source in the room.

/*ダクトからリモコンミサイルを
侵入させて部屋の中の
電源パネルを破壊するんだ。
*/
//dv}//v
}//d
//リモコン入手後 １Ｆ以外 h //e
resource PC_リモコンミサイル＿入手後__g {
//vox t:vc263921 {
大佐_000: {
Du hast die Lenkrakete. Gut gemacht.
Jetzt gehe zur ersten Etage im
