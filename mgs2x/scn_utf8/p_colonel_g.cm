//ツーハンを朗読 h //e
resource PC_発狂＿ツーハン__g {
//vox t:vc266711 {
大佐_000: {
Computerunterhaltungsprogramm
"Idea Spy 2.5 (Zwei-Komma-F&~unf)"
Episode 1
}
//	<<<ENGLISH>>>
//	Communicator Entertainment Program
//	Idea Spy 2.5 (Two-point-five)
//	Episode 1

/*連続通信機ドラマ
「アイデアスパイ２．５」
第１回
*/
大佐_001: {
New York. Hier in der Stadt, in der Tr&~aume
wahr werden und sich alles an W&~unschen
orientiert,
}
//	<<<ENGLISH>>>
//	New York. Here in the city where
//	dreams come true and desires
//	rule, something is being bought,
//<ページ数変更>
大佐_001_1: {
wird in jeder Sekunde etwas gekauft,
verkauft und weggeworfen.
}
//	<<<ENGLISH>>>
//	sold and thrown away,
//	even as we speak.

/*ニューヨーク。人々の欲望渦巻くこの
大都会では、今日も誰かが何かを買い、
売り、そして捨て、平和に暮らしている。
*/
大佐_002: {
Doch hinter den Szenen l&~auft
alles wie gewohnt.
}
//	<<<ENGLISH>>>
//	But behind the scenes
//	of business as usual,
//<ページ数変更>
大佐_002_1: {
Die ruchlose "J.E. (Junker Expensive)
Corporation" f&~uttert ihre ohnehin prallen
Koffer
}
//	<<<ENGLISH>>>
//	the nefarious J.E. (Junker Expensive)
//	Corporation lines its already bloated
//	coffers＃－
//<ページ数変更>
大佐_002_2: {
mit Gewinnen aus wertlosen Produkten.
}
//	<<<ENGLISH>>>
//	with profits from
//	worthless products.

/*だが、そんな平和の裏側で、粗悪な
商品を売りつけ私腹を肥やす悪の組織
『Ｊ・Ｅ社』が暗躍していた。
*/
大佐_003: {
J.E. verleitet einen weiteren Unschuldigen
zum Kauf von &~uberteuertem M&~ull.
}
//	<<<ENGLISH>>>
//	As J.E. swindles yet another innocent
//	into purchasing high-priced junk...

/*汚れなき市民を巧みに欺き、ガラクタを
高値で売りつける『Ｊ・Ｅ』の野望を
打ち砕くべく
*/
大佐_004: {
w&~ahrend das FBI eine streng geheime
Arbeitsgruppe damit beauftragt, dieser
Bedrohung ein Ende zu machen.
}
//	<<<ENGLISH>>>
//	...the FBI mobilizes a top-secret task
//	force to put a stop to the menace.

/*ＦＢＩは極秘に対抗チームを結成。
*/
大佐_005: {
Der beste Spion der Stadt ist
jetzt dort drau&~sen,
}
//	<<<ENGLISH>>>
//	Now, the city's best-kept
//	secret spy is out there,
//<ページ数変更>
大佐_005_1: {
eingewiesen und bereit, die Menschen vor
"J.E.", dem Katalog der Verschw&~orungen,
zu sch&~utzen.
}
//	<<<ENGLISH>>>
//	briefed and ready to protect the
//	people from J.E., the catalogue
//	of conspiracy --
//<ページ数変更>
大佐_005_2: {
Rufen Sie ihn an unter "2.5
Zwei-Komma-F&~unf".
}
//	<<<ENGLISH>>>
//	just call him 2.5 (Two-point-five).

/*悪の通信販売会社『Ｊ・Ｅ』から市民を
守るべく誕生した極秘スパイ、その名も
『２．５（ツー・ハン）』
*/
//dv}//v
}//d
