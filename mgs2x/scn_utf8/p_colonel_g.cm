*/
//dv}//v
}//d
//＊ムービー t //e
resource PC_主観攻撃＿左右ステップ１__g {
//vox t:vc264891 {
大佐_000: {
Dr&~uck die L2-Taste/R2-Taste, um
selbst bei einem Angriff aus der
Beobachtungsperspektive nach links
und rechts anzugreifen.
}
//	<<<ENGLISH>>>
//	You can strafe left and right even
//	during a First Person View attack
//	by pushing the L2 or R2 buttons.
//<ページ数変更>
