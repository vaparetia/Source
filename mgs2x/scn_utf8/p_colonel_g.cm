}
//	<<<ENGLISH>>>
//	you should be able to reach
//	the spot right above the pipe.

/*残った支柱をエルードで渡っていけば、
その上までいけそうじゃない？
*/
//dv}//v
}//d

resource PC_ＤＧ連絡橋＿渡り方エルードズバリ２__g {
//vox t:vc261971 {
大佐_000: {
Hangel Dich bis zu der Stelle &~uber dem
