Dead Cell?
}
//	<<<ENGLISH>>>
//	Dead Cell!?

/*デッドセルか！？*/
大佐_003: {
Das ist nicht best&~atigt.
Aber wahrscheinlich.
}
//	<<<ENGLISH>>>
//	No confirmation of that.
//	But probably...

/*わからん。だがおそらくは……。
*/
ローズ_004: {
Jack -- !
}
//	<<<ENGLISH(2)>>>
//	Jack -- !

/*ジャック……。*/
ライデン_005: {
Ich --
}
//	<<<ENGLISH(2)>>>
//	I...

/*ああ……。*/
大佐_006: {
Dies ist nicht der richtige Zeitpunkt,
um zu z&~ogern. Raiden, geh!
}
//	<<<ENGLISH>>>
//	This is not time to hesitate.
//	Raiden, go!

/*迷っている暇はない。
急ぐんだ、ライデン！
*/
//dv}//v
}//d


