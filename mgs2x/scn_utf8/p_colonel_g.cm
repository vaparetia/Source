//	Take out the power source and make
//	contact with the President before the
//	launch code can be reconfirmed.
//<ページ数変更>
大佐_001_1: {
Beeil' Dich!
}
//	<<<ENGLISH>>>
//	Hurry!

/*電源パネルを破壊して大統領と
接触するんだ。核発射コードの
