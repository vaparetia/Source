}//d


//赤外線センサー h //e
resource PC_ＥＦ連絡橋＿赤外線センサー１__g {
//vox t:vc261261 {
大佐_000: {
Pa&~s auf, Raiden. An dieser Stelle sind
IR-Sensorfallen.
}
//	<<<ENGLISH>>>
//	Watch out, Raiden. There are
//	IR sensor traps in that location.

/*ライデン、気をつけろ。
そこには赤外線センサーが
仕掛けられている。*/
//dv}//v
}//d
resource PC_ＥＦ連絡橋＿赤外線センサー＿触るな１__g {
//vox t:vc261271 {
ライデン_000: {
Infrarotsensoren?
}
//	<<<ENGLISH>>>
//	Infrared sensors?

/*赤外線センサー？*/
大佐_001: {
Genau. Eine Sprengfalle,
verbunden mit Plastiksprengstoff.
}
//	<<<ENGLISH>>>
//	Right. A booby trap connected
//	to plastic explosives.

/*そう。
プラスティック爆弾と連動した
トラップだ。
*/
//dv}//v
}//d
resource PC_ＥＦ連絡橋＿赤外線センサー＿触るな２__g {
//vox t:vc261281 {
大佐_000: {
Wenn Du durch einen IR-Strahl l&~aufst,
bringst Du eine gef&~ahrliche Menge Semtex
zur Explosion.
}
//	<<<ENGLISH>>>
//	Crossing an IR beam will trigger
//	the detonation of a critical
//	amount of Semtex.
//<ページ数変更>
大佐_000_1: {
Das w&~are Dein sicherer Tod. Vermeide
also unbedingt jeglichen Kontakt mit
diesen Strahlen.
}
//	<<<ENGLISH>>>
//	You will be killed, make no mistake
//	about it. Avoid contact with the
//	beams at all cost.

/*赤外線に触れれば大量のセムテックスが
爆発する。そうなれば命はないぞ。
赤外線には絶対に触れるな。
*/
//dv}//v
}//d

resource PC_ＥＦ連絡橋＿赤外線センサー＿制御装置破壊１__g {
//vox t:vc261291 {
大佐_000: {
Da sind zu viele Strahlen, als da&~s Du
unbemerkt am Sensor vorbeikommen
k&~onntest.
}
//	<<<ENGLISH>>>
//	There are too many beams in
//	place for you to get past the
//	sensor undetected.

/*だが赤外線に触れずにセンサーの間を
抜けることは出来ないだろうだろう。
赤外線の本数が多すぎる。
*/
ライデン_001: {
Was soll ich tun?
}
//	<<<ENGLISH>>>
//	What should I do?

/*どうすれば？*/
大佐_002: {
Du wirst den eigentlichen Sensor
deaktivieren m&~ussen.
}
//	<<<ENGLISH>>>
//	You'll have to take the
//	sensor itself offline.

/*センサー自体を無効にするしかないな。
*/
//dv}//v
}//d

resource PC_ＥＦ連絡橋＿赤外線センサー＿制御装置破壊__g {
//vox t:vc261301 {
大佐_000: {
Zerst&~ore das Steuerger&~at am Sensor.
}
//	<<<ENGLISH>>>
//	Take out the control unit
//	on the sensor.
//<ページ数変更>
大佐_000_1: {
Siehst Du ein Ger&~at mit gr&~un blinkender
Lampe neben dem Sprengstoff?
}
//	<<<ENGLISH>>>
//	You should be able to see a unit
//	with a blinking green light next
//	to the explosives.
//<ページ数変更>
大佐_000_2: {
Das ist das Steuerger&~at.
}
//	<<<ENGLISH>>>
//	That's the control unit.

/*センサーの制御装置を破壊するんだ。
爆弾の近くに緑色に点滅するランプの
ついた装置がある。それが制御装置だ。
*/
大佐_001: {
Wenn das Steuerger&~at zerst&~ort ist,
f&~allt der IR-Sensor aus.
}
//	<<<ENGLISH>>>
//	With the control unit destroyed,
//	the IR sensor will cease to function.
//<ページ数変更>
大佐_001_1: {
Schie&~se auf das Steuerger&~at.
}
//	<<<ENGLISH>>>
//	Shoot out the control unit.

/*制御装置を破壊すれば赤外線センサーは
機能を停止する。制御装置を銃で
撃ち抜くんだ。
*/
//dv}//v
}//d
resource PC_ＥＦ連絡橋＿赤外線センサー４__g {
//vox t:vc261311 {
大佐_000: {
Die Bet&~aubungspistole nutzt da nichts.
}
//	<<<ENGLISH>>>
//	The tranquilizer gun
//	won't do the job.

/*麻酔銃では破壊できんから気をつけろ。
*/
//dv}//v
}//d
resource PC_ＥＦ連絡橋＿赤外線センサー５__g {
//vox t:vc261321 {
大佐_000: {
Ber&~uhr auf keinen Fall das Semtex.
}
//	<<<ENGLISH>>>
//	Whatever you do, don't
//	touch the Semtex.
//<ページ数変更>
大佐_000_1: {
Geh davon aus, da&~s eine weitere
Z&~undkapsel angebracht ist, die auf
Ersch&~utterungen reagiert.
}
//	<<<ENGLISH>>>
//	Assume that there's another
//	detonator that responds to shock.

/*間違ってセムテックスを撃つなよ。
衝撃が加わると爆発する仕掛けが
されていると考えた方がいい。
*/
大佐_001: {
Schie&~se nur auf das Steuerger&~at
mit der gr&~unen Lampe.
}
//	<<<ENGLISH>>>
//	Take out only the control unit
//	with the green light.
//<ページ数変更>
大佐_001_1: {
Wechsle in die Beobachtungsperspektive
und ziele so genau du kannst.
}
//	<<<ENGLISH>>>
//	Go to First Person View and aim
//	with as much precision as you can.

/*緑色のランプがついた制御装置だけを
撃ち抜くんだ。主観攻撃でよく狙え。
*/
//dv}//v
}//d

//クリア条件 h //e
resource PC_ＥＦ連絡橋＿赤外線センサー＿クリア__g {
//vox t:vc261331 {
大佐_000: {
Sobald Du alle Steuerger&~ate ausgeschaltet
hast, verschwinden die IR-Strahlen.
}
//	<<<ENGLISH>>>
//	Once you take out every control
//	unit, the IR beams will disappear.

/*制御装置を全て機能停止させれば
赤外線は消える。
*/
大佐_001: {
Wenn immer noch ein durchgehender
IR-Strahl zu sehen ist, hast Du ein
Steuerger&~at noch nicht zerst&~ort.
}
//	<<<ENGLISH>>>
//	If you still see an intact beam,
//	that means you've left a control
//	unit untouched.

/*赤外線がまだ残っているとしたら、
破壊していない制御装置がどこかに
あるということだ。
*/
大佐_002: {
Zerst&~ore alle Steuerger&~ate.
}
//	<<<ENGLISH>>>
//	Take every control unit offline.

/*制御装置を全て破壊しろ。*/
//dv}//v
}//d
//工夫して撃て h //e
resource PC_ＥＦ連絡橋＿赤外線センサー＿工夫狙い__g {
//vox t:vc261341 {
大佐_000: {
Nicht alle Steuerger&~ate
sind sofort sichtbar.
}
//	<<<ENGLISH>>>
//	Not all control units are
//	in a highly visible spot.
//<ページ数変更>
大佐_000_1: {
Schau' Dich in der
Beobachtungsperspektive gut um.
}
//	<<<ENGLISH>>>
//	Use the First Person View
//	to take a good look.

/*制御装置は分かりやすい場所に
設置されているとは限らない。
主観でよく探すんだ。
*/
大佐_001: {
Dr&~ucke in der Beobachtungsperspektive
gleichzeitig die R2- und L2-Tasten, um
Dich auf die Zehenspitzen zu stellen.
}
//	<<<ENGLISH>>>
//	Push the R2 and L2 buttons
//	simultaneously in First Person
//	View to stretch up on your toes.

/*主観カメラ中にＲ２ボタンと
Ｌ２ボタンを同時に押せば背伸びが
出来る。
*/
大佐_002: {
Wenn Du die Kriechtaste dr&~uckst, kannst
Du Dich auch hinhocken und kriechen.
}
//	<<<ENGLISH>>>
//	You can also crouch down and
//	crawl by using the Crawl button.
//<ページ数変更>
大佐_002_1: {
Wechsle Deine Position und suche
gr&~undlich.
}
//	<<<ENGLISH>>>
//	Change your vantage point and
//	conduct a thorough search.

/*他にも×ボタンでしゃがんだり、
ホフクしたり、いろいろ視点を変えて
探してみろ。
*/
大佐_003: {
Geh geschickt vor, dann m&~u&~stest Du auch
Steuerger&~ate an unzug&~anglichen Stellen
ausschalten k&~onnen.
}
//	<<<ENGLISH>>>
//	Use your skills and you should be
//	able to deal with control units in
//	hard-to-reach spots.

/*狙いにくい場所にある制御装置も
工夫すれば必ず撃てるはずだ。
*/
//dv}//v
}//d
//赤外線見方 h //e
resource PC_ＥＦ連絡橋＿赤外線センサー＿たばこ__g {
//vox t:vc261351 {
大佐_000: {
Infrarot ist f&~ur das blo&~se Auge
normalerweise unsichtbar.
}
//	<<<ENGLISH>>>
//	Infrared is usually invisible
//	to the naked eye.
//<ページ数変更>
大佐_000_1: {
Es m&~u&~ste aber einen Weg geben,
die Strahlen sichtbar zu machen.
}
//	<<<ENGLISH>>>
//	There should, however, be
//	a way to make it visible.

/*赤外線は通常、肉眼で見ることは
出来ない。だが見えるようにする
方法はあるはずだ。
*/
ローズ_001: {
Experimentiere mit dem, was Du hast.
}
//	<<<ENGLISH>>>
//	You could experiment
//	with what you have.

/*装備品をいろいろ試してみたら？
*/
//dv}//v
}//d
//見方ズバリ h //e
resource PC_ＥＦ連絡橋＿赤外線センサー＿たばこズバリ__g {
//vox t:vc261361 {
大佐_000: {
Blase Zigarettenqualm an die Stelle,
an der Du IR-Strahlen vermutest.
}
//	<<<ENGLISH>>>
//	Blow some cigarette smoke on
//	the likely spot to see if there
//	are any IR beams.
//<ページ数変更>
大佐_000_1: {
W&~ahle die Zigaretten in der N&~ahe
eines IR-Sensors.
}
//	<<<ENGLISH>>>
//	Select the cigarettes
//	near an IR sensor.

/*煙草の煙を吹きかければどこに赤外線が
通っているかわかるはずだ。赤外線
センサーの近くで煙草を装備してみろ。
*/
//dv}//v
}//d


//うみどり h //e
resource PC_赤外線センサー＿海鳥１__g {
//vox t:vc261371 {
大佐_000: {
Raiden, achte auf die V&~ogel.
}
//	<<<ENGLISH>>>
//	Raiden, watch out for the birds.
//<ページ数変更>
大佐_000_1: {
Wenn ein Vogel durch einen IR-Strahl
fliegt, geht das Semtex hoch.
}
//	<<<ENGLISH>>>
//	If one of them manages to fly
//	through an IR beam, the Semtex
//	will detonate.

/*ライデン、海鳥に気をつけろ。
飛び立った海鳥が赤外線に触れても
セムテックスは爆発するぞ
*/
//dv}//v
}//d
resource PC_赤外線センサー＿海鳥２__g {
//vox t:vc261381 {
大佐_000: {
Erschrecke sie nicht. Unternimm etwas
wegen der V&~ogel, bevor Du dem Schwarm
zu nahe kommst.
}
//	<<<ENGLISH>>>
//	Don't startle them. Do something
//	about the birds before you get
//	close to the flock.

/*海鳥を驚かせないようにするんだ。。
近づく時はあらかじめ海鳥をなんとか
しておいた方がいい。
*/
//dv}//v
}//d
resource PC_赤外線センサー＿海鳥＿麻酔銃__g {
//vox t:vc261391 {
ローズ_000: {
Wie w&~are es, wenn Du sie mit der
Bet&~aubungspistole au&~ser Gefecht setzt?
}
//	<<<ENGLISH>>>
//	How about using the tranquilizer
//	gun to knock them out?

/*麻酔銃で眠ってもらったらどう？
*/
//dv}//v
}//d


//ガンサイファー h //e
resource PC_ガンサイファー１__g {
//vox t:vc261401 {
大佐_000: {
Da dr&~uben fliegt ein Gesch&~utz-Cypher.
}
//	<<<ENGLISH>>>
//	Raiden, there's a Gun Cypher
//	flying over there.
//<ページ数変更>
大佐_000_1: {
Das ist kein normales unbemanntes
Cypher-Flugger&~at. Die hier sind bemannt.
Pa&~s auf.
}
//	<<<ENGLISH>>>
//	Those aren't the normal Cypher
//	UAV's. These are armed. Watch
//	out.

/*ライデン、ガンサイファーが飛んでいる。
通常のサイファーとは違い、機銃を
装備した攻撃型のＵＡＶだ。気をつけろ。
*/
//dv}//v
}//d
resource PC_ガンサイファー＿チャフ__g {
//vox t:vc261411 {
大佐_000: {
Du kannst Gesch&~utz-Cypher
vor&~ubergehend lahmlegen:
}
//	<<<ENGLISH>>>
//	Gun Cyphers can be put out
//	of commission temporarily.
//<ページ数変更>
大佐_000_1: {
Mit dem D&~uppel setzt Du ihre
elektronischen Sensoren au&~ser Gefecht.
}
//	<<<ENGLISH>>>
//	Use the chaff to interfere with
//	their electronic sensors.

/*チャフを使って電子装置を撹乱すれば、
しばらくの間ガンサイファーの動きを
止めることが出来るはずだ。
*/
//dv}//v
}//d
resource PC_ガンサイファー＿撃墜__g {
//vox t:vc261421 {
大佐_000: {
Ziel in der Beobachtungsperspektive auf
das Gebl&~ase oder das Gesch&~utz, um die
Gesch&~utz-Cypher abzuschie&~sen.
}
//	<<<ENGLISH>>>
//	You can shoot Gun Cyphers down
//	if you target the fan section or its
//	gun. Aim in First Person View.

/*ガンサイファーを撃ち落とすには
