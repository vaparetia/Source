}
//	<<<ENGLISH>>>
//	Raiden, the sea lice are getting
//	fat on your rations.
//<ページ数変更>
大佐_000_1: {
Sch&~uttle das Ausr&~ustungsfenster,
um die Viecher loszuwerden.
}
//	<<<ENGLISH>>>
//	Shake the equipment window
//	to get rid of the bugs.

/*ライデン、レーションがフナムシに
食われているぞ。装備品ウィンドウを
揺すってフナムシを払い落とすんだ。
*/
//dv}//v
}//d


//開かない金網ドア h //e
resource PC_開かない金網ドア__g {
//vox t:vc260031 {
大佐_000: {
Raiden, die T&~ur l&~asst sich wohl nicht
