大佐_000: {
Nutze das RGB6 zu Deinem Vorteil.
}
//	<<<ENGLISH>>>
//	Use the RGB6 to your advantage.

/*ＲＧＢ６をうまく使うんだ。*/
//dv}//v
}//d
resource PC_ハリアー戦＿基本戦法下階__g {
//vox t:vc263721 {
大佐_000: {
Die untere Ebene bietet mehr Schutz.
}
//	<<<ENGLISH>>>
//	The lower level offers more cover.
//<ページ数変更>
大佐_000_1: {
Dort kannst Du den Harrier-Angriffen
leichter entkommen, kannst aber auch
nicht so gut zielen.
}
//	<<<ENGLISH>>>
//	It makes it easier to evade the
//	Harrier's attacks, but your own
//	aim will suffer as well.

/*下の階は障害物が多い。
