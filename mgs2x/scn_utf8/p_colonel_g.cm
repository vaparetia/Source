//dv}//v
}//d

//パイプ方面 h //e
resource PC_ＤＧ連絡橋＿渡り方エルードズバリ１__g {
//vox t:vc261961 {
大佐_000: {
Raiden, schau nach rechts unten.
}
//	<<<ENGLISH>>>
//	Raiden, look down and
//	to your right.
//<ページ数変更>
大佐_000_1: {
Da unten ist ein Rohr, mit dem
verunreinigtes Meerwasser umgew&~alzt
wird.
}
//	<<<ENGLISH>>>
//	There's a pipe down there
//	for circulating contaminated
//	seawater.

/*ライデン、右下の方を見てみろ。
