resource PC_海底ドック昇降機前ノード接続後２__g {
//vox t:vc260711 {
ライデン_000: {
Warten ist nicht gerade meine St&~arke.
}
//	<<<ENGLISH>>>
//	Waiting isn't my strong point.

/*待つのは苦手だ。*/
ローズ_001: {
Ich wei&~s -- das hast Du immer mir
&~uberlassen, nicht wahr?
}
