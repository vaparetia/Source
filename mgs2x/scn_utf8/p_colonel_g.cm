}//d


//ホールドアップ h //e
resource PC_ホールドアップ１__g {
//vox t:vc260961 {
大佐_000: {
Schleiche Dich unbemerkt an den Feind an
und ziele auf ihn, bevor er reagieren kann.
}
//	<<<ENGLISH>>>
//	Approach the enemy undetected
//	and train your gun on him before
//	he can react.
//<ページ数変更>
