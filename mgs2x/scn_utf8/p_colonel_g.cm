*/
ローズ_001: {
Wenn Du im Hangeln den verbliebenen
St&~utzen folgst,
}
//	<<<ENGLISH>>>
//	If you follow the remaining
//	supports while Hanging,
//<ページ数変更>
ローズ_001_1: {
m&~u&~stest Du die Stelle direkt &~uber dem
