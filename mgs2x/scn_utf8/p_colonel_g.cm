}
//	<<<ENGLISH>>>
//	They are pretty much what that
//	guy Pliskin described them as.

/*奴等については、大体あのプリスキンと
いう男が言った通りだ。
*/
ライデン_002: {
Eine vom ehemaligen Pr&~asidenten
aufgestellte Spezialeinheit.
}
