//<ページ数変更>
大佐_001_1: {
in den Raum und zerst&~ore die
Energiequelle.
}
//	<<<ENGLISH>>>
//	through that duct into the room
//	and take out that power source.

/*そのダクトを通して部屋の中にリモコン
ミサイルを侵入させるんだ。部屋の中の
電源パネルを破壊しろ。
*/
//dv}//v
}//d



//エマ後ダクトは蓋がされている h //e
