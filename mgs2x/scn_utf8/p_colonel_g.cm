}//d

//水中機雷 h  //e
resource PC_水中＿水中機雷__g {
//vox t:vc262251 {
大佐_000: {
Raiden, pa&~s auf Unterwasserminen auf.
}
//	<<<ENGLISH>>>
//	Raiden, watch out for
//	the underwater mines.
//<ページ数変更>
大佐_000_1: {
Sie explodieren bei Kontakt. Weiche ihnen
aus und schwimm durch den Bereich.
}
//	<<<ENGLISH>>>
//	They'll detonate on contact.
//	Avoid the mines and swim
//	through the area.

/*ライデン、水中機雷だ。
触れば爆発するぞ。
機雷をよけて泳ぐんだ。
*/
//dv}//v
}//d
//水密扉 h //e
resource PC_水中＿水中水密扉__g {
//vox t:vc262261 {
大佐_000: {
Raiden, wasserdichte T&~uren lassen sich
ebenso &~offnen wie T&~uren an Land.
}
//	<<<ENGLISH>>>
//	Raiden, the procedure for opening
//	watertight doors is the same as
//	when you're on land.
//<ページ数変更>
大佐_000_1: {
Dr&~ucke die Aktionstaste vor der T&~ur.
}
//	<<<ENGLISH>>>
//	Push the Action button
//	in front of the door.

/*ライデン、水中でも水密扉の開け方は
変わらない。扉の前で△ボタンを
押すんだ。
*/
//dv}//v
}//d
//水中開かない水密扉 h //e
resource PC_水中＿水中開かない水密扉__g {
//vox t:vc262271 {
大佐_000: {
Raiden, ich glaube nicht, da&~s Du die
wasserdichte T&~ur da &~offnen kannst.
Such einen anderen Weg.
}
//	<<<ENGLISH>>>
//	Raiden, it doesn't look as though
//	the watertight door will open.
//	Find another route.

/*ライデン、その水密扉は開かないようだ。
他のルートを探せ。
*/
//dv}//v
}//d

//息継ぎポイントを探せ h //e
resource PC_水中＿息継ぎ__g {
//vox t:vc262281 {
大佐_000: {
Du mu&~st Luft holen, bevor Deine
O2-Anzeige den Nullpunkt erreicht.
}
//	<<<ENGLISH>>>
//	You need to catch your breath
//	somewhere before your O2
//	Gauge runs out.
//<ページ数変更>
大佐_000_1: {
Halte Ausschau nach der
Wasseroberfl&~ache.
}
//	<<<ENGLISH>>>
//	Keep a lookout for the surface.

/*Ｏ２ゲージがなくなる前に息継ぎを
するんだ。上方に気を配れ。
*/
ローズ_001: {
Selbst bei dieser &~Uberschwemmung m&~u&~ste
es noch Lufteinschl&~u&~se geben.
}
//	<<<ENGLISH>>>
//	There should be pockets of air
//	somewhere even with this level
