/*まあ気持ちは分かるがな……。
*/
ローズ_007: {
Du kannst was?
}
//	<<<ENGLISH>>>
//	You what?

/*なんですって！？*/
大佐_008: {
&~Ah, nichts.
}
//	<<<ENGLISH>>>
//	Err, nothing...

/*あ、いや……。*/
ローズ_009: {
Ihr seid doch beide pervers!!
}
//	<<<ENGLISH>>>
//	How twisted, the both of you!!

/*信じられない！
……もう、なんて人達！！*/
//dv}//v
}//d

