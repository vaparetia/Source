resource PC_ヴァンプ戦＿弾当たらない１__g {
//vox t:vc264011 {
大佐_000: {
Der Vamp scheint die Flugbahn Deiner
Sch&~usse durch die minimale Bewegung
Deiner Muskeln vorauszuahnen.
}
//	<<<ENGLISH>>>
//	Vamp seems to be anticipating the
//	trajectory of your shots from the
//	minute movements of your muscles.

/*ヴァンプは君の筋肉の動きから銃口の
向きを予測し、着弾点を読むようだ。
*/
大佐_001: {
Aber kein System ist perfekt. Es mu&~s
einen Weg geben, ihn abzulenken und
einen Treffer zu landen.
}
//	<<<ENGLISH>>>
//	There's no such thing as a perfect
//	system, though. There must be a way
//	to throw him off and land a shot.

/*だが完璧な読みなどありえない。
必ず奴に攻撃を当てる方法はあるはずだ。
*/
//dv}//v
}//d

//ズバリヒント h //e
resource PC_ヴァンプ戦＿弾当たらないズバリ__g {
//vox t:vc264021 {
大佐_000: {
Raiden, benutze nicht die
Zielerfassungsfunktion - er
kann sonst die Flugbahn lesen.
}
//	<<<ENGLISH>>>
//	Raiden, don't use the target
//	locking function -- he'll be
//	able to read your trajectory.
//<ページ数変更>
大佐_000_1: {
Ziele lieber aus der
Beobachtungsperspektive und feure, wenn
n&~otig, eine Salve mit Deiner automatischen
Waffe.
}
//	<<<ENGLISH>>>
//	Aim from First Person View
//	instead, and fire off a barrage
//	with the automatic if necessary.

/*ライデン、ロックオンは使うな。
弾筋を読まれるぞ。主観攻撃で狙うんだ。
自動小銃で弾幕を張ってもいいだろう。
*/
//dv}//v
}//d

//基本戦法 h //e
resource PC_ヴァンプ戦＿基本戦法１__g {
//vox t:vc264031 {
大佐_000: {
Raiden, im Wasser ist er im Vorteil. Warte,
bis er an Land ist, bevor Du angreifst.
}
//	<<<ENGLISH>>>
//	Raiden, he has the advantage
//	when he's on water. Wait until
//	he's on land before you attack.

/*ライデン、奴が水の上にいる時は不利だ。
陸に上がった時に攻撃する方がいい
だろう。
*/
大佐_001: {
Wenn er sich n&~ahert, nutze Deine
Chance. Ziele und feure aus der
Beobachtungsperspektive!
}
//	<<<ENGLISH>>>
//	When he starts to close in,
//	that's your chance. Aim and
//	fire from First Person View!

/*奴が近づいてきた時がチャンスだ。
主観攻撃で狙え！
*/
//dv}//v
}//d

//水中では弾は効かない。h //e
resource PC_ヴァンプ戦＿水中弾当たらん__g {
//vox t:vc264041 {
大佐_000: {
Sobald sie auf Wasser treffen,
&~andern Kugeln ihre Bahn.
}
//	<<<ENGLISH>>>
//	Raiden, bullets veer off
//	course once they hit water.
//<ページ数変更>
大佐_000_1: {
Wenn er abtaucht, k&~onnen
Handfeuerwaffen und automatische
Waffen nicht viel gegen ihn ausrichten.
}
//	<<<ENGLISH>>>
//	Handguns and automatics will
//	have little effect on him when
//	he's submerged.
//<ページ数変更>
大佐_000_2: {
Nimm lieber Granaten.
}
//	<<<ENGLISH>>>
//	Use grenades instead.

/*ライデン、水中では弾道が曲がる。奴が
水中にいる間はハンドガンや自動小銃は効果がないぞ。グレネードを使うんだ。
*/
//dv}//v
}//d

//プール落ちたら死ぬ h //e
resource PC_ヴァンプ戦＿プール一発氏に__g {
//vox t:vc264051 {
大佐_000: {
Denk' an die Worte des Vamps: Der
