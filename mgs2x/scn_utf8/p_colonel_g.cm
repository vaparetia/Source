//主観で便器を見つめている h //e
resource PC_Ｃ脚男子トイレ便器主観__g {
//vox t:vc265301 {
大佐_000: {
Was schaust Du Dir da an?
Ah, ich verstehe -- Rosemary.
}
//	<<<ENGLISH>>>
//	Raiden, what are you looking at?
//	Oh, I see. Rosemary.

/*ライデン……一体何を見ているんだ？
あぁ、そうか。ローズ君。
*/
ローズ_001: {
Was?
}
//	<<<ENGLISH(2)>>>
//	What?

/*なんです？*/
大佐_002: {
W&~urdest Du ihn einen Augenblick
entschuldigen?
}
//	<<<ENGLISH>>>
//	Could you excuse
//	him for a moment?

/*ちょっと席を外してやってくれ。
*/
ローズ_003: {
Was?
}
//	<<<ENGLISH(2)>>>
//	Huh?

/*え？*/
大佐_004: {
Du wei&~st doch, damit er...
}
//	<<<ENGLISH>>>
//	You know, so he can...

/*ほら、その……。*/
ローズ_005: {
Ahh, verstehe.
}
//	<<<ENGLISH>>>
//	Ahh, I get it.

/*ああ、なるほど。*/
ライデン_006: 
''
/*……。*/
ローズ_007: {
Jack, &~ah, melde Dich,
wenn Du fertig bist, ja?
}
//	<<<ENGLISH>>>
//	Jack, uh, let me know
//	when you're done, okay?

/*ジャック、えーと……済んだら呼んでね。
*/
ライデン_008: 
''
/*……。*/
//dv}//v
}//d

//主観でしゃがんで便器を見つめている h //e
resource PC_Ｃ脚男子トイレ便器主観しゃがみ__g {
//vox t:vc265311 {
大佐_000: {
Ich wu&~ste gar nicht, da&~s Du so
merkw&~urdige Interessen hast...
}
//	<<<ENGLISH>>>
//	Raiden, I didn't know you
//	had such weird interests...

/*ライデン……。
君にはそういう趣味があったのか……
*/
大佐_001: {
Nicht da&~s, &~ah, das nicht okay w&~are.
Es ist nur etwas merkw&~urdig.
}
//	<<<ENGLISH>>>
//	Not that, uh, there's anything
//	wrong with that, though. Just
//	that, well, it's a little weird.

/*いや悪いといってるわけではないんだ。ただ、しかし、なんというか、
変わっているというか……。
*/
ローズ_002: {
Jack. Ich finde das etwas merkw&~urdig.
}
//	<<<ENGLISH>>>
//	Jack... I think that's
//	a little weird.

/*ジャック……
私、そういうのにはちょっと……。
*/
ライデン_003: 
''
