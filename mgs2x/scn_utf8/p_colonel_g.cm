//	Hang in there, okay?

/*がんばってね。*/
//dv}//v
}//d

//★P036_13_R04忍者登場１３無線デモ４終了＜フラグ＜P037_01_R01スネークの遺体１無線デモ１開始 d //e
//中央棟に人質 h //e
resource PC_人質＿中央棟行け__g {
//vox t:vc263231 {
大佐_000: {
Raiden, stell' den Kontakt zu Ames her
und finde heraus, wo sich der Pr&~asident
befindet.
}
//	<<<ENGLISH>>>
//	Raiden, make contact with
//	Ames and find out where
//	the President is.

/*ライデン、エイムズに接触して大統領の
居所を聞き出すんだ。
*/
大佐_001: {
Soweit wir wissen, wird Ames auf Etage
B1 im Kern von Shell 1 festgehalten.
}
//	<<<ENGLISH>>>
//	Our information indicates that
//	Ames is being held in the B1
//	level of Shell 1's core.
//<ページ数変更>
大佐_001_1: {
Begib Dich zum Kern von Shell 1.
}
//	<<<ENGLISH>>>
//	Head for the core of Shell 1.

/*エイムズはシェル１中央棟のＢ１に
人質として捕えられているらしい。
シェル１中央棟に向かえ。
*/
//dv}//v
}//d

//指向性マイク h //e
//一回目のみ t //e
resource PC_人質＿指向性マイク１__g {
//vox t:vc263241 {
大佐_000: {
Ames wird vermutlich zusammen mit
den anderen Geiseln festgehalten.
}
//	<<<ENGLISH>>>
//	Ames is most likely being
//	held with other hostages.

/*エイムズは他の人質と一緒に
捕らえられているらしい。
*/
ライデン_001: {
Sicher -- aber ich wei&~s nicht einmal,
wie Ames aussieht.
}
//	<<<ENGLISH>>>
//	Sure -- but I don't even
//	know what Ames looks like.

/*ああ。だが俺はエイムズの顔を知らない。
*/
//dv}//v
}//d

resource PC_人質＿指向性マイク２__g {
//vox t:vc263251 {
大佐_000: {
Benutze das Richtmikrofon, um Ames zu
identifizieren. Das ist die einzige
M&~oglichkeit.
}
//	<<<ENGLISH>>>
//	Use the directional microphone to
//	distinguish Ames from the other
//	hostages. It's the only way.

/*エイムズを他の人質から見分けるには
指向性マイクを使うしかないようだ。
*/
大佐_001: {
Soweit wir wissen, hat Ames einen
Herzschrittmacher.
}
//	<<<ENGLISH>>>
//	According to our information,
//	Ames has a pacemaker.
//<ページ数変更>
大佐_001_1: {
Sein Herzschlag m&~u&~ste sich also von dem
der anderen Geiseln unterscheiden.
}
//	<<<ENGLISH>>>
//	This should make his cardiac
//	pattern fairly distinct.
//<ページ数変更>
大佐_001_2: {
Mit dem Richtmikrofon kannst Du
ihn finden.
}
//	<<<ENGLISH>>>
//	Use the directional microphone
//	to locate it.

/*エイムズは心臓にペースメイカーを埋め
込んでいるらしい。心音が違うはずだ。
それを指向性マイクで聞き分けるんだ。
*/
//dv}//v
}//d
//マイク持ってない場合 t //e
resource PC_人質＿指向性マイク３__g {
//vox t:vc263261 {
大佐_000: {
Soll das Richtmikrofon nicht irgendwo
im Kern von Shell 1 liegen?
}
//	<<<ENGLISH>>>
//	Isn't the directional microphone
//	supposed to be somewhere in
//	the core of Shell 1?

/*指向性マイクはシェル１中央棟の
どこかにあるんだろう？
*/
//dv}//v
}//d


//変装方法 h //e
resource PC_変装＿変装方法１__g {
//vox t:vc263271 {
大佐_000: {
Die Sicherheitsma&~snahmen in Shell 1
sind sehr streng.
}
//	<<<ENGLISH>>>
//	Shell 1's core has extremely
//	tight security.
//<ページ数変更>
大佐_000_1: {
Tarn Dich als einer der Feinde, um in
den Abschnitt eindringen zu k&~onnen.
}
//	<<<ENGLISH>>>
//	Impersonate an enemy personnel
//	to infiltrate the section.

/*シェル１中央棟の警備は厳重だ。
敵に変装して潜入するんだ。
*/
大佐_001: {
Um Dich richtig zu tarnen, w&~ahle den
feindlichen Kampfanzug, den Du von dem
Ninja bekommen hast.
}
//	<<<ENGLISH>>>
//	For a proper disguise, select the
//	enemy field uniform you received
//	from the Ninja.
//<ページ数変更>
大佐_001_1: {
Damit f&~allst Du nicht auf.
}
//	<<<ENGLISH>>>
//	This will allow you to blend in.

/*変装するには、まずあの忍者から
渡された敵兵士の野戦服を装備するんだ。
それで敵の服装を真似ることが出来る。
*/
//dv}//v
}//d
resource PC_変装＿変装方法２__g {
//vox t:vc263281 {
大佐_000: {
Aber eines brauchst Du noch.
}
//	<<<ENGLISH>>>
//	But you still need one more thing.

/*だがそれだけでは不十分だ。*/
//dv}//v
}//d
resource PC_変装＿ＡＫ装備__g {
//vox t:vc263291 {
大佐_000: {
Ohne die Standardwaffe w&~urdest
Du Dich verd&~achtig machen.
}
//	<<<ENGLISH>>>
//	It will look suspicious
//	if you're not carrying
//	the standard equipment.

/*敵兵士と同じ武器を装備していなければ
怪しまれるぞ。
*/
大佐_001: {
Das gesamte Personal im Kern ist
mit AK-74Us bewaffnet.
}
//	<<<ENGLISH>>>
//	All personnel in the core are
//	equipped with AK-74U's.
//<ページ数変更>
大佐_001_1: {
W&~ahl Deine eigene AK,
solange Du Dich tarnen willst.
}
//	<<<ENGLISH>>>
//	Select your own AK when
//	you're in disguise.

/*中央棟の敵兵士は武器として
ＡＫＳ７４Ｕを装備している。
変装する時はＡＫを装備しろ。
*/
//dv}//v
}//d
//ＡＫ持っていない場合 t //e
resource PC_変装＿ＡＫ探せ__g {
//vox t:vc263301 {
大佐_000: {
Suche Dir eine AK.
}
//	<<<ENGLISH>>>
//	Find yourself an AK.

//<ページ数変更>
大佐_000_1: {
Du hast doch eine Karte f&~ur Ebene 2.
Gehe damit in das Lager in Strebe F und
durchsuche es.
}
//	<<<ENGLISH>>>
//	You have a Level 2 card in your
//	possession; go and search the
//	warehouse in Strut F.

/*ＡＫを探すんだ。カード２を手に入れた
だろう。Ｆ脚の倉庫を探してみては
どうだ？
*/
//dv}//v
}//d
//変装中攻撃すると見つかる h //e
resource PC_変装＿攻撃するな__g {
//vox t:vc263311 {
大佐_000: {
Selbst die beste Tarnung kann Dich nicht
mehr sch&~utzen,
}
//	<<<ENGLISH>>>
//	Even the most successful
//	disguise can't protect you＃－
//<ページ数変更>
大佐_000_1: {
wenn Du den Feind angreifst.
}
//	<<<ENGLISH>>>
//	if you decide to blow your own
//	cover by attacking the enemy.

/*変装に成功していても敵に攻撃を
しかけたりしてはたちまち正体が
ばれるぞ。
*/
大佐_001: {
La&~s Dich auf kein Gefecht mit dem Feind
ein, solange Du getarnt bist.
}
//	<<<ENGLISH>>>
//	Do not engage the enemy
//	while you are in disguise.

/*変装中は敵に手を出してはいけない。
いいな。
*/
//dv}//v
}//d
//変装中も怪しい行動はするな h //e
resource PC_変装＿怪しい行動__g {
//vox t:vc263321 {
大佐_000: {
Raiden, benimm Dich nicht verd&~achtig.
}
//	<<<ENGLISH>>>
//	Raiden, don't act in any way that
//	will excite the enemy's suspicion.

/*ライデン、敵に怪しまれるような
行動はするなよ。
*/
大佐_001: {
Eine falsche Bewegung kann eine perfekte
Tarnung zunichte machen. Sei vorsichtig.
}
//	<<<ENGLISH>>>
//	A perfect disguise can be ruined
//	by a single odd behavior.
//	Be careful.

/*いくら変装が完璧でもおかしな行動を
とれば正体を見破られてしまうぞ。
注意するんだ。
*/
//dv}//v
}//d

//変装接触で装備が外れる h //e
resource PC_変装＿接触脱ぎ１__g {
//vox t:vc263331 {
大佐_000: {
Wenn Du mit dem Feind in K&~orperkontakt
ger&~atst, wird Deine Tarnung sofort
deaktiviert.
}
//	<<<ENGLISH>>>
//	If you make physical contact with
//	the enemy while in disguise, the
//	disguise will be deselected.
//<ページ数変更>
大佐_000_1: {
Vergi&~s das nicht.
}
//	<<<ENGLISH>>>
//	Keep that in mind.

/*変装していても敵と接触すると
野戦服が装備から外れてしまう。
気をつけてくれ。
*/
//dv}//v
}//d
//一回目のみ t //e
resource PC_変装＿接触脱ぎ２__g {
//vox t:vc263341 {
ローズ_000: {
Die Uniform ist Dir doch viel zu klein.
}
//	<<<ENGLISH>>>
//	That uniform's probably not
//	even close to your size.

/*その服、きっとサイズがあってないのね。
*/
ライデン_001: {
Ja, ehrlich gesagt, ist sie ziemlich knapp.
}
//	<<<ENGLISH>>>
//	Yeah, to tell you the truth,
//	it feels pretty tight.

/*ああ。
実はかなりきついんだ……。
*/
大佐_002: {
Sie pa&~st Rosemary vermutlich
besser als Dir.
}
//	<<<ENGLISH>>>
//	It's probably a better fit for
//	Rosemary here than you.

/*そうか。君よりもむしろローズ君に
着てもらいたいところだな。
*/
ローズ_003: {
Wie bitte?
}
//	<<<ENGLISH>>>
//	Excuse me?

/*はい！？*/
ライデン_004: {
&~Ah -- Oberst?
}
//	<<<ENGLISH>>>
//	Er -- Colonel?

/*大佐……。*/
大佐_005: {
Das war nur eine Anmerkung. Kehren wir
zum Einsatz zur&~uck, okay?
}
//	<<<ENGLISH>>>
//	Just an observation.
//	Let's get back to the
//	mission, shall we?

/*冗談だ。
ライデン、任務に戻れ。
*/
ローズ_006: {
Das war v&~ollig unangebracht.
}
//	<<<ENGLISH>>>
//	That was inappropriate...

/*信じられない……。*/
//dv}//v
}//d

//激しい行動をとると脱げる h //e
resource PC_変装＿激し脱げ__g {
//vox t:vc263351 {
大佐_000: {
Der Kampfanzug erscheint mir viel
zu klein f&~ur Dich.
}
//	<<<ENGLISH>>>
//	That enemy field uniform seems
//	to be much too small for you.

/*敵の野戦服だが、君にはサイズが
小さすぎるようだな。
*/
大佐_001: {
Wenn Du Dich zu heftig bewegst, k&~onnte
die Uniform deaktiviert werden. Also sei
vorsichtig.
}
//	<<<ENGLISH>>>
//	Any vigorous activity could force
//	the uniform to be deselected.
//	Be cautious.

/*あまり激しい動きをすると装備から
外れてしまうかもしれない。
注意するんだ。
*/
//dv}//v
}//d

