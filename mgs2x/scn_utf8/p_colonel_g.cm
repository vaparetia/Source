//ファットマン戦後 d //e
//プリスキンは生きていた h //e
resource PC_プリスキン生きていた__g {
//vox t:vc265951 {
ライデン_000: {
Oberst, Pliskin ist nicht tot.
}
//	<<<ENGLISH>>>
//	Colonel, Pliskin wasn't killed.

/*大佐、プリスキン達は無事だった。*/
ローズ_001: {
Du siehst gl&~ucklich aus, Jack.
}
//	<<<ENGLISH>>>
//	You look happy, Jack.

/*うれしそうね、ジャック。*/
ライデン_002: {
Ja.
}
//	<<<ENGLISH>>>
//	Yeah...

/*ああ……。*/
大佐_003: {
Raiden, vertraue ihm nicht!
}
//	<<<ENGLISH>>>
//	Raiden, don't trust him!

/*ライデン、奴を信用するな。*/
ライデン_004: {
Was?
}
//	<<<ENGLISH>>>
//	What?

/*なんだって？*/
大佐_005: {
Kommt es Dir nicht auch verd&~achtig vor,
da&~s nur er unverletzt entkam? Es pa&~st
einfach nicht zusammen.
}
//	<<<ENGLISH>>>
//	Don't you think it's suspicious that
//	he alone came out unscathed?
//	Things don't add up.

/*おかしいとは思わないか？
奴一人だけ助かるなんて、
あまりにも都合が良すぎる。
*/
ライデン_006: 
''
//	<<<ENGLISH>>>
//	...

/*……。*/
大佐_007: {
Raiden, vertraue ihm nicht. Du wirst
Deinen Auftrag allein zu Ende f&~uhren.
Verstehst Du?
}
//	<<<ENGLISH>>>
//	Raiden, don't put any faith in that
//	guy. You will carry out your mission
//	alone. Do you understand?

/*ライデン。奴を頼りにするな。
君が独りで任務を遂行するんだ。
いいな。
*/
//dv}//v
}//d

//忍者について h //e
resource PC_忍者接触後＿忍者__g {
