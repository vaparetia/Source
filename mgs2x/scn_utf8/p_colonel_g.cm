//<ページ数変更>
ローズ_001_1: {
Finde einen, h&~orst Du?
}
//	<<<ENGLISH>>>
//	Make sure you find one, okay?

/*浸水しててもどこかに空気が残ってる
はずよ。見逃すないで。
*/
//dv}//v
}//d

//水中隔壁 h //e
resource PC_水中＿隔壁__g {
//vox t:vc262291 {
大佐_000: {
Raiden, die Brandmauer wurde abgesenkt.
Such eine andere Route -- da kommst Du
nicht durch.
}
//	<<<ENGLISH>>>
//	Raiden, the firewall's been
//	lowered. Find another route...
//	you can't get through there.

/*ライデン、隔壁が下りているな。
そこを通り抜けることは出来ないだろう。
他のルートを探すんだ。
*/
//dv}//v
}//d

//水中暗黒地帯 h //e
resource PC_水中＿水中暗黒地帯__g {
//vox t:vc262301 {
大佐_000: {
Raiden, das Infrarotsichtger&~at funktioniert
auch unter Wasser.
}
//	<<<ENGLISH>>>
//	Raiden, the Thermal Goggles will
//	function even underwater.

/*ライデン、赤外線ゴーグルなら
