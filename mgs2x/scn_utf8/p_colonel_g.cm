*/
大佐_002: {
Raiden!
}
//	<<<ENGLISH(2)>>>
//	Raiden!

/*ライデン！*/
ライデン_003: {
!?
}
/*！？*/
大佐_004: {
Er ist nicht Teil der Simulation.
Traue ihm nicht. Niemals. Verstanden?
}
//	<<<ENGLISH>>>
//	He's not included in the
//	simulation. Don't trust
//	him. Ever. You got it?

/*あの男はシミュレーションには入って
いない。あの男に頼るな。決してだ。
