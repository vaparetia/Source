//dv}//v
}//d


//ロケット h //e
resource PC_ハリアー戦＿ロケットミサイル__g {
//vox t:vc266151 {
大佐_000: {
Beide Fl&~ugel sind mit
Luft-Boden-Raketen versehen.
}
//	<<<ENGLISH>>>
//	Both wings are outfitted with
//	an air-to-surface rocket pod.

/*ハリアーは両翼に
対地攻撃用ロケット弾ポッドを
搭載している。
*/
大佐_001: {
Die Raketen sind nicht gelenkt. Beweg
Dich, dann kannst Du ihnen entkommen.
Aber Vorsicht mit der Druckwelle.
}
//	<<<ENGLISH>>>
//	The rockets aren't guided, so moving
//	should get you out of their way. Watch
//	out for the blast, though.

/*ロケット弾は無誘導だ。
移動すれば避けられるだろう。
ただし爆風には注意しろよ。
*/
//dv}//v
}//d

//突撃 h //e
resource PC_ハリアー戦＿突撃__g {
//vox t:vc266161 {
大佐_000: {
Lauf nicht ziellos herum, auch wenn
der Harrier weggeflogen und nicht
mehr zu sehen ist.
}
//	<<<ENGLISH>>>
//	Don't start scurrying about even
//	after the Harrier has flown away
//	and is no longer in eyesight.

/*ハリアーが飛び去って
目視出来なくなっても慌ててはいけない。
*/
大佐_001: {
Wenn der Harrier in Deine Richtung weist,
}
//

//	Wenn der Harrier in Deine Richtung weist,

//	When the Harrier is pointed
//	in your direction...
//<ページ数変更>
大佐_001_1: {
blinkt er vermutlich kurz auf, wenn
er die Sonne reflektiert. Achte auf
diese Vorwarnung.
}
//	<<<ENGLISH>>>

//	it should flash for a moment as
//	it reflects the sun. Don't miss
//	that flash.

/*ハリアーが機首を君の方に向けた時、
機体が太陽の反射で一瞬光るはずだ。
それを見逃すな。
*/
大佐_002: {
Du mu&~st ihn m&~oglichst schnell lokalisieren
und mit einer Stinger ausschalten. Wenn
Du z&~ogerst, wirst Du angegriffen.
}
//	Locate it as early as possible
//	and hit it with a Stinger. If you
//	delay you'll be attacked.

/*少しでも早く発見してスティンガーを
当てるんだ。遅れれば攻撃を受けるぞ。
*/
//dv}//v
}//d

//焼き攻撃 h //e
resource PC_ハリアー戦＿焼き攻撃__g {
//vox t:vc266171 {
大佐_000: {
Der Triebstrahl des Harrier
ist sehr hei&~s.
}
//	<<<ENGLISH>>>
//	The Harrier's exhaust
//	is extremely hot.
//<ページ数変更>
大佐_000_1: {
Du kannst es Dir nicht leisten, davon
erfa&~st zu werden. Wenn der Harrier
in Deine N&~ahe kommt, renne schnell
in die untere Ebene.
}
//	<<<ENGLISH>>>
//	You cannot afford to get enveloped
//	in it. When the Harrier draws near
//	run down to the lower level.

/*ハリアーの排気炎は高熱だ。
巻き込まれてはいけない。ハリアーが
接近してきたら下の階に逃げるんだ。
*/
//dv}//v
}//d

//フレア h //e
resource PC_ハリアー戦＿フレア__g {
//vox t:vc266181 {
大佐_000: {
Der Harrier ist mit IR-Leuchtraketen
versehen, die in der Luft mit Magnesium
verbrennen
}
//	The Harrier is outfitted with
//	IR Flares, a countermeasure
//	that burns in mid-air＃－
//<ページ数変更>
大佐_000_1: {
und auf diese Weise zielsuchende
Infrarot-Raketen t&~auschen.
}
//	<<<ENGLISH>>>

//	with magnesium to deceive
//	infrared homing missiles.

/*ハリアーはＩＲフレアを装備している。
マグネシウム等を空中で燃焼させ赤外線
誘導ミサイルを欺瞞する対抗兵器だ。
*/
大佐_001: {
Wenn Du eine Leuchtrakete abschie&~st,
wird eine gestartete Stinger-Rakete dorthin
gelenkt.
}
//	Shooting a flare will draw any
//	launched Stinger Missiles
//	towards the flare.

/*フレアを射出されると、発射した
スティンガーミサイルがフレアの方に
引き寄せられてしまうぞ。
*/
//dv}//v
}//d





//ハリアー戦後 d //e
//スネークについて h //e
resource PC_ハリアー戦後＿スネーク__g {
//vox t:vc266191 {
ライデン_000: {
Oberst, Pliskin war doch Snake.
}
//	<<<ENGLISH>>>
//	Colonel, Pliskin was
//	Snake after all.

/*大佐、プリスキンはやはりスネーク
だった……。
*/
大佐_001: {
Sagt er jedenfalls.
}
//	<<<ENGLISH>>>
//	According to him.

/*奴いわく、な。*/
ライデン_002: {
Was?
}
//	<<<ENGLISH>>>
//	What?

/*なんだって？*/
大佐_003: {
H&~or mal, Raiden. Ich sage es nochmal.
Er ist kein Teil der Simulation.
}
//	<<<ENGLISH>>>
//	Listen, Raiden. I'll say it again.
//	He is not in the simulation.

/*いいか、ライデン。何度でも言うぞ。
奴はシミュレーションには入っていない。
*/
ライデン_004: {
F&~angst Du schon wieder mit
der Simulation an.
}
//	<<<ENGLISH>>>
//	There you go about
//	the simulation again...

/*またシミュレーションか……。
*/
大佐_005: {
Glaube ihm nicht. Vertraue ihm nicht.
Verstehst Du?
}
//	<<<ENGLISH>>>
//	Don't put your faith in him.
//	Don't trust him. Do you
//	understand?

/*奴に頼るな。奴を信用するな。いいな。
*/
//dv}//v
}//d


//大統領後 d //e
//愛国者達 h //e
resource PC_愛国者達__g {
//vox t:vc266201 {
ライデン_000: {
Oberst, hast Du etwas &~uber die 'Patriots'
herausgefunden?
}
//	<<<ENGLISH>>>
//	Colonel, did you find anything
//	about the "Patriots"?

/*大佐、『愛国者達』という連中に
ついては何かわかったか？
*/
大佐_001: {
Nein, noch nicht.
}
//	<<<ENGLISH>>>
//	No, not yet...

/*いや、まだだ……。*/
ローズ_002: {
Ich kann nirgends irgendwelche Daten
&~uber sie finden.
}
//	<<<ENGLISH>>>
//	I can't find data on
//	them anywhere.

/*どこにもそんなデータは見つからないの。
*/
ライデン_003: {
Aber der Pr&~asident ist.
}
//	<<<ENGLISH>>>
//	But the President is...

/*だが大統領は……。*/
ローズ_004: {
Jack, es sind keine Daten vorhanden.
}
//	<<<ENGLISH>>>
//	Jack, there is no data.

/*ジャック、データはないの。*/
ライデン_005: {
Oberst, Du wei&~st doch etwas, oder?
}
//	<<<ENGLISH>>>
//	Colonel, you know
//	something, don't you?

/*大佐、あんたは何か知ってるんじゃ
ないのか？
*/
大佐_006: {
Nein, ich wei&~s nichts.
Ich brauche etwas mehr Zeit.
}
//	<<<ENGLISH>>>
//	No, I don't know anything...
//	I need a little more time.

/*いや。何も知らん……。
もう少し時間をくれ。
*/
//dv}//v
}//d



//オセロットはなぜ大統領を殺したのか？ h //e
resource PC_大統領後＿なぜ大統領を殺したのか__g {
//vox t:vc266211 {
ライデン_000: {
Oberst, warum hat Ocelot
den Pr&~asidenten get&~otet?
}
//	<<<ENGLISH>>>
//	Colonel, why did Ocelot
//	murder the President?

/*大佐、なぜオセロットは大統領を
殺したんだろう？
*/
大佐_001: {
Vermutlich wegen einer
Meinungsverschiedenheit.
}
//	<<<ENGLISH>>>
//	They disagreed, probably.

/*仲間割れじゃないか？*/
ライデン_002: {
genau dasselbe.
}
//	<<<ENGLISH>>>
//	...Exactly the same.

/*……似てないか？*/
大佐_003: {
Was?
}
//	<<<ENGLISH>>>
//	What?

/*何だって？*/
ライデン_004: {
Wie beim Shadow Moses-Zwischenfall.
}
//	<<<ENGLISH>>>
//	As the Shadow Moses incident.

/*シャドーモセス事件とだ。*/
大佐_005: {
Mach Dich nicht l&~acherlich.
}
//	<<<ENGLISH>>>
//	Don't be foolish.

/*馬鹿な……。*/
ライデン_006: {
Bist Du sicher? Ames Tod,
das Erscheinen des Ninjas,
}
//	<<<ENGLISH>>>
//	Are you sure about that?
//	Ames' death, appearance
//	of the Ninja,
//<ページ数変更>
ライデン_006_1: {
der Tod des Pr&~asidenten,
und jetzt dieser Virus.
}
//	<<<ENGLISH>>>
//	the President's death,
//	and now the virus...

/*そう言い切れるか？
エイムズの死、忍者の出現、大統領の死、
そしてウィルス……。
*/
大佐_007: {
Du interpretierst viel zu viel
in Dinge hinein.
}
//	<<<ENGLISH>>>
//	You're reading too
//	much into things.

/*考え過ぎだ。
*/
ローズ_008: {
Genau, Jack, Du bist m&~ude.
}
//	<<<ENGLISH>>>
//	That's right, Jack,
//	you're tired.

/*そうよ、ジャック。
あなたは疲れてるの。
*/
ライデン_009: 
''
//	<<<ENGLISH>>>
//	...

/*……。*/
大佐_010: {
Raiden, vergeude Deine Zeit nicht
mit unn&~otigen Gedanken.
}
//	<<<ENGLISH>>>
//	Raiden, don't waste your time
//	thinking unnecessary thoughts.
//<ページ数変更>
大佐_010_1: {
Investiere Deine ganze Energie
stattdessen lieber in die Erf&~ullung
Deiner Pflichten.
}
//	<<<ENGLISH>>>
//	Invest all your energy instead
//	in carrying out your duties.

/*ライデン、余計なことは考えるな。
任務を遂行することに全力を注ぐんだ。
いいな。
*/
//dv}//v
}//d


//タンカー編整理後 d //e
//スネークのこと h //e
resource PC_大統領後＿スネーク__g {
//vox t:vc266221 {
ライデン_000: {
Oberst, hast Du geh&~ort, wie der Shadow
Moses-Zwischenfall tats&~achlich ablief?
}
//	<<<ENGLISH>>>
//	Colonel, did you hear the truth
//	about the Shadow Moses incident?

/*大佐、聞いたか、シャドーモセスの
真実を？
*/
大佐_001: {
Ja.
}
//	<<<ENGLISH>>>
//	Yeah.

/*ああ。*/
ライデン_002: {
Snake war kein Terrorist.
}
//	<<<ENGLISH>>>
//	Snake wasn't a terrorist.

/*スネークはテロリストではなかった。*/
ローズ_003: {
Du siehst begeistert aus.
}
//	<<<ENGLISH>>>
//	You look thrilled.

/*うれしそうね？*/
ライデン_004: {
Was? Ja.
}
//	<<<ENGLISH>>>
//	Huh? Yeah...

/*ん？ああ……。*/
大佐_005: {
Du glaubst also einfach alles,
was er Dir erz&~ahlt?
}
//	<<<ENGLISH>>>
//	So you just believe everything
//	that he told you then?

/*それで君はあの男の言ったことを
そのまま信じているのか？
*/
ライデン_006: {
Was hast Du gesagt?
}
//	<<<ENGLISH>>>
//	What did you say?

/*なんだって？*/
大佐_007: {
Trau ihm nicht. Er geh&~ort nicht
zur Simulation.
}
//	<<<ENGLISH>>>
//	Don't trust him.
//	He isn't in the simulation.

/*奴を信用するな。
奴はシミュレーションには入っていない。
*/
ライデン_008: {
Noch eine Simulation?
Wovon sprichst Du eigentlich?
}
//	<<<ENGLISH>>>
//	Simulation again?
//	What exactly are
//	you talking about?

/*またシミュレーションか？
一体どういうことなんだ？
*/
大佐_009: {
Du solltest ihm nicht trauen. F&~uhr' einfach
Deine Aufgaben so gut wie Du kannst aus.
Verstehst Du, Raiden?
}
//	<<<ENGLISH>>>
//	Don't put your trust in him. Just carry
//	out your duties to the best of your
//	abilities. Do you understand, Raiden?

/*奴を頼るな。君の力で任務を
遂行するんだ。いいな。ライデン。
*/
//dv}//v
}//d

