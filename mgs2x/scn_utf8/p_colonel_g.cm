}//d

//　ノード接続まだ t //e
resource PC_ＥＦ連絡橋＿クレイモア＿地雷探知器ある＿レーダー不可__g {
//vox t:vc261251 {
大佐_000: {
Der Minendetektor kommuniziert mit dem
Radar und ermittelt so die Position der
Minen.
}
//	<<<ENGLISH>>>
//	The mine detector interfaces with
//	the radar to pinpoint the location
//	of the mines.
//<ページ数変更>
大佐_000_1: {
Aktivier also zun&~achst den Radar.
}
//	<<<ENGLISH>>>
//	The first step is to
//	enable the radar.

/*地雷探知器はレーダーに地雷の位置を
表示する。だからまずレーダーを
