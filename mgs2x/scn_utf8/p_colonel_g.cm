//ローズ回線切れる t //e
resource PC_人質＿人質ぱんつ写真２__g {
//vox t:vc265481 {
大佐_000: {
Rosemary.
}
//	<<<ENGLISH(2)>>>
//	Rosemary...

/*ローズ君……。*/
ライデン_001: {
Oberst, habe ich etwas Unrechtes
getan?
}
//	<<<ENGLISH>>>
//	...Colonel, was I wrong
//	in what I did?...

/*……大佐、俺は間違っているのか……？
*/
大佐_002: {
Vielleicht. Es gibt Dinge, die man tun kann,
aber besser lassen sollte.
}
//	<<<ENGLISH>>>
//	Perhaps. There are certain things
//	that a person can and can't do.

/*おそらくな。
人間にはやっていいことと
悪いことがある。
*/
ライデン_003: {
Ja, vielleicht hast Du Recht.
}
//	<<<ENGLISH>>>
//	Yeah, maybe you're right...

/*……そうなのかもしれないな……。*/
大佐_004: {
Verstehst Du?
}
//	<<<ENGLISH(2)>>>
//	Do you understand?

/*わかってくれたか。*/
ライデン_005: {
Ja.
}
//	<<<ENGLISH(2)>>>
//	Yes.

/*ああ。*/
大佐_006: {
&~Uberleb Deinen Einsatz. Um Deinetwillen
und damit Dein Training nicht umsonst
war.
}
//	<<<ENGLISH>>>
//	Come out of this thing alive,
//	both for yourself and so as
//	not to waste your training.

/*ライデン、生きて帰れよ。
その教訓を無駄にしないためにも。
*/
ライデン_007: {
Das mu&~s man mir nicht erst sagen,
Oberst!
}
//	<<<ENGLISH>>>
//	No need to tell me that, Colonel.

/*言われるまでもないさ。*/
大佐_008: {
Okay. Und, ich w&~urde auch empfehlen,
das Bild nicht wegzuwerfen.
}
//	<<<ENGLISH>>>
//	Right. And...I recommend you
//	not throw away that picture.

/*うむ。
あと……その写真は捨てなくても良いぞ。
*/
ライデン_009: {
Oberst.
}
//	<<<ENGLISH(2)>>>
//	Colonel.

/*大佐……。*/
大佐_010: {
Was?
}
//	<<<ENGLISH(2)>>>
//	What?



/*……なんだ。*/
ライデン_011: {
Das war kein Witz.
}
//	<<<ENGLISH>>>
//	You're not joking...

/*それ、冗談……*/
大佐_012: 
''
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
ライデン_013: {
Oder doch?
}
//	<<<ENGLISH>>>
//	are you?


/*じゃないみたいだな……。*/
大佐_014: {
Weiter mit der Arbeit. Verstanden?
}
//	<<<ENGLISH>>>
//	Continue your duties.
//	Understood?

/*任務を続行しろ。いいな。
*/
ライデン_015: {
Ja, Sir.
}
//	<<<ENGLISH>>>
//	Yes, sir.

/*了解。*/
//dv}//v
}//d

