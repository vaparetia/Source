//ソリダス戦中 愛国説教 h //e
resource PC_ソリダス戦中＿愛国説教__g {
//vox t:vc266861 {
大佐_000: {
Raiden, Du mu&~st Solidus besiegen!
Das ist Deine letzte Pflicht!
}
//	<<<ENGLISH>>>
//	Raiden, you have to beat Solidus!
//	This is your last duty!

/*ライデン、ソリダスと戦え！
それが君の最後の役割だ！
*/
ライデン_001: {
Wir sind nicht nur Bauern in einem
Simulationsspiel, wei&~st Du?
}
//	<<<ENGLISH>>>
//	We're not just pawns in some
//	simulation game, you know!

/*俺達はシミレーション・ゲームの
駒じゃない！
*/
ローズ_002: {
Oh doch. Ihr seid blo&~se Waffen, nicht
anders als Jets oder Panzer auch.
}
//	<<<ENGLISH>>>
//	Yes, you are. You're nothing but
//	mere weapons. No different from
//	fighter jets or tanks.

/*いいえ。あなた達はただの兵器。
戦闘機や戦車とかわりないのよ。
*/
ライデン_003: {
Was zum --
}
//	<<<ENGLISH>>>
//	What the --

/*なんだと？*/
大佐_004: {
Das alte, vor 4 Jahren zerst&~orte
Modell war 'REX'.
}
//	<<<ENGLISH>>>
//	The old model destroyed
//	four years ago was "REX"...

/*４年前に破壊された旧型は『ＲＥＸ』……
*/
ローズ_005: {
Das neue Amphibienmodell hei&~st 'RAY'.
}
//	<<<ENGLISH>>>
//	The new amphibious
//	model is "RAY"...

/*新型の水陸両用は『ＲＡＹ』……
*/
大佐_006: {
Beide tragen Codenamen, die die
amerikanischen Streitkr&~afte w&~ahrend
}
//	<<<ENGLISH>>>
//	Both of these are the same as
//	the code names used by the U.S.
//	Armed Forces＃－
//<ページ数変更>
大佐_006_1: {
des Zweiten Weltkriegs f&~ur japanische
Flugzeuge benutzten.
}
//	<<<ENGLISH>>>
//	to refer to Japanese war
//	planes during World War 2.

/*どちらも第二次大戦中、米軍が日本軍の
軍用機につけたコードネーム。
*/
ローズ_007: {
Dein Codename 'Raiden' ist der Name,
den die japanische Marine einem ihrer
Abfangj&~ager gegeben hat.
}
//	<<<ENGLISH>>>
//	Your code name "Raiden" too, comes
//	from the Japanese navy's name for
//	one of its interceptors...

/*あなたのコードネーム『ライデン』も
日本海軍の局地戦闘機『雷電』から
来ている……。
*/
ライデン_008: {
H&~or auf! Ich bin keine Waffe!!
}
//	<<<ENGLISH>>>
//	Stop it!
//	I'm not a weapon!!

/*ふざけるな！俺は兵器じゃない！！*/
ローズ_009: {
Ach ja? Wei&~st Du, welchen Codenamen
die amerikanischen Streitkr&~afte f&~ur das
japanische Kampfflugzeug 'Raiden'
benutzten?
}
//	<<<ENGLISH>>>
//	Oh really? Do you know the code
//	name the U.S. Armed Forces used
//	for the Japanese fighter "Raiden"?

/*そうかしら？
『雷電』に米軍がつけたコードネームが
なんだか知ってる？
*/
大佐_010: {
'Jack'.
}
//	<<<ENGLISH>>>
//	It was "Jack."

/*ジャックだよ。*/
大佐_011: {
Ihr seid beide nur Waffen, die man benutzt
und dann wegwirft
}
//	<<<ENGLISH>>>
//	Both of you are just weapons
//	to be used and thrown away.

/*貴様らは利用されて捨てられる
兵器なのだ。
*/
ローズ_012: {
Nur Waffen f&~ur die Schlacht. Nur
Schachfiguren in einem Spiel --
wie Du es gesagt hast.
}
//	<<<ENGLISH>>>
//	Just weapons to be used on the
//	battlefield. Just pawns in a game
//	-- exactly as you said.

/*兵器として戦場で利用される。
まさにゲームの駒。
*/
大佐_013: {
Eine Waffe hat kein Recht,
selbst zu denken!
}
//	<<<ENGLISH>>>
//	And a weapon has no
//	right to think for itself!
//<ページ数変更>
大佐_013_1: {
Jetzt ist es an der Zeit, da&~s Du Deinen
Zweck erf&~ullst! Besieg Solidus!
}
//	<<<ENGLISH>>>
//	Now, it's time to fulfill your
//	purpose! Defeat Solidus!

/*兵器に考える資格はない！
さあ、役割を果たせ！
ソリダスを倒すんだ！！
*/
//dv}//v
}//d

