}//d
resource PC_ＤＧ連絡橋＿赤外線センサー＿ＰＳＧ１構え__g {
//vox t:vc263521 {
大佐_000: {
Du kannst das PSG1 stehend,
kauernd und liegend benutzen.
}
//	<<<ENGLISH>>>
//	The PSG1 can be aimed from
//	upright, crouch, and prone
