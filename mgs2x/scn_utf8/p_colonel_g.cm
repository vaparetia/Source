//	Oh damn...

/*これは……。*/
大佐_001: {
Ja, Emma geht es nicht so gut.
}
//	<<<ENGLISH>>>
//	Yes. Emma's not doing so well.

/*ああ。
エマの怪我は相当重いようだな……。*/
ライデン_002: 
''
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
