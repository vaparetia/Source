*/
大佐_001: {
Nimm in der Dunkelheit das Nacht- oder
Infrarotsichtger&~at.
}
//	<<<ENGLISH>>>
//	Try using the night vision or
//	Thermal Goggles in the dark.

/*暗い場所では暗視ゴーグルか
赤外線ゴーグルを使うといい。
*/
//dv}//v
}//d

resource PC_シェル２中央棟１Ｆ＿暗い２__g {
