*/
//dv}//v
}//d


//ガンカメラ h //e
resource PC_リモコンミサイル＿ガンカメラ__g {
//vox t:vc263931 {
大佐_000: {
Halt Ausschau nach den Schu&~skameras.
}
//	<<<ENGLISH>>>
//	Look out for the gun cameras.
//<ページ数変更>
大佐_000_1: {
Das sind unbemannte
&~Uberwachungskameras, die auf alles
in Sichtweite schie&~sen.
}
//	<<<ENGLISH>>>
//	Those are unmanned surveillance
//	cameras that fire at any moving
//	object that comes into view.

/*ガンカメラに注意しろ。視界に入った
ものを銃撃する無人監視システムだ。
*/
大佐_001: {
Sei vorsichtig. Schu&~skameras k&~onnen
