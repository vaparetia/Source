		}
	}

	proc 警備兵コマンダー {
		#if d:DEBUG_PRINT
			print 'wccomm_set'
		#endif

		switch ( $b:ステージ番号 ) {
			// 主観ステージ２面
			case ( d:FPV_LV2_STAGE_NO ) {
				chara 警備コマンダー wccomm -e { 警備兵セット_２面 }
			}

			// 主観ステージ３面
			default {
				chara 警備コマンダー wccomm -e { 警備兵セット_３面 }
			}
		}
	}

	proc 攻撃兵コマンダー {
		#if d:DEBUG_PRINT
			print 'atcomm_set'
		#endif

		switch ( $b:ステージ番号 ) {
			// 主観ステージ２面
			case ( d:FPV_LV2_STAGE_NO ) {
				chara 攻撃コマンダー wccomm -e { 攻撃兵セット_２面 }
			}

			// 主観ステージ３面
			default {
				chara 攻撃コマンダー wccomm -e { 攻撃兵セット_３面 }
			}
		}
	}

	proc コマンダー設定 {
		#if d:DEBUG_PRINT
			print 'commander_set'
		#endif

		switch ( $b:ステージ番号 ) {
			// 主観ステージ２面
			case ( d:FPV_LV2_STAGE_NO ) {
				chara コマンダー 敵兵セット \
					-w 警備兵コマンダー \
					-a 攻撃兵コマンダー \
					-d 主観ステージ \
					-r d:GOAL_POS_SP22A 主観ステージ \
					-c d:GOAL_POS_SP22A 主観ステージ \
					-v [ene_vr_voice:01] \
					-z $i:敵標準麻酔持続 \
					-h $i:標準警戒時間 \
					-o $i:敵標準気絶持続 \
					-s ( d:ENE_STAGE_VR_ANOTHER ) \
					-b 16 \
					-m d:ALERT_MODE_SENNYU
			}
			
			// 主観ステージ３面
			default {
				chara コマンダー 敵兵セット \
					-w 警備兵コマンダー \
					-a 攻撃兵コマンダー \
					-d 主観ステージ \
					-r d:GOAL_POS_SP23A 主観ステージ \
					-c d:GOAL_POS_SP23A 主観ステージ \
					-v [ene_vr_voice:01] \
					-z $i:敵標準麻酔持続 \
					-h $i:標準警戒時間 \
					-o $i:敵標準気絶持続 \
					-s ( d:ENE_STAGE_VR_ANOTHER | d:ENE_STAGE_FAINT_EXIT ) \
					-b 0 \
					-m d:ALERT_MODE_SENNYU
			}
		}

	}

