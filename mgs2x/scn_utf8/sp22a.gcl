							[VRMSG_F:VRM_FPV_sp22a] [VRMSG_I:VRM_FPV_sp22a] [VRMSG_S:VRM_FPV_sp22a] \		// 仏、伊、西
							[VRMSG_K:VRM_FPV_sp22a] \															// 韓
