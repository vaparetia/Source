			// 主観ステージ２面
			case ( d:FPV_LV2_STAGE_NO ) {
				if ( $s:選択プレイヤー == ライデン ) {
				} else {
					// スネーク
					// A_監視カメラ $:名前 $:場所Ｘ $:場所Ｙ $:場所Ｚ $:取付縦方向 $:取付横方向 $:カメラ振り中心角 $:振り幅 $:フラグ 
					@A_監視カメラ 北カメラ -500 3500 -49000 500 0 0 512 0
					@A_監視カメラ 中央カメラ -5500 3000 -26000 500 0 0 512 0
					@A_監視カメラ 南東カメラ 3000 4500 -20500 500 1024 1024 512 0
				}
			}
			// 主観ステージ３面
			default {
				if ( $s:選択プレイヤー == ライデン ) {
				} else {
