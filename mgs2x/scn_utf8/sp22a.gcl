	// アイテムの設置
	// ------------------------------------
	proc アイテム設定 {
		#if d:DEBUG_PRINT 
			print 'item_set'
		#endif

		switch ( $b:ステージ番号 ) {
			// 主観ステージ２面
			case ( d:FPV_LV2_STAGE_NO ) {
				if ( $s:選択プレイヤー == ライデン ) {
					@A_クレイモア_初期設置 クレイモア本体 d:ITEM_POS_02 0 15
					@A_チャフ_初期設置 チャフ d:ITEM_POS_12 0 2
					@A_スタン_初期設置 スタン d:ITEM_POS_04 0 10
					@A_Ｃ４_初期設置 Ｃ４ d:ITEM_POS_22 0 15

					@A_Ｍ９_初期設置 Ｍ９本体 d:ITEM_POS_14 0 なし 16
					@A_ＲＧＢ６_初期設置 ＲＧＢ６本体 d:ITEM_POS_05 0 なし 18
					@A_ＡＫＳ_初期設置 ＡＫＳ本体 d:ITEM_POS_25 0 なし 211

					@A_ＰＳＧ１－Ｔ_初期設置 ＰＳＧ１－Ｔ本体 d:ITEM_POS_31 0 なし 16
					@A_ＰＳＧ１_初期設置 ＰＳＧ１本体 d:ITEM_POS_20 0 なし 16
					@A_ニキータ_初期設置 ニキータ本体 d:ITEM_POS_32 0 なし 5

					@ソコムサプレッサ_初期設置 ソコムサプレッサ d:ITEM_POS_26 0
					@ＡＫサプレッサ_初期設置 ＡＫサプレッサ d:ITEM_POS_06 0
					
					@ジアゼパム_初期設置 ジアゼパム d:ITEM_POS_16 0

				} else {
					// スネーク
					@A_クレイモア_初期設置 クレイモア本体 d:ITEM_POS_27 0 10
					@A_チャフ_初期設置 チャフ d:ITEM_POS_29 0 1
					@A_スタン_初期設置 スタン d:ITEM_POS_04 0 10
					@A_Ｃ４_初期設置 Ｃ４ d:ITEM_POS_19 0 10

					@A_Ｍ９_初期設置 Ｍ９本体 d:ITEM_POS_25 0 なし 6
					@弾薬_Ｍ９_初期設置 Ｍ９弾 d:ITEM_POS_06 0
					@A_ＵＳＰ_初期設置 ＵＳＰ本体 d:ITEM_POS_23 0 なし 8
					@弾薬_ＵＳＰ_初期設置 ＵＳＰ弾 d:ITEM_POS_16 0
					@A_ＲＧＢ６_初期設置 ＲＧＢ６本体 d:ITEM_POS_12 0 なし 18
					@A_Ｍ４_初期設置 ＡＫＳ本体 d:ITEM_POS_14 0 なし 151

					@A_ＰＳＧ１－Ｔ_初期設置 ＰＳＧ１－Ｔ本体 d:ITEM_POS_32 0 なし 10
					@A_ＰＳＧ１_初期設置 ＰＳＧ１本体 d:ITEM_POS_05 0 なし 10
					@A_ニキータ_初期設置 ニキータ本体 d:ITEM_POS_31 0 なし 5

					@ＵＳＰサプレッサ_初期設置 ＵＳＰサプレッサ d:ITEM_POS_09 0
					
					@ジアゼパム_初期設置 ジアゼパム d:ITEM_POS_02 0
				}
			}

			// 主観ステージ３面
			default {
				if ( $s:選択プレイヤー == ライデン ) {
					@A_クレイモア_初期設置 クレイモア本体 d:ITEM_POS_33 0 15
					@A_チャフ_初期設置 チャフ d:ITEM_POS_12 0 2
					@A_スタン_初期設置 スタン d:ITEM_POS_07 0 10
					@A_Ｃ４_初期設置 Ｃ４ d:ITEM_POS_06 0 15

					@A_Ｍ９_初期設置 Ｍ９本体 d:ITEM_POS_10 0 なし 16
					@A_ＲＧＢ６_初期設置 ＲＧＢ６本体 d:ITEM_POS_23 0 なし 12
					@A_ＡＫＳ_初期設置 ＡＫＳ本体 d:ITEM_POS_05 0 なし 61

					@A_ＰＳＧ１－Ｔ_初期設置 ＰＳＧ１－Ｔ本体 d:ITEM_POS_30 0 なし 10
					@A_ＰＳＧ１_初期設置 ＰＳＧ１本体 d:ITEM_POS_20 0 なし 10
					@A_ニキータ_初期設置 ニキータ本体 d:ITEM_POS_32 0 なし 5

					@ソコムサプレッサ_初期設置 ソコムサプレッサ d:ITEM_POS_28 0
					@ＡＫサプレッサ_初期設置 ＡＫサプレッサ d:ITEM_POS_31 0
					
					@ジアゼパム_初期設置 ジアゼパム d:ITEM_POS_29 0
				} else {
					// スネーク
					@A_クレイモア_初期設置 クレイモア本体 d:ITEM_POS_05 0 10
					@A_チャフ_初期設置 チャフ d:ITEM_POS_24 0 1
					@A_スタン_初期設置 スタン d:ITEM_POS_10 0 10
					@A_Ｃ４_初期設置 Ｃ４ d:ITEM_POS_07 0 10

					@A_Ｍ９_初期設置 Ｍ９本体 d:ITEM_POS_06 0 なし 8
					@A_ＲＧＢ６_初期設置 ＲＧＢ６本体 d:ITEM_POS_12 0 なし 6
					@A_Ｍ４_初期設置 ＡＫＳ本体 d:ITEM_POS_19 0 なし 61

					@A_ＰＳＧ１－Ｔ_初期設置 ＰＳＧ１－Ｔ本体 d:ITEM_POS_32 0 なし 8
					@A_ＰＳＧ１_初期設置 ＰＳＧ１本体 d:ITEM_POS_29 0 なし 8
					@A_ニキータ_初期設置 ニキータ本体 d:ITEM_POS_30 0 なし 5

					@ＵＳＰサプレッサ_初期設置 ＵＳＰサプレッサ d:ITEM_POS_14 0
					
					@ジアゼパム_初期設置 ジアゼパム d:ITEM_POS_26 0
				}
			}
		}
	}



	// ------------------------------------
