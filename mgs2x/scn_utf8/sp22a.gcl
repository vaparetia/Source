// ------------------------------------
// マップ設定
// ------------------------------------
chara マップ 主観ステージ -k d:KMS_NAME -h d:HZX_NAME,0 -l $s:ＶＲライトファイル名

command マップ設定 主観ステージ -set {
	// ローカルの初期化
	// ------------------------------------
	@ローカル変数初期化		// ローカルで使用する変数で初期化をする場合はここで

	// ＶＲで必要な基本プロックのセット(vr_common.hで定義)
	// サウンドの基本パック、ＶＲの基本システム、プレイヤー、ゴール等を設定します
	// ※このプロックを使用する時は「ＶＲクリア時処理」というプロックが必要です
	// ＶＲ共通プロックセット	$:スネークファイル $:雷電ファイル $:クリア条件フラグ
	//							$:ゴールＸ $:ゴールＹ $:ゴールＺ $:タイマー初期値
	//	VR_GOAL_TARGET	/*的全滅でゴールが開く*/
	//	VR_GOAL_FREE	/*ゴールが最初から開いてる*/
	//	VR_GOAL_ENEMY	/*敵全滅でゴールが開く*/
	//	VR_GOAL_SNEAK	/*潜入モード中はゴールが開く*/
	//	VR_GOAL_TIME	/*タイマーがゼロになるとゴールが開く*/
	// ------------------------------------
	switch ( $b:ステージ番号 ) {
		// 主観ステージ２面
		case ( d:FPV_LV2_STAGE_NO ) {
			@ＶＲ共通プロックセット sna_sp22a rai_sp22a d:VR_GOAL_FREE d:GOAL_POS_SP22A

			// クリア時に呼ばれるものの設定
			@ＶＲクリア設定 p:load_sp23a p:A_ＲＥＴＲＹプロック
		}
		
		// 主観ステージ３面
		default {
			@ＶＲ共通プロックセット sna_sp22a rai_sp22a d:VR_GOAL_SCN d:GOAL_POS_SP23A

			// クリア時に呼ばれるものの設定
			@ＶＲクリア設定 p:load_sp24a p:A_ＲＥＴＲＹプロック
		}
	}


	// ＶＲウィンドウの設定
	// ------------------------------------
	@主観ステージＶＲウィンドウ設定

	// ステージに引かれるライン
	// ------------------------------------
	@ＶＲアウトライン d:KMS_NAME d:TONBO_KMS_NAME d:LINE_KMS_NAME

	// 設定値を変更する場合は以下のプロック内で設定
	// ------------------------------------
	@設定値変更				// 敵兵や的のパラメータをステージ限定で変える時はここで

	// プレイヤーの設定
	// ------------------------------------
	@プラグイン設定			// プレイヤーのプラグインがいる時はここで
	@ジャンプ設定

	// 敵兵・的関係の設定
	// ------------------------------------
	@コマンダー設定
	@監視カメラ設置

	// ＢＧＭの設定(プレイヤー→敵兵→BGMの順で呼ぶ)
	// ------------------------------------
	@ＢＧＭ設定

	// アイテムの設定
	// ------------------------------------
	@アイテム設定

	// 光源、オブジェクト、カメラ関連の設定
	// ------------------------------------
	@ＶＲフォグ設定 -10000 70000 -13000 67000 -26000 65000
	@カメラセット					// chara カメラとベースのカメラを設定
	@ＶＲキャラ用ライト設置				// 必ず最後に設定
#if d:DEBUG_CHARA
//	@デバッグキャラセット
#endif
}

//初期マップの表示
command マップ表示 -show 主観ステージ


// 各proc設定
//-------------------------------------------------------------------------------------
// 全マップ共通
	//------------------------------------------------------------
	// ＶＲウィンドウの設定と表示
	//------------------------------------------------------------
	proc 主観ステージＶＲウィンドウ設定 {
		#if d:DEBUG_PRINT
			print 'vr_window_set'
		#endif

		// スタート時とクリア時に使用するカットインカメラ
		chara カメラ カットインカメラ		-c 0 -l 0 -p  0

		switch ( $b:ステージ番号 ) {
			// 主観ステージ２面
			case ( d:FPV_LV2_STAGE_NO ) {
				@ＶＲウィンドウ設定	d:SP22A_WINDOW_RES

				// スタート時のカメラ(必要な場合)
				chara カメラ設定 カットインカメラ \
					-c 1 \	
					-p -5500,6715,-54399 -t -5500,-685,-59594 \
					-r 625,2048,0 -f 9041 \
					-a 200 \
					-i 0 -1 0 0 \
					-s 1
			}

			// 主観ステージ３面
			default {
				@ＶＲウィンドウ設定	d:SP23A_WINDOW_RES

				// スタート時のカメラ(必要な場合)
				chara カメラ設定 カットインカメラ \
					-c 1 \	
					-p -542,5885,-4317 -t -502,1906,-1289 \
					-r 600,0,0 -f 5000 \
					-a 200 \
					-i 0 -1 0 0 \
					-s 1
			}
		}

		// ＶＲウィンドウを表示する
		mesg ＶＲウィンドウ ＶＲウィンドウ君 開く
	}

	//------------------------------------------------------------
	// ステージ開始時処理
	//------------------------------------------------------------
	proc ＶＲステージ開始時処理 {
		#if d:DEBUG_PRINT
			print 'game_start!!!!!'
		#endif

		// プレイヤーやパッドの制御等を行う a_stdproc.hで定義
		@全ミッション共通ステージ開始時処理

		// カメラワークスタート(必要な場合)
		switch ( $b:ステージ番号 ) {
			// 主観ステージ２面
			case ( d:FPV_LV2_STAGE_NO ) {
				// 全体図
				chara カメラ設定 カットインカメラ \
					-c 1 \	
					-p -5356,67517,11584 -t -5356,66523,11043 \
					-r 699,2048,0 -f 1131 \
					-a 200 \
					-i 4 4 d:START_CAMERA_CHANGE_TIME d:START_CAMERA_CHANGE_TIME \
					-s 1
			}

			// 主観ステージ３面
			default {
				// 全体図
				chara カメラ設定 カットインカメラ \
					-c 1 \	
					-p -410,61271,-75897 -t -390,57129,-73093 \
					-r 636,0,0 -f 5002 \
					-a 200 \
					-i 4 4 d:START_CAMERA_CHANGE_TIME d:START_CAMERA_CHANGE_TIME \
					-s 1
			}
		}

		chara delay ディレイ \
			-time d:START_CAMERA_CHANGE_TIME \
			-exec {
				chara カメラ設定 カットインカメラ -s -1
			}
	}


	// ------------------------------------
	// クリア時の処理
	// ------------------------------------
	proc ＶＲクリア時処理 {
		#if d:DEBUG_PRINT 
			print 'clear'
		#endif

		// 強制モーションを発動
		switch ( $b:ステージ番号 ) {
			// 主観ステージ２面
			case ( d:FPV_LV2_STAGE_NO ) {
				@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_1 2048

				// クリア時にカメラアングルを変える
				chara カメラ設定 クリア時カメラ \
					-c 1 \	
					-p -5697,1086,-62407 -t -5216,1261,-57678 \
					-r -24,66,0 -f 4757 \
					-a 160 \
					-i 1 1 0 0 \
					-s 1
			}

			// 主観ステージ３面
			default {
				@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_1 0

				// クリア時にカメラアングルを変える
				chara カメラ設定 クリア時カメラ \
					-c 1 \	
					-p 97,749,4124 -t -731,1405,-38 \
					-r -100,2176,0 -f 4294 \
					-a 160 \
					-i 1 1 0 0 \
					-s 1
			}
		}
	}



	// ------------------------------------
	// パラメータ系の変更
	// ------------------------------------
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT 
			print 'localvar_init'
		#endif
	}
	
	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT 
			print 'status_set'
		#endif

		switch ( $b:ステージ番号 ) {
			// 主観ステージ２面
			case ( d:FPV_LV2_STAGE_NO ) {
				if ( $s:選択プレイヤー == ライデン ) {
					$w:武器弾数Ｒ[d:武器:ソコム] = 61;
					$w:武器 = d:武器:ソコム;
				} else {
					// スネーク
					$w:武器 = d:武器:素手;
				}
			}

			// 主観ステージ３面
			default {
				command メニュー設定 -node_access off

				if ( $s:選択プレイヤー == ライデン ) {
					$w:武器弾数Ｒ[d:武器:ソコム] = 25;
					$w:武器 = d:武器:ソコム;
				} else {
					$w:武器弾数Ｒ[d:武器:ＵＳＰ] = 16;
					$w:武器 = d:武器:ＵＳＰ;
				}
			}
		}

		$w:アイテム = d:アイテム:素手;
	}



	// ------------------------------------
	// プレイヤーに関する設定
	//-------------------------------------
	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif

		command プラグイン自動ジャンプ
	}
	//-------------------------------------
	// 台登り
	// ------------------------------------
	proc ジャンプ設定 {
		#if d:DEBUG_PRINT
			print 'jump_set'
		#endif

		trap ky001 d:PLAYER \
			-mask 入る \
			-exec {
				@ジャンプ発動 ky001 1000 10
			}
	}



	// ------------------------------------
	// 敵兵や的の処理
	// ------------------------------------
	// 敵兵に関する設定
	//-------------------------------------
	proc 警備兵セット_２面 {
		#if d:DEBUG_PRINT 
			print 'watcher_set'
		#endif

		switch ( $s:選択プレイヤー ) {
			// ライデン
			case ( ライデン) {
				@VR_警備兵 敵兵:01 d:E_R:２面雷電Ｒ１ 0 d:ENE_STATUS_SP22A -5000 0 -57000 主観ステージ
				@VR_警備兵 敵兵:02 d:E_R:２面雷電Ｒ２ 0 d:ENE_STATUS_SP22A -6000 1000 -47000 主観ステージ
				@VR_警備兵 敵兵:03 d:E_R:２面雷電Ｒ３ 0 d:ENE_STATUS_SP22A -9000 0 -44000 主観ステージ
				@VR_警備兵 敵兵:04 d:E_R:２面雷電Ｒ４ 0 d:ENE_STATUS_SP22A 6000 1000 -49000 主観ステージ
				@VR_警備兵 敵兵:05 d:E_R:２面雷電Ｒ５ 0 d:ENE_STATUS_SP22A 5000 0 -33000 主観ステージ
			}

			// スネーク
			default {
				@VR_警備兵 敵兵:01 d:E_R:２面スネークＲ１ 0 d:ENE_STATUS_SP22A -5000 0 -57000 主観ステージ
				@VR_警備兵 敵兵:02 d:E_R:２面スネークＲ２ 0 d:ENE_STATUS_SP22A -6000 1000 -47000 主観ステージ
				@VR_警備兵 敵兵:03 d:E_R:２面スネークＲ３ 0 d:ENE_STATUS_SP22A -16000 -1000 -56000 主観ステージ
				@VR_警備兵 敵兵:04 d:E_R:２面スネークＲ４ 0 d:ENE_STATUS_SP22A -9000 0 -44000 主観ステージ
				@VR_警備兵 敵兵:05 d:E_R:２面スネークＲ５ 0 d:ENE_STATUS_SP22A 5000 0 -33000 主観ステージ
				@VR_警備兵 敵兵:06 d:E_R:２面スネークＲ６ 0 d:ENE_STATUS_SP22A 11000 0 -39000 主観ステージ
				@VR_警備兵 敵兵:07 d:E_R:２面スネークＲ７ 0 d:ENE_STATUS_SP22A -3000 -1000 -26000 主観ステージ
			}
		}
	}

	proc 警備兵セット_３面 {
		#if d:DEBUG_PRINT 
			print 'watcher_set'
		#endif

		switch ( $s:選択プレイヤー ) {
			// ライデン
			case ( ライデン) {
				@VR_拡張警備兵 敵兵:01 d:E_R:３面雷電Ｒ１ 0 d:ENE_STATUS_SP23A -500 0 -10000 主観ステージ
				@VR_拡張警備兵 敵兵:02 d:E_R:３面雷電Ｒ２ 0 d:ENE_STATUS_SP23A -9500 0 -43500 主観ステージ
				@VR_拡張警備兵 敵兵:03 d:E_R:３面雷電Ｒ３ 0 d:ENE_STATUS_SP23A -4500 -1000 -15000 主観ステージ
				@VR_拡張警備兵 敵兵:04 d:E_R:３面雷電Ｒ４ 0 d:ENE_STATUS_SP23A 1500 0 -3500 主観ステージ
				@VR_拡張警備兵 敵兵:05 d:E_R:３面雷電Ｒ５ 0 d:ENE_STATUS_SP23A 6000 1000 -49000 主観ステージ
				@VR_拡張警備兵 敵兵:06 d:E_R:３面雷電Ｒ６ 0 d:ENE_STATUS_SP23A 11000 0 -39000 主観ステージ
			}

			// スネーク
			default {
				@VR_拡張警備兵 敵兵:01 d:E_R:３面スネークＲ１ 0 d:ENE_STATUS_SP23A 2500 2000 -24500 主観ステージ
				@VR_拡張警備兵 敵兵:02 d:E_R:３面スネークＲ２ 0 d:ENE_STATUS_SP23A -9000 0 -44000 主観ステージ
				@VR_拡張警備兵 敵兵:03 d:E_R:３面スネークＲ３ 0 d:ENE_STATUS_SP23A -8500 0 -32500 主観ステージ
				@VR_拡張警備兵 敵兵:04 d:E_R:３面スネークＲ４ 0 d:ENE_STATUS_SP23A -4500 -1000 -24500 主観ステージ
				@VR_拡張警備兵 敵兵:05 d:E_R:３面スネークＲ５ 0 d:ENE_STATUS_SP23A -500 0 -10000 主観ステージ
				@VR_拡張警備兵 敵兵:06 d:E_R:３面スネークＲ６ 0 d:ENE_STATUS_SP23A_S 1500 0 -4500 主観ステージ
				@VR_拡張警備兵 敵兵:07 d:E_R:３面スネークＲ７ 0 d:ENE_STATUS_SP23A_S 11500 1000 -32500 主観ステージ
				@VR_拡張警備兵 敵兵:08 d:E_R:３面スネークＲ８ 0 d:ENE_STATUS_SP23A 500 2000 -39000 主観ステージ
			}
		}
	}


	proc 攻撃兵セット_２面 {
		#if d:DEBUG_PRINT 
			print 'attacker_set'
		#endif

		switch ( $s:選択プレイヤー ) {
			// ライデン
			case ( ライデン) {
				// VR_探索攻撃兵 $:名前 $:ルート $:ステータス $:装備 $:探索ルート
				// VR_サポート攻撃兵 $:名前 $:ルート $:ステータス $:装備 $:サポートする敵兵名
				@VR_攻撃兵 敵兵:11 d:E_R:２面待機Ｐ d:ENE_STATUS_SP22A d:ENE_EQUIP_TYPE_SHIELD
				@VR_探索攻撃兵 敵兵:12 d:E_R:２面待機Ｐ d:ENE_STATUS_SP22A d:ENE_EQUIP_TYPE_NORMAL d:E_R:２面雷電追加Ｒ２
				@VR_探索攻撃兵 敵兵:13 d:E_R:２面待機Ｐ d:ENE_STATUS_SP22A d:ENE_EQUIP_TYPE_NORMAL d:E_R:２面雷電追加Ｒ１
				@VR_攻撃兵 敵兵:14 d:E_R:２面待機Ｐ d:ENE_STATUS_SP22A d:ENE_EQUIP_TYPE_SHOTGUN
			}
			
			// スネーク
			default {
				// VR_探索攻撃兵 $:名前 $:ルート $:ステータス $:装備 $:探索ルート
				// VR_サポート攻撃兵 $:名前 $:ルート $:ステータス $:装備 $:サポートする敵兵名
				@VR_攻撃兵 敵兵:11 d:E_R:２面待機Ｐ d:ENE_STATUS_SP22A d:ENE_EQUIP_TYPE_SHIELD
				@VR_サポート攻撃兵 敵兵:12 d:E_R:２面待機Ｐ d:ENE_STATUS_SP22A d:ENE_EQUIP_TYPE_NORMAL 敵兵:05
				@VR_サポート攻撃兵 敵兵:13 d:E_R:２面待機Ｐ d:ENE_STATUS_SP22A d:ENE_EQUIP_TYPE_NORMAL 敵兵:04
				@VR_攻撃兵 敵兵:14 d:E_R:２面待機Ｐ d:ENE_STATUS_SP22A d:ENE_EQUIP_TYPE_SHOTGUN
			}
		}
	}

	proc 攻撃兵セット_３面 {
		#if d:DEBUG_PRINT 
			print 'attacker_set'
		#endif

		switch ( $s:選択プレイヤー ) {
			// ライデン
