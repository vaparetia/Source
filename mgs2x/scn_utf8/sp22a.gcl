	２面雷電Ｒ１,
	２面雷電Ｒ２,
	２面雷電Ｒ３,
	２面雷電Ｒ４,
	２面雷電Ｒ５,
	２面雷電追加Ｒ１,
	２面雷電追加Ｒ２,
	２面スネークＲ１,
	２面スネークＲ２,
	２面スネークＲ３,
	２面スネークＲ４,
	２面スネークＲ５,
	２面スネークＲ６,
	２面スネークＲ７,
	３面待機Ｐ,
	３面雷電Ｒ１,
	３面雷電Ｒ２,
	３面雷電Ｒ３,
	３面雷電Ｒ４,
	３面雷電Ｒ５,
	３面雷電Ｒ６,
	３面スネークＲ１,
	３面スネークＲ２,
	３面スネークＲ３,
	３面スネークＲ４,
	３面スネークＲ５,
	３面スネークＲ６,
	３面スネークＲ７,
	３面スネークＲ８
}

#define ENE_STATUS_SP22A	d:ENE_STATUS_NORMAL							// 主観ステージ２面敵兵用共通ステータス
#define ENE_STATUS_SP23A	d:ENE_STATUS_NORMAL d:ENE_STST_FAINT_EXIT	// 主観ステージ３面警備兵用共通ステータス
#define ENE_STATUS_SP23A_S	d:ENE_STATUS_NORMAL (d:ENE_STST_OPTCAMOUFLAGE | d:ENE_STST_FAINT_EXIT)	// ３面ステルス兵ステータス
#define ENE_STATUS_SP23A_A	d:ENE_STATUS_NORMAL							// 主観ステージ３面攻撃兵用共通ステータス



