							[VRMSG_F:VRM_FPV_sp23a] [VRMSG_I:VRM_FPV_sp23a] [VRMSG_S:VRM_FPV_sp23a] \		// 仏、伊、西
							[VRMSG_K:VRM_FPV_sp23a] \															// 韓
							p:ＶＲステージ開始時処理	// 終了プロック


