#define STAGE_N_TITLE		1

#ifdef d:FIX_MODE
	#define		USB_KEY			0		// USBキーボード
#else
	#define		USB_KEY			0		// USBキーボード
#endif




// command	フォント初期化


//#include "stdch.h"
#include "vardef.h"

#include "sload.h"
#include "sound.h"

#if d:USB_KEY
	#include "usbkbd.h"
#endif

#define	SCREEN_SHOOT	0

#ifdef d:AREA_JAPAN 
	/* 日本版はコナミロゴにＲがつかない、ＣＥＳＡ表示あり */
	#define LOGO_KONAMI			logo_konami
#else
	/* 海外はコナミロゴにＲがつく、ＣＥＳＡ表示なし */
	#define LOGO_KONAMI			logo_konami_r
#endif

#include "n_title_multi.rsc"
#include "varinit.h"
#include "lowpoly.h"

proc MOVIE_END {
	eval( $b:タイトルステップ = 2 );
	restart;
}

proc game_select3_restart {
	$f:game_select3_restart_flag = 1;
	restart;
}

	if( $f:game_select3_restart_flag ){
		$f:game_select3_restart_flag = 0;
		chara 2Dレイアウトドライバ ２Ｄドライバ
		mesg サウンドマネージャー ＳＤマネ SD_CODE d:SNG_PLAY_01
		@game_select3
	} else if( $f:ローポリ劇場フラグ == d:TRUE ){
		eval ($f:ローポリ劇場フラグ = d:FALSE);

		chara 2Dレイアウトドライバ ２Ｄドライバ

		@ローポリ劇場選択画面スタート２

	} else if( $f:ボスサバイバルフラグ == d:TRUE ){
		eval ( $f:ボスサバイバルフラグ = d:FALSE );
		chara 2Dレイアウトドライバ ２Ｄドライバ
		@ボスラッシュ選択画面スタート２

	} else if( $f:ミッションズフラグ == d:TRUE || $f:スネークテイルズフラグ == d:TRUE ){
		chara 2Dレイアウトドライバ ２Ｄドライバ
		mesg サウンドマネージャー ＳＤマネ SD_CODE d:SNG_PLAY_01
		@game_select2

	} else if( $f:スケート戻り値 ){
		chara 2Dレイアウトドライバ ２Ｄドライバ
//		mesg サウンドマネージャー ＳＤマネ SD_CODE d:SNG_PLAY_01
		// クリアフラグを元に戻す
		chara セーブファイル個数チェック 警告！！！ \
			-p game_select3_restart
	} else if( $b:タイトルステップ == 0 ){
		// メモリーカードチェック～CIロゴ
		chara 2Dレイアウトドライバ ２Ｄドライバ
#if 1
	#ifdef d:TGS2001F || d:EU_TRIAL
		@title_start
	#else
		chara メモリーカード警告画面 警告！！！ \
		#ifndef _XBOX
		#ifndef AREA_EU
			-d start_warning \
		#endif
		#endif
			-p title_start
	#endif
#else
		chara セーブゲーム画面マネージャー 画面テスト \
			-d save_load \
			-p title_start \
			-i tnkicon
#endif
	} else if( $b:タイトルステップ == 1 ){
		// ムービー再生
		chara MOVIE再生 opening -file t:opening -top 0, d:MOVIE_TOP_Y -size 512, 320 \
			-proc MOVIE_END -x
	} else if( $b:タイトルステップ == 2 ){
		// タイトル
		chara 2Dレイアウトドライバ ２Ｄドライバ

		print 'タイトル画面表示'
		@タイトル画面表示;
	}

	#if d:SCREEN_SHOOT
		chara スクリーンショット スクリーンショット
	#endif

	@サウンド設定

	#ifdef JAPANESE
		command 字幕制御 -y 348
	#else
		command 字幕制御 -y 400
	#endif

/***************************************************************************************************/
// タイトルループ
/***************************************************************************************************/
	proc title_start {
		/* 2001/8/9  Ken Kano
		   タイトルにスネークとライデンの顔がアップで出てくる
		   その際、プラント編をクリアしている時だけライデンの顔を出す */
	#if 0
		if($w:タイトルメニュー設定 & d:TITLE_MENU_PLANT_CLEARD){
			eval ($w:顔フラグ = 1);
		} else {
			eval ($w:顔フラグ = 0);
		}
	#else
		if($w:タイトルメニュー設定 & d:TITLE_MENU_PLANT_CLEARD){
			eval ($w:顔フラグ = $w:顔フラグ ^ 1);
		}
	#endif

	#ifdef d:AREA_JAPAN
		/* 日本版のみＣＥＳＡ表示が入る */
		@ＣＥＳＡ＿ＳＯＮＹ表示
	#else
		@コナミ表示 0
	#endif
	}

	proc ＣＥＳＡ＿ＳＯＮＹ表示 {
		print 'ＣＥＳＡ＿ＳＯＮＹ警告文表示'
		chara コナミロゴ表示 ＣＥＳＡ警告文 \
			-p コナミ表示 \
			-t 64 120 64 \
			-b caution \			// ＴＲＩファイル名
			   sce_cesa_attention	// テクスチャ名
	}

	proc コナミ表示 $:返り値 {
		if( ($:返り値 != 0) && ($w:タイトルメニュー設定 & d:TITLE_MENU_DISPED_WARNING_VIOLENCE ) ){
			print 'タイトル画面へ'
			@タイトル画面表示
		} else {
			print 'コナミ表示'
			chara コナミロゴ表示 コナミロゴ \
				-p ＫＣＥＪロゴ表示チェック \
				-t 64 120 64 \
				-b logo \				// ＴＲＩファイル名
				   d:LOGO_KONAMI		// テクスチャ名
		}
	}

	proc ＫＣＥＪロゴ表示チェック $:返り値 {
		print 'ＫＣＥＪロゴ表示チェック'
		if( $:返り値 == 0 ){
			/* 通常終了 */
			print 'ＫＣＥＪロゴ表示'
			@ＫＣＥＪロゴ表示
		} else {
			print 'キャンセル タイトルへ'
			@タイトル画面表示
		}
	}

/***************************************************************************************************/
// ＫＣＥＪロゴ表示
/***************************************************************************************************/
	proc ＫＣＥＪロゴ表示 {
		chara コナミロゴ表示 ＫＣＥＪロゴ \
			-p デモ起動チェック \
			-t 64 120 64 \
			-b logo \			// ＴＲＩファイル名
//			   logo_japan		// テクスチャ名
			   kcej_logo_alp_ovl
	}

	proc デモ起動チェック $:返り値 {
		#ifdef d:TGS2001F || d:EU_TRIAL
			chara delay ＴＧＳタイトル表示ディレイ -time 60 -exec {
				print 'ＴＧＳ版はデモを飛ばしてタイトルへ'
				@タイトル画面表示
			}
		#else
			if( $:返り値 == 0 ){
				print 'オープニングデモ起動'
				/* 通常終了 */
				@デモ起動ディレイ

			} else {
				print 'タイトル画面へ'
				@タイトル画面表示
			}
		#endif
	}

	proc デモ起動ディレイ {
		chara delay タイトル表示ディレイ -time 60 -exec {
			@デモスタート
		}
	}


	proc デモスタート {
		#if 0
			chara select name -s {
				'OPENING MOVIE' タイトル画面表示
			}
		#else
			eval( $b:タイトルステップ = 1 );
			restart
		#endif
	}


	proc タイトル表示 {
		chara delay タイトル表示ディレイ -time 60 -exec {
			@タイトル画面表示
		}
	}

/***************************************************************************************************/
// タイトル画面表示
/***************************************************************************************************/
	proc タイトル画面表示 {
		if ( !($w:タイトルメニュー設定 & d:TITLE_MENU_DISPED_WARNING_VIOLENCE ) ){
			print 'デモループ一回終了'
			eval( $w:タイトルメニュー設定 = $w:タイトルメニュー設定 | d:TITLE_MENU_DISPED_WARNING_VIOLENCE )
		}
		chara ノード画面バックグラウンド バックグラウンド
		@タイトル画面起動
		print 'ソングスタート'
		mesg サウンドマネージャー ＳＤマネ SD_CODE d:SNG_PLAY_01
	}

	proc タイトル画面起動 {
		chara タイトル画面マネージャー タイトル画面 \
			-d title_logo title_face \
			-p タイトル画面終了 \
			-b バックグラウンド \
			-f $w:顔フラグ
	}

	proc タイトル画面終了 $:返り値 {
		if( $:返り値 == 0 ){
			#ifdef d:TGS2001F
				@ＴＧＳ２００１Ｆゲームスタート
			#else
#ifdef XBOX
#ifdef AREA_EU
				@警告画面表示
#else
				@game_select
#endif
#else
				@game_select
#endif
			#endif
		} else {
			command セットサウンドコード -c d:SNG_FOUTS_S
			@mgs2_title
		}
	}

#ifdef XBOX
#ifdef AREA_EU
	proc 警告画面表示 {
		chara メモリーカード警告画面 警告！！！ \
			-d start_warning \
			-p game_select
	}
#endif
#endif

	// MGS2 TITLE
	proc mgs2_title {
		// KCEJロゴまで戻る

		mesg ノード画面バックグラウンド バックグラウンド kill

#if 0
		/* 2001/8/9  Ken Kano
		   タイトルにスネークとライデンの顔がアップで出てくる
		   その際、プラント編をクリアしている時だけライデンの顔を出す */
#if 1
		if($w:タイトルメニュー設定 & d:TITLE_MENU_PLANT_CLEARD){
			eval ($w:顔フラグ = $w:顔フラグ ^ 1);
		}
#else
		eval ($w:顔フラグ = $w:顔フラグ ^ 1);
#endif
#endif

		eval( $b:タイトルステップ = 0 );
		restart
	}

/***************************************************************************************************/
// ゲームセレクト
/***************************************************************************************************/
	proc game_select {
		chara ノード画面フレームアニメーション ノードフレーム \
			-d node_frame \
			-b バックグラウンド

		chara ゲームセレクト画面マネージャー ゲームセレクト画面 \
			-d title_menu \
			-p ゲームセレクト画面プロシージャー \
			-b バックグラウンド
	}

	/* MISSIONS,SNAKE_TALESから戻ってきた時に呼ばれる */
	proc game_select2 {
		chara ノード画面バックグラウンド バックグラウンド

		chara ノード画面フレームアニメーション ノードフレーム \
			-d node_frame \
			-b バックグラウンド

		if( $f:ミッションズフラグ == d:TRUE ){
			/* MISSIONSから帰ってきた */
			$b:ミッション／テイルズ = 2;
		} else {
			/* SNAKE_TALESから帰ってきた */
			$b:ミッション／テイルズ = 3;
		}			
		chara ゲームセレクト画面マネージャー ゲームセレクト画面 \
			-d title_menu \
			-p ゲームセレクト画面プロシージャー \
			-b バックグラウンド \
			-s $b:ミッション／テイルズ

		eval ( $f:ミッションズフラグ = d:FALSE );
		eval ( $f:スネークテイルズフラグ = d:FALSE );
	}
	/* SKATE */
	proc game_select3 {
		chara ノード画面バックグラウンド バックグラウンド

		chara ノード画面フレームアニメーション ノードフレーム \
			-d node_frame \
			-b バックグラウンド

		chara ゲームセレクト画面マネージャー ゲームセレクト画面 \
			-d title_menu \
			-p ゲームセレクト画面プロシージャー \
			-b バックグラウンド \
			-s 4
		$f:スケート戻り値 = 0;
	}

	proc ゲームセレクト画面プロシージャー $:モード \
												$:引数１ \ // 1ST_PLAY TANKER PLANT T&P
												$:引数２ \ // 難易度
												$:引数３ \ // 見つかりモード
												$:引数４ \ // アンケート結果
												$:引数５ \
	{
		if( $:モード == -1 ){
			// 終了
			mesg ノード画面フレームアニメーション ノードフレーム kill

			@タイトル画面起動
		} else if( $:モード == 0 ){
			// ゲームセレクト
			if( $:引数１ == 1 ){
				// ロードゲームの起動
				@load_game
			} else if( $:引数１ == 2 ){
				// オプションの起動
				@sel_option
			} else if( $:引数１ == 3 ){
				// スペシャルモードの起動
				eval($b:スペシャルモードのスタートカーソル位置 = 0);
				@special_scr
			} else if( $:引数１ == 4 ){
				// MISSIONS
				@load_VR 
			} else if( $:引数１ == 5 ){
				// スネークテイルズ
				@load_snake_tales
			} else if( $:引数１ == 6 ) {
				// スケートボード
				@load_skate_board
			}

		} else if( $:モード == 1 ){
			// ニューゲーム

			// このプレイでタンカーをクリアしたこと表すフラグを消去
			eval( $w:コンフィグ設定 = $w:コンフィグ設定 & ~d:CONFIG_TANKER_CLEARED );

			// ゲームモードの設定
			if( $:引数１ == 0 ){
				print '１ＳＴプレイ'

				if( $:引数４ <= 2 ) {
					print '１ＳＴプレイ タンカープラント'
					eval( $s:global_ゲームモード = タンカープラント )
				} else {
					print '１ＳＴプレイ プラント編'
					eval( $s:global_ゲームモード = プラント編 )
				}
			} else if( $:引数１ == 1 ){
				print 'タンカー編'
				eval( $s:global_ゲームモード = タンカー編 )
			} else if( $:引数１ == 2 ){
				print 'プラント編'
				eval( $s:global_ゲームモード = プラント編 )
			} else if( $:引数１ == 3 ){
				print 'タンカープラント'
				eval( $s:global_ゲームモード = タンカープラント )
			}

			// ゲーム難易度の設定
			eval( $b:n_title_ゲーム難易度 = ( $:引数２ + 1 ) * 10 )

			// 見つかりモード
			if( $:引数３ == 0 ){
				eval( $f:title_discover = d:TRUE )
			} else {
				eval( $f:title_discover = d:FALSE )
			}

			if( $5 < 0 ) {
				command セットサウンドコード -c d:SNG_FOUTS_S
				@１周目フィクション表記
			} else {
				command セットサウンドコード -c d:SNG_FOUTS_S
				chara delay アクションレベル決定ディレイ -time 60 -exec {
					command Stream t:vc126102 -p １周目フィクション表記 //-w
				}
			}

		} else if( $:モード == 2 ){
			// ロードゲーム
		} else if( $:モード == 3 ){
			// オプション
		} else if( $:モード == 4 ){
			// スペシャル
		} else if( $:モード == 5 ){
			// ハードディスクインストール
		}
	}

/***************************************************************************************************/
// ロードゲーム
/***************************************************************************************************/
	proc load_game {

#if 0
		chara select name -s {
			'LOAD GAME   return title loop'		コナミ表示
		}
#elif 1
	
		chara ロードゲーム画面マネージャー ロードゲーム画面起動 \
			-d save_load \
			-p ロードゲーム終了プロシージャー \
			-b バックグラウンド //\

#else
		chara メモリーカードセーブロード画面 ロードゲーム画面起動 \
			-m 0 \
			-p ロードゲーム終了プロシージャー
#endif

	}

	proc ロードゲーム終了プロシージャー $:返り値 {
		if( $:返り値 == 1 ){
			// ロード完了
#if 1
			eval ( $w:スタートアラートモード = d:ALERT_MODE_SENNYU );
			command varsave $w:スタートアラートモード ;
			eval ( $w:現ステージ番号 = `%save_var_read $w:現ステージ番号` );


			if( $w:現ステージ番号 == d:ステージ名:タンカー編クリア || \
				$w:現ステージ番号 == d:ステージ名:プラント編クリア ){

				@二周目スタート選択画面
			}else{
				@ロードリスタート
			}
#else
			// @二周目スタート選択画面
			@ロードリスタート
#endif
		} else {
			// ロードせずに終了
			mesg ゲームセレクト画面マネージャー ゲームセレクト画面 ret_by_cancel
		}
	}

	proc ロードリスタート {
		mesg ノード画面フレームアニメーション ノードフレーム kill
		mesg ノード画面バックグラウンド バックグラウンド kill

		command セットサウンドコード -c d:SNG_FOUTS_S

		//野尻が追加しました。
		eval($w:タイトルメニュー設定 = \
			 ($w:タイトルメニュー設定 | d:TITLE_MENU_START_FROM_LOAD));

		// ADD M.Kobayashi 2002/08/21
		if ( ($w:タイトルメニュー設定 & d:TITLE_MENU_OPTION_CHANGED) \
			&& !( $w:コンフィグ設定 & d:CONFIG_RADAR_OFF ) ){
			// オプションでレーダーをＯＮにしてロードした
			// ->レーダーを使ったことにする
			$w:クリアーコードフラグ = `%save_var_read $w:クリアーコードフラグ`;
		 	$w:クリアーコードフラグ = $w:クリアーコードフラグ | d:CLEAR_RADAR_USED;
			command varsave $w:クリアーコードフラグ;
			print 'CLEAR_RADAR_USED が立った。'
		}
		$w:クリアーコードフラグ = `%save_var_read $w:クリアーコードフラグ`;
		print 'クリアーコードフラグ' $w:クリアーコードフラグ
	
		// 2001/8/23 K.Kano
		if ( `%現在の秒単位時間` - `%ロードデータの秒単位タイムスタンプ` > 604800 ) {
			// 一週間以上経っている場合

			eval ( $w:プレイヤーフラグ = `%save_var_read $w:プレイヤーフラグ` );
			eval ( $w:プレイヤーフラグ = \
				   $w:プレイヤーフラグ & ~d:PL_GAVE_SHAVER_TO_SNAKE );
			command varsave $w:プレイヤーフラグ
		}

print 'LOAD END'
		// この時点では、変数セーブ領域にのみロードされている
		// この次の load_restartで変数が戻されるので、
		// それまでにvarsaveすれば、OK
		chara delay 終了ディレイ -time 1 -exec {	// サウンドマネージャーが死ぬ前にメッセージを送るため
			command load_restart
		}
	}

	proc 二周目スタート選択画面 {
		chara クリアデータロード後のゲーム開始画面 二周目選択画面 \
			-d title_menu \
			-p 二周目スタート選択画面終了 \
			-b バックグラウンド
	}

	proc 二周目スタート選択画面終了 $:返り値 $:引数１ $:引数２ $:引数３ $:引数４ $:引数５ {
		if( $:返り値 != 0 ){
			// ADD M.Kobayashi 2002/09/13
			// レーダー設定は今設定されたやつを使う
			$w:コンフィグ設定 = (`%save_var_read $w:コンフィグ設定` & (d:CONFIG_RADAR_OFF | d:CONFIG_RADAR_OFF_INTRUDE) ) \
								| ( $w:コンフィグ設定 & ~(d:CONFIG_RADAR_OFF | d:CONFIG_RADAR_OFF_INTRUDE) );

			command store_loadedvar

//			eval( $w:コンフィグ設定 = `%save_var_read $w:コンフィグ設定` );
			eval( $s:global_ゲームモード = `%save_var_read $s:global_ゲームモード` );
			eval( $b:n_title_ゲーム難易度 = `%save_var_read $b:n_title_ゲーム難易度` );
			eval( $f:title_discover = `%save_var_read $f:title_discover` );

			// このプレイでタンカーをクリアしたこと表すフラグを消去
			eval( $w:コンフィグ設定 = $w:コンフィグ設定 & ~d:CONFIG_TANKER_CLEARED );

			// ゲームモードの設定
			if( $:引数１ == 0 ){
				print 'タンカープラント'
				eval( $s:global_ゲームモード = タンカープラント )
			} else if( $:引数１ == 1 ){
				print 'タンカー編'
				eval( $s:global_ゲームモード = タンカー編 )
			} else if( $:引数１ == 2 ){
				print 'プラント編'
				eval( $s:global_ゲームモード = プラント編 )
			} else if( $:引数１ == 3 ){
				print 'タンカープラント'
				eval( $s:global_ゲームモード = タンカープラント )
			}

			// ゲーム難易度の設定
			eval( $b:n_title_ゲーム難易度 = ( $:引数２ + 1 ) * 10 )

			// 見つかりモード
			if( $:引数３ == 0 ){
				eval( $f:title_discover = d:TRUE )
			} else {
				eval( $f:title_discover = d:FALSE )
			}

			command varsave $w:コンフィグ設定
			command varsave $s:global_ゲームモード
			command varsave $b:n_title_ゲーム難易度
			command varsave $f:title_discover

			command セットサウンドコード -c d:SNG_FOUTS_S

			//@二周目スタート
			@二周目用フィクション表記
		} else {
			@load_game
		}
	}

/***************************************************************************************************/
// オプション
/***************************************************************************************************/

	proc sel_option {
		chara オプション画面マネージャー オプション画面 \
			-d node_menu \
			-p オプション終了プロシージャー \
			-b バックグラウンド \
#ifdef d:AREA_US
			-n 	1 \
			-l 	1 \ 
#elseifdef d:AREA_EU
			-n 	5 \
			-l 	1 2 3 4 5 \
#elseifdef d:AREA_JAPAN
			-n 	2 \
			-l	7 1 \
#endif
			-r 	オプションの説明英語 		レーダーの説明英語 			クイックチェンジの説明英語 		 \
				オプションの説明フランス語 	レーダーの説明フランス語	クイックチェンジの説明フランス語 \
				オプションの説明ドイツ語 	レーダーの説明ドイツ語 		クイックチェンジの説明ドイツ語 	 \
				オプションの説明イタリア語 	レーダーの説明イタリア語 	クイックチェンジの説明イタリア語 \
				オプションの説明スペイン語 	レーダーの説明スペイン語 	クイックチェンジの説明スペイン語 \
				0 0 0 \ //韓国語
				オプションの説明日本語 		レーダーの説明日本語 		クイックチェンジの説明日本語 	 
	}

	proc オプション終了プロシージャー {
		// オプションの終了
		mesg ゲームセレクト画面マネージャー ゲームセレクト画面 ret_by_cancel

		command 字幕言語設定
	}

/***************************************************************************************************/
// スペシャル
/***************************************************************************************************/


	proc special_scr {
		command セットサウンドコード -c d:SNG_FOUTS_S
		@special_scr_main
	}

	proc special_scr_main {
		chara スペシャル画面マネージャー スペシャル画面 \
			-d special \
			-p スペシャル終了プロシージャー \
			-s $b:スペシャルモードのスタートカーソル位置 \
			-g 0	/*	デバッグ用。これを１にするとスペシャルがフルオープンになる	*/
	}

	proc スペシャル終了プロシージャー $:返り値 {
		eval($b:スペシャルモードのスタートカーソル位置 = $:返り値);

		// スペシャルの終了
		if( $:返り値 == -1 ){
			mesg サウンドマネージャー ＳＤマネ SD_CODE d:SNG_PLAY_01
			mesg ゲームセレクト画面マネージャー ゲームセレクト画面 ret_by_cancel

#if 0
		} else if( $:返り値 == 0 ){
			// Previous Story

			chara シャドーモセス シャドー \
				-p シャドー終了

//			chara ネームエントリー ネーム
		} else if( $:返り値 == 1 ){
			// Album
			chara アルバムモード アルバム \
				-p 写真終了
		} else if( $:返り値 == 2 ){
			// Dogtag
			chara ドッグタグモード ドッグタグ \
				-p ドッグタグ終了
		} else if( $:返り値 == 3 ){
			// Exit
			mesg サウンドマネージャー ＳＤマネ SD_CODE d:SNG_PLAY_01
			mesg ゲームセレクト画面マネージャー ゲームセレクト画面 ret_by_ok
		}
#else
		} else if( $:返り値 == 0 ){
			// BASIC ACTION
			@スペシャル起動
		} else if( $:返り値 == 1 ){
			// Previous Story
			if( $w:言語 == d:LANG_ENGLISH_ENGLAND ) {
				chara シャドーモセス シャドー \
					-p シャドー終了 \
					-e 10 129 324
			} else if( $w:言語 == d:LANG_FRENCH ) {
				chara シャドーモセス シャドー \
					-p シャドー終了 \
					-e 11 127 359
			} else if( $w:言語 == d:LANG_GERMANY ) {
				chara シャドーモセス シャドー \
					-p シャドー終了 \
					-e 11 132 353
			} else if( $w:言語 == d:LANG_ITALY ) {
				chara シャドーモセス シャドー \
					-p シャドー終了 \
					-e 12 /*139*/140 /*341*/349
			} else if( $w:言語 == d:LANG_SPANISH ) {
				chara シャドーモセス シャドー \
					-p シャドー終了 \
					-e 10 126 326
			} else if( $w:言語 == d:LANG_JAPANESE ){
				chara シャドーモセス シャドー \
					-p シャドー終了 \
					-e 7 136 269
			}	

//			chara ネームエントリー ネーム
		} else if( $:返り値 == 2 ){
			// Album
			chara アルバムモード アルバム \
				-p 写真終了
		} else if( $:返り値 == 3 ){
			// Dogtag
			chara ドッグタグモード ドッグタグ \
				-p ドッグタグ終了
		} else if( $:返り値 == 4 ){
			// ローポリ劇場
			@ローポリ劇場選択画面スタート
		} else if( $:返り値 == 5 ){
			// ボスラッシュ
			@ボスラッシュ選択画面スタート
		} else if( $:返り値 == 6 ){
			// Exit
			mesg サウンドマネージャー ＳＤマネ SD_CODE d:SNG_PLAY_01
			mesg ゲームセレクト画面マネージャー ゲームセレクト画面 ret_by_ok
		}
#endif

	}

	proc ボスラッシュ選択画面スタート {
		command オプションフラグの内容を保存

		chara ボスラッシュ選択画面 ボスラッシュ選択画面 \
			-d boss_menu \
			-p ボスラッシュ選択画面終了
	}

	proc ボスラッシュ選択画面スタート２ {
		chara ノード画面バックグラウンド バックグラウンド

		chara ノード画面フレームアニメーション ノードフレーム \
			-d node_frame \
			-b バックグラウンド

		chara ゲームセレクト画面マネージャー ゲームセレクト画面 \
			-d title_menu \
			-p ゲームセレクト画面プロシージャー \
			-b バックグラウンド \
			-s 1

		chara ボスラッシュ選択画面 ボスラッシュ選択画面 \
			-d boss_menu \
			-p ボスラッシュ選択画面終了
	}

	proc ボスラッシュ選択画面終了 $:返り値 $:レベル {
		if( $:返り値 == -1 ){
			// Exit
			command 保存していたオプションフラグを戻す

			@special_scr_main
		} else {
			if( $:レベル == 0 ){
				eval( $w:ゲーム設定 = d:LEVEL_VERYEASY );
			} else if( $:レベル == 1 ){
				eval( $w:ゲーム設定 = d:LEVEL_EASY );
			} else if( $:レベル == 2 ){
				eval( $w:ゲーム設定 = d:LEVEL_HARD );
			}

			if( $:返り値 == 0 ){
				@load_boss_survival_raiden
			} else if( $:返り値 == 1 ){
				@load_boss_survival_snake
			}
		}
	}

	proc ローポリ劇場選択画面スタート {
		command オプションフラグの内容を保存

		eval( $w:コンフィグ設定 = $w:コンフィグ設定 | d:CONFIG_BLOOD_OFF );

		chara ローポリ劇場選択画面 ローポリ劇場選択画面 \
			-d casting \
			-p ローポリ劇場選択画面終了 \
			-f 0x0e05a 0x08052 0x00000 0x00000 \		// デモ１	タンカーオープニング
			   0x0825a 0x0e25a 0x00000 0x00000 \		// デモ２	タンカー乗っ取り
			   0x08078 0x31e7c 0x00078 0x00000 \		// デモ３	スネークＶＳオルガ
			   0x08250 0x08250 0x08250 0x0c250 \		// デモ４	ＲＡＹ強奪
			   0x08242 0x08242 0x0ee5a 0x08242 \		// デモ５	ヴァンプ遭遇
			   0x08042 0x08042 0x08e42 0x0ee5a \		// デモ６	フォーチュン遭遇
			   0x08400 0x00000 0x00000 0x00000 \		// デモ７	ＲＡＹＶＳソリダス
			   0x00400 0x00e00 0x00000 0x00000			// デモ８	ソリダスの最後
	}

	proc ローポリ劇場選択画面スタート２ {
		chara ノード画面バックグラウンド バックグラウンド

		chara ノード画面フレームアニメーション ノードフレーム \
			-d node_frame \
			-b バックグラウンド

		chara ゲームセレクト画面マネージャー ゲームセレクト画面 \
			-d title_menu \
			-p ゲームセレクト画面プロシージャー \
			-b バックグラウンド \
			-s 1

		chara ローポリ劇場選択画面 ローポリ劇場選択画面 \
			-d casting \
			-p ローポリ劇場選択画面終了 \
			-f 0x0e05a 0x08052 0x00000 0x00000 \		// デモ１	タンカーオープニング
			   0x0825a 0x0e25a 0x00000 0x00000 \		// デモ２	タンカー乗っ取り
			   0x08078 0x31e7c 0x00078 0x00000 \		// デモ３	スネークＶＳオルガ
			   0x08250 0x08250 0x08250 0x0c250 \		// デモ４	ＲＡＹ強奪
			   0x08242 0x08242 0x0ee5a 0x08242 \		// デモ５	ヴァンプ遭遇
			   0x08042 0x08042 0x08e42 0x0ee5a \		// デモ６	フォーチュン遭遇
			   0x08400 0x00000 0x00000 0x00000 \		// デモ７	ＲＡＹＶＳソリダス
			   0x00400 0x00e00 0x00000 0x00000 \		// デモ８	ソリダスの最後
			-s $b:前デモ再生番号 $b:前キャスト１指定番号 $b:前キャスト２指定番号 \
			   $b:前キャスト３指定番号 $b:前キャスト４指定番号
	}

	proc ローポリ劇場選択画面終了 $:返り値 $:キャスト１ $:キャスト２ $:キャスト３ $:キャスト４ {
		if( $:返り値 == -1 ){
			// Exit
			command 保存していたオプションフラグを戻す

			@special_scr_main
		} else {
			eval( $b:前デモ再生番号 = $:返り値 );
			eval( $b:前キャスト１指定番号 = $:キャスト１ );
			eval( $b:前キャスト２指定番号 = $:キャスト２ );
			eval( $b:前キャスト３指定番号 = $:キャスト３ );
			eval( $b:前キャスト４指定番号 = $:キャスト４ );

			@メインセレクト $:返り値 $:キャスト１ $:キャスト２ $:キャスト３ $:キャスト４
		}
	}

/***************************************************************************************************/
// ゲームスタート
/***************************************************************************************************/

proc resident_clear {
	/* 常駐ディレクトリ情報クリア（2001．9.4 園山追加） */
	dim $i:常駐ディレクトリ[ 4 ]
	eval ( $i:常駐ディレクトリ[ 0 ] = 0 )
	eval ( $i:常駐ディレクトリ[ 1 ] = 0 )
	eval ( $i:常駐ディレクトリ[ 2 ] = 0 )
	eval ( $i:常駐ディレクトリ[ 3 ] = 0 )
	command varsave $i:常駐ディレクトリ[ 0 ]
	command varsave $i:常駐ディレクトリ[ 1 ]
	command varsave $i:常駐ディレクトリ[ 2 ]
	command varsave $i:常駐ディレクトリ[ 3 ]
}

/////////////////
// １周目
	proc １周目フィクション表記 {
		mesg ノード画面フレームアニメーション ノードフレーム kill
		mesg ノード画面バックグラウンド バックグラウンド kill

		if( $w:言語 == d:LANG_ENGLISH_ENGLAND ) {
			eval( $s:n_titile_ＴＲＩ名 = fiction_e )
			eval( $s:n_titile_テクスチャ名 = fiction_e_alp_ovl )
		} else if( $w:言語 == d:LANG_FRENCH ) {
			eval( $s:n_titile_ＴＲＩ名 = fiction_fr )
			eval( $s:n_titile_テクスチャ名 = fiction_fr_alp_ovl )
		} else if( $w:言語 == d:LANG_GERMANY ) {
			eval( $s:n_titile_ＴＲＩ名 = fiction_de )
			eval( $s:n_titile_テクスチャ名 = fiction_de_alp_ovl )
		} else if( $w:言語 == d:LANG_ITALY ) {
			eval( $s:n_titile_ＴＲＩ名 = fiction_it )
			eval( $s:n_titile_テクスチャ名 = fiction_it_alp_ovl )
		} else if( $w:言語 == d:LANG_SPANISH ) {
			eval( $s:n_titile_ＴＲＩ名 = fiction_es )
			eval( $s:n_titile_テクスチャ名 = fiction_es_alp_ovl )
		} else { //全部違ったら日本語です。
			eval( $s:n_titile_ＴＲＩ名 = fiction_j )
			eval( $s:n_titile_テクスチャ名 = fiction_j_alp_ovl )
		}

		chara delay フィクションディレイ -time 120 -exec {
			chara コナミロゴ表示 フィクション表記 \
				-p ゲームスタート \
				-t 64 180 64 \
				-b $s:n_titile_ＴＲＩ名 \		// ＴＲＩファイル名
				   $s:n_titile_テクスチャ名		// テクスチャ名
		}

	}

	proc ゲームスタート {
		print '================================================================='
		print 'フラグチェック'
		print 'n_title_ゲーム難易度:' $b:n_title_ゲーム難易度
		print '================================================================='

		// NEW GAME からのスタート

		// 関係するすべての変数を初期化する。

		eval( $w:クリア回数 = 0 );
		eval( $w:タンカー編クリア回数 = 0 );
		eval( $w:プラント編クリア回数 = 0 );
		eval( $w:クリア後フラグ = 0 );

		eval( $f:タンカーデジカメ取得済み = 0 );
		eval($f:プラントデジカメ取得済み = 0 );
		eval($f:タンカー無限バンダナ取得済み = 0 );
		eval($f:タンカーステルス迷彩取得済み = 0 );
		eval($f:プラント無限カツラ取得済み = 0 );
		eval($f:プラントステルス迷彩取得済み = 0 );
		eval($f:プラント腕力カツラ取得済み = 0 );
		eval($f:プラントＯ２カツラ取得済み = 0 );

		command ドッグタグゼロクリア
		@resident_clear

		if( $s:global_ゲームモード == タンカー編 ) {
			@タンカー編スタート
		} else if( $s:global_ゲームモード == プラント編 ) {
			@プラント編スタート
		} else if( $s:global_ゲームモード == タンカープラント ) {
			@タンカー編スタート
		}
	}

/////////////////
// ２周目
	proc 二周目用フィクション表記 {
		mesg ノード画面フレームアニメーション ノードフレーム kill
		mesg ノード画面バックグラウンド バックグラウンド kill

		#if 1 // def d:EU
			if( $w:言語 == d:LANG_ENGLISH_ENGLAND ) {
				eval( $s:n_titile_ＴＲＩ名 = fiction_e )
				eval( $s:n_titile_テクスチャ名 = fiction_e_alp_ovl )
			} else if( $w:言語 == d:LANG_FRENCH ) {
				eval( $s:n_titile_ＴＲＩ名 = fiction_fr )
				eval( $s:n_titile_テクスチャ名 = fiction_fr_alp_ovl )
			} else if( $w:言語 == d:LANG_GERMANY ) {
				eval( $s:n_titile_ＴＲＩ名 = fiction_de )
				eval( $s:n_titile_テクスチャ名 = fiction_de_alp_ovl )
			} else if( $w:言語 == d:LANG_ITALY ) {
				eval( $s:n_titile_ＴＲＩ名 = fiction_it )
				eval( $s:n_titile_テクスチャ名 = fiction_it_alp_ovl )
			} else if( $w:言語 == d:LANG_SPANISH ) {
				eval( $s:n_titile_ＴＲＩ名 = fiction_es )
				eval( $s:n_titile_テクスチャ名 = fiction_es_alp_ovl )
			} else { //全部違ったら日本語です。
				eval( $s:n_titile_ＴＲＩ名 = fiction_j )
				eval( $s:n_titile_テクスチャ名 = fiction_j_alp_ovl )
			}

			chara delay フィクションディレイ -time 120 -exec {
				chara コナミロゴ表示 フィクション表記 \
					-p 二周目スタート \
					-t 64 180 64 \
					-b $s:n_titile_ＴＲＩ名 \		// ＴＲＩファイル名
					   $s:n_titile_テクスチャ名		// テクスチャ名
			}
		#else
			chara delay フィクションディレイ -time 120 -exec {
				chara コナミロゴ表示 フィクション表記 \
					-p 二周目スタート \
					-t 64 180 64 \
					-b logo \				// ＴＲＩファイル名
					   d:FICTION_ALP_OVL	// テクスチャ名
			}
		#endif
	}

	proc 二周目スタート {
		print '================================================================='
		print 'フラグチェック'
		print 'n_title_ゲーム難易度:' $b:n_title_ゲーム難易度
		print '================================================================='

		// クリア

		@resident_clear

		if( $s:global_ゲームモード == タンカー編 ) {
			command store_loadedvar
			@タンカー編スタート
		} else if( $s:global_ゲームモード == プラント編 ) {
			command store_loadedvar
			@プラント編スタート
		} else if( $s:global_ゲームモード == タンカープラント ) {
			command store_loadedvar
			@タンカー編スタート
		}
	}

	proc タンカー編スタート {
		@製品版初期設定 $b:n_title_ゲーム難易度 $s:global_ゲームモード
		if( !( $w:コンフィグ設定 & d:CONFIG_RADAR_OFF ) ){
			eval( $w:クリアーコードフラグ = $w:クリアーコードフラグ | d:CLEAR_RADAR_USED );
		}
		print 'クリアーコードフラグ' $w:クリアーコードフラグ

		@サングラスチェック

		load "d00t" -resident 'r_tnk0'
	}

/***************************************************************************************************/
// ＴＧＳ２００１Ｆゲームスタート
/***************************************************************************************************/
#ifdef d:TGS2001F
	proc ＴＧＳ２００１Ｆゲームスタート {
		//mesg ノード画面バックグラウンド バックグラウンド kill
		command セットサウンドコード -c d:SNG_FOUTS_S
		@ＴＧＳフィクション表記
	}

	proc ＴＧＳフィクション表記 {
		chara delay フィクションディレイ -time 120 -exec {
			chara コナミロゴ表示 フィクション表記 \
				-p ＴＧＳタンカー編スタート \
				-t 64 180 64 \
				-b logo \				// ＴＲＩファイル名
				   d:FICTION_ALP_OVL	// テクスチャ名
		}
	}

	proc ＴＧＳタンカー編スタート {
		command ドッグタグゼロクリア
		@resident_clear

		eval( $b:n_title_ゲーム難易度 = d:LEVEL_EASY )
		eval( $s:global_ゲームモード = タンカー編 )
		@タンカー編スタート
	}
#endif

//野尻の注意！！！！！！ここを直すんだったら、	t13a1D.w04c.gclデモ海面・タンカー沈没も直すこと。頼むよ、AMIGO!!!!!!
	proc プラント編スタート {
		@製品版初期設定 $b:n_title_ゲーム難易度 $s:global_ゲームモード
		eval( $w:p_story = d:ST:P001_01_P01オープニング潜入１ポリゴンデモ１開始 )

		if( !( $w:コンフィグ設定 & d:CONFIG_RADAR_OFF ) ){
			eval( $w:クリアーコードフラグ = $w:クリアーコードフラグ | d:CLEAR_RADAR_USED );
		}

		@サングラスチェック

		// 歴史博物館ステージへ
		load "museum" -resident 'r_plt1'

	}
//野尻の注意！！！！！！ここを直すんだったら、	t13a1D.w04c.gclデモ海面・タンカー沈没も直すこと。頼むよ、AMIGO!!!!!!







/***************************************************************************************************/
