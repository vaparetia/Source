proc エンドプロック $:ムービー {
	eval( $i:スペシャルムービーフラグ = $:ムービー )

	@シャドー終了
}

proc 終了メッセージ {
	command セットサウンドコード -c d:SNG_FOUTS_S		//ＢＧＭフェードアウト
#ifndef PAL
	mesg 英語版スペシャルメニュー スペメヌ ムービー終了
#else
	mesg スペシャルメニューページ付き スペメヌ ムービー終了
#endif
}

proc ムービーその１ {
	command セットサウンドコード -c d:SNG_PLAY_04		//ＢＧＭ
	chara MOVIE再生 movie -file t:baa01 -top 246 57 -size 224 160 \
		 -proc 終了メッセージ -repeat
}
