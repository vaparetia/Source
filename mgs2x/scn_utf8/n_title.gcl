}else if( $w:言語 == d:LANG_SPANISH ){
/* ページ数が２ページにわたるもの
	初級１:
	初級３:
	初級５:
	初級６:

	中級１:
	中級２:
	中級４:
	中級８:

	上級５:
*/

	chara スペシャルメニューページ付き スペメヌ \
		-flag 	$i:スペシャルムービーフラグ \
		-end 	エンドプロック \
		-data   ムービーその１   [題名_s:初級１] 0 1 [説明_s:初級１説明] [説明_s:初級１説明_1] \
		-data	ムービーその２   [題名_s:初級２] 0 0 [説明_s:初級２説明] \
