proc load_skate_board {
	command セットサウンドコード -c d:SNG_FOUTS_S

	command reboot -file 'cdrom0:\\SKATE\\SKATE2.ELF;1';
}
proc load_snake_tales {
	command セットサウンドコード -c d:SNG_FOUTS_S
	
	// ロードしますか?画面
	// sselect に移動

	// 初期設定をやってしまう

	@ミッションズスタート時初期設定
	command ミッションズデータ初期化

//  eval( $w:現ステージ番号 = d:ステージ名:スネークテイルズＡクリア );	// 実験
	$f:ＶＲ／スネークテイルズロードフラグ = 1;
	$f:スネークテイルズフラグ = d:TRUE;
	@resident_clear
	@load_tales_select
}


proc load_VR {
	command セットサウンドコード -c d:SNG_FOUTS_S

	// ロードしますか?画面
	// mselect に移動

	// 初期設定をやってしまう
	// TODO:ＶＲでの主観オプションを退避して戻す
	@ミッションズスタート時初期設定
	command ミッションズデータ初期化

	$f:ＶＲ／スネークテイルズロードフラグ = 1;
	$f:ミッションズフラグ = d:TRUE;
	@resident_clear
	@load_missions_select
}
