/***************************************************************************************************/

proc 写真ロード終了プロシージャー $:返り値 {
	if( $:返り値 == 1 ){
		chara アルバムモード アルバム \
			-p 写真終了 \
			-n hehe
	} else {
		// ロードせずに終了
		mesg ゲームセレクト画面マネージャー ゲームセレクト画面 ret_by_cancel
	}
}

proc ドッグタグロード終了プロシージャー $:返り値 {
	if( $:返り値 == 1 ){
		chara ドッグタグモード ドッグタグ \
			-p ドッグタグ終了
	} else {
		// ロードせずに終了
		mesg ゲームセレクト画面マネージャー ゲームセレクト画面 ret_by_cancel
	}
}

proc シャドー終了 {
	print '前処理'
	//mesg ゲームセレクト画面マネージャー ゲームセレクト画面 ret_by_cancel
	@special_scr_main
}

proc 写真終了 {
	print '前処理'
	//mesg ゲームセレクト画面マネージャー ゲームセレクト画面 ret_by_cancel
	@special_scr_main
}

proc ドッグタグ終了 {
	print '前処理'
	//mesg ゲームセレクト画面マネージャー ゲームセレクト画面 ret_by_cancel
	@special_scr_main
}

proc hehe {
	print '次へ'
}


	proc サウンド設定 {
		chara サウンドマネージャー ＳＤマネ -pak 0
	}

/***************************************************************************************************/
// サングラスモード
/***************************************************************************************************/
proc サングラスチェック {
	// サングラスフラグ処理
	print '********************************************************************'
	print '******************       2周目スタート      ************************'
	print '********************************************************************'
	print 'クリア回数'$w:クリア回数
	print '計算後'($w:クリア回数 % 2)

	if( ($w:クリア回数 > 1) && !($w:クリア回数 % 2) ) {
		// サングラスフラグを立てる
		print 'サングラスフラグを立てる'
		eval( $w:クリア後フラグ = $w:クリア後フラグ | d:CLEARED_SUNGLASSES_PLAYING )
	} else {
		// サングラスフラグを寝かす
		print 'サングラスフラグを寝かす'
		eval( $w:クリア後フラグ = $w:クリア後フラグ & ~d:CLEARED_SUNGLASSES_PLAYING )
	}
}

