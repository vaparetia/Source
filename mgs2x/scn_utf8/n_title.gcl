	if(!$f:スペシャルムービーその８フラグ){
		eval($f:スペシャルムービーその８フラグ = 1)
		chara MOVIE再生 movie -file t:baa08-a -top 246 57 -size 224 160 \
			 -proc 終了メッセージ -repeat
	} else {
		eval($f:スペシャルムービーその８フラグ = 0)
		chara MOVIE再生 movie -file t:baa08-b -top 246 57 -size 224 160 \
			 -proc 終了メッセージ -repeat
	}

}
