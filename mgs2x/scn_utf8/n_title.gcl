		-data	ムービーその２２ [題名_s:上級６] 0 0 [説明_s:上級６説明] \
		-data	ムービーその２３ [題名_s:上級７] 0 0 [説明_s:上級７説明] \
		-data	ムービーその２４ [題名_s:上級８] 0 0 [説明_s:上級８説明]

} else if( $w:言語 == d:LANG_JAPANESE ){
	
	chara 英語版スペシャルメニュー スペメヌ \
		-flag 	$i:スペシャルムービーフラグ \
		-end 	エンドプロック \
		-data   ムービーその１   [説明:初級１説明]   [題名:初級１]   0 \
