print '天球45度回転でたよ天球45度回転でたよ天球45度回転でたよ天球45度回転でたよ'

}

proc 沈没タンカーセット {
	chara 沈没タンカー tank \
		-p 12962,0,89330 \
		-dir 0 \
		-kms w00_chinbotsu \
		-mar tnk_sink \
		-scale 10 \
		-light d:LT2_SCALE
#if d:沈没タンカーぼんぼり臨時
	chara 沈没タンカー tankぼんぼり \
		-p 12962,0,89330 \
		-dir 0 \
		-kms w00_chinbotsu_bonbori \
		-mar tnk_sink \
		-scale 10 \
		-light d:LT2_SCALE
#endif

	chara 沈没タンカー tank2 \
		-p 12962,-2000,89330 \
		-dir 0 \
		-kms w00_chinbotsu \
		-mar tnk_sink \
		-scale 10 \
		-light d:LT2_SCALE
	mesg 沈没タンカー tank2 非表示
#if d:沈没タンカーぼんぼり臨時
	chara 沈没タンカー tank2ぼんぼり \
		-p 12962,-2000,89330 \
		-dir 0 \
		-kms w00_chinbotsu_bonbori \
		-mar tnk_sink \
		-scale 10 \
		-light d:LT2_SCALE
	mesg 沈没タンカー tank2ぼんぼり 非表示
#endif
}

proc タンカー沈没モーション_breakout_back {
	mesg 沈没タンカー tank モーション再生 0
	mesg 沈没タンカー tank2 モーション再生 0
#if d:沈没タンカーぼんぼり臨時
	mesg 沈没タンカー tankぼんぼり モーション再生 0
	mesg 沈没タンカー tank2ぼんぼり モーション再生 0
#endif
}
proc タンカー沈没モーション_touchdown {
	mesg 沈没タンカー tank モーション再生 1
	mesg 沈没タンカー tank2 モーション再生 1
#if d:沈没タンカーぼんぼり臨時
	mesg 沈没タンカー tankぼんぼり モーション再生 1
	mesg 沈没タンカー tank2ぼんぼり モーション再生 1
#endif
}
