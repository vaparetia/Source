	mesg 天球 背景 Ｙ回転 1024

print '天球90度回転でたよ天球90度回転でたよ天球90度回転でたよ天球90度回転でたよ'

}
proc 天球0度回転 {
	mesg 天球 背景 Ｙ回転 0

print '天球0度回転でたよ天球0度回転でたよ天球0度回転でたよ天球0度回転でたよ'

}

