// ぼかしセット
// ------------------------------------
proc ぼかしセット {
	chara 遠景ぼかし far_deforcus \
		-plane	4 \
		-near	6000 \
		-far	9000

	chara 近景ぼかし near_deforcus \
		-plane	3 \
		-near	0 \
		-far	3000
}

//水中エフェクト
proc 水中のエフェクト {
	command 水位設定 -lv -6500
/*	chara 水中カメラ ゆらぎマン \
		-col 128 128 128 \
		-warp 2
*/
	chara カメラ泡 泡ぶくマン  \
		 -col 64 128 96
	chara カメラダスト ダストマン  \
		 -col 32 96 64 \
		 -n   1
}

proc 海面ゆらぎ下降 {
	command 水位設定 -lv -507500
}

proc 海面ゆらぎ戻し {
	command 水位設定 -lv -6500
}
// プリシェード用ライトの件

/*
proc スクリーンショット使用 {
	chara スクリーンショット screenshot
}
*/


proc デモ再生_t13a1D {
	eval($w:t_story = d:ST_T13a1Dメタルギア逃走ポリゴンデモ開始)
	#if d:デモ前五秒間待ち
		@t13a1Dデモアクトデバッグ再生時
	#else
		@t13a1Dデモ再生時
	#endif
}

proc t13a1Dデモアクトデバッグ再生時 {
chara デモアクトデバッグ demodebug  -i t:t13a1D_pal -d 't13a1D_pal' -l  -v 0  \
			-p タンカー沈没モーション_breakout_back タンカー沈没モーション_touchdown タンカー沈没モーション_dive2sea \
			   タンカー沈没モーション_breakout_back_a \
			   タンカー沈没モーション_breakout_back_b \
			   タンカー沈没モーション_touchdown_a \
			   タンカー沈没モーション_touchdown_b \
			   タンカー沈没モーション_touchdown_c \
			   タンカー沈没モーション_touchdown_d \
			   タンカー沈没モーション_touchdown_e \
			   タンカー沈没モーション_touchdown_f \
			   タンカー沈没モーション_touchdown_g \
			   タンカー沈没モーション_touchdown_h \
			   タンカー沈没モーション_touchdown_i \
			   タンカー沈没モーション_dive2sea_a \
			   タンカー沈没モーション_dive2sea_b \
			   タンカー沈没モーション_dive2sea_c \
			   タンカー沈没モーション_dive2sea_d \
			   タンカー沈没モーション_dive2sea_e \
			   タンカー沈没モーション_dive2sea_f \
			   タンカーオン タンカーオフ タンカー２オン \
			   ぼんぼり１オン ぼんぼり１オフ ぼんぼり２オフ \
			   雨停止 雨開始 \
			   海面高空へ飛ばす タンカー沈没海面 海面元に戻す \
#ifdef d:PAL
			   スネーク浮上海面 スネークのまれ海面  初期海面 \
#endif
			   空消す 空表示 霧雨オン 霧雨オフ 海面ゆらぎ下降 海面ゆらぎ戻し \
			   海面テクスチャデフォルト 海面テクスチャ遠景１ 海面テクスチャ遠景２ \
			   天球オフ 天球オン 天球90度回転 天球0度回転 天球45度回転
}
proc t13a1Dデモ再生時 {
		chara demo デモ再生 \
			-i t:t13a1D \
			-p タンカー沈没モーション_breakout_back タンカー沈没モーション_touchdown タンカー沈没モーション_dive2sea \
			   タンカー沈没モーション_breakout_back_a \
			   タンカー沈没モーション_breakout_back_b \
			   タンカー沈没モーション_touchdown_a \
			   タンカー沈没モーション_touchdown_b \
			   タンカー沈没モーション_touchdown_c \
			   タンカー沈没モーション_touchdown_d \
			   タンカー沈没モーション_touchdown_e \
			   タンカー沈没モーション_touchdown_f \
			   タンカー沈没モーション_touchdown_g \
			   タンカー沈没モーション_touchdown_h \
			   タンカー沈没モーション_touchdown_i \
			   タンカー沈没モーション_dive2sea_a \
			   タンカー沈没モーション_dive2sea_b \
			   タンカー沈没モーション_dive2sea_c \
			   タンカー沈没モーション_dive2sea_d \
			   タンカー沈没モーション_dive2sea_e \
			   タンカー沈没モーション_dive2sea_f \
			   タンカーオン タンカーオフ タンカー２オン \
			   ぼんぼり１オン ぼんぼり１オフ ぼんぼり２オフ \
			   雨停止 雨開始 \
			   海面高空へ飛ばす タンカー沈没海面 海面元に戻す \
#ifdef d:PAL
			   スネーク浮上海面 スネークのまれ海面  初期海面 \
#endif
			   空消す 空表示 霧雨オン 霧雨オフ 海面ゆらぎ下降 海面ゆらぎ戻し\
			   海面テクスチャデフォルト 海面テクスチャ遠景１ 海面テクスチャ遠景２ \
			   天球オフ 天球オン 天球90度回転 天球0度回転 天球45度回転 \
			-next t13a1D終了
}
proc t13a1D終了 {
	mesg デモキャンセルチェック デモキャンセル kill
	eval($w:t_story = d:ST_T13a1Dメタルギア逃走ポリゴンデモ終了)
	print '$w:t_story = d:ST_T13a1Dメタルギア逃走ポリゴンデモ終了'
	eval($f:global_polygon_demo = 0)
	restart -s ;
}
proc タンカー編終了処理 {
	eval($w:タイトルメニュー設定 = $w:タイトルメニュー設定 | d:TITLE_MENU_TANKER_CLEARD)
	eval($w:コンフィグ設定 = $w:コンフィグ設定 | d:CONFIG_TANKER_CLEARED)
	eval($w:タンカー編クリア回数 = $w:タンカー編クリア回数 + 1)
	print '$w:タンカー編クリア回数は'$w:タンカー編クリア回数'になりました！！！！！！！！！'

	command メニュー設定 -radio off ;
	command varsave
	if(($w:タイトルメニュー設定 & d:TITLE_MENU_STORY_SEL_MASK) == d:TITLE_MENU_STORY_SEL_TANKER ) {
		//タンカー編のみ
		print 'ending'
		load "ending"
	}else{
		//タンカー&プラント編なのでこれからまだプラント編へ
		eval( $w:現ステージ番号 = d:ステージ名:プラント編スタート );
		eval( $w:t_story = d:ST_PASSクリアコード表示終了) ;
		command varsave ;

		print 'save manager'
		@セーブ確認ダイアログ表示
	}
}
// -------------------------------------------------------
// クリア情報のセーブ(確認）
// -------------------------------------------------------
proc セーブ確認ダイアログ表示 {
	chara セーブ確認画面 セーブ確認 \
		-p セーブダイアログ表示 \
		-s セーブ確認文
	// リソース名は、ending.gclでは「セーブ確認文」というのを用意してある。
	// リソースの内容は、ending.rscに記述してある。
}

// -------------------------------------------------------
// クリア情報のセーブ
// -------------------------------------------------------
proc セーブダイアログ表示 $:返り値 {
	if ( $:返り値 == 0 ) {
		// タンカー編後の情報をセーブする
		chara セーブゲーム画面マネージャー セーブ画面 \
			-d save_load \
			-p セーブダイアログ表示終了 \
			-i tnkicon
	} else {
		@プラント編スタート
	}
}

proc セーブダイアログ表示終了 $:返り値 {
	if( $:返り値 != 0 ){
		@プラント編スタート
	} else {
		@セーブ確認ダイアログ表示
	}
}

proc プラント編スタート {
	@タンカープラントつなぎ設定
	eval( $w:p_story = d:ST:P001_01_P01オープニング潜入１ポリゴンデモ１開始 )
	chara delay ディレイ -time 120 -exec{
		// 歴史博物館ステージへ
		load "museum" -resident 'r_plt1'
	}
}
