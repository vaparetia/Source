// 各gclで必要なdefine
// ------------------------------------
// モード
#define		STAGE_TANKER	1		// 共通プロック切り分け用
#define		DEMO_STAGE		1		// デモステージかどうかで起動するキャラを切り分ける

// 調整用Define
// ------------------------------------

#define	PLAYER		スネーク
#define SOUND_FG	1
#define LD_FADEOUT	1
#define STAGE_END	1
#define STAGE_HZX	d00a3
#define STAGE_LT2	w00a
#define LT2_SCALE	w00_chinbotsu_scale10
// 開発中ですデファインを外すときは、中味をきちんと確認。
#define 開発中です	0
#define 沈没タンカーぼんぼり臨時 1

// include
// ------------------------------------
#include "5sec_bfr_demo.h"
#include "demo_vardef.h"
#include "demo_stdch.h"
#include "demo_stdch2.h"
#include "story.h"
#include "sload.h"
#include "varinit.h"
#include "ending.rsc"



// マップ設定
// ------------------------------------
chara マップ 海面 -k null 0 0 0 -h d:STAGE_HZX -l d:STAGE_LT2
if($w:t_story < d:ST_T13a1Dメタルギア逃走ポリゴンデモ開始){
	command マップ設定 海面 -set {
		eval($s:d_num = t13a1D)
		#if d:MGS2_DEMO
			@t13a1Dデモアクトデバッグ再生時
		#else
			eval($f:global_polygon_demo = 1)
			@デモモデル差し替え処理
			#if d:デモ前五秒間待ち
				@global_五秒待ちセット
				if( $f:global_デバッグポーズ通過 ){ @デモ再生_t13a1D }
			#else
				@デモ再生_t13a1D
			#endif
			@デモキャンセルチェックプロック
		#endif
		@常駐キャラ設定
		@エフェクト設定
		@デモ海面セット
		@空_雷_天球_風制御_雨_霧雨セット
		@シネマスクリーンセット
		@沈没タンカーセット
		@水中のエフェクト
	}
} else if($w:t_story == d:ST_T13a1Dメタルギア逃走ポリゴンデモ終了) {
	@タンカー編終了処理
} else if($w:t_story == d:ST_PASSクリアコード表示終了) {
	@プラント編スタート
}
//初期マップの表示
command マップ表示 	-add 海面


// デモ再生関係用プロック設定
// ------------------------------------
// とりあえずダミープロック
proc null {}

proc デモキャンセル {
	// ポーズオフ
	command メニュー設定 -p off
	// プログラムで起動しているSEがあれば、ここで切る
	command セットサウンドコード -c d:SNG_FOUTS_S
	command セットサウンドコード -c d:SE_JOUCHUU_OFF
	command StreamStopAll
}

proc デモキャンセルチェックプロック {
	chara デモキャンセルチェック デモキャンセル \
		-p デモキャンセル
}



proc シネマスクリーンセット  {
	chara シネマスクリーン シネマ \
		-top d:CINEMA_BELT_UPPER \
		-bottom d:CINEMA_BELT_LOWER \
		-ftime 60	//デフォルト値（ゼロは駄目）
	mesg シネマスクリーン シネマ フェードアウト 1
}


// エフェクト設定
// ------------------------------------
proc エフェクト設定 {
}

proc デモ海面セット {
	chara プラント海面 seaseasea \
		-single_mode \
		-light_enable \
		-tex oil wave06 wave09_alp_ovl \
		-pos 0,-6500,0 \
		-details_wave 23 9938 12
}
proc 海面高空へ飛ばす {
	mesg プラント海面 seaseasea 表示位置移動 0,(-6500+0),0
}
proc タンカー沈没海面 {
	mesg プラント海面 seaseasea 表示位置移動 0,(-6500+0),0
}
proc 海面元に戻す {
	mesg プラント海面 seaseasea 表示位置移動 0,(-6500+0),0
}

#ifdef d:PAL
// ＰＡＬ版専用。その他のバージョンでは使用されません。
proc スネーク浮上海面 {
print 'pppppppppppppppppppppppppppppppppppppppppppppppppppppp'
	mesg プラント海面 seaseasea 表示位置移動 0,(-6500-1000),0
}	

proc スネークのまれ海面 {
print 'tttttttttttttttttttttttttttttttttttttttttttttttttttttt'
	mesg プラント海面 seaseasea 表示位置移動 0,(-6500+450),0
}	

proc 初期海面 {
print 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'
	mesg プラント海面 seaseasea 表示位置移動 0,(-6500-250),0
}	

#endif

proc 海面テクスチャデフォルト {
	mesg プラント海面 seaseasea テクスチャ変更 wave06
}
proc 海面テクスチャ遠景１ {
	mesg プラント海面 seaseasea テクスチャ変更 wave06long1
}
proc 海面テクスチャ遠景２ {
	mesg プラント海面 seaseasea テクスチャ変更 wave06long2
}


proc 空_雷_天球_風制御_雨_霧雨セット {
print 'sky_000'
	chara   新空 嵐空 \
//		-h 90000 \
		-m w00_sky
print 'sky_001'
	chara   新雷フラッシュ 嵐空
print 'sky_002'

	chara 天球 背景 \
		-h 180000 \
		-b -10000

//	command セットファークリップ 50 (65535 * 40)
print 'sky_003'

	chara 風制御 wind \
		-i 100 \
		-j 300 \
		-r -1024 1024 0 \
		-a 4 \
		-b 300 \
		-c 150

print 'sky_004'
	chara 雨 rain \
		-n 16 \
		-c 90 \
		-b -17750 0 -20000 17750 3000 -3000 \
			-14000 6000 -16000 14000 10000 -13000 \
			-32000 -10000 -32000 32000 -2600 32000

print 'sky_005'
	chara 霧雨 fograin

print 'sky_006'

}

proc 雨停止 {
	mesg 雨 rain パーセンテージ 0
}

proc 雨開始 {
	mesg 雨 rain パーセンテージ 100
}

proc 空消す {
	mesg 新空 嵐空 消す

print '空消すでたよ空消すでたよ空消すでたよ空消すでたよ'

}

proc 空表示 {
	mesg 新空 嵐空 表示

print '空表示でたよ空表示でたよ空表示でたよ空表示でたよ'

}

proc 霧雨オフ {
	mesg 霧雨 fograin オフ
}

proc 霧雨オン {
	mesg 霧雨 fograin オン
}

proc 天球オフ {
	mesg 天球 背景 オフ

print '天球オフでたよ天球オフでたよ天球オフでたよ天球オフでたよ'

}

proc 天球オン {
	mesg 天球 背景 オン

print '天球オンでたよ天球オンでたよ天球オンでたよ天球オンでたよ'

}

