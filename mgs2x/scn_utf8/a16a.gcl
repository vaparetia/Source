proc スタートカメラセット {
#if d:DEBUG_PRINT
	print '*** Start Camera Set ***'
#endif

	if( $s:登場ポイント == ＢＣ連絡橋から ) {
		chara カメラ設定 モーションカメラ \
			-c 1 \
			-p -56000,5388,-77134 \
			-t -56000,1560,-77750 \
			-a 200 \
			-i 0 2 0 0 \
			-s 1
	} else if( $s:登場ポイント == ＣＤ連絡橋から ) {
		chara カメラ設定 モーションカメラ \
			-c 1 \
			-p -44841,3198,-95145 \
			-t -44008,1980,-98447 \
			-a 200 \
			-i 0 2 0 0 \
			-s 1
	}
}

proc スタートカメラオフ {
#if d:DEBUG_PRINT
	print '*** Start Camera Off ***'
#endif

	chara カメラ設定 モーションカメラ -s -1
}

//-----------------------------------------------------------------------------
// ピーター遭遇デモへ
proc ピーター遭遇デモへ {
#if d:DEBUG_PRINT
	print '*** Peter Demo Start ***'
#endif

	preseek 'd014p01'
	@ポリゴンデモロード d:ST:P014_01_P01ピーター遭遇１ポリゴンデモ１開始
}



//-----------------------------------------------------------------------------
// フェードイン後
proc SS_CB_フェードイン後 {
#if d:DEBUG_PRINT
	print '*** SS CB After Fade In ***'
#endif
}


//-----------------------------------------------------------------------------
// ロード設定
proc ロード設定 {
#if d:DEBUG_PRINT
	print '*** Load Set ***'
#endif

	// @ステージ終了時処理 目標位置  終了時方向  呼び出しプロックに入る  入ってゆく姿勢

	// ＢＣ連絡橋へ (w15a)
	trap ld001 d:PLAYER \
		-mask 入る \
		-exec {
			if($f:ロードチェックＯＮフラグ == 1) {
				eval( $s:登場ポイント = ＢＣ連絡橋から );
				@スタートカメラセット
				@A_爆弾タイマー停止
				preseek 'a15b'
				@ステージ終了時処理（ステージ名表示） -56000 0 -74500 0 mv_a16a_a15a_0 d:DEFAULT_M_TYPE d:wn_ＢＣ連絡橋
			}
		}

	// ＣＤ連絡橋へ (w17a)
	trap ld002 d:PLAYER \
		-mask 入る \
		-exec {
			if($f:ロードチェックＯＮフラグ == 1) {
				eval( $s:登場ポイント = ＣＤ連絡橋から );
				@スタートカメラセット
				@A_爆弾タイマー停止
				preseek 'a17a'
				@ステージ終了時処理（ステージ名表示） -40750 0 -100250 1024 mv_a16a_a17a_0 d:DEFAULT_M_TYPE d:wn_ＣＤ連絡橋
			}
		}
}

proc ロードプロック {
#if d:DEBUG_PRINT
	print '*** Load Proc ***'
#endif

		if($s:呼び出しプロック == mv_a16a_a15a_0) {
			// ＢＣ連絡橋へ
			@mv_a16a_a15a_0

		} else if($s:呼び出しプロック == mv_a16a_a17a_0) {
			// ＣＤ連絡橋へ
			@mv_a16a_a17a_0
		}
}



//=============================================================================
// ステージ進入時処理
//=============================================================================

proc ステージ進入時処理 {
#if d:DEBUG_PRINT
	print '*** Stage Start Proc ***'
#endif

	// @ステージ開始時処理 タイプ(スライドドア、水密ドア、何もなし)   ドアの名前   移動距離   状態(前のステージ状態、走り、歩き)
	if($s:登場ポイント == ＢＣ連絡橋から) {
		@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:SL_DOOR_TYPE ＢＣ連絡橋へのドア 2000 d:DEFAULT_M_TYPE d:wn_Ｃ脚食堂

	} else if($s:登場ポイント == ＣＤ連絡橋から) {
		@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:SL_DOOR_TYPE ＣＤ連絡橋へのドア 2000 d:DEFAULT_M_TYPE d:wn_Ｃ脚食堂

	} else if($s:登場ポイント == Ｅ脚からダンボール) {
		@ステージ開始時処理（ダンボールワープ） d:wn_Ｃ脚食堂

	// テイルズＢエマ遭遇後から
	} else if ($s:登場ポイント == テイルズＢエマ遭遇後から) {
		@ステージ開始時処理 \
		d:LOAD_TYPE:NO_MOVE_TYPE 紙芝居 0 d:DEFAULT_M_TYPE
	// テイルズＢ敵兵倒した後から
	} else if ($s:登場ポイント == テイルズＢ敵兵倒した後から) {
		@ステージ開始時処理 \
		d:LOAD_TYPE:NO_MOVE_TYPE 紙芝居 0 d:DEFAULT_M_TYPE
	// テイルズＥＣ脚到着紙芝居後から
	} else if ($s:登場ポイント == テイルズＥＣ脚到着紙芝居後から) {
		@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:NO_MOVE_TYPE \
		紙芝居 0 d:DEFAULT_M_TYPE d:wn_Ｃ脚食堂
	}
}
