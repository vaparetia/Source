//-----------------------------------------------------------------------------
// その他オブジェクト設定

proc その他オブジェクト設定_食堂 {
#if d:DEBUG_PRINT
	print '*** Object Set: Cafeteria ***'
#endif

	//---------------------------------------------------------
	// レンズフレア
	//   -pos 位置  -size 大きさ  -alpha アルファ
	chara レンズフレア  レンズフレア \
		-pos   -63923,3281,-102612 \
		-size  1 \
		-alpha 8 \
		-g     7

	mesg レンズフレア レンズフレア アルファ変更 0 1

	//---------------------------------------------------------
	// ガラス弾痕
	chara ガラス弾痕 ガラス弾痕 \
		-flag   0 \
		-thick  10 \
		-size   60 \
		-number 2 \
		-point -65460,3244,-98444 -64493,2831,-100358 \
		-point -64375,3244,-100593 -63408,2831,-102507

	//---------------------------------------------------------
	command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 6

	//---------------------------------------------------------
	// 両開き扉 -m モデル名 -p 設置場所 -r Ｙ軸回転 -a 左扉の－制限角 左扉の＋制限角 右扉の－制限角 右扉の＋制限角
	chara 両開き扉 両開き扉 -m d:DOOR_NAME4 -p -56500 0 -104517 -r 1024 -a 900 900 900 900

	//---------------------------------------------------------
	// chara 鏡面モデル管理 -pos 鏡面座標 -axis 反点軸 // 0:X軸反点 1:Y軸反点 2:Z軸反点
	chara 鏡面モデル管理 鏡面モデル_食堂 \
		-pos  0, 0, 0\
		-axis 1
	trap ev011 ？ -mask ？ \
		-exec {
			if($3 == 入る) {
				mesg 鏡面モデル管理 鏡面モデル_食堂 add $2
			} else {
				mesg 鏡面モデル管理 鏡面モデル_食堂 del $2
			}
		}

	//---------------------------------------------------------
	// ダンボールトラップ
	chara ダンボール柄トラップ設定 ダンボール柄トラップ設定 \
		-name d:PLAYER \
		-traps d:アイテム:ダンボール, cbox_area
}

proc その他オブジェクト設定_廊下 {
#if d:DEBUG_PRINT
	print '*** Object Set: Hall ***'
#endif

	//---------------------------------------------------------
	// 主観禁止壁
	@主観禁止壁 ＣＤ連絡橋へのドア壁 -42625 0 -101000 3072 d:SD_SLIDE_OUTSIDE

	//---------------------------------------------------------
	// ロード部モデル

	// プットオブジェ
	//   -m オブジェクト名  -r 向き  -p 場所  -s スケール  -l 光源  -f フラグ  -t ＬＯＤ閾値
	@SS_プットオブジェ  ＣＤ連絡橋ロード部 d:KMS_NAME11
	mesg プットオブジェ ＣＤ連絡橋ロード部 off

	//---------------------------------------------------------
	// ドア風
	chara ローカル風 隙間風 \
		-n 2 \
		-d	-43750 0 -101000 -41500 3000 -99500 3072 -512 2048 \
			-56750 0  -77500 -55250 3000 -75250 2048 -512 2048
	mesg ローカル風 隙間風 オフ

	//---------------------------------------------------------
	// 電灯虫

	// chara 電灯虫 -n 匹数 // ４以上は４単位で -p 位置 // プレイヤー誘導時は無視 
	//   -b フラグ // 壁との当たり見るか 1:あり, 0:なし -s バウンド１ // 最小 -l バウンド２ // 最大
	chara 電灯虫 電灯虫 \
		-n 12 \
		-p -43000,2750,-100250 \
		-b 1 \
		-s -43875,   0,-101000 \
		-l -43000,3250, -99500

	//---------------------------------------------------------
	trap ev005 d:PLAYER \
		-mask ？\
		-exec {
			if($3 == 入る){
				mesg マップ接合 Ｃ脚接合４ off	// 広場 男子トイレ
				mesg マップ接合 Ｃ脚接合５ off	// 広場 女子トイレ
			} else {
				mesg マップ接合 Ｃ脚接合４ on	// 広場 男子トイレ
				mesg マップ接合 Ｃ脚接合５ on	// 広場 女子トイレ
			}
		}
}

proc その他オブジェクト設定_男子トイレ {
#if d:DEBUG_PRINT
	print '*** Object Set: Mens Restroom ***'
#endif

	//---------------------------------------------------------
	// chara 鏡面モデル管理 -pos 鏡面座標 -axis 反点軸 // 0:X軸反点 1:Y軸反点 2:Z軸反点
	chara 鏡面モデル管理 鏡面モデル_男子トイレ \
		-pos  0, 0, 0 \
		-axis 1
	trap ev001 ？ -mask ？ \
		-exec {
			if($3 == 入る) {
				mesg 鏡面モデル管理 鏡面モデル_男子トイレ add $2
			} else {
				mesg 鏡面モデル管理 鏡面モデル_男子トイレ del $2
			}
		}

	//---------------------------------------------------------
	// 真鏡面 -p 鏡面座標 -a 反点軸(0:X軸反点 1:Y軸反点 2:Z軸反点) -n 鏡面面の法線直接指定 -e 起動時からＯＮに(デフォルトはＯＦＦで起動)
	//   mesg 真鏡面 $s:name off[0]
	//   mesg 真鏡面 $s:name on[1]
	//
	//   子画面との併用は不可！！
	//   -axis オプションと -normal オプションは排他なので注意
	//   -axis 0 と -normal 1,0,0 は同じ結果になる
	//   -axis 1 と -normal 0,1,0 は同じ結果になる
	//   -axis 2 と -normal 0,0,1 は同じ結果になる
	chara 真鏡面  真鏡面_男子トイレ -p -57500,1570,-87502 -a 2
	trap ev001 d:PLAYER \
		-mask ？\
		-exec {
			if($3 == 入る){
				mesg 真鏡面 真鏡面_男子トイレ on
			}else{
				mesg 真鏡面 真鏡面_男子トイレ off
			}
		}
	trap ev002 d:PLAYER \
		-mask ？\
		-exec {
			if($3 == 入る){
				mesg マップ接合 Ｃ脚接合３ off	// 廊下 広場
				mesg マップ接合 Ｃ脚接合５ off	// 広場 女子トイレ
			}else{
				mesg マップ接合 Ｃ脚接合３ on	// 廊下 広場
				mesg マップ接合 Ｃ脚接合５ on	// 広場 女子トイレ
			}
		}

	//---------------------------------------------------------
	// 左小便器
	chara トイレ流れ トイレ流れ左 -pos -62750 500 -87144
	trap ev007 ？ \
		-mask 出る \
		-exec {
			mesg トイレ流れ トイレ流れ左 流れろ
		}
	// 右小便器
	chara トイレ流れ トイレ流れ右 -pos -61625 500 -87144
	trap ev008 ？ \
		-mask 出る \
		-exec {
			mesg トイレ流れ トイレ流れ右 流れろ
		}

	//---------------------------------------------------------
	// エアータオル
	trap ev009 ？ \
		-mask ？ \
		-exec {
			if($3 == 入る) {
				eval($i:Ｓローカル変数Ｉ２ = $i:Ｓローカル変数Ｉ２ + 0x00010000)
			} else {
				eval($i:Ｓローカル変数Ｉ２ = $i:Ｓローカル変数Ｉ２ - 0x00010000)

				if(($i:Ｓローカル変数Ｉ２ & 0x00ff0000) == 0) {
					eval($i:Ｓローカル変数Ｉ２ = 0)
				}
			}
		}
}

