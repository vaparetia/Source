//-----------------------------------------------------------------------------
// スイッチ

#define STAGE_PLANT 1
#define	STAGE_ALT	1		// オルタナティブミッション切り分け用
#define STAGE_W16A  1

#define		BOMB_DROP_PROC		1	// 凍結Ｃ４落下後処理を使用するためのdefine

#define ENE_P_GOL     1
#define ENE_HIGH_TECH 1

#define PLAYER     ライデン

#define STAGE_END      1		// ロードプロック
#define START_CAMERA   1		// ステージ開始時のカメラ
#define NODE           1		// ノード

#define SCREENSHOT     0		// スクリーンショット
#define KEYBOARD       0		// ＵＳＢキーボード

//-----------------------------------------------------------------------------
// マップ関係

#define HZX_NAME     a16a
#define LT2_NAME     w16a

#define KMS_NAME2    w16a1						// 廊下
#define KMS_NAME3    w16a1r
#define KMS_NAME4    w16a2						// 男子トイレ
#define KMS_NAME5    w16a2r
#define KMS_NAME6    a16a3						// 女子トイレ
#define KMS_NAME7    w16a3r
#define KMS_NAME8    w16a4						// 広場
#define KMS_NAME9    w16a4r
#define KMS_NAME10   w16a_15a					// ロード部 ＢＣ連絡橋
#define KMS_NAME11   w16a_17a					// ロード部 ＣＤ連絡橋

#define DOOR_NAME1   dr_free					// レベルドア
#define DOOR_NAME2   dr_lv1_00					// レベル１ドア
#define DOOR_NAME3   w16a_dr00					// 外部ドア
#define DOOR_NAME4   w16a0_kit_door				// 両開きドア
#define DOOR_NAME5   w16a0_refrigerator_door	// 冷蔵庫用
#define DOOR_NAME6   w16a_wc_dr					// トイレドア
#define DOOR_NAME7   w16a2_wc_dr_pos			// トイレドア(ポスター)

#define DOOR_NAME_BC_LV1   w16a_dr00x			// 外部ドア(テイルズ用ＢＣレベルドア)
#define DOOR_NAME_CD_LV0   w16a_dr00x			// 外部ドア(テイルズ用ＣＤレベルなしドア)

#define OBJECT_NAME1 w16a_chair					// 椅子
#define OBJECT_NAME2 w16a0_poster				// ポスター

#define KMS_NAME0    w16a0						// 食堂
#define KMS_NAME1    w16a0r



//-----------------------------
// 敵兵音声
//-----------------------------
resource ghq_area_alert_voice {
	w16a:
		$t{
			// PLAREA0
			t:vc040142,	// 指揮官　　「了解。応援部隊をＣ脚・男子トイレへ派遣する！奴を追い込むんだ」
			t:vc040143,	// 指揮官　　「了解。増援部隊、Ｃ脚に向かえ！男子トイレを固めろ」
			-2,
			// PLAREA1
			t:vc040144,	// 指揮官　　「了解。増援部隊、Ｃ脚・女子トイレへ向かえ！敵を追い込め」
			t:vc040145,	// 指揮官　　「了解。応援部隊をＣ脚に送る！女子トイレを守れ！」
			-2,
			// PLAREA2
			t:vc040146,	// 指揮官　　「了解。増援部隊、Ｃ脚食堂へ向かえ。奴を逃がすな！」
			t:vc040147,	// 指揮官　　「了解。応援部隊をＣ脚に送る！食堂を包囲しろ！」
			-2,
			// PLAREA3
			t:vc040148,	// 指揮官　　「了解。増援部隊、Ｃ脚へ急行せよ！敵を追い込むんだ！」
			t:vc040149,	// 指揮官　　「了解。バックアップ、Ｃ脚へ向かえ！敵を仕留めろ！」
			-1
		}
}

resource ghq_caution_voice {
	w16a:
		$t{
			t:vc040312,	// 指揮官　　「了解。Ｃ脚を増員する。警備を強化しろ」
			t:vc040313,	// 指揮官　　「了解。Ｃ脚に増員を送る。警戒を強化しろ」
			-2,
			t:vc040423,	// 指揮官　　「Ｃ脚との連絡が途絶えた」
			-1
		}

	w16a_2:
		$t{
			t:vc046601,	// 指揮官　　「了解、総員警戒を強化せよ」
			t:vc046601,	// 指揮官　　「了解、総員警戒を強化せよ」
			-2,
			t:vc040423,	// 指揮官　　「Ｃ脚との連絡が途絶えた」
			-1
		}
}



// ドア設定用ステージ内ローカル変数(a_mode.hよりも先に定義する)
dim $$b:ドアフラグ[ 4 ]
dim $$s:ドアモデル名[ 4 ]

command	配列セット $$b:ドアフラグ[0] {
	0,	0,	0,	0
}
command	配列セット $$s:ドアモデル名[0] {
	0,	0,	0,	0
}





//=============================================================================
// include
//=============================================================================

#include "rai_a16a.mh"		// ステージ固有モーションリスト

#include "stdch.h"
#include "enevoice.h"
#include "item_info.h"
#include "a_mode.h"		// アナザーミッション設定ファイル
#include "sload.h"
#include "sound.h"
#include "node_res.h"

#if d:KEYBOARD 
#include "usbkbd.h"
#endif

#include "stageset.h"		// ステージ設定共通ヘッダ

//-----------------------------------------------------------------------------
// ローカル

#define _PETER_X          -52200
#define _PETER_Z         -102125
#define CBOX_MAN_TIME       3600	// ダンボール男初期値 ６０秒
#define PETER_INTERVAL_TIME  300	// ピーター反応インターバル ５秒

eval($w:Ｓローカル変数Ｗ１ = d:CBOX_MAN_TIME);		// ダンボール男カウンター
eval($i:Ｓローカル変数Ｉ１ = 0);					// ピーター反応カウンター
eval($i:Ｓローカル変数Ｉ２ = 0);					// 男子トイレ エアータオルカウンター (鳴り始め | 人数 | フレームカウンター)
eval($i:Ｓローカル変数Ｉ３ = 0);					// 女子トイレ エアータオルカウンター (鳴り始め | 人数 | フレームカウンター)

eval($w:Ｓローカル変数Ｗ２ = 0);					// 主観デモのステップ
eval($f:Ｓローカルフラグ１ = 0);					// 主観デモ時の分岐
eval($f:Ｓローカルフラグ２ = 0);					// 主観デモ時の分岐

eval($f:クリアリングフラグ０ = 0)	// クリアリング状態
eval($f:クリアリングフラグ１ = 0)	// クリアリング状態

#ifdef d:XBOX
// ＸＢＯＸだけはエアータオルを連続呼び出しすると音が途切れるため２種類の音を交互に呼ぶ
$$f:エアータオルＳＥ番号 = 0;
#endif





//=============================================================================
// メイン
//=============================================================================
// アナザー用でマップ設定前に設定する
// ------------------------------------
@アナザー用マップ定義前設定

chara マップ 食堂 \
	-k d:KMS_NAME0 \
	-k d:OBJECT_NAME2 \
	-h d:HZX_NAME, 0 \
	-l d:LT2_NAME

chara マップ 廊下 \
	-k d:KMS_NAME2 \
	-h d:HZX_NAME, 1 \
	-l d:LT2_NAME

chara マップ 男子トイレ \
	-k d:KMS_NAME4 \
	-h d:HZX_NAME, 2 \
	-l d:LT2_NAME

chara マップ 女子トイレ \
	-k d:KMS_NAME6 \
	-h d:HZX_NAME, 3 \
	-l d:LT2_NAME

chara マップ 広場 \
	-k d:KMS_NAME8 \
	-h d:HZX_NAME, 4 \
	-l d:LT2_NAME

chara マップ接合 Ｃ脚接合１ 食堂 廊下
chara マップ接合 Ｃ脚接合２ 食堂 廊下
chara マップ接合 Ｃ脚接合３ 廊下 広場
chara マップ接合 Ｃ脚接合４ 広場 男子トイレ
chara マップ接合 Ｃ脚接合５ 広場 女子トイレ

command マップ設定 食堂 廊下 男子トイレ 女子トイレ 広場 -set {

	//----- 基本設定
	@SS_跳弾弾痕設定
	@常駐キャラ設定

	@A_プレイヤー設定 sna_a16a rai_a16a
}

// 爆弾解体ミッションでつけるオブジェクトがあるため、先に呼ぶ
command マップ設定 食堂 -set {

	//----- オブジェクト(マップ別)
	@壊れ物設定_食堂
}


// アナザー用でマップ設定後に設定する
// ------------------------------------
@アナザー用マップ定義後設定

command マップ設定 食堂 廊下 男子トイレ 女子トイレ 広場 -set {
	//----- オブジェクト(共通)
	@ドア設定
	@ロッカー設定
}

command マップ設定 食堂 -set {

	//----- オブジェクト(マップ別)
//	@ノード端末設定 2048
	@A_食堂ドア開閉設定
	@天井君設定_食堂
	@その他オブジェクト設定_食堂
}

command マップ設定 廊下 -set {

	//----- オブジェクト(マップ別)
	@A_廊下ドア開閉設定
	@天井君設定_廊下
	@その他オブジェクト設定_廊下
}

command マップ設定 男子トイレ -set {

	//----- オブジェクト(マップ別)
	@天井君設定_男子トイレ
	@壊れ物設定_男子トイレ
	@その他オブジェクト設定_男子トイレ
}

command マップ設定 女子トイレ -set {

	//----- オブジェクト(マップ別)
	@天井君設定_女子トイレ
	@壊れ物設定_女子トイレ
	@その他オブジェクト設定_女子トイレ
}

command マップ設定 広場 -set {

	//----- オブジェクト(マップ別)
	@A_広場ドア開閉設定
	@天井君設定_広場
	@壊れ物設定_広場
	@その他オブジェクト設定_広場
}

command マップ設定 食堂 廊下 男子トイレ 女子トイレ 広場 -set {

	//----- フォグ、カメラ、ロード
	@SS_フォグ_キャラ用ライト設定
}

command マップ設定 食堂 廊下 男子トイレ 女子トイレ 広場 -set {

	@カウンター処理設定

	//----- フォグ、カメラ、ロード
	@カメラ設定
	@ロード設定
}


if ($s:登場ポイント == Ｅ脚からダンボール) {
	// Ｅ脚１Ｆ→Ｃ脚（ダンボール移動）
	command マップ表示 -show 食堂

} else if($s:登場ポイント == ＢＣ連絡橋から) {
	// ＢＣ連絡橋→Ｃ脚
	command マップ表示 -show 広場
	mesg マップ接合 Ｃ脚接合４ on	// 広場 男子トイレ
	mesg マップ接合 Ｃ脚接合５ on	// 広場 女子トイレ

} else {
	// ＣＤ連絡橋→Ｃ脚
	command マップ表示 -show 廊下
}

mesg マップ接合 Ｃ脚接合３ on	// 廊下 広場

// レーダー当たり
command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 8
command 追加ＨＺＸグループ登録 -hzx_id 1 -add_id 8
command 追加ＨＺＸグループ登録 -hzx_id 2 -add_id 8
command 追加ＨＺＸグループ登録 -hzx_id 3 -add_id 8
command 追加ＨＺＸグループ登録 -hzx_id 4 -add_id 8

@ステージ進入時処理





//=============================================================================
// プロシージャ
//=============================================================================

//=============================================================================
// 基本設定
//=============================================================================
proc クリアリングカメラＯＦＦ {
#if d:DEBUG_PRINT
	print '*** Clearing Camera OFF ***'
#endif

	mesg サブ画面 子画面 off
	chara カメラ設定 クリアリングカメラ -s 0
}

//-----------------------------------------------------------------------------
// クリアリングエリア０設定
proc クリアリングエリア０_初期設定 {
#if d:DEBUG_PRINT
	print '*** Clearing Area 0: Init ***'
#endif

	command セットクリアリング \
		-p 0,1,6,クリアリングエリア０_ルートチェンジ１ \
		   0,2,1,クリアリングエリア０_ルートチェンジ２ \
		   0,3,4,クリアリングエリア０_ルートチェンジ２ \
		-i 0,1,6

	eval($f:クリアリングフラグ０ = 1)
}
proc クリアリングエリア０内チェック {
#if d:DEBUG_PRINT
	print '*** Clearing Area 0: Bounding Check ***'
#endif

	if(    (-63250 < $i:プレイヤー位置Ｘ) && ($i:プレイヤー位置Ｘ < -54750) \
		&& (-87500 < $i:プレイヤー位置Ｚ) && ($i:プレイヤー位置Ｚ < -81375)) {
	//	return 1;
		return 0;
	} else {
		return 0;
	}
}
proc クリアリングエリア０_ルートチェンジ１ {
#if d:DEBUG_PRINT
	print '*** Clearing Area 0: Route Change 1 ***'
#endif

	command ロッカー状態 -n ロッカー:02
	if(!($status & 0x2000) && ($status & 0x0001)) {
		command チェンジクリアリングルート 敵兵:22 -r 3 -p 0
	} else {
		command チェンジクリアリングルート 敵兵:22 -r 2 -p 0
	}
}
proc クリアリングエリア０_ルートチェンジ２ {
#if d:DEBUG_PRINT
	print '*** Clearing Area 0: Route Change 2 ***'
#endif

	command ロッカー状態 -n ロッカー:01
	if(!($status & 0x2000) && ($status & 0x0001)) {
		command チェンジクリアリングルート 敵兵:22 -r 5 -p 0
	} else {
		command チェンジクリアリングルート 敵兵:22 -r 4 -p 0
	}
}
proc クリアリングエリア０_終了 {
#if d:DEBUG_PRINT
	print '*** Clearing Area 0: End ***'
#endif

	eval($f:クリアリングフラグ０ = 0)
	@クリアリングカメラＯＦＦ
}

//-----------------------------------------------------------------------------
// クリアリングエリア１設定
proc クリアリングエリア１_初期設定 {
#if d:DEBUG_PRINT
	print '*** Clearing Area 1: Init ***'
#endif

	command セットクリアリング \
		-p 1,1,6,クリアリングエリア１_ルートチェンジ１ \
		   1,2,1,クリアリングエリア１_ルートチェンジ２ \
		   1,3,4,クリアリングエリア１_ルートチェンジ２ \
		   1,4,1,クリアリングエリア１_ルートチェンジ３ \
		   1,5,4,クリアリングエリア１_ルートチェンジ３ \
		   1,6,1,クリアリングエリア１_ルートチェンジ４ \
		   1,7,4,クリアリングエリア１_ルートチェンジ４ \
		-i 0,1,10

	eval($f:クリアリングフラグ１ = 1)
}
proc クリアリングエリア１内チェック {
#if d:DEBUG_PRINT
	print '*** Clearing Area 1: Bounding Check ***'
#endif

	if(    (-51750 < $i:プレイヤー位置Ｘ) && ($i:プレイヤー位置Ｘ < -43250) \
		&& (-87500 < $i:プレイヤー位置Ｚ) && ($i:プレイヤー位置Ｚ < -81375)) {
	//	return 1;
		return 0;
	} else {
		return 0;
	}
}
proc クリアリングエリア１_ルートチェンジ１ {
#if d:DEBUG_PRINT
	print '*** Clearing Area 1: Route Change 1 ***'
#endif

	command ロッカー状態 -n ロッカー:03
	if(!($status & 0x2000) && ($status & 0x0001)) {
		command チェンジクリアリングルート 敵兵:22 -r 3 -p 0
	} else {
		command チェンジクリアリングルート 敵兵:22 -r 2 -p 0
	}
}
proc クリアリングエリア１_ルートチェンジ２ {
#if d:DEBUG_PRINT
	print '*** Clearing Area 1: Route Change 2 ***'
#endif

	command ロッカー状態 -n ロッカー:04
	if(!($status & 0x2000) && ($status & 0x0001)) {
		command チェンジクリアリングルート 敵兵:22 -r 5 -p 0
	} else {
		command チェンジクリアリングルート 敵兵:22 -r 4 -p 0
	}
}
proc クリアリングエリア１_ルートチェンジ３ {
#if d:DEBUG_PRINT
	print '*** Clearing Area 1: Route Change 3 ***'
#endif

	command ロッカー状態 -n ロッカー:05
	if(!($status & 0x2000) && ($status & 0x0001)) {
		command チェンジクリアリングルート 敵兵:22 -r 7 -p 0
	} else {
		command チェンジクリアリングルート 敵兵:22 -r 6 -p 0
	}
}
proc クリアリングエリア１_ルートチェンジ４ {
#if d:DEBUG_PRINT
	print '*** Clearing Area 1: Route Change 4 ***'
#endif

	command ロッカー状態 -n ロッカー:06
	if(!($status & 0x2000) && ($status & 0x0001)) {
		command チェンジクリアリングルート 敵兵:22 -r 9 -p 0
	} else {
		command チェンジクリアリングルート 敵兵:22 -r 8 -p 0
	}
}
proc クリアリングエリア１_終了 {
#if d:DEBUG_PRINT
	print '*** Clearing Area 1: End ***'
#endif

	eval($f:クリアリングフラグ１ = 0)
	@クリアリングカメラＯＦＦ
}





//=============================================================================
// オブジェクト
//=============================================================================

//-----------------------------------------------------------------------------
// ドア設定
proc ドア設定 {
#if d:DEBUG_PRINT
	print '*** Door Set ***'
#endif

	// ドアフラグを元にモデルを設定(※全てのパターンのモデルを用意するのはもったいないので使うところのみ変更していく)
	// ドアモデル名セット $:配列番号 $:ドア名１(close) $:ドア名２(open) $:ドア名３(enemy) $:ドア名４(lv_close) $:ドア名５(lv_open)
	// 食堂と廊下のドア
	@ドアモデル名セット 0 d:DOOR_NAME1 d:DOOR_NAME1 d:DOOR_NAME1 d:DOOR_NAME2 d:DOOR_NAME2
	// 厨房と廊下のドア
	@ドアモデル名セット 1 d:DOOR_NAME1 d:DOOR_NAME1 d:DOOR_NAME1 d:DOOR_NAME2 d:DOOR_NAME2
	// ＢＣ連絡橋へのドア
	@ドアモデル名セット 2 d:DOOR_NAME3 d:DOOR_NAME3 d:DOOR_NAME3 d:DOOR_NAME_BC_LV1 d:DOOR_NAME_BC_LV1
	// ＣＤ連絡橋へのドア
	@ドアモデル名セット 3 d:DOOR_NAME_CD_LV0 d:DOOR_NAME_CD_LV0 d:DOOR_NAME_CD_LV0 d:DOOR_NAME3 d:DOOR_NAME3


	// ドア
	//   -m オブジェクト名  -d 向き  -p 場所  -slide スライド量  -time 時間  -between マップ名１ マップ名２  -exec { $:開閉フラグ }

	// 食堂と廊下のドア
	@ドアランプ設定 食堂と廊下のドアランプ 1024 -54625 0 -92500 2
	chara ドア 食堂と廊下のドア \
		-m $$s:ドアモデル名[0] \
		-d 0 1024 0 \
		-p -54625 0 -92500 \
		-s d:SD_SLIDE_INSIDE \
		-t d:SD_OPEN_TIME \
		-A 食堂と廊下のドアランプ \
		-b 廊下 食堂 \
		-exec {
			if(!($:開閉フラグ)) {
				mesg マップ接合 Ｃ脚接合１ off
				if($i:プレイヤー位置Ｘ > -54625) {
					mesg レンズフレア レンズフレア アルファ変更 0 1		// レンズフレア処理
				}
			} else {
				mesg マップ接合 Ｃ脚接合１ on
				mesg レンズフレア レンズフレア アルファ変更 8 1	// レンズフレア処理
			}
		}
	trap dr001 ？ -mask ？ \
		-exec {
			if($3 == 入る) {
				mesg ドア 食堂と廊下のドア open $2
			} else if($3 == 出る) {
				mesg ドア 食堂と廊下のドア close $2
			}
		}

	// 厨房と廊下のドア
	@ドアランプ設定 厨房と廊下のドアランプ 0 -48500 0 -96875 0
	chara ドア 厨房と廊下のドア \
		-m $$s:ドアモデル名[1] \
		-d 0 0 0 \
		-p -48500 0 -96875 \
		-s d:SD_SLIDE_INSIDE \
		-t d:SD_OPEN_TIME \
		-A 厨房と廊下のドアランプ \
		-b 廊下 食堂 \
		-exec {
			if(!($:開閉フラグ)) {
				mesg マップ接合 Ｃ脚接合２ off
				if($i:プレイヤー位置Ｚ > -96875) {
					mesg レンズフレア レンズフレア アルファ変更 0 1		// レンズフレア処理
				}
			} else {
				mesg マップ接合 Ｃ脚接合２ on
				mesg レンズフレア レンズフレア アルファ変更 8 1	// レンズフレア処理
			}
		}
	trap dr002 ？ -mask ？ \
		-exec {
			if($3 == 入る) {
				mesg ドア 厨房と廊下のドア open $2
			} else if($3 == 出る) {
				mesg ドア 厨房と廊下のドア close $2
			}
		}

	// ＢＣ連絡橋へのドア
	@ドアランプ設定 ＢＣ連絡橋へのドアランプ 0 -56750 0 -76375 1
//	@主観禁止壁     ＢＣ連絡橋へのドア壁       -56750 0 -76375 0 d:SD_SLIDE_OUTSIDE
	chara ドア ＢＣ連絡橋へのドア \
		-m $$s:ドアモデル名[2] \
		-d 0 0 0 \
		-p -56750 0 -76375 \
		-s d:SD_SLIDE_OUTSIDE \
		-t d:SD_OPEN_TIME \
		-A ＢＣ連絡橋へのドアランプ \
		-b 広場 広場 \
		-exec {
			if(!($:開閉フラグ)) {
				mesg プットオブジェ ＢＣ連絡橋ロード部 off				// ロード部モデル
				mesg ローカル風 隙間風 オフ
			} else {
				mesg プットオブジェ ＢＣ連絡橋ロード部 on				// ロード部モデル
				mesg ローカル風 隙間風 オン
			}
		}
	trap dr003 ？ -mask ？ \
		-exec {
			if($3 == 入る) {
				mesg ドア ＢＣ連絡橋へのドア open $2
			} else if($3 == 出る) {
				mesg ドア ＢＣ連絡橋へのドア close $2
			}
		}
	trap dr003 d:PLAYER -mask ？ \
		-state d:TRP_STATE_SUBJECT \
		-exec {
			if($3 == 入る) {
				mesg 透明壁 ＢＣ連絡橋へのドア壁 on
			} else if($3 == 出る) {
				mesg 透明壁 ＢＣ連絡橋へのドア壁 off
			}
		}

	// ＣＤ連絡橋へのドア
	@ドアランプ設定 ＣＤ連絡橋へのドアランプ 3072 -42625 0 -101000 0
//	@主観禁止壁     ＣＤ連絡橋へのドア壁          -42625 0 -101000 3072 d:SD_SLIDE_OUTSIDE
	chara ドア ＣＤ連絡橋へのドア \
		-m $$s:ドアモデル名[3] \
		-d 0 3072 0 \
		-p -42625 0 -101000 \
		-s d:SD_SLIDE_OUTSIDE \
		-t d:SD_OPEN_TIME \
		-A ＣＤ連絡橋へのドアランプ \
		-b 廊下 廊下 \
		-exec {
			if(!($:開閉フラグ)) {
				mesg プットオブジェ ＣＤ連絡橋ロード部 off				// ロード部モデル
				mesg ローカル風 隙間風 オフ
			} else {
				mesg プットオブジェ ＣＤ連絡橋ロード部 on				// ロード部モデル
				mesg ローカル風 隙間風 オン
			}
		}
	trap dr004 ？ -mask ？ \
		-exec {
			if($3 == 入る) {
				mesg ドア ＣＤ連絡橋へのドア open $2
			} else if($3 == 出る) {
				mesg ドア ＣＤ連絡橋へのドア close $2
			}
		}
	trap dr004 d:PLAYER -mask ？ \
		-state d:TRP_STATE_SUBJECT \
		-exec {
			if($3 == 入る) {
				mesg 透明壁 ＣＤ連絡橋へのドア壁 on
			} else if($3 == 出る) {
				mesg 透明壁 ＣＤ連絡橋へのドア壁 off
			}
		}
}

proc A_廊下ドア開閉設定 {
	@A_ドア開閉追加設定  ＣＤ連絡橋へのドア $$b:ドアフラグ[3] -42625 0 -101000 3072 d:SD_SLIDE_OUTSIDE
}

proc A_広場ドア開閉設定 {
	@A_ドア開閉追加設定  ＢＣ連絡橋へのドア $$b:ドアフラグ[2] -56750 0 -76375 0 d:SD_SLIDE_OUTSIDE
}

proc A_食堂ドア開閉設定 {
	@A_ドア開閉追加設定 食堂と廊下のドア $$b:ドアフラグ[0] -54625 0 -92500 1024 d:SD_SLIDE_INSIDE
	@A_ドア開閉追加設定  厨房と廊下のドア $$b:ドアフラグ[1] -48500 0 -96875 0 d:SD_SLIDE_INSIDE
}

//-----------------------------------------------------------------------------
// ロッカー設定
proc ロッカー設定 {
#if d:DEBUG_PRINT
	print '*** Locker Set ***'
#endif

	chara ロッカー管理 管理人さん -n 6
	command ロッカーモーション -motion locker
	command プレイヤーロッカーモーション -motion sna_locker

	// $:ロッカー名 $:トラップ名 $:番号 $:モデル名 $:Ｘ座標 $:Ｙ座標 $:Ｚ座標 $:ステータス $:壁音番号 $:倒れ時床音番号 $:フラグ $:倒れシフトＸ $:倒れシフトＹ $:倒れシフトＺ $:倒れ回転Ｙ $:影ＩＤ {
	@SS_北ロッカー登録 ロッカー:01 lk001 0 (d:DOOR_NAME7)  -60000 0 -85500 (d:LOCKER_STATE_POSTER)      4 4 (d:LOCKER_FLAG_TOILET)  0 0 -100 -160 (0)
	@SS_北ロッカー登録 ロッカー:02 lk002 1 (d:DOOR_NAME6)  -58875 0 -85500 (0)                          4 4 (d:LOCKER_FLAG_TOILET)  0 0    0 -110 (0)
	@SS_北ロッカー登録 ロッカー:03 lk003 2 (d:DOOR_NAME6)  -46625 0 -85500 (0)                          4 4 (d:LOCKER_FLAG_TOILET)  0 0    0 -100 (0)
	@SS_北ロッカー登録 ロッカー:04 lk004 3 (d:DOOR_NAME6)  -45500 0 -85500 (0)                          4 4 (d:LOCKER_FLAG_TOILET)  0 0  100  -90 (0)
	@SS_北ロッカー登録 ロッカー:05 lk005 4 (d:DOOR_NAME6)  -44375 0 -85500 (0)                          4 4 (d:LOCKER_FLAG_TOILET) 30 0   50 -130 (0)
	@SS_北ロッカー登録 ロッカー:06 lk006 5 (d:DOOR_NAME6)  -43250 0 -85500 (d:LOCKER_STATE_NO_OPEN_SEG) 4 4 (d:LOCKER_FLAG_TOILET)  0 0  150  -80 (0)
}

//-----------------------------------------------------------------------------
// CB_ロッカーチェック
proc SS_CB_ロッカーチェック $:番号 {
#if d:DEBUG_PRINT
	print '*** SS CB Locker Check ***'
#endif

	@壊れ物再セットチェック $b:w16a_破壊ロード回数[$:番号]
	if($f:再セットフラグ) {
		eval($i:w16a_ロッカー状態[$:番号] = 0)
	}

	return $i:w16a_ロッカー状態[$:番号]
}

//-----------------------------------------------------------------------------
// CB_ロッカー状態保存
proc SS_CB_ロッカー状態保存 $:開始終了 $:実行キャラ $:行動 $:ロッカー名 {
#if d:DEBUG_PRINT
	print '*** SS CB Locker Save ***'
#endif

	// ロッカー名と番号の対応
	if($:ロッカー名 == ロッカー:01) {
		eval($i:SS_ロッカー番号 = 0)
	} else if($:ロッカー名 == ロッカー:02) {
		eval($i:SS_ロッカー番号 = 1)
	} else if($:ロッカー名 == ロッカー:03) {
		eval($i:SS_ロッカー番号 = 2)
	} else if($:ロッカー名 == ロッカー:04) {
		eval($i:SS_ロッカー番号 = 3)
	} else if($:ロッカー名 == ロッカー:05) {
		eval($i:SS_ロッカー番号 = 4)
	} else if($:ロッカー名 == ロッカー:06) {
		eval($i:SS_ロッカー番号 = 5)
	}

	// 状態保存
	if(($:行動 != 6) && ($:行動 != 8)) {
		// 状態変化時
		eval($b:w16a_破壊ロード回数[$i:SS_ロッカー番号] = $w:グローバルロード回数);

	} else if($:行動 == 8) {
		// ステージ終了時
		command ロッカー状態 -n $:ロッカー名
		eval($i:w16a_ロッカー状態[$i:SS_ロッカー番号] = $status)
	}
}

//-----------------------------------------------------------------------------
// CB_ロッカー実行
proc SS_CB_ロッカー実行 $:トラップ名 $:フラグ $:トリガ $:ＰＸ $:ＰＹ $:ＰＺ {
#if d:DEBUG_PRINT
	print '*** SS CB Locker ***'
#endif

	//---------------------------------------------------------
	// 開閉実行処理
	if($:フラグ == 0) {

		if($:トラップ名 == lk001) {
			command ロッカー状態 -n ロッカー:01
			mesg プレイヤー d:PLAYER locker ロッカー:01 $status 2048,512 (-60000+70),(-85500+70)
		} else if($:トラップ名 == lk002) {
			command ロッカー状態 -n ロッカー:02
			mesg プレイヤー d:PLAYER locker ロッカー:02 $status 2048,512 (-58875+70),(-85500+70)
		} else if($:トラップ名 == lk003) {
			command ロッカー状態 -n ロッカー:03
			mesg プレイヤー d:PLAYER locker ロッカー:03 $status 2048,512 (-46625+70),(-85500+70)
		} else if($:トラップ名 == lk004) {
			command ロッカー状態 -n ロッカー:04
			mesg プレイヤー d:PLAYER locker ロッカー:04 $status 2048,512 (-45500+70),(-85500+70)
		} else if($:トラップ名 == lk005) {
			command ロッカー状態 -n ロッカー:05
			mesg プレイヤー d:PLAYER locker ロッカー:05 $status 2048,512 (-44375+70),(-85500+70)
		} else if($:トラップ名 == lk006) {
			command ロッカー状態 -n ロッカー:06
			mesg プレイヤー d:PLAYER locker ロッカー:06 $status 2048,512 (-43250+70),(-85500+70)
		}

	//---------------------------------------------------------
	// 開閉カメラ処理
	} else {
		if($:トラップ名 == lk001) {
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p (-60000-940),3708,-83441 \
				-t (-60000-564),1853,-84770 \
				-a 200 \
				-i 0 2 0 0 \
				-s $3
		} else if($:トラップ名 == lk002) {
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p (-58875-940),3708,-83441 \
				-t (-58875-564),1853,-84770 \
				-a 200 \
				-i 0 2 0 0 \
				-s $3
		} else if($:トラップ名 == lk003) {
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p (-46625-940),3708,-83441 \
				-t (-46625-564),1853,-84770 \
				-a 200 \
				-i 0 2 0 0 \
				-s $3
		} else if($:トラップ名 == lk004) {
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p (-45500-940),3708,-83441 \
				-t (-45500-564),1853,-84770 \
				-a 200 \
				-i 0 2 0 0 \
				-s $3
		} else if($:トラップ名 == lk005) {
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p (-44375-940),3708,-83441 \
				-t (-44375-564),1853,-84770 \
				-a 200 \
				-i 0 2 0 0 \
				-s $3
		} else if($:トラップ名 == lk006) {
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p (-43250-940),3708,-83441 \
				-t (-43250-564),1853,-84770 \
				-a 200 \
				-i 0 2 0 0 \
				-s $3
		}
	}
}



//-----------------------------------------------------------------------------
// 爆弾解体設定
proc 爆弾解体設定 {
#if d:DEBUG_PRINT
	print '*** Bomb Set ***'
#endif

	// 爆弾解体設定
	//   $:爆弾名 $:処理状態フラグ $:Ｘ座標 $:Ｙ座標 $:Ｚ座標 $:Ｘ回転 $:Ｙ回転 $:Ｚ回転
	@SS_爆弾解体設定_CB使用 w16b匂い爆弾 $f:w16b_爆弾処理完了 -48000 3275 -87000 0 2048 2048

	if($w:p_story >= d:ST:P014_15_P07ピーター遭遇１５ポリゴンデモ７終了) {
		chara 解体Ｃ４ ピーターＣ４ \
			-position (d:_PETER_X+638) 1000 (d:_PETER_Z+300) \
			-rotate -1024 (1024+2048) 0 \
			-type  0 \
			-state 1
	}
}

proc SS_CB_爆弾解体後処理 {
#if d:DEBUG_PRINT
	print '*** SS CB Bomb Frozen ***'
#endif

	if($2 == 1) {	// 解体時
//		if($b:Ｃ４爆弾設置数 == $b:Ｃ４爆弾処理数 + 2) {
		if(`@rp_爆弾解体脚数` == 4) {
			mesg プットオブジェ 冷蔵庫ドア kill
			mesg レーダー光点 ピーター光点 kill
			command 追加ＨＺＸグループ削除 -hzx_id 0 -add_id 5
			command 追加ＨＺＸグループ削除 -hzx_id 0 -add_id 9
			command 追加ＨＺＸグループ削除 -hzx_id 1 -add_id 9
			command 追加ＨＺＸグループ削除 -hzx_id 2 -add_id 9
			command 追加ＨＺＸグループ削除 -hzx_id 3 -add_id 9
			command 追加ＨＺＸグループ削除 -hzx_id 4 -add_id 9
		}
	}

	@爆弾解体後処理 $1 $2
}





