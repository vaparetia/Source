}//d


//●ＳＡＶＥ失敗  h//e
//・メモリーカードがない h //e
resource TO_ＳＡＶＥ失敗メモリーカードない__f {
//ns
オタコン_000: {
H&'e, il n'y a pas de MEMORY CARD (PS2)
dans la fente pour MEMORY CARD !
}
//	<<<ENGLISH>>>
//	Hey, there's no MEMORY CARD
//	(PlayStation&@R2) in the MEMORY
//	CARD slot.

/*あ、＃｛ＭＥＭＯＲＹ、メモリー｝＃ ＃｛ＣＡＲＤ、カード｝＃差込口に
＃｛"PlaySation2"、ピーエスツー｝＃専用メモリーカードが
ささってないよ。
*/

オタコン_001: {
Il est impossible de sauvegarder si tu n'as
pas ins&'er&'e de MEMORY CARD (PS2) dans
la fente.
}
//	<<<ENGLISH>>>
//	Saving can't be done unless you have
//	a MEMORY CARD (PlayStation&@R2)
//	ready.

/*＃｛記録、セーブ｝＃するには＃｛"PlaySation2"、ピーエスツー｝＃専用
メモリーカードが必要なんだ。
*/

オタコン_002: {
Il faut placer la MEMORY CARD (PS2)
dans la fente pour MEMORY CARD.
}
//	<<<ENGLISH>>>
//	You need to set the MEMORY CARD
//	(PlayStation&@R2) in the MEMORY CARD
//	slot.

/*＃｛ＭＥＭＯＲＹ、メモリー｝＃ ＃｛ＣＡＲＤ、カード｝＃差込口に
＃｛"PlaySation2"、ピーエスツー｝＃専用メモリーカードを
セットしてくれ。
*/
}//d


//・空き領域がない h //e
resource TO_ＳＡＶＥ失敗空領域ない__f {
//ns
オタコン_000: {
Oh, non ! Snake, il n'y avait plus assez
d'espace libre sur la MEMORY CARD
(PS2) pour sauvegarder la partie.
}
//	<<<ENGLISH>>>
//	Oh no. Snake, there wasn't enough
//	space left on the MEMORY CARD
//	(PlayStation&@R2) to save the game.

/*うーん。スネーク、＃｛"PlaySation2"、ピーエスツー｝＃専用
メモリーカードに空き領域がなくて
＃｛記録、セーブ｝＃出来なかったよ。
*/

}//d


//・フォーマットしようとしない  h //e
resource TO_ＳＡＶＥ失敗フォーマットしようとしない__f {
//ns
オタコン_000: {
D&'esol&'e, mais il est impossible de
sauvegarder &`a moins d'avoir fait un
formatage.
}
//	<<<ENGLISH>>>
//	Scuse me but -- you can't save
//	unless you format, you know.


/*あのー、フォーマットしないと＃｛記録、セーブ｝＃は
出来ないんだけど、わかってる？
*/

}//d


//・その他エラー  h //e
resource TO_ＳＡＶＥ失敗その他エラー__f {
//ns
オタコン_000: {
Je suis vraiment navr&'e, Snake. Il y a eu
une erreur et je n'ai pas pu sauvegarder.
}
//	<<<ENGLISH>>>
//	I'm really sorry, Snake.
//	There was an error and
//	I couldn't save.

/*スネーク、ごめん。エラーが起きて
＃｛記録、セーブ｝＃できなかった。
*/

}//d


//●ＳＡＶＥ失敗緊迫  h//e
//・メモリーカードがない緊迫 h //e
resource TO_ＳＡＶＥ失敗メモリーカードない緊迫__f {
//ns
オタコン_000: {
Il n'y a pas de MEMORY CARD
(PS2) dans la fente pour
MEMORY CARD !
}
//	<<<ENGLISH(2)>>>
//	There's no MEMORY CARD
//	(PlayStation&@R2) in the MEMORY
//	CARD slot!

/*あ、＃｛ＭＥＭＯＲＹ、メモリー｝＃ ＃｛ＣＡＲＤ、カード｝＃差込口に
＃｛"PlaySation2"、ピーエスツー｝＃専用メモリーカードが
ささってない！
*/

オタコン_001: {
Si tu n'as pas ins&'er&'e
de MEMORY CARD (PS2),
je ne peux pas sauvegarder, moi !
}
//	<<<ENGLISH>>>
//	I can't save unless you have a
//	MEMORY CARD (PlayStation&@R2)
//	ready!

/*＃｛記録、セーブ｝＃するには＃｛"PlaySation2"、ピーエスツー｝＃専用
メモリーカードが必要なんだ！
*/

オタコン_002: {
Place la MEMORY CARD (PS2)
dans la fente pour MEMORY CARD !
Tout de suite !
}
//	<<<ENGLISH>>>
//	Set the MEMORY CARD
//	(PlayStation&@R2) in the
//	MEMORY CARD slot now!

/*＃｛ＭＥＭＯＲＹ、メモリー｝＃ ＃｛ＣＡＲＤ、カード｝＃差込口に
＃｛"PlaySation2"、ピーエスツー｝＃専用メモリーカードを
セットしてくれ！
*/
}//d


