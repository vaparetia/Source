//●ＳＡＶＥメニューが出る前 d//e
//・普通 h//e
resource TO_ＳＡＶＥ前普通１__f{
オタコン_000: {
Tu veux faire une sauvegarde, Snake ?
}
//	<<<ENGLISH>>>
//	Do you want to save, Snake?

/*＃｛記録、セーブ｝＃するかい、スネーク？*/
}//d

resource TO_ＳＡＶＥ前普通２__f{
オタコン_000: {
Il est temps de sauvegarder ?
}
//	<<<ENGLISH>>>
//	Time to save?

/*＃｛記録、セーブ｝＃だね？*/
}//d

resource TO_ＳＡＶＥ前普通３__f {
オタコン_000: {
Ah, tu veux sauvegarder ! Une seconde !
}
//	<<<ENGLISH>>>
//	Oh, you need to save. Just a second.

/*ああ、＃｛記録、セーブ｝＃だね？すぐ準備する。*/
}//d

resource TO_ＳＡＶＥ前普通４__f {
オタコン_000: {
Oh, Snake, tu veux faire une sauvegarde
?
}
//	<<<ENGLISH>>>
//	Oh, Snake, you want to save?

/*スネーク、＃｛記録、セーブ｝＃したいのかい？*/
}//d


//・緊迫状態 h//e
resource TO_ＳＡＶＥ前緊迫１__f {
オタコン_000: {
Tu veux sauvegarder, hein, Snake ?
}
//	<<<ENGLISH>>>
//	Need to save, right, Snake?

/*＃｛記録、セーブ｝＃だね、スネーク？*/
}//d

resource TO_ＳＡＶＥ前緊迫２__f {
オタコン_000: {
&~Qa va, Snake ?
Je peux sauvegarder d&`es
que tu seras pr&^et.
}
//	<<<ENGLISH>>>
//	You all right, Snake?
//	I'm ready to save whenever you are.

/*大丈夫かい、スネーク？
＃｛記録、セーブ｝＃の準備なら出来てるよ？
*/
}//d

resource TO_ＳＡＶＥ前緊迫３__f {
オタコン_000: {
Snake !
Heureusement, je peux faire une
sauvegarde rapide si tu veux.
}
//	<<<ENGLISH>>>
//	Snake! Thank God!
//	I can do a quick save if you need.

/*スネーク！無事かい？
＃｛記録、セーブ｝＃ならすぐ出来るよ
*/
}//d

resource TO_ＳＡＶＥ前緊迫４__f {
オタコン_000: {
Snake ! Tu as besoin de sauvegarder ?
}
//	<<<ENGLISH>>>
//	Snake! Do you need to save?

/*スネーク！＃｛記録、セーブ｝＃かい？*/
}//d




//記録するメニューを選ばなかった場合  h//e
//普通 //e
resource TO_未セーブ終了普通１__f {
//ns
オタコン_000: {
Bien ! A la prochaine, Snake !
}
//	<<<ENGLISH>>>
//	OK, see you, Snake.

/*じゃあね、スネーク。*/
}//d

resource TO_未セーブ終了普通２__f {
//ns
オタコン_000: {
Tiens bon !
}
//	<<<ENGLISH(2)>>>
//	Hang in there.

/*がんばってくれよ*/
}//d

resource TO_未セーブ終了普通３__f {
//ns
オタコン_000: {
Ah, tu ne sauvegardes pas ? Comme tu
veux ! Quand tu voudras le faire, fais-moi
signe !
}
//	<<<ENGLISH>>>
//	Oh, you're not going to save?
//	Well, okay, just let me know
//	when you need to.

/*なんだ、＃｛記録、セーブ｝＃しないのかい？
ま、いいや。＃｛記録、セーブ｝＃したくなったら、
また連絡してくれ。
*/
}//d

resource TO_未セーブ終了普通４__f {
//ns
オタコン_000: {
Bon, Snake ! Ne te mets pas dans le
p&'etrin !
}
//	<<<ENGLISH>>>
//	OK, Snake. Stay out of trouble.

/*ＯＫ。スネーク、気をつけて。*/
}//d

resource TO_未セーブ終了普通５__f {
//ns
オタコン_000: {
Ecoute, Snake, cette fr&'equence est
r&'eserv&'ee aux sauvegardes.
Tu ne t'en souviens pas ?
}
/*スネーク、これは＃｛記録、セーブ｝＃専用の
回線なんだけど……。
Look, Snake, this frequency is
for saving only. Remember?
*/
}//d


//・緊迫 //e
resource TO_未セーブ終了緊迫１__f {
//ns
オタコン_000: {
Tiens bon, Snake !
}
//	<<<ENGLISH>>>
//	Hang in there, Snake!

/*頑張ってくれよ、スネーク！*/
}//d

resource TO_未セーブ終了緊迫２__f {
//ns
オタコン_000: {
Quand tu voudras sauvegarder, fais-le-moi
savoir, hein ? Ne les laisse pas prendre le
dessus !
}
//	<<<ENGLISH>>>
//	Let me know as soon as you
//	need to save, okay? Don't let
//	them get you!

/*＃｛記録、セーブ｝＃が必要になったらすぐ
連絡してくれ。負けるなよ！
*/
}//d

resource TO_未セーブ終了緊迫３__f {
//ns
オタコン_000: {
Ne baisse pas les bras !
}
//	<<<ENGLISH(2)>>>
//	Don't give up!

/*あきらめないでくれよ！*/
}//d

resource TO_未セーブ終了緊迫４__f {
//ns
オタコン_000: {
Snake ! Il faut que tu restes en vie !
}
//	<<<ENGLISH>>>
//	Snake!
//	You've got to stay alive!

/*勝つんだ、スネーク！*/
}//d


//・汎用無言 //e
resource TO_無言__f {
//ns
オタコン_000: {
...
}
