	print 'スネーク「どうした？」'
	print 'オタコン「い、いや、何でもない。何でもないよ……」'
	print 'オタコン「で、でもこれはメタルギアの写真じゃないね。悪いけど、撮り直してくれ」'
	@rto_電送装置アクセス時判定ＮＧ謎
/*
	vox t:vc012501 {
		puppet ero1
		talk オタコン 標準 -m {
			[オタコンおもしろ評価:オタコン＿保存しとこ＿１]
		}
		talk スネーク 標準 -m {
			[オタコンおもしろ評価:オタコン＿保存しとこ＿２]
		}
		puppet ero2
		talk オタコン 標準 -m {
			[オタコンおもしろ評価:オタコン＿保存しとこ＿３]
		}
		talk オタコン 標準 -m {
			[オタコンおもしろ評価:オタコン＿保存しとこ＿４]
		}
	}
*/

}


proc オタコン保存しとこ {
	puppet ero3

	print 'オタコン「……保存しとこ」'
	@rto_電送装置アクセス時判定ＮＧ謎＿保存しとこ
/*
	vox t:vc012502 {
		talk オタコン 標準 -m {
			[オタコンおもしろ評価:オタコン＿保存しとこ＿５]
		}
	}
*/
}


proc オタコンキレ気味 {

	if($b:デジカメキレ気味カウンター <= 5){

		if($b:デジカメキレ気味カウンター <= 2){
			puppet ngMuch1
		}else{
			puppet ngHomo2
		}

		rand 3
		if($status == 0){
			print 'オタコン「……何コレ？スネーク、遊んでるんじゃないんだ」'
			@rto_電送装置アクセス時判定ＮＧとんでもない１
/*
			vox t:vc012101 {
				talk オタコン 標準 -m {
					[オタコン評価実体:オタコン＿ＮＧ回数大＿１]
				}
			}
*/
		}else if($status == 1){
			print 'オタコン「スネーク……。もうちょっと真面目にやってくれ。頼むからさ」'
			@rto_電送装置アクセス時判定ＮＧとんでもない２
/*
			vox t:vc012102 {
				talk オタコン 標準 -m {
					[オタコン評価実体:オタコン＿ＮＧ回数大＿２]
				}
			}
*/
		}else{
			print 'オタコン「君、任務のこと忘れてない」'
			@rto_電送装置アクセス時判定ＮＧとんでもない３
/*
			vox t:vc012103 {
				talk オタコン 標準 -m {
					[オタコン評価実体:オタコン＿ＮＧ回数大＿３]
				}
			}
*/
		}

		eval($b:デジカメキレ気味カウンター = $b:デジカメキレ気味カウンター + 1)

	}else{
		@オタコン怒り

	}


}



proc オタコン怒り {
	puppet ikari1
	puppet ikari2 -loop

	print 'オタコン「もうやめてくれ！いやがらせか！？」'
	@rto_電送装置アクセス時判定ＮＧ心霊３
/*
	vox t:vc012901 {
		talk オタコン 標準 -m {
			[オタコンおもしろ評価:オタコン＿心霊写真＿４]
		}
	}
*/
}



proc オタコン評価終了判定 {

	print '評価終了判定開始'

	if($f:デジカメ写真１枚も無い){
		eval($f:デジカメ端末終了ＯＫ = 1)
	}

	if($f:メタル正面撮影成功 && $f:メタル右側撮影成功 && $f:メタル左側撮影成功 && $f:メタルＭＡＲＩＮＥＳ撮影成功){
		eval($f:タンカー編クリア許可 = 1)

		wait (300 * 1)		//1秒

		puppet complete

		print 'オタコン「よし、これで全部の写真が揃った……」'
		@rto_電送装置アクセス時判定全部ＯＫ
/*
		vox t:vc013001 {
			talk オタコン 標準 -m {
				[オタコン評価終了判定:オタコン＿クリア完璧]
			}
		}
*/

		@もう演説が終わる
		@写真はもう十分

		eval($f:デジカメ端末終了ＯＫ = 1)

	}else if(!$f:デジカメ写真これで最後){
		eval($b:タンカーデジカメ今何枚目 = $b:タンカーデジカメ今何枚目 + 1)
		eval($f:デジカメ写真表示これが１枚目 = 0)

		keywait


	}else{

		wait (300 * 1)		//1秒

		if($f:メタル右側撮影成功 && $f:メタル左側撮影成功 && $f:メタルＭＡＲＩＮＥＳ撮影成功 ){

			if($w:ゲーム設定 <= d:LEVEL_NORMAL \
#ifndef JAPANESE
			&& $i:船倉演説残り時間 < 60 * 30 \
#endif
			&& $f:デジカメ写真これで最後){

				@もう演説が終わる

				puppet resign

				print 'オタコン「正面からの写真はあきらめることにする…」'
				@rto_船倉演説終わる前に２
/*
				vox t:vc010102 {
					talk オタコン 標準 -m {
						[オタコン評価終了判定:オタコン＿クリア妥協＿正面]
					}
				}
*/

				@写真はもう十分

			}else{
				puppet norm

				print 'オタコン「右、左からのとマーキングの写真はもらったのでいける。あとはメタルギアを前から撮ったやつだけだ。頼むよ」'
				@rto_船倉残り写真１２
/*
				vox t:vc010812 {
					talk オタコン 標準 -m {
						[オタコン評価終了判定:オタコン＿残りは正面]
					}
				}
*/

				@時間切れ判定

			}


		}else if($f:メタル正面撮影成功 && $f:メタル左側撮影成功 && $f:メタルＭＡＲＩＮＥＳ撮影成功 && $f:デジカメ写真これで最後){

			if($w:ゲーム設定 <= d:LEVEL_NORMAL \
#ifndef JAPANESE
			&& $i:船倉演説残り時間 < 60 * 30 \
#endif
			&& $f:デジカメ写真これで最後){

				@もう演説が終わる

				puppet resign

				print 'オタコン「右からの写真はあきらめることにする…」'
				@rto_電送装置アクセス時判定あきらめ３
/*
				vox t:vc013103 {
					talk オタコン 標準 -m {
						[オタコン評価終了判定:オタコン＿クリア妥協＿右]
					}
				}
*/
				@写真はもう十分

			}else{
				puppet norm

				print 'オタコン「左、前からのとマーキングの写真はもらった。残る１枚。メタルギアを右から撮ったやつだけだ。もう少しだよ！」'
				@rto_船倉残り写真１４
/*
				vox t:vc010814 {
					talk オタコン 標準 -m {
						[オタコン評価終了判定:オタコン＿残りは右]
					}
				}
*/

				@時間切れ判定

			}


		}else if($f:メタル正面撮影成功 && $f:メタル右側撮影成功 && $f:メタルＭＡＲＩＮＥＳ撮影成功 ){

			if($w:ゲーム設定 <= d:LEVEL_NORMAL \
#ifndef JAPANESE
			&& $i:船倉演説残り時間 < 60 * 30 \
#endif
			&& $f:デジカメ写真これで最後){

				@もう演説が終わる

				puppet resign

				print 'オタコン「左からの写真はあきらめることにする…」'
				@rto_電送装置アクセス時判定あきらめ４
/*
				vox t:vc013104 {
					talk オタコン 標準 -m {
						[オタコン評価終了判定:オタコン＿クリア妥協＿左]
					}
				}
*/
				@写真はもう十分
			}else{
				puppet norm

				print 'オタコン「右、前からのとマーキングの写真は終了。あとほしいのは、メタルギアを左から撮った写真だけだ。よろしく」'
				@rto_船倉残り写真１３
/*
				vox t:vc010813 {
					talk オタコン 標準 -m {
						[オタコン評価終了判定:オタコン＿残りは左]
					}
				}
*/
				@時間切れ判定

			}

		}else if($f:メタル正面撮影成功 && $f:メタル右側撮影成功 && $f:メタル左側撮影成功 ){

			if($w:ゲーム設定 <= d:LEVEL_NORMAL \
#ifndef JAPANESE
			&& $i:船倉演説残り時間 < 60 * 30 \
#endif
			&& $f:デジカメ写真これで最後){

				@もう演説が終わる

				puppet resign

				print 'オタコン「ＭＡＲＩＮＥＳ」のマーキングの写真はあきらめることにする…」'
				@rto_電送装置アクセス時判定あきらめ５
/*
				vox t:vc013105 {
					talk オタコン 標準 -m {
						[オタコン評価終了判定:オタコン＿クリア妥協＿ＭＡＲＩＮＥＳ]
					}
				}
*/
				@写真はもう十分
			}else{
				puppet norm

				print 'オタコン「右、前、左からの写真はＯＫだ。残りは「ＭＡＲＩＮＥＳ」のマーキングのアップだけ。あとひと頑張りだ」'
				@rto_船倉残り写真１１
/*
				vox t:vc010811 {
					talk オタコン 標準 -m {
						[オタコン評価終了判定:オタコン＿残りはＭＡＲＩＮＥＳ]
					}
				}
*/
				@時間切れ判定

			}



		}else{
			puppet norm

			if($f:メタル右側撮影成功 && $f:メタル左側撮影成功){
				print 'オタコン「右からと左からの写真はもらった。あと２枚、前からと「ＭＡＲＩＮＥＳ」のマーキングのアップを頼むよ」'
				@rto_船倉残り写真５
/*
				vox t:vc010805 {
					talk オタコン 標準 -m {
						[オタコン評価終了判定:オタコン＿残りは正面とＭＡＲＩＮＥＳ＿１]
					}
					talk オタコン 標準 -m {
						[オタコン評価終了判定:オタコン＿残りは正面とＭＡＲＩＮＥＳ＿２]
					}
				}
*/
			}else if($f:メタル右側撮影成功 && $f:メタル正面撮影成功){
				print 'オタコン「右からと前からの写真はＯＫだ。あとは左からと「ＭＡＲＩＮＥＳ」のマーキングのアップの２枚だ。よろしく」'
				@rto_船倉残り写真６
/*
				vox t:vc010806 {
					talk オタコン 標準 -m {
						[オタコン評価終了判定:オタコン＿残りは左とＭＡＲＩＮＥＳ]
					}
				}
*/
			}else if($f:メタル右側撮影成功 && $f:メタルＭＡＲＩＮＥＳ撮影成功){
				print 'オタコン「右からのとマーキングの写真は合格だ。残り２枚、左からと前からのを撮ってきてくれ」'
				@rto_船倉残り写真７
/*
				vox t:vc010807 {
					talk オタコン 標準 -m {
						[オタコン評価終了判定:オタコン＿残りは左と正面]
					}
				}
*/
			}else if($f:メタル左側撮影成功 && $f:メタルＭＡＲＩＮＥＳ撮影成功){
				print 'オタコン「左からのとマーキングの写真はもらっとのでいけると思う。あと必要なのは２枚・右からと前からのだ。頼むよ」'
				@rto_船倉残り写真８
/*
				vox t:vc010808 {
					talk オタコン 標準 -m {
						[オタコン評価終了判定:オタコン＿残りは右と正面]
					}
				}
*/
			}else if($f:メタル左側撮影成功 && $f:メタル正面撮影成功){
				print 'オタコン「左からのと前からの写真はＯＫだ。右からのと「ＭＡＲＩＮＥＳ」のマーキングのアップを撮ってきてほしい」'
				@rto_船倉残り写真９
/*
				vox t:vc010809 {
					talk オタコン 標準 -m {
						[オタコン評価終了判定:オタコン＿残りは右とＭＡＲＩＮＥＳ]
					}
				}
*/
			}else if($f:メタルＭＡＲＩＮＥＳ撮影成功 && $f:メタル正面撮影成功){
				print 'オタコン「前からのとマーキングの写真は十分だ。残りは２枚。メタルギアを右からと左からそれぞれ撮って送ってくれ」'
				@rto_船倉残り写真１０
/*
				vox t:vc010810 {
					talk オタコン 標準 -m {
						[オタコン評価終了判定:オタコン＿残りは右と左]
					}
				}
*/









			}else if($f:メタル右側撮影成功){
				print 'オタコン「右からの写真はＯＫだ。あとは、左、前、「ＭＡＲＩＮＥＳ」のマーキングのアップ、の３枚だ。頼むよ」'
				@rto_船倉残り写真１
/*
				vox t:vc010801 {
					talk オタコン 標準 -m {
						[オタコン評価終了判定:オタコン＿残りは左と前とＭＡＲＩＮＥＳ]
					}
				}
*/

			}else if($f:メタル左側撮影成功){
				print 'オタコン「左からの写真はこれでいい。あと３枚だ。右から、前から、「ＭＡＲＩＮＥＳ」のマーキングのアップ。よろしく」'
				@rto_船倉残り写真２
/*
				vox t:vc010802 {
					talk オタコン 標準 -m {
						[オタコン評価終了判定:オタコン＿残りは右と正面とＭＡＲＩＮＥＳ]
					}
				}
*/

			}else if($f:メタル正面撮影成功){
				print 'オタコン「前からの写真はこれでいく。残りは３枚。右、左、「ＭＡＲＩＮＥＳ」のマーキングのアップだ」'
				@rto_船倉残り写真３
/*
				vox t:vc010803 {
					talk オタコン 標準 -m {
						[オタコン評価終了判定:オタコン＿残りは右と左とＭＡＲＩＮＥＳ]
					}
				}
*/

			}else if($f:メタルＭＡＲＩＮＥＳ撮影成功){
				print 'オタコン「マーキングの写真はＯＫだ。必要な写真はあと３枚。メタルギアをそれぞれ右から、左から、前から撮ったものだ」'
				@rto_船倉残り写真４
/*
				vox t:vc010804 {
					talk オタコン 標準 -m {
						[オタコン評価終了判定:オタコン＿残りは右と左と正面]
					}
				}
*/

			}else{//全然撮れてない
				print 'オタコン「必要な写真は４枚だ。まず、メタルギアをそれぞれ右斜め前、正面、左斜め前から撮ったのを１枚ずつ」'
				print 'オタコン「それと、メタルギアに描いてある「ＭＡＲＩＮＥＳ」っていう海兵隊のマーキングのアップを１枚」'
				@rto_船倉写真条件３
/*
				vox t:vc010703 {
					talk オタコン 標準 -m {
						[オタコン評価終了判定:オタコン＿残りは４枚＿１]
					}
					talk オタコン 標準 -m {
						[オタコン評価終了判定:オタコン＿残りは４枚＿２]
					}
				}
*/
				print 'オタコン「新型メタルギアをカメラに収めてくれ」'
				@rto_船倉写真条件２
/*
				vox t:vc010702 {
					talk オタコン 標準 -m {
						[オタコン評価終了判定:オタコン＿新型頼む]
					}
				}
*/
			}




			@時間切れ判定


		}

		eval($f:デジカメ端末終了ＯＫ = 1)

	}





}



proc もう演説が終わる {
	puppet hurry

	print 'オタコン「スネーク、もう演説が終わる」'
	@rto_電送装置アクセス時判定あきらめ１
/*
	vox t:vc013101 {
		talk オタコン 標準 -m {
			[オタコン評価終了判定:オタコン＿もう演説が終わる]
		}
	}
*/

}




proc 写真はもう十分 {

	eval($f:タンカー編クリア許可 = 1)

	puppet escape

	print 'オタコン「写真はもう十分だ。脱出してくれ」'
	@rto_電送装置アクセス時判定あきらめ６
/*
	vox t:vc013106 {
		talk オタコン 標準 -m {
			[オタコン評価終了判定:オタコン＿クリア妥協＿終了]
		}
	}
*/

}


proc 時間切れ判定 {

	if($i:船倉演説残り時間 < 60 * 60 * 1){
		puppet hurry

		print 'オタコン「演説がもうすぐ終わる。時間がない。急いで！」'
		@rto_船倉戻るな２
/*
		vox t:vc013202 {
			talk オタコン 標準 -m {
				[オタコン評価終了判定:オタコン＿時間がない]
			}
		}
*/
	}

}





block photo 画像判定スタート {
	@画像判定処理
}

