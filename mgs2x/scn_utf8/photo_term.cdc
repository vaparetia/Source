dim $w:タンカーデジカメ写真属性[7]

#include dcam_tanker.h

#include "t_otacon_e.cm"
#include "t_otacon_e.ct"

#include "t_otacon_f.cm"
#include "t_otacon_f.ct"

#include "t_otacon_g.cm"
#include "t_otacon_g.ct"

#include "t_otacon_s.cm"
#include "t_otacon_s.ct"

#include "t_otacon_i.cm"
#include "t_otacon_i.ct"

#include "t_otacon_j.cm"
#include "t_otacon_j.ct"

proc 画像判定処理 {

	loadpuppet papet enter
	defaction norm -tired tired (300 * 10)				//アイドル状態

	@画像判定オタコン挨拶

	repeat{
		@写真検索
		@画像判定オタコン評価前置き
		@画像判定オタコン評価実体
		@オタコン評価終了判定

		if($f:デジカメ端末終了ＯＫ == 1){
			return 0
		}else{
			return 1
		}

	}

}



proc 画像判定オタコン挨拶 {


	print '１枚目は'$w:タンカーデジカメ写真属性[0]
	print '２枚目は'$w:タンカーデジカメ写真属性[1]
	print '３枚目は'$w:タンカーデジカメ写真属性[2]
	print '４枚目は'$w:タンカーデジカメ写真属性[3]
	print '５枚目は'$w:タンカーデジカメ写真属性[4]
	print '６枚目は'$w:タンカーデジカメ写真属性[5]


	eval($b:タンカーデジカメ今何枚目 = 0)
	eval($f:デジカメ写真表示これが１枚目 = 1)
	eval($f:デジカメ写真これで最後 = 0)
	eval($f:デジカメ写真１枚も無い = 0)
	eval($f:デジカメ端末終了ＯＫ = 0)


	if($w:タンカーデジカメ写真属性[0] + $w:タンカーデジカメ写真属性[1] + $w:タンカーデジカメ写真属性[2] + $w:タンカーデジカメ写真属性[3] + $w:タンカーデジカメ写真属性[4] + $w:タンカーデジカメ写真属性[5] == d:blank * 6){
		eval($f:デジカメ写真１枚も無い = 1)

	}


	//初めて接続
	if(!$f:電送端末接続したことある){
		print 'オタコン「どうだい、スネーク、良い写真を送ってくれたかい？」'
		@rto_電送装置アクセス時最初１
/*
		vox t:vc010901 {
			talk オタコン 標準 -m {
				[オタコン挨拶:オタコン＿ハロー＿初めて]
			}
		}
*/

	//一枚も撮ってなかった
	}else if($f:デジカメ写真１枚も無い){

		puppet send

		print 'オタコン「写真を送ってくれたみたいだね。どれどれ…」'
		@rto_電送装置アクセス時最初３
/*
		vox t:vc010903 {
			talk オタコン 標準 -m {
				[オタコン挨拶:オタコン＿ハロー＿３]
			}
		}
*/

	}else{

		puppet send

		rand 2
		if($status == 0){
			print 'オタコン「よし、写真を送ってくれたね」'
			@rto_電送装置アクセス時最初２
/*
			vox t:vc010902 {
				talk オタコン 標準 -m {
					[オタコン挨拶:オタコン＿ハロー＿２]
				}
			}
*/

		}else{
			print 'オタコン「写真を送ってくれたみたいだね。どれどれ…」'
			@rto_電送装置アクセス時最初３
/*
			vox t:vc010903 {
				talk オタコン 標準 -m {
					[オタコン挨拶:オタコン＿ハロー＿３]
				}
			}
*/
		}


	}




}


proc 写真検索 {

	print '写真検索開始'

	eval($f:画像判定スタートしました = 0)

	if($f:デジカメ写真１枚も無い){

	}else{

		if($b:タンカーデジカメ今何枚目 == 0){
			print '１枚目はどうか？'
			if($w:タンカーデジカメ写真属性[$b:タンカーデジカメ今何枚目] == d:blank){
				eval($b:タンカーデジカメ今何枚目 = $b:タンカーデジカメ今何枚目 + 1)
				print '１枚目は空だったので、２枚目はどうか？'
			}else{
				if($w:タンカーデジカメ写真属性[1] + $w:タンカーデジカメ写真属性[2] + $w:タンカーデジカメ写真属性[3] + $w:タンカーデジカメ写真属性[4] + $w:タンカーデジカメ写真属性[5] == d:blank * 5){
					eval($f:デジカメ写真これで最後 = 1)
				}
				eval($f:画像判定スタートしました = 1)
			}
		}
		if(!$f:画像判定スタートしました && $b:タンカーデジカメ今何枚目 == 1){
			print '２枚目はどうか？'
			if($w:タンカーデジカメ写真属性[$b:タンカーデジカメ今何枚目] == d:blank){
				eval($b:タンカーデジカメ今何枚目 = $b:タンカーデジカメ今何枚目 + 1)
				print '２枚目は空だったので、３枚目はどうか？'
			}else{
				if($w:タンカーデジカメ写真属性[2] + $w:タンカーデジカメ写真属性[3] + $w:タンカーデジカメ写真属性[4] + $w:タンカーデジカメ写真属性[5] == d:blank * 4){
					eval($f:デジカメ写真これで最後 = 1)
				}
				eval($f:画像判定スタートしました = 1)
			}
		}
		if(!$f:画像判定スタートしました && $b:タンカーデジカメ今何枚目 == 2){
			print '３枚目はどうか？'
			if($w:タンカーデジカメ写真属性[$b:タンカーデジカメ今何枚目] == d:blank){
				eval($b:タンカーデジカメ今何枚目 = $b:タンカーデジカメ今何枚目 + 1)
				print '３枚目は空だったので、４枚目はどうか？'
			}else{
				if($w:タンカーデジカメ写真属性[3] + $w:タンカーデジカメ写真属性[4] + $w:タンカーデジカメ写真属性[5] == d:blank * 3){
					eval($f:デジカメ写真これで最後 = 1)
				}
				eval($f:画像判定スタートしました = 1)
			}
		}
		if(!$f:画像判定スタートしました && $b:タンカーデジカメ今何枚目 == 3){
			print '４枚目はどうか？'
			if($w:タンカーデジカメ写真属性[$b:タンカーデジカメ今何枚目] == d:blank){
				eval($b:タンカーデジカメ今何枚目 = $b:タンカーデジカメ今何枚目 + 1)
				print '４枚目は空だったので、５枚目はどうか？'
			}else{
				if($w:タンカーデジカメ写真属性[4] + $w:タンカーデジカメ写真属性[5] == d:blank * 2){
					eval($f:デジカメ写真これで最後 = 1)
				}
				eval($f:画像判定スタートしました = 1)
			}
		}
		if(!$f:画像判定スタートしました && $b:タンカーデジカメ今何枚目 == 4){
			print '５枚目はどうか？'
			if($w:タンカーデジカメ写真属性[$b:タンカーデジカメ今何枚目] == d:blank){
				eval($b:タンカーデジカメ今何枚目 = $b:タンカーデジカメ今何枚目 + 1)
				print '５枚目は空だったので、６枚目はどうか？'
			}else{
				if($w:タンカーデジカメ写真属性[5] == d:blank){
					eval($f:デジカメ写真これで最後 = 1)
				}
				eval($f:画像判定スタートしました = 1)
			}
		}
		if(!$f:画像判定スタートしました && $b:タンカーデジカメ今何枚目 == 5){
			print '６枚目はどうか？'
			eval($f:デジカメ写真これで最後 = 1)
		}
	}


}





proc 画像判定オタコン評価前置き {

	print '評価前置き開始'

	//一枚も写真が無い
	if($f:デジカメ写真１枚も無い){

		puppet bad

		print 'オタコン「ん？一枚も撮ってないじゃないか。写真を撮ってくれなきゃ、この端末を使っても意味が無いよ」'
		@rto_電送装置アクセス時写真ない
/*
		vox t:vc011001 {
			talk オタコン 標準 -m {
				[オタコン文句:オタコン＿一枚も無いぞい]
			}
		}
*/
		eval($f:デジカメ写真これで最後 = 1)

	}else{

		puppet check

		if($f:デジカメ写真表示これが１枚目){
			rand 3
			if($status == 0){
				print 'オタコン「まず、一枚目は……」'
				@rto_電送装置アクセス時写真あり１
/*
				vox t:vc011201 {
					talk オタコン 標準 -m {
						[オタコン前置き:オタコン＿１枚目＿１]
					}
				}
*/
			}else if($status == 1){
				print 'オタコン「最初の一枚は……」'
				@rto_電送装置アクセス時写真あり２
/*
				vox t:vc011202 {
					talk オタコン 標準 -m {
						[オタコン前置き:オタコン＿１枚目＿２]
					}
				}
*/
			}else{
				print 'オタコン「一枚目は……」'
				@rto_電送装置アクセス時写真あり３
/*
				vox t:vc011203 {
					talk オタコン 標準 -m {
						[オタコン前置き:オタコン＿１枚目＿３]
					}
				}
*/
			}

		}else if($f:デジカメ写真これで最後){
			@オタコン前置きこれが最後

		}else{

			rand 6
			if($status == 0){
				print 'オタコン「次はどうかな…」'
				@rto_電送装置アクセス時写真あり４
/*
				vox t:vc011204 {
					talk オタコン 標準 -m {
						[オタコン前置き:オタコン＿２枚目以降＿１]
					}
				}
*/
			}else if($status == 1){
				print 'オタコン「その次は、と…」'
				@rto_電送装置アクセス時写真あり５
/*
				vox t:vc011205 {
					talk オタコン 標準 -m {
						[オタコン前置き:オタコン＿２枚目以降＿２]
					}
				}
*/

			}else if($status == 2){
				print 'オタコン「で、次は…」'
				@rto_電送装置アクセス時写真あり６
/*
				vox t:vc011206 {
					talk オタコン 標準 -m {
						[オタコン前置き:オタコン＿２枚目以降＿３]
					}
				}
*/
			}else if($status == 3){
				print 'オタコン「その次はどうだろう…」'
				@rto_電送装置アクセス時写真あり７
/*
				vox t:vc011207 {
					talk オタコン 標準 -m {
						[オタコン前置き:オタコン＿２枚目以降＿４]
					}
				}
*/
			}else if($status == 4){
				print 'オタコン「ええと､次は…」'
				@rto_電送装置アクセス時写真あり８
/*
				vox t:vc011208 {
					talk オタコン 標準 -m {
						[オタコン前置き:オタコン＿２枚目以降＿５]
					}
				}
*/
			}else{
				print 'オタコン「さて､次は…」'
				@rto_電送装置アクセス時写真あり９
/*
				vox t:vc011209 {
					talk オタコン 標準 -m {
						[オタコン前置き:オタコン＿２枚目以降＿６]
					}
				}
*/
			}


		}


		print $b:タンカーデジカメ今何枚目'の写真表示します！！！'
		photoframe $b:タンカーデジカメ今何枚目
		wait 250

	}

}




proc オタコン前置きこれが最後 {
	print '写真これで最後'

	rand 3
	if($status == 0){
		print 'オタコン「最後の１枚は……」'
		@rto_電送装置アクセス時写真あり１０
/*
		vox t:vc011210 {
			talk オタコン 標準 -m {
				[オタコン前置き:オタコン＿これで最後＿１]
			}
		}
*/

	}else if($status == 1){
		print 'オタコン「これが最後か……」'
		@rto_電送装置アクセス時写真あり１１
/*
		vox t:vc011211 {
			talk オタコン 標準 -m {
				[オタコン前置き:オタコン＿これで最後＿２]
			}
		}
*/
	}else{
		print 'オタコン「ラストはどうかな……」'
		@rto_電送装置アクセス時写真あり１２
/*
		vox t:vc011212 {
			talk オタコン 標準 -m {
				[オタコン前置き:オタコン＿これで最後＿３]
			}
		}
*/
	}



}




proc 画像判定オタコン評価実体 {

	print '評価実体開始'

	if($f:デジカメ写真１枚も無い){
		print '評価するものはありません。'

	}else if($w:タンカーデジカメ写真属性[$b:タンカーデジカメ今何枚目] == d:正面メタルＯＫ){
		if(!$f:メタル正面撮影成功){

			eval($f:メタル正面撮影成功 = 1)

			photosave $b:タンカーデジカメ今何枚目

			puppet ok

			print 'オタコン「うん、これでいい。前からの写真はこれで十分だ」'
			@rto_電送装置アクセス時判定ＯＫ３
/*
			vox t:vc011303 {
				talk オタコン 標準 -m {
					[オタコン評価実体:オタコン＿メタル正面成功]
				}
			}
*/
		}else{

			puppet ngDouble

			rand 2
			if($status == 0){
				print 'オタコン「正面からの写真はもうあるからいらないんだ」'
				@rto_電送装置アクセス時判定ＮＧダブり前１
/*
				vox t:vc011901 {
					talk オタコン 標準 -m {
						[オタコン評価実体:オタコン＿メタル正面成功してた＿１]
					}
				}
*/
			}else{
				print 'オタコン「前からの写真はさっき撮ってくれたので十分だ。もう撮らなくていいよ」'
				@rto_電送装置アクセス時判定ＮＧダブり前２
/*
				vox t:vc011902 {
					talk オタコン 標準 -m {
						[オタコン評価実体:オタコン＿メタル正面成功してた＿２]
					}
				}
*/
			}

		}

	}else if($w:タンカーデジカメ写真属性[$b:タンカーデジカメ今何枚目] == d:右メタルＯＫ){

		if(!$f:メタル右側撮影成功){
			eval($f:メタル右側撮影成功 = 1)

			photosave $b:タンカーデジカメ今何枚目

			puppet ok

			print 'オタコン「うん、ＯＫだ。右からの写真はこれでいい」'
			@rto_電送装置アクセス時判定ＯＫ１
/*
			vox t:vc011301 {
				talk オタコン 標準 -m {
					[オタコン評価実体:オタコン＿メタル右成功]
				}
			}
*/

		}else{

			puppet ngDouble

			rand 2
			if($status == 0){
				print 'オタコン「右からの写真はもうあるからいらないんだ」'
				@rto_電送装置アクセス時判定ＮＧダブり右１
/*
				vox t:vc011701 {
					talk オタコン 標準 -m {
						[オタコン評価実体:オタコン＿メタル右成功してた＿１]
					}
				}
*/

			}else{
				print 'オタコン「右からの写真は撮ってあるからこれ以上必要ないよ」'
				@rto_電送装置アクセス時判定ＮＧダブり右２
/*
				vox t:vc011702 {
					talk オタコン 標準 -m {
						[オタコン評価実体:オタコン＿メタル右成功してた＿２]
					}
				}
*/
			}

		}

	}else if($w:タンカーデジカメ写真属性[$b:タンカーデジカメ今何枚目] == d:左メタルＯＫ){
		if(!$f:メタル左側撮影成功){
			eval($f:メタル左側撮影成功 = 1)

			photosave $b:タンカーデジカメ今何枚目

			puppet ok

			print 'オタコン「良い写真だね。左からの写真はこれをもらうことにする」'
			@rto_電送装置アクセス時判定ＯＫ２
/*
			vox t:vc011302 {
				talk オタコン 標準 -m {
					[オタコン評価実体:オタコン＿メタル左成功]
				}
			}
*/

		}else{

			puppet ngDouble

			rand 2
			if($status == 0){
				print 'オタコン「左からの写真はもういらないんだ」'
				@rto_電送装置アクセス時判定ＮＧダブり左１
/*
				vox t:vc011801 {
					talk オタコン 標準 -m {
						[オタコン評価実体:オタコン＿メタル左成功してた＿１]
					}
				}
*/
			}else{
				print 'オタコン「左からの写真はさっきのを使うからもう撮らなくて良いよ」'
				@rto_電送装置アクセス時判定ＮＧダブり左２
/*
				vox t:vc011802 {
					talk オタコン 標準 -m {
						[オタコン評価実体:オタコン＿メタル左成功してた＿２]
					}
				}
*/
			}


		}

	}else if($w:タンカーデジカメ写真属性[$b:タンカーデジカメ今何枚目] == d:ＭＡＲＩＮＥＳＯＫ){
		if(!$f:メタルＭＡＲＩＮＥＳ撮影成功){
			eval($f:メタルＭＡＲＩＮＥＳ撮影成功 = 1)

			photosave $b:タンカーデジカメ今何枚目

			puppet ok

			print 'オタコン「よく撮れてるね。「ＭＡＲＩＮＥＳ」のマーキングの写真はこれでいくことにする」'
			@rto_電送装置アクセス時判定ＯＫ４
/*
			vox t:vc011304 {
