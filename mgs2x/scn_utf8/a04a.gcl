					//メッセージ発行は、遅らせてタイミングを合わせる
					chara delay ハッチ用ディレイ \
						-time 80 \
						-exec {
							mesg プットモーションモデル 西側ハッチ 終了判定 4
						}

					eval( $f:船倉１西側地下ピットふた開いた = 1 )
					@西側ハッチオープン跳弾アタリ変更

				}else{

					//上に到着
					mesg プレイヤー d:PLAYER motion \
						d:モーションリスト:sna_non_ladder_up2hatch_r \
						3072 \
						-1 \
						0 \
						(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT | d:FA_NO_WEAPON)

				}


			}
*/


	}




	proc 北側から西地下ピットに下りる{
//		mesg プレイヤー d:PLAYER position \
//			-10970 -15970 -2000

		if( $f:船倉１西側地下ピットふた開いた == 0 ){


			//フタ開けて
			mesg プレイヤー d:PLAYER motion \
				d:モーションリスト:sna_non_ladder_hatch_open_r \
				0 \
				-1 \
				0 \
				(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_WEAPON) \
				-10970 -2000 -15970	//x,z,yの順

			//ふた開け連動
			mesg プットモーションモデル 西側ハッチ 終了判定 0
			eval( $f:船倉１西側地下ピットふた開いた = 1 )
			@西側ハッチオープン跳弾アタリ変更

		}

		//降りて
		mesg プレイヤー d:PLAYER motion \
			d:モーションリスト:sna_non_ladder_hatch2down_r \
			0 \
			-1 \
			0 \
			(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_WEAPON) \
			-10970 -2000 -15970	//x,z,yの順

		//着地
		mesg プレイヤー d:PLAYER motion \
			d:モーションリスト:non_ladder_down_c_end \
			-1 \
			-1 \
			0 \
			(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT | d:FA_NO_WEAPON)

#if d:ピットで自動ホフク
		mesg プレイヤー d:PLAYER stance \
			0 \
			-1 \
			1024 \
			(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT | d:FA_NO_WEAPON)


		mesg プレイヤー d:PLAYER stance \
			2 \
			-1 \
			1024 \
			(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT | d:FA_NO_WEAPON)
#endif


	}





	proc 船倉１東側地下はしご設定{
		print '船倉１東側地下はしご設定'


//東側
		chara プットモーションモデル 東側ハッチ \
			-pos 11500,-17000,-19000 \	//$v:配置座標
			-dir 2048 \					//$i:方向
			-kms hatch \				//$s:KMSモデル名
			-mar hatch_w04 \			//$s:モーションファイル名
			-number 1 \					//$i:基本モーション番号 ...
			-status	0x0e 				//$w:ステータス
//			-status	0x02 0x04 0x08		//$w:ステータス

				/*ステータスフラグ設定は以下のとおり
					(0x01) モーションの水平移動量を無視
					(0x02) 重力処理無し
					(0x04) 壁アタリ判定無し
					(0x08) メッセージ受信までモーション停止
				*/


//跳弾アタリ追加
		command 追加ＨＺＸグループ登録 \
			-hzx_id 0 \
			-add_id 5



	//地下はしご東・上部用設定
		//----------------------


		//北側から
		trap la303h_left d:PLAYER -mask 入る -button d:ACTION_BUTTON -dir 0,256 \
			-state d:TRP_STATE_STAND \
			-exec {

				mesg 透明壁 地下ピット東側 on

				@北側から東地下ピットに下りる

			}



		//西側から
		trap la303h_front d:PLAYER -mask 入る -button d:ACTION_BUTTON -dir 1024,256 \
			-state d:TRP_STATE_STAND \
			-exec {

				if( $f:船倉１東側地下ピットふた開いた == 0 ){
					//フタを開けて北側に移動
					mesg プレイヤー d:PLAYER motion \
						d:モーションリスト:sna_non_ladder_hatch_open_c2l \
						1024 \
						-1 \
						0 \
						(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_WEAPON) \
						10078 -19009 -16000	//x,z,yの順

					mesg プットモーションモデル 東側ハッチ 終了判定 3
					eval( $f:船倉１東側地下ピットふた開いた = 1 )
					@東側ハッチオープン跳弾アタリ変更

				}else{

					//北側に移動
					mesg プレイヤー d:PLAYER motion \
						d:モーションリスト:sna_non_ladder_hatch_c2l \
						1024 \
						-1 \
						0 \
						(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_WEAPON) \
						10055 -19018 -16000	//x,z,yの順

				}

				mesg 透明壁 地下ピット東側 on

				@北側から東地下ピットに下りる

			}






		//はしご中カメラ
		trap la303_force d:PLAYER \
			-camera \
			-mask ？ -state d:TRP_STATE_FORCE \
			-exec {
				chara カメラ設定 ビヨンドカメラ \
					-c 1 \
					-p 10308,-12412,-18471 \
					-t 10482,-16007,-19542 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3
			}

		//はしご影消去
		trap la303_force d:PLAYER -mask いる \
			-state d:TRP_STATE_LADDER,d:TRP_STATE_FORCE \
			-exec {
				mesg プレイヤー d:PLAYER shadow 0
			}
		trap la303_force d:PLAYER -mask いる \
			-state d:TRP_STATE_STAND \
			-exec {
				mesg プレイヤー d:PLAYER shadow 1
			}


	//地下はしご東・下部用設定
		//----------------------

#if d:ピット自動脱出
		//下から自動脱出
		trap la303l d:PLAYER \
			-mask いる \
			-exec{

				if( $4 > 10600 && !$f:船倉１東側地下ピットふた開いた){

					eval( $f:船倉１東側地下ピットふた開いた = 1 )
					@東側ハッチオープン跳弾アタリ変更

					mesg 透明壁 地下ピット東側 on

					//中からふた開けて上がる
					mesg プレイヤー d:PLAYER motion \
						d:モーションリスト:sna_non_ladder_open2hatch_l \
						1024 \
						-1 \
						0 \
						(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT | d:FA_NO_WEAPON) \
						10850 -19000 -18000	//x,z,yの順

					mesg プットモーションモデル 東側ハッチ 終了判定 5


				}

			}
#endif

		trap la303l d:PLAYER -mask 入る -button d:ACTION_BUTTON -dir 1024,256 \
			-state d:TRP_STATE_STAND \
			-exec {

				mesg 透明壁 地下ピット東側 on


				if( $f:船倉１東側地下ピットふた開いた == 0 ){

					//中からふた開けて上がる
					mesg プレイヤー d:PLAYER motion \
						d:モーションリスト:sna_non_ladder_open2hatch_l \
						1024 \
						-1 \
						0 \
						(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT | d:FA_NO_WEAPON) \
						10850 -19000 -18000	//x,z,yの順

					mesg プットモーションモデル 東側ハッチ 終了判定 5

					eval( $f:船倉１東側地下ピットふた開いた = 1 )
					@東側ハッチオープン跳弾アタリ変更

				}else{

					//昇って
					mesg プレイヤー d:PLAYER motion \
						d:モーションリスト:non_ladder_up_c_start \
						1024 \
						-1 \
						0 \
						(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_WEAPON) \
						10850 -19000 -18470	//x,z,yの順

					//上に到着
					mesg プレイヤー d:PLAYER motion \
						d:モーションリスト:sna_non_ladder_up2hatch_l \
						-1 \
						-1 \
						0 \
						(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT | d:FA_NO_WEAPON)

				}

			}




	}





	proc 北側から東地下ピットに下りる{
//		mesg プレイヤー d:PLAYER position \
//			11000 -15970 -20000

		if( $f:船倉１東側地下ピットふた開いた == 0 ){


			//フタ開けて
			mesg プレイヤー d:PLAYER motion \
				d:モーションリスト:sna_non_ladder_hatch_open_l \
				0 \
				-1 \
				0 \
				(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_WEAPON) \
				11000 -19950 -15970	//x,z,yの順

			//ふた開け連動
			mesg プットモーションモデル 東側ハッチ 終了判定 1
			eval( $f:船倉１東側地下ピットふた開いた = 1 )
			@東側ハッチオープン跳弾アタリ変更

		}

		//降りて
		mesg プレイヤー d:PLAYER motion \
			d:モーションリスト:sna_non_ladder_hatch2down_l \
			0 \
			-1 \
			0 \
			(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_WEAPON) \
			11000 -19950 -15970 	//x,z,yの順

		//着地
		mesg プレイヤー d:PLAYER motion \
			d:モーションリスト:non_ladder_down_c_end \
			-1 \
			-1 \
			0 \
			(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT | d:FA_NO_WEAPON)

#if d:ピットで自動ホフク
		mesg プレイヤー d:PLAYER stance \
			0 \
			-1 \
			3072 \
			(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT | d:FA_NO_WEAPON)


		mesg プレイヤー d:PLAYER stance \
			2 \
			-1 \
			3072 \
			(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT | d:FA_NO_WEAPON)
#endif

	}




//本当は開ききってからアタリ追加しなくちゃいけないけど、ここは危険モードないから大丈夫でしょ。


	proc 西側ハッチオープン跳弾アタリ変更{

		command 追加ＨＺＸグループ削除 \
			-hzx_id 0 \
			-add_id 3

		command 追加ＨＺＸグループ登録 \
			-hzx_id 0 \
			-add_id 4


	}





	proc 東側ハッチオープン跳弾アタリ変更{

		command 追加ＨＺＸグループ削除 \
			-hzx_id 0 \
			-add_id 5

		command 追加ＨＺＸグループ登録 \
			-hzx_id 0 \
			-add_id 6


	}




//###################################################################################
//									カメラ設定
//###################################################################################


	// カメラ設定
	// ------------------------------------
	proc カメラ設定 {
			print 'カメラ設定'

			chara カメラ ステージカメラ	-c 0 -l 3 -p 0
			chara カメラ サブカメラ１	-c 0 -l 2 -p 50
			chara カメラ サブカメラ２	-c 0 -l 2 -p 40
			chara カメラ サブカメラ３	-c 0 -l 2 -p 30
			chara カメラ ビヨンドカメラ	-c 0 -l 2 -p 20
			chara カメラ モーションカメラ	-c 0 -l 2 -p 10
			chara カメラ ロードカメラ	-c 0 -l 2 -p 5
			chara カメラ カットインカメラ -c 0 -l 0 -p 40

			// デフォルトカメラ

			chara カメラ設定 ステージカメラ \
				-c 0 \
				-b -8300,-16000,-80750 8300,-9550,3500 \
				-l -8300,-15900,-80750 8300,-100,-3050 \
				-r 415,2048,0 \
				-f 10000 \
				-a 200 \
				-i 1 -1 0 0 \
				-s 1 \
				-E 0 20 \
					1000 1000 \
					50

	}













//###################################################################################
//									船倉１カメラ設定
//###################################################################################

	proc 船倉１カメラ設定 {
		print '船倉１カメラ設定'

//奥狭い通路
		trap ca101 d:PLAYER \
			-mask ＊ \
			-exec {
				chara カメラ設定 サブカメラ２ \
					-c 1 \
					-p $4,-10927,-23075 \
					-t $4,-12115,-23236 \
					-a 200 \
					-i 1 -1 0 0 \
					-s $3
			}

//東はしご
		// 下側はしご
		trap ca103 d:PLAYER \
			-camera \
			-mask ＊ \
			-state d:TRP_STATE_LADDER \
			-exec {
				chara カメラ設定 サブカメラ２ \
					-c 1 \
					-p 10908,-12000,-397 \
					-t 9400,$5,$6 \
					-a 200 \
					-i 0 -1 0 0 \
					-s $3
			}

		trap ca103h d:PLAYER \
			-camera \
			-mask ？ \
			-state d:TRP_STATE_LADDER \
			-exec {
				chara カメラ設定 サブカメラ２ \
					-c 0 \
					-b -32000,-7000,-32000 11500,-5500,0 \
					-l -32000,-32000,-32000 32000,32000,32000 \
					-r 320,2320,0 \
					-f 2500 \
					-a 200 \
					-i 0 -1 0 0 \
					-s $3
			}

		// 上側はしご
		trap ca104 d:PLAYER \
			-camera \
			-mask ＊ \
			-state d:TRP_STATE_LADDER \
			-exec {

				chara カメラ設定 サブカメラ２ \
					-c 1 \
					-p 9901,-6000,-378 \
					-t 11349,$5,-3446 \
					-a 200 \
					-i 0 -1 0 0 \
					-s $3
			}

		trap ca104h d:PLAYER \
			-camera \
			-mask ？ \
			-state d:TRP_STATE_LADDER \
			-exec {

				chara カメラ設定 サブカメラ２ \
					-c 0 \
					-b -32000, -3000,-32000 32000,32000,32000 \
					-l -32000,-32000,-32000 32000,32000,32000 \
					-r 320,1800,0 \
					-f 2500 \
					-a 200 \
					-i 0 -1 0 0 \
					-s $3
			}

//上はしご床
		trap ca106 d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {
				chara カメラ設定 サブカメラ１ \
					-c 0 \
					-b -11500,-17000,-80750 11500,-100,-500 \
					-l -11500,-17000,-80750 11500,-100,-501 \
					-r 640,2048,0 \
					-f 7000 \
					-a 200 \
					-i 1 -1 0 0 \
					-s $3
			}

//西はしご
		// 下側はしご
		trap ca108 d:PLAYER \
			-camera \
			-mask ＊ \
			-state d:TRP_STATE_LADDER \
			-exec {
				chara カメラ設定 サブカメラ２ \
					-c 1 \
					-p -10908,-12000,-397 \
					-t -9400,$5,$6 \
					-a 200 \
					-i 0 -1 0 0 \
					-s $3
			}

