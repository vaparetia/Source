#define STAGE_TANKER		1		// モード共通 プロック切り分け用
#define STAGE_W04A			1		// ステージ名 共通プロック切り分け用
#define STAGE_ALT			1		// オールタナティブステージ切り分け用

// 薬莢
#define ENE_T_GOL				1	// タンカー編ゴル兵
#define	ENE_SHOT				1	// ショットガン兵
#define	ENE_SHIELD 				1	// 盾兵

#define	PLAYER		スネーク
#define	RADAR		0
#define SOUND_FG	1
#define SEALS_1_FG	1
#define ENE_T_GOL	1	// タンカー編ゴル兵薬莢

#define MULTI_MODEL	0		/* E3ビデオ用特別仕様(2000.4.8) */
#define PITHOLE		1

#define LT2_NAME	w04a
#define LD_FADEOUT	1
#define PAN_CAMERA	1
#define STAGE_END	1
#define ピット自動脱出	1
#define ピットで自動ホフク	0
#define debug_timer	0
#define movie		1
#define CTDOWN_TIMER		1		//w04.hでのタイマー選択
#define IN_RAIL_HZD	1				//エルード位置補正
#define	AUTO_JUMP	1
#define	SNEEZE		1

#define 開発中です	0	// 開発中に暫定的に使用する処理群
