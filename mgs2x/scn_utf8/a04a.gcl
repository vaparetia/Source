//###################################################################################

	proc 通路１カメラ設定 {
		print '通路１カメラ設定'

//１Ｆ北東
		trap ca400 d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {
				if( $6 >= -24500 ){
					eval($i:補完ＴＺ = -24501)

				}else{
					eval($i:補完ＴＺ = $6)

				}

				@CS_スムーズカメラ昇順 $i:補完ＴＺ -28000 -24501 -15100 -14000
				eval($i:補完ＰＹ = $i:CS_結果１)


				chara カメラ設定 サブカメラ１ \
					-c 1 \
					-p 8000,$i:補完ＰＹ,-24500 \
					-t 8000,$5,$i:補完ＴＺ \
					-a 200 \
					-i 0 0 0 0 \
					-s $3


			}


//１Ｆ北西
		trap ca401 d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {
				if( $6 >= -24500 ){
