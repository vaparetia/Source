//###################################################################################
//									はしご設定
//###################################################################################


	//はしご設定
	// ------------------------------------
	proc 船倉１はしご設定 {
			print '船倉１はしご設定'

			//下側はしご・下部用設定
			//----------------------
			trap la100l d:PLAYER -mask 入る -button d:ACTION_BUTTON -dir 2048,256 \
				-state d:TRP_STATE_STAND,d:TRP_STATE_LADDER \
				-exec {
					command はしご設定 \
						-l -15900,-9000 \
						-s d:モーションリスト:non_ladder_up_c_start	10500,-15970,-3330 2048 \
						-e d:モーションリスト:non_ladder_down_c_end	10500,-15500,-3330 -1
					mesg プレイヤー d:PLAYER ladder

					eval($f:ｗ０４ａはしご乗った方向  = 0)
					print '$f:ｗ０４ａはしご乗った方向は'$f:ｗ０４ａはしご乗った方向

				}

			//はしご上で下を押していたらおりる。
			trap la100l d:PLAYER -mask いる -dir 2048,256 \
				-state d:TRP_STATE_LADDER \
				-exec {
					command パッドチェック \
						-which 0 \
						-status		//押されている
					if( $status & d:PAD_D){
						command パッド操作 \
							-press d:PAD_X
					}
				}



			trap la100l d:PLAYER \
				-camera \
				-mask ？ -state d:TRP_STATE_FORCE \
				-exec {
					chara カメラ設定 ビヨンドカメラ \
						-c 1 \
						-p 9704,-13280,-1949 \
						-t 10187,-14848,-2702 \
						-a 200 \
						-i 0 2 0 0 \
						-s $3
				}


			//下側はしご・上部用設定
			//----------------------

			//はしごにのっている場合
			trap la100h d:PLAYER -mask 入る -button d:ACTION_BUTTON -dir 2048,256 \
				-state d:TRP_STATE_LADDER \
				-exec {
					command はしご設定 \
