//###################################################################################
//									アイテム設定
//###################################################################################


	proc アイテム設定 {
		print 'アイテム設定'

		@アイテム再セットチェック $b:w04a_取得ロード回数[0]
		if ($f:再セットフラグ) {
			@弾薬_Ｍ９_初期設置 弾薬_Ｍ９１ -11000,-9000,-500 0
		}

		@アイテム再セットチェック $b:w04a_取得ロード回数[1]
		if ($f:再セットフラグ) {
			@弾薬_Ｍ９_初期設置 弾薬_Ｍ９２ 7000,-5000,1750 0
		}

		@アイテム再セットチェック $b:w04a_取得ロード回数[2]
		if ($f:再セットフラグ) {
			@レーション_初期設置 レーション１ 10000,-5000,3250 0
		}

		if($w:アイテム数[d:アイテム:サーマルゴーグル] == 0){
#ifdef JAPANESE
			@サーマルゴーグル_初期設置 サーマルゴーグル 10500,-9000,-500 0
#else
			@サーマルゴーグル_初期設置 サーマルゴーグル -10500,-5000,-3500 0
#endif
		}


		//エルードハマリ防止レーション
		if($w:ゲーム設定 <= d:LEVEL_NORMAL &&  $w:アイテム数[ d:アイテム:レーション ] == 0){
			chara アイテム アイテムボックス \
				-b 0 \
				-p 11000 -9000 -23500 \
				-k ration_ibox \
				-s ration_ibox_sh \
				-l rtn_label \
				-f d:アイテム種別:アイテム \
				-i d:アイテム:レーション \
				-n 1 \
				-h 300 \
				-r 0

			chara アイテム アイテムボックス \
				-b 0 \
				-p -11000 -9000 -23500 \
				-k ration_ibox \
				-s ration_ibox_sh \
				-l rtn_label \
				-f d:アイテム種別:アイテム \
				-i d:アイテム:レーション \
				-n 1 \
				-h 300 \
				-r 0
		}

	}


