//###################################################################################
//									水密ドア設定
//###################################################################################

	proc 長廊下小部屋透明壁撤去 $:トリガ $:実行キャラ {

		if ($:トリガ == 0) {		// 開いたとき
			mesg 透明壁 長廊下４ off
			mesg 透明壁 長廊下５ on
		}

	}

	proc 船倉１水密ドア設置 {
		print '船倉１水密ドア設定'

		chara 水密ドア管理 水密ドア管理 -n 3 \
			-N 3 \		//$b:ノック音番号 \
			//-N d:se_code:SD_A_WALLM04		//$b:ノック音番号 \
			-motions sna_hatch hatch_door_sna hatch_handle_sna



			chara 水密ドア 第一船倉水密ドア \
				-kms w04_sdr w04_sdr_hnd \
				-position 8675,-5000,550 \
				-rotate 0,0,0 \
				-type 0 \
				-f d:WT_DOOR_FLAG_OPEN_START \
				-proc 長廊下小部屋透明壁撤去 \
				-h 8750 -5000 500 9750 -3000 500

			// 透明壁
			mesg 透明壁 長廊下４ off
			mesg 透明壁 長廊下５ on

		trap dr300 d:PLAYER \
			-mask いる \
			-dir 0,256 \
			-button d:ACTION_BUTTON \
			-state d:TRP_STATE_STAND \
			-exec {
					command 水密ドア状態 -n 第一船倉水密ドア

					mesg プレイヤー d:PLAYER wt_door \
						第一船倉水密ドア $status \	//$s:水密ドアの名前 $i:そのドアの状態
						0,512 \					//$w:ドアに正対した方向 $w:方向幅
						8700,500					//$i:ドア位置Ｘ $i:ドア位置Ｚ

					mesg プレイヤー d:PLAYER wt_door \
						第一船倉水密ドア $status \	//$s:水密ドアの名前 $i:そのドアの状態
						2048,1024 \					//$w:ドアに正対した方向 $w:方向幅
						8700,500					//$i:ドア位置Ｘ $i:ドア位置Ｚ
			}


//南側から開けるときカメラ
		trap dr300 d:PLAYER \
			-camera \
			-mask ？ \
			-dir 2048,256 \
			-state d:TRP_STATE_FORCE \
			-exec {
				chara カメラ設定 ビヨンドカメラ \
					-c 1 \
					-p 8198,-1624,2014 \
					-t 9321,-3983,-126 \
					-a 200 \
					-i 2 3 0 0 \
					-s $3
			}


//北側から開けるときカメラ
		trap dr300 d:PLAYER \
			-camera \
			-mask ？ \
			-dir 0,256 \
			-state 6 \
			-exec {
				chara カメラ設定 ビヨンドカメラ \
					-c 1 \
					-p 9214,-1219,-423 \
					-t 9214,-8217,-530 \
					-a 200 \
					-i 2 3 0 0 \
					-s $3
			}



//水密ドアをはさんでのグループ切り替え
		trap ca500 d:PLAYER \
			-mask ？ \
			-A \		//マップ接合
			-exec {

				if($4 >= 8500 && $4 <= 10000){
					if($3 == 入る){
						mesg マップ接合 船倉接合長廊下 off
					}else{
						mesg マップ接合 船倉接合長廊下 on
					}
				}
			}


		trap ca500 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_SUBJECT \
			-exec {

				if($3 == 入る){
					mesg マップ接合 船倉接合長廊下 on
				}else{
					mesg マップ接合 船倉接合長廊下 off
				}

			}




		if( $s:登場ポイント == 水密ドア ){
			chara 水密ドア 長廊下ドア \
				-kms w03esdr_body w03esdr_handle \
				-position 11550,-5000,1675 \
				-rotate 0,3072,0 \
				-type 1 \
				-flag (d:WT_DOOR_FLAG_NOT_OPEN | d:WT_DOOR_FLAG_OPEN_START)

		}else{
			chara 水密ドア 長廊下ドア \
				-kms w03esdr_body w03esdr_handle \
				-position 11550,-5000,1675 \
				-rotate 0,3072,0 \
				-type 1 \
				-flag d:WT_DOOR_FLAG_NOT_OPEN

		}


		trap dr301 d:PLAYER \
			-mask いる \
			-button d:ACTION_BUTTON \
			-state 0 \
			-exec {

				command 水密ドア状態 -n 長廊下ドア
				mesg プレイヤー d:PLAYER wt_door \
					長廊下ドア $status \	//$s:水密ドアの名前 $i:そのドアの状態
					1024,1024 \					//$w:ドアに正対した方向 $w:方向幅
					11400,2830					//$i:ドア位置Ｘ $i:ドア位置Ｚ

			}



//ハンドル掴んだときカメラ
		trap dr301 d:PLAYER \
			-camera \
			-mask ？ \
			-dir 1024,256 \
			-state d:TRP_STATE_FORCE \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 1 ){
					chara カメラ設定 ビヨンドカメラ \
						-c 1 \
						-p 10168,-1755,3237 \
						-t 10526,-2784,2472 \
						-a 200 \
						-i 2 2 0 0 \
						-s $3
				}
			}






//左舷上部
		chara 水密ドア 左舷上部ドア \
			-kms w01d0tray w04_sdr_hnd \
			-position -8675,-5000,450 \
			-rotate 0,2048,0 \
			-type 1 \
			-flag d:WT_DOOR_FLAG_NOT_OPEN



		trap dr302 d:PLAYER \
			-mask いる \
			-button d:ACTION_BUTTON \
			-state d:TRP_STATE_STAND \
			-exec {

				command 水密ドア状態 -n 長廊下ドア
				mesg プレイヤー d:PLAYER wt_door \
					左舷上部ドア $status \	//$s:水密ドアの名前 $i:そのドアの状態
					0,1024 \					//$w:ドアに正対した方向 $w:方向幅
					-9250,-462					//$i:ドア位置Ｘ $i:ドア位置Ｚ

			}



//ハンドル掴んだときカメラ
		trap dr302 d:PLAYER \
			-camera \
			-mask ？ \
			-dir 0,256 \
			-state d:TRP_STATE_FORCE \
			-exec {
				chara カメラ設定 ビヨンドカメラ \
					-c 1 \
					-p -9214,-1219,-423 \
					-t -9214,-8217,-530 \
					-a 200 \
					-i 2 3 0 0 \
					-s $3
			}

















	}









//###################################################################################
//								船倉１演説ボリューム制御
//###################################################################################


	proc 船倉１演説ボリューム制御 {


		command	配列セット	$b:演説ボリューム[0] {
			0x3F,	0x3F
		}

		command	配列セット	$b:演説パン角度[0] {
			0x20,	0x20
		}

		command	配列セット	$i:法線大きさ２[0] {
			0,	0
		}


		trap ev2000 d:PLAYER \
			-mask いる \
			-exec {
				@船倉演説ボリューム制御 1 5000 -9000 -21500 0 0 0
			}

	}




//###################################################################################
//									ぼかし設定
//###################################################################################

	// ぼかしセット
	// ------------------------------------
	proc ぼかしセット {
		print 'ぼかしセット！！！！'

		chara 遠景ぼかし far_deforcus \
			-plane	4 \
			-near	6000 \
			-far	9000

		chara 近景ぼかし near_deforcus \
			-plane	3 \
			-near	0 \
			-far	3000


		@船倉敵兵発見ぼかし設定	//発見時カメラ用。w04.hにあります。

	}








//###################################################################################
//									透明壁設定
//###################################################################################

	proc 船倉透明壁設定{
		print '船倉透明壁設定'

		chara 透明壁 下側はしご東上部１ \
			-position 10000 -9000 -3000 2000 \
			11000 -9000 -3000 2000 \
			-attribute (d:HZX_SEG_NO_BULLET|d:HZX_SEG_NO_MISSILE|d:HZX_SEG_NO_C4|d:HZX_SEG_NO_RECOIL|d:HZX_SEG_NO_HARITSUKI|d:HZX_SEG_NO_DISP_RADAR|d:HZX_SEG_NO_BULLETHOLE|d:HZX_SEG_NO_SPRAY|d:HZX_SEG_NO_ENEMY_EYES)

		chara 透明壁 下側はしご東上部２ \
			-position 11000 -9000 -3000 2000 \
			11000 -9000 -4000 2000 \
