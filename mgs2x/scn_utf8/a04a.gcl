//###################################################################################
//									地下はしご設定
//###################################################################################


/*

地下ハッチ移動量
フタ開け
	922,24,941
またぎ移動
	945,16,932

*/
	proc 船倉１西側地下はしご設定 {
		print '船倉１西側地下はしご設定'

//西側
		chara プットモーションモデル 西側ハッチ \
			-pos -11500,-17000,-1000 \	//$v:配置座標
			-dir 0 \					//$i:方向
			-kms hatch \				//$s:KMSモデル名
			-mar hatch_w04 \			//$s:モーションファイル名
			-number 0 \					//$i:基本モーション番号 ...
			-status	0x0e 				//$w:ステータス
//			-status	0x02 0x04 0x08		//$w:ステータス

				/*ステータスフラグ設定は以下のとおり
					(0x01) モーションの水平移動量を無視
					(0x02) 重力処理無し
					(0x04) 壁アタリ判定無し
					(0x08) メッセージ受信までモーション停止
				*/



//跳弾アタリ追加
		command 追加ＨＺＸグループ登録 \
			-hzx_id 0 \
			-add_id 3




	//地下はしご西・上部用設定
		//----------------------


		//北側から
		trap la302h_right d:PLAYER -mask 入る -button d:ACTION_BUTTON -dir 0,256 \
			-state d:TRP_STATE_STAND \
			-exec {

				mesg 透明壁 地下ピット西側 on

				@北側から西地下ピットに下りる

			}


		//東側から
		trap la302h_front d:PLAYER -mask 入る -button d:ACTION_BUTTON -dir 3072,256 \
			-state d:TRP_STATE_STAND \
			-exec {

				if( $f:船倉１西側地下ピットふた開いた == 0 ){
					//フタを開けて北側に移動
					mesg プレイヤー d:PLAYER motion \
						d:モーションリスト:sna_non_ladder_hatch_open_c2r \
						3072 \
						-1 \
						0 \
						(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_WEAPON) \
						-10048 -1059 -15970	//x,z,yの順

					mesg プットモーションモデル 西側ハッチ 終了判定 2
					eval( $f:船倉１西側地下ピットふた開いた = 1 )
					@西側ハッチオープン跳弾アタリ変更

				}else{

					//北側に移動
					mesg プレイヤー d:PLAYER motion \
						d:モーションリスト:sna_non_ladder_hatch_c2r \
						3072 \
						-1 \
						0 \
						(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_WEAPON) \
						-10025 -1068 -15970	//x,z,yの順

				}

				mesg 透明壁 地下ピット西側 on

				@北側から西地下ピットに下りる

			}




		//はしご中カメラ
		trap la302_force d:PLAYER \
			-camera \
			-mask ？ -state d:TRP_STATE_FORCE \
			-exec {
				chara カメラ設定 ビヨンドカメラ \
					-c 1 \
					-p -10193,-14480,-81 \
					-t -10776,-15999,-646 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3
			}

		//はしご影消去
		trap la302_force d:PLAYER -mask いる \
			-state d:TRP_STATE_LADDER,d:TRP_STATE_FORCE \
			-exec {
				mesg プレイヤー d:PLAYER shadow 0
			}
		trap la302_force d:PLAYER -mask いる \
			-state d:TRP_STATE_STAND \
			-exec {
				mesg プレイヤー d:PLAYER shadow 1
			}



	//地下はしご西・下部用設定



#if d:ピット自動脱出
		//下から自動脱出
		trap la302l d:PLAYER \
			-mask いる \
			-exec{

				if( $4 < -10600 && !$f:船倉１西側地下ピットふた開いた){

					eval( $f:船倉１西側地下ピットふた開いた = 1 )
					@西側ハッチオープン跳弾アタリ変更

					mesg 透明壁 地下ピット西側 on

					//中からふた開けて上る
					mesg プレイヤー d:PLAYER motion \
						d:モーションリスト:sna_non_ladder_open2hatch_r \
						3072 \
						-1 \
						0 \
						(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT | d:FA_NO_WEAPON) \
						-10850 -1000 -18000	//x,z,yの順

					mesg プットモーションモデル 西側ハッチ 終了判定 4

				}

			}
#endif


		trap la302l d:PLAYER -mask 入る -button d:ACTION_BUTTON -dir 3072,256 \
			-state d:TRP_STATE_STAND \
			-exec {

				mesg 透明壁 地下ピット西側 on



				if( $f:船倉１西側地下ピットふた開いた == 0 ){

					//中からふた開けて上る
					mesg プレイヤー d:PLAYER motion \
						d:モーションリスト:sna_non_ladder_open2hatch_r \
						3072 \
						-1 \
						0 \
						(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT | d:FA_NO_WEAPON) \
						-10850 -1000 -18000	//x,z,yの順

					mesg プットモーションモデル 西側ハッチ 終了判定 4


					eval( $f:船倉１西側地下ピットふた開いた = 1 )
					@西側ハッチオープン跳弾アタリ変更

				}else{

					//昇って
					mesg プレイヤー d:PLAYER motion \
						d:モーションリスト:non_ladder_up_c_start \
						3072 \
						-1 \
						0 \
						(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_WEAPON) \
						-10850 -1000 -18470	//x,z,yの順


					//上に到着
					mesg プレイヤー d:PLAYER motion \
						d:モーションリスト:sna_non_ladder_up2hatch_r \
						-1 \
						-1 \
						0 \
						(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT | d:FA_NO_WEAPON)

				}


			}


/*
		trap la302l d:PLAYER -mask 入る -button d:ACTION_BUTTON -dir 3072,256 \
			-state d:TRP_STATE_STAND \
			-exec {

				mesg 透明壁 地下ピット西側 on

				mesg プレイヤー d:PLAYER position \
