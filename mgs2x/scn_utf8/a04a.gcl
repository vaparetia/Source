	proc 長廊下壊れライト設定{
			print '長廊下壊れライト設定'

			chara プットスポットライトオブジェ 照明モデル１ \
				-m w03_lit1a w03_lit1b \
				-t 9250,-2000,560 100 4000 \
				-l d:LT2_NAME \
