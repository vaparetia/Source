/***************************************************************************************/
// マップ宣言
/***************************************************************************************/
	// アナザー用プロック マップ設定前に設定する
	@アナザー用マップ定義前設定					// a_mode.h

	// マップ設定
	// ------------------------------------
	chara マップ 船倉１ -k w04a1 0 0 0 -h w04a 0 -l w04a
	chara マップ 通路１ -k w04a2 0 0 0 -h w04a 1 -l w04a
	chara マップ 長廊下小部屋 -k w04a1 0 0 0 -h w04a 2 -l w04a

	chara マップ接合 船倉接合右舷１Ｆ 船倉１ 通路１
	chara マップ接合 船倉接合左舷１Ｆ 船倉１ 通路１
	chara マップ接合 船倉接合２Ｆ 船倉１ 通路１
	chara マップ接合 船倉接合長廊下 船倉１ 長廊下小部屋


	command マップ設定 船倉１ 通路１ 長廊下小部屋 -set {
		@ローカル変数初期化
		@常駐キャラ設定							// stdch.h
		@A_プレイヤー設定 sna_w04 rai_w04		// a_stdproc.h
	}

	// アナザー用プロック マップ設定後に設定する
	@アナザー用マップ定義後設定					// a_mode.h

	command マップ設定 船倉１ 通路１ 長廊下小部屋 -set {
		/* サウンドマネージャー＞敵兵コマンダー＞ＢＧＭマネージャー
		   の順番は、遵守すること */

		// ポリデモ以外の時セット
		//@サウンドマネージャー設定
//		@レーダー設定
		//@常駐キャラ設定
		//@プレイヤー設定
		@跳弾設定
		@はしご設定
		@カメラ設定
		@マップ接続
		@演説音声小さめに	//w04.hの中
		@エフェクト設定
		@ぼかしセット
		@ドア設置／船倉１－通路１

#if d:debug_timer
		if( $f:a01a_船倉イベントセット == 1 ) {
			@船倉カウントダウンタイマー初期化
		}
#endif

#if d:CTDOWN_TIMER
		if( $f:a01a_船倉イベントセット == 1 ) {
			@船倉タイマー起動
		}
#endif

	}



	command マップ設定 船倉１ -set {
		@プロジェクタライト設定

		@船倉１ビヨンド設定
		@船倉１落下キャッチ設定
	#if d:AUTO_JUMP
		@船倉１ｍジャンプ設定
	#endif
		@船倉１はしご設定

		@長廊下壊れライト設定
		@船倉１箱設置
#if d:空中ワイヤ
		@空中ワイヤ設置
#endif
		@船倉透明壁設定

	#if d:SEALS_1_FG
		if( $f:a01a_船倉イベントセット == 1 ) {
			@船倉１海兵隊セット
			@船倉物音カメラ		//w04.hの中
		}
	#endif

	#if d:PITHOLE
		@船倉１西側地下はしご設定
		@船倉１東側地下はしご設定
	#endif

	#if d:SNEEZE
		@船倉くしゃみ設定		//w04.hにある
	#endif

	}

	command マップ設定 通路１ -set {
		@通路１カメラ設定
		@主観禁止壁設定
	}


	command マップ設定 長廊下小部屋 -set {
		@長廊下透明壁設定
	}

	command マップ設定 長廊下小部屋 船倉１ -set {
		@船倉１カメラ設定
		@アイテム設定
		@船倉１水密ドア設置

	}


	command マップ設定 船倉１ 通路１ 長廊下小部屋 -set {
		@船倉１演説ボリューム制御

		//@サウンド設定
		@第一第二船倉キャラクタ専用ライトセット		//w04.hにある
		//@タンカーデジカメ写真判定		//dcam_tanker.hの中にあります。
		//@タンカー編全体マップ設定 d:第一船倉マップ
		@ポーズ時ステージ名表示設定 d:wn_第一船倉

		#if d:MY_DEBUG
			@デバッグ設定
		#endif
	}



	//初期マップの表示
	command マップ表示 	-add 船倉１ 長廊下小部屋

	eval( $f:船倉１西側地下ピットふた開いた = 0 )
	eval( $f:船倉１東側地下ピットふた開いた = 0 )
	eval($w:船倉物音カメラフレーム数 = 0)
	eval($f:船倉ステージ移動直後 = 1)
	eval($s:ドッキリ系スタート = 不可)
	eval($b:船倉デジカメ撮影つぶやき中 = 0)
	eval($f:ローカルフラグ１ = 0)
	eval($w:船倉演説イベント中 = 0)
	eval($f:ゲームオーバー処理終了呼ばれた = 0)
	eval($b:船倉デジカメ撮影つぶやき中 = 0)


	//w04bから来たときは通路に現れるため、通路を表示させる
	if($s:登場ポイント != 水密ドア ){
		print 'マップ接合ＯＮ！！'
		mesg マップ接合 船倉接合右舷１Ｆ on
		mesg マップ接合 船倉接合左舷１Ｆ on
		mesg マップ接合 船倉接合２Ｆ on
	}



// ポリデモ以外の時セット
	@第１船倉ロード進入時処理



//}		//$s:d_num == not_demo	の閉じカッコ // removed by S.Hirano 010530









//###################################################################################
//									変数初期化
//###################################################################################

	proc ローカル変数初期化 {
	}

//###################################################################################
//									レーダー設定
//###################################################################################

	proc レーダー設定 {

		#if d:RADAR
			chara レーダー レーダー

			if($f:レーダーフラグ){
				mesg レーダー レーダー on
			} else {
				mesg レーダー レーダー off
			}

		#endif
	}



//###################################################################################
//									エフェクト設定
//###################################################################################

	proc エフェクト設定 {
		print 'エフェクト設定'

		print 'フォグフォグ君！！'

		chara フォグ fog \
			 -c 0 10 15 \
			 -n -5000 \
			 -f 50000

		print 'フォグフォグ君終了！！'





//レーダーアタリ処理
		print 'レーダーアタリ追加'
		command foreach -argc 1 -repeat 3 \
			-data { \
				{0},{1},{2} \
			} \
			-exec {
				command 追加ＨＺＸグループ登録 \
					-hzx_id $1 \
					-add_id 8
			}



	}






//###################################################################################
//									サウンド設定
//###################################################################################

	// サウンド設定
	proc サウンドマネージャー設定{
#if d:SOUND_FG
		print 'サウンドマネージャー設定'

		chara サウンドマネージャー ＳＤマネ -pak 0
#endif
	}


	proc サウンド設定 {
		#if d:SOUND_FG
			print 'サウンド設定'

		//ここはゲームオーバーデモのために特殊
#if 1
		command セットサウンドコード -c d:SNG_PLAY_05
#else
		chara ＢＧＭマネージャー ＢＧＭマネ
#endif

#if 1
			@サウンド効果音設定
#else
#endif


		#endif
	}








//###################################################################################
//									プレイヤー設定
//###################################################################################

	proc プレイヤー設定 {
		print 'プレイヤー設定'

				chara プレイヤー d:PLAYER \
//					-p 10972,-1000,-850 \
//					-p 6000,-15000,-3000 \//１Ｆ
//					-p 2400,-17900,-11300 \//地下
					-p $i:プレイヤー初期Ｘ位置 $i:プレイヤー初期Ｙ位置 $i:プレイヤー初期Ｚ位置 \
					-d 0,$i:プレイヤー初期方向,0 \
					-s 0 \
					-i 0 \
					-m sna_def -a snake -o sna_w04

				//バンダナ
				chara ロープモデル３ バンダナ１ \
					-n sna_bdn1 \
					-d 1 \
					-y d:PLAYER \
					-z 12 \
					-x 0,60,-90 \
					-m 12 \
					-p 250 \
					-k 350 \
					-o 110 \
					-f 1

				chara ロープモデル３ バンダナ２ \
					-n sna_bdn2 \
					-d 1 \
					-y d:PLAYER \
					-z 12 \
					-x 0,50,-90 \
					-m 22 \
					-p 250 \
					-k 350 \
					-o 110 \
					-f 1

		#if d:MULTI_MODEL
			chara マルチウェイトキャラ マルチ \
				-name d:PLAYER \
				-model sna_mmt

			chara 臨時顔アニメキャラ アニメキャラ \
				-chara	d:PLAYER
		#endif

			//@プレイヤーＬＯＤ設定 d:P_STATE_TYPE d:TRP_STATE_BEHIND
			@プレイヤーＬＯＤ設定 d:C_DISTANCE_TYPE 6000


	}

	proc はしご設定 {
		//はしごモード追加
		command プラグインはしご
		command はしご設定 \
			-b 	d:モーションリスト:non_ladder_idle_loop,\
				d:モーションリスト:non_ladder_idle_loop_l,\
				d:モーションリスト:non_ladder_up_loop,\
				d:モーションリスト:non_ladder_down_loop
	}

	proc 跳弾設定 {
		// 跳弾番号設定
	// ------------------------------------
		command 跳弾ノーマル -n 0
		command 跳弾ノーマル -n 1
		command 跳弾ノーマル -n 2
		command 跳弾ノーマル -n 3
		command 跳弾ノーマル -n 4

		command 弾痕ノーマル -n 0
		command 弾痕ノーマル -n 1
		command 弾痕ノーマル -n 2
		command 弾痕ノーマル -n 3
		command 弾痕ノーマル -n 4



//		command 跳弾水蒸気中 -n 8
//		command 跳弾水蒸気小 -n 9
	}










//###################################################################################
//								プロジェクタ設定
//###################################################################################

	//プロジェクタ光設定
	// ------------------------------------

	proc プロジェクタライト設定 {
		print 'プロジェクタライト設定'

		chara スポットライト投影モデル プロジェクタライト \
			-m w04a1_k1 \
			-p 0,0,0

		chara 静止スポットライト設置 プロジェクタライト \
			-pos 140,-15600,-1300 \
			//-dir -184,1894,0 \
			-dir -174,1894,0 \
			-range 30000 \
			//-angle 15 \
			-angle 13 \
			-color 255,255,255 \
			-option 0x0001




//	( DX , DY , DZ )のベクトルの算出は、
//	( atan( DY / sqr( DX^2 + DZ^2 ) ) * ( -4096 / 360 ) , 1024 + atan( DY/DX ) * ( -4096 / 360 ) , 0 )

		chara プロジェクタライト プロジェクタライト \
			-p 140,-15600,-1300 \
			-d 4000,-10000,-22000





		//影判定用
		command 影投影ハザード \
			-name 船倉１ \
			-group 7



#if d:movie
		chara スポットライト背景イメージ指定 テストムービー
#endif

	}









