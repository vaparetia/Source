//###################################################################################
//									ビヨンド設定
//###################################################################################

proc 船倉１ビヨンド設定 {
		print 'beyond_set'
		print '船倉１ビヨンド設定'


//エルード踊り場→スクリーン横
		trap by100 d:PLAYER \
			-mask いる \
			-button d:ACTION_BUTTON \		//ビヨンドボタン
			-state 0,4 \	//立ち状態or張り付き
			-exec {
				mesg プレイヤー d:PLAYER shadow 0

				@西向きビヨンド発動 by100 10070 $6 -19500 500 \
					d:BY_FALL_DEAD
			}


//★★エルード２Ｆドアそば２（by102）とぶつかるため、サブカメラ３にした★★

		//強制モーション中（両端）
		trap by100 d:PLAYER \
			-camera \
			-mask いる \
			-state 6 \
