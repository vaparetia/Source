//###################################################################################


	proc 船倉１落下キャッチ設定 {


	//３Ｆから２Ｆへ右舷
		trap by100 d:PLAYER \
			-mask いる \
			-key d:PAD_X \
			-state d:TRP_STATE_ELUDE_FALL \
			-exec {
				print '落下キャッチ！！！！'
				@エルード落下キャッチ by103 $1 -9000 10000 $5 $6 1024 d:BY_FALL_DEAD
				@エルード落下キャッチ by106 $1 -9000 10000 $5 $6 1024 d:BY_FALL_DEAD
			}


	//３Ｆから２Ｆへ左舷
		trap by104 d:PLAYER \
			-mask いる \
			-key d:PAD_X \
			-state d:TRP_STATE_ELUDE_FALL \
			-exec {
				print '落下キャッチ！！！！'
				@エルード落下キャッチ by203 $1 -9000 -10000 $5 $6 3072 d:BY_FALL_DEAD
				@エルード落下キャッチ by106 $1 -9000 -10000 $5 $6 3072 d:BY_FALL_DEAD
			}


	//横ワイヤから縦ワイヤ右側へ
		trap by107r d:PLAYER \
			-mask いる \
			-key d:PAD_X \
			-state d:TRP_STATE_ELUDE_FALL \
			-exec {
				print '落下キャッチ！！！！'
				@エルード落下キャッチ by106 $1 -9000 (-1000 - 70) $5 $6 3072 0x0002
			}


	//横ワイヤから縦ワイヤ左側へ
		trap by107l d:PLAYER \
			-mask いる \
			-key d:PAD_X \
			-state d:TRP_STATE_ELUDE_FALL \
			-exec {
				print '落下キャッチ！！！！'
				@エルード落下キャッチ by106 $1 -9000 (-1000 + 50) $5 $6 1024 0x0002
			}




		trap by108r d:PLAYER \
			-mask いる \
			-key d:PAD_X \
			-state d:TRP_STATE_ELUDE_FALL \
			-exec {

				//縦ワイヤから横ワイヤへ
				@エルード落下キャッチ by107r $1 -13000 $4 $5 (-17000 - 150) 2048 0x0002
				@エルード落下キャッチ by107l $1 -13000 $4 $5 (-17000 - 150) 2048 0x0002

				//左舷縦ワイヤから横ワイヤへ
				@エルード落下キャッチ by201 $1 -13000 $4 $5 (-17000 - 150) 2048 0x0002
/*
				//右舷２Ｆから横ワイヤへ
				@エルード落下キャッチ by100 $1 -13000 $4 $5 (-17000 - 150) 2048 0x0002

				//右舷２Ｆから横ワイヤへ
				@エルード落下キャッチ by104 $1 -13000 $4 $5 (-17000 - 150) 2048 0x0002
*/
			}

		trap by108f d:PLAYER \
			-mask いる \
			-key d:PAD_X \
			-state d:TRP_STATE_ELUDE_FALL \
			-exec {
				print 'ぴりぴりぷりん'

				//縦ワイヤから横ワイヤへ
				@エルード落下キャッチ by107r $1 -13000 $4 $5 -17000 0 0x0002
				@エルード落下キャッチ by107l $1 -13000 $4 $5 -17000 0 0x0002

				//左舷縦ワイヤから横ワイヤへ
				@エルード落下キャッチ by201 $1 -13000 $4 $5 -17000 0 0x0002
/*
				//右舷２Ｆから横ワイヤへ
				@エルード落下キャッチ by100 $1 -13000 $4 $5 -17000 0 0x0002

				//右舷２Ｆから横ワイヤへ
				@エルード落下キャッチ by104 $1 -13000 $4 $5 -17000 0 0x0002
*/
			}






		trap ev005 d:PLAYER \
			-mask 入る \
			//-dir 1024,256 3072,256 \
			-state d:TRP_STATE_ELUDE_FALL \
			-exec {

#if 1
				@空中落下死亡開始		//w04.hの中
#else
				if(`%ゲームオーバーチェック` == 0){
					command ゲームオーバー処理開始 \
						-exec {
							command ゲームオーバー処理終了
						}
				}
#endif
			}





	}








//###################################################################################
//								船倉１ｍジャンプ設定
//###################################################################################

	proc 船倉１ｍジャンプ設定 {
		command プラグイン自動ジャンプ


		trap ky000 d:PLAYER \
			-mask 入る \
			-exec {
				@ジャンプ発動 ky000 1000 50
			}


	}



//###################################################################################
//									海兵隊設定
//###################################################################################

#define	左舷船首巡回		0
#define	左舷船首往復		2
#define	左舷タンク側棒立ち	4
#define	右舷２Ｆ往復		5
#define	右舷２Ｆ棒立ち		6

	proc null {}

	// 設置オブジェクト
	// ------------------------------------
	proc 船倉１海兵隊 {

		command カメラチェックキャラワーク確保

		if($w:ゲーム設定 <= d:LEVEL_VERYEASY){

			chara 船倉兵 SEALS_1 -a { \
				#include "w04a_seals_matrix.h"		//船倉兵の配列（共通）
				//船倉兵:a0,{0,0,d:左舷船首往復},{0,2048,0},		11,	101, 0, 0x0014 \
				船倉兵:a4,{0,0,d:右舷２Ｆ棒立ち},{0,2048,0 },		11,	101, 0, 0x0014 \
				船倉兵:14,{( 2250+10*2),-17000,(-14500+08*2)},{0,2048,0 },	20,	100, 2, 0x0020 \	//パンツ兵
			} \
			#include "w04a_seals_param.h"
			-j	船倉兵:a4 ドッグタグ_敵兵 [dogtag:tnk_w04a_guard_ve_01] \
					[dogtag:tnk_w04a_guard_ea_01] [dogtag:tnk_w04a_guard_no_01] \
					[dogtag:tnk_w04a_guard_ha_01] [dogtag:tnk_w04a_guard_vh_01] \
				船倉兵:8a ドッグタグ_敵兵 [dogtag:tnk_w04a_guard_ve_02] \
					[dogtag:tnk_w04a_guard_ea_02] [dogtag:tnk_w04a_guard_no_02] \
					[dogtag:tnk_w04a_guard_ha_02] [dogtag:tnk_w04a_guard_vh_02]

		}else if($w:ゲーム設定 == d:LEVEL_EASY){

			chara 船倉兵 SEALS_1 -a { \
				#include "w04a_seals_matrix.h"		//船倉兵の配列（共通）
				//船倉兵:a0,{0,0,d:左舷船首往復},{0,2048,0},		11,	101, 0, 0x0014 \
				船倉兵:a4,{0,0,d:右舷２Ｆ棒立ち},{0,2048,0 },		11,	101, 0, 0x0014 \
				船倉兵:14,{( 2250+10*2),-17000,(-14500+08*2)},{0,2048,0 },	20,	100, 2, 0x0020 \	//パンツ兵
			} \
			#include "w04a_seals_param.h"
			-j	船倉兵:a4 ドッグタグ_敵兵 [dogtag:tnk_w04a_guard_ve_01] \
					[dogtag:tnk_w04a_guard_ea_01] [dogtag:tnk_w04a_guard_no_01] \
					[dogtag:tnk_w04a_guard_ha_01] [dogtag:tnk_w04a_guard_vh_01] \
				船倉兵:14 ドッグタグ_敵兵 [dogtag:tnk_w04a_guard_ve_02] \
					[dogtag:tnk_w04a_guard_ea_02] [dogtag:tnk_w04a_guard_no_02] \
					[dogtag:tnk_w04a_guard_ha_02] [dogtag:tnk_w04a_guard_vh_02]

		}else if($w:ゲーム設定 == d:LEVEL_NORMAL){

			chara 船倉兵 SEALS_1 -a { \
				#include "w04a_seals_matrix.h"		//船倉兵の配列（共通）
				船倉兵:a2,{0,0,d:左舷タンク側棒立ち},{0,2048,0 },	11,	101, 0, 0x0014 \
				船倉兵:a4,{0,0,d:右舷２Ｆ棒立ち},{0,2048,0 },	11,	101, 0, 0x0014 \
				船倉兵:14,{( 2250+10*2),-17000,(-14500+08*2)},{0,2048,0 },	20,	100, 2, 0x0020 \	//パンツ兵
			} \
			#include "w04a_seals_param.h"
			-j	船倉兵:a4 ドッグタグ_敵兵 [dogtag:tnk_w04a_guard_ve_01] \
					[dogtag:tnk_w04a_guard_ea_01] [dogtag:tnk_w04a_guard_no_01] \
					[dogtag:tnk_w04a_guard_ha_01] [dogtag:tnk_w04a_guard_vh_01] \
				船倉兵:8a ドッグタグ_敵兵 [dogtag:tnk_w04a_guard_ve_02] \
					[dogtag:tnk_w04a_guard_ea_02] [dogtag:tnk_w04a_guard_no_02] \
					[dogtag:tnk_w04a_guard_ha_02] [dogtag:tnk_w04a_guard_vh_02] \
				船倉兵:a2 ドッグタグ_敵兵 [dogtag:dummy] \
					[dogtag:dummy] [dogtag:tnk_w04a_guard_no_03] \
					[dogtag:tnk_w04a_guard_ha_03] [dogtag:dummy]

		}else if($w:ゲーム設定 == d:LEVEL_HARD){

			chara 船倉兵 SEALS_1 -a { \
				#include "w04a_seals_matrix.h"		//船倉兵の配列（共通）
				船倉兵:a1,{0,0,d:左舷船首往復},{0,2048,0 },	11,	101, 0, 0x0014 \
				船倉兵:a2,{0,0,d:左舷タンク側棒立ち},{0,2048,0 },	11,	101, 0, 0x0014 \
				船倉兵:a4,{0,0,d:右舷２Ｆ棒立ち},{0,2048,0 },	11,	101, 0, 0x0014 \
				船倉兵:14,{( 2250+10*2),-17000,(-14500+08*2)},{0,2048,0 },	20,	100, 2, 0x0020 \	//パンツ兵
			} \
			#include "w04a_seals_param.h"
			-j	船倉兵:a4 ドッグタグ_敵兵 [dogtag:tnk_w04a_guard_ve_01] \
					[dogtag:tnk_w04a_guard_ea_01] [dogtag:tnk_w04a_guard_no_01] \
					[dogtag:tnk_w04a_guard_ha_01] [dogtag:tnk_w04a_guard_vh_01] \
				船倉兵:a2 ドッグタグ_敵兵 [dogtag:tnk_w04a_guard_ve_02] \
					[dogtag:tnk_w04a_guard_ea_02] [dogtag:tnk_w04a_guard_no_02] \
					[dogtag:tnk_w04a_guard_ha_02] [dogtag:tnk_w04a_guard_vh_02] \
				船倉兵:a1 ドッグタグ_敵兵 [dogtag:dummy] \
					[dogtag:dummy] [dogtag:tnk_w04a_guard_no_03] \
					[dogtag:tnk_w04a_guard_ha_03] [dogtag:dummy]

		}else{

			chara 船倉兵 SEALS_1 -a { \
#include "w04a_seals_matrix.h"		//船倉兵の配列（共通）
				船倉兵:a3,{0,0,d:左舷船首巡回},{0,2048,0 },	11,	101, 0, 0x0014 \
				船倉兵:a4,{0,0,d:右舷２Ｆ棒立ち},{0,2048,0 },	11,	101, 0, 0x0014 \
				船倉兵:14,{( 2250+10*2),-17000,(-14500+08*2)},{0,2048,0 },	20,	100, 2, 0x0020 \	//パンツ兵
			} \
			#include "w04a_seals_param.h"
			-j	船倉兵:a4 ドッグタグ_敵兵 [dogtag:tnk_w04a_guard_ve_01] \
					[dogtag:tnk_w04a_guard_ea_01] [dogtag:tnk_w04a_guard_no_01] \
					[dogtag:tnk_w04a_guard_ha_01] [dogtag:tnk_w04a_guard_vh_01] \
				船倉兵:a3 ドッグタグ_敵兵 [dogtag:tnk_w04a_guard_ve_02] \
					[dogtag:tnk_w04a_guard_ea_02] [dogtag:tnk_w04a_guard_no_02] \
					[dogtag:tnk_w04a_guard_ha_02] [dogtag:tnk_w04a_guard_vh_02]






		}





//右舷エルードでスクリーンに近づいたときルートチェンジ
		trap en000 d:PLAYER \
			-mask 入る \
			-exec {

				chara delay ディレイ \
					-time 90 \
					-exec{
						mesg 船倉兵 船倉兵:a4 ルート変更 d:右舷２Ｆ往復 0
					}
			}




	}


	proc げろっぱ{
		print 'なんにもねんだよバーカ！！！！'
	}


//proc 敵兵発見は"w04.h"の中にあります。



	proc プロジェクタ１ {

		if(`%ゲームオーバーチェック` == 0 && $f:ロードチェックＯＮフラグ){
			print 'プロジェクタに映ってもた'

			mesg プレイヤー d:PLAYER stance \
				d:FA_END_STAND \
				-1 \
				-1 \
				d:FA_BOX_EXIST
				//d:FA_NO_INTERP

			chara delay プロジェクタ映った -time 2 -exec{

				command ゲームオーバー処理開始 -load -exec {
					command セットタイマーステータス -s d:TMR_WAIT

					command メニュー設定 \
						-gage off \
						-radar off \
						-subwin off \
						-radio off \
						-pause off


					command 無線設定 -reset

					command パッド操作 \
						-release


					eval($w:船倉演説イベント中 = 100)


					chara カメラ設定 ビヨンドカメラ \
						-c 1 \
						-p 124,-15507,-27 \
						-t 124,-14951,-4373 \
						-a 200 \
						-i 2 -1 0 0 \
						-s 1

					chara delay プロジェクタ映った \
						-time 120 \
						-p 船倉敵兵発見ゲームオーバー

				}
			}
		}
	}

	proc 船倉１海兵隊セット {
		print '船倉１海兵隊セット'

		chara コマンダー 敵兵セット -w 	船倉１海兵隊 \
			-s (d:ENE_STAGE_CROWD_PEOPLE | d:ENE_STAGE_NO_WC_GOVER) \
			-z $i:敵標準麻酔持続 \
			-o $i:敵標準気絶持続 \
			-v [ene_tank_voice:01]

	}


//こいつは空です。
	proc プロジェクタ２ {
	}

//proc 船倉兵物音反応は"w04.h"の中にあります。




//proc 最初の一人発見は"w04.h"の中にあります。


//proc ライターのぞき発見は"w04.h"の中にあります。


//proc 船倉パンツ兵写真判定は"dcam_tanker.h"の中にあります。


//proc 船倉兵死亡時プロックは"w04.h"の中にあります。


//###################################################################################
//									船倉１箱設置
//###################################################################################

proc 船倉１箱設置{
	print '船倉１箱設置'


	chara プットオブジェ スピーカーボックス -m w04_box -r 0 1024 0 \
		-s 100,120,100 \
		-p -9500 -17000 -15500 -l w04a


	chara プットオブジェ スピーカー -m w04_box2 -r 0 2048 0 \
		-p -5000 -17000 -3000 -l w04a


	chara プットオブジェ スピーカー -m w04_box2 -r 0 2048 0 \
		-p 3000 -17000 -3000 -l w04a


}


//###################################################################################
//									空中ワイヤ設置
//###################################################################################

proc 空中ワイヤ設置 {

	print '空中ワイヤ設置'

#define	ワイヤの太さ	10

	//入口側横ワイヤ
	chara プットオブジェ 空中ワイヤ君１ -m w04_test_bou -r 1024 3072 0 \
		-s 1600,d:ワイヤの太さ,d:ワイヤの太さ \
		-f 0x0101 \		//赤外線反応フラグ
		-p 8000 -5000 -2050 -l w04a

	//中央縦ワイヤ
	chara プットオブジェ 空中ワイヤ君２ -m w04_test_bou -r 1024 2048 0 \
		-s d:ワイヤの太さ,d:ワイヤの太さ,2400 \
		-f 0x0101 \		//赤外線反応フラグ
		-p -1000 -9000 0 -l w04a
//		-p -4000 -9000 0 -l w04a


	//スクリーン側横ワイヤ
	chara プットオブジェ 空中ワイヤ君３ -m w04_test_bou -r 1024 3072 0 \
//		-s 2400,d:ワイヤの太さ,d:ワイヤの太さ \
		-s 2400,5,5 \
		-f 0x0101 \		//赤外線反応フラグ
		-p 12000 -13000 -17000 -l w04a


	//左舷３Ｆ縦ワイヤ
	chara プットオブジェ 空中ワイヤ君４ -m w04_test_bou -r 1024 2048 0 \
		-s d:ワイヤの太さ,d:ワイヤの太さ,2400 \
		-f 0x0101 \		//赤外線反応フラグ
		-p -7950 -5000 0 -l w04a




	//ワイヤ振動
	trap by106 d:PLAYER \
		-mask ＊ \
		-state d:TRP_STATE_ELUDE \
		-dir 0,256 \	//方向指定
		-exec {

			command パッドチェック \
				-which 0 \
				-status		//押されている

			//Ｒ２、Ｌ２を押している、または主観でない状態で左右を入力している
			if($3 == いる && ( ($status & (d:PAD_R2 | d:PAD_L2)) || (($status & (d:PAD_R | d:PAD_L) && !($status & d:PAD_R1))) )){

				@CS_スムーズカメラ昇順 (`%abs $4`) 0 8000 50 1
				eval($b:ワイヤ振幅縦 = $i:CS_結果１)

				@CS_スムーズカメラ昇順 (`%abs $4`) 0 8000 10 1
				eval($b:ワイヤ振幅横 = $i:CS_結果１)

				mesg プットオブジェ 空中ワイヤ君１ move 8000 (-5000 - `%rand $b:ワイヤ振幅縦`) (-2060 + `%rand $b:ワイヤ振幅横`)

			}else{
				mesg プットオブジェ 空中ワイヤ君１ move 8000 -5000 -2050

			}

		}



	//空中ワイヤ君２振動
	trap by107l d:PLAYER \
		-mask ＊ \
		-state d:TRP_STATE_ELUDE \
		-exec {
			@空中ワイヤ君２振動処理 $1 $2 $3 $4 $5 $6
		}


	trap by107r d:PLAYER \
		-mask ＊ \
		-state d:TRP_STATE_ELUDE \
		-exec {
			@空中ワイヤ君２振動処理 $1 $2 $3 $4 $5 $6
		}




	//空中ワイヤ君３振動
	trap by108f d:PLAYER \
		-mask ＊ \
		-state d:TRP_STATE_ELUDE \
		-exec {
			@空中ワイヤ君３振動処理 $1 $2 $3 $4 $5 $6
		}


	trap by108r d:PLAYER \
		-mask ＊ \
		-state d:TRP_STATE_ELUDE \
		-exec {
			@空中ワイヤ君３振動処理 $1 $2 $3 $4 $5 $6
		}






	//３Ｆ左舷
	trap by201 d:PLAYER \
		-mask ＊ \
		-state d:TRP_STATE_ELUDE \
		-dir 3072,256 \	//方向指定
		-exec {

			command パッドチェック \
				-which 0 \
				-status		//押されている

			//Ｒ２、Ｌ２を押している、または主観でない状態で左右を入力している
			if($3 == いる && ( ($status & (d:PAD_R2 | d:PAD_L2)) || (($status & (d:PAD_U | d:PAD_D) && !($status & d:PAD_R1))) )){

				@CS_スムーズカメラ昇順 (`%abs (-10000 - $6)`) 0 12000 50 1
				eval($b:ワイヤ振幅縦 = $i:CS_結果１)

				@CS_スムーズカメラ昇順 (`%abs (-10000 - $6)`) 0 12000 10 1
				eval($b:ワイヤ振幅横 = $i:CS_結果１)


				mesg プットオブジェ 空中ワイヤ君４ move (-7955 + `%rand $b:ワイヤ振幅横`) (-5000 - `%rand $b:ワイヤ振幅縦`) 0

			}else{
				mesg プットオブジェ 空中ワイヤ君４ move -7950 -5000 0

			}

		}


}




proc 空中ワイヤ君２振動処理 $:どこ $:誰 $:いつ $:Ｘ座標 $:Ｙ座標 $:Ｚ座標 {

	command パッドチェック \
		-which 0 \
		-status		//押されている

	//Ｒ２、Ｌ２を押している、または主観でない状態で左右を入力している
	if($3 == いる && ( ($status & (d:PAD_R2 | d:PAD_L2)) || (($status & (d:PAD_U | d:PAD_D) && !($status & d:PAD_R1))) )){

		@CS_スムーズカメラ昇順 (`%abs (-12000 - $6)`) 0 12000 50 1
		eval($b:ワイヤ振幅縦 = $i:CS_結果１)

		@CS_スムーズカメラ昇順 (`%abs (-12000 - $6)`) 0 12000 10 1
		eval($b:ワイヤ振幅横 = $i:CS_結果１)

		mesg プットオブジェ 空中ワイヤ君２ move (-1005 + `%rand $b:ワイヤ振幅横`) (-9025 + `%rand $b:ワイヤ振幅縦`) 0

	}else{
		mesg プットオブジェ 空中ワイヤ君２ move -1000 -9000 0

	}



}





proc 空中ワイヤ君３振動処理 $:どこ $:誰 $:いつ $:Ｘ座標 $:Ｙ座標 $:Ｚ座標 {

	command パッドチェック \
		-which 0 \
		-status		//押されている

	//Ｒ２、Ｌ２を押している、または主観でない状態で左右を入力している
	if($3 == いる && ( ($status & (d:PAD_R2 | d:PAD_L2)) || (($status & (d:PAD_R | d:PAD_L) && !($status & d:PAD_R1))) )){
		print '振動中デース！！！'

		@CS_スムーズカメラ昇順 (`%abs $4`) 0 12000 50 1
		eval($b:ワイヤ振幅縦 = $i:CS_結果１)

		@CS_スムーズカメラ昇順 (`%abs $4`) 0 12000 10 1
		eval($b:ワイヤ振幅横 = $i:CS_結果１)

		mesg プットオブジェ 空中ワイヤ君３ move 12000 (-13025 + `%rand $b:ワイヤ振幅縦`) (-17005 + `%rand $b:ワイヤ振幅横`)

	}else{
		mesg プットオブジェ 空中ワイヤ君３ move 12000 -13000 -17000

	}



}






//###################################################################################
//									ドア設定
//###################################################################################


	// ドアオブジェクト
	// ------------------------------------
	proc ドア設置／船倉１－通路１ {
		print 'ドア設置！！！！'

		chara ドア 右舷ドア１１ \
			-m w04_dr \
			-d 0,0,0 \
			-p 7250,-17000,-24050 \
			-slide 1600 \
			-time d:SD_OPEN_TIME \
			-between 船倉１ 通路１ \
			-exec {
				if( $:開閉フラグ == 0 ){
					mesg マップ接合 船倉接合右舷１Ｆ off
				} else {
					mesg マップ接合 船倉接合右舷１Ｆ on
				}
			}

		trap dr100 ？ -mask ？\
			-exec {
				if ( $3 == 入る ) {
					mesg ドア 右舷ドア１１ open $2
				} else {
					mesg ドア 右舷ドア１１ close $2
				}
			}


		chara ドア 右舷ドア１１奥 \
			-m w04_dr \
			-d 0,2048,0 \
 			-p 8750,-17000,-28450 \
			-slide 1600 \
			-between 通路１ 通路１ \
			-time d:SD_OPEN_TIME

		trap dr200 ？ -mask ？\
			-exec {
				if ( $3 == 入る ) {
					mesg ドア 右舷ドア１１奥 open $2
				} else {
					mesg ドア 右舷ドア１１奥 close $2
				}
			}




		chara ドア 左舷ドア１１ \
			-m w04_dr \
			-d 0,0,0 \
			-p -8750,-17000,-24050 \
			-slide 1600 \
			-time d:SD_OPEN_TIME \
			-between 船倉１ 通路１ \
			-exec {
				if( $:開閉フラグ == 0 ){
					mesg マップ接合 船倉接合左舷１Ｆ off
				} else {
					mesg マップ接合 船倉接合左舷１Ｆ on
				}
			}

		trap dr101 ？ -mask ？ \
			-exec {
				if ( $3 == 入る ) {
					mesg ドア 左舷ドア１１ open $2
				} else {
					mesg ドア 左舷ドア１１ close $2
				}

			}

		chara ドア 左舷ドア１１奥 \
			-m w04_dr \
			-d 0,2048,0 \
			-p -7250,-17000,-28450 \
			-slide 1600 \
			-between 通路１ 通路１ \
			-time d:SD_OPEN_TIME

		trap dr201 ？ -mask ？ \
			-exec {
				if ( $3 == 入る ) {
					mesg ドア 左舷ドア１１奥 open $2
				} else {
					mesg ドア 左舷ドア１１奥 close $2
				}
			}



		chara ドア 右舷上部ドア１１ \
			-m w04_dr \
			-d 0,0,0 \
			-p 10250,-9000,-24050 \
			-slide 1600 \
			-time d:SD_OPEN_TIME \
			-between 船倉１ 通路１ \
			-exec {
				if( $:開閉フラグ == 0 ){
					mesg マップ接合 船倉接合２Ｆ off
				} else {
					mesg マップ接合 船倉接合２Ｆ on
				}
			}

		trap dr102 ？ -mask ？ \
			-exec {
				if ( $3 == 入る ) {
					mesg ドア 右舷上部ドア１１ open $2
				} else {
					mesg ドア 右舷上部ドア１１ close $2
				}

			}


		chara ドア 右舷上部ドア１１奥 \
			-m w04_dr \
			-d 0,2048,0 \
			-p 11750,-9000,-28450 \
			-slide 1600 \
			-between 通路１ 通路１ \
			-time d:SD_OPEN_TIME

		trap dr202 ？ -mask ？ \
			-exec {
				if ( $3 == 入る ) {
					mesg ドア 右舷上部ドア１１奥 open $2
				} else {
					mesg ドア 右舷上部ドア１１奥 close $2
				}
			}



		chara ドア 左舷上部ドア１１ \
			-m w04_dr \
			-d 0,0,0 \
			-p -11750,-9000,-24050 \
			-slide 1600 \
			-time d:SD_OPEN_TIME \
			-between 船倉１ 通路１ \
			-exec {
				if( $:開閉フラグ == 0 ){
					mesg マップ接合 船倉接合２Ｆ off
				} else {
					mesg マップ接合 船倉接合２Ｆ on
				}
			}

		trap dr103 ？ -mask ？ \
			-exec {
				if ( $3 == 入る ) {
					mesg ドア 左舷上部ドア１１ open $2
				} else {
					mesg ドア 左舷上部ドア１１ close $2
				}
			}



		chara ドア 左舷上部ドア１１奥 \
			-m w04_dr \
			-d 0,2048,0 \
			-p -10250,-9000,-28450 \
			-slide 1600 \
			-between 通路１ 通路１ \
			-time d:SD_OPEN_TIME


		trap dr203 ？ -mask ？ \
			-exec { if ( $3 == 入る ) {
					mesg ドア 左舷上部ドア１１奥 open $2
				} else {
					mesg ドア 左舷上部ドア１１奥 close $2
				}
			}


	}




//###################################################################################
//									主観禁止壁設定
//###################################################################################

	proc 主観禁止壁設定 {

		print '主観禁止壁設定'
		print 'subjective_view_wall'


		@主観禁止壁 主観禁止壁君 8750,-17000,-28450 2048 d:SD_SLIDE_INSIDE		//stdproc.h

		trap dr200 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_SUBJECT \
			-exec {
				if($3==入る){
					mesg 透明壁 主観禁止壁君 on
				}else{
					mesg 透明壁 主観禁止壁君 off
				}
			}


		@主観禁止壁 主観禁止壁君 -7250 -17000 -28450 2048 d:SD_SLIDE_INSIDE		//stdproc.h

		trap dr201 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_SUBJECT \
			-exec {
				if($3==入る){
					mesg 透明壁 主観禁止壁君 on
				}else{
					mesg 透明壁 主観禁止壁君 off
				}
			}


		@主観禁止壁 主観禁止壁君 11750 -9000 -28450 2048 d:SD_SLIDE_INSIDE		//stdproc.h

		trap dr202 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_SUBJECT \
			-exec {
				if($3==入る){
					mesg 透明壁 主観禁止壁君 on
				}else{
					mesg 透明壁 主観禁止壁君 off
				}
			}


		@主観禁止壁 主観禁止壁君 -10250 -9000 -28450 2048 d:SD_SLIDE_INSIDE		//stdproc.h

		trap dr203 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_SUBJECT \
			-exec {
				if($3==入る){
					mesg 透明壁 主観禁止壁君 on
				}else{
					mesg 透明壁 主観禁止壁君 off
				}
			}



