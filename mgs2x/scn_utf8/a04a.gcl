//###################################################################################
//									マップ接続
//###################################################################################


	proc ロードプロック {
		command セットサウンドコード -c d:SNG_FOUTS_S		//ＢＧＭフェードアウト

		if ($s:呼び出しプロック == mv_a04a_a04b_0) {
			@mv_a04a_a04b_0
		} else if ($s:呼び出しプロック == mv_a04a_a04b_1) {
			@mv_a04a_a04b_1
		} else if ($s:呼び出しプロック == mv_a04a_a04b_2) {
			@mv_a04a_a04b_2
		} else if ($s:呼び出しプロック == mv_a04a_a04b_3) {
			@mv_a04a_a04b_3
		}

	}


	proc マップ接続{
		print 'マップ接続'

//１Ｆ北東

		trap ld100 d:PLAYER -mask 入る\
			-exec{
				if(`%ゲームオーバーチェック` == 0 && $f:ロードチェックＯＮフラグ){
					eval( $b:プレイヤー初期状態 = 0 )

#ifdef d:CTDOWN_TIMER
					@ロード時船倉タイマー残時間ゲット
#endif

					@ロード時ストリームフェードアウト	//w04.hのなか

					preseek 'w04b'
					@ステージ終了時処理（ステージ名表示） 8000 -17000 -31000 2048 mv_a04a_a04b_0 d:DEFAULT_M_TYPE d:wn_第二船倉

				}
			}

//１Ｆ南西

		trap ld101 d:PLAYER -mask 入る\
			-exec{
				if(`%ゲームオーバーチェック` == 0 && $f:ロードチェックＯＮフラグ){
					eval( $b:プレイヤー初期状態 = 0 )

#ifdef d:CTDOWN_TIMER
					@ロード時船倉タイマー残時間ゲット
#endif
					@ロード時ストリームフェードアウト	//w04.hのなか

					preseek 'w04b'
					@ステージ終了時処理（ステージ名表示） -8000 -17000 -31000 2048 mv_a04a_a04b_1 d:DEFAULT_M_TYPE d:wn_第二船倉

				}
			}

//２Ｆ南東

		trap ld102 d:PLAYER -mask 入る\
			-exec{
				if(`%ゲームオーバーチェック` == 0 && $f:ロードチェックＯＮフラグ){
					eval( $b:プレイヤー初期状態 = 0 )

#ifdef d:CTDOWN_TIMER
					@ロード時船倉タイマー残時間ゲット
#endif
					@ロード時ストリームフェードアウト	//w04.hのなか

					preseek 'w04b'
					@ステージ終了時処理（ステージ名表示） 11000 -9000 -31000 2048 mv_a04a_a04b_2 d:DEFAULT_M_TYPE d:wn_第二船倉

				}
			}

//２Ｆ南西

		trap ld103 d:PLAYER -mask 入る\
			-exec{
				if(`%ゲームオーバーチェック` == 0 && $f:ロードチェックＯＮフラグ){
					eval( $b:プレイヤー初期状態 = 0 )

#ifdef d:CTDOWN_TIMER
					@ロード時船倉タイマー残時間ゲット
#endif
					@ロード時ストリームフェードアウト	//w04.hのなか

					preseek 'w04b'
					@ステージ終了時処理（ステージ名表示） -11000 -9000 -31000 2048 mv_a04a_a04b_3 d:DEFAULT_M_TYPE d:wn_第二船倉

				}
			}


	}



//###################################################################################
//									ロード時進入設定
//###################################################################################

	proc 第１船倉ロード進入時処理 {

		if( $f:a01a_船倉イベントセット == 1 ) {
			if(! $f:w04演説は開始されました){
				@船倉スコット演説スタート
			}else{
					@演説実行
			}

			@演説ストリーム再生チェック
		}


		if( $s:登場ポイント == 演説デモ後スタート ){

			/*
			chara フェードインアウト フェードアウト \
				-c 0,0,0 128 \
				-t 1

			command パッド操作 \
				-release

			chara delay ディレイ -time 1 -exec{
				if($f:w04演説は開始されました){
					command パッド操作 \
						-cancel
					@ロード時フェードイン
					return 0
				}else{
					return 1
				}
			}
			*/
			@ステージ開始時処理（ステージ名表示）\
				 		d:LOAD_TYPE:NO_DOOR_TYPE \
				 		ドア無し \
				 		1500 \
				 		d:DEFAULT_M_TYPE \
				 		d:wn_第一船倉


			chara カメラ設定 ロードカメラ \
					-c 1 \
					-p 9250,-1526,-161 -t 9250,-4088,-433 \
					-r 955,2048,0 -f 2577 \
					-a 200 \
					-i 0 3 0 0 \
					-s 1

			chara プロック連続実行 ロードカメラＯＦＦ連続実行 -time -1 -exec {
				if( $f:ロードチェックＯＮフラグ == 1 ) {
					mesg プロック連続実行 ロードカメラＯＦＦ連続実行 kill
					@カメラＯＦＦ ロードカメラ
				}
			}


		}else if( $s:登場ポイント == 東１Ｆ ){
			@ステージ開始時処理（ステージ名表示）\
				 d:LOAD_TYPE:SL_DOOR_TYPE \
				 	右舷ドア１１奥 \
				 	2000 \
				 	d:DEFAULT_M_TYPE \
				 	d:wn_第一船倉

		}else if( $s:登場ポイント == 西１Ｆ ){
			@ステージ開始時処理（ステージ名表示）\
				d:LOAD_TYPE:SL_DOOR_TYPE \
				左舷ドア１１奥 \
				2000 \
				d:DEFAULT_M_TYPE \
				d:wn_第一船倉

		}else if( $s:登場ポイント == 東２Ｆ ){
			@ステージ開始時処理（ステージ名表示） \
				d:LOAD_TYPE:SL_DOOR_TYPE \
				右舷上部ドア１１奥 \
				2000 \
				d:DEFAULT_M_TYPE \
				d:wn_第一船倉

		}else if( $s:登場ポイント == 西２Ｆ ){
			@ステージ開始時処理（ステージ名表示） \
				d:LOAD_TYPE:SL_DOOR_TYPE \
				左舷上部ドア１１奥 \
				2000 \
				d:DEFAULT_M_TYPE \
				d:wn_第一船倉

		}else if( $s:登場ポイント == 水密ドア ){
			@ステージ開始時処理（ステージ名表示） \
				 d:LOAD_TYPE:WT_DOOR_TYPE 長廊下ドア 2000 d:M_TYPE:RUN_CHANGE \
				 d:wn_第一船倉
		} else {
			#if d:ASSERT
				command assert ( d:FALSE ) 'unexpected load point  (scenario err)'
			#else
				@ロード時フェードイン
			#endif
		}


	}


/****************************************************************************************/
// デバッグ関連
/****************************************************************************************/

	proc デバッグ設定 {

		//chara スクリーンショット scrshot
#ifndef d:FIX_MODE
		chara USBキーボード実行 keyboard \
			-e d:KPD_1 {
							mesg プレイヤー d:PLAYER position 2711 -15559 -3050
			} \
			-e d:KPD_2 {
							mesg プレイヤー d:PLAYER position 9250 -3500 -500
			} \
			-e d:KPD_3 {
							mesg プレイヤー d:PLAYER position -10737 -7953 -1592
			} \
			-e d:KPD_4 {
							mesg プレイヤー d:PLAYER position -10871 -7418 -22364
			} \
			-e d:KPD_5 {
							mesg プレイヤー d:PLAYER position 10871 -7418 -22364
			} \
			-e d:KBD_0	{ restart }

#endif
	}
/*
-p -10871,-5075,-18199 -t -10871,-7418,-22364 \
-r 334,2048,0 -f 4778 \
-a 200 \
-p 10898,-6989,-20288 -t 10993,-7865,-24161 \
-r 145,2032,0 -f 3972 \
-a 200 \
*/
