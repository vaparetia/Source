	}

	proc コマンダー設定 {
#if d:DEBUG_PRINT
	print '*** Enemy Set'
#endif
		if ($f:w45a_天狗兵登場フラグ == d:TRUE) {
			// コマンダー
			chara コマンダー 敵兵セット \
				-a 天狗兵コマンダー \
				-r -11750,8000,-152000 アーセナルギア小部屋Ｂ 11750,8000,-146500 アーセナルギア小部屋Ｂ \
				-c -11750,8000,-152000 アーセナルギア小部屋Ｂ 11750,8000,-146500 アーセナルギア小部屋Ｂ \
				-v [ene_plant_voice:01] \
				-b $i:w45a_天狗兵復活人数 \	// $i:危険モードでの復活人数 
				-k $i:w45a_天狗兵復活人数 \
				-s (d:ENE_STAGE_NPC_SNAKE | d:ENE_STAGE_NO_STRM | d:ENE_STAGE_ALERT2SNEAK | d:ENE_STAGE_NO_WC_GOVER) \
				-m $w:スタートアラートモード \
				-h $i:標準警戒時間		// 警戒時間
		}
	}

//###################################################################################
//									 ドア＆マップ切り替え
//###################################################################################

	proc A_ドア設置 {
		#if d:DEBUG_PRINT
			print 'slide_door_set'
		#endif
/*
		@ドアモデル名セット $:配列番号 \
			$:ドア名１				$:ドア名２				$:ドア名３ \
			$:ドア名４				$:ドア名５
			d:DOOR_FLAG_CLOSE 		d:DOOR_FLAG_OPEN		d:DOOR_FLAG_ENEMY_ONLY
			d:DOOR_FLAG_CLOSE_LEVEL	d:DOOR_FLAG_OPEN_LEVEL

		@A_ドア開閉追加設定 $:ドア名 $:フラグ $:ドア位置Ｘ $:ドア位置Ｙ $:ドア位置Ｚ $:ドア回転 $:ドアスライド幅
*/
		//	南側ドア
		//	アーセナルドアは両開きのためフラグ１つでモデル２つを管理する
		@ドアモデル名セット 0 d:DOOR_NAME_LOAD1A d:DOOR_NAME_LOAD1A d:DOOR_NAME_LOAD1A d:DOOR_NAME_LOAD1A d:DOOR_NAME_LOAD1A
		switch ( $$b:ドアフラグ[0] ) {
			case ( d:DOOR_FLAG_CLOSE ) {
				$$s:ドアモデル名[1] = d:DOOR_NAME_LOAD1B;
			}
			case ( d:DOOR_FLAG_OPEN ) {
				$$s:ドアモデル名[1] = d:DOOR_NAME_LOAD1B;
			}
			case ( d:DOOR_FLAG_ENEMY_ONLY ) {
				$$s:ドアモデル名[1] = d:DOOR_NAME_LOAD1B;
			}
			case ( d:DOOR_FLAG_CLOSE_LEVEL ) {
				$$s:ドアモデル名[1] = d:DOOR_NAME_LOAD1B;
			}
			case ( d:DOOR_FLAG_OPEN_LEVEL ) {
				$$s:ドアモデル名[1] = d:DOOR_NAME_LOAD1B;
			}
		}

		@A_ドア開閉追加設定 南側ドア $$b:ドアフラグ[0] 1250 0 -133125 0 d:SD_SLIDE_INSIDE


		//	南側ドア
		chara ドア 南側ドア \
			-m $$s:ドアモデル名[0] \
			-d 0,0,0 \
			-p 1250,0, -133125 \
			-slide d:SD_SLIDE_ARSENAL_LEFT \
			-time (d:SD_OPEN_TIME + 10)\
			-between アーセナルギア小部屋Ｂ アーセナルギア小部屋Ｂ \
			-w_door $$s:ドアモデル名[1] d:SD_SLIDE_ARSENAL_RIGHT \
			-h 1500 \
			-exec {
				if ( !($:開閉フラグ) ) {
					mesg プットオブジェ ロードエリア off
				} else {
					mesg プットオブジェ ロードエリア on
				}
			}
		//	主観禁止壁設定
		@主観禁止壁 南側ドア壁 1250 0 -133125 0 d:SD_SLIDE_INSIDE

		trap dr001 ？ \
			-mask ？ \	
			-exec {
				if ($3 == 入る) {
					mesg ドア 南側ドア open $2
				} else {
					mesg ドア 南側ドア close $2
				}
			}

		trap dr001 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_SUBJECT \
			-exec {
				if ($3 == 入る) {
					mesg 透明壁 南側ドア壁 on
				} else {
					mesg 透明壁 南側ドア壁 off
				}
			}
	}

//###################################################################################
//									開始時処理
//###################################################################################

	proc アーセナルギア小部屋Ｂ開始時処理 {
		if ($s:登場ポイント == 天狗通路Ｂから) {
			@ステージ開始時処理（ステージ名表示）\
			d:LOAD_TYPE:SL_DOOR_TYPE 南側ドア 2000 d:DEFAULT_M_TYPE \
			d:wn_アーセナルギアＳ状結腸
//			@ロード時カメラ設定
			//	ＢＧＭを鳴らす
			command セットサウンドコード -c d:SNG_PLAY_06
		}
}



//###################################################################################
//									ロード設定
//###################################################################################

	proc ロードプロック {
		#if d:DEBUG_PRINT 
			print 'load_proc'
		#endif
		if ($s:呼び出しプロック == mv_a45a_a44a_0) {
			// 通路Ｂへ
			@mv_a45a_a44a_0
		}
	}
	
	proc アーセナルギア小部屋Ｂロード設定 {
		trap ld001 d:PLAYER \
			-mask 入る \
			-exec {
				if($f:ロードチェックＯＮフラグ == 1) {
					//	先読み
					preseek 'a44a'
					@ステージ終了時処理（ステージ名表示） 2000 0 -132000 0 mv_a45a_a44a_0 \
					d:DEFAULT_M_TYPE d:wn_アーセナルギア回腸
				}
			}
	}

	proc ロード時カメラ設定 {
		chara カメラ設定 ロードカメラ \
			-c 1 \	
			-p 2051,5699,-133965 -t 2051,1228,-134461 \
			-r 952,2048,0 -f 4498 \
			-a 200 \
			-i 0 1 0 0 \
			-s 1

		chara プロック連続実行 カメラ戻し管理人 \
			-proc カメラ戻し管理
	}

	proc カメラ戻し管理 {
		command パッドチェック \
			-no_use
		if ($status != 1) {
			chara カメラ設定 ロードカメラ \
				-s -1
			mesg プロック連続実行 カメラ戻し管理人 kill
		}
	}

//###################################################################################
//									オブジェクト
//###################################################################################

	proc オブジェクト設定 {
		chara プットオブジェ 開きっぱ左ドア \
			-m d:DOOR_NAME_1A \
			-r 0,0,0 \
			-p -1225,0,-139625 -l d:LT2_NAME \
			-s 100,100,100
		chara プットオブジェ 開きっぱ右ドア \
			-m d:DOOR_NAME_1B \
			-r 0,0,0 \
			-p 750,0,-139625  -l d:LT2_NAME \
			-s 100,100,100

		chara プットオブジェ ロードエリア \
			-m d:KMS_NAME0 \
			-r 0,0,0 \
			-p 0,0,0 -l d:LT2_NAME \
			-s 100,100,100
		mesg プットオブジェ ロードエリア off
	}

//###################################################################################
//									 エフェクト
//###################################################################################

	proc エフェクト設定 {
		#if d:DEBUG_PRINT
			print 'effect_set'
		#endif

		#if d:BLUR
			chara ブラー ブラー
		#endif

		#if d:Z_MANAGER
			chara Ｚフォーカス管理 Z_manager
			mesg Ｚフォーカス管理 Z_manager パラメータ 5000 30
		#endif

		#if d:BODY_SHADOW
			chara ＯＦＦ制御 off_man
			mesg ＯＦＦ制御 off_man ボディシャドウＯＦＦ
		#endif
	}

	proc キャラ用ライト設定 {
		#if d:DEBUG_PRINT
			print 'chara_light_set'
		#endif

		chara 環境光 環境光源 \
			 -c 40 90 75

		chara 平行光 平行光源 \
			 -c 68 113 94 \
			 -p 1069 -2860 -3958
	}

	proc 息設定 {
		#if d:DEBUG_PRINT
		print 'PLAYER_BREARH'
		#endif
		chara 白息 プレイヤー息 \
			-name d:PLAYER \
			-object 12 \
			-shift 0,-30,130 \
			-interval 136
		mesg 白息 プレイヤー息 on
	}

	proc レンズフレア設定 {
		chara レンズフレア  レンズフレアくん天井 \
			-pos -4500,15000,-158000 \
			-size 1 \
			-alpha 16

		chara レンズフレア  レンズフレアくん地下 \
			-pos 0,0,-149250 \
			-size 1 \
			-alpha 12
	}

	proc 亀甲床設定 {
		chara 亀甲床 亀甲床ちゃん \
				-prims 128 \
				-alpha 10 \
				-vertex 10 \
				-user 32 \
				-region 0 -149250 7000
	}

//###################################################################################
//									カメラ
//###################################################################################

	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0 
		chara カメラ 小部屋カメラ		-c 0 -l 2 -p 40
		chara カメラ 通路カメラ		-c 0 -l 2 -p 30
		chara カメラ ロードカメラ		-c 0 -l 2 -p 20
		chara カメラ モーションカメラ		-c 0 -l 2 -p 10
		chara カメラ ゲームオーバーカメラ		-c 0 -l 0 -p 5

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \	
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 425,2048,0 \
			-f 7500 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}
	proc アーセナルギア小部屋Ｂカメラ設定 {
		#if d:DEBUG_PRINT
			print 'w45a_camera_set'
		#endif

		// 南側通路
		trap ca001 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ降順 $6 -133750 -139750 900 100
				eval( $i:補完ＲＸ = $i:CS_結果１ );

				chara カメラ設定 通路カメラ \
					-c 0 \
					-b  70,d:CAM_MIN,d:CAM_MIN 1935,d:CAM_MAX,-134124 \
					-l  70,d:CAM_MIN,d:CAM_MIN 1935,d:CAM_MAX,-134303 \
					-r $i:補完ＲＸ,2048,0 \
					-f 4500 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3
			}

		// 大部屋
		trap ca002 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ降順 $6 -140750 -150750 900 450
				eval( $i:補完ＲＸ = $i:CS_結果１ );

				chara カメラ設定 小部屋カメラ \
					-c 0 \	
					-b -4000,d:CAM_MIN,d:CAM_MIN 4000,10000,-140750 \
					-l -4000,d:CAM_MIN,d:CAM_MIN 4000,10000,-141000 \
					-r $i:補完ＲＸ,2048,0 \
					-f 9000 \
					-a 200 \
					-i 2 -1 0 0 \
					-s $3
			}
	}

//###################################################################################
//								武器設定
//###################################################################################

	proc 刀設定 {
		eval ( $w:武器最大数Ｒ[ d:武器:ブレード ] = 1 )
		eval ( $w:武器弾数Ｒ[ d:武器:ブレード ] = 1 )
		eval ( $w:武器最大数[ d:武器:ブレード ] = 1 )
		eval ( $w:武器弾数[ d:武器:ブレード ] = 1 )
	}














