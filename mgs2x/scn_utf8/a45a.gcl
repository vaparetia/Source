	// 敵兵設定
	proc 天狗兵０ {
#if d:DEBUG_PRINT
	print '*** Tengu 0'
#endif

	// 天狗兵Ｂ
		chara 天狗兵Ｂ 敵兵:01 \
			-r 8  \
			-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
			-l $w:w45a_天狗兵体力 -h $w:敵標準聴力 -f $w:w45a_天狗兵気絶 \
			-type 2

		chara 天狗兵Ｂ 敵兵:02 \
			-r 9  \
			-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
			-l $w:w45a_天狗兵体力 -h $w:敵標準聴力 -f $w:w45a_天狗兵気絶 \
			-type 3

		chara 天狗兵Ｂ 敵兵:04 \
			-r 11 \
			-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
			-l $w:w45a_天狗兵体力 -h $w:敵標準聴力 -f $w:w45a_天狗兵気絶 \
			-type 3

		chara 天狗兵Ｂ 敵兵:05 \
			-r 1  \
			-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
			-l $w:w45a_天狗兵体力 -h $w:敵標準聴力 -f $w:w45a_天狗兵気絶 \
			-type 2

		chara 天狗兵Ｂ 敵兵:07 \
			-r 1  \
			-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
			-l $w:w45a_天狗兵体力 -h $w:敵標準聴力 -f $w:w45a_天狗兵気絶 \
			-type 2

		chara 天狗兵Ｂ 敵兵:08 \
			-r 0  \
			-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
			-l $w:w45a_天狗兵体力 -h $w:敵標準聴力 -f $w:w45a_天狗兵気絶 \
			-type 3
	}

