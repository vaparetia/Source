@アーセナルギア小部屋Ｂ開始時処理



//###################################################################################
//									各proc設定
//###################################################################################


//###################################################################################
//									全マップ共通
//###################################################################################

	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT 
			print 'localvar_init'
		#endif

//		eval( $i:w45a_天狗兵刀ガード回数 = 20 )
		eval( $i:w45a_天狗兵刀ガード回数 = 10 )
		eval ($f:w45a_偽ゲームオーバーフラグ = d:FALSE)

		//	デモ後特殊装備外す
		@デモ後武器アイテム制御 d:デモ後前を継続 d:デモ後特殊装備なし

		//	武器をソーコムかＭ９に変える
		if($f:w45a_天狗兵登場フラグ == d:TRUE ) {
			//	Ｍ９だったら
			if ($w:武器 == d:武器:Ｍ９) {
				eval ($w:武器 = d:武器:Ｍ９)
				eval ( $w:プレイヤーフラグ = $w:プレイヤーフラグ & ~d:PL_START_STATE_BLADE_OUT )
			//	Ｍ９以外だったら
			} else {
				//	武器をソーコムに変える
				if ($w:武器 != d:武器:ソコム) {
					eval ($w:武器 = d:武器:ソコム)
					eval ( $w:プレイヤーフラグ = $w:プレイヤーフラグ & ~d:PL_START_STATE_BLADE_OUT )
				}
			}
		}

	}

	proc 設定値変更 {
		#if d:DEBUG_PRINT 
			print 'status_set'
		#endif

	//	刀ダメージ値	体のどの部位に当たっても１５００減る
	//	刀の一降りで理論上最高３回当たるので（間合いがシビア）、計１５００＊３＝４５００となる

	//	刀気絶値		体のどの部位に当たっても６減る

		if ($w:ゲーム設定 == d:LEVEL_VERYEASY) {

			eval ($i:w45a_スネークレベル = 7)
			eval ($i:w45a_スネークソコム数 = -1)
			eval ($i:w45a_スネークＭ４数 = -1)
			eval ($i:w45a_スネークレーション数 = -1)
			eval ($i:w45a_スネークライフ = 600)

			eval ($i:w45a_天狗兵復活人数 = 42)
			eval ($w:w45a_天狗兵体力 = 1500)		//	最低１振りで死ぬ
			eval ($w:w45a_天狗兵気絶 = 3)			//	１振りで気絶

		} else if ($w:ゲーム設定 == d:LEVEL_EASY) {

			eval ($i:w45a_スネークレベル = 5)
			eval ($i:w45a_スネークソコム数 = 10)
			eval ($i:w45a_スネークＭ４数 = 10)
			eval ($i:w45a_スネークレーション数 = -1)
			eval ($i:w45a_スネークライフ = 600)

			eval ($i:w45a_天狗兵復活人数 = 42)
			eval ($w:w45a_天狗兵体力 = 1500)		//	最低１振りで死ぬ
			eval ($w:w45a_天狗兵気絶 = 7)			//	２振りで気絶

		} else if ($w:ゲーム設定 == d:LEVEL_NORMAL) {

			eval ($i:w45a_スネークレベル = 3)
			eval ($i:w45a_スネークソコム数 = 5)
			eval ($i:w45a_スネークＭ４数 = 5)
			eval ($i:w45a_スネークレーション数 = 5)
			eval ($i:w45a_スネークライフ = 600)

			eval ($i:w45a_天狗兵復活人数 = 58)
			eval ($w:w45a_天狗兵体力 = 3000)		//	最低２振り（最高１振り）で死ぬ
			eval ($w:w45a_天狗兵気絶 = 9)			//	２振りで気絶

		} else if ($w:ゲーム設定 == d:LEVEL_HARD) {

			eval ($i:w45a_スネークレベル = 3)
			eval ($i:w45a_スネークソコム数 = 3)
			eval ($i:w45a_スネークＭ４数 = 3)
			eval ($i:w45a_スネークレーション数 = 3)
			eval ($i:w45a_スネークライフ = 500)

			eval ($i:w45a_天狗兵復活人数 = 90)
			eval ($w:w45a_天狗兵体力 = 3000)		//	最低２振り（最高１振り）で死ぬ
			eval ($w:w45a_天狗兵気絶 = 13)			//	３振りで気絶

		} else if ($w:ゲーム設定 >= d:LEVEL_EXTREME) {

			eval ($i:w45a_スネークレベル = 3)
			eval ($i:w45a_スネークソコム数 = 0)
			eval ($i:w45a_スネークＭ４数 = 0)
			//	エクストリームの場合
			if ($w:ゲーム設定 == d:LEVEL_EXTREME) {
				//	ステージ開始時のレーション数に依存(最大２個まで)
				if ($f:w45a_天狗兵登場フラグ == d:FALSE) {
					if ($w:アイテム数Ｒ[ d:アイテム:レーション ] >= 2) {
						eval ($i:w45a_スネークレーション数 = 0)
					} else if ($w:アイテム数Ｒ[ d:アイテム:レーション ] == 1) {
						eval ($i:w45a_スネークレーション数 = 1)
					} else if ($w:アイテム数Ｒ[ d:アイテム:レーション ] == 0) {
						eval ($i:w45a_スネークレーション数 = 2)
					}
				}
			//	ヨーロピアンエクストリームの場合
			} else {
				//	レーションは出さない
				eval ($i:w45a_スネークレーション数 = 0)
			}
			eval ($i:w45a_スネークライフ = 500)

			eval ($i:w45a_天狗兵復活人数 = 122)
			eval ($w:w45a_天狗兵体力 = 4500)		//	最低３振り（最高１振り）で死ぬ
			eval ($w:w45a_天狗兵気絶 = 17)			//	３振りで気絶

		}
	}

	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif

//		command プラグインはしご
//		command プラグインブレード -m rai_blade
