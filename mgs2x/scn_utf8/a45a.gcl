@アナザー用マップ定義前設定

// マップ設定
// ------------------------------------
chara マップ アーセナルギア小部屋Ｂ	-k d:KMS_NAME \
									-h d:HZX_NAME,0 \
									-l d:LT2_NAME


command マップ設定 アーセナルギア小部屋Ｂ -set {
	// サウンド、キャラクターのセット
	@常駐キャラ設定
	@ローカル変数初期化
	@設定値変更
	@プラグイン設定
	@A_プレイヤー設定 sna_a45a rai_a45a
	@亀甲床設定
}

// アナザー用でマップ設定後に設定する
