//###################################################################################
//									ロード入場
//###################################################################################

	proc 左舷長廊下進入時処理 {

		if( $s:登場ポイント == 左舷最後尾 ){

			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p -16180,-1167,-32647 \
				-t -16579,-2877,-32955 \
				-a 200 \
				-i 0 3 0 0 \
				-s 1

			@ステージ開始時処理（ステージ名表示）\
				 d:LOAD_TYPE:WT_DOOR_TYPE 水密君 2000 d:M_TYPE:RUN_CHANGE \
				 d:wn_第二甲板左舷

			if(!$f:w03a_船内放送聞いた){
				eval($f:w03a_船内放送聞いた = 1)
				%Stream t:vc060201 -menustop -c 1
				//船内放送「本船は現在、ベラザノ橋を通過……予定通り、１０分後、船倉にて海兵隊司令官が訓辞を行う……各員、それまで持ち場にて待機せよ……」
			}

		}else if( $s:登場ポイント == 中央長廊下 ){

			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p 10056,-717,-126199 \
				-t 10657,-4045,-127533 \
				-a 200 \
				-i 0 2 0 0 \
				-s 1

			@ステージ開始時処理（ステージ名表示）\
				 d:LOAD_TYPE:WT_DOOR_TYPE 水密君_右舷 2000 d:M_TYPE:RUN_CHANGE \
				 d:wn_第二甲板左舷

		}


	}






//###################################################################################
//									ロード退場
//###################################################################################

	// 入出トラップ
	// ------------------------------------
// $w:w03a_死体数
	proc ロードプロック {
		command セットサウンドコード -c d:SNG_FOUTS_S		//ＢＧＭフェードアウト

		if ($s:呼び出しプロック == mv_w03a_w02a_0) {
			@mv_w03a_w02a_0
		} else if ($s:呼び出しプロック == mv_w03a_w03b_0) {
			@mv_w03a_w03b_0
		}
	}
	proc エンジンルームへロード $:トリガ $:実行キャラ {
		#if d:LOAD_TRAP
			if ($:トリガ == 0) {		// 開いたとき
				#if d:STAGE_CAMERA
					chara カメラ設定 ロードカメラ \
						-c 1 \
						-p -16180,-1167,-32647 \
						-t -16579,-2877,-32955 \
						-a 200 \
						-i 0 3 0 0 \
						-s 1
				#endif

				preseek 'w02a'
				@ステージ終了時処理（ステージ名表示） -16750 -5000 -30750 0 mv_w03a_w02a_0 d:M_TYPE:RUN_CHANGE d:wn_機関室左舷

//				@ロード時フェードアウト -16750 -5000 -30750 0 mv_w03a_w02a_0
			}
		#endif
	}

#if d:MORPHING
	proc 右舷へロード $:トリガ $:実行キャラ {
/*		if ($:トリガ == 3) {		// 開き始め
			mesg プットオブジェ 旧w03c on
			mesg プットオブジェ 旧w03cr on
		}
*/
	}
#else
	proc 右舷へロード $:トリガ $:実行キャラ {
		#if d:LOAD_TRAP
/*			if ($:トリガ == 3) {		// 開き始め　これを上手くやるには、旧w03cモデルにもう少し手を加える必要ある。
				mesg プットオブジェ 旧w03c on
				mesg プットオブジェ 旧w03cr on
			} else if ($:トリガ == 0) {		// 開いたとき
*/
			if ($:トリガ == 0) {		// 開いたとき
				#if d:STAGE_CAMERA
					chara カメラ設定 ロードカメラ \
						-c 1 \
						-p 10447,-1676,-125625 \
						-t 11556,-4509,-127942 \
						-a 200 \
						-i 2 -1 0 0 \
						-s 1
				#endif


				preseek 'w03b'
				@ステージ終了時処理（ステージ名表示） 13000 -5000 -127000 1024 mv_w03a_w03b_0 d:M_TYPE:RUN_CHANGE d:wn_第二甲板右舷
				eval( $w:スタートアラートモード = d:ALERT_MODE_SENNYU );

			}
		#endif
	}
#endif
















//###################################################################################
//								エフェクト設定
//###################################################################################

	// エフェクト関係
	// -----------------------------------
	proc エフェクト設定 {
		#if d:BLUR
			chara ブラー ブラー -i 10
		#endif

		#if d:BODY_SHADOW
			chara ＯＦＦ制御 off_man
			mesg ＯＦＦ制御 off_man ボディシャドウＯＦＦ
		#endif

		#if d:KIRISAME
			chara 霧雨 霧雨
		#endif



		chara シネマスクリーン シネマ \
			-top d:CINEMA_BELT_UPPER \
			-bottom d:CINEMA_BELT_LOWER \
			-ftime 30



	}

	// ステージカメラ設定
	// ------------------------------------
	proc カメラセット {
		#if d:STAGE_CAMERA
			chara カメラ ステージカメラ	-c 0 -l 3 -p 0
			chara カメラ 長廊下カメラ	-c 0 -l 2 -p 60
			chara カメラ 長廊下カメラ２	-c 0 -l 2 -p 50
			chara カメラ 長廊下小部屋カメラ	-c 0 -l 2 -p 40
			chara カメラ カットインカメラ	-c 0 -l 1 -p 30
			chara カメラ モーションカメラ	-c 0 -l 2 -p 20
			chara カメラ ロードカメラ	-c 0 -l 2 -p 0

			// デフォルトカメラ
			chara カメラ設定 ステージカメラ \
				-c 0 \
				-b -17500,-32000,-132000 -17000,-2750,32000 \
				-l -32000,-32000,-132000 32000,32000,32000 \
				-r 180,2048,0 \
				-f 3000 \
				-a 170 \
				-i 0 0 0 0 \
				-s 1
		#endif
	}

	// フォグ
	// ------------------------------------
	proc フォグ設定 {
		#if d:FOG
#if 0
			chara フォグ 霧\
				-c 0, 15, 15 \
				-n -3000 \
				-f 10000 -z
#else
			chara フォグ 霧\
				-c 0, 15, 15 \
				-n -3000 \
//				-f 25000 -z
				-f 40000 -z
#endif
		#endif
	}


	// キャラ用光源(マップの設置が終わってから設定することで、キャラだけに光を当てる)
	// ------------------------------------
	proc キャラ用ライト設置 {
		#if d:CHARA_LIGHT
			chara 環境光 環境光源 \
				 -c 29 30 34

			chara 平行光 平行光源 \
				 -c 55 38 4 \
				 -d 512 2560 0
		#endif
	}

	// 天井
	// ------------------------------------
	proc 長廊下天井設置 $:モデル名 $:天井Ｚ座標{
		#if d:CHARA_CEIL
			chara 天井君 左舷天井 -m $:モデル名 -h -1500 -p 0,0,$:天井Ｚ座標 -l d:LT2_NAME
		#endif
	}

	// スポットライト
	// ------------------------------------
	proc 長廊下スポットライト設定 $:モデル名 $:スポットライトＺ座標 {
		#if d:SPOT_LIGHT
			chara スポットライト投影モデル 投影モデル \
				-m $:モデル名 \
				-p 0,0,$:スポットライトＺ座標
		#endif
	}










//###################################################################################
//								長廊下壊れライト設定
//###################################################################################




	proc 長廊下壊れライト総合設定 {
		print '長廊下壊れライト総合設定'



#if 1

//タイプ０：消えっぱなしでときどき点く
//タイプ１：つきっぱなしでときどき消える
//タイプ２：よくついたり消えたり
//タイプ３：つきっぱなし
//タイプ４：きえっぱなし

		command foreach -argc 5 -repeat 12 \
			-data { \

				{長廊下壊れライト１＿１,(250-39500),			2,$f:左舷長廊下ライト壊れフラグ１＿１,0} \
				{長廊下壊れライト１＿２,(-4250-39500),			1,$f:左舷長廊下ライト壊れフラグ１＿２,0} \
				{長廊下壊れライト１＿３,(-11750-39500),			1,$f:左舷長廊下ライト壊れフラグ１＿３,0} \
				{長廊下壊れライト１＿４,(-20750-39500),			0,$f:左舷長廊下ライト壊れフラグ１＿４,羽虫１＿４} \

				{長廊下壊れライト２＿１,(250+(-28500-39500)),	3,$f:左舷長廊下ライト壊れフラグ２＿１,羽虫２＿１} \
				{長廊下壊れライト２＿２,(-4250+(-28500-39500)),	1,$f:左舷長廊下ライト壊れフラグ２＿２,0} \
				{長廊下壊れライト２＿３,(-11750+(-28500-39500)),0,$f:左舷長廊下ライト壊れフラグ２＿３,羽虫２＿３} \
				{長廊下壊れライト２＿４,(-20750+(-28500-39500)),1,$f:左舷長廊下ライト壊れフラグ２＿４,0} \
				{長廊下壊れライト２＿５,(250+(-57000-39500)),	0,$f:左舷長廊下ライト壊れフラグ２＿５,0} \

				{長廊下壊れライト３＿１,(-4250+(-57000-39500)),	3,$f:左舷長廊下ライト壊れフラグ３＿１,羽虫３＿１} \
				{長廊下壊れライト３＿２,(-11750+(-57000-39500)),4,$f:左舷長廊下ライト壊れフラグ３＿２,0} \
				{長廊下壊れライト３＿３,(-20750+(-57000-39500)),2,$f:左舷長廊下ライト壊れフラグ３＿３,0} \

			} \
			-exec { \
				chara プットスポットライトオブジェ $1 \
					-m w03_lit0a w03_lit0b w03_lit0c \
					-t -16260,-2150,$2 100 3000 \
					-l d:LT2_NAME \
					-p -16260,0,$2 \
					-b 長廊下ライト壊れ処理 \
					-f d:BRK_LGT_PUTW03A

				if($4 == 1){
					mesg プットスポットライトオブジェ $1 ライト消す

				}else if( $3 == 1 || $3 == 4){
					mesg プットスポットライトオブジェ $1 ライト消灯

				}else{
					@長廊下壊れライトＯＮ／ＯＦＦ操作 $1 $2 $3

				}


				if($5 != 0 && $4 == 0){
					chara 電灯虫 $5 \
						-n	4 \
						-p	-16260,-2150,$2 \	// ライト位置 ->> プレイヤー誘導時は無視
						-b	1 \	// 下のバウンディングボックスで壁との当たり見るか  1 : 判定あり, 0 : 判定なし
						-s	(-16260-500),(-2150-1000),($2-500) \	// 最小ボックス座標
						-l	(-16260+200),(-2150+200),($2+500)	// 最大ボックス座標
				}

			}



#else
		@長廊下壊れライト設定 -16260 -39500

		@長廊下壊れライト設定 -16260 (-28500-39500)

		@長廊下壊れライト設定 -16260 (-57000-39500)
#endif

	}


	proc 長廊下ライト壊れ処理 {

		command foreach -argc 3 -repeat 12 \
			-data { \
				{$1,長廊下壊れライト１＿１,羽虫１＿１}
				{$1,長廊下壊れライト１＿２,羽虫１＿２}
				{$1,長廊下壊れライト１＿３,羽虫１＿３}
				{$1,長廊下壊れライト１＿４,羽虫１＿４}

				{$1,長廊下壊れライト２＿１,羽虫２＿１}
				{$1,長廊下壊れライト２＿２,羽虫２＿２}
				{$1,長廊下壊れライト２＿３,羽虫２＿３}
				{$1,長廊下壊れライト２＿４,羽虫２＿４}
				{$1,長廊下壊れライト２＿５,羽虫２＿５}

				{$1,長廊下壊れライト３＿１,羽虫３＿１}
				{$1,長廊下壊れライト３＿２,羽虫３＿２}
				{$1,長廊下壊れライト３＿３,羽虫３＿３}
			} \
			-exec { \
				if($1 == $2){
					print 'ぶっ壊されてもた'
					@長廊下壊れフラグ処理 $1
					mesg 電灯虫 $3 キル
				}
			}


	}




	proc 長廊下壊れフラグ処理 $:壊れライト名 {

		if($1 == 長廊下壊れライト１＿１){
			eval($f:左舷長廊下ライト壊れフラグ１＿１ = 1)
		}else if($1 == 長廊下壊れライト１＿２){
			eval($f:左舷長廊下ライト壊れフラグ１＿２ = 1)
		}else if($1 == 長廊下壊れライト１＿３){
			eval($f:左舷長廊下ライト壊れフラグ１＿３ = 1)
		}else if($1 == 長廊下壊れライト１＿４){
			eval($f:左舷長廊下ライト壊れフラグ１＿４ = 1)
		}else if($1 == 長廊下壊れライト２＿１){
			eval($f:左舷長廊下ライト壊れフラグ２＿１ = 1)
		}else if($1 == 長廊下壊れライト２＿２){
			eval($f:左舷長廊下ライト壊れフラグ２＿２ = 1)
		}else if($1 == 長廊下壊れライト２＿３){
			eval($f:左舷長廊下ライト壊れフラグ２＿３ = 1)
		}else if($1 == 長廊下壊れライト２＿４){
			eval($f:左舷長廊下ライト壊れフラグ２＿４ = 1)
		}else if($1 == 長廊下壊れライト２＿５){
			eval($f:左舷長廊下ライト壊れフラグ２＿５ = 1)
		}else if($1 == 長廊下壊れライト３＿１){
			eval($f:左舷長廊下ライト壊れフラグ３＿１ = 1)
		}else if($1 == 長廊下壊れライト３＿２){
			eval($f:左舷長廊下ライト壊れフラグ３＿２ = 1)
		}else if($1 == 長廊下壊れライト３＿３){
			eval($f:左舷長廊下ライト壊れフラグ３＿３ = 1)
		}
	}





	#include "w03_common.h"





	// 壊れライト
	// ------------------------------------
	proc 長廊下壊れライト設定 $:ライトＸ座標 $:ライトＺ座標 $:ライト名１ $:ライト名２ $:ライト名３ $:ライト名４ {
		#if d:B_LIGHT
			chara プットスポットライトオブジェ $3 \
				-m w03_lit0a w03_lit0b \
				-t $:ライトＸ座標,-2150,(250+$:ライトＺ座標) 100 4000 \
				-l d:LT2_NAME \
				-p $:ライトＸ座標,0,(250+$:ライトＺ座標) \
				-f 0x00000004

			chara プットスポットライトオブジェ $4 \
				-m w03_lit0a w03_lit0b \
				-t $:ライトＸ座標,-2150,(-4250+$:ライトＺ座標) 100 4000 \
				-l d:LT2_NAME \
				-p $:ライトＸ座標,0,(-4250+$:ライトＺ座標) \
				-f 0x00000004

			chara プットスポットライトオブジェ $5 \
				-m w03_lit0a w03_lit0b \
				-t $:ライトＸ座標,-2150,(-11750+$:ライトＺ座標) 100 4000 \
				-l d:LT2_NAME \
				-p $:ライトＸ座標,0,(-11750+$:ライトＺ座標) \
				-f 0x00000004

			chara プットスポットライトオブジェ $6 \
				-m w03_lit0a w03_lit0b \
				-t $:ライトＸ座標,-2150,(-20750+$:ライトＺ座標) 100 4000 \
				-l d:LT2_NAME \
				-p $:ライトＸ座標,0,(-20750+$:ライトＺ座標) \
				-f 0x00000004

		#endif
	}



	proc 長廊下小部屋壊れライト設定 {
		#if d:B_LIGHT

#if 1
		command foreach -argc 4 -repeat 3 \
			-data { \

				{長廊下壊れライト１０＿１,(-2000-39500),			$f:左舷長廊下ライト壊れフラグ１０＿１,羽虫１０＿１} \
				{長廊下壊れライト１０＿２,(-2000-28500-39500),		$f:左舷長廊下ライト壊れフラグ１０＿２,羽虫１０＿２} \
				{長廊下壊れライト１０＿３,(-2000-57000-39500),		$f:左舷長廊下ライト壊れフラグ１０＿３,羽虫１０＿３} \

			} \
			-exec { \

				chara プットスポットライトオブジェ $1 \
					-m w03_lit1a w03_lit1b \
					-t -11565,-2150,$2 100 4000 \
					-l d:LT2_NAME \
					-p -11565,0,$2 \
					-b 長廊下小部屋ライト壊れ処理 \
					-f 0x00000004

				if($3 == 1){
					mesg プットスポットライトオブジェ $1 ライト消す
				}


				if($3 == 0){
					chara 電灯虫 $4 \
						-n	4 \
						-p	-11565,-2150,$2 \	// ライト位置 ->> プレイヤー誘導時は無視
						-b	1 \	// 下のバウンディングボックスで壁との当たり見るか  1 : 判定あり, 0 : 判定なし
						-s	(-11565-500),(-2150-1000),($2-500) \	// 最小ボックス座標
						-l	(-11565+200),(-2150+200),($2+500)	// 最大ボックス座標
				}

			}


#else
			chara プットスポットライトオブジェ 照明モデル２ \
				-m w03_lit1a w03_lit1b \
				-t $:ライトＸ座標,-2150,(-2000+$:ライトＺ座標) 100 4000 \
				-l d:LT2_NAME \
				-p $:ライトＸ座標,0,(-2000+$:ライトＺ座標) \
				-f 0x00000004
#endif
		#endif
	}


	proc 長廊下小部屋ライト壊れ処理 {
		if($1 == 長廊下壊れライト１０＿１){
			eval($f:左舷長廊下ライト壊れフラグ１０＿１ = 1)
			mesg 電灯虫 羽虫１０＿１ キル
		}else if($1 == 長廊下壊れライト１０＿２){
			eval($f:左舷長廊下ライト壊れフラグ１０＿２ = 1)
			mesg 電灯虫 羽虫１０＿２ キル
		}else if($1 == 長廊下壊れライト１０＿３){
			eval($f:左舷長廊下ライト壊れフラグ１０＿３ = 1)
			mesg 電灯虫 羽虫１０＿３ キル
		}
	}


