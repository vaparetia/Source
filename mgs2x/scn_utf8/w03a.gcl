	proc 中央長廊下カメラ設定 {
		#if d:STAGE_CAMERA
			// 中央通路

#if 1
			trap ca002 d:PLAYER \
				-mask ＊ \
				-camera \
				-exec {

					if($4 < -14750){
						eval( $i:補完ＢＸ１ = -17000 )
						eval( $i:補完ＢＸ２ = -16000 )
						eval( $i:補完ＬＸ１ = -17000 )
						eval( $i:補完ＬＸ２ = -16000 )

					}else if($4 >= -14750 && $4 < -11500){
						eval( $i:補完ＢＸ１ = -13530 )
						eval( $i:補完ＢＸ２ = -12650 )
						eval( $i:補完ＬＸ１ = -13530 )
						eval( $i:補完ＬＸ２ = -12650 )

					}else if($4 >= -11500 && $4 < -7500){
