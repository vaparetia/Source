						eval( $i:補完ＬＸ１ = -2474 )
						eval( $i:補完ＬＸ２ = -3345 )

					}else if($4 >= -1500 && $4 < 1500){
						eval( $i:補完ＢＸ１ = -312 )
						eval( $i:補完ＢＸ２ = 380 )
						eval( $i:補完ＬＸ１ = -312 )
						eval( $i:補完ＬＸ２ = 380 )

					}else if($4 >= 1500 && $4 < 4500){
						eval( $i:補完ＢＸ１ = 2641 )
						eval( $i:補完ＢＸ２ = 3446 )
						eval( $i:補完ＬＸ１ = 2641 )
						eval( $i:補完ＬＸ２ = 3446 )

					}else if($4 >= 4500 && $4 < 7500){
						eval( $i:補完ＢＸ１ = 5575 )
						eval( $i:補完ＢＸ２ = 6226 )
						eval( $i:補完ＬＸ１ = 5575 )
						eval( $i:補完ＬＸ２ = 6226 )

					}else{
						eval( $i:補完ＢＸ１ = 8517 )
						eval( $i:補完ＢＸ２ = 10500 )
						eval( $i:補完ＬＸ１ = 8517 )
						eval( $i:補完ＬＸ２ = 10500 )

					}



					@CS_スムーズカメラ降順 $6 -126500 -127500 -126100 -126000
					eval( $i:補完ＲＺ = $i:CS_結果１ )

					chara カメラ設定 長廊下小部屋カメラ \
						-c 0 \
						-b $i:補完ＢＸ１,-200,$i:補完ＲＺ $i:補完ＢＸ２,32000,$i:補完ＲＺ \
						-l $i:補完ＬＸ１,-32000,-132000 $i:補完ＬＸ２,-3250,-126150 \
						-r 750,2048,0 \
						-f 3500 \
						-a 200 \
						-i 0 0 0 0 \
						-slide 0 20 1000 1000 60 \
						-s $3 \
						-z d:CAMERA_BOUNDCHANGE_QUICK
				}




#else

//3Dカメラ没（ルール壊しすぎだな～）2K1.1.22
			trap ca002 d:PLAYER \
				-mask ＊ \
				-camera \
				-exec {

					eval( $i:補完ＢＺ１ = -127000 );
					eval( $i:補完ＢＺ２ = -127000 );


					if($6 < -127500){
