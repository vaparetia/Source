//###################################################################################
//									長廊下死体設定
//###################################################################################

	proc 左舷長廊下死体表示 {
		#if d:SHITAI
		print '死体表示'

		chara 死体君 死体 -m tnc_def_blood -d 1 -p -15300,-5000,-69750 -r 0,3072,0 \
			-s d:CORP_STATUS_NOHIT \
			-q 弾薬_ＵＳＰ_敵兵 70 レーション_敵兵 40 弾薬_Ｍ９_敵兵 20 ジアゼパム_敵兵 10


		chara 電灯虫 羽虫 \
			-n	8 \
			-p	-15300,-5000,-69750 \	// ライト位置 ->> プレイヤー誘導時は無視
			-b	0 \	// 下のバウンディングボックスで壁との当たり見るか  1 : 判定あり, 0 : 判定なし
			-s	(-15300-500) (-5000-500) (-69750-500) \	// 最小ボックス座標
			-l	(-15300+500) (-5000+500) (-69750+500)	// 最大ボックス座標

		mesg 電灯虫 羽虫 人誘導 死体



		#endif
	}















//###################################################################################
//								左舷長廊下アイテム設定
//###################################################################################



	proc 左舷長廊下アイテム設定{

		print '長廊下アイテム設定'

#if d:M4_SNAKE
		//小部屋３のパイプ奥
		if($w:武器弾数[ d:武器:Ｍ４ ] == -1 ){
			//@Ｍ４_初期設置 Ｍ４本体 -12000 -5000 -100250 0

		}else{
			@アイテム再セットチェック $b:w03a_取得ロード回数[0]
			if ($f:再セットフラグ) {
				@弾薬_Ｍ４_初期設置 弾薬_Ｍ４１ -12000 -5000 -100250 0
			}
		}
		//左舷突き当たり
		@アイテム再セットチェック $b:w03a_取得ロード回数[1]
		if ($f:再セットフラグ) {
			@弾薬_Ｍ４_初期設置 弾薬_Ｍ４２ -17500,-5000,-128250 0
		}
#endif

		//小部屋１
		@アイテム再セットチェック $b:w03a_取得ロード回数[2]
		if ($f:再セットフラグ) {
			@レーション_初期設置 レーション１ -12250,-5000,-42000 0
		}

		//小部屋２
		@アイテム再セットチェック $b:w03a_取得ロード回数[3]
		if ($f:再セットフラグ) {
			@弾薬_ＵＳＰ_初期設置 弾薬_ＵＳＰ１ -14000,-5000,-68500 0
		}

		//中央長廊下
		@アイテム再セットチェック $b:w03a_取得ロード回数[4]
		if ($f:再セットフラグ) {
			@弾薬_ＵＳＰ_初期設置 弾薬_ＵＳＰ２ -4000,-5000,-128000 0
		}












//戦闘中ＵＳＰ弾補給
		chara アイテム アイテムボックス \
			-b 0 \
			-p -17500 -5000 -125750 \
			-k handgun_amo_ibox \
			-s handgun_amo_ibox_sh \
			-l usp_amo_label \
			-f d:アイテム種別:武器弾 \
			-i d:武器:ＵＳＰ \
			-n 15 \
			-h 300 \
			-r 0 \
			-x { eval($f:左舷長廊下１ＵＳＰ弾存在 = 0) }



		eval($f:左舷長廊下１ＵＳＰ弾存在 = 1)


		trap ca002 d:PLAYER \
			-mask いる \
			-exec {

				if(!$f:左舷長廊下１ＵＳＰ弾存在 && $w:武器弾数[ d:武器:ＵＳＰ ] < 15 && \
					`%カメラ視界チェック -camera 0x03 \
						-bound -17510 -5000 -125760 -17490 -5000 -125740` == 0){

					chara アイテム アイテムボックス \
						-b 0 \
						-p -17500 -5000 -125750 \
						-k handgun_amo_ibox \
						-s handgun_amo_ibox_sh \
						-l usp_amo_label \
						-f d:アイテム種別:武器弾 \
						-i d:武器:ＵＳＰ \
						-n 15 \
						-h 300 \
						-r 0 \
						-x { eval($f:左舷長廊下１ＵＳＰ弾存在 = 0) }

					// 弾薬がステージ上に出現（存在）しましたよ。
					eval($f:左舷長廊下１ＵＳＰ弾存在 = 1)


				}

			}






		chara アイテム アイテムボックス \
			-b 0 \
			-p 10500 -5000 -126500 \
			-k handgun_amo_ibox \
			-s handgun_amo_ibox_sh \
			-l usp_amo_label \
			-f d:アイテム種別:武器弾 \
			-i d:武器:ＵＳＰ \
			-n 15 \
			-h 300 \
			-r 0 \
			-x { eval($f:左舷長廊下２ＵＳＰ弾存在 = 0) }



		eval($f:左舷長廊下２ＵＳＰ弾存在 = 1)


		trap ca002 d:PLAYER \
			-mask いる \
			-exec {

				if(!$f:左舷長廊下２ＵＳＰ弾存在 && $w:武器弾数[ d:武器:ＵＳＰ ] < 15 && \
					`%カメラ視界チェック -camera 0x03 \
						-bound 10490 -5000 -126510 10510 -5000 -126490` == 0){

					chara アイテム アイテムボックス \
						-b 0 \
						-p 10500 -5000 -126500 \
						-k handgun_amo_ibox \
						-s handgun_amo_ibox_sh \
						-l usp_amo_label \
						-f d:アイテム種別:武器弾 \
						-i d:武器:ＵＳＰ \
						-n 15 \
						-h 300 \
						-r 0 \
						-x { eval($f:左舷長廊下２ＵＳＰ弾存在 = 0) }

					// 弾薬がステージ上に出現（存在）しましたよ。
					eval($f:左舷長廊下２ＵＳＰ弾存在 = 1)


				}

			}



	}


	proc アイテム取得時番号設定 $:ボックス名 {
	#if d:DEBUG_PRINT
		print 'item_no_set'
	#endif

		if($:ボックス名 == 弾薬_Ｍ４１) {
			eval($b:w03a_取得ロード回数[0] = $w:グローバルロード回数);

		} else if ($:ボックス名 == 弾薬_Ｍ４２) {
			eval($b:w03a_取得ロード回数[1] = $w:グローバルロード回数);

		} else if ($:ボックス名 == レーション１) {
			eval($b:w03a_取得ロード回数[2] = $w:グローバルロード回数);

		} else if ($:ボックス名 == 弾薬_ＵＳＰ１) {
			eval($b:w03a_取得ロード回数[3] = $w:グローバルロード回数);

		} else if ($:ボックス名 == 弾薬_ＵＳＰ２) {
			eval($b:w03a_取得ロード回数[4] = $w:グローバルロード回数);

		}


		#if d:DEBUG_PRINT
			print $:ボックス名
			print $w:グローバルロード回数
		#endif



	}



















//###################################################################################
//									カメラ設定
//###################################################################################

	// 各種カメラの設定
	// ------------------------------------
	proc 左舷長廊下カメラ設定 {
		#if d:STAGE_CAMERA
			// 左舷通路
			trap ca001 d:PLAYER \
				-mask ＊ \
				-camera \
				-exec {

					eval( $i:スライド距離 = 7000 );
					if ($w:アラートモード == 0) {
						eval( $i:スライド距離２ = 3500 );
					} else {
						eval( $i:スライド距離２ = 7000 );
					}

					@CS_スムーズカメラ降順 $6 -37000 -38500 -17000 -18250
					eval( $i:補完ＬＸ = $i:CS_結果１ );
					@CS_スムーズカメラ降順 $6 -37000 -38500 -16750 -14500
					eval( $i:補完ＬＸ２ = $i:CS_結果１ );

					@CS_スムーズカメラ降順 $6 -32500 -38000 1000 180
					eval( $i:補完ＲＸ = $i:CS_結果１ );

					if ( $6 > -117500 ) {
						@CS_スムーズカメラ昇順 $4 -16000 -15000 2048 1400
					} else {
						@CS_スムーズカメラ降順 $6 -117500 -125000 2048 1900
					}
					eval( $i:補完ＲＹ = $i:CS_結果１ );

					@CS_スムーズカメラ降順 $6 -37000 -38500 3500 2500
					eval( $w:補完距離 = $i:CS_結果１ );

					chara カメラ設定 長廊下カメラ \
						-c 0 \
						-b -17000,-3000,-132000 -16750,32000,-33000 \
						-l $i:補完ＬＸ,-32000,-132000 $i:補完ＬＸ２,-3250,-33500 \
						-r $i:補完ＲＸ,$i:補完ＲＹ,0 \
						-f $w:補完距離 \
						-a 200 \
						-i 3 -1 0 0 \
						-slide 1 20 $i:スライド距離 $i:スライド距離２ 100 \
						-s $3
				}
		#endif




			trap ca005 d:PLAYER \
				-mask ＊ \
				-camera \
				-exec {

					@CS_スムーズカメラ昇順 $4 -16000 -15000 3500 2500
					eval( $w:補完距離 = $i:CS_結果１ );

					if ( $6 > -117500 ) {
						@CS_スムーズカメラ昇順 $4 -16000 -15500 2048 1400
					} else {
						@CS_スムーズカメラ降順 $6 -117500 -125000 2048 1400
					}
