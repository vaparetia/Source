					@CS_スムーズカメラ降順 $6 -126000 -126500 1000 750
					eval( $i:補完ＲＸ = $i:CS_結果１ );

					chara カメラ設定 長廊下小部屋カメラ \
						-c 0 \
//						-b -32000,-200,$i:補完ＲＺ 10500,32000,$i:補完ＲＺ \
						-b -17000,-200,$i:補完ＲＺ 10500,32000,$i:補完ＲＺ \
