						-i 0 0 0 0 \
						-slide 0 20 1000 1000 60 \
						-s $3
				}
#endif

		#endif
	}




















//###################################################################################
//									デバッグ用設定
//###################################################################################

// デバッグキャラ
// ------------------------------------
proc デバッグキャラセット {
	#if d:DEBUG_MODE
		#if d:CHARA_CAMERA
			chara キャラカメラ 敵兵カメラ \
				-c d:TARGET_CHARA \
				-s -920,610,200 \
				-r -200,1024,0
		#endif

		#if d:SCREENSHOT
			chara スクリーンショット shot
		#endif
	#endif

	#if d:USB_KEY
		chara USBキーボード実行 test \
			-e d:KBD_ESC {	mesg 臨時顔アニメキャラ アニメキャラ モーション再生 normal 30
							mesg delay カメラディレイ kill
							mesg 臨時顔アニメキャラ アニメキャラ 視線変更 -1
						} \
			-e d:KBD_INSERT {
							mesg プレイヤー d:PLAYER shadow 1
						} \
			-e d:KBD_DELETE {
							mesg プレイヤー d:PLAYER shadow 0
						} \
			-e d:KBD_BS {
							mesg 遠景ぼかし 遠景ぼかし１ off
							mesg 遠景ぼかし 遠景ぼかし２ off
							mesg 遠景ぼかし 遠景ぼかし３ off
							mesg 近景ぼかし 近景ぼかし１ off
							mesg 近景ぼかし 近景ぼかし２ off
							mesg 近景ぼかし 近景ぼかし３ off
						} \
			-e d:KBD_RIGHT {
							mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 90 \
									($i:プレイヤー位置Ｘ+1000),($i:プレイヤー位置Ｙ-200),($i:プレイヤー位置Ｚ+3000)
						} \
			-e d:KBD_LEFT {
							mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 90 \
									($i:プレイヤー位置Ｘ-1000),($i:プレイヤー位置Ｙ-200),($i:プレイヤー位置Ｚ+3000)
						} \
			-e d:KBD_UP {
							mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 90 \
									($i:プレイヤー位置Ｘ+3000),($i:プレイヤー位置Ｙ-200),($i:プレイヤー位置Ｚ+1000)
						} \
			-e d:KBD_DOWN {
							mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 90 \
									($i:プレイヤー位置Ｘ+3000),($i:プレイヤー位置Ｙ-200),($i:プレイヤー位置Ｚ-1000)
						} \
			-e d:KBD_F1 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_speech_a 30 } \
			-e d:KBD_F2 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_speech_i 30 } \
			-e d:KBD_F3 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_speech_u 30 } \
			-e d:KBD_F4 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_speech_e 30 } \
			-e d:KBD_F5 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_speech_o 30 } \
			-e d:KBD_F6 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_speech_n 30 } \
			-e d:KBD_F7 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_teeth 30 } \
			-e d:KBD_F8 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_scream 0 } \
			-e d:KBD_F9 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_relax 30 } \
			-e d:KBD_F10 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_surprise 30 } \
			-e d:KBD_F11 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_sigh 30 } \
			-e d:KBD_F12 { mesg 臨時顔アニメキャラ アニメキャラ 視線変更 2 } \
			-e d:KBD_Q { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_tension 30 } \
			-e d:KBD_W {
						  chara delay カメラディレイ \
							-time 1 \
							-exec {
								mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_exciting 30
								return 60
							}
						} \
			-e d:KBD_E { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_pain 30 } \
			-e d:KBD_R { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_T12a1D71 30 } \
			-e d:KBD_T {
							mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 120 -7707,-3929,-14119
							chara delay カメラディレイ \
								-time 90 \
								-exec {
									mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 60 6710,-3960,-18261
								}
						} \
			-e d:KBD_Y {
						mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_sneeze 0
						mesg プレイヤー d:PLAYER motion d:モーションリスト:sna_m9_behind_squat_r_sneez_e3 \
							 -1 -1 -1 0x00000004
					 } \
			-e d:KBD_U { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_teeth 30
						  chara delay カメラディレイ \
							-time 20 \
							-exec {
									mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_surprise 20
							}
						  chara delay カメラディレイ \
							-time 40 \
							-exec {
									mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_teeth 20
							}
						} \
			-e d:KBD_I { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_teeth 20
						  chara delay カメラディレイ \
							-time 30 \
							-exec {
									mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_relax 20
							}
						  chara delay カメラディレイ \
							-time 60 \
							-exec {
									mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_surprise 20
							}
						  chara delay カメラディレイ \
							-time 90 \
							-exec {
									mesg 臨時顔アニメキャラ アニメキャラ モーション再生  normal 20
							}
						} \
			-e d:KBD_O {
							mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 90 \
									($i:プレイヤー位置Ｘ-1000),($i:プレイヤー位置Ｙ-200),($i:プレイヤー位置Ｚ+3000)
							chara delay カメラディレイ \
								-time 90 \
								-exec {
									mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 90 \
									($i:プレイヤー位置Ｘ+1000),($i:プレイヤー位置Ｙ-200),($i:プレイヤー位置Ｚ+3000)
								}
							chara delay カメラディレイ \
								-time 180 \
								-exec {
									mesg 臨時顔アニメキャラ アニメキャラ 視線変更 -1
								}
						} \
			-e d:KBD_P {
						  chara delay カメラディレイ \
							-time 1 \
							-exec {
								command ゲット敵兵座標 敵兵:01 $i:敵兵Ｘ $i:敵兵Ｙ $i:敵兵Ｚ
								mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 5 $i:敵兵Ｘ $i:敵兵Ｙ $i:敵兵Ｚ
								return 5
							}
						} \
			-e d:KBD_A { mesg 警備兵 敵兵:01 ルート変更 8 -16000,-5000,-122000 中央長廊下 } \
			-e d:KBD_S { mesg 警備兵 敵兵:01 ルート変更 9 -16000,-5000,-122000 中央長廊下 } \
			-e d:KBD_D { mesg 警備兵 敵兵:01 ルート変更 10 -16000,-5000,-122000 中央長廊下 } \
			-e d:KBD_F {
							mesg 長廊下兵 敵兵:01 モード変更 0
							mesg 長廊下兵 敵兵:02 モード変更 0
							mesg 長廊下兵 敵兵:03 モード変更 0
						} \
			-e d:KBD_G {
							mesg 長廊下兵 敵兵:01 モード変更 1
							mesg 長廊下兵 敵兵:02 モード変更 1
							mesg 長廊下兵 敵兵:03 モード変更 1
						} \
			-e d:KBD_1 { mesg 遠景ぼかし 遠景ぼかし１ on } \
			-e d:KBD_2 { mesg 遠景ぼかし 遠景ぼかし２ on } \
			-e d:KBD_3 { mesg 遠景ぼかし 遠景ぼかし３ on } \
			-e d:KBD_4 { mesg 近景ぼかし 近景ぼかし１ on } \
			-e d:KBD_5 { mesg 近景ぼかし 近景ぼかし２ on } \
			-e d:KBD_6 { mesg 近景ぼかし 近景ぼかし３ on } \
			-e d:KBD_0 { restart } \
			-e d:KBD_END { mesg Ｃ４ Ｃ４ bomb }
	#endif

}

proc 遠近ぼかしセット {
#if d:BOKASHI
	chara 遠景ぼかし 遠景ぼかし１ \
		-plane	4 \
		-near	1000 \
		-far	5000

	chara 遠景ぼかし 遠景ぼかし２ \
		-plane	4 \
		-near	5000 \
		-far	10000

	chara 遠景ぼかし 遠景ぼかし３ \
		-plane	4 \
		-near	10000 \
		-far	15000

	chara 近景ぼかし 近景ぼかし１ \
		-plane	3 \
		-near	0 \
		-far	1000

	chara 近景ぼかし 近景ぼかし２ \
		-plane	3 \
		-near	0 \
		-far	3000

	chara 近景ぼかし 近景ぼかし３ \
		-plane	3 \
		-near	0 \
		-far	5000
#endif
}

proc 水密ドアの向こうの構造セット {
	chara プットオブジェ 旧w03c -m w03b0 -r 0,0,0 -p 0,0,(-85500-39500) -l d:LT2_NAME
	chara プットオブジェ 旧w03cr -m w03b0r -r 0,0,0 -p 0,0,(-85500-39500) -l d:LT2_NAME
	mesg プットオブジェ 旧w03c off
	mesg プットオブジェ 旧w03cr off
}

//-----以下ビデオ用で使用した設定-----

// プレイヤー
// ------------------------------------
proc プレイヤービデオ用設定 {
	#if d:MULTI_MODEL
		chara マルチウェイトキャラ マルチ \
			-name d:PLAYER \
			-model sna_def_mh

		chara 臨時顔アニメキャラ アニメキャラ \
			-chara	d:PLAYER
	#endif

	#if d:MORPHING
		chara 水密ドアプレイヤー手モーフィング管理 モフ管理 \
			-patterns	4 4 \
			-right_hand_cv2	sna_rhand_sdoor01 sna_rhand_sdoor02 \
							sna_rhand_sdoor03 sna_rhand_sdoor04 \
			-left_hand_cv2	sna_lhand_sdoor01 sna_lhand_sdoor02 \
							sna_lhand_sdoor03 sna_lhand_sdoor04 \
			-timing_r 0,1,0 0,46,1 0,52,2 0,70,3 0,74,0 \
					  1,1,3 1,6,4 1,13,1 1,30,2 \
					  2,1,3 2,6,4 2,13,1 2,47,2 \
					  3,1,3 3,20,1 3,32,2 \
					  4,1,3 4,13,1 4,47,2 \
					  5,1,2 5,12,3 5,24,4 5,30,1 \
					  6,1,0 6,137,2 \
			-timing_l 0,1,0 0,46,1 0,52,2 0,70,3 0,74,0 \
					  1,1,3 1,6,4 1,13,1 1,30,2 \
					  2,1,3 2,6,4 2,13,1 2,47,2 \
					  3,1,3 3,20,1 3,32,2 \
					  4,1,3 4,13,1 4,47,2 \
					  5,1,2 5,12,3 5,24,4 5,30,1 \
					  6,1,0 6,137,2
	#endif
}
