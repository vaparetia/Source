					-b 16 //-a 1500

	//ワープ前の待機
				chara 長廊下兵 敵兵:03 -r d:ウォークマン兵待機 \
					-s d:ENE_STATUS_NIGHT_SIGHT \
	//				-h 4000 \
					-i 10000,$w:敵危険視力,$w:敵回避視力 \
	//				-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
					-l $w:敵標準体力 \
					//-l d:長廊下兵標準体力 \
					-f $w:敵標準気絶 \
					-j ドッグタグ_敵兵 [dogtag:tnk_w03a_guard_ve_03] \
						[dogtag:tnk_w03a_guard_ea_03] [dogtag:tnk_w03a_guard_no_03] \
						[dogtag:tnk_w03a_guard_ha_03] [dogtag:tnk_w03a_guard_vh_03] \
					-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
					-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
					-type 0 \
					-proc 死体捜索１


#if d:敵兵_64
//戦闘要員
				chara 長廊下兵 敵兵:04 -r d:戦闘要員北待機 \
					-s d:ENE_STATUS_NIGHT_SIGHT \
					-l d:長廊下兵標準体力 -type 0 -proc 死体捜索２ //-a 1500
#endif


				}




		}else{

//左舷巡回
			chara 長廊下兵 敵兵:01 -r d:敵兵１基本巡回２ \
				-s d:ENE_STATUS_NIGHT_SIGHT \
//				-h 4000 \
				-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
				-l $w:敵標準体力 \
				//-l d:長廊下兵標準体力 \
				-f $w:敵標準気絶 \
				-j ドッグタグ_敵兵 [dogtag:tnk_w03a_guard_ve_01] \
					[dogtag:tnk_w03a_guard_ea_01] [dogtag:tnk_w03a_guard_no_01] \
