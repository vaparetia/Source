//###################################################################################
//								ドアとれイベント
//###################################################################################

proc 左舷長廊下ドアとれるイベント{

// ドア取れるイベント用の設定
	chara 透明壁 敵兵通過不可壁 \	//下側
		-position	-17500,-5000,-124500,2000 \
					-16000,-5000,-124500,2000

	chara 透明壁 敵兵通過不可壁 \	//右側
		-position	-14500,-5000,-128000,2000 \
					-14500,-5000,-126000,2000

	mesg 透明壁 敵兵通過不可壁 off




	chara プットモーションモデル 取れるハンドル \
		-pos  (-17325+500) (-5000+1200) (-3950-39500-57000-28500-30) \
		-dir 2048 \
		-kms w01asdr_handle3 \
//		-kms w03bsdr_handle2 \
		-mar wtdoor_break \
		-number 0 \
		-status	( 0x04 | 0x08 )

	mesg プットモーションモデル 取れるハンドル 非表示



	trap no_dr300 d:PLAYER \
		-mask いる \
		-button d:ACTION_BUTTON \
		-state 0 \
		-exec {

			if(!$f:w01a_ドア取れフラグ){
				eval($f:左舷長廊下ドア壊れエリアに敵兵いる = 1)

				command ゲット敵兵座標 敵兵:01 $i:敵兵Ｘ $i:敵兵Ｙ $i:敵兵Ｚ
				if(( $i:敵兵Ｘ > -14500 ) || ( $i:敵兵Ｚ > -124500 )){
					command ゲット敵兵座標 敵兵:02 $i:敵兵Ｘ $i:敵兵Ｙ $i:敵兵Ｚ
					if(( $i:敵兵Ｘ > -14500 ) || ( $i:敵兵Ｚ > -124500 )){
						command ゲット敵兵座標 敵兵:03 $i:敵兵Ｘ $i:敵兵Ｙ $i:敵兵Ｚ
						if(( $i:敵兵Ｘ > -14500 ) || ( $i:敵兵Ｚ > -124500 )){
							command ゲット敵兵座標 敵兵:04 $i:敵兵Ｘ $i:敵兵Ｙ $i:敵兵Ｚ
							if(( $i:敵兵Ｘ > -14500 ) || ( $i:敵兵Ｚ > -124500 )){
								eval($f:左舷長廊下ドア壊れエリアに敵兵いる = 0)
							}
						}
					}
				}
			}


			if( ( $w:アラートモード == 0 ) && !$f:左舷長廊下ドア壊れエリアに敵兵いる && ($f:w01a_ドア取れフラグ == 0) ){

				//////////////////////////////////////////////////////////////////
				// ドア壊しモーションの発動
				//////////////////////////////////////////////////////////////////
				command 無線設定 -reset

				mesg 透明壁 敵兵通過不可壁 on

				command パッド操作 -release
				command プレイヤー無敵セット
				mesg シネマスクリーン シネマ フェードアウト 0
				command メニュー設定 -menu off -gage off  -radar off -subwin off

				// 水密ドアのハンドルを非表示
				mesg 水密ドア 水密君_no_dr300 handle 0

				// 取れるモーションの表示
				mesg プットモーションモデル 取れるハンドル 表示

				// プレイヤーのモーション発動
				mesg プレイヤー d:PLAYER motion \
					d:モーションリスト:sna_non_hatch_pop_out \
					2048 \	// 初期方向
					-1 \	// 終了方向
					0 \		// 終了姿勢(立ち)
					( d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT | d:FA_NO_WEAPON ) \
					(-17325+500) (-3950-39500-57000-28500-30+700) -4000	//x,z,yの順

				// ハンドルのモーション発動
				mesg プットモーションモデル 取れるハンドル 終了判定  0

				// 終了プロックの登録
				command	強制モーション終了プロック \
					-motion d:モーションリスト:sna_non_hatch_pop_out \
					-proc 取れるハンドル終了プロック

				chara デモキャンセルチェック Ch_ハンドルイベントキャンセル \
					-p Pr_ハンドルイベントキャンセル
				//////////////////////////////////////////////////////////////////
				// ここまで
				//////////////////////////////////////////////////////////////////

			}else{
				command 水密ドア状態 -n 水密君_no_dr300
				mesg プレイヤー d:PLAYER \
					wt_door 水密君_no_dr300 $status \
					2048,1024 \
					-17325,(-3950-39500-57000-28500) \
					1
			}
	}
}




proc Pr_ハンドルイベントキャンセル {
print 'ハンドルイベントキャンセル'

	mesg デモキャンセルチェック Ch_ハンドルイベントキャンセル kill

	command 強制モーションキャンセル
}




proc 取れるハンドル終了プロック {
	print 'ハンドルデモ終了プロック start'

	mesg デモキャンセルチェック Ch_ハンドルイベントキャンセル kill

	mesg 水密ドア 水密君_no_dr300 handle 1
	mesg プットモーションモデル 取れるハンドル 非表示
	mesg 透明壁 敵兵通過不可壁 off

	command プレイヤー無敵解除
	command パッド操作 -cancel

	mesg シネマスクリーン シネマ フェードイン 0
	command メニュー設定 -menu on -gage on -radar on -subwin on

	eval( $f:w01a_ドア取れフラグ = 1 )
	command varsave $f:w01a_ドア取れフラグ

	print 'ハンドルデモ終了プロック end'
}












//###################################################################################
//								左舷長廊下透明壁設定
//###################################################################################

proc 左舷長廊下透明壁設定 {

//左舷長廊下１すきま用
	chara 透明壁 すきま壁 \
		-position	-12824,-5000,-43500,2000 \
					-12824,-5000,-42750,2000 \
		-attribute	( d:HZX_SEG_NO_BULLET | d:HZX_SEG_NO_MISSILE | d:HZX_SEG_NO_RECOIL | d:HZX_SEG_NO_BULLETHOLE | d:HZX_SEG_NO_SPRAY | d:HZX_SEG_NO_HARITSUKI | d:HZX_SEG_NO_C4 | d:HZX_SEG_NO_DISP_RADAR ) \
		-map 左舷長廊下１

//左舷長廊下２すきま用
	chara 透明壁 すきま壁 \
		-position	-12824,-5000,-72000,2000 \
					-12824,-5000,-71250,2000 \
		-attribute	( d:HZX_SEG_NO_BULLET | d:HZX_SEG_NO_MISSILE | d:HZX_SEG_NO_RECOIL | d:HZX_SEG_NO_BULLETHOLE | d:HZX_SEG_NO_SPRAY | d:HZX_SEG_NO_HARITSUKI | d:HZX_SEG_NO_C4 | d:HZX_SEG_NO_DISP_RADAR ) \
		-map 左舷長廊下２

//左舷長廊下３すきま用
	chara 透明壁 すきま壁 \
		-position	-12824,-5000,-100500,2000 \
					-12824,-5000,-99750,2000 \
		-attribute	( d:HZX_SEG_NO_BULLET | d:HZX_SEG_NO_MISSILE | d:HZX_SEG_NO_RECOIL | d:HZX_SEG_NO_BULLETHOLE | d:HZX_SEG_NO_SPRAY | d:HZX_SEG_NO_HARITSUKI | d:HZX_SEG_NO_C4 | d:HZX_SEG_NO_DISP_RADAR ) \
		-map 左舷長廊下３


//中央長廊下左すきま用
	chara 透明壁 すきま壁 \
		-position	-13124,-5000,-129000,2000 \
					-13124,-5000,-128250,2000 \
		-attribute	( d:HZX_SEG_NO_BULLET | d:HZX_SEG_NO_MISSILE | d:HZX_SEG_NO_RECOIL | d:HZX_SEG_NO_BULLETHOLE | d:HZX_SEG_NO_SPRAY | d:HZX_SEG_NO_HARITSUKI | d:HZX_SEG_NO_C4 | d:HZX_SEG_NO_DISP_RADAR ) \
		-map 中央長廊下





	trap wallto d:PLAYER \
		-mask ？ \
		-state d:TRP_STATE_CAUTION \ // 張り付き状態の時
		-exec {
			if( $3 == 入る ) {
				mesg 透明壁 すきま壁 off
			}else{
				mesg 透明壁 すきま壁 on
			}

		}



}



//###################################################################################
//									長廊下消火器
//###################################################################################



proc 長廊下消火器セット{

	chara 消火器 消火器１ \
		-r 0 2048 0 \
		-p -11650 -5000 -40400 \
		-l w03a \
		-b (-11650 - 2000)  -5000 (-40400 - 2000) \
		   (-11650 + 2000) -2000  (-40400 + 2000) \
		-i 0 \	//赤外線センサーに作用
		-d 0


	chara 消火器 消火器２ \
		-r 0 2048 0 \
		-p -11650 -5000 (-40400-28500) \
		-l w03a \
		-b (-11650 - 2000)  -5000 (-40400-28500 - 2000) \
		   (-11650 + 2000) -2000  (-40400-28500 + 2000) \
		-i 0 \	//赤外線センサーに作用
		-d 0


	chara 消火器 消火器３ \
		-r 0 2048 0 \
		-p -11650 -5000 (-40400-57000) \
		-l w03a \
		-b (-11650 - 2000)  -5000 (-40400-57000 - 2000) \
		   (-11650 + 2000) -2000  (-40400-57000 + 2000) \
		-i 0 \	//赤外線センサーに作用
		-d 0


	chara 消火器 消火器４ \
