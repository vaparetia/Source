//###################################################################################
//									マップ設定
//###################################################################################

// マップ設定
// ------------------------------------
chara マップ 左舷長廊下０ -k d:KMS_NAME0 0,0,-39500 -h d:HZX_NAME,0 -l d:LT2_NAME
chara マップ 左舷長廊下１ -k d:KMS_NAME1 0,0,-39500 -h d:HZX_NAME,1 -l d:LT2_NAME
chara マップ 左舷長廊下２ -k d:KMS_NAME1 0,0,(-28500-39500) -h d:HZX_NAME,2 -l d:LT2_NAME
chara マップ 左舷長廊下３ -k d:KMS_NAME1 0,0,(-57000-39500) -h d:HZX_NAME,3 -l d:LT2_NAME
chara マップ 中央長廊下 -k d:KMS_NAME2 0,0,(-85500-39500) -h d:HZX_NAME,4 -l d:LT2_NAME

chara マップ接合 左長廊下０／左長廊下１ 左舷長廊下０ 左舷長廊下１
chara マップ接合 左長廊下１／左長廊下２ 左舷長廊下１ 左舷長廊下２
chara マップ接合 左長廊下２／左長廊下３ 左舷長廊下２ 左舷長廊下３
chara マップ接合 左長廊下３／中長廊下 左舷長廊下３ 中央長廊下

command マップ設定 左舷長廊下０ 左舷長廊下１ 左舷長廊下２ 左舷長廊下３ 中央長廊下 -set {

	/* サウンドマネージャー＞敵兵コマンダー＞ＢＧＭマネージャー
	   の順番は、遵守すること */

	@サウンドマネージャー設定
print '000'
	@常駐キャラ設定
print '001'
	@ローカル変数初期化
print '002'
//	@プレイヤー振動設定 sna_w00b
print '003'
	@跳弾番号設定
print '004'
print '005'
	@プレイヤー設定
print '006'
	@コマンダー設定
#if d:どっきり発動
	@長廊下小部屋ドッキリ発動
#endif
print '007'
	@長廊下マップ切り替え
print '008'
	@エフェクト設定
print '009'
	@カメラセット
print '010'
	@フォグ設定
print '011'
	@水密ドア管理人セット
print '012'

	@デバッグキャラセット
print '013'
	@遠近ぼかしセット
print '014'
	@プレイヤービデオ用設定
print '015'




	@左舷長廊下カメラ設定
print '201'
	@長廊下壊れライト総合設定
	@長廊下小部屋壊れライト設定

	@長廊下消火器セット
	//@左舷長廊下死体表示
	@左舷長廊下アイテム設定
	@左舷長廊下透明壁設定

	@サウンド設定

}

command マップ設定 左舷長廊下０ -set {
	@エンジンルームへの水密ドア設置
print '300'
	@長廊下天井設置 d:CEIL_NAME0 -39500
print '301'
	@長廊下スポットライト設定 d:KMS_NAME0 -39500
print '302'
}

command マップ設定 左舷長廊下１ -set {
print '400'
	@長廊下天井設置 d:CEIL_NAME1 -39500
print '401'
	@長廊下スポットライト設定 d:KMS_NAME1 -39500
print '402'
	//@長廊下小部屋壊れライト設定 -11565 -39500
print '403'
	@左舷小部屋１カメラ設定
print '404'
	@開かない横廊下へのドア_no_dr000
print '405'
}

command マップ設定 左舷長廊下２ -set {
print '500'
	@長廊下天井設置 d:CEIL_NAME1 (-28500-39500)
print '501'
	@長廊下スポットライト設定 d:KMS_NAME1 (-28500-39500)
print '502'
	//@長廊下小部屋壊れライト設定 -11565 (-28500-39500)
print '503'
	@左舷長廊下死体表示
print '504'
	@左舷小部屋２カメラ設定
print '505'
	@開かない横廊下へのドア_no_dr100
print '506'
}

command マップ設定 左舷長廊下３ -set {
print '600'
	@長廊下天井設置 d:CEIL_NAME1 (-57000-39500)
print '601'
	@長廊下スポットライト設定 d:KMS_NAME1 (-57000-39500)
print '602'
	//注意！！ここだけ別扱いです！！
	//@長廊下小部屋壊れライト設定 -11565 (-57000-39500)
print '603'
	@左舷小部屋３カメラ設定
print '604'
	@開かない横廊下へのドア_no_dr200
print '605'
//	@左舷長廊下箱設置

}

command マップ設定 中央長廊下 -set {
print '700'
	@長廊下天井設置 d:CEIL_NAME2 (-85500-39500)
print '701'
	@長廊下スポットライト設定 d:KMS_NAME2 (-85500-39500)
print '702'
	@中央長廊下壊れライト設定
print '703'
	@中央長廊下カメラ設定
print '704'
	@右舷への水密ドアセット
print '705'
	@水密ドアの向こうの構造セット
print '706'
	@開かないドア_no_dr300_no_dr301_no_dr302
print '707'
#if d:ドア取れイベント
	@左舷長廊下ドアとれるイベント
#endif

print '708'
}

command マップ設定 左舷長廊下０ 左舷長廊下１ 左舷長廊下２ 左舷長廊下３ 中央長廊下 -set {

	@キャラ用ライト設置
	@タンカーデジカメ写真判定		//dcam_tanker.hの中にあります。
