	proc 死体捜索１{
		chara delay ディレイ \
			-time 300 \
			-exec {
#if d:敵兵_64
				mesg 長廊下兵 敵兵:04 ワープ無しルート変更 d:ウォークマン兵南見る
#endif
				eval($w:w03a_死体数 = $w:w03a_死体数 + 1)
			}
	}

	proc 死体捜索２{
		chara delay ディレイ \
			-time 300 \
			-exec {
				mesg 長廊下兵 敵兵:03 ワープ無しルート変更 d:ウォークマン兵南見る
				eval($w:w03a_死体数 = $w:w03a_死体数 + 1)
			}
	}

	proc 死体数チェック {
		eval($w:w03a_死体数 = $w:w03a_死体数 + 1)
	}



	proc 長廊下コマンダー０ {
		chara 長廊下コマンダー atcomm \
			-e 長廊下兵０ \
			-defense \
				-15500,-5000,  -125750 6 \
				-10600, -5000 , -126100 6 \
				-6600,-5000,-126000 6 \
				100,-5000,   -126000 6 \
				2250,-5000,-126150 6 \
				5470 ,-5000,-126000 6 \
				8500,-5000,-126000 6 \
				9200,-5000,-128000 7 \
			-type	0 \
//			-final	17250,-5000,-127000
			-final	10300,-5000,-127000
	}



// コマンダー危険時音声
resource ghq_area_alert_voice {
	w03a:
		$t{
			// PLAREA0	左舷
			t:vc040085,	//「わかった。増援を第二甲板、左舷へ派遣する。奴を逃がすな！」
			t:vc040086,	//「了解。増援部隊は、第二甲板へ急行せよ。敵を狩り出せ！」
			-2,
			// PLAREA1	右舷
			t:vc040084,	//「了解。応援部隊、第二甲板へ向かえ。右舷を固めろ」
			t:vc040086,	//「了解。増援部隊は、第二甲板へ急行せよ。敵を狩り出せ！」
			-1// 全ての登録終了
		}
}

// コマンダー警戒時音声
resource ghq_caution_voice {
	w03a:
		$t{
			// PLAREA0 左舷
			t:vc040087,	//「了解。第二甲板を増員。警戒を強化せよ！」
			t:vc040089,	//「了解。第二甲板左舷を増員する。警戒を強化せよ」
			-2,
			// PLAREA1 右舷
			t:vc040087,	//「了解。第二甲板を増員。警戒を強化せよ！」
			t:vc040088,	//「了解。第二甲板右舷を増員する。警備を固めろ！」
			-2,
			t:vc040071,	//「第二甲板との連絡が途絶えた。応援部隊、現場へ向かえ」
			-1 // 登録終了
		}
}





#define 左舷長廊下兵麻酔時間 300
	proc コマンダー設定 {

		if($w:ゲーム設定 <= d:LEVEL_EASY){
			eval($b:w03a_敵兵発生数 = 4)

		}else if($w:ゲーム設定 == d:LEVEL_NORMAL){
			eval($b:w03a_敵兵発生数 = 5)

		}else{
			eval($b:w03a_敵兵発生数 = 8)

		}

		chara コマンダー 敵兵セット \
			-a 長廊下コマンダー０ \
			-r 8000,-5000,-128250 中央長廊下 \
			   -17000,-5000,-125500 中央長廊下 \
			-c 14000,-5000,-97000 左舷長廊下３ \
			-v [ene_tank_voice:01] \
			-x [ghq_area_alert_voice:w03a] \
			-y [ghq_caution_voice:w03a] \
			-g 3 \	//銃ライト
//			-m $w:スタートアラートモード \
			-z $i:敵標準麻酔持続 \
//			-z d:左舷長廊下兵麻酔時間 \
			-o $i:敵標準気絶持続 \
			-h $i:標準警戒時間 \
			-b $b:w03a_敵兵発生数 \
			-e	d:居眠り			0 居眠り継続チェック \
				d:居眠り異状なし	0 居眠り継続チェック \
				d:居眠り２			0 居眠り継続チェック２ \
				d:居眠り異状なし２	0 居眠り継続チェック２ \
			-f	d:ドッキリ敵兵１覗きこみ	0 t:vc045001 t:vc045001_len \	//「ん？誰かいるのか！？」
				d:ドッキリ敵兵１覗きこみ	5 t:vc045002 t:vc045002_len \	//「誰だ！！」？」
				d:ドッキリ敵兵３接近		3 t:vc045003 t:vc045003_len \	//「おいおい、俺だよ」
				d:ドッキリ敵兵１覗きこみ	7 t:vc045004 t:vc045004_len \	//「おどかすな…」
				d:ドッキリ敵兵１覗きこみ	9 t:vc045006 t:vc045006_len \	//「気のせいか」
				d:居眠り異状なし			0 t:vc044203 t:vc044203_len \	//「異状なし（寝言）」
				d:居眠り異状なし２			0 t:vc044203 t:vc044203_len		//「異状なし（寝言）」


		trap en001 d:PLAYER \
			-mask 入る \
			-exec {
				//戦闘要員退避
				//mesg 長廊下兵 敵兵:04 ワープ 11000 -5000 -126750 中央長廊下
				mesg 長廊下兵 敵兵:04 ルート変更 d:戦闘要員北待機
			}


		trap en007 d:PLAYER \
			-mask 入る \
			-exec {
				//戦闘要員退避
				//mesg 長廊下兵 敵兵:04 ワープ -12250 -5000 -41250 左舷長廊下１
				mesg 長廊下兵 敵兵:04 ルート変更 d:戦闘要員南待機
			}



		if( $s:登場ポイント == 左舷最後尾 ){

			// 敵兵ルートチェンジ

			eval($f:敵兵１ルート変更済み = 0)
			eval($f:敵兵２ルート変更済み = 0)

			trap en001 d:PLAYER \
				-mask 入る \
				-exec {
					if(!$f:敵兵１ルート変更済み){
						print '敵兵１スタート'
						eval($f:敵兵１ルート変更済み = 1)
						mesg 長廊下兵 敵兵:01 ルート変更 d:敵兵１基本巡回２
					}
				}



//ウォークマン兵スタート
			trap en007 d:PLAYER \
				-mask 入る \
				-exec {
					if(!$f:敵兵２ルート変更済み){
						eval($f:敵兵２ルート変更済み = 1)
						if($w:ゲーム設定 >= d:LEVEL_HARD ){
							mesg 長廊下兵 敵兵:02 ルート変更 d:ウォークマン兵南見る
						}else{
							mesg 長廊下兵 敵兵:02 ルート変更 d:ウォークマン兵ノリノリ歩き
						}
					}
				}



		}else{
			print '長廊下兵再発生ポイント手前に変更'
			mesg 長廊下コマンダー atcomm 再発生所替え 1

		}


//長廊下兵再発生ポイントチェンジ
		trap en003 d:PLAYER \
			-mask 出る \
			-exec {
				if($4 > 4000){
					print '長廊下兵再発生ポイント手前に変更'
					mesg 長廊下コマンダー atcomm 再発生所替え 1
				}else{
					print '長廊下兵再発生ポイント奥に変更'
					mesg 長廊下コマンダー atcomm 再発生所替え 0
				}
			}



	}


	proc 居眠り継続チェック {
		print '居眠りチェック！！！！！'

		if($i:プレイヤー位置Ｚ < -117000){
			print '寝言２開始'
			mesg 長廊下兵 敵兵:03 ルート変更 d:居眠り異状なし２
		}else{
			print '睡眠２継続'
			mesg 長廊下兵 敵兵:03 ルート変更 d:居眠り２
		}

	}

	proc 居眠り継続チェック２ {
		print '居眠りチェック２！！！！！'

		if($i:プレイヤー位置Ｚ < -117000){
			print '寝言開始'
			mesg 長廊下兵 敵兵:03 ルート変更 d:居眠り異状なし
		}else{
			print '睡眠継続'
			mesg 長廊下兵 敵兵:03 ルート変更 d:居眠り
		}

	}




#endif







//###################################################################################
//								小部屋ドッキリ発動
//###################################################################################






proc 長廊下小部屋ドッキリステップ１処理{

	command ゲット敵兵座標 \
		敵兵:01 $i:長廊下敵兵Ｘ座標 $i:長廊下敵兵Ｙ座標 $i:長廊下敵兵Ｚ座標

	if($b:長廊下小部屋ドッキリイベントステップ == 0 && $i:長廊下敵兵Ｚ座標 < -100000){
		eval($b:長廊下小部屋ドッキリイベントステップ = 1)

		mesg 長廊下兵 敵兵:01 ルート変更 d:ドッキリ敵兵１立ち止まり

		//膠着状態解除
		chara delay ディレイ \
			-time 1800 \
			-exec {
				if($b:長廊下小部屋ドッキリイベントステップ == 1){
					eval($b:長廊下小部屋ドッキリイベントステップ = 100)
					mesg 長廊下兵 敵兵:01 ルート変更 d:敵兵１基本巡回		//通常巡回
					mesg 長廊下兵 敵兵:03 ルート変更 d:居眠り				//居眠り
				}
			}

	}


}








proc 長廊下小部屋ドッキリ発動{

	if( $s:登場ポイント == 左舷最後尾 ){

		print '長廊下小部屋ドッキリ発動セット'

		chara プットモーションモデル 立てかけパイプ \
			-pos -14500,-5000,-99650 \	//$v:配置座標
			-dir 1024 \					//$i:方向
			-kms w03a_pipe \				//$s:KMSモデル名
			-mar pipe_w03a \				//$s:モーションファイル名
			-number 0 \					//$i:基本モーション番号 ...
			-status	(d:PUT_MOT_WAIT | d:PUT_MOT_PRESHADE) 				//$w:ステータス
//			-status	0x02 0x04 0x08		//$w:ステータス

				/*ステータスフラグ設定は以下のとおり
					(0x01) モーションの水平移動量を無視
					(0x02) 重力処理無し
					(0x04) 壁アタリ判定無し
					(0x08) メッセージ受信までモーション停止
				*/


/*
//跳弾アタリ追加
		command 追加ＨＺＸグループ登録 \
			-hzx_id 0 \
			-add_id 3
*/


//ステップ１：スネークが張り付いたら、ビハインドでギリギリ見えるところに移動
		//右側
		trap en004r d:PLAYER \
			-mask 入る \
			-dir 1024,256 \
			-state d:TRP_STATE_CAUTION \
			-exec {

				@長廊下小部屋ドッキリステップ１処理

			}


		trap en004l d:PLAYER \
			-mask 入る \
			-dir 1024,256 \
			-state d:TRP_STATE_CAUTION \
			-exec {

				@長廊下小部屋ドッキリステップ１処理

			}





//ステップ２：スネークが覗き込みをしたら、警戒開始
		trap en004r d:PLAYER \
			-mask いる \
			-dir 1024,256 \
			-state d:TRP_STATE_CAUTION \
			-exec {

				command ゲット敵兵座標 \
					敵兵:01 $i:長廊下敵兵Ｘ座標 $i:長廊下敵兵Ｙ座標 $i:長廊下敵兵Ｚ座標

				command パッドチェック \
					-which 0 \
					-status		//押されている

				if($i:長廊下敵兵Ｚ座標 > -100000 && ($status & d:PAD_L2) && $b:長廊下小部屋ドッキリイベントステップ == 1){
					command ゲット敵兵思考ステータス \
						敵兵:01 $i:敵兵思考状態

					if($i:敵兵思考状態 & d:THK_STATUS_ROOT_ACTION){

						eval($b:長廊下小部屋ドッキリイベントステップ = 2)
						chara delay ディレイ -time 30 -exec {
							mesg プットモーションモデル 立てかけパイプ 終了判定 0

							chara delay ディレイ -time 60 -exec {
								eval($b:長廊下小部屋ドッキリイベントステップ = 3)
//								mesg 長廊下兵 敵兵:01 ルート変更 5
								mesg 長廊下兵 敵兵:01 ルート変更 d:ドッキリ敵兵１覗きこみ
							}

						}
					}
				}
			}




//ステップ３：敵兵:01が警戒を開始したら相方（敵兵:03）スタート
		trap ca001 敵兵:01 \
			-mask いる \
			-exec {

				command ゲット敵兵座標 \
					敵兵:01 $i:長廊下敵兵Ｘ座標 $i:長廊下敵兵Ｙ座標 $i:長廊下敵兵Ｚ座標

				if($i:長廊下敵兵Ｚ座標 > -103750 && $b:長廊下小部屋ドッキリイベントステップ == 3){

					eval($b:長廊下小部屋ドッキリイベントステップ = 4)
					mesg 長廊下兵 敵兵:03 ルート変更 d:ドッキリ敵兵３待機

					chara delay ディレイ -time 1 -exec {

						mesg 長廊下兵 敵兵:03 ワープ -17250 -5000 -114500 左舷長廊下３

						chara delay ディレイ -time 1 -exec {
//							mesg 長廊下兵 敵兵:03 ルート変更 6
							mesg 長廊下兵 敵兵:03 ルート変更 d:ドッキリ敵兵３接近
						}
					}
				}

			}





//ステップ４：終了処理

	//左舷巡回
		trap en005 敵兵:01 \
			-mask 入る \
			-exec {

				if($b:長廊下小部屋ドッキリイベントステップ >= 4 && $b:長廊下小部屋ドッキリイベントステップ < 100){
					eval($b:長廊下小部屋ドッキリイベントステップ = 100)
					print '敵兵１作戦終了'
					mesg 長廊下兵 敵兵:01 ルート変更 d:敵兵１基本巡回
				}

			}


	//居眠り開始
		trap en006 敵兵:03 \
			-mask 入る \
			-exec {

				if($6 > -106250 && $b:長廊下小部屋ドッキリイベントステップ >= 4){
					if($b:長廊下小部屋ドッキリイベントステップ == 4){
						eval($b:長廊下小部屋ドッキリイベントステップ = 5)
					}
					print '敵兵３作戦終了'
					mesg 長廊下兵 敵兵:03 ルート変更 d:居眠り
				}

			}



//何もおこさずスネークが進んでしまった場合
		trap en006 d:PLAYER \
			-mask 入る \
			-exec {

				if($b:長廊下小部屋ドッキリイベントステップ < 4){
					eval($b:長廊下小部屋ドッキリイベントステップ = 100)
					print '敵兵３作戦終了'
					mesg 長廊下兵 敵兵:03 ルート変更 d:居眠り
				}

			}


		//何か異状があったらイベントを終了させる
		chara delay 危険モードチェックディレイ -time 1 -exec{
			if($b:長廊下小部屋ドッキリイベントステップ < 100){

				command ゲットゲームステータス \
					$i:ゲームステータス

				command ゲット敵兵状態 \
					敵兵:01 $i:敵兵１状態

				command ゲット敵兵状態 \
					敵兵:03 $i:敵兵３状態

				if(($i:ゲームステータス & d:STATE_DETECT) \
				|| ((($i:敵兵１状態 | $i:敵兵３状態) & 0x80106004) != 0)){		// 発見～危険モードの間
					print 'キャンセル発動'
					eval($b:長廊下小部屋ドッキリイベントステップ = 100)
					print '作戦終了'
					mesg 長廊下兵 敵兵:01 ルート変更 d:敵兵１基本巡回
					mesg 長廊下兵 敵兵:03 ルート変更 d:居眠り
					return 0
				}else{
					return 1
				}
			}else{
				return 0
			}
		}




	}








}


/*
	($i:敵兵状態 & 0x80106004) == 0

	0x00000004	//倒れ状態
	0x00002000	//捕まえられている
	0x00004000	//気絶中
	0x00100000	//起き上がり中
	0x80000000	//死亡

	のどれでもない。
*/



//###################################################################################
//								マップ切り替えトラップ
//###################################################################################

	// マップ切り替えトラップ
	// ------------------------------------
	proc 長廊下マップ切り替え {

		trap dr001 d:PLAYER \
			-mask 入る \
			-exec {
				mesg マップ接合 左長廊下０／左長廊下１ on
				mesg マップ接合 左長廊下１／左長廊下２ on
				mesg マップ接合 左長廊下１／左長廊下２ off
				mesg マップ接合 左長廊下２／左長廊下３ off

				mesg マップ接合 左長廊下３／中長廊下 off
				mesg プットオブジェ 旧w03c off
				mesg プットオブジェ 旧w03cr off
			}

		trap dr002 d:PLAYER \
			-mask 入る \
			-exec {
				mesg マップ接合 左長廊下０／左長廊下１ on
				mesg マップ接合 左長廊下１／左長廊下２ on
				mesg マップ接合 左長廊下２／左長廊下３ off

				mesg マップ接合 左長廊下３／中長廊下 off
				mesg プットオブジェ 旧w03c off
				mesg プットオブジェ 旧w03cr off
			}

		trap dr003 d:PLAYER \
			-mask 入る \
			-exec {
				mesg マップ接合 左長廊下０／左長廊下１ off
				mesg マップ接合 左長廊下１／左長廊下２ on
				mesg マップ接合 左長廊下２／左長廊下３ on

				mesg マップ接合 左長廊下３／中長廊下 off
				mesg プットオブジェ 旧w03c off
				mesg プットオブジェ 旧w03cr off
			}

		trap dr004 d:PLAYER \
			-mask 入る \
			-exec {
				mesg マップ接合 左長廊下０／左長廊下１ off
				mesg マップ接合 左長廊下１／左長廊下２ off
				mesg マップ接合 左長廊下２／左長廊下３ on

				mesg マップ接合 左長廊下３／中長廊下 on
//				mesg プットオブジェ 旧w03c on
//				mesg プットオブジェ 旧w03cr on
			}

		trap dr005 d:PLAYER \
			-mask 入る \
			-exec {
				mesg マップ接合 左長廊下０／左長廊下１ off
				mesg マップ接合 左長廊下１／左長廊下２ off
				mesg マップ接合 左長廊下２／左長廊下３ off

				mesg マップ接合 左長廊下３／中長廊下 on
//				mesg プットオブジェ 旧w03c on
//				mesg プットオブジェ 旧w03cr on
			}

		trap dr008 d:PLAYER \
			-mask 入る \
			-exec {
				mesg マップ接合 左長廊下０／左長廊下１ off
				mesg マップ接合 左長廊下１／左長廊下２ off
				mesg マップ接合 左長廊下２／左長廊下３ off

				mesg マップ接合 左長廊下３／中長廊下 off
				mesg プットオブジェ 旧w03c off
				mesg プットオブジェ 旧w03cr off
			}

		trap dr006 d:PLAYER \
			-mask 入る \
			-exec {
				mesg マップ接合 左長廊下０／左長廊下１ off
				mesg マップ接合 左長廊下１／左長廊下２ off
				mesg マップ接合 左長廊下２／左長廊下３ off

				mesg マップ接合 左長廊下３／中長廊下 off
				mesg プットオブジェ 旧w03c off
				mesg プットオブジェ 旧w03cr off
			}
	}








//###################################################################################
//									水密ドア設定
//###################################################################################

// ドア
// ------------------------------------
proc 水密ドア管理人セット {
	// ドアの数が増えたら、nオプションの数も変えること。
#if d:SUIMITU_DOOR_ALL
	chara 水密ドア管理 ドア管理人 -n 12 \
		-N d:se_code:SD_A_WALLM04		//$b:ノック音番号 \
		-motions sna_hatch hatch_door_sna hatch_handle_sna
		//-adjusts 10,50 0,0 0,50 0,50
#else
	chara 水密ドア管理 ドア管理人 -n 8 \
		-N 3 \		//$b:ノック音番号 \
		//-N d:se_code:SD_A_WALLM04		//$b:ノック音番号 \
		-motions sna_hatch hatch_door_sna hatch_handle_sna
//		-adjusts 0,50 0,0 0,50 0,50
		//-adjusts $i:左軸ドア引き時プレイヤー位置調整Ｘ \
				//$i:左軸ドア引き時プレイヤー位置調整Ｚ \
				//$i:左軸ドア押し時プレイヤー位置調整Ｘ \
				//$i:左軸ドア押し時プレイヤー位置調整Ｚ \
				//$i:右軸ドア引き時プレイヤー位置調整Ｘ \
				//$i:右軸ドア引き時プレイヤー位置調整Ｚ \
				//$i:右軸ドア押し時プレイヤー位置調整Ｘ \
				//$i:右軸ドア押し時プレイヤー位置調整Ｚ

#endif
}

proc エンジンルームへの水密ドア設置 {
	#if d:CHARA_DOOR
		if( $s:登場ポイント == 左舷最後尾 ){
			chara 水密ドア 水密君 \
				-kms w03bsdr_body w03bsdr_handle \
				-position -17325,-5000,(7150-39500) \
				-rotate 0,0,0 \
				-type 1 \
				-flag d:WT_DOOR_FLAG_OPEN_START \
				-proc エンジンルームへロード \
				-h -17250,-5000,-32250 -16250,-5000,-32250

		}else{
			chara 水密ドア 水密君 \
				-kms w03bsdr_body w03bsdr_handle \
				-position -17325,-5000,(7150-39500) \
				-rotate 0,0,0 \
				-type 1 \
				-proc エンジンルームへロード \
				-h -17250,-5000,-32250 -16250,-5000,-32250

		}


		trap dr001 d:PLAYER \
			-mask いる \
			-button d:ACTION_BUTTON \
			-state 0 \
			-exec {
				command 水密ドア状態 -n 水密君
				mesg プレイヤー d:PLAYER wt_door \
					水密君 $status \	//$s:水密ドアの名前 $i:そのドアの状態
					0,1024 \			//$w:ドアに正対した方向 $w:方向幅
					-17325,(7150-39500)	//$i:ドア位置Ｘ $i:ドア位置Ｚ
			}

		//ハンドル回し中カメラ
		trap dr001 d:PLAYER \
			-mask ？ \
			-camera \
			-state 6 \
			-exec {
				#if d:STAGE_CAMERA
				if( $f:ロードチェックＯＮフラグ == 1 ){
					chara カメラ設定 モーションカメラ \
						-c 1 \
						-p -16180,-1167,-32647 \
						-t -16579,-2877,-32955 \
						-a 200 \
						-i 2 3 0 0 \
						-s $3
				}
				#endif
			}


	#endif
}




proc 右舷への水密ドアセット {
// この水密ドアは、右舷への接続ドア。

	if( $s:登場ポイント == 中央長廊下 ){
		chara 水密ドア 水密君_右舷 \
			-kms w03bsdr_body w03bsdr_handle \
			-position 11550,-5000,(-2575-39500-57000-28500) \
			-rotate 0,3072,0 \
			-type 1 \
			-flag d:WT_DOOR_FLAG_OPEN_START \
			-proc 右舷へロード \
			-h 11500,-5000,-127500 11500,-5000,-126500

	}else{
		chara 水密ドア 水密君_右舷 \
			-kms w03bsdr_body w03bsdr_handle \
			-position 11550,-5000,(-2575-39500-57000-28500) \
			-rotate 0,3072,0 \
			-type 1 \
			-proc 右舷へロード \
			-h 11500,-5000,-127500 11500,-5000,-126500

	}

	trap dr010 d:PLAYER \
		-mask いる \
		-button d:ACTION_BUTTON \
		-state 0 \
		-exec {
			command 水密ドア状態 -n 水密君_右舷
			mesg プレイヤー d:PLAYER wt_door \
				水密君_右舷 $status \
				1024,1024 \
				11550,(-2575-39500-57000-28500)
		}


	//ハンドル回し中のカメラ
	trap dr010 d:PLAYER \
		-mask ？ \
		-camera \
		-state 6 \
		-exec {
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p 10056,-717,-126199 \
				-t 10657,-4045,-127533 \
				-a 200 \
				-i 2 3 0 0 \
				-s $3
		}

}









