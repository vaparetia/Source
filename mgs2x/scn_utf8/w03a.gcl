//###################################################################################
//								ローカル変数初期化
//###################################################################################

	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		if ($i:プレイヤー初期Ｘ位置 < 0) {
			eval($f:イベント兵フラグ = 0); // 不要か？
			eval($w:w03a_死体数 = 0);
		}

	}









//###################################################################################
//									サウンド設定
//###################################################################################


	proc サウンドマネージャー設定 {
		#if d:SOUND
		print 'サウンドマネージャー設定'

		chara サウンドマネージャー ＳＤマネ -pak 0
		mesg  サウンドマネージャー ＳＤマネ SD_CODE d:SE_REVERB_ON
		#endif
	}

	proc サウンド設定 {
		#if d:SOUND
		print 'サウンド設定'

		chara ＢＧＭマネージャー ＢＧＭマネ -s 0x00000001

#if 1
		@サウンド効果音設定
#else
		// 左足
		command 壁床効果音設定 \
			-id 0 \
			-type 0 \
			-se  d:SD_P_FOOTL01 \
			-data  d:se_code:SD_P_FOOT_01L,0 \
				   d:se_code:SD_P_FOOT_02L,0 \
				   d:se_code:SD_P_FOOT_01L,0 \
				   d:se_code:SD_P_FOOT_01L,0 \
				   d:se_code:SD_P_FOOT_01L,0 \
				   d:se_code:SD_P_FOOT_01L,0 \
				   d:se_code:SD_P_FOOT_01L,0 \
				   d:se_code:SD_P_FOOT_01L,0  	// 必ず８セット書くこと
		// 右足
		command 壁床効果音設定 \
			-id 0 \
			-type 0 \
			-se  d:SD_P_FOOTR01 \
			-data  d:se_code:SD_P_FOOT_01R,0 \
				   d:se_code:SD_P_FOOT_02R,0 \
				   d:se_code:SD_P_FOOT_01L,0 \
				   d:se_code:SD_P_FOOT_01L,0 \
				   d:se_code:SD_P_FOOT_01L,0 \
				   d:se_code:SD_P_FOOT_01L,0 \
				   d:se_code:SD_P_FOOT_01L,0 \
				   d:se_code:SD_P_FOOT_01L,0  	// 必ず８セット書くこと

		// 壁叩き音
		command 壁床効果音設定 \
			-id 0 \
			-type 1 \
			-se d:SD_P_WALL02 \
			-data	d:se_code:SD_A_WALLM01,d:NOISE_ZERO \ // 通常
					d:se_code:SD_A_WALLM02,d:NOISE_ZERO \ // 鉄筋
					d:se_code:SD_A_WALLM03,d:NOISE_ZERO \ // 鉄板
					d:se_code:SD_A_WALLM04,d:NOISE_S \	  // 木
					d:se_code:SD_A_WALLM01,d:NOISE_ZERO \
					d:se_code:SD_A_WALLM01,d:NOISE_ZERO \
					d:se_code:SD_A_WALLM01,d:NOISE_ZERO \
					d:se_code:SD_A_WALLM01,d:NOISE_ZERO	// 必ず８セット書くこと

		// 敵兵１用
		// 左足
		command 壁床効果音設定 \
			-id 1 \
			-type 0 \
			-se  d:SD_P_FOOTL01 \
			-data  d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_2L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO 	// 必ず８セット書くこと
		// 右足
		command 壁床効果音設定 \
			-id 1 \
			-type 0 \
			-se  d:SD_P_FOOTR01 \
			-data  d:se_code:SD_E_EFOOT_1R1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_2R1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO 	// 必ず８セット書くこと

		// 敵兵２用
		// 左足
		command 壁床効果音設定 \
			-id 2 \
			-type 0 \
			-se  d:SD_P_FOOTL01 \
			-data  d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_2L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO 	// 必ず８セット書くこと
		// 右足
		command 壁床効果音設定 \
			-id 2 \
			-type 0 \
			-se  d:SD_P_FOOTR01 \
			-data  d:se_code:SD_E_EFOOT_1R1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_2R1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO 	// 必ず８セット書くこと

		// 敵兵３用
		// 左足
		command 壁床効果音設定 \
			-id 3 \
			-type 0 \
			-se  d:SD_P_FOOTL01 \
			-data  d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_2L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO 	// 必ず８セット書くこと
		// 右足
		command 壁床効果音設定 \
			-id 3 \
			-type 0 \
			-se  d:SD_P_FOOTR01 \
			-data  d:se_code:SD_E_EFOOT_1R1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_2R1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO 	// 必ず８セット書くこと
#endif

		#endif
	}

	// 跳弾番号設定
	// ------------------------------------
	proc 跳弾番号設定 {

		command 跳弾ノーマル -n 0
		command 跳弾ノーマル -n 1
		command 跳弾ノーマル -n 2
		command 跳弾ノーマル -n 3
		command 弾痕ノーマル -n 0
		command 弾痕ノーマル -n 1
		command 弾痕ノーマル -n 2
		command 弾痕ノーマル -n 3



		command 弾痕ノーマル -n 5
		command 弾痕ノーマル -n 6
		command 弾痕ノーマル -n 7
		command 跳弾水蒸気大 -n 5
		command 跳弾水蒸気中 -n 6
		command 跳弾水蒸気小 -n 7
	}







