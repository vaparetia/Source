//dv}//v
}//d
//フラグ進め方 h //e
resource PO_南北通路＿スネーク探せ２__s {
//vox t:vc240171 {
オタコン_000: {
He o&'ido tu CALL un par de veces.
}
//	<<<ENGLISH>>>
//	I've heard your CALL sound
//	go off a couple of times now.
//<ページ数変更>
オタコン_000_1: {
&~!Contesta! &~?No?
}
//	<<<ENGLISH>>>
//	Try answering it for
//	a change, okay?

/*ＣＡＬＬが何度も鳴ってるみたい
じゃないか。受けてみたらどうだい？
*/
//dv}//v
}//d
//スネーク合流後 扉近く h //e
resource PO_南北通路＿スネーク合流後扉近く__s {
//vox t:vc240181 {
オタコン_000: {
Raiden, esa puerta est&'a cerrada.
Dir&'igete al norte.
}
//	<<<ENGLISH>>>
//	Raiden, that door's locked.
//	Head north instead.

/*ライデン、そこの扉はロックされてる。
北の方に向かうんだ。
*/
//dv}//v
}//d

//★P073_05_S01通路Ａ５シナリオデモ１終了＜フラグ＜P074_01_P01通路Ａ刀後１ポリゴンデモ１開始 d //e
//スネーク合流後 h //e
resource PO_南北通路＿スネーク合流後__s {
//vox t:vc240191 {
オタコン_000: {
Bien, veo que has estado con Snake.
Cuando hayas terminado de practicar
con la espada, dir&'igete hacia el norte.
}
//	<<<ENGLISH>>>
//	Good, you met up with Snake.
//	When you're done practicing
//	with the sword, head north.

/*スネークと合流できたね。
刀の練習が済んだら北に向かうんだ。
*/
//dv}//v
}//d

//スネーク合流後 催促 h //e
resource PO_南北通路＿スネーク合流後＿催促__s {
//vox t:vc240201 {
オタコン_000: {
Creo que ya has practicado bastante.
Vamos, sigue adelante, tienes que
alcanzar a Snake.
}
//	<<<ENGLISH>>>
//	I think you've had enough practice.
//	It's time to get going -- you need
//	to catch up to Snake.

/*もう練習は充分だろ？
そろそろ先に進もう。
スネークのところに行ってくれ。
*/
//dv}//v
}//d


//★P074_03_P02通路Ａ刀後３ポリゴンデモ２終了＜フラグ＜P076_01_R01大佐ＡＩ１無線機デモ１開始 d //e
//北に行け h //e
resource PO_天狗通路Ｂ＿北に行け__s {
//vox t:vc0240211 {
オタコン_000: {
En el fondo norte de este pasillo
hay una puerta.
}
//	<<<ENGLISH>>>
//	There's a door at the north
//	end of that corridor.
//<ページ数変更>
オタコン_000_1: {
Solidus tiene que estar, al otro lado.
Qu&'edate con Snake y contin&'ua hacia
el norte.
}
//	<<<ENGLISH>>>
//	Solidus should be somewhere on
//	the other side. Stay with Snake
//	and keep north.

/*その通路の北に扉がある。
ソリダス達はその先にいるはずだ。
スネークと一緒に北に進むんだ。
*/
//dv}//v
}//d

//スネークが死ぬと一緒にゲームオーバー h //e
resource PO_スネーク死んだら終わり__s {
//vox t:vc240221 {
オタコン_000: {
El indicador de LIFE de Snake est&'a
justo debajo del tuyo. Tu vives y
mueres con &'el, &~?entiendes?
}
//	<<<ENGLISH>>>
//	Snake's Life Gauge is right below
//	yours. You live and die together,
//	do you understand?

/*スネークのＬＩＦＥが君のＬＩＦＥ
ゲージの下に表示されている。
一連托生だ、いいね。
*/
オタコン_001: {
Seguro que no ten&'eis ning&'un problema,
pero si est&'a en apuros, ay&'udale
en lo que puedas.
}
//	<<<ENGLISH>>>
//	I'm sure everything will be okay,
//	but if he gets in a tight spot, give
//	him all the backup you can.
//<ページ数変更>
オタコン_001_1: {
&~!Conf&'io en ti!
}
//	<<<ENGLISH(2)>>>
//	I'm counting on you!

/*大丈夫だとは思うけど、スネークが
危なくなったら援護してやってくれ。
頼むよ！
*/
//dv}//v
}//d


//★P077_01_R01ローズ拉致１無線機デモ１終了＜フラグ＜天狗兵登場 d //e
//
//北に進もう h //e
resource PO_天狗ラッシュ前__s {
//vox t:vc240231 {
オタコン_000: {
Tiene que haber una escalera alta
en la pared norte.
}
//	<<<ENGLISH>>>
//	There should be a tall
//	ladder on the north wall.
//<ページ数変更>
オタコン_000_1: {
Ellos tienen que estar arriba.
&~!Empieza a subir por la escalera!
}
//	<<<ENGLISH>>>
//	Those guys should be at
//	the top. Start climbing!

/*北の壁に長いハシゴがあるだろう。
それを登ればきっとその先に奴等がいる。
ハシゴを登るんだ。
*/
//dv}//v
}//d

//★天狗兵登場＜フラグ＜P078_01_P01ＡＧフォーチュン登場１ポリゴンデモ１開始 d //e
//全滅させろ h //e
resource PO_天狗ラッシュ＿基本__s {
//vox t:vc240241 {
オタコン_000: {
El enemigo tiene tantas ganas de
detenerte como t&'u de avanzar. 
}
//	<<<ENGLISH>>>
//	The enemy is as desperate to stop
//	you as you are to get past them.
//<ページ数変更>
オタコン_000_1: {
La &'unica opci&'on es acabar con todos ellos.
&~!Adelante!
}
//	<<<ENGLISH>>>
//	Taking them all out is the
//	only way through. Do it!

/*敵も君達を阻止しようと必死なんだ。
そいつらを全て排除しなければ先には
進めないだろう。がんばって！
*/
//dv}//v
}//d

//みねうち h //e
resource PO_天狗ラッシュ＿みねうち__s {
//vox t:vc240251 {
オタコン_000: {
Si no quieres matar a un enemigo,
dale un golpe por detr&'as para dejarle
inconsciente.
}
//	<<<ENGLISH>>>
//	If you don't want to kill, use the
//	sword to hilt-strike someone
//	and knock them unconscious.

/*敵の命を奪いたくない時は刀の
みねうちを使って気絶させるといい。
*/
//dv}//v
}//d

//★P078_01_P01ＡＧフォーチュン登場１ポリゴンデモ１終了＜フラグ＜P079_01_P01ＲＡＹ戦前１ポリゴンデモ１開始 d //e
//メタル戦前 h //e
resource PO_メタル戦前先行け__s {
//vox t:vc240261 {
オタコン_000: {
Snake est&'a bien. El se ocupar&'a Fortune,
t&'u sigue adelante.
}
//	<<<ENGLISH>>>
//	I'm sure Snake is fine.
//	Let him deal with Fortune
//	-- you keep going.

/*スネークならきっと大丈夫だ。
フォーチュンはスネークに任せて
君は先に進め。
*/
オタコン_001: {
Tienes que detener el Arsenal Gear y
acabar con Solidus.
}
//	<<<ENGLISH>>>
//	You have to stop Arsenal
//	Gear and take out Solidus.

/*アーセナルギアを止めるんだ。
ソリダス達を倒してくれ。
*/
