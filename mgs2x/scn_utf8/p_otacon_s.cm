//	out of the enemy's sight.

/*ライデン、その格好では戦闘なんか
できっこない。敵に見つからないように
進むんだ。
*/
//dv}//v
}//d

//南北通路 h //e
resource PO_南北通路＿スネーク探せ１__s {
//vox t:vc240161 {
オタコン_000: {
Snake te est&'a esperando por aqu&'i.
Mira a tu alrededor.
}
//	<<<ENGLISH>>>
