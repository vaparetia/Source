resource PO_ソリダス戦＿ソリダス防御__s {
//vox t:vc240721 {
オタコン_000: {
Solidus est&'a muy bien protegido.
Apunta a sus partes sin protecci&'on.
}
//	<<<ENGLISH>>>
//	Solidus' defenses are solid.
//	You should aim for the
//	unprotected parts.

/*ソリダスの防御は堅い。
防御していない部分を狙った方が
いいだろう。
*/
オタコン_001: {
Si esta cubriendo por arriba dale
desde abajo.
}
//	<<<ENGLISH>>>
//	If he is defending high,
//	slash upward, and cut
//	him from below.

/*ソリダスが上段を守っているなら
下から斬り上げろ。
*/
