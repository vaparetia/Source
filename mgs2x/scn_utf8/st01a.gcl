// ------------------------------------
// 各gclで必要なdefine
// ------------------------------------
// モード
#define		STAGE_VR 		1		// 共通プロック切り分け用
#define		VR_STREAKING	1		// 共通プロック切り分け用
// ステージ名
#define		STAGE_ST01A		1		// 共通プロック切り分け用
// 敵兵、ＮＰＣ状況（薬莢を呼び分けるのに必要）
#define		ENE_P_GOL		1		// 都市迷彩ゴル兵
#define		ENE_SHOT		1		// ショットガン兵
#define		ENE_HIGH_TECH	1		// ハイテク兵
#define		ENE_SHIELD		1		// 盾兵


// ------------------------------------
// 各種スイッチ用define
// ------------------------------------
// デバッグ関係
#ifdef	d:FIX_MODE
	#define		DEBUG_CHARA		0		// デバッグキャラ全体(FIX時は0)
#else
	#define		DEBUG_CHARA		0		// デバッグキャラ全体
#endif
#define		CHARA_CAMERA	0		// キャラ追従カメラ
#define		TARGET_CHARA	敵兵:01	// キャラ追従カメラのターゲット
#define		SCREENSHOT		0		// スクリーンショット
#define		USB_KEY			0		// USBキーボード


// ------------------------------------
// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME			st01a
#define		KMS_NAME			vs01a
#define		TONBO_KMS_NAME		vs01a_tonbo
#define		LINE_KMS_NAME		vs01a_line

// キャラクター関係
#define		PLAYER		ライデン

// ------------------------------------
// 敵兵音声
// ------------------------------------

// ------------------------------------
// 敵兵ルート番号
// ------------------------------------
enum E_R {
	雷電道１ = 0,
	雷電道２
};
#define WINDOW_STREAKING_ST01A	[VRMSG_J:VRM_STR_st01a] [VRMSG_E:VRM_STR_st01a] [VRMSG_G:VRM_STR_st01a] \	// 日、英、独
								[VRMSG_F:VRM_STR_st01a] [VRMSG_I:VRM_STR_st01a] [VRMSG_S:VRM_STR_st01a] \	// 仏、伊、西
								[VRMSG_K:VRM_STR_st01a] \															// 韓
								p:ＶＲステージ開始時処理 1

#define WATCHER_STATUS_ST01A	d:ENE_STATUS_NORMAL 2000 0 -10000 ストリーキング１面
// ------------------------------------
// include
// ------------------------------------
#include "rai_st01a.mh"		// 強制モーションリスト
#include "stdch.h"
#include "enevoice.h"
#include "a_stdproc.h"		// アナザーミッション設定ファイル
#include "sload.h"
#include "sound.h"
#include "item_info.h"
#include "ene_item.h"
#include "vr_common.h"		// ＶＲステージ共通で使用するプロック
#include "st_common.h"		// ストリーキング共通ヘッダ
#include "vs01a_common.h"	// ステージ共通ヘッダ
#if d:USB_KEY
	#include "usbkbd.h"
#endif
// ------------------------------------
// マップ設定
// ------------------------------------
chara マップ ストリーキング１面 -k d:KMS_NAME -h d:HZX_NAME,0 -l $s:ＶＲライトファイル名

command マップ設定 ストリーキング１面 -set {
	// ローカルの初期化
	// ------------------------------------
	@ローカル変数初期化		// ローカルで使用する変数で初期化をする場合はここで

	// ＶＲで必要な基本プロックのセット(vr_common.hで定義)
	// サウンドの基本パック、ＶＲの基本システム、プレイヤー、ゴール等を設定します
	// ※このプロックを使用する時は「ＶＲクリア時処理」というプロックが必要です
	// ＶＲ共通プロックセット	$:スネークファイル $:雷電ファイル $:クリア条件フラグ
	//							$:ゴールＸ $:ゴールＹ $:ゴールＺ $:タイマー初期値
	//	VR_GOAL_TARGET	/*的全滅でゴールが開く*/
	//	VR_GOAL_FREE	/*ゴールが最初から開いてる*/
	//	VR_GOAL_ENEMY	/*敵全滅でゴールが開く*/
	//	VR_GOAL_SNEAK	/*潜入モード中はゴールが開く*/
	//	VR_GOAL_TIME	/*タイマーがゼロになるとゴールが開く*/
	// ------------------------------------
	@ストリーキングプロックセット sna_st01a rai_st01a d:VR_GOAL_FREE 2000 0 -10000

	// ＶＲウィンドウの設定
	// ------------------------------------
	@ストリーキング１面ＶＲウィンドウ設定

	// クリア時に呼ばれるものの設定
	// ------------------------------------
	@ＶＲポーズ設定

	// ステージに引かれるライン
	// ------------------------------------
	@ＶＲアウトライン d:KMS_NAME d:TONBO_KMS_NAME d:LINE_KMS_NAME

	// 設定値を変更する場合は以下のプロック内で設定
	// ------------------------------------
	@設定値変更				// 敵兵や的のパラメータをステージ限定で変える時はここで
	@プラグイン設定			// プレイヤーのプラグインがいる時はここで

	// 敵兵・的関係の設定
	// ------------------------------------
	@コマンダー設定

	// ＢＧＭの設定(プレイヤー→敵兵→BGMの順で呼ぶ)
	// ------------------------------------
	@ＢＧＭ設定

	// アイテムの設定
	// ------------------------------------
	@アイテム設定

	// 光源、オブジェクト、カメラ関連の設定
	// ------------------------------------
	@ＶＲフォグ設定 d:VR_FOG:朝Ｎ 35000 d:VR_FOG:夕Ｎ 33000 d:VR_FOG:夜Ｎ 20000
	@カメラセット					// chara カメラとベースのカメラを設定
	@vs01aカメラ設定				// ステージ固有のカメラ設定がいる時はこのプロックで
	@ＶＲキャラ用ライト設置			// 必ず最後に設定
#if d:DEBUG_CHARA
//	@デバッグキャラセット
#endif
}

//初期マップの表示
command マップ表示 -show ストリーキング１面


// 各proc設定
//-------------------------------------------------------------------------------------
// 全マップ共通
//------------------------------------------------------------
	// ＶＲウィンドウの設定と表示
	//------------------------------------------------------------
	proc ストリーキング１面ＶＲウィンドウ設定 {
		#if d:DEBUG_PRINT
			print 'vr_window_set'
		#endif
		@ＶＲストリーキングウィンドウ設定	d:WINDOW_STREAKING_ST01A


		// ＶＲウィンドウを表示する
		mesg ＶＲウィンドウ ＶＲウィンドウ君 開く

		// スタート時とクリア時に使用するカットインカメラ
		chara カメラ カットインカメラ		-c 0 -l 0 -p  0

		// スタート時のカメラ(必要な場合)
		chara カメラ設定 カットインカメラ \
			-c 1 \
			-p 2058,6871,-3734 -t 2000,0,-10000 \
			-r 542,2054,0 -f 9299 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1
	}

	//------------------------------------------------------------
	// ステージ開始時処理
	//------------------------------------------------------------
	proc ＶＲステージ開始時処理 {
		#if d:DEBUG_PRINT
			print 'game_start!!!!!'
		#endif

		// プレイヤーやパッドの制御等を行う a_stdproc.hで定義
		@全ミッション共通ステージ開始時処理

		// カメラワークスタート(必要な場合)
		// 全体図
		chara カメラ設定 カットインカメラ \
			-c 1 \
			-p 351,12396,7091 -t 360,6121,1369 \
			-r 542,2047,0 -f 8492 \
			-a 200 \
			-i 4 4 d:START_CAMERA_CHANGE_TIME d:START_CAMERA_CHANGE_TIME \
			-s 1

		chara delay ディレイ \
			-time d:START_CAMERA_CHANGE_TIME \
			-exec {
				chara カメラ設定 カットインカメラ -s -1
			}
	}

	// ------------------------------------
	// クリア時の処理
	// ------------------------------------
	proc ＶＲクリア時処理 {
		#if d:DEBUG_PRINT
			print 'clear'
		#endif
		eval ($i:A_ストリーキングミッションタイム = `%ＶＲゲットタイム` );
		@ストリーキングネクストステージ p:load_st02a
	}

	// ------------------------------------
	// パラメータ系の変更
	// ------------------------------------
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT
			print 'localvar_init'
		#endif
		@各ミッション用武器装備初期化 // 何も持っていない状態に。
		if($i:A_ストリーキングミッションタイム){
			eval( $$i:裸ライデンタイム = $i:A_ストリーキングミッションタイム );
		}
	}
	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT
			print 'status_set'
		#endif
	}
	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif
	}



	// ------------------------------------
	// 敵兵や的の処理
	// ------------------------------------
	// 敵兵に関する設定
	//-------------------------------------
	proc 警備兵セット {
		#if d:DEBUG_PRINT
			print 'watcher_set'
		#endif
// 		VR_警備兵 $:p_名前 $:p_ルート $:p_ノード $:p_ステータス $:p_守備Ｘ $:p_守備Ｙ $:p_守備Ｚ $:p_守備マップ
		@VR_警備兵 敵兵:01 d:E_R:雷電道１ 0 d:WATCHER_STATUS_ST01A

	}

	proc 攻撃兵セット {
		#if d:DEBUG_PRINT
			print 'attacker_set'
		#endif
	}

	proc 警備兵コマンダー {
		#if d:DEBUG_PRINT
			print 'wccomm_set'
		#endif

		chara 警備コマンダー wccomm -e {警備兵セット}
	}

	proc 攻撃兵コマンダー {
		#if d:DEBUG_PRINT
			print 'atcomm_set'
		#endif
	}

	proc コマンダー設定 {
		#if d:DEBUG_PRINT
			print 'commander_set'
		#endif

		chara コマンダー 敵兵セット \
			-w 警備兵コマンダー \
//			-a 攻撃兵コマンダー \
			-d スニーキング１面 \
			-r 2000,0,-10000 ストリーキング１面 \
			-c 2000,0,-10000 ストリーキング１面 \
			-v [ene_vr_voice:01] \
			-z $i:敵標準麻酔持続 \
			-h $i:標準警戒時間 \
			-o $i:敵標準気絶持続 \
			-s (d:ENE_STAGE_GPS | d:ENE_STAGE_VR_ANOTHER) \
			-b 0 \
			-m d:ALERT_MODE_SENNYU
	}



	// ------------------------------------
	// ＢＧＭの設定
	// ------------------------------------
	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT
			print 'bgm_set'
		#endif

		chara ＢＧＭマネージャー ＢＧＭマネ
	}


	// ------------------------------------
	// アイテムの設定
	// ------------------------------------
	// 再発生が必要な時は以下のプロックの中を記述する
	// ------------------------------------
	proc アイテム取得時番号設定 $:ボックス名 {
		#if d:DEBUG_PRINT
			print 'item_no_set'
		#endif
	}
	// アイテムの設置
	// ------------------------------------
	proc アイテム設定 {
		#if d:DEBUG_PRINT
			print 'item_set'
		#endif
		// $:p_ボックス名 $:p_Ｘ座標 $:p_Ｙ座標 $:p_Ｚ座標 $:p_水飛沫 $:p_耐久力
		@ダンボール_初期設置 だんぼうる -1000 0 -2000 0 25
	}
