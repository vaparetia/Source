// ------------------------------------
// 各gclで必要なdefine
// ------------------------------------
// 共通プロック切り分け用
#define		STAGE_VR		1		// モード
#define		STAGE_WP32A		1		// ステージ名
#define		VR_WEAPON		1		// VRステージの呼び分け

#define		STAGE_START		1		// ステージ開始直後処理


// ------------------------------------
// 各種スイッチ用define
// ------------------------------------
// デバッグ関係
#ifdef	d:FIX_MODE
	#define		DEBUG_CHARA		0		// デバッグキャラ全体(FIX時は0)
#else
	#define		DEBUG_CHARA		0		// デバッグキャラ全体
#endif
#define		CHARA_CAMERA	0		// キャラ追従カメラ
#define		TARGET_CHARA	敵兵:01	// キャラ追従カメラのターゲット
#define		SCREENSHOT		0		// スクリーンショット
#define		USB_KEY			0		// USBキーボード


// ------------------------------------
// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME			ws32a
#define		KMS_NAME			ws32a
#define		TONBO_KMS_NAME		ws32a_tonbo
#define		LINE_KMS_NAME		ws32a_line

// キャラクター関係
#define		PLAYER		ライデン


// ------------------------------------
// ローカル変数
// ------------------------------------


// ------------------------------------
// 的ルート番号
// ------------------------------------
enum M_R {
	//	グレネード２面用
//	ライデンルート０ = 0,	// 欠番
	ライデンルート１ = 1,
	ライデンルート２, ライデンルート３, ライデンルート４,

	スネークルート５, スネークルート６, スネークルート７, スネークルート８,

	前作スネークルート９, 前作スネークルート１０, 前作スネークルート１１, 前作スネークルート１２,
}


// ------------------------------------
// include
// ------------------------------------

#include "rai_wp32a.mh"		// 強制モーションリスト

#include "stdch.h"			// 常駐キャラ
//#include "enevoice.h"
#include "a_stdproc.h"		// アナザーミッション設定ファイル
#include "sload.h"			// ロード関数
#include "sound.h"
#include "item_info.h"
#include "a_item_info.h"
//#include "ene_item.h"
#include "jump.h"			// 自動ジャンプ関係
#include "vr_common.h"		// ＶＲステージ共通で使用するプロック

#if d:USB_KEY
	#include "usbkbd.h"
#endif



// ------------------------------------
// マップ設定
// ------------------------------------
chara マップ 武器訓練グレネード２面 -k d:KMS_NAME -h d:HZX_NAME,0 -l $s:ＶＲライトファイル名

command マップ設定 武器訓練グレネード２面 -set {
	// ローカルの初期化
	// ------------------------------------
	@ローカル変数初期化		// ローカルで使用する変数で初期化をする場合はここで

	// ＶＲで必要な基本プロックのセット(vr_common.hで定義)
	// サウンドの基本パック、ＶＲの基本システム、プレイヤー、ゴール等を設定します
	// ※このプロックを使用する時は「ＶＲクリア時処理」というプロックが必要です
	// ------------------------------------
	@ＶＲ共通プロックセット sna_wp32a rai_wp32a d:VR_GOAL_TARGET 0 0 1000

	// ＶＲウィンドウの設定
	// ------------------------------------
	@武器訓練グレネード２面ＶＲウィンドウ設定

	// クリア時に呼ばれるものの設定
	// ------------------------------------
	@ＶＲクリア設定 p:load_wp33a p:load_wp32a

	// ステージに引かれるライン
	// ------------------------------------
	@ＶＲアウトライン d:KMS_NAME d:TONBO_KMS_NAME d:LINE_KMS_NAME

	// 設定値を変更する場合は以下のプロック内で設定
	// ------------------------------------
	@設定値変更				// 敵兵や的のパラメータをステージ限定で変える時はここで
	@プラグイン設定			// プレイヤーのプラグインがいる時はここで
	@ジャンプ設定

	// 的関係の設定
	// ------------------------------------
	@ＶＲ標的グレネード２面設定				// ＶＲシステム起動後に呼ぶ

	// ＢＧＭの設定(プレイヤー→敵兵→BGMの順で呼ぶ。的の場合は関係ないがとりあえずここに)
	// ------------------------------------
	@ＢＧＭ設定

	// アイテムの設定
	// ------------------------------------
	@アイテム設定

	// 光源、オブジェクト、カメラ関連の設定
	// ------------------------------------
	@ＶＲフォグ設定 d:VR_FOG:朝Ｎ 35000 d:VR_FOG:夕Ｎ 35000 d:VR_FOG:夜Ｎ 27000
	@カメラセット						// chara カメラとベースのカメラを設定
	@武器訓練グレネード２面カメラ設定	// ステージ固有のカメラ設定がいる時はこのプロックで
	@ＶＲキャラ用ライト設置				// vr_common.hに定義。必ず最後に設定
#if d:DEBUG_CHARA
//	@デバッグキャラセット
#endif

}

//初期マップの表示
command マップ表示 -show 武器訓練グレネード２面


//###################################################################################
//									各proc設定
//###################################################################################



//###################################################################################
//									全マップ共通
//###################################################################################
	// ------------------------------------
	// 全マップ共通
	// ------------------------------------
	//------------------------------------------------------------
	// ＶＲウィンドウの設定と表示
	//------------------------------------------------------------
	proc 武器訓練グレネード２面ＶＲウィンドウ設定 {
		#if d:DEBUG_PRINT
			print 'vr_window_set'
		#endif

		@ＶＲウィンドウ設定	[VRMSG_J:VRM_WPN_GRN_wp32a] [VRMSG_E:VRM_WPN_GRN_wp32a] [VRMSG_G:VRM_WPN_GRN_wp32a] \	// 日、英、独
							[VRMSG_F:VRM_WPN_GRN_wp32a] [VRMSG_I:VRM_WPN_GRN_wp32a] [VRMSG_S:VRM_WPN_GRN_wp32a] \	// 仏、伊、西
							[VRMSG_K:VRM_WPN_GRN_wp32a] \															// 韓
							p:ＶＲステージ開始時処理								// 終了プロック


		// ＶＲウィンドウを表示する
		mesg ＶＲウィンドウ ＶＲウィンドウ君 開く

		// スタート時とクリア時に使用するカットインカメラ
		chara カメラ カットインカメラ		-c 0 -l 0 -p 0

		// スタート時のカメラ(必要な場合)
		chara カメラ設定 カットインカメラ \
			-c 1 \	
			-p 0,6600,3350 -t 0,0,1000 \
			-r 800,2048,0 -f 7000 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1
	}

	//------------------------------------------------------------
	// ステージ開始時処理
	//------------------------------------------------------------
	proc ＶＲステージ開始時処理 {
		#if d:DEBUG_PRINT
			print 'game_start!!!!!'
		#endif

		// プレイヤーやパッドの制御等を行う a_stdproc.hで定義
		@全ミッション共通ステージ開始時処理

		// カメラワークスタート(必要な場合)
		// 全体図
		chara カメラ設定 カットインカメラ \
			-c 1 \	
			-p 4000,20000,20000 -t 4000,12350,10750 \
			-r 450,2048,0 -f 12000 \
			-a 200 \
			-i 4 4 d:START_CAMERA_CHANGE_TIME d:START_CAMERA_CHANGE_TIME \
			-s 1

		chara delay ディレイ \
			-time d:START_CAMERA_CHANGE_TIME \
			-exec {
				chara カメラ設定 カットインカメラ -s -1
			}
	}

	// ------------------------------------
	// クリア時の処理
	// ------------------------------------
	proc ＶＲクリア時処理 {
		#if d:DEBUG_PRINT
			print 'clear'
		#endif

		// 強制モーションを発動
		@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_1 3808

		// クリア時にカメラアングルを変える
		chara カメラ設定 クリア時カメラ \
			-c 1 \
			-p -1660,2000,4500 -t 0,1070,970 \
			-r 150,1760,0 -f 4000 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}

	//------------------------------------------------------------
	// ステージ開始直後処理
	//------------------------------------------------------------
	proc ゲーム開始直後処理 {
		// 初期配置標的の起動（command ＶＲステージスタート の起動直後に行う必要がある）
		@ＶＲ初期配置標的グレネード２面設定
	}


	// ------------------------------------
	// パラメータ系の変更
	// ------------------------------------
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT
			print 'localvar_init'
		#endif

		//	的管理用各種フラグを初期化する
		$$b:標的セット数 = 0;
		$$i:標的フラグ = 0;

//		$$i:標的フラグＡ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NO_GHOST );
//		$$i:標的フラグＢ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST );
//		$$i:標的フラグＣ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    );
		$$i:標的フラグＤ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST                  | d:VR_TRG_WAIT );
//		$$i:標的フラグＥ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST | d:VR_TRG_WAIT );
//		$$i:標的フラグＦ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    | d:VR_TRG_WAIT );
//		$$i:標的フラグＧ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST                  | d:VR_TRG_WAIT | d:VR_TRG_CIRCLE );
//		$$i:標的フラグＨ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST | d:VR_TRG_WAIT | d:VR_TRG_CIRCLE );
//		$$i:標的フラグＩ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    | d:VR_TRG_WAIT | d:VR_TRG_CIRCLE );
//		$$i:標的フラグＪ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST                  | d:VR_TRG_WAIT | d:VR_TRG_NO_APPEAR_EF );
//		$$i:標的フラグＫ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST | d:VR_TRG_WAIT | d:VR_TRG_NO_APPEAR_EF );
//		$$i:標的フラグＬ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    | d:VR_TRG_WAIT | d:VR_TRG_NO_APPEAR_EF );
	}

	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT
			print 'status_set'
		#endif

		// 初期装備の設定
		// ライデン or スネークを選択
		if ( ($s:選択プレイヤー == ライデン) ||  ($s:選択プレイヤー == スネーク) ) {
			$w:武器弾数Ｒ[ d:武器:ＲＧＢ６ ] = 24
			$w:武器 = d:武器:ＲＧＢ６

		// タキシードスネーク or プリスキンを選択
		} else if ( ($s:選択プレイヤー == タキシードスネーク) || ($s:選択プレイヤー == プリスキン) ) {
			$w:武器弾数Ｒ[ d:武器:グレネード ] = 18
			$w:武器 = d:武器:グレネード

		// 前作スネークを選択
		} else if ( $s:選択プレイヤー == 前作スネーク ) {
			$w:武器弾数Ｒ[ d:武器:グレネード ] = 24
			$w:武器 = d:武器:グレネード
		}

	}

	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif

		command プラグイン自動ジャンプ
	}

	// 台登り
	// ------------------------------------
	proc ジャンプ設定 {
		#if d:DEBUG_PRINT
			print 'jump_set'
		#endif

		trap ky001 d:PLAYER \
			-mask 入る \
			-exec {
				@ジャンプ発動 ky001 1000 10
			}
	}



//###################################################################################
//									 的兵
//###################################################################################

	// ------------------------------------
	// グレネード２面
	// ------------------------------------
	// 敵兵や的の処理
	// ------------------------------------
	proc ＶＲ標的グレネード２面設定 {

		// ライデン or タキシードスネークを選択
		if ( ($s:選択プレイヤー == ライデン) ||  ($s:選択プレイヤー == タキシードスネーク) ) {

			command foreach -argc 2 -repeat 4 \
			-data { \
				// 的名,     ルート
				// act 1 ----------
				{ 移動的:01, d:M_R:ライデンルート１ }\
				{ 移動的:02, d:M_R:ライデンルート２ }\
				{ 移動的:03, d:M_R:ライデンルート３ }\
				{ 移動的:04, d:M_R:ライデンルート４ }\
			} \
			-exec { \
				if( $s:選択プレイヤー == タキシードスネーク ) {
					$$b:標的セット数 = $$b:標的セット数 + 1;
					if( $$b:標的セット数 % 2 ) {
						$$i:標的フラグ = ( $$i:標的フラグＤ | d:VR_TRG_HIDESTART );
					} else {
						$$i:標的フラグ = ( $$i:標的フラグＤ | d:VR_TRG_VISIBLESTART );
					}
				} else {
					$$i:標的フラグ = $$i:標的フラグＤ;
				}

				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグ \
					-route $2
			}

		// スネーク or プリスキンを選択
		} else if ( ($s:選択プレイヤー == スネーク) || ($s:選択プレイヤー == プリスキン) ) {

			command foreach -argc 2 -repeat 4 \
			-data { \
				// 的名,     ルート
				// act 1 ----------
				{ 移動的:01, d:M_R:スネークルート５ }\
				{ 移動的:02, d:M_R:スネークルート６ }\
				{ 移動的:03, d:M_R:スネークルート７ }\
				{ 移動的:04, d:M_R:スネークルート８ }\
			} \
			-exec { \
				if( $s:選択プレイヤー == プリスキン ) {
					$$b:標的セット数 = $$b:標的セット数 + 1;
					if( $$b:標的セット数 % 2 ) {
						$$i:標的フラグ = ( $$i:標的フラグＤ | d:VR_TRG_HIDESTART );
					} else {
						$$i:標的フラグ = ( $$i:標的フラグＤ | d:VR_TRG_VISIBLESTART );
					}
				} else {
					$$i:標的フラグ = $$i:標的フラグＤ;
				}

				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグ \
					-route $2
			}

		//	前作スネークを選択
		} else if ( $s:選択プレイヤー == 前作スネーク ) {

			command foreach -argc 2 -repeat 4 \
			-data { \
				// 的名,     ルート
				// act 1 ----------
				{ 移動的:01, d:M_R:前作スネークルート９   }\
				{ 移動的:02, d:M_R:前作スネークルート１０ }\
				{ 移動的:03, d:M_R:前作スネークルート１１ }\
				{ 移動的:04, d:M_R:前作スネークルート１２ }\
			} \
			-exec { \
				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグＤ \
					-route $2
			}

		}

	}

	proc ＶＲ初期配置標的グレネード２面設定 {
		// 共通標的 （主にライデン）
		mesg ＶＲ的共通 移動的:01 移動開始
		mesg ＶＲ的共通 移動的:02 移動開始
		mesg ＶＲ的共通 移動的:03 移動開始
		mesg ＶＲ的共通 移動的:04 移動開始
	}



//###################################################################################
//									 ＢＧＭ
//###################################################################################

	// ------------------------------------
	// ＢＧＭの設定
	// ------------------------------------
	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT
			print 'bgm_set'
		#endif

		chara ＢＧＭマネージャー ＢＧＭマネ
	}


//###################################################################################
//									 アイテム
//###################################################################################

	// ------------------------------------
	// アイテムの設定
	// ------------------------------------
	// 再発生が必要な時は以下のプロックの中を記述する
	// ------------------------------------
	proc アイテム取得時番号設定 $:ボックス名 {
		#if d:DEBUG_PRINT
			print 'item_no_set'
		#endif
	}
	// アイテムの設置
	// ------------------------------------
	proc アイテム設定 {
		#if d:DEBUG_PRINT
			print 'item_set'
		#endif

		// ライデン or スネークを選択
		if ( ($s:選択プレイヤー == ライデン) ||  ($s:選択プレイヤー == スネーク) ) {
				@A_グレネード_初期設置 グレネード弾薬 1500 0 -1000 0 なし 6

		// タキシードスネーク or プリスキンを選択
		} else if ( ($s:選択プレイヤー == タキシードスネーク) || ($s:選択プレイヤー == プリスキン) ) {
				@A_ＲＧＢ６_初期設置 ＲＧＢ６本体 0 0 -9500 0 なし 12

		}
		// 前作スネークはグレネード一筋
	}



//###################################################################################
//									 エフェクト
//###################################################################################

	// ------------------------------------
	// 光源関係
	// ------------------------------------
	// フォグ
	// ------------------------------------
	// キャラ用光源(マップの設置が終わってから設定することで、キャラだけに光を当てる)
	// ------------------------------------



//###################################################################################
//									 カメラ
//###################################################################################
	// ------------------------------------
	// カメラ関係の設定
	// ------------------------------------
	// ステージカメラ設定
	// ------------------------------------
	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'chara_camera & stage_camera_set'
		#endif

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0
		chara カメラ メインカメラ		-c 0 -l 2 -p 40
		chara カメラ クリア時カメラ		-c 0 -l 0 -p 10

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 400,2048,0 \
			-f 9000 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}
	// ステージ固有のカメラ設定
	// ------------------------------------
	proc 武器訓練グレネード２面カメラ設定 {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif
	}



//###################################################################################
//									 その他
//###################################################################################


// -----------------------------------------------------------------------------------
// 以下デバッグ専用proc
// -----------------------------------------------------------------------------------
// デバッグキャラ
// ------------------------------------
proc デバッグキャラセット {
	#if d:DEBUG_PRINT
		print 'debug_chara_set'
	#endif

	#if d:CHARA_CAMERA
		chara キャラカメラ 敵兵カメラ \
			-c d:TARGET_CHARA \
			-s -920,610,200 \
			-r -200,1024,0
	#endif

	#if d:SCREENSHOT
		chara スクリーンショット shot
	#endif

	#if d:USB_KEY
		chara USBキーボード実行 test \
			-e d:KBD_ESC {
				mesg プレイヤー d:PLAYER position -5500, -13000, -500
			} \
	#endif
}

