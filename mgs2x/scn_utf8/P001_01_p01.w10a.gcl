//以下は日本語の字あわせ

proc タイトルテロップＭＡＸ呼び出し {
	@タイトルテロップセット 35 85 \
							220 \
							60 \
							60
}

proc タイトルテロップセット \
		$:d00a0_メインタイトル座標Ｘ $:d00a0_メインタイトル座標Ｙ\
		$:d00a0_メインタイトルフェードインタイム \
		$:d00a0_メインタイトルウェイト \
		$:d00a0_メインタイトルフェードアウトタイム \
{
#if d:MGS2_DEMO
	if(1){
#else
	if(($w:タイトルメニュー設定 & d:TITLE_MENU_STORY_SEL_MASK) == d:TITLE_MENU_STORY_SEL_PLANT ) {
#endif
		//タイトル表示アリ
		// メインタイトル "ＭＧＳ２"
		chara ２Ｄスプライト表示 体験版メインタイトルテロップ \
			-tri 	terop \
			-x 		title_logo_blue_alp_ovl \
			-pos 	$:d00a0_メインタイトル座標Ｘ $:d00a0_メインタイトル座標Ｙ\
			-size	440 110 \
			-count  $:d00a0_メインタイトルフェードインタイム \
					$:d00a0_メインタイトルウェイト \
					$:d00a0_メインタイトルフェードアウトタイム
//			-flag 	d:FLAG_CENTER
	}
}

proc スタッフ脚本 {
#ifdef ENGLISH
// 英語版
	@スタッフ脚本セット 75 140 \
							30 \
							120 \
							40
#else
// 日本語版
	@スタッフ脚本セット (75+20) 140 \
							30 \
							120 \
							40
#endif
}

