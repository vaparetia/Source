proc 空設置 {
	chara 汎用空 デモ用空 \
		-pos 0 0 0 \
		-l  (32*80) \
		-f	(d:SKY_FLAGS_NO_MOVE|d:SKY_FLAGS_NO_BASE|d:SKY_FLAGS_NO_CLOUD|d:SKY_FLAGS_CAMERA) \
		-t 0 0 0 0 0 0 \
		-m 3 w10a_sky_wall1 128 128 128 0 0 \
			 w10a_sky_wall2 128 128 128 0 0 \
			 w10a_sky_wall3 107  80  75 0 0

	chara 太陽 ソル \
		-l (32*20) \
		-p 0 0 0 \    		//中心の位置
		-f -4700 350 -1600 \    //平行光源の-pと同じ値
		-a 9
}

proc 空オフ {
	mesg 汎用空 デモ用空 非表示
	mesg 太陽 ソル 非表示
}

proc 空オン {
	mesg 汎用空 デモ用空 表示
	mesg 太陽 ソル 表示
}

proc 海面セット {
	chara 巨大海面 seaseasea \
		-mipmap 3 100000 0 \
		-size 400000 400000 \
		-light_enable \
		-tex w10a_sea \
		w10a_sea03_256_alp_ovl \
		w10a_sea03_128_alp_ovl \
		w10a_sea03_64_alp_ovl \
		w10a_sea03_32_alp_ovl \
		-pos 60000,0,-200000
}

proc オイル海面セット {
	chara 巨大海面 oiloiloil \
		-mipmap 3 50000 0 \
		-size 400000 400000 \
		-light_enable \
		-tex w10c_oil_sea \
		w10c_oil_sea_256_alp_ovl \
		w10c_oil_sea_128_alp_ovl \
		w10c_oil_sea_64_alp_ovl \
		w10c_oil_sea_32_alp_ovl \
		-pos 60000,0,-200000

		// 最初は表示していない
		mesg 巨大海面 oiloiloil 表示状態 0
}

proc 海面遠くへ移動 {
	mesg 巨大海面 seaseasea 表示位置移動 0 400000 0
}

proc 海面東南へ移動 {
	mesg 巨大海面 seaseasea 表示位置移動 1500000 0 1500000
}

proc 海面元の位置へ移動 {
	mesg 巨大海面 seaseasea 表示位置移動 60000,0,-200000
}

proc オイル海面遠くへ移動 {
	mesg 巨大海面 oiloiloil 表示位置移動 0 400000 0
}

proc オイル海面東南へ移動 {
	mesg 巨大海面 oiloiloil 表示位置移動 1500000 0 1500000
}

proc オイル海面元の位置へ移動 {
	mesg 巨大海面 oiloiloil 表示位置移動 60000,0,-200000
}

proc 海面オン {
	mesg 巨大海面 seaseasea 表示状態 1
}

proc 海面オフ {
	mesg 巨大海面 seaseasea 表示状態 0
}

proc オイル海面オン {
	mesg 巨大海面 oiloiloil 表示状態 1
}

proc オイル海面オフ {
	mesg 巨大海面 oiloiloil 表示状態 0
}

// 2001/08/15 Uehara Masatoshi
proc 衝突防止警告灯 {

	// @プラント遠景モデルセットの値と連動しているので注意！
	eval($i:pos_x = -150000)
	eval($i:pos_y = 40000)
	eval($i:pos_z = 0)
	eval($i:rot_y = 3072)
	eval($i:red_a = 32)	// α
	eval($i:nml_a = 48)	// α

	// 赤色警告灯のパラメータ
	eval($s:red_mdl = rcm_l_msk)	// モデル名
	eval($i:red_r = 255)	// Ｒ
	eval($i:red_g = 0)		// Ｇ
	eval($i:red_b = 0)		// Ｂ
	eval($i:red_s = 400)	// スケール
	eval($i:red_f = 180)	// 明滅間隔

	// 通常警告灯のパラメータ
	eval($s:nml_mdl = w_bonbori)	// モデル名
	eval($i:nml_r = 96)		// Ｒ
	eval($i:nml_g = 208)	// Ｇ
	eval($i:nml_b = 96)		// Ｂ
	eval($i:nml_s = 250)	// スケール
	eval($i:nml_f = 0)		// 明滅間隔

	// Ａ脚からＤ脚まで
	chara プラント明滅ライト ＡＢＣＤ脚赤色警告灯 \
	-t $s:red_mdl \
	-p \
		 18000, 5000,       0, \	// Ａ脚
		 -9250, 5000,   16022, \	// Ａ脚
		 -9250, 5000,  -16022, \	// Ａ脚
		-42749, 5000,  -46043, \	// Ｂ脚
		-42749, 5000,  -14000, \	// Ｂ脚
		-70500, 5000,  -30021, \	// Ｂ脚
		-42749, 5000,  -74043, \	// Ｃ脚
		-70500, 5000,  -90064, \	// Ｃ脚
		-42749, 5000, -106086, \	// Ｃ脚
		  9250, 5000, -104064, \	// Ｄ脚
		  9250, 5000, -136107, \	// Ｄ脚
		-18500, 5000, -120086, \	// Ｄ脚
	-r $i:rot_y \
	-u $i:pos_x, $i:pos_y, $i:pos_z \
	-c $i:red_r, $i:red_g, $i:red_b, $i:red_a \
	-s $i:red_s \
	-f $i:red_f

	chara プラント明滅ライト ＡＢＣＤ脚通常警告灯 \
	-t $s:nml_mdl \
	-p \
		 -4065, -18000,   1684 \	// Ａ脚
		 -4065, -28500,  -1684 \	// Ａ脚
		-47930, -18000, -31705 \	// Ｂ脚
		-47930, -28500, -31705 \	// Ｂ脚
		-47934, -18000, -91748 \	// Ｃ脚
		-47934, -28500, -91748 \	// Ｃ脚
		  4065, -18000, -121770 \	// Ｄ脚
		  4065, -28500, -121770 \	// Ｄ脚
	-r $i:rot_y \
	-u $i:pos_x, $i:pos_y, $i:pos_z \
	-c $i:nml_r, $i:nml_g, $i:nml_b, $i:nml_a \
	-s $i:nml_s \
	-f $i:nml_f

	// Ｅ脚からＨ脚まで（Ｇ脚は除く）＋Ｋ脚
	chara プラント明滅ライト ＥＦＨＫ脚赤色警告灯 \
	-t $s:red_mdl \
	-p \
		 54037, 42198,  -90043 \	// Ｅ脚クレーン
		 45190, 30851,  -90043 \	// Ｅ脚クレーン
		 34249, 21750,  -90793 \	// Ｅ脚クレーン
		 69808, 12331, -111852 \	// Ｅ脚
		 69808, 12331,  -79734 \	// Ｅ脚
		 43190, 12331,  -79734 \	// Ｅ脚
		 43190, 12331, -111852 \	// Ｅ脚
		 33499,  5000,  -30022 \	// Ｆ脚
		 61249,  5000,  -46043 \	// Ｆ脚
		 61249,  5000,  -14000 \	// Ｆ脚
		-61249,  5000, -194129 \	// Ｈ脚
		-61249,  5000, -226172 \	// Ｈ脚
		-33499,  5000, -210150 \	// Ｈ脚
		 42749,   5000, -254172 \	// Ｋ脚
		 42749,   5000, -286215 \	// Ｋ脚
		 70499,   5000, -270193 \	// Ｋ脚
	-r $i:rot_y \
	-u $i:pos_x, $i:pos_y, $i:pos_z \
	-c $i:red_r, $i:red_g, $i:red_b, $i:red_a \
	-s $i:red_s \
	-f $i:red_f

	chara プラント明滅ライト ＥＦＨＫ脚通常警告灯 \
	-t $s:nml_mdl \
	-p \
		 56064, -18000,  -91748 \	// Ｅ脚
		 56064, -28500,  -91748 \	// Ｅ脚
		 47934, -18000,  -31905 \	// Ｆ脚
		 47934, -28500,  -31705 \	// Ｆ脚
		-47934, -18000, -208467 \	// Ｈ脚
		-47934, -28500, -208467 \	// Ｈ脚
		 56064, -18000, -268509 \	// Ｋ脚
