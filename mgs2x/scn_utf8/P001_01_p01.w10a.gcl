// 海面下の映り込み脚
proc プラント遠景映り込みモデルセット {
	command foreach -argc 4 -repeat 20 \
		 -data { \
			// 		名前				モデル名		Ｘ座標	Ｚ座標
			{ 映り込み_w10c_12a,     w10c_uturikomi_1,      0,       0 }
			{ 映り込み_w10c_14a,     w10c_uturikomi_1,  30022,  -51999 }
			{ 映り込み_w10c_16a,     w10c_uturikomi_1,  90064,  -51999 }
			{ 映り込み_w10c_18a,     w10c_uturikomi_1, 120086,       0 }
			{ 映り込み_w10c_20a,     w10c_uturikomi_1,  90064,   51999 }
			{ 映り込み_w10c_22a,     w10c_uturikomi_1,  30022,   51999 }
			{ 映り込み_w10c_25a,     w10c_uturikomi_1, 180129,       0 }
			{ 映り込み_w10c_h,       w10c_uturikomi_1, 210150,  -51999 }
			{ 映り込み_w10c_i,       w10c_uturikomi_1, 270193,  -51999 }
			{ 映り込み_w10c_j,       w10c_uturikomi_1, 300215,       0 }
			{ 映り込み_w10c_k,       w10c_uturikomi_1, 270193,   51999 }
			{ 映り込み_w10c_l,       w10c_uturikomi_1, 210150,   51999 }
			{ 映り込み_w10c_other01, w10c_uturikomi_1, 120086, -103997 }
			{ 映り込み_w10c_other02, w10c_uturikomi_1, 180129, -103997 }
			{ 映り込み_w10c_32c,     w10c_uturikomi_1, 180129,  103997 }
			{ 映り込み_w10c_32b,     w10c_uturikomi_1, 120086,  103997 }
			{ 映り込み_w10c_24a_1,   w10c_uturikomi_2,  60043,       0 }
			{ 映り込み_w10c_31a_1,   w10c_uturikomi_2, 240172,       0 }
			{ 映り込み_w10c_31a_2,   w10c_uturikomi_3, 240172,       0 }
			{ 映り込み_w10c_24a_2,   w10c_uturikomi_4,  60043,       0 }

		} \
		-exec {
			chara プットオブジェ $1 \
				-m $2 \
				-p ($3-150000), 40000, $4 \
				-r 0, 3072, 0 \
				-s 100,100,100 \
				-l d:LT2_NAME_PLANT \
				-f 0x0200
		}
}

