#else
// 日本語
#define TELOP_STAFF04 sr04j_alp_ovl
#define TELOP_STAFF05 sr05j_alp_ovl
#define TELOP_STAFF06 sr06j_alp_ovl
#define TELOP_STAFF18 sr18j_alp_ovl
