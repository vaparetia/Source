// include
// ------------------------------------
#include "5sec_bfr_demo.h"
#include "demo_vardef.h"
#include "demo_stdch.h"
#include "demo_stdch2.h"
#include "story.h"
#include "sload.h"

#if d:USB_KEY
	#include "usbkbd.h"
#endif

#if d:PLANT_DEMO_ALL_SKIP
	#define		DEMO_SKIP_ENABLE 1
#else
	#define		DEMO_SKIP_ENABLE 0
#endif

// マップ設定
// ------------------------------------

chara マップ プラント遠景ほか -h d:HZX_NAME -l d:LT2_NAME_100

command マップ設定 プラント遠景ほか -set {

//	デモ環境かゲーム環境かで起動を読み分ける。
// ------------------------------------
#if d:MGS2_DEMO

chara デモアクトデバッグ demodebug  -i t:p001_01_p01 -d 'p001_01_p01' -l   \
		-p ベラザノ橋オフ ベラザノ橋オン \
		   プラント海中モデルオフ プラント海中モデルオン \
		   プラント遠景モデルオフ１ プラント遠景モデルオン１ \
		   プラント遠景モデルオフ２ プラント遠景モデルオン２ \
		   プラント遠景モデルオン３ プラント遠景モデルオフ３ \
		   プラント遠景映り込みモデルオン１ プラント遠景映り込みモデルオフ１ \
		   プラント遠景映り込みモデルオン２ プラント遠景映り込みモデルオフ２ \
		   プラント遠景映り込みモデルオン３ プラント遠景映り込みモデルオフ３ \
		   海面遠くへ移動 海面東南へ移動 海面元の位置へ移動 \
		   オイル海面遠くへ移動 オイル海面東南へ移動 オイル海面元の位置へ移動 \
		   海面オン 海面オフ オイル海面オン オイル海面オフ \
		   衝突防止警告灯オフ 衝突防止警告灯オン \
		   衝突防止警告灯遠景版オフ 衝突防止警告灯遠景版オン \
		   空オフ 空オン タイトルテロップＭＡＸ呼び出し \
		   スタッフ監督 スタッフ社長 スタッフ新川 スタッフ松花 \
		   スタッフ豊田 スタッフ村岡 スタッフ村中 スタッフハリー \
		   スタッフ毛利 スタッフ植原 スタッフ水谷 スタッフ脚本


eval($s:d_num = P001_01_p01)


#else

// 実際の再生
//-----------------------------------------------------------
	// 実際のデモ再生の方も、ストーリーフラグで変える
	if($w:p_story == d:ST:P001_01_P01オープニング潜入１ポリゴンデモ１開始) {
		print '$w:p_story = ST:P001_01_P01オープニング潜入１ポリゴンデモ１開始'

		/* ライデン、プラントへの潜入シーン　旧カット２３まで */

		// デモ特有の変数代入
		eval($s:d_num = P001_01_p01)

		@デモモデル差し替え処理
		proc デモ再生_P001_01_p01 {
			chara demo デモ再生 \
				-i t:p001_01_p01 \
					-p ベラザノ橋オフ ベラザノ橋オン \
				   プラント海中モデルオフ プラント海中モデルオン \
				   プラント遠景モデルオフ１ プラント遠景モデルオン１ \
				   プラント遠景モデルオフ２ プラント遠景モデルオン２ \
				   プラント遠景モデルオン３ プラント遠景モデルオフ３ \
				   プラント遠景映り込みモデルオン１ プラント遠景映り込みモデルオフ１ \
				   プラント遠景映り込みモデルオン２ プラント遠景映り込みモデルオフ２ \
				   プラント遠景映り込みモデルオン３ プラント遠景映り込みモデルオフ３ \
				   海面遠くへ移動 海面東南へ移動 海面元の位置へ移動 \
				   オイル海面遠くへ移動 オイル海面東南へ移動 オイル海面元の位置へ移動 \
				   海面オン 海面オフ オイル海面オン オイル海面オフ \
				   衝突防止警告灯オフ 衝突防止警告灯オン \
				   衝突防止警告灯遠景版オフ 衝突防止警告灯遠景版オン \
				   空オフ 空オン タイトルテロップＭＡＸ呼び出し \
				   スタッフ監督 スタッフ社長 スタッフ新川 スタッフ松花 \
				   スタッフ豊田 スタッフ村岡 スタッフ村中 スタッフハリー \
				   スタッフ毛利 スタッフ植原 スタッフ水谷 スタッフ脚本 \
				-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
				-next P001_01_p01終了
		}

		@デモ再生_P001_01_p01
	}

#endif


// 以下、諸々セット
//-----------------------------------------------------------
	// デモキャンセルは全てのデモで共通につかう
	@常駐キャラ設定						// stdch.hで定義

	chara デモキャンセルチェック デモキャンセル \
		-p demo_cancel

	@シネマスクリーンセット

	// デモによる必要なローテーション、オフセット、あるいはモデルそれ自身
	// 確認してセットすること。
	@ベラザノ橋セット
	@プラント海中モデルセット
	@水中セット

	@プラント遠景モデルセット
	@プラント遠景映り込みモデルセット
	@空設置
	@フォグ設定
	@海面セット
	@オイル海面セット
	@衝突防止警告灯
	@衝突防止警告灯遠景版

	@エフェクト設定
	@デバッグキャラセット

} // 「command マップ設定 プラント遠景ほか」の閉じカッコ

// ====================================
// 初期マップ表示
// ====================================
	command マップ表示 -show プラント遠景ほか



// 各proc設定
//-------------------------------------------------------------------------------------
// デモ環境で共用のプロック
//-----------------------------------------------------------
	proc null {}

	proc demo_cancel {
		command StreamStopAll
	}

	proc restart_proc {
		restart
	}

	proc P001_01_p01終了 {

		@デモ終了時シネマスクリーンオフ

		mesg デモキャンセルチェック デモキャンセル kill

		#if d:DEMO_SKIP_ENABLE
			if ($1 == 1){
				print '$w:p_story = d:ST:P001_01_P01オープニング潜入１ポリゴンデモ１終了'
				eval($w:p_story = d:ST:P001_01_P02オープニング潜入１ポリゴンデモ２終了)
			} else {
				print '$w:p_story = d:ST:P001_01_P01オープニング潜入１ポリゴンデモ１終了'
				eval($w:p_story = d:ST:P001_01_P01オープニング潜入１ポリゴンデモ１終了)
			}
		#else
			print '$w:p_story = d:ST:P001_01_P01オープニング潜入１ポリゴンデモ１終了'
			eval($w:p_story = d:ST:P001_01_P01オープニング潜入１ポリゴンデモ１終了)
		#endif

		chara delay ディレイ \
			-time 1 \
			-exec{
				@mv_P001_01_P02_0
			}
	}

// シネマスクリーン
proc シネマスクリーンセット {
	chara シネマスクリーン シネマ \
		-top d:CINEMA_BELT_UPPER \
		-bottom d:CINEMA_BELT_LOWER \
		-ftime 60	//デフォルト値（ゼロは駄目）
	mesg シネマスクリーン シネマ フェードアウト 1
}


// 全マップ共通
//-----------------------------------------------------------

	// フォグ
	// ------------------------------------
	proc フォグ設定 {
		chara フォグ 霧 \
			-c 39,61,65 \
			-n (-1500000) \
			-f (3000000) \
			-z 					// ファークリップ機能追加（山下）
	}

	// エフェクト関係
	// -----------------------------------
	proc エフェクト設定 {
			chara Ｚフォーカス管理 Z_manager
	}


// 各マップ別設定
// ------------------------------------
// プラント海中モデル
	proc プラント海中モデルセット {
		chara プットオブジェ 海中グラデ１ \
			-m w10b_01 -r 0,0,0 -p 0,0,0 -s 100,100,100 -l d:LT2_NAME_100
		chara プットオブジェ 海中グラデ２ \
			-m w10b_02 -r 0,0,0 -p 0,0,0 -s 100,100,100 -l d:LT2_NAME_100
		chara プットオブジェ 海中グラデ３ \
			-m w10b_03 -r 0,0,0 -p 0,0,0 -s 100,100,100 -l d:LT2_NAME_100
		chara プットオブジェ 海中グラデ４ \
			-m w10b_04 -r 0,0,0 -p 0,0,0 -s 100,100,100 -l d:LT2_NAME_100
		chara プットオブジェ 海中グラデ５ \
			-m w10b_05 -r 0,0,0 -p 0,0,0 -s 100,100,100 -l d:LT2_NAME_100
		chara プットオブジェ 海中グラデ６ \
			-m w10b_06 -r 0,0,0 -p 0,0,0 -s 100,100,100 -l d:LT2_NAME_100
		chara プットオブジェ 海中グラデ７ \
			-m w10b_07 -r 0,0,0 -p 0,0,0 -s 100,100,100 -l d:LT2_NAME_100
		chara プットオブジェ 海中グラデ８ \
			-m w10b_08 -r 0,0,0 -p 0,0,0 -s 100,100,100 -l d:LT2_NAME_100

		chara プットオブジェ 網 \
			-m w10b_1 -r 0,0,0 -p 0,0,0 -s 100,100,100 -l d:LT2_NAME_100
		chara プットオブジェ ドック部分 \
			-m w10b_2 -r 0,0,0 -p 0,0,0 -s 100,100,100 -l d:LT2_NAME_100
	}

proc プラント海中モデルオフ {
	mesg プットオブジェ 海中グラデ１ off
	mesg プットオブジェ 海中グラデ２ off
	mesg プットオブジェ 海中グラデ３ off
	mesg プットオブジェ 海中グラデ４ off
	mesg プットオブジェ 海中グラデ５ off
	mesg プットオブジェ 海中グラデ６ off
	mesg プットオブジェ 海中グラデ７ off
	mesg プットオブジェ 海中グラデ８ off

	mesg プットオブジェ 網 off
	mesg プットオブジェ ドック部分 off
}

proc プラント海中モデルオン {
	mesg プットオブジェ 海中グラデ１ on
	mesg プットオブジェ 海中グラデ２ on
	mesg プットオブジェ 海中グラデ３ on
	mesg プットオブジェ 海中グラデ４ on
	mesg プットオブジェ 海中グラデ５ on
	mesg プットオブジェ 海中グラデ６ on
	mesg プットオブジェ 海中グラデ７ on
	mesg プットオブジェ 海中グラデ８ on

	mesg プットオブジェ 網 on
	mesg プットオブジェ ドック部分 on
}

//###################################################################################
//									 水中処理
//###################################################################################

	proc 水中セット {
/*
		command 新プラグイン水中 \
			-z 1
		command 新水中設定 \
			-horizon -48000 \
			-motion rai_swim \
			-flag d:WATER_FLAG_AUTO_ROTATE
		chara 水中カメラ ゆらぎマン \
			-col 90 128 130 \
			-warp 1
*/
		command 水位設定 -lv 0
		chara カメラ泡 泡ぶくマン -n 2
		chara カメラダスト ダストマン -n 1

	}


// プラント全景
// ------------------------------------
proc ベラザノ橋セット {
	// 橋モデル
	chara プットオブジェ ベラザノ橋_w10a_6 \
		-m w10a_6 -r 0,0,0 -p 0,0,0 \
		-s 10000,10000,10000 -l d:LT2_NAME_100 \
		-f 0x0010

	// 地面モデル
	chara プットオブジェ ベラザノ橋_w10a_7 \
		-m w10a_7 -r 0,0,0 -p 0,0,0 \
		-s 10000,10000,10000 -l d:LT2_NAME_100 \
		-f 0x0010

	chara プットオブジェ ベラザノ橋_w10a_1 \
		-m w10a_1 -r 0,0,0 -p 0,0,0 \
		-s 10000,10000,10000 -l d:LT2_NAME_100 \
		-f 0x0010
	chara プットオブジェ ベラザノ橋_w10a_2 \
		-m w10a_2 -r 0,0,0 -p 0,0,0 \
		-s 10000,10000,10000 -l d:LT2_NAME_100 \
		-f 0x0010
	chara プットオブジェ ベラザノ橋_w10a_3 \
		-m w10a_3 -r 0,0,0 -p 0,0,0 \
		-s 10000,10000,10000 -l d:LT2_NAME_100 \
		-f 0x0010
	chara プットオブジェ ベラザノ橋_w10a_4 \
		-m w10a_4 -r 0,0,0 -p 0,0,0 \
		-s 10000,10000,10000 -l d:LT2_NAME_100 \
		-f 0x0010
	chara プットオブジェ ベラザノ橋_w10a_5 \
		-m w10a_5 -r 0,0,0 -p 0,0,0 \
		-s 10000,10000,10000 -l d:LT2_NAME_100 \
		-f 0x0010

	// これだけ１０倍表示する。
	chara プットオブジェ ベラザノ橋_w10a_8 \
		-m w10a_8 -r 0,0,0 -p 0,0,0 \
		-s 1000,1000,1000 -l d:LT2_NAME_100 \
		-f 0x0010
}

proc ベラザノ橋オフ {
	mesg プットオブジェ ベラザノ橋_w10a_1 off
	mesg プットオブジェ ベラザノ橋_w10a_2 off
	mesg プットオブジェ ベラザノ橋_w10a_3 off
	mesg プットオブジェ ベラザノ橋_w10a_4 off
	mesg プットオブジェ ベラザノ橋_w10a_5 off
	mesg プットオブジェ ベラザノ橋_w10a_6 off
	mesg プットオブジェ ベラザノ橋_w10a_7 off
	mesg プットオブジェ ベラザノ橋_w10a_8 off
	mesg プットオブジェ ベラザノ橋_w10a_9 off
}

proc ベラザノ橋オン {
	mesg プットオブジェ ベラザノ橋_w10a_1 on
	mesg プットオブジェ ベラザノ橋_w10a_2 on
	mesg プットオブジェ ベラザノ橋_w10a_3 on
	mesg プットオブジェ ベラザノ橋_w10a_4 on
	mesg プットオブジェ ベラザノ橋_w10a_5 on
	mesg プットオブジェ ベラザノ橋_w10a_6 on
	mesg プットオブジェ ベラザノ橋_w10a_7 on
	mesg プットオブジェ ベラザノ橋_w10a_8 on
	mesg プットオブジェ ベラザノ橋_w10a_9 on
}

proc プラント遠景モデルセット {
	// プラント座標オフセット値
	eval($i:d001p01_plt_x = -150000)
	eval($i:d001p01_plt_y = 40000)
	eval($i:d001p01_plt_z = 0)

	// プラント回転オフセット値。Ｙのみ必要。
	eval($i:d001p01_rot_y = 3072)

#if 0
	chara プットオブジェ プラント遠景 \
		-m w10a_plant00 -r 0,0,0 -p 0,0,0 \
		-s 1000,1000,1000 -l d:LT2_NAME_100 \
		-f 0x0010
#else
	command foreach -argc 2 -repeat 34 \
		 -data { \
			{ 全景_w10c_12a,     w10c_12a }
			{ 全景_w10c_13a,     w10c_13a }
			{ 全景_w10c_14a,     w10c_14a }
			{ 全景_w10c_15a,     w10c_15a }
			{ 全景_w10c_16a,     w10c_16a }
			{ 全景_w10c_17a,     w10c_17a }
			{ 全景_w10c_18a,     w10c_18a }
			{ 全景_w10c_19a,     w10c_19a }
			{ 全景_w10c_20a,     w10c_20a }
			{ 全景_w10c_20b,     w10c_20b }
			{ 全景_w10c_21a,     w10c_21a }
			{ 全景_w10c_22a,     w10c_22a }
			{ 全景_w10c_23a,     w10c_23a }
			{ 全景_w10c_24a,     w10c_24a }
			{ 全景_w10c_25a,     w10c_25a }
			{ 全景_w10c_31a,     w10c_31a }
			{ 全景_w10c_gh,      w10c_gh  }
			{ 全景_w10c_gl,      w10c_gl  }
			{ 全景_w10c_h,       w10c_h   }
			{ 全景_w10c_hi,      w10c_hi  }
			{ 全景_w10c_i,       w10c_i   }
			{ 全景_w10c_ij,      w10c_ij  }
			{ 全景_w10c_j,       w10c_j   }
			{ 全景_w10c_jk,      w10c_jk  }
			{ 全景_w10c_k,       w10c_k   }
			{ 全景_w10c_kl,      w10c_kl  }
			{ 全景_w10c_l,       w10c_l   }
			{ 全景_w10c_crane,   w10c_crane }
			{ 全景_w10c_other00, w10c_other00 }
			{ 全景_w10c_other01, w10c_other01 }
			{ 全景_w10c_other02, w10c_other02 }
			{ 全景_w10c_32a,     w10c_32a }
			{ 全景_w10c_32b,     w10c_32b }
			{ 全景_w10c_32c,     w10c_32c }
		} \
		-exec {
			chara プットオブジェ $1 \
				-m $2 \
				-p $i:d001p01_plt_x, $i:d001p01_plt_y, $i:d001p01_plt_z \
				-r 0, $i:d001p01_rot_y, 0 \
				-s 100,100,100 \
				-l d:LT2_NAME_PLANT \
				-f 0x0200
		}
#endif

}

