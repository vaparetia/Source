proc 衝突防止警告灯オン{
	mesg プラント明滅ライト ＡＢＣＤ脚赤色警告灯 ＯＮ
	mesg プラント明滅ライト ＡＢＣＤ脚通常警告灯 ＯＮ
	mesg プラント明滅ライト ＥＦＨＫ脚赤色警告灯 ＯＮ
	mesg プラント明滅ライト ＥＦＨＫ脚通常警告灯 ＯＮ
	mesg プラント明滅ライト ＩＪＬ脚赤色警告灯 ＯＮ
	mesg プラント明滅ライト ＩＪＬ脚通常警告灯 ＯＮ
	mesg プラント明滅ライト ＳＨＬ１２赤色警告灯 ＯＮ
	mesg プラント明滅ライト ＳＨＬ１２通常警告灯 ＯＮ
	mesg プラント明滅ライト 浮き橋１２赤色警告灯 ＯＮ
	mesg プラント明滅ライト 浮き橋１２通常警告灯 ＯＮ
	mesg プラント明滅ライト ＡＢＣＤ連絡橋通常警告灯 ＯＮ
	mesg プラント明滅ライト ＤＥＦＡ連絡橋通常警告灯 ＯＮ
	mesg プラント明滅ライト ＩＪＫＬ連絡橋通常警告灯 ＯＮ
}

proc 衝突防止警告灯オフ{
	mesg プラント明滅ライト ＡＢＣＤ脚赤色警告灯 ＯＦＦ
	mesg プラント明滅ライト ＡＢＣＤ脚通常警告灯 ＯＦＦ
	mesg プラント明滅ライト ＥＦＨＫ脚赤色警告灯 ＯＦＦ
	mesg プラント明滅ライト ＥＦＨＫ脚通常警告灯 ＯＦＦ
	mesg プラント明滅ライト ＩＪＬ脚赤色警告灯 ＯＦＦ
	mesg プラント明滅ライト ＩＪＬ脚通常警告灯 ＯＦＦ
	mesg プラント明滅ライト ＳＨＬ１２赤色警告灯 ＯＦＦ
	mesg プラント明滅ライト ＳＨＬ１２通常警告灯 ＯＦＦ
	mesg プラント明滅ライト 浮き橋１２赤色警告灯 ＯＦＦ
	mesg プラント明滅ライト 浮き橋１２通常警告灯 ＯＦＦ
	mesg プラント明滅ライト ＡＢＣＤ連絡橋通常警告灯 ＯＦＦ
	mesg プラント明滅ライト ＤＥＦＡ連絡橋通常警告灯 ＯＦＦ
	mesg プラント明滅ライト ＩＪＫＬ連絡橋通常警告灯 ＯＦＦ
}

proc 衝突防止警告灯遠景版 {
	// @プラント遠景モデルセットの値と連動しているので注意！
	eval($i:pos_x = -150000)
	eval($i:pos_y = 40000)
	eval($i:pos_z = 0)
	eval($i:rot_y = 3072)

	// 赤色警告灯のパラメータ
	eval($s:red_mdl = svc_bonbori_r)	// モデル名
	eval($i:red_r = 128)	// Ｒ
	eval($i:red_g = 24)		// Ｇ
	eval($i:red_b = 0)		// Ｂ
	eval($i:red_a = 32)		// α
	eval($i:red_s = 1400)	// スケール
	eval($i:red_f = 180)	// 明滅間隔

	// 通常警告灯のパラメータ
	eval($s:nml_mdl = svc_bonbori_y)	// モデル名
	eval($i:nml_r = 96)		// Ｒ
	eval($i:nml_g = 128)	// Ｇ
	eval($i:nml_b = 96)		// Ｂ
	eval($i:nml_a = 32)	// α
	eval($i:nml_s = 700)	// スケール
	eval($i:nml_f = 0)		// 明滅間隔

	// Ａ脚からＤ脚まで
	chara プラント明滅ライト ＡＢＣＤ脚赤色警告灯遠景版 \
	-t $s:red_mdl \
	-p \
		 18000, 5000,       0, \	// Ａ脚
