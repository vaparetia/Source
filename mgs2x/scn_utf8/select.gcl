			'snake_demo_end(w11a)'        load_snake_demo_end
			'title demo end (w12a)'       load_title_demo_end
			'before vamp demo (w14a)'     load_before_vamp_demo
			'after vamp demo (w14a)'      load_after_vamp_demo
			'after fortune demo (w15a)'   load_after_fortune_demo_w15a
			'peter sdemo (w16a)'          load_peter_sdemo
			'bomb event start (w16b)'     load_bomb_event_start
