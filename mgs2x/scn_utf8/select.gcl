}

//$f:rft_enter_codec_debug_mode_tが立っていたら担架変無線デバッグモードに入ります。
//$f:rft_enter_codec_debug_mode_pが立っていたら不乱闘遍無線デバッグモードに入ります。
if((!$f:rft_enter_codec_debug_mode_t) && (!$f:rfp_enter_codec_debug_mode_p) ){
	if ($b:res_mode == d:RES_SELECT) {
		// 一番最初はライデンとスネークの選択
		chara select name -s {
			'select_tanker(res_snake)'	load_res_snake
			'select_plant(res_raiden)'	load_res_raiden
			'select_mission'			mission_player_select
			'select_snake_tales'		snake_tales_select
			'n_title' 					mv_init_n_title_0


			/* パッドセレクト XBOX用 */
			'pad_select(default)' set_padtype0
			'pad_select(type1)\n\nSubject   BK/WH-toggle\nAction/Lockon   A-press\nSquat   Y-toggle' set_padtype1
			'pad_select(type2)\n\nSubject   L3-toggle\nAction/Lockon   A-press\nSquat   Y-toggle' set_padtype2
			'pad_select(type3)\n\nSubject   A-press\nLockon   L3-press\nSquat   BK/WH-toggle' set_padtype3
			'pad_select(type4)\n\nSubject   A-press\nPunch   X-press\nWeapon   B-Release\nLockon   WH-press\nSquat   BK-toggle' set_padtype4


			'ending' mv_ending_0
			'boss_survival'				load_boss_survival
			'start_e_extreme' 			start_e_extreme
		#ifdef d:TGS2001F
			'TGS_2001f_special' 		mv_tgs2001f_special
		#endif
			'vox_test' mv_vox_test
			'memcard' mv_memcard
			'select_english' set_lang_english
			'select_french' set_lang_french
			'select_german' set_lang_german
			'select_italian' set_lang_italian
			'select_spanish' set_lang_spanish

			'low_poly_t00a1D'			mv_lowpoly_t00a1D
			'low_poly_t04a1D'			mv_lowpoly_t04a1D
			'low_poly_t05a1D'			mv_lowpoly_t05a1D
			'low_poly_t12a1D'			mv_lowpoly_t12a1D
			'low_poly_p010_01_p01'		mv_lowpoly_p010_01_p01
			'low_poly_p012_01_p01'		mv_lowpoly_p012_01_p01
			'low_poly_p080_03_p02'		mv_lowpoly_p080_03_p02
			'low_poly_p082_01_p01'		mv_lowpoly_p082_01_p01
		};
	} else if ($b:res_mode == d:RES_SNAKE) {
		// 常駐をスネークにしたときの選択

		eval($s:n_title_ゲームモード = タンカー編);
		chara select name -s {
			'stage' snake_stage_select
			'story' snake_story_select
		#if d:MGS2_SCN
			'Tanker:CODEC_motion_debug' enter_codec_debug_mode_t	//めくるめく無線デバッグモードへの扉
		#endif
			'return_select' load_select
		};
		$b:res_mode_back = d:RES_SELECT; /*一つ前に戻るため前のステータス */
	} else if ($b:res_mode == d:SNAKE_STAGE) {
		chara select name -s {
//			'title' mv_init_title_0
			'special' mv_init_special_0
			'config_veryeasy' config_veryeasy_t
			'config_easy' config_easy_t
			'config_normal' config_normal_t
			'config_hard' config_hard_t
			'config_veryhard' config_veryhard_t
			'config_e_extreme' config_e_extreme_t
			'config_itemfull' config_fullitem_p
			'config_debug' config_debug_t
			'config_end_if_found'         config_end_if_found
			'config_not_end_if_found'     config_not_end_if_found
			'start(veryeasy)' trialgame_start_veryeasy
			'start(easy)' trialgame_start_easy
			'start(normal)' trialgame_start_normal
			'start(hard)' trialgame_start_hard
			'start(veryhard)' trialgame_start_veryhard
		#ifdef d:MGS2_TANKER
			'tanker_demo' mv_tanker_demos_0
			'w00a_paddemo' mv_init_w00a_0
			'w00a' mv_init_w00a_1
			'w00b' mv_w01e_w00b_0
			'w00c' mv_w01e_w00c_0
			'w01a' mv_w00a_w01a_0
			'w01f' mv_w01a_w01f_1x
			'w01b' mv_w01f_w01b_1
			'w01c' mv_w01b_w01c_0
			'w01d' mv_w01c_w01d_0
			'w01e' mv_w01d_w01e_0
			'w02a' mv_w01f_w02a0_0
			'w03a' mv_w02a3_w03a_0
			'w03b' mv_w03a_w03b_0
			'w04a' mv_init_w04a_0
			'w04b' mv_init_w04b_0
			'w04c' mv_init_w04c_0
		#endif
			'return_select' restart_proc
		};
		$b:res_mode_back = d:RES_SNAKE; /*一つ前に戻るため前のステータス */
	} else if ($b:res_mode == d:SNAKE_STORY) {
		chara select name -s {
			'vs_orga' vs_orga
			'after_orga' mv_story_set_afterorga
			'corridor' mv_story_corridor
			'hold' mv_story_hold
//			'title' mv_init_title_0
			'special' mv_init_special_0
			'config_veryeasy' config_veryeasy_t
			'config_easy' config_easy_t
			'config_normal' config_normal_t
			'config_hard' config_hard_t
			'config_veryhard' config_veryhard_t
			'config_e_extreme' config_e_extreme_t
			'config_itemfull' config_fullitem_p
			'config_debug' config_debug_t
			'config_end_if_found'         config_end_if_found
			'config_not_end_if_found'     config_not_end_if_found
			'start(veryeasy)' trialgame_start_veryeasy
			'start(easy)' trialgame_start_easy
			'start(normal)' trialgame_start_normal
			'start(hard)' trialgame_start_hard
			'start(veryhard)' trialgame_start_veryhard
		#ifdef d:MGS2_TANKER
		#endif
		#if d:MGS2_SCN
			'CODEC_motion_debug' enter_codec_debug_mode_t	//めくるめく無線デバッグモードへの扉
		#endif
			'return_select' restart_proc
		};
		$b:res_mode_back = d:RES_SNAKE; /*一つ前に戻るため前のステータス */

	} else if ($b:res_mode == d:RES_RAIDEN) {
		// 常駐をライデンにしたときの選択

		eval($s:n_title_ゲームモード = プラント編);
		chara select name -s {
			'stage' raiden_stage_select
			'story' raiden_story_select
			'demo_test' mv_demotest
			'movie test' mv_movietest
			'boss_check' mv_boss_check
			'count_zero_test 1' mv_bombtest1
			'count_zero_test 2' mv_bombtest2
			'count_zero_test 3' mv_bombtest3
		#if d:MGS2_SCN
			#ifdef d:EU_TRIAL
			#else
	//ＸＸＸＸＸＸＸＸＸＸＸＸＸＸＸＸＸ
				'PLANT:CODEC_motion_debug' enter_codec_debug_mode_p	//めくるめく無線デバッグモードへの扉
			#endif
		#endif
			'return_select' restart_proc
		};
		$b:res_mode_back = d:RES_SELECT; /*一つ前に戻るため前のステータス */
	} else if ($b:res_mode == d:RAIDEN_STAGE) {
		// 常駐をライデンにしたときの選択
		chara select name -s {
		#ifdef d:MGS2_PLANT
			'plant_demo' mv_plant_demos_0
			'config_veryeasy' config_veryeasy_p
			'config_easy' config_easy_p
			'config_normal' config_normal_p
			'config_hard' config_hard_p
			'config_veryhard' config_veryhard_p
			'config_e_extreme' config_e_extreme_p
			'config_debug' config_debug_p
			'config_cardlevel_5' config_card5_p
			'config_itemfull' config_fullitem_p
			'config_end_if_found'         config_end_if_found
			'config_not_end_if_found'     config_not_end_if_found
			'story_set_bombstart' mv_story_set_bombstart
			'story_set_b_sensor_get' mv_story_set_b_sensor_get
			'story_set_vs_fortune_end' mv_story_set_vs_fortune_end
			'story_set_ninjademo_end' mv_story_set_ninjademo_end
			'story_set_biometrix' mv_story_biometrix
			'hostage_1st' hostage_1st
			'hostage_2nd' hostage_2nd
			'hostage_beauties' hostage_beauties
			'hostage_old_beauties' hostage_old_beauties
			'hostage_beasts' hostage_beasts
			'story_set_ames_died' mv_story_set_ames_died
			'w11a' mv_init_w11a0_0
			'w11b' mv_w12a_w11b_0
			'w11c' mv_w11b_w11c_0
			'w12a' mv_w11a2_w12a_0
			'w12b' mv_w12a_w12b0_0
			'w12c' mv_w12b0_w12a_0
			'w13a-1' mv_w12b0_w13a_0
			'w13a-2' mv_w14a_w13a_0
			'w13b' mv_init_w13b_0
			'w14a' mv_w13a_w14a_0
			'w15a-1' mv_w14a_w15a_0
			'w15a-2' mv_w16a_w15a_0
			'w15b' mv_init_w15b_0
			'w16a' mv_w15a_w16a_0
			'w17a-1' mv_w16a_w17a_0
			'w17a-2' mv_w18a_w17a_0
			'w18a' mv_w17a_w18a_0
			'w19a-1' mv_w18a_w19a_0
			'w19a-2' mv_w18a_w19a_1
			'w19a-3' mv_w20a0_w19a_0
			'w20a' mv_w19a_w20a0_0
			'w20a_2' mv_w32a_w20a2_0
			'w20b' mv_w20a1_w20b_0
			'w21a-1'  mv_w20a0_w21a_0
			'w21a-2' mv_w22a0g_w21a_0
			'w21a-3' mv_w24a_w21a_0
			'w21b' mv_init_w21b_0
			'w22a' mv_w23a_w22a0h_0
			'w23a-1' mv_w12b0_w23a_0
			'w23a-2' mv_w22a0h_w23a_0
			'w23a-3' mv_w22a1c_w23a_0
			'w23b' mv_init_w23b_0
			'w24a' mv_w21a_w24a_0
			'w24b' mv_w24a_w24b_0
			'w24b_caution' mv_caution_w24b
			'w24c' mv_w24b_w24c_0
			'w24c_eavesdrop' mv_demo_w24c_0
			'w24c_ocelot_approaching_fast!!!!'mv_demo_w24c_1
			'w24d' mv_w24a_w24d_0
			'w25a' mv_w18a_w25a_0
			'w25a harrier' mv_w18a_w25a_1
			'w25b' mv_w25a_w25b_0
			'w25c' mv_w25b_w25c_0
			'w28a' mv_w25c_w28a_0
			'w31a' mv_w25c_w31a_0
			'w31b' mv_w31a_w31b_0
			'w31c' mv_w31b_w31c0_0
			'w31d' mv_w31b_w31d_0
			'w32a' mv_w28a_w32a_0
			'w32b' mv_w32a_w32b_0
			'w41a-1' mv_w24d_w41a_0
			'w41a-AFTER_GOUMON' mv_init_GOUMONGO
			'w42a' mv_w41a_w42a_0
			'w43a' mv_w42a_w43a_0
			'w44a' mv_w43a_w44a_0
			'w45a' mv_w44a_w45a_0
			'w46a' mv_w45a_w46a_0
			'VS_METAL' mv_init_VSMETAL
			'w51a' mv_w46a_w51a_0
			'w61a' mv_init_w61a_0
			'wmovie' mv_init_wmovie_0
		#endif
			'return_select' restart_proc
		};
		$b:res_mode_back = d:RES_RAIDEN; /*一つ前に戻るため前のステータス */
	} else if ($b:res_mode == d:RAIDEN_STORY) {
		// 常駐をライデンにしたときの選択
		chara select name -s {
		#ifdef d:MGS2_PLANT
			'config_veryeasy'             config_veryeasy_p
			'config_easy'                 config_easy_p
			'config_normal'               config_normal_p
			'config_hard'                 config_hard_p
