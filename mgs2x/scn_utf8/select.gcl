/* パッドタイプ設定*/
proc set_padtype0 {
	$b:プレイヤーパッドタイプ = 0 ;
	chara delay リスタートディレイ \
		-time 30 \
		-exec {
			restart -save
		}
}
proc set_padtype1 {
	$b:プレイヤーパッドタイプ = 1 ;
	chara delay リスタートディレイ \
		-time 30 \
		-exec {
			restart -save
		}
}
