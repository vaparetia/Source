resource オプションの説明 {
VIB:
	'Turn the vibration ON / OFF.',
// RADはダミーデータ
RAD:
	'Select radar type.',
BLD:
	'Turn blood display ON / OFF.',
SND:
	'Select STEREO / MONAURAL sound.',
P5_1CH:
	'Certain cut scenes will be in Dolby Digital 5.1.',
CAP:
	'Turn the captions ON / OFF.',
OWN:
	'Select First Person View control type.',
ITEM:
	'Select item display type.',
QUICK:
	'Select quick change type.',
SCRADJ:
	'Adjust screen position.',
CLRADJ:
	'Display color adjustment screen.',
EXIT:
	'Return to previous screen.',
COLORADJ:
	'Adjust the monitor brightness|'
	'so that the gray scale under|'
	'the red line is no longer seen|'
	'to obtain optimal brightness|'
	'for this game.'
};

resource レーダーの説明 {
RAD_TYPE1:
	'Radar appears even during Intrusion View.',
RAD_TYPE2:
	'Radar does not appear during Intrusion View.'
RAD_OFF:
	'Radar will not appear at all.'
}

resource クイックチェンジの説明 {
unequip:
	'Equip/unequip selected weapon/item.'

previous:
	'Switch between currently and previously equipped|'
	'weapon/item.'
}
