#define	E_TALES			1	//	スネークテイルズＥ明示

#define	GAMEOVER_ADD	1	//	追加ゲームオーバー処理を可能にする。a_gameover.h内で呼ばれる
#define	CONTINUE_ADD	1	//	追加コンティニュー処理を可能にする。a_gameover.h内で呼ばれる



//	スネークテイルズＥで使用している変数をいったんローカルへ退避
	@スネークテイルズＥ用変数退避

//	自前で最初に初期化
	@A_製品版初期化設定

//	ＶＲに必要な変数を代入
#include	"a_vardef.h"
	$b:ミッション番号 = d:MISSION:バラエティ;
	$b:モード番号 = 0;
	$s:選択プレイヤー = スネーク;

	//	ザコサバ　対ゴルルゴンに必要な変数を代入
	$b:ステージ番号 = d:ZAKO_STAGE:GURLUGON;			//	対ゴルルゴン
	$i:プレイヤー初期Ｘ位置 = 550 ;
	$i:プレイヤー初期Ｙ位置 = 0 ;
	$i:プレイヤー初期Ｚ位置 = -3250 ;
	$i:プレイヤー初期方向 = 2048 ;

	$f:sp03a_ザコサバイバルゲームフラグ = 1;
	$f:sp03a_ザコサバイバルウィンドウ表示終了フラグ = 1;
	$i:ザコサバイバルタイマー残り時間 = 60*60*5

	$f:A_一括初期化拒否フラグ = 1;

//------------------------------------------------------------
//ゲームオーバー／コンティニューに関する設定
//------------------------------------------------------------
//	a_gameover.h内で呼ばれる
proc 追加ゲームオーバー処理 {
	@テイルズＥ用ゲームオーバー処理		//	a_stdproc.hで定義
}

//	a_gameover.h内で呼ばれる
proc 追加コンティニュー処理 {
	@テイルズＥ用コンティニュー処理		//	a_stdproc.hで定義
}

#include	"sp03a.gcl"

//------------------------------------------------------------
//アイテムに関する設定		//	#defineの関係上		#include	"sp03a.gcl"よりも後に書くこと
//------------------------------------------------------------
proc テイルズＥ用アイテム設定 {
	#if d:DEBUG_PRINT 
		print 'item_set'
	#endif

//	@アイテム再セットチェック $b:w22a_取得ロード回数[d:I_NO:RGB6]
//	if ($f:再セットフラグ) {
		// 本体を持っていたときは自動的に弾になる
//		@ＲＧＢ６_初期設置 ＲＧＢ６本体 45875 0 -39375 0 ＲＧＢ６弾薬	// Ａ倉庫
//	}

	// 前の繰越
	@Ｍ４_初期設置 Ｍ４本体 d:ITEM_POS_SP03A_07 0 なし
	@ＰＳＧ１_初期設置 ＰＳＧ１本体 d:ITEM_POS_SP03A_18 0 なし
	@ＲＧＢ６_初期設置 ＲＧＢ６本体 d:ITEM_POS_SP03A_03 0 なし	
	// 再発生しないもの
	@スティンガー_初期設置 スティンガー本体 d:ITEM_POS_SP03A_25 0 なし	
	@レーション_初期設置 レーション:01 d:ITEM_POS_SP03A_15 0
	@雑誌_初期設置 雑誌:01 d:ITEM_POS_SP03A_24 0

	// 再発生するもの
				// 再発生するもの
				@弾薬_Ｍ４_初期設置 ＡＫＳ弾:01 d:ITEM_POS_SP03A_17 0
				$$f:アイテム再セットフラグ[d:ITEM_NO:AKS_01] = 1;
				@弾薬_Ｍ４_初期設置 ＡＫＳ弾:02 d:ITEM_POS_SP03A_41 0
				$$f:アイテム再セットフラグ[d:ITEM_NO:AKS_02] = 1;
				@弾薬_ＰＳＧ１_初期設置 ＰＳＧ１弾:01 d:ITEM_POS_SP03A_44 0
				$$f:アイテム再セットフラグ[d:ITEM_NO:PSG1_01] = 1;
				@弾薬_ＰＳＧ１_初期設置 ＰＳＧ１弾:02 d:ITEM_POS_SP03A_29 0
				$$f:アイテム再セットフラグ[d:ITEM_NO:PSG1_02] = 1;
				@弾薬_ＲＧＢ６_初期設置 ＲＧＢ６弾:01 d:ITEM_POS_SP03A_04 0
				$$f:アイテム再セットフラグ[d:ITEM_NO:RGB6_01] = 1;
				@弾薬_スティンガー_初期設置 スティンガー弾:01 d:ITEM_POS_SP03A_08 0
				$$f:アイテム再セットフラグ[d:ITEM_NO:STINGER_01] = 1;
				@ジアゼパム_初期設置 ジアゼパム:01 d:ITEM_POS_SP03A_34 0
				$$f:アイテム再セットフラグ[d:ITEM_NO:DZP_01] = 1;
				trap ev001 d:PLAYER \
					-mask いる \
					-exec {
						@A_アイテム再発生	 d:WEAPON_BOX d:武器:Ｍ４ 29 d:ITEM_NO:AKS_01 \
											 p:弾薬_Ｍ４_初期設置 ＡＫＳ弾:01 d:ITEM_POS_SP03A_17

						@A_アイテム再発生	 d:WEAPON_BOX d:武器:Ｍ４ 29 d:ITEM_NO:AKS_02 \
											 p:弾薬_Ｍ４_初期設置 ＡＫＳ弾:02 d:ITEM_POS_SP03A_41

						@A_アイテム再発生	 d:WEAPON_BOX d:武器:ＰＳＧ１ 19 d:ITEM_NO:PSG1_01 \
											 p:弾薬_ＰＳＧ１_初期設置 ＰＳＧ１弾:01 d:ITEM_POS_SP03A_44

						@A_アイテム再発生	 d:WEAPON_BOX d:武器:ＰＳＧ１ 19 d:ITEM_NO:PSG1_02 \
											 p:弾薬_ＰＳＧ１_初期設置 ＰＳＧ１弾:02 d:ITEM_POS_SP03A_29

						@A_アイテム再発生	 d:WEAPON_BOX d:武器:ＲＧＢ６ 0 d:ITEM_NO:RGB6_01 \
											 p:弾薬_ＲＧＢ６_初期設置 ＲＧＢ６弾:01 d:ITEM_POS_SP03A_04

						@A_アイテム再発生	 d:WEAPON_BOX d:武器:スティンガー 9 d:ITEM_NO:STINGER_01 \
											 p:弾薬_スティンガー_初期設置 スティンガー弾:01 d:ITEM_POS_SP03A_08

						@A_アイテム再発生	 d:ITEM_BOX d:アイテム:ジアゼパム 4 d:ITEM_NO:DZP_01 \
											 p:ジアゼパム_初期設置 ジアゼパム:01 d:ITEM_POS_SP03A_34
					}
}