	if(!$f:スペシャルムービーその７フラグ){
		eval($f:スペシャルムービーその７フラグ = 1)
		chara PSS再生 pss -name '\\LEVEL2\\MB0007.PSS;1' -top 246 57 -proc 終了メッセージ

	}else{
		eval($f:スペシャルムービーその７フラグ = 0)
		chara PSS再生 pss -name '\\LEVEL2\\MB0007A.PSS;1' -top 246 57 -proc 終了メッセージ

	}
}
