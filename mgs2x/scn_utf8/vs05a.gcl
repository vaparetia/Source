				#endif
				@落下死処理 1 0 0
			}
		trap de019 d:PLAYER \
			-mask 入る \
			-state d:TRP_STATE_ELUDE_FALL \
			-exec {
				$$f:落下キャッチ成功フラグ = 0;
				#if d:DEBUG_PRINT
					print 'Death Trap エルード落下キャッチフラグ ＝'$$f:落下キャッチ成功フラグ
				#endif
				@落下死処理 1 0 0
			}
		trap de020 d:PLAYER \
			-mask 入る \
			-state d:TRP_STATE_ELUDE_FALL \
			-exec {
				$$f:落下キャッチ成功フラグ = 0;
				#if d:DEBUG_PRINT
					print 'Death Trap エルード落下キャッチフラグ ＝'$$f:落下キャッチ成功フラグ
				#endif
				@落下死処理 2 0 0
			}
		trap de021 d:PLAYER \
			-mask 入る \
			-state d:TRP_STATE_ELUDE_FALL \
			-exec {
				$$f:落下キャッチ成功フラグ = 0;
				#if d:DEBUG_PRINT
					print 'Death Trap エルード落下キャッチフラグ ＝'$$f:落下キャッチ成功フラグ
				#endif
				@落下死処理 1 0 0
			}
		trap de022 d:PLAYER \
			-mask 入る \
			-state d:TRP_STATE_ELUDE_FALL \
			-exec {
				$$f:落下キャッチ成功フラグ = 0;
				#if d:DEBUG_PRINT
					print 'Death Trap エルード落下キャッチフラグ ＝'$$f:落下キャッチ成功フラグ
				#endif
				@落下死処理 1 2 -1500
			}
		trap de023 d:PLAYER \
			-mask 入る \
			-state d:TRP_STATE_ELUDE_FALL \
			-exec {
				$$f:落下キャッチ成功フラグ = 0;
				#if d:DEBUG_PRINT
					print 'Death Trap エルード落下キャッチフラグ ＝'$$f:落下キャッチ成功フラグ
				#endif
				@落下死処理 1 2 -8500
			}
		trap de024 d:PLAYER \
			-mask 入る \
			-state d:TRP_STATE_ELUDE_FALL \
			-exec {
				$$f:落下キャッチ成功フラグ = 0;
				#if d:DEBUG_PRINT
					print 'Death Trap エルード落下キャッチフラグ ＝'$$f:落下キャッチ成功フラグ
				#endif
				@落下死処理 2 1 0
			}

		// ゲームオーバー終了用
		trap de666 d:PLAYER \
			-mask 入る \
			-state d:TRP_STATE_ELUDE_FALL \
			-exec {
				command ゲームオーバー処理終了
			}
	}
	/*---------------------------
	*	落下死処理。
	*	タイプ
	*	階層
	*		0 = 二階から落下
	*		1 = 一階から落下
	*		2 = 天井のある一階から落下
	*	タイプ
	*		0 = 通常
	*		1 = 絶対真上
	*		2 = プレイヤ位置が第三引数よりも手前であれば真上にする
	//---------------------------*/
	proc 落下死処理 $:階層 $:タイプ $:ｚ位置{

		local $$:rx;
		local $$:ry;
		local $$:by;
		local $$:by2;
		local $$:BY_プレイヤー方向;

		#if d:DEBUG_PRINT
			print '落下死処理 チェック' $$f:落下キャッチ成功フラグ
			print 'プレイヤー方向'$$:BY_プレイヤー方向
		#endif
		if(`%ゲームオーバーチェック` == 0 && $$f:落下キャッチ成功フラグ == 0 ){
			command ゲームオーバー処理開始
			#if d:DEBUG_PRINT
				print '落下死処理 階層' ($:階層) 'タイプ=' ($:タイプ)
			#endif
			$$:BY_プレイヤー方向 = ($w:プレイヤー方向 & 4095);

			// 階層
			if( $:階層 == 0 ){
				$$:by	= d:CAM_MAX;
				$$:by2	= 7000;
			}else if( $:階層 == 1 ){
				$$:by	= d:CAM_MAX;
				$$:by2	= 2000;
			}else if( $:階層 == 2 ){
				$$:by= -1000;
				$$:by2= 7000;
			}

			// カメラ角度設定
			if( ( $:タイプ == 1 ) || ($:タイプ == 2 && ( $i:プレイヤー位置Ｚ > $:ｚ位置 ))  ){
				$$:rx = 1020;
				$$:ry = 2048;
			}else{
				if( ((1024-256) < $$:BY_プレイヤー方向) &&  ($$:BY_プレイヤー方向 < (1024+256)) ){		// 右向き(西向エルード)
					#if d:DEBUG_PRINT
						print '右向き'
					#endif
					$$:rx = 745;
					$$:ry = 1672;
				}else if( ((2048-256) < $$:BY_プレイヤー方向) &&  ($$:BY_プレイヤー方向 < (2048+256)) ){// 上向(南向きエルード)
					#if d:DEBUG_PRINT
						print '上向き'
					#endif
					$$:rx = 745;
					$$:ry = 2048;
				}else if( ((3072-256) < $$:BY_プレイヤー方向) &&  ($$:BY_プレイヤー方向 < (3072+256)) ){// 左向き(西向エルード)
					#if d:DEBUG_PRINT
						print '左向き'
					#endif
					$$:rx = 745;
					$$:ry = 2276;
				}else if( ((0-256) < $$:BY_プレイヤー方向) &&  ($$:BY_プレイヤー方向 < (0+256)) ){		// 下向き(北向エルード)
					#if d:DEBUG_PRINT
						print '下向き'
					#endif
					$$:rx = 1023;
					$$:ry = 2048;
				}else{
					#if d:DEBUG_PRINT
						print 'dir error!!!!!!!!!!!!!!!!!!!!!!!!!! ∑(￣□￣;)'
					#endif
					$$:rx = 1023;
					$$:by = d:CAM_MAX;
				}
			}
			chara カメラ設定 クリア時カメラ \
				-c 0 \
				-b d:CAM_MIN,$$:by2,d:CAM_MIN	d:CAM_MAX,$$:by,d:CAM_MAX \
				-l d:CAM_MIN,-35000,d:CAM_MIN	d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
				-r $$:rx,$$:ry,0 -f 7000 \
				-a 180 \
				-z d:CAMERA_NO_CUSHION \
				-i 0 -1 0 0 \
				-s 1

			// 叫べ。
			chara delay 叫び -time 15 \
				-exec {
					#if d:DEBUG_PRINT
						print 'っっっっあーーーーーー'
					#endif
					command ＳＥセットモード -s d:SD_V_PFALL01 \
						-p	$i:プレイヤー位置Ｘ,$i:プレイヤー位置Ｙ,$i:プレイヤー位置Ｚ \
						-m 1
				}
		}
	}

	// ------------------------------------
	// 敵兵や的の処理
	// ------------------------------------
	// 敵兵に関する設定
	//-------------------------------------
	proc 警備兵セット {
		#if d:DEBUG_PRINT
			print 'watcher_set'
		#endif
		if ( $s:選択プレイヤー == ライデン		|| \
			 $s:選択プレイヤー == プリスキン	|| \
			 $s:選択プレイヤー == 刀ライデン	){
			@VR_スニーキング警備兵 敵兵:01 d:E_R:雷電道１	0 d:WATCHER_STATUS_VS05A
			@VR_スニーキング警備兵 敵兵:02 d:E_R:雷電道２	0 d:WATCHER_STATUS_VS05A
			@VR_スニーキング警備兵 敵兵:03 d:E_R:雷電道３	0 d:WATCHER_STATUS_VS05A
			@VR_スニーキング警備兵 敵兵:04 d:E_R:雷電道４	0 d:WATCHER_STATUS_VS05A
			@VR_スニーキング警備兵 敵兵:05 d:E_R:雷電道５	0 d:WATCHER_STATUS_VS05A

		}else if($s:選択プレイヤー == スネーク			|| \
			 	 $s:選択プレイヤー == タキシードスネーク){
			@VR_スニーキング警備兵 敵兵:01 d:E_R:蛇道１		0 d:WATCHER_STATUS_VS05A
			@VR_スニーキング警備兵 敵兵:02 d:E_R:蛇道２		3 d:WATCHER_STATUS_VS05A
			@VR_スニーキング警備兵 敵兵:03 d:E_R:蛇道３		0 d:WATCHER_STATUS_VS05A
			@VR_スニーキング警備兵 敵兵:04 d:E_R:蛇道４		0 d:WATCHER_STATUS_VS05A
			@VR_スニーキング警備兵 敵兵:05 d:E_R:蛇道５		2 d:WATCHER_STATUS_VS05A

		}else if( 前作スネーク ){
			@VR_スニーキング警備兵 敵兵:01 d:E_R:昔蛇１		0 d:WATCHER_STATUS_VS05A
			@VR_スニーキング警備兵 敵兵:02 d:E_R:昔蛇２		0 d:WATCHER_STATUS_VS05A
			@VR_スニーキング警備兵 敵兵:03 d:E_R:昔蛇３		0 d:WATCHER_STATUS_VS05A
			@VR_スニーキング警備兵 敵兵:04 d:E_R:昔蛇４		0 d:WATCHER_STATUS_VS05A

		}else{// ライデン
			@VR_スニーキング警備兵 敵兵:01 d:E_R:雷電道１	0 d:WATCHER_STATUS_VS05A
			@VR_スニーキング警備兵 敵兵:02 d:E_R:雷電道２	0 d:WATCHER_STATUS_VS05A
			@VR_スニーキング警備兵 敵兵:03 d:E_R:雷電道３	0 d:WATCHER_STATUS_VS05A
			@VR_スニーキング警備兵 敵兵:04 d:E_R:雷電道４	0 d:WATCHER_STATUS_VS05A
			@VR_スニーキング警備兵 敵兵:05 d:E_R:雷電道５	0 d:WATCHER_STATUS_VS05A
		}
	}

	proc 攻撃兵セット {
		#if d:DEBUG_PRINT
			print 'attacker_set'
		#endif
	}

