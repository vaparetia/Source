// ------------------------------------
// 各gclで必要なdefine
// ------------------------------------
// モード
#define		STAGE_VR 		1		// 共通プロック切り分け用
#define		VR_SNEAKING		1		// 共通プロック切り分け用

// ステージ名
#define		STAGE_VS05A		1		// 共通プロック切り分け用
// 敵兵、ＮＰＣ状況（薬莢を呼び分けるのに必要）
#define		ENE_P_GOL		1		// 都市迷彩ゴル兵
#define		ENE_SHOT		1		// ショットガン兵
#define		ENE_HIGH_TECH	1		// ハイテク兵
#define		ENE_SHIELD		1		// 盾兵


// ------------------------------------
// 各種スイッチ用define
// ------------------------------------
// デバッグ関係
#ifdef	d:FIX_MODE
	#define		DEBUG_CHARA		0		// デバッグキャラ全体(FIX時は0)
#else
	#define		DEBUG_CHARA		0		// デバッグキャラ全体
#endif
#define		CHARA_CAMERA	0		// キャラ追従カメラ
#define		TARGET_CHARA	敵兵:01	// キャラ追従カメラのターゲット
#define		SCREENSHOT		0		// スクリーンショット
#define		USB_KEY			0		// USBキーボード


// ------------------------------------
// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME			vs05a
#define		KMS_NAME			vs05a
#define		TONBO_KMS_NAME		vs05a_tonbo
#define		LINE_KMS_NAME		vs05a_line
#define		LT2_NAME			vs05a

// キャラクター関係
#define		PLAYER		ライデン

// ------------------------------------
// 敵兵音声
// ------------------------------------

// ------------------------------------
// 敵兵ルート番号
// ------------------------------------
enum E_R {
	雷電道１ = 0,
	雷電道２,
	雷電道３,
	雷電道４,
	雷電道５,
	蛇道１,
	蛇道２,
	蛇道３,
	蛇道４,
	蛇道５,
	昔蛇１,
	昔蛇２,
	昔蛇３,
	昔蛇４,
};
#define WINDOW_SNEAKING_VS05A	[VRMSG_J:VRM_SNK_SNK_vs05a] [VRMSG_E:VRM_SNK_SNK_vs05a] [VRMSG_G:VRM_SNK_SNK_vs05a] \	// 日、英、独
								[VRMSG_F:VRM_SNK_SNK_vs05a] [VRMSG_I:VRM_SNK_SNK_vs05a] [VRMSG_S:VRM_SNK_SNK_vs05a] \	// 仏、伊、西
								[VRMSG_K:VRM_SNK_SNK_vs05a] \															// 韓
								p:ＶＲステージ開始時処理								// 終了プロック

#define WINDOW_ELIM_ALL_VS05A	[VRMSG_J:VRM_SNK_ELM_vs05a] [VRMSG_E:VRM_SNK_ELM_vs05a] [VRMSG_G:VRM_SNK_ELM_vs05a] \	// 日、英、独
								[VRMSG_F:VRM_SNK_ELM_vs05a] [VRMSG_I:VRM_SNK_ELM_vs05a] [VRMSG_S:VRM_SNK_ELM_vs05a] \	// 仏、伊、西
								[VRMSG_K:VRM_SNK_ELM_vs05a] \															// 韓
								p:ＶＲステージ開始時処理								// 終了プロック
#define WATCHER_STATUS_VS05A	d:ENE_STATUS_NORMAL スニーキング５面
// ------------------------------------
// アイテム位置
// ------------------------------------
#define ２Ｆ兼掴み部 8000 0 -4000
#define １Ｆ階段脇   4500 -5000 500
#define 隠しエルード出口 2000 0 -14000
#define １Ｆ兼つかみ部 8000 -5000 -4000

// ------------------------------------
// include
// ------------------------------------
#include "rai_vs05a.mh"		// 強制モーションリスト
#include "stdch.h"
#include "enevoice.h"
#include "a_stdproc.h"		// アナザーミッション設定ファイル
#include "sload.h"
#include "sound.h"
#include "beyond.h"			// エルードヘッダ。
#include "fall.h"			// 落下時処理
#include "item_info.h"
#include "a_item_info.h"
#include "ene_item.h"
#include "vr_common.h"		// ＶＲステージ共通で使用するプロック
#include "camproc.h"
#if d:USB_KEY
	#include "usbkbd.h"
#endif
// ------------------------------------
// ステージ内ローカル変数
// ------------------------------------

// ------------------------------------
// マップ設定
// ------------------------------------
chara マップ スニーキング５面 -k d:KMS_NAME -h d:HZX_NAME,0 -l $s:ＶＲライトファイル名

command マップ設定 スニーキング５面 -set {
	// ローカルの初期化
	// ------------------------------------
	@ローカル変数初期化		// ローカルで使用する変数で初期化をする場合はここで

	// 設定値を変更する場合は以下のプロック内で設定
	// ------------------------------------
	@設定値変更				// 敵兵や的のパラメータをステージ限定で変える時はここで

	// ＶＲで必要な基本プロックのセット(vr_common.hで定義)
	// サウンドの基本パック、ＶＲの基本システム、プレイヤー、ゴール等を設定します
	// ※このプロックを使用する時は「ＶＲクリア時処理」というプロックが必要です
	// ＶＲ共通プロックセット	$:スネークファイル $:雷電ファイル $:クリア条件フラグ
	//							$:ゴールＸ $:ゴールＹ $:ゴールＺ $:タイマー初期値
	//	VR_GOAL_TARGET	/*的全滅でゴールが開く*/
	//	VR_GOAL_FREE	/*ゴールが最初から開いてる*/
	//	VR_GOAL_ENEMY	/*敵全滅でゴールが開く*/
	//	VR_GOAL_SNEAK	/*潜入モード中はゴールが開く*/
	//	VR_GOAL_TIME	/*タイマーがゼロになるとゴールが開く*/
	// ------------------------------------
	@ＶＲスニーキング共通プロックセット sna_vs05a rai_vs05a 12500 -5000 -13500

	// ＶＲウィンドウの設定
	// ------------------------------------
	@スニーキング５面ＶＲウィンドウ設定

	// クリア時に呼ばれるものの設定
	// ------------------------------------
//	テイルズＥ以外では
#ifndef d:E_TALES
	@ＶＲクリア設定 p:load_vs06a p:A_ＲＥＴＲＹプロック
//	テイルズＥのときは
#else
	@テイルズＥ用ＶＲクリア設定２
#endif

	// ステージに引かれるライン
	// ------------------------------------
	@ＶＲアウトライン d:KMS_NAME d:TONBO_KMS_NAME d:LINE_KMS_NAME

	@プラグイン設定			// プレイヤーのプラグインがいる時はここで
	@エルード設定			// エルード設定。

	// 敵兵・的関係の設定
	// ------------------------------------
	@コマンダー設定

	// ＢＧＭの設定(プレイヤー→敵兵→BGMの順で呼ぶ)
	// ------------------------------------
	@ＢＧＭ設定

	// アイテムの設定
	// ------------------------------------
	@アイテム設定

	// 光源、オブジェクト、カメラ関連の設定
	// ------------------------------------
	@監視カメラ設置
	@ＶＲフォグ設定 d:VR_FOG:朝Ｎ 60000 d:VR_FOG:夕Ｎ 45000 d:VR_FOG:夜Ｎ d:VR_FOG:夜Ｆ
	@カメラセット					// chara カメラとベースのカメラを設定
	@スニーキング５面カメラ設定		// ステージ固有のカメラ設定がいる時はこのプロックで
	@ＶＲキャラ用ライト設置			// 必ず最後に設定
#if d:DEBUG_CHARA
//	@デバッグキャラセット
#endif
}

//初期マップの表示
command マップ表示 -show スニーキング５面


// 各proc設定
//-------------------------------------------------------------------------------------
// 全マップ共通
// ＶＲウィンドウの設定と表示
//------------------------------------------------------------
	proc スニーキング５面ＶＲウィンドウ設定 {
		#if d:DEBUG_PRINT
			print 'vr_window_set'
		#endif
		if ( $b:モード番号 == d:SNEAKING:SNEAKING ) {
			@ＶＲウィンドウ設定 d:WINDOW_SNEAKING_VS05A
		}else{
			@ＶＲウィンドウ設定 d:WINDOW_ELIM_ALL_VS05A
		}

		// ＶＲウィンドウを表示する
		mesg ＶＲウィンドウ ＶＲウィンドウ君 開く

		// スタート時とクリア時に使用するカットインカメラ
		chara カメラ カットインカメラ		-c 0 -l 0 -p  0

		// スタート時のカメラ(必要な場合)
		chara カメラ設定 カットインカメラ \
			-c 1 \
			-p 12500,-296,-10347 -t 12500,-5000,-13500 \
			-r 639,2048,0 -f 5663 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1
	}

	//------------------------------------------------------------
	// ステージ開始時処理
	//------------------------------------------------------------
	proc ＶＲステージ開始時処理 {
		#if d:DEBUG_PRINT
			print 'game_start!!!!!'
		#endif

		// プレイヤーやパッドの制御等を行う a_stdproc.hで定義
		@全ミッション共通ステージ開始時処理

		// カメラワークスタート(必要な場合)
		// 全体図
		chara カメラ設定 カットインカメラ \
			-c 1 \
			-p 7330,17371,3333 -t 7330,9163,-336 \
			-r 750,2048,0 -f 8991 \
			-a 170 \
			-i 4 4 d:START_CAMERA_CHANGE_TIME d:START_CAMERA_CHANGE_TIME \
			-s 1

		chara delay ディレイ \
			-time d:START_CAMERA_CHANGE_TIME \
			-exec {
				chara カメラ設定 カットインカメラ -s -1
			}
	}

	// ------------------------------------
	// クリア時の処理
	// ------------------------------------
	proc ＶＲクリア時処理 {
		#if d:DEBUG_PRINT
			print 'clear'
		#endif
		// 強制モーションを発動
		@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_1 283

		// クリア時にカメラアングルを変える
		chara カメラ設定 クリア時カメラ \
			-c 1 \
			-p 13998,-3860,-9750 -t 12349,-3932,-13636 \
			-r 12,2331,0 -f 3921 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}



	// ------------------------------------
	// パラメータ系の変更
	// ------------------------------------
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT
			print 'localvar_init'
		#endif
		$$f:落下キャッチ成功フラグ = 0;
		$$f:監視カメラ破壊してないフラグ = 1;
	}
	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT
			print 'status_set'
		#endif
		@スニーキング用キャラ別標準装備設定 15 10 7 4
	}
	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif
		command プラグイン落下
	}
	//-------------------------------------
	// エルード
	// ------------------------------------
	proc エルード設定 {
		#if d:DEBUG_PRINT
			print 'beyond_set'
		#endif

		// 西向き( W )のエルード
		//---------------------------------
		//W 2F 隠しエルード部
		trap by001 d:PLAYER \
			-mask いる \
			-key d:PAD_ACTION \	//アクションボタン
			-state 0,4 \		//立ち状態or張り付き
			-exec { // トラップ名 手すり位置 プレイヤ位置($4 x座標 $6 z座標) トラップ幅min_z max_z フラグ(2は足影なし)
				$$f:落下キャッチ成功フラグ = 0;
				@西向きビヨンド発動 by001 1000 $6 -14750 -2250 0x00000002
			}
		trap by001 d:PLAYER \
			-mask いる \
			-state 6 \			// 強制モーション時
			-dir 3072 256 \		// 方向指定
			-camera \			// カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 874,1572,0 -f 6000 \
					-a 200 \
					-i 0 -1 0 0 \
					-s 1
			}
		trap by001 d:PLAYER \
			-mask ？ \			// 入出
			-state d:TRP_STATE_ELUDE \ // エルード時
			-dir 1024 256 \		//方向指定
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,-2250 \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,-3810 \
					-r 895,1880,0 -f 8079 \
					-a 330 \
					-i 3 2 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		//W 1F キャッチ部西側
		trap by002 d:PLAYER \
			-mask いる \
			-key d:PAD_ACTION \	//アクションボタン
			-state 0,4 \		//立ち状態or張り付き
			-exec { // トラップ名 手すり位置 プレイヤ位置($4 x座標 $6 z座標) トラップ幅min_z max_z フラグ(2は足影なし)
				$$f:落下キャッチ成功フラグ = 0;
				@西向きビヨンド発動 by002 7000 $6 -10750 -3250 0x00000002
			}
		trap by002 d:PLAYER \
			-mask いる \
			-state 6 \
			-dir 3072 256 \		//方向指定
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,-1000,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 320,1800,0 -f 6000 \
					-a 200 \
					-i 0 -1 0 0 \
					-s 1
			}
		trap by002 d:PLAYER \
			-mask ？ \			// 入出
			-state d:TRP_STATE_ELUDE \ // エルード時
			-dir 1024 256 \		//方向指定
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,-1000,d:CAM_MAX \
					-l d:CAM_MIN,-5348,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 250,1707,0 -f 5208 \
					-a 250 \
					-i 3 2 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}


		// W 1F ゴールへの通路東側エルード
		trap by003 d:PLAYER \
			-mask いる \
			-key d:PAD_ACTION \	//アクションボタン
			-state 0,4 \		//立ち状態or張り付き
			-exec { // トラップ名 手すり位置 プレイヤ位置($4 x座標 $6 z座標) トラップ幅min_z max_z フラグ(2は足影なし)
				$$f:落下キャッチ成功フラグ = 0;
				@西向きビヨンド発動 by003 12000 $6 -7750 -250 0x00000002
			}
		trap by003 d:PLAYER \
			-mask いる \
			-state 6 \
			-dir 3072 256 \		//方向指定
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,-3000,d:CAM_MIN 		d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN 	d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 850,1752,0 -f 5200 \
					-a 200 \
					-i 0 -1 0 0 \
					-s 1
		}
		trap by003 d:PLAYER \
			-mask ＊ \					// 入出
			-state d:TRP_STATE_ELUDE \	// エルード時
			-dir 1024 256 \				//方向指定
			-camera \					//カメラトラップであることを明示
			-exec {
					@CS_スムーズカメラ降順 $6 -2000 -3000 11819 11819
					eval( $i:補完ＰＸ = $i:CS_結果１ )
					@CS_スムーズカメラ降順 $6 -2000 -3000 -1112 -2398
					eval( $i:補完ＰＹ = $i:CS_結果１ )

					@CS_スムーズカメラ降順 $6 -1000 -3000 11816 11816
					eval( $i:補完ＴＸ = $i:CS_結果１ )

					if( $6 > -3000 ) {
						@CS_スムーズカメラ降順 $6 -1000 -3000 -5580 -4731
						eval( $i:補完ＴＹ = $i:CS_結果１ )

						@CS_スムーズカメラ降順 $6 -1000 -3000 0 -332
						eval( $i:補完ＰＺ = $i:CS_結果１ )
					}else{
						@CS_スムーズカメラ降順 $6 -3000 -6000 -4731 -3500
						eval( $i:補完ＴＹ = $i:CS_結果１ )
						@CS_スムーズカメラ降順 $6 -3000 -6000 -332 -1500
						eval( $i:補完ＰＺ = $i:CS_結果１ )
					}
					@CS_スムーズカメラ降順 $6 -1000 -3000 -1400 -4711
					eval( $i:補完ＴＺ = $i:CS_結果１ )

					@CS_スムーズカメラ降順 $6 -1000 -3000 200 175
					eval( $w:補完画角 = $i:CS_結果１ )

					chara カメラ設定 モーションカメラ \
						-c 1 \
						-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ \
						-t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ \
						-r 952,2316,0 -f 4278 \
						-a $w:補完画角 \
						-i 3 2 0 0 \
						-z d:CAMERA_NO_CUSHION \
						-s $3
			}

		// W 1F 階段横西側
		trap by004 d:PLAYER \
			-mask いる \
			-key d:PAD_ACTION \	//アクションボタン
			-state 0,4 \		//立ち状態or張り付き
			-exec { // トラップ名 手すり位置 プレイヤ位置($4 x座標 $6 z座標) トラップ幅min_z max_z フラグ(2は足影なし)
				$$f:落下キャッチ成功フラグ = 0;
				@西向きビヨンド発動 by004 4000 $6 250 1750 0x00000002
			}
		trap by004 d:PLAYER \
			-mask いる \
			-state 6 \			// 強制モーション時
			-dir 3072 256 \		// 方向指定
			-camera \			// カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 602,1800,0 -f 6039 \
					-a 200 \
