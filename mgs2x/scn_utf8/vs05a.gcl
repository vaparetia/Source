					-r 635,2048,0 \
					-f 10000 \
					-a 200 \
					-i 3 3 0 0 \
					-s $3
			}
		if( ($s:選択プレイヤー == 前作スネーク) && ($b:モード番号 == d:SNEAKING:ELIMINATE_ALL ) ){
			command トラップ切り替え -trap ca600 -switch 1
		}else{
			command トラップ切り替え -trap ca600 -switch 0
		}
	}





// -----------------------------------------------------------------------------------
// 以下デバッグ専用proc
// -----------------------------------------------------------------------------------
// デバッグキャラ
// ------------------------------------
proc デバッグキャラセット {
	#if d:DEBUG_PRINT
		print 'debug_chara_set'
	#endif

	#if d:CHARA_CAMERA
		chara キャラカメラ 敵兵カメラ \
			-c d:TARGET_CHARA \
			-s -920,610,200 \
			-r -200,1024,0
	#endif

	#if d:SCREENSHOT
		chara スクリーンショット shot
	#endif

	#if d:USB_KEY
		chara USBキーボード実行 test \
			-e d:KBD_ESC {
				mesg プレイヤー d:PLAYER position -5500, -13000, -500
			} \
	#endif
}
