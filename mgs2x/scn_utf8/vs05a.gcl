			print 'atcomm_set'
		#endif
	}

	proc コマンダー設定 {
		#if d:DEBUG_PRINT
			print 'commander_set'
		#endif

		// この面に攻撃兵は無し。
		chara コマンダー 敵兵セット \
			-w 警備兵コマンダー \
			-d スニーキング５面 \
			-r 12500,-5000,-13500 スニーキング５面 \
			-c 12500,-5000,-13500 スニーキング５面 \
			-v [ene_vr_voice:01] \
			-z $i:敵標準麻酔持続 \
			-h $i:標準警戒時間 \
			-o $i:敵標準気絶持続 \
			-s (d:ENE_STAGE_GPS | d:ENE_STAGE_VR_ANOTHER ) \
			-b 0 \
			-m d:ALERT_MODE_SENNYU
	}



	// ------------------------------------
	// ＢＧＭの設定
	// ------------------------------------
	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT
			print 'bgm_set'
		#endif

		chara ＢＧＭマネージャー ＢＧＭマネ
	}
	// ------------------------------------
	// 監視カメラ
	// ------------------------------------
	proc 監視カメラ破壊時処理 $:名前 $:フラグ {
		if($:名前 == ゴール前カメラ){
			print '壊れた～'
			$$f:監視カメラ破壊してないフラグ = 0;
			command トラップ切り替え -trap ca600 -switch 0
		}
	}
	proc 監視カメラ設置 {
		#if d:DEBUG_PRINT
			print 'svc_camera'
		#endif
		if( $s:選択プレイヤー == 前作スネーク && $b:モード番号 == d:SNEAKING:ELIMINATE_ALL ){
			// 標準のカメラ
			@A_監視カメラ ゴール前カメラ 14500 -2300 -14000 500 0 3584 512 0
		}

	}

	// ------------------------------------
	// アイテムの設定
	// ------------------------------------
	// 再発生が必要な時は以下のプロックの中を記述する
	// ------------------------------------
	proc アイテム取得時番号設定 $:ボックス名 {
		#if d:DEBUG_PRINT
			print 'item_no_set'
		#endif
	}
	// アイテムの設置
	// ------------------------------------
	proc アイテム設定 {
		#if d:DEBUG_PRINT
			print 'item_set'
		#endif
		if(`@スニーキング判定`){
			// 特に無し
		}else{
			switch( $s:選択プレイヤー ){
				case( ライデン ){
					@A_Ｍ９_初期設置 Ｍ９ d:２Ｆ兼掴み部 0 なし 15
				}
				case( プリスキン ){
					@A_Ｍ９_初期設置 Ｍ９ d:隠しエルード出口 0 なし 6
				}
				case( 刀ライデン ){
				}
				case( スネーク ){
					@A_Ｍ９_初期設置 Ｍ９ d:１Ｆ階段脇 0 なし 8
				}
				case( タキシードスネーク ){
				}
				case( 前作スネーク ){
					@A_Ｍ９_初期設置 Ｍ９ d:１Ｆ兼つかみ部 0 なし 4
					@A_ＵＳＰ_初期設置 ＵＳＰ d:２Ｆ兼掴み部 0 なし 5
					@ＵＳＰサプレッサ_初期設置 さぷれ d:隠しエルード出口 0
				}
				default{
				}
			}
		}
	}

	// ------------------------------------
	// カメラ関係の設定
	// ------------------------------------
	// ステージカメラ設定
	// ------------------------------------
	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'chara_camera & stage_camera_set'
		#endif

		chara カメラ ステージカメラ			-c 0 -l 3 -p 0
		chara カメラ メインカメラ			-c 0 -l 2 -p 50
		chara カメラ キャッチ部入出カメラ 	-c 0 -l 2 -p 40 // キャッチ部接合部 2m 壁裏で使用
		chara カメラ キャッチ部カメラ		-c 0 -l 2 -p 30	// キャッチ部 1Fで使用

		chara カメラ モーションカメラ		-c 0 -l 1 -p 20
		chara カメラ クリア時カメラ			-c 0 -l 0 -p 10

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l 2200,-3500,-14000 12000,d:CAM_MAX,900 \
			-r 650,2048,0 \
			-f 9000 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1

	}

	// ステージ固有のカメラ設定
	// ------------------------------------
	proc スニーキング５面カメラ設定 {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif

		// -------------------------------
		//	2m壁裏しゃがみ時トラップカメラ
		// -------------------------------
		//	2F 隠しエルード北
		trap ca001 d:PLAYER \
			-mask ？ \
			-camera \
			-state d:TRP_STATE_SQUAT d:TRP_STATE_GROUND \
			-exec {
				chara カメラ設定 メインカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l 2200,-3500,-14000 12000,d:CAM_MAX,900 \
					-r 870,2048,0 \
					-f 9000 \
					-a 200 \
					-i 3 3 0 0 \
					-s $3
			}
		// 2F 北通路
		trap ca002 d:PLAYER \
			-mask ？ \
			-camera \
			-state d:TRP_STATE_SQUAT d:TRP_STATE_GROUND \
			-exec {
				chara カメラ設定 メインカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN	d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l 2200,-3500,-14000				12000,d:CAM_MAX,900 \
					-r 870,2048,0 \
					-f 9000 \
					-a 200 \
					-i 3 3 0 0 \
					-s $3
			}

		// 1F 兼キャッチ突部接合地点壁裏
		trap ca003 d:PLAYER \
			-mask ？ \
			-camera \
			-state d:TRP_STATE_SQUAT d:TRP_STATE_GROUND \
			-exec {
				chara カメラ設定 キャッチ部入出カメラ \
					-c 0 \
					-b 9600,d:CAM_MIN,d:CAM_MIN		d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l 9600,-3500,d:CAM_MIN		12000,d:CAM_MAX,d:CAM_MAX \
					-r 870,2048,0 \
					-f 9000 \
					-a 200 \
					-i 3 3 0 0 \
					-s $3
			}
		// 1F 南北通路途中壁裏
		trap ca004 d:PLAYER \
			-mask ？ \
			-camera \
			-state d:TRP_STATE_SQUAT d:TRP_STATE_GROUND \
			-exec {
				chara カメラ設定 メインカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN	d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l 2200,-3500,-14000 				12000,d:CAM_MAX,900 \
					-r 870,2048,0 \
					-f 9000 \
					-a 200 \
					-i 3 3 0 0 \
					-s $3
			}
		// 1F ゴール入り口左壁裏
		trap ca005 d:PLAYER \
			-mask ？ \
			-camera \
			-state d:TRP_STATE_SQUAT d:TRP_STATE_GROUND \
			-exec {
				chara カメラ設定 メインカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN	d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l 2200,-3500,-14000 				12000,d:CAM_MAX,900 \
