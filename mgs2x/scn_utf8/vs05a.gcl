				#endif
				@落下死処理 1 0 0
			}
		trap de016 d:PLAYER \
			-mask 入る \
			-state d:TRP_STATE_ELUDE_FALL \
			-exec {
				$$f:落下キャッチ成功フラグ = 0;
				#if d:DEBUG_PRINT
					print 'Death Trap エルード落下キャッチフラグ ＝'$$f:落下キャッチ成功フラグ
				#endif
				@落下死処理 1 0 0
			}
		trap de017 d:PLAYER \
			-mask 入る \
