/* -------------------------------

強制無線機デモ用にゃろーんむきゃ。
$Id: t_demo_j.cm,v 1.18 2002/06/06 08:00:19 usr01098 Exp $

---------------------------------*/
resource T_00b1Rオープニング無線機デモ {
スネーク_000: {
こちらスネーク、
聞こえるか、オタコン？
}

オタコン_001: {
ああ僕だよ、スネーク。
聞こえる……。
}

スネーク_002: {
……待たせたな。
＃｛潜入、スニーク｝＃ポイントに到着……。
}

オタコン_003: {
上手くいったかい？
}

スネーク_004: {
着地の衝撃でステルス迷彩が壊れた。
}

オタコン_005: {
随分こき使ってきたからね……。
悪いけど我慢してくれ。
軍じゃないんだ。
}

スネーク_006: {
ああ。いつまでも＃｛ステルス迷彩、こんなもの｝＃に
頼るつもりはない。
}

オタコン_007: {
だけど民間の良いところもあるだろ？
プライバシーは守られてるし……。
}

スネーク_008: {
変な薬も盛られずにすむしな。
}

オタコン_009: {
ナオミのこと……？
}

スネーク_010: {
うるさい見張り役がいないのも気が楽だ。
}

オタコン_011: {
メイ・リンか……。
また彼女に頼んでおくよ。
＃｛ＮＡＴＩＣＫ、ナティック｝＃の新兵器。
}

スネーク_012: {
＃｛陸軍兵士システムセンター、ＳＳＣＥＮ｝＃からの
横流しか。彼女に伝えておいてくれ。
}

スネーク_013: {
いずれはバレる。
早いうちに手を引くようにな。
}

オタコン_014: {
それもそうだね……。
じゃあスネーク、本題に入るよ。
}


オタコン_015: {
シャドーモセス事件のあとメタルギアの
技術情報が＃｛闇市場、ブラックマーケット｝＃で密売されたよね。
}

スネーク_016: {
オセロットの仕業だ。
}

オタコン_017: {
ああ。それで全世界にメタルギアの
亜種が拡散した。
}

スネーク_018: {
いまや核武装国にとって、
メタルギアは特別な兵器ではない。
}

オタコン_019: {
今回の新型はそれらに対抗するために
設計された物らしい。
水陸両用の対メタルギア兵器……。
}

スネーク_020: {
それで新型は海兵隊の
所属って訳か……？
}


}//d


resource T_03b1Rカモフ登場後無線機デモ体験版 {
スネーク_000: {
奴等の正体を調べる必要があるな。
}

オタコン_001: {
そんな物飛ばしてるなんて、
どこかの軍隊かな？
}

スネーク_002: {
いや、そうとも言えない。
民間型のＫａ-６２かも知れない。
}

オタコン_003: {
シャドーモセスの時とは違うんだ。
何かあったらすぐ連絡してくれ。
}

オタコン_004: {
ベラザノ橋を越えた所で待ってる。
それまでに離脱するんだ。
}

スネーク_005: {
また連絡する。
}

}//d


resource T_03b1Rカモフ登場後無線機デモ製品版 {
スネーク_000: {
奴等の正体を調べる必要があるな。
}

オタコン_001: {
そんな物飛ばしてるなんて、
どこかの軍隊かな？
}

スネーク_002: {
いや、そうとも言えない。
民間型のＫａ-６２かも知れない。
}

オタコン_003: {
いいかい、スネーク。
必要なのはメタルギア開発の証拠写真だ。
}

オタコン_004: {
それさえあれば良い。
あとはＮＧＯの＃｛ＨＰ、ホームページ｝＃に掲載して
情報を公開する……。
}

オタコン_005: {
いいね、手荒な真似はしないでくれよ。
}

スネーク_006: {
わかった、努力する。
}

オタコン_007: {
シャドーモセスの時とは違うんだ。
何かあったらすぐ連絡してくれ。
}

オタコン_008: {
周波数は１４１．１２だ。
}

スネーク_009: {
データの記録はどうする？
}

オタコン_010: {
僕がするよ。
＃｛記録、セーブ｝＃用の専用回線は１４０．９６……。
}

オタコン_011: {
メイ・リンじゃなくて残念だけど。
}

オタコン_012: {
＃｛記録、セーブ｝＃したい時はこっちに
無線してくれればいい。
}

スネーク_013: {
ああ……。
}

オタコン_014: {
ベラザノ橋を越えた所で待ってる。
それまでに離脱するんだ。
}

スネーク_015: {
また連絡する。
}

}//d


resource T_04a0R操舵室無線機デモ {
オタコン_000: {
スネーク、その船の行き先は
わかったかい？
}

スネーク_001: {
ああ。北緯３５度、西経５８度の
あたりのようだ。
}

オタコン_002: {
バミューダ島の沖、８００キロ位か。
大西洋のど真ん中……。
}

オタコン_003: {
新型メタルギアは単独演習が
可能なほど完成してるのか……？
}

オタコン_004: {
それにそのあたりは海軍第２艦隊の
作戦海域からも外れてる。完全に海兵隊
独自のプロジェクトってことだね。
}

オタコン_005: {
……ということは新型メタルギアは
海軍の支援なしで単独作戦行動を
行う性能を持っている……？
}

オタコン_006: {
うん、まあ詳しいデータはあとで
分析することにするよ。スネークは
次に船倉に行ってメタルギア本体を……。
}

スネーク_007: {
？
}

}//d


// 新規作成分
resource T_06b1Rオルガ戦勝利後無線機デモ１ {
スネーク_000: {
オタコン、船は奴等の手に落ちたようだ。
}

スネーク_001: {
連中、兵装はロシア製だが、
身元がわかるような物は何もない。
}

オタコン_002: {
僕の方ではつかめたよ。
}

スネーク_003: {
何？
}

オタコン_004: {
さっきの男の正体がわかったんだ。
}

スネーク_005: {
誰だ？
}

オタコン_006: {
セルゲイ・ゴルルコビッチ。
}

スネーク_007: {
ゴルルコビッチ！
……オセロットが手を組んでいた？
}

//ＸＸＸＸむび切り分けＸＸＸＸ
} //d

resource T_06b1Rオルガ戦勝利後無線機デモ２ {
オタコン_008: {
そうだよ。シャドーモセスで
オセロットが合流しようとしていた
元＃｛参謀本部情報総局、ＧＲＵ｝＃の大佐……。
}

スネーク_009: {
奴等がメタルギアを……。
}

オタコン_010: {
状況が変わった。
もう単純にはいきそうもないよ。
}

スネーク_011: {
確かに。
俺も今、サイファーらしき
＃｛無人偵察機、ＵＡＶ｝＃を見た。
}

オタコン_012: {
海兵隊のサイファーＴ？
}

スネーク_013: {
いや。
陸軍のだ。
}

//ここで沸けＸＸＸＸＸ

オタコン_014: {
海兵隊にロシア兵、それに陸軍……？
}

スネーク_015: {
お前の言う通り単純では
なくなってきたようだな。
}

オタコン_016: {
……スネーク……実は……。
}

スネーク_017: {
何かあるのか？
}

オタコン_018: {
今回の新型メタルギアのネタ
なんだけど……いつもみたいに、
独自に得た情報じゃないんだ。
}

スネーク_019: {
それじゃ？
}

オタコン_020: {
タレコミなんだ……匿名の。
}

スネーク_021: {
匿名？
そんな情報を信じるような
お前じゃないはず？
}

オタコン_022: {
実は……
僕には妹がいるんだ。
血のつながらない……。
}

オタコン_023: {
一緒に暮らしたのはたった２年だけど。
}

スネーク_024: {
初めて聞くな。
それで……。
}

オタコン_025: {
タレコミメールの発信名に『ＥＥ』と
あったんだ……。
}

スネーク_026: {
ＥＥ？
}

オタコン_027: {
エマっていう名前なんだけど、
僕はＥＥって呼んでた。
}

スネーク_028: {
エマ・エメリッヒ？
}

オタコン_029: {
そうだよ。
懐かしい響きだった……。
}

オタコン_030: {
偶然かも知れないけど、
気になって……。
}

オタコン_030_2: {
妹のことを知ってる人間は
ほとんどいないんだ。
}

スネーク_031: {
彼女とは？
}

オタコン_032: {
もう十何年も会ってない。
}

スネーク_033: {
罠だと思うか？
俺達をおびき寄せる……？
}

オタコン_034: {
わからない。
……ただタレコミのあと＃｛国防総省、ペンタゴン｝＃の
ファイルに潜り込んで裏は取ったんだ。
}

スネーク_035: {
わかった……。
}

オタコン_036: {
すまない……スネーク。
気をつけてね。
}

スネーク_037: {
ＵＳＰを手に入れた。
これで奴等と対等だ。
}

スネーク_038: {
弾倉は空だが、海兵隊のＭ９と同じ
９ｍｍ弾を使う。弾はどこかで
補給できるだろう。
}

スネーク_039: {
フラッシュライトも装備されている。
}

オタコン_040: {
でも、銃声には注意してね。
}

スネーク_041: {
ああ。
}

}//d


// 新規作成分
resource T_09b1R船倉無線機デモ１ {
オタコン_000: {
スネーク、まだかい？
船倉に侵入した？
}

スネーク_001: {
予定より手間取っている……。
既にベラザノ橋を通過した。
}

オタコン_002: {
わかった。
＃｛回収、リカバリー｝ポイントを変更するよ。
}

スネーク_003: {
航路を変更するつもりかも知れん。
}

オタコン_004: {
何だって？
}

スネーク_005: {
上への出口が塞がれた……。
}

オタコン_006: {
連中、どうするつもりなんだ。
}

スネーク_007: {
奴等の手にメタルギアが
渡れば大変なことになる……。
}

} //d

// 新規作成分
resource T_10b1R船倉無線機デモ２体験版 {
オタコン_000: {
スネーク、もう一度確認するね。
}

オタコン_001: {
カメラで新型メタルギアの写真を
撮るんだ。政府がシラを切れない
ような証拠写真を頼む。
}

スネーク_007: {
できるだけ接近してみる。
}

オタコン_008: {
写真は４枚欲しい。メタルギアを
右、前、左の３方向から撮った物と、
海兵隊のマーキングのアップだ。
}

スネーク_009: {
マーキング？
}

オタコン_010: {
メタルギアのどこかに海兵隊の
所属であることを表す＃｛ＭＡＲＩＮＥＳ、マリーンズ｝って
いうマーキングがあるはずなんだ。
}

オタコン_011: {
それがはっきり写っているのが１枚
ほしい。言い逃れされないためにね。
}

オタコン_012: {
撮影できたら、無線機でバースト送信
してくれ。上手く撮れてたら次の指示を
出すよ。
}

/*

スネーク_013: {
わかった。
}

オタコン_014: {
……実はあと１つ問題があって。
}

スネーク_015: {
遠慮せずに言え。
厄介事が増えることには馴れている。
}

オタコン_016: {
誰かが僕等の通信をモニターしてる
気配があるんだ。
}

スネーク_017: {
何者だ？
}

オタコン_018: {
わからない。だけどモニターしてる
だけで妨害しようって様子はないんだ。
それがかえって不気味で……。
}

スネーク_019: {
さっきのサイファーとも関係が？
}

オタコン_020: {
どうかな。
とりあえずバースト通信の暗号化
プロトコルを別のに切り替えてる。
}

オタコン_021: {
あと、念のために写真の送信経路を
変えたいんだ。
}

スネーク_022: {
この無線を使わずに写真を
送るってことか？
}

オタコン_023: {
そう。船倉の一番奥、メタルギアがある
ブロックの南東にコンピュータが１台
置いてある。
}

オタコン_024: {
そこから写真を送信できるように
細工しておいた。
}

スネーク_025: {
細工？ どうやったんだ？
}

オタコン_026: {
軍事ネットワークのリンク１６経由で
その＃｛ＷＳ、ワークステーション｝に侵入してシステムの
一部を書き換えて＃－
}

オタコン_027: {
僕が作った特製のアプリを
リモート・インストールして……。
}

スネーク_028: {
面倒なことを……。
}

オタコン_029: {
いや、やり方は簡単だよ。スネークは
マシンの前でアクションボタンを押す
だけでいい。
}

オタコン_030: {
それでアプリが自動的に立ち上がって
写真のデータを読み取り、分割後暗号化
する。
}

オタコン_031: {
データは偽装されたパケットに
格納されて……。
}

スネーク_032: {
わかった。
写真を撮ったらコンピュータの前で
アクションボタンを押せば、いいんだな。
}

オタコン_033: {
うん、まあ、そうだよ。
}
*/

オタコン_034: {
それと……注意して欲しいのは、
既に演説が始まってる。
}

オタコン_035: {
演説が終わるまでに撮影しないと
発見されるよ、いいね？
}

スネーク_036: {
どれくらい余裕があるんだ？
}

オタコン_037: {
今日の司令官の原稿をハックした。
だいたい１０分てところだ。
アドリブがなければだけど……。
}

スネーク_038: {
１０分がタイムリミットか。
}

オタコン_039: {
スネーク、写真だけだよ。
}

スネーク_040: {
この数だ。そんな気は
起こしようもない。
}

スネーク_041: {
しかし、奴等に＃｛新型、アレ｝を
渡す訳にもいかない。
}

オタコン_042: {
そうだけど、まずは写真を……。
}

スネーク_043: {
わかった。
あとのことはそれから考える。
}

オタコン_044: {
それじゃ、見つからないようにね。
}

/*
スネーク_045: {
昇降機が動かない。
梯子で降りる……。
}
*/

} //d


