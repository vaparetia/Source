// ------------------------------------
// マップ設定
// ------------------------------------
chara マップ 武器訓練ハンドガン４面 -k d:KMS_NAME -h d:HZX_NAME,0 -l $s:ＶＲライトファイル名

command マップ設定 武器訓練ハンドガン４面 -set {
	// ローカルの初期化
	// ------------------------------------
	@ローカル変数初期化		// ローカルで使用する変数で初期化をする場合はここで

	// ＶＲで必要な基本プロックのセット(vr_common.hで定義)
	// サウンドの基本パック、ＶＲの基本システム、プレイヤー、ゴール等を設定します
	// ※このプロックを使用する時は「ＶＲクリア時処理」というプロックが必要です
	// ＶＲ共通プロックセット	$:スネークファイル $:雷電ファイル $:クリア条件フラグ
	//							$:ゴールＸ $:ゴールＹ $:ゴールＺ
	//	VR_GOAL_TARGET	/*的全滅でゴールが開く*/
	//	VR_GOAL_FREE	/*ゴールが最初から開いてる*/
	//	VR_GOAL_ENEMY	/*敵全滅でゴールが開く*/
	//	VR_GOAL_SNEAK	/*潜入モード中はゴールが開く*/
	//	VR_GOAL_TIME	/*タイマーがゼロになるとゴールが開く*/
	// ------------------------------------
	@ＶＲ共通プロックセット sna_wp04a rai_wp04a d:VR_GOAL_TARGET 1000 8000 -59000

	// カメラ設定
	@カメラセット					// chara カメラとベースのカメラを設定

	// ＶＲウィンドウの設定
	// ------------------------------------
	@武器訓練ハンドガン４面ＶＲウィンドウ設定

//	@ＶＲクリア設定 $:ＮＥＸＴＳＴＡＧＥプロック $:ＴＲＹＡＧＡＩＮプロック $:ＥＸＩＴプロック
	@ＶＲクリア設定 p:load_wp05a p:A_ＲＥＴＲＹプロック

	// ステージに引かれるライン
	// ------------------------------------
	@ＶＲアウトライン d:KMS_NAME d:TONBO_KMS_NAME d:LINE_KMS_NAME

	// 設定値を変更する場合は以下のプロック内で設定
	// ------------------------------------
	@設定値変更				// 敵兵や的のパラメータをステージ限定で変える時はここで
	@プラグイン設定			// プレイヤーのプラグインがいる時はここで

	// 的関係の設定
	// ------------------------------------
	@武器訓練ハンドガン４面ＶＲ標的設定				// ＶＲシステム起動後に呼ぶ

	// ＢＧＭの設定(プレイヤー→敵兵→BGMの順で呼ぶ。的の場合は関係ないがとりあえずここに)
	// ------------------------------------
	@ＢＧＭ設定

	// アイテムの設定
	// ------------------------------------
	@アイテム設定

	// 光源、オブジェクト、カメラ関連の設定
	// ------------------------------------
	@ＶＲフォグ設定 -5000 80000 -25000 80000 -35000 70000
	@武器訓練ハンドガン４面カメラ設定		// ステージ固有のカメラ設定がいる時はこのプロックで
	@ＶＲキャラ用ライト設置					// vr_common.hに定義。必ず最後に設定
#if d:DEBUG_CHARA
//	@デバッグキャラセット
#endif

}

//初期マップの表示
command マップ表示 -show 武器訓練ハンドガン４面


//###################################################################################
//									各proc設定
//###################################################################################



//###################################################################################
//									全マップ共通
//###################################################################################
	// ------------------------------------
	// 全マップ共通
	// ------------------------------------
	// ------------------------------------
	// クリア時の処理
	// ------------------------------------
	proc ＶＲクリア時処理 {
		#if d:DEBUG_PRINT
			print 'clear'
		#endif

		// 強制モーションを発動
		@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_1 2048

		// クリア時にカメラアングルを変える
		chara カメラ設定 カットインカメラ \
			-c 1 \
			-p 1627,9116,-62813 -t 1627,9061,-58313 \
			-r 8,0,0 -f 4501 \
			-a 200 \
			-i 1 1 0 0 \
			-s 1

	}



	// ------------------------------------
	// パラメータ系の変更
	// ------------------------------------
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT
			print 'localvar_init'
		#endif

		//	的フラグを初期化する
		eval ($$i:的起動フラグ = 0)

		//	的ステータスを初期化
		eval ($$i:的基本ステータス = 0);
		eval ($$i:的ステータス = 0)

		//	的スピードを初期化
		eval ($$i:的スピード = 0)

		//	的セット数を初期化する
		eval ($$b:的セット数 = 0);

	}
	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT
			print 'status_set'
		#endif

		// 初期装備の設定
		@武器訓練用キャラ別標準装備設定
	}
	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif
	}



//###################################################################################
//									 総合　的設定
//###################################################################################

//////////////////////////
//	基本的プロック
//////////////////////////

	// 移動的プロック
	// ------------------------------------
	proc ＶＲ標的基本設定 \
	$:p_名前 $:p_的ステータス $:p_ルート $:p_ノード $:p_破壊プロック $:p_初期方向 $:p_的スピード {

		//	点滅用処理
		@点滅割り振り設定 $:p_名前

		chara	ＶＲ移動的 $:p_名前 \
			-flag ($$i:的基本ステータス | $:p_的ステータス) \
			-route $:p_ルート $:p_ノード \
			-c $:p_破壊プロック \
			-dir $:p_初期方向 0 \
			-speed $:p_的スピード
	}


//////////////////////////
//	点滅割り振り設定
//////////////////////////
	proc 点滅割り振り設定 $:p_名前 {
		//	プリスキンかタキシードスネークは、点滅する
		if( ($s:選択プレイヤー == プリスキン) || \
			($s:選択プレイヤー == タキシードスネーク) ) {
			//	的セット数をカウントする
			$$b:的セット数 = $$b:的セット数 + 1;

			@ハンドガン４面点滅割り振り設定 $:p_名前

		//	そのほかのキャラは点滅しない
		} else {
			eval ($$i:的基本ステータス = $$i:的基本ステータス)
		}

	}

	//	基本点滅割り振り設定
	proc 基本点滅割り振り設定 {
		//	奇数ならば（＝的セット数が割り切れなければ）、消え状態からスタート
		if( $$b:的セット数 % 2 ) {
			eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)

		//	偶数ならば（＝的セット数が割り切れれば）、点き状態からスタート
		} else {
			eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
		}
	}

	//	ハンドガン４面例外措置
	proc ハンドガン４面点滅割り振り設定 $:p_名前 {
		//	プリスキンの場合
		if ($s:選択プレイヤー == プリスキン) {
			if ($:p_名前 == 移動的:01) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			} else if ( ($:p_名前 == 移動的:08) || ($:p_名前 == 移動的:10) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ($:p_名前 == 移動的:09) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			//	それ以外の的は
			} else {
				@基本点滅割り振り設定
			}

		//	タキシードの場合
		} else {
			if ($:p_名前 == 移動的:01) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			} else if ($:p_名前 == 移動的:06) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ($:p_名前 == 移動的:07) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			//	それ以外の的は
			} else {
				@基本点滅割り振り設定
			}
		}

	}



//////////////////////////
//	ハンドガン４面用
//////////////////////////

	//	スタート処理
	// ------------------------------------
	proc 武器訓練ハンドガン４面ＶＲ標的スタート処理 {
		//	ライデンを選択
		if ($s:選択プレイヤー == ライデン) {
			@ライデン的スタート処理

		//	スネークを選択
		} else if ($s:選択プレイヤー == スネーク) {
			@スネーク的スタート処理

		//	プリスキンを選択（ライデンとコンパチ）
		} else if ($s:選択プレイヤー == プリスキン) {
			@ライデン的スタート処理

		//	タキシードスネークを選択（スネークとコンパチ）
		} else if ($s:選択プレイヤー == タキシードスネーク) {
			@スネーク的スタート処理

		//	前作スネークを選択
		} else if ($s:選択プレイヤー == 前作スネーク) {
			@前作スネーク的スタート処理
		}

	}

	// 破壊時処理
	// ------------------------------------
	proc 武器訓練ハンドガン４面ＶＲ標的破壊処理 {
		//	ライデンを選択
		if ($s:選択プレイヤー == ライデン) {
			@ライデン的破壊処理 $1

		//	スネークを選択
		} else if ($s:選択プレイヤー == スネーク) {
			@スネーク的破壊処理 $1

		//	プリスキンを選択（ライデンとコンパチ）
		} else if ($s:選択プレイヤー == プリスキン) {
			@ライデン的破壊処理 $1

		//	タキシードスネークを選択（スネークとコンパチ）
		} else if ($s:選択プレイヤー == タキシードスネーク) {
			@スネーク的破壊処理 $1

		//	前作スネークを選択
		} else if ($s:選択プレイヤー == 前作スネーク) {
			@前作スネーク的破壊処理 $1
		}

	}

	// 的配置
	// ------------------------------------
	proc 武器訓練ハンドガン４面ＶＲ標的設定 {
		eval ($$i:的ステータス = ($$i:的ステータス | d:VR_TRG_ONE_TRI | d:VR_TRG_WAIT) )
		eval ($$i:的スピード = 0)

		//	ライデンを選択
		if ($s:選択プレイヤー == ライデン) {
			@ライデン的設定

		//	スネークを選択
		} else if ($s:選択プレイヤー == スネーク) {
			@スネーク的設定

		//	プリスキンを選択（ライデンとコンパチ）
		} else if ($s:選択プレイヤー == プリスキン) {
			@ライデン的設定

		//	タキシードスネークを選択（スネークとコンパチ）
		} else if ($s:選択プレイヤー == タキシードスネーク) {
			@スネーク的設定

		//	前作スネークを選択
		} else if ($s:選択プレイヤー == 前作スネーク) {
			@前作スネーク的設定
		}

	}



//###################################################################################
//									 ライデン　的設定
//###################################################################################

	//	スタート処理
	proc ライデン的スタート処理 {
		mesg ＶＲ的共通 移動的:01 移動開始
		mesg ＶＲ的共通 移動的:02 移動開始
		mesg ＶＲ的共通 移動的:03 移動開始
		mesg ＶＲ的共通 移動的:04 移動開始
		mesg ＶＲ的共通 移動的:05 移動開始
		mesg ＶＲ的共通 移動的:06 移動開始
		mesg ＶＲ的共通 移動的:07 移動開始
		mesg ＶＲ的共通 移動的:08 移動開始
		mesg ＶＲ的共通 移動的:09 移動開始
		mesg ＶＲ的共通 移動的:10 移動開始
	}

	//	破壊時処理
	proc ライデン的破壊処理 {
		if (	($1 == 移動的:01) || ($1 == 移動的:02) || ($1 == 移動的:03) || \
				($1 == 移動的:04) || ($1 == 移動的:05) || ($1 == 移動的:06) || \
				($1 == 移動的:07) || ($1 == 移動的:08) || ($1 == 移動的:09) || \
				($1 == 移動的:10) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 10) {
				mesg ＶＲ的共通 移動的:11 移動開始	/*	NG	*/
				mesg ＶＲ的共通 移動的:12 移動開始

				eval ($$i:的起動フラグ = 0)
			}

		} else if ($1 == 移動的:12) {
			mesg ＶＲ的共通 移動的:13 移動開始
			mesg ＶＲ的共通 移動的:14 移動開始	/*	NG	*/

			mesg ＶＲ的共通 移動的:11 消滅

		} else if ($1 == 移動的:13) {
			mesg ＶＲ的共通 移動的:15 移動開始	/*	NG	*/
			mesg ＶＲ的共通 移動的:16 移動開始

			mesg ＶＲ的共通 移動的:14 消滅

		} else if ($1 == 移動的:16) {
			mesg ＶＲ的共通 移動的:15 消滅
		}

	}

	//	的配置
	proc ライデン的設定 {

	//	ＶＲ標的基本設定 \
	//	$:p_名前 $:p_的ステータス $:p_ルート $:p_ノード $:p_破壊プロック $:p_初期方向 $:p_的スピード

		//	１Ｆ階段
		@ＶＲ標的基本設定 \
		移動的:01 $$i:的ステータス d:４面的ルート:移１Ｆ階段＿０ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 512 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:02 $$i:的ステータス d:４面的ルート:移１Ｆ階段＿５ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 3584 $$i:的スピード

		//	２Ｆ
		@ＶＲ標的基本設定 \
		移動的:03 $$i:的ステータス d:４面的ルート:移２Ｆ＿０ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 512 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:04 $$i:的ステータス d:４面的ルート:移２Ｆ＿２ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 3584 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:05 $$i:的ステータス d:４面的ルート:移２Ｆ＿４ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 512 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:06 $$i:的ステータス d:４面的ルート:移２Ｆ＿６ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 3584 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:07 $$i:的ステータス d:４面的ルート:移２Ｆ＿８ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 512 $$i:的スピード

		//	２Ｆ階段
		@ＶＲ標的基本設定 \
		移動的:08 $$i:的ステータス d:４面的ルート:移２Ｆ階段＿０ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 512 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:09 $$i:的ステータス d:４面的ルート:移２Ｆ階段＿７ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 3584 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:10 $$i:的ステータス d:４面的ルート:移２Ｆ階段＿４ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 512 $$i:的スピード

		//	３Ｆ
		@ＶＲ標的基本設定 \
		移動的:11 ($$i:的ステータス | d:VR_TRG_NG) d:４面的ルート:移３Ｆ左＿３ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 0 ($$i:的スピード + 50)
		@ＶＲ標的基本設定 \
		移動的:12 $$i:的ステータス d:４面的ルート:移３Ｆ右＿３ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 0 ($$i:的スピード + 50)

		@ＶＲ標的基本設定 \
		移動的:13 $$i:的ステータス d:４面的ルート:移３Ｆ左＿９ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 0 ($$i:的スピード + 50)
		@ＶＲ標的基本設定 \
		移動的:14 ($$i:的ステータス | d:VR_TRG_NG) d:４面的ルート:移３Ｆ右＿９ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 0 ($$i:的スピード + 50)

		@ＶＲ標的基本設定 \
		移動的:15 ($$i:的ステータス | d:VR_TRG_NG) d:４面的ルート:移３Ｆ左＿１８ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 0 ($$i:的スピード + 50)
		@ＶＲ標的基本設定 \
		移動的:16 $$i:的ステータス d:４面的ルート:移３Ｆ右＿１８ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 0 ($$i:的スピード + 50)
	}



