	}

	//	破壊時処理
	proc 前作スネーク的破壊処理 {
		if (	($1 == 移動的:01) || ($1 == 移動的:02) || ($1 == 移動的:03) || \
				($1 == 移動的:04) || ($1 == 移動的:05) || ($1 == 移動的:06) || \
				($1 == 移動的:07) || ($1 == 移動的:08) || ($1 == 移動的:09) || \
				($1 == 移動的:10) || ($1 == 移動的:11) || ($1 == 移動的:12) || \
				($1 == 移動的:13) || ($1 == 移動的:14) || ($1 == 移動的:15) || \
				($1 == 移動的:16) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 16) {
				mesg ＶＲ的共通 移動的:17 移動開始	/*	NG	*/
				mesg ＶＲ的共通 移動的:18 移動開始

				eval ($$i:的起動フラグ = 0)
			}

		} else if ($1 == 移動的:18) {
			mesg ＶＲ的共通 移動的:19 移動開始
			mesg ＶＲ的共通 移動的:20 移動開始	/*	NG	*/

			mesg ＶＲ的共通 移動的:17 消滅

		} else if ($1 == 移動的:19) {
			mesg ＶＲ的共通 移動的:21 移動開始	/*	NG	*/
			mesg ＶＲ的共通 移動的:22 移動開始	/*	NG	*/

			mesg ＶＲ的共通 移動的:23 移動開始	/*	NG	*/
			mesg ＶＲ的共通 移動的:24 移動開始

			mesg ＶＲ的共通 移動的:20 消滅

		} else if ($1 == 移動的:24) {
			mesg ＶＲ的共通 移動的:25 移動開始
			mesg ＶＲ的共通 移動的:26 移動開始

			mesg ＶＲ的共通 移動的:21 消滅
			mesg ＶＲ的共通 移動的:22 消滅
			mesg ＶＲ的共通 移動的:23 消滅

		}

	}

	//	的配置
	proc 前作スネーク的設定 {
	//	ＶＲ標的基本設定 \
	//	$:p_名前 $:p_的ステータス $:p_ルート $:p_ノード $:p_破壊プロック $:p_初期方向 $:p_的スピード

		//	１Ｆ階段
		@ＶＲ標的基本設定 \
		移動的:01 $$i:的ステータス d:４面的ルート:移１Ｆ階段＿０ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 512 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:02 $$i:的ステータス d:４面的ルート:移１Ｆ階段＿３ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 3584 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:03 $$i:的ステータス d:４面的ルート:移１Ｆ階段＿２ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 512 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:04 $$i:的ステータス d:４面的ルート:移１Ｆ階段＿５ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 3584 $$i:的スピード

		//	２Ｆ
		@ＶＲ標的基本設定 \
		移動的:05 $$i:的ステータス d:４面的ルート:移２Ｆ＿１ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 3584 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:06 $$i:的ステータス d:４面的ルート:移２Ｆ＿２ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:07 $$i:的ステータス d:４面的ルート:移２Ｆ＿４ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:08 $$i:的ステータス d:４面的ルート:移２Ｆ＿７ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 512 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:09 $$i:的ステータス d:４面的ルート:移２Ｆ＿８ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:10 $$i:的ステータス d:４面的ルート:移２Ｆ＿９ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 3584 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:11 $$i:的ステータス d:４面的ルート:移２Ｆ＿１０ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 0 $$i:的スピード

		//	２Ｆ階段
		@ＶＲ標的基本設定 \
		移動的:12 $$i:的ステータス d:４面的ルート:移２Ｆ階段＿０ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 512 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:13 $$i:的ステータス d:４面的ルート:移２Ｆ階段＿６ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 3584 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:14 $$i:的ステータス d:４面的ルート:移２Ｆ階段＿２ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 512 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:15 $$i:的ステータス d:４面的ルート:移２Ｆ階段＿８ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 3584 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:16 $$i:的ステータス d:４面的ルート:移２Ｆ階段＿４ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 512 $$i:的スピード

		//	３Ｆ
		@ＶＲ標的基本設定 \
		移動的:17 ($$i:的ステータス | d:VR_TRG_NG) d:４面的ルート:移３Ｆ左＿３ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 0 ($$i:的スピード + 50)
		@ＶＲ標的基本設定 \
		移動的:18 $$i:的ステータス d:４面的ルート:移３Ｆ右＿３ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 0 ($$i:的スピード + 50)

		@ＶＲ標的基本設定 \
		移動的:19 $$i:的ステータス d:４面的ルート:移３Ｆ左＿８ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 0 ($$i:的スピード + 50)
		@ＶＲ標的基本設定 \
		移動的:20 ($$i:的ステータス | d:VR_TRG_NG) d:４面的ルート:移３Ｆ右＿８ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 0 ($$i:的スピード + 50)

		@ＶＲ標的基本設定 \
		移動的:21 ($$i:的ステータス | d:VR_TRG_NG) d:４面的ルート:移３Ｆ左＿１２ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 0 ($$i:的スピード + 50)
		@ＶＲ標的基本設定 \
		移動的:22 ($$i:的ステータス | d:VR_TRG_NG) d:４面的ルート:移３Ｆ右＿１２ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 0 ($$i:的スピード + 50)

		@ＶＲ標的基本設定 \
		移動的:23 ($$i:的ステータス | d:VR_TRG_NG) d:４面的ルート:移３Ｆ左＿１６ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 0 ($$i:的スピード + 50)
		@ＶＲ標的基本設定 \
		移動的:24 $$i:的ステータス d:４面的ルート:移３Ｆ右＿１６ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 0 ($$i:的スピード + 50)

		@ＶＲ標的基本設定 \
		移動的:25 $$i:的ステータス d:４面的ルート:移３Ｆ左＿２１ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 0 ($$i:的スピード + 50)
		@ＶＲ標的基本設定 \
		移動的:26 $$i:的ステータス d:４面的ルート:移３Ｆ右＿２１ 0 p:武器訓練ハンドガン４面ＶＲ標的破壊処理 0 ($$i:的スピード + 50)
	}



