proc w12穴かもめ{
    if ( $i:カモメ拡散カウンタ > 0 ){
        eval( $i:カモメ拡散カウンタ = $i:カモメ拡散カウンタ - 1 )
	if ( $i:カモメ拡散カウンタ == 0 ){
	    mesg かもめマネージャ かもめ管理 指定トラップ内集合 ev002, 5, -4976, 5380, -11566, ev004, 120
	}
    }
}

proc w12かもめ弾監視
{
    if ( $1 >= 1 && $1 <= 4){
	mesg かもめマネージャ かもめ管理 指定球内エリア変更 -4976, 5380, -11566,, 2000, ev002, 30
        eval( $i:カモメ拡散カウンタ = 300 )
    }
}

proc w12aかもめ昇降機飛び立ち{ // 昇降機が到着してかもめが飛び立つ
	mesg かもめマネージャ かもめ管理 指定球内緊急離陸 200, 5000, -12500, 8000, ev003, 60, 4
}

/*------------- 自由飛行 -------------*/
proc w12aかもめ自由飛行管理{ // 連続呼びでw12aのかもめ自由飛行を監視
    // かもめの自由着陸管理
    if ( $i:カモメ着地カウンタ > 0 ){
        eval( $i:カモメ着地カウンタ = $i:カモメ着地カウンタ - 1 )
	if ( $i:カモメ着地カウンタ == 0 ){
	    eval( $i:カモメ着地点 = $i:カモメ着地点 + `command rand 2` + 1)		// 着地する線を決める
	    eval( $i:カモメ着地点 = $i:カモメ着地点 % 10) 				
  	    eval( $i:カモメ着地数 = `command rand 2` + 3)		// 着地するかもめの数を決める
  	    eval( $i:カモメ着地カウンタ = `command rand 500` + 500 )	// 次の着地命令発行までの間隔を決める

	    if ( $i:カモメ着地点 == 0 ){
		mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:カモメ着地数, ev002, -3800, 6000, -15850,  3800, 6000, -15850, 1000, 3000, 360
	    }else if ( $i:カモメ着地点 == 1 ){
		mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:カモメ着地数, ev002, 9000, 7500,  -3000,  9000, 7500,  -1500, 1000, 3000, 360
	    }else if ( $i:カモメ着地点 == 2 ){
		mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:カモメ着地数, ev002, 7500, 7500,      0, -1500, 7500,      0, 1000, 3000, 360
	    }else if ( $i:カモメ着地点 == 3 ){
		mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:カモメ着地数, ev002, -9000, 7500,  -3000, -9000, 7500,  -1500, 1000, 3000, 360
	    }else if ( $i:カモメ着地点 == 4 ){
		mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:カモメ着地数, ev002, -7500, 7500,      0, -4875, 7500,      0, 1000, 3000, 360
	    }else if ( $i:カモメ着地点 == 5 ){
		mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:カモメ着地数, ev002, 7500, 7500, -14000,  4000, 7500, -14000, 1000, 3000, 360
	    }else if ( $i:カモメ着地点 == 6 ){
		mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:カモメ着地数, ev002, 3875, 7500, -11500,  3875, 7500, -16000, 1000, 3000, 360
	    }else if ( $i:カモメ着地点 == 7 ){
		mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:カモメ着地数, ev002, -5750, 7500,  -9750, -5750, 7500, -11500, 1000, 3000, 360
	    }else if ( $i:カモメ着地点 == 8 ){
		mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:カモメ着地数, ev002, -3875, 7500, -11500, -3875, 7500, -16000, 1000, 3000, 360
	    }else if ( $i:カモメ着地点 == 9 ){
		mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:カモメ着地数, ev002, 9000, 7500,  -9750,  9000, 7500, -12500, 1000, 3000, 360
	    }
	}
    }
}
