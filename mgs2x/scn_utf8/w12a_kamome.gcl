// 002 北低   004 低エリア検索用   008 非難エリア   013 非難エリア検索用
// 011 南高
// 003 北高

proc w12a_かもめ危険モード開始
{
	mesg かもめマネージャ かもめ管理 指定トラップ内緊急散開 ev004 ev008 75 30
	mesg かもめマネージャ かもめ管理 指定トラップ内緊急離陸 ev004 ev008 75 30
}
proc w12a_かもめ危険モード終了
{
	mesg かもめマネージャ かもめ管理 指定トラップ内緊急散開 ev013 ev002 75 360
	mesg かもめマネージャ かもめ管理 指定トラップ内緊急離陸 ev013 ev002 75 360
}
proc w12a_かもめ自由飛行管理	// 連続呼びでw12aのかもめ自由飛行を監視
{
	if($i:w12a_カモメ着地カウンタ > 0) {
		// カウントダウン
		eval($i:w12a_カモメ着地カウンタ = $i:w12a_カモメ着地カウンタ - 1)

	} else if($i:w12a_カモメ着地カウンタ == 0) {
		// 着地点の設定
		eval($i:w12a_カモメ着地点 = $i:w12a_カモメ着地点 + `command rand 16` + 1)	// 着地する線を決める
		eval($i:w12a_カモメ着地点 = $i:w12a_カモメ着地点 % 16)
		if(($i:w12a_カモメ着地点 == 1) || ($i:w12a_カモメ着地点 == 4)) {	// この２つのケースはカモメが壁にめり込む可能性が高いので使わない
			eval($i:w12a_カモメ着地点 = $i:w12a_カモメ着地点 + 1)
		}
		// 着地数
		eval($i:w12a_カモメ着地数 = `command rand 2` + 1)							// 着地するかもめの数を決める
		// カウント設定
		eval($i:w12a_カモメ着地カウンタ = `command rand 800` + 800)					// 次の着地命令発行までの間隔を決める

		// 着地制御
		if($i:w12a_カモメ着地点 == 0) {
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev002, -3800, 6000, -15950,  3800, 6000, -15950, 1000, 3000, 360
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev003,  7500, 7500,     50, -1500, 7500,     50, 1000, 3000, 360
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev011, -7500, 7500,     50, -4875, 7500,     50, 1000, 3000, 360
		} else if($i:w12a_カモメ着地点 == 1) {
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev002, -9050, 7500,  -2500, -9050, 7500,  -1500, 1000, 3000, 360
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev003, -9050, 7500,  -2500, -9050, 7500,  -1500, 1000, 3000, 360
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev011,  9050, 7500,  -9750,  9050, 7500, -12500, 1000, 3000, 360
		} else if($i:w12a_カモメ着地点 == 2) {
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev002, -9050, 7500,  -1500, -7550, 7500,     50, 1000, 3000, 360
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev003, -9050, 7500,  -1500, -7550, 7500,     50, 1000, 3000, 360
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev011,  9050, 7500, -12500,  7550, 7500, -14050, 1000, 3000, 360
		} else if($i:w12a_カモメ着地点 == 3) {
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev002,  7500, 7500,     50, -1500, 7500,     50, 1000, 3000, 360
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev003, -7500, 7500,     50, -4875, 7500,     50, 1000, 3000, 360
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev011,  7500, 7500, -14050,  4000, 7500, -14050, 1000, 3000, 360
		} else if($i:w12a_カモメ着地点 == 4) {
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev002, -9050, 7500,  -2500, -9050, 7500,  -1500, 1000, 3000, 360
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev003,  9050, 7500,  -9750,  9050, 7500, -12500, 1000, 3000, 360
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev011,  5800, 7500,  -9750,  5800, 7500, -11550, 1000, 3000, 360
		} else if($i:w12a_カモメ着地点 == 5) {
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev002, -9050, 7500,  -1500, -7550, 7500,     50, 1000, 3000, 360
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev003,  9050, 7500, -12500,  7550, 7500, -14050, 1000, 3000, 360
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev011,  5800, 7500, -11550,  3925, 7500, -11550, 1000, 3000, 360
		} else if($i:w12a_カモメ着地点 == 6) {
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev002, -7550, 7500,     50, -4875, 7500,     50, 1000, 3000, 360
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev003,  7550, 7500, -14050,  4000, 7500, -14050, 1000, 3000, 360
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev011, -3925, 7500, -11550, -3925, 7500, -16000, 1000, 3000, 360
		} else if($i:w12a_カモメ着地点 == 7) {
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev002,  9050, 7500,  -9750,  9050, 7500, -12500, 1000, 3000, 360
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev003,  5800, 7500,  -9750,  5800, 7500, -11550, 1000, 3000, 360
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev011, -5800, 7500,  -9750, -5800, 7500, -11550, 1000, 3000, 360
		} else if($i:w12a_カモメ着地点 == 8) {
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev002,  9050, 7500, -12500,  7500, 7500, -14050, 1000, 3000, 360
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev003,  5800, 7500, -11550,  3925, 7500, -11550, 1000, 3000, 360
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev011, -5800, 7500, -11550, -3925, 7500, -11550, 1000, 3000, 360
		} else if($i:w12a_カモメ着地点 == 9) {
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev002,  7550, 7500, -14050,  4000, 7500, -14050, 1000, 3000, 360
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev003,  3925, 7500, -11550,  3925, 7500, -16000, 1000, 3000, 360
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev011, -3925, 7500, -11550, -3925, 7500, -16000, 1000, 3000, 360
		} else if($i:w12a_カモメ着地点 == 10) {
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev002,  5800, 7500,  -9750,  5800, 7500, -11550, 1000, 3000, 360
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev003, -5800, 7500,  -9750, -5800, 7500, -11550, 1000, 3000, 360
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev011, -3800, 6000, -15950,  3800, 6000, -15950, 1000, 3000, 360
		} else if($i:w12a_カモメ着地点 == 11) {

			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev002,  5800, 7500, -11550,  3925, 7500, -11500, 1000, 3000, 360
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev003, -5800, 7500, -11550, -3925, 7500, -11500, 1000, 3000, 360
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev011,  9050, 7500,  -2500,  9050, 7500,  -1500, 1000, 3000, 360
		} else if($i:w12a_カモメ着地点 == 12) {
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev002,  3925, 7500, -11550,  3925, 7500, -16000, 1000, 3000, 360
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev003, -3925, 7500, -11550, -3925, 7500, -16000, 1000, 3000, 360
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev011,  9000, 7500,  -1500,  7500, 7500,     50, 1000, 3000, 360
		} else if($i:w12a_カモメ着地点 == 13) {
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev002, -5800, 7500,  -9750, -5800, 7500, -11550, 1000, 3000, 360
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev003, -3800, 6000, -15950,  3800, 6000, -15950, 1000, 3000, 360
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev011,  7550, 7500,     50, -1500, 7500,     50, 1000, 3000, 360
		} else if($i:w12a_カモメ着地点 == 14) {
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev002, -5800, 7500, -11550, -3925, 7500, -11550, 1000, 3000, 360
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev003,  9050, 7500,  -2500,  9050, 7500,  -1500, 1000, 3000, 360
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev011, -9050, 7500,  -2500, -9050, 7500,  -1500, 1000, 3000, 360
		} else if($i:w12a_カモメ着地点 == 15) {
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev002, -3925, 7500, -11550, -3925, 7500, -16000, 1000, 3000, 360
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev003,  9050, 7500,  -1500,  7550, 7500,     50, 1000, 3000, 360
			mesg かもめマネージャ かもめ管理 指定トラップ内搾取線着地 $i:w12a_カモメ着地数, ev011, -9050, 7500,  -1500, -7550, 7500,     50, 1000, 3000, 360
		}
	}
}

proc w12a_かもめ_20
{
#if d:DEBUG_PRINT
	print '*** Seagull 20 ***'
#endif

    chara かもめマネージャ かもめ管理 \
	// モデルデータ名
	-datamdl kmo_noalp, kmo_low, kmo_low, kmo_low \ 

	// 平均速度
	-zspeed 65 \

	// 基本ルーチン
	-base d:KMNG_BASE_ESCAPE \	// 基本状態:敏感

	// フントラップ
	-cdanna ev011 \

	// 消去する高さ
	-eraseh -40500 \
#ifndef d:ANOTHER
	\ // かもめダメージ時プロック
	-wdmgproc rp_かもめ殺しやがった \
#endif
	\ // かもめの名前
	-name \ 
	Kamome00, Kamome01, Kamome02, Kamome03, Kamome04, \		// 北西
	Kamome05, Kamome06, Kamome07, Kamome08, Kamome09, \		// 北東
	Kamome10, Kamome11, Kamome12, Kamome13, Kamome14, \		// 南西
	Kamome15, Kamome16, Kamome17, Kamome18, Kamome19, \		// 南東

	// 初期Ｙ方向
	-yrot \
	0, 0, 0, 0, 0, \
	0, 3000, 0, 0, 0, \
	4096 - 500, 500, 644, 711, 804, \
	4096 - 256, 400, 544, 811, 904, \

	//-------------------------------------------
	// 初期位置

	// エリア指定型初期位置
	-farea \
	-5500, 5000, -11000, -5000, 5000, -10500, \		// 穴前 (0x00)
	-5000, 5000, -11000, -4500, 5000, -10500, \		// (0x01)
	-5500, 5000, -12500, -5000, 5000, -11800, \		// (0x02)

	// 線指定型初期位置
	-linepos \ /* 初期位置線指定 */
	-3800, 6000, -15950,  3800, 6000, -15950, \		// 北フェンス

	 9050, 7500,  -2500,  9050, 7500,  -1500, \		// 南東
	 9050, 7500,  -1500,  7550, 7500,     50, \		// 
	 7550, 7500,     50, -1500, 7500,     50, \		// 

	-9050, 7500,  -2500, -9050, 7500,  -1500, \		// 南西 
	-9050, 7500,  -1500, -7550, 7500,     50, \		// 
	-7550, 7500,     50, -4875, 7500,     50, \		// 

	 9050, 7500,  -9750,  9050, 7500, -12500, \		// 北東
	 9050, 7500, -12500,  7550, 7500, -14050, \
	 7550, 7500, -14050,  4000, 7500, -14050, \

	 5800, 7500,  -9750,  5800, 7500, -11550, \		// 北東
	 5800, 7500, -11550,  3925, 7500, -11550, \
	 3925, 7500, -11550,  3925, 7500, -16000, \

	-5800, 7500,  -9750, -5800, 7500, -11550, \		// 北西
	-5800, 7500, -11550, -3925, 7500, -11550, \
	-3925, 7500, -11550, -3925, 7500, -16000, \

	// 初期位置指定フラグ
	-unitpos \
	(d:KMM_IPOS_AREA | 0x01), (d:KMM_IPOS_AREA | 0x01), (d:KMM_IPOS_AREA | 0x01), (d:KMM_IPOS_LINE | 0x0e), (d:KMM_IPOS_LINE | 0x0f), \
	(d:KMM_IPOS_LINE | 0x00), (d:KMM_IPOS_LINE | 0x07), (d:KMM_IPOS_LINE | 0x09), (d:KMM_IPOS_LINE | 0x0b), (d:KMM_IPOS_LINE | 0x0b), \
	(d:KMM_IPOS_LINE | 0x04), (d:KMM_IPOS_LINE | 0x04), (d:KMM_IPOS_LINE | 0x04), (d:KMM_IPOS_LINE | 0x06), (d:KMM_IPOS_LINE | 0x06), \
	(d:KMM_IPOS_LINE | 0x01), (d:KMM_IPOS_LINE | 0x02), (d:KMM_IPOS_LINE | 0x03), (d:KMM_IPOS_LINE | 0x03), (d:KMM_IPOS_LINE | 0x03), \

	//-------------------------------------------
	// 飛行エリア

	// 飛行エリアトラップ列
	-traparea \
	        ev002 ev011 ev003 \		// 002 北低、011 南高、003 北高
	// 飛行エリアインデックス
	-indexarea \
	(d:KMM_FLYA_TRAP | 0x01), (d:KMM_FLYA_TRAP | 0x02), (d:KMM_FLYA_TRAP | 0x02), (d:KMM_FLYA_TRAP | 0x02), (d:KMM_FLYA_TRAP | 0x01), \
	(d:KMM_FLYA_TRAP | 0x02), (d:KMM_FLYA_TRAP | 0x02), (d:KMM_FLYA_TRAP | 0x01), (d:KMM_FLYA_TRAP | 0x02), (d:KMM_FLYA_TRAP | 0x02), \
	(d:KMM_FLYA_TRAP | 0x01), (d:KMM_FLYA_TRAP | 0x02), (d:KMM_FLYA_TRAP | 0x02), (d:KMM_FLYA_TRAP | 0x02), (d:KMM_FLYA_TRAP | 0x01), \
	(d:KMM_FLYA_TRAP | 0x02), (d:KMM_FLYA_TRAP | 0x02), (d:KMM_FLYA_TRAP | 0x01), (d:KMM_FLYA_TRAP | 0x02), (d:KMM_FLYA_TRAP | 0x02), \

	//-------------------------------------------

	// 初期モーション
	-mot \
	d:KMM_MOT_IDLE02, d:KMM_MOT_IDLE02, d:KMM_MOT_IDLE02, d:KMM_MOT_FLYING, d:KMM_MOT_FLYING, \  
	d:KMM_MOT_FLYING, d:KMM_MOT_FLYING, d:KMM_MOT_FLYING, d:KMM_MOT_FLYING, d:KMM_MOT_FLYING, \  
	d:KMM_MOT_FLYING, d:KMM_MOT_FLYING, d:KMM_MOT_FLYING, d:KMM_MOT_FLYING, d:KMM_MOT_FLYING, \  
	d:KMM_MOT_FLYING, d:KMM_MOT_FLYING, d:KMM_MOT_FLYING, d:KMM_MOT_FLYING, d:KMM_MOT_FLYING  \  

	// 初期思考
	-routine \
	d:KMM_INITTHK_GROUNDREST, d:KMM_INITTHK_GROUNDREST, d:KMM_INITTHK_GROUNDREST, d:KMM_INITTHK_REST, d:KMM_INITTHK_REST, \
	d:KMM_INITTHK_REST, d:KMM_INITTHK_REST, d:KMM_INITTHK_REST, d:KMM_INITTHK_REST, d:KMM_INITTHK_REST, \
	d:KMM_INITTHK_REST, d:KMM_INITTHK_REST, d:KMM_INITTHK_REST, d:KMM_INITTHK_REST, d:KMM_INITTHK_REST, \
	d:KMM_INITTHK_REST, d:KMM_INITTHK_REST, d:KMM_INITTHK_REST, d:KMM_INITTHK_REST, d:KMM_INITTHK_REST
}
proc w12a_かもめ_40
{
#if d:DEBUG_PRINT
	print '*** Seagull 40 ***'
#endif

    chara かもめマネージャ かもめ管理 \
	// モデルデータ名
	-datamdl kmo_noalp, kmo_low, kmo_low, kmo_low \ 

	// 平均速度
	-zspeed 65 \

	// 基本ルーチン
	-base d:KMNG_BASE_ESCAPE \	// 基本状態:敏感

	// 消去する高さ
	-eraseh -40500 \

	// フントラップ
	-cdanna ev011 \
#ifndef d:ANOTHER
	\ // かもめダメージ時プロック
	-wdmgproc rp_かもめ殺しやがった \
#endif
	\ // かもめの名前
	-name \ 
	Kamome00, Kamome01, Kamome02, Kamome03, Kamome04, \		// 穴前
	Kamome05, Kamome06, Kamome07, Kamome08, Kamome09, \		// 穴前
