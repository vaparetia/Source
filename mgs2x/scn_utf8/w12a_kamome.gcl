	 3925, 7500, -11550,  3925, 7500, -16000, \

	-5800, 7500,  -9750, -5800, 7500, -11550, \		// 北西
	-5800, 7500, -11550, -3925, 7500, -11550, \
	-3925, 7500, -11550, -3925, 7500, -16000, \

	-traparea \
	        ev002 ev003 ev004 ev008 \

