				-i $w:敵潜入視力,($w:敵危険視力+7500),$w:敵回避視力 \
				-l $w:敵標準体力 \
				-f $w:敵標準気絶 \
				-e d:ENE_EQUIP_TYPE_NORMAL	//	$w:装備タイプ
