//###################################################################################
//									ビヨンド
//###################################################################################

	proc ＣＤ連絡橋ビヨンド設定 {
		#if d:DEBUG_PRINT
			print 'beyond_set'
		#endif
// 上通路　北
		// ------------------
			//	エルード発動
			trap by001 d:PLAYER \
				-mask いる \
				-button 3 \		//ビヨンドボタン
				-state 0,4 \	//立ち状態or張り付き
				-exec {
					@北向きビヨンドハイ発動 by001 -1000 $4 -7750 7750 0x00002
				}
			//	発動カメラ
			trap by001 d:PLAYER \
				-camera \
				-mask いる \
				-state 6 \	// 強制モーション中
				-dir 2048 256 \	// 方向指定
				-exec {
					chara カメラ設定 ビヨンドカメラ \
						-c 0 \
						-b d:CAM_MIN,3212,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
						-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,1319,d:CAM_MAX \
						-r 222,1310,0 -f 5652 \
						-a 200 \
						-i 0 -1 0 0 \
						-s 1
				}
			//	エルードカメラ
			trap by001 d:PLAYER \
				-camera \
				-mask ？ \
				-state 5 \	// エルード中
				-dir 0 256 \	// 方向指定
				-exec {
					chara カメラ設定 ビヨンドカメラ \
						-c 0 \
						-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
						-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
						-r 881,1480,0 -f 6619 \
						-a 227 \
						-i 3 2 0 0 \
						-s $3 \
						-z d:CAMERA_NO_CUSHION
				}
			//	張り付きカメラ
			trap by001 d:PLAYER \
				-mask ？ \
				-state 8 \	//張り付き
				-dir 0 256 \	// 方向指定
				-camera \
				-exec {
					chara カメラ設定 張り付きカメラ \
						-c 0 \
						-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
						-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
//						-r 881,1583,0 -f 6619 \
						-r 881,1583,0 -f 10000 \
						-a 200 \
						-i 2 2 0 0 \
						-s $3 \
						-z (d:CAMERA_NO_CUSHION | d:CAMERA_NO_PAD_ADJUST)
				}
// 上通路　南
		// ------------------
			//	エルード発動
			trap by002 d:PLAYER \
				-mask いる \
				-button 3 \		//ビヨンドボタン
				-state 0,4 \	//立ち状態or張り付き
				-exec {
					@南向きビヨンド発動 by002 1000 $4 -4750 4750 0x00002
				}
			//	発動カメラ
			trap by002 d:PLAYER \
				-camera \
				-mask いる \
				-state 6 \	// 強制モーション中
				-dir 0 256 \	// 方向指定
				-exec {
					chara カメラ設定 ビヨンドカメラ \
						-c 0 \
						-b d:CAM_MIN,3212,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
						-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,1319,d:CAM_MAX \
						//-r 406,1483,0 -f 10410 \
						//-a 200 \
						-r 406,1444,0 -f 6348 \
						-a 200 \
						-i 0 -1 0 0 \
						-s 1
				}
			//	エルードカメラ
			trap by002 d:PLAYER \
				-camera \
				-mask ？ \
				-state 5 \	// エルード中
				-dir 2048 256 \	// 方向指定
				-exec {
					chara カメラ設定 ビヨンドカメラ \
						-c 0 \
						-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
						-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
						-r 484,1778,0 -f 13605 \
						-a 693 \
						-i 3 2 0 0 \
						-s $3 \
						-z d:CAMERA_NO_CUSHION
				}
			//	張り付きカメラ
			trap by002 d:PLAYER \
				-mask ？ \
				-state 8 \	//張り付き
				-dir 2048 256 \	// 方向指定
				-camera \
				-exec {
					chara カメラ設定 張り付きカメラ \
						-c 0 \	
						-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
						-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
//						-r 881,1583,0 -f 6619 \
						-r 881,1583,0 -f 10000 \
						-a 200 \
						-i 2 2 0 0 \
						-s $3 \
						-z (d:CAMERA_NO_CUSHION | d:CAMERA_NO_PAD_ADJUST)
				}
// 下通路
		// ------------------
			//	エルード発動
			trap by003 d:PLAYER \
				-mask いる \
				-button 3 \		//ビヨンドボタン
				-state 0,4 \	//立ち状態or張り付き
				-exec {
					@南向きビヨンドハイ発動 by003 3000 $4 -5750 5750 0x00002
				}
			//	発動カメラ
			trap by003 d:PLAYER \
				-camera \
				-mask いる \
				-state 6 \	// 強制モーション中
				-dir 0 256 \	// 方向指定
				-exec {
					chara カメラ設定 ビヨンドカメラ \
						-c 0 \
						-b d:CAM_MIN,-391,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
						-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,-1681,d:CAM_MAX \
						-r 150,1464,0 -f 5602 \
						-a 175 \
						-i 0 -1 0 0 \
						-s 1
				}
			//	エルードカメラ
			trap by003 d:PLAYER \
					-camera \
					-mask ？ \
					-state 5 \	// エルード中
					-dir 2048 256 \	// 方向指定
					-exec {
						chara カメラ設定 ビヨンドカメラ \
							-c 0 \
							-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
							-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
							-r 3904,1794,0 -f 8065 \
							-a 276 \
							-i 3 2 0 0 \
							-s $3 \
							-z d:CAMERA_NO_CUSHION 
					}
			//	張り付きカメラ
			trap by003 d:PLAYER \
				-mask ？ \
				-state 8 \	//張り付き
				-dir 2048 256 \	// 方向指定
				-camera \
				-exec {
					chara カメラ設定 張り付きカメラ \
						-c 0 \	
						-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
						-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
						-r 942,1583,0 -f 6817 \
						-a 200 \
						-i 2 2 0 0 \
						-s $3 \
						-z (d:CAMERA_NO_CUSHION | d:CAMERA_NO_PAD_ADJUST)
				}
	}

//###################################################################################
//									ＮＰＣ設定
//###################################################################################

	//	ダンボール男の配置チェック
	proc ダンボール男配置チェック {
		//	ダンボール男は爆弾が半分以上解体されているときはすでに見ている（もしくはもう出ない）はず
		if ($w:p_story >= d:ST:P016_01_R1爆弾解体半分解体１無線デモ１終了) {
			eval ($f:w17a_ダンボール男フラグ = d:TRUE)
		}
	}


	proc ダンボール男設定 {
		if ($f:w17a_ダンボール男フラグ == d:FALSE) {
		#if d:DEBUG_PRINT
		print 'SNAKESNAKESNAKESNAKESNAKESNAKESNAKESNAKESNAKESNAKESNAKESNAKESNAKESNAKE'
		# endif
			//	ダンボール男見たフラグを立てる
			eval ($f:w17a_ダンボール男フラグ = d:TRUE)

			if ($w:スタートアラートモード == d:ALERT_MODE_SENNYU) {
				if ($s:登場ポイント == sp_w16a_w17a_0 ) {
				#if d:DEBUG_PRINT
				print 'DETADETADETADETADETADETADETADETADETADETADETADETADETADETADETADETA'
				# endif
					//	ダンボール男配置
					chara ＮＰＣスネーク ダンボール男 \
						-m iro_def_mt \
						-a npc_snake \
						-c npc_snake_cap \
						-d npc_snake_drag \
						-x -5000,1500,0 \
						-r 0,1024,0 \
//						-p 15000,1639,-4000 \
						-p 17625,1639,-3250 \
						-t 4 \
						-z 3250

					//	福島さん管理
					@rp_ダンボール男監視野郎参上

					//	ダンボール男がトラップに入るとダンボール男消去
					trap ev001 ダンボール男 \
						-mask 入る \
						-exec {
						#if d:DEBUG_PRINT
							print 'trapin'
						#endif
							//	箱男見たフラグを立てる
							eval($f:rfp_箱男見た = 1)
							//	福島さん管理
							@rp_ダンボール男監視野郎も退場

							//	スネーク消去
							mesg ＮＰＣスネーク ダンボール男 kill
							command トラップ削除 -name ダンボール男消去
							//	敵兵永久気絶→通常気絶へ
							mesg 敵兵共通 敵兵:01 永久ダウンオフ
							mesg 敵兵共通 敵兵:01 ダウン時間セット d:FAINT_TIME_2
						}
				}
			}
		}
	}



//###################################################################################
//									シナリオデモ
//###################################################################################

	proc 監視カメラデモ設定 {
	//	日本語版
	#ifdef d:JAPANESE
		//	ノーマル以上
		if($w:ゲーム設定 >= d:LEVEL_NORMAL) {
			trap sc001 d:PLAYER \
				-mask 入る \
				-exec {
					if ($f:w17a_監視カメラデモフラグ == d:FALSE) {
						//	監視カメラデモフラグを立てる（危険モード時はデモは二度と見ない）
						eval ($f:w17a_監視カメラデモフラグ = d:TRUE)
						//	監視カメラが破壊されていない場合
						if ($f:w17a_監視カメラ破壊フラグ == d:FALSE) {

							//	潜入モード時のみデモが発動する
									//	Ｃ脚側から来てアラートモードが潜入のとき
							if (	(($f:w17a_敵配置フラグ == d:STRUT_C) && \
									($w:アラートモード == d:ALERT_MODE_SENNYU)) || \
									//	Ｄ脚側から来てスタートアラートモードが潜入のとき
									(($f:w17a_敵配置フラグ == d:STRUT_D) && \
									($w:スタートアラートモード == d:ALERT_MODE_SENNYU))	) {

								//	シナリオデモ安全チェックを入れておく
								if( `@シナリオデモ用安全チェック` ) {
									@監視カメラデモ管理設定
								}
							}

						}
					}
				}
		}

	//	それ以外
	#else
		trap sc001 d:PLAYER \
			-mask 入る \
			-exec {
				if ($f:w17a_監視カメラデモフラグ == d:FALSE) {
					//	監視カメラデモフラグを立てる（危険モード時はデモは二度と見ない）
					eval ($f:w17a_監視カメラデモフラグ = d:TRUE)
					//	監視カメラが破壊されていない場合
					if ($f:w17a_監視カメラ破壊フラグ == d:FALSE) {

						//	潜入モード時のみデモが発動する
								//	Ｃ脚側から来てアラートモードが潜入のとき
						if (	(($f:w17a_敵配置フラグ == d:STRUT_C) && \
								($w:アラートモード == d:ALERT_MODE_SENNYU)) || \
								//	Ｄ脚側から来てスタートアラートモードが潜入のとき
								(($f:w17a_敵配置フラグ == d:STRUT_D) && \
								($w:スタートアラートモード == d:ALERT_MODE_SENNYU))	) {

							//	シナリオデモ安全チェックを入れておく
							if( `@シナリオデモ用安全チェック` ) {
								@監視カメラデモ管理設定
							}
						}

					}
				}
			}

	#endif
	}

	proc 監視カメラデモ管理設定 {
		chara プロック連続実行 監視カメラデモ管理人 \
			-p 監視カメラデモ管理
	}

	proc 監視カメラデモ管理 {
		command パッドチェック \
			-no_use
		//	パッドが戻ったら（ステージ開始処理が終了したら）
		if ($status != 1) {
			@監視カメラデモ
			mesg プロック連続実行 監視カメラデモ管理人 kill
		}
	}

	proc 監視カメラデモ {

		//	シナリオデモ開始処理を行う
		@シナリオデモ開始処理

		//	シナリオデモ中を示すフラグを立てる
		eval ($f:w17a_監視カメラデモ中フラグ = d:TRUE)

		if ($f:w17a_敵配置フラグ == d:STRUT_C) {

			//	姿勢制御
			mesg プレイヤー d:PLAYER stance 0 -1 -1 0

			//	ライデンの向きを変える
			mesg プレイヤー d:PLAYER rotate 640

			//	位置を調整
			mesg プレイヤー d:PLAYER position 14250 $i:プレイヤー位置Ｙ -258

			//	シナリオカメラ起動
			chara カメラ設定 シナリオカメラ２ \
				-c 1 \
				-p 14813,4399,2622 -t 14121,1116,601 \
				-a 200 \
				-i 0 0 0 0 \
				-s 1

			chara カメラ設定 シナリオカメラ２ \
				-c 1 \
				-p 15717,4395,2315 -t 15021,1116,291 \
				-a 200 \
				-i 0 0 0 0 \
				-z d:CAMERA_INTERP_CAMERA \ // 補完カメラフラグを指定。
				-interp_time 120 \ // 補完時間を指定
				-s 1

		} else if ($f:w17a_敵配置フラグ == d:STRUT_D) {
			//	ライデンの向きを変える
			mesg プレイヤー d:PLAYER rotate 1915
		
			//	シナリオカメラ起動
			chara カメラ設定 シナリオカメラ２ \
				-c 1 \
				-p 14697,1211,5062 -t 15473,1921,3070 \
				-a 200 \
				-i 0 0 0 0 \
				-s 1

			chara カメラ設定 シナリオカメラ２ \
				-c 1 \
				-p 14697,1211,5062 -t 15473,2250,3070 \
				-a 500 \
				-i 0 0 0 0 \
				-z d:CAMERA_INTERP_CAMERA \ // 補完カメラフラグを指定。
				-interp_time 60 \ // 補完時間を指定
				-s 1
		}

		chara デモキャンセルチェック デモキャンセル -p 監視カメラデモキャンセル

		chara delay 監視カメラデモ終了ディレイ \
			-t 210 \
			-e {
				//	シナリオカメラオフ
				chara カメラ設定 シナリオカメラ２ \
					-s -1
				//	シナリオデモ終了処理
				@シナリオデモ終了処理

				//	シナリオデモ終了したことを示す
				eval ($f:w17a_監視カメラデモ中フラグ = d:FALSE)

				//	デモキャンセルチェック
				mesg デモキャンセルチェック デモキャンセル kill
			}



	}

	proc 監視カメラデモキャンセル {
		mesg delay 監視カメラデモ終了ディレイ kill
		
		chara カメラ設定 ロードカメラ \
			-s -1

		chara delay シナリオカメラ終了ディレイ \
			-t d:FADEOUT_TIME \
			-e {
				chara カメラ設定 シナリオカメラ２ \
					-s -1
			}

		//	シナリオデモ終了したことを示す
		eval ($f:w17a_監視カメラデモ中フラグ = d:FALSE)

		eval ($i:終了時位置Ｘ = $i:プレイヤー位置Ｘ);
		eval ($i:終了時位置Ｙ = $i:プレイヤー位置Ｙ);
		eval ($i:終了時位置Ｚ = $i:プレイヤー位置Ｚ);
		eval ($i:終了時方向 =   $w:プレイヤー方向);
		eval ($b:終了時姿勢 = d:FA_END_STAND);

		//	共通デモキャンセルにおまかせ
		@スタート時パッドデモキャンセル
	}



#if 0
	proc 監視カメラデモ管理 {
		command パッドチェック \
			-no_use
		//	パッドが戻ったら（ステージ開始処理が終了したら）
