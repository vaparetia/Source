			}
		//	Ｂ１南側Ｄ脚側
		trap bh103 d:PLAYER \
			-mask ？ \
			-state 8 \
			-dir 2048 256 \	//方向指定
			-camera \			//カメラトラップであることを明示
			-exec {
				@張り付き移動カメラＢ１ $3
			}

		//	階段
