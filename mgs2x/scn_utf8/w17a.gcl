//	監視カメラ

	proc 監視カメラ配置チェック	{
		@カメラ再セットチェック $b:w17a_破壊ロード回数[5]
		if ($f:再セットフラグ) {
			eval ($f:w17a_監視カメラ破壊フラグ = d:FALSE)
		}
	}

	proc 監視カメラ設定 {
	//	日本語版
	#ifdef d:JAPANESE
		//	ノーマル以上
		if($w:ゲーム設定 >= d:LEVEL_NORMAL) {
			// Ｄ脚側通路
			if ($f:w17a_監視カメラ破壊フラグ == d:FALSE) {
				chara プラントカメラ カメラ:01 \
					-pos 16250 3000 1500 \
//					-rot 630 3072 0 \
					-rot 590 3072 0 \
					-center 2944 0 \
					-dir 128 \
//					-xran 352 \
//					-yran 224 \
					-xran 320 \
					-yran 208 \
					-i 3500 6000 3500 3500 \
					-wait 240 \
					-alertdir 256 \
					-exec {
						eval ($i:w17a_監視カメラ壊れ方 = $2)
						#if d:DEBUG_PRINT 
							print '$###########################################################w17a_監視カメラ壊れ方１'$i:w17a_監視カメラ壊れ方
						#endif
						eval ($b:w17a_破壊ロード回数[5] = $w:グローバルロード回数)
						eval ($f:w17a_監視カメラ破壊フラグ = d:TRUE)
					}
			} else {
				chara プラントカメラ カメラ:01 \
					-pos 16250 3000 1500 \
//					-rot 630 3072 0 \
					-rot 590 3072 0 \
					-center 2944 0 \
					-dir 128 \
//					-xran 352 \
//					-yran 224 \
					-xran 320 \
					-yran 208 \
					-i 3500 6000 3500 3500 \
					-status $i:w17a_監視カメラ壊れ方 \
					-wait 240 \
					-alertdir 256
					#if d:DEBUG_PRINT 
						print '$###########################################################w17a_監視カメラ壊れ方２'$i:w17a_監視カメラ壊れ方
					#endif
			}
		}

	//	それ以外
	#else
		// Ｄ脚側通路
		if ($f:w17a_監視カメラ破壊フラグ == d:FALSE) {
			chara プラントカメラ カメラ:01 \
				-pos 16250 3000 1500 \
//				-rot 630 3072 0 \
				-rot 590 3072 0 \
				-center 2944 0 \
				-dir 128 \
//				-xran 352 \
//				-yran 224 \
				-xran 320 \
				-yran 208 \
				-i 3500 6000 3500 3500 \
				-wait 240 \
				-alertdir 256 \
				-exec {
					eval ($i:w17a_監視カメラ壊れ方 = $2)
					#if d:DEBUG_PRINT 
						print '$###########################################################w17a_監視カメラ壊れ方１'$i:w17a_監視カメラ壊れ方
					#endif
					eval ($b:w17a_破壊ロード回数[5] = $w:グローバルロード回数)
					eval ($f:w17a_監視カメラ破壊フラグ = d:TRUE)
				}
		} else {
			chara プラントカメラ カメラ:01 \
				-pos 16250 3000 1500 \
//				-rot 630 3072 0 \
				-rot 590 3072 0 \
				-center 2944 0 \
				-dir 128 \
//				-xran 352 \
//				-yran 224 \
				-xran 320 \
				-yran 208 \
				-i 3500 6000 3500 3500 \
				-status $i:w17a_監視カメラ壊れ方 \
				-wait 240 \
				-alertdir 256
				#if d:DEBUG_PRINT 
					print '$###########################################################w17a_監視カメラ壊れ方２'$i:w17a_監視カメラ壊れ方
				#endif
		}

	#endif
	}



//###################################################################################
//								ＢＧＭ設定
//###################################################################################

	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT 
			print 'bgm_set'
		#endif

		chara ＢＧＭマネージャー ＢＧＭマネ \
			-s 0x00000001
		chara ＢＧＭ風音 風音 \
		-s d:BGM_WINDNOISE_WEATHER_FAIN

	}

//###################################################################################
//									 ドア＆マップ切り替え
//###################################################################################

	proc ドア設置 {
		#if d:DEBUG_PRINT
			print 'door_set'
		#endif
		chara ドア Ｃ脚ドア \
			-m d:DOOR_NAME0 \
			-d 0 2769 0 \
			-p -16100,0,-5050 \
			-slide d:SD_SLIDE_OUTSIDE2 \
			-time d:SD_OPEN_TIME \
			-A Ｃ脚ドアランプ \
			-between ＣＤ連絡橋 ＣＤ連絡橋 \
			-card_level 1 \
			-exec{
				if( !($:開閉フラグ) ){
					mesg プットオブジェ Ｃ脚ロードエリア off
				}else{
					mesg プットオブジェ Ｃ脚ロードエリア on
				}
			}
		@ドアランプ設定 Ｃ脚ドアランプ 2770 -16100 0 -5050 1

		trap dr001 ？ -mask ？ \
			-exec {
				if ( $3 == 入る ) {
					mesg ドア Ｃ脚ドア open $2
				} else if( $3 == 出る ){
					mesg ドア Ｃ脚ドア close $2
				}
			}

		chara ドア Ｄ脚ドア \
			-m d:DOOR_NAME1 \
			-d 0 1024 0 \
			-p 16875,0,3750 \
			-slide d:SD_SLIDE_OUTSIDE \
			-time d:SD_OPEN_TIME \
			-between ＣＤ連絡橋 ＣＤ連絡橋 \
			-A Ｄ脚ドアランプ \
			-exec{
				if( !($:開閉フラグ) ){
					mesg プットオブジェ Ｄ脚ロードエリア off
				}else{
					mesg プットオブジェ Ｄ脚ロードエリア on
				}
			}
		@ドアランプ設定 Ｄ脚ドアランプ 1024 16875 0 3750 1
			
		trap dr002 ？ -mask ？ \
			-exec {
				if ( $3 == 入る ) {
					mesg ドア Ｄ脚ドア open $2
				} else if( $3 == 出る ){
					mesg ドア Ｄ脚ドア close $2
				}
			}
	}

	proc 主観禁止壁設定 {

		@主観禁止壁 Ｃ脚ドア壁 -16100 0 -5050 2769 d:SD_SLIDE_OUTSIDE2
		@主観禁止床 Ｃ脚ドア床１ Ｃ脚ドア床２ -16100 0 -5050 2769 d:SD_SLIDE_OUTSIDE2
		trap dr001 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_SUBJECT \
			-exec {
				if( $3 == 入る ) {
					mesg 透明壁 Ｃ脚ドア壁 on
				} else {
					mesg 透明壁 Ｃ脚ドア壁 off
				}
			}

		@主観禁止壁 Ｄ脚ドア壁 16875 0 3750 1024 d:SD_SLIDE_OUTSIDE
		@主観禁止床 Ｄ脚ドア床１ Ｄ脚ドア床２ 16875 0 3750 1024 d:SD_SLIDE_OUTSIDE
		trap dr002 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_SUBJECT \
			-exec {
				if( $3 == 入る ) {
					mesg 透明壁 Ｄ脚ドア壁 on
				} else {
					mesg 透明壁 Ｄ脚ドア壁 off
				}
			}



	
	}


//###################################################################################
//									開始時処理
//###################################################################################

	proc ＣＤ連絡橋開始時処理 {
		#if d:DEBUG_PRINT
			print 'start_set'
			print $s:登場ポイント sp_w16a_w17a_0 sp_w18a_w17a_0 ;
		#endif
		if( $s:登場ポイント == sp_w16a_w17a_0 ){
			@ステージ開始時処理（ステージ名表示）\
			d:LOAD_TYPE:SL_DOOR_TYPE Ｃ脚ドア 2500 d:DEFAULT_M_TYPE d:wn_ＣＤ連絡橋
			@Ｃ脚ロード時カメラ設定
		}else if( $s:登場ポイント == sp_w18a_w17a_0 ){
			@ステージ開始時処理（ステージ名表示）\
			d:LOAD_TYPE:SL_DOOR_TYPE Ｄ脚ドア 2000 d:DEFAULT_M_TYPE d:wn_ＣＤ連絡橋
			@Ｄ脚ロード時カメラ設定
		}
	}

//###################################################################################
//									ロード設定
//###################################################################################

	proc ロードプロック {
		if ($s:呼び出しプロック == mv_w17a_w16a_0) {
			@mv_w17a_w16a_0
		} else if ($s:呼び出しプロック == mv_w17a_w18a_0) {
			@mv_w17a_w18a_0
		}
	}
	proc ロード設定 {
		#if d:DEBUG_PRINT
			print 'load_set'
		#endif
		trap ld001 d:PLAYER \
			-mask いる \
			-exec {
				// Ｃ脚（w16a）へ
				@ポリトラップ $4 $6 -15750,-5500 -17000,-3000 ,-19250,-3000 -19250,-5500 ;
				if(( $i:ポリトラップ結果 >= 0 ) && ( $f:ロードチェックＯＮフラグ == 1 )){
					//	爆弾イベント用
					@爆弾タイマー残り時間保存
					@ステージ終了時処理（ステージ名表示） \
					-17625 0 -4750 2769 mv_w17a_w16a_0 d:DEFAULT_M_TYPE \
					d:wn_Ｃ脚食堂
					//	ロード時カメラ
					@Ｃ脚ロード時カメラ設定
					//	先読み
					preseek 'w16b'
				}
			}
		trap ld002 d:PLAYER \
			-mask いる \
			-exec {
				// Ｄ脚（w18a）上へ
				if( $f:ロードチェックＯＮフラグ == 1 ){
					//	爆弾イベント用
					@爆弾タイマー残り時間保存
					@ステージ終了時処理（ステージ名表示） \
					17625 0 3000 1024 mv_w17a_w18a_0 d:DEFAULT_M_TYPE \
					d:wn_Ｄ脚第一沈殿池
					//	ロード時カメラ
					@Ｄ脚ロード時カメラ設定
					//	先読み
					preseek 'w18a'
				}
			}
	}

	proc Ｃ脚ロード時カメラ設定 {
		chara カメラ設定 ロードカメラ \
						-c 1 \	
						-p -15259,4127,-822 \
						-t -15541,1562,-4150 \
						-a 200 \
						-i 0 1 0 0 \
						-s 1

		chara プロック連続実行 カメラ戻し管理人 \
			-proc カメラ戻し管理
	}
	proc Ｄ脚ロード時カメラ設定 {
		chara カメラ設定 ロードカメラ \
						-c 1 \
						-p 14357,3648,5492 -t 15913,2110,2549 \
						-a 200 \
						-i 0 1 0 0 \
						-s 1

		chara プロック連続実行 カメラ戻し管理人 \
			-proc カメラ戻し管理
	}

	proc カメラ戻し管理 {
		command パッドチェック \
			-no_use
		if ($status != 1) {
			chara カメラ設定 ロードカメラ \
				-s -1
			mesg プロック連続実行 カメラ戻し管理人 kill
		}
	}

//###################################################################################
//									オブジェクト
//###################################################################################

	proc オブジェクト設定 {
		chara プットオブジェ Ｄ脚ロードエリア \
			-m 	d:KMS_NAME8 -r 0 0 0 -p 0 0 0  -l d:LT2_NAME
		mesg プットオブジェ Ｄ脚ロードエリア off

		chara プットオブジェ Ｃ脚ロードエリア \
			-m 	d:KMS_NAME24 -r 0 0 0 -p 0 0 0  -l d:LT2_NAME
		mesg プットオブジェ Ｃ脚ロードエリア off
	}

	proc 水位設定 {
		command 水位設定 -lv -40000
	}

	proc 海面設定 {
		#if d:DEBUG_PRINT
			print 'w17a_sea_set'
		#endif

		chara プラント海面 seaseasea \
			-tex oil d_oil_sea_alp_ovl_mod0222 d_oil_ref_add_alp_ovl_mod1120 \
			-w 1,2,3 \
			-l \
			-pos 0,-40000,0

		chara 拡張海表示 sea_serface_ex \
			-tex d_oil_sea_alp_ovl_mod0222 \
			-pos 0,-40000,0 \
			-color 145 185 120			/*色合い調整 省略可*/

		chara 水面監視水飛沫 落下水飛沫 \
			-n d:PLAYER \
			-n 敵兵
		command 弾水飛沫処理
	}

	proc 空設定 {
		#if d:DEBUG_PRINT
			print 'w17a_sky_set'
		#endif

//		@昼空	0 -40000 0 -2700 -3700 -2000
		@昼空（レンズフレア指定）	0 -40000 0 -2700 -3700 -2000 1

	}

	proc 天井設定 {
		#if d:DEBUG_PRINT
			print 'ceil_set'
		#endif
		chara 天井君 Ｃ脚天井 -m d:KMS_NAME9 -p 0,0,0  -l d:LT2_NAME -c -14000,0,0 -a 0
		chara 天井君 Ｄ脚天井 -m d:KMS_NAME10 -p 0,0,0  -l d:LT2_NAME -c 14000,0,0 -a 1
	
	}


	//	落し穴設定
	proc 落し穴配置チェック {
		//	アイテムと同じなので、アイテム再セットプロックをそのまま使用する

		@壊れ物再セットチェック $b:w17a_破壊ロード回数[0]
		if ($f:再セットフラグ) {
			eval ($f:w17a_落し穴１開いたフラグ = d:FALSE)
		}

		@壊れ物再セットチェック $b:w17a_破壊ロード回数[1]
		if ($f:再セットフラグ) {
			eval ($f:w17a_落し穴２開いたフラグ = d:FALSE)
		}

		@壊れ物再セットチェック $b:w17a_破壊ロード回数[2]
		if ($f:再セットフラグ) {
			eval ($f:w17a_落し穴３開いたフラグ = d:FALSE)
		}

		@壊れ物再セットチェック $b:w17a_破壊ロード回数[3]
		if ($f:再セットフラグ) {
			eval ($f:w17a_落し穴４開いたフラグ = d:FALSE)
		}

		@壊れ物再セットチェック $b:w17a_破壊ロード回数[4]
		if ($f:再セットフラグ) {
			eval ($f:w17a_落し穴５開いたフラグ = d:FALSE)
		}

	}

	proc 落し穴設定 {
		#if d:DEBUG_PRINT
			print 'w17a_pit_set'
		#endif	
	//	落ちてもセーフ
		//	１階
		if ($f:w17a_落し穴１開いたフラグ == d:FALSE) {
			chara 崩落床 落し穴１ \
				-position -6400,0,2000  \
				-rotate 0,0,0 \
				-map ＣＤ連絡橋 \
				-model w17a_trap_dr1 w17a_trap_dammy1 \
				-hazard -6875,0,1375 \
						-5875,0,1375 \
						-5875,0,2625 \
						-6875,0,2625 \
				-fall_time 30 \
				-fall_pattern 4 \
				-proc 落し穴落下設定１
		} else if ($f:w17a_落し穴１開いたフラグ == d:TRUE) {
			chara 崩落床 落し穴１ \
				-position -6400,0,2000  \
				-rotate 0,0,0 \
				-map ＣＤ連絡橋 \
				-model w17a_trap_dr1 w17a_trap_dammy1 \
				-hazard -6875,0,1375 \
						-5875,0,1375 \
						-5875,0,2625 \
						-6875,0,2625 \
				-fall_time 30 \
				-fall_pattern 4 \
				-status 1 \
				-proc 落し穴落下設定１
		}

	//	落ちるとアウト
		//	Ｂ１西側左
		if ($f:w17a_落し穴２開いたフラグ == d:FALSE) {
			chara 崩落床 落し穴２ \
				-position -2500,-3000,2000 \
				-rotate 0,0,0 \
				-map ＣＤ連絡橋 \
				-model w17a_trap_dr2 w17a_trap_dammy2 \
				-hazard -3000,-3000,1125 \
						-2000,-3000,1125 \
						-2000,-3000,2625 \
						-3000,-3000,2625 \
				-fall_time 30 \
				-fall_pattern 7 \
				-proc 落し穴落下設定２
		} else if ($f:w17a_落し穴２開いたフラグ == d:TRUE) {
			chara 崩落床 落し穴２ \
				-position -2500,-3000,2000 \
				-rotate 0,0,0 \
				-map ＣＤ連絡橋 \
				-model w17a_trap_dr2  w17a_trap_dammy2 \
				-hazard -3000,-3000,1125 \
						-2000,-3000,1125 \
						-2000,-3000,2625 \
						-3000,-3000,2625 \
				-fall_time 30 \
				-fall_pattern 7 \
				-status 1 \
				-proc 落し穴落下設定２
		}

		//	Ｂ１西側右
		if ($f:w17a_落し穴３開いたフラグ == d:FALSE) {
			chara 崩落床 落し穴３ \
				-position -1500,-3000,2000 \
				-rotate 0,0,0 \
				-map ＣＤ連絡橋 \
				-model w17a_trap_dr3  w17a_trap_dammy2 \
				-hazard -2000,-3000,1125 \
						-1000,-3000,1125 \
						-1000,-3000,2625 \
						-2000,-3000,2625 \
				-fall_time 30 \
				-fall_pattern 4 \
				-se_pattern 1 \
				-proc 落し穴落下設定３
		} else if ($f:w17a_落し穴３開いたフラグ == d:TRUE) {
			chara 崩落床 落し穴３ \
				-position -1500,-3000,2000 \
				-rotate 0,0,0 \
				-map ＣＤ連絡橋 \
				-model w17a_trap_dr3 w17a_trap_dammy2 \
				-hazard -2000,-3000,1125 \
						-1000,-3000,1125 \
						-1000,-3000,2625 \
						-2000,-3000,2625 \
				-fall_time 30 \
				-fall_pattern 4 \
				-se_pattern 1 \
				-status 1 \
				-proc 落し穴落下設定３
		}


		//	Ｂ１東側左
		if ($f:w17a_落し穴４開いたフラグ == d:FALSE) {
			chara 崩落床 落し穴４ \
				-position 3500,-3000,2000 \
				-rotate 0 0 0 \
				-map ＣＤ連絡橋 \
				-model w17a_trap_dr2  w17a_trap_dammy2 \
				-hazard 3000,-3000,1125 \
						4000,-3000,1125 \
						4000,-3000,2625 \
						3000,-3000,2625 \
				-fall_time 30 \
				-fall_pattern 7 \
				-proc 落し穴落下設定４
		} else if ($f:w17a_落し穴４開いたフラグ == d:TRUE) {
			chara 崩落床 落し穴４ \
				-position 3500,-3000,2000 \
				-rotate 0 0 0 \
				-map ＣＤ連絡橋 \
				-model w17a_trap_dr2  w17a_trap_dammy2 \
				-hazard 3000,-3000,1125 \
						4000,-3000,1125 \
						4000,-3000,2625 \
						3000,-3000,2625 \
				-fall_time 30 \
				-fall_pattern 7 \
				-status 1 \
				-proc 落し穴落下設定４
		}


		//	Ｂ１東側右
		if ($f:w17a_落し穴５開いたフラグ == d:FALSE) {
			chara 崩落床 落し穴５ \
				-position 4500,-3000,2000 \
				-rotate 0,0,0 \
				-map ＣＤ連絡橋 \
				-model w17a_trap_dr4  w17a_trap_dammy2 \
				-hazard 4000,-3000,1125 \
						5000,-3000,1125 \
						5000,-3000,2625 \
						4000,-3000,2625 \
				-fall_time 30 \
				-fall_pattern 4 \
				-se_pattern 1 \
				-proc 落し穴落下設定５
		} else if ($f:w17a_落し穴５開いたフラグ == d:TRUE) {
			chara 崩落床 落し穴５ \
				-position 4500,-3000,2000 \
				-rotate 0,0,0 \
				-map ＣＤ連絡橋 \
				-model w17a_trap_dr4  w17a_trap_dammy2 \
				-hazard 4000,-3000,1125 \
						5000,-3000,1125 \
						5000,-3000,2625 \
						4000,-3000,2625 \
				-fall_time 30 \
				-fall_pattern 4 \
				-se_pattern 1 \
				-status 1 \
				-proc 落し穴落下設定５
		}


	//	落とし穴上存在判定
		//	１階
#if 0
		trap pi001 d:PLAYER \
			-mask ＊ \
			-exec {
				if ($3 == 入る) {
					//	落し穴上にいるときは落し穴上フラグを立てる
					eval( $f:w17a_落し穴１上フラグ = d:TRUE)

					//	側転で入ったときは側転中フラグを立てる
					command プレイヤー状態取得
					if ($status & d:PFLAG_ROLLING) {
						eval ($f:w17a_側転中１フラグ = d:TRUE)
					}
					//	落し穴がすでに開いている場合、側転中以外ならば落とす
					if ($f:w17a_落し穴１開いたフラグ == d:TRUE) {
						command プレイヤー状態取得
						if ( ( $status & d:PFLAG_ROLLING ) == 0 ) {
							@落し穴落下設定１
						}
					}
				} else if ($3 == いる) {
					//	落し穴上にいるときは落し穴上フラグを立てる
					eval( $f:w17a_落し穴１上フラグ = d:TRUE)

					//	ここにいるときに側転中でない場合は側転中フラグをおろす
					command プレイヤー状態取得
					if ( ( $status & d:PFLAG_ROLLING ) == 0 ) {
						eval ($f:w17a_側転中１フラグ = d:FALSE)
					}
				} else if($3 == 出る) {
		#if d:DEBUG_PRINT
					print 'EXIT'
		#endif
					//	落し穴上から出るときは落し穴上フラグをおろす
					eval( $f:w17a_落し穴１上フラグ = d:FALSE)

					//	側転中フラグが立っていないときは床を落とす
					if ($f:w17a_側転中１フラグ == d:FALSE) {
						//	通り過ぎたら床を落とす
						eval ($f:w17a_落し穴１開いたフラグ = d:TRUE)
						mesg 崩落床 落し穴１ fall
					}
					//	側転中フラグが立っていたらおろす
					if ($f:w17a_側転中１フラグ == d:TRUE) {
						eval ($f:w17a_側転中１フラグ = d:FALSE)
					}
				}
			}
#else
		trap pi001 d:PLAYER \
			-mask ＊ \
			-exec {
				if ($3 == いる) {
					//	落し穴上にいるときは落し穴上フラグを立てる
					eval( $f:w17a_落し穴１上フラグ = d:TRUE)
				} else if($3 == 出る) {
		#if d:DEBUG_PRINT
					print 'EXIT'
		#endif
					//	落し穴上から出るときは落し穴上フラグをおろす
					eval( $f:w17a_落し穴１上フラグ = d:FALSE)

					//	床の状態を取得
					command 崩落床状態取得 \
					-name 落し穴１
					//	床を踏んでいたら床を落とす
					if ( $status == 1) {
						#if d:DEBUG_PRINT
						print 'FLAG_A'
						#endif
						eval ($b:w17a_破壊ロード回数[0] = $w:グローバルロード回数)
						eval ($f:w17a_落し穴１開いたフラグ = d:TRUE)
						mesg 崩落床 落し穴１ fall
					}
				}
			}

#endif



		//	Ｂ１西側左
#if 0
		trap pi002 d:PLAYER \
			-mask ＊ \
			-exec {
				if ($3 == 入る) {
					//	落し穴上にいるときは落し穴上フラグを立てる
					eval ($f:w17a_落し穴２上フラグ = d:TRUE)

					//	側転で入ったときは側転中フラグを立てる
					command プレイヤー状態取得
					if ($status & d:PFLAG_ROLLING) {
						eval ($f:w17a_側転中２フラグ = d:TRUE)
					}
				} else if ($3 == いる) {
					//	落し穴上にいるときは落し穴上フラグを立てる
					eval ($f:w17a_落し穴２上フラグ = d:TRUE)

					//	ここにいるときに側転中でない場合は側転中フラグをおろす
					command プレイヤー状態取得
					if ( ( $status & d:PFLAG_ROLLING ) == 0 ) {
						eval ($f:w17a_側転中２フラグ = d:FALSE)
					}
				} else if ($3 == 出る) {
		#if d:DEBUG_PRINT
					print 'EXIT2'
		#endif
					//	落し穴上から出るときは落し穴上フラグをおろす
					eval( $f:w17a_落し穴２上フラグ = d:FALSE)

					//	側転中フラグが立っていないときは床を落とす
					if ($f:w17a_側転中２フラグ == d:FALSE) {
					print 'FALL2'
						//	通り過ぎたら床を落とす
						eval ($f:w17a_落し穴２開いたフラグ = d:TRUE)
						mesg 崩落床 落し穴２ fall
					}
					//	側転中フラグが立っていたらおろす
					if ($f:w17a_側転中２フラグ == d:TRUE) {
						eval ($f:w17a_側転中２フラグ = d:FALSE)
					}
				}
			}
#else
		trap pi002 d:PLAYER \
			-mask ＊ \
			-exec {
				if ($3 == いる) {
					//	落し穴上にいるときは落し穴上フラグを立てる
					eval ($f:w17a_落し穴２上フラグ = d:TRUE)
				} else if ($3 == 出る) {
