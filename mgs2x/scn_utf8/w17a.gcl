command マップ設定 ＣＤ連絡橋 -set {
	//	デバッグ用
//	eval ($w:p_story = d:ST:P035_01_R01ファットマン爆弾解体終了１無線デモ１終了)
//	eval ($w:p_story = d:ST:P041_02_R01エイムズ死亡後２無線デモ１終了)
	@ダンボール男配置チェック

#if d:SOUND
	@サウンド設定
#endif
	//	ノードアクセス関連
	if ( $f:w16a_ノードフラグ == 1 || $f:w18a_ノードフラグ == 1) {
		@レーダーオンオフチェック 1
	} else {
		@レーダーオンオフチェック 0
	}
	@常駐キャラ設定
	@ローカル変数初期化
	@設定値変更
	@プラグイン設定
	@水位設定

	@プレイヤー設定
#if d:ENEMY
	@敵配置チェック
	@コマンダー設定
#endif
#if d:SV_CAMERA
	@監視カメラ配置チェック
	@監視カメラ設定
#endif

#if d:BGM
	@ＢＧＭ設定
#endif
#if d:SLIDE_DOOR
	@ドア設置
	@主観禁止壁設定
#endif
#if d:LOAD_TRAP
	@ロード設定
#endif
	@オブジェクト設定
#if d:SEA
	@海面設定
#endif
#if d:SKY
	@空設定
#endif
	@天井設定
# if d:PIT
	@落し穴配置チェック
	@落し穴設定
#endif

#if d:ITEM
	@アイテム設定
#endif
#if d:FOG
	@フォグ設定
#endif
#if d:EFFECT
	@エフェクト設定
#endif
	@ＣＤ連絡橋風設定
#if d:BY_MOTION
	@ＣＤ連絡橋ビヨンド設定
#endif
	@カメラセット
	@ＣＤ連絡橋カメラ設定

	@エルード落下死設定
	@ジャンプ落下死設定

	@死体捨て設定

	@ダンボール男設定
	@監視カメラデモ設定
	@シナリオデモキャラセット

#if d:CHARA_LIGHT
	@キャラ用ライト設定
# endif
	@爆弾タイマー設置	//	爆弾イベント用
	@プラント編全体マップ設定  d:ＣＤ連絡橋マップ	//	全体マップ表示

#if d:DEBUG_CHARA
	@デバッグキャラセット
#endif

}

//※※通信機のincludeは移動させないこと！！※※
#include "w17a_cdc.ch"

//初期マップの表示
// -----------------------------------
command マップ表示 	-add ＣＤ連絡橋
@ＣＤ連絡橋開始時処理

//###################################################################################
//									各proc設定
//###################################################################################



//###################################################################################
//									全マップ共通
//###################################################################################

	proc サウンド設定 {
		#if d:DEBUG_PRINT
			print 'sound_set'
		#endif

	//	英語版は
	#ifdef d:ENGLISH
		if ($w:p_story < d:ST:P041_02_R01エイムズ死亡後２無線デモ１終了) {
			chara サウンドマネージャー ＳＤマネ -pak 0
		} else {
			chara サウンドマネージャー ＳＤマネ -pak 1
		}

	//	それ以外は
	#else
//		chara サウンドマネージャー ＳＤマネ -pak 0 -s 0x00000001
		chara サウンドマネージャー ＳＤマネ -pak 0
	#endif

		//		ＳＥ設定
		@サウンド効果音設定
		command 弾痕ノーマル -n 0
		command 弾痕ノーマル -n 1
		command 弾痕ノーマル -n 3

		command 跳弾ノーマル -n 0
		command 跳弾ノーマル -n 1
		command 跳弾ノーマル -n 3

		//	水蒸気
		command 弾痕ノーマル -n 6
		command 跳弾水蒸気中 -n 6

	}

	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT 
			print 'localvar_init'
		#endif
		//	落とし穴上フラグを初期化
		eval ($f:w17a_落し穴１上フラグ = d:FALSE)
		eval ($f:w17a_落し穴２上フラグ = d:FALSE)
		eval ($f:w17a_落し穴３上フラグ = d:FALSE)
		eval ($f:w17a_落し穴４上フラグ = d:FALSE)
		eval ($f:w17a_落し穴５上フラグ = d:FALSE)

		//	監視カメラデモ中フラグを初期化
		eval ($f:w17a_監視カメラデモ中フラグ = d:FALSE)

	//	日本語版
	#ifdef d:JAPANESE
		//	ベリーイージーでは常に落し穴復活
		if ($w:ゲーム設定 == d:LEVEL_VERYEASY) {
			eval ($f:w17a_落し穴１開いたフラグ = d:FALSE)
			eval ($f:w17a_落し穴２開いたフラグ = d:FALSE)
			eval ($f:w17a_落し穴３開いたフラグ = d:FALSE)
			eval ($f:w17a_落し穴４開いたフラグ = d:FALSE)
			eval ($f:w17a_落し穴５開いたフラグ = d:FALSE)
		}
	#endif

		//	側転中フラグを初期化
//		eval ($f:w17a_側転中１フラグ = d:FALSE)
//		eval ($f:w17a_側転中２フラグ = d:FALSE)
//		eval ($f:w17a_側転中３フラグ = d:FALSE)
//		eval ($f:w17a_側転中４フラグ = d:FALSE)
//		eval ($f:w17a_側転中５フラグ = d:FALSE)

/*
		ダンボール男の出現条件はＣ脚内で判定される
		出ないときは$f:w17a_ダンボール男フラグにTRUEが入る

		//	条件は仮
		if ($f:w17a_ダンボール男フラグ == d:FALSE) {
			//	Ｄ脚から来たときはすでにいない
			if ($s:登場ポイント == sp_w18a_w17a_0 ) {
				eval ($f:w17a_ダンボール男フラグ = d:TRUE)
			}
		}
*/
	}
	proc 設定値変更 {
		#if d:DEBUG_PRINT 
			print 'status_set'
		#endif
	}
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif

			command プラグイン落下
	}

//###################################################################################
//									 プレイヤー
//###################################################################################

	proc プレイヤー設定 {
		#if d:RAIDEN
				chara プレイヤー d:PLAYER \
					-m rai_def \
					-a raiden \
					-p $i:プレイヤー初期Ｘ位置 $i:プレイヤー初期Ｙ位置 $i:プレイヤー初期Ｚ位置 \
					-d 0,$i:プレイヤー初期方向,0 \
					-l 4000 \
					-s 0 \
					-o rai_w17a \
					-i 0 
					
				//髪の毛
				@ライデン髪の毛設定 d:NORMAL_HAIR

				//	ＬＯＤ機能
				@プレイヤーＬＯＤ設定 d:C_DISTANCE_TYPE 5000
//				@プレイヤーＬＯＤ設定 d:P_STATE_TYPE d:TRP_STATE_BEHIND

		#else
				chara プレイヤー d:PLAYER \
					-m sna_def \
					-a snake \
					-p $i:プレイヤー初期Ｘ位置 $i:プレイヤー初期Ｙ位置 $i:プレイヤー初期Ｚ位置 \
					-d 0,$i:プレイヤー初期方向,0 \
					-l 4000 \
					-s 0 \
					-o sna_w00a \
					-i 0 
				//バンダナ
				chara ロープモデル３ バンダナ１ \
					-n sna_bdn1 \
					-d 1 \
					-y d:PLAYER \
					-z 12 \
					-x 0,60,-90 \
					-m 12 \
					-p 250 \
					-k 350 \
					-o 110 \
					-f 1
				chara ロープモデル３ バンダナ２ \
					-n sna_bdn2 \
					-d 1 \
					-y d:PLAYER \
					-z 12 \
					-x 0,50,-90 \
					-m 22 \
					-p 250 \
					-k 350 \
					-o 110 \
					-f 1
		#endif
	}

//###################################################################################
//								敵兵
//###################################################################################

	proc 敵配置チェック {
//		自分の来た場所で敵配置変更
		if( $s:登場ポイント == sp_w16a_w17a_0 ) {
			eval($f:w17a_敵配置フラグ = d:STRUT_C)
		} else {
			eval($f:w17a_敵配置フラグ = d:STRUT_D)
		}
	}



//	敵兵配置

//	基本セット

	//	警備兵
	proc 警備兵セット {

		//	ストーリーフラグや難易度で分岐
		//	ダンボール男を見ていないとき
		if ($f:w17a_ダンボール男フラグ == d:FALSE) {

			//	ハード以下
			if ($w:ゲーム設定 <= d:LEVEL_HARD) {

				//	潜入モード時
				if ($w:スタートアラートモード == d:ALERT_MODE_SENNYU) {

					//	Ｃ脚から来たとき
					if ($s:登場ポイント == sp_w16a_w17a_0 ) {
					//	ダンボール男が来るとき
					#if d:DEBUG_PRINT
						print 'KIZETSUKIZETSUKIZETSUKIZETSUKIZETSUKIZETSUKIZETSUKIZETSUKIZETSUKIZETSUKIZETSUKIZETSUKIZETSUKIZETSUKIZETSUKIZETSU'
					# endif
						@警備兵気絶	//	気絶兵

					//	Ｄ脚から来たとき
					} else {
						@警備兵０	//	敵１人

					}

				//	潜入モード以外
				} else {

					//	監視カメラデモを見ていない
					if ($f:w17a_監視カメラデモフラグ == d:FALSE) {
						@警備兵０Ａ	//	敵１人（潜入視力短い）

					//	監視カメラデモを見た後
					} else {
						@警備兵０	//	敵１人
					}
				}

			//	エクストリーム
			} else {
				//	潜入モード時
				if ($w:スタートアラートモード == d:ALERT_MODE_SENNYU) {

					//	Ｃ脚から来たとき
					if ($s:登場ポイント == sp_w16a_w17a_0 ) {
					//	ダンボール男が来るとき
					#if d:DEBUG_PRINT
						print 'KIZETSUKIZETSUKIZETSUKIZETSUKIZETSUKIZETSUKIZETSUKIZETSUKIZETSUKIZETSUKIZETSUKIZETSUKIZETSUKIZETSUKIZETSUKIZETSU'
					# endif
						@警備兵気絶	//	気絶兵

					//	Ｄ脚から来たとき
					} else {
						@警備兵４	//	敵１人下覗き込み２

					}

				//	潜入モード以外
				} else {

					//	監視カメラデモを見ていない
					if ($f:w17a_監視カメラデモフラグ == d:FALSE) {
						@警備兵０Ａ	//	敵１人（潜入視力短い）

					//	監視カメラデモを見た後
					} else {
						@警備兵４	//	敵１人下覗き込み２
					}
				}

			}


		//	ダンボール男を見た（もしくは時間が過ぎた）とき
		} else {
		#if d:DEBUG_PRINT
			print 'NORMAL-NORMAL-NORMAL-NORMAL-NORMAL-NORMAL-NORMAL-NORMAL-NORMAL-NORMAL-NORMAL-NORMAL'
		# endif

			//	ファットマン戦終了まで
			if ($w:p_story < d:ST:P035_01_R01ファットマン爆弾解体終了１無線デモ１終了) {

				//	ハード以下
				if ($w:ゲーム設定 <= d:LEVEL_HARD) {
					//	落し穴が開いていないとき
					if ( ($f:w17a_落し穴１開いたフラグ == d:FALSE ) && ($f:w17a_落し穴２開いたフラグ == d:FALSE ) && \
						($f:w17a_落し穴３開いたフラグ == d:FALSE ) && ($f:w17a_落し穴４開いたフラグ == d:FALSE ) && \
						($f:w17a_落し穴５開いたフラグ == d:FALSE ) ) {

						//	監視カメラデモを見ていない
						if ($f:w17a_監視カメラデモフラグ == d:FALSE) {
							@警備兵０Ａ	//	敵１人（潜入視力短い）

						//	監視カメラデモを見た後
						} else {
							@警備兵０	//	敵１人
						}

					//	落し穴が開いたとき
					} else {
							@警備兵３	//	敵１人下覗き込み１
					}

				//	エクストリーム
				} else {
					//	監視カメラデモを見ていない
					if ($f:w17a_監視カメラデモフラグ == d:FALSE) {
						@警備兵０Ａ	//	敵１人（潜入視力短い）

					//	監視カメラデモを見た後
					} else {
						@警備兵４	//	敵１人下覗き込み２
					}
				}

			//	変装イベント終了まで
			} else if ($w:p_story < d:ST:P041_02_R01エイムズ死亡後２無線デモ１終了) {
				@警備兵２	//	敵２人
			//	その後
			} else {
				@警備兵２	//	敵２人
			}
		}
	}

	//	@警備兵０Ａ	//	敵１人（潜入視力短い）

	//	@警備兵０	//	敵１人
	//	@警備兵１	//	敵１人　下にも行く
	//	@警備兵２	//	敵２人
	//	@警備兵３	//	敵１人下覗き込み１
	//	@警備兵４	//	敵１人下覗き込み２

	//	攻撃兵
	proc 攻撃兵セット {

		//	ストーリーフラグや難易度で分岐

		//	ファットマン戦終了まで
		if ($w:p_story < d:ST:P035_01_R01ファットマン爆弾解体終了１無線デモ１終了) {

			//	監視カメラデモを見ていない
			if ($f:w17a_監視カメラデモフラグ == d:FALSE) {

				//	ノーマル以下
				if ($w:ゲーム設定 <= d:LEVEL_NORMAL) {
					@攻撃兵６Ａ	//	敵１人	ノーマル（サポート兵化）

				//	ハード
				} else if ($w:ゲーム設定 <= d:LEVEL_HARD) {
					@攻撃兵７Ａ	//	敵２人	ノーマル（サポート兵化）

				//	エクストリーム
				} else {
					@攻撃兵ＡＡ	//	敵４人	ノーマル（サポート兵化）
				}

			//	監視カメラデモを見た後
			} else {
			
				//	ノーマル以下
				if ($w:ゲーム設定 <= d:LEVEL_NORMAL) {
//					@攻撃兵０	//	敵１人	ノーマル
					@攻撃兵６	//	敵１人	ノーマル（サポート兵化）

				//	ハード
				} else if ($w:ゲーム設定 <= d:LEVEL_HARD) {
//					@攻撃兵３	//	敵２人	ノーマル
					@攻撃兵７	//	敵２人	ノーマル（サポート兵化）

				//	エクストリーム
				} else {
					@攻撃兵Ａ	//	敵４人	ノーマル（サポート兵化）
				}
			}

		//	その後
		} else if ($w:p_story < d:ST:P041_02_R01エイムズ死亡後２無線デモ１終了) {

			//	イージー以下
			if($w:ゲーム設定 <= d:LEVEL_EASY) {
//				@攻撃兵０	//	敵１人	ノーマル
				@攻撃兵６	//	敵１人	ノーマル（サポート兵化）

			//	ハード以下
			} else if ($w:ゲーム設定 <= d:LEVEL_HARD) {
//				@攻撃兵３	//	敵２人	ノーマル
				@攻撃兵７	//	敵２人	ノーマル（サポート兵化）

			//	エクストリーム
			} else {
				@攻撃兵Ａ	//	敵４人	ノーマル（サポート兵化）
			}
		} else {

			//	イージー以下
			if($w:ゲーム設定 <= d:LEVEL_EASY) {
//				@攻撃兵５	//	敵１人	ハイテクノーマル
				@攻撃兵９	//	敵１人	ハイテクノーマル（サポート兵化）

			//	ハード以下
			} else if ($w:ゲーム設定 <= d:LEVEL_HARD) {
//				@攻撃兵４	//	敵２人	ハイテクノーマル
				@攻撃兵８	//	敵２人	ハイテクノーマル（サポート兵化）

			//	エクストリーム
			} else {
				@攻撃兵Ｂ	//	敵４人	ハイテクノーマル（サポート兵化）
			}

		}
	}

	//	@攻撃兵０	//	敵１人	ノーマル
	//	@攻撃兵１	//	敵２人	盾兵
	//	@攻撃兵２	//	敵２人	ショットガン
	//	@攻撃兵３	//	敵２人	ノーマル
	//	@攻撃兵４	//	敵２人	ハイテクノーマル
	//	@攻撃兵５	//	敵１人	ハイテクノーマル


	//	@攻撃兵６	//	敵１人	ノーマル（サポート兵化）
	//	@攻撃兵７	//	敵２人	ノーマル（サポート兵化）
	//	@攻撃兵８	//	敵２人	ハイテクノーマル（サポート兵化）
	//	@攻撃兵９	//	敵１人	ハイテクノーマル（サポート兵化）

	//	@攻撃兵Ａ	//	敵４人	ノーマル（サポート兵化）
	//	@攻撃兵Ｂ	//	敵４人	ハイテクノーマル（サポート兵化）

	//	@攻撃兵６Ａ	//	敵１人	ノーマル（サポート兵化）
	//	@攻撃兵７Ａ	//	敵２人	ノーマル（サポート兵化）
	//	@攻撃兵ＡＡ	//	敵４人	ノーマル（サポート兵化）



//	コマンダーセット

	//	警備兵
	proc 警備兵コマンダー {
		chara 警備コマンダー wccomm -e { 警備兵セット }
	}
	
	//	攻撃兵
	proc 攻撃兵コマンダー {
		chara 攻撃コマンダー atcomm \
			-e { 攻撃兵セット } \
			-wait (60*3) \			/*危険開始時の出動遅らせ時間*/
			-avoidwait (60*5) \		/*回避モードで始まる場合のみ有効*/
			-status 0x01
	}

	//	コマンダー

	//	司令官音声
	resource ghq_area_alert_voice {
	w17a:
		$t{
			// PLAREA0
			t:vc040154,	//	指揮官　　「了解。増援部隊、ＣＤ連絡橋に急行！敵の前進を阻止せよ！」
			t:vc040155,	//	指揮官　　「了解。バックアップをＣＤ連絡橋へ送る！敵を包囲しろ！」
			-2,
			// PLAREA1
			t:vc040150,	//	指揮官　　「了解。応援部隊、ＣＤ連絡橋へ向かえ！Ｃ脚入口を固めろ！」
			t:vc040151,	//	指揮官　　「了解。増援部隊、ＣＤ連絡橋・Ｃ脚入口へ向かえ！敵を逃がすな！」
			-2,
			// PLAREA2
			t:vc040152,	//	指揮官　　「了解。応援部隊をＣＤ連絡橋に派遣する！Ｄ脚入口を守れ！」
			t:vc040153,	//	指揮官　　「了解。増援部隊、ＣＤ連絡橋・Ｄ脚入口へ向かえ！敵を仕留めろ」
			-1
		}
	}

	resource ghq_caution_voice {

	//	攻撃兵が残っていない場合
	w17a:
		$t{
			t:vc040601,	//	指揮官　　「了解、総員、警戒を強化せよ」

			t:vc040491,	//	指揮官　　「攻撃チームは引き返せ、警戒チームはそのまま現場に残れ」
			t:vc040492,	//	指揮官　　「攻撃チームは撤収、警戒チームは警戒を続行せよ」
			t:vc040493,	//	指揮官　　「攻撃チーム帰投せよ、警戒チームはそのまま警戒に当たれ」
			t:vc040496,	//	指揮官　　「攻撃チーム、配置に戻れ」
			t:vc040497,	//	指揮官　　「攻撃チーム、撤収せよ」
			-2,
			t:vc040424,	//	指揮官　　「ＣＤ連絡橋との連絡が途絶えた」
			-3,
			t:vc040608,	//	カメラ用「異状発生…」
			-1
		}

	//	攻撃兵が残っている場合
	w17a-2:
		$t{
			// PLAREA0
			t:vc040318,	//	指揮官　　「了解。ＣＤ連絡橋を増員する。警戒を強化しろ」

			t:vc040314,	//	指揮官　　「了解。ＣＤ連絡橋・Ｃ脚入口に増員。警戒を強化しろ」
			t:vc040315,	//	指揮官　　「了解。ＣＤ連絡橋を増員する。Ｃ脚入口の警備を固めろ」

			t:vc040316,	//	指揮官　　「了解。ＣＤ連絡橋・Ｄ脚入口に増員。警戒を強化しろ」
			t:vc040317,	//	指揮官　　「了解。ＣＤ連絡橋を増員する。Ｄ脚入口の警備を固めろ」
			-2,
			t:vc040424,	//	指揮官　　「ＣＤ連絡橋との連絡が途絶えた」
			-3,
			t:vc040608,	//	カメラ用「異状発生…」
			-1
		}
	}

	proc コマンダー設定 {
		#if d:DEBUG_PRINT
			print 'commander_set'
		#endif

		chara コマンダー 敵兵セット \
			-w 警備兵コマンダー \
			-a 攻撃兵コマンダー \
			-r -25250,0,-3250 ＣＤ連絡橋 17750,0,-3250 ＣＤ連絡橋 \
			-c -25250,0,-3250 ＣＤ連絡橋 17750,0,-3250 ＣＤ連絡橋 \
			-v [ene_plant_voice:01] \
			-x [ghq_area_alert_voice:w17a] \
			-y [ghq_caution_voice:w17a-2] \
			-z $i:敵標準麻酔持続 \
			-o $i:敵標準気絶持続 \
			-b $w:敵標準再発生数 \
			-s d:ENE_STAGE_GPS \
			-m $w:スタートアラートモード \
			-h $i:標準警戒時間		// 警戒時間

	}



//	警備兵セット

	//	気絶兵１人
	proc 警備兵気絶 {

		//	気絶兵状態セット
		command セット敵兵メモリー \
			w17a \
			ＣＤ連絡橋 \
			敵兵:01 \
			-13000 \
			500 \
			0 \
			3072 \
			d:ENEMEM_ST_FAINT \
			d:ENEMEM_PS_BACK \
			d:FAINT_TIME_3 \
			$w:敵標準気絶  \
			$w:敵標準体力  \
			0 \
			0

		//	気絶兵配置
		chara 警備兵 敵兵:01 -r 0 -d 13000,0,0 ＣＤ連絡橋 -n 0 \
			-h $w:敵標準聴力 \
			-i 4000,$w:敵危険視力,4000 \
			-l $w:敵標準体力 \
			-f $w:敵標準気絶 \
			-s d:ENE_STATUS_EVER_ZZZ \
			-j ドッグタグ_敵兵 \
				[dogtag:plt_w17a_guard_ve_01] [dogtag:plt_w17a_guard_ea_01] [dogtag:plt_w17a_guard_no_01] \
				[dogtag:plt_w17a_guard_ha_01] [dogtag:plt_w17a_guard_vh_01] \
