// 設置オブジェクト
// ------------------------------------
proc 第三船倉セット {
	chara プットオブジェ third_hold_roka \
		-m w04c2 \
		-r 0 0 0 \
		-p 0 0 0 \
		-l d:STAGE_LT2 \
		-s 100 100 100 
}

proc 第三船倉オフ {
	mesg プットオブジェ third_hold off
}

proc 第三船倉オン {
	mesg プットオブジェ third_hold on
}

proc メタルギア零設定 {
	chara プットオブジェ MetalGear_Ray \
		-m ray_w04c1 \
		-r 0 0 0 \
		-p 0 0 0 \
		-l d:STAGE_LT2 \
		-s 100 100 100 
	chara プットオブジェ MetalGear_Ray_canopy \
		-m ray_canopy_w04c1_mt \
		-r 0 0 0 \
		-p 0 0 0 \
		-l d:STAGE_LT2 \
		-s 100 100 100 \
		-f 1
}

proc レイキャノピーオフ {
	mesg プットオブジェ MetalGear_Ray_canopy off
}


