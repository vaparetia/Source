proc P036_11_p07終了 {
	mesg デモキャンセルチェック デモキャンセル kill
	print '$w:p_story = d:ST:P036_11_P07忍者登場１１ポリゴンデモ７終了'
	eval($w:p_story = d:ST:P036_11_P07忍者登場１１ポリゴンデモ７終了)

	chara delay ディレイ -time 1 \ 
		-exec{
			load 'd021p01'
		}
}
