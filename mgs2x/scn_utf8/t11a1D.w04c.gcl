// 各gclで必要なdefine
// ------------------------------------
// モード
#define		STAGE_TANKER	1		// 共通プロック切り分け用
#define		DEMO_STAGE		1		// デモステージかどうかで起動するキャラを切り分ける

// 調整用Define
// ------------------------------------

#define	PLAYER		スネーク
#define SOUND_FG	1
#define LD_FADEOUT	1
#define STAGE_END	1
#define STAGE_HZX	d00a3
#define STAGE_LT2	w04c_demo
#define SCREEN_SHOT	0
#define marines		1


/* 2Dレイアウトドライバ二重起動禁止 */
eval($s:d_num = co_game_demo_stage)
/* 場所はここ（includeの前） */

// include
// ------------------------------------
#include "5sec_bfr_demo.h"
#include "stdch.h"
#include "story.h"
#include "sload.h"
#include "enevoice.h"
#include "demo_vardef.h"
#include "demo_stdch.h"
#include "demo_stdch2.h"

// マップ設定
// ------------------------------------
chara マップ 船倉３ -k w04c1 0 0 0 -h d:STAGE_HZX -l d:STAGE_LT2
command マップ設定 船倉３ -set {
	//	デモ環境かゲーム環境かで起動を読み分ける。
	// ------------------------------------
	#if d:MGS2_DEMO
		// t11 を再生するとき
		eval($s:d_num = t11a1D)
chara デモアクトデバッグ demodebug  -i t:p036_11_p07 -d 'p036_11_p07' -l   \
			-p	第三船倉オフ 第三船倉オン \
				レイキャノピーオフ \
				右舷ドア２３_オフ 右舷ドア２３_オン \
				右舷ドア２３奥_オフ 右舷ドア２３奥_オン \
				左舷ドア２３_オフ 左舷ドア２３_オン \
				左舷ドア２３奥_オフ 左舷ドア２３奥_オン \
				右舷上部ドア２３_オフ 右舷上部ドア２３_オン \
				右舷上部ドア２３奥_オフ 右舷上部ドア２３奥_オン \
				左舷上部ドア２３_オフ 左舷上部ドア２３_オン \
				左舷上部ドア２３奥_オフ 左舷上部ドア２３奥_オン \
				スネーク影出し
		#if d:marines
			@船倉３海兵隊
		#endif
	#else
		if( $w:t_story < d:ST_T11a1D船首メタルギア登場ポリゴンデモ開始 ) { 
			eval($f:global_polygon_demo = 1)
			eval($s:d_num = t11a1D)
			// メタル発見シーンの兵隊は、シナリオ置き
			#if d:marines
				@船倉３海兵隊
			#endif
			@デモモデル差し替え処理
			@デモ再生_t11a群
		} else if( $w:p_story <= d:ST:P036_11_P07忍者登場１１ポリゴンデモ７開始 ) { 
			print '$w:p_story = d:ST:P036_11_P07忍者登場１１ポリゴンデモ７開始'
			eval($s:d_num = P036_11_p07)
			@デモモデル差し替え処理
			@デモ再生_P036_11_p07
		}
		// 本番では共通でつかう
		@デモキャンセルチェックプロック
	#endif
		@常駐キャラ設定
		@シネマスクリーンセット
		@ぼかしセット
		@チェーン設定
		@ドア設置／通路２－船倉３
		@第三船倉セット
		@メタルギア零設定
		@リアル影セット
		#if d:SCREEN_SHOT
			chara スクリーンショット screenshot
		#endif
} // 「command マップ設定 船倉３」の閉じカッコ


// 初期マップの表示
command マップ表示 	-add 船倉３

// 必ずステージのshow(add)の後にセットすること。
//@デフォルトキャラ専用ライトセット

// デモ再生関係用プロック設定
// ------------------------------------
// とりあえずダミープロック
proc null {
}

proc デモキャンセル {
	// ポーズオフ
	command メニュー設定 -p off
	// プログラムで起動しているSEがあれば、ここで切る
	command セットサウンドコード -c d:SNG_FOUTS_S
	command セットサウンドコード -c d:SE_JOUCHUU_OFF
	command StreamStopAll
}

proc デモキャンセルチェックプロック {
	chara デモキャンセルチェック デモキャンセル \
		-p デモキャンセル
}

proc t11a1D系終了 {
	mesg デモキャンセルチェック デモキャンセル kill
	eval($w:t_story = d:ST_T11a1D船首メタルギア登場ポリゴンデモ終了)
	// sload.h では no_save を使っているので、メタル登場ポリデモを何度も
	// 見ないようにストーリーフラグだけはセーブ。
	%varsave $w:t_story
	print '$w:t_story = d:ST_T11a1D船首メタルギア登場ポリゴンデモ終了'
	// リスタート後、ゲーム用の仕様をセットするためにフラグを戻す
	eval($s:d_num = not_demo)
	// 同様、レーダーを出すために必要
	eval($f:global_polygon_demo = 0)
	// デモ終了後のスネーク再セット位置
	if($s:登場ポイント == 東１Ｆ) {
		@mv_w04b_w04c_demo0
	} else if($s:登場ポイント == 西１Ｆ) {
		@mv_w04b_w04c_demo1
	} else if($s:登場ポイント == 東２Ｆ) {
		@mv_w04b_w04c_demo2
	} else if($s:登場ポイント == 西２Ｆ) {
		@mv_w04b_w04c_demo3
	} else {
		@mv_w04b_w04c_demo4
	}
}


proc シネマスクリーンセット  {
	chara シネマスクリーン シネマ \
		-top d:CINEMA_BELT_UPPER \
		-bottom d:CINEMA_BELT_LOWER \
		-ftime 60	//デフォルト値（ゼロは駄目）
	mesg シネマスクリーン シネマ フェードアウト 1
}


