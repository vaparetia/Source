// ぼかしセット
// ------------------------------------
proc ぼかしセット {
	chara 遠景ぼかし far_deforcus \
		-plane	4 \
		-near	6000 \
		-far	9000 

	chara 近景ぼかし near_deforcus \
		-plane	3 \
		-near	0 \
		-far	3000 
}


//###################################################################################
//									海兵隊設定
//###################################################################################

proc 船倉３海兵隊 {
#if d:marines
		if($s:d_num == t11a1D) { 
		print 'marine_001'
			chara 船倉兵 SEALS_1 -a { \
					#include "w04c_seals_matrix.h"
				} \
				-t 100000,100000 \
				-s 4000,-10000,-22000 \
				-m 1 \ // ポリデモです。
				-w 0			//$w:最初の見つめる場所 \ /* 0:プロジェクタ1 1:プロジェクタ２ 2:スコット */
		}
#endif
}

// キャラ用ライトセット
// ------------------------------------
proc デフォルトキャラ専用ライトセット {
	command マップ設定 船倉３ -set {
		chara 環境光 アンビ \
			 -c 6 20 30

		chara 平行光 パラ \
			 -c 86 85 48 \
			 -p -1287 -3357 -5545
	}
}
/*
デフォルトキャラ専用ライトセット
w04cのキャラ平環光セット
w04bのキャラ平環光セット
w04aのキャラ平環光セット
レイコクピットのキャラ平環光セット
*/
// -------------------------------------
// ！！！重要！！！
// -------------------------------------
/* 以下のライトで、
「＊＊＊のプリシェード平環光セット」はプリシェードモデルを置く直前でセット、
 置き終わったら元のものに戻す。（プットオブジェで検索して、ちゃんと置く。
 t04a1D.w00a.gcl参照）
「＊＊＊のキャラ平環光セット」はマックスの方で、随時呼び出すために用意した
 このステージでは、マップ設定でセットしているのは ?????.lt2 である */

// w04cステージにあたる場所での平行、環境光
proc w04cのキャラ平環光セット {
	chara 環境光 w04cキャラ環境光 \
		 -c 73 89 121 
	chara 平行光 w04cキャラ平行光 \
		 -c 61 142 174 \
		 -p -100 -3500 -2000
}
proc w04cのプリシェード平環光セット {
	chara 環境光 w04cプリ環境光 \
		 -c 73 89 121 
	chara 平行光 w04cプリ平行光 \
		 -c 61 142 174 \
		 -p 0 -4300 -2500
}

// w04bステージにあたる場所での平行、環境光
proc w04bのキャラ平環光セット {
	chara 環境光 w04bキャラ環境光 \
		 -c 4 35 44
	chara 平行光 w04bキャラ平行光 \
		 -c 54 86 70 \
		 -p 321 1705 0
}
proc w04bのプリシェード平環光セット {
	chara 環境光 w04bプリ環境光 \
		 -c 28 31 33
	chara 平行光 w04bプリ平行光 \
		 -c 63 80 70 \
		 -p 3800 -3200 -100
}

// w04aステージにあたる場所での平行、環境光
proc w04aのキャラ平環光セット {
	chara 環境光 w04aキャラ環境光 \
		 -c 53,73,55
	chara 平行光 w04aキャラ平行光 \
		 -c 70,230,214 \
		 -p 691,721,0
}
proc w04aのプリシェード平環光セット {
	chara 環境光 w04aプリ環境光 \
		 -c 15,31,33
	chara 平行光 w04aプリ平行光 \
		 -c 64,64,64 \
		 -p 2200,-4300,1000
}

// レイコクピットアップでの平行、環境光
proc レイコクピットのキャラ平環光セット {
	chara 環境光 レイキャラ環境光 \
		 -c 53,73,55
	chara 平行光 w04aキャラ平行光 \
		 -c 70,230,214 \
		 -p 691,721,0
}
proc レイコクピットのプリシェード平環光セット {
	chara 環境光 レイプリ環境光 \
		 -c 15,31,33
	chara 平行光 レイプリ平行光 \
		 -c 64,64,64 \
		 -p 2200,-4300,1000
}

// デモ影用モデル
proc リアル影セット {
	chara 影投影モデル 影床モデル \
		-model w04c1_demo_k1 \
		-pos 0 0 0

	chara 影管理 影床 \
		-type 0 \
		-length 6000
}

proc スネーク影出し {
	mesg 影管理 影床 demo_add sna_def_mh 影床モデル
}


proc デモ再生_t11a群 {
	if( $s:登場ポイント == ダクト ) {
		chara demo デモ再生 \
			-i t:t11a5D \
			-p 	右舷ドア２３_オフ 右舷ドア２３_オン \
				右舷ドア２３奥_オフ 右舷ドア２３奥_オン \
				左舷ドア２３_オフ 左舷ドア２３_オン \
				左舷ドア２３奥_オフ 左舷ドア２３奥_オン \
				右舷上部ドア２３_オフ 右舷上部ドア２３_オン \
				右舷上部ドア２３奥_オフ 右舷上部ドア２３奥_オン \
				左舷上部ドア２３_オフ 左舷上部ドア２３_オン \
				左舷上部ドア２３奥_オフ 左舷上部ドア２３奥_オン \
				スネーク影出し \
			-next t11a1D系終了
	} else if($s:登場ポイント == 東１Ｆ) {
		chara demo デモ再生 \
			-i t:t11a1D \
			-p 	右舷ドア２３_オフ 右舷ドア２３_オン \
				右舷ドア２３奥_オフ 右舷ドア２３奥_オン \
				左舷ドア２３_オフ 左舷ドア２３_オン \
				左舷ドア２３奥_オフ 左舷ドア２３奥_オン \
				右舷上部ドア２３_オフ 右舷上部ドア２３_オン \
