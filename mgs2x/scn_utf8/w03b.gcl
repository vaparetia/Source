}

proc 船倉への水密ドアセット {
	chara 水密ドア 水密君 \
		-kms w03bsdr_body w03bsdr_handle \
		-position 11550,-5000,-70575 \
		-rotate 0,3072,0 \
		-type 1 \
		-proc 船倉へロード \
		-h 11500,-5000,-70500 11550,-5000,-69500


	trap dr010 d:PLAYER \
		-mask いる \
		-button d:ACTION_BUTTON \
		-state 0 \
		-exec {
			command 水密ドア状態 -n 水密君
			mesg プレイヤー d:PLAYER \
				wt_door 水密君 $status \	//$s:水密ドアの名前 $i:そのドアの状態
				3072,1024 \					//$w:ドアに正対した方向 $w:方向幅
				11550,-70575				//$i:ドア位置Ｘ $i:ドア位置Ｚ
		}

	trap dr010 d:PLAYER \
		-mask ？ \
		-state 6 \
		-exec {
/*
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p -16261,-1339,-30543 \
				-t -16969,-3728,-31980 \
				-a 200 \
				-i 2 2 0 0 \
				-s $3
*/
		}

}


proc 開かない左舷へのドア_no_dr000_dr_001 {

	// 左舷へのドア

