//###################################################################################
//									マップ設定
//									command マップ設定より先に置く
//###################################################################################
#ifndef d:BOSS_MODE
// マップ設定
// ------------------------------------
print 'map_000'
chara マップ 中央長廊下 -k d:KMS_NAME2 0,0,(-85500-39500) -h d:HZX_NAME,0 -l d:LT2_NAME
print 'map_001'

chara マップ 右舷長廊下１ -k d:KMS_NAME4 0,0,(-28500-39500) -h d:HZX_NAME,1 -l d:LT2_NAME
print 'map_002'
chara マップ 右舷長廊下３ -k d:KMS_NAME3 0,0,(-57000-39500) -h d:HZX_NAME,2 -l d:LT2_NAME
print 'map_003'

print 'map_004'
chara マップ接合 中長廊下／右長廊下３ 中央長廊下 右舷長廊下３
print 'map_005'
chara マップ接合 右長廊下３／右長廊下１ 右舷長廊下３ 右舷長廊下１
print 'map_006'


//###################################################################################
//							ポリデモのストーリーフラグ制御など
//###################################################################################
// added by S.Hirano 01/02/20
#include "polydemo_w03b.h"


//###################################################################################
//							マップ設定 （command マップ設定）
//###################################################################################

command マップ設定 中央長廊下 右舷長廊下３ 右舷長廊下１ -set {

print '002'
	@ローカル変数初期化
print '003'

// デモでは不要
if($s:d_num == not_demo) {
	@サウンドマネージャー設定
}

//	@プレイヤー振動設定 sna_w00b
print '004'

// デモでは不要
if($s:d_num == not_demo) {
	@跳弾番号設定
print '005'
print '006'
	@プレイヤー設定
print '007'
	@コマンダー設定
print '008'
	@長廊下マップ切り替え
}

print '009'
	@エフェクト設定
print '010'

// デモでは不要
if($s:d_num == not_demo) {
	@カメラセット
print '011'
	@フォグ設定
	@水密ドア管理人セット
	@右舷長廊下透明壁設定
print '012'
	@デバッグキャラセット
}

print '013'
	@遠近ぼかしセット
print '014'
	if($s:d_num == not_demo) {
		@サウンド設定
	}
	@常駐キャラ設定		//デモと共有しているステージはこの位置らしい。

}

command マップ設定 右舷長廊下１ -set {

// デモでは不要
if($s:d_num == not_demo) {
	@船倉への水密ドアセット
}

}
command マップ設定 中央長廊下 -set {

// デモでは不要
if($s:d_num == not_demo) {
	@開かない左舷へのドア_no_dr000_dr_001
}

}

command マップ設定 右舷長廊下１ 右舷長廊下３ 中央長廊下 -set {

// デモでは不要
if($s:d_num == not_demo) {
	@右舷長廊下カメラ設定
	@右舷長廊下アイテム設定
}

#if d:B_LIGHT
	@長廊下壊れライト総合設定
#endif
	@長廊下消火器セット
}

command マップ設定 中央長廊下 -set {
print 'cei_000'
	@長廊下天井設置 d:CEIL_NAME2 (-85500-39500)
print 'cei_001'
	if( $w:t_story != d:ST_T08a1Dハッチ閉鎖ポリゴンデモ開始 ) {
		@長廊下スポットライト設定 d:KMS_NAME2 (-85500-39500)
	}
	@中央長廊下壊れライト設定

// デモでは不要
if($s:d_num == not_demo) {
	@中央長廊下カメラ設定
}

}

command マップ設定 右舷長廊下１ -set {
print 'cei_002'
	@長廊下天井設置 d:CEIL_NAME4 (-28500-39500)
print 'cei_003'

// デモでは不要(5/1追加)
if($s:d_num == not_demo) {
	@長廊下スポットライト設定 d:KMS_NAME4 (-28500-39500)
}
	@長廊下小部屋壊れライト設定 11565 (-28500-39500) 長廊下小部屋壊れライト１ $f:w03b_長廊下小部屋壊れライト１破壊 長廊下羽虫１

// デモでは不要
if($s:d_num == not_demo) {
	@右舷小部屋１カメラ設定
	@右舷小部屋２カメラ設定
}
	@イベント兵登場

	if(  $w:t_story > d:長廊下兵との戦闘突入ポリデモ開始 ) {
		@長廊下兵戦闘時透明壁設定
	}

	@右舷長廊下箱設置
}

command マップ設定 右舷長廊下３ -set {
print 'cei_004'
	@長廊下天井設置 d:CEIL_NAME3 (-57000-39500)
print 'cei_005'
	if( $w:t_story != d:ST_T08a1Dハッチ閉鎖ポリゴンデモ開始 ) {
		@長廊下スポットライト設定 d:KMS_NAME3 (-57000-39500)
	}
	@長廊下小部屋壊れライト設定 11565 (-57000-39500) 長廊下小部屋壊れライト３ $f:w03b_長廊下小部屋壊れライト３破壊 長廊下羽虫３

print 'cei_006'

// デモでは不要
if($s:d_num == not_demo) {
	@右舷小部屋３カメラ設定
	@開かない横廊下へのドア_no_dr100
}
print 'cei_007'

}

command マップ設定 中央長廊下 右舷長廊下３ 右舷長廊下１ -set {
// デモでは不要
	if($s:d_num == not_demo) {
		@キャラ用ライト設置
		@タンカーデジカメ写真判定		//dcam_tanker.hの中にあります。
		//@タンカー編全体マップ設定 d:第二甲板マップ
		@ポーズ時ステージ名表示設定 d:wn_第二甲板右舷

		// ボスラッシュ用extern宣言
		@ボスラッシュ開始時キャラ設定
	}
}

// ------------------------------------
// 無線gclのインクルード。
// 必ずマップ設定と、showコマンドの間に置くこと。
// ------------------------------------
#include "w03b_cdc.ch"
// ------------------------------------
// 無線gclのインクルード終了。
// ここから動かさないこと。
// ------------------------------------

	command マップ表示 -show 中央長廊下
// デモ時の表示マップ
if($s:d_num == t08a1D || $s:d_num == t09a1D) {
	command マップ表示 -show 右舷長廊下１
	command マップ表示 -show 右舷長廊下３

// ゲーム時の表示マップ
} else {
	command マップ表示 -show 右舷長廊下１
	command マップ表示 -show 右舷長廊下３
}

// 全てのセットが終わったところでフェードイン
// デモでは不要
if($s:d_num == not_demo) {
	@右舷長廊下進入時処理
}
// ボスサバイバル用のendif
#endif



// 全マップ共通
	// プラグインプログラム
	// ------------------------------------
	proc プラグイン {
	}

	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		if ($i:プレイヤー初期Ｘ位置 < 0) {
			eval($f:w03b_イベント兵フラグ = 0);
			eval($w:死体数 = 0);
		}
//		eval($f:w03b_イベント兵フラグ = 1);
	}



















//###################################################################################
//									サウンド設定
//###################################################################################



	proc サウンドマネージャー設定 {
		#if d:SOUND
		print 'サウンド設定'

		chara サウンドマネージャー ＳＤマネ -pak 0
		mesg  サウンドマネージャー ＳＤマネ SD_CODE d:SE_REVERB_ON
		#endif
	}



	proc サウンド設定 {
		#if d:SOUND

		print 'bgm_manager'
		print 'ＢＧＭマネージャー呼び出し'
		chara ＢＧＭマネージャー ＢＧＭマネ -s 0x00000001

#if 1
		@サウンド効果音設定
#else

		// 左足
		command 壁床効果音設定 \
			-id 0 \
			-type 0 \
			-se  d:SD_P_FOOTL01 \
			-data  d:se_code:SD_P_FOOT_01L,0 \
				   d:se_code:SD_P_FOOT_02L,0 \
				   d:se_code:SD_P_FOOT_01L,0 \
				   d:se_code:SD_P_FOOT_01L,0 \
				   d:se_code:SD_P_FOOT_01L,0 \
				   d:se_code:SD_P_FOOT_01L,0 \
				   d:se_code:SD_P_FOOT_01L,0 \
				   d:se_code:SD_P_FOOT_01L,0  	// 必ず８セット書くこと
		// 右足
		command 壁床効果音設定 \
			-id 0 \
			-type 0 \
			-se  d:SD_P_FOOTR01 \
			-data  d:se_code:SD_P_FOOT_01R,0 \
				   d:se_code:SD_P_FOOT_02R,0 \
				   d:se_code:SD_P_FOOT_01L,0 \
				   d:se_code:SD_P_FOOT_01L,0 \
				   d:se_code:SD_P_FOOT_01L,0 \
				   d:se_code:SD_P_FOOT_01L,0 \
				   d:se_code:SD_P_FOOT_01L,0 \
				   d:se_code:SD_P_FOOT_01L,0  	// 必ず８セット書くこと

		// 壁叩き音
		command 壁床効果音設定 \
			-id 0 \
			-type 1 \
			-se d:SD_P_WALL02 \
			-data	d:se_code:SD_A_WALLM01,d:NOISE_ZERO \ // 通常
					d:se_code:SD_A_WALLM02,d:NOISE_ZERO \ // 鉄筋
					d:se_code:SD_A_WALLM03,d:NOISE_ZERO \ // 鉄板
					d:se_code:SD_A_WALLM04,d:NOISE_S \	  // 木
					d:se_code:SD_A_WALLM01,d:NOISE_ZERO \
					d:se_code:SD_A_WALLM01,d:NOISE_ZERO \
					d:se_code:SD_A_WALLM01,d:NOISE_ZERO \
					d:se_code:SD_A_WALLM01,d:NOISE_ZERO	// 必ず８セット書くこと

		// 敵兵１用
		// 左足
		command 壁床効果音設定 \
			-id 1 \
			-type 0 \
			-se  d:SD_P_FOOTL01 \
			-data  d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_2L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO 	// 必ず８セット書くこと
		// 右足
		command 壁床効果音設定 \
			-id 1 \
			-type 0 \
			-se  d:SD_P_FOOTR01 \
			-data  d:se_code:SD_E_EFOOT_1R1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_2R1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO 	// 必ず８セット書くこと

		// 敵兵２用
		// 左足
		command 壁床効果音設定 \
			-id 2 \
			-type 0 \
			-se  d:SD_P_FOOTL01 \
			-data  d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_2L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO 	// 必ず８セット書くこと
		// 右足
		command 壁床効果音設定 \
			-id 2 \
			-type 0 \
			-se  d:SD_P_FOOTR01 \
			-data  d:se_code:SD_E_EFOOT_1R1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_2R1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO 	// 必ず８セット書くこと

		// 敵兵３用
		// 左足
		command 壁床効果音設定 \
			-id 3 \
			-type 0 \
			-se  d:SD_P_FOOTL01 \
			-data  d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_2L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO 	// 必ず８セット書くこと
		// 右足
		command 壁床効果音設定 \
			-id 3 \
			-type 0 \
			-se  d:SD_P_FOOTR01 \
			-data  d:se_code:SD_E_EFOOT_1R1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_2R1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO \
				   d:se_code:SD_E_EFOOT_1L1,d:NOISE_ZERO 	// 必ず８セット書くこと
		#endif

#endif

	}

	// 跳弾番号設定
	// ------------------------------------
	proc 跳弾番号設定 {
		print '跳弾番号設定'
		command 跳弾ノーマル -n 0
		command 跳弾ノーマル -n 2
		command 跳弾ノーマル -n 3
		command 跳弾ノーマル -n 4
		command 弾痕ノーマル -n 0
		command 弾痕ノーマル -n 2
		command 弾痕ノーマル -n 3
		command 弾痕ノーマル -n 4

		command 弾痕ノーマル -n 5
		command 弾痕ノーマル -n 6
		command 弾痕ノーマル -n 7
		command 跳弾水蒸気大 -n 5
		command 跳弾水蒸気中 -n 6
		command 跳弾水蒸気小 -n 7
	}



















//###################################################################################
//									プレイヤー設定
//###################################################################################

	// プレイヤー
	// ------------------------------------
	proc プレイヤー設定 {
		#if d:SNAKE
			command ＵＳＰライトＯＮ

			// イベント戦の場合は、しゃがみでスタート
			if( d:長廊下兵との戦闘突入ポリデモ開始 < $w:t_story && \
			    $w:t_story < d:ST_T08a1Dハッチ閉鎖ポリゴンデモ開始 ) {
				eval($b:w03b_開始時スネーク姿勢 = 1)
			} else {
				eval($b:w03b_開始時スネーク姿勢 = 0)
			}

			chara プレイヤー d:PLAYER \
				-p $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,$i:プレイヤー初期Ｚ位置 \
//				-p 9500, -5000, -11000 \
//				-p	16200,-5000,-66750 \
//				-p	17000,-5000,-85750 \
				-d 0,$i:プレイヤー初期方向,0 \
				-s $b:w03b_開始時スネーク姿勢 \
				-m sna_def -a snake -o sna_w02a \
				-i 0

				//バンダナ
				chara ロープモデル３ バンダナ１ \
					-n sna_bdn1 \
					-d 1 \
					-y スネーク \
					-z 12 \
					-x 0,60,-90 \
					-m 12 \
					-p 250 \
					-k 350 \
					-o 110 \
					-f 1

				chara ロープモデル３ バンダナ２ \
					-n sna_bdn2 \
					-d 1 \
					-y スネーク \
					-z 12 \
					-x 0,50,-90 \
					-m 22 \
					-p 250 \
					-k 350 \
					-o 110 \
					-f 1

#if 1
				@プレイヤーＬＯＤ設定 d:C_DISTANCE_TYPE 10000
				//@プレイヤーＬＯＤ設定 d:P_STATE_TYPE d:TRP_STATE_BEHIND
#else
				chara ＬＯＤ制御 プレイヤーＬＯＤ \
					-name d:PLAYER \
					-type 1 \
					-model sna_def_sh \
					-value 5000
#endif


		#else if d:RAIDEN
			chara プレイヤー d:PLAYER \
		//		-p $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,$i:プレイヤー初期Ｚ位置 \
				-p 9500, -5000, -11000 \
				-d 0,$i:プレイヤー初期方向,0 \
				-s 0 \
				-o rai_m00

		#endif
	}


































//###################################################################################
//									長廊下兵設定
//###################################################################################

	// 敵兵
	// ------------------------------------
	#if d:ENEMY

		// イベント

		proc 長廊下兵１ {
			chara 長廊下兵 敵兵:61 -r 3 \
				-s (d:ENE_STATUS_NIGHT_SIGHT) \
				-l $w:敵標準体力 -type 2 // -proc 死体数チェック //-a 1000
			chara 長廊下兵 敵兵:62 -r 3 \
				-s (d:ENE_STATUS_NIGHT_SIGHT) \
				-l $w:敵標準体力 -type 2 //	-proc 死体数チェック //-a 1000
			chara 長廊下兵 敵兵:63 -r 4 \
				-s (d:ENE_STATUS_NIGHT_SIGHT) \
				-l $w:敵標準体力 -type 2  // -proc 死体数チェック //-a 1000
		}


		proc 長廊下戦闘終了 {
			#ifndef d:BOSS_MODE
				command セットサウンドコード -c d:SNG_FOUTS_M		//ＢＧＭフェードアウト
				command パッド操作 -release

				chara delay ディレイ -time 90 -exec{
					chara フェードインアウト フェードアウト \
						-i 0 0 0 0 \		//設定するとこのＲＧＢαから始まる
						-c 0 0 0 128 \		//目標のＲＧＢα
						-t 30 \
						-p 長廊下イベント兵全滅
				}
			#else
			// ボスラッシュモードの設定
				@ボスラッシュ終了時処理
			#endif
		}

		// イベント兵全滅＝デモへ
		proc 長廊下イベント兵全滅 {
				eval( $w:アイテム = d:アイテム:素手 )
				if($w:武器 == d:武器:Ｍ９){
					eval( $w:武器 = d:武器:Ｍ９ )
				}else{
					eval( $w:武器 = d:武器:ＵＳＰ )
				}

				// オセロットゴル兵射殺ポリデモ
				eval($w:t_story = d:ST_T08a1Dハッチ閉鎖ポリゴンデモ開始)
				eval($s:d_num = t09a1D)

				// このフラグでレーダーを切る
				eval($f:global_polygon_demo = 1)

				restart
		}



		// イベント
		proc 長廊下コマンダー１ {
			chara 長廊下コマンダー atcomm \
				-e 長廊下兵１ \
				-defense	\
//					15250,-5000,-70400 0 \
					15500,-5000,-70400 0 \
					18100,-5000,-70700 2 \
					16250,-5000,-67250 1 \
					16250,-5000,-74750 1 \	//追加しました
				-type	1 \
				-light	16260,-2150,(250-28500-39500) \
				16260,-2150,(-4250-28500-39500) \
				-count	1800 \
				-final	17250,-5000,-127000 \
				-proc 長廊下戦闘終了
		}

	#endif

#define 右舷長廊下兵麻酔時間 300
	proc コマンダー設定 {
		#if d:ENEMY
		if($f:w03b_イベント兵フラグ) {

			#ifndef d:BOSS_MODE
				if($w:ゲーム設定 <= d:LEVEL_EASY){
					eval($b:w03b_敵兵発生数 = 4)

				}else if($w:ゲーム設定 == d:LEVEL_NORMAL){
					eval($b:w03b_敵兵発生数 = 5)

				}else{
					eval($b:w03b_敵兵発生数 = 8)

				}
			#else
			// ボスサバイバルはこっち
				if($w:ゲーム設定 < d:LEVEL_EASY){
					eval( $b:w03b_敵兵発生数 = 4 )

				}else if( $w:ゲーム設定 == d:LEVEL_EASY ){
					eval( $b:w03b_敵兵発生数 = 5 )

				}else{
					eval( $b:w03b_敵兵発生数 = 8 )

				}
			#endif


			chara コマンダー 敵兵セット \
				-a 長廊下コマンダー１ \
				-r 14000,-5000,-70000 右舷長廊下１ \
				-c 14000,-5000,-70000 右舷長廊下１\
				-b $b:w03b_敵兵発生数 \
				-g 3 \	//銃ライト
//				-z d:右舷長廊下兵麻酔時間 \
				-s d:ENE_STAGE_NO_WC_GOVER \
				-f -1 0 t:vc042020 t:vc042020_len //「ライトを破壊しろ！」音声
		}
		#endif
	}
















//###################################################################################
//									マップ切り替え設定
//###################################################################################

	// マップ切り替えトラップ
	// ------------------------------------
	proc 長廊下マップ切り替え {
		trap dr001 d:PLAYER \
			-mask 入る \
			-exec {
				mesg マップ接合 中長廊下／右長廊下３ off
				mesg マップ接合 右長廊下３／右長廊下１ off
			}

		trap dr002 d:PLAYER \
			-mask 入る \
			-exec {
				mesg マップ接合 中長廊下／右長廊下３ off
				mesg マップ接合 右長廊下３／右長廊下１ off
			}

		trap dr003 d:PLAYER \
			-mask 入る \
			-exec {
				mesg マップ接合 中長廊下／右長廊下３ off
				mesg マップ接合 右長廊下３／右長廊下１ off
			}

		trap dr004 d:PLAYER \
			-mask 入る \
			-exec {
				mesg マップ接合 中長廊下／右長廊下３ off
				mesg マップ接合 右長廊下３／右長廊下１ off
			}

		trap dr005 d:PLAYER \
			-mask 入る \
			-exec {
				mesg マップ接合 中長廊下／右長廊下３ on
				mesg マップ接合 右長廊下３／右長廊下１ off
			}

		trap dr008 d:PLAYER \
			-mask 入る \
			-exec {
				mesg マップ接合 中長廊下／右長廊下３ on
				mesg マップ接合 右長廊下３／右長廊下１ on
			}

		trap dr006 d:PLAYER \
			-mask 入る \
			-exec {
				mesg マップ接合 中長廊下／右長廊下３ off
				mesg マップ接合 右長廊下３／右長廊下１ on
			}
	}





















