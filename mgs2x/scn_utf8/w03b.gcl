//###################################################################################
//									カメラ設定
//###################################################################################


	// 各種カメラの設定
	// ------------------------------------
	proc 中央長廊下カメラ設定 {
		#if d:STAGE_CAMERA
			// 中央通路
			trap ca002 d:PLAYER \
				-mask ＊ \
				-camera \
				-exec {
					@CS_スムーズカメラ降順 $6 -126500 -127500 -126100 -125750
					eval( $i:補完ＲＺ = $i:CS_結果１ )

					@CS_スムーズカメラ降順 $6 -126000 -126500 1000 750
					eval( $i:補完ＲＸ = $i:CS_結果１ );

					chara カメラ設定 長廊下カメラ２ \
						-c 0 \
						-b 12585,-200,$i:補完ＲＺ 13500,32000,$i:補完ＲＺ \
						-l 12585,-32000,-132000 13500,-3250,-126150 \
						-r $i:補完ＲＸ,2048,0 \
						-f 3500 \
						-a 200 \
						-i 0 0 0 0 \
						-slide 0 20 1000 1000 60 \
						-s $3
				}
		#endif
	}





	// 各種カメラの設定
	// ------------------------------------
	proc 右舷長廊下カメラ設定 {
		#if d:STAGE_CAMERA
			// 右舷通路
			trap ca003 d:PLAYER \
				-mask ＊ \
				-camera \
				-exec {

					if($3 == 入る) {
						print 'ca003_入る'
					} else if($3 == 出る) {
						print 'ca003_出る'
					}

					if ( $4 < 15600 ) {
						@CS_スムーズカメラ降順 $4 15600 15000 3500 2500
						eval( $i:スライド距離 = $i:CS_結果１ );
						eval( $i:スライド距離２ = $i:CS_結果１ );
					} else {
						eval( $i:スライド距離 = 7000 );
						if ($w:アラートモード == 0) {
							eval( $i:スライド距離２ = 3500 );
						} else {
							eval( $i:スライド距離２ = 7000 );
						}
					}

					@CS_スムーズカメラ降順 $6 -37000 -38500 16750 14500
					eval( $i:補完ＬＸ = $i:CS_結果１ );
					@CS_スムーズカメラ降順 $6 -37000 -38500 17000 18250
					eval( $i:補完ＬＸ２ = $i:CS_結果１ );

					@CS_スムーズカメラ降順 $6 -32500 -38000 1000 180
					eval( $i:補完ＲＸ = $i:CS_結果１ );

					if ( $6 > -117500 ) {
						@CS_スムーズカメラ降順 $4 16000 15000 2048 1400
					} else {
						@CS_スムーズカメラ降順 $6 -117500 -125000 2048 2196
					}
					eval( $i:補完ＲＹ = $i:CS_結果１ );

					@CS_スムーズカメラ降順 $6 -37000 -38500 3500 2500
					eval( $w:補完距離 = $i:CS_結果１ );

					if ($f:w03b_イベント兵フラグ == 0) {
						chara カメラ設定 長廊下カメラ \
							-c 0 \
							-b 16750,-4000,-132000 17000,32000,-33000 \
							-l $i:補完ＬＸ,-4000,-132000 $i:補完ＬＸ２,-3250,-33500 \
							-r $i:補完ＲＸ,$i:補完ＲＹ,0 \
							-f $w:補完距離 \
							-a 200 \
							-i 3 -1 0 0 \
							-slide 1 20 $i:スライド距離 $i:スライド距離２ 100 \
							-s $3 \
							-d 0
					} else {
						chara カメラ設定 長廊下カメラ \
							-c 0 \
							-b 16750,-4000,-91000 17000,32000,-33000 \
							-l -32000,-4000,-91000 32000,-3250,-33500 \
//							-b 16750,-4000,-132000 17000,32000,-33000 \
//							-l -32000,-4000,-132000 32000,-3250,-33500 \
							-r 120,0,0 \
							-f 5000 \
							-a 200 \
							-i 0 0 0 0 \
							-s $3 \
							-d 1
					}
				}
		#endif





			trap ca007 d:PLAYER \
				-mask ＊ \
				-camera \
				-exec {

					@CS_スムーズカメラ降順 $4 16000 15000 3500 2500
					eval( $w:補完距離 = $i:CS_結果１ );

					if ( $6 > -117500 ) {
						@CS_スムーズカメラ降順 $4 16000 15500 2048 (4096 - 1400)
					} else {
						@CS_スムーズカメラ降順 $6 -117500 -125000 2048 (4096 - 1400)
					}
					eval( $i:補完ＲＹ = $i:CS_結果１ );

					@CS_スムーズカメラ降順 $6 -37000 -38500 3500 2500
					eval( $w:補完距離 = $i:CS_結果１ );

					chara カメラ設定 長廊下カメラ２ \
						-c 0 \
						-b 16750,-32000,-132000 17000,32000,-33000 \
						-l 14500,-32000,-132000 18250,-3250,-33500 \
						-r 180,$i:補完ＲＹ,0 \
						-f 3500 \
						-a 161 \
						-i 3 -1 0 0 \
						-s $3


				}













	}

	proc 右舷小部屋１カメラ設定 {
		#if d:STAGE_CAMERA
			trap ca005 d:PLAYER \
				-mask ＊ \
				-camera \
				-exec {
					@CS_スムーズカメラ降順 $6 -40500 -41500 1000 650
					eval( $i:補完ＲＸ = $i:CS_結果１ );

					@CS_スムーズカメラ降順 $4 14500 13500 2036 2048
					eval( $i:補完ＲＹ = $i:CS_結果１ );

					chara カメラ設定 長廊下小部屋カメラ \
						-c 0 \
						-b 12750,-32000,-40000 13250,500,-40000 \
						-l 12750,-32000,-132000 13250,32000,-39500 \
						-r $i:補完ＲＸ,$i:補完ＲＹ,0 \
						-f 4000 \
						-a 200 \
						-i 0 0 0 0 \
						-s $3
				}
		#endif
	}

	proc 右舷小部屋２カメラ設定 {
		#if d:STAGE_CAMERA
			trap ca006 d:PLAYER \
				-mask ＊ \
				-camera \
				-exec {
					@CS_スムーズカメラ降順 $6 (-40500-28500) (-41500-28500) 1000 650
					eval( $i:補完ＲＸ = $i:CS_結果１ );

					@CS_スムーズカメラ降順 $4 14500 13500 2036 2048
					eval( $i:補完ＲＹ = $i:CS_結果１ );


					chara カメラ設定 長廊下小部屋カメラ \
						-c 0 \
						-b 12750,-32000,(-40000-28500) 13250,500,(-40000-28500) \
						-l 12750,-32000,-132000 13250,32000,(-39500-28500) \
						-r $i:補完ＲＸ,$i:補完ＲＹ,0 \
						-f 4000 \
						-a 200 \
						-i 0 0 0 0 \
						-s $3
				}
		#endif
	}

	proc 右舷小部屋３カメラ設定 {
		trap ca005 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {

				@CS_スムーズカメラ降順 $6 (-40500-57000) (-41500-57000) -97500 -99000
				eval( $i:補完ＴＺ = $i:CS_結果１ );

				chara カメラ設定 長廊下小部屋カメラ \
					-c 1 \
					-p 13100,30,-97000 \
					-t 13100,-3300,$i:補完ＴＺ \
					-a 200 \
					-i 0 0 0 0 \
					-s $3

			}
	}


	// イベント用トラップ
	// ------------------------------------

	proc イベント兵登場デモ終了 {
		eval( $i:プレイヤー初期Ｘ位置 = 16353 ) ;
		eval( $i:プレイヤー初期Ｙ位置 = -5000 ) ;
		eval( $i:プレイヤー初期Ｚ位置 = -83759 ) ;
		eval( $i:プレイヤー初期方向 = 0 )
		if($w:武器 == d:武器:Ｍ９){
			eval( $w:武器 = d:武器:Ｍ９ )
		}else{
			eval( $w:武器 = d:武器:ＵＳＰ )
		}
		eval( $s:登場ポイント = 長廊下兵戦闘終了 ) ;

		// このフラグでレーダーを出す。
		eval($f:global_polygon_demo = 0)

		restart -s
	}

	proc イベント前各種セット終了 {
		chara delay カメラディレイ \
			-time 10 \
			-exec {
				// これでカメラの南北が変わる。
				eval($f:w03b_イベント兵フラグ = 1)

				// このフラグでレーダーを切る
				eval($f:global_polygon_demo = 1)

				restart
			}
	}




//###################################################################################
//							イベント兵登場デモ呼び出し
//###################################################################################

	proc イベント兵登場 {
		trap ev001 d:PLAYER \
			-mask 入る \
			-exec {
				if( $w:t_story < d:長廊下兵との戦闘突入ポリデモ開始 ) {

					command セットサウンドコード -c d:SNG_FOUTS_S		//ＢＧＭフェードアウト
					command パッド操作 -release

					// 強制移動
					mesg プレイヤー d:PLAYER run \
						16492 -5000 -93242 \
						0 \ // 立ち歩き
						0 \
						d:FA_DIRECT_MOVE

					// 黒フェード
					chara フェードインアウト 黒フェード \
						-c 0 0 0 255 \		//目標のＲＧＢα
						-t 120 \		//変化完了までのフレーム数
						-p イベント前各種セット終了 // \
//						-s 1

					eval($w:t_story = d:長廊下兵との戦闘突入ポリデモ開始)

					// ポリデモで必要なものだけセットするためのフラグ
					eval($s:d_num = t08a1D)

				}
		}
	}














