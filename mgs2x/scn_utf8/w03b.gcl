			if($f:中央長廊下壊れライト８破壊) {
				mesg プットスポットライトオブジェ 中央長廊下壊れライト８ ライト消す
			}

			chara プットスポットライトオブジェ 中央長廊下壊れライト９ \
				-m w03_lit1a w03_lit1b \
				-t -1615,(-2150-300),(-85500-39500-2000) 100 4000 \
