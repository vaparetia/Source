	// 実際のライトのセット
	proc 中央長廊下壊れライト設定 {
		#if d:B_LIGHT
			chara プットスポットライトオブジェ 中央長廊下壊れライト２ \
				-m w03_lit0a w03_lit0b \
				-t 16260,-2150,(-85500-39500+250) 100 4000 \
				-l d:LT2_NAME \
		        -p 16260,0,(-85500-39500+250) \
				-b 中央長廊下ライト壊れプロック２ \
				-f 0x00000004
			if($f:中央長廊下壊れライト２破壊) {
				mesg プットスポットライトオブジェ 中央長廊下壊れライト２ ライト消す
			}

/*
			chara プットスポットライトオブジェ 中央長廊下壊れライト３ \
				-m w03_lit1a w03_lit1b \
				-t -16750,-2150,(-85500-39500-3935) 100 4000 \
				-l d:LT2_NAME \
		        -p -16750,0,(-85500-39500-3935) \
				-b 中央長廊下ライト壊れプロック３ \
				-r 0,1024,0 \
				-f 0x00000004
			if($f:中央長廊下壊れライト３破壊) {
				mesg プットスポットライトオブジェ 中央長廊下壊れライト３ ライト消す
			}
*/

			chara プットスポットライトオブジェ 中央長廊下壊れライト４ \
				-m w03_lit1a w03_lit1b \
				-t 16750,-2150,(-85500-39500-3935) 100 4000 \
				-l d:LT2_NAME \
		        -p 16750,0,(-85500-39500-3935) \
				-b 中央長廊下ライト壊れプロック４ \
				-r 0,1024,0 \
				-f 0x00000004
			if($f:中央長廊下壊れライト４破壊) {
				mesg プットスポットライトオブジェ 中央長廊下壊れライト４ ライト消す
			}

/*
			chara プットスポットライトオブジェ 中央長廊下壊れライト５ \
				-m w03_lit1a w03_lit1b \
				-t -11565,-2150,(-85500-39500-2000) 100 4000 \
				-l d:LT2_NAME \
		        -p -11565,0,(-85500-39500-2000) \
				-b 中央長廊下ライト壊れプロック５ \
				-f 0x00000004
			if($f:中央長廊下壊れライト５破壊) {
				mesg プットスポットライトオブジェ 中央長廊下壊れライト５ ライト消す
			}
*/

			chara プットスポットライトオブジェ 中央長廊下壊れライト６ \
				-m w03_lit1a w03_lit1b \
				-t 11565,-2150,(-85500-39500-2000) 100 4000 \
				-r 0,2048,0 \
				-l d:LT2_NAME \
		        -p 11565,0,(-85500-39500-2000) \
				-b 中央長廊下ライト壊れプロック６ \
				-f 0x00000004
			if($f:中央長廊下壊れライト６破壊) {
				mesg プットスポットライトオブジェ 中央長廊下壊れライト６ ライト消す
			}

/*
			chara プットスポットライトオブジェ 中央長廊下壊れライト７ \
				-m w03_lit1a w03_lit1b \
				-t -7615,(-2150-300),(-85500-39500-2000) 100 4000 \
				-l d:LT2_NAME \
		        -p -7615,-300,(-85500-39500-2000) \
				-b 中央長廊下ライト壊れプロック７ \
				-f 0x00000004
			if($f:中央長廊下壊れライト７破壊) {
				mesg プットスポットライトオブジェ 中央長廊下壊れライト７ ライト消す
			}

			chara プットスポットライトオブジェ 中央長廊下壊れライト８ \
				-m w03_lit1a w03_lit1b \
				-t 7615,(-2150-300),(-85500-39500-2000) 100 4000 \
