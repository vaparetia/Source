				-t 12476,-3494,-127094 \
				-a 200 \
				-i 2 2 0 0 \
				-s $3
		}



//右舷最前部突き当たり水密ドア（ヴァイオリン兵）
	chara 水密ドア 水密君_no_dr001 \
		-kms w03bsdr_body w03bsdr_handle \
		-position 17325,-5000,(-3950-39500-57000-28500) \
		-rotate 0,2048,0 \
		-type 1 \
		-flag d:WT_DOOR_FLAG_NOT_OPEN \
		-h 16175,-5000,(-3950-39500-57000-28500) (16175+1000),-5000,(-3950-39500-57000-28500)

	trap no_dr001 d:PLAYER \
		-mask いる \
		-button d:ACTION_BUTTON \
		-state 0 \
		-exec {
			eval($f:rft_w03b_開かない水密扉dr001開けた = 1)	//fukushima
			command 水密ドア状態 -n 水密君_no_dr001
			mesg プレイヤー d:PLAYER \
				wt_door 水密君_no_dr001 $status \
				2048,1024 \
				11550,(-3950-39500-57000-28500) \
		}

	trap no_dr001 d:PLAYER \
		-mask ？ \
		-state 6 \
		-exec {

			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p 16753,-1795,-126639 \
				-t 16377,-4205,-129288 \
				-a 200 \
				-i 2 2 0 0 \
				-s $3

		}
}








proc 開かない横廊下へのドア_no_dr100 {
	chara 水密ドア 水密君_no_dr100 \
		-kms w01d0tray w03bsdr_handle \
