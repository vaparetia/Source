//###################################################################################
//									ロード入場
//###################################################################################



	proc 右舷長廊下進入時処理{

		if( $s:登場ポイント == 中央長廊下 ){

			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p 13621,-228,-125977 \
				-t 12476,-3494,-127094 \
				-a 200 \
				-i 0 2 0 0 \
				-s 1


			@ステージ開始時処理（ステージ名表示）\
				 d:LOAD_TYPE:WT_DOOR_TYPE 水密君_no_dr000 2000 d:M_TYPE:RUN_CHANGE \
				 d:wn_第二甲板右舷

		}else{	//水密ドア閉めデモあと
			@ロード時フェードイン

		}


	}









//###################################################################################
//									ロード退場
//###################################################################################

	// 入出トラップ
	// ------------------------------------
	proc ロードプロック {
		if ($s:呼び出しプロック == mv_w03b_w03a_0) {
			@mv_w03b_w03a_0
		} else if ($s:呼び出しプロック == mv_w03a_w04a_0) {
			@mv_w03a_w04a_0
		}
	}


	proc 左舷へロード $:トリガ $:実行キャラ {
		#if d:LOAD_TRAP
			if ($:トリガ == 0) {		// 開いたとき
				#if d:STAGE_CAMERA
				chara カメラ設定 ロードカメラ \
					-c 1 \
					-p 12260,-1095,-126765 \
					-t 12262,-4724,-126999 \
					-a 200 \
					-i 2 3 0 0 \
					-s 1
				#endif

				command 無線設定 -reset

				preseek 'w03a'
				@ステージ終了時処理（ステージ名表示） 10500 -5000 -127000 3072 mv_w03b_w03a_0 d:M_TYPE:RUN_CHANGE d:wn_第二甲板左舷

//				@ロード時フェードアウト 10250 -5000 -70000 3072 mv_w03a_w04a_0
			}
		#endif
	}

	proc 船倉へロード $:トリガ $:実行キャラ {
		#if d:LOAD_TRAP
			if ($:トリガ == 0) {		// 開いたとき
				#if d:STAGE_CAMERA
				chara カメラ設定 ロードカメラ \
					-c 1 \
					-p -16180,-1167,-32647 \
					-t -16579,-2877,-32955 \
					-a 200 \
					-i 0 3 0 0 \
					-s 1
				#endif

				command 無線設定 -reset

				@ロード時フェードアウト 10250 -5000 -70000 3072 mv_w03a_w04a_0
			}
		#endif
	}

















//###################################################################################
//									エフェクト設定
//###################################################################################

	// エフェクト関係
	// -----------------------------------
	proc エフェクト設定 {
		#if d:BLUR
		// デモの時だけ使用
		if($s:d_num != not_demo) {
			chara ブラー ブラー -i 10
		}
		#endif

		#if d:BODY_SHADOW
			chara ＯＦＦ制御 off_man
			mesg ＯＦＦ制御 off_man ボディシャドウＯＦＦ
		#endif

		#if d:KIRISAME
			chara 霧雨 霧雨
		#endif
	}

	// ステージカメラ設定
	// ------------------------------------
	proc カメラセット {
		#if d:STAGE_CAMERA
			chara カメラ ステージカメラ	-c 0 -l 3 -p 0
			chara カメラ 長廊下カメラ	-c 0 -l 2 -p 60
			chara カメラ 長廊下カメラ２	-c 0 -l 2 -p 50
			chara カメラ 長廊下小部屋カメラ	-c 0 -l 2 -p 40
			chara カメラ カットインカメラ	-c 0 -l 1 -p 30
			chara カメラ モーションカメラ	-c 0 -l 2 -p 20
			chara カメラ ロードカメラ	-c 0 -l 2 -p 0

			// デフォルトカメラ
			chara カメラ設定 ステージカメラ \
				-c 0 \
				-b -17500,-32000,-132000 -17000,-2750,32000 \
				-l -32000,-32000,-132000 32000,32000,32000 \
				-r 180,2048,0 \
				-f 3000 \
				-a 170 \
				-i 0 0 0 0 \
				-s 1
		#endif
	}

	// フォグ
	// ------------------------------------
	proc フォグ設定 {
		#if d:FOG
			chara フォグ 霧\
				-c 0, 15, 15 \
				-n -3000 \
				-f 50000 -z
		#endif
	}


	// キャラ用光源(マップの設置が終わってから設定することで、キャラだけに光を当てる)
	// ------------------------------------
	proc キャラ用ライト設置 {
		#if d:CHARA_LIGHT
			chara 環境光 環境光源 \
				 -c 29 30 34

			chara 平行光 平行光源 \
				 -c 55 38 4 \
				 -d 512 2560 0
		#endif
	}





	// 天井
	// ------------------------------------
	proc 長廊下天井設置 $:モデル名 $:天井Ｚ座標{
		#if d:CHARA_CEIL
			chara 天井君 左舷天井 -m $:モデル名 -h -1500 -p 0,0,$:天井Ｚ座標 -l d:LT2_NAME
		#endif
	}








	// スポットライト
	// ------------------------------------
	proc 長廊下スポットライト設定 $:モデル名 $:スポットライトＺ座標 {
		#if d:SPOT_LIGHT
			chara スポットライト投影モデル 投影モデル \
				-m $:モデル名 \
				-p 0,0,$:スポットライトＺ座標
		#endif
	}












//###################################################################################
//								長廊下壊れライト設定
//###################################################################################




	// 実際のライトセット
	proc 長廊下壊れライト総合設定 {
#if 1

//タイプ０：つきっぱなしでときどき消える
//タイプ１：消えっぱなしでときどき点く
//タイプ２：よくついたり消えたり
//タイプ３：つきっぱなし
//タイプ４：きえっぱなし

		command foreach -argc 5 -repeat 12 \
			-data { \

				{長廊下壊れライト１＿１,(250-39500),			0,$f:右舷長廊下ライト壊れフラグ１＿１,羽虫１＿１} \
				{長廊下壊れライト１＿２,(-4250-39500),			1,$f:右舷長廊下ライト壊れフラグ１＿２,0} \
				{長廊下壊れライト１＿３,(-11750-39500),			2,$f:右舷長廊下ライト壊れフラグ１＿３,0} \
				{長廊下壊れライト１＿４,(-20750-39500),			3,$f:右舷長廊下ライト壊れフラグ１＿４,羽虫１＿４} \

				{長廊下壊れライト２＿１,(250+(-28500-39500)),	3,$f:右舷長廊下ライト壊れフラグ２＿１,羽虫２＿１} \
				{長廊下壊れライト２＿２,(-4250+(-28500-39500)),	3,$f:右舷長廊下ライト壊れフラグ２＿２,羽虫２＿２} \
				{長廊下壊れライト２＿３,(-11750+(-28500-39500)),3,$f:右舷長廊下ライト壊れフラグ２＿３,羽虫２＿３} \
				{長廊下壊れライト２＿４,(-20750+(-28500-39500)),3,$f:右舷長廊下ライト壊れフラグ２＿４,羽虫２＿４} \
				{長廊下壊れライト２＿５,(250+(-57000-39500)),	3,$f:右舷長廊下ライト壊れフラグ２＿５,羽虫２＿５} \

				{長廊下壊れライト３＿１,(-4250+(-57000-39500)),	2,$f:右舷長廊下ライト壊れフラグ３＿１,0} \
				{長廊下壊れライト３＿２,(-11750+(-57000-39500)),0,$f:右舷長廊下ライト壊れフラグ３＿２,0} \
				{長廊下壊れライト３＿３,(-20750+(-57000-39500)),1,$f:右舷長廊下ライト壊れフラグ３＿３,羽虫３＿３} \

			} \
			-exec { \
				chara プットスポットライトオブジェ $1 \
					-m w03_lit0a w03_lit0b w03_lit0c \
					-t 16260,-2150,$2 100 3000 \
					-l d:LT2_NAME \
					-p 16260,0,$2 \
					-b 長廊下ライト壊れ処理 \
					-f d:BRK_LGT_PUTW03A

				if($4 == 1){
					mesg プットスポットライトオブジェ $1 ライト消す

					if($1 == 長廊下壊れライト２＿１){
						mesg 長廊下コマンダー atcomm ライト破壊 0
					}else if($1 == 長廊下壊れライト２＿２){
						mesg 長廊下コマンダー atcomm ライト破壊 1
					}

				}else{
					@長廊下壊れライトＯＮ／ＯＦＦ操作 $1 $2 $3
				}

				if($5 != 0 && $4 == 0){
					chara 電灯虫 $5 \
						-n	4 \
						-p	16260,-2150,$2 \	// ライト位置 ->> プレイヤー誘導時は無視
						-b	1 \	// 下のバウンディングボックスで壁との当たり見るか  1 : 判定あり, 0 : 判定なし
						-s	(16260-200),(-2150-1000),($2-500) \	// 最小ボックス座標
						-l	(16260+500),(-2150+200),($2+500)	// 最大ボックス座標
				}


			}



#else
		@長廊下壊れライト設定 16260 -39500

		@長廊下壊れライト設定 16260 (-28500-39500)

		@長廊下壊れライト設定 16260 (-57000-39500)
#endif

	}




	proc 長廊下ライト壊れ処理 {
		command foreach -argc 3 -repeat 12 \
			-data { \
				{$1,長廊下壊れライト１＿１,羽虫１＿１}
				{$1,長廊下壊れライト１＿２,羽虫１＿２}
				{$1,長廊下壊れライト１＿３,羽虫１＿３}
				{$1,長廊下壊れライト１＿４,羽虫１＿４}

				{$1,長廊下壊れライト２＿１,羽虫２＿１}
				{$1,長廊下壊れライト２＿２,羽虫２＿２}
				{$1,長廊下壊れライト２＿３,羽虫２＿３}
				{$1,長廊下壊れライト２＿４,羽虫２＿４}
				{$1,長廊下壊れライト２＿５,羽虫２＿５}

				{$1,長廊下壊れライト３＿１,羽虫３＿１}
				{$1,長廊下壊れライト３＿２,羽虫３＿２}
				{$1,長廊下壊れライト３＿３,羽虫３＿３}
			} \
			-exec { \
				if($1 == $2){
					print 'ぶっ壊されてもた'
					@長廊下壊れフラグ処理 $1
					mesg 電灯虫 $3 キル
				}
				if($1 == 長廊下壊れライト２＿１){
					mesg 長廊下コマンダー atcomm ライト破壊 0
				}else if($1 == 長廊下壊れライト２＿２){
					mesg 長廊下コマンダー atcomm ライト破壊 1
				}
			}


	}




	proc 長廊下壊れフラグ処理 $:壊れライト名 {

		if($1 == 長廊下壊れライト１＿１){
			eval($f:右舷長廊下ライト壊れフラグ１＿１ = 1)
		}else if($1 == 長廊下壊れライト１＿２){
			eval($f:右舷長廊下ライト壊れフラグ１＿２ = 1)
		}else if($1 == 長廊下壊れライト１＿３){
			eval($f:右舷長廊下ライト壊れフラグ１＿３ = 1)
		}else if($1 == 長廊下壊れライト１＿４){
			eval($f:右舷長廊下ライト壊れフラグ１＿４ = 1)
		}else if($1 == 長廊下壊れライト２＿１){
			eval($f:右舷長廊下ライト壊れフラグ２＿１ = 1)
		}else if($1 == 長廊下壊れライト２＿２){
			eval($f:右舷長廊下ライト壊れフラグ２＿２ = 1)
		}else if($1 == 長廊下壊れライト２＿３){
			eval($f:右舷長廊下ライト壊れフラグ２＿３ = 1)
		}else if($1 == 長廊下壊れライト２＿４){
			eval($f:右舷長廊下ライト壊れフラグ２＿４ = 1)
		}else if($1 == 長廊下壊れライト２＿５){
			eval($f:右舷長廊下ライト壊れフラグ２＿５ = 1)
		}else if($1 == 長廊下壊れライト３＿１){
			eval($f:右舷長廊下ライト壊れフラグ３＿１ = 1)
		}else if($1 == 長廊下壊れライト３＿２){
			eval($f:右舷長廊下ライト壊れフラグ３＿２ = 1)
		}else if($1 == 長廊下壊れライト３＿３){
			eval($f:右舷長廊下ライト壊れフラグ３＿３ = 1)
		}
	}

















	#include "w03_common.h"

















	// ライトの破壊関連
	proc 長廊下小部屋壊れライト破壊 {
		if($1 == 長廊下小部屋壊れライト１){
			eval($f:w03b_長廊下小部屋壊れライト１破壊 = 1)
			mesg 電灯虫 長廊下羽虫１ キル
		}else if($1 == 長廊下小部屋壊れライト３){
			eval($f:w03b_長廊下小部屋壊れライト３破壊 = 1)
			mesg 電灯虫 長廊下羽虫３ キル
		}
	}

	// 実際のライトセット
	proc 長廊下小部屋壊れライト設定 $:ライトＸ座標 $:ライトＺ座標 $:ライト名 $:長廊下ライト壊れフラグ名 $:虫の名前 {
		#if d:B_LIGHT
			chara プットスポットライトオブジェ $3 \
				-m w03_lit1a w03_lit1b \
				-t $:ライトＸ座標,-2150,(-2000+$:ライトＺ座標) 100 4000 \
				-r 0,2048,0 \
				-l d:LT2_NAME \
				-p $:ライトＸ座標,0,(-2000+$:ライトＺ座標) \
				-b 長廊下小部屋壊れライト破壊 \
				-f 0x00000004
			if($4 == 1) {
				mesg プットスポットライトオブジェ $3 ライト消す
			}else{
				chara 電灯虫 $5 \
					-n	12 \
					-p	$:ライトＸ座標,-2150,(-2000+$:ライトＺ座標) \	// ライト位置 ->> プレイヤー誘導時は無視
					-b	1 \	// 下のバウンディングボックスで壁との当たり見るか  1 : 判定あり, 0 : 判定なし
					-s	($:ライトＸ座標-200),(-2150-200),(-2000+$:ライトＺ座標-200) \	// 最小ボックス座標
					-l	($:ライトＸ座標+200),(-2150+200),(-2000+$:ライトＺ座標+200)	// 最大ボックス座標
			}
		#endif
	}

