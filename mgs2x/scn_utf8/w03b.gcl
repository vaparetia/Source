			if($f:中央長廊下壊れライト１０破壊) {
				mesg プットスポットライトオブジェ 中央長廊下壊れライト１０ ライト消す
			}
*/
		#endif
	}





















//###################################################################################
//									長廊下消火器
//###################################################################################



proc 長廊下消火器セット{


	chara 消火器 消火器２ \
		-r 0 0 0 \
		-p 11650 -5000 (-40400-28500) \
		-l w03b \
		-b (11650 - 2000) -5000 (-40400-28500 - 2000) \
		   (11650 + 2000) -2000 (-40400-28500 + 2000) \
		-i 0 // \	//赤外線センサーに作用
//		-d 0


	chara 消火器 消火器３ \
		-r 0 0 0 \
		-p 11650 -5000 (-40400-57000) \
		-l w03b \
		-b (11650 - 2000) -5000 (-40400-57000 - 2000) \
		   (11650 + 2000) -2000 (-40400-57000 + 2000) \
		-i 0 // \	//赤外線センサーに作用
//		-d 0


	chara 消火器 消火器４ \
		-r 0 0 0 \
		-p 11650 -5000 (-40400-85500) \
		-l w03b \
		-b (11650 - 2000) -5000 (-40400-85500 - 2000) \
		   (11650 + 2000) -2000 (-40400-85500 + 2000) \
		-i 0 // \	//赤外線センサーに作用
//		-d 0


}
















//###################################################################################
//									アイテム設定
//###################################################################################

	proc 右舷長廊下アイテム設定{

		print '長廊下アイテム設定'

		if($w:t_story > d:長廊下兵との戦闘突入ポリデモ開始 ){

//戦闘中ＵＳＰ弾補給
			chara アイテム アイテムボックス \
				-b 0 \
				-p 17250 -5000 -87000 \
				-k handgun_amo_ibox \
				-s handgun_amo_ibox_sh \
				-l usp_amo_label \
				-f d:アイテム種別:武器弾 \
				-i d:武器:ＵＳＰ \
				-n 15 \
				-h 300 \
				-r 0 \
				-x { eval($f:長廊下兵戦ＵＳＰ弾１存在 = 0) }



			chara アイテム アイテムボックス \
				-b 0 \
				-p 17250 -5000 -86000 \
				-k handgun_amo_ibox \
				-s handgun_amo_ibox_sh \
				-l usp_amo_label \
				-f d:アイテム種別:武器弾 \
				-i d:武器:ＵＳＰ \
				-n 15 \
				-h 300 \
				-r 0 \
				-x { eval($f:長廊下兵戦ＵＳＰ弾２存在 = 0) }




#if d:M4_SNAKE
//戦闘中Ｍ４弾補給
			if($w:武器弾数[ d:武器:Ｍ４ ] >= 0){
				chara アイテム アイテムボックス \
					-b 0 \
					-p 16250 -5000 -86000 \
					-k handgun_amo_ibox \
					-s handgun_amo_ibox_sh \
					-l usp_amo_label \
					-f d:アイテム種別:武器弾 \
					-i d:武器:Ｍ４ \
					-n 15 \
					-h 300 \
					-r 0 \
					-x { eval($f:長廊下兵戦Ｍ４弾１存在 = 0) }
			}
#endif


//戦闘中レーション補給
			if($w:ゲーム設定 <= d:LEVEL_EXTREME){
				chara アイテム アイテムボックス \
					-b 0 \
					-p 16250 -5000 -87000 \
					-k ration_ibox \
					-s ration_ibox_sh \
					-l rtn_label \
					-f d:アイテム種別:アイテム \
					-i d:アイテム:レーション \
					-n 1 \
					-h 300 \
					-r 0 \
					-x { eval($f:長廊下兵戦レーション存在 = 0) }
			}

			eval($f:長廊下兵戦ＵＳＰ弾１存在 = 1)
			eval($f:長廊下兵戦ＵＳＰ弾２存在 = 1)
			eval($f:長廊下兵戦Ｍ４弾１存在 = 1)
			eval($f:長廊下兵戦レーション存在 = 1)





			trap ca003 d:PLAYER \
				-mask いる \
				-exec {


					if(!$f:長廊下兵戦ＵＳＰ弾１存在 && $w:武器弾数[ d:武器:ＵＳＰ ] == 0 && \
						`command カメラ視界チェック -camera 0x03 \
							-bound 17240 -5000 -87010 17260 -4500 -86990` == 0){

						chara アイテム アイテムボックス \
							-b 0 \
							-p 17250 -5000 -87000 \
							-k handgun_amo_ibox \
							-s handgun_amo_ibox_sh \
							-l usp_amo_label \
							-f d:アイテム種別:武器弾 \
							-i d:武器:ＵＳＰ \
							-n 15 \
							-h 300 \
							-r 0 \
							-x { eval($f:長廊下兵戦ＵＳＰ弾１存在 = 0) }

						// 弾薬がステージ上に出現（存在）しましたよ。
						eval($f:長廊下兵戦ＵＳＰ弾１存在 = 1)

					}


					if(!$f:長廊下兵戦ＵＳＰ弾２存在 && $w:武器弾数[ d:武器:ＵＳＰ ] == 0 && \
						`command カメラ視界チェック -camera 0x03 \
							-bound 17240 -5000 -86010 17260 -4500 -85990` == 0){

						chara アイテム アイテムボックス \
							-b 0 \
							-p 17250 -5000 -86000 \
							-k handgun_amo_ibox \
							-s handgun_amo_ibox_sh \
							-l usp_amo_label \
							-f d:アイテム種別:武器弾 \
							-i d:武器:ＵＳＰ \
							-n 15 \
							-h 300 \
							-r 0 \
							-x { eval($f:長廊下兵戦ＵＳＰ弾２存在 = 0) }

						// 弾薬がステージ上に出現（存在）しましたよ。
						eval($f:長廊下兵戦ＵＳＰ弾２存在 = 1)

					}

#if d:M4_SNAKE
					if(!$f:長廊下兵戦Ｍ４弾１存在 && $w:武器弾数[ d:武器:Ｍ４ ] == 0 && \
						`command カメラ視界チェック -camera 0x03 \
							-bound 16240 -5000 -86010 16260 -4500 -85990` == 0){

						chara アイテム アイテムボックス \
							-b 0 \
							-p 16250 -5000 -86000 \
							-k handgun_amo_ibox \
							-s handgun_amo_ibox_sh \
							-l usp_amo_label \
							-f d:アイテム種別:武器弾 \
							-i d:武器:Ｍ４ \
							-n 15 \
							-h 300 \
							-r 0 \
							-x { eval($f:長廊下兵戦Ｍ４弾１存在 = 0) }

						// 弾薬がステージ上に出現（存在）しましたよ。
						eval($f:長廊下兵戦Ｍ４弾１存在 = 1)

					}
#endif


					if(!$f:長廊下兵戦レーション存在 && $w:アイテム数[ d:アイテム:レーション ] == 0 && \
						`command カメラ視界チェック -camera 0x03 \
							-bound 16240 -5000 -87010 16260 -4500 -86990` == 0){

						chara アイテム アイテムボックス \
							-b 0 \
							-p 16250 -5000 -87000 \
							-k ration_ibox \
							-s ration_ibox_sh \
							-l rtn_label \
							-f d:アイテム種別:アイテム \
							-i d:アイテム:レーション \
							-n 1 \
							-h 300 \
							-r 0 \
							-x { eval($f:長廊下兵戦レーション存在 = 0) }

						// レーションがステージ上に出現（存在）しましたよ。
						eval($f:長廊下兵戦レーション存在 = 1)

					}

				}

			}




#if d:M4_SNAKE
		//一番奥ドアそば
		if($w:武器弾数[ d:武器:Ｍ４ ] >= 0 ){
			@アイテム再セットチェック $b:w03b_取得ロード回数[0]
			if ($f:再セットフラグ) {
				@弾薬_Ｍ４_初期設置 弾薬_Ｍ４１ 12750 -5000 -128750 0
			}
		}
#endif

		//一番奥右
		@アイテム再セットチェック $b:w03b_取得ロード回数[1]
		if ($f:再セットフラグ) {
			@弾薬_ＵＳＰ_初期設置 弾薬_ＵＳＰ１ 15750 -5000 -128500 0
		}

		//戦闘直前パイプ裏
		@アイテム再セットチェック $b:w03b_取得ロード回数[2]
		if ($f:再セットフラグ) {
			@弾薬_ＵＳＰ_初期設置 弾薬_ＵＳＰ２ 12750 -5000 -100250 0
		}

		@アイテム再セットチェック $b:w03b_取得ロード回数[3]
		if ($f:再セットフラグ) {
			@レーション_初期設置 レーション１ 13000 -5000 -97250 0
		}

#if d:M4_SNAKE
		if($w:武器弾数[ d:武器:Ｍ４ ] >= 0 ){
			@アイテム再セットチェック $b:w03b_取得ロード回数[4]
			if ($f:再セットフラグ) {
				@弾薬_Ｍ４_初期設置 弾薬_Ｍ４２ 12000 -5000 -97250 0
			}
		}
#else
		@アイテム再セットチェック $b:w03b_取得ロード回数[4]
		if ($f:再セットフラグ) {
			@弾薬_Ｍ９_初期設置 弾薬_Ｍ９１ 12300,-5000,-128750 0
		}
#endif

	}



#ifndef d:BOSS_MODE
	proc アイテム取得時番号設定 $:ボックス名 {
	#if d:DEBUG_PRINT
		print 'item_no_set'
	#endif

		if($:ボックス名 == 弾薬_Ｍ４１) {
#if d:M4_SNAKE
			eval($b:w03b_取得ロード回数[0] = $w:グローバルロード回数);
#endif

		}else if($:ボックス名 == 弾薬_ＵＳＰ１) {
			eval($b:w03b_取得ロード回数[1] = $w:グローバルロード回数);

		}else if($:ボックス名 == 弾薬_ＵＳＰ２) {
			eval($b:w03b_取得ロード回数[2] = $w:グローバルロード回数);

		}else if($:ボックス名 == レーション１) {
			eval($b:w03b_取得ロード回数[3] = $w:グローバルロード回数);

#if d:M4_SNAKE
		}else if($:ボックス名 == 弾薬_Ｍ４２) {
			eval($b:w03b_取得ロード回数[4] = $w:グローバルロード回数);
#else
		}else if($:ボックス名 == 弾薬_Ｍ９１) {
			eval($b:w03b_取得ロード回数[4] = $w:グローバルロード回数);
#endif
		}

		#if d:DEBUG_PRINT
			print $:ボックス名
			print $w:グローバルロード回数
		#endif



	}
#endif








// 右舷長廊下
	// 入出トラップ
	// ------------------------------------
	// マップ切り替えトラップ
