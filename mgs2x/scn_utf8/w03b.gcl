		chara 攻撃コマンダー atcomm -e 攻撃兵０
	}
#endif

proc コマンダー設定（ビデオ用） {
	#if d:ENEMY
print 'ene_000'
		chara コマンダー 敵兵セット \
			-w 警備兵コマンダー \
			-a 攻撃兵コマンダー \
			-r 14000,-5000,-97000 右舷長廊下３ \
			-c 14000,-5000,-97000 右舷長廊下３

//	-f $w:ルート $w:ポイント $t:音声 $t:音声時間 ...4


print 'ene_001'
		// 敵兵ルートチェンジ
		trap en001 d:PLAYER \
			-mask 入る \
			-exec {
//				mesg 警備兵 敵兵:01 ルート変更 1 -16000,-5000,-122000 中央長廊下
			}
print 'ene_002'
	#endif
}

