	talk スネーク 標準 -m {
		[TO_ＳＡＶＥ後初めて__e:スネーク_008]
	}

	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ後初めて__e:オタコン_009]
	}

	talk スネーク 標準 -m {
		[TO_ＳＡＶＥ後初めて__e:スネーク_010]
	}
} //v
}

