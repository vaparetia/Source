// ------------------------------------
// 各gclで必要なdefine
// ------------------------------------
// モード
#define		STAGE_VR		1		// 共通プロック切り分け用
#define		VR_WEAPON		1		// 共通プロック切り分け用
#define		STAGE_START		1		//	ゲーム開始直後処理を有効にするため
// ステージ名
#define		STAGE_WP44A		1		// 共通プロック切り分け用
// 敵兵、ＮＰＣ状況（薬莢を呼び分けるのに必要）
#define		ENE_P_GOL		1		// 都市迷彩ゴル兵
#define		ENE_SHOT		1		// ショットガン兵
#define		ENE_HIGH_TECH	1		// ハイテク兵
#define		ENE_SHIELD		1		// 盾兵


// ------------------------------------
// 各種スイッチ用define
// ------------------------------------
// デバッグ関係
#ifdef	d:FIX_MODE
	#define		DEBUG_CHARA		0		// デバッグキャラ全体(FIX時は0)
#else
	#define		DEBUG_CHARA		0		// デバッグキャラ全体
#endif
#define		CHARA_CAMERA	0		// キャラ追従カメラ
#define		TARGET_CHARA	敵兵:01	// キャラ追従カメラのターゲット
#define		SCREENSHOT		0		// スクリーンショット
#define		USB_KEY			1		// USBキーボード


// ------------------------------------
// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME			ws44a
#define		KMS_NAME			ws43a
#define		TONBO_KMS_NAME		ws43a_tonbo
#define		LINE_KMS_NAME		ws43a_line
#define		LT2_NAME			$s:ＶＲライトファイル名

// キャラクター関係
#define		PLAYER		ライデン

// ------------------------------------
// 敵兵音声
// ------------------------------------

// ------------------------------------
// include
// ------------------------------------
#include "rai_wp41a.mh"		// 強制モーションリスト
#include "stdch.h"
#include "enevoice.h"
#include "a_stdproc.h"		// アナザーミッション設定ファイル
#include "sload.h"
#include "item_info.h"
#include "a_item_info.h"
#include "ene_item.h"
#include "vr_common.h"		// ＶＲステージ共通で使用するプロック

// ステージ固有
#include "jump.h"

#if d:USB_KEY
	#include "usbkbd.h"
#endif

// ------------------------------------
// マップ設定
// ------------------------------------
chara マップ ＶＲステージ -k d:KMS_NAME -h d:HZX_NAME,0 -l d:LT2_NAME

command マップ設定 ＶＲステージ -set {
	// ローカルの初期化
	// ------------------------------------
	@ローカル変数初期化		// ローカルで使用する変数で初期化をする場合はここで

	// ＶＲで必要な基本プロックのセット(vr_common.hで定義)
	// サウンドの基本パック、ＶＲの基本システム、プレイヤー、ゴール等を設定します
	// ※このプロックを使用する時は「ＶＲクリア時処理」というプロックが必要です
	// ＶＲ共通プロックセット	$:スネークファイル $:雷電ファイル $:クリア条件フラグ
	//							$:ゴールＸ $:ゴールＹ $:ゴールＺ
	//	VR_GOAL_TARGET	/*的全滅でゴールが開く*/
	//	VR_GOAL_FREE	/*ゴールが最初から開いてる*/
	//	VR_GOAL_ENEMY	/*敵全滅でゴールが開く*/
	//	VR_GOAL_SNEAK	/*潜入モード中はゴールが開く*/
	//	VR_GOAL_TIME	/*タイマーがゼロになるとゴールが開く*/
	// ------------------------------------
	@ＶＲ共通プロックセット sna_wp44a rai_wp44a d:VR_GOAL_TARGET -1000,3000,25000

	// ＶＲウィンドウの設定
	// ------------------------------------
	@武器訓練狙撃４面ＶＲウィンドウ設定

	// クリア時に呼ばれるものの設定
	// ------------------------------------
	@ＶＲクリア設定 p:load_wp45a p:load_wp44a

	// ステージに引かれるライン
	@ＶＲアウトライン d:KMS_NAME d:TONBO_KMS_NAME d:LINE_KMS_NAME

	// 設定値を変更する場合は以下のプロック内で設定
	// ------------------------------------
	@設定値変更				// 敵兵や的のパラメータをステージ限定で変える時はここで
	@プラグイン設定			// プレイヤーのプラグインがいる時はここで

	// 的関係の設定
	// ------------------------------------
	@ＶＲ標的設定				// ＶＲシステム起動後に呼ぶ

	// ＢＧＭの設定(プレイヤー→敵兵→BGMの順で呼ぶ。的の場合は関係ないがとりあえずここに)
	// ------------------------------------
	@ＢＧＭ設定

	// アイテムの設定
	// ------------------------------------
	@アイテム設定

	// 光源、オブジェクト、カメラ関連の設定
	// ------------------------------------

	@ＶＲフォグ設定 -5000 80000 -8000 80000 -7000 75000

	@カメラセット					// chara カメラとベースのカメラを設定
	@ＶＲ面カメラ設定				// ステージ固有のカメラ設定がいる時はこのプロックで
	@ＶＲキャラ用ライト設置			// vr_common.hに定義。必ず最後に設定
	
#if d:DEBUG_CHARA
	@デバッグキャラセット
#endif
}


//初期マップの表示
command マップ表示 -show ＶＲステージ


// 各proc設定
//-------------------------------------------------------------------------------------
// 全マップ共通
	//------------------------------------------------------------
	// ＶＲウィンドウの設定と表示
	//------------------------------------------------------------
	proc 武器訓練狙撃４面ＶＲウィンドウ設定 {
		#if d:DEBUG_PRINT
			print 'vr_window_set'
		#endif

		@ＶＲウィンドウ設定	[VRMSG_J:VRM_WPN_PSG_wp44a] [VRMSG_E:VRM_WPN_PSG_wp44a] \	// 日、英
							[VRMSG_G:VRM_WPN_PSG_wp44a] [VRMSG_F:VRM_WPN_PSG_wp44a] \	// 独、仏
							[VRMSG_I:VRM_WPN_PSG_wp44a] [VRMSG_S:VRM_WPN_PSG_wp44a] \	// 伊、西
							[VRMSG_K:VRM_WPN_PSG_wp44a] \								// 韓
							p:ＶＲステージ開始時処理								// 終了プロック


		// ＶＲウィンドウを表示する
		mesg ＶＲウィンドウ ＶＲウィンドウ君 開く

		// スタート時とクリア時に使用するカットインカメラ
		chara カメラ カットインカメラ		-c 0 -l 0 -p  0

		// スタート時のカメラ(必要な場合)
		chara カメラ設定 カットインカメラ \
			-c 1 \
			-p 26,25384,-7098 -t 26,16581,-11873 \
			-r 700,2048,0 -f 10015 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1
	}

	//------------------------------------------------------------
	// ステージ開始時処理
	//------------------------------------------------------------
	proc ＶＲステージ開始時処理 {
		#if d:DEBUG_PRINT
			print 'game_start!!!!!'
		#endif

		// プレイヤーやパッドの制御等を行う a_stdproc.hで定義
		@全ミッション共通ステージ開始時処理

		// カメラワークスタート(必要な場合)
		// 全体図
		chara カメラ設定 カットインカメラ \
			-c 1 \
			-p 1149,55390,-667 -t 1149,46050,-4287 \
			-r 783,2048,0 -f 10017 \
			-a 200 \
			-i 4 4 d:START_CAMERA_CHANGE_TIME d:START_CAMERA_CHANGE_TIME \
			-s 1

		chara delay ディレイ \
			-time d:START_CAMERA_CHANGE_TIME \
			-exec {
				chara カメラ設定 カットインカメラ -s -1
			}
	}

	// ------------------------------------
	// クリア時の処理
	// ------------------------------------
	proc ＶＲクリア時処理 {
		#if d:DEBUG_PRINT
			print 'clear'
		#endif

		// 強制モーションを発動
		@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_1 d:SOUTH

		// クリア時にカメラアングルを変える
		chara カメラ設定 クリア時カメラ \
			-c 1 \
			-p -1757,3707,28502 -t -1198,4171,25126 \
			-r -88,1941,0 -f 3453 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}



	// ------------------------------------
	// パラメータ系の変更
	// ------------------------------------
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT
			print 'localvar_init'
		#endif

		$$i:フラグ = 0;

		$f:移動的フラグ１ = 0;
		$f:移動的フラグ２ = 0;
		$f:移動的フラグ３ = 0;
		$f:移動的フラグ４ = 0;
	}
	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT
			print 'status_set'
		#endif

	// 初期装備の設定
		eval( $w:アイテム数Ｒ[ d:アイテム:ジアゼパム ] = 1 )
		eval( $w:武器弾数Ｒ[ d:武器:ＰＳＧ１ ] = 61 )

	// ＰＳＧ１を前装備させておく
		command シナリオ前武器変更 -number d:武器:ＰＳＧ１
	// ジアゼパムを装備させておく
		$w:アイテム = d:アイテム:ジアゼパム

	}

	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif
		//command プラグイン自動ジャンプ
	}


	// ------------------------------------
	// 敵兵や的の処理
	// ------------------------------------
	proc ＶＲ標的設定 {
		if( $s:選択プレイヤー == ライデン || \
			$s:選択プレイヤー == プリスキン ) {
			@ライデン的ルート設定
		} else {
			@スネーク的ルート設定
		}

	}

	proc ゲーム開始直後処理 {
		//	的をスタートさせる
		if( $s:選択プレイヤー == ライデン || \
			$s:選択プレイヤー == プリスキン ) {

			@ライデン的スタート
		} else {
			@スネーク的スタート
		}
	}

/*************************************************************************************/
// ライデン的ルート設定
/*************************************************************************************/

proc ライデン的ルート設定 {
		command foreach -argc 5 -repeat 15 \
			-data { \
				{ 移動的:01, 1, ( d:VR_TRG_OCT ), 0, 0 } \	// 初期配置的
				{ 移動的:03, 3, ( d:VR_TRG_OCT ), 0, 0 } \	// 初期配置的
				{ 移動的:05, 5, ( d:VR_TRG_OCT ), 0, 0 } \	// 初期配置的
				{ 移動的:07, 7, ( d:VR_TRG_OCT ), 0, 0 } \	// 初期配置的
				{ 移動的:09, 9, ( d:VR_TRG_OCT ), 0, 0 } \	// 初期配置的
				{ 移動的:02, 2, ( d:VR_TRG_OCT | d:VR_TRG_WAIT ), 2, 2 } \
				{ 移動的:04, 4, ( d:VR_TRG_OCT | d:VR_TRG_WAIT ), 4, 4 } \
				{ 移動的:06, 6, ( d:VR_TRG_OCT | d:VR_TRG_WAIT ), 6, 2 } \
				{ 移動的:08, 8, ( d:VR_TRG_OCT | d:VR_TRG_WAIT ), 8, 3 } \
				{ 移動的:10, 10, ( d:VR_TRG_OCT | d:VR_TRG_WAIT ), 10, 3 } \
				//
				{ 移動的:11, 11, ( d:VR_TRG_OCT | d:VR_TRG_BLAST ), 0, 0 } \		// 初期配置的
				{ 移動的:12, 12, ( d:VR_TRG_OCT ), 0, 0 } \	// 初期配置的
				{ 移動的:13, 13, ( d:VR_TRG_OCT ), 0, 0 } \	// 初期配置的
				{ 移動的:14, 14, ( d:VR_TRG_OCT ), 0, 0 } \	// 初期配置的
				{ 移動的:15, 15, ( d:VR_TRG_OCT | d:VR_TRG_NG ), 0, 0 } \	// 初期配置的
			} \
			-exec { \

				if( $s:選択プレイヤー == プリスキン ) {
					$$b:的セット数 = $$b:的セット数 + 1;
					if( $$b:的セット数 % 2 ) {
						$$i:フラグ = ( $3 | d:VR_TRG_HIDESTART );
					} else {
						$$i:フラグ = ( $3 | d:VR_TRG_VISIBLESTART );
					}
				} else {
					$$i:フラグ = $3;
				}

				chara ＶＲ移動的 $1 \
					-route $2 \
					-flag ( $$i:フラグ | d:VR_TRG_WAIT ) \
					-yshift 0 500 0 \
					-dir 0 0 \
					-speed 10 \
					-x ライデン的ルート変更プロック $4 $5 \
					-c ライデン的破壊プロック
			}
	}

	proc ライデン的スタート {
		mesg ＶＲ的共通 移動的:01 移動開始
		mesg ＶＲ的共通 移動的:03 移動開始
		mesg ＶＲ的共通 移動的:05 移動開始
		mesg ＶＲ的共通 移動的:07 移動開始
		mesg ＶＲ的共通 移動的:09 移動開始
		mesg ＶＲ的共通 移動的:11 移動開始
		mesg ＶＲ的共通 移動的:12 移動開始
		mesg ＶＲ的共通 移動的:13 移動開始
		mesg ＶＲ的共通 移動的:14 移動開始
		mesg ＶＲ的共通 移動的:15 移動開始
	}

	proc ライデン的破壊プロック {
		print '的が破壊されました'
		if( $1 == 移動的:01 ) {
			mesg ＶＲ的共通 移動的:02 移動開始
		} else if( $1 == 移動的:03 ) {
			mesg ＶＲ的共通 移動的:04 移動開始
		} else if( $1 == 移動的:05 ) {
			mesg ＶＲ的共通 移動的:06 移動開始
		} else if( $1 == 移動的:07 ) {
			mesg ＶＲ的共通 移動的:08 移動開始
		} else if( $1 == 移動的:09 ) {
			mesg ＶＲ的共通 移動的:10 移動開始
		}

		if( $1 == 移動的:11 ) {
			chara delay 的消しディレイ -time 120 -exec {
				mesg ＶＲ的共通 移動的:15 消滅
			}
		}
	}

	proc ライデン的ルート変更プロック {
		print 'ルートが変更されました'
		if( $1 == 移動的:02 ) {
			mesg ＶＲ移動的 移動的:02 即ルート変更 1
		} else if( $1 == 移動的:04 ) {
			mesg ＶＲ移動的 移動的:04 即ルート変更 3
		} else if( $1 == 移動的:06 ) {
			mesg ＶＲ移動的 移動的:06 即ルート変更 5
		} else if( $1 == 移動的:08 ) {
			mesg ＶＲ移動的 移動的:08 即ルート変更 7
		} else if( $1 == 移動的:10 ) {
			mesg ＶＲ移動的 移動的:10 即ルート変更 9
		}

	}


/*************************************************************************************/
// スネーク的設定
/*************************************************************************************/

	proc スネーク的ルート設定 {
		@スネーク的セット 移動的:01 51 0 d:VR_TRG_BLAST
		@スネーク的セット 移動的:02 52 0 d:VR_TRG_BLAST
		@スネーク的セット 移動的:03 53 0 d:VR_TRG_BLAST
		@スネーク的セット 移動的:04 54 0 d:VR_TRG_BLAST
		@スネーク的セット 移動的:05 55 0 d:VR_TRG_BLAST
		@スネーク的セット 移動的:06 56 0 d:VR_TRG_BLAST
		@スネーク的セット 移動的:07 57 0 d:VR_TRG_BLAST
		@スネーク的セット 移動的:08 58 0 d:VR_TRG_BLAST
		@スネーク的セット 移動的:09 59 0 d:VR_TRG_BLAST
		@スネーク的セット 移動的:10 60 0 d:VR_TRG_BLAST
		@スネーク的セット 移動的:11 61 0 d:VR_TRG_BLAST
		@スネーク的セット 移動的:12 62 0 d:VR_TRG_BLAST
		@スネーク的セット 移動的:13 63 0 d:VR_TRG_BLAST

		@スネーク的セット 移動的:14 64 0 d:VR_TRG_NG
	}

	proc スネーク的セット $:名前 $:ルート $:ノード $:フラグ {
		// 点滅的の設定
			if( $s:選択プレイヤー == タキシードスネーク || \
				$s:選択プレイヤー == 前作スネーク ) {
				$$b:的セット数 = $$b:的セット数 + 1;
				if( $$b:的セット数 % 2 ) {
					$$i:フラグ = d:VR_TRG_HIDESTART;
				} else {
					$$i:フラグ = d:VR_TRG_VISIBLESTART;
				}
			} else {
				$$i:フラグ = 0;
			}

		chara ＶＲ移動的 $:名前 \
			-route $:ルート $:ノード \
			-flag ( $:フラグ | d:VR_TRG_OCT | d:VR_TRG_WAIT | $$i:フラグ ) \
			-yshift 0 500 0 \
			-dir 0 0 \
			-speed 10 \
			-c スネーク的破壊プロック
	}

	proc スネーク的スタート {
		mesg ＶＲ的共通 移動的 移動開始
	}

	proc スネーク的破壊プロック {
		switch ( $1 ) {
			case ( 移動的:10 ) {
				$f:移動的フラグ１ = 1;
			}
			case ( 移動的:11 ) {
				$f:移動的フラグ２ = 1;
			}
			case ( 移動的:12 ) {
				$f:移動的フラグ３ = 1;
			}
			case ( 移動的:13 ) {
				$f:移動的フラグ４ = 1;
			}
		}

		if( $f:移動的フラグ１ && \
			$f:移動的フラグ２ && \
			$f:移動的フラグ３ && \
			$f:移動的フラグ４ ) {

			$f:移動的フラグ１ = 0;
			$f:移動的フラグ２ = 0;
			$f:移動的フラグ３ = 0;
			$f:移動的フラグ４ = 0;

			chara delay 的消しディレイ -time 120 -exec {
				mesg ＶＲ的共通 移動的:14 消滅
			}
		}
	}

	proc スネーク的ルート変更プロック {
	}



/*************************************************************************************/
// ＢＧＭの設定
/*************************************************************************************/
	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT
			print 'bgm_set'
		#endif

		chara ＢＧＭマネージャー ＢＧＭマネ
	}

	// ------------------------------------
	// アイテムの設定
	// ------------------------------------
	// 再発生が必要な時は以下のプロックの中を記述する
	// ------------------------------------
	proc アイテム取得時番号設定 $:ボックス名 {
		#if d:DEBUG_PRINT
			print 'item_no_set'
		#endif
	}
	// アイテムの設置
	// ------------------------------------
	proc アイテム設定 {
		#if d:DEBUG_PRINT
			print 'item_set'
		#endif

		switch ( $s:選択プレイヤー ) {
			case ( ライデン ) {
				@A_ジアゼパム_初期設置 ジアゼパム:01 4450,5000,27350 d:アイテム水飛沫無 2
				@A_ジアゼパム_初期設置 ジアゼパム:02 -6000,0,27500 d:アイテム水飛沫無 2
			}
			case ( スネーク ) {
				@A_ジアゼパム_初期設置 ジアゼパム:01 4450,5000,27350 d:アイテム水飛沫無 2
				@A_ジアゼパム_初期設置 ジアゼパム:02 -6000,0,27500 d:アイテム水飛沫無 2
			}
			case ( プリスキン ) {
				@A_ジアゼパム_初期設置 ジアゼパム:01 4450,5000,27350 d:アイテム水飛沫無 2
			}
			case ( タキシードスネーク ) {
				@A_ジアゼパム_初期設置 ジアゼパム:02 -6000,0,27500 d:アイテム水飛沫無 2
			}
			case ( 前作スネーク ) {
			}
		}
	}

	// ------------------------------------
	// 光源関係
	// ------------------------------------

	// ------------------------------------
	// キャラ用光源(マップの設置が終わってから設定することで、キャラだけに光を当てる)
	// ------------------------------------

	// ------------------------------------
	// カメラ関係の設定
	// ------------------------------------
	// ステージカメラ設定
	// ------------------------------------
	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'chara_camera & stage_camera_set'
		#endif

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0
		chara カメラ メインカメラ		-c 0 -l 2 -p 40
		chara カメラ クリア時カメラ		-c 0 -l 0 -p 10

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 261,2048,0 -f 10022 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
/*
		// デバッグ用カメラ設定
		chara カメラ設定 メインカメラ \
			-c 1 \
			-p 708,32525,-13403 -t 708,22827,-15896 \
			-r 860,2048,0 -f 10014 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
*/


	}
	// ステージ固有のカメラ設定
	// ------------------------------------
	proc ＶＲ面カメラ設定 {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif
	}





// -----------------------------------------------------------------------------------
// 以下デバッグ専用proc
// -----------------------------------------------------------------------------------
// デバッグキャラ
// ------------------------------------
proc デバッグキャラセット {
	#if d:DEBUG_PRINT
		print 'debug_chara_set'
	#endif

	#if d:CHARA_CAMERA
		chara キャラカメラ 敵兵カメラ \
			-c d:TARGET_CHARA \
			-s -920,610,200 \
			-r -200,1024,0
	#endif

	#if d:SCREENSHOT
		chara スクリーンショット shot
	#endif

	#if d:USB_KEY
		chara USBキーボード実行 test \
			-e d:KBD_R {
			}
	#endif
}

