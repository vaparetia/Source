// マップ設定
// ------------------------------------
chara マップ 発着口 -k d:KMS_NAME0 -h d:HZX_NAME,0 -l d:LT2_NAME
chara マップ 連結ハッチ -k d:KMS_NAME1 -h d:HZX_NAME,1 -l d:LT2_NAME
chara マップ 昇降機ホール -k d:KMS_NAME2 -k d:KMS_NAME3 -h d:HZX_NAME,2 -l d:LT2_NAME

chara マップ接合 発着口／連結ハッチ 発着口 連結ハッチ
chara マップ接合 連結ハッチ／昇降機ホール 連結ハッチ 昇降機ホール

command マップ設定 昇降機ホール -set {
	// デモorゲームにかかわらずセットする
	command フォーチュン索敵初期化

// プレイヤーを乗っけるために先に定義
	if( $s:登場ポイント == sp_w12a_w11b_0 ) {
	// 上からきたときのみ設置する
		@昇降機設置					// w11abc_common.hで定義
	}
}

command マップ設定 発着口 連結ハッチ 昇降機ホール -set {
// サウンド、キャラクターのセット
// ------------------------------------
#if d:SOUND	
	@サウンド設定				// データは最初に呼ぶ。w11abc_common.hで定義
#endif
	@レーダーオンオフチェック $f:w11a_ノードフラグ	// stdproc.hで定義
	@常駐キャラ設定				// stdch.hで定義
	@ローカル変数初期化			// w11abc_common.hで定義
	@設定値変更					// w11abc_common.hで定義
	@レーダーオンオフチェック $f:w11a_ノードフラグ	// stdch.hで定義
	@シナリオデモキャラセット	// stdproc.hで定義
	@プラグイン設定				// w11abc_common.hで定義
	@プレイヤー設定				// w11abc_common.hで定義
#if d:JP_MOTION
	@ジャンプ設定				// w11ab_common.hで定義
#endif
	@弾痕跳弾設定				// w11abc_common.hで定義
// マップ切り替え、ロード、ドア
// ------------------------------------
#if d:SLIDE_DOOR
	@ドア設置					// w11abc_common.hで定義
#endif
#if d:LOAD_TRAP
	@昇降機ホールロード設定		// w11ab_common.hで定義
#endif
// ステージ、オブジェクト関連
// ------------------------------------
	@プラント編全体マップ設定 d:Ａ脚マップ	// stdproc.hで定義
	@爆弾タイマー設置			// stdproc.hで定義（ストリーフラグで自動判別）
#if d:FOG
	@フォグ設定					// w11abc_common.hで定義
#endif
	@カメラセット				// w11abc_common.hで定義

// デバッグキャラ、仮キャラ
// ------------------------------------
#if d:DEBUG_CHARA
//	@デバッグキャラセット		// w11ab_common.hで定義
#endif
}

command マップ設定 発着口 連結ハッチ -set {
#if d:WT_DOOR
	@水密ドア設置				// w11ab_common.hで定義
#endif
}

command マップ設定 発着口 -set {
#if d:CHARA_CEIL
	@発着口天井設置			// w11ab_common.hで定義
#endif
#if d:ITEM
	@発着口アイテム設置		// w11abc_common.hで定義
#endif
#if d:TR_WALL
	@透明壁設置					// w11ab_common.hで定義
#endif
#if d:LOCKER
	@ロッカー設置				// w11ab_common.hで定義
#endif
	@イントルード金網設定			// w11ab_common.hで定義
#if d:SUBMARINE
	@潜水艇設置					// w11ab_common.hで定義
#endif
	@発着口壁スポットライト		// w11ab_common.hで定義
	@フナ虫設定					// w11ab_common.hで定義
	@メニューフナムシ取り付き設定	// stdproc.hで定義
#if d:C4_BOMB
	@解体Ｃ４設置				// w11ab_common.hで定義
#endif
#if d:BY_MOTION
	@発着口ビヨンド設定		// w11ab_common.hで定義
#endif
	@発着口カメラ設定		// w11ab_common.hで定義
#if d:WATER
	@水中モード基本キャラ設定
	@エルード時の体水飛沫設定	// w11ab_common.hで定義
	@敵兵水落ち設定				// w11ab_common.hで定義
	@発着口水面設定			// w11ab_common.hで定義
	@発着口水中モードプレイヤー連動キャラ設定	// w11ab_common.hで定義
#endif
	@フェンスドア設定				// w11ab_common.hで定義
}

command マップ設定 連結ハッチ -set {
#if d:CHARA_CEIL
	@連結ハッチ天井設置			// w11ab_common.hで定義
#endif
	@連結ハッチカメラ設定		// w11ab_common.hで定義
// デバッグキャラ、仮キャラ
// ------------------------------------
	@爆弾解体後昇降機ホール１無線デモ１設定
}

command マップ設定 昇降機ホール -set {
#if d:NODE
	@ノード端末設定 1536			// stdproc.hで定義
#endif
#if d:CHARA_CEIL
	@デモ中壊れオブジェクト設定		// w11abc_common.hで定義
	@昇降機ホール天井設置			// w11abc_common.hで定義
	@天井崩れ						// w11bc_common.hで定義
#endif
#if d:ITEM
	@昇降機ホールアイテム設置		// w11abc_common.hで定義
#endif
	@昇降機ホール揺れライト設定		// w11abc_common.hで定義
	@昇降機ホール壁ライト設定		// w11abc_common.hで定義
	@昇降機ホール壁スポットライト	// w11abc_common.hで定義
	@昇降機ホールオブジェ設置 5		// w11bc_common.hで定義
	@昇降機ホールスポットライト設定 // w11abc_common.hで定義
	@昇降機ホールカメラ設定
}

// キャラ用ライトは最後に設定
command マップ設定 発着口 連結ハッチ 昇降機ホール -set {
#if d:CHARA_LIGHT
	@キャラ用ライト設置				// w11abc_common.hで定義
#endif
}


// 無線用include ※位置は動かさないこと
#include "w11b_cdc.ch"
#include "p_force_cdc.ch"


// 全てのセットが終わったところでフェードイン
if( $s:登場ポイント == sp_w12a_w11b_0 ) {
	//初期マップの表示
	command マップ表示 -show 昇降機ホール
	mesg マップ接合 発着口／連結ハッチ on

	// 全てのセットが終わったところでフェードイン
	@ステージ開始時処理（昇降機） d:wn_Ａ脚底部海底ドック

} else if ( $s:登場ポイント == 爆弾解体終了１無線デモ１終了後 ) {
// 無線デモ後
	command マップ表示 -show 発着口
	command マップ表示 -show 連結ハッチ
	mesg マップ接合 発着口／連結ハッチ on
	// 無効にしていたロードプロックと無線用プロックを起動
	command トラップ切り替え -trap ev010 -switch 1
	command トラップ切り替え -trap ld002 -switch 1
	@ロード時フェードイン
} else {
// 無線デモ後
	command マップ表示 -show 発着口
	command マップ表示 -show 連結ハッチ
	mesg マップ接合 発着口／連結ハッチ on
	@ロード時フェードイン
	// 無効にしていたロードプロックと無線用プロックを起動
	command トラップ切り替え -trap ld002 -switch 1
}



// 各proc設定
//-------------------------------------------------------------------------------------
// 全マップ共通
	// ノード端末
	// ------------------------------------
	proc ノード接続時プロック {
		#if d:DEBUG_PRINT
			print 'node_set'
		#endif

		eval($f:ノードフラグ = $f:w11a_ノードフラグ);
	}


	proc ノード接続後プロック {
		#if d:DEBUG_PRINT
			print 'node_event_go'
		#endif

		eval($f:w11a_ノードフラグ = 1);
		command メニュー設定 -node_access on 
	}

	// 無線デモ
	// ------------------------------------
	proc 爆弾解体後昇降機ホール１無線デモ１設定 {
		#if d:DEBUG_PRINT
			print 'codec_demo_set'
		#endif

		// このトラップは爆弾解体終了後起動
		trap ev010 d:PLAYER \
			-mask 入る \
			-exec {
				if ( $w:p_story < d:ST:P027_01_R01爆弾解体後昇降機ホール１無線デモ１開始 ) {
					eval ( $w:p_story = d:ST:P027_01_R01爆弾解体後昇降機ホール１無線デモ１終了 );
					eval( $i:プレイヤー初期Ｘ位置 = $i:プレイヤー位置Ｘ ) ;
					eval( $i:プレイヤー初期Ｙ位置 = $i:プレイヤー位置Ｙ ) ;
					eval( $i:プレイヤー初期Ｚ位置 = $i:プレイヤー位置Ｚ ) ;
					eval( $i:プレイヤー初期方向 = $w:プレイヤー方向 )
					eval( $b:プレイヤー初期姿勢 = $w:プレイヤー姿勢 ) ;
					eval( $s:登場ポイント = 昇降機ホール１無線デモ１後 );
					@昇降機ホール揺れフラグチェック			// w11abc_common.h
					@rt_P027_01_R01爆弾解体後昇降機ホール１無線デモ１
				}
			}
	}


// 各マップ別設定
// ------------------------------------
// 昇降機ホール
	// 各種カメラの設定
	// ------------------------------------
	proc 昇降機ホールカメラ設定 {
		#if d:DEBUG_PRINT
			print 'w11a2_camera_set'
		#endif

		trap ca021 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				if ( $w:p_story > d:ST:P027_01_R01爆弾解体後昇降機ホール１無線デモ１開始 && $w:p_story <= d:ST:P028_01_P01爆弾解体後フォーチュン再登場１ポリゴンデモ１開始 ) {
					// 爆弾解体終了後はポリデモへ飛ぶので、カメラを変化させない
					chara カメラ設定 メインカメラ \
						-c 0 \	
						-b -11316,-39467,4286 -8474,-39467,4286 \
						-l -11316,-43497,2993 -8474,-43497,2993 \
						-r 821,2048,0 \
						-f 4239 \
						-a 200 \
						-i 0 0 0 0 \
						-z d:CAMERA_NO_CUSHION \
						-s $3
				} else {
					@CS_スムーズカメラ降順 $6 6000 4000 876 500
					eval( $i:補完ＲＸ = $i:CS_結果１ );

					chara カメラ設定 メインカメラ \
						-c 0 \	
						-b -2500,-38000,1000 2500,-38000,5776 \
						-l -2500,-43653,-5000 2500,-43653,4249 \
						-r $i:補完ＲＸ,2048,0 \
						-f 7500 \
						-a 200 \
						-i 2 -1 0 0 \
						-s $3
				}

			}

		trap ca022 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ降順 $6 -4000 -5000 -2300 -850
				eval( $i:補完ＢＸ = $i:CS_結果１ );

				@CS_スムーズカメラ降順 $6 -4000 -5000 2300 850
				eval( $i:補完ＢＸ２ = $i:CS_結果１ );

				@CS_スムーズカメラ降順 $6 -4000 -5000 -38000 -38500
				eval( $i:補完ＢＹ = $i:CS_結果１ );

				chara カメラ設定 メインカメラ \
					-c 0 \	
					-b $i:補完ＢＸ,$i:補完ＢＹ,-434 $i:補完ＢＸ２,$i:補完ＢＹ,5776 \
					-l $i:補完ＢＸ,-43653,-5834 $i:補完ＢＸ２,-43653,4249 \
					-r 500,2048,0 \
					-f 7500 \
					-a 200 \
					-i 3 3 0 0 \
					-s $3
			}

		// エレベーター
		trap ca023 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ \
					-c 1 \	
					-p 0,-42999,-3037 -t 0,-43401,-6872 \
					-r 68,2048,0 -f 3856 \
					-a 200 \
					-i 0 1 0 0 \
					-s $3
			}

		// 連結通路扉前
		trap ca024 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				if ( $w:p_story > d:ST:P027_01_R01爆弾解体後昇降機ホール１無線デモ１開始 && $w:p_story <= d:ST:P028_01_P01爆弾解体後フォーチュン再登場１ポリゴンデモ１開始 ) {
					// 爆弾解体終了後はポリデモへ飛ぶので、カメラを変化させない
					chara カメラ設定 メインカメラ \
						-c 0 \	
						-b -11316,-39467,4286 -8474,-39467,4286 \
						-l -11316,-43497,2993 -8474,-43497,2993 \
						-r 821,2048,0 \
						-f 4239 \
						-a 200 \
						-i 0 0 0 0 \
						-z d:CAMERA_NO_CUSHION \
						-s $3
				} else {
					@CS_スムーズカメラ降順 $6 6000 4000 876 500
					eval( $i:補完ＲＸ = $i:CS_結果１ );

					chara カメラ設定 サブカメラ \
						-c 0 \	
						-b -4250,-38000,1000 2500,-38000,5776 \
						-l -4250,-43653,3481 2500,-43653,4249 \
						-r $i:補完ＲＸ,2048,0 \
						-f 7500 \
						-a 200 \
						-i 3 3 0 0 \
						-s $3
				}
			}

		// 昇降機ホール南東
		trap ca025 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ降順 $6 6000 4000 876 500
				eval( $i:補完ＲＸ = $i:CS_結果１ );

				chara カメラ設定 サブカメラ \
					-c 0 \	
					-b -2500,-38000,1000 4000,-38000,5776 \
					-l -2500,-43653,3231 4000,-43653,4249 \
					-r $i:補完ＲＸ,2048,0 \
					-f 7500 \
					-a 200 \
					-i 3 3 0 0 \
					-s $3
			}

		// 荷物裏の匍匐カメラ
		trap ca026 d:PLAYER \
			-mask ？ \
			-state 1,2 \	//しゃがみor匍匐
			-camera \
			-exec {
				chara カメラ設定 サブカメラ \
					-c 0 \	
					-b -3500,-38000,d:CAM_MIN d:CAM_MAX,-38000,d:CAM_MAX \
					-l -3500,-43653,d:CAM_MIN d:CAM_MAX,-43653,d:CAM_MAX \
					-r 900,2048,0 \
					-f 7250 \
					-a 200 \
					-i 3 3 0 0 \
					-s $3
			}
	}




