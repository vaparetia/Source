// 各gclで必要なdefine
// ------------------------------------
// モード
#define		STAGE_PLANT		1		// 共通プロック切り分け用
// ステージ名
#define		STAGE_W11B		1		// 共通プロック切り分け用
// 敵兵、ＮＰＣ状況（薬莢を呼び分けるのに必要）

// 各種スイッチ用define
// ------------------------------------
// サウンド
#define		SOUND			1		// サウンドデータは最初に呼ぶ
#define		BGM				1		// BGMは敵兵コマンダーの後に呼ぶ
// ノード端末
#define		NODE			1		// ノードcharaを使用するのに必要
// キャラクター関係
#define		RAIDEN			1		// SNAKEとは排他
// ドア
#define		WT_DOOR			1		// 水密ドア
#define		SLIDE_DOOR		1		// スライドドア
// 入出トラップ
#define		LOAD_TRAP		1
#define		STAGE_END		1		// ステージ終了時処理を使用可にする
// フォグ
#define		FOG				1
// エフェクト関係
// 子画面
#define		SUB_CAMERA		0
// カメラ関係
#define		CLEAR_CAMERA	0		// クリアリング専用カメラ(要子画面)
// 天井
#define		CHARA_CEIL		1		// 天井君
// 透明壁
#define		TR_WALL			1		// シナリオ置きの透明壁
// ライト関係
#define		SPOT_LIGHT		0		// スポットライト
#define		CHARA_LIGHT		1		// キャラ専用ライト
// オブジェ関係
#define		LOCKER			1		// ロッカー
#define		SD_LOCKER_FLR	4		// ロッカー扉SE番号(倒れバージョン)
#define		SD_LOCKER_HZD	1		// ロッカー扉SE番号(扉バージョン)
#define		SUBMARINE		1		// 潜水艇
#define		C4_BOMB			1		// 解体用
// 水中モード関連
#define	WATER				1		// 水面
#define	WATER_MODE			1		// 水中モード基本キャラ設定を使用するのに必要
#define WATER_SURFACE		-47250	// 水面の高さ
#define	WATER_CAMERA_ZONE	5		// 追従カメラが使用するゾーンのあるグループ番号(必要があれば定義する)
#define	WATER_ELUDE_IN		1		// エルード状態から入水できる場合は定義する
#define	CAMERA_BUBBLE_NUM	3		// カメラ泡の個数(いらない場合は定義しない)
#define	CAMERA_DUST_NUM		10		// カメラダストの個数(いらない場合は定義しない)
// 爆弾タイマー
#define		CTDOWN_TIMER_P	1		// 爆弾タイマー開始procを呼ぶのに必要
// アイテム
#define		ITEM			1
// 強制モーション
#define		JP_MOTION		1		// ジャンプモーション
#define		BY_MOTION		1		// ビヨンドモーション

// デバッグ関係
#ifdef	d:FIX_MODE
	#define		DEBUG_CHARA		0		// デバッグキャラ全体(FIX時は0)
	#define		DEBUG_MODE		0		// デバッグ開発環境
	#define		NO_POLYDEMO		0		// ポリデモなしフラグ
#else
	#define		DEBUG_CHARA		0		// デバッグキャラ全体
	#define		DEBUG_MODE		1		// デバッグ開発環境
	#define		NO_POLYDEMO		1		// ポリデモなしフラグ
#endif
#define		CHARA_CAMERA	0		// キャラ追従カメラ
#define		TARGET_CHARA	敵兵:01	// キャラ追従カメラのターゲット
#define		SCREENSHOT		0		// スクリーンショット
#define		USB_KEY			0		// USBキーボード


// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME		w11b
#define		KMS_NAME0		w11a0
#define		MT_KMS_NAME0	w11a0_speobj_mt
#define		KMS_NAME1		w11a1
#define		KMS_NAME2		w11c2
#define		KMS_NAME3		w11_elv_fader
#define		BK_CABLE_NAME	w11c2r_cable
#define		CEIL_NAME0		w11a0r
#define		CEIL_NAME1		w11a1r
#define		CEIL_NAME2		w11c2r
#define		WALL_NAME0		w11a0_southwall
#define		WALL_NAME1		w11c2_southwall
#define		DOOR_NAME1		dr_free
#define		LT2_NAME		w11
#define		R_MT_FILE		rai_w11a

// キャラクター関係
#if d:RAIDEN
	#define		PLAYER		ライデン	// モーションができるまで名前はスネーク
#else
	#define		PLAYER		スネーク
#endif



