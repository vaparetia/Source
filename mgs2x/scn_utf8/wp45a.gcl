// ------------------------------------
// 各gclで必要なdefine
// ------------------------------------
// モード
#define		STAGE_VR		1		// 共通プロック切り分け用
#define		VR_WEAPON		1		// 共通プロック切り分け用
#define		STAGE_START		1		//	ゲーム開始直後処理を有効にするため
// ステージ名
#define		STAGE_WP45A		1		// 共通プロック切り分け用

// ------------------------------------
// 各種スイッチ用define
// ------------------------------------
// デバッグ関係
#ifdef	d:FIX_MODE
	#define		DEBUG_CHARA		0		// デバッグキャラ全体(FIX時は0)
	#define		SCREENSHOT		0		// スクリーンショット
	#define		USB_KEY			0		// USBキーボード
#else
	#define		DEBUG_CHARA		0		// デバッグキャラ全体
	#define		SCREENSHOT		0		// スクリーンショット
	#define		USB_KEY			0		// USBキーボード
#endif

#define		CHARA_CAMERA		0		// キャラ追従カメラ
#define		TARGET_CHARA		敵兵:01	// キャラ追従カメラのターゲット



// ------------------------------------
// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME			ws45a
#define		KMS_NAME			ws45a
#define		TONBO_KMS_NAME		ws45a_tonbo
#define		LINE_KMS_NAME		ws45a_line
#define		LT2_NAME			ws45a

// キャラクター関係
#define		PLAYER		ライデン

// ------------------------------------
// 敵兵音声
// ------------------------------------

// ------------------------------------
// 敵兵ルート番号
// ------------------------------------
enum M_R {
	雷電ルート０ = 0,
	雷電ルート１,
	雷電ルート２,
	雷電ルート３
}


// ------------------------------------
// include
// ------------------------------------
#include "rai_wp45a.mh"		// 強制モーションリスト
#include "stdch.h"
#include "enevoice.h"
