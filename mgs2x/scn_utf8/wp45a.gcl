// ------------------------------------
// マップ設定
// ------------------------------------
chara マップ 武器訓練狙撃５面 -k d:KMS_NAME -h d:HZX_NAME,0 -l $s:ＶＲライトファイル名
/*

*/
command マップ設定 武器訓練狙撃５面 -set {

	// ローカルの初期化
	// ------------------------------------
	@ローカル変数初期化		// ローカルで使用する変数で初期化をする場合はここで

	// ＶＲで必要な基本プロックのセット(vr_common.hで定義)
	// サウンドの基本パック、ＶＲの基本システム、プレイヤー、ゴール等を設定します
	// ※このプロックを使用する時は「ＶＲクリア時処理」というプロックが必要です
	// ＶＲ共通プロックセット	$:スネークファイル $:雷電ファイル $:クリア条件フラグ
	//							$:ゴールＸ $:ゴールＹ $:ゴールＺ
	//	VR_GOAL_TARGET	/*的全滅でゴールが開く*/
	//	VR_GOAL_FREE	/*ゴールが最初から開いてる*/
	//	VR_GOAL_ENEMY	/*敵全滅でゴールが開く*/
	//	VR_GOAL_SNEAK	/*潜入モード中はゴールが開く*/
	//	VR_GOAL_TIME	/*タイマーがゼロになるとゴールが開く*/
	// ------------------------------------
	
	@ＶＲ共通プロックセット sna_wp45a rai_wp45a d:VR_GOAL_TARGET 5250 4000 -3500
	
	// ＶＲウィンドウの設定
	// ------------------------------------
	@武器訓練狙撃５面ＶＲウィンドウ設定

	// クリア時に呼ばれるものの設定
	// ------------------------------------
	@ＶＲクリア設定 p:load_select p:load_wp45a
	
	// ステージに引かれるライン
	@ＶＲアウトライン d:KMS_NAME d:TONBO_KMS_NAME d:LINE_KMS_NAME

	// 設定値を変更する場合は以下のプロック内で設定
	// ------------------------------------
	@設定値変更				// 敵兵や的のパラメータをステージ限定で変える時はここで
	@プラグイン設定			// プレイヤーのプラグインがいる時はここで

	// 的関係の設定
	// ------------------------------------
	@ＶＲ標的設定				// ＶＲシステム起動後に呼ぶ

	// ＢＧＭの設定(プレイヤー→敵兵→BGMの順で呼ぶ。的の場合は関係ないがとりあえずここに)
	// ------------------------------------
	@ＢＧＭ設定

	// エルード
	//@エルード設定

	// アイテムの設定
	// ------------------------------------
	@アイテム設定

	// 光源、オブジェクト、カメラ関連の設定
	// ------------------------------------
	@ＶＲフォグ設定 -5000 80000 -8000 75000 -7000 75000
	
	//@フォグ設定
	@カメラセット					// chara カメラとベースのカメラを設定
	@武器訓練狙撃５面カメラ設定		// ステージ固有のカメラ設定がいる時はこのプロックで
	@ＶＲキャラ用ライト設置			// 必ず最後に設定
#if d:DEBUG_CHARA
	//@デバッグキャラセット
#endif
}

//初期マップの表示
command マップ表示 -show 武器訓練狙撃５面



// このステージは広いので個別にフォグを設置 2002.04.22
proc フォグ設定 {
	chara フォグ 霧 \
			-c 139, 100, 52 \
			-n -3000 \
			//-f 40000
			-f 100000
}

// 各proc設定
//-------------------------------------------------------------------------------------
// 全マップ共通
	//------------------------------------------------------------
	// ＶＲウィンドウの設定と表示
	//------------------------------------------------------------
	proc 武器訓練狙撃５面ＶＲウィンドウ設定 {
		#if d:DEBUG_PRINT
			print 'vr_window_set'
		#endif

		@ＶＲウィンドウ設定	[VRMSG_J:VRM_WPN_PSG_wp45a] [VRMSG_E:VRM_WPN_PSG_wp45a] \	// 日、英
							[VRMSG_G:VRM_WPN_PSG_wp45a] [VRMSG_F:VRM_WPN_PSG_wp45a] \	// 独、仏
							[VRMSG_I:VRM_WPN_PSG_wp45a] [VRMSG_S:VRM_WPN_PSG_wp45a] \	// 伊、西
							[VRMSG_K:VRM_WPN_PSG_wp45a] \								// 韓
							p:ＶＲステージ開始時処理								// 終了プロック


		// ＶＲウィンドウを表示する
		mesg ＶＲウィンドウ ＶＲウィンドウ君 開く

		// スタート時とクリア時に使用するカットインカメラ
		chara カメラ カットインカメラ		-c 0 -l 0 -p  0

		// スタート時のカメラ(必要な場合)
		chara カメラ設定 カットインカメラ \
			-c 1 \	
			-p -1102,20937,-10702 -t -6854,16628,-16096 \
			-r 326,2581,0 -f 8986 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1
	}
	
	//------------------------------------------------------------
	// ステージ開始時処理
	//------------------------------------------------------------
	proc ＶＲステージ開始時処理 {
		#if d:DEBUG_PRINT
			print 'game_start!!!!!'
		#endif

		// プレイヤーやパッドの制御等を行う a_stdproc.hで定義
		@全ミッション共通ステージ開始時処理

		// カメラワークスタート(必要な場合)
		// 全体図
		
		chara カメラ設定 カットインカメラ \
			-c 1 \	
			-p 24371,25660,13081 -t 18417,21857,7532 \
			-r 285,2583,0 -f 8984 \
			-a 200 \
			-i 4 4 d:START_CAMERA_CHANGE_TIME d:START_CAMERA_CHANGE_TIME \
			-s 1

		chara delay ディレイ \
			-time d:START_CAMERA_CHANGE_TIME \
			-exec {
				chara カメラ設定 カットインカメラ -s -1
			}
	}
	
	// ------------------------------------
	// クリア時の処理
	// ------------------------------------
	proc ＶＲクリア時処理 {
		#if d:DEBUG_PRINT
			print 'clear'
		#endif

		// 強制モーションを発動
		@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_2 256
		
		// クリア時にカメラアングルを変える
		chara カメラ設定 クリア時カメラ \
			-c 1 \
			-p 7456,5103,-240 -t 5025,5085,-3165 \
			-r 3,2500,0 -f 3804 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}



	// ------------------------------------
	// パラメータ系の変更
	// ------------------------------------
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT
			print 'localvar_init'
		#endif
		$$f:真中到着 = 0
		$$b:wp45a_的破壊数 = 0
		
		$$f:移動的フラグ１８ = 0;
		$$f:移動的フラグ１９ = 0;
		$$f:移動的フラグ２０ = 0;
	}
	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT
			print 'status_set'
		#endif

		// 初期装備の設定
		eval( $w:アイテム数Ｒ[ d:アイテム:ジアゼパム ] = 3 )
		eval( $w:武器弾数Ｒ[ d:武器:ＰＳＧ１ ] = 61 )

		// ＰＳＧ１、ジアゼパムを装備させておく
		command シナリオ前武器変更 -number d:武器:ＰＳＧ１
		// ジアゼパムを装備させておく
		$w:アイテム = d:アイテム:ジアゼパム
	}

	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif
	}



	// ------------------------------------
	// 敵兵や的の処理
	// ------------------------------------
	proc ＶＲ標的設定 {
		
		if( $s:選択プレイヤー == ライデン || \
			$s:選択プレイヤー == プリスキン ) {
			@ライデン的ルート設定
		} else {
			@スネーク的ルート設定
		}
		
/*
		chara ＶＲ壁 壁:01 \
			-flag d:VR_TRG_NORMAL \
			-pos	0 0 0 \
			-dir	0				//Ｘ軸に平行 １＝Ｚ軸に平行
		chara ＶＲ箱 箱:01 \
			-flag d:VR_TRG_NORMAL \
			-pos	0 0 1000
*/
	}
	
	proc ゲーム開始直後処理 {
		//	的をスタートさせる
		if( $s:選択プレイヤー == ライデン || \
			$s:選択プレイヤー == プリスキン ) {
			
			@ライデン的スタート
		} else {
			@スネーク的スタート
		}
	}


/****************************************************************************************/
// ライデン的設定
/****************************************************************************************/
	
	proc ライデン的ルート設定 {
		command foreach -argc 4 -repeat 4 \
			-data { \
				// ４階
				{ 壁:01, -13000, 17000, -40000 } \
				// ３階
				{ 壁:02, -10000, 13000, -40000 } \
//				{ 壁:03, -7000, 13000, -40000 } \
				// ２階
				{ 壁:04, -13000, 9000, -40000 } \
				{ 壁:05, -10000, 9000, -40000 } \
				// １階
//				{ 壁:06, -10000, 5000, -40000 } \
			} \
			-exec { \
				chara ＶＲ壁 $1 \
					-flag d:VR_TRG_NORMAL \
					-pos	$2 $3 $4 \
					-dir	0	\			//Ｘ軸に平行 １＝Ｚ軸に平行
					-c ライデン壁破壊プロック
			}

		command foreach -argc 6 -repeat 21 \
			-data { \
			// A
				// 壁隠れ
				{ 移動的:01, 1, ( d:VR_TRG_OCT ), d:SOUTH, 0, 0 } \
				{ 移動的:02, 5, ( d:VR_TRG_OCT ), d:SOUTH, 0, 0 } \
				{ 移動的:03, 9, ( d:VR_TRG_OCT ), d:SOUTH, 0, 0 } \
				{ 移動的:04, 11, ( d:VR_TRG_OCT ), d:SOUTH, 0, 0 } \
				// スパイダー
				{ スパイダー的, 34, ( d:VR_TRG_OCT | d:VR_TRG_WAIT | d:VR_TRG_BLAST), d:SOUTH, 0, 0 } \
				// その他
				{ 移動的:06, 14, ( d:VR_TRG_OCT ), d:SOUTH, 0, 0 } \
				{ 移動的:07, 15, ( d:VR_TRG_OCT ), d:SOUTH, 0, 0 } \
			// B
				{ 移動的:08, 20, ( d:VR_TRG_OCT ), d:SOUTH_EAST, 0, 0 } \
				{ 移動的:09, 33, ( d:VR_TRG_OCT ), d:SOUTH_EAST, 0, 0 } \
			// C
				{ 移動的:10, 21, ( d:VR_TRG_OCT ), d:SOUTH_EAST, 0, 0 } \
				{ 移動的:11, 22, ( d:VR_TRG_OCT ), d:SOUTH_EAST, 0, 0 } \
				{ 移動的:12, 23, ( d:VR_TRG_OCT ), d:SOUTH_EAST, 0, 0 } \
				{ 移動的:13, 31, ( d:VR_TRG_OCT ), d:SOUTH_EAST, 31, 1 } \
				{ 移動的:14, 32, ( d:VR_TRG_OCT ), d:SOUTH_EAST, 0, 0 } \
			// D
				{ 移動的:15, 24, ( d:VR_TRG_OCT | d:VR_TRG_NG ), d:SOUTH_EAST, 0, 0 } \
				{ 移動的:16, 25, ( d:VR_TRG_OCT | d:VR_TRG_NG ), d:SOUTH_EAST, 0, 0 } \
				{ 移動的:17, 26, ( d:VR_TRG_OCT | d:VR_TRG_NG ), d:SOUTH_EAST, 0, 0 } \
				{ 移動的:18, 27, ( d:VR_TRG_OCT ), d:SOUTH_EAST, 0, 0 } \
			// E
				{ 移動的:19, 28, ( d:VR_TRG_OCT | d:VR_TRG_BLAST ), d:SOUTH_EAST, 0, 0 } \
				{ 移動的:20, 29, ( d:VR_TRG_OCT | d:VR_TRG_BLAST ), d:SOUTH_EAST, 0, 0 } \
				{ 移動的:21, 30, ( d:VR_TRG_OCT | d:VR_TRG_NG ), d:SOUTH_EAST, 0, 0 } \

			} \
			-exec { \
				// 点滅的の設定
				if( $s:選択プレイヤー == プリスキン ) {
					$$b:的セット数 = $$b:的セット数 + 1;
					if( $$b:的セット数 % 2 ) {
						$$i:フラグ = d:VR_TRG_HIDESTART;
					} else {
						$$i:フラグ = d:VR_TRG_VISIBLESTART;
					}
				} else {
					$$i:フラグ = 0;
				}
				
				chara ＶＲ移動的 $1 \
					-route $2 \
					-flag ( $3 | d:VR_TRG_WAIT | $$i:フラグ ) \
					-yshift 0 500 0 \
					-dir $4 0 \
					-speed 10 \
					-x ライデン的ルート変更プロック $5 $6 \
					-c ライデン的破壊プロック
			}
	}
	
	proc ライデン的スタート {
		mesg ＶＲ的共通 移動的 移動開始
	}

	proc ライデン的破壊プロック {
		$$b:wp45a_的破壊数 = ($$b:wp45a_的破壊数 + 1)
		print '的破壊数 = ' $$b:wp45a_的破壊数

		// 残り少なくなったら見え易い位置に
		if( $$b:wp45a_的破壊数 == 18 ) {
			mesg ＶＲ移動的 移動的:08 ルート変更 35
			mesg ＶＲ移動的 移動的:09 ルート変更 36
		}


		// スパイダー出動
		if( $$b:wp45a_的破壊数 == 6 ) {
			mesg ＶＲ的共通 スパイダー的 移動開始
		}

		if( $1 == 移動的:18 ) {
			chara delay 的消しディレイ -time 60 -exec {
				mesg ＶＲ的共通 移動的:15 消滅
				mesg ＶＲ的共通 移動的:16 消滅
				mesg ＶＲ的共通 移動的:17 消滅
			}
		}
/*
		if( $1 == 移動的:19 || $1 == 移動的:20 ) {
			chara delay 的消しディレイ -time 120 -exec {
				mesg ＶＲ的共通 移動的:21 消滅
			}
		}
*/
		if( $1 == 移動的:19 ) {
			$$f:移動的フラグ１９ = 1;
		} else if( $1 == 移動的:20 ) {
			$$f:移動的フラグ２０ = 1;
		}

		if( $$f:移動的フラグ１９ && $$f:移動的フラグ２０ ) {
			chara delay 的消しディレイ -time 120 -exec {
				mesg ＶＲ的共通 移動的:21 消滅
			}
		}
	}

	proc ライデン的ルート変更プロック {
		if( $1 == 移動的:13 ) {
			if( $$b:wp45a_的破壊数 >= 18 ) {
				print '移動的:13 ルート変更  31 → 37'
				mesg ＶＲ移動的 移動的:13 即ルート変更 37
			}
		}
	}

	proc ライデン壁破壊プロック {
		print '壁が破壊されました'
		if( $1 == 壁:05 ) {
			eval( $f:wp45a_壁０５破壊フラグ = 1 )
			if( $f:wp45a_壁０４破壊フラグ == 0 ) {
				mesg ＶＲ移動的 移動的:01 ルート変更 2
				mesg ＶＲ移動的 移動的:02 ルート変更 6
				mesg ＶＲ移動的 移動的:03 ルート変更 10
				mesg ＶＲ移動的 移動的:04 ルート変更 12
			} else {
				mesg ＶＲ移動的 移動的:01 ルート変更 4
				mesg ＶＲ移動的 移動的:02 ルート変更 8
				mesg ＶＲ移動的 移動的:03 ルート変更 10
				mesg ＶＲ移動的 移動的:04 ルート変更 12
			}
		} else if( $1 == 壁:04 ) {
			eval( $f:wp45a_壁０４破壊フラグ = 1 )
			if( $f:wp45a_壁０５破壊フラグ == 1 ) {
				mesg ＶＲ移動的 移動的:01 ルート変更 3
				mesg ＶＲ移動的 移動的:02 ルート変更 7
			}
		}
	}

/****************************************************************************************/
// スネーク的設定
/****************************************************************************************/
	proc スネーク的ルート設定 {
		command foreach -argc 4 -repeat 6 \
			-data { \
				// ４階
				//{ 壁:01, -13000, 17000, -40000 } \
				//{ 壁:02, -10000, 17000, -40000 } \
				//{ 壁:03, -7000, 17000, -40000 } \
				// ３階
				{ 壁:04, -13000, 13000, -40000 } \
				{ 壁:05, -10000, 13000, -40000 } \
				{ 壁:06, -7000, 13000, -40000 } \
				// ２階
				//{ 壁:07, -13000, 9000, -40000 } \
				//{ 壁:08, -10000, 9000, -40000 } \
				//{ 壁:09, -7000, 9000, -40000 } \
				// １階
				{ 隠れ壁:01, -13000, 5000, -40000 } \
				{ 隠れ壁:02, -10000, 5000, -40000 } \
				{ 隠れ壁:03, -7000, 5000, -40000 } \
			} \
			-exec { \
				chara ＶＲ壁 $1 \
					-flag d:VR_TRG_NORMAL \
					-pos	$2 $3 $4 \
					-dir	0	\			//Ｘ軸に平行 １＝Ｚ軸に平行
					-c スネーク壁破壊プロック
			}

		// 隠れ的
		command foreach -argc 9 -repeat 5 \
			-data { \
			// A
				// 壁隠れ
				{ 移動的:01, 50, ( d:VR_TRG_OCT | d:VR_TRG_BLAST ), d:WEST, 10, 0, 0, 0, 0 } \
				{ 隠れ的:01, 51, ( d:VR_TRG_OCT ), d:SOUTH, 60, 55, 3 , 63 , 2 } \
				{ 隠れ的:02, 52, ( d:VR_TRG_OCT ), d:SOUTH, 60, 56, 3, 64, 3 } \
				{ 隠れ的:03, 53, ( d:VR_TRG_OCT ), d:SOUTH, 60, 57, 4, 65, 3 } \
				{ 隠れ的:04, 54, ( d:VR_TRG_OCT ), d:SOUTH, 60, 58, 3, 66, 3 } \
			} \
			-exec { \
				// 点滅的の設定
				if( $s:選択プレイヤー == タキシードスネーク || \
					$s:選択プレイヤー == 前作スネーク ) {
					$$b:的セット数 = $$b:的セット数 + 1;
					if( $$b:的セット数 % 2 ) {
						$$i:フラグ = d:VR_TRG_HIDESTART;
					} else {
						$$i:フラグ = d:VR_TRG_VISIBLESTART;
					}
				} else {
					$$i:フラグ = 0;
				}
				
				chara ＶＲ移動的 $1 \
					-route $2 \
					-flag ( $3 | d:VR_TRG_WAIT | $$i:フラグ ) \
					-yshift 0 500 0 \
					-dir $4 0 \
					-speed $5 \
					-x スネーク的ルート変更プロック１ $6 $7 \
					   スネーク的ルート変更プロック２ $8 $9 \
					-c スネーク的破壊プロック
			}

	// その他
	// A
		@その他的セット 移動的:01, 71, ( 0 ), d:SOUTH, 0, 0
		@その他的セット 移動的:02, 72, ( 0 ), d:SOUTH, 0, 0
		@その他的セット 移動的:03, 73, ( 0 ), d:WEST, 0, 0
		//@その他的セット 移動的:04, 74, ( 0 ), d:SOUTH, 0, 0
		@その他的セット 移動的:05, 75, ( 0 ), d:SOUTH, 0, 0
		@その他的セット 移動的:55, 76, ( 0 ), d:SOUTH, 0, 0
	// B
		@その他的セット 移動的:06, 77, ( 0 ), d:SOUTH_EAST, 0, 0
		@その他的セット 移動的:07, 78, ( 0 ), d:SOUTH_EAST, 0, 0
		@その他的セット 移動的:08, 79, ( 0 ), d:SOUTH_EAST, 0, 0
		@その他的セット 移動的:09, 80, ( 0 ), d:SOUTH_EAST, 0, 0
	// C
		@その他的セット 移動的:10, 81, ( 0 ), d:SOUTH_EAST, 0, 0
		@その他的セット 遅れ的:11, 81, ( d:VR_TRG_WAIT ), d:SOUTH_EAST, 0, 0
		@その他的セット 遅れ的:12, 81, ( d:VR_TRG_WAIT ), d:SOUTH_EAST, 0, 0
	// D
		@その他的セット 移動的:13, 82, ( d:VR_TRG_BLAST ), d:SOUTH_EAST, 0, 0
		@その他的セット 移動的:14, 83, ( d:VR_TRG_BLAST ), d:SOUTH_EAST, 0, 0
		//@その他的セット 移動的:15, 84, ( 0 ), d:SOUTH_EAST, 0, 0
		//@その他的セット 移動的:16, 85, ( 0 ), d:SOUTH_EAST, 0, 0
	// E
		
		@その他的セット 移動的:17, 86, ( d:VR_TRG_NG ), d:SOUTH_EAST, 0, 0
		@その他的セット 移動的:18, 87, ( d:VR_TRG_BLAST ), d:SOUTH_EAST, 0, 0
		@その他的セット 移動的:19, 88, ( d:VR_TRG_BLAST ), d:SOUTH_EAST, 0, 0
	}
	
	proc その他的セット $:名前 $:ルート $:フラグ $:向き $:変更ルート $:変更ノード {
		// 点滅的の設定
		if( $s:選択プレイヤー == タキシードスネーク || \
			$s:選択プレイヤー == 前作スネーク ) {
			
			$$b:的セット数 = $$b:的セット数 + 1;
			if( $$b:的セット数 % 2 ) {
				$$i:フラグ = d:VR_TRG_HIDESTART;
			} else {
				$$i:フラグ = d:VR_TRG_VISIBLESTART;
			}
		} else {
			$$i:フラグ = 0;
		}
			
		chara ＶＲ移動的 $:名前 \
			-route $:ルート \
			-flag ( $:フラグ | d:VR_TRG_WAIT | d:VR_TRG_OCT | $$i:フラグ ) \
			-yshift 0 500 0 \
			-dir $:向き 0 \
			-speed 10 \
			-x スネーク的ルート変更プロック１ $:変更ルート $:変更ノード \
			-c スネーク的破壊プロック
	}
	
	proc スネーク的スタート {
	
		mesg ＶＲ的共通 移動的 移動開始
		mesg ＶＲ的共通 隠れ的 移動開始
		
		// 的を送らせてスタート
		chara delay ディレイ -time 120 -exec {
			mesg ＶＲ的共通 遅れ的:11 移動開始
		}
		chara delay ディレイ -time 240 -exec {
			mesg ＶＲ的共通 遅れ的:12 移動開始
		}
	}

	proc スネーク的破壊プロック {
		$$b:wp45a_的破壊数 = ( $$b:wp45a_的破壊数 + 1 )
		print '的破壊数 = ' $$b:wp45a_的破壊数
		
		
		if( $1 == 移動的:18 ) {
			$$f:移動的フラグ１８ = 1;
		} else if( $1 == 移動的:19 ) {
			$$f:移動的フラグ１９ = 1;
		}
		
		if( $$f:移動的フラグ１８ && $$f:移動的フラグ１９ ) {
			
			$$f:移動的フラグ１８ = 0;
			$$f:移動的フラグ１９ = 0;
			chara delay 的消しディレイ -time 120 -exec {
				mesg ＶＲ的共通 移動的:17 消滅
			}
		}
	}

	proc スネーク的ルート変更プロック１ {
		switch ( $1 ) {
		// 壁に隠れている的
			case ( 隠れ的:01 ) {
				if( `command コントロール存在検査 隠れ壁:02` == -1 ) {
					mesg ＶＲ移動的 隠れ的:01 即ルート変更 63
				} else {
					$$f:真中到着 = 1
					mesg ＶＲ移動的 隠れ的:01 即ルート変更 59
				}
			}
			case ( 隠れ的:02 ) {
				if( `command コントロール存在検査 隠れ壁:02` == -1 ) {
					mesg ＶＲ移動的 隠れ的:02 即ルート変更 64
				} else {
					$$f:真中到着 = 1
					mesg ＶＲ移動的 隠れ的:02 即ルート変更 60
				}
			}
			case ( 隠れ的:03 ) {
				if( `command コントロール存在検査 隠れ壁:02` == -1 ) {
					mesg ＶＲ移動的 隠れ的:03 即ルート変更 65
				} else {
					$$f:真中到着 = 1
					mesg ＶＲ移動的 隠れ的:03 即ルート変更 61
				}
			}
			case ( 隠れ的:04 ) {
				if( `command コントロール存在検査 隠れ壁:02` == -1 ) {
					mesg ＶＲ移動的 隠れ的:04 即ルート変更 66
				} else {
					$$f:真中到着 = 1
					mesg ＶＲ移動的 隠れ的:04 即ルート変更 62
				}
			}
/*
		// 数が少なくなったら見える位置へ
			case ( 移動的:05 ) {
				if( $$b:wp45a_的破壊数 >= 20 ) {
					mesg ＶＲ移動的 移動的:05 即ルート変更 76
				}
			}
*/
			default {
				;
			}
		}

	}
	proc スネーク的ルート変更プロック２ {
		if( $1 == 隠れ的:01 ) {
			mesg ＶＲ移動的 隠れ的:01 即ルート変更 67
		} else if( $1 == 隠れ的:02 ) {
			mesg ＶＲ移動的 隠れ的:02 即ルート変更 68
		} else if( $1 == 隠れ的:03 ) {
			mesg ＶＲ移動的 隠れ的:03 即ルート変更 69
		} else if( $1 == 隠れ的:04 ) {
			mesg ＶＲ移動的 隠れ的:04 即ルート変更 70
		}
	}


	proc スネーク壁破壊プロック {
		if( $1 == 隠れ壁:01 ) {
			mesg ＶＲ移動的 隠れ的:01 ルート変更 55
			mesg ＶＲ移動的 隠れ的:02 ルート変更 56
			mesg ＶＲ移動的 隠れ的:03 ルート変更 57
			mesg ＶＲ移動的 隠れ的:04 ルート変更 58
		} else if( $1 == 隠れ壁:02 ) {
			print '隠れ壁:02'
			if( `command コントロール存在検査 隠れ壁:01` == -1 ) {
				print $$f:真中到着
				if( $$f:真中到着 == 1 ) {
					mesg ＶＲ移動的 隠れ的:01 ルート変更 63
					mesg ＶＲ移動的 隠れ的:02 ルート変更 64
					mesg ＶＲ移動的 隠れ的:03 ルート変更 65
					mesg ＶＲ移動的 隠れ的:04 ルート変更 66
				}
			}
		}
	}


	// ------------------------------------
	// ＢＧＭの設定
	// ------------------------------------
	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT
			print 'bgm_set'
		#endif

		chara ＢＧＭマネージャー ＢＧＭマネ
	}

	proc エルード設定 {
		trap by001 d:PLAYER \
			-mask いる \
			-button d:ACTION_BUTTON \
			-state d:TRP_STATE_STAND, d:TRP_STATE_CAUTION \	//立ち状態or張り付き
			-exec {
				print 'ビヨーンド'
				@東向きビヨンド発動 $1 6000 $4 -29000 -14000 d:BY_NOFOOTSHADOW
			}
	}


	// ------------------------------------
	// アイテムの設定
	// ------------------------------------
	// 再発生が必要な時は以下のプロックの中を記述する
	// ------------------------------------
	proc アイテム取得時番号設定 $:ボックス名 {
		#if d:DEBUG_PRINT
			print 'item_no_set'
		#endif
	}
	// アイテムの設置
	// ------------------------------------
	proc アイテム設定 {
		#if d:DEBUG_PRINT
			print 'item_set'
		#endif
		
		switch ( $s:選択プレイヤー ) {
			case ( ライデン ) {
				@弾薬_ＰＳＧ１_初期設置 ＰＳＧ１弾:01 5400,7000,-10100 d:アイテム水飛沫無
				@弾薬_ＰＳＧ１_初期設置 ＰＳＧ１弾:02 -4000,1000,-3200 d:アイテム水飛沫無
				@A_ジアゼパム_初期設置 ジアゼパム:02 3500,1000,-5150 d:アイテム水飛沫無 2
			}
			case ( スネーク ) {
				@弾薬_ＰＳＧ１_初期設置 ＰＳＧ１弾:01 5400,7000,-10100 d:アイテム水飛沫無
				@弾薬_ＰＳＧ１_初期設置 ＰＳＧ１弾:02 -4000,1000,-3200 d:アイテム水飛沫無
				@A_ジアゼパム_初期設置 ジアゼパム:02 3500,1000,-5150 d:アイテム水飛沫無 2
			}
			case ( プリスキン ) {
				@弾薬_ＰＳＧ１_初期設置 ＰＳＧ１弾:01 5400,7000,-10100 d:アイテム水飛沫無
			}
			case ( タキシードスネーク ) {
				@弾薬_ＰＳＧ１_初期設置 ＰＳＧ１弾:02 -4000,1000,-3200 d:アイテム水飛沫無
			}
			case ( 前作スネーク ) {
			}
		}
		
		
		@A_ジアゼパム_初期設置 ジアゼパム:01 -3000,7000,-3000 d:アイテム水飛沫無 2
		@A_ＰＳＧ１－Ｔ_初期設置 ＰＳＧ１－Ｔ本体 -450,0,-51900 0 なし 61
	}

	// ------------------------------------
	// カメラ関係の設定
	// ------------------------------------
	// ステージカメラ設定
	// ------------------------------------
	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'chara_camera & stage_camera_set'
		#endif

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0
		chara カメラ メインカメラ		-c 0 -l 2 -p 40
		chara カメラ クリア時カメラ		-c 0 -l 0 -p 10


		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 80,2490,0 -f 8993 \
			-f 9000 \
			-a 200 \
			-i 2 2 0 0 \
			-d 1 \
			-s 1
	}
	// ステージ固有のカメラ設定
	// ------------------------------------
	proc 武器訓練狙撃５面カメラ設定 {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif


		// 橋
		trap ca001 d:PLAYER \
			-mask ？ \
			-exec {
				chara カメラ設定 メインカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 80,2107,0 -f 10453 \
					-a 200 \
					-i 3 3 0 0 \
					//-d 1 \
					-s $3
					//-p 1294,2868,7468 -t 356,1589,-2864 \
					//-r 80,2107,0 -f 10453 \
					//-a 200 \
		}

		// 右１Ｆ
		trap ca002 d:PLAYER \
			-mask ＊ \
			-exec {

				@CS_スムーズカメラ昇順 $6 -10000 -5000 10 50
				eval( $i:補完ＲＸ = $i:CS_結果１ );

				chara カメラ設定 メインカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r $i:補完ＲＸ,/*2252*/2100,0 -f 7189 \
					-a 200 \
					-i 3 3 0 0 \
					-d 1 \
					-s $3
				//-p 5406,3134,5198 -t 3200,2583,-1621 \
				//-r 50,2252,0 -f 7189 \
				//-a 200 \
		}
	}





// -----------------------------------------------------------------------------------
// 以下デバッグ専用proc
// -----------------------------------------------------------------------------------
// デバッグキャラ
// ------------------------------------
proc デバッグキャラセット {
	#if d:DEBUG_PRINT
		print 'debug_chara_set'
	#endif

	#if d:CHARA_CAMERA
		chara キャラカメラ 敵兵カメラ \
			-c d:TARGET_CHARA \
			-s -920,610,200 \
			-r -200,1024,0
	#endif

	#if d:SCREENSHOT
		chara スクリーンショット shot
	#endif



	command メニュー設定 -gage off -radar off -vibrate off

	#if d:USB_KEY
		chara USBキーボード実行 test \
			-e d:KBD_ESC {
				mesg プレイヤー d:PLAYER position -5500, -13000, -500
			} \
	#endif
}

