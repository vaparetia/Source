			-point	49645,-3100,-20725 49645,-4000,-20100
	}

	// ドア＆マップ切り替え関係
	// ------------------------------------
	proc １Ｆ右下小部屋マップ切り替え {
		#if d:DEBUG_PRINT
			print 'w22a0f_map_change_set'
		#endif

		// 中央広場の表示非表示
		trap dr000 d:PLAYER \
			-mask ？ \
			-exec {
				if ( $3 == 入る ) {
					// ダクトの中にいるときに１にする
					eval( $f:ローカルフラグ１ = 1 );
					mesg マップ接合 １Ｆ中央／右下小部屋 on
				} else if ( $3 == 出る ) {
					// ダクトからでたら０にする
					eval( $f:ローカルフラグ１ = 0 );
					// ダクトから出てきて右下小部屋の扉が閉まっていたらオフにする
					if ( $f:ローカルフラグ２ == 0 ) {
						mesg マップ接合 １Ｆ中央／右下小部屋 off
					}
				}
			}
	}

	proc １Ｆ中央広場マップ切り替え {
		#if d:DEBUG_PRINT
			print 'w22a0h_map_change_set'
		#endif
		// エルード落下用
		command マップチェンジトラップ登録 \
			-trap dr072 \
			-map １Ｆ中央広場 Ｂ１中央広場

		// 右下小部屋の表示非表示
		trap dr000 d:PLAYER \
			-mask ？ \
			-exec {
				if ($3 == 入る) {
					// ダクトの中にいるときに１にする
					eval( $f:ローカルフラグ１ = 1 );
					mesg マップ接合 １Ｆ中央／右下小部屋 on
				} else if ( $3 == 出る ) {
					// ダクトからでたら０にする
					eval( $f:ローカルフラグ１ = 0 );
					// ダクトから出てきて右下小部屋の扉が閉まっていたらオフにする
					if ( $f:ローカルフラグ２ == 0 ) {
						mesg マップ接合 １Ｆ中央／右下小部屋 off
					}
				}
			}
	}

	proc １Ｆダクト表示切り替え {
		#if d:DEBUG_PRINT
			print 'w22a0_duct_change_set'
		#endif

		chara プットオブジェ １Ｆダクト -m d:DUCT_NAME0 -r 0,0,0 -p 0,0,0 -s 100,100,100 -l d:LT2_NAME

		// 右下小部屋ダクトの表示非表示
		trap ob000 d:PLAYER \
			-mask ？ \
			-exec {
				if ($3 == 入る) {
					mesg プットオブジェ １Ｆダクト on
				} else if ($3 == 出る) {
					mesg プットオブジェ １Ｆダクト off
				}
			}
		
	}

	proc １Ｆ黒天井表示切り替え {
		#if d:DEBUG_PRINT
			print 'w22a0_ceil_change_set'
		#endif

		chara プットオブジェ １Ｆ黒天井 -m d:CEIL_NAME0 -r 0,0,0 -p 0,0,0 -s 100,100,100 -l d:LT2_NAME
		mesg プットオブジェ １Ｆ黒天井 off

		// 小部屋上黒天井の表示非表示
		trap ob001 d:PLAYER \
			-mask ？ \
			-exec {
				if ($3 == 入る) {
					mesg プットオブジェ １Ｆ黒天井 on
				} else if ($3 == 出る) {
					mesg プットオブジェ １Ｆ黒天井 off
				}
			}
	}

	proc Ｂ１共通１Ｆ＆小部屋マップ切り替え {
		#if d:DEBUG_PRINT
			print 'w22a1b_1F_map_change_set'
		#endif

		// キャラはずっと呼びっぱなしでフラグで切り分ける
		chara プロック連続実行 １Ｆチェック \
			-time -1 \
			-exec { \
				if ( $f:w22a_Ｂ１いるフラグ == 1 ) {
					if ( `command プレイヤー状態取得` & d:PFLAG_SUBJECT && $i:プレイヤー位置Ｙ > -1900 ) {
						// 箱の上の主観状態は無条件にマップオン
						// マップをオンにするときはエフェクトを再びつけるために範囲外にバウンドを移動させる
						command エフェクトバウンド追加 0 0 0 2 2 2 1
						eval( $f:エフェクトバウンドフラグ = 0 );
//						command 即時マップ接合変更 １Ｆ北／Ｂ１中央 on
//						command 即時マップ接合変更 １Ｆ北／中央 on
						mesg マップ接合 １Ｆ北／Ｂ１中央 on
						mesg マップ接合 １Ｆ北／中央 on

					} else if ( $i:カメラＹ位置 > -500 ) {
						command 即時マップ接合変更 １Ｆ北／Ｂ１中央 off
						// エフェクトバウンドを指定し、範囲内のエフェクトを消す
						if ( $f:エフェクトバウンドフラグ == 0 ) {
							command エフェクトバウンド追加 44000 -500 -45000 59000 4000 -35500 1
							command エフェクトバウンド追加 41000 -500 -35500 60500 4000 -16000 0
							command エフェクトバウンド実行
							eval( $f:エフェクトバウンドフラグ = 1 );
						}

					} else {
						// マップをオンにするときはエフェクトを再びつけるために範囲外にバウンドを移動させる
						command エフェクトバウンド追加 0 0 0 2 2 2 1
						eval( $f:エフェクトバウンドフラグ = 0 );
						mesg マップ接合 １Ｆ北／Ｂ１中央 on
						mesg マップ接合 １Ｆ北／中央 on
					}
				}
			}

		// １Ｆ北通路・１Ｆ中央広場の表示非表示
		// プレイヤーチェックがカメラチェックよりも先に入るためカメラ位置を取るときには連続実行を使用する。
		trap dr100 d:PLAYER \
			-mask ？ \
			-exec {
				if ( $3 == 入る ) {
					eval ( $f:w22a_Ｂ１いるフラグ = 1 );
				} else {
					eval ( $f:w22a_Ｂ１いるフラグ = 0 );
					command エフェクトバウンド追加 0 0 0 2 2 2 1
					eval( $f:エフェクトバウンドフラグ = 0 );
					mesg マップ接合 １Ｆ北／Ｂ１中央 on
				}
			}


		// Ｂ１左下小部屋・右下小部屋の表示非表示
		trap dr110 d:PLAYER \
			-mask ？ \
			-exec {
				if ($3 == 入る) {
					mesg マップ接合 Ｂ１左下／右下小部屋 on
				} else if ($3 == 出る) {
					mesg マップ接合 Ｂ１左下／右下小部屋 off
				}
			}
	}

	proc Ｂ１ダクト表示切り替え {
		#if d:DEBUG_PRINT
			print 'w22a1_duct_change_set'
		#endif

