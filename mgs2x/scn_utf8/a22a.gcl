				@CS_スムーズカメラ降順 $6 -19000 -24000 -18491 -21315
				eval( $i:補完ＴＺ = $i:CS_結果１ );

				chara カメラ設定 メインカメラ \
					-c 1 \	
					-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ -t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ \
					-r 358,2048,0 -f 8032 \
