	// 入出トラップ
	// ------------------------------------
	proc ロードプロック {
		#if d:DEBUG_PRINT 
			print 'load_proc'
		#endif

		if ($s:呼び出しプロック == mv_a22a0h_a23a_0) {
			// ＦＡ連絡橋１Ｆへ
			@mv_a22a0h_a23a_0
		} else if ($s:呼び出しプロック == mv_a22a1c_a23a_0) {
			// ＦＡ連絡橋Ｂ１へ
			@mv_a22a1c_a23a_0
		} else if ($s:呼び出しプロック == mv_a22a0g_a21a_0) {
			// ＥＦ連絡橋へ
			@mv_a22a0g_a21a_0
		}
	}

	proc ロード設定 {
		#if d:DEBUG_PRINT 
			print 'load_set'
		#endif

		trap ld061 d:PLAYER \
			-mask 入る \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 1 ) {
					// ＥＦ連絡橋へ
					@エンドカメラセット ＥＦ連絡橋
					preseek 'a21a'
					@ステージ終了時処理（ステージ名表示） \
						57750 0 -44750 2048 mv_a22a0g_a21a_0 d:DEFAULT_M_TYPE \
						d:wn_ＥＦ連絡橋
				}
			}

		trap ld071 d:PLAYER \
			-mask 入る \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 1 ) {
					// ＦＡ連絡橋１Ｆへ
					@エンドカメラセット ＦＡ連絡橋１Ｆ
					preseek 'a23b'
					@ステージ終了時処理（ステージ名表示） \
						43500 0 -17500 3072 mv_a22a0h_a23a_0 d:DEFAULT_M_TYPE \
						d:wn_ＦＡ連絡橋
				}
			}

		trap ld131 d:PLAYER \
			-mask 入る \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 1 ) {
					// ＦＡ連絡橋Ｂ１へ
					@エンドカメラセット ＦＡ連絡橋Ｂ１
					preseek 'a23b'
					@ステージ終了時処理（ステージ名表示） \
						44250 -5000 -23000 0 mv_a22a1c_a23a_0 d:DEFAULT_M_TYPE \
						d:wn_ＦＡ連絡橋
				}
			}
	}



	// 壊れライト設定
	// ------------------------------------
	#define		LIGHT_NORMAL	0
	#define		LIGHT_BROKEN	1

	proc Ｆ脚１Ｆ壊れライト設定 $:名前 $:Ｘ座標 $:Ｚ座標 $:Ｙ角度 $:番号 {
		#if d:DEBUG_PRINT
			print 'bk_light_set'
		#endif


		chara プットスポットライトオブジェ $:名前 \
			-m w22a_light_1 w22a_light_2 \
			-t $:Ｘ座標 3059 $:Ｚ座標 250 500 750 \
			-s 750 100 100 \
			-r 0 $:Ｙ角度 0 \
			-l d:LT2_NAME \
			-b ライト破壊後処理 \
			-p $:Ｘ座標 3059 $:Ｚ座標 \
			-f ( d:BRK_LGT_OBJ_TARGET )
//			-f ( d:BRK_LGT_SHOWTRGT | d:BRK_LGT_OBJ_TARGET )

		@壊れ物再セットチェック $b:w22a_破壊ロード回数[$:番号]
		if ( $f:再セットフラグ == 0 ) {
			command プットスポットライトオブジェライト消す -n $:名前
			eval( $f:w22a_ライト破壊状態フラグ[$:番号] = d:LIGHT_BROKEN );
		} else {
			eval( $f:w22a_ライト破壊状態フラグ[$:番号] = d:LIGHT_NORMAL );
		}
	}

	proc ライト破壊後処理 {
		#if d:DEBUG_PRINT
			print 'w22a_light_broken'
		#endif

		if ( $1 == Ａ倉庫左ライト ) {
			eval( $b:w22a_破壊ロード回数[d:L_NO:A_L] = $w:グローバルロード回数 );
			eval( $f:w22a_ライト破壊状態フラグ[d:L_NO:A_L] = d:LIGHT_BROKEN );
		} else if ( $1 == Ａ倉庫右ライト ) {
			eval( $b:w22a_破壊ロード回数[d:L_NO:A_R] = $w:グローバルロード回数 );
			eval( $f:w22a_ライト破壊状態フラグ[d:L_NO:A_R] = d:LIGHT_BROKEN );
		} else if ( $1 == Ｂ倉庫左ライト ) {
			eval( $b:w22a_破壊ロード回数[d:L_NO:B_L] = $w:グローバルロード回数 );
			eval( $f:w22a_ライト破壊状態フラグ[d:L_NO:B_L] = d:LIGHT_BROKEN );
		} else if ( $1 == Ｂ倉庫右ライト ) {
			eval( $b:w22a_破壊ロード回数[d:L_NO:B_R] = $w:グローバルロード回数 );
			eval( $f:w22a_ライト破壊状態フラグ[d:L_NO:B_R] = d:LIGHT_BROKEN );
		} else if ( $1 == Ｃ倉庫左ライト ) {
			eval( $b:w22a_破壊ロード回数[d:L_NO:C_L] = $w:グローバルロード回数 );
			eval( $f:w22a_ライト破壊状態フラグ[d:L_NO:C_L] = d:LIGHT_BROKEN );
		} else if ( $1 == Ｃ倉庫右ライト ) {
			eval( $b:w22a_破壊ロード回数[d:L_NO:C_R] = $w:グローバルロード回数 );
			eval( $f:w22a_ライト破壊状態フラグ[d:L_NO:C_R] = d:LIGHT_BROKEN );
		} else if ( $1 == Ｄ倉庫左ライト ) {
			eval( $b:w22a_破壊ロード回数[d:L_NO:D_L] = $w:グローバルロード回数 );
			eval( $f:w22a_ライト破壊状態フラグ[d:L_NO:D_L] = d:LIGHT_BROKEN );
		} else if ( $1 == Ｄ倉庫右ライト ) {
			eval( $b:w22a_破壊ロード回数[d:L_NO:D_R] = $w:グローバルロード回数 );
			eval( $f:w22a_ライト破壊状態フラグ[d:L_NO:D_R] = d:LIGHT_BROKEN );
		} else if ( $1 == Ｅ倉庫左ライト ) {
			eval( $b:w22a_破壊ロード回数[d:L_NO:E_L] = $w:グローバルロード回数 );
			eval( $f:w22a_ライト破壊状態フラグ[d:L_NO:E_L] = d:LIGHT_BROKEN );
		} else if ( $1 == Ｅ倉庫右ライト ) {
			eval( $b:w22a_破壊ロード回数[d:L_NO:E_R] = $w:グローバルロード回数 );
			eval( $f:w22a_ライト破壊状態フラグ[d:L_NO:E_R] = d:LIGHT_BROKEN );
		} else if ( $1 == Ｆ倉庫左ライト ) {
			eval( $b:w22a_破壊ロード回数[d:L_NO:F_L] = $w:グローバルロード回数 );
			eval( $f:w22a_ライト破壊状態フラグ[d:L_NO:F_L] = d:LIGHT_BROKEN );
		} else if ( $1 == Ｆ倉庫右ライト ) {
			eval( $b:w22a_破壊ロード回数[d:L_NO:F_R] = $w:グローバルロード回数 );
			eval( $f:w22a_ライト破壊状態フラグ[d:L_NO:F_R] = d:LIGHT_BROKEN );
		}
 
		@暗闇トラップ起動チェック
	}
	
	proc 暗闇トラップ起動チェック {
		#if d:DEBUG_PRINT
			print 'dark_area_check'
		#endif
		
		// 小部屋のライトが二つとも消えたらダークトラップＯＮ
		if ( $f:w22a_ライト破壊状態フラグ[d:L_NO:A_L] && $f:w22a_ライト破壊状態フラグ[d:L_NO:A_R] ) {
			command トラップ切り替え -trap dark:01 -switch 1
		} else {
			command トラップ切り替え -trap dark:01 -switch 0
		}

		if ( $f:w22a_ライト破壊状態フラグ[d:L_NO:B_L] && $f:w22a_ライト破壊状態フラグ[d:L_NO:B_R] ) {
			command トラップ切り替え -trap dark:02 -switch 1
		} else {
			command トラップ切り替え -trap dark:02 -switch 0
		}
/* Ｃ倉庫は進入禁止フラグがあるためダークトラップを起動させない
		if ( $f:w22a_ライト破壊状態フラグ[d:L_NO:C_L] && $f:w22a_ライト破壊状態フラグ[d:L_NO:C_R] ) {
			command トラップ切り替え -trap dark:03 -switch 1
		} else {
			command トラップ切り替え -trap dark:03 -switch 0
		}
*/
		if ( $f:w22a_ライト破壊状態フラグ[d:L_NO:D_L] && $f:w22a_ライト破壊状態フラグ[d:L_NO:D_R] ) {
			command トラップ切り替え -trap dark:04 -switch 1
		} else {
			command トラップ切り替え -trap dark:04 -switch 0
		}

		if ( $f:w22a_ライト破壊状態フラグ[d:L_NO:E_L] && $f:w22a_ライト破壊状態フラグ[d:L_NO:E_R] ) {
			command トラップ切り替え -trap dark:05 -switch 1
		} else {
			command トラップ切り替え -trap dark:05 -switch 0
		}

		if ( $f:w22a_ライト破壊状態フラグ[d:L_NO:F_L] && $f:w22a_ライト破壊状態フラグ[d:L_NO:F_R] ) {
			command トラップ切り替え -trap dark:06 -switch 1
		} else {
			command トラップ切り替え -trap dark:06 -switch 0
		}

	}



	// 消火器設定
	// ------------------------------------
	proc Ｆ脚１Ｆ消火器設置 $:名前 $:Ｘ座標 $:Ｚ座標 $:Ｙ角度 $:範囲Ｘ１ $:範囲Ｚ１ $:範囲Ｘ２ $:範囲Ｚ２ {
		#if d:DEBUG_PRINT
			print 'hose_set'
		#endif

		if ( $:名前 == 消火器:21 ) {
			chara 消火器 $:名前 \
				-r 0 $:Ｙ角度 0 \
				-p $:Ｘ座標 0 $:Ｚ座標 \
				-l d:LT2_NAME \
				-i 1 \
//				-d 1 \	// デバッグ表示ＯＮ
				-e 赤外線可視 \ //
				-b $:範囲Ｘ１ 0  $:範囲Ｚ１ \
				   $:範囲Ｘ２ 2000 $:範囲Ｚ２
		} else {
			chara 消火器 $:名前 \
				-r 0 $:Ｙ角度 0 \
				-p $:Ｘ座標 0 $:Ｚ座標 \
				-l d:LT2_NAME \
				-i 1 \
//				-d 1 \	// デバッグ表示ＯＮ
				-b $:範囲Ｘ１ 0  $:範囲Ｚ１ \
				   $:範囲Ｘ２ 2000 $:範囲Ｚ２
		}
	}


	// フォグ
	// ------------------------------------
	proc フォグ設定 {
		#if d:DEBUG_PRINT
			print 'fog_set'
		#endif

		chara フォグ 霧\
			-c 31, 31, 20 \
			-n -5000 \
			-f 36000 
	}

	// キャラ用光源(マップの設置が終わってから設定することで、キャラだけに光を当てる)
	// ------------------------------------
	proc キャラ用ライト設置 {
		#if d:DEBUG_PRINT
			print 'chara_light_set'
		#endif

		chara 環境光 環境光源 \
			 -c 51 63 68

		chara 平行光 平行光源 \
			 -c 44 64 62 \
			 -p 2488 -3705 -2255
	}

	// エフェクト関係
	// -----------------------------------
	proc エフェクト設定 {
		#if d:DEBUG_PRINT
			print 'effect_set'
		#endif
	}


	// 子画面設定 
	// ------------------------------------
	proc 子画面設定 {
		#if d:DEBUG_PRINT
			print 'sub_camera_set'
		#endif

		chara サブ画面 子画面 \
			-w (512-d:SUB_MARGIN-d:SUB_WIDTH),d:SUB_MARGIN (512-d:SUB_MARGIN),(d:SUB_HEIGHT+d:SUB_MARGIN)
	}

	// ステージカメラ設定 
	// ------------------------------------
	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0 
		chara カメラ メインカメラ		-c 0 -l 2 -p 40
		chara カメラ サブカメラ１		-c 0 -l 2 -p 30
		chara カメラ サブカメラ２		-c 0 -l 2 -p 20
		chara カメラ サブカメラ３		-c 0 -l 2 -p 15
		chara カメラ モーションカメラ	-c 0 -l 2 -p 10 
		chara カメラ モーションカメラ２	-c 0 -l 2 -p 5 
		chara カメラ クリアリングカメラ	-c 1 -l 2 -p 0

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \	
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 740,2048,0 \
			-f 6500 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}


	// ステージ開始時カメラ 
	// ------------------------------------
	proc スタートカメラセット {
		#if d:DEBUG_PRINT
			print 'start_camera_set'
		#endif

		if( $s:登場ポイント == ＦＡ連絡橋１Ｆから ) {
			// ＦＡ連絡橋１Ｆから
			chara カメラ設定 モーションカメラ２ \
				-c 1 \
				-p 47638,2473,-15175 -t 46150,1544,-17227 \
				-r 229,2457,0 -f 2700 \
				-a 200 \
				-i 0 2 0 0 \
				-s 1
		} else if( $s:登場ポイント == ＦＡ連絡橋Ｂ１から ) {
			// ＦＡ連絡橋Ｂ１から
			chara カメラ設定 モーションカメラ２ \
				-c 1 \
				-p 44024,-519,-24985 -t 44024,-3485,-25176 \
				-r 982,2048,0 -f 2972 \
				-a 200 \
				-i 0 2 0 0 \
				-s 1
		} else if( $s:登場ポイント == ＥＦ連絡橋から ) {
			// ＥＦ連絡橋から
			if ( ($b:ミッション番号 == d:MISSION:スネークテイルズ) && \
			 ($b:tales_story_no == d:TALES_NO:B) ) {
				//	エマといっしょのときは
				if ($f:エマ存在フラグ == 1 ) {
					chara カメラ設定 モーションカメラ２ \
						-c 1 \
						-p 58105,4630,-42345 -t 57740,1567,-43053 \
						-r 858,2358,0 -f 3165 \
						-a 200 \
						-i 0 2 0 0 \
						-s 1
				} else {
					chara カメラ設定 モーションカメラ２ \
						-c 1 \
						-p 58515,4505,-41755 -t 57803,452,-43559 \
						-r 733,2293,0 -f 4493 \
						-a 200 \
						-i 0 2 0 0 \
						-s 1
				}
			 } else {
				chara カメラ設定 モーションカメラ２ \
					-c 1 \
					-p 58515,4505,-41755 -t 57803,452,-43559 \
					-r 733,2293,0 -f 4493 \
					-a 200 \
					-i 0 2 0 0 \
					-s 1
			}
		} else if( $s:登場ポイント == Ｅ脚からダンボール ) {
			// Ｅ脚から
			chara カメラ設定 モーションカメラ２ \
				-c 1 \
				-p 58821,81,-24850 -t 59504,-2127,-25929 \
				-r 682,1680,0 -f 2551 \
				-a 200 \
				-i 0 2 0 0 \
				-s 1
		}
	}

	proc スタートカメラオフ {
		#if d:DEBUG_PRINT
			print 'start_camera_off'
		#endif

		chara カメラ設定 モーションカメラ２ -s -1
	}

	// ステージ終了時カメラ 
	// ------------------------------------
	proc エンドカメラセット $:エンドポイント {
		#if d:DEBUG_PRINT
			print 'end_camera_set'
		#endif

		if( $:エンドポイント == ＦＡ連絡橋１Ｆ ) {
			// ＦＡ連絡橋１Ｆへ
			chara カメラ設定 モーションカメラ２ \
				-c 1 \
				-p 47638,2473,-15175 -t 46150,1544,-17227 \
				-r 229,2457,0 -f 2700 \
				-a 200 \
				-i 0 2 0 0 \
				-s 1
		} else if( $:エンドポイント == ＦＡ連絡橋Ｂ１ ) {
			// ＦＡ連絡橋Ｂ１へ
			chara カメラ設定 モーションカメラ２ \
				-c 1 \
				-p 44024,-519,-24985 -t 44024,-3485,-25176 \
				-r 982,2048,0 -f 2972 \
				-a 200 \
				-i 0 2 0 0 \
				-s 1
		} else if( $:エンドポイント == ＥＦ連絡橋 ) {
			// ＥＦ連絡橋へ
			chara カメラ設定 モーションカメラ２ \
				-c 1 \
				-p 58515,4505,-41755 -t 57803,452,-43559 \
				-r 733,2293,0 -f 4493 \
				-a 200 \
				-i 0 2 0 0 \
				-s 1
		}
	}


// 各マップ別設定
// ------------------------------------
	// ロッカー関係
	// -----------------------------------
	proc ロッカー管理人設置 {
		#if d:DEBUG_PRINT
			print 'locker_set'
		#endif

		chara ロッカー管理 管理人さん -n 11
		command ロッカーモーション -motion locker
		command プレイヤーロッカーモーション -motion sna_locker
	}


// １Ｆ左上小部屋
	// 透明壁の設定
	// ------------------------------------
	proc １Ｆ左上小部屋透明壁設置 {
		#if d:DEBUG_PRINT
			print 'w22a0a_tr_wall_set'
		#endif

		@東西５０ｃｍ幅透明壁設置 １Ｆ左上小部屋上壁 45250 0 -38750 2000
		@東西５０ｃｍ幅透明壁設置 １Ｆ左上小部屋下壁 45250 0 -37750 2000

		trap wl001 d:PLAYER \
			-mask ？ \
			-state 4 \	
			-exec {
				if ($3 == 入る) {
					command パッド操作 -mask d:PAD_B
					mesg 透明壁 １Ｆ左上小部屋上壁 off
					mesg 透明壁 １Ｆ左上小部屋下壁 off
				} else {
					command パッド操作 -cancel 0
					mesg 透明壁 １Ｆ左上小部屋上壁 on
					mesg 透明壁 １Ｆ左上小部屋下壁 on
				}
			}
	}

	// ロッカー関係
	// -----------------------------------
	proc ロッカーチェック $:番号 {
		@壊れ物再セットチェック $b:w22a_ロッカー破壊ロード回数[$:番号]
		if($f:再セットフラグ) {
			eval( $i:w22a_ロッカー状態[$:番号] = 0 );
		}
	}

	proc ロッカー状態保存 $:番号 $:行動 $:ロッカー名 {
		if(($:行動 != 6) && ($:行動 != 8)) {
			// 状態変化時
			eval($b:w22a_ロッカー破壊ロード回数[$:番号] = $w:グローバルロード回数);
		} else if($:行動 == 8) {
			// ステージ終了時
			command ロッカー状態 -n $:ロッカー名
			eval($i:w22a_ロッカー状態[$:番号] = $status)
		}
	}

	proc １Ｆ左上小部屋ロッカー設置 {
		#if d:DEBUG_PRINT
			print 'w22a0a_locker_set'
		#endif

		@ロッカーチェック 0
		chara ロッカー ロッカー01 \
			-kms neo_locker_door \
			-p 49625,0,-37800 \
			-r 0,3072,0 \
			-down_rot 0,3000,0 \
			-down_shift 125,0,0 \
			-s $$i:ロッカー初期状態[0] \
			-seno d:SD_LOCKER_HZD \
			-sefloor d:SD_LOCKER_FLR \
			-load_state $i:w22a_ロッカー状態[0] \
			-exec {
				@プレイヤーロッカーに入ったかチェック $2 $3 $4
				@ロッカー状態保存 0 $3 $4
			}
		trap lk001 d:PLAYER \
			-and \
			-mask いる \
			-state 0,4 \
			-dir 1024,512 3072,512 \
			-key d:PAD_ACTION,-1 \				//アクションボタン
			-exec {
				command ロッカー状態 -n ロッカー01
				mesg プレイヤー d:PLAYER locker ロッカー01 $status 1024,512 49625,-37800
			}
		trap lk001 d:PLAYER \
			-mask ？ \
			-state 6 \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 48244,4583,-36809 -t 49346,1635,-38207 \
					-r 670,1613,0 -f 3444 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3
			}

		@ロッカーチェック 1
		if ( $$i:ロッカー初期状態[1] == d:LOCKER_STATE_DESTROY ) {
			// 無理やり閉じる場合は壊れたドアも内側へ
			chara ロッカー ロッカー02 \
				-kms neo_locker_door \
				-p 49625,0,-36800 \
				-r 0,3072,0 \
				-down_rot 0,3072,0 \
				-down_shift 125,0,250 \
				-s $$i:ロッカー初期状態[1] \
				-f d:LOCKER_FLAG_DOWNOUTSIDE \
				-seno d:SD_LOCKER_HZD \
				-sefloor d:SD_LOCKER_FLR \
				-load_state $i:w22a_ロッカー状態[1] \
				-exec {
					@プレイヤーロッカーに入ったかチェック $2 $3 $4
					@ロッカー状態保存 1 $3 $4
				}
		} else {
			// それ以外の場合もクリアリングの関係で壊れてあかないままで
			chara ロッカー ロッカー02 \
				-kms neo_locker_door \
				-p 49625,0,-36800 \
				-r 0,3072,0 \
				-down_rot 0,3072,0 \
				-down_shift 125,0,250 \
				-s d:LOCKER_STATE_DESTROY \
				-f d:LOCKER_FLAG_DOWNOUTSIDE \
				-seno d:SD_LOCKER_HZD \
				-sefloor d:SD_LOCKER_FLR \
				-load_state $i:w22a_ロッカー状態[1] \
				-exec {
					@プレイヤーロッカーに入ったかチェック $2 $3 $4
					@ロッカー状態保存 1 $3 $4
				}
		}

		trap lk002 d:PLAYER \
			-and \
			-mask いる \
			-state 0,4 \
			-dir 1024,512 3072,512 \
			-key d:PAD_ACTION,-1 \				//アクションボタン
			-exec {
				command ロッカー状態 -n ロッカー02
				mesg プレイヤー d:PLAYER locker ロッカー02 $status 1024,512 49625,-36800
			}
		trap lk002 d:PLAYER \
			-mask ？ \
			-state 6 \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 48145,4277,-36197 -t 49341,1263,-37347 \
					-r 696,1523,0 -f 3440 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3
			}
	}

	// ジャンプ設定
	// ------------------------------------
	proc １Ｆ左上小部屋ジャンプ設定 {
		#if d:DEBUG_PRINT
			print 'w22a0a_jump_set'
		#endif

		trap ky001 d:PLAYER \
			-mask 入る \
			-exec {
				@ジャンプ発動 ky001 1000 10
			}
	}

