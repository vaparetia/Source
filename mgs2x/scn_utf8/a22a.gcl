		// Ｂ１ダクトの表示非表示
		trap ob100 d:PLAYER \
			-mask ？ \
			-exec {
				if ($3 == 入る) {
					mesg プットオブジェ Ｂ１ダクト on
				} else if ($3 == 出る) {
					mesg プットオブジェ Ｂ１ダクト off
				}
			}
		
	}

	proc Ｂ１黒天井表示切り替え {
