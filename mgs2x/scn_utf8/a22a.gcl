					3, d:C_R3:２番兵ロッカー開けルート, 5 隙間チェック３ \
					3, d:C_R3:２番兵ロッカー開けルート, 9 ダクトチェック３ \
					3, d:C_R3:２番兵隙間のぞきルート, 4 ダクトチェック３ \
					3, d:C_R3:先頭兵標準ルート, 0 子画面オンオフチェック３ \
					3, d:C_R3:先頭兵標準ルート, 0 クリアリングカメラ３－１ \
					3, d:C_R3:先頭兵標準ルート, 4 クリアリングカメラ３－２
		}
	}

	proc スタンチェック３ {
		// マップ外に出ていたらスタン投げキャンセル
		if ( `command プレイヤーマップ名` != １Ｆ中央右小部屋 ) {
			command チェンジクリアリングルート 敵兵:61 -r d:C_R3:先頭兵スタンルート -p 2
		}
	}

	proc ダクトちょっとだけチェック {
		if ( $b:w22a_クリアリング回避回数[3] < $w:クリアリングレベルアップ回数 ) {
			// 規定数を超えるまではダクトちょっとだけチェックをしない
			command チェンジクリアリングルート 敵兵:62 -r d:C_R3:２番兵ルート -p 7
		}
	}

	proc ロッカーチェック３ {
		if ( $b:w22a_クリアリング回避回数[3] >= $w:クリアリングレベルアップ回数 + 1 ) {
			// 規定数+1を超えるとロッカー開けルートか隙間のぞきルートへチェンジ（ノーマル以上）
			
			if ( $w:ゲーム設定 <= d:LEVEL_NORMAL && $s:プレイヤーがいるロッカー名 == ロッカー31 ) {
			// ノーマル以下でプレイヤーがロッカーに隠れていた場合は無条件に隙間のぞきルートへ
				command チェンジクリアリングルート 敵兵:62 -r d:C_R3:２番兵隙間のぞきルート -p 0
			} else {
				command ロッカー状態 -n ロッカー31
				if ( !($status & 0x2000) && ($status & 0x0001) ) {
					command チェンジクリアリングルート 敵兵:62 -r d:C_R3:２番兵ロッカー開けルート -p 0
				} else {
					if ( $w:ゲーム設定 <= d:LEVEL_NORMAL && $i:プレイヤー位置Ｚ < -32375 ) {
					// ノーマル以下では隙間に隠れていたらダクトを見るルートに変更
						command チェンジクリアリングルート 敵兵:62 -r d:C_R3:２番兵ロッカー開けルート -p 5
					} else {
						command チェンジクリアリングルート 敵兵:62 -r d:C_R3:２番兵隙間のぞきルート -p 0
					}
				}
			}
		}
	}

	proc 隙間チェック３ {
		if ( $w:ゲーム設定 <= d:LEVEL_NORMAL && $i:プレイヤー位置Ｚ < -32375 ) {
			// ノーマル以下では隙間に隠れていたらダクトを見るルートに変更
			command チェンジクリアリングルート 敵兵:62 -r d:C_R3:２番兵ダクトのぞきルート -p 1
		}
	}

	proc ダクトチェック３ {
		if ( $w:ゲーム設定 <= d:LEVEL_NORMAL && $i:プレイヤー位置Ｘ > 62750 ) {
			// ノーマル以下ではダクトに隠れていたら直帰ルートに変更
			command チェンジクリアリングルート 敵兵:62 -r d:C_R3:２番兵直帰ルート -p 0
		} else {
			command チェンジクリアリングルート 敵兵:62 -r d:C_R3:２番兵ダクトのぞきルート -p 0
		}
	}

	proc 子画面オンオフチェック３ {
		eval( $f:クリアリング子画面フラグ = 1 );
	}

	proc クリアリングカメラ３－１ {
		command カメラマップ設定 -chanl 1 -map １Ｆ中央広場
		eval( $f:クリアリング中フラグ = 1 );
		chara カメラ設定 クリアリングカメラ \
			-c 1 \	
			-p 62725,2546,-25205 -t 59892,1378,-26566 \
			-r 232,2780,0 -f 3353 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1

		chara カメラ設定 クリアリングカメラ \
			-c 1 \	
			-p 62896,2034,-25117 -t 60066,860,-26483 \
			-r 233,2779,0 -f 3354 \
			-a 200 \
			-i 0 -1 0 0 \
			-z d:CAMERA_INTERP_CAMERA \ // 補完カメラフラグを指定。
			-interp_time (60*2) \ // 補完時間を指定
			-s 1
	}

	proc クリアリングカメラ３－２ {
		command カメラマップ設定 -chanl 1 -map １Ｆ中央右小部屋
		chara カメラ設定 クリアリングカメラ \
			-c 1 \	
			-p 58522,4589,-32654 -t 60308,771,-27737 \
			-r 411,227,0 -f 6477 \
			-a 205 \
			-i 0 -1 0 0 \
			-s 1

		chara カメラ設定 クリアリングカメラ \
			-c 1 \	
			-p 58524,4589,-32655 -t 60319,-584,-29195 \
			-r 603,312,0 -f 6477 \
			-a 170 \
			-i 0 -1 0 0 \
			-z d:CAMERA_INTERP_CAMERA \ // 補完カメラフラグを指定。
			-interp_time (60*10) \ // 補完時間を指定
			-s 1
	}


	// １Ｆ-Ｅ倉庫のクリアリング
	//---------------------------------------
	proc クリアリングエリア４初期設定 {

		eval( $b:クリアリングエリア番号 = 4 );
		#if d:DEBUG_PRINT
			print '$b:クリアリングエリア番号='$b:クリアリングエリア番号
			print '$b:w22a_クリアリング回避回数['$b:クリアリングエリア番号']='$b:w22a_クリアリング回避回数[$b:クリアリングエリア番号]
		#endif

		if ( $b:w22a_クリアリング回避回数[4] >= $w:クリアリングレベルアップ回数 ) {
			// 規定数を超えるとスタングレネードを投げてくる
			command セットクリアリング \
				-i	d:C_R4:先頭兵スタンルート, \
					d:C_R4:２番兵ルート, \
					d:C_R4:３番兵ルート, \
					d:C_R4:４番兵ルート \
				-p	4, d:C_R4:先頭兵スタンルート, 0 スタンチェック４ \
					4, d:C_R4:２番兵ルート, 9 ロッカーチェック４ \
					4, d:C_R4:先頭兵スタンルート, 0 子画面オンオフチェック４ \
					4, d:C_R4:先頭兵スタンルート, 0 クリアリングカメラ４－１ \
					4, d:C_R4:先頭兵スタンルート, 3 クリアリングカメラ４－２
				
		} else {
			// はじめのうちはこっち
			command セットクリアリング \
				-i	d:C_R4:先頭兵標準ルート, \
					d:C_R4:２番兵ルート, \
					d:C_R4:３番兵ルート, \
					d:C_R4:４番兵ルート \
				-p	4, d:C_R4:先頭兵標準ルート, 0 子画面オンオフチェック４ \
					4, d:C_R4:先頭兵標準ルート, 0 クリアリングカメラ４－１ \
					4, d:C_R4:先頭兵標準ルート, 3 クリアリングカメラ４－２
		}
	}

	proc スタンチェック４ {
		// マップ外に出ていたらスタン投げキャンセル
		if ( `command プレイヤーマップ名` != １Ｆ左下小部屋 ) {
			command チェンジクリアリングルート 敵兵:61 -r d:C_R4:先頭兵スタンルート -p 2
		}
	}

	proc ロッカーチェック４ {
		if ( $b:w22a_クリアリング回避回数[4] >= $w:クリアリングレベルアップ回数 + 1 ) {
			// 規定数+1を超えるとロッカー開けルートへチェンジ
			command ロッカー状態 -n ロッカー41
			if ( !($status & 0x2000) && ($status & 0x0001) ) {
				// ノーマル以下では中に入っていたら開けない
				if ( $w:ゲーム設定 >= d:LEVEL_HARD || $s:プレイヤーがいるロッカー名 != ロッカー41 ) {
					command チェンジクリアリングルート 敵兵:62 -r d:C_R4:２番兵ロッカー開けルート -p 0
				}
			}
		}
	}

	proc 子画面オンオフチェック４ {
		eval( $f:クリアリング子画面フラグ = 1 );
	}

	proc クリアリングカメラ４－１ {
		command カメラマップ設定 -chanl 1 -map １Ｆ中央広場
		eval( $f:クリアリング中フラグ = 1 );
		chara カメラ設定 クリアリングカメラ \
			-c 1 \	
			-p 50314,2840,-15722 -t 49145,462,-20613 \
			-r 288,2201,0 -f 5563 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1

