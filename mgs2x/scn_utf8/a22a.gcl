// Ｂ１上小部屋
	// 透明壁の設定
	// ------------------------------------
	proc Ｂ１上小部屋透明壁設置 {
		#if d:DEBUG_PRINT
			print 'w22a1a_tr_wall_set'
		#endif

		@東西５０ｃｍ幅透明壁設置 Ｂ１上小部屋左上壁 46250 -5000 -42500 2000
		@東西５０ｃｍ幅透明壁設置 Ｂ１上小部屋左下壁 46250 -5000 -41000 2000

		@東西５０ｃｍ幅透明壁設置 Ｂ１上小部屋右上壁 57250 -5000 -42500 2000
		@東西５０ｃｍ幅透明壁設置 Ｂ１上小部屋右下壁 57250 -5000 -41000 2000

		@南北５０ｃｍ幅透明壁設置 Ｂ１上小部屋左壁 51500 -5000 -41500 2000
		@南北５０ｃｍ幅透明壁設置 Ｂ１上小部屋右壁 52500 -5000 -41500 2000

		trap wl101 d:PLAYER \
			-mask ？ \
			-state 4 \	
			-exec {
				if ($3 == 入る) {
					command パッド操作 -mask d:PAD_B
					mesg 透明壁 Ｂ１上小部屋左上壁 off
					mesg 透明壁 Ｂ１上小部屋左下壁 off
				} else {
					command パッド操作 -cancel 0
					mesg 透明壁 Ｂ１上小部屋左上壁 on
					mesg 透明壁 Ｂ１上小部屋左下壁 on
				}
			}

		trap wl101 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_BEHINDCAMERA_ENABLE \	
			-exec {
				// 張り付いたときのカメラ
				chara カメラ設定 モーションカメラ \
					-c 0 \	
					-b 48000,2440,d:CAM_MIN d:CAM_MAX,2440,d:CAM_MAX \
					-l 48000,-3000,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 870,2048,0 \
					-f 6000 \
					-a 200 \
					-i 2 2 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		trap wl102 d:PLAYER \
			-mask ？ \
			-state 4 \	
			-exec { 
				if ($3 == 入る) {
					command パッド操作 -mask d:PAD_B
					mesg 透明壁 Ｂ１上小部屋右上壁 off
					mesg 透明壁 Ｂ１上小部屋右下壁 off
				} else {
					command パッド操作 -cancel 0
					mesg 透明壁 Ｂ１上小部屋右上壁 on
					mesg 透明壁 Ｂ１上小部屋右下壁 on
				}
			}

		trap wl102 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_BEHINDCAMERA_ENABLE \	
			-exec {
				// 張り付いたときのカメラ
				chara カメラ設定 モーションカメラ \
					-c 0 \	
					-b d:CAM_MIN,2440,d:CAM_MIN 56000,2440,d:CAM_MAX \
					-l d:CAM_MIN,-3000,d:CAM_MIN 56000,d:CAM_MAX,d:CAM_MAX \
					-r 870,2048,0 \
					-f 6000 \
					-a 200 \
					-i 2 2 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		trap wl103 d:PLAYER \
			-mask ？ \
			-state 4 \	
			-exec {
				if ($3 == 入る) {
					command パッド操作 -mask d:PAD_B
					mesg 透明壁 Ｂ１上小部屋左壁 off
					mesg 透明壁 Ｂ１上小部屋右壁 off
				} else {
					command パッド操作 -cancel 0
					mesg 透明壁 Ｂ１上小部屋左壁 on
					mesg 透明壁 Ｂ１上小部屋右壁 on
				}
			}

		trap wl103 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_BEHINDCAMERA_ENABLE \	
			-exec {
				// 張り付いたときのカメラ
				chara カメラ設定 モーションカメラ \
					-c 0 \	
					-b d:CAM_MIN,2440,d:CAM_MIN d:CAM_MAX,2440,d:CAM_MAX \
					-l d:CAM_MIN,-3000,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 870,2048,0 \
					-f 6000 \
					-a 200 \
					-i 2 2 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}
	}

	// 各種カメラの設定
	// ------------------------------------
	proc Ｂ１上小部屋カメラ設定 {
		#if d:DEBUG_PRINT
			print 'w22a1a_camera_set'
		#endif

		trap ca101 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ降順 $6 -36500 -39500 49500 50000
				eval( $i:補完ＢＸ = $i:CS_結果１ );
				eval( $i:補完ＬＸ = $i:CS_結果１ );

				@CS_スムーズカメラ降順 $6 -36500 -39500 54500 54000
				eval( $i:補完ＢＸ２ = $i:CS_結果１ );
				eval( $i:補完ＬＸ２ = $i:CS_結果１ );

