// Ｂ１中央広場
	// 解体Ｃ４設置
	// ------------------------------------
	proc 解体Ｃ４設置 {
		if ( $f:w22a_爆弾処理完了 == 0 ) {
			if ( $w:ゲーム設定 <= d:LEVEL_HARD ) {
				chara 解体Ｃ４ 解体Ｃ４ \
					-position 46000,-4000,-29500 \
					-rotate 0,1024,0 \
					-type 0 \
					-state 0 \
					-proc 爆弾解体後処理
			} else {
				chara 解体Ｃ４ 解体Ｃ４ \
					-position 46500,-4000,-28875 \
					-rotate 0,2048,0 \
					-type 0 \
					-state 0 \
					-proc 爆弾解体後処理
			}

			chara 爆弾検知領域 Bomb_Type_A \
				-trap bm000
		} else {
			if ( $w:ゲーム設定 <= d:LEVEL_HARD ) {
				chara 解体Ｃ４ 解体Ｃ４ \
					-position 46000,-4000,-29500 \
					-rotate 0,1024,0 \
					-type 0 \
					-state 1
			} else {
				chara 解体Ｃ４ 解体Ｃ４ \
					-position 46500,-4000,-28875 \
					-rotate 0,2048,0 \
					-type 0 \
					-state 1
			}
		}
	}

	proc Ｂ１中央広場透明壁設置 {
		#if d:DEBUG_PRINT
			print 'w22a1d_tr_wall_set'
		#endif

		@南北５０ｃｍ幅透明壁設置 Ｂ１中央広場左壁 51000 -5000 -35500 4000
		@南北５０ｃｍ幅透明壁設置 Ｂ１中央広場右壁 53000 -5000 -35500 4000

		@東西５０ｃｍ幅透明壁設置 Ｂ１中央広場上壁 60000 -5000 -30000 4000
		@東西５０ｃｍ幅透明壁設置 Ｂ１中央広場下壁 60000 -5000 -28000 4000


		trap wl131 d:PLAYER \
			-mask ？ \
			-state 4 \
			-exec {
				if ($3 == 入る) {
					command パッド操作 -mask d:PAD_B
					mesg 透明壁 Ｂ１中央広場左壁 off
					mesg 透明壁 Ｂ１中央広場右壁 off
				} else {
					command パッド操作 -cancel 0
					mesg 透明壁 Ｂ１中央広場左壁 on
					mesg 透明壁 Ｂ１中央広場右壁 on
				}
			}

		trap wl131 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_BEHINDCAMERA_ENABLE \	
			-exec {
				// 張り付いたときのカメラ
				chara カメラ設定 モーションカメラ \
					-c 0 \	
					-b d:CAM_MIN,4172,-32000 d:CAM_MAX,4172,d:CAM_MAX \
					-l d:CAM_MIN,-3000,-33393 d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 910,2048,0 \
					-f 7980 \
					-a 200 \
					-i 2 2 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		trap wl132 d:PLAYER \
			-mask ？ \
			-state 4 \	
			-exec { 
				if ($3 == 入る) {
					command パッド操作 -mask d:PAD_B
					mesg 透明壁 Ｂ１中央広場上壁 off
					mesg 透明壁 Ｂ１中央広場下壁 off
				} else {
					command パッド操作 -cancel 0
					mesg 透明壁 Ｂ１中央広場上壁 on
					mesg 透明壁 Ｂ１中央広場下壁 on
				}
			}

		trap wl132 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_BEHINDCAMERA_ENABLE \	
			-exec {
				// 張り付いたときのカメラ
				chara カメラ設定 モーションカメラ \
					-c 0 \	
					-b d:CAM_MIN,2764,d:CAM_MIN 58580,2764,d:CAM_MAX \
					-l d:CAM_MIN,-3000,d:CAM_MIN 58580,d:CAM_MAX,d:CAM_MAX \
					-r 870,2048,0 \
					-f 6357 \
					-a 200 \
					-i 2 2 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}
	}

	// 強制モーション用トラップ
	// ------------------------------------
	// ジャンプ設定
	// ------------------------------------
	proc Ｂ１中央広場ジャンプ設定 {
		#if d:DEBUG_PRINT
			print 'w22a1c_jump_set'
