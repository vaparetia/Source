	// 各種カメラの設定
	// ------------------------------------
	proc Ｂ１中央広場カメラ設定 {
		#if d:DEBUG_PRINT
			print 'w22a1c_camera_set'
		#endif

		// ロードドア前
		trap ca131 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ２ \
					-c 0 \	
					-b 44756,1452,-25034 d:CAM_MAX,1452,-25034 \
					-l 44756,-3000,-25849 d:CAM_MAX,d:CAM_MAX,-25849 \
					-r 920,2048,0 \
					-f 5000 \
					-a 200 \
					-i 0 0 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-slide 0 5 500 500 30 0 \
					-s $3
			}

		// 中央広場
		trap ca132 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ降順 $6 -26000 -29000 48769 49777
				eval( $i:補完ＢＸ = $i:CS_結果１ );
				eval( $i:補完ＬＸ = $i:CS_結果１ );

				@CS_スムーズカメラ降順 $6 -26000 -29000 57643 57000
				eval( $i:補完ＢＸ２ = $i:CS_結果１ );
				eval( $i:補完ＬＸ２ = $i:CS_結果１ );

				@CS_スムーズカメラ降順 $6 -26000 -29000 880 700
				eval( $i:補完ＲＸ = $i:CS_結果１ );

				chara カメラ設定 サブカメラ１ \
					-c 0 \	
					-b $i:補完ＢＸ,-700,-28769 $i:補完ＢＸ２,4332,-25207 \
					-l $i:補完ＬＸ,-3000,-32822 $i:補完ＬＸ２,-2500,-26884 \
					-r $i:補完ＲＸ,2048,0 \
					-f 8500 \
					-a 200 \
					-i 2 1 0 0 \
					-s $3
			}

		// 南通路
		trap ca133 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ降順 $6 -21000 -24000 52000 52000
				eval( $i:補完ＰＸ = $i:CS_結果１ );
				@CS_スムーズカメラ降順 $6 -21000 -24000 1577 -143
				eval( $i:補完ＰＹ = $i:CS_結果１ );
				@CS_スムーズカメラ降順 $6 -21000 -24000 -18665 -18114
				eval( $i:補完ＰＺ = $i:CS_結果１ );

				@CS_スムーズカメラ降順 $6 -21000 -24000 52000 52000
				eval( $i:補完ＴＸ = $i:CS_結果１ );
				@CS_スムーズカメラ降順 $6 -21000 -24000 -3247 -3261
				eval( $i:補完ＴＹ = $i:CS_結果１ );
				@CS_スムーズカメラ降順 $6 -21000 -24000 -19889 -22923
				eval( $i:補完ＴＺ = $i:CS_結果１ );

				chara カメラ設定 サブカメラ２ \
					-c 1 \	
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,-18114 \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,-19889 \
					-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ -t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ \
					-r 375,2048,0 -f 4977 \
					-a 200 \
					-i 0 0 0 0 \
					-z (d:CAMERA_NO_CUSHION | d:CAMERA_LIMITBOUND_EXIST) \
					-s $3
			}

		if ( ($b:ミッション番号 == d:MISSION:スネークテイルズ) && \
			 ($b:tales_story_no == d:TALES_NO:B) ) {
		/*	スネークテイルズＢでは独自カメラ設定a22a_tale.hで設定	*/
			@スネークテイルズＢ用階段カメラ設定
		} else {
			@階段カメラ設定
		}

		// 左側荷物内
		trap ca135 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ２ \
					-c 1 \	
					-p 48881,3065,-27480 -t 48881,-868,-29123 \
					-r 766,2048,0 -f 4262 \
					-a 200 \
					-i 2 2 0 0 \
					-z (d:CAMERA_NO_CUSHION | d:CAMERA_BOUNDCHANGE_QUICK) \
					-s $3
			}

		// 匍匐カメラ
		trap ca136 d:PLAYER \
			-mask ＊ \
			-state d:TRP_STATE_SQUAT d:TRP_STATE_GROUND \
			-camera \
			-exec {
				@CS_スムーズカメラ降順 $6 -26000 -29000 48769 49777
				eval( $i:補完ＢＸ = $i:CS_結果１ );
				eval( $i:補完ＬＸ = $i:CS_結果１ );

				@CS_スムーズカメラ降順 $6 -26000 -29000 57643 57000
				eval( $i:補完ＢＸ２ = $i:CS_結果１ );
				eval( $i:補完ＬＸ２ = $i:CS_結果１ );

				chara カメラ設定 サブカメラ２ \
					-c 0 \	
					-b $i:補完ＢＸ,3612,d:CAM_MIN $i:補完ＢＸ２,4332,-25207 \
					-l $i:補完ＬＸ,-3000,d:CAM_MIN $i:補完ＬＸ２,d:CAM_MAX,-26884 \
					-r 910,2048,0 \
					-f 8500 \
					-a 200 \
					-i 2 2 0 0 \
					-s $3
			}


		// エルード落下中のカメラ
		trap ca077 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_ELUDE \
			-camera \
			-exec {
				chara カメラ設定 モーションカメラ２ \
					-c 0 \	
					-b d:CAM_MIN,-1250,d:CAM_MIN d:CAM_MAX,-1000,-24500 \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,-2500,-25500 \
					-r 350,2048,0 \
					-f 5500 \
					-a 200 \
					-i 0 3 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}
	}

proc 階段カメラ設定 {
	// 階段下部
	trap ca134 d:PLAYER \
		-mask ＊ \
		-camera \
		-exec {
			@CS_スムーズカメラ降順 $6 -34000 -36500 59611 60083
			eval( $i:補完ＰＸ = $i:CS_結果１ );
			@CS_スムーズカメラ降順 $6 -34000 -36500 -2649 -2921
			eval( $i:補完ＰＹ = $i:CS_結果１ );
			@CS_スムーズカメラ降順 $6 -34000 -36500 -29558 -30040
			eval( $i:補完ＰＺ = $i:CS_結果１ );

			@CS_スムーズカメラ降順 $6 -34000 -36500 58753 59209
			eval( $i:補完ＴＸ = $i:CS_結果１ );
			@CS_スムーズカメラ降順 $6 -34000 -36500 -3653 -2328
			eval( $i:補完ＴＹ = $i:CS_結果１ );
			@CS_スムーズカメラ降順 $6 -34000 -36500 -35802 -36398
			eval( $i:補完ＴＺ = $i:CS_結果１ );

			@CS_スムーズカメラ降順 $6 -34000 -36500 200 250
			eval( $w:補完画角 = $i:CS_結果１ );

			chara カメラ設定 メインカメラ \
				-c 1 \	
				-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ -t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ \
				-r -41,2154,0 -f 6479 \
				-a $w:補完画角 \
				-i 0 -1 0 0 \
				-z d:CAMERA_NO_CUSHION \
				-s $3
		}

	// 階段上部
	trap ca063 d:PLAYER \
		-mask ＊ \
		-camera \
		-exec {
			@CS_スムーズカメラ降順 $6 -38500 -40250 60290 60291
			eval( $i:補完ＰＸ = $i:CS_結果１ );
			@CS_スムーズカメラ降順 $6 -38500 -40250 2747 2747
			eval( $i:補完ＰＹ = $i:CS_結果１ );
			@CS_スムーズカメラ降順 $6 -38500 -40250 -33195 -33196
			eval( $i:補完ＰＺ = $i:CS_結果１ );

			@CS_スムーズカメラ降順 $6 -38500 -40250 59554 59465
			eval( $i:補完ＴＸ = $i:CS_結果１ );
			@CS_スムーズカメラ降順 $6 -38500 -40250 -1217 238
			eval( $i:補完ＴＹ = $i:CS_結果１ );
			@CS_スムーズカメラ降順 $6 -38500 -40250 -39163 -39896
			eval( $i:補完ＴＺ = $i:CS_結果１ );

			chara カメラ設定 メインカメラ \
				-c 1 \	
				-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ -t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ \
				-r 224,2128,0 -f 6486 \
				-a 220 \
				-i 0 0 0 0 \
				-z d:CAMERA_NO_CUSHION \
				-s $3
		}

}






