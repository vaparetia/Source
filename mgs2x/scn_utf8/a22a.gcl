// ------------------------------------
// 敵兵音声
// ------------------------------------
// 司令官、危険モード時の音声リソース
resource ghq_area_alert_voice {
	w22a:
		$t{
			// PLAREA0 Ａ倉庫
			t:vc040208,		// 指揮官「了解。増援部隊、Ｆ脚１Ｆ・Ａ倉庫に向かえ！敵を包囲せよ！」
			t:vc040209,		// 指揮官「了解。バックアップ、Ｆ脚１Ｆに向かえ！Ａ倉庫を守れ！」
			-2, // PLAREA0の登録終了
			// PLAREA1 Ｂ倉庫
			t:vc040210,		// 指揮官「了解。応援部隊、Ｆ脚１Ｆ・Ｂ倉庫に向かえ！敵を逃がすな！」
			t:vc040211,		// 指揮官「了解。増援部隊、Ｆ脚１Ｆに急行せよ！敵をＢ倉庫に追い込め！」
			-2, // PLAREA1の登録終了
			// PLAREA2 Ｃ倉庫
			t:vc040212,		// 指揮官「了解。増援部隊、Ｆ脚１Ｆ・Ｃ倉庫に向かえ！侵入者を仕留めろ！」
			t:vc040213,		// 指揮官「了解。バックアップ、Ｆ脚１Ｆに向かえ！Ｃ倉庫を包囲せよ！」
			-2, // PLAREA2の登録終了
			// PLAREA3 Ｄ倉庫
			t:vc040214,		// 指揮官「了解。増援部隊、Ｆ脚１Ｆ・Ｄ倉庫に向かえ！敵を逃がすな」
			t:vc040215,		// 指揮官「了解。増援部隊、Ｆ脚１Ｆに向かえ！Ｄ倉庫で敵を仕留めろ」
			-2, // PLAREA3の登録終了
			// PLAREA4 Ｅ倉庫
			t:vc040216,		// 指揮官「了解。応援部隊、Ｆ脚１Ｆ・Ｅ倉庫に向かえ！侵入者を逃がすな！」
			t:vc040217,		// 指揮官「了解。応援部隊、Ｆ脚１Ｆに向かえ！Ｅ倉庫から敵を逃がすな」
			-2, // PLAREA4の登録終了
			// PLAREA5 Ｆ倉庫
			t:vc040218,		// 指揮官「了解。バックアップ、Ｆ脚１Ｆ・Ｆ倉庫に向かえ！敵を追い込め！」
			t:vc040219,		// 指揮官「了解。バックアップ、Ｆ脚１Ｆに向かえ！Ｆ倉庫を包囲しろ」
			-2, // PLAREA5の登録終了
			// PLAREA6 ＥＦ連絡橋
			t:vc040200,		// 指揮官「了解。増援部隊、Ｆ脚Ｂ１・Ｇ倉庫に向かえ！侵入者を包囲せよ！」
			t:vc040201,		// 指揮官「了解。増援部隊、Ｆ脚Ｂ１に急行！Ｇ倉庫で敵を仕留めろ！」
			-2, // PLAREA6の登録終了
			// PLAREA7 全体
			t:vc040226,		// 指揮官「了解。増援部隊、Ｆ脚に向かえ！敵を逃がすな！」
			t:vc040227,		// 指揮官「了解。増援部隊をＦ脚に送る！侵入者を逃がすな！」
			-2, // PLAREA7の登録終了
			// PLAREA8 ＦＡ連絡橋
			t:vc040202,		// 指揮官「了解。増援部隊、Ｆ脚・ＦＡ連絡橋への扉付近に向かえ！敵の前進を阻止せよ！」
			t:vc040203,		// 指揮官「了解。応援部隊、Ｆ脚へ急行せよ！ＦＡ連絡橋への扉を守れ！」
			-2, // PLAREA8の登録終了
			// PLAREA9 Ｇ倉庫
			t:vc040220,		// 指揮官「了解。増援部隊、Ｆ脚Ｂ１・Ｇ倉庫に向かえ！侵入者を包囲せよ！」
			t:vc040221,		// 指揮官「了解。増援部隊、Ｆ脚Ｂ１に急行！Ｇ倉庫で敵を仕留めろ！」
			-2, // PLAREA9の登録終了
			// PLAREA10 Ｈ倉庫
			t:vc040222,		// 指揮官「了解。応援部隊、Ｆ脚Ｂ１・Ｈ倉庫に向かえ！敵を逃がすな！」
			t:vc040223,		// 指揮官「了解。応援部隊、Ｆ脚Ｂ１に向かえ！Ｈ倉庫を固めろ！」
			-2, // PLAREA10の登録終了
			// PLAREA11 Ｉ倉庫
			t:vc040224,		// 指揮官「了解。バックアップ、Ｆ脚Ｂ１・Ｉ倉庫に向かえ！敵を仕留めろ！」
			t:vc040225,		// 指揮官「了解。増援部隊、Ｆ脚Ｂ１に向かえ！Ｉ倉庫を囲め！」
			-2, // PLAREA11の登録終了
			// PLAREA12 階段
			t:vc040204,		// 指揮官「了解。増援部隊をＦ脚・階段に派遣する！敵を仕留めろ！」
			t:vc040205,		// 指揮官「了解。応援部隊、Ｆ脚に出動！階段を固めろ！」
			-1 // 全ての登録終了
		}
}

// 司令官、警戒モード時の音声リソース
resource ghq_caution_voice {
	w22a:
		$t{
			t:vc040383,		// 指揮官「了解。Ｆ脚を増員する。警備を強化しろ」
			t:vc040384,		// 指揮官「了解。Ｆ脚に増員を派遣する。警戒を強化しろ」
			-2
			t:vc040430,		// 指揮官「Ｆ脚との連絡が途絶えた」
			-1
		}
}

// 敵兵ルート番号
enum E_R {
	攻撃兵待機ルート上 = 0,
	攻撃兵待機ルート下,
	解体前ＶＥ用ルート上,
	解体前ＶＥ用ルート下,
	解体前定時連絡ルート上,
	解体前定時連絡ルート下,
	解体前ＨＤ用追加ルート上,
	解体前ＨＤ用追加ルート下,
	解体前定時連絡ルート上ＥＸ,
	解体前定時連絡ルート下ＥＸ,
	解体前ＨＤ用追加ルート上ＥＸ,
	解体前ＨＤ用追加ルート下ＥＸ,
	解体中ＶＥ用ルート上,
	解体中定時連絡ルート上,
	解体中ルート上,
	解体中ルート下,
	解体中ＨＤ用追加ルート下,
	解体中定時連絡ルート上ＥＸ,
	解体中ルート上ＥＸ,
	解体中ルート下南ＥＸ,
	解体中ルート下西ＥＸ,
	Ｇ倉庫ルートＥＸ
}


