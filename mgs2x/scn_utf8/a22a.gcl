	proc ロッカーチェック２ {
		if ( $b:w22a_クリアリング回避回数[2] >= $w:クリアリングレベルアップ回数 + 1 ) {
			// 規定数+1を超えると厳しいルートへチェンジ
			command チェンジクリアリングルート 敵兵:61 -r d:C_R2:先頭兵ダクトのぞきルート -p 0
			
			// ノーマル以下でプレイヤーがロッカーに隠れていた場合は無条件にロッカー開けないルート
			if ( $w:ゲーム設定 <= d:LEVEL_NORMAL && $s:プレイヤーがいるロッカー名 == ロッカー21 ) {
				command チェンジクリアリングルート 敵兵:62 -r d:C_R2:２番兵ロッカーしまってたときルート -p 0
			} else {
				command ロッカー状態 -n ロッカー21
				if ( !($status & 0x2000) && ($status & 0x0001) ) {
					command チェンジクリアリングルート 敵兵:62 -r d:C_R2:２番兵ロッカー開けルート -p 0
				} else {
