if( $s:登場ポイント == ＦＡ連絡橋１Ｆから ) {
	// ＦＡ連絡橋１Ｆから
	//初期マップの表示
	command マップ表示 -show １Ｆ北通路
	command マップ表示 -show １Ｆ中央広場
	command マップ表示 -show Ｂ１中央広場

	mesg マップ接合 １Ｆ北／中央 on
	mesg マップ接合 １Ｆ北／Ｂ１中央 on

	eval ( $f:w22a_Ｂ１いるフラグ = 0 );

	// 全てのセットが終わったところでフェードイン
	@ステージ開始時処理（ステージ名表示）\
		d:LOAD_TYPE:SL_DOOR_TYPE １Ｆ下ドア 2000 d:DEFAULT_M_TYPE \
		d:wn_Ｆ脚倉庫１Ｆ
} else if( $s:登場ポイント == ＦＡ連絡橋Ｂ１から ) {
	// ＦＡ連絡橋Ｂ１から
	//初期マップの表示
	command マップ表示 -show Ｂ１中央広場

	mesg マップ接合 １Ｆ北／中央 on
	mesg マップ接合 １Ｆ北／Ｂ１中央 on

	eval ( $f:w22a_Ｂ１いるフラグ = 1 );

	// 全てのセットが終わったところでフェードイン
	@ステージ開始時処理（ステージ名表示）\
		d:LOAD_TYPE:SL_DOOR_TYPE Ｂ１下ドア 2000 d:DEFAULT_M_TYPE \
		d:wn_Ｆ脚倉庫Ｂ１
} else if( $s:登場ポイント == ＥＦ連絡橋から ) {
	// ＥＦ連絡橋から
	//初期マップの表示
	command マップ表示 -show １Ｆ北通路
	command マップ表示 -show １Ｆ中央広場
	command マップ表示 -show Ｂ１中央広場

	mesg マップ接合 １Ｆ北／中央 on
	mesg マップ接合 １Ｆ北／Ｂ１中央 on

	eval ( $f:w22a_Ｂ１いるフラグ = 0 );

	// 全てのセットが終わったところでフェードイン
	@ステージ開始時処理（ステージ名表示） \
		d:LOAD_TYPE:SL_DOOR_TYPE １Ｆ上ドア 2000 d:DEFAULT_M_TYPE \
		d:wn_Ｆ脚倉庫１Ｆ
} else if( $s:登場ポイント == Ｅ脚からダンボール ) {
	// Ｅ脚から
	//初期マップの表示
	command マップ表示 -show Ｂ１中央広場

	mesg マップ接合 １Ｆ北／中央 on
	mesg マップ接合 １Ｆ北／Ｂ１中央 on

	eval ( $f:w22a_Ｂ１いるフラグ = 1 );

	// 全てのセットが終わったところでフェードイン
	@ステージ開始時処理（ダンボールワープ） d:wn_Ｆ脚倉庫Ｂ１

} else if( ($s:登場ポイント == 武装解除ミッション６面) || ($s:登場ポイント == 敵兵排除ミッション８面) ) {
	// 武装解除ミッション６面
	//初期マップの表示
	command マップ表示 -show １Ｆ北通路
	command マップ表示 -show １Ｆ中央広場
	command マップ表示 -show Ｂ１中央広場

	mesg マップ接合 １Ｆ北／中央 on
	mesg マップ接合 １Ｆ北／Ｂ１中央 on

	eval ( $f:w22a_Ｂ１いるフラグ = 0 );

} else if( $s:登場ポイント == テイルズＡエイムズ紙芝居後から ) {
	// テイルズＡエイムズ紙芝居後から
	//初期マップの表示
	command マップ表示 -show １Ｆ北通路
	command マップ表示 -show １Ｆ中央広場
	command マップ表示 -show Ｂ１中央広場

	mesg マップ接合 １Ｆ北／中央 on
	mesg マップ接合 １Ｆ北／Ｂ１中央 on

	eval ( $f:w22a_Ｂ１いるフラグ = 0 );

	// 全てのセットが終わったところでフェードイン
	@ステージ開始時処理 \
		d:LOAD_TYPE:NO_MOVE_TYPE １Ｆ左上小部屋前 0 d:DEFAULT_M_TYPE \
		d:wn_Ｆ脚倉庫１Ｆ

} else if( $s:登場ポイント == テイルズＢオタコン念押し紙芝居後から ) {
	// テイルズＢオタコン念押し紙芝居後から
	//初期マップの表示
	command マップ表示 -show １Ｆ北通路
	command マップ表示 -show １Ｆ中央広場
	command マップ表示 -show Ｂ１中央広場

	mesg マップ接合 １Ｆ北／中央 on
	mesg マップ接合 １Ｆ北／Ｂ１中央 on

	eval ( $f:w22a_Ｂ１いるフラグ = 0 );

	// 全てのセットが終わったところでフェードイン
	@ステージ開始時処理（ステージ名表示） \
		d:LOAD_TYPE:NO_MOVE_TYPE 紙芝居 0 d:DEFAULT_M_TYPE \
		d:wn_Ｆ脚倉庫１Ｆ

} else if( $s:登場ポイント == テイルズＢエマ再会紙芝居後から ) {
	// テイルズＢエマ再会紙芝居後から
	//初期マップの表示
	command マップ表示 -show １Ｆ北通路
	command マップ表示 -show １Ｆ中央広場
	command マップ表示 -show Ｂ１中央広場

	mesg マップ接合 １Ｆ北／中央 on
	mesg マップ接合 １Ｆ北／Ｂ１中央 on

	eval ( $f:w22a_Ｂ１いるフラグ = 0 );

	// 全てのセットが終わったところでフェードイン
	@ステージ開始時処理 \
		d:LOAD_TYPE:NO_MOVE_TYPE 紙芝居 0 d:DEFAULT_M_TYPE

} else if( $s:登場ポイント == テイルズＤ開始紙芝居後から ) {
	// テイルズＤスタート紙芝居後から
	//初期マップの表示
	command マップ表示 -show Ｂ１上小部屋

	mesg マップ接合 １Ｆ北／中央 on
	mesg マップ接合 １Ｆ北／Ｂ１中央 on

	eval ( $f:w22a_Ｂ１いるフラグ = 1 );

	mesg プットオブジェ Ｂ１黒天井 off

	// 全てのセットが終わったところでフェードイン
	@ステージ開始時処理 \
		d:LOAD_TYPE:NO_MOVE_TYPE 紙芝居 0 d:DEFAULT_M_TYPE

}


// 各proc設定
//-------------------------------------------------------------------------------------
// 全マップ共通
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT 
			print 'localvar_init'
		#endif

		// ダクトの中にいるときに１にする
		eval( $f:ローカルフラグ１ = 0 );
		// １Ｆ右下小部屋のドアが開いているときに1にする
		eval( $f:ローカルフラグ２ = 0 );

		// 入っているロッカーの名前
		eval( $s:プレイヤーがいるロッカー名 = なし );

		// クリアリング用子画面を初期化
		eval( $f:クリアリング子画面フラグ = 0 );
		// ゲームステータスを格納するための変数
		eval( $i:ローカル変数Ｉ１ = 0 );
	}

	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT 
			print 'status_set'
		#endif
	}


	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif

		command プラグイン自動ジャンプ
	}


	proc ダンボール柄設定 {
		#if d:DEBUG_PRINT
			print 'cb_box_area_set'
		#endif

		// マクファーレンダンボールエリア
		chara ダンボール柄トラップ設定 ダンボールエリア \
			-name d:PLAYER \
			-traps d:アイテム:ダンボールＤ bx001
	}



	// １Ｆ-Ａ倉庫のクリアリング
	//---------------------------------------
	proc クリアリングエリア０初期設定 {

		eval( $b:クリアリングエリア番号 = 0 );
		#if d:DEBUG_PRINT
			print '$b:クリアリングエリア番号='$b:クリアリングエリア番号
			print '$b:w22a_クリアリング回避回数['$b:クリアリングエリア番号']='$b:w22a_クリアリング回避回数[$b:クリアリングエリア番号]
		#endif

		if ( $b:w22a_クリアリング回避回数[0] >= $w:クリアリングレベルアップ回数 ) {
			// 規定数を超えるとスタングレネードを投げてくる
			command セットクリアリング \
				-i	d:C_R0:先頭兵スタンルート, \
					d:C_R0:２番兵ルート, \
					d:C_R0:３番兵ルート, \
					d:C_R0:４番兵ルート \
				-p	0, d:C_R0:先頭兵スタンルート, 0 スタンチェック０ \
					0, d:C_R0:先頭兵スタンルート, 11 ロッカーチェック０ \
					0, d:C_R0:２番兵ルート, 13 コース選択０ \
					0, d:C_R0:先頭兵スタンルート, 0 子画面オンオフチェック０ \
					0, d:C_R0:先頭兵スタンルート, 0 クリアリングカメラ０－１ \
					0, d:C_R0:先頭兵スタンルート, 6 クリアリングカメラ０－２
		} else {
			// はじめのうちはこっち
			command セットクリアリング \
				-i	d:C_R0:先頭兵標準ルート, \
					d:C_R0:２番兵ルート, \
					d:C_R0:３番兵ルート, \
					d:C_R0:４番兵ルート \
				-p	0, d:C_R0:２番兵ルート, 13 コース選択０ \
					0, d:C_R0:先頭兵標準ルート, 0 子画面オンオフチェック０ \
					0, d:C_R0:先頭兵標準ルート, 0 クリアリングカメラ０－１ \
					0, d:C_R0:先頭兵標準ルート, 4 クリアリングカメラ０－２
		}
	}

	proc スタンチェック０ {
		// マップ外に出ていたらスタン投げキャンセル
		if ( `command プレイヤーマップ名` != １Ｆ左上小部屋 ) {
			command チェンジクリアリングルート 敵兵:61 -r d:C_R0:先頭兵スタンルート -p 3
		}
	}

	proc ロッカーチェック０ {
		if ( $b:w22a_クリアリング回避回数[0] >= $w:クリアリングレベルアップ回数 + 1 ) {
			// 規定数+1を超えるとロッカー開けルートへチェンジ
			command ロッカー状態 -n ロッカー01
			if ( !($status & 0x2000) && ($status & 0x0001) ) {
				// ノーマル以下では中に入っていたら開けない
				if ( $w:ゲーム設定 >= d:LEVEL_HARD || $s:プレイヤーがいるロッカー名 != ロッカー01 ) {
					command チェンジクリアリングルート 敵兵:61 -r d:C_R0:先頭兵ロッカー開けルート -p 0
				}
			}
		}
	}

	proc コース選択０ {
		// EXTREMEは無条件にちょっときつめ
		if ( $w:ゲーム設定 >= d:LEVEL_EXTREME ) {
			command チェンジクリアリングルート 敵兵:62 -r d:C_R0:２番兵ＥＸルート -p 0
		}
	}

	proc 子画面オンオフチェック０ {
		eval( $f:クリアリング子画面フラグ = 1 );
	}

	proc クリアリングカメラ０－１ {
