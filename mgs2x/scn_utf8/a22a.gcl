// １Ｆ右上小部屋
	// 透明壁の設定
	// ------------------------------------
	proc １Ｆ右上小部屋透明壁設置 {
		#if d:DEBUG_PRINT
			print 'w22a0b_tr_wall_set'
		#endif

		@南北５０ｃｍ幅透明壁設置 １Ｆ右上小部屋右壁 55600 0 -41250 2000

		trap wl011 d:PLAYER \
			-mask ？ \
			-state 4 \	
			-exec {
					if ($3 == 入る) {
						command パッド操作 -mask d:PAD_B
						mesg 透明壁 １Ｆ右上小部屋右壁 off
					} else {
						command パッド操作 -cancel 0
						mesg 透明壁 １Ｆ右上小部屋右壁 on
					}
				}

		trap wl011 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_BEHINDCAMERA_ENABLE \	
			-exec {
				// 張り付いたときのカメラ
				chara カメラ設定 モーションカメラ \
					-c 1 \	
					-p 56250,7614,-39418 -t 56250,1122,-39607 \
					-r 1005,2048,0 -f 6495 \
					-a 200 \
					-i 2 2 0 0 \
					-s $3
			}
	}

