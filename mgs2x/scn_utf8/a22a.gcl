		chara カメラ設定 クリアリングカメラ \
			-c 1 \	
			-p 45804,-1432,-18287 -t 48822,-3632,-22000 \
			-r 281,1603,0 -f 5266 \
			-a 290 \
			-i 0 -1 0 0 \
			-s 1

		chara カメラ設定 クリアリングカメラ \
			-c 1 \	
			-p 45805,-1432,-18288 -t 47442,-4920,-21877 \
			-r 472,1769,0 -f 5266 \
			-a 172 \
			-i 0 -1 0 0 \
			-z d:CAMERA_INTERP_CAMERA \ // 補完カメラフラグを指定。
			-interp_time (60*7) \ // 補完時間を指定
			-s 1
	}

	// Ｂ１-Ｉ倉庫のクリアリング
	//---------------------------------------
	proc クリアリングエリア８初期設定 {

		eval( $b:クリアリングエリア番号 = 8 );
		#if d:DEBUG_PRINT
			print '$b:クリアリングエリア番号='$b:クリアリングエリア番号
			print '$b:w22a_クリアリング回避回数['$b:クリアリングエリア番号']='$b:w22a_クリアリング回避回数[$b:クリアリングエリア番号]
		#endif

		command セットクリアリング \
			-i	d:C_R8:先頭兵ルート, \
				d:C_R8:２番兵ルート, \
				d:C_R8:３番兵ルート, \
				d:C_R8:４番兵ルート \
			-p	8, d:C_R8:先頭兵ルート, 1 スタンチェック８ \
				8, d:C_R8:先頭兵ルート, 1 子画面オンオフチェック８ \
				8, d:C_R8:先頭兵ルート, 1 クリアリングカメラ８－１ \
				8, d:C_R8:先頭兵ルート, 4 クリアリングカメラ８－２
	}

