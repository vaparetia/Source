		chara プットオブジェ Ｂ１黒天井 -m d:CEIL_NAME1 -r 0,0,0 -p 0,0,0 -s 100,100,100 -l d:LT2_NAME

		// 小部屋上黒天井の表示非表示
		trap ob111 d:PLAYER \
			-mask ？ \
			-exec {
				if ($3 == 入る) {
					mesg プットオブジェ Ｂ１黒天井 on
				} else if ($3 == 出る) {
					mesg プットオブジェ Ｂ１黒天井 off
				}
			}
	}

	proc ドア設置 {
		#if d:DEBUG_PRINT
			print 'slide_door_set'
		#endif

		// ドアフラグを元にモデルを設定(※全てのパターンのモデルを用意するのはもったいないので使うところのみ変更していく)
		// ドアモデル名セット $:配列番号 $:ドア名１(close) $:ドア名２(open) $:ドア名３(enemy) $:ドア名４(lv_close) $:ドア名５(lv_open)
		// 左上小部屋ドア
		@ドアモデル名セット 0 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0
		// 右上小部屋ドア
		@ドアモデル名セット 1 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0
		// １Ｆ中央左小部屋ドア
		@ドアモデル名セット 2 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0
		// １Ｆ中央右小部屋ドア
		@ドアモデル名セット 3 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0
		// １Ｆ左下小部屋ドア
		@ドアモデル名セット 4 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0
		// １Ｆ右下小部屋ドア
		@ドアモデル名セット 5 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0
		// １Ｆ上ドア
		@ドアモデル名セット 6 d:DOOR_NAME_EF_LV0 d:DOOR_NAME_EF_LV0 d:DOOR_NAME_EF_LV0 d:DOOR_NAME_EF_LV1 d:DOOR_NAME_EF_LV1
		// １Ｆ下ドア
		@ドアモデル名セット 7 d:DOOR_NAME_FA_LV0 d:DOOR_NAME_FA_LV0 d:DOOR_NAME_FA_LV0 d:DOOR_NAME_FA_LV0 d:DOOR_NAME_FA_LV0
		// Ｂ１上小部屋ドア左
		@ドアモデル名セット 8 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0
		// Ｂ１上小部屋ドア右
		@ドアモデル名セット 9 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0
		// Ｂ１左下小部屋ドア
		@ドアモデル名セット 10 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0
		// Ｂ１右下小部屋ドア
		@ドアモデル名セット 11 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0
		// Ｂ１下ドア
		@ドアモデル名セット 12 d:DOOR_NAME_FA_LV0 d:DOOR_NAME_FA_LV0 d:DOOR_NAME_FA_LV0 d:DOOR_NAME_FA_LV0 d:DOOR_NAME_FA_LV0


		// 実際のドアとランプの設置
		@ドアランプ設定 １Ｆ左上小部屋ドアランプ 2048 48500 0 -35625 1
		chara ドア １Ｆ左上小部屋ドア \
			-m $$s:ドアモデル名[0] \
			-d 0,2048,0 \
			-p 48500,0,-35625 \
			-slide d:SD_SLIDE_INSIDE \
			-time d:SD_OPEN_TIME \
			-between １Ｆ左上小部屋 １Ｆ中央広場 \
			-A １Ｆ左上小部屋ドアランプ \
			-exec {
				if( $:開閉フラグ == 0 ){
					mesg マップ接合 １Ｆ中央／左上小部屋 off
				} else {
					mesg マップ接合 １Ｆ中央／左上小部屋 on
				}
			}
		trap dr001 ？ \
			-mask ？ \
			-exec {
				if ( $b:tales_story_no == d:TALES_NO:A && $b:tales_story_a <= d:TALES_A:エイムズ遭遇前 ) {
					// スネークテイルズのエイムズイベント前までは独自にa22a_tale.hで設定
				} else {
					if($3==入る){
						mesg ドア １Ｆ左上小部屋ドア open $2
					}else{
						if ($$f:エマゲームオーバーフラグ == 0) {
							mesg ドア １Ｆ左上小部屋ドア close $2
						}
					}
				}
			}


		@ドアランプ設定 １Ｆ右上小部屋ドアランプ 2048 57000,0,-35625 1
		chara ドア １Ｆ右上小部屋ドア \
			-m $$s:ドアモデル名[1] \
			-d 0,2048,0 \
			-p 57000,0,-35625 \
			-slide d:SD_SLIDE_INSIDE \
			-time d:SD_OPEN_TIME \
			-between １Ｆ右上小部屋 １Ｆ中央広場 \
			-A １Ｆ右上小部屋ドアランプ \
			-exec {
				if( $:開閉フラグ == 0 ){
					mesg マップ接合 １Ｆ中央／右上小部屋 off
				} else {
					mesg マップ接合 １Ｆ中央／右上小部屋 on
				}
			}
		trap dr011 ？ \
			-mask ？ \	
			-exec {
				if($3==入る){
					mesg ドア １Ｆ右上小部屋ドア open $2
				}else{
					if ($$f:エマゲームオーバーフラグ == 0) {
						mesg ドア １Ｆ右上小部屋ドア close $2
					}
				}
			}


		@ドアランプ設定 １Ｆ中央左小部屋ドアランプ 2048 44500,0,-27125 1
		chara ドア １Ｆ中央左小部屋ドア \
			-m $$s:ドアモデル名[2] \
			-d 0,2048,0 \
			-p 44500,0,-27125 \
			-slide d:SD_SLIDE_INSIDE \
			-time d:SD_OPEN_TIME \
			-between １Ｆ中央左小部屋 １Ｆ中央広場 \
			-A １Ｆ中央左小部屋ドアランプ \
			-exec {
				if( $:開閉フラグ == 0 ){
					mesg マップ接合 １Ｆ中央／中央左小部屋 off
				} else {
					mesg マップ接合 １Ｆ中央／中央左小部屋 on
				}
			}
		trap dr021 ？ \
			-mask ？ \	
			-exec {
				if($3==入る){
					mesg ドア １Ｆ中央左小部屋ドア open $2
				}else{
					if ($$f:エマゲームオーバーフラグ == 0) {
						mesg ドア １Ｆ中央左小部屋ドア close $2
					}
				}
			}

		@ドアランプ設定 １Ｆ中央右小部屋ドアランプ 2048 61000,0,-27125 1
		chara ドア １Ｆ中央右小部屋ドア \
			-m $$s:ドアモデル名[3] \
			-d 0,2048,0 \
			-p 61000,0,-27125 \
			-slide d:SD_SLIDE_INSIDE \
			-time d:SD_OPEN_TIME \
			-between １Ｆ中央右小部屋 １Ｆ中央広場 \
			-A １Ｆ中央右小部屋ドアランプ \
			-exec {
				if( $:開閉フラグ == 0 ){
					mesg マップ接合 １Ｆ中央／中央右小部屋 off
				} else {
					mesg マップ接合 １Ｆ中央／中央右小部屋 on
				}
			}
		trap dr031 ？ \
			-mask ？ \	
			-exec {
				if ( $b:tales_story_no == d:TALES_NO:B && $b:tales_story_b == d:TALES_B:エマ再会前 ) {
					// スネークテイルズのエマ再会前では独自にa22a_tale.hで設定
				} else {
					if($3==入る){
						mesg ドア １Ｆ中央右小部屋ドア open $2
					}else{
						if ($$f:エマゲームオーバーフラグ == 0) {
							mesg ドア １Ｆ中央右小部屋ドア close $2
						}
					}
				}
			}

		@ドアランプ設定 １Ｆ左下小部屋ドアランプ 2048 48500,0,-18625 1
		chara ドア １Ｆ左下小部屋ドア \
			-m $$s:ドアモデル名[4] \
			-d 0,2048,0 \
			-p 48500,0,-18625 \
			-slide d:SD_SLIDE_INSIDE \
			-time d:SD_OPEN_TIME \
			-between １Ｆ左下小部屋 １Ｆ中央広場 \
			-A １Ｆ左下小部屋ドアランプ \
			-exec {
				if( $:開閉フラグ == 0 ){
					mesg マップ接合 １Ｆ中央／左下小部屋 off
				} else {
					mesg マップ接合 １Ｆ中央／左下小部屋 on
				}
			}
		trap dr041 ？ \
			-mask ？ \	
			-exec {
				if($3==入る){
					mesg ドア １Ｆ左下小部屋ドア open $2
				}else{
					if ($$f:エマゲームオーバーフラグ == 0) {
						mesg ドア １Ｆ左下小部屋ドア close $2
					}
				}
			}

		@ドアランプ設定 １Ｆ右下小部屋ドアランプ 2048 57000,0,-18625 1
		chara ドア １Ｆ右下小部屋ドア \
			-m $$s:ドアモデル名[5] \
			-d 0,2048,0 \
			-p 57000,0,-18625 \
			-slide d:SD_SLIDE_INSIDE \
			-time d:SD_OPEN_TIME \
			-between １Ｆ右下小部屋 １Ｆ中央広場 \
			-A １Ｆ右下小部屋ドアランプ \
			-exec {
				if( $:開閉フラグ == 0 ){
					// 扉が閉まったら０
					eval( $f:ローカルフラグ２ = 0 );

					// 扉が閉まって、プレイヤーがダクトにいないときにオフにする
					if ( $f:ローカルフラグ１ == 0 ) {
						mesg マップ接合 １Ｆ中央／右下小部屋 off
					}
				} else {
					// 扉が開いてたら１
					eval( $f:ローカルフラグ２ = 1 );

					mesg マップ接合 １Ｆ中央／右下小部屋 on
				}
			}
		trap dr051 ？ \
			-mask ？ \	
			-exec {
				if($3==入る){
					mesg ドア １Ｆ右下小部屋ドア open $2
				}else{
					if ($$f:エマゲームオーバーフラグ == 0) {
						mesg ドア １Ｆ右下小部屋ドア close $2
					}
				}
			}

		@ドアランプ設定 １Ｆ上ドアランプ 0 57000,0,-43625 2
		chara ドア １Ｆ上ドア \
			-m $$s:ドアモデル名[6] \
			-d 0,0,0 \
			-p 57000,0,-43625 \
			-slide d:SD_SLIDE_OUTSIDE \
			-time d:SD_OPEN_TIME \
			-between １Ｆ北通路 １Ｆ北通路 \
			-A １Ｆ上ドアランプ \
			-exec {
			}
		trap dr061 ？ \
			-mask ？ \	
			-exec {
				if($3==入る){
					mesg ドア １Ｆ上ドア open $2
				}else{
					if ($$f:エマゲームオーバーフラグ == 0) {
						mesg ドア １Ｆ上ドア close $2
					}
				}
			}
		trap dr061 d:PLAYER -mask ？ \
			-state d:TRP_STATE_SUBJECT \
			-exec {
				if($3 == 入る) {
					mesg 透明壁 １Ｆ上ドアへの透明壁 on
				} else if($3 == 出る) {
					mesg 透明壁 １Ｆ上ドアへの透明壁 off
				}
			}

		@ドアランプ設定 １Ｆ下ドアランプ 1024 44875,0,-16500 2
		chara ドア １Ｆ下ドア \
			-m $$s:ドアモデル名[7] \
			-d 0,1024,0 \
