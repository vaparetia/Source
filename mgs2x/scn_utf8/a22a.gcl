	// １Ｆ-Ｂ倉庫のクリアリング
	//---------------------------------------
	proc クリアリングエリア１初期設定 {

		eval( $b:クリアリングエリア番号 = 1 );
		#if d:DEBUG_PRINT
			print '$b:クリアリングエリア番号='$b:クリアリングエリア番号
			print '$b:w22a_クリアリング回避回数['$b:クリアリングエリア番号']='$b:w22a_クリアリング回避回数[$b:クリアリングエリア番号]
		#endif

		if ( $b:w22a_クリアリング回避回数[1] >= $w:クリアリングレベルアップ回数 ) {
			// 規定数を超えるとスタングレネードを投げてくる
			command セットクリアリング \
				-i	d:C_R1:先頭兵スタンルート, \
					d:C_R1:２番兵ルート, \
					d:C_R1:３番兵ルート, \
					d:C_R1:４番兵ルート \
				-p	1, d:C_R1:先頭兵スタンルート, 0 スタンチェック１ \
					1, d:C_R1:２番兵ルート, 4 ロッカーチェック１下 \
					1, d:C_R1:２番兵ロッカー開けルート下, 4 通常ルート１－５へ復帰 \
					1, d:C_R1:２番兵ルート, 5 ロッカーチェック１上 \
					1, d:C_R1:２番兵ロッカー開けルート上, 4 通常ルート１－６へ復帰 \
					1, d:C_R1:２番兵ルート, 10 隙間チェック１ \
					1, d:C_R1:先頭兵スタンルート, 0 子画面オンオフチェック１ \
					1, d:C_R1:先頭兵スタンルート 0 クリアリングカメラ１－１ \
					1, d:C_R1:先頭兵スタンルート 3 クリアリングカメラ１－２
		} else {
			// はじめのうちはこっち
			command セットクリアリング \
				-i	d:C_R1:先頭兵標準ルート, \
					d:C_R1:２番兵ルート, \
					d:C_R1:３番兵ルート, \
					d:C_R1:４番兵ルート \
