	// 各種カメラの設定
	// ------------------------------------
	proc １Ｆ中央広場カメラ設定 {
		#if d:DEBUG_PRINT
			print 'w22a0h_camera_set'
		#endif

		// 中央広場
		trap ca071 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ降順 $6 -27000 -30000 50051 50425
				eval( $i:補完ＢＸ = $i:CS_結果１ );
				eval( $i:補完ＬＸ = $i:CS_結果１ );

				@CS_スムーズカメラ降順 $6 -27000 -30000 53877 53602
				eval( $i:補完ＢＸ２ = $i:CS_結果１ );
				eval( $i:補完ＬＸ２ = $i:CS_結果１ );

				@CS_スムーズカメラ降順 $6 -27000 -30000 10021 8494
				eval( $i:補完ＢＹ = $i:CS_結果１ );

				@CS_スムーズカメラ降順 $6 -27000 -30000 -25341 -23813
				eval( $i:補完ＢＺ = $i:CS_結果１ );

				@CS_スムーズカメラ降順 $6 -27000 -30000 870 650
				eval( $i:補完ＲＸ = $i:CS_結果１ );

				chara カメラ設定 メインカメラ \
					-c 0 \	
					-b $i:補完ＢＸ,$i:補完ＢＹ,-27880 $i:補完ＢＸ２,$i:補完ＢＹ, $i:補完ＢＺ \
					-l $i:補完ＬＸ,1745,-32358 $i:補完ＬＸ２,d:CAM_MAX,-27284 \
					-r $i:補完ＲＸ,2048,0 \
					-f 8250 \
					-a 200 \
					-i 0 0 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// 中央広場右上
		trap ca072 d:PLAYER \
			-mask ？ \
			-camera \
