	// クリアリングが終了したら呼ぶプロック
	//---------------------------------------
	proc クリアリング回避回数処理 {
		// クリアリング回避回数をカウントする
		if ( $b:クリアリングエリア番号 == 0 ) {
			if ( $b:w22a_クリアリング回避回数[0] < 255 ) {
				eval( $b:w22a_クリアリング回避回数[0] = $b:w22a_クリアリング回避回数[0] + 1 );
			}
		} else if ( $b:クリアリングエリア番号 == 1 ) {
			if ( $b:w22a_クリアリング回避回数[1] < 255 ) {
				eval( $b:w22a_クリアリング回避回数[1] = $b:w22a_クリアリング回避回数[1] + 1 );
			}
		} else if ( $b:クリアリングエリア番号 == 2 ) {
			if ( $b:w22a_クリアリング回避回数[2] < 255 ) {
				eval( $b:w22a_クリアリング回避回数[2] = $b:w22a_クリアリング回避回数[2] + 1 );
			}
		} else if ( $b:クリアリングエリア番号 == 3 ) {
			if ( $b:w22a_クリアリング回避回数[3] < 255 ) {
				eval( $b:w22a_クリアリング回避回数[3] = $b:w22a_クリアリング回避回数[3] + 1 );
			}
		} else if ( $b:クリアリングエリア番号 == 4 ) {
			if ( $b:w22a_クリアリング回避回数[4] < 255 ) {
				eval( $b:w22a_クリアリング回避回数[4] = $b:w22a_クリアリング回避回数[4] + 1 );
			}
		} else if ( $b:クリアリングエリア番号 == 5 ) {
			if ( $b:w22a_クリアリング回避回数[5] < 255 ) {
				eval( $b:w22a_クリアリング回避回数[5] = $b:w22a_クリアリング回避回数[5] + 1 );
			}
		} else if ( $b:クリアリングエリア番号 == 6 ) {
			if ( $b:w22a_クリアリング回避回数[6] < 255 ) {
				eval( $b:w22a_クリアリング回避回数[6] = $b:w22a_クリアリング回避回数[6] + 1 );
			}
		} else if ( $b:クリアリングエリア番号 == 7 ) {
			if ( $b:w22a_クリアリング回避回数[7] < 255 ) {
				eval( $b:w22a_クリアリング回避回数[7] = $b:w22a_クリアリング回避回数[7] + 1 );
			}
		} else if ( $b:クリアリングエリア番号 == 8 ) {
			if ( $b:w22a_クリアリング回避回数[8] < 255 ) {
				eval( $b:w22a_クリアリング回避回数[8] = $b:w22a_クリアリング回避回数[8] + 1 );
			}
		}
	}

	// すべてのクリアリングのキャンセル＆終了プロック
	//---------------------------------------
	proc クリアリングカメラオフ {
		eval( $f:クリアリング中フラグ = 0 );
		chara カメラ設定 クリアリングカメラ -s -1
		eval( $f:クリアリング子画面フラグ = 0 );
		mesg サブ画面 子画面 off
	}


	// クリアリング子画面チェック
	//---------------------------------------
	proc クリアリング子画面チェック {
		#if d:DEBUG_PRINT 
			print 'clearing_sub_camera_check'
		#endif

		chara プロック連続実行 子画面チェック \
			-time -1 \
			-exec { \
				if ( $f:クリアリング子画面フラグ == 1 ) {
					command ゲットゲームステータス $i:ローカル変数Ｉ１

					if ( $b:クリアリングエリア番号 == 0 ) {
						if ( $s:プレイヤーがいるロッカー名 == ロッカー01 ) {
							if ( $i:ローカル変数Ｉ１ & d:STATE_CLEARING ) {
								mesg サブ画面 子画面 on
							}
						} else {
							mesg サブ画面 子画面 off
						}

					} else if ( $b:クリアリングエリア番号 == 1 ) {
						if ( $s:プレイヤーがいるロッカー名 == ロッカー11 || \
							 $s:プレイヤーがいるロッカー名 == ロッカー12 ) {
							if ( $i:ローカル変数Ｉ１ & d:STATE_CLEARING ) {
								mesg サブ画面 子画面 on
							}
						} else {
							mesg サブ画面 子画面 off
						}

					} else if ( $b:クリアリングエリア番号 == 2 ) {
						if ( $s:プレイヤーがいるロッカー名 == ロッカー21 || \
							((`command プレイヤー状態取得` & d:PFLAG_INTRUDE) && \
							`command プレイヤーマップ名` == １Ｆ中央左小部屋) ) {
							if ( $i:ローカル変数Ｉ１ & d:STATE_CLEARING ) {
								mesg サブ画面 子画面 on
							}
						} else {
							mesg サブ画面 子画面 off
						}

					} else if ( $b:クリアリングエリア番号 == 3 ) {
						if ( $s:プレイヤーがいるロッカー名 == ロッカー31 || \
							((`command プレイヤー状態取得` & d:PFLAG_INTRUDE) && \
							`command プレイヤーマップ名` == １Ｆ中央右小部屋) ) {
							if ( $i:ローカル変数Ｉ１ & d:STATE_CLEARING ) {
								mesg サブ画面 子画面 on
							}
						} else {
							mesg サブ画面 子画面 off
						}

					} else if ( $b:クリアリングエリア番号 == 4 ) {
						if ( $s:プレイヤーがいるロッカー名 == ロッカー41 ) {
							if ( $i:ローカル変数Ｉ１ & d:STATE_CLEARING ) {
								mesg サブ画面 子画面 on
							}
						} else {
							mesg サブ画面 子画面 off
						}

					} else if ( $b:クリアリングエリア番号 == 5 ) {
						if ( (`command プレイヤー状態取得` & d:PFLAG_INTRUDE) && \
							 `command プレイヤーマップ名` == １Ｆ右下小部屋 ) {
							if ( $i:ローカル変数Ｉ１ & d:STATE_CLEARING ) {
								mesg サブ画面 子画面 on
							}
						} else {
							mesg サブ画面 子画面 off
						}

					} else if ( $b:クリアリングエリア番号 == 6 ) {
					} else if ( $b:クリアリングエリア番号 == 7 ) {
						if ( $s:プレイヤーがいるロッカー名 == ロッカー71 || \
							 $s:プレイヤーがいるロッカー名 == ロッカー73 || \
							 $s:プレイヤーがいるロッカー名 == ロッカー74 || \
							((`command プレイヤー状態取得` & d:PFLAG_INTRUDE) && \
							`command プレイヤーマップ名` == Ｂ１左下小部屋 ) ) {
							if ( $i:ローカル変数Ｉ１ & d:STATE_CLEARING ) {
								mesg サブ画面 子画面 on
							}
						} else {
							mesg サブ画面 子画面 off
						}

					} else if ( $b:クリアリングエリア番号 == 8 ) {
						if ( ((`command プレイヤー状態取得` & d:PFLAG_INTRUDE) && \
							 `command プレイヤーマップ名` == Ｂ１右下小部屋 ) ) {
							if ( $i:ローカル変数Ｉ１ & d:STATE_CLEARING ) {
								mesg サブ画面 子画面 on
							}
						} else {
							mesg サブ画面 子画面 off
						}

					}



				}
			}
		
	}



	// クリアリングキャンセル設定
	//---------------------------------------
	proc クリアリングキャンセル設定 {
		#if d:DEBUG_PRINT 
			print 'clearing_cancel_set'
		#endif

		// 指定トラップに入ったときはクリアリングを発生させない
		trap cl002 d:PLAYER \
			-mask ？ \
			-exec {
				if ($3 == 入る) {
					mesg コマンダー 敵兵セット クリアリングエリアスキップオン 2
				} else if ($3 == 出る) {
					mesg コマンダー 敵兵セット クリアリングエリアスキップオフ 2
				}
			}

		trap cl003 d:PLAYER \
			-mask ？ \
			-exec {
				if ($3 == 入る) {
					mesg コマンダー 敵兵セット クリアリングエリアスキップオン 3
				} else if ($3 == 出る) {
					mesg コマンダー 敵兵セット クリアリングエリアスキップオフ 3
				}
			}

	}


	// 弾痕跳弾関係の設定
	// ------------------------------------
	proc 弾痕跳弾設定 {
		#if d:DEBUG_PRINT 
			print 'recoil_set'
		#endif

		command 弾痕ノーマル -n 0	// 通常
		command 弾痕ノーマル -n 1	// ダンボール
		command 弾痕ノーマル -n 2	// 階段、木箱
		command 弾痕ノーマル -n 3	// 鉄床、鉄筋
		command 弾痕ノーマル -n 4	// ロッカー扉、鉄板
		command 弾痕ノーマル -n 6	// パイプ
		command 弾痕ノーマル -n 7	// ホロ

		command 跳弾ノーマル -n 0
		command 跳弾ＳＥのみ -n 1
		command 跳弾ＳＥのみ -n 2
		command 跳弾ノーマル -n 3
		command 跳弾ノーマル -n 4
		command 跳弾ＳＥのみ -n 7

		command 跳弾水蒸気中 -n 6
	}

