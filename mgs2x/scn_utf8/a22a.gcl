			-between １Ｆ中央広場 １Ｆ中央広場 \
			-A １Ｆ下ドアランプ \
			-exec {
			}
		trap dr071 ？ \
			-mask ？ \	
			-exec {
				if($3==入る){
					mesg ドア １Ｆ下ドア open $2
				}else{
					if ($$f:エマゲームオーバーフラグ == 0) {
