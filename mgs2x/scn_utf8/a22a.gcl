// Ｂ１左下小部屋
	// ロッカー関係
	// -----------------------------------
	proc Ｂ１左下小部屋ロッカー設置 {
		#if d:DEBUG_PRINT
			print 'w22a1b_locker_set'
		#endif

		@ロッカーチェック 7
		chara ロッカー ロッカー71 \
			-kms neo_locker_door \
			-p 45875,-5000,-20950 \
			-r 0,1024,0 \
			-down_rot 0,700,0 \
			-down_shift 250,0,250 \
			-s $$i:ロッカー初期状態[7] \
			-seno d:SD_LOCKER_HZD \
			-sefloor d:SD_LOCKER_FLR \
			-load_state $i:w22a_ロッカー状態[7] \
			-exec {
				@プレイヤーロッカーに入ったかチェック $2 $3 $4
				@ロッカー状態保存 7 $3 $4
			}
		trap lk111 d:PLAYER \
			-and \
			-mask いる \
			-state 0,4 \
			-dir 3072,512 1024,512 \
			-key d:PAD_ACTION,-1 \				//アクションボタン
			-exec {
				command ロッカー状態 -n ロッカー71
				mesg プレイヤー d:PLAYER locker ロッカー71 $status 3072,512 45875,-20950
			}
		trap lk111 d:PLAYER \
			-mask ？ \
			-state 6 \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 47830,-52,-18902 -t 46063,-5606,-21750 \
					-r 670,2410,0 -f 6487 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3
			}

		@ロッカーチェック 8
		if ( $$i:ロッカー初期状態[8] == d:LOCKER_STATE_DESTROY ) {
			// 無理やり閉じる場合は壊れたドアも内側へ
			chara ロッカー ロッカー72 \
				-kms neo_locker_door \
				-p 45875,-5000,-21950 \
				-r 0,1024,0 \
				-down_rot 0,600,0 \
				-down_shift 500,0,0 \
				-s $$i:ロッカー初期状態[8] \
				-f d:LOCKER_FLAG_DOWNOUTSIDE \
				-seno d:SD_LOCKER_HZD \
				-sefloor d:SD_LOCKER_FLR \
				-load_state $i:w22a_ロッカー状態[8] \
				-exec {
					@プレイヤーロッカーに入ったかチェック $2 $3 $4
					@ロッカー状態保存 8 $3 $4
				}
		} else {
			// それ以外の場合もクリアリングの関係で壊れてあかないままで
			chara ロッカー ロッカー72 \
				-kms neo_locker_door \
				-p 45875,-5000,-21950 \
				-r 0,1024,0 \
				-down_rot 0,600,0 \
				-down_shift 500,0,0 \
				-s d:LOCKER_STATE_DESTROY \
				-f d:LOCKER_FLAG_DOWNOUTSIDE \
				-seno d:SD_LOCKER_HZD \
				-sefloor d:SD_LOCKER_FLR \
				-load_state $i:w22a_ロッカー状態[8] \
				-exec {
					@プレイヤーロッカーに入ったかチェック $2 $3 $4
					@ロッカー状態保存 8 $3 $4
				}
		}
		trap lk112 d:PLAYER \
			-and \
			-mask いる \
			-state 0,4 \
			-dir 3072,512 1024,512 \
			-key d:PAD_ACTION,-1 \				//アクションボタン
			-exec {
				command ロッカー状態 -n ロッカー72
				mesg プレイヤー d:PLAYER locker ロッカー72 $status 3072,512 45875,-21950
			}
		trap lk112 d:PLAYER \
			-mask ？ \
			-state 6 \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 47965,332,-19736 -t 46190,-5216,-22589 \
					-r 669,2411,0 -f 6486 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3
			}

		@ロッカーチェック 9
		chara ロッカー ロッカー73 \
			-kms neo_locker_door \
			-p 47700,-5000,-23625 \
			-r 0,0,0 \
			-down_rot 0,128,0 \
			-down_shift 0,0,-100 \
			-s $$i:ロッカー初期状態[9] \
			-sefloor d:SD_LOCKER_FLR \
			-load_state $i:w22a_ロッカー状態[9] \
			-exec {
				@プレイヤーロッカーに入ったかチェック $2 $3 $4
				@ロッカー状態保存 9 $3 $4
			}
		trap lk113 d:PLAYER \
			-and \
			-mask いる \
			-state 0,4 \
			-dir 2048,512 0,512 \
			-key d:PAD_ACTION,-1 \				//アクションボタン
			-exec {
				command ロッカー状態 -n ロッカー73
				mesg プレイヤー d:PLAYER locker ロッカー73 $status 2048,512 47700,-23625
			}
		trap lk113 d:PLAYER \
			-mask ？ \
			-state 6 \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 48237,-910,-20161 -t 47100,-5392,-24700 \
					-r 498,2208,0 -f 6479 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3
			}

		@ロッカーチェック 10
		chara ロッカー ロッカー74 \
			-kms neo_locker_door \
			-p 48700,-5000,-23625 \
			-r 0,0,0 \
			-down_rot 0,128,0 \
			-down_shift 100,0,-100 \
			-s $$i:ロッカー初期状態[10] \
			-seno d:SD_LOCKER_HZD \
			-sefloor d:SD_LOCKER_FLR \
			-load_state $i:w22a_ロッカー状態[10] \
			-exec {
				@プレイヤーロッカーに入ったかチェック $2 $3 $4
				@ロッカー状態保存 10 $3 $4
			}
		trap lk114 d:PLAYER \
			-and \
			-mask いる \
			-state 0,4 \
			-dir 2048,512 0,512 \
			-key d:PAD_ACTION,-1 \				//アクションボタン
			-exec {
				command ロッカー状態 -n ロッカー74
				mesg プレイヤー d:PLAYER locker ロッカー74 $status 2048,512 48700,-23625
			}
		trap lk114 d:PLAYER \
			-mask ？ \
			-state 6 \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 49050,-1049,-20227 -t 47922,-5539,-24761 \
					-r 499,2207,0 -f 6480 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3
			}
	}

