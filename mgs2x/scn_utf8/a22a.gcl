// １Ｆ北通路
	// 各種カメラの設定
	// ------------------------------------
	proc １Ｆ北通路カメラ設定 {
		#if d:DEBUG_PRINT
			print 'w22a0g_camera_set'
		#endif

		// 北横通路
		trap ca061 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ２ \
					-c 0 \	
					-b 52000,5868,-41714 58998,5868,-41714 \
					-l 52000,1750,-42773 58998,d:CAM_MAX,-42773 \
					-r 870,2048,0 \
					-f 4500 \
					-a 200 \
					-i 0 0 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-slide 0 5 750 750 30 0 \
					-s $3
			}

		// 中央南北通路
		trap ca062 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ降順 $6 -36500 -41500 52000 52000
				eval( $i:補完ＰＸ = $i:CS_結果１ );
				@CS_スムーズカメラ降順 $6 -36500 -41500 5986 4134
				eval( $i:補完ＰＹ = $i:CS_結果１ );
				@CS_スムーズカメラ降順 $6 -36500 -41500 -29473 -31805
				eval( $i:補完ＰＺ = $i:CS_結果１ );

				@CS_スムーズカメラ降順 $6 -36500 -41500 52000 52000
				eval( $i:補完ＴＸ = $i:CS_結果１ );
				@CS_スムーズカメラ降順 $6 -36500 -41500 903 -1070
				eval( $i:補完ＴＹ = $i:CS_結果１ );
				@CS_スムーズカメラ降順 $6 -36500 -41500 -35686 -40546
				eval( $i:補完ＴＺ = $i:CS_結果１ );

				chara カメラ設定 サブカメラ１ \
					-c 1 \	
					-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ -t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ \
					-r 358,2048,0 -f 8032 \
					-a 200 \
					-i 3 3 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// 階段部分上
		trap ca063 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ降順 $6 -38500 -40250 60290 60291
				eval( $i:補完ＰＸ = $i:CS_結果１ );
				@CS_スムーズカメラ降順 $6 -38500 -40250 2747 2747
				eval( $i:補完ＰＹ = $i:CS_結果１ );
				@CS_スムーズカメラ降順 $6 -38500 -40250 -33195 -33196
				eval( $i:補完ＰＺ = $i:CS_結果１ );

				@CS_スムーズカメラ降順 $6 -38500 -40250 59554 59465
				eval( $i:補完ＴＸ = $i:CS_結果１ );
				@CS_スムーズカメラ降順 $6 -38500 -40250 -1217 238
				eval( $i:補完ＴＹ = $i:CS_結果１ );
				@CS_スムーズカメラ降順 $6 -38500 -40250 -39163 -39896
				eval( $i:補完ＴＺ = $i:CS_結果１ );

				chara カメラ設定 メインカメラ \
					-c 1 \	
					-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ -t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ \
					-r 224,2128,0 -f 6486 \
					-a 220 \
					-i 0 0 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}
	}


// １Ｆ中央広場
	// ビヨンド設定
	// ------------------------------------
	proc １Ｆ中央広場ビヨンド設定 {
		#if d:DEBUG_PRINT
			print 'w22a0h_beyond_set'
		#endif

		// 一番北側
		trap by071 d:PLAYER \
			-mask いる \
			-key d:PAD_ACTION \	//アクションボタン
			-state 0,4 \		//立ち状態or張り付き
			-exec {
				@南向きビヨンド発動 by071 -33000 $4 49000 55000 0x00000002
			}
		trap by071 d:PLAYER \
			-mask いる \
			-state 6 \
			-dir 0 256 \	//方向指定
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 815,2243,0 -f 6222 \
					-a 200 \
					-i 0 -1 0 0 \
					-s 1
			}
		trap by071 d:PLAYER \
			-mask ？ \
			-state 5 \
			-dir 2048 256 \	//方向指定
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN 54615,d:CAM_MAX,-29522 \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN 53737,d:CAM_MAX,-32976 \
					-r 617,2188,0 -f 6199 \
					-a 225 \
					-i 3 2 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// 中央左
		trap by072 d:PLAYER \
			-mask いる \
			-key d:PAD_ACTION \		//アクションボタン
			-state 0,4 \	//立ち状態or張り付き
			-exec {
				@東向きビヨンド発動 by072 48000 $6 -30750 -29250 0x00000002
			}
		trap by072 d:PLAYER \
			-mask いる \
			-state 6 \
			-dir 1024 256 \	//方向指定
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b 48413,5000,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l 48163,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 859,2182,0 -f 4893 \
					-a 200 \
					-i 0 -1 0 0 \
					-s 1
			}
		trap by072 d:PLAYER \
