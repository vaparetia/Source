// １Ｆ中央左小部屋
	// ロッカー関係
	// -----------------------------------
	proc １Ｆ中央左小部屋ロッカー設置 {
		#if d:DEBUG_PRINT
			print 'w22a0c_locker_set'
		#endif

		@ロッカーチェック 4
		chara ロッカー ロッカー21 \
			-kms neo_locker_door \
			-p 41875,0,-28950 \
			-r 0,1024,0 \
			-s $$i:ロッカー初期状態[4] \
			-seno d:SD_LOCKER_HZD \
			-sefloor d:SD_LOCKER_FLR \
			-load_state $i:w22a_ロッカー状態[4] \
			-exec {
				@プレイヤーロッカーに入ったかチェック $2 $3 $4
				@ロッカー状態保存 4 $3 $4
			}
		trap lk021 d:PLAYER \
			-and \
			-mask いる \
			-state 0,4 \
			-dir 3072,512 1024,512 \
			-key d:PAD_ACTION,-1 \				//アクションボタン
			-exec {
				command ロッカー状態 -n ロッカー21
				mesg プレイヤー d:PLAYER locker ロッカー21 $status 3072,512 41875,-28950
			}
		trap lk021 d:PLAYER \
			-mask ？ \
			-state 6 \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 43346,4502,-27525 -t 42120,-1443,-29673 \
					-r 767,2386,0 -f 6439 \
					-a 193 \
					-i 0 2 0 0 \
					-s $3
			}
	}

	// 赤外線センサーの設定
	// ------------------------------------
	proc １Ｆ中央左小部屋赤外線センサー設置 {
		#if d:DEBUG_PRINT
			print 'w22a0c_ir_sensor_set'
		#endif
		
		// センサーとスイッチの設定
		if ( $f:w22a_赤外線センサーフラグ == 0 ) {
			chara 複数赤外線 赤外線センサー \
				-p 41386,2250,-28120 0,1024,0 スイッチ君 \		//$v:スイッチ座標 $v:スイッチ方向 $s:スイッチ名前 ...7
				-n 1 \											//$i:スイッチの数 \
				-a	41400,0,-30100 0,0,0 \
					46100,0,-30100 0,0,0 \		//$v:センサー座標 $v:センサー方向 ...6
				-e Ｃ４爆発ゲームオーバー \
				-s スイッチ破壊 \
				-m irs_box irs_box2 irs \
				-b 1 \
				-d 1						//$i:１を指定すると下部のセンサー無し（50cmの隙間ができる）\

			// 敵兵が引っかかった場合の処理
			trap ev021 敵兵 \
				-mask 入る \
				-exec {
					if ( $f:ゲームオーバー処理フラグ == 0 ) {
						mesg マップ接合 １Ｆ北／中央 on
						mesg マップ接合 １Ｆ北／Ｂ１中央 on
						mesg マップ接合 １Ｆ中央／左上小部屋 on
						mesg マップ接合 １Ｆ中央／右上小部屋 on
						mesg マップ接合 １Ｆ中央／中央左小部屋 on
						mesg マップ接合 １Ｆ中央／中央右小部屋 on
						mesg マップ接合 １Ｆ中央／左下小部屋 on
						mesg マップ接合 １Ｆ中央／右下小部屋 on
						mesg マップ接合 Ｂ１中央／上小部屋左 on
						mesg マップ接合 Ｂ１中央／上小部屋右 on
						mesg マップ接合 Ｂ１中央／左下小部屋 on
						mesg マップ接合 Ｂ１中央／右下小部屋 on
						mesg マップ接合 Ｂ１左下／右下小部屋 on

/* ほとんどの場合、赤外線のendprocの方が先に呼ばれ紛らわしい＋カメラが黒天井の上なので、はずします。2001.11.19
						chara カメラ設定 モーションカメラ２ \
							-c 1 \
							-p 44750,5538,-27236 -t 43804,1570,-30846 \
							-r 532,2215,0 -f 5448 \
							-a 170 \
							-i 0 0 0 0 \
							-s $3
*/
						
						@Ｃ４爆発ゲームオーバー
					}
				}
		} else {
			chara プットオブジェ 赤外線スイッチ１ -m irs_box2 -r 0 1024 0 -p 41386,2250,-28120 -l d:LT2_NAME -s 100 100 100
			chara プットオブジェ 赤外線センサーＬ１ -m irs -r 0 0 0 -p 41400,0,-30100 -l d:LT2_NAME -s 100 100 100
			chara プットオブジェ 赤外線センサーＲ１ -m irs -r 0 0 0 -p 46100,0,-30100 -l d:LT2_NAME -s 100 100 100
			command トラップ切り替え -trap ev021 -switch 0
		}

		// セムテックスの設置
		command foreach -argc 6 -repeat 5 \
			-data { \
					{45024,1675,-32575, 1024,0,0} \
					{44770,1675,-32225, 1024,2048,0} \
					{45560,1675,-31652, 1024,1024,0} \
					{45910,1675,-31398, 1024,3072,0} \
					{41325,2250,-28400, 0,1024,0}
			} \
			-exec { \
				chara トラップ専用C4 ＢＩＧＣ４ -p $1,$2,$3 -r $4,$5,$6 \
					-e Ｃ４爆発ゲームオーバー \
					-n 1	// 爆発音敵兵に聞こえない
			}
	}

	proc Ｃ４爆発ゲームオーバー {
		#if d:DEBUG_PRINT
			print 'w22a0c_irs_switch_on'
		#endif

		if ( $f:ゲームオーバー処理フラグ == 0 && `command ゲームオーバーチェック` == 0 ) {
			eval( $f:ゲームオーバー処理フラグ = 1 );
			mesg 複数赤外線 赤外線センサー on
			mesg トラップ専用C4 ＢＩＧＣ４ on
			@爆発ゲームオーバー処理 d:BOMB_EFFECT_ON
		}
	}

	proc スイッチ破壊 {
		#if d:DEBUG_PRINT
			print 'w22a0c_switch_broken'
		#endif
		
		eval ( $f:w22a_赤外線センサーフラグ = 1 );
		command トラップ切り替え -trap ev021 -switch 0
		mesg トラップ専用C4 ＢＩＧＣ４ lamp_off
	}

	proc 赤外線可視 {
		#if d:DEBUG_PRINT
			print 'irs_on'
		#endif

		mesg 複数赤外線 赤外線センサー on
	}


	// 各種カメラの設定
	// ------------------------------------
	proc １Ｆ中央左小部屋カメラ設定 {
		#if d:DEBUG_PRINT
			print 'w22a0c_camera_set'
		#endif

		trap ca021 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ２ \
					-c 1 \	
					-p 43750,8564,(-27250-761) -t 43750,1304,(-27250-2782) \
					-r 847,2048,0 -f 7536 \
					-a 170 \
					-i 0 0 0 0 \
					-s $3
			}
	}


// １Ｆ中央右小部屋
	// 透明壁の設定
	// ------------------------------------
	proc １Ｆ中央右小部屋透明壁設置 {
		#if d:DEBUG_PRINT
			print 'w22a0d_tr_wall_set'
		#endif

		@南北５０ｃｍ幅透明壁設置 １Ｆ中央右小部屋左壁 60875 0 -32750 2000

		trap wl031 d:PLAYER \
			-mask ？ \
			-state 4 \	
			-exec {
				if ($3 == 入る) {
					command パッド操作 -mask d:PAD_B
					mesg 透明壁 １Ｆ中央右小部屋左壁 off
				} else {
					command パッド操作 -cancel 0
					mesg 透明壁 １Ｆ中央右小部屋左壁 on
				}
			}

		trap wl031 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_BEHINDCAMERA_ENABLE \	
			-exec {
				// 張り付いたときのカメラ
				chara カメラ設定 モーションカメラ \
					-c 1 \	
					-p 60714,7541,-30309 -t 60714,1133,-30950 \
					-r 958,2048,0 -f 6439 \
					-a 193 \
					-i 2 2 0 0 \
					-s $3
			}

	}

