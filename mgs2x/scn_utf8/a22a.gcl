			-c 1 \	
			-p 49063,2841,-15422 -t 47901,462,-20316 \
			-r 288,2200,0 -f 5564 \
			-a 200 \
			-i 0 -1 0 0 \
			-z d:CAMERA_INTERP_CAMERA \ // 補完カメラフラグを指定。
			-interp_time (60*2) \ // 補完時間を指定
			-s 1
	}

	proc クリアリングカメラ４－２ {
		command カメラマップ設定 -chanl 1 -map １Ｆ左下小部屋
		chara カメラ設定 クリアリングカメラ \
			-c 1 \	
			-p 49257,4539,-23951 -t 47075,965,-19049 \
			-r 383,3823,0 -f 6447 \
			-a 273 \
			-i 0 -1 0 0 \
			-s 1

		chara カメラ設定 クリアリングカメラ \
			-c 1 \	
			-p 49258,4539,-23952 -t 46159,-278,-20992 \
			-r 550,3569,0 -f 6447 \
			-a 186 \
			-i 0 -1 0 0 \
			-z d:CAMERA_INTERP_CAMERA \ // 補完カメラフラグを指定。
			-interp_time (60*7) \ // 補完時間を指定
			-s 1
	}

	// １Ｆ-Ｆ倉庫のクリアリング
	//---------------------------------------
	proc クリアリングエリア５初期設定 {

		eval( $b:クリアリングエリア番号 = 5 );
		#if d:DEBUG_PRINT
			print '$b:クリアリングエリア番号='$b:クリアリングエリア番号
			print '$b:w22a_クリアリング回避回数['$b:クリアリングエリア番号']='$b:w22a_クリアリング回避回数[$b:クリアリングエリア番号]
		#endif

		command セットクリアリング \
			-i	d:C_R5:先頭兵標準ルート, \
				d:C_R5:２番兵ルート, \
				d:C_R5:３番兵ルート, \
				d:C_R5:４番兵ルート \
			-p	5, d:C_R5:先頭兵標準ルート, 1 スタンチェック５ \
				5, d:C_R5:２番兵ルート, 3 プレイヤー位置チェック５ \
				5, d:C_R5:先頭兵標準ルート, 1 子画面オンオフチェック５ \
				5, d:C_R5:先頭兵標準ルート, 1 クリアリングカメラ５－１ \
				5, d:C_R5:先頭兵標準ルート, 5 クリアリングカメラ５－２
	}

	proc スタンチェック５ {
		// 規定回数に行くまではスタン投げを飛ばす
		if ( $b:w22a_クリアリング回避回数[5] < $w:クリアリングレベルアップ回数 || \
			`command プレイヤーマップ名` != １Ｆ右下小部屋 ) {
			command チェンジクリアリングルート 敵兵:61 -r d:C_R5:先頭兵標準ルート -p 3
		}
	}

	proc プレイヤー位置チェック５ {
		if ( $b:w22a_クリアリング回避回数[5] >= $w:クリアリングレベルアップ回数 ) {
			// 規定数+1を超えると厳しいルートへチェンジ
			if ( $w:ゲーム設定 <= d:LEVEL_NORMAL && $i:プレイヤー位置Ｚ < -22750 ) {
				// ノーマル以下では荷物裏に隠れていたらダクトルートのみ発動
				command チェンジクリアリングルート 敵兵:61 -r d:C_R5:先頭兵ダクトのぞきルート -p 0
			} else {
				command チェンジクリアリングルート 敵兵:61 -r d:C_R5:先頭兵奥までルート -p 0
				command チェンジクリアリングルート 敵兵:62 -r d:C_R5:２番兵ダクトのぞきルート -p 0
			}
		}

	}

	proc 子画面オンオフチェック５ {
		eval( $f:クリアリング子画面フラグ = 1 );
	}

	proc クリアリングカメラ５－１ {
		command カメラマップ設定 -chanl 1 -map １Ｆ中央広場
		eval( $f:クリアリング中フラグ = 1 );
		chara カメラ設定 クリアリングカメラ \
			-c 1 \	
			-p 57661,2942,-16065 -t 56058,1818,-17883 \
			-r 283,2519,0 -f 2672 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1

		chara カメラ設定 クリアリングカメラ \
			-c 1 \	
			-p 57882,2206,-15831 -t 56196,1369,-17725 \
			-r 208,2522,0 -f 2670 \
			-a 200 \
			-i 0 -1 0 0 \
			-z d:CAMERA_INTERP_CAMERA \ // 補完カメラフラグを指定。
			-interp_time (60*2) \ // 補完時間を指定
			-s 1
	}

	proc クリアリングカメラ５－２ {
		command カメラマップ設定 -chanl 1 -map １Ｆ右下小部屋
		chara カメラ設定 クリアリングカメラ \
			-c 1 \	
			-p 54339,3242,-24128 -t 56126,1381,-20350 \
			-r 273,288,0 -f 4575 \
			-a 266 \
			-i 0 -1 0 0 \
			-s 1

		chara カメラ設定 クリアリングカメラ \
			-c 1 \	
			-p 54341,3242,-24129 -t 56814,860,-21106 \
			-r 357,447,0 -f 4575 \
			-a 195 \
			-i 0 -1 0 0 \
			-z d:CAMERA_INTERP_CAMERA \ // 補完カメラフラグを指定。
			-interp_time (60*5) \ // 補完時間を指定
			-s 1
	}


	// Ｂ１-Ｇ倉庫のクリアリング
	//---------------------------------------
	proc クリアリングエリア６初期設定 {

		eval( $b:クリアリングエリア番号 = 6 );
		#if d:DEBUG_PRINT
			print '$b:クリアリングエリア番号='$b:クリアリングエリア番号
			print '$b:w22a_クリアリング回避回数['$b:クリアリングエリア番号']='$b:w22a_クリアリング回避回数[$b:クリアリングエリア番号]
		#endif

		if ( $b:w22a_クリアリング回避回数[6] <= $w:クリアリングレベルアップ回数 + 1 || $w:ゲーム設定 <= d:LEVEL_NORMAL ) {
			if ( $i:プレイヤー位置Ｘ > 52000 ) {
				command セットクリアリング \
					-i	d:C_R6:先頭兵右ルート, \
						d:C_R6:２番兵右ルート, \
						d:C_R6:３番兵右ルート, \
						d:C_R6:４番兵右ルート \
					-p	6, d:C_R6:先頭兵右ルート, 1 スタンチェック６右
			} else {
				command セットクリアリング \
					-i	d:C_R6:先頭兵左ルート, \
						d:C_R6:２番兵左ルート, \
						d:C_R6:３番兵左ルート, \
						d:C_R6:４番兵左ルート \
					-p	6, d:C_R6:先頭兵左ルート, 1 スタンチェック６左
			}
		} else {
		// ハード以上で規定回数を超えると両側からクリアリングを起動
			command セットクリアリング \
				-i	d:C_R6:先頭兵右ルート２, \
					d:C_R6:２番兵左ルート２, \
					d:C_R6:３番兵左ルート２, \
					d:C_R6:４番兵右ルート２ \
				-p	6, d:C_R6:先頭兵右ルート２, 1 スタンチェック６右２ \
					6, d:C_R6:２番兵左ルート２, 1 スタンチェック６左２
		}
	} 

	proc スタンチェック６右 {
		// 規定回数に行くまではスタン投げを飛ばす
		if ( $b:w22a_クリアリング回避回数[6] < $w:クリアリングレベルアップ回数 || \
			`command プレイヤーマップ名` != Ｂ１上小部屋 ) {
			command チェンジクリアリングルート 敵兵:61 -r d:C_R6:先頭兵右ルート -p 3
		}
	}

	proc スタンチェック６左 {
		// 規定回数に行くまではスタン投げを飛ばす
		if ( $b:w22a_クリアリング回避回数[6] < $w:クリアリングレベルアップ回数 || \
			`command プレイヤーマップ名` != Ｂ１上小部屋 ) {
			command チェンジクリアリングルート 敵兵:61 -r d:C_R6:先頭兵左ルート -p 3
		}
	}

	proc スタンチェック６右２ {
		// 規定回数に行くまではスタン投げを飛ばす
		if ( $b:w22a_クリアリング回避回数[6] < $w:クリアリングレベルアップ回数 || \
			`command プレイヤーマップ名` != Ｂ１上小部屋 ) {
			command チェンジクリアリングルート 敵兵:61 -r d:C_R6:先頭兵右ルート２ -p 3
		}
	}

	proc スタンチェック６左２ {
		// 規定回数に行くまではスタン投げを飛ばす
		if ( $b:w22a_クリアリング回避回数[6] < $w:クリアリングレベルアップ回数 || \
			`command プレイヤーマップ名` != Ｂ１上小部屋 ) {
			command チェンジクリアリングルート 敵兵:62 -r d:C_R6:２番兵左ルート２ -p 3
		}
	}


	// Ｂ１-Ｈ倉庫のクリアリング
	//---------------------------------------
	proc クリアリングエリア７初期設定 {

		eval( $b:クリアリングエリア番号 = 7 );
		#if d:DEBUG_PRINT
			print '$b:クリアリングエリア番号='$b:クリアリングエリア番号
			print '$b:w22a_クリアリング回避回数['$b:クリアリングエリア番号']='$b:w22a_クリアリング回避回数[$b:クリアリングエリア番号]
		#endif

		command セットクリアリング \
			-i	d:C_R7:先頭兵ルート, \
				d:C_R7:２番兵ルート, \
				d:C_R7:３番兵ルート, \
				d:C_R7:４番兵ルート \
			-p	7, d:C_R7:先頭兵ルート, 0 スタンチェック７ \
				7, d:C_R7:先頭兵ルート, 8 ロッカーチェック７右 \
				7, d:C_R7:先頭兵ロッカー開けルート右, 4 先頭兵ルート７－９へ復帰 \
				7, d:C_R7:先頭兵ルート, 9 ロッカーチェック７左 \
				7, d:C_R7:２番兵ルート, 6 ロッカーチェック７下 \
				7, d:C_R7:先頭兵ルート, 0 子画面オンオフチェック７ \
				7, d:C_R7:先頭兵ルート, 0 クリアリングカメラ７－１ \
				7, d:C_R7:先頭兵ルート, 3 クリアリングカメラ７－２
	}

	proc スタンチェック７ {
		// 規定回数に行くまではスタン投げを飛ばす
		if ( $b:w22a_クリアリング回避回数[7] < $w:クリアリングレベルアップ回数 || \
			`command プレイヤーマップ名` != Ｂ１左下小部屋 ) {
			command チェンジクリアリングルート 敵兵:61 -r d:C_R7:先頭兵ルート -p 2
		}
	}

	proc ロッカーチェック７右 {
		if ( $b:w22a_クリアリング回避回数[7] >= $w:クリアリングレベルアップ回数 + 1 ) {
			// 規定数+1を超えるとロッカー開けルートへチェンジ
			command ロッカー状態 -n ロッカー74
			if ( !($status & 0x2000) && ($status & 0x0001) ) {
				// ノーマル以下では中に入っていたら開けない
				if ( $w:ゲーム設定 >= d:LEVEL_HARD || $s:プレイヤーがいるロッカー名 != ロッカー74 ) {
					command チェンジクリアリングルート 敵兵:61 -r d:C_R7:先頭兵ロッカー開けルート右 -p 0
				}
			}
		}
	}

	proc 先頭兵ルート７－９へ復帰 {
		command チェンジクリアリングルート 敵兵:61 -r d:C_R7:先頭兵ルート -p 9
	}

	proc ロッカーチェック７左 {
		if ( $b:w22a_クリアリング回避回数[7] >= $w:クリアリングレベルアップ回数 + 1 ) {
			// 規定数+1を超えるとロッカー開けルートへチェンジ
			command ロッカー状態 -n ロッカー73
			if ( !($status & 0x2000) && ($status & 0x0001) ) {
				// ノーマル以下では中に入っていたら開けない
				if ( $w:ゲーム設定 >= d:LEVEL_HARD || $s:プレイヤーがいるロッカー名 != ロッカー73 ) {
					command チェンジクリアリングルート 敵兵:61 -r d:C_R7:先頭兵ロッカー開けルート左 -p 0
				}
			}
		}
	}

	proc ロッカーチェック７下 {
		if ( $b:w22a_クリアリング回避回数[7] >= $w:クリアリングレベルアップ回数 + 1 ) {
			// 規定数+1を超えるとロッカー開けルートへチェンジ
			command ロッカー状態 -n ロッカー71
			if ( !($status & 0x2000) && ($status & 0x0001) ) {
				// ノーマル以下では中に入っていたら開けない
				if ( $w:ゲーム設定 >= d:LEVEL_HARD || $s:プレイヤーがいるロッカー名 != ロッカー71 ) {
					command チェンジクリアリングルート 敵兵:62 -r d:C_R7:２番兵ロッカー開けルート -p 0
				}
			}
		}
	}

	proc 子画面オンオフチェック７ {
		eval( $f:クリアリング子画面フラグ = 1 );
	}

	proc クリアリングカメラ７－１ {
		command カメラマップ設定 -chanl 1 -map Ｂ１中央広場
		eval( $f:クリアリング中フラグ = 1 );
		chara カメラ設定 クリアリングカメラ \
			-c 1 \	
			-p 52384,-2218,-20610 -t 51185,-3247,-23468 \
			-r 209,2307,0 -f 3265 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1

		chara カメラ設定 クリアリングカメラ \
			-c 1 \	
			-p 52460,-2753,-20452 -t 51244,-3710,-23325 \
			-r 194,2309,0 -f 3263 \
			-a 200 \
			-i 0 -1 0 0 \
			-z d:CAMERA_INTERP_CAMERA \ // 補完カメラフラグを指定。
			-interp_time (60*2) \ // 補完時間を指定
			-s 1
	}

	proc クリアリングカメラ７－２ {
