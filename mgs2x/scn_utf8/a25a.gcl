	}

// デバッグモード
// ------------------------------------
proc カメラ対策カサッカ監視処理 $:カメラＸ位置 $:カメラＹ位置 $:カメラＺ位置 $:指定距離 {
	// カメラ位置とカサッカの距離を監視して食い込みを防止します
	eval( $i:L1 = `%VecLen $:カメラＸ位置 $:カメラＹ位置 $:カメラＺ位置 $i:スネーク位置Ｘ $i:スネーク位置Ｙ $i:スネーク位置Ｚ` );
	eval( $i:L2 = `%VecLen $:カメラＸ位置 $:カメラＹ位置 $:カメラＺ位置 $i:hpx $i:hpy $i:hpz` );
	if ( $i:L1 < $:指定距離 ) {
		// カメラとカサッカが近い
		return 1
	} else if ( $i:L2 < $:指定距離 ) {
		// カメラとハリアが近い
		return 2
	} else {
		// カメラとカサッカは離れている
		return 0
	}
}

// デバッグモード
// ------------------------------------
proc デバッグキャラセット {
	#if d:DEBUG_PRINT 
		print 'debug_chara_set'
	#endif
}
