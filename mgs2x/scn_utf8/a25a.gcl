					-p -5012,1083,-147813 -t -2888,417,-154018 \
					-r 66,1833,0 -f 6592 \
					-a 200 \
					-i 0 -1 0 0 \
					-s $3
			}
		trap by005 d:PLAYER -camera -mask ？ -state d:TRP_STATE_ELUDE \
			-exec {
				chara カメラ設定 ビヨンドカメラ \
					-c 0 \
					-b -320000 -320000 -320000 320000 320000 320000 \
					-l -320000 -320000 -320000 320000 320000 320000 \
					-r 831,1833,0 -f 12079 \
					-a 200 \
					-i 1 -1 0 0 \
					-s $3
			}
		trap by006 d:PLAYER \
			-mask いる \
			-and \
			-button d:ACTION_BUTTON d:ACTION_BUTTON \		//ビヨンドボタン
			-state 0,4 \	//立ち状態or張り付き
			-exec {
				@東向きビヨンド発動 by006 3000 $6 -156500 -144000 0x000002
			}
		trap by006 d:PLAYER -camera -mask ＊ -state d:TRP_STATE_FORCE \
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 11131,-5122,-138270 -t 2856,837,-149077 \
					-r 3827,2474,0 -f 14859 \
					-a 303 \
					-i 0 -1 0 0 \
					-s $3
			}
		trap by006 d:PLAYER -camera -mask ？ -state d:TRP_STATE_ELUDE \
			-exec {
				chara カメラ設定 ビヨンドカメラ \
					-c 0 \
					-b -320000 -320000 -320000 320000 320000 320000 \
					-l -320000 -320000 -320000 320000 320000 320000 \
					-r 825,2130,0 -f 12497 \
