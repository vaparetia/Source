#define		KMS_NAMEI		w25ab_i2	// 遠景
#define		KMS_NAMEJ		w25ab_kl	// 遠景
#define		KMS_NAMEK		w25ab_l		// 遠景
#define		KMS_NAMEL		w25ab_other00	// 遠景
#define		KMS_NAMEM		w25ab_other01	// 遠景
#define		KMS_NAMEN		w25ab_other02	// 遠景
#define		KMS_NAMEO		w25a_18b	// Ｄ脚ロード部分
#define		KMS_NAMEP		w25ab_hi	// 遠景 ＨＩ連絡橋　サブスタンスから追加 2002.07.18 by 吉池

// デモ前
#define		KMS_ENT_D_0		w25a_brk00a	// Ｄ脚入り口破壊前
#define		KMS_ENT_G_0		w25a_brk01a	// Ｇ脚入り口破壊前
#define		KMS_ENT_P_0		w25a_brk02a	// パイプへこみ前

// デモ後
#define		KMS_ENT_D_1		w25a_brk00b	// Ｄ脚入り口破壊後
#define		KMS_ENT_G_1		w25a_brk01b	// Ｇ脚入り口破壊後
#define		KMS_ENT_P_1		w25a_brk02b	// パイプへこみ後

#define		KMS_NAME0_BEFORE	w25a0_obj00	// 破壊前上部
#define		KMS_NAME1_BEFORE	w25a1_obj00	// 破壊前下部
#define		KMS_NAME0_AFTER		w25a0_obj01	// 破壊後上部
#define		KMS_NAME1_AFTER		w25a1_obj01	// 破壊後下部
#define		KMS_NAME_SEA		sea		// 海

#define		DOOR_NAME_LOAD		w25a_dr00		// ロード用

#define		LT2_NAME		w25a

