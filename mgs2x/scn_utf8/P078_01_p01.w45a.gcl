// 各gclで必要なdefine
// ------------------------------------
// モード
#define		STAGE_PLANT		1		// 共通プロック切り分け用
#define		DEMO_STAGE		1		// デモステージかどうかで起動するキャラを切り分ける


// 各種設定用define
// ------------------------------------
// マップ関係
//#define		HZX_NAME			w45a
#define		HZX_NAME			d00a3
#define		KMS_NAME			w45a
#define		LT2_NAME			w45a
#define		DOOR_NAME_LOAD		w01f_dr
#define		DOOR_NAME_LOAD1A	w45a_dr_left_temae
#define		DOOR_NAME_LOAD1B	w45a_dr_right_temae
#define		BLOOD				tng_blood

// include
// ------------------------------------
#include "5sec_bfr_demo.h"
#include "demo_stdch.h"
#include "demo_stdch2.h"
#include "demo_vardef.h"
#include "story.h"
#include "sload.h"

#if d:PLANT_DEMO_ALL_SKIP
	#define		DEMO_SKIP_ENABLE 1
#else
	#define		DEMO_SKIP_ENABLE 0
#endif

#include "w45a_d_common.h"	//	ゲーム／デモ共通プロック

// マップ設定
// ------------------------------------
chara マップ アーセナルギア小部屋Ｂ	-k w45a \	//（マップモデル追加：田中修平）
									-h d:HZX_NAME,0 \
									-l d:LT2_NAME

//###################################################################################
//								ストーリーフラグ & デモ再生
//###################################################################################

command マップ設定 アーセナルギア小部屋Ｂ -set {

// デモ環境かどうか。
#if d:MGS2_DEMO

// 不要プログラムの起動阻害
	eval($s:d_num = P036_04_p03)

chara デモアクトデバッグ demodebug  -i t:p078_01_p01 -d 'p078_01_p01' -l   \
		-p  空中文字オフ 空中文字オン

#else


if($w:p_story == d:ST:P078_01_P01ＡＧフォーチュン登場１ポリゴンデモ１開始) {
	print'd:ST:P078_01_P01ＡＧフォーチュン登場１ポリゴンデモ１開始'
	//eval($w:p_story = d:ST:P078_01_P01ＡＧフォーチュン登場１ポリゴンデモ１開始)

	/* フォーチュン再び登場　スネークと対決 */

		// デモ特有の変数代入
		eval($s:d_num = P078_01_p01)

		//	かつら等対応
		@デモモデル差し替え処理
		proc デモ再生_P078_01_p01 {
			chara demo デモ再生 \
				-i t:p078_01_p01 \
				-p 空中文字オフ 空中文字オン \
				-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
				-next P078_01_p01終了
		}
		
		@デモ再生_P078_01_p01

	}

#endif

// デモ仕様のセット
	@常駐キャラ設定						// stdch.hで定義
	if($s:d_num != not_demo){

		// 共通して使用するもの
		chara デモキャンセルチェック デモキャンセル \
			-p demo_cancel

		@シネマスクリーンセット

		@血だまり設定
		@デモ用薬莢用メモリ確保セット

		//	w45a_d_common.h内で記述
		@ドア設置
		@フォグ設定
		@空中文字設定


	}

} // < 「command マップ設定 アーセナルギア小部屋Ｂ」の閉じカッコ

//初期マップの表示
	command マップ表示 -show アーセナルギア小部屋Ｂ


//###################################################################################
//									各proc設定
//###################################################################################
//###################################################################################
//									デモのみ仕様各種
//###################################################################################
// ダミープロック
proc null {}

// デモキャンセル
proc demo_cancel {
	command StreamStopAll
}

// リスタート
proc restart_proc {
	restart
}

// デモ終了時プロック
#if 0
proc P077_02_p01終了 {
	@デモ終了時シネマスクリーンオフ
	mesg デモキャンセルチェック デモキャンセル kill

	print '$w:p_story = d:ST:P077_02_P01天狗兵降下ラッシュポリゴンデモ１終了'
	eval($w:p_story = d:ST:P077_02_P01天狗兵降下ラッシュポリゴンデモ１終了)

	chara delay ディレイ \
		-time 1 \ 
		-exec{
			// ゲームへ
			@ゲームステージへ戻る
			restart
		}
}
#endif

proc P078_01_p01終了 {
	@デモ終了時シネマスクリーンオフ
	mesg デモキャンセルチェック デモキャンセル kill

	print '$w:p_story = d:ST:P078_01_P01ＡＧフォーチュン登場１ポリゴンデモ１終了'
	eval($w:p_story = d:ST:P078_01_P01ＡＧフォーチュン登場１ポリゴンデモ１終了)

	// この後はすぐにw46aステージをロード。w46aステージの初回ロード時に、
	// いきなり「P079_01_P01ＲＡＹ戦前１ポリゴンデモ１開始」開始なので、
	// ここでストーリーフラグを進めておく。

	print '$w:p_story = d:ST:P079_01_P01ＲＡＹ戦前１ポリゴンデモ１開始'
	eval($w:p_story = d:ST:P079_01_P01ＲＡＹ戦前１ポリゴンデモ１開始)

	chara delay ディレイ \
		-time 1 \ 
		-exec{
			// ゲームへ（w46aへ）
			@ゲームステージへ戻る
			@mv_w45a_w46a_0
		}
}



// シネマスクリーン
proc シネマスクリーンセット {
	chara シネマスクリーン シネマ \
		-top d:CINEMA_BELT_UPPER \
		-bottom d:CINEMA_BELT_LOWER \
		-ftime 60	//デフォルト値（ゼロは駄目）
	mesg シネマスクリーン シネマ フェードアウト 1
}



//###################################################################################
//									 エフェクト
//###################################################################################

proc デモ用薬莢用メモリ確保セット {
	chara M4_DEMO_GUN弾 デモ弾Ｍ４
}

proc 空中文字オフ {
mesg 天狗兵ステージモニター モニタ インビジブル 0
mesg 天狗兵ステージモニター モニタ インビジブル 1
mesg 天狗兵ステージモニター モニタ インビジブル 2

}
proc 空中文字オン {
mesg 天狗兵ステージモニター モニタ ビジブル 0
mesg 天狗兵ステージモニター モニタ ビジブル 1
mesg 天狗兵ステージモニター モニタ ビジブル 2
	}

	proc 血だまり設定 {
		if(($w:コンフィグ設定 & 0x0008) == 0) {
			chara プットオブジェ 血だまり \
				-m d:BLOOD \
				-r 0,0,0 \
				-p 0,0,0 -l d:LT2_NAME \
				-s 100,100,100
		}
	}


