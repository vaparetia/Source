// モード
#define		STAGE_PLANT		1		// 共通プロック切り分け用


#include "stdch.h"
#include "sload.h"
#include "sound.h"
#include "enevoice.h"
#include "item_info.h"
#include "commdef.h"
#include "p_force_cdc.ch"

