				-a 200 \
				-i 3 3 0 0 \
				-s $3
		}

	// ポンプ設備南(爆弾)
	trap ca105 d:PLAYER \
		-camera -mask ？ \
		-exec {
			chara カメラ設定 サブカメラ２ \
				-c 1 \	
				-p -61,6484,13250 \
				-t -180,936,11104 \
				-a 200 \
				-i 3 3 0 0 \
				-s $3
		}

	// ポンプ設備北
	trap ca106 d:PLAYER \
		-camera -mask ？ \
		-exec {
			chara カメラ設定 サブカメラ２ \
				-c 0 \
				-b -3466,d:CAM_MIN,d:CAM_MIN 3438,d:CAM_MAX,d:CAM_MAX \
				-l -3401,2529     ,d:CAM_MIN 3503,2529     ,d:CAM_MAX \
				-r 786,2028,0 \
				-f 5928 \
				-a 200 \
				-i 3 3 0 0 \
				-s $3
		}

	// ポンプ設備東階段
	trap ca107 d:PLAYER \
		-camera -mask ？ \
		-exec {
			chara カメラ設定 サブカメラ２ \
				-c 1 \	
				-p 7809,5332,10384 \
				-t 7237,182,7533 \
				-a 200 \
				-i 3 3 0 0 \
				-s $3
		}

	// ポンプ設備北西
	trap ca108 d:PLAYER \
		-camera -mask ？ \
		-exec {
			chara カメラ設定 サブカメラ２ \
				-c 1 \	
				-p -7289,6011,7721 \
				-t -6982,543,5507 \
				-a 200 \
				-i 3 3 0 0 \
				-s $3
		}

	// ポンプ設備北東
	trap ca109 d:PLAYER \
		-camera -mask ？ \
		-exec {
			chara カメラ設定 サブカメラ２ \
				-c 1 \	
				-p 7417,5712,7302 \
				-t 6935,191,5257 \
				-a 200 \
				-i 3 3 0 0 \
				-s $3
		}

	// ポンプ設備潜り込み西
	trap ca110 d:PLAYER \
		-camera -mask ？ \
		-exec {
			chara カメラ設定 サブカメラ２ \
				-c 1 \	
				-p -591,4594,12778 \
				-t -1737,724,8456 \
				-a 200 \
				-i 3 3 0 0 \
				-s $3
		}

	// ポンプ設備潜り込み東
	trap ca111 d:PLAYER \
		-camera -mask ？ \
		-exec {
			chara カメラ設定 サブカメラ２ \
				-c 1 \	
				-p 659,6069,8657 \
				-t 760,-658,7334 \
				-a 200 \
				-i 3 3 0 0 \
				-s $3
		}
}

proc スタートカメラセット {
#if d:DEBUG_PRINT
	print '*** Start Camera Set ***'
#endif

	if($s:登場ポイント == Ａ脚屋上左側から) {				// 屋上左から
		chara カメラ設定 モーションカメラ \
			-c 1 \
			-p -6211,9019,-5060 \
			-t -7739,6283,-8166 \
			-a 225 \
			-i 0 2 0 0 \
			-s 1
	} else if($s:登場ポイント == Ａ脚屋上右側から) {			// 屋上右から
		chara カメラ設定 モーションカメラ \
			-c 1 \
			-p 6211,9019,-5060 \
			-t 7739,6283,-8166 \
			-a 225 \
			-i 0 2 0 0 \
			-s 1
	} else if($s:登場ポイント == ＡＢ連絡橋から) {			// ＡＢ連絡橋から
		chara カメラ設定 モーションカメラ \
			-c 1 \
			-p -4081,4166,-5678 \
			-t -5422,1698,-9695 \
			-a 200 \
			-i 0 2 0 0 \
			-s 1
	} else if($s:登場ポイント == ＦＡ連絡橋から) {			// ＦＡ連絡橋から
		chara カメラ設定 モーションカメラ \
			-c 1 \
			-p 4081,4166,-5678 \
			-t 5422,1698,-9695 \
			-a 200 \
			-i 0 2 0 0 \
			-s 1
	}
}

proc スタートカメラオフ {
#if d:DEBUG_PRINT
	print '*** Start Camera Off ***'
#endif

	chara カメラ設定 モーションカメラ -s 0
}


//-----------------------------------------------------------------------------
// Ａ脚ノード前１無線デモ１後処理
proc w12b_Ａ脚ノード前１無線デモ１後処理 {
#if d:DEBUG_PRINT
	print '*** After Node Codec Demo ***'
#endif

	chara カメラ設定 でもデモカメラ -s 0
}

//-----------------------------------------------------------------------------
// センサーＢ無線後処理
proc w12b_センサーＢ無線後処理 {
#if d:DEBUG_PRINT
	print '*** After Sensor B Codec ***'
#endif

	if($s:登場ポイント == Ａ脚屋上左側から) {
		eval($i:プレイヤー初期Ｘ位置 = -8000)
		eval($i:プレイヤー初期Ｙ位置 =  5000)
		eval($i:プレイヤー初期Ｚ位置 = -7750)
		eval($i:プレイヤー初期方向   =     0)
		eval($s:登場ポイント         = センサーＢスタート左)
		restart

	} else if($s:登場ポイント == Ａ脚屋上右側から) {
		eval($i:プレイヤー初期Ｘ位置 =  8000)
		eval($i:プレイヤー初期Ｙ位置 =  5000)
		eval($i:プレイヤー初期Ｚ位置 = -7750)
		eval($i:プレイヤー初期方向   =     0)
		eval($s:登場ポイント         = センサーＢスタート右)
		restart

	} else {
		@爆弾タイマー開始
	}
}

//-----------------------------------------------------------------------------
// ロード設定
proc ロード設定 {
#if d:DEBUG_PRINT
	print '*** Load Set ***'
#endif

	// @ステージ終了時処理 目標位置  終了時方向  呼び出しプロックに入る  入ってゆく姿勢

	// 屋上左側へ (w12a、w12c)
	trap ld001 d:PLAYER \
		-mask 入る \
		-exec {
			if($f:ロードチェックＯＮフラグ == 1) {
				preseek 'a12a'
				@ステージ終了時処理（ステージ名表示） -8000 5000 -11000 2048 mv_a12b0_a12a_0 d:DEFAULT_M_TYPE d:wn_Ａ脚屋上
			}
		}

	// 屋上右側へ (w12a、w12c)
	trap ld002 d:PLAYER \
		-mask 入る \
		-exec {
			if($f:ロードチェックＯＮフラグ == 1) {
				preseek 'a12a'
				@ステージ終了時処理（ステージ名表示） 8000 5000 -11000 2048 mv_a12b0_a12a_1 d:DEFAULT_M_TYPE d:wn_Ａ脚屋上
			}
		}

	// ＡＢ連絡橋へ (w13a、w13b)
	trap ld003 d:PLAYER \
		-mask 入る \
		-exec {
			if($f:ロードチェックＯＮフラグ == 1) {
				preseek 'a13b'
				@ステージ終了時処理（ステージ名表示） -7375 0 -11500 3072 mv_a12b0_a13a_0 d:DEFAULT_M_TYPE d:wn_ＡＢ連絡橋
			}
		}

	// ＦＡ連絡橋へ (w23a、w23b)
	trap ld004 d:PLAYER \
		-mask 入る \
		-exec {
			if($f:ロードチェックＯＮフラグ == 1) {
				preseek 'a23b'
				@ステージ終了時処理（ステージ名表示） 7375 0 -11500 1024 mv_a12b0_a23a_0 d:DEFAULT_M_TYPE d:wn_ＦＡ連絡橋
			}
		}
}

proc ロードプロック {
#if d:DEBUG_PRINT
	print '*** Load Proc ***'
#endif

	if($s:呼び出しプロック == mv_a12b0_a12a_0) {
		// 屋上左側へ
		@mv_a12b0_a12a_0

	} else if($s:呼び出しプロック == mv_a12b0_a12a_1) {
		// 屋上右側へ
		@mv_a12b0_a12a_1

	} else if($s:呼び出しプロック == mv_a12b0_a13a_0) {
		// ＡＢ連絡橋へ
		@mv_a12b0_a13a_0

	} else if($s:呼び出しプロック == mv_a12b0_a23a_0) {
		@mv_a12b0_a23a_0
	}
}





//=============================================================================
// ステージ進入時処理
//=============================================================================

proc ステージ進入時処理 {
#if d:DEBUG_PRINT
	print '*** Stage Start Proc ***'
#endif

	// @ステージ開始時処理 タイプ(スライドドア、水密ドア、何もなし)   ドアの名前   移動距離   状態(前のステージ状態、走り、歩き)
	if($s:登場ポイント == Ａ脚屋上左側から) {
		@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:SL_DOOR_TYPE 屋上左側へのドア 2000 d:DEFAULT_M_TYPE d:wn_Ａ脚ポンプ室

	} else if($s:登場ポイント == Ａ脚屋上右側から) {
		@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:SL_DOOR_TYPE 屋上右側へのドア 2000 d:DEFAULT_M_TYPE d:wn_Ａ脚ポンプ室

	} else if($s:登場ポイント == ＡＢ連絡橋から) {
		@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:SL_DOOR_TYPE ＡＢ連絡橋へのドア 2000 d:DEFAULT_M_TYPE d:wn_Ａ脚ポンプ室

	} else if($s:登場ポイント == ＦＡ連絡橋から) {
		@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:SL_DOOR_TYPE ＦＡ連絡橋へのドア 2000 d:DEFAULT_M_TYPE d:wn_Ａ脚ポンプ室

	} else if($s:登場ポイント == Ｅ脚からダンボール) {
		@ステージ開始時処理（ダンボールワープ） d:wn_Ａ脚ポンプ室
	}

#if d:DEBUG_PRINT
	print '$f:ロードチェックＯＮフラグ='$f:ロードチェックＯＮフラグ
	print 's:登場ポイント='$s:登場ポイント
#endif
}
