// [登場ポイント]
//   w12b(左)				sp_w12a_w12b0_0			w12b
//   w12b(右)				sp_w12a_w12b0_1			w12b
//   w13a					sp_w13a_w12b0_0			w12b
//   w23a					sp_w23a_w12b0_0			w12b
//   ダンボール				sp_w20a_w12b0_0			w12b
//   w12b_リスタート２		w12b_リスタート２		w12b
//   センサーＢスタート左	センサーＢスタート左	w12b
//   センサーＢスタート右	センサーＢスタート右	w12b

//=============================================================================
// define
//=============================================================================

//-----------------------------------------------------------------------------
// スイッチ

#define STAGE_PLANT 1
#define	STAGE_ALT	1		// オルタナティブミッション切り分け用
#define STAGE_W12B  1

#define		ENE_P_GOL     1
#define		ENE_SHOT		1		// ショットガン兵
#define		ENE_HIGH_TECH	1		// ハイテク兵
#define		ENE_SHIELD		1		// 盾兵

#define PLAYER     ライデン

#define ENEMY_SET      1		// 敵兵の配置
#define STAGE_END      1		// ロードプロック
#define START_CAMERA   1		// ステージ開始時のカメラ
#define NODE           1		// ノード

#define SCREENSHOT     0		// スクリーンショット
#define KEYBOARD       0		// ＵＳＢキーボード

//-----------------------------------------------------------------------------
// マップ関係

#define HZX_NAME   a12b
#define LT2_NAME   w12b

#define KMS_NAME0  w12b0			// 制御室
#define KMS_NAME1  w12b0r0			// 制御室天井
#define KMS_NAME2  w12b0r1			// 制御室天井
#define KMS_NAME3  w12b1			// ポンプ室

//#define KMS_NAME6  w12b_k2		// 影用西階段
//#define KMS_NAME7  w12b_k1		// 影用東階段
#define KMS_NAME8  w12b1_k1			// 影用ポンプ室

#define KMS_NAME10  w12b0_12a0		// 屋上ロード部左
#define KMS_NAME11  w12b0_12a1		// 屋上ロード部右
#define KMS_NAME12  w12b0_13a		// ＡＢ連絡橋ロード部
#define KMS_NAME13  w12b0_23a		// ＦＡ連絡橋ロード部

#define DOOR_NAME1 w12b_dr00		// 屋上扉
#define DOOR_NAME2 w12b_dr01		// 連絡橋扉
#define DOOR_NAME3 dr_lv1_00		// レベル扉
#define DOOR_NAME4 w12b0_locker1_dr	// ロッカー扉
#define DOOR_NAME5 w12b0_eyes1_dr	// ロッカー扉（キョロ）

#define	DOOR_NAME_LV0 dr_free		// カードレベルなし室内共通ドア



// ------------------------------------
// 敵兵音声
// ------------------------------------
// 司令官、危険モード時の音声リソース
resource ghq_area_alert_voice {
	w12b:
		$t{
			// PLAREA0
			t:vc040112,	// 指揮官　　「了解。増援部隊、ＡＢ連絡橋への扉付近を守れ！侵入者を食い止めるんだ！」
			t:vc040113,	// 指揮官　　「了解。応援部隊をＡ脚いっかい１Ｆに派遣する！ＡＢ連絡橋への扉を固めろ」
			-2,
			// PLAREA1
			t:vc040114,	// 指揮官　　「了解。増援部隊、Ａ脚いっかい１Ｆ・ＦＡ連絡橋への扉付近を守れ！侵入者を食い止めるんだ！」
			t:vc040115,	// 指揮官　　「了解。バックアップをＡ脚いっかい１Ｆに送る。ＦＡ連絡橋への扉を守れ」
			-2,
			// PLAREA2
			t:vc040116,	// 指揮官　　「了解。応援部隊、Ａ脚いっかい１Ｆ制御室へ向かえ！敵を包囲せよ！」
			t:vc040117,	// 指揮官　　「了解。増援部隊をＡ脚いっかい１Ｆに送る。制御室を守れ！」
			-2,
			// PLAREA3
			t:vc040118,	// 指揮官　　「了解。増援部隊、Ａ脚いっかい１Ｆポンプ室へ急行せよ！敵を逃がすな！」
			t:vc040119,	// 指揮官　　「了解。増援部隊をＡ脚いっかい１Ｆに派遣する。ポンプ室を包囲しろ！」
			-2,
			// PLAREA4
			t:vc040120,	// 指揮官　　「了解。増援部隊、Ａ脚いっかい１Ｆへ向かえ！敵を殲滅せよ！」
			t:vc040121,	// 指揮官　　「了解。応援部隊、Ａ脚いっかい１Ｆへ急行せよ！侵入者を逃がすな！」
			-1
		}
}

resource ghq_caution_voice {
	w12b:
		$t{
			t:vc040285,	// 指揮官　　「了解。Ａ脚いっかい１Ｆに増援を送る。警備を強化しろ」
			t:vc040284,	// 指揮官　　「了解。Ａ脚いっかい１Ｆを増員。警戒を強化しろ」
			-2,
			t:vc040419,	// 指揮官　　「Ａ脚１Ｆとの連絡が途絶えた」
			-3,
			t:vc040605,	// 指揮官　　「(監視カメラ破壊時の音声)」
			-1
		}
}


// ドア設定用ステージ内ローカル変数(a_mode.hよりも先に定義する)
dim $$b:ドアフラグ[ 5 ]
dim $$s:ドアモデル名[ 5 ]

command	配列セット $$b:ドアフラグ[0] {
	0,	0,	0,	0,	0
}
command	配列セット $$s:ドアモデル名[0] {
	0,	0,	0,	0,	0
}


//=============================================================================
// include
//=============================================================================

#include "rai_a12b.mh"	// ステージ固有モーションリスト

#include "stdch.h"
#include "enevoice.h"
#include "a_mode.h"		// アナザーミッション設定ファイル
#include "sload.h"
#include "jump.h"
#include "sound.h"
#include "item_info.h"
#include "node_res.h"

#if d:KEYBOARD 
#include "usbkbd.h"
#endif

//-----------------------------------------------------------------------------
// ローカル

eval($f:クリアリングフラグ０ = 0)	// クリアリング状態

#include "stageset.h"			// ステージ設定共通ヘッダ





//=============================================================================
// メイン
//=============================================================================
// アナザー用でマップ設定前に設定する
// ------------------------------------
@アナザー用マップ定義前設定

chara マップ 制御室 \
	-k d:KMS_NAME0 \
	-h d:HZX_NAME, 0 \
	-l d:LT2_NAME

chara マップ ポンプ室 \
	-k d:KMS_NAME3 \
	-h d:HZX_NAME, 1 \
	-l d:LT2_NAME

chara マップ接合 Ａ脚接合 制御室 ポンプ室

command マップ設定 制御室 ポンプ室 -set {

	//----- 基本設定
	@SS_跳弾弾痕設定
	@常駐キャラ設定

	@A_プレイヤー設定 sna_a12b rai_a12b
}

// アナザー用でマップ設定後に設定する
// ------------------------------------
@アナザー用マップ定義後設定

command マップ設定 制御室 ポンプ室 -set {
	//----- オブジェクト(共通)
	@ドア設定
	@ロッカー設定
}

command マップ設定 制御室 -set {

	//----- オブジェクト(マップ別)
//	@ノード端末設定 2048
	@A_制御室ドア開閉設定
	@天井君設定_制御室
	@壊れ物設定_制御室
	@その他オブジェクト設定_制御室
}

command マップ設定 ポンプ室 -set {

	//----- ビヨンド、ジャンプ
	@ジャンプ設定_ポンプ室

	//----- オブジェクト(マップ別)
	@A_ポンプ室ドア開閉設定
	@その他オブジェクト設定_ポンプ室
}

command マップ設定 制御室 ポンプ室 -set {

	//----- フォグ、カメラ、ロード
	@SS_フォグ_キャラ用ライト設定
	@カメラ設定
	@ロード設定
}


command マップ表示 -show 制御室

// レーダー当たり
command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 3
command 追加ＨＺＸグループ登録 -hzx_id 1 -add_id 3
//command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 4	// 扉閉まってる
command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 5	// 扉開いている
command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 6	// エレベータの柵が上がっている

// 影投影
command	影投影ハザード -name ポンプ室 -group 7

@ステージ進入時処理





//=============================================================================
// プロシージャ
//=============================================================================

//=============================================================================
// 基本設定
//=============================================================================
proc クリアリングカメラＯＦＦ {
#if d:DEBUG_PRINT
	print '*** Clearing Camera OFF ***'
#endif

	mesg サブ画面 子画面 off
	chara カメラ設定 クリアリングカメラ -s 0
}

//-----------------------------------------------------------------------------
// クリアリングエリア０設定
proc クリアリングエリア０_初期設定 {
#if d:DEBUG_PRINT
	print '*** Clearing Area 0: Init ***'
#endif

	command セットクリアリング \
		-p 0,0,0,クリアリングエリア０_カメラ０ \
		   0,0,4,クリアリングエリア０_カメラ１ \
		   0,0,7,クリアリングエリア０_カメラ２ \
		-i 0,1

	eval($f:クリアリングフラグ０ = 1)
}
proc クリアリングエリア０内チェック {
#if d:DEBUG_PRINT
	print '*** Clearing Area 0: Bounding Check ***'
#endif

	if(    (-4250 < $i:プレイヤー位置Ｘ) && ($i:プレイヤー位置Ｘ <  4250) \
		&& (-9750 < $i:プレイヤー位置Ｚ) && ($i:プレイヤー位置Ｚ < -2500)) {
		return 1;
	} else {
		return 0;
	}
}
proc クリアリングエリア０_カメラ０ {
#if d:DEBUG_PRINT
	print '*** Clearing Area 0: Camera 0 ***'
#endif

	if(`@クリアリングエリア０内チェック`) {
		chara カメラ設定 クリアリングカメラ \
			-c 1 \
			-p -4453,2318,-282 \
			-t 2623,279,-2334 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1
		command カメラマップ設定 -chanl 1 -map 制御室
		mesg サブ画面 子画面 on
	}
}
proc クリアリングエリア０_カメラ１ {
#if d:DEBUG_PRINT
	print '*** Clearing Area 0: Camera 1 ***'
#endif

	if(`@クリアリングエリア０内チェック`) {
		chara カメラ設定 クリアリングカメラ \
			-c 1 \
			-p -4307,2712,-2944 \
			-t 1181,-511,-7119 \
			-a 180 \
			-i 0 -1 0 0 \
			-s 1
		command カメラマップ設定 -chanl 1 -map 制御室
		mesg サブ画面 子画面 on
	}
}
proc クリアリングエリア０_カメラ２ {
#if d:DEBUG_PRINT
	print '*** Clearing Area 0: Camera 2 ***'
#endif

	if(`@クリアリングエリア０内チェック`) {
		chara カメラ設定 クリアリングカメラ \
			-c 1 \
			-p -4101,2373,-7083 \
			-t 2508,-1159,-8356 \
			-a 180 \
			-i 0 -1 0 0 \
			-s 1
		command カメラマップ設定 -chanl 1 -map 制御室
		mesg サブ画面 子画面 on
	}
}
proc クリアリングエリア０_終了 {
#if d:DEBUG_PRINT
	print '*** Clearing Area 0: End ***'
#endif

	eval($f:クリアリングフラグ０ = 0)
	@クリアリングカメラＯＦＦ
}





//=============================================================================
// ビヨンド、ジャンプ
//=============================================================================

//-----------------------------------------------------------------------------
// ジャンプ設定
proc ジャンプ設定_ポンプ室 {
#if d:DEBUG_PRINT
	print '*** Jump Set: Pump Room ***'
#endif

	command プラグイン自動ジャンプ
	@ジャンプ発動 ky001 1000 50
}





//=============================================================================
// オブジェクト
//=============================================================================

//-----------------------------------------------------------------------------
// ドア設定
proc ドア設定 {
#if d:DEBUG_PRINT
	print '*** Door Set ***'
#endif

	// ドアフラグを元にモデルを設定(※全てのパターンのモデルを用意するのはもったいないので使うところのみ変更していく)
	// ドアモデル名セット $:配列番号 $:ドア名１(close) $:ドア名２(open) $:ドア名３(enemy) $:ドア名４(lv_close) $:ドア名５(lv_open)
	// 屋上左側へのドア
	@ドアモデル名セット 0 d:DOOR_NAME1 d:DOOR_NAME1 d:DOOR_NAME1 d:DOOR_NAME1 d:DOOR_NAME1
	// 屋上右側へのドア
	@ドアモデル名セット 1 d:DOOR_NAME1 d:DOOR_NAME1 d:DOOR_NAME1 d:DOOR_NAME1 d:DOOR_NAME1
	// ＡＢ連絡橋へのドア
	@ドアモデル名セット 2 d:DOOR_NAME2 d:DOOR_NAME2 d:DOOR_NAME2 d:DOOR_NAME2 d:DOOR_NAME2
	// ＦＡ連絡橋へのドア
	@ドアモデル名セット 3 d:DOOR_NAME2 d:DOOR_NAME2 d:DOOR_NAME2 d:DOOR_NAME2 d:DOOR_NAME2
	// ポンプ室のドア
	@ドアモデル名セット 4 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0 d:DOOR_NAME_LV0 d:DOOR_NAME3 d:DOOR_NAME3

	// ドア
	//   -m オブジェクト名  -d 向き  -p 場所  -slide スライド量  -time 時間  -between マップ名１ マップ名２  -exec { $:開閉フラグ }
	// 屋上左側へのドア
	@ドアランプ設定 屋上左側へのドアランプ 0 -8750 5000 -9125 0
//	@主観禁止壁     屋上左側へのドア壁       -8750 5000 -9125 0 d:SD_SLIDE_OUTSIDE
	chara ドア 屋上左側へのドア \
		-m $$s:ドアモデル名[0] \
		-d 0 0 0 \
		-p -8750 5000 -9125 \
		-s d:SD_SLIDE_OUTSIDE \
		-t d:SD_OPEN_TIME \
		-A 屋上左側へのドアランプ \
		-b 制御室 制御室 \
		-exec {
			if(!($:開閉フラグ)) {
				mesg プットオブジェ 屋上ロード部左 off				// ロード部モデル
				mesg レンズフレア レンズフレア アルファ変更 0 1		// レンズフレア処理
				mesg ローカル風 隙間風 オフ
			} else {
				mesg プットオブジェ 屋上ロード部左 on				// ロード部モデル
				mesg レンズフレア レンズフレア アルファ変更 16 1	// レンズフレア処理
				mesg ローカル風 隙間風 オン
			}
		}
	trap dr001 ？ -mask ？ \
		-exec {
			if($3 == 入る) {
				mesg ドア 屋上左側へのドア open $2
			} else if($3 == 出る) {
				mesg ドア 屋上左側へのドア close $2
			}
		}
	trap dr001 d:PLAYER -mask ？ \
		-state d:TRP_STATE_SUBJECT \
		-exec {
			if($3 == 入る) {
				mesg 透明壁 屋上左側へのドア壁 on
			} else if($3 == 出る) {
				mesg 透明壁 屋上左側へのドア壁 off
			}
		}


	// 屋上右側へのドア
	@ドアランプ設定 屋上右側へのドアランプ 2048 8750 5000 -9125 1
//	@主観禁止壁     屋上右側へのドア壁          8750 5000 -9125 2048 d:SD_SLIDE_OUTSIDE
	chara ドア 屋上右側へのドア \
		-m $$s:ドアモデル名[1] \
		-d 0 2048 0 \
		-p 8750 5000 -9125 \
		-s d:SD_SLIDE_OUTSIDE \
		-t d:SD_OPEN_TIME \
		-A 屋上右側へのドアランプ \
		-b 制御室 制御室 \
		-exec {
			if(!($:開閉フラグ)) {
				mesg プットオブジェ 屋上ロード部右 off				// ロード部モデル
				mesg レンズフレア レンズフレア アルファ変更 0 1		// レンズフレア処理
				mesg ローカル風 隙間風 オフ
			} else {
				mesg プットオブジェ 屋上ロード部右 on				// ロード部モデル
				mesg レンズフレア レンズフレア アルファ変更 16 1	// レンズフレア処理
				mesg ローカル風 隙間風 オン
			}
		}
	trap dr002 ？ -mask ？ \
		-exec {
			if($3 == 入る) {
				mesg ドア 屋上右側へのドア open $2
			} else if($3 == 出る) {
				mesg ドア 屋上右側へのドア close $2
			}
		}
	trap dr002 d:PLAYER -mask ？ \
		-state d:TRP_STATE_SUBJECT \
		-exec {
			if($3 == 入る) {
				mesg 透明壁 屋上右側へのドア壁 on
			} else if($3 == 出る) {
				mesg 透明壁 屋上右側へのドア壁 off
			}
		}

	// ＡＢ連絡橋へのドア
	@ドアランプ設定 ＡＢ連絡橋へのドアランプ 722 -6350 0 -10050 0
//	@主観禁止壁     ＡＢ連絡橋へのドア壁         -6350 0 -10050 722 d:SD_SLIDE_OUTSIDE2
	chara ドア ＡＢ連絡橋へのドア \
		-m $$s:ドアモデル名[2] \
		-d 0 722 0 \
		-p -6350 0 -10050 \
		-s d:SD_SLIDE_OUTSIDE2 \
		-t d:SD_OPEN_TIME \
		-A ＡＢ連絡橋へのドアランプ \
		-b 制御室 制御室 \
		-r -6375 0 -10875 -5437 0 -10875 \
		-exec {
			if(!($:開閉フラグ)) {
				mesg プットオブジェ ＡＢ連絡橋ロード部 off	// ロード部モデル
				mesg ローカル風 隙間風 オフ
			} else {
				mesg プットオブジェ ＡＢ連絡橋ロード部 on	// ロード部モデル
				mesg ローカル風 隙間風 オン
			}
		}
	trap dr003 ？ -mask ？ \
		-exec {
			if($3 == 入る) {
				mesg ドア ＡＢ連絡橋へのドア open $2
			} else if($3 == 出る) {
				mesg ドア ＡＢ連絡橋へのドア close $2
			}
		}
	trap dr003 d:PLAYER -mask ？ \
		-state d:TRP_STATE_SUBJECT \
		-exec {
			if($3 == 入る) {
				mesg 透明壁 ＡＢ連絡橋へのドア壁 on
			} else if($3 == 出る) {
				mesg 透明壁 ＡＢ連絡橋へのドア壁 off
			}
		}

	// ＦＡ連絡橋へのドア
	@ドアランプ設定 ＦＡ連絡橋へのドアランプ 1326 6350 0 -10050 1
//	@主観禁止壁     ＦＡ連絡橋へのドア壁          6350 0 -10050 1326 d:SD_SLIDE_OUTSIDE2
	chara ドア ＦＡ連絡橋へのドア \
		-m $$s:ドアモデル名[3] \
		-d 0 1326 0 \
		-p 6350 0 -10050 \
		-s d:SD_SLIDE_OUTSIDE2 \
		-t d:SD_OPEN_TIME \
		-A ＦＡ連絡橋へのドアランプ \
		-b 制御室 制御室 \
		-r 5437 0 -10875 6375 0 -10875 \
		-exec {
			if(!($:開閉フラグ)) {
				mesg プットオブジェ ＦＡ連絡橋ロード部 off	// ロード部モデル
				mesg ローカル風 隙間風 オフ
			} else {
				mesg プットオブジェ ＦＡ連絡橋ロード部 on	// ロード部モデル
				mesg ローカル風 隙間風 オン
			}
		}
	trap dr004 ？ -mask ？ \
		-exec {
			if($3 == 入る) {
				mesg ドア ＦＡ連絡橋へのドア open $2
			} else if($3 == 出る) {
				mesg ドア ＦＡ連絡橋へのドア close $2
			}
		}
	trap dr004 d:PLAYER -mask ？ \
		-state d:TRP_STATE_SUBJECT \
		-exec {
			if($3 == 入る) {
				mesg 透明壁 ＦＡ連絡橋へのドア壁 on
			} else if($3 == 出る) {
				mesg 透明壁 ＦＡ連絡橋へのドア壁 off
			}
		}

	// ポンプ室のドア
	@ドアランプ設定 ポンプ室のドアランプ 0 7250 0 125 2
	chara ドア ポンプ室のドア \
		-m $$s:ドアモデル名[4] \
		-d 0 0 0 \
		-p 7250 0 125 \
		-s d:SD_SLIDE_INSIDE \
		-t d:SD_OPEN_TIME \
		-A ポンプ室のドアランプ \
		-b ポンプ室 制御室 \
		-exec {
			if(!($:開閉フラグ)) {
				mesg マップ接合 Ａ脚接合 off	// マップ接合
			} else {
				mesg マップ接合 Ａ脚接合 on		// マップ接合
			}
		}
	trap dr005 ？ -mask ？ \
		-exec {
			if($3 == 入る) {
				mesg ドア ポンプ室のドア open $2
			} else if($3 == 出る) {
				mesg ドア ポンプ室のドア close $2
			}
		}
}

proc A_制御室ドア開閉設定 {
#if d:DEBUG_PRINT
	print 'door_open or close check'
#endif

	@A_ドア開閉追加設定 屋上左側へのドア $$b:ドアフラグ[0] -8750 5000 -9125 0 d:SD_SLIDE_OUTSIDE
	@A_ドア開閉追加設定 屋上右側へのドア $$b:ドアフラグ[1] 8750 5000  -9125 2048 d:SD_SLIDE_OUTSIDE
	@A_ドア開閉追加設定 ＡＢ連絡橋へのドア $$b:ドアフラグ[2] -6350    0 -10050  722 d:SD_SLIDE_OUTSIDE2
	@A_ドア開閉追加設定 ＦＡ連絡橋へのドア $$b:ドアフラグ[3] 6350    0 -10050 1326 d:SD_SLIDE_OUTSIDE2
}

proc A_ポンプ室ドア開閉設定 {
#if d:DEBUG_PRINT
	print 'door_open or close check'
#endif

	@A_ドア開閉追加設定 ポンプ室のドア $$b:ドアフラグ[4] 7250 0 125 0 d:SD_SLIDE_INSIDE
}



//-----------------------------------------------------------------------------
// ロッカー設定
proc ロッカー設定 {
#if d:DEBUG_PRINT
	print '*** Locker Set ***'
#endif

	chara ロッカー管理 管理人さん -n 4
	command ロッカーモーション -motion locker
	command プレイヤーロッカーモーション -motion sna_locker

	// $:ロッカー名 $:トラップ名 $:番号 $:モデル名 $:Ｘ座標 $:Ｙ座標 $:Ｚ座標 $:ステータス $:壁音番号 $:倒れ時床音番号 $:フラグ $:倒れシフトＸ $:倒れシフトＹ $:倒れシフトＺ $:倒れ回転Ｙ $:影ＩＤ {
	@SS_北ロッカー登録 ロッカー:01 lk001 0 (d:DOOR_NAME4) -10000 0 -4000 (0)                          1 4 (0) 0 0 0  -90 (0)
	@SS_北ロッカー登録 ロッカー:02 lk002 1 (d:DOOR_NAME4)  -9000 0 -4000 (d:LOCKER_STATE_NO_OPEN_SEG) 1 4 (0) 0 0 0  -80 (0)
	@SS_北ロッカー登録 ロッカー:03 lk003 2 (d:DOOR_NAME5)   9875 0 -4000 (d:LOCKER_STATE_POSTER)      1 4 (0) 0 0 0 -100 (0)
	@SS_北ロッカー登録 ロッカー:04 lk004 3 (d:DOOR_NAME4)  10875 0 -4000 (d:LOCKER_STATE_NO_OPEN_SEG) 1 4 (0) 0 0 0  -80 (0)
}

//-----------------------------------------------------------------------------
// CB_ロッカーチェック
proc SS_CB_ロッカーチェック $:番号 {
#if d:DEBUG_PRINT
	print '*** SS CB Locker Check ***'
#endif

	@壊れ物再セットチェック $b:w12b_破壊ロード回数[$:番号]
	if($f:再セットフラグ) {
		eval($i:w12b_ロッカー状態[$:番号] = 0)
	}

	return $i:w12b_ロッカー状態[$:番号]
}

//-----------------------------------------------------------------------------
// CB_ロッカー状態保存
proc SS_CB_ロッカー状態保存 $:開始終了 $:実行キャラ $:行動 $:ロッカー名 {
#if d:DEBUG_PRINT
	print '*** SS CB Locker Save ***'
#endif

	// ロッカー名と番号の対応
	if($:ロッカー名 == ロッカー:01) {
		eval($i:SS_ロッカー番号 = 0)
	} else if($:ロッカー名 == ロッカー:02) {
		eval($i:SS_ロッカー番号 = 1)
	} else if($:ロッカー名 == ロッカー:03) {
		eval($i:SS_ロッカー番号 = 2)
	} else if($:ロッカー名 == ロッカー:04) {
		eval($i:SS_ロッカー番号 = 3)
	}

	// 状態保存
	if(($:行動 != 6) && ($:行動 != 8)) {
		// 状態変化時
		eval($b:w12b_破壊ロード回数[$i:SS_ロッカー番号] = $w:グローバルロード回数);

	} else if($:行動 == 8) {
		// ステージ終了時
		command ロッカー状態 -n $:ロッカー名
		eval($i:w12b_ロッカー状態[$i:SS_ロッカー番号] = $status)
	}
}

//-----------------------------------------------------------------------------
// CB_ロッカー実行
proc SS_CB_ロッカー実行 $:トラップ名 $:フラグ $:トリガ $:ＰＸ $:ＰＹ $:ＰＺ {
#if d:DEBUG_PRINT
	print '*** SS CB Locker ***'
#endif

	//---------------------------------------------------------
	// 開閉実行処理
	if($:フラグ == 0) {

		if($:トラップ名 == lk001) {
			command ロッカー状態 -n ロッカー:01
			mesg プレイヤー d:PLAYER locker ロッカー:01 $status 2048,512 (-10000-50),-4000
		} else if($:トラップ名 == lk002) {
			command ロッカー状態 -n ロッカー:02
			mesg プレイヤー d:PLAYER locker ロッカー:02 $status 2048,512 (-9000-50),-4000
		} else if($:トラップ名 == lk003) {
			command ロッカー状態 -n ロッカー:03
			mesg プレイヤー d:PLAYER locker ロッカー:03 $status 2048,512 (9875-50),-4000
		} else if($:トラップ名 == lk004) {
			command ロッカー状態 -n ロッカー:04
			mesg プレイヤー d:PLAYER locker ロッカー:04 $status 2048,512 (10875-50),-4000
		}

	//---------------------------------------------------------
	// 開閉カメラ処理
	} else {
		if($:トラップ名 == lk001) {
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p -9382,4390,-1198 \
				-t -10271,1633,-3308 \
				-a 200 \
				-i 0 2 0 0 \
				-s $3
		} else if($:トラップ名 == lk002) {
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p -8096,4493,-1605 \
				-t -9525,1683,-3313 \
				-a 200 \
				-i 0 2 0 0 \
				-s $3
		} else if($:トラップ名 == lk003) {
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p 8096,4493,-1605 \
				-t 9525,1683,-3313 \
				-a 200 \
				-i 0 2 0 0 \
				-s $3
		} else if($:トラップ名 == lk004) {
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p 9382,4390,-1198 \
				-t 10271,1633,-3308 \
				-a 200 \
				-i 0 2 0 0 \
				-s $3
		}
	}
}


//-----------------------------------------------------------------------------
// 爆弾解体設定
proc 爆弾解体設定 {
#if d:DEBUG_PRINT
	print '*** Bomb Set ***'
#endif

	// 爆弾解体設定
	//   $:爆弾名 $:処理状態フラグ $:Ｘ座標 $:Ｙ座標 $:Ｚ座標 $:Ｘ回転 $:Ｙ回転 $:Ｚ回転
	@SS_爆弾解体設定_CB使用 w12b匂い爆弾 $f:w12b_爆弾処理完了 250 250 8650 0 0 0
}

proc SS_CB_爆弾解体後処理 {
#if d:DEBUG_PRINT
	print '*** SS CB Bomb Frozen ***'
#endif

	if($2 == 1) {	// 解体時
// バグ修正 2001.12.03
//		if($w:アイテム数Ｒ[d:アイテム:センサーＢ] == 1) {	// 既にセンサーＢをゲットしている
		if($b:Ｃ４爆弾処理数 == $b:Ｃ４爆弾設置数 - 1) {	// 最後の爆弾であるならば昇降機を上げる
			eval($f:w12a_Ａ脚ポンプ室爆弾解体前にセンサーＢゲット = 1)
		}
	}

	@爆弾解体後処理 $1 $2
}





//-----------------------------------------------------------------------------
// ノード端末設定
proc ノード接続時プロック {
#if d:DEBUG_PRINT
	print '*** Node Set ***'
#endif

	eval($f:ノードフラグ = $f:w12b_ノードフラグ);
}

proc ノード接続後プロック {
#if d:DEBUG_PRINT
	print '*** Node Event ***'
#endif

	eval($f:w12b_ノードフラグ = 1);
	command メニュー設定 -node_access on 
}


//-----------------------------------------------------------------------------
// 天井君設定
proc 天井君設定_制御室 {
#if d:DEBUG_PRINT
	print '*** Tenjou-kun Set: Control Room ***'
#endif

	//注意！！天井君の高さを変えるときは、ビハインドカメラの位置を全てチェックすること！！
	chara 天井君 天井_制御室   -m d:KMS_NAME1 -h 8000 -p 0,0,0  -l d:LT2_NAME
	chara 天井君 天井_制御室   -m d:KMS_NAME2 -h 4000 -p 0,0,0  -l d:LT2_NAME
}

//-----------------------------------------------------------------------------
// 壊れ物設定
proc 壊れ物設定_制御室 {
#if d:DEBUG_PRINT
	print '*** Koware Set: Control Room ***'
#endif


	//---------------------------------------------------------
	// 制御室モニター
	@壊れ物再セットチェック $b:w12b_破壊ロード回数[5]
	if($f:再セットフラグ) {
		eval($i:w12b_制御モニター壊れ状態 = 0)
	}
	chara プット制御室モニター 制御モニター -flag $i:w12b_制御モニター壊れ状態 -proc 制御モニター破壊時


	//---------------------------------------------------------
	// 壊れコンピュータ
	@壊れ物再セットチェック $b:w12b_破壊ロード回数[6]
	if($f:再セットフラグ) {
		eval($i:w12b_制御コンピュータ壊れ状態 = 0)
	}
	chara 壊れコンピュータW12B 制御コンピュータ -flag $i:w12b_制御コンピュータ壊れ状態 -proc 制御コンピュータ破壊時
}

proc 制御モニター破壊時 {
#if d:DEBUG_PRINT
	print '*** Control Monitor Destroyed ***'
#endif

	eval($i:w12b_制御モニター壊れ状態 = $1)
	eval($b:w12b_破壊ロード回数[5] = $w:グローバルロード回数);
}

proc 制御コンピュータ破壊時 {
#if d:DEBUG_PRINT
	print '*** Control Computer Destroyed ***'
#endif

	eval($i:w12b_制御コンピュータ壊れ状態 = $1)
	eval($b:w12b_破壊ロード回数[6] = $w:グローバルロード回数);
}

//-----------------------------------------------------------------------------
// その他オブジェクト設定
proc その他オブジェクト設定_制御室 {
#if d:DEBUG_PRINT
	print '*** Object Set: Control Room ***'
#endif

	//---------------------------------------------------------
	// 主観禁止壁
	@主観禁止壁 屋上左側へのドア壁   -8750 5000  -9125    0 d:SD_SLIDE_OUTSIDE
	@主観禁止壁 屋上右側へのドア壁    8750 5000  -9125 2048 d:SD_SLIDE_OUTSIDE
	@主観禁止壁 ＡＢ連絡橋へのドア壁 -6350    0 -10050  722 d:SD_SLIDE_OUTSIDE2
	@主観禁止壁 ＦＡ連絡橋へのドア壁  6350    0 -10050 1326 d:SD_SLIDE_OUTSIDE2

	//---------------------------------------------------------
	// ロード部モデル

	// プットオブジェ
	//   -m オブジェクト名  -r 向き  -p 場所  -s スケール  -l 光源  -f フラグ  -t ＬＯＤ閾値
	@SS_プットオブジェ  屋上ロード部左     d:KMS_NAME10
	mesg プットオブジェ 屋上ロード部左     off
	@SS_プットオブジェ  屋上ロード部右     d:KMS_NAME11
	mesg プットオブジェ 屋上ロード部右     off
	@SS_プットオブジェ  ＡＢ連絡橋ロード部 d:KMS_NAME12
	mesg プットオブジェ ＡＢ連絡橋ロード部 off
	@SS_プットオブジェ  ＦＡ連絡橋ロード部 d:KMS_NAME13
	mesg プットオブジェ ＦＡ連絡橋ロード部 off

	//---------------------------------------------------------
	// ドア風
	chara ローカル風 隙間風 \
		-n 6 \
		-d	-8750 5000 -10250 -7250 8000  -8250    0 -512 2048 \
			 7250 5000 -10250  8750 8000  -8250    0 -512 2048 \
			-6625    0 -11750 -5625 3000 -10000  722 -512 2048 \
			-5625    0 -11250 -5125 3000  -9750  722 -512 2048 \
			 5125    0 -11250  5625 3000  -9750 3374 -512 2048 \
			 5625    0 -11750  6625 3000 -10000 3374 -512 2048
	mesg ローカル風 隙間風 オフ

	//---------------------------------------------------------
	// レンズフレア

	// レンズフレア -pos 位置 -size 大きさ -alpha アルファ -g グループ番号
	//##### w12a の太陽にあわせる #####
	if($w:p_story < d:ST:P014_15_P07ピーター遭遇１５ポリゴンデモ７終了) {
		chara レンズフレア  レンズフレア \
			-pos   -19300 15000 -43500 \
			-size  1 \
			-alpha 16 \
			-g     2
	} else {
		chara レンズフレア  レンズフレア \
			-pos   16000 38000 -28000 \
			-size  1 \
			-alpha 16 \
			-g     2
	}
	if(    ($s:登場ポイント != Ａ脚屋上左側から) \
		&& ($s:登場ポイント != Ａ脚屋上右側から)) {
		mesg レンズフレア レンズフレア アルファ変更 0 1
	}

	//---------------------------------------------------------
	// 電灯虫

	// chara 電灯虫 -n 匹数 // ４以上は４単位で -p 位置 // プレイヤー誘導時は無視 
	//   -b フラグ // 壁との当たり見るか 1:あり, 0:なし -s バウンド１ // 最小 -l バウンド２ // 最大
	chara 電灯虫 電灯虫 \
		-n 12 \
		-p -8000,7750,-8750 \
		-b 1 \
		-s -8625,5000,-8750 \
		-l -7375,7875,-8000
	chara 電灯虫 電灯虫 \
		-n 12 \
		-p 8000,7750,-8750 \
		-b 1 \
		-s 7375,5000,-8750 \
		-l 8625,7875,-8000
	chara 電灯虫 電灯虫 \
		-n 12 \
		-p -5625,2600,-10500 \
		-b 1 \
		-s -5625,   0,-10750 \
		-l -5000,3250, -9875
	chara 電灯虫 電灯虫 \
		-n 12 \
		-p 5625,2600,-10500 \
		-b 1 \
		-s 5000,   0,-10750 \
		-l 5625,3250, -9875

	//---------------------------------------------------------
	// 張り付き壁
	@東西５０ｃｍ幅透明壁設置 上壁 -6250 5000 -7125 2000
	trap wl001 d:PLAYER \
		-mask ？ \
		-state 4 \
		-exec {
			if($3 == 入る) {
				command パッド操作 -mask d:PAD_B
				mesg 透明壁 上壁 off
			} else {
				command パッド操作 -cancel 0
				mesg 透明壁 上壁 on
			}
		}

	//---------------------------------------------------------
	// 鏡面モデル

	// chara 鏡面モデル管理 -pos 鏡面座標 -axis 反点軸 // 0:X軸反点 1:Y軸反点 2:Z軸反点
	chara 鏡面モデル管理 鏡面モデル \
		-pos  0, 0, 0 \
		-axis 1
	trap ev003 ？ -mask ？ \
		-exec {
			if($3 == 入る) {
				mesg 鏡面モデル管理 鏡面モデル add $2
			} else {
				mesg 鏡面モデル管理 鏡面モデル del $2
			}
		}

	//---------------------------------------------------------
	// ガラス弾痕
	chara ガラス弾痕 ガラス弾痕 \
		-flag   0 \
		-thick  1 \
		-size   60 \
		-number 4 \
		-point  3625,1900,-6950  3625,1000,-6275 \
		-point  3625,1900,-6225  3625,1000,-5550 \
		-point -3625,1900,-6950 -3625,1000,-6275 \
		-point -3625,1900,-6225 -3625,1000,-5550

	//---------------------------------------------------------
	// ダンボールトラップ
	chara ダンボール柄トラップ設定 ダンボール柄トラップ設定 \
		-name d:PLAYER \
		-traps d:アイテム:ダンボールＣ, cbox_area

	//---------------------------------------------------------
	// 影投影モデル

//	// 影投影モデル -m 影投影専用モデル -p 設置位置
//	chara 影投影モデル 影投影モデル西 -m d:KMS_NAME6 -p -2,2,-2
//	chara 影投影モデル 影投影モデル東 -m d:KMS_NAME7 -p -2,2,-2
//
//	// 影管理 -t 光源タイプ -l 光源距離(並行光源時のみ有効) -p 並行光源方向直接指定
//	chara 影管理 影管理 -t 0 -l 6000 -p 975,-3154,5372
//	trap dr001 ？ \
//		-mask ？ \
//		-exec {
//			if($3 == 入る) {
