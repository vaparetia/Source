/*……。*/
}//d


//●ＳＡＶＥ失敗  h//e
//・メモリーカードがない h //e
resource TO_ＳＡＶＥ失敗メモリーカードない__s {
//ns
オタコン_000: {
&~!Eh!, no hay una MEMORY CARD (PS2)
en la ranura para MEMORY CARD.
}
//	<<<ENGLISH>>>
//	Hey, there's no MEMORY CARD
//	(PlayStation&@R2) in the MEMORY
//	CARD slot.

/*あ、＃｛ＭＥＭＯＲＹ、メモリー｝＃ ＃｛ＣＡＲＤ、カード｝＃差込口に
＃｛"PlaySation2"、ピーエスツー｝＃専用メモリーカードが
ささってないよ。
*/

オタコン_001: {
No se puede guardar a menos
que tengas una MEMORY CARD (PS2)
preparada.
}
//	<<<ENGLISH>>>
//	Saving can't be done unless you have
//	a MEMORY CARD (PlayStation&@R2)
//	ready.

/*＃｛記録、セーブ｝＃するには＃｛"PlaySation2"、ピーエスツー｝＃専用
メモリーカードが必要なんだ。
*/

オタコン_002: {
Necesitas introducir la MEMORY CARD
(PS2) en la ranura para MEMORY CARD.
}
//	<<<ENGLISH>>>
//	You need to set the MEMORY CARD
//	(PlayStation&@R2) in the MEMORY CARD
//	slot.

/*＃｛ＭＥＭＯＲＹ、メモリー｝＃ ＃｛ＣＡＲＤ、カード｝＃差込口に
＃｛"PlaySation2"、ピーエスツー｝＃専用メモリーカードを
セットしてくれ。
*/
}//d


//・空き領域がない h //e
resource TO_ＳＡＶＥ失敗空領域ない__s {
//ns
オタコン_000: {
Oh no. Snake, no hay espacio suficiente
en la MEMORY CARD (PS2) para guardar
el juego.
}
//	<<<ENGLISH>>>
//	Oh no. Snake, there wasn't enough
//	space left on the MEMORY CARD
//	(PlayStation&@R2) to save the game.

/*うーん。スネーク、＃｛"PlaySation2"、ピーエスツー｝＃専用
メモリーカードに空き領域がなくて
＃｛記録、セーブ｝＃出来なかったよ。
*/

}//d


//・フォーマットしようとしない  h //e
resource TO_ＳＡＶＥ失敗フォーマットしようとしない__s {
//ns
オタコン_000: {
Lo siento pero - no puedes guardar si no
Formateas, ya lo sabes.
}
//	<<<ENGLISH>>>
//	'Scuse me but -- you can't save
//	unless you format, you know.

/*あのー、フォーマットしないと＃｛記録、セーブ｝＃は
出来ないんだけど、わかってる？
*/

}//d


//・その他エラー  h //e
resource TO_ＳＡＶＥ失敗その他エラー__s {
//ns
オタコン_000: {
Lo siento mucho, Snake. Hubo un error y
no pude guardar.
}
//	<<<ENGLISH>>>
//	I'm really sorry, Snake.
//	There was an error and
//	I couldn't save.

/*スネーク、ごめん。エラーが起きて
＃｛記録、セーブ｝＃できなかった。
*/

}//d


//●ＳＡＶＥ失敗緊迫  h//e
//・メモリーカードがない緊迫 h //e
resource TO_ＳＡＶＥ失敗メモリーカードない緊迫__s {
//ns
オタコン_000: {
&~!No hay una MEMORY CARD (PS2)
en la ranura para MEMORY CARD!
}
//	<<<ENGLISH(2)>>>
//	There's no MEMORY CARD
//	(PlayStation&@R2) in the MEMORY
//	CARD slot!

/*あ、＃｛ＭＥＭＯＲＹ、メモリー｝＃ ＃｛ＣＡＲＤ、カード｝＃差込口に
＃｛"PlaySation2"、ピーエスツー｝＃専用メモリーカードが
ささってない！
*/

オタコン_001: {
&~!No puedo guardar a menos que
tengas una MEMORY CARD (PS2)
preparada!
}
//	<<<ENGLISH>>>
//	I can't save unless you have a
//	MEMORY CARD (PlayStation&@R2)
//	ready!

/*＃｛記録、セーブ｝＃するには＃｛"PlaySation2"、ピーエスツー｝＃専用
メモリーカードが必要なんだ！
*/

オタコン_002: {
&~!Introduce la MEMORY CARD
(PS2) en la ranura para
MEMORY CARD ahora!
}
//	<<<ENGLISH(2)>>>
//	Set the MEMORY CARD
//	(PlayStation&@R2) in the
//	MEMORY CARD slot now!

/*＃｛ＭＥＭＯＲＹ、メモリー｝＃ ＃｛ＣＡＲＤ、カード｝＃差込口に
＃｛"PlaySation2"、ピーエスツー｝＃専用メモリーカードを
セットしてくれ！
*/
}//d


//・空き領域がない緊迫 h //e
resource TO_ＳＡＶＥ失敗空領域ない緊迫__s {
