//●ＳＡＶＥメニューが出る前 d//e
//・普通 h//e
resource TO_ＳＡＶＥ前普通１__s{
オタコン_000: {
&~?Snake, quieres guardar?
}
//	<<<ENGLISH>>>
//	Do you want to save, Snake?

/*＃｛記録、セーブ｝＃するかい、スネーク？*/
}//d

resource TO_ＳＡＶＥ前普通２__s{
オタコン_000: {
&~?Quieres guardar ya?
}
//	<<<ENGLISH>>>
//	Time to save?

/*＃｛記録、セーブ｝＃だね？*/
}//d

resource TO_ＳＡＶＥ前普通３__s {
オタコン_000: {
Oh, necesitas guardar. Espera un
segundo.
}
//	<<<ENGLISH>>>
//	Oh, you need to save. Just a second.

/*ああ、＃｛記録、セーブ｝＃だね？すぐ準備する。*/
}//d

resource TO_ＳＡＶＥ前普通４__s {
オタコン_000: {
Oh, Snake, &~?quieres guardar?
}
//	<<<ENGLISH(2)>>>
//	Oh, Snake, you want to save?

/*スネーク、＃｛記録、セーブ｝＃したいのかい？*/
}//d


//・緊迫状態 h//e
resource TO_ＳＡＶＥ前緊迫１__s {
オタコン_000: {
&~?Necesitas guardar, verdad Snake?
}
//	<<<ENGLISH(2)>>>
//	Need to save, right, Snake?

/*＃｛記録、セーブ｝＃だね、スネーク？*/
}//d

resource TO_ＳＡＶＥ前緊迫２__s {
オタコン_000: {
&~?Est&'as bien Snake? Estoy listo para
guardar cuando sea.
}
//	<<<ENGLISH>>>
//	You all right, Snake?
//	I'm ready to save whenever you are.

/*大丈夫かい、スネーク？
＃｛記録、セーブ｝＃の準備なら出来てるよ？
*/
}//d

resource TO_ＳＡＶＥ前緊迫３__s {
オタコン_000: {
&~!Snake! &~!Gracias a Dios! Puedo
guardarlo si lo necesitas.
}
//	<<<ENGLISH>>>
//	Snake! Thank God!
//	I can do a quick save if you need.

/*スネーク！無事かい？
＃｛記録、セーブ｝＃ならすぐ出来るよ
*/
}//d

resource TO_ＳＡＶＥ前緊迫４__s {
オタコン_000: {
&~!Snake! &~?Necesitas guardar?
}
//	<<<ENGLISH>>>
//	Snake! Do you need to save?

/*スネーク！＃｛記録、セーブ｝＃かい？*/
}//d




//記録するメニューを選ばなかった場合  h//e
//普通 //e
resource TO_未セーブ終了普通１__s {
//ns
オタコン_000: {
De acuerdo, hasta luego Snake.
}
//	<<<ENGLISH>>>
//	OK, see you, Snake.

/*じゃあね、スネーク。*/
}//d

resource TO_未セーブ終了普通２__s {
//ns
オタコン_000: {
Aguanta.
}
//	<<<ENGLISH(2)>>>
//	Hang in there.

/*がんばってくれよ*/
}//d

resource TO_未セーブ終了普通３__s {
//ns
オタコン_000: {
Oh, &~?no vas a guardar? Bien, de acuerdo,
d&'imelo cuando lo necesites.
}
//	<<<ENGLISH>>>
//	Oh, you're not going to save?
//	Well, okay, just let me know
//	when you need to.

/*なんだ、＃｛記録、セーブ｝＃しないのかい？
ま、いいや。＃｛記録、セーブ｝＃したくなったら、
また連絡してくれ。
*/
}//d

resource TO_未セーブ終了普通４__s {
//ns
オタコン_000: {
De acuerdo Snake. Evita los problemas.
}
//	<<<ENGLISH>>>
//	OK, Snake. Stay out of trouble.

/*ＯＫ。スネーク、気をつけて。*/
}//d

resource TO_未セーブ終了普通５__s {
//ns
オタコン_000: {
Snake, esta frecuencia es para guardar.
&~?Te acuerdas?
}
//	<<<ENGLISH>>>
//	Look, Snake, this frequency is
//	for saving only. Remember?

/*スネーク、これは＃｛記録、セーブ｝＃専用の
回線なんだけど……。
*/
}//d


//・緊迫 //e
resource TO_未セーブ終了緊迫１__s {
//ns
オタコン_000: {
&~!Aguanta Snake!
}
//	<<<ENGLISH>>>
//	Hang in there, Snake!

/*頑張ってくれよ、スネーク！*/
}//d

resource TO_未セーブ終了緊迫２__s {
//ns
オタコン_000: {
Cuando necesites guardar d&'imelo, &~?vale?
&~!No dejes que te pillen!
}
//	<<<ENGLISH>>>
//	Let me know as soon as you
//	need to save, okay? Don't let
//	them get you!

/*＃｛記録、セーブ｝＃が必要になったらすぐ
連絡してくれ。負けるなよ！
*/
}//d

resource TO_未セーブ終了緊迫３__s {
//ns
オタコン_000: {
&~!No te des por vencido!
}
//	<<<ENGLISH(2)>>>
//	Don't give up!

/*あきらめないでくれよ！*/
}//d

resource TO_未セーブ終了緊迫４__s {
//ns
オタコン_000: {
&~!Snake! &~!Tienes que seguir vivo!
}
//	<<<ENGLISH>>>
//	Snake!
//	You've got to stay alive!

/*勝つんだ、スネーク！*/
}//d


//・汎用無言 //e
resource TO_無言__s {
//ns
オタコン_000: {
...
}
//	<<<ENGLISH(2)>>>
