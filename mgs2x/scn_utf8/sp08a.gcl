// ------------------------------------
// マップ設定
// ------------------------------------
chara マップ ダークステージ -k d:KMS_NAME -h d:HZX_NAME,0 -l d:LT2_NAME
command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 1

command マップ設定 ダークステージ -set {
	// ローカルの初期化
	// ------------------------------------
	@ローカル変数初期化		// ローカルで使用する変数で初期化をする場合はここで

	// 設定値を変更する場合は以下のプロック内で設定
	// ------------------------------------
	@設定値変更				// 敵兵や的のパラメータをステージ限定で変える時はここで

	// ＶＲで必要な基本プロックのセット(vr_common.hで定義)
	// サウンドの基本パック、ＶＲの基本システム、プレイヤー、ゴール等を設定します
	// ※このプロックを使用する時は「ＶＲクリア時処理」というプロックが必要です
	// ＶＲ共通プロックセット	$:スネークファイル $:雷電ファイル $:クリア条件フラグ
	//							$:ゴールＸ $:ゴールＹ $:ゴールＺ $:タイマー初期値
	//	VR_GOAL_TARGET	/*的全滅でゴールが開く*/
	//	VR_GOAL_FREE	/*ゴールが最初から開いてる*/
	//	VR_GOAL_ENEMY	/*敵全滅でゴールが開く*/
	//	VR_GOAL_SNEAK	/*潜入モード中はゴールが開く*/
	//	VR_GOAL_TIME	/*タイマーがゼロになるとゴールが開く*/
	// ------------------------------------
	@ＶＲ共通プロックセット sna_sp08a rai_sp08a d:VR_GOAL_ENEMY d:GOAL_POS_SP08A

	// ＶＲウィンドウの設定
	// ------------------------------------
	@ダークステージＶＲウィンドウ設定

	// クリア時に呼ばれるものの設定
	// ------------------------------------
	if ( $s:選択プレイヤー == ライデン || $s:選択プレイヤー == スネーク ) {
		@ＶＲクリア設定 p:load_sp07a p:A_ＲＥＴＲＹプロック
	} else if ( $s:選択プレイヤー == 前作スネーク  ) {
		@ＶＲクリア設定 p:load_sp03a p:A_ＲＥＴＲＹプロック
	} else {
		@ＶＲクリア設定 p:A_ミッションエンド p:A_ＲＥＴＲＹプロック
	}

	// ステージに引かれるライン
	// ------------------------------------
	@ＶＲアウトライン d:KMS_NAME d:TONBO_KMS_NAME d:LINE_KMS_NAME


	// プレイヤーの設定
	// ------------------------------------
	@プラグイン設定			// プレイヤーのプラグインがいる時はここで
	@ジャンプ設定

	// 敵兵・的関係の設定
	// ------------------------------------
	@コマンダー設定
	@ＶＲ機雷設定

	// ＢＧＭの設定(プレイヤー→敵兵→BGMの順で呼ぶ)
	// ------------------------------------
	@ＢＧＭ設定

	// アイテムの設定
	// ------------------------------------
	@アイテム設定

	// 光源、オブジェクト、カメラ関連の設定
	// ------------------------------------
	@鏡設定
	@ガラス弾痕設定
	@落とし穴設置
	@フォグ設定
	@カメラセット					// chara カメラとベースのカメラを設定
	@ダークステージカメラ設定		// ステージ固有のカメラ設定がいる時はこのプロックで
	@キャラ用ライト設置				// 必ず最後に設定
#if d:DEBUG_CHARA
//	@デバッグキャラセット
#endif
}

//初期マップの表示
command マップ表示 -show ダークステージ


// 各proc設定
//-------------------------------------------------------------------------------------
// 全マップ共通
	//------------------------------------------------------------
	// ＶＲウィンドウの設定と表示
	//------------------------------------------------------------
	proc ダークステージＶＲウィンドウ設定 {
		#if d:DEBUG_PRINT
			print 'vr_window_set'
		#endif

		@ＶＲウィンドウ設定	d:SP08A_WINDOW_RES

		// ＶＲウィンドウを表示する
		mesg ＶＲウィンドウ ＶＲウィンドウ君 開く

		// スタート時とクリア時に使用するカットインカメラ
		chara カメラ カットインカメラ		-c 0 -l 0 -p  0

		// スタート時のカメラ(必要な場合)
		chara カメラ設定 カットインカメラ \
			-c 1 \	
			-p 56500,6531,-35031 -t 56500,0,-39000 \
			-r 668,2048,0 -f 7643 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1
	}

	//------------------------------------------------------------
	// ステージ開始時処理
	//------------------------------------------------------------
	proc ＶＲステージ開始時処理 {
		#if d:DEBUG_PRINT
			print 'game_start!!!!!'
		#endif

		// プレイヤーやパッドの制御等を行う a_stdproc.hで定義
		@全ミッション共通ステージ開始時処理

		// カメラワークスタート(必要な場合)
		// 全体図
		chara カメラ設定 カットインカメラ \
			-c 1 \	
			-p 26953,60228,15624 -t 26953,-12370,-26986 \
			-r 678,2048,0 -f 84179 \
			-a 200 \
			-i 4 4 d:START_CAMERA_CHANGE_TIME d:START_CAMERA_CHANGE_TIME \
			-s 1

		chara delay ディレイ \
			-time d:START_CAMERA_CHANGE_TIME \
			-exec {
				chara カメラ設定 カットインカメラ -s -1
			}
	}


	// ------------------------------------
	// クリア時の処理
	// ------------------------------------
	proc ＶＲクリア時処理 {
		#if d:DEBUG_PRINT 
			print 'clear'
		#endif

		// 強制モーションを発動(ザコサバイバルのないキャラは、最後のステージなのでモーションを変える）
		if ( $s:選択プレイヤー == ライデン || $s:選択プレイヤー == スネーク || $s:選択プレイヤー == 前作スネーク ) {
			@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_1 0
		} else {
			@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_2 0
		}

		// クリア時にカメラアングルを変える
		chara カメラ設定 クリア時カメラ \
			-c 1 \	
			-p 56833,1822,-34148 -t 56310,1252,-37332 \
			-r 114,2154,0 -f 3277 \
			-a 200 \
			-i 1 0 0 0 \
			-s 1
	}



	// ------------------------------------
	// パラメータ系の変更
	// ------------------------------------
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT 
			print 'localvar_init'
		#endif

		$$i:テンプライトカウンタ = 0;
	}

	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT 
			print 'status_set'
		#endif

		// 初期装備の追加設定
		switch ( $s:選択プレイヤー ) {
			case ( ライデン ) {
				$w:武器弾数Ｒ[ d:武器:Ｍ９ ] = 16;
				$w:武器弾数Ｒ[ d:武器:ソコム ] = 25;
				$w:プレイヤーフラグ = ( $w:プレイヤーフラグ| d:PL_SOCOM_SPPRSR_ATTACHED );
				$w:武器弾数Ｒ[ d:武器:マガジン ] = 5;
				$w:アイテム数Ｒ[ d:アイテム:双眼鏡 ] = 1;
				$w:アイテム数Ｒ[ d:アイテム:振動センサー ] = 1
				$w:武器 = d:武器:ソコム;
				$w:アイテム = d:アイテム:振動センサー;
			}
			case ( スネーク ) {
				$w:武器弾数Ｒ[ d:武器:Ｍ９ ] = 16;
				$w:武器弾数Ｒ[ d:武器:ＵＳＰ ] = 16;
				$w:武器弾数Ｒ[ d:武器:マガジン ] = 5;
				$w:プレイヤーフラグ = ( $w:プレイヤーフラグ| d:PL_USP_SPPRSR_ATTACHED );
				$w:アイテム数Ｒ[ d:アイテム:双眼鏡 ] = 1;
				$w:アイテム数Ｒ[ d:アイテム:振動センサー ] = 1;
				$w:武器 = d:武器:ＵＳＰ;
				$w:アイテム = d:アイテム:振動センサー;
			}
			case ( プリスキン ) {
				$w:武器弾数Ｒ[ d:武器:Ｍ４ ] = 61;
				$w:アイテム数Ｒ[ d:アイテム:振動センサー ] = 1
				$w:アイテム数Ｒ[ d:アイテム:双眼鏡 ] = 1;
				$w:武器弾数Ｒ[ d:武器:マガジン ] = 3;
				$w:武器 = d:武器:Ｍ４;
				$w:アイテム = d:アイテム:振動センサー;
			}
			case ( タキシードスネーク ) {
				$w:武器弾数Ｒ[ d:武器:Ｍ９ ] = 7;
				$w:アイテム数Ｒ[ d:アイテム:振動センサー ] = 1
				$w:アイテム数Ｒ[ d:アイテム:双眼鏡 ] = 1;
				$w:武器弾数Ｒ[ d:武器:マガジン ] = 3;
				$w:武器 = d:武器:Ｍ９;
				$w:アイテム = d:アイテム:振動センサー;
			}
			case ( 刀ライデン ) {
				$w:武器弾数Ｒ[ d:武器:ブレード ] = 1;
				$w:プレイヤーフラグ = ( $w:プレイヤーフラグ | d:PL_START_STATE_BLADE_OUT );		// 刀抜いている
				$w:プレイヤーフラグ = ( $w:プレイヤーフラグ & ~(d:PL_START_STATE_BLADE_INV) );	// 峰うちじゃない
				$w:アイテム数Ｒ[ d:アイテム:双眼鏡 ] = 1;
				$w:アイテム数Ｒ[ d:アイテム:振動センサー ] = 1
				$w:アイテム = d:アイテム:振動センサー;
				$w:武器 = d:武器:ブレード;
				$w:アイテム = d:アイテム:振動センサー;
			}
			default {
				// 前作スネーク
				$w:武器弾数Ｒ[ d:武器:ＵＳＰ ] = 7;
				$w:アイテム数Ｒ[ d:アイテム:双眼鏡 ] = 1;
				$w:武器 = d:武器:ＵＳＰ;
				$w:アイテム = d:アイテム:素手;
			}
		}

	}



	// ------------------------------------
	// プレイヤーに関する設定
	//-------------------------------------
	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif

		command プラグイン自動ジャンプ
		command ＵＳＰライトＯＮ
		command プラグイン落下
	}
	//-------------------------------------
	// 台登り
	// ------------------------------------
	proc ジャンプ設定 {
		#if d:DEBUG_PRINT
			print 'jump_set'
		#endif

		trap ky001 d:PLAYER \
			-mask 入る \
			-exec {
				@ジャンプ発動 ky001 1000 10
			}
	}



	// ------------------------------------
	// 敵兵や的の処理
	// ------------------------------------
	// 敵兵に関する設定
	//-------------------------------------
	// 拠点防衛型の警備兵
	proc VR_拠点防衛兵 $:p_名前 $:p_ルート $:p_ステータス $:p_拡張ステータス {
		#if d:DEBUG_PRINT
			print 'watcher_set'
		#endif

		chara 長廊下兵 $:p_名前 \
			-r $:p_ルート \
			-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
			-l $w:敵標準体力 -f $w:敵標準気絶 \
			-s $:p_ステータス \
			-k ( d:ENE_STST_VRBODY | $:p_拡張ステータス ) \
			-v d:アナザーダーク \
			-t 0
	}

	// ライデンの敵兵セット
	proc 拠点兵セット_ライデン {
		#if d:DEBUG_PRINT 
