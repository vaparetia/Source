	// 各兵士のコマンダー
	proc 拠点兵コマンダー {
		#if d:DEBUG_PRINT
			print 'wccomm_set'
		#endif

		switch ( $s:選択プレイヤー ) {
			case ( ライデン ) {
				@拠点兵コマンダー_ライデン
			}
			case ( スネーク ) {
				@拠点兵コマンダー_スネーク
			}
			case ( プリスキン ) {
				@拠点兵コマンダー_プリスキン
			}
			case ( タキシードスネーク ) {
				@拠点兵コマンダー_タキシードスネーク
			}
			case ( 刀ライデン ) {
				@拠点兵コマンダー_刀ライデン
			}
			default {
				// 前作スネーク
				@拠点兵コマンダー_前作スネーク
			}
		}
	}

	proc 攻撃兵コマンダー {
		#if d:DEBUG_PRINT
			print 'atcomm_set'
		#endif

		switch ( $s:選択プレイヤー ) {
			case ( スネーク ) {
				chara 攻撃コマンダー wccomm -e { 警備攻撃兵セット_スネーク }
			}
			case ( プリスキン ) {
				chara 攻撃コマンダー wccomm -e { 警備攻撃兵セット_プリスキン }
			}
			case ( タキシードスネーク ) {
				chara 攻撃コマンダー wccomm -e { 警備攻撃兵セット_タキシードスネーク }
			}
			case ( 刀ライデン ) {
				chara 攻撃コマンダー wccomm -e { 警備攻撃兵セット_刀ライデン }
			}
			default {
				// 前作スネーク
				chara 攻撃コマンダー wccomm -e { 警備攻撃兵セット_前作スネーク }
			}
		}
	}

	proc コマンダー設定 {
		#if d:DEBUG_PRINT
			print 'commander_set'
		#endif

		if ( $s:選択プレイヤー == ライデン ) {
			chara コマンダー 敵兵セット \
				-w 拠点兵コマンダー \
				-d ダークステージ \
				-r d:GOAL_POS_SP08A ダークステージ \
				-c d:GOAL_POS_SP08A ダークステージ \
				-v [ene_vr_voice:01] \
				-z $i:敵標準麻酔持続 \
				-h $i:標準警戒時間 \
				-o $i:敵標準気絶持続 \
				-s (d:ENE_STAGE_VR_ANOTHER) \
				-b 0 \
				-m d:ALERT_MODE_SENNYU
		} else {
			chara コマンダー 敵兵セット \
				-w 拠点兵コマンダー \
				-a 攻撃兵コマンダー \
				-d ダークステージ \
				-r d:GOAL_POS_SP08A ダークステージ \
				-c d:GOAL_POS_SP08A ダークステージ \
				-v [ene_vr_voice:01] \
				-z $i:敵標準麻酔持続 \
				-h $i:標準警戒時間 \
				-o $i:敵標準気絶持続 \
				-s (d:ENE_STAGE_VR_ANOTHER) \
				-b 0 \
				-m d:ALERT_MODE_SENNYU
		}

	}




	// 的に関する設定
	//-------------------------------------
	proc ＶＲ機雷設定 {
		#if d:DEBUG_PRINT 
			print 'vr_bomb_set'
		#endif

		local $$:ＶＲ機雷フラグ;
		$$:ＶＲ機雷フラグ = ( d:VR_TRG_MINE | d:VR_TRG_FL_MARK );

		switch ( $s:選択プレイヤー ) {
			case ( スネーク ) {
				chara	ＶＲ移動的 機雷:01 \
					-flag $$:ＶＲ機雷フラグ \
					-route d:E_R:スネーク機雷Ｒ \
					-speed 25
			}
			case ( プリスキン ) {
				chara	ＶＲ移動的 機雷:01 \
					-flag $$:ＶＲ機雷フラグ \
					-route d:E_R:プリスキン機雷Ｒ \
					-speed 25
			}
			case ( タキシードスネーク ) {
				chara	ＶＲ移動的 機雷:01 \
					-flag $$:ＶＲ機雷フラグ \
					-route d:E_R:タキシードスネーク機雷Ｒ \
					-speed 25
			}
			case ( 刀ライデン ) {
				chara	ＶＲ移動的 機雷:01 \
					-flag $$:ＶＲ機雷フラグ \
					-route d:E_R:刀ライデン機雷Ｒ01 \
					-speed 40

				chara	ＶＲ移動的 機雷:02 \
					-flag $$:ＶＲ機雷フラグ \
					-route d:E_R:刀ライデン機雷Ｒ02 \
					-speed 40
			}
			case ( 前作スネーク ) {
				// 前作スネーク
				chara	ＶＲ移動的 機雷:01 \
					-flag $$:ＶＲ機雷フラグ \
					-route d:E_R:前作スネーク機雷Ｒ01 \
					-speed 50

				chara	ＶＲ移動的 機雷:02 \
					-flag $$:ＶＲ機雷フラグ \
					-route d:E_R:前作スネーク機雷Ｒ02 \
					-speed 50

				chara	ＶＲ移動的 機雷:03 \
					-flag $$:ＶＲ機雷フラグ \
					-route d:E_R:前作スネーク機雷Ｒ03 \
					-speed 50
			}
		}
	}



	// ------------------------------------
	// ＢＧＭの設定
	// ------------------------------------
	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT 
			print 'bgm_set'
		#endif

		chara ＢＧＭマネージャー ＢＧＭマネ
	}


	// ------------------------------------
	// アイテムの設定
	// ------------------------------------
	// 再発生が必要な時は以下のプロックの中を記述する
	// ------------------------------------
	proc アイテム取得時番号設定 $:ボックス名 {
		#if d:DEBUG_PRINT
			print 'item_no_set'
		#endif
	}
	// アイテムの設置
	// ------------------------------------
	proc アイテム設定 {
		#if d:DEBUG_PRINT 
			print 'item_set'
		#endif

		switch ( $s:選択プレイヤー ) {
			case ( ライデン ) {
				@A_ＰＳＧ１_初期設置 ＰＳＧ１本体 d:ITEM_POS_03 0 なし 15
				@A_ＰＳＧ１－Ｔ_初期設置 ＰＳＧ１－Ｔ本体 d:ITEM_POS_04 0 なし 15
				@ジアゼパム_初期設置 ジアゼパム d:ITEM_POS_05 0
				@暗視ゴーグル_初期設置 暗視ゴーグル d:ITEM_POS_01 0
				@サーマルゴーグル_初期設置 サーマルゴーグル d:ITEM_POS_07 0
			}
			case ( スネーク ) {
				@A_ＰＳＧ１_初期設置 ＰＳＧ１本体 d:ITEM_POS_06 0 なし 15
				@A_ＰＳＧ１－Ｔ_初期設置 ＰＳＧ１－Ｔ本体 d:ITEM_POS_01 0 なし 15
				@ジアゼパム_初期設置 ジアゼパム d:ITEM_POS_03 0
				@暗視ゴーグル_初期設置 暗視ゴーグル d:ITEM_POS_22 0
				@サーマルゴーグル_初期設置 サーマルゴーグル d:ITEM_POS_09 0
			}
			case ( プリスキン ) {
				@A_Ｍ９_初期設置 Ｍ９本体 d:ITEM_POS_03 0 なし 10
				@A_ＵＳＰ_初期設置 ＵＳＰ本体 d:ITEM_POS_28 0 なし 16
				@A_ＰＳＧ１_初期設置 ＰＳＧ１本体 d:ITEM_POS_22 0 なし 15
				@A_ＰＳＧ１－Ｔ_初期設置 ＰＳＧ１－Ｔ本体 d:ITEM_POS_08 0 なし 10
				@ジアゼパム_初期設置 ジアゼパム d:ITEM_POS_02 0
				@暗視ゴーグル_初期設置 暗視ゴーグル d:ITEM_POS_13 0
				@サーマルゴーグル_初期設置 サーマルゴーグル d:ITEM_POS_15 0
			}
			case ( タキシードスネーク ) {
				@A_ＵＳＰ_初期設置 ＵＳＰ本体 d:ITEM_POS_01 0 なし 16
				@A_ＰＳＧ１_初期設置 ＰＳＧ１本体 d:ITEM_POS_11 0 なし 15
				@A_ＰＳＧ１－Ｔ_初期設置 ＰＳＧ１－Ｔ本体 d:ITEM_POS_22 0 なし 7
				@ジアゼパム_初期設置 ジアゼパム d:ITEM_POS_05 0
				@暗視ゴーグル_初期設置 暗視ゴーグル d:ITEM_POS_10 0
				@サーマルゴーグル_初期設置 サーマルゴーグル d:ITEM_POS_15 0
			}
			case ( 刀ライデン ) {
				@暗視ゴーグル_初期設置 暗視ゴーグル d:ITEM_POS_10 0
				@サーマルゴーグル_初期設置 サーマルゴーグル d:ITEM_POS_13 0
			}
			default {
				// 前作スネーク
				@A_Ｍ９_初期設置 Ｍ９本体 d:ITEM_POS_22 0 なし 7
				@弾薬_ＵＳＰ_初期設置 ＵＳＰ弾薬 d:ITEM_POS_12 0 なし 16
				@A_ＰＳＧ１_初期設置 ＰＳＧ１本体 d:ITEM_POS_11 0 なし 15
				@A_ＰＳＧ１－Ｔ_初期設置 ＰＳＧ１－Ｔ本体 d:ITEM_POS_10 0 なし 7
				@ジアゼパム_初期設置 ジアゼパム d:ITEM_POS_03 0
				@暗視ゴーグル_初期設置 暗視ゴーグル d:ITEM_POS_15 0
				@サーマルゴーグル_初期設置 サーマルゴーグル d:ITEM_POS_16 0
			}
		}

	}



	// ------------------------------------
	// その他オブジェクト関係
	// ------------------------------------
	// 鏡
	// ------------------------------------
	proc 鏡設定 {
		#if d:DEBUG_PRINT
			print 'mirror_set'
		#endif

		chara 真鏡面  びっくり鏡 -p 18000,1570,-42000 -a 2

		command ＵＳＰライト鏡面 -p 18000,1570,-42000 -a 2

		trap ev001 d:PLAYER \
			-mask ？ \
			-exec {
				if ( $3 == 入る ) {
					mesg 真鏡面 びっくり鏡 on
				} else {
					mesg 真鏡面 びっくり鏡 off
				}
			}
		
	}

	// 鏡の弾痕
	proc ガラス弾痕設定 {
		#if d:DEBUG_PRINT 
			print 'recoil_set'
		#endif

		// ガラス弾痕
		chara ガラス弾痕 ガラス弾痕 \
			-flag   0 \
			-thick  1 \
			-size   60 \
			-number 3 \
			-point	18000,4000,-41999 21000,-1000,-41999 \
			-point	30000,4000,-41999 34000,-1000,-41999 \
			-point	41000,4000,-41999 52000,-1000,-41999
	}

	// 落とし穴
	// ------------------------------------
	proc 落とし穴設置 {
		#if d:DEBUG_PRINT
			print 'pitfall_set'
		#endif

		command foreach -argc 3 -repeat 4 \
			-data { \
					{ 落とし穴:01, 25000, -36000 } \
					{ 落とし穴:02, 25000, -34000 } \
					{ 落とし穴:03, 35000, -32000 } \
					{ 落とし穴:04, 37000, -32000 } \
				} \
				-exec { \
					chara ＶＲ落とし穴 $1 \
						-position $2, 0, $3 \
						-rotate 0,0,0 \
						-map ダークステージ \
						-model vr2_pitfall_a0 vr2_pitfall_a0 \
						-hazard	($2-1000), 0, ($3-1000) \	/*min maz の2点指定 */
								($2+1000), 0, ($3+1000) \
						-fall_time 40 \
						-fall_pattern 7 \
						-status 0 \
						-proc 落し穴落下時処理
				}
	}

	proc 落し穴落下時処理 {
		#if d:DEBUG_PRINT
			print 'pitfall_gameover'
		#endif

		if ( $1 == 落とし穴:01 ) {
			mesg プレイヤー d:PLAYER position 25000,$i:プレイヤー位置Ｙ,-36000
			@落下時カメラセット 25000 0 -36000
			@ジャンプ落下死発動 0x0004 -10000
			mesg ＶＲ落とし穴 落とし穴:01 fall
		} else if ( $1 == 落とし穴:02 ) {
			mesg プレイヤー d:PLAYER position 25000,$i:プレイヤー位置Ｙ,-34000
			@落下時カメラセット 25000 0 -34000
			@ジャンプ落下死発動 0x0004 -10000
			mesg ＶＲ落とし穴 落とし穴:02 fall
		} else if ( $1 == 落とし穴:03 ) {
			mesg プレイヤー d:PLAYER position 35000,$i:プレイヤー位置Ｙ,-32000
			@落下時カメラセット 35000 0 -32000
			@ジャンプ落下死発動 0x0004 -10000
			mesg ＶＲ落とし穴 落とし穴:03 fall
		} else if ( $1 == 落とし穴:04 ) {
			mesg プレイヤー d:PLAYER position 37000,$i:プレイヤー位置Ｙ,-32000
			@落下時カメラセット 35000 0 -32000
			@ジャンプ落下死発動 0x0004 -10000
			mesg ＶＲ落とし穴 落とし穴:04 fall
		}
	}

	// 落下したときに出るカメラ(落とし穴中心のＸＹＺを入力)
	proc 落下時カメラセット $:p_Ｘ $:p_Ｙ $:p_Ｚ {
		#if d:DEBUG_PRINT
			print 'fall camera set'
		#endif

		chara delay ディレイ \
			-time 1 \
			-arg $:p_Ｘ $:p_Ｙ $:p_Ｚ \
			-exec {
				chara カメラ設定 クリア時カメラ \
					-c 0 \
					-b d:CAM_MIN,5647,($1+1851)	 d:CAM_MAX,5647,($3+1851) \
					-l d:CAM_MIN,1500,($1+234)	 d:CAM_MAX,1500,($3+234) \
					-r 766,2243,0 -f 4392 \
					-a 200 \
					-i 0 -1 0 0 \
					-s 1
			}
	}

	// ジャンプ落下死発動から呼ばれるプロック
	proc ジャンプ落下死開始処理 {
		#if d:DEBUG_PRINT
			print 'jump_gameover_start'
		#endif

		@ゲームオーバー開始処理
	}

	// 最終的に落ちたときに呼ばれるプロック（サウンドや振動を呼ぶ）
	proc ゲームオーバー終了処理 {
	}


	// ------------------------------------
	// 光源関係
	// ------------------------------------
	// ------------------------------------
	proc フォグ設定 {
		#if d:DEBUG_PRINT
			print 'fog_set'
		#endif

		chara フォグ 霧\
			-c 0, 15, 10 \
			-n 3000 \
			-f 18000
	}
	// キャラ用光源(マップの設置が終わってから設定することで、キャラだけに光を当てる)
	// ------------------------------------
	proc キャラ用ライト設置 {
		#if d:DEBUG_PRINT
			print 'chara_light_set'
		#endif

		chara 環境光 環境光源 \
			 -c 0 20 10

		chara 平行光 平行光源 \
			 -c 0 35 30 \
			 -p -2500 -3200 -2500


		// プレイヤーの周りに光るテンプライト
		chara プロック連続実行 テンプライトチェック \
			-time -1 \
			-exec { \
				// プレイヤーが登場してから処理開始
				if ( $f:ロードチェックＯＮフラグ == 1 ) {
					command パッドチェック -which 0 -status
					if ( $status & d:PAD_Y ) {
						// 武器ボタンが押されているとき
						if ( $w:武器 == d:武器:ソコム || $w:武器 == d:武器:ＵＳＰ ) {
							$$i:テンプライトカウンタ = 0;
						} else {
							if ( $$i:テンプライトカウンタ < 60*75 ) {
								$$i:テンプライトカウンタ = $$i:テンプライトカウンタ + 1;
							}
						}
					} else {
						if ( $$i:テンプライトカウンタ < 60*75 ) {
							$$i:テンプライトカウンタ = $$i:テンプライトカウンタ + 1;
						}
					}

					if ( $$i:テンプライトカウンタ > 0 ) {
						command テンプライト プレイヤーテンプライト  \
							-p $i:プレイヤー位置Ｘ,$i:プレイヤー位置Ｙ,$i:プレイヤー位置Ｚ \
							-r $$i:テンプライトカウンタ -e ($$i:テンプライトカウンタ*2) -c 0,30,20 -f 0x0200
					}

					// さらにサーマルゴーグルか暗視ゴーグルをつけていたときはフォグのfarも変える
					if ( $w:アイテム == d:アイテム:サーマルゴーグル || $w:アイテム == d:アイテム:暗視ゴーグル ) {
						chara フォグ 霧 -c 0, 15, 10 -n 3000 -f 35000 -t 1
					} else {
						chara フォグ 霧 -c 0, 15, 10 -n 3000 -f 18000 -t 1
					}
				}
			}
	}

	// ------------------------------------
	// カメラ関係の設定 
	// ------------------------------------
	// ステージカメラ設定 
	// ------------------------------------
	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'chara_camera & stage_camera_set'
		#endif

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0 
		chara カメラ メインカメラ		-c 0 -l 2 -p 40
		chara カメラ サブカメラ			-c 0 -l 2 -p 30
		chara カメラ クリア時カメラ		-c 0 -l 0 -p 10

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \	
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 560,2048,0 \
			-f 5000 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}
	// ステージ固有のカメラ設定 
	// ------------------------------------
	proc ダークステージカメラ設定 {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif

		//---------------------
		// 通常のステージカメラ
		//---------------------
		// スタート地点のカメラ
		trap ca001 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 メインカメラ \
					-c 0 \	
					-b 4500,d:CAM_MIN,2750	 4500,d:CAM_MAX,3700 \
					-l 4500,1500,-1500		 4500,d:CAM_MAX,-500 \
					-r 375,2048,0 \
					-f 5000 \
					-a 200 \
					-i 2 2 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// １Ｆベースのカメラ
		trap ca002 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 メインカメラ \
					-c 0 \	
					-b 4500,5000,d:CAM_MIN	 22500,d:CAM_MAX,-1400 \
					-l 4500,1500,d:CAM_MIN	 22500,d:CAM_MAX,-4600 \
					-r 560,2048,0 \
					-f 5500 \
					-a 200 \
					-i 2 -1 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// １Ｆ北側エリアのカメラ
		trap ca003 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ降順 $6 -20500 -24000 10000 12000
				eval( $i:補完ＢＸ = $i:CS_結果１ );
				eval( $i:補完ＬＸ = $i:CS_結果１ );

				chara カメラ設定 メインカメラ \
					-c 0 \	
					-b $i:補完ＢＸ,5000,d:CAM_MIN	 22500,d:CAM_MAX,-1400 \
					-l $i:補完ＬＸ,1500,d:CAM_MIN	 22500,d:CAM_MAX,-4600 \
					-r 560,2048,0 \
					-f 5500 \
					-a 200 \
					-i 2 -1 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// １Ｆ中央の南北通路部分
		trap ca004 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ降順 $6 -25000 -30000 21000 20000
				eval( $i:補完ＢＸ = $i:CS_結果１ );
				eval( $i:補完ＬＸ = $i:CS_結果１ );
				@CS_スムーズカメラ降順 $6 -22000 -30000 -21500 -25000
				eval( $i:補完ＢＺ = $i:CS_結果１ );

				@CS_スムーズカメラ降順 $6 -23000 -30000 870 300
				eval( $i:補完ＲＸ = $i:CS_結果１ );

				chara カメラ設定 メインカメラ \
					-c 0 \	
					-b 12000,d:CAM_MIN,d:CAM_MIN	 $i:補完ＢＸ,d:CAM_MAX,$i:補完ＢＺ \
					-l 12000,1500,d:CAM_MIN			 $i:補完ＬＸ,d:CAM_MAX,-22750 \
					-r $i:補完ＲＸ,2048,0 \
					-f 5500 \
					-a 200 \
					-i 2 -1 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// １Ｆ北の落とし穴地帯付近
		trap ca005 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ降順 $6 -34000 -37000 20500 24500
				$i:補完ＢＸ = $i:CS_結果１;
				$i:補完ＬＸ = $i:CS_結果１;

				chara カメラ設定 メインカメラ \
					-c 0 \	
					-b $i:補完ＢＸ,5000,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,-28500 \
					-l $i:補完ＬＸ,1500,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,-32000 \
					-r 560,2048,0 \
					-f 5500 \
					-a 200 \
					-i 2 -1 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// １Ｆ北の落とし穴地帯付近の横
		trap ca006 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ降順 $6 -38000 -40000 560 300
				$i:補完ＲＸ = $i:CS_結果１;

				chara カメラ設定 メインカメラ \
					-c 0 \	
					-b 12000,d:CAM_MIN,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,-28500 \
					-l 12000,1500,d:CAM_MIN			 d:CAM_MAX,d:CAM_MAX,-32000 \
					-r $i:補完ＲＸ,2048,0 \
					-f 5500 \
					-a 200 \
					-i 2 -1 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// １Ｆ北側一番東の鏡のところのカメラ
		trap ca007 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ昇順 $4 42000 44000 -28500 -33000
				eval( $i:補完ＢＺ = $i:CS_結果１ );
				@CS_スムーズカメラ昇順 $4 42000 44000 -32000 -37250
				eval( $i:補完ＬＺ = $i:CS_結果１ );

				@CS_スムーズカメラ昇順 $4 42000 43000 560 300
				eval( $i:補完ＲＸ = $i:CS_結果１ );

				chara カメラ設定 メインカメラ \
					-c 0 \	
					-b 4500,d:CAM_MIN,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,$i:補完ＢＺ \
					-l 4500,1500,d:CAM_MIN		 d:CAM_MAX,d:CAM_MAX,$i:補完ＬＺ \
					-r $i:補完ＲＸ,2048,0 \
					-f 5500 \
					-a 200 \
					-i 2 2 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// １Ｆ北側一番東のゴール付近のカメラ
		trap ca008 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ降順 $6 -35000 -37000 560 300
				eval( $i:補完ＲＸ = $i:CS_結果１ );

				chara カメラ設定 メインカメラ \
					-c 0 \	
					-b 4500,d:CAM_MIN,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,-30500 \
					-l 4500,1500,d:CAM_MIN		 d:CAM_MAX,d:CAM_MAX,-34000 \
					-r $i:補完ＲＸ,2048,0 \
					-f 5500 \
					-a 200 \
					-i 2 2 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// 中央の島への階段
		trap ca009 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ降順 $5 4000 1000 4500 1500
				eval( $i:補完ＬＹ = $i:CS_結果１ );

				chara カメラ設定 メインカメラ \
					-c 0 \	
					-b 4500,5000,d:CAM_MIN			 d:CAM_MAX,d:CAM_MAX,-10500 \
					-l 4500,$i:補完ＬＹ,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,-14000 \
					-r 560,2048,0 \
					-f 5500 \
					-a 200 \
					-i 2 -1 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// 中央の島
		trap ca010 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 メインカメラ \
					-c 0 \	
					-b 4500,5000,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,-10500 \
					-l 4500,4500,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,-14000 \
					-r 560,2048,0 \
					-f 5500 \
					-a 200 \
					-i 2 -1 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// 北西の島への階段
		trap ca011 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ昇順 $5 500 3500 12000 4500
				eval( $i:補完ＢＸ = $i:CS_結果１ );
				eval( $i:補完ＬＸ = $i:CS_結果１ );

				@CS_スムーズカメラ降順 $5 4000 1000 4500 1500
				eval( $i:補完ＬＹ = $i:CS_結果１ );

				chara カメラ設定 メインカメラ \
					-c 0 \	
					-b $i:補完ＢＸ,5000,d:CAM_MIN			 d:CAM_MAX,d:CAM_MAX,-17500 \
					-l $i:補完ＬＸ,$i:補完ＬＹ,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,-20750 \
					-r 560,2048,0 \
					-f 5500 \
					-a 200 \
					-i 2 -1 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// 北西の島
		trap ca012 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 メインカメラ \
					-c 0 \	
					-b 4500,5000,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,-17500 \
					-l 4500,4500,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,-20750 \
					-r 560,2048,0 \
					-f 5500 \
					-a 200 \
					-i 2 -1 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}


		//-------------------------
		// 匍匐カメラ
		//-------------------------
		// １Ｆのベース部分のカメラ
		trap ca100 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_SQUAT d:TRP_STATE_GROUND \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ \
					-c 0 \	
					-b 4500,5000,d:CAM_MIN	 22500,d:CAM_MAX,-1400 \
					-l 4500,1500,d:CAM_MIN	 22500,d:CAM_MAX,-4600 \
					-r 870,2048,0 \
					-f 5500 \
					-a 200 \
					-i 3 3 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// １Ｆのベース部分のカメラ(ＢＸが12000)
		trap ca101 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_SQUAT d:TRP_STATE_GROUND \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ \
					-c 0 \	
					-b 12000,5000,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,-1400 \
					-l 12000,1500,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,-4600 \
					-r 870,2048,0 \
					-f 5500 \
					-a 200 \
					-i 3 3 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// 落とし穴地帯の横のカメラ
		trap ca102 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_SQUAT d:TRP_STATE_GROUND \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ \
					-c 0 \	
					-b 4500,5000,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,-29500 \
					-l 4500,1500,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,-31000 \
					-r 850,2048,0 \
					-f 5500 \
					-a 200 \
					-i 3 3 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// １Ｆ北側一番東の鏡のところのカメラ
		trap ca103 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_SQUAT d:TRP_STATE_GROUND \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ \
					-c 0 \	
					-b 4500,5000,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,-35000 \
					-l 4500,1500,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,-36500 \
					-r 850,2048,0 \
					-f 5500 \
					-a 200 \
					-i 3 3 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// １Ｆゴール付近の鏡の前のカメラ
		trap ca104 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_SQUAT d:TRP_STATE_GROUND \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ \
					-c 0 \	
					-b 4500,5000,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,-32000 \
					-l 4500,1500,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,-33500 \
					-r 850,2048,0 \
					-f 5500 \
					-a 200 \
					-i 3 3 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// 中央の島のカメラ
		trap ca105 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_SQUAT d:TRP_STATE_GROUND \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ \
					-c 0 \	
					-b 4500,5000,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,-10500 \
					-l 4500,4500,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,-14000 \
					-r 870,2048,0 \
					-f 5500 \
					-a 200 \
					-i 3 3 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// 北西の島のカメラ
		trap ca106 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_SQUAT d:TRP_STATE_GROUND \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ \
					-c 0 \	
					-b 4500,5000,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,-17500 \
					-l 4500,4500,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,-20750 \
					-r 870,2048,0 \
					-f 5500 \
					-a 200 \
					-i 3 3 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

	}





// -----------------------------------------------------------------------------------
// 以下デバッグ専用proc
// -----------------------------------------------------------------------------------
// デバッグキャラ
// ------------------------------------
proc デバッグキャラセット {
	#if d:DEBUG_PRINT
		print 'debug_chara_set'
	#endif

	#if d:CHARA_CAMERA
		chara キャラカメラ 敵兵カメラ \
			-c d:TARGET_CHARA \
			-s -920,610,200 \
			-r -200,1024,0 
	#endif

	#if d:SCREENSHOT
		chara スクリーンショット shot
	#endif

	#if d:USB_KEY
		chara USBキーボード実行 test \
			-e d:KBD_ESC {	
				mesg プレイヤー d:PLAYER position -5500, -13000, -500
			} \
	#endif
}
