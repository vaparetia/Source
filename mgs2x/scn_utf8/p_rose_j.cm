}
ローズ_004: {
ジャック……。
}
ライデン_005: {
ローズ、こっちは命賭けてるんだぞ。
}
ローズ_006: {
私だってそう！
}
ライデン_007: {
ローズ？
}
ローズ_008: {
ごめんなさい。でも私だって本当に
心配してるの、あなたのこと。
他人事になんか思ってない。
}
ライデン_009: {
ああ……わかってるよ。
ありがとう。
}
//dv}//v
}//d

//明日何の日 h //e
resource PR_ＳＡＶＥ後＿明日何の日１ {
//vox t:vc250711 {
ローズ_000: {
