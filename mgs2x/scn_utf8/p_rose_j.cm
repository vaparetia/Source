ライデン_009: {
ローズ？
}
ローズ_010: {
いいの。
がんばって。
}
//dv}//v
}//d

//新鮮 h //e
resource PR_ＳＡＶＥ後＿新鮮 {
//vox t:vc250701 {
ローズ_000: {
考えてみると、ちょっと新鮮ね。
}
ライデン_001: {
何が？
}
ローズ_002: {
あなたに会えるのが当然だったのに
