//エマと手つなぎ中 h //e
resource PR_ＳＡＶＥ後＿エマと手つなぎ {
//vox t:vc250691 {
ローズ_000: {
はい＃｛記録、セーブ｝＃終了。じゃ、さよなら。
}
ライデン_001: {
ちょっと待てよ。
どうしたんだ？
}
