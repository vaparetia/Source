*/

}//d




//○長廊下(w03a) d //e
//・ライト撃つと消える。h //e
resource TO_長廊下ライト__i {
オタコン_000: {
Spara contro le luci e por eliminarle.
}
//	<<<ENGLISH>>>
//	Shoot out the lights to
//	darken the corridor.
//<ページ数変更>
オタコン_000_1: {
Il corridoio ci serve buio, cos&`i il nemico
far&`a pi&`u fatica a trovarti.
}
//	<<<ENGLISH>>>
//	The enemy will have a
//	harder time finding you.

/*電灯を銃で撃って壊せば明かりを
消すことが出来る。暗くなるけど、
敵も君が見にくくなるはずだ。
*/

}//d

//・長廊下暗い注意 h //e
resource TO_長廊下ライトつけろ__i {
オタコン_000: {
Snake, usa la torcia in posti bui come
questo.
}
//	<<<ENGLISH>>>
//	Snake, use the flashlight
//	in dark places like this.

/*スネーク、暗いところではライトを
つけるといい。
*/

オタコン_001: {
La tua arma USP &`e equipaggiata con una
torcia.
}
//	<<<ENGLISH>>>
//	Your USP is equipped
//	with a flashlight.
//<ページ数変更>
オタコン_001_1: {
Devi solo selezionare l'arma e puntarla con
il tasto Armi. Ora la luce si accende.
}
//	<<<ENGLISH>>>
//	All you have to do is select the gun
//	and aim it with the Weapon button,
//	and the light will go on.

/*君のＵＳＰにはフラッシュライトが装備
されてる。ＵＳＰを装備して＃｛□、武器｝＃ボタン
で構えれば、その間ライトがつくよ。
*/

オタコン_002: {
Lo sai da te,
}
//	<<<ENGLISH>>>
//	Not that I need to tell you this,
//<ページ数変更>
オタコン_002_1: {
ma la luce ti rende un bersaglio perfetto se
ci sono nemici nelle vicinanze.
}
//	<<<ENGLISH>>>
//	but the light will turn you
//	into a better target if there
//	are enemies nearby.
//<ページ数変更>
オタコン_002_2: {
Stai attento, quindi.
}
//	<<<ENGLISH>>>
//	Be careful.

/*でも、ライトをつければ当然敵に
見つかりやすくなるから気をつけてくれ。
*/

}//d

//・敵は暗視ゴーグルをつけている h //e
