*/

}//d

resource TO_赤外線機関室通れない__i {
スネーク_000: {
L'idea di andare a picco non mi attira di
certo... 
}
//	<<<ENGLISH>>>
//	I'm not in the mood to go
//	sleep with the fishes, but...
//<ページ数変更>
スネーク_000_1: {
Ci sono troppi sensori. Mi sa che dovremo
trovare un'altra via.
}
//	<<<ENGLISH>>>
//	There are too many sensors. Looks
