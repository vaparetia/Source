//	So this is what they
//	were talking about.

/*奴等が仕掛けたと言っていたのは、
これのことか……。
*/
オタコン_001: {
Sembra proprio di s&`i.
}
//	<<<ENGLISH(2)>>>
//	Looks like it.

/*みたいだね。*/
}


resource TO_赤外線強制ＣＡＬＬ３__i {
//e
オタコン_000: {
Se attivi i sensori...
}
//	<<<ENGLISH>>>
//	If you trip the sensors...

/*もしセンサーにひっかかったら……。*/

スネーク_001: {
Vado a picco con l'intera nave, a far
