}
//	<<<ENGLISH(2)>>>
//	...

}//d

//・戻るなと怒られる h //e
resource TO_船倉戻るな１__i {
オタコン_000: {
Perch&'e stai svoltando? Metal Gear &`e nella
stiva pi&`u lontana, te l'ho detto.
}
//	<<<ENGLISH>>>
//	Why are you turning around?
//	Metal Gear is in the farthest
//	hold, I told you.

/*なんで戻るんだい？
メタルギアは一番奥の船倉だ。
*/
}


resource TO_船倉戻るな２__i {
//時間がない場合 h //e
オタコン_000: {
Il Comandante ha quasi finito di parlare. Il
nostro tempo sta per scadere - sbrigati!
}
//	<<<ENGLISH>>>
//	The Commandant is almost done
//	with his speech. We're just about
//	out of time -- hurry!

/*演説がもうすぐ終わる。
時間がない。急いで！
*/

}//d

//★デフォルト。ランダム（操作等ゲームの説明）基本的に序盤のみ、ある確率で発生 d //e

//○仕様 d //e
//・ルードの仕方。h //e
resource TO_エルード１の１__i {
//＊ムービー t //e
オタコン_000: {
Premi il tasto Azione vicino a un parapetto
scalabile, per sospenderti dall'altra parte.
}
//	<<<ENGLISH>>>
//	Push the Action button near
//	a scalable railing to hang off
//	the other side.

/*乗り越えられる手すりの近くで
＃｛△、アクション｝＃ボタンを押すと、その手すりの
向こう側にぶらさがることが出来る。
*/
}


resource TO_エルード１の２__i {
//＊ムービー t //e
オタコン_000: {
Questa tecnica si chiama Sospensione.
}
//	<<<ENGLISH>>>
//	This is called Hanging.
//<ページ数変更>
オタコン_000_1: {
Puoi usarla per spostarti, nasconderti e
persino manovrare alle spalle del nemico.
}
//	<<<ENGLISH>>>
//	You can use it to move around,
//	hide, and even maneuver around
//	an enemy's back.

/*これをエルードっていうんだ。
移動だけじゃなく、隠れたり敵の背後を
とったりするのにも使えるはずだ。
*/
}


resource TO_エルード２の１__i {
//＊ムービー t //e
オタコン_000: {
Mentre sei in Sospensione puoi spostarti a
sinistra e a destra, muovendo la levetta
analogica sinistra oppure i tasti L2 e R2.
}
//	<<<ENGLISH>>>
//	You can move the left analog stick or the
//	L2 and R2 buttons to move left and right
//	while hanging.

/*
You can move the left analog stick
or use the L2 and R2 buttons to
move left and right while hanging.
エルード中は左スティックの左右か
Ｌ２ボタン、Ｒ２ボタンで左右に
移動出来る。
*/
}


resource TO_エルード２の２__i {
//＊ムービー t //e
オタコン_000: {
Quando sei pronto a sollevarti, premi
nuovamente il tasto Azione.
}
//	<<<ENGLISH>>>
//	When you're ready to pull yourself
//	up, just push the Action button again.

/*這い上がりたくなったら、
もう一度＃｛△、アクション｝＃ボタンを押せばいい。
*/
}



resource TO_エルード３の１__i {
//＊ムービー t //e
オタコン_000: {
Mentre sei in Sospensione, sotto
l'indicatore della LIFE appare un
indicatore della GRIP.
}
//	<<<ENGLISH>>>
//	A Grip Gauge appears below
//	the Life Gauge during Hanging.

/*あと、エルード中は＃｛ＬＩＦＥ、ライフ｝＃ゲージの
下に＃｛握力、グリップ｝＃ゲージが表示されるんだ。
*/

オタコン_001: {
L'indicatore della GRIP mostra se
la tua presa &`e salda
}
//	<<<ENGLISH>>>
//	The Grip Gauge indicates how
//	tightly you are holding on,
//<ページ数変更>
オタコン_001_1: {
e cala costantemente mentre ti trovi nella
modalit&`a Sospensione.
}
//	<<<ENGLISH>>>
//	and steadily decreases as long
//	as you are in Hanging mode.

/*＃｛握力、グリップ｝＃ゲージは君の握力を表していて、
エルードしている間、少しずつ減って
いく。
*/
}


resource TO_エルード３の２__i {
//＊ムービー t //e
オタコン_000: {
Quando l'indicatore della GRIP scende a
zero, non potrai pi&`u rimanere ancorato.
}
//	<<<ENGLISH>>>
//	When the Grip Gauge goes to
//	zero, you won't be able to hold
//	on anymore.
//<ページ数変更>
オタコン_000_1: {
Devi sollevarti prima di cadere.
}
//	<<<ENGLISH>>>
//	You need to hoist yourself
//	up before you fall off.

/*＃｛握力、グリップ｝＃ゲージが無くなったら、つかまっていられなくなって下に落ちてしまう。
そうなる前に這い上がった方がいいね。
*/
}


resource TO_エルード４の１__i {
//＠×か、ホフクか //e
//＊ムービー t //e
オタコン_000: {
Premi il tasto Annulla mentre sei in
Sospensione per saltare dirtto gi&`u.
}
//	<<<ENGLISH>>>
//	Push the Crawl button
//	while Hanging to jump
//	down straight below.

/*エルード中に＃｛×、ホフク｝＃ボタンを押すと、
真下に飛び降りる。
*/
}


resource TO_エルード４の２__i {
//＊ムービー t //e
オタコン_000: {
Se l'altezza di salto &`e eccessiva,
perderai un po' di LIFE.
}
//	<<<ENGLISH>>>
//	If the ground is too far
//	below, you'll lose some
//	LIFE.
//<ページ数変更>
オタコン_000_1: {
In alcuni punti non riusciresti a farcela.
Stai attento.
}
//	<<<ENGLISH>>>
//	In some places, you won't
//	make it at all. Be careful
//	of that.

/*でも高過ぎる所から落ちたら＃｛ＬＩＦＥ、ライフ｝＃が
減るし、場所によっては助からないかも
しれない。気をつけてくれ。
*/

//＠エルード自殺可能？ //e
}//d


//・段差上り（上れる場所近くでも発生）h //e
//＊ムービー t //e
resource TO_段差上り__i {
オタコン_000: {
Se l'altezza arriva circa alla vita, potrai
arrampicarti sugli oggetti usando il tasto
Azione.
}
//	<<<ENGLISH>>>
//	If it's about waist-high, you'll be
//	able to climb up or over things
//	with the Action button.
//<ページ数変更>
オタコン_000_1: {
Tienilo presente.
}
//	<<<ENGLISH>>>
//	Keep that in mind.

/*腰くらいの高さのものなら、
＃｛△、アクション｝＃ボタンを押せばよじ登ることが出来る。
忘れないでくれ。
*/

}//d


//・主観攻撃（左右ステップ、背伸び）h //e
resource TO_主観攻撃１の１__i {
//＊ムービー t //e
オタコン_000: {
Passa alla Visuale Soggettiva con un'arma
selezionata.
}
//	<<<ENGLISH>>>
//	Change to First Person View
//	with a weapon selected.
//<ページ数変更>
オタコン_000_1: {
Poi quando prendi la mira con il tasto Armi
sarai pronto ad attaccare nella Visuale
Soggettiva.
}
//	<<<ENGLISH>>>
//	Once you aim your weapon with
//	the Weapon button, you're ready
//	to attack in First Person View.

/*武器を装備した状態で主観にして、
＃｛□、武器｝＃ボタンで武器を構えれば、
主観攻撃が出来る。
*/
}


resource TO_主観攻撃１の２__i {
//＊ムービー t //e
オタコン_000: {
Usando l'attacco con Visuale Soggettiva
puoi sparare alto o basso.
}
//	<<<ENGLISH(2)>>>
//	Using the First Person Attack
//	allows you to shoot high or low;
//<ページ数変更>
オタコン_000_1: {
Puoi mirare ai piedi o alla testa del
nemico.
}
//	<<<ENGLISH>>>
//	you can aim for the enemy's
//	head or even feet.

/*主観攻撃を使えば、上や下にも撃てるし、
敵の足や頭を狙うことも出来るんだ。
*/
}


resource TO_主観攻撃２の１__i {
//＊ムービー t //e
オタコン_000: {
I tasti L2 e R2 ti lasciano mitragliare a
ventaglio nella Visuale Soggettiva.
}
//	<<<ENGLISH>>>
//	The L2 and R2 buttons let you
//	strafe during First Person Attacks.
//<ページ数変更>
オタコン_000_1: {
Puoi anche acquattarti, usando il tasto
Strisciare.
}
//	<<<ENGLISH>>>
//	You can crouch, too,
//	with the Crawl button.

/*主観攻撃中にもＬ２ボタン、
Ｒ２ボタンで左右ステップしたり、
＃｛×、ホフク｝＃ボタンでしゃがんだり出来る。
*/
}


resource TO_主観攻撃２の２__i {
//＊ムービー t //e
オタコン_000: {
Quando hai imparato tutte le mosse potrai
balzar fuori da un nascondiglio,
}
//	<<<ENGLISH>>>
//	Once you've mastered all the moves,
//	you'll be able to do things like jump
//	out from concealment,
//	
//<ページ数変更>
オタコン_000_1: {
sparare ad un bersaglio e poi sparire
subito dalla visuale del nemico.
}
//	<<<ENGLISH>>>
//	fire at a target, and then drop
//	out of the enemy's view again.

/*うまく使えば、遮蔽物に隠れながら、
相手の隙を見て飛び出して撃って
また隠れるとか出来るはずだ。
*/
}//d

//・銃を構えてゆっくりおろす h //e
resource TO_銃を構えて下ろす１__i {
オタコン_000: {
Puoi prendere la mira con la pistola
usando il tasto Armi,
}
//	<<<ENGLISH>>>
//	You can aim the handgun
//	with the Weapon button,
//<ページ数変更>
オタコン_000_1: {
poi abbassarla senza sparare se rilasci
piano il tasto.
}
//	<<<ENGLISH>>>
//	then lower it without firing
//	if you let go of the button
//	slowly.

/*ハンドガンは＃｛□、武器｝＃ボタンで構えても、
ゆっくり＃｛□、武器｝＃ボタンを離せば
発砲せずに銃を下ろすことが出来る。
*/
}


resource TO_銃を構えて下ろす２__i {
オタコン_000: {
Ti fa risparmiare munizioni e poi potrebbe
esserti utile se disarmi un nemico
puntandogli l'arma contro.
}
//	<<<ENGLISH>>>
//	It saves ammunition, and besides,
//	it could be useful after you've
//	disarmed an enemy at gunpoint.

/*弾を無駄に使わずに済むし、
敵をホールドアップさせた後
なんかでも役立つと思う。
*/

}//d
//＠構え下ろしは拳銃だけ？ //e


//・武器を構えてゆっくりおろす h //e
resource TO_武器を構えて下ろす１__i {
オタコン_000: {
Puoi prendere la mira con un'arma usando
il tasto
}
//	<<<ENGLISH>>>
//	You can aim a weapon with
//	the Weapon button,
//<ページ数変更>
オタコン_000_1: {
Armi e poi abbassarla senza sparare, se
rilasci piano il tasto.
}
//	<<<ENGLISH>>>
//	then lower it without using
//	it if you let go of the button
//	slowly.

/*武器は＃｛□、武器｝＃ボタンで構えても、
ゆっくり＃｛□、武器｝＃ボタンを離せば
攻撃せずに下ろすことが出来る。
*/

}//d
//＠構え下ろしは拳銃だけ？ //e


//・流血で見つかる h //e
//＠敵の血痕に敵は反応しない //e
resource TO_血痕見つかる__i {
オタコン_000: {
Snake, se rimani ferito in un attacco del
nemico, potrebbero catturarti pi&`u
facilmente. 
}
//	<<<ENGLISH>>>
//	Snake, if you sustain damage from
//	enemy attacks, it could increase
//	your chances of capture.
//<ページ数変更>
オタコン_000_1: {
Le macchie di sangue li porterebbero
direttamente a te.
}
//	<<<ENGLISH>>>
//	The bloodstains would
//	lead them right to you.

/*スネークが敵の攻撃を受けたら血が
飛び散る。血の跡が残るからそれが敵に
見つかったら面倒なことになるだろう。
*/

オタコン_001: {
Ecco un altro motivo per cui dovresti
tenerti il pi&`u possibile lontano dai guai.
}
//	<<<ENGLISH>>>
//	That's another reason you should
//	stay away from trouble as much
//	as possible.

/*血を流すようなことは出来るだけ
さけたほうがいい。
*/

}//d


//・止血条件 h //e
//＠流血止血仕様未満？回復は静止？ //e
resource TO_流血止血条件出血状態__i {
//血が出ている時 t //e
オタコン_000: {
Snake, perdi sangue!?
}
//	<<<ENGLISH>>>
//	Snake, are you bleeding!?

/*スネーク、出血してるのかい！？*/
}


resource TO_流血止血条件__i {
オタコン_001: {
Se l'indicatore della LIFE scende
fino alla zona rossa, il sangue non
si fermer&`a.
}
//	<<<ENGLISH>>>
//	If your Life Gauge is down to the
//	point where it's red, the bleeding
//	won't stop.

/*＃｛ＬＩＦＥ、ライフ｝＃ゲージが赤くなるまで減ると
血が止まらなくなるんだ。
*/

オタコン_002: {
Mentre sanguini l'indicatore
della LIFE continua a calare
gradualmente.
}
//	<<<ENGLISH>>>
//	As long as you're bleeding,
//	your Life Gauge will keep
//	dropping gradually.
//<ページ数変更>
オタコン_002_1: {
Inoltre le macchie di sangue potrebbero
mettere il nemico sulle tue tracce.
}
//	<<<ENGLISH>>>
//	Besides that, the bloodstains
//	could put the enemy on your
//	trail.

/*出血してる間は＃｛ＬＩＦＥ、ライフ｝＃も少しずつ
減っていくし、血痕を敵に見つけられて
追跡されるかもしれない。
*/

オタコン_003: {
L'unico modo di fermare una volta per tutte
il sangue &`e di lasciare che il tuo corpo si
riprenda,
}
//	<<<ENGLISH>>>
//	The only way to stop the bleeding
//	for good is to let your body recover
//	until the Life Gauge is green.
//<ページ数変更>
オタコン_003_1: {
fino a quando l'indicatore della LIFE
&`e verde. Il modo migliore &`e usare
le razioni.
}
//	<<<ENGLISH>>>
//	Rations are the best
//	way to do that.

/*完全に血を止めるには＃｛ＬＩＦＥ、ライフ｝＃ゲージが
緑色に戻るまで回復させるしかない。
回復にはレーションが一番いいね。
*/

オタコン_004: {
Cerca di acquattarti o di assumere la
posizione Strisciare e rimanere fermo
finch&'e sanguini.
}
//	<<<ENGLISH>>>
//	Try to crouch down or assume Crawl
//	position and stay still while you're
//	bleeding.
//<ページ数変更>
オタコン_004_1: {
La tua LIFE risale, poco a poco.
}
//	<<<ENGLISH>>>
//	Your LIFE will recover bit by bit.

/*でも出血してる間はしゃがむかホフク
するかして、じっと止まっていれば
少しずつ＃｛ＬＩＦＥ、ライフ｝＃が回復するんだ。
*/

オタコン_005: {
Ti consiglio di rimanere nascosto fino a
quando il sangue non si ferma, se puoi.
}
//	<<<ENGLISH(2)>>>
//	I'd recommend that you stay in
//	hiding until the bleeding stops,
//	if possible.

/*血が止まるまでどこかで隠れているのも
いいかもしれない。
*/
}


resource TO_流血止血条件止血剤__i {
オタコン_000: {
Puoi anche usare la benda in gel per
fermare il sangue, ma solo in casi di
emergenza.
}
//	<<<ENGLISH>>>
//	You can also use the gel bandage
//	to prevent further blood loss, but
//	this is an emergency measure only.
//<ページ数変更>
オタコン_000_1: {
Se deselezioni la benda dal tuo
equipaggiamento corrente, torni daccapo.
Tienilo presente.
}
//	<<<ENGLISH>>>
//	If you deselect it as your current
//	equipment, you're back to square
//	one. Keep that in mind.

/*止血剤を装備すれば血は止まるけど、
あくまで応急処置だ。装備から外したら
また出血してしまう。気をつけてくれ。
*/

//＠流血回復は静止か？ //e
}//d



//・部位ダメージの違い（麻酔の効き方）h //e
resource TO_麻酔効き方__i {
オタコン_000: {
Snake, i proiettili-sonnifero dell'M9 hanno
effetti diversi a seconda di dove
colpiscono.
}
//	<<<ENGLISH>>>
//	Snake, the M9's anaesthetic rounds
//	have different effects depending
//	on where it hits.

/*スネーク、Ｍ９の麻酔弾は、
敵のどこに当たったかによって
効き方が変わってくるんだ。
*/

オタコン_001: {
Se riesci a colpire la testa o la zona del
cuore, il nemico si abbatte subito al suolo.
}
//	<<<ENGLISH(2)>>>
//	If you manage to land them on the
//	head or the heart area, the enemy
//	will go down immediately.
//<ページ数変更>
オタコン_001_1: {
Se colpisci mani o piedi, ci potrebbe voler
tempo prima che il sonnifero faccia effetto.
}
//	<<<ENGLISH>>>
//	If it's hands or feet, it may take
//	a while for the anaesthetic to
//	take effect.

/*頭や心臓に当てれば敵はすぐに倒れるし、
手や足だったら麻酔が効くまで
少し時間がかかる。
*/

オタコン_002: {
Cerca di usare la Visuale Soggettiva per
prendere la mira con pi&`u precisione
}
//	<<<ENGLISH>>>
//	Try using the First Person View
//	to aim with higher accuracy.

/*主観攻撃でよく狙った方がいいね。
*/

}//d



//・転がり h //e
resource TO_飛び込み前転__i {
//＊ムービー t //e
オタコン_000: {
Premi il tasto Strisciare quando stai per
fare una capriola e rotolare in avanti.
}
//	<<<ENGLISH>>>
//	Push the Crawl button as you're
//	running to go into a tumble and
//	a forward roll.

/*走りながら＃｛×、ホフク｝＃ボタンを押すと
飛び込み前転が出来る。
*/

オタコン_001: {
Fanne buon uso - magari quando devi
muoverti rapidamente da un riparo all'altro.
}
//	<<<ENGLISH>>>
//	Make good use of it -- maybe
//	when you need to move from
//	cover to cover quickly?

/*物陰から物陰に素早く移動したりする
時とかにうまく使ってくれ。
*/

}//d


//・そろそろ歩き h //e
resource TO_そろそろ歩き__i {
オタコン_000: {
Se inclini meno la levetta analogica
sinistra potrai camminare pi&`u lentamente
e facendo meno rumore.
}
//	<<<ENGLISH>>>
//	If you tilt the left analog stick at
//	a smaller angle, you'll be able to
//	walk more slowly and stealthily.

/*左スティックの倒し具合を少しにすれば、
忍び足で歩ける。
*/

オタコン_001: {
La velocit&`a non &`e tutto. Cerca di muoverti
sulle superfici che fanno rumore.
}
//	<<<ENGLISH>>>
//	Speed isn't everything.
//	Try moving over noisy
//	surfaces this way.

/*移動速度は遅くなるけど足音が
しないから、歩くと音が鳴ってしまう
床の上では役に立つはずだ。
*/

}//d


//・死体は隠さなければいけない h //e
resource TO_死体隠せ__i {
オタコン_000: {
Snake, non basta eliminare nemici e
lasciarli in giro. &`E una pessima idea.
}
//	<<<ENGLISH>>>
//	Snake, don't just take out enemies
//	and leave them there. That's a bad
//	idea.

/*スネーク、敵を倒してもそれだけで
安心しちゃダメだ。倒した敵を
そのままにしておくのはマズイ。
*/

オタコン_001: {
Se il nemico trova i compagni morti,
probabilmente le sentinelle daranno
l'allarme.
}
//	<<<ENGLISH>>>
//	Finding their dead friends on
//	the ground will probably make
//	sentries raise an alarm.

/*倒れた仲間を敵が見つけたら、
当然警戒態勢を強化するはずだからね。
*/

オタコン_002: {
Quando hai eliminato qualcuno, nascondi
bene il corpo.
}
//	<<<ENGLISH>>>
//	Once you've dealt with someone, put
//	the body somewhere out of sight.

/*倒した敵の体はどこか人目につかない
場所に隠した方がいい。
*/

}//d


//・死体引きずり方法 h //e
resource TO_死体引きずり方法１__i {
オタコン_000: {
Puoi spostare il corpo di un nemico
trascinandolo.
}
//	<<<ENGLISH>>>
//	Bodies can be moved to
//	another location by dragging.

/*倒れた敵は引きずって
移動させることが出来るんだ。
*/
}


resource TO_死体引きずり方法２__i {
//＊ムービー t //e
オタコン_000: {
Innanzitutto controlla di non aver
selezionato armi, poi premi il tasto Armi
vicino al corpo per prenderlo.
}
//	<<<ENGLISH>>>
//	First, make sure no weapon is
//	selected. Then push the Weapon
//	button near the body to grab it.

/*やり方は、倒れた敵の体の近くで、
武器を装備せずに＃｛□、武器｝＃ボタンを押せば、
敵の体を抱える。
*/

オタコン_001: {
Se mantieni la presa sul corpo potrai
trascinarlo.
}
//	<<<ENGLISH>>>
//	As long as you have a hold on the
//	body, you'll be able to drag it.
//<ページ数変更>
オタコン_001_1: {
Quando hai finito, rilascia il tasto Armi.
}
//	<<<ENGLISH>>>
//	Let go of the Weapon
//	button when you're done.

/*これで＃｛□、武器｝＃ボタンを押している間、
敵を引きずることが出来る。
離す時は＃｛□、武器｝＃ボタンを離せばいい。
*/
}

resource TO_死体引きずり方法３__i {
オタコン_000: {
Non &`e una buona idea lasciare in giro i
nemici caduti.
}
//	<<<ENGLISH>>>
//	It's a bad idea to leave enemies
//	where they've fallen.
//<ページ数変更>
オタコン_000_1: {
Nascondi i loro corpi cos&`i nessuno li vede.
}
//	<<<ENGLISH>>>
//	Hide the bodies to make
//	sure no one sees them.

/*倒した敵をそのままにしておくのは
マズイからね。人目につかない場所に
隠すんだ。
*/

}//d



//・死体硬直 h //e
resource TO_死体硬直１__i {
オタコン_000: {
Ti consiglio di nascondere il corpo dei
nemici non appena li hai messi k.o.
}
//	<<<ENGLISH>>>
//	I recommend you hide the enemy's
//	body as soon as you've taken them
//	down.

/*スネーク、倒した敵の体は
すぐ隠すようにした方が良い。
*/
}

/*<vc014502>*/
resource TO_死体硬直２__i {
オタコン_000: {
Se sono solo sedati o svenuti, prima o poi
i nemici si risveglieranno.
}
//	<<<ENGLISH>>>
//	The tranquilized and unconscious
//	enemies will wake up sooner or
//	later.
//<ページ数変更>
オタコン_000_1: {
Nel caso dei soldati uccisi, in breve
tempo il loro corpo diventer&`a troppo
rigido per poterli spostare.
}
//	<<<ENGLISH>>>
//	As for soldiers you've killed,
//	the body will become too stiff
//	to move in a short while.

/*眠ったり気絶したりしてる敵はすぐに
起き上がってくるし、そうでない敵も
しばらくすると硬直して動かせなくなる。
*/

オタコン_001: {
Tienilo presente.
}
//	<<<ENGLISH(2)>>>
//	Keep that in mind.

/*注意してくれ。*/
}//d


//・ロッカー死体隠し h //e
resource TO_死体ロッカー隠し__i {
//＊ムービー t //e
オタコン_000: {
Puoi anche nascondere il corpo di un
nemico in un armadietto.
}
//	<<<ENGLISH>>>
//	You can also hide the
//	enemy's body in a locker.

/*ロッカーの中に倒した敵の体を
隠すことも出来る。
*/

オタコン_001: {
Devi solo aprire lo sportello e trascinare il
corpo nell'armadietto.
}
//	<<<ENGLISH>>>
//	All you have to do is open the
//	locker and drag the body there.

/*やり方はロッカーを開けて、
そこまで敵の体を引きずっていけばいい。
*/

}//d

//・部位ダメージの違い（銃弾） h //e
resource TO_部位ダメージ銃１__i {
オタコン_000: {
Le munizioni della pistola e le altre
munizioni hanno effetti diversi a seconda di
dove colpiscono.
}
//	<<<ENGLISH>>>
//	The handgun ammunition and other
//	live rounds have different effects
//	depending on where the bullet hits.

/*ハンドガンとかの弾は、
敵の体のどこに当たるかによって、
与えるダメージが違うんだ。
*/

オタコン_001: {
Se colpisci un nemico alla mano, la
renderai inutilizzabile,
}
//	<<<ENGLISH>>>
//	If you hit the hand, the enemy
//	won't be able to use it,
//<ページ数変更>
オタコン_001_1: {
mentre se miri alla gamba il nemico perde
la mobilit&`a.
}
//	<<<ENGLISH>>>
//	and a round to the leg and feet
//	will take away their mobility.
//<ページ数変更>
オタコン_001_2: {
Se riesci a colpire la testa o l'area del
cuore, lo abbatti immediatamente.
}
//	<<<ENGLISH(2)>>>
//	If you manage to land them on the
//	head or the heart area, the enemy
//	will go down immediately.

/*手を撃てば敵は手が使えなくなるし、
足を撃てば歩けなくなる。
頭や心臓を狙えば一発で倒せるよ。
*/
}

resource TO_部位ダメージ銃２__i {
オタコン_000: {
Distruggi la radio che portano sul fianco
destro, cos&`i non possono chiedere rinforzi.
}
//	<<<ENGLISH>>>
//	Destroy the radio on their right
//	hip, to the back, to prevent the
//	enemy from calling for backup.
//<ページ数変更>
オタコン_000_1: {
Per prendere la mira in modo preciso, usa
la Visuale Soggettiva.
}
//	<<<ENGLISH>>>
//	Use the First Person View when
//	you need to aim accurately.

/*腰の右後ろにある無線機を撃って壊せば、
敵が応援を呼ぶのを防ぐことも出来る。
状況に応じて、主観攻撃でよく狙うんだ。
*/
}//d


//・ビハインド覗き、ＬＲ移動 h //e
resource TO_ビハインド覗き__i {
//＊ムービー t //e
オタコン_000: {
Premi il tasto L2 o R2 nella Visuale
Angolare per spostare la testa e dare una
rapida occhiata in quella direzione.
}
//	<<<ENGLISH>>>
//	Push the L2 or R2 button while in
//	Corner View to move your head and
//	take a quick look in that direction.

/*ビハインドの時にＬ２ボタンもしくは
Ｒ２ボタンを押すと物陰から頭を出して
その方向を覗き込むことが出来る。
*/

オタコン_001: {
Potrai vedere pi&`u lontano nella Visuale
Angolare, ma rischierai maggiormente di
venire scoperto.
}
//	<<<ENGLISH>>>
//	You'll be able to see farther in
//	Corner View, but there's a greater
//	chance of being discovered.
//<ページ数変更>
オタコン_001_1: {
Tienilo presente.
}
//	<<<ENGLISH(2)>>>
//	Keep that in mind.

/*ビハインドするより遠くまで見えるけど、
頭を出すから敵に見つかりやすくなる。
そこは気をつけてくれ。
*/

}//d

//・ビハインド飛び出し（立ったまま、座ったまま） h //e
resource TO_ビハインド飛び出し１__i {
//＊ムービー t //e
オタコン_000: {
Se hai selezionato un'arma mentre sei
nella Visuale Angolare,
}
//	<<<ENGLISH>>>
//	If you have a weapon selected
//	while in Corner View,
//<ページ数変更>
オタコン_000_1: {
premi il tasto Armi per balzar fuori dal
nascondiglio e prendere la mira.
}
//	<<<ENGLISH>>>
//	push the Weapon button to jump
//	out of concealment and aim your
//	weapon.

/*武器を装備してビハインドしている時に
＃｛□、武器｝＃ボタンを押すと、物陰から素早く
飛び出して武器を構えることが出来る。
*/
}


resource TO_ビハインド飛び出し２__i {
//＊ムービー t //e
オタコン_000: {
Puoi usarlo mentre sei in piedi oppure
acquattato. Ti dovrebbe aiutare negli
scontri a fuoco.
}
//	<<<ENGLISH>>>
//	You can use this while you're
//	standing or crouching. It should
//	help during gunfights.

/*立ったままでも、しゃがんだ状態でも
可能だ。銃撃戦の時にうまく使ってくれ。
*/

}//d

//・ビハインド中右スティック h //e
resource TO_ビハインド中右スティック__i {
//＊ムービー t //e
オタコン_000: {
Muovi la levetta analogica destra nella
Visuale Angolare per guardare in quella
direzione.
}
//	<<<ENGLISH>>>
//	Move the right analog stick
//	while in Corner View to look
//	in that direction.

/*ビハインド中に右スティックを動かせば
その方向を伺うことが出来る。
*/

オタコン_001: {
La differenza fra questo e i tasti L2 e R2
}
//	<<<ENGLISH(2)>>>
//	The difference between this
//	and using L2 and R2 buttons
//<ページ数変更>
オタコン_001_1: {
&`e che non ti esporrai al fuoco del nemico.
}
//	<<<ENGLISH>>>
//	is that you won't be exposing
//	yourself to possible enemy fire.
//<ページ数変更>
オタコン_001_2: {
Ma,allo stesso tempo,
il tuo campo visivo
}
//	<<<ENGLISH>>>
//	At the same time, because
//	you are staying in the same
//	position,
//<ページ数変更>
オタコン_001_3: {
Sar&`a pi&`u ristretto.
}
//	<<<ENGLISH>>>
//	your range of vision
//	is more limited.

/*Ｌ２ボタン、Ｒ２ボタンの覗き込みと
違って体を乗り出さないぶん安全だ。
見える範囲は少なくなるけどね。
*/

}//d

//・影が見つかること h //e
resource TO_影伸び１__i {
//＊ムービー t //e
オタコン_000: {
Snake, in alcune posizioni l'illuminazione
allunga la tua ombra e la rende pi&`u visibile.
}
//	<<<ENGLISH>>>
//	Snake, in some locations, the
//	lighting makes your shadow
//	longer and more noticeable.

/*スネーク、照明の具合によっては
影が大きく伸びてしまう場所がある。
そういう所では、影にも注意してくれ。
*/
}


resource TO_影伸び２__i {
オタコン_000: {
Il nemico potrebbe vedere la tua ombra,
quindi fai attenzione
}
//	<<<ENGLISH>>>
//	The enemy might spot your shadow,
//	so you'll want to watch out.
//<ページ数変更>
オタコン_000_1: {
Curve e angoli sono particolarmente
pericolosi.
}
//	<<<ENGLISH>>>
//	Turns and corners are
//	especially dangerous.

/*伸びた影を敵に見つけられてしまう
ことがあるかもしれないからね。
特に曲がり角では気をつけた方が良い。
*/

オタコン_001: {
Ma lo stesso vale per i nemici. Se scopri la
loro ombra davanti a te puoi evitare rischi
inutili.
}
//	<<<ENGLISH>>>
//	But the same holds for the enemy.
//	If you spot someone's shadow ahead,
//	you can avoid unnecessary risks.

/*でも、敵の影も同じように伸びるから、
人影を見つけたら近づかないように
すれば無用な危険をさけられるはずだ。
*/

}//d

//・不審物で見つかる（壊れ物） h //e
resource TO_不審物__i {
//＊ムービー t //e
オタコン_000: {
Non rompere niente se puoi. Qualunque
segno di infiltrazione allerterebbe il nemico.
}
//	<<<ENGLISH>>>
//	Don't break things if you can help
//	it. Any sign of infiltration will
//	put the enemy on a lookout.
//<ページ数変更>
オタコン_000_1: {
Usa molta cautela.
}
//	<<<ENGLISH>>>
//	Exercise caution.

/*物はあまり壊したりしない方がいい。
潜入の痕跡を発見されると、当然敵に
警戒されるからね。気をつけてくれ。
*/

}//d


//・探索モード h //e
resource TO_探索モード__i {
オタコン_000: {
Anche se hai depistato il nemico,
}
//	<<<ENGLISH>>>
//	Even if you've successfully thrown
//	the enemy off your trail,
//<ページ数変更>
オタコン_000_1: {
non abbassare mai la guardia una volta
che ti hanno individuato.
}
//	<<<ENGLISH>>>
//	don't ever relax your guard
//	once you've been spotted.

/*一度見つかったら、例え逃げ切っても
安心しちゃダメだ。
*/

オタコン_001: {
Continueranno a cercarti e potenzieranno
la sicurezza.
}
//	<<<ENGLISH>>>
//	They'll be looking for you,
//	and security will be tighter.
//<ページ数変更>
オタコン_001_1: {
Non sottovalutare chi ti sta contro.
}
//	<<<ENGLISH>>>
//	Don't underestimate what
//	you're up against.

/*敵は君を探して警戒を強化するはず
だからね。注意してくれ。
*/
//＠探索モード仕様 //e

}//d

//・クリアリング（初クリアリングは強制ＣＡＬＬ？） h //e
resource TO_クリアリング１__i {
//ＣＡＬＬ時 t //e
オタコン_000: {
Snake, sparisci in fretta! Stanno arrivando
pattuglie nemiche di perlustrazione. &`E
un'operazione di Pulizia.
}
//	<<<ENGLISH>>>
//	Snake, get yourself out of sight
//	now! Enemy search parties are
//	on the way. It's a Clearing.

/*スネーク、早くどこかに隠れるんだ！
敵は君を徹底的に探し出そうとしてる。
クリアリングだ。
*/
}


resource TO_クリアリング２__i {
オタコン_000: {
Queste non sono sentinelle:
}
//	<<<ENGLISH>>>
//	These aren't sentries
//	you're dealing with;
//<ページ数変更>
オタコン_000_1: {
cercano proprio te e sanno che tu non vuoi
farti trovare.
}
//	<<<ENGLISH>>>
//	they're searching for you, and they
//	know you don't want to be found.

/*敵が呼んだ増援部隊は一度侵入者を
見失っても簡単にはあきらめない。君が
隠れていそうな場所まで探しに来るんだ。
*/

オタコン_001: {
Non puoi tentare di nasconderti
cosi come capita.
}
//	<<<ENGLISH>>>
//	You can't make some feeble
//	attempt at concealment.
//<ページ数変更>
オタコン_001_1: {
Controlla di essere totalmente nascosto in
un punto in cui non penserebbero di
cercarti.
}
//	<<<ENGLISH>>>
//	Make sure you're completely hidden
//	in some place they wouldn't think
//	of searching.

/*中途半端な隠れ方じゃ見つかってしまう。
どこか見つかりにくい場所に
身を隠すんだ。いいね。
*/
//＠クリアリング仕様。見つかる条件。 //e

}//d


//・銃撃戦の戦い方 h //e
resource TO_銃撃戦１__i {
オタコン_000: {
Se vieni individuato e si arriva allo scontro
a fuoco, non rimanere esposto.
}
//	<<<ENGLISH>>>
//	If you're spotted and it comes
//	down to an exchange of gunfire,
//<ページ数変更>
オタコン_000_1: {
Trovati SUBITO una copertura.
}
//	<<<ENGLISH>>>
//	don't stand out in the
//	open. Find cover ASAP.

/*万一、敵に見つかって銃撃戦になったら
遮蔽物に隠れながら戦うんだ。無防備に
体をさらしてはいけない。
*/
}


//＊ムービー t //e
resource TO_銃撃戦２__i {
オタコン_000: {
Mitraglia a ventaglio e allungati dalla
posizione nascosta per prendere bene la
mira,
}
//	<<<ENGLISH>>>
//	Strafe and stretch up from your
//	concealed position to get a good
//	shot on target
//<ページ数変更>
オタコン_000_1: {
nella Visuale Soggettiva.
}
//	<<<ENGLISH>>>
//	while in First Person View.

/*隠れながら左右ステップや伸び上がりを
使って主観攻撃で応戦してくれ。
*/

オタコン_001: {
Ma se arrivano a frotte, neppure tu
riuscirai a tenerli a bada.
}
//	<<<ENGLISH>>>
//	But if they come at you in droves,
//	even you won't be able to fend
//	them off.
//<ページ数変更>
オタコン_001_1: {
Devi evitare a tutti i costi che ti scoprano.
}
//	<<<ENGLISH>>>
//	You need to avoid
//	discovery at all costs.

/*でも一度に大勢で来られたら、
いくら君でも太刀打ち出来ないだろう。
見つからないのが一番だからね。
*/

}//d


//・敵の無線連絡 h //e
resource TO_敵の無線連絡１__i {
//＊ムービー
オタコン_000: {
Non appena un soldato nemico ti vede,
chiamer&`a rinforzi usando la radio.
}
//	<<<ENGLISH>>>
//	As soon as you're spotted by
//	an enemy soldier, he'll call for
//	backup on his radio.
//<ページ数変更>
オタコン_000_1: {
E questi rinforzi, ti assicuro, sono ossi
molto duri.
}
//	<<<ENGLISH>>>
//	The search party that's going to
//	show up as a result is a tough
//	bunch.

/*敵は君を見つけると無線で仲間を呼ぶ。
それでやって来る増援部隊はかなり
手強いはずだ。
*/
}


resource TO_敵の無線連絡２__i {
//＊ムービー t //e
オタコン_000: {
Prima di tutto sono meglio equipaggiati,
per esempio hanno corazze antiproiettili.
}
//	<<<ENGLISH>>>
//	For one thing, they have better
//	equipment, like body armor.
//<ページ数変更>
オタコン_000_1: {
Ma in particolare sono addestratissimi
nelle missioni di ricerca e distruzione.
}
//	<<<ENGLISH>>>
//	But the main thing is that they're
//	highly trained in search-and-
//	destroy types of activities.

/*＃｛防弾衣、ボディ・アーマー｝＃とか、一般の兵士よりも
上の装備も持ってるし、何より彼らは
戦闘馴れしている。
*/

オタコン_001: {
Arriveranno ed attaccheranno in gruppo.
Non cercare di affrontarli direttamente.
}
//	<<<ENGLISH>>>
//	They'll come as a team and attack
//	as a team. Don't try to take them
//	straight on.

/*チームで攻撃してくるから、
いくら君でも一人でまともに
やりあうのは危ないと思う。
*/
}


resource TO_敵の無線連絡３の１__i {
オタコン_000: {
Se una sentinella ti vede, devi impedirle di
chiamare rinforzi.
}
//	<<<ENGLISH>>>
//	If you're spotted, you need to stop
//	the sentry from calling for backup.

/*万一敵に見つかったら、
仲間を呼ばれないようにした方が良いね。
*/
}


resource TO_敵の無線連絡３の２__i {
オタコン_000: {
Mettila k.o. prima che abbia il tempo di
usare la radio.
}
//	<<<ENGLISH>>>
//	Take him down before he has
//	the chance to use the radio.

/*無線で仲間を呼ぶ前にその敵を倒せば、
増援部隊とは戦わずに済むはずだ。
*/
}



resource TO_敵の無線連絡４__i {
オタコン_000: {
Puoi anche usare la granata chaff antiradar
ed interferire con la trasmissione del
messaggio,
}
//	<<<ENGLISH>>>
//	You can also break out the chaff
//	grenade and interfere with the
//	message transmission
//<ページ数変更>
オタコン_000_1: {
impedendo che dia l'allarme.
}
//	<<<ENGLISH>>>
//	to prevent any alerts
//	from being issued.

/*チャフ・グレネードを使って無線を
妨害しても、敵が応援を呼ぶのを
防げる。
*/
}


resource TO_敵の無線連絡５__i {
//＊ムービー t //e
オタコン_000: {
Se metti fuori uso la radio, la sentinella
non ha modo di chiedere aiuto.
}
//	<<<ENGLISH>>>
//	If you take out the radio,
//	the sentry will have no way
//	of calling for help.

/*無線機を壊せば敵は応援を呼べなくなる
はずだ。
*/

オタコン_001: {
Le sentinelle portano la radio dietro il
fianco destro. Dovresti riuscire a prendere
la mira nella Visuale Soggettiva.
}
//	<<<ENGLISH>>>
//	Radios are worn behind the right
//	hip. You should be able to target
//	it in First Person View.

/*敵は無線機を腰の右後ろにつけてる。
主観攻撃で狙えば撃ち抜けるだろう。
*/
}


resource TO_敵の無線連絡６__i {
オタコン_000: {
Se la sentinella riesce a chiamare rinforzi,
corri subito a nasconderti prima che
arrivino, e scegli un nascondiglio sicuro.
}
//	<<<ENGLISH>>>
//	If he does manage to call for backup,
//	get yourself in deep hiding before
//	they arrive.

/*もしも仲間を呼ばれてしまったら、
増援部隊が到着する前に隠れた方が
いいね。
*/

}//d


//・増援部隊強い h //e
resource TO_増援部隊__i {
オタコン_000: {
I rinforzi sono tutti corazzati.
}
//	<<<ENGLISH>>>
//	The reinforcements are
//	all wearing body armor.
//<ページ数変更>
オタコン_000_1: {
Ci vorranno molti proiettili prima di poter
penetrare la corazza e colpire le parti pi&`u
vulnerabili.
}
//	<<<ENGLISH>>>
//	It'll take several shots before
//	the rounds do any damage to
//	the protected regions of the body.

/*敵の増援部隊は＃｛防弾衣、ボディ・アーマー｝＃を着てる。
＃｛防弾衣、ボディ・アーマー｝＃で守られてる部分は何発か当て
なければダメージを与えられないんだ。
*/

オタコン_001: {
Ma per la testa basta un solo colpo andato
a segno. Mira con precisione mentre
attacchi nella Visuale Soggettiva.
}
//	<<<ENGLISH>>>
//	But only a single head shot
//	is needed. Aim well while
//	attacking in First Person View.

/*でも頭を狙えば一発だ。
主観攻撃で頭を狙ってくれ。
*/

}//d


//・ヒドゥンポイントの説明 h //e
resource TO_ヒドゥンポイント__i {
オタコン_000: {
Al buio potrai passare meglio inosservato.
}
//	<<<ENGLISH>>>
//	You'll be less likely to
//	be spotted in the dark.
//<ページ数変更>
オタコン_000_1: {
Questo per&`o non funziona durante una
Pulizia e ti consiglio di provare un altro
modo.
}
//	<<<ENGLISH>>>
//	But this won't work during
//	a Clearing, so I recommend
//	you try something else.

/*暗がりにいれば、敵も君を見つけにくい
はずだ。でもクリアリングの時は
見つかってしまうから気をつけてくれよ。
*/
//＠ヒドゥンって暗いところで見つかる？ //e
}
/**/


//・マガジン投げ(持ってる時のみ) h //e
resource TO_マガジン投げ__i {
//＊ムービー t //e
オタコン_000: {
Seleziona il caricatore e lancialo con il
tasto Armi.
}
//	<<<ENGLISH>>>
//	Select the magazine and throw
//	it using the Weapon button.
//<ページ数変更>
オタコン_000_1: {
Il rumore attirer&`a i soldati verso il punto di
atterraggio del caricatore.
}
//	<<<ENGLISH(2)>>>
//	The noise will draw enemy
//	soldiers toward wherever
//	the magazine lands.

/*マガジンは装備して＃｛□、武器｝＃ボタンで
投げられるんだ。マガジンが床に落ちた
時の音で敵をおびき寄せたり出来る。
*/

オタコン_001: {
Pi&`u forte premi il tasto e maggiore sar&`a la
distanza di tiro.
}
//	<<<ENGLISH(2)>>>
//	How strong you push the button
//	determines how large a swing
//	you take.
//<ページ数変更>
オタコン_001_1: {
Prendi la mira nella Visuale Soggettiva per
gettare il caricatore e allontanare da te il
nemico.
}
//	<<<ENGLISH>>>
//	Take aim using First Person View
//	and try to land it where it will lure
//	the enemy away.

/*＃｛□、武器｝＃ボタンを押す強さで投擲距離が変わる。
主観攻撃で狙って、うまく敵を誘導
出来るポイントへ落とすんだ。
*/

}//d

resource TO_ホールドアップ__i {
//＊ムービー t //e
オタコン_000: {
Puoi fermare qualcuno puntandogli contro
l'arma. Basta prenderlo alle spalle quando
hai l'arma pronta.
}
//	<<<ENGLISH(2)>>>
//	You can hold someone at gunpoint
//	by getting behind his back with your
//	gun ready.
//<ページ数変更>
オタコン_000_1: {
Poi sta a te decidere cosa fare di un
ostaggio che non oppone resistenza.
}
//	<<<ENGLISH>>>
//	What you choose to do with a
//	hostage making no resistance
//	after that is up to you.

/*敵の後ろから銃を突き付ければ、敵を
ホールドアップさせられる。その後、
無抵抗の相手をどうするかは君次第だ。
*/
}//d


//・懸垂で握力アップ後 ＣＡＬＬ？ h //e
resource TO_懸垂握力アップ後__i {
オタコン_000: {
Congratulazioni, Snake! Valeva la pena
fare tutta quella ginnastica. Ora la tua
forza di presa &`e aumentata!
}
//	<<<ENGLISH>>>
//	Congrats, Snake! Looks like those
//	pull-ups were worth it. Your grip
//	strength is up!

/*スネーク、おめでとう！
懸垂で体を鍛えた甲斐があったね。
握力が上がったよ！！
*/

}//d




//○前からある仕様 d //e
//・武器・アイテム装備方法 d //e
resource TO_武器装備品装備法１__i {
オタコン_000: {
Quando devi armarti, premi il tasto R2 per
passare alla modalit&`a Armi.
}
//	<<<ENGLISH>>>
//	When you need to arm yourself with
//	a weapon, push down on the R2
//	button to enter the Weapon mode.

/*武器を装備するには、まず、
Ｒ２ボタンを押しっぱなしにして
武器モードにするんだ。
*/

オタコン_001: {
Vedi le icone delle armi?
}
//	<<<ENGLISH(2)>>>
//	You see those weapon icons?
//<ページ数変更>
オタコン_001_1: {
Scegline una muovendo in su e in gi&`u
la levetta analogica sinistra
}
//	<<<ENGLISH(2)>>>
//	Select the one you want by moving
//	the left analog stick up and down...
//<ページ数変更>
オタコン_001_2: {
ed abbinando l'icona al punto in basso a
destra.
}
//	<<<ENGLISH(2)>>>
//	and matching up the icon
//	to the lower right spot.

/*武器のアイコンが表示されるだろ。
その中から使いたい武器を左スティック
の上下で選んで右下に合わせるんだ。
*/

オタコン_002: {
Se hai diverse armi dello stesso tipo, lo
schermo le mostra in fila.
}
//	<<<ENGLISH>>>
//	If you have several weapons
//	of the same type, they'll be
//	displayed in a row.

/*同じ系統の武器をいくつか持っている
時はアイコンが横に並んで表示される。
*/

オタコン_003: {
Scegli quella che vuoi muovendo a destra
e a sinistra la levetta analogica
sinistra
}
//	<<<ENGLISH>>>
//	Select the one you want by
//	moving the left analog stick
//	right and left
//<ページ数変更>
オタコン_003_1: {
e collocando l'icona sul punto all'estrema
destra.
}
//	<<<ENGLISH>>>
//	and placing the icon
//	to the far right spot.

/*その中から使いたい武器を
左スティックの左右で一番右に
合わせてくれ。
*/

オタコン_004: {
Poi rilascia il tasto R2 per equipaggiarti
con l'arma.
}
//	<<<ENGLISH(2)>>>
//	Then let go of the R2 button to
//	arm yourself with the weapon.

/*そこでＲ２ボタンを離せば、
その武器を装備出来るってわけさ。
*/

オタコン_005: {
Se vuoi conoscere le caratteristiche
precise per l'uso di ciascuna delle armi,
}
//	<<<ENGLISH(2)>>>
//	If you need to know the finer points
//	of using each of the weapons,
//<ページ数変更>
オタコン_005_1: {
osserva la finestra di guida.
}
//	<<<ENGLISH(2)>>>
//	just take a look at the
//	guidance window.

/*それぞれの武器の詳しい使い方は
ウィンドウの中の説明を読んでくれ。
*/
}


resource TO_武器装備品装備法２__i {
オタコン_000: {
Se ti occorre selezionare oggetti come le
razioni,
}
//	<<<ENGLISH(2)>>>
//	If it's items, like rations,
//	that you need to select,
//<ページ数変更>
オタコン_000_1: {
usa la stessa procedura ma con il tasto L2.
}
//	<<<ENGLISH(2)>>>
//	just follow the same procedure,
//	but with the L2 button.

/*レーションとかの装備品を
装備したい時はＬ２ボタンで
同じことをすればいい。
*/

}//d

resource TO_武器装備品装備法従来型１__i {
オタコン_000: {
Quando devi equipaggiarti con un'arma,
tieni premuto il tasto R2 per passare alla
modalit&`a Armi.
}
//	<<<ENGLISH>>>
//	When you need to arm yourself with
//	a weapon, hold down on the R2 button
//	to enter the Weapon mode.

/*武器を装備するには、まず、
Ｒ２ボタンを押しっぱなしにして
武器モードにするんだ。
*/

オタコン_001: {
Vedi le icone delle armi?
}
//	<<<ENGLISH(2)>>>
//	You see those weapon icons?
//<ページ数変更>
オタコン_001_1: {
Scegline una muovendo in su e in gi&`u
la levetta analogica sinistra
}
//	<<<ENGLISH(2)>>>
//	Select the one you want by moving
//	the left analog stick up and down...
//<ページ数変更>
オタコン_001_2: {
ed abbinando l'icona al punto in basso a
destra.
}
//	<<<ENGLISH>>>
//	and matching up the icon
//	to the lower right spot.

/*武器のアイコンが表示されるだろ。
その中から使いたい武器を左スティック
の上下で選んで右下に合わせるんだ。
*/

オタコン_002: {
Poi rilascia il tasto R2 per equipaggiarti
con l'arma.
}
//	<<<ENGLISH(2)>>>
//	Then let go of the R2 button to
//	arm yourself with the weapon.

/*そこでＲ２ボタンを離せば、
その武器を装備出来るってわけさ。
*/

オタコン_003: {
Se vuoi conoscere le caratteristiche
precise per l'uso di ciascuna delle armi,
}
//	<<<ENGLISH(2)>>>
//	If you need to know the finer points
//	of using each of the weapons,
//<ページ数変更>
オタコン_003_1: {
osserva la finestra di guida.
}
//	<<<ENGLISH(2)>>>
//	just take a look at the
//	guidance window.

/*それぞれの武器の詳しい使い方は
ウィンドウの中の説明を読んでくれ。
*/

}
/**/

resource TO_武器装備品装備法従来型２__i {
オタコン_000: {
Se ti occorre selezionare oggetti come le
razioni,
}
//	<<<ENGLISH(2)>>>
//	If it's items like rations
//	that you need to select,
//<ページ数変更>
オタコン_000_1: {
usa la stessa procedura ma con il tasto L2.
}
//	<<<ENGLISH(2)>>>
//	just follow the same procedure,
//	but with the L2 button.

/*レーションとかの装備品を
装備したい時はＬ２ボタンで
同じことをすればいい。
*/

}


//・無線ＣＡＬＬ。一度も任意ＣＡＬＬ受信していない時 h //e
resource TO_無線ＣＡＬＬ__i {
オタコン_000: {
Snake, quando ho un messaggio
importante per te ti chiamer&`o col CODEC.
}
//	<<<ENGLISH>>>
//	Snake, when I have something
//	urgent to tell you, I'll raise you
//	on the Codec.

/*スネーク、僕の方から緊急に伝えたい
ことがある場合はＣＡＬＬする。
*/

オタコン_001: {
Quando vedi il simbolo CALL, premi
il tasto SELECT per ricevere, va bene?
}
//	<<<ENGLISH>>>
//	When you see the CALL sign, hit
//	the SELECT button to receive,
//	all right?

/*ＣＡＬＬサインが出たら、
ＳＥＬＥＣＴボタンを押して
受信するんだ。いいね。
*/

}//d


//・パンチ・キック h //e
resource TO_パンチキック__i {
//＊ムービー t //e
オタコン_000: {
Snake, quando ti avvicini abbastanza per il
Combattimento corpo a corpo, dimenticati
le armi.
}
//	<<<ENGLISH(2)>>>
//	Snake, once you get close enough
//	for Close Quarters Combat, forget
//	the weapons.
//<ページ数変更>
オタコン_000_1: {
Premi il tasto Pugno per colpire: i pugni
sono un modo efficace per mettere k.o. il
nemico senza rumore.
}
//	<<<ENGLISH>>>
//	Push the Punch button to take
//	a swing; punching is an effective,
//	noiseless way to take out enemies.

/*スネーク、接近戦になったら格闘だ。
＃｛○、パンチ｝＃ボタンでパンチが出せる。
音を立てずに攻撃出来るはずだ。
*/

オタコン_001: {
Premi ripetutamente il tasto Pugno per
sferrare attacchi combinati e darle sode.
}
//	<<<ENGLISH>>>
//	Hit the Punch button repeatedly to
//	unleash combo attacks and pummel
//	the enemy.
//<ページ数変更>
オタコン_001_1: {
Puoi anche usare la Visuale Soggettiva.
}
//	<<<ENGLISH(2)>>>
//	You can also use the
//	First Person View.

/*＃｛○、パンチ｝＃ボタンを連打すれば＃｛連続技、コンボ｝＃になって
敵を吹き飛ばせるし、主観攻撃も出来る。
*/

オタコン_002: {
Certo, il favore pi&`u grosso che puoi farti &`e
schivare totalmente le situazioni di questo
tipo.
}
//	<<<ENGLISH>>>
//	Of course, the biggest favor you
//	can do yourself is to avoid getting
//	in melee situations altogether.

/*でも一番いいのは、接近戦になるような
局面はさけることだ。
*/

}//d

//・投げ h //e
resource TO_投げ__i {
//＊ムービー t //e
オタコン_000: {
Se non hai selezionato armi
}
//	<<<ENGLISH>>>
//	As long as you have
//	no weapons selected,
//<ページ数変更>
オタコン_000_1: {
potrai lanciare un nemico usando il tasto
Armi e la levetta analogica sinistra.
}
//	<<<ENGLISH>>>
//	you can throw an enemy with
//	the Weapon button and the left
//	analog stick.
//<ページ数変更>
オタコン_000_2: {
Basta che ti avvicini e poi premi insieme
quei comandi.
}
//	<<<ENGLISH>>>
//	Just get in close and hit these
//	controls at the same time. 

/*武器を装備していない時は投げ技が使え
る。やり方は敵の近くで左スティックを
入れながら＃｛□、武器｝＃ボタンを押せばいい。
*/

オタコン_001: {
Cosi il nemico sar&`a atterrato e forse
riuscirai persino a tramortirlo.
}
//	They'll be down on the ground
//	afterwards, and you may even
//	able to knock them unconscious.

/*敵を地面に倒せるし、うまくすれば
気絶させることも出来るはずだ。
*/

}//d


//・首絞め h //e
resource TO_首締め１__i {
//＊ムービー t //e
オタコン_000: {
L'altra opzione di attacco quando sei
disarmato &`e la presa con strangolamento.
}
//	<<<ENGLISH>>>
//	The other attack option when
//	you're unarmed is the chokehold.

/*スネーク、武器を装備していない時は、
投げ技の他にも敵の首を絞めることが
出来る。
*/
}


resource TO_首締め２__i {
オタコン_000: {
Avvicinati al nemico alle spalle e premi il
tasto Armi
}
//	<<<ENGLISH>>>
//	Move in close to the enemy
//	from behind and push the
//	Weapon button
//<ページ数変更>
オタコン_000_1: {
senza muovere la levetta analogica
sinistra.
}
//	<<<ENGLISH>>>
//	without moving the
//	left analog stick.

/*首を絞めるには、敵の後ろから
近づいて左スティックを入れずに
＃｛□、武器｝＃ボタンを押すんだ。
*/

オタコン_001: {
Premi ripetutamente il tasto Armi per
spezzare il collo al nemico.
}
//	<<<ENGLISH>>>
//	Hit the Weapon button repeatedly
//	to break the enemy's neck.
//<ページ数変更>
オタコン_001_1: {
Tienilo invece premuto se vuoi spostarti e
trascinare il nemico con te.
}
//	<<<ENGLISH>>>
//	Keep it pushed down if you want
//	to move around and drag him away
//	with you.

/*そのまま＃｛□、武器｝＃ボタンを連打すれば、
敵を倒せる。押しっぱなしにすれば
敵を引きずって移動することも出来る。
*/
}


resource TO_首締め３__i {
オタコン_000: {
Ricordati che puoi farlo solo prendendo il
nemico alle spalle.
}
//	<<<ENGLISH>>>
//	Remember, you can only
//	do this from the back.
//<ページ数変更>
オタコン_000_1: {
Non puoi strangolarlo se gli stai davanti.
Fai attenzione.
}
//	<<<ENGLISH>>>
//	You can't perform a chokehold
//	while facing someone. Be careful.

/*でも気をつけてくれ。敵の正面からじゃ
首は絞められない。首絞めを仕掛ける
時は必ず相手の後ろに回りこむんだ。
*/

}//d


//・壁コンコン h //e
resource TO_張り付きコンコン１__i {
//＊ムービー t //e
オタコン_000: {
Muovi la levetta analogica sinistra verso
un muro e tienila l&`i per appiattirti contro
il muro.
}
//	<<<ENGLISH>>>
//	Move the left analog stick toward a wall
//	and keep it there to flatten yourself against
//	the wall.

//	Move the left analog stick in the
//	direction of a wall and keep it there
//	to flatten yourself against the wall.

/*壁の方向に向かって左スティックを
押しっぱなしにすると、壁に張り付ける。
*/
}

resource TO_張り付きコンコン２__i {
//＊ムービー t //e
オタコン_000: {
Premi il tasto Pugno quando sei
appoggiato al muro per picchiare e
creare un diversivo.
}
//	<<<ENGLISH>>>
//	Push the Punch button while in
//	that position to knock on the
//	wall and create a diversion.

/*壁に張り付いている時に＃｛○、パンチ｝＃ボタンを
押せば、壁を叩いて物音を立てることが
出来るんだ。
*/
}


resource TO_張り付きコンコン３__i {
//＊ムービー t //e
オタコン_000: {
Se usi un piano attento, potrai allontanare
le sentinelle dalle loro postazioni.
}
//	<<<ENGLISH>>>
//	If you plan carefully, you'll
//	be able to lure sentries away
//	from their posts.

/*うまくやれば持ち場から動こうとしない
敵をおびき寄せたりすることも出来る
はずだ。
*/

}//d



//・普通のビハインド h //e
resource TO_普通のビハインド１__i {
//＊ムービー t //e
オタコン_000: {
Quando sei appiattito contro una superficie
dietro l'angolo, ti trovi nella Visuale
Angolare.
}
//	<<<ENGLISH(2)>>>
//	When you're flattened against a
//	surface behind a corner, you're
//	in Corner View.
//<ページ数変更>
オタコン_000_1: {
Potrai guardare oltre l'angolo.
}
//	<<<ENGLISH>>>
//	You'll be able to survey the area
//	without exposing yourself.

/*物陰の角に張り付くとビハインドモード
になる。自分は隠れながら曲がり角の
先とかを覗くことが出来るんだ。
*/
}


resource TO_普通のビハインド２__i {
//＊ムービー t //e
オタコン_000: {
La Visuale Angolare ti lascia guardare
davanti a te con i tasti L2 o R2,
}
//	<<<ENGLISH(2)>>>
//	The Corner View lets you take a look
//	ahead with the L2 and R2 buttons,
//<ページ数変更>
オタコン_000_1: {
oppure potrai balzare fuori dal nascondiglio
con l'arma alla mano.
}
//	<<<ENGLISH>>>
//	or you can jump out with
//	your weapon ready.

/*ビハインドモードからはＬ２ボタン、
Ｒ２ボタンで覗き込みをしたり、
武器を構えて飛び出したり出来る。
*/

オタコン_001: {
Sfrutta tutta l'azione.
}
//	<<<ENGLISH(2)>>>
//	Take advantage of
//	all the action.

/*うまく使ってくれ。
*/

}//d


//・イントルード h //e
resource TO_イントルード１__i {
オタコン_000: {
Usa Strisciare per infilarti sotto scrivanie
ed altri oggetti.
}
//	<<<ENGLISH(2)>>>
//	Use Crawl to get under
//	desks and other objects.
//<ページ数変更>
オタコン_000_1: {
Quando ti trovi in una zona ristretta, sarai
nella Visuale Incursione.
}
//	<<<ENGLISH>>>
//	Once you're in enclosed space,
//	you'll be in Intrusion View.

/*机の下とかにはホフクで潜り込める。
そうやって狭い所に入り込んだ時は
イントルードモードになるんだ。
*/
}


resource TO_イントルード２__i {
オタコン_000: {
Nella Visuale Incursione ti sposti in avanti
con la levetta analogica sinistra in Su,
indietro con Gi&`u,
}
//	<<<ENGLISH>>>
//	In Intrusion View, you move forward
//	with the left analog stick Up, back
//	with Down,
//<ページ数変更>
オタコン_000_1: {
oppure a sinistra o destra rispettivamente
con Sinistra e Destra.
}
//	<<<ENGLISH>>>
//	and left or right with the
//	corresponding directions.

/*イントルードモードの時は
左スティックの上で前進、下で後退、
左右でその方向を向く。
*/

オタコン_001: {
Usa il tasto della Visuale Soggettiva per
guardarti intorno o per prendere la mira
con precisione.
}
//	<<<ENGLISH>>>
//	Use the First Person View button to look
//	around or aim with precision.

//	Use the First Person View button
//	to take a look around or aim with
//	precision.

/*主観ボタンを使えばまわりを見渡せるし、
銃を撃つことも出来る。
*/
}


resource TO_イントルード３__i {
オタコン_000: {
Ma se qualcuno ti vede mentre sei
nascosto, potresti subire un attacco.
}
//	<<<ENGLISH>>>
//	But if someone catches sight of
//	you while you hide, you could be
//	attacked.
//<ページ数変更>
オタコン_000_1: {
E non &`e neppure una garanzia nelle
operazioni di Pulizia.
}
//	<<<ENGLISH>>>
//	It's no guarantee against
//	a Clearing either. 

/*でも隠れるところを敵に見られたら
攻撃されることもあるし、クリアリング
の時は見つかってしまうこともある。
*/

オタコン_001: {
Passare allo stato di Incursione non
significa essere totalmente al sicuro.
Tieni presente questo fatto.
}
//	<<<ENGLISH>>>
//	Entering Intrusion state doesn't
//	mean you're absolutely safe.
//	Keep that in mind.

/*イントルードに逃げ込めば
安全ってわけじゃないってことだ。
気をつけてくれ。
*/

}//d


//・匍匐 h //e
resource TO_ホフク１__i {
//＊ムービー t //e
オタコン_000: {
Snake, premi il tasto Strisciare per
acquattarti.
}
//	<<<ENGLISH(2)>>>
//	Snake, push the Crawl button
//	to crouch down.
//<ページ数変更>
オタコン_000_1: {
Fallo quando ti metti al riparo dietro ad
oggetti bassi.
}
//	<<<ENGLISH>>>
//	You'll definitely need it when
//	you're taking cover behind low
//	objects.

/*スネーク、＃｛×、ホフク｝＃ボタンを押すとしゃがむ
ことが出来る。低い遮蔽物に隠れる時は
しゃがまなきゃダメだ。
*/
}


resource TO_ホフク２__i {
//＊ムービー t //e
オタコン_000: {
Usa la levetta analogica sinistra mentre
sei acquattato, per strisciare in quella
direzione.
}
//	<<<ENGLISH>>>
//	Use the left analog stick while
//	you're crouching to crawl in
//	that direction.
//<ページ数変更>
オタコン_000_1: {
Per rialzarti, premi di nuovo il tasto
Strisciare.
}
//	<<<ENGLISH>>>
//	Push the Crawl button
//	again to stand up.

/*しゃがんでる時に左スティックを押すと、
その方向にホフクする。立ち上がるには
もう一度＃｛×、ホフク｝＃ボタンを押せばいい。
*/
}


resource TO_ホフク３__i {
//＊ムービー t //e
オタコン_000: {
Strisciare &`e il modo migliore di muoversi in
silenzio, oppure di infilarsi sotto qualcosa.
}
//	<<<ENGLISH>>>
//	Crawling is your best bet when you
//	need to move silently, or get under
//	something.

/*足音を立てたくない時や、机の下とかに
潜り込みたい時はホフクすればいい。
*/
}


resource TO_ホフク４__i {
オタコン_000: {
Puoi far fuoco con un'arma dalla posizione
a terra. &`E un buon attacco invisibile.
}
//	<<<ENGLISH>>>
//	You can fire a handgun from
//	prone position. It's a good
//	stealth attack.

/*ハンドガンならホフクしながらでも
撃つことが出来る。隠れながら攻撃
したい時には役立つと思う。
*/

}//d

//・アイテムボックス h //e
resource TO_アイテムボックス１__i {
オタコン_000: {
Ogni volta che vedi una Scatola di Oggetti,
prendila.
}
//	<<<ENGLISH>>>
//	Whenever you see an Item
//	Box, you should acquire it.
//<ページ数変更>
オタコン_000_1: {
Controlla pi&`u da vicino di che Oggetto si
tratta.
}
//	<<<ENGLISH>>>
//	Take a closer look to
//	see what the Item is.

/*アイテムボックスを見かけたら
入手した方が良い。何のアイテムかは、
よく見れば書いてあると思う。
*/
}


resource TO_アイテムボックス２__i {
//＊ムービー t //e
オタコン_000: {
Quando metti k.o. un nemico, nascondi il
suo corpo e controlla se c'&`e una Scatola di
Oggetti.
}
//	<<<ENGLISH>>>
//	When you take out an enemy, move
//	his body out of the way and check
//	for an Item Box.
//<ページ数変更>
オタコン_000_1: {
Non lasciarla l&`i.
}
//	<<<ENGLISH(2)>>>
//	Don't leave it behind.

/*敵を倒して、その体を動かすと
アイテムボックスを出すことがある。
それを手に入れるのも忘れないようにね。
*/

}//d

resource TO_アイテムボックス３__i {
//＊ムービー t //e
オタコン_000: {
Quando metti k.o. un nemico potrebbe
apparire una Scatola di Oggetti. Non
lasciarla l&`i...
}
//	<<<ENGLISH>>>
//	When you take out an enemy,
//	an Item Box may appear.
//	Don't leave it behind.

/*敵を倒すとアイテムボックスを
出すことがある。それを手に入れるのも
忘れないようにね。
*/

}//d



//○その他 d //e
//・隠密行動せよ。 h //e
resource TO_発見されるな__i {
オタコン_000: {
Snake, non lasciare che il nemico ti veda.
}
//	<<<ENGLISH>>>
//	Snake, don't let the
//	enemy spot you.
//<ページ数変更>
オタコン_000_1: {
Se una sentinella ti scopre, chiamer&`a
rinforzi e ci sar&`a un attacco.
}
//	<<<ENGLISH>>>
//	Once you've been discovered by a
//	sentry, he'll call in reinforcements
//	and there will be an attack.

/*スネーク、敵に見つからないように
してくれよ。敵は君を見つけたら、
当然仲間を呼んで攻撃してくる。
*/

オタコン_001: {
Nemmeno tu puoi farcela con un attacco
cos&`i organizzato.
}
//	<<<ENGLISH>>>
//	Even you're no match for that
//	level of organized assault.
//<ページ数変更>
オタコン_001_1: {
E poi avranno anche armi migliori, ricordi?
}
//	<<<ENGLISH>>>
//	They have better weapons
//	too, remember?

/*組織的に攻撃されたら、いくら君でも
勝ち目はない。武装は向こうの方が
上だしね。
*/

オタコン_002: {
Noi non siamo terroristi, capito?
}
//	<<<ENGLISH>>>
//	We aren't terrorists, okay?
//<ページ数変更>
オタコン_002_1: {
Evita i confronti inutili e cerca di rimanere
completamente invisibile. Va bene?
}
//	<<<ENGLISH>>>
//	Avoid unnecessary confrontations
//	and go for total stealth. All right?

/*僕らはテロリストじゃない。
無用な戦闘はさけてくれ。
あくまでも隠密行動だ。いいね。
*/

}//d



//★デフォルト会話。当該アイテムを装備している時一回目のみ発生 d //e
//武器 d //e
//・Ｍ９ h //e
resource TO_Ｍ９__i {
オタコン_000: {
L'arma che hai in mano &`e una Beretta
M-92F modificata, studiata per proiettili
che contengono tranquillanti.
}
//	<<<ENGLISH>>>
//	What you're wielding right now
//	is a converted Beretta M-92F,
//	designed to fire tranquilizer rounds.
//<ページ数変更>
オタコン_000_1: {
Se colpisci direttamente il nemico, perder&`a
i sensi.
}
//	<<<ENGLISH(2)>>>
//	A direct hit will knock
//	the target unconscious.

/*君が装備してるのはベレッタＭ９２Ｆを
改造した麻酔銃だ。命中すれば敵を
眠らせることが出来るよ。
*/


オタコン_001: {
Pensa ai proiettili come a delle piccole
siringhe.
}
//	<<<ENGLISH(2)>>>
//	Think of those rounds
//	as tiny syringes.

/*麻酔弾は簡単に言えば小さな注射器
みたいなものだ。
*/

オタコン_002: {
L'impatto dei proiettili fa mischiare insieme
due sostanze chimiche al loro interno.
}
//	<<<ENGLISH>>>
//	The impact of the round causes
//	the mixing of two chemicals in
//	the shell.
//<ページ数変更>
オタコン_002_1: {
Il gas prodotto comprime un piccolo
pistone
}
//	<<<ENGLISH(2)>>>
//	The resulting gas compresses
//	a tiny piston＃－
//<ページ数変更>
オタコン_002_2: {
ed inietta il tranquillante dalla punta
del proiettile nella pelle del nemico.
}
//	<<<ENGLISH(2)>>>
//	and injects the tranquilizer in the
//	bullet's tip into the target's skin.

/*着弾時の慣性で薬品を混合してガスを
発生させ、そのガスでピストンを押して、
対象に麻酔を注入する仕組みになってる。
*/

オタコン_003: {
Gli effetti del tranquillante iniziano prima o
dopo, a seconda della parte del corpo
colpita.
}
//	<<<ENGLISH(2)>>>
//	The tranquilizer's effects are felt
//	at different times depending on
//	where the bullet lands.

/*麻酔弾は当たる場所によって、
麻酔が効くまでの時間が
変わってくるんだ。
*/

オタコン_004: {
Se miri alla testa o al cuore, l'effetto &`e
immediato,
}
//	<<<ENGLISH(2)>>>
//	A head or heart shot will
//	take effect immediately,
//<ページ数変更>
オタコン_004_1: {
mentre se miri altrove, per esempio ai
piedi o alle mani, ci vorr&`a un po'.
}
//	<<<ENGLISH>>>
//	but a round that hits somewhere
//	like feet or hands will take a while.
//<ページ数変更>
オタコン_004_2: {
Usa l'Attacco con Visuale Soggettiva per la
massima precisione.
}
//	<<<ENGLISH(2)>>>
//	Use the First Person View
//	Attack for maximum accuracy.

/*頭や心臓なら早いし手足なら時間が
かかる。主観攻撃でうまく狙ってくれ。
*/

オタコン_005: {
L'arma ha un silenziatore, quindi non devi
preoccuparti di attirare l'attenzione del
nemico con il rumore.
}
//	<<<ENGLISH(2)>>>
//	The gun is fitted with a suppressor,
//	so there is no need to worry about
//	alerting the enemy with the noise.

/*サプレッサー装備だから銃声で敵に
見つかったりすることもないはずだ。
*/

オタコン_006: {
Ma siccome spara tranquillanti, l'M9 ha i
suoi limiti.
}
//	<<<ENGLISH(2)>>>
//	But since it is a tranquilizer
//	gun, the M9 has its limitations.
//<ページ数変更>
オタコン_006_1: {
Pu&`o solo tramortire il nemico. Tienilo
presente.
}
//	<<<ENGLISH(2)>>>
//	All it can do is knock the enemy
//	unconscious. Keep that in mind.

/*でもあくまでＭ９は麻酔銃だ。
敵を眠らせるだけで倒せるわけじゃない。
気をつけてくれ。
*/

}//d

//・ＵＳＰ h //e
resource TO_ＵＳＰ１__i {
オタコン_000: {
Snake, quella pistola &`e un'USP.
}
//	<<<ENGLISH>>>
//	Snake, that handgun
//	of yours is a USP.

/*スネーク、君が装備してるハンドガンは
ＵＳＰだね。
*/

オタコン_001: {
L'USP &`e disponibile in vari calibri, da 9mm
fino a 45.
}
//	<<<ENGLISH>>>
//	The USP comes in a variety of
//	calibers, from a 9mm to a .45.
//<ページ数変更>
オタコン_001_1: {
La tua &`e una 9mm, con 15 proiettili per
ogni caricatore.
}
//	<<<ENGLISH>>>
//	Yours is a 9mm, with 15
//	rounds per magazine.

/*ＵＳＰは９ｍｍとか４５口径とか色々な
バリエントがあるんだけど、君のは
口径９ｍｍ、装弾数１５発のモデルだ。
*/

}


//製品版のみ t //e
resource TO_ＵＳＰ２__i {
オタコン_000: {
&`E anche equipaggiata con una torcia, per
l'uso notturno.
}
//	<<<ENGLISH>>>
//	It's also equipped with a flashlight
//	for nighttime shooting.
//<ページ数変更>
オタコン_000_1: {
Al buio, seleziona l'USP e poi prendi la
mira per attivare la torcia.
}
//	<<<ENGLISH>>>
//	In the dark, select the USP
//	and aim to turn on the light.

/*フラッシュライトもついてるね。
暗いところでＵＳＰを装備して
構えればライトがつくはずだ。
*/
}



resource TO_ＵＳＰ３__i {
オタコン_000: {
A differenza dell'M9, l'USP non ha un
silenziatore.
}
//	<<<ENGLISH>>>
//	Unlike the M9, the USP isn't
//	suppressor-equipped.
//<ページ数変更>
オタコン_000_1: {
I colpi che esplodi potranno attirare rinforzi
nemici, quindi fai attenzione.
}
//	<<<ENGLISH>>>
//	The gunshots may bring enemy
//	reinforcements running, so be
//	careful.

/*でもＭ９と違ってサプレッサーは
付いてないから、発砲すれば当然
銃声がする。撃つ時には注意してくれ。
*/
//ＸＸＸＸＸ //e

}//d



//・チャフ h //e
resource TO_チャフ__i {
オタコン_000: {
Ehi, hai una granata chaff antiradar.
}
//	<<<ENGLISH>>>
//	Hey, you have a chaff grenade.
//<ページ数変更>
オタコン_000_1: {
Puoi usarla per interferire
temporaneamente con le comunicazioni
radio
}
//	<<<ENGLISH>>>
//	You can use that to interfere
//	with enemy radio communications...
//<ページ数変更>
オタコン_000_2: {
del nemico e con i dispositivi elettronici.
}
//	<<<ENGLISH>>>
//	and electronic devices
//	for a short time.

/*チャフ・グレネードを持ってるね。
それを使えば少しの間、敵の無線や
電子機器を妨害することが出来る。
*/

オタコン_001: {
La granata chaff &`e un'arma che diffonde
frammenti di alluminio o vetro metallizzato
}
//	<<<ENGLISH>>>
//	The chaff grenade is a weapon
//	that disperses aluminum foil or
//	metalcoated glass
//<ページ数変更>
オタコン_001_1: {
e fibre plastiche che confondono i radar
nemici.
}
//	<<<ENGLISH>>>
//	and plastic fibers to
//	confuse the enemy radar.

/*チャフはアルミ箔とか金属コーティング
したガラスやプラスティック繊維を散布
してレーダーを妨害する電子戦兵器だ。
*/

オタコン_002: {
Quella che hai &`e la versione portatile dei
lanciagranate chaff
}
//	<<<ENGLISH>>>
//	What you have is a portable
//	application of the chaff-
//	launchers
//<ページ数変更>
オタコン_002_1: {
antiradar installati sui caccia.
}
//	<<<ENGLISH>>>
//	built into fighter planes.

/*君が持ってるのは戦闘機とかに
搭載されるチャフ・ディスペンサーを
携行用に小型化したものだね。
*/

オタコン_003: {
Se scoppia, la granata libera frammenti
chaff antiradar
}
//	<<<ENGLISH>>>
//	When detonated, the grenade
//	releases tiny chaff pieces
//<ページ数変更>
オタコン_003_1: {
e dispositivi miniaturizzati di bloccaggio
attivati, usando piccola quantit&`a di
esplosivo.
}
//	<<<ENGLISH>>>
//	as well as miniaturized active
//	jammers using a small amount
//	of explosives.

/*点火装置が発火すると微量の爆薬で
多数のチャフ片と同時に
＃｛小型妨害電波発信機、ミニ・アクティブ・ジャマー｝＃を散布する。
*/

オタコン_004: {
La granata non pu&`o creare corridoi o
nuvole chaff antiradar su scala completa,
}
//	<<<ENGLISH>>>
//	The grenade can't create full-scale
//	chaff corridors or chaff clouds,
//<ページ数変更>
オタコン_004_1: {
ma former&`a un'area in Sezione Radar
(RCS) abbastanza ampia per l'uso da parte
di una sola persona.
}
//	<<<ENGLISH>>>
//	but will form a Radar Cross
//	Section area large enough for
//	single-personnel use.

/*大規模なチャフ＃｛回廊、コリドー｝＃やチャフ雲は作り出
せないけど個人用としては充分な大きさ
の＃｛レーダー有効反射面積、ＲＣＳ｝＃を形成出来る。
*/

オタコン_005: {
Quest'arma serve solo a creare
interferenze elettroniche, per&`o.
}
//	<<<ENGLISH>>>
//	This weapon is for electronic
//	interference only, though.
//<ページ数変更>
オタコン_005_1: {
Non ha alcun effetto sul nemico.
}
//	<<<ENGLISH>>>
//	It has no effect on
//	enemy personnel. 

/*でもあくまでも電子妨害用の手榴弾
だから、それで敵を倒すことは出来ない。
注意してくれ。
*/

}//d

//・スタン h //e
resource TO_スタン__i {
オタコン_000: {
La granata stordente contenuta nel tuo
equipaggiamento serve a immobilizzare i
nemici senza ucciderli.
}
//	<<<ENGLISH>>>
//	The stun grenade in your equipment
//	is for incapacitating enemies without
//	killing them.

/*スタン・グレネードを装備してるね。
それを使えば敵を殺さずに気絶させる
ことが出来る。
*/

オタコン_001: {
Le granate sordenti sono arme non letali
che tramortiscono il nemico
}
//	<<<ENGLISH>>>
//	Stun grenades are non-lethal
//	weapons that knock out enemy
//	personnel
//<ページ数変更>
オタコン_001_1: {
con un intenso lampo luminoso ed un
rumore fortissimo.
}
//	<<<ENGLISH>>>
//	with an intense flash of
//	light and a burst of sound.

/*スタン・グレネードは強烈な光と音を
発生させて人間を傷つけずに無力化する
＃｛非殺傷兵器、ノン・リーサル・ウェポン｝＃だ。
*/

オタコン_002: {
Quando lanci la granata, un detonatore a
tempo espelle una cartuccia interna,
}
//	<<<ENGLISH>>>
//	Once the grenade is airborne,
//	a timed detonator ejects an
//	internal cartridge＃－
//<ページ数変更>
オタコン_002_1: {
usando una piccola quantit&`a di esplosivo.
}
//	<<<ENGLISH(2)>>>
//	using a small amount
//	of explosives.

/*投擲後、時限点火装置が作動すると、
微量の火薬で内蔵のカートリッジが
撃ち出される。
*/

オタコン_003: {
Poi la cartuccia esplode e genera un lampo
di pi&`u di un milione di candele in intensit&`a,
}
//	<<<ENGLISH>>>
//	The cartridge then explodes, and
//	releases a flash rated at over a
//	million candlepower,
//<ページ数変更>
オタコン_003_1: {
con un botto di oltre 200 decibel.
}
//	<<<ENGLISH>>>
//	with an accompanying bang
//	of over 200 decibels.
//<ページ数変更>
オタコン_003_2: {
La combinazione di lampo e rumore ha
temporaneamente il sopravvento sulle
percezioni sensoriali umane.
}
//	<<<ENGLISH>>>
//	The combinations of the flash and
//	the bang temporarily overwhelms
//	human sensory perceptions.

/*カートリッジは１００万カンデラ以上の
閃光と２００デシベル以上の爆音を放出
して爆発し、人間の感覚を失わせるんだ。
*/

オタコン_004: {
Quest'arma non esplode proiettili e pu&`o
solo tramortire il nemico, non ferirlo.
Tienilo presente.
}
//	<<<ENGLISH>>>
//	There are no projectiles released,
//	so it can only knock out enemies,
//	not wound them. Keep that in mind.

/*体を傷つける破片は飛び散らないから、
敵を気絶させるだけでダメージを
負わせることは出来ない。注意してくれ。
*/

}//d

//・マガジン h //e
resource TO_マガジン__i {
オタコン_000: {
Snake, hai un caricatore vuoto in mano.
Perch&'e continui a portarlo con te?
}
//	<<<ENGLISH>>>
//	Snake, you have an empty magazine
//	in your hand. Why are you still
//	carrying that around?

/*スネーク、君が今持ってるのは、
撃ち尽くした銃の弾倉だ。捨てずに
取っておくなんて物持ちがいいね。
*/
//マガジン投げの説明 t //e

}//d


//装備 d //e
//・軍用双眼鏡 h //e
resource TO_双眼鏡__i {
オタコン_000: {
Bene, hai un binocolo. Potrai usarlo per
una ricognizione del territorio nemico,
tenendoti a distanza.
}
//	<<<ENGLISH>>>
//	Good, you have a pair of binoculars.
//	You'll be able to use them to survey
//	enemy territory from a distance.

/*双眼鏡を装備してるね。
それを使えば遠くから敵地を偵察出来る。
*/

オタコン_001: {
Ha una funzione di zoom e anche
l'auto-focus. In pi&`u &`e molto resistente,
come tutti i dispositivi militari.
}
//	<<<ENGLISH>>>
//	They come with a zoom function
//	and auto-focus, and have all the
//	durability of military equipment.
//<ページ数変更>
オタコン_001_1: {
Non dovrai preoccuparti che si rompa,
quest'aggeggio.
}
//	<<<ENGLISH>>>
//	You won't have to worry
//	about breakage with these.

/*ズーム機能もついてるし、フォーカスも
オートだ。軍用品だから耐久性も問題
ない。壊れたりする心配もないと思う。
*/

}//d

//・レーション h //e
resource TO_レーション__i {
オタコン_000: {
Ah, hai delle razioni ora. Si tratta di razioni
militari,
}
//	<<<ENGLISH>>>
//	So you've got rations now.
//	These are military food supplies,
//<ページ数変更>
オタコン_000_1: {
che ti fanno recuperare un po'
di LIFE se le usi.
}
//	<<<ENGLISH>>>
//	and allow you to recover
//	some LIFE with use.

/*レーションを装備してるね。
軍用の携帯糧食で、使うと＃｛ＬＩＦＥ、ライフ｝＃を
ある程度回復するアイテムだ。
*/

オタコン_001: {
Se ne sei gi&`a equipaggiato,
}
//	<<<ENGLISH>>>
//	If it is equipped in advance,
//<ページ数変更>
オタコン_001_1: {
la razione viene usata automaticamente e
recuperi LIFE quando vieni ferito.
}
//	<<<ENGLISH>>>
//	the ration will automatically be
//	used and LIFE will be regained
//	when you receive damage.

/*装備しておけば＃｛ＬＩＦＥ、ライフ｝＃が無くなる
瞬間、自動的に使って＃｛ＬＩＦＥ、ライフ｝＃を
回復出来る。
*/

オタコン_002: {
Puoi selezionarla all'interno della finestra e
premere il tasto di conferma, per usarla
all'istante.
}
//	<<<ENGLISH>>>
//	You can select it in the window and
//	push the confirmation button to use
//	the item on the spot.

/*ウィンドウで選んで＃｛○、決定｝＃ボタンを押せば、
その場で使うことも出来る。
*/

オタコン_003: {
Le razioni erano studiate per venire portate
e mangiate sul campo.
}
//	<<<ENGLISH>>>
//	Rations were designed to be
//	carried and eaten on the field.
//<ページ数変更>
オタコン_003_1: {
&`E tutta una questione di funzionalit&`a e
calorie.
}
//	<<<ENGLISH>>>
//	They're all about functionality
//	and calories.

/*レーションは初めから戦場で食べる
ことを想定して作られた軍用携帯糧食だ。特に機能性とカロリーを重視してある。
*/

オタコン_004: {
Le razioni usano un metodo speciale di
liofilizzazione sviluppato dall'NROC.
}
//	<<<ENGLISH>>>
//	They use a special freeze-drying
//	methods developed by NROC.
//<ページ数変更>
オタコン_004_1: {
Sono compatte, portatili e durano intere
settimane.
}
//	<<<ENGLISH>>>
//	They're compact, portable,
//	and last for weeks.

/*＃｛米軍調理開発研究所、ＮＲＯＣ｝＃が開発した
フリーズドライ方式を使っていて、小型
軽量で日持ちもするように出来てるんだ。
*/


}//d


//・軍用止血剤 h //e
resource TO_止血剤１__i {
オタコン_000: {
Vedo che hai preso le bende in gel, bravo.
}
//	<<<ENGLISH>>>
//	You've picked up
//	gel bandages, I see.
//<ページ数変更>
オタコン_000_1: {
Quando sanguini, scegli la benda
per fermare il sangue.
}
//	<<<ENGLISH>>>
//	When you're bleeding, select
//	the bandage as an equipment
//	to stop the blood.

/*止血剤を装備してるね。出血してる時に
止血剤を使えば血を止められる。
*/
}

//流血条件聞いてない場合 流血条件 t e//

resource TO_止血剤２__i {
オタコン_000: {
La benda &`e una specie di fasciatura in
alginato.
}
//	<<<ENGLISH>>>
//	The bandage is a type
//	of alginate dressing.
//<ページ数変更>
オタコン_000_1: {
&`E una compressa molto assorbente che
diventa un gel a contatto col sangue o altri
fluidi.
}
//	<<<ENGLISH(2)>>>
//	It's a highly absorbent pad
//	that gels blood and other
//	fluids on contact.

/*その止血剤はいわゆるアルギネート材
だ。血液や体液を吸収してゲル化する
アルギン酸繊維製の吸収パッドだよ。
*/

オタコン_001: {
Durante l'assorbimento rilascia ioni di
calcio, con un effetto coagulante.
}
//	<<<ENGLISH>>>
//	It releases calcium ions
//	during absorption, hence
//	the coagulating effect.

/*吸収する時にカルシウムイオンを
放出するから止血効果が高いんだ。
*/

}//d


//・軍用カメラ h //e
resource TO_カメラ__i {
オタコン_000: {
Okay, prendi la telecamera digitale. Voglio
che scatti una foto del nuovo Metal Gear.
}
//	<<<ENGLISH>>>
//	OK, take out the digital camera.
//	I want you to take a picture of
//	the new Metal Gear.

/*デジタルカメラを装備してるね。
それで新型メタルギアの写真を
撮ってきてほしいんだ。
*/

オタコン_001: {
Ma non dimenticare: per salvare le
immagini ti serve una MEMORY CARD
(PS2).
}
//	<<<ENGLISH>>>
//	But, don't forget; to save the
//	pictures, you need a MEMORY
//	CARD (PlayStation&@R2).

/*だけど注意してくれ。
写真を記録するには“PlayStation2”
専用メモリーカード(8MB)が必要なんだ。
*/

オタコン_002: {
Quando scatti foto, non dimenticare di
inserire una MEMORY CARD (PS2)
}
//	<<<ENGLISH>>>
//	When you take pictures, don't
//	forget to insert the MEMORY CARD
//	(PlayStation&@R2)
//<ページ数変更>
オタコン_002_1: {
nell'ingresso MEMORY CARD.
}
//	<<<ENGLISH>>>
//	into the MEMORY CARD slot.

/*写真を撮る時は、忘れずにＭＥＭＯＲＹ 
ＣＡＲＤ差込口へ“PlayStation2”専用
メモリーカード(8MB)をセットしてくれ。
*/

オタコン_003: {
Sai, la telecamera &`e da tempo essenziale
per le operazioni belliche.
}
//	<<<ENGLISH>>>
//	You know, the camera has been
//	an essential part of warfare for
//	a while now.
//<ページ数変更>
オタコン_003_1: {
Ho sentito che i corpi di Fotografia Militare
dell'esercito degli Stati Uniti esistono gi&`a
da 100 anni.
}
//	<<<ENGLISH>>>
//	I heard that the Photo Corps
//	of the US Army has been around
//	for 100 years.

/*昔から戦場での偵察行動にカメラは
必需品だっただろ。米軍の写真班は
１００年前からあったって言うしね。
*/


}//d

//・タバコ h //e
resource TO_タバコ__i {
オタコン_000: {
Snake, ma fumi? Dovresti smettere, lo
sai.
}
//	<<<ENGLISH>>>
//	Snake, are you smoking?
//	You really should quit.

/*スネーク、煙草を吸ってるのかい？
やめた方が良いと思うよ。
*/

オタコン_001: {
Innanzitutto ti rende un bersaglio perfetto
al buio.
}
//	<<<ENGLISH>>>
//	First of all, it turns you into
//	an instant target in the dark.
//<ページ数変更>
オタコン_001_1: {
E poi, non sto nemmeno a dirti cosa fa per
la tua salute.
}
//	<<<ENGLISH>>>
//	As for what it means to your
//	health, I won't even go there.

/*暗いところで吸えば火が目立って
見つかりやすくなるし、何より健康に
良くない。
*/

オタコン_002: {
Ricorda quello che diceva Naomi sul
numero di casi di cancro ai polmoni?
}
//	<<<ENGLISH>>>
//	Remember what Naomi said
//	about lung cancer rates?
//<ページ数変更>
オタコン_002_1: {
Tutti sanno che &`e una sostanza
pericolosa.
}
//	<<<ENGLISH>>>
//	Everyone knows that it's
//	a dangerous substance.

/*ナオミも肺癌の元だって言ってただろ。
だいたい今時煙草なんて流行らない。
*/

スネーク_003: {
Anche la guerra &`e pericolosa, eppure la
faccio da una vita.
}
//	<<<ENGLISH>>>
//	So's war, and I've
//	done that all my life.

/*悪いが流行には興味が無い。
*/

オタコン_004: {
Beh, affari tuoi se vuoi rovinarti la salute,
ma almeno pensa agli altri va bene?
}
//	<<<ENGLISH>>>
//	Well, you can screw up your own
//	body if you like, but think about
//	other people, okay?

/*ま、命を縮めるのは君の勝手だけど、
人の迷惑になるようなことをしちゃ
ダメだよ。
*/

スネーク_005: {
Queste sigarette sono del tipo leggero, non
ti preoccupare. Non danno fastidio a
nessuno.
}
//	<<<ENGLISH>>>
//	This is the new kind that has
//	almost no second-hand smoke.
//	It won't bother anyone.

/*こいつは副流煙の出ない先折り煙草だ。
他人に迷惑はかけんよ。
*/

オタコン_006: {
Ah davvero? Ma non ti ho forse visto
gettare in acqua il mozzicone? Ora ti
metti anche a inquinare...
}
//	<<<ENGLISH>>>
//	Oh really? Didn't I see you
//	toss the butt off the bridge?
//	Littering, polluting...

/*そうかな？
君、橋の上でポイ捨てしたろ？
*/

スネーク_007: {
Mmmm...
}
//	<<<ENGLISH(2)>>>
//	Ummm...

/*……。*/

オタコン_008: {
Ne hai ancora di strada da fare, vecchio
mio.
}
//	<<<ENGLISH>>>
//	You have a long way
//	to go, my friend.

/*まったく！
*/

}//d


//・耳栓 h //e
resource TO_耳栓__i {
オタコン_000: {
Snake, l'equipaggiamento che abbiamo qui
sono tappi per le orecchie.
}
//	<<<ENGLISH>>>
//	Snake, the equipment you've got
//	there is a pair of earplugs.

/*スネーク、今君が装備してる装備品は
耳栓だ。
*/

オタコン_001: {
Di solito quando fai esplodere una granata
stordente per un po' non ci senti bene,
}
//	<<<ENGLISH>>>
//	You usually have reduced hearing
//	for a while after setting off a stun
//	grenade,
//<ページ数変更>
オタコン_001_1: {
ma sei hai quelli nessun problema.
}
//	<<<ENGLISH>>>
//	but not if you have those on.

/*普通、スタン・グレネードを使うと
しばらく耳が聞こえにくくなるんだけど
それをつけてれば大丈夫だ。
*/

オタコン_002: {
Ma se ti metti i tappi senti poco, lo stesso.
}
//	<<<ENGLISH>>>
//	But you won't hear too well as
//	long as you have them on, either.
//<ページ数変更>
オタコン_002_1: {
Usali solo quando lanci le granate
stordenti.
}
//	<<<ENGLISH>>>
//	Use them only with stun grenades.

/*でも普段より聞こえにくくなることは
確かだから、スタンを使う時とか以外は
つけない方が良いかもね。
*/

}//d

//・ジアゼパム h //e
resource TO_ジアゼパム__i {
オタコン_000: {
Hai della pentazemina nel tuo inventario.
}
//	<<<ENGLISH>>>
//	You have Pentazemin
//	in your inventory.
//<ページ数変更>
オタコン_000_1: {
Se ti serve, selezionalo nella Finestra
Oggetti e premi il tasto Invio.
}
//	<<<ENGLISH>>>
//	If you need to take some, select
//	it in the Item Window and push
//	the Enter button.

/*ジアゼパムを装備してるね。
アイテムウィンドウで選んで
＃｛○、決定｝＃ボタンを押せば使うことが出来る。
*/

オタコン_001: {
La pentazemina &`e un leggero tranquillante
usato per la depressione clinica,
}
//	<<<ENGLISH>>>
//	Pentazemin is a mild tranquilizer
//	used to treat clinical depression,
//<ページ数変更>
オタコン_001_1: {
il disturbo ossessivo-compulsivo e gli stati
ansiosi.
}
//	<<<ENGLISH>>>
//	obsessive-compulsive
//	behavior, and anxiety.

/*ジアゼパムは鬱病とか自律神経失調症、不安神経症なんかの治療に使われる
マイナー・トランキライザーだ。
*/

オタコン_002: {
Appartiene alla classe farmaceutica del
benzodiazepinato
}
//	<<<ENGLISH>>>
//	It belongs to the
//	benzodiazepinate family,
//<ページ数変更>
オタコン_002_1: {
e oltre alle propriet&`a antidepressive ed
ansiolitiche, sopprime le convulsioni.
}
//	<<<ENGLISH>>>
//	and along with its antidepressant
//	and anti-anxiety qualities, it
//	suppresses convulsions.

/*ベンゾジアゼピン系の抗不安薬で
鎮静作用、抗鬱作用と同時に
抗痙攣作用もある。
*/

オタコン_003: {
rendilo prima delle azioni da cecchino, per
ridurre al minimo i tremiti con il fucile di
precisione.
}
//	<<<ENGLISH>>>
//	Take it when you have a tough shot
//	ahead with the sniper rifle and you
//	need to minimize shakiness.
//<ページ数変更>
オタコン_003_1: {
Ma forse non ce l'hai ancora.
}
//	<<<ENGLISH>>>
//	But I guess you don't
//	have one of those yet.

/*スナイパー・ライフルで精密狙撃を
する時とかに手ぶれを抑えられるよ。
でも持ってないんじゃ意味ないか……。
*/

オタコン_004: {
Beh... puoi anche prendere un paio di
pentazemine se soffri di mal di mare.
}
//	<<<ENGLISH>>>
//	Well... you can also try some
//	if you're feeling really seasick.

/*そうだね。船酔いがひどいんだったら
飲んでみると良いと思うよ。
*/

}//d

//・ダンボール h //e
resource TO_ダンボール__i {
オタコン_000: {
Ah, usi il vecchio trucco della scatola di
cartone! Ti sta proprio bene, Snake.
}
//	<<<ENGLISH>>>
//	Using the old cardboard box trick,
//	huh? Looks good on you, Snake.
//<ページ数変更>
オタコン_000_1: {
La mimetizzazione &`e il modo migliore per
fuggire il nemico.
}
//	<<<ENGLISH>>>
//	Camouflage is the best way to
//	slip past enemy surveillance.

/*ダンボール箱をかぶってるね！
スネークはやっぱりそうでなくっちゃ。
うまく使って敵の目を誤魔化してくれ。
*/

オタコン_001: {
Ma alla fine il cartone &`e solo carta.
}
//	<<<ENGLISH>>>
//	But cardboard is just paper
//	when it comes down to it.
//<ページ数変更>
オタコン_001_1: {
Non resister&`a agli attacchi sostenuti.
}
//	<<<ENGLISH>>>
//	It won't withstand any
//	serious assault for long.

/*でもダンボールは所詮紙だってことを
忘れないでくれ。敵から何度も攻撃を
受けたら当然破けてしまう。
*/

オタコン_002: {
E non affidarti nemmeno troppe volte allo
stesso trucco. Ah, ti suggerisco di tenerlo
asciutto.
}
//	<<<ENGLISH>>>
//	Don't rely on the trick too many
//	times, either. And I recommend
//	you keep it dry.

/*使い過ぎてもヘタってくるから
気をつけてくれ。あまり濡らしたり
しない方がいいんじゃないかな？
*/

}//d


//追加分


resource TO_オルガ戦見つからずに移動せよ__i {
オタコン_000: {
Snake, non lasciare che indovini la tua
attuale posizione.
}
//	<<<ENGLISH>>>
//	Snake, don't let her figure
//	out your current position.
//<ページ数変更>
オタコン_000_1: {
Rimani nascosto dietro gli oggetti mentre ti
muovi e tieni lei all'oscuro di tutto.
}
//	<<<ENGLISH>>>
//	Stay hidden behind objects
//	while you move, and keep
//	her in the dark.

/*スネーク、相手に君の位置を悟らせるな。
物陰に隠れたまま移動すれば、相手は
君を見失うはずだ。
*/
オタコン_001: {
Prima o poi abbasser&`a la guardia. Quella
sar&`a la tua chance.
}
//	<<<ENGLISH>>>
//	She'll lower her guard at some
//	point. That's your opportunity.

/*必ず隙が出来る。そこを狙うんだ。
*/

}//d

resource TO_オルガ戦幌は通らない__i {
オタコン_000: {
Snake, sta sparando da dietro quel
tendone.
}
//	<<<ENGLISH>>>
//	Snake, she's shooting at you
//	from behind the tarpaulin.
//<ページ数変更>
オタコン_000_1: {
Ti pu&`o vedere ma la tenda blocca
completamente la tua visuale.
}
//	<<<ENGLISH>>>
//	She can see you, but the tarp's
//	completely blocking your view.

/*スネーク、相手は幌に隠れながら
撃ってきてる。向こうからは
君が見えるけど、君からは見えない。
*/

オタコン_001: {
Se le cose stanno cos&`i non hai scampo.
Fai qualcosa!
}
//	<<<ENGLISH>>>
//	You haven't got a prayer like this.
//	Do something about that tarp!

/*このままじゃ分が悪すぎる。
その幌を何とかするんだ！
*/

}//d

resource TO_オルガ戦ライト眩惑__i {
オタコン_000: {
Snake, togli di mezzo quella luce! Non
riuscirai a vedere niente con quel riflesso.
}
//	<<<ENGLISH>>>
//	Snake, get rid of that light!
//	You can't see anything with
//	that glare.
//<ページ数変更>
オタコン_000_1: {
Liberati di quella luce o sei spacciato!
}
//	<<<ENGLISH>>>
//	Shoot it out or you're
//	a sitting duck!

/*スネーク、そのライトはマズイ！
光に眩惑されて相手が見えなくなる。
ライトを消すんだ！
*/

}//d

resource TO_オルガ戦ヘッドショット__i {
オタコン_000: {
Gli effetti della pistola variano a seconda
del punto che colpisci.
}
//	<<<ENGLISH>>>
//	The handgun's effects vary
//	depending on where you
//	manage to land a shot.

/*ハンドガンの弾は相手のどこに
当たるかによって威力が変わって
くるんだ。
*/

オタコン_001: {
Mira alla testa per avere i massimi effetti.
Prendi la mira con la Visuale Soggettiva.
}
//	<<<ENGLISH>>>
//	Aim for the head for the highest
//	degree of damage. Use the First
//	Person View to take aim.

/*頭を狙えばより大きなダメージを
与えられる。主観攻撃でよく狙うんだ。
*/

}//d

resource TO_Ｌ１ボタンロックオン__i {
オタコン_000: {
Prendi la mira con la pistola e premi il
tasto L1 per agganciare automaticamente il
bersaglio
}
//	<<<ENGLISH>>>
//	Aim the gun and push the
//	L1 button to automatically
//	lock onto the target.

/*銃を構えてＬ１ボタンを押すと
敵に向かって自動的に照準を合わせる。
*/

オタコン_001: {
Puoi anche usare questa funzione nella
Visuale Soggettiva o nella Visuale dall'alto.
}
//	<<<ENGLISH>>>
//	You can use this feature from
//	First Person View or from Top
//	View as well.

/*＃｛俯瞰、フカン｝＃でも主観でも出来るから、
有効に使ってくれ。
*/

}//d

resource TO_階段魔人__i {
オタコン_000: {
Snake, ti hanno teso un'imboscata in cima
alle scale!
}
//	<<<ENGLISH>>>
//	Snake, they're waiting to ambush
//	you on top of the stairs!
//<ページ数変更>
オタコン_000_1: {
Non ce la farai mai a salire se ti sparano
dall'alto.
}
//	<<<ENGLISH>>>
//	There's no way you can make it up
//	while being sniped from above.

/*スネーク、階段の上に敵が待ち伏せ
してる！上から狙い撃ちされたら、
とてもその階段を上るのは無理だ！
*/

オタコン_001: {
Non puoi salire quelle scale finch&'e non ti
scrolli di dosso il nemico. Per il momento,
vieni fuori da l&`a!
}
//	<<<ENGLISH>>>
//	You can't get up those stairs until
//	you've shaken the enemy from your
//	trail. Get out of there for now!

/*階段を上るには敵を振り切るしかない。
とりあえず逃げるんだ！
*/

}//d


resource TO_エラー__i {
オタコン_000: {
BUG
}
/*ばぐっち！*/
}


resource TO_debug1__i {
オタコン_000: {
debug1
}

/**/
}


//追加ファイル達
resource TO_監視カメラ４__i {
オタコン_000: {
C'&`e un vicolo cieco proprio dietro la
telecamera. Usalo per guadagnare tempo.
}
//	<<<ENGLISH>>>
//	There's a blind spot right
//	beneath the camera. Use
//	it to buy some time.

/*あとカメラの真下は死角になってる。
それも利用するんだ。
*/
}


resource TO_操舵室デモ後オルガ戦前__i {
オタコン_000: {
Snake, ma quell'ombra...?
}
//	<<<ENGLISH>>>
//	Snake, is that shadow...?

/*スネーク、あの影は……？*/

スネーク_001: {
Chi sar&`a? ... Vado a controllare.
}
//	<<<ENGLISH>>>
//	Who is that?
//	...I'll check it out.

/*正体を調べる必要があるな。*/

オタコン_002: {
Stai all'erta, Snake.
}
//	<<<ENGLISH>>>
//	Watch yourself Snake.

/*気をつけてくれよ……。*/
}


//------------------------------
//続・追加ファイル達
//------------------------------
resource TO_オルガ戦前__i {
オタコン_000: {
Quel soldato che stava all'esterno
dell'infrastruttura non mi convince...
}
//	<<<ENGLISH>>>
//	There's something about that
//	soldier who was standing
//	outside the infrastructure.
//<ページ数変更>
オタコン_000_1: {
Usa il boccaporto a babordo
}
//	<<<ENGLISH>>>
//	I think you should check it out --
//	use the hatch on the port side of
//	the infrastructure
//<ページ数変更>
オタコン_000_2: {
dell'infrastruttura per andare sul ponte di
navigazione. 
}
//	<<<ENGLISH>>>
//	to get out onto the
//	navigational deck.

/*船橋の外にいた兵士……何か気になるな。
調べておいた方がいい。船橋左舷の
水密扉から航海甲板に出られるはずだ。
*/
オタコン_001: {
&`E l&`i che devi andare.
}
//	<<<ENGLISH>>>
//	That's where you need to go.

/*航海甲板に向かってくれ。*/
}//d



resource TO_銃撃戦飛び出し撃ち１__i {
オタコン_000: {
Non credo che ti permetteranno di infiltrarti
cos&`i facilmente nella stiva.
}
//	<<<ENGLISH>>>
//	I don't think they're going to
//	let you into the hold so easily.

/*敵も黙って君を船倉に入れる気は
ないみたいだ。
*/
スネーク_001: {
Allora dovr&`o affrontarli. Posso provare a
balzar fuori e colpirli nella Visuale
Angolare.
}
//	<<<ENGLISH>>>
//	I'll have to stand my ground and
//	fight. I can try a Jump-out shot
//	from Corner View.

/*ああ。ここは戦うしかないようだ。
ビハインドからの飛び出し撃ちを
使ってみるか……。
*/
オタコン_002: {
Buona idea.
}
//	<<<ENGLISH(2)>>>
//	Good idea.

/*そうだね。*/
}//d

//二回目以降 t //e
resource TO_銃撃戦飛び出し撃ち２__i {
オタコン_000: {
Se opti per questa tattica, puoi tenerti al
coperto e aspettare il momento giusto per
colpire.
}
//	<<<ENGLISH>>>
//	If you go with Jump-out shots,
//	you can wait behind cover for
//	the right time to get in a shot.

/*飛び出し撃ちを活用すれば、遮蔽物に
隠れながら相手の隙をみて銃撃を加える
ことが出来るだろう。
*/
オタコン_001: {
Seleziona l'arma e appiattisciti contro un
oggetto, poi passa alla Visuale Angolare.
}
//	<<<ENGLISH>>>
//	Select your gun and flatten
//	yourself against an object,
//	then switch to Corner View.

/*やり方は、まず銃を装備してから
遮蔽物に張り付いてビハインドカメラに
する。
*/
オタコン_002: {
Premi il tasto Attacco per balzare allo
scoperto e sorprendere il nemico.
}
//	<<<ENGLISH>>>
//	Hit the Attack button to pop out
//	and catch the enemy off guard.
//<ページ数変更>
オタコン_002_1: {
Rilascia il tasto Attacco per tornare al
coperto.
}
//	<<<ENGLISH>>>
//	Let go of the Attack button
//	to get back behind cover.

/*その状態から＃｛□、武器｝＃ボタンを押せば
飛び出し撃ちができる。＃｛□、武器｝＃ボタンを
離せば素早く遮蔽物の陰に戻る。
*/
オタコン_003: {
Aspetta una pausa nel fuoco del nemico e
poi attacca.
}
//	<<<ENGLISH>>>
//	Wait for a lull in the
//	enemy fire to strike.

/*敵の弾幕が途切れる瞬間を
見極めて攻撃に転じるんだ。*/
}//d

resource TO_タクティカルリロード１__i {
オタコン_000: {
Snake, cosa succederebbe se tu finissi le
munizioni nel bel mezzo di uno scontro a
fuoco?
}
//	<<<ENGLISH>>>
//	Snake, what if you run out of
//	ammunition during an exchange
//	of fire?
//<ページ数変更>
オタコン_000_1: {
Ti troveresti improvvisamente vulnerabile,
no?
}
//	<<<ENGLISH>>>
//	Leaves you suddenly
//	vulnerable, doesn't it?

/*スネーク、撃ち合っている最中に弾が
切れたら大きな隙を相手に見せることに
なるんじゃないか？
*/
スネーク_001: {
Questo non ti succederebbe con
la Ricarica Tattica.
}
//	<<<ENGLISH>>>
//	That wouldn't happen
//	with Tactical Reload.

/*ああ。だがタクティカル・リロードを
使えばそんなことにはならん。
*/
オタコン_002: {
Quindi cambia il caricatore prima che si
esaurisca.
}
//	<<<ENGLISH>>>
//	So change the magazine
//	before it becomes empty.
//<ページ数変更>
オタコン_002_1: {
In questo modo non finirai mai le munizioni
quando hai il nemico davanti.
}
//	<<<ENGLISH>>>
//	That way, you would never run
//	out when you're actually facing
//	the enemy.

/*敵の目の前で弾切れを起こす危険を
回避するため、弾倉が空になる前に
あらかじめ弾倉を交換しておく戦術だね。
*/
スネーク_003: {
Esattamente.
}
//	<<<ENGLISH(2)>>>
//	Exactly.

/*そうだ。*/
}//d

//二回目以降 t //e
resource TO_タクティカルリロード２__i {
オタコン_000: {
Per eseguire la Ricarica Tattica,
disequipaggia l'arma e poi riequipaggiala.
}
//	<<<ENGLISH>>>
//	To perform a Tactical Reload,
//	unequip the gun, then equip it
//	again.

/*タクティカル・リロードをするには
銃を装備から外してからもう一度
装備し直せばいい。
*/
オタコン_001: {
Ora l'arma dovrebbe avere un caricatore
nuovo.
}
//	<<<ENGLISH>>>
//	The gun should now be loaded
//	with a fresh magazine.
//<ページ数変更>
オタコン_001_1: {
Usa il tasto di cambio rapido, il tasto R2,
per quest'operazione.
}
//	<<<ENGLISH(2)>>>
//	Use the quick change button --
//	the R2 button -- for this one.

/*それで新しい弾倉を装填した状態になる。Ｒ２ボタンを素早く押してクイック
チェンジを使うといいだろう。
*/
}//d

resource TO_グレネード注意__i {
オタコン_000: {
Snake, hanno delle granate. Se ne vedi
arrivare una, taglia la corda.
}
//	<<<ENGLISH>>>
//	Snake, they've got grenades.
//	If you see an incoming one,
//	just get the hell out of there.

/*スネーク、敵はグレネードも装備して
いる。グレネードを投げられたらすぐに
逃げるんだ。
*/
}//d

resource TO_全滅させなければ駄目__i {
オタコン_000: {
Snake, il nemico ha deciso di non lasciarti
passare.
}
//	<<<ENGLISH>>>
//	Snake, the enemy's serious
//	about not letting you through.
//<ページ数変更>
オタコン_000_1: {
Non hai altra scelta, devi farli fuori tutti.
Inizia a sparare.
}
//	<<<ENGLISH>>>
//	You have no choice but to take
//	all of them out. Start firing.

/*スネーク、敵も必死みたいだ。
そこを突破するには敵を全て倒すしか
ないだろう。銃で応戦するんだ。
*/
}//d

resource TO_プロジェクタ切替__i {
オタコン_000: {
Ci sono due proiettori nella stiva.
}
//	<<<ENGLISH>>>
//	There are two projectors
//	in that cargo hold.
//<ページ数変更>
オタコン_000_1: {
Sembra che quando uno si accende l'altro
si spenga e viceversa.
}
//	<<<ENGLISH>>>
//	It looks like the feed is
//	being switched back and
//	forth between them.

/*その船倉にはプロジェクタが二つある。映像は交互に切り替えられている
みたいだ。
*/
オタコン_001: {
Naturalmente i Marines guarderanno in
direzione del proiettore attivato.
}
//	<<<ENGLISH>>>
//	The Marines would naturally be
//	looking towards the projector
//	that's currently in use.

/*海兵隊員達は当然映像の映っているプロジェクタの方に注目している。
*/
オタコン_002: {
Il che significa che quando l'altro proiettore
entra in funzione, anche loro si volteranno
da quella parte.
}
//	<<<ENGLISH>>>
//	Which means that when the switch
//	takes place, they'll change the
//	direction of their focus too.

/*つまりプロジェクタが切り替わったら
海兵隊員達の見ている方向もかわるって
ことだ。
*/
オタコン_003: {
Non abbassare la guardia. Se ti vedono, &`e
finita.
}
//	<<<ENGLISH>>>
//	Be on the lookout.
//	If they see you, it's all over.

/*気をつけてくれ。
見つかったら終わりだよ。
*/
}//d

resource TO_かねきゃっち__i {
オタコン_000: {
Dopo aver premuto il tasto Strisciare
nella modalit&`a Sospensione e quando stai
cadendo,
}
//	<<<ENGLISH>>>
//	After pushing the Crawl button
//	in Hanging mode and falling,
//<ページ数変更>
オタコン_000_1: {
se vedi un buon appiglio cerca di premere
il tasto Azione.
}
//	<<<ENGLISH>>>
//	If you see a good handhold,
//	try pushing the Action button.

/*エルードから×ボタンで落下している
途中につかめそうな場所があったら
△ボタンを押してみるといい。
*/
オタコン_001: {
Se lo premi al momento giusto, dovresti
riuscire a far presa.
}
//	<<<ENGLISH>>>
//	If you hit it just right, you
//	should be able to grab on.
//<ページ数変更>
オタコン_001_1: {
Non importa se la tua direzione &`e
leggermente sfalsata. Fai un po' di pratica.
}
//	<<<ENGLISH>>>
//	It won't matter if your direction
//	if off a little bit. Experiment with
//	it.

/*うまくすればつかまることが出来る
はずだ。多少方向がずれても大丈夫。
いろいろ試してみてくれ。
*/
}//d

resource TO_かねきっく__i {
オタコン_000: {
Mentre rimbalzi dalla modalit&`a Sospensione
con il tasto Azione,
}
//	<<<ENGLISH>>>
//	When you're springing up from
//	Hanging mode with the Action
//	button,
//<ページ数変更>
オタコン_000_1: {
puoi usare lo slancio per uccidere
qualcuno.
}
//	<<<ENGLISH>>>
//	you can use the momentum
//	to knee someone.

/*エルードから△ボタンで這い上がる時、
反動で近くにいる敵にひざを打ち込む
ことが出来る。
*/
オタコン_001: {
Se vedi un nemico vicino al corrimano,
provaci.
}
//	<<<ENGLISH>>>
//	If you see an enemy walking
//	near the railings, give it a try.

/*手すりのあたりを歩いている敵が
いたら狙ってみるといい。
*/
}//d

resource TO_インケン投げ__i {
オタコン_000: {
Seleziona la granata quando sbirci fuori.
}
//	<<<ENGLISH>>>
//	Select the grenade
//	when you take a peek.
//<ページ数変更>
オタコン_000_1: {
Poi potrai usare il tasto Armi per
lanciare la granata, mentre tu vai al
coperto nascondendoti dietro gli oggetti.
}
//	<<<ENGLISH>>>
//	You can then use the Weapon
//	button to throw the grenade
//	while taking cover behind objects.

/*覗き込みをしている時にグレネードを
装備していれば＃｛□、武器｝＃ボタンで遮蔽物に隠れ
ながらグレネードを投げることが出来る。
*/
}//d

resource TO_ホールドアップアイテム搾取１__i {
オタコン_000: {
Se sei fortunato, potresti impadronirti di un
oggetto da un nemico che tieni bloccato.
}
//	<<<ENGLISH>>>
//	If you get lucky, you could seize
//	an item from someone after you
//	hold them up.

/*敵をホールドアップさせた後、
うまくやればアイテムを奪うことが
出来るだろう。
*/
}//d

//ドッグタグホールドアップのみの場合 t //e

resource TO_ホールドアップアイテム搾取２__i {
オタコン_000: {
Ci sono alcuni oggetti ottenibili solo dai
soldati che tieni prigionieri. Se ne hai il
tempo, provaci.
}
//	<<<ENGLISH>>>
//	There are some items you can only
//	acquire from holdups. If you've got
//	the time, try it out.

/*ホールドアップからしか手に入らない
アイテムもあるみたいだ。余裕があれば
試してみるといい。
*/
}//d

resource TO_ドッグタグ取得後__i {
オタコン_000: {
Metti il visore agli infrarossi per guardare il
collo dei nemici.
}
//	<<<ENGLISH(2)>>>
//	Put your Thermal Goggles on and
//	look at the enemy's neck area.

/*＃｛赤外線、サーマル｝＃ゴーグルで敵兵士の
首のあたりをよく見てみるといい。
*/
オタコン_001: {
Dovresti riuscire a vedere se hanno una
piastrina di riconoscimento.
}
//	<<<ENGLISH>>>
//	You should be able to see
//	if he has dog tags on.

/*ドッグタグを持っているかどうかが
わかるはずだ。
*/
}//d




//信管ヤバイよ！ＸＸＸＸＸＸＸｘｘ
resource TO_グレネード__i {
//vox t:vcXXXXXXX {
オタコン_000: {
Vedo che hai eto la granata.
}
//	<<<ENGLISH>>>
//	I see you have the
//	grenade equipped.
//<ページ数変更>
オタコン_000_1: {
&`E una granata antiuomo che, se lanciata
contro un nemico,
}
//	<<<ENGLISH>>>
//	It's an anti-personnel frag
//	grenade -- throw it at the
//	enemy
//<ページ数変更>
オタコン_000_2: {
si frammenta in mille pezzi e lo distrugge.
}
//	<<<ENGLISH>>>
//	and the blast and fragments
//	will take the enemy out.

/*グレネードを装備してるね。
投擲用の対人破片手榴弾だ。
爆風と破片で敵を倒すことが出来る。
*/
オタコン_001: {
Attento - se premi il tasto Armi togli la
sicura.
}
//	<<<ENGLISH(2)>>>
//	Watch out -- pushing the Weapon
//	button will pull out the pin.
//<ページ数変更>
オタコン_001_1: {
Rilascia il tasto Armi per lanciare la
granata.
}
//	<<<ENGLISH>>>
//	Release the Weapon
//	button to toss it.
//<ページ数変更>
オタコン_001_2: {
La distanza di lancio dipende dalla forza
con cui premi il tasto Armi.
}
//	<<<ENGLISH>>>
//	The throwing distance depends
//	on how hard you push the Weapon
//	button.

/*□ボタンを押すと信管を抜いて構え、
□ボタンを離すと投げる。□ボタンを
押した時の強さで投擲距離が変わるよ。
*/
オタコン_002: {
Dopo aver tolto la sicura, avrai 5 secondi
prima che la granata esploda.
}
//	<<<ENGLISH>>>
//	After pulling the pin, you'll
//	have five seconds until the
//	grenade explodes.
//<ページ数変更>
オタコン_002_1: {
Impara a cambiare la sincronizzazione e la
distanza di tiro della granata prima che
esploda.
}
//	<<<ENGLISH>>>
//	Get familiar with changing the
//	timing and throwing distance of
//	the grenade before it goes off.

/*構えてから爆発するまで約５秒ある。
爆発するまでの時間と投げる距離が
変えられる点をうまく使いこなすんだ。
*/
//dv}//v
}//d


resource TO_赤外線ゴーグル１__i {
//vox t:vcxxxxxxxxxx {
オタコン_000: {
Hai il Visore Termico, eh?
}
//	<<<ENGLISH>>>
//	You have the Thermal
//	Goggles equipped huh?
//<ページ数変更>
オタコン_000_1: {
Ti permette di vedere di notte, usando le
variazioni nella distribuzione del calore per
generare un'immagine.
}
//	<<<ENGLISH>>>
//	They provide night vision by using
//	variances in heat distribution to
//	create an image.

/*サーマル赤外線ゴーグルを使ってるね。
赤外線ゴーグルは物体の熱分布を
映像化する暗視装置だ。
*/

オタコン_001: {
Usa un sistema di proiezione
bidimensionale in fase solida per generare
immagini pi&`u accurate,
}
//	<<<ENGLISH>>>
//	It uses a two dimensional solid
//	state projection system to create
//	high-res images
//<ページ数変更>
オタコン_001_1: {
a 60 fotogrammi al secondo in tempo
reale.
}
//	<<<ENGLISH>>>
//	at sixty fps in real-time.

/*二次元固体撮像素子方式を採用して
高解像度、高感度で６０フレームの
リアルタイム映像を実現している。
*/
//dv}//v
}//d

//ドッグタグもっている場合
resource TO_赤外線ゴーグル２__i {
//vox t:vcxxxxxxxxxx {
オタコン_000: {
Usando il Visore Termico potrai osservare
il collo del nemico e scoprire se ha una
piastrina di riconoscimento.
}
//	<<<ENGLISH>>>
//	By using the Thermal Goggles, you
//	can take a look at the enemy's neck
//	to see if they have dog tags or not.

/*サーマル赤外線ゴーグルで敵兵士の
首もとを見てみればドッグタグを
もってるかどうかわかるかもしれないな。
*/
//dv}//v
}//d

resource TO_Ｍ４__i {
//vox t:vcxxxxxxxxxx {
オタコン_000: {
Vedo che hai equipaggiato l'M4. &`E una
carabina d'assalto di tipo standard per le
truppe SOCOM.
}
//	<<<ENGLISH>>>
//	I see you have the M4 equipped.
//	It's a standard issue assault
//	carbine for SOCOM troops.

/*Ｍ４を持ってるね。
＃｛米特殊作戦、ＵＳ．ＳＯＯＭ｝＃コマンドで正式採用されてる
アサルトカービン銃だ。
*/

オタコン_001: {
Come l'M16A2, usa colpi da 5,56 mm e
pu&`o avere 30 colpi per ciascun caricatore.
}
//	<<<ENGLISH>>>
//	Like the M16A2, it uses 5.56mm
//	cartridges, and can hold thirty
//	per magazine.

/*Ｍ１６Ａ２と同じ５．５６ｍｍ弾を使う。
装弾数は３０発だ
*/
オタコン_002: {
Ha un ricevitore superiore piatto e
un'impugnatura staccabile per il trasporto.
}
//	<<<ENGLISH>>>
//	It features a flat top upper
//	receiver and a detachable
//	carrying handle,
//<ページ数変更>
オタコン_002_1: {
Puoi configurarlo in base alle specifiche
delle Forze Speciali.
}
//	<<<ENGLISH>>>
//	and it can be configured
//	to the specifications of
//	the Special Forces.

/*フラットトップレシーバーと着脱式
キャリングハンドルなど特殊部隊の
要求に合わせた仕様になっている。
*/
//dv}//v
}//d

resource TO_生体センサー__i {
//vox t:vcxxxxxxxxxx {
オタコン_000: {
Stai usando il sensore antiuomo, vedo.
}
//	<<<ENGLISH>>>
//	You're using the Anti-personnel
//	Sensor, I see.
//<ページ数変更>
オタコン_000_1: {
Misura i campi elettromagnetici e il battito
cardiaco degli esseri viventi
}
//	<<<ENGLISH>>>
//	It measures the electromagnetic
//	fields and heartbeat of life forms＃－
//<ページ数変更>
オタコン_000_2: {
e trasforma i dati in vibrazioni.
}
//	<<<ENGLISH>>>
//	and converts the data
//	into vibrations.

/*生体センサーを使っているね。
人間の鼓動や微弱な生体電磁波を
検知して振動に変換するデバイスだ。
*/
オタコン_001: {
Se un nemico si avvicina, vibra.
}
//	If an enemy draws near,
//	it will vibrate.
//<ページ数変更>
オタコン_001_1: {
Pi&`u forte vibra e pi&`u vicino &`e il nemico.
}
//	<<<ENGLISH>>>
//	The stronger the vibration,
//	the closer the enemy is.

/*敵が接近すると振動して知らせてくれる。
振動が強いほど敵が近くにいるって
ことだ。
*/
オタコン_002: {
Ma ricorda: quando usi il sensore antiuomo
potrai solo sentire
}
//	<<<ENGLISH>>>
//	But, remember, when using
//	the Anti-personnel Sensor,
//<ページ数変更>
オタコン_002_1: {
le vibrazioni generate dal sensore.
}
//	<<<ENGLISH>>>
//	you'll only be able to feel
//	the vibrations coming from
//	the sensor.

/*ただ、生体センサーを使ってる間は
センサーが発生させる振動しか感じ取れ
なくなるってことは覚えておいてくれ。
*/
//dv}//v
}//d

resource TO_機関室エルード__i {
//vox t:vcXXXXXXXX {
オタコン_000: {
Snake, la sala motori &`e piena di strutture
solide. 
}
//	<<<ENGLISH>>>
//	Snake, the engine room is
//	full of solid structures --
//<ページ数変更>
オタコン_000_1: {
Probabilmente le puoi usare per dileguarti
quando il nemico ti sta alle calcagna.
}
//	<<<ENGLISH>>>
//	you could probably use them
//	to get away when the enemy
//	is chasing you.

/*スネーク、機関室は立体的な構造に
なっている。それを利用すれば敵に
追われても逃げられるかもしれない。
*/

オタコン_001: {
Usa accortamente la modalit&`a
Sospensione.
}
//	<<<ENGLISH>>>
//	Use the Hanging mode wisely.

/*エルードをうまく使うんだ。*/
//dv}//v
}//d

resource TO_タンカーカメラうんちく１__i {
//vox t:vcXXXXXXXX {
オタコン_000: {
Ora ti spiego come usare la fotocamera.
}
//	<<<ENGLISH>>>
//	I'll explain how
//	to use the camera.

/*カメラの説明をしておこうか。*/

オタコン_001: {
La fotocamera digitale che hai &`e stata
progettata proprio per scattare foto del
prototipo del Metal Gear.
}
//	<<<ENGLISH>>>
//	That digital camera you have was
//	specially made to take pictures of
//	the prototype Metal Gear.

/*君が持ってるのは新型メタルギアの
写真を撮るために作った特別製の
デジタルカメラだ。
*/

オタコン_002: {
Quando scatti una foto, i dati su schermo
vengono prima memorizzati nella
fotocamera.
}
//	<<<ENGLISH>>>
//	When a picture is taken, the screen
//	data is first stored in the camera's
//	internal memory.

/*写真を撮るとその画像データはまず
カメラ本体に内蔵されたメモリーの中に
格納される。
*/

オタコン_003: {
Poi vengono elaborati automaticamente
attraverso vari algoritmi, per proteggerli dai
tentativi di manomissione.
}
//	<<<ENGLISH>>>
//	Then it's automatically processed
//	through various algorithms to
//	protect against tampering.

/*そこで電子的改竄を防ぐための
色々な処理が自動的に行われるように
なってるんだ。
*/

オタコン_004: {
Ogni immagine viene contrassegnata
elettronicamente e codificata
separatamente.
}
//	<<<ENGLISH>>>
//	Each picture is electronically
//	stamped and distinctively
//	encrypted.
//<ページ数変更>
オタコン_004_1: {
Quindi, anche se qualcuno dovesse
alterare i dati in fase di trasmissione, lo
scopriremmo subito.
}
//	<<<ENGLISH>>>
//	So, in the off chance that someone
//	alters the data during transmission,
//	we'll know immediately.

/*電子透かしを埋め込んだり特製の暗号を
かけたりね。だから万一転送途中で誰か
にデータをいじられてもすぐにわかる。
*/

オタコン_005: {
Ah - per&`o la memoria interna ha una
capacit&`a limitata.
}
//	<<<ENGLISH>>>
//	Oh -- there's a limit to the
//	internal memory's capacity.

/*ただ、カメラの内蔵メモリーの容量には
限界があるんだ。
*/

オタコン_006: {
Se la memoria si riempie, sovrascrivi le
foto che non ti servono pi&`u.
}
//	<<<ENGLISH>>>
//	If the memory becomes full,
//	overwrite the pictures you
//	don't need anymore.

/*メモリーがいっぱいになったら、
いらない写真に上書きするといい。
*/
//dv}//v
}//d

//場合１ t //e
resource TO_タンカーカメラうんちく２__i {
//vox t:vcxxxxxxxx {
オタコン_000: {
Quando sei pronto a scattare,
}
//	<<<ENGLISH(2)>>>
//	When you're ready to take a shot,
//<ページ数変更>
オタコン_000_1: {
usa i tasti L1 e R1 per spostare il cursore
alla base dello schermo verso destra o
verso sinistra.
}
//	<<<ENGLISH>>>
//	use the L1 and R1 buttons to move
//	the cursor at the bottom of the screen
//	to the left or right.

/*カメラを構えた状態でＬ１ボタン、
Ｒ１ボタンを押すと画面下のカーソルを
それぞれ左右に動かせる。
*/
//dv}//v
}//d

//場合２ t //e
resource TO_タンカーカメラうんちく３__i {
//vox t:vcxxxxxxxx {
オタコン_000: {
Quando sei pronto a scattare, usa i tasti
L1 ed R1 per scorrere a sinistra o a destra
}
//	<<<ENGLISH>>>
//	When you're ready to take a shot,
//	use the L1 and R1 buttons to scroll
//	left or right＃－
//<ページ数変更>
オタコン_000_1: {
i provini delle foto, sulla base dello
schermo.
}
//	<<<ENGLISH>>>
//	among the picture previews
//	at the bottom of the screen.

/*カメラを構えた状態でＬ１ボタン、
Ｒ１ボタンを押すと画面下の写真の
プレビューをそれぞれ左右に動かせる。
*/
//dv}//v
}//d

resource TO_タンカーカメラうんちく４__i {
//vox t:vcxxxxxxxx {
オタコン_000: {
Seleziona un'immagine che non ti serve e
la nuova foto sar&`a sovrimposta su quella
vecchia.
}
//	<<<ENGLISH>>>
//	Select an unwanted picture and
//	the new shot will overwrite the
//	selected picture.

/*いらない写真を選んでそのまま写真を
撮れば、新しい写真をそこに上書き
出来るっていう仕組みだ。
*/
//dv}//v
}//d

//第三船倉にいる場合 t //e
resource TO_タンカーカメラうんちく５__i {
//vox t:vcxxxxxxxx {
オタコン_000: {
Quando hai finito, mandami le foto.
}
//	<<<ENGLISH>>>
//	Send the pictures to
//	me when you're done.

/*写真を撮り終えたらこっちに
転送してくれ。
*/
オタコン_001: {
Premi il tasto Azione quando ti trovi
davanti al terminale, a sud est di dove ti
trovi ora.
}
//	<<<ENGLISH(2)>>>
//	Press the Action button when
//	you're in front of the workstation
//	southeast from there,
//<ページ数変更>
オタコン_001_1: {
In questo modo mi trasmetterai le foto.
}
//	<<<ENGLISH>>>
//	and the pictures will
//	be sent to me.
//<ページ数変更>
オタコン_001_2: {
Scattane di belle!
}
//	<<<ENGLISH>>>
//	Get some good shots!

/*写真を転送する方法はそのエリアの
南東にあるＷＳの前で＃｛△、アクション｝＃ボタンを
押すだけだ。いい写真を頼むよ。
*/
//dv}//v
}//d

//・開かない水密扉近く h //e
