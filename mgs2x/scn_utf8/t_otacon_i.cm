}//d


//○第一船倉(w04a) d //e
//・はしご近く：はしごの上り下り方法 h //e
resource TO_はしご__i {
オタコン_000: {
Snake, mettiti di fronte alla scala e premi il
tasto Azione per afferrarla.
}
//	<<<ENGLISH>>>
//	Snake, face the ladder and push
//	the Action button to grab onto
//	the ladder.

/*スネーク、ハシゴにつかまるには
ハシゴに向かって＃｛△、アクション｝＃ボタンを押すんだ。
*/

オタコン_001: {
Premi nuovamente il tasto Azione in cima
o ai piedi della scala per mollare la presa.
}
//	<<<ENGLISH>>>
//	Push the Action button again at
//	the top or the foot of the ladder
//	to let go.

/*ハシゴから離れたくなったら、
ハシゴの一番上か一番下でもう一度
＃｛△、アクション｝＃ボタンを押せばいい。
*/

オタコン_002: {
Ricordati: quando sali o scendi una scala,
non potrai usare nessun'arma.
}
//	<<<ENGLISH>>>
//	Remember, while you're going up or
//	down a ladder, you won't be able to
//	use any weapons.

/*ただ、ハシゴを上り下りしてる間は
武器は使えないから、気をつけてくれ。
*/
//＠はしご中は無敵？
}//d

//・プロジェクタ：プロジェクタについての注意 h //e
resource TO_プロジェクタ１__i {
オタコン_000: {
Snake, lo vedi quel proiettore?
}
//	<<<ENGLISH>>>
//	Snake, you see that
//	projector there?
//<ページ数変更>
オタコン_000_1: {
Guarda che immagini mostra se provi a
girarlo sullo schermo davanti a te.
}
//	<<<ENGLISH>>>
//	See what comes up if you turn it
//	onto the screen in front of you.

/*スネーク、そこにプロジェクタが
あるだろ。それで前にあるスクリーンに
映像を映してるんだ。
*/
}


//・一回目のみ t //e　　（二回目？）
resource TO_プロジェクタ２__i {
オタコン_000: {
Tiro un po' ad indovinare qui, ma secondo
me non c'&`e molto spazio per i marines
nella stiva dove hanno messo Metal Gear.
}
//	<<<ENGLISH>>>
//	I'm guessing there isn't enough space
//	for all the Marines in that farthest hold
//	where Metal Gear is.

/*メタルギアのある一番奥の船倉に
海兵隊員が入りきらないからだろう。
*/
}


//・リフレッシュ室ＴＶ前会話聞いてない場合のみ t //e
resource TO_プロジェクタ３__i {
オタコン_000: {
Allora trasmettono le immagini dal vivo -
}
//	<<<ENGLISH>>>
//	So they're broadcasting
//	the live proceedings --

/*だから中継してる映像を利用して……。*/

スネーク_000: {
Ma perch&'e rischiano trasmettendo questa
roba?
}
//	<<<ENGLISH>>>
//	Why risk broadcasting
//	in the first place?

/*そもそも、なぜ中継を？
*/
//・ＴＶ会話へ t //e
}


resource TO_プロジェクタ４__i {
//e
オタコン_000: {
Non passare davanti al proiettore,
altrimenti il nemico potrebbe vedere la tua
ombra.
}
//	<<<ENGLISH>>>
//	Don't cut across in front of
//	the projector, or the enemy
//	may spot your shadow.

/*不用意にプロジェクタの前を横切ったら
スクリーンに影が映って敵に見つかって
しまう。気をつけてくれ。
*/

オタコン_001: {
Attraversa l'area strisciando, se vuoi
spostarti davanti al proiettore.
}
//	<<<ENGLISH>>>
//	Crawl across if you need to
//	move in front of the projector.

/*プロジェクタの前はホフクして進むんだ。
*/

}//d




//・鳴り床：鳴り床注意 h //e
resource TO_鳴り床__i {
オタコン_000: {
Snake, non puoi camminare su quel
pavimento senza fare un sacco di rumore.
}
//	<<<ENGLISH>>>
//	Snake, you can't walk on that
//	floor without causing a racket.
//<ページ数変更>
オタコン_000_1: {
E se qualcuno ti sente, sei nei guai.
}
//	<<<ENGLISH>>>
//	You'll be in trouble if
//	someone hears you.

/*スネーク、そこの床は歩くと音が
鳴ってしまうみたいだ。
足音を聞かれたら厄介なことになる。
*/
}



resource TO_鳴り床２__i {
オタコン_000: {
Per muoverti pi&`u silenziosamente, prova a
strisciare, oppure cammina pi&`u piano,
spingendo poco alla volta la levetta
analogica sinistra.
}
//	<<<ENGLISH>>>
//	To move more quietly, try crawling,
//	or walk slower by pushing the left
//	analog stick a little bit at a time.

/*足音を立てないように進むには、
ホフクするか、左スティックの倒し方を
少しだけにしてゆっくり歩けばいい。
*/

}//d

//・一階：船倉兵の動きについて h //e
resource TO_船倉兵__i {
オタコン_000: {
Se qualcuno dovesse notare qualcosa ed
iniziasse a camminare nella tua direzione,
eliminalo subito o togliti dai piedi.
}
//	<<<ENGLISH>>>
//	If someone notices something and
//	starts walking towards you, take
//	him out quickly or get out of there.

/*もしも気づかれて海兵隊員が近づいて
来たら、見つかる前に素早く倒すか、
逃げるかするんだ。
*/

オタコン_001: {
Sarebbe davvero un suicidio affrontare tutti
quei marines.
}
//	<<<ENGLISH>>>
//	It really would be suicide to
//	take on that many Marines.
//<ページ数変更>
オタコン_001_1: {
Non puoi permetterti di venire scoperto -
credimi sulla parola.
}
//	<<<ENGLISH>>>
//	You can't afford to be discovered --
//	trust me on this one.

/*あの人数の海兵隊はとても相手に
出来ない。絶対に見つかっちゃダメだ。
いいね。
*/
//＠船倉兵は追ってくる一人を倒せばいい？

}//d

//・ハッチはアクションボタンで開く h //e
resource TO_船倉地下ハッチ__i {
オタコン_000: {
Snake, guarda quel boccaporto.
Probabilmente porta ad una rete di condotti
sottocoperta.
}
//	<<<ENGLISH>>>
//	Snake, look at that hatch over
//	there. It probably connects to
//	a below-deck network of ducts.

/*スネーク、そこにハッチがある。
多分下層のダクトに通じてるんだ。
*/

オタコン_001: {
Mettiti di fronte al boccaporto e premi il
tasto Azione per aprirlo.
}
//	<<<ENGLISH>>>
//	Face the hatch and push
//	the Action button to open
//	it.

/*ハッチを開けるには、ハッチに向かって
＃｛△、アクション｝＃ボタンを押せばいい。
*/

}//d

//・ハッチ下：ホフクでダクトに入れる h //e
//
resource TO_船倉ハッチ下__i {
オタコン_000: {
Penso che ci sia un'entrata nei condotti.
C'&`e appena spazio per entrare carponi.
Forza!
}
//	<<<ENGLISH>>>
//	I think it's an entrance into
//	the ducts. There's just enough
//	room for you to crawl in.

/*そこはダクトの入口になってる
みたいだね。
ホフクすれば中に入れるはずだ。
*/

オタコン_001: {
Potresti essere pi&`u al sicuro sotto che
sopraccoperta. Ma non abbassare troppo
la guardia.
}
//	<<<ENGLISH>>>
//	It could be safer for you down there
//	than above deck. But don't let that
//	relax you.

/*ダクトの中を進むのは上を行くより
安全かもしれないな。
でも気は抜かないでくれ。
*/

}//d


//・長廊下からのドア近く h //e
resource TO_船倉ロックドア__i {
オタコン_000: {
Snake, quel boccaporto &`e chiuso dall'altro
lato. Ora non puoi tornare indietro.
Continua a muoverti.
}
//	<<<ENGLISH>>>
//	Snake, that door is locked from
//	the other side. There's no way
//	back now. Keep moving.

/*スネーク、そこのドアは外からロック
されてる。もう後戻りは出来ない。
先に進むんだ。
*/

}//d

//・地下小部屋：物音立てると死ぬ h //e
resource TO_船倉地下小部屋__i {
オタコン_000: {
Snake, ti scopriranno se fai molto rumore,
anche dentro quel condotto.
}
//	<<<ENGLISH>>>
//	Snake, they'll find you if you make
//	any loud noises, even inside that
//	duct.

/*スネーク、ダクトの中にいても、
大きな音を立てたら見つかってしまうと
思う。
*/
//＠ダクト内で発砲で死亡？

オタコン_001: {
Non ce la faresti mai ad affrontarli tutti
insieme.
}
//	<<<ENGLISH>>>
//	There's no way you can
//	take on that many of them.

/*あの人数に囲まれたら、
いくら君でもどうしようもない。
*/

オタコン_002: {
Non pensare nemmeno di usare una
pistola, okay? Capito?
}
//	<<<ENGLISH>>>
//	Don't even think about firing
//	a gun, okay? Please?

/*絶対に銃を撃ったりしちゃダメだ。
いいね。
*/

}//d


//・ＴＶ兵近く：ＴＶ兵について h //e
resource TO_船倉ＴＶ兵__i {
//
オタコン_000: {
Oh, allora era lui che trasmetteva tutta
questa roba.
}
//	<<<ENGLISH>>>
//	Oh, so he was broadcasting
//	all this stuff.

/*映像はその兵隊が中継してたんだね。
*/
//ＴＶ会話聞いていない場合、ＴＶ会話へ t //e

}//d

//・消防ポール上側近く：下り方。一度下りたら上れない h //e
resource TO_ポール上__i {
オタコン_000: {
Snake, puoi usare quel palo per scendere
al livello inferiore.
}
//	<<<ENGLISH>>>
//	Snake, you can use that pole to
//	get down to the level below.

/*スネーク、そこにあるポールをつたえば
下の階に下りられるはずだ。
*/

オタコン_001: {
Mettiti di fronte al palo e premi il tasto
Azione per aggrapparti.
}
//	<<<ENGLISH>>>
//	Face the pole and push the Action
//	button to grab a hold of the pole.

/*ポールにつかまるにはポールの方を向いて＃｛△、アクション｝＃ボタンを押せばいい。*/

オタコン_002: {
Ma una volta scivolato gi&`u,
non potrai tornare indietro...
}
//	<<<ENGLISH>>>
//	But once you slide down, you
//	won't be able to go back up.
//<ページ数変更>
オタコン_002_1: {
Prima di scendere, controlla di aver finito
tutto quello che devi fare su questo livello.
}
//	<<<ENGLISH>>>
//	Make sure you're finished with
//	this floor before going down.

/*でも一度下りたら、もう上には上がれ
ないだろう。下りるのはその階でしたい
ことを全部終えてからの方がいいね。
*/

}//d

//・消防ポール下側近く：下からは上れません h //e
resource TO_ポール下__i {
オタコン_000: {
Snake, non potrai risalire usando quel
palo. 
}
//	<<<ENGLISH>>>
//	Snake, you're not going to be
//	able to climb back up that thing.
//<ページ数変更>
オタコン_000_1: {
Se fossi in te lascerei perdere l'idea di
salire fino a quel livello.
}
//	<<<ENGLISH>>>
//	You should forget about
//	going up to that level.

/*スネーク、そのポール、下からは
上れないそうにない。上の階に行くのは
諦めたほうがいいね。
*/

}//d


//・電送機近く：電送機について h //e
resource TO_電送機__i {
オタコン_000: {
Snake, quel terminale &`e il punto di
trasferimento fra l'intranet del tanker e il
mondo esterno.
}
//	<<<ENGLISH>>>
//	Snake, that workstation is the
//	transfer point between the tanker's
//	intranet and the outside world.
//<ページ数変更>
オタコン_000_1: {
Usalo per trasmettere quelle immagini.
}
//	<<<ENGLISH>>>
//	Use it to send those pictures over.

/*スネーク、そこにあるコンピュータが
外に繋がってるＷＳだ。
それを使って写真をこっちに送ってくれ。
*/

オタコン_001: {
Devi solo metterti di fronte al computer e
premere il tasto Azione:
}
//	<<<ENGLISH>>>
//	All you have to do is face the
//	computer and push the Action
//	button,
//<ページ数変更>
オタコン_001_1: {
ora tutte le foto vengono inviate.
}
//	<<<ENGLISH>>>
//	and the photos will be sent. 

/*写真を送信する時は、そのＷＳの前に
立って＃｛△、アクション｝＃ボタンを押すだけでいい。
*/

オタコン_002: {
Spero che tu abbia fatto delle belle foto!
}
//	<<<ENGLISH>>>
//	Hope you took a good one!

/*いい写真を頼むよ！*/

}//d

//・二回目のみ h //e
resource TO_電送機説明__i {
オタコン_000: {
Quel terminale &`e collegato con l'intera rete
militare.
}
//	<<<ENGLISH>>>
//	That workstation is hooked up
//	to the greater military network;
//<ページ数変更>
オタコン_000_1: {
L'audio nella stiva viene trasmesso
all'esterno da quella macchina.
}
//	<<<ENGLISH>>>
//	the speech in the holds is being
//	relayed out through that machine.
//<ページ数変更>
オタコン_000_2: {
Anche noi la useremo.
}
//	<<<ENGLISH>>>
//	We'll be making use of it too.

/*そのＷＳは軍事ネットワークに
繋がってる。演説の映像もそこから送信
されているんだ。それを僕らは利用する。
*/

オタコン_001: {
Sono riuscito a fare contatto con un router
IC dell'esercito in Ohio.
}
//	<<<ENGLISH>>>
//	I managed to get in through
//	an Army IC router in Ohio.

/*僕はオハイオにある陸軍のインター
ネット・コントローラ・ルーターから
軍事ネットワークに侵入した。
*/

オタコン_002: {
Ho usato semplicemente il Link-16 per
installare remotamente qualche driver
}
//	<<<ENGLISH>>>
//	All I had to do from there was
//	use the Link-16 to remotely
//	install a few drivers＃－
//<ページ数変更>
オタコン_002_1: {
e un'applicazione su quel terminale.
}
//	<<<ENGLISH>>>
//	and an application onto
//	that workstation.
//<ページ数変更>
オタコン_002_2: {
Cos&`i la tua telecamera pu&`o parlare col loro
computer ora.
}
//	<<<ENGLISH>>>
//	So your camera can talk
//	to their computer now.

/*そこからリンク１６経由でそのＷＳに
写真を送信するためのアプリケーション
をリモート・インストールしたのさ。
*/

オタコン_003: {
Ehi, persino le reti militari usano prodotti
basati sulla tecnologia in commercio.
}
//	<<<ENGLISH>>>
//	Hey, even military networks use
//	products based on commercial
//	technology.
//<ページ数変更>
オタコン_003_1: {
Insomma, niente di sconosciuto.
}
//	<<<ENGLISH>>>
//	Nothing too unfamiliar there.

/*なに、軍事ネットワークは基本的に
民生品ベースの技術を応用してるからね。
軽いもんだよ。
*/

オタコン_004: {
In pi&`u, quando ancora avevo accesso, mi
sono messo qualcosa da parte.
}
//	<<<ENGLISH>>>
//	Besides, I cut myself a back
//	door when I still had access.
//<ページ数変更>
オタコン_004_1: {
Avevo molti privilegi d'accesso quando
sviluppavamo REX.
}
//	<<<ENGLISH>>>
//	I had a lot of access privileges
//	while we were developing REX.

/*それにあらかじめバックドアも仕掛けて
あったんだ。ＲＥＸを作ってた時に
陸軍のネットにはアクセス出来たから。
*/

オタコン_005: {
Ehi, mi stai ascoltando?
}
//	<<<ENGLISH>>>
//	Hey, are you listening?

/*ねぇ話聞いてる？*/

スネーク_000: {
Oh, ah, s&`i...
}
//	<<<ENGLISH>>>
//	Oh, ah, yeah...

/*あ、ああ……。*/

オタコン_006: {
Sicuro? Comunque, il programma
compatta, codifica e impacchetta i dati
dell'immagine fotografica.
}
//	<<<ENGLISH>>>
//	Really? Anyway, the program will
//	compress, encrypt and packetize
//	the photo's image data.
//<ページ数変更>
オタコン_006_1: {
Ho usato BATON per codificare, tra
parentesi.
}
//	<<<ENGLISH>>>
//	I used BATON for encryption,
//	by the way.

/*本当に？で、そのアプリは写真のデータ
を圧縮・暗号化・分割して送信する。
暗号化にはＢＡＴＯＮを使ったよ。
*/

オタコン_007: {
E il bello &`e che - i pacchetti hanno
l'aspetto del formato TADIL-J per
messaggi.
}
//	<<<ENGLISH>>>
//	And the beauty of it is -- the packets
//	are disguised to look like the TADIL-J
//	message format.
//<ページ数変更>
オタコン_007_1: {
Capito? &`E il formato standard per
messaggi in Tactical Digital Information
Link,
}
//	<<<ENGLISH>>>
//	Get it? It's the standard Tactical
//	Digital Information Link message
//	format,
//<ページ数変更>
オタコン_007_2: {
quindi i pacchetti sono inviati nascosti dalla
loro stessa trasmissione audio.
}
//	<<<ENGLISH>>>
//	and the packets will be sent out
//	cloaked by their own speech
//	broadcast.

/*パケットは＃｛戦術デジタル情報リンク、ＴＡＤＩＬ｝＃
Ｊメッセージフォーマットに偽装され、
演説の画像に紛れて送信されるんだ。
*/


オタコン_008: {
E tu prova a dirmi che non &`e geniale!
}
//	<<<ENGLISH>>>
//	Tell me that isn't brilliant!

/*どう？わかった？*/

スネーク_001: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/

オタコン_009: {
Vuoi che ti ripeta il tutto?
}
//	<<<ENGLISH>>>
//	Want me to go over it again?

/*もう一回説明しようか？*/

スネーク_002: {
No, no, una volta basta e avanza.
}
//	<<<ENGLISH>>>
//	No, once was enough.

/*いや、もう充分だ。*/

}//d


//・カメラ使い方 h //e
resource TO_カメラ使い方１__i {
オタコン_000: {
Snake, usa la telecamera per fotografare il
prototipo del nuovo Metal Gear.
}
//	<<<ENGLISH>>>
//	Snake, use the camera to take
//	photos of the new Metal Gear
//	prototype.

/*スネーク、カメラで新型メタルギアの
写真を撮ってくれ。
*/
}


//＠カメラの仕様ボタンは固定？ //e
//没ＸＸＸＸＸＸＸＸＸＸＸＸｘ
resource TO_カメラ使い方２__i {
オタコン_000: {
La telecamera &`e facile da usare.
}
//	<<<ENGLISH>>>
//	The camera's pretty easy to use.
//<ページ数変更>
オタコン_000_1: {
Ingrandisci con il tasto <cerchio>, riduci
con il tasto <X> e registra un'immagine
con il tasto <quadrato>.
}
//	<<<ENGLISH>>>
//	Zoom in with the <circle> button,
//	out with the <X> button, and record
//	an image with the <square> button.

/*カメラの使い方は簡単だよ。○ボタンで
ズームアップ、×ボタンでズームバック、
□ボタンで写真を撮る。
*/
}


//保険 t //e
resource TO_カメラ使い方３__i {
オタコン_000: {
Guarda la Finestra Oggetti per controllare
di nuovo le istruzioni della telecamera.
}
//	<<<ENGLISH>>>
//	Look at the Item Window to check
//	the camera's instructions again.

/*カメラの使い方はアイテムウィンドウの
説明を見ればわかるよ。
*/
}


//没ＸＸＸＸＸＸＸＸ
resource TO_カメラ使い方４__i {
オタコン_000: {
Ma non dimenticare che ti serve
una MEMORY CARD (PS2) per
registrare un'immagine fotografica.
}
//	<<<ENGLISH>>>
//	But don't forget that you need
//	the MEMORY CARD (PlayStation&@R2)
//	to record a photo image.

/*ただ注意してくれ。
写真を保存するには"PlayStation2"専用
メモリーカード(8MB)が必要なんだ。
*/
}


//没ＸＸＸＸＸＸＸＸ
resource TO_カメラ使い方５__i {
オタコン_000: {
Controlla che la MEMORY CARD
(PS2) sia inserita
nell'ingresso MEMORY CARD.
}
//	<<<ENGLISH(2)>>>
//	Make sure the MEMORY CARD
//	(PlayStation&@R2) is in the MEMORY
//	CARD slot.

/*
ちゃんと"PlayStation2"専用メモリー
カード(8MB)をＭＥＭＯＲＹ ＣＡＲＤ
差込口にセットしておいてくれ。
*/

}//d


resource TO_写真電送せよ__i {
オタコン_000: {
Quando hai le foto,
}
//	<<<ENGLISH>>>
//	Once you've got the photos,
//<ページ数変更>
オタコン_000_1: {
usa il terminale all'estremit&`a sud-est di
quella stanza per mandarmele.
}
//	<<<ENGLISH>>>
//	use the workstation in the
//	southeast end of that room
//	to send them over to me.

/*写真が撮れたら、その部屋の南東にある
ＷＳを使ってこっちに送ってほしい。
*/

オタコン_001: {
Ma se non sono le foto che ci servono,
dovr&`o chiederti di scattarne delle altre.
}
//	<<<ENGLISH>>>
//	But if they aren't what we need,
//	I'm going to have to ask you to
//	take another set.

/*でも写真が良くなかったら
撮り直してもらうからね。
*/

}//d

//★デフォルト会話。ストーリーフラグ関連。d //e
//●スタート＜フラグ＜船内に入った d //e
//○船尾看板（W00a）d //e
//・左右の扉から船内に入れ h //e
resource TO_甲板船内入れ__i {
オタコン_000: {
Snake, devi arrivare al ponte del livello pi&`u
alto dell'infrastruttura. 
}
//	<<<ENGLISH>>>
//	Snake, you need to get to the
//	bridge on the top level of the
//	infrastructure.
//<ページ数変更>
オタコン_000_1: {
Prima trova un boccaporto che porti
all'interno del tanker e poi infiltrati nella
nave.
}
//	<<<ENGLISH>>>
//	First, find a door that leads
//	into the tanker's interior and
//	infiltrate the ship.

/*スネーク、目標は船橋最上階の操舵室だ。
まずは船の中に潜入してくれ。
船内に入れる扉を探すんだ。
*/

}//d

//・メタルギアの写真を公開する。製品版のみ h //e
resource TO_写真公開する１__i {
オタコン_000: {
Quando arrivano le foto, le trasmetteremo
on-line e tutto il mondo sapr&`a di questa
faccenda sul Web.
}
//	<<<ENGLISH>>>
//	When the photos are in, we'll put
//	them online and blow this whole
//	thing wide open on the Web.

/*新型メタルギアの写真を撮ったら、
僕らのウェブサイトに置いて
インターネット上で公開するんだ。
*/
}


//一回目のみ t //e  （二回目？）
resource TO_写真公開する２__i {
スネーク_000: {
Non pensi che le autorit&`a ci chiuderanno la
bocca?
}
//	<<<ENGLISH>>>
//	Don't you think that the
//	authorities will just shut
//	us down?

/*すぐ当局に削除されてしまうんじゃ
ないのか？
*/

オタコン_001: {
Probabilmente, ma non importa.
}
//	<<<ENGLISH>>>
//	Probably.
//	But it won't matter --
//<ページ数変更>
オタコン_001_1: {
Ci saranno siti che spunteranno ovunque,
pochi minuti dopo la trasmissione.
}
//	<<<ENGLISH>>>
//	there'll be mirror sites spawning
//	within minutes after those images
//	go up.
//<ページ数変更>
オタコン_001_2: {
Non dovremo neppure chiedere. La gente
far&`a man bassa delle foto. Nessuno potr&`a
fermarla.
}
//	<<<ENGLISH>>>
//	We won't even have to ask; people
//	will be grabbing the pictures. There's
//	no way anyone can stop it.

/*大丈夫。公開した途端、すぐにミラーが
作られるよ。頼まなくても、勝手にね。
第三者が根絶することなんて出来ない。
*/

オタコン_002: {
Le informazioni hanno vita propria e finch&'e
durer&`a la faccenda continueranno a
circolare -
}
//	<<<ENGLISH>>>
//	Information has a life of its own,
//	and as long as it lasts, it'll keep
//	existing --
//<ページ数変更>
オタコン_002_1: {
anche se cambiera in forma o luogo.
}
//	<<<ENGLISH>>>
//	even if it has to change
//	its form or location.

/*情報はそれ自体に命を持ってるんだ。
その命が尽きないうちは形や場所を
変えて生き続ける。
*/


スネーク_003: {
Hanno una vita?
}
//	<<<ENGLISH>>>
//	Life?

/*命？*/

オタコン_004: {
Gi&`a - il desiderio che l'uomo ha di sapere.
La richiesta di dati.
}
//	<<<ENGLISH>>>
//	Yeah -- the desire of people to
//	learn. The demand for data.

/*人がそれを知りたいと思う欲求。
つまり需要だ。
*/

スネーク_005: {
Per quanto mi riguarda, significa ficcare il
naso e basta.
}
//	<<<ENGLISH>>>
//	That's called idle
//	curiosity in my book.

/*下世話な興味か。
*/

オタコン_006: {
S&`i, c'&`e anche questo. Ma qualche volta pu&`o
aprire la strada alla verit&`a. Io credo che sia
cos&`i.
}
//	<<<ENGLISH>>>
//	Everyone's got some of that.
//	And sometimes, it can pave the
//	way for truth. That's what I believe.

/*下世話でない人間なんていないさ。
だからそれが真実を導くこともある。
僕はそう信じてる。
*/

}//d


//・新型メタルギアについて h //e
resource TO_新型メタルギア１の１__i {
オタコン_000: {
Secondo le voci,
}
//	<<<ENGLISH>>>
//	According to intelligence,
//<ページ数変更>
オタコン_000_1: {
questo nuovo modello &`e stato realizzato
per combattere tutti i cloni di Metal Gear
esistenti al mondo.
}
//	<<<ENGLISH>>>
//	this new model was designed to
//	combat all the clone models of Metal
//	Gear floating around in the world.

/*情報によると、新型メタルギアは
世界中に拡散したメタルギアの亜種に
対抗するためのものらしい。
*/
}


resource TO_新型メタルギア１の２__i {
オタコン_001: {
Ocelot ha venduto informazioni e dettagli
di Metal Gear a chiunque pagasse in
contanti, dopo essere sopravvissuto a
Shadow Moses -
}
//	<<<ENGLISH>>>
//	Ocelot sold the Metal Gear specs
//	to anyone with hard cash after he
//	survived Shadow Moses --

/*シャドーモセス事件の後、生き残った
オセロットがメタルギアの技術情報を
世界中にばらまいたよね。
*/

スネーク_002: {
E ha accumulato abbastanza soldi da
comprarsi una nazione mica tanto piccola,
fra l'altro.
}
//	<<<ENGLISH>>>
//	And raked in enough money to
//	buy a decent-sized country in
//	the process.

/*それで奴は国が一つ買えるくらいの金を
手に入れた。
*/

オタコン_003: {
Ma l'obiettivo finale di Ocelot - era davvero
solo il denaro?
}
//	<<<ENGLISH>>>
//	But was that -- was money
//	really Ocelot's end objective?

/*……でも思うんだけど、オセロットの
目的って本当に金だけだったのかな？
*/

スネーク_004: {
Pensi che abbia un piano pi&`u profondo?
}
//	<<<ENGLISH>>>
//	You think he had a deeper plan?

/*他に何か目論んでいたと……？*/

オタコン_005: {
S&`i. Niente di certo,
}
//	<<<ENGLISH>>>
//	I do.
//	Nothing definite,
//<ページ数変更>
オタコン_005_1: {
ma fare un mucchio di soldi &`e sempre una
buona cosa, quando vuoi iniziare un altro
progetto.
}
//	<<<ENGLISH>>>
//	but acquiring a large sum of money
//	is always a good starting point for
//	another project.

/*うん。わからないけど何となく……。
金を手に入れるのは何かを始めるには
一番手ごろな手段だしね。
*/

スネーク_006: {
Hmm...
}
//	<<<ENGLISH(2)>>>
//	Hmm...

/*……。
*/

オタコン_007: {
Ad ogni modo, tutti i paesi che hanno
pagato Ocelot stanno gareggiando per
produrre il loro carro armato bipede -
}
//	<<<ENGLISH>>>
//	Anyway, every country that paid off
//	Ocelot is racing to produce its own
//	bipedal tank --
//<ページ数変更>
オタコン_007_1: {
in grado di lanciare la cosiddetta 
"testata nucleare invisibile".
}
//	<<<ENGLISH>>>
//	one that can launch the so-called
//	"invisible nuclear warhead."

/*まあそれはともかく情報を得た各国は
「見えない核弾頭」を発射する核搭載
二足歩行戦車の開発に着手し始めている。
*/
オタコン_008: {
Se tutto il mondo avesse un Metal Gear, il
predominio militare degli USA verrebbe
neutralizzato.
}
//	<<<ENGLISH>>>
//	If the whole world has a Metal Gear,
//	the military dominance of the U.S.
//	will disappear.

/*世界中がメタルギアを持つように
なったら合衆国の軍事的優位性は
一気に崩れてしまう。
*/

オタコン_009: {
In un mondo pieno di Metal Gear,
}
//	<<<ENGLISH>>>
//	In a world where Metal Gear
//	has become commonplace,
//<ページ数変更>
オタコン_009_1: {
l'unico modo per riconquistare la
supremazia sarebbe possedere un'arma
ancora pi&`u potente.
}
//	<<<ENGLISH>>>
//	the only way to regain the upper
//	hand is to possess a weapon even
//	more powerful than Metal Gear.

/*メタルギアが標準になった世界で「唯一
の超大国」としての優位を保つには、
メタルギアを超える兵器を持つしかない。
*/

スネーク_010: {
Insomma, un nuovo Metal Gear.
}
//	<<<ENGLISH>>>
//	And that means a new Metal Gear.

/*そのための新型メタルギアか。*/

オタコン_011: {
Esatto. La corsa agli armamenti deve
continuare.
}
//	<<<ENGLISH>>>
//	Exactly.
//	The arms race must go on.

/*そう。
目には目を、ってわけさ。*/

}//dＸＸＸ


resource TO_新型メタルギア２の１__i {
オタコン_000: {
Il Metal Gear a bordo di quel tanker viene
sviluppato dal corpo dei marines.
}
//	<<<ENGLISH>>>
//	The Metal Gear that the tanker is
//	transporting is being developed
//	under Marine Corps jurisdiction. 

/*その偽装タンカーに積まれた
新型メタルギアは海兵隊の主導で
開発が進められている。
*/

オタコン_001: {
Ma io - ho anche sentito che la Marina sta
lavorando a un suo Metal Gear.
}
//	<<<ENGLISH>>>
//	But -- I've also heard a rumor
//	that the Navy is working on its
//	own Metal Gear.

/*だけど……別のメタルギアが海軍で
作られてるって噂もあるんだ。
*/

}


resource TO_新型メタルギア２の２__i {
スネーク_000: {
Sai altro del modello della Marina?
}
//	<<<ENGLISH>>>
//	Any more info on
//	the Navy's model?

/*そっちの方の情報は？*/

オタコン_001: {
Ho cercato di infiltrarmi nel sistema, ma la
sicurezza era strettissima.
}
//	<<<ENGLISH>>>
//	I tried to hack some out, but
//	security was too tight.

/*いや、それが全然。ガードが固くて。
*/

オタコン_002: {
Stanno assegnando molti soldi al progetto,
questo &`e certo. 
}
//	<<<ENGLISH>>>
//	There's a lot of money being
//	allocated -- that's for sure.
//<ページ数変更>
オタコン_002_1: {
Ma tutte le mie indagini portano allo stesso
nome e poi si scontrano contro un muro
insuperabile.
}
//	<<<ENGLISH>>>
//	But every one of my investigations
//	takes me to one name, then hits a
//	brick wall.

/*巨額の金が動いてることは確かなんだよ。だけど、全ての調査はある名前に
ぶつかって止まってしまうんだ。
*/

オタコン_003: {
Il nome &`e "I Patriots"
}
//	<<<ENGLISH>>>
//	The name is "The Patriots."

/*『＃｛愛国者達、パトリオッツ｝＃』っていうね。*/

スネーク_004: {
Chi sarebbero?
}
//	<<<ENGLISH>>>
//	Who are they?

/*何者だ？*/

オタコン_005: {
Magari lo sapessi! Non ho neppure idea
se si tratti di una sola persona o di
un'intera organizzazione.
}
//	<<<ENGLISH>>>
//	I wish I knew. I have no idea
//	if this is an individual, or an
//	organization, even.

/*それが全くわからないんだ。
個人なのか、団体なのかさえ……。
*/

オタコン_006: {
Ma quando diremo al mondo della
presenza di questo Metal Gear dei
marines,
}
//	<<<ENGLISH>>>
//	But once we expose the presence
//	of this Marine Corps Metal Gear to
//	the world,
//<ページ数変更>
オタコン_006_1: {
forse anche i "Patriots" si daranno una
mossa.
}
//	<<<ENGLISH>>>
//	maybe that will shake the
//	"Patriots" out of the tree.

/*でも、海兵隊の新型メタルギアの存在を
世間にぶちまければ、そっちにも
揺さ振りをかけることが出来ると思う。
*/

オタコン_007: {
La missione consiste anche di questo.
}
//	<<<ENGLISH>>>
//	This mission is partly
//	about that too.

/*今回の作戦にはそういう意味もあるんだ。
*/

}//d


//●船内に入った＜フラグ＜カモフ発見 d //e
//○船尾看板（W00a）d //e
//・さっさと船内に戻れ h //e
resource TO_船内に戻れ__i {
オタコン_000: {
Snake, devi arrivare al ponte in cima alla
sovrastruttura. 
}
//	<<<ENGLISH>>>
//	Snake, you need to get to
//	the bridge on top of the
//	superstructure.
//<ページ数変更>
オタコン_000_1: {
Torna sottocoperta e sali su.
}
//	<<<ENGLISH>>>
//	Get back inside the ship
//	and head upstairs.

/*スネーク、目標は船橋最上階の操舵室だ。
船内に戻って、上に向かってくれ。
*/

}//d


//○居住区１F南 通路(W01a) d //e
//・奥に進め。目標はまず艦橋 t //e
resource TO_奥に進め__i {
オタコン_000: {
Nel blocco a nord ci sono delle scale che
conducono su. Per ora dirigiti verso nord.
}
//	<<<ENGLISH>>>
//	There are stairs in the North
//	block that will take you up.
//	Head north for now.

/*北のブロックに上へ行く階段がある。
北に進んでくれ。
*/

}//d

//・上に行け。目標はまず艦橋 h //e
resource TO_艦橋に行け１__i {
オタコン_000: {
Snake, vai prima sul ponte e scopri la rotta
di questa nave.
}
//	<<<ENGLISH>>>
//	Snake, go to the bridge first and
//	find out where this ship is headed.

/*スネーク、まず操舵室に行って
その船の行き先を調べるんだ。
*/
}


resource TO_艦橋に行け２__i {
オタコン_000: {
Il ponte &`e sul livello pi&`u alto. Sali, su.
}
//	<<<ENGLISH>>>
//	The bridge is on the top level.
//	Go up.

/*操舵室は最上階だ。
上に向かってくれ。
*/

}//d


//●カモフ発見＜フラグ＜オルガ戦 d //e
//○艦橋(w01e) d //e
//・カサッカについてのウンチク h //e
resource TO_カサッカうんちく__i {
オタコン_000: {
Ah, il Ka-60 Kasatka -
}
//	<<<ENGLISH>>>
//	So that's the Ka-60 Kasatka --
//<ページ数変更>
オタコン_000_1: {
un elicottero militare multifunzione
costruito dalla societ&`a aerospaziale russa
Kamov.
}
//	<<<ENGLISH>>>
//	a multipurpose military helicopter
//	built by Kamov, the Russian
//	aerospace firm.

/*さっきのヘリはＫａ－６０カサッカだね。
ロシアのカモフ設計局で作られた軍用の
多目的ヘリコプターだ。
*/

オタコン_001: {
Questo modello si adatta a varie missioni.
}
//	<<<ENGLISH(2)>>>
//	It adapts to a variety of missions:
//<ページ数変更>
オタコン_001_1: {
Trasporto di truppe e armi, MedEvac, 
marcatura di bersagli
per gli elicotteri d'assalto,
}
//	<<<ENGLISH>>>
//	troop and weapons transport,
//	MedEvac, target marking for
//	attack choppers,
//<ページ数変更>
オタコン_001_2: {
persino missioni spia in qualsiasi
condizione atmosferica.
}
//	<<<ENGLISH>>>
//	even all-weather surveillance
//	missions.

/*歩兵・武器弾薬の輸送、負傷兵の後送、
攻撃ヘリのためのターゲット補足、
全天候偵察等、様々な任務に対応できる。
*/

オタコン_002: {
Usa rotori posteriori modello Fenestron.
Sono loro a produrre quel caratteristico
rumore che hai sentito.
}
//	<<<ENGLISH(2)>>>
//	It uses Fenestron-type tail rotors.
//	That's what makes the distinct
//	rotor sound that you picked up.

/*フェネトロン式テイルローターを
採用してるから、君も聞いた通りの
独特のローター音がするんだ。
*/

オタコン_003: {
&`E un elicottero russo, ma non possiamo
essere sicuri che i dirottatori siano militari
russi.
}
//	<<<ENGLISH>>>
//	It is a Russian helicopter, but we
//	can't be sure that the hijackers
//	are Russian military.

/*確かにロシア製のヘリだけど
民間型のＫａ－６２も作られてるし、
輸出モデルのＫａ－６４もある。
*/

オタコン_004: {
Dopotutto la Kamov ha prodotto una
versione civile del modello, il Ka-62,
}
//	<<<ENGLISH>>>
//	After all, Kamov did make a
//	civilian version, the Ka-62,
//<ページ数変更>
オタコン_004_1: {
poi c'&`e il modello export, il Ka-64...
}
//	<<<ENGLISH>>>
//	and there's also the Ka-64,
//	the export model.

/*だから彼らがロシア軍とは
言い切れないね……。
*/

}//d


//●オルガ戦＜フラグ＜オルガ戦終了 d //e
//○艦橋外オルガ戦(w00b) d //e
//逃げようとした場合 h //e
resource TO_オルガ戦逃げられない１__i {
オタコン_000: {
Snake, stai cercando di fuggire? Non
credo proprio che lei te lo permetter&`a. Devi
fermarti e combattere!
}
//	<<<ENGLISH>>>
//	Snake, are you trying to run away?
//	I don't think she'll let you. You
//	have to stand your ground here!

/*スネーク、逃げるのかい？
でも相手が見逃してくれるとは思えない。
ここは戦うしかないよ！
*/
}


//スネーク不利の場合（オルガとスネークのライフ値から判断）t //e
resource TO_オルガ戦逃げられないスネーク不利__i {
オタコン_000: {
Non dirmi che ti stai lasciando prendere
dallo sconforto!
}
//	<<<ENGLISH>>>
//	Don't tell me you're
//	getting discouraged!
//<ページ数変更>
オタコン_000_1: {
Tu dovresti essere fortissimo sotto
pressione, ricordi?
}
//	<<<ENGLISH>>>
//	You're supposed to be great
//	under pressure, remember?

/*分が悪いからって弱気になった？
らしくないね。諦めちゃダメだ。
*/
}


//スネーク有利の場合（オルガとスネークのライフ値から判断）t //e
resource TO_オルガ戦逃げられないスネーク有利__i {
オタコン_000: {
&`E quasi finita. Resisti!
}
//	<<<ENGLISH>>>
//	She's almost done.
//	Hang in there!

/*相手もかなり弱ってる。
もう少しだ。がんばってくれ！*/

}//d


//・隠れながら撃て。 h //e
resource TO_オルガ戦隠れながら撃て__i {
オタコン_000: {
Snake, non sei il solo ad avere un'arma.
Se non corri ai ripari, te ne pentirai.
}
//	<<<ENGLISH>>>
//	Snake, you're not the only one
//	with a gun. If you don't take
//	cover, you'll get hurt.
//<ページ数変更>
オタコン_000_1: {
Nasconditi dietro a qualcosa.
}
//	<<<ENGLISH>>>
//	Hide behind something.

/*スネーク、相手も銃を持ってるんだ。
無防備に体をさらしたら撃たれてしまう。
遮蔽物に身を隠すんだ。
*/

オタコン_001: {
Forse anche lei si &`e nascosta, ma se
decide di attaccare la potrai vedere subito.
}
//	<<<ENGLISH>>>
//	She may be hiding too, but you
//	have a clear shot whenever she
//	decides to attack.
//<ページ数変更>
オタコン_001_1: {
Usa l'Attacco con Visuale Soggettiva!
}
//	<<<ENGLISH>>>
//	Use the First Person View Attack!

/*向こうも隠れてるけど、攻撃をしかける
時には物陰から出てくる。その一瞬を
狙うんだ。主観攻撃を使って！
*/

}//d

//・進めませんエリア h //e
resource TO_オルガ戦立入禁止__i {
オタコン_000: {
Snake, se ti spingi pi&`u avanti ti troverai
completamente esposto al nemico. 
}
//	<<<ENGLISH>>>
//	Snake, if you go any further out,
//	you'll be completely exposed to
//	the enemy.
//<ページ数変更>
オタコン_000_1: {
Ti vuoi suicidare, per caso?? Torna
indietro!
}
//	<<<ENGLISH>>>
//	Are you suicidal or something!?
//	Get back!

/*スネーク、そこから前に出たら相手から
丸見えだ。蜂の巣にされたいのかい！？
戻って！！
*/

}//d

//・主観攻撃、左右ステップ、背伸び h //e
resource TO_オルガ戦主観攻撃１__i {
オタコン_000: {
Snake, lei spara da un nascondiglio.
}
//	<<<ENGLISH>>>
//	Snake, she's shooting
//	from concealment.
//<ページ数変更>
オタコン_000_1: {
Dovresti usare l'Attacco con Visuale
Soggettiva.
}
//	<<<ENGLISH>>>
//	You should use the First
//	Person View Attack.

/*スネーク、相手は遮蔽物に隠れながら
撃ってきてる。こっちも主観攻撃で
狙うんだ。
*/
}


resource TO_オルガ戦主観攻撃２__i {
//＠Ｒ１ＯＲ主観ボタン？ //e
オタコン_000: {
Premi il tasto R1 per passare alla Visuale
Soggettiva.
}
//	<<<ENGLISH>>>
//	Push the R1 button to change
//	to First Person View.
//<ページ数変更>
オタコン_000_1: {
Poi usa il tasto Armi per alzare l'arma ed
attaccare da quel punto di osservazione.
}
//	<<<ENGLISH>>>
//	Then use the Weapon button to
//	raise the gun and you can attack
//	from that viewpoint.

/*Ｒ１ボタンを押すと主観になる。
この時に＃｛□、武器｝＃ボタンで武器を構えれば
主観攻撃が出来るんだ。
*/
}


resource TO_オルガ戦主観攻撃３__i {
オタコン_000: {
Premi i tasti L2 e R2 quando sei nella
Visuale Soggettiva per mitragliare a
sinistra e a destra.
}
//	<<<ENGLISH>>>
//	Push the L2 and R2 buttons
//	while in First Person View to
//	strafe left and right.

/*主観の時にＬ２ボタン、Ｒ２ボタンを
押せば、主観のままそれぞれ左右に
ステップする。
*/
}


resource TO_オルガ戦主観攻撃４__i {
オタコン_000: {
Premi insieme i tasti L2 e R2 per alzarti in
punta di piedi mentre sei ancora nella
Visuale Soggettiva.
}
//	<<<ENGLISH>>>
//	Push the L2 and R2 buttons at the
//	same time to stretch up on your toes
//	while still in First Person View.
//<ページ数変更>
オタコン_000_1: {
Queste mosse possono essere utili.
}
//	<<<ENGLISH>>>
//	These moves can be useful.

/*Ｌ２ボタンとＲ２ボタンを同時に押せば、
主観のまま背伸びして上に伸び上がる
ことが出来る。うまく使ってくれ。
*/

}//d


//・ビハインド活用しろ h //e
resource TO_オルガ戦ビハインド活用１__i {
オタコン_000: {
Snake, usa la Visuale Angolare per
controllare le possibilit&`a d'attacco mentre
sei nascosto.
}
//	<<<ENGLISH>>>
//	Snake, use the Corner View to watch
//	for a chance to attack while hidden.

/*スネーク、ビハインドを使って、
隠れながら相手の隙を見つけるんだ。
*/
}


resource TO_オルガ戦ビハインド活用２の１__i {
オタコン_000: {
Premi il tasto R2 o L2 quando sei nella
Visuale Angolare per dare rapide occhiate
fuori.
}
//	<<<ENGLISH>>>
//	Push the R2 or L2 button while
//	in Corner View to take quick
//	looks out.

/*ビハインドの状態でＲ２ボタン、
Ｌ２ボタンを押すと覗き込みが
出来る。
*/
}


resource TO_オルガ戦ビハインド活用２の２__i {
オタコン_000: {
Puoi anche muovere la levetta analogica
destra quando sei nella Visuale Angolare,
per osservare nelle altre direzioni.
}
//	<<<ENGLISH>>>
//	You can also move the right analog
//	stick while in Corner View to survey
//	other directions.

/*ビハインドしながら右スティックを
動かして、そっちの方を伺うのも有効だ。
*/

}



resource TO_オルガ戦ビハインド活用３__i {
オタコン_000: {
Se hai selezionato un'arma,
}
//	<<<ENGLISH>>>
//	If you have a weapon selected,
//<ページ数変更>
オタコン_000_1: {
premi il tasto Armi nella Visuale Angolare
per balzare fuori dal nascondiglio e
prendere la mira.
}
//	<<<ENGLISH>>>
//	push the Weapon button while
//	in Corner View to jump out from
//	concealment and aim your weapon.

/*武器を装備してるなら、ビハインド中に
＃｛□、武器｝＃ボタンを押せば、遮蔽物から素早く
飛び出して武器を構えることが出来る。
*/
}


resource TO_オルガ戦ビハインド活用４__i {
オタコン_000: {
La tua chance arriver&`a quando lei
tenta di attaccare. Spara prima che
lo faccia lei!
}
//	<<<ENGLISH>>>
//	Your best opportunity will
//	be when she tries to attack.
//	Shoot before she does!

/*相手が攻撃してくる時がチャンスだ。
撃たれる前に撃て！
*/

}//d

//・中空障害物 h //e
resource TO_オルガ戦中空障害物__i {
オタコン_000: {
Se usi un Attacco con Visuale Soggettiva,
dovresti poter attaccare fra un container e
l'altro.
}
//	<<<ENGLISH>>>
//	If you use a First Person View
//	Attack, you should be able to
//	strike from between containers.
//<ページ数変更>
オタコン_000_1: {
Avrai dalla tua parte l'elemento sorpresa.
}
//	<<<ENGLISH>>>
//	You'll have an element of
//	surprise on your side.

/*主観攻撃を使えばコンテナの隙間からも
狙撃出来るはずだ。相手の不意をつける
かもしれない。
*/

}//d

//・グレネード注意。グレネード投げてから h //e
resource TO_オルガ戦グレネード__i {
オタコン_000: {
Snake, ha delle granate - non puoi
rimanere nello stesso posto.
}
//	<<<ENGLISH>>>
//	Snake, she has grenades --
//	you can't stay in one place.
//<ページ数変更>
オタコン_000_1: {
Continua a muoverti e sarai pi&`u sicuro!
}
//	<<<ENGLISH>>>
//	Keep moving around
//	and you'll be safer!

/*スネーク、相手はグレネードを持ってる。
ずっと同じ所に隠れていたら危ない。
こまめに場所を変えるんだ！
*/

}//d


//・何者？ h //e
resource TO_オルガ戦何者__i {
オタコン_000: {
Ma chi &`e, infine?
}
//	<<<ENGLISH>>>
//	Who is she, anyway?

/*いったい何者なんだろう？*/

スネーク_001: {
Su quello "scout knife" c'&`e scritto
"spetsnaz" ovunque, ma...
}
//	<<<ENGLISH(2)>>>
//	That scout knife had Spetsnaz
//	written all over it, but...

/*あのスカウトナイフを見る限り
スペツナズのようでもあるが……。
*/

オタコン_002: {
Spetznaz? Ma sono le squadre speciali
dei GRU sovietici. Allora lei dev'essere
russa...
}
//	<<<ENGLISH>>>
//	Spetsnaz? That's the special
//	ops of the Soviet GRU. So she
//	must be Russian...?

/*スペツナズ……旧＃｛ＧＲＵ。グルー｝＃の特殊部隊か。
じゃあ、やっぱりロシアの？
*/

スネーク_003: {
Chiss&`a. So solo che spara come gli agenti
dei reparti speciali.
}
//	<<<ENGLISH>>>
//	Who knows. All I'm sure of is that
//	she shoots like a commando.

/*さあな。とりあえず確かなのは
射撃の腕が良いということだけだ。
*/

オタコン_004: {
Fai attenzione.
}
//	<<<ENGLISH(2)>>>
//	Be careful.

/*気をつけて。*/

}//d


//●オルガ戦＜フラグ＜赤外線センサー発見 d //e
//○エンジンルーム(w02a) d //e
//・北西に行け h //e
resource TO_エンジンルーム北西行け__i {
オタコン_000: {
Snake, dovrebbe esserci una scala che
scende alla stiva, nella parte nord-ovest
della sala motori.
}
//	<<<ENGLISH>>>
//	Snake, there should be a staircase
//	down to the holds in the northwest
//	section of the engine room.
//<ページ数変更>
オタコン_000_1: {
Dirigiti verso ovest.
}
//	<<<ENGLISH>>>
//	Head west.

/*スネーク、その機関室の北西に
船倉へ下りる階段があるはずだ。
西に向かってくれ。
*/

}//d


//・サイファーのウンチク h e//
resource TO_サイファー__i {
オタコン_000: {
Sembra un Cypher - un disco volante-spia.
}
//	<<<ENGLISH>>>
//	The Cypher's what it looks like --
//	a flying surveillance saucer.
//<ページ数変更>
オタコン_000_1: {
&`E un aeromobile senza equipaggio
usato per la sorveglianza terrestre e
oceanica. 
}
//	<<<ENGLISH>>>
//	It's an unmanned aerial vehicle
//	used for ground and ocean
//	surveillance,
//<ページ数変更>
オタコン_000_2: {
Aiuta anche nelle comunicazioni.
}
//	<<<ENGLISH>>>
//	and it also assists
//	in communication.

/*サイファーは見た通りの空飛ぶ
円盤型偵察機だよ。陸上及び海上監視、
通信支援に使われる無人機だ。
*/

オタコン_001: {
Pu&`o decollare e atterrare in verticale
}
//	<<<ENGLISH>>>
//	It can take off and
//	land vertically,
//<ページ数変更>
オタコン_001_1: {
e per volare usa un flusso d'aria dai rotori
e dallo scudo circostante.
}
//	<<<ENGLISH>>>
//	and uses a ducted airstream from
//	its rotors and the surrounding
//	shroud to fly.

/*垂直離着陸が可能で、同軸回転翼と
それを囲む環状シュラウドからの
ダクテッド・エアストリームで飛ぶ。
*/

オタコン_002: {
Quello che hai visto era il tipo usato
dall'esercito, se ricordo bene.
}
//	<<<ENGLISH>>>
//	The one you saw was the type
//	used by the Army, if I recall.

/*君が見たのは陸軍で採用されてる
タイプのサイファーだったね。
*/

オタコン_003: {
Ma non ce lo vedo proprio l'esercito a
collaborare in un progetto top-secret dei
marines...
}
//	<<<ENGLISH>>>
//	But I can't see the Army officially
//	cooperating with a top-secret
//	Marine Corps project...

/*でも海兵隊の極秘プロジェクトに
陸軍が公式に協力するなんて
考えにくい……。
*/

スネーク_004: {
Neanche io. Il che vuol dire che non solo
noi e i russi siamo interessati 
}
//	<<<ENGLISH>>>
//	No. Which means that there's
//	someone besides us and the
//	Russians＃－
//<ページ数変更>
スネーク_004_1: {
al prototipo del nuovo Metal Gear...
}
//	<<<ENGLISH>>>
//	that are interested in the
//	new Metal Gear prototype...

/*ああ。俺達やロシア兵の他にも
新型メタルギアに興味を持っている
勢力があるってことだな……。
*/

オタコン_005: {
I Cypher hanno un'autonomia di volo di
circa tre ore, 
}
//	<<<ENGLISH>>>
//	Cyphers can stay airborne
//	for about three hours,
//<ページ数変更>
オタコン_005_1: {
quindi qua vicino dovrebbe esserci una
stazione terrestre mobile integrata che
controlla la sua rotta di volo. 
}
//	<<<ENGLISH>>>
//	so there should be an Integrated
//	Mobile Ground Station controlling
//	its flight pattern＃－
//<ページ数変更>
オタコン_005_2: {
Deve trovarsi sicuramente a terra.
}
//	<<<ENGLISH>>>
//	and output nearby --
//	it's got to be on land.

/*サイファーの滞空時間は３時間位だから、
そのすぐ近くに発進・管制をしてる統合
モバイル地上ステーションがあるはずだ。
*/

オタコン_006: {
Scommetto che l'hanno nascosta a bordo
di un normale camion o qualcosa simile, 
}
//	<<<ENGLISH>>>
//	I'll bet you anything it's
//	disguised as a regular
//	truck or something,
//<ページ数変更>
オタコン_006_1: {
dalle parti di Riverside. Fammi un po'
controllare.'
}
//	<<<ENGLISH>>>
//	driving along riverside.
//	Let me check it out.

/*多分普通のトラックに偽装して
リバーサイドを走ってるんだと思う。
そっちの方も調べてみるよ。
*/

スネーク_007: {
Buona idea.
}
//	<<<ENGLISH>>>
//	Good call.

/*頼む。*/
//ＸＸＸ

}//d 

//・ゴルルコビッチについての説明 h //e
resource TO_ゴルルコビッチ__i {
オタコン_000: {
Non pensavo che c'entrasse Gurlukovich,
in questa faccenda.
}
//	<<<ENGLISH>>>
//	Didn't think Gurlukovich was
//	involved, of all people.

/*まさかゴルルコビッチが絡んでるとはね。
*/

スネーク_001: {
L'ex comandante di Ocelot... col suo
esercito personale di ex militari russi e
soldati del GRU. 
}
//	<<<ENGLISH>>>
//	Ocelot's former CO -- and a man
//	with a private army of ex-Russian
//	military and GRU soldiers.
//<ページ数変更>
スネーク_001_1: {
La storia non mi piace per niente.
}
//	<<<ENGLISH>>>
//	I don't like it.

/*旧ロシア軍やＧＲＵ上がりの私兵
軍隊を抱えているオセロットの
元上官、か……。
*/

オタコン_002: {
E Liquid voleva allearsi proprio con questi
tipacci a Shadow Moses.
}
//	<<<ENGLISH>>>
//	And Liquid was planning to team up
//	with that bunch at Shadow Moses.

/*シャドーモセスの時、リキッドは
彼の部隊と合流して蜂起を継続しようと
していた……。
*/

スネーク_003: {
Ma in quell'occasione &`e riuscito solo a
fornire un giocattolo o due.
}
//	<<<ENGLISH>>>
//	All he managed to do back then
//	was to provide a toy or two.
//<ページ数変更>
スネーク_003_1: {
Sembra che ne abbia avuto abbastanza di
sponsorizzare insurrezioni.
}
//	<<<ENGLISH>>>
//	Looks like he's had enough
//	of sponsoring insurrections.

/*あの時は結局、オモチャを一台提供した
だけだったがな。どうやらスポンサー
稼業は廃業したらしい。
*/

オタコン_004: {
Quindi ora ci tenta da solo. Che dici, vuole
mettere le mani sul Metal Gear?
}
//	<<<ENGLISH>>>
//	So this time, he's out here himself.
//	I guess he's after Metal Gear?

/*今度はゴルルコビッチが自分で出てきた。
やっぱり新型メタルギアを？*/

スネーク_005: {
La storia si ripete. 
}
//	<<<ENGLISH>>>
//	History repeats itself.
//<ページ数変更>
スネーク_005_1: {
Metal Gear ha abbastanza importanza
strategica da sconvolgere da solo l'intero
equilibrio del potere militare.
}
//	<<<ENGLISH>>>
//	Metal Gear has enough strategic
//	clout to upset the balance of
//	military power overnight.
//<ページ数変更>
スネーク_005_2: {
Star&`a sognando il ritorno alla gloria della
Madre Russia.
}
//	<<<ENGLISH>>>
//	He must be dreaming of Mother
//	Russia's return to glory.

/*だろうな。メタルギアには軍事的パワー
バランスを一気に覆すだけの戦略的価値
がある。目指すはロシアの再興か。
*/

オタコン_006: {
Proprio come dici tu, la storia si ripete.
Certa gente non cambia mai.
}
//	<<<ENGLISH>>>
//	Like you said, history repeats
//	itself. Some people never change.

/*あの時と同じだね。進歩の無い奴だ。
*/

スネーク_007: {
Forse &`e il mondo che non cambia mai - o
che non vuole cambiare.
}
//	<<<ENGLISH>>>
//	Maybe it's the world that
//	doesn't -- or won't -- change.

/*進歩してないのは現実の方かも
しれんがな。
*/

オタコン_008: {
Forse. Per&`o anche noi stiamo cercando di
sconvolgere il suo equilibrio, no?
}
//	<<<ENGLISH>>>
//	Maybe. But we're fighting
//	to upset the status quo too,
//	aren't we?
//ＸＸＸ
/*そうかもしれないね。だから僕らは
それを変えるために戦ってる。
そうだろ？
*/
}//d


//・オルガについての会話 h //e
resource TO_オルガ戦後オルガ__i {
オタコン_000: {
Insomma, chi era quell'Olga?
}
//	<<<ENGLISH>>>
//	So who was that Olga person?

/*あのオルガって女の人、
何者だったんだろう？*/

スネーク_001: {
Non ne ho idea. Forse la figlia di
Gurlukovich. Ha detto "nomadi"...
}
//	<<<ENGLISH>>>
//	Don't know. I'm guessing
//	she's Gurlukovich's daughter.
//	She said "nomads"...

/*さあな。ゴルルコビッチの娘らしいが。
『国亡き民』、か……。
*/

オタコン_002: {
Ma non pensi - che somigliasse un po' a
Meryl?
}
//	<<<ENGLISH>>>
//	Didn't she -- you know,
//	look a little like Meryl?

/*……ちょっとメリルに似てたね？
*/

スネーク_003: {
Non ci ho fatto caso.
}
//	<<<ENGLISH>>>
//	...I didn't notice.

/*……似てないさ。*/

}//d


//・ＥＥメールについて
resource TO_ＥＥメール__i {
オタコン_000: {
Snake, ti devo delle scuse. Il motivo per
cui non ho parlato di mia sorella &`e che...
beh...
}
//	<<<ENGLISH>>>
//	Snake, I owe you an apology.
//	The reason I didn't mention my
//	sister was, well, because --

/*……スネーク、ごめん。
妹のこと言えなかったのは……。
*/

スネーク_001: {
Otacon, ti ho mai detto chi mi ha dato
questa bandana?
}
//	<<<ENGLISH>>>
//	Otacon, have I ever told you
//	who gave me this bandanna?

/*オタコン、俺がこのバンダナを誰から
貰ったか、話したことはあったか？
*/

オタコン_002: {
No, ma che c'entra questo, scusa?
}
//	<<<ENGLISH>>>
//	No, but -- what's that
//	got to do with this?

/*いや、ないけど……。
どういうこと？
*/

スネーク_003: {
Significa che tu non mi devi spiegazioni.
}
//	<<<ENGLISH>>>
//	It means you don't
//	have to explain.

/*気にするなってことだ。*/

オタコン_004: {
Okay. Grazie, Snake.
}
//	<<<ENGLISH>>>
//	...OK. Thanks, Snake.

/*……ありがとう。*/

}//d

//・ＵＳＰを手に入れたから敵を殺せるけど音がする h //e
resource TO_ＵＳＰ注意１__i {
オタコン_000: {
Ehi, Snake, lo sai il detto 'Chi ce la mette
tutta
}
//	<<<ENGLISH>>>
//	Hey, Snake, you found a handgun.

/*スネーク、ハンドガンを手に入れたね。*/

スネーク_001: {
pu&`o perdere tutto'?
}
//	<<<ENGLISH>>>
//	It's a decent one -- USP.

/*ああ。ＵＳＰだ。*/
}


//センサーＣＡＬＬ聞いている場合 t //e
resource TO_ＵＳＰ注意センサー壊せる__i {
オタコン_000: {
Quell'arma pu&`o mettere k.o. i sensori agli
infrarossi che hai appena visto.
}
//	<<<ENGLISH>>>
//	That gun can take out the infrared
//	sensors you just saw.

/*その銃なら、さっきあった
赤外線センサーのトラップも
破壊できるはずだ。
*/
}


resource TO_ＵＳＰ注意２__i {
オタコン_000: {
L'USP usa veri proiettili, non tramortisce e
basta come l'M9. Lo sai questo, vero?
}
//	<<<ENGLISH>>>
//	The USP fires real bullets --
//	not the knockout rounds the M9
//	uses. You know that, right?

/*ＵＳＰが発射するのはＭ９で使ってる
麻酔弾じゃない。実弾だ。
わかってるよね。
*/


オタコン_001: {
L'USP non &`e neppure equipaggiata con un
silenziatore.
}
//	<<<ENGLISH>>>
//	The USP isn't equipped
//	with a suppressor, either.
//<ページ数変更>
オタコン_001_1: {
Se spari quando i nemici sono nelle
vicinanze, probabilmente ti sentiranno.
}
//	<<<ENGLISH>>>
//	If you fire it when there
//	are enemies nearby,
//	they'll probably hear it.

/*
あと、そのＵＳＰにサプレッサーは
装備されてない。撃てば銃声がするから
近くに敵が居たら気づかれると思う。
*/

オタコン_002: {
Tienilo presente.
}
//	<<<ENGLISH>>>
//	Keep that in mind.

/*注意してくれ。*/

オタコン_003: {
Avere un'USP ti faciliter&`a i combattimenti,
ma la cosa migliore rimane non farsi
scoprire. Intesi?
}
//	<<<ENGLISH>>>
//	Having the USP will make combat
//	easier, but being undetected is
//	still the best way to go. OK?

/*ＵＳＰがあれば戦闘が有利になるのは
確かだけど、やっぱり敵に見つからない
のが一番だ。いいね。
*/

}//d


//○それ以外 d //e
//・メタルギアは船倉。船倉へ行け。h //e
resource TO_船倉へ向かえ１__i {
オタコン_000: {
Snake, Metal Gear &`e nella stiva sotto il
ponte del tanker. Scendi gi&`u.
}
//	<<<ENGLISH>>>
//	Snake, Metal Gear is in the holds
//	below the tanker's deck. Go down.

/*スネーク、メタルギアはタンカー下部の
船倉だ。下に向かってくれ。
*/

}


//赤外線ＣＡＬＬ聞いている場合 t //e
resource TO_船倉へ向かえ２__i {
オタコン_000: {
Quella tua USP dovrebbe permetterti di
eliminare le trappole agli infrarossi.
}
//	<<<ENGLISH>>>
//	That USP of yours should let you
//	take out the infrared booby traps.

/*さっき手に入れたＵＳＰなら、
赤外線センサーのトラップも
壊せるはずだ。
*/

オタコン_001: {
L'unico modo di arrivare nella stiva &`e
oltrepassare quei sensori.
}
//	<<<ENGLISH>>>
//	There's no way into the holds
//	except past those sensors.
//<ページ数変更>
オタコン_001_1: {
Neutralizza la trappola e scendi pi&`u in
basso.
}
//	<<<ENGLISH>>>
//	Take out the trap and
//	head further down.

/*船倉へ行くにはあのトラップを通過する
以外に道はない。トラップをクリアして
その先へ進んでくれ。
*/

}//d

//●赤外線センサー破壊＜フラグ＜ハッチ閉鎖デモ d //e
//○長廊下(w03a) d //e
//・まっすぐ進んで船倉へ行け。 t //e
resource TO_長廊下船倉へ向かえ１__i {
オタコン_000: {
Snake, il prototipo di Metal Gear &`e gi&`u,
nella stiva.
}
//	<<<ENGLISH>>>
//	Snake, the Metal Gear prototype
//	is down in the holds.

/*スネーク、新型メタルギアは船倉にある。
*/
}


//一回目のみ t //e  （二回目？）
resource TO_長廊下船倉へ向かえ２__i {
オタコン_000: {
Quel corridoio circonda la stiva.
}
//	<<<ENGLISH>>>
//	That corridor wraps
//	around the holds.
//<ページ数変更>
オタコン_000_1: {
Vedrai diversi boccaporti che portano nella
stiva,
}
//	<<<ENGLISH>>>
//	There are several doors into
//	the holds from the corridor,
//<ページ数変更>
オタコン_000_2: {
ma sembra che la maggior parte sia chiusa
a chiave.
}
//	<<<ENGLISH>>>
//	but it looks like most
//	of them are locked.

/*そこの廊下は船倉をぐるっと囲んで
るんだ。船倉への扉は幾つかあるけど、
ほとんど閉鎖されてる。
*/
}


resource TO_長廊下船倉へ向かえ３__i {
オタコン_000: {
Per&`o non penso che il boccaporto pi&`u
lontano sia stato chiuso.
}
//	<<<ENGLISH>>>
//	But I think the farthest
//	door isn't locked yet.

/*でも、一番奥の扉はまだ閉じられて
いないようだね。
*/
}


//西通路 t //e
resource TO_長廊下船倉へ向かえ４__i {
オタコン_000: {
Puoi penetrare nella stiva dal boccaporto
alla fine di quel corridoio. Vai verso nord.
}
//	<<<ENGLISH>>>
//	You can get into the holds
//	from the door at the end of
//	that corridor. Head north.

/*その廊下の一番奥にある扉から
船倉に侵入できる。北に向かってくれ。
*/
}


//北通路 t //e
resource TO_長廊下船倉へ向かえ５__i {
オタコン_000: {
Puoi entrare nella stiva dal boccaporto alla
fine di quel corridoio. Vai verso est.
}
//	<<<ENGLISH>>>
//	You can get into the holds
//	from the door at the end of
//	that corridor. Head east.

/*その廊下の一番奥にある扉から
船倉に入れる。東に向かってくれ。
*/
}


//東通路 t //e
resource TO_長廊下船倉へ向かえ６__i {
オタコン_000: {
Puoi entrare nella stiva dal boccaporto alla
fine di quel corridoio. Vai verso sud.
}
//	<<<ENGLISH>>>
//	You can get into the holds
//	from the door at the end of
//	that corridor. Head south.

/*その廊下の一番奥にある扉から
船倉に入るんだ。南に向かってくれ。
*/

}//d 


//○それ以外 d //e
//・メタルギアは船倉。センサー地帯を抜けて船倉へ行け h //e
resource TO_長廊下以外船倉へ向かえ__i {
オタコン_000: {
Snake, il prototipo di Metal Gear &`e nella
stiva.
}
//	<<<ENGLISH>>>
//	Snake, the Metal Gear
//	prototype is in the holds.

/*スネーク、新型メタルギアは船倉だ。
*/

オタコン_001: {
Hai appena neutralizzato la trappola dei
sensori agli infrarossi.
}
//	<<<ENGLISH>>>
//	You took out the infrared
//	sensor trap just now.
//<ページ数変更>
オタコン_001_1: {
Attraversi quella sezione e raggiungerai la
stiva.
}
//	<<<ENGLISH>>>
//	Go through that section
//	to reach the holds.

/*さっき赤外線センサーのトラップを
壊したよね。船倉へ行くにはその先を
進めばいい。
*/

}//d


//●ハッチ閉鎖デモ＜フラグ＜オセロットと兵士デモ＝長廊下兵イベント d //e
//○長廊下(w03a) d //e
//・銃撃排除せよ h //e
//没！ＸＸＸＸＸｘ
resource TO_長廊下長廊下兵戦え__i {
オタコン_000: {
Sembra che vogliano impedirti di passare.
Non hai scelta, devi contrattaccare.
}
//	<<<ENGLISH>>>
//	Looks like they plan to stop you
//	from getting through. You've got
//	no choice but to fight back.
//<ページ数変更>
オタコン_000_1: {
Usa la modalit&`a di Attacco con Visuale
Soggettiva!
}
//	<<<ENGLISH>>>
//	Use the First Person Attack mode!

/*敵も黙って君を通す気はないみたいだ。
銃で応戦するしかない。
主観攻撃を使って！
*/

}//d

//・物陰に隠れろ h //e
resource TO_長廊下廊下兵隠れろ__i {
オタコン_000: {
Snake, puoi ripararti dietro agli oggetti.
Abbassati e contrattacca da un punto
sicuro!
}
//	<<<ENGLISH>>>
//	Snake, you can take cover behind
//	objects. Get down and fight back
//	from a safer spot!

/*スネーク、遮蔽物があるだろ。
それに隠れながら応戦するんだ！
*/

}//d

//●オセロットと兵士デモ＜フラグ＜船首メタルギア登場デモ d //e
//・奥に進め。 h //e
resource TO_船倉１２進め__i {
オタコン_000: {
Snake, la stiva del tanker &`e divisa in tre
blocchi separati
}
//	<<<ENGLISH>>>
//	Snake, the tanker's holds are
//	divided into three separate
//	blocks,
//<ページ数変更>
オタコン_000_1: {
e Metal Gear si trova nella parte pi&`u
lontana. Devi dirigerti verso nord.
}
//	<<<ENGLISH>>>
//	and Metal Gear is in the farthest
//	hold. You need to head north.

/*スネーク、船倉は三つのブロックに
分かれている。新型メタルギアは一番
奥のブロックだ。北に進んでくれ。
*/

オタコン_001: {
Sai quanti nemici hai davanti. Se ti
individuano non riuscirai mai a vincere.
}
//	<<<ENGLISH>>>
//	You know the number you're
//	up against. If you're spotted,
//	there's no winning that fight.
//<ページ数変更>
オタコン_001_1: {
Devi tenerti alla larga da loro, intesi?
}
//	<<<ENGLISH>>>
//	You have to stay out
//	of their sight, okay?

/*相手はその人数だ。もし見つかったら
どう考えても勝ち目はない。
絶対に見つかったらダメだ。いいね。
*/

}//d


//・演説が終わる前に写真を撮り終えろ h //e
resource TO_船倉演説終わる前に１__i {
オタコン_000: {
Snake, scatta quelle foto prima che il
Comandante finisca il suo discorso. &`E
l'unica chance che abbiamo.
}
//	<<<ENGLISH>>>
//	Snake, take those pictures before
//	the Commandant finishes his speech.
//	It's the only chance we've got.

/*スネーク、チャンスは海兵隊司令官の
演説が続いている間だけだ。演説が
終わる前に写真を撮り終える必要がある。
*/
}


//一回目のみ t //e 
resource TO_船倉演説終わる前に２__i {
オタコン_000: {
Non appena finisce, i marines torneranno
alle rispettive postazioni.
}
//	<<<ENGLISH>>>
//	As soon as he finishes up,
//	the Marines will go back to
//	their posts. 

/*演説が終わったら、
海兵隊員達は持ち場に戻るだろう。
*/

オタコン_001: {
Ci sono troppi occhi a sorvegliare Metal
Gear.
}
//	<<<ENGLISH>>>
//	That's way too many pairs of eyes
//	watching out for Metal Gear.
//<ページ数変更>
オタコン_001_1: {
Non lascerebbero mai passare nessuno
con una telecamera.
}
//	<<<ENGLISH>>>
//	There's no way they'll let
//	an intruder with a camera
//	slip past.

/*あの人数で警備されたら、
見つからずにメタルギアの写真を
撮るなんて不可能だ。
*/

オタコン_002: {
Fai quello che devi fare prima che finisca il
suo discorso.
}
//	<<<ENGLISH>>>
//	Do what you have to
//	before that happens.

/*そうなる前に全てを片づけてくれ。
*/
}

//時間がない場合 t //e
resource TO_船倉演説終わる前に３__i {
オタコン_000: {
Il nostro tempo sta per scadere. Sbrigati!
}
//	<<<ENGLISH>>>
//	We're just about
//	out of time. Hurry!

/*もう時間がない。急いで！*/

}//d



//・見つかると即死注意
resource TO_船倉見つかると即死__i {
オタコン_000: {
Non devi farti assolutamente vedere da
nessuno l&`a dentro.
}
//	<<<ENGLISH>>>
//	You absolutely can't let
//	anyone see you in there.
//<ページ数変更>
オタコン_000_1: {
Ci sono troppi marines, anche per uno
come te.
}
//	<<<ENGLISH>>>
//	There are too many Marines in
//	there to handle, even for you.

/*そこでは絶対に見つかっちゃダメだ。
その人数の海兵隊を相手にしたら、
いくら君でも勝ち目がない。
*/

オタコン_001: {
Se ti vedono, sei un uomo morto. Devi
assolutamente essere cauto.
}
//	<<<ENGLISH>>>
//	If they see you, you're dead.
//	Caution's the keyword here.

/*見つかったら終わりだ。
とにかく慎重に進んでくれ。
*/

}//d

//・演説の内容についての解説 h //e
resource TO_演説１__i {
オタコン_000: {
La caratteristica fondamentale dei marines
&`e che sono un corpo che risponde alle
emergenze, in caso di crisi.
}
//	<<<ENGLISH>>>
//	The Marine Corps' defining
//	character is that of an emergency
//	response team in crisis situations.

/*海兵隊は有事の際の緊急展開部隊としての性格が強い。
*/

オタコン_001: {
Ma l'esercito ha continuamente potenziato
le sue capacit&`a in caso di crisi, 
}
//	<<<ENGLISH(2)>>>
//	But the Army's been steadily
//	enlarging its own crisis response
//	capabilities,
//<ページ数変更>
オタコン_001_1: {
facendo affidamento sulla forza della
Brigata Medium.
}
//	<<<ENGLISH>>>
//	building on the strength
//	of their Medium Brigade.

/*でも最近陸軍がミディアム旅団を
中心に緊急即応の能力を高めている。
*/

オタコン_002: {
Secondo le analisi i marines considerano
questa mossa come un'invasione del loro
campo
}
//	<<<ENGLISH(2)>>>
//	Analysis is that the Marine Corps
//	sees this as an infringement on
//	their own domain,
//<ページ数変更>
オタコン_002_1: {
di attivit&`a e sono molto allarmati.
}
//	<<<ENGLISH>>>
//	and is more than
//	a little alarmed.

/*海兵隊はそれに対し、自軍の権益を
侵害されるという非常な危機感を
持っているようだ。
*/


オタコン_003: {
Noi due sappiamo che Metal Gear REX
doveva essere sviluppato per l'uso da
parte dell'Esercito.
}
//	<<<ENGLISH(2)>>>
//	We both know that Metal Gear REX
//	was being developed for deployment
//	by the Army.

/*君も知ってる通りメタルギアＲＥＸは
陸軍での採用を目的として開発されて
いた。
*/

オタコン_004: {
Quindi c'era da aspettarsi che i marines
cercassero di sviluppare la loro versione
personale di Metal Gear.
}
//	<<<ENGLISH(2)>>>
//	So it does make sense that the
//	Marines are trying to compete with
//	their own version of Metal Gear.

/*だから海兵隊が陸軍に対抗して独自の
メタルギアを持とうとしてるというのは
分からない話じゃないね。
*/

}//d

resource TO_演説２__i {
オタコン_000: {
Allora il Comandante dice che la Marina si
sta affidando a loro, eh?
}
//	<<<ENGLISH>>>
//	So the Commandant says the
//	Navy is leaning on them, huh?

/*司令官が海軍からの圧力があるって
言ってたね。
*/

オタコン_001: {
Sono sicuro che alla Marina non va gi&`u il
fatto dello sviluppo di un nuovo prototipo di
Metal Gear.
}
//	<<<ENGLISH>>>
//	I'm sure the Navy isn't happy about
//	the new Metal Gear prototype being
//	developed.

/*確かに海軍はその新型メタルギアの
開発をおもしろく思ってないだろう。
*/

オタコン_002: {
Da quanto mi risulta il nuovo modello pu&`o
avvicinarsi, lanciare un attacco
}
//	<<<ENGLISH>>>
//	From what I can tell, the new
//	model can make an approach,
//	launch an attack,
//<ページ数変更>
オタコン_002_1: {
ed eseguire decolli dall'oceano, senza
nessun supporto.
}
//	<<<ENGLISH>>>
//	and execute takeoffs from the
//	ocean without any support.

/*新型メタルギアは海からの接敵・攻撃・
離脱という作戦行動を単独で可能にする
兵器らしい。
*/

オタコン_003: {
Se quest'arma supera la fase di collaudo,
potrebbe rendere obsolete portaerei,
}
//	<<<ENGLISH>>>
//	If the weapon makes it past the
//	testing stage, it could render
//	aircraft carriers,
//<ページ数変更>
オタコン_003_1: {
corazzate, persino i sottomarini.
}
//	<<<ENGLISH>>>
//	battleships, even
//	submarines obsolete.

/*これが完成したら空母や戦艦は勿論、
潜水艦までが戦略的意義を失ってしまう
かもしれない。
*/

オタコン_004: {
Per la Marina come organizzazione si
tratta insomma di vita o di morte...
}
//	<<<ENGLISH>>>
//	It's a matter of life or death for
//	the Navy as an organization...

/*海軍にとっては死活問題だ。
*/
}



//海軍メタルギアの話聞いている場合 t //e
resource TO_演説２x__i {
オタコン_000: {
E se &`e vero che la Marina sta progettando
un suo Metal Gear,
}
//	<<<ENGLISH>>>
//	And if it's true that the Navy has
//	its own Metal Gear in the works,
//<ページ数変更>
オタコン_000_1: {
ecco un'altra ragione per innervosirsi di
pi&`u.
}
//	<<<ENGLISH>>>
//	that's another reason for
//	them to get nervous.

/*まして海軍も別のメタルギアの開発を
進めているとあったら尚更だね。
*/
}//d


//没ＸＸＸＸＸＸＸＸＸＸＸ
resource TO_演説３__i {
オタコン_000: {
La storia del Comandante sul Capo
operazioni navali - ne ho sentito parlare
quando ero ancora con la ArmsTech.
}
//	<<<ENGLISH>>>
//	The Commandant's story about the Chief of Naval Operations -- I heard about it when I was still with ArmsTech.


/**/

オタコン_001: {
Correva voce che l'Ammiraglio Boorda non
fosse suicidato. L'avevano fatto fuori.
}
//	<<<ENGLISH>>>
//	Rumor was that General Voda didn't kill himself. It was murder.


/**/

オタコン_002: {
しかもそれを仕組んだのは僕らの
会社のベイカー社長とＤＡＲＰＡの
アンダーソン局長だ、という話だった。
}

/**/

オタコン_003: {
ＤＡＲＰＡとＡＴ社が進めようとしていたメタルギア計画はアーセナルシップ
計画と戦略的に重複する部分が多い。
}
/**/

オタコン_004: {
海軍のアーセナルシップ計画が進行中で
ある限りメタルギア開発にＧＯサインは
出ないような状況だったんだ。
}
/**/

オタコン_005: {
だけどアーセナルシップ計画は
ボーダ大将の死によって打ち切りに
なった。
}
/**/

オタコン_006: {
そしてその予算はＤＡＲＰＡに回されて、
メタルギアＲＥＸの開発が始まり、
それを受注したのがＡＴ社だ。
}
/**/

オタコン_007: {
変な噂が立つのも無理はないよね。
}
/**/

オタコン_008: {
本当のことは僕も知らない。
だけどあの社長のことだから、ありうる
ことなんじゃないかとは思ってた……。
}
/**/

}//d

resource TO_演説４__i {
オタコン_000: {
Hai sentito il Comandante parlare dell'NMD
- il programma nazionale di difesa
missilistica.
}
//	<<<ENGLISH>>>
//	You heard the Commandant mention
//	the NMD -- the National  Missile
//	Defense program.

/*海兵隊司令官の言ってたＮＭＤって
いうのは全米ミサイル防衛のことだ。
*/

オタコン_001: {
&`E stato pensato alla fine del secolo scorso
come rete di difesa per rilevare ed
agganciare
}
//	<<<ENGLISH>>>
//	It was conceptualized late last
//	century as a defense network
//	to detect and engage＃－
//<ページ数変更>
オタコン_001_1: {
gli ICBM nemici lanciati contro gli Stati
Uniti continentali.
}
//	<<<ENGLISH>>>
//	enemy ICBM's launched at
//	the continental United States.

/*合衆国本土に向かって発射された
大陸間弾道弾を迎撃するっていう
構想で前世紀末から開発されていた。
*/


オタコン_002: {
Ma allo stesso tempo, era stato attaccato
perch&'e contribuiva alla proliferazione delle
armi nucleari. 
}
//	<<<ENGLISH>>>
//	But at the same time, it came
//	under fire for contributing to
//	nuclear proliferation. 
//<ページ数変更>
オタコン_002_1: {
L'equipaggiamento di missili balistici con
MIRV e il potenziale della letalit&`a
}
//	<<<ENGLISH>>>
//	The MIRV'ing of ballistic missiles
//	and the increase in weapon
//	lethality＃－
//<ページ数変更>
オタコン_002_2: {
delle armi sono stati dei sottoprodotti del
programma di ricerca e sviluppo della
difesa.
}
//	<<<ENGLISH>>>
//	were some of the byproducts
//	of these defense R&D's.

/*でもそれは、核兵器の多弾頭化や
高性能化を呼んで核軍拡を導く
という強い批判を生んだんだ。
*/

オタコン_003: {
C'era molta opposizione da parte della
comunit&`a internazionale,
}
//	<<<ENGLISH>>>
//	There was a lot of opposition from
//	the international community,
//<ページ数変更>
オタコン_003_1: {
visto che il programma violava il trattato
antibalistico per i missili.
}
//	<<<ENGLISH>>>
//	on the grounds that the program
//	violated the Anti-Ballistic Missile
//	Treaty.
//<ページ数変更>
オタコン_003_2: {
In particolare, la Russia e la Cina si erano
opposte al programma.
}
//	<<<ENGLISH>>>
//	Russia and China were especially
//	vocal in their criticism.

/*弾道弾迎撃ミサイル制限条約に
違反するとしてロシアや中国も強く
反対した。
*/

オタコン_004: {
Comunque, ci vorr&`a ancora tempo per
l'attuazione del programma.
}
//	<<<ENGLISH>>>
//	Program deployment is a
//	ways off, in any case.
//<ページ数変更>
オタコン_004_1: {
I militari non sono riusciti a formulare una
tecnologia che distingua
}
//	<<<ENGLISH>>>
//	The military hasn't been able to
//	come up with a good technology
//	to discriminate＃－
//<ページ数変更>
オタコン_004_2: {
i bersagli effettivi da quelli tranello.
}
//	<<<ENGLISH>>>
//	between actual targets
//	and decoys.
//<ページ数変更>
オタコン_004_3: {
Devono anche affrontare altre
problematiche.
}
//	<<<ENGLISH>>>
//	There are also other tech issues
//	that have to be addressed.

/*他にも標的と囮の識別等の技術的問題が
解決されずに実験が失敗を繰り返した
事もあって未だ配備されてないんだ。
*/

}//d


//●船首メタルギア登場デモ＜フラグ＜メタルギア強奪デモ d //e
//○第三船倉(w04c) d //e
//・メタルギアの写真をとれ。条件説明 h //e
resource TO_船倉写真条件１__i {
//一回目のみ t //e
オタコン_000: {
Okay, finalmente ci siamo.
}
//	<<<ENGLISH>>>
//	Ok, we're finally there.

/*ようやく辿り着いたね。*/

スネーク_001: {
Quindi questo &`e il nuovo Metal Gear...
}
//	<<<ENGLISH>>>
//	So this is the new Metal Gear...

/*ああ。
これが新型メタルギアか……。*/

オタコン_002: {
Gi&`a. E noi faremo vedere a tutto il mondo
le foto di questo beb&`e.
}
//	<<<ENGLISH>>>
//	Yep. And we're going to show
//	the whole world its baby pictures.

/*そうだ。その姿を世界中の人に
見せてやるんだ。
*/
}


resource TO_船倉写真条件２__i {
オタコン_000: {
Riprendi il prototipo, dai.
}
//	<<<ENGLISH>>>
//	Get the prototype on camera.

/*新型メタルギアをカメラに収めてくれ。*/
}


resource TO_船倉写真条件３__i {
オタコン_000: {
Ci servono quattro foto: una del lato
anteriore destro, una del lato anteriore e
una del lato anteriore sinistro.
}
//	<<<ENGLISH(2)>>>
//	We need four images. 
//	One from the front-right,
//	the front, and the front-left,

