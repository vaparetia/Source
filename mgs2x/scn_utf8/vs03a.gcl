// ------------------------------------
// 各gclで必要なdefine
// ------------------------------------
// モード
#define		STAGE_VR 		1		// 共通プロック切り分け用
#define		VR_SNEAKING		1		// 共通プロック切り分け用
// ステージ名
#define		STAGE_VS03A		1		// 共通プロック切り分け用
// 敵兵、ＮＰＣ状況（薬莢を呼び分けるのに必要）
#define		ENE_P_GOL		1		// 都市迷彩ゴル兵
#define		ENE_SHOT		1		// ショットガン兵
#define		ENE_HIGH_TECH	1		// ハイテク兵
#define		ENE_SHIELD		1		// 盾兵


// ------------------------------------
// 各種スイッチ用define
// ------------------------------------
// デバッグ関係
#ifdef	d:FIX_MODE
	#define		DEBUG_CHARA		0		// デバッグキャラ全体(FIX時は0)
#else
	#define		DEBUG_CHARA		0		// デバッグキャラ全体
#endif
#define		CHARA_CAMERA	0		// キャラ追従カメラ
#define		TARGET_CHARA	敵兵:01	// キャラ追従カメラのターゲット
#define		SCREENSHOT		0		// スクリーンショット
#define		USB_KEY			0		// USBキーボード


// ------------------------------------
// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME			vs03a
#define		KMS_NAME			vs03a
#define		TONBO_KMS_NAME		vs03a_tonbo
#define		LINE_KMS_NAME		vs03a_line

// キャラクター関係
#define		PLAYER		ライデン

// ------------------------------------
// 敵兵音声
// ------------------------------------

// ------------------------------------
// 敵兵ルート番号
// ------------------------------------
enum E_R {
	雷電道１ = 0,
	雷電道２,
	雷電道３,
	蛇道１,
	蛇道２,
	蛇道３,
	蛇道４,
	昔蛇道１,
	昔蛇道２,
	昔蛇道３,
	昔蛇道４,
	昔蛇道５
};

#define WINDOW_SNEAKING_VS03A	[VRMSG_J:VRM_SNK_SNK_vs03a] [VRMSG_E:VRM_SNK_SNK_vs03a] [VRMSG_G:VRM_SNK_SNK_vs03a] \	// 日、英、独
								[VRMSG_F:VRM_SNK_SNK_vs03a] [VRMSG_I:VRM_SNK_SNK_vs03a] [VRMSG_S:VRM_SNK_SNK_vs03a] \	// 仏、伊、西
								[VRMSG_K:VRM_SNK_SNK_vs03a] \															// 韓
								p:ＶＲステージ開始時処理								// 終了プロック

#define WINDOW_ELIM_ALL_VS03A	[VRMSG_J:VRM_SNK_ELM_vs03a] [VRMSG_E:VRM_SNK_ELM_vs03a] [VRMSG_G:VRM_SNK_ELM_vs03a] \	// 日、英、独
								[VRMSG_F:VRM_SNK_ELM_vs03a] [VRMSG_I:VRM_SNK_ELM_vs03a] [VRMSG_S:VRM_SNK_ELM_vs03a] \	// 仏、伊、西
								[VRMSG_K:VRM_SNK_ELM_vs03a] \															// 韓
								p:ＶＲステージ開始時処理								// 終了プロック

#define	WATCHER_STATUS			d:ENE_STATUS_NORMAL スニーキング３面

#define RS_GOAL_POSITION		13000 0 -16000

// ------------------------------------
// アイテム位置
// ------------------------------------
#define へこみ通路南	10000 0 0
#define スタート北		0 0 -5000
#define ステージ左上	0 0 -16000
#define 最右穴前		12500 0 -9500
#define ゴール前Ｔ字路	8000 0 -15000
// ------------------------------------
// 弾数設定
// ------------------------------------
#define ライデン弾数 24
#define スネーク弾数 15
#define ぷりすき弾数 10
#define たきへび弾数 4
// ------------------------------------
// include
// ------------------------------------
#include "rai_vs01a.mh"		// 強制モーションリスト
#include "stdch.h"
#include "enevoice.h"
#include "a_stdproc.h"		// アナザーミッション設定ファイル
#include "sload.h"
#include "sound.h"
#include "item_info.h"
#include "a_item_info.h"
#include "ene_item.h"
#include "vr_common.h"		// ＶＲステージ共通で使用するプロック
#include "vs03a_common.h"
#if d:USB_KEY
	#include "usbkbd.h"
#endif

// ------------------------------------
// マップ設定
// ------------------------------------
chara マップ スニーキング３面 -k d:KMS_NAME -h d:HZX_NAME,0 -l $s:ＶＲライトファイル名

command マップ設定 スニーキング３面 -set {
	// ローカルの初期化
	// ------------------------------------
	@ローカル変数初期化		// ローカルで使用する変数で初期化をする場合はここで

	// 設定値を変更する場合は以下のプロック内で設定
	// ------------------------------------
	@設定値変更				// 敵兵や的のパラメータをステージ限定で変える時はここで

	// ＶＲで必要な基本プロックのセット(vr_common.hで定義)
	// サウンドの基本パック、ＶＲの基本システム、プレイヤー、ゴール等を設定します
	// ※このプロックを使用する時は「ＶＲクリア時処理」というプロックが必要です
	// ＶＲ共通プロックセット	$:スネークファイル $:雷電ファイル $:クリア条件フラグ
	//							$:ゴールＸ $:ゴールＹ $:ゴールＺ $:タイマー初期値
	//	VR_GOAL_TARGET	/*的全滅でゴールが開く*/
	//	VR_GOAL_FREE	/*ゴールが最初から開いてる*/
	//	VR_GOAL_ENEMY	/*敵全滅でゴールが開く*/
	//	VR_GOAL_SNEAK	/*潜入モード中はゴールが開く*/
	//	VR_GOAL_TIME	/*タイマーがゼロになるとゴールが開く*/
	// ------------------------------------
	@ＶＲスニーキング共通プロックセット sna_vs01a rai_vs01a 13000 0 -16000

	// ＶＲウィンドウの設定
	// ------------------------------------
	@スニーキング３面ＶＲウィンドウ設定

	// クリア時に呼ばれるものの設定
	// ------------------------------------
//	テイルズＥ以外では
#ifndef d:E_TALES
	@ＶＲクリア設定 p:load_vs04a p:A_ＲＥＴＲＹプロック
//	テイルズＥのときは
#else
	@テイルズＥ用ＶＲクリア設定２
#endif

	// ステージに引かれるライン
	// ------------------------------------
	@ＶＲアウトライン d:KMS_NAME d:TONBO_KMS_NAME d:LINE_KMS_NAME


	@プラグイン設定			// プレイヤーのプラグインがいる時はここで

	// 敵兵・的関係の設定
	// ------------------------------------
	@コマンダー設定

	// ＢＧＭの設定(プレイヤー→敵兵→BGMの順で呼ぶ)
	// ------------------------------------
	@ＢＧＭ設定

	// アイテムの設定
	// ------------------------------------
	@アイテム設定

	// 光源、オブジェクト、カメラ関連の設定
	// ------------------------------------
/*	default...

	朝Ｎ = 0,
	朝Ｆ = 50000,
	夕Ｎ = -3000,
	夕Ｆ = 40000,
	夜Ｎ = -500,
	夜Ｆ = 18000
*/
	@ＶＲフォグ設定 d:VR_FOG:朝Ｎ d:VR_FOG:朝Ｆ d:VR_FOG:夕Ｎ d:VR_FOG:夕Ｆ -2500 30000
	@カメラセット					// chara カメラとベースのカメラを設定
	@vs03aカメラ設定				// ステージ固有のカメラ設定がいる時はこのプロックで
	@ＶＲキャラ用ライト設置			// 必ず最後に設定
#if d:DEBUG_CHARA
//	@デバッグキャラセット
#endif
}

//初期マップの表示
command マップ表示 -show スニーキング３面


// 各proc設定
//-------------------------------------------------------------------------------------
// 全マップ共通
	// ＶＲウィンドウの設定と表示
	//------------------------------------------------------------
	proc スニーキング３面ＶＲウィンドウ設定 {
		#if d:DEBUG_PRINT
			print 'vr_window_set'
		#endif
		if( $b:モード番号 == d:SNEAKING:SNEAKING ){
			@ＶＲウィンドウ設定	d:WINDOW_SNEAKING_VS03A
		}else{
			@ＶＲウィンドウ設定	d:WINDOW_ELIM_ALL_VS03A
		}

		// ＶＲウィンドウを表示する
		mesg ＶＲウィンドウ ＶＲウィンドウ君 開く

		// スタート時とクリア時に使用するカットインカメラ
		chara カメラ カットインカメラ		-c 0 -l 0 -p  0

		// スタート時のカメラ(必要な場合)
		chara カメラ設定 カットインカメラ \
			-c 1 \
			-p 13000,6238,-13982 -t 13000,0,-16000 \
			-r 820,2048,0 -f 6556 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1
	}

	//------------------------------------------------------------
	// ステージ開始時処理
	//------------------------------------------------------------
	proc ＶＲステージ開始時処理 {
		#if d:DEBUG_PRINT
			print 'game_start!!!!!'
		#endif

		// プレイヤーやパッドの制御等を行う a_stdproc.hで定義
		@全ミッション共通ステージ開始時処理

		// カメラワークスタート(必要な場合)
		// 全体図
		chara カメラ設定 カットインカメラ \
			-c 1 \
			-p 6300,21742,9788 -t 6300,14639,4263 \
			-r 593,2048,0 -f 8999 \
			-a 200 \
			-i 4 4 d:START_CAMERA_CHANGE_TIME d:START_CAMERA_CHANGE_TIME \
			-s 1

		chara delay ディレイ \
			-time d:START_CAMERA_CHANGE_TIME \
			-exec {
				chara カメラ設定 カットインカメラ -s -1
			}
	}
	// ------------------------------------
	// クリア時の処理
	// ------------------------------------
	proc ＶＲクリア時処理 {
		#if d:DEBUG_PRINT
			print 'clear'
		#endif

//		mesg プレイヤー d:PLAYER position 13000,$i:プレイヤー位置Ｙ,-16300
		// 強制モーションを発動
		@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_1 1024

		// クリア時にカメラアングルを変える
		chara カメラ設定 クリア時カメラ \
			-c 1 \
			-p 16818,805,-16720 -t 10474,1246,-15203 \
			-r -44,3225,0 -f 6538 \
			-a 200 \
			-z d:CAMERA_NO_CUSHION \
			-i 2 0 0 0 \
			-s 1
/*
-p 15251,1193,-19901 -t 12878,1105,-15293 \
-r 11,3786,0 -f 5184 \
-a 200 \
*/
	}



	// ------------------------------------
	// パラメータ系の変更
	// ------------------------------------
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT
			print 'localvar_init'
		#endif
	}
	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT
			print 'status_set'
		#endif

		// 初期装備の設定(全殺し)
		@スニーキング用キャラ別標準装備設定 d:ライデン弾数 d:スネーク弾数 d:ぷりすき弾数 d:たきへび弾数

	}
	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif
	}

	// ------------------------------------
	// 敵兵や的の処理
	// ------------------------------------
	// 敵兵に関する設定
	//-------------------------------------
	proc 警備兵セット {
		#if d:DEBUG_PRINT
			print 'watcher_set'
		#endif
		if ( $s:選択プレイヤー == ライデン		|| \
			 $s:選択プレイヤー == プリスキン	|| \
			 $s:選択プレイヤー == 刀ライデン	){

			@VR_スニーキング警備兵 敵兵:01 d:E_R:雷電道１	3 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:02 d:E_R:雷電道２	1 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:03 d:E_R:雷電道３	2 d:WATCHER_STATUS

		}else if($s:選択プレイヤー == スネーク			|| \
			 	 $s:選択プレイヤー == タキシードスネーク){

			@VR_スニーキング警備兵 敵兵:01 d:E_R:蛇道１ 	0 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:02 d:E_R:蛇道２ 	1 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:03 d:E_R:蛇道３ 	0 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:04 d:E_R:蛇道４ 	4 d:WATCHER_STATUS

		}else if( 前作スネーク ){

			@VR_スニーキング警備兵 敵兵:01 d:E_R:昔蛇道１	3 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:02 d:E_R:昔蛇道２	1 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:03 d:E_R:昔蛇道３	0 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:04 d:E_R:昔蛇道４	2 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:05 d:E_R:昔蛇道５	0 d:WATCHER_STATUS

		}else{// ライデン

			@VR_スニーキング警備兵 敵兵:01 d:E_R:雷電道１	3 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:02 d:E_R:雷電道２	1 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:03 d:E_R:雷電道３	2 d:WATCHER_STATUS
		}
	}


	proc 攻撃兵セット {
		#if d:DEBUG_PRINT
			print 'attacker_set'
		#endif
	}

	proc 警備兵コマンダー {
		#if d:DEBUG_PRINT
			print 'wccomm_set'
		#endif

		chara 警備コマンダー wccomm -e {警備兵セット}
	}

	proc 攻撃兵コマンダー {
		#if d:DEBUG_PRINT
			print 'atcomm_set'
		#endif
	}

	proc コマンダー設定 {
		#if d:DEBUG_PRINT
			print 'commander_set'
		#endif

		chara コマンダー 敵兵セット \
			-w 警備兵コマンダー \
//			-a 攻撃兵コマンダー \
			-d スニーキング３面 \
			-r 13000,0,-16000 スニーキング３面 \
			-c 13000,0,-16000 スニーキング３面 \
			-v [ene_vr_voice:01] \
			-z $i:敵標準麻酔持続 \
			-h $i:標準警戒時間 \
			-o $i:敵標準気絶持続 \
			-s (d:ENE_STAGE_GPS | d:ENE_STAGE_VR_ANOTHER) \
			-b 0 \
			-m d:ALERT_MODE_SENNYU
	}



	// ------------------------------------
	// ＢＧＭの設定
	// ------------------------------------
	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT
			print 'bgm_set'
		#endif

		chara ＢＧＭマネージャー ＢＧＭマネ
	}


	// ------------------------------------
	// アイテムの設定
	// ------------------------------------
	// 再発生が必要な時は以下のプロックの中を記述する
	// ------------------------------------
	proc アイテム取得時番号設定 $:ボックス名 {
		#if d:DEBUG_PRINT
			print 'item_no_set'
		#endif
	}
	// アイテムの設置
	// ------------------------------------
	proc アイテム設定 {
		#if d:DEBUG_PRINT
			print 'item_set'
		#endif
		if(`@スニーキング判定`){
			// 特に無し
		}else{
			switch( $s:選択プレイヤー ){
				case( ライデン ){
					@A_Ｍ９_初期設置 Ｍ９ d:へこみ通路南 0 なし 15
				}
				case( プリスキン ){
					@A_Ｍ９_初期設置 Ｍ９ d:ステージ左上 0 なし 6
				}
				case( 刀ライデン ){
					// 無し
				}
				case( スネーク ){
					@A_Ｍ９_初期設置 Ｍ９ d:スタート北 0 なし 8
				}
				case( タキシードスネーク ){
					//無し
				}
				case( 前作スネーク ){
					@A_ＵＳＰ_初期設置 ＵＳＰ d:最右穴前 0 なし 5
					@ＵＳＰサプレッサ_初期設置 さプレ d:へこみ通路南 0
					@A_Ｍ９_初期設置 Ｍ９ d:ゴール前Ｔ字路 0 なし 5
				}
				default{
				}
			}
		}
	}
