	// ------------------------------------
	// 敵兵や的の処理
	// ------------------------------------
	// 敵兵に関する設定
	//-------------------------------------
	proc ゴルルゴン設定 {
		#if d:DEBUG_PRINT
			print 'goll_set'
		#endif

		local $$:ゴルルゴン基本視力;

		chara ゴルルコマンダー ゴルルコマンダー 

		if ( $s:選択プレイヤー == ライデン ) {
			$$:ゴルルゴン基本視力 = 23000;

			chara ゴルルゴン ゴルルゴン:01 -r 0 -m 1 -l $$:ゴルルゴン基本視力
			chara ゴルルゴン ゴルルゴン:02 -r 2 -m 1 -l $$:ゴルルゴン基本視力
			chara ゴルルゴン ゴルルゴン:03 -r 4 -m 1 -l $$:ゴルルゴン基本視力
			chara ゴルルゴン ゴルルゴン:04 -r 6 -m 1 -l $$:ゴルルゴン基本視力

			// ルートチェンジ設定
			trap en001 ゴルルゴン:01 \
				-mask 入る \
				-exec {
					mesg ゴルルゴン ゴルルゴン:01 ルート変更 1 0
					command トラップ切り替え -trap en001 -switch 0
				}

			trap en002 ゴルルゴン:02 \
				-mask 入る \
				-exec {
					mesg ゴルルゴン ゴルルゴン:02 ルート変更 3 0
					command トラップ切り替え -trap en002 -switch 0
				}

			trap en003 ゴルルゴン:03 \
				-mask 入る \
				-exec {
					mesg ゴルルゴン ゴルルゴン:03 ルート変更 5 0
					command トラップ切り替え -trap en003 -switch 0
				}


		} else {
			// スネーク
			$$:ゴルルゴン基本視力 = 25000;

			chara ゴルルゴン ゲノラ:01 -r 10 -m 1 -l $$:ゴルルゴン基本視力
			chara ゴルルゴン ゲノラ:02 -r 12 -m 1 -l $$:ゴルルゴン基本視力
			chara ゴルルゴン ゲノラ:03 -r 14 -m 1 -l $$:ゴルルゴン基本視力
			chara ゴルルゴン ゲノラ:04 -r 15 -m 1 -l $$:ゴルルゴン基本視力

			// ルートチェンジ設定
			trap en011 ゲノラ:01 \
				-mask 入る \
				-exec {
					mesg ゴルルゴン ゲノラ:01 ルート変更 11 0
					command トラップ切り替え -trap en011 -switch 0
				}

			trap en012 ゲノラ:02 \
				-mask 入る \
				-exec {
					mesg ゴルルゴン ゲノラ:02 ルート変更 13 0
					command トラップ切り替え -trap en012 -switch 0
				}

			trap en013 ゲノラ:04 \
				-mask 入る \
				-exec {
					mesg ゴルルゴン ゲノラ:04 ルート変更 16 2
					command トラップ切り替え -trap en013 -switch 0
				}

		}
	}

	// ------------------------------------
	// ＢＧＭの設定
	// ------------------------------------
	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT 
			print 'bgm_set'
		#endif

		chara ＢＧＭマネージャー ＢＧＭマネ
	}


	// ------------------------------------
	// その他オブジェクト関係
	// ------------------------------------
	proc 落下死設定 {
		trap de001 d:PLAYER \
			-mask 入る \
			-exec {
				mesg プレイヤー d:PLAYER position 27000 $i:プレイヤー位置Ｙ -12000
				@落下死カメラ設定 0
				@ジャンプ落下死発動 0x0004 -30000
			}

		trap de002 d:PLAYER \
			-mask 入る \
			-exec {
				mesg プレイヤー d:PLAYER position 29000 $i:プレイヤー位置Ｙ -22500
				@落下死カメラ設定 0
				@ジャンプ落下死発動 0x0004 -30000
			}

		trap de003 d:PLAYER \
			-mask 入る \
			-exec {
				mesg プレイヤー d:PLAYER position 29000 $i:プレイヤー位置Ｙ -29500
				@落下死カメラ設定 0
				@ジャンプ落下死発動 0x0004 -30000
			}

		trap de004 d:PLAYER \
			-mask 入る \
			-exec {
				if ( $4 < 49000 ) {
					mesg プレイヤー d:PLAYER position2 0 49000
				} else if ( $4 > 50000 ) {
					mesg プレイヤー d:PLAYER position2 0 50000
				}
				
				@落下死カメラ設定 15000
				// ビルからの落下は床を突き抜けるので、こっちでゲームオーバー処理を先に奪ってしまう
				@ジャンプ落下死発動 0x0004 2500
			}

	}

	// 落下死カメラ設定
	proc 落下死カメラ設定 $:p_床の高さ {
		chara delay ディレイ \
			-time 1 \
			-arg $:p_床の高さ \
			-exec {
				chara カメラ設定 クリア時カメラ \
					-c 0 \	
					-b d:CAM_MIN,(5750+$1),d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,($1-500),d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 998,2154,0 -f 5725 \
					-a 200 \
					-i 0 0 0 0 \
					-s 1
			}

	}

	// ジャンプ落下死発動から呼ばれるプロック
	proc ジャンプ落下死開始処理 {
		#if d:DEBUG_PRINT
			print 'jump_gameover_start'
		#endif

		@ゲームオーバー開始処理
	}

	// 最終的に落ちたときに呼ばれるプロック（サウンドや振動を呼ぶ）
	proc ゲームオーバー終了処理 {
		#if d:DEBUG_PRINT
			print 'jump_gameover_start $i:プレイヤー位置Ｙ='$i:プレイヤー位置Ｙ
		#endif

		command ゲームオーバー処理終了
	}



	// ------------------------------------
	// 光源関係
	// ------------------------------------
	// ------------------------------------

	// ------------------------------------
	// カメラ関係の設定 
	// ------------------------------------
	// ステージカメラ設定 
	// ------------------------------------
	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'chara_camera & stage_camera_set'
		#endif

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0 
		chara カメラ メインカメラ		-c 0 -l 2 -p 40
		chara カメラ サブカメラ			-c 0 -l 2 -p 30
		chara カメラ サブカメラ２		-c 0 -l 2 -p 20
		chara カメラ モーションカメラ	-c 0 -l 2 -p 10
		chara カメラ クリア時カメラ		-c 0 -l 0 -p 10

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \	
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 300,2048,0 \
			-f 5000 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}
	// ステージ固有のカメラ設定 
	// ------------------------------------
	proc ゴルルゴンステージカメラ設定 {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif

		//---------------------
		// 通常のステージカメラ
		//---------------------
		// スタート地点～台までのカメラ
		trap ca001 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ降順 $6 -500 -6000 300 0
				eval( $i:補完ＲＸ = $i:CS_結果１ );

				chara カメラ設定 メインカメラ \
					-c 0 \	
					-b -10000,1051,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,4500 \
					-l -10000,1842,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,-1000 \
					-r $i:補完ＲＸ,2048,0 \
					-f 6250 \
					-a 200 \
					-i 3 3 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// 台～階段までのカメラ
		trap ca002 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ昇順 $4 14000 25000 1051 8300
				eval( $i:補完ＢＹ = $i:CS_結果１ );

				@CS_スムーズカメラ昇順 $4 14000 25000 1842 3000
				eval( $i:補完ＴＹ = $i:CS_結果１ );

				@CS_スムーズカメラ昇順 $4 14000 25000 0 400
				eval( $i:補完ＲＸ = $i:CS_結果１ );

				@CS_スムーズカメラ昇順 $4 14000 25000 6250 10000
				eval( $w:補完距離 = $i:CS_結果１ );

				chara カメラ設定 メインカメラ \
					-c 0 \	
					-b -10000,$i:補完ＢＹ,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,4500 \
					-l -10000,$i:補完ＴＹ,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,-1000 \
					-r $i:補完ＲＸ,2048,0 \
					-f $w:補完距離 \
					-a 200 \
					-i 3 3 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// 階段～建物入口までのカメラ
		trap ca003 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ昇順 $4 40500 44500 8300 6000
				eval( $i:補完ＢＹ = $i:CS_結果１ );

				@CS_スムーズカメラ昇順 $4 40500 44500 3000 6500
				eval( $i:補完ＴＹ = $i:CS_結果１ );

				@CS_スムーズカメラ昇順 $4 40500 44500 400 125
				eval( $i:補完ＲＸ = $i:CS_結果１ );

				@CS_スムーズカメラ昇順 $4 40500 44500 10000 6000
				eval( $w:補完距離 = $i:CS_結果１ );

				chara カメラ設定 メインカメラ \
					-c 0 \	
					-b -10000,$i:補完ＢＹ,d:CAM_MIN	 45500,d:CAM_MAX,4500 \
					-l -10000,$i:補完ＴＹ,d:CAM_MIN	 45500,d:CAM_MAX,-1000 \
					-r $i:補完ＲＸ,2048,0 \
					-f $w:補完距離 \
					-a 200 \
					-i 3 -1 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// 建物２階のカメラ
		trap ca004 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 メインカメラ \
					-c 0 \	
					-b 41081,6000,d:CAM_MIN	 43750,8000,4500 \
					-l 41658,6500,d:CAM_MIN	 43750,d:CAM_MAX,-1000 \
					-r 125,1984,0 \
					-f 6000 \
					-a 200 \
					-i 3 -1 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// 建物２階からの階段のカメラ
		trap ca005 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ昇順 $6 -40500 -36000 7250 11500
				eval( $i:補完ＴＹ = $i:CS_結果１ );

				@CS_スムーズカメラ昇順 $6 -40500 -36000 500 200
				eval( $i:補完ＲＸ = $i:CS_結果１ );

				chara カメラ設定 サブカメラ \
					-c 0 \	
					-b 46250,d:CAM_MIN,d:CAM_MIN	 46250,14000,4500 \
					-l 46250,$i:補完ＴＹ,d:CAM_MIN	 46250,d:CAM_MAX,-1000 \
					-r $i:補完ＲＸ,2048,0 \
					-f 5500 \
					-a 200 \
					-i 0 0 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// 建物３階のカメラ
		trap ca006 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ２ \
					-c 0 \	
					-b 38000,12000,d:CAM_MIN	 46250,13750,4500 \
					-l 38000,11500,d:CAM_MIN	 46250,d:CAM_MAX,-1000 \
					-r 200,2048,0 \
					-f 6000 \
					-a 200 \
					-i 2 2 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// 建物３階からの階段のカメラ
		trap ca007 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ昇順 $5 11000 16000 11500 16500
				eval( $i:補完ＴＹ = $i:CS_結果１ );

				@CS_スムーズカメラ昇順 $5 11000 16000 200 400
				eval( $i:補完ＲＸ = $i:CS_結果１ );

				@CS_スムーズカメラ昇順 $5 11000 16000 6000 8000
				eval( $w:補完距離 = $i:CS_結果１ );

				chara カメラ設定 サブカメラ２ \
					-c 0 \	
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,4500 \
					-l d:CAM_MIN,$i:補完ＴＹ,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,-1000 \
					-r $i:補完ＲＸ,2048,0 \
					-f $w:補完距離 \
					-a 200 \
					-i 2 2 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// 南北通路北側の壁の裏にあたるカメラ
		trap ca008 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ \
					-c 0 \	
					-b -10000,8300,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,-27865 \
					-l -10000,3000,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,-31190 \
					-r 800,2048,0 \
					-f 10000 \
					-a 200 \
					-i 3 3 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// 建物３階窓に登ったときのカメラ
		trap ca009 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ \
					-c 0 \	
					-b 40500,12000,d:CAM_MIN	 46250,13750,4500 \
					-l 37500,11500,d:CAM_MIN	 46250,d:CAM_MAX,-1000 \
					-r 200,2369,0 \
					-f 6000 \
					-a 200 \
					-i 2 2 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		//-------------------------
		// 匍匐カメラ
		//-------------------------
		// 南北通路南側の壁の裏にあたるカメラ
		trap ca010 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_SQUAT d:TRP_STATE_GROUND \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ \
					-c 0 \	
					-b -10000,8300,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l -10000,3000,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 870,2048,0 \
					-f 10000 \
					-a 200 \
					-i 3 3 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}
		
		// 建物２階から３階への階段部分のカメラ
		trap ca011 d:PLAYER \
			-mask ＊ \
			-state d:TRP_STATE_SQUAT d:TRP_STATE_GROUND \
			-camera \
			-exec {
				@CS_スムーズカメラ昇順 $6 -40500 -36000 7250 11500
				eval( $i:補完ＴＹ = $i:CS_結果１ );

				chara カメラ設定 サブカメラ２ \
					-c 0 \	
					-b 46250,d:CAM_MIN,d:CAM_MIN	 46250,14000,4500 \
					-l 46250,$i:補完ＴＹ,d:CAM_MIN	 46250,d:CAM_MAX,-1000 \
					-r 500,2048,0 \
					-f 5500 \
					-a 200 \
					-i 3 3 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}
	}





// -----------------------------------------------------------------------------------
// 以下デバッグ専用proc
// -----------------------------------------------------------------------------------
// デバッグキャラ
// ------------------------------------
proc デバッグキャラセット {
	#if d:DEBUG_PRINT
		print 'debug_chara_set'
	#endif

	#if d:CHARA_CAMERA
		chara キャラカメラ 敵兵カメラ \
			-c d:TARGET_CHARA \
			-s -920,610,200 \
			-r -200,1024,0 
	#endif

	#if d:SCREENSHOT
		chara スクリーンショット shot
	#endif

	#if d:USB_KEY
		chara USBキーボード実行 test \
			-e d:KBD_ESC {	
				mesg プレイヤー d:PLAYER position -5500, -13000, -500
			} \
	#endif
}
