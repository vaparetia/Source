	//プロジェクタ光設定
	// ------------------------------------

	proc プロジェクタライト設定 {
		print 'プロジェクタライト設定'

		chara スポットライト投影モデル プロジェクタライト \
			-m w04a1_k1 \
			-p 0,0,0

		chara 静止スポットライト設置 プロジェクタライト \
			-pos 140,-15600,-1300 \
			-dir -184,1894,0 \
			-range 30000 \
			-angle 15 \
			-color 255,255,255 \
			-option 0x8001




//	( DX , DY , DZ )のベクトルの算出は、
//	( atan( DY / sqr( DX^2 + DZ^2 ) ) * ( -4096 / 360 ) , 1024 + atan( DY/DX ) * ( -4096 / 360 ) , 0 )

		chara プロジェクタライト プロジェクタライト \
			-p 140,-15600,-1300 \
			-d 4000,-10000,-22000


#if d:movie
#if 1
		chara スポットライト背景イメージ指定 テストムービー
#else
		chara スポットライト背景イメージ指定 テストムービー \
			//-image $s:テクスチャ名（raw形式イメージなので注意！（RGBARGBA・・・））\
			-movie t:iputest1
			//-file 'host0:testmovie256_16.ipu'
#endif
#endif

	}


