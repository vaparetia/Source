#if d:PLANT_DEMO_ALL_SKIP
	#define		DEMO_SKIP_ENABLE 1
#else
	#define		DEMO_SKIP_ENABLE 0
#endif

#include	w15_d_common.h		//共通プロック

// キャスティングシアター対応。
#include "lowpoly.h"
@ローポリ設定


chara サウンドマネージャー ＳＤマネ -pak 0

// マップ設定
// ------------------------------------
chara マップ ＢＣ連絡橋 -h d:HZX_NAME -l d:LT2_NAME

command マップ設定 ＢＣ連絡橋 -set {

//	デモ環境かゲーム環境かで起動を読み分ける。
// ------------------------------------
#if d:MGS2_DEMO

chara デモアクトデバッグ demodebug  -i t:p012_01_p01 -d 'p012_01_p01' -l  -s 'p012_01_p01'  \
		-p ＢＣ連絡橋破壊前オン ＢＣ連絡橋破壊前オフ \
		   ＢＣ連絡橋破壊後オン ＢＣ連絡橋破壊後オフ \
		   全かもめ緊急離陸 全かもめ死亡１ 全かもめ死亡２ 全かもめ死亡３ フォーチュン群がりカモメ散れ \
		   フォーチュンリニアガンオン フォーチュンリニアガンオフ \
		   爆発でカモメ待避 待避したカモメ全体に散れ \
		   しがみつくシールズ影出し しがみつくシールズ影削除

//			eval($s:d_num = t01a1D)


#else


// 実際の再生
//-----------------------------------------------------------
	// 実際のデモ再生の方も、ストーリーフラグで変える
	if($w:p_story <= d:ST:P012_01_P01フォーチュン遭遇１ポリゴンデモ１開始) {
		print '$w:p_story = ST:P012_01_P01フォーチュン遭遇１ポリゴンデモ１開始'

		/* フォーチュン、SEALを殲滅 */

		// デモ特有の変数代入
		eval($s:d_num = P012_01_p01)

		@デモモデル差し替え処理
		proc デモ再生_P012_01_p01 {
				chara demo デモ再生 \
//					-i t:data_dummy_raiden \
					-i t:p012_01_p01 \
					-p ＢＣ連絡橋破壊前オン ＢＣ連絡橋破壊前オフ \
					   ＢＣ連絡橋破壊後オン ＢＣ連絡橋破壊後オフ \
					   全かもめ緊急離陸 全かもめ死亡１ 全かもめ死亡２ 全かもめ死亡３ フォーチュン群がりカモメ散れ \
					   フォーチュンリニアガンオン フォーチュンリニアガンオフ \
					   爆発でカモメ待避 待避したカモメ全体に散れ \
					   しがみつくシールズ影出し しがみつくシールズ影削除 \
					-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
					-next P012_01_p01終了
		}
		@デモ再生_P012_01_p01

	} else if( d:ST:P012_01_P01フォーチュン遭遇１ポリゴンデモ１終了 <= $w:p_story && \
					$w:p_story < d:ST:P012_02_R01フォーチュン遭遇２無線デモ１開始) {

		/* 大佐強制センド　SEAL全滅を報告 */

		// デモ特有の変数代入
		eval($s:d_num = P012_02_r01)
		command セットサウンドコード -c d:SNG_PLAY_06
		@rt_P012_02_R01_フォーチュン遭遇２無線デモ１
	}

#endif


// 以下、諸々セット
//-----------------------------------------------------------
	@常駐キャラ設定						// stdch.hで定義

	chara デモキャンセルチェック デモキャンセル \
		-p demo_cancel

	@ステージモデル本体セット
	@エフェクト設定
	@デモ用薬莢用メモリ確保セット
	@かもめさんセット

	//	w15_d_common.h内
	@ドア設置
	@海面設置
	@空設置
	@フォグ設定

	@リアル影セット
	@リアル影セット２

//	@プラント海面セット 朝 w15a 1
//	@プラントステージでのフォグセット 朝 0


	// 無線ではシネマスクリーン起動しない
	if($s:d_num != P012_02_r01){
		@シネマスクリーンセット // 水谷
	}
}

//初期マップの表示
// -----------------------------------
command マップ表示 	-add ＢＣ連絡橋


//###################################################################################
//									各proc設定
//###################################################################################
// デモデモ再生関連のプロック
//-----------------------------------------------------------
proc null {}

proc demo_cancel {
	command StreamStopAll
}

proc P012_01_p01終了 {
	if ($f:ローポリ劇場フラグ == d:TRUE) {
		// ローポリ劇場中
		@mv_lowpoly

	} else {
		// 通常ゲーム中
		@デモ終了時シネマスクリーンオフ
		mesg デモキャンセルチェック デモキャンセル kill

		print '$w:p_story = d:ST:P012_01_P01フォーチュン遭遇１ポリゴンデモ１終了'
		eval($w:p_story = d:ST:P012_01_P01フォーチュン遭遇１ポリゴンデモ１終了)

		chara delay ディレイ \
			-time 1 \ 
			-exec{
				restart
			}
	}
}

/*
proc P012_02_r01終了 {
		eval($w:p_story = d:ST:P012_02_R01フォーチュン遭遇２無線デモ１終了)
		// ゲームへ
		@ゲームステージへ戻る
		@mv_w14a_w15a_0
}
*/


proc シネマスクリーンセット  {
	chara シネマスクリーン シネマ \
		-top d:CINEMA_BELT_UPPER \
		-bottom d:CINEMA_BELT_LOWER \
		-ftime 60	//デフォルト値（ゼロは駄目）
	mesg シネマスクリーン シネマ フェードアウト 1
}


