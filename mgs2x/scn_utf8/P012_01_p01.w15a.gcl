	chara プットオブジェ ＤＥ連絡橋 \
		-m d:KMS_NAME6 \
		-r 0 0 0 \
		-p 0 0 0 \
		-l d:LT2_NAME \
		-s 100 100 100

	chara プットオブジェ ＦＡ連絡橋 \
		-m d:KMS_NAME7 \
		-r 0 0 0 \
		-p 0 0 0 \
		-l d:LT2_NAME \
		-s 100 100 100

	chara プットオブジェ Ｃ脚 \
		-m d:KMS_NAME8 \
		-r 0 0 0 \
		-p 0 0 0 \
		-l d:LT2_NAME \
		-s 100 100 100

	chara プットオブジェ Ｅ脚 \
		-m d:KMS_NAME9 \
		-r 0 0 0 \
