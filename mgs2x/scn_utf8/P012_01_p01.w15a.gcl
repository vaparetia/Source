	chara プットオブジェ 浮き橋２ \
		-m d:KMS_NAME11 \
		-r 0 0 0 \
		-p 0 0 0 \
		-l d:LT2_NAME \
		-s 100 100 100

	chara プットオブジェ 浮き橋３ \
		-m d:KMS_NAME12 \
