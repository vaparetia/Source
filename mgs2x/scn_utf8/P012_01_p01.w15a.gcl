proc 全かもめ緊急離陸 {
	mesg かもめマネージャ かもめマネージャ１ 全かもめ緊急離陸 15
}

proc 全かもめ死亡１ {
	#if 0
		mesg かもめマネージャ かもめマネージャ１ 全かもめ死亡 15
	#else
		mesg かもめマネージャ かもめマネージャ１ 指定エリア内搾取死亡 \
			-44000, 1000, -70000,  -34000, 8000, -45000 480
		mesg かもめマネージャ かもめマネージャ１ 落下速度設定 110
	#endif
}
proc 全かもめ死亡２ {
	#if 0
		mesg かもめマネージャ かもめマネージャ１ 全かもめ死亡 15
	#else
		mesg かもめマネージャ かもめマネージャ１ 指定エリア内搾取死亡 \
			-50000, 1000, -70000,  -25000, 8000, -61000 360
		mesg かもめマネージャ かもめマネージャ１ 落下速度設定 110
	#endif
}
proc 全かもめ死亡３ {
	#if 0
		mesg かもめマネージャ かもめマネージャ１ 全かもめ死亡 15
	#else
		mesg かもめマネージャ かもめマネージャ１ 指定エリア内搾取死亡 \
			-50000, 1000, -59000,  -25000, 8000, -45000 400
		mesg かもめマネージャ かもめマネージャ１ 落下速度設定 110
	#endif
}

proc フォーチュン群がりカモメ散れ {
	mesg かもめマネージャ かもめマネージャ１ 指定エリア内飛行エリア変更 \
		-60000, 1500, -67500,  -25000, 4500, -52500 \ // 変更もと
//		-70000, 2000, -80000,  -25000, 6000, -40000 \
		-60000, 1500, -72000,  -25000, 4500, -46000 \ // 変更先（全体）
		120
}

proc 爆発でカモメ待避 {
	mesg かもめマネージャ かもめマネージャ１ 指定エリア内緊急散開 \
		-46500 1500 -65000 -24500 4500 -55000 \
		-60500 6500 -71000 -51500 9500 -50000 \
//		-60500 6500 -71000 -51500 9500 -50000 \
		250 \
		30
}

proc 待避したカモメ全体に散れ {
	mesg かもめマネージャ かもめマネージャ１ 指定エリア内飛行エリア変更 \
		-60500 6500 -71000 -51500 9500 -50000 \ // 変更もと
		-45000, 1500, -72000,  -33000, 4500, -46000 \ // 変更先（全体）
//		-60000, 1500, -72000,  -25000, 4500, -46000 \ // 変更先（全体）
		120
}

// [追加] 2001/08/30 Uehara Masatoshi
proc リアル影セット {
	chara 影投影モデル 影もでる \
		-m w15demo_sdw00 \
		-p -1 1 -1

	chara 影管理 影かんり \
		-t 0 \
		-p 71 -70 69

	mesg 影管理 影かんり demo_add for_coat_addhand_demo 影もでる	// ファーチュン
	mesg 影管理 影かんり demo_add vmp_coat_demo         影もでる	// ヴァンプ
	mesg 影管理 影かんり demo_add vmp_coat_demo02       影もでる	// ヴァンプ
	mesg 影管理 影かんり demo_add jam_def_demo          影もでる	// 大統領

	mesg 影管理 影かんり demo_add sel_def_B0 影もでる	// 中腰射撃兵（ブラボー）
	mesg 影管理 影かんり demo_add sel_def_B1 影もでる	// 匍匐射撃兵（ブラボー）
	mesg 影管理 影かんり demo_add sel_def_C0 影もでる	// グレネード兵（アルファ）
	mesg 影管理 影かんり demo_add sel_def_D0 影もでる	// 兵（アルファ）
	mesg 影管理 影かんり demo_add sel_def_E0 影もでる	// 落下兵（アルファ）
	mesg 影管理 影かんり demo_add sel_def_F  影もでる	// 後続兵１（アルファ）
	mesg 影管理 影かんり demo_add sel_def_G  影もでる	// 後続兵２（アルファ）
	mesg 影管理 影かんり demo_add sel_def_H  影もでる	// 後続兵３（アルファ）

	mesg 影管理 影かんり demo_add demo_m4_sel_D0 影もでる	// 兵（アルファ）の銃

	mesg 影管理 影かんり demo_add blackcase         影もでる	// ブラックケース（床置き）
	mesg 影管理 影かんり demo_add blackcase02       影もでる	// ブラックケース（手持ち）
	mesg 影管理 影かんり demo_add demo_m4_grn_bul02 影もでる	// グレネード弾
	mesg 影管理 影かんり demo_add kmo_def           影もでる	// ごめんねカモメさん

}

proc フォーチュンリニアガンオン {
	mesg 影管理 影かんり demo_add demo_lnr 影もでる	// ファーチュンリニアガン
}
proc フォーチュンリニアガンオフ {
	mesg 影管理 影かんり del demo_lnr	// ファーチュンリニアガン
}

proc リアル影セット２ {
	chara 影投影モデル２ 影管理2代目 \
		-ctrl w15a_obj02_A

	chara 影管理 影かんり２ \
		-t 0 \
		-p 71 -70 69
}

proc しがみつくシールズ影出し {
	mesg 影管理 影かんり２ demo_add sel_def_E1 影管理2代目
}

proc しがみつくシールズ影削除 {
	mesg 影管理 影かんり２ del sel_def_E1
}

