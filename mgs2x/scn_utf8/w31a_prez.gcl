	d:PREZ_REACT_BEHIND,   d:PREZ_REACT_BEHIND,   d:PREZ_REACT_BEHIND,   d:PREZ_REACT_BEHIND, \
	d:PREZ_REACT_BASE,     d:PREZ_REACT_BASE,     d:PREZ_REACT_TUMBLE,   d:PREZ_REACT_TUMBLE, \
	// 電気板上 \
	d:PREZ_REACT_BEHIND, d:PREZ_REACT_BEHIND,   d:PREZ_REACT_BEHIND, d:PREZ_REACT_BEHIND, \
	d:PREZ_REACT_BASE,   d:PREZ_REACT_SIDESTEP, d:PREZ_REACT_BEHIND, d:PREZ_REACT_BEHIND, \
	// 電気板下 \
