#enum{ // エリア
PREZ_AREA_1,	// 西壁上
PREZ_AREA_2,	// 西壁下
PREZ_AREA_3,	// 北壁上
PREZ_AREA_4,	// 北壁中
PREZ_AREA_5,	// 北壁下
PREZ_AREA_6,	// 電気板への通路
PREZ_AREA_7,	// 電気板前
PREZ_AREA_8,	// 電気板前下
PREZ_AREA_MAX,
}
#define PREZ_AREA_N -1 // 該当無し

#enum{ // 逃げエリア
// 通常
PR01_NORMAL01,
PR02_NORMAL01,
PR03_NORMAL01,
PR04_NORMAL01,
