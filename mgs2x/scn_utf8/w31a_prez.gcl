proc 大統領ニキータイベント設定{
//    command ニキータイベント大統領難易度取得 $i:大統領難易度
     eval($i:大統領難易度 = $w:ゲーム設定)
#if d:DEBUG_PRINT
	print $i:大統領難易度
#endif
    if ( $i:大統領難易度 == d:LEVEL_VERYEASY ){
	@ニキータイベント大統領_VERYEASY;
    }else if ( $i:大統領難易度 == d:LEVEL_EASY ){
	@ニキータイベント大統領_EASY;
    }else if ( $i:大統領難易度 == d:LEVEL_NORMAL ){
	@ニキータイベント大統領_NORMAL;
    }else if ( $i:大統領難易度 == d:LEVEL_HARD ){
	@ニキータイベント大統領_HARD;
    }else if ( $i:大統領難易度 >= d:LEVEL_EXTREME ){
	@ニキータイベント大統領_EXTREME;
    }

	// 大統領ネクタイ
	chara ロープモデル３ ネクタイ \
		-n jam_tie \
		-d 6 \
		-b jam_bounding \
		-y 健康な大統領 \
		-z 2 \
		-x 0,0,0 \
		-m 22 \
		-p 250 \
		-k 350 \
		-o 100 \
		-f 1 \
		-h 1 \
		-v
}

