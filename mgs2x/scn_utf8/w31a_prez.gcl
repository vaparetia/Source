PR06_NORMAL01,
PR07_NORMAL01,
PR08_NORMAL01,
// はりつき
PR01_BEHIND01,
PR01_BEHIND02,
PR01_BEHIND03,
PR02_BEHIND01,
PR02_BEHIND02,
PR02_BEHIND03,
PR03_BEHIND01,
PR04_BEHIND01,
PR05_BEHIND01,
PR05_BEHIND02,
PR06_BEHIND01,
PR06_BEHIND02,
PR07_BEHIND01,
PR08_BEHIND01,
// 横飛び
PR01_SIDE01,
PR02_SIDE01,
PR04_SIDE01,
PR05_SIDE01,
PR07_SIDE01,
// 転倒
