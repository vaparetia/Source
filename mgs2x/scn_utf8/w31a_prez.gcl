	d:PREZ_REACT_BASE,   d:PREZ_REACT_SIDESTEP, d:PREZ_REACT_BEHIND, d:PREZ_REACT_BEHIND, \
	
	-gtrap knock_area

	if ( $w:p_story < d:ST:P048_01_P01電源パネル破壊１ポリゴンデモ１開始 ) {
	     mesg ニキータイベント大統領 健康な大統領 寝かせる  6450, 1098, -245800, 0
	}
}

