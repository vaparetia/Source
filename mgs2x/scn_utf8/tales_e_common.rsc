EOF




	E14_ＶＲ制御奪い返し: << EOF
#C(101)#C1
EOF

	E15_対ＲＡＹクリア: << EOF
#C(101)#C1
EOF

/*
	E16_エンディング: << EOF
#C1#W#C2#W#C3#W

#C(202)#W
#C(100)

EOF
*/

	E16_エンディング１: << EOF
#C(101)#C1#W#C2#W#C3
EOF

	E16_エンディング２: << EOF
#C(202)#W
#C(100)
EOF




