//狙撃後 d //e
//エマの状態について h //e
resource PS_狙撃後＿エマ傷１__s {
//vox t:vc212241 {
ライデン_000: {
&~?Qu&'e tal est&'a Emma?
}
//	<<<ENGLISH>>>
