}
//	<<<ENGLISH>>>
//	Nothing, I told you.
//	Don't worry about it.

/*なんでもない。気にするな。*/
//dv}//v
}//d

//★P065_06_R02Ｌ脚エマ６無線機デモ２終了＜フラグ＜P067_01_R01エマ狙撃１無線機デモ１開始＝狙撃イベント d //e
