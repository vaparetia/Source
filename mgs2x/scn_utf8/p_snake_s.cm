}
//	<<<ENGLISH>>>
//	Raiden, we're not doing so well up
//	here. This would be a good time to
//	get rid of that Harrier.

/*ライデン、こっちはかなり危ない状況だ。
早くハリアーを落としてくれ。*/
//dv}//v
}//d
//カサッカ死亡寸前２ h //e
resource PS_ハリアー戦＿カサッカ死亡寸前２__s {
//vox t:vc210711 {
ライデン_000: {
&~?Est&'ais los dos bien?
}
//	<<<ENGLISH>>>
//	Are you two all right!?

/*大丈夫か！？*/
プリスキン_001: {
Lo siento Raiden, pero a menos que
puedas hacer algo con el Harrier,
estamos acabados.
}
//	<<<ENGLISH>>>
//	Sorry, Raiden, but we're just about
//	done unless you can do something
//	about the Harrier.

/*すまん、ライデン。
こっちの方はもういくらも持ちそうに
