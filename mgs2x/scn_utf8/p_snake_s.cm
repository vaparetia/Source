//ＤＧ連絡橋以外 h //e
resource PS_ＤＧ連絡橋以外__s {
//vox t:vc210511 {
プリスキン_000: {
Para llegar al Shell 2 tienes que desactivar
todos los sensores de infrarrojos del
puente de conexi&'on
}
//	<<<ENGLISH>>>
//	In order to get to Shell 2, you'll
//	have to disable the IR sensors
//	on the connecting bridge＃－
//<ページ数変更>
プリスキン_000_1: {
entre el Shell 1 y el Shell 2.
