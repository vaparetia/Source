}
//	<<<ENGLISH>>>
//	You have something against us
//	that we don't know about!?

/*お前、俺達に何か恨みでもあるのか！！*/
//dv}//v
}//d

//カサッカ死亡寸前１ h //e
resource PS_ハリアー戦＿カサッカ死亡寸前１__s {
//vox t:vc210701 {
プリスキン_000: {
Raiden, las cosas no van muy bien por
aqu&'i. &'Este es un buen momento para
