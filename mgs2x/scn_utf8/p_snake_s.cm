//<ページ数変更>
プリスキン_001_1: {
Si no ves la unidad de control espera a
que cambie el viento para disparar.
}
//	<<<ENGLISH>>>
//	Wait until the wind changes
//	and you can see the control
//	unit, then shoot.

/*間違ってセムテックスを撃ってしまった
ら終わりだぞ。風向きが変わって旗の
向こう側が見えた時に狙うんだ。
*/
//dv}//v
}//d

//サイファー h //e
resource PS_ＤＧ連絡橋＿サイファーヒント__s {
//vox t:vc210611 {
プリスキン_000: {
Hecha problemas con los Cyphers que
hay por esta zona.
}
//	<<<ENGLISH>>>
//	I had some trouble with Cyphers
//	flying around the area.

/*そういえば、サイファーが飛んでいて
