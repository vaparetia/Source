//	You'd better watch your back.
//	He may be waiting to ambush.

/*気をつけたほうがいいな。
待ち伏せしているかもしれん。*/
ライデン_004: {
De acuerdo...
}
//	<<<ENGLISH(2)>>>
//	OK...

/*……ああ……。*/
//dv}//v
}//d
