*/
ライデン_002: {
&~?Qu&'e quieres decir?
}
//	<<<ENGLISH>>>
//	What're you trying to say?

/*つまり？*/
//dv}//v
}//d
resource PS_狙撃後＿エマ傷２__s {
//vox t:vc212251 {
プリスキン_000: {
Igual ha sufrido da&~nos internos.
}
//	<<<ENGLISH>>>
//	That there's the possibility
//	of intestinal damage.
//<ページ数変更>
プリスキン_000_1: {
Adem&'as, est&'a perdiendo mucha sangre... y
la presi&'on arterial cada vez es m&'as baja...
}
//	<<<ENGLISH>>>
//	Added to that, she's bleeding
//	bad... losing blood pressure...

/*腸管や腸間膜まで損傷している可能性が
あるということだ。加えて出血も多い。
