//	The cloud indicates the rough
//	location of the explosive.

/*検知された『匂い』は雲のような形で
レーダー状に表示される。Ｃ４は必ず
その近くにあるはずだ。
*/
//dv}//v
}//d
resource PS_センサーＡ２__s {
