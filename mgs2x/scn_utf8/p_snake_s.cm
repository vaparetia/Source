//<ページ数変更>
プリスキン_005_1: {
&'este escanear&'a la zona en la que te
encuentras, y si detecta alg&'un explosivo,
pitar&'a.
}
//	<<<ENGLISH>>>
//	will automatically scan the area
//	around you, and will sound a warning
//	if there's an explosive nearby.

/*装備するだけで自動的に周囲の走査を
行ってくれる。同じエリアに爆発物を
