//	against that kind of firepower.

/*ハリアーが機銃を撃ってきたらすぐに
遮蔽物に隠れるんだ。いいね。
*/

}//d
//ロケットランチャー h //e
resource PS_ハリアー戦＿ロケット１__s {
//vox t:vc212041 {
オタコン_000: {
El Harrier 2 est&'a equipado con cohetes de
aire-tierra en ambas alas.
}
//	<<<ENGLISH>>>
//	The Harrier 2 comes equipped
//	with air-to-surface rocket pods
//	on both wings.

/*ハリアー２は両翼に対地攻撃用の
