}
//	<<<ENGLISH>>>
//	We're having some problems.
//	You're going to have to deal
//	by yourself for a while.
//<ページ数変更>
プリスキン_001_1: {
Cuida de Emma &~?vale?
}
//	<<<ENGLISH>>>
//	Take good care of
//	Emma, all right?

/*少し手間取っている。
それまで一人でなんとかしてくれ。
エマを頼むぞ。
*/
//dv}//v
}//d
//狙撃依頼１ h //e
resource PS_エマ狙撃＿依頼１__s {
//vox t:vc210961 {
ライデン_000: {
Snake, yo no lo puedo hacer solo.
}
//	<<<ENGLISH>>>
//	Snake, I can't handle this alone.

/*スネーク、俺一人では無理のようだ……。*/
プリスキン_001: {
Vale. Ya me ocupo yo.
}
//	<<<ENGLISH>>>
