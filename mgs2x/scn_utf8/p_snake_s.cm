//dv}//v
}//d
resource PS_ＤＧ連絡橋＿旗ズパリ１__s {
//vox t:vc210591 {
プリスキン_000: {
Mira bien detr&'as de la bandera,
y ver&'as una unidad de control.
}
//	<<<ENGLISH>>>
//	Take a careful look behind the flag,
//	and you should see a control unit.

/*旗の後ろをよく見るんだ。
制御装置が隠れているぞ。*/
//dv}//v
}//d
resource PS_ＤＧ連絡橋＿旗ズパリ２__s {
//vox t:vc210601 {
プリスキン_000: {
Podr&'as disparar a la unidad de control a
