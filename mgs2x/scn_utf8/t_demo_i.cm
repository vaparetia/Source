/* -------------------------------

強制無線機デモ用にゃろーんむきゃ。
$Id: t_demo_i.cm,v 1.4 2001/11/26 01:01:31 usr01098 Exp $

---------------------------------*/
resource T_00b1Rオープニング無線機デモ__i {
スネーク_000: {
Qui &`e Snake. Mi ricevi, Otacon?
}
//	<<<ENGLISH>>>
//	This is Snake.
//	Do you read me, Otacon?

/*
こちらスネーク、
聞こえるか、オタコン？
*/
オタコン_001: {
Forte e chiaro, Snake.
}
//	<<<ENGLISH>>>
//	Loud and clear, Snake.

/*ああ僕だよ、スネーク。
聞こえる……。*/
スネーク_002: {
Ti ho fatto aspettare, eh?
Mi trovo al punto di infiltrazione.
}
//	<<<ENGLISH(2)>>>
//	Kept you waiting, huh?
//	I'm at the "sneak point."

/*……待たせたな。
＃｛潜入、スニーク｝＃ポイントに到着……。*/
オタコン_003: {
Tutto a posto, Snake?
}
//	<<<ENGLISH>>>
//	Everything going okay?

/*うまくいったかい？
*/
スネーク_004: {
La mia mimetica ottica &`e k.o. &`E stato
l'impatto.
}
//	<<<ENGLISH>>>
//	The stealth camo's busted.
//	Landing impact.

/*着地の衝撃でステルス迷彩が壊れた。*/
オタコン_005: {
L'avremo usata troppo. Scusa, sai, ma
devi prenderti cura dell'equipaggiamento.
}
//	<<<ENGLISH(2)>>>
//	We must have overused it.
//	Sorry, but you're gonna
//	have to deal with it.

/*随分こき使ってきたからね……。
悪いけど我慢してくれ。
*/
//<ページ数変更>
オタコン_005_1: {
Non sei pi&`u un militare.
}
//	<<<ENGLISH>>>
//	You're not in the
//	military anymore.

/*
軍じゃないんだ。
*/
スネーク_006: {
Giusto. Comunque non avevo intenzione di
fare troppo affidamento su questo
aggeggio.
}
//	<<<ENGLISH>>>
//	Right. I didn't plan on relying
//	on this gadget anyway.

/*ああ。いつまでも＃｛ステルス迷彩、こんなもの｝＃に
頼るつもりはない。*/
オタコン_007: {
Per&`o il settore privato non &`e cos&`i male, dai.
Almeno hai la tua privacy...
}
//	<<<ENGLISH>>>
//	The private sector's not so bad,
//	is it? Privacy guaranteed...

/*だけど民間のいいところもあるだろ？
プライバシーは守られてるし……。*/
スネーク_008: {
Basta che nessuno mi faccia qualche
sorpresa, stavolta.
}
//	<<<ENGLISH>>>
//	I'm happy as long as no one
//	gives me any more unwanted
//	gifts.

/*変な薬も盛られずに済むしな。*/
オタコン_009: {
Vuoi dire la faccenda di Naomi?
}
//	<<<ENGLISH>>>
//	You mean that thing with Naomi?

/*ナオミの事……？*/
スネーク_010: {
Devo dire che non mi manca proprio,
quella chiacchierona.
}
//	<<<ENGLISH>>>
//	And I can't say I miss
//	the chattering nanny.

/*うるさい見張り役がいないのも気が楽だ。*/
オタコン_011: {
Mei Ling non &`e cos&`i, per&`o. A proposito,
devo richiamarla per quel nuovo gingillo,
}
//	<<<ENGLISH>>>
//	Mei Ling's not so bad. That
//	reminds me, I have to get in
//	touch with her again

/*メイ・リンか……。
また彼女に頼んでおくよ。*/
//<ページ数変更>
オタコン_011_1: {
il Natik.
}
//	<<<ENGLISH>>>
//	about that new Natik flashware.

/*
＃｛ＮＡＴＩＣＫ、ナティック｝＃の新兵器。
*/
スネーク_012: {
Un altro aggeggio dell'SSCEN (Centro
sistemi militari esercito USA)? Dille
questo da parte mia: prima o poi,
}
//	Diverting toys from the SSCEN (U.S.
//	Army Soldier Systems Center) again?
//	Give her a message from me:

/*＃｛陸軍兵士システムセンター、ＮＡＴＩＣＫ｝＃からの
横流しか。彼女に伝えておいてくれ。*/
スネーク_013: {
qualcuno se ne accorger&`a.
}
//	<<<ENGLISH>>>
//	someone will find out
//	sooner or later.

/*いずれはバレる。*/
//<ページ数変更>
スネーク_013_1: {
Se fossi in lei, sparirei dalla circolazione
finch&'e c'&`e tempo.
}
//	<<<ENGLISH>>>
//	She's better off assuming
//	it's sooner and quit while
//	she's safe.

/*早いうちに手を引くようにな。*/
オタコン_014: {
Parole sacrosante, Snake. E ora
mettiamoci al lavoro.
}
//	<<<ENGLISH>>>
//	Too true. Okay, Snake,
//	let's get to work.

/*それもそうだね……。
じゃあスネーク、本題に入るよ。*/
オタコン_015: {
Sai come hanno venduto sul mercato nero
le specifiche tecniche del Metal Gear, dopo
Shadow Moses?
}
//	<<<ENGLISH>>>
//	You know how the technical specs of
//	Metal Gear were sold on the black
//	market after Shadow Moses?

/*シャドーモセス事件の後、メタルギアの
技術情報が＃｛闇市場、ブラックマーケット｝＃で密売されたよね。*/
スネーク_016: {
&`E tutta colpa di Ocelot......
}
//	<<<ENGLISH>>>
//	All Ocelot's doing...

/*オセロットの仕業だ。*/
オタコン_017: {
Esattamente. E ora ogni nazione, ogni
gruppo e ogni puntocom del pianeta ha una
sua versione di Metal Gear.
}
//	<<<ENGLISH>>>
//	Exactly. And now every state,
//	group and dotcom has its own
//	version of Metal Gear.

/*ああ。それで全世界にメタルギアの
亜種が拡散した。*/
スネーク_018: {
Insomma, altro che arma segreta per le
moderne superpotenze nucleari, eh?
}
//	<<<ENGLISH>>>
//	Not exactly a classified weapon
//	for today's nuclear powers.

/*いまや核武装国にとって、
メタルギアは特別な兵器ではない。*/
オタコン_019: {
Sembra che il nuovo modello sia al di
sopra degli altri Metal Gear.
}
//	<<<ENGLISH>>>
//	This new one seems to have been
//	designed to wipe the floor with
//	all the other models.

/*今回の新型はそれらに対抗する為に
設計されたものらしい。*/
//<ページ数変更>
オタコン_019_1: {
Si sa solo che &`e un veicolo anfibio
anti-Metal Gear...
}
//	<<<ENGLISH>>>
//	The only consistent description is
//	that it's an amphibious, anti-Metal
//	Gear vehicle...

/*水陸両用の
対メタルギア兵器……。*/
スネーク_020: {
Questo spiega perch&'e lo stiano
sviluppando i nostri amici della Marina.
}
//	<<<ENGLISH>>>
//	That explains why this one is
//	under Marine Corps jurisdiction.

/*それで新型は海兵隊の所属って訳か……？*/

}//d


resource T_03b1Rカモフ登場後無線機デモ体験版__i {
スネーク_000: {
Dobbiamo scoprire chi sono, e in fretta.
}
//	<<<ENGLISH>>>
//	We need to get a fix
//	on who they are.

/*奴等の正体を調べる必要があるな。
*/
オタコン_001: {
A giudicare dai mezzi di trasporto,
sembrano reparti speciali, non ti pare?
}
//	<<<ENGLISH>>>
//	Judging by their transport,
//	aren't they some kind of
//	military commandos?

/*そんなもの飛ばしてるなんて、
どこかの軍隊かな？
*/
スネーク_002: {
Non necessariamente. Potrebbe essere il
KA-62, il modello civile.
}
//	<<<ENGLISH>>>
//	Not necessarily. It could be
//	the KA-62, the civil model.

/*いや、そうとも言えない。
民間型のＫＡ-６２かもしれない。
*/
オタコン_003: {
Qui non &`e come a Shadow Moses.
Chiamami se succede qualcosa.
}
//	<<<ENGLISH>>>
//	This isn't like Shadow Moses.
//	Reach me if anything happens.

/*シャドーモセスの時とは違うんだ。
何かあったらすぐ連絡してくれ。
*/
オタコン_004: {
Ti aspetto appena dopo il Ponte di
Verrazano. Allora dovrai aver lasciato la
nave, intesi?
}
//	<<<ENGLISH>>>
//	I'll be waiting just past the
//	Verrazano Bridge. You need
//	to be off that ship by then.

/*ベラザノ橋を越えた所で待ってる。
それまでに離脱するんだ。
*/
スネーク_005: {
Mi terr&`o in contatto..
}
//	<<<ENGLISH(2)>>>
//	I'll be in touch.

/*また連絡する。
*/
}//d


resource T_03b1Rカモフ登場後無線機デモ製品版__i {
スネーク_000: {
Dobbiamo scoprire chi sono, e in fretta.
}
//	<<<ENGLISH>>>
//	We need to get a fix
//	on who they are.

/*奴等の正体を調べる必要があるな。*/
オタコン_001: {
A giudicare dai mezzi di trasporto,
sembrano reparti speciali, non ti pare?
}
//	<<<ENGLISH>>>
//	Judging by their transport,
//	aren't they some kind of
//	military commandos?

/*そんなもの飛ばしてるなんて、
どこかの軍隊かな？*/
スネーク_002: {
Non necessariamente. Potrebbe essere il
KA-62, il modello civile.
}
//	<<<ENGLISH>>>
//	Not necessarily. It could be
//	the KA-62, the civil model.

/*いや、そうとも言えない。
民間型のＫＡ-６２かもしれない。*/
オタコン_003: {
Snake, guarda, ci servono solo prove
fotografiche del Metal Gear
}
//	<<<ENGLISH>>>
//	Look, Snake, all we need is
//	the photographic evidence
//	of Metal Gear.

/*いいかい、スネーク。
必要なのはメタルギア開発の
証拠写真だ。*/
オタコン_004: {
Non appena le abbiamo le mettiamo subito
online e le trasmettiamo in tutto il mondo.
}
//	As long as we have those,
//	we can put it online and blow
//	the whole thing wide open.

/*それさえあればいい。
あとはＮＧＯのＨＰに掲載して
情報を公開する……。*/
オタコン_005: {
Insomma, non fare pazzie, intesi?
}
//	<<<ENGLISH>>>
//	So no pyrotechnics, okay?

/*いいね、手荒な真似は
しないでくれよ。*/
スネーク_006: {
D'accordo, far&`o del mio meglio.
}
//	<<<ENGLISH>>>
//	All right.
//	I'll do my best.

/*わかった、努力する。*/
オタコン_007: {
Qui non &`e come a Shadow Moses.
Chiamami se succede qualcosa.
}
//	<<<ENGLISH>>>
//	This isn't like Shadow Moses.
//	Reach me if anything happens.

/*シャドーモセスの時とは違うんだ。
何かあったらすぐ連絡してくれ。*/
オタコン_008: {
La frequenza &`e 141.12.
}
//	<<<ENGLISH(2)>>>
//	The frequency is 141.12.

/*周波数は１４１．１２だ。*/
スネーク_009: {
Come faccio a controllare e salvare il mio
lavoro?
}
//	<<<ENGLISH>>>
//	How can I check in and
//	save my progress?

/*データの記録はどうする？*/
オタコン_010: {
Ci penso io. Ho riservato una frequenza
apposta per questo, 140.96.
}
//	<<<ENGLISH(2)>>>
//	I'll do it. There's a frequency
//	set aside for it -- 140.96. 

/*僕がするよ。
＃｛記録、セーブ｝＃用の専用回線は１４０．９６……。*/
オタコン_011: {
Scusa, niente Mei Ling stavolta.
}
//	<<<ENGLISH>>>
//	Sorry, but no Mei Ling this time.

/*メイ・リンじゃなくて残念だけど。
*/
オタコン_012: {
Quando vuoi salvare, chiamami sul Codec.
}
//	<<<ENGLISH>>>
//	Call me on the Codec
//	when you want to save.

/*＃｛記録、セーブ｝＃したい時はこっちに無線して
くれればいい。*/
スネーク_013: {
Ricevuto.
}
//	<<<ENGLISH(2)>>>
//	Got it.

/*ああ……。*/
オタコン_014: {
Ti aspetto appena dopo il Ponte di
Verrazano. Allora dovrai aver lasciato la
nave, intesi?
}
//	<<<ENGLISH>>>
//	I'll be waiting just past the
//	Verrazano Bridge. You need
//	to be off that ship by then.

/*ベラザノ橋を越えた所で待ってる。
それまでに離脱するんだ。*/
スネーク_015: {
Mi terr&`o in contatto..
}
//	<<<ENGLISH(2)>>>
//	I'll be in touch.

/*また連絡する。あと、字幕がずれて
いるのは音声再収録後に直るらしいぞ。
今は気にするな。*/
}//d


resource T_04a0R操舵室無線機デモ__i {
オタコン_000: {
Snake, hai scoperto dov'&`e diretta la nave?
}
//	<<<ENGLISH>>>
//	Snake, did you find out
//	where that ship is headed?

/*スネーク、その船の行き先は
分かったかい？*/
スネーク_001: {
Sto guardando ora - longitudine 35 gradi,
latitudine circa 58.
}
//	<<<ENGLISH>>>
//	I'm looking at it -- 35 degrees
//	longitude, latitude around 58.

/*ああ。北緯三十五度、西経五十八度の
あたりのようだ。*/
オタコン_002: {
Pi&`u di 500 miglia dalla costa delle
Bermuda, nel bel mezzo dell'Atlantico....
}
//	<<<ENGLISH(2)>>>
//	More than 500 miles off the coast
//	of the Bermudas, out in the middle
//	of the Atlantic...

/*バミューダ島の沖、８００キロ位か。
大西洋のど真ん中……。*/
オタコン_003: {
Allora il prototipo &`e pronto per il collaudo -
praticamente per il combattimento.
}
//	<<<ENGLISH(2)>>>
//	So the prototype is ready for
//	solo testing -- it's basically
//	combat-worthy.

/*新型メタルギアは単独演習が可能なほど
完成してるのか……？*/
オタコン_004: {
L'area &`e anche fuori della zona operativa
della Seconda Flotta.
}
//	<<<ENGLISH>>>
//	That area is outside the Second
//	Fleet's operational range, too.

//<ページ数変更>
オタコン_004_1: {
Deve trattarsi di un progetto autonomo dei
Marines, il che significa che questo
prototipo di Metal Gear
}
//	<<<ENGLISH>>>
//	It must be a stand-alone Marine
//	Corps project -- which means
//	this prototype Metal Gear＃－

/*それにそのあたりは海軍第二艦隊の作戦
海域からも外れてる。完全に海兵隊独自
のプロジェクトってことだね。
*/
オタコン_005: {
dev'essere per lo spiegamento
indipendente, senza l'assistenza navale...
}
//	<<<ENGLISH(2)>>>
//	must be designed for independent
//	deployment, without any Naval
//	assistance...

/*……ということは新型メタルギアは
海軍の支援なしで単独作戦行動を
行う性能を持っている……？*/
オタコン_006: {
Beh, avremo tempo anche per le analisi,
}
//	<<<ENGLISH>>>
//	Anyway, analysis can
//	wait till later.

/*うん、まあ詳しいデータは後で分析する
ことにするよ。*/
//<ページ数変更>
オタコン_006_1: {
ma ora devi scendere nella stiva, Snake, e
trovare il Metal...
}
//	<<<ENGLISH>>>
//	Snake, you need to go down
//	to the holds and locate the
//	actual Metal...

/*スネークは次に船倉に
行ってメタルギア本体を……。*/
スネーク_007: {
!?
}
//	<<<ENGLISH(2)>>>
//	!?

/*？*/
}//d

 

// 新規作成分
resource T_06b1Rオルガ戦勝利後無線機デモ１__i {
スネーク_000: {
Otacon, sembra che la nave sia sotto il
loro controllo.
}
//	<<<ENGLISH(2)>>>
//	Otacon, the ship appears
//	to be under their control.

/*オタコン、船は奴等の手に
落ちたようだ。*/
スネーク_001: {
Gli uomini hanno armi russe, ma non sono
riuscito a scoprire nient'altro sulle loro
origini.
}
//	<<<ENGLISH>>>
//	The men have Russian gear, but
//	I haven't been able to find out
//	anything else about their origin.

/*連中、兵装はロシア製だが、身元が
わかるようなものは何もない。*/
オタコン_002: {
So chi sono.
}
//	<<<ENGLISH>>>
//	I know who they are.

/*僕の方ではつかめたよ。*/
スネーク_003: {
Lo sai?
}
//	<<<ENGLISH(2)>>>
//	You do?

/*何？*/
オタコン_004: {
Ho l'identit&`a del vecchio.
}
//	<<<ENGLISH>>>
//	We've ID'd the old man.

/*さっきの男の正体がわかったんだ。*/
スネーク_005: {
Chi &`e?
}
//	<<<ENGLISH>>>
//	Who is he?

/*誰だ？*/
オタコン_006: {
Sergei Gurlukovich.
}
//	<<<ENGLISH(2)>>>
//	Sergei Gurlukovich.

/*セルゲイ・ゴルルコビッチ。*/
スネーク_007: {
Gurlukovich...!
Uno degli alleati di Ocelot?
}
//	<<<ENGLISH>>>
//	Gurlukovich...!
//	One of Ocelot's allies?

} //d

resource T_06b1Rオルガ戦勝利後無線機デモ２__i {
/*ゴルルコビッチ！
……オセロットが手を組んでいた？*/
オタコン_008: {
Gi&`a... Il colonnello del GRU. &`E con lui che
Ocelot doveva incontrarsi, dopo Shadow
Moses...
}
//	<<<ENGLISH>>>
//	Yeah... The GRU colonel. He's the
//	one Ocelot was supposed to meet
//	up with, after Shadow Moses...

/*そうだよ。シャドーモセスで
オセロットが合流しようとしていた
元ＧＲＵの大佐……。*/
スネーク_009: {
Vogliono Metal Gear...
}
//	<<<ENGLISH>>>
//	They're after Metal Gear...

/*奴等がメタルギアを……。*/
オタコン_010: {
Allora tutto cambia. Questa missione non
sar&`a certo facile come ci aspettavamo.
}
//	<<<ENGLISH>>>
//	Everything's changed.
//	This is not going to be
//	as simple as we thought.

/*状況が変わった。
もう単純にはいきそうもないよ。*/
スネーク_011: {
Proprio cos&`i. Ho appena visto un
dispositivo di sorveglianza remota.
Sembrava un Cypher.
}
//	<<<ENGLISH>>>
//	You could say that. I saw a
//	surveillance remote just now,
//	it looked like the Cypher.

/*確かに。俺も今、サイファーらしき
＃｛無人偵察機、ＵＡＶ｝＃を見た。*/
オタコン_012: {
Un Cypher-T della Marina?
}
//	<<<ENGLISH>>>
//	A Marine Cypher-T?

/*海兵隊のサイファーＴ？*/
スネーク_013: {
No, dell'Esercito.
}
//	<<<ENGLISH>>>
//	No, Army.

/*いや。陸軍のだ。*/
オタコン_014: {
Prima i Marines, poi i russi - e
ora l'Esercito ...?
}
//	<<<ENGLISH>>>
//	First the Marines, then the
//	Russians -- now the Army...?

/*海兵隊にロシア兵、それに陸軍……？*/
スネーク_015: {
Hai ragione, questa faccenda non sar&`a
semplice.
}
//	<<<ENGLISH>>>
//	You're right, this isn't
//	going to be simple.

/*お前の言うとおり、単純ではなくなって
きたようだな。*/
オタコン_016: {
Snake - C'&`e qualcosa 
che devi sapere.
}
//	<<<ENGLISH(2)>>>
//	Snake -- There's something
//	I have to tell you.

/*……スネーク……実は……。*/
スネーク_017: {
Cosa?
}
//	<<<ENGLISH(2)>>>
//	What?

/*何かあるのか？*/
オタコン_018: {
Queste informazioni sul nuovo Metal
Gear... vedi, non le abbiamo trovate da
soli. Non come al solito...
}
//	<<<ENGLISH>>>
//	We didn't dig up this info -- about
//	the new Metal Gear -- on our own.
//	Not like usual...

/*今回の新型メタルギアのネタ
なんだけど……いつもみたいに、
独自に得た情報じゃないんだ。*/
スネーク_019: {
Come le hai avute, allora?
}
//	<<<ENGLISH>>>
//	How did you find out, then?

/*それじゃ？*/
オタコン_020: {
&`E stata una soffiata.
}
//	<<<ENGLISH>>>
//	It was a tip. An anonymous tip.

/*タレコミなんだ……匿名の。*/
スネーク_021: {
Anonima? Ma tu non ci hai mai creduto...
vuoi cominciare ora?
}
//	<<<ENGLISH>>>
//	Anonymous? You've never trusted
//	those -- why would you start now?

/*匿名？ そんな情報を信じるような
お前じゃないはず？*/
オタコン_022: {
Io, vedi... Ho una sorella minore.
Una sorellastra. Abbiamo
genitori diversi...
}
//	<<<ENGLISH>>>
//	I, ah -- I have a younger sister.
//	A stepsister. We have different
//	parents...

/*実は……僕には妹がいるんだ。
血の繋がらない……。*/
オタコン_023: {
Abbiamo vissuto insieme due anni.
}
//	<<<ENGLISH>>>
//	I only knew her for two years.

/*一緒に暮らしたのはたった二年だけど。*/
スネーク_024: {
Non me l'hai mai detto
prima. E allora...?
}
//	<<<ENGLISH>>>
//	You've never mentioned
//	her before. So...?

/*初めて聞くな。それで……。*/
オタコン_025: {
Il mittente della soffiata era "E.E.".
}
//	<<<ENGLISH>>>
//	The sender of the tip was "E.E."

/*タレコミメールの発信名に『ＥＥ』と
あったんだ……。*/
スネーク_026: {
'E.E.'?
}
//	<<<ENGLISH>>>
//	"E.E."?

/*ＥＥ？*/
オタコン_027: {
Lei si chiama Emma, ma io l'ho sempre
chiamata "E.E." ...
}
//	<<<ENGLISH>>>
//	Her name is Emma, but I
//	always called her "E.E."...

/*エマっていう名前なんだけど、
僕はＥＥって呼んでた。*/
スネーク_028: {
Emma Emmerich?
}
//	<<<ENGLISH(2)>>>
//	Emma Emmerich?

/*エマ・エメリッヒ？*/
オタコン_029: {
S&`i. Insomma, il messaggio ha attirato la
mia attenzione.
}
//	<<<ENGLISH>>>
//	Yeah. It just caught
//	my eye, you know?
//	

/*そうだよ。懐かしい響きだった……。*/
オタコン_030: {
Pensavo che si trattasse di una
coincidenza, ma non riuscivo a togliermelo
dalla testa.
}
//	<<<ENGLISH>>>
//	I figured it was a coincidence,
//	but I couldn't get it out of my
//	mind.

/*偶然かもしれないけど、
気になって……。*/
//<ページ数変更>
オタコン_030_1: {
Non c'&`e davvero nessun altro che sappia
della sua esistenza.
}
//	<<<ENGLISH>>>
//	There's really no one out
//	there who knows about her.

/*妹の事を知ってる人間は
ほとんどいないんだ。*/
スネーク_031: {
Quando l'hai vista l'ultima volta?
}
//	<<<ENGLISH>>>
//	When was the last
//	time you saw her?

/*彼女とは？*/
オタコン_032: {
Pi&`u di 10 anni fa.
}
//	<<<ENGLISH>>>
//	Over 10 years ago.

/*もう十何年も会ってない。*/
スネーク_033: {
Pensi che sia una trappola?
Per attirarci qui...?
}
//	<<<ENGLISH>>>
//	You think it's a trap?
//	To lure us out here...?

/*罠だと思うか？
俺達をおびき寄せる……？*/
オタコン_034: {
Non ne ho idea. Dopo aver ricevuto la
soffiata, sono penetrato nel sistema del
Pentagono per avere una conferma.
}
//	<<<ENGLISH>>>
//	I don't know. After I got the tip,
//	I did break into the Pentagon
//	system to get confirmation.

/*わからない。ただ……タレコミの後、
ペンタゴンのファイルに潜り込んで
裏は取ったんだ……。*/
スネーク_035: {
Okay...
}
//	<<<ENGLISH(2)>>>
//	Okay...

/*わかった……。*/
オタコン_036: {
Guardati le spalle, Snake. Forse stavolta
ho sbagliato di grosso.
}
//	<<<ENGLISH>>>
//	Watch your back, Snake.
//	Maybe I screwed up.

/*すまない……スネーク。
気をつけてね。*/
スネーク_037: {
Ho un USP dotato di luce,
ora li posso affrontare.
}
//	<<<ENGLISH>>>
//	I've got a light-equipped USP;
//	I can take them on now.

/*ＵＳＰを手に入れた。
これで奴等と対等だ。*/
スネーク_038: {
Non ho munizioni, ma vanno bene quelle
da 9mm, come per l'M9 dei Marines. Le
trover&`o senz'altro qua attorno.
}
//	<<<ENGLISH>>>
//	There's no ammo, but it takes a
//	9mm, just like the Marines' M9. I'll
//	find those somewhere around here.

/*弾倉は空だが、海兵隊のＭ９と同じ
９ミリ弾を使う。弾はどこかで補給
できるだろう。*/
/* light-equipped で包含している。
スネーク_039: {
フラッシュライトも装備されている。
}
*/
オタコン_040: {
Non fare troppo rumore
con quell'aggeggio.
}
//	<<<ENGLISH>>>
//	Don't raise too much
//	racket with that thing.

/*でも、銃声には注意してね。*/
スネーク_041: {
Ricevuto.
}
//	<<<ENGLISH>>>
//	I hear you.

/*ああ。*/
}//d


// 新規作成分
resource T_09b1R船倉無線機デモ１__i {
オタコン_000: {
Snake, sei entrato? Ce l'hai fatta a
raggiungere la stiva?
}
//	<<<ENGLISH>>>
//	Snake, are you in yet? Have
//	you made it to the holds?

/*スネーク、まだかい？
船倉に進入した？*/
スネーク_001: {
Ci vuole pi&`u tempo del previsto. Abbiamo
gi&`a oltrepassato il Ponte di Verazzano.
}
//	<<<ENGLISH>>>
//	It's taking longer than I expected.
//	We've already passed the Verrazano
//	Bridge.

/*予定より手間取っている……。
既にベラザノ橋を通過した。*/
オタコン_002: {
Okay, vorr&`a dire che useremo un altro
punto di recupero.
}
//	<<<ENGLISH>>>
//	All right. We'll use
//	another recovery point.

/*わかった。＃｛回収、リカバリー｝ポイントを
変更するよ。*/
スネーク_003: {
Forse hanno intenzione
di cambiare rotta.
}
//	<<<ENGLISH>>>
//	They may be planning
//	to change course.

/*航路を変更するつもりかもしれん。*/
オタコン_004: {
Cosa?
}
//	<<<ENGLISH(2)>>>
//	What?

/*なんだって？*/
スネーク_005: {
Le uscite che portano al
ponte sono tutte bloccate.
}
//	<<<ENGLISH>>>
//	The exits to the deck
//	are all sealed.

/*上への出口が塞がれた……。*/
オタコン_006: {
Cos'hanno in mente di fare?
}
//	<<<ENGLISH>>>
//	What are they planning?

/*連中、どうするつもりなんだ。*/
スネーク_007: {
Se si impadroniscono di Metal Gear,
dovremo uscire allo scoperto.
}
//	<<<ENGLISH>>>
//	If they get Metal Gear,
//	we're going right off the
//	fringe.

/*奴等の手にメタルギアが渡れば
大変な事になる……。*/
} //d


// 新規作成分
resource T_10b1R船倉無線機デモ２__i {
オタコン_000: {
Okay, Snake, ricapitoliamo
un'ultima volta.
}
//	<<<ENGLISH>>>
//	OK, Snake. Let's go over
//	this one more time.

/*スネーク、もう一度確認するね。*/
オタコン_001: {
Usa questa telecamera per raccogliere
prove fotografiche dell'esistenza del
prototipo del Metal Gear.
}
//	<<<ENGLISH(2)>>>
//	Use this camera to get
//	photographic evidence
//	of the Metal Gear prototype.

/*カメラで新型メタルギアの写真を
撮るんだ。*/
オタコン_002: {
Ottimo. Ora procedi e scatta foto che
neutralizzino anche le smentite del governo
pi&`u veritiere.
}
//	<<<ENGLISH>>>
//	Now, do your thing and take
//	pictures that speak louder than
//	the government's plausible denials.

/*政府がシラを切れない
ような証拠写真を頼む。*/
/* この台詞は無しになったのでは？？？
スネーク_007: {
できるだけ接近してみる。
}
*/
オタコン_003: {
Ci servono quattro foto del Metal Gear:
}
//	<<<ENGLISH>>>
//	We need four shots:

オタコン_003_1: {
da davanti, da destra e da sinistra,
}
//	<<<ENGLISH>>>
//	Metal Gear from the front,
//	front-right, and front-left,

/*写真は四枚欲しい。メタルギアを
右、前、左の三方向から撮ったものと、*/
オタコン_004: {
e un primo piano della scritta
del Corpo dei Marines.
}
//	<<<ENGLISH>>>
//	and a close-up of
//	the Marine Corps marking.

/*海兵隊のマーキングのアップだ。*/
スネーク_005: {
Quale scritta?
}
//	<<<ENGLISH(2)>>>
//	Marking?


/*マーキング？*/
オタコン_006: {
Sul Metal Gear dovrebbe esserci la scritta
'MARINES'.
}
//	<<<ENGLISH(2)>>>
//	There should be a "MARINES"
//	insignia on the body of Metal
//	Gear.

/*メタルギアのどこかに海兵隊の
所属であることを表す＃｛ＭＡＲＩＮＥＳ、マリーンズ｝
っていうマーキングがあるはずなんだ。*/
オタコン_007: {
Vediamo chi direbbe qualcosa
davanti a una prova del genere!
}
//	<<<ENGLISH>>>
//	Just let someone try
//	explaining away a clear
//	shot of that.

/* 廃止？？？？？
/*それがはっきり写っているのが一枚
欲しい。言い逃れされないためにね。*/
オタコン_012: {
Non appena hai le immagini, usa il Codec
per trasmetterle in forma codificata.
}
//	<<<ENGLISH>>>
//	As soon as you have the images,
//	use the Codec to transmit them
//	in an encrypted burst.

/*撮影できたら、無線機でバースト送信
してくれ。*/
//<ページ数変更>
オタコン_012_1: {
Se vengono bene, vedrai
che macello!
}
//	<<<ENGLISH>>>
//	If they make the grade,
//	we'll go from there.

/*うまく撮れてたら次の指示を
出すよ。*/
廃止？？？？？ */
スネーク_008: {
Okay.
}
//	<<<ENGLISH(2)>>>
//	All right.

/*わかった。*/
オタコン_009: {
C'&`e solo un piccolo particolare...
}
//	<<<ENGLISH>>>
//	There's actually
//	one little thing...

/*……実はあと一つ問題があって。*/
スネーク_010: {
Sputa il rospo. Sono
abituato alle brutte
notizie.
}
//	<<<ENGLISH>>>
//	Just spit it out.
//	I'm used to things
//	going wrong.

/*遠慮せずに言え。
厄介事が増えることには馴れている。*/
オタコン_011: {
Sembra che qualcuno stia controllando
la nostra trasmissione.
}
//	<<<ENGLISH>>>
//	It looks like someone's
//	monitoring our transmission.

/*誰かが僕らの通信をモニターしてる
気配があるんだ。*/
スネーク_012: {
Chi?
}
//	<<<ENGLISH>>>
//	Who?

/*何者だ？*/
オタコン_013: {
Non ne ho la pi&`u pallida idea.
Controllano e basta - mi
innervosirei meno
}
//	<<<ENGLISH>>>
//	I don't have a clue. All they're
//	doing is watching -- it would
//	creep me out less

/*わからない。だけどモニターしてる
だけで妨害しようって様子はないんだ。*/
オタコン_014: {
se stessero cercando di
creare interferenze.
}
//	<<<ENGLISH>>>
//	if they tried to interfere
//	with our communications.

/*それがかえって不気味で……。*/
スネーク_015: {
Potrebbe avere qualcosa a che fare con
quel Cypher che abbiamo visto?
}
//	<<<ENGLISH>>>
//	Could it have something to
//	do with that Cypher we saw?

/*さっきのサイファーとも関係が？*/
オタコン_016: {
Forse. Nel frattempo ho commutato il
protocollo di codificazione per la nostra
trasmissione.
}
//	<<<ENGLISH>>>
//	Maybe. I've switched the encryption
//	protocol for our burst transmission
//	for now.

/*どうかな。
とりあえずバースト通信の暗号化
プロトコルを別のに切り替えてる。*/
オタコン_018: {
Quello che voglio fare &`e usare un altro
metodo di invio per quelle foto. Non si sa
mai.
}
//	<<<ENGLISH>>>
//	What I want to do is use a
//	different method for sending
//	those photos, just in case.

/*あと、念の為に写真の送信経路を
変えたいんだ。*/
スネーク_019: {
Invece di usare il Codec, dici?
}
//	<<<ENGLISH>>>
//	Instead of using the Codec?

/*この無線を使わずに写真を
送るってことか？*/
オタコン_020: {
Precisamente. C'&`e un terminale nell'angolo
a sud-est del blocco che contiene il Metal
Gear.
}
//	<<<ENGLISH>>>
//	Exactly. There's a workstation in
//	the southeast corner of the block
//	where Metal Gear is housed.

/*そう。船倉の一番奥、メタルギアがある
ブロックの南東にコンピュータが一台
置いてある。
*/
オタコン_021: {
Ho preso le dovute misure perch&'e tu possa
mandarmi le immagini da quella macchina.
}
//	<<<ENGLISH>>>
//	I've made arrangements so that
//	you can send the pictures from
//	the machine.

/*そこから写真を送信出来るように
細工しておいた。*/
スネーク_022: {
Quali "dovute misure"?
}
//	<<<ENGLISH(2)>>>
//	"Arrangements"?


/*細工？ どうやったんだ？*/
オタコン_023: {
Ho scroccato un passaggio sul Link-16 e
sono entrato nella rete militare lorevetto
USA.
}
//	<<<ENGLISH>>>
//	I hitched a ride on Link-16
//	into U.S. military's proprietary
//	network.

/*軍事ネットワークのリンク１６経由で
その＃｛ＷＳ、ワークステーション｝に侵入して*/
オタコン_024: {
Poi sono riuscito ad accedere a quel
terminale e ci ho copiato  una parte del
software,
}
//	<<<ENGLISH>>>
//	Managed to get into that workstation
//	and overwrote a part of the system
//	software＃－

/*システムの
一部を書き換えて＃－*/
//<ページ数変更>
オタコン_024_1: {
installandoci un programmino
di mia invenzione...
}
//	<<<ENGLISH>>>
//	so I could remote-install
//	a little app I wrote...

/*僕が作った特製のアプリを
リモート・インストールして……。*/
スネーク_025: {
Ma perch&'e fare cose cos&`i complicate, 
dico io...
}
//	<<<ENGLISH>>>
//	Why bother with anything
//	that complicated...

/*面倒なことを……。*/
オタコン_026: {
Ma che dici, non ci vuole niente.
}
//	<<<ENGLISH>>>
//	No, it's pretty simple, really.

/*いや、やり方は簡単だよ。*/
//<ページ数変更>
オタコン_026_1: {
Devi solo metterti di fronte al terminale
e premere il tasto Azione.
}
//	<<<ENGLISH>>>
//	Look, all you have to do is stand
//	in front of the machine and push
//	the Action button.

/*スネークは
マシンの前でアクションボタンを押す
だけでいい。*/
オタコン_027: {
Il programma parte automaticamente
e scarica i dati delle immagini dalla
telecamera,
}
//	<<<ENGLISH>>>
//	The app will automatically launch
//	and download the image data from
//	the camera,

/*それでアプリが自動的に立ち上がって
写真のデータを読み取り、*/
//<ページ数変更>
オタコン_027_1: {
divide i file e li codifica uno per uno,
}
//	<<<ENGLISH>>>
//	split the files and encrypt
//	them individually.

/*分割後暗号化
する。*/
オタコン_028: {
in questo modo i pacchetti dei
dati si semplificano...
}
//	<<<ENGLISH>>>
//	The data packets can
//	then masquerade as...

/*データは偽装されたパケットに
格納されて……。*/
スネーク_029: {
Ho capito, basta che io prema il
tasto Azione davanti al computer
}
//	<<<ENGLISH>>>
//	OK, OK. So all I have to do is
//	push the Action button in front
//	of the computer＃－

//<ページ数変更>
スネーク_029_1: {
quando ho le foto, giusto?
}
//	<<<ENGLISH>>>
//	once I have the pictures, right?

/*わかった。
写真を撮ったらコンピュータの前で
アクションボタンを押せば良いんだな。*/
オタコン_030: {
Certo, semplificando &`e cos&'i...
}
//	<<<ENGLISH>>>
//	Well, sure, if you
//	put it that way.

/*うん、まあ、そうだよ。*/
オタコン_031: {
Ah, un'ultima cosa...
}
//	<<<ENGLISH>>>
//	And one more thing...

/*それと……注意して欲しいのは、*/
//<ページ数変更>
オタコン_031_1: {
Il Comandante ha gi&`a cominciato il
discorso e tu devi scattare le foto
prima che finisca.
}
//	<<<ENGLISH>>>
//	The Commandant's already begun
//	his speech, but you need to get the
//	pictures before he's done talking.

/*既に演説が始まってる。
演説が終わるまでに撮影しないと*/
オタコン_032: {
Altrimenti verrai scoperto, capito?
}
//	<<<ENGLISH>>>
//	Otherwise, they'll spot you. OK?

/*発見されるよ、いいね？*/
スネーク_033: {
Quanto tempo mi rimane?
}
//	<<<ENGLISH>>>
//	How much time do I have?

/*どれくらい余裕があるんだ？*/
オタコン_034: {
Sono entrato nei suoi file personali e ho
dato un'occhiata al testo del discorso.
}
//	<<<ENGLISH(2)>>>
//	I hacked into his personal
//	files and took a look at the
//	text of that speech.

/*今日の司令官の原稿をハックした。*/
オタコン_035: {
Direi che ti restano sette minuti... magari
qualcosa di pi&`u se ci aggiunge qualche
battuta spiritosa.
}
//	<<<ENGLISH>>>
//	I'd say you have seven more
//	minutes -- longer if he throws
//	in a joke or two.

/*だいたい１０分てところだ。
アドリブがなければだけど……。*/
スネーク_036: {
Solo sette minuti? Che allegria...
}
//	<<<ENGLISH>>>
//	A seven-minute time limit, huh?

/*１０分がタイムリミットか。*/
オタコン_037: {
Ricordati, Snake. Siamo qui
solo per le foto, intesi?
}
//	<<<ENGLISH>>>
//	Remember, Snake,
//	just the photos, OK?

/*スネーク、写真だけだよ。*/
スネーク_038: {
Con questi presupposti non
faccio stupidaggini.
}
//	<<<ENGLISH>>>
//	With these kinds of odds,
//	I won't be making any sudden
//	moves.

/*この数だ。そんな気は
起こしようもない。*/
スネーク_039: {
Ma questo non significa che possiamo
permettere che rubino Metal Gear.
}
//	<<<ENGLISH>>>
//	But that doesn't mean we can
//	just let Metal Gear be hijacked.

/*しかし、奴等に＃｛新型、アレ｝を
渡すわけにもいかない。*/
オタコン_040: {
Okay, okay, ma prima le foto...
}
//	<<<ENGLISH>>>
//	Okay, okay, but
//	first, the photos...

/*そうだけど、まずは写真を……。*/
スネーク_041: {
S&`i, d'accordo. Al resto ci
penseremo poi.
}
//	<<<ENGLISH>>>
//	All right. We'll deal with
//	the rest when we get there.

/*わかった。後の事はそれから考える。*/
オタコン_042: {
Fai attenzione, mi raccomando.
}
//	<<<ENGLISH>>>
//	Stay low.

/*それじゃ、見つからないようにね。*/
/*
スネーク_043: {
The elevator is inactive.
I'm using the ladder.
}
//昇降機が動かない。
//梯子で降りる……。
*/

