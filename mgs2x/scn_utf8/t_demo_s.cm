/* -------------------------------

強制無線機デモ用にゃろーんむきゃ。
$Id: t_demo_s.cm,v 1.7 2001/11/17 08:14:36 usr01098 Exp $

---------------------------------*/
resource T_00b1Rオープニング無線機デモ__s {
スネーク_000: {
Aqu&'i Snake. &~?Me recibes, Otacon?
}
//	<<<ENGLISH>>>
//	This is Snake.
//	Do you read me, Otacon?

/*
こちらスネーク、
聞こえるか、オタコン？
*/
オタコン_001: {
Alto y claro, Snake.
}
//	<<<ENGLISH>>>
//	Loud and clear, Snake.

/*ああ僕だよ、スネーク。
聞こえる……。*/
スネーク_002: {
&~?Te he hecho esperar, eh?
Estoy en el punto de infiltraci&'on.
}
//	<<<ENGLISH(2)>>>
//	Kept you waiting, huh?
//	I'm at the "sneak point."

/*……待たせたな。
＃｛潜入、スニーク｝＃ポイントに到着……。*/
オタコン_003: {
&~?Todo bien?
}
//	<<<ENGLISH>>>
//	Everything going okay?

/*うまくいったかい？
*/
スネーク_004: {
El de sistema camuflaje se ha hecho
polvo, con el impacto del aterrizaje.
}
//	<<<ENGLISH>>>
//	The stealth camo's busted.
//	Landing impact.

/*着地の衝撃でステルス迷彩が壊れた。*/
オタコン_005: {
Quiz&'as lo hemos uttilizado de masiado.
Lo siento, pero tendr&'as que resolverlo
t&'u mismo.
}
//	<<<ENGLISH(2)>>>
//	We must have overused it.
//	Sorry, but you're gonna
//	have to deal with it.

/*随分こき使ってきたからね……。
悪いけど我慢してくれ。
*/
//<ページ数変更>
オタコン_005_1: {
Ya no est&'as en el ej&'ercito.
}
//	<<<ENGLISH>>>
//	You're not in the
//	military anymore.

/*
軍じゃないんだ。
*/
スネーク_006: {
Bien. Pues, no ten&'ia ninguna intenci&'on
de confiar en este aparato. 
}
//	<<<ENGLISH>>>
//	Right. I didn't plan on relying
//	on this gadget anyway.

/*ああ。いつまでも＃｛ステルス迷彩、こんなもの｝＃に
頼るつもりはない。*/
オタコン_007: {
El sector privado no es tan malo,
&~?verdad? Privacidad garantizada...
}
//	<<<ENGLISH>>>
//	The private sector's not so bad,
//	is it? Privacy guaranteed...

/*だけど民間のいいところもあるだろ？
プライバシーは守られてるし……。*/
スネーク_008: {
No me importa, siempre y cuando no me
den m&'as regalitos no deseados.
}
//	<<<ENGLISH>>>
//	I'm happy as long as no one
//	gives me any more unwanted
//	gifts.

/*変な薬も盛られずに済むしな。*/
オタコン_009: {
&~?Te refieres a esa cosa con Naomi?
}
//	<<<ENGLISH>>>
//	You mean that thing with Naomi?

/*ナオミの事……？*/
スネーク_010: {
Y no puedo decir que extra&~ne a la ni&~nera
parlanchina.
}
//	<<<ENGLISH>>>
//	And I can't say I miss
//	the chattering nanny.

/*うるさい見張り役がいないのも気が楽だ。*/
オタコン_011: {
Mei Ling no est&'a tan mala. Y hablando de
Mei Ling, tengo que ponerme en contacto
}
//	<<<ENGLISH>>>
//	Mei Ling's not so bad. That
//	reminds me, I have to get in
//	touch with her again

/*メイ・リンか……。
また彼女に頼んでおくよ。*/
//<ページ数変更>
オタコン_011_1: {
con ella sobre ese nuevo flashware Natik.
}
//	<<<ENGLISH>>>
//	about that new Natik flashware.

/*
＃｛ＮＡＴＩＣＫ、ナティック｝＃の新兵器。
*/
スネーク_012: {
&~?Desviando juguetes del SSCEN (Centro
de Sistemas de Soldados del Ej&'ercito de
los Estados Unidos)? otra vez?
Env&'iale un mensaje m&'io:
}
//	<<<ENGLISH>>>
//	Diverting toys from the SSCEN (U.S.
//	Army Soldier Systems Center) again?
//	Give her a message from me:

/*＃｛陸軍兵士システムセンター、ＮＡＴＩＣＫ｝＃からの
横流しか。彼女に伝えておいてくれ。*/
スネーク_013: {
tarde o temprano lo van a averiguar.
}
//	<<<ENGLISH>>>
//	someone will find out
//	sooner or later.

/*いずれはバレる。*/
//<ページ数変更>
スネーク_013_1: {
Ser&'a mejor que se detenga antes de que
sea demasiado tarde.
}
//	<<<ENGLISH>>>
//	She's better off assuming
//	it's sooner and quit while
//	she's safe.

/*早いうちに手を引くようにな。*/
オタコン_014: {
&~!Muy cierto! 
Vamos, Snake, &~!a trabajar!
}
//	<<<ENGLISH>>>
//	Too true. Okay, Snake,
//	let's get to work.

/*それもそうだね……。
じゃあスネーク、本題に入るよ。*/
オタコン_015: {
&~?Sabes c&'omo se vendieron los datos
t&'ecnicos de Metal Gear en el mercado
negro despu&'es de Shadow Moses?
}
//	<<<ENGLISH>>>
//	You know how the technical specs of
//	Metal Gear were sold on the black
//	market after Shadow Moses?

/*シャドーモセス事件の後、メタルギアの
技術情報が＃｛闇市場、ブラックマーケット｝＃で密売されたよね。*/
スネーク_016: {
Todo dobido a Ocelot...
}
//	<<<ENGLISH>>>
//	All Ocelot's doing...

/*オセロットの仕業だ。*/
オタコン_017: {
Exactamente. Anora todo estado, grupo y
"punto com" tiene su propio Metal Gear.
}
//	<<<ENGLISH>>>
//	Exactly. And now every state,
//	group and dotcom has its own
//	version of Metal Gear.

/*ああ。それで全世界にメタルギアの
亜種が拡散した。*/
スネーク_018: {
No exactamente un arma secreta para los
poderes nucleares de hoy.
}
//	<<<ENGLISH>>>
//	Not exactly a classified weapon
//	for today's nuclear powers.

/*いまや核武装国にとって、
メタルギアは特別な兵器ではない。*/
オタコン_019: {
Este nuevo modelo es mucho mejor que
cualquier otro.
}
//	<<<ENGLISH>>>
//	This new one seems to have been
//	designed to wipe the floor with
//	all the other models.

/*今回の新型はそれらに対抗する為に
設計されたものらしい。*/
//<ページ数変更>
オタコン_019_1: {
Lo &'unico que se conoce de
&'el es que es un veh&'iculo anfibio, anti-Metal
Gear.
}
//	<<<ENGLISH>>>
//	The only consistent description is
//	that it's an amphibious, anti-Metal
//	Gear vehicle...

/*水陸両用の
対メタルギア兵器……。*/
スネーク_020: {
Esto explica por qu&'e &'este est&'a bajo
jurisdicci&'on del Cuerpo de Marines.
}
//	<<<ENGLISH>>>
//	That explains why this one is
//	under Marine Corps jurisdiction.

/*それで新型は海兵隊の所属って訳か……？*/

}

resource T_03b1Rカモフ登場後無線機デモ体験版__s {
スネーク_000: {
Necesitamos descubrir su identidad.
}
//	<<<ENGLISH>>>
//	We need to get a fix
//	on who they are.

/*奴等の正体を調べる必要があるな。
*/
オタコン_001: {
A juzgar por su transporte, &~?no crees que
son alg&'un tipo de comando militar?
}
//	<<<ENGLISH>>>
//	Judging by their transport,
//	aren't they some kind of
//	military commandos?

/*そんなもの飛ばしてるなんて、
どこかの軍隊かな？
*/
スネーク_002: {
No necesariamente. Podr&'ia ser el KA-62,
el modelo civil.
}
//	<<<ENGLISH>>>
//	Not necessarily. It could be
//	the KA-62, the civil model.

/*いや、そうとも言えない。
民間型のＫＡ-６２かもしれない。
*/
オタコン_003: {
Esto no es como Shadow Moses. Ll&'amame
si pasa algo.
}
//	<<<ENGLISH>>>
//	This isn't like Shadow Moses.
//	Reach me if anything happens.

/*シャドーモセスの時とは違うんだ。
何かあったらすぐ連絡してくれ。
*/
オタコン_004: {
Te esperav&'e justo tras el Puente
Verrazano. Para entonces, tendr&'as que
estar fuera del barco.
}
//	<<<ENGLISH>>>
//	I'll be waiting just past the
//	Verrazano Bridge. You need
//	to be off that ship by then.

/*ベラザノ橋を越えた所で待ってる。
それまでに離脱するんだ。
*/
スネーク_005: {
Estar&'e en contacto.
}
//	<<<ENGLISH(2)>>>
//	I'll be in touch.

/*また連絡する。
*/
}

resource T_03b1Rカモフ登場後無線機デモ製品版__s {
スネーク_000: {
Necesitamos descubrir su identidad.
}
//	<<<ENGLISH>>>
//	We need to get a fix
//	on who they are.

/*奴等の正体を調べる必要があるな。*/
オタコン_001: {
A juzgar por su transporte, &~?no crees que
son alg&'un tipo de comando militar?
}
//	<<<ENGLISH>>>
//	Judging by their transport,
//	aren't they some kind of
//	military commandos?

/*そんなもの飛ばしてるなんて、
どこかの軍隊かな？*/
スネーク_002: {
No necesariamente. Podr&'ia ser el KA-62,
el modelo civil.
}
//	<<<ENGLISH>>>
//	Not necessarily. It could be
//	the KA-62, the civil model.

/*いや、そうとも言えない。
民間型のＫＡ-６２かもしれない。*/
オタコン_003: {
Mira Snake, lo &'unico que necesitamos es
la prueba fotogr&'afica de Metal Gear.
}
//	<<<ENGLISH(2)>>>
//	Look, Snake, all we need is
//	the photographic evidence
//	of Metal Gear.

/*いいかい、スネーク。
必要なのはメタルギア開発の
証拠写真だ。*/
オタコン_004: {
Cuando la tengamos, la podremos
en la red y se har&'a mundialmente
p&'ublicas en cuesti&'on de segundos.
}
//	<<<ENGLISH>>>
//	As long as we have those,
//	we can put it online and blow
//	the whole thing wide open.

/*それさえあればいい。
あとはＮＧＯのＨＰに掲載して
情報を公開する……。*/
オタコン_005: {
As&'i que nada de pirot&'ecnicos,
&~?entendido?
}
//	<<<ENGLISH(2)>>>
//	So no pyrotechnics, okay?

/*いいね、手荒な真似は
しないでくれよ。*/
スネーク_006: {
De acuerdo. Har&'e lo que pueda.
}
//	<<<ENGLISH>>>
//	All right.
//	I'll do my best.

/*わかった、努力する。*/
オタコン_007: {
Esto no es como Shadow Moses. Ll&'amame
si pasa algo.
}
//	<<<ENGLISH>>>
//	This isn't like Shadow Moses.
//	Reach me if anything happens.

/*シャドーモセスの時とは違うんだ。
何かあったらすぐ連絡してくれ。*/
オタコン_008: {
Mi frecuencia es 141.12.
}
//	<<<ENGLISH(2)>>>
//	The frequency is 141.12.

/*周波数は１４１．１２だ。*/
スネーク_009: {
&~?C&'omo puedo entrar y guardar mi
avance?
}
//	<<<ENGLISH>>>
//	How can I check in and
//	save my progress?

/*データの記録はどうする？*/
オタコン_010: {
Yo lo har&'e. Hay una frecuencia reservada
para ello... 140.96.
}
//	<<<ENGLISH(2)>>>
//	I'll do it. There's a frequency
//	set aside for it -- 140.96.

/*僕がするよ。
＃｛記録、セーブ｝＃用の専用回線は１４０．９６……。*/
オタコン_011: {
Esta vez no es a trav&'es de Mei Ling.
}
//	<<<ENGLISH>>>
//	Sorry, but no Mei Ling this time.

/*メイ・リンじゃなくて残念だけど。
*/
オタコン_012: {
Si quieres guardar tu avance, ll&'amame por
el Codec.
}
//	<<<ENGLISH>>>
//	Call me on the Codec
//	when you want to save.

/*＃｛記録、セーブ｝＃したい時はこっちに無線して
くれればいい。*/
スネーク_013: {
Entendido.
}
//	<<<ENGLISH(2)>>>
//	Got it.

/*ああ……。*/
オタコン_014: {
Te esperav&'e justo tras el Puente
Verrazano. Para entonces, tendr&'as que
estar fuera del barco.
}
//	<<<ENGLISH>>>
//	I'll be waiting just past the
//	Verrazano Bridge. You need
//	to be off that ship by then.

/*ベラザノ橋を越えた所で待ってる。
それまでに離脱するんだ。*/
スネーク_015: {
Estar&'e en contacto.
}
//	<<<ENGLISH(2)>>>
//	I'll be in touch.

/*また連絡する。あと、字幕がずれて
いるのは音声再収録後に直るらしいぞ。
今は気にするな。*/
}


resource T_04a0R操舵室無線機デモ__s {
オタコン_000: {
Snake, &~?has averiguado hacia d&'onde se
dirige ese barco?
}
//	<<<ENGLISH>>>
//	Snake, did you find out
//	where that ship is headed?

/*スネーク、その船の行き先は
分かったかい？*/
スネーク_001: {
Estoy en ello… longitud 35 grados y latitud
unos 58.
}
//	<<<ENGLISH>>>
//	I'm looking at it -- 35 degrees
//	longitude, latitude around 58.

/*ああ。北緯三十五度、西経五十八度の
あたりのようだ。*/
オタコン_002: {
A m&'as de 500 millas de la costa de las
Bermudas, en medio del Atl&'antico...
}
//	<<<ENGLISH(2)>>>
//	More than 500 miles off the coast
//	of the Bermudas, out in the middle
//	of the Atlantic...

/*バミューダ島の沖、８００キロ位か。
大西洋のど真ん中……。*/
オタコン_003: {
As&'i que el prototipo est&'a listo
para las pruebas en solitario,
basicamente de combate.
}
//	<<<ENGLISH(2)>>>
//	So the prototype is ready for
//	solo testing -- it's basically
//	combat-worthy.

/*新型メタルギアは単独演習が可能なほど
完成してるのか……？*/
オタコン_004: {
Esa zona est&'a fuera del campo operativo
de la Segunda Flota.
}
//	<<<ENGLISH>>>
//	That area is outside the Second
//	Fleet's operational range, too.

//<ページ数変更>
オタコン_004_1: {
Debe ser un de Marines,
significa que este prototipo de Metal Gear
}
//	<<<ENGLISH(2)>>>
//	It must be a stand-alone Marine
//	Corps project -- which means
//	this prototype Metal Gear＃－

/*それにそのあたりは海軍第二艦隊の作戦
海域からも外れてる。完全に海兵隊独自
のプロジェクトってことだね。
*/
オタコン_005: {
debe estar dise&~nado para el despliegue
independiente, sin ning&'un tipo de ayuda
naval...
}
//	<<<ENGLISH(2)>>>
//	must be designed for independent
//	deployment, without any Naval
//	assistance...

/*……ということは新型メタルギアは
海軍の支援なしで単独作戦行動を
行う性能を持っている……？*/
オタコン_006: {
Bueno, el an&'alisis puede esperar
un poco.
}
//	<<<ENGLISH>>>
//	Anyway, analysis can
//	wait till later.

/*うん、まあ詳しいデータは後で分析する
ことにするよ。*/
//<ページ数変更>
オタコン_006_1: {
Snake, has de bajar a las bodegas y
localizar al verdadero Metal.
}
//	<<<ENGLISH>>>
//	Snake, you need to go down
//	to the holds and locate the
//	actual Metal...

/*スネークは次に船倉に
行ってメタルギア本体を……。*/
スネーク_007: {
&~?&~!!?
}
//	<<<ENGLISH(2)>>>
//	!?

/*？*/
}


// 新規作成分
resource T_06b1Rオルガ戦勝利後無線機デモ１__s {
スネーク_000: {
Otacon, parece que el barco est&'a bajo
control.
}
//	<<<ENGLISH(2)>>>
//	Otacon, the ship appears
//	to be under their control.

/*オタコン、船は奴等の手に
落ちたようだ。*/
スネーク_001: {
Los hombres tienen equipo ruso,
pero no he podido averiguar nada sobre su
origen.
}
//	<<<ENGLISH>>>
//	The men have Russian gear, but
//	I haven't been able to find out
//	anything else about their origin.

/*連中、兵装はロシア製だが、身元が
わかるようなものは何もない。*/
オタコン_002: {
Yo s&'e qui&'enes son.
}
//	<<<ENGLISH>>>
//	I know who they are.

/*僕の方ではつかめたよ。*/
スネーク_003: {
&~?Lo sabes?
}
//	<<<ENGLISH(2)>>>
//	You do?

/*何？*/
オタコン_004: {
Hemos identificado al viejo.
}
//	<<<ENGLISH>>>
//	We've ID'd the old man.

/*さっきの男の正体がわかったんだ。*/
スネーク_005: {
&~?Qui&'en es?
}
//	<<<ENGLISH>>>
//	Who is he?

/*誰だ？*/
オタコン_006: {
Sergei Gurlukovich.
}
//	<<<ENGLISH(2)>>>
//	Sergei Gurlukovich.

/*セルゲイ・ゴルルコビッチ。*/
スネーク_007: {
Gurlukovich...
&~?Uno de los aliados de Ocelot?
}
//	<<<ENGLISH>>>
//	Gurlukovich...!
//	One of Ocelot's allies?

}

resource T_06b1Rオルガ戦勝利後無線機デモ２__s {
/*ゴルルコビッチ！
……オセロットが手を組んでいた？*/
オタコン_008: {
S&'i el coronel GRU. Es el hombre que
supuestamente deb&'ia haberse reunido con
Ocelot despu&'es de Shadow Moses...
}
//	<<<ENGLISH>>>
//	Yeah... The GRU colonel. He's the
//	one Ocelot was supposed to meet
//	up with, after Shadow Moses...

/*そうだよ。シャドーモセスで
オセロットが合流しようとしていた
元ＧＲＵの大佐……。*/
スネーク_009: {
Van detr&'as de Metal Gear...
}
//	<<<ENGLISH>>>
//	They're after Metal Gear...

/*奴等がメタルギアを……。*/
オタコン_010: {
Todo ha cambiado. No va a ser tan f&'acil
como hab&'iamos pensado.
}
//	<<<ENGLISH>>>
//	Everything's changed.
//	This is not going to be
//	as simple as we thought.

/*状況が変わった。
もう単純にはいきそうもないよ。*/
スネーク_011: {
Puede que tengas raz&'on. Acabo de ver un
puesto de vigilancia remoto, se parec&'ia al
CYPHER.
}
//	<<<ENGLISH>>>
//	You could say that. I saw a
//	surveillance remote just now,
//	it looked like the Cypher.

/*確かに。俺も今、サイファーらしき
＃｛無人偵察機、ＵＡＶ｝＃を見た。*/
オタコン_012: {
&~?Un CYPHER-T de los Marine?
}
//	<<<ENGLISH>>>
//	A Marine Cypher-T?

/*海兵隊のサイファーＴ？*/
スネーク_013: {
No, del Ej&'ercito.
}
/*いや。陸軍のだ。*/
オタコン_014: {
Primero los Marines, luego los
Rusos... y ahora el Ej&'ercito...
}
//	<<<ENGLISH>>>
//	First the Marines, then the
//	Russians -- now the Army...?

/*海兵隊にロシア兵、それに陸軍……？*/
スネーク_015: {
Tienes raz&'on, esto no va a ser nada f&'acil.
}
//	<<<ENGLISH>>>
//	You're right, this isn't
//	going to be simple.

/*お前の言うとおり、単純ではなくなって
きたようだな。*/
オタコン_016: {
Snake -- Hay algo que tengo que decirte.
}
//	<<<ENGLISH(2)>>>
//	Snake -- There's something
//	I have to tell you.

/*……スネーク……実は……。*/
スネーク_017: {
&~?Qu&'e?
}
//	<<<ENGLISH(2)>>>
//	What?

/*何かあるのか？*/
オタコン_018: {
Esta vez, no solo nosotros descubrimos
la informaci&'on... sobre el nuevo Metal
Gear no es como usual.
}
//	<<<ENGLISH>>>
//	We didn't dig up this info -- about
//	the new Metal Gear -- on our own.
//	Not like usual...

/*今回の新型メタルギアのネタ
なんだけど……いつもみたいに、
独自に得た情報じゃないんだ。*/
スネーク_019: {
Entonces, &~?c&'omo lo averiguasteis?
}
//	<<<ENGLISH>>>
//	How did you find out, then?

/*それじゃ？*/
オタコン_020: {
Una pista. Una pista an&'onima.
}
//	<<<ENGLISH>>>
//	It was a tip. An anonymous tip.

/*タレコミなんだ……匿名の。*/
スネーク_021: {
&~?Un an&'onimo?
Pero nunca has confiado en ese tipo de informaci&'on,
 &~?porqu&'e ahora?
}
/*匿名？ そんな情報を信じるような
お前じゃないはず？*/
オタコン_022: {
Esto... yo tengo una
hermana menor, una hermanastra.
Tenemos padres diferentes...
}
//	<<<ENGLISH>>>
//	I, ah -- I have a younger sister.
//	A stepsister. We have different
//	parents...

/*実は……僕には妹がいるんだ。
血の繋がらない……。*/
オタコン_023: {
S&'olo la conoc&'i durante dos a&~nos.
}
//	<<<ENGLISH>>>
//	I only knew her for two years.

/*一緒に暮らしたのはたった二年だけど。*/
スネーク_024: {
Nunca la hab&'ias mencionado antes. &~?Y...?
}
//	<<<ENGLISH>>>
//	You've never mentioned
//	her before. So...?

/*初めて聞くな。それで……。*/
オタコン_025: {
La pista vino de 'E.E.'.
}
//	<<<ENGLISH>>>
//	The sender of the tip was "E.E."

/*タレコミメールの発信名に『ＥＥ』と
あったんだ……。*/
スネーク_026: {
&~?E.E.?
}


/*ＥＥ？*/
オタコン_027: {
Se llama Emma, pero yo siempre la he
llamado 'E.E.'...
}
//	<<<ENGLISH>>>
//	Her name is Emma, but I
//	always called her "E.E."...

/*エマっていう名前なんだけど、
僕はＥＥって呼んでた。*/
スネーク_028: {
&~?Emma Emmerich?
}
//	<<<ENGLISH(2)>>>
//	Emma Emmerich?

/*エマ・エメリッヒ？*/
オタコン_029: {
S&'i. Me ha llamado la atenci&'on, &~?sabes?
}
//	<<<ENGLISH>>>
//	Yeah. It just caught
//	my eye, you know?
//	

/*そうだよ。懐かしい響きだった……。*/
オタコン_030: {
Pens&'e que era una coincidencia, Y no
pude quit&'armelo de la cabeza.
}
//	<<<ENGLISH>>>
//	I figured it was a coincidence,
//	but I couldn't get it out of my
//	mind.

/*偶然かもしれないけど、
気になって……。*/
//<ページ数変更>
オタコン_030_1: {
Adem&'as, no hay nadie que sepa de su existencia.
}
//	<<<ENGLISH>>>
//	There's really no one out
//	there who knows about her.

/*妹の事を知ってる人間は
ほとんどいないんだ。*/
スネーク_031: {
&~?Cu&'ando fue la &'ultima vez que la viste?
}
//	<<<ENGLISH>>>
//	When was the last
//	time you saw her?

/*彼女とは？*/
オタコン_032: {
Hace m&'as de 10 a&~nos.
}
//	<<<ENGLISH>>>
//	Over 10 years ago.

/*もう十何年も会ってない。*/
スネーク_033: {
&~?Ser&'a una trampa?
&~?Para qu&'e caigamos en ella...?
}
//	<<<ENGLISH>>>
//	You think it's a trap?
//	To lure us out here...?

/*罠だと思うか？
俺達をおびき寄せる……？*/
オタコン_034: {
No s&'e. Despu&'es de la pista, entr&'e en el
sistema del Pent&'agono para recibir
confirmaci&'on.
}
//	<<<ENGLISH>>>
//	I don't know. After I got the tip,
//	I did break into the Pentagon
//	system to get confirmation.

/*わからない。ただ……タレコミの後、
ペンタゴンのファイルに潜り込んで
裏は取ったんだ……。*/
スネーク_035: {
Vale...
}
//	<<<ENGLISH(2)>>>
//	Okay...

/*わかった……。*/
オタコン_036: {
Ten cuidado, Snake. Quiz&'as met&'i la pata.
}
//	<<<ENGLISH>>>
//	Watch your back, Snake.
//	Maybe I screwed up.

/*すまない……スネーク。
気をつけてね。*/
スネーク_037: {
Tengo una USP con luz, puedo
enfrentarlos los ahora mismo.
}
//	<<<ENGLISH>>>
//	I've got a light-equipped USP;
//	I can take them on now.

/*ＵＳＰを手に入れた。
これで奴等と対等だ。*/
スネーク_038: {
No tengo municiones,
pero es una 9mm, como las M9 de los
Marines. Encontrar&'e municiones por aqu&'i.
}
//	<<<ENGLISH>>>
//	There's no ammo, but it takes a
//	9mm, just like the Marines' M9. I'll
//	find those somewhere around here.

/*弾倉は空だが、海兵隊のＭ９と同じ
９ミリ弾を使う。弾はどこかで補給
できるだろう。*/
/* light-equipped で包含している。
スネーク_039: {
フラッシュライトも装備されている。
}
*/
オタコン_040: {
No armes tanto jaleo con eso.
}
//	<<<ENGLISH>>>
//	Don't raise too much
//	racket with that thing.

/*でも、銃声には注意してね。*/
スネーク_041: {
De acuerdo.
}
//	<<<ENGLISH>>>
//	I hear you.

/*ああ。*/
}//d


// 新規作成分
resource T_09b1R船倉無線機デモ１__s {
オタコン_000: {
Snake, &~?est&'as ya dentro? &~?Has llegado
ya a las bodegas?
}
//	<<<ENGLISH>>>
//	Snake, are you in yet? Have
//	you made it to the holds?

/*スネーク、まだかい？
船倉に進入した？*/
スネーク_001: {
Estoy tardando m&'as de lo que esperaba.
Ya hemos pasado el Puente Verrazano.
}
//	<<<ENGLISH>>>
//	It's taking longer than I expected.
//	We've already passed the Verrazano
//	Bridge.

/*予定より手間取っている……。
既にベラザノ橋を通過した。*/
オタコン_002: {
Vale. Usaremos otro lugar para el rescate.
}
//	<<<ENGLISH>>>
//	All right. We'll use
//	another recovery point.

/*わかった。＃｛回収、リカバリー｝ポイントを
変更するよ。*/
スネーク_003: {
Puede que planeen cambiar el recorrido.
}
//	<<<ENGLISH>>>
//	They may be planning
//	to change course.

/*航路を変更するつもりかもしれん。*/
オタコン_004: {
&~?Qu&'e?
}
//	<<<ENGLISH(2)>>>
//	What?

/*なんだって？*/
スネーク_005: {
Todas las salidas a la cubierta
est&'an todas cerradas.
}
//	<<<ENGLISH>>>
//	The exits to the deck
//	are all sealed.

/*上への出口が塞がれた……。*/
オタコン_006: {
&~?Qu&'e est&'an planeando?
}
//	<<<ENGLISH>>>
//	What are they planning?

/*連中、どうするつもりなんだ。*/
スネーク_007: {
Si consiguen el Metal Gear, nos vamos a
quedar con nada.
}
//	<<<ENGLISH>>>
//	If they get Metal Gear,
//	we're going right off the
//	fringe.

/*奴等の手にメタルギアが渡れば
大変な事になる……。*/
}


// 新規作成分
resource T_10b1R船倉無線機デモ２__s {
オタコン_000: {
De acuerdo, Snake. Repasemos lo nuestro
una vez m&'as.
}
//	<<<ENGLISH>>>
//	OK, Snake. Let's go over
//	this one more time.

/*スネーク、もう一度確認するね。*/
オタコン_001: {
Usa esta c&'amara para obtener pruebas
fotogr&'aficas de la existencia del prototipo
de Metal Gear.
}
//	<<<ENGLISH(2)>>>
//	Use this camera to get
//	photographic evidence
//	of the Metal Gear prototype.

/*カメラで新型メタルギアの写真を
撮るんだ。*/
オタコン_002: {
&~!Bien! Ahora, haz lo que tengas que
hacer, saca las fotos, Y pon al gobierno en
evidencia.
}
//	<<<ENGLISH>>>
//	Now, do your thing and take
//	pictures that speak louder than
//	the government's plausible denials.

/*政府がシラを切れない
ような証拠写真を頼む。*/
/* この台詞は無しになったのでは？？？
スネーク_007: {
できるだけ接近してみる。
}
*/
オタコン_003: {
Necesitamos cuatro fotograf&'ias:
}
//	<<<ENGLISH>>>
//	We need four shots:

オタコン_003_1: {
el Metal Gear por el frente, la derecha,
}
//	<<<ENGLISH>>>
//	Metal Gear from the front,
//	front-right, and front-left,

/*写真は四枚欲しい。メタルギアを
右、前、左の三方向から撮ったものと、*/
オタコン_004: {
por la izquierda y un primer plano del sello
de los Marines.
}
//	<<<ENGLISH>>>
//	and a close-up of
//	the Marine Corps marking.

/*海兵隊のマーキングのアップだ。*/
スネーク_005: {
&~?Sello?
}
//	<<<ENGLISH>>>
//	Marking?

/*マーキング？*/
オタコン_006: {
Deber&'ia de haber un sello de 'MARINES'
sobre el cuerpo de Metal Gear.
}
//	<<<ENGLISH(2)>>>
//	There should be a "MARINES"
//	insignia on the body of Metal
//	Gear.

/*メタルギアのどこかに海兵隊の
所属であることを表す＃｛ＭＡＲＩＮＥＳ、マリーンズ｝
っていうマーキングがあるはずなんだ。*/
オタコン_007: {
Ya quiero oir la explicaci&'on de esa foto.
}
//	<<<ENGLISH>>>
//	Just let someone try
//	explaining away a clear
//	shot of that.

/* 廃止？？？？？
/*それがはっきり写っているのが一枚
欲しい。言い逃れされないためにね。*/
オタコン_012: {
Cuando tengas las im&'agenes, Env&'ialas a
trav&'es de Codec.
}
//	<<<ENGLISH>>>
//	As soon as you have the images,
//	use the Codec to transmit them
//	in an encrypted burst.

/*撮影できたら、無線機でバースト送信
してくれ。*/
//<ページ数変更>
オタコン_012_1: {
Si las fotos son suficientemente claras, las
podremos usar.
}
//	<<<ENGLISH>>>
//	If they make the grade,
//	we'll go from there.

/*うまく撮れてたら次の指示を
出すよ。*/
廃止？？？？？ */
スネーク_008: {
De acuerdo.
}
//	<<<ENGLISH(2)>>>
//	All right.

/*わかった。*/
オタコン_009: {
A decir verdad, hay algo m&'as...
}
//	<<<ENGLISH>>>
//	There's actually
//	one little thing...

/*……実はあと一つ問題があって。*/
スネーク_010: {
Venga, su&'eltalo. Estoy acostumbrado a
que las cosas vayan mal.
}
//	<<<ENGLISH>>>
//	Just spit it out.
//	I'm used to things
//	going wrong.

/*遠慮せずに言え。
厄介事が増えることには馴れている。*/
オタコン_011: {
Creo que alguien est&'a controlando
nuestra transmisi&'on.
}
//	<<<ENGLISH>>>
//	It looks like someone's
//	monitoring our transmission.

/*誰かが僕らの通信をモニターしてる
気配があるんだ。*/
スネーク_012: {
&~?Qui&'en?
}
//	<<<ENGLISH>>>
//	Who?

/*何者だ？*/
オタコン_013: {
No tengo ni idea. Lo &'unico que hacen es
observar...
}
//	<<<ENGLISH>>>
//	I don't have a clue. All they're
//	doing is watching -- it would
//	creep me out less

/*わからない。だけどモニターしてる
だけで妨害しようって様子はないんだ。*/
オタコン_014: {
me preocupar&'ia menos si intentaran
interferir nuestra comunicaci&'on.
}
//	<<<ENGLISH>>>
//	if they tried to interfere
//	with our communications.

/*それがかえって不気味で……。*/
スネーク_015: {
&~?Podr&'ia tener algo que ver con ese Cypher
que vimos?
}
//	<<<ENGLISH>>>
//	Could it have something to
//	do with that Cypher we saw?

/*さっきのサイファーとも関係が？*/
オタコン_016: {
Tal vez. Cambie temporalmente el
protocolo de encriptaci&'on para nuestra
transmisi&'on.
}
//	<<<ENGLISH>>>
//	Maybe. I've switched the encryption
//	protocol for our burst transmission
//	for now.

/*どうかな。
とりあえずバースト通信の暗号化
プロトコルを別のに切り替えてる。*/
オタコン_018: {
Lo que quiero hacer ahora es usar un
m&'etodo distinto para enviar esas fotos.
S&'olo por si acaso.
}
//	<<<ENGLISH>>>
//	What I want to do is use a
//	different method for sending
//	those photos, just in case.

/*あと、念の為に写真の送信経路を
変えたいんだ。*/
スネーク_019: {
&~?En vez de usar Codec?
}
//	<<<ENGLISH>>>
//	Instead of using the Codec?

/*この無線を使わずに写真を
送るってことか？*/
オタコン_020: {
Exactamente. Hay una terminal en la
esquina sureste del bloque donde se aloja
Metal Gear.
}
//	<<<ENGLISH>>>
//	Exactly. There's a workstation in
//	the southeast corner of the block
//	where Metal Gear is housed.

/*そう。船倉の一番奥、メタルギアがある
ブロックの南東にコンピュータが一台
置いてある。
*/
オタコン_021: {
He hecho los preparativos para enviar las
fotos...
}
//	<<<ENGLISH>>>
//	I've made arrangements so that
//	you can send the pictures from
//	the machine.

/*そこから写真を送信出来るように
細工しておいた。*/
スネーク_022: {
desde esa m&'aquina.
}
//	<<<ENGLISH>>>
//	"Arrangements"?


/*細工？ どうやったんだ？*/
オタコン_023: {
Enganch&'e un aparato al Link-16 de la red
del Ej&'ercito norteamericano.
}
//	<<<ENGLISH>>>
//	I hitched a ride on Link-16
//	into U.S. military's proprietary
//	network.

/*軍事ネットワークのリンク１６経由で
その＃｛ＷＳ、ワークステーション｝に侵入して*/
オタコン_024: {
Me las ingeni&'e para entrar en la terminal
y re-escribi una parte del software,
}
//	<<<ENGLISH>>>
//	Managed to get into that workstation
//	and overwrote a part of the system
//	software＃－

/*システムの
一部を書き換えて＃－*/
//<ページ数変更>
オタコン_024_1: {
Y as&'i poder instalar a distancia
la aplicaci&'on.
}
//	<<<ENGLISH>>>
//	so I could remote-install
//	a little app I wrote...

/*僕が作った特製のアプリを
リモート・インストールして……。*/
スネーク_025: {
&~?Por qu&'e molestarse en algo tan
complicado?
}
//	<<<ENGLISH>>>
//	Why bother with anything
//	that complicated...

/*面倒なことを……。*/
オタコン_026: {
No, es bastante f&'acil, de verdad.
}
//	<<<ENGLISH>>>
//	No, it's pretty simple, really.

/*いや、やり方は簡単だよ。*/
//<ページ数変更>
オタコン_026_1: {
Lo &'unico por hacer una vez en la m&'aquina
es pulsar 'Acci&'on'.
}
//	<<<ENGLISH>>>
//	Look, all you have to do is stand
//	in front of the machine and push
//	the Action button.

/*スネークは
マシンの前でアクションボタンを押す
だけでいい。*/
オタコン_027: {
La aplicaci&'on autom&'aticamente emitir&'a y
descargar&'a, las im&'agenes de la c&'amara,
}
//	<<<ENGLISH>>>
//	The app will automatically launch
//	and download the image data from
//	the camera,

/*それでアプリが自動的に立ち上がって
写真のデータを読み取り、*/
//<ページ数変更>
オタコン_027_1: {
dividir&'a los archivos y los encriptar&'a uno
por uno.
}
//	<<<ENGLISH>>>
//	split the files and encrypt
//	them individually.

/*分割後暗号化
する。*/
オタコン_028: {
Los paquetes de informaci&'on se podr&'an
disfrazar como...
}
//	<<<ENGLISH>>>
//	The data packets can
//	then masquerade as...

/*データは偽装されたパケットに
格納されて……。*/
スネーク_029: {
Bien, Vale. O sea que s&'olo tengo que
pulsar 'Acci&'on' cuando est&'e frente al
computador,
}
//	<<<ENGLISH>>>
//	OK, OK. So all I have to do is
//	push the Action button in front
//	of the computer＃－

//<ページ数変更>
スネーク_029_1: {
con las fotos, &~?no?
}
//	<<<ENGLISH>>>
//	once I have the pictures, right?

/*わかった。
写真を撮ったらコンピュータの前で
アクションボタンを押せば良いんだな。*/
オタコン_030: {
Bien, vale, eso es m&'as o menos...
}
//	<<<ENGLISH>>>
//	Well, sure, if you
//	put it that way.

/*うん、まあ、そうだよ。*/
オタコン_031: {
Y algo m&'as...
}
//	<<<ENGLISH>>>
//	And one more thing...

/*それと……注意して欲しいのは、*/
//<ページ数変更>
オタコン_031_1: {
El Comandante ya ha empezado su
discurso, tienes que tomar las fotos antes
de que termine de hablar.
}
//	<<<ENGLISH>>>
//	The Commandant's already begun
//	his speech, but you need to get the
//	pictures before he's done talking.

/*既に演説が始まってる。
演説が終わるまでに撮影しないと*/
オタコン_032: {
Si no es as&'i, te atrapar&'an.
&~?De acuerdo?
}
//	<<<ENGLISH>>>
//	Otherwise, they'll spot you. OK?

/*発見されるよ、いいね？*/
スネーク_033: {
&~?Cu&'anto tiempo tengo?
}
//	<<<ENGLISH>>>
//	How much time do I have?

/*どれくらい余裕があるんだ？*/
オタコン_034: {
Entr&'e en sus archivos personales y ech&'e
un vistazo al texto de su discurso.
}
//	<<<ENGLISH(2)>>>
//	I hacked into his personal
//	files and took a look at the
//	text of that speech.

/*今日の司令官の原稿をハックした。*/
オタコン_035: {
Te dir&'ia que tienes unos cinco minutos
m&'as... algo m&'as si cuenta alg&'un chiste... 
}
//	<<<ENGLISH>>>
//	I'd say you have seven more
//	minutes -- longer if he throws
//	in a joke or two.

/*だいたい１０分てところだ。
アドリブがなければだけど……。*/
スネーク_036: {
Un m&'aximo de siete minutos, &~?eh?
}
//	<<<ENGLISH>>>
//	A seven-minute time limit, huh?

/*１０分がタイムリミットか。*/
オタコン_037: {
Recuerda, Snake, s&'olo las fotos, &~?S&'i?
}
//	<<<ENGLISH>>>
//	Remember, Snake,
//	just the photos, OK?

/*スネーク、写真だけだよ。*/
スネーク_038: {
En estas circunstancias, no me arriesgar&'e.
}
//	<<<ENGLISH>>>
//	With these kinds of odds,
//	I won't be making any sudden
//	moves.

/*この数だ。そんな気は
起こしようもない。*/
スネーク_039: {
Pero no podemos dejar que se apropien de
Metal Gear.
}
//	<<<ENGLISH>>>
//	But that doesn't mean we can
//	just let Metal Gear be hijacked.

/*しかし、奴等に＃｛新型、アレ｝を
渡すわけにもいかない。*/
オタコン_040: {
Vale, vale, pero primero,
las fotos...
}
//	<<<ENGLISH>>>
//	Okay, okay, but
//	first, the photos...

/*そうだけど、まずは写真を……。*/
スネーク_041: {
De acuerdo. Nos ocuparemos del resto
cuando llegue el momento.
}
//	<<<ENGLISH>>>
//	All right. We'll deal with
//	the rest when we get there.

/*わかった。後の事はそれから考える。*/
オタコン_042: {
Ten cuidado.
}
//	<<<ENGLISH>>>
//	Stay low.

/*それじゃ、見つからないようにね。*/
