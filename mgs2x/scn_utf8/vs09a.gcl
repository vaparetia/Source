// ------------------------------------
// マップ設定
// ------------------------------------
chara マップ スニーキング９面 -k d:KMS_NAME -h d:HZX_NAME,0 -l $s:ＶＲライトファイル名

command マップ設定 スニーキング９面 -set {
	// ローカルの初期化
	// ------------------------------------
	@ローカル変数初期化		// ローカルで使用する変数で初期化をする場合はここで

	// 設定値を変更する場合は以下のプロック内で設定
	// ------------------------------------
	@設定値変更				// 敵兵や的のパラメータをステージ限定で変える時はここで

	// ＶＲで必要な基本プロックのセット(vr_common.hで定義)
	// サウンドの基本パック、ＶＲの基本システム、プレイヤー、ゴール等を設定します
	// ※このプロックを使用する時は「ＶＲクリア時処理」というプロックが必要です
	// ＶＲ共通プロックセット	$:スネークファイル $:雷電ファイル $:クリア条件フラグ
	//							$:ゴールＸ $:ゴールＹ $:ゴールＺ $:タイマー初期値
	//	VR_GOAL_TARGET	/*的全滅でゴールが開く*/
	//	VR_GOAL_FREE	/*ゴールが最初から開いてる*/
	//	VR_GOAL_ENEMY	/*敵全滅でゴールが開く*/
	//	VR_GOAL_SNEAK	/*潜入モード中はゴールが開く*/
	//	VR_GOAL_TIME	/*タイマーがゼロになるとゴールが開く*/
	// ------------------------------------
	if ( $b:モード番号 == d:SNEAKING:SNEAKING ) {
		if ( $s:選択プレイヤー != 前作スネーク ) {
			@ＶＲ共通プロックセット sna_vs09a rai_vs09a d:VR_GOAL_FREE d:GOAL_POS_VS09A
		} else {
			@ＶＲ共通プロックセット sna_vs09a rai_vs09a d:VR_GOAL_FREE d:GOAL_POS_VS09A_PRE
		}
	} else {
		if ( $s:選択プレイヤー != 前作スネーク ) {
			@ＶＲ共通プロックセット sna_vs09a rai_vs09a d:VR_GOAL_SCN d:GOAL_POS_VS09A
		} else {
			@ＶＲ共通プロックセット sna_vs09a rai_vs09a d:VR_GOAL_SCN d:GOAL_POS_VS09A_PRE
		}
	}

	// ＶＲウィンドウの設定
	// ------------------------------------
	@スニーキング９面ＶＲウィンドウ設定

	// クリア時に呼ばれるものの設定
	// ------------------------------------
	@ＶＲクリア設定 p:load_vs10a p:A_ＲＥＴＲＹプロック

	// ステージに引かれるライン
	// ------------------------------------
	@ＶＲアウトライン d:KMS_NAME d:TONBO_KMS_NAME d:LINE_KMS_NAME

	// プレイヤーの設定
	// ------------------------------------
	@プラグイン設定			// プレイヤーのプラグインがいる時はここで
	@ジャンプ設定

	// 敵兵・的関係の設定
	// ------------------------------------
	@コマンダー設定
	@監視カメラ設置

	// ＢＧＭの設定(プレイヤー→敵兵→BGMの順で呼ぶ)
	// ------------------------------------
	@ＢＧＭ設定

	// アイテムの設定
	// ------------------------------------
	@アイテム設定

	// 光源、オブジェクト、カメラ関連の設定
	// ------------------------------------
	@ＶＲフォグ設定 d:VR_FOG:朝Ｎ 35000 d:VR_FOG:夕Ｎ 35000 d:VR_FOG:夜Ｎ 30000
	@カメラセット					// chara カメラとベースのカメラを設定
	@スニーキング９面カメラ設定		// ステージ固有のカメラ設定がいる時はこのプロックで
	@ＶＲキャラ用ライト設置			// 必ず最後に設定
#if d:DEBUG_CHARA
//	@デバッグキャラセット
#endif
}

//初期マップの表示
command マップ表示 -show スニーキング９面


// 各proc設定
//-------------------------------------------------------------------------------------
// 全マップ共通
	//------------------------------------------------------------
	// ＶＲウィンドウの設定と表示
	//------------------------------------------------------------
	proc スニーキング９面ＶＲウィンドウ設定 {
		#if d:DEBUG_PRINT
			print 'vr_window_set'
		#endif

		if ( $b:モード番号 == d:SNEAKING:SNEAKING ) {
			@ＶＲウィンドウ設定	d:VS09A_SNK_WINDOW_RES
		} else {
			@ＶＲウィンドウ設定	d:VS09A_ELM_WINDOW_RES
		}

		// ＶＲウィンドウを表示する
		mesg ＶＲウィンドウ ＶＲウィンドウ君 開く

		// スタート時とクリア時に使用するカットインカメラ
		chara カメラ カットインカメラ		-c 0 -l 0 -p  0

		// スタート時のカメラ(必要な場合)
		if ( $s:選択プレイヤー != 前作スネーク ) {
			chara カメラ設定 カットインカメラ \
				-c 1 \	
				-p 500,6908,-4613 -t 500,21,-9033 \
				-r 652,2048,0 -f 8183 \
				-a 200 \
				-i 0 -1 0 0 \
				-s 1
		} else {
			chara カメラ設定 カットインカメラ \
				-c 1 \	
				-p -4000,6907,-4612 -t -4000,246,-9364 \
				-r 620,2048,0 -f 8182 \
				-a 200 \
				-i 0 -1 0 0 \
				-s 1
		}
	}

	//------------------------------------------------------------
	// ステージ開始時処理
	//------------------------------------------------------------
	proc ＶＲステージ開始時処理 {
		#if d:DEBUG_PRINT
			print 'game_start!!!!!'
		#endif

		// プレイヤーやパッドの制御等を行う a_stdproc.hで定義
		@全ミッション共通ステージ開始時処理

		// カメラワークスタート(必要な場合)
		// 全体図
		chara カメラ設定 カットインカメラ \
			-c 1 \	
			-p 504,23205,10889 -t 504,4627,1574 \
			-r 721,2048,0 -f 20782 \
			-a 200 \
			-i 4 4 d:START_CAMERA_CHANGE_TIME d:START_CAMERA_CHANGE_TIME \
			-s 1

		chara delay ディレイ \
			-time d:START_CAMERA_CHANGE_TIME \
			-exec {
				chara カメラ設定 カットインカメラ -s -1
			}
	}

	// ------------------------------------
	// クリア時の処理
	// ------------------------------------
	proc ＶＲクリア時処理 {
		#if d:DEBUG_PRINT 
			print 'clear'
		#endif

		// 強制モーションを発動
		@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_1 2048

		// クリア時にカメラアングルを変える
		if ( $s:選択プレイヤー != 前作スネーク ) {
			chara カメラ設定 クリア時カメラ \
				-c 1 \	
				-p 1990,2329,-13038 -t 359,741,-7972 \
				-r 189,3893,0 -f 5554 \
				-a 200 \
				-i 1 0 0 0 \
				-s 1

		} else {
			chara カメラ設定 クリア時カメラ \
				-c 1 \	
				-p -5938,1655,-13135 -t -3552,973,-8148 \
				-r 80,291,0 -f 5570 \
				-a 200 \
				-i 1 0 0 0 \
				-s 1

		}
	}



	// ------------------------------------
	// パラメータ系の変更
	// ------------------------------------
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT 
			print 'localvar_init'
		#endif
	}
	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT 
			print 'status_set'
		#endif

		@スニーキング用キャラ別標準装備設定 13 5 10 4

		// 初期装備の設定
		// 初期装備の追加設定
		if ( $b:モード番号 == d:SNEAKING:SNEAKING ) {
			switch ( $s:選択プレイヤー ) {
				case ( ライデン ) {
					eval ( $w:武器弾数Ｒ[ d:武器:雑誌 ] = 5 );
					eval ( $w:武器 = d:武器:雑誌 );
				}
			}

		} else {
			// ELM_ALLの時
		}
	}



	// ------------------------------------
	// プレイヤーに関する設定
	//-------------------------------------
	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif

		command プラグイン自動ジャンプ
	}
	//-------------------------------------
	// 台登り
	// ------------------------------------
	proc ジャンプ設定 {
		#if d:DEBUG_PRINT
			print 'jump_set'
		#endif

		trap ky001 d:PLAYER \
			-mask 入る \
			-exec {
				@ジャンプ発動 ky001 1000 10
			}
	}



	// ------------------------------------
	// 敵兵や的の処理
	// ------------------------------------
	// 敵兵に関する設定
	//-------------------------------------
	proc 警備兵セット {
		#if d:DEBUG_PRINT 
			print 'watcher_set'
		#endif

		local $$:拡張ステータス;

		if ( $b:モード番号 == d:SNEAKING:SNEAKING ) {
			$$:拡張ステータス = 0;
		} else {
			$$:拡張ステータス = d:ENE_STST_FAINT_EXIT;
		}

		if ( $s:選択プレイヤー == ライデン || $s:選択プレイヤー == プリスキン || $s:選択プレイヤー == 刀ライデン ) {
			@VR_拡張警備兵 敵兵:01 d:E_R:雷電西Ｒ	 0 d:ENE_STATUS_NORMAL $$:拡張ステータス d:COMMON_STATUS
			@VR_拡張警備兵 敵兵:02 d:E_R:雷電中央Ｒ	 0 d:ENE_STATUS_NORMAL $$:拡張ステータス d:COMMON_STATUS
			@VR_拡張警備兵 敵兵:03 d:E_R:雷電北Ｒ	 0 d:ENE_STATUS_NORMAL $$:拡張ステータス d:COMMON_STATUS

		} else if ( $s:選択プレイヤー == スネーク || $s:選択プレイヤー == タキシードスネーク ) {
			@VR_拡張警備兵 敵兵:01 d:E_R:スネーク西Ｒ		 0 d:ENE_STATUS_NORMAL $$:拡張ステータス d:COMMON_STATUS
			@VR_拡張警備兵 敵兵:02 d:E_R:スネーク倉庫前Ｒ	 0 d:ENE_STATUS_NORMAL $$:拡張ステータス d:COMMON_STATUS
			@VR_拡張警備兵 敵兵:03 d:E_R:スネーク中央Ｒ		 0 d:ENE_STATUS_NORMAL $$:拡張ステータス d:COMMON_STATUS
			@VR_拡張警備兵 敵兵:04 d:E_R:スネーク北Ｒ		 0 d:ENE_STATUS_NORMAL $$:拡張ステータス d:COMMON_STATUS

		} else {
			// 前作スネーク
			@VR_拡張警備兵 敵兵:01 d:E_R:前作スネーク倉庫前Ｒ	 0 d:ENE_STATUS_NORMAL $$:拡張ステータス d:COMMON_STATUS
			@VR_拡張警備兵 敵兵:02 d:E_R:前作スネーク南西Ｒ		 0 d:ENE_STATUS_NORMAL $$:拡張ステータス d:COMMON_STATUS
			@VR_拡張警備兵 敵兵:03 d:E_R:前作スネークゴール前Ｒ	 0 d:ENE_STATUS_NORMAL $$:拡張ステータス d:COMMON_STATUS
			@VR_拡張警備兵 敵兵:04 d:E_R:前作スネーク中央定時連絡Ｒ	 1 d:ENE_STATUS_REPORT $$:拡張ステータス d:COMMON_STATUS
			@VR_拡張警備兵 敵兵:05 d:E_R:前作スネーク北Ｒ		 0 d:ENE_STATUS_NORMAL $$:拡張ステータス d:COMMON_STATUS

		}
	}

	proc 攻撃兵セット {
		#if d:DEBUG_PRINT 
			print 'attacker_set'
		#endif

		if ( $s:選択プレイヤー == ライデン || $s:選択プレイヤー == プリスキン || $s:選択プレイヤー == 刀ライデン ) {

			@VR_探索攻撃兵 敵兵:21		 d:ATTACKER_COMMON_STATUS d:E_R:雷電東追加Ｒ
			@VR_探索攻撃兵 敵兵:21		 d:ATTACKER_COMMON_STATUS d:E_R:雷電中央追加Ｒ

		} else if ( $s:選択プレイヤー == スネーク || $s:選択プレイヤー == タキシードスネーク ) {
			@VR_探索攻撃兵 敵兵:21		 d:ATTACKER_COMMON_STATUS d:E_R:スネーク東追加Ｒ
			@VR_サポート攻撃兵 敵兵:22	 d:ATTACKER_COMMON_STATUS 敵兵:01

		} else {
			// 前作スネーク
			@VR_探索攻撃兵 敵兵:22		 d:ATTACKER_COMMON_STATUS_PRE d:E_R:前作スネーク東追加Ｒ
			@VR_探索攻撃兵 敵兵:22		 d:ATTACKER_COMMON_STATUS_PRE d:E_R:前作スネーク西追加Ｒ
			@VR_サポート攻撃兵 敵兵:23	 d:ATTACKER_COMMON_STATUS_PRE 敵兵:04
		}
	}

	proc 警備兵コマンダー {
		#if d:DEBUG_PRINT
			print 'wccomm_set'
		#endif

		chara 警備コマンダー wccomm -e { 警備兵セット }
	}

	proc 攻撃兵コマンダー {
		#if d:DEBUG_PRINT
			print 'atcomm_set'
		#endif

		chara 攻撃コマンダー atcomm -e { 攻撃兵セット }
	}

	proc コマンダー設定 {
		#if d:DEBUG_PRINT
			print 'commander_set'
		#endif

		if ( $s:選択プレイヤー != 前作スネーク ) {
			chara コマンダー 敵兵セット \
				-w 警備兵コマンダー \
				-a 攻撃兵コマンダー \
				-d スニーキング９面 \
				-r d:GOAL_POS_VS09A スニーキング９面 \
				-c d:GOAL_POS_VS09A スニーキング９面 \
				-v [ene_vr_voice:01] \
				-z $i:敵標準麻酔持続 \
				-h $i:標準警戒時間 \
				-o $i:敵標準気絶持続 \
				-s (d:ENE_STAGE_GPS | d:ENE_STAGE_VR_ANOTHER) \
				-b 0 \
				-m d:ALERT_MODE_SENNYU

		} else {
			chara コマンダー 敵兵セット \
				-w 警備兵コマンダー \
				-a 攻撃兵コマンダー \
				-d スニーキング９面 \
				-r d:GOAL_POS_VS09A_PRE スニーキング９面 \
				-c d:GOAL_POS_VS09A_PRE スニーキング９面 \
				-v [ene_vr_voice:01] \
				-z $i:敵標準麻酔持続 \
				-h $i:標準警戒時間 \
				-o $i:敵標準気絶持続 \
				-f	d:E_R:前作スネーク中央定時連絡Ｒ 2 t:vc044023 t:vc044023_len \
				-s (d:ENE_STAGE_GPS | d:ENE_STAGE_VR_ANOTHER) \
				-b 0 \
				-m d:ALERT_MODE_SENNYU

		}
	}


	// ------------------------------------
	// 監視カメラ
	// ------------------------------------
	proc 監視カメラ破壊時処理 $:名前 $:フラグ {
	}
	proc 監視カメラ設置 {
		#if d:DEBUG_PRINT
			print 'svc_camera'
		#endif

		// プリスキン以降出てくるカメラ
		if ( $s:選択プレイヤー == プリスキン || \
			 $s:選択プレイヤー == タキシードスネーク || \
			 $s:選択プレイヤー == 刀ライデン || \
			 $s:選択プレイヤー == 前作スネーク ) {
			
			@A_監視カメラ 北カメラ -2500 3500 -9000 700 0 0 800 0
		}
	}


	// ------------------------------------
	// ＢＧＭの設定
	// ------------------------------------
	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT 
			print 'bgm_set'
		#endif

		chara ＢＧＭマネージャー ＢＧＭマネ
	}


	// ------------------------------------
	// アイテムの設定
	// ------------------------------------
	// 再発生が必要な時は以下のプロックの中を記述する
	// ------------------------------------
	proc アイテム取得時番号設定 $:ボックス名 {
		#if d:DEBUG_PRINT
			print 'item_no_set'
		#endif
	}
	// アイテムの設置
	// ------------------------------------
	proc アイテム設定 {
		#if d:DEBUG_PRINT 
			print 'item_set'
		#endif

		if ( $b:モード番号 == d:SNEAKING:SNEAKING ) {
			switch ( $s:選択プレイヤー ) {
				case ( ライデン ) {
					@ダンボール_初期設置 ダンボールＡ d:ITEM_POS_01 0 25
				}
				case ( スネーク ) {
					@雑誌_初期設置 雑誌:01 d:ITEM_POS_03 0
					@雑誌_初期設置 雑誌:02 d:ITEM_POS_04 0
					@雑誌_初期設置 雑誌:03 d:ITEM_POS_05 0
					@雑誌_初期設置 雑誌:04 d:ITEM_POS_07 0
					@ダンボールＢ_初期設置 ダンボールＢ d:ITEM_POS_01 0 25
				}
				case ( プリスキン ) {
					@雑誌_初期設置 雑誌:04 d:ITEM_POS_05 0
					@ダンボールＣ_初期設置 ダンボールＣ d:ITEM_POS_01 0 25
				}
				case ( タキシードスネーク ) {
					@A_チャフ_初期設置 チャフ d:ITEM_POS_03 0 2
					@雑誌_初期設置 雑誌:04 d:ITEM_POS_06 0
					@ダンボールＤ_初期設置 ダンボールＤ d:ITEM_POS_05 0 25
				}
				case ( 刀ライデン ) {
				}
				default {
					// 前作スネーク
					@A_チャフ_初期設置 チャフ d:ITEM_POS_01 0 2
					@雑誌_初期設置 雑誌:01 d:ITEM_POS_03 0
					@雑誌_初期設置 雑誌:02 d:ITEM_POS_04 0
					@雑誌_初期設置 雑誌:03 d:ITEM_POS_08 0
					@雑誌_初期設置 雑誌:04 d:ITEM_POS_12 0
					@雑誌_初期設置 雑誌:05 d:ITEM_POS_13 0
					@ダンボールＥ_初期設置 ダンボールＥ d:ITEM_POS_02 0 25
				}
			}
		} else {
			switch ( $s:選択プレイヤー ) {
				case ( ライデン ) {
					@A_Ｍ９_初期設置 Ｍ９本体 d:ITEM_POS_01 0 なし 16
					@弾薬_Ｍ９_初期設置 Ｍ９弾 d:ITEM_POS_10 0
					@弾薬_ソコム_初期設置 ソコム弾 d:ITEM_POS_02 0
					@A_雑誌_初期設置 雑誌 d:ITEM_POS_07 0 1
					@ダンボール_初期設置 ダンボールＡ d:ITEM_POS_12 0 25
				}
				case ( スネーク ) {
					@A_Ｍ９_初期設置 Ｍ９本体 d:ITEM_POS_12 0 なし 6
					@弾薬_Ｍ９_初期設置 Ｍ９弾 d:ITEM_POS_02 0
					@弾薬_ＵＳＰ_初期設置 ＵＳＰ弾 d:ITEM_POS_09 0
					@A_雑誌_初期設置 雑誌 d:ITEM_POS_05 0 1
					@ダンボールＢ_初期設置 ダンボールＢ d:ITEM_POS_01 0 25
				}
				case ( プリスキン ) {
					@A_Ｍ９_初期設置 Ｍ９本体 d:ITEM_POS_06 0 なし 6
					@弾薬_ＵＳＰ_初期設置 ＵＳＰ弾 d:ITEM_POS_10 0
					@A_雑誌_初期設置 雑誌 d:ITEM_POS_05 0 1
					@ダンボールＣ_初期設置 ダンボールＣ d:ITEM_POS_02 0 25
				}
				case ( タキシードスネーク ) {
					@A_ＵＳＰ_初期設置 ＵＳＰ本体 d:ITEM_POS_03 0 なし 16
					@A_チャフ_初期設置 チャフ d:ITEM_POS_05 0 2
					@A_雑誌_初期設置 雑誌 d:ITEM_POS_09 0 1
					@ダンボールＤ_初期設置 ダンボールＤ d:ITEM_POS_12 0 25
					@ＵＳＰサプレッサ_初期設置 ＵＳＰサプレッサ d:ITEM_POS_04 0
				}
				case ( 刀ライデン ) {
				}
				default {
					// 前作スネーク
					@A_Ｍ９_初期設置 Ｍ９本体 d:ITEM_POS_03 0 なし 5
					@弾薬_Ｍ９_初期設置 Ｍ９弾 d:ITEM_POS_11 0
					@A_ＵＳＰ_初期設置 ＵＳＰ本体 d:ITEM_POS_04 0 なし 0
					@弾薬_ＵＳＰ_初期設置 ＵＳＰ弾 d:ITEM_POS_01 0
					@A_チャフ_初期設置 チャフ d:ITEM_POS_08 0 2
					@A_雑誌_初期設置 雑誌 d:ITEM_POS_06 0 1
					@ダンボールＥ_初期設置 ダンボールＥ d:ITEM_POS_15 0 25
					@ＵＳＰサプレッサ_初期設置 ＵＳＰサプレッサ d:ITEM_POS_12 0
					@A_雑誌_初期設置 雑誌 d:ITEM_POS_14 0 1
				}
			}
		}
	}




	// ------------------------------------
	// その他オブジェクト関係
	// ------------------------------------


	// ------------------------------------
	// 光源関係
	// ------------------------------------
	// フォグ
	// ------------------------------------
	proc フォグ設定 {
		#if d:DEBUG_PRINT
			print 'fog_set'
		#endif

		chara フォグ 霧\
			-c 4, 33, 38 \
			-n 3000 \
			-f 40000 
	}
	// キャラ用光源(マップの設置が終わってから設定することで、キャラだけに光を当てる)
	// ------------------------------------
	proc キャラ用ライト設置 {
		#if d:DEBUG_PRINT
			print 'chara_light_set'
		#endif

		chara 環境光 環境光源 \
			 -c 75 100 95

		chara 平行光 平行光源 \
			 -c 30	70 90 \
			 -p -3800 -3200 250
	}


	// ------------------------------------
	// カメラ関係の設定 
	// ------------------------------------
	// ステージカメラ設定 
	// ------------------------------------
	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'chara_camera & stage_camera_set'
		#endif

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0 
		chara カメラ メインカメラ		-c 0 -l 2 -p 40
		chara カメラ クリア時カメラ		-c 0 -l 2 -p 10

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \	
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l -4000,1500,-8374 1705,d:CAM_MAX,5534 \
			-r 740,2048,0 \
			-f 9000 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}
	// ステージ固有のカメラ設定 
	// ------------------------------------
	proc スニーキング９面カメラ設定 {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif
		
