// ------------------------------------
// 敵兵ルート番号
// ------------------------------------
enum E_R {
	共通待機Ｒ = 0,
	前作スネーク共通待機Ｒ,
	雷電西Ｒ,
	雷電中央Ｒ,
	雷電北Ｒ,
	雷電東追加Ｒ,
	雷電中央追加Ｒ,
	スネーク西Ｒ,
	スネーク倉庫前Ｒ,
	スネーク中央Ｒ,
	スネーク北Ｒ,
	スネーク東追加Ｒ,
	前作スネーク倉庫前Ｒ,
	前作スネーク南西Ｒ,
	前作スネークゴール前Ｒ,
	前作スネーク中央定時連絡Ｒ,
	前作スネーク北Ｒ,
	前作スネーク西追加Ｒ,
	前作スネーク東追加Ｒ
}

#define	COMMON_STATUS				 0 0 0 スニーキング９面
#define	ATTACKER_COMMON_STATUS		 d:E_R:共通待機Ｒ d:ENE_STATUS_NORMAL d:ENE_EQUIP_TYPE_NORMAL
#define	ATTACKER_COMMON_STATUS_PRE	 d:E_R:前作スネーク共通待機Ｒ d:ENE_STATUS_NORMAL d:ENE_EQUIP_TYPE_NORMAL


// ------------------------------------
// ゴールの位置
// ------------------------------------
#define	GOAL_POS_VS09A		500 0 -9000			// 前作スネーク以外
#define	GOAL_POS_VS09A_PRE	-4000 0 -9000		// 前作スネーク

// ------------------------------------
// ＶＲウィンドウのリソース等
// ------------------------------------
#define	VS09A_SNK_WINDOW_RES [VRMSG_J:VRM_SNK_SNK_vs09a] [VRMSG_E:VRM_SNK_SNK_vs09a] [VRMSG_G:VRM_SNK_SNK_vs09a] \	// 日、英、独
							 [VRMSG_F:VRM_SNK_SNK_vs09a] [VRMSG_I:VRM_SNK_SNK_vs09a] [VRMSG_S:VRM_SNK_SNK_vs09a] \	// 仏、伊、西
							 [VRMSG_K:VRM_SNK_SNK_vs09a] \															// 韓
							 p:ＶＲステージ開始時処理		// 終了プロック

#define	VS09A_ELM_WINDOW_RES [VRMSG_J:VRM_SNK_ELM_vs09a] [VRMSG_E:VRM_SNK_ELM_vs09a] [VRMSG_G:VRM_SNK_ELM_vs09a] \	// 日、英、独
							 [VRMSG_F:VRM_SNK_ELM_vs09a] [VRMSG_I:VRM_SNK_ELM_vs09a] [VRMSG_S:VRM_SNK_ELM_vs09a] \	// 仏、伊、西
							 [VRMSG_K:VRM_SNK_ELM_vs09a] \															// 韓
							 p:ＶＲステージ開始時処理		// 終了プロック


// ------------------------------------
// アイテムのポジション
// ------------------------------------
#define	ITEM_POS_01		 -6500,	 0,		 3500	// 南西のくぼみ
#define	ITEM_POS_02		 -1000,	 0,		 4000	// 南の部屋の中央
#define	ITEM_POS_03		 -1500,	 0,		 2500	// 南の部屋の北部分左
#define	ITEM_POS_04		 -500,	 0,		 2500	// 南の部屋の北部分右
#define	ITEM_POS_05		 5000,	 0,		 7000	// 南東
#define	ITEM_POS_06		 -4500,	 750,	 -5500	// 北西荷物の上
#define	ITEM_POS_07		 -4000,	 0,		 -9000	// ステージ北西
#define	ITEM_POS_08		 5500,	 0,		 -5500	// ステージ東壁の裏
#define	ITEM_POS_09		 3500,	 750,	 -7500	// 北東荷物の上
#define	ITEM_POS_10		 5000,	 0,		 -9000	// 北東
#define	ITEM_POS_11		 -1500,	 0,		 -8500	// 北の柱の下
#define	ITEM_POS_12		 2500,	 0,		 -500	// 中央の角
#define	ITEM_POS_13		 -500,	 0,		 -4500	// 中央の柱の南側
#define	ITEM_POS_14		 1500,	 0,		 7500	// ステージ南側
#define	ITEM_POS_15		 5500,	 0,		 -3500	// ステージ西側


