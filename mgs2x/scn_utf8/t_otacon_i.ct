// added by S.Hirano 01/03/02
proc rto_オルガ死体:04  {
vox t:vc002901 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_オルガ死体__i:オタコン_000]
	}
	talk スネーク 標準 -m {
		[TO_オルガ死体__i:スネーク_001]
	}
	talk オタコン 標準 -m {
		[TO_オルガ死体__i:オタコン_002]
	}
@rt_つっこまれ＿是＿なんで知ってるんだ系デフォルト 100
@rt_うなづきデフォルト＿否
	talk スネーク 標準 -m {
		[TO_オルガ死体__i:スネーク_003]
	}
	talk オタコン 標準 -m {
		[TO_オルガ死体__i:オタコン_004]
	}
	talk スネーク 標準 -m {
		[TO_オルガ死体__i:スネーク_005]
	}
@rt_エロエロ＿是＿たまららん系デフォルト 100
@rt_キテレツさん＿否＿なんだこいつ系デフォルト 100
	talk オタコン 標準 -m {
		[TO_オルガ死体__i:オタコン_006]
	}
	talk オタコン 標準 -m {
		[TO_オルガ死体__i:オタコン_006_1]
	}
	talk スネーク 標準 -m {
		[TO_オルガ死体__i:スネーク_007]
	}
} //v
}


