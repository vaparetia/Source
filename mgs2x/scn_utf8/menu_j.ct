proc rp_ＳＡＶＥデフォルトセット:07 {
	selectmenu  2 -m  { 
		[ＳＡＶＥ選択肢:セーブする] 
		[ＳＡＶＥ選択肢:セーブしない] 
	}
	eval($w:rfp_ＳＡＶＥ選択肢返り値 = $status)
	print 'ぐあだららじょぶ$w:rfp_ＳＡＶＥ選択肢返り値:' $w:rfp_ＳＡＶＥ選択肢返り値
}

proc rp_ＳＡＶＥさせないセット:07 {
	selectmenu  2 -m  { 
		[ＳＡＶＥ選択肢:セーブさせない] 
		[ＳＡＶＥ選択肢:セーブしない] 
	}
	eval($w:rfp_ＳＡＶＥ選択肢返り値 = $status)
	print 'ぐあだららじょぶ$w:rfp_ＳＡＶＥ選択肢返り値:' $w:rfp_ＳＡＶＥ選択肢返り値
}

proc rt_ＳＡＶＥデフォルトセット:07 {
print 'ほげほほほ'
	selectmenu  2 -m  { 
		[ＳＡＶＥ選択肢:セーブする] 
		[ＳＡＶＥ選択肢:セーブしない] 
	}
	eval($w:rft_ＳＡＶＥ選択肢返り値 = $status)
print 'ぷにょあよあああ'
}
