					mesg 警備兵 敵兵:04 ルート変更 d:E_R:雷電_的Ｃ護衛Ｒ04 d:D_POS_C_04 ダークステージ
					mesg 警備兵 敵兵:05 ルート変更 d:E_R:雷電_的Ｃ護衛Ｒ05 d:D_POS_C_05 ダークステージ
					mesg 警備兵 敵兵:06 ルート変更 d:E_R:雷電_的Ｃ護衛Ｒ06 d:D_POS_C_06 ダークステージ

				} else if ($$f:的Ａ破壊フラグ == 0 && $$f:的Ｃ破壊フラグ == 1 ) {
					mesg 警備兵 敵兵:01 ルート変更 d:E_R:雷電_的Ａ護衛Ｒ01 d:D_POS_A_01 ダークステージ
