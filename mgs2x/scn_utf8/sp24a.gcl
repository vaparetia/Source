					mesg 警備兵 敵兵:04 ルート変更 d:E_R:雷電_的Ａ護衛Ｒ04 d:D_POS_A_04 ダークステージ
					mesg 警備兵 敵兵:05 ルート変更 d:E_R:雷電_的Ａ護衛Ｒ05 d:D_POS_A_05 ダークステージ
					mesg 警備兵 敵兵:06 ルート変更 d:E_R:雷電_的Ａ護衛Ｒ06 d:D_POS_A_06 ダークステージ

				} else if ($$f:的Ａ破壊フラグ == 1 && $$f:的Ｃ破壊フラグ == 0 ) {
