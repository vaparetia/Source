// ------------------------------------
// マップ設定
// ------------------------------------
chara マップ ダークステージ -k d:KMS_NAME -k d:KMS_NAME_WALL -h d:HZX_NAME,0 -l d:LT2_NAME
command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 2

command マップ設定 ダークステージ -set {
	// ローカルの初期化
	// ------------------------------------
	@ローカル変数初期化		// ローカルで使用する変数で初期化をする場合はここで

	// ＶＲで必要な基本プロックのセット(vr_common.hで定義)
	// サウンドの基本パック、ＶＲの基本システム、プレイヤー、ゴール等を設定します
	// ※このプロックを使用する時は「ＶＲクリア時処理」というプロックが必要です
	// ＶＲ共通プロックセット	$:スネークファイル $:雷電ファイル $:クリア条件フラグ
	//							$:ゴールＸ $:ゴールＹ $:ゴールＺ $:タイマー初期値
	//	VR_GOAL_TARGET	/*的全滅でゴールが開く*/
	//	VR_GOAL_FREE	/*ゴールが最初から開いてる*/
	//	VR_GOAL_ENEMY	/*敵全滅でゴールが開く*/
	//	VR_GOAL_SNEAK	/*潜入モード中はゴールが開く*/
	//	VR_GOAL_TIME	/*タイマーがゼロになるとゴールが開く*/
	// ------------------------------------
	@ＶＲ共通プロックセット sna_sp08a rai_sp08a d:VR_GOAL_TARGET d:GOAL_POS_SP24A

	// ＶＲウィンドウの設定
	// ------------------------------------
	@ダークステージＶＲウィンドウ設定

	// クリア時に呼ばれるものの設定
	// ------------------------------------
	@ＶＲクリア設定 p:load_sp25a p:A_ＲＥＴＲＹプロック

	// ステージに引かれるライン
	// ------------------------------------
	@ＶＲアウトライン d:KMS_NAME d:TONBO_KMS_NAME d:LINE_KMS_NAME

	// 設定値を変更する場合は以下のプロック内で設定
	// ------------------------------------
	@設定値変更				// 敵兵や的のパラメータをステージ限定で変える時はここで

	// プレイヤーの設定
	// ------------------------------------
	@プラグイン設定			// プレイヤーのプラグインがいる時はここで
	@ジャンプ設定

	// 敵兵・的関係の設定
	// ------------------------------------
	@コマンダー設定
	@ＶＲ護衛的設定
	@監視カメラ設置

	// ＢＧＭの設定(プレイヤー→敵兵→BGMの順で呼ぶ)
	// ------------------------------------
	@ＢＧＭ設定

	// アイテムの設定
	// ------------------------------------
	@アイテム設定

	// 光源、オブジェクト、カメラ関連の設定
	// ------------------------------------
	@落とし穴設置
	@フォグ設定
	@カメラセット					// chara カメラとベースのカメラを設定
	@キャラ用ライト設置				// 必ず最後に設定
#if d:DEBUG_CHARA
//	@デバッグキャラセット
#endif
}

//初期マップの表示
command マップ表示 -show ダークステージ


// 各proc設定
//-------------------------------------------------------------------------------------
// 全マップ共通
	//------------------------------------------------------------
	// ＶＲウィンドウの設定と表示
	//------------------------------------------------------------
	proc ダークステージＶＲウィンドウ設定 {
		#if d:DEBUG_PRINT
			print 'vr_window_set'
		#endif

		@ＶＲウィンドウ設定	d:SP24A_WINDOW_RES

		// ＶＲウィンドウを表示する
		mesg ＶＲウィンドウ ＶＲウィンドウ君 開く

		// スタート時とクリア時に使用するカットインカメラ
		chara カメラ カットインカメラ		-c 0 -l 0 -p  0

		// スタート時のカメラ(必要な場合)
		chara カメラ設定 カットインカメラ \
			-c 1 \	
			-p 6904,6120,-1000 -t 4500,0,-1000 \
			-r 780,3072,0 -f 6575 \
			-a 160 \
			-i 0 -1 0 0 \
			-s 1
	}

	//------------------------------------------------------------
	// ステージ開始時処理
	//------------------------------------------------------------
	proc ＶＲステージ開始時処理 {
		#if d:DEBUG_PRINT
			print 'game_start!!!!!'
		#endif

		// プレイヤーやパッドの制御等を行う a_stdproc.hで定義
		@全ミッション共通ステージ開始時処理

		// カメラワークスタート(必要な場合)
		// 全体図
		chara カメラ設定 カットインカメラ \
			-c 1 \	
			-p 66062,102950,-25075 -t 43702,46535,-25075 \
			-r 778,3072,0 -f 60685 \
			-a 160 \
			-i 4 4 d:START_CAMERA_CHANGE_TIME d:START_CAMERA_CHANGE_TIME \
			-s 1

		chara delay ディレイ \
			-time d:START_CAMERA_CHANGE_TIME \
			-exec {
				chara カメラ設定 カットインカメラ -s -1
			}
	}

	// 的を開始直後に表示する
	proc ゲーム開始直後処理 {
		// 初期配置標的の起動（command ＶＲステージスタート の起動直後に行う必要がある）
		mesg ＶＲ的共通 的 移動開始
	}

	// ------------------------------------
	// クリア時の処理
	// ------------------------------------
	proc ＶＲクリア時処理 {
		#if d:DEBUG_PRINT 
			print 'clear'
		#endif

		@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_1 0

		// クリア時にカメラアングルを変える
		chara カメラ設定 クリア時カメラ \
			-c 1 \	
			-p 5396,1499,2899 -t 4549,1178,-143 \
			-r 66,2225,0 -f 3174 \
			-a 160 \
			-i 1 0 0 0 \
			-s 1
	}



	// ------------------------------------
	// パラメータ系の変更
	// ------------------------------------
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT 
			print 'localvar_init'
		#endif

		$$i:テンプライトカウンタ = 0;
		$$f:的Ａ破壊フラグ = 0;
		$$f:的Ｂ破壊フラグ = 0;
		$$f:的Ｃ破壊フラグ = 0;
		$$f:的Ｄ破壊フラグ = 0;
		$$f:的Ｅ破壊フラグ = 0;
	}

	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT 
			print 'status_set'
		#endif

		// ダークステージはレーダーオフ
		command メニュー設定 -node_access off

		// 初期装備の追加設定
		switch ( $s:選択プレイヤー ) {
			case ( ライデン ) {
				$w:武器弾数Ｒ[ d:武器:Ｍ９ ] = 76;
				$w:武器弾数Ｒ[ d:武器:ソコム ] = 109;
				$w:プレイヤーフラグ = ( $w:プレイヤーフラグ| d:PL_SOCOM_SPPRSR_ATTACHED );
				$w:武器弾数Ｒ[ d:武器:マガジン ] = 10;
				$w:アイテム数Ｒ[ d:アイテム:双眼鏡 ] = 1;
				$w:アイテム数Ｒ[ d:アイテム:振動センサー ] = 1
				$w:武器 = d:武器:ソコム;
				$w:アイテム = d:アイテム:振動センサー;
			}
			case ( スネーク ) {
				$w:武器弾数Ｒ[ d:武器:Ｍ９ ] = 61;
				$w:武器弾数Ｒ[ d:武器:ＵＳＰ ] = 76;
				$w:武器弾数Ｒ[ d:武器:マガジン ] = 10;
				$w:プレイヤーフラグ = ( $w:プレイヤーフラグ| d:PL_USP_SPPRSR_ATTACHED );
				$w:アイテム数Ｒ[ d:アイテム:双眼鏡 ] = 1;
				$w:アイテム数Ｒ[ d:アイテム:振動センサー ] = 1;
				$w:武器 = d:武器:ＵＳＰ;
				$w:アイテム = d:アイテム:振動センサー;
			}
		}

	}



	// ------------------------------------
	// プレイヤーに関する設定
	//-------------------------------------
	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif

		command プラグイン自動ジャンプ
		command ＵＳＰライトＯＮ
		command プラグイン落下
	}
	//-------------------------------------
	// 台登り
	// ------------------------------------
	proc ジャンプ設定 {
		#if d:DEBUG_PRINT
			print 'jump_set'
		#endif

		trap ky001 d:PLAYER \
			-mask 入る \
			-exec {
				@ジャンプ発動 ky001 1000 10
			}
	}



	// ------------------------------------
	// 敵兵や的の処理
	// ------------------------------------
	// 敵兵に関する設定
	//-------------------------------------
	proc 警備兵セット {
		#if d:DEBUG_PRINT 
			print 'watcher_set'
		#endif

		// VR_警備兵 $:p_名前 $:p_ルート $:p_ノード $:p_ステータス $:p_守備Ｘ $:p_守備Ｙ $:p_守備Ｚ $:p_守備マップ
		switch ( $s:選択プレイヤー ) {
			case ( ライデン ) {
				@VR_警備兵 敵兵:01 d:E_R:雷電_的Ａ護衛Ｒ01 0 d:ENE_STATUS_SP24A d:D_POS_A_01 ダークステージ
				@VR_警備兵 敵兵:02 d:E_R:雷電_的Ａ護衛Ｒ02 0 d:ENE_STATUS_SP24A d:D_POS_A_02 ダークステージ
				@VR_警備兵 敵兵:03 d:E_R:雷電_的Ｂ護衛Ｒ03 0 d:ENE_STATUS_SP24A d:D_POS_B_03 ダークステージ
				@VR_警備兵 敵兵:04 d:E_R:雷電_的Ｂ護衛Ｒ04 0 d:ENE_STATUS_SP24A d:D_POS_B_04 ダークステージ
				@VR_警備兵 敵兵:05 d:E_R:雷電_的Ｃ護衛Ｒ05 0 d:ENE_STATUS_SP24A d:D_POS_C_05 ダークステージ
				@VR_警備兵 敵兵:06 d:E_R:雷電_的Ｃ護衛Ｒ06 0 d:ENE_STATUS_SP24A d:D_POS_C_06 ダークステージ
			}
			default {
				// スネーク
				@VR_警備兵 敵兵:01 d:E_R:スネーク_的Ａ護衛Ｒ01 0 d:ENE_STATUS_SP24A d:D_POS2_A_01 ダークステージ
				@VR_警備兵 敵兵:02 d:E_R:スネーク_的Ａ護衛Ｒ02 0 d:ENE_STATUS_SP24A d:D_POS2_A_02 ダークステージ
				@VR_警備兵 敵兵:03 d:E_R:スネーク_的Ｂ護衛Ｒ03 0 d:ENE_STATUS_SP24A d:D_POS2_B_03 ダークステージ
				@VR_警備兵 敵兵:04 d:E_R:スネーク_的Ｂ護衛Ｒ04 0 d:ENE_STATUS_SP24A d:D_POS2_B_04 ダークステージ
				@VR_警備兵 敵兵:05 d:E_R:スネーク_的Ｃ護衛Ｒ05 0 d:ENE_STATUS_SP24A d:D_POS2_C_05 ダークステージ
				@VR_警備兵 敵兵:06 d:E_R:スネーク_的Ｃ護衛Ｒ06 0 d:ENE_STATUS_SP24A d:D_POS2_C_06 ダークステージ
				@VR_警備兵 敵兵:07 d:E_R:スネーク_的Ｄ護衛Ｒ07 0 d:ENE_STATUS_SP24A d:D_POS2_D_07 ダークステージ
				@VR_警備兵 敵兵:08 d:E_R:スネーク_的Ｅ護衛Ｒ08 0 d:ENE_STATUS_SP24A d:D_POS2_E_08 ダークステージ
			}
		}
	}

	proc 攻撃兵セット {
		#if d:DEBUG_PRINT 
			print 'attacker_set'
		#endif

		switch ( $s:選択プレイヤー ) {
			case ( ライデン ) {
				@VR_攻撃兵 敵兵:11 d:ATTACKER_COMMON_STATUS d:ENE_EQUIP_TYPE_SHIELD
				@VR_攻撃兵 敵兵:12 d:ATTACKER_COMMON_STATUS d:ENE_EQUIP_TYPE_NORMAL
				@VR_攻撃兵 敵兵:13 d:ATTACKER_COMMON_STATUS d:ENE_EQUIP_TYPE_SHOTGUN
			}
			default {
				// スネーク
				@VR_攻撃兵 敵兵:11 d:ATTACKER_COMMON_STATUS d:ENE_EQUIP_TYPE_SHIELD
				@VR_攻撃兵 敵兵:12 d:ATTACKER_COMMON_STATUS d:ENE_EQUIP_TYPE_SHIELD
				@VR_攻撃兵 敵兵:13 d:ATTACKER_COMMON_STATUS d:ENE_EQUIP_TYPE_SHOTGUN
				@VR_攻撃兵 敵兵:14 d:ATTACKER_COMMON_STATUS d:ENE_EQUIP_TYPE_SHOTGUN
			}
		}
	}

	proc 警備兵コマンダー {
		#if d:DEBUG_PRINT
			print 'wccomm_set'
		#endif

		chara 警備コマンダー wccomm -e { 警備兵セット }
	}

	proc 攻撃兵コマンダー {
		#if d:DEBUG_PRINT
			print 'atcomm_set'
		#endif

		chara 攻撃コマンダー wccomm -e { 攻撃兵セット }
	}


	proc コマンダー設定 {
		#if d:DEBUG_PRINT
			print 'commander_set'
		#endif

		local $$:再発生数;
		switch ( $s:選択プレイヤー ) {
			case ( ライデン ) {
				$$:再発生数 = 4;
			}
			default {
				$$:再発生数 = 8;
			}
		}

		chara コマンダー 敵兵セット \
			-w 警備兵コマンダー \
			-a 攻撃兵コマンダー \
			-d ダークステージ \
			-r d:GOAL_POS_SP24A ダークステージ \
			-c d:GOAL_POS_SP24A ダークステージ \
			-v [ene_vr_voice:01] \
			-z $i:敵標準麻酔持続 \
			-h $i:標準警戒時間 \
			-o $i:敵標準気絶持続 \
			-s (d:ENE_STAGE_VR_ANOTHER) \
			-b $$:再発生数 \
			-m d:ALERT_MODE_SENNYU
	}




	// 的に関する設定
	//-------------------------------------
	proc ＶＲ的セット $:p_名前 $:p_ルート {

		switch ( $s:選択プレイヤー ) {
			case ( ライデン ) {
				chara	ＶＲ移動的 $:p_名前 \
					-flag ( d:VR_TRG_DARK_OCTA | d:VR_TRG_FL_MARK | d:VR_TRG_WAIT ) \
					-route $:p_ルート \
					-speed 25 \
					-c ＶＲ的破壊時処理
			}
			default {
				chara	ＶＲ移動的 $:p_名前 \
					-flag ( d:VR_TRG_DARK_OCTA | d:VR_TRG_FL_MARK | d:VR_TRG_WAIT | d:VR_TRG_HIDESTART ) \
					-route $:p_ルート \
					-speed 25 \
					-c ＶＲ的破壊時処理 
			}
		}
	}

	proc ＶＲ的破壊時処理 {
		#if d:DEBUG_PRINT 
			print 'vr_target_broken $1='$1
		#endif

		switch ( $1 ) {
			case ( 的:01 ) {
				$$f:的Ａ破壊フラグ = 1;
				// 他の的が破壊されていない場合、フォーメーションを変える
				if ( $$f:的Ｂ破壊フラグ == 0 && $$f:的Ｃ破壊フラグ == 0 ) {
					mesg 警備兵 敵兵:01 ルート変更 d:E_R:雷電_的Ｂ護衛Ｒ01 d:D_POS_B_01 ダークステージ
					mesg 警備兵 敵兵:02 ルート変更 d:E_R:雷電_的Ｃ護衛Ｒ02 d:D_POS_C_02 ダークステージ
					mesg 警備兵 敵兵:03 ルート変更 d:E_R:雷電_的Ｂ護衛Ｒ03 d:D_POS_B_03 ダークステージ
					mesg 警備兵 敵兵:04 ルート変更 d:E_R:雷電_的Ｂ護衛Ｒ04 d:D_POS_B_04 ダークステージ
					mesg 警備兵 敵兵:05 ルート変更 d:E_R:雷電_的Ｃ護衛Ｒ05 d:D_POS_C_05 ダークステージ
					mesg 警備兵 敵兵:06 ルート変更 d:E_R:雷電_的Ｃ護衛Ｒ06 d:D_POS_C_06 ダークステージ

				} else if ($$f:的Ｂ破壊フラグ == 0 && $$f:的Ｃ破壊フラグ == 1 ) {
					mesg 警備兵 敵兵:01 ルート変更 d:E_R:雷電_的Ｂ護衛Ｒ01 d:D_POS_B_01 ダークステージ
					mesg 警備兵 敵兵:02 ルート変更 d:E_R:雷電_的Ｂ護衛Ｒ02 d:D_POS_B_02 ダークステージ
					mesg 警備兵 敵兵:03 ルート変更 d:E_R:雷電_的Ｂ護衛Ｒ03 d:D_POS_B_03 ダークステージ
					mesg 警備兵 敵兵:04 ルート変更 d:E_R:雷電_的Ｂ護衛Ｒ04 d:D_POS_B_04 ダークステージ
					mesg 警備兵 敵兵:05 ルート変更 d:E_R:雷電_的Ｂ護衛Ｒ05 d:D_POS_B_05 ダークステージ
					mesg 警備兵 敵兵:06 ルート変更 d:E_R:雷電_的Ｂ護衛Ｒ06 d:D_POS_B_06 ダークステージ

				} else if ($$f:的Ｂ破壊フラグ == 1 && $$f:的Ｃ破壊フラグ == 0 ) {
					mesg 警備兵 敵兵:01 ルート変更 d:E_R:雷電_的Ｃ護衛Ｒ01 d:D_POS_C_01 ダークステージ
					mesg 警備兵 敵兵:02 ルート変更 d:E_R:雷電_的Ｃ護衛Ｒ02 d:D_POS_C_02 ダークステージ
					mesg 警備兵 敵兵:03 ルート変更 d:E_R:雷電_的Ｃ護衛Ｒ03 d:D_POS_C_03 ダークステージ
					mesg 警備兵 敵兵:04 ルート変更 d:E_R:雷電_的Ｃ護衛Ｒ04 d:D_POS_C_04 ダークステージ
					mesg 警備兵 敵兵:05 ルート変更 d:E_R:雷電_的Ｃ護衛Ｒ05 d:D_POS_C_05 ダークステージ
					mesg 警備兵 敵兵:06 ルート変更 d:E_R:雷電_的Ｃ護衛Ｒ06 d:D_POS_C_06 ダークステージ

				}
			}
			case ( 的:02 ) {
				$$f:的Ｂ破壊フラグ = 1;
				// 他の的が破壊されていない場合、フォーメーションを変える
				if ( $$f:的Ａ破壊フラグ == 0 && $$f:的Ｃ破壊フラグ == 0 ) {
					mesg 警備兵 敵兵:01 ルート変更 d:E_R:雷電_的Ａ護衛Ｒ01 d:D_POS_A_01 ダークステージ
					mesg 警備兵 敵兵:02 ルート変更 d:E_R:雷電_的Ａ護衛Ｒ02 d:D_POS_A_02 ダークステージ
