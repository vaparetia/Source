					mesg 警備兵 敵兵:03 ルート変更 d:E_R:スネーク_的Ａ護衛Ｒ03 d:D_POS2_A_03 ダークステージ
					mesg 警備兵 敵兵:04 ルート変更 d:E_R:スネーク_的Ｃ護衛Ｒ04 d:D_POS2_C_04 ダークステージ
					mesg 警備兵 敵兵:05 ルート変更 d:E_R:スネーク_的Ｃ護衛Ｒ05 d:D_POS2_C_05 ダークステージ
					mesg 警備兵 敵兵:06 ルート変更 d:E_R:スネーク_的Ｃ護衛Ｒ06 d:D_POS2_C_06 ダークステージ

				} else if ($$f:的Ａ破壊フラグ == 0 && $$f:的Ｃ破壊フラグ == 1 ) {
					mesg 警備兵 敵兵:01 ルート変更 d:E_R:スネーク_的Ａ護衛Ｒ01 d:D_POS2_A_01 ダークステージ
					mesg 警備兵 敵兵:02 ルート変更 d:E_R:スネーク_的Ａ護衛Ｒ02 d:D_POS2_A_02 ダークステージ
					mesg 警備兵 敵兵:03 ルート変更 d:E_R:スネーク_的Ａ護衛Ｒ03 d:D_POS2_A_03 ダークステージ
					mesg 警備兵 敵兵:04 ルート変更 d:E_R:スネーク_的Ａ護衛Ｒ04 d:D_POS2_A_04 ダークステージ
					mesg 警備兵 敵兵:05 ルート変更 d:E_R:スネーク_的Ａ護衛Ｒ05 d:D_POS2_A_05 ダークステージ
					mesg 警備兵 敵兵:06 ルート変更 d:E_R:スネーク_的Ａ護衛Ｒ06 d:D_POS2_A_06 ダークステージ

				} else if ($$f:的Ａ破壊フラグ == 1 && $$f:的Ｃ破壊フラグ == 0 ) {
					mesg 警備兵 敵兵:01 ルート変更 d:E_R:スネーク_的Ｃ護衛Ｒ01 d:D_POS2_C_01 ダークステージ
					mesg 警備兵 敵兵:02 ルート変更 d:E_R:スネーク_的Ｃ護衛Ｒ02 d:D_POS2_C_02 ダークステージ
					mesg 警備兵 敵兵:03 ルート変更 d:E_R:スネーク_的Ｃ護衛Ｒ03 d:D_POS2_C_03 ダークステージ
					mesg 警備兵 敵兵:04 ルート変更 d:E_R:スネーク_的Ｃ護衛Ｒ04 d:D_POS2_C_04 ダークステージ
					mesg 警備兵 敵兵:05 ルート変更 d:E_R:スネーク_的Ｃ護衛Ｒ05 d:D_POS2_C_05 ダークステージ
					mesg 警備兵 敵兵:06 ルート変更 d:E_R:スネーク_的Ｃ護衛Ｒ06 d:D_POS2_C_06 ダークステージ

				}
			}
			case ( 的:13 ) {
				$$f:的Ｃ破壊フラグ = 1;
				// 他の的が破壊されていない場合、フォーメーションを変える
				if ( $$f:的Ａ破壊フラグ == 0 && $$f:的Ｂ破壊フラグ == 0 ) {
					mesg 警備兵 敵兵:01 ルート変更 d:E_R:スネーク_的Ａ護衛Ｒ01 d:D_POS2_A_01 ダークステージ
					mesg 警備兵 敵兵:02 ルート変更 d:E_R:スネーク_的Ａ護衛Ｒ02 d:D_POS2_A_02 ダークステージ
					mesg 警備兵 敵兵:03 ルート変更 d:E_R:スネーク_的Ｂ護衛Ｒ03 d:D_POS2_B_03 ダークステージ
					mesg 警備兵 敵兵:04 ルート変更 d:E_R:スネーク_的Ｂ護衛Ｒ04 d:D_POS2_B_04 ダークステージ
					mesg 警備兵 敵兵:05 ルート変更 d:E_R:スネーク_的Ａ護衛Ｒ05 d:D_POS2_A_05 ダークステージ
					mesg 警備兵 敵兵:06 ルート変更 d:E_R:スネーク_的Ｂ護衛Ｒ06 d:D_POS2_B_06 ダークステージ

				} else if ($$f:的Ａ破壊フラグ == 0 && $$f:的Ｂ破壊フラグ == 1 ) {
					mesg 警備兵 敵兵:01 ルート変更 d:E_R:スネーク_的Ａ護衛Ｒ01 d:D_POS2_A_01 ダークステージ
					mesg 警備兵 敵兵:02 ルート変更 d:E_R:スネーク_的Ａ護衛Ｒ02 d:D_POS2_A_02 ダークステージ
					mesg 警備兵 敵兵:03 ルート変更 d:E_R:スネーク_的Ａ護衛Ｒ03 d:D_POS2_A_03 ダークステージ
					mesg 警備兵 敵兵:04 ルート変更 d:E_R:スネーク_的Ａ護衛Ｒ04 d:D_POS2_A_04 ダークステージ
					mesg 警備兵 敵兵:05 ルート変更 d:E_R:スネーク_的Ａ護衛Ｒ05 d:D_POS2_A_05 ダークステージ
					mesg 警備兵 敵兵:06 ルート変更 d:E_R:スネーク_的Ａ護衛Ｒ06 d:D_POS2_A_06 ダークステージ

				} else if ($$f:的Ａ破壊フラグ == 1 && $$f:的Ｂ破壊フラグ == 0 ) {
					mesg 警備兵 敵兵:01 ルート変更 d:E_R:スネーク_的Ｂ護衛Ｒ01 d:D_POS2_B_01 ダークステージ
					mesg 警備兵 敵兵:02 ルート変更 d:E_R:スネーク_的Ｂ護衛Ｒ02 d:D_POS2_B_02 ダークステージ
					mesg 警備兵 敵兵:03 ルート変更 d:E_R:スネーク_的Ｂ護衛Ｒ03 d:D_POS2_B_03 ダークステージ
					mesg 警備兵 敵兵:04 ルート変更 d:E_R:スネーク_的Ｂ護衛Ｒ04 d:D_POS2_B_04 ダークステージ
					mesg 警備兵 敵兵:05 ルート変更 d:E_R:スネーク_的Ｂ護衛Ｒ05 d:D_POS2_B_05 ダークステージ
					mesg 警備兵 敵兵:06 ルート変更 d:E_R:スネーク_的Ｂ護衛Ｒ06 d:D_POS2_B_06 ダークステージ

				}
			}
			case ( 的:14 ) {
				$$f:的Ｄ破壊フラグ = 1;
				// 他の的が破壊されていない場合、フォーメーションを変える
				if ( $$f:的Ｅ破壊フラグ == 0 ) {
					mesg 警備兵 敵兵:07 ルート変更 d:E_R:スネーク_的Ｅ護衛Ｒ07 d:D_POS2_E_07 ダークステージ
					mesg 警備兵 敵兵:08 ルート変更 d:E_R:スネーク_的Ｅ護衛Ｒ08 d:D_POS2_E_08 ダークステージ
				}
			}
			case ( 的:15 ) {
				$$f:的Ｅ破壊フラグ = 1;
				// 他の的が破壊されていない場合、フォーメーションを変える
				if ( $$f:的Ｄ破壊フラグ == 0 ) {
					mesg 警備兵 敵兵:07 ルート変更 d:E_R:スネーク_的Ｄ護衛Ｒ07 d:D_POS2_D_07 ダークステージ
					mesg 警備兵 敵兵:08 ルート変更 d:E_R:スネーク_的Ｄ護衛Ｒ08 d:D_POS2_D_08 ダークステージ

				}
			}
		}
	}

	proc ＶＲ護衛的設定 {
		#if d:DEBUG_PRINT 
			print 'vr_bomb_set'
		#endif

		command ＶＲ移動的ライフ 10
		command セットＶＲ的部位ダメージ d:VR_MDL_DARK 1 1 1

		switch ( $s:選択プレイヤー ) {
			case ( ライデン ) {
				@ＶＲ的セット 的:01 d:E_R:雷電_的Ａ
				@ＶＲ的セット 的:02 d:E_R:雷電_的Ｂ
				@ＶＲ的セット 的:03 d:E_R:雷電_的Ｃ
			}
			default {
				// スネーク
				command セットＶＲ的出現消え周期 180 60

				@ＶＲ的セット 的:11 d:E_R:スネーク_的Ａ
				@ＶＲ的セット 的:12 d:E_R:スネーク_的Ｂ
				@ＶＲ的セット 的:13 d:E_R:スネーク_的Ｃ
				@ＶＲ的セット 的:14 d:E_R:スネーク_的Ｄ
				@ＶＲ的セット 的:15 d:E_R:スネーク_的Ｅ
			}
		}
	}



	// 監視カメラに関する設定
	//-------------------------------------
	proc 監視カメラ破壊時処理 $:名前 $:フラグ {
	}
	proc 監視カメラ設置 {
		#if d:DEBUG_PRINT
			print 'svc_camera'
		#endif

		// A_監視カメラ $:名前 $:場所Ｘ $:場所Ｙ $:場所Ｚ $:取付縦方向 $:取付横方向 $:カメラ振り中心角 $:振り幅 $:フラグ 
		if ( $s:選択プレイヤー == スネーク ) {
			@A_監視カメラ 監視カメラ:01 24500 3500 -40000 500 0 512 512 0
			@A_監視カメラ 監視カメラ:02 11000 3500 -37500 500 1024 512 512 0
			@A_監視カメラ 監視カメラ:03 3000 3500 -5500 500 1024 512 512 0
			@A_監視カメラ 監視カメラ:04 24000 3500 -3500 500 3072 2560 512 0
		}

	}

	// ------------------------------------
	// ＢＧＭの設定
	// ------------------------------------
	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT 
			print 'bgm_set'
		#endif

		chara ＢＧＭマネージャー ＢＧＭマネ
	}


	// ------------------------------------
	// アイテムの設定
	// ------------------------------------
	// 再発生が必要な時は以下のプロックの中を記述する
	// ------------------------------------
	proc アイテム取得時番号設定 $:ボックス名 {
		#if d:DEBUG_PRINT
			print 'item_no_set'
		#endif
	}
	// アイテムの設置
	// ------------------------------------
	proc アイテム設定 {
		#if d:DEBUG_PRINT 
			print 'item_set'
		#endif

		switch ( $s:選択プレイヤー ) {
			case ( ライデン ) {
				@A_ＡＫＳ_初期設置 ＡＫＳ本体 d:ITEM_POS_19 0 なし 211
				@A_ＰＳＧ１_初期設置 ＰＳＧ１本体 d:ITEM_POS_13 0 なし 60
				@A_ＰＳＧ１－Ｔ_初期設置 ＰＳＧ１－Ｔ本体 d:ITEM_POS_18 0 なし 30
				@A_スタン_初期設置 スタン d:ITEM_POS_14 0 なし 5
				@A_チャフ_初期設置 チャフ d:ITEM_POS_29 0 なし 5
				@ジアゼパム_初期設置 ジアゼパム d:ITEM_POS_21 0
				@暗視ゴーグル_初期設置 暗視ゴーグル d:ITEM_POS_12 0
				@サーマルゴーグル_初期設置 サーマルゴーグル d:ITEM_POS_25 0
				@ＡＫサプレッサ_初期設置 ＡＫサプレッサ d:ITEM_POS_22 0
			}
			default {
				// スネーク
				@A_Ｍ４_初期設置 Ｍ４本体 d:ITEM_POS_25 0 なし 151
				@A_ＰＳＧ１_初期設置 ＰＳＧ１本体 d:ITEM_POS_22 0 なし 60
				@A_ＰＳＧ１－Ｔ_初期設置 ＰＳＧ１－Ｔ本体 d:ITEM_POS_16 0 なし 30
				@A_スタン_初期設置 スタン d:ITEM_POS_18 0 なし 5
				@A_チャフ_初期設置 チャフ d:ITEM_POS_07 0 なし 5
				@ジアゼパム_初期設置 ジアゼパム d:ITEM_POS_20 0
				@暗視ゴーグル_初期設置 暗視ゴーグル d:ITEM_POS_11 0
				@サーマルゴーグル_初期設置 サーマルゴーグル d:ITEM_POS_03 0
			}
		}

	}



	// ------------------------------------
	// その他オブジェクト関係
	// ------------------------------------
	// 落とし穴
	// ------------------------------------
	proc 落とし穴設置 {
		#if d:DEBUG_PRINT
			print 'pitfall_set'
		#endif

		command foreach -argc 3 -repeat 4 \
			-data { \
					{ 落とし穴:01, 25000, -36000 } \
					{ 落とし穴:02, 25000, -34000 } \
					{ 落とし穴:03, 35000, -32000 } \
					{ 落とし穴:04, 37000, -32000 } \
				} \
				-exec { \
					chara ＶＲ落とし穴 $1 \
						-position $2, 0, $3 \
						-rotate 0,0,0 \
						-map ダークステージ \
						-model vr2_pitfall_a0 vr2_pitfall_a0 \
						-hazard	($2-1000), 0, ($3-1000) \	/*min maz の2点指定 */
								($2+1000), 0, ($3+1000) \
						-fall_time 40 \
						-fall_pattern 7 \
						-status 0 \
						-proc 落し穴落下時処理
				}
	}

	proc 落し穴落下時処理 {
		#if d:DEBUG_PRINT
			print 'pitfall_gameover'
		#endif

		if ( $1 == 落とし穴:01 ) {
			mesg プレイヤー d:PLAYER position 25000,$i:プレイヤー位置Ｙ,-36000
			@落下時カメラセット 25000 0 -36000
			@ジャンプ落下死発動 0x0004 -10000
			mesg ＶＲ落とし穴 落とし穴:01 fall
		} else if ( $1 == 落とし穴:02 ) {
			mesg プレイヤー d:PLAYER position 25000,$i:プレイヤー位置Ｙ,-34000
			@落下時カメラセット 25000 0 -34000
			@ジャンプ落下死発動 0x0004 -10000
			mesg ＶＲ落とし穴 落とし穴:02 fall
		} else if ( $1 == 落とし穴:03 ) {
			mesg プレイヤー d:PLAYER position 35000,$i:プレイヤー位置Ｙ,-32000
			@落下時カメラセット 35000 0 -32000
			@ジャンプ落下死発動 0x0004 -10000
			mesg ＶＲ落とし穴 落とし穴:03 fall
		} else if ( $1 == 落とし穴:04 ) {
			mesg プレイヤー d:PLAYER position 37000,$i:プレイヤー位置Ｙ,-32000
			@落下時カメラセット 35000 0 -32000
			@ジャンプ落下死発動 0x0004 -10000
			mesg ＶＲ落とし穴 落とし穴:04 fall
		}
	}

	// 落下したときに出るカメラ(落とし穴中心のＸＹＺを入力)
	proc 落下時カメラセット $:p_Ｘ $:p_Ｙ $:p_Ｚ {
		#if d:DEBUG_PRINT
			print 'fall camera set'
		#endif

		chara カメラ設定 クリア時カメラ \
			-c 0 \
			-b d:CAM_MIN,5647,($:p_Ｚ+1851)	 d:CAM_MAX,5647,($:p_Ｚ+1851) \
			-l d:CAM_MIN,1500,($:p_Ｚ+234)	 d:CAM_MAX,1500,($:p_Ｚ+234) \
			-r 766,2243,0 -f 4392 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1
	}

	// ジャンプ落下死発動から呼ばれるプロック
	proc ジャンプ落下死開始処理 {
		#if d:DEBUG_PRINT
			print 'jump_gameover_start'
		#endif

		@ゲームオーバー開始処理
	}

	// 最終的に落ちたときに呼ばれるプロック（サウンドや振動を呼ぶ）
	proc ゲームオーバー終了処理 {
	}


	// ------------------------------------
	// 光源関係
	// ------------------------------------
	// ------------------------------------
	proc フォグ設定 {
		#if d:DEBUG_PRINT
			print 'fog_set'
		#endif

		chara フォグ 霧\
			-c 0, 15, 10 \
			-n 3000 \
			-f 18000
	}
	// キャラ用光源(マップの設置が終わってから設定することで、キャラだけに光を当てる)
	// ------------------------------------
	proc キャラ用ライト設置 {
		#if d:DEBUG_PRINT
			print 'chara_light_set'
		#endif

		chara 環境光 環境光源 \
			 -c 0 20 10

		chara 平行光 平行光源 \
			 -c 0 35 30 \
			 -p -2500 -3200 -2500


		// プレイヤーの周りに光るテンプライト
		chara プロック連続実行 テンプライトチェック \
			-time -1 \
			-exec { \
				// プレイヤーが登場してから処理開始
				if ( $f:ロードチェックＯＮフラグ == 1 ) {
					command パッドチェック -which 0 -status
					if ( $status & d:PAD_Y ) {
						// 武器ボタンが押されているとき
						if ( $w:武器 == d:武器:ソコム || $w:武器 == d:武器:ＵＳＰ ) {
							$$i:テンプライトカウンタ = 0;
						} else {
							if ( $$i:テンプライトカウンタ < 60*75 ) {
								$$i:テンプライトカウンタ = $$i:テンプライトカウンタ + 1;
							}
						}
					} else {
						if ( $$i:テンプライトカウンタ < 60*75 ) {
							$$i:テンプライトカウンタ = $$i:テンプライトカウンタ + 1;
						}
					}

					if ( $$i:テンプライトカウンタ > 0 ) {
						command テンプライト プレイヤーテンプライト  \
							-p $i:プレイヤー位置Ｘ,$i:プレイヤー位置Ｙ,$i:プレイヤー位置Ｚ \
							-r $$i:テンプライトカウンタ -e ($$i:テンプライトカウンタ*2) -c 0,30,20 -f 0x0200
					}

					// さらにサーマルゴーグルか暗視ゴーグルをつけていたときはフォグのfarも変える
					if ( $w:アイテム == d:アイテム:サーマルゴーグル || $w:アイテム == d:アイテム:暗視ゴーグル ) {
						chara フォグ 霧 -c 0, 15, 10 -n 3000 -f 35000 -t 1
					} else {
						chara フォグ 霧 -c 0, 15, 10 -n 3000 -f 18000 -t 1
					}
				}
			}
	}

	// ------------------------------------
	// カメラ関係の設定 
	// ------------------------------------
	// ステージカメラ設定 
	// ------------------------------------
	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'chara_camera & stage_camera_set'
		#endif

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0 
		chara カメラ メインカメラ		-c 0 -l 2 -p 40
		chara カメラ サブカメラ			-c 0 -l 2 -p 30
		chara カメラ クリア時カメラ		-c 0 -l 0 -p 10

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \	
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 560,2048,0 \
			-f 5000 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}





// -----------------------------------------------------------------------------------
// 以下デバッグ専用proc
// -----------------------------------------------------------------------------------
// デバッグキャラ
// ------------------------------------
proc デバッグキャラセット {
	#if d:DEBUG_PRINT
		print 'debug_chara_set'
	#endif

	#if d:CHARA_CAMERA
		chara キャラカメラ 敵兵カメラ \
			-c d:TARGET_CHARA \
			-s -920,610,200 \
			-r -200,1024,0 
	#endif

	#if d:SCREENSHOT
		chara スクリーンショット shot
	#endif

