}//d

//生体センサー h //e
resource PS_生体センサー__i {
//vox t:vc212591 {
プリスキン_000: {
Stai usando il Sensore Antiuomo.
}
//	<<<ENGLISH>>>
//	You're using your Anti-Personnel
//	Sensor.
//<ページ数変更>
プリスキン_000_1: {
Vibra quando un nemico si avvicina alla
tua posizione.
}
//	<<<ENGLISH>>>
//	It vibrates whenever an enemy
//	is approaching your position.

/*生体センサーを使っているな。
それを装備すれば、敵の接近を振動で
感じ取ることが出来る。
*/
プリスキン_001: {
Il sensore risponde al campo
elettromagnetico e al battito
cardiaco degli esseri viventi.
}
//	<<<ENGLISH>>>
//	The sensor responds to the
//	electromagnetic field and
//	heartbeat of life forms.
//<ページ数変更>
プリスキン_001_1: {
Pi&`u vicino &`e il nemico e pi&`u forte vibrer&`a.
}
//	<<<ENGLISH>>>
//	The closer an enemy, the
//	bigger the vibration.

/*生体電磁波や心臓の鼓動を感知する
センサーだ。敵が接近すればするほど
振動も大きくなる。
*/
プリスキン_002: {
&`E uno strumento molto utile. Per&`o, ricorda
che quando ti equipaggi col sensore,
}
//	<<<ENGLISH>>>
//	It's a useful device.
//	But remember that if you're
//	equipped with the sensor,
//<ページ数変更>
プリスキン_002_1: {
non potrai sentire nessun'altra
vibrazione attorno a te.
}
//	<<<ENGLISH>>>
//	you won't be able to feel any
//	other vibrations around you.

/*便利な装備品だが、生体センサーを
装備している間は他の振動は感じなく
なるということは覚えておけ。
*/
プリスキン_003: {
&`E un po' come nella vita.
}
//	<<<ENGLISH>>>
//	It's like life...
//<ページ数変更>
プリスキン_003_1: {
Vinci qualcosa per poi perderne un'altra.
}
//	<<<ENGLISH>>>
//	You gain something
//	only to lose something else.
//<ページ数変更>
プリスキン_003_2: {
Sta a te decidere dove e quando usarlo.
}
//	<<<ENGLISH>>>
//	It's up to you to decide where
//	and when you want to use it.

/*何かを得れば何かを失う。人生とは
そんなものだ。状況に応じて使うか
使わないかを決めるといい。
*/
//dv}//v
}//d

//地雷探知器 h //e
resource PS_地雷探知器１__i {
//vox t:vc212601 {
プリスキン_000: {
Quel cercamine con cui
ti sei equipaggiato mostra
}
//	<<<ENGLISH>>>
//	That mine detector that you're
//	equipped with＃－
//<ページ数変更>
プリスキン_000_1: {
la posizione delle mine Claymore
invisibili a occhio nudo.
}
//	<<<ENGLISH>>>
//	displays the location of Claymore
//	mines that aren't visible to the
//	naked eye.

/*地雷探知器を装備しているな。
肉眼では見えないクレイモア地雷の
位置をレーダー上に表示する探知器だ。
*/
プリスキン_001: {
Non &`e un normale cercamine.
}
//	<<<ENGLISH>>>
//	It's not your run-of-the-mill
//	mine detector.
//<ページ数変更>
プリスキン_001_1: {
&`E il modello pi&`u nuovo ad usare
la tecnologia sviluppata in un laboratorio
μ chimico privato.
}
//	<<<ENGLISH>>>
//	It's the latest model to use
//	the technology developed in
//	a private μchem lab.

/*そいつは通常の地雷探知器ではない。
自律微少スケール化学実験室で開発
された技術を採用した最新型だ。
*/
プリスキン_002: {
Non &`e un metal detector,}
//	<<<ENGLISH>>>
//	It isn't a metal detector.
//<ページ数変更>
プリスキン_002_1: {
&`E basato pi&`u sui vari sistemi usati
nei rilevatori chimici.
}
//	<<<ENGLISH>>>
//	It's based more on the
//	various systems used
//	in chemical detectors.

/*金属探知ではなく主に化学探知器を
利用したシステムになっている。
*/
プリスキン_003: {
Per farla breve, non risponde all'involucro
metallico delle mine,
}
//	<<<ENGLISH>>>
//	In short, it doesn't respond
//	to a mine's metallic casing.
//<ページ数変更>
プリスキン_003_1: {
ma rileva invece gli elementi
usati negli esplosivi.
}
//	<<<ENGLISH>>>
//	It actually detects the elements
//	used in explosives.

/*地雷の金属ケースではなく、爆発物が
放出する爆発性分子を検出するという
ことだ。
*/
プリスキン_004: {
Essenzialmente &`e simile al sensore
che ti ha dato il vecchio...
}
//	<<<ENGLISH>>>
//	Basically, it's similar to the
//	sensor that the old man gave
//	you...
//<ページ数変更>
プリスキン_004_1: {
quello che risponde all'"odore"
delle C4.
}
//	<<<ENGLISH>>>
//	the one that responds
//	to the "smell" of C4.

/*親父さんから渡されたＣ４の『匂い』を
探知するセンサーと基本原理は同じだな。
*/
プリスキン_005: {
Ecco perch&'e puoi rilevare con precisione
la posizione delle mine,
}
//	<<<ENGLISH>>>
//	That's why you can accurately
//	detect the location of mines＃－
//<ページ数変更>
プリスキン_005_1: {
malgrado ti trovi in una struttura metallica.
}
//	<<<ENGLISH>>>
//	despite the fact that you're
//	in a metal-based structure.

/*だから俺達がいるような金属構造物の
中でも正確に地雷の位置を検出できる。
というわけだ。
*/
//dv}//v
}//d
//レーダー使用不能状態 t //e
resource PS_地雷探知器２__i {
//vox t:vc212611 {
プリスキン_000: {
Non ha senso usare il cercamine se non
attivi anche il radar.
}
//	<<<ENGLISH>>>
//	There's no point using the
//	detector without employing
//	the radar.

/*しかしレーダーを使用可能にしなければ
使っても意味がないぞ。覚えておけ。
*/
//dv}//v
}//d

//センサーＡ h //e
resource PS_センサーＡ１__i {
//vox t:vc212621 {
プリスキン_000: {
Vedo che il vecchio ti ha dato
un Sensore A.
}
//	<<<ENGLISH>>>
//	I see the old man set you
//	up with a Sensor A unit.

/*親父さんから渡されたセンサーＡを
使っているな。
*/
プリスキン_001: {
Oltre alle C4, gli esplosivi liberano
continuamente le loro particelle specifiche.
}
//	<<<ENGLISH>>>
//	Aside from C4, explosives
//	continually release their
//	own specific particles.

/*Ｃ４に限らず爆発物は特有の
爆発性分子を大気中に放出し続けている。
*/
プリスキン_002: {
Il Sensore A si basa sulla spettrometria a
mobilit&`a ionica
}
//	<<<ENGLISH>>>
//	Based on ion mobility spectrometry
//	technology,

プリスキン_002_1: {
e pu&`o rilevare i grappoli di particelle.
}
//	<<<ENGLISH>>>
//	Sensor A is capable of
//	detecting particle clusters.

/*そのセンサーＡはイオン易動性分光測定
という技術を使ってその分子クラスター
を検知する探知器だ。
*/
プリスキン_003: {
In poche parole, pu&`o "fiutare"
le C4 e trovarle.
}
//	<<<ENGLISH>>>
//	Simply put, the detector
//	can "sniff out" C4.

/*早い話がＣ４が発する『匂い』を
嗅ぎ付けるということだな。
*/
プリスキン_004: {
La C4 trovata appare sul radar come
una specie di nuvoletta,
}
//	<<<ENGLISH>>>
//	The detected C4 appears on
//	radar as a cloud-like shape.
//<ページ数変更>
プリスキン_004_1: {
che mostra la posizione approssimativa
dell'esplosivo.
}
//	<<<ENGLISH>>>
//	The cloud indicates the rough
//	location of the explosive.

/*検知された『匂い』は雲のような形で
レーダー状に表示される。Ｃ４は必ず
その近くにあるはずだ。
*/
//dv}//v
}//d
resource PS_センサーＡ２__i {
//vox t:vc212631 {
プリスキン_000: {
Questo sensore sembra sintonizzato in
modo speciale.
}
//	<<<ENGLISH>>>
//	This sensor looks like it's
//	been specially tuned.

/*このセンサーは特殊なチューニングが
施されているようだ。
*/
プリスキン_001: {
&`E stato modificato per fiutare le C4,
}
//	<<<ENGLISH>>>
//	It's been specially modified to
//	sniff out the signature odor of
//	C4＃－
//<ページ数変更>
プリスキン_001_1: {
insieme allo speciale profumo che Fatman
lascia come firma del suo lavoro.
}
//	<<<ENGLISH>>>
//	combined with Fatman's special
//	perfume that he uses to identify
//	his work.

/*ファットマンがサインとして振り掛ける
香水とＣ４の『匂い』を混合した化学
シグネチャに特化した調整だな。
*/
プリスキン_002: {
Ecco perch&'e non risponder&`a alle C4 che
hai innescato tu.
}
//	<<<ENGLISH>>>
//	That's why it won't respond to
//	any of the C4 that we've set up.

/*だから俺達がＣ４を仕掛けても
反応はしないだろう。
*/
//dv}//v
}//d
//爆弾解体後 t //e
resource PS_センサーＡ３__i {
//vox t:vc212641 {
プリスキン_000: {
L'hai usato molto, quello.
}
//	<<<ENGLISH>>>
//	We got a lot of use
//	out of this thing.

プリスキン_000_1: {
Probabilmente ora non ti servir&`a pi&`u.
}
//	<<<ENGLISH>>>
//	We probably won't need
//	it anymore.

/*充分役に立ってくれたが
もう使うことはないかも知れんな。
*/
//dv}//v
}//d

//センサーＢ h //e
resource PS_センサーＢ１__i {
//vox t:vc212651 {
プリスキン_000: {
Stai usando il Sensore B. &`E studiato per
rilevare le C4 "inodori" innescate da
Fatman.
}
//	<<<ENGLISH>>>
//	You're using Sensor B. It's designed
//	to pick out the "odorless" C4 set up
//	by Fatman.

/*センサーＢを装備しているな。
ファットマンが仕掛けた『匂い』の
しないＣ４を探知出来るセンサーだ。
*/
プリスキン_001: {
A differenza del Sensore A, che rileva
le particelle di esplosivo,
}
//	<<<ENGLISH>>>
//	Unlike Sensor A, which detects
//	explosive particles,
//<ページ数変更>
プリスキン_001_1: {
quest'unit&`a rileva l'esplosivo all'interno
di un oggetto sigillato ad emissione di
neutroni.
}
//	<<<ENGLISH>>>
//	this unit detects the explosive
//	inside an object sealed by neutron
//	emission.

/*爆発性分子を化学探知するセンサーＡ
とは違い、中性子を放射して閉鎖された物体の中の爆発物を検知する。
*/
プリスキン_002: {
Il sensore dovrebbe poter rilevare le C4
anche se queste sono state sigillate
}
//	<<<ENGLISH>>>
//	The sensor should be able to detect
//	C4, despite the fact that it's been
//	securely sealed＃－
//<ページ数変更>
プリスキン_002_1: {
con cura per risultare inodori o, per meglio
dire, fermare la diffusione delle particelle
di esplosivo.
}
//	<<<ENGLISH>>>
//	to prevent "odor" or more
//	specifically the diffusion of
//	explosive particles.

/*『匂い』、つまり爆発性分子が
拡散しないよう厳重にシールされた
Ｃ４も発見することが出来るだろう。
*/
プリスキン_003: {
Quando i neutroni attraversano un oggetto,
}
//	<<<ENGLISH>>>
//	When neutrons pass
//	through an object,
//<ページ数変更>
プリスキン_003_1: {
il materiale di idrogeno che esso contiene
interagisce per creare una retrodiffusione.
}
//	<<<ENGLISH>>>
//	the hydrogen material it contains
//	interacts to produce a rear
//	diffusion.

/*中性子は物体を通過する際、その中に
含有される水素含有物質との相互作用に
よって後方散乱を起こす。
*/
プリスキン_004: {
Misurando questa retrodiffusione
con lo strumento,
}
//	<<<ENGLISH>>>
//	By measuring this rear
//	diffusion with the detector,
//<ページ数変更>
プリスキン_004_1: {
analizzi il valore risultante per determinare
la presenza di esplosivo.
}
//	<<<ENGLISH>>>
//	the resulting value is analyzed
//	to determine the existence of
//	an explosive.

/*この後方散乱を放射線検出器で測定し、
値を分析して爆発物の存在を特定する
という仕組みだ。
*/
プリスキン_005: {
Basta che ti equipaggi con quest'unit&`a
e il sensore
}
//	<<<ENGLISH>>>
//	Simply equipping yourself with
//	this unit and the sensor＃－
//<ページ数変更>
プリスキン_005_1: {
analizza automaticamente l'area attorno
a te. Se trova esplosivo, genera un
avvertimento acustico.
}
//	<<<ENGLISH>>>
//	will automatically scan the area
//	around you, and will sound a warning
//	if there's an explosive nearby.

/*装備するだけで自動的に周囲の走査を
行ってくれる。同じエリアに爆発物を
発見すれば警告音が鳴る。
*/
プリスキン_006: {
Ricorda sempre che pi&`u frequenti
sono i segnali acustici
}
//	<<<ENGLISH>>>
//	Always remember that the shorter
//	the intervals between the warning
//	sound,
//<ページ数変更>
プリスキン_006_1: {
e pi&`u vicino ti trovi alla bomba.
}
//	<<<ENGLISH>>>
//	the closer the location
//	of the bomb.

/*警告音の間隔が短くなればそれだけ
爆弾に近づいているということだ。
覚えておけ。
*/
//dv}//v
}//d
resource PS_センサーＢ２__i {
//vox t:vc212661 {
プリスキン_000: {
Questo sensore &`e impostato per
rispondere esclusivamente alle C4
innescate da Fatman.
}
//	<<<ENGLISH>>>
//	This sensor is adjusted to respond
//	only to the C4 used by Fatman.

/*このセンサーはファットマンの使う
Ｃ４にしか反応しないように調整して
あるらしい。
*/
プリスキン_001: {
La composizione delle nostre C4 e di
quelle di Fatman sembra leggermente
diversa.
}
//	<<<ENGLISH>>>
//	The composition of our C4 and
//	that of Fatman's seems to be
//	slightly different.
//<ページ数変更>
プリスキン_001_1: {
Penso che sia la cera che usa per
i suoi esplosivi.
}
//	<<<ENGLISH(2)>>>
//	I think it may be the wax materials
//	that he uses in his explosives.

/*ファットマンが使うＣ４と俺達が使う
Ｃ４の組成は微妙に異なるようだ。多分
ワックスの材質か何かが違うんだろう。
*/
プリスキン_002: {
Probabilmente il vecchio ha dedicato la
maggior parte del suo tempo ad apportare
questa modifica.
}
//	<<<ENGLISH(2)>>>
//	The old man probably concentrated
//	the bulk of his time on making this
//	modification.

/*親父さんが調整に時間をかけていたのは
このあたりだったのかもしれんな。
*/
//dv}//v
}//d
resource PS_センサーＢ３__i {
//vox t:vc212671 {
プリスキン_000: {
Ma visto che abbiamo sistemato
tutte le C4
}
//	<<<ENGLISH>>>
//	However, since we've taken
//	care of all the C4,
//<ページ数変更>
プリスキン_000_1: {
e che Fatman non &`e pi&`u fra noi...
}
//	<<<ENGLISH>>>
//	and given the fact that Fatman
//	is no longer with us...
//<ページ数変更>
プリスキン_000_2: {
non penso che questo sensore ci servir&`a
pi&`u.
}
//	<<<ENGLISH>>>
//	I don't think we'll need
//	this sensor anymore.

/*だがＣ４は全て処理し終わっているし、
ファットマンももういない。
このセンサーを使う必要はないだろう。
*/
//dv}//v
}//d

//双眼鏡 h //e
resource PS_双眼鏡１__i {
//vox t:vc212681 {
プリスキン_000: {
Quel binocolo &`e un modello militare di
qualit&`a, con funzioni di auto-focus e zoom.
}
//	<<<ENGLISH>>>
//	That pair of binoculars is a
//	high-end military model with
//	auto-focus and zoom features.

