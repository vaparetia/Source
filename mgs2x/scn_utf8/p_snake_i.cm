resource PS_網膜センサー＿羽交い絞め２__i {
//vox t:vc210071 {
プリスキン_000: {
Perch&'e non stringi un nemico in una morsa
e lo trascini fino al sensore?
}
//	<<<ENGLISH>>>
//	Why don't you put one in
//	a chokehold and drag him
//	over to the sensor?

/*首絞めで捕まえてセンサーまで
引きずっていったらどうだ？*/
//dv}//v
}//d

//シェル２中央棟１Ｆノード位置 h //e
resource PS_シェル２中央棟１Ｆ＿ノード位置__i {
//vox t:vc210081 {
プリスキン_000: {
Raiden, il nodo per quell'area &`e all'interno
di una stanzetta a nord ovest. Ti conviene
collegarti.
}
//	<<<ENGLISH>>>
//	Raiden, the node for that area
//	is inside a small room to the
//	northwest. You'd better log in.

/*ライデン、そのエリアのノードは
北西にある小部屋の中だ。アクセスして
おいた方がいいだろうな。*/
//dv}//v
}//d

//シェル２中央棟Ｂ１ d //e
//水中 h //e
//Ｂ１の地形 t //e
resource PS_シェル２中央棟Ｂ１＿水中レーダー使え１__i {
//vox t:vc210091 {
プリスキン_000: {
&`E difficile capire la planimetria della zona
quando &`e sommersa. Ti conviene attivare
il radar.
}
//	<<<ENGLISH>>>
//	It's hard to gauge the layout of
//	the area when it's underwater.
//	You'd better enable the radar.

/*水中では地形の把握が難しい。
レーダーを使えるようにしておいた方が
いいだろうな。*/
//dv}//v
}//d
//ノード位置 t //e
resource PS_シェル２中央棟Ｂ１＿水中レーダー使え２__i {
//vox t:vc210101 {
プリスキン_000: {
Il nodo per quell'area &`e proprio accanto
all'ascensore. Vedi di collegarti.
}
//	<<<ENGLISH>>>
//	The node for that area is right near
//	the elevator. Make sure you log in.

/*そのエリアのノードはエレベータの
すぐ近くにある。必ずアクセスして
おくんだ。*/
//dv}//v
}//d
//水中機雷 h //e
resource PS_シェル２中央棟＿水中機雷１__i {
//vox t:vc210111 {
プリスキン_000: {
Raiden, attento a quella mina sommersa.
}
//	<<<ENGLISH>>>
//	Raiden, watch out for
//	that underwater mine.
//<ページ数変更>
プリスキン_000_1: {
Esplode a contatto, quindi vedi di evitarla.
}
//	<<<ENGLISH>>>
//	It'll detonate on contact,
//	so make sure you avoid it.

/*ライデン、水中機雷に気をつけろ。
触れると爆発するぞ。機雷をよけて
泳ぐんだ。
*/
//dv}//v
}//d
//一回目のみ t //e
resource PS_シェル２中央棟＿水中機雷２__i {
//vox t:vc210121 {
ライデン_000: {
Perch&'e ci sarebbe una mina qui?
}
//	<<<ENGLISH>>>
//	Why would there be a mine here?

/*なぜこんなところに水中機雷があるんだ？*/
プリスキン_001: {
Perch&'e qualcuno ce l'ha messa.
}
//	<<<ENGLISH>>>
//	Because someone planted one.

/*誰かが仕掛けたからだろう。*/
オタコン_002: {
E quel tipo che correva sull'acqua?
Magari &`e stato lui.
}
//	<<<ENGLISH>>>
//	What about that guy who was
//	running on water? Could have
//	been him.

/*あいつじゃないか？
水面を走っていた男……。*/
プリスキン_003: {
Guardati le spalle. Potrebbe cercare
di tenderti un'imboscata.
}
//	<<<ENGLISH>>>
//	You'd better watch your back.
//	He may be waiting to ambush.

/*気をつけたほうがいいな。
待ち伏せしているかもしれん。*/
ライデン_004: {
Okay...
}
//	<<<ENGLISH(2)>>>
//	OK...

/*……ああ……。*/
//dv}//v
}//d
//エマ居場所 h //e
resource PS_シェル２中央棟Ｂ１＿エマ居場所１__i {
//vox t:vc210131 {
プリスキン_000: {
Probabilmente Emma &`e nella Camera
di Filtrazione 2 al piano B1 del centro
di Shell 2.
}
//	<<<ENGLISH>>>
//	Emma's probably being kept in
//	Filter Chamber No. 2 on Floor
//	B1 of Shell 2's core.

/*エマが捕らわれているのは
おそらくシェル２中央棟Ｂ１の
第二濾過室だろう。*/
//dv}//v
}//d
//Ｂ１にいる t //e
resource PS_シェル２中央棟Ｂ１＿エマ居場所２__i {
//vox t:vc210141 {
プリスキン_000: {
&`E nella parte nord est del piano
in cui ti trovi ora.
}
//	<<<ENGLISH>>>
//	It's in the northeast section
//	of the floor you're on.

/*お前がいるフロアの北東部だ。*/
//dv}//v
}//d
//Ｂ１北にいる t //e
resource PS_シェル２中央棟＿南西行け１__i {
//vox t:vc210151 {
プリスキン_000: {
Vacci da sud. Cos&`i dovresti riuscire a
raggiungerla.
}
//	<<<ENGLISH>>>
//	Go around from the south and
//	you should be able to reach her.

/*南の方からまわっていけば辿り着ける
はずだ。*/
//dv}//v
}//d
resource PS_シェル２中央棟＿南西行け２__i {
//vox t:vc210161 {
プリスキン_000: {
Inizia nuotando verso sud.
}
//	<<<ENGLISH>>>
//	Start out by swimming south.

/*まずは南の方に泳いで行くんだ。*/
//dv}//v
}//d
//Ｂ１南にいる t //e
resource PS_シェル２中央棟＿西行け１__i {
//vox t:vc210171 {
プリスキン_000: {
Nuota pi&`u ad ovest che puoi. Quindi
dirigiti a nord e dovresti arrivare alla
Camera di filtrazione 2.
}
//	<<<ENGLISH>>>
//	Swim as far west as you can.
//	Then head north and you should
//	reach Filter Chamber No. 2.

/*そこから西の方に泳いで行くんだ。
突き当たりを北に向かえば
第二濾過室に出られるはずだ。*/
//dv}//v
}//d
//Ｂ１南西にいる t //e
resource PS_シェル２中央棟＿北行け１__i {
//vox t:vc210181 {
プリスキン_000: {
La Camera di Filtrazione 2 deve essere a
nord di dove ti trovi. Dirigiti in quella
direzione.
}
//	<<<ENGLISH(2)>>>
//	Filter Chamber No. 2 should be
//	just north of your present location.
//	Head northward.

/*第二濾過室はその北だ。
北に向かえ。*/
//dv}//v
}//d




//Ｅ脚狙撃後 h //e
//エマ血痕近く h //e
resource PS_Ｅ脚＿エマ血痕__i {
//vox t:vc210191 {
ライデン_000: {
Snake - quanto sono gravi
le ferite di Emma...?
}
//	<<<ENGLISH>>>
//	Snake -- how bad are
//	Emma's injuries...?

/*スネーク……エマの怪我は……。*/
プリスキン_001: {
&`E proprio come pensi.
}
//	<<<ENGLISH>>>
//	It's about what you'd expect.

/*見ての通りだ。*/
ライデン_002: {
...
}
/*……。*/
プリスキン_003: {
Sbrigati.
}
//	<<<ENGLISH>>>
//	Just hurry.

/*急いでくれ。*/
//dv}//v
}//d


//ストーリー依存 d //e
//★P010_10_P05ヴァンプ遭遇１０ポリゴンデモ５終了＜フラグ＜P012_01_P01フォーチュン遭遇１ポリゴンデモ１開始 d //e
//寝ている h //e
resource PS_寝ている１__i {
//vox t:vc210201 {
プリスキン_000: {
Zzzz...
}
//	<<<ENGLISH(2)>>>
//	Zzzz...

/*ＺＺｚｚ……。*/
//dv}//v
}//d
resource PS_寝ている２__i {
//vox t:vc210211 {
ライデン_000: {
Ma - dorme?
}
//	<<<ENGLISH>>>
//	He's -- asleep?

/*寝てるのか……？*/
//dv}//v
}//d

//寝ているつっこみ h //e
resource PS_寝ている３__i {
//vox t:vc210221 {
ライデン_000: {
Per quanto dormir&`a ancora questo qui...?
}
//	<<<ENGLISH>>>
//	How much longer is this
//	guy going to sleep...?

/*いつまで寝てるつもりだ……？*/
//dv}//v
}//d
//寝ているつっこみ h //e
resource PS_寝ている４__i {
//vox t:vc210231 {
ライデン_000: {
Vorrei essere rilassato come lui...
}
//	<<<ENGLISH>>>
//	Wish I were that relaxed...

/*呑気なものだ……。*/
//dv}//v
}//d
//寝ているつっこみ h //e
resource PS_寝ている５__i {
//vox t:vc210232 {
プリスキン_000: {
mmm... pof pof... nnnn...
}

/*……むにゃむにゃ……*/
ライデン_001: {
... sta ancora dormendo...
}
//	<<<ENGLISH>>>
//	... he's still sleeping...



/*……まだ寝ている……*/
プリスキン_002: {
Liquid!!
}
/*……リキッドォ！*/
ライデン_003: {
Eh?
}
//	<<<ENGLISH(2)>>>
//	Huh?

/*え？*/
プリスキン_004: {
...zzz...
}
/*……Ｚｚｚｚ……。*/
//dv}//v
}//d

//★P012_02_R01フォーチュン遭遇２無線デモ１終了＜フラグ＜P014_01_P01ピーター遭遇１ポリゴンデモ１開始 d //e
//寝ている間に通信した場合 h //e
resource PS_寝ている間に通信した__i {
//vox t:vc210241 {
ライデン_000: {
Buongiorno, Tenente J.G. Pliskin.
Dormito bene?
}
//	<<<ENGLISH>>>
//	Good morning, Lieutenant J.G.
//	Pliskin. Did you sleep well?

/*おはよう、プリスキン中尉。
良いお目覚めで。*/
プリスキン_001: {
S&`i, grazie. Mi sento benone,
molto meglio di prima.
}
//	<<<ENGLISH>>>
//	Yeah, thank you. I'm good,
//	feeling much better.

/*ああ……。ありがとう。
体調も戻った。
もう大丈夫だ。*/
//dv}//v
}//d



//フォーチュンの設定 h //e
resource PS_フォーチュン＿死なない__i {
//vox t:vc210251 {
ライデン_000: {
Perch&'e quella donna non muore?
}
//	<<<ENGLISH>>>
//	Why won't that woman die?

/*あの女、なぜ死なない？*/
プリスキン_001: {
Non sai quanto lo desideri. Accoglierebbe
la morte a braccia aperte, se soloquesto
potesse liberarla.
}
//	<<<ENGLISH(2)>>>
//	She yearns for death. She would
//	welcome it with open arms if it
//	came to set her free.

/*あの女は死を歓迎している。
死が自分を開放しにくる時を
待ち望んでいるんだ。*/
プリスキン_002: {
Quelli che non hanno paura della morte,
finiscono per evitarla.
}
//	<<<ENGLISH>>>
//	People who have no fear of
//	death end up eluding it.
//<ページ数変更>
プリスキン_002_1: {
Pi&`u terrore hai di morire
e pi&`u vicino ci vai.
}
//	<<<ENGLISH>>>
//	And the more terrified you are of
//	dying, the closer you find yourself
//	to it.

/*死への恐怖がない人間程、生へ近づく。
死を恐れれば、それだけ死に近づく。
*/
//dv}//v
}//d


//眠りプリスキンを殴っている場合 h //e
resource PS_睡眠中殴られた１__i {
//vox t:vc210261 {
プリスキン_000: {
Proprio ora che stavo dormendo
- Tu per caso -
}
//	<<<ENGLISH>>>
//	While I was sleeping just
//	now -- Did you --

/*お前……さっき俺が休んでる間……。*/
ライデン_001: {
Eh -- !?
}
//	<<<ENGLISH>>>
//	Uh -- !?

/*え！？*/
プリスキン_002: {
Pfff. Lasciamo perdere.
}
//	<<<ENGLISH>>>
//	Hmph. Forget it.

/*ふん。まあいい。*/
ライデン_003: {
Fiuuu...
}
//	<<<ENGLISH>>>
//	(Phew) ...



/*……。（ほっ）*/
//dv}//v
}//d


//★P014_16_G01ピーター遭遇１６ゲーム１終了＜フラグ＜P015_01_R1爆弾解体最初の一つ１無線デモ１開始 d //e
//爆弾解体ヒント１ h //e
resource PS_爆弾解体中＿敵排除のススメ１＿１__i {
//vox t:vc210271 {
プリスキン_000: {
Raiden, non ti stressare. &`E pi&`u sicuro
eliminare prima il nemico e poi mettersi a
cercare la bomba.
}
//	<<<ENGLISH>>>
//	Raiden, don't get yourself worked
//	up. It's safer to take out the enemy
//	first, then look for the bomb.

/*ライデン、焦るんじゃないぞ。
先に敵を倒してそれから爆弾を
探す方が安全だ。*/
//dv}//v
}//d

resource PS_爆弾解体中＿敵排除のススメ１＿２__i {
//vox t:vc210281 {
プリスキン_000: {
Non pensare minimamente a cercare la
bomba mentre ti guardi le spalle dal
nemico.
}
//	<<<ENGLISH>>>
//	Don't even think about searching
//	for the bomb while looking over
//	your shoulder for the enemy.

/*敵を警戒しながら、爆弾を探す
なんてことは考えない方がいい。*/
プリスキン_001: {
Prima tramortiscili, oppure falli
direttamente fuori.
}
//	<<<ENGLISH>>>
//	Knock them unconscious or
//	take them out altogether first.

/*敵を眠らせるなり、倒すなりして、
排除しておくんだ。*/
//dv}//v
}//d

//爆弾解体ヒント２ h //e
resource PS_爆弾解体中＿敵排除のススメ２__i {
//vox t:vc210291 {
プリスキン_000: {
Sembra che le sentinelle nemiche
controllino i perimetri difensivi di
tutti i supporti.
}
//	<<<ENGLISH(2)>>>
//	Looks like the enemy sentries have
//	the defensive perimeters of each
//	strut covered.

/*敵の見張りは各脚の守備範囲を
受け持っているようだ。*/
プリスキン_001: {
Sarai al sicuro se non chiamano rinforzi,
ma se ti vedono, taglia la corda.
}
//	<<<ENGLISH>>>
//	You'll be safe as long as they
//	don't radio for more men, but
//	if you're spotted, run for it.
//<ページ数変更>
プリスキン_001_1: {
Trovati un buon nascondiglio e aspetta
finch&'e i rinforzi non se ne saranno
andati.
}
//	<<<ENGLISH>>>
//	Find a good concealment and
//	wait until the backup leaves.

/*無線連絡されない限り安全だが、
発見されたらすぐに逃げろ。どこかに
身を潜めて、増援部隊をやり過ごすんだ。
*/
プリスキン_002: {
Non potrai disinnescare le bombe mentre
il nemico ti sta alle calcagna, credimi.
}
//	<<<ENGLISH>>>
//	You won't be able to defuse the
//	bombs while you're being chased
//	down, believe me.

/*敵に追われながら爆弾を処理するなんて
お前には無理な話だろう。*/
//dv}//v
}//d


//爆弾解体催促 h //e
resource PS_爆弾解体中＿催促１__i {
//vox t:vc210301 {
プリスキン_000: {
Raiden, ho neutralizzato la prima bomba.
Tu come procedi?
}
//	<<<ENGLISH>>>
//	Raiden, I've frozen the first
//	bomb. How are you doing?

/*ライデン、１つ目の爆弾を凍結した！
そっちは？*/
ライデン_001: {
Finora niente...
}
//	<<<ENGLISH>>>
//	Nothing yet...

/*まだだ……。*/
ピーター_002: {
Pliskin, qual &`e l'esatta posizione
dell'esplosivo?
}
//	<<<ENGLISH>>>
//	Pliskin, what was the exact
//	location of the explosive?

/*プリスキン、爆弾の設置されていた
状況を教えてくれ。*/
プリスキン_003: {
L'eliporto. Si trovava dietro
a un carico.
}
//	<<<ENGLISH>>>
//	The heliport on Strut H.
//	It was behind some cargo.
//<ページ数変更>
プリスキン_003_1: {
Pensavo che avrei avuto problemi con
le pattuglie, invece &`e stato facile.
}
//	<<<ENGLISH>>>
//	Thought I was going to have
//	some trouble with the patrols,
//	but it was an easy job.

/*Ｈ脚のヘリポート。荷物の影に
仕掛けられていた。
見張りが厄介だったが、楽勝だった。
*/
ピーター_004: {
Capisco...
}
//	<<<ENGLISH>>>
//	I see...

/*そうか……。（なにかおかしい）*/
プリスキン_005: {
Che c'&`e?
}
//	<<<ENGLISH(2)>>>
//	What's the matter?

/*どうかしたのか？*/
ピーター_006: {
Niente, niente.
Pliskin, tu non abbassare la guardia.
}
//	<<<ENGLISH>>>
//	Nothing, really. Pliskin, just
//	don't let your guard down.
//<ページ数変更>
ピーター_006_1: {
Non rilassarti, anche quando pensi di
aver disinnescato le bombe.
}
//	<<<ENGLISH>>>
//	Don't relax even after you
//	think you've defused it.

/*
いや。なんでもない。
プリスキン、気を抜くなよ。
解体後の安心感は禁物だ。
*/
プリスキン_007: {
Lo so. Raiden, Shell 1 &`e tutta tua.
}
//	<<<ENGLISH>>>
//	I know that. Raiden,
//	Shell 1's all yours.

/*わかってる。
ライデン、シェル１を頼むぞ。*/
ライデン_008: {
Sicuro...
}
//	<<<ENGLISH>>>
//	Sure...

/*ああ……。*/
//dv}//v
}//d


