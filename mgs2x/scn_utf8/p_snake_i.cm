}
//	<<<ENGLISH>>>
//	You can find the locker room
//	where Emma is to the northwest
//	of the flooded area. Go!

/*エマのいるロッカールームは
その浸水したエリアの北西にあたる。
急げ！*/
//dv}//v
}//d

//エマ助けろロッカー部屋 h //e
//一回目のみ t //e
resource PS_ヴァンプ戦後＿エマ助けろ＿ロッカー部屋１__i {
