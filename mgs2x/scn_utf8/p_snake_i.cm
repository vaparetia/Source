//刀の説明 h //e
resource PS_刀説明１__i {
//vox t:vc211081 {
プリスキン_000: {
Usa la levetta analogica destra
per controllare la spada.
}
//	<<<ENGLISH>>>
//	Use the right analog stick
//	to control the blade.
//<ページ数変更>
プリスキン_000_1: {
Sposta la leva in su/gi&`u per un fendente
verso l'alto/il basso, o a sinistra/destra
per un fendente orizzontale.
}
//	<<<ENGLISH>>>
//	Move the stick up and down to
//	swish up or down, and left and
//	right to slice the blade horizontally.

/*刀の操作は右スティックを使う。
