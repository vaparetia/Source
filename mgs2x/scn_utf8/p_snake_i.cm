resource PS_刀説明３__i {
//vox t:vc211101 {
プリスキン_000: {
Spingi in avanti la levetta analogica
destra per affondare.
}
//	<<<ENGLISH>>>
//	Push the right analog stick
//	forward to get a stabbing
//	strike.
//<ページ数変更>
プリスキン_000_1: {
Ci&`o ha una portata e una potenza maggiori
degli attacchi normali, ma ti espone di pi&`u
al contrattacco nemico.
}
//	<<<ENGLISH>>>
//	It has more reach and power than
//	normal strikes, but you're also
//	more open to counterattacks.
//<ページ数変更>
プリスキン_000_2: {
Valuta bene i pro e i contro.
}
//	<<<ENGLISH>>>
//	Weigh the pros and cons well.

/*右スティックを押し込めば突きが出せる。
