meglio attorno.
}
//	<<<ENGLISH>>>
//	I can't believe Emma managed
//	to get out of that room by herself.
//	Take a more thorough look around.

/*エマがその部屋から自力で逃げ出した
とは思えん。よく調べてみるんだ。*/
//dv}//v
}//d
//心音を聞いた h //e
//一回目のみ t //e
resource PS_ヴァンプ戦後＿ロッカー部屋＿心音__i {
//vox t:vc210881 {
ライデン_000: {
Sento un rumore venire dall'armadietto...
}
//	<<<ENGLISH>>>
//	I hear something
//	inside a locker...

/*ロッカーの中から音がする……。*/
