プリスキン_001_1: {
compresi gli stivali.
}
//	<<<ENGLISH>>>
//	you've got the exact same gear
//	as they have -- including those
//	boots.

/*だがスカルキャップがなくなっただけで
他は全く同じ装備だとも言える……。
