//dv}//v
}//d

//ＤＧ連絡橋以外 h //e
resource PS_ＤＧ連絡橋以外__i {
//vox t:vc210511 {
プリスキン_000: {
Per arrivare a Shell 2 dovrai disattivare i
sensori agli IR sul ponte di
}
//	<<<ENGLISH>>>
//	In order to get to Shell 2, you'll
//	have to disable the IR sensors
//	on the connecting bridge＃－
//<ページ数変更>
プリスキン_000_1: {
collegamento fra Shell 1 e Shell 2.
}
//	<<<ENGLISH>>>
//	between Shells 1 and 2.

/*シェル２に渡るにはシェル１シェル２
連絡橋の赤外線センサーを無効にする
しかない。
*/
//dv}//v
}//d
//ＰＳＧ１ある場合 t //e
resource PS_ＤＧ連絡橋以外＿ＰＳＧ１ある__i {
//vox t:vc210521 {
プリスキン_000: {
Usa il PSG1 per eliminare le unit&`a
di controllo dei sensori agli IR.
}
//	<<<ENGLISH>>>
//	Use your PSG1 to take out
//	the IR sensors' control units.
//<ページ数変更>
