}
//	<<<ENGLISH>>>
//	Raiden, the odorless C4's should
//	be at the bottom of Strut A. Head
//	to Strut A's bottom level now!

/*ライデン、無臭のＣ４はＡ脚底部らしい。
Ａ脚底部に急げ！*/
//dv}//v
}//d

//★P043_01_S01シェル１シェル２連絡橋２シナリオデモ１終了＜フラグ＜P044_01_R01赤外線センサークリア１無線デモ１開始 d //e
//ＰＳＧ１ h //e
//弾が届かんはウソ？ＸＸＸＸＸＸＸＸ
resource PS_ＤＧ連絡橋＿ＰＳＧ１使え__i {
//vox t:vc210481 {
プリスキン_000: {
Non cercare di sparare alle unit&`a di
controllo con la pistola se sei troppo
distante.
}
//	<<<ENGLISH>>>
//	Don't try to shoot out control
//	units with the handgun when
//	the distance is too great.
//<ページ数変更>
プリスキン_000_1: {
L'arma non ha un raggio d'azione cos&`i
lungo. Usa il fucile di precisione.
}
//	<<<ENGLISH>>>
//	The weapon doesn't have that
//	kind of range. Use the sniper
//	rifle.

/*遠くにある制御装置をハンドガンで
撃つのは無理だ。弾が届かん。
狙撃用ライフルを使え。
*/
//dv}//v
}//d
