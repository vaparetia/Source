ライデン_000: {
Snake, non vedo Emma...
}
//	<<<ENGLISH>>>
//	Snake, I don't see Emma...

/*スネーク、エマの姿が見当たらない……。*/
オタコン_001: {
E.E....
}
/*ＥＥ……。*/
//dv}//v
}//d
resource PS_ヴァンプ戦後＿ロッカー部屋２__i {
//vox t:vc210871 {
プリスキン_000: {
Stento a credere che Emma sia riuscita a
