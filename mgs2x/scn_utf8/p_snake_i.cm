Ce n'era una piuttosto in alto, sul soffitto.
}
//	<<<ENGLISH>>>
//	There was one planted pretty
//	high up, on the ceiling.
//<ページ数変更>
プリスキン_000_1: {
Lo spray refrigerante non la raggiungeva,
quindi ho dovuto arrampicarmi e farlo da l&`i.
}
//	<<<ENGLISH>>>
//	The coolant spray couldn't
//	reach that far, so I had to
//	get up on a stand and do it.

/*天井の高いところに仕掛けられていた。
冷却スプレーが届かなくてな。台の上に
乗って冷却した。
*/
//dv}//v
}//d

