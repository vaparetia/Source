//=============================================================================
// include
//=============================================================================

#include "varinit.h"
#include "sload.h"

#include "ms_sel.rsc"



//=============================================================================
// メイン
//=============================================================================

//デバッグ用のコードです


command メニュー設定 -pause off

chara 2Dレイアウトドライバ ２ＤＬＤ
print '$s:直前のエリア' $s:直前のエリア 
if( $f:ＶＲ／スネークテイルズロードフラグ != 0 ) {
	$f:ＶＲ／スネークテイルズロードフラグ = 0;
	@load_snake_tales
} else if( $w:現ステージ番号 == d:ステージ名:スネークテイルズＡクリア || \
	$w:現ステージ番号 == d:ステージ名:スネークテイルズＢクリア || \
	$w:現ステージ番号 == d:ステージ名:スネークテイルズＣクリア || \
	$w:現ステージ番号 == d:ステージ名:スネークテイルズＤクリア || \
	$w:現ステージ番号 == d:ステージ名:スネークテイルズＥクリア ) {
	@スタッフロール
} else {
	@セレクト画面
}

proc セレクト画面 {

	chara スネークテイルズセレクト スネークテイルズセレクト君 \
		-proc	ステージロードプロック１ \
				ステージロードプロック２ \
				ステージロードプロック３ \
				ステージロードプロック４ \
				ステージロードプロック５ \
		-fclear	$f:テイルズＡクリアしたフラグ \
				$f:テイルズＢクリアしたフラグ \
				$f:テイルズＣクリアしたフラグ \
				$f:テイルズＤクリアしたフラグ \
				$f:テイルズＥクリアしたフラグ \
		-cursor 0 \
		-exit   ＥＸＩＴプロック
}

proc ステージロードプロック１ {
	print 'stage load proc 1'
	@テイルズ変数初期化
	@load_tales_a
}
proc ステージロードプロック２ {
	print 'stage load proc 2'
	@テイルズ変数初期化
	@load_tales_b
}
proc ステージロードプロック３ {
	print 'stage load proc 3'
	@テイルズ変数初期化
	@load_tales_c
}
proc ステージロードプロック４ {
	print 'stage load proc 4'
	@テイルズ変数初期化
	@load_tales_d
}
proc ステージロードプロック５ {
	print 'stage load proc 5'
	@テイルズ変数初期化
	@load_tales_e
}

proc ＥＸＩＴプロック {
	print 'exit proc'

	$f:スネークテイルズフラグ = d:TRUE;
	@mv_init_n_title_0;
}

/////////////////////////////////////
// スタッフロール・セーブ確認・セーブ

proc スタッフロール {
	$$b:スタッフロール終了判定 = 0;
	local $$:titlename;
	local $$:telopname;

	$$:telopname = ending_st_e;

	command パッド操作 -release

 	if( $w:現ステージ番号 == d:ステージ名:スネークテイルズＡクリア ) {
		$$:titlename = titlea_st_e;
		command Stream t:vc031001 -p スタッフロール終了
	} else if( $w:現ステージ番号 == d:ステージ名:スネークテイルズＢクリア ) {
		$$:titlename = titleb_st_e;
		command Stream t:vc031001 -p スタッフロール終了
	} else if( $w:現ステージ番号 == d:ステージ名:スネークテイルズＣクリア ) {
#ifdef PSX2
		$$:titlename = titlec_st_e;
		command Stream t:vc031001 -p スタッフロール終了
#else
		$$:titlename = titlec_st_e;
		$$:telopname = ending_st_sp_e;
		command Stream t:vc031003 -p スタッフロール終了
#endif
	} else if( $w:現ステージ番号 == d:ステージ名:スネークテイルズＤクリア ) {
#ifdef PSX2
		$$:titlename = titled_st_e;
		command Stream t:vc031001 -p スタッフロール終了
#else
		$$:titlename = titled_st_e;
		$$:telopname = ending_st_sp_e;
		command Stream t:vc031003 -p スタッフロール終了
#endif
	} else {
		$$:titlename = titlee_st_e;
		command Stream t:vc031002 -p スタッフロール終了
	}

	chara エンディング name -telop $$:telopname -proc スタッフロール終了 -n $$:titlename 240 -s 11
}

proc スタッフロール終了 {
	$$b:スタッフロール終了判定 = $$b:スタッフロール終了判定 + 1;
	if( $$b:スタッフロール終了判定 == 2 ) {
		command パッド操作 -cancel
		@リザルト画面表示
	}
}

proc リザルト画面表示 {
	chara 結果画面 テールズ結果 -n セーブしますか？ 
}

proc セーブしますか？{
	chara セーブ確認画面 セーブ確認 \
		-p セーブダイアログ表示 \
		-s セーブ確認文
}

proc セーブダイアログ表示 $:result {
	if ( $:result == 0 ) {
		command セーブ用参照変数登録 $b:tales_story_no \
			$f:テイルズＡクリアしたフラグ \
			$f:テイルズＢクリアしたフラグ \
			$f:テイルズＣクリアしたフラグ \
			$f:テイルズＤクリアしたフラグ \
			$f:テイルズＥクリアしたフラグ
		chara セーブゲーム画面マネージャー セーブ画面 \
			-d save_load \
			-p セーブダイアログ表示終了 \
			-m d:SAVE_LOAD_MODE_SNAKE_TALES \
			-i sub_sticon
	} else {
		@セーブダイアログ表示終了 1
	}
}

proc セーブダイアログ表示終了 $:返り値 {
	if( $:返り値 != 0 ){
		@セレクト画面
	} else {
		@セーブしますか？
	}
}


//////////////////////////
// スネークテイルズロード

// もともとn_titleにあったけど引越しました（n_titleでメモリ不足）

proc load_snake_tales {
	// セーブファイルがあるかどうかチェック
	chara セーブファイル個数チェック check -m d:SAVE_LOAD_MODE_SNAKE_TALES -p ロードしますか？
}

proc ロードしますか？ $:result {

	// ロードしますか?画面
	if( $:result > 0 ) {
		chara セーブ確認画面 セーブ確認 \
			-p スネークテイルズロード画面表示
	} else {
		@セレクト画面
	}
}

proc スネークテイルズロード画面表示 $:result {
	// ロード画面

	if( $:result == 0 ) {
		chara delay 終了ディレイ -time 3 -exec {	// メモリ解放待ち
			chara ロードゲーム画面マネージャー ロードゲーム画面起動 \
				-d save_load \
				-p ロードＳＴ終了プロシージャー \
				-m d:SAVE_LOAD_MODE_SNAKE_TALES
		}
	} else {
		@セレクト画面
	}
}

proc ロードＳＴ終了プロシージャー $:返り値 {
	if( $:返り値 == 1 ) {
		// クリアデータなら st_select に飛ぶ
		eval ( $w:現ステージ番号 = `%save_var_read $w:現ステージ番号` );
		if( $w:現ステージ番号 >= d:ステージ名:スネークテイルズＡクリア && \
			$w:現ステージ番号 <= d:ステージ名:スネークテイルズＥクリア ) {
			command store_loadedvar
			eval( $w:現ステージ番号 = 0 );
			@load_tales_select
		} else {
			chara delay 終了ディレイ -time 1 -exec {	// サウンドマネージャーが死ぬ前にメッセージを送るため
				command load_restart
			}
		}
	} else {
		@load_tales_select
	}
}

proc テイルズ変数初期化 {
	
	$$f:テイルズＡクリアしたフラグ = $f:テイルズＡクリアしたフラグ;
	$$f:テイルズＢクリアしたフラグ = $f:テイルズＢクリアしたフラグ;
	$$f:テイルズＣクリアしたフラグ = $f:テイルズＣクリアしたフラグ;
	$$f:テイルズＤクリアしたフラグ = $f:テイルズＤクリアしたフラグ;
	$$f:テイルズＥクリアしたフラグ = $f:テイルズＥクリアしたフラグ;
	
	command 変数初期化
	
	$f:テイルズＡクリアしたフラグ = $$f:テイルズＡクリアしたフラグ;
	$f:テイルズＢクリアしたフラグ = $$f:テイルズＢクリアしたフラグ;
	$f:テイルズＣクリアしたフラグ = $$f:テイルズＣクリアしたフラグ;
	$f:テイルズＤクリアしたフラグ = $$f:テイルズＤクリアしたフラグ;
	$f:テイルズＥクリアしたフラグ = $$f:テイルズＥクリアしたフラグ;
}