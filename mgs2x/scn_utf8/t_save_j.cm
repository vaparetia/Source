//●ＳＡＶＥメニューが出る前 d//e
//・普通 h//e
resource TO_ＳＡＶＥ前普通１{
オタコン_000: {
＃｛記録、セーブ｝＃するかい、スネーク？
}
}//d

resource TO_ＳＡＶＥ前普通２{
オタコン_000: {
＃｛記録、セーブ｝＃だね？
}
}//d

resource TO_ＳＡＶＥ前普通３ {
オタコン_000: {
ああ、＃｛記録、セーブ｝＃だね？
すぐ準備する。
}
}//d

resource TO_ＳＡＶＥ前普通４ {
オタコン_000: {
スネーク、＃｛記録、セーブ｝＃したいのかい？
}
}//d


//・緊迫状態 h//e
resource TO_ＳＡＶＥ前緊迫１ {
オタコン_000: {
＃｛記録、セーブ｝＃だね、スネーク？
}
}//d

resource TO_ＳＡＶＥ前緊迫２ {
オタコン_000: {
大丈夫かい、スネーク？
＃｛記録、セーブ｝＃の準備ならできてるよ？
}
}//d

resource TO_ＳＡＶＥ前緊迫３ {
オタコン_000: {
スネーク！無事かい？
＃｛記録、セーブ｝＃ならすぐできるよ！
}
}//d

resource TO_ＳＡＶＥ前緊迫４ {
オタコン_000: {
スネーク！
＃｛記録、セーブ｝＃かい？
}
}//d




//記録するメニューを選ばなかった場合  h//e
//普通 //e
resource TO_未セーブ終了普通１ {
//ns
オタコン_000: {
じゃあね、スネーク。
}
}//d

resource TO_未セーブ終了普通２ {
//ns
オタコン_000: {
がんばってくれよ。
}
}//d

resource TO_未セーブ終了普通３ {
//ns
オタコン_000: {
何だ、＃｛記録、セーブ｝＃しないのかい？
ま、いいや。＃｛記録、セーブ｝＃したくなったら、
また連絡してくれ。
}
}//d

resource TO_未セーブ終了普通４ {
//ns
オタコン_000: {
ＯＫ。
スネーク、気をつけて。
}
}//d

resource TO_未セーブ終了普通５ {
//ns
オタコン_000: {
スネーク、これは＃｛記録、セーブ｝＃専用の
回線なんだけど……。
}
}//d


//・緊迫 //e
resource TO_未セーブ終了緊迫１ {
//ns
オタコン_000: {
頑張ってくれよ、スネーク！
}
}//d

resource TO_未セーブ終了緊迫２ {
//ns
オタコン_000: {
＃｛記録、セーブ｝＃が必要になったら
すぐ連絡してくれ。負けるなよ！
}
}//d

resource TO_未セーブ終了緊迫３ {
//ns
オタコン_000: {
あきらめないでくれよ！
}
}//d

resource TO_未セーブ終了緊迫４ {
//ns
オタコン_000: {
勝つんだ、スネーク！
}
}//d


//・汎用無言 //e
resource TO_無言 {
//ns
オタコン_000: {
……。
}
}//d


//●ＳＡＶＥ失敗  h//e
//・メモリーカードがない h //e
resource TO_ＳＡＶＥ失敗メモリーカードない {
//ns
オタコン_000: {
あ、ＭＥＭＯＲＹ ＣＡＲＤ差込口に
"PlayStation 2"専用メモリーカード
(8MB)が差さってないよ。
}

オタコン_001: {
＃｛記録、セーブ｝＃するには"PlayStation 2"専用
メモリーカード(8MB)が必要なんだ。
}

オタコン_002: {
ＭＥＭＯＲＹ ＣＡＲＤ差込口に
"PlayStation 2"専用メモリーカード
(8MB)をセットしてくれ。
}
}//d


//・空き領域がない h //e
resource TO_ＳＡＶＥ失敗空領域ない {
//ns
オタコン_000: {
うーん。スネーク、"PlayStation 2"
専用メモリーカード(8MB)に
空き領域がなくて＃｛記録、セーブ｝＃できなかったよ。
}

}//d


//・フォーマットしようとしない  h //e
resource TO_ＳＡＶＥ失敗フォーマットしようとしない {
//ns
オタコン_000: {
あのー、フォーマットしないと
＃｛記録、セーブ｝＃はできないんだけど……
わかってる？
}

}//d


//・その他エラー  h //e
resource TO_ＳＡＶＥ失敗その他エラー {
//ns
オタコン_000: {
スネーク、ごめん。
エラーが起きて＃｛記録、セーブ｝＃できなかった。
}

}//d


//●ＳＡＶＥ失敗緊迫  h//e
//・メモリーカードがない緊迫 h //e
