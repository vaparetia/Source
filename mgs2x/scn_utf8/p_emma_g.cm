}//d

//柱の影でジョニーと会った後 h //e
resource PE_狙撃＿ジョニー後__g {
//vox t:vc220701 {
ライデン_000: {
Emma, ist etwas hinter
der S&~aule passiert?
}
/*
エマ、柱の影で何かあったのか？
Emma, did something happen
behind that column?
*/
エマ_001: {
Nein, eigentlich nicht.
}
/*
いいえ、何も。
No, not really.
*/
ライデン_002: {
Aber ich h&~orte jemanden sprechen.
}
/*
話し声が聞こえたが？
But I heard someone talking.
*/
エマ_003: {
Hast Du gelauscht?
}
/*
盗み聞きしてたの？
Were you eavesdropping?
*/
ライデン_004: {
Soll das eine Anschuldigung sein?
Ich war um Dich besorgt.
}
/*
人聞きが悪いな。
俺は君が心配だったから……。
What kind of accusation is that?
I was worried about you.
*/
エマ_005: {
Du HAST also gelauscht.
}
/*
盗み聞きしてたのね。
So you WERE eavesdropping.
*/
ライデン_006: {
Gut, dann dr&~ucke es eben so aus.
}
/*
あぁ……まあ……そうとも言えるかな。
Fine... Put it that
way if you like.
*/
エマ_007: {
Du Mistkerl.
}
/*
サイテー。
You suck.
*/
ライデン_008: {
Ja ja. Sagst Du mir jetzt,
was passiert ist?
}
/*
聞きなれたよ、それ。
で、何があったんだ？
Yeah, yeah. Are you going
to tell me what happened?
*/
エマ_009: {
Nein -- ich glaube nicht!
}
/*
うふふ。……内緒！
Ha! No -- I don't think so!
*/
//dv}//v
}//d


