proc rp_ＳＡＶＥデフォルトセット:05 {
	selectmenu  2 -m  { 
		[ＳＡＶＥ選択肢__s:セーブする] 
		[ＳＡＶＥ選択肢__s:セーブしない] 
	}
	eval($w:rfp_ＳＡＶＥ選択肢返り値 = $status)
	print 'ぐあだららじょぶ$w:rfp_ＳＡＶＥ選択肢返り値:' $w:rfp_ＳＡＶＥ選択肢返り値
}

proc rt_ＳＡＶＥデフォルトセット:05 {
	#ifdef d:EU_TRIAL
	selectmenu  1 -m  { 
		[ＳＡＶＥ選択肢__s:セーブしない] 
	}
	eval($w:rft_ＳＡＶＥ選択肢返り値 = 1)
	#else
print 'ほげほほほ'
	selectmenu  2 -m  { 
		[ＳＡＶＥ選択肢__s:セーブする] 
		[ＳＡＶＥ選択肢__s:セーブしない] 
	}
	eval($w:rft_ＳＡＶＥ選択肢返り値 = $status)
	#endif
print 'ぷにょあよあああ'
}

proc rp_ＳＡＶＥさせないセット:05 {
	selectmenu  2 -m  { 
		[ＳＡＶＥ選択肢__s:セーブさせない] 
		[ＳＡＶＥ選択肢__s:セーブしない] 
	}
	eval($w:rfp_ＳＡＶＥ選択肢返り値 = $status)
	print 'ぐあだららじょぶ$w:rfp_ＳＡＶＥ選択肢返り値:' $w:rfp_ＳＡＶＥ選択肢返り値
}

