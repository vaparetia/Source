// 敵兵
#define		SUPPORT			0		// サポート兵
#define		ATTACKER		0		// 攻撃兵
#define		SHIELD			0		// 盾兵(1) or 通常攻撃兵(0)

// デバッグ
#define		USB_KEY			0		// USBキーボード
#define		DEBUG_MODE		0		// デバッグモード
#define		DEBUG_PRINT		0		// デバッグ表示

// ステージロード制御
