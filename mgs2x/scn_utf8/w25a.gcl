#define		KMS_NAME1		w25a1		// シェル1シェル２連絡橋下部
#define		KMS_NAME2		w25ab_17a	// 遠景
#define		KMS_NAME3		w25ab_18a	// 遠景
#define		KMS_NAME4		w25ab_19a	// 遠景
#define		KMS_NAME5		w25ab_20a	// 遠景
#define		KMS_NAME6		w25a_gl		// 遠景
#define		KMS_NAME7		w25ab_gh	// 遠景
#define		KMS_NAME8		w25a_g		// 遠景
#define		KMS_NAME9		w25ab_14a	// 遠景
#define		KMS_NAMEA		w25ab_21a	// 遠景
#define		KMS_NAMEB		w25ab_24a	// 遠景
#define		KMS_NAMEC		w25ab_31a	// 遠景
#define		KMS_NAMED		w25ab_32a	// 遠景
#define		KMS_NAMEE		w25ab_32b	// 遠景
#define		KMS_NAMEF		w25ab_32c	// 遠景
#define		KMS_NAMEG		w25ab_crane	// 遠景
#define		KMS_NAMEH		w25ab_i1	// 遠景
#define		KMS_NAMEI		w25ab_i2	// 遠景
#define		KMS_NAMEJ		w25ab_kl	// 遠景
#define		KMS_NAMEK		w25ab_l		// 遠景
#define		KMS_NAMEL		w25ab_other00	// 遠景
#define		KMS_NAMEM		w25ab_other01	// 遠景
#define		KMS_NAMEN		w25ab_other02	// 遠景
