// ------------------------------------
// 各gclで必要なdefine
// ------------------------------------
// モード
#define		STAGE_VR 		1		// 共通プロック切り分け用
#define		VR_SNEAKING		1		// 共通プロック切り分け用

// ステージ名
#define		STAGE_VS04A		1		// 共通プロック切り分け用
// 敵兵、ＮＰＣ状況（薬莢を呼び分けるのに必要）
#define		ENE_P_GOL		1		// 都市迷彩ゴル兵
#define		ENE_SHOT		1		// ショットガン兵
#define		ENE_HIGH_TECH	1		// ハイテク兵
#define		ENE_SHIELD		1		// 盾兵


// ------------------------------------
// 各種スイッチ用define
// ------------------------------------
// デバッグ関係
#ifdef	d:FIX_MODE
	#define		DEBUG_CHARA		0		// デバッグキャラ全体(FIX時は0)
#else
	#define		DEBUG_CHARA		0		// デバッグキャラ全体
#endif
#define		CHARA_CAMERA	0		// キャラ追従カメラ
#define		TARGET_CHARA	敵兵:01	// キャラ追従カメラのターゲット
#define		SCREENSHOT		0		// スクリーンショット
#define		USB_KEY			0		// USBキーボード


// ------------------------------------
// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME			vs04a
#define		KMS_NAME			vs04a
#define		TONBO_KMS_NAME		vs04a_tonbo
#define		LINE_KMS_NAME		vs04a_line

// キャラクター関係
#define		PLAYER		ライデン

// ------------------------------------
// 敵兵音声
// ------------------------------------

// ------------------------------------
// 敵兵ルート番号
// ------------------------------------
enum E_R {
	雷電道１ = 0,
	雷電道２,
	雷電道３,
	蛇道１,
	蛇道２,
	蛇道３,
	蛇道４,
	昔蛇１,
	昔蛇２,
	昔蛇３,
	昔蛇４,
	昔蛇５,
};

#define WINDOW_SNEAKING_VS04A	[VRMSG_J:VRM_SNK_SNK_vs04a] [VRMSG_E:VRM_SNK_SNK_vs04a] [VRMSG_G:VRM_SNK_SNK_vs04a] \	// 日、英、独
								[VRMSG_F:VRM_SNK_SNK_vs04a] [VRMSG_I:VRM_SNK_SNK_vs04a] [VRMSG_S:VRM_SNK_SNK_vs04a] \	// 仏、伊、西
								[VRMSG_K:VRM_SNK_SNK_vs04a] \															// 韓
								p:ＶＲステージ開始時処理								// 終了プロック

#define WINDOW_ELIM_ALL_VS04A	[VRMSG_J:VRM_SNK_ELM_vs04a] [VRMSG_E:VRM_SNK_ELM_vs04a] [VRMSG_G:VRM_SNK_ELM_vs04a] \	// 日、英、独
								[VRMSG_F:VRM_SNK_ELM_vs04a] [VRMSG_I:VRM_SNK_ELM_vs04a] [VRMSG_S:VRM_SNK_ELM_vs04a] \	// 仏、伊、西
								[VRMSG_K:VRM_SNK_ELM_vs04a] \															// 韓
								p:ＶＲステージ開始時処理								// 終了プロック

#define	WATCHER_STATUS			d:ENE_STATUS_NORMAL スニーキング４面

#define ゴール位置				10000 0 -18000
#define 前作スネークゴール位置	0 0 -18000

// ------------------------------------
// アイテム位置
// ------------------------------------
#define 壁箱右 5000 0 -7500
#define 右下箱右下 10000 0 -5000
#define ステージ左上 0 0 -18000
#define 左上通路中央 -500 0 -12500
#define 北中央窪み	 5000 0 -17000
#define ステージ右上 10000 0 -18000
// ------------------------------------
// include
// ------------------------------------
#include "rai_vs01a.mh"		// 強制モーションリスト
#include "stdch.h"
#include "enevoice.h"
#include "a_stdproc.h"		// アナザーミッション設定ファイル
#include "sload.h"
#include "sound.h"
#include "item_info.h"
#include "a_item_info.h"
#include "ene_item.h"
#include "vr_common.h"		// ＶＲステージ共通で使用するプロック
#include "vs04a_common.h"
#if d:USB_KEY
	#include "usbkbd.h"
#endif

// ------------------------------------
// マップ設定
// ------------------------------------
chara マップ スニーキング４面 -k d:KMS_NAME -h d:HZX_NAME,0 -l $s:ＶＲライトファイル名

command マップ設定 スニーキング４面 -set {
	// ローカルの初期化
	// ------------------------------------
	@ローカル変数初期化		// ローカルで使用する変数で初期化をする場合はここで

	// 設定値を変更する場合は以下のプロック内で設定
	// ------------------------------------
	@設定値変更				// 敵兵や的のパラメータをステージ限定で変える時はここで

	// ＶＲで必要な基本プロックのセット(vr_common.hで定義)
	// サウンドの基本パック、ＶＲの基本システム、プレイヤー、ゴール等を設定します
	// ※このプロックを使用する時は「ＶＲクリア時処理」というプロックが必要です
	// ＶＲ共通プロックセット	$:スネークファイル $:雷電ファイル $:クリア条件フラグ
	//							$:ゴールＸ $:ゴールＹ $:ゴールＺ $:タイマー初期値
	//	VR_GOAL_TARGET	/*的全滅でゴールが開く*/
	//	VR_GOAL_FREE	/*ゴールが最初から開いてる*/
	//	VR_GOAL_ENEMY	/*敵全滅でゴールが開く*/
	//	VR_GOAL_SNEAK	/*潜入モード中はゴールが開く*/
	//	VR_GOAL_TIME	/*タイマーがゼロになるとゴールが開く*/
	// ------------------------------------
	if( $s:選択プレイヤー == 前作スネーク ){
		@ＶＲスニーキング共通プロックセット sna_vs01a rai_vs01a d:前作スネークゴール位置
	}else{
		@ＶＲスニーキング共通プロックセット sna_vs01a rai_vs01a d:ゴール位置
	}

	// ＶＲウィンドウの設定
	// ------------------------------------
	@スニーキング４面ＶＲウィンドウ設定

	// クリア時に呼ばれるものの設定
	// ------------------------------------
	@ＶＲクリア設定 p:load_vs05a p:A_ＲＥＴＲＹプロック

	// ステージに引かれるライン
	// ------------------------------------
	@ＶＲアウトライン d:KMS_NAME d:TONBO_KMS_NAME d:LINE_KMS_NAME

	@プラグイン設定			// プレイヤーのプラグインがいる時はここで

	// 敵兵・的関係の設定
	// ------------------------------------
	@コマンダー設定

	// ＢＧＭの設定(プレイヤー→敵兵→BGMの順で呼ぶ)
	// ------------------------------------
	@ＢＧＭ設定

	// アイテムの設定
	// ------------------------------------
	@アイテム設定

	// 光源、オブジェクト、カメラ関連の設定
	// ------------------------------------
	@ＶＲフォグ設定 d:VR_FOG:朝Ｎ 60000 d:VR_FOG:夕Ｎ d:VR_FOG:夕Ｆ d:VR_FOG:夜Ｎ 30000
	@カメラセット					// chara カメラとベースのカメラを設定
	@vs04aカメラ設定				// ステージ固有のカメラ設定がいる時はこのプロックで
	@ＶＲキャラ用ライト設置			// 必ず最後に設定
#if d:DEBUG_CHARA
//	@デバッグキャラセット
#endif
}

//初期マップの表示
command マップ表示 -show スニーキング４面


// 各proc設定
//-------------------------------------------------------------------------------------
// 全マップ共通
	// ＶＲウィンドウの設定と表示
	//------------------------------------------------------------
	proc スニーキング４面ＶＲウィンドウ設定 {
		#if d:DEBUG_PRINT
			print 'vr_window_set'
		#endif
		if( $b:モード番号 == d:SNEAKING:SNEAKING ){
			@ＶＲウィンドウ設定 d:WINDOW_SNEAKING_VS04A
		}else{
			@ＶＲウィンドウ設定 d:WINDOW_ELIM_ALL_VS04A
		}

		// ＶＲウィンドウを表示する
		mesg ＶＲウィンドウ ＶＲウィンドウ君 開く

		// スタート時とクリア時に使用するカットインカメラ
		chara カメラ カットインカメラ		-c 0 -l 0 -p  0

		if($s:選択プレイヤー == 前作スネーク ){
			// スタート時のカメラ(必要な場合)
			chara カメラ設定 カットインカメラ \
				-c 1 \
				-p 0,4525,-13129 -t 0,0,-18000 \
				-r 488,2048,0 -f 6648 \
				-a 200 \
				-i 0 -1 0 0 \
				-s 1
		}else{
			// スタート時のカメラ(必要な場合)
			chara カメラ設定 カットインカメラ \
				-c 1 \
				-p 10000,5686,-15353 -t 10000,0,-18000 \
				-r 740,2048,0 -f 6272 \
				-a 200 \
				-i 0 -1 0 0 \
				-s 1
		}
	}

	//------------------------------------------------------------
	// ステージ開始時処理
	//------------------------------------------------------------
	proc ＶＲステージ開始時処理 {
		#if d:DEBUG_PRINT
			print 'game_start!!!!!'
		#endif

		// プレイヤーやパッドの制御等を行う a_stdproc.hで定義
		@全ミッション共通ステージ開始時処理

		// カメラワークスタート(必要な場合)
		// 全体図
		chara カメラ設定 カットインカメラ \
			-c 1 \
			-p 4202,20489,9060 -t 4202,15501,5276 \
			-r 601,2048,0 -f 6261 \
			-a 188 \
			-i 4 4 d:START_CAMERA_CHANGE_TIME d:START_CAMERA_CHANGE_TIME \
			-s 1

		chara delay ディレイ \
			-time d:START_CAMERA_CHANGE_TIME \
			-exec {
				chara カメラ設定 カットインカメラ -s -1
			}
	}

	// ------------------------------------
	// クリア時の処理
	// ------------------------------------
	proc ＶＲクリア時処理 {
		#if d:DEBUG_PRINT
			print 'clear'
		#endif
		// 強制モーションを発動
		@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_1 2048

		if($s:選択プレイヤー == 前作スネーク ){
			chara カメラ設定 クリア時カメラ \
				-c 1 \
				-p 189,1072,-21633 -t 217,1065,-20440 \
				-r 4,0,0 -f 1193 \
				-a 200 \
				-i 0 0 0 0 \
				-s 1
		}else{
		// クリア時にカメラアングルを変える
			chara カメラ設定 クリア時カメラ \
				-c 1 \
				-p 10069,839,-22529 -t 10069,978,-19413 \
				-r -29,0,0 -f 3120 \
				-a 200 \
				-i 0 0 0 0 \
				-s 1
		}
	}



	// ------------------------------------
	// パラメータ系の変更
	// ------------------------------------
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT
			print 'localvar_init'
		#endif
	}
	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT
			print 'status_set'
		#endif
 		@スニーキング用キャラ別標準装備設定 15 10 4 4
		// 初期装備の設定
		switch($s:選択プレイヤー){
			case( ライデン ){
				// ライデンの初期装備
				@A_弾数設定 d:武器:マガジン 20
				if ( $b:モード番号 == d:SNEAKING:SNEAKING ) {
					@A_装備武器	d:武器:マガジン
				}
			}
			case(スネーク){
				@A_弾数設定 d:武器:マガジン 10
				if ( $b:モード番号 == d:SNEAKING:SNEAKING ) {
					@A_装備武器	d:武器:マガジン
				}
			}
			case( プリスキン ){
				@A_弾数設定 d:武器:マガジン 5
				if ( $b:モード番号 == d:SNEAKING:SNEAKING ) {
					@A_装備武器	d:武器:マガジン
				}
			}
			case( タキシードスネーク ){
				@A_弾数設定 d:武器:マガジン 3
				if ( $b:モード番号 == d:SNEAKING:SNEAKING ) {
					@A_装備武器	d:武器:マガジン
				}
			}
			case( 刀ライデン ){
				// 無し
			}
			case( 前作スネーク ){
				@A_弾数設定 d:武器:マガジン 1
				if ( $b:モード番号 == d:SNEAKING:SNEAKING ) {
					@A_装備武器	d:武器:マガジン
				}
			}
			default{
				#ifndef d:FIX_MODE
					print 'player_code_is '$s:選択プレイヤー
					command assert (d:FALSE) 'player_error (scn) vs04a.gcl '
				#endif
				@A_弾数設定 d:武器:マガジン 20
				if ( $b:モード番号 == d:SNEAKING:SNEAKING ) {
					@A_装備武器	d:武器:マガジン
				}
			}
		}
	}
	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif
	}



	// ------------------------------------
	// 敵兵や的の処理
	// ------------------------------------
	// 敵兵に関する設定
	//-------------------------------------
	proc 警備兵セット {
		#if d:DEBUG_PRINT
			print 'watcher_set'
		#endif
		if ( $s:選択プレイヤー == ライデン		|| \
			 $s:選択プレイヤー == プリスキン	|| \
			 $s:選択プレイヤー == 刀ライデン	){
			@VR_スニーキング警備兵 敵兵:01 d:E_R:雷電道１ 0 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:02 d:E_R:雷電道２ 0 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:03 d:E_R:雷電道３ 0 d:WATCHER_STATUS

		}else if($s:選択プレイヤー == スネーク			|| \
			 	 $s:選択プレイヤー == タキシードスネーク){

			@VR_スニーキング警備兵 敵兵:01 d:E_R:蛇道１ 0 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:02 d:E_R:蛇道２ 0 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:03 d:E_R:蛇道３ 0 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:04 d:E_R:蛇道４ 0 d:WATCHER_STATUS

		}else if( 前作スネーク ){
			@VR_スニーキング警備兵 敵兵:01 d:E_R:昔蛇１ 0 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:02 d:E_R:昔蛇２ 0 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:03 d:E_R:昔蛇３ 0 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:04 d:E_R:昔蛇４ 0 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:05 d:E_R:昔蛇５ 0 d:WATCHER_STATUS
		}else{// ライデン
			@VR_スニーキング警備兵 敵兵:01 d:E_R:雷電道１ 0 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:02 d:E_R:雷電道２ 0 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:03 d:E_R:雷電道３ 0 d:WATCHER_STATUS
		}
	}

	proc 攻撃兵セット {
		#if d:DEBUG_PRINT
			print 'attacker_set'
		#endif
	}

	proc 警備兵コマンダー {
		#if d:DEBUG_PRINT
			print 'wccomm_set'
		#endif

		chara 警備コマンダー wccomm -e {警備兵セット}
	}

	proc 攻撃兵コマンダー {
		#if d:DEBUG_PRINT
			print 'atcomm_set'
		#endif
	}

	proc コマンダー設定 {
		#if d:DEBUG_PRINT
			print 'commander_set'
		#endif

		chara コマンダー 敵兵セット \
			-w 警備兵コマンダー \
			-d スニーキング４面 \
			-r 10000,0,-18000 スニーキング４面 \
			-c 10000,0,-18000 スニーキング４面 \
			-v [ene_vr_voice:01] \
			-z $i:敵標準麻酔持続 \
			-h $i:標準警戒時間 \
			-o $i:敵標準気絶持続 \
			-s (d:ENE_STAGE_GPS | d:ENE_STAGE_VR_ANOTHER) \
			-b 0 \
			-m d:ALERT_MODE_SENNYU
	}



	// ------------------------------------
	// ＢＧＭの設定
	// ------------------------------------
	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT
			print 'bgm_set'
		#endif

		chara ＢＧＭマネージャー ＢＧＭマネ
	}


	// ------------------------------------
	// アイテムの設定
	// ------------------------------------
	// 再発生が必要な時は以下のプロックの中を記述する
	// ------------------------------------
	proc アイテム取得時番号設定 $:ボックス名 {
		#if d:DEBUG_PRINT
			print 'item_no_set'
		#endif
	}
	// アイテムの設置
	// ------------------------------------
	proc アイテム設定 {
		#if d:DEBUG_PRINT
			print 'item_set'
		#endif
		if(`@スニーキング判定`){
			// 特に無し
		}else{
			switch( $s:選択プレイヤー ){
				case( ライデン ){
					@A_Ｍ９_初期設置 Ｍ９ d:壁箱右 0 なし 15
				}
				case( プリスキン ){
					@A_Ｍ９_初期設置 Ｍ９ d:ステージ左上 0 なし 4
				}
				case( 刀ライデン ){
				}
				case( スネーク ){
					@A_Ｍ９_初期設置 Ｍ９ d:右下箱右下 0 なし 6
				}
				case( タキシードスネーク ){
				}
				case( 前作スネーク ){
					@A_Ｍ９_初期設置 Ｍ９ d:左上通路中央 0 なし 5
					@ＵＳＰサプレッサ_初期設置 さぷれ d:北中央窪み 0
					@A_ＵＳＰ_初期設置 ＵＳＰ d:ステージ右上 0 なし 5
				}
				default{
				}
			}
		}
	}
