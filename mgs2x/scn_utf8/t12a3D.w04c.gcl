chara マップ 船倉３ -h d:STAGE_HZX -l d:STAGE_LT2

command マップ設定 船倉３ -set {

//	デモ環境かゲーム環境かで起動を読み分ける。
// ------------------------------------
#if d:MGS2_DEMO

		// t11 を再生するとき
		eval($s:d_num = t11a1D)
		// t12 を再生するとき
	//	eval($s:d_num = t12a1D)
		// t13 を再生するとき
	//	eval($s:d_num = t13a1D)

chara デモアクトデバッグ demodebug  -i t:t12a3D -d 't12a3D' -l   \
		-p	第三船倉オフ 第三船倉オン \
			第二船倉オフ 第二船倉オン \
//			第一船倉オフ 第一船倉オン \
//			レイコックピットオフ レイコックピットオン \
			レイキャノピーオフ \
			右プロジェクタオフ 左プロジェクタオフ \
			右プロジェクタオン 左プロジェクタオン \
			右舷ドア２３_オフ 右舷ドア２３_オン \
			右舷ドア２３奥_オフ 右舷ドア２３奥_オン \
			左舷ドア２３_オフ 左舷ドア２３_オン \
			左舷ドア２３奥_オフ 左舷ドア２３奥_オン \
			右舷上部ドア２３_オフ 右舷上部ドア２３_オン \
			右舷上部ドア２３奥_オフ 右舷上部ドア２３奥_オン \
			左舷上部ドア２３_オフ 左舷上部ドア２３_オン \
			左舷上部ドア２３奥_オフ 左舷上部ドア２３奥_オン \
			第三船倉上方へ移動 第三船倉元の位置へ移動 \
			水面発生 水面移動_第二船倉に移動 水面移動_第一船倉に移動 \
			水面移動_原点にもどる \
			ライトのフレアオフ \
			オセロットオン オセロットオフ りきロッドオン りきロッドオフ \
			スクリーン壊れた！



//	@船倉３海兵隊セット


#else


if($w:t_story < d:ST_T12a3Dメタルギア強奪ポリゴンデモ３開始){
	eval($f:global_polygon_demo = 1)
	eval($s:d_num = t12a3D)

print 'd:ST_T12a3Dメタルギア強奪ポリゴンデモ３開始'

	@デモモデル差し替え処理
	proc デモ再生_t12a3D {
		#if d:デモ前五秒間待ち
chara デモアクトデバッグ demodebug  -i t:t12a3D -d 't12a3D' -l   \
				-next t12a3D終了 \
				-p	第三船倉オフ 第三船倉オン \
					第二船倉オフ 第二船倉オン \
		//			第一船倉オフ 第一船倉オン \
		//			レイコックピットオフ レイコックピットオン \
					レイキャノピーオフ \
