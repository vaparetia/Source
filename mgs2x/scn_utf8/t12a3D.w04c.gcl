// キャラ用ライトセット
// ------------------------------------
proc デフォルトキャラ専用ライトセット {
	command マップ設定 船倉３ 通路２ -set {
		chara 環境光 アンビ \
			 -c 6 20 30

		chara 平行光 パラ \
			 -c 86 85 48 \
			 -p -1287 -3357 -5545
	}
}
/*
デフォルトキャラ専用ライトセット
w04cのキャラ平環光セット
w04bのキャラ平環光セット
w04aのキャラ平環光セット
レイコクピットのキャラ平環光セット
*/
// -------------------------------------
// ！！！重要！！！
// -------------------------------------
/* 以下のライトで、
「＊＊＊のプリシェード平環光セット」はプリシェードモデルを置く直前でセット、
 置き終わったら元のものに戻す。（プットオブジェで検索して、ちゃんと置く。
 t04a1D.w00a.gcl参照）
「＊＊＊のキャラ平環光セット」はマックスの方で、随時呼び出すために用意した
 このステージでは、マップ設定でセットしているのは ?????.lt2 である */

// w04cステージにあたる場所での平行、環境光
proc w04cのキャラ平環光セット {
	chara 環境光 w04cキャラ環境光 \
		 -c 73 89 121
	chara 平行光 w04cキャラ平行光 \
		 -c 61 142 174 \
		 -p -100 -3500 -2000
}
proc w04cのプリシェード平環光セット {
	chara 環境光 w04cプリ環境光 \
		 -c 63 35 17
	chara 平行光 w04cプリ平行光 \
		 -c 255 119 70 \
		 -p 0 -4300 -2500
}

// w04bステージにあたる場所での平行、環境光
proc w04bのキャラ平環光セット {
	chara 環境光 w04bキャラ環境光 \
		 -c 4 35 44
	chara 平行光 w04bキャラ平行光 \
		 -c 54 86 70 \
		 -p 321 1705 0
}
proc w04bのプリシェード平環光セット {
	chara 環境光 w04bプリ環境光 \
		 -c 24 91 94
	chara 平行光 w04bプリ平行光 \
		 -c 80 35 5 \
		 -p 3800 -3200 -100
}

// w04aステージにあたる場所での平行、環境光
proc w04aのキャラ平環光セット {
	chara 環境光 w04aキャラ環境光 \
		 -c 53,73,55
	chara 平行光 w04aキャラ平行光 \
		 -c 70,230,214 \
		 -p 691,721,0
}
proc w04aのプリシェード平環光セット {
	chara 環境光 w04aプリ環境光 \
		 -c 24 91 94
	chara 平行光 w04aプリ平行光 \
		 -c 80 35 5  \
		 -p 2200,-4300,1000
}

// レイコクピットアップでの平行、環境光
