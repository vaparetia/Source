// ドアオブジェクト
// ------------------------------------
proc ドア設置／通路２－船倉３ {
// 第三船倉にあるドア
	chara プットオブジェ 右舷ドア２３ \
		-m w04_dr \
		-r 0,2048,0 \
		-p 8750,-17000,50 \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0010

	chara プットオブジェ 右舷ドア２３奥 \
		-m w04_dr \
		-r 0,0,0 \
		-p 7250,-17000,4450 \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0010

	chara プットオブジェ 左舷ドア２３ \
		-m w04_dr \
		-r 0,2048,0 \
		-p -7250,-17000,50 \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0010

	chara プットオブジェ 左舷ドア２３奥 \
		-m w04_dr \
		-r 0,0,0 \
		-p -8750,-17000,4450 \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0010

	chara プットオブジェ 右舷上部ドア２３ \
		-m w04_dr \
		-r 0,2048,0 \
		-p 11750,-9000,50 \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0010

	chara プットオブジェ 右舷上部ドア２３奥 \
		-m w04_dr \
		-r 0,0,0 \
		-p 10250,-9000,4450 \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0010

	chara プットオブジェ 左舷上部ドア２３ \
		-m w04_dr \
		-r 0,2048,0 \
		-p -10250,-9000,50 \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0010

	chara プットオブジェ 左舷上部ドア２３奥 \
		-m w04_dr \
		-r 0,0,0 \
		-p -11750,-9000,4450 \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0010

// 第二船倉右手前（第一船倉側）
	chara プットオブジェ 右舷ドア１２ \
		-m w04_dr \
		-r 0,2048,0 \
		-p 8750,-17000,(50+28500) \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0020

	chara プットオブジェ 右舷上部ドア１２ \
		-m w04_dr \
		-r 0,2048,0 \
		-p 11750,-9000,(50+28500) \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0020
}

proc 右舷ドア２３_オフ {
	mesg プットオブジェ 右舷ドア２３ off
}
proc 右舷ドア２３_オン {
	mesg プットオブジェ 右舷ドア２３ on
}

