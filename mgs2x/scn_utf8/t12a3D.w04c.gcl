	chara 平行光 レイプリ平行光 \
		 -c 255 119 70 \
//		 -c 64,64,64 \
		 -p 2200,-4300,1000
}

proc 水面発生{
//	print'水面発生'
	print'揺らぎ追加'

	chara キラキラ水面２ 水面 \
	-tex water_sur w04c_envmap_alp_ovl \
	-pos 0,-15300,-15750 \
	-ctrl // これをつけると水面コントロールキャラによる水面高さの変更が可能に

	chara delay ディレイ \
		-time 1 \
		-exec{
	print'揺らぎ追加'
			mesg キラキラ水面２ 水面 波発生源追加 sna_def_addhand_demo
//			mesg キラキラ水面２ 水面 波発生源追加 sna_def_addhand_mh_mt
			mesg キラキラ水面２ 水面 波発生源追加 us_def2_01
	}
/*		chara 水中カメラ ゆらぎマン \
			-col 128 128 160 \
			-warp 2						*/
// 室内用水面オブジェクト
// テクスチャはこの波プログラム専用のテクスチャ単体でPACK_ALLしたTRIファイルが必要なので注意
// メッセージを送るとそのキャラの動きによって水面に波が立つ。

}
proc 水面移動_原点にもどる{
	print'水面移動'
	mesg キラキラ水面２ 水面 表示位置移動 0,-15300,-15750
}

proc 水面移動_第二船倉に移動{
	print'水面移動'
	mesg キラキラ水面２ 水面 表示位置移動 0,-15300,(-13000+28500)
}

proc 水面移動_第一船倉に移動{
	print'水面移動'
	mesg キラキラ水面２ 水面 表示位置移動 0,-15300,(-13000+28500+28500)
}

//@ライトのフレアオフ

proc リアル影セット {
print 'リアル影000_aaa'
#if 0
print 'リアル影000'
print 'リアル影000_bbb'
	chara 影管理 演説台 \
		-type 1 \
		-length 150000
	mesg 影管理 演説台 demo_add sco_def w04c1_drk
	mesg 影管理 演説台 demo_add rev_coat w04c1_drk

	mesg 影管理 演説台 demo_add us_def1_A1 w04c1_drk
	mesg 影管理 演説台 demo_add us_def1_A2 w04c1_drk
	mesg 影管理 演説台 demo_add us_def1_A3 w04c1_drk
	mesg 影管理 演説台 demo_add us_def1_A4 w04c1_drk

	mesg 影管理 演説台 demo_add us_def1_B1 w04c1_drk
	mesg 影管理 演説台 demo_add us_def1_B2 w04c1_drk
	mesg 影管理 演説台 demo_add us_def1_B3 w04c1_drk
	mesg 影管理 演説台 demo_add us_def1_B4 w04c1_drk

	mesg 影管理 演説台 demo_add us_def1_C1 w04c1_drk
	mesg 影管理 演説台 demo_add us_def1_C2 w04c1_drk
	mesg 影管理 演説台 demo_add us_def1_C3 w04c1_drk
	mesg 影管理 演説台 demo_add us_def1_C4 w04c1_drk

//	mesg 影管理 $s:名前 del[1] $s:削除キャラ
	// 光源タイプ
	//   0:無限遠並行光源（ステージの平行光に対して）
	//   1:点光源エミュレーション（影フラグのついた点光源に対して）
	// メッセージにより追加、削除ができるので部屋の入口のトラップなどに
	// 引っかけて使用すると良い
	// 投影モデル名指定を指定することで特定の投影モデルのみに投影することが可能
	// また、すでに影を表示しているキャラに対してさらにaddでメッセージを
	// 送ると投影モデル名のみの変更が可能です。

print 'リアル影001'
	chara スポットライト投影モデル 演説台 \
		-model w04c1_drk \
		-pos 0 0 (-28500-39500)
print 'リアル影002'
	chara 静止スポットライト設置 演説台 \
		-pos -1000, -8750, -14500 \
		-dir 490, 0, 0 \
		-range 15000 \
		-angle 53 \
		-color 128,128,100 \
		-option 0x8000
//		-option 0x0000
print 'リアル影003'
#endif
	// 2001/09/16 Uehara Masatoshi [新規追加]
	chara 影投影モデル キャットウォークの影もでる \
		-m w04ck1 \
		-p 0 2 0

	chara 影管理 影かんり \
		-t 0 \
		-a 96 \
		-p 164 -1000 -164
}

// 2001/09/16 Uehara Masatoshi [新規追加]
proc オセロットオン {
	mesg 影管理 影かんり demo_add rev_def_addhand_mh_mt キャットウォークの影もでる
}
proc オセロットオフ {
	mesg 影管理 影かんり del rev_def_addhand_mh_mt
}
proc りきロッドオン {
	mesg 影管理 影かんり demo_add rev_liq_addhand_mh_mt キャットウォークの影もでる
}
proc りきロッドオフ {
	mesg 影管理 影かんり del rev_liq_addhand_mh_mt
}

