proc 右舷上部ドア２３_オフ {
	mesg プットオブジェ 右舷上部ドア２３ off
}
proc 右舷上部ドア２３_オン {
	mesg プットオブジェ 右舷上部ドア２３ on
}

proc 右舷上部ドア２３奥_オフ {
	mesg プットオブジェ 右舷上部ドア２３奥 off
}
proc 右舷上部ドア２３奥_オン {
	mesg プットオブジェ 右舷上部ドア２３奥 on
}

proc 左舷上部ドア２３_オフ {
	mesg プットオブジェ 左舷上部ドア２３ off
}
proc 左舷上部ドア２３_オン {
	mesg プットオブジェ 左舷上部ドア２３ on
}

proc 左舷上部ドア２３奥_オフ {
	mesg プットオブジェ 左舷上部ドア２３奥 off
}
proc 左舷上部ドア２３奥_オン {
	mesg プットオブジェ 左舷上部ドア２３奥 on
}


proc チェーン設定{
//２Ｆ外周
	chara ロープモデル２ チェーン１ \
		-n w02a_chain \
		-x 10020,-8000,-13520 \
		-r 0,1024,0 \
		-s 50 \
		-m 200 \
		-k 2000 \
		-d 0

	chara ロープモデル２ チェーン２ \
		-n w02a_chain \
		-x -10020,-8000,-13520 \
		-r 0,1024,0 \
		-s 50 \
		-m 200 \
		-k 2000 \
		-d 0

//演説台
	chara ロープモデル２ チェーン３ \
		-n w02a_chain \
		-x 6970,-13750,-13520 \
		-r 0,1024,0 \
		-s 50 \
		-m 200 \
		-k 2000 \
		-d 0


	chara ロープモデル２ チェーン４ \
		-n w02a_chain \
		-x -6970,-13750,-13520 \
		-r 0,1024,0 \
		-s 50 \
		-m 200 \
		-k 2000 \
		-d 0

//昇降機
	chara ロープモデル２ チェーン５ \
		-n w02a_chain \
		-x 7000,-11000,-13520 \
		-r 0,1024,0 \
		-s 50 \
		-m 200 \
		-k 2000 \
		-d 0

	chara ロープモデル２ チェーン６ \
		-n w02a_chain \
		-x -7000,-11000,-13520 \
		-r 0,1024,0 \
		-s 50 \
		-m 200 \
		-k 2000 \
		-d 0

}

// ぼかしセット
// ------------------------------------
proc ぼかしセット {
	chara 遠景ぼかし far_deforcus \
		-plane	4 \
		-near	6000 \
		-far	9000

	chara 近景ぼかし near_deforcus \
		-plane	3 \
		-near	0 \
		-far	3000
}

// 第二船倉のプロジェクタセット
// ------------------------------------
proc 第二船倉のプロジェクタセット {
/*
	//プロジェクタ右
	chara スポットライト投影モデル スポットライト投影右 \
		-m w04b1_k1 \
		-p 0,0,28500
	chara 静止スポットライト設置 スポットライト投影右 \
		-pos 630,-15600,(-1300+28500) \
		-dir -150,1930,0 \
		-range 30000 \
		-angle 14 \
		-color 255,255,255 \
		-option 0x0001
*/
	chara プロジェクタライト プロジェクタライト右 \
		-p 630,-15600,(-1300+28500) \
		-d 4000,-10000,(-22000+28500)

/*
	//プロジェクタ左
	chara スポットライト投影モデル スポットライト投影左 \
		-m w04b1_k2 \
		-p 0,0,28500
	chara 静止スポットライト設置 スポットライト投影左 \
		-pos -630,-15600,(-1300+28500) \
		-dir -154,2192,0 \
		-range 30000 \
		-angle 16 \
		-color 255,255,255 \
		-option 0x0001
*/
	chara プロジェクタライト プロジェクタライト左 \
		-p -630,-15600,(-1300+28500) \
		-d -4000,-10000,(-22000+28500)

#if 1
	mesg プロジェクタライト プロジェクタライト右 オフ
	mesg プロジェクタライト プロジェクタライト左 オフ
#endif

}
proc 右プロジェクタオフ {
	mesg プロジェクタライト プロジェクタライト右 オフ
}
proc 左プロジェクタオフ {
	mesg プロジェクタライト プロジェクタライト左 オフ
}
proc 右プロジェクタオン {
	mesg プロジェクタライト プロジェクタライト右 オン
}
proc 左プロジェクタオン {
	mesg プロジェクタライト プロジェクタライト左 オン
}

// 第二船倉の壊れスクリーンセット
// ------------------------------------
proc 第二船倉の壊れスクリーンセット {
	@w04bのプリシェード平環光セット
	chara プットオブジェ 壊れ前スクリーン \
		-m w04b_demo_screen_normal \
		-r 0 0 0 \
		-p 0 0 28500 \
		-l d:STAGE_LT2 \
		-s 100 100 100

	chara プットオブジェ 壊れ後スクリーン \
		-m w04b_demo_screen_brk \
		-r 0 0 0 \
		-p 0 0 28500 \
		-l d:STAGE_LT2 \
		-s 100 100 100
	@w04cのプリシェード平環光セット
	mesg プットオブジェ 壊れ後スクリーン off
}

proc スクリーン壊れた！ {
	mesg プットオブジェ 壊れ前スクリーン off
	mesg プットオブジェ 壊れ後スクリーン on
	mesg スポットライト背景イメージ指定 ムービー テクスチャ許可 0
}

