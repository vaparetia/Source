	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ失敗空領域ない緊迫:オタコン_000]
		//スネーク、＃｛"PlaySation2"、ピーエスツー｝＃専用
		//メモリーカードに空き領域がなくて
		//＃｛記録、セーブ｝＃出来なかった！
	}
} //v
}

