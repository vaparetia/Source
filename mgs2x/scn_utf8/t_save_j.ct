proc rto_ＳＡＶＥ前普通１:07 {
vox t:vc020101 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ前普通１:オタコン_000]
		//＃｛記録、セーブ｝＃するかい、スネーク？
	}
} //v
}

