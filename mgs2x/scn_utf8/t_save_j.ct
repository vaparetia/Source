proc rto_未セーブ終了普通３:07 {
vox t:vc021101 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_未セーブ終了普通３:オタコン_000]
		//なんだ、＃｛記録、セーブ｝＃しないのかい？
		//ま、いいや。＃｛記録、セーブ｝＃したくなったら、
		//また連絡してくれ。
