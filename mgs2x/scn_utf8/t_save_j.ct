proc rto_ＳＡＶＥ後序盤６:07 {
vox t:vc023301 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ後序盤６:オタコン_000]
		//『傷口が癒えると痛みを忘れる』
		//ってコトワザ知ってるかい？
	}

@rt_うなづきデフォルト＿是
@rt_疑惑＿否＿信じられん系デフォルト 100
	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ後序盤６:オタコン_001]
		//意味は……ええと……あれ？
		//メモがどっかに……。
	}

	talk スネーク 標準 -m {
		[TO_ＳＡＶＥ後序盤６:スネーク_002]
		//何か言ったか？
