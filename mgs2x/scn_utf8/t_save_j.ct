proc rto_ＳＡＶＥ失敗メモリーカードない:07 {
vox t:vc021901 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ失敗メモリーカードない:オタコン_000]
		//あ、＃｛ＭＥＭＯＲＹ、メモリー｝＃ ＃｛ＣＡＲＤ、カード｝＃差込口に
		//＃｛"PlaySation2"、ピーエスツー｝＃専用メモリーカードが
		//ささってないよ。
	}

	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ失敗メモリーカードない:オタコン_001]
		//＃｛記録、セーブ｝＃するには＃｛"PlaySation2"、ピーエスツー｝＃専用
		//メモリーカードが必要なんだ。
	}

	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ失敗メモリーカードない:オタコン_002]
		//＃｛ＭＥＭＯＲＹ、メモリー｝＃ ＃｛ＣＡＲＤ、カード｝＃差込口に
		//＃｛"PlaySation2"、ピーエスツー｝＃専用メモリーカードを
		//セットしてくれ。
	}
} //v
}

proc rto_ＳＡＶＥ失敗空領域ない:07 {
vox t:vc022001 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ失敗空領域ない:オタコン_000]
		//うーん。スネーク、＃｛"PlaySation2"、ピーエスツー｝＃専用
		//メモリーカードに空き領域がなくて
		//＃｛記録、セーブ｝＃出来なかったよ。
	}
} //v
}

proc rto_ＳＡＶＥ失敗フォーマットしようとしない:07 {
vox t:vc022101 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ失敗フォーマットしようとしない:オタコン_000]
		//あのー、フォーマットしないと＃｛記録、セーブ｝＃は
		//出来ないんだけど、わかってる？
	}
} //v
}

proc rto_ＳＡＶＥ失敗その他エラー:07 {
vox t:vc022201 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ失敗その他エラー:オタコン_000]
		//スネーク、ごめん。エラーが起きて
		//＃｛記録、セーブ｝＃できなかった。
	}
} //v
}

proc rto_ＳＡＶＥ失敗メモリーカードない緊迫:07 {
vox t:vc022301 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ失敗メモリーカードない緊迫:オタコン_000]
		//＃｛ＭＥＭＯＲＹ、メモリー｝＃ ＃｛ＣＡＲＤ、カード｝＃差込口に
		//＃｛"PlaySation2"、ピーエスツー｝＃専用メモリーカードが
		//ささってない！
	}

	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ失敗メモリーカードない緊迫:オタコン_001]
		//＃｛記録、セーブ｝＃するには＃｛"PlaySation2"、ピーエスツー｝＃専用
		//メモリーカードが必要なんだ！
	}

	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ失敗メモリーカードない緊迫:オタコン_002]
		//＃｛ＭＥＭＯＲＹ、メモリー｝＃ ＃｛ＣＡＲＤ、カード｝＃差込口に
		//＃｛"PlaySation2"、ピーエスツー｝＃専用メモリーカードを
		//セットしてくれ！
	}
} //v
}

proc rto_ＳＡＶＥ失敗空領域ない緊迫:07 {
vox t:vc022401 {
