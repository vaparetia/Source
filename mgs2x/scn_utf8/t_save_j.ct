proc rto_ＳＡＶＥ後序盤４:07 {
vox t:vc023101 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ後序盤４:オタコン_000]
		//中国では『迷う者は＃｛路、みち｝＃を問わず、
