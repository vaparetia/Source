	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ失敗フォーマットしようとしない緊迫:オタコン_000]
		//フォーマットしないと＃｛記録、セーブ｝＃は
		//出来ないんだ！わかってるか！？
	}
} //v
}

proc rto_ＳＡＶＥ失敗その他エラー緊迫:07 {
vox t:vc022601 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ失敗その他エラー緊迫:オタコン_000]
		//スネーク、エラーが起きて＃｛記録、セーブ｝＃
		//できなかった。
	}
} //v
}

proc rto_ＳＡＶＥ後初めて:07 {
vox t:vc022701 {
@rt_キテレツさん＿否＿なんだこいつ系デフォルト 100
@rt_うなづきデフォルト＿是
	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ後初めて:オタコン_000]
		//スネーク、『＃｛匹夫、ヒキオ｝＃の＃｛勇、ゆう｝＃、一人に
		//敵するものなり』ってコトワザが
		//あるんだけど……。
	}

	talk スネーク 標準 -m {
		[TO_ＳＡＶＥ後初めて:スネーク_001]
		//どうしたんだ、突然？
	}

	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ後初めて:オタコン_002]
		//いや、なんとなく寂しいだろうと
		//思って、準備してきたんだよ。
	}

@rt_疑惑＿否＿信じられん系デフォルト 100
	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ後初めて:オタコン_003]
		//ヒキオってのは中国の英雄だ。多分。
	}

@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ後初めて:オタコン_004]
		//ま、どんなに強くっても一度に
		//相手出来るのは一人がせいぜいって
		//ことだね。
	}

	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ後初めて:オタコン_005]
		//要するに大勢を一度に敵に回しちゃ
		//勝ち目がないって意味だ。
	}

	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ後初めて:オタコン_006]
		//スネークは一人で潜入してるんだから、
		//多数の敵をまともに相手しちゃダメだ。
		//見つからないようにね。
	}

@rt_キテレツさん＿否＿なんだこいつ系デフォルト 100
@rt_うなづきデフォルト＿是
	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ後初めて:オタコン_007]
		//っと、こんな感じ。
		//どうだい、懐かしいだろう？
	}

	talk スネーク 標準 -m {
		[TO_ＳＡＶＥ後初めて:スネーク_008]
		//懐かしいことは懐かしいが……。
		//何か違わないか？
	}

	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ後初めて:オタコン_009]
		//そんなことはないよ！
		//これからも色々なコトワザを
		//教えてあげるからね。
	}

	talk スネーク 標準 -m {
		[TO_ＳＡＶＥ後初めて:スネーク_010]
		//うぅむ……。
	}
} //v
}

proc rto_ＳＡＶＥ後序盤１:07 {
vox t:vc022801 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ後序盤１:オタコン_000]
		//ええと『＃｛高飛、こうひ｝＃の＃｛鳥、とり｝＃も＃｛美食、びしょく｝＃に死す。
		//＃｛深泉、しんせん｝＃の＃｛魚、うお｝＃も＃｛芳餌、ほうじ｝＃に死す』って
		//コトワザ知ってるかい？
	}

@rt_うなづきデフォルト＿是
@rt_疑惑＿否＿信じられん系デフォルト 100
	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ後序盤１:オタコン_001]
		//意味は……欲をかき過ぎるなって
		//ことだ。
	}

	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ後序盤１:オタコン_002]
		//高飛という所に住んでいた鳥は
		//食べ過ぎて死んじゃったし、深泉地方の
		//魚も食べ過ぎて死んだ、と。
	}

	talk スネーク 標準 -m {
		[TO_ＳＡＶＥ後序盤１:スネーク_003]
		//……そうなのか？
	}

	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ後序盤１:オタコン_004]
		//そうさ。スネークもアイテムを取ろうと
		//欲張ってケガしちゃダメだよ。
	}

	talk スネーク 標準 -m {
		[TO_ＳＡＶＥ後序盤１:スネーク_005]
		//……。
	}
} //v
}

proc rto_ＳＡＶＥ後序盤２:07 {
vox t:vc022901 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ後序盤２:オタコン_000]
		//中国には『天に順う者は存し、天に
		//逆らう者は亡ぶ』っていうコトワザが
		//あるんだ。知ってる？
	}

	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ後序盤２:オタコン_001]
		//意味は、うーんと……自然の道理に
		//従っている者は存在出来るけど、逆らう
		//者は滅亡してしまう、ってことだ。
	}

@rt_うなづきデフォルト＿是
@rt_疑惑＿否＿信じられん系デフォルト 100
	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ後序盤２:オタコン_002]
		//テンっていうのはイタチ科の動物だ。
		//イタチによく似てるけど少し大型で、
		//足が短い。
	}

	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ後序盤２:オタコン_003]
		//とても素早くて木登りもうまいんだ。
		//主に小型の哺乳類や小鳥なんかを
		//食べる。
	}

	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ後序盤２:オタコン_004]
		//毛皮はとても珍重されていて……。
	}

@rt_うなづきデフォルト＿是
	talk スネーク 標準 -m {
		[TO_ＳＡＶＥ後序盤２:スネーク_005]
		//テンと自然の道理に関係があるのか？
	}

	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ後序盤２:オタコン_006]
		//うーん。それだけテンは
		//恐れ敬われてたってことだ。
	}

	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ後序盤２:オタコン_006_1]
		//うーん。それだけテンは
		//恐れ敬われてたってことだ。
	}

	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ後序盤２:オタコン_006_2]
		//うーん。それだけテンは
		//恐れ敬われてたってことだ。
	}

	talk スネーク 標準 -m {
		[TO_ＳＡＶＥ後序盤２:スネーク_007]
		//テンが、か……？
	}

/*
	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ後序盤２:オタコン_008]
		//そうだよ。多分。
	}

	talk スネーク 標準 -m {
		[TO_ＳＡＶＥ後序盤２:スネーク_009]
		//……。
	}
*/
} //v
}

proc rto_ＳＡＶＥ後序盤３:07 {
