@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ＳＡＶＥ前緊迫２:オタコン_000]
		//大丈夫かい、スネーク？
		//＃｛記録、セーブ｝＃の準備なら出来てるよ？
	}
