/* -------------------------------

プラント強制無線機デモどろどっち。
$Id: p_demo_e.cm,v 1.38 2002/07/12 05:43:30 usr03005 Exp $

---------------------------------*/

resource P001_02_R01_オープニング潜入２無線デモ１＿１__e {
ライデン_000: {
This is Snake. I am now inside
Strut A of Shell 1.
}
/*こちらスネーク、
シェル１のＡ脚内に潜入した。*/
大佐_001: {
How are things?
}
/*状況はどうだ？*/
ライデン_002: {
We're in luck. Looks like there
are no sentries posted here.
}
/*幸い、ここには見張りはいないようだ。*/
大佐_003: {
What's the visibility?
}
/*視界はどうだ？*/
ライデン_004: {
The lights on the plant's struts
are functioning. I won't have to
use the IR goggles.
}
/*プラント脚部のライトが起動している。
おかげで＃｛赤外線、サーマル｝＃ゴーグルは使わずに済む。*/
大佐_005: {
Any problems?
}
/*何か問題は？*/
ライデン_006: {
There was a brand-new hole
cut through the oil fence.
}
/*オイルフェンスの切断面が真新しかった。*/
//<ページ数変更>
ライデン_006_1: {
There's someone else besides me
that wanted to get in badly.
}
/*俺の他にも潜入を試みた奴がいる。*/
大佐_007: {
That's not possible.
}
/*それは考えられん。*/
ライデン_008: {
What about SEAL Team 10?
}
/*ＳＥＡＬ１０の突入班は？*/
大佐_009: {
They landed on the roof of
the Big Shell as planned.
}//<ページ数変更>
/*既に『ビッグ・シェル』上部に降下した。*/
大佐_009_1: {
And by the way Snake, we're
changing your codename for
all following communication.
}
/*それとスネーク、今後の無線はコード
ネームを変更して行う。*/
ライデン_010: {
What's wrong with "Snake"?
}
/*スネークでは何か問題が？*/
大佐_011: {
Just a precaution. You are
now designated "Raiden."
}
/*まあな……。
君をこれから、ライデンと呼ぶ*/
}//d

//★　タンカー編をクリアしたユーザーの場合
resource P001_02_R01_オープニング潜入２無線デモ１＿タンカーした１__e {
大佐_000: {
All right, Raiden. You've
already covered infiltration
in VR Training.
}
/*では、ライデン。
潜入ミッションは既にＶＲ訓練で
訓練済みだな。*/
ライデン_001: {
I've completed three hundred
missions in VR.
}
/*ＶＲなら３００ミッションはこなした。*/
ライデン_002: {
I feel like some kind of
legendary mercenary...
}
/*伝説の傭兵になった気分だ……。*/
}//d

resource P001_02_R01_オープニング潜入２無線デモ１＿タンカーした２__e {
大佐_000: {
Okay, we'll skip that part.
}
/*それじゃ、その部分は簡略化するぞ*/
}//d


//★　タンカー編をクリアしていないユーザーの場合

resource P001_02_R01_オープニング潜入２無線デモ１＿タンカーしてない__e {
大佐_000: {
This will be your first
sneaking mission.
}
/*今回、君にとって初めての＃｛潜入任務、スニーキング・ミッション｝＃に
なる。*/
大佐_001: {
The arms will naturally have
to be procured on-site.
}
/*当然、武器は現地調達だ。*/
}//d

resource P001_02_R01_オープニング潜入２無線デモ１＿２__e {
大佐_000: {
Make sure nobody sees you.
}
/*くれぐれも見つからんようにな*/
大佐_001: {
If you need to, contact me by Codec.
The frequency is 140.85.
}
/*何かあれば無線連絡をくれ。
周波数は１４０．８５だ*/
#ifdef d:XBOX
大佐_002: {
When you want to use the Codec,
push the Codec button.
}
#else
大佐_002: {
When you want to use the Codec,
push the SELECT button.
}
#endif

/*無線機を使いたい時は
ＳＥＬＥＣＴボタンを押すんだ。*/
大佐_003: {
When we need to reach you...
contact you, the Codec will
beep.
}
/*こちらから呼び出す場合、
いや連絡する場合はＣＡＬＬする。*/
#ifdef d:XBOX
大佐_004: {
When you hear that noise,
press the Codec button.
}
#else
大佐_004: {
When you hear that noise,
press the SELECT button.
}
#endif
/*ＣＡＬＬ音がなったら、
ＳＥＬＥＣＴボタンを押してくれ。*/
大佐_005: {
The Codec's receiver directly
stimulates the small bones of
your ear.
}
/*耳小骨を直接振動させるものだ。
*/
//<ページ数変更>
大佐_005_1: {
No one but you will
be able to hear it.
}
/*敵には聞こえない。*/
ライデン_006: {
All right. I'll contact you
if anything changes.
}
/*わかった。
なにかあれば＃｛送信、ＳＥＮＤ｝＃する。*/
大佐_007: {
First, make your way to
the upper section of the
Big Shell.
}
/*まずは『ビッグ・シェル』の上部に
出るんだ。*/
ライデン_008: {
How do I get up to
the next level?
}
/*上部へはどうやって？*/
}//d

//無線機スクリーンに昇降機の映像（ゲーム映像）が流れる。先行映像。ライデンが昇降機を見上げている＋主観映像。昇降機の場所と昇降機がわかる映像。

resource P001_02_R01_オープニング潜入２無線デモ１＿３__e {
大佐_000: {
There's an elevator at the far end
of that area. Use that.
}
/*そのエリアの奥に昇降機がある。
それを使え。*/
ライデン_001: {
Sounds good.
}
/*わかった。*/
}//d

//映像消える。

resource P001_02_R01_オープニング潜入２無線デモ１＿４__e {
大佐_000: {
Your new Sneaking suit uses
electrofiber technology, a by-
product of fiber-optics research.
}//d
/*今回のスニーキング・スーツは
光ファイバーを使った電気紡績技術を
使っている。*/
}
//オープニング潜入３ポリゴンデモ２へ




resource P001_04_R02_オープニング潜入４無線デモ２__e {
//vc110111
大佐_000: {
The hatch with a circular handle
will open into the elevator area.
Locate the hatch first.
}
/*丸いハンドルの付いたハッチが
昇降機エリアへの入口だ。
まずはそれを探してくれ。*/
ライデン_001: {
Copy that. Moving onto
main mission objectives.
}
/*了解、＃｛作戦、ミッション｝＃に入る。*/
}//d

resource P002_02_R01_Ａ脚底部連結ハッチ２無線デモ１＿１__e {
//vc110201
ライデン_000: {
Colonel, I've sighted
an enemy sentry.
}
/*大佐、敵兵を１名確認。*/
}//d

resource P002_02_R01_Ａ脚底部連結ハッチ２無線デモ１＿２__e {
//vc110202
ライデン_000: {
AN-94 and a Makarov...
}
/*ＡＮ９４にマカロフ……。*/
ライデン_001: {
Those grenades... all his
equipment is Russian-made.
}
/*グレネード……ロシア製の装備だ。*/
大佐_002: {
Must be a Gurlukovich man.
}
/*ゴルルコビッチ大佐の部隊だろう*/
ライデン_003: {
Gurlukovich?
}
/*ゴルルコビッチ？*/
大佐_004: {
A Russian private army that was in
line to work with the Shadow Moses
takeover group, four years ago.
}
/*４年前のシャドーモセス事件の際、
テロリストと合流しようとしたロシアの
私兵部隊だ。*/
ライデン_005: {
What's their stake in this one?
}
/*なぜ彼らがこのテロに加わっている？*/
大佐_006: {
They must have made a deal -- an
arrangement with the terrorists.
}
/*テロリスト達とのなんらかの取引が
あったに違いない。*/
大佐_007: {
They've become a band of
mercenaries, an army without
a country.
}
/*もはや彼らは国亡き傭兵部隊と
化している。*/
/*
大佐_008: {
通常、敵は君を見つけると仲間を呼ぶが、
そのエリアに限って言えば、その心配は
ない。
}
大佐_009: {
壁面に埋め込まれた無線通信補助
アンテナが錆び付いているんだ。
そのエリアで敵は無線を使えない。
}
ライデン_010: {
俺達の通信システムには影響ないのか？
}
大佐_011: {
ナノマシンには問題ない。
通常無線のみだ。
}
大佐_012: {
たとえ仲間を呼べなくても、
敵は武装している。
慎重にな、ライデン。
}
*/
}//d


resource P003_02_R02_スネーク昇降機上昇２無線デモ１＿１__e {
//vc110301
ライデン_000: {
Colonel, there's definitely
another intruder in here
besides me.
}
/*大佐、やはり俺の他に誰か侵入者がいる。*/
大佐_001: {
That's not a possibility.
}
/*ありえない事だ。*/
ライデン_002: {
Not a team -- looks like a solo job.
}
/*チームではない。単独のようだ。*/
大佐_003: {
One man...?
}
/*単独だと……？*/
ライデン_004: {
We may not know who he is, but he
managed to take care of every sentry
in the area; they're all out cold.
}
/*素性はわからんが、ここの見張りを
全て片づけてくれたようだ。
みんな気を失っている。*/
ライデン_005: {
Whoever he is, he's got some skills.
}
/*かなりのタフガイだ。*/
大佐_006: {
We need to get an ID... But for
now, you can take advantage of
the situation and get to work.
}
/* 意味が包含されている。008と融合。
大佐_007: {
今のうちにことを進めるとしよう。
}
*/
/*調査が必要だな……
しかし敵が無力化されているのは
とりあえず好都合だ。*/
大佐_008: {
There's a terminal in front
of the elevator, a node.
}
/*昇降機の前に端末がある。
『ノード』と呼ばれるものだ。*/
ライデン_009: {
Did you say "nerd"?
}
/*＃｛まぬけ、ナード｝＃だって？*/
大佐_010: {
Not "nerd" -- "node."
}
/*ノードだ。*/
ライデン_011: {
Oh.
}
/*なるほど、＃｛端末、ノード｝＃か。*/
大佐_012: {
Use the node to gain access to
the Big Shell's facilities network.
}
/*ノードを使えば『ビッグ・シェル』内の
作業支援コンピュータ・ネットワークに
接続できる。*/
ライデン_013: {
Then what?
}
/*何が出来るんだ。*/
大佐_014: {
Pull up the map of the structure;
that'll let you activate the
Soliton Radar.
}
/*『ビッグ・シェル』のマップが参照
出来る。そしてそのデータによって
ソリトン・レーダーが使用可能になる。*/
ライデン_015: {
The Soliton Radar?
}
/*ソリトン・レーダー？*/
}//d
resource P003_02_R02_スネーク昇降機上昇２無線デモ１＿２__e {
//vc110302
//（タンカー編をやってる人）
ライデン_000: {
True, that radar came in
useful during VR training.
}
/*ＶＲ訓練で重宝したレーダーだな。*/
}//d
resource P003_02_R02_スネーク昇降機上昇２無線デモ１＿３__e {
//vc110303
//（タンカー編をやってないひと。全員聞く音声）
大佐_000: {
A radar system -- uses biological
magnetic fields as input.
}
/*人間の生体反応に起因する電磁場を
活用して判定を行うシステムだ。*/
大佐_001: {
These estimated enemy positions
are projected onto a map＃－
}
//<ページ数変更>
大佐_001_1: {
according to reference points
collected via GPS signals and
field personnel reports.
}
/*それらをＧＰＳや各隊員から収集される
エリア測定値により、誤差を修正した
マップ上に投影する。*/
大佐_002: {
We need to get to the map through
the Big Shell's node to put this
data processing to practical use.
}
/*この膨大なデジタル処理を
行う為にもノードによるマップ情報の
ダウンロードが必要なのだ。*/
大佐_003: {
The node unit is about three feet
high -- should be colored blue.
}
/*ノードは１メートルくらいの高さの
青い端末だ。*/
//<ページ数変更>
大佐_003_1: {
Each area has at least one.
}
/* このセリフはカットになった。
usually built right into the
wall.
*/
/*各エリアに最低１台はある。
壁に埋め込まれているはずだ。*/
}//d

resource P003_02_R02_スネーク昇降機上昇２無線デモ１＿４__e {
//vc110304
ライデン_000: {
How do I gain access?
}
/*接続するにはどうすればいい？*/
大佐_001: {
Just push the Action button
in front of the node.
}
/*ノードの前で＃｛△、アクション｝＃ボタンを押すだけだ。*/
大佐_002: {
The nanomachines in your body will
take care of the security clearance,
and allow you access to the node.
}
/*あとは君の体内のナノマシンが自動で
セキュリティを破りノードを使用可能に
してくれる。*/
大佐_003: {
Complete the procedure before
those sentries gain consciousness.
}
/*敵兵達が目覚める前にアクセスを
完了しろ。*/
大佐_004: {
If they spot you, you won't be able
to gain access for a while.
}
/*敵に発見されるとアクセスは一時的に
できなくなる。*/
大佐_005: {
Stay on guard.
}
/*注意するんだ。*/
ライデン_006: {
Got it.
}
/*了解。*/
}//d

resource P004_02_R01_ノード初接続２無線デモ１＿１__e {
//vc110401
大佐_000: {
Good work, Raiden.
}
/*ライデン、ノードにアクセスできた
ようだな。*/
ライデン_001: {
The radar should be
functioning now?
}
/*これでレーダーが使える？*/
}//d

resource P004_02_R01_ノード初接続２無線デモ１＿２__e {
//vc110402
//タンカー編をやっている人
大佐_000: {
Remember your VR training sessions.
}
/*ＶＲ訓練を思い出せ。*/
大佐_001: {
The tool is exactly the same one --
it maps the terrain as well as the
position of enemy personnel.
}
/*ものは同じだ。
地形と敵兵の位置が表示される。*/
}//d

resource P004_02_R01_ノード初接続２無線デモ１＿３__e {
//vc110403
//タンカー編をやっていない人
大佐_000: {
Let me explain about your
Soliton Radar system.
}
/*それではソリトン・レーダーの説明を
しよう。*/
大佐_001: {
The bright dot in the
middle is you, Raiden.
}
/*中心の光点が……ライデン、君の位置だ。*/
大佐_002: {
The red dots are your enemies
and the blue cone shape represents
their field of vision.
}
/*そして赤い光点が敵の位置。
蒼い円錐が敵の視界……。*/
大佐_003: {
Your radar isn't
affected by the weather,
}
/*ソリトン・レーダーは気象には
影響されないが、*/
大佐_004: {
but if you're discovered by
an enemy you won't be able
to use it.
}
/*敵に発見されると
使えなくなる。*/
大佐_005: {
It gets jammed easily I'm afraid.
}
/*うむ、簡単に妨害されてしまうのだ。*/
大佐_006: {
It's all made from currently
existing technology.
}
/*ソリトン・レーダーはもはや既存技術だ。*/
大佐_007: {
You won't be able to use it in
an area with strong harmonic
resonance. So be careful.
}
/*それと音響共鳴の強い空間でも
使えないから注意しろ。*/
}//d

//ムービー終り
resource P004_02_R01_ノード初接続２無線デモ１＿４__e {
//vc110404
#ifdef d:XBOX
大佐_000: {
The Big Shell's layout map should
now be available after touching
the Pause button.
}
#else
大佐_000: {
The Big Shell's layout map should
now be available after touching
the START button.
}
#endif
/*『ビッグ・シェル』全体の構造マップは
ＳＴＡＲＴボタンでいつでも閲覧が
可能だ。*/
ライデン_001: {
How do I save the mission data?
}
/*潜入データの記録は？*/
大佐_002: {
I've set aside a proprietary
frequency for saves. And an
analyst to work on the data too.
}
/*セーブには専用回線を設けてある。
専用のアナリストもな。*/
}//d

resource P004_02_R01_ノード初接続２無線デモ１＿５__e {
//vc110405
ローズ_001: {
Jack -- is everything
all right?
}
/*ジャック……大丈夫？*/
ライデン_002: {
What are you doing here!?
}
/*まさか！*/
ローズ_003: {
Jack, can you hear me?
}
/*ジャック、聞こえる？*/
ライデン_004: {
Rose!
You're not supposed
to be involved!
}
/*ローズ！
どうして君が！！*/
ライデン_005: {
What's going on!?
}
/*なぜ君がそこにいる！？*/
ローズ_006: {
Jack, I'm a part
of this mission.
}
/*ああ、
ジャック……私も作戦に参加するの。*/
ライデン_007: {
Colonel, what the hell
is going on?
}
/*どういう事だ？大佐！！*/
大佐_008: {
Raiden, meet the mission analyst.
She'll be overseeing the data
saving and support.
}
/*ライデン、彼女には今回のデータ記録と
サポートを担当して貰う。*/
ライデン_009: {
Why her?
}
/*なぜ彼女が？*/
大佐_010: {
The FOXHOUND analyst that was
supposed to take part in this
mission was in an accident.
}
/*本作戦に従事する予定だった
ＦＯＸ　ＨＯＵＮＤ部隊のオペレーターが
事故にあい、参加できなくなった。*/
大佐_011: {
Rosemary was brought in
as a replacement.
}
/*それで急遽、
ローズマリー君が選ばれた……。*/
ライデン_012: {
An accident...?
}
/*事故……？*/
大佐_013: {
And according to the files, she
knows you better than anybody
else.
}
/*それに＃｛報告、レポート｝によると……
彼女は君を誰よりも知っている。*/
ライデン_014: {
Rose may be in the service,
but an intelligence analyst
is no field officer.
}
/*彼女は確かに軍人だが……
内勤のデータ・アナリストに過ぎない。*/
大佐_015: {
Not to worry.
She has our technical
staff at her disposal.
}
/*大丈夫だ。うちの専門スタッフが
オペレートする。*/
ライデン_016: {
She's never been a part of a
field mission. This is insane.
}
/*実戦サポートなんて無理だ。
できっこない。*/
大佐_017: {
I have my own reasons for selecting
her for this mission, soldier.
}
/*彼女をこの作戦に参加させたのには、
それなりの理由がある。*/
ライデン_018: {
Colonel, I fail to see --
}
/*大佐、俺には理解できない。*/
大佐_019: {
I know your VR training performance
in and out. But sometimes that's not
enough.
}
/*私は君のＶＲ訓練の成績なら
よく知っている。
しかし、それ以上の事はわからない。*/
大佐_020: {
You're familiar with the
Shadow Moses incident?
}
/*シャドーモセスの事は知っているな？*/
ライデン_021: {
You know I covered it in VR.
}
/*ああ、事件のＶＲも体験した。*/
大佐_022: {
If there's a crucial tactical
detail that case taught us,
}
/*あの事件で立証された。*/
//<ページ数変更>
大佐_022_1: {
it was the power of the operative's
will to survive.
}
/*兵士の士気を持続させる要素……。*/
ライデン_023: {
I was trained to fight. My personal
feelings have no place in a mission.
}
/*俺は軍人として訓練されて来た。
己の感情には左右されない。*/
大佐_024: {
We've learned that it doesn't work
that way. And on the field, you need
all the help you can get.
}
/*そうはいかない。
本作戦に失敗は許されんのだ。*/
ローズ_025: {
Jack? You're stuck with me
whether you like it or not.
}
/*ジャック？
いい、私は最後まであなたにつき合う。*/
ライデン_026: {
Rose...
}
/*ローズ？*/
ローズ_027: {
You need someone to watch
your back. But＃－
}
/*あなたが心配だから……ただし。*/
ローズ_028: {
I have conditions that
need to be met, Colonel.
}
/*条件がある、大佐。*/
大佐_029: {
What is it?
}
/*なんだ？*/
ローズ_030: {
I'll perform my duties and
save that mission data.
}
/*私はこの作戦の＃｛記録、セーブ｝＃を行う。*/
//<ページ数変更>
ローズ_030_1: {
But I'm aware that technically,
I'm not part of the mission control
team.
}
/*でも、私は作戦の一部じゃない。*/
ローズ_031: {
After all, I'm just a normal
girl who's worried about Jack.
}
/*ジャックを案じる普通の女……*/

//<ページ数変更>
ローズ_031_1: {
But that means, Colonel, that I am
not required to follow your orders
outside of my immediate duties.
}
/*だから、
それ以外は大佐達の強制は受けない。*/
ローズ_032: {
Jack is not simply a field
personnel for me to track.
}//<ページ数変更>
/*私にとって、彼は恋人、
ジャックでしかない。*/
ローズ_032_1: {
His safety comes first
to me, not the mission.
}
/*彼の安否が最優先……。*/
ローズ_033: {
And because of that,
I will be monitoring...
}//<ページ数変更>
ローズ_033_1: {
and keeping a record of every
communication you have with
him, Colonel.
}
/*だから、大佐との交信内容も傍聴する。
いえ、記録する。*/
大佐_034: {
... Given the circumstances,
you're free to do what you
see fit.
}
/*……わかった。好きにするがいい。*/
ローズ_035: {
Hey, I prefer this to being
kept in the dark, waiting.
}
/*考えようによっては……
この方がいいかも。何も知らされず、
待つだけなんて辛いだけだもの。*/
大佐_036: {
I'd like to make a request,
if I may.
}
/*一つだけいいか？*/
ローズ_037: {
Of course.
}
/*何？*/
大佐_038: {
His handle is Raiden. For the
duration of the mission, could
you call him that?
}
/*彼の名はライデンだ。
作戦遂行中はコードネームで呼んでくれ。*/
ローズ_039: {
Yes sir.
}
/*わかったわ。*/
ローズ_040: {
All right -- Raiden.
}
/*じゃあ、ライデン？*/
ローズ_041: {
Let me know when you're
ready to turn in a save.
}
/*潜入データを記録したい時は
私に連絡して。*/
ローズ_042: {
The proprietary save frequency
is 140.96.
}
/*周波数は１４０．９６……
＃｛記録、セーブ｝＃用の専用回線よ。*/
}//d

resource P004_02_R01_ノード初接続２無線デモ１＿６__e {
//vc110406
ローズ_000: {
I just switched frequencies.
}
/*今、周波数を変えたわ。*/
ローズ_001: {
Jack?
}
/*ジャック？*/
ライデン_002: {
What?
}
/*なんだ？*/
ローズ_003: {
Do you know what day
it is tomorrow?
}
/*明日、何の日か知ってる？*/
ライデン_004: {
April 30th -- is there something
special about it?
}
/*４月３０日……いや、わからない。*/
ローズ_005: {
Isn't there?
}
/*ほんとに？*/
ライデン_006: {
I can't remember.
I'm sorry.
}
/*いや、悪いが思い出せない。*/
ローズ_007: {
Oh well, I'll keep trying
'til I hear the answer.
}
/*その答えを聞くまではがんばるわ。*/
ローズ_008: {
I'm going to let you go now, Jack.
Take care.
}
/*それじゃ、ジャック。がんばってね。*/
}//d

resource P005_03_R01ライデン昇降機上昇３無線デモ１＿１__e {
//vc110501
ライデン_000: {
Colonel, I'm on the roof. There are
no sentries, but it would only take
one to spot me in this light.
}
/*大佐、『ビッグ・シェル』の屋上に出た。
敵兵は見あたらないが見通しが良すぎる。*/
大佐_001: {
You never had daylight
VR training, after all.
}
/*夜間潜入の訓練しかしていなかったな。*/
大佐_002: {
Stay extra sharp until you can
find a node to log in from.
}
/*ノードにアクセスするまでは、
警戒していくしかない。*/
ライデン_003: {
What about the commandos?
}
/*突入部隊はどうなった？*/
大佐_004: {
SEAL Team 10 has landed
on Struts B and C.
}
/*ＳＥＡＬ１０はＢ脚、Ｃ脚に降下した。*/
ライデン_005: {
And the President?
}
/*大統領は？*/
大佐_006: {
Seems he was spotted
on Strut B.
}
/*Ｂ脚で発見されたらしい。*/
ライデン_007: {
Strut B?
}
/*Ｂ脚？*/
}//d


resource P005_05_R02_ライデン昇降機上昇５無線デモ２__e {
//vc110511
大佐_000: {
First, get to a node.
Log into the network.
}
/*まずはノードを探してみろ。
ノードにアクセスすればわかる。*/
ライデン_001: {
Got it.
}
/*了解。*/
}//d



resource P006_01_R01_Ａ脚金網１無線デモ１__e {
//vc110601
大佐_000: {
Raiden, SEAL Team 10 is in.
}
/*ライデン、ＳＥＡＬ・チーム１０が
突入を開始した。*/
ライデン_001: {
Do we really have no line of
communication with the SEALs?
}
/*ＦＯＸＨＯＵＮＤとＳＥＡＬの
コンセサンスは本当にないのか？*/
大佐_002: {
They don't know a thing about us.
You know we work in the dark,
and this mission is no exception.
}
/*先方は我々の事を何も知らない。
我々は隠密組織だ。任務も機密事項。
*/
//<ページ数変更>
大佐_002_1: {
Only a few people know
about your presence here.
}
/*君の潜入を知る者は極少数だ。*/
ライデン_003: {
...
}
/*……。*/
大佐_004: {
There's no need for concern.
This operation is under Pentagon's
direct command,
}
/*今回の作戦は＃｛国防総省、ペンタゴン｝＃が直接指揮を
取っている。*/
//<ページ数変更>
大佐_004_1: {
and the NSDD (National Security
Decision Directives) came from
the Vice President＃－
}
大佐_004_2: {
and the Secretary of Defense.
}
/*＃｛国家安全保障決定命令、ＮＳＤＤ｝＃も
副大統領と国防省長官によって行われた。*/
大佐_005: {
Your mission may be top-secret,
but it's gone through the usual
channels.
}
/*君の任務は極秘だが正規の手続きに
基づいているんだ。心配するな。*/
}//d


resource P007_01_R01_Ａ脚ノード前１無線デモ１＿１__e {
//vc110701
ライデン_000: {
Colonel, I've located the node,
but it's under heavy surveillance.
I can't get in any closer.
}
/*大佐、ノードを発見したが、
敵が陣取っていて近づけない。*/
大佐_001: {
Distract them. Try making some
noise to draw their attention away.
}
/*敵をおびき寄せるんだ。
音を立ててみろ。*/
ライデン_002: {
How?
}
/*どうやって？*/
大佐_003: {
Flatten yourself against a wall
and hit the Punch button.
}
/*壁にはりついて、＃｛○、パンチ｝＃ボタンだ。*/
}

//小画面に映像。同じシーンで物音を立てるライデン。
resource P007_01_R01_Ａ脚ノード前１無線デモ１＿２__e {
//vc110702
ライデン_001: {
Got it.
}
/*わかった。*/
}//d


resource P008_01_R01_ＡＢ連絡橋１無線デモ１＿１__e {
//vc110801
大佐_000: {
Raiden, watch out. There are
sentries posted on the connecting
bridge.
}
/*ライデン、気をつけろ。
連絡橋の中央に見張りがいる。*/
//<ページ数変更>
大佐_000_1: {
They will spot you if you
continue on course.
}
/*そのまま進めば発見されるぞ。*/
ライデン_001: {
Any recommendations?
}
/*どうすれば？*/
大佐_002: {
Use the Hanging mode.
}
/*＃｛ぶら下がり、エルード｝＃を使うんだ。*/
ライデン_003: {
Hanging?
}
/*エルード？*/
}//d

resource P008_01_R01_ＡＢ連絡橋１無線デモ１＿２__e {
//vc110802
大佐_000: {
Face any waist-high railing and
push the Action button to clear
the railing and hang over the side.
}
/*腰くらいの高さの手すりに向かって
＃｛△、アクション｝＃ボタンを押すと、手すりを乗り越えて
向こう側にぶら下がることが出来る。*/
大佐_001: {
Once there, you can move sideways
while keeping out of enemy sight.
}
/*そのまま移動すれば敵に見つからずに
進めるはずだ。*/
ライデン_002: {
All right, I'm giving it a try.
}
/*わかった、やってみる。*/
大佐_003: {
Don't forget the Grip Gauge.
It will keep decreasing during
a Hanging maneuver,
}
/*＃｛握力、ＧＲＩＰ｝＃ゲージを忘れるな。
エルードしている間、時間と共に
減っていく。
*/
大佐_004: {
and once it runs out,
you will fall.
}
/*ゲージがなくなると落下してしまうぞ。*/
}//d

resource P008_01_R01_ＡＢ連絡橋１無線デモ１＿３__e {
//vc110803
ライデン_000: {
Copy that.
}
/*了解。*/
}//d

resource P008_01_R01_ＡＢ連絡橋１無線デモ１＿ＳＥＡＬＳ無線傍受__e {
//vcxxxxxxxx
大佐_000: {
Wait a second, I just intercepted
new intelligence on the operation
being executed by SEAL Team 10.
}
/*まて、ライデン。
今、ＳＥＡＬ１０突入部隊の無線を
傍受した。*/
ライデン_001: {
Intercepted?
}
/*傍受？*/
大佐_002: {
As I said before, they need to be
kept in the dark about our presence.
}
/*もう一度言うが、彼らは我々の存在を
知らない。*/
ライデン_003: {
So we just listen in...
}
/*盗み聞きってわけか。*/
大佐_004: {
I'm patching it through.
}
/*そっちへ繋ぐ……。*/
//画面にはＳＥＡＬＳの顔は表示されない。画面はライデンと大佐。

シールズ_005: {
This is Alpha Zero.
We have the President.
}
/*こちらアルファー・ゼロ。
大統領を確保……。*/
シールズ隊長_006: {
Is he safe?
}
/*無事か！*/
シールズ_007: {
He is safe.
}
/*無事です。*/
シールズ隊長_008: {
What about the package?
}
/*パッケージは？*/
シールズ_009: {
Tell the guys upstairs that
we've secured the package.
Easy money.
}
/*海軍大佐共々、保護しました。
楽勝でしたよ……。*/
シールズ隊長_010: {
Good work. Your retrieval is
on the way. Come on home...
}
/*よし、ヘリを回す。脱出してくれ……。*/
シールズ_011: {
Roger that...
}
シールズ_011_1: {
H-holy!
}
/*了解……な、なんだ！？*/
//銃声！！無線にノイズが！！
シールズ隊長_012: {
Alpha Zero! Report!!
}
/*どうした！！*/
シールズ_013: {
Dammit!
Cover the President!!
}
/*くっ！大統領を守れ！！*/
シールズ隊長_014: {
Come in, Alpha Zero!
}
/*アルファ・ゼロ！*/
シールズ_015: {
This is Alpha Zero.
We are under attack!
}
/*こちらアルファ・ゼロ。敵と遭遇！！*/
シールズ_016: {
This is crazy!
Is that...!?
}
/*馬鹿な！あれが！？*/
シールズ隊長_017: {
Alpha Zero, respond!
}
/*どうしたアルファ・ゼロ！*/
シールズ_018: {
...
}
/*……。*/
シールズ隊長_019: {
All Alpha, respond!
}
/*オール・アルファ、応答せよ！！*/

//無線通じなくなる

大佐_020: {
Raiden, the President's life is
in danger! Head to Strut B now!
}
/*ライデン、大統領の身が危ない！
Ｂ脚に急いでくれ！*/
}//d



resource P009_01_R01_サイファー遭遇１無線デモ１＿１__e {
//vc110901
大佐_000: {
Raiden, watch your back!
That's a Cypher, a type of UAV!
}
/*ライデン、気をつけろ！
それはサイファー。
＃｛無人偵察機、ＵＡＶ｝＃の一種だ！*/
}//d

resource P009_01_R01_サイファー遭遇１無線デモ１＿２__e {
//vc110902
大佐_000: {
If it spots you, it will alert
enemy personnel. Exercise
extreme caution.
}
/*見つかると敵を呼ばれるぞ。
注意しろ。*/
大佐_001: {
But you can use chaff to set up
an interference field. That'll knock
its sensors offline for a while.
}
/*だがチャフを使って電子妨害を行えば
無力化出来る。*/
//<ページ数変更>
大佐_001_1: {
Try to locate some chaff.
}
/*チャフを探せ！*/
大佐_002: {
You can also destroy the engine or
the camera. Some of the UAV's may
be armed -- be careful.
}
/*あるいはエンジンか、カメラ部分を
破壊するんだ。武装したタイプも
あるかもしれん。気を付けろ。*/
}//d


resource P010_04_R01_ヴァンプ遭遇４無線デモ１＿１__e {
//vc111001
大佐_000: {
What about the President?
}
/*大統領は？*/
ライデン_001: {
Looks like they took him
somewhere else...
}
/*連れ去られたようだ……。*/
大佐_002: {
I see... You said there was a
survivor from SEAL Team 10?
}
/*そうか……ＳＥＡＬ１０に生き残りが
いると言ったな。*/
ライデン_003: {
Yeah.
Lieutenant J.G. Pliskin.
}
/*ああ。プリスキン中尉だ。*/
大佐_004: {
Has he seen your face?
}
/*……顔を見られたか？*/
ライデン_005: {
What?
}
/*なんだって？*/
大佐_006: {
This is a top-secret mission.
No one can know that we're
involved.
}
/*隠密行動だ。誰にも悟られてはならん。*/
ライデン_007: {
It's a little too late for that.
}
/*……もう手遅れだ。*/
}//d



resource P011_01_R01_ＢＣ連絡橋ＣＡＬＬ１無線デモ１＿１__e {
//vc111101
ローズ_000: {
Jack, it's me...
}
/*ジャック、私……。*/
ライデン_001: {
Everything okay, Rose?
}
/*どうした？
ローズ？*/
ローズ_002: {
Don't you need to save
the mission data?
}
/*潜入データの＃｛記録、セーブ｝＃はいいの？*/
ライデン_003: {
Oh yeah -- thanks for the reminder.
}
/*ああ、そうだな……頼むよ。*/
}//d

resource P011_01_R01_ＢＣ連絡橋ＣＡＬＬ１無線デモ１＿２__e {
//vc111102
ローズ_000: {
Jack, do you remember
what day tomorrow is?
}
/*ジャック、明日、何の日だかわかった？*/
ライデン_001: {
That again...
}
/*またか……。*/
ライデン_002: {
I'm sorry, but I still
don't have a clue.
}
/*悪いが思い出せない。*/
ローズ_003: {
That's okay.
}
/*そう……。*/
ライデン_004: {
What is it, Rose?
Talk to me.
}
/*何があるんだ？*/
ローズ_005: {
I'd rather you figure it out.
It's important.
}
/*いいの、あなたが思い出して？
話があるの。*/
ライデン_006: {
How important?
}
/*話？*/
ローズ_007: {
Important enough.
And we'll talk about it,
tomorrow.
}
/*そう、重要な話。
それも明日、話したい。*/
ライデン_008: {
Why not now?
}
/*今じゃダメなのか？*/
ローズ_009: {
Tomorrow seems more -- appropriate.
I need all the help I can get so that
I won't chicken out anyway.
}
/*ええ、明日がいい。
勇気がいるの。*/
ライデン_010: {
Is that the reason you decided
to be part of this mission?
}
/*まさか、その為にこの作戦に？*/
ローズ_011: {
...
}
/*……。*/
ライデン_012: {
OK... I'm going to finish this
thing by tomorrow, no matter what.
}
/*わかった。
明日までにはなんとか任務を完了させる。*/
ローズ_013: {
You know I'll do everything
I can to help you.
}
/*がんばって……。*/
ライデン_014: {
Rose, there's something I need
you to do as an analyst.
}
/*ローズ、データ・アナリストとして、
調べてもらいたい事がある。*/
ローズ_015: {
What is it?
}
/*なに？*/
ライデン_016: {
It has to do with Solid Snake.
}
/*ソリッド・スネークの事だ。*/
//<ページ数変更>
ライデン_016_1: {
The leader of this takeover
incident is claiming that he's
Snake himself.
}
/*今回のテロリストの＃｛首領、ボス｝＃が
そう名乗ってる。
*/
ローズ_017: {
The legendary mercenary?
Hm.
}
/*伝説の傭兵ね。*/
ライデン_018: {
I need as much data on him as
possible. Everything they have on
him after the Shadow Moses incident.
}
/*彼の詳細データが欲しい。
シャドーモセス事件の後、
どうなったか……。*/
ローズ_019: {
He's dead now, isn't he?
}
/*もう亡くなってるんでしょ？*/
ライデン_020: {
Yes.
Should be a burial record
somewhere too.
}
/*ああ。遺体がどこかに
埋葬されているはずだ。*/
ライデン_021: {
You should be able to request
top-level security clearance
from the Colonel.
}
/*大佐に頼めば、最高度のセキュリティ・
クリアランスが貰えるはず。*/
//<ページ数変更>
ライデン_021_1: {
That should get us into the
most classified material.
}
/*どんな極秘ファイルにも近づける。
*/
ローズ_022: {
I'm on it.
}
/*わかったわ。
調べてみる……。*/
ローズ_023: {
I'll contact you as soon
as I find out something.
}
/*何かわかったら、＃｛ＣＡＬＬ、コール｝＃するわ。*/
}//d




resource P012_02_R01_フォーチュン遭遇２無線デモ１＿１__e {
//vc111201
ライデン_000: {
Colonel, SEAL Team 10's
Bravo team was wiped out.
}
/*大佐、ＳＥＡＬ１０ブラボー・チームが
全滅した……。*/
大佐_001: {
I see.
}
/*そうか……。*/
ライデン_002: {
What happened to the cargo
choppers?
}
/*……突入したヘリはどうなった？*/
大佐_003: {
Both of them are at the bottom of
the harbor. Looks like your new
hosts have a Harrier 2.
}
/*……２機共、マンハッタン湾に沈んだ。
奴等はハリアー２を所持しているようだ。*/
ライデン_004: {
A Harrier?
What is this?
}
/*馬鹿な！ハリアーだって？*/
大佐_005: {
Calm down. It just means
they anticipated the attack.
}
/*うろたえるな。
予想されたことだ。*/
ライデン_006: {
What?
}
/*なに？*/
大佐_007: {
Besides, since the SEALs drew
their fire, your infiltration
went off without a hitch.
}
/*彼らがデッドセルを引き付けてくれた
お陰で君の潜入は成功し、*/
//<ページ数変更>
大佐_007_1: {
On top of that, we know their
defensive capabilities.
}
/*敵の戦力も
把握できた……。*/
ライデン_008: {
Are you saying
this was all a feint?
}
/*全て＃｛陽動作戦、フェイント・オペレーション｝＃だったって言うのか！？*/
大佐_009: {
Raiden, get a hold of yourself.
The entire mission is in your
hands now, do you understand?
}
/*ライデン、落ち着くんだ。
これより任務は全て君独りに
託されるんだぞ。*/
ライデン_010: {
But...
}
/*しかし……。*/
大佐_011: {
There's no time for questions.
They could decide to retaliate
for that failed assault.
}
/*迷っている暇はない。
奴等が突入の報復を行うことが
考えられる。*/
ライデン_012: {
You mean the hostages?
}
/*……人質の命が危ないと？*/
大佐_013: {
They could be in danger, yes. But
we need to consider the possibility
that they'll blow the whole Shell.
}
/*それもある。だが同様に警戒すべき
なのは『ビッグ・シェル』が爆破される
可能性だ。*/
大佐_014: {
If that toxic spill does take place,
it'll devastate not only the harbor,
}
/*爆破によって発生する有毒物質が
周辺海域一帯に拡散すれば、湾内だけで
なく沿岸部への影響も計り知れない。*/
大佐_015: {
but poison the coastline
for generations.
}
/*環境回復には何世代もかかる。*/
ライデン_016: {
...
}
/*……。*/
大佐_017: {
Raiden, we've had to adjust
the mission objectives.
}
/*ライデン、作戦を変更する。
大統領の救出は後回しだ。*/
大佐_018: {
The priority is now on removing
those C4's that the terrorists
wired over the Big Shell.
}
//<ページ数変更>
大佐_018_1: {
The President can wait,
but this can't.
}
/*彼らが『ビッグ・シェル』に仕掛けた
Ｃ４を除去してくれ。一刻も早くな。*/
ライデン_019: {
Colonel, you know I'm no
bomb disposal expert.
}
/*……大佐、俺には爆弾処理の経験はない。*/
大佐_020: {
That's not a problem -- the Bravo
team brought an explosives pro in
with them.
}
/*ブラボー・チームと共に爆弾処理の
教官が降下している。*/
大佐_021: {
He was supposed to standby on
Strut C according to their mission
plan. You should find him there.
}
/*ＳＥＡＬ１０の
作戦ではＣ脚に残ることになっていた。
まだそこにいるだろう。*/
ライデン_022: {
Is this according to
simulation too...?
}
/*……これもシミュレーション通りなのか？*/
大佐_023: {
What are you talking about?
Get to Strut C and find him!
}
/*何を言っている？
Ｃ脚に向かうんだ。
彼を探せ。*/
ライデン_024: {
Understood... But I need to ask
you something before I go.
}
/*……了解。
だがその前に、ひとついいか？*/
大佐_025: {
Make it quick.
}
/*なんだ？*/
ライデン_026: {
Who are they -- Dead Cell, I mean?
}
/*奴等は、デッドセルは何者なんだ？*/
ライデン_027: {
They couldn't hit her, no matter
how hard they tried...
}
/*あの女、弾が当たらなかった……。*/
ライデン_028: {
And that vampire too.
It's -- it's like...
}
/*さっきの吸血鬼といい……。*/
ライデン_029: {
It's like being in a nightmare
you can't wake up from.
}
/*そう、悪夢をみているようだ。*/
ローズ_030: {
Jack, snap out of it!
}
/*ジャック、しっかりして！*/
ライデン_031: {
And you Rose -- I can't believe
you're on this mission. I keep
thinking I'll wake up...
}
/*ああローズ。君がこのミッションに
参加している事も信じられない。
いつ目が醒めるかと……。*/
大佐_032: {
Raiden, this is real.
And that's why you won't
wake up.
}
/*ライデン、これは現実だ。
目が覚める事はない。*/
ライデン_033: {
But nothing seems real.
}
/*あまりにも全てが現実離れしている。*/
ローズ_034: {
I've made up my mind to stay with
you. Whether this is real or a bad
dream,
}
/*私は……私は覚悟を決めた。
悪夢でも現実でも、私はあなたを見てる。*/
//<ページ数変更>
ローズ_034_1: {
I'll keep watching you,
till it's over.
}
/*最後まで。*/
ライデン_035: {
Thank you, Rose.
And I won't let you
be just a dream...
}
/*わかったよ。
君だけは、ローズだけは夢であって
欲しくないものだ。*/
大佐_036: {
Are you two done?
Raiden, you're needed
on Strut C.
}
/*話はすんだか？
ならばＣ脚へ向かってくれ。*/
}//d



resource P013_01_R01_ライデン危機無線１無線デモ１＿１__e {
//vc111301
ローズ_000: {
Jack! Are you okay!?
}
/*ジャック！
無事なの！！！*/
大佐_001: {
Rosemary!
}
/*ローズ君！*/
ローズ_002: {
Jack, tell me you're okay.
}
/*ジャック、大丈夫？*/
ライデン_003: {
I'm all right.
It was a close one, though.
}
/*大丈夫だ。
……危なかったが。*/
ローズ_004: {
Oh good...
}
/*……よかった。*/
ライデン_005: {
...
}
/*……。*/
ローズ_006: {
I didn't think it would
be this tough.
}
/*私、甘かったわ。*/
ライデン_007: {
Hey...
}
/*大丈夫か？*/
ローズ_008: {
It's the helplessness of it,
you know.
}
/*辛い……こんなの。*/
ローズ_009: {
Just watching... with
no power to help you.
}
/*ただ傍観しているだけ。何もできない。*/
//<ページ数変更>
ローズ_009_1: {
It's like having a ringside
seat at a boxing match.
}
/*まるでボクシングの試合を観てるみたい。*/
ローズ_010: {
But much worse...
}
/*いいえ、それよりも酷い。*/
ローズ_011: {
Because it's someone I love
and the stakes are --
}
/*自分の大切な人が……。*/
大佐_012: {
Rosemary -- maybe this was
a miscalculation on my part.
}
/*ローズ君……
私の間違いだったかもしれん。*/
大佐_013: {
Selecting her wasn't
the wisest choice.
}
/*やはり彼女には無理だったようだ。*/
ローズ_014: {
No, no, I apologize
for the outburst.
}
/*いえ、ごめんなさい。*/
ローズ_014_1: {
I'm all right.
I will see this through
with you.
}
/*私、大丈夫。最後までつき合う。
*/
ライデン_015: {
Rose?
}
/*ローズ？*/
ローズ_016: {
We fight together, ok? You have
nowhere to run, neither do I.
}
/*私も一緒に闘う。
彼も逃げられない。
だから私も逃げない。*/
大佐_017: {
Rosemary, you're not obligated
to continue, you know that.
}
/*ローズ君、無理はせんでもいい。*/
ローズ_018: {
I'm all right, sir.
}
/*私、できるわ。*/
大佐_019: {
Hmm...
}
/*うむ……。*/
大佐_020: {
Raiden, how about you?
}
/*ライデン、君の方はどうだ？*/
ライデン_021: {
I'm good.
}
/*ああ、大丈夫だ。*/
大佐_022: {
Then the mission goes on.
}
/*よし、ではこのまま続けて貰う。*/
大佐_023: {
But Rosemary, there's one thing
you need to understand.
}
/*ただし、いいかね。ローズ君？*/
ローズ_024: {
Sir?
}
/*はい？*/
大佐_025: {
His name is Raiden.
Got it?
}
/*彼はライデンだ。わかったか？*/
ローズ_026: {
Yes sir.
I understand.
}
/*え、ええ。
わかってます……。*/
}//d





resource P014_05_R01_ピーター遭遇５無線デモ１＿１__e {
//vc111401
大佐_000: {
Glad to hear Stillman is safe.
}
/*ライデン、スティルマンが
無事だったのは何よりだ。*/
大佐_001: {
Assist him in any way possible to
clear the C4 from the structure.
}
/*彼と協力して『ビッグ・シェル』内の
Ｃ４を解除してくれ。*/
ライデン_002: {
Colonel, you know I've never
been trained in bomb disposal.
}
/*大佐、俺は爆弾解体の訓練なんて、
受けたことがない。*/
大佐_003: {
It's all right. The man you're
working with is the best in the
field.
}
/*大丈夫だ。そこにいる男は爆弾処理の
専門家だ。超一流のな。*/
//<ページ数変更>
大佐_003_1: {
All you have to do is
follow his directions.
}
/*彼の指示に
従ってくれ。*/
大佐_004: {
You will of course keep your
identity and mission objectives
to yourself.
}
/*ただし、ライデン。こちら側の素性や
ミッションについてはいっさい話すな。*/
ライデン_005: {
Is it true that an engineer
came in with Stillman?
}
/*スティルマンと一緒に技術者が降下した
という話は本当なのか？*/
大佐_006: {
I wasn't informed of that. It's
probably something the SEALs
decided on their own.
}
/*いや、我々も聞いていない。
ＳＥＡＬ１０の独自行動だろう。*/
ライデン_006: {
...
}
/*……。*/
大佐_007: {
There are more important issues
at hand, Raiden. The enemy may
retaliate for the failed assault.
}
/*そんなことより、先ほどの突入に対する、
報復が考えられる。*/
//<ページ数変更>
大佐_007_1: {
Get those C4's neutralized now.
}
/*爆弾の除去を急いで
くれ。*/
ライデン_008: {
Colonel, I'm not qualified
for bomb disposal.
}
/*……大佐、爆弾解体など、
俺にはできない。*/
ローズ_009: {
Jack, it's me.
}
/*ジャック、私……。*/
ライデン_010: {
Rose?
}
/*ローズ？*/
ローズ_011: {
You can do this.
Trust me.
}
/*大丈夫、あなたならできる。
きっとできる。*/
大佐_012: {
You haven't had bomb disposal
training per se in VR, but you're
more than capable of handling C4.
}
/*確かに爆弾解体のＶＲ訓練は受けて
いないが、Ｃ４の取扱いは訓練済み
だろう。*/
ライデン_013: {
...This is a little
different from using C4.
}
/*……Ｃ４を仕掛けるのとは訳が違う。*/
ローズ_014: {
You're up for this.
You know that.
}
/*大丈夫。
できるわ、あなたなら……。*/
//口ぱくはいりません。
プリスキン_015: {
How about it, kid?
Are the results in yet?
}
/*どうだ、若いの。結論は出たか？*/
}//d



resource P015_01_R1_爆弾解体最初の一つ１無線デモ１＿１__e {
//vc111501
ピーター_000: {
That's not like him...
}
/*そうか、あいつらしくない……。*/
ライデン_001: {
Anything wrong?
}
/*何かおかしな点でも？*/
ピーター_002: {
Maybe. Pliskin's reported other
locations too, and none of them
are effective demolition points.
}
/*ああ、
プリスキンの報告も聞いているが……
どこも効果的な位置ではない。*/
ライデン_003: {
What do you mean?
}
/*どういう事だ？*/
ピーター_004: {
It means that they wouldn't be
the best places to choose if you
wanted to destroy this place.
}
/*ここを沈める為の最適な設置場所では
ない。*/
ライデン_005: {
Are you saying they don't plan
on blowing the Shell up?
}
/*沈めるつもりはないということか？*/
ピーター_006: {
It certainly seems that way. So far,
we haven't seen anything but a waste
of good explosives.
}
/*うむ、明らかに爆薬の無駄遣いだ。*/
//<ページ数変更>
ピーター_006_1: {
Unless of course, we're
missing something...
}
/*あるいは、何か見落としているのか……。*/
ライデン_007: {
A trap?
}
/*罠？*/
ピーター_008: {
He couldn't have overlooked the
fact that I would be called into
this. There's something going on.
}
/*あいつは私がでてくる事を予期していた
はず。何かありそうだ。*/
}//d




resource P016_01_R1_爆弾解体半分解体１無線デモ１＿１__e {
//vc111601
ピーター_000: {
This is all wrong.
This is something only
an amateur would do.
}
/*おかしい。これじゃまるで、素人だ。*/
ライデン_001: {
What do you mean?
}
/*どういうことか、話してくれ？*/
ピーター_002: {
All the bombs that have been
found so far don't appear to be
in the right kind of locations.
}
/*これまでに設置されていたどのＣ４も
適切な場所とは思えない。*/
//<ページ数変更>
ピーター_002_1: {
And the quantity of explosives
isn't sufficient either.
}
/*爆薬量も
最適ではない。*/
ライデン_003: {
Even Fatman can make
mistakes, right?
}
/*ファットマンにも間違いはある。*/
ピーター_004: {
No. there's something
else going on here...
}
/*いや。何かある……。*/
ピーター_005: {
Get a move on with the disposal,
Raiden. I've got a bad feeling
about this.
}
/*急いでくれ、ライデン。気になる。*/
ライデン_006: {
Do you think it's a trap?
}
/*囮なのか？*/
ピーター_007: {
I don't know, but I'm going to
tell Pliskin to watch his back too.
Just hurry.
}
/*わからない。
プリスキンにも用心するよう伝えておく。
頼むぞ。*/
}//d



resource P017_01_R01_爆弾解体中ローズその１無線デモ１＿１__e {
//vc111701
ローズ_000: {
Jack -- it must be so nerve-racking
to defuse a bomb...
}
/*ジャック、爆弾解体って……
すごく神経を使うでしょ？*/
ライデン_001: {
Yeah, I'd say so.
}
/*当たり前だ。*/
ローズ_002: {
OK, that was a stupid thing
to say. Sorry.
}
/*ああ、ごめん。無神経だったわね。*/
ライデン_003: {
That's all right. It's just that
I've never been trained in this
stuff.
}
/*いや……
ただ訓練ではやらなかったからな。*/
ローズ_004: {
You okay?
Are you feeling well?
}
/*大丈夫？まいってない？*/
ライデン_005: {
I almost threw up a few times.
}
/*何度も吐きそうになった。*/
ローズ_006: {
Oh Jack...
}
/*ジャック？*/
ライデン_007: {
But I'm okay.
It's not like I'm in this alone.
}
/*でもまだ大丈夫だ。
ひとりでや
ってる訳じゃない。*/
ローズ_008: {
Oh -- yeah, that's true.
}
/*……そ、そうね。*/
ローズ_009: {
What do you think about when
you're defusing those things?
}
/*解体している時って、
どんな事を考えるの？*/
ライデン_010: {
I don't think so much as remember.
And I know that I need to resist
that, and keep my mind blank.
}
/*いろんな事が思い出される……
でも、それらを押し込める事が
大切なんだ。
無心にならないと……*/
ライデン_011: {
I can't let myself be overwhelmed
by the fear.
}
/*恐怖に飲まれてはいけないらしい。
*/
ローズ_012: {
So, am I a part of what you
try not to remember?
}
/*私の事なんかも考えるの？*/
ライデン_013: {
...
}
/*……。*/
ローズ_014: {
I was just kidding. But I guess
this isn't a good time for that.
}
/*ごめんなさい、こんな時にね。*/
ライデン_015: {
No, it is. And I do think about you.
I'm trying to remember what's so
special about April 30th.
}
/*いいんだ。そうだな、
４月３０日が何の日か？
それを考えている。*/
ローズ_016: {
Any success?
}
/*思い出した？*/
ライデン_017: {
No, not yet.
}
/*いや、まだだ。*/
ローズ_018: {
You need to stay
alive so you can.
}
/*思い出すまで、死んじゃダメよ。*/
ライデン_020: {
Okay, that's a deal.
}
/*わかった……。*/
}//d



resource P018_01_R01_爆弾解体中ローズその２無線デモ１__e {
//vc111801
ローズ_000: {
Hey Jack? I bet bomb disposal's
a lot like starting a relationship.
}
/*ジャック、教えて？
爆弾解体って、女の子を口説くような
もの？*/
ライデン_001: {
Huh?
What are you talking about?
}
/*どういう意味だ？*/
ローズ_002: {
Carefully dismantling emotional
defenses, being on your toes
constantly...you know?
}
/*壊さないように、慎重に、慎重に……。
心の防御を一枚、一枚、剥がしていく
みたなもんでしょ？*/
ライデン_003: {
I guess. Neither of them
are my strong point.
}
/*そうだな、一理あるかも。
まあ、俺には苦手な分野だ。*/
ローズ_004: {
It's true that you're not the
most patient man in the world.
}
/*そうね、ジャックはせっかちだから。*/
ライデン_005: {
It's not that.
I like to leave things
as they are.
}
/*いや、外から眺めている方が好きなんだ。*/
ローズ_006: {
Are you afraid of what
might be hidden inside?
}
/*人の真実に触れるのが怖い？*/
ライデン_007: {
Not afraid, just -- unwilling...
to deal with complications.
}
/*面倒なんだ。厄介事が。*/
ローズ_008: {
Like me?
}
/*私の事も？*/
ライデン_009: {
You're --
}
/*それは……。*/
ローズ_010: {
Hey Jack?
}
/*ねえ、ジャック？*/
ライデン_011: {
Yeah?
}
/*ああ？*/
ローズ_012: {
Do you know why
I took this job?
}
/*今回の任務を引き受けたの、
なぜだかわかる？*/
ライデン_013: {
?
}
/*？*/
ローズ_014: {
I wanted to see what
you were really like.
}
/*あなたの心を覗いてみたかったの。
私のしらない、本当のあなた。*/
ライデン_015: {
But we've been together a while.
You know me already.
}
/*いつもそばにいたじゃないか？*/
ローズ_016: {
No -- you never let me in past a
certain point. And I need to know
what's there.
}
/*いいえ、あなたいつも心を閉ざしていた。
それが何か、知りたいの。*/
ライデン_017: {
...Hahhhh.
Are you trying to
take me apart now?
}
/*……ふむ……
これじゃ、こっちが解体されそうだ。*/
ローズ_018: {
Hey, it's not important.
}
/*ごめん、冗談よ。*/
ローズ_019: {
Good luck, Jack.
}
/*がんばってね、ジャック。*/
}//d



resource P019_01_R01_爆弾解体中ローズその３無線デモ１＿１__e {
//vc111901
ローズ_000: {
Jack, do you remember
the day we met?
}
/*ジャック、私たちの出逢い、憶えている？*/
ライデン_001: {
I'm kinda busy right now, Rose.
}
/*こんな時に、なんだ？
*/
ローズ_002: {
You're right, sorry.
}
/*ごめんなさい、そうね……。*/
ライデン_003: {
I do remember.
}
/*ああ……憶えているよ。*/
ライデン_004: {
It was right after I
transferred to New York.
}
/*俺がＮＹに移ってきた直後だった。*/
//<ページ数変更>
ライデン_004_1: {
There were all these tourists
around you, in front of the
Federal Hall.
}
/*そう、フェデラルホールの前……
君は観光客の一団に囲まれていた……。*/
ローズ_005: {
A group of middle-aged Japanese
ladies came up and asked me,
}//<ページ数変更>
/*質問をされてたの。日本から来た
おばさん達に。*/
ローズ_005_1: {
which building it was that King Kong
was climbing in the movie.
}
/*キングコングの登った
ビルはどれか？って。*/
/* テロ事件対応でカット */
/*
ライデン_006: {
You pointed out the
World Trade Center.
}
*/
/*君は世界貿易センタービルを指して
答えた。*/
/* テロ事件対応でカット */
/*
ローズ_007: {
But the ladies
weren't convinced.
}
*/
/*でもおばさんはそのビルを見て
納得しなかった。*/
/* テロ事件対応でカット */
/*
ライデン_008: {
The tourists were talking about
the black and white King Kong.
}
*/
/*おばさんはモノクロのキングコングの
方を観ていたんだ。*/
ローズ_009: {
I said it was probably
the Chrysler Building.
}
/*私はおそらく、クライスラービルだと
言った。*/
/* テロ事件対応でカット */
/*
ライデン_010: {
You hadn't seen the black
and white original.
}
*/
/*そう、君はモノクロ版を観ていなかった。*/
/* テロ事件対応で一部セリフカット */
/*ローズ_011: {
I just vaguely remembered the
pictures. And then you showed up
and started mouthing off.
}
*/
ローズ_011: {
And then you showed up
and started mouthing off.
}
/*ええ、うろ憶えだった。
そこへあなたが現れて割り込んできた。*/
ローズ_012: {
You were like,
"No, it's the Empire State."
}
/*違う。エンパイアステートビルだ。*/
ライデン_013: {
I said the Chrysler Building
was in Godzilla.
}
/*クライスラービルが壊れたのはゴジラだ。
といった。*/
ローズ_014: {
Ha ha ha...
}
/*ふふ……。*/
ローズ_015: {
We started arguing, and I forgot
all about the tourists.
}
/*私たちはおばさん達、そっちのけで
討論を始めた。*/
ローズ_016: {
I was insisting that I was right,
and you were doing the same...
}
/*自分こそが正しいと主張して……。*/
ライデン_017: {
The next thing we knew,
the Japanese women had
gone away.
}
/*気が付くと、観光客はいなくなっていた。*/
ローズ_018: {
And we ended up going to the
Skyscraper Museum to see who
had the better recall.
}
/*そこで、お互いの言い分を
立証するために、摩天楼博物館に
向かう事になった。*/
ライデン_019: {
We argued all the way
to Battery Park.
}
/*そうだ。バッテリーパークまで口論を
続けながら歩いた。*/
ローズ_020: {
And for nothing!
}
/*でも、結論はでなかった。*/
ライデン_021: {
Since the museum was closed.
}
/*博物館は休館だったんだ。*/
ライデン_022: {
We went our separate ways
from the museum.
}
/*博物館の前で俺達は別れた。*/
ライデン_023: {
And then I found you again by
coincidence out in the base
corridor.
}
/*１週間後、偶然君を基地の廊下で
見つけた。*/
ローズ_024: {
An amazing coincidence -- that we
were actually working at the same
place.
}
/*ええ、偶然だった。
同じところで働いたなんてね。*/
ライデン_025: {
That night, we went up to
the top of the Empire State.
}
/*俺達はその夜、
エンパイアステートビルの屋上へ行った。*/
ローズ_026: {
It was so beautiful --
}
/*綺麗だった。*/
//<ページ数変更>
ローズ_026_1: {
I could look down on the Chrysler
Building from a hundred and twenty
stories above ground.
}
/*地上１２０階から観る
クライスラービル……。*/
ライデン_027: {
I felt -- overwhelmed.
}
/*圧倒された……。*/
ライデン_028: {
I didn't care anymore
who was right.
}
/*どちらが正しいなんて、もうどうでも
良くなってた。*/
ローズ_029: {
And that was our first date.
}
/*あれが私たちの最初のデート。*/
ライデン_030: {
We watched "King Kong" in your
apartment a bunch of times that
night.
}
/*その晩、君の部屋でキングコングの
ビデオを何度も見た。*/
ライデン_031: {
Didn't sleep till morning...
}
/*朝まで……。*/
ローズ_032: {
...
}
/*……。*/
ライデン_033: {
If it weren't for that coincidence,
we wouldn't be together.
}
/*あの偶然がなければ俺達は出会って
いなかった。*/
ローズ_034: {
I know...
}
/*そうね……。*/
ローズ_035: {
I'm sorry Jack.
I'm taking up your time again.
}
/*ジャック、ごめんなさい。
時間を無駄にしたわね。*/
ライデン_036: {
What?
}
/*え？*/
ローズ_037: {
Take care.
}
/*それじゃ、がんばって。*/
}//d



resource P020_01_R01_地雷原１無線デモ１＿１__e {
//vc112001
オルガ_000: {
Be careful!
There are Claymore mines
around there.
}
/*気をつけろ！！*/
/*
オルガ_001: {
There are Claymore mines
around there.
}
*/
/*そこにはクレイモア地雷が
セットされている。*/
ライデン_002: {
Who is this!
}
/*なんだっ！*/
}//d
//無線機のスクリーンにＥＦ連絡橋の映像が映る
resource P020_01_R01_地雷原１無線デモ１＿２__e {
//vc112002
オルガ_000: {
Stealth-equipped Claymore mines,
invisible to the naked eye.
}
/*ステルス装備のクレイモアだ。
肉眼では見えない。*/
オルガ_001: {
Use the mine detector.
}
/*地雷探知機を使え！*/
ライデン_002: {
Identify yourself.
}
/*誰だ、おまえは？*/
オルガ_003: {
Just call me "Deepthroat."
}
/*ディープ・スロートとでも
名乗っておこう。*/
ライデン_004: {
Deepthroat?
You mean from Shadow Moses?
}
/*ディープ・スロート？
シャドー・モセス事件の？*/
オルガ_005: {
Mr. X, then.
}
/*いや、ミスターＸとでも言っておこう。*/
ライデン_006: {
Mr. X now, is it? Why would it
matter if I called you Deepthroat?
}
/*ミスターＸ？
どうした？
なぜ言い直す？*/
オルガ_007: {
Never mind about that.
}
/*そんな事はどうでもいい。*/
ライデン_008: {
Why did you contact me?
}
/*何者だ、なぜ俺に忠告を？*/
オルガ_009: {
Let's just say I'm
one of your fans.
}
/*ファンの一人だよ。*/
}//d
resource P020_01_R01_地雷原１無線デモ１＿３__e {
//vc112003
ライデン_000: {
Colonel, someone calling himself
Mr. X just contacted me. Do you
know anything about it?
}
/*大佐、ミスターＸという人物から
無線連絡が入った。何者だ？*/
大佐_001: {
No -- and whoever it was, it
wasn't a burst transmission.
}
/*わからない。バースト通信では
なかったようだ。*/
//<ページ数変更>
大佐_001_1: {
The transmission was sent
from within the Big Shell.
}
/*『ビッグ・シェル』
内部から発信されている。*/
ライデン_002: {
He called himself "Deepthroat"
at first. Do you think -- ?
}
/*やつは最初、ディープ・スロートと
名乗った。まさか……？*/
大佐_003: {
I caught that part too, but the
possibility of it being true is
none.
}
/*ああ、私も聞いた。
しかし、それはありえん事だ。*/
大佐_004: {
Gray Fox was the one who used
that alias in Shadow Moses, and
he's dead.
}
/*シャドーモセス事件でその名を語った
グレイ・フォックスは既に死んでいる。*/
ライデン_005: {
Is it an enemy trap?
}
/*敵だと思うか？*/
大佐_006: {
Could be.
Exercise extreme caution.
}
/*わからん……注意しろ。*/
}//d

//ここ

resource P021_02_R01_爆弾解体オルガ登場２無線デモ１＿１__e {
//vc112101
ライデン_000: {
I saw a female soldier -- Russian.
}
/*ロシア人の女兵士を見かけた。*/
プリスキン_001: {
Must be Olga Gurlukovich.
}
/*ああ、
彼女はオルガ・ゴルルコビッチ……。*/
ライデン_002: {
How do you know?
}
/*何故、知ってる？*/
プリスキン_003: {
Unlike you, I've been briefed.
}
/*お前と違って、ブリーフィングを
受けたからな。*/
ライデン_004: {
She's not a Dead Cell?
}
/*デッドセルではないのか？*/
プリスキン_005: {
No, she commands
a Russian private army.
}
/*ロシア私兵部隊のリーダーだ。*/
ライデン_006: {
They must be the ones
patrolling the Big Shell.
}
/*『ビッグ・シェル』内を巡回している
奴等だな。*/
プリスキン_007: {
That's right. She's led the group
ever since her old man, Colonel
Gurlukovich, died.
}
/*ああ。親父のゴルルコビッチ大佐が
死んで以来、彼女が部隊を統率している。*/
プリスキン_008: {
Watch yourself with her.
She's a tough one.
}
/*あの女には注意するんだ。
かなりできるぞ。*/
}//d



resource P022_01_R01_爆弾解体最後から二つ目１無線デモ１＿１__e {
//vc112201
ピーター_000: {
Good work.
Only one more left to go...
}
/*よくやった。残りは後、一つ……。*/
}//d
resource P022_01_R01_爆弾解体最後から二つ目１無線デモ１＿２__e {
//vc112002
プリスキン_001: {
This is Pliskin.
Do you read me, Pete?
}
/*こちらプリスキン、親父さん、
聞こえるか？*/
ピーター_002: {
I'm here. What's up?
}
/*こちら、スティルマン。
どうした？*/
プリスキン_003: {
Raiden, you need
to hear this too.
}
/*ライデンも聞いてくれ。*/
ライデン_004: {
I'm listening.
}
/*聞いてる。*/
プリスキン_005: {
I checked out the bottom
of Strut H for you, Pete.
}
/*親父さんに言われて、
Ｈ脚の脚底部を調べてみた。*/
ライデン_006: {
Wait -- what's this about?
}
/*何を？*/
ピーター_007: {
I asked Pliskin
to look around.
}
/*私がプリスキンに頼んだのだ。*/
//<ページ数変更>
ピーター_007_1: {
Knowing Fatman, I can't shake the
feeling that all the bombs so far
were just wrong.
}
/*爆薬をセットする位置の選択が、
ファットマンらしくない……。*/
ライデン_008: {
So did you find anything?
}
/*それで？*/
プリスキン_009: {
A hell of a lot of C4's packed
into the bottom of the strut.
Pete called it right.
}
/*あんたの言う通り、脚底部にＣ４が
大量にセットされていた。*/
ピーター_010: {
I knew he had the real
thing up his sleeve...
}
/*やはりな。
あいつめ……それが本命だ。*/
ライデン_011: {
So all the other ones
were dummies?
}
/*それじゃ、今までのはダミー？*/
ピーター_012: {
No, they're a threat all right,
but the detonation wouldn't be
enough to destroy the entire Shell.
}
/*いや、どれも脅威である事は
間違いないが、１つの爆発でこの
『ビッグ・シェル』が沈む程ではない。
*/
ピーター_013: {
But the C4's Pliskin found would
inflict serious structural damage.
}
/*しかし、その脚底部は違う、
かなりのダメージになる。*/
プリスキン_014: {
That's not the bad news either.
These are sensor-proof.
}
/*それだけじゃない。
その爆弾はセンサーに反応しない。*/
ピーター_015: {
What!
}
/*なんだと！？*/
プリスキン_016: {
New model, I guess.
The ionization sensor
can't detect them.
}
/*新型だ。
臭いセンサーではつかめない。*/
プリスキン_017: {
The whole thing is sealed tight to
prevent vapor leak, and there's no
trace of that cologne signature.
}
/*Ｃ４から発生する気化ガスが外に
漏れない様、厳重にシールドしてある。
サインの香水もない……。*/
プリスキン_018: {
Pete, looks like
he fooled you.
}
/*親父さん、読みは外れたな？*/
ピーター_019: {
Yes...
}
/*……うむ……。*/
ライデン_020: {
But you managed to
find the thing anyway?
}
/*よく見つけたな？*/
プリスキン_021: {
It was sheer luck.
}
/*全くの偶然だ。
危ないところだった……。*/
ライデン_022: {
Bombs that are invisible
to the sensor...
}
/*センサーに反応しない爆弾……。*/
プリスキン_023: {
Any ideas, Pete?
}
/*親父さん、どうしたらいい？*/
ライデン_024: {
Are there more out there?
}
/*他にもあるんだろうか？*/
ピーター_025: {
I'll go see for myself.
}
/*……わかった。私が行く。
見てみなければわからん。*/
ライデン_026: {
You can't move fast enough.
}
/*その足じゃ無理だ。*/
プリスキン_027: {
He's right. I can try
the spray from a distance.
}
/*そうだな。
冷却スプレーで試してみよう。*/
ピーター_028: {
Hold on!
There's something not right
about this one, I can feel it.
}
/*待てっ！こいつには何かある！！*/
プリスキン_029: {
Well, Pete?
Should I come back and get you?
}
/*どうする？
親父さん、迎えに行ってやろうか？*/
ピーター_030: {
No, there's no need.
Raiden, you have one
left to go, correct?
}
/*いや、大丈夫だ。
ライデンは後、一つだったな？*/
ライデン_031: {
Right -- except for
those scentless ones.
}
/*そうだ。ただし、『臭いのあるＣ４』は、
という意味だが。*/
ピーター_032: {
How about you, Pliskin?
}
/*プリスキンは？*/
プリスキン_033: {
I have two left not
counting this one.
}
/*俺はこいつを除いても後、２つ……。*/
ピーター_034: {
OK... It'll have to be me. I have
the level 4 card that'll get me
into Shell 2 in any case.
}
/*うむ……やはり、私が行く。
シェル２へ行けるカード４も持っている。*/
ライデン_035: {
You'll never make it. With that
bad leg of yours, they'll spot
you for sure.
}
/*無理だ。
その脚では途中で敵に見つかる……。*/
ピーター_036: {
That won't happen.
I...
}
/*その心配はいらん。
実は……。*/
ピーター_037: {
I can walk just fine.
}
/*私は歩けるのだ。*/
ピーター_038: {
I can even run...
}
/*そればかりか、走ることもできる……。*/
プリスキン_039: {
What do you mean?
}
/*どういう事だ……。*/
ピーター_040: {
That bomb, five years ago.
I messed up. Even with all
my experience, I lost it.
}
/*５年前の事だ。
年甲斐もなく、びびってしまった。*/
ピーター_041: {
And a church was lost in the
explosion. All those kids
playing nearby too...
}
/*おかげで教会が爆発した。
近隣の子供たちも巻き添えを食った。*/
//<ページ数変更>
ピーター_041_1: {
These past five years,
I've lived a lie.
}
/*この５年間、私は嘘をついてきた……。*/
ライデン_042: {
Lied?
}
/*嘘？*/
ピーター_043: {
Yes, lied. I didn't lose
my leg in the explosion.
}
/*そうだ。
私は右足を失ってなどおらん。*/
プリスキン_044: {
...
}
/*……。*/
ピーター_045: {
So many dead -- all
because of my mistake.
}
/*私の失敗で……
あまりにも多くの犠牲が出た。*/
ピーター_046: {
All I could think about was hiding
from the crime, shielding myself
from the public outcry.
}
/*私は……
あろう事か、世間の同情を買おうとした。
*/
ピーター_047: {
I wanted people to be sorry
for me, for my weakness...
}
/*攻撃の目をそらそうとした。
非難を逃れようとした。*/
ライデン_048: {
...
}
/*……。*/
ピーター_049: {
I faked being a victim myself
because I couldn't bear to face
the families of the real victims.
}
/*周りの視線から逃れるために、
仮病を使ったのだ。*/
ピーター_050: {
This is no prosthetic. I can
keep my footing on catwalks
and hike over deserts.
}
/*私の脚は義足ではない。
歩くことも、走ることもできる。*/
ピーター_051: {
I lived my lie so well I
haven't even answered to
myself for my sins...
}
/*私は嘘をつくことで、
自分の罪から逃れてきた。*/
ピーター_052: {
It was supposed to be a shield.
}
/*世間への嘘だったはずが……。*/
ピーター_053: {
And it's become a shroud instead.
}
/*時を経る毎に己への嘘となっていった。*/
ピーター_054: {
I've killed my soul by
playing the victim.
}
/*自ら被害者を演じることで、世間を、
いや自分を騙してきた。*/
ピーター_055: {
Instead of protecting me,
it's made my life even more
hellish.
}
/*身を守るはずの嘘が、やがて自分への
重圧へと変わっていった。*/
プリスキン_056: {
What good can that
do the victims?
}
/*そんな事で犠牲者が浮かばれるとでも？*/
ピーター_057: {
I know -- I'm a coward!
}
/*そうだ、私は卑怯者だ！*/
プリスキン_058: {
Hey, Pete...
}
/*親父さん……。*/
ピーター_059: {
God forgive me...
}
/*許してくれ！*/
ピーター_060: {
I can walk with my own two feet.
}
/*若者たちよ。
いいか、私は歩ける。*/
ピーター_061: {
And I need them to stop Fatman.
His crimes are also mine -- one
of omission, and arrogance.
}
/*ファットマンは私が止めねばならん。
あいつの暴走も私の責任……私の罪だ。*/
ピーター_062: {
No one should teach the skills
I taught him without a clear
conscience.
}
/*自分を欺き、大切なものを何も
伝えられなかった、私の……。*/
ピーター_063: {
This is the only way
I can defuse my own sins.
}
/*これから自分の罪を解体しにいく！*/
プリスキン_064: {
I get you, Pete.
That one's all yours.
You got it, Raiden?
}
/*わかった、親父さん。任せる。
……ライデンもいいな。*/
ライデン_065: {
I understand.
}
/*ああ……。*/
プリスキン_066: {
Pete, I've taken care of
guards in Struts G and H
of Shell 2.
}
/*親父さん、シェル２のＧ脚とＨ脚の
敵兵は排除した。*/
//<ページ数変更>
プリスキン_066_1: {
I wouldn't recommend you go
into any of the other struts.
}
/*他の脚へは出入り
するなよ。*/
ピーター_067: {
I owe you one.
}
/*すまんな。*/
プリスキン_068: {
I'll get back to freezing
the baby bombs then.
}
/*それじゃ、俺は爆弾解体を続ける。*/
ピーター_069: {
You do that too, Raiden.
}
/*ライデンも解体に戻ってくれ。*/
ライデン_070: {
I'm on it.
}
/*わかった。*/
ピーター_071: {
I'll have the radio with me,
if you need to get in touch.
}
/*無線機を持っていく。
何かあれば連絡をくれ。*/
ピーター_072: {
Just don't ask for "Peg-Legged
Peter." He's gone for good.
}
/*『義足のピーター』のニックネームも
今日で終わりだ。*/
}//d


resource P023_01_R01_爆弾解体最後の一つ１無線デモ１＿１__e {
//vc112301
ライデン_000: {
I have the last C4 frozen.
There's nothing showing
up on the sensor now.
}
/*最後のＣ４を解体した。
センサーに映るものは、もうない。*/
ピーター_001: {
Good work, Raiden.
}
/*よし。
よくやった、ライデン。*/
プリスキン_002: {
You're way ahead of me, kid.
I still have one to go.
}
/*先を越されたな。
俺の方はまだ１つ残っている。*/
ライデン_003: {
How's your bomb, Peter?
}
/*スティルマンの方は？*/
ピーター_004: {
It's a bomb all right.
Sealed C4, and in huge
quantities...
}
/*間違いない。無臭のＣ４だ。
しかも、凄い量だ……。*/
ライデン_005: {
You think there's
another one in Shell 1?
}
/*シェル１にもあると思うか？*/
ピーター_006: {
For sure. Somewhere at
the bottom of Strut A.
}
/*ある。
おそらく、Ａ脚底部のどこか。*/
ライデン_007: {
Why are you so certain?
}
/*確かか？*/
ピーター_008: {
If this bottom section of the strut
is demolished, Shell 2 will be well
on its way to destruction.
}
/*この脚底部を破壊すると、
シェル２はほぼ壊滅する。*/
プリスキン_009: {
You mean that Shell 2
will actually sink?
}
/*シェル２が沈むという事か？*/
ピーター_010: {
Not immediately. There'll
still be five struts left.
}
/*いや、すぐには沈まん。
この脚が破壊されてもまだ５脚
残っている。*/
/* 以下は無しだったのでは？？？
プリスキン_011: {
どうなる？
}
ピーター_012: {
まず中心部が浸水する……。
}
*/
ピーター_013: {
But, if Shell 1 loses a strut at
the same time, it'll be a very
different story.
}
/*ただし、シェル１も同時に爆発すれば
そうはいかない。*/
ピーター_014: {
The Big Shell's structural
integrity depends on a very
exact balance.
}
/*『ビッグ・シェル』は微妙な均衡で
姿勢を保っている。*/
ピーター_015: {
If both Shells lose a strut each,
the whole structure will tear
itself apart under its own weight.
}
/*シェル１も爆破されれば自重を
支え切れなくなり……自壊する。*/
ライデン_016: {
What do we do?
}
/*どうすればいい？*/
ピーター_017: {
I have a sensor that can locate
even those scentless C4's.
}
/*無臭のＣ４も探知できるセンサーがある。*/
//<ページ数変更>
ピーター_017_1: {
It makes combined use of a neutron
scintillator and a hydrogen bomb
detector.
}
/*中性子後方散乱装置と水素爆発物探知機
を併用したものだ。
*/
}//d

resource P023_01_R01_爆弾解体最後の一つ１無線デモ１＿センサーＢなし__e {
ライデン_000: {
You brought that stuff with you?
}
/*そんなものを持って来てたのか？*/
ピーター_001: {
Of course. I made the
calibrations while
I was in the pantry.
}
/*ああ……。
貯蔵庫の中で調整しておいた。*/
}//d

resource P023_01_R01_爆弾解体最後の一つ１無線デモ１＿２__e {
ライデン_000: {
Does it work?
}
/*使えるのか？*/
ピーター_001: {
I just tested it, and
it definitely responds.
}
/*ここで試した。確かに反応する。*/
//<ページ数変更>
ピーター_001_1: {
But the best I can do is a
sound beacon, not the radar.
}
/*ただし、レーダー・スクリーンではなく、
音で知らせる仕組みだ。
*/
ライデン_002: {
Sound?
}
/*音？*/
ピーター_003: {
The shorter the interval between
beacons, the closer the target.
}
/*音の間隔だ。
短くなる程接近していることを意味する。*/
ライデン_004: {
I get you.
}
/*わかった。*/
ピーター_005: {
There's another one in that
pantry I was in. You can go
back and get it.
}
/*私のいた貯蔵庫にもう一式ある。
取りに行ってくれ。*/
プリスキン_006: {
It's all yours, Raiden.
}
/*ライデン、そっちは頼んだぞ。*/
ピーター_007: {
I'm going to study it some more,
and see if the freezing process
will work.
}
/*もう少し、調べて、冷却できるかどうか
試してみる。*/
//<ページ数変更>
ピーター_007_1: {
Don't touch the other
one until I say so.
}
/*それまでは手を出すな。*/
ライデン_008: {
OK. I'll standby
until you radio in.
}
/*わかった。連絡を待つ。*/
}//d



resource P024_01_R01_爆弾解体センサーＢ入手１無線デモ１＿１__e {
//vc112401
ライデン_000: {
Peter, I have Sensor B.
}
/*スティルマン、センサーＢを入手した。*/
ピーター_001: {
Good.
Head to the bottom of Strut A.
}
/*そうか、Ａ脚底部に向かってくれ。*/
}//d

resource P024_01_R01_爆弾解体センサーＢ入手１無線デモ１＿１Ａ__e {
ライデン_002: {
How's your invisible bomb?
}
/*無臭爆弾はどうなった。*/
ピーター_003: {
I'm looking at it, but I'm keeping
my distance. How's Pliskin doing?
}
/*目の前にあるが、まだ近づいてはいない。
プリスキンの方はどうだ？*/
プリスキン_004: {
A few more minutes...
}
/*もう少し待ってくれ。*/
//<ページ数変更>
プリスキン_004_1: {
I just got to the last strut, but
there are a few enemy sentries
I have to take care of.
}
/*今最後の脚に到着した。
敵兵が邪魔だ。先に排除する……。*/
ライデン_005: {
Does it look bad, Peter?
}
/*……スティルマン、厄介そうなのか？*/
ピーター_006: {
Maybe. It's an odd one --
the detonator hasn't been
activated.
}
/*ああ。少し妙だ。
起爆装置が作動していない。*/
ライデン_007: {
What?
}
/*なに？*/
ピーター_008: {
But the sensors are live...
Which means...
}
/*だがセンサーは生きている……
これは……。*/
プリスキン_009: {
This is Pliskin.
I've located the last C4.
}
/*こちらプリスキン。
最後のＣ４を発見した。*/
ピーター_010: {
Is that it!?
}
/*まさか！？*/
プリスキン_011: {
I'm about to freeze it.
Then --
}
/*今から凍結する。これで……。*/
ピーター_012: {
Wait! Pliskin!
}
/*プリスキン、待て！！*/
}//d

resource P024_01_R01_爆弾解体センサーＢ入手１無線デモ１＿２__e {
//vc112406
ピーター_000: {
Damn! That WAS it!
}
/*くっ！やはり！！*/
プリスキン_001: {
What's going on!?
}
/*どうした！？*/
ピーター_002: {
The detonator just woke up.
It's counting down!
}
/*起爆装置が動き出した！
カウントダウンしている！*/
ライデン_003: {
What happened!?
}
/*どういうことだ！？*/
ピーター_004: {
The big ones were rigged to be
activated when all the baby C4's
went offline...
}
/*通常のＣ４爆弾の信号が全て消えたら、
こちらの爆弾が起動する仕掛けになって
いたんだ……。*/
ピーター_005: {
Raiden, the one in Shell 1
should be counting down too.
Hurry!
}
/*ライデン、シェル１の爆弾も起動して
いるはずだ！間違いない！急いでくれ！！*/
ライデン_006: {
What's the remaining time!?
}
/*残りカウントは！？*/
}//d
resource P024_01_R01_爆弾解体センサーＢ入手１無線デモ１＿カウント２００__e {
//vc112402
ピーター_000: {
200 seconds.
}
/*２００秒だ。*/
ライデン_001: {
200 seconds?
}
/*２００秒？
*/
}//d

resource P024_01_R01_爆弾解体センサーＢ入手１無線デモ１＿カウント３００__e {
//vc112403
ピーター_000: {
300 seconds.
}
/*３００秒だ。
*/
ライデン_001: {
300 seconds?
}
/*３００秒？
*/
}//d

resource P024_01_R01_爆弾解体センサーＢ入手１無線デモ１＿カウント４００__e {
//vc112404
ピーター_000: {
400 seconds.
}
/*４００秒だ。
*/
ライデン_001: {
400 seconds?
}
/*４００秒？
*/
}//d
resource P024_01_R01_爆弾解体センサーＢ入手１無線デモ１＿カウント後__e {
//vc112405
ピーター_000: {
Raiden, move!
Get to the bottom
of Strut A now!
}
/*ライデン、急げっ！！
Ａ脚底部に急ぐんだ！*/
}//d



resource P025_01_R01_爆弾解体昇降機下１無線デモ１＿１__e {
//vc112501
ピーター_000: {
Raiden, Pliskin,
listen carefully.
}
/*ライデン、プリスキン……
いいか、よく聞いてくれ！*/
ライデン_001: {
What is it?
}
/*どうした？*/
ピーター_002: {
I fell for it.
}
/*まずった……。*/
プリスキン_003: {
Fell for what?
}
/*何があった？*/
ピーター_004: {
Fatman has my number.
}
/*ファットマンにやられた。*/
ピーター_005: {
A proximity trigger.
Microwave.
}
/*距離だ。マイクロ波だ。*/
ライデン_006: {
Microwave?
}
/*マイクロ波？*/
ピーター_007: {
With a 7-foot range.
}
/*２メートル以内に近づくと感知する。*/
ピーター_008: {
It's not a technique
I taught him.
}
/*私の教えていないトラップだ。*/
ピーター_009: {
Neither was that multi-bomb
booby trap.
}
/*さっきの仕掛けといい、このトラップと
いい…*/
//<ページ数変更>
ピーター_009_1: {
Looks like he's far surpassed me
as far as explosives technique goes.
As for the rest --
}
/*…爆弾の技術に関する限り、
奴は私を越えたな……。だが……。*/
プリスキン_010: {
Pete, get the hell out of there!
}
/*親父さん、逃げろっ！*/
ピーター_011: {
There's less than 30 seconds
left. It's too late.
}
/*いや、後３０秒もない……。*/
ライデン_012: {
No!
}
/*そんな馬鹿なっ……。*/
ピーター_013: {
Pliskin, get away from Strut H,
as fast as you can.
}
/*プリスキン、Ｈ脚からなるべく離れろ！*/
プリスキン_014: {
Pete --
}
/*親父さん……。*/
ピーター_015: {
Raiden, keep your distance.
}
/*ライデン、近づいてはダメだ。*/
ピーター_016: {
Use the spray from as
far away as possible.
}
/*冷却スプレーは離れた位置から
噴射するんだ。*/
ライデン_017: {
Me?
}
/*俺にできるのか？*/
ピーター_018: {
You can do it.
I know that.
}
/*おまえならできる、いいな。*/
ライデン_019: {
I'm not so sure...
}
/*無理だ……。*/
ピーター_020: {
But I am. Do it,
I know you can.
}
/*大丈夫、やるんだ。おまえならできる。*/
}//d

resource P025_01_R01_爆弾解体昇降機下１無線デモ１＿２__e {
//vc112502
//*爆発ＳＥ入る
ピーター_021: {
!!
}
/*！！*/
}//d



resource P026_01_R01_爆弾解体終了１無線デモ１＿１__e {
//vc112601
ライデン_000: {
Colonel, I've neutralized the bomb.
}
/*大佐、爆弾を解体した……。*/
大佐_001: {
Good work, Raiden.
}
/*よくやった、ライデン。*/
ライデン_002: {
It was a great loss for everyone.
}
/*大きな犠牲を払った……。*/
大佐_003: {
Yes it was.
}
/*ああ……。*/
ライデン_004: {
Colonel, any damage report
on the explosion?
}
/*大佐、爆発の影響は？*/
大佐_005: {
Seems that the duct for diverting
the contaminated sea water was
destroyed.
}
/*汚染海水を巡らせる経路が
破壊されたらしい。
*/
//<ページ数変更>
大佐_005_1: {
And the central section
of Shell 2 is flooding.
}
/*シェル２の中央棟が浸水している。*/
大佐_006: {
The explosion's ignited
the oil slick on the surface.
}
/*それと、油膜に引火して、
海面が炎上している。*/
ライデン_007: {
What about the toxins?
}
/*有毒物質の発生は？*/
大佐_008: {
The chemicals stayed in
containment. There's no
immediate danger.
}
/*今の所は心配ないようだ。*/
ライデン_009: {
Is the Big Shell stable?
}
/*『ビッグ・シェル』は
姿勢維持できるのか？*/
大佐_010: {
Shell 1 was unaffected. The
price was high, but the threat
of the bomb is over for now.
}
/*大丈夫だ。シェル１には影響はない。
とにかく爆弾の脅威は去った。*/
ライデン_011: {
What's the next objective?
}
/*次の指示は？*/
大佐_012: {
Rescue the President.
Get back to the upper level.
}
/*大統領の救出に向かってくれ。
とりあえずそこから上に戻るんだ。*/
ライデン_013: {
Roger that.
}
/*了解。*/
}//d




resource P027_01_R01_爆弾解体後昇降機ホール１無線デモ１＿１__e {
//vc112701
大佐_000: {
Raiden, the terrorists have
retaliated for our bomb
neutralization.
}
/*ライデン、
爆弾の強制除去に対する報復があった。*/
ライデン_001: {
What?
}
/*何？*/
大佐_002: {
A hostage has been killed --
shot in the head.
}
/*人質が１名殺害された。*/
大佐_003: {
They shot one of them on the roof,
just to make sure we caught it.
}
/*T奴等、屋上でこれみよがしに
頭を撃ち抜いてみせたよ。
*/
//<ページ数変更>
大佐_003_1: {
One of our satellites
caught it, clear as day.
}
/*衛星がはっきり捉えた。*/
ライデン_004: {
Damn!
}
/*くそっ！*/
大佐_005: {
They announced that they would
kill one every hour from now on.
}
/*今後、１時間毎に１名ずつ……だそうだ。*/
ライデン_006: {
What are my orders?
What should I do?
}
/*どうすればいい？
俺は？*/
大佐_007: {
Stay with your mission objective.
Rescue the President.
}
/*そのまま任務を続行しろ。
大統領救出が優先だ。*/
ライデン_008: {
What about the other hostages?
}
/*他の人質は？*/
大佐_009: {
President Johnson is
your first priority.
}
/*最優先はジョンソン大統領だ。*/
ライデン_010: {
Priority my butt.
They're all in danger!
}
/*人質に優先もくそもない。*/
ローズ_011: {
Jack, be reasonable.
}
/*ジャック、冷静になって。
*/
ローズ_012: {
I know what you're feeling,
but you can't save them all.
}
/*あなたの気持ちはわかるわ。
でも、あなた一人では人質全員を
救出なんてできない。*/
ライデン_013: {
No, not by myself.
}
/*俺一人ではな。*/
大佐_014: {
Are you expecting that
Pliskin to come through?
}
/*あの男に期待しているのか？*/
ライデン_015: {
Well...
}
/*……。*/
大佐_016: {
Looks like he's turned
his radio off too.
}
/*無線は通じないようだが？*/
ライデン_017: {
I can't complete this
mission by myself.
}
/*俺一人では、任務遂行は無理だ。*/
大佐_018: {
That man was not included
in the simulation.
}
/*あの男はシミュレーションには
入っていない。*/
大佐_019: {
He is not a factor in this mission.
}
/*あの男は＃｛要素、ファクター｝＃には入っていないのだ。*/
ライデン_020: {
What do you mean by that, Colonel?
}
/*大佐、何だって？*/
大佐_021: {
Your mission must
remain a solo effort.
}
/*君の任務はあくまでも単独作戦行動……。*/
ライデン_022: {
What about the SEALs?
No second attempt?
}
/*ＳＥＡＬＳの再突入はないのか？*/
大佐_023: {
They haven't even gotten
to planning that.
}
/*まだ目処も立ってない。*/
大佐_024: {
All we can do is wait.
In the meantime, you're
our only hope.
}
/*我々は待つしかできない。
君だけが頼りなんだ。*/
ライデン_025: {
...I understand.
}
/*……わかった。*/
大佐_026: {
Raiden, go and rescue the President.
You can start off by getting to the
upper level of Strut A.
}
/*ライデン、大統領の救出に向かってくれ。
まずＡ脚上部に上がるんだ。*/
}//d




resource P030_01_R01_フォーチュン戦中無線無線デモ１＿１__e {
//vc113001
大佐_000: {
Raiden, Fatman just
contacted us directly.
}
/*ライデン、ファットマンから
こちらに直接連絡があった。*/
ライデン_001: {
Fatman called US?
}
/*ファットマンから？*/
大佐_002: {
Yes. Looks like he placed a bomb
on the heliport. He specifically
asked for you, Raiden.
}
/*ああ。ヘリポートにまた仕掛けたらしい。
ライデン、君を指定してきている。*/
ライデン_003: {
What!?
}
/*なに！？*/
大佐_004: {
He's killed off Peter.
Now he's after you.
}
/*スティルマンが亡くなって、
次のターゲットは君らしい。*/
ライデン_005: {
Why me?
}
/*なぜ俺なんだ？*/
大佐_006: {
How should I know?
}
/*わからん。*/
ライデン_007: {
Look. This is really not
a good time for this.
}
/*こっちはそれどころじゃないぞ！*/
大佐_008: {
The countdown's already
begun, Raiden!
}
/*すでにタイマーが起動している。*/
ライデン_009: {
Great, how much
time do I have left?
}
/*なんてこった、後いくらだ？*/
大佐_010: {
I'll show you the count.
}
/*カウントを表示する。*/
}//d
resource P030_01_R01_フォーチュン戦中無線無線デモ１＿カウント２００__e {
//vc113002
大佐_000: {
200 seconds remaining.
}
/*後２００カウントだ。
*/
}//d
resource P030_01_R01_フォーチュン戦中無線無線デモ１＿カウント３００__e {
//vc113003
大佐_000: {
300 seconds remaining.
}
/*後３００カウントだ。
*/
}//d
resource P030_01_R01_フォーチュン戦中無線無線デモ１＿カウント４００__e {
//vc113004
大佐_000: {
400 seconds remaining.
}
/*後４００カウントだ。
*/
}//d
resource P030_01_R01_フォーチュン戦中無線無線デモ１＿カウント５００__e {
//vc113005
大佐_000: {
500 seconds remaining.
}
/*後５００カウントだ。
*/
}//d
resource P030_01_R01_フォーチュン戦中無線無線デモ１＿カウント後__e {
//vc113006
ライデン_000: {
So he's planning on
taking this place out.
}
/*ここを破壊する気だな。*/
大佐_001: {
It looks like he has a different
agenda from that of Dead Cell.
}
/*デッドセルの目的と奴の目的は
既に違うようだ。*/
ライデン_002: {
What about backup?
}
/*応援は？*/
大佐_003: {
None. There's no time.
}
/*ダメだ。
今からでは時間がない。*/
ライデン_004: {
Which type of explosives is it?
}
/*爆弾はどっちのタイプだ？*/
大佐_005: {
He didn't say.
}
/*そこまでのヒントはもらえなかった。*/
}//d




resource P035_01_R01_ファットマン爆弾解体終了１無線デモ１＿１__e {
//vc113501
大佐_000: {
Good work, Raiden. Looks like
all the bombs are neutralized.
}
/*ライデン、よくやった。爆弾は全て除去
できたようだな。*/
//<ページ数変更>
大佐_000_1: {
One of their main leverages
is now gone. That leaves --
}
/*これで奴等の脅しは
一つ無効になった。あとは……。*/
ライデン_001: {
Colonel, Fatman didn't seem to
know about the ransom demands.
}
/*大佐、ファットマンは要求のことを
知らなかったようだが……？*/
大佐_002: {
Intentionally kept
in the dark, I'd say.
}
/*知らされていなかっただけではないのか？
*/
//<ページ数変更>
大佐_002_1: {
He seemed to be coming from a
very different place from the
other terrorists.
}
/*彼は他のテロリスト達とは違う目的で
動いていたようだ。*/
ライデン_003: {
...
}
// どっかから「しかし」を持ってくる。
/*しかし……。*/
大佐_004: {
Raiden, a lot of hostages --
our President included --
are still in danger.
}
/*ライデン、まだ大統領をはじめ、多くの
人質がいる。*/
//<ページ数変更>
大佐_004_1: {
Keep your mind focused
on protecting them.
}
/*彼らの命がいまだ危険に
さらされているのを忘れるな。*/
ライデン_005: {
... What are my orders?
}
/*……次の指示は？*/
大佐_006: {
Rescue the President.
}
/*大統領を救出するんだ。*/
ライデン_007: {
We have no idea where he is.
}
/*手がかりがない……。*/
大佐_008: {
You haven't been in the central
core yet. I suggest you start
there...
}
/*中央棟はまだ調べていないだろう？
そちらを……。*/
ライデン_009: {
Wait, I have another call.
Want me to take it?
}
/*待ってくれ、＃｛ＣＡＬＬ、コール｝＃が入った。
つないでいいか？*/
大佐_010: {
No, I'll go offline. Best to
keep our presence unknown.
}
/*いや、待て！
こちらの存在を知られてはまずい。
切るぞ。*/
}//d
resource P035_01_R01_ファットマン爆弾解体終了１無線デモ１＿２__e {
//vc113502
プリスキン_000: {
How're you doing, kid?
}
/*若いの、大丈夫か？*/
ライデン_001: {
Pliskin!?
Is everything all right?
}
/*プリスキン！？
無事だったのか？*/
プリスキン_002: {
Could be better.
Looks like I was out
cold for a while.
}
/*なんとかな……
しばらく気を失っていたらしい。*/
ライデン_003: {
How did you manage
to stay alive?
}
/*よく生きてたな。*/
プリスキン_004: {
Had a little help
from a friend.
}
/*仲間に助けられた。*/
ライデン_005: {
Friend?
}
/*仲間？*/
プリスキン_006: {
What about the bomb?
}
/*爆弾はどうなった？*/
ライデン_007: {
Defused. And Fatman too.
}
/*ああ、解除した。
ファットマンも含め、全て。*/
プリスキン_008: {
That's good news.
}
/*そいつはいいニュースだ。*/
ライデン_009: {
How's Shell 2?
}
/*シェル２の様子は？*/
プリスキン_010: {
It's a mess.
The bomb crippled H Strut.
}
/*こっちはひどい有様だ。
爆発したＨ脚は目茶苦茶だ。*/
ライデン_011: {
What about the toxins?
}
/*有毒物質の発生は？*/
プリスキン_012: {
The what?
}
/*なに？*/
ライデン_013: {
If the Big Shell blows up, the
explosion is expected to produce
massive amounts of toxins...
}
/*『ビッグ・シェル』が爆発・炎上すると
大量の有毒物質が……。*/
プリスキン_014: {
Never heard anything about that.
}
/*そんな話は聞いていないが？*/
ライデン_015: {
Huh?
}
/*え？*/
プリスキン_016: {
Well, looks like there's not
much danger of that in any case.
}
/*まあその心配はない様だ。*/
//<ページ数変更>
プリスキン_016_1: {
But the central core is
starting to flood.
It won't last much longer.
}
/*だが爆発の衝撃で中央棟が浸水している。
長くは持たないだろうな……。*/
ライデン_017: {
What about the President
and the other hostages?
}
/*……大統領や人質は？*/
プリスキン_018: {
They weren't in Shell 2.
They must be in Shell 1.
}
/*いや、シェル２にはいなかった。
おそらく、シェル１だろう。*/
ライデン_019: {
We need to get the hostages
out of here now.
}
/*早く人質を待避させなければ。*/
プリスキン_020: {
It's too far from Manhattan
for a swim.
}
/*ここからマンハッタンまで泳ぎ切れる
距離じゃない。*/
ライデン_021: {
What about the lifeboats?
}
/*救命ボートみたいなものは？*/
プリスキン_022: {
There doesn't seem to be
any. Doesn't make sense.
}
/*いや、装備されていないようだ。
考えられない事だがな。*/
ライデン_023: {
So a chopper is
our only extraction?
}
/*ヘリで脱出しかない？*/
プリスキン_024: {
Right. And it comes with a passenger
limit. Intel has it that there are
about thirty hostages.
}
/*そうだ。しかも人数制限付き。
情報によれば人質は３０人ほどいる
そうだ。*/
ライデン_025: {
It'd take more than
a single trip.
}
/*１回では無理だな。*/
プリスキン_026: {
We'll have to come back.
}
/*往復するしかない。*/
ライデン_027: {
Can you pilot a chopper?
}
/*ヘリの操縦はできるのか？*/
プリスキン_028: {
No, but I brought a gearhead with
me. He's a good guy. I'll introduce
you later.
}
/*いや、しかし、メカオタクの仲間を
連れてきている。信用できる奴だ。
後で紹介する。*/
ライデン_029: {
Pliskin, I'm on the heliport right
now, but I don't see their Harrier.
It's out somewhere.
}
/*プリスキン、今ヘリポートだが、
敵のハリアーが見えない。
出払っているようだ。*/
プリスキン_030: {
We'd better move now then. Our
chances with a Harrier after us
are close to nothing.
}
/*今のうちだな。
ハリアーに狙われたら終わりだ……。*/
ライデン_031: {
Do you know where
the President is?
}
/*大統領は？*/
プリスキン_032: {
No. That one's all yours.
}
/*わからない。そっちは任せる。*/
ライデン_033: {
The President is at the top of our
rescue list. These are our orders,
Lieutenant J.G..
}
/*救出は大統領が優先だぞ。
それが俺達の任務だ。*/
プリスキン_034: {
Your orders. Not mine.
}
/*お前の、だろう？
勘違いするな。*/
ライデン_035: {
What?
}
/*なに？*/
プリスキン_036: {
See you later.
}
/*じゃあな。*/
}//d



resource P036_03_R01_忍者登場３無線デモ１＿１__e {
//vc113601
オルガ_000: {
This is safer, I think.
}
/*こちらの方が都合が良い。*/
ライデン_001: {
Safe from what?
}
/*……都合？*/
オルガ_002: {
Eavesdropping, of course.
}
/*人に聞かれる心配がない。*/
ライデン_003: {
All right -- why did
you contact me?
}
/*ああ……なぜ俺に接触を？*/
オルガ_004: {
I've been ordered to give you
backup, including the relaying
of necessary intel.
}
/*情報供給も含め、おまえをサポートする
ように言われている。*/
ライデン_005: {
Ordered by whom?
}
/*誰に？*/
オルガ_006: {
...
}
/*……。*/
ライデン_007: {
Why won't you identify
yourself?
}
/*何故正体を明かさない？*/
オルガ_008: {
There is no need
for you to know.
}
/*お前が知る必要はない。*/
ライデン_009: {
I'll decide whether
I need to know.
}
/*必要あるかどうかは俺が決める。*/
オルガ_010: {
You are not yet trusted
to make such decisions.
}
/*お前に判断する資格は与えられていない。*/
ライデン_011: {
...
}
/*……。*/
オルガ_012: {
I'll tell you something you
do need to know, instead.
}
/*かわりに知る必要があることを
教えてやろう。*/
オルガ_013: {
The current location
of the President.
}
/*大統領の居場所だ。*/
ライデン_014: {
What!
}
/*なに？*/
オルガ_015: {
Or rather, the person who
knows the current location
of the President.
}
/*正確には大統領の居場所を知っている
人間……。*/
ライデン_016: {
Who is it?
}
/*誰だ？*/
オルガ_017: {
A Secret Service agent named Ames,
currently being held with the other
hostages.
}
/*エイムズというシークレット・サービス
だ。今は人質と共に捕らえられている。*/
ライデン_018: {
Secret Service, huh.
}
/*シークレット・サービス？*/
オルガ_019: {
The head of the President's
security detail.
}
/*そうだ。エイムズはシークレット・
サービスの中でも特別な地位にある。*/
オルガ_020: {
Ames has been fitted with the same
type of VIP nanomachine system as
the President.
}
/*大統領のものと同じ要人用ナノマシンが
注入されていて、*/
//<ページ数変更>
オルガ_020_1: {
If you're within range, you
should be able to communicate.
}
/*近くにいれば相互に
体内通信が可能だ。*/
ライデン_021: {
Why are you telling me this?
}
/*……なぜ俺にそんなことを教える？*/
オルガ_022: {
Do I need to repeat myself?
}
/*同じ言葉を何度言わせる気だ？*/
ライデン_023: {
There's no reason for me
to believe any of this.
You understand that?
}
/*……俺がお前を信じなければならない
理由もないと思うが？*/
オルガ_024: {
Of course. But you also have
no choice but to believe.
}
/*無論だ。しかしお前は信じざるを得ない。
そうだろう？*/
ライデン_025: {
...
}
/*……。*/
オルガ_026: {
Do you have any other leads?
}
/*他に手がかりがあるのか？*/
ライデン_027: {
...Where are those hostages?
}
/*……人質はどこにいる？*/
オルガ_028: {
Ha ha ha ha.
}
/*
ふふん。*/
}//d





resource P036_08_R02_忍者登場８無線デモ２＿１__e {
//vc113611
オルガ_000: {
I suggest you hurry.
They have the nuke
on their side.
}
/*急いだ方が良いぞ。
奴等には核がある。*/
ライデン_001: {
The nuke!? They have a
nuclear weapon WITH them?
}
/*核！？
奴等、核兵器を持ち込んでいるのか！？*/
オルガ_002: {
You didn't find their continuing
presence here unusual?
}
/*お前はおかしいと思わなかったのか？*/
オルガ_003: {
Even with the President as hostage,
this is an island -- and they have
no visible means of escape...
}
/*大統領を人質にとっているとはいえ、
なぜ奴等はここにとどまっているのか？*/
/* 意味包含
//<ページ数変更>
オルガ_004: {
逃げ場のないこの孤島に……
脱出手段も用意せず。
}
*/
ライデン_005: {
...Even if they do have a nuke,
the warhead is no good without
an access code.
}
/*例え奴等が核兵器を持ち込んだとしても、
核弾頭には安全装置が組み込まれている
はずだ。*/
//<ページ数変更>
ライデン_005_1: {
The security lockout
can't be bypassed...
}
/*起爆コード入力式の……。
}*/
オルガ_006: {
They don't need to.
They have the code.
}
/*それも奴等は手に入れている。*/
}//d


resource P036_10_R03_忍者登場１０無線デモ３＿１__e {
//vc113621
ライデン_000: {
Why did they have to bring
the football along?
}
/*なぜここにブラックケースを
持ち込んだんだ？
*/
//<ページ数変更>
ライデン_000_1: {
To a decontamination
plant, of all places.
}
/*ただの除染プラントに……。*/
オルガ_001: {
But they did have to.
}
/*答えは簡単だ。*/
//<ページ数変更>
オルガ_001_1: {
Because, after all, the Big Shell
is the farthest thing from a cleanup
plant there is.
}
/*『ビッグ・シェル』は
除染プラントなどではないからだよ。*/
ライデン_002: {
What!?
}
/*なに！？*/
オルガ_003: {
Dead Cell didn't have to bring
a nuke along with them.
It was right here to begin with.
}
/*核も奴等が持ち込んだのではない。
初めからここにあるものだ。
*/
//<ページ数変更>
オルガ_003_1: {
Nothing in this affair
is what it seems...
}
/*そう、全ては偽装……。*/
ライデン_004: {
A cover-up -- but
why? For what?
}
/*偽装！？いったい何の？*/
オルガ_005: {
For Metal Gear,
that is housed here.
}
/*ここには……メタルギアがある……。*/
}//d



resource P036_13_R04_忍者登場１３無線デモ４＿１__e {
//vc113631
ライデン_000: {
Colonel, who was
that man just now?
}
/*大佐、今の男は何者だ？*/
大佐_001: {
He's not one of ours.
}
/*我々の仲間ではない。*/
大佐_002: {
No -- we have no one
like that in our unit.
}
/*違う……うちにあんな隊員はいない。*/
ライデン_003: {
He said that the Big Shell
was housing a new model
of Metal Gear.
}
/*この『ビッグ・シェル』に
新型メタルギアがあると言っていたが？
*/
大佐_004: {
First I've heard of it.
}
/*初耳だ……。*/
ライデン_005: {
Colonel, what are
you not telling me?
}
/*大佐、俺に何を隠している？*/
大佐_006: {
I've been completely open
with you, Raiden. I've told
you everything.
}
/*いや。隠し事などしていない。
全て話している。*/
ライデン_007: {
Is that everything you know
-- or everything I need to
know?
}
/*……それは大佐の知っている全てか？
それとも俺に話していいと許可された
ことの全てか？*/
大佐_008: {
Snap out of it, Raiden!
}
/*馬鹿なことを言うな、ライデン！*/
ライデン_009: {
...
}
/*……。*/
大佐_010: {
I'll have the Metal Gear rumor
looked into. You need to make
contact with this Ames.
}
/*メタルギアについてはこちらでも調べて
みる。君はエイムズに接触してくれ。*/
ライデン_011: {
So you believe that Ninja?
}
/*あの男の言うことを信じろと？*/
大佐_012: {
Since we have no leads on the
President's current location,
we have no other alternatives.
}
/*他に大統領につながる手がかりがない
以上、今は他に方法がない。*/
大佐_013: {
Right now, collect as much
data as you can, including
anything on Metal Gear.
}
/*メタルギアのことも含めて情報を
得るんだ。*/
ライデン_014: {
Are those my orders.
}
/*それが指令か？*/
大佐_015: {
Yes they are. Disguise yourself
as an enemy soldier and infiltrate
the Shell 1 Core.
}
/*そうだ。敵兵士に変装して
シェル１中央棟に潜入しろ。*/
ライデン_016: {
...Understood.
}
/*……了解。*/
}




resource P037_01_R01_スネークの遺体１無線デモ１＿１__e {
//vc113701
ローズ_000: {
Got a minute, Jack?
}
/*ジャック、ちょっといい？*/
ライデン_001: {
Rose?
}
/*ローズ？*/
ローズ_002: {
I found some information on
where Solid Snake is interred.
}
/*頼まれていたスネークの
遺体の調査だけど……。*/
ライデン_003: {
Great. Shoot.
}
/*どうだった？*/
ローズ_004: {
I've located the grave site.
}
/*スネークの墓を見つけた。*/
ライデン_005: {
And the body?
}
/*それで遺体は？*/
ローズ_006: {
Exhumed for DNA testing.
}
/*スネークの墓を掘り起こして、
ＤＮＡ鑑定をしたわ。*/
ライデン_007: {
Well? Do you have the results?
}
/*結果は？*/
ローズ_008: {
The right arm was missing, but
there was no doubt that it was him.
That body belongs to Solid Snake.
}
/*右腕が欠損していたものの、
ソリッド・スネークに間違いない。
彼はすでに死んでいる。*/
ライデン_009: {
Hrmmm... So the head of
the terrorist group must
be --
}
/*ううん……となると、
今回のテロリストは？*/
ローズ_010: {
An impostor.
}
/*スネークを語る偽物。*/
ライデン_011: {
Right...
}
/*そうか……。*/
ローズ_012: {
You sound disappointed.
}
/*どうしたの？
がっかりしたようだけど。*/
ライデン_013: {
I guess -- I guess I was kind of
hoping to meet the legend in the
flesh.
}
/*いや、伝説の男に会えるかもしれないと、
どこかで期待していた。*/
ローズ_014: {
I get you. But it looks
like he's not behind this
incident.
}
/*そうね。
でも彼は今回の主犯ではない。*/
大佐_015: {
Raiden, the President
needs you, I think.
}
/*ライデン、大統領の手がかりを追うんだ。*/
大佐_016: {
Disguise yourself as enemy
personnel and infiltrate the
core section.
}
/*テロリストに化けて、中央棟に潜入しろ。
*/
//<ページ数変更>
大佐_016_1: {
Your priority is to
contact Agent Ames.
}
/*エイムズを探すんだ。*/
}




resource P040_02_R02_エイムズ発見２無線デモ１＿１__e {
//vc114001
エイムズ_000: {
Are you on?
}
/*聞こえるか？*/
ライデン_001: {
Right here.
}
/*大丈夫だ。*/
ライデン_002: {
Do you really know where
the President is?
}
/*あんた、本当に大統領の居場所を？*/
エイムズ_003: {
Almost certainly. He was moved
to the first floor of Shell 2's core
section.
}
/*ああ。
シェル２中央棟の１Ｆに移されたらしい。*/
ライデン_004: {
The first floor,
the core of Shell 2...
}
/*シェル２中央棟の１Ｆ……。*/
ライデン_005: {
Is he still there?
}
/*今もそこにいるのか？*/
エイムズ_006: {
I don't know. I can't
get a response.
}
/*いや、今は反応がない。*/
ライデン_007: {
You don't think he's been --
like the other hostages...?
}
/*まさか、他の人質のように……？*/
エイムズ_008: {
?
}
/*？*/
ライデン_009: {
A hostage was killed in
retaliation after the SEAL
10 disaster, remember?
}
/*ＳＥＡＬ１０が突入した報復に人質が
殺されただろう？*/
エイムズ_010: {
What are you talking about?
}
/*何のことだ？*/
ライデン_011: {
...?
}
/*……？*/
エイムズ_012: {
Regardless of what they do
to other hostages, they won't
touch the President.
}
/*他の人質はともかく、
奴等は大統領を殺さない。*/
ライデン_013: {
What makes you so sure?
}
/*なぜそう言い切れる？*/
エイムズ_014: {
The case.
}
/*ブラックケースだよ。*/
ライデン_015: {
You mean the nuclear
button they took?
}
/*奴等が奪っていった、
核兵器を解除するケースのことか？*/
エイムズ_016: {
Right. And the case won't
do a thing by itself.
}
/*そうだ。
奴等はブラックケースを奪った。
だがそれだけでは意味を成さない。*/
エイムズ_017: {
That case may be the single most
advanced example of a weapons
fail-safe system.
}
/*あのケースは最新ハイテク技術の粋を
集めたものだ。*/
エイムズ_018: {
The password is nothing less than
the physiological data of the U.S.
President.
}
/*合衆国大統領の生体データを用いる
暗号システムを採用している。*/
ライデン_019: {
Physiological data?
}
/*生体データ？*/
エイムズ_020: {
The President's own vital signs --
heartbeat, brainwave pattern,
blood pressure and so on --
}
//<ページ数変更>
エイムズ_020_1: {
are constantly monitored and
relayed by his internal nano-
machines.
}
/*大統領体内のナノマシンから
ＤＮＡ情報、鼓動、脳波、血圧等を
送信し、それを鍵とするんだ。*/
エイムズ_021: {
This information along with the
DNA pattern serve as a biometric
password, unbreakable even by＃－
}
//<ページ数変更>
エイムズ_021_1: {
the latest parallel processor
supercomputers.
}
/*最新の超並列コンピュータを使っても
破ることは出来ない。*/
エイムズ_022: {
The password entry itself cannot
be performed unless brainwave
patterns and heartbeats＃－
}
//<ページ数変更>
エイムズ_022_1: {
fall within normal parameters,
rendering chemical and other
forms of coercion impractical.
}
/*入力は脳波・心拍数等が通常の状態で
なければ無効になる。薬物や脅迫で
入力させることは出来ない。*/
エイムズ_023: {
In other words, the login must
be made of the President's own
free will.
}
/*つまり大統領本人が、自分自身の意志で
直接入力しなければ入力は認められない
仕組みになっている。*/
エイムズ_024: {
As a fail-safe, the input must also
be reconfirmed hourly, even after
the initial login.
}
//<ページ数変更>
エイムズ_024_1: {
If a valid confirmation is not
forthcoming, the system will
automatically cancel the login.
}
/*その上、入力後も一定時間毎に
ＩＤ確認が義務づけられ、確認が得られ
ない場合、コード入力は取り消される。*/
ライデン_025: {
And that's why they can't
harm the President...
}
/*だから奴等は大統領を殺さない……？*/
エイムズ_026: {
-- at least until the bird flies.
}
/*少なくとも核を撃つまでは、な。*/
ライデン_027: {
Is there really a new model
of Metal Gear here?
}
/*……ここには本当に核が……
新型メタルギアがあるのか？*/
エイムズ_028: {
Absolutely. The Black Case serves
as the launch key to Metal Gear as
well.
}
/*無論だ。ブラックケースのシステムは
核兵器の解除だけではなく、
新型メタルギア起動の鍵も兼ねている。*/
ライデン_029: {
Why would they hide a Metal
Gear in an offshore plant?
}
/*なぜ海上除染施設にメタルギアが？*/
エイムズ_030: {
...Haven't they told
you anything?
}
/*……何も聞かされていないのか？*/
ライデン_031: {
...
}
/*……。*/
エイムズ_032: {
The entire thing was planned --
the oil spill, the tanker accident
that caused it, everything.
}
/*全て偽装だ。原油汚染も、
その原因となったタンカーの沈没も。
何もかもな。*/
エイムズ_033: {
The Big Shell was built specifically
for the development of a new Metal
Gear model.
}
/*この『ビッグ・シェル』は
新型メタルギア開発を行うために
建造された。*/
エイムズ_034: {
The inspection tour was
to check its progress...
}
/*今回の視察も、その進捗を確かめる
ためのものだった……。*/
ライデン_035: {
What's going on around here...
}
/*どういうことなんだ？*/
エイムズ_036: {
Wait!
}
/*待て！*/
}
//d



resource P040_06_R02_エイムズ発見６無線デモ２＿１__e {
//vc114011
エイムズ_000: {
Anyway, what did you
manage to catch?
}
/*それより、奴等は何を？*/
ライデン_001: {
They said password
input was complete...
}
/*コード入力は終わったと言っていた……。*/
エイムズ_002: {
I thought so...
}
/*やはり……。*/
ライデン_003: {
You said the password entry into
the Black Case had to be made by
the President willingly.
}
/*あんた、ブラックケースは大統領が
自分の意志で入力しなければならない、
と言ったな。*/
エイムズ_004: {
That's right.
}
/*ああ。*/
ライデン_005: {
So this means the President
is cooperating with them?
}
/*では大統領自身が奴等に手を貸している
と言うことか？*/
エイムズ_006: {
It would have to be, yes.
}
/*そうなるな。*/
ライデン_007: {
Why?
}
/*一体なぜ？*/
エイムズ_008: {
Probably tired of being a puppet.
But it wasn't a smart move to
betray us...
}
/*人形でいることに飽きたんだろうよ。
我々を裏切るとは……愚かな。*/
ライデン_009: {
...a puppet?
}
/*……人形？*/
エイムズ_010: {
We're running out of time. They
WILL fire a nuke. You know what
you need to do before then.
}
/*もう時間がないぞ。奴等は必ず核を撃つ。
その前に大統領を……。*/
ライデン_011: {
Fire the nuke?
But it's nowhere close
to the ransom deadline.
}
/*核を撃つ？
要求のタイムリミットまでは
まだ時間があるぞ。*/
エイムズ_012: {
Ransom?
}
/*要求？*/
ライデン_013: {
Thirty billion dollars in cash...
}
/*現金３００億ドル……。*/
エイムズ_014: {
What are you babbling about!
The nuclear strike is not a threat --
it's been the objective all along!
}
/*何を言っている？
核攻撃は脅迫の手段などではない。
それこそが奴等の目的だ。*/
ライデン_015: {
They plan to slaughter
millions of people!?
}
/*大量虐殺が！？*/
エイムズ_016: {
No -- a high-altitude detonation.
You've heard of the Compton Effect?
}
/*いや。奴等は高空で核を使うつもりだ。
聞いたことがあるだろう？
コンプトン効果やスカラー電磁波……。*/
ライデン_017: {
The total disruption
of electronic equipment
caused by EMMA pulse.
}
/*核爆発による電子機器の破壊か？*/
エイムズ_018: {
Textbook answer. Well, when
an average nuclear warhead
goes off within the atmosphere,
}
//<ページ数変更>
エイムズ_018_1: {
the result is an electromagnetic
pulse of up to 50 billion megawatts.
}
/*そうだ。大気中で核爆発が起こると
５兆メガワットを越える強烈な
電磁パルスが発生する。*/
エイムズ_019: {
The EMMA field can reach tens
of thousands of volts per meter,
}
//<ページ数変更>
エイムズ_019_1: {
and most electronic equipment
will be toast in an instant.
}
/*電磁場の強さは数万ボルト／メートル
にもなり、一般の電子機器は全て
破壊される。*/
}
/* 以下の文は？ ムービー？？？
奴等はそれをマンハッタン上空で行おうとしているんだ
And this is what they plan
to do right over Manhattan.
*/
//d




resource P040_06_R02_エイムズ発見６無線デモ２＿２__e {
//vc114012
エイムズ_000: {
But that isn't their aim.
}

/*いやそうではない。*/
//<ページ数変更>
エイムズ_000_1: {
What they plan to do is "liberate"
Manhattan, pull it offline, and turn
it into some kind of a republic.
}
/*デジタルのくびきを
断ち切りマンハッタンを解放区とする
こと……それが奴等の狙いだ。
*/
エイムズ_001: {
Hence "Sons of Liberty," I suppose.
}
/*ふん。『＃｛自由の息子達、サンズ・オブ・リバティー｝＃』とは
よく言ったものだな……。*/
ライデン_002: {
"Sons of Liberty"...?
}
/*『＃｛自由の息子達、サンズ・オブ・リバティー｝＃』……？*/
エイムズ_003: {
Damn, Ocelot is coming!
I'm going offline.
}
/*くっマズイ。
オセロットが来る！
体内通信を解くぞ。*/
}
//d



resource P041_02_R01_エイムズ死亡後２無線デモ１＿１__e {
//vc114101
ライデン_000: {
Colonel, Ames is dead.
Looked like a heart attack.
}
/*大佐、エイムズが死んだ。
心臓発作のようだった。*/
大佐_001: {
Hm, that's unfortunate. However,
we do at least know where the
President is.
}
/*ああ。残念なことだ。だが大統領の
居場所がわかっただけで良しとしよう。*/
ライデン_002: {
So there really is a new type
of Metal Gear in this place?
}
/*……ここに新型メタルギアがあるのは
確かなようだが？
*/
大佐_003: {
Apparently.
We're still looking into it...
}
/*そうらしいな。
現在調査を行っている……。*/
ライデン_004: {
I've also been told that the nuclear
strike was what the terrorists were
after from the start.
}
/*奴等の目的は核攻撃らしいぞ。*/
//<ページ数変更>
ライデン_004_1: {
NOT the thirty billion dollars!
}
/*現金３００億ドルではなく！！*/
大佐_005: {
Chri--, it was a cover-up
all along...
}
/*偽装だったとはな……。*/
ライデン_006: {
Colonel! What are you
keeping from me!
}
/*大佐！
一体何を隠している！！*/
大佐_007: {
I am not keeping back anything!
It's not as though I'm told all
the facts either!
}
/*何も隠してはおらん！
私も全てを知らされているわけでは
ないのだ。*/
ライデン_008: {
...
}
/*……。*/
大佐_009: {
I'm pulling in all the favors
I can to look into all this.
Just be a little patient.
}
/*それらの件についてはあらゆる情報網を
使って調査をする。もう少し待ってくれ。*/
大佐_010: {
Our priority should be with
the President right now.
}
/*今問題なのは大統領だ。*/
大佐_011: {
We can take it that they've
completed the password entry＃－
}
//<ページ数変更>
大佐_011_1: {
and are preparing Metal Gear
for nuclear strike.
}
/*奴等がコード入力を終了し、
メタルギアによる核発射の準備を
整えていることは事実のようだ。*/
大佐_012: {
Get to the President
as soon as possible.
}
/*君は一刻も早く大統領の元へ
向かってほしい。*/
ライデン_013: {
But the President is
cooperating with them --
}
/*しかし大統領は奴等と……。*/
大佐_014: {
According to Ames, yes. But
it's also true that they're about
to get rid of the President.
}
/*エイムズの話によればな。しかし奴等が
大統領を始末しようとしていることも
確かだ。*/
大佐_015: {
There's something
else going on here,
}
//<ページ数変更>
大佐_015_1: {
and the President may be able
to tell you what it is when you
see him in person.
}
/*裏にはまだ何かある。
大統領本人に会って状況を確かめるんだ。*/
ライデン_016: {
...
}
/*……。*/
大佐_017: {
Once they get the confirmation
for nuclear launch, they'll do it.
}
/*それにコードの再確認がなされれば
奴等は核を撃つ。*/
大佐_018: {
You need to rescue the
President before then.
}
/*いずれにせよ。その前に大統領の身柄を
確保するしかない。*/
ライデン_019: {
...
}
/*……。*/
ローズ_020: {
Jack, I agree with the Colonel.
You need to protect the President
for now.
}
/*ジャック……
私も大佐の言う通りだと思う。
今は大統領を……。*/
ライデン_021: {
All right...
}
/*わかった……。*/
}
//d




resource P042_01_R01_シェル１シェル２連絡橋１無線デモ１＿１__e {
//vc114201
プリスキン_000: {
Raiden, can you hear me?
}
/*ライデン、聞こえるか！*/
ライデン_001: {
Pliskin?
Where have you been?
}
/*プリスキンか？
今までどこに？*/
プリスキン_002: {
Checking around. I'm in
Strut H right now. How's
the situation over there?
}
/*ちょっとした調べものだ。
今Ｈ脚にいる。
そっちの状況は？*/
ライデン_003: {
We have a lead on the
President's location.
}
/*大統領の手がかりを得た。*/
プリスキン_004: {
Where is he?
}
/*どこだ？*/
ライデン_005: {
Shell 2 Core, the first floor.
}
/*シェル２の中央棟の１Ｆにいるらしい。*/
プリスキン_006: {
I'm cut off from the core
where I am. It's a mess
here.
}
/*そうか、こっちはひどい有様だ。
ここからでは中央棟へは回れない。*/
ライデン_007: {
All right. I'm on my way
to Shell 2 right now.
}
/*わかった。
これからシェル２へ向かう。*/
プリスキン_008: {
There are IR sensors in place on
the connecting bridge between
Shells 1 and 2.
}
/*シェル１シェル２連絡橋には
赤外線センサーのトラップが
仕掛けられている。*/
プリスキン_009: {
If you break the beams,
the Semtex will go off.
}
/*赤外線に触れるとセムテックスが
爆発するぞ。*/
ライデン_010: {
Yeah, I heard them
talking about that.
}
/*ああ、奴らが話しているのを聞いた。*/
プリスキン_011: {
Target the control units and
destroy them. Make sure you
don't shoot the Semtex.
}
/*制御装置を狙撃して破壊するんだ。
くれぐれも、セムテックス本体を
撃つんじゃないぞ。*/
/*　以下は廃止？？？*/
ライデン_012: {
What about the coolant spray?
}
// 
/*爆弾解体に使った冷却スプレーは？*/
プリスキン_013: {
They're not stupid. The Semtex is
on the other side of the railing,
out of reach.
}
// 
/*奴らも馬鹿じゃない。
セムテックスは橋の裏に仕掛けてある。*/
ライデン_014: {
What do the control
units look like?
}
/*破壊しなければならない装置は？*/
プリスキン_015: {
Take a look with
your binoculars.
}
/*双眼鏡で見てみるといい。*/
}
//d




resource P044_01_R01_赤外線センサークリア１無線デモ１＿１__e {
//vc114401
プリスキン_000: {
Raiden, I found us a ride.
}
/*ライデン、いいものを手に入れたぞ。*/
ライデン_001: {
I'm all ears.
}
/*いいもの？*/
プリスキン_002: {
One of the enemy's Kasatkas.
}
/*敵のカサッカだ。*/
ライデン_003: {
Is it in good shape?
}
/*飛べるのか？*/
プリスキン_004: {
Full tank. I'm heading for Shell 1
now. What about that Harrier?
}
/*燃料もＯＫだ。今からシェル１へ向かう。
ハリアーはどうした？*/
ライデン_005: {
It's not on the heliport here.
}
/*いや、こっちのヘリポートにはいない。*/
プリスキン_006: {
Good. I'll set this one
down there then.
}
/*よし、今のうちだ。そっちへ降りる。*/
ライデン_007: {
Can you cover the hostages?
They're being held on level
B1 in the core.
}
/*人質を頼む。
間違い＞＞＞中央棟の１Ｆに軟禁されている。
正解＞＞＞中央棟のＢ１に軟禁されている。*/
ライデン_008: {
Pliskin, you didn't happen to find
any other places where hostages
were being held, did you?
}
/*プリスキン、他に人質が捕らわれている
場所を見つけたか？*/
プリスキン_009: {
No -- nothing like that.
}
/*いや。そんな気配はなかった。*/
ライデン_010: {
OK...
}
/*そうか……。*/
プリスキン_011: {
How many hostages are there?
}
/*人質は何人いた？*/
ライデン_012: {
There's a few short of thirty.
One dead, and several wounded.
}
/*３０名弱……うち、１名死亡した。
何人か怪我もしている。*/
プリスキン_013: {
The Kasatka's cargo area
will hold thirteen max.
}
/*カサッカの貨物はどうがんばっても
１３人が限界だ。*/
ライデン_014: {
What about the other Kasatka?
}
/*もう一機のカサッカは？*/
プリスキン_015: {
I sabotaged it. It can't come after
us if it can't get off the ground.
}
/*飛べない様に細工をしておいた。
追跡されては困るからな。*/
ライデン_016: {
Oh.
}
/*そうか。*/
プリスキン_017: {
We'll have to make two trips.
}
/*往復するしかない。*/
ライデン_018: {
Can you fly a Kasatka?
}
/*カサッカを操縦できるのか？*/
プリスキン_019: {
I have a pilot who's flown the
civilian model, the KA-62, in VR.
}
/*民間用のＫＡ－６２の経験パイロットが
いる。と言ってもＶＲ訓練だがな。*/
プリスキン_020: {
There's not a whole lot of
difference between the military
KA-60 and the civilian model.
}
/*機体は軍用型のＫＡ－６０とほとんど
同じだから問題なく操縦できるだろう。*/
//（ＯＦＦ）
オタコン_021: {
Cleared for takeoff...
}
/*準備完了だ……。*/
プリスキン_022: {
Raiden, let me introduce you
to my partner -- Otacon.
}
/*ライデン、俺の相棒を紹介する。
オタコンだ。*/
ライデン_023: {
"Otacon"?
}
/*オタコン？*/
オタコン_024: {
Hey, Raiden.
Nice to meet you.
}
/*やあ、ライデン。
始めまして。
よろしく頼むよ。*/
プリスキン_025: {
Damn!
}
/*まずいっ！*/
プリスキン_026: {
Raiden, I'll talk to you later.
}
/*ライデン、後で話す。*/
}//d

resource P044_01_R01_赤外線センサークリア１無線デモ１＿２__e {
//vc114402
ライデン_000: {
Colonel, I need some answers
from you. Who exactly is Pliskin
and his partner?
}
/*大佐、答えてくれ！
プリスキン達は何者なんだ？*/
大佐_001: {
I know what you're thinking.
}
/*君の考えている事ならわかる。*/
ライデン_002: {
It keeps coming back to Shadow
Moses. And now this Otacon...
}
/*シャドーモセスにオタコンと言えば……。*/
ローズ_003: {
A.k.a. Hal Emmerich, Ph.D.
A Shadow Moses survivor.
}
/*ハル・エメリッヒ博士。
シャドーモセス事件での生存者。*/
ライデン_004: {
Rose?
}
/*ローズ？*/
ローズ_005: {
Snake and Otacon both became
fugitives after Shadow Moses,
wanted for acts of terrorism.
}
/*あの事件の後、スネークとオタコンは
テロリストとして指名手配された。*/
ライデン_006: {
An anti-Metal Gear organization...
}
/*反メタルギア団体……。*/
大佐_007: {
They sabotaged and destroyed
countless Metal Gear units
throughout the world...
}
/*彼らは世界中のメタルギアを
破壊して回った。*/
ローズ_008: {
And were responsible for the
incident two years ago＃－
}
//<ページ数変更>
ローズ_008_1: {
that necessitated the
construction of the Big
Shell.
}
/*そして２年前その『ビッグ・シェル』が
建造される理由を作った。*/
ライデン_009: {
Snake and his partner
aren't terrorists.
}
/*スネーク達はテロリストではない。*/
ローズ_010: {
Jack, why are you
defending them?
}
/*ジャック、どうして彼らをかばうの？*/
ライデン_011: {
I look back on what I've
done here so far＃－
}
//<ページ数変更>
ライデン_011_1: {
and things like training and sense
of duty alone won't get you through
a sneaking mission like this.
}
/*これまで任務を遂行して感じる……
使命感だけでは＃｛潜入任務、スニーキング・ミッション｝＃は達成できない。
単にタフなだけでは。*/
ローズ_012: {
Jack, are you okay?
}
/*ジャック、大丈夫？*/
ライデン_013: {
You need something -- higher.
I can't think of the right word,
but...
}
/*それ以上に崇高な何か？
そう、的確な言葉が見あたらないが。*/
ライデン_014: {
it has to be pure will, backed
up by -- by courage, or ideals,
or something like that.
}
/*たとえば、『勇気』や『理想』に
裏付けされた強い『意志』が必要だ。*/
ライデン_015: {
I'd stake my life on it.
}
//<ページ数変更>
ライデン_015_1: {
The Solid Snake that saved
Shadow Moses couldn't turn
into a terrorist.
}
/*俺にも感じるんだ。シャドーモセスを
救ったスネークはテロリストに豹変は
しない。*/
大佐_016: {
Maybe that's true, but they went
down with that tanker two years ago.
We even recovered Snake's body.
}
/*それは定かではないが、
彼らは２年前、タンカーと共に沈んだ。
そしてスネークの遺体も回収されている。*/
ライデン_017: {
And the DNA test results
on the body say it's him.
}
/*遺体のＤＮＡ検査も一致。*/
ローズ_018: {
Jack, I know what you're
saying, but Snake is dead.
}
/*ジャック、あなたの気持ちもわかる。
でもスネークは死んでるの。*/
ローズ_019: {
He can't be here, not even
as this Dr. Hal Emmerich.
}
/*だから彼がハル・エメリッヒ博士である
はずはないわ。*/
ライデン_020: {
But that also means that he
can't be the terrorist leader
behind this thing.
}
/*もうひとつ確かな事がある……
テロリストのリーダーもスネークでは
ありえない。*/
}
//d




resource P046_02_R01_ハリアー戦勝利２無線デモ１＿１__e {
//vc114601
プリスキン_000: {
Raiden, you all right?
}
/*ライデン、大丈夫か？*/
ライデン_001: {
Yeah.
How about you guys?
}
/*そっちはどうなんだ？*/
プリスキン_002: {
Barely managed,
but we're all right.
}
/*どうにか着陸した。*/
ライデン_003: {
The chopper?
}
/*ヘリは無事か？*/
プリスキン_004: {
We need some time for repairs.
}
/*修理の時間が必要だ。*/
ライデン_005: {
Oh...
}
/*そうか……。*/
プリスキン_006: {
The President's all yours.
}
/*大統領を頼むぞ。*/
ライデン_007: {
OK... Can I ask you something?
}
/*あっ、ちょっと？*/
プリスキン_008: {
What?
}
/*なんだ？*/
ライデン_009: {
Are you THE Snake?
}
/*あんたが、スネークなのか？*/
プリスキン_010: {
...
}
/*……。*/
ライデン_011: {
They said you were dead...
}
/*死んだはずだ……。*/
プリスキン_012: {
No, not me. There are still too
many things I need to do.
}
/*俺は死なんさ。
まだやることがたくさんある。*/
ライデン_013: {
Snake, you're a legend -- and
that's why I need to ask you this.
}
/*スネーク、あんたが伝説の傭兵として、
聞きたいことがある。*/
プリスキン_014: {
Legend?
}
/*伝説？*/
プリスキン_015: {
A legend is nothing but fiction.
Someone tells it, someone else
remembers, everybody passes it on.
}
/*伝説は人が作るものだ。
人が記憶し、語り伝えるものだ。*/
ライデン_016: {
I'm here because I was assigned to
this mission, not because I want to.
}
//<ページ数変更>
ライデン_016_1: {
If I could, I'd be out
of here in a second.
}
/*俺は任務でここにる。自らの意志では
ない。できれば、今すぐにでもここから
逃げたい。*/
プリスキン_017: {
...
}
/*……。*/
ライデン_018: {
How could you come back to
all this? Why keep fighting?
}
/*なぜ再び戦場に？*/
プリスキン_019: {
There's something my best
friend said to me once.
}
/*ライデン、いいか。
俺の親友の言った言葉がある。*/
ライデン_020: {
Wha...?
}
/*……。*/
プリスキン_021: {
We're not tools of the
government or anyone
else.
}
//<ページ数変更>
プリスキン_021_1: {
Fighting was the only thing I was
good at, but... At least I always
fought for what I believed in...
}
/*俺達は政府や誰かの道具じゃない。
戦う事でしか自分を表現できなかったが
……いつも自分の意志で戦ってきた。*/
ライデン_022: {
What about -- what about the
DNA results from that body?
}
/*なぜ……遺体のＤＮＡ検査では。*/
オタコン_023: {
That was Liquid's body.
He and Snake are identical
on the genetic level.
}
/*あれはリキッドの遺体だよ。
彼とスネークはＤＮＡレベルでは
全く同じ。*/
ライデン_024: {
Liquid.
}
/*リキッドの遺体。*/
オタコン_025: {
A deception -- for
our own protection.
}
/*そうさ、世間の目を欺くためのトリック。*/
オタコン_0251: {
We stole his frozen body from
some organization. Kind of a
hassle though...
}
/*ある機関が冷凍保存してたのを
盗み出したんだ。
ちょっと苦労したけどね*/
プリスキン_026: {
That's all there is to it.
}
/*そういう事だ。*/
ライデン_027: {
...
}
/*……。*/
ライデン_028: {
Are you two really an NGO?
}
/*君らは本当に＃｛非政府組織、ＮＧＯ｝＃なのか？*/
オタコン_029: {
Insofar as we're a nonprofit
organization of civilians
advocating a cause, yes.
}
//<ページ数変更>
オタコン_029_1: {
The cause happens to be the
eradication of Metal Gear.
}
/*ああ、僕らは民間の反メタルギア組織さ。*/
プリスキン_030: {
We work on our own.
But it's a cause worth
fighting for.
}
/*何処にも属さない。
この地球上からメタルギアを
根絶する為に動いている……。*/
ライデン_031: {
Why would you stick your neck
out for something this risky?
}
/*なぜそんな危険な事を？*/
プリスキン_032: {
That's the way I used to
look at it, four years ago.
}
/*４年前の俺もそう思っていた。*/
プリスキン_034: {
I was holed up in the middle
of nowhere in Alaska, drinking
too much.
}
/*アラスカの僻地で自分の殻に
閉じこもって……酔っぱらっていた。*/
オタコン_035: {
We have a responsibility to the
coming generations, to the world.
}
/*僕らは伝える義務がある。
世間に、子供達に。*/
ライデン_036: {
What responsibility?
}
/*何を。*/
オタコン_037: {
To keep track of the mistakes
we've made as a species.
}
/*我々人類の間違い。*/
プリスキン_038: {
We need to remember -- to spread
the word -- to fight for change.
And that's what keeps me alive.
}
/*過ちを記憶して、伝える、抗議する……
その為に生きる。*/
ライデン_039: {
You think you can
change the future?
}
/*君らが未来を変える？*/
プリスキン_040: {
I'm not as arrogant as that.
}
/*そこまで自惚れてはいない。*/
ライデン_041: {
What you do isn't grassroots
activism. It's more like terrorism.
}
/*君らのは、草の根運動なんかじゃない。
テロに近い。*/
プリスキン_042: {
I admit that...
}
/*そうかもな。*/
オタコン_043: {
But our group, Philanthropy,
received some information:
}
/*僕らの組織『フィランソロピー』が、
情報を手に入れたんだ。*/
オタコン_044: {
a new Metal Gear prototype was
being developed here, and terrorists
were planning to raid the facility.
}
/*ここで新型メタルギア開発が行われて
いて、テロリストがそれを襲撃しようと
しているっていうね。*/
オタコン_045: {
The information came from
a very reliable source.
}
/*タレコミなんかとは違う、
信頼できる情報だった。*/
ライデン_046: {
So you're here to...
}
/*だからあんた達はここに？*/
オタコン_047: {
We're here to stop all that, but
I also have a personal motive.
}
/*ああ……。
それと、個人的な理由……。*/
プリスキン_048: {
Looks like the terrorists have
his sister in the Big Shell.
}
/*こいつの妹がビッグシェルにいるらしい。*/
プリスキン_049: {
We're here on our own, not under
anyone's orders. We have our own
battles.
}
//<ページ数変更>
プリスキン_049_1: {
Otacon's here for
someone -- I'm not.
}
/*俺達は誰の使いでもない。俺達の意志で、
俺達の闘いをしている。俺は……俺は
誰の為にも戦っていない。*/
ライデン_050: {
This is a military mission.
}
/*これはミッションだ。*/
}
//d


resource P046_02_R01_ハリアー戦勝利２無線デモ１＿２__e {
//vc114602
ローズ_000: {
Jack? Are you all right?
}
/*大丈夫、ジャック？*/
ライデン_001: {
Just barely.
}
/*かろうじて……。*/
ローズ_002: {
You almost gave me
a heart attack...
}
/*もう私、
心臓がどうにかなってしまいそう。*/
ライデン_003: {
Sorry. Wasn't intentional.
}
/*ああ、悪気はないんだが。*/
ローズ_004: {
I know that. And I know
I need to stay stronger.
}
/*ええ、わかってる。
私も強くならなくっちゃね。*/
ライデン_005: {
Say a prayer for me, Rose.
So I can come back...
}
/*祈ってくれ、俺が無事で帰れるように。*/
ローズ_006: {
You will make it back.
I'm with you all the way,
 remember...
}
/*大丈夫、帰れるわ。
私がついてる……。*/
ライデン_007: {
That means a lot
to me, you know.
}
/*心強いよ、ほんと。
この状況ではね。*/
ローズ_008: {
I'm going to save
the data, okay Jack?
}
/*ジャック、＃｛記録、セーブ｝＃しておくわね。*/
}



resource P046_02_R01_ハリアー戦勝利２無線デモ１＿３__e {
//vc114603
ライデン_000: {
Colonel, Metal Gear's
already gone active...
}
/*大佐、メタルギアはもう起動して
しまった……。*/
大佐_001: {
It's not too late. You can still
prevent a nuclear strike by
securing the President＃－
}
//<ページ数変更>
大佐_001_1: {
and preventing password
confirmation from taking
place.
}
/*まだ間に合う。大統領を確保して
コードの再確認を防げば、核攻撃は
阻止出来る。*/
大佐_002: {
Get to the President. He's in
the core section of Shell 2.
}
/*大統領の元へ急げ。シェル２の中央棟だ。*/
ローズ_003: {
I'm checking the satellite
images...
}
//<ページ数変更>
ローズ_003_1: {
Looks like you can get to
the core from the other
side of Strut L.
}
/*衛星からの映像では……
Ｌ脚の向こうまでいけば、
中央棟へいけそうよ。*/
大佐_004: {
The core hasn't gone under
yet from what we can tell.
}
//<ページ数変更>
大佐_004_1: {
Follow the railings down,
then jump onto the pipes.
}
/*今のところ、中央棟はまだ浮かんでいる
ようだ。その手すりを伝って行くしか
ない。途中でパイプに飛び移れ。*/
ローズ_005: {
The only viable strut in the
outer perimeter is the L.
}
//<ページ数変更>
ローズ_005_1: {
That attack just now doesn't make
any sense -- it's like they have no
more use for this place.
}
/*外周脚で無事なのはＬ脚だけみたい。
さっきの攻撃……変ね。
彼ら、もうここは必要ないみたい。*/
ライデン_006: {
Colonel, you were monitoring
the Codec calls. That man was
the real Snake, all along...
}
/*大佐、聞いていたろう？スネークだった、
あの男は……。*/
大佐_007: {
Maybe.
}
/*そうかもしれん。*/
ライデン_008: {
Maybe?
}
/*かもしれん？*/
大佐_009: {
Don't let your guard
down with him.
}
/*決して気を許すな。*/
ライデン_010: {
Why do you say that?
}
/*なぜ？*/
大佐_011: {
Because they were never
a part of the simulation.
They're an unknown factor.
}
/*彼らとの協力はシミュレーションには
入っておらん。不確定要素だ。*/
ライデン_012: {
You can take your simulation
and...! We're out here, we
bleed, we die!
}
/*なんでもシミュレーションなんだな。
実際に戦って、血を流してるんだぞ！*/
ローズ_013: {
Calm down!
}
/*落ち着いて！*/
大佐_014: {
I suggest that you do, Raiden.
}
/*そうだ、冷静になれ。*/
大佐_015: {
Even if that is Snake, that has
no bearing on your mission.
}
/*もし彼らがスネークであったとしても、
君の任務にはなんら変更はない。*/
ライデン_016: {
Colonel, you and Snake used
to be on the same side.
}
/*大佐、あんたは以前、スネークと共に
戦ったはず。*/
大佐_017: {
...
}
/*……。*/
ライデン_018: {
I don't understand. I read about
you and Snake in "In the Darkness
of Shadow Moses" --
}
/*わからない。
『シャドーモセスの真実』によると、
大佐とスネークは。*/
大佐_019: {
I don't give a damn what
that piece of trash said.
Do you get me?
}
/*そんなゴシップ記事は意味がない。
いいな？*/
}




resource P047_05_R01_電撃床前オルガ５無線デモ１＿１__e {
//vc114701
ライデン_000: {
I'm in front of the room where
they're keeping the President.
}
/*大統領が軟禁されている部屋に到着した。*/
大佐_001: {
Everything all right?
}
/*そこは大丈夫か？*/
ライデン_002: {
No sign of flooding, but I can't
get close to the door. The floor
is electrified.
}
/*浸水はしていないが、扉には近づけない。
高圧電流が流されている。*/
大佐_003: {
Don't test it.
You'll be bacon.
}
/*なるほど。
上は歩くな。
黒焦げになるぞ。*/
ライデン_004: {
Any suggestions?
}
/*どうすればいい？*/
大佐_005: {
Remember the Shadow
Moses VR training.
}
/*シャドーモセス事件を思い出せ。
あの事件のＶＲ訓練をな。*/
ライデン_006: {
Take out the circuit panel?
}
/*電源パネルを破壊する？*/
大佐_007: {
Right.
}
/*そうだ。*/
ライデン_008: {
But there's no way
into the room.
}
/*しかし、中には入れそうもない。*/
大佐_009: {
Try ventilation ducts.
}
/*通気ダクトがあるだろう？*/
ライデン_010: {
Yeah, I think I see one.
}
/*ああ……ダクトの穴なら……。*/
大佐_011: {
Look for a remote-control missile
launcher. You can guide it through
the duct into the room.
}
/*リモコン・ミサイルを探すんだ。
リモコン・ミサイルなら、
ダクトを通過する事ができる。*/
ライデン_012: {
-- then target the
circuit panel. Got it.
}
/*それで、室内の電源パネルを破壊すれば
いいんだな。*/
}
//d
//スクリーン内に子画面。リモコンミサイルでクリアする映像を出す。一番難しいコース。



resource P047_05_R01_電撃床前オルガ５無線デモ１＿２__e {
//vc114703
大佐_000: {
Right. But make sure you
don't hit the President.
}
/*そうだ。ただし大統領には当てるなよ。*/
ライデン_001: {
The President is wired
with nanomachines.
}
//<ページ数変更>
ライデン_001_1: {
If we know the frequency,
I can raise him...
}
/*大統領にもナノマシンが注入されて
いるんだろう？周波数がわかれば
呼びかけることも出来るが……。*/
大佐_002: {
We've tried that repeatedly,
but there's no response.
}
//<ページ数変更>
大佐_002_1: {
It looks like the walls have
a built-in radio shield.
}
/*いや、こちらからも何度かＣＡＬＬして
いるが通じない。そこの壁は通信を
妨害する素材で出来ているようだ。*/
ライデン_003: {
So that's why Ames
lost contact with him...
}
/*なるほど。
エイムズが反応を見失ったのは
そのためか……。*/
大佐_004: {
If you need to confirm his position,
you can log into the node.
}
/*だがノードに接続すれば彼の位置は
確認出来るはずだ。*/
ライデン_005: {
Understood.
}
/*わかった。*/
大佐_006: {
Locate a remote-control
missile launcher first.
}
/*まずはリモコン・ミサイルを探せ。*/
}
//d



resource P049_02_R01_大統領２無線機デモ１＿１__e {
//vc114901
ライデン_000: {
Do you read me, sir?
}
/*聞こえますか？*/
大統領_001: {
Uh... yes.
}
/*ああ。*/
ライデン_002: {
Mr. President. It's my understanding
that the terrorists have managed to＃－
}
//<ページ数変更>
ライデン_002_1: {
input the code sequence necessary
for launching a nuclear strike...
}
/*大統領、テロリスト達は核発射の
コード入力を終了したと……。*/
大統領_003: {
That's correct. I punched
the sequence in myself.
}
/*……そうだ。私が自分で入力した。*/
ライデン_004: {
You're working for them!?
}
/*……やはりあなたは奴等と……？*/
大統領_005: {
If you asked me two hours ago,
my answer would have been yes.
}
//<ページ数変更>
大統領_005_1: {
Right now, they're keeping
me alive until my vital signs
are reconfirmed.
}
/*２時間前まではな。
今はヴァイタルＩＤの再確認が
終わるまで生かされているだけの身だ。*/
ライデン_006: {
They betrayed you?
}
/*裏切られた？*/
/* テロ事件対応で一部セリフカット */
大統領_007: {
I wouldn't quite put it that way.
}
/*We had a conflict of ideals... and
I lost.
*/
//<ページ数変更>
大統領_007_1: {
I wanted power.
They sought destruction.
}
/*いや。私は継承を望み、彼らは破壊を
欲した。思想の違い、といったところ
かな。*/
/* テロ事件対応でカット */
/*
ライデン_008: {
Ideals? What kind of ideals
can justify terrorism!?
}
*/
/*思想？
テロになんの思想があると？*/
/* テロ事件対応でカット */
/*
大統領_009: {
Any movement is driven
by an ideal --
}
*/
/*どんなものにも思想はある。*/
ライデン_010: {
But why stoop to terrorism!?
}
/*……なぜテロを？*/
大統領_011: {
I wanted absolute power.
}
/*権力に加わるためだ。*/
ライデン_012: {
But you're the President --
you have power...
}
/*＃｛大統領、あなた｝＃が権力でしょう？*/
大統領_013: {
No. I'm just a figurehead.
}
/*いや、私は外様だよ。*/
ライデン_014: {
?
}
/*？*/
大統領_015: {
I don't have any control.
The real power is in the
Patriots' hands.
}
/*私に実権はないのだ。
本当の『権力』は『愛国者達』の
元にある……。*/
ライデン_016: {
The Patriots...?
}
/*『愛国者達』？*/
大統領_017: {
The truth behind this country...
}
/*この国の真実だよ。*/
}
//d




resource P049_05_R02_大統領５無線機デモ２＿１__e {
//vc114911
大統領_000: {
I wished to be a member
of the Patriots.
}
大統領_001: {
I wanted to wield the power
of a king, instead of being an
expendable pawn...
}
/*私の望みは『愛国者達』の一員となる
こと…*/
/*…彼等の支配構造に加わること
だった。使い捨ての＃｛駒、ポーン｝＃としてではなく。*/
ライデン_002: {
And that justifies
acts of terrorism?
}
/*それがテロを起こした理由？*/
大統領_003: {
Yes. I'd intended to use
the new Metal Gear as a
bargaining chip...
}
/*そうだ。新型メタルギアも、
あくまで取り引き材料として
使うつもりだった……。*/
ライデン_004: {
Bargaining chip?
}
/*……だった、とは？*/
大統領_005: {
But I underestimated Solidus...
he actually wants to challenge
the Patriots --
}
//<ページ数変更>
大統領_005_1: {
...even if it means the
destruction of the world!
}
/*私は見くびっていた。ソリダスは……
本気で彼等に闘いを挑もうとしている。
奴は世界を壊すつもりだ。*/
ライデン_006: {
What are you saying?
}
/*どういうことです？*/
大統領_007: {
Whether you believe it or not,
the balance of power rests in
the hands of the Patriots.
}
/*君が信じようと信じまいと、
世界の均衡を保っているのは
『愛国者達』なのだよ。*/
大統領_008: {
They regulate the country's
various interests through
controlled presentation,
}
//<ページ数変更>
大統領_008_1: {
staging a "drama" that is
palatable to the general
masses.
}
/*この国に渦巻く利害を調整し、
結果を分かりやすい『物語』にして
大衆に提供する。*/
大統領_009: {
Can you imagine what
would happen if they
ceased to function?
}
/*その機能が停止すれば、いや、
その存在が公になっただけでどうなる？*/
ライデン_010: {
?
}
/*？*/
大統領_011: {
Picture a massive
political vacuum,
}
大統領_012: {
a space that every power-
monger will try to fill for
their own greedy ends.
}
/*巨大な政治的真空が生まれる。
その空位を貪欲なブタどもが
見逃すはずがない。*/
大統領_013: {
I'm talking about an unregulated
power struggle -- panic, civil
war... chaos.
}
/*すぐさま共食いが始まるだろう。
世界中であらゆるタガが外れる。
紛争、内戦、恐慌……
誰も制御することはできない……。
*/
大統領_014: {
Like it or not -- the Patriots
is an organization that must
continue to exist.
}
/*彼等は闘ってはいけない相手なのだ。*/
ライデン_015: {
So you changed your mind because
you wanted to avoid global chaos?
}
/*……世界を混乱させるのはあなたの
本意ではないと？*/
大統領_016: {
Exactly.
}//<ページ数変更>
大統領_016_1: {
When I told Solidus that
I wished to prevent disaster,
}
/*……そうだ。
私には破滅を望むことが出来なかった。
だが奴は言ったよ。
*/
大統領_017: {
he replied that pawns can
never become players...
}
/*それが私の限界だ、とな。*/
ライデン_018: {
And who is this... Solidus?
}
/*……ソリダスとは、一体何者なんです？*/
}
//d




resource P049_08_R03_大統領８無線機デモ３＿１__e {
//vc114921
ライデン_000: {
I thought he resigned...
}
/*辞任ではなかったのですか？*/
大統領_001: {
That's the story given
to the general public.
}
//<ページ数変更>
大統領_001_1: {
Following his "resignation," the
Patriots selected me -- their
new pawn, for the Presidency.
}
/*公にはな。
そしてその後任の＃｛駒、ポーン｝＃に選ばれたのが
私というわけだ。*/
ライデン_002: {
But that would mean that the
Presidential race was --
}
/*あなたの選挙戦は……？*/
大統領_003: {
That was quite a show,
wasn't it?
}
//<ページ数変更>
大統領_003_1: {
It was a well-scripted drama
staged by the Patriots for the
benefit of the public.
}
/*おもしろいショーだっただろう？
大衆を満足させるためのイベントも
多く盛り込んであった。*/
大統領_004: {
Even the Democrats and
Republicans were dancing
to the Patriots' tune.
}
//<ページ数変更>
大統領_004_1: {
Everything went according to
plan, but for one exception...
}
/*民主党も共和党も『愛国者達』の意図に
沿って踊っただけだ。全て彼等の筋書き
通り……しかし予定外の出来事もあった。*/
ライデン_005: {
?
}
/*？*/
大統領_006: {
Following his resignation, Solidus'
health was scheduled to fail him,
bringing about his untimely death.
}
/*ソリダスは辞任後、病死するはずだった。*/
ライデン_007: {
Capped...?
}
/*暗殺か！？*/
大統領_008: {
Correct. But before the Patriots
could execute their plot,
}
//<ページ数変更>
大統領_008_1: {
Solidus went underground
with the help of Ocelot.
}
/*そうだ。だが奴はオセロットの
手を借り地下に潜伏した。*/
大統領_009: {
As he avoided pursuit, Solidus
gained control of Dead Cell,
}
//<ページ数変更>
大統領_009_1: {
winning over Colonel
Gurlukovich's outfit.
}
//<ページ数変更>
大統領_009_2: {
From there, he bided his time,
knowing that his opportunity
would soon arrive...
}
/*そして『愛国者達』の追撃をかわしながら、デッドセルを手なずけ、ゴルルコ
ビッチ大佐の部隊を懐柔し、時を待った。*/
ライデン_010: {
What opportunity?
}
/*時？*/
大統領_011: {
The completion of the new
Metal Gear project --
}
//<ページ数変更>
大統領_011_1: {
an opportunity that would even
his odds against the Patriots.
}
/*『愛国者達』と対等に渡り合う機会……
新型メタルギアの完成だ。*/
大統領_012: {
By stealing the Patriots'
most valued project,
}
//<ページ数変更>
大統領_012_1: {
he would be able to place them
in a very uncomfortable position.
}
/*『愛国者達』が全精力を傾けている
最重要プロジェクトを奪えば彼等の
急所を抑えることが出来る。*/
大統領_013: {
It's the only chance
he has for survival.
}
/*それが彼等に対抗出来る唯一の
手段だった。*/
大統領_014: {
Once he has the new Metal Gear,
he'll declare war against the
Patriots.
}
//<ページ数変更>
大統領_014_1: {
Needless to say,
he must be stopped.
}
/*アレが手に入り次第、奴は戦争を始める
だろう。そうなる前に奴を止めねば
ならん。*/
ライデン_015: {
Metal Gear is already
operational...

}
/*メタルギアはもう起動してしまった……。*/
大統領_016: {
No. Not yet.
}
/*いや、まだだ。*/
ライデン_017: {
?
}
/*？*/
大統領_018: {
What you saw was
Metal Gear RAY --
}
/*君が見たのはメタルギアＲＡＹ。*/
大統領_019: {
-- hijacked two years ago from
the Marines by Ocelot. That was
not the new Metal Gear.
}
/*二年前にオセロットが海兵隊から
奪ったものだ。新型メタルギアではない。*/
ライデン_019: {
Then, where's the
new Metal Gear?
}
/*では新型メタルギアとは？*/
大統領_020: {
Right here.
}
/*ここだ。*/
ライデン_021: {
What?
}
/*え？*/
大統領_022: {
You're standing in it. To be more
precise, this entire "Big Shell"
facility is the new Metal Gear.
}
/*この『ビッグ・シェル』全体が
新型メタルギアなのだ。*/
ライデン_023: {
What'd you say?
}
/*なんだって！！*/
大統領_024: {
No. I'm quite serious. The
upper structure that you've
seen is camouflage＃－
}
//<ページ数変更>
大統領_024_1: {
designed to represent an
offshore cleanup facility.
}
//<ページ数変更>
大統領_024_2: {
The main structure extends from
the foundation all the way down
to the ocean floor.
}
/*君が見てきた上部構造は偽装だ。
海洋除染施設の体裁を整えるためのな。
本体は基底部から海底に建造されている。
*/
大統領_025: {
The connecting elevator is located
on the B2 floor of the Shell 1 Core.
}
/*連絡エレベータは
シェル１中央棟のＢ２だ。*/
大統領_026: {
Arsenal Gear... that's the code
name for the new Metal Gear.
}
/*＃｛火薬庫、アーセナル｝＃ギア。それが
新型メタルギアのコードネーム……。*/
ライデン_027: {
Arsenal?
}
/*アーセナル？*/
}
//d



resource P049_10_R04_大統領１０無線機デモ４＿１__e {
//vc114931
大統領_000: {
It is a means to preserve the
world as it is. It will establish
a new form of control.
}
/*世界を保全するための手段。
新しい支配の確立。*/
大統領_001: {
The Patriots will use it to keep
their place as the country's true
rulers.
}
/*『愛国者達』がこの国の真実で
ありつづけるための要なのだ。*/
大統領_002: {
...Right now they feel
pressured and threatened.
}
/*……彼等は今、支配を脅かされ、
焦っている。*/
ライデン_003: {
By what?
}
/*何からです？*/
大統領_004: {
They fear an overabundance
of digital information --
}
//<ページ数変更>
大統領_004_1: {
the world will drown in the
coming flood of information,
and they along with it.
}
/*……デジタルによる真実の氾濫、
世界の窒息……といったところかな。*/
ライデン_005: {
?
}
/*？*/
大統領_006: {
The Arsenal plans include a
system to digitally manage
the flow of information,
}
/*それを逆にデジタルによってつなぎとめるためのメソッド。
*/
大統領_007: {
making it possible to shape the
"truth" for their own purposes.
}
//<ページ数変更>
大統領_007_1: {
In short, the Arsenal's system
is the key to their supremacy.
}
/*それを具現化するためのシステムが
アーセナルに搭載されている。
それこそがアーセナルの本質なのだ。*/
ライデン_008: {
The key...?
}
/*本質？*/
大統領_009: {
Yes, the "GW" system is
the Patriots' trump card.
}
/*『Ｇ．Ｗ』。それはそう呼ばれている。『愛国者達』の切り札。*/
大統領_010: {
Arsenal Gear will be fully
operational when "GW" is
successfully integrated.
}
//<ページ数変更>
大統領_010_1: {
Once operational, it will be
a completely new form of
power for the Patriots to wield.
}
/*『Ｇ．Ｗ』とアーセナルギアの完成は
すなわち『愛国者達』による新しい
支配の完成を意味する。*/
大統領_011: {
I had hoped to seize the project
from them so that I would be in
a strong bargaining position...
}
/*それを奪えば彼等と対等な立場に立てる
はずだった。対等な取り引きもな……。*/
ライデン_012: {
Bargain for what?
}
/*取り引き？
だが奴は……。*/
大統領_013: {
I'd hoped to trade my way
into their ranks. But Solidus
preferred rebellion.
}
/*そう。
ソリダスは取り引きではなく
闘争を望んだ。*/
大統領_014: {
Outer Heaven -- his plan to
unleash a nuclear blast over
the skies of Wall Street＃－
}
//<ページ数変更>
大統領_014_1: {
to break the Patriots' control
over the business community --
}
/*奴がやろうとしているウォール街
上空への核攻撃も、彼等の支配を
断ち切り解放区を形成するためだ。
*/
大統領_015: {
is also a key factor
in his offensive effort.
}
/*……奴はそれを
ＯＵＴＥＲ　ＨＥＡＶＥＮと呼んでいた……。*/
ライデン_016: {
Outer Heaven...?
}
/*ＯＵＴＥＲ　ＨＥＡＶＥＮ……？*/
大統領_017: {
Listen. There isn't much time.
The "football" served as the key
for activating Arsenal Gear.
}
//<ページ数変更>
大統領_017_1: {
I've already input the necessary
code sequence...
}
/*もう時間がない。アーセナルギア起動の
鍵はブラックケースが兼ねていたが……
私が入力してしまった。*/
大統領_018: {
It won't be long before "GW" begins
to establish connections with other
external systems＃－
}
//<ページ数変更>
大統領_018_1: {
and Arsenal Gear becomes
fully operational.
}
/*じきに『Ｇ．Ｗ』は外部と接続を開始し、
アーセナルギアの機関部も始動する。*/
大統領_019: {
Stop them before that
happens. That is your
role.
}
/*そうなる前に奴を止めろ。
それが君の役割だ。*/
ライデン_020: {
Role?
}
/*役割……？*/
大統領_021: {
You've got to find Emma Emmerich.
She's the only one who can stop that
thing once it's been activated.
}
/*動き出したあれを止められるのは
エマ・エメリッヒしかいない。
彼女を探せ。*/
ライデン_022: {
Emma -- Emmerich?
}
/*エマ……エメリッヒ？*/
大統領_023: {
She's the system programmer
for Arsenal Gear.
}
//<ページ数変更>
大統領_023_1: {
I believe she's somewhere on level
B1 in the core of this building.
}
/*アーセナルギアのシステム・
プログラマだ。この中央棟のＢ１で
監禁されているはず。*/
ライデン_024: {
I thought the levels
below us were flooded?
}
/*この下は浸水しているのでは？*/
大統領_025: {
I'm sure they won't let her die just
yet as she's the only remaining
programmer for this project.
}
/*いや、彼女はまだ生かされている。
残っているプログラマは彼女だけだ。
*/
大統領_026: {
According to Ocelot, she was being
held in a locker room located in the
northwest part of level B1.
}
/*オセロットが言っていた……
Ｂ１の北西にあるロッカールームだ。*/
大統領_027: {
Cut transmission, and get moving!
}
/*急げ！
通信をとくぞ。*/
}
//d




resource P049_12_R05_大統領１２無線機デモ５＿１__e {
//vc114941
ライデン_000: {
Colonel, the President is dead.
}
/*大佐、大統領が死んだ……。*/
大佐_001: {
I see... I'm sorry to hear that.
}
/*ああ……残念なことだ……。*/
ライデン_002: {
Where do we go from here?
}
/*俺はこれからどうすれば？*/
大佐_003: {
Your mission was to rescue
the President and eliminate
the terrorist threat.
}
/*君の目的は大統領の救出とテロリストの武装解除だった……*/
大佐_004: {
However, given the recent
turn of events, we will honor
the President's last directive.
}
//<ページ数変更>
大佐_004_1: {
You must put a stop to Arsenal
Gear once and for all.
}
/*だが今からは、大統領の最後の命令を
果たすことが君の任務となる。
……ライデン、アーセナルギアを止めろ。*/
ライデン_005: {
Do you actually think there's
any truth to his story＃－
}
//<ページ数変更>
ライデン_005_1: {
about this "Big Shell" facility
being a front for Arsenal Gear?
}
/*この『ビッグ・シェル』全体が
メタルギアだという話を信じろと？*/
大佐_006: {
I don't have the security clearance
necessary to verify the facts.
}
//<ページ数変更>
大佐_006_1: {
However, he was the President.
I'm sure he knew what he was
talking about.
}
/*私のセキュリティ・クリアランスでは
確認することは出来なかったが……
大統領本人の言葉だ。間違いないだろう。*/
ライデン_007: {
Aren't you forgetting that he
was part of the terrorist plot?
}
/*彼自身がテロに荷担していたとしても？*/
大佐_008: {
All the more reason why I believe
his information is reliable.
}
/*だからこそ、信憑性が高いとも言える。*/
ライデン_009: {
...
}
/*……。*/
大佐_010: {
We're talking about a man who
chose to die rather than risk a
nuclear holocaust.
}
/*それに大統領は君に自分を殺すよう頼み
すらした。核発射を無効にするために。*/
大佐_011: {
Thanks to his sacrifice, the nuclear
launch authority has shifted to the
Vice President,
}
//<ページ数変更>
大佐_011_1: {
effectively eliminating
the terrorist threat.
}
/*彼が死んだお陰で核兵器の行使権限は
副大統領に移った。
これで奴等の核兵器はただの飾りに……。*/
ライデン_012: {
Colonel, when you
put it like that,
}
//<ページ数変更>
ライデン_012_1: {
it almost sounds like I should've
assassinated the President to
"eliminate the threat."
}
/*大佐、
俺が大統領を殺すべきだったとでも？*/
大佐_013: {
That was not my intention.
}
//<ページ数変更>
大佐_013_1: {
I was trying to point out that there
is certainly some credibility to the
words of a man＃－
}
//<ページ数変更>
大佐_013_2: {
who chose death to protect
the innocent.
}
/*そうではない。彼の言葉は信用して
いいのではないかと言いたいのだ。*/
ローズ_014: {
The Colonel has a point, Jack.
}
/*ジャック、私もそう思う……。*/
ライデン_015: {
What about the information
he gave me on the "Patriots"?
}
/*……『愛国者達』とかいう連中に
ついての話も信じろと？*/
大佐_016: {
That's a new one on me.
I'll see what I can find out.
}
/*それについては初耳だ。
調査する。*/
ライデン_017: {
...
}
/*……。*/
大佐_018: {
Raiden, we're running out of time.
}
//<ページ数変更>
大佐_018_1: {
Find Emma. She's supposed to be
located on level B1, in the core of
that building you're in, right?
}
/*ライデン、時間がないぞ。
エマを探し出すんだ。
彼女はその中央棟のＢ１だろう？*/
ライデン_019: {
...
}
/*……。*/
大佐_020: {
You've got to find her before
Arsenal becomes fully operational.
}
/*アーセナルが動き出す前に彼女を
見つけ出すんだ！*/
ローズ_021: {
Hurry Jack!
}
/*急いで、ジャック！*/
ライデン_022: {
...
}
/*……。*/
大佐_023: {
It's up to you to make sure
that the President didn't
sacrifice his life in vain.
}
/*大統領の死を無駄にする気か！？*/
ライデン_024: {
Understood....
Raiden out.
}
/*……了解。*/
}
//d



resource P050_01_R01_タンカー編整理１無線機デモ１＿１__e {
//vc115001
プリスキン_000: {
What's your status, Raiden?
}
/*ライデン、そっちはどうだっ！*/
ライデン_001: {
Snake? The President...
he's been assassinated.
}
/*スネーク？
……大統領が殺された！*/
プリスキン_002: {
What!?
}
/*なんだって？*/
ライデン_003: {
There was nothing I could do --
}
/*すまない。*/
プリスキン_004: {
What about the nuclear
strike code sequence!?
}
/*核発射コードの再確認はすんでいたのか？*/
ライデン_005: {
He died before his vital ID
could be reconfirmed.
}
/*いや、最終のヴァイタルＩＤチェックの
前だった。*/
プリスキン_006: {
Then the enemy's lost their
nuclear strike capability --
}
/*ということは、奴らは核を撃てなく
なったわけだな。*/
ライデン_007: {
But, that Ocelot guy obviously
killed the President on purpose.
}
/*だが、あの男、オセロットは明らかに
わざと大統領を殺した。*/
プリスキン_008: {
Why?
}
/*どういうことだ？*/
ライデン_009: {
It doesn't make any sense.
}
//<ページ数変更>
ライデン_009_1: {
They had to know that they
couldn't launch the nuke if
they killed the President.
}
/*わからない。大統領が死ねば核が
撃てなくなることは奴等も知っていた
はずだ。*/
オタコン_010: {
Maybe there's a way to launch
without reconfirming the vital ID?
}
/*ヴァイタルＩＤチェックを回避して
核を撃つ方法がある？*/
プリスキン_011: {
Or maybe they've found a more
effective weapon within Arsenal
Gear.
}
/*あるいは核以上の何かがあるということ
だろうな……アーセナルギアには。*/
ライデン_012: {
You knew about Arsenal Gear!?
}
/*知っていたのか？アーセナルギアのこと？*/
プリスキン_013: {
Yeah...
}
/*ああ。*/
ライデン_014: {
Why didn't you
tell me about it!?
}
/*……なぜ教えてくれなかった？*/
プリスキン_015: {
You never asked.
}
/*聞かれなかったからな。*/
ライデン_016: {
Am I correct in assuming you
also know that the Big Shell's
a front for the project!?
}
/*……『ビッグ・シェル』が偽装だという
ことも？*/
プリスキン_017: {
You mean, did I know
that the Big Shell,
}
//<ページ数変更>
プリスキン_017_1: {
a fully functional environmental
cleanup facility, was designed to
camouflage Arsenal Gear?
}
/*ああ。この『ビッグ・シェル』は一応、
海洋除染施設の体裁を整えてはいる。
*/
プリスキン_018: {
Yeah, I did.
}
プリスキン_018_1: {
It's exactly what the President
and Ames described... a massive
cover story.
}
/*だがエイムズや大統領の言った通り、
それは偽装だった。*/
プリスキン_019: {
The good news is that it hasn't
really done much in terms of
cleaning up the environment,
}
//<ページ数変更>
プリスキン_019_1: {
so we won't have to worry about
any toxic gas being released if
we have to blow the house down.
}
/*海水除染は申し訳程度にしか行われて
いないし、破壊されても有毒化学物質
など発生しないだろう……。*/
ライデン_020: {
Right... and when did
you find out about all
of this?
}
/*……いつからそれを？*/
プリスキン_021: {
It took a while, but we uncovered
the info around the time you took
out that mad bomber.
}
/*確かめるには時間がかかった。
調べがついたのはお前があの爆弾魔を
処理した後くらいだな。*/
ライデン_022: {
...
}
/*……。*/
プリスキン_023: {
There's no doubt that Arsenal
Gear is being built here...
}
/*アーセナルギアがここで建造されて
いるのは確かだ。
*/
プリスキン_024: {
then it was all set up two years
ago on that day -- all of it.
}
/*おそらく二年前のあの時から
仕組まれていたんだろう……
全てがな……。*/
ライデン_025: {
Two years ago...
What really happened here?
}
/*二年前……
この場所で本当は何があったんだ？*/
}
//d




resource P050_04_R02_タンカー編整理４無線機デモ２＿１__e {
//vc115011
ライデン_000: {
How did you manage to get out?
}
/*よく無事だったな？*/
プリスキン_001: {
Otacon managed to have
a small boat ready for me.
}
/*オタコンが小型艇を用意してくれていた。*/
オタコン_002: {
That was the easy part.
}
//<ページ数変更>
オタコン_002_1: {
The tough part was not getting
dragged down with the sinking
tanker --
}
//<ページ数変更>
オタコン_002_2: {
small miracle when
you think about it.
}
/*沈没するタンカーに巻き込まれない
ようにするのが大変だった。
我ながら、奇跡に近い。*/
オタコン_003: {
It turned out that the whole
thing was a setup to lure us.
}
/*全ては僕達をおびき寄せるための
罠だったんだ。*/
}
//d





resource P050_06_R03_タンカー編整理６無線機デモ３＿１__e {
//vc115021
プリスキン_000: {
Forget it. We're wasting time.
We can figure this out later.
}
/*なに、いずれわかるだろうさ……。
だが今はこれ以上考えている時間は
なさそうだ。*/
プリスキン_001: {
The nuclear strike's
been prevented,
}
//<ページ数変更>
プリスキン_001_1: {
but Arsenal still has a massive
payload of missiles to deal with.
}
/*核が使えなくとも、アーセナルには
莫大な量のミサイル兵器がある。*/
オタコン_002: {
Right. If the opposition gets
control of those missiles...
}
/*そうだね。
奴等がそれを手に入れたら……。*/
プリスキン_003: {
Raiden -- you've
got to find Emma.
}
/*ライデン、エマのところに急いでくれ。*/
ライデン_004: {
Wait a second.
Isn't Emma Emmerich --
}
/*待ってくれ、そのエマ・エメリッヒと
いうのが、あんた達が言っていた……？*/
オタコン_005: {
My sister.
}
/*そう。僕の妹だ。*/
ライデン_006: {
What's she doing here?
}
/*彼女はここで何を？*/
オタコン_007: {
You got me. She's a computer whiz
who specializes in neural-AI＃－
}
//<ページ数変更>
オタコン_007_1: {
and ultra-variable volume data
analysis using complex logic.
}
/*……わからない。
彼女は確かにコンピュータの天才だ。
でも専門はニューロＡＩと複雑性理論を
応用した超多変量情報解析で、*/
オタコン_008: {
How she got involved in
weapons development is
beyond me.
}
/*兵器開発
じゃないんだ……。*/
ライデン_009: {
...
}
/*……。*/
プリスキン_010: {
Whatever her reasons, we need
her in order to stop Arsenal.
}
/*とにかくアーセナルを止めるには
彼女の力を借りるしかない。*/
オタコン_011: {
Raiden -- find her.
}
/*ライデン、彼女を頼む。*/
ライデン_012: {
I'm on my way.
}
/*わかった。*/
}
//d



resource P051_01_R01_エマとオタコン１無線機デモ１＿１__e {
//vc115101
ライデン_000: {
Colonel, I want some background
information on Emma Emmerich.
}
/*大佐、
エマ・エメリッヒの情報を知りたい。*/
大佐_001: {
I've got it right here, direct from
the National Security Agency's
personnel files.
}
/*ああ。調べさせておいた。
＃｛国家安全保障局、ＮＳＡ｝＃の局員ファイルに
彼女の名前があった。*/
大佐_002: {
Apparently she was involved in some
sort of high-level project, but
there's no details on that.
}
/*何らかの極秘プロジェクトに関わって
いたようだが、それについての記載は
ない。*/
大佐_003: {
Her record shows that she resigned
from the agency two years ago --
}
/*記録では二年前に職を辞したことに
なっている……。*/
大佐_004: {
Emma Emmerich.
Full name: Emma
Emmerich-Danziger.
}
大佐_004_1: {
Members of her
family call her "E.E."
}
/*エマ・エメリッヒ。
本名、エマ・エメリッヒ・ダンジガー。
家族からはＥＥと呼ばれていたらしい。*/
大佐_005: {
After divorcing Hal Emmerich's
father, her mother took Emma to
England and raised her there.
}
/*彼女はハル・エメリッヒの父親と離婚後、
母に連れられてイギリスに戻った。*/
大佐_006: {
Danziger is her mother's maiden
name, but she prefers Emmerich.
}
/*まだ６歳の子供だった。ダンジガーは
母親の姓だが、彼女は好んでエメリッヒ
という姓を使っている。*/
大佐_007: {
After returning home to England,
her mother married Robinson,
a businessman.
}
/*故郷イギリスに帰った後、
彼女の母親は再婚している。
ロビンソンという実業家だ。*/
大佐_008: {
The following details are from a
report filed with the NSA when
she joined the agency...
}
/*以下はＮＳＡに入る際、取られた調書だ。*/
大佐_009: {
Just before graduating from high
school, Emma injured Robinson in
self-defense＃－
}
//<ページ数変更>
大佐_009_1: {
during an alleged assault
on her person.
}
/*……エマがハイスクールを卒業しようと
していた頃、義理の父親から暴行を受け
そうになり、父親を傷つけてしまう。*/
大佐_010: {
As a result of this incident, she
followed in the footsteps of her
stepbrother, Hal Emmerich,
}
//<ページ数変更>
大佐_010_1: {
and left home to enroll in Oxford.
}
/*この事が原因でエマは義理の兄、ハル・
エメリッヒが歩んだのと同じように一人
家を出てオックスフォードへ入学する。*/
大佐_011: {
It is believed that at this
particular point in her life,
}
//<ページ数変更>
大佐_011_1: {
she was extremely angered by
the fact that her brother failed
to protect her.
}
/*この時もエマは自分を守ってくれない兄、
ハルに対して非常な怒りを憶えている。*/
大佐_012: {
Consequently, she lost all family
connections and is very resentful.
}
//<ページ数変更>
大佐_012_1: {
She seems to believe that her
brother is to blame for everything.
}
/*エマもハルと同じく、この時に事実上、
家族を失っている。『自分の不幸は全て
兄のせいだ』とも思いこんでいるようだ。*/
大佐_013: {
While attending Oxford,
}
//<ページ数変更>
大佐_013_1: {
she was noted for her success in
a deciphering event sponsored by
British GCHQ.
}
/*オックスフォード在学中に、彼女は
英国政府中央情報部が主催する暗号解読
イベントで解読に成功している……。*/
ライデン_014: {
They may not be blood-related,
but she sure sounds like Otacon's
sister.
}
/*なるほど、血は繋がってはいないが、
オタコンの妹だ。*/
大佐_015: {
There's more --
}
/*いやそれで終わりではない。*/
大佐_016: {
Raiden, do you recall a certain
'situation' that's more or less
become a legend among hackers?
}
/*ライデン、ハッキング史上類をみない、
ある出来事を覚えているか？*/
大佐_017: {
To refresh your memory --
}
//<ページ数変更>
大佐_017_1: {
at the time, just about all of
our nation's communications
and information resources
}//<ページ数変更>
大佐_017_2: {
were concentrated at NSA,
in Fort Meade.
}
/*当時の、わが国のあらゆる通信情報は
フォート・ミードにあるＮＳＡに
集中していた。*/
大佐_018: {
In fact, NSA's basement facility
operated round-the-clock to
amass data obtained＃－
}
//<ページ数変更>
大佐_018_1: {
not only from public communications,
but everything from satellite to
wiretap operations as well.
}
/*衛星や盗聴などで得られた一般を含む
あらゆる通信情報が、２４時間体勢で
ＮＳＡの地下に集められていたのだ。*/
大佐_019: {
I don't think I'm exaggerating when
I say that whoever controlled the
NSA facility could move the world.
}
/*ここの情報を牛耳るものがそれこそ、
世界を動かす事ができる。*/
大佐_020: {
On January 24th in the year 2000,
the facility suffered a total system
shutdown for a 73-hour period.
}
/*ところが、２０００年の１月２４日……
このシステムが７３時間に渡って
ダウンした……。*/
ライデン_021: {
Did they ever figure out the cause?
}
/*原因は？*/
大佐_022: {
It's believed that a small
group within the government
had arranged the incident＃－
}
//<ページ数変更>
大佐_022_1: {
with the assistance of a
notorious group of crackers.
}
/*政府の一部が指示したという噂がある。
当時有名だったクラッカー・グループにな。*/
大佐_023: {
The result was a full review
of NSA's safety measures,
}
//<ページ数変更>
大佐_023_1: {
which in turn led to the decision
to shift the data-gathering
operations to an isolated location
}
/*結果として安全対策は見直され、
ＮＳＡのこの機能を別に移そうという
計画になった……
*/
大佐_024: {
that would be safe from physical
attack as well as cyber-terrorism.
}
/*物理的なテロやサイバーテロから
隔離された場所に。
*/
ライデン_025: {
And where might that be?
}
/*何処に？*/
大佐_026: {
My security clearance couldn't
get me that information.
}
//<ページ数変更>
大佐_026_1: {
But I did find out that one of the
key members of the hacker group
was none other than Emma Emmerich.
}
/*それは私のクリアランスでは
近づくことはできない。
そのメンバーの中心人物がエマだった。*/
大佐_027: {
Although she started off
as a specialist in artificial
intelligence and complex logic,
}
//<ページ数変更>
大佐_027_1: {
Emma is now regarded
as a computer genius.
}
/*彼女の専門はあくまで人工知能と複雑性
理論だったが、既にコンピュータの天才
として一目を置かれる存在になっていた。*/
ライデン_028: {
That would make her a prime
candidate for recruitment＃－
}
//<ページ数変更>
ライデン_028_1: {
in the intelligence community,
wouldn't it?
}
//<ページ数変更>
ライデン_028_2: {
And knowing most of the
intelligence agencies,
}
//<ページ数変更>
ライデン_028_3: {
I doubt fair play was a major
concern in their recruiting
efforts...
}
/*で、世界中の諜報機関が彼女を
スカウトした。いつもの汚いやり方で？*/
大佐_029: {
Your assumption's correct.
The government played on
her weakness --
}
/*あまり違いはない。
政府は彼女の弱みを探した。*/
大佐_030: {
-- her strong hate
for Hal Emmerich,
}
/*彼女の弱みは……６歳の時に別れた兄、
ハル・エメリッヒへの想いだった。*/
大佐_031: {
the brother who left her when
she was six years old.
}
/*それも強烈な恨みだ。
*/

ライデン_032: {
She hates him that much?
}
/*恨み？*/
大佐_033: {
When she was six years old, Emma
and her father were involved in a
pool accident.
}
大佐_033_1: {
She survived, but her father drowned.
}
/*彼女が６歳の時に事故があった。エマと父親がプールで溺れた。父親は助からず、溺死した。
*/
ライデン_034: {
What did the police have
to say about that?
}
/*警察は？
*/
大佐_035: {
Their report states it
was an accidental death.
}
/*当時の警察は事故として処理している。
*/
ライデン_036: {
Isn't that about the time that
Otacon left his home and family?
}
/*オタコンが家を出たのはその直後なのか？
*/
大佐_037: {
Exactly. But I don't have any
idea why he chose to do so.
}
/*そうだ。何があったかはわからんが……。
*/
}//d

resource P051_01_R01_エマとオタコン１無線機デモ１＿２__e {
//vcxxxxxxxxx
ライデン_000: {
Does Emma blame Otacon
for her father's death?
}
/*エマは事故の原因を？*/
大佐_001: {
I don't think so. Her hate seems to
stem from the fact that she believes
Otacon abandoned her.
}
/*いや、エマは兄に見捨てられたと
思っているようだ。*/
大佐_002: {
You see, although the two weren't
directly related, they were said to
be very close.
}
/*それまでは連れ子同士にもかかわらず、
非常に仲のいい＃｛兄妹、きょうだい｝＃だった
らしい。*/
大佐_003: {
It's rumored that sibling rivalry
was what launched her career
as a hacker.
}
/*彼女がクラッカーまがいの行為を
行なっていたのも、兄への対抗意識
だったのだろう……。*/
大佐_004: {
Four years ago, the government
leaked her the details of the
Shadow Moses incident.
}
//<ページ数変更>
大佐_004_1: {
In doing so, they were able
to recruit her for the NSA.
}
/*そして４年前、政府はシャドーモセス
事件の真実を彼女にリークし、ＮＳＡへ
入ることに同意させた。*/
大佐_005: {
I also have little doubt...
}
//<ページ数変更>
大佐_005_1: {
that they also used the NSA hacking
affair as a means to 'convince' her
to cooperate.
}
/*例のハッキングの件も保険として、
脅迫材料に入っていたに違いない。*/
ライデン_006: {
You think that her hate drove her
to frame Snake and Otacon?
}
/*オタコン達に濡れ衣をかぶせたのも、
そういう理由か？*/
大佐_007: {
That -- I don't know.
}
/*それはわからん。*/
}
//d



resource P052_01_R01_ローズ無線１無線機デモ１＿１__e {
//vc115201
ローズ_000: {
Jack?
}
/*ジャック、聞いて？*/
ライデン_001: {
What is it?
}
/*どうした？*/
ローズ_002: {
I've always been alone...
}
/*私いつも独りだった……。*/
ライデン_003: {
Huh?
}
/*？*/
ローズ_004: {
I'm so lonely...
}
/*私、寂しかった……。*/
ライデン_005: {
Lonely? Rose, we've always --
}
/*ローズ？
俺はいつも君と？*/
ローズ_006: {
Not always.
}
/*違うわ……。*/
ライデン_007: {
What do you mean?
}
/*違うって？*/
ローズ_008: {
You've never slept beside me...
}
/*あなたは私と眠った事はなかった……。*/
ライデン_009: {
What are you talking about?
I --
}
/*何の話だ？*/
ローズ_010: {
After we've been together in my
room... you stay awake all night
or you head for the door.
}
/*私の部屋で愛し合った後……
あなたはいつも朝まで起きているか、
帰っていくかのどちらかだった。*/
ライデン_011: {
Is this really the time
to bring this up?
}
/*こんな時に何を？*/
ローズ_012: {
Why, Jack? Why?
}
/*なぜなの？
ジャック？*/
ライデン_013: {
Listen, Rose. I'm right in the
middle of a mission, and I...
}
/*ローズ？
任務中だ……。*/
ローズ_014: {
Why!? Why can't you relax
when you're with me!?
}
/*なぜなの？
私といると安らげないの？*/
ライデン_015: {
Look... the mission... I...
}
/*任務中……。*/
ローズ_016: {
Why don't you open up to me!?
}
/*どうして心を開いてくれないの？*/
ライデン_017: {
Rose... I... I just can't!
}
/*違う。*/
ローズ_018: {
All I ever wanted was to share your
dreams -- to spend a meaningful
evening with you...
}
/*夢を共有したい、
あなたと夜を過ごしたい。*/
ローズ_019: {
I just wanted to find you by
my side when I woke up. Is
that asking too much?
}
/*そして朝を向かえたい。
ダメなの？*/
ライデン_020: {
It's the night -- I'm scared of
the night... it's got nothing to
do with you...
}
/*夜が……夜が怖いんだ。
君は関係ない。*/
ローズ_021: {
Scared of the night?
What's that supposed
to mean?
}
/*夜が怖いって……そんなの……。*/
ライデン_022: {
I can't relax when
I'm with someone...
}
/*人前では熟睡できないんだ。*/
ローズ_023: {
Jack? You wouldn't even
let me in your room!
}
/*ジャック？
私があなたの部屋に入ることも嫌がった。*/
ライデン_024: {
I need privacy...
I just can't be bothered.
}
/*自分の生活を、邪魔されたくないんだ。*/
ローズ_025: {
Bothered!?
}
/*邪魔だなんて？*/
ライデン_026: {
Wrong word! What I wanted to say
was that there are certain things
that I have to keep to myself...
}
/*いや、覗かれたくない。*/
ローズ_027: {
Do you remember that time
I forced my way into your room?
}
/*憶えてる？
無理矢理あなたの部屋に押し入ったの？*/
ローズ_028: {
We'd known each other for almost
a year... and you blew up!
}
//<ページ数変更>
ローズ_028_1: {
It was the first time you ever
raised your hand against me!
}
/*つきあい始めてもう１年も経っていた。あなたはもの凄く怒ったわ。
私に初めて手を挙げた。*/
ライデン_029: {
...
}
/*……。*/
ローズ_030: {
I was so worried about you...
}
/*あなたが心配だったの。*/
ライデン_031: {
Look... I'm sorry...
}
/*わるかった……。*/
ローズ_032: {
It wasn't your violent nature that
scared me. It was your room...
your heart...
}
/*いいえ、
私が怯えたのはあなたの暴力じゃない。
あなたの部屋……あなたの心の中……。*/
ライデン_033: {
Stop it...
}
/*やめてくれ……。*/
ローズ_034: {
There wasn't anything in your room
-- only a bed and a small desk. It
looked like a prison cell...
}
/*何もない部屋だった。
ベッドと小さな机が一つ。
まるで、刑務所の独房のようだった。*/
ライデン_035: {
Rose?
}
/*ローズ？*/
ローズ_036: {
No television set...
no family pictures...
not even a poster...
}
/*家族の写真もポスターも、
テレビさえもなかった。*/
ライデン_037: {
Rose, I only use that
room for sleeping.
}
/*ただ寝るだけの部屋だ……。*/
ローズ_038: {
A lifeless room... almost
like your empty heart.
}
/*生活感のない部屋、
実体のないあなた……。*/
ライデン_039: {
That's why I tried
to keep you out.
}
/*だから、君には来て欲しくなかったんだ。*/
ローズ_040: {
I thought I was beginning to
understand you -- until I saw
that room.
}
/*あなたの部屋を見て……
あなたがわからなくなった。*/
ライデン_041: {
Would you've been happier if
I had a picture of you hanging
on the wall!?
}
/*君の写真が飾ってあればよかったのか？*/
ローズ_042: {
That's not what I was
trying to say --
}
/*いいえ、そんな意味じゃない。*/
ライデン_043: {
Enough, Rose. We'll talk about
this later... after the mission.
}
/*ローズ、後で話し合おう……。
この任務が終わったら。*/
ローズ_044: {
Right... after the mission...
I understand.
}
/*……ええ……そうね。
わかったわ。*/
}
//d



resource P053_01_R01_息継ぎ１無線機デモ１＿１__e {
//vc115301
オタコン_000: {
Raiden, are you reading me?
This is Otacon. What's your
situation?
}
/*ライデン、聞こえる？
僕だよ。そっちの状況はどうだい？*/
ライデン_001: {
Wet and miserable...
this place is flooded.
}
//<ページ数変更>
ライデン_001_1: {
The seawater that's been pumped
up is pouring into the building.
}
/*浸水がひどい。
汲み上げた海水が流れ込んで来ている。*/
オタコン_002: {
I see. Listen, there's something
I have to tell you about E.E.
}
/*そうか、やっぱり……ＥＥの事だけど、
どうしても言っておきたい事がある。*/
ライデン_003: {
Don't worry about her.
I'll get her out --
}
/*心配するな、彼女は助ける。*/
オタコン_004: {
She's afraid of water.
}
/*彼女、水が苦手なんだ。*/
ライデン_005: {
What!?
}
/*水が？*/
オタコン_006: {
Yeah... when she was six years old,
she almost drowned with my father
in our swimming pool.
}
/*ああ……６歳の時に、家のプールで
溺れたんだ。僕の親父と一緒に。*/
ライデン_007: {
She can't swim!?
}
/*泳げなかったのか？*/
オタコン_008: {
Well yes and no... we used to swim
a lot together when we were kids.
}
//<ページ数変更>
オタコン_008_1: {
In fact, she swam like a fish until
that day when she almost drowned...
}
/*そうじゃない。泳ぎは得意だった。
よく二人で泳ぎに行った……。
あの事故が起こるまではね。*/
}
//d

//大佐の説明を聞いている人のみ
resource P053_01_R01_息継ぎ１無線機デモ１＿２__e {
//vc115302
ライデン_000: {
That pretty much coincides with
what the Colonel told me...
}
/*……やはり、大佐の話は本当だったのか。*/
}
/**///d
resource P053_01_R01_息継ぎ１無線機デモ１＿３__e {
//vc115303
オタコン_000: {
When the accident happened, I was
in my room. I learned later that E.E.
was calling me for help...
}
/*僕はあの時、自分の部屋にいた。
……ＥＥはずっと僕に助けを……
呼んでたらしい。*/
オタコン_001: {
She didn't doubt for a
minute that I'd be there.
}
/*お兄ちゃんが助けてくれる、
お兄ちゃんなら……。*/
オタコン_002: {
You could see the pool from
my room... but I didn't realize at
the time that she needed my help.
}
/*僕の部屋からはプールがよく見えたんだ。
……でも僕は気づかなかった。*/
ライデン_003: {
What were you doing?
}
/*何してたんだ？*/
オタコン_004: {
I... I was...
}
/*その時、僕は……。*/
ライデン_005: {
So Emma survived the ordeal...
}
/*エマは助かったんだろう？*/
オタコン_006: {
Yeah. But my father didn't...
}
/*ああ、幸いね。
親父は助からなかったけど……。*/
ライデン_007: {
So you blamed yourself
and left your family?
}
/*あんたはその事で、自分を責め……
家を出た？*/
オタコン_008: {
No. E.E. seems to believe that
was the case. The fact is...
I betrayed her.
}
/*いや、そうじゃないが、
彼女はそう思っているかもしれない。
僕はＥＥを裏切ったんだ。*/
ライデン_009: {
And you think that she can't
swim because of the traumatic
experience?
}
/*それがトラウマになって、泳げないと？*/
オタコン_010: {
I haven't seen her since that
day... but yes, I think so.
}
/*ああ。
……あれから直接は会ってないけど……。*/
オタコン_011: {
I got a letter from Julie, her
mother, after they moved
back to England.
}
/*彼女たちがイギリスに帰って、
しばらくしてから手紙が来たんだ。
母親のジュリーから。*/
オタコン_012: {
In her letter, she mentioned that
E.E. couldn't swim anymore...
}
//<ページ数変更>
オタコン_012_1: {
that she refused to even
wear a bathing suit.
}
/*あれ以来、ＥＥが泳ぐ事がなくなった、
水着を着ることもなくなったって。*/
ライデン_013: {
Damn! If she still can't swim,
we're in trouble... level B1 in
the core is pretty much flooded.
}
/*そのトラウマが生きているとすると、
まずいな。中央棟のＢ１はほとんど
浸水している。*/
オタコン_014: {
Look... maybe you can help
her overcome the trauma.
}
/*なんとか彼女を勇気づけてやってくれ。*/
ライデン_015: {
You want me to help
her get over it?
}
/*こっちが勇気づけて欲しい
状況なんだが……。*/
オタコン_016: {
It's still going to take some
time to repair the Kamov.
}
/*カモフの修理にまだ時間がかかる。*/
プリスキン_017: {
Sorry, kid. Emma's
rescue is up to you.
}
/*悪いが手が離せない。エマの事は頼む。*/
ライデン_018: {
Thanks. An underwater mission...
well, this is a first. Look -- I'll
see what I can do.
}
/*水中でのミッションは初めてなんだが。なんとかやってみる。*/
プリスキン_019: {
I suggest that you drum
the map of the building
into your head,
}
//<ページ数変更>
プリスキン_019_1: {
'cause you won't have time
to look at it when you try to
bring Emma out.
}
/*今のうちにマップを頭にたたき込んで
おくことだ。エマを連れて進む事になる。*/
オタコン_020: {
I'm counting on you, Raiden.
}
/*頼むよ。*/
プリスキン_021: {
I covered most of the core when
I had to take out the C4's...
}
//<ページ数変更>
プリスキン_021_1: {
if there's anything you need to
ask me, call me on the Codec.
}
/*中央棟は俺の方が詳しい。Ｃ４解除で
一通り、回ったからな。何か聞きたい
ことがあれば無線連絡をくれ。*/
ライデン_022: {
I'll do that.
}
/*わかった。*/
}
//d



resource P057_02_R01_ヴァンプ戦終了２無線機デモ１＿１__e {
//vc115701
ライデン_000: {
Colonel! They've apparently
completed the final check
procedure for Arsenal Gear!
}
/*大佐、アーセナルギアの最終チェックが
終わったらしい！*/
大佐_001: {
Find Emma on the double!
}
//<ページ数変更>
大佐_001_1: {
You've got to get her to
install the virus program
that the President gave you!
}
/*早くエマを助け出せ。
彼女に大統領からもらったウィルスを
入力させるんだ。
*/
大佐_002: {
When you find her, take her to
the Computer Room on level B2
in the core of Shell 1!
}
/*彼女を救出してシェル１中央棟Ｂ２の
電算室へ連れて行け。*/
}
//d




//スネークに無線機ＳＥＮＤ（周波数変更）
resource P057_02_R01_ヴァンプ戦終了２無線機デモ１＿２__e {
//vc115702
ライデン_000: {
Snake! Did you catch all that!?
I didn't make it on time...
Arsenal's going active!
}
/*スネーク、聞こえたか？
間に合わなかった。
アーセナルが動き出す！*/
プリスキン_001: {
Yeah, I heard. The
hostage rescue's
gonna have to wait.
}
/*ああ、聞こえた。
人質の救出は後回しだ。*/
ライデン_002: {
I'm going after Emma.
}
/*俺はエマを助け出す。*/
プリスキン_003: {
We'll secure the Computer Room.
}
/*わかった。
俺達は電算室を確保する。*/
}
//d

//無線機の小画面に大統領がＭＯを渡す映像が映る
resource P057_02_R01_ヴァンプ戦終了２無線機デモ１＿３__e {
//vc115703
プリスキン_000: {
Looks like we can't install the
virus program without Emma.
}
/*やはりエマでなければウィルスを
侵入させることは出来ないらしい。*/
ライデン_001: {
Can't your partner do it?
}
/*あんたの相棒でも駄目なのか？*/
オタコン_002: {
I would if I could. But the security
for this system is no joke. I need
more time...
}
/*出来ればやってる。
ここのセキュリティはよく出来てるよ。
短時間じゃちょっと手が出せない……。*/
プリスキン_003: {
That's why we need her.
}
/*そういうことだ。
エマを連れてきてくれ。*/
ライデン_004: {
Understood. I'll make
sure you have your
family reunion...
}
/*わかった。安心してくれ。
ちゃんと兄妹を対面させてみせるさ。*/
オタコン_005: {
...
}
/*……。*/
ライデン_006: {
What's up?
}
/*どうした？*/
オタコン_007: {
A lot of years have passed
between E.E. and me...
}
/*……ＥＥとは長い間、会ってないんだ。*/
ライデン_008: {
Then you should see her, right?
}
/*だからすぐ会えるじゃないか。*/
オタコン_009: {
I don't have the right to see her.
}
/*いや、僕には彼女に逢う資格はないんだ。*/
プリスキン_010: {
We can talk about this later.
Raiden, I think you'd better
get moving,
}
/*事情があるようだが、時間がない。
エマはその部屋の北にある
ロッカールームだろう？*/
プリスキン_011: {
Emma's in the Locker Room
to the north, right?
}
/*ライデン、頼むぞ。*/
ライデン_012: {
I'm on it.
}
/*わかった。*/
}
//d


resource P058_02_R01_エマ救出２無線機デモ１＿１__e {
//vc115801
ライデン_000: {
Can you hear me, now?
}
/*聞こえるか？*/
エマ_001: {
Nanocommunication...?
}
/*体内通信？*/
ライデン_002: {
That's right.
I have nanomachines, too.
}
/*そうだ、俺の体内にもナノマシンが
注入されている。*/
エマ_003: {
Then you're not one of them...
}
/*あいつらとは違う……？*/
ライデン_004: {
That's what I've been
trying to tell you.
}
/*そういう事だ。*/
エマ_005: {
And you came to rescue me?
}
/*で、私を助けるのが任務？*/
ライデン_006: {
Actually, I need your help
to stop Arsenal...
}
//<ページ数変更>
ライデン_006_1: {
I understand you're the only one
who might be able to do it.
}
/*俺はアーセナルを止めに来たんだ。
協力してほしい。あれを止められるのは
君しかいないと聞いた。*/
エマ_007: {
And who told you that?
}
/*……誰からそんなことを？*/
ライデン_008: {
The President.
}
/*大統領。*/
エマ_009: {
...Really?
}
/*……ホントに？*/
ライデン_010: {
I need you to come with me to
Shell 1. Your brother's waiting
for you there.
}
/*一緒にシェル１に来てくれ。
君のお兄さんが待ってる。*/
エマ_011: {
My brother?
}
/*お兄ちゃん？*/
ライデン_012: {
C'mon!
We have to get moving!
}
/*とにかく、ここを出よう！*/
ライデン_013: {
This place'll be flooded soon!
}
/*いつ浸水するかわからない。*/
}
//d



resource P058_04_R02_エマ救出４無線機デモ２＿１__e {
//vc115811
エマ_000: {
Leave me...
}
/*だから、ここに……。*/
ライデン_001: {
You can swim!
You used to love it!
}
/*泳げないんじゃない！
エマ、君は泳げたんだ！*/
エマ_002: {
How did you know...?
}
/*どうして、そのことを？*/
ライデン_003: {
Your brother told me.
}
/*君のお兄さんに聞いた。*/
エマ_004: {
He's really here?
}
/*本当に、ここに？*/
ライデン_005: {
That's right... he's
here to rescue you.
}
/*ああ。君を助ける為に。*/
エマ_006: {
I don't believe you!
He would never come for me!
}
/*ウソよ。
あの男がそんな事をするはずない！*/
ライデン_007: {
And I'm telling you he's
here -- waiting for us
at Shell 1!
}
/*ウソじゃない。
シェル１で君が来るのを待っている。*/
エマ_008: {
No! He left me... my mother --
when we needed him the most!
}
/*信じられない！
あの男は私を捨てたの。
私達親子をね。*/
エマ_009: {
When my father died, all he
could think about was himself!
}
/*父が死んだ、一番辛い時に。
あいつは自分だけ……。*/
ライデン_010: {
Emma, we can go over all that
later. But first, we have to get
out of here!
}
/*エマ、恨み言は後でいくらでも聞く。
ここから離れよう！*/
エマ_011: {
No! I hate water!
}
/*嫌っ！
水は嫌い！*/
エマ_012: {
It's hopeless!
I can't swim!
}
/*無理よ！泳げないっ！*/
}
//d



resource P058_07_R03_エマ救出７無線機デモ３＿１__e {
//Vc115821
ライデン_000: {
Put your ear against my chest
and listen to my heartbeat.
}
/*俺の心臓のに耳を当てておくんだ。*/
エマ_001: {
Your heartbeat?
}
/*心臓？*/
ライデン_002: {
Count the beats -- don't think about
anything else. When you reach 100,
open your eyes.
}
//<ページ数変更>
ライデン_002_1: {
By that time, we'll be
on the other side.
}
/*鼓動の数を数える、ひとつ、ふたつ……
他の事は考えるな。１００まで数えたら、
目を開けろ。向こう側についてる。*/
ライデン_003: {
Give me a signal if you think
you're running out of breath.
}
/*苦しくなったら、合図をくれ。*/
エマ_004: {
What will you do then?
}
/*そしたら？*/
ライデン_005: {
I'll swim faster.
}
/*できる限り、急いでむこうまで行く。*/
}
//d



resource P059_03_R01_エマ休憩３無線機デモ１＿１__e {
//vc115901
大佐_000: {
Raiden, what's your status?
}
/*ライデン、どうだ？*/
ライデン_001: {
Colonel? I've got Emma Emmerich
here... we've managed to avoid
drowning.
}
/*大佐、エマ・エメリッヒを救出……
なんとか溺死するのだけは免れた。*/
大佐_002: {
Good job. Get her over to
Shell 1 as soon as you can.
}
/*よし、
彼女をシェル１まで連れて行くんだ。*/
ライデン_003: {
That's going to be hard with the
connecting bridge on the upper
level destroyed.
}
/*シェル１への上部連絡橋は
破壊されている。*/
大佐_004: {
Didn't Olga say something about
taking the oil fence at the bottom
of Strut L?
}
/*確かオルガが言っていたな。
Ｌ脚下部のオイルフェンスを通って、
と……。*/
ライデン_005: {
Yeah, I remember that.
}
/*ああ、覚えている。*/
大佐_006: {
You should be able to go down
by way of Strut L. Try and get
over there.
}
/*Ｌ脚から下へ降りられるはずだ。
Ｌ脚に向かえ。*/
ライデン_007: {
What about Emma?
She's been injected with something
and she can't walk without any help.
}
/*エマはどうする？薬物の影響らしいが、
一人で歩くのは無理のようだ。*/
大佐_008: {
Take her with you... free your hands
of any equipment and hold down the
Action button to give her a hand.
}
/*彼女を引っ張っていくしかない。
素手の状態で＃｛△、アクション｝＃ボタンを押している間、
手をつなぐ。*/
}
//d

//……子画面にエマを連れて進む映像（ＶＲ）……
resource P059_03_R01_エマ休憩３無線機デモ１＿２__e {
//vc115902
大佐_000: {
To release your grip on her, take
your finger off the Action button.
}
//<ページ数変更>
大佐_000_1: {
Emma can sit and wait until
you help her back up.
}
/*手を離したい時は＃｛△、アクション｝＃ボタンを離すんだ。
手を離すとエマはその場に座り込む。
彼女の手を引っ張ってＬ脚まで行くんだ。*/
大佐_001: {
And be careful... you won't be able
to use any weapons while you're
leading her.
}
大佐_002: {
Now, head for Strut L!
}
//<ページ数変更> 包含
/*だがいいか、彼女の手を引いている間、
武器は使えないぞ。*/
ライデン_004: {
We're on our way.
}
/*わかった。*/
}
//d




resource P061_01_R01_エマとオタコン１無線機デモ１＿１__e {
//Vc116101.aif
プリスキン_000: {
Raiden, we've infiltrated the
Computer Room. What's your
situation?
}
/*ライデン、電算室に侵入した。
どうだ？*/
ライデン_001: {
Emma's safe.
We're heading your way.
}
/*エマは無事だ。
これからそっちへ向かう。*/
オタコン_002: {
Good job!
}
/*よかった……。*/
プリスキン_003: {
Shell 1's deserted. Looks like
everybody's aboard Arsenal.
}
/*シェル１には誰もいない。
皆アーセナルに乗り込んだようだ。*/
オタコン_004: {
I had a look at the system, but
there's nothing I can do. E.E.'s
our only hope...
}
/*いろいろやってみたけどやっぱり
僕じゃ手が出せない。ＥＥでなきゃ……。*/
ライデン_005: {
Right... I'll put her on then.
}
/*それじゃ、エマに変わる。*/
オタコン_006: {
Huh? E.E.? How...?
}
/*えっ、ＥＥに……。*/
ライデン_007: {
I'll use my Codec as a relay.
}
/*俺の体内通信を中継する。*/
オタコン_008: {
Ahem, ummm...
}
/*あ、あ……。*/
ライデン_009: {
Here she is...
}
/*代わるぞ？*/
エマ_010: {
Uh... Hal...?
}
/*……お兄ちゃん？*/
//無線機画面、ライデンの変わりにオタコンが表示される。オタコンを動かすことはできるが、相づちはうてないようにする。
}
//d

resource P061_01_R01_エマとオタコン１無線機デモ１＿２__e {
//vcxxxxxxxxx
オタコン_000: {
Ah... E.E.? Is that you?
}
/*ＥＥかい？*/
エマ_001: {
Hal...
}
/*お兄ちゃん……。*/
オタコン_002: {
E.E....
}
/*ＥＥ……。*/
オタコン_003: {
Uh... why're you involved
with Metal Gear?
}
/*ＥＥ、なぜメタルギアなんかに手を？*/
エマ_004: {
Huh???
}
/*えっ？？*/
オタコン_005: {
You knew our family's dark history,
and still got involved!? What's
wrong with you!?
}
/*僕たちの呪われた家系を知っているだろ？
どうしてなんだ？*/
エマ_006: {
I should've known...
}
/*……やっぱり。*/
オタコン_007: {
Answer me! Why are you
repeating the same mistake?
}
/*どうしてだ？
どうして同じ過ちを繰り返す？*/
エマ_008: {
...
}
/*……。*/
エマ_009: {
I wanted to hurt you...
I wanted to see you suffer...
}
/*あなたに会って、
あなたを苦しめたかったから……。*/
オタコン_010: {
E.E....?
}
/*ＥＥ？*/
エマ_011: {
You abandoned me --
}
/*あなたは私を捨てた……。*/
オタコン_012: {
No!
That's not what happened...
}
/*違う。そうじゃない。*/
プリスキン_013: {
Alright -- that's enough!
}
/*二人とも、やめるんだ。*/
オタコン_014: {
...
}
/*……。*/
エマ_015: {
Who are you?
}
/*誰？*/
プリスキン_016: {
I'm a friend of Otacon's, Emma.
}
/*エマ、俺はオタコンの友人だ。*/
エマ_017: {
Otacon...
}
/*オタコン……。*/
プリスキン_018: {
Enough with the sibling rivalry.
}
/*兄妹喧嘩なら、後でしろ。*/
エマ_019: {
That's not what this is!!
}
/*兄妹喧嘩じゃないわ！*/
プリスキン_020: {
We haven't got time for this!
Raiden! Get her over here,
right now.
}
/*一刻を争うんだ！
ライデンとこっちに来てくれ。*/
エマ_021: {
I -- I...
}
/*う、うん。*/
ライデン_022: {
Gotcha, Snake. I'll head
over there with Emma.
}
/*わかった、スネーク。
エマを連れて行く。
*/
プリスキン_023: {
Most of the enemy's aboard
Arsenal. But I suggest you
be careful.
}
//<ページ数変更>
プリスキン_023_1: {
Make sure Emma gets
here in one piece.
}
/*奴ら、ほとんどアーセナルに乗り込んで
いると思うが気をつけろ。
エマに怪我をさせるな。*/
オタコン_024: {
Raiden... take care of my sister.
}
/*ライデン……頼む……。*/
ライデン_025: {
Don't worry.
I'll get her there.
}
/*わかった。まかせてくれ。*/
}
//d



resource P062_03_R01_エマとＡＩ３無線機デモ１＿１__e {
//vc116201
ライデン_000: {
Are you reading me, Emma?
}
/*エマ、いいかい？*/
エマ_001: {
Yes -- loud and clear.
}
/*ええ、大丈夫……。*/
ライデン_002: {
The President said that Arsenal
Gear was the Patriots' key to
supremacy.
}
/*大統領は『Ｇ．Ｗ』とアーセナルギアが
『愛国者達』の切り札だと言った。*/
エマ_003: {
That's as good a description as any.
}
/*そうね。
そういえるかも。*/
ライデン_004: {
What exactly is it?
}
/*一体、どういうものなんだ？*/
エマ_005: {
It's a massive data processing
system capable of controlling
information on a global scale.
}
/*世界規模の情報統制を行なうための
超大規模情報処理システム。*/
ライデン_006: {
A data processing system...?
}
/*情報処理システム？*/
エマ_007: {
That's right. The system's a
social device for maintaining
the Patriots' control.
}
/*ええ。『愛国者達』が支配を
継続していくための社会装置……。*/
ライデン_008: {
You've lost me.
}
/*なんだそれは？*/
エマ_009: {
In this day and age, information
emerges from every direction,
and is freely distributed...
}
/*現代ではあらゆるところから情報が
生まれて、流通する……。*/
エマ_010: {
A variety of information - gathered
by servers employing the latest in
high-speed communication networks
}
//<ページ数変更>
エマ_010_1: {
and P2P technology - is rapidly
circulated to individuals.
}
/*高速通信網の整備とＰ２Ｐ技術の発達で
サーバに集約されていた情報が個人に
分散されるようになって、*/
エマ_011: {
In fact, the speed of this circulation
process is accelerating on an almost
daily basis.
}
/*その流れはますます加速してるの。*/
エマ_012: {
The Patriots seem to be
afraid of this development.
}
/*彼等はそれに強い危機感を
持ってるみたい。*/
エマ_013: {
Apparently, they believe that their
role will shift from dominant to
dominated.
}
/*近いうちに支配する側が支配される側に
取り込まれてしまうんじゃないかって、
ね。*/
ライデン_014: {
?
}
/*？*/
エマ_015: {
Let me give you an example. You're
aware of Solid Snake's anti-Metal
Gear activities, aren't you?
}
/*例えばあなたはソリッド・スネークの
反メタルギア活動を知っているでしょう？*/
ライデン_016: {
Yeah -- I know a little about it.
}
/*ああ……少しは。*/
エマ_017: {
That's just a small sample of
uncontrolled information.
}
//<ページ数変更>
エマ_017_1: {
I can guarantee you the Patriots
did not want Solid Snake's name
publicized.
}
/*それが一番の証拠。ソリッド・スネーク
の名は『愛国者達』にとって最も
口外されてはいけないものなの。
*/
エマ_018: {
Now, look at it like this...
political scandal, corporate
corruption...
}
/*それは一例に過ぎない。政治家の醜聞、
企業の不正……*/
エマ_019: {
up until now, the Patriots have
managed to keep a lid on these
and other self-serving events.
}
/*今までなら『愛国者達』の力で隠されていた事実が簡単に暴かれてしまう。*/
エマ_020: {
But with their existing data
processing system, they are
no longer able to effectively＃－
}
//<ページ数変更>
エマ_020_1: {
control the flow of information
generated at the individual level.
}
/*現行のシステムでは個人から発信される
情報を抑えきることは出来ないの。
*/
エマ_021: {
With the newly created system,
they can fully regulate digital
information.
}
/*だから新しいシステムで、
デジタル化された全ての情報統制を行う。*/
エマ_022: {
High-level information can be
categorized in stages, given
clearance levels,
}
//<ページ数変更>
エマ_022_1: {
and deleted as necessary --
never to be seen by the public.
}
/*高度な情報は段階を経て、
クリアランスが付けられ、
一般公開から削除されていく。
*/
エマ_023: {
By deleting such information, the
Patriots can shape the course of
history as they see fit.
}
/*これが動き出せば、数年で様々な情報は
歴史からいっせいに削除されることに
なる……。*/
ライデン_024: {
Somebody's bound to catch on --
}
/*誰かが気づくはずだ。*/
エマ_025: {
No. The memory capacity --
not to mention the life span --
}
//<ページ数変更>
エマ_025_1: {
of the average individual
is extremely limited.
}
/*いいえ、人の記憶容量は極めて小さい。
人の寿命も短い。
*/
エマ_026: {
On the other hand, digital
information lasts virtually
forever...
}
//<ページ数変更>
エマ_026_1: {
it doesn't deteriorate.
}
/*永遠に残るのはデジタル化されたもの
だけ。劣化しないから。
*/
ライデン_027: {
So...?
}
/*ばかな……。*/
エマ_028: {
The alphabet... twenty-six letters,
right? It could've been thirty letters.
}
/*例えばアルファベットは２６文字だと
思われている。でも本来は３０文字
だったかもしれない。
*/
エマ_029: {
What if the 4 deleted letters
were controlled by a program?
}
/*その削除された４文字をプログラムで
統制しているとしたら……。
*/
ライデン_030: {
Impossible.
}
/*ありえない。*/
エマ_031: {
It's not. In fact, something
similar is already underway.
}
//<ページ数変更>
エマ_031_1: {
Do you know how many genes
exist in an individual?
}
/*いいえ。それは既に行われつつある。
じゃあ、人の遺伝子数はいくつか
知ってる？
*/
ライデン_032: {
About 30 to 40 thousand?
}
/*３万から４万個？*/
エマ_033: {
Right. That's what was announced
at the turn of the century.
}
//<ページ数変更>
エマ_033_1: {
But there's actually 100 thousand,
according to the original theory＃－
}
//<ページ数変更>
エマ_033_2: {
advanced by the scientific
community.
}
/*ええ。今世紀の初めにそう発表された。
でも本当は、それ以前の学説通りの
１０万個なの。
*/
エマ_034: {
Information regarding the
remaining 60 thousand was
suppressed by the Patriots.
}
/*残りの６万個が『愛国者達』に
情報統制されている……。*/
ライデン_035: {
No...
}
/*嘘だ！*/
エマ_036: {
Why? How would you know?
}
/*それが嘘だと、どうしてあなたに
分かるの？*/
エマ_037: {
Do you know what a gene looks like?
Did you count them yourself?
}
/*遺伝子がどんなものか、
あなたは本当に知ってるの？*/
ライデン_038: {
There are research organizations...
}
/*……研究機関なら……。*/
エマ_039: {
Of course... and their reports have
already been subtly altered.
}
//<ページ数変更>
エマ_039_1: {
They're even beginning to
believe the doctored reports.
}
/*勿論、研究論文もすべて情報改竄されて
るわ。そしてそのうち自分が間違いで
あったと錯覚する。
*/
エマ_040: {
GW is a system that allows the
Patriots to decide what will be
recorded in tomorrow's history.
}
/*『Ｇ．Ｗ』は人の歴史を後世に
どう残すか、それを『愛国者達』が
決めるためのシステム……。*/
ライデン_041: {
So what we're talking about is
one huge censorship system for
deleting information＃－
}
//<ページ数変更>
ライデン_041_1: {
which might be inconvenient
to the Patriots?
}
/*つまり『愛国者達』に都合の悪い情報を
削除する大掛かりな検閲装置という
ことか？
*/
エマ_042: {
Exactly. The actual, physical core
for handling the task -- GW -- is
installed in Arsenal.
}
/*ええ。それを行う中枢システムの物理的
実体がアーセナルの中にあるの。*/
エマ_043: {
It's the only system in the world
with an optic neural AI＃－
}
/*『Ｇ．Ｗ』。
*/
エマ_044: {
that has a parallel processing
capacity of 980 trillion hammets.
}
/*世界に一つしかない９８０兆ハメットの
複雑さを持つ光ニューロＡＩ……。*/
ライデン_045: {
I suppose that being a specialist
in neural AI and complex logic＃－
}
//<ページ数変更>
ライデン_045_1: {
played a significant role
in your association with
the Metal Gear project.
}
/*それが理由か？ニューロＡＩと
複雑性理論の専門家の君が
メタルギア開発に関わっていたのは……。
*/
エマ_046: {
That's not the only reason...
}
/*それだけじゃないけどね……。*/
ライデン_047: {
What do you mean?
}
/*え？*/
エマ_048: {
...
}
/*……。*/
ライデン_049: {
I guess there're plenty
of other reasons.
}
/*……まぁ、きっと事情があるんだろうな。*/
エマ_050: {
Yes, there are --
}
/*うん……。*/
ライデン_051: {
I understand...
}
/*わかるよ。*/
エマ_052: {
Do you?
}
/*……そう……？*/
ライデン_053: {
So Arsenal Gear was actually
designed to protect the GW
system, wasn't it?
}
/*ではアーセナルギアは『Ｇ．Ｗ』を
守るために建造された？*/
エマ_054: {
Uh...yes. It's armed with
everything including nuclear
weapons,
}
//<ページ数変更>
エマ_054_1: {
and is fully equipped with
cyber-terrorist countermeasures.
}
/*……ええ。核兵器を含めた最高の武装を持ち、サイバーテロ対策も完璧。
物理的にも論理的にも史上最強の要塞。
*/
エマ_056: {
Physically and logically,
it's the ultimate fortress
for housing GW.
}
/*『Ｇ．Ｗ』の器。*/
ライデン_057: {
But is the AI actually capable
of controlling everything?
}
/*だが、そのＡＩだけで全てを制御出来る
とは思えないが。*/
エマ_058: {
No. GW is only the system's core.
It's only for deciding what data
is stored or deleted.
}
/*ええ。『Ｇ．Ｗ』はあくまでも
システムの中枢。何を残すか、
何を削除するかを判断するためのね。*/
エマ_059: {
The actual sub-system for
executing the task exists
within our social structure...
}
/*それを実行するサブシステムは
既に社会に埋め込まれている……。*/
ライデン_060: {
What!?
}
/*どういうことだ？*/
}
//d


resource P062_05_R02_エマとＡＩ５無線機デモ２＿１__e {
//vc116211
ライデン_000: {
Let me guess... the Y2K
countermeasure contained a program
designed by the Patriots?
}
/*その中に『愛国者達』のプログラムが
仕込まれていたと？*/
エマ_001: {
Yes. And everything supplied from
that day onward contains the same
program.
}
/*ええ。
勿論、それ以降に作られたものには
初めからそのシステムが組み込んである。*/
ライデン_002: {
Impossible.
}
/*そんな馬鹿な……。*/
エマ_003: {
Do you know how
a computer operates?
}
/*どうしてそう言えるの？コンピュータが
どうやって動作しているのか、あなたは
知ってるの？
*/
エマ_004: {
Do you really know the basic
principles on how data is
exchanged?
}
/*この通信がどういう原理なのかだって
本当は分かってないでしょ？
*/
ライデン_005: {
...
}
/*……。*/
エマ_006: {
Nobody's aware of it, but
there's a sub-system in place.
And it's about to be activated.
}
/*誰も知らないけど、そのシステムは
実在する。そしてそれらはもうすぐ
一斉に動き出す……。*/
ライデン_007: {
Is that why Solidus wants to burn
out every electrical circuit in
Manhattan with a nuclear blast?
}
/*ソリダスが核爆発でマンハッタン全ての
電子回路を焼き切ろうとしているのは
そのため……？*/
エマ_008: {
Probably.
But the overall system
isn't actually complete.
}
/*そうかもね。
でもシステムはまだ完成してるわけ
じゃない。*/
ライデン_009: {
What?
}
/*え？*/
エマ_010: {
It still lacks the necessary
factors for judging situations.
}
/*状況を判断するための＃｛因子、ファクター｝＃が
不足してるの。*/
エマ_011: {
I heard they were planning a major
experiment in the next few days,
}
//<ページ数変更>
エマ_011_1: {
to provide complex data
for GW to study.
}
/*その複雑さを『Ｇ．Ｗ』に学習させる
ために大規模な実験を近日中に
行うって話は聞いていたんだけど……。
*/
エマ_012: {
And suddenly all this happens...
}
/*突然、こんなことが起こって……。*/
ライデン_013: {
Emma... it's not your fault.
If it wasn't for the terrorists...
}
/*……エマ、これはテロだ。
君が悪いんじゃない……。*/
エマ_014: {
Yeah... you're right...
}
/*……うん……そうね……。*/
エマ_015: {
Well... I think that's
about all I know.
}
/*うん。
……とりあえず私が知ってるのは
これくらい、かな。*/
ライデン_016: {
Right... uh, thanks. I think
we'd better head for the
Computer Room.
}
/*そうか……ありがとう。
じゃあ電算室へ急ごうか？*/
エマ_017: {
My bird in the Computer
Room! Is he safe!?
}
/*鳥は無事？
電算室にいた……。*/
}
//d




resource P064_01_R01_エマライデンローズ無線１無線機デモ１＿１__e {
//vc116401
ローズ_000: {
Well, Jack. It sounds like you
and Miss Emma are getting
along just fine.
}
/*ジャック、エマさんと仲がいいようね。*/
ライデン_001: {
Rose?
}
/*ローズ、何を言っている？*/
ローズ_002: {
I've been monitoring your
every move and conversation.
I can't say it's been fun...
}
/*私、あなたの行動や会話を全部モニター
してるのよ。あまりいい気はしないわ。*/
ライデン_003: {
Give me a break! I'm only
trying to keep her spirits up.
}
/*誤解するな。
俺はエマを勇気づけてるだけだ。*/
ローズ_004: {
Is that right?
}
/*そうなの、ジャック？*/
ライデン_005: {
Absolutely. My mission is to get
her to the Computer Room.
}
/*ああ。
彼女を電算室まで連れて行くのが任務だ。*/
ローズ_006: {
That's all?
}
/*それだけ？*/
ライデン_007: {
Yeah.
}
/*……ああ。*/
ローズ_008: {
You're lying.
You're attracted
to her, aren't you.
}
/*嘘っ、ちょっとはいいと思ってる？*/
ライデン_009: {
...I'll admit she's cute.
}
/*ああ、エマはかわいい娘だ。*/
ローズ_010: {
Cuter than me?
}
/*私より？*/
ライデン_011: {
Rose, you're beautiful.
You know how I feel about
you.
}
/*ローズ、君は素敵だ。
俺の気持ちに代わりはない。*/
ローズ_012: {
Have you remembered yet?
}
/*じゃあ、思い出した？*/
ライデン_013: {
You mean April 30th?
}
/*４月３０日のこと？*/
ローズ_014: {
Yes.
}
/*そう。*/
ライデン_015: {
It's your birthday, isn't it.
}
/*君の誕生日？*/
ローズ_016: {
Wrong!
You're not even warm!
}
/*ブブー！
外れ！
大外れ！*/
ライデン_017: {
What is it then?
}
/*意地悪だな。*/
ローズ_018: {
Forget it... it's nothing.
Maybe I'm just a little...
a little jealous...
}
/*……ごめんなさい。ちょっとした冗談、
なんだか、いいムードだったから……
ちょっとやけちゃったかな……。*/
ライデン_019: {
Rose?
}
/*ローズ？*/
ローズ_020: {
You'd better get moving.
Good luck.
}
/*じゃあね、がんばって。*/
}
//d




resource P065_02_R01_エマＬ脚２無線機デモ１＿１__e {
//vc116501
ライデン_000: {
I have a question for you.
}
/*……聞いていいか？*/
エマ_001: {
What is it?
}
/*なに？*/
ライデン_002: {
How do you feel about heights?
}
/*高いところは苦手か？*/
エマ_003: {
I can't say I like heights...
though water's higher on
my phobia list. Why?
}
/*嫌い。
水の中よりはマシだけど……
どうしてそんなこと聞くの？*/
ライデン_004: {
Well... we have to
go down a ladder.
}
/*これからハシゴで下に降りる。*/
エマ_005: {
How far down?
}
/*どれくらい？*/
ライデン_006: {
Just a little bit...
}
/*ほんの少しだ。*/
エマ_007: {
Why do I feel like we've had
this conversation before?
How little is little?
}
/*さっきも『ほんの少し』って聞いたけど？*/
ライデン_008: {
...About 130 feet?
}
/*……４０メートル……くらいかな。*/
エマ_009: {
...
}
/*……。*/
ライデン_010: {
Think you can do it?
}
/*いけるか？*/
エマ_011: {
Would you take "no"
for an answer?
}
/*ダメって言っても連れてくんでしょ。*/
ライデン_012: {
How are your legs?
}
/*足の具合は？*/
エマ_013: {
Better.
The numbness is gone.
}
/*大丈夫。だいぶシビレがとれてきた。*/
エマ_014: {
I can climb down on my own.
}
/*一人で歩けるわ。*/
ライデン_015: {
Okay... follow me.
}
/*よし、俺の後についてくるんだ。*/
}
//d




resource P065_06_R02_Ｌ脚エマ６無線機デモ２＿１__e {
//Vc116511
ライデン_000: {
This is Raiden, do you read me?
}
/*こちらライデン、聞こえるか？*/
プリスキン_001: {
Yeah. What's up?
}
/*ああ、どうした？*/
ライデン_002: {
We've made it to the lower part
of Strut L. We'll have to cross
the water from here.
}
/*Ｌ脚下部に到着した。
今から海面を渡るところだ。*/
プリスキン_003: {
Can Emma walk?
}
/*エマは歩けそうか？*/
ライデン_004: {
She's okay. The pontoon bridge
doesn't look too sturdy. Emma is
going to have to cross it alone.
}
/*彼女なら大丈夫だが。
浮き橋はかなり脆そうだ。
エマひとりしか渡れそうもない。*/
プリスキン_005: {
Right... the oil fence --
}
/*オイルフェンスだからな。*/
}
//d
//小画面に双眼鏡モードの映像がでる。浮き橋をパンすると、敵兵、サイファーが見える
resource P065_06_R02_Ｌ脚エマ６無線機デモ２＿２__e {
//vc116512
ライデン_000: {
There's Cyphers and
several guards.
}
/*サイファーと見張りが数人いる。*/
プリスキン_001: {
Raiden, you're carrying
a PSG1, aren't you?
}
/*ライデン、ＰＳＧ１を持ってるだろう？*/
ライデン_002: {
Yeah.
}
/*ああ。*/
プリスキン_003: {
It's time to play sniper.
}
/*そこから狙撃するんだ。*/
}
//d
resource P065_06_R02_Ｌ脚エマ６無線機デモ２＿３__e {
//vc116513
ライデン_000: {
Not bad. This spot gives me
a good view of the targets.
}
/*なるほど、
ここは狙撃ポイントに最適だな。*/
プリスキン_001: {
You're going to have to
cover Emma until she
crosses to Strut E.
}
//<ページ数変更>
プリスキン_001_1: {
I'll get there and provide
some support of my own.
}
/*エマがＥ脚まで渡り切るのを
サポートするんだ。俺もＥ脚まで
行って援護する。
*/
ライデン_002: {
Thanks.
}
/*それはありがたい。*/
プリスキン_003: {
Think you can handle it?
}
/*狙撃の腕に自信は？*/
ライデン_004: {
Yeah. I know the drill.
}
/*大丈夫だ、このシチュエーション。*/
ライデン_005: {
I've faced a similar situation
in Advanced Mode Level 4 VR
training with the PSG1.
}
/*ＶＲ訓練で経験済みだ。
アドバンスドモードのＰＳＧ１、
ＬＥＶＥＬ４……。*/
プリスキン_006: {
VR...? Guess that's better
than nothing. Make sure you
don't hit Emma.
}
/*またＶＲか。
いいか、彼女を傷つけるんじゃないぞ。*/
プリスキン_007: {
Right now, with Arsenal's boarding
in progress, security should be at
a minimum.
}
//<ページ数変更>
プリスキン_007_1: {
That doesn't mean it's
going to be easy.
}
/*既にアーセナルへの待避が始まっている。
敵兵は最低限しか残されていない
だろうが、気を抜くな。
*/
プリスキン_008: {
Given the situation, they've
probably got Claymores in place to
make up for the security shortage.
}
/*地形から考えて、人数をカバーする
ためにクレイモアをしかけている
可能性が高い。
*/
プリスキン_009: {
Make sure you use
your thermal goggles.
}
/*＃｛赤外線、サーマル｝＃ゴーグルでよく調べてみろ。*/
ライデン_010: {
Right.
}
/*わかった。*/
プリスキン_011: {
Okay.
I'm heading for Strut E.
}
/*今から、Ｅ脚へ向かう。*/
}
//d
//←
resource P065_06_R02_Ｌ脚エマ６無線機デモ２＿４__e {
//vc116514
ライデン_000: {
Emma, are you reading me?
}
/*エマ、聞こえるか？*/
エマ_001: {
Loud and clear...
}
/*ええ……。*/
ライデン_002: {
I'm gonna clear a path
for you from here.
}
/*俺がここから君の進路を切り開く。*/
エマ_003: {
How?
}
/*どうやって？*/
ライデン_004: {
Sniper fire.
}
/*狙撃だ。*/
エマ_005: {
You're kidding...
}
/*私に当たるんじゃ？*/
ライデン_006: {
Trust me.
}
/*俺を信じろ。*/
エマ_007: {
What if I fall into the sea?
I... I can't swim!
}
/*私、泳げない。
海に落ちたら？*/
ライデン_008: {
You were doing pretty good
a few minutes ago.
}
/*もう泳げる。
いや、さっきは泳げた。*/
エマ_009: {
Okay.
}
/*わかった。*/
ライデン_010: {
Think you can do it?
}
/*準備はいいか？*/
エマ_011: {
Would you take "no"
for an answer?
}
/*よくなくても。*/
/* はもりりん
ライデン_000: {
No.
}
//行ってもらう。
*/
エマ_012: {
No.
}
/*行ってもらう。*/
ライデン_013: {
Alright, get going.
You'll be fine.
}
/*さあ、行くんだ。
君ならきっと出来る。*/
}
//d




resource P067_01_R01_エマ狙撃１無線機デモ１＿１__e {
//vc116701
プリスキン_000: {
This is Snake.
Can you hear me?
}
/*こちらスネーク、聞こえるか？*/
ライデン_001: {
Yeah. Nice and clear.
}
/*ああ、聞こえる。*/
プリスキン_002: {
I've reached my sniping position
on Strut E. I'll provide support
fire from here.
}
/*Ｅ脚の狙撃ポイントに到着した。
ここからサポートする。*/
ライデン_003: {
Right. Do me a favor and
take out whatever I miss.
}
/*わかった、
こっちが撃ち逃した場合は頼む。*/
プリスキン_004: {
Just call me when you
want me to shoot.
}
/*俺に狙撃を任せたくなったら、
無線連絡をくれ。*/
}
//d



resource P069_02_R01_ヴァンプ狙撃終了２無線機デモ１＿１__e {
//vc116901
プリスキン_000: {
Raiden!
Emma's been stabbed!
}
/*ライデン！
エマが刺された！*/
ライデン_001: {
That bastard!
}
/*なんてこった！！*/
オタコン_002: {
How bad is it!?
}
/*傷はどうなんだ！*/
プリスキン_003: {
She's conscious... but the
bleeding's bad. I'm bringing
her over there right now!
}
/*意識はしっかりしてるが……
出血がひどい。すぐそっちに運ぶ。*/
オタコン_004: {
E.E....
}
/*ＥＥ……。*/
プリスキン_005: {
Raiden! Get that disc over
here as soon as possible.
}
/*ライデン、ディスクを持って
早くきてくれ。
*/
プリスキン_006: {
I'm afraid her time's
running out...
}
/*時間が、もうないかもしれん……。*/
ライデン_007: {
I'll be there!
}
/*わかった。*/
}
//d



resource P069_04_R02_ヴァンプ狙撃終了４無線機デモ２＿１__e {
//Vc116911
ライデン_000: {
Snake, what's your
situation over there?
}
/*スネーク、そっちの状況は？*/
プリスキン_001: {
Emma seems to be uh... doing
something to GW's defensive
capabilities.
}
//<ページ数変更>
プリスキン_001_1: {
All we need now is your disc.
}
/*エマが『Ｇ．Ｗ』の自己防衛機能を
一時無効化してくれたらしい。
あとはお前のディスク待ちだ。
*/
プリスキン_002: {
You'd better hurry --
I don't think she's gonna make it.
}
/*急いでくれ。
エマの体力が……持ちそうもない。*/
ライデン_003: {
How's the bleeding?
}
/*出血がひどいのか？*/
プリスキン_004: {
She's...
}
/*ああ……。*/
プリスキン_005: {
Just get over here. You'll find the
coast is clear with everybody
aboard Arsenal right now.
}
/*早く来るんだ。敵の心配はいらない。
奴ら、アーセナルに乗り込んだようだ。
もう誰も残っていないはず。*/
ライデン_006: {
Understood.
}
/*わかった。*/
}
//d



resource P070_10_R01_ＡＧ起動１０無線機デモ１＿１__e {
//vc117001
ローズ_000: {
Jack? Are you reading me?
}
//<ページ数変更>
ローズ_000_1: {
Do you want to save your mission
data up to this point?
}
/*ジャック？聞こえてるわよね？
これまでの潜入データを＃｛記録、セーブ｝＃する？
*/
}
//d

resource P070_10_R01_ＡＧ起動１０無線機デモ１＿２__e {
//Vc117002
ローズ_000: {
Your mission data's been saved.
}
/*潜入データを＃｛記録、セーブ｝＃したわ……。*/
}
//d



resource P070_18_R02_ＡＧ起動１８無線機デモ２＿１__e {
//vc117011
ライデン_000: {
Mister X...?
Ninja...?
}
/*ミスターＸも忍者も……。*/
オルガ_001: {
Correct... it's me.
}
/*そう、私。*/
ライデン_002: {
I thought you were the leader
of the Russian troops...
}
/*君はロシア兵のリーダー
じゃなかったのか？*/
オルガ_003: {
No. That was just
a smoke screen.
}
/*……いいえ。
それは表向きの役割……。*/
ライデン_004: {
A smoke screen?
}
/*表向き？*/
オルガ_005: {
I was sent to provide
you support.
}
/*ええ……
本当の役割はあなたのサポート……。*/
ライデン_006: {
Support? Who sent you?
The Colonel?
}
/*俺のサポート？
誰の命令で？
大佐か？*/
オルガ_007: {
No... the Patriots.
}
/*いいえ……『愛国者達』。*/
ライデン_008: {
What!?
}
/*なんだって！？*/
オルガ_009: {
I... I deceived my troops...
betrayed them...
}
/*私は……部隊の皆を騙し、裏切っている。*/
ライデン_010: {
But why?
}
/*どういうことなんだ……？*/
オルガ_011: {
My child is... being held
hostage by the Patriots.
}
/*……子供が……
『愛国者達』に捕らわれているの……。*/
オルガ_012: {
It all started two years ago when
I lost my father during the tanker
incident...
}
/*二年前、あのタンカーと一緒に父を
失った後……。*/
オルガ_013: {
My men and I had nowhere to go...
so we joined forces with an illegal
Russian organization.
}
/*行くところのない私達はロシアと
つながりのある非合法組織に拾われた。*/
ライデン_014: {
The Russian Mafia?
}
/*マフィア？*/
オルガ_015: {
Something like that.
}
//<ページ数変更>
オルガ_015_1: {
Actually, I learned much later that
it was a subordinate organization
of the Patriots.
}
/*そう呼んでも良い。
だけどそこが『愛国者達』の下部組織
だと知ったのはずっと後のことだった。
*/
オルガ_016: {
I was expecting at the time.
}
//<ページ数変更>
オルガ_016_1: {
When I gave birth to my child,
it turned out I was in a hospital
run by the Patriots.
}
/*身重だった私は、何も知らずに奴等の
病院で子供を生んだ。
*/
オルガ_017: {
In the morning... my child was gone.
My baby is being kept somewhere in
this country.
}
/*目が覚めた時はもう……あの子は奴等に
奪われていた。今もこの国の何処かで
暮らしている。*/
ライデン_018: {
Have you ever met your child?
}
/*会った事は？*/
オルガ_019: {
No. Once a month, they send me
a photo of my child via network.
}
//<ページ数変更>
オルガ_019_1: {
I've never even held the
child in my own arms...
}
/*ないわ。月に一度、ネッワーク経由で
映像が送られてくる。私はまだあの子を
この手に抱いたことはない。
*/
ライデン_020: {
I see...
}
/*……そうか……。*/
ライデン_021: {
Given your situation, nobody can
blame you for what you did.
}
/*そういう事情なら……仕方ないさ。
誰も君を責められない……。*/
オルガ_022: {
That's your opinion...
}
/*……そうかしら……。*/
ライデン_023: {
What about Snake?
I thought you were
enemies...
}
/*……スネークとは？
彼とは敵対していたんじゃ？*/
オルガ_024: {
He wasn't responsible for
my father's death. Actually,
we owe him our lives.
}
/*彼等は父の仇じゃなかった……
命の恩人だったのよ。*/
}
//d



resource P070_20_R03_ＡＧ起動２０無線機デモ３＿１__e {
//Vc117021
ライデン_000: {
So you joined hands with him
to pay back a debt?
}
/*手を組んだのは恩返しってわけか？*/
オルガ_001: {
No. Mutual gain...
}
/*いいえ。
相互利益のための協力ってところね。*/
ライデン_002: {
Mutual gain?
}
/*利益？*/
オルガ_003: {
My job was to assist you.
}
/*あなたをサポートすること。
それが私に課せられた役割。*/
オルガ_004: {
If Solidus gets away with Arsenal,
your mission is a failure.
}
/*ソリダスがアーセナルを手に入れれば
あなたの任務も失敗。私も役割を果たせ
なかったと見なされる。
*/
オルガ_005: {
The Patriots would judge that as
failure on my part and terminate
my child.
}
//<ページ数変更>
オルガ_005_1: {
Putting it simply, my child's
life depends on your success.
}
/*……『愛国者達』はあの子を殺すわ。
だからあなた達を助けることがあの子を
助けることになる……。*/
ライデン_006: {
So you did it all for your child.
}
//<ページ数変更>
ライデン_006_1: {
But why would the Patriots want to
help me? Are they hoping I'll take
Solidus out?
}
/*全ては子供のため、か……
だがなぜ『愛国者達』が俺を助けようと
する？ソリダスを倒すためか？
*/
オルガ_007: {
No. You're just like me...
we're just pawns...
}
/*いいえ……あなたも私と同じ。
骨の髄まで利用されている……。*/
ライデン_008: {
Pawns for what purpose?
}
/*何を言ってる？*/
オルガ_009: {
The S3 Plan...
}
/*Ｓ３計画……。*/
ライデン_010: {
Huh?
}
/*？*/
オルガ_011: {
You'll figure it out sooner or
later -- but I wonder if you'll
handle the truth?
}
/*いずれわかる……
その辛さを克服できるかどうか……。*/
ライデン_012: {
What do you mean?
}
/*どういうことだ？*/
オルガ_013: {
Listen... we haven't
got time for this.
}
//<ページ数変更>
オルガ_013_1: {
Solidus will commence his
attack any minute. He's got
to be stopped.
}
/*時間がない。
ソリダスは今にも攻撃を開始する。
奴を止めなければ……。
*/
ライデン_014: {
What about the virus?
}
/*ウィルスは？*/
オルガ_015: {
No results so far. I think the
Patriots have tampered with
the program.
}
/*まだ効果は現れてない。
やはり『愛国者達』が手を加えていた
ようね。*/
ライデン_016: {
Will it work?
}
/*効くのか？*/
オルガ_017: {
I don't know...
}
/*わからない……。*/
ライデン_018: {
Get me out of this thing.
}
/*これをはずしてくれ。*/
オルガ_019: {
Not yet. I'll release your
restraints after I leave
this room.
}
/*今はできない。
私がここを出てから拘束を解除する。*/
ライデン_020: {
Where's my gear?
}
/*俺の装備は？*/
オルガ_021: {
Snake's got everything.
I couldn't bring it here.
}
/*スネークに預けた。
ここでは渡せない。*/
ライデン_022: {
And where do I find Snake?
}
/*彼は何処に？*/
}
//d



resource P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e {
//Vc117031
ローズ_000: {
Jack, are you all right?
}
/*ジャック、大丈夫？*/
ライデン_001: {
Oh, y-yeah.
}
/*あ、ああ……。*/
ローズ_002: {
Jack, is it true?
What Solidus said?
}
/*ジャック、ソリダスの話。
本当なの？*/
ライデン_003: {
...Yes.
}
/*……本当だ。*/
ローズ_004: {
It's unbelievable...
}
//<ページ数変更>
ローズ_004_1: {
Drafting small children, sending
them to war -- it's not allowed
under international conventions.
}
/*信じられない。そんな事が……
子供を徴兵したり、戦闘グループに
参加させたりする事は禁られているはず。
*/
ライデン_005: {
ICC rules don't mean
a lot in war.
}
/*法律なんて、戦場での歯止めには
ならない。*/
ライデン_006: {
Someone told me that there are
over three hundred thousand
children in combat right now.
}
//<ページ数変更>
ライデン_006_1: {
I was just one of them...
}
/*今現在も、戦闘に参加している子供は
３０万人以上もいる。
俺もそのうちの一人だった……。
*/
ローズ_007: {
So you remember? I thought your
memory had been... manipulated
by them.
}
/*憶えてたの？
記憶を操作されていたんじゃ？*/
ライデン_008: {
It was -- but I have nightmares
every day, pieces of the past
I can't put together...
}
/*……いや。
毎晩、うなされていた……
過去の断片に……。*/
ローズ_009: {
Why didn't you tell me?
}
/*なぜ、今まで言ってくれなかったの？*/
ライデン_010: {
You couldn't begin
to understand.
}
/*君に理解できるはずがない。*/
ローズ_011: {
You wouldn't know
that until you try me.
}
/*そんなの、言ってくれなきゃ、
分からないじゃない？*/
ライデン_012: {
I didn't want you to get hurt.
}
/*君を苦しめたくなかったんだ。*/
ローズ_013: {
...
}
/*……。*/
ライデン_014: {
There was never a real
reason for me to fight,
}
//<ページ数変更>
ライデン_014_1: {
except that someone put
a gun in my hand. And
that someone was him...
}
/*俺には戦う理由などなかった。
物心ついた頃から、銃を握らされていた。
あいつだ、あの男に……。
*/
ローズ_015: {
It wasn't your fault.
}
/*でも、それは罪じゃない。*/
ライデン_016: {
If I survived the day's fight, I was
praised, fed, and had a bed to sleep
in.
}
/*１日を戦えば、ほめられた。
食事にありつけた。
屋根のある寝床で安眠する事ができた。*/
ライデン_017: {
I think I was only six when I held
my first AK, but I'm not even sure
of that.
}
/*最初に＃｛銃、ＡＫ｝＃を握らされた時は
まだ６歳だった。
いや、年齢も定かではない。*/
ローズ_018: {
Jack?
}
/*ジャック？*/
ライデン_019: {
I'm not like Snake, I never
questioned why we fought.
There was no purpose, no way out.
}
/*俺はスネークとは違う。
戦いに疑問など感じた事などなかった。
目的があったわけでもない。*/
ライデン_020: {
They give you a gun, you
ask how many to kill.
}
/*出口のないトンネルをただ、
銃を突きつけられて歩く事を
強いられていただけだ。*/
ライデン_021: {
If you didn't, you were
the one they shot instead.
}
/*銃を取らない奴は、みんな殺された。*/
ローズ_022: {
It's OK.
No one is blaming you.
}
/*あなたを責めるつもりはない……。*/
ライデン_023: {
We were shown Hollywood action
films every day. The kind with
macho guys and big guns.
}
/*毎日、ハリウッドのアクション映画を
見せられた。マッチョな男が銃を持って
戦う映画だ。*/
ライデン_024: {
They call it image training.
}
/*イメージトレーニングと言ってな。*/
/* 以下はカット。
ゲームもやらされた。
勿論、遊びじゃない。
*/
ローズ_025: {
...
}
/*……。*/
ライデン_026: {
They -- they built us from
the ground up, into killing
machines...
}
/*俺達は……造られた。
＃｛殺人、キリング｝＃マシーンとして。*/
ライデン_027: {
We were fed once a day. I can
still taste the gunpowder they
mixed into the food.
}
/*日に一度の食事にはガンパウダーが
混入されていた。*/
ローズ_028: {
Gunpowder? In the food?
}
/*ガンパウダー？
火薬の事？*/
ライデン_029: {
The gunpowder had toluene
in it, giving it hallucinogenic
properties.
}
//<ページ数変更>
ライデン_029_1: {
It kept us drugged,
controllable.
}
/*そうだ、ガンパウダーには幻覚作用を
もたらすトルエン成分が含まれている。
麻薬漬けにされたんだ。
*/
ローズ_030: {
Oh, my God...
}
/*そんな……。*/
ライデン_031: {
When the civil war ended, those
of us who survived were taken
in by NGO's.
}
//<ページ数変更>
ライデン_031_1: {
They gave me a new life in
the States. I can't complain.
}
/*内戦が終わって、生き残った俺達は、
保護された。それからはこの国で……
さすがに衣食住に困ることはなかった。
*/
ライデン_032: {
But nothing's changed.
}
//<ページ数変更>
ライデン_032_1: {
The only people who have no problem
with my past have secrets and
agendas of their own...
}
/*しかし、今も、何も変わっていない。
俺達の過去を黙認してくれるのは、
やはり闇の世界しかなかった。*/
ライデン_033: {
Terrible nightmares --
every night. I can never
forget...
}
/*毎晩、うなされる。
忘れることはできない。
*/
ローズ_034: {
Jack...
}
/*ジャック……。*/
ライデン_035: {
I'm afraid of the night. That's
why I don't sleep next to you.
}
/*夜が怖い。
だから、君の隣りでは眠れない。*/
ローズ_036: {
You should have told me...
}
/*言って欲しかった……。*/
ライデン_037: {
Told you what? That I'm a
killer and always have been?
}
/*何を？
俺が根っからの殺し屋だったって事か？*/
ローズ_038: {
No, no.
}
/*そうじゃないわ。*/
ライデン_039: {
What I hate more than anything
else in the world is my own past.
}
//<ページ数変更>
ライデン_039_1: {
I didn't want you
-- or anyone --
to know about it.
}
/*この世で一番憎むべきもの、
それは自分の過去だ。
誰にも知られたくはなかった。君にも。
*/
ローズ_040: {
...
}
/*……。*/
ライデン_041: {
Now I know why I was
chosen for this mission.
}
/*だが、俺がこのミッションに選ばれた
理由がようやくわかったよ。*/
ライデン_042: {
No one can take him on --
take him down -- except me.
}
/*あの男を倒すために……あの男を
倒すにはこの俺でなければならない。*/
ライデン_043: {
I've been kept alive this long
for this. I knew, as soon as
I saw Solidus.
}
/*この日のために俺は奴らに生かされて
いたんだ。ソリダスに会って分かった。*/
ローズ_044: {
Jack, I love you the way you are
now. You have to believe me.
}
/*ジャック、信じて。
私、今のあなたが好き。*/
ライデン_045: {
...
}
/*……。*/
ローズ_046: {
I didn't know anything
about you, I admit that.
}
/*私、確かに……
あなたの事、何も知らなかった。
*/
ローズ_047: {
Where you were born, how you
grew up -- but I know that now.
}
/*どこで生まれて、どう育ったか？
今日までね。
*/
ローズ_048: {
And I know that what I feel for you
can only get better, and I'll share
in your past if that's the price.
}
/*でも、これから……もっとあなたを
好きになる。あなたの過去も受け止める。*/
ライデン_049: {
It doesn't work that way. No one can
share the burden of what I've done.
}
//<ページ数変更>
ライデン_049_1: {
It's not one of those warm and
fuzzy things couples share.
}
/*無理だ。他人が俺の過去を背負うこと
なんかできっこない。俺には恋人達が
語り合うような、楽しい過去はない。
*/
ローズ_050: {
I accept the good and the bad, Jack.
That's what you do for someone you
love.
}
/*みんなそうなのよ。楽しい事ばかりじゃ
ない。辛いことや悲しい事を共有する
から……ジャック、信じて。*/
ライデン_051: {
I don't want to share my past with
anyone. I just want to forget about
it.
}
/*俺は、俺の過去を誰とも共有したくは
ない。ただ忘れたいんだ。*/
ローズ_052: {
Jack? I haven't told you -- you
know, about what I've done...
}
/*ジャック？
私もあなたに、自分の過去を……。*/
ローズ_053: {
...
}
/*……。*/
ライデン_054: {
The last two years with you --
it's been more than I've ever
hoped for.
}
/*ローズ、君と過ごした２年間は……
本当に楽しかった。*/
ローズ_055: {
Jack...
}
/*ジャック？*/
ライデン_056: {
But I can't go any farther.
}
/*でも、そこまでだ。
それ以上は踏み込めない。*/
ライデン_057: {
I know you want to get married.
}
/*君が俺のプロポーズを心待ちにしていた
ことは知っている。*/
ローズ_058: {
I --
}
/*それは。*/
ライデン_059: {
But --
}
/*でも……。*/
ライデン_060: {
I can't.
}
/*俺には……できない。*/
ライデン_061: {
I can't risk starting a family.
}
/*俺には家族を創ることはできない。*/
ライデン_062: {
There's no way to erase
my childhood.
}
/*あの体験を白紙に戻すことはできない。*/
ローズ_063: {
It's all right, Jack.
Please, don't say any more...
}
/*ジャック、わかった。
それ以上、言わないで……。*/
}
//d



resource P071_01_R01_拷問部屋脱出１無線機デモ１＿１__e {
//Vc117101
大佐_000: {
Raiden, do you copy.
}
/*ライデン、いいか。*/
大佐_001: {
You must continue
your m-mission.
}
/*に、任務、任務を続行しろ。*/
ライデン_002: {
I've lost all my gear.
I need to locate Snake.
}
/*装備がない。
スネークを探さなければ……。*/
大佐_003: {
He was never factored into the
simulation. Leave him out of this.
}
/*あの男はシミュレーション要素には
入っていない。あの男にかまうな。*/
ライデン_004: {
I can't do much naked, especially
in this temperature.
}
/*裸ではどうしようもない。
ここはかなり室温が低い。*/
大佐_005: {
That's true -- you won't be able to
attack or enter the Hanging mode,
either.
}
/*そうだな。
その格好では攻撃もエルードもできない。*/
ライデン_006: {
I think Snake has my gear.
}
/*装備はスネークが持っているらしい。*/
大佐_007: {
Raiden, take out Solidus and his
men. You must recover Arsenal
intact.
}
/*ライデン、ソリダス達を倒せ。
アーセナルを無傷で奪い返すんだ。*/
ライデン_008: {
Colonel, are you under orders
from the Patriots?
}
/*大佐、あんたは『愛国者達』の命令で？*/
大佐_009: {
Your role -- that is, mission --
is to infiltrate the structure and
disarm the terrorists --
}
/*君の今回の役割……
いや、任務は単独潜入して、
テロリストを武装解除し……。*/
ライデン_010: {
My role? Why do you
keep saying that.
}
/*また役割か？*/
大佐_011: {
Why not? This is a type
of role-playing game.
}
//<ページ数変更>
大佐_011_1: {
The point is that you play out your
part -- and I expect you to turn in
a perfect performance!
}
/*これは一種のロール・プレイングなのだ。
役割を果たせ！役割を演じきるのだ。
*/
ライデン_012: {
Colonel, I just remembered
something.
}
/*大佐、思い出したんだ。*/
大佐_013: {
What?
}
/*なんだ？*/
ライデン_014: {
That I've never met you
in person. Not once.
}
/*俺はあんたに直接あったことがない。
一度もな。*/
大佐_015: {
...
}
/*……。*/
大佐_016: {
Complete your mission according
to the simulation!
}
/*任務をシミュレーション通りに
完遂するんだ！*/
ライデン_017: {
Colonel, who are you?
}
/*大佐、あんたは誰なんだ！？*/
大佐_018: {
No more questions.
We have Rosemary.
}
/*それ以上の詮索は無用だ。
ローズマリーはこちらが預かっている。*/
ライデン_019: {
What do you mean by that!
}
/*それはどういう意味だ？*/
大佐_020: {
Over and out.
}
/*いいな、ライデン。*/
}
//d



resource P072_01_R01_大佐混乱１無線機デモ１＿１__e {
//Vc117201
大佐_000: {
Raiden, turn the game
console off right now!
}
/*ライデン、今すぐにゲーム機の電源を
切るんだ！*/
//大佐エフェクトをかける。（ウイルスが効き始めている）
ライデン_001: {
What did you say?
}
/*何て言った？*/
大佐_002: {
The mission is a failure!
Cut the power right now!
}
/*任務は失敗に終わった！
今すぐ電源を切れっ！*/
ライデン_003: {
What's wrong with you?
}
/*一体、どうしたんだ？*/
大佐_004: {
Don't worry, it's a game!
It's a game just like usual.
}
/*うろたえるな、これはゲームだ！
いつものゲームなんだ。*/
ローズ_005: {
You'll ruin your eyes playing 
so close to the TV.
}
/*長時間プレイすると目が悪くなるわよ。*/
ライデン_006: {
What are you talking about!?
}
/*何を言ってるんだ！？*/
大佐_007: {
Raiden, something happened to me
last Thursday when I was driving
home.
}
/*ライデン、聞いてくれ。先週の木曜の
ことだ。私は車で家に帰る途中だった。*/
大佐_008: {
I had a couple of miles to go -- I
looked up and saw a glowing orange
object in the sky, to the east!
}
/*家まであと２マイルほどの所……
ふと目を上げると東の空にオレンジ色の
光る物体が見えたんだ！*/
大佐_009: {
It was moving very irregularly...
Suddenly, there was intense light
all around me --
}
/*とても不規則に動いていた……
そして次の瞬間、あたり一面が
強烈な光に包まれ……*/
大佐_010: {
-- and when I came to, I was home.

}
/*気がつくと私は家に着いていた……。*/
大佐_011: {
What do you think happened
to me...?
}
/*どう思う？*/
ライデン_012: {
Huh?
}
/*どうって……。*/
大佐_013: {
Fine, forget it...
}
/*わかった……もういい……。*/
}
//d


resource P073_01_R01_通路Ａ１無線機デモ１＿１__e {
//vc117301
ローズ_000: {
Jack, it's me.
}
/*ジャック、私よ。*/
ライデン_001: {
Hi Rose.
}
/*ああ、ローズか。*/
ローズ_002: {
Jack -- I owe you an apology.
}
/*ジャック……
私、謝らなきゃいけないことがある……。*/
ライデン_003: {
If it's about that conversation
just now, I'm the one who's sorry.
}
/*さっきの事なら……すまなかった。*/
ローズ_004: {
No, it's something else.
}
/*違うの。*/
ライデン_005: {
What is it?
}
/*なんだ？*/
ローズ_006: {
That day at Federal Hall two years
ago -- it wasn't a coincidence.
}
/*２年前……あなたに初めて
会ったフェデラルホール……
あれは偶然ではないの。*/
ローズ_007: {
I was ordered to keep an eye
on you...
}
/*私、あなたを監視するように……。*/
ライデン_008: {
Keep an eye on me?
}
/*俺を監視？*/
ローズ_009: {
Yes -- by the Patriots.
}
/*そう、『愛国者達』に雇われて……。*/
ライデン_010: {
You're a spy.
}
/*スパイ？*/
ローズ_011: {
I suppose. Yes.
It's an ugly word.
}
/*そういう事になる。
その言葉は嫌いだけど。*/
ライデン_012: {
...
}
/*……。*/
ローズ_013: {
Are you still there?
}
/*……聞こえてる？*/
ライデン_014: {
Was sleeping with me
a part of the job?
}
/*俺と身体を重ねたのも、
任務だというのか？*/
ローズ_015: {
I fell in love with you...
}
/*あなたと恋に落ちたのは……。*/
ライデン_016: {
How could anyone --
}
/*卑劣な……。*/
ローズ_017: {
I can't excuse what I did.
}
//<ページ数変更>
ローズ_017_1: {
I've reported every detail of
your personal life to them these
two years.
}
//<ページ数変更>
ローズ_017_2: {
What you did, said, everything...
}
/*言い訳はできない。この２年間、
あなたの私生活を＃｛報告、レポート｝＃していた……
あなたの行動、言動……細かな事まで。
*/
ライデン_018: {
Must've been fun.
}
/*さぞ楽しかったろうな。*/
ローズ_019: {
But some things
I didn't tell anyone!
}
/*でも、報告してない事もあるわ！*/
ライデン_020: {
...
}
/*……。*/
ローズ_021: {
Like what I felt for you.
}
/*私の気持ち……。*/
ライデン_022: {
So that's why you were involved in
this mission. I should have known.
}
/*今回も最初からそういう事だったんだ。
俺が迂闊だった。*/
ライデン_023: {
Why else would they toss an analyst
into the mix at the last minute?
}
/*君のようなアナリストを
極秘ミッションに参加させるわけはない。*/
ローズ_024: {
I'm sorry, I know what
I did was wrong...
}
/*悪いのは私……。*/
ライデン_025: {
No matter where I go - I get used.
}
/*俺はどこまでも利用された訳だ。*/
ローズ_026: {
I reinvented myself to
suit your tastes.
}
//<ページ数変更>
ローズ_026_1: {
Hairstyle, clothes, the way I move,
things I talked about...
}
/*私はあなたに気に入られようと
必死だった……あなたの好きな髪型、
服装、仕草、話題……。
*/
ローズ_027: {
You say you love the color of my
hair, my eyes. They're not even
real.
}
/*あなたが好きと言ってくれた私の髪も
目の色も……嘘なの。*/
ライデン_028: {
You must have gone over my psych
profile with a fine-tooth comb.
}
/*俺のデータを調べ尽くしたんだろう？*/
ローズ_029: {
It was my job.
}
/*それが任務だった。*/
ライデン_030: {
Great performance --
had me completely fooled.
}
/*まんまと引っかかったわけだ。*/
ローズ_031: {
What I really wanted was
for you to see the real me.
}
/*でも……本当の自分を、本当の私を
あなたに愛してもらいたかった。*/
ローズ_032: {
It hurt to play out this --
this artificial romance.
}
/*私には、それが辛かった。
それが悲しかった。
私は疑似恋愛を強いられたの。*/
ローズ_033: {
It was worse to lie to
myself than to you.
}
/*あなたを騙し続ける事よりも……
自分を騙し続ける事の方が辛かった。*/
ローズ_034: {
The more love you gave me, the more
it hurt -- because I knew the person
you loved was just a character.
}
/*あなたが私を強く愛してくれれば、
くれるほど。あなたが愛しているのは
マニュアルに従った私。*/
ライデン_035: {
So it was artificial on my end too.
It was just a game, not the real
thing.
}
/*つまり俺の方も疑似恋愛だったって事か。
ゲームだったんだ。*/
ローズ_036: {
Oh Jack...
}
/*ジャック……。*/
ライデン_037: {
I feel better knowing that.
}
/*それを聞いて、少しは気がおさまった。*/
ローズ_038: {
What?
}
/*えっ？*/
ライデン_039: {
I was in love -- or thought I was --
with someone who didn't exist.
}
/*嘘の人格を愛していたんだ。
いや、愛していたつもりになっていた。
*/
ライデン_040: {
I was trying to be someone I wasn't
by loving what wasn't real.
}
/*嘘の相手を愛することで
嘘の自分を演じていた。*/
ライデン_041: {
I don't know who you really are.
}
//<ページ数変更>
ライデン_041_1: {
The person I knew isn't real;
she's not the woman I'm talking
to right now.
}
/*俺は本当の君を知らない。
俺が知ってるのは嘘の君だ。
今、話している君じゃない。
*/
ローズ_042: {
In a sense, the deception
was my own, not theirs.
}
/*それだけはわかった。
だから俺は奴等に騙されたわけじゃない。*/
ローズ_043: {
Jack, I thought I was acting,
because that was my job.
}
/*ジャック、私、演じていたつもり。
それが任務だったから。*/
ローズ_044: {
But I did fall in love with
you, that wasn't an act.
}
/*でも、あなたを愛したのは……
全てが演技じゃない。*/
ライデン_045: {
You expect me to believe that?
}
/*それを信じろというのか。*/
ローズ_046: {
...
}
/*……。*/
ライデン_047: {
It's okay. You had your reasons,
right? Hey, I understand. But I
have nothing left to...
}
/*いいさ。
君にもいろいろ事情があったんだろう？
それは分かるよ。でもこれで……。*/
ローズ_048: {
Jack!!
}
/*ジャック！！*/
ライデン_049: {
What?
}
/*え？*/
ローズ_050: {
I'm...
}
ローズ_050_1: {
...I'm carrying...
}
/*私……お腹に……お腹に……。*/
ローズ_051: {
I'm pregnant, Jack.
}
/*私、妊娠しているの。*/
//ローズの声がバグってゆく。回転スピードが落ちてゆく。ＨＡＬ９０００の最後に近い。
ローズ_052: {
Your baby.
}
/*あなたの赤ちゃんが。*/
ライデン_053: {
Rose? What's going on?
}
/*どうした、ローズ？*/
}
//d



resource P073_03_R02_通路Ａ３無線機デモ２＿１__e {
//Vc117311
スネーク_000: {
Sorry about earlier. I had to
use you as bait to gain access
to Arsenal. It worked.
}
/*悪かったな。アーセナルに潜入する
ためにお前をだしに使わせてもらった。
お陰でうまくいった。*/
ライデン_001: {
Why didn't you tell
me about Olga?
}
/*オルガのこと、なぜ黙っていた？*/
スネーク_002: {
You never asked.
}
/*聞かなかっただろう？*/
ライデン_003: {
Uh!
}
/*くっ！*/
スネーク_004: {
Not happy about that?
Get over it.
}
/*気にいらんか？
ま、過ぎたことだ。
気にするな。*/
ライデン_005: {
...any effects of the virus yet?
}
/*……ウイルスの効果は？*/
スネーク_006: {
Still waiting on that.
}
/*まだ出ていない。*/
ライデン_007: {
So it was rigged
by the Patriots?
}
/*やはり『愛国者達』の仕掛けが？*/
スネーク_008: {
Looks like it. From what I can tell,
Arsenal is headed for Manhattan.
}
/*らしいな。アーセナルはマンハッタンに
向かっているようだ。*/
スネーク_009: {
I don't know what Solidus is
planning, but we'll have to deal
with it one way or another.
}
/*ソリダスが何をする気かは分からんが…
俺達でなんとかするしかない。*/
スネーク_010: {
There's also a troop of
production-model RAYs
ahead.
}
/*この先に量産型ＲＡＹが待ち構えている。*/
ライデン_011: {
How many units?
}
/*何機？*/
スネーク_012: {
Twenty-five, according to Olga.
}
/*オルガが言うには２５機。*/
ライデン_013: {
Twenty-five!?
}
/*２５機！？*/
スネーク_014: {
Yeah. Can't say I've faced that
many Metal Gears before, but --
I think we can deal.
}
/*ああ。俺もそれだけのメタルギアを
相手にしたことはないが……
いけるだろう？*/
ライデン_015: {
No way we can...
}
/*とても相手に出来ない……。*/
スネーク_016: {
We can because we
have no other choice.
}
/*だがやるしかない。*/
ライデン_017: {
How?
}
/*どうやって？*/
スネーク_018: {
I've stocked up on
Stinger missiles.
}
/*スティンガー・ミサイルを
補給しておいた。*/
スネーク_019: {
Oh yeah, Olga left this for you.
}
/*そうだ、オルガからこれを預かった。*/
}
//d



resource P074_02_R01_通路Ａ刀後２無線機デモ１＿１__e {
//Vc117401
ライデン_000: {
Snake, have you ever --
enjoyed killing someone?
}
/*スネーク、
人を殺す度に喜びを感じたことは？*/
スネーク_001: {
What are you talking about?
}
/*どういう意味だ。*/
ライデン_002: {
I'm not sure. Sometimes it's hard
to tell the difference between
reality and a game...
}
/*わからない。
これが現実なのか？
ゲームなのか？*/
スネーク_003: {
Diminished sense of reality, huh?
VR training will do that.
}
/*現実感の欠如。
ＶＲ訓練の影響だ。*/
ライデン_004: {
No, it was field training,
when I was a kid.
}
/*いや、現実に訓練されたんだ。
子供の頃に。*/
ライデン_005: {
I lied, Snake. I have more field
experience than I can remember.
It's not VR that's doing this to me.
}
/*スネーク、俺は嘘をついた。
実戦の経験をしている。
ＶＲの影響じゃない。*/
スネーク_006: {
Raiden, we don't carry guns to take
people down. We're not here to help
some politician either.
}
/*ライデン、俺達は人を傷つけるために
銃を握っているわけじゃない。
ましてや、どこかの政治家の為でもない。*/
ライデン_007: {
You can say that because
you're a legend, a hero.
}
//<ページ数変更>
ライデン_007_1: {
I'm Jack the Ripper, a dirty
reminder -- of a terrible mistake.
}
/*あんたは伝説の＃｛戦士、ヒーロー｝＃だ。
俺は＃｛切り裂きジャック、ジャック・ザ・リッパー｝＃。
封印された歴史の＃｛汚穢、おわい｝＃。
*/
スネーク_008: {
Legends don't mean a whole lot.
I was just a name to exploit.
}
/*伝説でもなんでもない、
俺も利用されただけだ。*/
スネーク_009: {
Just like you.
}
/*俺もお前と同じだ。*/
ライデン_010: {
People will remember only
the good part, the right part
of what you did.
}
/*あんたの行動は語り継がれる。
正当化される。*/
スネーク_011: {
There's no right part
in murder, not ever.
}
/*人殺しが正当化される事などない。
正当化される時代もない。*/
スネーク_012: {
And we're not in this to make
a name for ourselves.
}
/*俺達は自分の功績を残そうとして
いるんじゃない。*/
ライデン_013: {
Then what are you and
Otacon fighting for?
}
/*なら、あんたやオタコンは何のために
戦ってる？*/
スネーク_014: {
A future.
}
/*俺は未来のために銃を握っている。*/
スネーク_015: {
You can stop being part of
a mistake, starting now.
}
/*いいか、つまらん殺戮に手を貸すのは、
これで終わりにしろ。*/
ライデン_016: {
What am I -- what am I
supposed to do?
}
/*俺は……どうすればいいんだ？*/
}
//d


resource P075_01_R01_オタコン無事１無線機デモ１＿１__e {
//Vc117501
オタコン_000: {
Snake, Raiden!
}
/*スネーク、ライデン！*/
スネーク_001: {
Otacon! You all right?
}
/*オタコン！
無事だったか？*/
オタコン_002: {
Yeah. So are all the hostages.
}
/*うん。人質もみんなね。*/
ライデン_003: {
That's good news.
}
/*それはよかった。*/
オタコン_004: {
How's everything on your end?
}
/*君達の方は大丈夫かい？*/
ライデン_005: {
All right for now. But
there is something --
}
/*今のところは……ただ……。*/
オタコン_006: {
What?
}
/*ただ？*/
ライデン_007: {
The Colonel's last transmission
was strange.
}
/*大佐の様子がおかしいんだ。*/
オタコン_008: {
Strange? How?
}
/*おかしい？*/
ライデン_009: {
Just -- strange. No idea --
}
/*ああ……一体どうしたのか……？*/
オタコン_010: {
Interference?
}
/*妨害電波？*/
ライデン_011: {
I don't know.
}
/*わからない。*/
オタコン_012: {
Where is this Colonel?
}
/*……大佐はどこから指令を？*/
ライデン_013: {
I don't know. I've never
met the man, actually...
}
/*……わからないんだ。
俺は大佐に会ったことがない……。*/
オタコン_014: {
...I'll dig around.
}
/*……調べてみるよ。*/
ライデン_015: {
Thanks. I owe you one.
}
/*頼む。*/
オタコン_016: {
If there's anything else, call me
on the Codec, I might be able to
help.
}
//<ページ数変更>
オタコン_016_1: {
The frequency is 141.12.
}
/*他にも何かあったら無線連絡をくれ。
サポートできると思う。
周波数は１４１．１２だ。
*/
}
//d



resource P076_01_R01_大佐ＡＩ１無線機デモ１＿１__e {
//Vc117601
オタコン_000: {
Raiden? About this Colonel of
yours -- I found out where he is.
}
/*ライデン？
『大佐』のことだけど……わかったんだ。
君の『大佐』がどこにいるのか。*/
ライデン_001: {
Where?
}
/*どこだ？*/
オタコン_002: {
Inside Arsenal.
}
/*そのアーセナルの中。*/
ライデン_003: {
What!?
}
/*なに！？*/
オタコン_004: {
I've checked out all the possibilities,
but I keep coming back to Arsenal.
}
//<ページ数変更>
オタコン_004_1: {
It isn't a relay point, it's
the origin of the signal.
}
/*いろいろな要素を検討したんだけど……
中継ではなく、アーセナル内部から
発信されているとしか考えられない。
*/
ライデン_005: {
...
}
/*……。*/
オタコン_006: {
And, the encryption protocol it
uses is exactly the same as that of
Arsenal's AI -- the so-called GW.
}
/*それに……暗号化コードが同じなんだ。
『Ｇ．Ｗ』……アーセナルのＡＩと。*/
ライデン_007: {
...What the hell does this mean?
}
/*……どういうことなんだ？*/
オタコン_008: {
I think it means -- you've
been talking to an AI.
}
/*つまり……君が喋っていた相手は、
ＡＩなんだよ。*/
ライデン_009: {
That's impossible!
}
/*嘘だ！！*/
オタコン_010: {
The Colonel probably
isn't GW per se.
}
//<ページ数変更>
オタコン_010_1: {
GW was most likely stimulating
cortical activity in the dormant
part of your brain＃－
}
/*本当だ。正確には『Ｇ．Ｗ』そのもの
じゃない。おそらく『Ｇ．Ｗ』からの
信号が君の脳内ナノマシンを動かし、
*/
オタコン_011: {
through signal manipulation
of your own nanomachines.
}
/*脳の使用されていない冗長部分の
神経配置を器質操作して『大佐』を
発生させるっていう仕組みだ……
*/
オタコン_012: {
The Colonel is in part your own
creation, cobbled together from
expectations and experience...
}
/*つまり『大佐』は君の脳の中に
存在する……。*/
ライデン_013: {
That's crazy...
}
/*馬鹿な……。*/
オタコン_014: {
But it's probably the truth.
}
/*でも、事実なんだ。*/
オタコン_015: {
The virus may be starting to
affect GW, which would explain
the Colonel's behavior.
}
/*『大佐』の様子がおかしくなってるのは、
多分あのウィルスが『Ｇ．Ｗ』に効き
始めたせいだと思う。*/
ライデン_016: {
It was all -- an illusion?
Everything I've done so far...?
}
/*全て……幻……？
では……俺が今までしてきたことは……？*/
スネーク_017: {
Raiden!
}
/*ライデン！*/
ライデン_018: {
Snake -- what's happening
around here?
}
/*スネーク……
どういうことなんだろう？*/
スネーク_019: {
I don't know. What I do know is
that you're standing right here
in front of me.
}
/*わからん。
……俺に言えるのは、俺の目の前にいる
お前は幻じゃないということだけだ。*/
スネーク_020: {
Not an illusion --
flesh and blood.
}
/*お前は確かにここにいる。*/
ライデン_021: {
...
}
/*……。*/
スネーク_022: {
It's your call. You can
drop this if you want.
}
/*どうする？
やめたければやめてもいい。*/
ライデン_023: {
No, I can't do that.
Let's go...
}
/*いや。辞めるわけにはいかない。
行こう……。*/
}
//d





resource P077_01_R01_ローズ拉致１無線機デモ１＿１__e {
//Vc117701
大佐_000: {
Raiden! They've got Rose!
}
/*ライデン！
ローズ君が奴等に拉致された！！*/
ライデン_001: {
What!
}
/*何だって！*/
大佐_002: {
Rose is being held in the holds!
}
/*ローズ君は船倉に捕らえられている！*/
//（ＯＦＦ） くちぱくいりません
スネーク_003: {
It's a trap!
}
/*罠だぞ！*/
ローズ_004: {
Help!
}
/*タスケテ！*/

ライデン_005: {
Rose!
}
/*ローズ！！*/
スネーク_006: {
Raiden, get a grip!
}
/*落ち着け、ライデン。*/
ライデン_007: {
But Snake!
}
/*しかし！！*/
スネーク_008: {
It's a trap. Since the Colonel
doesn't exist, there's no way
he can take Rose hostage.
}
/*奴等の罠だ。
『大佐』は存在しない。
ローズを拉致出来るはずもないだろう。*/
ライデン_009: {
Yeah -- you're right...
}
/*……そうか……
……そうだな……。*/
スネーク_010: {
I am right.
}
/*そうだ。*/
ライデン_011: {
...OK.
}
/*……そう……。*/
ライデン_012: {
...
}
/*……。*/
ライデン_013: {
Does Rose -- exist -- ?
}
/*……ローズも……存在しない……？*/
スネーク_014: {
Don't be weird.
She's your --
}
/*何を言ってるんだ？
彼女は……。*/
ライデン_015: {
What if I've never really met her...
}
/*いや、ひょっとしたら俺は
彼女と会ったことすらないのかも
しれない……。*/
スネーク_016: {
What?
}
/*何を？*/
ライデン_017: {
If the Colonel is something that
I partly dreamt up, then...
}
//<ページ数変更>
ライデン_017_1: {
everything I remember
about her could be...
}
/*『大佐』が俺の脳の中にしか存在しない
幻だったように……
彼女も、彼女との思い出も……。
*/
スネーク_018: {
Don't jump to conclusions!
}
/*結論を急ぐんじゃない！！*/
ライデン_019: {
You and Otacon are the ones that
say the Colonel never existed.
}
/*『大佐』が存在しないという結論を
出したのはあんた達だぞ。*/
スネーク_020: {
Raiden!
}
/*ライデン！*/
ライデン_021: {
Is this what Olga was
talking about?
}
/*オルガが言っていたのは……
このことだった？*/
}
//d




resource P080_19_R01_ＡＧ浮上１９無線機デモ１＿１__e {
//Vc118001
大佐_000: {
Raiden, are you receiving?
We're still here.
}
/*ライデン、聞こえるか？
我々だ。*/
ライデン_001: {
How's that possible!?
The AI was destroyed!
}
/*なぜだ！？
ＡＩは崩壊したはず！？*/
大佐_002: {
Only GW...
}
/*『Ｇ．Ｗ』は、な……。*/
ライデン_003: {
Who are you?
}
/*お前達は一体！？*/
大佐_004: {
To begin with -- we're not
what you'd call -- human.
}
/*そもそも我々は正確には……
人ではない。*/
}
//d


/*ＸＸＸむーびまじ？
*movie
大佐_000: {
４０億年前、地球の海中で突然、生命が生まれたように。
}
/**/
大佐_000: {
ホワイトハウス（の汚濁）の中で芽生え、進化してきた……。
}
/**/
大佐_000: {
星条旗の元に……市民宗教の中で……。
}
/**/

アメリカの国家が鳴り響く。
*movie ここまで
*/

resource P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e {
//vc118011
大佐_000: {
We are formless. We are the
very discipline and morality that
Americans invoke so often.
}
/*我々に実体はない。我々は君達が頼る
『秩序』や『規範』そのものなのだ。*/
大佐_001: {
How can anyone hope to eliminate
us? As long as this nation exists,
so will we.
}
/*誰も我々を抹殺する事はできない。
この国が消滅しない限り、
我々は存在し続ける……。*/
ライデン_000: {
Cut the crap! If you're immortal,
why would you take away individual
freedoms and censor the Net?
}
/*ふざけるな！お前達が不滅なら、
なぜ支配を続けるために個人の自由を
奪い、デジタル情報を検閲する？*/
ローズ_001: {
Jack, don't be silly.
}
/*ははは、ジャックって、ほんと馬鹿ね。*/
大佐_002: {
Don't you know that our plans
have your interests -- not ours
-- in mind?
}
/*いいか、我々の計画は我々のために
あるのではない。
君達のためにあるのだよ。*/
ライデン_003: {
What?
}
/*なに？*/
ローズ_004: {
Jack, listen carefully
like a good boy!
}
/*ジャック、耳をかっぽじって、
よく聞きなさい！*/
大佐_005: {
The mapping of the human genome
was completed early this century.
}
/*今世紀初頭にヒトゲノム情報の
読みとりが完了した。
*/
大佐_006: {
As a result, the evolutionary log
of the human race lay open to us.
}
/*その結果、地球生命の４８億年に渡る、
我々人類の進化過程が明らかになった。
*/
ローズ_007: {
We started with genetic engineering,
and in the end, we succeeded in
digitizing life itself.
}
/*遺伝子操作を始めとして、
生命のデジタル化に成功したのよ。*/
大佐_008: {
But there are things not covered
by genetic information.
}
/*しかし、一方で遺伝子上に乗っていない
ものがある。*/
ライデン_009: {
What do you mean?
}
/*遺伝情報に載っていないもの？*/
大佐_010: {
Human memories, ideas.
Culture. History.
}
/*そう、人の記憶や思想、文化や歴史だ。*/
ローズ_011: {
Genes don't contain any
record of human history.
}
/*遺伝子には人類の歴史は刻まれてない。*/
大佐_012: {
Is it something that should
not be passed on?
}
//<ページ数変更>
大佐_012_1: {
Should that information be
left at the mercy of nature?
}
/*果たして、それは伝えるべきなのか？
これまで同様、自然界で淘汰される
べきなのか？
*/
ローズ_013: {
We've always kept records of our
lives. Through words, pictures,
symbols... from tablets to books...
}
/*私達の先祖はそれらを語り伝えてきた。
言葉や絵、文字を使って……
石版や書物に記録しながら……。*/
大佐_014: {
But not all the information was
inherited by later generations.
}
/*しかし、全ての情報が後世に
伝えられてきた訳でない。*/
大佐_015: {
A small percentage of the whole was
selected and processed, then passed
on. Not unlike genes, really.
}
/*選択され、加工されて継承されて
きたのだ……。
まるで遺伝子のように。*/
ローズ_016: {
That's what history is, Jack.
}
/*それが人の歴史よ、ジャック。*/
大佐_017: {
But in the current, digitized
world,
}
//<ページ数変更>
大佐_017_1: {
trivial information is accumulating
every second, preserved in all its
triteness.
}
/*しかし、現代のデジタル社会では、
日々のあらゆる情報が蓄積され、些細な
情報がそのままの形で保存されている。
*/
大佐_018: {
Never fading, always accessible.
}
/*永久に、劣化する事はない。*/
ローズ_019: {
Rumors about petty issues,
misinterpretations, slander...
}
/*誰が言ったかも分からない、
ゴミのような噂、間違った解釈、
他人の中傷……。*/
大佐_020: {
All this junk data preserved in
an unfiltered state, growing at
an alarming rate.
}
/*あらゆる情報が濾過されず、保存されて、
後世に伝えられる。*/
ローズ_021: {
It will only slow down social
progress, reduce the rate of
evolution.
}
/*それは進化を止める。*/
大佐_022: {
Raiden, you seem to think that
our plan is one of censorship.
}
/*ライデン、君は我々が行おうとしている
ことを単なる検閲だと思っていないか？*/
ライデン_023: {
Are you telling me it's not!?
}
/*違うとでも言うのか！？*/
ローズ_024: {
You're being silly! What we
propose to do is not to control
content, but to create context.
}
/*ええ、勿論。私達がしようと
してるのはコンテンツの制御ではなく、
コンテクストの生成。*/
ライデン_025: {
Create context?
}
/*コンテクストの生成？*/
大佐_026: {
The digital society furthers human
flaws and selectively rewards＃－
}
//<ページ数変更>
大佐_026_1: {
development of convenient
half-truths.
}
/*世界のデジタル化は、人の弱さを助長し、
それぞれだけに都合のいい『真実』の
生成を加速している。
*/
大佐_027: {
Just look at the strange
juxtapositions of morality
around you.
}
/*社会に満ちる『真実』の山を
見てみるがいい……。*/
ローズ_028: {
Billions spent on new weapons
in order to humanely murder
other humans.
}
/*高価な兵器が人道的に人を殺し……*/
大佐_029: {
Rights of criminals are given
more respect than the privacy
of their victims.
}
/*犯罪者の人権は被害者のプライバシー
より丁重に扱われ……*/
ローズ_030: {
Although there are people suffering
in poverty, huge donations are made
to protect endangered species.
}
/*稀少動物保護の寄付金が集まる傍らで、
貧困に苦しむ人達がいる……。*/
ローズ_031: {
Everyone grows up being
told the same thing.
}
/*誰もがこう言われて育つわ。*/
大佐_032: {
Be nice to other people.
}
/*他人には優しくしよう。*/
ローズ_033: {
But beat out the competition!
}
/*でも競争相手は叩きのめせ！*/
大佐_034: {
"You're special."
"Believe in yourself
and you will succeed."
}
/*『お前は特別だ』
『信じていれば夢はかなう』*/
ローズ_035: {
But it's obvious from the start
that only a few can succeed...
}
/*だけど成功できる人間が一部だけなのは、
初めから明らかよね……。*/
大佐_036: {
You exercise your right to "freedom"
and this is the result.
}
/*君達が『自由』を『行使』した、
これが結果だ。*/
大佐_037: {
All rhetoric to avoid conflict
and protect each other from hurt.
}
/*争いを避け、傷つかないようにお互いを
かばいあうための詭弁……*/
大佐_038: {
The untested truths spun by
different interests continue
to churn and accumulate＃－
}
//<ページ数変更>
大佐_038_1: {
in the sandbox of political
correctness and value systems.
}
/*『政治的正しさ』や『価値相対化』と
いうキレイゴトの名の下に、それぞれの
『真実』がただ蓄積されていく。
*/
ローズ_039: {
Everyone withdraws into their own
small gated community, afraid of a
larger forum.
}
/*衝突を怖れてそれぞれのコミュニティに
ひきこもり、*/
ローズ_040: {
They stay inside their little ponds,
}
//<ページ数変更>
ローズ_040_1: {
leaking whatever "truth" suits
them into the growing cesspool
of society at large.
}
/*ぬるま湯の中で適当に甘やかしあい
ながら、好みの『真実』を垂れ流す。
*/
大佐_041: {
The different cardinal truths
neither clash nor mesh.
}
//<ページ数変更>
大佐_041_1: {
No one is invalidated,
but nobody is right.
}
/*かみ合わないのにぶつからない
『真実』の数々。誰も否定されないが
故に誰も正しくない。
*/
ローズ_042: {
Not even natural selection can
take place here. The world is
being engulfed in "truth."
}
/*ここでは淘汰も起こらない。
世界は『真実』で飽和する。*/
大佐_043: {
And this is the way the world ends.
Not with a bang, but a whimper.
}
/*それが世界を終わらせるのだ。
緩やかに。*/
ローズ_044: {
We're trying to stop
that from happening.
}
/*私達はそれを食い止めてあげようって
言うの。*/
大佐_045: {
It's our responsibility as rulers.
}
/*我々には支配者としての責任が
あるからな。*/
大佐_046: {
Just as in genetics, unnecessary
information and memory must be
filtered out＃－
}
//<ページ数変更>
大佐_046_1: {
to stimulate the evolution
of the species.
}
/*遺伝子と同じく、必要のない情報、
記憶は淘汰されてこそ、種の進化を
促進するのだ。
*/
ライデン_047: {
And you think you're qualified to
decide what's necessary and not!?
}
/*何が必要か、お前達が決めるって
いうのか！？*/
大佐_048: {
Absolutely. Who else could wade
through the sea of garbage you
people produce,
}
//<ページ数変更>
大佐_048_1: {
retrieve valuable truths and even
interpret their meaning for later
generations?
}
/*その通りだ。君達が＃Ｔ｛ひり｝＃出す糞の山から、
我々が価値のある真実を選び取り、
残すべき意味を紡いでやる。
*/
ローズ_049: {
That's what it means
to create context.
}
/*それがコンテクストの生成。*/
ライデン_050: {
I'll decide for myself what to
believe and what to pass on!
}
/*次の世代に伝えるものは自分で決める！*/
大佐_051: {
But is that even your own idea?
}
/*それは君自身の言葉か？*/
ローズ_052: {
Or something Snake told you?
}
/*スネークさんが言ったことじゃないの？*/
ライデン_053: {
...
}
/*……。*/
大佐_054: {
That's the proof of your
incompetence, right there.
}
//<ページ数変更>
大佐_054_1: {
You lack the qualifications
to exercise free will.
}
/*ふふん。それが君の無能を表わしている。
君に選択の自由を行使する資格はない。
*/
ライデン_055: {
That's not true!
I have the right --
}
/*違う！
俺は自分で……*/
ローズ_056: {
Does something like a "self"
exist inside of you?
}
/*『自分』なんてものが、
あなたにあるの！？*/
大佐_057: {
That which you call "self" serves
as nothing more than a mask to
cover your own being.
}
/*君が思っている『自分』なぞ、
せいぜい身を守る為の言い訳に過ぎんの
ではないか？*/
ローズ_058: {
In this era of ready-made 'truths',
}
//<ページ数変更>
ローズ_058_1: {
"self" is just something used to
preserve those positive emotions
that you occasionally feel...
}
/*世間に溢れてる出来合いの『真実』の
中から、その時々に気持ち良く思える
ことをツギハギしただけ。
*/
大佐_059: {
...Another possibility is that "self"
is a concept you conveniently
borrowed under the logic＃－
}
//<ページ数変更>
大佐_059_1: {
that it would endow you with
some sense of strength...
}
/*あるいは、もっともらしい権威の元に
身を寄せて手に入れたつもりになって
いる借り物か……。
*/
ライデン_060: {
That's crap!
}
/*違う！！*/
大佐_061: {
Is it? Would you prefer that
someone else tell you?
Alright then. Explain it to him.
}
/*うん？誰かにそう言ってもらいたいのか？
よかろう。言ってやれ。*/
ローズ_062: {
Jack, you're simply the best!
And you got there all by yourself!
}
/*あなたは立派よ、ジャック！
自分を確立してるもの！！*/
ライデン_063: {
Rrrr...
}
/*くそっ……。*/
大佐_064: {
Oh, what happened? Do you
feel lost? Why not try a bit
of soul-searching?
}
/*どうした？迷ったのか？
では『自分探し』でもしてみるか？*/
ローズ_065: {
Don't think you'll find
anything, though...
}
/*何も見つからないと思うけど。*/
大佐_066: {
Ironic that although "self" is
something that you yourself
fashioned,
}
//<ページ数変更>
大佐_066_1: {
every time something goes wrong,
you turn around and place the blame
on something else.
}
/*だが、そうやって自分で作った『自分』
にも関わらず、何か都合が悪いことが
起きると、それを他の何かのせいにする。
*/
ローズ_067: {
It's not my fault.
It's not your fault.
}
/*俺のせいじゃない。
君のせいじゃない。*/
大佐_068: {
In denial, you simply resort
to looking for another,
}
//<ページ数変更>
大佐_068_1: {
more convenient "truth" in order
to make yourself feel better.
}
/*そしてまた別の口当たりのいい
『真実』を探して、そこに『癒し』を
求める。
*/
ローズ_069: {
...leaving behind in an instant
the so-called "truth" you once
embraced.
}
/*今まで利用してた『真実』を
あっさり使い捨ててね。*/
大佐_070: {
Should someone like that be
able to decide what is "truth"?
}
/*そんな君に真実が選べるのか？*/
ローズ_071: {
Should someone like you even
have the right to decide?
}
/*その自由を使う資格があるの？*/
大佐_072: {
You've done nothing but
abuse your freedom.
}
/*君は自由を食いつぶしている。*/
ローズ_073: {
You don't deserve to be free!
}
/*あなたは自由に値しない。*/
大佐_074: {
We're not the ones smothering
the world. You are.
}
/*世界を逼塞させようとしているのは
我々ではない。君達なのだよ。*/
ローズ_075: {
The individual is supposed to be
weak. But far from powerless --
}
//<ページ数変更>
ローズ_075_1: {
-- a single person has the
potential to ruin the world.
}
/*本来、個は弱いけど無力じゃない。
むしろ世界を壊すほどに危険な存在なの。
*/
大佐_076: {
And the age of digitized
communication has given even
more power to the individual.
}
//<ページ数変更>
大佐_076_1: {
Too much power for
an immature species.
}

/* こんな事を言ってはいないので、
英語音声からカットすること。
音声からカットされたら、以下もマスク。*/
/* 0820マスク
大佐_076_no_use: {
That's why we've decided to be
your guardians, if you will.
}
*/
/*そしてデジタルのテクノロジーがさらに
個を強くした。それは今の君達には
過ぎた力だ。
*/

ローズ_077: {
Building a legacy involves figuring
out what is wanted, and what needs
to be done for that goal.
}
/*何を残すかは、何をしたいか、
そのために何をするか、ということ。*/
ローズ_078: {
All this, you used to struggle
with. Now, we think for you.
}
/*あなた達がする全てのことを私達が
かわりに考えてあげる。*/
大佐_079: {
We are your guardians after all.
}
/*我々は君達の保護者だからな。*/
ライデン_080: {
You want to control human
thought? Human behavior?
}
/*人の想いと行動を管理しようというのか？
*/
大佐_081: {
Of course. Anything can
be quantified nowadays.
}
//<ページ数変更>
大佐_081_1: {
That's what this exercise
was designed to prove.
}
/*そうだ。
現代ではどんなものでも数値化できる。
それを実証するための演習だった。
*/
ローズ_082: {
You fell in love with me just as
you were meant to, after all.
Isn't that right, Jack?
}
/*だってジャックは作られた私を愛して
いたのよ。そうでしょ？*/
大佐_083: {
Ocelot was not told the whole
truth, to say the least.
}
/*オセロットにも全てを
教えていたわけではない。*/
ローズ_084: {
We rule an entire nation -- of what
interest would a single soldier,
no matter how able, be to us?
}
/*この国を支配する私達にとって、
どんなに優秀でも一人の兵士なんて
問題にはならない。*/
大佐_085: {
The S3 Plan does not stand
for Solid Snake Simulation.
}
/*Ｓ３計画とはＳｏｌｉｄ　Ｓｎａｋｅ　
Ｓｉｍｕｌａｔｉｏｎの略ではないのだ。*/
大佐_086: {
What it does stand for is
Selection for Societal Sanity...
}
/*正しくは
＃｛社会の（思想的）健全化のための淘汰、Ｓｅｌｅｃｔｉｏｎ　ｆｏｒ　Ｓｏｃｉｅｔａｌ　Ｓａｎｉｔｙ｝＃。*/
}
//d



resource P080_23_R03_ＡＧ浮上２３無線機デモ３＿１__e {
//Vc118021
大佐_000: {
What you experienced was the
final test of its effectiveness.
}
/*君が経験したのはその有効性を
実証するための最終試験だった。*/
ライデン_001: {
That's crazy...
}
/*そんな馬鹿な？*/
大佐_002: {
You heard what President
Johnson said.
}
/*ジョンソン大統領が言っていただろう。*/
大統領_003: {
The Arsenal's "GW" system is
the key to their supremacy.
}
/*『Ｇ．Ｗ』とアーセナルの完成は
すなわち新しい支配の完成を意味する。*/
大佐_004: {
The objective of this exercise
was to establish such a method.
}
/*この演習の目的はそのメソッドの確立だ。*/
}
//d




resource P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e {
//Vc118031
大佐_000: {
Raiden, there are also reasons
behind your selection.
}
/*ライデン、君を選んだのにも理由がある。*/
大佐_001: {
Solidus raised plenty of other
child soldiers. Do you know why
we chose you over them?
}
/*ソリダスの育てたチャイルド・
ソルジャーなら他にもいる。だが我々は
あえて君を選んだ。なぜだか分かるか？*/
ライデン_002: {
?
}
/*？*/
大佐_003: {
It was because you were
the only one who refused
to acknowledge the past.
}
/*君だけが自分の過去から目をそらして
いたからだ。*/
大佐_004: {
All the others remember what
they were, and pay for it daily.
}
/*他の者は皆、それぞれ自分の過去に
苦しんでいるというのに……。*/
ローズ_005: {
But you turn your back on
everything you don't like.
}
/*そう。あなたは見たくないもの全てに
背を向けていた。*/
ローズ_006: {
You do whatever you like,
see only the things you like,
and for yourself alone.
}
/*自分のためだけに自分の見たいもの
だけを見て、したいことだけをしていた。*/
大佐_007: {
Yes -- Rose can attest to that.
}
/*そのあたりはローズ君が詳しいな。*/
ローズ_008: {
You refused to see me for what I
was. I lied to you, but I wanted to
be caught.
}
/*あなたは本当の私を見ようとしなかった。
確かに私はウソをついてたわ。
でも本当は気づいてほしかった。*/
ローズ_009: {
You pretended to be understanding,
to be a gentleman...
}
/*……だけどあなたは理解のある振りを
して、物分かりがいい風を装って……*/
ローズ_010: {
You never made a conscious
attempt to reach out to me...
}
/*自分から私に踏み込もうとしては
くれなかった……*/
ローズ_011: {
The only time you did was
when I gave you no choice
but to do so...
}
/*私に踏み込むのは、私に追いつめられて、
やむを得ずそうする時だけ……。*/
ライデン_012: {
I was just trying not to...
}
/*それは君を……。*/
ローズ_013: {
What? "Trying not to hurt me?"
Dear, the one you were trying not
to hurt was yourself!
}
/*傷つけたくなかったから？嘘！！
あなたは自分が傷つきたくなかったのよ。*/
ローズ_014: {
Avoiding the truth under the guise
of "kindness" is all that you did!
}
/*『優しさ』をアリバイにして逃げて
ただけ……！*/
ローズ_015: {
It occurred to you to do nothing
but look out for yourself.
}
/*……あなたはいつも自分を守ることしか頭になかった……*/
ローズ_016: {
Even if you claim that it was for
my sake, that feeling was nowhere
to be seen.
}
/*私のためとか言ってみても、
本当に何かをしてくれるわけじゃない。*/
ローズ_017: {
In the end, everything was for
your sake... I was never part of
the picture.
}
/*結局、全部自分のため……
私のことなんか……考えもしない……！*/
大佐_018: {
Ha, ha, ha...exactly right.
}
/*はっはっは……そういうことだ。*/
大佐_019: {
So you see, you're a perfect
representative of the masses
we need to protect.
}
//<ページ数変更>
大佐_019_1: {
This is why we chose you.
}
/*つまり君は、我々が保護すべき大衆の
モデルケースとして、うってつけ
だったのだよ。だから君を選んだ。
*/
大佐_020: {
You accepted the fiction we've
provided, obeyed our orders and
did everything you were told to.
}
/*事実、これまで君は我々の提供する
フィクションを進んで受け入れ、指示を
こい、言われた通りに動いてくれた。*/
大佐_021: {
The exercise is a resounding
success.
}
/*演習は成功だ。*/
エマ_022: {
Didn't I tell you that GW
was still incomplete? But
not anymore, thanks to you.
}
/*私、言ったでしょ？『Ｇ．Ｗ』はまだ
未完成だったって。それもこれで完成。
全部あなたのおかげ。ありがとう！*/
大佐_023: {
Your persona, experiences,
triumphs and defeats are
nothing but byproducts.
}
//<ページ数変更>
大佐_023_1: {
The real objective was ensuring
that we could generate and
manipulate them.
}
/*君自身も君の経験も、君の喜怒哀楽も
ただの副産物だ…それを作り出し、制御
しうることを確かめるのが目的だった。
*/
大佐_024: {
It's taken a lot of time and money,
but it was well worth it considering
the results.
}
/*金と時間はかかったが、この成功に
くらべれば、極めてささいなものだ……。*/
ライデン_025: {
...
}
/*……。*/
大佐_026: {
I think that's enough talk.
It's time for the final exercise.
}
/*さあ、話は終わりだ。
そろそろ最後の演習を行なって
もらおうか。*/
大佐_027: {
Raiden, take Solidus down.
}
/*ライデン、ソリダスを倒せ。*/
ライデン_028: {
Think again! I'm through
doing what I'm told!
}
/*もう貴様らの言いなりにはならない！！*/
大佐_029: {
Oh really? Aren't you
forgetting something?
}
/*それはどうかな？
思い出せ。*/
オルガ_030: {
If you die, my child dies.
}
/*あなたが死ぬと、私の子供も死ぬように
プログラムされている。*/
大佐_031: {
The termination of vital signals
from your nanomachines means
the death of Olga's child.
}
/*ナノマシンから発信されている＃｛ＶＳ、ヴァイタル・サイン｝＃が
途絶えることは、オルガの子供が死ぬ
ことを意味する。*/
大佐_032: {
Not to mention the death of Rose.
She's wired the same way.
}
/*それだけではないぞ。君の大事な
ローズ君にも同じ仕掛けがしてある。*/
ライデン_033: {
Rose -- does she actually exist?
}
/*ローズは実在するのか！？*/
ローズ_034: {
Of course I do, Jack!
You have to beLIEve me!
}
/*もちろんよ、ジャック！
信じて！*/
ライデン_035: {
Damn...
}
/*くそ……。*/
大佐_036: {
It will be a fight to the death.
}
/*君達は殺し合う事になる。*/
ローズ_037: {
Solidus, at least, wants you dead.
}
/*少なくともソリダスはあなたを
殺したがっているわよ？*/
大佐_038: {
We will collect the necessary data
from this last fight, then we'll
consider the exercise closed.
}
/*君達の最後の戦いをデータとして
収集し……今回の演習は幕を閉じる。*/
大佐_039: {
So, Jack the Ripper!
}
/*それでは、＃｛切り裂きジャック、ジャック・ザ・リッパー｝＃！*/
大佐_040: {
Will it be Solidus,
the Patriots' creation?
}
/*『＃｛愛国者達、われわれ｝＃』が作ったソリダスか？*/
大佐_041: {
Or you -- Solidus' creation?
}
/*ソリダスが作った貴様か？*/
大佐_042: {
Our beloved monsters --
enjoy yourselves.
}
/*我々の愛しい怪物達よ……
せいぜい楽しむがいい。*/
}
//d






