if( selecting == yes ){
	getsearch;
	#first = yes;
}
#win = findhidemaru("HTAGS");
if( #win == -1 ){
	readonlyopenfile "HTAGS";
	#win = findhidemaru("HTAGS");
}
setactivehidemaru #win;
if( #first == yes ){
	gofiletop;
}
finddown;
if( result == yes ){
	tagjump;
} else {
	setactivehidemaru #my;
}
