//###################################################################################
//									 プリスキン　的設定
//###################################################################################

//////////////////////////
//	ブレード５面用
//////////////////////////

	//	スタート処理
	proc プリスキン的スタート処理 {
		mesg ＶＲ的共通 移動的:01 移動開始
	}

	//	破壊時処理
	proc プリスキン的破壊処理 {
		if ($1 == 移動的:01) {
			mesg ＶＲ的共通 移動的:02 移動開始
			mesg ＶＲ的共通 移動的:03 移動開始
			mesg ＶＲ的共通 移動的:04 移動開始
			mesg ＶＲ的共通 移動的:05 移動開始
			mesg ＶＲ的共通 移動的:06 移動開始
			mesg ＶＲ的共通 移動的:07 移動開始
			mesg ＶＲ的共通 移動的:08 移動開始
			mesg ＶＲ的共通 移動的:09 移動開始
			mesg ＶＲ的共通 移動的:10 移動開始
			mesg ＶＲ的共通 移動的:11 移動開始
			mesg ＶＲ的共通 移動的:12 移動開始

			mesg ＶＲ的共通 移動的:13 移動開始
			mesg ＶＲ的共通 移動的:14 移動開始
			mesg ＶＲ的共通 移動的:15 移動開始

			mesg ＶＲ的共通 移動的:16 移動開始
			mesg ＶＲ的共通 移動的:17 移動開始

		} else if ( ($1 == 移動的:02) || ($1 == 移動的:03) || ($1 == 移動的:04) || \
					($1 == 移動的:05) || ($1 == 移動的:06) || ($1 == 移動的:07) || \
					($1 == 移動的:08) || ($1 == 移動的:09) || ($1 == 移動的:10) || \
					($1 == 移動的:11) || ($1 == 移動的:12) || ($1 == 移動的:13) || \
					($1 == 移動的:14) || ($1 == 移動的:15) || ($1 == 移動的:16) || \
					($1 == 移動的:17) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 16) {
				mesg ＶＲ的共通 移動的:18 移動開始	/*	NG	*/
				mesg ＶＲ的共通 移動的:19 移動開始	/*	NG	*/
				mesg ＶＲ的共通 移動的:20 移動開始	/*	NG	*/
				mesg ＶＲ的共通 移動的:21 移動開始	/*	NG	*/

				mesg ＶＲ的共通 移動的:22 移動開始
				mesg ＶＲ的共通 移動的:23 移動開始
				mesg ＶＲ的共通 移動的:24 移動開始
				mesg ＶＲ的共通 移動的:25 移動開始

				eval ($$i:的起動フラグ = 0)
			}

		} else if ( ($1 == 移動的:22) || ($1 == 移動的:23) || ($1 == 移動的:24) || \
					($1 == 移動的:25) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 4) {
				mesg ＶＲ的共通 移動的:26 移動開始
				mesg ＶＲ的共通 移動的:27 移動開始

				eval ($$i:的起動フラグ = 0)
			}

		} else if ( ($1 == 移動的:26) || ($1 == 移動的:27) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 2) {
				mesg ＶＲ的共通 移動的:28 移動開始
				mesg ＶＲ的共通 移動的:29 移動開始
				mesg ＶＲ的共通 移動的:30 移動開始

				mesg ＶＲ的共通 移動的:31 移動開始
				mesg ＶＲ的共通 移動的:32 移動開始

				mesg ＶＲ的共通 移動的:33 移動開始

				mesg ＶＲ的共通 移動的:34 移動開始

				mesg ＶＲ的共通 移動的:35 移動開始

				mesg ＶＲ的共通 移動的:36 移動開始

				eval ($$i:的起動フラグ = 0)
			}

		} else if ( ($1 == 移動的:28) || ($1 == 移動的:29) || ($1 == 移動的:30) || \
					($1 == 移動的:31) || ($1 == 移動的:32) || ($1 == 移動的:33) || \
					($1 == 移動的:34) || ($1 == 移動的:35) || ($1 == 移動的:36) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 9) {
				mesg ＶＲ的共通 移動的:37 移動開始
				mesg ＶＲ的共通 移動的:38 移動開始

				mesg ＶＲ的共通 移動的:39 移動開始
				mesg ＶＲ的共通 移動的:40 移動開始

				mesg ＶＲ的共通 移動的:41 移動開始

				mesg ＶＲ的共通 移動的:42 移動開始

				eval ($$i:的起動フラグ = 0)
			}

		} else if ( ($1 == 移動的:37) || ($1 == 移動的:38) || ($1 == 移動的:39) || \
					($1 == 移動的:40) || ($1 == 移動的:41) || ($1 == 移動的:42) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 6) {
				mesg ＶＲ的共通 移動的:43 移動開始	/*	NG	*/

				mesg ＶＲ的共通 移動的:44 移動開始
				mesg ＶＲ的共通 移動的:45 移動開始

				mesg ＶＲ的共通 移動的:46 移動開始

				mesg ＶＲ的共通 移動的:47 移動開始

				mesg ＶＲ的共通 移動的:48 移動開始

				eval ($$i:的起動フラグ = 0)
			}

		} else if ( ($1 == 移動的:44) || ($1 == 移動的:45) || ($1 == 移動的:46) || \
					($1 == 移動的:47) || ($1 == 移動的:48) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 5) {
				mesg ＶＲ的共通 移動的:49 移動開始

				mesg ＶＲ的共通 移動的:50 移動開始	/*	NG	*/

				mesg ＶＲ的共通 移動的:51 移動開始
				mesg ＶＲ的共通 移動的:52 移動開始
				mesg ＶＲ的共通 移動的:53 移動開始
				mesg ＶＲ的共通 移動的:54 移動開始
				mesg ＶＲ的共通 移動的:55 移動開始
				mesg ＶＲ的共通 移動的:56 移動開始

				eval ($$i:的起動フラグ = 0)
			}

		}

	}

	//	ゴール処理
	proc プリスキン的ゴール処理 {
		//	ＮＧ的を消す
		mesg ＶＲ的共通 移動的:18 消滅
		mesg ＶＲ的共通 移動的:19 消滅
		mesg ＶＲ的共通 移動的:20 消滅
		mesg ＶＲ的共通 移動的:21 消滅

		mesg ＶＲ的共通 移動的:43 消滅

		mesg ＶＲ的共通 移動的:50 消滅
	}

	//	ルート変更
	proc プリスキン的ルート変更１ {
		print '############################################ROUTE_CHANGE1'
		mesg ＶＲ移動的 移動的:22 即ルートノード変更 d:５面的ルート:移部屋２＿４ 0

		mesg ＶＲ移動的 移動的:23 即ルートノード変更 d:５面的ルート:移部屋２＿５ 0
		mesg ＶＲ移動的 移動的:24 即ルートノード変更 d:５面的ルート:移部屋２＿６ 0
		mesg ＶＲ移動的 移動的:25 即ルートノード変更 d:５面的ルート:移部屋２＿７ 0
	}
	proc プリスキン的ルート変更２ {
		print '############################################ROUTE_CHANGE2'
		mesg ＶＲ移動的 移動的:22 即ルートノード変更 d:５面的ルート:移部屋２＿４ 1
		mesg ＶＲ移動的 移動的:23 即ルートノード変更 d:５面的ルート:移部屋２＿５ 1
		mesg ＶＲ移動的 移動的:24 即ルートノード変更 d:５面的ルート:移部屋２＿６ 1
		mesg ＶＲ移動的 移動的:25 即ルートノード変更 d:５面的ルート:移部屋２＿７ 1
	}

	//	的配置
	proc プリスキン的設定 {

	//	@ＶＲ標的基本設定 \
	//	$:p_名前 $:p_的ステータス $:p_ルート $:p_ノード $:p_破壊プロック $:p_初期方向 $:p_自転速度 $:p_的スピード

		//	ルーム１
		@ＶＲ標的基本設定 \
		移動的:01 $$i:的ステータス d:５面的ルート:移部屋１＿０ 0 p:武器訓練ブレード５面ＶＲ標的破壊処理 0 0 0

		@ＶＲ標的基本設定 \
		移動的:02 $$i:的ステータス d:５面的ルート:移部屋１＿１ 0 p:武器訓練ブレード５面ＶＲ標的破壊処理 0 0 0

		@ＶＲ標的基本設定 \
		移動的:03 $$i:的ステータス d:５面的ルート:移部屋１＿２ 0 p:武器訓練ブレード５面ＶＲ標的破壊処理 0 0 0

		@ＶＲ標的基本設定 \
		移動的:04 $$i:的ステータス d:５面的ルート:移部屋１＿３ 0 p:武器訓練ブレード５面ＶＲ標的破壊処理 0 0 0
		@ＶＲ標的基本設定 \
		移動的:05 $$i:的ステータス d:５面的ルート:移部屋１＿４ 0 p:武器訓練ブレード５面ＶＲ標的破壊処理 0 0 0

		@ＶＲ標的基本設定 \
		移動的:06 $$i:的ステータス d:５面的ルート:移部屋１＿５ 0 p:武器訓練ブレード５面ＶＲ標的破壊処理 0 0 0
		@ＶＲ標的基本設定 \
		移動的:07 $$i:的ステータス d:５面的ルート:移部屋１＿６ 0 p:武器訓練ブレード５面ＶＲ標的破壊処理 0 0 0
		@ＶＲ標的基本設定 \
		移動的:08 $$i:的ステータス d:５面的ルート:移部屋１＿７ 0 p:武器訓練ブレード５面ＶＲ標的破壊処理 0 0 0

		@ＶＲ標的基本設定 \
		移動的:09 $$i:的ステータス d:５面的ルート:移部屋１＿８ 0 p:武器訓練ブレード５面ＶＲ標的破壊処理 0 0 0
		@ＶＲ標的基本設定 \
		移動的:10 $$i:的ステータス d:５面的ルート:移部屋１＿９ 0 p:武器訓練ブレード５面ＶＲ標的破壊処理 0 0 0
		@ＶＲ標的基本設定 \
		移動的:11 $$i:的ステータス d:５面的ルート:移部屋１＿１０ 0 p:武器訓練ブレード５面ＶＲ標的破壊処理 0 0 0
		@ＶＲ標的基本設定 \
		移動的:12 $$i:的ステータス d:５面的ルート:移部屋１＿１１ 0 p:武器訓練ブレード５面ＶＲ標的破壊処理 0 0 0

		@ＶＲ標的基本設定 \
//		移動的:13 $$i:的ステータス d:５面的ルート:移部屋１＿１２ 0 p:武器訓練ブレード５面ＶＲ標的破壊処理 0 0 $$i:的スピード
		移動的:13 ($$i:的ステータス | d:VR_TRG_FLY_RAISE) d:５面的ルート:移部屋１＿１２ 0 p:武器訓練ブレード５面ＶＲ標的破壊処理 0 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:14 $$i:的ステータス d:５面的ルート:移部屋１＿１３ 0 p:武器訓練ブレード５面ＶＲ標的破壊処理 0 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:15 $$i:的ステータス d:５面的ルート:移部屋１＿１４ 0 p:武器訓練ブレード５面ＶＲ標的破壊処理 0 0 $$i:的スピード

