// ------------------------------------
// include
// ------------------------------------

#include "rai_wp75a.mh"		// 強制モーションリスト

#include "stdch.h"
#include "enevoice.h"
#include "a_stdproc.h"			// アナザーミッション設定ファイル
#include "sload.h"
#include "sound.h"
#include "item_info.h"
#include "ene_item.h"
#include "vr_common.h"		// ＶＲステージ共通で使用するプロック
#include "jump.h"
#include "varinit.h"

#if d:USB_KEY
	#include "usbkbd.h"
#endif

// ------------------------------------
// マップ設定
// ------------------------------------
chara マップ 武器訓練ブレード５面 -k d:KMS_NAME -h d:HZX_NAME,0 -l $s:ＶＲライトファイル名

command マップ設定 武器訓練ブレード５面 -set {
	// ローカルの初期化
	// ------------------------------------
	@ローカル変数初期化		// ローカルで使用する変数で初期化をする場合はここで

	// ＶＲで必要な基本プロックのセット(vr_common.hで定義)
	// サウンドの基本パック、ＶＲの基本システム、プレイヤー、ゴール等を設定します
	// ※このプロックを使用する時は「ＶＲクリア時処理」というプロックが必要です
	// ＶＲ共通プロックセット	$:スネークファイル $:雷電ファイル $:クリア条件フラグ
	//							$:ゴールＸ $:ゴールＹ $:ゴールＺ
	//	VR_GOAL_TARGET	/*的全滅でゴールが開く*/
	//	VR_GOAL_FREE	/*ゴールが最初から開いてる*/
	//	VR_GOAL_ENEMY	/*敵全滅でゴールが開く*/
	//	VR_GOAL_SNEAK	/*潜入モード中はゴールが開く*/
	//	VR_GOAL_TIME	/*タイマーがゼロになるとゴールが開く*/
	// ------------------------------------
	@ＶＲ共通プロックセット sna_wp75a rai_wp75a d:VR_GOAL_TARGET 0 2000 -55000

	// カメラ設定
	@カメラセット					// chara カメラとベースのカメラを設定

	// ＶＲウィンドウの設定
	// ------------------------------------
	@武器訓練ブレード５面ＶＲウィンドウ設定

//	@ＶＲクリア設定 $:ＮＥＸＴＳＴＡＧＥプロック $:ＴＲＹＡＧＡＩＮプロック $:ＥＸＩＴプロック
	@ＶＲクリア設定 p:load_select p:A_ＲＥＴＲＹプロック

	// ステージに引かれるライン
	// ------------------------------------
	@ＶＲアウトライン d:KMS_NAME d:TONBO_KMS_NAME d:LINE_KMS_NAME

	// 設定値を変更する場合は以下のプロック内で設定
	// ------------------------------------
	@設定値変更				// 敵兵や的のパラメータをステージ限定で変える時はここで
	@プラグイン設定			// プレイヤーのプラグインがいる時はここで

	// 的関係の設定
	// ------------------------------------
	@武器訓練ブレード５面ＶＲ標的設定				// ＶＲシステム起動後に呼ぶ

	// ＢＧＭの設定(プレイヤー→敵兵→BGMの順で呼ぶ。的の場合は関係ないがとりあえずここに)
	// ------------------------------------
	@ＢＧＭ設定

	// アイテムの設定
	// ------------------------------------
	@アイテム設定

	// 光源、オブジェクト、カメラ関連の設定
	// ------------------------------------
	@ＶＲフォグ設定 -8000 75000 -15000 70000 -10000 70000
	@武器訓練ブレード５面カメラ設定		// ステージ固有のカメラ設定がいる時はこのプロックで
	@ＶＲキャラ用ライト設置					// vr_common.hに定義。必ず最後に設定
#if d:DEBUG_CHARA
//	@デバッグキャラセット
#endif

	@ジャンプ設定
}

//初期マップの表示
command マップ表示 -show 武器訓練ブレード５面


//###################################################################################
//									各proc設定
//###################################################################################



//###################################################################################
//									全マップ共通
//###################################################################################
	// ------------------------------------
	// 全マップ共通
	// ------------------------------------
	// ------------------------------------
	// クリア時の処理
	// ------------------------------------
	proc ＶＲクリア時処理 {
		#if d:DEBUG_PRINT
			print 'clear'
		#endif

		//	ＮＧ的を消す
		@武器訓練ブレード５面ＶＲ標的ゴール処理

		// 強制モーションを発動
		@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_2 0

		// クリア時にカメラアングルを変える
		chara カメラ設定 カットインカメラ \
			-c 1 \
//			-p -398,3428,-51308 -t -398,2998,-55964 \
//			-r 60,2048,0 -f 4675 \
//			-a 200 \
			-p -350,3239,-50873 -t -350,3044,-55118 \
			-r 30,2048,0 -f 4249 \
			-a 200 \
			-i 1 1 0 0 \
			-s 1

	}



	// ------------------------------------
	// パラメータ系の変更
	// ------------------------------------
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT
			print 'localvar_init'
		#endif

		//	的フラグを初期化する
		eval ($$i:的起動フラグ = 0)

		//	的ステータスを初期化する
		eval ($$i:的基本ステータス = 0);
		eval ($$i:的ステータス = 0)

		//	的スピードを初期化する
		eval ($$i:的スピード = 0)
		eval ($$i:的スピードＡ = 0)

		//	的セット数を初期化する
		eval ($$b:的セット数 = 0);

	}
	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT
			print 'status_set'
		#endif

		// 初期装備の設定
		/*	@ＶＲ共通プロックセット内で設定	*/

	}
	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif

		/*	@ＶＲ共通プロックセット内で設定	*/

	}



//###################################################################################
//									 総合　的設定
//###################################################################################

//////////////////////////
//	基本的プロック
//////////////////////////

	// 移動的プロック
	// ------------------------------------
	proc ＶＲ標的基本設定 \
	$:p_名前 $:p_的ステータス $:p_ルート $:p_ノード $:p_破壊プロック $:p_初期方向 $:p_自転速度 $:p_的スピード {

		//	点滅用処理
		@点滅割り振り設定 $:p_名前

		//	プリスキンかタキシードスネークのＮＧ的は点滅周期が違う
		if( ($s:選択プレイヤー == プリスキン) || \
			($s:選択プレイヤー == タキシードスネーク) && \
			($:p_的ステータス & d:VR_TRG_NG) ) {
			chara	ＶＲ移動的 $:p_名前 \
				-flag ($$i:的基本ステータス | $:p_的ステータス) \
				-route $:p_ルート $:p_ノード \
				-c $:p_破壊プロック \
				-dir $:p_初期方向 $:p_自転速度 \
				-v 120 120 \
				-speed $:p_的スピード

		//	それ以外は
		} else {
			chara	ＶＲ移動的 $:p_名前 \
				-flag ($$i:的基本ステータス | $:p_的ステータス) \
				-route $:p_ルート $:p_ノード \
				-c $:p_破壊プロック \
				-dir $:p_初期方向 $:p_自転速度 \
				-speed $:p_的スピード
		
		}

	}

	proc ＶＲ標的基本設定（方向指定つき） \
	$:p_名前 $:p_的ステータス $:p_ルート $:p_ノード $:p_破壊プロック $:p_初期方向 $:p_自転速度 $:p_指定方向 $:p_的スピード {

		//	点滅用処理
		@点滅割り振り設定 $:p_名前

		//	プリスキンかタキシードスネークのＮＧ的は点滅周期が違う
		if( ($s:選択プレイヤー == プリスキン) || \
			($s:選択プレイヤー == タキシードスネーク) && \
			($:p_的ステータス & d:VR_TRG_NG) ) {
			chara	ＶＲ移動的 $:p_名前 \
				-flag ($$i:的基本ステータス | $:p_的ステータス) \
				-route $:p_ルート $:p_ノード \
				-c $:p_破壊プロック \
				-dir $:p_初期方向 $:p_自転速度 \
				-K $:p_指定方向 \
				-v 120 120 \
				-speed $:p_的スピード

		//	それ以外は
		} else {
			chara	ＶＲ移動的 $:p_名前 \
				-flag ($$i:的基本ステータス | $:p_的ステータス) \
				-route $:p_ルート $:p_ノード \
				-c $:p_破壊プロック \
				-dir $:p_初期方向 $:p_自転速度 \
				-K $:p_指定方向 \
				-speed $:p_的スピード
		}

	}

	proc ＶＲ標的基本設定（公転つき） \
	$:p_名前 $:p_的ステータス $:p_ルート $:p_ノード $:p_破壊プロック \
	$:p_公転速度 $:p_初期公転方向 $:p_公転半径 $:p_初期方向 $:p_自転速度 $:p_的スピード {

		//	点滅用処理
		@点滅割り振り設定 $:p_名前

		//	プリスキンかタキシードスネークのＮＧ的は点滅周期が違う
		if( ($s:選択プレイヤー == プリスキン) || \
			($s:選択プレイヤー == タキシードスネーク) && \
			($:p_的ステータス & d:VR_TRG_NG) ) {
			chara	ＶＲ移動的 $:p_名前 \
				-flag ($$i:的基本ステータス | $:p_的ステータス) \
				-route $:p_ルート $:p_ノード \
				-c $:p_破壊プロック \
				-kouten $:p_公転速度 $:p_初期公転方向 $:p_公転半径 \
				-dir $:p_初期方向 $:p_自転速度 \
				-v 120 120 \
				-speed $:p_的スピード

		//	それ以外は
		} else {
			chara	ＶＲ移動的 $:p_名前 \
				-flag ($$i:的基本ステータス | $:p_的ステータス) \
				-route $:p_ルート $:p_ノード \
				-c $:p_破壊プロック \
				-kouten $:p_公転速度 $:p_初期公転方向 $:p_公転半径 \
				-dir $:p_初期方向 $:p_自転速度 \
				-speed $:p_的スピード
		}

	}

	proc ＶＲ標的基本設定（ルートプロックつき） \
	$:p_名前 $:p_的ステータス $:p_ルート $:p_ノード $:p_破壊プロック \
	$:p_ルートプロック１ $:p_ルート１ $:p_ノード１ $:p_ルートプロック２ $:p_ルート２ $:p_ノード２ \
	$:p_初期方向 $:p_自転速度 $:p_的スピード {

		//	点滅用処理
		@点滅割り振り設定 $:p_名前

		//	プリスキンかタキシードスネークのＮＧ的は点滅周期が違う
		if( ($s:選択プレイヤー == プリスキン) || \
			($s:選択プレイヤー == タキシードスネーク) && \
			($:p_的ステータス & d:VR_TRG_NG) ) {
			chara	ＶＲ移動的 $:p_名前 \
				-flag ($$i:的基本ステータス | $:p_的ステータス) \
				-route $:p_ルート $:p_ノード \
				-c $:p_破壊プロック \
				-x	$:p_ルートプロック１ $:p_ルート１ $:p_ノード１ \
					$:p_ルートプロック２ $:p_ルート２ $:p_ノード２ \
				-dir $:p_初期方向 $:p_自転速度 \
				-v 120 120 \
				-speed $:p_的スピード

		//	それ以外は
		} else {
			chara	ＶＲ移動的 $:p_名前 \
				-flag ($$i:的基本ステータス | $:p_的ステータス) \
				-route $:p_ルート $:p_ノード \
				-c $:p_破壊プロック \
				-x	$:p_ルートプロック１ $:p_ルート１ $:p_ノード１ \
					$:p_ルートプロック２ $:p_ルート２ $:p_ノード２ \
				-dir $:p_初期方向 $:p_自転速度 \
				-speed $:p_的スピード
		}

	}

	proc ＶＲ標的基本設定（シフトつき） \
	$:p_名前 $:p_的ステータス $:p_ルート $:p_ノード $:p_破壊プロック $:p_シフトＸ $:p_シフトＹ $:p_シフトＺ $:p_初期方向 $:p_自転速度 $:p_的スピード {

		//	点滅用処理
		@点滅割り振り設定 $:p_名前

		//	プリスキンかタキシードスネークのＮＧ的は点滅周期が違う
		if( ($s:選択プレイヤー == プリスキン) || \
			($s:選択プレイヤー == タキシードスネーク) && \
			($:p_的ステータス & d:VR_TRG_NG) ) {
			chara	ＶＲ移動的 $:p_名前 \
				-flag ($$i:的基本ステータス | $:p_的ステータス | d:VR_TRG_ABSSHIFT) \	//	絶対座標シフト
				-route $:p_ルート $:p_ノード \
				-c $:p_破壊プロック \
				-yshift $:p_シフトＸ $:p_シフトＹ $:p_シフトＺ \
				-dir $:p_初期方向 $:p_自転速度 \
				-v 120 120 \
				-speed $:p_的スピード

		//	それ以外は
		} else {
			chara	ＶＲ移動的 $:p_名前 \
				-flag ($$i:的基本ステータス | $:p_的ステータス | d:VR_TRG_ABSSHIFT) \	//	絶対座標シフト
				-route $:p_ルート $:p_ノード \
				-c $:p_破壊プロック \
				-yshift $:p_シフトＸ $:p_シフトＹ $:p_シフトＺ \
				-dir $:p_初期方向 $:p_自転速度 \
				-speed $:p_的スピード
		}

	}


//////////////////////////
//	点滅割り振り設定
//////////////////////////
	proc 点滅割り振り設定 $:p_名前 {
		//	プリスキンかタキシードスネークは、点滅する
		if( ($s:選択プレイヤー == プリスキン) || \
			($s:選択プレイヤー == タキシードスネーク) ) {
			//	的セット数をカウントする
			$$b:的セット数 = $$b:的セット数 + 1;

			@ブレード５面点滅割り振り設定 $:p_名前

		//	そのほかのキャラは点滅しない
		} else {
			eval ($$i:的基本ステータス = $$i:的基本ステータス)
		}

	}

	//	基本点滅割り振り設定
	proc 基本点滅割り振り設定 {
		//	奇数ならば（＝的セット数が割り切れなければ）、消え状態からスタート
		if( $$b:的セット数 % 2 ) {
			eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)

		//	偶数ならば（＝的セット数が割り切れれば）、点き状態からスタート
		} else {
			eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
		}
	}

	//	ブレード５面例外的措置
	proc ブレード５面点滅割り振り設定 $:p_名前 {
		//	プリスキンの場合
		if ($s:選択プレイヤー == プリスキン) {
			//	セット１
			if ( ($:p_名前 == 移動的:04) || ($:p_名前 == 移動的:05) ) {
					eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ( ($:p_名前 == 移動的:06) || ($:p_名前 == 移動的:07) || \
						($:p_名前 == 移動的:08) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ( ($:p_名前 == 移動的:09) || ($:p_名前 == 移動的:10) || \
						($:p_名前 == 移動的:11) || ($:p_名前 == 移動的:12) ) {
					eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ( ($:p_名前 == 移動的:16) || ($:p_名前 == 移動的:17) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			//	セット２
			} else if ($:p_名前 == 移動的:19) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ($:p_名前 == 移動的:20) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			} else if ($:p_名前 == 移動的:22) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ($:p_名前 == 移動的:24) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			//	追加
			} else if ($:p_名前 == 移動的:31) {
					eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)

			//	セット３
			} else if ( ($:p_名前 == 移動的:37) || ($:p_名前 == 移動的:38) ) {
					eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ($:p_名前 == 移動的:41) {
					eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ( ($:p_名前 == 移動的:39) || ($:p_名前 == 移動的:42) ) {
					eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)

			//	セット４
			} else if ($:p_名前 == 移動的:49) {
					eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ($:p_名前 == 移動的:50) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ( ($:p_名前 == 移動的:52) || ($:p_名前 == 移動的:53) ) {
					eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ( ($:p_名前 == 移動的:54) || ($:p_名前 == 移動的:55) || \
						($:p_名前 == 移動的:56) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			//	移動的:43～移動的:48は
			} else if ( ($$b:的セット数 >= 43) && ($$b:的セット数 <= 48) ) {
				@基本点滅割り振り設定

			//	それ以外の的は
			} else {
				//	奇数ならば（＝的セット数が割り切れなければ）、点き状態からスタート
				if( $$b:的セット数 % 2 ) {
					eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

				//	偶数ならば（＝的セット数が割り切れれば）、消え状態からスタート
				} else {
					eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
				}
			}

		//	タキシードは
		} else {
			if ($:p_名前 == 移動的:01) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			//	セット１
			} else if ($:p_名前 == 移動的:03) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ( ($:p_名前 == 移動的:04) || ($:p_名前 == 移動的:05) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ( ($:p_名前 == 移動的:06) || ($:p_名前 == 移動的:07) || \
						($:p_名前 == 移動的:08) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)

			//	セット２
			} else if ($:p_名前 == 移動的:09) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ( ($:p_名前 == 移動的:10) || ($:p_名前 == 移動的:11) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ( ($:p_名前 == 移動的:12) || ($:p_名前 == 移動的:13) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)

			//	セット３
			} else if ($:p_名前 == 移動的:14) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ($:p_名前 == 移動的:15) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ($:p_名前 == 移動的:16) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ($:p_名前 == 移動的:17) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)

			//	セット４
			} else if ($:p_名前 == 移動的:18) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ( ($:p_名前 == 移動的:19) || ($:p_名前 == 移動的:20) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ( ($:p_名前 == 移動的:21) || ($:p_名前 == 移動的:22) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)

			//	セット５
			//	移動的:23～移動的:27は
			} else if ( ($$b:的セット数 >= 23) && ($$b:的セット数 <= 27) ) {
				//	奇数ならば（＝的セット数が割り切れなければ）、点き状態からスタート
				if( $$b:的セット数 % 2 ) {
					eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

				//	偶数ならば（＝的セット数が割り切れれば）、消え状態からスタート
				} else {
					eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
				}

			//	セット６
			} else if ($:p_名前 == 移動的:35) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ( ($:p_名前 == 移動的:36) || ($:p_名前 == 移動的:37) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ( ($:p_名前 == 移動的:38) || ($:p_名前 == 移動的:39) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ($:p_名前 == 移動的:40) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ( ($:p_名前 == 移動的:41) || ($:p_名前 == 移動的:42) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ( ($:p_名前 == 移動的:43) || ($:p_名前 == 移動的:44) || \
						($:p_名前 == 移動的:45) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			//	それ以外の的は
			} else {
				@基本点滅割り振り設定
			}
		}

	}


//////////////////////////
//	ブレード５面用
//////////////////////////

	//	スタート処理
	// ------------------------------------
	proc 武器訓練ブレード５面ＶＲ標的スタート処理 {
		//	ライデンを選択
		if ($s:選択プレイヤー == ライデン) {
			@ライデン的スタート処理

		//	スネークを選択
		} else if ($s:選択プレイヤー == スネーク) {
			@スネーク的スタート処理

		//	プリスキンを選択
		} else if ($s:選択プレイヤー == プリスキン) {
			@プリスキン的スタート処理

		//	タキシードスネークを選択（スネークとコンパチ）
		} else if ($s:選択プレイヤー == タキシードスネーク) {
			@スネーク的スタート処理

		//	前作スネークを選択
		} else if ($s:選択プレイヤー == 前作スネーク) {
			@前作スネーク的スタート処理

		//	忍者を選択
		} else if ($s:選択プレイヤー == 刀ライデン) {
			@忍者的スタート処理
		}

	}

	// 破壊時処理
	// ------------------------------------
	proc 武器訓練ブレード５面ＶＲ標的破壊処理 {
		//	ライデンを選択
		if ($s:選択プレイヤー == ライデン) {
			@ライデン的破壊処理 $1

		//	スネークを選択
		} else if ($s:選択プレイヤー == スネーク) {
			@スネーク的破壊処理 $1

		//	プリスキンを選択
		} else if ($s:選択プレイヤー == プリスキン) {
			@プリスキン的破壊処理 $1

		//	タキシードスネークを選択（スネークとコンパチ）
		} else if ($s:選択プレイヤー == タキシードスネーク) {
			@スネーク的破壊処理 $1

		//	前作スネークを選択
		} else if ($s:選択プレイヤー == 前作スネーク) {
			@前作スネーク的破壊処理 $1

		//	忍者を選択
		} else if ($s:選択プレイヤー == 刀ライデン) {
			@忍者的破壊処理 $1
		}

	}

	// ゴール処理
	// ------------------------------------
	proc 武器訓練ブレード５面ＶＲ標的ゴール処理 {
		//	ライデンを選択
		if ($s:選択プレイヤー == ライデン) {
			@ライデン的ゴール処理

		//	スネークを選択
		} else if ($s:選択プレイヤー == スネーク) {
			@スネーク的ゴール処理

		//	プリスキンを選択
		} else if ($s:選択プレイヤー == プリスキン) {
			@プリスキン的ゴール処理

		//	タキシードスネークを選択（スネークとコンパチ）
		} else if ($s:選択プレイヤー == タキシードスネーク) {
			@スネーク的ゴール処理

		//	前作スネークを選択
		} else if ($s:選択プレイヤー == 前作スネーク) {
			@前作スネーク的ゴール処理

		//	忍者を選択
		} else if ($s:選択プレイヤー == 刀ライデン) {
			@忍者的ゴール処理
		}

	}

	// 的配置
	// ------------------------------------
	proc 武器訓練ブレード５面ＶＲ標的設定 {
		eval ($$i:的ステータス = ($$i:的ステータス | d:VR_TRG_KATANA | d:VR_TRG_WAIT | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST) )
//		eval ($$i:的ステータス = ($$i:的ステータス | d:VR_TRG_KATANA | d:VR_TRG_WAIT | d:VR_TRG_FL_MARK | d:VR_TRG_DEBUG ))
		eval ($$i:的スピード = 30)
		eval ($$i:的スピードＡ = 40)

		//	ライデンを選択
		if ($s:選択プレイヤー == ライデン) {
			@ライデン的設定

		//	スネークを選択
		} else if ($s:選択プレイヤー == スネーク) {
			@スネーク的設定

		//	プリスキンを選択
		} else if ($s:選択プレイヤー == プリスキン) {
			@プリスキン的設定

		//	タキシードスネークを選択（スネークとコンパチ）
		} else if ($s:選択プレイヤー == タキシードスネーク) {
			@スネーク的設定

		//	前作スネークを選択
		} else if ($s:選択プレイヤー == 前作スネーク) {
			@前作スネーク的設定

		//	忍者を選択
		} else if ($s:選択プレイヤー == 刀ライデン) {
			@忍者的設定
		}

	}



//###################################################################################
//									 ライデン　的設定
//###################################################################################

//////////////////////////
//	ブレード５面用
//////////////////////////

	//	スタート処理
	proc ライデン的スタート処理 {
		mesg ＶＲ的共通 移動的:01 移動開始
	}

	//	破壊時処理
	proc ライデン的破壊処理 {
		if ($1 == 移動的:01) {
			mesg ＶＲ的共通 移動的:02 移動開始
			mesg ＶＲ的共通 移動的:03 移動開始
			mesg ＶＲ的共通 移動的:04 移動開始
			mesg ＶＲ的共通 移動的:05 移動開始
			mesg ＶＲ的共通 移動的:06 移動開始
			mesg ＶＲ的共通 移動的:07 移動開始
			mesg ＶＲ的共通 移動的:08 移動開始
			mesg ＶＲ的共通 移動的:09 移動開始
			mesg ＶＲ的共通 移動的:10 移動開始
			mesg ＶＲ的共通 移動的:11 移動開始
			mesg ＶＲ的共通 移動的:12 移動開始

			mesg ＶＲ的共通 移動的:13 移動開始
			mesg ＶＲ的共通 移動的:14 移動開始
			mesg ＶＲ的共通 移動的:15 移動開始

			mesg ＶＲ的共通 移動的:16 移動開始
			mesg ＶＲ的共通 移動的:17 移動開始

		} else if ( ($1 == 移動的:02) || ($1 == 移動的:03) || ($1 == 移動的:04) || \
					($1 == 移動的:05) || ($1 == 移動的:06) || ($1 == 移動的:07) || \
					($1 == 移動的:08) || ($1 == 移動的:09) || ($1 == 移動的:10) || \
					($1 == 移動的:11) || ($1 == 移動的:12) || ($1 == 移動的:13) || \
					($1 == 移動的:14) || ($1 == 移動的:15) || ($1 == 移動的:16) || \
					($1 == 移動的:17) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 16) {
				mesg ＶＲ的共通 移動的:18 移動開始	/*	NG	*/
				mesg ＶＲ的共通 移動的:19 移動開始	/*	NG	*/
				mesg ＶＲ的共通 移動的:20 移動開始	/*	NG	*/
				mesg ＶＲ的共通 移動的:21 移動開始	/*	NG	*/

				mesg ＶＲ的共通 移動的:22 移動開始
				mesg ＶＲ的共通 移動的:23 移動開始
				mesg ＶＲ的共通 移動的:24 移動開始
				mesg ＶＲ的共通 移動的:25 移動開始

				eval ($$i:的起動フラグ = 0)
			}

		} else if ( ($1 == 移動的:22) || ($1 == 移動的:23) || ($1 == 移動的:24) || \
					($1 == 移動的:25) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 4) {
				mesg ＶＲ的共通 移動的:26 移動開始
				mesg ＶＲ的共通 移動的:27 移動開始

				eval ($$i:的起動フラグ = 0)
			}

		} else if ( ($1 == 移動的:26) || ($1 == 移動的:27) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 2) {
				mesg ＶＲ的共通 移動的:28 移動開始
				mesg ＶＲ的共通 移動的:29 移動開始
				mesg ＶＲ的共通 移動的:30 移動開始

				mesg ＶＲ的共通 移動的:31 移動開始
				mesg ＶＲ的共通 移動的:32 移動開始

				mesg ＶＲ的共通 移動的:33 移動開始

				mesg ＶＲ的共通 移動的:34 移動開始

				mesg ＶＲ的共通 移動的:35 移動開始

				mesg ＶＲ的共通 移動的:36 移動開始

				eval ($$i:的起動フラグ = 0)
			}

		} else if ( ($1 == 移動的:28) || ($1 == 移動的:29) || ($1 == 移動的:30) || \
					($1 == 移動的:31) || ($1 == 移動的:32) || ($1 == 移動的:33) || \
					($1 == 移動的:34) || ($1 == 移動的:35) || ($1 == 移動的:36) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 9) {
				mesg ＶＲ的共通 移動的:37 移動開始
				mesg ＶＲ的共通 移動的:38 移動開始

				mesg ＶＲ的共通 移動的:39 移動開始
				mesg ＶＲ的共通 移動的:40 移動開始

				mesg ＶＲ的共通 移動的:41 移動開始

				mesg ＶＲ的共通 移動的:42 移動開始

				eval ($$i:的起動フラグ = 0)
			}

		} else if ( ($1 == 移動的:37) || ($1 == 移動的:38) || ($1 == 移動的:39) || \
					($1 == 移動的:40) || ($1 == 移動的:41) || ($1 == 移動的:42) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 6) {
				mesg ＶＲ的共通 移動的:43 移動開始	/*	NG	*/

				mesg ＶＲ的共通 移動的:44 移動開始
				mesg ＶＲ的共通 移動的:45 移動開始

				mesg ＶＲ的共通 移動的:46 移動開始

				mesg ＶＲ的共通 移動的:47 移動開始

				mesg ＶＲ的共通 移動的:48 移動開始

				eval ($$i:的起動フラグ = 0)
			}

		} else if ( ($1 == 移動的:44) || ($1 == 移動的:45) || ($1 == 移動的:46) || \
					($1 == 移動的:47) || ($1 == 移動的:48) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 5) {
				mesg ＶＲ的共通 移動的:49 移動開始

				mesg ＶＲ的共通 移動的:50 移動開始	/*	NG	*/

				mesg ＶＲ的共通 移動的:51 移動開始
				mesg ＶＲ的共通 移動的:52 移動開始
				mesg ＶＲ的共通 移動的:53 移動開始
				mesg ＶＲ的共通 移動的:54 移動開始
				mesg ＶＲ的共通 移動的:55 移動開始
				mesg ＶＲ的共通 移動的:56 移動開始

				eval ($$i:的起動フラグ = 0)
			}

		}

	}

	//	ゴール処理
	proc ライデン的ゴール処理 {
		//	ＮＧ的を消す
		mesg ＶＲ的共通 移動的:18 消滅
		mesg ＶＲ的共通 移動的:19 消滅
		mesg ＶＲ的共通 移動的:20 消滅
		mesg ＶＲ的共通 移動的:21 消滅

		mesg ＶＲ的共通 移動的:43 消滅

		mesg ＶＲ的共通 移動的:50 消滅
	}

	//	ルート変更
	proc ライデン的ルート変更１ {
		print '############################################ROUTE_CHANGE1'
		mesg ＶＲ移動的 移動的:22 即ルートノード変更 d:５面的ルート:移部屋２＿４ 0

		mesg ＶＲ移動的 移動的:23 即ルートノード変更 d:５面的ルート:移部屋２＿５ 0
		mesg ＶＲ移動的 移動的:24 即ルートノード変更 d:５面的ルート:移部屋２＿６ 0
		mesg ＶＲ移動的 移動的:25 即ルートノード変更 d:５面的ルート:移部屋２＿７ 0
	}
	proc ライデン的ルート変更２ {
		print '############################################ROUTE_CHANGE2'
		mesg ＶＲ移動的 移動的:22 即ルートノード変更 d:５面的ルート:移部屋２＿４ 1
		mesg ＶＲ移動的 移動的:23 即ルートノード変更 d:５面的ルート:移部屋２＿５ 1
		mesg ＶＲ移動的 移動的:24 即ルートノード変更 d:５面的ルート:移部屋２＿６ 1
		mesg ＶＲ移動的 移動的:25 即ルートノード変更 d:５面的ルート:移部屋２＿７ 1
	}

	//	的配置
	proc ライデン的設定 {

	//	@ＶＲ標的基本設定 \
	//	$:p_名前 $:p_的ステータス $:p_ルート $:p_ノード $:p_破壊プロック $:p_初期方向 $:p_自転速度 $:p_的スピード

		//	ルーム１
		@ＶＲ標的基本設定 \
		移動的:01 $$i:的ステータス d:５面的ルート:移部屋１＿０ 0 p:武器訓練ブレード５面ＶＲ標的破壊処理 0 0 0

		@ＶＲ標的基本設定 \
		移動的:02 $$i:的ステータス d:５面的ルート:移部屋１＿１ 0 p:武器訓練ブレード５面ＶＲ標的破壊処理 0 0 0
		@ＶＲ標的基本設定 \
		移動的:03 $$i:的ステータス d:５面的ルート:移部屋１＿２ 0 p:武器訓練ブレード５面ＶＲ標的破壊処理 0 0 0
		@ＶＲ標的基本設定 \
		移動的:04 $$i:的ステータス d:５面的ルート:移部屋１＿３ 0 p:武器訓練ブレード５面ＶＲ標的破壊処理 0 0 0
		@ＶＲ標的基本設定 \
		移動的:05 $$i:的ステータス d:５面的ルート:移部屋１＿４ 0 p:武器訓練ブレード５面ＶＲ標的破壊処理 0 0 0
		@ＶＲ標的基本設定 \
		移動的:06 $$i:的ステータス d:５面的ルート:移部屋１＿５ 0 p:武器訓練ブレード５面ＶＲ標的破壊処理 0 0 0
		@ＶＲ標的基本設定 \
		移動的:07 $$i:的ステータス d:５面的ルート:移部屋１＿６ 0 p:武器訓練ブレード５面ＶＲ標的破壊処理 0 0 0
		@ＶＲ標的基本設定 \
		移動的:08 $$i:的ステータス d:５面的ルート:移部屋１＿７ 0 p:武器訓練ブレード５面ＶＲ標的破壊処理 0 0 0
		@ＶＲ標的基本設定 \
		移動的:09 $$i:的ステータス d:５面的ルート:移部屋１＿８ 0 p:武器訓練ブレード５面ＶＲ標的破壊処理 0 0 0
		@ＶＲ標的基本設定 \
		移動的:10 $$i:的ステータス d:５面的ルート:移部屋１＿９ 0 p:武器訓練ブレード５面ＶＲ標的破壊処理 0 0 0
		@ＶＲ標的基本設定 \
		移動的:11 $$i:的ステータス d:５面的ルート:移部屋１＿１０ 0 p:武器訓練ブレード５面ＶＲ標的破壊処理 0 0 0
		@ＶＲ標的基本設定 \
		移動的:12 $$i:的ステータス d:５面的ルート:移部屋１＿１１ 0 p:武器訓練ブレード５面ＶＲ標的破壊処理 0 0 0

		@ＶＲ標的基本設定 \
		移動的:13 $$i:的ステータス d:５面的ルート:移部屋１＿１２ 0 p:武器訓練ブレード５面ＶＲ標的破壊処理 0 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:14 $$i:的ステータス d:５面的ルート:移部屋１＿１３ 0 p:武器訓練ブレード５面ＶＲ標的破壊処理 0 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:15 $$i:的ステータス d:５面的ルート:移部屋１＿１４ 0 p:武器訓練ブレード５面ＶＲ標的破壊処理 0 0 $$i:的スピード

		@ＶＲ標的基本設定 \
		移動的:16 $$i:的ステータス d:５面的ルート:移部屋１＿追０ 0 p:武器訓練ブレード５面ＶＲ標的破壊処理 0 0 0
		@ＶＲ標的基本設定 \
		移動的:17 $$i:的ステータス d:５面的ルート:移部屋１＿追１ 0 p:武器訓練ブレード５面ＶＲ標的破壊処理 0 0 0

	//	@ＶＲ標的基本設定（ルートプロックつき） \
	//	$:p_名前 $:p_的ステータス $:p_ルート $:p_ノード $:p_破壊プロック \
	//	$:p_ルートプロック１ $:p_ルート１ $:p_ノード１ $:p_ルートプロック２ $:p_ルート２ $:p_ノード２ \
	//	$:p_初期方向 $:p_自転速度 $:p_的スピード

		//	ルーム２
		@ＶＲ標的基本設定（ルートプロックつき） \
		移動的:18 ($$i:的ステータス | d:VR_TRG_NG) d:５面的ルート:移部屋２＿０ 1 p:武器訓練ブレード５面ＶＲ標的破壊処理 \
		p:ライデン的ルート変更１ d:５面的ルート:移部屋２＿０ 0 p:ライデン的ルート変更２ d:５面的ルート:移部屋２＿０ 1 \
		0 0 $$i:的スピード
		@ＶＲ標的基本設定（ルートプロックつき） \
		移動的:19 ($$i:的ステータス | d:VR_TRG_NG) d:５面的ルート:移部屋２＿１ 1 p:武器訓練ブレード５面ＶＲ標的破壊処理 \
		p:ライデン的ルート変更１ d:５面的ルート:移部屋２＿１ 0 p:ライデン的ルート変更２ d:５面的ルート:移部屋２＿１ 1 \
		0 0 $$i:的スピード
		@ＶＲ標的基本設定（ルートプロックつき） \
		移動的:20 ($$i:的ステータス | d:VR_TRG_NG) d:５面的ルート:移部屋２＿２ 1 p:武器訓練ブレード５面ＶＲ標的破壊処理 \
		p:ライデン的ルート変更１ d:５面的ルート:移部屋２＿２ 0 p:ライデン的ルート変更２ d:５面的ルート:移部屋２＿２ 1 \
