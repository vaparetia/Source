					巡回兵:a3,{0,0,d:居眠り},{0,2048,0 },	$b:w04_船倉兵モデル番号[14],	101, 2, 0x0010 \
					//犠牲兵,{10500,-9000,-11500},{0,3072,0 },	$b:w04_船倉兵モデル番号[14],	101, 2, 0x0010 \
