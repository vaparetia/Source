//###################################################################################
//								船倉３演説ボリューム制御
//###################################################################################


	proc 船倉３演説ボリューム制御 {

		trap ev2000 d:PLAYER \
			-mask いる \
			-exec {
				%ゲット船倉兵座標 スコット $i:スコットＸ座標 $i:スコットＹ座標 $i:スコットＺ座標
//				print 'スコット座標'$i:スコットＸ座標 $i:スコットＹ座標 $i:スコットＺ座標
				@船倉演説ボリューム制御 1 $i:スコットＸ座標 $i:スコットＹ座標 $i:スコットＺ座標 0 0 0
			}

	}








