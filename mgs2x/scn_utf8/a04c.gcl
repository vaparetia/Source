//###################################################################################
//									チェーン設定
//###################################################################################

	proc チェーン設定{

//２Ｆ外周
		chara ロープモデル２ チェーン１ \
			-n w02a_chain \
			-x 10020,-8000,-13520 \
			-r 0,1024,0 \
			-s 50 \
			-m 200 \
			-k 2000 \
			-d 0

		chara ロープモデル２ チェーン２ \
			-n w02a_chain \
			-x -10020,-8000,-13520 \
			-r 0,1024,0 \
			-s 50 \
			-m 200 \
			-k 2000 \
			-d 0

//演説台
		chara ロープモデル２ チェーン３ \
			-n w02a_chain \
			-x 6970,-13750,-13520 \
			-r 0,1024,0 \
			-s 50 \
			-m 200 \
			-k 2000 \
			-d 0


		chara ロープモデル２ チェーン４ \
			-n w02a_chain \
			-x -6970,-13750,-13520 \
			-r 0,1024,0 \
			-s 50 \
			-m 200 \
			-k 2000 \
			-d 0

//昇降機
		chara ロープモデル２ チェーン５ \
			-n w02a_chain \
			-x 7000,-11000,-13520 \
			-r 0,1024,0 \
			-s 50 \
			-m 200 \
			-k 2000 \
			-d 0

		chara ロープモデル２ チェーン６ \
			-n w02a_chain \
			-x -7000,-11000,-13520 \
			-r 0,1024,0 \
			-s 50 \
			-m 200 \
			-k 2000 \
			-d 0

	}










//###################################################################################
//									オセロット設定
//###################################################################################


	proc オセロット設定 {

		print 'オセロット参上！！！'


		chara プットオブジェ たたずむオセロット \
			-m rev_stand_test \
			-r 0 100 0 \
			-p 8000 -15600 -19040 \
			-l w04c


		mesg プットオブジェ たたずむオセロット off

		trap ca341 d:PLAYER \
			-mask ＊ \
			-state d:TRP_STATE_SUBJECT \
			-exec{

				if($3 == 入る){
					eval($w:船倉オセロット見始めたカウント = 0)

					if(!$f:船倉たたずむオセロット見た && $w:武器 == d:武器:素手){
						eval($f:船倉オセロット登場させた = 1)
						print 'オセロット出現させます。'
						mesg プットオブジェ たたずむオセロット on

					}

				}else if($3 == いる){

					if( `command カメラ視界チェック -camera 0x03 \
						-bound (8000-200),-15600,(-19040-200) (8000+200),(-15600+2000),(-19040+200)` == 1){

						//オセロットを初めて見たと判定
						if($f:船倉オセロット登場させた && !$f:船倉たたずむオセロット見た){
							if($w:船倉オセロット見始めたカウント < 120){
								eval($w:船倉オセロット見始めたカウント = $w:船倉オセロット見始めたカウント + 1)

							}else{
								print '佇むオセロット発見！！！'
								eval($f:船倉たたずむオセロット見た = 1)
								eval($w:船倉オセロット見始めたカウント = 0)

							}

						//オセロットが消えてるのを認識して１回だけジングル
						}else if($f:船倉オセロット消えた && !$f:船倉オセロット消えたジングル鳴らした){

							if($w:船倉オセロット見始めたカウント < 120){
								eval($w:船倉オセロット見始めたカウント = $w:船倉オセロット見始めたカウント + 1)

							}else{
								print 'ジングルならしまーす。'
								eval($f:船倉オセロット消えたジングル鳴らした = 1)

								command StreamSetPan $i:STREAM_ID -v 0x10
								command セットサウンドコード -c d:se_code:SD_S_JINGLE01
								chara delay ジングルディレイ \
									-time 240 \
									-exec{
										command StreamSetPan $i:STREAM_ID -v 0x3F
									}



							}

						}

					}else{

						//オセロットを見た後、視界から外れた
						if($f:船倉たたずむオセロット見た){
							eval($f:船倉オセロット消えた = 1)

							print '視界外なのでオセロット消します。'
							eval($f:船倉オセロット登場させた = 0)
							mesg プットオブジェ たたずむオセロット off

						}


					}


				}else{

					//オセロットを見た後、主観を外した
					if($f:船倉たたずむオセロット見た){
						eval($f:船倉オセロット消えた = 1)
					}

					print '主観やめたのでオセロット消します。'
					eval($f:船倉オセロット登場させた = 0)
					mesg プットオブジェ たたずむオセロット off

				}



			}




	}







//###################################################################################
//									ぼかし設定
//###################################################################################

	// ぼかしセット
	// ------------------------------------
	proc ぼかしセット {
		chara 遠景ぼかし far_deforcus \
			-plane	4 \
			-near	6000 \
			-far	9000

		chara 近景ぼかし near_deforcus \
			-plane	3 \
			-near	0 \
			-far	3000


		@船倉敵兵発見ぼかし設定	//発見時カメラ用。w04.hにあります。

	}





//###################################################################################
//							第三船倉キャラクタ専用ライトセット
//###################################################################################

proc 第三船倉キャラクタ専用ライトセット {

	print 'キャラ平行光'

// キャラクタ専用ライト設置
	chara 環境光 環境光 \
		 -c 63,35,17

	chara 平行光 平行光 \
		 -c 205,119,70 \
		 -p -50,-100,-40
//		 -p 2,-100,-2

/*
// キャラクタ専用ライト設置
	chara 環境光 環境光 \
		 -c 24,91,94

	chara 平行光 平行光 \
		 -c 80,35,5 \
		 -d -50,-70,-50
*/
}




//###################################################################################
//							レーダーアタリチェンジ接続設定
//###################################################################################

	proc レーダーアタリチェンジ設定 {

		//すべり棒でチェンジされます。


		//２Ｆ
		if($i:プレイヤー初期Ｙ位置 >= -9000){
			command 追加ＨＺＸグループ登録 \
				-hzx_id 1 \
				-add_id 4


		//床下
		}else if($i:プレイヤー初期Ｙ位置 < -17000){
			command 追加ＨＺＸグループ登録 \
				-hzx_id 1 \
				-add_id 2

		//１Ｆ
		}else{
			command 追加ＨＺＸグループ登録 \
				-hzx_id 1 \
				-add_id 3

		}



	}


//###################################################################################
//									マップ接続設定
//###################################################################################

	proc ロードプロック {

		command セットサウンドコード -c d:SNG_FOUTS_S		//ＢＧＭフェードアウト

		if ($s:呼び出しプロック == mv_a04c_a04b_0) {
			// 一階 左
			@mv_a04c_a04b_0
		} else if ($s:呼び出しプロック == mv_a04c_a04b_1) {
			// 一階 右
			@mv_a04c_a04b_1
		} else if ($s:呼び出しプロック == mv_a04c_a04b_2) {
			// 二階 左
			@mv_a04c_a04b_2
		} else if ($s:呼び出しプロック == mv_a04c_a04b_3) {
			// 二階 右
			@mv_a04c_a04b_3

		} else if ($s:呼び出しプロック == mv_a04c_a04b_4) {
			// 地下
			@mv_a04c_a04b_4
		}
	}

	proc マップ接続{

//１Ｆ南東

		trap ld100 d:PLAYER -mask 入る\
			-exec{
				if(`%ゲームオーバーチェック` == 0 && $f:ロードチェックＯＮフラグ){
#ifdef d:CTDOWN_TIMER
					@ロード時船倉タイマー残時間ゲット
#endif
					@ロード時ストリームフェードアウト	//w04.hのなか

					preseek 'w04b'
					@ステージ終了時処理（ステージ名表示） 8000 -17000 2000 0 mv_a04c_a04b_0 d:DEFAULT_M_TYPE d:wn_第二船倉
				}
			}


//１Ｆ南西

		trap ld101 d:PLAYER -mask 入る\
			-exec{
				if(`%ゲームオーバーチェック` == 0 && $f:ロードチェックＯＮフラグ){
#ifdef d:CTDOWN_TIMER
					@ロード時船倉タイマー残時間ゲット
#endif
					@ロード時ストリームフェードアウト	//w04.hのなか

					preseek 'w04b'
					@ステージ終了時処理（ステージ名表示） -8000 -17000 2000 0 mv_a04c_a04b_1 d:DEFAULT_M_TYPE d:wn_第二船倉
				}
			}

//２Ｆ南東

		trap ld102 d:PLAYER -mask 入る\
			-exec{
				if(`%ゲームオーバーチェック` == 0 && $f:ロードチェックＯＮフラグ){
#ifdef d:CTDOWN_TIMER
					@ロード時船倉タイマー残時間ゲット
#endif
					@ロード時ストリームフェードアウト	//w04.hのなか

					preseek 'w04b'
					@ステージ終了時処理（ステージ名表示） 11000 -9000 2000 0 mv_a04c_a04b_2 d:DEFAULT_M_TYPE d:wn_第二船倉
				}
			}

//２Ｆ南西

		trap ld103 d:PLAYER -mask 入る\
			-exec{
				if(`%ゲームオーバーチェック` == 0 && $f:ロードチェックＯＮフラグ){
#ifdef d:CTDOWN_TIMER
					@ロード時船倉タイマー残時間ゲット
#endif
					@ロード時ストリームフェードアウト	//w04.hのなか

					preseek 'w04b'
					@ステージ終了時処理（ステージ名表示） -11000 -9000 2000 0 mv_a04c_a04b_3 d:DEFAULT_M_TYPE d:wn_第二船倉
				}
			}



		//地下

		trap ld200 d:PLAYER -mask 入る\
			-exec{
				if(`%ゲームオーバーチェック` == 0 && $f:ロードチェックＯＮフラグ){

					chara カメラ設定 サブカメラ１ \
						-c 1 \
						-p 348,-17027,-20736 \
						-t 375,-17148,-18484 \
						-a 200 \
						-i 2 0 0 0 \
						-s 1

#ifdef d:CTDOWN_TIMER
					@ロード時船倉タイマー残時間ゲット
#endif

print 'フェードアウト直前'
					@ロード時ストリームフェードアウト	//w04.hのなか

					preseek 'w04b'
					@ステージ終了時処理（ステージ名表示） 0 -17500 -13000 0 mv_a04c_a04b_4 d:DEFAULT_M_TYPE d:wn_第二船倉

				}

			}

/*

				command パッド操作 \
					-release

				chara カメラ設定 サブカメラ１ \
					-c 1 \
					-p 348,-17027,-20736 \
					-t 375,-17148,-18484 \
					-a 200 \
					-i 2 0 0 0 \
					-s $3

				command プラグイン強制移動

				mesg プレイヤー d:PLAYER run \
					8000 -17500 -13000 \
					3 \
					0 \
					d:FA_NO_WEAPON

				// 旧「フェード」廃止に伴う変更を行ないました（2000.11/6 岡嶋）
				chara フェードインアウト フェードアウト \
					-i 0 0 0 0 \		//設定するとこのＲＧＢαから始まる
					-c 0 0 0 128 \		//目標のＲＧＢα
					-t 120 \
					-p mv_w04c_w04b_4

*/


	}







//###################################################################################
//									ロード時進入設定
//###################################################################################


	proc 第３船倉ロード進入時処理{


		if($s:登場ポイント == タンカー編クリア許可リスタート){
			print '**************************** 1'
			chara フェードインアウト フェードイン \
				-i 0,0,0 128 \
				-c 0,0,0 0 \
				-t d:FADEIN_TIME

			mesg タイマー タイマー 表示切り替え 0

			@シナリオデモ開始処理
			@タンカークリアカメラ
			@タンカー編クリア前演説

		}else{
			print '**************************** 2'
			#if d:デバッグ演説スタート
				@船倉スコット演説スタート
			#else
				@演説実行
				@演説ストリーム再生チェック
			#endif

			if( $s:登場ポイント == デモ後 ){
				print '**************************** 3'
				@ロード時フェードイン

			}else if( $s:登場ポイント == 東１Ｆ ){
				print '**************************** 4'

				@ステージ開始時処理（ステージ名表示） \
					d:LOAD_TYPE:SL_DOOR_TYPE 右舷ドア２３ 1600 d:DEFAULT_M_TYPE \
					d:wn_第三船倉

			}else if( $s:登場ポイント == 西１Ｆ ){
				print '**************************** 5'

				@ステージ開始時処理（ステージ名表示） \
					d:LOAD_TYPE:SL_DOOR_TYPE 左舷ドア２３ 1600 d:DEFAULT_M_TYPE \
					d:wn_第三船倉

			}else if( $s:登場ポイント == 東２Ｆ ){
				print '**************************** 6'

				@ステージ開始時処理（ステージ名表示） \
					d:LOAD_TYPE:SL_DOOR_TYPE 右舷上部ドア２３ 1600 d:DEFAULT_M_TYPE \
					d:wn_第三船倉

			}else if( $s:登場ポイント == 西２Ｆ ){
				print '**************************** 7'

				@ステージ開始時処理（ステージ名表示） \
					d:LOAD_TYPE:SL_DOOR_TYPE 左舷上部ドア２３ 1600 d:DEFAULT_M_TYPE \
					d:wn_第三船倉

			}else if( $s:登場ポイント == ダクト ){
				print '**************************** 8'

				@ステージ開始時処理（ステージ名表示） \
					d:LOAD_TYPE:SL_DOOR_TYPE なし 1500 d:M_TYPE:CRAWL_CHANGE \
					d:wn_第三船倉

			}

		}

	}








