//###################################################################################
//							ムービー用パンカメラ設定
//###################################################################################


	enum ゲームオーバー敵兵モーションリスト {
		gbs_kamae = 0,
		gbs_walk,
		gbs_go
	}

#define	ゴル兵待機					10
#define	コマンダースタート			11
#define	ゴル兵すべり棒コース		20
#define	ゴル兵上コース				21


	proc ムービー用ゴル兵突入準備 {

		chara ルートデモ人形 指揮官兵 \
			-route d:ゴル兵待機 0 \
			-kms gbs_def \ /*EVMを表示する場合はダミーKMSが必要*/
			-mar gbs_w04c_movie \
			-weapon 1 \
			-number d:ゲームオーバー敵兵モーションリスト:gbs_walk




		chara ルートデモ人形 ゴル兵１ \
			-route d:ゴル兵待機 0 \
			-kms gbs_def \ /*EVMを表示する場合はダミーKMSが必要*/
			-mar gbs_w04c_movie \
			-weapon 1 \
			-number d:ゲームオーバー敵兵モーションリスト:gbs_walk



		chara ルートデモ人形 ゴル兵２ \
			-route d:ゴル兵待機 0 \
			-kms gbs_def \ /*EVMを表示する場合はダミーKMSが必要*/
			-mar gbs_w04c_movie \
			-weapon 1 \
			-number d:ゲームオーバー敵兵モーションリスト:gbs_walk

		chara ルートデモ人形 ゴル兵３ \
			-route d:ゴル兵待機 0 \
			-kms gbs_def \ /*EVMを表示する場合はダミーKMSが必要*/
			-mar gbs_w04c_movie \
			-weapon 1 \
			-number d:ゲームオーバー敵兵モーションリスト:gbs_walk


		chara ルートデモ人形 ゴル兵４ \
			-route d:ゴル兵待機 0 \
			-kms gbs_def \ /*EVMを表示する場合はダミーKMSが必要*/
			-mar gbs_w04c_movie \
			-weapon 1 \
			-number d:ゲームオーバー敵兵モーションリスト:gbs_walk





		chara プットモーションモデル すべり棒ゴル兵１ \
			-pos 12250,(-9000 + 525),(-22250 + 1250) \
			-dir 2048 \
			-kms gbs_def \
			-mar sna_w04c \
			-number  d:モーションリスト:non_pole_down_3f \ /*省略時０*/
//			-item	$s:装備モデル名 $i:関節番号 \ /*オブジェを付随*/
//			-C 網膜センサーおしつけられ終了 \	//$p:終了時プロック
			-status	(0x08|0x20|0x80)


		chara プットモーションモデル すべり棒ゴル兵２ \
			-pos 12250,(-9000 + 525),(-22250 + 1250) \
			-dir 2048 \
			-kms gbs_def \
			-mar sna_w04c \
			-number  d:モーションリスト:non_pole_down_3f \ /*省略時０*/
//			-item	$s:装備モデル名 $i:関節番号 \ /*オブジェを付随*/
//			-C 網膜センサーおしつけられ終了 \	//$p:終了時プロック
			-status	(0x08|0x20|0x80)




		trap ev002 ？ \
			-mask 入る \
			-exec {

				if($2 == ゴル兵１){
					mesg プットモーションモデル すべり棒ゴル兵１ 終了判定 d:モーションリスト:non_pole_down_3f
				}else if($2 == ゴル兵２){
					mesg プットモーションモデル すべり棒ゴル兵２ 終了判定 d:モーションリスト:non_pole_down_3f
				}

			}




	}



	proc ムービーゴル兵突撃開始 {

		mesg ルートデモ人形 指揮官兵 ルート変更 d:コマンダースタート

		chara delay ディレイ -time 180 -exec{
			mesg ルートデモ人形 ゴル兵１ ルート変更 d:ゴル兵すべり棒コース
			chara delay ディレイ -time 30 -exec{
				mesg ルートデモ人形 ゴル兵２ ルート変更 d:ゴル兵すべり棒コース
				chara delay ディレイ -time 34 -exec{
					mesg ルートデモ人形 ゴル兵３ ルート変更 d:ゴル兵上コース
					chara delay ディレイ -time 40 -exec{
						mesg ルートデモ人形 ゴル兵４ ルート変更 d:ゴル兵上コース
					}
				}
			}
		}





	}



	//メタルアップからズームアウト
	proc ムービー用カメラ７ {

		chara カメラ設定 パンカメラ \
			-c 1 \
			-p -3815,-13141,-3492 \
			-t -5078,-12148,-7277 \
			-a 280 \
			-i 0 0 0 0 \
			-s 1

		chara カメラ設定 パンカメラ \
			-c 1 \
			-p -3815,-13141,-3492 \
			-t -318,-12540,-5459 \
			-a 280 \
			-z d:CAMERA_INTERP_CAMERA \ // 補完カメラフラグを指定。
			-interp_time (60 * 30) \ // 補完時間を指定
			-s 1

		chara delay ディレイ -time (60*31) -exec{

			chara カメラ設定 パンカメラ \
				-c 1 \
				-p -3815,-13141,-3492 \
				-t -2256,-12706,-7272 \
				-a 280 \
				-z d:CAMERA_INTERP_CAMERA \ // 補完カメラフラグを指定。
				-interp_time (60 * 20) \ // 補完時間を指定
				-s 1


		}

	}



	proc ムービー用カメラ８ {

		mesg プットオブジェ たたずむオセロット on
		mesg プットオブジェ たたずむオセロット move 6500 -15500 -27200
		mesg プットオブジェ たたずむオセロット turn 0 3900 0


		chara カメラ設定 パンカメラ \
			-c 1 \
			-p 5287,-13058,-2119 \
			-t 6033,-12711,-6129 \
			-a 591 \
			-i 0 0 0 0 \
			-s 1

		chara カメラ設定 パンカメラ \
			-c 1 \
			-p 5287,-13058,-2119 \
			-t 2667,-12983,-5292 \
			-a 300 \
			-z d:CAMERA_INTERP_CAMERA \ // 補完カメラフラグを指定。
			-interp_time (60 * 20) \ // 補完時間を指定
			-s 1


		chara delay ディレイ -time (60*21) -exec{
			mesg プットオブジェ たたずむオセロット off

			chara カメラ設定 パンカメラ \
				-c 1 \
				-p 5287,-13058,-2119 \
				-t 6033,-13011,-6129 \
				-a 591 \
				-z d:CAMERA_INTERP_CAMERA \ // 補完カメラフラグを指定。
				-interp_time (60 * 20) \ // 補完時間を指定
				-s 1
		}


	}




	proc デバッグ設定 {
		//chara スクリーンショット scrshot
#ifndef d:FIX_MODE
		chara USBキーボード実行 keyboard \
			-e d:KPD_1 {
							// 一階 右
							mesg プレイヤー d:PLAYER position 9994 -15412 -1151
			} \
			-e d:KPD_2 {
							// 一階 左
							mesg プレイヤー d:PLAYER position -8812 -15413 -2378
			} \
			-e d:KPD_3 {
							// 二階 右
							mesg プレイヤー d:PLAYER position 11354 -7417 -2427
			} \
			-e d:KPD_4 {
							// 二階 左
							mesg プレイヤー d:PLAYER position -11354 -7417 -2427
			} \
			-e d:KPD_5 {
							// 二階 左
							mesg プレイヤー d:PLAYER position 0 -15961 -20088
			} \
			-e d:KBD_0	{ restart }
#endif
	}
