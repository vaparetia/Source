//###################################################################################
//									カメラ設定
//###################################################################################

	// カメラ設定
	// ------------------------------------
	proc カメラ設定 {
			chara カメラ ステージカメラ	-c 0 -l 3 -p 0
			chara カメラ サブカメラ１	-c 0 -l 2 -p 50
			chara カメラ サブカメラ２	-c 0 -l 2 -p 40
			chara カメラ サブカメラ３	-c 0 -l 2 -p 30
			chara カメラ サブカメラ４	-c 0 -l 2 -p 25
			chara カメラ ビヨンドカメラ	-c 0 -l 2 -p 20
			chara カメラ カットインカメラ -c 0 -l 0 -p 40



			// デフォルトカメラ
			chara カメラ設定 ステージカメラ \
				-c 0 \
				-b -9500,-32000,-6000 9500,-9600,-100 \
				-l -9500,-32000,-80750 9500,-100,-2000 \
				-r 640,2048,0 \
				-f 7000 \
				-a 200 \
				-i 2 -1 0 0 \
				-s 1

	}




//###################################################################################
//									船倉３カメラ設定
//###################################################################################


	proc 船倉３カメラ設定 {


//カメラ２階外周
		trap ca320 d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {
