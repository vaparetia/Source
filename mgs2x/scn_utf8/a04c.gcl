			-exec {
				mesg プレイヤー d:PLAYER shadow 1
			}


	}




//###################################################################################
//								船倉３デジカメ接続
//###################################################################################



	proc 船倉３デジカメ接続{


		if(!$f:電送端末接続したことある){
			chara プットオブジェ 端末画面 \
				-m w04c1_moni_off \
				-r 0 0 0 \
				-p 0 0 0 \
				-l w04c \
				-s 100 100 100
		}

		chara 画像転送端末 端末君 \
			-skin densou_main \
			-file t:photo


		trap ev005 d:PLAYER \
			-mask 入る \
			-button d:ACTION_BUTTON \
			-dir 2048,512 \
			-state d:TRP_STATE_STAND \
			-exec {

				if(`%ゲームオーバーチェック` == 0){
					command StreamPauseControl -channel 1 -on
						// -on, -off のどちらかを指定。onでPAUSE_ON

					eval($i:タイマーステータス = `%ゲットタイマーステータス`)
					command セットタイマーステータス -s d:TMR_WAIT

					@シナリオデモ開始処理

					command	強制モーション終了プロック \
						-motion d:モーションリスト:non_memory_card_w04c \
						-proc 船倉デジカメ接続終了

					mesg プレイヤー d:PLAYER motion \
						d:モーションリスト:non_memory_card_w04c \
						2048 \
						-1 \
						-1 \
						(d:FA_NO_CHECK_SEG | d:FA_NO_WEAPON | d:FA_NO_INTERP) \
						11750 -3700	//x,z,yの順

					if(!$f:電送端末接続したことある){
						chara delay ディレイ -time 123 -exec{
							mesg プットオブジェ 端末画面 off
						}
					}
				}

			}



		trap ev005 d:PLAYER \
			-mask ？ \
			-dir 2048,256 \
			-state d:TRP_STATE_FORCE \
			-exec {

				chara カメラ設定 ビヨンドカメラ \
					-c 1 \
					-p 10717,-15104,-2348 \
					-t 11937,-16126,-4434 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3

			}


	}



	proc 船倉デジカメ接続終了 {

		eval($b:タンカーデジカメ今何枚目 = 0)
		eval($i:船倉演説残り時間 = `%ゲット残りタイム`)

		if(`%ゲームオーバーチェック` == 0){
			command セットサウンドコード -c d:SNG_FOUTS_S		//ＢＧＭフェードアウト
			mesg タイマー タイマー 表示切り替え 0

			command 字幕制御 -hide
	#if 1
			command StreamPauseControl -channel 1 -on
				// -on, -off のどちらかを指定。onでPAUSE_ON
	#else
			command セットサウンドコード -c 0xFF00001D	//ストリーミング(CH2)、ポーズ ON
	#endif


			if($f:電送端末接続したことある){
				chara フェードインアウト フェードアウト \
					-i 0 0 0 0 \		//設定するとこのＲＧＢαから始まる
					-c 0 0 0 128 \		//目標のＲＧＢα
					-s 143 \			//プライオリティ
					-t 1

				chara delay ディレイ -time 10 -exec{
					if(`%ゲームオーバーチェック` == 0){
						command 転送端末起動 -call t:画像判定スタート -p 端末終了
					}
				}
			}else{

				//スネークごしからモニターアップへ
				chara カメラ設定 カットインカメラ \
					-c 1 \
					-p 12336,-14922,-1038 \
					-t 11786,-15645,-4912 \
					-a 200 \
					-i 0 0 0 0 \
					-s 1

				chara カメラ設定 カットインカメラ \
					-c 1 \
					-p 12336,-14922,-1038 \
					-t 11786,-15645,-4912 \
					-a 3500 \
					-i 3 -1 0 0 \
					-z d:CAMERA_INTERP_CAMERA \ //補完カメラフラグを指定。
					-interp_time 90 \ //補完時間を指定
					-s 1

				chara delay ディレイ -time 60 -exec{
					chara フェードインアウト フェードアウト \
						-i 0 0 0 0 \		//設定するとこのＲＧＢαから始まる
						-c 0 0 0 128 \		//目標のＲＧＢα
						-s 143 \			//プライオリティ
						-t 30
				}

				chara delay ディレイ -time 90 -exec{
					print '電送端末初めて！！！'

					chara delay ディレイ -time 1 -exec{
						if(`%ゲームオーバーチェック` == 0){
							command 転送端末起動 -call t:画像判定スタート -p 端末終了 -cold
						}
					}
				}

			}

		}

	}


	proc 端末終了 {
		print '端末終了プロック'

		if(`%ゲームオーバーチェック` == 0){

			eval($f:電送端末接続したことある = 1)
			command varsave $f:電送端末接続したことある

			if($f:タンカー編クリア許可 == 1){

				//eval( $w:武器 = d:武器:Ｍ９ )
				eval( $w:アイテム = d:アイテム:素手 )

				eval( $i:プレイヤー初期Ｘ位置 = 11750 ) ;
				eval( $i:プレイヤー初期Ｙ位置 = -17000 ) ;
				eval( $i:プレイヤー初期Ｚ位置 = -4000 ) ;
				eval( $i:プレイヤー初期方向 = 2100 ) ;
				eval( $s:登場ポイント = タンカー編クリア許可リスタート ) ;


				restart -save

			}else{

				chara フェードインアウト フェードイン \
					-i 0,0,0 128 \
					-c 0,0,0 0 \
					-t d:FADEIN_TIME


				command varsave $b:写真全然ＮＧだった回数
				command varsave $b:デジカメスコット評価回数
				command varsave $b:デジカメマッスル評価回数
				command varsave $b:デジカメレイブン評価回数
				command varsave $b:デジカメパンツ兵評価回数
				command varsave $b:デジカメカップルポスター評価回数
				command varsave $b:デジカメオルガ顔評価回数
				command varsave $b:デジカメ心霊写真評価回数
				command varsave $b:デジカメグラビアポスター評価回数
				command varsave $b:デジカメエロ雑誌評価回数
				command varsave $b:デジカメキレ気味カウンター

				command varsave $f:メタル正面撮影成功
				command varsave $f:メタル右側撮影成功
				command varsave $f:メタル左側撮影成功
				command varsave $f:メタルＭＡＲＩＮＥＳ撮影成功


				command	配列セット $w:タンカーデジカメ写真属性[0] {
					d:blank,d:blank,d:blank,d:blank,d:blank,
					d:blank,d:blank,
				}

				command foreach -argc 1 -repeat 6 \
					-data{ \
						{0},{1},{2},{3},{4},{5} \
					} \
					-exec{ \
						command タンカーカメラステータス初期化 \
							-f $1
						//デジカメ写真保持処理
						command varsave $w:タンカーデジカメ写真属性[$1]		//レジデントの写真はなくなっちゃったので
					}

				command varsave $i:タンカー編カメラステータス

				chara カメラ設定 カットインカメラ \
					-s -1
				mesg タイマー タイマー 表示切り替え 1
#if 1
				command StreamPauseControl -channel 1 -off
					// -on, -off のどちらかを指定。onでPAUSE_ON
#else
				command セットサウンドコード -c 0xFF00001E	//ストリーミング(Ch2)、ポーズ OFF
#endif
				command セットサウンドコード -c d:SNG_PLAY_05

				if(($i:タイマーステータス & d:TMR_WAIT) == 0){
					mesg タイマー タイマー 開始
				}

				@シナリオデモ終了処理
			}
		}



	}






	proc タンカークリアカメラ {

		//スネークごし
		chara カメラ設定 カットインカメラ \
			-c 1 \
			-p 12850,-16160,-3125 \
			-t 10041,-15510,-5866 \
			-a 200 \
			-i 0 0 0 0 \
			-s 1

		chara カメラ設定 カットインカメラ \
			-c 1 \
			-p 12918,-15346,-3014 \
			-t 9502,-14709,-4943 \
			-a 200 \
			-i 3 -1 0 0 \
			-z d:CAMERA_INTERP_CAMERA \ //補完カメラフラグを指定。
			-interp_time 300 \ //補完時間を指定
			-s 1


		//海兵隊後ろから
		chara delay ディレイ -time 300 -exec{
			chara カメラ設定 カットインカメラ \
				-c 1 \
				-p -362,-16043,-1041 \
				-t -397,-15055,-4883 \
				-a 200 \
				-i 0 0 0 0 \
				-s 1

			chara カメラ設定 カットインカメラ \
				-c 1 \
				-p -354,-15419,-882 \
				-t -396,-14437,-4725 \
				-a 200 \
				-i 3 -1 0 0 \
				-z d:CAMERA_INTERP_CAMERA \ //補完カメラフラグを指定。
				-interp_time 360 \ //補完時間を指定
				-s 1
		}
	}




	proc タンカー編クリア前演説 {
		print 'じゃあ、ここは一本〆で！！！'

		eval($f:ローカルフラグ１ = 0)

		chara デモキャンセルチェック デモキャンセル \
			-p タンカー編クリア前演説終了


		eval( $i:STREAM_ENDING_ID = `%Stream t:vc070130 -p タンカー編クリア前演説終了 -menustop -c 1 -ipu` );
		//スコット「....このメタルギアＲＡＹによって、我々海兵隊が新しい時代を切り開くのだ。以上、解散！！！」

		%StreamSetPan $i:STREAM_ENDING_ID -v 0x30
			// ストリームにパンとボリュームを設定する。
			// pan 0(左)-0x20(中)-0x3F(右), vol 0-0x3F

#if 1
		command StreamPauseControl -channel 1 -F
			// -on, -off のどちらかを指定。onでPAUSE_ON
#else
		command セットサウンドコード -c 0xFF00001E	//ストリーミング(Ch2)、ポーズ OFF
#endif

	}


	proc タンカー編クリア前演説終了 {

		mesg デモキャンセルチェック デモキャンセル kill

		if(!$f:ローカルフラグ１){
			eval($f:ローカルフラグ１ = 1)

			preseek 'd12t'
			chara フェードインアウト フェードアウト \
				-i 0 0 0 0 \		//設定するとこのＲＧＢαから始まる
				-c 0 0 0 128 \		//目標のＲＧＢα
				-t d:FADEOUT_TIME \
				-p タンカー編終了デモスタート
		}
	}







	proc タンカー編終了デモスタート{
		command セットサウンドコード -c d:STR2_FADE_OUT	//ストリーミングch.2のフェードアウト

		chara delay ディレイ \
			-time 1 \
			-exec {
				command セットサウンドコード -c d:SNG_FOUTS_S		//ＢＧＭフェードアウト
				load "d12t"
			}
	}







