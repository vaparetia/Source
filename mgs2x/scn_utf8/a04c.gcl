//###################################################################################
//						ストーリーフラグ & 強制無線 & ポリデモ再生
//###################################################################################
command マップ設定 通路２ 船倉３ -set {

// デモ環境かどうか。
#if d:MGS2_DEMO

// 不要プログラムの起動阻害
	eval($s:d_num = t11a1D)

chara デモアクトデバッグ demodebug  -i t:t11a1D -d 't00a2D' -l  -v 0  \
	-p  dummy_proc

#else


eval($w:t_story = d:ST_T11a1D船首メタルギア登場ポリゴンデモ開始)

if($w:t_story < d:ST_T11a1D船首メタルギア登場ポリゴンデモ開始) {

	eval($s:d_num = t11a1D)

	@シネマスクリーンセット
	chara デモキャンセルチェック デモキャンセル \
		-p demo_cancel

	@デモモデル差し替え処理
	// デモのパターン決定。登場ポイントとＴシンボルとの対応は仮（00.12.12現在）
	if( $s:登場ポイント == ダクト ) {
		chara demo デモ再生 \
			-i t:data_dummy \
	//		-i t:t11a1D \
			-p dummy_proc \
			-next t11a1D系終了
	} else if($s:登場ポイント == 東１Ｆ) {
		chara demo デモ再生 \
			-i t:data_dummy \
	//		-i t:t11a2D \
			-p dummy_proc \
			-next t11a1D系終了
	} else if($s:登場ポイント == 西１Ｆ) {
		chara demo デモ再生 \
			-i t:data_dummy \
	//		-i t:t11a3D \
			-p dummy_proc \
			-next t11a1D系終了
	} else if($s:登場ポイント == 東２Ｆ) {
		chara demo デモ再生 \
			-i t:data_dummy \
	//		-i t:t11a4D \
			-p dummy_proc \
			-next t11a1D系終了
	} else {
		chara demo デモ再生 \
			-i t:data_dummy \
	//		-i t:t11a5D \
			-p dummy_proc \
			-next t11a1D系終了
	}


// デモの時以外は、以下を通過する。
} else {

	eval($s:d_num = not_demo)

}

// ポリデモ以外の時セット
//if($s:d_num == not_demo) {

#endif

} // < 「command マップ設定 通路２ 船倉３」 の閉じカッコ


//###################################################################################
//									デモのみ仕様各種
//###################################################################################
// ダミープロック
proc dummy_proc {}

// デモキャンセル
proc demo_cancel {
	command StreamStopAll
}

// デモ終了時プロック
proc t11a1D系終了 {
	mesg デモキャンセルチェック デモキャンセル kill
	eval($w:t_story = d:ST_T11a1D船首メタルギア登場ポリゴンデモ終了)
	print '$w:t_story = d:ST_T11a1D船首メタルギア登場ポリゴンデモ終了'

	// リスタート後、ゲーム用の仕様をセットするためにフラグを戻す
	eval($s:d_num = not_demo)

	// デモ終了後のスネーク再セット位置
	if( $s:登場ポイント == ダクト ) {
		eval( $i:プレイヤー初期Ｘ位置 = 0 ) ;
		eval( $i:プレイヤー初期Ｙ位置 = -17500 ) ;
		eval( $i:プレイヤー初期Ｚ位置 = -18500-1000 ) ;
		eval( $i:プレイヤー初期方向 = 2048 ) ;
	} else if($s:登場ポイント == 東１Ｆ) {
		eval( $i:プレイヤー初期Ｘ位置 = 8000 ) ;
		eval( $i:プレイヤー初期Ｙ位置 = -17000 ) ;
		eval( $i:プレイヤー初期Ｚ位置 = 500-1000 ) ;
		eval( $i:プレイヤー初期方向 = 2048 ) ;
	} else if($s:登場ポイント == 西１Ｆ) {
		eval( $i:プレイヤー初期Ｘ位置 = -8000 ) ;
		eval( $i:プレイヤー初期Ｙ位置 = -17000 ) ;
		eval( $i:プレイヤー初期Ｚ位置 = 500-1000 ) ;
		eval( $i:プレイヤー初期方向 = 2048 ) ;
	} else if($s:登場ポイント == 東２Ｆ) {
		eval( $i:プレイヤー初期Ｘ位置 = 11000 ) ;
		eval( $i:プレイヤー初期Ｙ位置 = -9000 ) ;
		eval( $i:プレイヤー初期Ｚ位置 = 500-1000 ) ;
		eval( $i:プレイヤー初期方向 = 2048 ) ;
	} else {
		eval( $i:プレイヤー初期Ｘ位置 = -11000 ) ;
		eval( $i:プレイヤー初期Ｙ位置 = -9000 ) ;
		eval( $i:プレイヤー初期Ｚ位置 = 500-1000 ) ;
		eval( $i:プレイヤー初期方向 = 2048 ) ;
	}

	chara delay ディレイ \
		-time 1 \
		-exec{
			restart
		}
}

// シネマスクリーン
proc シネマスクリーンセット {
	chara シネマスクリーン シネマ \
		-top d:CINEMA_BELT_UPPER \
		-bottom d:CINEMA_BELT_LOWER \
		-ftime 30	//デフォルト値（ゼロは駄目）
	mesg シネマスクリーン シネマ フェードアウト 1
}



/******************************************************************************/
// 以下はゲーム用
/******************************************************************************/
command マップ設定 船倉３ 通路２ -set {
		// ポリデモ以外の時セット
		if($s:d_num == not_demo) {
			//@サウンドマネージャー設定
			//@常駐キャラ設定
			@エフェクト設定
			//@プレイヤー設定
			@はしご設定
			@カメラ設定
			@マップ接続
			//@船倉３エルード設定
			@演説音声小さめに	//w04.hの中
			#if d:SEALS_1_FG
				@船倉３演説ボリューム制御
			#endif

#if d:debug_timer
			@船倉タイマー演算

#endif
#if d:CTDOWN_TIMER
			@船倉タイマー起動
#endif
			@ドア設置／通路２－船倉３
		}
			@ぼかしセット
			@チェーン設定

}

command マップ設定 通路２ -set {
		// ポリデモ以外の時セット
		if($s:d_num == not_demo) {
			@船倉３カメラ設定	//ロード関連を変更したため
//			@通路２カメラ設定
		}
}
command マップ設定 船倉３ -set {
		// ポリデモ以外の時セット
		if($s:d_num == not_demo) {
			@船倉３カメラ設定
			@船倉３はしご設定
			@船倉３透明壁設定
			@船倉３すぺリ棒設定
			@船倉３デジカメ接続
			@オセロット設定
		}
		@メタルギア零設定

		@第三船倉キャラクタ専用ライトセット

		#if d:SEALS_1_FG
			@船倉３海兵隊セット
			@船倉物音カメラ		//w04.hの中
		#endif

		#if d:SNEEZE
			@船倉くしゃみ設定		//w04.hにある
		#endif

}

command マップ設定 船倉３ 通路２ -set {
		// ポリデモ以外の時セット
		if($s:d_num == not_demo) {
			//@サウンド設定
			//@タンカーデジカメ写真判定		//dcam_tanker.hの中にあります。
			//@タンカー編全体マップ設定 d:第三船倉マップ
			#if d:RADAR_HAZARD
				@レーダーアタリチェンジ設定
			#endif
			#if d:ムービー撮影用
				@ムービー用ゴル兵突入準備
			#endif
			@ポーズ時ステージ名表示設定 d:wn_第三船倉
		}
}

// 最後に行う設定
command マップ設定 船倉３ 通路２ -set {
	#if d:MY_DEBUG
		@デバッグ設定
	#endif
}

