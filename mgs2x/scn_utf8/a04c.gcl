					-a 200 \
					-i 2 -1 0 0 \
					-s $3


			}





//カメラ左階段
		trap ca311 d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {

				@CS_スムーズカメラ昇順 $6 -12000 -10000 1800 2049
				eval($i:補完ＲＸ = $i:CS_結果１)

				if($w:プレイヤー方向 > (4096-256) || $w:プレイヤー方向 < (256)){
					eval($w:補完距離  = 6000)
				} else {
					eval($w:補完距離  = 3000)
				}

				chara カメラ設定 サブカメラ１ \
					-c 0 \
					-b -32000,-16900,-32000 32000,32000,-7000 \
					-l -32000,-32000,-32000 32000,32000,32000 \
					-r -150,$i:補完ＲＸ,0 \
					-f $w:補完距離 \
					-a 200 \
					-i 3 3 0 0 \
					-s $3
			}

//カメラ右階段
		trap ca312 d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {

				@CS_スムーズカメラ昇順 $6 -12000 -10000 2300 2049
				eval($i:補完ＲＸ = $i:CS_結果１)

				if($w:プレイヤー方向 > (4096-256) || $w:プレイヤー方向 < (256)){
					eval($w:補完距離  = 6000)
				} else {
					eval($w:補完距離  = 3000)
				}

				chara カメラ設定 サブカメラ１ \
					-c 0 \
					-b -32000,-16900,-32000 32000,32000,-7000 \
					-l -32000,-32000,-32000 32000,32000,32000 \
					-r -150,$i:補完ＲＸ,0 \
					-f $w:補完距離 \
					-a 200 \
					-i 3 3 0 0 \
					-s $3
			}


//カメラ演説台上
		trap ca313 d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {

				@CS_スムーズカメラ昇順 $4 -14250 14250 1800 2300
				eval($i:補完ＲＸ = $i:CS_結果１)

				chara カメラ設定 サブカメラ１ \
					-c 0 \
					-b -32000,-17000,-80750 32000,-100,0 \
					-l -32000,-17000,-80750 32000,-100,0 \
					-r 76,$i:補完ＲＸ,0 \
					-f 4000 \
					-a 200 \
					-i 1 -1 0 0 \
					-s $3
				}



//カメラメタル台下

			trap ca330 d:PLAYER \
				-camera \
				-mask ＊ \
				-exec {

					if($4 <-2500){
						eval($i:補完ＢＸ１ = -5000)
						eval($i:補完ＢＸ２ = -3500)

					}else if($4 > 2500){
						eval($i:補完ＢＸ１ = 3500)
						eval($i:補完ＢＸ２ = 5000)

					}else{
						eval($i:補完ＢＸ１ = -1000)
						eval($i:補完ＢＸ２ = 1000)
					}

					chara カメラ設定 サブカメラ１ \
						-c 0 \
						-b $i:補完ＢＸ１,-17500,-80750 $i:補完ＢＸ２,-16000,-18500 \
						-l -5000,-17500,-80750 5000,-100,0 \
						-r 640,2048,0 \
						-f $w:補完距離 \
						-a 200 \
						-i 2 -1 0 0 \
						-s $3 \
						-E 1 30 \ 			//$f:スライドタイプ $w:スライド待ち時間 \
							10000 7000 \ 		//$i:スライド距離１ $i:スライド距離２ \
							50 				//$i:スライドスピード [$i:スライドフラグ]


				}


			trap ca331 d:PLAYER \
				-camera \
				-mask ＊ \
				-exec {

					chara カメラ設定 サブカメラ１ \
						-c 1 \
						-p $4,-15667,-17301 \
						-t $4,-17607,-21884 \
						-a 200 \
						-i 2 -1 0 0 \
						-s $3

				}


			//イントルード付近
			trap ca332 d:PLAYER \
				-camera \
				-mask ？ \
				-exec {

					chara カメラ設定 サブカメラ２ \
						-c 1 \
						-p 3942,-15875,-20613 \
						-t 5951,-17561,-27128 \
						-a 200 \
						-i 3 -1 0 0 \
						-s $3

				}





//右舷１Ｆドア付近
		trap dr300 d:PLAYER \
			-camera \
			-mask ？ \
			-exec {

				chara カメラ設定 サブカメラ２ \
					-c 1 \
					-p 7971,-12794,-329 \
					-t 7971,-14893,-555 \
					-a 153 \
					-i 2 2 0 0 \
					-s $3


			}




//左舷１Ｆドア付近
