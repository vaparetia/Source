		chara 透明壁 西側撮影班 \
			-position -6250 -15000 -2000 2000 \
			-4750 -15000 -2000 2000 \
			-attribute (d:HZX_SEG_NO_BULLET|d:HZX_SEG_NO_MISSILE|d:HZX_SEG_NO_C4|d:HZX_SEG_NO_RECOIL|d:HZX_SEG_NO_HARITSUKI|d:HZX_SEG_NO_DISP_RADAR|d:HZX_SEG_NO_BULLETHOLE|d:HZX_SEG_NO_SPRAY | d:HZX_SEG_NO_ENEMY_EYES)





