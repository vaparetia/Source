						[dogtag:tnk_w04c_guard_ea_03] [dogtag:tnk_w04c_guard_no_03] \
						[dogtag:tnk_w04c_guard_ha_03] [dogtag:tnk_w04c_guard_vh_03] \
					巡回兵:a2 ドッグタグ_敵兵 [dogtag:dummy] \
						[dogtag:dummy] [dogtag:dummy] \
						[dogtag:tnk_w04c_guard_ha_04] [dogtag:tnk_w04c_guard_vh_04]

			}






//巡回兵設定
			//右奥にいる奴が中央巡回開始
			trap ca310 巡回兵:a0 \
				-mask いる \
				-exec{

					if($i:プレイヤー位置Ｚ < -12000 && $b:w04c_巡回ルート == d:右舷警戒){
						mesg 船倉兵 巡回兵:a0 ルート変更 d:壇下警戒 d:右からスタート
						eval($b:w04c_巡回ルート = d:壇下警戒)
						print '$b:w04c_巡回ルート = d:壇下警戒'
					}


				}


			//左奥にいる奴が中央巡回開始
			trap ca306 巡回兵:a0 \
				-mask いる \
				-exec{

					if($i:プレイヤー位置Ｚ < -12000 && $b:w04c_巡回ルート == d:左舷警戒){
						mesg 船倉兵 巡回兵:a0 ルート変更 d:壇下警戒 d:左からスタート
						eval($b:w04c_巡回ルート = d:壇下警戒)
						print '$b:w04c_巡回ルート = d:壇下警戒'
					}


				}


			//壇下巡回時にスネークが手前にいたら、
			trap en000 巡回兵:a0 \
				-mask 入る \
				-exec{

					if(($i:プレイヤー位置Ｚ > -4500 || ($i:プレイヤー位置Ｘ < 0 && $i:プレイヤー位置Ｚ > -12000)) && $b:w04c_巡回ルート == d:壇下警戒){
						mesg 船倉兵 巡回兵:a0 ルート変更 d:右舷警戒 d:奥からスタート
						eval($b:w04c_巡回ルート = d:右舷警戒)
						print '$b:w04c_巡回ルート = d:右舷警戒'

					}

				}


			trap en001 巡回兵:a0 \
				-mask 入る \
				-exec{

					if(($i:プレイヤー位置Ｚ > -4500 || ($i:プレイヤー位置Ｘ > 0 && $i:プレイヤー位置Ｚ > -12000)) && $b:w04c_巡回ルート == d:壇下警戒){

						mesg 船倉兵 巡回兵:a0 ルート変更 d:左舷警戒 d:奥からスタート
						eval($b:w04c_巡回ルート = d:左舷警戒)
						print '$b:w04c_巡回ルート = d:左舷警戒'

					}

				}



			//スネークが写真をメタル正面の写真を撮っている場合
			//左舷
			trap en002 巡回兵:a0 \
				-mask 入る \
				-exec{

					if($i:プレイヤー位置Ｘ > -4750 && $i:プレイヤー位置Ｘ < 4750 && $i:プレイヤー位置Ｚ > -2500 && $b:w04c_巡回ルート == d:右舷警戒){
						mesg 船倉兵 巡回兵:a0 ルート変更 d:右舷手前警戒 0
						eval($b:w04c_巡回ルート = d:右舷手前警戒)
						print '$b:w04c_巡回ルート = d:右舷手前警戒'

						chara delay 巡回兵ディレイ -time 600 -exec{
							mesg 船倉兵 巡回兵:a0 ルート変更 d:右舷警戒 d:奥からスタート
							eval($b:w04c_巡回ルート = d:右舷警戒)
							print '$b:w04c_巡回ルート = d:右舷警戒'
						}

					}

				}


			//右舷
			trap en003 巡回兵:a0 \
				-mask 入る \
				-exec{

					if($i:プレイヤー位置Ｘ > -4750 && $i:プレイヤー位置Ｘ < 4750 && $i:プレイヤー位置Ｚ > -2500 && $b:w04c_巡回ルート == d:左舷警戒){
						mesg 船倉兵 巡回兵:a0 ルート変更 d:左舷手前警戒 0
						eval($b:w04c_巡回ルート = d:左舷手前警戒)
						print '$b:w04c_巡回ルート = d:左舷手前警戒'

						chara delay 巡回兵ディレイ -time 600 -exec{
							mesg 船倉兵 巡回兵:a0 ルート変更 d:左舷警戒 d:奥からスタート
							eval($b:w04c_巡回ルート = d:左舷警戒)
							print '$b:w04c_巡回ルート = d:左舷警戒'

						}


					}




				}











		}




	}







	proc 船倉３海兵隊セット {
		chara コマンダー 敵兵セット -w 	船倉３海兵隊 \
			-z $i:敵標準麻酔持続 \
			-o $i:敵標準気絶持続 \
			-s (d:ENE_STAGE_CROWD_PEOPLE | d:ENE_STAGE_NO_WC_GOVER) \
			-v [ene_tank_voice:01]
	}


//proc 敵兵発見は"w04.h"の中にあります。



	proc プロジェクタ１{
	}

	proc プロジェクタ２{
	}

//proc 船倉兵物音反応は"w04.h"の中にあります。





//proc 最初の一人発見は"w04.h"の中にあります。



//proc ライターのぞき発見は"w04.h"の中にあります。


	proc 左舷カメラが発見 {

		chara カメラ設定 カットインカメラ \
			-c 1 \
			-p -5421,-12924,-314 \
			-t -4905,-13554,-2247 \
			-a 113 \
			-i 2 0 0 0 \
			-s 1


	}

	proc 右舷カメラが発見 {
		chara カメラ設定 カットインカメラ \
			-c 1 \
			-p 5421,-12924,-314 \
			-t 4905,-13554,-2247 \
			-a 113 \
			-i 2 0 0 0 \
			-s 1


	}




	proc スコットを撃った {

		if(!$f:船倉最初に一人に発見された && `%ゲームオーバーチェック` == 0){
			command ゲームオーバー処理開始 -load -exec {

				eval($f:船倉最初に一人に発見された = 1)

				print 'スコットを撃ちよった！！！！'

				eval($i:船倉兵位置Ｘ = $1)
				eval($i:船倉兵位置Ｙ = $2)
				eval($i:船倉兵位置Ｚ = $3)

				print '$i:船倉兵位置Ｘ' $i:船倉兵位置Ｘ
				print '$i:船倉兵位置Ｙ' $i:船倉兵位置Ｙ
				print '$i:船倉兵位置Ｚ' $i:船倉兵位置Ｚ


				command StreamStopAll
				chara delay ディレイ -time 1 -exec{
					if(`%StreamIsPlay` == 0){
						if($i:プレイヤー位置Ｚ > -5000 || (`%abs $i:プレイヤー位置Ｘ` < 5000 && $i:プレイヤー位置Ｚ < -17000)){
							print '後ろに侵入者がいる！'
							eval( $i:STREAM_ID = `%Stream t:vc070113 -c 1 -ipu` );

						}else if($i:プレイヤー位置Ｘ > 0){
							print '右に侵入者がいる！'
							eval( $i:STREAM_ID = `%Stream t:vc070112 -c 1 -ipu` );

						}else{
							print '左に侵入者がいる！１回目'
							eval( $i:STREAM_ID = `%Stream t:vc070111 -c 1 -ipu` );
						}
						return 0
					}else{
						return 1
					}
				}

				chara デモキャンセルチェック ゲームオーバーデモキャンセル \
					-p 船倉ゲームオーバーデモキャンセル処理

				command セットタイマーステータス -s d:TMR_WAIT

				command メニュー設定 \
					-gage off \
					-radar off \
					-subwin off \
					-radio off \
					-pause off

				command 無線設定 -reset

				command パッド操作 \
					-release

				eval($i:カメラポジションＸ = (($i:船倉兵位置Ｘ * 10) + ($i:船倉兵位置Ｘ - $i:プレイヤー位置Ｘ) * 2)/10 )
				eval($i:カメラポジションＹ = (($i:船倉兵位置Ｙ * 10) + ($i:船倉兵位置Ｙ - $i:プレイヤー位置Ｙ) * 2)/10 )
				eval($i:カメラポジションＺ = (($i:船倉兵位置Ｚ * 10) + ($i:船倉兵位置Ｚ - $i:プレイヤー位置Ｚ) * 2)/10 )

				print '$i:カメラポジションＸ'$i:カメラポジションＸ
				print '$i:カメラポジションＹ'$i:カメラポジションＹ
				print '$i:カメラポジションＺ'$i:カメラポジションＺ


				chara カメラ設定 カットインカメラ \
					-c 1 \
					-p $i:カメラポジションＸ,-12000,$i:カメラポジションＺ \
					-t $i:プレイヤー位置Ｘ,$i:プレイヤー位置Ｙ,$i:プレイヤー位置Ｚ \
					-a 135 \
					-i 0 -1 0 0 \
					-s 1

		//ぼかし変化
				mesg 近景ぼかし near_deforcus off
				mesg 遠景ぼかし far_deforcus off
				mesg 遠景ぼかし 敵兵発見遠景ぼかし on

				chara delay ディレイ -time 30 -exec {

					chara カメラ設定 カットインカメラ \
						-c 1 \
						-p $i:カメラポジションＸ,-12000,$i:カメラポジションＺ \
						-t $i:プレイヤー位置Ｘ,$i:プレイヤー位置Ｙ,$i:プレイヤー位置Ｚ \
						-a 700 \
						-i 4 0 30 0 \
						-s 1

					mesg 遠景ぼかし 敵兵発見遠景ぼかし set (19 * 50) 0 40000 80000

					chara delay ディレイ \
						-time 20 \
						-exec {
							mesg 遠景ぼかし 敵兵発見遠景ぼかし off
						}

					mesg 近景ぼかし 敵兵発見近景ぼかし on

					chara delay ディレイ \
						-time 1 \
						-exec {
							mesg 近景ぼかし 敵兵発見近景ぼかし set (29 * 50) 0 1000 5000
						}

					chara delay ディレイ -time 150 -exec {
	/*
						chara カメラ設定 カットインカメラ \
							-s -1

						mesg 近景ぼかし 敵兵発見近景ぼかし off
						mesg 遠景ぼかし far_deforcus on
	*/

						@船倉敵兵発見ゲームオーバー

					}

				}

			}

		}


	}







//###################################################################################
//									ドア設定
//###################################################################################

	// ドアオブジェクト
	// ------------------------------------
	proc ドア設置／通路２－船倉３ {

//通路のアンビエントが違うため、マップ接合はいつもon
		mesg マップ接合 船倉接合４ on


		chara ドア 右舷ドア２３ \
			-m w04_dr \
			-d 0,2048,0 \
			-p 8750,-17000,50 \
			-slide 1600 \
			-time d:SD_OPEN_TIME \

			-exec {
/*
				if( $:開閉フラグ == 0 ){
					mesg マップ接合 船倉接合４ off
				} else {
					mesg マップ接合 船倉接合４ on
				}
*/
			}

		trap dr300 ？ -mask ？ \
			-exec {
				if ( $3 == 入る ) {
					mesg ドア 右舷ドア２３ open $2
				} else {
					mesg ドア 右舷ドア２３ close $2
				}
			}

		chara ドア 右舷ドア２３奥 \
