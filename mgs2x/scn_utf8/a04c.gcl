						eval($i:補完ＰＺ = $i:CS_結果１)

					}else if( $6 >= -27500 && $6 < -23500 ){
						@CS_スムーズカメラ昇順 $6 -27500 -23500 -26000 -25000
						eval($i:補完ＰＺ = $i:CS_結果１)

					}else if( $6 >= -23500 && $6 < -16500 ){
						@CS_スムーズカメラ昇順 $6 -23500 -16500 -22000 -18000
						eval($i:補完ＰＺ = $i:CS_結果１)

					}else if( $6 >= -16500 && $6 < -12500 ){
						@CS_スムーズカメラ昇順 $6 -16500 -12500 -15000 -14000
						eval($i:補完ＰＺ = $i:CS_結果１)

					}else if( $6 >= -12500 && $6 < -5500){
						@CS_スムーズカメラ昇順 $6 -12500 -5500 -11000 -7000
						eval($i:補完ＰＺ = $i:CS_結果１)

					}else{
						@CS_スムーズカメラ昇順 $6 -5500 0 -4000 0
						eval($i:補完ＰＺ = $i:CS_結果１)

					}

					//東
