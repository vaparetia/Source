//###################################################################################

	proc メタルギア零設定 {
		chara プットオブジェ MetalGear_Ray \
			-m ray_w04c1 \
			-r 0 0 0 \
			-p 0 0 0 \
			-l w04c \
			-s 100 100 100

		chara プットオブジェ MetalGear_Ray \
			-m ray_canopy_w04c1_mt \
			-r 0 0 0 \
			-p 0 0 0 \
			-l w04c \
			-s 100 100 100 \
			-f 1

	}














