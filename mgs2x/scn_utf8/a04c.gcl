					巡回兵:a3,{0,0,$b:w04c_巡回ルート},{0,2048,0 },	$b:w04_船倉兵モデル番号[14],	101, 2, 0x0010 \
					巡回兵:a2,{0,0,d:壇下警戒},{0,2048,0 },	$b:w04_船倉兵モデル番号[14],	101, 2, 0x0010 \
					巡回兵:a1,{-9000,-17000,-7500},{0,1300,0 },	$b:w04_船倉兵モデル番号[14],	101, 2, 0x0010 \
					犠牲兵,{11500,-9000,-4500},{0,2900,0 },	$b:w04_船倉兵モデル番号[14],	101, 2, 0x0010 \
				} \
				#include "w04c_seals_param.h"
				-j	犠牲兵 ドッグタグ_敵兵 [dogtag:tnk_w04c_guard_ve_01] \
