	//メタルパン左→右
	proc ムービー用カメラ１ {

		chara カメラ設定 パンカメラ \
			-c 1 \
			-p -4850,-13512,-2670 \
			-t -5365,-13047,-4660 \
			-a 190 \
			-i 0 0 0 0 \
			-s 1

