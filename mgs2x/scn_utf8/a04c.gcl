//									スコット設定
//###################################################################################

	//使用されていません
	proc スコット設定 {
		chara プットモーションモデル スコットさん \
				-pos 0, -13710, -11000 \
				-dir 0 \
				-kms sna_def \
				-evm sco_standing \
				-mar sco \
				-number 0 \
				-item sco_hat 12
		chara 臨時顔アニメキャラ スコット顔キャラ -chara スコットさん
		mesg プットモーションモデル スコットさん モーション再生 0
		mesg 臨時顔アニメキャラ スコット顔キャラ 視線変更 0 0 0 -15656 -4707
	}























//###################################################################################
//									海兵隊設定
//###################################################################################


#define		右舷警戒		1
	#define		奥からスタート	4
#define		左舷警戒		3
#define		壇下警戒		2
	#define		右からスタート	0
	#define		左からスタート	15
#define		右舷手前警戒	4
#define		左舷手前警戒	5
#define		左舷往復		6
#define		壇下警戒２		7
#define		段下棒立ち		13
#define		居眠り			8


	proc 船倉３海兵隊 {

		if($s:登場ポイント == タンカー編クリア許可リスタート){
			eval( $i:ローカル変数Ｉ１ = 20000 );
			eval( $i:ローカル変数Ｉ２ = 20001 );
		}else{
			eval( $i:ローカル変数Ｉ１ = 2500 );
			eval( $i:ローカル変数Ｉ２ = 7000 );
		}

		if($w:ゲーム設定 == d:LEVEL_VERYEASY){
			if($f:w04c_哀れな海兵隊成仏){

				chara 船倉兵 SEALS_1 -a { \
					#include "w04c_seals_matrix.h"
					#include "w04c_seals_scot.h"
					巡回兵:a3,{0,0,d:居眠り},{0,2048,0 },	$b:w04_船倉兵モデル番号[14],	101, 2, 0x0010 \
				} \
				#include "w04c_seals_param.h"
				-j	巡回兵:a3 ドッグタグ_敵兵 [dogtag:tnk_w04c_guard_ve_02] \
						[dogtag:tnk_w04c_guard_ea_02] [dogtag:tnk_w04c_guard_no_02] \
						[dogtag:tnk_w04c_guard_ha_02] [dogtag:tnk_w04c_guard_vh_02] \

			}else{

				chara 船倉兵 SEALS_1 -a { \
					#include "w04c_seals_matrix.h"
					#include "w04c_seals_scot.h"
					巡回兵:a3,{0,0,d:居眠り},{0,2048,0 },	$b:w04_船倉兵モデル番号[14],	101, 2, 0x0010 \
					犠牲兵,{11500,-9000,-4500},{0,2900,0 },	$b:w04_船倉兵モデル番号[14],	101, 2, 0x0010 \
				} \
				#include "w04c_seals_param.h"
				-j	犠牲兵 ドッグタグ_敵兵 [dogtag:tnk_w04c_guard_ve_01] \
						[dogtag:tnk_w04c_guard_ea_01] [dogtag:tnk_w04c_guard_no_01] \
						[dogtag:tnk_w04c_guard_ha_01] [dogtag:tnk_w04c_guard_vh_01] \
					巡回兵:a3 ドッグタグ_敵兵 [dogtag:tnk_w04c_guard_ve_02] \
						[dogtag:tnk_w04c_guard_ea_02] [dogtag:tnk_w04c_guard_no_02] \
						[dogtag:tnk_w04c_guard_ha_02] [dogtag:tnk_w04c_guard_vh_02] \

			}

		}else if($w:ゲーム設定 == d:LEVEL_EASY){
			if($f:w04c_哀れな海兵隊成仏){

				chara 船倉兵 SEALS_1 -a { \
					#include "w04c_seals_matrix.h"
					#include "w04c_seals_scot.h"
					巡回兵:a3,{0,0,d:居眠り},{0,2048,0 },	$b:w04_船倉兵モデル番号[14],	101, 2, 0x0010 \
				} \
				#include "w04c_seals_param.h"
				-j	巡回兵:a3 ドッグタグ_敵兵 [dogtag:tnk_w04c_guard_ve_02] \
						[dogtag:tnk_w04c_guard_ea_02] [dogtag:tnk_w04c_guard_no_02] \
						[dogtag:tnk_w04c_guard_ha_02] [dogtag:tnk_w04c_guard_vh_02] \
					船倉兵:03 ドッグタグ_敵兵 [dogtag:dummy] \
						[dogtag:tnk_w04c_guard_ea_03] [dogtag:tnk_w04c_guard_no_03] \
						[dogtag:tnk_w04c_guard_ha_03] [dogtag:tnk_w04c_guard_vh_03] \

			}else{

				chara 船倉兵 SEALS_1 -a { \
					#include "w04c_seals_matrix.h"
					#include "w04c_seals_scot.h"
					巡回兵:a3,{0,0,d:居眠り},{0,2048,0 },	$b:w04_船倉兵モデル番号[14],	101, 2, 0x0010 \
					犠牲兵,{11500,-9000,-4500},{0,2900,0 },	$b:w04_船倉兵モデル番号[14],	101, 2, 0x0010 \
				} \
				#include "w04c_seals_param.h"
				-j	犠牲兵 ドッグタグ_敵兵 [dogtag:tnk_w04c_guard_ve_01] \
						[dogtag:tnk_w04c_guard_ea_01] [dogtag:tnk_w04c_guard_no_01] \
						[dogtag:tnk_w04c_guard_ha_01] [dogtag:tnk_w04c_guard_vh_01] \
					巡回兵:a3 ドッグタグ_敵兵 [dogtag:tnk_w04c_guard_ve_02] \
						[dogtag:tnk_w04c_guard_ea_02] [dogtag:tnk_w04c_guard_no_02] \
						[dogtag:tnk_w04c_guard_ha_02] [dogtag:tnk_w04c_guard_vh_02] \
					船倉兵:03 ドッグタグ_敵兵 [dogtag:dummy] \
						[dogtag:tnk_w04c_guard_ea_03] [dogtag:tnk_w04c_guard_no_03] \
						[dogtag:tnk_w04c_guard_ha_03] [dogtag:tnk_w04c_guard_vh_03] \
			}



		}else if($w:ゲーム設定 == d:LEVEL_NORMAL){
			if($f:w04c_哀れな海兵隊成仏){

				chara 船倉兵 SEALS_1 -a { \
					#include "w04c_seals_matrix.h"
					#include "w04c_seals_scot.h"
					巡回兵:a1,{-9000,-17000,-7500},{0,1300,0 },	$b:w04_船倉兵モデル番号[14],	101, 2, 0x0010 \
					//巡回兵:a2,{0,0,d:段下棒立ち},{0,2048,0 },	$b:w04_船倉兵モデル番号[14],	101, 2, 0x0010 \
					巡回兵:a3,{0,0,d:居眠り},{0,2048,0 },	$b:w04_船倉兵モデル番号[14],	101, 2, 0x0010 \
				} \
				#include "w04c_seals_param.h"
				-j	巡回兵:a3 ドッグタグ_敵兵 [dogtag:tnk_w04c_guard_ve_02] \
