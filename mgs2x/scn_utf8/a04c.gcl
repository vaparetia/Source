//									エフェクト設定
//###################################################################################

	// エフェクト設定
	// ------------------------------------
	proc エフェクト設定 {

		chara フォグ fog \
			-c 24 30 24 \
			-n 10000 \
			-f 50000


		chara シネマスクリーン シネマ \
			-top d:CINEMA_BELT_UPPER \
			-bottom d:CINEMA_BELT_LOWER \
			-ftime 30


	// 跳弾番号設定
	// ------------------------------------
		command 跳弾ノーマル -n 0
		command 跳弾ノーマル -n 1
		command 跳弾ノーマル -n 2
		command 跳弾ノーマル -n 3
		command 跳弾ノーマル -n 4
		command 弾痕ノーマル -n 0
		command 弾痕ノーマル -n 1
		command 弾痕ノーマル -n 2
		command 弾痕ノーマル -n 3
		command 弾痕ノーマル -n 4


	}

	// スコットおしゃべり
	proc スコットおしゃべり {
		chara delay delay1 -time   1 -exec { mesg 臨時顔アニメキャラ スコット顔キャラ モーション再生 sco_face_speech_a 20 }
		chara delay delay1 -time  10 -exec { mesg 臨時顔アニメキャラ スコット顔キャラ モーション再生 sco_face_speech_i 20 }
		chara delay delay1 -time  22 -exec { mesg 臨時顔アニメキャラ スコット顔キャラ モーション再生 sco_face_speech_e 20 }
		chara delay delay1 -time  31 -exec { mesg 臨時顔アニメキャラ スコット顔キャラ モーション再生 sco_face_speech_u 20 }
		chara delay delay1 -time  39 -exec { mesg 臨時顔アニメキャラ スコット顔キャラ モーション再生 sco_face_speech_o 20 }
		chara delay delay1 -time  50 -exec { mesg 臨時顔アニメキャラ スコット顔キャラ モーション再生 sco_face_speech_i 20 }
		chara delay delay1 -time  61 -exec { mesg 臨時顔アニメキャラ スコット顔キャラ モーション再生 sco_face_speech_e 20 }
		chara delay delay1 -time  70 -exec { mesg 臨時顔アニメキャラ スコット顔キャラ モーション再生 sco_face_speech_o 20 }
		chara delay delay1 -time  79 -exec { mesg 臨時顔アニメキャラ スコット顔キャラ モーション再生 sco_face_speech_i 20 }
		chara delay delay1 -time  92 -exec { mesg 臨時顔アニメキャラ スコット顔キャラ モーション再生 sco_face_speech_a 20 }
		chara delay delay1 -time 103 -exec { mesg 臨時顔アニメキャラ スコット顔キャラ モーション再生 sco_face_speech_e 20 }
		chara delay delay1 -time 110 -exec { mesg 臨時顔アニメキャラ スコット顔キャラ モーション再生 sco_face_speech_i 20 }
	}











