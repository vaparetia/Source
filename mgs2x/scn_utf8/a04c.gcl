//###################################################################################
//									プレイヤー設定
//###################################################################################


	// プレイヤー
	// ------------------------------------
	proc プレイヤー設定 {
print '200'

				if( $s:登場ポイント == ダクト ){
					eval( $b:プレイヤー初期状態 = 2 )

				}else{
					eval( $b:プレイヤー初期状態 = 0 )

				}

				chara プレイヤー d:PLAYER \
//					-p 9250,-17000,-73500 \	//地下
//					-p 13500,-17000,-20000 \	//地下はしご
//					-p 11000,-8500,-1000 \	//２階
					-p $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,$i:プレイヤー初期Ｚ位置 \
					-d 0,$i:プレイヤー初期方向,0 \
					-s $b:プレイヤー初期状態 \
					-i 0 \
//					-m gbs_def -a snake -o sna_w04c
					-m sna_def -a snake -o sna_w04c




print '201'
				//バンダナ
				chara ロープモデル３ バンダナ１ \
					-n sna_bdn1 \
					-d 1 \
					-y d:PLAYER \
					-z 12 \
					-x 0,60,-90 \
					-m 12 \
					-p 250 \
					-k 350 \
					-o 110 \
					-f 1

print '202'
				chara ロープモデル３ バンダナ２ \
					-n sna_bdn2 \
					-d 1 \
					-y d:PLAYER \
					-z 12 \
					-x 0,50,-90 \
					-m 22 \
					-p 250 \
					-k 350 \
					-o 110 \
					-f 1

print '203'
				//はしごモード追加
				command プラグインはしご
				command はしご設定 \
					-b 	d:モーションリスト:non_ladder_idle_loop,\
						d:モーションリスト:non_ladder_idle_loop_l,\
						d:モーションリスト:non_ladder_up_loop,\
						d:モーションリスト:non_ladder_down_loop
print '204'
			#if d:MULTI_MODEL
				chara マルチウェイトキャラ マルチ \
					-name d:PLAYER \
					-model sna_mmt

				chara 臨時顔アニメキャラ アニメキャラ \
					-chara	d:PLAYER
			#endif
print '205'

			//@プレイヤーＬＯＤ設定 d:P_STATE_TYPE d:TRP_STATE_BEHIND
			@プレイヤーＬＯＤ設定 d:C_DISTANCE_TYPE 6000

	}

	proc はしご設定 {
		//はしごモード追加
		command プラグインはしご
		command はしご設定 \
			-b 	d:モーションリスト:non_ladder_idle_loop,\
				d:モーションリスト:non_ladder_idle_loop_l,\
				d:モーションリスト:non_ladder_up_loop,\
				d:モーションリスト:non_ladder_down_loop
	}










//###################################################################################
//									すべり棒設定
//###################################################################################


	proc 船倉３すぺリ棒設定{



	//３Ｆから
		//左から
		trap ev001 d:PLAYER \
			-mask いる \
			-button d:ACTION_BUTTON \
			-dir 1024,512 \
			-state d:TRP_STATE_STAND \
			-exec {

				mesg プレイヤー d:PLAYER motion \
					d:モーションリスト:non_pole_down_3f \
					1024 \
					-1 \
					0 \
					(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_WEAPON) \
					(12250 - 1250) -22250 (-9000 + 1025)	//x,z,yの順


				command 追加ＨＺＸグループ削除 \
					-hzx_id 1 \
					-add_id 4

				command 追加ＨＺＸグループ登録 \
					-hzx_id 1 \
					-add_id 3


			}



		//手前から
		trap ev002 d:PLAYER \
			-mask いる \
			-button d:ACTION_BUTTON \
			-dir 2048,512 \
			-state d:TRP_STATE_STAND \
			-exec {

				mesg プレイヤー d:PLAYER motion \
					d:モーションリスト:non_pole_down_3f \
					2048 \
					-1 \
					0 \
					(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_WEAPON) \
					12250 (-22250 + 1250) (-9000 + 1025)	//x,z,yの順

				command 追加ＨＺＸグループ削除 \
					-hzx_id 1 \
					-add_id 4

				command 追加ＨＺＸグループ登録 \
					-hzx_id 1 \
					-add_id 3

			}

	//２Ｆから
		trap la340h d:PLAYER \
			-mask いる \
			-button d:ACTION_BUTTON \
			-dir 2048,512 \
			-state d:TRP_STATE_STAND \
			-exec {

				mesg プレイヤー d:PLAYER motion \
					d:モーションリスト:non_pole_down_2f \
					2048 \
					-1 \
					0 \
					(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_WEAPON) \
					12250 (-22250 + 1250) (-13000 + 1025)	//x,z,yの順

				command 追加ＨＺＸグループ削除 \
					-hzx_id 1 \
					-add_id 2

				command 追加ＨＺＸグループ登録 \
					-hzx_id 1 \
					-add_id 3

			}

//２Ｆから乗るときカメラ（降下は下！！）は外側はしご・上部用設定と同じです。







//降下時カメラ
		//後ろから
		trap ev004 d:PLAYER \
			-camera \
			-mask ＊ \
			-dir 2048,256 \
			-state d:TRP_STATE_FORCE \
			-exec {

				@CS_スムーズカメラ昇順 $5 -10000 -8000 12072 11257
				eval($i:補完ＰＸ = $i:CS_結果１)

				@CS_スムーズカメラ昇順 $5 -10000 -8000 -7412 -5816
				eval($i:補完ＰＹ = $i:CS_結果１)

				@CS_スムーズカメラ昇順 $5 -10000 -8000 -21673 -20029
				eval($i:補完ＰＺ = $i:CS_結果１)

				chara カメラ設定 ビヨンドカメラ \
					-c 1 \
					-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ \
					-t $4,$5,$6 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3


			}

		//左から
		trap ev004 d:PLAYER \
			-camera \
			-mask ＊ \
			-dir 1024,256 \
			-state d:TRP_STATE_FORCE \
			-exec {

				@CS_スムーズカメラ昇順 $5 -15000 -8000 200 414
				eval($w:補完画角 = $i:CS_結果１)


				chara カメラ設定 ビヨンドカメラ \
					-c 1 \
					-p 12385,-15481,-21659 \
					-t $4,$5,$6 \
					-a $w:補完画角 \
					-i 0 0 0 0 \
					-s $3


			}






	}








//###################################################################################
//									はしご設定
//###################################################################################

	//はしご設定
	// ------------------------------------

	proc 船倉３はしご設定 {

		//外側はしご・下部用設定
		//----------------------
		trap la340l d:PLAYER -mask いる -button d:ACTION_BUTTON -dir 2048,256 \
			-state d:TRP_STATE_STAND,d:TRP_STATE_LADDER \
			-exec {
				command はしご設定 \
					-l -16400,-12300 \
					-s d:モーションリスト:non_ladder_up_c_start	13730,-16440,-20350 2048 \
					-e d:モーションリスト:non_ladder_down_c_end	13730,-16000,-20350 -1
				mesg プレイヤー d:PLAYER ladder
			}

		//はしご上で下を押していたらおりる。
		trap la340l d:PLAYER -mask いる -dir 2048,256 \
			-state d:TRP_STATE_LADDER \
			-exec {

				command パッドチェック \
					-which 0 \
					-status		//押されている

				if( $status & d:PAD_D && $5 < -16000 ){

					command パッド操作 \
						-press d:PAD_X

				}
			}

		trap la340l d:PLAYER -mask ？ -state d:TRP_STATE_FORCE \
			-exec {
				chara カメラ設定 ビヨンドカメラ \
					-c 1 \
					-p 14090,-13910,-19184 \
					-t 13672,-16216,-20770 \
					-a 200 \
					-i 0 -1 0 0 \
					-s $3
			}


		//はしご影消去
		trap la340l d:PLAYER -mask いる \
			-state d:TRP_STATE_FORCE \
			-exec {
				mesg プレイヤー d:PLAYER shadow 0
			}
		trap la340l d:PLAYER -mask いる \
			-state d:TRP_STATE_STAND \
			-exec {
				mesg プレイヤー d:PLAYER shadow 1
			}


		//外側はしご・上部用設定
		//----------------------
		trap la340h d:PLAYER \
			-and \
			-mask いる \
			-button d:ACTION_BUTTON d:ACTION_BUTTON \
			-dir 1024,256 2048,256 \
			-state d:TRP_STATE_STAND,d:TRP_STATE_LADDER \
			-exec {
				command はしご設定 \
					-l -16400,-12300 \
					-s d:モーションリスト:non_ladder_down_l_start 	13020,-11960,-20470 1024 \
					-e d:モーションリスト:non_ladder_up_l_end	13830,-13000,-20450 -1
				mesg プレイヤー d:PLAYER ladder

			}

		//はしご上で左または上を押していたらおりる。
		trap la340h d:PLAYER -mask いる -dir 2048,256 \
			-state d:TRP_STATE_LADDER \
			-exec {

				command パッドチェック \
					-which 0 \
					-status		//押されている

				if( $status & (d:PAD_L | d:PAD_U)){

					command パッド操作 \
						-press d:PAD_X

				}
			}


		trap la340h d:PLAYER \
			-camera \
			-mask ？ \
			-state d:TRP_STATE_FORCE \
			-exec {
				chara カメラ設定 カットインカメラ \
					-c 1 \
					-p 11235,-10311,-18967 \
					-t 12032,-11444,-20457 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3
			}



		//はしご影消去
		trap la340h d:PLAYER -mask いる \
			-state d:TRP_STATE_FORCE \
			-exec {
				mesg プレイヤー d:PLAYER shadow 0
			}
		trap la340h d:PLAYER -mask いる \
			-state d:TRP_STATE_STAND \
			-exec {
				mesg プレイヤー d:PLAYER shadow 1
			}


		//はしごカメラ
		trap ca340 d:PLAYER \
			-camera \
			-mask ＊ \
			-camera \
			-exec {

				@CS_スムーズカメラ昇順 $5 -16400 -12500 13500 14350
				eval($i:補完ＰＸ = $i:CS_結果１)

				@CS_スムーズカメラ昇順 $5 -16400 -12500 -13500 -9425
				eval($i:補完ＰＹ = $i:CS_結果１)

				@CS_スムーズカメラ昇順 $5 -16400 -12500 -18600 -19615
				eval($i:補完ＰＺ = $i:CS_結果１)



				if( $6 > -18601 ){
					eval($i:補完ＴＺ = -18601)
					eval($w:カメラ補完方式 = 1)
				}else{
					eval($i:補完ＴＺ = $6 )
					eval($w:カメラ補完方式 = 0)
				}

				chara カメラ設定 サブカメラ１ \
					-c 1 \
					-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ \
					-t 13500,$5,$i:補完ＴＺ \
					-a 200 \
					-i $w:カメラ補完方式 -1 0 0 \
					-s $3

		}



		//踊り場カメラ
		trap ca341 d:PLAYER \
			-camera \
			-mask ＊ \
			-camera \
			-exec {

				chara カメラ設定 サブカメラ１ \
					-c 1 \
					-p 12107,-9058,-18752 \
					-t 12116,-10697,-19959 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3
		}









//西側撮影班はしご

	//西側撮影班はしご・下部用設定

		//----------------------
		trap la350l d:PLAYER \
			-mask いる \
			-button d:ACTION_BUTTON \
			-dir 0,256 \
			-state d:TRP_STATE_STAND,d:TRP_STATE_LADDER \
