				} else {
					mesg ドア 左舷ドア２３奥 close $2
				}
			}


		chara ドア 右舷上部ドア２３ \
			-m w04_dr \
			-d 0,2048,0 \
			-p 11750,-9000,50 \
			-slide 1600 \
			-time d:SD_OPEN_TIME \
			-exec {
/*
				if( $:開閉フラグ == 0 ){
					mesg マップ接合 船倉接合４ off
				} else {
					mesg マップ接合 船倉接合４ on
				}
*/
			}

		trap dr302 ？ -mask ？ \
			-exec {
				if ( $3 == 入る ) {
					mesg ドア 右舷上部ドア２３ open $2
				} else {
					mesg ドア 右舷上部ドア２３ close $2
				}
			}

		chara ドア 右舷上部ドア２３奥 \
			-m w04_dr \
			-d 0,0,0 \
			-p 10250,-9000,4450 \
			-slide 1600 \
			-time d:SD_OPEN_TIME



		trap dr205 ？ -mask ？ \
			-exec {
				if ( $3 == 入る ) {
					mesg ドア 右舷上部ドア２３奥 open $2
				} else {
					mesg ドア 右舷上部ドア２３奥 close $2
				}
			}



		chara ドア 左舷上部ドア２３ \
			-m w04_dr \
			-d 0,2048,0 \
			-p -10250,-9000,50 \
			-slide 1600 \
			-time d:SD_OPEN_TIME \
			-exec {
/*
				if( $:開閉フラグ == 0 ){
					mesg マップ接合 船倉接合４ off
				} else {
					mesg マップ接合 船倉接合４ on
				}
*/
			}


		trap dr303 ？ -mask ？ \
			-exec {
				if ( $3 == 入る ) {
					mesg ドア 左舷上部ドア２３ open $2
				} else {
					mesg ドア 左舷上部ドア２３ close $2
				}
			}

		chara ドア 左舷上部ドア２３奥 \
			-m w04_dr \
