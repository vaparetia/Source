// defines
// デバグ用各種
#define		EFFECT_RAIN	0			// 雨

// -----------------------------------
#define STAGE_KMS		d00a
#define STAGE_HZX		etitle
#define STAGE_LT2		d00a			// LT2ファイルを変える場合、ここにLT2名を入れる。
#define LT2_SCALE		title_trial		// 10倍スケール用LT2ファイル

#define screen_shot		1 			// スクリーンショット使用

// includes
// ------------------------------------
#include "stdch.h"
#include "sload.h"
#include "varinit.h"
#include "sound.h"
#include "usbkbd.h"

// マップ
// ------------------------------------
chara マップ ＧＷ橋 -h d:STAGE_HZX -l d:LT2_SCALE

// マップ設定

// ------------------------------------
command マップ設定 ＧＷ橋 -s {
	@常駐キャラ設定
	@タイトルサウンドマネージャー設定
	@etitle初期化
	//---------------------------------------------------------------
	// さわる必要のないもの。外したい場合は、行の先端に「//」を入れる。
	//---------------------------------------------------------------
	@天球_新空_新雷セット
	@岡嶋ブラーセット
	@ＧＷ橋セット
	@ぼんぼりセット
	@橋のワイヤーぼんぼりセット

	//---------------------------------------------------------------
	// パラメータをいじれるもの。command.def参照。
	//---------------------------------------------------------------
	@風制御セット
	#if d:EFFECT_RAIN
		@カメラ雨セット
		@雨セット
		@手すりなどの水飛沫セット
	#endif
	@フォグセット
	@波面セット 1
	@川岸のぼかし

	//---------------------------------------------------------------
	// 以下はシナリオ班用。
	//---------------------------------------------------------------
	@各種カメラ作成
	@基本カメラセット
	@プレイヤーセット
	@ハリアーセット
	@スクリーンショット使用
	@ＵＳＢキーボードセット
	@E3撮影用

}

// ====================================
// 初期マップ表示
// ====================================
	command マップ表示 -show ＧＷ橋
	// マップshowの後でセットすること。
	chara delay ディレイ -time 5 -exec {
		@キャラクタ専用ライトセット
	}


// >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>

// メッセージ関連(00.08.10現在)
// ------------------------------------
/*
	＜ＧＷ橋を消す＞
	mesg プットオブジェ 橋本体_左半分 off
	mesg プットオブジェ 橋本体_右半分 off
	＜ＧＷ橋を出す＞
	mesg プットオブジェ 橋本体_左半分 on
	mesg プットオブジェ 橋本体_右半分 on

	＜マンハッタンを消す＞
	mesg プットオブジェ 川岸 off

	＜マンハッタンを出す＞
	mesg プットオブジェ 川岸 on

	＜画面全体に出る白い飛沫（＝カメラ雨）を消す＞
	mesg カメラ雨 カメラ雨 オフ

	＜カメラ雨を出す＞
	mesg カメラ雨 カメラ雨 オン
*/

// >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
proc タイトルサウンドマネージャー設定 {
	chara サウンドマネージャー ＳＤＭ -pak 0
}

proc etitle初期化 {
//	chara シネマスクリーンＥ３ シネマ -top d:CINEMA_BELT_UPPER -bottom d:CINEMA_BELT_LOWER -ftime d:C_FADE_TIME
	mesg シネマスクリーン シネマ フェードアウト 0
	command メニュー設定 -menu on -gage off -radar off -subwin off
	eval( $w:手ブレ用カウンターX = 0 ) ;
	eval( $w:手ブレ用カウンターY = 0 ) ;
	eval( $w:手ブレ用カウンターZ = 0 ) ;
	eval( $w:武器最大数[ d:武器:スティンガー ] = 9999 ) ;
	eval( $w:武器弾数[ d:武器:スティンガー ] = 9999 ) ;
}

// エフェクト関係
// ------------------------------------
proc カメラ上下振動セット {
	chara カメラ上下振動 波ゆれ \
		-a 96 \
		-c 512
}

proc 天球_新空_新雷セット {
	chara 新空 new_sky \
		    -m w00_sky \
			-u 1
	chara 新雷フラッシュ thunder
}

proc 岡嶋ブラーセット {
	chara ブラー okajibura
}

// ＧＷ橋セット（橋はスケール10倍、川岸は100倍）
proc ＧＷ橋セット {
	chara プットオブジェ 橋本体_左半分 \
		-m d00a0 \
		-r 0 0 0 \
		-p 0 0 0 \
		-s 1000 1000 1000 \
		-l d:LT2_SCALE \
		-f 0x0010
	chara プットオブジェ 橋本体_右半分 \
		-m d00a1 \
		-r 0 0 0 \
		-p 0 0 0 \
		-s 1000 1000 1000 \
		-l d:LT2_SCALE \
		-f 0x0010
	chara プットオブジェ 川岸 \
		-m d00a2 \
		-r 0 0 0 \
		-p 0 -30000 50000 \
		-s 10000 10000 10000 \
		-l d:STAGE_LT2 \
		-f 0x0010

	chara ジョージワシントン橋のライン補強モデル lines
}

proc 風制御セット {
	chara 風制御 wind \
		-i 300 \			// 通常風速のＭＡＸ値
		-j 300 \			// 突風風速のＭＡＸ値
		-r -1024 256 0 \	// 通常風の方向（0 0 0 で真下に向かって吹く）
		-a 4 \				// 方向のランダム幅（4096で360度を表す）
		-b 300 \			// 突風頻度（何フレームに一回（目安））
		-c 150				// 突風持続時間のＭＡＸ値（フレーム数）
}

proc 雨セット {
	chara 雨 rain \
		-n 24 \		// 量
		-c 144 		// 輝度
}

proc 波面セット $:ディレイフレーム数 {
	chara delay ディレイ -time $:ディレイフレーム数 -exec {
		//中心位置から10ユニットずつ前後左右に広がります。(デフォルト 0,-2000, 0)
		//うねり周期は、0 厳禁。周期なので大きいほど遅くなります。(デフォルト 256)
		chara 環境光 アンビ \
			 -c 12 35 35
		chara 平行光 パラ \
			 -c 24 42 43 \
			 -p -1587 -3357 -5545
		chara 波面 wave \
			-p 0,-6000,0 \		// 中心位置
			-s 128 \		// うねりの周期
			-n 3 \			// 波濤の数
			-w 5 5 \
			-b 	     0,200,  20500,6,    0,  0 \	// 並び順： posx, posy, posz, size, roty, alpha
				 18000,500,-255000,8, 1251,-25 \
				-18000,500,-245000,8,-1251,-25 \
			-x 0,-135500 20000,132500			// (前2つ)非表示領域位置：中心座標 ／ (後2つ)非表示領域：幅/奥行
			// posx posz 波涛出現位置
			// posy      波涛発生高さの条件
			// size      波涛の高さ
			// roty      波涛の向き（4096 = 360deg）
			// alpha     波涛のα調整（-薄い  +濃い）
#if 0
		chara 嵐の川波 高波 \
			-tex wave wave06 wave09_alp_ovl \
			-dir 100,-20,100 \		// ローカル並行光ベクトル
			-color 160,160,160 \		// 平行光ＲＧＢ
			-ambient 10,10,10 \		// 環境光ＲＧＢ
			-pos 0,-4000,0
#else
	chara プラント海面 seaseasea \
		-single_mode \		// シングルテクスチャモード
		-light_enable \		// ステージライト反映
		-tex wave wave06 wave09_alp_ovl \
		-pos 0,-4000,0 \
		-wave 6,196,21
#endif
	}
}

proc フォグセット {
	chara フォグ 霧 \
		 -c 16 32 27 \		// ＲＧＢ
		 -n -5000 \
		 -f 2000000
}

proc 川岸のぼかし {
	chara 遠景ぼかし far_blur \
		-plane	4 \
		-near	50000 \
		-far	100000 \
		-enable
}

proc キャラクタ専用ライトセット {
	chara 環境光 アンビ \
		 -c 37 52 52
	chara 平行光 パラ \
		 -c 36 63 63 \
		 -p -1587 -3357 -5545
}

proc カメラ雨セット {
	//「プットテクスチャクロスフェードカメラ」と
	//「プットテクスチャクロスフェードカメラドア」の前にセットする
	chara カメラ雨 カメラ雨 \
		-l 1 \
		-i 1	// 不可視起動
}

proc ぼんぼりセット {
	chara プットテクスチャクロスフェードターゲット無し 点滅無しぼんぼり \
		-t xlit04b_alp \
		-u xlit04a_alp \
		-v xlit05b_alp \
		-p 21000,69950,14500 \
		       0,69950,14500 \
		  -20000,69950,14500 \
		  -40000,69950,14500 \
		  -60000,69950,14500 \
		  -80000,69950,14500 \
