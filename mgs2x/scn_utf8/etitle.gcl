proc 路面の水飛沫セット {
	chara 波紋 床水飛沫１ \
		-n 4 \
		-b -150000 14000 -100000 18100 \
		-h 66000

	chara 波紋 床水飛沫１ \
		-n 4 \
		-b -100000 14000 -50000 18100 \
		-h 66000

	chara 波紋 床水飛沫１ \
		-n 4 \
		-b -50000 14000 0 18100 \
		-h 66000

	chara 波紋 床水飛沫１ \
		-n 2 \
		-b 0 14000 25000 18100 \
		-h 66000
}

// カメラ設定
// ------------------------------------
proc 各種カメラ作成 {
	chara カメラ ステージカメラ	-c 0 -l 3 -p 0
	chara カメラ 通常カメラ		-c 0 -l 2 -p 50 
	chara カメラ 追跡カメラ		-c 0 -l 2 -p 40 
}

// カメラ各種セット
// ------------------------------------
proc 基本カメラセット {
	chara カメラ設定 ステージカメラ \
		-c 1 \
		-p   60730, -931,-41097 \
		-t -211111,77057,167053 \
		-a 200 \
		-i 0 0 0 0 \
		-s 1
}

// プレイヤー
// ------------------------------------
proc プレイヤーセット {
	chara プレイヤー スネーク \
		-m sna_def \
		-a snake \
		-p 10000,67000,30000 \
		-d 0,0,0 \
		-l 2800 \
		-s 0
}

// ハリアー
// ------------------------------------
proc ハリアーセット {
	command 水位設定 -lv -4000		//水しぶきが出る高さ
		if ( $b:ハリアー挙動パターン == 0 ) {
			chara ハリアー harrier \
				-pos 100 100 100
			chara delay ディレイ -time 1 -exec {
				mesg ハリアー harrier リロード
				mesg ハリアー harrier ミサイル追尾 1 
				mesg ハリアー harrier スピード設定 2400
				mesg ハリアー  harrier 位置指定 -35790 -1500  478720
				mesg ハリアー  harrier 方向指定 0 2049 0 
				mesg ハリアー  harrier 目標指定  68641 -1500 -420516
				chara delay ディレイ -time 170 -exec {
					mesg ハリアー harrier 加減速 3600 30
					mesg ハリアー harrier 目標指定   -28696,200000,-41085
				}
				return (12*60);
			}
			chara シナリオトラップ harrier_trap \
				-bound -3200000 -3200000 -3200000 \
				        3200000  3200000  3200000 \
				-map ＧＷ橋
			trap harrier_trap harrier -mask いる -exec {
				chara カメラ設定 追跡カメラ \
					-c 1 \
					-p 38726,-565,-114582 \
					-t $4,$5,$6 \
					-a 200 \
					-i 0 0 0 0 \
					-s 1
			}
		} else if ( $b:ハリアー挙動パターン == 1 ) {
			chara ハリアー harrier \
				-pos 100 100 100
			mesg ハリアー  harrier 位置指定  13959 132233 33356
		} else if ( $b:ハリアー挙動パターン == 2 ) {
			chara ハリアー harrier \
				-pos 100 100 100
			chara delay ディレイ -time 1 -exec {
				mesg ハリアー harrier リロード
				mesg ハリアー harrier ミサイル追尾 1 
				mesg ハリアー harrier 位置指定  -39262 72095 10289
				mesg ハリアー harrier 方向指定 0 0 0 
				mesg ハリアー harrier スピード設定 0
				chara delay ディレイ -time 60 -exec {
					mesg ハリアー harrier 加減速 2400 (4*60)
					mesg ハリアー harrier 目標指定 -473926 156295 -52607
				}
				return (12*60);
			}
		} else if ( $b:ハリアー挙動パターン == 3 ) {
			chara カメラ設定 通常カメラ \
				-c 0 \
				-b -3200000,-3200000,-3200000 3200000 3200000 3200000 \
				-l -3200000,-3200000,-3200000 3200000 3200000 3200000 \
				-f 8000 \
				-r 640 2048 0 \
				-a 200 \
				-i 0 0 0 0 \
				-s 1
			command プレイヤー無敵セット
			eval( $w:武器 = d:武器:スティンガー ) ;
			mesg プレイヤー スネーク position -20215,67589,14581
			chara ハリアー harrier \
				-pos 100 100 100
			chara delay ディレイ -time 1 -exec {
				mesg ハリアー harrier リロード
				mesg ハリアー harrier スピード設定 2400
				mesg ハリアー harrier ミサイル追尾 1 
				mesg ハリアー  harrier 位置指定 472412,363610,-158489
				mesg ハリアー  harrier 方向指定 0 3319 0 
				mesg ハリアー  harrier 目標指定  -20215,67589,14581
				chara delay ディレイ -time 170 -exec {
					chara delay ディレイ -time 20 -exec {
						mesg ハリアー harrier 目標指定 -923774,1983530,-1685820
					}
					mesg ハリアー harrier ミサイル発射
				}
				return (10*60);
			}
			chara シナリオトラップ harrier_trap \
				-bound -3200000 -3200000 -3200000 \
				        3200000  3200000  3200000 \
				-map ＧＷ橋
			trap harrier_trap harrier -mask いる -exec {
				eval( $i:手ブレカメラ注視点X = $4 + (`command sin $w:手ブレ用カウンターX`) );
				eval( $i:手ブレカメラ注視点Y = $5 + (`command cos $w:手ブレ用カウンターY`) );
				eval( $i:手ブレカメラ注視点Z = $6 + (`command sin $w:手ブレ用カウンターZ`) );
				eval( $w:手ブレ用カウンターX = ($w:手ブレ用カウンターX + 64) & 4095 )
				eval( $w:手ブレ用カウンターY = ($w:手ブレ用カウンターY + 78) & 4095 )
				eval( $w:手ブレ用カウンターZ = ($w:手ブレ用カウンターZ + 57) & 4095 )
				command 主観カメラ乗っ取り \
					-target $i:手ブレカメラ注視点X,$i:手ブレカメラ注視点Y,$i:手ブレカメラ注視点Z
			}
		} else if ( $b:ハリアー挙動パターン == 4 ) {
			chara ハリアー harrier1 \
				-pos 100 100 100
			chara ハリアー harrier2 \
				-pos 100 100 100
			chara delay ディレイ -time 1 -exec {
				eval( $i:カメラ位置Ｚ方向カウンター = 458720 );
				mesg ハリアー harrier リロード
				mesg ハリアー harrier1 スピード設定 2400
				mesg ハリアー harrier2 スピード設定 2400
				mesg ハリアー harrier1 ミサイル追尾 1 
				mesg ハリアー harrier2 ミサイル追尾 1 

				mesg ハリアー harrier1 位置指定 -85790 165000  468720
				mesg ハリアー harrier1 方向指定 0 2049 0 
				mesg ハリアー harrier1 目標指定 -85790 165000 -420516

				mesg ハリアー harrier2 位置指定 -65790 170000  478720
				mesg ハリアー harrier2 方向指定 0 2049 0 
				mesg ハリアー harrier2 目標指定 -65790 170000 -420516
				chara delay ディレイ -time 150 -exec {
					mesg ハリアー harrier1 目標指定 -473926 156295 -52607
					chara delay ディレイ -time 30 -exec {
						mesg ハリアー harrier2 目標指定 -473926 156295 -52607
					}
				}
				return (10*60);
			}
			chara シナリオトラップ harrier_trap \
				-bound -3200000 -3200000 -3200000 \
				        3200000  3200000  3200000 \
				-map ＧＷ橋
			trap harrier_trap harrier2 -mask いる -exec {
				eval( $i:手ブレカメラ注視点X = $4 + (`command sin $w:手ブレ用カウンターX`)/256 );
				eval( $i:手ブレカメラ注視点Y = $5 + (`command cos $w:手ブレ用カウンターY`)/256 );
				eval( $i:手ブレカメラ注視点Z = $6 + (`command sin $w:手ブレ用カウンターZ`)/256 );
				eval( $w:手ブレ用カウンターX = ($w:手ブレ用カウンターX + 64) & 4095 )
				eval( $w:手ブレ用カウンターY = ($w:手ブレ用カウンターY + 78) & 4095 )
				eval( $w:手ブレ用カウンターZ = ($w:手ブレ用カウンターZ + 57) & 4095 )
				chara カメラ設定 追跡カメラ \
					-c 1 \
					-p -45790,185000,$i:カメラ位置Ｚ方向カウンター \
					-t $i:手ブレカメラ注視点X,$i:手ブレカメラ注視点Y,$i:手ブレカメラ注視点Z \
//					-t $4 $5 $6 \
					-a 200 \
					-i 0 0 0 0 \
					-s 1
				eval( $i:カメラ位置Ｚ方向カウンター = $i:カメラ位置Ｚ方向カウンター - 2400 )
			}
		} else if ( $b:ハリアー挙動パターン == 5 ) {
			command プレイヤー無敵セット
			chara ハリアー harrier \
				-pos 100 100 100
			chara delay ディレイ -time 1 -exec {
				mesg ハリアー harrier リロード
				mesg ハリアー harrier ミサイル追尾 1 
				mesg ハリアー harrier 位置指定  13959 132233 33356
				mesg ハリアー harrier 方向指定 0 1024 0 
				mesg ハリアー harrier スピード設定 24
				mesg ハリアー harrier 目標指定  83959 132233 33356
				chara delay ディレイ -time 180 -exec {
					mesg ハリアー harrier 爆撃
				}
				return (16*60);
			}
		}
	}

// デバッグキャラ
// ------------------------------------
proc スクリーンショット使用 {
#if d:screen_shot
	chara スクリーンショット スクリーンショット
#endif
}

//クリッピング値変更
command セットファークリップ 50 (65535 * 40)

/***************************************************************************************************/
// USBキーボード
/***************************************************************************************************/
	proc ＵＳＢキーボードセット {
		chara USBキーボード実行 ＵＳＢキーボード \
				-e d:KBD_R	{ command メニュー設定 -menu on -gage on -radar on -subwin on	} \
				-e d:KBD_T	{ command メニュー設定 -menu off -gage off -radar off -subwin off	} \
				-e d:KBD_F9 {
						//mesg 警備兵 警備兵Ａ ルート変更 27 -5000,3000,-9000 １Fリフレッシュルーム
				} \
				-e d:KPD_PLUS		{ mesg  プットオブジェ これも天井 on } \
				-e d:KPD_MINUS		{ mesg  プットオブジェ これも天井 off } \
				-e d:KPD_ENTER		{ mesg Ｃ４ Ｃ４ bomb } \
				-e d:KBD_ESC {	mesg 臨時顔アニメキャラ アニメキャラ モーション再生 normal 30
								mesg delay カメラディレイ kill
								mesg 臨時顔アニメキャラ アニメキャラ 視線変更 -1
								mesg 遠景ぼかし 遠景ぼかし１ off
								mesg 遠景ぼかし 遠景ぼかし２ off
								mesg 遠景ぼかし 遠景ぼかし３ off
								mesg 近景ぼかし 近景ぼかし１ off
								mesg 近景ぼかし 近景ぼかし２ off
								mesg 近景ぼかし 近景ぼかし３ off
							} \
				-e d:KBD_F1	{ mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_speech_a 30 } \
				-e d:KBD_F2 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_speech_i 30 } \
				-e d:KBD_F3 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_speech_u 30 } \
				-e d:KBD_F4 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_speech_e 30 } \
				-e d:KBD_F5 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_speech_o 30 } \
				-e d:KBD_F6 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_speech_n 30 } \
				-e d:KBD_F7 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_teeth 30 } \
				-e d:KBD_F8 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_scream 0 } \
				-e d:KBD_F9 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_relax 30 } \
				-e d:KBD_F10{ mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_surprise 30 } \
				-e d:KBD_F11{ mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_sigh 30 } \
				-e d:KBD_F12{ mesg 臨時顔アニメキャラ アニメキャラ 視線変更 2 } \
				-e d:KBD_Q	{ mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_tension 30 } \
				-e d:KBD_W	{
							  chara delay カメラディレイ \
								-time 1 \
								-exec {
									mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_exciting 30
									return 60
								}
							} \
				-e d:KBD_E	{ mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_pain 30 } \
				-e d:KBD_R	{ mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_T12a1D71 30 } \
				-e d:KBD_T	{
								mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 120 -7707,-3929,-14119
								chara delay カメラディレイ \
									-time 90 \
									-exec {
										mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 60 6710,-3960,-18261
									}
							} \
				-e d:KBD_Y	{
							mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_sneeze 0
							} \
				-e d:KBD_U	{ mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_teeth 30
							  chara delay カメラディレイ \
								-time 20 \
								-exec {
										mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_surprise 20
								}
							  chara delay カメラディレイ \
								-time 40 \
								-exec {
										mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_teeth 20
								}
							} \
				-e d:KBD_I	{ mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_teeth 20
							  chara delay カメラディレイ \
								-time 30 \
								-exec {
										mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_relax 20
								}
							  chara delay カメラディレイ \
								-time 60 \
								-exec {
										mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_surprise 20
								}
							  chara delay カメラディレイ \
								-time 90 \
								-exec {
										mesg 臨時顔アニメキャラ アニメキャラ モーション再生  normal 20
								}
							} \
				-e d:KBD_O	{
								mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 90 \
										($i:プレイヤー位置Ｘ-1000),($i:プレイヤー位置Ｙ-200),($i:プレイヤー位置Ｚ+3000)
								chara delay カメラディレイ \
									-time 90 \
									-exec {
										mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 90 \
										($i:プレイヤー位置Ｘ+1000),($i:プレイヤー位置Ｙ-200),($i:プレイヤー位置Ｚ+3000)
									}
								chara delay カメラディレイ \
									-time 180 \
									-exec {
										mesg 臨時顔アニメキャラ アニメキャラ 視線変更 -1
									}
							} \
				-e d:KBD_0 { eval( $b:ハリアー挙動パターン = 0 ); restart ;} \
				-e d:KBD_1 { eval( $b:ハリアー挙動パターン = 1 ); restart ;} \
				-e d:KBD_2 { eval( $b:ハリアー挙動パターン = 2 ); restart ;} \
				-e d:KBD_3 { eval( $b:ハリアー挙動パターン = 3 ); restart ;} \
				-e d:KBD_4 { eval( $b:ハリアー挙動パターン = 4 ); restart ;} \
				-e d:KBD_5 { eval( $b:ハリアー挙動パターン = 5 ); restart ;} \
				-e d:KBD_6 { eval( $b:ハリアー挙動パターン = 6 ); restart ;} \
				-e d:KPD_MINUS {
								mesg プレイヤー スネーク position \
								2966 2000 -15180
							} \
				-e d:KPD_NUMLOCK {
						mesg プット大ガラスオブジェ でかガラス 割れる
				} \
				-e d:KPD_7 {
					mesg プレイヤー スネーク shadow 1
				} \
				-e d:KPD_8 {
					mesg プレイヤー スネーク shadow 0
				} \
				-e d:KBD_L {
									mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_teeth 40
									chara delay カメラディレイ \
										-time 20 \
										-exec {
												mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_tension 30
										}
				} \
				-e d:KBD_A {
					mesg ハリアー harrier ミサイル追尾 1
				 } \
				-e d:KBD_S {
					mesg ハリアー harrier ミサイル追尾 0
				 } \
				-e d:KBD_Z {
					mesg ハリアー harrier リロード
				 } \
				-e d:KBD_X {
					mesg ハリアー harrier 回転設定 60
				 } \
				-e d:KBD_C {
					mesg ハリアー harrier 回転設定 0
				 } \
				-e d:KBD_V {
					mesg ハリアー harrier ミサイルポッド発射
				 } \
				-e d:KBD_B {
					mesg ハリアー harrier ミサイル発射
				 } \
				-e d:KBD_N {
					mesg ハリアー harrier 機銃発射 1	/*1：オン 0:オフ*/
				 } \
				-e d:KBD_M {
					mesg ハリアー harrier 機銃発射 0	/*1：オン 0:オフ*/
				 } \
				-e d:KBD_9 { restart }
		#endif
	}

/***************************************************************************************************/
// E3撮影用
/***************************************************************************************************/

	proc E3撮影用 {
		#if 1
			chara マルチウェイトキャラ マルチ \
				-name d:PLAYER \
				-model sna_def_mh

			chara 臨時顔アニメキャラ アニメキャラ \
				-chara	d:PLAYER
		#endif
	}

