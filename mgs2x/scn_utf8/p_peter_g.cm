}
//	<<<ENGLISH>>>
//	You're faster than I expected...
//	and more capable than you look.

/*意外と早かったな。
見かけよりはやるようだ。
*/
/*以下はカット*/
/*スネーク_001: {
I've finally finished one.
Let's keep ourselves together.
}
*/
/*こっちもようやく１個だ。
気を引き締めていこう。
*/
//dv}//v
}//d

//時間早い h //e
resource PP_爆弾評価＿時間早い__g {
//vox t:vc200311 {
ピーター_000: {
Du bist ganz sch&~on schnell.
jedenfalls f&~ur einen Anf&~anger.
