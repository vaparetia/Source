//爆弾評価 時間、ゲームオーバー回数から判定 h //e
//時間掛かり過ぎ h //e
resource PP_爆弾評価＿時間超過__g {
//vox t:vc200291 {
ピーター_000: {
Du bist zu langsam.
Arbeite etwas schneller.
}
//	<<<ENGLISH>>>
//	You're taking too much time.
//	You should work a little faster.

/*時間が掛かりすぎだな。
もう少し、急いだ方がいい。
*/
スネーク_001: {
Wir haben keine Zeit, Raiden. Ich habe
alle H&~ande voll zu tun und kann Dir
wohl nicht helfen.
}
//	<<<ENGLISH>>>
//	There's no time, Raiden. I've got
//	my hands full here, so it doesn't
//	look like I can help you.
//<ページ数変更>
スネーク_001_1: {
Es liegt allein an Dir.
}
//	<<<ENGLISH>>>
//	It's in your hands.

/*ライデン、時間がない。
こっちも手いっぱいだ。
お前の手伝いは出来そうにない。頼むぞ。
*/
//dv}//v
}//d

//時間普通 h //e
