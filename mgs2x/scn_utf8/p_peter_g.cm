//	Stillman, where are you?

/*スティルマン、今どこだ？*/
//dv}//v
}//d
resource PP_移動後Ｈ脚到着前２__g {
//vox t:vc200631 {
ピーター_000: {
Ich bin noch nicht in Strebe H.
}
//	<<<ENGLISH>>>
//	I haven't arrived at Strut H yet.

/*こっちはまだＨ脚に到着していない。*/
//dv}//v
}//d
resource PP_移動後Ｈ脚到着前３__g {
//vox t:vc200641 {
ライデン_000: {
Kommst Du alleine zurecht?
}
//	<<<ENGLISH>>>
//	Are you all right on your own?

/*ひとりで大丈夫か？*/
ピーター_001: {
Ob Du's glaubst oder nicht,
}
//	<<<ENGLISH>>>
//	Believe it or not,
//	I used to be a cop.
//<ページ数変更>
ピーター_001_1: {
ich war einmal Polizist. Was den Feind
anbelangt, den &~ubernimmt Pliskin f&~ur mich.
}
//	<<<ENGLISH>>>
//	As far as the enemy, Pliskin is
//	already taking care of that for
//	me.

/*これでも、昔は警官だった。敵も
プリスキンがあらかじめ始末して
