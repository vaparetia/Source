//Ｃ脚 d //e
//厨房扉前 h //e
resource PP_Ｃ脚厨房扉前１__g {
//vox t:vc200011 {
ピーター_000: {
K&~ummere Dich nicht um mich.
Entsch&~arfe lieber die Bomben.
}
//	<<<ENGLISH>>>
//	Never mind about me.
//	Get on with disposing
//	of those bombs.

/*私なら大丈夫だ。
爆弾の解体に向かってくれ。
*/
//dv}//v
}//d

//しつこく扉を叩いた後 h //e
resource PP_Ｃ脚厨房扉前扉叩いた後__g {
//vox t:vc200021 {
ピーター_000: {
Was machst Du da? Beeil' Dich
und entsch&~arfe die Bomben.
}
//	<<<ENGLISH>>>
//	What are you doing there?
//	Hurry up and dispose of those
//	bombs.

/*そこで何をしてるんだ？
さっさと爆弾を処理しに行ってくれ。
*/
//dv}//v
}//d

//扉の外で危険モードである h //e
resource PP_Ｃ脚厨房扉前危険モード１__g {
//vox t:vc200031 {
ピーター_000: 
''
/*……。（息を殺していない振りをしている）
*/
//dv}//v
}//d
resource PP_Ｃ脚厨房扉前危険モード２__g {
//vox t:vc200041 {
ピーター_000: {
Ich werde die T&~ur nicht &~offnen!
}
//	<<<ENGLISH>>>
//	I'm not going to open the door!

/*……ここは開けないぞ！*/
//dv}//v
}//d

//厨房で破壊の限りを尽くした後 h //e
resource PP_Ｃ脚厨房扉前破壊__g {
//vox t:vc200051 {
ピーター_000: {
Was machst Du da?
}
//	<<<ENGLISH(2)>>>
//	What are you doing?
//<ページ数変更>
ピーター_000_1: {
Wer so zerst&~orungsw&~utig ist, sollte
wohl lieber keine Bomben r&~aumen.
Bist Du sicher,
}
//	<<<ENGLISH>>>
//	Someone with such an appetite for
//	destruction is probably not cut out
//	for bomb disposal.
//<ページ数変更>
ピーター_000_2: {
da&~s Du es schaffen kannst?
}
//	<<<ENGLISH>>>
//	Are you sure you're up to it?

/*何をやってるんだ？
破壊衝動が強すぎる人間は爆弾処理には
向かないのだが……。大丈夫か？
*/
//dv}//v
}//d


//★P014_16_G01ピーター遭遇１６ゲーム１終了＜フラク＜P015_01_R1爆弾解体最初の一つ１無線デモ１開始 d //e
//ノードにアクセスせよ h //e
resource PP_ノードにアクセスしろ__g {
//vox t:vc200061 {
ピーター_000: {
Der Sensor A zeight die Positionen
der Bomben auf dem Radar an.
}
//	<<<ENGLISH>>>
//	The Sensor A that I gave you is
//	set so that the position of bombs
//	will appear on the radar.

/*あんたに渡したセンサーＡはレーダーに
爆弾の位置を表示するようにセットして
ある。
*/
ピーター_001: {
Habe ich nicht gesagt, da&~s Du zuerst
den Radar initialisieren mu&~st?
Los, suche jetzt den Node.
}
//	<<<ENGLISH>>>
//	Didn't I say that if you don't first
//	initialize the radar, you won't get
//	anywhere? Now search for the node.

/*だからまずレーダーを使えるように
しなければ話にならない。
ノードを探すんだ。
*/
ピーター_002: {
Wenn Du Dir nicht sicher bist, wo Du
den Node findest, frag' Deinen Offizier.
Er m&~u&~ste es wissen.
}
//	<<<ENGLISH>>>
//	If you're not sure where the
//	node is, ask your superior
//	officer. He should know.

/*ノードがどこにあるかはあんたの上官に
聞けばわかるだろう。
*/
//dv}//v
}//d

//センサー説明１ h //e
resource PP_センサー説明１__g {
//vox t:vc200071 {
ピーター_000: {
Nimm Sensor A. Damit wird der Geruch
der C4s visuell auf Deinem Radar
dargestellt.
}
//	<<<ENGLISH>>>
//	Equipping yourself with
//	Sensor A will bring up a
//	visual representation＃－
//<ページ数変更>
ピーター_000_1: {
Die Bomben sehen aus wie Nebel.
}
//	<<<ENGLISH>>>
//	of the odor of C4's on your
//	radar. It will appear as a
//	mist-like image.

/*センサーＡを装備すれば、Ｃ４の匂いを
レーダー上に視覚化させることが出来る。
雲のように映るのがそれだ。
*/
ピーター_001: {
Die C4s wurden garantiert an strategisch
g&~unstigen Stellen plaziert. Suche gr&~undlich.
}
//	<<<ENGLISH>>>
//	C4 is sure to be planted anywhere
//	where there is a response. Search
//	carefully.

/*反応があるあたりに必ずＣ４が
仕掛けられている。よく探すんだ。
*/
//dv}//v
}//d

//センサー説明２ h //e
resource PP_センサー説明２__g {
//vox t:vc200081 {
ピーター_000: {
Sensor A gibt die Position
der Bomben nicht genau an.
}
//	<<<ENGLISH>>>
//	Sensor A can't specify the
//	exact location of bombs.

/*センサーＡは爆弾の位置を
特定できるものではない。
*/
ピーター_001: {
Leider kann nur der ungef&~ahre
Bereich ermittelt werden.
}
//	<<<ENGLISH>>>
//	It's unfortunate, but only
//	the area can be localized.
//<ページ数変更>
ピーター_001_1: {
Wenn Du in dem Bereich bist,
mu&~st Du selbst weitersuchen.
}
//	<<<ENGLISH>>>
//	Once you've got the area, you'll
//	have to continue your search
//	using your own two eyes.

/*残念ながら、エリアを特定できるのみだ。
エリアがわかれば、後は目で探す
しかない。
*/
//dv}//v
}//d
//センサー説明３ h //e
resource PP_センサー説明３__g {
//vox t:vc200091 {
ピーター_000: {
Der Sensor ist sehr zuverl&~assig.
Man k&~onnte sogar sagen fehlerfrei.
}
//	<<<ENGLISH>>>
//	The sensor has a high dependability
//	factor. Consider it error-proof.

/*センサーの信憑性は高い。
誤作動はないと考えてくれていい。
*/
ピーター_001: {
Selbst wenn Du auf den ersten Blick nichts
siehst, kannst Du sicher sein, da&~s der
Sensor reagiert, wenn sich eine C4 in der
N&~ahe befindet.
}
//	<<<ENGLISH>>>
//	Even if a glance reveals nothing,
//	you can be sure there is a C4 in
//	the vicinity if the sensor responds.

/*センサーに反応があったら、
必ずそのどこかにＣ４がある。
一見見当たらなくてもな。
*/
ピーター_002: {
Versuche, Dich in Fatman
hineinzuversetzen. Dann findest Du
garantiert etwas. Suche gr&~undlich.
}
//	<<<ENGLISH>>>
//	Try thinking from Fatman's
//	perspective, and you're sure to
//	find something. Look carefully.

/*ファットマンの気持ちになって
考えてみれば、必ず見つかる。
よく探すんだ。
*/
//dv}//v
}//d


//冷凍スプレー h //e
//使い方 t //e
resource PP_冷凍スプレー使い方__g {
//vox t:vc200101 {
ピーター_000: {
Das K&~uhlspray geht nie aus, gleichg&~ultig
wie oft Du es benutzt. Also mach ruhig
Gebrauch davon.
}
//	<<<ENGLISH>>>
//	The coolant spray will never run
//	out no matter how much you use
//	it. Go ahead and utilize it freely.

/*冷却スプレーはいくら使っても内容物が
なくなることはない。そこは気にせず
使ってくれ。
*/
ピーター_001: {
Aber denke daran, da&~s das Spray nur
eine Reichweite von wenigen Metern hat.
}
//	<<<ENGLISH>>>
//	Note, however, that the spray has
//	a range of only several meters.
//<ページ数変更>
ピーター_001_1: {
Ber&~ucksichtige also die Entfernung
zwischen Dir und den Bomben.
}
//	<<<ENGLISH>>>
//	Be sure to factor in the distance
//	between you and the bombs when
//	you use it.

/*ただしスプレーが届くは数メートルだ。
爆弾との距離を考えて使用するんだ。
*/
//dv}//v
}//d

//注意。主観画面になる。 h //e
resource PP_冷凍スプレー主観__g {
//vox t:vc200111 {
ピーター_000: {
Wenn Du das K&~uhlspray benulzt, wird
die Beobachtungsperspektive gezeigt.
Vorsicht, denn das hei&~st,
}
//	<<<ENGLISH>>>
//	When you equip yourself with the
//	coolant spray, you will enter the
//	First Person View Screen.
//<ページ数変更>
ピーター_000_1: {
da&~s Du Dich nicht bewegen kannst,
solange Du spr&~uhst.
}
//	<<<ENGLISH>>>
//	Now, be careful, as this means that
//	you can't move while spraying.

/*冷却スプレーを装備すると主観画面に
なる。つまりスプレー噴射中は移動
出来ないということだ。気をつけてくれ。
*/
//dv}//v
}//d

//その他注意 h //e
resource PP_冷凍スプレー注意__g {
//vox t:vc200121 {
ピーター_000: {
Das Spray m&~u&~ste selbst unzug&~angliche
Stellen, d.h. zu hohe oder enge,
}
//	<<<ENGLISH>>>
//	Even in places that you can't
//	reach or narrow areas that
//	you can't enter,
//<ページ数変更>
ピーター_000_1: {
erreichen k&~onnen,
wenn Du den Arm ausstreckst.
}
//	<<<ENGLISH>>>
//	the spray should reach provided
//	you stretch out your arm.

/*背の届かない場所、入り込めないような
狭い場所でも、手を伸ばせばスプレーの
噴射が届くはずだ。
*/
//dv}//v
}//d


//爆弾 h //e
resource PP_爆弾１__g {
//vox t:vc200131 {
ピーター_000: {
Wenn die Lampe am Sprengz&~under nicht
mehr blinkt, ist die Bombe eingefroren
}
//	<<<ENGLISH>>>
//	When the lamp on the detonator
//	stops pulsating, it indicates that
//	the bomb has been frozen --
//<ページ数変更>
ピーター_000_1: {
-- das hei&~st, sie ist entsch&~arft.
}
//	<<<ENGLISH>>>
//	meaning that the bomb has
//	been successfully defused.

/*起爆装置についているランプの点滅が
止まれば、凍結完了、つまり爆弾処理が
終わったということだ。
*/
ピーター_001: {
Spr&~uhe, bis die Lampe aufh&~ort zu blinken.
}
//	<<<ENGLISH>>>
//	Apply the spray until
//	the lamp stops blinking.

/*ランプの点滅が止まるまで
スプレーを吹き付けろ。
*/
//dv}//v
}//d

