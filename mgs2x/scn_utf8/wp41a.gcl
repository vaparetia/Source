// ------------------------------------
// 各gclで必要なdefine
// ------------------------------------
// モード
#define		STAGE_VR		1		// 共通プロック切り分け用
#define		VR_WEAPON		1		// 共通プロック切り分け用
#define		STAGE_START		1		//	ゲーム開始直後処理を有効にするため
// ステージ名
#define		STAGE_WP41A		1		// 共通プロック切り分け用
// 敵兵、ＮＰＣ状況（薬莢を呼び分けるのに必要）
#define		ENE_P_GOL		1		// 都市迷彩ゴル兵
#define		ENE_SHOT		1		// ショットガン兵
#define		ENE_HIGH_TECH	1		// ハイテク兵
#define		ENE_SHIELD		1		// 盾兵


// ------------------------------------
// 各種スイッチ用define
// ------------------------------------
// デバッグ関係
#ifdef	d:FIX_MODE
	#define		DEBUG_CHARA		0		// デバッグキャラ全体(FIX時は0)
#else
	#define		DEBUG_CHARA		0		// デバッグキャラ全体
#endif
#define		CHARA_CAMERA	0		// キャラ追従カメラ
#define		TARGET_CHARA	敵兵:01	// キャラ追従カメラのターゲット
#define		SCREENSHOT		0		// スクリーンショット
#define		USB_KEY			0		// USBキーボード


// ------------------------------------
// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME			ws41a
#define		KMS_NAME			ws41a
#define		LT2_NAME			$s:ＶＲライトファイル名
#define		TONBO_KMS_NAME		ws41a_tonbo
#define		LINE_KMS_NAME		ws41a_line

// キャラクター関係
#define		PLAYER		ライデン

// ------------------------------------
// 敵兵音声
// ------------------------------------

// ------------------------------------
// include
// ------------------------------------
#include "rai_wp41a.mh"		// 強制モーションリスト
#include "stdch.h"
#include "enevoice.h"
#include "a_stdproc.h"		// アナザーミッション設定ファイル
#include "sload.h"
#include "item_info.h"
#include "a_item_info.h"
#include "ene_item.h"
#include "vr_common.h"		// ＶＲステージ共通で使用するプロック

// ステージ固有
#include "jump.h"

#if d:USB_KEY
	#include "usbkbd.h"
#endif

// ------------------------------------
// マップ設定
// ------------------------------------
chara マップ ＶＲステージ -k d:KMS_NAME -h d:HZX_NAME,0 -l d:LT2_NAME

command マップ設定 ＶＲステージ -set {
	// ローカルの初期化
	// ------------------------------------
	@ローカル変数初期化		// ローカルで使用する変数で初期化をする場合はここで

	// ＶＲで必要な基本プロックのセット(vr_common.hで定義)
	// サウンドの基本パック、ＶＲの基本システム、プレイヤー、ゴール等を設定します
	// ※このプロックを使用する時は「ＶＲクリア時処理」というプロックが必要です
	// ＶＲ共通プロックセット	$:スネークファイル $:雷電ファイル $:クリア条件フラグ
	//							$:ゴールＸ $:ゴールＹ $:ゴールＺ
	//	VR_GOAL_TARGET	/*的全滅でゴールが開く*/
	//	VR_GOAL_FREE	/*ゴールが最初から開いてる*/
	//	VR_GOAL_ENEMY	/*敵全滅でゴールが開く*/
	//	VR_GOAL_SNEAK	/*潜入モード中はゴールが開く*/
	//	VR_GOAL_TIME	/*タイマーがゼロになるとゴールが開く*/
	// ------------------------------------
	@ＶＲ共通プロックセット sna_wp41a rai_wp41a d:VR_GOAL_TARGET -2500 0 -14000
	
	// ＶＲウィンドウの設定
	// ------------------------------------
	@武器訓練狙撃１面ＶＲウィンドウ設定

	// クリア時に呼ばれるものの設定
	// ------------------------------------
	@ＶＲクリア設定 p:load_wp42a p:load_wp41a
	
	// ステージに引かれるライン
	// ------------------------------------
	@ＶＲアウトライン d:KMS_NAME d:TONBO_KMS_NAME d:LINE_KMS_NAME

	// 設定値を変更する場合は以下のプロック内で設定
	// ------------------------------------
	@設定値変更				// 敵兵や的のパラメータをステージ限定で変える時はここで
	@プラグイン設定			// プレイヤーのプラグインがいる時はここで

	@自動ジャンプ設定

	// 的関係の設定
	// ------------------------------------
	@ＶＲ標的設定				// ＶＲシステム起動後に呼ぶ

	// ＢＧＭの設定(プレイヤー→敵兵→BGMの順で呼ぶ。的の場合は関係ないがとりあえずここに)
	// ------------------------------------
	@ＢＧＭ設定

	// アイテムの設定
	// ------------------------------------
	@アイテム設定

	// 光源、オブジェクト、カメラ関連の設定
	// ------------------------------------
	//@フォグ設定
	@ＶＲフォグ設定 -8000 85000 -10000 80000 -7000 77000
	@カメラセット					// chara カメラとベースのカメラを設定
	@ＶＲ面カメラ設定				// ステージ固有のカメラ設定がいる時はこのプロックで
	@ＶＲキャラ用ライト設置			// vr_common.hに定義。必ず最後に設定
#if d:DEBUG_CHARA
//	@デバッグキャラセット
#endif
}


//初期マップの表示
command マップ表示 -show ＶＲステージ


// 各proc設定
//-------------------------------------------------------------------------------------
// 全マップ共通
	//------------------------------------------------------------
	// ＶＲウィンドウの設定と表示
	//------------------------------------------------------------
	proc 武器訓練狙撃１面ＶＲウィンドウ設定 {
		#if d:DEBUG_PRINT
			print 'vr_window_set'
		#endif

		@ＶＲウィンドウ設定	[VRMSG_J:VRM_WPN_PSG_wp41a] [VRMSG_E:VRM_WPN_PSG_wp41a] \	// 日、英
							[VRMSG_G:VRM_WPN_PSG_wp41a] [VRMSG_F:VRM_WPN_PSG_wp41a] \	// 独、仏
							[VRMSG_I:VRM_WPN_PSG_wp41a] [VRMSG_S:VRM_WPN_PSG_wp41a] \	// 伊、西
							[VRMSG_K:VRM_WPN_PSG_wp41a] \								// 韓
							p:ＶＲステージ開始時処理								// 終了プロック


		// ＶＲウィンドウを表示する
		mesg ＶＲウィンドウ ＶＲウィンドウ君 開く

		// スタート時とクリア時に使用するカットインカメラ
		chara カメラ カットインカメラ		-c 0 -l 0 -p  0

		// スタート時のカメラ(必要な場合)
		chara カメラ設定 カットインカメラ \
			-c 1 \	
			-p 201,14585,-43705 -t 201,7797,-48287 \
			-r 637,2048,0 -f 8190 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1
	}
	
	//------------------------------------------------------------
	// ステージ開始時処理
	//------------------------------------------------------------
	proc ＶＲステージ開始時処理 {
		#if d:DEBUG_PRINT
			print 'game_start!!!!!'
		#endif

		// プレイヤーやパッドの制御等を行う a_stdproc.hで定義
		@全ミッション共通ステージ開始時処理

		// カメラワークスタート(必要な場合)
		// 全体図
		chara カメラ設定 カットインカメラ \
			-c 1 \
			-p 210,43871,-18676 -t 210,37090,-23267 \
			-r 636,2048,0 -f 8189 \
			-a 200 \
			-i 4 4 d:START_CAMERA_CHANGE_TIME d:START_CAMERA_CHANGE_TIME \
			-s 1

		chara delay ディレイ \
			-time d:START_CAMERA_CHANGE_TIME \
			-exec {
				chara カメラ設定 カットインカメラ -s -1
			}
	}

// ------------------------------------
// ゲーム開始直後処理
// ------------------------------------
	
	proc ゲーム開始直後処理 {
		//	的をスタートさせる
		mesg ＶＲ的共通 移動的 移動開始
	}
	
	// ------------------------------------
	// クリア時の処理
	// ------------------------------------
	proc ＶＲクリア時処理 {
		#if d:DEBUG_PRINT
			print 'clear'
		#endif
		
		// 強制モーションを発動
		@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_1 d:SOUTH

		// クリア時にカメラアングルを変える
		chara カメラ設定 クリア時カメラ \
			-c 1 \
			-p -3846,800,-10504 -t -1725,1765,-18354 \
			-r -77,1876,0 -f 8189 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}



	// ------------------------------------
	// パラメータ系の変更
	// ------------------------------------
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT
			print 'localvar_init'
		#endif
		
		$$b:的セット数 = 0;
	}
	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT
			print 'status_set'
		#endif

	// 初期装備の設定
		eval( $w:武器弾数Ｒ[ d:武器:ＰＳＧ１ ] = 61 )

	// ＰＳＧ１を前装備させておく
		command シナリオ前武器変更 -number d:武器:ＰＳＧ１
	}

	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif
		command プラグイン自動ジャンプ
	}

	proc 自動ジャンプ設定 {

		trap jp d:PLAYER \
			-mask 入る \
			-exec {
				@ジャンプ発動 jp:001 1000 200
			}
	}



	// ------------------------------------
	// 敵兵や的の処理
	// ------------------------------------
	proc ＶＲ標的設定 {
		if( $s:選択プレイヤー == ライデン || \
			$s:選択プレイヤー == プリスキン ) {
			@ライデン的ルート設定
		} else {
			@スネーク的ルート設定
		}
	}

	proc ライデン的ルート設定 {
		command foreach -argc 2 -repeat 6 \
		-data { \
			{ 移動的:01, 1 }\
			{ 移動的:02, 2 }\
			{ 移動的:03, 3 }\
			{ 移動的:04, 4 }\
			{ 移動的:05, 5 }\
			{ 移動的:06, 6 }\
		} \
		-exec { \
			// 点滅的の設定
			if( $s:選択プレイヤー == プリスキン ) {
				$$b:的セット数 = $$b:的セット数 + 1;
				if( $$b:的セット数 % 2 ) {
					$$i:フラグ = d:VR_TRG_HIDESTART;
				} else {
					$$i:フラグ = d:VR_TRG_VISIBLESTART;
				}
			} else {
				$$i:フラグ = 0;
			}
			
			chara ＶＲ移動的 $1 \
				-flag ( d:VR_TRG_OCT | d:VR_TRG_WAIT | $$i:フラグ ) \
				-route $2 \
				-yshift 0 500 0 \
				-dir 0 0 \
				-speed 15
		}
	}

	proc スネーク的ルート設定 {

		command foreach -argc 2 -repeat 9 \
		-data { \
			{ 移動的:01, 1 }\
			{ 移動的:02, 2 }\
			{ 移動的:03, 3 }\
			{ 移動的:04, 4 }\
			{ 移動的:05, 5 }\
			{ 移動的:06, 6 }\
			{ 移動的:07, 7 }\
			{ 移動的:08, 8 }\
			{ 移動的:09, 9 }\
		} \
		-exec { \
			// 点滅的の設定
			if( $s:選択プレイヤー == タキシードスネーク || \
				$s:選択プレイヤー == 前作スネーク ) {
				$$b:的セット数 = $$b:的セット数 + 1;
				if( $$b:的セット数 % 2 ) {
					$$i:フラグ = d:VR_TRG_HIDESTART;
				} else {
					$$i:フラグ = d:VR_TRG_VISIBLESTART;
				}
			} else {
				$$i:フラグ = 0;
			}
			
			
			chara ＶＲ移動的 $1 \
				-flag ( d:VR_TRG_OCT | d:VR_TRG_WAIT | $$i:フラグ ) \
				-route $2 \
				-yshift 0 500 0 \
				-dir 0 0 \
				-speed 15
		}
	}

	// ------------------------------------
	// ＢＧＭの設定
	// ------------------------------------
	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT
			print 'bgm_set'
		#endif

		chara ＢＧＭマネージャー ＢＧＭマネ
	}

	// ------------------------------------
	// アイテムの設定
	// ------------------------------------
	// 再発生が必要な時は以下のプロックの中を記述する
	// ------------------------------------
	proc アイテム取得時番号設定 $:ボックス名 {
		#if d:DEBUG_PRINT
			print 'item_no_set'
		#endif
	}
	// アイテムの設置
	// ------------------------------------
	proc アイテム設定 {
		#if d:DEBUG_PRINT
			print 'item_set'
		#endif
		
		switch ( $s:選択プレイヤー ) {
			case ( ライデン ) {
				@A_ジアゼパム_初期設置 ジアゼパム:01 -2000,0,-15700 d:アイテム水飛沫無 2
				@A_ジアゼパム_初期設置 ジアゼパム:02 5400,-1000,-14600 d:アイテム水飛沫無 2
			}
			case ( スネーク ) {
				@A_ジアゼパム_初期設置 ジアゼパム:01 -2000,0,-15700 d:アイテム水飛沫無 2
				@A_ジアゼパム_初期設置 ジアゼパム:01 -6500,-1000,-14600 d:アイテム水飛沫無 2
			}
			case ( プリスキン ) {	
				@A_ジアゼパム_初期設置 ジアゼパム:01 -2000,0,-15700 d:アイテム水飛沫無 2
			}
			case ( タキシードスネーク ) {
				@A_ジアゼパム_初期設置 ジアゼパム:01 -2000,0,-15700 d:アイテム水飛沫無 2
			}
			case ( 前作スネーク ) {
				@A_ジアゼパム_初期設置 ジアゼパム:01 -2000,0,-15700 d:アイテム水飛沫無 2
			}
		}
		
	}

	// ------------------------------------
	// 光源関係
	// ------------------------------------
	// フォグ
	// ------------------------------------
	proc フォグ設定 {
		#if d:DEBUG_PRINT
			print 'fog_set'
		#endif

		chara フォグ 霧\
			-c 31, 31, 20 \
			-n -5000 \
			-f 90000


	}
	// キャラ用光源(マップの設置が終わってから設定することで、キャラだけに光を当てる)
	// ------------------------------------

	// ------------------------------------
	// カメラ関係の設定
	// ------------------------------------
	// ステージカメラ設定
	// ------------------------------------
	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'chara_camera & stage_camera_set'
		#endif

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0
		chara カメラ メインカメラ		-c 0 -l 2 -p 40
		chara カメラ クリア時カメラ		-c 0 -l 0 -p 10

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 200,2048,0 -f 8196 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}
	// ステージ固有のカメラ設定
	// ------------------------------------
	proc ＶＲ面カメラ設定 {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif
	}





// -----------------------------------------------------------------------------------
// 以下デバッグ専用proc
// -----------------------------------------------------------------------------------
// デバッグキャラ
// ------------------------------------
proc デバッグキャラセット {
	#if d:DEBUG_PRINT
		print 'debug_chara_set'
	#endif

	#if d:CHARA_CAMERA
		chara キャラカメラ 敵兵カメラ \
			-c d:TARGET_CHARA \
			-s -920,610,200 \
			-r -200,1024,0
	#endif

	#if d:SCREENSHOT
		chara スクリーンショット shot
	#endif

	#if d:USB_KEY
		chara USBキーボード実行 test \
			-e d:KBD_ESC {
				mesg プレイヤー d:PLAYER position -5500, -13000, -500
			} \
	#endif
}

