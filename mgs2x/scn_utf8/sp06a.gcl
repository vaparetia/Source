#define E_WAIT_TIME	30
	proc タキシードルート変更 {
		chara delay 敵兵出発ディレイ -time (d:E_WAIT_TIME*1) -exec {
			mesg 警備兵 警備兵:01 アクション終了
		}
		chara delay 敵兵出発ディレイ -time (d:E_WAIT_TIME*2) -exec {
			mesg 警備兵 警備兵:02 アクション終了
		}
		chara delay 敵兵出発ディレイ -time (d:E_WAIT_TIME*3) -exec {
