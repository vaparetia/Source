/*************************************************************************************/
// 落下ゲームオーバー
/*************************************************************************************/
	proc 落下ゲームオーバー {
		trap drop_dead_cam d:PLAYER \
			-mask ？ \
			-exec {
				print '死にかけ！'
				// 死にかけなのでカメラ固定
				chara カメラ設定 ゲームオーバーカメラ \
					-c 1 \
					-p $i:カメラＸ位置 $i:カメラＹ位置 $i:カメラＺ位置 \
					-t $i:注視点Ｘ位置 $i:注視点Ｙ位置 $i:注視点Ｚ位置 \
					-a 200 \
					-i 1 1 0 0 \
					-s $3
			}

		trap drop_dead d:PLAYER \
			-mask 入る \
			-exec {
				// ゲームオーバー
				$$b:ゲームオーバータイプ = 2;
				@ミッション共通ゲームオーバー処理
				// ほんとに死んだのでカメラ固定
				chara カメラ設定 ゲームオーバーカメラ強 \
					-c 1 \
					-p $i:カメラＸ位置 $i:カメラＹ位置 $i:カメラＺ位置 \
					-t $i:注視点Ｘ位置 $i:注視点Ｙ位置 $i:注視点Ｚ位置 \
					-a 200 \
					-i 1 1 0 0 \
					-s 1

				// 落下声「うぎゃー」
				command ＳＥセットモード -s d:SD_V_PFALL01 \
					-p $i:プレイヤー位置Ｘ,$i:プレイヤー位置Ｙ,$i:プレイヤー位置Ｚ \
					-m 1
			}

	}

/*************************************************************************************/
// アイテムの設定
