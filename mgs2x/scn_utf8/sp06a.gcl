			print 'item_set'
		#endif
	}

	// ------------------------------------
	// キャラ用光源(マップの設置が終わってから設定することで、キャラだけに光を当てる)
	// ------------------------------------

/*************************************************************************************/
// カメラ関係の設定
/*************************************************************************************/
	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'chara_camera & stage_camera_set'
		#endif

		chara カメラ メリル死亡カメラ		-c 0 -l 0 -p 5
		chara カメラ ゲームオーバーカメラ強	-c 0 -l 0 -p 7
		chara カメラ ゲームオーバーカメラ	-c 0 -l 0 -p 10
		chara カメラ クリア時カメラ			-c 0 -l 0 -p 15
		chara カメラ シナリオカメラ			-c 0 -l 1 -p 50
		chara カメラ モーションカメラ		-c 0 -l 2 -p 10
		chara カメラ メインカメラ			-c 0 -l 2 -p 50
		chara カメラ ステージカメラ			-c 0 -l 3 -p 0


		// デフォルトカメラ
	#if 1
		chara カメラ設定 ステージカメラ \
			-c 0 \
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			//-r 97,2044,0 -f 8215 \
			-r 231,2044,0 -f 5374 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	#else
		chara カメラ設定 ステージカメラ \
			-c 1 \
			-p 246,77811,-20013 -t 252,69682,-21130 \
			-r 934,2044,0 -f 8204 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	#endif
	}

	// ステージ固有のカメラ設定
	// ------------------------------------
	proc ＶＲ面カメラ設定 {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif
	}





/*************************************************************************************/
// 以下デバッグ専用proc
/*************************************************************************************/

	proc デバッグキャラセット {
		#if d:DEBUG_PRINT
			print 'debug_chara_set'
		#endif

		#if d:CHARA_CAMERA
			chara キャラカメラ 敵兵カメラ \
				-c d:TARGET_CHARA \
				-s -920,610,200 \
				-r -200,1024,0
		#endif

		#if d:SCREENSHOT
			chara スクリーンショット shot
		#endif

		#if d:USB_KEY
			chara USBキーボード実行 test \
				-e d:KPD_9 {
					mesg プレイヤー d:PLAYER position 0 1000 0
				} \
				-e d:KPD_0 {
					// ステージデフォルトカメラに戻す
					chara カメラ設定 ステージカメラ \
						-c 0 \
						-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
						-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
						-r 97,2044,0 -f 8215 \
						-a 200 \
						-i 2 2 0 0 \
						-s 1
				} \
				-e d:KPD_1 {
					//
					chara カメラ設定 ステージカメラ \
						-c 1 \
						-p 246,77811,-20013 -t 252,69682,-21130 \
						-r 934,2044,0 -f 8204 \
						-a 200 \
						-i 2 2 0 0 \
						-s 1
				} \
				-e d:KPD_2 {
					//
					chara カメラ設定 ステージカメラ \
						-c 1 \
						-p 258,48894,-22088 -t 275,41138,-24783 \
						-r 806,2044,0 -f 8211 \
						-a 200 \
						-i 2 2 0 0 \
						-s 1
				} \
				-e d:KPD_3 {
					//
					chara カメラ設定 ステージカメラ \
						-c 1 \
						-p 171,43932,-7870 -t 188,36181,-10577 \
						-r 805,2044,0 -f 8210 \
						-a 200 \
						-i 2 2 0 0 \
						-s 1
				} \
				-e d:KPD_4 {
					//
					chara カメラ設定 ステージカメラ \
						-c 1 \
						-p 135,41875,-2022 -t 152,34124,-4729 \
						-r 805,2044,0 -f 8210 \
						-a 200 \
						-i 2 2 0 0 \
						-s 1
				} \
				-e d:KPD_5 {
					print 'アクション終了'
					mesg 警備兵 警備兵:01 アクション終了
				} \
				-e d:KPD_ENTER {
					restart
				}
		#endif


		command メニュー設定 -gage off -radar off

	}


	// a_stdproc.hで呼ばれている
	proc 敵兵全滅プロック {
		/*
		chara プロック連続実行 クリア監視連続君 -time -1 -exec {
			if( !( `command プレイヤー状態取得` & ( d:PFLAG_ELUDE | d:PFLAG_ELUDE_FALL ) ) ) {
