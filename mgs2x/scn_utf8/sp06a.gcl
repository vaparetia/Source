// ------------------------------------
// 各gclで必要なdefine
// ------------------------------------
// モード
#define		STAGE_VR		1		// 共通プロック切り分け用
#define		VR_WEAPON		1		// 共通プロック切り分け用
// ステージ名
#define		STAGE_SP06A		1		// 共通プロック切り分け用
#define		STAGE_START		1		// 開始直後プロックの使用

// 敵兵、ＮＰＣ状況（薬莢を呼び分けるのに必要）
#define		ENE_P_GOL		1		// 都市迷彩ゴル兵
#define		ENE_SHOT		1		// ショットガン兵
#define		ENE_HIGH_TECH	1		// ハイテク兵
#define		ENE_SHIELD		1		// 盾兵


// ------------------------------------
// 各種スイッチ用define
// ------------------------------------
// デバッグ関係
#ifdef	d:FIX_MODE
	#define		DEBUG_CHARA		0		// デバッグキャラ全体(FIX時は0)
	#define		CHARA_CAMERA	0			// キャラ追従カメラ
	#define		TARGET_CHARA	敵兵:01		// キャラ追従カメラのターゲット
	#define		SCREENSHOT		0			// スクリーンショット
	#define		USB_KEY			0			// USBキーボード
	#define 	CLEAR_CHECK		0			// 敵兵が少なくなる
#else
	#define		DEBUG_CHARA		1		// デバッグキャラ全体
	#define		CHARA_CAMERA	0			// キャラ追従カメラ
	#define		TARGET_CHARA	敵兵:01		// キャラ追従カメラのターゲット
	#define		SCREENSHOT		0			// スクリーンショット
	#define		USB_KEY			1			// USBキーボード
	#define 	CLEAR_CHECK		0			// 敵兵が少なくなる
#endif


// ------------------------------------
// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME			sp06a
#define		KMS_NAME			sp06a
#define		TONBO_KMS_NAME		sp06a_tonbo
#define		LINE_KMS_NAME		sp06a_line
//#define		LT2_NAME			debug
#define		LT2_NAME			$s:ＶＲライトファイル名

// キャラクター関係
#define		PLAYER		ライデン

#define 足場Ｚ 20000
#define 足場Ｙ 0

#define DOCUMENT	0

// ------------------------------------
// 敵兵音声
// ------------------------------------

// ------------------------------------
// include
// ------------------------------------

#include "rai_sp06a.mh"		// 強制モーションリスト
#include "stdch.h"
#include "enevoice.h"
#include "a_stdproc.h"		// アナザーミッション設定ファイル
#include "sload.h"
#include "item_info.h"
#include "a_item_info.h"
#include "ene_item.h"
#include "vr_common.h"		// ＶＲステージ共通で使用するプロック

#include "beyond.h"

#if d:USB_KEY
	#include "usbkbd.h"
#endif

// ------------------------------------
// マップ設定
// ------------------------------------

chara マップ ２階／３階 -k d:KMS_NAME -h d:HZX_NAME,0 -l d:LT2_NAME
chara マップ １階 -k sp06a_building 0 6000 20000 -h d:HZX_NAME,1 -l d:LT2_NAME
chara マップ ビル -k sp06a_building 0 0 20000 -h d:HZX_NAME,2 -l d:LT2_NAME

#if d:DOCUMENT
	switch ( $i:プレイタイム % 5 ) {
		case ( 0 ) {
			$$s:ポスター名 = sp06a_poster1
		}
		case ( 1 ) {
			$$s:ポスター名 = sp06a_poster2
		}
		case ( 2 ) {
			$$s:ポスター名 = sp06a_poster3
		}
		case ( 3 ) {
			$$s:ポスター名 = sp06a_poster4
		}
		case ( 4 ) {
			$$s:ポスター名 = sp06a_poster5
		}
		default {
			command assert ( d:FALSE ) 'そんなポスターはありません'
		}
	}

	chara マップ ポスター -k $$s:ポスター名 0 0 0 -h d:HZX_NAME,2 -l d:LT2_NAME
#endif

command マップ設定 ２階／３階 １階 ビル -set {
	// ローカルの初期化
	// ------------------------------------
	@ローカル変数初期化		// ローカルで使用する変数で初期化をする場合はここで

	// ＶＲで必要な基本プロックのセット(vr_common.hで定義)
	// サウンドの基本パック、ＶＲの基本システム、プレイヤー、ゴール等を設定します
	// ※このプロックを使用する時は「ＶＲクリア時処理」というプロックが必要です
	// ＶＲ共通プロックセット	$:スネークファイル $:雷電ファイル $:クリア条件フラグ
	//							$:ゴールＸ $:ゴールＹ $:ゴールＺ $:タイマー初期値
	//	VR_GOAL_TARGET	/*的全滅でゴールが開く*/
	//	VR_GOAL_FREE	/*ゴールが最初から開いてる*/
	//	VR_GOAL_ENEMY	/*敵全滅でゴールが開く*/
	//	VR_GOAL_SNEAK	/*潜入モード中はゴールが開く*/
	//	VR_GOAL_TIME	/*タイマーがゼロになるとゴールが開く*/
	// ------------------------------------
	//@ＶＲ共通プロックセット sna_sp06a rai_sp06a d:VR_GOAL_ENEMY 0 ( 0-2000 ) 400000
	@ＶＲ共通プロックセット sna_sp06a rai_sp06a d:VR_GOAL_ENEMY 0 6000 20000
	@各ミッション用ゴール表示 0 0 20000

	// ＶＲウィンドウの設定
	// ------------------------------------
	@敵兵狙撃ＶＲウィンドウ設定

	// クリア時に呼ばれるものの設定
	// ------------------------------------
	@ＶＲクリア設定 p:load_sp08a p:A_ＲＥＴＲＹプロック

	// ステージに引かれるライン
	@ＶＲアウトライン d:KMS_NAME d:TONBO_KMS_NAME d:LINE_KMS_NAME

	// 設定値を変更する場合は以下のプロック内で設定
	// ------------------------------------
	@設定値変更				// 敵兵や的のパラメータをステージ限定で変える時はここで
	@プラグイン設定			// プレイヤーのプラグインがいる時はここで

	// 敵関係の設定
	// ------------------------------------
	@コマンダー設定				// ＶＲシステム起動後に呼ぶ
	@ディフェンスポイント設置
	//@ルート変更				// ウィンドウ表示が終わってから起動するように変更

	// ＢＧＭの設定(プレイヤー→敵兵→BGMの順で呼ぶ。的の場合は関係ないがとりあえずここに)
	// ------------------------------------
	@ＢＧＭ設定

	// エルード
	@エルード設定
	@落下ゲームオーバー

	// アイテムの設定
	// ------------------------------------
	@アイテム設定

	// 光源、オブジェクト、カメラ関連の設定
	// ------------------------------------
	@ＶＲフォグ設定 -10000 100000 \		// 朝
					-10000 100000 \		// 昼
					-10000 100000		// 夜
	@カメラセット					// chara カメラとベースのカメラを設定
	@ＶＲ面カメラ設定		// ステージ固有のカメラ設定がいる時はこのプロックで
	@ＶＲキャラ用ライト設置				// 必ず最後に設定

	if( $s:選択プレイヤー == 前作スネーク ) {
		@クレイモア設置
		@アイテム設置
	}


#if d:DEBUG_CHARA
	@デバッグキャラセット
#endif
}

command マップ設定 １階 -set {
}

//初期マップの表示
command マップ表示 -show ２階／３階
command マップ表示 -show １階
command マップ表示 -show ビル

#if d:DOCUMENT
	command マップ表示 -show ポスター
#endif

	proc ステージ個別アウトライン設定 $:モデル名 $:トンボ $:ライン $:Ｘ $:Ｙ $:Ｚ {
		chara ステージアウトライン ステージアウトライン \
			-center		$:Ｘ $:Ｙ $:Ｚ \
			-center		0 6000 20000 \
			-file		$:モデル名 \
			-a_color	100 100 100 128

		chara フェードオブジェ トンボ君 \
			-pos $:Ｘ $:Ｙ $:Ｚ \
			-pos 0 6000 20000 \
			-rgb 80 80 80 \	/*最も明るくなったときの値*/
			-time 90 \			/*最も明るくなるまでの時間*/
			-kms $:トンボ

		chara フェードオブジェ トンボ君 \
			-pos $:Ｘ $:Ｙ $:Ｚ \
			-pos 0 6000 20000 \
			-rgb 160, 160, 160 \	/*最も明るくなったときの値*/
			-time 45 \			/*最も明るくなるまでの時間*/
			-kms $:ライン
	}

// 各proc設定
//-------------------------------------------------------------------------------------
// 全マップ共通
	// ------------------------------------
	// ＶＲウィンドウの設定と表示
	//------------------------------------------------------------
	proc 敵兵狙撃ＶＲウィンドウ設定 {
		#if d:DEBUG_PRINT
			print 'vr_window_set'
		#endif

		switch ( $s:選択プレイヤー ) {
			case ( プリスキン ) {
				@ＶＲウィンドウ設定	\
				[VRMSG_J:VRM_VRT_sp06a_2] [VRMSG_E:VRM_VRT_sp06a_2] \	// 日、英
				[VRMSG_G:VRM_VRT_sp06a_2] [VRMSG_F:VRM_VRT_sp06a_2] \	// 独、仏
				[VRMSG_I:VRM_VRT_sp06a_2] [VRMSG_S:VRM_VRT_sp06a_2] \	// 伊、西
				[VRMSG_K:VRM_VRT_sp06a_2] \							// 韓
				p:ＶＲステージ開始時処理							// 終了プロック
			}
			case ( タキシードスネーク ) {
				@ＶＲウィンドウ設定	\
				[VRMSG_J:VRM_VRT_sp06a_3] [VRMSG_E:VRM_VRT_sp06a_3] \	// 日、英
				[VRMSG_G:VRM_VRT_sp06a_3] [VRMSG_F:VRM_VRT_sp06a_3] \	// 独、仏
				[VRMSG_I:VRM_VRT_sp06a_3] [VRMSG_S:VRM_VRT_sp06a_3] \	// 伊、西
				[VRMSG_K:VRM_VRT_sp06a_3] \							// 韓
				p:ＶＲステージ開始時処理							// 終了プロック
			}
			case ( 前作スネーク ) {
				@ＶＲウィンドウ設定	\
				[VRMSG_J:VRM_VRT_sp06a_4] [VRMSG_E:VRM_VRT_sp06a_4] \	// 日、英
				[VRMSG_G:VRM_VRT_sp06a_4] [VRMSG_F:VRM_VRT_sp06a_4] \	// 独、仏
				[VRMSG_I:VRM_VRT_sp06a_4] [VRMSG_S:VRM_VRT_sp06a_4] \	// 伊、西
				[VRMSG_K:VRM_VRT_sp06a_4] \							// 韓
				p:ＶＲステージ開始時処理							// 終了プロック
			}
			default {
				@ＶＲウィンドウ設定	\
				[VRMSG_J:VRM_VRT_sp06a_1] [VRMSG_E:VRM_VRT_sp06a_1] \	// 日、英
				[VRMSG_G:VRM_VRT_sp06a_1] [VRMSG_F:VRM_VRT_sp06a_1] \	// 独、仏
				[VRMSG_I:VRM_VRT_sp06a_1] [VRMSG_S:VRM_VRT_sp06a_1] \	// 伊、西
				[VRMSG_K:VRM_VRT_sp06a_1] \							// 韓
				p:ＶＲステージ開始時処理							// 終了プロック
			}
		}


		// ＶＲウィンドウを表示する
		mesg ＶＲウィンドウ ＶＲウィンドウ君 開く

		// スタート時とクリア時に使用するカットインカメラ
		chara カメラ カットインカメラ		-c 0 -l 0 -p  0

		// スタート時のカメラ(必要な場合)
		chara カメラ設定 カットインカメラ \
			-c 1 \
			-p -4,3309,-4969 -t 18,-703,-8538 \
			-r 550,2044,0 -f 5369 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1
	}

	//------------------------------------------------------------
	// ステージ開始時処理
	//------------------------------------------------------------
	proc ＶＲステージ開始時処理 {
		#if d:DEBUG_PRINT
			print 'game_start!!!!!'
		#endif

		// プレイヤーやパッドの制御等を行う a_stdproc.hで定義
		@全ミッション共通ステージ開始時処理

		// カメラワークスタート(必要な場合)
		// 全体図
		chara カメラ設定 カットインカメラ \
			-c 1 \
			-p -129,42533,41020 -t -100,39879,36352 \
			-r 337,2044,0 -f 5369 \
			-a 200 \
			-i 4 4 d:START_CAMERA_CHANGE_TIME d:START_CAMERA_CHANGE_TIME \
			-s 1

		chara delay ディレイ \
			-time d:START_CAMERA_CHANGE_TIME \
			-exec {
				chara カメラ設定 カットインカメラ -s -1
			}

	}

	// ------------------------------------
	// クリア時の処理
	// ------------------------------------
	proc ＶＲクリア時処理 {
		#if d:DEBUG_PRINT
			print 'clear'
		#endif
		// 強制モーションを発動
		@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_1 d:SOUTH

		// クリア時にカメラアングルを変える

		if( $i:プレイヤー位置Ｙ > 3000 ) {
			print '上カメラじゃい'
			chara カメラ設定 クリア時カメラ \
				-c 0 \
				-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
				-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
				-r 98,1848,0 -f 5360 \
				-a 200 \
				-i 2 2 0 0 \
				-s 1
		} else {
			print '下カメラじゃい'
			chara カメラ設定 クリア時カメラ \
				-c 0 \
				-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
				-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
				//-r 90,1894,0 -f 5319 \
				-r 20,1856,0 -f 5700 \
				-a 200 \
				-i 2 2 0 0 \
				-s 1
		}

		chara delay クリアカメラディレイ -time 50 -exec {
			chara カメラ設定 クリア時カメラ \
				-c 1 \
				-p $i:カメラＸ位置 $i:カメラＹ位置 $i:カメラＺ位置 \
				-t $i:注視点Ｘ位置 $i:注視点Ｙ位置 $i:注視点Ｚ位置 \
				-r 98,1848,0 -f 5360 \
				-a 200 \
				-i 2 2 0 0 \
				-s 1
		}

	}



	// ------------------------------------
	// パラメータ系の変更
	// ------------------------------------
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT
			print 'localvar_init'
		#endif

		$$f:カレー喰われたフラグ = 0;
		$$b:死体数 = 0;
		$$i:敵兵状態 = 0;
		$$f:伏兵フラグＡ = 0;
		$$f:伏兵フラグＢ = 0;
		$$i:タイムチェック = 0;

		$$b:ゲームオーバータイプ = 0;		// a_stdproc.h で使用

		dim $$f:配列[ 7 ]
		dim $$w:出発時間[ 7 ]

		command	配列セット $$f:配列[0] {
			0,	0,	0,	0,	0,	0,	0
		}
		command	配列セット $$w:出発時間[0] {
			0,	0,	0,	0,	0,	0,	0
		}
	}
	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT
			print 'status_set'
		#endif

	// 初期装備の設定


		switch ( $s:選択プレイヤー ) {
			case ( タキシードスネーク ) {
				$w:武器最大数Ｒ[ d:武器:ＰＳＧ１－Ｔ ] = 250;
				$w:武器弾数Ｒ[ d:武器:ＰＳＧ１－Ｔ ] = 250;

				$w:武器最大数Ｒ[ d:武器:ＰＳＧ１ ] = 250;
				$w:武器弾数Ｒ[ d:武器:ＰＳＧ１ ] = 250;
			}
			default {
				$w:アイテム最大数Ｒ[ d:アイテム:ジアゼパム ] = 5;
				$w:アイテム数Ｒ[ d:アイテム:ジアゼパム ] = 5;
				$w:アイテム = d:アイテム:ジアゼパム	// ジアゼパム装備

				$w:武器最大数Ｒ[ d:武器:ＰＳＧ１－Ｔ ] = 250;
				$w:武器弾数Ｒ[ d:武器:ＰＳＧ１－Ｔ ] = 250;

				$w:武器最大数Ｒ[ d:武器:ＰＳＧ１ ] = 250;
				$w:武器弾数Ｒ[ d:武器:ＰＳＧ１ ] = 250;
			}
		}

		command シナリオ前武器変更 -number d:武器:ＰＳＧ１
		command シナリオ前装備変更 -number d:アイテム:双眼鏡


	}

	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif
	}



/*************************************************************************************/
// 敵兵や的の処理
/*************************************************************************************/
	proc コマンダー設定 {
		#if d:DEBUG_PRINT
			print 'commander_set'
		#endif

		chara コマンダー 敵兵セット \
			-w 警備兵コマンダー \
			-d １階 \
			-r 0,0,0 １階 \
			-c 0,0,0 １階 \
			-v [ene_plant_voice:01] \
			-z $i:敵標準麻酔持続 \
			-h $i:標準警戒時間 \
			-o $i:敵標準気絶持続 \
			-s (  d:ENE_STAGE_GPS \
				| d:ENE_STAGE_VR_ANOTHER \
				| d:ENE_STAGE_NO_APPER_EFFE \
				| d:ENE_STAGE_NO_NOTICE \
				| d:ENE_STAGE_NO_RUN_SMOOTH \
				| d:ENE_STAGE_ROOT_NO_LOOP \
				| d:ENE_STAGE_VRBOM_BIGDAM ) \
			-b 0 \
			-k 0 \
			-e 114 55 逆送兵到着 \
			-m d:ALERT_MODE_SENNYU
			//-m d:ALERT_MODE_KIKEN

		//mesg コマンダー 敵兵セット 危険レベル減らない

	}

	proc 逆送兵到着 {
		mesg 警備兵 警備兵:25 アクション終了
		mesg 警備兵 警備兵:25 ルート変更 115 0 0 0 １階
	}

	proc 警備兵コマンダー {
		#if d:DEBUG_PRINT
			print 'wccomm_set'
		#endif

		switch ( $s:選択プレイヤー ){
			case ( ライデン ) {
				chara 警備コマンダー wccomm -e { ライデン警備兵セット }
			}
			case ( スネーク ) {
				chara 警備コマンダー wccomm -e { スネーク警備兵セット }
			}
			case ( プリスキン ) {
				chara 警備コマンダー wccomm -e { プリスキン警備兵セット }
			}
			case ( タキシードスネーク ) {
				chara 警備コマンダー wccomm -e { タキシード警備兵セット }
			}
			case ( 前作スネーク ) {
				chara 警備コマンダー wccomm -e { 前作スネーク警備兵セット }
			}
		}
	}

	// a_stdproc.h で呼んでいる。
	proc ゲーム開始直後処理 {
		// 敵兵が動き出してからメッセージを送る
		print 'ゲーム開始直後処理'

		switch ( $s:選択プレイヤー ) {
			case ( スネーク ) {
				@スネークルート変更
			}
			case ( ライデン ) {
				@ライデンルート変更
			}
			case ( プリスキン ) {
				@プリスキンルート変更
			}
			case ( タキシードスネーク ) {
				@タキシードルート変更
			}
			case ( 前作スネーク ) {
				@前作スネークルート変更
			}
		}
	}

	proc コソコソ兵セット $:名前 $:ルート $:ノード {
		@VR_拡張警備兵 $:名前 $:ルート $:ノード d:ENE_STATUS_NORMAL d:ENE_STST_FAINT_EXIT 0 0 0 １階
	}


