	proc 添字チェック {
		if( $$b:添字 < 7 ) {
			if( $$f:配列[ $$b:添字 ] == 0 ) {
				return $$b:添字;
			} else {
				$$b:添字 = $$b:添字 + 1;
				@添字チェック
			}
		} else {
			command assert ( d:FALSE ) '配列オーバーです'
		}
	}


	proc タイム入力 {
		//$$b:添字 = `command rand 7`
		$$b:添字 = ( $i:プレイタイム % 7 );
		if( $$f:配列[ $$b:添字 ] == 0 ) {
			print '+'
			$$f:配列[ $$b:添字 ] = 1;
			$$w:出発時間[ $$b:添字 ] = $$w:タイム;
		} else {
			print '-'
			$$b:添字 = 0;
			@添字チェック
			$$f:配列[ $$b:添字 ] = 1;
			$$w:出発時間[ $$b:添字 ] = $$w:タイム;
		}
		print '添字'$$b:添字
		print 'タイム'$$w:タイム
	}

	proc プリスキンルート変更 {

		/*
		chara delay 敵兵出発ディレイ -time (60*1) -exec {
			mesg 警備兵 警備兵:01 アクション終了
			mesg 警備兵 警備兵:02 アクション終了
			mesg 警備兵 警備兵:03 アクション終了
			mesg 警備兵 警備兵:04 アクション終了
			mesg 警備兵 警備兵:05 アクション終了
			mesg 警備兵 警備兵:06 アクション終了
			mesg 警備兵 警備兵:07 アクション終了
		}
		*/

		$$w:タイム = ( $$w:タイム + ( $i:プレイタイム % 600 ) + 120 );
		@タイム入力
		$$w:タイム = ( $$w:タイム + ( $i:プレイタイム % 600 ) + 60 );
		@タイム入力
		$$w:タイム = ( $$w:タイム + ( $i:プレイタイム % 600 ) + 60 );
		@タイム入力
		$$w:タイム = ( $$w:タイム + ( $i:プレイタイム % 600 ) + 60 );
		@タイム入力
		$$w:タイム = ( $$w:タイム + ( $i:プレイタイム % 600 ) + 60 );
		@タイム入力
		$$w:タイム = ( $$w:タイム + ( $i:プレイタイム % 600 ) + 60 );
		@タイム入力
		$$w:タイム = ( $$w:タイム + ( $i:プレイタイム % 600 ) + 60 );
		@タイム入力

		chara delay 敵兵出発ディレイ -time $$w:出発時間[0] -exec {
			mesg 警備兵 警備兵:01 アクション終了
		}
		chara delay 敵兵出発ディレイ -time $$w:出発時間[1] -exec {
			mesg 警備兵 警備兵:02 アクション終了
		}
		chara delay 敵兵出発ディレイ -time $$w:出発時間[2] -exec {
			mesg 警備兵 警備兵:03 アクション終了
		}
		chara delay 敵兵出発ディレイ -time $$w:出発時間[3] -exec {
			mesg 警備兵 警備兵:04 アクション終了
		}
		chara delay 敵兵出発ディレイ -time $$w:出発時間[4] -exec {
			mesg 警備兵 警備兵:05 アクション終了
		}
		chara delay 敵兵出発ディレイ -time $$w:出発時間[5] -exec {
			mesg 警備兵 警備兵:06 アクション終了
		}
		chara delay 敵兵出発ディレイ -time $$w:出発時間[6] -exec {
			mesg 警備兵 警備兵:07 アクション終了
		}
	}

	proc 敵兵ＧＯ {
		switch ( $$b:添字 ) {
			case ( 0 ) {
				mesg 警備兵 警備兵:01 アクション終了
			}
			case ( 1 ) {
				mesg 警備兵 警備兵:02 アクション終了
			}
			case ( 2 ) {
				mesg 警備兵 警備兵:03 アクション終了
			}
			case ( 3 ) {
				mesg 警備兵 警備兵:04 アクション終了
			}
			case ( 4 ) {
				mesg 警備兵 警備兵:05 アクション終了
			}
			case ( 5 ) {
				mesg 警備兵 警備兵:06 アクション終了
			}
			case ( 6 ) {
				mesg 警備兵 警備兵:07 アクション終了
			}
		}
	}
/*************************************************************************************/
// ライデンルート
/*************************************************************************************/
	proc ライデン警備兵セット {
		@コソコソ兵セット 警備兵:01	01 00
		@コソコソ兵セット 警備兵:02	02 00
		@コソコソ兵セット 警備兵:03	03 00
		@コソコソ兵セット 警備兵:04	04 00
		@コソコソ兵セット 警備兵:05	05 00

		@コソコソ兵セット 警備兵:06	06 00
		@コソコソ兵セット 警備兵:07	07 00
		@コソコソ兵セット 警備兵:08	08 00

	}


	proc ライデンルート変更 {

		chara delay 敵兵出発ディレイ -time (60*1) -exec {
			mesg 警備兵 警備兵:01 アクション終了
			mesg 警備兵 警備兵:02 アクション終了
			mesg 警備兵 警備兵:03 アクション終了
			mesg 警備兵 警備兵:04 アクション終了
			mesg 警備兵 警備兵:05 アクション終了
		}
		chara delay 敵兵出発ディレイ -time (60*20) -exec {
			mesg 警備兵 警備兵:06 アクション終了
			mesg 警備兵 警備兵:07 アクション終了
			mesg 警備兵 警備兵:08 アクション終了

		}
	}

/*************************************************************************************/
// スネークルート
/*************************************************************************************/
	proc スネーク警備兵セット {
		// ビル巡回兵
#if	 d:CLEAR_CHECK
	// クリアチェック用 敵兵一人
		@コソコソ兵セット 警備兵:30	80 00
#else

	// 本番用
		@コソコソ兵セット 警備兵:91	59 02
		@コソコソ兵セット 警備兵:92	60 03
		@コソコソ兵セット 警備兵:93	61 04

	// １回目
		@コソコソ兵セット 警備兵:01	50 00
		@コソコソ兵セット 警備兵:02	51 00
		@コソコソ兵セット 警備兵:03	52 00
		@コソコソ兵セット 警備兵:04	53 00
		@コソコソ兵セット 警備兵:05	54 00
		@コソコソ兵セット 警備兵:06	55 00


		@コソコソ兵セット 警備兵:07	56 00
		@コソコソ兵セット 警備兵:08	57 00
		@コソコソ兵セット 警備兵:09	58 00

	// ２回目
		@コソコソ兵セット 警備兵:11	50 00
		@コソコソ兵セット 警備兵:12	51 00
		@コソコソ兵セット 警備兵:13	52 00
		@コソコソ兵セット 警備兵:14	53 00
		@コソコソ兵セット 警備兵:15	54 00
		@コソコソ兵セット 警備兵:16	55 00

		@コソコソ兵セット 警備兵:20	70 00
		@コソコソ兵セット 警備兵:21	71 00

		@コソコソ兵セット 警備兵:22	56 00
		@コソコソ兵セット 警備兵:23	57 00
		@コソコソ兵セット 警備兵:24	58 00
	// 伏兵
		@コソコソ兵セット 警備兵:31	82 00
		@コソコソ兵セット 警備兵:32	83 00

	// サボり兵
		@コソコソ兵セット 警備兵:30	80 00
#endif
	}

	proc スネークルート変更 {
		chara delay 敵兵出発ディレイ -time (60*1) -exec {
			mesg 警備兵 警備兵:01 アクション終了
			mesg 警備兵 警備兵:02 アクション終了
			mesg 警備兵 警備兵:03 アクション終了
			mesg 警備兵 警備兵:04 アクション終了
			mesg 警備兵 警備兵:05 アクション終了
			mesg 警備兵 警備兵:06 アクション終了
			mesg 警備兵 警備兵:07 アクション終了
			mesg 警備兵 警備兵:08 アクション終了
			mesg 警備兵 警備兵:09 アクション終了

		}

		chara delay 敵兵出発ディレイ -time (60*20) -exec {
			mesg 警備兵 警備兵:11 アクション終了
			mesg 警備兵 警備兵:12 アクション終了
			mesg 警備兵 警備兵:13 アクション終了
			mesg 警備兵 警備兵:14 アクション終了
			mesg 警備兵 警備兵:15 アクション終了
			mesg 警備兵 警備兵:16 アクション終了
		}

		// 隠れ兵が殺されていたら伏兵が代理を勤める
		chara delay 伏兵出発ディレイ -time 1053 -exec {
			// 伏兵Ａ
			command ゲット敵兵状態 警備兵:01 $$i:敵兵状態
			if( $$i:敵兵状態 & 0x80000000 ) {
				$$f:伏兵フラグＡ = 1;
				mesg 警備兵 警備兵:31 アクション終了
			}
			// 伏兵Ｂ
			command ゲット敵兵状態 警備兵:02 $$i:敵兵状態
			if( $$i:敵兵状態 & 0x80000000 ) {
				$$f:伏兵フラグＢ = 1;
				mesg 警備兵 警備兵:32 アクション終了
			}
		}
		chara delay 伏兵出発ディレイ -time 2195 -exec {
			// 伏兵Ａ
			command ゲット敵兵状態 警備兵:11 $$i:敵兵状態
			if( ( $$i:敵兵状態 & 0x80000000 ) && ( !$$f:伏兵フラグＡ ) ) {
				mesg 警備兵 警備兵:31 アクション終了
			}
			// 伏兵Ｂ
			command ゲット敵兵状態 警備兵:12 $$i:敵兵状態
			if( ( $$i:敵兵状態 & 0x80000000 ) && ( !$$f:伏兵フラグＢ ) ) {
				mesg 警備兵 警備兵:32 アクション終了
			}
		}
		// 最後まで伏兵が出現しなかったら強制的に出現させる
		chara delay 伏兵出発ディレイ -time 3100 -exec {
			if( !$$f:伏兵フラグＡ ) {
				mesg 警備兵 警備兵:31 アクション終了
			}
			if( !$$f:伏兵フラグＢ ) {
				mesg 警備兵 警備兵:32 アクション終了
			}
		}

		//////////////////////////////////////
		// デバッグ設定
		// 目印ポスターセット
		//@デバッグポスター 警備兵:01
	}

	proc スネーク用敵兵死亡プロック {
		$$b:死体数 = ( $$b:死体数 + 1 )
		print '撃ち殺しました'
		print '死体数：'$$b:死体数

		switch ( $$b:死体数 ) {
			case ( 9 ) {
				mesg 警備兵 警備兵:20 アクション終了
				mesg 警備兵 警備兵:21 アクション終了
			}
			case ( 12 ) {
				// サボり兵スタート
				mesg 警備兵 警備兵:30 アクション終了
				mesg 警備兵 警備兵:30 ルート変更 81 0 0 0 １階
			}
			case ( 13 ) {
				mesg 警備兵 警備兵:22 アクション終了
			}
			case ( 14 ) {
				mesg 警備兵 警備兵:23 アクション終了
			}
			case ( 15 ) {
				mesg 警備兵 警備兵:24 アクション終了
			}
		}
	}

/*************************************************************************************/
// 死亡プロック
/*************************************************************************************/
	proc 敵兵死亡プロック {
		#if d:DEBUG_PRINT
			print 'やられたー'
		#endif

		switch ( $s:選択プレイヤー ) {
			case ( スネーク ) {
				@スネーク用敵兵死亡プロック
			}
			case ( 前作スネーク ) {
				@前作スネーク用敵兵死亡プロック
			}
		}
	}

	proc デバッグポスター $:名前 {
		chara 装備品Ｃ ポスターＡ \
			-n w01a_ldr02 \
			-y $:名前 \
			-z 0 \
			-x 500 0 -1000 \
			-r 1024 0 0 \
			-f 1

		chara 装備品Ｃ ポスターＡ \
			-n w01a_ldr02 \
			-y $:名前 \
			-z 0 \
			-x -500 1500 0 \
			-r 0 2048 0 \
			-f 1
	}

/*********************************************************************************/
// ディフェンスポイント設置
/*********************************************************************************/
	proc ディフェンスポイント設置 {
		#if d:DEBUG_PRINT
			print 'mrl set'
		#endif

		// 元気なルート巡回兵がトラップに入ったらプロック実効
		chara ルート兵チェック カレーチェック \
			-proc カレー喰われた \
			-trap 3491980

		switch ( $s:選択プレイヤー ) {
			case ( プリスキン ) {
				@カレー設置
			}
			case ( タキシードスネーク ) {
				@ラーメン設置
			}
			case ( 前作スネーク ) {
				@ダンボール設置
			}
			case ( スネーク ) {
				@メリル設置
			}
			case ( ライデン ) {
				@エマ設置
			}
		}
	}

	proc メリル設置 {
		chara あたり付き人形 メリル人形 \
			-route 0 0 \
			-kms mrl_def_sh_mt \ //EVMを表示する場合はダミーKMSが必要
			-mar mrl_sp06a \
			-number 0 1 1 1 1 1 1 \		//移動 死亡 胴体 右手 左手 右足 左足 の順
			-x	メリル死亡 \
			-voice	d:se_code:SD_V_ORGA07 \	// 死亡
					d:se_code:SD_V_ORGA06 d:se_code:SD_V_ORGA05 \ // ダメージ
		//	-status 0x04 \
		//	-item	usp 6 \
			-life	4
		//	-face	$s:話者名 // ストリーム口パク
	}

	proc エマ設置 {
		chara あたり付き人形 エマ人形 \
			-route 150 0 \
			-kms ema_def_sh_mt \ //EVMを表示する場合はダミーKMSが必要
			-mar emma_sp06a \
			-number 0 1 1 1 1 1 1 \		//移動 死亡 胴体 右手 左手 右足 左足 の順
			-x	メリル死亡 \
			-voice	d:se_code:SD_V_EMAOUT01 \	// 死亡
					d:se_code:SD_V_EMADMG01 d:se_code:SD_V_EMADMG02 \ // ダメージ
			-item	ema_glasses_mt 12 \
			-life	4 \
			-gage	1	// エマゲージ

		chara エマ装備 エマ装備品 -name エマ人形
			
	}
	
	proc カレー設置 {
		chara プットオブジェ カレー -m currie \
			-r 0,0,0 \
			-p 0 1 -7500 \
			-s 100,100,100 \
			-l d:LT2_NAME
	}
	proc ラーメン設置 {
		chara プットオブジェ ラーメン -m rarmen \
			-r 0,0,0 \
			-p 0 1 -7500 \
			-s 100,100,100 \
			-l d:LT2_NAME

		chara 湯気セット 湯気 \
			-pos 0 100 -7500 \
			-r 400
	}
	proc ダンボール設置{

		// オブジェセット
		chara プットオブジェ ダンボール -m cardboard \
			-r 0,512,0 \
			-p 0 1 -7500 \
			-s 100,100,100 \
			-l d:LT2_NAME
		// ハザードセット
		command 追加ＨＺＸグループ登録 \
			-hzx_id 0 \
			-add_id 3
	}

	proc カレー喰われた {

		$$i:タイムチェック;
		$$i:タイムチェック = `command ＶＲゲットタイム`
		print '$$i:タイムチェック'$$i:タイムチェック

		// デバッグ用にタイムが９９分以上の時はカレーは食べられない
		if( $$f:カレー喰われたフラグ == 0 && $$i:タイムチェック <= (60*60*99) ) {

			$$f:カレー喰われたフラグ = 1;
			#if d:DEBUG_PRINT
				print 'カレー喰われたー'
				print 'パッド操作奪う'
			#endif
			
			// タイマーストップ
			command ＶＲタイマーポーズ

			// 武器を外す
			$w:武器 = d:武器:素手
			$w:アイテム = d:アイテム:素手

			// パッド操作不能
			command パッド操作 -release

			// フェードアウト
			command セットサウンドコード -c d:SNG_FOUTS_SS

			chara カメラ設定 ゲームオーバーカメラ \
				-c 1 \
				-p 2732,5390,-2000 -t -824,192,-8413 \
				-r 402,2378,0 -f 8988 \
				-a 200 \
				-i 2 2 0 0 \
				-s 1

			chara delay ゲームオーバー処理ディレイ -time 180 -exec {
				@ミッション共通ゲームオーバー処理
				//chara カメラ設定 ゲームオーバーカメラ -s 0
			}
		}
	}

	proc メリル死亡 {

		chara カメラ設定 メリル死亡カメラ \
			-c 1 \
			-p -150,2325,-4895 -t -126,-1315,-8838 \
			-r 486,2044,0 -f 5366 \
			-a 200 \
			-i 0 0 0 0 \
			-s 1
		@A_装備武器 d:武器:素手
		$$b:ゲームオーバータイプ = 1;
		@ミッション共通ゲームオーバー処理 //(45+72)
	}


/*************************************************************************************/
// ＢＧＭの設定
/*************************************************************************************/
	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT
			print 'bgm_set'
		#endif

		chara ＢＧＭマネージャー ＢＧＭマネ
	}

/*************************************************************************************/
// エルード設定
/*************************************************************************************/
	proc エルード設定 {

	/**************************/
	// １Ｆ 西側設定
		// エルード
		trap el:003 d:PLAYER \
			-mask いる \
			-button d:ACTION_BUTTON \
			-state d:TRP_STATE_STAND, d:TRP_STATE_CAUTION \	//立ち状態or張り付き
			-exec {
				@西向きビヨンド発動 $1 -1500 $6 18500 21500 d:BY_NOFOOTSHADOW
			}

		// エルード入るカメラ
		trap el:003 d:PLAYER \
			-mask いる \
			-state d:TRP_STATE_FORCE \
			-dir d:WEST 256 \
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 527,1616,0 -f 5366 \
					-a 200 \
					-i 1 -1 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s 1
			}

		// エルード中カメラ
		trap el:003 d:PLAYER \
			-mask ？ \
			-and \
			-state d:TRP_STATE_ELUDE d:TRP_STATE_ELUDE_FALL \
			-dir d:EAST 256 d:EAST 256 \	//方向指定
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 239,1819,0 -f 5366 \
					-a 200 \
					-i 2 -1 0 0 \
					-s $3
			}

		// 落下キャッチ
		trap el:004 d:PLAYER \
			-mask いる \
			-key d:PAD_X \
			-state d:TRP_STATE_ELUDE_FALL \
			-exec {
				print 'おちてます'
				@エルード落下キャッチ \
						el:003 \			// 上トラップ
						$1 \				// 下トラップ
						0 \					// 床高さ
						-1500 $5 $6 \		// プレイヤー位置
						d:EAST \			// 落下後に張り付く方向
						d:BY_NOFOOTSHADOW	// フラグ
			}

	/**************************/
	// １Ｆ 東側設定
		trap el:005 d:PLAYER \
			-mask いる \
			-button d:ACTION_BUTTON \
			-state d:TRP_STATE_STAND, d:TRP_STATE_CAUTION \	//立ち状態or張り付き
			-exec {
				@東向きビヨンド発動 $1 1500 $6 18500 21500 d:BY_NOFOOTSHADOW
			}

		// エルード入るカメラ
		trap el:005 d:PLAYER \
			-mask いる \
			-state d:TRP_STATE_FORCE \
			-dir d:EAST 256 \
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 540,2383,0 -f 5374 \
					-a 200 \
					-i 1 -1 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s 1
			}

		// エルード中カメラ
		trap el:005 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_ELUDE \
			-dir d:WEST 256 \	//方向指定
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 202,2201,0 -f 5374 \
					-a 200 \
					-i 2 -1 0 0 \
					-s $3
			}

		// 落下キャッチ
		trap el:006 d:PLAYER \
			-mask いる \
			-key d:PAD_X \
			-state d:TRP_STATE_ELUDE_FALL \
			-exec {
				print 'おちてます'
				@エルード落下キャッチ \
						el:005 \			// 上トラップ
						$1 \				// 下トラップ
						0 \					// 床高さ
						1500 $5 $6 \		// プレイヤー位置
						d:WEST \			// 落下後に張り付く方向
						d:BY_NOFOOTSHADOW	// フラグ
			}

	/**************************/
	// １Ｆ 南側設定
		trap el:007 d:PLAYER \
			-mask いる \
			-button d:ACTION_BUTTON \
			-state d:TRP_STATE_STAND, d:TRP_STATE_CAUTION \	//立ち状態or張り付き
			-exec {
				@南向きビヨンド発動 $1 21500 $4 -1500 1500 d:BY_NOFOOTSHADOW
			}

		// エルード入るカメラ
		trap el:007 d:PLAYER \
			-mask いる \
			-state d:TRP_STATE_FORCE \
			-dir d:SOUTH 256 \
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 436,2223,0 -f 6005 \
					-a 200 \
					-i 1 -1 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s 1
			}

		// エルード中カメラ
		trap el:007 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_ELUDE \
			-dir d:NORTH 256 \	//方向指定
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 285,2045,0 -f 5374 \
					-a 200 \
					-i 2 -1 0 0 \
					-s $3
			}

		// 落下キャッチ
		trap el:008 d:PLAYER \
			-mask いる \
			-key d:PAD_X \
			-state d:TRP_STATE_ELUDE_FALL \
			-exec {
				print 'おちてます'
				@エルード落下キャッチ \
						el:007 \			// 上トラップ
						$1 \				// 下トラップ
						0 \					// 床高さ
						$4 $5 21500 \		// プレイヤー位置
						d:NORTH \			// 落下後に張り付く方向
						d:BY_NOFOOTSHADOW	// フラグ
			}



	/**************************/
	// ２Ｆ 西側設定
		trap el:004 d:PLAYER \
			-mask いる \
			-button d:ACTION_BUTTON \
			-state d:TRP_STATE_STAND, d:TRP_STATE_CAUTION \	//立ち状態or張り付き
			-exec {
				@西向きビヨンド発動 $1 -1500 $6 18500 21500 d:BY_NOFOOTSHADOW
			}

		// エルード入るカメラ
		trap el:004 d:PLAYER \
