		chara delay 敵兵出発ディレイ -time (d:E_WAIT_TIME*4) -exec {
			mesg 警備兵 警備兵:14 アクション終了
		}
		chara delay 敵兵出発ディレイ -time (d:E_WAIT_TIME*5) -exec {
			mesg 警備兵 警備兵:15 アクション終了
		}
		chara delay 敵兵出発ディレイ -time (d:E_WAIT_TIME*6) -exec {
