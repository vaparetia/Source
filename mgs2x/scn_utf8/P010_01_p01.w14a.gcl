// デモ終了時プロック
proc P010_01_p01終了 {
	if ($f:ローポリ劇場フラグ == d:TRUE) {
		// ローポリ劇場中
		@mv_lowpoly

	} else {
		// 通常ゲーム中
		@デモ終了時シネマスクリーンオフ
		mesg デモキャンセルチェック デモキャンセル kill
		#if d:DEMO_SKIP_ENABLE
		#else
			eval($w:p_story = d:ST:P010_01_P01ヴァンプ遭遇１ポリゴンデモ１終了)
			print '$w:p_story = d:ST:P010_01_P01ヴァンプ遭遇１ポリゴンデモ１終了'
		#endif

		chara delay ディレイ \
			-time 1 \ 
			-exec{
				restart
			}
	}
}

proc P010_01_p02終了 {
	@デモ終了時シネマスクリーンオフ
	mesg デモキャンセルチェック デモキャンセル kill
	#if d:DEMO_SKIP_ENABLE
	#else
		eval($w:p_story = d:ST:P010_01_P02ヴァンプ遭遇１ポリゴンデモ２終了)
		print '$w:p_story = d:ST:P010_01_P02ヴァンプ遭遇１ポリゴンデモ２終了'
	#endif

	@サウンドマネージャー_mesg_2

	chara delay ディレイ \
		-time 1 \ 
		-exec{
			restart
		}
}

proc P010_02_m01終了 {
	@デモ終了時シネマスクリーンオフ
	#if d:DEMO_SKIP_ENABLE
	#else
		eval($w:p_story = d:ST:P010_02_M01ヴァンプ遭遇２ムービーデモ１終了)
	#endif
	restart
}

proc P010_03_p02終了 {
