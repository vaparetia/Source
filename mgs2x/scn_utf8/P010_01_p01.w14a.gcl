//=============================================================================
// define
//=============================================================================
// 各gclで必要なdefine
// ------------------------------------
// モード
#define		STAGE_PLANT		1		// 共通プロック切り分け用
#define		DEMO_STAGE		1		// デモステージかどうかで起動するキャラを切り分ける

//-----------------------------------------------------------------------------
// スイッチ
#define SCREENSHOT 0			// スクリーンショット
#define KEYBOARD   0			// ＵＳＢキーボード

//-----------------------------------------------------------------------------
// マップ関係
//#define HZX_NAME   d00a3
#define HZX_NAME   dp14a
#define KMS_NAME0  w14a0
#define KMS_NAME1  w14a1
#define KMS_NAME2  w14a2
#define CEIL_NAME0  w14a0r
#define CEIL_NAME1  w14a1r
#define LT2_NAME   w14a
#define DOOR_NAME1    w14a_dr00			// ＡＢ連絡橋への扉
#define DOOR_NAME2    w14a_dr01			// ＢＣ連絡橋への扉

#define DOOR_NAME4    w14a_hdr01		// 変電盤扉１
#define DOOR_NAME5    w14a_hdr02		// 変電盤扉２
#define DOOR_NAME6    w14a_hdr03		// 変電盤扉３
#define DOOR_NAME7    w14a_hdr04		// 変電盤扉３

// includes
// ------------------------------------
#include "5sec_bfr_demo.h"
#include "demo_stdch.h"
#include "demo_stdch2.h"
#include "demo_vardef.h"
#include "story.h"
#include "sload.h"
#include "p_force_cdc.ch"

#if d:KEYBOARD 
#include "usbkbd.h"
#endif

#if d:PLANT_DEMO_ALL_SKIP
	#define		DEMO_SKIP_ENABLE 1
#else
	#define		DEMO_SKIP_ENABLE 0
#endif

#define define_P010_01_p01 1

#if d:MGS2_DEMO
	#define DEMO_SET_STAGE 6	// 再生するステージを切り替える
								// 0 : p010_01_01(g/n)
								// 1 : p010_01_02
								// 2 : p010_03_02
								// 3 : p010_05_03
								// 4 : p010_09_04(a/b)
								// 5 : p010_10_05
								// 6 : 他(?)
#endif

// キャスティングシアター対応。
#include "lowpoly.h"
@ローポリ設定

// マップ設定
// ------------------------------------
chara マップ 変電室 -h d:HZX_NAME -l d:LT2_NAME

command マップ設定 変電室 -set {

//	デモ環境かゲーム環境かで起動を読み分ける。
// ------------------------------------
#if d:MGS2_DEMO

	// 不要プログラムの起動阻害
	// 血のり有り無し
	#if d:define_P010_01_p01
		eval($s:d_num = P010_01_p01)
	#else
		eval($s:d_num = P010_01_p02)
	#endif

chara デモアクトデバッグ demodebug  -i t:p010_10_p05 -d 'p010_10_p05' -l   \
		-p 漏電花火オフ 漏電花火オン \
		   ステージ血のり無し→血のり有り \
		   海軍大佐オフ 海軍大佐オン \
		   ヴァンプ下階影オン ヴァンプ下階影オフ ヴァンプ壊れ前上階影オン ヴァンプ上階影オフ \
		   ライデン上階m4a_rai_subオン \
		   ライデン上階銃所持オン ライデン上階銃所持オフ ライデン上階素手オン ライデン上階素手オフ \
		   イロコイ上階m4a_nm_iroオン イロコイ上階m4a_nm_iroオフ \
		   北面の壁壊れる １Ｆ西側の壁壊れる

	if (d:DEMO_SET_STAGE == 0) {
		eval($s:d_num = P010_01_p01)
	} else if (d:DEMO_SET_STAGE == 1) {
		eval($s:d_num = P010_01_p02)
	} else if (d:DEMO_SET_STAGE == 2) {
		eval($s:d_num = P010_03_p02)
	} else if (d:DEMO_SET_STAGE == 3) {
		eval($s:d_num = P010_05_p03)
	} else if (d:DEMO_SET_STAGE == 4) {
		eval($s:d_num = P010_09_p04)
	} else if (d:DEMO_SET_STAGE == 5) {
		eval($s:d_num = P010_10_p05)
	} else {
	}

#else

if( $w:p_story == d:ST:P010_01_P01ヴァンプ遭遇１ポリゴンデモ１開始 ) {
	print '$w:p_story = ST:P010_01_P01ヴァンプ遭遇１ポリゴンデモ１開始'

	/* SEALSがヴァンプにやられる　プリスキン登場　の前半 */

	// デモ特有の変数代入
	eval($s:d_num = P010_01_p01)

	@デモモデル差し替え処理
	proc デモ再生_P010_01_p01 {
		if( (($w:武器弾数Ｒ[d:武器:Ｍ９] >= 0) || \
			($w:武器弾数Ｒ[d:武器:ソコム] >= 0)) && \
			($f:ローポリ劇場フラグ == d:FALSE) ){
			// 武器を持っている
/*
			// 武器は持っているが装備していない場合があるので、その対処。
			if(($w:武器 != d:武器:Ｍ９) && ($w:武器 != d:武器:ソコム)) {
				// 武器は持っているがそれを装備していない。
				if($w:武器弾数Ｒ[d:武器:ソコム] >= 0) {
					// ソコムを持っているのでソコムを持たせる
					eval ($w:武器 = d:武器:ソコム)
				}else{
					// Ｍ９しか持っていないのでＭ９を持たせる
					eval ($w:武器 = d:武器:Ｍ９)
				}
			}
*/
			chara demo デモ再生 \
				-i t:p010_01_p01g \
				-p 漏電花火オフ 漏電花火オン \
				   ステージ血のり無し→血のり有り \
				   海軍大佐オフ 海軍大佐オン \
				   ヴァンプ下階影オン ヴァンプ下階影オフ ヴァンプ壊れ前上階影オン ヴァンプ上階影オフ \
				   ライデン上階m4a_rai_subオン \
				   ライデン上階銃所持オン ライデン上階銃所持オフ ライデン上階素手オン ライデン上階素手オフ \
				   イロコイ上階m4a_nm_iroオン イロコイ上階m4a_nm_iroオフ \
				   北面の壁壊れる １Ｆ西側の壁壊れる \
				-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
				-next P010_01_p01終了

		} else {
			// 武器を持っていない。

			chara demo デモ再生 \
				-i t:p010_01_p01n \
				-p 漏電花火オフ 漏電花火オン \
				   ステージ血のり無し→血のり有り \
				   海軍大佐オフ 海軍大佐オン \
				   ヴァンプ下階影オン ヴァンプ下階影オフ ヴァンプ壊れ前上階影オン ヴァンプ上階影オフ \
				   ライデン上階m4a_rai_subオン \
				   ライデン上階銃所持オン ライデン上階銃所持オフ ライデン上階素手オン ライデン上階素手オフ \
				   イロコイ上階m4a_nm_iroオン イロコイ上階m4a_nm_iroオフ \
				   北面の壁壊れる １Ｆ西側の壁壊れる \
				-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
				-next P010_01_p01終了
		}
	}

	@デモ再生_P010_01_p01

} else if(d:ST:P010_01_P01ヴァンプ遭遇１ポリゴンデモ１終了 <= $w:p_story && \
			$w:p_story < d:ST:P010_01_P02ヴァンプ遭遇１ポリゴンデモ２開始) {
	eval($w:p_story = d:ST:P010_01_P02ヴァンプ遭遇１ポリゴンデモ２開始)
	print '$w:p_story = ST:P010_01_P02ヴァンプ遭遇１ポリゴンデモ２開始'

	/* SEALSがヴァンプにやられ、プリスキン登場　の後半 */

	// デモ特有の変数代入
	eval($s:d_num = P010_01_p02)

	@サウンドマネージャーセット
	@サウンドマネージャー_mesg_1

	@デモモデル差し替え処理
	proc デモ再生_P010_01_p02 {
		chara demo デモ再生 \
			-i t:p010_01_p02 \
			-p 漏電花火オフ 漏電花火オン \
			   ステージ血のり無し→血のり有り \
			   海軍大佐オフ 海軍大佐オン \
			   北面の壁壊れる １Ｆ西側の壁壊れる \
			-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
			-next P010_01_p02終了
	}

	@デモ再生_P010_01_p02

} else if(d:ST:P010_01_P02ヴァンプ遭遇１ポリゴンデモ２終了 <= $w:p_story && \
			$w:p_story < d:ST:P010_02_M01ヴァンプ遭遇２ムービーデモ１開始) {
	eval($w:p_story = d:ST:P010_02_M01ヴァンプ遭遇２ムービーデモ１開始)
	print '$w:p_story = ST:P010_02_M01ヴァンプ遭遇２ムービーデモ１開始'

	/* フォース２１のムービー */

	// デモ特有の変数代入
	eval($s:d_num = P010_02_m01)

	chara MOVIE再生 p010_02_m01 -file t:p010_02_m01 -top 0, d:MOVIE_TOP_Y -size 512, 320 -proc P010_02_m01終了

} else if(d:ST:P010_02_M01ヴァンプ遭遇２ムービーデモ１終了 <= $w:p_story && \
			$w:p_story < d:ST:P010_03_P02ヴァンプ遭遇３ポリゴンデモ２開始) {
	eval($w:p_story = d:ST:P010_03_P02ヴァンプ遭遇３ポリゴンデモ２開始)
	print '$w:p_story = ST:P010_03_P02ヴァンプ遭遇３ポリゴンデモ２開始'

	/* ナノマシン通信するライデン */

	// デモ特有の変数代入
	eval($s:d_num = P010_03_p02)

	@サウンドマネージャーセット
	@サウンドマネージャー_mesg_1

	@デモモデル差し替え処理
	proc デモ再生_P010_03_p02 {
		chara demo デモ再生 \
			-i t:p010_03_p02 \
//			-i t:data_dummy_raiden \
			-p 漏電花火オフ 漏電花火オン \
			   ステージ血のり無し→血のり有り \
			   海軍大佐オフ 海軍大佐オン \
			   北面の壁壊れる １Ｆ西側の壁壊れる \
			-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
			-next P010_03_p02終了
	}

	@デモ再生_P010_03_p02

} else if(d:ST:P010_03_P02ヴァンプ遭遇３ポリゴンデモ２終了 <= $w:p_story && \
			$w:p_story < d:ST:P010_04_R01ヴァンプ遭遇４無線デモ１開始) {
	eval($w:p_story = d:ST:P010_04_R01ヴァンプ遭遇４無線デモ１開始)
	print '$w:p_story = ST:P010_04_R01ヴァンプ遭遇４無線デモ１開始'

	/* 大佐強制コール　プリスキンのことを報告 */

	// デモ特有の変数代入
	eval($s:d_num = P010_04_r01)

	@rt_P010_04_R01ヴァンプ遭遇４無線デモ１
	/*
	proc P010_04_r01終了 {
		eval($w:p_story = d:ST:P010_04_R01ヴァンプ遭遇４無線デモ１終了)
		restart
	}
	*/

} else if(d:ST:P010_04_R01ヴァンプ遭遇４無線デモ１終了 <= $w:p_story && \
			$w:p_story < d:ST:P010_05_P03ヴァンプ遭遇５ポリゴンデモ３開始) {
	eval($w:p_story = d:ST:P010_05_P03ヴァンプ遭遇５ポリゴンデモ３開始)
	print '$w:p_story = ST:P010_05_P03ヴァンプ遭遇５ポリゴンデモ３開始'

	/* 海軍大佐の右腕が無い */

	// デモ特有の変数代入
	eval($s:d_num = P010_05_p03)

	@デモモデル差し替え処理
	proc デモ再生_P010_05_p03 {
		chara demo デモ再生 \
			-i t:p010_05_p03 \
			-p 漏電花火オフ 漏電花火オン \
			   ステージ血のり無し→血のり有り \
			   海軍大佐オフ 海軍大佐オン \
			   北面の壁壊れる １Ｆ西側の壁壊れる \
			-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
			-next P010_05_p03終了
	}

	@デモ再生_P010_05_p03

} else if(d:ST:P010_05_P03ヴァンプ遭遇５ポリゴンデモ３終了 <= $w:p_story && \
			$w:p_story < d:ST:P010_06_M02ヴァンプ遭遇６ムービーデモ２開始) {
	eval($w:p_story = d:ST:P010_06_M02ヴァンプ遭遇６ムービーデモ２開始)
	print '$w:p_story = ST:P010_06_M02ヴァンプ遭遇６ムービーデモ２開始'

	/* デッドセル紹介ムービー */

	// デモ特有の変数代入
	eval($s:d_num = P010_06_m02)

	chara MOVIE再生 p010_06_m02 -file t:p010_06_m02 -top 0, d:MOVIE_TOP_Y -size 512, 320 -proc P010_06_m02終了

} else if(d:ST:P010_06_M02ヴァンプ遭遇６ムービーデモ２終了 <= $w:p_story && \
			$w:p_story < d:ST:P010_07_M03ヴァンプ遭遇７ムービーデモ３開始) {
	eval($w:p_story = d:ST:P010_07_M03ヴァンプ遭遇７ムービーデモ３開始)
	print '$w:p_story = ST:P010_07_M03ヴァンプ遭遇７ムービーデモ３開始'

	/* タンカー編の映像ムービー */

	// デモ特有の変数代入
	eval($s:d_num = P010_07_m03)

	chara MOVIE再生 p010_07_m03 -file t:p010_07_m03 -top 0, d:MOVIE_TOP_Y -size 512, 320 -proc P010_07_m03終了

} else if(d:ST:P010_07_M03ヴァンプ遭遇７ムービーデモ３終了 <= $w:p_story && \
			$w:p_story < d:ST:P010_08_M04ヴァンプ遭遇８ムービーデモ４開始) {
	eval($w:p_story = d:ST:P010_08_M04ヴァンプ遭遇８ムービーデモ４開始)
	print '$w:p_story = ST:P010_08_M04ヴァンプ遭遇８ムービーデモ４開始'

	/* 敵兵の正体についての説明 */

	// デモ特有の変数代入
	eval($s:d_num = P010_08_m04)

	chara MOVIE再生 p010_08_m04 -file t:p010_08_m04 -top 0, d:MOVIE_TOP_Y -size 512, 320 -proc P010_08_m04終了

} else if(d:ST:P010_08_M04ヴァンプ遭遇８ムービーデモ４終了 <= $w:p_story && \
			$w:p_story < d:ST:P010_09_P04ヴァンプ遭遇９ポリゴンデモ４開始) {
	eval($w:p_story = d:ST:P010_09_P04ヴァンプ遭遇９ポリゴンデモ４開始)
	print '$w:p_story = ST:P010_09_P04ヴァンプ遭遇９ポリゴンデモ４開始'

	/* タバコ　髭剃り交換 */

	// デモ特有の変数代入
	eval($s:d_num = P010_09_p04)

	@デモモデル差し替え処理
	proc デモ再生_P010_09_p04 {
		// 髭剃りなし
		if($w:アイテム数Ｒ[d:アイテム:髭剃り] <= 0){
			chara demo デモ再生 \
				-i t:p010_09_p04a \
				-p 漏電花火オフ 漏電花火オン \
				   ステージ血のり無し→血のり有り \
				   海軍大佐オフ 海軍大佐オン \
				   北面の壁壊れる １Ｆ西側の壁壊れる \
				-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
				-next P010_09_p04終了

		// 髭剃りあり
		} else {
			chara demo デモ再生 \
				-i t:p010_09_p04b \
				-p 漏電花火オフ 漏電花火オン \
				   ステージ血のり無し→血のり有り \
				   海軍大佐オフ 海軍大佐オン \
				   北面の壁壊れる １Ｆ西側の壁壊れる \
				-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
				-next P010_09_p04終了

			// デモの中で髭剃りをスネークに渡す。
			eval($w:アイテム数Ｒ[d:アイテム:髭剃り] = 0)
			eval($w:プレイヤーフラグ = $w:プレイヤーフラグ | d:PL_GAVE_SHAVER_TO_SNAKE)

		}
	}

	@デモ再生_P010_09_p04

} else if(d:ST:P010_09_P04ヴァンプ遭遇９ポリゴンデモ４終了 <= $w:p_story && \
			$w:p_story < d:ST:P010_10_P05ヴァンプ遭遇１０ポリゴンデモ５開始) {
	eval($w:p_story = d:ST:P010_10_P05ヴァンプ遭遇１０ポリゴンデモ５開始)
	print '$w:p_story = ST:P010_10_P05ヴァンプ遭遇１０ポリゴンデモ５開始'

	/* 本名は平凡ダ… */

	// デモ特有の変数代入
	eval($s:d_num = P010_10_p05)

	@デモモデル差し替え処理
	proc デモ再生_P010_10_p05 {
		chara demo デモ再生 \
			-i t:p010_10_p05 \
//			-i t:data_dummy_raiden \
			-p 漏電花火オフ 漏電花火オン \
			   ステージ血のり無し→血のり有り \
			   海軍大佐オフ 海軍大佐オン \
			   北面の壁壊れる １Ｆ西側の壁壊れる \
			-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
			-next P010_10_p05終了
	}

	@デモ再生_P010_10_p05

}

// 共通して使用するもの
	chara デモキャンセルチェック デモキャンセル \
		-p demo_cancel

#endif


// 以下、諸々セット
//-----------------------------------------------------------
	// 無線ではシネマスクリーン起動しない
	if($s:d_num != P010_04_r01){
		@シネマスクリーンセット
	}


	if( ($s:d_num != P010_02_m01) && ($s:d_num != P010_04_r01) && \
		($s:d_num != P010_06_m02) && ($s:d_num != P010_07_m03) && \
		($s:d_num != P010_08_m04) ) {

		//----- 基本設定
		@常駐キャラ設定						// stdch.hで定義
		@変電室ステージセット
		@天井君設定

		// ヴァンプ遭遇デモで壁壊れる
		if($s:d_num == P010_01_p01){
			@壊れ前壁セット
		} else {
			@壊れ後壁セット
		}

		//----- オブジェクト
		@ノード端末設定
		@ドア設定
		@アイテム設定
		@その他オブジェクト設定
		@変電板の扉セット

		//----- フォグ
		@フォグ設定

		// リアル影セット
		// 010620現在、ヴァンプ遭遇１でのみ使用。
		// 010904現在、以下のデモで使用。
		if (($s:d_num == P010_01_p01) || \
			($s:d_num == P010_01_p02) || \
			($s:d_num == P010_03_p02) || \
			($s:d_num == P010_05_p03) || \
			($s:d_num == P010_09_p04) || \
			($s:d_num == P010_10_p05)) {
			@リアル影セット
		}

		if (($s:d_num == P010_05_p03) || \
			($s:d_num == P010_09_p04) || \
			($s:d_num == P010_10_p05)) {
			@海軍大佐の死体影セット
		}

		// 他
		@デモ用薬莢用メモリ確保セット
	}
} // < 「command マップ設定 変電室」 の閉じカッコ


