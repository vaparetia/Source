proc リアル影セット {
	chara 影投影モデル 変電室下階の影もでる \
		-m w14a_demo_sdw_1 \
		-p 0 2 0


	chara 影投影モデル 変電室上階壊れ前の影もでる \
		-m w14a_demo_sdw_2 \
		-p 0 2 0

	chara 影投影モデル 変電室上階壊れ後の影もでる \
		-m w14a_demo_sdw_3 \
		-p 0 2 0

	chara 影管理 変電室下階の影かんり \
		-t 0 \
		-l 6000 \
		-p 1563 -1998 758 

	chara 影管理 変電室上階の影かんり \
		-t 0 \
		-l 6000 \
		-p -1563 -1998 758

	if($s:d_num == P010_01_p01) {
		mesg 影管理 変電室下階の影かんり demo_add sel_def_01 変電室下階の影もでる	// シールズ１号
		mesg 影管理 変電室下階の影かんり demo_add sel_def_02 変電室下階の影もでる	// シールズ２号
		mesg 影管理 変電室下階の影かんり demo_add sel_def_03 変電室下階の影もでる	// シールズ３号
		mesg 影管理 変電室下階の影かんり demo_add sel_def_sh   変電室下階の影もでる	// シールズ４号
		mesg 影管理 変電室下階の影かんり demo_add sel_blood_sh 変電室下階の影もでる	// 血塗れシールズ
		mesg 影管理 変電室下階の影かんり demo_add sel_def_04_血吸われ 変電室下階の影もでる	// 血吸われシールズ

		mesg 影管理 変電室下階の影かんり demo_add m4a_nm_sel01 変電室下階の影もでる	// シールズ１号の武器
		mesg 影管理 変電室下階の影かんり demo_add m4a_nm_sel02 変電室下階の影もでる	// シールズ２号の武器
		mesg 影管理 変電室下階の影かんり demo_add m4a_nm_sel03 変電室下階の影もでる	// シールズ３号の武器
		mesg 影管理 変電室下階の影かんり demo_add m4a_nm_sel04 変電室下階の影もでる	// シールズ４号の武器

		mesg 影管理 変電室上階の影かんり demo_add iro_def_mh_demo 変電室上階壊れ前の影もでる	// 色濃いイロコイ
		mesg 影管理 変電室上階の影かんり demo_add iro_blood_mh_mt 変電室上階壊れ前の影もでる	// 血塗れイロコイ

	} else if($s:d_num == P010_01_p02) {
		mesg 影管理 変電室上階の影かんり demo_add iro_def_mh_mt   変電室上階壊れ後の影もでる	// 色濃いイロコイ
		mesg 影管理 変電室上階の影かんり demo_add iro_blood_mh_mt 変電室上階壊れ後の影もでる	// 血塗れイロコイ
	} else if($s:d_num == P010_03_p02) {
		mesg 影管理 変電室上階の影かんり demo_add iro_def_mh_mt   変電室上階壊れ後の影もでる	// 色濃いイロコイ
		mesg 影管理 変電室上階の影かんり demo_add demo_m4_sel2    変電室上階壊れ後の影もでる	// Ｍ４
	} else if($s:d_num == P010_05_p03) {
		mesg 影管理 変電室下階の影かんり demo_add rai_def_mh_demo 変電室下階の影もでる	// ライデン
		mesg 影管理 変電室下階の影かんり demo_add iro_def_mh_mt   変電室下階の影もでる	// 色濃いイロコイ
		mesg 影管理 変電室下階の影かんり demo_add demo_m4_sel2    変電室下階の影もでる	// Ｍ４
	} else if($s:d_num == P010_09_p04) {
		mesg 影管理 変電室下階の影かんり demo_add rai_def_mh_demo 変電室下階の影もでる	// ライデン
		mesg 影管理 変電室下階の影かんり demo_add iro_def_mh_mt   変電室下階の影もでる	// 色濃いイロコイ
		mesg 影管理 変電室下階の影かんり demo_add sel_def_03      変電室下階の影もでる	// シールズ
		mesg 影管理 変電室下階の影かんり demo_add demo_m4_sel2    変電室下階の影もでる	// Ｍ４
	} else if($s:d_num == P010_10_p05) {
		mesg 影管理 変電室下階の影かんり demo_add rai_def_mh_demo 変電室下階の影もでる	// ライデン
		mesg 影管理 変電室下階の影かんり demo_add iro_def_mh_mt   変電室下階の影もでる	// 色濃いイロコイ
		mesg 影管理 変電室下階の影かんり demo_add demo_m4_sel     変電室下階の影もでる	// Ｍ４
	}
}

// 壁壊れ前（P010_01_p01(g/n)）でのみ使用
proc ヴァンプ下階影オン {
	mesg 影管理 変電室下階の影かんり demo_add vmp_coat_ジャンプ 変電室下階の影もでる	// フライング・ヴァンプ
	mesg 影管理 変電室下階の影かんり demo_add vmp_coat_mh_demo  変電室下階の影もでる	// ヴァンプ
}
proc ヴァンプ下階影オフ {
	mesg 影管理 変電室下階の影かんり del vmp_coat_ジャンプ	// フライング・ヴァンプ
	mesg 影管理 変電室下階の影かんり del vmp_coat_mh_demo 	// ヴァンプ
}
proc ヴァンプ壊れ前上階影オン {
	mesg 影管理 変電室上階の影かんり demo_add vmp_coat_mh_demo 変電室上階壊れ前の影もでる	// ヴァンプ
	mesg 影管理 変電室上階の影かんり demo_add vkf_big_inv_mt   変電室上階壊れ前の影もでる	// ナイフ
}
proc ヴァンプ上階影オフ {
	mesg 影管理 変電室上階の影かんり del vmp_coat_mh_demo	// ヴァンプ
	mesg 影管理 変電室上階の影かんり del vkf_big_inv_mt		// ナイフ
}

proc ライデン上階m4a_rai_subオン {
	mesg 影管理 変電室上階の影かんり demo_add m4a_rai_sub     変電室上階壊れ前の影もでる	// Ｍ４
}

proc ライデン上階銃所持オン {
	mesg 影管理 変電室上階の影かんり demo_add rai_def_mh_demo 変電室上階壊れ前の影もでる	// ライデン武器有り
}
proc ライデン上階銃所持オフ {
	mesg 影管理 変電室上階の影かんり del rai_def_mh_demo	// ライデン武器有り
}
proc ライデン上階素手オン {
	mesg 影管理 変電室上階の影かんり demo_add rai_def_mh_素手 変電室上階壊れ前の影もでる	// ライデン武器無し
}
proc ライデン上階素手オフ {
	mesg 影管理 変電室上階の影かんり del rai_def_mh_素手	// ライデン武器無し
}

proc イロコイ上階m4a_nm_iroオン {
	mesg 影管理 変電室上階の影かんり demo_add m4a_nm_iro 変電室上階壊れ前の影もでる	// Ｍ４
}
proc イロコイ上階m4a_nm_iroオフ {
	mesg 影管理 変電室上階の影かんり del m4a_nm_iro	// Ｍ４
}


proc デモ用薬莢用メモリ確保セット {
	chara M4_DEMO_GUN弾 デモ弾Ｍ４
}

proc 壊れ前壁セット {
	// 北面の壁
	chara プットオブジェ wall1_0 \
		-m w14a1_wall1_0 \
		-r 0,0,0 \
		-p -45000 -2000 -39000 \
		-s 100,100,100 \
		-l d:LT2_NAME
	// １Ｆ西側の壁
	chara プットオブジェ wall2_0 \
		-m w14a1_wall2_0 \
		-r 0,0,0 \
		-p -53250 0 -30750 \
		-s 100,100,100 \
		-l d:LT2_NAME
}

proc 壊れ後壁セット {
	// 北面の壁
	chara プットオブジェ wall1_1 \
		-m w14a1_wall1_1 \
		-r 0,0,0 \
		-p -45000 -2000 -39000 \
		-s 100,100,100 \
		-l d:LT2_NAME
	// １Ｆ西側の壁
	chara プットオブジェ wall2_1 \
		-m w14a1_wall2_1 \
		-r 0,0,0 \
		-p -53250 0 -30750 \
		-s 100,100,100 \
		-l d:LT2_NAME
}

proc 北面の壁壊れる {
	mesg プットオブジェ wall1_0 off
	chara プットオブジェ wall1_1 \
		-m w14a1_wall1_1 \
		-r 0,0,0 \
		-p -45000 -2000 -39000 \
		-s 100,100,100 \
		-l d:LT2_NAME
}

proc １Ｆ西側の壁壊れる {
	mesg プットオブジェ wall2_0 off
	chara プットオブジェ wall2_1 \
		-m w14a1_wall2_1 \
		-r 0,0,0 \
		-p -53250 0 -30750 \
		-s 100,100,100 \
		-l d:LT2_NAME
}

proc 変電板の扉セット {
#if 1
	// 部屋変電盤
	chara プットオブジェ ロッカー部屋変電盤１ \
		-m d:DOOR_NAME5 \
		-r 0,(1024+1024),0 \
		-p -52880,0,(-38750+50) \
		-s 100,100,100 \
		-l d:LT2_NAME

	// 部屋変電盤
	chara プットオブジェ ロッカー部屋変電盤２ \
		-m d:DOOR_NAME4 \
		-r 0,(1024),0 \
		-p -52880,0,(-37750+50) \
		-s 100,100,100 \
		-l d:LT2_NAME

	// 廊下変電盤
	chara プットオブジェ ロッカー廊下変電盤１ \
		-m d:DOOR_NAME7 \
		-r 0,(1024),0 \
		-p -57000,0,(-34750+50) \
		-s 100,100,100 \
		-l d:LT2_NAME

	// 廊下変電盤
	chara プットオブジェ ロッカー廊下変電盤２ \
		-m d:DOOR_NAME6 \
		-r 0,(1024),0 \
		-p -57000,0,(-28750+50) \
		-s 100,100,100 \
		-l d:LT2_NAME
#else
	// 開いた状態でセット
	chara ロッカー管理 管理人さん -n 4
	command ロッカーモーション -motion locker

	// 部屋変電盤
	chara ロッカー ロッカー部屋変電盤１ \
		-kms d:DOOR_NAME5 \
		-p -52880,0,(-38750+50) \
		-r 0,1024,0 \
		-s d:LOCKER_STATE_OPEN \
		-exec {
		}
	// 部屋変電盤
	chara ロッカー ロッカー部屋変電盤２ \
		-kms d:DOOR_NAME4 \
		-p -52880,0,(-37750+50) \
		-r 0,1024,0 \
		-s 0 \
		-exec {
		}

	// 廊下変電盤
	chara ロッカー ロッカー廊下変電盤１ \
		-kms d:DOOR_NAME7 \
		-p -57000,0,(-34750+50) \
		-r 0,1024,0 \
		-s 0 \
		-exec {
		}
	// 廊下変電盤
	chara ロッカー ロッカー廊下変電盤２ \
		-kms d:DOOR_NAME6 \
		-p -57000,0,(-28750+50) \
		-r 0,1024,0 \
		-s 0 \
		-exec {
		}
#endif
}

