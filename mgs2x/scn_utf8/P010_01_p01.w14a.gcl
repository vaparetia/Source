proc P010_09_p04終了 {
	@デモ終了時シネマスクリーンオフ
	mesg デモキャンセルチェック デモキャンセル kill
	#if d:DEMO_SKIP_ENABLE
	#else
		eval($w:p_story = d:ST:P010_09_P04ヴァンプ遭遇９ポリゴンデモ４終了)
		print '$w:p_story = d:ST:P010_09_P04ヴァンプ遭遇９ポリゴンデモ４終了'
	#endif

	// ソコムをスネークからもらう
	eval($w:武器弾数Ｒ[ d:武器:ソコム ] = 13)

	chara delay ディレイ \
		-time 1 \ 
		-exec{
			restart
		}
}

proc P010_10_p05終了 {
	@デモ終了時シネマスクリーンオフ
	mesg デモキャンセルチェック デモキャンセル kill
		eval($w:p_story = d:ST:P010_10_P05ヴァンプ遭遇１０ポリゴンデモ５終了)
		print '$w:p_story = d:ST:P010_10_P05ヴァンプ遭遇１０ポリゴンデモ５終了'

	@サウンドマネージャー_mesg_2

	chara delay ディレイ \
		-time 1 \ 
		-exec{
			// ゲームへ
			@ゲームステージへ戻る
			@mv_demo_w14a_0
		}
}



// シネマスクリーン
proc シネマスクリーンセット {
	chara シネマスクリーン シネマ \
		-top d:CINEMA_BELT_UPPER \
		-bottom d:CINEMA_BELT_LOWER \
		-ftime 60	//デフォルト値（ゼロは駄目）
	mesg シネマスクリーン シネマ フェードアウト 1
}


