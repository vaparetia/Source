//-----------------------------------------------------------------------------
// ステージモデル設定
proc 変電室ステージセット {
print '変電室ステージセット_000'
	chara プットオブジェ 変電室廊下 \
		-m d:KMS_NAME0 \
		-r 0,0,0 \
		-p 0,0,0 \
		-s 100,100,100 \
		-l d:LT2_NAME

print '変電室ステージセット_001'

	// ヴァンプ登場デモでは血のり無し→血のり有り。
	if($s:d_num == P010_01_p01){
		chara プットオブジェ 変電室血のり部屋 \
			-m d:KMS_NAME1 \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME
		chara プットオブジェ 変電室血のり無し部屋 \
			-m d:KMS_NAME2 \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME

		mesg プットオブジェ 変電室血のり部屋 off

	print '変電室ステージセット_002'

	// それ以降は血のり有りのみ。
	} else {
		chara プットオブジェ 変電室血のり部屋 \
			-m d:KMS_NAME1 \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME
	}
}
proc ステージ血のり無し→血のり有り {
	mesg プットオブジェ 変電室血のり無し部屋 off
	mesg プットオブジェ 変電室血のり部屋 on
}

