	}
	talk エマ 標準 -m {
		 [PE_狙撃＿悪口後:エマ_005]
		//！？
		//だ、だから何も言ってないってば！
	}
}//v
}//d

//柱の影でジョニーと会った後 h //e
//resource PE_狙撃＿ジョニー後
proc rp_PE_狙撃＿ジョニー後:07 {
vox t:vc220701 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ライデン 標準 -m {
		 [PE_狙撃＿ジョニー後:ライデン_000]
		//エマ、柱の影で何かあったのか？
	}
	talk エマ 標準 -m {
		 [PE_狙撃＿ジョニー後:エマ_001]
		//いいえ、何も。
	}
	talk ライデン 標準 -m {
		 [PE_狙撃＿ジョニー後:ライデン_002]
		//話し声が聞こえたが？
	}
@rp_つっこまれ＿是１＿なんで知ってるんだ系デフォルト 100
	talk エマ 標準 -m {
		 [PE_狙撃＿ジョニー後:エマ_003]
		//盗み聞きしてたの？
	}
	talk ライデン 標準 -m {
		 [PE_狙撃＿ジョニー後:ライデン_004]
		//人聞きが悪いな。
		//俺は君が心配だったから……。
	}
	talk エマ 標準 -m {
		 [PE_狙撃＿ジョニー後:エマ_005]
		//盗み聞きしてたのね。
	}
	talk ライデン 標準 -m {
		 [PE_狙撃＿ジョニー後:ライデン_006]
		//あぁ……まあ……そうとも言えるかな。
	}
@rp_つっこまれ＿否１＿逆ギレ系デフォルト 100
	talk エマ 標準 -m {
		 [PE_狙撃＿ジョニー後:エマ_007]
		//サイテー。
	}
	talk ライデン 標準 -m {
		 [PE_狙撃＿ジョニー後:ライデン_008]
		//聞きなれたよ、それ。
		//で、何があったんだ？
	}
@rp_かみあわない＿否１＿話聞けよ系デフォルト 100
	talk エマ 標準 -m {
		 [PE_狙撃＿ジョニー後:エマ_009]
		//うふふ。……内緒！
	}
}//v
}//d


//ヴァンプに首を絞められている時１ h //e
//resource PE_狙撃＿ヴァンプ１
