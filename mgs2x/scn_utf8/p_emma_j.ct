vox t:vc220711 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk エマ 標準 -m {
		 [PE_狙撃＿ヴァンプ１:エマ_000]
		//うぅぅぅ……。
	}
}//v
}//d
//ヴァンプに首を絞められている時２ h //e
//resource PE_狙撃＿ヴァンプ２
proc rp_PE_狙撃＿ヴァンプ２:07 {
vox t:vc220721 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk エマ 標準 -m {
		 [PE_狙撃＿ヴァンプ２:エマ_000]
		//苦しい……。
	}
}//v
}//d
//ヴァンプに首を絞められている時３ h //e
//resource PE_狙撃＿ヴァンプ３
proc rp_PE_狙撃＿ヴァンプ３:07 {
vox t:vc220731 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk エマ 標準 -m {
		 [PE_狙撃＿ヴァンプ３:エマ_000]
		//……助けて……。
	}
}//v
}//d


//-------------------------------//e
//後回し会話 d //e
//-------------------------------//e
//ＲＭＡの話 h //e
//resource PE_ＲＭＡ
proc rp_PE_ＲＭＡ:07 {
vox t:vc220741 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ライデン 標準 -m {
		 [PE_ＲＭＡ:ライデン_000]
		//エマ、『Ｇ．Ｗ』についてだが……、
		//本当に大規模な検閲をコンピュータで
		//自動的に行うことなんか出来るのか？
	}
	talk エマ 標準 -m {
		 [PE_ＲＭＡ:エマ_001]
		//出来る。というより、コンピュータで
		//なければ出来ない、というべきね。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk エマ 標準 -m {
		 [PE_ＲＭＡ:エマ_002]
		//多量すぎる情報はもはや人間には
		//処理できないの。あなたが詳しいだろう
		//軍事関係を例に話してみましょうか？
	}
	talk エマ 標準 -m {
		 [PE_ＲＭＡ:エマ_003]
		//今世紀初頭から軍隊や戦場は
		//デジタル化されてるわよね。
	}
	talk ライデン 標準 -m {
		 [PE_ＲＭＡ:ライデン_004]
		//ああ。戦場のデジタル化、ＲＭＡ革命……
		//ＶＲ訓練もその一環だ。
	}
	talk ライデン 標準 -m {
		 [PE_ＲＭＡ:ライデン_005]
		//戦場では情報こそが勝敗を決める。
		//そのために大量のハイテク兵器、装置を
		//導入してきた。夜も昼もない。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk エマ 標準 -m {
		 [PE_ＲＭＡ:エマ_006]
		//そう。２４時間、電子の目や耳を通じて
		//見えない世界はなくなった。
	}
	talk ライデン 標準 -m {
		 [PE_ＲＭＡ:ライデン_007]
		//そしてリアルタイムで戦況を収集、解析、
		//把握することが出来るようになった……。
	}
	talk エマ 標準 -m {
		 [PE_ＲＭＡ:エマ_008]
		//いいえ、それは逆。敵味方の部隊配置
		//から歩兵一人一人の残弾数にいたる
		//まで……文字どおりの膨大なデータ。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk エマ 標準 -m {
		 [PE_ＲＭＡ:エマ_009]
		//結果として、誰にも戦況を把握する
		//ことができなくなったの。
	}
	talk エマ 標準 -m {
		 [PE_ＲＭＡ:エマ_010]
		//どんな優れた将軍であろうと、生身の
		//人間にはね。
	}
	talk ライデン 標準 -m {
		 [PE_ＲＭＡ:ライデン_011]
		//情報化時代に人間は対応できない？
	}
	talk エマ 標準 -m {
		 [PE_ＲＭＡ:エマ_012]
		//そう。既に高度情報化されたデジタル
		//戦場では人間はもはや適切な判断は
		//下せない。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk エマ 標準 -m {
		 [PE_ＲＭＡ:エマ_013]
		//かわりにコンピュータでそれを補佐する
		//システムが研究された。
	}
	talk エマ 標準 -m {
		 [PE_ＲＭＡ:エマ_014]
		//湾岸戦争の時、国防総省は人工知能を
		//使って兵站スケジュールを組む大規模
		//システムの実験を行って成果を挙げてる。
	}
	talk ライデン 標準 -m {
		 [PE_ＲＭＡ:ライデン_015]
		//……全世界の情報検閲も同じように？
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk エマ 標準 -m {
		 [PE_ＲＭＡ:エマ_016]
		//そう。『Ｇ．Ｗ』の力があれば
		//それは可能なの。わかった？
	}
}//v
}//d


//エマが柱の影でレーション食った後 h //e
//resource PE_狙撃＿レーション食った
proc rp_PE_狙撃＿レーション食った:07 {
vox t:vc220751 {
	talk ライデン 標準 -m {
		 [PE_狙撃＿レーション食った:ライデン_000]
		//エマ、ＬＩＦＥが回復してるな。
	}
	talk エマ 標準 -m {
		 [PE_狙撃＿レーション食った:エマ_001]
		//ええ……ちょっとおやつを。
	}
	talk ライデン 標準 -m {
		 [PE_狙撃＿レーション食った:ライデン_002]
		//……。
	}
	talk エマ 標準 -m {
		 [PE_狙撃＿レーション食った:エマ_003]
		//なによ！
		//いいじゃないおやつくらい食べたって！
	}
	talk エマ 標準 -m {
		 [PE_狙撃＿レーション食った:エマ_004]
		//間食は精神的なリラクゼーションに
		//なるの！ストレス緩和の役に立つって、
		//セラピストが言ってたもん。
	}
	talk エマ 標準 -m {
		 [PE_狙撃＿レーション食った:エマ_005]
		//そもそも太らない体質なんだから、私、
		//ホントに！
	}
	talk ライデン 標準 -m {
		 [PE_狙撃＿レーション食った:ライデン_006]
		//……。
	}
	talk エマ 標準 -m {
		 [PE_狙撃＿レーション食った:エマ_007]
		//……ええそう。たしかに最近少し体重
		//増えてる。でも私ぜんぜん気にして
		//ないし！ホントに、もう、ぜんぜん！！
	}
	talk エマ 標準 -m {
		 [PE_狙撃＿レーション食った:エマ_008]
		//っていうか、いいじゃない別に
		//少しくらい太ったって！！
	}
	talk エマ 標準 -m {
		 [PE_狙撃＿レーション食った:エマ_009]
		//それであなたが何か困るわけ！？
		//そのせいでイルカが死ぬ！？
		//あなたのひいきの野球チームが負ける！？
	}
	talk エマ 標準 -m {
		 [PE_狙撃＿レーション食った:エマ_010]
		//だいたいそういう風に
		//女性を見た目で判断する思考が……。
	}
	talk ライデン 標準 -m {
		 [PE_狙撃＿レーション食った:ライデン_011]
		//エマ、俺は何も言ってないよ。
	}
	talk エマ 標準 -m {
		 [PE_狙撃＿レーション食った:エマ_012]
		//あ……あ……あ、そう……。
	}
}//v
}//d


proc rp_PE_ばぐっち:07 {
	talk エマ 標準 -m {
		 [PE_ばぐっち:エマ_000]
	}
}//d

