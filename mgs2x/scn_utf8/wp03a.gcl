				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ( ($:p_名前 == 移動的:08) || ($:p_名前 == 移動的:09) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			//	セット４
			} else if ($:p_名前 == 移動的:10) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ( ($:p_名前 == 移動的:11) || ($:p_名前 == 移動的:12) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)

			//	セット５
			} else if ($:p_名前 == 移動的:14) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ( ($:p_名前 == 移動的:13) || ($:p_名前 == 移動的:15) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)

			//	セット６
			} else if ($:p_名前 == 移動的:17) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ( ($:p_名前 == 移動的:16) || ($:p_名前 == 移動的:18) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			//	セット７
			} else if ($:p_名前 == 移動的:19) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ( ($:p_名前 == 移動的:20) || ($:p_名前 == 移動的:21) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			//	セット８
			} else if ($:p_名前 == 移動的:22) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ( ($:p_名前 == 移動的:23) || ($:p_名前 == 移動的:24) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)

			//	セット９
			} else if ($:p_名前 == 移動的:25) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ( ($:p_名前 == 移動的:26) || ($:p_名前 == 移動的:27) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			//	セット１０
			} else if ( ($:p_名前 == 移動的:28) || ($:p_名前 == 移動的:31) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ( ($:p_名前 == 移動的:29) || ($:p_名前 == 移動的:30) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			//	セット１１
			} else if ( ($:p_名前 == 移動的:32) || ($:p_名前 == 移動的:35) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ( ($:p_名前 == 移動的:33) || ($:p_名前 == 移動的:34) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)

			//	セット１２
			} else if ( ($:p_名前 == 移動的:36) || ($:p_名前 == 移動的:39) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ( ($:p_名前 == 移動的:37) || ($:p_名前 == 移動的:38) ) {
