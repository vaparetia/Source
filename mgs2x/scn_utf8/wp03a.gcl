	}



//////////////////////////
//	ハンドガン３面用
//////////////////////////

	//	スタート処理
	// ------------------------------------
	proc 武器訓練ハンドガン３面ＶＲ標的スタート処理 {
		//	ライデンを選択
		if ($s:選択プレイヤー == ライデン) {
			@ライデン的スタート処理

		//	スネークを選択
		} else if ($s:選択プレイヤー == スネーク) {
			@スネーク的スタート処理

		//	プリスキンを選択（ライデンとコンパチ）
		} else if ($s:選択プレイヤー == プリスキン) {
			@ライデン的スタート処理

		//	タキシードスネークを選択（スネークとコンパチ）
		} else if ($s:選択プレイヤー == タキシードスネーク) {
			@スネーク的スタート処理

		//	前作スネークを選択
		} else if ($s:選択プレイヤー == 前作スネーク) {
			@前作スネーク的スタート処理
		}

	}

	// 破壊時処理
	// ------------------------------------
	proc 武器訓練ハンドガン３面ＶＲ標的破壊処理 {
		//	ライデンを選択
		if ($s:選択プレイヤー == ライデン) {\
			@ライデン的破壊処理 $1

		//	スネークを選択
		} else if ($s:選択プレイヤー == スネーク) {
			@スネーク的破壊処理 $1

		//	プリスキンを選択（ライデンとコンパチ）
		} else if ($s:選択プレイヤー == プリスキン) {
			@ライデン的破壊処理 $1

		//	タキシードスネークを選択（スネークとコンパチ）
		} else if ($s:選択プレイヤー == タキシードスネーク) {
			@スネーク的破壊処理 $1

		//	前作スネークを選択
		} else if ($s:選択プレイヤー == 前作スネーク) {
			@前作スネーク的破壊処理 $1
		}

	}

	// 的配置
	// ------------------------------------
	proc 武器訓練ハンドガン３面ＶＲ標的設定 {
		eval ($$i:的ステータス = ($$i:的ステータス | d:VR_TRG_NORMAL | d:VR_TRG_WAIT | d:VR_TRG_NO_GHOST) )
		eval ($$i:的ステータスＡ = ($$i:的ステータスＡ | d:VR_TRG_NORMAL | d:VR_TRG_WAIT) )		//	子的が動く場合はこっち
		eval ($$i:的スピード = 30)
		eval ($$i:的スピードＡ = 31)	//	これ以上遅いとつながらないとおもう

		//	ライデンを選択
		if ($s:選択プレイヤー == ライデン) {
			@ライデン的設定

		//	スネークを選択
		} else if ($s:選択プレイヤー == スネーク) {
			@スネーク的設定

		//	プリスキンを選択（ライデンとコンパチ）
		} else if ($s:選択プレイヤー == プリスキン) {
			@ライデン的設定

		//	タキシードスネークを選択（スネークとコンパチ）
		} else if ($s:選択プレイヤー == タキシードスネーク) {
			@スネーク的設定

		//	前作スネークを選択
		} else if ($s:選択プレイヤー == 前作スネーク) {
			@前作スネーク的設定
		}

	}



//###################################################################################
//									 ライデン　的設定
//###################################################################################

//////////////////////////
//	ハンドガン３面用
//////////////////////////

	//	スタート処理
	proc ライデン的スタート処理 {
		mesg ＶＲ的共通 移動的:01 移動開始
		mesg ＶＲ的共通 移動的:02 移動開始
		mesg ＶＲ的共通 移動的:03 移動開始
	}

	//	破壊時処理
	proc ライデン的破壊処理 {
			if ( ($1 == 移動的:01) || ($1 == 移動的:02) || ($1 == 移動的:03) ) {
				eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
				if ($$i:的起動フラグ == 3) {
					mesg ＶＲ的共通 移動的:04 移動開始
					mesg ＶＲ的共通 移動的:05 移動開始
					mesg ＶＲ的共通 移動的:06 移動開始

					mesg ＶＲ的共通 移動的:07 移動開始
					mesg ＶＲ的共通 移動的:08 移動開始
					mesg ＶＲ的共通 移動的:09 移動開始
					eval ($$i:的起動フラグ = 0)
				}

			} else if ( ($1 == 移動的:04) || ($1 == 移動的:05) || ($1 == 移動的:06) || \
						($1 == 移動的:07) || ($1 == 移動的:08) || ($1 == 移動的:09) ) {
				eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
				if ($$i:的起動フラグ == 6) {
					mesg ＶＲ的共通 移動的:10 移動開始
					mesg ＶＲ的共通 移動的:11 移動開始
					mesg ＶＲ的共通 移動的:12 移動開始
					eval ($$i:的起動フラグ = 0)
				}

			} else if ( ($1 == 移動的:10) || ($1 == 移動的:11) || ($1 == 移動的:12) ) {
				eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
				if ($$i:的起動フラグ == 3) {
					mesg ＶＲ的共通 移動的:13 移動開始
					mesg ＶＲ的共通 移動的:14 移動開始
					mesg ＶＲ的共通 移動的:15 移動開始

					mesg ＶＲ的共通 移動的:16 移動開始
					mesg ＶＲ的共通 移動的:17 移動開始
					mesg ＶＲ的共通 移動的:18 移動開始

					eval ($$i:的起動フラグ = 0)
				}

			} else if ( ($1 == 移動的:13) || ($1 == 移動的:14) || ($1 == 移動的:15) || \
						($1 == 移動的:16) || ($1 == 移動的:17) || ($1 == 移動的:18) ) {
				eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
				if ($$i:的起動フラグ == 6) {
					mesg ＶＲ的共通 移動的:19 移動開始
					mesg ＶＲ的共通 移動的:20 移動開始
					mesg ＶＲ的共通 移動的:21 移動開始

					mesg ＶＲ的共通 移動的:22 移動開始
					mesg ＶＲ的共通 移動的:23 移動開始
					mesg ＶＲ的共通 移動的:24 移動開始
					mesg ＶＲ的共通 移動的:25 移動開始

					mesg ＶＲ的共通 移動的:26 移動開始
					mesg ＶＲ的共通 移動的:27 移動開始
					mesg ＶＲ的共通 移動的:28 移動開始
					mesg ＶＲ的共通 移動的:29 移動開始

					eval ($$i:的起動フラグ = 0)
				}

			}

	}

	//	的配置
	proc ライデン的設定 {

	//	@ＶＲ標的基本設定 \
	//	$:p_名前 $:p_的ステータス $:p_ルート $:p_ノード $:p_破壊プロック $:p_的スピード
	//	@ＶＲ子的基本設定 \
	//	$:p_名前 $:p_親名前 $:p_的ステータス $:p_破壊プロック $:p_Ｘシフト $:p_Ｙシフト $:p_Ｚシフト

		//	１つ目
		@ＶＲ標的基本設定 \
		移動的:01 ($$i:的ステータス | d:VR_TRG_BLAST) d:３面的ルート:移＿０ 0 p:武器訓練ハンドガン３面ＶＲ標的破壊処理 $$i:的スピード
		@ＶＲ子的基本設定 \
		移動的:02 移動的:01 $$i:的ステータス p:武器訓練ハンドガン３面ＶＲ標的破壊処理 -1000 0 0
		@ＶＲ子的基本設定 \
		移動的:03 移動的:01 $$i:的ステータス p:武器訓練ハンドガン３面ＶＲ標的破壊処理 1000 0 0

		//	２つ目
		@ＶＲ標的基本設定 \
		移動的:04 ($$i:的ステータス | d:VR_TRG_BLAST) d:３面的ルート:移＿１ 0 p:武器訓練ハンドガン３面ＶＲ標的破壊処理 $$i:的スピード
		@ＶＲ子的基本設定 \
		移動的:05 移動的:04 $$i:的ステータス p:武器訓練ハンドガン３面ＶＲ標的破壊処理 -1000 0 0
		@ＶＲ子的基本設定 \
		移動的:06 移動的:04 $$i:的ステータス p:武器訓練ハンドガン３面ＶＲ標的破壊処理 1000 0 0

		@ＶＲ標的基本設定 \
		移動的:07 ($$i:的ステータス | d:VR_TRG_BLAST) d:３面的ルート:移＿２ 0 p:武器訓練ハンドガン３面ＶＲ標的破壊処理 $$i:的スピード
		@ＶＲ子的基本設定 \
		移動的:08 移動的:07 $$i:的ステータス p:武器訓練ハンドガン３面ＶＲ標的破壊処理 -1000 0 0
		@ＶＲ子的基本設定 \
		移動的:09 移動的:07 $$i:的ステータス p:武器訓練ハンドガン３面ＶＲ標的破壊処理 1000 0 0

		//	３つ目
		@ＶＲ標的基本設定 \
		移動的:10 $$i:的ステータス d:３面的ルート:移＿２４ 0 p:武器訓練ハンドガン３面ＶＲ標的破壊処理 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:11 ($$i:的ステータス | d:VR_TRG_BLAST) d:３面的ルート:移＿２５ 0 p:武器訓練ハンドガン３面ＶＲ標的破壊処理 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:12 $$i:的ステータス d:３面的ルート:移＿２６ 0 p:武器訓練ハンドガン３面ＶＲ標的破壊処理 $$i:的スピード

		//	４つ目
		@ＶＲ標的基本設定 \
		移動的:13 ($$i:的ステータスＡ | d:VR_TRG_BLAST) d:３面的ルート:移＿５ 0 p:武器訓練ハンドガン３面ＶＲ標的破壊処理 $$i:的スピード
		@ＶＲ子的基本設定 \
		移動的:14 移動的:13 $$i:的ステータス p:武器訓練ハンドガン３面ＶＲ標的破壊処理 -1000 0 0
		@ＶＲ子的基本設定 \
		移動的:15 移動的:13 $$i:的ステータス p:武器訓練ハンドガン３面ＶＲ標的破壊処理 1000 0 0

		@ＶＲ標的基本設定 \
		移動的:16 ($$i:的ステータスＡ | d:VR_TRG_BLAST) d:３面的ルート:移＿６ 0 p:武器訓練ハンドガン３面ＶＲ標的破壊処理 $$i:的スピード
		@ＶＲ子的基本設定 \
		移動的:17 移動的:16 $$i:的ステータス p:武器訓練ハンドガン３面ＶＲ標的破壊処理 -1000 0 0
		@ＶＲ子的基本設定 \
		移動的:18 移動的:16 $$i:的ステータス p:武器訓練ハンドガン３面ＶＲ標的破壊処理 1000 0 0

		//	５つ目
		@ＶＲ標的基本設定 \
		移動的:19 ($$i:的ステータスＡ | d:VR_TRG_BLAST) d:３面的ルート:移＿７ 0 p:武器訓練ハンドガン３面ＶＲ標的破壊処理 $$i:的スピード
		@ＶＲ子的基本設定 \
		移動的:20 移動的:19 $$i:的ステータス p:武器訓練ハンドガン３面ＶＲ標的破壊処理 0 -1000 0
		@ＶＲ子的基本設定 \
		移動的:21 移動的:19 $$i:的ステータス p:武器訓練ハンドガン３面ＶＲ標的破壊処理 0 1000 0

		@ＶＲ標的基本設定 \
		移動的:22 $$i:的ステータスＡ d:３面的ルート:移＿２０ 0 p:武器訓練ハンドガン３面ＶＲ標的破壊処理 $$i:的スピード
		@ＶＲ子的基本設定 \
		移動的:23 移動的:22 $$i:的ステータス p:武器訓練ハンドガン３面ＶＲ標的破壊処理 -1000 0 0

		@ＶＲ標的基本設定 \
		移動的:24 ($$i:的ステータスＡ | d:VR_TRG_BLAST) d:３面的ルート:移＿２１ 0 p:武器訓練ハンドガン３面ＶＲ標的破壊処理 $$i:的スピード
		@ＶＲ子的基本設定 \
		移動的:25 移動的:24 $$i:的ステータス p:武器訓練ハンドガン３面ＶＲ標的破壊処理 1000 0 0

