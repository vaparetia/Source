// ------------------------------------
// マップ設定
// ------------------------------------
chara マップ 武器訓練ハンドガン３面 -k d:KMS_NAME -h d:HZX_NAME,0 -l $s:ＶＲライトファイル名

command マップ設定 武器訓練ハンドガン３面 -set {
	// ローカルの初期化
	// ------------------------------------
	@ローカル変数初期化		// ローカルで使用する変数で初期化をする場合はここで

	// ＶＲで必要な基本プロックのセット(vr_common.hで定義)
	// サウンドの基本パック、ＶＲの基本システム、プレイヤー、ゴール等を設定します
	// ※このプロックを使用する時は「ＶＲクリア時処理」というプロックが必要です
	// ＶＲ共通プロックセット	$:スネークファイル $:雷電ファイル $:クリア条件フラグ
	//							$:ゴールＸ $:ゴールＹ $:ゴールＺ
	//	VR_GOAL_TARGET	/*的全滅でゴールが開く*/
	//	VR_GOAL_FREE	/*ゴールが最初から開いてる*/
	//	VR_GOAL_ENEMY	/*敵全滅でゴールが開く*/
	//	VR_GOAL_SNEAK	/*潜入モード中はゴールが開く*/
	//	VR_GOAL_TIME	/*タイマーがゼロになるとゴールが開く*/
	// ------------------------------------

	@ＶＲ共通プロックセット sna_wp03a rai_wp03a d:VR_GOAL_TARGET 0 0 0

	// カメラ設定
	@カメラセット					// chara カメラとベースのカメラを設定

	// ＶＲウィンドウの設定
	// ------------------------------------
	@武器訓練ハンドガン３面ＶＲウィンドウ設定

//	テイルズＥ以外では
#ifndef d:E_TALES
//	@ＶＲクリア設定 $:ＮＥＸＴＳＴＡＧＥプロック $:ＴＲＹＡＧＡＩＮプロック $:ＥＸＩＴプロック
	@ＶＲクリア設定 p:load_wp04a p:A_ＲＥＴＲＹプロック
//	テイルズＥのときは
#else
//	@テイルズＥ用ＶＲクリア設定２
	@テイルズＥ用ＶＲクリア設定２
#endif

	// ステージに引かれるライン
	// ------------------------------------
	@ＶＲアウトライン d:KMS_NAME d:TONBO_KMS_NAME d:LINE_KMS_NAME

	// 設定値を変更する場合は以下のプロック内で設定
	// ------------------------------------
	@設定値変更				// 敵兵や的のパラメータをステージ限定で変える時はここで
	@プラグイン設定			// プレイヤーのプラグインがいる時はここで

	// 的関係の設定
	// ------------------------------------
	@武器訓練ハンドガン３面ＶＲ標的設定				// ＶＲシステム起動後に呼ぶ

	// ＢＧＭの設定(プレイヤー→敵兵→BGMの順で呼ぶ。的の場合は関係ないがとりあえずここに)
	// ------------------------------------
	@ＢＧＭ設定

	// アイテムの設定
	// ------------------------------------
	@アイテム設定

	// 光源、オブジェクト、カメラ関連の設定
	// ------------------------------------
	@ＶＲフォグ設定 d:VR_FOG:朝Ｎ d:VR_FOG:朝Ｆ d:VR_FOG:夕Ｎ d:VR_FOG:夕Ｆ d:VR_FOG:夜Ｎ d:VR_FOG:夜Ｆ
	
	@武器訓練ハンドガン３面カメラ設定		// ステージ固有のカメラ設定がいる時はこのプロックで
	@ＶＲキャラ用ライト設置					// vr_common.hに定義。必ず最後に設定
#if d:DEBUG_CHARA
//	@デバッグキャラセット
#endif

//	@ジャンプ設定

//	@実験

}

//初期マップの表示
command マップ表示 -show 武器訓練ハンドガン３面


//###################################################################################
//									各proc設定
//###################################################################################



//###################################################################################
//									全マップ共通
//###################################################################################
	// ------------------------------------
	// 全マップ共通
	// ------------------------------------
	// ------------------------------------
	// クリア時の処理
	// ------------------------------------
	proc ＶＲクリア時処理 {
		#if d:DEBUG_PRINT
			print 'clear'
		#endif

		// 強制モーションを発動
		@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_1 0

		// クリア時にカメラアングルを変える
		chara カメラ設定 カットインカメラ \
			-c 1 \
			-p -341,1170,4652 -t -341,1076,-51 \
			-r 55,2048,0 -f 7019 \
			-a 200 \
			-i 1 1 0 0 \
			-s 1

	}



	// ------------------------------------
	// パラメータ系の変更
	// ------------------------------------
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT
			print 'localvar_init'
		#endif
		//	的起動フラグを初期化
		eval ($$i:的起動フラグ = 0)
		eval ($$i:的起動フラグＡ = 0)
		eval ($$i:的起動フラグＢ = 0)
		eval ($$i:的起動フラグＣ = 0)
		eval ($$i:的起動フラグＤ = 0)
		eval ($$i:的起動フラグＥ = 0)

		//	的ステータスを初期化する
		eval ($$i:的基本ステータス = 0);
		eval ($$i:的ステータス = 0)
		eval ($$i:的ステータスＡ = 0)

		//	的スピードを初期化する
		eval ($$i:的スピード = 0)
		eval ($$i:的スピードＡ = 0)

		//	的セット数を初期化する
		eval ($$b:的セット数 = 0);

	}
	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT
			print 'status_set'
		#endif

		// 初期装備の設定
		@武器訓練用キャラ別標準装備設定
	}
	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif
	}



//###################################################################################
//									 総合　的設定
//###################################################################################

//////////////////////////
//	基本的プロック
//////////////////////////

	// 移動的プロック
	// ------------------------------------
	proc ＶＲ標的基本設定 \
	$:p_名前 $:p_的ステータス $:p_ルート $:p_ノード $:p_破壊プロック $:p_的スピード {

		//	点滅用処理
		@点滅割り振り設定 $:p_名前

		//	爆発的は点滅しない
		if ($:p_的ステータス & d:VR_TRG_BLAST) {
			eval ($$i:的基本ステータス = 0)
		}
		chara	ＶＲ移動的 $:p_名前 \
			-flag ($$i:的基本ステータス | $:p_的ステータス) \
			-route $:p_ルート $:p_ノード \
			-c $:p_破壊プロック \
			-speed $:p_的スピード
	}

	// 子的プロック
	// ------------------------------------
	proc ＶＲ子的基本設定 \
	$:p_名前 $:p_親名前 $:p_的ステータス $:p_破壊プロック $:p_Ｘシフト $:p_Ｙシフト $:p_Ｚシフト {

		//	点滅用処理
		@点滅割り振り設定 $:p_名前

		//	爆発的は点滅しない
		if ($:p_的ステータス & d:VR_TRG_BLAST) {
			eval ($$i:的基本ステータス = 0)
		}
		chara	ＶＲ子的 $:p_名前 \
			-parent $:p_親名前 \
			-flag ($$i:的基本ステータス | $:p_的ステータス) \
			-c $:p_破壊プロック \
			-yshift $:p_Ｘシフト $:p_Ｙシフト $:p_Ｚシフト \
			-dir 0 0
	}


//////////////////////////
//	点滅割り振り設定
//////////////////////////
	proc 点滅割り振り設定 $:p_名前 {
		//	プリスキンかタキシードスネークは、点滅する
		if( ($s:選択プレイヤー == プリスキン) || \
			($s:選択プレイヤー == タキシードスネーク) ) {
			//	的セット数をカウントする
			$$b:的セット数 = $$b:的セット数 + 1;

			@ハンドガン３面点滅割り振り設定 $:p_名前

		//	そのほかのキャラは点滅しない
		} else {
			eval ($$i:的基本ステータス = $$i:的基本ステータス)
		}

	}

	//	基本点滅割り振り設定
	proc 基本点滅割り振り設定 {
		//	奇数ならば（＝的セット数が割り切れなければ）、消え状態からスタート
		if( $$b:的セット数 % 2 ) {
			eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)

		//	偶数ならば（＝的セット数が割り切れれば）、点き状態からスタート
		} else {
			eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
		}
	}

	//	ハンドガン３面例外措置
	proc ハンドガン３面点滅割り振り設定 $:p_名前 {
		//	プリスキンの場合
		if ($s:選択プレイヤー == プリスキン) {
#if 1
			//	セット１
			if ($:p_名前 == 移動的:01) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ( ($:p_名前 == 移動的:02) || ($:p_名前 == 移動的:03) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			
			//	セット２
			} else if ($:p_名前 == 移動的:04) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ( ($:p_名前 == 移動的:05) || ($:p_名前 == 移動的:06) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)

			//	セット３
			} else if ($:p_名前 == 移動的:07) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ( ($:p_名前 == 移動的:08) || ($:p_名前 == 移動的:09) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			//	セット４
			} else if ($:p_名前 == 移動的:11) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ( ($:p_名前 == 移動的:10) || ($:p_名前 == 移動的:12) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)

			//	セット５
			} else if ($:p_名前 == 移動的:13) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ( ($:p_名前 == 移動的:14) || ($:p_名前 == 移動的:15) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			//	セット６
			} else if ($:p_名前 == 移動的:16) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ( ($:p_名前 == 移動的:17) || ($:p_名前 == 移動的:18) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			//	セット７
			} else if ($:p_名前 == 移動的:19) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ( ($:p_名前 == 移動的:20) || ($:p_名前 == 移動的:21) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			//	セット８
			} else if ( ($:p_名前 == 移動的:22) || ($:p_名前 == 移動的:25) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ( ($:p_名前 == 移動的:23) || ($:p_名前 == 移動的:24) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			//	セット９
			} else if ( ($:p_名前 == 移動的:26) || ($:p_名前 == 移動的:29) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ( ($:p_名前 == 移動的:27) || ($:p_名前 == 移動的:28) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)

			//	それ以外の的は（念のため）
			} else {
				@基本点滅割り振り設定
			}

//	以下はムズい！
#else
			if ($:p_名前 == 移動的:12) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)

			} else if ($:p_名前 == 移動的:26) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ( ($:p_名前 == 移動的:27) || ($:p_名前 == 移動的:29) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			} else {
				@基本点滅割り振り設定
			}
#endif

		//	タキシードの場合
		} else {
#if 1
			//	セット１
			if ($:p_名前 == 移動的:01) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ( ($:p_名前 == 移動的:02) || ($:p_名前 == 移動的:03) ) {
