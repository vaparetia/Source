//#define		TONBO_KMS_NAME		sp21a_tonbo
//#define		LINE_KMS_NAME		sp21a_line

// キャラクター関係
#define		PLAYER		ライデン


// ------------------------------------
// 標的ルート番号と共通ステータス
// ------------------------------------
enum M_R {
//	共通ルート０ = 0,	// 欠番
	ライデンルート１ = 1,
	ライデンルート２, ライデンルート３, ライデンルート４, ライデンルート５, ライデンルート６,
	ライデンルート７, ライデンルート８, ライデンルート９, ライデンルート１０, ライデンルート１１,
	ライデンルート１２, ライデンルート１３, ライデンルート１４, ライデンルート１５, ライデンルート１６,
	ライデンルート１７, ライデンルート１８, ライデンルート１９, ライデンルート２０, ライデンルート２１,
	ライデンルート２２, ライデンルート２３, ライデンルート２４, ライデンルート２５,

	スネークルート２６, スネークルート２７, スネークルート２８, スネークルート２９, スネークルート３０,
	スネークルート３１, スネークルート３２, スネークルート３３, スネークルート３４, スネークルート３５,
	スネークルート３６, スネークルート３７, スネークルート３８, スネークルート３９, スネークルート４０,
	スネークルート４１, スネークルート４２, スネークルート４３, スネークルート４４, スネークルート４５,
	スネークルート４６, スネークルート４７, スネークルート４８, スネークルート４９, スネークルート５０,
	スネークルート５１, スネークルート５２, スネークルート５３, スネークルート５４, スネークルート５５,
	スネークルート５６, スネークルート５７, スネークルート５８, スネークルート５９, スネークルート６０,
	スネークルート６１, スネークルート６２, スネークルート６３, スネークルート６４, スネークルート６５,
	スネークルート６６, スネークルート６７, スネークルート６８, スネークルート６９, スネークルート７０,
	スネークルート７１, スネークルート７２, スネークルート７３, スネークルート７４, スネークルート７５,
	スネークルート７６, スネークルート７７, スネークルート７８, スネークルート７９, スネークルート８０,
}



