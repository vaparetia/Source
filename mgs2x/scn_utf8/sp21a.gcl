// ------------------------------------
// マップ設定
// ------------------------------------
chara マップ 主観ステージ -k d:KMS_NAME -h d:HZX_NAME,0 -l $s:ＶＲライトファイル名

command マップ設定 主観ステージ -set {
	// ローカルの初期化
	// ------------------------------------
	@ローカル変数初期化		// ローカルで使用する変数で初期化をする場合はここで

	// ＶＲで必要な基本プロックのセット(vr_common.hで定義)
	// サウンドの基本パック、ＶＲの基本システム、プレイヤー、ゴール等を設定します
	// ※このプロックを使用する時は「ＶＲクリア時処理」というプロックが必要です
	// ------------------------------------
	@ＶＲ共通プロックセット sna_sp21a rai_sp21a d:VR_GOAL_TARGET 1000 8000 -59000

	// クリア時に呼ばれるものの設定
	@ＶＲクリア設定 p:ネクストステージ処理 p:リトライステージ処理


	// ＶＲウィンドウの設定
	// ------------------------------------
	@主観ステージ１面ＶＲウィンドウ設定

	// ステージに引かれるライン
	// ------------------------------------
	@ＶＲアウトライン d:KMS_NAME d:TONBO_KMS_NAME d:LINE_KMS_NAME

	// 設定値を変更する場合は以下のプロック内で設定
	// ------------------------------------
	@設定値変更				// 敵兵や的のパラメータをステージ限定で変える時はここで

	// プレイヤーの設定
	// ------------------------------------
	@プラグイン設定			// プレイヤーのプラグインがいる時はここで

	// 敵兵・的関係の設定
	// ------------------------------------
	@主観ステージ標的１面設定				// ＶＲシステム起動後に呼ぶ
	@ＡＣＴ２トラップ起動
	@ＡＣＴ３トラップ起動
	@ＡＣＴ４トラップ起動

	// ＢＧＭの設定(プレイヤー→敵兵→BGMの順で呼ぶ)
	// ------------------------------------
	@ＢＧＭ設定

	// アイテムの設定
	// ------------------------------------
	@アイテム収得範囲変更
	@アイテム設定

	// 光源、オブジェクト、カメラ関連の設定
	// ------------------------------------
	@ＶＲフォグ設定 d:VR_FOG:朝Ｎ d:VR_FOG:朝Ｆ d:VR_FOG:夕Ｎ d:VR_FOG:夕Ｆ d:VR_FOG:夜Ｎ d:VR_FOG:夜Ｆ
	@カメラセット					// chara カメラとベースのカメラを設定
	@主観ステージ１面カメラ設定		// ステージ固有のカメラ設定がいる時はこのプロックで
	@ＶＲキャラ用ライト設置			// 必ず最後に設定
#if d:DEBUG_CHARA
//	@デバッグキャラセット
#endif
}

//初期マップの表示
command マップ表示 -show 主観ステージ


// 各proc設定
//-------------------------------------------------------------------------------------
// 全マップ共通
	//------------------------------------------------------------
	// ＶＲウィンドウの設定と表示
	//------------------------------------------------------------
	proc 主観ステージ１面ＶＲウィンドウ設定 {
		#if d:DEBUG_PRINT
			print 'vr_window_set'
		#endif

		// スタート時とクリア時に使用するカットインカメラ
		chara カメラ カットインカメラ -c 0 -l 0 -p  0

		// 主観ステージ１面
		@ＶＲウィンドウ設定 [VRMSG_J:VRM_FPV_sp21a] [VRMSG_E:VRM_FPV_sp21a] [VRMSG_G:VRM_FPV_sp21a] \	// 日、英、独
							[VRMSG_F:VRM_FPV_sp21a] [VRMSG_I:VRM_FPV_sp21a] [VRMSG_S:VRM_FPV_sp21a] \	// 仏、伊、西
							[VRMSG_K:VRM_FPV_sp21a] \													// 韓
							p:ＶＲステージ開始時処理	// 終了プロック

		// スタート時のカメラ(必要な場合)
		chara カメラ設定 カットインカメラ \
			-c 1 \
			-p 1000,11308,-53863 -t 1000,6767,-61627 \
			-r 345,2048,0 -f 8995 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1

		// ＶＲウィンドウを表示する
		mesg ＶＲウィンドウ ＶＲウィンドウ君 開く
	}

	//------------------------------------------------------------
	// ステージ開始時処理
	//------------------------------------------------------------
	proc ＶＲステージ開始時処理 {
		#if d:DEBUG_PRINT
			print 'game_start!!!!!'
		#endif

		// プレイヤーやパッドの制御等を行う a_stdproc.hで定義
		@全ミッション共通ステージ開始時処理

		// カメラワークスタート(必要な場合)
		chara カメラ設定 カットインカメラ \
			-c 1 \
			-p 1000,22838,-9260 -t 1000,17684,-16626 \
			-r 398,2048,0 -f 8990 \
			-a 200 \
			-i 4 4 d:START_CAMERA_CHANGE_TIME d:START_CAMERA_CHANGE_TIME \
			-s 1

		chara delay ディレイ \
			-time d:START_CAMERA_CHANGE_TIME \
			-exec {
				chara カメラ設定 カットインカメラ -s -1
			}
	}


	// ------------------------------------
	// クリア時の処理
	// ------------------------------------
	proc ＶＲクリア時処理 {
		#if d:DEBUG_PRINT 
			print 'clear'
		#endif

		// 強制モーションを発動
		@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_1 2048

		// クリア時にカメラアングルを変える
		chara カメラ設定 クリア時カメラ \
			-c 1 \
			-p 125,9163,-61943 -t 865,8844,-59502 \
			-r 81,192,0 -f 2570 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}

	//------------------------------------------------------------
	// ステージ開始直後処理
	//------------------------------------------------------------
	proc ゲーム開始直後処理 {
		// 初期配置標的の起動（command ＶＲステージスタート の起動直後に行う必要がある）
		@主観ステージ初期配置標的１面設定
	}

	//------------------------------------------------------------
	// クリア直後処理
	//------------------------------------------------------------
	proc ネクストステージ処理 {
		@アイテム収得範囲リセット
		@load_sp22a
	}

	proc  リトライステージ処理{
		@アイテム収得範囲リセット
		@A_ＲＥＴＲＹプロック
	}



	// ------------------------------------
	// パラメータ系の変更
	// ------------------------------------
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT 
			print 'localvar_init'
		#endif

		// DEBUG用
//		$b:主観モード番号 = 2;		// MGSライクな操作感♪

		// 的管理用各種フラグを初期化する
		$$b:act_1_破壊数カウント = 0;
		$$b:act_2_破壊数カウント = 0;
		$$b:act_3_破壊数カウント = 0;
		$$b:act_4_破壊数カウント = 0;
		$$b:act_5_破壊数カウント = 0;
		$$b:act_6_破壊数カウント = 0;

		$$b:ＡＣＴ２トラップ起動制御 = 0
		$$b:ＡＣＴ３トラップ起動制御 = 0
		$$b:ＡＣＴ４トラップ起動制御 = 0

		// 他の担当ステージとは文法が違うので注意。
		$$i:標的フラグＡ１ = ( d:VR_TRG_NORMAL | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_WAIT )
		$$i:標的フラグＡ２ = ( d:VR_TRG_NORMAL | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_WAIT | d:VR_TRG_P_DIR | d:VR_TRG_NO_SIGHT )

		$$i:標的フラグＣ１ = ( d:VR_TRG_CROSS | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_WAIT )
		$$i:標的フラグＣ２ = ( d:VR_TRG_CROSS | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_WAIT | d:VR_TRG_NO_APPEAR_EF )

		$$i:標的フラグＯ１ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_WAIT | d:VR_TRG_NO_APPEAR_EF )
	}
	
	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT 
			print 'status_set'
		#endif

		// 初期装備の設定
//		$w:武器弾数Ｒ[ d:武器:ＲＧＢ６ ] = 54
//		$w:武器 = d:武器:ＲＧＢ６

		if ( $s:選択プレイヤー == ライデン ) {
			// ライデン系を選択
			$w:武器弾数Ｒ[d:武器:ソコム] = 25;
			$w:武器 = d:武器:ソコム;
//			$w:武器弾数Ｒ[ d:武器:Ｍ４ ] = 991
//			$w:武器 = d:武器:Ｍ４
		} else {
			// スネーク系を選択
			$w:武器弾数Ｒ[ d:武器:ＵＳＰ ] = 31;
			$w:武器 = d:武器:ＵＳＰ;
//			$w:武器弾数Ｒ[ d:武器:ＡＫＳ ] = 991
//			$w:武器 = d:武器:ＡＫＳ
//			$w:アイテム = d:アイテム:ＡＫサプレッサ

			command メニュー設定 -node_access off
		}

		if ( $s:選択プレイヤー == ライデン ) {
		} else {
		}

	}



	// ------------------------------------
	// プレイヤーに関する設定
	//-------------------------------------
	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif

	}



	// ------------------------------------
	// 標的に関する設定
	//-------------------------------------
	// 破壊時処理
	// ------------------------------------
	proc 主観ステージ標的破壊１面処理 {

		// ライデンを選択
		if ( $s:選択プレイヤー == ライデン ) {

			// act 1 ----------
			if ( ($1 == 移動的:01) || ($1 == 移動的:02) || ($1 == 移動的:03) ) {
				$$b:act_1_破壊数カウント = $$b:act_1_破壊数カウント + 1

			// act 2 ----------
			} else if ( ($1 == 移動的:04) || ($1 == 移動的:05) || ($1 == 移動的:06) || ($1 == 移動的:07) || \
						($1 == 移動的:08) || ($1 == 移動的:09) || ($1 == 移動的:10) || ($1 == 移動的:11) ) {
				$$b:act_2_破壊数カウント = $$b:act_2_破壊数カウント + 1
				if( $$b:act_2_破壊数カウント == 1 ){
					mesg ＶＲ的共通 移動的:08 移動開始
				} else if( $$b:act_2_破壊数カウント == 2 ){
					mesg ＶＲ的共通 移動的:09 移動開始
				} else if( $$b:act_2_破壊数カウント == 3 ){
					mesg ＶＲ的共通 移動的:10 移動開始
				} else if( $$b:act_2_破壊数カウント == 4 ){
					mesg ＶＲ的共通 移動的:11 移動開始
				} else if( $$b:act_2_破壊数カウント == 8 ){
					mesg ＶＲ的共通 移動的:12 移動開始
					mesg ＶＲ的共通 移動的:13 移動開始
					mesg ＶＲ的共通 移動的:14 移動開始
					mesg ＶＲ的共通 移動的:15 移動開始
				}

			// act 3 ----------
			} else if ( ($1 == 移動的:12) || ($1 == 移動的:13) || ($1 == 移動的:14) || ($1 == 移動的:15) ) {
				$$b:act_3_破壊数カウント = $$b:act_3_破壊数カウント + 1

			}

		// スネークを選択
		} else if ( $s:選択プレイヤー == スネーク ) {

			// act 1 ----------
			if ( ($1 == 移動的:01) || ($1 == 移動的:02) || ($1 == 移動的:03) || ($1 == 移動的:04) ) {
				$$b:act_1_破壊数カウント = $$b:act_1_破壊数カウント + 1

			// act 2 ----------
			} else if ( ($1 == 移動的:05) || ($1 == 移動的:06) || ($1 == 移動的:07) || \
						($1 == 移動的:08) || ($1 == 移動的:09) || ($1 == 移動的:10) || \
						($1 == 移動的:11) || ($1 == 移動的:12) || ($1 == 移動的:13) ) {
				$$b:act_2_破壊数カウント = $$b:act_2_破壊数カウント + 1

				if( $$b:act_2_破壊数カウント == 1 ){
					mesg ＶＲ的共通 移動的:06 移動開始
					mesg ＶＲ的共通 移動的:07 移動開始
				} else if( $$b:act_2_破壊数カウント == 3 ){
					mesg ＶＲ的共通 移動的:08 移動開始
					mesg ＶＲ的共通 移動的:09 移動開始
					mesg ＶＲ的共通 移動的:10 移動開始
				} else if( $$b:act_2_破壊数カウント == 6 ){
					mesg ＶＲ的共通 移動的:11 移動開始
					mesg ＶＲ的共通 移動的:12 移動開始
					mesg ＶＲ的共通 移動的:13 移動開始
				}

			// act 3 ----------
			} else if ( ($1 == 移動的:14) || ($1 == 移動的:15) || ($1 == 移動的:16) || ($1 == 移動的:17) ) {
				$$b:act_3_破壊数カウント = $$b:act_3_破壊数カウント + 1
			}

		}

	}

	// 敵兵や的の処理
	// ------------------------------------
	proc 主観ステージ標的１面設定 {

		// ライデンを選択
		if ( $s:選択プレイヤー == ライデン ) {

			// 通常標的
			command foreach -argc 5 -repeat 25 \
			-data { \
				// 的名,     フラグ,             ルート,     自転初期方向, スピード
				// act 1 ----------
				{ 移動的:01, $$i:標的フラグＡ１, d:M_R:ライデンルート１,      0,  50 }\
				{ 移動的:02, $$i:標的フラグＡ１, d:M_R:ライデンルート２,      0,  50 }\
				{ 移動的:03, $$i:標的フラグＡ１, d:M_R:ライデンルート３,      0,  50 }\
				// act 2 ----------
				{ 移動的:04, $$i:標的フラグＯ１, d:M_R:ライデンルート４,      0, 100 }\
				{ 移動的:05, $$i:標的フラグＯ１, d:M_R:ライデンルート５,      0, 100 }\
				{ 移動的:06, $$i:標的フラグＯ１, d:M_R:ライデンルート６,      0, 100 }\
				{ 移動的:07, $$i:標的フラグＯ１, d:M_R:ライデンルート７,      0, 100 }\
				{ 移動的:08, $$i:標的フラグＯ１, d:M_R:ライデンルート８,      0, 100 }\
				{ 移動的:09, $$i:標的フラグＯ１, d:M_R:ライデンルート９,      0, 100 }\
				{ 移動的:10, $$i:標的フラグＯ１, d:M_R:ライデンルート１０,    0, 100 }\
				{ 移動的:11, $$i:標的フラグＯ１, d:M_R:ライデンルート１１,    0, 100 }\
				// act 3 ----------
				{ 移動的:12, $$i:標的フラグＡ１, d:M_R:ライデンルート１２,  256,   0 }\
				{ 移動的:13, $$i:標的フラグＡ１, d:M_R:ライデンルート１３,  256,   0 }\
				{ 移動的:14, $$i:標的フラグＡ１, d:M_R:ライデンルート１４, 3840,   0 }\
				{ 移動的:15, $$i:標的フラグＡ１, d:M_R:ライデンルート１５, 3840,   0 }\
				// act 4 ----------
				{ 移動的:16, $$i:標的フラグＡ２, d:M_R:ライデンルート１６,    0,  50 }\
				{ 移動的:17, $$i:標的フラグＡ２, d:M_R:ライデンルート１７,    0,  50 }\
				{ 移動的:18, $$i:標的フラグＡ２, d:M_R:ライデンルート１８,    0,  50 }\
				{ 移動的:19, $$i:標的フラグＡ２, d:M_R:ライデンルート１９,    0,  50 }\
				{ 移動的:20, $$i:標的フラグＡ２, d:M_R:ライデンルート２０,    0,  50 }\
				// act 5 ----------
				{ 移動的:21, $$i:標的フラグＣ１, d:M_R:ライデンルート２１,    0,  50 }\
				{ 移動的:22, $$i:標的フラグＣ１, d:M_R:ライデンルート２２,    0,  50 }\
				{ 移動的:23, $$i:標的フラグＣ１, d:M_R:ライデンルート２３,    0,  50 }\
				{ 移動的:24, $$i:標的フラグＣ１, d:M_R:ライデンルート２４,    0,  50 }\
				{ 移動的:25, $$i:標的フラグＣ１, d:M_R:ライデンルート２５,    0,  50 }\
			} \
			-exec { \

				chara ＶＲ移動的 $1 \
					-flag $2 \
					-route $3 \
					-dir $4 0 \
					-c 主観ステージ標的破壊１面処理 \
					-speed $5
			}

		//	スネークを選択
		} else if ( $s:選択プレイヤー == スネーク ) {

			// 通常標的
			command foreach -argc 5 -repeat 27 \
			-data { \
				// 的名,     フラグ,             ルート,     自転初期方向, スピード
				// act 1 ----------
				{ 移動的:01, $$i:標的フラグＡ１, d:M_R:スネークルート２６,    0,  50 }\
				{ 移動的:02, $$i:標的フラグＡ１, d:M_R:スネークルート２７,    0,  50 }\
				{ 移動的:03, $$i:標的フラグＡ１, d:M_R:スネークルート２８, 3072,  50 }\
				{ 移動的:04, $$i:標的フラグＡ１, d:M_R:スネークルート２９, 3072,  50 }\
				// act 2 ----------
				{ 移動的:05, $$i:標的フラグＣ２, d:M_R:スネークルート３０,    0, 100 }\
				{ 移動的:06, $$i:標的フラグＣ２, d:M_R:スネークルート３１,    0, 100 }\
				{ 移動的:07, $$i:標的フラグＣ２, d:M_R:スネークルート３２,    0, 100 }\
				{ 移動的:08, $$i:標的フラグＣ２, d:M_R:スネークルート３３,    0, 100 }\
				{ 移動的:09, $$i:標的フラグＣ２, d:M_R:スネークルート３４,    0, 100 }\
				{ 移動的:10, $$i:標的フラグＣ２, d:M_R:スネークルート３５,    0, 100 }\
				{ 移動的:11, $$i:標的フラグＣ２, d:M_R:スネークルート３６,    0, 100 }\
				{ 移動的:12, $$i:標的フラグＣ２, d:M_R:スネークルート３７,    0, 100 }\
				{ 移動的:13, $$i:標的フラグＣ２, d:M_R:スネークルート３８,    0, 100 }\
				// act 3 ----------
				{ 移動的:14, $$i:標的フラグＯ１, d:M_R:スネークルート３９,    0, 100 }\
				{ 移動的:15, $$i:標的フラグＯ１, d:M_R:スネークルート４０,    0, 100 }\
				{ 移動的:16, $$i:標的フラグＯ１, d:M_R:スネークルート４１,    0,   0 }\
				{ 移動的:17, $$i:標的フラグＯ１, d:M_R:スネークルート４２,    0,   0 }\
				// act 4 ----------
				{ 移動的:18, $$i:標的フラグＡ２, d:M_R:スネークルート４３,    0,  75 }\
				{ 移動的:19, $$i:標的フラグＡ２, d:M_R:スネークルート４４,    0,  75 }\
				{ 移動的:20, $$i:標的フラグＡ２, d:M_R:スネークルート４５,    0,  75 }\
				{ 移動的:21, $$i:標的フラグＡ２, d:M_R:スネークルート４６,    0,  75 }\
				{ 移動的:22, $$i:標的フラグＡ２, d:M_R:スネークルート４７,    0,  75 }\
				// act 5 ----------
				{ 移動的:23, $$i:標的フラグＣ２, d:M_R:スネークルート４８,    0,  75 }\
				{ 移動的:24, $$i:標的フラグＣ２, d:M_R:スネークルート４９,    0,  75 }\
				{ 移動的:25, $$i:標的フラグＣ２, d:M_R:スネークルート５０,    0,  75 }\
				{ 移動的:26, $$i:標的フラグＣ２, d:M_R:スネークルート５１,    0,  75 }\
				{ 移動的:27, $$i:標的フラグＣ２, d:M_R:スネークルート５２,    0,  75 }\
			} \
			-exec { \

				chara ＶＲ移動的 $1 \
					-flag $2 \
					-route $3 \
					-dir $4 0 \
					-c 主観ステージ標的破壊１面処理 \
					-speed $5
			}

		}

	}

	proc 主観ステージ初期配置標的１面設定 {
		// 共通標的 （主にライデン）
		mesg ＶＲ的共通 移動的:01 移動開始
		mesg ＶＲ的共通 移動的:02 移動開始
		mesg ＶＲ的共通 移動的:03 移動開始

		// 他キャラ選択時の追加標的s
		// スネーク or プリスキン
		if ( ($s:選択プレイヤー == スネーク) || ($s:選択プレイヤー == プリスキン) ) {
			mesg ＶＲ的共通 移動的:04 移動開始
		// 前作スネーク
		} else if ( $s:選択プレイヤー == 前作スネーク ) {
			// 現状ではスネークルートを流用
		}
	}

	proc ＡＣＴ２トラップ起動 {
		trap act2_on d:PLAYER \
			-mask ＊ \
//			-and \
//			-dir 2048 256 \
			-exec {

				if( $b:ＡＣＴ２トラップ起動制御 == 0 ){
					// ライデンを選択
					if ( ($s:選択プレイヤー == ライデン) && ($$b:act_1_破壊数カウント == 3) ) {
						mesg ＶＲ的共通 移動的:04 移動開始
						mesg ＶＲ的共通 移動的:05 移動開始
						mesg ＶＲ的共通 移動的:06 移動開始
						mesg ＶＲ的共通 移動的:07 移動開始
						$b:ＡＣＴ２トラップ起動制御 = 1
					// スネークを選択
					} else if ( ($s:選択プレイヤー == スネーク) && ($$b:act_1_破壊数カウント == 4) ) {
						mesg ＶＲ的共通 移動的:05 移動開始
						$b:ＡＣＴ２トラップ起動制御 = 1
					}
				}
			}
	}

	proc ＡＣＴ３トラップ起動 {
		trap act4_on d:PLAYER \		// 引っ掛けるのはact4_on
			-mask ＊ \
//			-and \
//			-dir 2048 256 \
			-exec {

				if( ($b:ＡＣＴ３トラップ起動制御 == 0) && ($s:選択プレイヤー == スネーク) && ($$b:act_2_破壊数カウント == 9) ){
					// スネークを選択
					mesg ＶＲ的共通 移動的:14 移動開始
					mesg ＶＲ的共通 移動的:15 移動開始
					mesg ＶＲ的共通 移動的:16 移動開始
					mesg ＶＲ的共通 移動的:17 移動開始
					$b:ＡＣＴ３トラップ起動制御 = 1
				}
			}
	}

	proc ＡＣＴ４トラップ起動 {
		trap act4_on d:PLAYER \
			-mask ＊ \
//			-and \
			-dir 2048 256 \
			-exec {

				if( $b:ＡＣＴ４トラップ起動制御 == 0 ){
					// ライデンを選択
					if ( ($s:選択プレイヤー == ライデン) && ($$b:act_3_破壊数カウント == 4) ) {
						mesg ＶＲ的共通 移動的:16 移動開始
						mesg ＶＲ的共通 移動的:17 移動開始
						mesg ＶＲ的共通 移動的:18 移動開始
						mesg ＶＲ的共通 移動的:19 移動開始
						mesg ＶＲ的共通 移動的:20 移動開始
						mesg ＶＲ的共通 移動的:21 移動開始
						mesg ＶＲ的共通 移動的:22 移動開始
						mesg ＶＲ的共通 移動的:23 移動開始
						mesg ＶＲ的共通 移動的:24 移動開始
						mesg ＶＲ的共通 移動的:25 移動開始
						$b:ＡＣＴ４トラップ起動制御 = 1
					// スネークを選択
					} else if ( ($s:選択プレイヤー == スネーク) && ($$b:act_3_破壊数カウント == 4) ) {
						mesg ＶＲ的共通 移動的:18 移動開始
						mesg ＶＲ的共通 移動的:19 移動開始
						mesg ＶＲ的共通 移動的:20 移動開始
						mesg ＶＲ的共通 移動的:21 移動開始
						mesg ＶＲ的共通 移動的:22 移動開始
						mesg ＶＲ的共通 移動的:23 移動開始
						mesg ＶＲ的共通 移動的:24 移動開始
						mesg ＶＲ的共通 移動的:25 移動開始
						mesg ＶＲ的共通 移動的:26 移動開始
						mesg ＶＲ的共通 移動的:27 移動開始
						$b:ＡＣＴ４トラップ起動制御 = 1
					}
				}
			}
	}


	// ------------------------------------
	// ＢＧＭの設定
	// ------------------------------------
	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT 
			print 'bgm_set'
		#endif

		chara ＢＧＭマネージャー ＢＧＭマネ
	}


	// ------------------------------------
	// アイテムの設定
	// ------------------------------------
	// 再発生が必要な時は以下のプロックの中を記述する
	// ------------------------------------
	proc アイテム収得範囲変更 {
		command アイテム収得可能範囲設定 750 1000 750
	}

	proc アイテム収得範囲リセット {
		command アイテム収得可能範囲設定 300 1500 300
	}

	proc アイテム取得時番号設定 $:ボックス名 {
		#if d:DEBUG_PRINT
			print 'item_no_set'
		#endif
	}

	// アイテムの設置
	// ------------------------------------
	proc アイテム設定 {
		#if d:DEBUG_PRINT 
			print 'item_set'
		#endif

		if ( $s:選択プレイヤー == ライデン ) {

			// ソコム弾数(12)(109)
//			@A_ソコム_初期設置 ソコム本体:01 0 0 0 0 なし 25
			@弾薬_ソコム_初期設置 ソコム弾:01 4000 3000 -21500 0
			@弾薬_ソコム_初期設置 ソコム弾:02 0 8000 -43000 0

			// Ｍ４弾数(30)(991)
			@A_Ｍ４_初期設置 Ｍ４本体:01 1000 8000 -37000 0 なし 91
			@弾薬_Ｍ４_初期設置 Ｍ４弾:01 2000 8000 -48000 0

			// ＲＧＢ６弾数(6)(54)
			@A_ＲＧＢ６_初期設置 ＲＧＢ６本体:01 1000 3000 -11500 0 なし 18
			@弾薬_ＲＧＢ６_初期設置 ＲＧＢ６弾:01 -2000 3000 -22000 0

		} else {

			// ＵＳＰ弾数(15)(106)
//			@A_ＵＳＰ_初期設置 ＵＳＰ本体:01 0 0 0 0 なし 31
			@弾薬_ＵＳＰ_初期設置 ＵＳＰ弾:01 2000 8000 -47000 0

			// ＡＫＳ弾数(30)(991)
			@A_ＡＫＳ_初期設置 ＡＫＳ本体:01 1000 3000 -11500 0 なし 121
			@弾薬_ＡＫＳ_初期設置 ＡＫＳ弾:01 4000 3000 -22000 0
			@弾薬_ＡＫＳ_初期設置 ＡＫＳ弾:02 1000 8000 -39000 0
			@弾薬_ＡＫＳ_初期設置 ＡＫＳ弾:03 1000 8000 -52000 0

			// ＲＧＢ６弾数(6)(54)
			@A_ＲＧＢ６_初期設置 ＲＧＢ６本体:01 1000 8000 -37000 0 なし 12
//			@弾薬_ＲＧＢ６_初期設置 ＲＧＢ６弾:01 0 0 0 0
		}

	}



	// ------------------------------------
	// その他オブジェクト関係
	// ------------------------------------


	// ------------------------------------
	// カメラ関係の設定 
	// ------------------------------------
	// ステージカメラ設定 
	// ------------------------------------
	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'chara_camera & stage_camera_set'
		#endif

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0 
		chara カメラ メインカメラ		-c 0 -l 2 -p 40
		chara カメラ クリア時カメラ		-c 0 -l 0 -p 10

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \	
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 175,2048,0 \
			-f 9000 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}

	// ステージ固有のカメラ設定
	// ------------------------------------
	proc 主観ステージ１面カメラ設定 {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif
	}




// -----------------------------------------------------------------------------------
// 以下デバッグ専用proc
// -----------------------------------------------------------------------------------
// デバッグキャラ
// ------------------------------------
proc デバッグキャラセット {
	#if d:DEBUG_PRINT
		print 'debug_chara_set'
	#endif

	#if d:CHARA_CAMERA
		chara キャラカメラ 敵兵カメラ \
			-c d:TARGET_CHARA \
			-s -920,610,200 \
			-r -200,1024,0 
	#endif

	#if d:SCREENSHOT
		chara スクリーンショット shot
	#endif

	#if d:USB_KEY
		chara USBキーボード実行 test \
			-e d:KBD_ESC {	
				mesg プレイヤー d:PLAYER position -5500, -13000, -500
			} \
	#endif
}
