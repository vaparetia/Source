//●ＳＡＶＥメニューが出る前 d//e
//・普通 h//e
resource TO_ＳＡＶＥ前普通１__i{
オタコン_000: {
Vuoi salvare, Snake?
}
//	<<<ENGLISH>>>
//	Do you want to save, Snake?

/*＃｛記録、セーブ｝＃するかい、スネーク？*/
}//d

resource TO_ＳＡＶＥ前普通２__i{
オタコン_000: {
&`E ora di salvare?
}
//	<<<ENGLISH>>>
//	Time to save?

/*＃｛記録、セーブ｝＃だね？*/
}//d

resource TO_ＳＡＶＥ前普通３__i {
オタコン_000: {
Ah, devi salvare. Un attimo.
}
//	<<<ENGLISH>>>
//	Oh, you need to save. Just a second.

/*ああ、＃｛記録、セーブ｝＃だね？すぐ準備する。*/
}//d

resource TO_ＳＡＶＥ前普通４__i {
オタコン_000: {
Ah, Snake, vuoi salvare?
}
//	<<<ENGLISH>>>
//	Oh, Snake, you want to save?

/*スネーク、＃｛記録、セーブ｝＃したいのかい？*/
}//d


//・緊迫状態 h//e
resource TO_ＳＡＶＥ前緊迫１__i {
オタコン_000: {
Devi salvare, Snake, giusto?
}
//	<<<ENGLISH(2)>>>
//	Need to save, right, Snake?

/*＃｛記録、セーブ｝＃だね、スネーク？*/
}//d

resource TO_ＳＡＶＥ前緊迫２__i {
オタコン_000: {
Tutto a posto, Snake? Se sei pronto,
anch'io sono pronto a salvare.
}
//	<<<ENGLISH>>>
//	You all right, Snake?
//	I'm ready to save whenever you are.

/*大丈夫かい、スネーク？
＃｛記録、セーブ｝＃の準備なら出来てるよ？
*/
}//d

resource TO_ＳＡＶＥ前緊迫３__i {
オタコン_000: {
Snake! Grazie al cielo! Se ti serve,
posso fare un salvataggio rapido.
}
//	<<<ENGLISH>>>
//	Snake! Thank God!
//	I can do a quick save if you need.

/*スネーク！無事かい？
＃｛記録、セーブ｝＃ならすぐ出来るよ
*/
}//d

resource TO_ＳＡＶＥ前緊迫４__i {
オタコン_000: {
Snake! Devi salvare?
}
//	<<<ENGLISH>>>
//	Snake! Do you need to save?

/*スネーク！＃｛記録、セーブ｝＃かい？*/
}//d




//記録するメニューを選ばなかった場合  h//e
//普通 //e
resource TO_未セーブ終了普通１__i {
//ns
オタコン_000: {
Okay, ci vediamo, Snake.
}
//	<<<ENGLISH>>>
//	OK, see you, Snake.

/*じゃあね、スネーク。*/
}//d

resource TO_未セーブ終了普通２__i {
//ns
オタコン_000: {
Tieni duro.
}
//	<<<ENGLISH(2)>>>
//	Hang in there.

/*がんばってくれよ*/
}//d

resource TO_未セーブ終了普通３__i {
//ns
オタコン_000: {
Ah, ma allora non salvi? 
Beh, okay, fammi sapere
quando
}
//	<<<ENGLISH>>>
//	Oh, you're not going to save?
//	Well, okay, just let me know
//	when you need to.

/*なんだ、＃｛記録、セーブ｝＃しないのかい？
ま、いいや。＃｛記録、セーブ｝＃したくなったら、
また連絡してくれ。
*/
}//d

resource TO_未セーブ終了普通４__i {
//ns
オタコン_000: {
Okay, Snake, tieniti alla larga dai guai.
}
//	<<<ENGLISH>>>
//	OK, Snake. Stay out of trouble.

/*ＯＫ。スネーク、気をつけて。*/
}//d

resource TO_未セーブ終了普通５__i {
//ns
オタコン_000: {
Senti, Snake, questa frequenza &`e
solo per salvare. Ti ricordi?
}
//	<<<ENGLISH>>>
//	Look, Snake, this frequency is
//	for saving only. Remember?

/*スネーク、これは＃｛記録、セーブ｝＃専用の
回線なんだけど……。
*/
}//d


//・緊迫 //e
resource TO_未セーブ終了緊迫１__i {
//ns
オタコン_000: {
Tieni duro, Snake!
}
//	<<<ENGLISH>>>
//	Hang in there, Snake!

/*頑張ってくれよ、スネーク！*/
}//d

resource TO_未セーブ終了緊迫２__i {
//ns
オタコン_000: {
Dimmi subito quando vuoi salvare, va
bene? Non farti sorprendere!
}
//	<<<ENGLISH>>>
//	Let me know as soon as you
//	need to save, okay? Don't let
//	them get you!

/*＃｛記録、セーブ｝＃が必要になったらすぐ
連絡してくれ。負けるなよ！
*/
}//d

resource TO_未セーブ終了緊迫３__i {
//ns
オタコン_000: {
Non mollare!
}
//	<<<ENGLISH(2)>>>
//	Don't give up!

/*あきらめないでくれよ！*/
}//d

resource TO_未セーブ終了緊迫４__i {
//ns
オタコン_000: {
Snake!
Devi assolutamente sopravvivere!
}
//	<<<ENGLISH>>>
//	Snake!
//	You've got to stay alive!

/*勝つんだ、スネーク！*/
}//d


//・汎用無言 //e
resource TO_無言__i {
//ns
オタコン_000: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
}//d


//●ＳＡＶＥ失敗  h//e
//・メモリーカードがない h //e
resource TO_ＳＡＶＥ失敗メモリーカードない__i {
//ns
オタコン_000: {
Ehi, non c'&`e la MEMORY CARD
(PS2) nell'ingresso
MEMORY CARD.
}
//	<<<ENGLISH>>>
//	Hey, there's no MEMORY CARD
//	(PlayStation&@R2) in the MEMORY
//	CARD slot.

/*あ、＃｛ＭＥＭＯＲＹ、メモリー｝＃ ＃｛ＣＡＲＤ、カード｝＃差込口に
＃｛"PlaySation2"、ピーエスツー｝＃専用メモリーカードが
ささってないよ。
*/

オタコン_001: {
Non puoi salvare senza avere
una MEMORY CARD (PS2)
pronta.
}
//	<<<ENGLISH>>>
//	Saving can't be done unless you have
//	a MEMORY CARD (PlayStation&@R2)
//	ready.

/*＃｛記録、セーブ｝＃するには＃｛"PlaySation2"、ピーエスツー｝＃専用
メモリーカードが必要なんだ。
*/

オタコン_002: {
Devi impostare la MEMORY CARD
(PS2) nell'ingresso MEMORY CARD.
}
//	<<<ENGLISH>>>
//	You need to set the MEMORY CARD
//	(PlayStation&@R2) in the MEMORY CARD
//	slot.

/*＃｛ＭＥＭＯＲＹ、メモリー｝＃ ＃｛ＣＡＲＤ、カード｝＃差込口に
＃｛"PlaySation2"、ピーエスツー｝＃専用メモリーカードを
セットしてくれ。
*/
}//d


//・空き領域がない h //e
resource TO_ＳＡＶＥ失敗空領域ない__i {
//ns
オタコン_000: {
Oh no, Snake! Non avevi abbastanza
memoria sulla MEMORY CARD
(PS2) per salvare il gioco.
}
//	<<<ENGLISH>>>
//	Oh no. Snake, there wasn't enough
//	space left on the MEMORY CARD
//	(PlayStation&@R2) to save the game.

/*うーん。スネーク、＃｛"PlaySation2"、ピーエスツー｝＃専用
メモリーカードに空き領域がなくて
＃｛記録、セーブ｝＃出来なかったよ。
*/

}//d


//・フォーマットしようとしない  h //e
resource TO_ＳＡＶＥ失敗フォーマットしようとしない__i {
//ns
オタコン_000: {
Scusa ma... se non formatti
non puoi mica salvare, lo sai.
}
//	<<<ENGLISH>>>
//	'Scuse me but -- you can't save
//	unless you format, you know.

/*あのー、フォーマットしないと＃｛記録、セーブ｝＃は
出来ないんだけど、わかってる？
*/

}//d


//・その他エラー  h //e
resource TO_ＳＡＶＥ失敗その他エラー__i {
//ns
オタコン_000: {
Mi dispiace, Snake. C'&`e stato un
errore e non ho potuto salvare.
}
//	<<<ENGLISH>>>
//	I'm really sorry, Snake.
//	There was an error and
//	I couldn't save.

/*スネーク、ごめん。エラーが起きて
＃｛記録、セーブ｝＃できなかった。
*/

}//d


//●ＳＡＶＥ失敗緊迫  h//e
//・メモリーカードがない緊迫 h //e
resource TO_ＳＡＶＥ失敗メモリーカードない緊迫__i {
//ns
オタコン_000: {
Non c'&`e la MEMORY CARD
(PS2) nell'ingresso
MEMORY CARD!
}
//	<<<ENGLISH(2)>>>
//	There's no MEMORY CARD
//	(PlayStation&@R2) in the MEMORY
//	CARD slot!

/*あ、＃｛ＭＥＭＯＲＹ、メモリー｝＃ ＃｛ＣＡＲＤ、カード｝＃差込口に
＃｛"PlaySation2"、ピーエスツー｝＃専用メモリーカードが
ささってない！
*/

オタコン_001: {
Non posso salvare se non hai una
MEMORY CARD (PS2) pronta!
}
//	<<<ENGLISH>>>
//	I can't save unless you have a
//	MEMORY CARD (PlayStation&@R2)
//	ready!

/*＃｛記録、セーブ｝＃するには＃｛"PlaySation2"、ピーエスツー｝＃専用
メモリーカードが必要なんだ！
*/

オタコン_002: {
Imposta adesso la MEMORY CARD
(PS2) nell'ingresso MEMORY CARD!
}
//	<<<ENGLISH(2)>>>
//	Set the MEMORY CARD
//	(PlayStation&@R2) in the
//	MEMORY CARD slot now!

/*＃｛ＭＥＭＯＲＹ、メモリー｝＃ ＃｛ＣＡＲＤ、カード｝＃差込口に
＃｛"PlaySation2"、ピーエスツー｝＃専用メモリーカードを
セットしてくれ！
*/
}//d


//・空き領域がない緊迫 h //e
resource TO_ＳＡＶＥ失敗空領域ない緊迫__i {
//ns
オタコン_000: {
Snake, non c'era abbastanza
memoria sulla MEMORY CARD (PS2)!
}
//	<<<ENGLISH>>>
//	Snake, there wasn't enough
//	space left on the MEMORY CARD
//	(PlayStation&@R2)!
//<ページ数変更>
オタコン_000_1: {
Non ho potuto salvare il gioco!
}
//	<<<ENGLISH>>>
//	I couldn't save the game!

/*うーん。スネーク、＃｛"PlaySation2"、ピーエスツー｝＃専用
メモリーカードに空き領域がなくて
＃｛記録、セーブ｝＃出来なかった！
*/

}//d


//・フォーマットしようとしない緊迫  h //e
resource TO_ＳＡＶＥ失敗フォーマットしようとしない緊迫__i {
//ns
オタコン_000: {
Senti, non c'&`e modo di salvare se
non formatti la MEMORY CARD (PS2)!
}
//	<<<ENGLISH>>>
//	Look, there's no way to save
//	unless you format the MEMORY
//	CARD (PlayStation&@R2)!

/*フォーマットしないと＃｛記録、セーブ｝＃は
出来ないんだ！
*/

}//d


//・その他エラー  h //e
resource TO_ＳＡＶＥ失敗その他エラー緊迫__i {
//ns
オタコン_000: {
Snake, c'&`e stato un errore e non ho
potuto salvare!
}
//	<<<ENGLISH>>>
//	Snake, there was an error
//	and I couldn't save!

/*スネーク、エラーが起きて＃｛記録、セーブ｝＃
できなかった。
*/

}//d


//ＳＡＶＥ後会話 偽コトワザ  h//e
//・初めてのＳＡＶＥ後 h //e
resource TO_ＳＡＶＥ後初めて__i {
//ns
オタコン_000: {
Snake, conoscerai il detto 
"Tutti per uno e uno per tutti", 
vero?
}
//	<<<ENGLISH>>>
//	Snake, you of course know the
//	saying "One for all, all for one."

/*スネーク、『＃｛匹夫、ヒキオの＃｛勇、ゆう｝＃、一人に
敵するものなり』ってコトワザが
あるんだけど……。
*/

スネーク_001: {
Ma che c'entra, tutto d'un tratto?
}
//	<<<ENGLISH>>>
//	What is this, all of a sudden?

/*どうしたんだ、突然？*/

オタコン_002: {
Beh, pensavo che avresti avuto bisogno di
molta motivazione e sono venuto
preparato.
}
//	<<<ENGLISH>>>
//	Oh, I figured you'd need a lot of
//	motivation, so I came prepared.

/*いや、なんとなく寂しいだろうと
思って、準備してきたんだよ。
*/

オタコン_003: {
Il detto &`e tratto da "I tre moschettieri"... 
il libro, intendo.
}
//	<<<ENGLISH>>>
//	It's from 'The Three Musketeers'
//	-- the book, not the candy bar.

/*ヒキオってのは中国の英雄だ。多分。
*/

オタコン_004: {
Comunque, significa che se ti batti da solo
contro tutti, anche loro si metteranno
insieme contro di te. Almeno penso.
}
//	<<<ENGLISH>>>
//	Anyway, it means that if you go
//	up against everyone by yourself,
//	they'll gang up on you too. I think. 

/*ま、どんなに強くっても一度に
相手出来るのは一人がせいぜいって
ことだね。
*/
/*要するに大勢を一度に敵に回しちゃ
勝ち目がないって意味だ
*/

オタコン_005: {
Visto che sei da solo su quella nave, devi
tenere ben presente questo fatto ed evitare
gli scontri diretti.
}
//	<<<ENGLISH>>>
//	Since you're on your own on that
//	ship, you need to take this to heart
//	and avoid confrontations.

/*スネークは一人で潜入してるんだから、
多数の敵をまともに相手しちゃダメだ。
見つからないようにね。
*/

//<ページ数変更>
/* 包含
オタコン_006: {
スネークは一人で潜入してるんだから、
多数の敵をまともに相手しちゃダメだ。
見つからないようにね。
}
*/

オタコン_007: {
Che te ne pare? Proprio come ai 
vecchi tempi, eh?
}
//	<<<ENGLISH>>>
//	How was that? Just
//	like the old days, huh?

/*っと、こんな感じ。
どうだい、懐かしいだろう？
*/

スネーク_008: {
Mi ricorda un po' Mei Ling, ma... 
Sei davvero sicuro?
}
//	<<<ENGLISH>>>
//	Almost reminds me of Mei Ling,
//	but... You sure you got it right?

/*懐かしいことは懐かしいが……。
何か違わないか？
*/

オタコン_009: {
Certo che s&`i! E te ne insegner&`o
tanti altri di detti, ci puoi contare.
}
//	<<<ENGLISH>>>
//	Of course! And I'll teach you
//	a lot more of these, you can
//	count on it.

/*そんなことはないよ！これからも色々な
コトワザを教えてあげるからね。
*/

スネーク_010: {
Oh, che bello...
}
//	<<<ENGLISH>>>
//	Great...

/*うぅむ……。*/

}//d


//・ＳＡＶＥ後会話 h //e
resource TO_ＳＡＶＥ後序盤１__i {
//ns
オタコン_000: {
Okay... C'&`e un detto che fa
}
//	<<<ENGLISH>>>
//	Okay...
//	There's a saying that goes＃－
//<ページ数変更>
オタコン_000_1: {
'Sia l'uccellino in cielo che il pesce
nel mare non devono strafare'.
}
//	<<<ENGLISH>>>
//	"Even a bird on high dies
//	a glutton's death, as do
//	the fish of The Deeps."

/*ええと『＃｛高飛、こうひ｝＃の＃｛鳥、とり｝＃も＃｛美食、びしょく｝＃に死す。
＃｛深泉、しんせん｝＃の＃｛魚、うお｝＃も＃｛芳餌、ほうじ｝＃に死す』って
コトワザ知ってるかい？。
*/

オタコン_001: {
La morale &`e... ecco,
non essere avido.
}
//	<<<ENGLISH>>>
//	The lesson is -- er,
//	don't be greedy.

/*意味は……欲をかき過ぎるなって
ことだ。
*/

オタコン_002: {
Il pesce &`e morto perch&'e si &`e
ingozzato di cibo,
}
//	<<<ENGLISH>>>
//	The fish that belonged to a
//	family called the Deeps died
//	from overfeeding,
//<ページ数変更>
オタコン_002_1: {
ma anche l'uccellino, probabilmente
avr&`a mangiato frutta fermentata.
}
//	<<<ENGLISH>>>
//	and so did a bird that got high on
//	something -- probably fermented
//	fruit.

/*高飛という所に住んでいた鳥は
食べ過ぎて死んじゃったし、深泉地方の
魚も食べ過ぎて死んだ、と。
*/

スネーク_003: {
... okay, se lo dici tu.
}
//	<<<ENGLISH>>>
//	...okay. If you say so.

/*……そうなのか？*/

オタコン_004: {
Credimi, Snake. Non correre rischi
superflui solo perch&'e vuoi
arraffare pi&`u oggetti.
}
//	<<<ENGLISH>>>
//	I do, Snake. Don't take unnecessary
//	risks just because you're greedy
//	for more Items.
//<ページ数変更>
オタコン_004_1: {
Ricordati la fine che ha fatto quel pesce!
}
//	<<<ENGLISH>>>
//	Remember the Deep family's fish.

/*そうさ。スネークもアイテムを取ろうと
欲張ってケガしちゃダメだよ。
*/

スネーク_005: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
}//d


resource TO_ＳＡＶＥ後序盤２__i {
//ns
オタコン_000: {
C'&`e un altro proverbio cinese che dice:
}
//	<<<ENGLISH>>>
//	Another Chinese proverb:
//<ページ数変更>
オタコン_000_1: {
'I timorosi di Dio prosperano, quelli
che lo ignorano muoiono'. Lo conosci?
}
//	<<<ENGLISH>>>
//	"Those who look to the Heavens
//	prosper, those who defy it are no
//	more." Do you know this one?

/*中国には『天に＃｛順、したが｝＃う者は＃「存、そん｝＃し、天に
逆らう者は亡ぶ』っていうコトワザが
あるんだ。知ってる？
*/

オタコン_001: {
La morale qui &`e... un attimo solo...
}
//	<<<ENGLISH>>>
//	The meaning here is
//	-- hold on a sec --
//<ページ数変更>
オタコン_001_1: {
che puoi sopravvivere solo
se fai parte dell'ordine
naturale delle cose.
}
//	<<<ENGLISH>>>
//	that you can only survive as
//	long as you're a part of the
//	natural order of things.

/*意味は、うーんと……自然の道理に
従っている者は存在出来るけど、逆らう
者は滅亡してしまう、ってことだ。
*/

オタコン_002: {
Te li ricordi i jeans che si vendevano
gi&`a strappati?
}
//	<<<ENGLISH>>>
//	You remember pre-ripped jeans?

/*テンっていうのはイタチ科の動物だ。
イタチによく似てるけど少し大型で、
足が短い。
*/

オタコン_003: {
I produttori credevano che solo 
perch&'e alla gente piacevano i
jeans vecchi e comodi,
}
//	<<<ENGLISH>>>
//	Manufacturers thought that
//	just because people loved
//	old, broken-in jeans,

/*とても素早くて木登りもうまいんだ。
主に小型の哺乳類や小鳥なんかを
食べる。
*/

オタコン_004: {
li avrebbero voluti comprare cos&`i.
Allora fecero apposta a...
}
//	<<<ENGLISH>>>
//	they would want to buy new
//	jeans that looked old. So they
//	purposefully --

/*毛皮はとても珍重されていて……。
*/

スネーク_005: {
Ma che c'entrano i jeans con la natura e
l'ordine delle cose?
}
//	<<<ENGLISH>>>
//	What do jeans have to do
//	with nature and order?

/*テンと自然の道理に関係があるのか？
*/

オタコン_006: {
Il denim dovrebbe sfrangiarsi e strapparsi
da solo, in modo naturale, giusto?
}
//	<<<ENGLISH>>>
//	Denim should fray and rip on
//	its own, naturally. Right?
//<ページ数変更>
オタコン_006_1: {
Alcuni stilisti hanno cercato di forzare la
natura e... nessuno ha comprato i loro
jeans!
}
//	<<<ENGLISH>>>
//	Some designers tried to go against
//	that, and  -- no one bought them!
//<ページ数変更>
オタコン_006_2: {
Basta guardare i loro guadagni
in quell'anno fiscale!
}
//	<<<ENGLISH>>>
//	The earnings report from that
//	fiscal year is enough of a proof!

/*うーん。それだけテンは恐れ
敬われてたってことだ。
*/

スネーク_007: {
Guadagni...?
}
//	<<<ENGLISH>>>
//	Earnings...?

/*テンが、か……？*/

/* 英語はここまで
オタコン_008: {
そうだよ。多分。
}
スネーク_009: {
……。
}
*/

}//d


resource TO_ＳＡＶＥ後序盤３__i {
//ns
オタコン_000: {
Ehi, Snake, lo sai il detto 
"Chi ce la mette tutta pu&`o perdere tutto"?
}
//	<<<ENGLISH>>>
//	Hey, Snake, what's "Hardest
//	won, most easily lost"?

/*いいかい、スネーク。中国では
『得難くして失い＃｛易、やす｝＃き者は、時なり』
って言うことがあるんだ。
*/

オタコン_001: {
Vuol dire che &`e ora, capisci? &`E
incredibile quanto siano ancora validi
questi proverbi cinesi.
}
//	<<<ENGLISH>>>
//	It's time, get it? Amazing
//	how relevant these Chinese
//	proverbs still are!
//<ページ数変更>
オタコン_001_1: {
Se ti fai sfuggire l'attimo, 
non ritorna pi&`u!
}
//	<<<ENGLISH>>>
//	Once the moment's
//	gone, it's gone.

/*意味は……時間は大切にってことだ。
*/

オタコン_002: {
Beh, ma non nel caso dell'ora legale,
certo.
}
//	<<<ENGLISH>>>
//	Except for daylight savings
//	time, of course.
//<ページ数変更>
オタコン_002_1: {
Quell'ora in pi&`u che ti permette
di fare ci&`o che vuoi ogni autunno...
Che bello.
}
//	<<<ENGLISH>>>
//	That extra hour to do anything
//	you like with every autumn...
//	gotta love it.

/*トキは学名ニッポニア・ニッポン。
絶滅の危機に瀕してる日本の
天然記念物だよ。
*/

オタコン_003: {
Per&`o, d'altra parte perdi un'ora ogni
primavera, quindi forse i proverbi
dicono la verit&`a.
}
//	<<<ENGLISH>>>
//	Then again, you lose an hour every
//	spring, so I guess the proverbs are
//	right.
//<ページ数変更>
オタコン_003_1: {
Uau, pensavano a tutto, i cinesi.
}
//	<<<ENGLISH>>>
//	Wow, they thought of everything.

/*全長は約７５センチ。トキ色を帯びた
白色の羽をしてて、顔も脚も赤い。
でも繁殖期には羽の色が濃い灰色に……。
*/

スネーク_004: {
Vuoi dire avevano gi&`a l'ora legale?
}
//	<<<ENGLISH>>>
//	Did they even have daylight
//	savings back then? 

/*なぜ日本のトキが中国のコトワザに
出てくるんだ？
*/

オタコン_005: {
Ma no! Per&`o sapevano come risparmiare
tempo. Siamo noi che abbiamo bisogno
delle leggi per farlo.
}
//	<<<ENGLISH>>>
//	Of course not! They knew how
//	to save time. We're the ones
//	that need to be tricked into it.

/*自然の貴さに国境はないよ！
*/

スネーク_006: {
Ma non avevi detto che...
}
//	<<<ENGLISH>>>
//	But you said --

/*いや、それはそうかもしれないが……。*/

オタコン_007: {
L'attimo fuggente non torna mai, Snake.
Non sprechiamolo con domande inutili.
}
//	<<<ENGLISH>>>
//	The moment never returns,
//	Snake. Let's not waste it on
//	idle questions.

/*失われた自然は決して戻らないから
大切にしようってことだよ。多分。
*/

スネーク_008: {
Okay...?
}
//	<<<ENGLISH(2)>>>
//	Okay...?

/*……？*/
}//d


resource TO_ＳＡＶＥ後序盤４__i {
//ns
オタコン_000: {
C'&`e un detto cinese che fa
}
//	<<<ENGLISH>>>
//	The Chinese have a saying:
//<ページ数変更>
オタコン_000_1: {
'Chi si perde non dubita mai del
sentiero e chi sta per affogare
non dubita della sabbia'.
}
//	<<<ENGLISH>>>
//	"Those who are lost never question
//	a path, and a drowning man doubts
//	not the shallows."

/*中国では『迷う者は＃｛路、みち｝＃を問わず、
溺るる者は＃｛遂、あさせ｝＃を問わず』って言うんだ。
*/

オタコン_001: {
Che vuol dire... significa che devi fare
affidamento sugli altri. Accettare il loro
aiuto, altrimenti finisci nei guai.
}
//	<<<ENGLISH>>>
//	And it means -- means that you need
//	to make use of other people's help.
//	Otherwise, you could be in trouble.

/*意味は……ええと、他人に意見を
求めないと失敗するってことだ。
*/

オタコン_002: {
Se ti perdi, non sai neppure se la strada
che ti si para davanti sia quella giusta e,
ecco...,
}
//	<<<ENGLISH>>>
//	If you're lost, you don't even know
//	whether a road you come across is
//	a right one, and, uh,
//<ページ数変更>
オタコン_002_1: {
che differenza c'&`e fra l'acqua bassa
e l'acqua profonda se sei gi&`a affogato....
dico bene?
}
//	<<<ENGLISH>>>
//	what's the difference between
//	shallow and deep if you've already
//	drowned... right?

/*道に迷っちゃう人はどんな道でも
迷うし、溺れちゃう人はどんな浅瀬でも
溺れちゃうから……。
*/

オタコン_003: {
Ad ogni modo, la cosa da non dimenticare
&`e che &`e sempre bene accettare un
aiuto. Quindi fai buon uso del Codec.
}
//	<<<ENGLISH>>>
//	Anyway, the point is that help is
//	always a good thing to accept.
//	So make good use of the Codec.

/*まあ人の助けを借りるべきだってこと
じゃないかな、多分。無線は有効に
使ってくれよ。
*/

スネーク_004: {
Senti... a me non sembra proprio quello
che diceva Mei Ling, sai?
}
//	<<<ENGLISH>>>
//	Look -- this stuff seems nothing
//	like what Mei Ling used to talk
//	about.

/*なあ、メイ・リンから聞いたこととは
違うような気がするんだが……。
*/

オタコン_005: {
Ma che dici, lei non avrebbe saputo
fare di meglio!
}
//	<<<ENGLISH>>>
//	Hey, she couldn't do
//	better herself!

/*そんなことないよ！
*/

スネーク_006: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
}//d


resource TO_ＳＡＶＥ後序盤５__i {
//ns
オタコン_000: {
I conoscenti convengono, gli amici litigano.
}
//	<<<ENGLISH>>>
//	"Acquaintances agree.
//	Friends argue."


/*『泣いて馬食を切る』
*/

オタコン_001: {
Questo proverbio &`e facile da capire;
}
//	<<<ENGLISH>>>
//	That's a straightforward one.
//<ページ数変更>
オタコン_001_1: {
pi&`u amico sei di una persona e
pi&`u apertamente puoi dirti in
disaccordo con lei.
}
//	<<<ENGLISH>>>
//	The better friends you are,
//	the more openly you can
//	disagree with each other.

/*意味はええと、仲の良い相手でも
規律のためには処分しなきゃいけない
ってことだ。
*/

オタコン_002: {
Quindi se non sei d'accordo con qualcosa
che dico, controbatti pure. Anzi,
litighiamo pure!
}
//	<<<ENGLISH>>>
//	So feel free to present a
//	counterpoint if you don't agree
//	with what I'm saying. Argue away!

/*だから……まあ、きっと馬の肉を食べる
のは禁止になってたんだろうね。
*/

スネーク_003: {
Va bene, s&`i.
}
//	<<<ENGLISH>>>
//	Sure. All right.

/*馬の肉が？*/

オタコン_004: {
... Non &`e un inizio promettente. Okay,
dimentica quello che ho detto. Segui
i miei consigli e basta.
}
//	<<<ENGLISH>>>
//	...Not a promising start. OK,
//	forget what I said -- just go
//	along with my advice.

/*そうさ。いくら友達でも作戦は作戦だ。
スネークも僕の指示は守ってくれよ。
*/
}//d


resource TO_ＳＡＶＥ後序盤６__i {
//ns
オタコン_000: {
Conosci il detto che fa 
"Ferita guarita, tutto dimenticato"?
}
//	<<<ENGLISH(2)>>>
//	Do you know the saying
//	"One forgets the hurt once
//	the wound has healed"?

/*『傷口が癒えると痛みを忘れる』
ってコトワザ知ってるかい？
*/

オタコン_001: {
Che ovviamente significa
...ehm..
}
//	<<<ENGLISH>>>
//	And that of course means
//	-- uh --
//<ページ数変更>
オタコン_001_1: {
dove ho messo quel foglietto
di carta...
}
//	<<<ENGLISH>>>
//	where'd I put that
//	piece of paper --

/*意味は……ええと……あれ？
メモがどっかに……。
*/

スネーク_002: {
Scusa, dicevi?
}
//	<<<ENGLISH>>>
//	Did you say something?

/*何か言ったか？*/

オタコン_003: {
No, niente. Quindi, ehm, ferita guarita
significa che anche il dolore va.... Ehm...
}
//	<<<ENGLISH>>>
//	No, nothing. So, uh, forgetting
//	the pain when the wound's healed
//	means... Um --

/*いや、なんでもない。傷は治れば
もう痛くない、と、いうことは……。
うーん。
*/

オタコン_004: {
Che devi rimetterti in sesto e in fretta!
Ecco, questo vuol dire. Quindi fatti una
scorta di razioni e bende.
}
//	<<<ENGLISH>>>
//	That you have to get better fast!
//	Yeah, that's it. So stock up on
//	those rations and bandages.

/*ケガは早く治そうって意味だろうね。
レーションや止血剤は大切に
してくれよ。
*/

スネーク_005: {
Vuol dire davvero questo?
}
//	<<<ENGLISH>>>
//	Is that really all it means?

/*本当にそんな意味なのか？*/

オタコン_006: {
Ehi, sono l'esperto qui.
}
//	<<<ENGLISH>>>
//	Hey, I'm the expert here.

/*もちろんさ！*/
}//d


resource TO_ＳＡＶＥ後序盤７__i {
//ns
オタコン_000: {
Snake, lo conosci questo detto? 
"La natura dell'uomo &`e malvagia e 
il suo intero essere falso".
}
//	<<<ENGLISH>>>
//	Snake, have you heard this one?
//	"Evil is human nature, and his
//	entire being, falseness."

/*スネーク、聞いたことあるかい？
『人の＃｛性、せい｝＃は悪、その全なるものは偽なり』
*/

オタコン_001: {
&`E il concetto del peccato
originale.
}
//	<<<ENGLISH>>>
//	The concept of so-called
//	Original Sin.
//<ページ数変更>
オタコン_001_1: {
L'idea insomma che si nasce gi&`a
cattivi e quindi si possono solo
compiere cattiverie su cattiverie...
}
//	<<<ENGLISH>>>
//	The idea that you're born bad, so
//	you can't help doing bad things...

/*いわゆる性悪説だね。人間の本性は
悪だから悪いことしても仕方ないって
言う……。
*/

スネーク_002: {
Ma scusa! Io pensavo che l'idea a monte
del peccato originale fosse che, visto
che si nasce cattivi,
}
//	<<<ENGLISH>>>
//	Hold on. I thought the idea of
//	Original Sin was that you had
//	to work even harder
//<ページ数変更>
スネーク_002_1: {
ci si deve sforzare di pi&`u per fare
del bene!
}
//	<<<ENGLISH>>>
//	at being good because
//	you were born evil!

/*待て。性悪説というのは、人間の本性は
悪だからこそ学問や礼儀を修めなければ
いけないという考え方じゃなかったか？
*/

オタコン_003: {
Eh? Ah gi&`a, anche questo &`e vero. Bravo,
Snake.
}
//	<<<ENGLISH>>>
//	Er -- oh yeah, that too.
//	Very good, Snake.

/*え？ま、まあ、そうとも言うね。
*/

スネーク_004: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
}//d


resource TO_ＳＡＶＥ後序盤８__i {
//ns
オタコン_000: {
La conosci la leggenda di Achille e
Paride?
}
//	<<<ENGLISH>>>
//	You know the story about
//	Achilles and Paris?

/*『＃｛好死、こうし｝＃は＃｛悪活、あっかつ｝＃に＃｛如、し｝＃かず』ってコトワザ聞いたことあるかい？
*/

オタコン_001: {
La sua morale &`e che... cio&`e... non
c'entrava mica un tallone?
}
//	<<<ENGLISH>>>
//	The moral here is -- er --
//	something about his heel?

/*意味は……うーん……。
*/

オタコン_002: {
Comunque, dicevo, anche il grandissimo
eroe Achille, quasi i un immortale, alla
fine &`e stato ucciso da Paride.
}
//	<<<ENGLISH>>>
//	Anyway, even the great and
//	virtually immortal hero Achilles
//	was finally done in by Paris.
//<ページ数変更>
オタコン_002_1: {
Si parla di una citta pericolosa.
}
//	<<<ENGLISH>>>
//	Talk about a dangerous city.

/*あの偉大な孔子もアッカツには
及ばない。つまり上には上がいる
ってことだ。
*/

オタコン_003: {
Quindi non dare niente per scontato. Le
sorti possono ribaltarsi e ti ritrovi nei guai.
}
//	<<<ENGLISH>>>
//	So don't get complacent.
//	The mission can turn around
//	and get you.

/*ゲームに馴れても過信しちゃ
いけないよ。いいね。
*/

スネーク_004: {
Paride? Non era una persona?
}
//	<<<ENGLISH>>>
//	Wasn't Paris a person?

/*……アッカツとは誰だ？*/

オタコン_005: {
Come?
}
//	<<<ENGLISH(2)>>>
//	What?

/*なんだって！？*/

スネーク_006: {
Paride. Pensavo che fosse un...
}
//	<<<ENGLISH>>>
//	Paris. I thought he was a --

/*アッカツとは……？*/

オタコン_007: {
Snake, c'&`e un momento per tutte le cose e
ora non &`e il caso di perdere tempo coi
complotti.
}
//	<<<ENGLISH>>>
//	Snake, there's a time and place
//	for conspiracy theories.
//<ページ数変更>
オタコン_007_1: {
Sto cercando di concentrarmi!
}
//	<<<ENGLISH>>>
//	Please, I'm trying to
//	concentrate here.

/*スネーク……。つまんないこと
聞かないでくれよ。興ざめだ。全く！
*/

スネーク_008: {
Eh? Ah, scusa...
}
//	<<<ENGLISH>>>
//	Huh? Ah, sorry...?

/*え？ああ……？……すまない……？？*/
}//d


resource TO_ＳＡＶＥ後中盤１__i {
//ns
オタコン_000: {
Conosci il detto "Chi cammina per cento
leghe non sa di aver fatto
}
//	<<<ENGLISH(2)>>>
//	Do you know the saying
//	"Those who walk a hundred
//	leagues think not that＃－
//<ページ数変更>
オタコン_000_1: {
pi&`u di met&`a strada prima della novantesima
lega"?
}
//	<<<ENGLISH>>>
//	their journey is half ended
//	until the ninetieth league"?

/*『百里を行く者は＃｛九十、きゅうじゅう｝＃を＃｛半、なか｝＃ばとす』
っていうコトワザ知ってるかい？
*/

オタコン_001: {
Questo significa...
cosa significa...
}
//	<<<ENGLISH(2)>>>
//	That means...
//	-- what does it mean --

/*意味は……なんだろうな……。*/

オタコン_002: {
Ecco, s&`i. Significa che se pensi di fare
tutta quella strada,
}
//	<<<ENGLISH>>>
//	OK. It means that if you're
//	planning to walk that far,
//<ページ数変更>
オタコン_002_1: {
ti conviene sapere l'aritmetica. Studia! Vai
a scuola!
}
//	<<<ENGLISH>>>
//	you'd better damn well know
//	how to do simple arithmetic.
//	Study! Stay in school!

/*うん。百里も行こうというのに数が
勘定出来ないだと困るからちゃんと勉強
しといた方がいいってことだ。多分。
*/

スネーク_003: {
A me sembra che tu stia farneticando...
}
//	<<<ENGLISH>>>
//	This seems to be getting
//	more and more random.

/*だんだんいい加減になっていく気が
するんだが。
*/

オタコン_004: {
No, &`e che sta diventando tutto pi&`u
profondo. Fidati.
}
//	<<<ENGLISH>>>
//	Correction -- it's becoming
//	more deep. Trust me.

/*何言ってんだい。そんなこと
あるわけないじゃないか。
*/
}//d


resource TO_ＳＡＶＥ後中盤２__i {
//ns
オタコン_000: {
Okay. "Una rana in un pozzo non conosce
il grande oceano".
}
//	<<<ENGLISH(2)>>>
//	OK -- "A frog in a well knows
//	not of the great ocean."

/*えーと……『＃｛好漢、こうかん｝＃は＃｛当年、とうねん｝＃の＃｛勇、ゆう｝＃を語らず』
*/

オタコン_001: {
Ehi, questa proprio non mi piace.
}
//	<<<ENGLISH>>>
//	Hey, I don't like this one at all.
//<ページ数変更>
オタコン_001_1: {
Intrappolare una povera rana in un pozzo?
&`E crudelt&`a!
}
//	<<<ENGLISH>>>
//	Trapping a little frog in a well?
//	That sucks, that's really cruel.

/*これはいけないね。人として絶対に
しちゃいけない最悪の犯罪だ。
*/

オタコン_002: {
Certo che non conosce l'oceano,
poverina, anzi morir&`a in fretta
}
//	<<<ENGLISH>>>
//	Of course it's not going to
//	see the big blue sea＃－
//<ページ数変更>
オタコン_002_1: {
per la mancanza di luce.
}
//	<<<ENGLISH>>>
//	the lack of sunlight alone
//	will kill it pretty quick.

/*刑罰も当然、殺人や放火と同じくらい
重くなってる。
*/

オタコン_003: {
Certo, se chiudi qualcuno a chiave, gli
impedisci di vedere quello che vuoi
tenergli nascosto.
}
//	<<<ENGLISH>>>
//	Sure, locking someone up is a good
//	way to make sure they don't see
//	what you don't want them to.
//<ページ数変更>
オタコン_003_1: {
Ma questo detto &`e terribile e non
mi piace per niente. Poverina, quella
rana...!
}
//	<<<ENGLISH>>>
//	But this is a terrible saying,
//	and I don't like it at all. Poor
//	little froggy...!

/*それを誇る奴なんて最低のクズだって
ことさ、全く！でも、なんでこんな
コトワザがあるんだろう……？
*/

スネーク_004: {
... Credo proprio che questa tu non l'abbia
capita.
}
//	<<<ENGLISH>>>
//	...I really think you've
//	got this one wrong.

/*……お前、勘違いしてないか？
*/
}//d


resource TO_ＳＡＶＥ後中盤３__i {
//ns
オタコン_000: {
C'&`e un proverbio cinese che dice: 
"I dotti apprezzano la conoscenza, 
non l'azione".
}
//	<<<ENGLISH>>>
//	The Chinese have a proverb
//	that goes "Scholars hold in
//	esteem knowledge, not acts."

/*中国では『学者はこれ之を知るをとうと貴び、
これ之を行うをとうと貴ばず』って言うことも
あるんだ。
*/

オタコン_001: {
Capisci, loro se ne stanno l&`i seduti a
riflettere, invece di fare cose concrete.
E non si pu&`o dire che servano a molto.
}
//	<<<ENGLISH>>>
//	See, they just sit around thinking,
//	instead of actually doing something.
//	Which doesn't make them too useful.
//<ページ数変更>
オタコン_001_1: {
&`E l'azione che conta! Almeno penso.
}
//	<<<ENGLISH>>>
//	Action is what matters! I think.

/*学者は知識ばかりを求めて行動しない
からダメだってことで……
……まあ、事をなすには行動が大事ってことだよ。多分。
*/

スネーク_002: {
Senti, invece Mei Ling diceva che...
}
//	<<<ENGLISH>>>
//	Look, what I heard from
//	Mei Ling was that --

/*やはりメイ・リンから聞いた時とは
違うと思うんだが……。
*/

オタコン_003: {
Snake, ti rendi conto che parli molto
di lei?
}
//	<<<ENGLISH>>>
//	Snake, have you noticed that
//	you bring her up a lot?

/*なんだい、スネーク、そんなに
メイ・リンのことが気になるのかい？
*/

スネーク_004: {
Eh? Ma scusa, non &`e...
}
//	<<<ENGLISH>>>
//	Huh? That isn't the --

/*いや、そういうことではなくて……。*/

オタコン_005: {
Ci risiamo. Cosa mai potr&`o fare di te?
}
//	<<<ENGLISH>>>
//	Here we go again.
//	What am I going to
//	do with you?

/*また、また。
ホント、困ったもんだよ、君には。
*/

スネーク_006: {
Come stavo dicendo...
}
//	<<<ENGLISH>>>
//	Like I was saying --

/*だから……。*/

オタコン_007: {
Tu e la tua libido iperattiva. Ma almeno
uno di noi due riesce a ragionare a mente
fredda, qui.
}
//	<<<ENGLISH>>>
//	You and your hyperactive libido.
//	It's a good thing one of us can
//	keep all the details straight.

/*やれやれ。オイタもいい加減に
しとかないと、また大変なことに
なるよ？
*/

スネーク_008: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
}//d


resource TO_ＳＡＶＥ後中盤４__i {
//ns
オタコン_000: {
Questo &`e il mio detto cinese preferito:
'Meglio essere il primo fra i galli che
l'ultimo fra i tori'.
}
//	<<<ENGLISH>>>
//	This is my favorite Chinese saying:
//	"Better to be first among roosters
//	than last among bulls."

/*『＃｛鶏口、けいこう｝＃となるも＃｛牛後、ぎゅうご｝＃となるなかれ』って
中国のコトワザ、知ってるかい？
*/

オタコン_001: {
Il significato &`e ovvio, mi pare:
}
//	<<<ENGLISH>>>
//	Of course, the meaning's clear:
//<ページ数変更>
オタコン_001_1: {
se devi scegliere fra essere un 
pollo o una mucca,
}
//	<<<ENGLISH>>>
//	If you have to choose between
//	being a chicken or a cow, pick
//	the chicken.
//<ページ数変更>
オタコン_001_2: {
scegli il pollo! Le mucche vengono sempre
rapite dagli alieni e come sai le mutilazioni
di bovini sono in aumento.
}
//	<<<ENGLISH>>>
//	Cows are always being messed with
//	by aliens -- cattle mutilations are
//	up, you know.

/*牛よりも＃｛鶏、にわとり｝＃になる方がいい。牛は
宇宙人に血を抜かれたりするからね。
*/

オタコン_002: {
Perch&'e cercarsi pi&`u guai?
}
//	<<<ENGLISH>>>
//	Why go looking for trouble, right?

/*余計な厄介事はしょい込むなってことだ。*/

オタコン_003: {
Se un nemico ti vede, ti troverai in pi&`u guai
di una mucca a bordo di un UFO. Stattene
alla larga!
}
//	<<<ENGLISH>>>
//	If an enemy spots you, you'll be in
//	more trouble than a cow on a UFO.
//	You stay out of their sight!

/*敵に発見されたら厄介なことになる。
絶対、見つからないようにしてくれよ。
*/

スネーク_004: {
Ma perch&'e mai in un proverbio cinese ci
sono gli alieni?
}
//	<<<ENGLISH>>>
//	Why would aliens be in
//	an old Chinese proverb?

/*宇宙人が昔の中国に行ったとは
思えないんだが……？
*/

オタコン_005: {
Tutti sanno che visitano il nostro pianeta
da migliaia di anni ormai.
}
//	<<<ENGLISH>>>
//	Everyone knows they've been
//	visiting us for thousands of
//	years.

/*宇宙人は国になんかこだわらないよ！
*/

スネーク_006: {
...questa mi &`e nuova.
}
//	<<<ENGLISH>>>
//	...news to me.

/*……？*/
}//d


//・メイ・リン登場 h //e
resource TO_ＳＡＶＥ後メイ・リン登場__i {
//ns
オタコン_000: {
Snake, conosci il proverbio cinese 
"Pi&`u attento sei e meglio &`e?
}
//	<<<ENGLISH>>>
//	Snake, do you know
//	the Chinese proverb
//	"Care avoids err"?

/*スネーク、『＃｛小心、しょうしん｝＃に＃｛大過、たいか｝＃なし』って
中国のコトワザ知ってるかい？
*/

オタコン_001: {
Sapevi che "&`e" probabilmente viene dalla
lingua Kung e significa "cosa"?
}
//	<<<ENGLISH>>>
//	"Err" is thought to be a
//	！Kung word meaning "what."


/*『タイカ』はイヌイットの言葉で
『あれ』って意味だ。
*/

オタコン_002: {
A detta di alcuni linguisti questo &`e il motivo
per cui quasi tutte le lingue del mondo
esprimono l'incertezza dicendo
}
//	<<<ENGLISH>>>
//	There are some linguists who
//	think that this accounts for an
//	almost universal utterance＃－
//<ページ数変更>
オタコン_002_1: {
qualcosa come "ehm". Insomma, delle
vestigia...
}
//	<<<ENGLISH>>>
//	of the syllable "er" when people
//	are at a loss for words. A kind
//	of vestigial --

/*『あれはなんだ？』って聞く時は
『キスーリ タイカ？』って言うよね。
つまり……。
*/

メイ・リン_003: {
Ehi!
}
//	<<<ENGLISH(2)>>>
//	Hey!

/*ちょっと！*/

オタコン_004: {
Acc!
}
//	<<<ENGLISH(2)>>>
//	Ack!

/*わぁ！*/

メイ・リン_005: {
Che brocco! Che ne hai fatto di quel
foglietto di istruzioni che ti avevo
dato?
}
//	<<<ENGLISH>>>
//	What a crock! What did you
//	do with that little cheat sheet
//	I made you!

/*デタラメばっかり言って！
私が作ってあげたメモはどうしたの？
*/

オタコン_006: {
Ehm...
}
//	<<<ENGLISH(2)>>>
//	Er --

/*いや……。*/

メイ・リン_007: {
Ah, eccolo... Ehi!
}
//	<<<ENGLISH(2)>>>
//	Oh, there it is -- Hey!

/*あ、そんなとこに……ええっ！？*/

オタコン_008: {
Ehm, veramente &`e un...
}
//	<<<ENGLISH>>>
//	Er, that's really a...

/*あの、それは……。*/

メイ・リン_009: {
Come hai potuto fare una cosa del
genere! Sai quanto sono presa,
eppure...!!
}
//	<<<ENGLISH>>>
//	How could you do that!
//	You know how busy I am
//	and you -- !!

/*ヒドイ！！どうしてそんなこと
出来るのよ！？もう、サイテー！！！
*/

オタコン_010: {
Non &`e quello che pensi...
}
//	<<<ENGLISH>>>
//	It's not what you think...

/*いや違うんだ……。*/

メイ・リン_011: {
Ah no? Allora a cosa penso?
}
//	<<<ENGLISH>>>
//	Oh, so what am I thinking?

/*何がどう違うってのよ！！*/

スネーク_012: {
Ma che succede l&`a?
}
//	<<<ENGLISH>>>
//	What's going on over there?

/*どうしたんだ？*/

メイ・リン_013: {
Oh, ciao, Snake. Ma lo sai che
Otacon ha...
}
//	<<<ENGLISH>>>
//	Oh, hi, Snake.
//	Do you know that
//	Otacon's been --

/*聞いてよ、スネーク！
オタコンったら……。
*/

オタコン_014: {
Ehm, Mei Ling, siamo nel mezzo di una
missione, se non ti spiace! Quindi
potremmo, come dire...
}
//	<<<ENGLISH>>>
//	Er, Mei Ling, we're in the middle
//	of a mission and everything!
//	So can we, you know...

/*メイ・リン！
ほら、あの、今作戦中だしさ、ね。
*/

メイ・リン_015: {
...
}
//	<<<ENGLISH>>>
//	...

/*……。*/

オタコン_016: {
...
}
//	<<<ENGLISH>>>
//	...

/*……。*/

メイ・リン_017: {
S&`i, d'accordo.
}
//	<<<ENGLISH>>>
//	Fine. Sure.

/*……わかった。*/

メイ・リン_018: {
E Snake, il vero significato del proverbio
'Pi&`u attento sei e meglio &`e',
}
//	<<<ENGLISH>>>
//	And Snake, the real meaning
//	of "Care avoids err"
//<ページ数変更>
メイ・リン_018_1: {
&`e che se uno &`e cauto, pu&`o evitare di
commettere gravi errori.
}
//	<<<ENGLISH>>>
//	is that if you're cautious,
//	you can avoid making
//	serious mistakes.

/*いい、スネーク、『小心に大過なし』の
本当の意味は、慎重にやれば大きな
間違いをすることはないって意味よ。
*/

メイ・リン_019: {
Quindi anche se ti sei abituato alla
missione, attento a quel che fai.
Buona fortuna!
}
//	<<<ENGLISH>>>
//	Even if you've gotten used
//	to the mission, watch what
//	you do. Good luck!

/*ゲームに馴れてきても、慎重さは
忘れないでってこと。がんばってね！
*/

オタコン_020: {
Giusto, Snake! Buona fortuna!
}
//	<<<ENGLISH>>>
//	Yeah, Snake! Good luck!

/*うん、がんばって！*/

メイ・リン_021: {
Con te non ho ancora finito.
}
//	<<<ENGLISH>>>
//	You, I'm not done with.

/*さ、オタコン……。*/

オタコン_022: {
Acc...
}
//	<<<ENGLISH(2)>>>
//	Ack...

/*う！*/

メイ・リン_023: {
Parliamone, che dici?
}
//	<<<ENGLISH>>>
//	Let's discuss this, shall we?

/*話し合いましょうか。みっちりと。*/

オタコン_024: {
...
}
//	<<<ENGLISH>>>
//	Err...

/*……。*/

}//d

resource TO_ＳＡＶＥ後メイ・リン登場後__i {
//ns
スネーク_000: {
Che &`e successo a Mei Ling?
}
//	<<<ENGLISH>>>
//	What happened to Mei Ling?

/*メイ・リンはどうした？*/

オタコン_001: {
He he! Si &`e arrabbiata ed &`e andata offline.
}
//	<<<ENGLISH>>>
//	Hee. She got mad
//	and went offline.

/*あはは。怒って回線切られちゃった。*/

スネーク_002: {
Cosa hai combinato?
}
//	<<<ENGLISH>>>
//	What did you do?

/*お前、一体何をしたんだ？*/

オタコン_003: {
Niente! Non dobbiamo tornare alla nostra
missione? Abbiamo tantissimo da fare e il
tempo stringe...
}
//	<<<ENGLISH(2)>>>
//	Nothing! Now don't we need
//	to get back to the mission?
//	So much to do, so little time...

/*いや、何もしてないよ！
そんなことより作戦だ。ね？
*/

スネーク_004: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
}//d


