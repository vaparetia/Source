//###################################################################################
//							プレイヤー水面落下死亡カメラ
//###################################################################################

	proc プレイヤー水面落下死亡カメラ{

		trap dead100 d:PLAYER \
			-mask 入る \
			-exec{

				if($4 < -5000){
					eval($i:甲板落下カメラＸ差分１ = -3000)
					eval($i:甲板落下カメラＸ差分２ = -10000)

				}else if($4 > 5000){
					eval($i:甲板落下カメラＸ差分１ = 3000)
					eval($i:甲板落下カメラＸ差分２ = 10000)

				}else{
					eval($i:甲板落下カメラＸ差分１ = 0)
					eval($i:甲板落下カメラＸ差分２ = 0)
				}

				chara カメラ設定 パンカメラ \
					-c 1 \
					-p ($4 + $i:甲板落下カメラＸ差分１),3000,($6 + 5000) \
					-t $4,-1000,$6 \
					-a 200 \
					-i 3 -1 0 0 \
					-s 1

				chara delay ディレイ \
					-arg $4 $6 \
					-time 30 \
					-exec {

						@パンカメラプロック \
							($1 + $i:甲板落下カメラＸ差分１),3000,($2 + 5000) \
							$1,-1000,$2 \
							($1 + $i:甲板落下カメラＸ差分２),13000,($2 + 15000) \
							$1,-1000,$2 \
							200 \	//画角
							300 \	//持続フレーム数
							0

					}

			}

	}

//###################################################################################
//								甲板鏡面モデル設定
//###################################################################################

	proc 甲板鏡面モデル設定{
		print '甲板鏡面モデル設定'


		chara 鏡面モデル管理 床面映り込み \
			-pos 0,0,0 \
			-axis 1 // Y軸反転


		trap mr000 d:PLAYER \
			-mask ？ \
			-exec {
				if( $3 == 入る ){
					print '鏡像だす１'

					mesg プレイヤー d:PLAYER shadow 0
					mesg 鏡面モデル管理 床面映り込み add スネーク

				}else{
					print '鏡像けす１'
					mesg プレイヤー d:PLAYER shadow 1
					mesg 鏡面モデル管理 床面映り込み del スネーク

				}

			}

		trap mr000 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_ELUDE \	// エルード中
			-exec {
				if( $3 == 入る ){
					print '鏡像けす'
					mesg 鏡面モデル管理 床面映り込み del スネーク

				}else{
					print '鏡像だす'
					mesg 鏡面モデル管理 床面映り込み add スネーク

				}

			}


		trap mr000 敵兵:01 \
			-mask ＊ \
			-exec {

				if( $3 == いる ){

					@甲板敵兵映り込み判定 敵兵:01

					if($f:甲板敵兵映り込み範囲にいる == 1){

						if($f:甲板敵兵０１映り込みあり == 0){
							eval($f:甲板敵兵０１映り込みあり = 1)

							print '敵兵０１映り込み出し'
							mesg 鏡面モデル管理 床面映り込み add 敵兵:01
						}

					}else{
						if($f:甲板敵兵０１映り込みあり == 1){
							eval($f:甲板敵兵０１映り込みあり = 0)

							print '敵兵０１映り込み消し'
							mesg 鏡面モデル管理 床面映り込み del 敵兵:01
						}
					}

				}else if($3 == 出る){
					eval($f:甲板敵兵０１映り込みあり = 0)
					mesg 鏡面モデル管理 床面映り込み del 敵兵:01

				}

			}


		trap mr000 敵兵:02 \
			-mask ＊ \
			-exec {

				if( $3 == いる ){


					@甲板敵兵映り込み判定 敵兵:02

					if($f:甲板敵兵映り込み範囲にいる == 1){

						if($f:甲板敵兵０２映り込みあり == 0){
							eval($f:甲板敵兵０２映り込みあり = 1)

							print '敵兵０２映り込み出し'
							mesg 鏡面モデル管理 床面映り込み add 敵兵:02
						}

					}else{
						if($f:甲板敵兵０２映り込みあり == 1){
							eval($f:甲板敵兵０２映り込みあり = 0)

							print '敵兵０２映り込み消し'
							mesg 鏡面モデル管理 床面映り込み del 敵兵:02
						}
					}

				}else if($3 == 出る){
					eval($f:甲板敵兵０２映り込みあり = 0)
					mesg 鏡面モデル管理 床面映り込み del 敵兵:02

				}

			}


		trap mr000 敵兵:03 \
			-mask ＊ \
			-exec {

				if( $3 == いる ){

					@甲板敵兵映り込み判定 敵兵:03

					if($f:甲板敵兵映り込み範囲にいる == 1){

						if($f:甲板敵兵０３映り込みあり == 0){
							eval($f:甲板敵兵０３映り込みあり = 1)

							print '敵兵０３映り込み出し'
							mesg 鏡面モデル管理 床面映り込み add 敵兵:03
						}

					}else{
						if($f:甲板敵兵０３映り込みあり == 1){
							eval($f:甲板敵兵０３映り込みあり = 0)

							print '敵兵０３映り込み消し'
							mesg 鏡面モデル管理 床面映り込み del 敵兵:03
						}
					}

				}else if($3 == 出る){
					eval($f:甲板敵兵０３映り込みあり = 0)
					mesg 鏡面モデル管理 床面映り込み del 敵兵:03

				}

			}



		trap mr000 攻撃兵 \
			-mask ＊ \
			-exec {

				if( $3 == いる ){

					@甲板敵兵映り込み判定 攻撃兵

					if($f:甲板敵兵映り込み範囲にいる == 1){

						if($f:甲板攻撃兵映り込みあり == 0){
							eval($f:甲板攻撃兵映り込みあり = 1)

							print '攻撃兵映り込み出し'
							mesg 鏡面モデル管理 床面映り込み add 攻撃兵
						}

					}else{
						if($f:甲板攻撃兵映り込みあり == 1){
							eval($f:甲板攻撃兵映り込みあり = 0)

							print '攻撃兵映り込み消し'
							mesg 鏡面モデル管理 床面映り込み del 攻撃兵
						}
					}

				}else if($3 == 出る){
					eval($f:甲板攻撃兵映り込みあり = 0)
					mesg 鏡面モデル管理 床面映り込み del 攻撃兵

				}

			}




	}


	proc 甲板敵兵映り込み判定 $:敵兵名{

		eval($f:甲板敵兵映り込み範囲にいる = 0)

		//(Z - Z1)*(X2 - X1) = (X - X1)*(Z2 - Z1)を境界に範囲を算出

		command ゲット敵兵座標 \
			$:敵兵名 $i:Ｘ座標変数 $i:Ｙ座標変数 $i:Ｚ座標変数

		if( \
		( ($i:Ｚ座標変数 - (-20000))*(-13000 - (-19250)) < ($i:Ｘ座標変数 - (-19250))*(3750 - (-20000)) ) \
		&& ( ($i:Ｚ座標変数 - 3750)*(-5000 - (-13000)) < ($i:Ｘ座標変数 - (-13000))*(19750 - 3750) ) \
		){

			if( \
			( ($i:Ｚ座標変数 - (-20000))*(13000 - 19250) > ($i:Ｘ座標変数 - 19250)*(3750 - (-20000)) ) \
			&& ( ($i:Ｚ座標変数 - 3750)*(5000 - 13000) > ($i:Ｘ座標変数 - 13000)*(19750 - 3750) ) \

			&& ($i:Ｚ座標変数 < 19750) \
			){
				eval($f:甲板敵兵映り込み範囲にいる = 1)

			}

		}


	}


