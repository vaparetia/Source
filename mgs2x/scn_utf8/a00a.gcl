	proc ローカル変数初期化 {
		$$i:水密ドアフラグ = 0;

		$$f:エルード２Ｆ左入ってます = 0;
		$$f:エルード２Ｆ右入ってます = 0;
	}


//###################################################################################
//								デジカメセルゲイ用意
//###################################################################################

	proc デジカメセルゲイ用意 {
		print 'デジカメセルゲイ用意'

		command タンカーカメラ初期化 \
			-s celgei_snapshot \
			-f 1

		eval($w:タンカーデジカメ写真属性[5] = d:デジカメセルゲイ)



	}












//###################################################################################
//									エフェクト設定
//###################################################################################

	proc エフェクト設定 {
		print 'エフェクト設定'

		chara 落下水飛沫 splash_fall \
			-l -7000 6000 8000  7000 6000 8000 \
			-s 0 \
			-n 32 \
			-t 9

		chara 落下水飛沫 splash_fall \
			-l -4000 9000 6000  -2500 9000 6000 \
			-s 0 \
			-n 12 \
			-t 9

		chara 落下水飛沫 splash_fall \
			-l -1500 9000 6000  1500 9000 6000 \
			-s 0 \
			-n 12 \
			-t 9

		chara 落下水飛沫 splash_fall \
			-l  2500 9000 6000   4000 9000 6000 \
			-s 0 \
			-n 12 \
			-t 9

#if 0
		chara 落下水飛沫 splash_fall \
			-l -16000 3000 -6000  -15500 3000 -5000 \
			-s 0 \
			-n 8 \
			-t 9

		chara 落下水飛沫 splash_fall \
			-l -15500 3000 -5000  -13500 3000 -3000 \
			-s 0 \
			-n 8 \
			-t 9
		chara 落下水飛沫 splash_fall \
			-l -13500 3000 -3000  -12000 3000 -3000 \
			-s 0 \
			-n 8 \
			-t 9
#endif

		chara 床水飛沫 floor_splash \
			-b -5000 100 8000  5000 100 20000 \
			-n 20

		#if d:SCREENSHOT
			chara スクリーンショット scrshot
		#endif

		chara カメラ雨 カメラ雨 \
			-i 0	//水滴非表示

		chara 武器水飛沫 ddd

		chara フォグ fog \
			 -c 16 32 27 \
			 -n -1500 \
			 -f 24000

		chara ブラー okajibura

#if d:CUT_OFF
#else
		chara 煙突煙 smoke \
			-n 4 \
			-p	4000,25000,-1000 \
				4000,25000,-3000 \
				-4000,25000,-1000 \
				-4000,25000,-3000
#endif
		chara 新雷フラッシュ thanderflash

#if d:CUT_OFF
#else
		chara 天球 sphear
#endif
		chara 風制御 wind \
			-i 300 \
			-j 500 \
			-r -1024 1024 0 \
			-a 4 \
			-b 300 \
			-c 150

		chara 雨 rain \
			-n 16 \
			-c 90 \
			-b -17750 0 -20000 17750 3000 -3000 \
				-14000 6000 -16000 14000 10000 -13000 \
				-32000 -10000 -32000 32000 -2600 32000

#if d:CUT_OFF
#else
		chara 新空 cloud \
			-m w00_sky

		chara プットテクスチャ タンカー前部ボンボリ \
			-t light07_msk light07_msk light07_msk light07_msk light07_msk light07_msk light07_msk light07_msk \
			-p 	-17000, 3500,  -61000 \
				 17000, 3500,  -61000 \
				-17000, 3500, -121000 \
				 17000, 3500, -121000 \
				-17000, 3500, -181000 \
				 17000, 3500, -181000 \
				 -3500, 4000, -112100 \
				     0, 7000, -218000 \
			-r 0 0 0 0 0 0 0 0 \
			-c 	128 128 128 32 \
				128 128 128 32 \
				128 128 128 32 \
				128 128 128 32 \
				128 128 128 32 \
				128 128 128 32 \
				128 128 128 32 \
				128 128 128 32 \
			-s 	10000 10000 \
				10000 10000 \
				10000 10000 \
				10000 10000 \
				10000 10000 \
				10000 10000 \
				10000 10000 \
				10000 10000
#endif
		chara 霧雨 fograin

#if d:CUT_OFF
#else
		chara マンハッタン manhattern \
			-l w00a
		chara ブルックリン blucking \
			-l w00a
		chara マンハット黄灯 黄灯
		chara マンハット赤灯1 赤灯1
		chara マンハット赤灯2 赤灯2
		chara ブルックリン赤灯 赤灯
		chara ロープモデル２ クレーンワイヤー \
			-n w00a_ch1 \
			-x 10950 7970 6610 \
			-d 0
		chara ロープモデル２ クレーンワイヤー \
			-n w00a_ch1 \
			-x -10950 7970 6610 \
			-d 0
#endif

		chara モデル切り替えアニメ 窓雨 \
