	// アナザー用プロック マップ設定前に設定する
	@アナザー用マップ定義前設定					// a_mode.h

	chara マップ 甲板 -k w00a 0 0 0 -h a00a 0 -l w00a

/**************************************************************************************/
//	各マップのキャラ設定
/**************************************************************************************/
	command マップ設定 甲板 -set {
		@常駐キャラ設定							// stdch.h
		@ローカル変数初期化
		@A_プレイヤー設定 sna_a00a rai_a00a		// a_stdproc.h
	}

	// アナザー用プロック マップ設定後に設定する
	@アナザー用マップ定義後設定					// a_mode.h

	if($s:登場ポイント == タンカー編パッドデモスタート){
		/*
		command マップ設定 甲板 -set {
			@デジカメセルゲイ用意
			//@サウンドマネージャー設定
			//@常駐キャラ設定
			#if d:RADAR
				@レーダー設定
			#endif
			//@プレイヤー設定
			@スネーク水飛沫設定
			@船首モデル設定
			@カメラ設定
			@水密ドア設置
			@甲板カメラ設定
			#if d:MIRROR
				@甲板鏡面モデル設定
			#endif
			@甲板はりつき視点変更設定
			@サウンド設定
			@エフェクト設定
			@甲板ライト設置		//w00_common.hの中
			@甲板アイテム設定
			@甲板透明壁設定
			@甲板高波設定
			@甲板チェーン設置
			@処理落ち対処
			@パッドデモ準備
		}
		*/
	}else{
		command マップ設定 甲板 -set {
			//@サウンドマネージャー設定
			//@常駐キャラ設定
			#if d:RADAR
				@レーダー設定
			#endif
			//@プレイヤー設定
			@スネーク水飛沫設定
			@船首モデル設定
			@カメラ設定
			#if d:DROP_ENE
			@落下敵兵カメラ
			#endif
			@水密ドア設置
			@甲板カメラ設定
			@甲板ビヨンド設定
			#if d:MIRROR
				@甲板鏡面モデル設定
			#endif
			@甲板はりつき視点変更設定
			@プレイヤー水面落下死亡カメラ
			#if d:ENEMY_SET
				//@甲板敵兵セット
			#endif
			@甲板死体遺棄設定
			//@サウンド設定
			@エフェクト設定
			@甲板ライト設置		//w00_common.hの中
			//@甲板アイテム設定
			#if d:INSECT
				@電灯虫設定
			#endif
			@１ｍジャンプ設定
			@甲板透明壁設定
			@甲板高波設定
			@甲板チェーン設置
			@船橋ウイングオブジェ設定
			@メタル登場
			@処理落ち対処
			#if d:DEBUG
				@甲板デバッグプロック
			#endif
			//@タンカーデジカメ写真判定		//dcam_tanker.hの中にあります。
			//@タンカー編全体マップ設定 d:船尾甲板マップ
#if d:パッドデモ収録デバッグ
			@パッドデモ準備
#endif
			//@ポーズ時ステージ名表示設定 d:wn_船尾甲板

			#if d:MY_DEBUG
				@デバッグ設定
			#endif
		}

	}




//初期マップの表示
// -----------------------------------
command マップ表示 	-add 甲板


@甲板ロード進入時処理

//###################################################################################
//									ロード時進入設定
//###################################################################################


	proc 甲板ロード進入時処理{

		print '甲板ロード進入時設定'

		if($w:t_story == d:ST_T01a1D目的説明ポリゴンデモ終了){
			print '目的説明ポリゴンデモ終了'
			command パッド操作 -release

			chara フェードインアウト フェードイン \
			-i 0,0,0 128 \
			-c 0,0,0 0 \
			-t d:FADEIN_TIME

		}else if( $s:登場ポイント == 甲板左舷１Ｆ ){
			print '甲板左舷１Ｆ'
			@甲板いろいろ登場

			chara カメラ設定 ビヨンドカメラ \
				-c 1 \
				-p -11020,3899,-2710 \
				-t -8098,-233,-5785 \
				-a 200 \
				-i 0 2 0 0 \
				-s 1

			@ステージ開始時処理（ステージ名表示）\
				 d:LOAD_TYPE:WT_DOOR_TYPE \
				 水密ドア／左舷１Ｆ \
				 2000 \
				 d:M_TYPE:RUN_CHANGE \
				 d:wn_船尾甲板左舷
		} else if( $s:登場ポイント == 甲板右舷１Ｆ ) {
			print '甲板右舷１Ｆ'
			chara カメラ設定 ロードカメラ \
				-c 1 \
				-p 9843,827,-1674 -t 8794,955,-3347 \
				-r -42,2413,0 -f 1979 \
				-a 200 \
				-i 0 2 0 0 \
				-s 1

			@タイマー付きカメラＯＦＦ ロードカメラ 70

			@ステージ開始時処理（ステージ名表示） \
				d:LOAD_TYPE:WT_DOOR_TYPE \
				水密ドア／右舷１Ｆ \
				3000 \
				d:M_TYPE:RUN_CHANGE \
				d:wn_船尾甲板右舷

		}else if( $s:登場ポイント == 甲板右舷２Ｆ ){
			print '甲板右舷２Ｆ'
			@甲板いろいろ登場

			chara カメラ設定 ビヨンドカメラ \
				-c 1 \
				-p 15638,5377,-5806 \
				-t 12666,4315,-10905 \
				-a 200 \
				-i 0 2 0 0 \
				-s 1

			@ステージ開始時処理（ステージ名表示） \
				d:LOAD_TYPE:WT_DOOR_TYPE \
				水密ドア／右舷２Ｆ \
				3000 \
				d:M_TYPE:RUN_CHANGE \
				d:wn_船尾甲板右舷

		} else if( $s:登場ポイント == 甲板左舷２Ｆ ) {
			print '甲板左舷２Ｆ'
			@甲板いろいろ登場

			chara カメラ設定 ビヨンドカメラ \
				-c 1 \
				-p -15638,5377,-5806 \
				-t -12666,4315,-10905 \
				-a 200 \
				-i 0 2 0 0 \
				-s 1
				
			@ステージ開始時処理（ステージ名表示） \
				d:LOAD_TYPE:WT_DOOR_TYPE \
				水密ドア／左舷２Ｆ \
				3000 \
				d:M_TYPE:RUN_CHANGE \
				d:wn_船尾甲板左舷
		} else if( $s:登場ポイント == スネークテイルズスタート ) {
			@ロード時フェードイン
		} else {
			#if d:DEBUG_PRINT
				@デバッグ用オールタナティブミッション表示
			#endif
		}
	}

//###################################################################################
//								パッドデモスタート
//###################################################################################


//	if($w:t_story == d:ST_T01a1D目的説明ポリゴンデモ終了){

	if($s:登場ポイント == タンカー編パッドデモスタート){

		eval($w:t_story = d:ST_T01b1G装備品説明シナリオデモ開始)

		eval($w:アイテム数[d:アイテム:ダミータンカーカメラ] = 1)
		eval($w:アイテム数[d:アイテム:タンカー編カメラ] = 0)

//		eval($w:武器弾数[d:武器:Ｍ９] = 16)

		eval($f:w00a_タンカー右舷で死体捨てた = 0)
		eval($f:w00a_タンカー左舷で死体捨てた = 0)
		eval($f:w00a_タンカー３Ｆ左舷横で死体捨てた = 0)
		eval($f:w00a_タンカー３Ｆ左舷正面で死体捨てた = 0)
		eval($f:w00a_タンカー３Ｆ右舷で死体捨てた = 0)



		@甲板いろいろ登場
		@甲板パッドデモ

	}else if($w:t_story == d:ST_T03b1Rカモフ登場後無線機デモ終了){

//	}else if($s:登場ポイント == タンカー編スタート){

		eval($w:アイテム数[d:アイテム:ダミータンカーカメラ] = 0)
		eval($w:アイテム数[d:アイテム:タンカー編カメラ] = 1)

		eval( $w:武器 = d:武器:Ｍ９ )
		eval( $w:アイテム = d:アイテム:素手 )


	}

#if d:パッドデモ収録デバッグ
	eval($w:アイテム数[d:アイテム:ダミータンカーカメラ] = 1)
#endif



#if d:DEBUG
	mesg シネマスクリーン シネマ フェードアウト 0		//ゼロでデフォルト値
#endif


