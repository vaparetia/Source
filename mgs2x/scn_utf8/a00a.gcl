								-press d:PAD_B 		// 指定ボタンをそのフレームだけおしたことにする
					}

#endif

				}


//右舷クレーン階段横東方向
		// ------------------
			trap by023r d:PLAYER \
				-mask いる \
				-and \
				-dir 1024,256 3072,256 \
				-button d:ACTION_BUTTON d:ACTION_BUTTON \		//ビヨンドボタン
				-state d:TRP_STATE_STAND,d:TRP_STATE_CAUTION \	//立ち状態or張り付き
				-exec {
					@東向きビヨンド発動 by023r 9000 $6 4000 5000 d:BY_NOFOOTSHADOW

#if d:すぐおりエルード
					chara delay ディレイ -time 110 -exec {

							command パッド操作 \
								-press d:PAD_B 		// 指定ボタンをそのフレームだけおしたことにする
					}

#endif


				}















	}







