/**************************************************************************************/
// リソース
/**************************************************************************************/
	resource ghq_area_alert_voice {
	w00a:
		$t{
			t:vc04000a,	//「了解。船尾甲板、扉付近を守れ！侵入者を船内に入れるな！」
			t:vc04000b, //「わかった。船尾甲板、扉を死守しろ！」
			-1 // PLAREA0の登録終了
		}
	}

	resource ghq_caution_voice {
	w00a:
		$t{
			t:vc040033, //「了解。船尾甲板、扉付近の警戒を強化せよ。侵入者を船内に入れるな」
			t:vc040034, //「わかった。船尾甲板、扉近辺の警備を固めろ」
			-2,
			t:vc040068,	//「船尾甲板との連絡が途絶えた」
			-1 // PLAREA0の登録終了
		}
	a00a:
		$t{
			t:vc046601, //「了解、総員警戒を強化せよ」
			t:vc046601, //「了解、総員警戒を強化せよ」
			-2,
			t:vc040068,	//「船尾甲板との連絡が途絶えた」
			-1 // PLAREA0の登録終了
		}
	}

/****************************************************************************************/
// ドア設定用ステージ内ローカル変数(a_mode.hよりも先に定義する)
/****************************************************************************************/

dim $$b:ドアフラグ[ 4 ]
dim $$s:ドアモデル名[ 4 ]

command	配列セット $$b:ドアフラグ[0] {
	0, 0, 0, 0
}
command	配列セット $$s:ドアモデル名[0] {
	0, 0, 0, 0
}

