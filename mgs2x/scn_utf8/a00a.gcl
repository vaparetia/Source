	proc 船首モデル設定 {
		print '艦首モデル設定'

		chara プットオブジェ 船首１ -m w00_f1 -r 0 0 0 -p 0 0 -180000  -l w00a -s 100 100 100
		chara プットオブジェ 船首２ -m w00_f2 -r 0 0 0 -p 0 0 -120000  -l w00a -s 100 100 100
		chara プットオブジェ 船首３ -m w00_f3 -r 0 0 0 -p 0 0 -60000  -l w00a -s 100 100 100
		chara プットオブジェ 船首４ -m w00_f4 -r 0 0 0 -p 0 0 0  -l w00a -s 100 100 100


		chara プットオブジェ ウィンドラス -m w00a_winch -r 0 0 0 -p 0 0 0  -l w00a -s 100 100 100

	}


//###################################################################################
//									サウンド設定
//###################################################################################

	// サウンド設定
	proc サウンドマネージャー設定 {
		print 'w00a_sound_mane:サウンド設定'

		chara サウンドマネージャー ＳＤマネ -pak 0

	}

	proc サウンド設定 {

		#if d:SOUND_FG

		chara ＢＧＭマネージャー ＢＧＭマネ -s 0x00000001

		chara ＢＧＭ風音 風音

//Track0x06 …雨、屋根当たり音[場所に貼る]

		chara ＢＧＭフェーダー 雨屋根当たり音 \
			-t 0x06 \
			-a -13500,4000,-12000 1500,1000,4000 w00a \	//左舷救命ボート
				13500,4000,-12000 1500,1000,4000 w00a \	//右舷救命ボート
				-4000,1000,16500 2000,1000,1500 w00a \	//左舷ウインチ
				4000,1000,16500 2000,1000,1500 w00a		//右舷ウインチ


//Track0x07 …雨、鉄板系当たり音[場所に貼る]

		chara ＢＧＭフェーダー 雨鉄板系当たり音 \
			-t 0x07 \
			-a -9000,7000,-6000 2000,1000,2000 w00a \	//左舷アンテナ
				9000,7000,-6000 2000,1000,2000 w00a \	//右舷アンテナ
				-11500,1500,-4500 1500,2000,1000 w00a \	//左舷１Ｆ階段
				11500,1500,-4500 1500,2000,1000 w00a \	//右舷１Ｆ階段
				-7500,1000,6000 1000,2000,1000 w00a \	//左舷１Ｆ階段南
				7500,1000,6000 1000,2000,1000 w00a \	//右舷１Ｆ階段南
				-10000,3000,1500 2000,1000,2000 w00a \	//左舷クレーンそば
				10000,3000,1500 2000,1000,2000 w00a		//右舷クレーンそば


//Track0x08 …雨、床当たり音[鳴らない場所を指定、ステータスに 0x0003 を指定]

		chara ＢＧＭフェーダー 雨床当たり音 \
			-t 0x08 \
			-a -16000,1000,-11500 4000,1000,6500 w00a \	//左舷下
				16000,1000,-11500 4000,1000,6500 w00a \	//右舷下
			-s 0x0003


#if 1
		//@サウンド効果音設定
#else

#endif

		#endif
	}










	// プレイヤー
	// ------------------------------------
	proc プレイヤー設定 {

		if( $s:登場ポイント == タンカー編パッドデモスタート ){
			eval( $b:プレイヤー初期状態 = 1 )

		}else{
			eval( $b:プレイヤー初期状態 = 0 )

		}

		#if d:VIDEO_SPECIAL
				chara プレイヤー d:PLAYER \
					-m sna_def \
					-a snake \
					-p $i:プレイヤー初期Ｘ位置 $i:プレイヤー初期Ｙ位置 $i:プレイヤー初期Ｚ位置 \
					-d 0,$i:プレイヤー初期方向,0 \
					-l 4000 \
					-f 0x00000001 \
					-s 0 \
					-o sna_w00a \
					-i 0 \
					-h 100000 2048
		#else
				chara プレイヤー d:PLAYER \
					-m sna_def \
					-a snake \
					-p $i:プレイヤー初期Ｘ位置 $i:プレイヤー初期Ｙ位置 $i:プレイヤー初期Ｚ位置 \
					-d 0,$i:プレイヤー初期方向,0 \
					-l 4000 \
					-f 0x00000001 \
					-s $b:プレイヤー初期状態 \
					-o sna_w00a \
					-i 0
		#endif
				//バンダナ
				chara ロープモデル３ バンダナ１ \
					-n sna_bdn1 \
					-d 1 \
					-y d:PLAYER \
					-z 12 \
					-x 0,60,-90 \
					-m 12 \
					-p 250 \
					-k 350 \
					-o 110 \
					-f 1

				chara ロープモデル３ バンダナ２ \
					-n sna_bdn2 \
					-d 1 \
					-y d:PLAYER \
					-z 12 \
					-x 0,50,-90 \
					-m 22 \
					-p 250 \
					-k 350 \
					-o 110 \
					-f 1
		#if d:MULTI_MODEL
			chara マルチウェイトキャラ マルチ \
				-name d:PLAYER \
				-model sna_mmt

			chara 臨時顔アニメキャラ アニメキャラ \
				-chara	d:PLAYER
		#endif


#if 1
			@プレイヤーＬＯＤ設定 d:C_DISTANCE_TYPE 6000
#else
			// 距離によるＬＯＤの使用
			chara ＬＯＤ制御 プレイヤーＬＯＤ \
						-name d:PLAYER \
						-type 1 \
						-model sna_def_sh \
						-value 2000
#endif

	}


