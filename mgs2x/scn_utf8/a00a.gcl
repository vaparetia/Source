//								スネーク水飛沫設定
//###################################################################################

	proc スネーク水飛沫設定 {
		print 'スネーク水飛沫設定'
		print 'snake_splash'


		chara キャラ付随水飛抹 スネーク水飛沫 \
			-nconcname d:PLAYER \
			-addone 32 \
			-time -1 \
			-rgbadd 0x40404030 \
			-gbsub 0x40404030

		trap ca003 d:PLAYER \
			-mask ？ \
			-exec {
				if($3 == 入る){
					print 'スネーク水飛沫スリープ'
					mesg キャラ付随水飛抹 スネーク水飛沫 スリープモード
				}else{
					print 'スネーク水飛沫アクティブ'
					mesg キャラ付随水飛抹 スネーク水飛沫 アクティブモード
				}
			}



	}




//###################################################################################
//									カメラ設定
//###################################################################################

	// カメラ設定
	// ------------------------------------
	proc カメラ設定 {
		print 'デフォルトカメラ設定'

			chara カメラ ステージカメラ	-c 0 -l 3 -p 0
			chara カメラ サブカメラ１	-c 0 -l 2 -p 50
			chara カメラ サブカメラ２	-c 0 -l 2 -p 40
			chara カメラ サブカメラ３	-c 0 -l 2 -p 30
			chara カメラ ビヨンドカメラ	-c 0 -l 2 -p 20
			chara カメラ シナリオカメラ	-c 0 -l 2 -p 15
			chara カメラ ロードカメラ	-c 0 -l 2 -p 10 //水密ドアロード用にしか使ってません

			// デフォルトカメラ
			chara カメラ設定 ステージカメラ \
				-c 0 \
				-b -32000,-17000,-80750 32000,32000,0 \
				-l -32000,-17000,-80750 32000,32000,0 \
				-r 640,2048,0 \
				-f 4000 \
				-a 200 \
				-i 1 -1 0 0 \
				-s 1
	}


	proc 甲板カメラ設定 {
		print '甲板カメラ設定'


//甲板南部１（最後尾）
		trap ca000 d:PLAYER \
			-camera \
			-mask いる \
			-exec {
				@CS_スムーズカメラ $6 8000 20000 350 100
				eval( $i:補完ＲＸ = $i:CS_結果１ )
				@CS_スムーズカメラ $4 -6000 6000 1920 2176
				eval( $i:補完ＲＹ = $i:CS_結果１ )
				chara カメラ設定 サブカメラ１ \
					-c 0 \
					-b -32000,   500,-32000 32000,32000,32000 \
					-l -32000,   500,-32000 32000,32000,32000 \
//					-r $i:補完ＲＸ,$i:補完ＲＹ,0 \
					-r 390,$i:補完ＲＹ,0 \
					-f 8000 \
					-a 200 \
					-i 1 -1 0 0 \
					-s $3
			}

//甲板南部２
		trap ca001 d:PLAYER \
			-camera \
			-mask いる \
			-exec {

				eval( $i:割合Ｚ = ($6 + 1000) / 90 );
				eval( $i:補完ＲＸ = 1020 - 670 * $i:割合Ｚ / 100 );
				eval( $i:割合Ｘ = ($4 + 6000) / 120 );
				eval( $i:補完ＲＹ = ( 2048 -  ( 2048 - ( 1920 + 256 * $i:割合Ｘ / 100 )) * $i:割合Ｚ / 100 ) )	;

				@CS_スムーズカメラ昇順 $5 500 2000 5900 7000

				eval( $w:補完距離 = $i:CS_結果１ )

				chara カメラ設定 サブカメラ１ \
					-c 0 \
					-b -32000,500,-32000 32000,32000,32000 \
					-l -32000,500,-32000 32000,32000,32000 \
					-r $i:補完ＲＸ,$i:補完ＲＹ,0 \
					-f 8000 \
					-a 200 \
					-i 2 -1 0 0 \
					-s $3

			}


//左舷クレーン脇
		trap ca027l d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {
				chara カメラ設定 サブカメラ１ \
					-c 1 \
					-p -8466,4825,1999 \
					-t -9274,3078,-887 \
					-a 145 \
					-i 0 -1 0 0 \
					-s $3

			}

//右舷クレーン脇
		trap ca027r d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {
				chara カメラ設定 サブカメラ１ \
					-c 1 \
					-p 8466,4825,1999 \
					-t 9274,3078,-887 \
					-a 145 \
					-i 0 -1 0 0 \
					-s $3

			}


//甲板南部３＆階段
		trap ca002 d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {

				if( $4 < 0 ){
					eval( $i:補完ＢＸ１ = -32000 )
					eval( $i:補完ＢＸ２ = -8100 )
					eval( $i:補完ＬＸ１ = -32000 )
					eval( $i:補完ＬＸ２ = -8200 )

				}else{
					eval( $i:補完ＢＸ１ = 8100 )
					eval( $i:補完ＢＸ２ = 32000 )
					eval( $i:補完ＬＸ１ = 8200 )
					eval( $i:補完ＬＸ２ = 32000 )

				}

				if($4 > -11000 && $4 < 11000 && $6 > -2000){	//クレーン横から降りてきたときだけ。
					eval($w:カメラ補完方式 = 0)
				}else{
					eval($w:カメラ補完方式 = 3)
				}

				@CS_スムーズカメラ $6 -1000 -5000 1020 640
				eval( $i:補完ＲＸ = $i:CS_結果１ ) ;
				chara カメラ設定 サブカメラ１ \
					-c 0 \
					-b $i:補完ＢＸ１,500,-32000 $i:補完ＢＸ２,7000,-1500 \
//					-b $i:補完ＢＸ１,500,-32000 $i:補完ＢＸ２,5900,-1500 \
					-l $i:補完ＬＸ１,500,-32000 $i:補完ＬＸ２,32000,-1600 \
					-r $i:補完ＲＸ,2048,0 \
					-f 8000 \
//					-f 5900 \
					-a 200 \
					-i $w:カメラ補完方式 -1 0 0 \
					-s $3
			}

//甲板南部４（屋根アリ）

		trap ca003 d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {


				if( $4 < 0 ){
					chara カメラ設定 サブカメラ２ \
						-c 0 \
						-b -14800,2000,-32000 -14100,32000,32000 \
						-l -32000,-32000,-32000 32000,32000,32000 \
						-r 60,2400,0 \
						-f 4000 \
						-a 200 \
						-i 3 -1 0 0 \
						-o 30 \
						-s $3 \
						-E 1 30 \ 			//$f:スライドタイプ $w:スライド待ち時間 \
							7000 4000 \ 		//$i:スライド距離１ $i:スライド距離２ \
							50 				//$i:スライドスピード [$i:スライドフラグ]

				}else{
					chara カメラ設定 サブカメラ２ \
						-c 0 \
						-b 14100,2000,-32000  14800,32000,32000 \
						-l -32000,-32000,-32000 32000,32000,32000 \
						-r 60,( 4096 - 2400 ),0 \
						-f 4000 \
						-a 200 \
						-i 2 -1 0 0 \
						-o 30 \
						-s $3 \
						-E 1 30 \ 			//$f:スライドタイプ $w:スライド待ち時間 \
							7000 4000 \ 		//$i:スライド距離１ $i:スライド距離２ \
							50 				//$i:スライドスピード [$i:スライドフラグ]

				}

			}



//左舷死体遺棄場所（屋根アリ）
		trap ca020l d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {
				chara カメラ設定 サブカメラ３ \
					-c 1 \
					-p -18108,4722,-8975 \
					-t -17958,1244,-10756 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3
			}

//右舷死体遺棄場所（屋根アリ）
		trap ca020r d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {
				chara カメラ設定 サブカメラ３ \
					-c 1 \
					-p 18108,4722,-8975 \
					-t 17958,1244,-10756 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3
			}


//左舷甲板４奥（屋根アリ）
		trap ca021l d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {
				chara カメラ設定 サブカメラ３ \
					-c 1 \
					-p -19562,5124,-15194 \
					-t -19021,1581,-17606 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3
			}

//右舷甲板４奥（屋根アリ）
		trap ca021r d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {
				chara カメラ設定 サブカメラ３ \
					-c 1 \
					-p 19562,5124,-15194 \
					-t 19021,1581,-17606 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3
			}


//１Ｆ階段西
		trap ca004l d:PLAYER \
			-camera \
			-mask ？ \
			-exec {
				if ( $5 < 2000 && $4 > -11000 ) {	//階段の下除外するため

					/* 階段を下から上に昇る */
					chara カメラ設定 サブカメラ３ \
						-c 0 \
						-b -13224,4164,331 -13224,4164,331 \
						-l -32000,-32000,-32000 32000,32000,32000 \
						-f 8000 \
						-a 200 \
						-i 3 -1 0 0 \
						-z 0x00700000 \		//遊びなしカメラ
						-s $3

				} else if( $5 > 2000 ){

					/* 階段を上から下へ降りる */
					chara カメラ設定 サブカメラ３ \
						-c 1 \
						-p -12206,6958,-991 \
						-t -11325,813,-4727 \
						-a 200 \
						-i 3 -1 0 0 \
						-s $3

				}

			}



//１Ｆ階段右舷
		trap ca004r d:PLAYER \
			-camera \
			-mask ？ \
			-exec {
				if ( $5 < 2000 && $4 < 11000 ) {	//階段の下除外するため

					/* 階段を下から上に昇る */
					chara カメラ設定 サブカメラ３ \
						-c 0 \
						-b 13224,4164,331 13224,4164,331 \
						-l -32000,-32000,-32000 32000,32000,32000 \
						-f 8000 \
						-a 200 \
						-i 3 -1 0 0 \
						-z 0x00700000 \		//遊びなしカメラ
						-s $3

				} else if( $5 > 2000 ){

					/* 階段を上から下へ降りる */
					chara カメラ設定 サブカメラ３ \
						-c 1 \
						-p 12206,6958,-991 \
						-t 11325,813,-4727 \
						-a 200 \
						-i 1 -1 0 0 \
						-s $3

				}

			}


//２Ｆ階段左舷

		trap ca005l d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {

				if( $6 < -12500 && $5 < 5000 ){	//階段奥

					@CS_スムーズカメラ昇順 $4 -15000 -12000 2250 1800
					eval( $i:補完ＲＹ = $i:CS_結果１ )

					chara カメラ設定 サブカメラ１ \
						-c 0 \
						-b -13000,-32000,-32000 -13000,5400,32000 \
						-l -32000,-32000,-32000 32000,32000,32000 \
						-r 148,$i:補完ＲＹ,0 \
						-f 6000 \
						-a 200 \
						-i 0 -1 0 0 \
						-s $3

				}else{
					chara カメラ設定 サブカメラ１ \
						-c 0 \
						-b -32000,5000,-32000 32000,5500,32000 \
						-l -32000,-32000,-7000 32000,32000,32000 \
						-r 120,1900,0 \
						-f 6000 \
						-a 200 \
						-i 3 -1 0 0 \
						-s $3

				}

			}



//２Ｆ階段右舷
		trap ca005r d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {

				if( $6 < -12500 && $5 < 5000 ){	//階段奥

					@CS_スムーズカメラ昇順 $4 12000 14000 (4096 - 2250) (4096 - 1800)
					eval( $i:補完ＲＹ = $i:CS_結果１ )

					chara カメラ設定 サブカメラ１ \
						-c 0 \
						-b 13000,-32000,-32000 13000,5400,32000 \
						-l -32000,-32000,-32000 32000,32000,32000 \
						-r 148,$i:補完ＲＹ,0 \
						-f 6000 \
						-a 200 \
						-i 0 -1 0 0 \
						-s $3


				}else{
					chara カメラ設定 サブカメラ１ \
						-c 0 \
						-b -32000,5000,-32000 32000,5500,32000 \
						-l -32000,-32000,-7000 32000,32000,32000 \
						-r 120,(4096 - 1900),0 \
						-f 6000 \
						-a 200 \
						-i 3 -1 0 0 \
						-s $3

				}

			}


//２Ｆ階段奥（東西）
		trap ca026 d:PLAYER \
			-camera \
			-mask ？ \
			-exec {

				if($4 < 0){
					chara カメラ設定 サブカメラ２ \
						-c 1 \
						-p -16880,9310,-14570 \
						-t -16519,1745,-17082 \
						-a 154 \
						-i 0 0 0 0 \
						-s $3

				}else{
					chara カメラ設定 サブカメラ２ \
						-c 1 \
						-p 16880,9310,-14570 \
						-t 16519,1745,-17082 \
						-a 154 \
						-i 0 0 0 0 \
						-s $3

				}

			}




//２Ｆ～３Ｆ左舷階段
		trap ca010l d:PLAYER \
			-camera \
			-mask いる \
			-exec {

					chara カメラ設定 サブカメラ１ \
						-c 0 \
						-b -32000,-32000,-5000 -13000,32000,32000 \
						-l -32000,-32000,-32000 32000,32000,32000 \
						-r 100,2000,0 \
						-f 10000 \
						-a 200 \
						-i 3 -1 0 0 \
						-s $3

			}


//２Ｆ～３Ｆ右舷階段
		trap ca010r d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {

					chara カメラ設定 サブカメラ１ \
						-c 0 \
						-b 13000,-32000,-5000 32000,32000,32000 \
						-l -32000,-32000,-32000 32000,32000,32000 \
						-r 100,(4096 - 2000),0 \
						-f 10000 \
						-a 200 \
						-i 3 -1 0 0 \
						-s $3

			}



// ３Ｆ左舷(階段上がったところ)

		trap ca006l d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {
				chara カメラ設定 サブカメラ１ \
					-c 0 \
					-b -32000,-32000,-5000 -13000,9000,32000 \
					-l -32000,-32000,-32000 32000,32000,32000 \
					-r 120,2000,0 \
					-f 10000 \
					-a 200 \
					-i 2 -1 0 0 \
					-s $3
			}


//３Ｆ右舷(階段上がったところ)

		trap ca006r d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {

				chara カメラ設定 サブカメラ１ \
					-c 0 \
					-b 13000,-32000,-5000 32000,9000,32000 \
					-l -32000,-32000,-32000 32000,32000,32000 \
					-r 120,(4096 - 2000),0 \
					-f 10000 \
					-a 200 \
					-i 2 -1 0 0 \
					-s $3

			}



//３Ｆ踊り場
		trap ca007 d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {
				if ( $4 < 0 ) { eval( $i:補完ＲＹ = 2000 ) ;
				} else { 	eval( $i:補完ＲＹ = 4096 - 2000 ) }

				@CS_スムーズカメラ昇順 $6 -12000 -3000 9000 11000
				eval( $i:補完ＢＹ = $i:CS_結果１ )

				chara カメラ設定 サブカメラ１ \
					-c 0 \
					-b -32000,-32000,-32000 32000,$i:補完ＢＹ,32000 \
					-l -32000,-32000,-32000 32000,32000,32000 \
					-r 200,$i:補完ＲＹ,0 \
					-f 10000 \
					-a 200 \
					-i 2 -1 0 0 \
					-s $3
			}




//３Ｆ縦通路
		trap ca008 d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {
				if ( $4 < 0 ) { eval( $i:補完ＲＹ = 2048 - 150 ) ;
				} else { 	eval( $i:補完ＲＹ = 2048 + 150 ) ;}
				eval( $i:割合Ｚ = (( $6 + 5000 ) / 100 ));
//				eval( $i:補完ＲＸ = 100 * $i:割合Ｚ / 100 );
				eval( $i:補完ＲＸ = 200 );
				eval( $w:補完Ｔ = 6000 - 1500 * $i:割合Ｚ / 100 );


				chara カメラ設定 サブカメラ１ \
					-c 0 \
					-b -32000 -32000 -32000 32000 32000 32000 \
					-l -32000 -32000 -32000 32000 32000 32000 \
					-r $i:補完ＲＸ,$i:補完ＲＹ,0 \
					-f $w:補完Ｔ \
					-a 200 \
					-i 2 -1 0 0 \
					-s $3 \
					-E 1 120 \
						7000 5000 \
						1


//	-slidE $f:スライドタイプ $w:スライド待ち時間 \
//	       $i:スライド距離１ $i:スライド距離２ \
//	       $i:スライドスピード [$i:スライドフラグ]

// スライドカメラ設定方法
// スライドタイプ：０／１ － 左右タイプ／前後タイプ
// スライド待ち時間：スライドするまでの待ちフレーム数
// スライド距離１・２：左右タイプの場合 左右スライド距離
//		       前後タイプの場合 接近距離、離れた距離
// スライドスピード：そのまんま
// スライドフラグ ：
//		1にしておくと、入った時スライドしていない状態から始まります。

			}

//３Ｆ横通路
		trap ca009 d:PLAYER \
			-camera \
			-mask ？ \
			-exec {

				chara カメラ設定 サブカメラ１ \
					-c 0 \
					-b -32000,-32000,-32000,32000,32000,32000 \
					-l -32000,-32000,-32000,32000,32000,32000 \
					-f 5400 \
					-r 248,2048,0 \
					-a 200 \
					-i 2 -1 0 0 \
					-s $3 \
					-E 0 30 \
						1500 1500 \
						40 1

			}






//甲板南部１（最後尾）
		eval( $f:甲板スネークca000にいる = 0 )

		trap ca000 d:PLAYER \
			-mask ？ \
			-exec {

				if( $3 == 入る ){
					eval( $f:甲板スネークca000にいる = 1 )

				}else{
					eval( $f:甲板スネークca000にいる = 0 )

				}

			}




	}




//###################################################################################
//								落下敵兵カメラ設定
//###################################################################################


	proc 落下敵兵カメラ{

//右舷２Ｆ
		trap en002 敵兵 \
			-mask 入る \
			-exec {
				print '敵兵落下'

				if( $w:アラートモード == d:ALERT_MODE_SENNYU && !$f:甲板スネークca000にいる ){

					@パンカメラプロック \
						18254 5875 810 \
						16584 2982 -4138 \
						16090 7039 1836 \
						14979 4700 -3576 \
						200 \	//画角
						90 \	//持続フレーム数
						0

				}

			}


//３Ｆ最後尾
		trap en003 敵兵 \
			-mask 入る \
			-exec {
				print 'アラートモード'$w:アラートモード


				if( $w:アラートモード == d:ALERT_MODE_SENNYU && !$f:甲板スネークca000にいる ){

					eval( $i:甲板敵兵Ｘ座標 = $4 )

					if($i:甲板敵兵Ｘ座標 < -2500){
						eval($f:w00a_タンカー３Ｆ左舷正面で死体捨てた = 1)
					}else if($i:甲板敵兵Ｘ座標 > 2500){
						eval( $f:w00a_タンカー３Ｆ右舷正面で死体捨てた = 1 );
					}else{
						eval( $f:w00a_タンカー３Ｆ正面で死体捨てた = 1 );
					}

					@パンカメラプロック \
						$4,10500,9500 \
						$4,6000,8000 \
						($4 + 250),10500,9500 \
						$4,6000,8000 \
						100 \	//画角
						19 \	//持続フレーム数
						0

					chara delay カメラゆれタイム \
#ifdef d:PAL
						-time 21 \
#else
						-time 20 \
#endif
						-exec {

							@シナリオデモ開始処理


							@パンカメラプロック \
								$i:甲板敵兵Ｘ座標 2000 8562 \
								$i:甲板敵兵Ｘ座標 6216 7021 \
								$i:甲板敵兵Ｘ座標 2000 8562 \
								$i:甲板敵兵Ｘ座標 6216 8500 \
								100 \	//画角
								49 \	//持続フレーム数
								0

							chara delay カメラゆれタイム -time 50 -exec {

								eval($f:カメラゆれ中 = 1)

								chara delay カメラゆれタイム -time 30 -exec {
									eval($f:カメラゆれ中 = 0)
								}

								chara delay カメラゆれタイム２ -time 1 -exec {
									if($f:カメラゆれ中 == 1){
										chara カメラ設定 シナリオカメラ \
											-c 1 \
											-p ($i:甲板敵兵Ｘ座標 + `%rand 100`),(2000 + `%rand 100`),(8562 + `%rand 100`) \
											-t $i:甲板敵兵Ｘ座標,6216,7021 \
											-a 100 \
											-i 1 0 0 0 \
											-s 1
										return 1
									}else{
										chara delay カメラゆれタイム２ -time 30 -exec {
											chara カメラ設定 シナリオカメラ \
												-s -1
											@シナリオデモ終了処理
										}
										return 0
									}
								}

							}


						}

				}

			}


//３Ｆ最後尾左右
		trap en004 敵兵 \
			-mask 入る \
			-exec {

				if( $w:アラートモード == d:ALERT_MODE_SENNYU && !$f:甲板スネークca000にいる ){

					print '敵兵落下'

					@シナリオデモ開始処理

					if( $4 < 0 ){

						eval($f:w00a_タンカー３Ｆ左舷横で死体捨てた = 1)

						chara delay カメラゆれタイム \
							-time 290 \
							-exec {

								@シナリオデモ終了処理

							}

						chara カメラ設定 シナリオカメラ \
							-c 1 \
							-p -7360,7353,9582 \
							-t -7218,6859,3403 \
							-a 300 \
							-i 0 -1 0 0 \
							-s 1

						chara delay カメラゆれタイム -time 30 -exec {

							chara カメラ設定 シナリオカメラ \
								-c 1 \
								-p -9744,1361,14804 \
								-t -8963,2959,10577 \
								-a 200 \
								-i 0 -1 0 0 \
								-s 1

							chara delay カメラゆれタイム -time 120 -exec {

								chara カメラ設定 シナリオカメラ \
									-c 1 \
									-p -9693,4235,14331 \
									-t -9509,1839,9520 \
									-a 200 \
									-i 3 0 0 0 \
									-s 1

								chara delay カメラゆれタイム -time 120 -exec {

									chara カメラ設定 シナリオカメラ \
										-s -1

								}

							}

						}

					}else{

						eval($f:w00a_タンカー３Ｆ右舷で死体捨てた = 1)

						chara delay カメラゆれタイム -time 110 -exec {
							@シナリオデモ終了処理
						}

						@パンカメラプロック \
							8479 12035 6277 \
							7486 7574 5718 \
							9442 16362 6818 \
							8449 11901 6260 \
							200 \	//画角
							120 \	//持続フレーム数
							0

					}


				}

			}





//１Ｆ左舷
		trap en005 敵兵 \
			-mask 入る \
			-exec {

				if( $w:アラートモード == d:ALERT_MODE_SENNYU ){

					@シナリオデモ開始処理

					chara delay カメラゆれタイム \
						-time 150 \
						-exec {
							@シナリオデモ終了処理
						}


					@パンカメラプロック \
						($4 - 1000) 900 ($6 + 6000) \
						($4 - 1000) 1200 $6 \
						($4 - 1000) 0 ($6 + 6000) \
						($4 - 1000) -5000 $6 \
						200 \	//画角
						180 \	//持続フレーム数
						0




				}

			}

	}







