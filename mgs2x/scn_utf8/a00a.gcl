				return 240

			}else if($w:甲板パッドデモステップ == 2){
				print '飛び出し撃ち説明'

				@説明テクスチャ表示 飛び出し撃ち説明 act_telop4_alp_ovl 80

				eval($w:甲板パッドデモステップ = 3)
				return 150


			}else if($w:甲板パッドデモステップ == 3){
				print '主観説明'

				@説明テクスチャ表示 主観説明 act_telop5_alp_ovl 140

				eval($w:甲板パッドデモステップ = 4)
				return 210

			}else if($w:甲板パッドデモステップ == 4){
				print '主観撃ち説明'

				@説明テクスチャ表示 ビハインド説明 act_telop6_alp_ovl 120

				eval($w:甲板パッドデモステップ = 5)
				return 0

			}

		}


#endif


	}



	proc 各言語対応テクスチャ呼び出し $:時間 $:英語 $:フランス語 $:ドイツ語 $:イタリア語 $:スペイン語 {

		if($w:言語 == d:LANG_FRENCH){
			@説明テクスチャ表示 パッドデモ説明 $:フランス語 $:時間
		}else if($w:言語 == d:LANG_GERMANY){
			@説明テクスチャ表示 パッドデモ説明 $:ドイツ語 $:時間
		}else if($w:言語 == d:LANG_ITALY){
			@説明テクスチャ表示 パッドデモ説明 $:イタリア語 $:時間
		}else if($w:言語 == d:LANG_SPANISH){
			@説明テクスチャ表示 パッドデモ説明 $:スペイン語 $:時間
		}else{
			@説明テクスチャ表示 パッドデモ説明 $:英語 $:時間
		}
	}






	proc Ｍ９音声終了{
	}


	proc タバコ説明パッドデモ{
#if d:DEBUG
	@甲板パッドデモ終了
#else
		command プレイヤー無敵セット

		//command Stream t:vc050202 -p タバコ音声終了
		command Stream t:vc060602 -p タバコ音声終了
/*
		<vc050202>
			オタコン	「装備の方は……」
			オタコン	「スネーク、なんだい！煙草？相変わらずだな」
			スネーク	「お守りみたいなもんだ」
			オタコン	「しょうがない奴だな……」
*/


		mesg パッドデモ タバコ説明 start

#endif
	}


	proc タバコ音声終了{
	}


	proc スコープ説明パッドデモ{

		command プレイヤー無敵解除

		chara delay パッドデモディレイ \
			-time 30 \
			-exec{

				//command Stream t:vc050203 -p スコープ音声終了
				command Stream t:vc060603 -p スコープ音声終了
//					<vc050203>	オタコン	「これが双眼鏡。使い方はと同じだ」


				mesg パッドデモ スコープ説明 start

			}

	}


	proc スコープ音声終了{
	}




	proc 甲板パッドデモ終了{

		mesg デモキャンセルチェック デモキャンセル kill

#if d:DEBUG
		command パッド操作 \
			-cancel

		mesg レーダー レーダー on

		command メニュー設定 \
			-gage on

#else

		if(!$f:パッドデモキャンセルした){
			eval($f:パッドデモキャンセルした = 1)

			preseek 'd01t'
			chara フェードインアウト フェードアウト \
				-i 0 0 0 0 \		//設定するとこのＲＧＢαから始まる
				-c 0 0 0 128 \		//目標のＲＧＢα
				-t d:FADEOUT_TIME \
				-p スコープデモ呼び出し
		}
#endif

	}

	proc スコープデモ呼び出し{

		print '$w:t_story = d:ST_T01b1G装備品説明シナリオデモ終了'
		eval($w:t_story = d:ST_T01b1G装備品説明シナリオデモ終了)

		command パッド操作 \
			-cancel


		command StreamStopAll


		mesg シネマスクリーン シネマ フェードイン 0		//ゼロでデフォルト値

		chara delay ディレイ \	//このディレイは暫定。無線の終了プロックをとること。
			-time 1 \
			-exec{
				load "d01t"
			}

	}



















//###################################################################################
//							ビデオ撮影用メタル登場設定
//###################################################################################

	proc メタル登場{

#if d:METAL
		print 'メタルギア設定'


		chara プットモーションモデル メタルギア \
			-pos 4849,0,15017 \
			-dir 0 \
//			-route $i:ルート $b:ノード \ //routeを指定した場合posとdirは無効
			-kms ray_e3a_sh \
			-evm ray_def \ /*省略可*/
			-mar ray_e3a \
			-number 0 \
			-status	0x16
//			-item	$s:装備モデル名 $i:関節番号 \ /*オブジェを付随*/

#endif

	}




//###################################################################################
//								デバッグ用設定
//###################################################################################

	proc 甲板デバッグプロック{

//パッドデモ実験用
		trap ca000 d:PLAYER \
			-mask いる \
			-button 0 \
			-exec {
				@甲板パッドデモ
			}

	}








