	// 設置オブジェクト
	// ------------------------------------
	// ドアオブジェクト
	// ------------------------------------


//###################################################################################
//									水密ドア設定
//###################################################################################

#define DR_NAME_L1	w00_sdr_r
#define DR_NAME_L2	w00_sdr_r
#define DR_NAME_L3	w00_sdr_r
#define DR_NAME_L4	w00_sdr_r
#define DR_NAME_L5	w00_sdr_r

#define DR_NAME_R1	w00_sdr_l
#define DR_NAME_R2	w00_sdr_l
#define DR_NAME_R3	w00_sdr_l
#define DR_NAME_R4	w00_sdr_l
#define DR_NAME_R5	w00_sdr_l

	proc 水密ドア設置 {
		// ドアフラグを元にモデルを設定(※全てのパターンのモデルを用意するのはもったいないので使うところのみ変更していく)
		@ドアモデル名セット 0 d:DR_NAME_L1 d:DR_NAME_L2 d:DR_NAME_L3 d:DR_NAME_L4 d:DR_NAME_L5
		@ドアモデル名セット 1 d:DR_NAME_L1 d:DR_NAME_L2 d:DR_NAME_L3 d:DR_NAME_L4 d:DR_NAME_L5
		@ドアモデル名セット 2 d:DR_NAME_R1 d:DR_NAME_R2 d:DR_NAME_R3 d:DR_NAME_R4 d:DR_NAME_R5
		@ドアモデル名セット 3 d:DR_NAME_R1 d:DR_NAME_R2 d:DR_NAME_R3 d:DR_NAME_R4 d:DR_NAME_R5

		print '水密ドア設定'

		if( `@スネーク達` ) {
			eval( $s:ローカル変数Ｓ１ = sna_hatch )
		} else {
			eval( $s:ローカル変数Ｓ１ = rai_wt_hatch )
		}

		chara 水密ドア管理 ドア管理モジュール -n 4 \
			-N 1 \		//$b:ノック音番号 \
			//-N d:se_code:SD_A_WALLM02 \		//$b:ノック音番号 \
			-motions $s:ローカル変数Ｓ１ hatch_door_sna hatch_handle_sna

//右舷１Ｆ

	// ドア開閉フラグの設定
		if( $s:登場ポイント == 甲板右舷１Ｆ ) {
			eval( $$i:水密ドアフラグ = d:WT_DOOR_FLAG_OPEN_START )
		} else {
			eval( $$i:水密ドアフラグ = d:WT_DOOR_FLAG_NORMAL )
		}

		if( $$b:ドアフラグ[0] == d:DOOR_FLAG_CLOSE ) {
			eval( $$i:水密ドアフラグ = ( $$i:水密ドアフラグ | d:WT_DOOR_FLAG_NOT_OPEN ) )
		}

		chara 水密ドア 水密ドア／右舷１Ｆ \
			-kms $$s:ドアモデル名[0] w00_sdr_handle \
			-position 9325,0,-5050 \
			-rotate 0,2048,0 \
			-type 1 \
			-hazard 8250,0,-5000 9250,0,-5000 \
			-flag $$i:水密ドアフラグ \
			-proc 右舷１Ｆロード

		trap dr501 d:PLAYER \
			-mask いる \
			-button d:ACTION_BUTTON \
			-state 0 \
			-exec {

					command 水密ドア状態 -n 水密ドア／右舷１Ｆ
					mesg プレイヤー d:PLAYER wt_door \
						水密ドア／右舷１Ｆ $status \	//$s:水密ドアの名前 $i:そのドアの状態
						2048,1024 \					//$w:ドアに正対した方向 $w:方向幅
						9325,-5050					//$i:ドア位置Ｘ $i:ドア位置Ｚ
			}


		trap dr501 d:PLAYER \
			-mask ？ \
			-dir 0,256 2048,256 \
			-state d:TRP_STATE_FORCE \
			-exec {
				chara カメラ設定 ビヨンドカメラ \
					-c 1 \
					-p 11020,3899,-2710 \
					-t 8098,-233,-5785 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3
			}

//右舷２Ｆ

	// ドア開閉フラグの設定
		if( $s:登場ポイント == 甲板右舷２Ｆ ){
			$$i:水密ドアフラグ = d:WT_DOOR_FLAG_OPEN_START;
		}else{
			$$i:水密ドアフラグ = d:WT_DOOR_FLAG_NORMAL;
		}

		if( $$b:ドアフラグ[1] == d:DOOR_FLAG_CLOSE ) {
			$$i:水密ドアフラグ = ( $$i:水密ドアフラグ | d:WT_DOOR_FLAG_NOT_OPEN );
		}

		chara 水密ドア 水密ドア／右舷２Ｆ \
				-kms $$s:ドアモデル名[1] w00_sdr_handle \
				-position 11950,3000,-10325 \
				-rotate 0,3072,0 \
				-type 1 \	  //０：左軸 １：右軸 省略時は０
				-proc 右舷２Ｆロード \
				-hazard 12000,3000,-9250 12000,3000,-10250 \
				-flag $$i:水密ドアフラグ


		trap dr503 d:PLAYER \
			-mask いる \
			-button d:ACTION_BUTTON \
			-state 0 \
			-exec {
					command 水密ドア状態 -n 水密ドア／右舷２Ｆ
					mesg プレイヤー d:PLAYER wt_door \
						水密ドア／右舷２Ｆ $status \	//$s:水密ドアの名前 $i:そのドアの状態
						3072,1024 \					//$w:ドアに正対した方向 $w:方向幅
						11950,-10325					//$i:ドア位置Ｘ $i:ドア位置Ｚ
			}


		trap dr503 d:PLAYER \
			-mask ？ \
			-dir 1024,256 3072,256 \
			-state d:TRP_STATE_FORCE \
			-exec {
				chara カメラ設定 ビヨンドカメラ \
					-c 1 \
					-p 15638,5377,-5806 \
					-t 12666,4315,-10905 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3
			}

//左舷１Ｆ
		if( $s:登場ポイント == 甲板左舷１Ｆ ){
			$$i:水密ドアフラグ = d:WT_DOOR_FLAG_OPEN_START;
		}else{
			$$i:水密ドアフラグ = d:WT_DOOR_FLAG_NORMAL;
		}

		if( $$b:ドアフラグ[2] == d:DOOR_FLAG_CLOSE ) {
			$$i:水密ドアフラグ = ( $$i:水密ドアフラグ | d:WT_DOOR_FLAG_NOT_OPEN );
		}

		chara 水密ドア 水密ドア／左舷１Ｆ \
				-kms $$s:ドアモデル名[2] w00_sdr_handle \
				-position -9325,0,-5050 \
				-rotate 0,0,0 \
				-proc 左舷１Ｆロード \
				-flag $$i:水密ドアフラグ \
				-h -9250,0,-5000 -8250,0,-5000

		trap dr500 d:PLAYER \
			-mask いる \
			-button d:ACTION_BUTTON \
			-state 0 \
			-exec {
					command 水密ドア状態 -n 水密ドア／左舷１Ｆ
					mesg プレイヤー d:PLAYER wt_door \
						水密ドア／左舷１Ｆ $status \	//$s:水密ドアの名前 $i:そのドアの状態
						2048,1024 \					//$w:ドアに正対した方向 $w:方向幅
						-9325,-5050					//$i:ドア位置Ｘ $i:ドア位置Ｚ
			}

		trap dr500 d:PLAYER \
			-mask ？ \
			-dir 0,256 2048,256 \
			-state d:TRP_STATE_FORCE \
			-exec {

				print '水密カメラ'
				chara カメラ設定 ビヨンドカメラ \
					-c 1 \
					-p -11020,3899,-2710 \
					-t -8098,-233,-5785 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3
			}

//左舷２Ｆ
		if( $s:登場ポイント == 甲板左舷２Ｆ ) {
			eval( $$i:水密ドアフラグ = d:WT_DOOR_FLAG_OPEN_START )
		} else {
			eval( $$i:水密ドアフラグ = d:WT_DOOR_FLAG_NORMAL )
		}

		if( $$b:ドアフラグ[3] == d:DOOR_FLAG_CLOSE ) {
			$$i:水密ドアフラグ = ( $$i:水密ドアフラグ | d:WT_DOOR_FLAG_NOT_OPEN );
		}

		chara 水密ドア 水密ドア／左舷２Ｆ \
			-kms $$s:ドアモデル名[3] w00_sdr_handle \
			-position -11950,3000,-10325 \
			-rotate 0,3072,0 \
			-proc 左舷２Ｆロード \
			-hazard -12000,3000,-9250 -12000,3000,-10250 \
			-flag $$i:水密ドアフラグ

		trap dr502 d:PLAYER \
			-mask いる \
			-button d:ACTION_BUTTON \
			-state 0 \
			-exec {
					command 水密ドア状態 -n 水密ドア／左舷２Ｆ
					mesg プレイヤー d:PLAYER wt_door \
						水密ドア／左舷２Ｆ $status \	//$s:水密ドアの名前 $i:そのドアの状態
						1024,1024 \					//$w:ドアに正対した方向 $w:方向幅
						-11950,-10325					//$i:ドア位置Ｘ $i:ドア位置Ｚ
			}

		trap dr502 d:PLAYER \
			-mask ？ \
			-dir 3072,256 1024,256 \
			-state d:TRP_STATE_FORCE \
			-exec {
				chara カメラ設定 ビヨンドカメラ \
					-c 1 \
					-p -15638,5377,-5806 \
					-t -12666,4315,-10905 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3
			}
	}

/*
	// 不明なプロック
	// 特に呼び出されてはいない模様
	proc ドア設置／甲板－居住区 {
		chara ドア 左舷１Ｆドア -m w00_door -d 0 0 0 -p -9450 0 -5125 \
			-slide 2000 -time 30
		chara ドア 右舷１Ｆドア -m w00_door -d 0 0 0 -p 8000 0 -5125 \
			-slide 2000 -time 30

		trap d000l d:PLAYER \
			-mask ？ \
			-exec {
				if ( $3 == 入る ) {
					mesg ドア 左舷１Ｆドア open $2
				} else{
					mesg ドア 左舷１Ｆドア close $2
				}
			}
		trap d000r d:PLAYER \
			-mask ？ \
			-exec {
				if ( $3 == 入る ) {
					mesg ドア 右舷１Ｆドア open $2
				} else{
					mesg ドア 右舷１Ｆドア close $2
				}
			}
	}
*/



//###################################################################################
//									甲板敵兵設定
//###################################################################################

	// 甲板敵兵セット

#define	左舷通常巡回		0
#define	右舷通常巡回		1
#define	右舷長距離巡回		2
#define	３Ｆ全体巡回		3
#define	３Ｆハード警戒		4
#define	３Ｆノーマル警戒	6
#define	３Ｆイージー警戒	7
#define	攻撃兵右舷待機		5
#define	攻撃兵左舷待機		8
#define	攻撃兵警戒巡回		9




	proc 警備兵０ {

		if( $s:登場ポイント == タンカー編スタート){
			print '敵兵ルート１'

			//左舷１Ｆ
			chara 警備兵 敵兵:01 -r d:左舷通常巡回 -n 0 -d -8750,0,-4500 甲板 \
				-s (d:ENE_STATUS_GUNLIGHT | d:ENE_STATUS_NIGHT_SIGHT) \
				-h 4000 \
				-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
				-l $w:敵標準体力 \
				-f $w:敵標準気絶 \
				-j ドッグタグ_敵兵 [dogtag:tnk_w00a_guard_ve_01] \
					[dogtag:tnk_w00a_guard_ea_01] [dogtag:tnk_w00a_guard_no_01] \
					[dogtag:tnk_w00a_guard_ha_01] [dogtag:tnk_w00a_guard_vh_01] \
				-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
				-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３

			//右舷２Ｆ
			if($w:ゲーム設定 >= d:LEVEL_NORMAL){
				chara 警備兵 敵兵:02 -r d:右舷通常巡回 -n 0 -d 12500,3000,-9750 甲板 \
					-s (d:ENE_STATUS_GUNLIGHT | d:ENE_STATUS_NIGHT_SIGHT) \
					-h 4000 \
					-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
					-l $w:敵標準体力 \
					-f $w:敵標準気絶 \
					-j ドッグタグ_敵兵 [dogtag:tnk_w00a_guard_ve_02] \
						[dogtag:tnk_w00a_guard_ea_02] [dogtag:tnk_w00a_guard_no_02] \
						[dogtag:tnk_w00a_guard_ha_02] [dogtag:tnk_w00a_guard_vh_02] \
					-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
					-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３

			}else{
				chara 警備兵 敵兵:02 -r d:右舷長距離巡回 -n 0 -d 12500,3000,-9750 甲板 \
					-s (d:ENE_STATUS_GUNLIGHT | d:ENE_STATUS_NIGHT_SIGHT) \
					-h 4000 \
					-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
					-l $w:敵標準体力 \
					-f $w:敵標準気絶 \
					-j ドッグタグ_敵兵 [dogtag:tnk_w00a_guard_ve_02] \
						[dogtag:tnk_w00a_guard_ea_02] [dogtag:tnk_w00a_guard_no_02] \
						[dogtag:tnk_w00a_guard_ha_02] [dogtag:tnk_w00a_guard_vh_02] \
					-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
					-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３

			}


			//最後尾３Ｆ
			if($w:ゲーム設定 >= d:LEVEL_HARD){
				chara 警備兵 敵兵:03 -r d:３Ｆハード警戒 -n 1 -d -6500,6000,3000 甲板 \
					-s (d:ENE_STATUS_GUNLIGHT | d:ENE_STATUS_NIGHT_SIGHT) \
					-h 4000 \
					-i 6500,$w:敵危険視力,$w:敵回避視力 \
					-l $w:敵標準体力 \
					-f $w:敵標準気絶 \
					-j ドッグタグ_敵兵 [dogtag:tnk_w00a_guard_ve_03] \
						[dogtag:tnk_w00a_guard_ea_03] [dogtag:tnk_w00a_guard_no_03] \
						[dogtag:tnk_w00a_guard_ha_03] [dogtag:tnk_w00a_guard_vh_03] \
					-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
					-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
					-w 警備兵スネーク発見

			}else if($w:ゲーム設定 == d:LEVEL_NORMAL){
				chara 警備兵 敵兵:03 -r d:３Ｆノーマル警戒 -n 1 -d -6500,6000,3000 甲板 \
					-s (d:ENE_STATUS_GUNLIGHT | d:ENE_STATUS_NIGHT_SIGHT) \
					-h 4000 \
					-i 6500,$w:敵危険視力,$w:敵回避視力 \
					-l $w:敵標準体力 \
					-f $w:敵標準気絶 \
					-j ドッグタグ_敵兵 [dogtag:tnk_w00a_guard_ve_03] \
						[dogtag:tnk_w00a_guard_ea_03] [dogtag:tnk_w00a_guard_no_03] \
						[dogtag:tnk_w00a_guard_ha_03] [dogtag:tnk_w00a_guard_vh_03] \
					-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
					-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
					-w 警備兵スネーク発見

			}else{
				chara 警備兵 敵兵:03 -r d:３Ｆイージー警戒 -n 1 -d -6500,6000,3000 甲板 \
					-s (d:ENE_STATUS_GUNLIGHT | d:ENE_STATUS_NIGHT_SIGHT) \
					-h 4000 \
					-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
					-l $w:敵標準体力 \
					-f $w:敵標準気絶 \
					-j ドッグタグ_敵兵 [dogtag:tnk_w00a_guard_ve_03] \
						[dogtag:tnk_w00a_guard_ea_03] [dogtag:tnk_w00a_guard_no_03] \
						[dogtag:tnk_w00a_guard_ha_03] [dogtag:tnk_w00a_guard_vh_03] \
					-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
					-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
					-w 警備兵スネーク発見

			}

		}else{
			print '敵兵ルート２'

			//左舷１Ｆ
			chara 警備兵 敵兵:01 -r d:左舷通常巡回 -n 2 -d 	0,0,12000 甲板 \
				-s (d:ENE_STATUS_GUNLIGHT | d:ENE_STATUS_NIGHT_SIGHT) \
				-h 4000 \
				-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
				-l $w:敵標準体力 \
				-f $w:敵標準気絶 \
				-j ドッグタグ_敵兵 [dogtag:tnk_w00a_guard_ve_01] \
					[dogtag:tnk_w00a_guard_ea_01] [dogtag:tnk_w00a_guard_no_01] \
					[dogtag:tnk_w00a_guard_ha_01] [dogtag:tnk_w00a_guard_vh_01] \
				-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
				-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３

			//右舷２Ｆ
			if($w:ゲーム設定 >= d:LEVEL_NORMAL){
				chara 警備兵 敵兵:02 -r d:右舷通常巡回 -n 1 -d 7000,6000,-4000 甲板 \
					-s (d:ENE_STATUS_GUNLIGHT | d:ENE_STATUS_NIGHT_SIGHT) \
					-h 4000 \
					-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
					-l $w:敵標準体力 \
					-f $w:敵標準気絶 \
					-j ドッグタグ_敵兵 [dogtag:tnk_w00a_guard_ve_02] \
						[dogtag:tnk_w00a_guard_ea_02] [dogtag:tnk_w00a_guard_no_02] \
						[dogtag:tnk_w00a_guard_ha_02] [dogtag:tnk_w00a_guard_vh_02] \
					-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
					-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３

			}else{
				chara 警備兵 敵兵:02 -r d:右舷長距離巡回 -n 4 -d 7000,6000,-4000 甲板 \
					-s (d:ENE_STATUS_GUNLIGHT | d:ENE_STATUS_NIGHT_SIGHT) \
					-h 4000 \
					-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
					-l $w:敵標準体力 \
					-f $w:敵標準気絶 \
					-j ドッグタグ_敵兵 [dogtag:tnk_w00a_guard_ve_02] \
						[dogtag:tnk_w00a_guard_ea_02] [dogtag:tnk_w00a_guard_no_02] \
						[dogtag:tnk_w00a_guard_ha_02] [dogtag:tnk_w00a_guard_vh_02] \
					-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
					-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３

			}

			//最後尾３Ｆ
			chara 警備兵 敵兵:03 -r d:３Ｆ全体巡回 -n 1 -d -6000,6000,7000 甲板 \
				-s (d:ENE_STATUS_GUNLIGHT | d:ENE_STATUS_NIGHT_SIGHT) \
				-h 4000 \
				-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
				-l $w:敵標準体力 \
				-f $w:敵標準気絶 \
					-j ドッグタグ_敵兵 [dogtag:tnk_w00a_guard_ve_03] \
					[dogtag:tnk_w00a_guard_ea_03] [dogtag:tnk_w00a_guard_no_03] \
					[dogtag:tnk_w00a_guard_ha_03] [dogtag:tnk_w00a_guard_vh_03] \
				-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
				-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３

		}

	}






	proc 警備兵コマンダー {
		chara 警備コマンダー wccomm -e { 警備兵０ }
	}


	proc 攻撃兵０{

		chara アタッカー 攻撃兵 \
			-r 5 \				//$b:初期ルート \
			-i	$w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
			-l	$w:敵標準体力 \
			-f	$w:敵標準気絶 \
			-s d:ENE_STATUS_GUNLIGHT \
			-c	9 \
			-q レーション_敵兵 25 \
			-e	0 				// $w:装備タイプ

//			-d $v:守備位置 $s:マップ \
//			-o $v:待避位置 \ /*守備位置に他の兵が近い時に使用*/
//			-q $p:プロック $b:確率 ...2
		// 装備タイプ	０標準 １盾 ２ライト付き盾




		trap ca003 d:PLAYER \
			-mask 入る \
			-exec {
				if( $4 > 0 ){
					print 'アタッカー左舷に移動'
					mesg アタッカー 攻撃兵 ルート変更 8
				}else{
					print 'アタッカー右舷に移動'
					mesg アタッカー 攻撃兵 ルート変更 5
				}
			}

	}

	proc 攻撃兵コマンダー{
		chara 攻撃コマンダー 攻撃コマンダー \
			-e { 攻撃兵０ } \
			-wait	(60*3) \	//危険開始時の出動遅らせ時間
			-avoidwait (60*5) \	//回避モードで始まる場合のみ有効
			-status	d:AT_COM_WARP
	}

	proc 甲板敵兵セット {
		print '甲板敵兵セット設定'


		chara コマンダー 敵兵セット \
			-w 警備兵コマンダー \
			-a 攻撃兵コマンダー \
			-r -18500,0,-17000 甲板 18500,0,-17000 甲板 \
			-c -8750,0,-2000 甲板 8750,0,-2000 甲板 0,6000,6500 甲板 0,0,8500 甲板 \
			-p 0,-1,-1 甲板クリアリング設定右舷 \ //$w:クリアリングエリア $w:ルート $w:ポイント $p:プロック ...4 \
				1,-1,-1 甲板クリアリング設定左舷 \
			-v [ene_tank_voice:01] \
			-x [ghq_area_alert_voice:w00a] \
			-y [ghq_caution_voice:w00a] \
			-m $w:スタートアラートモード \
			-z $i:敵標準麻酔持続 \
			-o $i:敵標準気絶持続 \
			-b $w:敵標準再発生数 \
			-h $i:標準警戒時間

		if($i:プレイヤー位置Ｘ > 0){
			print '待機所変更０'
			mesg コマンダー 敵兵セット 待機所替え \
				0

		}else{
			print '待機所変更１'
			mesg コマンダー 敵兵セット 待機所替え \
				1

		}




//以下は，甲板には傷の手当てをするところがないので、スネークの位置によって待機所を見えないところに変更する処理。
		trap ca000 d:PLAYER \
			-mask ？ \
			-exec {

				if($3 == 入る){
					print '敵兵ルート変更１'

					if($w:ゲーム設定 >= d:LEVEL_HARD){
						mesg 警備兵 敵兵:03 ルート変更 \
							d:３Ｆハード警戒 -6500 6000 7000 甲板 //$i:ルート番号 $i:守備位置Ｘ $i:守備位置Ｙ $i:守備位置Ｚ $s:マップ

					}else{
						mesg 警備兵 敵兵:03 ルート変更 \
							d:３Ｆノーマル警戒 -6500 6000 7000 甲板 //$i:ルート番号 $i:守備位置Ｘ $i:守備位置Ｙ $i:守備位置Ｚ $s:マップ

					}

					if($4 > 0){
						print '待機所変更０'
						mesg コマンダー 敵兵セット 待機所替え \
							0

					}else{
						print '待機所変更１'
						mesg コマンダー 敵兵セット 待機所替え \
							1

					}


				}else{
					print '敵兵ルート変更２'
					mesg 警備兵 敵兵:03 ルート変更 \
						d:３Ｆ全体巡回 -6500 6000 7000 甲板 //$i:ルート番号 $i:守備位置Ｘ $i:守備位置Ｙ $i:守備位置Ｚ $s:マップ

					print '待機所変更２'
					mesg コマンダー 敵兵セット 待機所替え \
						2

				}

			}


		trap ca009 d:PLAYER \
			-mask ？ \
			-exec {

				if($3 == 入る){
					if($4 > 0){
						print '待機所変更０'
						mesg コマンダー 敵兵セット 待機所替え \
							0

					}else{
						print '待機所変更１'
						mesg コマンダー 敵兵セット 待機所替え \
							1

					}

				}else{
					print '待機所変更３'
					mesg コマンダー 敵兵セット 待機所替え \
						3

				}

			}



	}



	proc 警備兵スネーク発見{

		eval($i:甲板発見敵兵Ｘ座標 = $1)
		eval($i:甲板発見敵兵Ｚ座標 = $3)

		if($f:甲板スネークを発見した == 0 && $4 == 5 && $f:甲板スネークca000にいる == 1 && $w:アラートモード == d:ALERT_MODE_SENNYU ){		//$4 == 5は、敵兵がプレイヤーに白ビックリという意味


			@甲板いろいろ登場

			chara デモキャンセルチェック デモキャンセル \
				-p 甲板敵兵発見カメラキャンセル発動

			@シナリオデモ開始処理



			eval($w:Ｘ変位 =  $i:プレイヤー位置Ｘ - $i:甲板発見敵兵Ｘ座標)
			eval($w:Ｚ変位 =  $i:プレイヤー位置Ｚ - $i:甲板発見敵兵Ｚ座標)
			eval($w:角度 = `%atan $w:Ｘ変位 $w:Ｚ変位` )

			print '角度は'($w:角度)

/*
			mesg プレイヤー d:PLAYER stance \
				$w:プレイヤー姿勢 \
				(3072 - $w:角度) \
				(3072 - $w:角度) \
				0
*/

			if( !`command	PlayerStatus -f d:TRP_STATE_ELUDE` ){
				mesg プットオブジェ ウィンドラス off
			}

			command カメラ上下振動スイッチ -w 0 -m off

			chara カメラ設定 サブカメラ３ \
				-c 1 \
				-p ($i:プレイヤー位置Ｘ + ( 1000 * `%cos $w:角度` / 4096 )), \
					1000, \
					($i:プレイヤー位置Ｚ + ( 1000 * `%sin $w:角度` / 4096 )) \
				-t $i:甲板発見敵兵Ｘ座標,6000,$i:甲板発見敵兵Ｚ座標 \
				-a 200 \
				-i 1 -1 0 0 \
				-s 1

//ぼかし変化
			mesg 遠景ぼかし far_blur off
			mesg 遠景ぼかし 敵兵発見遠景ぼかし on

			chara delay 敵兵スネークを発見した \
				-time 60 \
				-exec {

					chara カメラ設定 サブカメラ３ \
						-c 1 \
						-p ($i:プレイヤー位置Ｘ + ( 1000 * `%cos $w:角度` / 4096 )), \
							1000, \
							($i:プレイヤー位置Ｚ + ( 1000 * `%sin $w:角度` / 4096 )) \
						-t $i:甲板発見敵兵Ｘ座標,7000,$i:甲板発見敵兵Ｚ座標 \
						-a 400 \
						-i 2 -1 0 0 \
						-s 1

					mesg 遠景ぼかし 敵兵発見遠景ぼかし set 50 0 40000 80000

					chara delay 敵兵スネークを発見した \
						-time 50 \
						-exec {
							mesg 遠景ぼかし 敵兵発見遠景ぼかし off
						}

					mesg 近景ぼかし 敵兵発見近景ぼかし on

					chara delay 敵兵スネークを発見した \
						-time 1 \
						-exec {
							mesg 近景ぼかし 敵兵発見近景ぼかし set 80 0 1000 5000
						}

					chara delay 敵兵スネークを発見した \
						-time 90 \
						-exec {

							mesg 近景ぼかし 敵兵発見近景ぼかし off
							mesg 遠景ぼかし far_blur on
							mesg プットオブジェ ウィンドラス on

							chara カメラ設定 サブカメラ３ \
								-s -1

#if 1
							@発見敵兵追っかけカメラ

#else
							mesg レーダー レーダー on

							mesg シネマスクリーン シネマ フェードイン 0		//ゼロでデフォルト値
							command カメラ上下振動スイッチ -w 0 -m on

							command パッド操作 \
								-cancel

							eval($f:甲板スネークを発見した = 1)

#endif

						}

				}



		}


	}


	proc 発見敵兵追っかけカメラ{


		command ゲット敵兵座標 \
			敵兵:03 $i:発見敵兵Ｘ座標 $i:発見敵兵Ｙ座標 $i:発見敵兵Ｚ座標


		if($i:発見敵兵Ｘ座標 > 0){
			@パンカメラプロック \
				12509 13157 14535 \
				7200 8239 11139 \
				11985 11332 9345 \
				10135 10073 1666 \
				172 \	//画角
				300 \	//持続フレーム数
				0

		}else{
			@パンカメラプロック \
				-12509 13157 14535 \
				-7200 8239 11139 \
				-11985 11332 9345 \
				-10135 10073 1666 \
				172 \	//画角
				300 \	//持続フレーム数
				0

		}


		chara delay 敵兵スネークを発見した \
			-time 300 \
			-exec {
				@甲板敵兵発見カメラ終了処理
			}

	}






	proc 甲板敵兵発見カメラキャンセル発動{

		mesg delay 敵兵スネークを発見した kill

		mesg 遠景ぼかし 敵兵発見遠景ぼかし off
		mesg 近景ぼかし 敵兵発見近景ぼかし off
		mesg 遠景ぼかし far_blur on
		mesg プットオブジェ ウィンドラス on

		chara delay キャンセルディレイ -time 2 -exec {
			chara カメラ設定 サブカメラ３ \
				-s -1

			chara カメラ設定 パンカメラ \
				-s -1
		}

		@甲板敵兵発見カメラ終了処理


	}



	proc 甲板敵兵発見カメラ終了処理{

		@シナリオデモ終了処理

		command カメラ上下振動スイッチ -w 0 -m on

		mesg デモキャンセルチェック デモキャンセル kill

		eval($f:甲板スネークを発見した = 1)


	}




//###################################################################################
//									甲板クリアリング設定
//###################################################################################


	proc 甲板クリアリング設定右舷{

		print '右舷クリアリング開始'

		command セットクリアリング \
			-p -1,-1,-1 甲板クリアリングカメラ設定 \ //$w:クリアリングエリア $w:ルート $w:ポイント $p:プロック ...4 \
			-i 0


	}

	proc 甲板クリアリング設定左舷{

		print '左舷クリアリング開始'

		command セットクリアリング \
			-p -1,-1,-1 甲板クリアリングカメラ設定 \ //$w:クリアリングエリア $w:ルート $w:ポイント $p:プロック ...4 \
			-i 0


	}

	proc 甲板クリアリングカメラ設定{


	}


//###################################################################################
//									甲板死体遺棄設定
//###################################################################################

	proc 甲板死体遺棄設定{
		print '甲板死体遺棄設定'


		chara プットモーションモデル 左舷柵 \
			-pos 0,0,0 \				//$v:配置座標
			-dir 0 \					//$i:方向
			-kms w00a_crps_saku_l1 \	//$s:KMSモデル名
			-mar corpse_w00a \			//$s:モーションファイル名
			-number 3 \
			-status	0x28 				//$w:ステータス



		chara プットモーションモデル 右舷柵 \
			-pos 0,0,0 \				//$v:配置座標
			-dir 0 \					//$i:方向
			-kms w00a_crps_saku_r1 \	//$s:KMSモデル名
			-mar corpse_w00a \			//$s:モーションファイル名
			-number 5 \
			-status	0x28 				//$w:ステータス

				/*ステータスフラグ設定は以下のとおり
					(0x01) モーションの水平移動量を無視
					(0x02) 重力処理無し
					(0x04) 壁アタリ判定無し
					(0x08) メッセージ受信までモーション停止
					(0x20) モーション切り替え時に補完なし
				*/





//左舷死体遺棄

		trap dead000l d:PLAYER \
			-mask 入る \
			-state d:TRP_STATE_ENEMY_PULL \
			-exec {

				if (`@死体捨てチェック`) {

					eval($f:甲板死体遺棄中 = 1)
					eval($f:w00a_タンカー左舷で死体捨てた = 1)

					command 無線設定 -reset

					//スネーク死体捨て
					mesg プレイヤー d:PLAYER motion \
						d:モーションリスト:non_carry_body_throw1 \
						1024 \
						-1 \
						0 \
						(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_WEAPON) \
						-17000 -11000 //x,z,yの順


					mesg コマンダー 敵兵セット 引き釣られ兵消す
					command ゲット捕まえられ兵の名前 $i:敵兵モデル名


					//捨てられ敵兵
					/*指定された順にモーション再生後プロック呼んで消滅*/
					chara デモ人形 死体 \
						-pos (-17000 + 430 ),0,( -11000 - 69 ) \
						-dir 1024 \
						-code $i:敵兵モデル名 \
						-mar corpse_w00a \
						-list 0 \			//$i:再生順番 ... \ /*最大8個*/
						-end 死体消し	//$p:終了時プロック

				}

			}

/*
		スネークから兵士までの腰の座標（）
		Ｘ-148
		Ｙ-921
		Ｚ-814
*/


		trap ca020l d:PLAYER \
			-camera \
			-mask ？ \
			-state d:TRP_STATE_FORCE \
			-exec {

				if( $3 == 入る && $f:甲板死体遺棄中 == 1 ){

					command パッド操作 -release

					command 無線設定 -reset

					mesg 鏡面モデル管理 床面映り込み del スネーク

					mesg レーダー レーダー off

					mesg シネマスクリーン シネマ フェードアウト 0		//ゼロでデフォルト値

					chara カメラ設定 パンカメラ \
						-c 1 \
						-p -19766,4772,-12128 \
						-t -17406,1409,-11484 \
						-a 200 \
						-i 0 0 0 0 \
						-s 1

					mesg プットモーションモデル 左舷柵 終了判定  3


					chara delay ディレイ -time 60 -exec {


						chara カメラ設定 パンカメラ \
							-c 1 \
							-p -27900,-2291,-11461 \
							-t -23804,-1700,-10931 \
							-a 200 \
							-i 0 0 0 0 \
							-s 1


						chara カメラ設定 パンカメラ \
							-c 1 \
							-p -27900 2166 -9461 \
							-t -23804 107 -8931 \
							-a 120 \
							-z d:CAMERA_INTERP_CAMERA \ //補完カメラフラグを指定。
							-interp_time 180 \ //補完時間を指定
							-s 1

					}

				}else if( $3 == 出る && $f:甲板死体遺棄中 == 1 ){


					eval($f:甲板死体遺棄中 = 0)

					mesg プットモーションモデル 左舷柵 終了判定  2


					chara delay ディレイ -time 1 -exec {

						mesg 鏡面モデル管理 床面映り込み add スネーク

						mesg レーダー レーダー on

						mesg シネマスクリーン シネマ フェードイン 0		//ゼロでデフォルト値

						command パッド操作 -cancel

						chara カメラ設定 パンカメラ -s -1

					}

				}

			}


//右舷死体遺棄

		trap dead000r d:PLAYER \
			-mask 入る \
			-state d:TRP_STATE_ENEMY_PULL \
			-exec {

				if (`@死体捨てチェック`) {
					eval($f:甲板死体遺棄中 = 1)
					eval($f:w00a_タンカー右舷で死体捨てた = 1)

					command 無線設定 -reset

					//スネーク死体捨て
					mesg プレイヤー d:PLAYER motion \
						d:モーションリスト:non_carry_body_throw1 \
						3072 \
						-1 \
						0 \
						(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_WEAPON) \
						16500 -11000 //x,z,yの順


					mesg コマンダー 敵兵セット 引き釣られ兵消す
					command ゲット捕まえられ兵の名前 $i:敵兵モデル名


					//捨てられ敵兵
					/*指定された順にモーション再生後プロック呼んで消滅*/
					chara デモ人形 死体 \
						-pos (16500 - 430 ),0,( -11000 + 69 ) \
						-dir 3072 \
						-code $i:敵兵モデル名 \
						-mar corpse_w00a \
						-list 0 \			//$i:再生順番 ... \ /*最大8個*/
						-end 死体消し	//$p:終了時プロック

				}

			}

/*
		スネークから兵士までの腰の座標（）
		Ｘ-148
		Ｙ-921
		Ｚ-814
*/


		trap ca020r d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_FORCE \
			-exec {

				if( $3 == 入る && $f:甲板死体遺棄中 == 1 ){

					command 無線設定 -reset
					command パッド操作 -release

					mesg 鏡面モデル管理 床面映り込み del スネーク

					mesg レーダー レーダー off

					mesg シネマスクリーン シネマ フェードアウト 0		//ゼロでデフォルト値

					chara カメラ設定 パンカメラ \
						-c 1 \
						-p 19766,4772,-12128 \
						-t 17406,1409,-11484 \
						-a 200 \
						-i 0 0 0 0 \
						-s 1

					mesg プットモーションモデル 右舷柵 終了判定  5

					chara delay ディレイ -time 60 -exec {

						chara カメラ設定 パンカメラ \
							-c 1 \
							-p 27900,-2291,-11461 \
							-t 23804,-1700,-10931 \
							-a 200 \
							-i 0 0 0 0 \
							-s 1


						chara カメラ設定 パンカメラ \
							-c 1 \
							-p 27900 2166 -9461 \
							-t 23804 107 -8931 \
							-a 200 \
							-z d:CAMERA_INTERP_CAMERA \ //補完カメラフラグを指定。
							-interp_time 120 \ //補完時間を指定
							-s 1


					}

				}else if( $3 == 出る && $f:甲板死体遺棄中 == 1 ){


					eval($f:甲板死体遺棄中 = 0)

					mesg プットモーションモデル 右舷柵 終了判定  4


					chara delay ディレイ -time 1 -exec {

						mesg 鏡面モデル管理 床面映り込み add スネーク

						mesg レーダー レーダー on

						mesg シネマスクリーン シネマ フェードイン 0		//ゼロでデフォルト値

						command パッド操作 -cancel

						chara カメラ設定 パンカメラ -s -1

					}

				}

			}


	}


	proc 死体消し{
	}


//###################################################################################
//									甲板アイテム設定
//###################################################################################

	proc 甲板アイテム設定{

		print '甲板アイテム設定'

		if($w:ゲーム設定  <= d:LEVEL_HARD){
			@アイテム再セットチェック $b:w00a_取得ロード回数[0]
			if ($f:再セットフラグ) {
				@レーション_初期設置 レーション１ -18500 0 -17500 1
			}
		}

		@アイテム再セットチェック $b:w00a_取得ロード回数[1]
		if ($f:再セットフラグ) {
			@ジアゼパム_初期設置 ジアゼパム１ 18500 0 -17500 1
		}

		@アイテム再セットチェック $b:w00a_取得ロード回数[2]
		if ($f:再セットフラグ) {
			@チャフ_初期設置 チャフ１ 10000 2000 -500 1
		}

		@アイテム再セットチェック $b:w00a_取得ロード回数[3]
		if ($f:再セットフラグ) {
			@止血剤_初期設置 止血剤１ 16000 3000 -17000 1
		}


		if($w:ゲーム設定 >= d:LEVEL_HARD){
			@アイテム再セットチェック $b:w00a_取得ロード回数[4]
			if ($f:再セットフラグ) {
				@風邪薬_初期設置 風邪薬１ 0 6000 5500 0 3
			}
		}

		if($w:ゲーム設定  <= d:LEVEL_VERYEASY){
			@アイテム再セットチェック $b:w00a_取得ロード回数[6]
			if ($f:再セットフラグ) {
				@レーション_初期設置 レーション２ 5000 0 18750 1
			}
		}

		@アイテム再セットチェック $b:w00a_取得ロード回数[7]
		if ($f:再セットフラグ) {
			@止血剤_初期設置 止血剤２ -7750 0 4500 1
		}

	}

