							-count 30,300,30
							-alp $1 \
							-flag $2
					}

				//座標ＸＹ(0,0)<->(512,384)
				//サイズＷＨ(0,0)<->(512,384)
				//スケールｗｈ（１００００で１．０）なしだと１．０
				//カウントｘ　フェードインタイム
				//カウントｙ　ウェイト
