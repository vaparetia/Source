						eval( $i:補完ＰＸ = $4 )
						eval( $i:補完ＰＹ = 10872 )
						eval( $i:補完ＰＺ = 10648 )
						eval( $i:補完ＴＸ = $4 )
						eval( $i:補完ＴＹ = 2669 )
						eval( $i:補完ＴＺ = 6814 )


					}else{
						@CS_スムーズカメラ昇順 $4 5400 5900 5000 6119
						eval( $i:補完ＰＸ = $i:CS_結果１ )
						@CS_スムーズカメラ昇順 $4 5400 5900 10872 2160
						eval( $i:補完ＰＹ = $i:CS_結果１ )
