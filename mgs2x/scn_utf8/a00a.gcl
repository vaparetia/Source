//###################################################################################
//									電灯虫設定
//###################################################################################

	proc 電灯虫設定 {

		command foreach -argc 1 -repeat 2 \
			-data { \
				{1},{-1} \
			} \
			-exec{

				chara 電灯虫 羽虫 \
					-n	32 \
					-p	(8750 * $1) 2500 -5000 \	// ライト位置 ->> プレイヤー誘導時は無視
					-b	1 \	// 下のバウンディングボックスで壁との当たり見るか  1 : 判定あり, 0 : 判定なし
					-s	((8750 * $1) - 500) (2500-500) -5000 \	// 最小ボックス座標
					-l	((8750 * $1) + 500) (2500+500) -4500	// 最大ボックス座標

			}


	}





//###################################################################################
//									甲板高波設定
//###################################################################################

	proc 甲板高波設定{

#if d:WAVE
		print '甲板高波設定'

		chara 波面 wave \
			-p 0,-6000,0 \
			-s 128 \
			-n 3 \
			-w 5 5 \
			-b 	     0,200,  20500,6,    0,  0 \
				 18000,500,-255000,8, 1251,-50 \
				-18000,500,-245000,8,-1251,-50 \
			-x 0,-135500 20000,132500


		chara 嵐の川波 高波 \
			-tex wave wave06 wave09_alp_ovl \
			-dir 100,-20,100 \
			-color 160,160,160 \
			-ambient 10,10,10 \
			-pos 0,-3750,0

		trap dead100 ？ \
			-mask 入る \
			-exec{
				mesg 嵐の川波 高波 水しぶき発生 $2

				if($2 == d:PLAYER && `%ゲームオーバーチェック` == 0){

					command ゲームオーバー処理開始 \
						-exec {
							command プレイヤーモーション振動ＯＦＦ
							chara delay 水面落下ディレイ \
								-time 10 \
								-exec {
									chara パッド振動 落下振動 -vibfile drop_sea
								}

							if($w:体力 > 0){

								command メニュー設定 \
									-gage off \
									-radar off \
									-subwin off \
									-radio off \
									-pause off

								chara delay 水面落下ディレイ \
									-time 15 \
									-exec {
											print 'スネーク悲鳴'
											command セットサウンドコード -c d:se_code:SD_V_POBORE01	//ＳＥおぼれ悲鳴
									}

							}

							chara delay 水面落下ディレイ \
								-time 240 \
								-exec {
									command ゲームオーバー処理終了
								}
						}
				}
			}

#endif


	}



//###################################################################################
//									チェーン設定
//###################################################################################

	proc 甲板チェーン設置 {
		#if d:CHAIN
		print '甲板チェーン設定'

/*
			chara ローカル風 甲板風 \
				-n 3 \
				-d -5250,0,17000 5250,1000,18000 2048 128 10000 \
					-18000,0,-12000 -17000,1000,-10000 2048 128 500 \
					17000,0,-12000 18000,1000,-10000 2048 128 500
					// データの並び
					// ２点で立方体を表現（６つ）、
					// その立方体内の風方向（Ｙ軸のみ１つ）
					// 風方向ランダム幅（4096(=360度)）（全方向に加味される、１つ）
					// 風速MAX（１つ）
					// 以上９つの数字で一塊。
*/

			chara ロープモデル２ ウィンチドラム１ \
				-n w00a_chn_c1 \
				-x -4750,800,17200 \
				-d 0 \
				-p 1000

			chara ロープモデル２ ウィンチドラム２ \
				-n w00a_chn_c1 \
				-x -3250,800,17200 \
				-d 0 \
				-p 500

			chara ロープモデル２ ウィンチドラム３ \
				-n w00a_chn_c1 \
				-x 3250,800,17200 \
				-d 0 \
				-p 1000

			chara ロープモデル２ ウィンチドラム４ \
				-n w00a_chn_c1 \
				-x 4750,800,17200 \
				-d 0 \
				-p 500

		#endif
	}







//###################################################################################
//								甲板ウイング投光器設定
//###################################################################################



	proc 船橋ウイングオブジェ設定 {

		print '船橋ウイングオブジェ設定'


		if( $f:w00b_左舷投光器壊れた == 0){
			chara プットオブジェ 左舷投光器 -m w00_sl2 -r 0,0,0 -p 0,0,0 -l w00a
/*
			chara プット投光器オブジェ 投光器_左 \
				-m  w00_sl2 w00_sl2x \
				-n ブリッジ屋上 左舷投光器 \
				-l w00a \
				//-b 左投光器壊れ \
				-p 0,0,0
*/

			chara 固定ボリュームライト 左舷投光器 \
				-p -19670,13610,-14914 \
				-d 0,19000,-11000 \
				-n 32 \		// 16 (max=32)
				-l 15000 \	// 15000
				-w 3000		// 1000

		}else{
			chara プットオブジェ 壊れ投光器 -m w00_sl2x -r 0,0,0 -p 0,0,0 -l w00a
			command 光源消し -pos -20175 14499 -14989

		}

		if( $f:w00c_右投光器壊れフラグ == 0 ) {
			chara プットオブジェ 右舷投光器 -m w00_sl1 -r 0,0,0 -p 0,0,0 -l w00a
/*
			chara プット投光器オブジェ 投光器_右 \
				-m  w00_sl1 w00_sl1x \
				-n ブリッジ屋上 右舷投光器 \
				-l w00a \
				//-b 右投光器壊れ \
				-p 0,0,0
*/

			chara 固定ボリュームライト 右舷投光器 \
				-p 19670,13610,-14914 \
				-d 0,19000,-11000 \
				-n 32 \		// 16 (max=32)
				-l 15000 \	// 15000
				-w 3000		// 1000

		}else{
			chara プットオブジェ 壊れ投光器 -m w00_sl1x -r 0,0,0 -p 0,0,0 -l w00a
			command 光源消し -pos 20175 14499 -14989
		}





		chara プット頂点アニメオブジェ 旗         -m w00_vfg -b 5 -w 1 -p 0,0,0
		chara プット頂点アニメオブジェ ワイヤー１ -m w00_vw1 -b 5 -w 1 -p 0,0,0
		chara プット頂点アニメオブジェ ワイヤー２ -m w00_vw2 -b 5 -w 1 -p 0,0,0
		chara プット頂点アニメオブジェ ワイヤー３ -m w00_vw3 -b 5 -w 1 -p 0,0,0
		chara プット頂点アニメオブジェ ワイヤー４ -m w00_vw4 -b 5 -w 1 -p 0,0,0
		chara プット頂点アニメオブジェ ワイヤー５ -m w00_vw5 -b 5 -w 1 -p 0,0,0
		chara プット頂点アニメオブジェ ワイヤー６ -m w00_vw6 -b 5 -w 1 -p 0,0,0



		chara くるくる物体 radar \
			-k w00_radar \
			-p -1500 25600 -15400 \
			-r 32 \
			-s 1 \
			-d 2 200 200 48



		@船橋ウイングオブジェＯＦＦ


		trap ev000 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_SUBJECT,d:TRP_STATE_BEHIND \
			-exec {
				if($3 == 入る){
					@船橋ウイングオブジェＯＮ
				}else{
					@船橋ウイングオブジェＯＦＦ
				}
			}


		trap by002l d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_FORCE \
			-exec {
				if($3 == 入る){
					@船橋ウイングオブジェＯＮ
				}else{
					@船橋ウイングオブジェＯＦＦ
				}
			}




	}



	proc 船橋ウイングオブジェＯＮ {
		print '船橋ウイングオブジェＯＮ'
		mesg 固定ボリュームライト 右舷投光器 オン
		mesg 固定ボリュームライト 左舷投光器 オン
		mesg プット頂点アニメオブジェ 旗 表示
		mesg プット頂点アニメオブジェ ワイヤー１ 表示
		mesg プット頂点アニメオブジェ ワイヤー２ 表示
		mesg プット頂点アニメオブジェ ワイヤー３ 表示
		mesg プット頂点アニメオブジェ ワイヤー４ 表示
		mesg プット頂点アニメオブジェ ワイヤー５ 表示
		mesg プット頂点アニメオブジェ ワイヤー６ 表示
	}

	proc 船橋ウイングオブジェＯＦＦ {
		print '船橋ウイングオブジェＯＦＦ'
		mesg 固定ボリュームライト 右舷投光器 オフ
		mesg 固定ボリュームライト 左舷投光器 オフ
		mesg プット頂点アニメオブジェ 旗 非表示
		mesg プット頂点アニメオブジェ ワイヤー１ 非表示
		mesg プット頂点アニメオブジェ ワイヤー２ 非表示
		mesg プット頂点アニメオブジェ ワイヤー３ 非表示
		mesg プット頂点アニメオブジェ ワイヤー４ 非表示
		mesg プット頂点アニメオブジェ ワイヤー５ 非表示
		mesg プット頂点アニメオブジェ ワイヤー６ 非表示
	}



//###################################################################################
//									ロード設定
//###################################################################################

	proc テイルズ風邪引き判定 {
		print '$w:風邪状態'$w:風邪状態
		print '$i:ステージプレイ時間'$i:ステージプレイ時間
		
		if($w:風邪状態 == 0){
			if( $i:ステージプレイ時間 >= (60 * 30) ){
				print '風邪引きました'
				command プレイヤー風邪引かせ -time 100	//$i:くしゃみ間隔（秒）
			} else {
				print '風邪は引きませんでした'
			}
		}
	}
	// 入出トラップ
	// ------------------------------------
	proc ロードプロック {

#if d:FORCED_SNEEZE
		//@タンカー風邪引き判定	//stdproc.hの中
		if ( ( $b:ミッション番号 == d:MISSION:スネークテイルズ ) && \
			 ( $b:tales_story_no == d:TALES_NO:C ) ) {
			@テイルズ風邪引き判定
		}
#endif

		if ($s:呼び出しプロック == mv_a00a_a01a_0) {
			@mv_a00a_a01a_0
		} else if ($s:呼び出しプロック == mv_a00a_a01a_1) {
			@mv_a00a_a01a_1
		} else if ($s:呼び出しプロック == mv_a00a_a01b_2) {
			@mv_a00a_a01b_2
		} else if ($s:呼び出しプロック == mv_a00a_a01b_3) {
			@mv_a00a_a01b_3
		}
	}

	proc 左舷１Ｆロード $:トリガ $:実行キャラ {
		if ($:トリガ == 0) {		// 開いたとき

			chara カメラ設定 ロードカメラ \
				-c 1 \
				-p -11020,3899,-2710 \
				-t -8098,-233,-5785 \
				-a 200 \
				-i 0 2 0 0 \
				-s 1


			command 無線設定 -reset

			@ストーリーフラグ船内入ったへ
			preseek 'a01a'
			@ステージ終了時処理（ステージ名表示） \
					-8500 0 -6500 2048 \
					mv_a00a_a01a_0 \
					d:M_TYPE:RUN_CHANGE \
					d:wn_船橋一階居住区左舷


		}
	}

	proc 右舷１Ｆロード $:トリガ $:実行キャラ {
		if ($:トリガ == 0) {		// 開いたとき
			//chara カメラ設定 ビヨンドカメラ -s 1
			chara カメラ設定 ロードカメラ \
				-c 1 \
				-p 8779,2320,-2527 -t 8740,1861,-3869 \
				-r 215,2067,0 -f 1419 \
				-a 200 \
				-i 3 2 0 0 \
				-s 1

			@ストーリーフラグ船内入ったへ

			preseek 'a01a'
			@ステージ終了時処理（ステージ名表示） \
					8750 0 -6500 2048 \
					mv_a00a_a01a_1 \
					d:M_TYPE:RUN_CHANGE \
					d:wn_船橋一階居住区右舷
		}
	}

	proc 左舷２Ｆロード $:トリガ $:実行キャラ {
		if ($:トリガ == 0) {		// 開いたとき
			chara カメラ設定 ロードカメラ \
				-c 1 \
				-p -15638,5377,-5806 \
				-t -12666,4315,-10905 \
				-a 200 \
				-i 0 2 0 0 \
				-s 1

			chara カメラ設定 ビヨンドカメラ -s 1
			@ストーリーフラグ船内入ったへ

			preseek 'a01b'
			//@ステージ終了時処理 -11000 3000 -9750 1024 mv_a00a_a01b_2 d:M_TYPE:RUN_CHANGE
			@ステージ終了時処理（ステージ名表示） \
					-11000 3000 -9750 1024 \
					mv_a00a_a01b_2 \
					d:M_TYPE:RUN_CHANGE \
					d:wn_船橋二階居住区左舷

		}
	}

	proc 右舷２Ｆロード $:トリガ $:実行キャラ {
		if ($:トリガ == 0) {		// 開いたとき

			chara カメラ設定 ロードカメラ \
				-c 1 \
				-p 15638,5377,-5806 \
				-t 12666,4315,-10905 \
				-a 200 \
				-i 0 2 0 0 \
				-s 1

			command 無線設定 -reset

			@ストーリーフラグ船内入ったへ

			preseek 'a01b'
			@ステージ終了時処理（ステージ名表示） 11000 3000 -9750 3072 mv_a00a_a01b_3 d:M_TYPE:RUN_CHANGE d:wn_船橋二階居住区右舷


		}

	}


	proc ストーリーフラグ船内入ったへ{
		if($w:t_story == d:ST_T03b1Rカモフ登場後無線機デモ終了){
			print '$w:t_story = d:ST_船内入った'
			eval($w:t_story = d:ST_船内入った)
		}
	}


//###################################################################################
//									処理落ち対処
//###################################################################################


	proc 処理落ち対処{


		print '処理落ち対処設定'

		if( $i:プレイヤー初期Ｚ位置 > -5000 ){
				@甲板船首ＯＦＦ
		}


//左舷甲板４奥（屋根アリ）
		trap ca021l d:PLAYER \
			-mask 入る \
			-exec {
				@甲板船首ＯＮ
			}

//右舷甲板４奥（屋根アリ）
		trap ca021r d:PLAYER \
			-mask 入る \
			-exec {
				@甲板船首ＯＮ
			}


//左舷甲板４奥（屋根アリ）
		trap ca021l d:PLAYER \
			-mask 出る \
			-exec {
				@甲板船首ＯＦＦ
			}

//右舷甲板４奥（屋根アリ）
		trap ca021r d:PLAYER \
			-mask 出る \
			-exec {
				@甲板船首ＯＦＦ
			}





//２Ｆ階段西
		trap ca005l d:PLAYER \
			-mask 入る \
			-exec {
				@甲板船首ＯＮ
			}

//２Ｆ階段東
		trap ca005r d:PLAYER \
			-mask 入る \
			-exec {
				@甲板船首ＯＮ
			}


//甲板南部３＆階段
		trap ca002 d:PLAYER \
			-mask 入る \
			-exec {
				@甲板船首ＯＦＦ
			}







//３Ｆ縦通路
		trap ca008 d:PLAYER \
			-mask ？ \
			-exec {

				if( $3 == 入る ){
					@甲板船首ＯＦＦ

				}else if( $3 == 出る && $6 < 0 ){
					@甲板船首ＯＮ

				}

			}





//左舷死体遺棄場所
		trap ca020l d:PLAYER \
			-mask ？ \
			-exec {
				if( $3 == 入る ){
					@甲板船首ＯＮ

				}else if( $3 == 出る ){
					@甲板船首ＯＦＦ

				}
			}


//右舷死体遺棄場所
		trap ca020r d:PLAYER \
			-mask ？ \
			-exec {
				if( $3 == 入る ){
					@甲板船首ＯＮ

				}else if( $3 == 出る ){
					@甲板船首ＯＦＦ

				}
			}



#if d:CUT_OFF

#if 1
		eval($f:甲板いろいろ登場 = 0)	//初期化
		@甲板いろいろ登場
#else
		eval($f:甲板いろいろ登場 = 0)	//初期化

		if( $s:登場ポイント != タンカー編スタート){
			eval($f:甲板いろいろ登場 = 1)	//初期化
			@甲板いろいろ登場
		}
#endif


//甲板南部１（最後尾）
		trap ca000 d:PLAYER \
			-mask ？ \
			-exec {

				if( $3 == 入る ){
					print '床水飛沫＆波紋オン'
					mesg 床水飛沫 floor_splash オン
					mesg 波紋 ripple オン

				}else{
					print '床水飛沫＆波紋オフ'
					mesg 床水飛沫 floor_splash オフ
					mesg 波紋 ripple オフ

					@甲板いろいろ登場

				}

			}


//甲板南部１（最後尾）
		trap ca000 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_SUBJECT d:TRP_STATE_CAUTION \
			-exec {

				if( $3 == 入る ){
					mesg 落下水飛沫 splash_fall オン
					@甲板いろいろ登場

				}else{
					mesg 落下水飛沫 splash_fall オフ

				}

			}


//３Ｆ横通路
		trap ca009 d:PLAYER \
			-mask ？ \
			-exec {

				if( $3 == 入る ){
					print '床水飛沫＆波紋オン'
					mesg 床水飛沫 floor_splash オン
					mesg 波紋 ripple オン
					mesg 落下水飛沫 splash_fall オン
					@甲板いろいろ登場

				}else{
					print '床水飛沫＆波紋オフ'
					mesg 床水飛沫 floor_splash オフ
					mesg 波紋 ripple オフ

				}

			}


//３Ｆ縦通路（エルードのときに落下水飛沫を消さないように）
		trap ca008 d:PLAYER \
			-mask 入る \
			-exec {
					mesg 落下水飛沫 splash_fall オフ
			}

#endif

	}


