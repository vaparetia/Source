//=============================================================================
// メイン
//=============================================================================
// ＜↓↓↓同期↓↓↓＞
chara マップ ヘリポート -h d:HZX_NAME -l d:LT2_NAME

command マップ設定 ヘリポート -set {

//	デモ環境かゲーム環境かで起動を読み分ける。
// ------------------------------------
#if d:MGS2_DEMO

chara デモアクトデバッグ demodebug  -i t:p036_06_p05 -d 'p036_06_p05' -l  -s 'p036_06_p05'  \
		-p 映り込みゴルルコ兵オン 映り込みゴルルコ兵オフ
#else
// 実際の再生
//-----------------------------------------------------------
	// 実際のデモ再生の方も、ストーリーフラグで変える
	if(d:ST:P036_05_P04忍者登場５ポリゴンデモ４終了 <= $w:p_story && \
					$w:p_story < d:ST:P036_06_P05忍者登場６ポリゴンデモ５開始) {
		eval($w:p_story = d:ST:P036_06_P05忍者登場６ポリゴンデモ５開始)
		print '$w:p_story = ST:P036_06_P05忍者登場６ポリゴンデモ５開始'

		/* 中央棟中心と外周部の、兵士の服装・武器の違いを見せる */

		// デモ特有の変数代入
		eval($s:d_num = P036_06_p05)

		@デモモデル差し替え処理
		chara demo デモ再生 \
//			-i t:data_dummy_raiden \
			-i t:p036_06_p05 \
			-p 映り込みゴルルコ兵オン 映り込みゴルルコ兵オフ \
			-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
			-next P036_06_p05終了
	}

#endif


// 以下、諸々セット
//-----------------------------------------------------------
	@常駐キャラ設定						// stdch.hで定義

	chara デモキャンセルチェック デモキャンセル \
		-p demo_cancel

	//----- 基本設定
	@シネマスクリーンセット

	//----- ステージ
	@シェル１中央棟１Ｆエレベーターホール
	@シェル１中央棟１Ｆ
	@シェル１中央棟１Ｆエレベーター
	@監視カメラ設定
	//----- フォグ、カメラ、ロード
	@海面設置
	@空設置
	@フォグ設定
	@床面映り込みゴルルコ兵
}

command マップ表示 -show ヘリポート




//=============================================================================
// プロシージャ
//=============================================================================

//=============================================================================
// 基本設定
//=============================================================================
// デモ再生関連のプロック
//-----------------------------------------------------------
// これはデバッグ用
proc restart_proc {
	restart
}

proc null {}

proc demo_cancel {
	command StreamStopAll
}

proc P036_06_p05終了 {
	mesg デモキャンセルチェック デモキャンセル kill
	#if d:DEMO_SKIP_ENABLE
		print '$w:p_story = d:ST:P036_07_P06忍者登場７ポリゴンデモ６終了'
		eval($w:p_story = d:ST:P036_07_P06忍者登場７ポリゴンデモ６終了)
	#else
		print '$w:p_story = d:ST:P036_06_P05忍者登場６ポリゴンデモ５終了'
		eval($w:p_story = d:ST:P036_06_P05忍者登場６ポリゴンデモ５終了)
	#endif

	chara delay ディレイ \
		-time 1 \ 
		-exec{
				load 'd021p01'
//			#if d:P036_07_p06ここで再生
//				restart
//			#else
//				@mv_w24a_w24b_0
//			#endif
		}
}

proc シネマスクリーンセット  {
	chara シネマスクリーン シネマ \
		-top d:CINEMA_BELT_UPPER \
		-bottom d:CINEMA_BELT_LOWER \
		-ftime 60	//デフォルト値（ゼロは駄目）
	mesg シネマスクリーン シネマ フェードアウト 1
}



