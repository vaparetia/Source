	proc シェル１中央棟１Ｆエレベーター {
		@w24aの平行光環境光
		chara プットオブジェ elevator0 \
			-m d:KMS_ELEVATOR_NAME0 \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_W24A_NAME

		chara プットオブジェ elevator1 \
			-m d:KMS_ELEVATOR_NAME1 \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_W24A_NAME

		chara プットオブジェ elevator_door0 \
			-m d:KMS_ELEVATOR_DOOR0 \
			-r 0,-2048,0 \
			-p 0,0,-73250 \
			-s 100,100,100 \
			-l d:LT2_W24A_NAME

		chara プットオブジェ elevator_door1 \
			-m d:KMS_ELEVATOR_DOOR1 \
			-r 0,-2048,0 \
			-p 1250,0,-73250 \
			-s 100,100,100 \
			-l d:LT2_W24A_NAME
		@w20cの平行光環境光

		chara ドアランプ エレベーターランプ \
			-r 0 \
			-p 2000, 2250, -72750 // 階数表示部分の中央の座標
		mesg ドアランプ エレベーターランプ 黄
	}

//=============================================================================
// オブジェクト
//=============================================================================

//=============================================================================
// フォグ、カメラ、ロード
//=============================================================================
//-----------------------------------------------------------------------------
// 海面・空
	proc 海面設置 {
		@プラント海面セット 昼 w20b 1
	}

	proc 空設置 {
		@プラントステージでの汎用空セット 昼 w20b

		chara 太陽 ソル \
			-p 56500,-40000,-96250 \		//中心の位置
			-f -800 -4400 2100	//平行光源の -p と同じ値
	}

//-----------------------------------------------------------------------------
// フォグ設定
proc フォグ設定 {
	@プラントステージでのフォグセット 昼 0
//	chara フォグ 霧\
//		-c 220, 237, 198 \
//		-n -7000 \
//		-f 260000
}

proc 網膜センサー付近フォグ設定 {
	// フォグ
	//   -c ＲＧＢカラー  -n ＮＥＡＲ値  -f ＦＡＲ値
	chara フォグ 霧\
		-c 100, 35, 30 \
		-n 3000 \
		-f 33000
}

/***************************************************************************************************/
// 監視カメラの設定
/***************************************************************************************************/
	proc 監視カメラ設定 {
		#if d:DEBUG_PRINT
			print 'P036_96_p05.w20c_camera_set'
		#endif
		// 左通路

		@w24aの平行光環境光
		chara プットオブジェ svc_camera1 \
			-m d:KMS_SVC_DEMO_CAMERA \
			-r 0,3072,0 \
			-p -9125,3000,-55000 \
			-s 100,100,100 \
			-l d:LT2_W24A_NAME

		chara プットオブジェ svc_camera2 \
			-m d:KMS_SVC_DEMO_CAMERA \
			-r 0,1024,0 \
			-p 9250,3000,-49250 \
			-s 100,100,100 \
			-l d:LT2_W24A_NAME

		@w20cの平行光環境光
#if 0
		chara プラントカメラ カメラ:01 \
			-pos -9125 3000 -55000 \
			-rot 500 3072 0 \ /*ＸＹ値のみ有効*/
			-center 3072 0 \
			-dir 768 \
			-xran 256 \ 	// 省略可
			-yran 256 \ 	// 省略可
			-i 5000 \		// 省略可
			-status $w:ローカル変数Ｗ１

		// 右通路北3
		chara プラントカメラ カメラ:05 \
			-pos 9250 3000 -49250 \
			-rot 700 1024 0 \ 	// ＸＹ値のみ有効
			-center 768 768 \	// $i:振り中心角 $i:初期方向
			-dir 768 \
			-xran 256 \
			-yran 256 \
			-i 5000 \
			-status $w:ローカル変数Ｗ１
#endif

		// 変装チェック用カメラ
		//chara プットオブジェ 破壊不可能カメラ -m svc_unbreak -r 400,3548,0 -p 3000,2500,(-73000+50) -l w24a -s 100,100,100
		chara 非破壊カメラ 変装チェックカメラ \
			-pos 3000,2500,-73000 \
			-rot  0,0,0 \		/*ＸＹ値のみ有効*/
			-head 400,3548,0	/*ＸＹ値のみ有効*/
//		mesg 非破壊カメラ 変装チェックカメラ 緑点灯
	}


//-----------------------------------------------------------------------------
// サウンド
proc サウンドマネージャーセット {
	chara サウンドマネージャー ＳＤマネ -pak -1		// パックをロードしない
}
proc サウンドマネージャー_mesg_1 {
	mesg サウンドマネージャー ＳＤマネ SD_CODE d:SNG_PLAY_07
}
proc サウンドマネージャー_mesg_2 {
	mesg サウンドマネージャー ＳＤマネ SD_CODE d:SNG_FOUTS_S
}

proc w20cの平行光環境光 {
	chara 環境光 amb \
		 -c 24 44 32

	chara 平行光 para \
		 -c 150 150 146 \
		 -p -1620 -9000 4250	// 原点からこの位置に向かって光が射す
}

proc w24aの平行光環境光 {
	chara 環境光 amb \
		 -c 24 45 59

	chara 平行光 para \
		 -c 51 56 45 \
		 -p 0 -9800 -1960	// 原点からこの位置に向かって光が射す
}


// ゴルルコ兵床面映り込み
proc 床面映り込みゴルルコ兵 {
	chara 鏡面モデル管理 映り込みゴルルコ兵 \
		-pos 0,0,0 \ //
		-axis 1 // Y軸反転
}
proc 映り込みゴルルコ兵オン {
	mesg 鏡面モデル管理 映り込みゴルルコ兵 add gbs_def
}
proc 映り込みゴルルコ兵オフ {
	mesg 鏡面モデル管理 映り込みゴルルコ兵 del gbs_def
}


