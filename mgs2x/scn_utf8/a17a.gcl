//-p 8149,11382,895 -t 9573,1622,-751 \
			-b -10843,d:CAM_MIN,d:CAM_MIN 8149,d:CAM_MAX,d:CAM_MAX \
			-l -9419,d:CAM_MIN,d:CAM_MIN 9573,d:CAM_MAX,d:CAM_MAX \

			-r 881,1583,0 -f 10000 \
			-a 200 \
			-i 2 2 0 0 \
