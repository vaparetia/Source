command マップ設定 ＣＤ連絡橋 -set {
	@常駐キャラ設定
	@ローカル変数初期化
	@設定値変更
	@プラグイン設定
	@水位設定
	@A_プレイヤー設定 sna_a17a rai_a17a
#if d:ENEMY
	@敵配置チェック
#endif
}

// アナザー用でマップ設定後に設定する
// ------------------------------------
@アナザー用マップ定義後設定

command マップ設定 ＣＤ連絡橋 -set {
	@弾痕跳弾設定
// マップ切り替え、ロード、ドア
// ------------------------------------
#if d:SLIDE_DOOR
	@ドア設置
	@主観禁止壁設定
#endif
// ステージ、オブジェクト関連
// ------------------------------------
#if d:LOAD_TRAP
	@ロード設定
#endif
	@オブジェクト設定
#if d:SEA
	@海面設定
#endif
#if d:SKY
	@空設定
#endif
	@天井設定
# if d:PIT
	@落し穴配置チェック
	@落し穴設定
#endif

#if d:FOG
	@フォグ設定
#endif
#if d:EFFECT
//	@エフェクト設定
#endif
	@ＣＤ連絡橋風設定
#if d:BY_MOTION
	@ＣＤ連絡橋ビヨンド設定
#endif
	@カメラセット
	@ＣＤ連絡橋カメラ設定

	@エルード落下死設定
	@ジャンプ落下死設定

	@死体捨て設定

#if d:CHARA_LIGHT
	@キャラ用ライト設定
# endif

//	@プラント編全体マップ設定  d:ＣＤ連絡橋マップ	//	全体マップ表示

#if d:DEBUG_CHARA
	@デバッグキャラセット
#endif

}

//初期マップの表示
// -----------------------------------
command マップ表示 	-add ＣＤ連絡橋
@ＣＤ連絡橋開始時処理



//###################################################################################
//									各proc設定
//###################################################################################



//###################################################################################
//									全マップ共通
//###################################################################################

	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT 
			print 'localvar_init'
		#endif
		//	落とし穴上フラグを初期化
		eval ($f:w17a_落し穴１上フラグ = d:FALSE)
		eval ($f:w17a_落し穴２上フラグ = d:FALSE)
		eval ($f:w17a_落し穴３上フラグ = d:FALSE)
		eval ($f:w17a_落し穴４上フラグ = d:FALSE)
		eval ($f:w17a_落し穴５上フラグ = d:FALSE)

		//	監視カメラデモ中フラグを初期化
		eval ($f:w17a_監視カメラデモ中フラグ = d:FALSE)

//	インテグラル
#if 0
	//	日本語版
	#ifdef d:JAPANESE
		//	ベリーイージーでは常に落し穴復活
		if ($w:ゲーム設定 == d:LEVEL_VERYEASY) {
			eval ($f:w17a_落し穴１開いたフラグ = d:FALSE)
			eval ($f:w17a_落し穴２開いたフラグ = d:FALSE)
			eval ($f:w17a_落し穴３開いたフラグ = d:FALSE)
			eval ($f:w17a_落し穴４開いたフラグ = d:FALSE)
			eval ($f:w17a_落し穴５開いたフラグ = d:FALSE)
		}
	#endif
#endif
		//	側転中フラグを初期化
//		eval ($f:w17a_側転中１フラグ = d:FALSE)
//		eval ($f:w17a_側転中２フラグ = d:FALSE)
//		eval ($f:w17a_側転中３フラグ = d:FALSE)
//		eval ($f:w17a_側転中４フラグ = d:FALSE)
//		eval ($f:w17a_側転中５フラグ = d:FALSE)

/*
		ダンボール男の出現条件はＣ脚内で判定される
		出ないときは$f:w17a_ダンボール男フラグにTRUEが入る

		//	条件は仮
		if ($f:w17a_ダンボール男フラグ == d:FALSE) {
			//	Ｄ脚から来たときはすでにいない
			if ($s:登場ポイント == sp_w18a_w17a_0 ) {
				eval ($f:w17a_ダンボール男フラグ = d:TRUE)
			}
		}
*/
	}
	proc 設定値変更 {
		#if d:DEBUG_PRINT 
			print 'status_set'
		#endif
	}
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif

			command プラグイン落下
	}

	proc 弾痕跳弾設定 {
		command 弾痕ノーマル -n 0
		command 弾痕ノーマル -n 1
		command 弾痕ノーマル -n 3

		command 跳弾ノーマル -n 0
		command 跳弾ノーマル -n 1
		command 跳弾ノーマル -n 3

		//	水蒸気
		command 弾痕ノーマル -n 6
		command 跳弾水蒸気中 -n 6
	}

//###################################################################################
//								敵兵
//###################################################################################

	proc 敵配置チェック {
//		自分の来た場所で敵配置変更
		if( $s:登場ポイント == Ｃ脚から) {
			eval($f:w17a_敵配置フラグ = d:STRUT_C)
		} else if ($s:登場ポイント == Ｄ脚から) {
			eval($f:w17a_敵配置フラグ = d:STRUT_D)
		}
	}

//###################################################################################
//									 ドア＆マップ切り替え
//###################################################################################

	proc ドア設置 {
		#if d:DEBUG_PRINT
			print 'door_set'
		#endif

/*
		@ドアモデル名セット $:配列番号 \
			$:ドア名１				$:ドア名２				$:ドア名３ \
			$:ドア名４				$:ドア名５
			d:DOOR_FLAG_CLOSE 		d:DOOR_FLAG_OPEN		d:DOOR_FLAG_ENEMY_ONLY
			d:DOOR_FLAG_CLOSE_LEVEL	d:DOOR_FLAG_OPEN_LEVEL

		@A_ドア開閉追加設定 $:ドア名 $:フラグ $:ドア位置Ｘ $:ドア位置Ｙ $:ドア位置Ｚ $:ドア回転 $:ドアスライド幅
*/
		//	Ｃ脚ドア
		@ドアモデル名セット 0 d:DOOR_NAME_ALT d:DOOR_NAME_ALT d:DOOR_NAME_ALT d:DOOR_NAME0 d:DOOR_NAME0
		@A_ドア開閉追加設定 Ｃ脚ドア $$b:ドアフラグ[0] -16100 0 -5050 2769 d:SD_SLIDE_OUTSIDE2

		//	Ｄ脚ドア
		@ドアモデル名セット 1 d:DOOR_NAME1 d:DOOR_NAME1 d:DOOR_NAME1 d:DOOR_NAME1 d:DOOR_NAME1
		@A_ドア開閉追加設定 Ｄ脚ドア $$b:ドアフラグ[1] 16875 0 3750 1024 d:SD_SLIDE_OUTSIDE


		//	Ｃ脚ドア
		chara ドア Ｃ脚ドア \
			-m $$s:ドアモデル名[0] \
			-d 0 2769 0 \
			-p -16100,0,-5050 \
			-slide d:SD_SLIDE_OUTSIDE2 \
			-time d:SD_OPEN_TIME \
			-A Ｃ脚ドアランプ \
			-between ＣＤ連絡橋 ＣＤ連絡橋 \
			-r -17125 0 -4313 -16250 0 -4250 \	//	オルタナ用追加
			-exec {
				if( !($:開閉フラグ) ){
					mesg プットオブジェ Ｃ脚ロードエリア off
				}else{
					mesg プットオブジェ Ｃ脚ロードエリア on
				}
			}
		@ドアランプ設定 Ｃ脚ドアランプ 2770 -16100 0 -5050 1

		trap dr001 ？ -mask ？ \
			-exec {
				if ( $3 == 入る ) {
					mesg ドア Ｃ脚ドア open $2
				} else if( $3 == 出る ){
					mesg ドア Ｃ脚ドア close $2
				}
			}

		//	Ｄ脚ドア
		chara ドア Ｄ脚ドア \
			-m $$s:ドアモデル名[1] \
			-d 0 1024 0 \
			-p 16875,0,3750 \
			-slide d:SD_SLIDE_OUTSIDE \
			-time d:SD_OPEN_TIME \
			-between ＣＤ連絡橋 ＣＤ連絡橋 \
			-A Ｄ脚ドアランプ \
			-exec{
				if( !($:開閉フラグ) ){
					mesg プットオブジェ Ｄ脚ロードエリア off
				}else{
					mesg プットオブジェ Ｄ脚ロードエリア on
				}
			}
		@ドアランプ設定 Ｄ脚ドアランプ 1024 16875 0 3750 1
			
		trap dr002 ？ -mask ？ \
			-exec {
				if ( $3 == 入る ) {
					mesg ドア Ｄ脚ドア open $2
				} else if( $3 == 出る ){
					mesg ドア Ｄ脚ドア close $2
				}
			}
	}

	proc 主観禁止壁設定 {

		@主観禁止壁 Ｃ脚ドア壁 -16100 0 -5050 2769 d:SD_SLIDE_OUTSIDE2
		@主観禁止床 Ｃ脚ドア床１ Ｃ脚ドア床２ -16100 0 -5050 2769 d:SD_SLIDE_OUTSIDE2
		trap dr001 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_SUBJECT \
			-exec {
				if( $3 == 入る ) {
					mesg 透明壁 Ｃ脚ドア壁 on
				} else {
					mesg 透明壁 Ｃ脚ドア壁 off
				}
			}

		@主観禁止壁 Ｄ脚ドア壁 16875 0 3750 1024 d:SD_SLIDE_OUTSIDE
		@主観禁止床 Ｄ脚ドア床１ Ｄ脚ドア床２ 16875 0 3750 1024 d:SD_SLIDE_OUTSIDE
		trap dr002 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_SUBJECT \
			-exec {
				if( $3 == 入る ) {
					mesg 透明壁 Ｄ脚ドア壁 on
				} else {
					mesg 透明壁 Ｄ脚ドア壁 off
				}
			}



	
	}


//###################################################################################
//									開始時処理
//###################################################################################

	proc ＣＤ連絡橋開始時処理 {
		#if d:DEBUG_PRINT
			print 'start_set'
			print $s:登場ポイント Ｃ脚から Ｄ脚から ;
		#endif
		if ($s:登場ポイント == Ｃ脚から) {
			@ステージ開始時処理（ステージ名表示）\
			d:LOAD_TYPE:SL_DOOR_TYPE Ｃ脚ドア 2500 d:DEFAULT_M_TYPE d:wn_ＣＤ連絡橋
			@Ｃ脚ロード時カメラ設定
		} else if ($s:登場ポイント == Ｄ脚から) {
			@ステージ開始時処理（ステージ名表示）\
			d:LOAD_TYPE:SL_DOOR_TYPE Ｄ脚ドア 2000 d:DEFAULT_M_TYPE d:wn_ＣＤ連絡橋
			@Ｄ脚ロード時カメラ設定
		//	テイルズＥメイ・リン登場紙芝居後から
		} else if ($s:登場ポイント == テイルズＥメイ・リン登場紙芝居後から) {
			// 全てのセットが終わったところでフェードイン
			@ステージ開始時処理（ステージ名表示）\
			d:LOAD_TYPE:NO_MOVE_TYPE 紙芝居 0 d:DEFAULT_M_TYPE d:wn_ＣＤ連絡橋
		}
	}

//###################################################################################
//									ロード設定
//###################################################################################

	proc ロードプロック {
		if ($s:呼び出しプロック == mv_a17a_a16a_0) {
			//	Ｃ脚へ
			@mv_a17a_a16a_0
		} else if ($s:呼び出しプロック == mv_a17a_a18a_0) {
			//	Ｄ脚へ
			@mv_a17a_a18a_0
		} else if ($s:呼び出しプロック == load_tales_book) {
			// 紙芝居へ
			@load_tales_book
		}
	}
	proc ロード設定 {
		#if d:DEBUG_PRINT
			print 'load_set'
		#endif
		trap ld001 d:PLAYER \
			-mask いる \
			-exec {
				// Ｃ脚（w16a）へ
				@ポリトラップ $4 $6 -15750,-5500 -17000,-3000 ,-19250,-3000 -19250,-5500 ;
				if(( $i:ポリトラップ結果 >= 0 ) && ( $f:ロードチェックＯＮフラグ == 1 )){

#if 0
					//	テイルズＢのＢ脚ノードアクセス前はＣ脚の敵はいないのでＢＧＭフェードアウトする
					if (($b:ミッション番号 == d:MISSION:スネークテイルズ) && \
						($b:tales_story_no == d:TALES_NO:B) && \
						($b:tales_story_b == d:TALES_B:Ｂ脚ノードアクセス前)) {
						command セットサウンドコード -c d:SNG_FOUTS_S
					}
#endif
					//	テイルズＥのＣ脚到着前はこちらを通る
					if (($b:ミッション番号 == d:MISSION:スネークテイルズ) && \
						($b:tales_story_no == d:TALES_NO:E) && \
						($b:tales_story_e == d:TALES_E:Ｃ脚到着前)) {
						@ステージ終了時処理 \
						-17625 0 -4750 2769 load_tales_book d:DEFAULT_M_TYPE
						//	ロード時カメラ
						@Ｃ脚ロード時カメラ設定

					//	それ以外はＣ脚へ
					} else {

						@A_爆弾タイマー停止

						//	先読み
						preseek 'a16a'

						@ステージ終了時処理（ステージ名表示） \
						-17625 0 -4750 2769 mv_a17a_a16a_0 d:DEFAULT_M_TYPE \
						d:wn_Ｃ脚食堂
						//	ロード時カメラ
						@Ｃ脚ロード時カメラ設定
					}
				}
			}
		trap ld002 d:PLAYER \
			-mask いる \
			-exec {
				// Ｄ脚（w18a）上へ
				if( $f:ロードチェックＯＮフラグ == 1 ){
					//	テイルズＤのＥ脚戻る前はこちらを通る
					if (($b:ミッション番号 == d:MISSION:スネークテイルズ) && \
						($b:tales_story_no == d:TALES_NO:D) && \
						($b:tales_story_d == d:TALES_D:Ｄ脚到着前)) {
						@ステージ終了時処理 \
						17625 0 3000 1024 load_tales_book d:DEFAULT_M_TYPE
						//	ロード時カメラ
						@Ｄ脚ロード時カメラ設定

					//	それ以外はＤ脚へ
					} else {
						@A_爆弾タイマー停止

						//	先読み
						preseek 'a18a'

						@ステージ終了時処理（ステージ名表示） \
						17625 0 3000 1024 mv_a17a_a18a_0 d:DEFAULT_M_TYPE \
						d:wn_Ｄ脚第一沈殿池
						//	ロード時カメラ
						@Ｄ脚ロード時カメラ設定
					}
				}
			}
	}

	proc Ｃ脚ロード時カメラ設定 {
		chara カメラ設定 ロードカメラ \
						-c 1 \	
						-p -15259,4127,-822 \
						-t -15541,1562,-4150 \
						-a 200 \
						-i 0 1 0 0 \
						-s 1

		chara プロック連続実行 カメラ戻し管理人 \
			-proc カメラ戻し管理
	}
	proc Ｄ脚ロード時カメラ設定 {
		chara カメラ設定 ロードカメラ \
						-c 1 \
						-p 14357,3648,5492 -t 15913,2110,2549 \
						-a 200 \
						-i 0 1 0 0 \
						-s 1

		chara プロック連続実行 カメラ戻し管理人 \
			-proc カメラ戻し管理
	}

	proc カメラ戻し管理 {
		command パッドチェック \
			-no_use
		if ($status != 1) {
			chara カメラ設定 ロードカメラ \
				-s -1
			mesg プロック連続実行 カメラ戻し管理人 kill
		}
	}

//###################################################################################
//									オブジェクト
//###################################################################################

	proc オブジェクト設定 {
		chara プットオブジェ Ｄ脚ロードエリア \
			-m 	d:KMS_NAME8 -r 0 0 0 -p 0 0 0  -l d:LT2_NAME
		mesg プットオブジェ Ｄ脚ロードエリア off

		chara プットオブジェ Ｃ脚ロードエリア \
			-m 	d:KMS_NAME24 -r 0 0 0 -p 0 0 0  -l d:LT2_NAME
		mesg プットオブジェ Ｃ脚ロードエリア off
	}

	proc 水位設定 {
		command 水位設定 -lv -40000
	}

	proc 海面設定 {
		#if d:DEBUG_PRINT
			print 'w17a_sea_set'
		#endif

		chara プラント海面 seaseasea \
			-tex oil d_oil_sea_alp_ovl_mod0222 d_oil_ref_add_alp_ovl_mod1120 \
			-w 1,2,3 \
			-l \
			-pos 0,-40000,0

		chara 拡張海表示 sea_serface_ex \
			-tex d_oil_sea_alp_ovl_mod0222 \
			-pos 0,-40000,0 \
			-color 145 185 120			/*色合い調整 省略可*/

		chara 水面監視水飛沫 落下水飛沫 \
			-n d:PLAYER \
			-n 敵兵
		command 弾水飛沫処理
	}

	proc 空設定 {
		#if d:DEBUG_PRINT
			print 'w17a_sky_set'
		#endif

		@昼空（レンズフレア指定）	0 -40000 0 -2700 -3700 -2000 1

	}

	proc 天井設定 {
		#if d:DEBUG_PRINT
			print 'ceil_set'
		#endif
		chara 天井君 Ｃ脚天井 -m d:KMS_NAME9 -p 0,0,0  -l d:LT2_NAME -c -14000,0,0 -a 0
		chara 天井君 Ｄ脚天井 -m d:KMS_NAME10 -p 0,0,0  -l d:LT2_NAME -c 14000,0,0 -a 1
	
	}


	//	落し穴設定
	proc 落し穴配置チェック {
		//	アイテムと同じなので、アイテム再セットプロックをそのまま使用する

		@壊れ物再セットチェック $b:w17a_破壊ロード回数[0]
		if ($f:再セットフラグ) {
			eval ($f:w17a_落し穴１開いたフラグ = d:FALSE)
		}

		@壊れ物再セットチェック $b:w17a_破壊ロード回数[1]
		if ($f:再セットフラグ) {
			eval ($f:w17a_落し穴２開いたフラグ = d:FALSE)
		}

		@壊れ物再セットチェック $b:w17a_破壊ロード回数[2]
		if ($f:再セットフラグ) {
			eval ($f:w17a_落し穴３開いたフラグ = d:FALSE)
		}

		@壊れ物再セットチェック $b:w17a_破壊ロード回数[3]
		if ($f:再セットフラグ) {
			eval ($f:w17a_落し穴４開いたフラグ = d:FALSE)
		}

		@壊れ物再セットチェック $b:w17a_破壊ロード回数[4]
		if ($f:再セットフラグ) {
			eval ($f:w17a_落し穴５開いたフラグ = d:FALSE)
		}

	}

	proc 落し穴設定 {
		#if d:DEBUG_PRINT
			print 'w17a_pit_set'
		#endif	
	//	落ちてもセーフ
		//	１階
		if ($f:w17a_落し穴１開いたフラグ == d:FALSE) {
			chara 崩落床 落し穴１ \
				-position -6400,0,2000  \
				-rotate 0,0,0 \
				-map ＣＤ連絡橋 \
				-model w17a_trap_dr1 w17a_trap_dammy1 \
				-hazard -6875,0,1375 \
						-5875,0,1375 \
						-5875,0,2625 \
						-6875,0,2625 \
				-fall_time 30 \
				-fall_pattern 4 \
				-proc 落し穴落下設定１
		} else if ($f:w17a_落し穴１開いたフラグ == d:TRUE) {
			chara 崩落床 落し穴１ \
				-position -6400,0,2000  \
				-rotate 0,0,0 \
				-map ＣＤ連絡橋 \
				-model w17a_trap_dr1 w17a_trap_dammy1 \
				-hazard -6875,0,1375 \
						-5875,0,1375 \
						-5875,0,2625 \
						-6875,0,2625 \
				-fall_time 30 \
				-fall_pattern 4 \
				-status 1 \
				-proc 落し穴落下設定１
		}

	//	落ちるとアウト
		//	Ｂ１西側左
		if ($f:w17a_落し穴２開いたフラグ == d:FALSE) {
			chara 崩落床 落し穴２ \
				-position -2500,-3000,2000 \
				-rotate 0,0,0 \
				-map ＣＤ連絡橋 \
				-model w17a_trap_dr2 w17a_trap_dammy2 \
				-hazard -3000,-3000,1125 \
						-2000,-3000,1125 \
						-2000,-3000,2625 \
						-3000,-3000,2625 \
				-fall_time 30 \
				-fall_pattern 7 \
				-proc 落し穴落下設定２
		} else if ($f:w17a_落し穴２開いたフラグ == d:TRUE) {
			chara 崩落床 落し穴２ \
				-position -2500,-3000,2000 \
				-rotate 0,0,0 \
				-map ＣＤ連絡橋 \
				-model w17a_trap_dr2  w17a_trap_dammy2 \
				-hazard -3000,-3000,1125 \
						-2000,-3000,1125 \
						-2000,-3000,2625 \
						-3000,-3000,2625 \
				-fall_time 30 \
				-fall_pattern 7 \
				-status 1 \
				-proc 落し穴落下設定２
		}

		//	Ｂ１西側右
		if ($f:w17a_落し穴３開いたフラグ == d:FALSE) {
			chara 崩落床 落し穴３ \
				-position -1500,-3000,2000 \
				-rotate 0,0,0 \
				-map ＣＤ連絡橋 \
				-model w17a_trap_dr3  w17a_trap_dammy2 \
				-hazard -2000,-3000,1125 \
						-1000,-3000,1125 \
						-1000,-3000,2625 \
						-2000,-3000,2625 \
				-fall_time 30 \
				-fall_pattern 4 \
				-se_pattern 1 \
				-proc 落し穴落下設定３
		} else if ($f:w17a_落し穴３開いたフラグ == d:TRUE) {
			chara 崩落床 落し穴３ \
				-position -1500,-3000,2000 \
				-rotate 0,0,0 \
				-map ＣＤ連絡橋 \
				-model w17a_trap_dr3 w17a_trap_dammy2 \
				-hazard -2000,-3000,1125 \
						-1000,-3000,1125 \
						-1000,-3000,2625 \
						-2000,-3000,2625 \
				-fall_time 30 \
				-fall_pattern 4 \
				-se_pattern 1 \
				-status 1 \
				-proc 落し穴落下設定３
		}


		//	Ｂ１東側左
		if ($f:w17a_落し穴４開いたフラグ == d:FALSE) {
			chara 崩落床 落し穴４ \
				-position 3500,-3000,2000 \
				-rotate 0 0 0 \
				-map ＣＤ連絡橋 \
				-model w17a_trap_dr2  w17a_trap_dammy2 \
				-hazard 3000,-3000,1125 \
						4000,-3000,1125 \
						4000,-3000,2625 \
						3000,-3000,2625 \
				-fall_time 30 \
				-fall_pattern 7 \
				-proc 落し穴落下設定４
		} else if ($f:w17a_落し穴４開いたフラグ == d:TRUE) {
			chara 崩落床 落し穴４ \
				-position 3500,-3000,2000 \
				-rotate 0 0 0 \
				-map ＣＤ連絡橋 \
				-model w17a_trap_dr2  w17a_trap_dammy2 \
				-hazard 3000,-3000,1125 \
						4000,-3000,1125 \
						4000,-3000,2625 \
						3000,-3000,2625 \
				-fall_time 30 \
				-fall_pattern 7 \
				-status 1 \
				-proc 落し穴落下設定４
		}


		//	Ｂ１東側右
		if ($f:w17a_落し穴５開いたフラグ == d:FALSE) {
			chara 崩落床 落し穴５ \
				-position 4500,-3000,2000 \
				-rotate 0,0,0 \
				-map ＣＤ連絡橋 \
				-model w17a_trap_dr4  w17a_trap_dammy2 \
