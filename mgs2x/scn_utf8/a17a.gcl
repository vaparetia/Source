					-s $3 \

		}


		//	通路
		trap ca003 d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {

				//	高さ１３０以上のとき
				if ($5 > 130) {
					//	プレイヤーのＸ座標に沿ってＸロットが変化
					@CS_スムーズカメラ昇順 $4  -12000 12000 650 450
				//	高さ１３０以下のとき
				} else if ($5 > -1600) {

					//	高さ１３０のときのＸロットを求める。
					@CS_スムーズカメラ昇順 $4  -12000 12000 650 450
					//	プレイヤーのＸ座標に沿って変化するＸロットを別の変数に代入
					eval ($i:現状ＲＸ１ = $i:CS_結果１);

					//	高さ－１６００のときのＸロットを求める。
					@CS_スムーズカメラ昇順 $4  -12000 12000 180 100
					//	求めたＸロットを別の変数に代入。このＸロットからスムーズにつながる
					eval ($i:現状ＲＸ２ = $i:CS_結果１);

					//	求めた変数からプレイヤーのＹ座標に沿ってＸロットが変化
					@CS_スムーズカメラ降順 $5  -600 -1600 $i:現状ＲＸ１ $i:現状ＲＸ２

				} else {
					@CS_スムーズカメラ昇順 $4  -12000 12000 180 100
				}

				//	最終的に求めたＸロットを代入
				eval( $i:補完ＲＸ = $i:CS_結果１ );


				@CS_スムーズカメラ降順 $5  -600 -1500 -13000 -15470
//				@CS_スムーズカメラ降順 $5  -600 -1500 -13000 -14113
				eval( $i:補完ＢＸ = $i:CS_結果１ );

				@CS_スムーズカメラ降順 $5  -600 -1500 -8775 -7371
				eval( $i:補完ＬＸ = $i:CS_結果１ );



				if ($5 > 130) {
					@CS_スムーズカメラ昇順 $4  -12000 12000 10393 8158
				} else if ($5 > -1600) {
					@CS_スムーズカメラ昇順 $4  -12000 12000 10393 8158
					eval ($i:現状ＢＹ１ = $i:CS_結果１);
					@CS_スムーズカメラ昇順 $4  -8000 8000 1273 658
					eval ($i:現状ＢＹ２= $i:CS_結果１);
					@CS_スムーズカメラ降順 $5  -600 -1600 $i:現状ＢＹ１ $i:現状ＢＹ２
				} else {
					@CS_スムーズカメラ昇順 $4  -8000 8000 1273 658
				}
				eval( $i:補完ＢＹ = $i:CS_結果１ );

				if ($5 > 130) {
					@CS_スムーズカメラ昇順 $4  -12000 12000 1154 1154
				} else if ($5 > -1600) {
					@CS_スムーズカメラ昇順 $4  -12000 12000 1154 1154
					eval ($i:現状ＬＹ１ = $i:CS_結果１);
					@CS_スムーズカメラ昇順 $4  -8000 8000 -1498 -1535
					eval ($i:現状ＬＹ２= $i:CS_結果１);
					@CS_スムーズカメラ降順 $5  -600 -1600 $i:現状ＬＹ１ $i:現状ＬＹ２
				} else {
					@CS_スムーズカメラ昇順 $4  -8000 8000 -1498 -1535
				}
				eval( $i:補完ＬＹ = $i:CS_結果１ );

				

# if 0
				chara カメラ設定 通路カメラ \
					-c 0 \
					-b $i:補完ＢＸ,d:CAM_MIN,d:CAM_MIN 3000,10500,d:CAM_MAX \
					-l $i:補完ＬＸ,d:CAM_MIN,d:CAM_MIN 7897,1154,d:CAM_MAX \
					-r $i:補完ＲＸ,1600,0 -f 11000 \
					-a 200 \
