					eval( $i:補完ＴＸ = $i:CS_結果１ );

					@CS_スムーズカメラ降順 $6  -1000 -3000 2158 2156
					eval( $i:補完ＴＹ = $i:CS_結果１ );

					@CS_スムーズカメラ降順 $6  -1000 -3000 -1371 -2768
					eval( $i:補完ＴＺ = $i:CS_結果１ );
			} else {

					@CS_スムーズカメラ降順 $6  1000 -1000 -15440 -16051
					eval( $i:補完ＰＸ = $i:CS_結果１ );

					@CS_スムーズカメラ降順 $6  1000 -1000 4934 5116
					eval( $i:補完ＰＹ = $i:CS_結果１ );

					@CS_スムーズカメラ降順 $6  1000 -1000 977 229
					eval( $i:補完ＰＺ = $i:CS_結果１ );


					@CS_スムーズカメラ降順 $6  1000 -1000 -15259 -14738
					eval( $i:補完ＴＸ = $i:CS_結果１ );

					@CS_スムーズカメラ降順 $6  1000 -1000 1368 2158
					eval( $i:補完ＴＹ = $i:CS_結果１ );

					@CS_スムーズカメラ降順 $6  1000 -1000 757 -1371
					eval( $i:補完ＴＺ = $i:CS_結果１ );
			}
		
				chara カメラ設定 小部屋カメラ \
					-c 1 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \

					-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ \
					-t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ \
					-a 200 \
					-i 0 -1 0 0 \
					-d 1 \
					-s $3
		}
#endif

		//	Ｃ脚ドア付近
		trap ca001 d:PLAYER \
