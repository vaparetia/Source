						eval ($b:w17a_破壊ロード回数[3] = $w:グローバルロード回数)
						eval ($f:w17a_落し穴４開いたフラグ = d:TRUE)
						mesg 崩落床 落し穴４ fall
					}
				}
			}

		//	Ｂ１東側右
		trap pi005 d:PLAYER \
			-mask ＊ \
			-exec {
				if ($3 == いる) {
					//	落し穴上にいるときは落し穴上フラグを立てる
					eval( $f:w17a_落し穴５上フラグ = d:TRUE)
