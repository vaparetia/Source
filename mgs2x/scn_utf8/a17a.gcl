//-p -15383,5596,681 -t -15335,-314,450 \

					@CS_スムーズカメラ昇順 $6  -3000 1000 -15891 -15383
					eval( $i:補完ＰＸ = $i:CS_結果１ );

					@CS_スムーズカメラ昇順 $6  -3000 1000 4202 5596
					eval( $i:補完ＰＹ = $i:CS_結果１ );

					@CS_スムーズカメラ昇順 $6  -3000 1000 3155 681
