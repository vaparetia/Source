						5000,-3000,1125 \
						5000,-3000,2625 \
						4000,-3000,2625 \
				-fall_time 30 \
				-fall_pattern 4 \
				-se_pattern 1 \
				-proc 落し穴落下設定５
		} else if ($f:w17a_落し穴５開いたフラグ == d:TRUE) {
			chara 崩落床 落し穴５ \
				-position 4500,-3000,2000 \
				-rotate 0,0,0 \
				-map ＣＤ連絡橋 \
				-model w17a_trap_dr4  w17a_trap_dammy2 \
				-hazard 4000,-3000,1125 \
						5000,-3000,1125 \
						5000,-3000,2625 \
						4000,-3000,2625 \
				-fall_time 30 \
				-fall_pattern 4 \
				-se_pattern 1 \
				-status 1 \
				-proc 落し穴落下設定５
		}

	//	落とし穴上存在判定
		//	１階
		trap pi001 d:PLAYER \
			-mask ＊ \
			-exec {
				if ($3 == いる) {
					//	落し穴上にいるときは落し穴上フラグを立てる
					eval( $f:w17a_落し穴１上フラグ = d:TRUE)
				} else if($3 == 出る) {
		#if d:DEBUG_PRINT
					print 'EXIT'
		#endif
					//	落し穴上から出るときは落し穴上フラグをおろす
					eval( $f:w17a_落し穴１上フラグ = d:FALSE)

					//	床の状態を取得
					command 崩落床状態取得 \
					-name 落し穴１
					//	床を踏んでいたら床を落とす
					if ( $status == 1) {
						#if d:DEBUG_PRINT
						print 'FLAG_A'
						#endif
						eval ($b:w17a_破壊ロード回数[0] = $w:グローバルロード回数)
						eval ($f:w17a_落し穴１開いたフラグ = d:TRUE)
						mesg 崩落床 落し穴１ fall
					}
				}
			}

		//	Ｂ１西側左
		trap pi002 d:PLAYER \
			-mask ＊ \
			-exec {
				if ($3 == いる) {
					//	落し穴上にいるときは落し穴上フラグを立てる
					eval ($f:w17a_落し穴２上フラグ = d:TRUE)
				} else if ($3 == 出る) {
		#if d:DEBUG_PRINT
					print 'EXIT2'
		#endif
					//	落し穴上から出るときは落し穴上フラグをおろす
					eval( $f:w17a_落し穴２上フラグ = d:FALSE)

					//	床の状態を取得
					command 崩落床状態取得 \
					-name 落し穴２
					//	床を踏んでいたら床を落とす
					if ( $status == 1) {
						eval ($b:w17a_破壊ロード回数[1] = $w:グローバルロード回数)
						eval ($f:w17a_落し穴２開いたフラグ = d:TRUE)
						mesg 崩落床 落し穴２ fall
					}
				}
			}

		//	Ｂ１西側右
		trap pi003 d:PLAYER \
			-mask ＊ \
			-exec {
				if ($3 == いる) {
					//	落し穴上にいるときは落し穴上フラグを立てる
					eval( $f:w17a_落し穴３上フラグ = d:TRUE)
				} else if ($3 == 出る) {
		#if d:DEBUG_PRINT
					print 'EXIT3'
		#endif
					//	落し穴上から出るときは落し穴上フラグをおろす
					eval( $f:w17a_落し穴３上フラグ = d:FALSE)

					//	床の状態を取得
					command 崩落床状態取得 \
					-name 落し穴３
					//	床を踏んでいたら床を落とす
					if ( $status == 1) {
						eval ($b:w17a_破壊ロード回数[2] = $w:グローバルロード回数)
						eval ($f:w17a_落し穴３開いたフラグ = d:TRUE)
						mesg 崩落床 落し穴３ fall
					}
				}
			}

		//	Ｂ１東側左
		trap pi004 d:PLAYER \
			-mask ＊ \
			-exec {
				if ($3 == いる) {
					//	落し穴上にいるときは落し穴上フラグを立てる
					eval( $f:w17a_落し穴４上フラグ = d:TRUE)
				} else if ($3 == 出る) {
