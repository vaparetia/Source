			}

	}



	//	落し穴落下セーフ
	//	１階
	proc 落し穴落下設定１ {
		#if d:DEBUG_PRINT
		print 'PI_3'
		#endif
		if ($f:w17a_落し穴１上フラグ == d:TRUE) {
		#if d:DEBUG_PRINT
		print 'PI_4'
		#endif
		#if d:DEBUG_PRINT
		print '$f:w17a_落し穴１開いたフラグ'$f:w17a_落し穴１開いたフラグ
		#endif
			mesg プレイヤー d:PLAYER position -6400,$i:プレイヤー位置Ｙ,2000

			//	初めて落ちたとき
			if ($f:w17a_落し穴１叫びフラグ == d:FALSE) {
				eval ($f:w17a_落し穴１叫びフラグ = d:TRUE)
				mesg プレイヤー d:PLAYER fall \
					d:モーションリスト:non_elude_fall_start \
					d:モーションリスト:non_elude_fall \
					d:モーションリスト:non_elude_fall_normal \
					-3000 \
					0x0005 \
					落下セーフ開始処理 \
					落下セーフ終了処理

			//	それ以外の場合
			} else {
				mesg プレイヤー d:PLAYER fall \
					d:モーションリスト:non_elude_fall_start \
					d:モーションリスト:non_elude_fall \
					d:モーションリスト:non_elude_fall_normal \
					-3000 \
					(0x0005 | 0x0008) \
					落下セーフ開始処理 \
					落下セーフ終了処理
			}
			//	落し穴開いたフラグが立っていないときは立てる
			if ($f:w17a_落し穴１開いたフラグ == d:FALSE) {
				#if d:DEBUG_PRINT
				print 'FLAG_B'
				#endif
				eval ($b:w17a_破壊ロード回数[0] = $w:グローバルロード回数)
				eval ($f:w17a_落し穴１開いたフラグ = d:TRUE)
			}
		}
	}

	proc 落下セーフ開始処理 {
		chara カメラ設定 シナリオカメラ \
				-c 1 \
				-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
				-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
				-p -9506,-1480,8628 \
				-t -6498,-2320,2219 \
				-a 200 \
				-i 0 -1 0 0 \
				-s 1

	}

	proc 落下セーフ終了処理 {
		//	カメラを戻す
		chara delay シナリオカメラディレイ \
			-t 10 \
			-e {
				chara カメラ設定 シナリオカメラ \
					-s -1
			}
	}

	//	落し穴落下アウト
	//	Ｂ１西側左
	proc 落し穴落下設定２ {
		#if d:DEBUG_PRINT
		print 'PIT2'
		print '$f:w17a_落し穴２上フラグ' $f:w17a_落し穴２上フラグ
		#endif
		if ($f:w17a_落し穴２上フラグ == d:TRUE) {
		#if d:DEBUG_PRINT
		print 'FALL2'
		#endif
			mesg プレイヤー d:PLAYER position -2500,$i:プレイヤー位置Ｙ,2000
			@ジャンプ落下死発動 0x0004 -41000
		}
	}
