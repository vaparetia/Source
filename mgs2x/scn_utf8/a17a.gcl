	proc フォグ設定 {
		#if d:DEBUG_PRINT
			print 'fog_set'
		#endif

		@明るさ可変機能 220 237 198 -25000 250000 ha002 -3000

	}

	proc エフェクト設定 {
		#if d:DEBUG_PRINT
			print 'effect_set'
		#endif

//		chara ブラー okajibura 
//		chara Ｚフォーカス管理 Z_manager -z 5000 10000 -t 30
//		mesg Ｚフォーカス管理 Z_manager パラメータ３ \
//			1000 \
//			6000 \
//			30

/*
		chara 近景ぼかし near_deforcus \
			-plane	3 \
			-near	0 \
			-far	3000 
		chara 遠景ぼかし far_blur \
			-plane 2 \
			-near 50000 \
			-far 100000 \
			-enable
		@プレイヤー振動設定 sna_w00a
*/
	}

	proc キャラ用ライト設定 {
		chara 環境光 Amb \
			-c 55 63 38

		chara 平行光 Para \
			-c 163 164 150 \
			-p -2700 -3700 -2000
	}

	proc ＣＤ連絡橋風設定 {
		@風設定 ca003
	}

//###################################################################################
//									カメラ
//###################################################################################

	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif

			chara カメラ ステージカメラ	-c 0 -l 3 -p 0
			chara カメラ 通路カメラ		-c 0 -l 2 -p 50 
			chara カメラ 小部屋カメラ	-c 0 -l 2 -p 40 
			chara カメラ ビヨンドカメラ	-c 0 -l 2 -p 20 
			chara カメラ 張り付きカメラ	-c 0 -l 2 -p 10 
			chara カメラ シナリオカメラ	-c 0 -l 2 -p 6
			chara カメラ ロードカメラ		-c 0 -l 1 -p 5
			chara カメラ ゲームオーバーカメラ	c 0 -l 1 -p 4

			chara カメラ シナリオカメラ２	-c 0 -l 1 -p 3

			// デフォルトカメラ
			chara カメラ設定 ステージカメラ \
					-c 0 \
					-b -14656,6768,5080 14501,7079,7010  \
					-l -6843 1027 246   6688,1339,1876 \
					-r 359,1403,0 -f 10970 \
					-a 200 \
					-d 1 \
					-i 0 0 0 0 \
					-s 1
	}

	proc ＣＤ連絡橋カメラ設定 {
		#if d:DEBUG_PRINT
			print 'camera_set'
		#endif
#if 0
		//	Ｃ脚ドア付近
		trap ca001 d:PLAYER \
			-camera \
			-mask ＊ \
			-exec {
/*
				//	カメラ垂直
				chara カメラ設定 小部屋カメラ \
					-c 0 \
					-b -15626,d:CAM_MIN,d:CAM_MIN -15400,4671,1100 \
					-l -15626,d:CAM_MIN,-2573 -15400,d:CAM_MAX,1001 \
					-r 325,2048,0 -f 7000 \
					-a 200 \
					-i 0 -1 0 0 \
					-d 1 \
					-s $3 
*/
			if ($6 < -1000) {
					@CS_スムーズカメラ降順 $6  -1000 -3000 -16051 -16410 
					eval( $i:補完ＰＸ = $i:CS_結果１ );

					@CS_スムーズカメラ降順 $6  -1000 -3000 5116 4889
