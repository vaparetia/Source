		-i 0 -1 0 0 \
		-s 1
	chara delay ディレイ人生 -time 120 -exec {
		chara カメラ設定 オルガカットカメラ人生 -s -1

		mesg ボスオルガ オルガ 回避有効
		@シネマスクリーン終了
		@レーダー画面表示
		command パッド操作 -cancel
	}
}

proc オルガ表情セット {
#if d:rinji_kao_anime
	chara 臨時顔アニメキャラ オルガアニメ \
		-chara オルガ
#else
	chara 顔アニメキャラ オルガアニメ \
		-fanim	org_rmt \
		-chara	オルガ

// マルチウェイトエンベロープモデル顔アニメキャラ
// メッセージによりコントロールする（時間は全て1/300秒単位）
// ＜視線変更コマンド捕捉＞
//  $w:タイプ = -1 視線はモーションに依存（補間時間、注目座標の指定は必要なし）
//            =  0 絶対座標による注目座標指定
//            =  1 頭部モデルからの相対座標による注目座標指定
//            =  2 カメラ目線（注目座標の指定は必要なし）
//
#endif
}

proc ボスオルガセット {


		// -hオプション時は、オルガ全部表情つけるか？
		// ぼかしも入れるとか。

		/*
		if($w:ゲーム設定 <= d:LEVEL_EASY){
			eval( $w:ローカル変数Ｗ１ = 5 );
			eval( $w:ローカル変数Ｗ２ = 11 );
		}else if($w:ゲーム設定 == d:LEVEL_NORMAL){
			eval( $w:ローカル変数Ｗ１ = 8 );
			eval( $w:ローカル変数Ｗ２ = 14 );
		}else if($w:ゲーム設定 == d:LEVEL_HARD){
			eval( $w:ローカル変数Ｗ１ = 15 );
			eval( $w:ローカル変数Ｗ２ = 25 );
		}else{
			eval( $w:ローカル変数Ｗ１ = 30 );
			eval( $w:ローカル変数Ｗ２ = 50 );
		}
		*/
		eval( $w:ローカル変数Ｗ１ = 45 );
		eval( $w:ローカル変数Ｗ２ = 50 );

		chara ボスオルガ オルガ \
			-e mrl_def_mh_mt \
			-m mrl_def_sh_mt \
			-a orga \
			-p -18800,13000,-19300 \
			-d 0,2048,0 \
			-s 0 \
//			-v t:vc060101 t:vc060102 t:vc060103 t:vc060104 t:vc060105 t:vc060106 \
			-h オルガホロ撃ち時 \
			   オルガ死に時 \
			   オルガグレネードなげ時 \
			   オルガめくら撃ち_乱射時 \
			   オルガアンチエルード時 \
			   オルガとんぼ返り時 \
			   オルガ側転時 \
			   オルガダメージ時 \
			   オルガ覗き込み時 \
			   オルガスライディング時 \
			   オルガマシンガンな奴時 \
			   オルガ挑発時 \
			   ホロ舞う時 \
			   ライフ１／２時 \ // 廃止
			   ライフ１／４時 \
			   ライフ１／８時 \
			   ライフ３／４時 \
			   スネークすき間 \
			   人生語り最初始め \	//（１番めのセリフススタート）
			   人生語り最初終り \	//（１番めのセリフ終了）
			   人生語り最後始め \	//（４番めのセリフスタート）
			   人生語り最後終り \	//（４番めのセリフ終了）
			   オルガ戦第二フェーズロックオン防止壁終了 \
			   オルガ戦第三フェーズカット               \ /* 第３フェーズ用 */
			   オルガ戦第二フェーズロックオン防止壁終了 \ /* 第３フェーズに流用 */
			-c $w:ローカル変数Ｗ１ $w:ローカル変数Ｗ２ 1500 2000 \ // スネーク銃・グレネードダメージ・吹っ飛びダメージ範囲・吹っ飛びのみ範囲
			   //32 25 11 11 11 11 11 11 11 11 20 \ // オルガダメージ 128
			   24 17 8 8 8 8 8 8 8 8 15 \ // オルガダメージ 128
			-f (d:ORGA_MERYLE)

		// ステージ開始時は、シングル表示。
		mesg ボスオルガ オルガ シングルウェイト表示

		//欧州言語用ＳＥ字幕
		#ifdef d:EU || d:KOREA
			#ifdef d:EU
				command 字幕言語設定
			#endif
				@ＳＥ字幕リソース
		#endif

#if 0
	chara 装備品Ａ オルガＵＳＰホルスター \
		-n org_gbhlst \
		-y オルガ \
		-z 0 \
		-x -110 90 55 \
		-v 0 -243 0 \
		-a 1 0 0 \
		-r (0*4096/360) (-55*4096/360) (-10*4096/360) \
		-l (20*4096/360) \
		-o 90

	chara 装備品Ａ オルガスカウトナイフ \
		-n org_sk_cover \
		-y オルガ \
		-z 0 \
		-x 76 90 107 \
		-v 0 -243 0 \
		-a 1 0 1 \
		-r (0*4096/360) (8*4096/360) (15*4096/360) \
		-l (45*4096/360) \
		-o 110

	chara 装備品Ａ オルガ無線機 \
		-n org_radio \
		-y オルガ \
		-z 0 \
		-x 67 90 -51 \
		-v 0 -243 0 \
		-a 1 0 0 \
		-r (0*4096/360) (157*4096/360) (0*4096/360) \
		-l (20*4096/360) \
		-o 110
#endif
}

