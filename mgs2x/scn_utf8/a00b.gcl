	@特殊装備解除

	command パッド操作 -release

	command プレイヤー無敵セット
}

proc オルガスライディング時 {
#if d:オルガ各種カット
	#if d:オルガスライディング時x
		#if d:オルガスライディング時初回のみ
		print 'スライディング１'

			if((!$f:w00b_オルガスライディング_コンテナへ_終了) || \
				(!$f:w00b_オルガスライディング_ロッカーへ_終了)) {

		print 'スライディング２'
				// 主観ではなく、ビハインドしてもいなければ…
				if(!`%PlayerStatus \
					-f d:TRP_STATE_SUBJECT \
					   d:TRP_STATE_BEHIND`) {

		print 'スライディング３'
					// どっちから飛び出すか先に判定
					command ゲットオルガ目的地 $i:目的地 $i:現在地
					// 目的地は、０：ロッカー、１：コンテナ、３：ホロ。

					// コンテナへ向けてスライディング
					if($i:目的地 == 1){

						// まだコンテナへのスライディングを見ていなかったら。
						if(!$f:w00b_オルガスライディング_コンテナへ_終了) {

							@オルガスライディング内部プロック 75

							chara カメラ設定 オルガカットカメラ \
								-c 1 \
								-p -14805,12996,-19486 \
								-t -13287,14184,-11265 \
								-a 163 \
								-i 0 0 0 0  \
								-s 1

							chara delay ディレイ -time 35 -exec {
								/* オルガの水飛沫浴びて、カメラレンズ飛沫 */

				print 'コンテナへ向けてスライディング'

							}

							eval($f:w00b_オルガスライディング_コンテナへ_終了 = 1)

						}

					// ロッカーへ向けてスライディング
					} else if($i:目的地 == 0) {

						// まだロッカーへのスライディングを見ていなかったら。
						if(!$f:w00b_オルガスライディング_ロッカーへ_終了) {

							@オルガスライディング内部プロック 75

						chara カメラ設定 オルガカットカメラ \
							-c 1 \
							-p -17659,15174,-15491 \
							-t -10565,10971,-17268 \
							-a 165 \
							-i 0 0 0 0  \
							-s 1

			print 'ロッカーへ向けてスライディング'

						eval($f:w00b_オルガスライディング_ロッカーへ_終了 = 1)

						}

					}

					chara delay ディレイ -time $i:w00b_delay_time -exec {
						#if 1
							@オルガカットカメラ終了
						#else
							chara カメラ設定 オルガカットカメラ -s -1
						#endif
						command パッド操作 -cancel
						command プレイヤー無敵解除

					}
				}
			}
		#endif
	#endif
#endif
}

