proc オルガ側転時内部プロックその１ {

	command パッド操作 -release

	@特殊装備解除

	command プレイヤー無敵セット

	mesg ボスオルガ オルガ 回避無効
}

proc オルガ側転時 {
#if d:オルガ各種カット
	#if d:オルガ側転時x
		#if d:オルガ側転時初回のみ

			// カットを両方とも見終わっていなかったら。
			if((!$f:w00b_オルガ側転_ロッカーから_終了) || \
				(!$f:w00b_オルガ側転_ロッカーから_終了)){

				// 主観ではなく、ビハインドしてもいなければ…
				if(!`%PlayerStatus \
					-f d:TRP_STATE_SUBJECT \
					   d:TRP_STATE_BEHIND`) {

						// どっちから飛び出すか先に判定
						command ゲットオルガ目的地 $i:目的地 $i:現在地
						// 目的地は、０：ロッカー、１：コンテナ、２：ホロ。

						// ロッカーから飛び出す
						if($i:現在地 == 0){

							// まだロッカーから飛び出しを見ていなかったら。
							if(!$f:w00b_オルガ側転_ロッカーから_終了) {

								// 何フレーム見せるか
								eval($i:w00b_delay_time = 70) // 少し短い

								// レーダー画面制御
								@オルガ各種カット時レーダー画面制御 $i:w00b_delay_time

								// シネマスクリーン
								@シネマスクリーン使用 $i:w00b_delay_time

								@オルガ側転時内部プロックその１

								@パンカメラプロック \
									-10707,13112,-15915 \
									-12249,13431,-15211 \
									-10734,13120,-15461 \
									-12426,13430,-15584 \
									150 \
									$i:w00b_delay_time \
									1

				print '側転_ロッカーから飛び出す'

								eval($f:w00b_オルガ側転_ロッカーから_終了 = 1)
							}

						// コンテナから飛び出す
						} else if($i:現在地 == 1) {

							// まだコンテナから飛び出しを見ていなかったら。
							if(!$f:w00b_オルガ側転_ロッカーから_終了) {

								// 何フレーム見せるか
								eval($i:w00b_delay_time = 90) // こっちは少し長目

								// レーダー画面制御
								@オルガ各種カット時レーダー画面制御 $i:w00b_delay_time

								// シネマスクリーン
								@シネマスクリーン使用 $i:w00b_delay_time

								@オルガ側転時内部プロックその１

								@パンカメラプロック \
									-13646 15785 -20732 \
									-12427 12517 -17374 \
									-15787 15900 -19830 \
									-14298 13356 -16032 \
									170 \
									$i:w00b_delay_time \
									1

				print '側転_コンテナから飛び出す'

								eval($f:w00b_オルガ側転_コンテナから_終了 = 1)
							}
						}

						chara delay ディレイ -time $i:w00b_delay_time -exec {
							command パッド操作 -cancel
							mesg ボスオルガ オルガ 回避有効
							command プレイヤー無敵解除

							// 側転直後に射撃すると、スネークは避けにくいのでその対策。
							mesg ボスオルガ オルガ 全機能停止 15

							#if 1
								@オルガカットカメラ終了
							#else
								chara カメラ設定 オルガカットカメラ -s -1
							#endif
						}

				}
			}
		#endif
	#endif
#endif
}

