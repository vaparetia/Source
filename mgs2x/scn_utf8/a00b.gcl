proc 人生語り最初始め {
#if d:オルガ各種カット
	#if d:人生語り最初始めx
		if($f:w00b_人生語り始め聞いた) {
			mesg ボスオルガ オルガ デモスキップ可能
		}
		eval($f:w00b_人生語り始め聞いた = 1)

		// コンティニュー後スキップのため
		command varsave $f:w00b_人生語り始め聞いた

		@シネマスクリーンスタート
		@レーダー画面消去
		@特殊装備解除
		command パッド操作 -release
		command プレイヤー無敵セット

		// ------------------------------
		// 実際のカット
		// ------------------------------
		// 最初のカット始め
		@パンカメラプロック \
			-24427,17548,-9693 \
			-19465,13757,-17972 \
			-15298,17548,-9265 \
			-19465,13757,-17972 \
			766 \
			d:人生語り始めディレイタイム \
			0

		// 船首ぼかす
		mesg 遠景ぼかし 遠景ぼかし３ on

		// 別カットに切り替わり
		chara delay ディレイ人生 -time d:人生語り始めディレイタイム -exec {

			mesg 遠景ぼかし 遠景ぼかし３ off

