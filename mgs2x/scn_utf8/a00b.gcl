proc ライフ１／８時 {
#if d:オルガ各種カット
	print 'ライフ１／８'
	chara delay ディレイ -time 140 -exec {
		mesg ボスオルガ オルガ オルガ静止解除
	}

//----------------

		#if d:オルガライフ１／８時x
			#if d:オルガライフ１／８時初回のみ
			print 'ライフ１／８'

					// 何フレーム見せるか（モーションのフレーム数＋しゃべり分数フレーム）
					eval($i:w00b_delay_time = 180)

					// レーダー画面制御
					@オルガ各種カット時レーダー画面制御 $i:w00b_delay_time

					command パッド操作 -release

					@特殊装備解除

					command プレイヤー無敵セット

					command ゲットオルガ目的地 $i:目的地 $i:現在地
					// 目的地は、０：ロッカー、１：コンテナ、３：ホロ。

					// 各隠れ場所の左右どちらか？
					command ゲットオルガフラグ $i:フラグ

			#if 1
					// コンテナへ隠れ
					if($i:目的地 == 1){
						// コンテナ右端
						if($i:フラグ & d:flag_t:ORGA_F_DANGR_LEFT){
							//オルガが隠れ場所に到達
							mesg ボスオルガ オルガ マルチウェイト表示

							chara カメラ設定 オルガカットカメラ \
								-c 1 \
								-p -11710,13985,-19350 \
								-t -14214,13767,-18698 \
								-a 499 \
								-i 0 0 0 0  \
								-s 1

							mesg 臨時顔アニメキャラ オルガアニメ モーション再生 org_face_scream 10
							mesg 臨時顔アニメキャラ オルガアニメ 視線変更 0 60 -10500 12000 -12500 // 仮座標
							command ＳＥセットモード -s d:se_code:SD_V_SORGA10 -p -15735,14272,-13146 -m 1

