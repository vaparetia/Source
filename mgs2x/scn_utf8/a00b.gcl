				if($3 == 入る){
				//隠れ場所にスネークが入った
				mesg ボスオルガ オルガ snake_hide 2 // 引数はトラップ名の最後の数字にあわせる
			} else {
				//隠れ場所にスネークが出た
				mesg ボスオルガ オルガ snake_unhide
			}
		}

	trap ev003 d:PLAYER \
		-mask ？ \
		-exec {
				if($3 == 入る){
				//隠れ場所にスネークが入った
				mesg ボスオルガ オルガ snake_hide 3 // 引数はトラップ名の最後の数字にあわせる
			} else {
