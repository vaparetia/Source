							800 800 \
							30 1
			}
		}

*/

}


proc スネークホフク時オルガ映り込み消去セット {
#if d:uturikomi
	trap ev400 d:PLAYER \
		-mask ？ \
		-state 2 \
		-exec {
				//スネークホフク中は、オルガの映り込みを消す。
				if($3 == 入る){
					mesg 鏡面モデル管理 床面映り込みオルガ del オルガ
				} else {
					mesg 鏡面モデル管理 床面映り込みオルガ add オルガ
				}
		}
#endif
}


// オルガへの接近防止用カメラ。
proc 階段前寄りカメラセット {
	trap ca002 d:PLAYER \
		-mask ＊ \
		-camera \
		-exec {
				chara カメラ設定 サブカメラ１ \
					-c 1 \
					-p -11270,18652,-14875 \
					-t -11342,14417,-14880 \
					-a 220 \
					-i 1 -1 0 0 \
					-d 1 \ // パッド補正
					-s $3
	}
}

















// ビヨンド設定
// ------------------------------------
proc オルガ戦ステージビヨンド設定１ {
	trap by000 d:PLAYER \
		-mask いる \
		-button 3 \		//ビヨンドボタン
		-state 0,4 \	//立ち状態or張り付き
		-exec {

			@西向きビヨンド発動 by000 -11875 $6 -11500 -9250 d:BY_FALL_DEAD

		}

	// ぶら下がり前
	trap by000 d:PLAYER \
		-mask ＊ \
		-state 6 \
		-dir 3072 256 \	//方向指定
		-exec {
			mesg プレイヤー d:PLAYER shadow 0
			chara カメラ設定 ビヨンドカメラ \
				-c 0 \
				-b -32000,-32000,-32000 32000,32000,32000 \
				-l -32000,-32000,-32000 32000,32000,32000 \
				-r 708,1872,0 \
				-f 9776 \
				-a 200 \
				-i 1 -1 0 0 \
				-s $3
#if d:uturikomi
			if($3 == 入る){
				mesg 鏡面モデル管理 床面映り込みスネーク del d:PLAYER
				mesg 鏡面モデル管理 床面映り込みオルガ del オルガ
print 'デリート！！'
			}
#endif
		}

	// ぶら下がり中
	trap by000 d:PLAYER \
		-mask ？ \
		-state 5 \
		-dir 1024 256 \	//方向指定
		-exec {
#if 1
			chara カメラ設定 ビヨンドカメラ \
				-c 1 \
				-p -19015,16201,-13452 \
				-t -11608,11093,-10929 \
				-r 377,810,0 -f 9344 \
				-a 445 \
				-i 3 2 0 0 \
				-s $3
#else
			chara カメラ設定 ビヨンドカメラ \
				-c 1 \
				-p -17479,19354,-11748 \
				-t -12266,11637,-12562 \
				-r 588,1095,0 \
				-f 9349 \
				-a 238 \
				-i 3 2 0 0 \
				-s $3
#endif
#if d:uturikomi
			if($3 == 出る){
				mesg 鏡面モデル管理 床面映り込みスネーク add d:PLAYER
				mesg 鏡面モデル管理 床面映り込みオルガ add オルガ
print 'アッド！！'
			}
#endif
		}



	trap by000 d:PLAYER \
		-mask 入る \
		-state d:TRP_STATE_ELUDE_FALL \
		-dir 1024,256 \	//方向指定
		-exec {
			print '落下死です。'
			if(`%ゲームオーバーチェック` == 0){
				command ゲームオーバー処理開始 \
					-exec {
						chara delay ディレイ -time 60 -exec{
							command ゲームオーバー処理終了
						}
					}
			}
		}


}

proc オルガ戦ステージビヨンド設定２ {
	trap by001 d:PLAYER \
		-mask ？ \
		-state 0,4 \	//立ち状態or張り付き
		-exec {}

	trap by001 d:PLAYER \
		-mask いる \
		-button 3 \		//ビヨンドボタン
		-state 0,4 \	//立ち状態or張り付き
		-exec {
// Y.Matsuhana 2001.2.27 modify
//			@ビヨンドモード発動 by001 0 2 (-10125+(d:ADJ_DIS_NOMAL)) (-9625+(d:ADJ_DIS_BEHIND)) \
//								0 $4 (-12000+(d:ADJ_DIS)) (-7000-(d:ADJ_DIS)) 0x00000006
		}

	// ぶら下がり前
	trap by001 d:PLAYER \
		-mask ＊ \
		-state 6 \
		-dir 0 256 \	//方向指定
		-exec {
			mesg プレイヤー d:PLAYER shadow 0

			chara カメラ設定 ビヨンドカメラ \
				-c 0 \
				-b -32000,-32000,-32000 -5500,32000,32000 \
				-l -32000,-32000,-32000 -5500,32000,32000 \
				-r 464,3736,0 \
				-f 4500 \
				-a 176 \
				-i 1 -1 0 0 \
				-s $3
#if d:uturikomi
			if($3 == 入る){
				mesg 鏡面モデル管理 床面映り込みスネーク del d:PLAYER
print 'デリート！！'
			}
#endif
		}

	// ぶら下がり中
	trap by001 d:PLAYER \
		-mask ？ \
		-state 5 \
		-dir 2048 256 \	//方向指定
		-exec {
			chara カメラ設定 ビヨンドカメラ \
				-c 0 \
				-b -32000,12390,-32000 32000,32000,32000 \
				-l -32000,11767,-32000 32000,32000,32000 \
				-r 36,2136,0 \
				-f 10192 \
				-a 200 \
				-i 3 2 0 0 \
				-s $3
			if($3 == 入る) {
				mesg 鏡面モデル管理 床面映り込みオルガ del オルガ
				mesg プットオブジェ 底抜け防止 off
			} else {
				mesg 鏡面モデル管理 床面映り込みオルガ add オルガ
				mesg プットオブジェ 底抜け防止 on
#if d:uturikomi
				mesg 鏡面モデル管理 床面映り込みスネーク add d:PLAYER
print 'アッド！！'
#endif
			}
		}
}

