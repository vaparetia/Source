proc ゲームスタート時スネーク起立 {

	command パッド操作 -release

	command プレイヤー無敵セット

	//eval($w:武器 = d:武器:Ｍ９)
	$w:武器 = d:武器:ＵＳＰ;

	chara delay ディレイ -time 30 -exec {

		mesg プレイヤー d:PLAYER stance \
			 0 \
			-1 \
			-1 \
			0

		command プレイヤー無敵解除
		command パッド操作 -cancel

	}

}


