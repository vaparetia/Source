proc スネークすき間 {
#if d:オルガ各種カット
	#if d:スネークすき間時x
		#if d:スネークすき間初回のみ

		print 'スネークすき間'

			if(!$f:w00b_スネークすき間時初回終了){

				// 何フレーム見せるか
				eval($i:w00b_delay_time = 90)

				// レーダー画面制御
				@オルガ各種カット時レーダー画面制御 $i:w00b_delay_time

				// シネマスクリーン
				@シネマスクリーン使用 $i:w00b_delay_time

				command パッド操作 -release

				@特殊装備解除

				command プレイヤー無敵セット
				mesg ボスオルガ オルガ 回避無効

				@パンカメラプロック \
					-11813 15880 -12355 \
					-8640  12670 -17025 \
					-7782  15870 -12001 \
					-11594 12670 -16169 \
					206 \
					$i:w00b_delay_time \
					1

				chara delay ディレイ -time $i:w00b_delay_time -exec {
					#if 1
						@オルガカットカメラ終了
					#else
						chara カメラ設定 オルガカットカメラ -s -1
					#endif
					eval($b:w00b_呼ばれてはいけない_スネークすき間 = 1)
					command パッド操作 -cancel
					mesg ボスオルガ オルガ 回避有効
					command プレイヤー無敵解除
				}

				eval($f:w00b_スネークすき間時初回終了 = 1)

			}

		#endif
	#endif
#endif
}

