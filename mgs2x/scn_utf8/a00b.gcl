// レーダー
// ------------------------------------
proc レーダーセット {
	// レーダー画面回転のため、charaを置く。
	chara レーダー レーダー -dir 3072
}

proc オルガ各種カット時レーダー画面制御 $:消去持続時間 {
	command メニュー設定 \
		-menu off \ // 武器・アイテムメニューのオフ
		-gage off \ // ゲージのオフ
		-radar off \ // レーダーのオフ
		-subwin off  // 子画面のオフ

	chara delay ディレイ -time $:消去持続時間 -exec {
		command メニュー設定 \
			-menu on \ //武器・アイテムメニューのオン
			-gage on \ //ゲージのオン
			-radar on \ //レーダーのオン
			-subwin on  //子画面のオン
	}
}

proc レーダー画面消去 {
	command メニュー設定 \
		-menu off \ // 武器・アイテムメニューのオフ
		-gage off \ // ゲージのオフ
		-radar off \ // レーダーのオフ
		-subwin off  // 子画面のオフ
}

proc レーダー画面表示 {
	command メニュー設定 \
		-menu on \ //武器・アイテムメニューのオン
		-gage on \ //ゲージのオン
		-radar on \ //レーダーのオン
		-subwin on  //子画面のオン
}

