w00b/cの階段前新規箱の座標です。
obs_box3.mdl
TRANS : -11300, 12000, -15000
ROTY : 15°
*/
}

proc 木箱のすき間の透明壁セット {
	// 立ち時用透明壁
	chara 透明壁 木箱のすき間透明壁立ち \
		-position -9450,12500,-16550 600 \
			      -9450,12500,-17050 600 \
		-attribute (d:HZX_SEG_NO_ENEMY | d:HZX_SEG_NO_BULLET | d:HZX_SEG_NO_MISSILE | \
					d:HZX_SEG_NO_C4 | d:HZX_SEG_NO_RECOIL | \
					d:HZX_SEG_NO_DISP_RADAR | d:HZX_SEG_NO_BULLETHOLE | d:HZX_SEG_NO_SPRAY | \
					d:HZX_SEG_NO_ENEMY_EYES | d:HZX_SEG_NO_KNOCK_SE)

	trap ev800 d:PLAYER \
		-mask ？ \
		-exec {
			if($3 == 入る) {
				mesg 透明壁 木箱のすき間透明壁立ち on
			} else {
				mesg 透明壁 木箱のすき間透明壁立ち off
			}
		}

	// しゃがみ時用透明壁・張り付きアリ
	chara 透明壁 木箱のすき間透明壁立ち_張り付きアリ \
		-position -9450,12000,-16550 500 \
			      -9450,12000,-17050 500 \
		-attribute (d:HZX_SEG_NO_ENEMY | d:HZX_SEG_NO_BULLET | d:HZX_SEG_NO_MISSILE | \
					d:HZX_SEG_NO_C4 | d:HZX_SEG_NO_RECOIL | \
					d:HZX_SEG_NO_DISP_RADAR | d:HZX_SEG_NO_BULLETHOLE | d:HZX_SEG_NO_SPRAY | \
					d:HZX_SEG_NO_ENEMY_EYES | d:HZX_SEG_NO_KNOCK_SE)
	// しゃがみ時用透明壁・張り付きナシ
	chara 透明壁 木箱のすき間透明壁立ち_張り付きナシ \
		-position -9450,12000,-16550 500 \
			      -9450,12000,-17050 500 \
		-attribute (d:HZX_SEG_NO_ENEMY | d:HZX_SEG_NO_BULLET | d:HZX_SEG_NO_MISSILE | \
					d:HZX_SEG_NO_C4 | d:HZX_SEG_NO_RECOIL | d:HZX_SEG_NO_HARITSUKI | \
					d:HZX_SEG_NO_DISP_RADAR | d:HZX_SEG_NO_BULLETHOLE | d:HZX_SEG_NO_SPRAY | \
					d:HZX_SEG_NO_ENEMY_EYES | d:HZX_SEG_NO_KNOCK_SE)

	trap ev101 d:PLAYER \
		-mask ？ \
		-state d:TRP_STATE_CAUTION \
		-exec {
			if($3 == 入る) {
				mesg 透明壁 木箱のすき間透明壁立ち_張り付きアリ on
				mesg 透明壁 木箱のすき間透明壁立ち_張り付きナシ off
			} else {
				mesg 透明壁 木箱のすき間透明壁立ち_張り付きアリ off
				mesg 透明壁 木箱のすき間透明壁立ち_張り付きナシ on
			}
		}
}

