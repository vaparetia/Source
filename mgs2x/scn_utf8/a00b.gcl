proc USBキーボード操作セット {
#if d:usb_keyboard
	chara 臨時顔アニメキャラ スネークアニメ \
		-chara d:PLAYER

	chara 臨時顔アニメキャラ オルガアニメ \
		-chara オルガ

	chara USBキーボード実行 test \
		-e d:KBD_ESC {	mesg 臨時顔アニメキャラ スネークアニメ モーション再生 normal 30
						mesg 臨時顔アニメキャラ スネークアニメ 視線変更 -1
						mesg 遠景ぼかし 遠景ぼかし１ off
						mesg 遠景ぼかし 遠景ぼかし２ off
						mesg 遠景ぼかし 遠景ぼかし３ off
						mesg 近景ぼかし 近景ぼかし１ off
						mesg 近景ぼかし 近景ぼかし２ off
						mesg 近景ぼかし 近景ぼかし３ off
						} \
		-e d:KBD_F1 { mesg 臨時顔アニメキャラ スネークアニメ モーション再生 sna_face_pain 30 } \
		-e d:KBD_F2 { mesg 臨時顔アニメキャラ スネークアニメ モーション再生 sna_face_T12a1D71 30 } \
		-e d:KBD_F3 { mesg 臨時顔アニメキャラ スネークアニメ モーション再生 sna_face_relax 30 } \
		-e d:KBD_F4 { mesg 臨時顔アニメキャラ スネークアニメ モーション再生 sna_face_scream 0 } \
		-e d:KBD_F5 { mesg 臨時顔アニメキャラ スネークアニメ モーション再生 sna_face_sigh 30 } \
		-e d:KBD_F6 { mesg 臨時顔アニメキャラ スネークアニメ モーション再生 sna_face_surprise 30 } \
		-e d:KBD_F7 { mesg 臨時顔アニメキャラ スネークアニメ モーション再生 sna_face_teeth 30 } \
		-e d:KBD_F8 { mesg 臨時顔アニメキャラ スネークアニメ モーション再生 sna_face_tension 30 } \
		-e d:KBD_F9 { mesg 臨時顔アニメキャラ スネークアニメ モーション再生 sna_face_exciting 30 } \

		-e d:KBD_F10 { mesg 臨時顔アニメキャラ スネークアニメ 視線変更 0 60 -10000,13000,-23000 } \
		-e d:KBD_F11 { mesg 臨時顔アニメキャラ スネークアニメ 視線変更 0 60 -10000,13000,-9950 } \
		-e d:KBD_F12 { mesg 臨時顔アニメキャラ スネークアニメ 視線変更 0 60 10000,13000,-18100 } \
		-e d:KBD_PRINT { mesg 臨時顔アニメキャラ スネークアニメ 視線変更 0 60 -10000,13000,-18100 } \
		-e d:KBD_SCLOCK { mesg 臨時顔アニメキャラ スネークアニメ 視線変更 2 } \

		-e d:KBD_X { mesg プットホロオブジェ ホロ オルガ開く } \
		-e d:KBD_C { mesg プットホロオブジェ ホロ 右開く } \
		-e d:KBD_Z { mesg プットホロオブジェ ホロ 左開く } \

		-e d:KBD_1 { mesg 遠景ぼかし 遠景ぼかし１ on } \
		-e d:KBD_2 { mesg 遠景ぼかし 遠景ぼかし２ on } \
		-e d:KBD_3 { mesg 遠景ぼかし 遠景ぼかし３ on } \
		-e d:KBD_4 { mesg 近景ぼかし 近景ぼかし１ on } \
		-e d:KBD_5 { mesg 近景ぼかし 近景ぼかし２ on } \
		-e d:KBD_6 { mesg 近景ぼかし 近景ぼかし３ on } \

		-e d:KPD_ENTER { mesg プレイヤー d:PLAYER headmark } \

		-e d:KBD_0 { restart } \

		-e d:KBD_ZENHAN {	mesg 臨時顔アニメキャラ オルガアニメ モーション再生 normal 30
							mesg 臨時顔アニメキャラ オルガアニメ 視線変更 -1
							mesg ボスオルガ オルガ デバッグアクション 0 } \
		-e d:KBD_Q { mesg 臨時顔アニメキャラ オルガアニメ モーション再生 org_face_anger 30 } \
		-e d:KBD_W { mesg 臨時顔アニメキャラ オルガアニメ モーション再生 org_face_teeth 30 } \
		-e d:KBD_E { mesg 臨時顔アニメキャラ オルガアニメ モーション再生 org_face_look_distant 30 } \
		-e d:KBD_R { mesg 臨時顔アニメキャラ オルガアニメ モーション再生 org_face_pain 30 } \
		-e d:KBD_T {
					mesg 臨時顔アニメキャラ オルガアニメ モーション再生 org_face_excitement 30
					chara delay ディレイ \
						-time 100 \
						-exec { mesg 臨時顔アニメキャラ オルガアニメ モーション再生 org_face_excitement 30 }
					chara delay ディレイ \
						-time 200 \
						-exec { mesg 臨時顔アニメキャラ オルガアニメ モーション再生 org_face_excitement 30
					chara delay ディレイ \
						-time 100 \
						-exec { mesg 臨時顔アニメキャラ オルガアニメ モーション再生 org_face_excitement 30 }
						}
					chara delay ディレイ \
						-time 300 \
						-exec { mesg 臨時顔アニメキャラ オルガアニメ モーション再生 org_face_excitement 30 }
					chara delay ディレイ \
						-time 400 \
						-exec { mesg 臨時顔アニメキャラ オルガアニメ モーション再生 org_face_excitement 30 }
					} \
		-e d:KBD_Y { mesg 臨時顔アニメキャラ オルガアニメ モーション再生 org_face_scream 10 } \
		-e d:KBD_U { mesg 臨時顔アニメキャラ オルガアニメ モーション再生 org_face_surprise 30 } \
		-e d:KBD_I { mesg 臨時顔アニメキャラ オルガアニメ モーション再生 t05a1d41 30 } \
		-e d:KBD_O { mesg 臨時顔アニメキャラ オルガアニメ 視線変更 0 -14000,13000,-18000 } \
		-e d:KBD_P { mesg 臨時顔アニメキャラ オルガアニメ 視線変更 2 } \

		-e d:KBD_INSERT 	{ mesg ボスオルガ オルガ デバッグアクション 1 } \
		-e d:KBD_HOME   	{ mesg ボスオルガ オルガ デバッグアクション 2 } \
		-e d:KBD_PAGEUP 	{ mesg ボスオルガ オルガ デバッグアクション 3 } \
		-e d:KBD_DELETE 	{ mesg ボスオルガ オルガ デバッグアクション 4 } \
		-e d:KBD_END    	{ mesg ボスオルガ オルガ デバッグアクション 5 } \
		-e d:KBD_PAGEDOWN 	{ mesg ボスオルガ オルガ デバッグアクション 6 } \
		-e d:KBD_SCLOCK 	{ mesg ボスオルガ オルガ デバッグアクション 7 } \
		-e d:KBD_PAUSE 		{ mesg ボスオルガ オルガ デバッグアクション 12 } \
		-e d:KPD_NUMLOCK 	{ mesg ボスオルガ オルガ デバッグアクション 13 } \
		-e d:KPD_SLASH	 	{ mesg ボスオルガ オルガ デバッグアクション 14 } \
		-e d:KPD_ASTA	 	{ mesg ボスオルガ オルガ デバッグアクション 15 } \

//		-e d:KPD_SLASH	 	{ mesg プットホロオブジェ ホロ リセット } \

//		-e d:KBD_V { mesg 鏡面モデル管理 床面映り込みスネーク del d:PLAYER } \
//		-e d:KBD_B { mesg 鏡面モデル管理 床面映り込みスネーク add d:PLAYER } \
//		-e d:KBD_N { mesg 鏡面モデル管理 床面映り込みオルガ del オルガ } \
//		-e d:KBD_M { mesg 鏡面モデル管理 床面映り込みオルガ add オルガ } \

		-e d:KBD_A { mesg プレイヤー d:PLAYER shadow $f:ＯＦＦ }
#endif
}

proc レーダークルクル {
	chara くるくる物体 radar \
		-k w00_radar \
		-p -1500 25600 -15400 \
		-r 32 \
		-s 1 \
		-d 2 200 200 48
}

proc ボス戦初期化 {
	// 設置すべきアイテムの数だけ必要。
	// （予備）弾薬がステージ上に存在しているかどうかのフラグ。
	eval($f:boss_battle_bullet_exist_1 = 0)
	eval($f:boss_battle_bullet_exist_2 = 0)
	eval($w:boss_battle_bullet_exist_3 = 0)
	eval($w:boss_battle_bullet_exist_4 = 0)
//	eval($w:boss_battle_bullet_exist_5 = 0)
	eval($f:boss_battle_bullet_exist_6 = 0)
}

proc スネーク居場所チェック {
	trap ev800 d:PLAYER \
		-mask ？ \
		-exec {
			if($3 == 入る) {
				eval($f:ev_item_000 = 1)
			} else {
				eval($f:ev_item_000 = 0)
			}
		}
	trap ev801 d:PLAYER \
		-mask ？ \
		-exec {
			if($3 == 入る) {
				eval($f:ev_item_001 = 1)
			} else {
				eval($f:ev_item_001 = 0)
			}
		}
	trap ev802 d:PLAYER \
		-mask ？ \
		-exec {
			if($3 == 入る) {
				eval($f:ev_item_002 = 1)
			} else {
				eval($f:ev_item_002 = 0)
			}
		}
}

#ifndef d:BOSS_MODE
/*
proc アイテム取得時番号設定 $:ボックス名 {
	// ボスステージなので、中身は不要。
}
*/
#endif

proc アイテム初期設置セット {


		chara アイテム アイテムボックス \
			-b 0 \
			-p -11500 12000 -13500 \
			-k handgun_amo_ibox \
			-s handgun_amo_ibox_sh \
			-l m92_amo_label \
			-f d:アイテム種別:武器弾 \
			-i d:武器:Ｍ９ \
			-n 15 \
			-h 300 \
			-r 1 \
			-x { eval($f:boss_battle_bullet_exist_1 = 0) }
		// ボス戦用アイテム、重複出現防止
		eval($f:boss_battle_bullet_exist_1 = 1)

//--------
		chara アイテム アイテムボックス \
			-b 0 \
			-p -6600 12000 -19250 \
			-k handgun_amo_ibox \
			-s handgun_amo_ibox_sh \
			-l m92_amo_label \
			-f d:アイテム種別:武器弾 \
			-i d:武器:Ｍ９ \
			-n 15 \
			-h 300 \
			-r 1 \
			-x { eval($f:boss_battle_bullet_exist_2 = 0) }
		// ボス戦用アイテム、重複出現防止
		eval($f:boss_battle_bullet_exist_2 = 1)

//--------
		if($w:ゲーム設定 < d:LEVEL_EXTREME) {

			// Easy 以下では判りやすい場所に設置
			if($w:ゲーム設定 <= d:LEVEL_EASY) {
				eval($i:w00b_レーション位置Ｘ = -11250)
				eval($i:w00b_レーション位置Ｚ = -10750)
			} else {
				eval($i:w00b_レーション位置Ｘ = -4550)
				eval($i:w00b_レーション位置Ｚ = -9500)
			}

			chara アイテム アイテムボックス \
				-b 0 \
				-p $i:w00b_レーション位置Ｘ 12000 $i:w00b_レーション位置Ｚ \
				-k ration_ibox \
				-s ration_ibox_sh \
				-l rtn_label \
				-f d:アイテム種別:アイテム \
				-i d:アイテム:レーション \
				-n 1 \
				-h 300 \
				-r 1 \
				-x { eval($f:boss_battle_bullet_exist_6 = 0) }
			// ボス戦用アイテム、重複出現防止
			eval($f:boss_battle_bullet_exist_6 = 1)
		}


//	@振動センサー_初期設置 ぶるぶる -4550 12000 -9000 1

}

proc ボスラッシュＭ９設置判定 {
	if($s:ボスラッシュプレイヤー == スネーク){
		if($w:武器弾数[ d:武器:Ｍ９ ] == 0){
			return 1
		}else{
			return 0
		}
	}else{
		if($w:武器弾数Ｒ[ d:武器:Ｍ９ ] == 0){
			return 1
		}else{
			return 0
		}
	}
}



proc ボスラッシュレーション設置判定 {
	if($s:ボスラッシュプレイヤー == スネーク){
		if($w:アイテム数[ d:アイテム:レーション ] == 0){
			return 1
		}else{
			return 0
		}
	}else{
		if($w:アイテム数Ｒ[ d:アイテム:レーション ] == 0){
			return 1
		}else{
			return 0
		}
	}
}


proc ボス戦アイテム補給セット {


		@ボス戦初期化 // 初期配置をすることになったので、実質上不要か？
		@スネーク居場所チェック

		// ボス戦初期化よりあとに置くこと
		@アイテム初期設置セット

		trap ev300 d:PLAYER \
			-mask いる \
			-exec {
				// M9の1
				if(!$f:ev_item_000) {
					if($f:boss_battle_bullet_exist_1 == 0) {
						if($w:武器弾数[ d:武器:Ｍ９ ] == 0){
							if(`command カメラ視界チェック -camera 0x03 \
								-bound -11510 12000 -13510 -11490 12000 -13490` == 0){
							 		chara アイテム アイテムボックス \
										-b 0 \
										-p -11500 12000 -13500 \
										-k handgun_amo_ibox \
										-s handgun_amo_ibox_sh \
										-l m92_amo_label \
										-f d:アイテム種別:武器弾 \
										-i d:武器:Ｍ９ \
										-n 15 \
										-h 300 \
										-r 1 \
										-x { eval($f:boss_battle_bullet_exist_1 = 0) }

									// 弾薬がステージ上に出現（存在）しましたよ。
									eval($f:boss_battle_bullet_exist_1 = 1)

							}
						}
					}
				}

				// M9の2
				if(!$f:ev_item_001) {
					if($f:boss_battle_bullet_exist_2 == 0) {
						if($w:武器弾数[ d:武器:Ｍ９ ] == 0){
							if(`command カメラ視界チェック -camera 0x03 \
								-bound -6610 12000 -195260 -6590 12000 -19240` == 0){
									chara アイテム アイテムボックス \
										-b 0 \
										-p -6600 12000 -19250 \
										-k handgun_amo_ibox \
										-s handgun_amo_ibox_sh \
										-l m92_amo_label \
										-f d:アイテム種別:武器弾 \
										-i d:武器:Ｍ９ \
										-n 15 \
										-h 300 \
										-r 1 \
										-x { eval($f:boss_battle_bullet_exist_2 = 0) }

									// 弾薬がステージ上に出現（存在）しましたよ。
									eval($f:boss_battle_bullet_exist_2 = 1)

							}
						}
					}
				}


	// --------------------------------------------
				// レーションの1
				if($w:ゲーム設定 < d:LEVEL_EXTREME && !$f:ev_item_002 && ! $f:boss_battle_bullet_exist_6){
					if($w:アイテム数[ d:アイテム:レーション ] == 0){
						eval($i:w00b_レーションバウンドＸ１ = $i:w00b_レーション位置Ｘ-10)
						eval($i:w00b_レーションバウンドＸ２ = $i:w00b_レーション位置Ｘ+10)
						eval($i:w00b_レーションバウンドＺ１ = $i:w00b_レーション位置Ｚ-10)
						eval($i:w00b_レーションバウンドＺ２ = $i:w00b_レーション位置Ｚ+10)

						if(`command カメラ視界チェック -camera 0x03 \
							-bound $i:w00b_レーションバウンドＸ１,12000,$i:w00b_レーションバウンドＺ１ $i:w00b_レーションバウンドＸ２,12000,$i:w00b_レーションバウンドＺ２` == 0){

							chara アイテム アイテムボックス \
								-b 0 \
								-p $i:w00b_レーション位置Ｘ 12000 $i:w00b_レーション位置Ｚ \
								-k ration_ibox \
								-s ration_ibox_sh \
								-l rtn_label \
								-f d:アイテム種別:アイテム \
								-i d:アイテム:レーション \
								-n 1 \
								-h 300 \
								-r 1 \
								-x { eval($f:boss_battle_bullet_exist_6 = 0) }

							// 弾薬がステージ上に出現（存在）しましたよ。
							eval($f:boss_battle_bullet_exist_6 = 1)

						}
					}
				}
			}


}

proc 共通シネマスクリーンセット {
	chara シネマスクリーン シネマ \
		-top d:CINEMA_BELT_UPPER \
		-bottom d:CINEMA_BELT_LOWER \
		-ftime 30	//デフォルト値（ゼロは駄目）
}

// 適宜スタート、終了したい場合
proc シネマスクリーンスタート {
	// コール絡みバグ予防策
	command 無線設定 -reset

	mesg ボスオルガ オルガ デモ開始
	mesg シネマスクリーン シネマ フェードアウト 0
}
proc シネマスクリーン終了 {
	mesg シネマスクリーン シネマ フェードイン 0
	mesg ボスオルガ オルガ デモ終了
}

// 最初から時間判っている場合
proc シネマスクリーン使用 $:持続時間 {
	// コール絡みバグ予防策
	command 無線設定 -reset

	mesg シネマスクリーン シネマ フェードアウト 0
	mesg ボスオルガ オルガ デモ開始
	chara delay ディレイ -time $:持続時間 -exec {
		mesg シネマスクリーン シネマ フェードイン 0
		mesg ボスオルガ オルガ デモ終了
	}
}

// ステージ は、最後に！！
// ------------------------------------
proc 船首セット {
	chara プットオブジェ 船首１ -m w00_f1 -r 0 0 0 -p 0 0 -180000  -l w00b -s 100 100 100
	chara プットオブジェ 船首２ -m w00_f2 -r 0 0 0 -p 0 0 -120000  -l w00b -s 100 100 100
	chara プットオブジェ 船首３ -m w00_f3 -r 0 0 0 -p 0 0 -60000  -l w00b -s 100 100 100
	chara プットオブジェ 船首４ -m w00_f4 -r 0 0 0 -p 0 0 0  -l w00b -s 100 100 100
}

// 屋上部との絡みで、ステージをオブジェ置き。
proc ステージセット {
	chara プットオブジェ ブリッジ屋上 -m w00b -r 0 0 0 -p 0 0 0  -l w00b -s 100 100 100 -f d:PUT_OBJ_AUTOREPAINT
}

// デバッグキャラ
// ------------------------------------
proc スクリーンショットセット {
#if d:screen_shot
	chara スクリーンショット スクリーンショット
#endif
}

proc キャラクタ専用ライトセット {
// キャラクタ専用ライト設置
	chara 環境光 環境光 \
		 -c 53,73,55
	chara 平行光 平行光 \
		 -c 70,230,214 \
		 -d 691,721,0
}




proc オルガ戦風邪治し {
	mesg delay タンカーくしゃみ繰り返しディレイ kill
	command プレイヤー風邪治し
}


