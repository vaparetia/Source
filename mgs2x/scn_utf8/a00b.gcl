		-m tnc_died_obj -r 0 0 0 -p 0 0 0 -l w00b -s 100 100 100
}

proc 木箱の上のIRS制御ボックスセット {
#if 1
	chara プットオブジェ ＩＲ制御ボックス -m irs_box -r 3072 (4096-160) 0 \
		-p  -9800 13220 -15600 -l w00b -s 100 100 100
	chara プットオブジェ ＩＲ制御ボックス -m irs_box -r 3072 (4096-50) 0 \
		-p -10250 13220 -15300 -l w00b -s 100 100 100
	chara プットオブジェ ＩＲ制御ボックス -m irs_box -r 3072 1960 0 \
		-p  -9850 13220 -15250 -l w00b -s 100 100 100
	chara プットオブジェ ＩＲ制御ボックス -m irs_box -r 3072 1420 0 \
		-p -10150 13220 -14850 -l w00b -s 100 100 100
#else
	chara プット箱型オブジェ ＩＲ制御ボックス \
		-l w00b \
		-m irs_box irs_box irs_box irs_box \
		-p  3072 (4096-160) 0 -9800 13220 -15600 \
			3072 (4096-50) 0 -10250 13220 -15300 \
			3072 1960 0  	  -9850 13220 -15250 \
			3072 1420 0 	 -10150 13220 -14850 \
		-f 0x00000002
	//パラメータの詳細
	// 向きx 向きy  位置x 位置y 位置z
	//を1セットとしてモデルの個数分だけ用意する
	// フラグは以下のものがあり、ビットを立てることによりその機能を選択できる
	//	0x00000001 移動あり(衝撃により移動する。)
	//	0x00000002 回転あり(衝撃により回転する。なしの場合はY軸回転のみ)
	//	0x00000004 ハザードあり(移動回転の際 周りのハザードを見る、なしの場合は最初だけ)
	//	0x00000008 密度あり(モデルの大きさに動きが比例)
	//	0x00000010 箱同士の当たりあり(未完成)
	//	0x00000020 光源計算あり
#endif
}

proc 鉄箱_木箱セット {
	chara プットスネーク隠れオブジェ 鉄と木箱群 \
		-m obs_box3 -r 0 1024 0 -p -10000 12000 -18700 -l w00b \
		-m obs_box3 -r 0    0 0 -p -10000 12000 -17600 -l w00b \
		-m obs_box4 -r 0 1024 0 -p -10000 12000 -16000 -l w00b \
		-m obs_box4 -r 0 1024 0 -p -10000 12000 -14900 -l w00b \
		-m obs_box3 -r 0 -200 0 -p -10200 13100 -16900 -l w00b \
		-m obs_box3 -r 0  350 0 -p -10000 13100 -18200 -l w00b \

		-m obs_box4 -r 0 1024 0 -p -11300 12000 -12000 -l w00b \
		-m obs_box4 -r 0 1024 0 -p -10200 12000 -11800 -l w00b \
		-m obs_box3 -r 0  800 0 -p -10600 13100 -12200 -l w00b \

		-m obs_box3 -r 0 171 0 -p -11300 12000 -15000 -l w00b

//		-m obs_box3 -r 0 (1024/6) 0 -p -11300 12000 -15000 -l w00b

/* 上から
