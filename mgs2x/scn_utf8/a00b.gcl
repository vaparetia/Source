proc オルガ覗き込み時 {
#if d:オルガ各種カット
	#if d:オルガ覗き込み時x
		#if d:オルガ覗き込み時初回のみ

		print 'のぞき'
			if(!$f:w00b_オルガ覗き込み時初回終了){

				@特殊装備解除

				command パッド操作 -release

				mesg ボスオルガ オルガ 回避無効

				command ゲットオルガ目的地 $i:目的地 $i:現在地
				eval($i:攻撃_行動地 = $i:目的地)

				// コンテナに隠れて覗き込み
				if($i:攻撃_行動地 == 1) {
						chara カメラ設定 オルガカットカメラ \
							-c 1 \
							-p -12411 14174 -13395 \
							-t -13855 13311 -18613 \
							-a 280 \
							-i 0 0 0 0  \
							-s 1

			print 'コンテナに隠れて覗き込み'

					// ロッカーに隠れて覗き込み
					} else if($i:攻撃_行動地 == 0) {
						chara カメラ設定 オルガカットカメラ \
							-c 1 \
							-p -18098 17141 -12664 \
							-t -12782 12566 -15309 \
							-a 250 \
							-i 0 0 0 0  \
							-s 1

			print 'ロッカーに隠れて覗き込み'

					// ホロに隠れて覗き込み
					} else if($i:攻撃_行動地 == 2) {

						// 各隠れ場所の左右どちらか？
						command ゲットオルガフラグ $i:フラグ

						// 右端
						if($i:フラグ & d:flag_t:ORGA_F_DANGR_LEFT){
							chara カメラ設定 オルガカットカメラ \
								-c 1 \
								-p -19030,16614,-19683 \
								-t -16346,11799,-17432 \
								-r 614,569,0 -f 5955 \
								-a 180 \
								-i 0 0 0 0  \
								-s 1

			print 'ホロに隠れて、船首側覗き込み'

						// 右端
						} else if($i:フラグ & d:flag_t:ORGA_F_DANGR_RIGHT){
							chara カメラ設定 オルガカットカメラ \
								-c 1 \
								-p -19984,16614,-14405 \
								-t -14424,8623,-18731 \
								-r 553,1455,0 -f 10653 \
								-a 180 \
								-i 0 0 0 0  \
								-s 1

			print 'ホロに隠れて、船尾側覗き込み'

						}
					}

				chara delay ディレイ -time 180 -exec {
					#if 1
						@オルガカットカメラ終了
					#else
						chara カメラ設定 オルガカットカメラ -s -1
					#endif
					mesg ボスオルガ オルガ 回避有効
					command パッド操作 -cancel
				}

				eval($f:w00b_オルガ覗き込み時初回終了 = 1)

			}
		#endif
	#endif
#endif
}

proc オルガスライディング内部プロック $:スライディング持続時間 {

	// 何フレーム見せるか
	eval($i:w00b_delay_time = $:スライディング持続時間)

	// レーダー画面制御
