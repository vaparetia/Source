// 変数初期化
// ------------------------------------
proc 変数初期化 {
	$$f:ＵＳＰで倒した = 0;
}

// サウンド
// ------------------------------------
proc サウンドマネージャーセット {
#if d:SOUND
	chara サウンドマネージャー ＳＤマネ -pak 0
		mesg サウンドマネージャー ＳＤマネ SD_CODE d:SNG_PLAY_01
//		mesg サウンドマネージャー ＳＤマネ SD_SNEAK_AUTO d:SNG_PLAY_01
#endif
}

proc ボス戦ＢＧＭ_アクション曲調に戻る {
	mesg サウンドマネージャー ＳＤマネ SD_CODE d:SD_AUTO_FADER1
}

proc ボス戦ＢＧＭ_静かな曲調に変わる {
	mesg サウンドマネージャー ＳＤマネ SD_CODE d:SD_AUTO_FADER2
}

proc 足音セット {
	// スネーク雨足音セット「通常・鉄階段・以下ダミー・・・」の順
	// 左足
#if 1
	@サウンド効果音設定
#else
	command 壁床効果音設定 \
		-id 0 \
		-type 0 \
		-se d:SD_P_FOOTL01 \
		-data  d:se_code:SD_P_FOOT_03L,d:NOISE_ZERO \
			   d:se_code:SD_P_FOOT_04L,d:NOISE_ZERO \
			   d:se_code:SD_P_FOOT_03L,d:NOISE_ZERO \
			   d:se_code:SD_P_FOOT_03L,d:NOISE_ZERO \
			   d:se_code:SD_P_FOOT_03L,d:NOISE_ZERO \
			   d:se_code:SD_P_FOOT_03L,d:NOISE_ZERO \
			   d:se_code:SD_P_FOOT_03L,d:NOISE_ZERO \
			   d:se_code:SD_P_FOOT_03L,d:NOISE_ZERO 	// 必ず８セット書くこと
	// 右足
	command 壁床効果音設定 \
		-id 0 \
		-type 0 \
		-se  d:SD_P_FOOTR01 \
		-data  d:se_code:SD_P_FOOT_03R,d:NOISE_ZERO \
			   d:se_code:SD_P_FOOT_04R,d:NOISE_ZERO \
			   d:se_code:SD_P_FOOT_03R,d:NOISE_ZERO \
			   d:se_code:SD_P_FOOT_03R,d:NOISE_ZERO \
			   d:se_code:SD_P_FOOT_03R,d:NOISE_ZERO \
			   d:se_code:SD_P_FOOT_03R,d:NOISE_ZERO \
			   d:se_code:SD_P_FOOT_03R,d:NOISE_ZERO \
			   d:se_code:SD_P_FOOT_03R,d:NOISE_ZERO 	// 必ず８セット書くこと

	// 壁叩き音
	command 壁床効果音設定 \
		-id 0 \
		-type 1 \
		-se d:SD_P_WALL02 \
	-data	d:se_code:SD_A_WALLM01,d:NOISE_ZERO \ // 通常
			d:se_code:SD_A_WALLM02,d:NOISE_ZERO \ // 鉄筋
			d:se_code:SD_A_WALLM03,d:NOISE_ZERO \ // 鉄板
			d:se_code:SD_A_WALLM04,d:NOISE_S \	  // 木
			d:se_code:SD_A_WALLM01,d:NOISE_ZERO \
			d:se_code:SD_A_WALLM01,d:NOISE_ZERO \
			d:se_code:SD_A_WALLM01,d:NOISE_ZERO \
			d:se_code:SD_A_WALLM01,d:NOISE_ZERO	// 必ず８セット書くこと

	// 床跳弾音
	command 壁床効果音設定 \
		-id 0 \
		-type 0 \
		-se d:SD_W_RICOCH02 \
		-data	d:se_code:SD_A_RICOCH01,d:NOISE_ZERO \ // 跳弾１－１ 通常
				d:se_code:SD_A_RICOCH02,d:NOISE_ZERO \ // 跳弾２－１ 鉄筋
				d:se_code:SD_A_RICOCH03,d:NOISE_ZERO \ // 跳弾３－１ 鉄板
				d:se_code:SD_A_RICOCH04,d:NOISE_S \	   // 跳弾４－１ 木
				d:se_code:SD_A_RICOCH05,d:NOISE_ZERO \ // 跳弾５－１ ダンボール
				d:se_code:SD_A_RICOCH02,d:NOISE_ZERO \
				d:se_code:SD_A_RICOCH02,d:NOISE_ZERO \
				d:se_code:SD_A_RICOCH02,d:NOISE_ZERO	// 必ず８セット書くこと

	// 壁跳弾音
	command 壁床効果音設定 \
		-id 0 \
		-type 1 \
		-se d:SD_W_RICOCH02 \
		-data	d:se_code:SD_A_RICOCH01,d:NOISE_ZERO \ // 跳弾１－１ 通常
				d:se_code:SD_A_RICOCH02,d:NOISE_ZERO \ // 跳弾２－１ 鉄筋
				d:se_code:SD_A_RICOCH03,d:NOISE_ZERO \ // 跳弾３－１ 鉄板
				d:se_code:SD_A_RICOCH04,d:NOISE_S \	   // 跳弾４－１ 木
				d:se_code:SD_A_RICOCH05,d:NOISE_ZERO \ // 跳弾５－１ ダンボール
				d:se_code:SD_A_RICOCH02,d:NOISE_ZERO \
				d:se_code:SD_A_RICOCH02,d:NOISE_ZERO \
				d:se_code:SD_A_RICOCH02,d:NOISE_ZERO	// 必ず８セット書くこと


	// オルガ雨足音セット「通常・鉄階段・以下ダミー・・・」の順
	// 左足
	command 壁床効果音設定 \
		-id 1 \
		-type 0 \
		-se  d:SD_P_FOOTL01 \
		-data d:se_code:SD_E_EFOOT_3L1,d:NOISE_ZERO \
			  d:se_code:SD_E_EFOOT_4L1,d:NOISE_ZERO \
			  d:se_code:SD_E_EFOOT_3L1,d:NOISE_ZERO \
			  d:se_code:SD_E_EFOOT_3L1,d:NOISE_ZERO \
			  d:se_code:SD_E_EFOOT_3L1,d:NOISE_ZERO \
			  d:se_code:SD_E_EFOOT_3L1,d:NOISE_ZERO \
			  d:se_code:SD_E_EFOOT_3L1,d:NOISE_ZERO \
			  d:se_code:SD_E_EFOOT_3L1,d:NOISE_ZERO 	// 必ず８セット書くこと
	// 右足
	command 壁床効果音設定 \
		-id 1 \
		-type 0 \
		-se  d:SD_P_FOOTR01 \
		-data d:se_code:SD_E_EFOOT_3R1,d:NOISE_ZERO \
			  d:se_code:SD_E_EFOOT_4R1,d:NOISE_ZERO \
			  d:se_code:SD_P_FOOT_03R,d:NOISE_ZERO \
			  d:se_code:SD_P_FOOT_03R,d:NOISE_ZERO \
			  d:se_code:SD_P_FOOT_03R,d:NOISE_ZERO \
			  d:se_code:SD_P_FOOT_03R,d:NOISE_ZERO \
			  d:se_code:SD_P_FOOT_03R,d:NOISE_ZERO \
			  d:se_code:SD_P_FOOT_03R,d:NOISE_ZERO 	// 必ず８セット書くこと



#endif
}


proc 跳弾番号設定 {
	print '跳弾番号設定'
	// ------------------------------------
		command 跳弾ノーマル -n 0
		command 跳弾ノーマル -n 1
		command 跳弾ノーマル -n 2
		command 跳弾ＳＥのみ -n 6

		command 弾痕ノーマル -n 0
		command 弾痕ノーマル -n 1
		command 弾痕ノーマル -n 2
		command 弾痕ノーマル -n 6



}

proc オルガ戦ＢＧＭ_スネークの場所によって曲調変化セット {
	trap fd000 d:PLAYER \
		-mask ？ \
		-state d:TRP_STATE_ELUDE \
		-exec {
			if($3 == 入る) {
				@ボス戦ＢＧＭ_静かな曲調に変わる
			} else {
				@ボス戦ＢＧＭ_アクション曲調に戻る
			}
		}
	trap fd000 d:PLAYER \
		-mask ？ \
		-exec {
			if($3 == 入る) {
				@ボス戦ＢＧＭ_静かな曲調に変わる
			} else {
				@ボス戦ＢＧＭ_アクション曲調に戻る
			}
		}
}

proc オルガプログラム用イベントセット {
