オルガの各種カットは、
スネークが主観時ではなく、かつビハインド時でも無いときに発動
し、各カット初回の一回のみ発動、とする。

	// 主観ではなく、ビハインドしてもいなければ…
	if(!`%PlayerStatus -f d:TRP_STATE_SUBJECT d:TRP_STATE_BEHIND`) {

*/

// オルガカット終了時共通処理。バグ回避のため、終了を２フレーム遅らせる。
proc オルガカットカメラ終了 {
	chara delay ディレイ -time 2 -exec {
		chara カメラ設定 オルガカットカメラ -s -1
	}
}


proc オルガホロ撃ち時 {
#if d:オルガホロ撃ち時x

		// 何フレーム見せるか
		eval($i:w00b_delay_time = 150)

		// レーダー画面制御
		@オルガ各種カット時レーダー画面制御 $i:w00b_delay_time

		// シネマスクリーン
		@シネマスクリーン使用 $i:w00b_delay_time

		command パッド操作 -release

		@特殊装備解除

		mesg ボスオルガ オルガ 回避無効

		@ホロ下のIRセンサー水飛沫セット

		chara カメラ設定 オルガカットカメラ \
			-c 1 \
			-p -21366,15703,-20372 -t -18004,13369,-16651 \
			-r 284,479,0 -f 5531 \
			-a 170 \
			-i 0 0 0 0  \
			-s 1

		// ひも当たり位置変更
		mesg プットホロオブジェ ホロ 右紐当たり位置変更 -15950 12800 -18000

		// ホロの向こう側のオルガに対するロックオン防止機構設置
		@オルガ戦第二フェーズロックオン防止壁発動

		chara delay ディレイ -time $i:w00b_delay_time -exec {
			#if 1
				@オルガカットカメラ終了
			#else
				chara カメラ設定 オルガカットカメラ -s -1
			#endif
			mesg ボスオルガ オルガ 回避有効
			command パッド操作 -cancel
		}

#endif
}

proc オルガ戦勝利後デモへ {
	//ＳＥをフェードで消してから、
	command セットサウンドコード -c d:SE_JOUCHUU_OFF

/*
	//もっかいだけチャンスをあげるぷりーん
	print 'もう１回だけサボり兵のチャンスをあげるよーん！！！！！！'
	eval($f:休憩兵イベント発生 = 0)
*/
	// オルガ戦後デモステージをロード
	//load "d05t" -no_save 0
	if( $$f:ＵＳＰで倒した ) {
		@紙芝居ステージロード d:TALES_C:メリルＵＳＰで倒した
	} else {
		@紙芝居ステージロード d:TALES_C:メリルＭ９で倒した
	}
}


proc 死に場所雨増加とスロー発動 {

	chara 雨速度可変 slow_rain \
	-n 32 \		// 量
	-c 128		// 輝度

	// 速度可変雨の速度を変更するchara
	chara スローパラメータ制御 スローにする -s 35

	// スローかける
	chara delay ディレイ -time 1 -exec {
		chara 速度可変 可変 \
		-l 120 \
		-t 2
	}

	// ブラーかける
	chara ブラー オカジーブラー -i 72
}

proc 壊れ物ステータス引継 {
	// ホロの状態の保存
	command ゲットホロ状況 $i:w00b_ホロステータス

	// 投光器の状態の保存
	/* @投光器壊れた で保存した */

	// ピンライトの状態の保存
	// 出来るか？体験版後に森田さん？

}

proc オルガ死に時 {
#if d:オルガ各種カット
	#if d:オルガ死に時x

		
		if( $1 == 1 ) {
			print 'ＵＳＰで倒した'
			$$f:ＵＳＰで倒した = 1;
		} else {
			$$f:ＵＳＰで倒した = 0;
		}
		
		@レーダー画面消去
		@壊れ物ステータス引継

		#if d:体験版
		#else
			// 死んだ場所によって、どちらの戦後デモへ送るか決める。
			command ゲットオルガ座標 $i:Ｘ座標変数 $i:Ｙ座標変数 $i:Ｚ座標変数
			if($i:Ｚ座標変数 < -16000) {
				eval($f:w00b_オルガ柵によりかかり = 0)
			} else {
				eval($f:w00b_オルガ柵によりかかり = 1)
			}
		#endif

		// まずはパッドリリース
		command パッド操作 -release

		@特殊装備解除

#ifndef d:BOSS_MODE
		// シネマスクリーン起動
		@シネマスクリーン使用 600 // そのままフェードアウトするので、適当に長目に。

		// オルガの映り込みを消して
		mesg 鏡面モデル管理 床面映り込みオルガ del オルガ

		preseek 'd05t'
		// ホワイトフェード
		chara delay ディレイ -time 30 -exec {
			chara フェードインアウト フェードイン \
			-c 255,255,255 128 \
			-t 210 \
			-s 1 // 何か値を入れると優先低くなる。


			// に引き続いて黒くフェード
			chara delay ディレイ -time 210 -exec {

				chara delay ディレイ -time 30 -exec {
					if($f:w00b_オルガ柵によりかかり) {
						command ＳＥセットモード -s d:se_code:SD_E_ORGABR01 -p -17391 12225 -10618 -m 3
					}else{
						command ＳＥセットモード -s d:se_code:SD_E_ORGABR02 -p -17391 12225 -10618 -m 3
					}
				}

				chara フェードインアウト フェードイン \
				-c 0,0,0 128 \
				-t 120 \
				-s 1
			}

		}

		chara delay ディレイ -time 15 -exec {

			// ＢＧＭをフェードで消してから、
			command セットサウンドコード -c d:SNG_FOUTS_L

			// 他のオブジェにカメラがめり込む等の面倒を避けるため、オルガを瞬間移動
			mesg ボスオルガ オルガ オルガ瞬間移動 \
				-18750 12750 -10000 1024

			// 下からのアオリ固定アングル
				// 新倒れモーション
				chara カメラ設定 オルガカットカメラ人生 \
					-c 1 \
					-p -17391,12225,-10618 -t -18449,13031,-9947 \
					-r -373,3440,0 -f 1490 \
					-a 158 \
					-i 0 0 0 0  \
					-s 1

			// 死に場所雨増加＆スロー発動
			@死に場所雨増加とスロー発動
		}

		// オルガ戦後デモへ
		chara delay ディレイ -time 360 -exec {
			#if 0
				@オルガカットカメラ終了
			#else
				chara delay ディレイ -time 2 -exec {
					chara カメラ設定 オルガカットカメラ人生 -s -1
				}
			#endif
			command パッド操作 -cancel

			//ゲーム中の処理
			@オルガ戦勝利後デモへ
		}
#else
		// ＢＧＭをフェードで消してから、
		command セットサウンドコード -c d:SNG_FOUTS_L
		//ボスラッシュ時の処理
		@ボスラッシュ終了時処理
#endif

	#endif
#endif
}

proc オルガグレネードなげ時 {
#if d:オルガ各種カット
	#if d:オルガグレネードなげ時x

	print '投げ'
		#if 1

		if(!$f:rft_オルガ戦オルガグレネード投げた){			//fukushima
			eval($f:rft_オルガ戦オルガグレネード投げた = 1)	//fukushima
		}													//fukushima

		#else

		// 主観ではなく、ビハインドしてもいなければ…
		if(!`%PlayerStatus \
			-f d:TRP_STATE_SUBJECT \
			   d:TRP_STATE_BEHIND`) {

			if(!$f:w00b_オルガグレネードなげ時初回終了){

				command パッド操作 -release

				@特殊装備解除

				mesg ボスオルガ オルガ 回避無効

				// 何フレーム見せるか
				eval($i:w00b_delay_time = 120)

				// レーダー画面制御
				@オルガ各種カット時レーダー画面制御 $i:w00b_delay_time

				// シネマスクリーン
				@シネマスクリーン使用 $i:w00b_delay_time

				command ゲットオルガ目的地 $i:目的地 $i:現在地
				eval($i:攻撃_行動地 = $i:目的地)

				// コンテナに隠れてグレネードなげ
				if($i:攻撃_行動地 == 1) {
					chara カメラ設定 オルガカットカメラ \
						-c 1 \
						-p -12330,12929,-15146 \
						-t -14626,14197,-18051 \
						-a 200 \
						-i 0 0 0 0  \
						-s 1

		print 'コンテナ隠れて投げ'

				// ロッカーに隠れてグレネードなげ
				} else if($i:攻撃_行動地 == 0) {

					@パンカメラプロック \
						-10953 14756 -10655 \
						-14467 13116 -16129 \
						-13153 14746 -9233 \
						-16683 13116 -14696 \
						280 \
						$i:w00b_delay_time \
						1

		print 'ロッカー隠れて投げ'

				// ホロに隠れてグレネードなげ
				} else if($i:攻撃_行動地 == 2) {

					// 各隠れ場所の左右どちらか？
					command ゲットオルガフラグ $i:フラグ

					// ホロの右端
					if($i:フラグ & d:flag_t:ORGA_F_DANGR_LEFT){

					@パンカメラプロック \
						-10965 14788 -23622 \
						-14789 14575 -21024 \
						-10251 14788 -22573 \
						-14070 14575 -19970 \
						170 \
						$i:w00b_delay_time \
						1

		print 'ホロ隠れ船首側投げ'

					// ホロの左端
					} else if($i:フラグ & d:flag_t:ORGA_F_DANGR_RIGHT){

						chara カメラ設定 オルガカットカメラ \
							-c 1 \
							-p -17277,25546,-13423 \
							-t -17779,21002,-14260 \
							-a 433 \
							-i 0 0 0 0  \
							-s 1

		print 'ホロ隠れ船尾側投げ'

					}
				}

				chara delay ディレイ -time $i:w00b_delay_time -exec {
					#if 1
						@オルガカットカメラ終了
					#else
						chara カメラ設定 オルガカットカメラ -s -1
					#endif
					mesg ボスオルガ オルガ 回避有効
					command パッド操作 -cancel
				}

				eval($f:w00b_オルガグレネードなげ時初回終了 = 1)

			}
		}

		#endif

	#endif
#endif
}

