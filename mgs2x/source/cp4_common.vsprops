<?xml version="1.0" encoding="Windows-1252"?>
<VisualStudioPropertySheet
	ProjectType="Visual C++"
	Version="8.00"
	Name="cp4_common"
	>
	<Tool
		Name="VCCLCompilerTool"
		AdditionalIncludeDirectories="&quot;$(ProjectDir)&quot;;&quot;$(MGS_ROOT)/bp/shared&quot;;&quot;$(BPE_ROOT)/Source&quot;;&quot;$(BPE_ROOT)/Source/ExtLibraries/DXSDK/Include&quot;;&quot;$(BPE_ROOT)/Source/ExtLibraries/libPad/include&quot;;&quot;$(BPE_ROOT)/Source/ExtLibraries/lua-5.0.2/include&quot;;&quot;$(BPE_ROOT)/Source/ExtLibraries/Boost/include&quot;;&quot;$(MGS_ROOT)/mgs2x/source/include&quot;;&quot;$(MGS_ROOT)/mgs2x/source/include/ps2&quot;;&quot;$(MGS_ROOT)/mgs2x/source/game&quot;;&quot;$(MGS_ROOT)/mgs2x/source/main&quot;;&quot;$(MGS_ROOT)/mgs2x/source/user&quot;;&quot;$(MGS_ROOT)/mgs2x/source/system/libdg&quot;;&quot;$(MGS_ROOT)/mgs2x/source/system/libfs&quot;;&quot;$(MGS_ROOT)/mgs2x/source/system/libgcl&quot;;&quot;$(MGS_ROOT)/mgs2x/source/system/libgv&quot;;&quot;$(MGS_ROOT)/mgs2x/source/system/libhzx&quot;;&quot;$(MGS_ROOT)/mgs2x/source/system/libmt&quot;;&quot;$(MGS_ROOT)/mgs2x/source/system/libutl&quot;;&quot;$(MGS_ROOT)/mgs2x/module/include&quot;"
		PreprocessorDefinitions="BP_WIN32;ENGLISH;MGS_MASTER;MGS_VERSION=2;$(CP4_USER);PSX2"
		WholeProgramOptimization="false"
	/>
	<Tool
		Name="VCLinkerTool"
		AdditionalLibraryDirectories="$(BPE_ROOT)/Source/ExtLibraries/DXSDK/Lib/x86"
	/>
</VisualStudioPropertySheet>
