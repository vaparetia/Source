/* オブジェクト構造体へのポインタを接続 */
void		GM_ConfigControlObject( ctrl, object ) 
CONTROL		*ctrl ;
OBJECT		*object ;
{
    ctrl->object = object ;
}

/* 当たりチェックしないからハザード格納領域は
   いらない */
void		GM_ConfigControlNoSegmentArea( ctrl )
CONTROL		*ctrl ;
{
    GV_Free( ctrl->segs[ 0 ] ) ;
    ctrl->segs[ 0 ] = NULL ;
    ctrl->segs[ 1 ] = NULL ;
    ctrl->level[ 0 ] = NULL ;
    ctrl->level[ 1 ] = NULL ;
}

/* 位置からマップＩＤを設定 */
void	GM_ConfigControlMapID( ctrl )
CONTROL		*ctrl ;
{
    int		z ;

    ctrl->hzx_id = HZX_GetHzxIDbyZone( 0, &ctrl->mov, &z ) ;

    ctrl->addr = HZX_AddressNo( GV_GetNo( ctrl->hzx_id ), z, z ) ;
    GM_ChangeControlMapFromHzxId( ctrl, ctrl->hzx_id ) ;
    GM_SetCurrentMap( ctrl->map ) ;
}

/* 初期位置設定 */
void		GM_ConfigControlPosition( ctrl, pos, rot )
CONTROL		*ctrl ;
FVECTOR		*pos ;
SVECTOR		*rot ;
{
    ctrl->mov = *pos ;
    ctrl->rot = *rot ;
    ctrl->turn = *rot ;
    GM_ConfigControlMapID( ctrl ) ;
}

/* 当たり判定パラメータ設定 */
void		GM_ConfigControlHazard( ctrl, height, r_sphere, s_sphere )
CONTROL		*ctrl ;
int		height ;
int		r_sphere ;
int		s_sphere ;
{
    ctrl->height = (float)height ;
    ctrl->r_sphere = r_sphere ;
    ctrl->s_sphere = s_sphere ;
}

/* 当たり判定高さおよび初期床高さ設定 */
