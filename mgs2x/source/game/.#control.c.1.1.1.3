static	void	ResetHeightMotion( CONTROL *ctrl )
{
	MOTION_CONTROL	*m_ctrl ;
	OBJECT			*body ;
	float			height ;

	body = ctrl->object ;
	m_ctrl = body->m_ctrl ;

	/* 高さ調整 */
	height = m_ctrl->mt3_ctrl[ 0 ].move->step.vw ;
	m_ctrl->height = height ;
	m_ctrl->old_height = height ;
	body->height = height ;
	ctrl->height = height ;

	ctrl->hzx_base = ctrl->mov.vy - height ;

	/* ルート位置調整 */
	height = m_ctrl->mt3_ctrl[ 0 ].root->step.vw ;
	m_ctrl->root_height = height ;
	m_ctrl->root_old_height = height ;

	/* step.vyは0に */
	ctrl->step.vy = 0.0F ;
}

/*------------------------------------------------------------------*/

void		GM_ActControl( ctrl )
CONTROL		*ctrl ;
{
    int			interp, flag ;
	float		tmp = 0.0F ;
    int			hzx_check_again ;
    FVECTOR		step_buf = DG_ZeroVector ;
	FVECTOR		pmov ;
	//    int			r_sphere_buf, s_sphere_buf ;
#ifdef DEBUG_MODE
    int			intime, outtime ;
#endif

#ifdef DEBUG_MODE
    intime = GET_HSYNC_TIMER() ;
#endif

#ifdef PSX2	/// ?本体が見つからない
if(0){	/* 円あたり跳ね返り実験 */
extern	void	GM_SphereBounce( CONTROL *ctrl ) ;

GM_SphereBounce( ctrl ) ;
}
#endif ///
    /*
       メッセージ／イベントを処理する
	   */
    GM_CurrentMap = ctrl->map ;

    hzx_check_again = 0 ;
    flag = ctrl->skip_flag ;
	DG_COPY_VEC( &pmov, &ctrl->mov ) ;
	/* モーション変更時高さ調節機能 */
	if ( ( flag & CTRL_RESET_HEIGHT ) &&
		 ( ctrl->motion_num >= 0 && 
		   ctrl->motion_num != ctrl->object->m_ctrl->mt3_ctrl[ 0 ].motion_num ) ) {
		ResetHeightMotion( ctrl ) ;
		ctrl->motion_num = -1 ;
		ctrl->skip_flag &= ~CTRL_RESET_HEIGHT ;
	}

hazard_check_again :
    /* 壁チェック */
    if ( !( flag & CTRL_SKIP_SEG_CHECK ) ) {
		ctrl->n_touches = 0 ;
		if ( DG_FABS( ctrl->hzx_height - HZX_HEIGHT_NO_USE ) > 0.1F ) {
			tmp = ctrl->mov.vy ;
			ctrl->mov.vy = ctrl->hzx_height + ctrl->hzx_base ;
			/* 有効桁数落ち防止の為、強引に整数化する */
			ctrl->mov.vy = ( float )( ( int )ctrl->mov.vy ) ;
		} else {
			tmp = ctrl->mov.vy ;
			ctrl->mov.vy = ( float )( ( int )ctrl->mov.vy ) ;
		}
		if ( !( flag & CTRL_SKIP_ONLINE_CHECK ) ) CheckOnlineHazard( ctrl ) ;
		/* 直方体チェック */
#if 0
		if ( ctrl->skip_flag & CTRL_COLLIDE_CHECK ) { 
			HZX_DetCollide( ctrl, ctrl->col_width, ctrl->col_length ) ;
			r_sphere_buf = ctrl->r_sphere ;
			s_sphere_buf = ctrl->s_sphere ;
			ctrl->r_sphere = MinInt( ( int )ctrl->col_width, ( int )ctrl->col_length ) ;
			ctrl->s_sphere = MaxInt( ( int )ctrl->col_width, ( int )ctrl->col_length ) ;
		}
#endif
		ctrl->mov.vx += ctrl->step.vx ;
		ctrl->mov.vz += ctrl->step.vz ;
		if ( !( flag & CTRL_SKIP_NEAR_CHECK ) ) CheckNearHazard( ctrl ) ;
#if 0
		if ( ctrl->skip_flag & CTRL_COLLIDE_CHECK ) { 
			ctrl->r_sphere = r_sphere_buf ;
			ctrl->s_sphere = s_sphere_buf ;
		}
#endif
		/* hzx_heightなしでも整数化するようにした */
		//if ( DG_FABS( ctrl->hzx_height - HZX_HEIGHT_NO_USE ) > 0.1F ) {
			ctrl->mov.vy = tmp ;
		//} 
    } else {
		ctrl->n_touches = 0 ;
		ctrl->mov.vx += ctrl->step.vx ;
		ctrl->mov.vz += ctrl->step.vz ;
    }
    /* 床チェック */
    if ( !( flag & CTRL_SKIP_FLR_CHECK ) ) {
		if ( flag & CTRL_RESET_HZX_BASE ) {
			ctrl->hzx_base = ctrl->mov.vy - ctrl->height ;
			ctrl->skip_flag &= ~CTRL_RESET_HZX_BASE ;
		}
		CheckLevelHazard( ctrl ) ;
    } else {
		ctrl->mov.vy += ctrl->step.vy ;	    
    }
    ctrl->hzx_base = ctrl->mov.vy - ctrl->height ;

    /* アドレス変更チェック */
    if ( !( flag & CTRL_SKIP_GET_ADDRESS ) ) {
		FVECTOR		mov ;

		if ( ctrl->addr_mov == NULL ) {
			/* +25.0f は誤差吸収 */
			mov = ctrl->mov ; mov.vy = ctrl->hzx_base + 25.0F ;
		} else {
			mov = *( ctrl->addr_mov ) ;
		}
		ctrl->addr = HZX_GetAddress( ctrl->hzx_id, &mov, ctrl->addr ) ;
#ifdef _XBOX
		GM_CurrentAddr = ctrl->addr;
#endif
    }
    /* マップ変更チェック */
    if ( !( flag & CTRL_SKIP_CHANGE_MAP ) ) {
		if ( GM_CheckChangeGroup( ctrl, &pmov ) ) {
#ifdef DEBUG_MODE
			if ( hzx_check_again ) printf( "same frame map change\n" ) ;
#endif
			/* ステップ値を０クリアして
			   もう一回ハザードチェック */
			GM_SetCurrentMap( ctrl->map ) ;
			step_buf = ctrl->step ;
			ctrl->step = DG_ZeroVector ;
			DG_COPY_VEC( &pmov, &ctrl->mov ) ;
			hzx_check_again = 1 ;
			goto hazard_check_again ;
		}
    }
    /* ステップ値を戻す */
    if ( hzx_check_again ) ctrl->step = step_buf ;

    /* 向き更新 */
    if ( ( interp = ctrl->interp ) == 0 ) {
#ifdef PAL
#if 0
		if ( ( GV_PadDataDirect[ 1 ].status & PAD_A ) &&
			 ( GV_PadDataDirect[ 1 ].status & PAD_B ) ) {
			GV_NearExp8PVPAL( &( ctrl->rot ), &( ctrl->turn ), 3 ) ;
		} else {
			GV_NearExp8PV( &( ctrl->rot ), &( ctrl->turn ), 3 ) ;
		}
#else
		GV_NearExp8PVPAL( &( ctrl->rot ), &( ctrl->turn ), 3 ) ;
#endif
#else
		GV_NearExp8PV( &( ctrl->rot ), &( ctrl->turn ), 3 ) ;
#endif
    } else {
		GV_NearTimePV2( &( ctrl->rot ), 
					  &( ctrl->turn ), interp, 3 ) ;
		ctrl->interp = interp - 1 ;
    }

    /* トラップチェック */
    if( !( flag & CTRL_SKIP_TRAP ) ){
		FVECTOR		mov, *buf ;
		int			trap_check_again, oldmap ;
		/*
		   トラップに侵入／離脱した場合、イベントを発生
		   */
		/* ctrl->movでチェックしない（モーションルートを使用する）
		   リンクゾーン中は無視 */
		oldmap = ctrl->map ;
		trap_check_again = 0 ;
recheck_trap :
		if ( ctrl->root_offset != NULL && ctrl->link_zone == NULL ) {
			buf = ctrl->evt.mov ;
			_sceVu0AddVector( &mov, &ctrl->mov, ctrl->root_offset ) ;
			ctrl->evt.mov = &mov ;
			HZX_EnterTrap( ctrl->hzx_id, &( ctrl->evt ) ) ;
			ctrl->evt.mov = buf ;
		} else {
			HZX_EnterTrap( ctrl->hzx_id, &( ctrl->evt ) ) ;
		}
		if ( trap_check_again == 0 && oldmap != ctrl->map ) {
			/* トラップ処理中にマップが変更された */
			trap_check_again = 1 ;
			goto recheck_trap ;
		}
    }

    /* メッセージチェック */
    if ( !( flag & CTRL_SKIP_MESSAGE ) ) {
		CheckMessage( ctrl ) ;
    }
    /* 定数回転マトリクスをセット */
    DG_SetPos2( &( ctrl->mov ), &( ctrl->rot ) ) ;
#ifdef DEBUG_MODE
	/* ワールドリミットチェック */
	if ( ctrl->mov.vy > GM_WORLD_LIMIT_UPPER * 2.0F  ||
		 ctrl->mov.vy < GM_WORLD_LIMIT_BOTTOM * 2.0F ) {
		GV_ERROR( GV_ERROR_WORLD_BOTTOM ) ;
	}

#endif
#ifdef DEBUG_MODE
    outtime = GET_HSYNC_TIMER() ;
    ctrl->runtime += DIFF_HSYNC_TIMER( outtime, intime ) ;
    ctrl->count ++ ;
#endif
}

