GV_MSG *GM_CheckMessage( void *work, long name, long msgcode )
{
	GV_MSG *msg;
	long n_msg;

	n_msg = GV_ReceiveMessage( name, &msg );
	while( -- n_msg >= 0 ){
		if( msg->message[ 0 ] == msgcode ){
			return msg;
		}
		msg++;
	}
	return NULL;
}
