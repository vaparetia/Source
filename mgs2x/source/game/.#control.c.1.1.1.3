		CONTROL		*ctrl ,
		float		height, float base )
{
    ctrl->hzx_height = height ;
    ctrl->hzx_base = base ;
}

/* 当たりフラグを設定 */
void		GM_ConfigControlHzxCheckFlag( ctrl, segflag, flrflag )
CONTROL		*ctrl ;
int			segflag, flrflag ;
{
	ctrl->seg_flag = segflag ;
	ctrl->flr_flag = flrflag ;
}

/* マップ変更チェックする */
void	GM_ConfigControlMapCheck( CONTROL *ctrl )
{
    ctrl->skip_flag &= ~( CTRL_SKIP_CHANGE_MAP | CTRL_SKIP_GET_ADDRESS ) ;
}

/* ゾーン変更チェックする */
void	GM_ConfigControlAddressCheck( CONTROL *ctrl )
{
    ctrl->skip_flag &= ~CTRL_SKIP_GET_ADDRESS ;
}

/* トラップチェックする */
void	GM_ConfigControlTrapCheck( CONTROL *ctrl )
{
    if ( ctrl->name == 0 ) return ;
    ctrl->skip_flag &= ~CTRL_SKIP_TRAP;
    HZX_SetEvent( &( ctrl->evt ), ctrl->name, &ctrl->mov, &ctrl->rot ) ;
}

/* メッセージをチェックする */
void	GM_ConfigControlMessageCheck( CONTROL *ctrl )
{
    if ( ctrl->name == 0 ) return ;
    ctrl->skip_flag &= ~CTRL_SKIP_MESSAGE ;
