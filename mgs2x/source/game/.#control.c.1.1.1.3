void		GM_FreeControl( ctrl )
CONTROL		*ctrl ;
{
	if ( ctrl->name > 128 ) DequeueWhere( ctrl ) ;
	if ( ctrl->segs[ 0 ] != NULL ) GM_ConfigControlNoSegmentArea( ctrl ) ;
}

