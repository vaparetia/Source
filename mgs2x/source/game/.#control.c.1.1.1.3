/* マップチェンジ */
int	GM_ComMapChange( void )
{
	CONTROL		*ctrl ;
	int			name, mapname, map, oldmap ;

	GCL_GetOption( 'n' ) ;
	name = GCL_GetNextInt() ;
	ctrl = GM_SearchWhere( name ) ;
	ASSERT( ctrl != NULL ) ;
	GCL_GetOption( 'm' ) ;
	mapname = GCL_GetNextInt() ;
	map = GM_GetMapID( mapname ) ;
	oldmap = ctrl->map ;
	GM_ChangeControlMapFromMapId( ctrl, map ) ;
	ctrl->addr = HZX_GetAddress( ctrl->hzx_id, &ctrl->mov, -1 ) ;
	return 1 ;
}

