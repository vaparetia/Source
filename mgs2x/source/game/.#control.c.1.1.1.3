/* 倒れている状態を計算 １ならあお向け０ならうつぶせ*/
int	GM_GetFallTypeForGCL( void )
{
	GCL_VAR_REF ref; //配列への参照データ
	int name, fall_type ;
	CONTROL	*ctrl ;
	FMATRIX	mat, *w ;
	static FVECTOR Front = { 0.0, 0.0, 100.0 } ;

	if ( GCL_NextStr() == NULL ) return -1 ;
	name = GCL_GetNextInt() ;

//printf(" get enemy pos [%d]\n",name ) ;
	ctrl = GM_SearchWhere( name ) ;

	if ( ctrl->object == NULL ) {
		printf("WARNING!! GM_GetFallTypeForGCL NO BODY!!!!!! \n");
		return -1 ;
	}

	w = &ctrl->object->objs->objs[0].world ;
	DG_SetPos( w ) ;
	DG_MovePos( &Front ) ;
	DG_GetPos( &mat ) ;

	fall_type = ( mat.m[3][1] > w->m[3][1] ) ? 1 : 0 ;

	if ( GCL_NextStr() == NULL ) return -1 ;
	GCL_GetNextVarRef( &ref ); // 参照データの取得
	GCL_SetVarRef( &ref, 0, (int)fall_type );

	return 1 ;
}

