int		GM_CheckControlTouches( ctrl, range )
CONTROL		*ctrl ;
int		range ;
{
	int		n_touches ;

	n_touches = ctrl->n_touches ;
	if ( n_touches == 0 ) return 0 ;
	if ( n_touches == 2 ) {
		if ( ctrl->segs[ 1 ]->p1.h < 0
			|| GV_VecLen3( ctrl->vecs + 1 ) <= range ) return 2 ;
	}
	if ( ctrl->segs[ 0 ]->p1.h < 0
		|| GV_VecLen3( ctrl->vecs ) <= range ) return 1 ;
	return 0 ;
}

