/* コントロールのポジションを強制移動する */
void	GM_ResetControlPosition( ctrl, vec )
CONTROL		*ctrl ;
FVECTOR		*vec ;
{
    ctrl->mov = *vec ;
	if ( DG_FABS( ctrl->hzx_height - HZX_HEIGHT_NO_USE ) > 0.10F ) {
		ctrl->hzx_base = vec->vy - ctrl->height ;
		/* 床チェックする */
		if ( !( ctrl->skip_flag & CTRL_SKIP_FLR_CHECK ) ) {
			FVECTOR		mov ;
			int			flag ;

			mov.vx = ctrl->mov.vx ;
			mov.vz = ctrl->mov.vz ;
			mov.vy = ctrl->hzx_base + ctrl->hzx_height ;
			flag = HZX_LevelHazardCheck( ctrl->hzx_id, 
										 &mov, ctrl->hzx_check_type, 
										 ctrl->flr_flag ) ;
			if ( flag != 0 ) {
				HZX_GetLevelHeight( ctrl->levels ) ;
				HZX_GetLevelHazard( ctrl->level[ 0 ], ctrl->flr_atrs ) ;
			} 
			if ( !( flag & 1 ) ) ctrl->levels[ 0 ] = GM_WORLD_LIMIT_BOTTOM ;
			if ( !( flag & 2 ) ) ctrl->levels[ 1 ] = GM_WORLD_LIMIT_UPPER ;
			ctrl->level_found = flag ;
		}
    }
}

/* コントロールのポジションとグループとゾーンアドレスを強制移動する */
/* アドレスはhzx_idの中から探す。hzx_id == 0 のときは、
   移動先座標がどのグループに属するかを調べて、その中から
   探す */
void	GM_ResetControlPositionAndGroup( ctrl, vec, hzx_id )
CONTROL		*ctrl ;
FVECTOR		*vec ;
int			hzx_id ;
{
    extern void	HZX_Pos2Zone( FVECTOR *, int *, int * ) ;
    int g, z ;

    z = -1 ;
    if ( hzx_id == 0 ) {
		HZX_Pos2Zone( vec, &g, &z );
		hzx_id = GM_GetBit( g ) ;
    }
    GM_ChangeControlMapFromHzxId( ctrl, hzx_id );
    ctrl->addr = HZX_GetAddress( hzx_id, vec, z ) ;
    GM_ResetControlPosition( ctrl, vec ) ;
}

/* トラップ進入チェック */
/* 返り値はビットフラグ（入っていたら１） */
int		GM_CheckInsideTrap( ctrl, traps, n, mode )
CONTROL		*ctrl ;
u_int		*traps ;	/* チェックしたいトラップ列 */
int		n ;		/* チェックしたいトラップの数 */
int		mode ;		/* 0/1 : ナンバーチェックなし/あり */ 
{
    u_int	*inside, res, trap, trap2, i ;
    int		n_inside, mask ;

    ASSERT( 0 < n && n < 32 ) ;
    if ( mode == 0 ) mask = 0x00ffffff ;
    else	     mask = 0xffffffff ;
    res = 0 ;
    n_inside = ctrl->evt.n_inside ;
    inside = ctrl->evt.inside ;
    while ( -- n_inside >= 0 ) {
		trap = ( *inside ) & mask ;
		for ( i = 0; i < (u_int)n; i ++ ) {
			trap2 = traps[ i ] & mask ;
			if ( trap == trap2 ) res |= ( 1 << i ) ;
		}
		inside ++ ;
    }    
    return res ;
}

/* ワールドリミットチェック */
int	GM_CtrlWorldLimit( CONTROL *ctrl )
{
	if ( ctrl->mov.vy <= GM_WORLD_LIMIT_BOTTOM ||
		 ctrl->mov.vy >= GM_WORLD_LIMIT_UPPER ) return 1 ;
	return 0 ;
}

/* モーション切り替え時に高さを設定しなおす */
void		GM_ControlResetHeightMotion( CONTROL *ctrl )
{
	ASSERT( ctrl->object != NULL && ctrl->object->m_ctrl != NULL ) ;
	ctrl->skip_flag |= CTRL_RESET_HEIGHT ;
	ctrl->motion_num = ctrl->object->m_ctrl->mt3_ctrl[ 0 ].motion_num ;
}

