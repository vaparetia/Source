/* マップ移動をチェック */
int GM_CheckChangeGroup( CONTROL *ctrl, FVECTOR *pmov )
{
    HZX_GROUP_ID hzx_id;
	FVECTOR		 mov ;

    hzx_id = ctrl->hzx_id;

	if ( ctrl->addr_mov == NULL ) {
		DG_COPY_VEC( &mov, &ctrl->mov ) ;
		mov.vy = ctrl->hzx_base + 25.0F ;
	} else {
		DG_COPY_VEC( &mov, ctrl->addr_mov ) ;
	}

    ctrl->link_zone = HZX_CheckChangeGroup( &hzx_id, &mov, ctrl->link_zone, &ctrl->addr ) ;
    if( ctrl->hzx_id != hzx_id ){
		/* 切替えが検出された */
		GM_ChangeControlMapFromHzxId( ctrl, hzx_id ) ;
		return 1 ;
    }
	if ( GM_CheckMapChangeTrap( ctrl, pmov ) ) {
		/* 切替えが検出された */
		return 1 ;
	}
	/* ゾーン外にいるときは、オンラインマップ変更チェック */
	{
		u_char		z1, z2 ;

		z1 = ctrl->addr & 0xff ;
		z2 = ( ctrl->addr & 0xff00 ) >> 8 ;
		if ( z1 != z2 ) {
			ctrl->link_zone = HZX_CheckChangeGroupMapLink( &hzx_id, pmov, &ctrl->mov, 
														   ctrl->link_zone, &ctrl->addr ) ;
			if ( ctrl->hzx_id != hzx_id ) {
				GM_ChangeControlMapFromHzxId( ctrl, hzx_id ) ;
				return 1 ;
			}
		}
	}
    return 0 ;
}

