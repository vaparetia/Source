/*
   移動直線上の障害物をチェック
   */
static	inline	void	CheckOnlineHazard( CONTROL *ctrl )
{
    FVECTOR		to ;
    float 		len1, len2 ;
	int			which ;

	ctrl->attribute &= ~( CTRL_ATR_ONLINE_SEG | CTRL_ATR_ONLINE_FLR ) ;
    _sceVu0AddVector( &to, &( ctrl->mov ), &( ctrl->step ) ) ;
    if ( ( ctrl->skip_flag & CTRL_HZX_SEG_HORIZON_CHECK ) ) {
		if ( ( DG_FABS( ctrl->step.vy ) < ctrl->height / 2.0F ) ) {
			to.vy = ctrl->mov.vy ;
		} else {
			//printf( "horizon online -- large step.vy %f\n", ctrl->step.vy ) ;
		}
	}
    if ( HZX_OnlineHazardCheck( ctrl->hzx_id, &( ctrl->mov ), &to, ctrl->hzx_check_type, 
							   ctrl->seg_flag, ctrl->flr_flag ) ) {
		ctrl->n_touches = 1 ;
		which = HZX_GetOnlineHazardType() ;
		if ( which == HZX_ONLINE_TYPE_SEGMENT ) ctrl->attribute |= CTRL_ATR_ONLINE_SEG ;
		else									ctrl->attribute |= CTRL_ATR_ONLINE_FLR ;
		if ( ctrl->level[ 0 ] != NULL ) {
			HZX_GetOnlineHazard( ctrl->level[ 0 ], ctrl->flr_atrs ) ;
			//HZX_ViewHazard( ctrl->level[ 0 ] ) ;
		}
		HZX_GetOnlineVector( ctrl->vecs ) ;
		len1 = GV_VecLen3F( ctrl->vecs ) ;
		len2 = len1 - ( float )( ctrl->r_sphere / 2 ) ;
#ifdef DEBUG_MODE
		if ( !GM_CheckGameStatus( STATE_DEMO ) && len1 < 0.010F ) {
			printf( "on hazard : %.2f %.2f %.2f\n", 
				   ctrl->mov.vx, ctrl->mov.vy, ctrl->mov.vz ) ;
			GV_ERROR( GV_ERROR_JUST_ON_WALL ) ;
		} 
#endif
		if ( len2 < 0.0F ) {
			len2 = - len2 ;
			if ( DG_FABS( ctrl->step.vx ) < 0.010F &&
				 DG_FABS( ctrl->step.vy ) < 0.010F &&
				 DG_FABS( ctrl->step.vz ) < 0.010F ) {
				/* 動かない。（でいいのか？） */
				DG_COPY_VEC( &to, &DG_ZeroVector ) ;
			} else {
				GV_LenVec3F( &ctrl->step, &to, len1, len2 ) ;
				_sceVu0SubVector( &to, &DG_ZeroVector, &to ) ;
			}
		} else {
			GV_LenVec3F( ctrl->vecs, &to, len1, len2 ) ;
		}
		ctrl->step = to ;
    }
}

/* 近接壁との間に床があったらはじく */
static	int		CheckNearOnline( CONTROL *ctrl, HZX_HZD *segs, FVECTOR *near_vecs, 
								 int *atrs, signed char *is_edges, int n_touches )
{
	FVECTOR			to, near ;
	int				i, n ;
				
	n = n_touches ;
	for ( i = 0; i < n; i ++ ) {
		DG_COPY_VEC( &near, near_vecs + i ) ;	
		near.vy = 0.0F ;
		_sceVu0AddVector( &to, &ctrl->mov, &near ) ;
		
		//ViewFromTo( &ctrl->mov, &to, 232, 32, 32 ) ;

		if ( HZX_OnlineHazardCheck( ctrl->hzx_id, &ctrl->mov, &to,
								   HZX_CHK_FLOOR, 0, ctrl->flr_flag ) ) {	
#if 0
			{	
				HZX_HZD		flr ;

				HZX_GetOnlineHazard( &flr, NULL ) ;	
				HZX_ViewFloor( &flr, flr.p4.h ) ;
			}
#endif
			n_touches -- ;
			if ( i == 0 && n == 2 ) {
				segs[ 0 ] = segs[ 1 ] ;
				near_vecs[ 0 ] = near_vecs[ 1 ] ;
				atrs[ 0 ] = atrs[ 1 ] ;
				is_edges[ 0 ] = is_edges[ 1 ] ;
			}
			//printf( "<%d> n_touches %d\n", GV_Time, n_touches ) ;
		}
	}
	return n_touches ;
}

/*
   近接障害物をチェック２
*/
static	int		CheckNearHazard2( FVECTOR *react1, CONTROL *ctrl )
{
    FVECTOR		react = { 0.0F, 0.0F, 0.0F } ;
	FVECTOR		vecs[ 2 ], pos1 ;
	HZX_HZD		segs[ 2 ] ;
	signed char	is_edge[ 2 ] ;
	float		tmp, len ;
    int			n_touches, atrs[ 2 ] ;
    long		retry_flag;

	DG_COPY_VEC( &pos1, &ctrl->mov ) ;
	tmp = ctrl->mov.vy ;
//	ctrl->mov.vy = ctrl->hzx_base + ctrl->col_width ;
	ctrl->mov.vy = ctrl->hzx_base + ctrl->hzx_height2 ;

	if ( HZX_OnlineHazardCheck( ctrl->hzx_id, &pos1, &ctrl->mov, HZX_CHK_FLOOR,
							    0, ctrl->flr_flag ) ) {
		HZX_GetOnlinePoint( &ctrl->mov ) ;
		ctrl->mov.vy += 1.0F ;
	}

    retry_flag = 0;
NearCheckAgain2 :
    /* 近接障害物処理 */
    n_touches = HZX_NearHazardCheck( ctrl->hzx_id, &( ctrl->mov ), ctrl->s_sphere, 
									ctrl->hzx_check_type, ctrl->seg_flag, 
									ctrl->r_sphere ) ;
    if ( n_touches > 0 ) {
		HZX_GetNearVector( vecs ) ;
		HZX_GetIsEdge( is_edge ) ;
		HZX_GetNearHazard( segs, atrs ) ;
		n_touches = GM_HzxCheckConflict( n_touches, &ctrl->mov, segs, vecs, is_edge ) ;
		if ( ctrl->attribute & CTRL_ATR_NEARONLINE ) {
			//printf( "<%d>nearcheck2\n", GV_Time ) ;
			n_touches = CheckNearOnline( ctrl, segs, vecs, atrs, is_edge, n_touches ) ;
		}
		GM_GetHazardReaction( &react, n_touches, vecs, ctrl->r_sphere ) ;
#ifdef DEBUG
		if ( ( DG_FABS( vecs[ 0 ].vx ) < 0.010F ) &&
			 ( DG_FABS( vecs[ 0 ].vz ) < 0.010F ) ) {
			/* 壁上 */
			if ( retry_flag == 0 ) {
				/* ステップを少し戻して再チェック */	
				react.vx = ctrl->step.vx ;
				react.vy = 0.0F ;
				react.vz = ctrl->step.vz ;
				GV_LenVec3F( &react, &react, 0.0F, 8.0F ) ;
				_sceVu0SubVector( &ctrl->mov, &ctrl->mov, &react ) ;
				retry_flag = 1 ;	
#ifdef DEBUG_MODE
				if ( !GM_CheckGameStatus( STATE_DEMO ) ) {
					printf( "warning: near check - on hazard. try again\n" ) ;
					GV_ERROR( GV_ERROR_JUST_ON_WALL ) ;
				}
#endif
				goto NearCheckAgain2 ;
			} else {
#ifdef DEBUG_MODE
				if ( !GM_CheckGameStatus( STATE_DEMO ) ) {
					printf( "fatal!!! : near check - on hazard.\n" ) ;
					GV_ERROR( GV_ERROR_JUST_ON_WALL ) ;
					if ( GV_PadData[ 0 ].status & PAD_L1 ) HZX_ViewHazard( &segs[ 0 ] ) ;
				}
#endif
				return 0 ;
			}
		}
#endif		
#ifdef DEBUG
		/* 吹っ飛びの回避 */
		{
			float	len, rs ;

			rs = ( float )ctrl->r_sphere ;
			react.vy = 0.0F ;
			len = GV_VecLen3F( &react ) ;
//			if ( len > ctrl->r_sphere ) {
	        if ( ( ( DG_FABS( react.vx ) - rs * 2.0F ) > 0.0F ) ||
				 ( ( DG_FABS( react.vz ) - rs * 2.0F ) > 0.0F ) ) {
#ifdef DEBUG_MODE
				if ( !GM_CheckGameStatus( STATE_DEMO ) ) {
					printf( "warning : react vector is too large. auto adjust\n" ) ;
					GV_ERROR( GV_ERROR_NARROW_POS ) ;
					GM_ViewNarrowInfo( n_touches, &ctrl->mov, segs ) ;
				}
#endif	
				/* r_sphere * 2 までにとどめる */
				GV_LenVec3F( &react, &react, len, ( float )ctrl->r_sphere * 2.0F ) ;
			}
		}
#endif
    }
	len = GV_VecLen3F( &react ) ;
	if ( len > GV_VecLen3F( react1 ) ) {
		//printf( "<%d> nearcheck2 touches %d\n", GV_Time, n_touches ) ;
		ctrl->n_touches = n_touches ;
		react1->vx = react.vx ;
		react1->vz = react.vz ;
		HZX_GetNearVector( ctrl->vecs ) ;
		HZX_GetIsEdge( ctrl->is_edge ) ;
		if ( ctrl->segs[ 0 ] != NULL ) {
			HZX_GetNearHazard( ctrl->segs[ 0 ], ctrl->atrs ) ;		
		}
	}
	ctrl->mov.vy = tmp ;
	return n_touches ;
}

/*
   近接障害物をチェック
*/
static	inline	void	CheckNearHazard( CONTROL *ctrl )
{
    FVECTOR		react = { 0.0F, 0.0F, 0.0F } ;
    int			n_touches ;
	//    int			interp ;
    long		retry_flag;

    retry_flag = 0;
NearCheckAgain :
    /* 近接障害物処理 */
    n_touches = HZX_NearHazardCheck( ctrl->hzx_id, &( ctrl->mov ), ctrl->s_sphere, 
									ctrl->hzx_check_type, ctrl->seg_flag, 
									ctrl->r_sphere ) ;
    if ( n_touches > 0 ) {
		HZX_GetNearVector( ctrl->vecs ) ;
		HZX_GetIsEdge( ctrl->is_edge ) ;
		if ( ctrl->segs[ 0 ] != NULL ) {
			HZX_GetNearHazard( ctrl->segs[ 0 ], ctrl->atrs ) ;
			n_touches = GM_HzxCheckConflict( n_touches, &ctrl->mov, ctrl->segs[ 0 ], ctrl->vecs,
											 ctrl->is_edge ) ;
			if ( ctrl->attribute & CTRL_ATR_NEARONLINE ) {
				n_touches = CheckNearOnline( ctrl, ctrl->segs[ 0 ], ctrl->vecs, 
											 ctrl->atrs, ctrl->is_edge, n_touches ) ;
			}
		}
		ctrl->n_touches = n_touches ;
#ifdef DEBUG
		if ( ( DG_FABS( ctrl->vecs[ 0 ].vx ) < 0.010F ) &&
			 ( DG_FABS( ctrl->vecs[ 0 ].vz ) < 0.010F ) ) {
			/* 壁上 */
			if ( retry_flag == 0 ) {
				/* ステップを少し戻して再チェック */	
				react.vx = ctrl->step.vx ;
				react.vy = 0.0F ;
				react.vz = ctrl->step.vz ;
				GV_LenVec3F( &react, &react, 0.0F, 8.0F ) ;
				_sceVu0SubVector( &ctrl->mov, &ctrl->mov, &react ) ;
				retry_flag = 1 ;	
#ifdef DEBUG_MODE
				if ( !GM_CheckGameStatus( STATE_DEMO ) ) {
					printf( "warning: near check - on hazard. try again\n" ) ;
					GV_ERROR( GV_ERROR_JUST_ON_WALL ) ;
				}
#endif
				goto NearCheckAgain ;
			} else {
#ifdef DEBUG_MODE
				if ( !GM_CheckGameStatus( STATE_DEMO ) ) {
					printf( "fatal!!! : near check - on hazard.\n" ) ;
					GV_ERROR( GV_ERROR_JUST_ON_WALL ) ;
					if ( GV_PadData[ 0 ].status & PAD_L1 ) HZX_ViewHazard( ctrl->segs[ 0 ] ) ;
				}
#endif
				return ;
			}
		}
#endif		
//		HZX_GetReactVector( &react ) ;
		GM_GetHazardReaction( &react, n_touches, ctrl->vecs, ctrl->r_sphere ) ;

#ifdef DEBUG
		/* 吹っ飛びの回避 */
		{
			float	len, rs ;

			rs = ( float )ctrl->r_sphere ;
			react.vy = 0.0F ;
			len = GV_VecLen3F( &react ) ;
	        if ( ( ( DG_FABS( react.vx ) - rs * 2.0F ) > 0.0F ) ||
				 ( ( DG_FABS( react.vz ) - rs * 2.0F ) > 0.0F ) ) {
//			if ( len > ctrl->r_sphere ) {
#ifdef DEBUG_MODE
				printf( "[%d]warning : react vector is too large. auto adjust\n", GV_Time ) ;
				GV_ERROR( GV_ERROR_NARROW_POS ) ;
				GM_ViewNarrowInfo( n_touches, &ctrl->mov, ctrl->segs[ 0 ] ) ;
//				DumpVec( &ctrl->mov ) ;	
				DumpVec( &ctrl->vecs[ 0 ] ) ;
				if ( n_touches == 2 ) DumpVec( &ctrl->vecs[ 1 ] ) ;
				DumpVec( &react ) ;
				printf( "%d\n", ctrl->r_sphere ) ;
//				DumpSegment( ctrl->segs[ 0 ] ) ;
//				if ( n_touches == 2 ) DumpSegment( ctrl->segs[ 1 ] ) ;
#endif
				/* r_sphere * 2 までにとどめる */
				GV_LenVec3F( &react, &react, len, ( float )ctrl->r_sphere * 2.0F ) ;
			}
		}
#endif
    }
	/* 2点ニアチェック */
	if ( ctrl->skip_flag & CTRL_NEAR_CHECK2 ) {
		CheckNearHazard2( &react, ctrl ) ;
		ctrl->skip_flag &= ~CTRL_NEAR_CHECK2 ;
	}
	ctrl->mov.vx += react.vx ;
	ctrl->mov.vz += react.vz ;
}

/*
   レベル障害物をチェック
   */
static	inline	void	CheckLevelHazard( CONTROL *ctrl )
{
    float		levels[ 2 ] ;
    float		y, height, limit, diff, hzx_height ;
	float		prev_floor ;
    int			flag, again, pre_level_found ;
	//    int			atrs[ 2 ] ;

	again = 0 ;
	pre_level_found = ctrl->level_found ;
    /*
       0 : 床高さ	
       1 : 天井高さ
	   */
    ctrl->grounded = 0 ;
    ctrl->level_found = 0 ;
    /*
       垂直移動処理
	   */
	if ( DG_FABS( ctrl->hzx_height - HZX_HEIGHT_NO_USE ) < 0.1F ) {
		height = diff = 0.0F ;
		y = ctrl->mov.vy + ctrl->step.vy ;
		hzx_height = ctrl->height ;
    } else {
		hzx_height = ctrl->hzx_height ;
		height = hzx_height + ctrl->hzx_base ;
		y = height + ctrl->step.vy ;
		ctrl->mov.vy = height ;
		diff = ctrl->height - hzx_height ; 
    }

	prev_floor = ctrl->levels[ 0 ] ;
level_check_again :
    flag = HZX_LevelHazardCheck( ctrl->hzx_id, &( ctrl->mov ),
								ctrl->hzx_check_type, ctrl->flr_flag ) ;
    if ( flag != 0 ) {
		HZX_GetLevelHeight( levels ) ; 
		if ( ctrl->level[ 0 ] != NULL ) {
			HZX_GetLevelHazard( ctrl->level[ 0 ], ctrl->flr_atrs ) ;
		}
    }
	if ( !( 1 & flag ) ) levels[ 0 ] = GM_WORLD_LIMIT_BOTTOM ;
	if ( !( 2 & flag ) ) levels[ 1 ] = GM_WORLD_LIMIT_UPPER ;

	/* 保険機構 */
	/* 前フレームと激しく違うときは、１ずらした位置と比較 */
	if ( !GM_CheckGameStatus( STATE_DEMO ) && 
		again == 0 && ( pre_level_found & 1 ) && 
		( !( flag & 1 ) || ( ( ( flag & 1 ) && DG_FABS( prev_floor - levels[ 0 ] ) > 2000.0F ) ) ) ) {
		FVECTOR		p1, p2 ;
		int			flag1, flag2 ;
		int			xz ;
		float		levels1[ 2 ], levels2[ 2 ] ;

		//printf( "level check again\n" ) ;
		xz = 0 ;
level_check_again_again :
	    if ( xz == 0 ) {
			DG_COPY_VEC( &p1, &ctrl->mov ) ; p1.vx += 1.0F ;
			DG_COPY_VEC( &p2, &ctrl->mov ) ; p2.vx -= 1.0F ;
		} else {
			DG_COPY_VEC( &p1, &ctrl->mov ) ; p1.vz += 1.0F ;
			DG_COPY_VEC( &p2, &ctrl->mov ) ; p2.vz -= 1.0F ;
		}
		
		flag1 = HZX_LevelHazardCheck( ctrl->hzx_id, &p1,
									 ctrl->hzx_check_type, ctrl->flr_flag ) & 1 ;
		if ( flag1 != 0 ) {
			HZX_GetLevelHeight( levels1 ) ; 
		} else {
			levels1[ 0 ] = GM_WORLD_LIMIT_BOTTOM ;
		}
		flag2 = HZX_LevelHazardCheck( ctrl->hzx_id, &p2,
									 ctrl->hzx_check_type, ctrl->flr_flag ) & 1 ;
		if ( flag2 != 0 ) {
			HZX_GetLevelHeight( levels2 ) ; 
		} else {
			levels2[ 0 ] = GM_WORLD_LIMIT_BOTTOM ;
		}

		//printf( "-%d- %f %f %f\n", xz, levels[ 0 ], levels1[ 0 ], levels2[ 0 ] ) ;
		if ( DG_FABS( levels1[ 0 ] - levels2[ 0 ] ) < 10.0F &&
			 levels1[ 0 ] - levels[ 0 ] > 100.0F ) {
			//printf( "control levelcheck again %d\n", ctrl->name ) ;
			//printf( "%f %f %f\n", ctrl->mov.vx, ctrl->mov.vy, ctrl->mov.vz ) ;
			DG_COPY_VEC( &ctrl->mov, &p1 ) ;
			if ( xz == 0 ) again = 1 ;
			else		   again = 2 ;
			goto level_check_again ;
		}
		if ( xz == 0 ) {
			xz = 1 ;
			goto level_check_again_again ;
		}
	}
	if ( again ) {
		if ( again == 1 ) ctrl->mov.vx -= 1.0F ;
		else			  ctrl->mov.vz -= 1.0F ;
	}

    ctrl->level_found = flag ;

    /*
       床処理
	   */
    limit = hzx_height ;
    if ( 1 & flag ) {
		limit += levels[ 0 ] ;
		if ( y < limit ) {
			y = limit ;
			ctrl->grounded = 1 ;
			goto set_heightx ;
		}
    }
    /*
       天井処理
	   */
    if ( 2 & flag ) {
		limit = levels[ 1 ] - hzx_height ;
		if ( y > limit ) {
			y = limit ;
			ctrl->grounded = 2 ;
		}
    }
set_heightx :
    ctrl->levels[ 0 ] = levels[ 0 ] ;
    ctrl->levels[ 1 ] = levels[ 1 ] ;
    ctrl->mov.vy = y + diff ;
}

