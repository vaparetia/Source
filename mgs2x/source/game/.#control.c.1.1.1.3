static	inline	int	MaxInt( a, b )
int		a, b ;
{
    return ( a > b ) ? a : b ;
}

static	inline	int	MinInt( a, b )
int		a, b ;
{
    return ( a < b ) ? a : b ;
}

/*
   公開位置情報に登録する
   */
static	int	QueueWhere( where )
CONTROL		*where ;
{
    int		num ;

    ASSERT( where != NULL ) ;
    if ( where->name == PLAYER_NAME ) {
		GM_WhereList[ 0 ] = where ;
    } else {
		
		
#ifdef DEBUG_MODE
		{
		    CONTROL		**list ;
		    int			i, n ;
			list = GM_WhereList ;
			n = GM_N_WhereList ;
			for ( i = n ; i > 0 ; -- i ) {
				ASSERT( *list != where) ;
				list ++ ;
		    }
		}

#endif		
		
		num = GM_N_WhereList ;
		if ( num >= MAX_WHERES ) {
			printf( "warning : control list over %x\n", where->name ) ;
			return -1 ;
		}
		GM_WhereList[ num ] = where ;
		GM_N_WhereList = num + 1 ;
    }
    return 0 ;
}

/*
   公開位置情報から削除する
   */
static	void	DequeueWhere( where )
CONTROL		*where ;
{
    CONTROL		**list ;
    int			i, n ;

    ASSERT( where != NULL ) ;
    list = GM_WhereList ;
    n = GM_N_WhereList ;
    for ( i = n ; i > 0 ; -- i ) {
		if ( *list == where ) goto found ;
		list ++ ;
    }
    WARNING( "dequeued invalid where %x\n", where ) ;
    return ;
	found :
    if ( list != GM_WhereList ) {
		n -- ;
		*list = GM_WhereList[ n ] ;
		GM_N_WhereList = n ;
    } else {
		GM_WhereList[ 0 ] = &DummyPlayer;
    }
}

/*
   公開位置を検索
   */
CONTROL	*GM_SearchWhere( name )
u_int	name;
{
    CONTROL		**list ;
    int			i, n ;

    list = GM_WhereList ;
    n = GM_N_WhereList ;
    for ( i = n ; i > 0 ; -- i ) {
		if ( (*list)->name == name ) return *list;
		list ++ ;
    }
    return NULL;
}

//名前のキャラが存在してるかのみチェック
int	GM_OnlyCheckControl( void )
{
	int name ;
	CONTROL	*ctrl ;

	if ( GCL_NextStr() == NULL ) return -1 ;
	name = GCL_GetNextInt() ;
	ctrl = GM_SearchWhere( name ) ;
	if(ctrl == NULL) return -1 ;
	return 1 ;
}
int	GM_GetPosForGCL( void )
{
	GCL_VAR_REF ref; //配列への参照データ
	int name ;
	CONTROL	*ctrl ;

	if ( GCL_NextStr() == NULL ) return -1 ;
	name = GCL_GetNextInt() ;

//printf(" get enemy pos [%d]\n",name ) ;
	ctrl = GM_SearchWhere( name ) ;

	if ( GCL_NextStr() == NULL ) return -1 ;
	GCL_GetNextVarRef( &ref ); // 参照データの取得
	GCL_SetVarRef( &ref, 0, (int)ctrl->mov.vx );

	if ( GCL_NextStr() == NULL ) return -1 ;
	GCL_GetNextVarRef( &ref ); // 参照データの取得
	GCL_SetVarRef( &ref, 0, (int)ctrl->mov.vy );

	if ( GCL_NextStr() == NULL ) return -1 ;
	GCL_GetNextVarRef( &ref ); // 参照データの取得
	GCL_SetVarRef( &ref, 0, (int)ctrl->mov.vz );

	return 1 ;
}

