void		GM_InitWhereSystem( void )
{
	/*
	   リスト先頭は必ずプレイヤーなので
	   ダミーの構造体を登録しておく
	   */
	GM_WhereList[ 0 ] = &DummyPlayer ;
	GM_N_WhereList = 1 ;
}

int		GM_InitControlEx( ctrl, name, map, atr )
CONTROL		*ctrl ;
u_int		name ;
int			map ;
int			atr ;
{
    if ( map == 0 ) map = GM_CurrentMap ;
#ifdef DEBUG_MODE
	if ( name > 128 && map == 0x7fffffff ) {
		printf( "init control error : [%x] invalid map %x\n", name, map ) ;
		ASSERT( 0 ) ;
	}
#endif

    GV_ZeroMemory( ctrl, sizeof( CONTROL_NOEVT ) ) ;
    GM_ChangeControlMapFromMapId( ctrl, map ) ;

    ctrl->name = name ;

    ctrl->height = DEFAULT_HEIGHT ;
    ctrl->hzx_height = HZX_HEIGHT_NO_USE ;
    ctrl->r_sphere = ctrl->s_sphere = DEFAULT_SPHERE ;
    ctrl->seg_flag = 0 ;
    ctrl->flr_flag = HZX_FLOOR_IK ;
    /* デフォルトでは、トラップ、メッセージ、マップ変更なし、
       アドレスチェックなし */
    ctrl->skip_flag = CTRL_SKIP_TRAP | CTRL_SKIP_MESSAGE | 
		CTRL_SKIP_CHANGE_MAP | CTRL_SKIP_GET_ADDRESS ;
    ctrl->hzx_check_type = HZX_CHK_ALL ;
    ctrl->addr = 0xffffffff ;
    ctrl->addr_mov = NULL ;
    /* 床・天井初期値 */
    ctrl->levels[ 0 ] = GM_WORLD_LIMIT_BOTTOM ;
    ctrl->levels[ 1 ] = GM_WORLD_LIMIT_UPPER ;
    /* 床壁格納領域確保 */
	if ( !( atr & CTRL_ATR_NOCHK_HZX ) ) {
		GM_SEGMENTS	*segs ;

		segs = GV_Malloc( sizeof( GM_SEGMENTS ) ) ;
		if ( segs == NULL ) return -1 ;
		ctrl->segs[ 0 ] = &segs->segments[ 0 ] ;
		ctrl->segs[ 1 ] = &segs->segments[ 1 ] ;
		ctrl->level[ 0 ] = &segs->floors[ 0 ] ;
		ctrl->level[ 1 ] = &segs->floors[ 1 ] ;
    } else {
		ctrl->segs[ 0 ] = NULL ;
		ctrl->segs[ 1 ] = NULL ;
		ctrl->level[ 0 ] = NULL ;
		ctrl->level[ 1 ] = NULL ;
		ctrl->skip_flag |= CTRL_SKIP_HZX ;
	}
	ctrl->attribute = atr ;
    ctrl->root_offset = NULL ;
    ctrl->object = NULL ;
	ctrl->motion_num = -1 ;

    /*
       キャラ名として128以下が指定されていると
       公開位置情報に登録しない
	*/
//    if ( name != 0 ) {
	if ( name > 128 ) {
		if ( QueueWhere( ctrl ) < 0 ) return -1 ;
    }

    return 0 ;
}

