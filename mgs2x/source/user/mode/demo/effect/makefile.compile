#
# Makefile for MGS2 Sub Module
#	各ソースがおかれたディレクトリ用 makefile
#
# 1999/07/08 K.Uehara
# $Id: makefile.compile,v 1.11 2002/02/22 07:04:10 usr04098 Exp $
