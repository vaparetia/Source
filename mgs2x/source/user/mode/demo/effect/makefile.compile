# ベースディレクトリ
BASEDIR = ../../../..

# ライブラリ名

LIBNAME = mode.a

# オブジェクトリスト
SOURCES = $(wildcard *.c)
OBJECTS = $(SOURCES:.c=.o)
XOBJECTS = $(SOURCES:.c=.obj)

# ここでのローカルフラグリスト

LOCAL_INCLUDES = 
LOCAL_DEFINES = 
LOCAL_OPTIONS = 

# 設定の実体
include $(BASEDIR)/makefile.sub


# 依存関係のリスト

