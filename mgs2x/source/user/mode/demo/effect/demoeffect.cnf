effect "物理シム 新髪の毛" [NewHairModel_Demo] <id:0x3008><force_effect>
{
	int name 		{ %% = MaxInputGetEffectName( "名前", 0 ) ; } ;
	int model_name	{ %% = MaxInputStrCode( "KMSモデル", 0, ""/*default*/, "kms" ) ; } ;
	int sample_num	{ %% = MaxInputComboBox( "モード", 0, 
	"ライデン通常=0&ライデン水中=1&ライデン濡れ髪=2&ライデン少し濡れ髪=3&リキッド用=4&フォーチュン裾=5&フォーチュン袖=6&フォーチュン髪の毛=7&ゴルルゴ兵のマスク=8","ライデン通常" ); };
	void *object      {
		link = &MaxInputGetLink( "リンク", 0 ) ;
		handle = DM_GetObjectHandle( link->vx );
		%% = DM_GetObjectObject( handle );
	} ;
	int objnum        { %% = link->vy ; } ;
	FVECTOR *pos      { %% = &MaxInputFVector( "位置", 1,   0.0f,0.0f,0.0f/*default*/ ) ; } ;
	SVECTOR *rot      { %% = &MaxInputSVector( "回転", 2,   0.0f,0.0f,0.0f/*default*/ ) ; } ;
	float oval_param  { %% = MaxInputSlideBarF( "当たり倍率", 0, 0.5f, 2.0f, 10,  1.0f/*default*/ ) ; } ;
	int collision_flag{ %% = MaxInputComboBox( "当たりフラグ", 0, "首当たり無し=2&首当たり有り=3","首当たり有り" ); };
	int visible_flag  { %% = 1; };
	int light_flag    { %% = MaxInputSlideBarI( "ライトモード", 0, 0, 6, 1,  0/*default*/ ); } ;

	int bound_model	  { %% = MaxInputStrCode( "当たりモデル", 0, "", "kms" ); };

}"ライデンなど髪の毛の動きを計算、表示するキャラです。\n以下パラメータの説明\n位置  取り付ける場所のローカル座標値\n回転  取り付けるモデルのローカルの回転値\n当たり倍率   当たりをより大きく取りたい場合に調整します。だいたい、1.00fから1.50fまでの値を使用。\nライトモードはどれだけ平行光を環境光に振り分けるかです。\n";

effect "物理シム 新髪の毛ＥＶＭ" [NewEvmHairModel_Demo] <id:0x3007><force_effect>
{
	int name 		{ %% = MaxInputGetEffectName( "名前", 0 ) ; } ;
	int model_name	{ %% = MaxInputStrCode( "evmモデル", 0, ""/*default*/, "evm" ) ; } ;
	int sample_num	{ %% = MaxInputComboBox( "モード", 0, 
				"ライデン通常=0&ライデン水中=1&ライデン濡れ髪=2&ライデン少し濡れ髪=3&リキッド用=4&フォーチュン裾=5&フォーチュン袖=6&フォーチュン髪の毛=7&ゴルルゴ兵のマスク=8&ゴルルゴ兵の服=23&エマのＩＤ(受渡用)=18&ライデン上下移動用=24","ライデン通常" ); };
	void *object      {
		link = &MaxInputGetLink( "リンク", 0 ) ;
		handle = DM_GetObjectHandle( link->vx );
		%% = DM_GetObjectObject( handle );
	} ;
	int objnum        { %% = link->vy ; } ;
	FVECTOR *pos      { %% = &MaxInputFVector( "位置", 1,   0.0f,0.0f,0.0f/*default*/ ) ; } ;
	SVECTOR *rot      { %% = &MaxInputSVector( "回転", 2,   0.0f,0.0f,0.0f/*default*/ ) ; } ;
	float oval_param  { %% = MaxInputSlideBarF( "当たり倍率", 0, 0.5f, 2.0f, 10,  1.0f/*default*/ ) ; } ;
	int collision_flag{ %% = MaxInputComboBox( "当たりフラグ", 0, "首当たり無し=2&首当たり有り=3&当たり無し=0","首当たり有り" ); };
	int visible_flag  { %% = 1; };
	int light_flag    { %% = MaxInputSlideBarI( "ライトモード", 0, 0, 6, 1,  0/*default*/ ); } ;

	int bound_model	  { %% = MaxInputStrCode( "当たりモデル", 0, "", "kms" ); };

}"ライデンなど髪の毛の動きを計算、表示するキャラです。\n以下パラメータの説明\n位置  取り付ける場所のローカル座標値\n回転  取り付けるモデルのローカルの回転値\n当たり倍率   当たりをより大きく取りたい場合に調整します。だいたい、1.00fから1.50fまでの値を使用。\nライトモードはどれだけ平行光を環境光に振り分けるかです。\n";

mesg "物理シム 新髪の毛ＥＶＭ" 髪の毛の計算許可[3] $i:計算フラグ "髪の毛の計算を行う、行わないを指定するフラグ。\n0:計算しない  1:計算する  -1:現在の状態を反転  -2:関節位置の初期化のみを行う\n計算しない→計算するにした場合、関節の初期位置を再計算する。\n" ;

mesg "物理シム 新髪の毛ＥＶＭ" 髪の毛逆立モード[4] $i:逆立度合の指定 $i:逆立期間 $i:逆立→通常の戻り期間 "電撃などで髪の毛を逆立てる。\n逆立度合の指定は、逆立に使う力の大きさを指定。0以下では、デフォルトの1000を使用する。\n逆立期間、逆立→通常の戻り期間は、フレーム数で指定する。逆立期間に、-1を指定すると永久に逆立する指定、0にすると現在の逆立のオフ指定となる。\n";


effect "物理シム 新髪の毛ＥＶＭ２" [NewEvmHairModel_Demo2] <id:0x3009><force_effect>
{
	int name 		{ %% = MaxInputGetEffectName( "名前", 0 ) ; } ;
	int model_name	{ %% = MaxInputStrCode( "evmモデル", 0, ""/*default*/, "evm" ) ; } ;
	int sample_num	{ %% = MaxInputComboBox( "モード", 0,
	"フォーチュンの裾揺れ=0&フォーチュンの右袖揺れ=1&フォーチュンの左袖揺れ=2&フォーチュンの髪の毛揺れ=3&ヴァンプ髪の毛=4&ヴァンプナイフ=5&ヴァンプコート=6&ピーターのフード=7&死体ピーターのフード=8&死体ピーターのオーバータイ=9&潜水ライデンの髪の毛=10&ローズの髪の毛=11&エマの髪の毛=12&エマのＩＤカード=13&プラントオルガの髪の毛=15&オタコンの裾=17&濡れたエマの髪の毛=18&ゴルルゴ兵の服=19&ドックタグ=20&潜水フィン(右)=21&潜水フィン(左)=22&オタコンの前髪=23&裸ヴァンプ髪の毛=24","フォーチュンの裾揺れ" ); };

	void *object      {
		link = &MaxInputGetLink( "リンク", 0 ) ;
		handle = DM_GetObjectHandle( link->vx );
		%% = DM_GetObjectObject( handle );
	} ;
	FVECTOR *pos      { %% = &MaxInputFVector( "位置", 1,   0.0f,0.0f,0.0f/*default*/ ) ; } ;
	SVECTOR *rot      { %% = &MaxInputSVector( "回転", 2,   0.0f,0.0f,0.0f/*default*/ ) ; } ;
	float oval_param  { %% = MaxInputSlideBarF( "当たり倍率", 0, 0.5f, 2.0f, 10,  1.0f/*default*/ ) ; } ;
	int visible_flag  { %% = 1; };
	int light_flag    { %% = MaxInputSlideBarI( "ライトモード", 0, 0, 6, 1,  0/*default*/ ); } ;

	int bound_model	  { %% = MaxInputStrCode( "当たりモデル", 0, "", "kms" ); };

}"ライデンなど髪の毛の動きを計算、表示するキャラです。\n以下パラメータの説明\n位置  取り付ける場所のローカル座標値\n回転  取り付けるモデルのローカルの回転値\n当たり倍率   当たりをより大きく取りたい場合に調整します。だいたい、1.00fから1.50fまでの値を使用。\nライトモードはどれだけ平行光を環境光に振り分けるかです。\n使用モデル\n　ヴァンプ髪の毛 : vmp_hair_coat_mh_mt.mdl\n　ヴァンプナイフ : vmp_parts_vkpa_mh.mdl (鞘+ナイフ)\n　　　　　　　　　 vmp_parts_vkpb_mh.mdl (鞘のみ)\n　ヴァンプコート : vmp_parts_coat_mh.mdl\n\nその他\n　ヴァンプのナイフは、鞘からのナイフの抜き差しを考えて、\n　三つのモデルがある。\n　　揺れ有り\n　　vmp_parts_vkpa_mh.mdl (鞘+ナイフ)\n　　vmp_parts_vkpb_mh.mdl (鞘のみ)\n　　揺れ無し\n　　vmp_parts_vkpfix.mdl (鞘のみ、ナイフを抜く瞬間に使用)";

mesg "物理シム 新髪の毛ＥＶＭ２" 髪の毛の計算許可[3] $i:計算フラグ "髪の毛の計算を行う、行わないを指定するフラグ。\n0:計算しない  1:計算する  -1:現在の状態を反転  -2:関節位置の初期化のみを行う\n計算しない→計算するにした場合、関節の初期位置を再計算する。\n" ;

mesg "物理シム 新髪の毛ＥＶＭ２" 髪の毛逆立モード[4] $i:逆立度合の指定 $i:逆立期間 $i:逆立→通常の戻り期間 "電撃などで髪の毛を逆立てる。\n逆立度合の指定は、逆立に使う力の大きさを指定。0以下では、デフォルトの1000を使用する。\n逆立期間、逆立→通常の戻り期間は、フレーム数で指定する。逆立期間に、-1を指定すると永久に逆立する指定、0にすると現在の逆立のオフ指定となる。\n";


effect "物理シム ソリダスのマント" [NewSolMant_called] <id:0x3013><force_effect>
{
	int name 		{ %% = MaxInputGetEffectName( "名前", 0 ) ; } ;
	int model_name	{ %% = MaxInputStrCode( "evmモデル", 0, ""/*default*/, "evm" ) ; } ;
	int sample_num	{ %% = MaxInputComboBox( "モード", 0, "通常=14&腕組み=16","通常" ); };

	void *object      {
		link = &MaxInputGetLink( "リンク", 0 ) ;
		handle = DM_GetObjectHandle( link->vx );
		%% = DM_GetObjectObject( handle );
	} ;
	FVECTOR *pos      { %% = &MaxInputFVector( "位置", 1,   0.0f,0.0f,0.0f/*default*/ ) ; } ;
	SVECTOR *rot      { %% = &MaxInputSVector( "回転", 2,   0.0f,0.0f,0.0f/*default*/ ) ; } ;
	float oval_param  { %% = MaxInputSlideBarF( "当たり倍率", 0, 0.5f, 2.0f, 10,  1.0f/*default*/ ) ; } ;
	int visible_flag  { %% = 1; };
	int light_flag    { %% = MaxInputSlideBarI( "ライトモード", 0, 0, 6, 1,  0/*default*/ ); } ;

	int bound_model	  { %% = MaxInputStrCode( "当たりモデル", 0, "", "kms" ); };

	int mode { %% = MaxInputInt( "燃え尽きるまでの時間", 0,  60 /*default*/ ); };

}"ソリダスのマントの計算と、燃え出すエフェクトを管理しています。\nパラメータは髪の毛とほぼいっしょです。\n以下パラメータの説明\n位置  取り付ける場所のローカル座標値\n回転  取り付けるモデルのローカルの回転値\n当たり倍率   当たりをより大きく取りたい場合に調整します。だいたい、1.00fから1.50fまでの値を使用。\nライトモードはどれだけ平行光を環境光に振り分けるかです。\n燃え尽きるまでの時間は、マントが燃え出してから燃え尽きるまでの時間をフレーム数で指定します。";

mesg "物理シム ソリダスのマント" マントの計算許可[3] $i:計算フラグ "髪の毛の計算を行う、行わないを指定するフラグ。\n0:計算しない  1:計算する  -1:現在の状態を反転  -2:関節位置の初期化のみを行う\n計算しない→計算するにした場合、関節の初期位置を再計算する。\n" ;

mesg "物理シム ソリダスのマント" 燃え出しエフェクトスタート[4] "マントを燃やし始めます。\n" ;
mesg "物理シム ソリダスのマント" 燃え出しエフェクトリスタート[5] "燃やしてしまったマントを、また復活させます。\n" ;


