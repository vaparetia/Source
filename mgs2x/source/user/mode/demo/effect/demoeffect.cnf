effect "手錠モデル表示" [NewHandcuff_called] <id:0x3015>
{
	int name	      { %% = MaxInputGetEffectName( "名前", 0 ) ; } ;
	int model_name    { %% = MaxInputStrCode( "KMSモデル", 0, ""/*default*/, "kms" ) ; } ;
	void *object1     {
		link = &MaxInputGetLink( "リンク", 0 ) ;
		handle = DM_GetObjectHandle( link->vx );
		%% = DM_GetObjectObject( handle );
	} ;
