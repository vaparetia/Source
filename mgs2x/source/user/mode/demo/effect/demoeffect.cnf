	物理シミュレーション系    id 0x3000

****************************************************************************************/
effect "物理シム・バンダナ" [NewRopeModel3_called] <id:0x3000>
{
	int model_name    { %% = MaxInputStrCode( "KMSモデル", 0, "sna_bdn1"/*default*/, "kms" ) ; } ;
	int sample_num    { %% = MaxInputSlideBarI( "動きの種類", 0, 0, 1, 1,  0/*default*/ )+2 ; } ;
	void *object      {
		link = &MaxInputGetLink( "リンク", 0 ) ;
		handle = DM_GetObjectHandle( link->vx );
		%% = DM_GetObjectObject( handle );
	} ;
	int objnum        { %% = link->vy ; } ;
	FVECTOR *pos      { %% = &MaxInputFVector( "位置", 1,   0.0f,0.0f,0.0f/*default*/ ) ; } ;
	SVECTOR *rot      { %% = &MaxInputSVector( "回転", 2,   0.0f,0.0f,0.0f/*default*/ ) ; } ;
	float oval_param  { %% = MaxInputSlideBarF( "当たり倍率", 0, 0.5f, 2.0f, 10,  1.0f/*default*/ ) ; } ;
	int collision_flag{ %% = 1 ; } ;
	int visible_flag  { %% = 1 ; } ;
	int mode          { %% = 0 ; } ;
	int bound_model	  { %% = MaxInputStrCode( "当たりモデル", 0, "", "kms" ); };
} "バンダナの動きを計算、表示するキャラです。\n以下パラメータの説明\n位置  取り付ける場所のローカル座標値\n回転  取り付けるモデルのローカルの回転値\n当たり倍率   当たりをより大きく取りたい場合に調整します。だいたい、1.00fから1.50fまでの値を使用。\nスネークのバンダナは、2本あるので`動きの種類'および`モデル'を変えて表示させて下さい。sna_bdn1、sna_bdn2がバンダナのモデルです。" ;

