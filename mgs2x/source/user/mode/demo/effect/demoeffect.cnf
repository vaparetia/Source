effect "影 光源遮り"[NewBodyShadow] <id:0x1004>
{
	void *objs      {
		link = &MaxInputGetLink( "リンク", 0 ) ;
		handle = DM_GetObjectHandle( link->vx );
		%% = DM_GetObjectDgObjs( handle );
	} ;
} "フラッシュバック効果を人体から出します。ある特定の光源設定された物に近付くと体の輪郭から影が伸びます。\n対象人体は、リンク制御で設定します。\n常駐キャラとして`chara ライト位置管理'が要ります。" ;

effect "影 ボリューミックシャドーライン" [NewBodyShadowVolume_Demo] <id:0x100a>
{
	void *objs {
		link = &MaxInputGetLink( "リンク", 0 ) ;
		handle = DM_GetObjectHandle( link->vx );
		%% = DM_GetObjectDgObjs( handle );
	};
	FVECTOR *light_pos	{
		link = &MaxInputHumanNum( "ライトの座標", 0 ) ;
		handle = DM_GetObjectHandle( link->vx );
		%% = DM_GetObjectPos( handle, link->vy );
	};
	
	float reach  { %% = MaxInputFloat( "光源影響距離", 0,  50.0f/*default*/ ) ; } ;
	float back_shift  { %% = MaxInputFloat( "光源位置補正距離", 0,  50.0f/*default*/ ) ; } ;
	int model_name    { %% = MaxInputStrCode( "CV2モデル", 0, ""/*default*/, "cv2" ) ; } ;
	int	add_sub	{ %% = MaxInputComboBox( "モード", 0, "減算=0&加算=1", "減算" ) ;};

	int life 		{ 
		max = MaxInputGetKeyRangeMax( "フレーム最大", 0 ) ;
		min = MaxInputGetKeyRangeMin( "フレーム最小", 0 ) ;
		%% = (max-min) ;
	};
	
	int color		{
		col = &MaxInputSelectColor("色",0,128,128,128,128);
		%% = ((col->vx)|(col->vy*256)|(col->vz*256*256)|(col->vw*256*256*256));
	};
}"「光源」から見た「モデル（多関節可：joint ２２まで）」のエッジ（輪郭）から、\n影に模した減算ラインを表示する。\nモデルの中心座標が、光源からreach までの間のみ発生し、その間αを減衰させている。\n光源が「点」の場合、back_shift は ゼロ。\n投光器のように光源が大きい場合 back_shift( 0.0f 以上 ) で仮想光源点をモデルと逆方向にシフトさせる。\n（その時も、reach はあくまでも光源が基点となる）\nプリミティブが「ライン」であるため、接近しすぎると正体がバレる（将来的にポリゴン化する予定）。\nラインの発生点は常にブレている為、このエフェクトを複数置くことによりラインに厚みが出る効果が期待できる。\nlife が 残り６０ フレームを切るとフェードアウトを始める。\n[特殊な使い方]\n　　・モデルエッジからラインが出ること利用して、「集中線」モドキ（いづれ正式に作成します）。\n　　・フェードアウトする事を考慮に入れて、連続爆発のインパクトに使用。\n　　・継続的に影を出したまま「光源」をツールで移動させ「光の移動」を表現できる。";

effect "ゴルルコ兵 発砲エフェクト" [DM_SendEffectMessage] <id:0x100b><no_birth>
{
	int name    { %% = MaxInputStrCode( "送り先", 0,  "装備品 ゴルルコビッチ兵", ""); } ;
	int data0   { %% = MaxInputListBox( "エフェクトフラグ", 0, "左手の武器から=0x0001&SHOOT_NOSPARK=0x0002&軌道がランダム=0x0004&点光源１=0x0008&点光源２=0x0010", 0x0000 ) ; };
	int data1   { %% = 0; };
	int data2   { %% = 0; };
	int data3   { %% = 0; };
	int data4   { %% = 0; };
	int data5   { %% = 0; };
	int data6   { %% = 0; };
	int data7   { %% = 0; };
	int command { %% = 0; } ;
	int num     { %% = 2; };

}"ゴルルコ兵に発砲メッセージを送るエフェクトです。\nモーションは付きません\nハザードがないと薬莢は落ち続けます。";

