{

	int name { %% = MaxInputGetEffectName( "名前", 0 ) ; } ;

	void *parent{ %% = DM_NULL() ; } ;
	void *object{
		link = &MaxInputGetLink( "リンク", 0 ) ;
		handle = DM_GetObjectHandle( link->vx );
		%% = DM_GetObjectObject( handle );
	} ;
	int  flag   {
		%% =  MaxInputListBox( "装備フラグ", 0, "銃のホルスター=0x0001&ナイフ=0x0002&ナイフを抜いたケース=0x0004&マガジン入れ=0x0008&バックパック=0x0010&無線機=0x0020&暗視ゴーグル=0x0040&暗視ゴーグル開き=0x0200&右ライトオン=0x0400&左ライトオン=0x0800&武器右手持ち=0x0080&武器ぶら下げる=0x0100&武器左手持ち=0x1000&プラントゴル兵=0x2000&プラント攻撃ゴル兵=0x4000&銃天狗=0x8000&刀天狗=0x10000&刀鞘=0x20000", 0x003b ) ;
	} ;
	int  wpname { %% = MaxInputStrCode( "右 器モデル名", 0,  ""/*default*/, "kms" ) ; } ;
	int  left_wp { %% = MaxInputStrCode( "左 武器モデル名", 0,  ""/*default*/, "kms" ) ; } ;
	
} "装備フラグはビットフラグになっています。必要な装備品に対応したビットを立ててください。\n 備品必要モデル\nホルスター：gbs_hlst\nナイフ入りケース：gbs_knif\nマガジンケース：gbs_mag\nバックパック：gbs_bp\n無線機：rad ,rad_m\n暗視ゴーグル：gbs_nvg2, gbs_nvg1\n武器：aks_sp, aks\nスリング：sling,kanagu\n懐中電灯：tnr_frashlight\n兵装備品必要テクスチャ\nスリング：gbs_ak_sling2\nプラントゴル兵：gps_sling, gps_knife, gps_def_mt, abk, abk_amo\nプラント攻撃ゴル兵：gpa_sling, gpa_def_mt,  abk, abk_amo\n銃天狗 : tng_magazine\n刀鞘 : tng_saya, tng_strap" ;

