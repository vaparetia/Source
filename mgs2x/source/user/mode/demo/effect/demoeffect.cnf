		%% = MaxInputStrCode( "モデル名", 0, "sna_def", "cv2" ) ;
	};
}"「常駐 水飛沫」「常駐 波紋」を起動してください\nモデルを水面で切断した場所からパーティクル水飛沫を発生。設定時から常に水面を監視して自動的に発生します。";

effect "水効果 単発水飛沫" [OK_PutSplushSurface]<id : 0xb002><no_birth>
{
	FVECTOR *pos      { %% = &MaxInputFVector( "位置", 1,   0.0f,0.0f,0.0f/*default*/ ) ; };
	FVECTOR *vec      { 
		rot = &MaxInputFVector( "回転", 2,   0.0f,0.0f,0.0f/*default*/ );
		pow = MaxInputFloat( "大きさ", 0,  100.0f );
		DM_GetFMatrixM_ZXY( &temp, rot, 2 );
		sceVu0ScaleVector( &temp, &temp, pow );
		%% = &temp;
	};
}"「常駐 水飛沫」「常駐 波紋」を起動してください\n「水効果 小粒水飛沫」が出す飛沫の単発呼びです\n";

effect "水効果_巨大水飛沫" [NewSplushTidal]<id : 0xb003><add_src : "bombgas6_alp.bmp">
{
