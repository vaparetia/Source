	};

}"レイの滲み血の管理キャラ。メッセージを受けとると指定の位置に滲み血を生成。";

effect "レイ_滲み血メッセージ"[PDRAY_OozeBloodAddDemo]<id : 0xd008><no_birth><add_src : "pdray_def_mt.cv2">
{

	int	name		{ %% = MaxInputSelectName( "起動済み滲み血名", 0 ); };
	int 	joint_num 	{ %% = MaxInputInt( "最近関節番号", 0, 0 ); };
	float	x		{ pos = &MaxInputFVector( "中心位置", 1,  0.0f,0.0f,0.0f/*default*/ );
				  %%  = pos->vx ; } ;
	float	y		{ %%  = pos->vy ; } ;
	float	z		{ %%  = pos->vz ; } ;
	float	range		{ %% = MaxInputFloat( "影響範囲", 0, 2000.0f/*default*/ ); };


}"[レイ_滲み血]に血発生メッセージを送る。";

effect "レイ_ステージ床フォグ消去"[PDRAY_CLOUD_DeleteDensity]<id : 0xd009><no_birth>
{
	FVECTOR *pos	{ %% = &MaxInputFVector( "消去中心位置", 1,  0.0f,0.0f,0.0f/*default*/ ); } ;
	int 	size	{ %% = MaxInputInt( "消去半径", 0, 0 ); };

}"レイ戦ステージのシナリオ起動床フォグを部分的に晴らすメッセージを渡す関数です。";


effect "レイ_吹き出し血"[NewDemoRayFallBlood]<id : 0xd00a>
{

	int	name  		{ %% = MaxInputGetEffectName( "名前", 0 ); };
	int	con_name	{ %% = MaxInputSelectName( "ダミーポイント", 0 ); };

}"ゲーム中で使っているレイの体から吹き出す血です。\nゲーム中の動きに合わせると、\n発生から１５フレームで吹き出し血の減衰開始、\n発生から９０フレーム目で２５０フレームかけて流血が減衰します。減衰しきらないと自分からキャラが死ぬことはありません。";

mesg "レイ_吹き出し血" 吹き出し血減衰開始[0] "勢い良く吹き出している血が減衰を開始します。";
mesg "レイ_吹き出し血" 流血減衰開始[1] $i:時間 "指定時間でデロデロ流れている血が減衰します。";


effect "レイ_衝撃波"[NewFogWave]<id : 0xd00b><add_src : "smoke_lp3_alp.bmp">
{
	FMATRIX *root  {
		sceVu0UnitMatrix( &mat ) ;
		pos = &MaxInputFVector( "位置", 1,   0.0f,0.0f,0.0f/*default*/ ) ;
		rot = &MaxInputFVector( "回転", 2,   0.0f,0.0f,0.0f/*default*/ ) ;
		sceVu0RotMatrix( &mat, &mat, rot ) ;
		sceVu0TransMatrix( &mat, &mat, pos ) ;
		%% = &mat ;
	} ;
	int 	size	{ %% = MaxInputInt( "半径", 0, 1000 ); };
	int 	speed	{ %% = MaxInputInt( "スピード", 0, 200 ); };
	int 	height	{ %% = MaxInputInt( "高さ", 0, 300 ); };

}"ゲーム中で使われている衝撃波です。";

/**************************************************************************************

	水飛沫 系    id 0x100〜0x104

****************************************************************************************/

effect "水飛沫 モーション連動" [NewSplashMotion_Demo] <id:0x100> <add_src : "splash05_alp.bmp,splash07_alp.bmp" >
{
	void *objs  {
		link = &MaxInputGetLink( "リンク", 0 ) ;
		handle = DM_GetObjectHandle( link->vx ) ;
		%% = DM_GetObjectDgObjs( handle ) ;
	} ;
	float step_limit { %% = MaxInputSlideBarF( "ステップリミット", 0, 0.0f, 100.0f, 10, 5.0f/*deflaut*/ ) ; } ;
	int   life
	{
		max = MaxInputGetKeyRangeMax( "フレーム最大", 0 ) ;
		min = MaxInputGetKeyRangeMin( "フレーム最小", 0 ) ;
		%% = (max-min) ;
	} ;
} "モーションによって大きく動いた関節点から水飛沫を発生させる。前のフレームの関節点からの距離を調べ、一定以上離れた場合に出る。\n  対象オブジェ：：リンク制御で指定。\n  ステップリミット：：前フレームとどれだけ離れていれば発生させるか\n  寿命：：トラックビューでフレーム数指定" ;

effect "水飛沫 風紋" [NewSplashRipple_Demo] <id:0x101> <add_src : "splash05_alp.bmp,splash07_alp.bmp" >
{
	FVECTOR *center   { %% = &MaxInputFVector( "中心位置", 1,  0.0f,0.0f,0.0f/*default*/ ) ; } ;
	float   radius    { %% = MaxInputFloat( "発生半径", 0, 200.0f ) ; } ;
	float   direction { %% = MaxInputSlideBarF( "方向", 4, 0, 360, 8, 0.0f/*default*/ ) ; } ;
	float   angle     { %% = MaxInputSlideBarF( "角度差分", 4, 0, 180, 4, 30.0f/*default*/  ) ; } ;
	float   size      { %% = MaxInputFloat( "大きさ", 0, 200.0f/*default*/  ) ; } ;
	int     multiple  { %% = MaxInputSlideBarI( "発生個数", 0, 10, 150, 10, 10/*default*/ ) ; } ;
	int	time
	{
		max = MaxInputGetKeyRangeMax( "フレーム最大", 0 ) ;
		min = MaxInputGetKeyRangeMin( "フレーム最小", 0 ) ;
		%% = (max-min) ;
	} ;
} "単発水飛沫を系統立てて呼ぶエフェクト。自殺キャラ。\n発生円内に円弧状に発生し、外周に向かって移動を繰り返す。\n  中心位置：：発生円の中心（高さＹの水平面のみから発生する）\n  発生半径：：発生円の最大半径\n  方向：：Ｙ軸回転角度(°単位)\n  角度差分：：`方向'からの＋−(°単位)\n  大きさ：：水飛沫自体の大きさ\n  発生個数：：発生させる円弧内の水飛沫の数 \nトラックビューで発生させ続けるフレーム数を指定（その後自殺する）" ;

effect "水飛沫 単発" [NewSplashParts_Demo] <id:0x102> <add_src : "splash05_alp.bmp,splash07_alp.bmp" >
{	FVECTOR *center  { %% = &MaxInputFVector( "中心位置", 1,  0.0f,0.0f,0.0f/*default*/ ) ; } ;
	SVECTOR *rot     { %% = &MaxInputSVector( "回転", 2,  0.0f,0.0f,0.0f/*default*/ ) ; } ;
	float   intense  { %% = MaxInputFloat( "大きさ", 0,  100.0f ) ; } ;
} "発生場所から発生方向（Ｚ軸基準）に水飛沫が飛ぶ。強さは単位フレームに進む距離を現し、大きさもそれに比例する。重力計算あり。" ;

effect "水飛沫 足元" [NewFootSplash] <id:0x103> <add_src : "splash05_alp.bmp,splash07_alp.bmp" >
{
	void  *object {
		link = &MaxInputGetLink( "リンク", 0 ) ;
		handle = DM_GetObjectHandle( link->vx ) ;
		%% = DM_GetObjectObject( handle ) ;
	} ;
	void *control {
