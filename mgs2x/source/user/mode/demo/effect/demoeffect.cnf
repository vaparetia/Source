	int cv2_1       { %% = MaxInputStrCode( "アニメパターン２", 0, ""/*default*/, "cv2" ) ; } ;
	int cv2_2       { %% = MaxInputStrCode( "アニメパターン３", 0, ""/*default*/, "cv2" ) ; } ;
	int cv2_3       { %% = MaxInputStrCode( "アニメパターン４", 0, ""/*default*/, "cv2" ) ; } ;
	int cv2_4       { %% = MaxInputStrCode( "アニメパターン５", 0, ""/*default*/, "cv2" ) ; } ;
	int cv2_5       { %% = MaxInputStrCode( "アニメパターン６", 0, ""/*default*/, "cv2" ) ; } ;
} "汎用の頂点アニメ再生エフェクト。\n頂点アニメのパターンを６個まで指定できる。アニメパターンの指定は、cv2のファイル名を指定する。アニメーションの指定は、メッセージで行う。" ;

mesg "汎用ＣＶ２頂点アニメ" アニメーションの指定[0] $i:フレーム数 $i:割合１ $i:割合２ $i:割合３ $i:割合４ $i:割合５ $i:割合６ "アニメーションのフレーム数とアニメパターンの混合割合を指定します。フレーム数で指定された時間をかけて、指定された割合で混ぜられたモデルへと変化します。" ;


