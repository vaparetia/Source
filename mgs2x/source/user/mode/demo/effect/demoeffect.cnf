		%% =  MaxInputListBox( "装備フラグ", 0, "髪の毛(茶色)=0x0001&髪の毛(金色)=0x0002&髪の毛(白色)=0x0004&髪の毛(ハゲ)=0x0008&シャツ黒=0x0010&シャツ青=0x0020&ネクタイ黄色=0x0040&ネクタイ茶色=0x0080&眼鏡=0x0100&バッグ(右手)=0x0200&バッグ(左手)=0x0400&バッグ(右肩)=0x0800&バッグ(左肩)=0x1000&バッグ(右肩)=0x2000&バッグ(左肩)=0x4000", 0x0001) ;
