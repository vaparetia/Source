}"水平面にしかおけません。寿命が負だと出っ放し。半透明モードはαです。";



effect "フォーチュン落ち涙" [NewFortuneTear]<id:0x023>
{
	FVECTOR	*pos	{ %% = &MaxInputFVector( "発生位置", 1, 0.0f,0.0f,0.0f ); };
	FVECTOR *vec	{ 
		rot = &MaxInputFVector( "飛抹方向回転", 2,   0.0f,0.0f,0.0f );
		DM_GetFMatrixM_XYZ( &temp, rot, 2 );
		%% = &temp;
	};

	float 	spread_y 	{ %% = MaxInputFloat( "飛び散るポイントの高さ", 0, 10.0f ); };
	float 	gravity 	{ %% = MaxInputFloat( "落ち涙重力", 0, 49.0f ); };
	float 	size 		{ %% = MaxInputFloat( "落ち涙の大きさ", 0, 20.0f ); };
	int 	tear_tex	{ %% = MaxInputStrCode( "落ち涙テクスチャ名", 0, "drop01_msk", "bmp" ); };

	int	add_RGBA	{ 
		col = &MaxInputSelectColor( "加算プリミティブ色", 0,  48, 48, 48, 80 ) ;
		%% = (col->vx * 256 * 256 * 256) | (col->vy * 256 * 256) | (col->vz * 256) | col->vw; };
	int	sub_RGBA	{ 
		col = &MaxInputSelectColor( "減算プリミティブ色", 0,  32, 32, 32, 72 ) ;
		%% = (col->vx * 256 * 256 * 256) | (col->vy * 256 * 256) | (col->vz * 256) | col->vw; };

	int 	sprd_num	{ %% = MaxInputInt( "飛抹数", 0, 16 ); };	

	int 	sprd_life_min	{ %% = MaxInputInt( "飛抹最小生存時間", 0, 15 ); };
	int 	sprd_life_max	{ %% = MaxInputInt( "飛抹最大生存時間", 0, 20 ); };
	int 	sprd_rad	{ %% = MaxInputInt( "飛抹拡散角度", 0, 512 ); };

	float 	sprd_spd_min 	{ %% = MaxInputFloat( "飛抹最小スピード", 0, 5.0f ); };
	float 	sprd_spd_max 	{ %% = MaxInputFloat( "飛抹最大スピード", 0, 12.0f ); };
	float 	sprd_spd_grav 	{ %% = MaxInputFloat( "飛抹重力", 0, 0.04f ); };

	float 	sprd_size_min 	{ %% = MaxInputFloat( "飛抹最小サイズ", 0, 12.0f ); };
	float 	sprd_size_max 	{ %% = MaxInputFloat( "飛抹最大サイズ", 0, 16.0f ); };

	int 	sprd_tex	{ %% = MaxInputStrCode( "飛抹テクスチャ名", 0, "drop01_msk", "bmp" ); };
	int	sprd_RGBA	{ 
		col = &MaxInputSelectColor( "飛抹色", 0,  48, 48, 48, 48 ) ;
		%% = (col->vx * 256 * 256 * 256) | (col->vy * 256 * 256) | (col->vz * 256) | col->vw; };

	int 	nSeed 		{ %% = MaxInputInt( "ランダムシード", 0, 342145 ); };


}"「飛抹方向回転」で指定された角度だけ回転したZ軸方向に飛抹が飛びます。使用しているテクスチャはsrcファイルに追加してください。";




