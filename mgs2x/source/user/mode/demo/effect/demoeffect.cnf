		%% =  MaxInputListBox( "装備フラグ", 0, "髪の毛(A-1)=0x0001&髪の毛(A-2)=0x0002&髪の毛(A-3)=0x0004&髪の毛(A-4)=0x0008&髪の毛(A-5)=0x0010&髪の毛(B-1)=0x0020&髪の毛(B-2)=0x0040&髪の毛(B-3)=0x0080&髪の毛(B-4)=0x0100&髪の毛(B-5)=0x0200&ブラウス(タイプA)=0x0400&ブラウス(タイプB)=0x0800&ブラウス(タイプC)=0x1000&ブラウス(タイプD)=0x2000", 0x0001) ;
