effect "息" [NewBreathDemo]<id:0x101e><add_src : "smoke_msk.bmp">
{
	int name       { %% = MaxInputGetEffectName( "名前", 0 ) ; } ;
	FMATRIX	*world {		
		link = &MaxInputGetLink( "リンク", 0 ) ;
		handle = DM_GetObjectHandle( link->vx );
		%% = DM_GetObjectMatrix( handle, link->vy );
	};
	FVECTOR *shift { %% = &MaxInputFVector( "シフト", 0,   0.0f,-36.0f,107.0f/*default*/ ) ; } ;
}"
メッセージによって「単発置き」「自動継続」が行われる。\n
「単発置き」はメッセージを送った時だけ「息」が発生し、\n
「自動継続」はメッセージを送った後は指定した間隔で発生し続ける。\n
";

mesg "息" 単発置き[0] "" ;
mesg "息" 自動継続[1] $i:呼び出し間隔 "NTSC 基準のフレーム数(60 = 1s)" ;

/**************************************************************************************

	野外効果系    id 0x2000

****************************************************************************************/
effect "稲光" [NewThunder_Demo] <id:0x2000>
{
	float sx { %% = MaxInputSlideBarF( "X軸", 0, -2.0f, 2.0f, 10,  0.0f/*default*/ ) ; } ;
	float sy { %% = MaxInputSlideBarF( "Y軸", 0, -2.0f, 2.0f, 10,  0.0f/*default*/ ) ; } ;
} "稲光の始点を２次元指定。\nカメラ画面の中心が（０、０）\n   Ｘ軸（左右）： 左端−１〜右端＋１\n   Ｙ軸（左右）： 上端−１〜下端＋１\nＸ、Ｙ共画面外の指定も可。\n稲光の終点は毎回違うが、３次元にした後のＹの最低値をゼロ（水平線）にしている。" ;

effect "風 ローカル" [NewLocalWind_Demo] <id:0x2002>
{
	FVECTOR *pos   { %% = &MaxInputFVector( "場所", 1,   0.0f,0.0f,0.0f/*default*/ ) ; } ;
	FVECTOR *size  { %% = &MaxInputFVector( "大きさ", 0,   3000.0f,1000.0f,3000.0f/*default*/ ) ; } ;
	float rot_y    { %% = MaxInputSlideBarF( "方向", 2, 0.0f, 360.0f, 8,  0.0f/*defualt*/ )*2048.0f/3.14159265f ; } ;
	float rot_diff { %% = MaxInputSlideBarF( "振れ幅", 0, 0.0f, 180.0f,  8, 30.0f/*defualt*/ ) ; } ;
	float intense  { %% = MaxInputSlideBarF( "風速", 0, 1.0f, 10000.0f,  5, 200.0f/*defualt*/ ) ; } ;
	int name       { %% = MaxInputGetEffectName( "名前", 0 ) ; } ;
} "  場所：風が吹く領域の中心位置を表します\n  大きさ：領域の大きさ（幅X、高さY、奥行きZ）\n  方向：風の吹く方向(0〜360°)\n  振れ幅：風の吹く方向がどれだけぶれるかの角度を指定する\n  風速：風の強さを表す\n" ;

mesg "風 ローカル" オフ[0] "風を止めます。" ;
mesg "風 ローカル" オン[1] "風を吹かせます。" ;
mesg "風 ローカル" 終了[2] "終了します。" ;

mesg "効果 波涛" 全体Ｙ変化[2]  $i:Ｙ座標 "波涛全体のyを そのフレームで変えますが、もう既に出てしまっている波涛は、瞬時に変わりません。" ;
mesg "効果 波涛" 波涛だし[1]  $i:Ｘ座標 $i:Ｙ座標 $i:Ｚ座標  $i:向き（３６０°単位） $i:サイズ（％） $i:初期αの差分 "波涛を所定の場所に出します。向きは、0°でワールドのＺ軸の正の方向に出ます。サイズは１００がデフォルトの大きさです。因みにゲーム上の波涛は６００です（個人的には大きすぎる様なきが...）。初期のα差分は、０でデフォルトの濃さになります。薄くしたければ−の値を入れて下さい。あまり大きすぎると変になります（あしからず）。" ;


///////////////////////////////////////////////////////////////////
effect "風 ローカル２" [NewLocalWind2_Demo] <id:0x2004>
{
	int	con_name { %% = MaxInputSelectName( "ダミーポイント", 0 ); };

	FVECTOR	*size  { %% = &MaxInputFVector( "大きさ", 0,   1000.0f,1000.0f,1000.0f/*default*/ ) ; } ;

	float	intense  { %% = MaxInputSlideBarF( "風速", 0, 1.0f, 10000.0f,  5, 200.0f/*defualt*/ ) ; } ;
	int	name       { %% = MaxInputGetEffectName( "名前", 0 ) ; } ;


} "  風が吹く領域の中心位置と方向（Ｚ軸方向）を表します\n  大きさ：領域の大きさ（幅X、高さY、奥行きZ）\n  風速：風の強さを表す \n 優先度：風ローカル２ ＞ 風ローカル１ ＞ ステージ全体の風 \n" ;

mesg "風 ローカル２" オフ[0] "風を止めます。" ;
mesg "風 ローカル２" オン[1] "風を吹かせます。" ;
mesg "風 ローカル２" 終了[2] "終了します。" ;




effect "スローパラメータ制御" [NewSlowParamMan_prog] <id:0x2003>
{
	int name {
		%% = MaxInputGetEffectName( "名前", 0 );
	};
	int param {
		%% = MaxInputSlideBarI( "パーセント", 0, 0, 100, 1, 0 );
	};
} "１００でデフォルトと同等";

