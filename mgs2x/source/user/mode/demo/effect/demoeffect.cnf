effect "効果 壁這う煙" [NewFlyingSmoke] <id:0x600a><add_src : "bombgas6_alp.bmp">
{
	FVECTOR *pos {
		%% = &MaxInputFVector( "発生場所", 1,   0.0f,0.0f,0.0f );
	};
	FVECTOR *vector {
		rot = &MaxInputFVector( "回転", 2,   0.0f,0.0f,0.0f );
		DM_GetFMatrixM_ZXY( &vec, rot, 2 );
		len = MaxInputFloat( "初速", 0, 1.0f );
		sceVu0ScaleVector( &vec, &vec, len );
		%% = &vec;
	};
	int life {
		max = MaxInputGetKeyRangeMax( "フレーム最大", 0 ) ;
		min = MaxInputGetKeyRangeMin( "フレーム最小", 0 ) ;
		%% = (max-min) ;
	} ;
} "Ｃ４の壁を見る煙の単体呼びです。";

