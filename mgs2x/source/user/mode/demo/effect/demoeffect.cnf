} "キャラの足の上下に合わせて足元水飛沫を表示する。一つで両足分を管理する。リンク制御でキャラを指定" ;

effect "水飛沫 身体" [NewBodySplash3] <id:0x104> <add_src : "splash05_alp.bmp,splash07_alp.bmp" >
{
	void *objs    {
		link = &MaxInputGetLink( "リンク", 0 ) ;
		handle = DM_GetObjectHandle( link->vx ) ;
		%% = DM_GetObjectDgObjs( handle ) ;
	} ;
	void *control {
		%% = DM_GetObjectControl( handle ) ;
