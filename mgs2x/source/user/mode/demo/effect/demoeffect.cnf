effect "効果 跳弾" [NewSpark]<id : 0x6000 >
{
	FMATRIX *world
	{
		sceVu0UnitMatrix( &mat ) ;
		pos = &MaxInputFVector( "位置", 1,   0.0f,0.0f,0.0f/*default*/ ) ;
		rot = &MaxInputFVector( "回転", 2,   0.0f,0.0f,0.0f/*default*/ ) ;
		sceVu0RotMatrix( &mat, &mat, rot ) ;
		sceVu0TransMatrix( &mat, &mat, pos ) ;
		%% = &mat ;
	} ;
	FVECTOR *color
	{
		c_ivec = &MaxInputSelectColor( "色", 0,  255, 255, 255, 128 ) ;
		sceVu0ITOF0Vector( &c_fvec, c_ivec ) ;
		%% = &c_fvec ;
	} ;
} "このコメントはでましたか？エフェクト用のコメントです。" ;

effect "効果 光学迷彩" [NewOpticalCamouflageBreakDemo] <id:0x6001>
{
	void *objs      {
		link = &MaxInputGetLink( "リンク", 0 ) ;
		handle = DM_GetObjectHandle( link->vx );
		%% = DM_GetObjectDgObjs( handle );
		fps = MaxInputGetFrameRate( "フレームレート", 0 )/5 ;
	} ;
	int    type	   { %% = MaxInputComboBox( "歪みタイプ", 0, "横歪み=0&縦縮小=1", "横歪み" ) ; } ;
	int    start_time  { %% = MaxInputGetKeyRangeMin( "開始フレーム", 0 )*fps ; } ;
	int    end_time    { %% = MaxInputGetKeyRangeMax( "終了フレーム", 0 )*fps ; } ;
	int    color       { 
		col = &MaxInputSelectColor( "迷彩色", 0,  255, 255, 255, 128 ) ;
		%% = (col->vx) | (col->vy * 256) | (col->vz * 256 * 256 ) ;
	} ;
} "壊れエフェクト発動前の光学迷彩エフェクト処理も含みます。(起動時には通常の光学迷彩としてエフェクトがかかる)このキャラが起動してから開始時間が経過した後に壊れエフェクトが発動します。壊れエフェクトが終了するのはキャラを起動してから終了時間経過後になります。\n  また、壊れエフェクト発動前の光学迷彩エフェクトに対してメッセージで歪みパラメータを変更可能。\nトラックビューにて開始・終了時間を指定。\nリンク制御によって対象オブジェクトを設定。\n  歪みタイプ：：横歪み＝０ 縦縮小＝１\n  迷彩色：：光学迷彩につく色(RGBのみ)" ;

mesg "効果 光学迷彩" 壊れ発動[0] $i:Ｘ方向ずらし量 $i:Ｙ方向ずらし量 $i:補間時間 "ずらし量（ピクセル単位default=16）\n補間時間（１／３００秒単位。最低でも６以上）\n" ;
mesg "効果 光学迷彩" 壊れ発動その２[128] $i:Ｘ方向ずらし量 $i:Ｙ方向ずらし量 $i:補間時間 "ずらし量（ピクセル単位default=16）\n補間時間（１／１０００秒単位。最低でも６以上）\n" ;

effect "効果 光学迷彩２" [NewOpticalCamouflageBreakDemo2] <id:0x6006>
{
	int	name     { %% = MaxInputGetEffectName( "名前", 0 ) ; } ;

	void *objs      {
		link = &MaxInputGetLink( "リンク", 0 ) ;
		handle = DM_GetObjectHandle( link->vx );
		%% = DM_GetObjectDgObjs( handle );
		fps = 300 / MaxInputGetFrameRate( "フレームレート", 0 );
	};
	int    type	   { %% = MaxInputComboBox( "歪みタイプ", 0, "横歪み=0&縦縮小=1", "横歪み" ) ; } ;

	int    start_time  {
		frame = MaxInputInt( "壊れ開始フレーム", 0, 0 ) * 2 * 5 / fps ;
		min = MaxInputGetKeyRangeMin( "フレーム最小", 0 );
		max = MaxInputGetKeyRangeMax( "フレーム最大", 0 );

		%% = (frame - min)*fps;
	};
	int    end_time    { 
		%% = (max - min)*fps;
	};
	int    color       { 
		col = &MaxInputSelectColor( "迷彩色", 0,  255, 255, 255, 128 ) ;
		%% = (col->vx) | (col->vy * 256) | (col->vz * 256 * 256 ) ;
	} ;
} "壊れエフェクト発動前の光学迷彩エフェクト処理も含みます。(起動時には通常の光学迷彩としてエフェクトがかかる)このキャラが起動してから開始時間が経過した後に壊れエフェクトが発動します。壊れエフェクトが終了するのはキャラを起動してから終了時間経過後になります。\n  また、壊れエフェクト発動前の光学迷彩エフェクトに対してメッセージで歪みパラメータを変更可能。\nトラックビューにて開始・終了時間を指定。\nリンク制御によって対象オブジェクトを設定。\n  歪みタイプ：：横歪み＝０ 縦縮小＝１\n  迷彩色：：光学迷彩につく色(RGBのみ)" ;

mesg "効果 光学迷彩２" 壊れ発動[0] $i:Ｘ方向ずらし量 $i:Ｙ方向ずらし量 $i:補間時間 "ずらし量（ピクセル単位default=16）\n補間時間（１／３００秒単位。最低でも６以上）\n" ;
mesg "効果 光学迷彩２" 壊れ発動その２[128] $i:Ｘ方向ずらし量 $i:Ｙ方向ずらし量 $i:補間時間 "ずらし量（ピクセル単位default=16）\n補間時間（１／１０００秒単位。最低でも６以上）\n" ;


effect "効果 プラズマ（ポリ）" [NewPlasmaPoly_Demo] <id:0x6002>
