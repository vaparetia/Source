effect "水飛沫 波涛" [NewWaveSplash_Demo] <id:0x107> <add_src : "splash05_alp.bmp,splash03_alp.bmp,splash07_alp.bmp" >
{
	FMATRIX *root  {
		sceVu0UnitMatrix( &mat ) ;
		pos = &MaxInputFVector( "位置", 1,   0.0f,0.0f,0.0f/*default*/ ) ;
		rot = &MaxInputFVector( "回転", 2,   0.0f,0.0f,0.0f/*default*/ ) ;
		sceVu0RotMatrix( &mat, &mat, rot ) ;
		sceVu0TransMatrix( &mat, &mat, pos ) ;
		%% = &mat ;
	} ;
	float   scale    { %% = MaxInputFloat( "大きさ", 0,  4.0f/*default*/ ) ; } ;
	int     alpha    { %% = MaxInputSlideBarI( "ベースアルファ", 0, -64, 64, 16, 1 ) ; } ;
} "位置から指定した方向に波涛が出ます。ベースアルファは、デフォルト状態(ベースアルファを0の状態)からどれだけ下げたり上げたりするかの値を入れます。まず０で試して、濃い方が良いか、薄い方が良いか、調整して下さい。" ;

effect "水飛沫 波涛カラー" [NewWaveSplash_Demo2] <id:0x10c> <add_src : "splash05_alp.bmp,splash03_alp.bmp,splash07_alp.bmp" >
{
	FMATRIX *root  {
		sceVu0UnitMatrix( &mat ) ;
		pos = &MaxInputFVector( "位置", 1,   0.0f,0.0f,0.0f/*default*/ ) ;
		rot = &MaxInputFVector( "回転", 2,   0.0f,0.0f,0.0f/*default*/ ) ;
		sceVu0RotMatrix( &mat, &mat, rot ) ;
		sceVu0TransMatrix( &mat, &mat, pos ) ;
		%% = &mat ;
	} ;
	float   scale    { %% = MaxInputFloat( "大きさ", 0,  4.0f/*default*/ ) ; } ;
	int     alpha    { 
		temp = MaxInputSlideBarI( "ベースアルファ", 0, -64, 64, 16, 1 );
