effect "外部出力 振動再生" [NewPadVibration2]<id : 0x9000 >
{
	int   vib_file { %% = MaxInputStrCode( "振動ファイル名（VIB）", 0,  "wtdoor_close.vib"/*default*/, "vib" ) ; } ;
	int   frame {
		mode = MaxInputComboBox( "モード", 0, "スケール再生=1&そのまま再生=-1", "スケール再生" ) ;
		max = MaxInputGetKeyRangeMax( "フレーム最大", 0 ) ;
		min = MaxInputGetKeyRangeMin( "フレーム最小", 0 ) ;
		%% = (max - min)*mode ;
	} ;
} "VIBのファイル名を入れて下さい。振動データが有効フレームに引き延ばされて再生されます。" ;

