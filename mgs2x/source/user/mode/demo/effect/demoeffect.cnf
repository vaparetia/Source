effect "効果 汎用パーティクル"[NewMAOParticle]<id : 0x601c>
{

	int	nRandSeed	{ %% = MaxInputInt( "ランダムシード", 0, 432423 ); };
	FMATRIX *world 		{
		link = &MaxInputGetLink( "リンク", 0  ) ;
		handle = DM_GetObjectHandle( link->vx );
		%% = DM_GetObjectMatrix(handle,link->vy); };
	int	nRrimNum	{ %% = MaxInputInt( "発生数", 0, 4 ); };
	int	nVertNum	{ %% = MaxInputInt( "頂点数", 0, 8 ); };
	int	nLifeMin	{ %% = MaxInputInt( "最小生存時間", 0, 240 ); };
	int	nLifeMax	{ %% = MaxInputInt( "最大生存時間", 0, 360 ); };
	int	nAng		{ %% = MaxInputInt( "角度範囲", 0, 128 ); };
	float 	fInitSpd   	{ %% = MaxInputFloat( "初期速度"  , 0,  4.0f/*default*/ ) ; } ;
	float 	fAimSpd    	{ %% = MaxInputFloat( "目標速度", 0,  0.25f/*default*/ ) ; } ;
	float 	fGravity 	{ %% = MaxInputFloat( "重力", 0,  -0.01f/*default*/ ) ; } ;
	float 	fInitSize   	{ %% = MaxInputFloat( "初期サイズ"  , 0,  10.0f/*default*/ ) ; } ;
	float 	fAimSize    	{ %% = MaxInputFloat( "目標サイズ", 0,  200.0f/*default*/ ) ; } ;
	int 	tex_code	{ %% = MaxInputStrCode( "ＴＥＸ名", 0, "", "bmp" ); };
	int     nInitRGBA      	{
		col = &MaxInputSelectColor( "色", 0,  128, 128, 128, 128 ) ;
		%% = (col->vx * 256 * 256 * 256) | (col->vy * 256 * 256) | (col->vz * 256) | (col->vw) ; };
	int     nAimRGBA      	{
		col = &MaxInputSelectColor( "色", 0,  128, 128, 128, 128 ) ;
		%% = (col->vx * 256 * 256 * 256) | (col->vy * 256 * 256) | (col->vz * 256) | (col->vw) ; };
	float 	fRandRate    	{ %% = MaxInputFloat( "ランダム幅", 0,  1.0f/*default*/ ) ; } ;
	int	nFlag		{ %% = MaxInputInt( "拡張フラグ", 0, 0 ); };

}"汎用パーティクルです。「オタコンの唾」「水中の鎖の錆」に使用予定です。\n速度、サイズ、色値は生存時間を越えると目標値になります。\nランダムシードには大きな値を入れて下さい。\n[拡張フラグ]\n 0,1 : 半透明\n 2   :加算半透明\n 4   :減算半透明\n基本パラメータは奥田さんが設定した「水中の鎖の錆」パラメータです。詳細はＨＰ参照。";

