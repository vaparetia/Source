		%% = &MaxInputFVector("シフト", 1, 0.0f, 0.0f, 0.0f);
	};
	float height { %% = MaxInputFloat( "発射の強さ", 0, 0.0f/*default*/ ); };
	int size {
		%% = MaxInputInt( "サイズ", 0, 5 );
	};

}"
リンク先が動くと勝手に補完します。\n
メッセージによって「単発置き」「自動継続」が行われる。\n
「単発置き」はメッセージを送った時だけ発生し、\n
「自動継続」はメッセージを送った後は指定した間隔で発生し続ける。\n
";

mesg "血_滴り" 単発置き[0] "" ;
mesg "血_滴り" 自動継続[1] $i:呼び出し間隔 "NTSC 基準のフレーム数(60 = 1s)" ;



effect "血_天井滴り血" [NewBloodWeep]<id:0x700b><add_src : "drop01_alp2_mod1021.bmp">
{
	FMATRIX *world
	{
		sceVu0UnitMatrix( &mat );
		pos = &MaxInputFVector( "位置", 1,   0.0f,0.0f,0.0f/*default*/ );
		rot = &MaxInputFVector( "回転", 2,   0.0f,0.0f,0.0f/*default*/ );
		sceVu0RotMatrix( &mat, &mat, rot );
		sceVu0TransMatrix( &mat, &mat, pos );
		%% = &mat;
	};
	int 	nLife 		{ %% = MaxInputInt( "生存時間", 0, 600 ); };
	int 	nDrip 		{ %% = MaxInputInt( "溜り時間", 0, 180 ); };
	float	fKillY		{ %% = MaxInputFloat( "着地高さ", 0, 30.0f ); };
	float 	speed 		{ %% = MaxInputFloat( "落下速度", 0, 10.0f ); };
	float 	drop_size 	{ %% = MaxInputFloat( "滴の大きさ", 0, 30.0f ); };
	float 	drip_rad 	{ %% = MaxInputFloat( "溜り半径", 0, 150.0f ); };
	float 	nLenter 	{ %% = MaxInputFloat( "粘性", 0, 0.8f ); };
	int	color		{ 
		col = &MaxInputSelectColor( "色", 0,  12, 0, 0, 128 ) ;
		%% = (col->vx * 256 * 256 * 256) | (col->vy * 256 * 256) | (col->vz * 256) | col->vw; };
	int 	nSeed 		{ %% = MaxInputInt( "ランダムシード", 0, 5132451 ); };
	int 	nFlag 		{ %% = MaxInputInt( "フラグ", 0, 0 ); };


}"指定された座標に丸い溜りができる→中心が下に垂れる→滴が落ちる→着地すると飛抹が出て、床に血がつく。\n
落下地点の関係から、発生高さを天井高さではなく少し下（１０くらい）下げてください。現在フラグは対応していません。";


