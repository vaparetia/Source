	void *object2     {
		link = &MaxInputHumanNum( "結ぶ先の名前", 0 ) ;
		handle = DM_GetObjectHandle( link->vx );
		%% = DM_GetObjectObject( handle );
	} ;
	int objnum2       { %% = link->vy ; } ;
} "KMSモデルを手錠として計算、表示します。手錠の計算とは、あるモデル上の二つの点を結ぶように、手錠のモデルを配置することです。この際に、KMSモデルの長さと二点の距離から出来る、モデルの垂れ具合も計算します。\n使用時には、結び付ける元のモデルをリンクで指定し、結び付ける先の関節番号を数値で指定して下さい。あと、拡張機能として、結び付ける先を別のモデルに指定することも出来ます。";

mesg "手錠モデル表示" 表示制御[0] $i:フラグ "1 : 表示\n0 : 非表示\n-1 : 現在の状態から反転\n" ;

