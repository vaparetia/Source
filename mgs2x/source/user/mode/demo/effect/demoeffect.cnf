effect "２Ｄ　スプライト表示" [New2DSprite_Prog] <id:0x00d>
{
	int tri_code {
		%% = MaxInputStrCode( "ＴＲＩ名", 0, "", "" );
	};
	int tex_code {
		%% = MaxInputStrCode( "ＴＥＸ名", 0, "", "" );
	};
	FVECTOR *data { 
		DM_InFVector(&temp,
				MaxInputFloat( "Ｘ座標", 0, 0.0f ),
				MaxInputFloat( "Ｙ座標", 0, 0.0f ),
				MaxInputFloat( "Ｘスケール", 0, 1.0f ),
				MaxInputFloat( "Ｙスケール", 0, 1.0f ) );
		%% = &temp;
	};
	int wide { %% = MaxInputInt( "幅", 0,  512 ) ; } ;
	int high { %% = MaxInputInt( "高さ", 0,  384 ) ; } ;
	SVECTOR *time { %% = &MaxInputSVector( "タイム", 0,  60.0f,128.0f,60.0f  ) ; } ;
	int flags { %% = MaxInputListBox( "フラグ", 0, "右合わせ=0x01&下合わせ=0x02&中心合わせ=0x10&優先下げ=0x100",0x00); };
}
"２Ｄのスプライト表示です。（座標系(0,0)<->(512,384)）\nTIRは一まとめにした方がいいです。\nデータ：\n\t:Ｘ座標\n\t:Ｙ座標\n\t:スケールＸ\n\t:スケールＹ\n幅と高さ:幅に-1を入れるとTEXそのまま\n時間:(６０フレーム)\n\tx:フェードイン\n\ty:そのまま\n\tz:フェードアウト\nフラグ:\n\t何も設定しないと左上をあわせます。\n中心合わせはその他のフラグと両立できません。" ;

effect "フォグ" [NewFogSet_Demo]<id : 0x000 ><no_birth>
{
	int r {
		col = &MaxInputSelectColor( "色", 0,  16,32,27,128/*default*/ ) ;
		%% = col->vx ;
	} ;
	int g { %% = col->vy ; } ;
	int b { %% = col->vz ; } ;
	float near_para { %% = MaxInputFloat( "Near", 0, 50000 ) ; } ;
	float far_para  { %% = MaxInputFloat( "Far", 0, 100000 ) ; } ;
	int time
	{
		max = MaxInputGetKeyRangeMax( "フレーム最大", 0 ) ;
		min = MaxInputGetKeyRangeMin( "フレーム最小", 0 ) ;
		%% = (max-min) ;
	} ;
} "フォグ効果。\n  色：フォグの色\n  Near：フォグが掛かり始める距離\n  Far：指定した色になる距離\nトラックビューで変化時間を設定" ;



effect "フォグ 変更可＆不可" [OK_FogStatusSet] <id:0x0018><no_birth>
{
	int command { %% = MaxInputComboBox( "変更", 0, "可=0&不可=1", "可" ); };

}"
プログラム内でフォグを変更しているエフェクト（リニアガン発射 等）の \n「フォグのパラメータ変更」の「可」「不可」を制御するようにしました。\n何も指定しない場合のデフォルトは「可」です。\n \n「不可」にした後、さらにデモツールでフォグを変更したい場合、\n
「可」に戻して下さい。
";



effect "遠景ぼかし" [NewFarFocusEffect]<id : 0x001 >
{
	int	name     { %% = MaxInputGetEffectName( "名前", 0 ) ; } ;
	int	max_plane{ %% = MaxInputInt( "最大描画枚数", 0,  4/*default*/ ) ; } ;
	int	near_para{ %% = MaxInputInt( "ぼかし最小距離", 0, 50000 ) ; } ;
	int	far_para { %% = MaxInputInt( "ぼかし最大距離", 0, 2000000 ) ; } ;
} "最大描画枚数は４ぐらいが適当かも。\n起動後のコントロールにはメッセージを使用します。また、メッセージで指定する補間時間は１／３００秒単位での指定なので注意してください。メッセージにおいて１／１０００秒単位での指定に対応しました。" ;
mesg "遠景ぼかし" 機能ＯＦＦ[0] "ぼかし機能をなくします。" ;
mesg "遠景ぼかし" 機能ＯＮ[1]  "ぼかし機能が有効になります。" ;
mesg "遠景ぼかし" ぼかし調節[2] $w:補間時間 $b:補間タイプ $i:ぼかし最小距離 $i:ぼかし最大距離
	"※現在指定できる補間タイプは０のみである。\n" ;


effect "近景ぼかし" [NewNearFocusEffect]<id : 0x002 >
{
	int	name     { %% = MaxInputGetEffectName( "名前", 0 ) ; } ;
	int	max_plane{ %% = MaxInputInt( "最大描画枚数", 0, 4/*default*/ ) ; } ;
	int	near_para{ %% = MaxInputInt( "ぼかし最小距離", 0,  0.0f/*default*/ ) ; } ;
	int	far_para { %% = MaxInputInt( "ぼかし最大距離", 0,  3000.0f/*default*/ ) ; } ;
} "最大描画枚数は４ぐらいが適当かも。\n起動後のコントロールにはメッセージを使用します。また、メッセージで指定する補間時間は１／３００秒単位での指定なので注意してください。メッセージにおいて１／１０００秒単位での指定に対応しました。" ;

mesg "近景ぼかし" 機能ＯＦＦ[0]	"ぼかし機能をなくします。" ;
mesg "近景ぼかし" 機能ＯＮ[1]	"ぼかし機能が有効になります。" ;
mesg "近景ぼかし" ぼかし調節[2] $w:補間時間 $b:補間タイプ $i:ぼかし最小距離 $i:ぼかし最大距離
		"※現在指定できる補間タイプは０のみである。\n" ;


