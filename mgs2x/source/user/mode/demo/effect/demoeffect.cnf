effect "効果 フォーチュンバリアー" [NewFortBarrierDemo]<id:0x6014><add_src : "bombpowder1_msk.bmp">
{
	void *objs {
		link = &MaxInputGetLink( "リンク", 0 );
		handle = DM_GetObjectHandle( link->vx ) ;
		%% = DM_GetObjectDgObjs( handle ) ;
	} ;
	float length   { %% = MaxInputFloat( "煙表示開始距離"  , 0,  3000.0f/*default*/ ) ; } ;
	float front    { %% = MaxInputFloat( "煙曲がり始め距離", 0,  2000.0f/*default*/ ) ; } ;
	float vertical { %% = MaxInputFloat( "煙曲がり垂直距離", 0,  1000.0f/*default*/ ) ; } ;
	float size   { %% = MaxInputFloat( "ターゲットの大きさ(mm)", 0, 1000.0f/*default*/ ) ; } ;
	int   where  { %% = DM_GetCurrentMap(); };
	int   flag   { %% = MaxInputComboBox( "フラグ", 0, "なし=0&デバッグ=1", "なし" ); };
} "要リンク。\nフォーチュン戦で使われているフォーチュンバリアーです。普通の弾(「火器 着弾簡易エフェクト」または「火器 簡易エフェクト」)の弾が当たると回避効果が出ます。基本的に着弾方向によって自動的に回避曲線が計算されて表示されます。リンク制御でリンクしたヒューマンの腰を中心としてターゲットが貼られます。\n\n[引数について]\n\n[煙表示開始距離]： ターゲット(リンク制御先)から指定した距離から表示が開始されます。\n\n[煙曲がり始め距離]：ターゲット(リンク制御先)から指定した距離から弾丸が曲がり始めます。つまり大きくすれば出来上がる曲線はなめらかになります。\n\n[煙表曲がり垂直距離]： ターゲット(リンク制御先)から垂直(ターゲットに対して)に伸びる距離。つまり大きくすれば大きくそれます。\n\n[ターゲットの大きさ]： リンク先の腰につくターゲットの大きさを指定できます。\n\n[フラグ]： デバッグフラグを立てられます。立てるとターゲットの大きさにオレンジ色の枠が出ます。" ;

effect "効果 プラズマ回避エフェクト" [NewPlasmaEvade]<id:0x6029>
{
	int	name	{ %% = MaxInputGetEffectName( "名前", 0 ); };

	FMATRIX *pmatOrg
	{
		link = &MaxInputHumanNum( "リニアガンへのリンク", 0 );
		handle = DM_GetObjectHandle( link->vx ) ;
		%% = DM_GetObjectMatrix( handle, link->vy );
	};

	FMATRIX *pmatRepel
	{
		sceVu0UnitMatrix( &mat2 );
		pos2 = &MaxInputFVector( "回避マトリクス位置", 1,   0.0f,0.0f,0.0f/*default*/ );
		rot2 = &MaxInputFVector( "回避マトリクス回転", 2,   0.0f,0.0f,0.0f/*default*/ );
		sceVu0RotMatrix( &mat2, &mat2, rot2 );
		sceVu0TransMatrix( &mat2, &mat2, pos2 );
		%% = &mat2;
	};

	int	straight_node 	{ %% = 5 ; };
	int	branch_node 	{ %% = 7 ; };

	float fOneDist	{ %% = MaxInputFloat( "バリアの長さ",     0, 70.0f ); };
	float fOneRad	{ %% = MaxInputFloat( "バリアの半径の√", 0, 4000.0f ); };

	int     nBaseAng 	{ %% = MaxInputSlideBarI( "基本方向", 0, 0/*min*/, 4096/*max*/, 16/*seg*/, 3572/*default*/ ) ; };
	int	nAddAngMin 	{ %% = -164 ; };
	int	nAddAngMax 	{ %% =  164 ; };

	int	nRandSeed 	{ %% = MaxInputInt( "ランダムシード", 0, 589955 ); };

}"オセロットがフォーチュンのリニアガンを回避するときのエフェクトです。\n「リニアガンへのリンク」はリニアガンのモデルを選んで下さい。エフェクトを置いた時点での、リニアガンからエフェクトの位置へ発射されます。ランダムシードを変えることで形を変えることができます。複数置く場合は、何らかの数字に変えることを尾勧め致します。基本方向は、プラズマが曲がり避ける方向（０から４０９６）となります。プラズマは１ノードを３２頂点として、０〜（直線で進むノード数）個までは直線で弾く座標に向かって進み、それ以降はバリアに沿って枝別れしていきます。バリアにぶつかった際、どの方向に曲がるかは（基本方向）で決めます。ノードの長さが１５００を越えると見た目に粒なのがばれるので、直線部分を長くしたいときは（直線で進むノード数）を増やしてください。ノードは最大数が２５６なので数を増やし過ぎると出なくなります。\nサンプル値で大体出るようになっているので参考にしてください。";

