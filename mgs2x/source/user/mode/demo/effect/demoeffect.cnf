effect "効果 マズルフラッシュ" [NewCallMazzle] <id:0x600d><add_src : "socom_f_msk.bmp , col128_add.bmp , smoke_msk.bmp">
{
	int maz_id {
		%% = MaxInputComboBox( "種類", 0, "ＵＳＰ=1&ＦＡＭＡＳ=2&ＭＫＲ=3&ＡＫＳ=4", "ＵＳＰ" ) ;
	};
	FMATRIX *world {
		sceVu0UnitMatrix( &mat ) ;
		pos = &MaxInputFVector( "位置", 1,   0.0f,0.0f,0.0f/*default*/ ) ;
		rot = &MaxInputFVector( "回転", 2,   0.0f,0.0f,0.0f/*default*/ ) ;
		sceVu0RotMatrix( &mat, &mat, rot ) ;
		sceVu0TransMatrix( &mat, &mat, pos ) ;
		%% = &mat ;
	};
