effect "効果 頂点アニメブラー" [NewVanimeBullerCall] <id:0x6004>
{
	int id {
		%% = MaxInputStrCode( "モデル名", 0, "shock1"/*default*/, "cv2" );
	};
	float rot_y {
		%% = MaxInputFloat( "Ｙ軸回転速度", 0, 0.0f );
	};
	float speed {
		%% = MaxInputFloat( "速度", 0, 100.0f );
	};
	FVECTOR *from	{
		%% = &MaxInputFVector("始点", 1, 0.0f, 0.0f, 0.0f);
	};
	FVECTOR *to	{
		%% = &MaxInputFVector("終点", 0, 0.0f, 0.0f, 10000.0f);
	};
	int base { %% = MaxInputInt( "補間フレーム数", 0, 40 ); };
	int rand { %% = MaxInputInt( "補間フレーム数の乱数幅", 0, 0 ); };
	int flag { %% =  MaxInputListBox( "各種フラグ", 0, "デバッグ表示=0x01",0x00);};
}"[機能]\n  頂点アニメモデルを光学迷彩で表示する。\n[引数について]\n  モデルIDは、同じ名前のKNSおよびCV2が必要です。方向に対する移動速度が設\n  定されていると、その向きに移動します。初期位置は、ワールド座標である。\n  初期位置から目標点に向かってモデルの向きを変えます。そのときY軸の正の\n  方向のものを指定したベクトルの向きに変えます。ベースキーフレームは、頂\n  点アニメのオブジェクト同士を何フレームで補間するかを決めるパラメータです。\n  乱数幅は、ベースフレームからどのくらいバラツキを出すかどうかです。\n  デバッグモードは、０は通常モード、１はデバッグモードとなります。\nKMSのキーフレームとなるモデルは、順序良くOBJとして並んでいなければならず、\n頂点数ポリゴン数ともに同じものでなければなりません。\nモデルは,effect/shock1.kmsです。";

effect "効果 弾丸" [NewDemoBulletCall] <id:0x6005>
{
	int id {
		%% = MaxInputStrCode( "モデル名", 0, "usp_emb"/*default*/, "kms" );
	};
	float rot_y {
		%% = MaxInputFloat( "Ｙ軸回転速度", 0, 0.0f );
	};
	float speed {
		%% = MaxInputFloat( "速度", 0, 100.0f );
	};
	FVECTOR *from	{
		%% = &MaxInputFVector("始点", 1, 0.0f, 0.0f, 0.0f);
	};
	FVECTOR *to	{
		%% = &MaxInputFVector("終点", 0, 0.0f, 0.0f, 10000.0f);
	};
	int flag { %% =  MaxInputListBox( "各種フラグ", 0, "デバッグ表示=0x01",0x00);};

}"[機能]\n  スクリュー状に煙を出したながら回転して進む弾丸\n[引数について]\n  モデルIDは、同じ名前のKNSおよびCV2が必要です。方向に対する移動速度が設\n  定されていると、その向きに移動します。初期位置は、ワールド座標である。\n  初期位置から目標点に向かってモデルの向きを変えます。そのときY軸の正の\n  方向のものを指定したベクトルの向きに変えます。\n  デバッグモードは、０は通常モード、１はデバッグモードとなります。\nKMSのキーフレームとなるモデルは、順序良くOBJとして並んでいなければならず、\n頂点数ポリゴン数ともに同じものでなければなりません。\nモデルは,effect/shock1.kmsです。";


effect "効果 コモデル破片" [NewDebris_Cm_Demo] <id:0x6007>
{
	FVECTOR *bound0 {
		%% = &MaxInputFVector( "発生場所１", 1,   0.0f,0.0f,0.0f );
	};
	FVECTOR *bound1 {
		%% = &MaxInputFVector( "発生場所２", 0,   0.0f,0.0f,0.0f );
	};
	FVECTOR	*force {
		rot = &MaxInputFVector( "回転", 2,   0.0f,0.0f,0.0f );
		DM_GetFMatrixM_ZXY( &vec, rot, 2 );
		%% = &vec;
		//%% = &MaxInputFVector( "方向", 0, 0.0f,1.0f,0.0f );
	};
	float pow {
		%% = MaxInputFloat( "初速", 0, 1.0f );
	};
	int num { %% = MaxInputInt( "個数", 0, 0 ); };
	int objcode { %% = MaxInputStrCode( "モデル名", 0, "", "kms" ); };
	int color {
		col = &MaxInputSelectColor( "色", 0,  128, 128, 128, 0 ) ;
		%% = (col->vx * 256 * 256 * 256) | (col->vy * 256 * 256) | (col->vz * 256) ;
	};
	float scale {
		%% = MaxInputFloat( "スケール", 0, 1.0f );
	};
	int flags { 
		%% = MaxInputListBox( "各種フラグ", 0,
							"床当たり毎回計算=0x01&床辺り有り=0x02",
							0x02);
	};
} "発生場所１，２\n\t１，２に囲まれる矩形で発生します。\n\t同じにするとその場所から\n方向\nスケール\n\t後でランダムが入るので目安です\nフラグ\n\t毎回計算は重いです";

