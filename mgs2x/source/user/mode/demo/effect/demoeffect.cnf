effect "頂点ストリームアニメ" [NewPutSTanimeObjectCall] <id:0x4000> 
{
	int name	{ %% = MaxInputGetEffectName( "名前", 0 ) ; } ;
	int model	{ %% = MaxInputStrCode( "XSI,KMS,CV2モデル", 0, "d00a_divewire"/*default*/, "xsi" ) ; } ;
	void *obj	{
		link = &MaxInputGetLink( "リンク", 0 ) ;
		handle = DM_GetObjectHandle( link->vx );
		%% = DM_GetObjectDgObj( handle, link->vy );
	} ;
	FVECTOR *pos    { %% = &MaxInputFVector( "位置", 1,  0.0f,0.0f,0.0f/*default*/ ) ; } ;
	SVECTOR *rot    { %% = &MaxInputSVector( "回転", 2,  0.0f,0.0f,0.0f/*default*/ ) ; } ;
	FVECTOR *scale  { %% = &MaxInputFVector( "スケール", 3,  1.0f,1.0f,1.0f/*default*/ ) ; } ;
	FVECTOR *bound_u{ %% = &MaxInputFVector( "バウンド最大", 0, 10000.0f,10000.0f,10000.0f/*default*/ ) ; } ;
	FVECTOR *bound_l{ %% = &MaxInputFVector( "バウンド最小", 0, -10000.0f,-10000.0f,-10000.0f/*default*/ ) ; } ;
	int mode	{ %% = MaxInputComboBox( "モード", 0, "普通再生=1&繰返し再生=2", "普通再生" ) ; } ;
} "モデル名（必須） KMS, ANM, CV2 が必要 名前は共通\nリンク制御によってオブジェクトにリンクします。\n  位置：：ローカル位置\n  回転：：ローカル回転（°単位）\n  スケール：：1.0を等バイトする大きさ\n  バウンド：：再生時に最大状態のバウンダリを指定します。\n  再生モード：：再生＝１ 繰返し表示＝２\n再生は、起動時に必ず掛かります。" ;

mesg "頂点ストリームアニメ" 停止[0] "アニメーションが止まります（ポーズ状態）" ;
mesg "頂点ストリームアニメ" 再生[1] "アニメーションが再開します（再生）" ;
mesg "頂点ストリームアニメ" 終了[2] "キャラを終了します。" ;
mesg "頂点ストリームアニメ" 再生スピード変更[3] $i:スピード "スピードを変更します。遅くにしかなりません。2を入れると2倍遅くなります。整数倍に遅くすることが出来ます。" ;
mesg "頂点ストリームアニメ" 再生レイト変更[4] $i:レイト "再生レイトを変更します。4096を1/30secに換算した値です。つまり、大きくすると速くなり小さくすると遅くなります。1から4096までしか入りません。デフォルトの値は、2048(1/60sec)です。" ;


