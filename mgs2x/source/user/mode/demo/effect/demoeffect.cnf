effect "装備品 レインコート" [NewRaincoat_called] <id:0x1005><force_effect>
{
	void *body{
		link = &MaxInputGetLink( "リンク", 0 ) ;
		handle = DM_GetObjectHandle( link->vx );
		%% = DM_GetObjectObject( handle ) ;
	} ;
	int  *sg_name   {
		%%  = &MaxInputStrCode( "アニメモデル名1（CV2/KMS）", 0,  "tnr_coat_up_blood00"/*default*/, "kms,cv2" ) ;
		nm2 = &MaxInputStrCode( "アニメモデル名2（CV2）", 0,  "tnr_coat_sgl_anim00"/*default*/, "cv2" ) ;
		nm3 = &MaxInputStrCode( "アニメモデル名3（CV2）", 0,  "tnr_coat_sgl_anim01"/*default*/, "cv2" ) ;
		nm4 = &MaxInputStrCode( "アニメモデル名4（CV2）", 0,  ""/*default*/, "cv2" ) ;
		nm5 = &MaxInputStrCode( "アニメモデル名5（CV2）", 0,  ""/*default*/, "cv2" ) ;
		nm6 = &MaxInputStrCode( "アニメモデル名6（CV2）", 0,  ""/*default*/, "cv2" ) ;
		nm7 = &MaxInputStrCode( "アニメモデル名7（CV2）", 0,  ""/*default*/, "cv2" ) ;
		nm8 = &MaxInputStrCode( "アニメモデル名8（CV2）", 0,  ""/*default*/, "cv2" ) ;
	} ;
	int   sg_num    { %% = MaxInputSlideBarI( "アニメモデルの個数", 0, 1, 8, 8, 3/*default*/ ) ; } ;
	int   mt_name   { %% = MaxInputStrCode( "コートモデル名（EVM）", 0,  "tnr_coat_mlch"/*default*/, "evm" ) ; } ;
	float wind_min  { %% = MaxInputFloat( "風の強さの最小値", 0,  50.0f/*default*/ ) ; } ;
	float wind_max  { %% = MaxInputFloat( "風の強さの最大値", 0,  250.0f/*default*/ ) ; } ;
	float frame_min  { %% = MaxInputFloat( "アニメフレーム最大値", 0, 3.0f/*default*/ ) ; } ;
	float frame_max  { %% = MaxInputFloat( "アニメフレーム最小値", 0, 1.5f/*default*/ ) ; } ;
} "レインコートモデルを指定する。アニメモデルには、最初のモデルのみCV2,KMSが必要です。残りは、CV2だけでいいです。データとして、デフォルトではtnr_coat_up_blood00.kms\n  tnr_coat_up_blood00.cv2\n  tnr_coat_sgl_anim00.cv2\n  tnr_coat_sgl_anim01.cv2\n  tnr_coat_mlch.evm\nを用意し、tnr_corpse.kmsを表示にリンク制御で指定してみてください。\n風の強さは、ばたばたアニメが影響する風の最大値と最小値を入れて下さい。" ;


