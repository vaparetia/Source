effect "全画面 クロスフェード" [NewCrossFadeEffect]<id:0x0012>
{
	int		time {
		max = MaxInputGetKeyRangeMax( "フレーム最大", 0 ) ;
		min = MaxInputGetKeyRangeMin( "フレーム最小", 0 ) ;
		fps = 300 / MaxInputGetFrameRate( "フレームレート", 0 );
		%% = (max-min)*fps ;
	};
}"リンク不可\nキャラを起動したときのフレームを退避し、指定時間かけてクロスフェードを行う１つ起動するごとにメモリを５１２ＫＢ消費するので注意すること！\n（起動タイミングとしてはカメラが変化したタイミングで起動すると切り替え前の最終フレームをクロスフェード用として取り込むことができる）";

effect "フレームスキップスロー" [NewCrossFadeEffectCustom] <id:0x0013>
{
	int		time {
		max = MaxInputGetKeyRangeMax( "フレーム最大", 0 ) ;
		min = MaxInputGetKeyRangeMin( "フレーム最小", 0 ) ;
		fps = 300 / MaxInputGetFrameRate( "フレームレート", 0 );
		%% = (max-min)*fps ;
	};
	int		capture_interval {
		temp = MaxInputInt( "スキップ数", 0, 0 );
		%% = temp*10 ;
	};
	int		bright_time {
		temp = MaxInputInt( "輝度変化時間", 0, 0 );
		%% = temp*10 ;
	};
	int		alpha_time {
		temp = MaxInputInt( "α変化時間", 0, 0 );
		%% = temp*10 ;
	};
	int flag { %% = 0; };
	
}"リンク不可\nフレームバッファの再取り込みを行うと自動的に輝度とアルファのフェードが\n初期値に戻る\n輝度の変化時間を０にすると常に輝度が１００％になる\nアルファの変化時間を０にすると常にアルファが１２８になる\n1/30秒";


effect "沈む太陽" [NewDemoSun] <id:0x01f> 
{
	int	name		{ %% = MaxInputGetEffectName( "名前", 0 ); };
	FMATRIX *root  {
		sceVu0UnitMatrix( &mat ) ;
		pos = &MaxInputFVector( "位置", 1,   0.0f,0.0f,0.0f/*default*/ ) ;
		rot = &MaxInputFVector( "回転", 2,   0.0f,0.0f,0.0f/*default*/ ) ;
		sceVu0RotMatrix( &mat, &mat, rot ) ;
		sceVu0TransMatrix( &mat, &mat, pos ) ;
		%% = &mat ;
	} ;
	float   speed   	{ %% = MaxInputFloat( "速度", 0, 0.0f ) ; } ;
	float   scale   	{ %% = MaxInputFloat( "スケール", 0, 110.0f ) ; } ;
	int	w 		{ %% = MaxInputInt( "幅", 0, 240 /*default*/ ); };
	int	h 		{ %% = MaxInputInt( "高さ", 0, 240 /*default*/ ); };
	int     col		{
			col = &MaxInputSelectColor( "色", 0,  128, 128, 128, 128 ) ;
			%% = (col->vx * 256 * 256 * 256) | (col->vy * 256 * 256) | (col->vz * 256) | (col->vw) ; };
	int	alpha 		{ %% = MaxInputInt( "レンズフレアのアルファ", 0,  18 /*default*/ ); };

} "デフォルト値はゲーム中の太陽のデフォルト値にしています。" ;

mesg "沈む太陽" 表示[0]	"表示します。" ;
mesg "沈む太陽" 非表示[1]  "非表示にします。" ;
mesg "沈む太陽" スピード変更[2] $i:スピード $i:補間時間 "指定された時間だけかけて指定スピードになります。" ;
mesg "沈む太陽" 色変更[3] $i:Ｒ $i:Ｇ $i:Ｂ $i:Ａ $i:補間時間 "指定された時間だけかけて指定色になります。" ;


effect "ガソリン炎" [NewExplosionControl_Demo] <id:0x021> <add_src : "bombsphere01_alp.bmp, bombsphere03_alp.bmp, bombsphere04_alp.bmp">
{
	int	name		{ %% = MaxInputGetEffectName( "名前", 0 ); };

	FMATRIX *world {
		link = &MaxInputGetLink( "リンク", 0  ) ;
		handle = DM_GetObjectHandle( link->vx );
		%% = DM_GetObjectMatrix(handle,link->vy);
	};
} "

初期状態では何も発生しません。\n
メッセージで送られたデータにより継続して発生させます。
" ;

mesg "ガソリン炎" データセット[0] $i:発生間隔（フレーム） $i:その時の発生数 $i:サイズ $i:α "発生間隔が０以下で発生をストップ。αは２５５まで。" ;
mesg "ガソリン炎" 全消去[1] "出ている炎を全て殺す。" ;
mesg "ガソリン炎" ランダムシード[2] $i:シード "指定ランダムシードに初期化する。\n注意）カメラの向きを編集すると見栄えが変わる。" ;


effect "失禁" [NewNyou] <id:0x022><add_src : "ketchap00_alp.bmp">
{
	FVECTOR	*pos	{ %% = &MaxInputFVector( "位置", 1,   0.0f,0.0f,0.0f/*default*/ ) ; };
	int	life	{ %% = MaxInputInt( "寿命", 0, -1 ); };
	float 	size	{ %% = MaxInputFloat( "サイズ", 0, 2000.0f ) ; } ;
	int     col		{
	col = &MaxInputSelectColor( "色", 0,  128, 128, 128, 128 ) ;
		%% = (col->vx * 256 * 256 * 256) | (col->vy * 256 * 256) | (col->vz * 256) | (col->vw) ; };
