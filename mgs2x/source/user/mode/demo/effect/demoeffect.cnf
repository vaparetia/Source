{
	void *objs {
		link = &MaxInputGetLink( "リンク", 0 ) ;
		handle = DM_GetObjectHandle( link->vx ) ;
		%% = DM_GetObjectDgObjs( handle ) ;
	};
	void *cntrl {
		%% = DM_GetObjectControl( handle ) ;
	};
