effect "効果 リンク汎用点滅" [NewGeneralSprite2] <id:0x6011>
{
	int	name     	{ %% = MaxInputGetEffectName( "名前", 0 ); };
	int tex_code	{ %% = MaxInputStrCode( "ＴＥＸ名", 0, "", "bmp" ); };
	FMATRIX *world	{	
		link = &MaxInputGetLink( "リンク", 0 ) ;
		handle = DM_GetObjectHandle( link->vx );
		%% = DM_GetObjectMatrix( handle, link->vy );
	};
	FVECTOR *pos	{ %% = &MaxInputFVector( "位置", 1, 0.0f,0.0f,0.0f ); };
	float shift		{ %% = MaxInputSlideBarF( "カメラシフト", 0, -500, 500, 1, 0.0f ); };
	int color		{
		col = &MaxInputSelectColor("色",0,128,128,128,128);
		%% = ((col->vx)|(col->vy*256)|(col->vz*256*256));
	};
	int w { %% = MaxInputInt( "サイズ", 0, 100 ); };
	int life 		{ %% = 0; };
	int mode   { temp0 = MaxInputComboBox( "描画モード", 0, 
						"ＴＥＸ=0x0001&加算=0x0001&減算=0x0002&アルファ=0x0004", "加算" );
		temp1 = MaxInputComboBox( "フォグ", 0, 
						"有り=0x00200000&無し=0", "無し" );
		%% = temp0*256*256 | temp1;
	};
	int act_time { %% = MaxInputInt( "表示フレーム", 0, 60 ); };
	int sleep_time { %% = MaxInputInt( "非表示フレーム", 0, 30 ); };
}"";

mesg "効果 リンク汎用点滅" 表示[0] "表示";
mesg "効果 リンク汎用点滅" 非表示[1] "非表示";
mesg "効果 リンク汎用点滅" カラー変更[2] $i:Ｒ $i:Ｇ $i:Ｂ $i:時間 "カラー変更";
mesg "効果 リンク汎用点滅" 強制フェード[3] $i:Ａ $i:時間 "強制フェード";

