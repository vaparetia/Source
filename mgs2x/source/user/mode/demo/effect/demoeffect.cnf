		col = &MaxInputSelectColor( "減算色", 0,  64, 255, 255, 16 ) ;
		%% = (col->vx * 256 * 256 * 256) | (col->vy * 256 * 256) | (col->vz * 256) | (col->vw) ; };

}"PLANT22 ピーターの死体が浮いてる更に向こうの部屋が血で真っ赤になっていて、
そこから拡散していく血表現。\n
Ｚ軸をカメラ側に向けて下さい。\n
ドアの向こう側から回り込むようにしてこちら側に吹き込んできます。
";
mesg "血 水中死体遭遇" ＯＦＦ[0] "" ;
mesg "血 水中死体遭遇" ＯＮ[1] "" ;

effect "血_滴り" [NewBloodDropDemo]<id:0x700a><add_src : "drop01_msk.bmp">
{
	int name    { %% = MaxInputGetEffectName( "名前", 0 ) ; } ;
	FMATRIX *world {
