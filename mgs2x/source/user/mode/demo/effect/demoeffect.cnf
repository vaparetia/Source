effect "Ｊ・Ｗ橋の交通" [NewTraffic_Demo] <id:2001><efct_on : 0><efct_off : 1>
{
	int name    { %% = MaxInputGetEffectName( "名前", 0 ) ; } ;
	float z_crip{ %% = MaxInputFloat( "焼き付き最大距離", 0,  10000.0f/*default*/ ) ; } ;
	int max_car { %% = MaxInputInt( "車の最大数", 0,  60/*default*/ ) ; } ;
	int f_speed { %% = MaxInputSlideBarI( "端までのフレーム数", 0, 100, 200, 10,  160/*default*/ ) ; } ;
} "フレーム数は、車が表示を開始する位置から消える位置までの何フレームで移動するかを指定します。つまり車の速度を表します。１６０が最適です。" ;

mesg "Ｊ・Ｗ橋の交通" 表示[0] "車および、ライトを表示します。" ;
mesg "Ｊ・Ｗ橋の交通" 非表示[1] "車およびライトを消します。" ;
mesg "Ｊ・Ｗ橋の交通" スピード変更[2] $i:フレーム数 "車の動くスピードを変更します。\n車が端から端までのフレーム数で調整します。" ;
mesg "Ｊ・Ｗ橋の交通" 輝度変更[3] $i:輝度値 "車のライトの明るさを変更します。\n尚、０〜２５５までの値です。" ;
mesg "Ｊ・Ｗ橋の交通" 終了[4] "Ｊ・Ｗ橋の交通を終了します。" ;
mesg "Ｊ・Ｗ橋の交通" Ｘ座標シフト[5] $i:シフト値"バンダリをＸ方向にシフトします。" ;





