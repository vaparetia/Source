	.global Vu1DrawRadarMPGTag
	.global Vu1DrawRadarFunc

Vu1DrawRadarFunc:
	.word ( Vu1RadarDrawStart / 8 )		; 最初の1回
	.word ( Vu1RadarDrawNext / 8 )		; 次から
	.word ( Vu1PosDrawStart / 8 )

	.data
	.DmaPackVif 1

Vu1DrawRadarMPGTag:
	DMAref *, _draw_radar		; データ転送用タグ

	.DmaData _draw_radar
	MPG 0, *
	.vu
	.include "vuradar.vu1"	; プログラム本体
	.EndMPG
	.EndDmaData


