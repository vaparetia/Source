.macro	UNPACK_ADDR	addr
	VUMEM_ADDR		= \addr
.endm
.macro DATA_LABEL	name
	\name	= VUMEM_ADDR
.endm
.macro IVEC v0,v1,v2,v3
	.int	\v0,\v1,\v2,\v3
	VUMEM_ADDR		= VUMEM_ADDR + 1
.endm
.macro FVEC v0,v1,v2,v3
	.float	\v0,\v1,\v2,\v3
	VUMEM_ADDR		= VUMEM_ADDR + 1
.endm

; ----------------------------------------------------------------
.data
.DmaPackVif 0			; タグ中のＶＩＦコード無効

; ----------------------------------------------------------------
; 外部宣言
.global CalcPatchRayPickVu
.global CalcPatchRayPickVu_Func

; ----------------------------------------------------------------
; プログラム呼び出しＶＩＦコード一覧
CalcPatchRayPickVu_Func:
;	.word	( CalcPatchRayPick / 8 )

; ----------------------------------------------------------------
; プログラム転送ＤＭＡタグ定義
CalcPatchRayPickVu:	; マイクロプログラム読み込み用タグ記憶ポインタ
DMAret *

; ----------------------------------------------------------------
; 定数テーブル
Unpack 4, 4, V4_32, 0, *
UNPACK_ADDR	0
DATA_LABEL	MAT_HERMITE
	FVEC	 2.0, -2.0,  1.0,  1.0		; エルミート補間マトリクス係数
	FVEC	-3.0,  3.0, -2.0, -1.0		; エルミート補間マトリクス係数
	FVEC	 0.0,  0.0,  1.0,  0.0		; エルミート補間マトリクス係数
	FVEC	 1.0,  0.0,  0.0,  0.0		; エルミート補間マトリクス係数
DATA_LABEL	FV_TTBL										;( t^3, t^2, t, 1 )
	FVEC	1.0           , 1.0       , 1.0   , 1.0		; t=16/16
	FVEC	0.823974609375, 0.87890625, 0.9375, 1.0		; t=15/16
	FVEC	0.669921875   , 0.765625  , 0.875 , 1.0		; t=14/16
	FVEC	0.536376953125, 0.66015625, 0.8125, 1.0		; t=13/16
	FVEC	0.421875      , 0.5625    , 0.75  , 1.0		; t=12/16
	FVEC	0.324951171875, 0.47265625, 0.6875, 1.0		; t=11/16
	FVEC	0.244140625   , 0.390625  , 0.625 , 1.0		; t=10/16
	FVEC	0.177978515625, 0.31640625, 0.5625, 1.0		; t= 9/16
	FVEC	0.125         , 0.25      , 0.5   , 1.0		; t= 8/16
	FVEC	0.083740234375, 0.19140625, 0.4375, 1.0		; t= 7/16
	FVEC	0.052734375   , 0.140625  , 0.375 , 1.0		; t= 6/16
	FVEC	0.030517578125, 0.09765625, 0.3125, 1.0		; t= 5/16
	FVEC	0.015625      , 0.0625    , 0.25  , 1.0		; t= 4/16
	FVEC	0.006591796875, 0.03515625, 0.1875, 1.0		; t= 3/16
	FVEC	0.001953125   , 0.015625  , 0.125 , 1.0		; t= 2/16
	FVEC	0.000244140625, 0.00390625, 0.0625, 1.0		; t= 1/16
	FVEC	0.0           , 0.0       , 0.0   , 1.0		; t= 0/16
DATA_LABEL	FV_DTTBL						;( 3t^2, 2t, 1, 0 )
	FVEC	3.0       , 2.0  , 1.0, 0.0		; t=16/16
	FVEC	2.63671875, 1.875, 1.0, 0.0		; t=15/16
	FVEC	2.296875  , 1.75 , 1.0, 0.0		; t=14/16
	FVEC	1.98046875, 1.625, 1.0, 0.0		; t=13/16
	FVEC	1.6875    , 1.5  , 1.0, 0.0		; t=12/16
	FVEC	1.41796875, 1.375, 1.0, 0.0		; t=11/16
	FVEC	1.171875  , 1.25 , 1.0, 0.0		; t=10/16
	FVEC	0.94921875, 1.125, 1.0, 0.0		; t= 9/16
	FVEC	0.75      , 1    , 1.0, 0.0		; t= 8/16
	FVEC	0.57421875, 0.875, 1.0, 0.0		; t= 7/16
	FVEC	0.421875  , 0.75 , 1.0, 0.0		; t= 6/16
	FVEC	0.29296875, 0.625, 1.0, 0.0		; t= 5/16
	FVEC	0.1875    , 0.5  , 1.0, 0.0		; t= 4/16
	FVEC	0.10546875, 0.375, 1.0, 0.0		; t= 3/16
	FVEC	0.046875  , 0.25 , 1.0, 0.0		; t= 2/16
	FVEC	0.01171875, 0.125, 1.0, 0.0		; t= 1/16
	FVEC	0.0       , 0.0  , 1.0, 0.0		; t= 0/16
DATA_LABEL	WORK_MEM
.EndUnpack



; ----------------------------------------------------------------
; マイクロプログラム転送
MPG 0,*				; マイクロプログラム転送VIFcode
.include "wave5vcl.vsm"
;	nop		iaddiu	vi00,vi00,FV_TTBL
.EndMPG

; ----------------------------------------------------------------
; DMA転送データの終了
.EndDmaData

