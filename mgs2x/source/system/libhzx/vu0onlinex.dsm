	opmsub.xyz	vf30,vf22,vf18		nop
	opmula.xyz	ACC ,vf18,vf27		nop
	opmsub.xyz	vf31,vf27,vf18		nop
	mulax.w		ACC ,vf00,vf26		nop
	madday.w	ACC ,vf00,vf26		nop
	maddaz.w	ACC ,vf00,vf26		nop		; ACCw外積方向結果
	madd.w		vf00,vf00,vf00		nop		; 外積+1.0 <= 0 をチェック
	mul.xyz		vf27,vf30,vf31		nop		; vf30,vf31開放
	opmula.xyz	ACC ,vf25,vf23		nop
	opmsub.xyz	vf30,vf23,vf25		nop
	opmula.xyz	ACC ,vf25,vf28		fmand	vi12,vi11
	opmsub.xyz	vf31,vf28,vf25		ibne	vi12,vi00,FlrLoopEnd
	mulax.w		ACC ,vf00,vf27		nop
	madday.w	ACC ,vf00,vf27		nop
	maddaz.w	ACC ,vf00,vf27		nop		; ACCw外積方向結果
	madd.w		vf00,vf00,vf00		nop		; 外積+1.0 <= 0 をチェック
	mul.xyz		vf28,vf30,vf31		nop		; vf30,vf31開放
	nop								nop
	nop								nop
	nop								fmand	vi12,vi11
	mulax.w		ACC ,vf00,vf28		ibne	vi12,vi00,FlrLoopEnd
	madday.w	ACC ,vf00,vf28		nop
	maddaz.w	ACC ,vf00,vf28		nop		; ACCw外積方向結果
