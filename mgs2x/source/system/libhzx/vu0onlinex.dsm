;	addz.x  vf08, vf08, vf08		ibne	vi12, vi00, FlrLoopEnd
;	nop					nop
FloorFind :
	; 長さチェック＆バウンドチェック
	sub.x	vf00, vf10, vf08		nop
	nop								ilw.y	vi10, 0x00(vi08) ; ブロック番号ロード
	nop								iaddiu	vi12, vi00, 0x00e0 ; バウンドチェック用
	nop								iaddiu	vi11, vi00, 0x0080 ; 長さチェック用
	sub.xyz vf31, vf04, vf09		fmand	vi11, vi11
	nop								ibne	vi11, vi00, FlrLoopEnd	
	sub.xyz vf30, vf09, vf03		nop
	nop								ibltz	vi10, SaveFloor ; Ｄハザードはバウンドチェック無し
	nop								fmand	vi10, vi12
	nop								ibne	vi10, vi00, FlrLoopEnd
	nop								fmand	vi10, vi12
	nop								ibne	vi10, vi00, FlrLoopEnd
	nop								nop
SaveFloor :
	addx.x	 vf10, vf08, vf00		iaddi	vi02, vi02, 1
	addx.xyz vf07, vf09, vf00		lq.xyzw	vf30, 0x00(vi08)
	nop					sq.xyzw vf30, 0x03(vi00)
	nop					isw.x	vi03, 0x03(vi00)
	nop					isw.x	vi01, 0x0006(vi00) ; HIT_TYPE
	nop					ilw.y	vi15, 0x00(vi08)
FlrLoopEnd :
	nop					iaddiu	vi11, vi05, 3
	addx.xyzw vf12, vf13, vf00		iadd	vi04, vi04, vi11
	addx.xyzw vf13, vf14, vf00		isub	vi03, vi03, vi11
	nop					b	FlrLoop
	nop					nop
CheckFloorEnd :
	nop					isw.x	vi02, 0x0000(vi00)
	nop					sq.xyzw	vf07, 0x0001(vi00)
	nop					sq.x	vf10, 0x0002(vi00)

	nop					iaddiu	vi11, vi00, M_DATA_PTR
	nop					iaddiu	vi04, vi00, M_DATA_PTR2
	nop					ibeq	vi08, vi11, CheckFloorEndEnd
	nop					nop
	nop					iaddiu	vi04, vi00, M_DATA_PTR
CheckFloorEndEnd :
	nop[e]					nop
	nop					nop
	
	;サブルーチン
	
CheckOpOut :								
	; 外積 > -1.0F チェック
	; vf26x = -1.0F, vf31x = op
	; vi11, vi12 を使用
	; vi14 へリターン
	subx.x	vf00x, vf31x, vf26x		iaddiu	vi11, vi00, 0x0088
	nop								nop	
	nop								nop
	nop								nop
	nop								fmand	vi12, vi11
	nop								ibne	vi12, vi00, FlrLoopEnd
	nop								nop
	nop								jr		vi14
	nop								nop

.EndMPG
.EndDmaData
