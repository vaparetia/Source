;
;	t1_shdw.vu1
;	影レンダリング用描画ＶＵ１プログラム（フォグ対応）
;
;	1999/07/14 K.Takabe
;	$Id: t1_shdw.vu1,v 1.1.1.3 2002/11/19 11:42:28 Yoshizawa1 Exp $
;

;
;
;	ＶＵ１実験用オブジェクト表示マイクロプログラム
;	1999.4.*  K.Takabe
;
;	浮動小数点レジスタ使用状況
;	vf0:fix
;	vf1:定数読み込みベクトル
;	vf2:プリミティブ座標へのスケール値
;	vf3:プリミティブ座標へのオフセット
;	vf4~vf7:透視変換マトリクス
;	vf8~vf11:作業用マトリクス（ライトマトリクス等）
;	vf12:頂点読み込み
;	vf13:法線読み込み
;	vf14:ＵＶ値読み込み
;	vf15:リザーブ（頂点データ読み込み）
;	vf16~19:リザーブ（マトリクス）
;	vf20:透視変換直後座標
;	vf21:光源計算用ワーク
;	vf22~23:作業用
;	vf24~27:作業用
;	vf28:描画頂点データ
;	vf29:色データ
;	vf30:テクスチャ座標
;	vf31:リザーブ（変換後頂点データ）
;	
;	整数レジスタ使用状況
;	vi0:０固定
;	vi1:フラグ受け取り用
;	vi2:ＧＩＦキックアドレス
;	vi3:読み出し頂点処理アドレス
;	vi4:汎用
;	vi5:汎用
;	vi6:汎用
;	vi7:描画キックフラグの記憶
;	vi8:頂点数（＝ループカウンタ）
;	vi9:描画カウント（画面外に頂点があると３が代入されカウントが０になるとそのポリゴンは完全に画面内と判定できる）
;	vi10:Ｗの符号チェック用定数
;	vi11:Ｗの符号チェック結果格納用変数
;	vi12:リザーブ
;	vi13:バッファ先頭アドレス（インクリメントしてキックアドレスとして使用する）
;	vi14:スタック
;	vi15:リンクレジスタ
;	

; メモリ使用構成（ＶＵ１側から見るときには下位４ビットを無視すること）
; 0x0000~0x01ff	プログラムワーク
; 0x0200~0x03ff オブジェクトパラメータ設定（変換マトリクス等）
; 0x0400~0x21ff ダブルバッファ０
;  +0x0000_0x0eff 転送用バッファ
;  +0x0f00_0x1cff 読み込み用バッファ
; 0x2200~0x3fff ダブルバッファ１
;  +0x0000_0x0eff 転送用バッファ
;  +0x0f00_0x1cff 読み込み用バッファ
; 0x4000		最終アドレス
; 

; データフォーマット（案）
; + 0.x    頂点データ数
; + 0.y    データ開始位置（＝５）
; + 1.xyzw GIFtag（クリップポリゴン用プリミティブ設定ＧＩＦタグ）
; + 2.xyzw PRIM
; + 3.xyzw GIFtag（クリップポリゴン頂点用の転送ＧＩＦタグ）
; + 4.xyzw GIFtag（テクスチャパラメータ設定ＧＩＦタグ）
; + 5.xyzw CLAMP_1
; + 6.xyzw TEX0_1
; + 7.xyzw GIFtag（頂点の転送ＧＩＦタグ）
; + 8.xyzw 第１ＳＴＱ
; + 9.xyzw 第１ＲＧＢＡ
; +10.xyzw 第１ＸＹＺＦ
; +11.xyzw 第２ＳＴＱ
; +12.xyzw 第２ＲＧＢＡ
; .
; .
; .
; +f0.xyzw 第１ＶＵデータ
; +f1.xyzw 第１法線データ
; +f2.xyzw 第１頂点データ
; +f3.xyzw 第２ＶＵデータ
; +f4.xyzw 第１法線データ
; 
; 
; 
; 




; --------------------------------------
; 影テクスチャＵＶ値計算
; --------------------------------------
;	vf16~19:光源ビューポートマトリクス
;
CalcShadowUV:
	nop								xtop		vi13				; 
	nop								fcset		0					; クリップフラグクリア
	nop								ilw.y		vi02,0(vi13)		; 格納先オフセット読み出し
	nop								ilw.x		vi08,0(vi13)		; 頂点数読み出し
	nop								iaddiu		vi03,vi13,0xf0		; データ読み出しアドレス設定
	nop								lq.xyzw		vf31,M_COL0(vi00)	; 描画用ＲＧＢＡ値読み込み
	nop								lq.xyzw		vf15,M_COL1(vi00)	; 減衰最大距離読み込み(w)
	nop								lq.xyzw		vf12,2(vi03)		; 
	nop								lq.xyzw		vf13,1(vi03)		; 
	nop								lq.xyzw		vf16,M_SUP0(vi00)	; 
	nop								div			Q,vf00w,vf15w		; -,減衰計算
	nop								lq.xyzw		vf17,M_SUP1(vi00)	; ベースカラー
	itof0.xyz	vf12,vf12			lq.xyzw		vf18,M_SUP2(vi00)	; 
	itof12.xyz	vf21,vf13			lq.xyzw		vf19,M_SUP3(vi00)	; 
	mulx.xyzw	vf11,vf00,vf00		lq.xyzw		vf01,FV_PRM2(vi00)	; 定数読み込み
	nop								lq.xyzw		vf08,M_LIT0(vi00)	; 光源ベクトル取得
	nop								lq.xyzw		vf09,M_LIT1(vi00)	; 光源ベクトル取得
	nop								lq.xyzw		vf10,M_LIT2(vi00)	; 光源ベクトル取得
	addy.xy		vf11,vf11,vf01		iaddiu		vi04,vi00,0x4000	; x:0.5 y:0.5 設定,描画マスク用定数設定
	mulq.xyzw	vf22,vf31,Q			iadd		vi04,vi04,vi04		; 減衰計算

	mulax.xyzw	ACC ,vf16,vf12		sq.xyz		vf12,2(vi03)		; 透視変換,
	mulw.xyzw	vf28,vf28,vf29		nop								; (遅)減衰処理
	madday.xyzw	ACC ,vf17,vf12		iaddiu		vi03,vi03,3			; 透視変換,次ループ準備
	maddaz.xyzw	ACC ,vf18,vf12		mtir		vi07,vf13w			; 透視変換,-
	maddw.xyzw	vf20,vf19,vf00		lq.xyz		vf12,2(vi03)		; 透視変換,次の頂点読み出し
	mulax.xyz	ACC ,vf08,vf21		lq.xyzw		vf13,1(vi03)		; 法線回転,次の法線読み出し
	madday.xyz	ACC ,vf09,vf21		iaddi		vi08,vi08,-1		; 法線回転,
	maddz.xyz	vf29,vf10,vf21		nop								; 法線回転,(遅)カラー書き出し
	clipw.xyz	vf20,vf20			nop								; クリップチェック,(遅)ＵＶ書き出し
	sub.w		vf29,vf15,vf20		nop								; 減衰計算,
	itof0.xyz	vf12,vf12			nop								; 次ループ準備,-
	maxx.xyz	vf29,vf29,vf00		mr32.z		vf30,vf20			; xには光源方向ベクトルとの内積値,ＱにＷを格納
	itof12.xyz	vf21,vf13			fcand		vi01,0x010410		; 次ループ準備,投影範囲チェック（ニアチェックのみ）
	maxx.w		vf29,vf29,vf15		ibeq		vi01,vi00,_cs_label_0; 減衰計算,クリップ
	nop								nop								; -,値の書き戻し
	; ポリゴンの頂点がニアクリップに引っかかった場合
;	addx.w		vf29,vf15,vf00		ior			vi07,vi07,vi04		; ●描画スキップ（歪ませて強制表示にする手もある）
	nop								ior			vi07,vi07,vi04		; ●描画スキップ（歪ませて強制表示にする手もある）
_cs_label_0:
	mulx.xyzw	vf28,vf22,vf29		isw.w		vi07,0-3(vi03)		; カラー計算,フラグの書き戻し（ＵＶ値の方に）
	mulay.xy	ACC ,vf20,vf01		ibgtz		vi08,CalcShadowLoop	; ＵＶ値設定,
	maddw.xy	vf30,vf11,vf20		nop								; ＵＶ値設定,

CalcShadowLoop:
	mulax.xyzw	ACC ,vf16,vf12		sq.xyz		vf12,2(vi03)		; 透視変換,
	mulw.xyzw	vf28,vf28,vf29		nop								; (遅)減衰処理
	madday.xyzw	ACC ,vf17,vf12		iaddiu		vi03,vi03,3			; 透視変換,次ループ準備
	maddaz.xyzw	ACC ,vf18,vf12		mtir		vi07,vf13w			; 透視変換,-
	maddw.xyzw	vf20,vf19,vf00		lq.xyz		vf12,2(vi03)		; 透視変換,次の頂点読み出し
	mulax.xyz	ACC ,vf08,vf21		lq.xyzw		vf13,1(vi03)		; 法線回転,次の法線読み出し
	madday.xyz	ACC ,vf09,vf21		iaddi		vi08,vi08,-1		; 法線回転,
	maddz.xyz	vf29,vf10,vf21		sq.xyzw		vf28,1-6(vi03)		; 法線回転,(遅)カラー書き出し
	clipw.xyz	vf20,vf20			sq.xyz		vf30,0-6(vi03)		; クリップチェック,(遅)ＵＶ書き出し
	sub.w		vf29,vf15,vf20		nop								; 減衰計算,
	itof0.xyz	vf12,vf12			nop								; 次ループ準備,-
	maxx.xyz	vf29,vf29,vf00		mr32.z		vf30,vf20			; xには光源方向ベクトルとの内積値,ＱにＷを格納
	itof12.xyz	vf21,vf13			fcand		vi01,0x010410		; 次ループ準備,投影範囲チェック（ニアチェックのみ）
	maxx.w		vf29,vf29,vf15		ibeq		vi01,vi00,_cs_label_1; 減衰計算,クリップ
	nop								nop								; -,値の書き戻し
	; ポリゴンの頂点がニアクリップに引っかかった場合
;	addx.w		vf29,vf15,vf00		ior			vi07,vi07,vi04		; ●描画スキップ（歪ませて強制表示にする手もある）
	nop								ior			vi07,vi07,vi04		; ●描画スキップ（歪ませて強制表示にする手もある）
_cs_label_1:
	mulx.xyzw	vf28,vf22,vf29		isw.w		vi07,0-3(vi03)		; カラー計算,フラグの書き戻し（ＵＶ値の方に）
	mulay.xy	ACC ,vf20,vf01		ibgtz		vi08,CalcShadowLoop	; ＵＶ値設定,
	maddw.xy	vf30,vf11,vf20		nop								; ＵＶ値設定,

;後始末
	mulw.xyzw	vf28,vf28,vf29		nop								; 
	nop								sq.xyz		vf30,0-3(vi03)		; 
	nop								sq.xyzw		vf28,1-3(vi03)		; 

	nop								jr			vi15				; リターン
	nop								nop								; 


; --------------------------------------
; プリシェード用最高速透視変換ルーチン
; --------------------------------------
;	upper		.					lower		.
ShadowFastTransStart:
	; 変換初期化処理
	nop								lq.xyzw		vf07,M_PRS3(vi00)	; -,透視変換マトリクスロード
	nop								lq.xyzw		vf04,M_PRS0(vi00)	; -,透視変換マトリクスロード
	nop								lq.xyzw		vf05,M_PRS1(vi00)	; -,透視変換マトリクスロード
	nop								lq.xyzw		vf06,M_PRS2(vi00)	; -,透視変換マトリクスロード
	; 変換処理開始
ShadowFastTransNext:
	; バッファアドレス、ループ回数のセットとデータのプリロード処理
	nop								bal			vi15,CalcShadowUV	; 
	nop								nop								; 
	; バッファアドレス、ループ回数のセットとデータのプリロード処理
	nop								xtop		vi01				; 
	nop								ilw.y		vi02,0(vi01)		; 
	nop								lq.xyzw		vf12,0xf2(vi01)		; 第１頂点読み込み
	nop								lq.xyzw		vf13,0xf1(vi01)		; 第１法線（＆キック情報）読み込み
	nop								lq.xyzw		vf14,0xf0(vi01)		; 第１ＵＶ値読み込み
	nop								iaddiu		vi03,vi01,0xf3		; データ先読みアドレス設定
	nop								iadd		vi02,vi02,vi01		; データ書き戻しアドレス設定
	ftoi0.xyzw	vf29,vf13			ilw.x		vi08,0(vi01)		; 処理頂点数の読み込み
	nop								lq.xyzw		vf01,FV_PRM(vi00)	;
	nop								lq.xyzw		vf02,FV_FOG(vi00)	; 
	nop								iaddiu		vi06,vi00,0x4000	;
	nop								iadd		vi06,vi06,vi06		;
	nop								iaddiu		vi01,vi01,4			; GIFキックアドレス設定


	; ディレイ処理の為の前処理
	; 頂点変換処理（途中で次の頂点の情報を読み込んでおく）
	mulax.xyzw	ACC ,vf04,vf12		mtir		vi07,vf14w			; 透視変換,キックフラグ
	madday.xyzw	ACC ,vf05,vf12		lq.xyzw		vf13,1(vi03)		; 透視変換,次ループ準備
	minix.w		vf28,vf28,vf01		nop								; (遅)透視変換,-
	maddaz.xyzw	ACC ,vf06,vf12		nop								; 透視変換,(遅)ＳＴ座標
	maddw.xyzw	vf20,vf07,vf00		lq.xyzw		vf12,2(vi03)		; 透視変換,次ループ準備
	addx.xyzw	vf30,vf14,vf00		lq.xyzw		vf14,0(vi03)		; ＳＴ座標,次ループ準備
	add.w		vf28,vf28,vf31		sq.xyzw		vf29,1(vi02)		; (遅)透視変換,光源処理
	nop								iand		vi05,vi07,vi06		; -,キックフラグ
	mulax.w		ACC ,vf20,vf02		div			Q,vf00w,vf20w		; フォグ,透視変換
	maddy.w		vf20,vf00,vf02		mfir.w		vf31,vi05			; フォグ,キックフラグ
	ftoi4.xyzw	vf28,vf28			nop								; (遅)透視変換,
	ftoi0.xyzw	vf29,vf13			iaddiu		vi03,vi03,3			; 次ループ準備,先読みアドレスインクリメント
	nop								iaddiu		vi02,vi02,3			; -,書き込みアドレスのインクリメント
	itof4.w		vf31,vf31			isubiu		vi08,vi08,1			; フォグ＆キック,カウンタのデクリメント
	maxx.w		vf28,vf20,vf00		nop								; フォグ,(遅)透視変換
	mulq.xyz	vf28,vf20,Q			ibgtz		vi8,_ShadowFastTransLoop	; 透視変換,ループジャンプ
	mulq.xyz	vf30,vf30,Q			nop								; ＳＴ座標,-

_ShadowFastTransLoop:
	; 頂点変換処理（途中で次の頂点の情報を読み込んでおく）
	mulax.xyzw	ACC ,vf04,vf12		mtir		vi07,vf14w			; 透視変換,キックフラグ
	madday.xyzw	ACC ,vf05,vf12		lq.xyzw		vf13,1(vi03)		; 透視変換,次ループ準備
	minix.w		vf28,vf28,vf01		nop								; (遅)透視変換,-
	maddaz.xyzw	ACC ,vf06,vf12		sq.xyz		vf30,0-3(vi02)		; 透視変換,(遅)ＳＴ座標
	maddw.xyzw	vf20,vf07,vf00		lq.xyzw		vf12,2(vi03)		; 透視変換,次ループ準備
	addx.xyzw	vf30,vf14,vf00		lq.xyzw		vf14,0(vi03)		; ＳＴ座標,次ループ準備
	add.w		vf28,vf28,vf31		sq.xyzw		vf29,1(vi02)		; (遅)透視変換,光源処理
	nop								iand		vi05,vi07,vi06		; -,キックフラグ
	mulax.w		ACC ,vf20,vf02		div			Q,vf00w,vf20w		; フォグ,透視変換
	maddy.w		vf20,vf00,vf02		mfir.w		vf31,vi05			; フォグ,キックフラグ
	ftoi4.xyzw	vf28,vf28			nop								; (遅)透視変換,
	ftoi0.xyzw	vf29,vf13			iaddiu		vi03,vi03,3			; 次ループ準備,先読みアドレスインクリメント
	nop								iaddiu		vi02,vi02,3			; -,書き込みアドレスのインクリメント
	itof4.w		vf31,vf31			isubiu		vi08,vi08,1			; フォグ＆キック,カウンタのデクリメント
	maxx.w		vf28,vf20,vf00		sq.xyzw		vf28,2-6(vi02)		; フォグ,(遅)透視変換
	mulq.xyz	vf28,vf20,Q			ibgtz		vi8,_ShadowFastTransLoop	; 透視変換,ループジャンプ
	mulq.xyz	vf30,vf30,Q			nop								; ＳＴ座標,-

	; 後始末
	minix.w		vf28,vf28,vf01		nop								; 
	add.w		vf28,vf28,vf31		nop								; 
	ftoi4.xyzw	vf28,vf28			sq.xyz		vf30,0-3(vi02)		; 遅透視変換,遅ＳＴ座標
	nop								sq.xyzw		vf28,2-3(vi02)		; -,遅透視変換

	; 終端ダミーパケットをキックし待機
	nop								xgkick		vi01				; ＧＩＦへのキック
	nop[e]							b			ShadowFastTransNext			; ジャンプ＆停止
	nop								nop								; 




; --------------------------------------
; 透視変換ルーチン
; --------------------------------------
;	upper		.					lower		.
ShadowClipTransStart:
	; 変換初期化処理
	nop								lq.xyzw		vf04,M_PRS0(vi00)	; -,透視変換マトリクスロード
	nop								lq.xyzw		vf05,M_PRS1(vi00)	; -,透視変換マトリクスロード
	nop								lq.xyzw		vf06,M_PRS2(vi00)	; -,透視変換マトリクスロード
	nop								lq.xyzw		vf07,M_PRS3(vi00)	; -,透視変換マトリクスロード
	nop								lq.xyzw		vf02,FV_SCN(vi00)	; 
	nop								lq.xyzw		vf03,FV_OFT(vi00)	; 
	; 変換処理開始
ShadowClipTransNext:
	; バッファアドレス、ループ回数のセットとデータのプリロード処理
	nop								bal			vi15,CalcShadowUV	; 
	nop								nop								; 
	nop								xtop		vi13				; 
	nop								ilw.y		vi02,0(vi13)		; 
	nop								lq.xyzw		vf12,0xf2(vi13)		; 第１頂点読み込み
	nop								lq.xyzw		vf13,0xf1(vi13)		; 第１法線（＆キック情報）読み込み
	nop								lq.xyzw		vf14,0xf0(vi13)		; 第１ＵＶ値読み込み
	nop								iaddiu		vi03,vi13,0xf3		; データ先読みアドレス設定
	nop								iadd		vi02,vi02,vi13		; データ書き戻しアドレス設定
	ftoi0.xyzw	vf29,vf13			ilw.x		vi08,0(vi13)		; 処理頂点数の読み込み
	nop								iaddiu		vi13,vi13,4			; GIFキックアドレス設定
	nop								iaddiu		vi09,vi00,0			; 
	nop								iaddiu		vi10,vi00,0x0010		; 
	nop								fcset		0					; クリップチェック初期化
	nop								lq.xyzw		vf22,FV_FOG(vi00)	; フォグ係数読み込み
	nop								lq.xyzw		vf01,FV_PRM(vi00)	; 
	nop								iaddiu		vi06,vi00,0x4000	; 
	nop								iadd		vi06,vi06,vi06		; 

	; ディレイ処理の為の前処理
	mulax.xyzw	ACC ,vf04,vf12		nop								; 透視変換,キックフラグ
	madday.xyzw	ACC ,vf05,vf12		nop								; 透視変換,(遅)ＳＴ座標
	maddaz.xyzw	ACC ,vf06,vf12		sq.xyzw		vf29,1(vi02)		; 透視変換,光源処理
	add.w		vf28,vf28,vf22		sq.xyz		vf14,0-3(vi03)		; (遅)フォグ＆キック,クリップ用に保存（不必要）
	maddw.xyzw	vf20,vf07,vf00		lq.xyzw		vf12,2(vi03)		; 透視変換,次ループ準備
	nop								sq.xyzw		vf13,1-3(vi03)		; -,クリップ用に保存（不必要）
	nop								lq.xyzw		vf13,1(vi03)		; -,次ループ準備
	ftoi4.xyzw	vf28,vf28			mtir		vi07,vf14w			; (遅)透視変換,カウンタのデクリメント
	clipw.xyz	vf20,vf20			div			Q,vf00w,vf20w		; クリップチェック,透視変換
	mulax.w		ACC ,vf20,vf22		sq.xyzw		vf20,2-3(vi03)		; フォグ,クリップ用に保存
	maddy.w		vf20,vf00,vf22		isubiu		vi08,vi08,1			; フォグ,-
	ftoi0.xyzw	vf29,vf13			nop								; 次ループ準備,(遅)透視変換
	nop								fcand		vi01,0x3ffff		; -,クリップ
	nop								ibeq		vi01,vi00,label0_sps; -,クリップ
	maxx.w		vf28,vf20,vf0		nop								; フォグ,-
	; 描画するポリゴンがクリップ面に掛かっている場合
	nop								ibltz		vi07,label0_sps		; ●描画ポリゴンかどうかのチェック
	nop								iaddi		vi01,vi00,-1		; ●フラグの上位２ビットを立てる
	nop								ior			vi07,vi07,vi01		; ●
label0_sps:
	mulq.xyz	vf28,vf20,Q			iand		vi05,vi06,vi07		; 透視変換,キックフラグ(=waitq)
	mulq.xyz	vf30,vf14,Q			mfir.w		vf22,vi05			; ＳＴ座標,キックフラグ
	nop								lq.xyzw		vf14,0(vi03)		; -,次ループ準備
	minix.w		vf28,vf28,vf01		isw.w		vi07,0-3(vi03)		; フォグクリップ用に保存
	mula.xyz	ACC ,vf28,vf02		iaddiu		vi03,vi03,3			; 透視変換,先読みアドレスインクリメント
	maddw.xyz	vf28,vf03,vf00		ibgtz		vi08,_ShadowClipTransLoop; 透視変換,ループジャンプ
	itof4.w		vf22,vf22			iaddiu		vi02,vi02,3			; キックフラグ,書き込みアドレスのインクリメント

_ShadowClipTransLoop:
	; 頂点変換処理（途中で次の頂点の情報を読み込んでおく）
	mulax.xyzw	ACC ,vf04,vf12		nop								; 透視変換,キックフラグ
	madday.xyzw	ACC ,vf05,vf12		sq.xyz		vf30,0-3(vi02)		; 透視変換,(遅)ＳＴ座標
	maddaz.xyzw	ACC ,vf06,vf12		sq.xyzw		vf29,1(vi02)		; 透視変換,光源処理
	add.w		vf28,vf28,vf22		sq.xyz		vf14,0-3(vi03)		; (遅)フォグ＆キック,クリップ用に保存（不必要）
	maddw.xyzw	vf20,vf07,vf00		lq.xyzw		vf12,2(vi03)		; 透視変換,次ループ準備
	nop								sq.xyzw		vf13,1-3(vi03)		; -,クリップ用に保存（不必要）
	nop								lq.xyzw		vf13,1(vi03)		; -,次ループ準備
	ftoi4.xyzw	vf28,vf28			mtir		vi07,vf14w			; (遅)透視変換,カウンタのデクリメント
	clipw.xyz	vf20,vf20			div			Q,vf00w,vf20w		; クリップチェック,透視変換
	mulax.w		ACC ,vf20,vf22		sq.xyzw		vf20,2-3(vi03)		; フォグ,クリップ用に保存
	maddy.w		vf20,vf00,vf22		isubiu		vi08,vi08,1			; フォグ,-
	ftoi0.xyzw	vf29,vf13			sq.xyzw		vf28,2-3(vi02)		; 次ループ準備,(遅)透視変換
	nop								fcand		vi01,0x3ffff		; -,クリップ
	nop								ibeq		vi01,vi00,label2_sps; -,クリップ
	maxx.w		vf28,vf20,vf0		nop								; フォグ,-
	; 描画するポリゴンがクリップ面に掛かっている場合
	nop								ibltz		vi07,label2_sps		; ●描画ポリゴンかどうかのチェック
	nop								iaddi		vi01,vi00,-1		; ●フラグの上位２ビットを立てる
	nop								ior			vi07,vi07,vi01		; ●
label2_sps:
	mulq.xyz	vf28,vf20,Q			iand		vi05,vi06,vi07		; 透視変換,キックフラグ(=waitq)
	mulq.xyz	vf30,vf14,Q			mfir.w		vf22,vi05			; ＳＴ座標,キックフラグ
	nop								lq.xyzw		vf14,0(vi03)		; -,次ループ準備
	minix.w		vf28,vf28,vf01		isw.w		vi07,0-3(vi03)		; フォグクリップ用に保存
	mula.xyz	ACC ,vf28,vf02		iaddiu		vi03,vi03,3			; 透視変換,先読みアドレスインクリメント
	maddw.xyz	vf28,vf03,vf00		ibgtz		vi08,_ShadowClipTransLoop; 透視変換,ループジャンプ
	itof4.w		vf22,vf22			iaddiu		vi02,vi02,3			; キックフラグ,書き込みアドレスのインクリメント

	; 後始末
	add.w		vf28,vf28,vf22		nop								; 
	ftoi4.xyzw	vf28,vf28			sq.xyz		vf30,0-3(vi2)		; (遅)透視変換,(遅)ＳＴ座標
	nop								sq.xyzw		vf28,2-3(vi2)		; 光源処理,遅透視変換

	; 終端ダミーパケットをキックし待機
	nop								xgkick		vi13				; ＧＩＦへのキック
	nop								b			_ClipStartFog			; 
	nop								nop								; 







; --------------------------------------
; 最高速光源計算付き透視変換ルーチン
; --------------------------------------
;	upper		.					lower		.
FastTransStart:
	; 変換初期化処理
	nop								lq.xyzw		vf7,M_PRS3(vi0)		; -,透視変換マトリクスロード
	nop								lq.xyzw		vf4,M_PRS0(vi0)		; -,透視変換マトリクスロード
	nop								lq.xyzw		vf5,M_PRS1(vi0)		; -,透視変換マトリクスロード
	nop								lq.xyzw		vf6,M_PRS2(vi0)		; -,透視変換マトリクスロード
	nop								lq.xyzw		vf2,FV_SCN(vi0)		; 
	nop								lq.xyzw		vf3,FV_OFT(vi0)		; 
	nop								lq.xyzw		vf1,FV_PRM(vi0)		; 
	nop								lq.xyzw		vf16,M_SUP0(vi0)	; エンベロープ補正マトリクス読み込み
	nop								lq.xyzw		vf17,M_SUP1(vi0)	; エンベロープ補正マトリクス読み込み
	nop								lq.xyzw		vf18,M_SUP2(vi0)	; エンベロープ補正マトリクス読み込み
	nop								lq.xyzw		vf19,M_SUP3(vi0)	; エンベロープ補正マトリクス読み込み
	nop								lq.xyzw		vf8,M_LIT0(vi0)		; ローカルライトマトリクス読み込み
	nop								lq.xyzw		vf9,M_LIT1(vi0)		; ローカルライトマトリクス読み込み
	nop								lq.xyzw		vf10,M_LIT2(vi0)	; ローカルライトマトリクス読み込み
	nop								lq.xyzw		vf24,M_COL0(vi0)	; ローカルカラーマトリクス読み込み
	nop								lq.xyzw		vf25,M_COL1(vi0)	; ローカルカラーマトリクス読み込み
	nop								lq.xyzw		vf26,M_COL2(vi0)	; ローカルカラーマトリクス読み込み
	nop								lq.xyzw		vf27,M_COL3(vi0)	; ローカルカラーマトリクス読み込み
	; 変換処理開始
FastTransNext:
	; バッファアドレス、ループ回数のセットとデータのプリロード処理
	nop								xtop		vi01				; 
	nop								ilw.y		vi02,0(vi01)		; 
	nop								lq.xyzw		vf12,0xf2(vi01)		; 第１頂点読み込み
	nop								lq.xyzw		vf13,0xf1(vi01)		; 第１法線（＆キック情報）読み込み
	nop								lq.xyzw		vf14,0xf0(vi01)		; 第１ＵＶ値読み込み
	nop								lq.xyzw		vf01,FV_PRM(vi00)	;
	nop								iaddiu		vi03,vi01,0xf3		; データ先読みアドレス設定
	itof0.xyzw	vf12,vf12			iadd		vi02,vi02,vi01		; データ書き戻しアドレス設定
	nop								ilw.x		vi08,0(vi01)		; 処理頂点数の読み込み
	itof12.xyz	vf13,vf13			iaddiu		vi01,vi01,4			; GIFキックアドレス設定
	muly.w		vf29,vf00,vf01		ilw.x		vi06,FV_DAT(vi00)	; アルファ設定,
	ftoi0.w		vf29,vf29			nop								; アルファ設定,

	; ディレイ処理の為の前処理
	mulax.xyzw	ACC,vf4,vf12		nop								; 透視変換,-
	madday.xyzw	ACC,vf5,vf12		nop								; 透視変換,-
	maddaz.xyzw	ACC,vf6,vf12		nop								; 透視変換,-
	maddw.xyzw	vf20,vf7,vf0		lq.xyzw		vf12,2(vi3)			; 透視変換,次ループ準備
	minix.xyz	vf29,vf21,vf1		mtir		vi7,vf13w			; 遅光源処理,描画キック
	mulax.xyzw	ACC,vf8,vf13		nop								; 光源処理,
	madday.xyzw	ACC,vf9,vf13		nop								; 光源処理,
	maddz.xyzw	vf21,vf10,vf13		div			Q,vf0w,vf20w		; 光源処理,透視変換
	ftoi4.xyz	vf28,vf28			iaddiu		vi3,vi3,3			; 遅透視変換,先読みアドレスインクリメント
	itof0.xyzw	vf12,vf12			lq.xyzw		vf13,1-3(vi3)		; 次ループ準備,次ループ準備
	itof12.xyz	vf14,vf14			iand		vi7,vi7,vi6			; 次ループ準備,フォグ処理
	maxx.xyzw	vf21,vf21,vf0		isw.w		vi7,2(vi2)			; 光源処理,描画キック
	ftoi0.xyz	vf29,vf29			isubiu		vi8,vi8,1			; 遅光源処理,カウンタのデクリメント
	itof12.xyz	vf13,vf13			iaddiu		vi2,vi2,3			; 次ループ準備,書き込みアドレスのインクリメント
	mulq.xyzw	vf28,vf20,Q			nop								; 透視変換,遅透視変換
	mulax.xyz	ACC,vf24,vf21		nop								; 光源処理,遅ＳＴ座標
	madday.xyz	ACC,vf25,vf21		nop								; 光源処理,遅光源処理
	maddaz.xyz	ACC,vf26,vf21		nop								; 光源処理,
	maddw.xyz	vf21,vf27,vf0		ibgtz		vi8,_FastTransLoop	; 光源処理,ループジャンプ
	mulq.xyz	vf30,vf14,Q			lq.xyzw		vf14,0-3(vi3)		; ＳＴ座標,次ループ準備

_FastTransLoop:
	; 頂点変換処理（途中で次の頂点の情報を読み込んでおく）
	mulax.xyzw	ACC,vf4,vf12		nop								; 透視変換,-
	madday.xyzw	ACC,vf5,vf12		nop								; 透視変換,-
	maddaz.xyzw	ACC,vf6,vf12		nop								; 透視変換,-
	maddw.xyzw	vf20,vf7,vf0		lq.xyzw		vf12,2(vi3)			; 透視変換,次ループ準備
	minix.xyz	vf29,vf21,vf1		mtir		vi7,vf13w			; 遅光源処理,描画キック
	mulax.xyzw	ACC,vf8,vf13		nop								; 光源処理,
	madday.xyzw	ACC,vf9,vf13		nop								; 光源処理,
	maddz.xyzw	vf21,vf10,vf13		div			Q,vf0w,vf20w		; 光源処理,透視変換
	ftoi4.xyz	vf28,vf28			iaddiu		vi3,vi3,3			; 遅透視変換,先読みアドレスインクリメント
	itof0.xyzw	vf12,vf12			lq.xyzw		vf13,1-3(vi3)		; 次ループ準備,次ループ準備
	itof12.xyz	vf14,vf14			iand		vi7,vi7,vi6			; 次ループ準備,フォグ処理
	maxx.xyzw	vf21,vf21,vf0		isw.w		vi7,2(vi2)			; 光源処理,描画キック
	ftoi0.xyz	vf29,vf29			iaddi		vi8,vi8,-1			; 遅光源処理,カウンタのデクリメント
	itof12.xyz	vf13,vf13			iaddiu		vi2,vi2,3			; 次ループ準備,書き込みアドレスのインクリメント
	mulq.xyzw	vf28,vf20,Q			sq.xyz		vf28,2-6(vi2)		; 透視変換,遅透視変換
	mulax.xyz	ACC,vf24,vf21		sq.xyz		vf30,0-6(vi2)		; 光源処理,遅ＳＴ座標
	madday.xyz	ACC,vf25,vf21		sq.xyzw		vf29,1-6(vi2)		; 光源処理,遅光源処理
	maddaz.xyz	ACC,vf26,vf21		nop								; 光源処理,
	maddw.xyz	vf21,vf27,vf0		ibgtz		vi8,_FastTransLoop	; 光源処理,ループジャンプ
	mulq.xyz	vf30,vf14,Q			lq.xyzw		vf14,0-3(vi3)		; ＳＴ座標,次ループ準備
	; 後始末
	minix.xyz	vf29,vf21,vf1		nop
	ftoi4.xyz	vf28,vf28			nop
	ftoi0.xyz	vf29,vf29			sq.xyz		vf30,0-3(vi2)		; 遅光源処理,-
	nop								sq.xyz		vf28,2-3(vi2)		; 光源処理,遅透視変換
	nop								sq.xyzw		vf29,1-3(vi2)		; 光源処理,遅光源処理

	; 終端ダミーパケットをキックし待機
	nop								nop								; 
	nop								xgkick		vi1					; ＧＩＦへのキック
;	nop[e]							b			FastTransNext		; ジャンプ＆停止
	nop[e]							nop								; ジャンプ＆停止
	nop								nop								; 


; --------------------------------------
; エンベロープ対応ルーチン
; --------------------------------------
;	upper		.					lower		.
FastTransEnvelopeStart:
	; 変換初期化処理
	nop								lq.xyzw		vf7,M_PRS3(vi0)		; -,透視変換マトリクスロード
	nop								lq.xyzw		vf4,M_PRS0(vi0)		; -,透視変換マトリクスロード
	nop								lq.xyzw		vf5,M_PRS1(vi0)		; -,透視変換マトリクスロード
	nop								lq.xyzw		vf6,M_PRS2(vi0)		; -,透視変換マトリクスロード
	nop								lq.xyzw		vf2,FV_SCN(vi0)		; 
	nop								lq.xyzw		vf3,FV_OFT(vi0)		; 
	nop								lq.xyzw		vf1,FV_PRM(vi0)		; 
	nop								lq.xyzw		vf16,M_SUP0(vi0)	; エンベロープ補正マトリクス読み込み
	nop								lq.xyzw		vf17,M_SUP1(vi0)	; エンベロープ補正マトリクス読み込み
	nop								lq.xyzw		vf18,M_SUP2(vi0)	; エンベロープ補正マトリクス読み込み
	nop								lq.xyzw		vf19,M_SUP3(vi0)	; エンベロープ補正マトリクス読み込み
	nop								lq.xyzw		vf8,M_LIT0(vi0)		; ローカルライトマトリクス読み込み
	nop								lq.xyzw		vf9,M_LIT1(vi0)		; ローカルライトマトリクス読み込み
	nop								lq.xyzw		vf10,M_LIT2(vi0)	; ローカルライトマトリクス読み込み
	nop								lq.xyzw		vf24,M_COL0(vi0)	; ローカルカラーマトリクス読み込み
	nop								lq.xyzw		vf25,M_COL1(vi0)	; ローカルカラーマトリクス読み込み
	nop								lq.xyzw		vf26,M_COL2(vi0)	; ローカルカラーマトリクス読み込み
	nop								lq.xyzw		vf27,M_COL3(vi0)	; ローカルカラーマトリクス読み込み
	; 変換処理開始
FastTransEnvelopeNext:
	; バッファアドレス、ループ回数のセットとデータのプリロード処理
	nop								xtop		vi01				; 
	nop								ilw.y		vi02,0(vi01)		; 
	nop								lq.xyzw		vf12,0xf2(vi01)		; 第１頂点読み込み
	nop								lq.xyzw		vf13,0xf1(vi01)		; 第１法線（＆キック情報）読み込み
	nop								lq.xyzw		vf14,0xf0(vi01)		; 第１ＵＶ値読み込み
	nop								lq.xyzw		vf01,FV_PRM(vi00)	;
	nop								iaddiu		vi03,vi01,0xf3		; データ先読みアドレス設定
	itof0.xyz	vf12,vf12			iadd		vi02,vi02,vi01		; データ書き戻しアドレス設定
	itof12.w	vf31,vf12			ilw.x		vi08,0(vi1)			; 処理頂点数の読み込み
	itof12.xyz	vf13,vf13			iaddiu		vi01,vi01,4			; GIFキックアドレス設定
	muly.w		vf29,vf00,vf01		ilw.x		vi06,FV_DAT(vi00)	; アルファ設定
	ftoi0.w		vf29,vf29			nop								; アルファ設定,

	; ディレイ処理の為の前処理
	mulax.xyzw	ACC,vf16,vf12		nop								; trans_v,-
	madday.xyzw	ACC,vf17,vf12		nop								; trans_v,-
	maddaz.xyzw	ACC,vf18,vf12		nop								; trans_v,make v
	maddw.xyzw	vf22,vf19,vf0		nop								; trans_v,-
	sub.w		vf22,vf0,vf31		nop								; make v&n,-
	mulax.xyz	ACC,vf16,vf13		nop								; trans_n,-
	madday.xyz	ACC,vf17,vf13		nop								; trans_n,-
	maddz.xyz	vf23,vf18,vf13		nop								; trans_n,-
	mulaw.xyz	ACC,vf12,vf31		nop								; make v,-
	maddw.xyz	vf12,vf22,vf22		nop								; make v,-
	mulaw.xyz	ACC,vf13,vf31		nop								; make n,-
	maddw.xyz	vf13,vf23,vf22		nop								; make n,-

	itof12.xyz	vf14,vf14			nop								; ＳＴ座標,-
	mulax.xyzw	ACC,vf4,vf12		nop								; 透視変換,-
	madday.xyzw	ACC,vf5,vf12		nop								; 透視変換,-
	maddaz.xyzw	ACC,vf6,vf12		nop								; 透視変換,-
	maddw.xyzw	vf20,vf7,vf0		lq.xyzw		vf12,2(vi3)			; 透視変換,次ループ準備
	minix.xyz	vf29,vf21,vf1		mtir		vi7,vf13w			; 遅光源処理,描画キック
	mulax.xyzw	ACC,vf8,vf13		nop								; 光源処理,
	madday.xyzw	ACC,vf9,vf13		nop								; 光源処理,
	maddz.xyzw	vf21,vf10,vf13		div			Q,vf0w,vf20w		; 光源処理,透視変換
	ftoi4.xyz	vf28,vf28			iaddiu		vi3,vi3,3			; 遅透視変換,先読みアドレスインクリメント
	itof0.xyz	vf12,vf12			lq.xyzw		vf13,1-3(vi3)		; 次ループ準備,次ループ準備
	itof12.w	vf31,vf12			iand		vi7,vi7,vi6			; 次ループ準備,フォグ処理
	maxx.xyzw	vf21,vf21,vf0		isw.w		vi7,2(vi2)			; 光源処理,描画キック
	ftoi0.xyz	vf29,vf29			isubiu		vi8,vi8,1			; 遅光源処理,カウンタのデクリメント
	itof12.xyz	vf13,vf13			iaddiu		vi2,vi2,3			; 次ループ準備,書き込みアドレスのインクリメント
	mulq.xyzw	vf28,vf20,Q			nop								; 透視変換,遅透視変換
	mulax.xyz	ACC,vf24,vf21		nop								; 光源処理,遅ＳＴ座標
	madday.xyz	ACC,vf25,vf21		nop								; 光源処理,遅光源処理
	maddaz.xyz	ACC,vf26,vf21		nop								; 光源処理,-
	maddw.xyz	vf21,vf27,vf0		ibgtz		vi8,_FastTransEnvelopeLoop	; 光源処理,ループジャンプ
	mulq.xyz	vf30,vf14,Q			lq.xyzw		vf14,0-3(vi3)		; ＳＴ座標,次ループ準備

_FastTransEnvelopeLoop:
	; 頂点変換処理（途中で次の頂点の情報を読み込んでおく）
	mulax.xyzw	ACC,vf16,vf12		nop								; trans_v,-
	madday.xyzw	ACC,vf17,vf12		nop								; trans_v,-
	maddaz.xyzw	ACC,vf18,vf12		nop								; trans_v,make v
	maddw.xyzw	vf22,vf19,vf0		nop								; trans_v,-
	sub.w		vf22,vf0,vf31		nop								; make v&n,-
	mulax.xyz	ACC,vf16,vf13		nop								; trans_n,-
	madday.xyz	ACC,vf17,vf13		nop								; trans_n,-
	maddz.xyz	vf23,vf18,vf13		nop								; trans_n,-
	mulaw.xyz	ACC,vf12,vf31		nop								; make v,-
	maddw.xyz	vf12,vf22,vf22		nop								; make v,-
	mulaw.xyz	ACC,vf13,vf31		nop								; make n,-
	maddw.xyz	vf13,vf23,vf22		nop								; make n,-

	; 頂点変換処理（途中で次の頂点の情報を読み込んでおく）
	itof12.xyz	vf14,vf14			nop								; ＳＴ座標,-
	mulax.xyzw	ACC,vf4,vf12		nop								; 透視変換,-
	madday.xyzw	ACC,vf5,vf12		nop								; 透視変換,-
	maddaz.xyzw	ACC,vf6,vf12		nop								; 透視変換,-
	maddw.xyzw	vf20,vf7,vf0		lq.xyzw		vf12,2(vi3)			; 透視変換,次ループ準備
	minix.xyz	vf29,vf21,vf1		mtir		vi7,vf13w			; 遅光源処理,描画キック
	mulax.xyzw	ACC,vf8,vf13		nop								; 光源処理,
	madday.xyzw	ACC,vf9,vf13		nop								; 光源処理,
	maddz.xyzw	vf21,vf10,vf13		div			Q,vf0w,vf20w		; 光源処理,透視変換
	ftoi4.xyz	vf28,vf28			iaddiu		vi3,vi3,3			; 遅透視変換,先読みアドレスインクリメント
	itof0.xyz	vf12,vf12			lq.xyzw		vf13,1-3(vi3)		; 次ループ準備,次ループ準備
	itof12.w	vf31,vf12			iand		vi7,vi7,vi6			; 次ループ準備,フォグ処理
	maxx.xyzw	vf21,vf21,vf0		isw.w		vi7,2(vi2)			; 光源処理,描画キック
	ftoi0.xyz	vf29,vf29			isubiu		vi8,vi8,1			; 遅光源処理,カウンタのデクリメント
	itof12.xyz	vf13,vf13			iaddiu		vi2,vi2,3			; 次ループ準備,書き込みアドレスのインクリメント
	mulq.xyzw	vf28,vf20,Q			sq.xyz		vf28,2-6(vi2)		; 透視変換,遅透視変換
	mulax.xyz	ACC,vf24,vf21		sq.xyz		vf30,0-6(vi2)		; 光源処理,遅ＳＴ座標
	madday.xyz	ACC,vf25,vf21		sq.xyzw		vf29,1-6(vi2)		; 光源処理,遅光源処理
	maddaz.xyz	ACC,vf26,vf21		nop								; 光源処理,-
	maddw.xyz	vf21,vf27,vf0		ibgtz		vi8,_FastTransEnvelopeLoop	; 光源処理,ループジャンプ
	mulq.xyz	vf30,vf14,Q			lq.xyzw		vf14,0-3(vi3)		; ＳＴ座標,次ループ準備

	; 後始末
	minix.xyz	vf29,vf21,vf1		nop
	ftoi4.xyz	vf28,vf28			nop
	ftoi0.xyz	vf29,vf29			sq.xyz		vf30,0-3(vi2)		; 遅光源処理,-
	nop								sq.xyz		vf28,2-3(vi2)		; 光源処理,遅透視変換
	nop								sq.xyzw		vf29,1-3(vi2)		; 光源処理,遅光源処理

	; 終端ダミーパケットをキックし待機
	nop								xgkick		vi1					; ＧＩＦへのキック
	nop[e]							b			FastTransNext			; ジャンプ＆停止
	nop								nop								; 

FastPreshadeTransStart:
FastPreshadeTransNext: