	madday.xyz	ACC ,vf05,vf18		nop											; 光源計算,-
	maddz.xyz	vf14,vf06,vf18		move.xyzw	vf15,vf17						; 光源計算,ＵＶ待避

loop_s0:
	clipw.xyz	vf13,vf13			div			Q,vf00w,vf13w					; クリップチェック,Ｗ除算
	subz.w		vf01,vf00,vf02		lq.xyzw		vf09,SRC_VERT+SRC_NEXT(vi04)	; (先)t-1生成,計算済みデータ用
	mulax.xyzw	ACC ,vf20,vf03		iaddiu		vi05,vi05,DST_NEXT*2			; (先)Ｓ傾き生成,計算済みデータ用
	madday.xyzw	ACC ,vf21,vf03		iaddiu		vi07,vi00,0x0000				; (先)Ｓ傾き生成,フラグクリア
	maddaz.xyzw	ACC ,vf22,vf03		fcand		vi01,0x3ffff					; (先)Ｓ傾き生成,クリップチェック
	maxx.xyz	vf14,vf14,vf00		lq.xyzw		vf28,DST_XYZ-DST_NEXT(vi05)		; 光源計算,計算済みデータ用
	maddw.xyzw	vf18,vf23,vf03		lq.xyzw		vf29,DST_COL-DST_NEXT(vi05)		; (先)Ｓ傾き生成,計算済みデータ用
	mulaw.xyzw	ACC ,vf24,vf01		lq.xyzw		vf30,DST_UV0-DST_NEXT(vi05)		; (先)Ｔ傾き生成,計算済みデータ用
	maddz.xyzw	vf19,vf25,vf02		ilw.w		vi08,DST_XYZ-DST_NEXT(vi05)		; (先)Ｔ傾き生成,計算済みデータ用
	mulax.xyzw	ACC ,vf20,vf02		lq.xyz		vf01,FV_FOG(vi00)				; (先)頂点生成,フォグパラメータ
