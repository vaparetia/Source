	mula.xyz	ACC ,vf10,vf02		iaddiu		vi04,vi04,SRC_NEXT*2			; 透視変換,アドレス増加（２頂点分）
	maddw.xyz	vf10,vf03,vf00		sq.xyzw		vf28,DST_XYZ-DST_NEXT*2(vi03)	; 透視変換,計算済みデータ用
	addx.w		vf10,vf31,vf31		sq.xyzw		vf29,DST_COL-DST_NEXT*2(vi03)	; キック＆フォグ,計算済みデータ用
	minii.xyz	vf14,vf14,I			sq.xyzw		vf30,DST_UV0-DST_NEXT*2(vi03)	; 光源計算,計算済みデータ用
	mulq.xyz	vf12,vf15,Q			isw.w		vi08,SRC_UV0-SRC_NEXT*2(vi04)	; ＳＴ補正,計算済みデータ用
.ifndef alpha_vertex
;	nop								nop											; ,
.else
	addx.w		vf14,vf15,vf00		nop											; ,
.endif
;	nop								nop											; ,
;	nop								nop											; ,
	ftoi4.xyzw	vf10,vf10			isw.w		vi08,DST_XYZ-DST_NEXT*2(vi03)	; 透視変換,計算済みデータ用
	ftoi0.xyzw	vf11,vf14			sq.xyzw		vf14,SRC_COL-SRC_NEXT(vi04)		; 光源計算,クリップ用保存
;	nop								nop											; -,
	nop								sq.xyzw		vf12,DST_UV0-DST_NEXT(vi03)		; -,ＵＶ書き込み
	nop								sq.xyzw		vf10,DST_XYZ-DST_NEXT(vi03)		; ,座標書き込み
	nop								sq.xyzw		vf11,DST_COL-DST_NEXT(vi03)		; ,カラー書き込み

	nop								b			chech_lower						; 
	nop								nop											; 

	; エッジ接続フラグのチェック
	; （補足）エッジ接続は隣接する計算済み頂点をコピーする事で見た目の頂点数を１レベル分下げることで実現
chech_lower:
	nop								ibeq		vi12,vi00,draw_strip			; フラグクイックチェック
	nop								ilw.x		vi03,BUFF_ADDR(vi00)			; -,パケットアドレス設定
lower_s0:
	nop								ibeq		vi09,vi00,lower_s1_end			; 奇数偶数ラインチェック
	nop								iaddiu		vi04,vi00,CLIP_DATA				; -,データ待避アドレス設定
	nop								iaddiu		vi01,vi00,0x0001				; Ｓ＝０上のエッジについてチェック
	nop								iand		vi01,vi01,vi12					; 
	nop								iaddiu		vi03,vi03,0x0001				; 頂点データの先頭になるように補正
	nop								ibeq		vi01,vi00,lower_s0_end			; エッジフラグチェック
	nop								iaddiu		vi02,vi00,0x0fff				; マスク生成
	nop								iaddiu		vi01,vi00,0x4000				; マスク生成
	nop								iaddiu		vi01,vi01,0x4000				; マスク生成
	nop								ilw.w		vi07,DST_XYZ(vi03)				; フラグ読み込み
	nop								lq.xyzw		vf28,DST_XYZ(vi03)				; 頂点読み込み
	nop								lq.xyzw		vf29,DST_COL(vi03)				; カラー読み込み
	nop								lq.xyzw		vf30,DST_UV0(vi03)				; ＵＶ読み込み
	nop								lq.xyzw		vf04,SRC_VERT(vi04)				; 待避頂点読み込み
	nop								lq.xyzw		vf05,SRC_COL(vi04)				; 待避カラー読み込み
	nop								lq.xyzw		vf06,SRC_UV0(vi04)				; 待避ＵＶ読み込み
	nop								iand		vi07,vi07,vi02					; キックフラグ細工
	nop								ior			vi07,vi07,vi01					; キックフラグ細工
	nop								isw.w		vi07,DST_XYZ+DST_NEXT(vi03)		; キックフラグ書き込み
	nop								sq.xyz		vf28,DST_XYZ+DST_NEXT(vi03)		; 頂点書き込み
	nop								sq.xyzw		vf29,DST_COL+DST_NEXT(vi03)		; カラー書き込み
	nop								sq.xyzw		vf30,DST_UV0+DST_NEXT(vi03)		; ＵＶ書き込み
	nop								isw.w		vi07,SRC_UV0+SRC_NEXT(vi04)		; 待避キックフラグ書き込み
	nop								sq.xyzw		vf04,SRC_VERT+SRC_NEXT(vi04)	; 待避頂点書き込み
	nop								sq.xyzw		vf05,SRC_COL+SRC_NEXT(vi04)		; 待避カラー書き込み
	nop								sq.xyz		vf06,SRC_UV0+SRC_NEXT(vi04)		; 待避ＵＶ書き込み
lower_s0_end:

lower_s1:
	nop								ilw.x		vi05,PACKDAT(vi13)				; 
	nop								iaddiu		vi01,vi00,0x0002				; Ｓ＝１上のエッジについてチェック
	nop								iand		vi01,vi01,vi12					; 
	nop								iadd		vi08,vi05,vi05					; vi08 = vi05 * 2
	nop								iadd		vi05,vi08,vi05					; vi05 = vi05 * 3
	nop								ibeq		vi01,vi00,lower_s1_end			; 
	nop								iadd		vi08,vi04,vi05					; -,データ待避アドレス設定
	nop								iadd		vi05,vi03,vi05					; -,パケットアドレス設定
	nop								ilw.w		vi07,DST_XYZ-DST_NEXT*2(vi05)	; フラグ読み込み
	nop								lq.xyzw		vf28,DST_XYZ-DST_NEXT*2(vi05)	; 頂点読み込み
	nop								lq.xyzw		vf29,DST_COL-DST_NEXT*2(vi05)	; カラー読み込み
	nop								lq.xyzw		vf30,DST_UV0-DST_NEXT*2(vi05)	; ＵＶ読み込み
	nop								lq.xyzw		vf04,SRC_VERT-SRC_NEXT*2(vi08)	; 待避頂点読み込み
	nop								lq.xyzw		vf05,SRC_COL-SRC_NEXT*2(vi08)	; 待避カラー読み込み
	nop								lq.xyzw		vf06,SRC_UV0-SRC_NEXT*2(vi08)	; 待避ＵＶ読み込み
	nop								iaddiu		vi02,vi00,0x0fff				; マスク生成
	nop								iaddiu		vi01,vi00,0x4000				; マスク生成
	nop								iaddiu		vi01,vi01,0x4000				; マスク生成
	nop								iand		vi07,vi07,vi02					; キックフラグ細工
	nop								ior			vi07,vi07,vi01					; キックフラグ細工
	nop								isw.w		vi07,DST_XYZ-DST_NEXT(vi05)		; キックフラグ書き込み
	nop								sq.xyz		vf28,DST_XYZ-DST_NEXT(vi05)		; 頂点書き込み
	nop								sq.xyzw		vf29,DST_COL-DST_NEXT(vi05)		; カラー書き込み
	nop								sq.xyzw		vf30,DST_UV0-DST_NEXT(vi05)		; ＵＶ書き込み
	nop								isw.w		vi07,SRC_UV0-SRC_NEXT(vi08)		; 待避キックフラグ書き込み
	nop								sq.xyzw		vf04,SRC_VERT-SRC_NEXT(vi08)	; 待避頂点書き込み
	nop								sq.xyzw		vf05,SRC_COL-SRC_NEXT(vi08)		; 待避カラー書き込み
	nop								sq.xyz		vf06,SRC_UV0-SRC_NEXT(vi08)		; 待避ＵＶ書き込み
lower_s1_end:

lower_t0:
	nop								ilw.x		vi03,BUFF_ADDR(vi00)			; -,パケットアドレス設定
	nop								iaddiu		vi01,vi00,16					; 
	nop								iaddiu		vi04,vi00,CLIP_DATA				; -,データ待避アドレス設定
	nop								iaddiu		vi03,vi03,0x0001				; 頂点データの先頭になるように補正
	nop								ibne		vi11,vi01,lower_t0_end			; 
	nop								iaddiu		vi01,vi00,0x0004				; Ｔ＝０上のエッジについてチェック
	nop								iand		vi01,vi01,vi12					; 
	nop								iaddiu		vi05,vi03,0x0000				; 
	nop								ibeq		vi01,vi00,lower_t0_end			; 
	nop								iaddiu		vi08,vi04,0x0000				; 
	nop								iaddiu		vi10,vi00,16					; 
lower_t0_loop:
	nop								isub		vi10,vi10,vi14					; 
	nop								isub		vi10,vi10,vi14					; 
	nop								lq.xyzw		vf04,SRC_VERT(vi08)				; 
	nop								lq.xyzw		vf05,SRC_COL(vi08)				; 
	nop								lq.xyzw		vf06,SRC_UV0(vi08)				; 
	nop								lq.xyzw		vf07,DST_XYZ(vi05)				; 
	nop								lq.xyzw		vf08,DST_COL(vi05)				; 
	nop								lq.xyzw		vf09,DST_UV0(vi05)				; 
	nop								sq.xyzw		vf04,SRC_VERT+SRC_NEXT*2(vi08)	; 
	nop								sq.xyzw		vf05,SRC_COL+SRC_NEXT*2(vi08)	; 
	nop								sq.xyzw		vf06,SRC_UV0+SRC_NEXT*2(vi08)	; 
	nop								sq.xyzw		vf07,DST_XYZ+DST_NEXT*2(vi05)	; 
	nop								sq.xyzw		vf08,DST_COL+DST_NEXT*2(vi05)	; 
	nop								sq.xyzw		vf09,DST_UV0+DST_NEXT*2(vi05)	; 
	nop								iaddiu		vi05,vi05,DST_NEXT*4			; 
	nop								ibgtz		vi10,lower_t0_loop				; 
	nop								iaddiu		vi08,vi08,SRC_NEXT*4			; 
	nop								b			clip_check_end					; 描画は行なわない
	nop								nop											; 
lower_t0_end:

lower_t1:
	nop								ibne		vi11,vi00,lower_t1_end			; 
	nop								iaddiu		vi01,vi00,0x0008				; Ｔ＝１上のエッジについてチェック
	nop								iand		vi01,vi01,vi12					; 
	nop								iaddiu		vi05,vi03,0x0000				; 
	nop								ibeq		vi01,vi00,lower_t1_end			; 
	nop								iaddiu		vi08,vi04,0x0000				; 
	nop								iaddiu		vi10,vi00,16					; 
lower_t1_loop:
	nop								isub		vi10,vi10,vi14					; 
	nop								isub		vi10,vi10,vi14					; 
	nop								lq.xyzw		vf04,SRC_VERT(vi08)				; 
	nop								lq.xyzw		vf05,SRC_COL(vi08)				; 
	nop								lq.xyzw		vf06,SRC_UV0(vi08)				; 
	nop								lq.xyzw		vf07,DST_XYZ(vi05)				; 
	nop								lq.xyzw		vf08,DST_COL(vi05)				; 
	nop								lq.xyzw		vf09,DST_UV0(vi05)				; 
	nop								sq.xyzw		vf04,SRC_VERT+SRC_NEXT*2(vi08)	; 
	nop								sq.xyzw		vf05,SRC_COL+SRC_NEXT*2(vi08)	; 
	nop								sq.xyzw		vf06,SRC_UV0+SRC_NEXT*2(vi08)	; 
	nop								sq.xyzw		vf07,DST_XYZ+DST_NEXT*2(vi05)	; 
	nop								sq.xyzw		vf08,DST_COL+DST_NEXT*2(vi05)	; 
	nop								sq.xyzw		vf09,DST_UV0+DST_NEXT*2(vi05)	; 
	nop								iaddiu		vi05,vi05,DST_NEXT*4			; 
	nop								ibgtz		vi10,lower_t1_loop				; 
	nop								iaddiu		vi08,vi08,SRC_NEXT*4			; 
	nop								b			re_clip_check					; クリップの再チェック
	nop								nop											; 
lower_t1_end:

	nop								b			draw_strip						; 描画処理へ
	nop								nop											; 

	; トライアングルストリップの各クリップフラグを再計算する
re_clip_check:
	nop								ilw.x		vi10,PACKDAT(vi13)				; 頂点数読み込み
	nop								lq			vf09,SRC_VERT(vi04)				; 
	nop								ilw.w		vi08,DST_XYZ(vi03)				; 
	nop								fcset		0								; 
	nop								iaddiu		vi15,vi00,0						; 
	nop								iaddiu		vi02,vi00,0x0fff				; 
re_clip_loop:
	clipw.xyz	vf09,vf09			iand		vi07,vi08,vi02					; 
	nop								iaddiu		vi03,vi03,DST_NEXT				; -,(先)
	nop								iaddiu		vi04,vi04,SRC_NEXT				; -,(先)
	nop								lq			vf09,SRC_VERT(vi04)				; 
	nop								fcand		vi01,0x3ffff					; 
	nop								ibeq		vi01,vi00,l08					; 
	nop								ilw.w		vi08,DST_XYZ(vi03)				; 
	nop								iaddiu		vi15,vi15,1						; ●
	nop								ior			vi07,vi07,vi06					; ●
l08:nop								isw.w		vi07,DST_XYZ-DST_NEXT(vi03)		; 
	nop								isw.w		vi07,SRC_UV0-SRC_NEXT(vi04)		; 
	nop								ibgtz		vi10,re_clip_loop				; 
	nop								iaddi		vi10,vi10,-1					; 

	; 描画処理（最初の１ライン以外）
draw_strip:
	nop								ilw.x		vi03,BUFF_ADDR(vi00)			; -,アドレススワップ
	nop								iaddiu		vi01,vi00,16					;
	nop								lq.yzw		vf01,GIFNORMAL(vi00)			; 
	nop								ibeq		vi01,vi11,set_texture			; 
	nop								ilw.x		vi01,GIFNORMAL(vi00)			; 
	nop								ilw.x		vi02,PACKDAT(vi13)				; 
	nop								sq.yzw		vf01,0x00(vi03)					; ＧＩＦタグ書き込み
	nop								ior			vi01,vi01,vi02					; 
	nop								isw.x		vi01,0x00(vi03)					; ＧＩＦタグ書き込み
	nop								xgkick		vi03							; プリミティブパケットキック
	; クリップポリゴン処理
clip_check:
	nop								ibeq		vi15,vi00,loop_end				; 
	nop								isw.x		vi09,REG_BACKUP(vi00)			; 
	nop								isw.y		vi11,REG_BACKUP(vi00)			; 
	nop								b			ClipStartFog					; 
	nop								nop											; 
clip_finish:
	nop								ilw.x		vi09,REG_BACKUP(vi00)			; 
	nop								ilw.y		vi11,REG_BACKUP(vi00)			; 
	nop								ilw.y		vi12,SURF_FLAG(vi13)			; 
	nop								b			loop_end						; 
	nop								ilw.z		vi14,SURF_FLAG(vi13)			; 
clip_check_end:

	; テクスチャの設定（最初の１ライン計算後のみ）
set_texture:
	nop								iaddiu		vi04,vi00,TX0_OFT				; 
	nop								xgkick		vi04							; テクスチャ設定パケットキック
set_texture_end:

	; １ライン分処理後の後始末
loop_end:
	nop								ilw.x		vi03,BUFF_ADDR(vi00)			; -,アドレススワップ
	nop								ilw.y		vi05,BUFF_ADDR(vi00)			; -,アドレススワップ
	nop								isub		vi11,vi11,vi14					; 
	nop								iaddiu		vi01,vi00,1						; バッファ切り替え
	nop								isub		vi09,vi01,vi09					; バッファ切り替え
	nop								isw.y		vi03,BUFF_ADDR(vi00)			; -,アドレススワップ
	nop								isw.x		vi05,BUFF_ADDR(vi00)			; -,アドレススワップ
	nop								ibgez		vi11,loop_t						; 
	nop								nop											; 

	nop[e]							nop											; 
	nop								nop											; 











; ================================================================
; クリップルーチン用レジスタ割り当て
; ================================================================
;	vf00:fix
;	vf01:定数読み込みベクトル
;	vf02:プリミティブ座標変換スケール
;	vf03:プリミティブ座標変換オフセット
;	vf04:クリップ頂点保持用
;	vf05:クリップ頂点保持用
;	vf06:クリップ頂点保持用
;	vf07:クリップ頂点保持用
;	vf08:
;	vf09:
;	vf10:
;	vf11:
;	vf12:
;	vf13:
;	vf14:
;	vf15:フォグパラメータ
;	vf16:
;	vf17:
;	vf18:
;	vf19:
;	vf20:
;	vf21:
;	vf22:
;	vf23:
;	vf24:
;	vf25:
;	vf26:
;	vf27:
;	vf28:
;	vf29:
;	vf30:
;	vf31:汎用

;	vi00:０
;	vi01:条件判断又はテンポラリ
;	vi02:クリップ頂点数
;	vi03:一時使用
;	vi04:一時使用
;	vi05:一時使用
;	vi06:
;	vi07:キックフラグ読み込み用
;	vi08:頂点数
;	vi09:読み込みデータアドレス
;	vi10:書き込みデータアドレス
;	vi11:0x4000定数＆汎用
;	vi12:処理フラグ記憶用
;	vi13:バッファ先頭アドレス
;	vi14:
;	vi15:リンクレジスタ＆クリップ処理チェックフラグ

; ================================================================
; クリッピングルーチン
; ================================================================
ClipStartFog:
	nop								lq.xyzw		vf02,FV_SCN(vi00)				; -,座標スケール
	nop								lq.xyzw		vf03,FV_OFT(vi00)				; -,座標オフセット
	nop								ilw.x		vi08,PACKDAT(vi13)				; -,処理頂点数の読み込み
	nop								iaddiu		vi09,vi00,CLIP_DATA+SRC_NEXT*2	; -,読み込みアドレス設定
	nop								ilw.w		vi07,SRC_FLG(vi09)			; クリップフラグ読み込み
	nop								iaddi		vi08,vi08,-2				; ２頂点スキップしているので
	nop								iaddiu		vi11,vi00,0x4000			; 定数設定
ClipLoopFog:
	nop								iand		vi01,vi07,vi11				; フラグチェック
	nop								iaddiu		vi02,vi00,3					; クリップ処理頂点数設定
	nop								ibeq		vi01,vi00,ClipSkipFog		; 
	nop								fcset		0							; 
	; クリップポリゴン発見時
	nop								ilw.z		vi10,BUFF_ADDR(vi00)			; バッファアドレス設定
	nop								lq.xyzw		vf04,SRC_XYZW-SRC_NEXT*2(vi09)	; -,第１座標読み込み
	nop								lq.xyzw		vf05,SRC_XYZW-SRC_NEXT*1(vi09)	; -,第２座標読み込み
	nop								lq.xyzw		vf06,SRC_XYZW-SRC_NEXT*0(vi09)	; -,第３座標読み込み
	nop								iaddiu		vi10,vi10,6*3+1					; バッファアドレス設定
	clipw.xyz	vf04,vf04			lq.xyzw		vf16,SRC_COL -SRC_NEXT*2(vi09)	; ,第１カラー読み込み
	clipw.xyz	vf05,vf05			lq.xyzw		vf17,SRC_UV0 -SRC_NEXT*2(vi09)	; ,第１ＵＶ０読み込み
	clipw.xyz	vf06,vf06			lq.xyzw		vf18,SRC_COL -SRC_NEXT*1(vi09)	; ,第２カラー読み込み
	nop								lq.xyzw		vf19,SRC_UV0 -SRC_NEXT*1(vi09)	; -,第２ＵＶ０読み込み
	nop								fcget		vi03							; 
	nop								fcget		vi04							; 
	nop								iand		vi03,vi03,vi04					; 
	nop								fcget		vi04							; 
	nop								iand		vi03,vi03,vi04					; 
	nop								sq.xyzw		vf16,DST_COL +DST_NEXT*0(vi10)	; 第１カラー書き込み
	nop								ibne		vi03,vi00,ClipSkipFog			; 
	nop								sq.xyzw		vf17,DST_UV0 +DST_NEXT*0(vi10)	; 第１ＵＶ０書き込み
	nop								sq.xyzw		vf18,DST_COL +DST_NEXT*1(vi10)	; 第２カラー書き込み
	nop								sq.xyzw		vf19,DST_UV0 +DST_NEXT*1(vi10)	; 第２ＵＶ０書き込み
	nop								lq.xyzw		vf16,SRC_COL -SRC_NEXT*0(vi09)	; 第３カラー読み込み
	nop								lq.xyzw		vf17,SRC_UV0 -SRC_NEXT*0(vi09)	; 第３ＵＶ０読み込み
	nop								sq.xyzw		vf04,DST_XYZ +DST_NEXT*0(vi10)	; 第１座標書き込み
	nop								sq.xyzw		vf05,DST_XYZ +DST_NEXT*1(vi10)	; 第２座標書き込み
	nop								sq.xyzw		vf06,DST_XYZ +DST_NEXT*2(vi10)	; 第３座標書き込み
	nop								sq.xyzw		vf16,DST_COL +DST_NEXT*2(vi10)	; 第３カラー書き込み
	nop								sq.xyzw		vf17,DST_UV0 +DST_NEXT*2(vi10)	; 第３ＵＶ０書き込み

	nop								fcand		vi01,0x10410		; 
	nop								ibeq		vi01,vi00,_clipf_6	; 
	nop								nop								; 
	nop								bal			vi15,ZClip_p		; Ｚ＝Ｗ面によるクリップ
	nop								nop								; 
_clipf_6:
	nop								bal			vi15,CorrectColor	; ＲＧＢＡ補正
	nop								nop								; 
	nop								fcand		vi01,0x820820		; 
	nop								ibeq		vi01,vi00,_clipf_1	; 
	nop								nop								; 
	nop								bal			vi15,ZClip_m		; Ｚ＝−Ｗ面によるクリップ
	nop								nop								; 
_clipf_1:
	nop								fcand		vi01,0x041041		; 
	nop								ibeq		vi01,vi00,_clipf_2	; 
	nop								nop								; 
	nop								bal			vi15,XClip_p		; Ｘ＝Ｗ面によるクリップ
	nop								nop								; 
_clipf_2:
	nop								fcand		vi01,0x082082		; 
	nop								ibeq		vi01,vi00,_clipf_3	; 
	nop								nop								; 
	nop								bal			vi15,XClip_m		; Ｘ＝−Ｗ面によるクリップ
	nop								nop								; 
_clipf_3:
	nop								fcand		vi01,0x104104		; 
	nop								ibeq		vi01,vi00,_clipf_4	; 
	nop								nop								; 
	nop								bal			vi15,YClip_p		; Ｙ＝Ｗ面によるクリップ
	nop								nop								; 
_clipf_4:
	nop								fcand		vi01,0x208208		; 
	nop								ibeq		vi01,vi00,_clipf_5	; 
	nop								nop								; 
	nop								bal			vi15,YClip_m		; Ｙ＝−Ｗ面によるクリップ
	nop								nop								; 
_clipf_5:

	; クリップ後に頂点が存在すれば描画を行う
	nop								isubiu		vi01,vi02,3					; 
	nop								lq.xyzw		vf16,GIFCLIP(vi00)			; ＧＩＦタグ読み込み
	nop								ibltz		vi01,ClipSkipFog			; 
	nop								iaddiu		vi01,vi00,0x4000			; 
	mulx.xyzw	vf27,vf27,vf00		iadd		vi01,vi01,vi01				; 
	nop								ior			vi01,vi01,vi02				; 
	nop								iaddi		vi10,vi10,-1				; 
	nop								loi			0.0							; ＲＧＢＡ四捨五入用定数
	addi.xyz	vf27,vf27,I			sq.yzw		vf16,0(vi10)				; alphaには四捨五入を行なわない
	nop								isw.x		vi01,0(vi10)				; 
	nop								iaddiu		vi03,vi10,1					; 
	; 座標変換処理他

	nop								lq.xyzw		vf15,FV_FOG(vi00)	; 
	nop								lq.xyzw		vf16,DST_XYZ(vi03)	; 
	nop								lq.xyzw		vf17,DST_COL(vi03)	; 
	nop								lq.xyzw		vf18,DST_UV0(vi03)	; 
	mulax.w		ACC ,vf16,vf15		div			Q,vf00w,vf16w		; 
	maddy.w		vf16,vf00,vf15		lq.xyzw		vf01,FV_PRM(vi00)	; 
	maxx.w		vf21,vf16,vf00		nop								; 
_clipf_0:
	mulq.xyz	vf21,vf16,Q			waitq									; 透視変換,-
	mulaq.xyzw	ACC ,vf17,Q			iaddiu		vi03,vi03,DST_NEXT			; ＲＧＢＡ値補正,読み込みアドレス増加
	maddw.xyzw	vf22,vf27,vf00		lq.xyzw		vf16,DST_XYZ(vi03)			; ＲＧＢＡ値補正,(先)頂点読み込み
	minix.w		vf21,vf21,vf01		lq.xyzw		vf17,DST_COL(vi03)			; フォグ,(先)色読み込み
	mula.xyz	ACC ,vf21,vf02		nop										; プリミティブ座標,-
	maddw.xyz	vf21,vf03,vf00		nop										; プリミティブ座標,-
	mulq.xyz	vf23,vf18,Q			div			Q,vf00w,vf16w				; ＳＴＱ０,除数算出
	ftoi0.xyzw	vf22,vf22			lq.xyzw		vf18,DST_UV0(vi03)			; 整数化,(先)ＵＶ０読み込み
	mulax.w		ACC ,vf16,vf15		iaddi		vi02,vi02,-1				; (先)フォグ,頂点数減算
	ftoi4.xyzw	vf21,vf21			nop										; 整数化,-
	maddy.w		vf16,vf00,vf15		sq.xyz		vf23,DST_UV0-DST_NEXT(vi03)	; (先)フォグ,ＵＶ０書き戻し
	nop								sq.xyzw		vf22,DST_COL-DST_NEXT(vi03)	; -,色書き戻し
	nop								ibgtz		vi02,_clipf_0				; -,ループ
	maxx.w		vf21,vf16,vf00		sq.xyzw		vf21,DST_XYZ-DST_NEXT(vi03)	; (先)フォグ,座標書き戻し

	nop								xgkick		vi10						; 
	nop								ilw.z		vi10,BUFF_ADDR(vi00)		; バッファ切り替え
	nop								ilw.w		vi14,BUFF_ADDR(vi00)		; バッファ切り替え
	nop								isw.w		vi10,BUFF_ADDR(vi00)		; バッファ切り替え
	nop								isw.z		vi14,BUFF_ADDR(vi00)		; バッファ切り替え

ClipSkipFog:
	nop								iaddi		vi08,vi08,-1		; カウンタ減算
	nop								iaddiu		vi09,vi09,SRC_NEXT	; 読み込みアドレス増加
	nop								ilw.w		vi07,SRC_FLG(vi09)	; クリップフラグ読み込み
	nop								ibgtz		vi08,ClipLoopFog	; 
	nop								iaddiu		vi11,vi00,0x4000	; 定数設定

	nop								b			clip_finish			; 
	nop								nop								; 



; ================================================================
; クリップ用サブルーチン
; ================================================================

; ----------------------------------------------------------------
; Ｘ＝Ｗ面に対するクリップ処理
; ----------------------------------------------------------------
XClip_p:
	nop								iaddiu		vi03,vi10,0			; vi03=処理用の頂点読み込みアドレス
	nop								iadd		vi01,vi02,vi02		; 
	nop								iadd		vi01,vi01,vi02		; vi01=処理頂点数×3
	nop								iadd		vi04,vi03,vi01		; vi04=計算用最終頂点格納アドレス
	nop								isubiu		vi10,vi10,DST_NEXT	; 頂点アドレスのデクリメント
	nop								iaddiu		vi11,vi10,0			; vi11=処理用の頂点格納アドレス
	nop								iaddi		vi05,vi02,0			; vi05=ループ用カウンタ
	nop								iaddiu		vi02,vi00,0			; 新規の頂点数をカウントする為にクリア

	nop								lq.xyzw		vf16,DST_XYZ(vi03)	; 
	nop								lq.xyzw		vf17,DST_COL(vi03)	; 
	nop								lq.xyzw		vf18,DST_UV0(vi03)	; 
	nop								iaddiu		vi03,vi03,DST_NEXT	; 
	clipw.xyz	vf16,vf16			sq.xyzw		vf16,DST_XYZ(vi04)	; ,計算用最終頂点の生成
	subx.w		vf12,vf16,vf16		sq.xyzw		vf17,DST_COL(vi04)	; ＜非共通部分＞,計算用最終頂点の生成
	nop								sq.xyzw		vf18,DST_UV0(vi04)	; ,計算用最終頂点の生成
_clip0_0:
	nop								lq.xyzw		vf21,DST_XYZ(vi03)	; 
	nop								lq.xyzw		vf22,DST_COL(vi03)	; 
	nop								lq.xyz		vf23,DST_UV0(vi03)	; 
	nop								iaddiu		vi03,vi03,DST_NEXT	; 
	clipw.xyz	vf21,vf21			sq.xyzw		vf16,DST_XYZ(vi11)	; 先頭頂点がクリップ内のときには先にストアしておく
	subx.w		vf13,vf21,vf21		sq.xyzw		vf17,DST_COL(vi11)	; ＜非共通部分＞
	nop								sq.xyzw		vf18,DST_UV0(vi11)	; 
	nop								iaddi		vi05,vi05,-1		; 
	; クリップ判定
	mulw.xyzw	vf27,vf21,vf12		fcor		vi01,~0x041			; 座標Ｂ,＜非共通部分＞
	mulw.xyzw	vf26,vf16,vf13		ibne		vi01,vi00,_clip0_2	; 座標Ａ,２点とも領域外
	sub.w		vf14,vf13,vf12		fcand		vi01,0x041			; Ｗの差分,カラー補間用先行計算,＜非共通部分＞
	mulw.xyzw	vf28,vf17,vf13		ibeq		vi01,vi00,_clip0_1	; 色Ａ,２点とも領域内
	mulw.xyzw	vf29,vf22,vf12		fcand		vi01,0x0040			; 色Ｂ,＜非共通部分＞
	mulw.xyz	vf30,vf18,vf13		ibne		vi01,vi00,_clip0_3	; ＵＶ０Ａ,
	mulw.xyz	vf31,vf23,vf12		div			Q,vf00w,vf14w		; ＵＶ０Ｂ,
	nop								iaddiu		vi11,vi11,DST_NEXT	; ●書き込みアドレス増加
	nop								iaddiu		vi02,vi02,1			; ●頂点数増加
_clip0_3:
	sub.yzw		vf16,vf26,vf27		nop								; 座標＜非共通部分＞,
	sub.xyzw	vf17,vf28,vf29		nop								; 色
	sub.xyz		vf18,vf30,vf31		nop								; ＳＴ０
	addw.x		vf16,vf00,vf16		nop								; 座標＜非共通部分＞
	mulq.xyzw	vf16,vf16,Q			waitq							; 
	mulq.xyzw	vf17,vf17,Q			nop								; 
	mulq.xyzw	vf18,vf18,Q			nop								; 
_clip0_1:
	nop								sq.xyzw		vf16,DST_XYZ(vi11)	; 
	nop								sq.xyzw		vf17,DST_COL(vi11)	; 
	nop								sq.xyzw		vf18,DST_UV0(vi11)	; 
	nop								iaddiu		vi11,vi11,DST_NEXT	; 
	nop								iaddiu		vi02,vi02,1			; 
_clip0_2:
	addx.xyzw	vf16,vf21,vf00		nop								; 
	addx.xyzw	vf17,vf22,vf00		ibgtz		vi05,_clip0_0		; 
	addx.xyzw	vf18,vf23,vf00		move.w		vf12,vf13			; 

	clipw.xyz	vf04,vf04			nop								; 
	clipw.xyz	vf05,vf05			nop								; リターン
	clipw.xyz	vf06,vf06			nop								; 
	clipw.xyz	vf07,vf07			nop								; 
	nop								nop								; 
	nop								jr			vi15				; 
	nop								nop								; 

; ----------------------------------------------------------------
; Ｘ＝−Ｗ面に対するクリップ処理
; ----------------------------------------------------------------
XClip_m:
	nop								iaddiu		vi03,vi10,0			; vi03=処理用の頂点読み込みアドレス
	nop								iadd		vi01,vi02,vi02		; 
	nop								iadd		vi01,vi01,vi02		; vi01=処理頂点数×3
	nop								iadd		vi04,vi03,vi01		; vi04=計算用最終頂点格納アドレス
	nop								isubiu		vi10,vi10,DST_NEXT	; 頂点アドレスのデクリメント
	nop								iaddiu		vi11,vi10,0			; vi11=処理用の頂点格納アドレス
	nop								iaddi		vi05,vi02,0			; vi05=ループ用カウンタ
	nop								iaddiu		vi02,vi00,0			; 新規の頂点数をカウントする為にクリア

	nop								lq.xyzw		vf16,DST_XYZ(vi03)	; 
	nop								lq.xyzw		vf17,DST_COL(vi03)	; 
	nop								lq.xyzw		vf18,DST_UV0(vi03)	; 
	nop								iaddiu		vi03,vi03,DST_NEXT	; 
	clipw.xyz	vf16,vf16			sq.xyzw		vf16,DST_XYZ(vi04)	; ,計算用最終頂点の生成
	addx.w		vf12,vf16,vf16		sq.xyzw		vf17,DST_COL(vi04)	; ＜非共通部分＞,計算用最終頂点の生成
	nop								sq.xyzw		vf18,DST_UV0(vi04)	; ,計算用最終頂点の生成
_clip1_0:
	nop								lq.xyzw		vf21,DST_XYZ(vi03)	; 
	nop								lq.xyzw		vf22,DST_COL(vi03)	; 
	nop								lq.xyz		vf23,DST_UV0(vi03)	; 
	nop								iaddiu		vi03,vi03,DST_NEXT	; 
	clipw.xyz	vf21,vf21			sq.xyzw		vf16,DST_XYZ(vi11)	; ,先にストアしておく
	addx.w		vf13,vf21,vf21		sq.xyzw		vf17,DST_COL(vi11)	; ＜非共通部分＞
	nop								sq.xyzw		vf18,DST_UV0(vi11)	; 
	nop								iaddi		vi05,vi05,-1		; 
	; クリップ判定
	mulw.xyzw	vf27,vf21,vf12		fcor		vi01,~0x082			; 座標Ｂ,＜非共通部分＞
	mulw.xyzw	vf26,vf16,vf13		ibne		vi01,vi00,_clip1_2	; 座標Ａ,２点とも領域外
	sub.w		vf14,vf13,vf12		fcand		vi01,0x082			; Ｗの差分,カラー補間用先行計算,＜非共通部分＞
	mulw.xyzw	vf28,vf17,vf13		ibeq		vi01,vi00,_clip1_1	; 色Ａ,２点とも領域内
	mulw.xyzw	vf29,vf22,vf12		fcand		vi01,0x0080			; 色Ｂ,＜非共通部分＞
	mulw.xyz	vf30,vf18,vf13		ibne		vi01,vi00,_clip1_3	; ＵＶ０Ａ,
	mulw.xyz	vf31,vf23,vf12		div			Q,vf00w,vf14w		; ＵＶ０Ｂ,
	nop								iaddiu		vi11,vi11,DST_NEXT	; ●書き込みアドレス増加
	nop								iaddiu		vi02,vi02,1			; ●頂点数増加
_clip1_3:
	sub.yzw		vf16,vf26,vf27		nop								; 座標＜非共通部分＞,
	sub.xyzw	vf17,vf28,vf29		nop								; 色
	sub.xyz		vf18,vf30,vf31		nop								; ＳＴ０
	subw.x		vf16,vf00,vf16		nop								; 座標＜非共通部分＞
	mulq.xyzw	vf16,vf16,Q			waitq							; 
	mulq.xyzw	vf17,vf17,Q			nop								; 
	mulq.xyzw	vf18,vf18,Q			nop								; 
_clip1_1:
	nop								sq.xyzw		vf16,DST_XYZ(vi11)	; 
	nop								sq.xyzw		vf17,DST_COL(vi11)	; 
	nop								sq.xyzw		vf18,DST_UV0(vi11)	; 
	nop								iaddiu		vi11,vi11,DST_NEXT	; 
	nop								iaddiu		vi02,vi02,1			; 
_clip1_2:
	addx.xyzw	vf16,vf21,vf00		nop								; 
	addx.xyzw	vf17,vf22,vf00		ibgtz		vi05,_clip1_0		; 
	addx.xyzw	vf18,vf23,vf00		move.w		vf12,vf13			; 

	clipw.xyz	vf04,vf04			nop								; 
	clipw.xyz	vf05,vf05			nop								; リターン
	clipw.xyz	vf06,vf06			nop								; 
	clipw.xyz	vf07,vf07			nop								; 
	nop								nop								; 
	nop								jr			vi15				; 
	nop								nop								; 


; ----------------------------------------------------------------
; Ｙ＝Ｗ面に対するクリップ処理
; ----------------------------------------------------------------
YClip_p:
	nop								iaddiu		vi03,vi10,0			; vi03=処理用の頂点読み込みアドレス
	nop								iadd		vi01,vi02,vi02		; 
	nop								iadd		vi01,vi01,vi02		; vi01=処理頂点数×3
	nop								iadd		vi04,vi03,vi01		; vi04=計算用最終頂点格納アドレス
	nop								isubiu		vi10,vi10,DST_NEXT	; 頂点アドレスのデクリメント
	nop								iaddiu		vi11,vi10,0			; vi11=処理用の頂点格納アドレス
	nop								iaddi		vi05,vi02,0			; vi05=ループ用カウンタ
	nop								iaddiu		vi02,vi00,0			; 新規の頂点数をカウントする為にクリア

	nop								lq.xyzw		vf16,DST_XYZ(vi03)	; 
	nop								lq.xyzw		vf17,DST_COL(vi03)	; 
	nop								lq.xyzw		vf18,DST_UV0(vi03)	; 
	nop								iaddiu		vi03,vi03,DST_NEXT	; 
	clipw.xyz	vf16,vf16			sq.xyzw		vf16,DST_XYZ(vi04)	; ,計算用最終頂点の生成
	suby.w		vf12,vf16,vf16		sq.xyzw		vf17,DST_COL(vi04)	; ＜非共通部分＞,計算用最終頂点の生成
	nop								sq.xyzw		vf18,DST_UV0(vi04)	; ,計算用最終頂点の生成
_clip2_0:
	nop								lq.xyzw		vf21,DST_XYZ(vi03)	; 
	nop								lq.xyzw		vf22,DST_COL(vi03)	; 
	nop								lq.xyz		vf23,DST_UV0(vi03)	; 
	nop								iaddiu		vi03,vi03,DST_NEXT	; 
	clipw.xyz	vf21,vf21			sq.xyzw		vf16,DST_XYZ(vi11)	; 先頭頂点がクリップ内のときには先にストアしておく
	suby.w		vf13,vf21,vf21		sq.xyzw		vf17,DST_COL(vi11)	; ＜非共通部分＞
	nop								sq.xyzw		vf18,DST_UV0(vi11)	; 
	nop								iaddi		vi05,vi05,-1		; 
	; クリップ判定
	mulw.xyzw	vf27,vf21,vf12		fcor		vi01,~0x104			; 座標Ｂ,＜非共通部分＞
	mulw.xyzw	vf26,vf16,vf13		ibne		vi01,vi00,_clip2_2	; 座標Ａ,２点とも領域外
	sub.w		vf14,vf13,vf12		fcand		vi01,0x104			; Ｗの差分,カラー補間用先行計算,＜非共通部分＞
	mulw.xyzw	vf28,vf17,vf13		ibeq		vi01,vi00,_clip2_1	; 色Ａ,２点とも領域内
	mulw.xyzw	vf29,vf22,vf12		fcand		vi01,0x0100			; 色Ｂ,＜非共通部分＞
	mulw.xyz	vf30,vf18,vf13		ibne		vi01,vi00,_clip2_3	; ＵＶ０Ａ,
	mulw.xyz	vf31,vf23,vf12		div			Q,vf00w,vf14w		; ＵＶ０Ｂ,
	nop								iaddiu		vi11,vi11,DST_NEXT	; ●書き込みアドレス増加
	nop								iaddiu		vi02,vi02,1			; ●頂点数増加
_clip2_3:
	sub.xzw		vf16,vf26,vf27		nop								; 座標＜非共通部分＞,
	sub.xyzw	vf17,vf28,vf29		nop								; 色
	sub.xyz		vf18,vf30,vf31		nop								; ＳＴ０
