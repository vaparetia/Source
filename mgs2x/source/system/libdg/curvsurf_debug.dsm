	madday.xyzw	ACC ,vf05,vf16		lq.xyzw		vf05,M_LIT1(vi00)				; 座標変換,ローカルライトＭ
	maddaz.xyzw	ACC ,vf06,vf16		lq.xyzw		vf06,M_LIT2(vi00)				; 座標変換,ローカルライトＭ
	maddw.xyzw	vf13,vf07,vf16		lq.xyzw		vf02,FV_TTBL(vi10)				; 座標変換,(t^3,t^2,t,1)算出
