	; Ｔ軸方向ループ
loop_t:
	nop								lq.xyzw		vf02,FV_TTBL(vi11)				; (t^3,t^2,t,1)算出
	nop								lq.xyzw		vf03,FV_DTTBL(vi11)				; (3t^2,2t,1,0)算出
