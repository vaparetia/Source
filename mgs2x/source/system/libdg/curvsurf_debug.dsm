	itof4.x		vf31,vf31			iaddiu		vi03,vi03,DST_NEXT*2			; キックフラグ,アドレス増加（２頂点分）
	maddw.xyz	vf14,vf07,vf00		iaddiu		vi04,vi04,SRC_NEXT*2			; 光源計算,アドレス増加（２頂点分）
