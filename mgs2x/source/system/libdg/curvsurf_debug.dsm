;
;	curvsurf.dsm
;	パッチ曲面（エルミート補間方式）パケット処理プログラム
;
;	2000/07/07 K.Takabe
;	$Id: curvsurf_debug.dsm,v 1.1.1.3 2002/11/19 11:42:05 Yoshizawa1 Exp $
;

alpha_vertex = 0
DRAW_DEBUG_MODE = 3

; ================================================================
; 補足事項
; ================================================================
; ＜曲面生成手順概要＞
; ０）曲面サーフェスは以下のようにＳ軸とＴ軸からなる
;O         S
; +--------+ (1,0)
; |        |
; |        |
; |        |
; |        |
; |        |
;T+--------+(1,1)
; (0,1)
;
; １）まずはＴ軸方向に両端をエルミート補間で計算
; |MAT_VT0 |MAT_VT1 * TVEC
; | * TVEC | 
; |        |
; |        |
; |T0軸    |T1軸
; V        V
; 
; ２）次にＳ軸方向にエルミート補間で座標を求めつつストリップ作成
; .        .
; +........+
; |/|/...|/|
; +--------+
; 
; 
; ＜バッファの使用方法＞
; １つのバッファはＳ軸走査時における奇数ライン・偶数偶数ラインに対応したダブルバッファを
; インタリーブした形になっている。こうすることで描画時にトライアングルストリップとして
; 直接キックすることができる。
; ●クリップ用待避バッファ（シングルバッファ）
; 　クリッピング処理に使用するＷ除算前のデータ
; ●プリミティブバッファ（ダブルバッファ）
; 　実際にプリミティブを構成してＧＩＦに渡すためのバッファ。描画に使用するためダブルバッファ
; 　構造になっているため、描画に必要な片側のラインの頂点データはもう１つのバッファからコピー
; 　することになるので注意。
; 


; ================================================================
; DVPASM設定
; ================================================================


.global Vu1DrawCurveSurface_Debug
.global Vu1DrawCurveSurface_Debug_Func


; プログラム呼び出しＶＩＦコード一覧
Vu1DrawCurveSurface_Debug_Func:
	.word	( StartCurveSurface / 8 )						; 



; ================================================================
; 各種定数定義
; ================================================================

; ＜ワークアドレスオフセット＞
VAR00		= 0		; プログラム用変数領域
VAR00X		= 0		; パケットバッファワーク切り替えフラグ退避用
VAR00Y		= 0		; 
VAR00Z		= 0		; 
VAR00W		= 0		; 
VAR01		= 1		; プログラム用変数領域
; 固定パラメータ類
FV_FOG		= 2		; フォグパラメータ
FV_PRM		= 3		; 各種定数
FV_SCN		= 4		; プリミティブ座標へのスケーリングパラメータ
FV_OFT		= 5		; プリミティブ座標へのオフセット値
FV_PRM2		= 6		; 各種定数２
FV_ASPC		= 7		; アスペクト比
; 定数等
GIFCLIP		= 16	; クリップ描画用ＧＩＦタグ（トライアングルファン型）<<static data>>
GIFNORMAL	= 17	; 通常描画用ＧＩＦタグ（トライアングルストリップ型）<<static data>>
; 係数マトリクス
MAT_HERMITE	= 18	; エルミート補間用係数マトリクス<<static data>>
FV_TTBL		= 22	; 計算済みt展開テーブル<<static data>>
FV_DTTBL	= 39	; 計算済みt微分展開テーブル（傾き算出用）<<static data>>
FV_TTBLNEXT	= 56	; ダミー
; エルミート補間用計算済みマトリクス保持ワーク
MAT_HVT0	= 80	; エルミート補間用マトリクス（Ｔ０軸頂点座標補間用）
MAT_HVT1	= 84	; エルミート補間用マトリクス（Ｔ１軸頂点座標補間用）
; プログラムワーク＆レジスタ待避
BUFF_ADDR	= 88	; 現在のパケットバッファアドレス
REG_BACKUP	= 89	; レジスタ待避用
; オブジェクト処理パラメータ類
M_PRS0		= 104	; 透視変換マトリクス０
M_PRS1		= 105	; 透視変換マトリクス１
M_PRS2		= 106	; 透視変換マトリクス２
M_PRS3		= 107	; 透視変換マトリクス３
M_LIT0		= 108	; ローカルライトマトリクスＸ = lit0_x,lit1_x,lit2_x,supecular_x
M_LIT1		= 109	; ローカルライトマトリクスＹ = lit0_y,lit1_y,lit2_y,supecular_y
M_LIT2		= 110	; ローカルライトマトリクスＺ = lit0_z,lit1_z,lit2_z,supecular_z
M_LIT3		= 111	; 未使用
M_COL0		= 112	; ローカルカラー０ = lit0_r,lit0_g,lit0_b
M_COL1		= 113	; ローカルカラー１ = lit1_r,lit1_g,lit1_b
M_COL2		= 114	; ローカルカラー２ = lit2_r,lit2_g,lit2_b
M_COL3		= 115	; アンビエントカラー = amb_r amb_g amb_b
M_OPT0		= 116	; 環境マッピング用マトリクス０
M_OPT1		= 117	; 環境マッピング用マトリクス１
M_OPT2		= 118	; 環境マッピング用マトリクス２
M_OPT3		= 119	; 環境マッピング用マトリクス３
TX0_OFT		= 120	; テクスチャ設定パケット
; 固有ワーク
; クリッピングデータ待避バッファ領域
CLIP_DATA	= 128	; 
; プリミティブパケットバッファ領域
PACK0_GIF	= 384	; ＧＩＦタグ格納位置
PACK0_PRIM	= 385	; プリミティブデータ格納位置
PACK1_GIF	= 640	; ＧＩＦタグ格納位置
PACK1_PRIM	= 641	; プリミティブデータ格納位置
PACKCLIP0	= 896	; 切断ポリゴン用データ領域
PACKCLIP1	= 928	; 切断ポリゴン用データ領域
; データロードダブルバッファ領域
DBUFFER_TOP	= 960	;
; 1024

; 頂点データオフセット
VERT0		= 0x00	; 頂点座標
VERT0_DS	= 0x01	; 頂点座標Ｓ成分変化量
VERT0_DT	= 0x02	; 頂点座標Ｔ成分変化量
TEX0		= 0x03	; テクスチャ座標
VERT1		= 0x04	; 頂点座標
VERT1_DS	= 0x05	; 頂点座標Ｓ成分変化量
VERT1_DT	= 0x06	; 頂点座標Ｔ成分変化量
TEX1		= 0x07	; テクスチャ座標
VERT2		= 0x08	; 頂点座標
VERT2_DS	= 0x09	; 頂点座標Ｓ成分変化量
VERT2_DT	= 0x0a	; 頂点座標Ｔ成分変化量
TEX2		= 0x0b	; テクスチャ座標
VERT3		= 0x0c	; 頂点座標
VERT3_DS	= 0x0d	; 頂点座標Ｓ成分変化量
VERT3_DT	= 0x0e	; 頂点座標Ｔ成分変化量
TEX3		= 0x0f	; テクスチャ座標
SURF_FLAG	= 0x10	; 各種フラグ（x:頂点数,y:エッジ接続フラグ,z:分割数）

PACKDAT		= 0x10	; パケット定数（x:頂点数、y:処理フラグ、z:固定フォグ値、w:マトリクス数）
PACKET_END	= 32 ;


; ＜データ構造定義＞
; パケット構成バッファ使用定数
DST_NEXT	= 3		; 次の頂点データへのオフセット
DST_UV0		= 0		; ＳＴＱデータへのオフセット
DST_COL		= 1		; 頂点カラーデータへのオフセット
DST_XYZ		= 2		; 頂点データへのオフセット

; クリップ用待避バッファのデータ構造
SRC_NEXT	= 3		; 次の頂点データへのオフセット
SRC_FLG		= 2		; 座標変換処理終了後のキックフラグ格納オフセット
SRC_VERT	= 0		; 頂点データへのオフセット（実数、Ｗにはフォグ値）
SRC_NORM	= 1		; 法線データへのオフセット（実数）
SRC_UV0		= 2		; ＵＶ０データへのオフセット（実数）
SRC_XYZW	= 0		; 計算済み同時座標へのオフセット（実数）
SRC_COL		= 1		; 算出済み頂点カラーへのオフセット（実数）




; ================================================================
; データ転送定義部
; ================================================================
.data
.DmaPackVif 1			; タグ中のＶＩＦコード有効

; プログラム転送ＤＭＡタグ定義
Vu1DrawCurveSurface_Debug:		; マイクロプログラム読み込み用タグ記憶ポインタ
	DMAref *, _trans	; DMArefによるデータ転送を行う



; ================================================================
; データ記述開始
; ================================================================
.DmaData _trans			; DMArefで転送するデータの宣言

; ================================================================
; ＶＩＦ１初期化
; ================================================================
FLUSHA						; 前ＶＩＦ１パケット終了待ち
BASE	DBUFFER_TOP			; ダブルバッファ先頭アドレス
OFFSET	PACKET_END			; ダブルバッファサイズ
STCYCL	1,1					; ストアサイクル初期化
STMOD	DIRECT				; ストアモード（通常書き込み）

; ================================================================
; ＧＩＦ初期化
; ================================================================
DIRECT	*
GIFpacked REGS={A_D}, NLOOP=4, EOP
	.int	0x00000001, 0x00000000, 0x00000046, 0x00000000	; COLCLAMP
	.int	0x00000001, 0x00000000, 0x0000001a, 0x00000000	; PRMODECONT
;	.int	0x00000078, 0x00000000, 0x0000001b, 0x00000000	; PRMODE
	.int	0x00000068, 0x00000000, 0x0000001b, 0x00000000	; PRMODE
	.int	0x00000061, 0x00000000, 0x00000014, 0x00000000	; TEX1_1
.EndGif
.EndDirect

; ================================================================
; 定数の転送
; ================================================================
UNPACK 4, 4, V4_32, GIFCLIP, *
.if DRAW_DEBUG_MODE == 0
	; GIFCLIP
	.int	0x00008000, 0x303ec000, 0x00000412, 0x00000000
	; GIFNORMAL
	.int	0x00008000, 0x303e4000, 0x00000412, 0x00000000
.endif
.if DRAW_DEBUG_MODE == 1
	.int	0x00008000, 0x303ec000, 0x00000412, 0x00000000
	.int	0x00008000, 0x303d4000, 0x00000412, 0x00000000	; ラインストリップ版（デバッグ用）
.endif
.if DRAW_DEBUG_MODE == 2
	.int	0x00008000, 0x303ec000, 0x00000412, 0x00000000
	.int	0x00008000, 0x30354000, 0x00000412, 0x00000000	; ラインストリップ版テクスチャなし（デバッグ用）
.endif
.if DRAW_DEBUG_MODE == 3
	.int	0x00008000, 0x3046c000, 0x00000412, 0x00000000
	.int	0x00008000, 0x30464000, 0x00000412, 0x00000000	; ポリゴン版テクスチャなし（デバッグ用）
.endif
	; MAT_HERMITE
	.float	 2.0, -2.0,  1.0,  1.0		; エルミート補間マトリクス係数
	.float	-3.0,  3.0, -2.0, -1.0		; エルミート補間マトリクス係数
	.float	 0.0,  0.0,  1.0,  0.0		; エルミート補間マトリクス係数
	.float	 1.0,  0.0,  0.0,  0.0		; エルミート補間マトリクス係数
	; FV_TTBL ( t^3, t^2, t, 1 )
	.float	1.0           , 1.0       , 1.0   , 1.0		; t=16/16
	.float	0.823974609375, 0.87890625, 0.9375, 1.0		; t=15/16
	.float	0.669921875   , 0.765625  , 0.875 , 1.0		; t=14/16
	.float	0.536376953125, 0.66015625, 0.8125, 1.0		; t=13/16
	.float	0.421875      , 0.5625    , 0.75  , 1.0		; t=12/16
	.float	0.324951171875, 0.47265625, 0.6875, 1.0		; t=11/16
	.float	0.244140625   , 0.390625  , 0.625 , 1.0		; t=10/16
	.float	0.177978515625, 0.31640625, 0.5625, 1.0		; t= 9/16
	.float	0.125         , 0.25      , 0.5   , 1.0		; t= 8/16
	.float	0.083740234375, 0.19140625, 0.4375, 1.0		; t= 7/16
	.float	0.052734375   , 0.140625  , 0.375 , 1.0		; t= 6/16
	.float	0.030517578125, 0.09765625, 0.3125, 1.0		; t= 5/16
	.float	0.015625      , 0.0625    , 0.25  , 1.0		; t= 4/16
	.float	0.006591796875, 0.03515625, 0.1875, 1.0		; t= 3/16
	.float	0.001953125   , 0.015625  , 0.125 , 1.0		; t= 2/16
	.float	0.000244140625, 0.00390625, 0.0625, 1.0		; t= 1/16
	.float	0.0           , 0.0       , 0.0   , 1.0		; t= 0/16
	; FV_DTTBL ( 3t^2, 2t, 1, 0 )
	.float	3.0       , 2.0  , 1.0, 0.0		; t=16/16
	.float	2.63671875, 1.875, 1.0, 0.0		; t=15/16
	.float	2.296875  , 1.75 , 1.0, 0.0		; t=14/16
	.float	1.98046875, 1.625, 1.0, 0.0		; t=13/16
	.float	1.6875    , 1.5  , 1.0, 0.0		; t=12/16
	.float	1.41796875, 1.375, 1.0, 0.0		; t=11/16
	.float	1.171875  , 1.25 , 1.0, 0.0		; t=10/16
	.float	0.94921875, 1.125, 1.0, 0.0		; t= 9/16
	.float	0.75      , 1    , 1.0, 0.0		; t= 8/16
	.float	0.57421875, 0.875, 1.0, 0.0		; t= 7/16
	.float	0.421875  , 0.75 , 1.0, 0.0		; t= 6/16
	.float	0.29296875, 0.625, 1.0, 0.0		; t= 5/16
	.float	0.1875    , 0.5  , 1.0, 0.0		; t= 4/16
	.float	0.10546875, 0.375, 1.0, 0.0		; t= 3/16
	.float	0.046875  , 0.25 , 1.0, 0.0		; t= 2/16
	.float	0.01171875, 0.125, 1.0, 0.0		; t= 1/16
	.float	0.0       , 0.0  , 1.0, 0.0		; t= 0/16
.EndUnpack
UNPACK 4, 4, V4_32, BUFF_ADDR, *
	; BUFF_ADDR
	.int	PACK0_GIF, PACK1_GIF, PACKCLIP0, PACKCLIP1
.EndUnpack



; ================================================================
; プログラムの転送
; ================================================================
MPG 0,*				; マイクロプログラム転送VIFcode

.vu


; ----------------------------------------------------------------
; 通常レジスタ割り当て
; ----------------------------------------------------------------
;	vf00:fix
;	vf01:定数読み込みベクトル
;	vf02:ｔ展開ベクトル＆プリミティブ座標変換スケール
;	vf03:ｔ微分展開ベクトル＆プリミティブ座標変換オフセット
;	vf04:マトリクスワーク１
;	vf05:マトリクスワーク１
;	vf06:マトリクスワーク１
;	vf07:マトリクスワーク１
;	vf08:マトリクスワーク２
;	vf09:マトリクスワーク２＆計算済み同次座標チェック用
;	vf10:マトリクスワーク２＆書き込み頂点保持用
;	vf11:マトリクスワーク２＆書き込みカラー保持用
;	vf12:　　　　　　　　　　書き込みＳＴＱ保持用
;	vf13:頂点変換ワーク
;	vf14:光源計算ワーク
;	vf15:ＵＶ保持ワーク
;	vf16:エルミート補間係数読み込みマトリクス＆生成頂点
;	vf17:エルミート補間係数読み込みマトリクス＆生成ＵＶ
;	vf18:エルミート補間係数読み込みマトリクス＆生成法線
;	vf19:エルミート補間係数読み込みマトリクス＆法線生成テンポラリ
;	vf20:Ｓ軸頂点座標用エルミート補間マトリクス
;	vf21:Ｓ軸頂点座標用エルミート補間マトリクス
;	vf22:Ｓ軸頂点座標用エルミート補間マトリクス
;	vf23:Ｓ軸頂点座標用エルミート補間マトリクス
;	vf24:Ｔ０軸頂点Ｓ座標傾き
;	vf25:Ｔ１軸頂点Ｓ座標傾き
;	vf26:Ｔ０軸テクスチャ座標
;	vf27:Ｔ１軸テクスチャ座標
;	vf28:計算済み頂点移動用
;	vf29:計算済みカラー移動用
;	vf30:計算済みＳＴＱ移動用
;	vf31:フォグ計算テンポラリ

;	vi00:０
;	vi01:条件判断又はテンポラリ
;	vi02:
;	vi03:書き込みアドレス
;	vi04:書き込みアドレス（クリッピング用）
;	vi05:描画中バッファのアドレス
;	vi06:キックフラグ用定数
;	vi07:キックフラグ読み込み用
;	vi08:計算済みフォグ＆キックフラグ
;	vi09:プリミティブバッファ切り替えクロック（クリップ処理時には待避）
;	vi10:Ｓループカウンタ
;	vi11:Ｔループカウンタ（クリップ処理時には待避）
;	vi12:処理フラグ記憶用（クリップ処理時には待避？）
;	vi13:バッファ先頭アドレス
;	vi14:ループステップ値
;	vi15:リンクレジスタ＆クリップ処理チェックフラグ


; ================================================================
; 描画セットアップ処理
; ================================================================
;	upper		.					lower		.
StartCurveSurface:
	nop								xtop		vi13							; -,データアドレス取得
	nop								iaddiu		vi09,vi00,0						; バッファ切り替えクロック初期化
	nop								iaddiu		vi11,vi00,16					; 0(=1.0) <= vi11(t) < 16(=0.0)
	nop								ilw.y		vi12,SURF_FLAG(vi13)			; 
	nop								ilw.z		vi14,SURF_FLAG(vi13)			; 

.if 0
	nop								lq.xyzw		vf16,MAT_HERMITE+0(vi00)		; -,エルミート係数読み込み
	nop								lq.xyzw		vf17,MAT_HERMITE+1(vi00)		; -,エルミート係数読み込み
	nop								lq.xyzw		vf18,MAT_HERMITE+2(vi00)		; -,エルミート係数読み込み
	nop								lq.xyzw		vf19,MAT_HERMITE+3(vi00)		; -,エルミート係数読み込み

	; Ｔ０軸エルミート補間用マトリクス生成
	nop								lq.xyzw		vf04,VERT0(vi13)				; 
	nop								lq.xyzw		vf05,VERT2(vi13)				; 
	nop								lq.xyzw		vf06,VERT0_DT(vi13)				; 
	nop								lq.xyzw		vf07,VERT2_DT(vi13)				; 
	mulax.xyzw	ACC ,vf04,vf16		nop											; 
	madday.xyzw	ACC ,vf05,vf16		nop											; 
	maddaz.xyzw	ACC ,vf06,vf16		nop											; 
	maddw.xyzw	vf08,vf07,vf16		nop											; 
	mulax.xyzw	ACC ,vf04,vf17		nop											; 
	madday.xyzw	ACC ,vf05,vf17		nop											; 
	maddaz.xyzw	ACC ,vf06,vf17		nop											; 
	maddw.xyzw	vf09,vf07,vf17		nop											; 
	mulax.xyzw	ACC ,vf04,vf18		nop											; 
	madday.xyzw	ACC ,vf05,vf18		nop											; 
	maddaz.xyzw	ACC ,vf06,vf18		nop											; 
	maddw.xyzw	vf10,vf07,vf18		nop											; 
