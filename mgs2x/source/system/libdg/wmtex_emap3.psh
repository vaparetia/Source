; マルチテクスチャ用ピクセルシェーダー（グロスマップ付き環境マップ）
; 
;
; 2002.04.21  K.Takabe

ps.1.1

tex t1							; グロスマップテクスチャ
tex t2							; 環境マップテクスチャ

mul_x2 r0.a,   t1,     v0		; アルファはテクスチャ１のみを参照
add    r0.rgb, t1,     t2		; 加算
mul_x2 r0.rgb, r0,     v0		; 頂点カラーでテクスチャをモジュレート

; X-BOXオリジナル
;mul_x2 r0.a,   t1.a,   v0.a		; アルファはテクスチャ１のみを参照
;add    r0.rgb, t1.rgb, t2.rgb		; 加算
;mul_x2 r0.rgb, r0.rgb, v0.rgb		; 頂点カラーでテクスチャをモジュレート

