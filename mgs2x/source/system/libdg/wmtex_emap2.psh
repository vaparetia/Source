; マルチテクスチャ用ピクセルシェーダー（グロスマップ付き環境マップ）
; 
;
; 2002.04.21  K.Takabe

ps.1.1

tex t0							; グロスマップテクスチャ
tex t2							; 環境マップテクスチャ

mul_x2 r0.a,   t0,     v0		; アルファはテクスチャ０のみを参照
mul_x2 r0.rgb, t2,     v0		; 頂点カラーでベーステクスチャをモジュレート

; X-BOXオリジナル
;mul_x2 r0.a,   t0.a,   v0.a			; アルファはテクスチャ０のみを参照
;mul_x2 r0.rgb, t2.rgb, v0.rgb			; 頂点カラーでベーステクスチャをモジュレート

