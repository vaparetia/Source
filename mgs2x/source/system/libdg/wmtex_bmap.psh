; マルチテクスチャ用ピクセルシェーダー（グロスマップ付き環境マップ）
; 
;
; 2002.04.21  K.Takabe

ps.1.1

tex t0							; ベーステクスチャ
tex t1							; ハイトマップテクスチャ
tex t2							; ハイトマップテクスチャ

; カラーモジュレート式バンプマップ
mul_x2 r0.a,    v0,     t0		; アルファはテクスチャ０のみを参照
sub    r0.rgb,  t1,     t2		; エンボス用差分計算
mul_x2 r0.rgb,  r0,     v0		; 差分値をカラーでモジュレート
add    r0.rgb,  r0,     v0		; 差分から求めたカラーを本来のカラーに加える
mul_x2 r0.rgb,  r0,     t0		; ベースのモジュレート

;mul_x2 r0.a,    v0,     t0		; アルファはテクスチャ０のみを参照
;mul_x2 r0.rgb,  v0,     t2		; ベースのモジュレート


; X-BOXオリジナル
;mul_x2 r0.a,   v0.a,   t0.a		; アルファはテクスチャ０のみを参照
;sub    r0.rgb, t1.rgb, t2.rgb		; エンボス用差分計算
;mul_x2 r0.rgb, r0.rgb, v0.rgb		; 差分値をカラーでモジュレート
;add    r0.rgb, r0.rgb, v0			; 差分から求めたカラーを本来のカラーに加える
;mul_x2 r0.rgb, r0.rgb, t0.rgb		; ベースのモジュレート

