;
;	t0_clip.vu1
;	クリップ処理付き描画ＶＵ１プログラム
;
;	1999/07/07 K.Takabe
;	$Id: t0_clip.vu1,v 1.1.1.3 2002/11/19 11:42:26 Yoshizawa1 Exp $
;

;
;	ＶＵ１実験用オブジェクト表示マイクロプログラム
;	1999.4.*  K.Takabe
;
;	浮動小数点レジスタ使用状況
;	vf0:fix
;	vf1:定数読み込みベクトル
;	vf2:プリミティブ座標へのスケール値
;	vf3:プリミティブ座標へのオフセット
;	vf4~vf7:透視変換マトリクス
;	vf8~vf11:作業用マトリクス（ライトマトリクス等）
;	vf12:頂点読み込み
;	vf13:法線読み込み
;	vf14:ＵＶ値読み込み
;	vf15:リザーブ（頂点データ読み込み）
;	vf16~19:リザーブ（マトリクス）
;	vf20:透視変換直後座標
;	vf21:光源計算用ワーク
;	vf22~23:作業用
;	vf24~27:作業用
;	vf28:描画頂点データ
;	vf29:色データ
;	vf30:テクスチャ座標
;	vf31:リザーブ（変換後頂点データ）
;	
;	整数レジスタ使用状況
;	vi0:０固定
;	vi1:フラグ受け取り用
;	vi2:ＧＩＦキックアドレス
;	vi3:読み出し頂点処理アドレス
;	vi4:汎用
;	vi5:汎用
;	vi6:汎用
;	vi7:描画キックフラグの記憶
;	vi8:頂点数（＝ループカウンタ）
;	vi9:描画カウント（画面外に頂点があると３が代入されカウントが０になるとそのポリゴンは完全に画面内と判定できる）
;	vi10:Ｗの符号チェック用定数
;	vi11:Ｗの符号チェック結果格納用変数
;	vi12:リザーブ
;	vi13:バッファ先頭アドレス（インクリメントしてキックアドレスとして使用する）
;	vi14:スタック
;	vi15:リンクレジスタ
;	

; メモリ使用構成（ＶＵ１側から見るときには下位４ビットを無視すること）
; 0x0000~0x01ff	プログラムワーク
; 0x0200~0x03ff オブジェクトパラメータ設定（変換マトリクス等）
; 0x0400~0x21ff ダブルバッファ０
;  +0x0000_0x0eff 転送用バッファ
;  +0x0f00_0x1cff 読み込み用バッファ
; 0x2200~0x3fff ダブルバッファ１
;  +0x0000_0x0eff 転送用バッファ
;  +0x0f00_0x1cff 読み込み用バッファ
; 0x4000		最終アドレス
; 

; データフォーマット（案）
; + 0.x    頂点データ数
; + 0.y    データ開始位置（＝５）
; + 1.xyzw GIFtag（クリップポリゴン用プリミティブ設定ＧＩＦタグ）
; + 2.xyzw PRIM
; + 3.xyzw GIFtag（クリップポリゴン頂点用の転送ＧＩＦタグ）
; + 4.xyzw GIFtag（テクスチャパラメータ設定ＧＩＦタグ）
; + 5.xyzw CLAMP_1
; + 6.xyzw TEX0_1
; + 7.xyzw GIFtag（頂点の転送ＧＩＦタグ）
; + 8.xyzw 第１ＳＴＱ
; + 9.xyzw 第１ＲＧＢＡ
; +10.xyzw 第１ＸＹＺＦ
; +11.xyzw 第２ＳＴＱ
; +12.xyzw 第２ＲＧＢＡ
; .
; .
; .
; +f0.xyzw 第１ＶＵデータ
; +f1.xyzw 第１法線データ
; +f2.xyzw 第１頂点データ
; +f3.xyzw 第２ＶＵデータ
; +f4.xyzw 第１法線データ
; 
; 
; 
; 

; --------------------------------------
; 高速化した光源計算付き透視変換ルーチン
; --------------------------------------
;	upper		.					lower		.
ClipTransStart:
	; 変換初期化処理
	nop								lq.xyzw		vf1,FV_PRM2(vi0)	; 
	nop								lq.xyzw		vf7,M_PRS3(vi0)		; -,透視変換マトリクスロード
	nop								lq.xyzw		vf4,M_PRS0(vi0)		; -,透視変換マトリクスロード
	nop								lq.xyzw		vf5,M_PRS1(vi0)		; -,透視変換マトリクスロード
	nop								lq.xyzw		vf6,M_PRS2(vi0)		; -,透視変換マトリクスロード
	nop								lq.xyzw		vf2,FV_SCN(vi0)		; 
	nop								lq.xyzw		vf3,FV_OFT(vi0)		; 
	nop								lq.xyzw		vf1,FV_PRM(vi0)	; 
	; 変換処理開始
ClipTransNext:
	; バッファアドレス、ループ回数のセットとデータのプリロード処理
	nop								xtop		vi13				; 
	nop								ilw.y		vi2,0(vi13)			; 
	nop								lq.xyzw		vf12,0xf2(vi13)		; 第１頂点読み込み
	nop								lq.xyzw		vf13,0xf1(vi13)		; 第１法線（＆キック情報）読み込み
	nop								lq.xyzw		vf14,0xf0(vi13)		; 第１ＵＶ値読み込み
	nop								iaddiu		vi3,vi13,0xf3		; データ先読みアドレス設定
	itof0.xyzw	vf12,vf12			iadd		vi2,vi2,vi13		; データ書き戻しアドレス設定
	itof12.xyz	vf13,vf13			ilw.x		vi8,0(vi13)			; 処理頂点数の読み込み
	nop								iaddiu		vi13,vi13,4			; GIFキックアドレス設定
	nop								iaddiu		vi9,vi0,0			; 
	nop								iaddiu		vi10,vi0,0x0010		; 
	nop								fcset		0					; クリップチェック初期化

	; ディレイ処理の為の前処理
	mulax.xyzw	ACC,vf4,vf12		lq.xyzw		vf8,M_LIT0(vi0)		; 透視変換,光源処理
	madday.xyzw	ACC,vf5,vf12		lq.xyzw		vf9,M_LIT1(vi0)		; 透視変換,光源処理
	maddaz.xyzw	ACC,vf6,vf12		lq.xyzw		vf10,M_LIT2(vi0)	; 透視変換,光源処理
	maddw.xyzw	vf20,vf7,vf0		lq.xyzw		vf12,2(vi3)			; 透視変換,次ループ準備
	mulax.xyzw	ACC,vf8,vf13		mtir		vi7,vf13w			; 光源処理,描画キック
	madday.xyzw	ACC,vf9,vf13		lq.xyzw		vf8,M_COL0(vi0)		; 光源処理,光源処理
	maddz.xyzw	vf21,vf10,vf13		fsset		0					; 光源処理,クリップ
	subz.w		vf31,vf20,vf20		div			Q,vf0w,vf20w		; クリップ,透視変換
	addz.x		vf31,vf0,vf20		lq.xyzw		vf13,1(vi3)			; クリップ,次ループ準備
	itof0.xyzw	vf12,vf12			lq.xyzw		vf9,M_COL1(vi0)		; 次ループ準備,光源処理
	clipw.xyz	vf20xyz,vf20w		sq.xyzw		vf29,1-6(vi3)		; クリップ,クリップ用に保存
	nop								lq.xyzw		vf10,M_COL2(vi0)	; -,光源処理
	nop								fsand		vi11,0x80			; -,クリップ
	maxx.xyz	vf21,vf21,vf0		sq.xyzw		vf20,2-3(vi3)		; 光源処理,クリップ用に保存
	maxw.w		vf21,vf21,vf1		fcand		vi01,0x3f			; スペキュラー,クリップ(=waitq)
	itof12.xyz	vf13,vf13			nop								; 次ループ準備,-
	itof12.xyz	vf14,vf14			ior			vi1,vi11,vi1		; ＳＴ座標,クリップアウト
	mulq.xyz	vf28,vf20,Q			lq.xyzw		vf11,M_COL3(vi0)	; 透視変換,光源処理
	mulax.xyz	ACC,vf8,vf21		ibeq		vi1,vi0,label0		; 光源処理,クリップ
	madday.xyz	ACC,vf9,vf21		nop								; 光源処理,-
	; その頂点が画面外の場合の処理
	nop								iaddiu		vi9,vi0,3			; 
label0:
	maddaz.xyz	ACC,vf10,vf21		sq.xyz		vf14,0-3(vi3)		; 光源処理,クリップ用に保存
	maddw.xyz	vf21,vf11,vf0		iblez		vi9,label1			; 光源処理,
	nop								iaddi		vi9,vi9,-1			; 
	; 描画するポリゴンがクリップ面に掛かっている場合
	nop								ibltz		vi7,label1			;
	nop								iaddi		vi1,vi0,-2			; 
	nop								ior			vi7,vi7,vi1			; 
label1:
	mulq.xyz	vf30,vf14,Q			lq.xyzw		vf14,0(vi3)			; ＳＴ座標,次ループ準備
	mul.xyz		vf28,vf28,vf2		isw.w		vi7,0-3(vi3)		; 透視変換,クリップ用に保存
	subw.w		vf21,vf21,vf1		iaddiu		vi3,vi3,3			; スペキュラー,先読みアドレスインクリメント
	minix.xyz	vf29,vf21,vf1		isubiu		vi8,vi8,1			; 光源処理,カウンタのデクリメント
	nop								sq.xyz		vf30,0(vi2)			; -,ＳＴ座標
	add.xyz		vf28,vf28,vf3		isw.w		vi7,2(vi2)			; 透視変換,透視変換
	mulz.w		vf29,vf21,vf1		ibgtz		vi8,_ClipTransLoop		; スペキュラー,ループジャンプ
	nop								iaddiu		vi2,vi2,3			; 書き込みアドレスのインクリメント

_ClipTransLoop:
	; 頂点変換処理（途中で次の頂点の情報を読み込んでおく）
	mulax.xyzw	ACC,vf4,vf12		lq.xyzw		vf8,M_LIT0(vi0)		; 透視変換,光源処理
	madday.xyzw	ACC,vf5,vf12		lq.xyzw		vf9,M_LIT1(vi0)		; 透視変換,光源処理
	maddaz.xyzw	ACC,vf6,vf12		lq.xyzw		vf10,M_LIT2(vi0)	; 透視変換,光源処理
	maddw.xyzw	vf20,vf7,vf0		lq.xyzw		vf12,2(vi3)			; 透視変換,次ループ準備
	mulax.xyzw	ACC,vf8,vf13		mtir		vi7,vf13w			; 光源処理,描画キック
	madday.xyzw	ACC,vf9,vf13		lq.xyzw		vf8,M_COL0(vi0)		; 光源処理,光源処理
	maddz.xyzw	vf21,vf10,vf13		fsset		0					; 光源処理,クリップ
	subz.w		vf31,vf20,vf20		div			Q,vf0w,vf20w		; クリップ,透視変換
	addz.x		vf31,vf0,vf20		lq.xyzw		vf13,1(vi3)			; クリップ,次ループ準備
	itof0.xyzw	vf12,vf12			lq.xyzw		vf9,M_COL1(vi0)		; 次ループ準備,光源処理
	clipw.xyz	vf20xyz,vf20w		sq.xyzw		vf29,1-6(vi3)		; クリップ,クリップ用に保存
	ftoi4.xyz	vf28,vf28			lq.xyzw		vf10,M_COL2(vi0)	; (遅)透視変換,光源処理
	ftoi0.xyzw	vf29,vf29			fsand		vi11,0x80			; (遅)光源処理,クリップ
	maxx.xyz	vf21,vf21,vf0		sq.xyzw		vf20,2-3(vi3)		; 光源処理,クリップ用に保存
	maxw.w		vf21,vf21,vf1		fcand		vi01,0x3f			; スペキュラー,クリップ(=waitq)
	itof12.xyz	vf13,vf13			sq.xyz		vf28,2-3(vi2)		; 次ループ準備,(遅)透視変換
	itof12.xyz	vf14,vf14			ior			vi1,vi11,vi1		; ＳＴ座標,クリップアウト
	mulq.xyz	vf28,vf20,Q			lq.xyzw		vf11,M_COL3(vi0)	; 透視変換,光源処理
	mulax.xyz	ACC,vf8,vf21		ibeq		vi1,vi0,label2		; 光源処理,クリップ
	madday.xyz	ACC,vf9,vf21		sq.xyzw		vf29,1-3(vi2)		; 光源処理,(遅)光源処理
	; その頂点が画面外の場合の処理
	nop								iaddiu		vi9,vi0,3			; 
label2:
	maddaz.xyz	ACC,vf10,vf21		sq.xyz		vf14,0-3(vi3)		; 光源処理,クリップ用に保存
	maddw.xyz	vf21,vf11,vf0		iblez		vi9,label3			; 光源処理,
	nop								iaddi		vi9,vi9,-1			; 
	; 描画するポリゴンがクリップ面に掛かっている場合
	nop								ibltz		vi7,label3			; 描画ポリゴンかどうかのチェック
	nop								iaddi		vi1,vi0,-2			; フラグの上位２ビットを立てる
	nop								ior			vi7,vi7,vi1			; 
label3:
	mulq.xyz	vf30,vf14,Q			lq.xyzw		vf14,0(vi3)			; ＳＴ座標,次ループ準備
	mul.xyz		vf28,vf28,vf2		isw.w		vi7,0-3(vi3)		; 透視変換,クリップ用に保存
	subw.w		vf21,vf21,vf1		iaddiu		vi3,vi3,3			; スペキュラー,先読みアドレスインクリメント
	minix.xyz	vf29,vf21,vf1		isubiu		vi8,vi8,1			; 光源処理,カウンタのデクリメント
	nop								sq.xyz		vf30,0(vi2)			; -,ＳＴ座標
	add.xyz		vf28,vf28,vf3		isw.w		vi7,2(vi2)			; 透視変換,透視変換
	mulz.w		vf29,vf21,vf1		ibgtz		vi8,_ClipTransLoop	; スペキュラー,ループジャンプ
	nop								iaddiu		vi2,vi2,3			; 書き込みアドレスのインクリメント

	; 後始末
	ftoi4.xyz	vf28,vf28			nop								; 遅透視変換,-
	ftoi0.xyzw	vf29,vf29			sq.xyzw		vf29,1-6(vi3)		; 遅光源処理,クリップ用に保存
	nop								sq.xyz		vf28,2-3(vi2)		; 光源処理,遅透視変換
	nop								sq.xyzw		vf29,1-3(vi2)		; 光源処理,遅光源処理

	; 終端ダミーパケットをキックし待機
	nop								xgkick		vi13				; ＧＩＦへのキック
	nop								b			_ClipStart			; 
	nop								nop								; 


; --------------------------------------
; エンベロープ対応ルーチン
; --------------------------------------
;	upper		.					lower		.
ClipTransEnvelopeStart:
	; 変換初期化処理
	nop								lq.xyzw		vf7,M_PRS3(vi0)		; -,透視変換マトリクスロード
	nop								lq.xyzw		vf4,M_PRS0(vi0)		; -,透視変換マトリクスロード
	nop								lq.xyzw		vf5,M_PRS1(vi0)		; -,透視変換マトリクスロード
	nop								lq.xyzw		vf6,M_PRS2(vi0)		; -,透視変換マトリクスロード
	nop								lq.xyzw		vf2,FV_SCN(vi0)		; 
	nop								lq.xyzw		vf3,FV_OFT(vi0)		; 
	nop								lq.xyzw		vf1,FV_PRM(vi0)	; 
	; 変換処理開始
ClipTransEnvelopeNext:
	; バッファアドレス、ループ回数のセットとデータのプリロード処理
	nop								xtop		vi13				; 
	nop								ilw.y		vi2,0(vi13)			; 
	nop								lq.xyzw		vf12,0xf2(vi13)		; 第１頂点読み込み
	nop								lq.xyzw		vf13,0xf1(vi13)		; 第１法線（＆キック情報）読み込み
	nop								lq.xyzw		vf14,0xf0(vi13)		; 第１ＵＶ値読み込み
	nop								iaddiu		vi3,vi13,0xf3		; データ先読みアドレス設定
	nop								lq			vf16,M_SUP0(vi0)	; エンベロープ補正マトリクス読み込み
	nop								lq			vf17,M_SUP1(vi0)	; エンベロープ補正マトリクス読み込み
	nop								lq			vf18,M_SUP2(vi0)	; エンベロープ補正マトリクス読み込み
	nop								lq			vf19,M_SUP3(vi0)	; エンベロープ補正マトリクス読み込み
	itof0.xyz	vf12,vf12			iadd		vi2,vi2,vi13		; データ書き戻しアドレス設定
	itof12.xyz	vf13,vf13			ilw.x		vi8,0(vi13)			; 処理頂点数の読み込み
	itof12.w	vf31,vf12			iaddiu		vi13,vi13,4			; GIFキックアドレス設定
	nop								iaddiu		vi9,vi0,0			; 
	nop								iaddiu		vi10,vi0,0x0010		; 
	nop								fcset		0					; クリップチェック初期化

	; ディレイ処理の為の前処理
	mulax.xyz	ACC,vf16,vf12		nop								; trans_v,-
	madday.xyz	ACC,vf17,vf12		nop								; trans_v,-
	maddaz.xyz	ACC,vf18,vf12		nop								; trans_v,make v
	maddw.xyz	vf24,vf19,vf0		nop								; trans_v,-
	sub.w		vf24,vf0,vf31		nop								; make v&n,-
	mulax.xyz	ACC,vf16,vf13		nop								; trans_n,-
	madday.xyz	ACC,vf17,vf13		nop								; trans_n,-
	maddz.xyz	vf25,vf18,vf13		nop								; trans_n,-
	mulaw.xyz	ACC,vf12,vf31		nop								; make v,-
	maddw.xyz	vf12,vf24,vf24		nop								; make v,-
	mulaw.xyz	ACC,vf13,vf31		nop								; make n,-
	maddw.xyz	vf13,vf25,vf24		nop								; make n,-

	mulax.xyzw	ACC,vf4,vf12		lq.xyzw		vf8,M_LIT0(vi0)		; 透視変換,光源処理
	madday.xyzw	ACC,vf5,vf12		lq.xyzw		vf9,M_LIT1(vi0)		; 透視変換,光源処理
	maddaz.xyzw	ACC,vf6,vf12		lq.xyzw		vf10,M_LIT2(vi0)	; 透視変換,光源処理
	maddw.xyzw	vf20,vf7,vf0		lq.xyzw		vf12,2(vi3)			; 透視変換,次ループ準備
	mulax.xyzw	ACC,vf8,vf13		mtir		vi7,vf13w			; 光源処理,描画キック
	madday.xyzw	ACC,vf9,vf13		lq.xyzw		vf8,M_COL0(vi0)		; 光源処理,光源処理
	maddz.xyzw	vf21,vf10,vf13		fsset		0					; 光源処理,クリップ
	subz.w		vf31,vf20,vf20		div			Q,vf0w,vf20w		; クリップ,透視変換
	addz.x		vf31,vf0,vf20		lq.xyzw		vf13,1(vi3)			; クリップ,次ループ準備
	itof0.xyz	vf12,vf12			lq.xyzw		vf9,M_COL1(vi0)		; 次ループ準備,光源処理
	clipw.xyz	vf20xyz,vf20w		sq.xyzw		vf29,1-6(vi3)		; クリップ,クリップ用に保存
	nop								lq.xyzw		vf10,M_COL2(vi0)	; -,光源処理
	nop								fsand		vi11,0x80			; -,クリップ
	maxx.xyz	vf21,vf21,vf0		sq.xyzw		vf20,2-3(vi3)		; 光源処理,クリップ用に保存
	maxw.w		vf21,vf21,vf1		fcand		vi01,0x3f			; スペキュラー,クリップ(=waitq)
	itof12.xyz	vf13,vf13			nop								; 次ループ準備,-
	itof12.xyz	vf14,vf14			ior			vi1,vi11,vi1		; ＳＴ座標,クリップアウト
	mulq.xyz	vf28,vf20,Q			lq.xyzw		vf11,M_COL3(vi0)	; 透視変換,光源処理
	mulax.xyz	ACC,vf8,vf21		ibeq		vi1,vi0,label0_en	; 光源処理,クリップ
	madday.xyz	ACC,vf9,vf21		nop								; 光源処理,-
	; その頂点が画面外の場合の処理
	nop								iaddiu		vi9,vi0,3			; 
label0_en:
	maddaz.xyz	ACC,vf10,vf21		sq.xyz		vf14,0-3(vi3)		; 光源処理,クリップ用に保存
	maddw.xyz	vf21,vf11,vf0		iblez		vi9,label1_en		; 光源処理,
	nop								iaddi		vi9,vi9,-1			; 
	; 描画するポリゴンがクリップ面に掛かっている場合
	nop								ibltz		vi7,label1_en		;
	nop								iaddi		vi1,vi0,-2			; 
	nop								ior			vi7,vi7,vi1			; 
label1_en:
	mulq.xyz	vf30,vf14,Q			lq.xyzw		vf14,0(vi3)			; ＳＴ座標,次ループ準備
	mul.xyz		vf28,vf28,vf2		isw.w		vi7,0-3(vi3)		; 透視変換,クリップ用に保存
	subw.w		vf21,vf21,vf1		iaddiu		vi3,vi3,3			; スペキュラー,先読みアドレスインクリメント
	minix.xyz	vf29,vf21,vf1		isubiu		vi8,vi8,1			; 光源処理,カウンタのデクリメント
	itof12.w	vf31,vf12			sq.xyz		vf30,0(vi2)			; 次ループ準備,ＳＴ座標
	add.xyz		vf28,vf28,vf3		isw.w		vi7,2(vi2)			; 透視変換,透視変換
	mulz.w		vf29,vf21,vf1		ibgtz		vi8,_ClipTransEnvelopeLoop		; スペキュラー,ループジャンプ
	mulax.xyz	ACC,vf16,vf12		iaddiu		vi2,vi2,3			; 次ループ準備,書き込みアドレスのインクリメント

_ClipTransEnvelopeLoop:
	; 頂点変換処理（途中で次の頂点の情報を読み込んでおく）
	mulax.xyz	ACC,vf16,vf12		nop								; trans_v,-
	madday.xyz	ACC,vf17,vf12		nop								; trans_v,-
	maddaz.xyz	ACC,vf18,vf12		nop								; trans_v,make v
	maddw.xyz	vf24,vf19,vf0		nop								; trans_v,-
	sub.w		vf24,vf0,vf31		nop								; make v&n,-
	mulax.xyz	ACC,vf16,vf13		nop								; trans_n,-
	madday.xyz	ACC,vf17,vf13		nop								; trans_n,-
	maddz.xyz	vf25,vf18,vf13		nop								; trans_n,-
	mulaw.xyz	ACC,vf12,vf31		nop								; make v,-
	maddw.xyz	vf12,vf24,vf24		nop								; make v,-
	mulaw.xyz	ACC,vf13,vf31		nop								; make n,-
	maddw.xyz	vf13,vf25,vf24		nop								; make n,-

	mulax.xyzw	ACC,vf4,vf12		lq.xyzw		vf8,M_LIT0(vi0)		; 透視変換,光源処理
	madday.xyzw	ACC,vf5,vf12		lq.xyzw		vf9,M_LIT1(vi0)		; 透視変換,光源処理
	maddaz.xyzw	ACC,vf6,vf12		lq.xyzw		vf10,M_LIT2(vi0)	; 透視変換,光源処理
	maddw.xyzw	vf20,vf7,vf0		lq.xyzw		vf12,2(vi3)			; 透視変換,次ループ準備
	mulax.xyzw	ACC,vf8,vf13		mtir		vi7,vf13w			; 光源処理,描画キック
	madday.xyzw	ACC,vf9,vf13		lq.xyzw		vf8,M_COL0(vi0)		; 光源処理,光源処理
	maddz.xyzw	vf21,vf10,vf13		fsset		0					; 光源処理,クリップ
	subz.w		vf31,vf20,vf20		div			Q,vf0w,vf20w		; クリップ,透視変換
	addz.x		vf31,vf0,vf20		lq.xyzw		vf13,1(vi3)			; クリップ,次ループ準備
	itof0.xyz	vf12,vf12			lq.xyzw		vf9,M_COL1(vi0)		; 次ループ準備,光源処理
	clipw.xyz	vf20xyz,vf20w		sq.xyzw		vf29,1-6(vi3)		; クリップ,クリップ用に保存
	ftoi4.xyz	vf28,vf28			lq.xyzw		vf10,M_COL2(vi0)	; (遅)透視変換,光源処理
	ftoi0.xyzw	vf29,vf29			fsand		vi11,0x80			; (遅)光源処理,クリップ
	maxx.xyz	vf21,vf21,vf0		sq.xyzw		vf20,2-3(vi3)		; 光源処理,クリップ用に保存
	maxw.w		vf21,vf21,vf1		fcand		vi01,0x3f			; スペキュラー,クリップ(=waitq)
	itof12.xyz	vf13,vf13			sq.xyz		vf28,2-3(vi2)		; 次ループ準備,(遅)透視変換
	itof12.xyz	vf14,vf14			ior			vi1,vi11,vi1		; ＳＴ座標,クリップアウト
	mulq.xyz	vf28,vf20,Q			lq.xyzw		vf11,M_COL3(vi0)	; 透視変換,光源処理
	mulax.xyz	ACC,vf8,vf21		ibeq		vi1,vi0,label2_en	; 光源処理,クリップ
	madday.xyz	ACC,vf9,vf21		sq.xyzw		vf29,1-3(vi2)		; 光源処理,(遅)光源処理
	; その頂点が画面外の場合の処理
	nop								iaddiu		vi9,vi0,3			; 
label2_en:
	maddaz.xyz	ACC,vf10,vf21		sq.xyz		vf14,0-3(vi3)		; 光源処理,クリップ用に保存
	maddw.xyz	vf21,vf11,vf0		iblez		vi9,label3_en		; 光源処理,
	nop								iaddi		vi9,vi9,-1			; 
	; 描画するポリゴンがクリップ面に掛かっている場合
	nop								ibltz		vi7,label3_en		;
	nop								iaddi		vi1,vi0,-2			; 
	nop								ior			vi7,vi7,vi1			; 
label3_en:
	mulq.xyz	vf30,vf14,Q			lq.xyzw		vf14,0(vi3)			; ＳＴ座標,次ループ準備
	mul.xyz		vf28,vf28,vf2		isw.w		vi7,0-3(vi3)		; 透視変換,クリップ用に保存
	subw.w		vf21,vf21,vf1		iaddiu		vi3,vi3,3			; スペキュラー,先読みアドレスインクリメント
	minix.xyz	vf29,vf21,vf1		isubiu		vi8,vi8,1			; 光源処理,カウンタのデクリメント
	itof12.w	vf31,vf12			sq.xyz		vf30,0(vi2)			; -,ＳＴ座標
	add.xyz		vf28,vf28,vf3		isw.w		vi7,2(vi2)			; 透視変換,透視変換
	mulz.w		vf29,vf21,vf1		ibgtz		vi8,_ClipTransEnvelopeLoop	; スペキュラー,ループジャンプ
	mulax.xyz	ACC,vf16,vf12		iaddiu		vi2,vi2,3			; 書き込みアドレスのインクリメント

	; 後始末
	ftoi4.xyz	vf28,vf28			nop								; 遅透視変換,-
	ftoi0.xyzw	vf29,vf29			sq.xyzw		vf29,1-6(vi3)		; 遅光源処理,クリップ用に保存
	nop								sq.xyz		vf28,2-3(vi2)		; 光源処理,遅透視変換
	nop								sq.xyzw		vf29,1-3(vi2)		; 光源処理,遅光源処理

	; 終端ダミーパケットをキックし待機
	nop								xgkick		vi13				; ＧＩＦへのキック
	nop								b			_ClipStart			; 
	nop								nop								; 


; --------------------------------------
; プリシェード用透視変換ルーチン
; --------------------------------------
;	upper		.					lower		.
ClipPreshadeTransStart:
	; 変換初期化処理
	nop								lq.xyzw		vf1,FV_PRM2(vi0)	; 
	nop								lq.xyzw		vf7,M_PRS3(vi0)		; -,透視変換マトリクスロード
	nop								lq.xyzw		vf4,M_PRS0(vi0)		; -,透視変換マトリクスロード
	nop								lq.xyzw		vf5,M_PRS1(vi0)		; -,透視変換マトリクスロード
	nop								lq.xyzw		vf6,M_PRS2(vi0)		; -,透視変換マトリクスロード
	nop								lq.xyzw		vf2,FV_SCN(vi0)		; 
	nop								lq.xyzw		vf3,FV_OFT(vi0)		; 
	nop								lq.xyzw		vf1,FV_PRM(vi0)	; 
	; 変換処理開始
ClipPreshadeTransNext:
	; バッファアドレス、ループ回数のセットとデータのプリロード処理
	nop								xtop		vi13				; 
	nop								ilw.y		vi2,0(vi13)			; 
	nop								lq.xyzw		vf12,0xf2(vi13)		; 第１頂点読み込み
	nop								lq.xyzw		vf13,0xf1(vi13)		; 第１法線（＆キック情報）読み込み
	nop								lq.xyzw		vf14,0xf0(vi13)		; 第１ＵＶ値読み込み
	nop								iaddiu		vi3,vi13,0xf3		; データ先読みアドレス設定
	itof0.xyzw	vf12,vf12			iadd		vi2,vi2,vi13		; データ書き戻しアドレス設定
	itof0.xyz	vf21,vf13			ilw.x		vi8,0(vi13)			; 処理頂点数の読み込み
	mulx.w		vf21,vf21,vf0		iaddiu		vi13,vi13,4			; GIFキックアドレス設定
	nop								iaddiu		vi9,vi0,0			; 
	nop								iaddiu		vi10,vi0,0x0010		; 
	nop								fcset		0					; クリップチェック初期化

	; ディレイ処理の為の前処理
	; 頂点変換処理（途中で次の頂点の情報を読み込んでおく）
	mulax.xyzw	ACC,vf4,vf12		mtir		vi7,vf13w			; 透視変換,描画キック
	madday.xyzw	ACC,vf5,vf12		nop								; 透視変換,(遅)ＳＴ座標
	maddaz.xyzw	ACC,vf6,vf12		nop								; 透視変換,-
	maddw.xyzw	vf20,vf7,vf0		lq.xyzw		vf12,2(vi3)			; 透視変換,次ループ準備
	ftoi0.xyzw	vf29,vf21			sq.xyzw		vf21,1-3(vi3)		; 光源処理,クリップ用に保存
	ftoi4.xyz	vf28,vf28			lq.xyzw		vf13,1(vi3)			; (遅)透視変換,次ループ準備
	itof12.xyz	vf14,vf14			fsset		0					; ＳＴ座標,クリップ
	subz.w		vf31,vf20,vf20		div			Q,vf0w,vf20w		; クリップ,透視変換
	addz.x		vf31,vf0,vf20		sq.xyzw		vf20,2-3(vi3)		; クリップ,クリップ用に保存
	clipw.xyz	vf20xyz,vf20w		sq.xyzw		vf29,1(vi2)			; クリップ,光源処理
	itof0.xyzw	vf12,vf12			nop								; 次ループ準備,(遅)透視変換
	itof0.xyz	vf21,vf13			sq.xyz		vf14,0-3(vi3)		; 次ループ準備,クリップ用に保存
	nop								fsand		vi11,0x80			; ＳＴ座標,クリップ
	nop								fcand		vi01,0x3f			; -,クリップ
	mulq.xyz	vf28,vf20,Q			ior			vi1,vi11,vi1		; 透視変換,クリップアウト(=waitq)
	mulq.xyz	vf30,vf14,Q			lq.xyzw		vf14,0(vi3)			; ＳＴ座標,次ループ準備
	nop								ibeq		vi1,vi0,label0_ps	; -,クリップ
	nop								isubiu		vi8,vi8,1			; -,カウンタのデクリメント
	; その頂点が画面外の場合の処理
	nop								iaddiu		vi9,vi0,3			; ポリゴンクリップ有効カウンタ設定
	nop								nop								; -,
label0_ps:
	nop								iblez		vi9,label1_ps		; -,クリップフラグチェック
	mul.xyz		vf28,vf28,vf2		iaddi		vi9,vi9,-1			; 透視変換,
	; 描画するポリゴンがクリップ面に掛かっている場合
	nop								ibltz		vi7,label1_ps		; 描画ポリゴンかどうかのチェック
	nop								iaddi		vi1,vi0,-2			; フラグの上位２ビットを立てる
	nop								ior			vi7,vi7,vi1			; 
label1_ps:
	nop								isw.w		vi7,0-3(vi3)		; -,クリップ用に保存
	nop								isw.w		vi7,2(vi2)			; -,透視変換
	nop								iaddiu		vi3,vi3,3			; -,先読みアドレスインクリメント
	add.xyz		vf28,vf28,vf3		ibgtz		vi8,_ClipPreshadeTransLoop	; 透視変換,ループジャンプ
	nop								iaddiu		vi2,vi2,3			; 書き込みアドレスのインクリメント

_ClipPreshadeTransLoop:
	; 頂点変換処理（途中で次の頂点の情報を読み込んでおく）
	mulax.xyzw	ACC,vf4,vf12		mtir		vi7,vf13w			; 透視変換,描画キック
	madday.xyzw	ACC,vf5,vf12		sq.xyz		vf30,0-3(vi2)		; 透視変換,(遅)ＳＴ座標
	maddaz.xyzw	ACC,vf6,vf12		nop								; 透視変換,-
	maddw.xyzw	vf20,vf7,vf0		lq.xyzw		vf12,2(vi3)			; 透視変換,次ループ準備
	ftoi0.xyzw	vf29,vf21			sq.xyzw		vf21,1-3(vi3)		; 光源処理,クリップ用に保存
	ftoi4.xyz	vf28,vf28			lq.xyzw		vf13,1(vi3)			; (遅)透視変換,次ループ準備
	itof12.xyz	vf14,vf14			fsset		0					; ＳＴ座標,クリップ
	subz.w		vf31,vf20,vf20		div			Q,vf0w,vf20w		; クリップ,透視変換
	addz.x		vf31,vf0,vf20		sq.xyzw		vf20,2-3(vi3)		; クリップ,クリップ用に保存
	clipw.xyz	vf20xyz,vf20w		sq.xyzw		vf29,1(vi2)			; クリップ,光源処理
	itof0.xyzw	vf12,vf12			sq.xyz		vf28,2-3(vi2)		; 次ループ準備,(遅)透視変換
	itof0.xyz	vf21,vf13			sq.xyz		vf14,0-3(vi3)		; 次ループ準備,クリップ用に保存
	nop								fsand		vi11,0x80			; ＳＴ座標,クリップ
	nop								fcand		vi01,0x3f			; -,クリップ
	mulq.xyz	vf28,vf20,Q			ior			vi1,vi11,vi1		; 透視変換,クリップアウト(=waitq)
	mulq.xyz	vf30,vf14,Q			lq.xyzw		vf14,0(vi3)			; ＳＴ座標,次ループ準備
	nop								ibeq		vi1,vi0,label2_ps	; -,クリップ
	nop								isubiu		vi8,vi8,1			; -,カウンタのデクリメント
	; その頂点が画面外の場合の処理
	nop								iaddiu		vi9,vi0,3			; ポリゴンクリップ有効カウンタ設定
	nop								nop								; -,
label2_ps:
	nop								iblez		vi9,label3_ps		; -,クリップフラグチェック
	mul.xyz		vf28,vf28,vf2		iaddi		vi9,vi9,-1			; 透視変換,
	; 描画するポリゴンがクリップ面に掛かっている場合
	nop								ibltz		vi7,label3_ps		; 描画ポリゴンかどうかのチェック
	nop								iaddi		vi1,vi0,-2			; フラグの上位２ビットを立てる
	nop								ior			vi7,vi7,vi1			; 
label3_ps:
	nop								isw.w		vi7,0-3(vi3)		; -,クリップ用に保存
	nop								isw.w		vi7,2(vi2)			; -,透視変換
	nop								iaddiu		vi3,vi3,3			; -,先読みアドレスインクリメント
	add.xyz		vf28,vf28,vf3		ibgtz		vi8,_ClipPreshadeTransLoop	; 透視変換,ループジャンプ
	nop								iaddiu		vi2,vi2,3			; 書き込みアドレスのインクリメント

	; 後始末
	ftoi4.xyz	vf28,vf28			sq.xyz		vf30,0-3(vi2)		; (遅)透視変換,(遅)ＳＴ座標
	nop								sq.xyz		vf28,2-3(vi2)		; 光源処理,遅透視変換

	; 終端ダミーパケットをキックし待機
	nop								xgkick		vi13				; ＧＩＦへのキック
	nop								b			_ClipStart			; 
	nop								nop								; 






;	浮動小数点レジスタ使用状況
;	vf0:fix
;	vf1:定数読み込みベクトル
;	vf2:プリミティブ座標へのスケール値
;	vf3:プリミティブ座標へのオフセット
;	vf4~vf7:透視変換マトリクス
;	vf8~vf11:作業用マトリクス（ライトマトリクス等）
;	vf12:頂点読み込み
;	vf13:法線読み込み
;	vf14:ＵＶ値読み込み
;	vf15:リザーブ（頂点データ読み込み）
;	vf16~19:リザーブ（マトリクス）
;	vf20:透視変換直後座標
;	vf21:光源計算用ワーク
;	vf22~23:作業用
;	vf24~27:作業用
;	vf28:描画頂点データ
;	vf29:色データ
;	vf30:テクスチャ座標
;	vf31:リザーブ（変換後頂点データ）
;	
;	整数レジスタ使用状況
;	vi0:０固定
;	vi1:フラグ受け取り用
;	vi2:頂点格納アドレス（６回のクリップ処理毎にアドレスを−１していき、最終的にＧＩＦタグの直後になる）
;	vi3:読み出し頂点処理アドレス
;	vi4:クリップ処理頂点取り出しアドレス
;	vi5:クリップ頂点処理カウンタ
;	vi6:汎用
;	vi7:描画キックフラグの記憶
;	vi8:頂点数（＝ループカウンタ）
;	vi9:リザーブ
;	vi10:チェック用定数
;	vi11:クリップ処理頂点数
;	vi12:ＧＩＦキックアドレス
;	vi13:ダブルバッファ先頭アドレス
;	vi14:スタック
;	vi15:リンクレジスタ

_ClipStart:
	; クリップされたポリゴンを探し出し、切断処理を行って表示する
	nop								xtop		vi13				; 
	nop								iaddiu		vi3,vi13,0xf6		; データ先読みアドレス設定
	nop								lq.xyzw		vf14,0xf6(vi13)		; 第３法線（＆キック情報）読み込み
	nop								ilw.x		vi8,0(vi13)			; 処理頂点数の読み込み
	nop								iaddiu		vi10,vi0,0x4000		; 
	nop								mtir		vi7,vf14w			; 
	nop								isubiu		vi8,vi8,2			; 

ClipLoop:
	nop								nop								; 
	nop								nop								; 
	nop								nop								; 
	nop								iand		vi1,vi7,vi10		; 
	nop								nop								; 
	nop								ibeq		vi1,vi0,label4		; 
	nop								iaddiu		vi3,vi3,3			; 

	; クリップポリゴン発見時
	mulx.xyzw	vf31,vf0,vf0		iaddiu		vi12,vi13,1			; 
	nop								iaddiu		vi11,vi0,3			; 処理頂点数設定
	nop								xgkick		vi12				; 
	nop								iaddiu		vi12,vi12,3+6*3		; 頂点格納アドレス設定（チェック数分ずらす）
	nop								lq.xyzw		vf8,2-9(vi3)		; 頂点データを作業用エリアにコピーする
	nop								lq.xyzw		vf11,1-9(vi3)		; 頂点はvf8,vf9,vf10に入れチェック用に残しておく
	nop								lq.xyzw		vf14,0-9(vi3)		; 
	nop								lq.xyzw		vf9,2-6(vi3)		; 
	nop								lq.xyzw		vf12,1-6(vi3)		; 
	mulw.xyzw	vf11,vf11,vf8		lq.xyzw		vf15,0-6(vi3)		; Ｗを掛けて描画前にＷで割って戻す,-
	nop								lq.xyzw		vf10,2-3(vi3)		; 
	nop								lq.xyzw		vf13,1-3(vi3)		; 
	mulw.xyzw	vf12,vf12,vf9		lq.xyzw		vf16,0-3(vi3)		; Ｗを掛けて描画前にＷで割って戻す,-
	nop								sq.xyzw		vf8,2+0(vi12)		; 
	nop								sq.xyzw		vf11,1+0(vi12)		; 
	mulw.xyzw	vf13,vf13,vf10		sq.xyzw		vf14,0+0(vi12)		; Ｗを掛けて描画前にＷで割って戻す,-
	clipw.xyz	vf8xyz,vf31w		sq.xyzw		vf9,2+3(vi12)		; 
	clipw.xyz	vf9xyz,vf31w		sq.xyzw		vf12,1+3(vi12)		; 
	clipw.xyz	vf10xyz,vf31w		sq.xyzw		vf15,0+3(vi12)		; 
	nop								sq.xyzw		vf10,2+6(vi12)		; 
	nop								sq.xyzw		vf13,1+6(vi12)		; 
	nop								fsset		0x0					;
	subz.w		vf31,vf8,vf8		sq.xyzw		vf16,0+6(vi12)		; 

	subz.w		vf31,vf9,vf9		fcand		vi1,0x020820		; 
	subz.w		vf31,vf10,vf10		ibeq		vi1,vi0,_clip_1		; 
	nop								nop								; 
	nop								bal			vi15,ZClip_z		; Ｚ＝０面によるクリップ
	nop								nop								; 
_clip_1:
	nop								fsset		0x0					; 
	subx.w		vf31,vf8,vf8		nop								; 
	subx.w		vf31,vf9,vf9		nop								; 
	subx.w		vf31,vf10,vf10		fsand		vi1,0x80			; 
	nop								ibeq		vi1,vi0,_clip_6		; 
	nop								nop								; 
	nop								bal			vi15,ZClip_p		; Ｚ＝Ｗ面によるクリップ
	nop								nop								; 
_clip_6:
	nop								fsset		0x0					;
	addx.w		vf31,vf8,vf8		nop								; 
	addx.w		vf31,vf9,vf9		fsand		vi1,0x80			; 
	addx.w		vf31,vf10,vf10		ibeq		vi1,vi0,_clip_2		; 
	nop								nop								; 
	nop								bal			vi15,XClip_p		; Ｘ＝Ｗ面によるクリップ
	nop								nop								; 
_clip_2:
	nop								fsset		0x0					;
	suby.w		vf31,vf8,vf8		nop								; 
	suby.w		vf31,vf9,vf9		nop								; 
	suby.w		vf31,vf10,vf10		fsand		vi1,0x80			; 
	nop								ibeq		vi1,vi0,_clip_3		; 
	nop								nop								; 
	nop								bal			vi15,XClip_m		; Ｘ＝−Ｗ面によるクリップ
	nop								nop								; 
_clip_3:
	nop								fsset		0x0					; 
	addy.w		vf31,vf8,vf8		nop								; 
	addy.w		vf31,vf9,vf9		nop								; 
	addy.w		vf31,vf10,vf10		fsand		vi1,0x80			; 
	nop								ibeq		vi1,vi0,_clip_4		; 
	nop								nop								; 
	nop								bal			vi15,YClip_p		; Ｙ＝Ｗ面によるクリップ
	nop								nop								; 
_clip_4:
	nop								fsset		0x0					; 
	nop								nop								; 
	nop								nop								; 
	nop								fsand		vi1,0x80			; 
	nop								ibeq		vi1,vi0,_clip_5		; 
	nop								nop								; 
	nop								bal			vi15,YClip_m		; Ｙ＝−Ｗ面によるクリップ
	nop								nop								; 
_clip_5:

	; クリップ後に頂点が存在すれば描画を行う
	nop								isubiu		vi1,vi11,3			; 
	nop								lq.xyzw		vf11,3(vi13)		; ＧＩＦタグ読み込み
	nop								ibltz		vi1,label4			; 
	nop								iadd		vi1,vi10,vi10		; 
	nop								ior			vi1,vi1,vi11		; 
	nop								isubiu		vi12,vi12,1			; 
	nop								sq.yzw		vf11,0(vi12)		; 
	nop								isw.x		vi1,0(vi12)			; 
	nop								iaddiu		vi2,vi12,1			; 
	; 座標変換処理他
_clip_0:
	mulx.xyzw	vf27,vf27,vf0		lq.xyzw		vf20,2(vi2)			; 
	nop								lq.xyzw		vf21,1(vi2)			; 
	nop								lq.xyzw		vf22,0(vi2)			; 
	;nop								nop								; 
	nop								div			Q,vf0w,vf20w		; 
	nop								loi			0.5					; ＲＧＢＡ四捨五入用定数
	addi.xyzw	vf27,vf27,I			iaddiu		vi6,vi0,0x0fff		; 
	mulq.xyzw	vf20,vf20,Q			waitq							; 
	mulq.xyz	vf22,vf22,Q			iaddiu		vi2,vi2,3			; 
	mulaq.xyzw	ACC,vf21,Q			nop								; ＲＧＢＡ値補正
	maddw.xyzw	vf21,vf27,vf0		nop								; ＲＧＢＡ値補正
	mul.xyz		vf20,vf20,vf2		isubiu		vi11,vi11,1			; 
	add.xyz		vf20,vf20,vf3		nop								; 
	nop								nop								; 
	ftoi0.xyzw	vf21,vf21			nop								; 
	ftoi4.xyz	vf20,vf20			isw.w		vi6,2-3(vi2)		; 
	nop								sq.xyz		vf22,0-3(vi2)		; 
	nop								sq.xyzw		vf21,1-3(vi2)		; 
	nop								sq.xyz		vf20,2-3(vi2)		; 
.if 0 ;クリップポリゴン用プリミティブの属性をフラットシェードにして以下のデバッグルーチンを使用
 nop iadd vi1,vi11,vi11
 nop iadd vi1,vi1,vi1
 nop iadd vi1,vi1,vi1
 nop iadd vi1,vi1,vi1
 nop iadd vi1,vi1,vi1
 nop isw.x vi1,1-3(vi2)
 nop iadd vi1,vi1,vi1
 nop isw.y vi1,1-3(vi2)
 nop iadd vi1,vi1,vi1
 nop isw.z vi1,1-3(vi2)
.endif
	nop								ibgtz		vi11,_clip_0		; 
	nop								nop								; 
	nop								xgkick		vi12				; 
	
label4:
	nop								lq.xyzw		vf14,0(vi3)			; 
	nop								isubiu		vi8,vi8,1			; 
	nop								nop								; 
	nop								ibgtz		vi8,ClipLoop		; 
	nop								mtir		vi7,vf14w			; 

	nop[e]							b			ClipTransNext		; ジャンプ＆停止
	nop								nop								; 

	; 以下のクリップルーチン共通レジスタ割り当て
	; vf1,vf2,vf3:定数が入っているので破壊してはいけない
	; vf4,vf5,vf6,vf7:透視変換マトリクスが入っているので破壊してはいけない
	; vf8,vf9,vf10,vf11:クリップチェックのベースとなる４頂点が入っているので破壊してはいけない
	; vi3,vi8,vi10,vi13:破壊してはいけないので使用不可
	; vi11:現在の頂点数：終了時に処理により変化
	; vi12:現在処理中の頂点列先頭ポインタ：終了時にアドレス−３（＝１頂点分デクリメント）
	; 内部使用レジスタ
	; vi2,vi4,vi5,vi6
	; vf12,vf13,vf14,vf16,vf17,vf18,
	; vf20,vf21,vf22,vf23,vf24,vf25,vf26,vf27
	; ※終了時にはvf8,vf9,vf10のクリップ処理を終えていなければならないので注意

	; Ｘ＝Ｗ面に対するクリップ処理
XClip_p:
	nop								iaddiu		vi4,vi12,0			; 処理用の頂点読み込みアドレス設定
	nop								iadd		vi6,vi4,vi11		; 計算用最終頂点格納アドレス計算
	nop								iadd		vi6,vi6,vi11		; 計算用最終頂点格納アドレス計算
	nop								iadd		vi6,vi6,vi11		; 計算用最終頂点格納アドレス計算
	nop								isubiu		vi12,vi12,3			; 頂点アドレスのデクリメント
	nop								iaddiu		vi2,vi12,0			; 処理用の頂点格納アドレス設定
	nop								isubiu		vi5,vi11,2			; ループ用カウンタ設定
	nop								iaddiu		vi11,vi0,0			; 新規の頂点数をカウントする為にクリア
	nop								lq.xyzw		vf12,2(vi4)			; 
	nop								lq.xyzw		vf13,1(vi4)			; 
	nop								lq.xyz		vf14,0(vi4)			; 
	nop								iaddiu		vi4,vi4,3			; 
	clipw.xyz	vf12xyz,vf12w		sq.xyzw		vf12,2(vi6)			; 計算用最終頂点の生成
	subx.w		vf20,vf12,vf12		sq.xyzw		vf13,1(vi6)			; 計算用最終頂点の生成
	nop								sq.xyz		vf14,0(vi6)			; 計算用最終頂点の生成
_clip0_0:
	nop								lq.xyzw		vf16,2(vi4)			; ＜非共通部分＞
	nop								lq.xyzw		vf17,1(vi4)			; 
	nop								lq.xyz		vf18,0(vi4)			; 
	;nop							nop								; 
	clipw.xyz	vf16xyz,vf16w		iaddiu		vi4,vi4,3			; 
	subx.w		vf21,vf16,vf16		sq.xyzw		vf12,2(vi2)			; ＜非共通部分＞
	nop								sq.xyzw		vf13,1(vi2)			; 先頭頂点がクリップ内のときには先にストアしておく
	nop								sq.xyz		vf14,0(vi2)			; 
	; クリップ判定
	mulw.xyzw	vf23,vf16,vf20		fcor		vi1,~0x041			; ＜非共通部分＞
	mulw.yzw	vf22,vf12,vf21		ibne		vi1,vi0,_clip0_2	; ２点とも領域外
	sub.w		vf14,vf21,vf20		fcand		vi1,0x041			; カラー補間用先行計算,＜非共通部分＞
	mulw.xyzw	vf24,vf13,vf21		ibeq		vi1,vi0,_clip0_1	; ２点とも領域内
	; 切断処理
	mulw.xyzw	vf25,vf17,vf20		fcand		vi1,0x040			; ＜非共通部分＞
	mulw.xyz	vf26,vf14,vf21		ibne		vi1,vi0,_clip0_3	; 
	mulw.xyz	vf27,vf18,vf20		div			Q,vf0w,vf14w		; 
	nop								iaddiu		vi2,vi2,3			; 
	nop								iaddiu		vi11,vi11,1			; 
_clip0_3:
	mulx.x		vf12,vf12,vf0		nop								; 
	sub.yzw		vf12,vf22,vf23		nop								; 座標
	sub.xyzw	vf13,vf24,vf25		nop								; 色
	sub.xyz		vf14,vf26,vf27		nop								; ＳＴ
	addw.x		vf12,vf12,vf12		nop								; 
	mulq.xyzw	vf13,vf13,Q			waitq							; 
	mulq.xyzw	vf14,vf14,Q			nop								; 
	mulq.xyzw	vf12,vf12,Q			nop								; 
_clip0_1:
	nop								iaddiu		vi11,vi11,1			; 
	nop								sq.xyzw		vf13,1(vi2)			; 
	nop								sq.xyzw		vf14,0(vi2)			; 
	nop								sq.xyzw		vf12,2(vi2)			; 先頭頂点のストア
	nop								iaddiu		vi2,vi2,3			; 
_clip0_2:
	mulw.xyzw	vf12,vf16,vf0		move.w		vf20,vf21			; 終点頂点を先頭頂点用レジスタへコピー
	mulw.xyzw	vf13,vf17,vf0		ibgez		vi5,_clip0_0		; 
	mulw.xyzw	vf14,vf18,vf0		isubiu		vi5,vi5,1			; 

	nop								fsset		0					; 
	addx.w		vf31,vf8,vf8		nop								; 
	addx.w		vf31,vf9,vf9		nop								; リターン
	addx.w		vf31,vf10,vf10		jr			vi15				; 
	nop								nop								; 

	; Ｘ＝−Ｗ面に対するクリップ処理
XClip_m:
	nop								iaddiu		vi4,vi12,0			; 処理用の頂点読み込みアドレス設定
	nop								iadd		vi6,vi4,vi11		; 計算用最終頂点格納アドレス計算
	nop								iadd		vi6,vi6,vi11		; 計算用最終頂点格納アドレス計算
	nop								iadd		vi6,vi6,vi11		; 計算用最終頂点格納アドレス計算
	nop								isubiu		vi12,vi12,3			; 頂点アドレスのデクリメント
	nop								iaddiu		vi2,vi12,0			; 処理用の頂点格納アドレス設定
	nop								isubiu		vi5,vi11,2			; ループ用カウンタ設定
	nop								iaddiu		vi11,vi0,0			; 新規の頂点数をカウントする為にクリア
	nop								lq.xyzw		vf12,2(vi4)			; 
	nop								lq.xyzw		vf13,1(vi4)			; 
	nop								lq.xyzw		vf14,0(vi4)			; 
	nop								iaddiu		vi4,vi4,3			; 
	clipw.xyz	vf12xyz,vf12w		sq.xyzw		vf12,2(vi6)			; 計算用最終頂点の生成
	nop								sq.xyzw		vf13,1(vi6)			; 計算用最終頂点の生成
	addx.w		vf20,vf12,vf12		sq.xyzw		vf14,0(vi6)			; 計算用最終頂点の生成
_clip1_0:
	nop								lq.xyzw		vf16,2(vi4)			; ＜非共通部分＞
	nop								lq.xyzw		vf17,1(vi4)			; 
	nop								lq.xyzw		vf18,0(vi4)			; 
	;nop							nop								; 
	clipw.xyz	vf16xyz,vf16w		iaddiu		vi4,vi4,3			; 
	addx.w		vf21,vf16,vf16		sq.xyzw		vf12,2(vi2)			; ＜非共通部分＞
	nop								sq.xyzw		vf13,1(vi2)			; 先頭頂点がクリップ内のときには先にストアしておく
	nop								sq.xyzw		vf14,0(vi2)			; 
	; クリップ判定
	mulw.xyzw	vf23,vf16,vf20		fcor		vi1,~0x082			; ＜非共通部分＞
	mulw.xyzw	vf22,vf12,vf21		ibne		vi1,vi0,_clip1_2	; ２点とも領域外
	sub.w		vf14,vf21,vf20		fcand		vi1,0x082			; カラー補間用先行計算,＜非共通部分＞
	mulw.xyzw	vf24,vf13,vf21		ibeq		vi1,vi0,_clip1_1	; ２点とも領域内
	; 切断処理
	mulw.xyzw	vf25,vf17,vf20		fcand		vi1,0x080			; ＜非共通部分＞
	mulw.xyz	vf26,vf14,vf21		ibne		vi1,vi0,_clip1_3	; 
	mulw.xyz	vf27,vf18,vf20		div			Q,vf0w,vf14w		; 
	nop								iaddiu		vi2,vi2,3			; 
	nop								iaddiu		vi11,vi11,1			; 
_clip1_3:
	mulx.x		vf12,vf12,vf0		nop								; 
	sub.yzw		vf12,vf22,vf23		nop								; 座標
	sub.xyzw	vf13,vf24,vf25		nop								; 色
	sub.xyz		vf14,vf26,vf27		nop								; ＳＴ
	subw.x		vf12,vf12,vf12		nop								; 
	mulq.xyzw	vf13,vf13,Q			waitq							; 
	mulq.xyzw	vf14,vf14,Q			nop								; 
	mulq.xyzw	vf12,vf12,Q			nop								; 
_clip1_1:
	nop								iaddiu		vi11,vi11,1			; 
	nop								sq.xyzw		vf13,1(vi2)			; 
	nop								sq.xyzw		vf14,0(vi2)			; 
	nop								sq.xyzw		vf12,2(vi2)			; 先頭頂点のストア
	nop								iaddiu		vi2,vi2,3			; 
_clip1_2:
	mulw.xyzw	vf12,vf16,vf0		move.w		vf20,vf21			; 終点頂点を先頭頂点用レジスタへコピー
	mulw.xyzw	vf13,vf17,vf0		ibgez		vi5,_clip1_0		; 
	mulw.xyzw	vf14,vf18,vf0		isubiu		vi5,vi5,1			; 

	nop								fsset		0x0					; 
	suby.w		vf31,vf8,vf8		nop								; 
	suby.w		vf31,vf9,vf9		nop								; 
	suby.w		vf31,vf10,vf10		jr			vi15				; リターン
	nop								nop								; 

	; Ｙ＝Ｗ面に対するクリップ処理
YClip_p:
	nop								iaddiu		vi4,vi12,0			; 処理用の頂点読み込みアドレス設定
	nop								iadd		vi6,vi4,vi11		; 計算用最終頂点格納アドレス計算
	nop								iadd		vi6,vi6,vi11		; 計算用最終頂点格納アドレス計算
	nop								iadd		vi6,vi6,vi11		; 計算用最終頂点格納アドレス計算
	nop								isubiu		vi12,vi12,3			; 頂点アドレスのデクリメント
	nop								iaddiu		vi2,vi12,0			; 処理用の頂点格納アドレス設定
	nop								isubiu		vi5,vi11,2			; ループ用カウンタ設定
	nop								iaddiu		vi11,vi0,0			; 新規の頂点数をカウントする為にクリア
	nop								lq.xyzw		vf12,2(vi4)			; 
	nop								lq.xyzw		vf13,1(vi4)			; 
	nop								lq.xyzw		vf14,0(vi4)			; 
	nop								iaddiu		vi4,vi4,3			; 
