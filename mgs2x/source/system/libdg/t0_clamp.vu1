	nop								lq.xyzw		vf6,M_PRS2(vi0)		; -,透視変換マトリクスロード
	nop								lq.xyzw		vf2,FV_SCN(vi0)		; 
	nop								lq.xyzw		vf3,FV_OFT(vi0)		; 
	nop								lq.xyzw		vf1,FV_PRM(vi0)		; 
	nop								lq.xyzw		vf16,M_SUP0(vi0)	; エンベロープ補正マトリクス読み込み
	nop								lq.xyzw		vf17,M_SUP1(vi0)	; エンベロープ補正マトリクス読み込み
	nop								lq.xyzw		vf18,M_SUP2(vi0)	; エンベロープ補正マトリクス読み込み
	nop								lq.xyzw		vf19,M_SUP3(vi0)	; エンベロープ補正マトリクス読み込み
	; 変換処理開始
PreshadeClampTransNext:
	; バッファアドレス、ループ回数のセットとデータのプリロード処理
	nop								xtop		vi1					; 
	nop								ilw.y		vi2,0(vi1)			; 
	nop								lq.xyzw		vf12,0xf2(vi1)		; 第１頂点読み込み
	nop								lq.xyzw		vf13,0xf1(vi1)		; 第１法線（＆キック情報）読み込み
	nop								lq.xyzw		vf14,0xf0(vi1)		; 第１ＵＶ値読み込み
	nop								iaddiu		vi3,vi1,0xf3		; データ先読みアドレス設定
	itof0.xyzw	vf12,vf12			iadd		vi2,vi2,vi1			; データ書き戻しアドレス設定
	nop								ilw.x		vi8,0(vi1)			; 処理頂点数の読み込み
	nop								iaddiu		vi1,vi1,4			; GIFキックアドレス設定
	nop								lq.xyzw		vf1,FV_PRM(vi0)		;


	; ディレイ処理の為の前処理
	mulax.xyzw	ACC,vf4,vf12		mtir		vi7,vf13w			; 透視変換,描画キック
	madday.xyzw	ACC,vf5,vf12		mfir.w		vf13,vi0			; 透視変換,光源処理
	maddaz.xyzw	ACC,vf6,vf12		nop								; 透視変換,-
	maddw.xyzw	vf20,vf7,vf0		lq.xyzw		vf12,2(vi3)			; 透視変換,次ループ準備
	itof12.xyz	vf30,vf14			lq.xyzw		vf14,0(vi3)			; ＳＴ座標,次ループ準備
	nop								sq.xyzw		vf13,1(vi2)			; -,光源処理
	nop								lq.xyzw		vf13,1(vi3)			; -,次ループ準備
	itof0.xyzw	vf12,vf12			div			Q,vf0w,vf20w		; 次ループ準備,透視変換
	nop								isw.w		vi7,2(vi2)			; -,透視変換
	nop								iaddiu		vi3,vi3,3			; -,先読みアドレスインクリメント
	nop								nop								; -,-
	nop								lq.xyz		vf2,FV_MIN(vi0)		; -,透視変換
	nop								nop								; -,-
	nop								nop								; -,-
	mulq.xyzw	vf20,vf20,Q			waitq							; 透視変換,-
	mulq.xyz	vf30,vf30,Q			isubiu		vi8,vi8,1			; ＳＴ座標,カウンタのデクリメント
	nop								iaddiu		vi2,vi2,3			; -,書き込みアドレスのインクリメント
	nop								ibgtz		vi8,_PreshadeClampTransLoop	; -,ループジャンプ
	max.xyz		vf28,vf20,vf2		lq.xyz		vf2,FV_MAX(vi0)		; 透視変換,透視変換

_PreshadeClampTransLoop:
	; 頂点変換処理（途中で次の頂点の情報を読み込んでおく）
	mulax.xyzw	ACC,vf4,vf12		mtir		vi7,vf13w			; 透視変換,描画キック
	madday.xyzw	ACC,vf5,vf12		mfir.w		vf13,vi0			; 透視変換,光源処理
	maddaz.xyzw	ACC,vf6,vf12		sq.xyz		vf30,0-3(vi2)		; 透視変換,遅ＳＴ座標
	maddw.xyzw	vf20,vf7,vf0		lq.xyzw		vf12,2(vi3)			; 透視変換,次ループ準備
	itof12.xyz	vf30,vf14			lq.xyzw		vf14,0(vi3)			; ＳＴ座標,次ループ準備
	mini.xyz	vf28,vf28,vf2		sq.xyzw		vf13,1(vi2)			; 遅透視変換,光源処理
	nop								lq.xyzw		vf13,1(vi3)			; -,次ループ準備
	itof0.xyzw	vf12,vf12			div			Q,vf0w,vf20w		; 次ループ準備,透視変換
	nop								isw.w		vi7,2(vi2)			; -,透視変換
	ftoi4.xyz	vf28,vf28			iaddiu		vi3,vi3,3			; 遅透視変換,先読みアドレスインクリメント
	nop								iaddiu		vi2,vi2,3			; -,書き込みアドレスのインクリメント
	nop								lq.xyz		vf2,FV_MIN(vi0)		; -,透視変換
	nop								isubiu		vi8,vi8,1			; -,カウンタのデクリメント
	nop								sq.xyz		vf28,2-6(vi2)		; -,遅透視変換
	mulq.xyzw	vf20,vf20,Q			waitq							; 透視変換,-
	mulq.xyz	vf30,vf30,Q			nop								; ＳＴ座標,-
	nop								nop								; -,-
	nop								ibgtz		vi8,_PreshadeClampTransLoop	; -,ループジャンプ
	max.xyz		vf28,vf20,vf2		lq.xyz		vf2,FV_MAX(vi0)		; 透視変換,透視変換

	; 後始末
	mini.xyz	vf28,vf28,vf2		sq.xyz		vf30,0-3(vi2)		; 遅透視変換,遅ＳＴ座標
	ftoi4.xyz	vf28,vf28			nop								; 遅透視変換,-
	nop								sq.xyz		vf28,2-3(vi2)		; -,遅透視変換

	; 終端ダミーパケットをキックし待機
	nop								xgkick		vi1					; ＧＩＦへのキック
	nop[e]							b			ClampTransNext		; ジャンプ＆停止
	nop								nop								; 


