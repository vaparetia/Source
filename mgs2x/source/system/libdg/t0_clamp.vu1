	nop								lq.xyzw		vf12,0xf2(vi1)		; 第１頂点読み込み
	nop								lq.xyzw		vf13,0xf1(vi1)		; 第１法線（＆キック情報）読み込み
	nop								lq.xyzw		vf14,0xf0(vi1)		; 第１ＵＶ値読み込み
	nop								iaddiu		vi3,vi1,0xf3		; データ先読みアドレス設定
	itof0.xyzw	vf12,vf12			iadd		vi2,vi2,vi1			; データ書き戻しアドレス設定
	nop								ilw.x		vi8,0(vi1)			; 処理頂点数の読み込み
	nop								iaddiu		vi1,vi1,4			; GIFキックアドレス設定
	nop								lq.xyzw		vf1,FV_PRM(vi0)		;


	; ディレイ処理の為の前処理
	; 頂点変換処理（途中で次の頂点の情報を読み込んでおく）
	mulax.xyzw	ACC,vf4,vf12		mtir		vi7,vf13w			; 透視変換,描画キック
	madday.xyzw	ACC,vf5,vf12		mfir.w		vf13,vi0			; 透視変換,光源処理
	maddaz.xyzw	ACC,vf6,vf12		nop								; 透視変換,遅ＳＴ座標
	maddw.xyzw	vf20,vf7,vf0		lq.xyzw		vf12,2(vi3)			; 透視変換,次ループ準備
	itof12.xyz	vf30,vf14			lq.xyzw		vf14,0(vi3)			; ＳＴ座標,次ループ準備
	nop								sq.xyzw		vf13,1(vi2)			; -,光源処理
	nop								lq.xyzw		vf13,1(vi3)			; -,次ループ準備
	itof0.xyzw	vf12,vf12			div			Q,vf0w,vf20w		; 次ループ準備,透視変換
	nop								isw.w		vi7,2(vi2)			; -,透視変換
	nop								iaddiu		vi3,vi3,3			; -,先読みアドレスインクリメント
	nop								iaddiu		vi2,vi2,3			; -,書き込みアドレスのインクリメント
	nop								lq.xyz		vf2,FV_MIN(vi0)		; -,透視変換
	nop								isubiu		vi8,vi8,1			; -,カウンタのデクリメント
	nop								nop								; -,-
	mulq.xyzw	vf28,vf20,Q			waitq							; 透視変換,-
	mulq.xyz	vf30,vf30,Q			ibgtz		vi8,_PreshadeTransLoop	; ＳＴ座標,ループジャンプ
	nop								nop								; -,-

_PreshadeTransLoop:
	; 頂点変換処理（途中で次の頂点の情報を読み込んでおく）
	mulax.xyzw	ACC,vf4,vf12		mtir		vi7,vf13w			; 透視変換,描画キック
	madday.xyzw	ACC,vf5,vf12		mfir.w		vf13,vi0			; 透視変換,光源処理
	maddaz.xyzw	ACC,vf6,vf12		sq.xyz		vf30,0-3(vi2)		; 透視変換,遅ＳＴ座標
	maddw.xyzw	vf20,vf7,vf0		lq.xyzw		vf12,2(vi3)			; 透視変換,次ループ準備
	itof12.xyz	vf30,vf14			lq.xyzw		vf14,0(vi3)			; ＳＴ座標,次ループ準備
	ftoi4.xyz	vf28,vf28			sq.xyzw		vf13,1(vi2)			; 遅透視変換,光源処理
	nop								lq.xyzw		vf13,1(vi3)			; -,次ループ準備
	itof0.xyzw	vf12,vf12			div			Q,vf0w,vf20w		; 次ループ準備,透視変換
	nop								isw.w		vi7,2(vi2)			; -,透視変換
