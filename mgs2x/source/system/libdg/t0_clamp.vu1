;
;	t0_clamp.vu1
;	クランプ処理付き描画ＶＵ１プログラム
;
;	1999/07/07 K.Takabe
;	$Id: t0_clamp.vu1,v 1.1.1.3 2002/11/19 11:42:26 Yoshizawa1 Exp $
;


;
;	ＶＵ１実験用オブジェクト表示マイクロプログラム
;	1999.3.12  K.Takabe
;
;	浮動小数点レジスタ使用状況
;	vf0:fix
;	vf1:定数読み込みベクトル
;	vf2:tmp
;	vf3:tmp
;	vf4~vf7:透視変換マトリクス
;	vf8~vf11:作業用マトリクス（ライトマトリクス等）
;	vf12:頂点読み込み
;	vf13:法線読み込み
;	vf14:ＵＶ値読み込み
;	vf15:リザーブ（頂点データ読み込み）
;	vf16~19:リザーブ（マトリクス）
;	vf20:透視変換直後座標
;	vf21:光源計算用ワーク
;	vf22~23:作業用
;	vf24~27:作業用
;	vf28:描画頂点データ
;	vf29:色データ
;	vf30:テクスチャ座標
;	vf31:リザーブ（変換後頂点データ）
;	
;	整数レジスタ使用状況
;	vi0:０固定
;	vi1:バッファ先頭アドレス（インクリメントしてキックアドレスとして使用する）
;	vi2:ＧＩＦキックアドレス
;	vi3:読み出し頂点処理アドレス
;	vi4:汎用
;	vi5:汎用
;	vi6:汎用
;	vi7:描画キックフラグの記憶
;	vi8:頂点数（＝ループカウンタ）
;	vi9:リザーブ
;	vi10:リザーブ
;	vi11:リザーブ
;	vi12:リザーブ
;	vi13:リザーブ
;	vi14:スタック
;	vi15:リンクレジスタ
;	

; メモリ使用構成（ＶＵ１側から見るときには下位４ビットを無視すること）
; 0x0000~0x01ff	プログラムワーク
; 0x0200~0x03ff オブジェクトパラメータ設定（変換マトリクス等）
; 0x0400~0x21ff ダブルバッファ０
;  +0x0000_0x0eff 転送用バッファ
;  +0x0f00_0x1cff 読み込み用バッファ
; 0x2200~0x3fff ダブルバッファ１
;  +0x0000_0x0eff 転送用バッファ
;  +0x0f00_0x1cff 読み込み用バッファ
; 0x4000		最終アドレス
; 

; データフォーマット（案）
; + 0.x    頂点データ数
; + 0.y    データ開始位置（＝５）
; + 1.xyzw GIFtag（クリップポリゴン用プリミティブ設定ＧＩＦタグ）
; + 2.xyzw PRIM
; + 3.xyzw GIFtag（クリップポリゴン頂点用の転送ＧＩＦタグ）
; + 4.xyzw GIFtag（テクスチャパラメータ設定ＧＩＦタグ）
; + 5.xyzw CLAMP_1
; + 6.xyzw TEX0_1
; + 7.xyzw GIFtag（頂点の転送ＧＩＦタグ）
; + 8.xyzw 第１ＳＴＱ
; + 9.xyzw 第１ＲＧＢＡ
; +10.xyzw 第１ＸＹＺＦ
; +11.xyzw 第２ＳＴＱ
; +12.xyzw 第２ＲＧＢＡ
; .
; .
; .
; +f0.xyzw 第１ＶＵデータ
; +f1.xyzw 第１法線データ
; +f2.xyzw 第１頂点データ
; +f3.xyzw 第２ＶＵデータ
; +f4.xyzw 第１法線データ
; 
; 
; 
; 

; --------------------------------------
; 高速化した光源計算付き透視変換ルーチン
; --------------------------------------
;	upper		.					lower		.
ClampTransStart:
	; 変換初期化処理
	nop								lq.xyzw		vf26,FV_PRM2(vi0)	; 
	nop								lq.xyzw		vf7,M_PRS3(vi0)		; -,透視変換マトリクスロード
	nop								lq.xyzw		vf4,M_PRS0(vi0)		; -,透視変換マトリクスロード
	nop								lq.xyzw		vf5,M_PRS1(vi0)		; -,透視変換マトリクスロード
	nop								lq.xyzw		vf6,M_PRS2(vi0)		; -,透視変換マトリクスロード
	nop								lq.xyzw		vf2,FV_SCN(vi0)		; 
	nop								lq.xyzw		vf3,FV_OFT(vi0)		; 
	nop								lq.xyzw		vf1,FV_PRM(vi0)		; 
	nop								lq.xyzw		vf16,M_SUP0(vi0)	; エンベロープ補正マトリクス読み込み
	nop								lq.xyzw		vf17,M_SUP1(vi0)	; エンベロープ補正マトリクス読み込み
	nop								lq.xyzw		vf18,M_SUP2(vi0)	; エンベロープ補正マトリクス読み込み
	nop								lq.xyzw		vf19,M_SUP3(vi0)	; エンベロープ補正マトリクス読み込み
	; 変換処理開始
ClampTransNext:
	; バッファアドレス、ループ回数のセットとデータのプリロード処理
	nop								xtop		vi1					; 
	nop								ilw.y		vi2,0(vi1)			; 
	nop								lq.xyzw		vf12,0xf2(vi1)		; 第１頂点読み込み
	nop								lq.xyzw		vf13,0xf1(vi1)		; 第１法線（＆キック情報）読み込み
	nop								lq.xyzw		vf14,0xf0(vi1)		; 第１ＵＶ値読み込み
	nop								iaddiu		vi3,vi1,0xf3		; データ先読みアドレス設定
	itof0.xyzw	vf12,vf12			iadd		vi2,vi2,vi1			; データ書き戻しアドレス設定
	nop								ilw.x		vi8,0(vi1)			; 処理頂点数の読み込み
	itof12.xyz	vf13,vf13			iaddiu		vi1,vi1,4			; GIFキックアドレス設定
	nop								lq.xyzw		vf1,FV_PRM(vi0)		;


	; ディレイ処理の為の前処理
	mulax.xyzw	ACC,vf4,vf12		lq.xyzw		vf8,M_LIT0(vi0)		; 透視変換,光源処理
	madday.xyzw	ACC,vf5,vf12		lq.xyzw		vf9,M_LIT1(vi0)		; 透視変換,光源処理
	maddaz.xyzw	ACC,vf6,vf12		lq.xyzw		vf10,M_LIT2(vi0)	; 透視変換,光源処理
	maddw.xyzw	vf20,vf7,vf0		lq.xyzw		vf12,2(vi3)			; 透視変換,次ループ準備
	mulax.xyzw	ACC,vf8,vf13		mtir		vi7,vf13w			; 光源処理,描画キック
	madday.xyzw	ACC,vf9,vf13		lq.xyzw		vf8,M_COL0(vi0)		; 光源処理,光源処理
	maddz.xyzw	vf21,vf10,vf13		lq.xyzw		vf13,1(vi3)			; 光源処理,次ループ準備
	itof0.xyzw	vf12,vf12			div			Q,vf0w,vf20w		; 次ループ準備,透視変換
	nop								lq.xyzw		vf9,M_COL1(vi0)		; -,光源処理
	itof12.xyz	vf14,vf14			lq.xyzw		vf10,M_COL2(vi0)	; ＳＴ座標,光源処理
	maxx.xyzw	vf21,vf21,vf0		lq.xyzw		vf11,M_COL3(vi0)	; 光源処理,光源処理
	itof12.xyz	vf13,vf13			lq.xyz		vf2,FV_MIN(vi0)		; 次ループ準備,透視変換
;	nop								nop								; -,-
;	nop								nop								; -,-
	mulq.xyzw	vf20,vf20,Q			waitq							; 透視変換,-
	mulax.xyz	ACC,vf8,vf21		move.w		vf29,vf1			; 光源処理,光源処理
	madday.xyz	ACC,vf9,vf21		nop								; 光源処理,-
	maddaz.xyz	ACC,vf10,vf21		nop								; 光源処理,-
	maddw.xyz	vf21,vf11,vf0		nop								; 光源処理,-
	mulq.xyz	vf30,vf14,Q			lq.xyzw		vf14,0(vi3)			; ＳＴ座標,次ループ準備
	max.xyz		vf20,vf20,vf2		lq.xyz		vf2,FV_MAX(vi0)		; 透視変換,透視変換
	nop								iaddiu		vi3,vi3,3			; -,先読みアドレスインクリメント
	minix.xyz	vf29,vf21,vf1		isubiu		vi8,vi8,1			; 光源処理,カウンタのデクリメント
	nop								sq.xyz		vf30,0(vi2)			; -,ＳＴ座標
	mini.xyz	vf28,vf20,vf2		isw.w		vi7,2(vi2)			; 透視変換,透視変換
	nop								ibgtz		vi8,_ClampTransLoop	; 光源処理,ループジャンプ
	nop								iaddiu		vi2,vi2,3			; 書き込みアドレスのインクリメント

_ClampTransLoop:
	; 頂点変換処理（途中で次の頂点の情報を読み込んでおく）
	mulax.xyzw	ACC,vf4,vf12		lq.xyzw		vf8,M_LIT0(vi0)		; 透視変換,光源処理
	madday.xyzw	ACC,vf5,vf12		lq.xyzw		vf9,M_LIT1(vi0)		; 透視変換,光源処理
	maddaz.xyzw	ACC,vf6,vf12		lq.xyzw		vf10,M_LIT2(vi0)	; 透視変換,光源処理
	maddw.xyzw	vf20,vf7,vf0		lq.xyzw		vf12,2(vi3)			; 透視変換,次ループ準備
	mulax.xyzw	ACC,vf8,vf13		mtir		vi7,vf13w			; 光源処理,描画キック
	madday.xyzw	ACC,vf9,vf13		lq.xyzw		vf8,M_COL0(vi0)		; 光源処理,光源処理
	maddz.xyzw	vf21,vf10,vf13		lq.xyzw		vf13,1(vi3)			; 光源処理,次ループ準備
	itof0.xyzw	vf12,vf12			div			Q,vf0w,vf20w		; 次ループ準備,透視変換
	nop								lq.xyzw		vf9,M_COL1(vi0)		; -,光源処理
	itof12.xyz	vf14,vf14			lq.xyzw		vf10,M_COL2(vi0)	; ＳＴ座標,光源処理
	maxx.xyzw	vf21,vf21,vf0		lq.xyzw		vf11,M_COL3(vi0)	; 光源処理,光源処理
	itof12.xyz	vf13,vf13			lq.xyz		vf2,FV_MIN(vi0)		; 次ループ準備,透視変換
	ftoi4.xyz	vf28,vf28			nop								; 遅透視変換,-
	ftoi0.xyzw	vf29,vf29			nop								; 遅光源処理,-
	mulq.xyzw	vf20,vf20,Q			waitq							; 透視変換,-
	mulax.xyz	ACC,vf8,vf21		nop								; 光源処理,-
	madday.xyz	ACC,vf9,vf21		sq.xyz		vf28,2-3(vi2)		; 光源処理,遅透視変換
	maddaz.xyz	ACC,vf10,vf21		sq.xyzw		vf29,1-3(vi2)		; 光源処理,遅光源処理
	maddw.xyz	vf21,vf11,vf0		move.w		vf29,vf1			; 光源処理,光源処理
	mulq.xyz	vf30,vf14,Q			lq.xyzw		vf14,0(vi3)			; ＳＴ座標,次ループ準備
	max.xyz		vf20,vf20,vf2		lq.xyz		vf2,FV_MAX(vi0)		; 透視変換,透視変換
	nop								iaddiu		vi3,vi3,3			; -,先読みアドレスインクリメント
	minix.xyz	vf29,vf21,vf1		isubiu		vi8,vi8,1			; 光源処理,カウンタのデクリメント
	nop								sq.xyz		vf30,0(vi2)			; -,ＳＴ座標
	mini.xyz	vf28,vf20,vf2		isw.w		vi7,2(vi2)			; 透視変換,透視変換
	nop								ibgtz		vi8,_ClampTransLoop	; 光源処理,ループジャンプ
	nop								iaddiu		vi2,vi2,3			; 書き込みアドレスのインクリメント

	; 後始末
	ftoi4.xyz	vf28,vf28			nop								; 遅透視変換,-
	ftoi0.xyzw	vf29,vf29			nop								; 遅光源処理,-
	nop								sq.xyz		vf28,2-3(vi2)		; 光源処理,遅透視変換
	nop								sq.xyzw		vf29,1-3(vi2)		; 光源処理,遅光源処理

	; 終端ダミーパケットをキックし待機
	nop								xgkick		vi1					; ＧＩＦへのキック
	nop[e]							b			ClampTransNext		; ジャンプ＆停止
	nop								nop								; 


; --------------------------------------
; エンベロープ対応ルーチン
; --------------------------------------
;	upper		.					lower		.
ClampTransEnvelopeStart:
	; 変換初期化処理
	nop								lq.xyzw		vf7,M_PRS3(vi0)		; -,透視変換マトリクスロード
	nop								lq.xyzw		vf4,M_PRS0(vi0)		; -,透視変換マトリクスロード
	nop								lq.xyzw		vf5,M_PRS1(vi0)		; -,透視変換マトリクスロード
	nop								lq.xyzw		vf6,M_PRS2(vi0)		; -,透視変換マトリクスロード
	nop								lq.xyzw		vf2,FV_SCN(vi0)		; 
	nop								lq.xyzw		vf3,FV_OFT(vi0)		; 
	nop								lq.xyzw		vf1,FV_PRM(vi0)		; 
	nop								lq.xyzw		vf16,M_SUP0(vi0)	; エンベロープ補正マトリクス読み込み
	nop								lq.xyzw		vf17,M_SUP1(vi0)	; エンベロープ補正マトリクス読み込み
	nop								lq.xyzw		vf18,M_SUP2(vi0)	; エンベロープ補正マトリクス読み込み
	nop								lq.xyzw		vf19,M_SUP3(vi0)	; エンベロープ補正マトリクス読み込み
	; 変換処理開始
ClampTransEnvelopeNext:
	; バッファアドレス、ループ回数のセットとデータのプリロード処理
	nop								xtop		vi1					; 
	nop								ilw.y		vi2,0(vi1)			; 
	nop								lq.xyzw		vf12,0xf2(vi1)		; 第１頂点読み込み
	nop								lq.xyzw		vf13,0xf1(vi1)		; 第１法線（＆キック情報）読み込み
	nop								lq.xyzw		vf14,0xf0(vi1)		; 第１ＵＶ値読み込み
	nop								iaddiu		vi3,vi1,0xf3		; データ先読みアドレス設定
	itof0.xyz	vf12,vf12			iadd		vi2,vi2,vi1			; データ書き戻しアドレス設定
	itof12.w	vf31,vf12			ilw.x		vi8,0(vi1)			; 処理頂点数の読み込み
	itof12.xyz	vf13,vf13			iaddiu		vi1,vi1,4			; GIFキックアドレス設定
	nop								lq.xyzw		vf1,FV_PRM(vi0)		;


	; ディレイ処理の為の前処理
	mulax.xyzw	ACC,vf16,vf12		nop								; trans_v,-
	madday.xyzw	ACC,vf17,vf12		nop								; trans_v,-
	maddaz.xyzw	ACC,vf18,vf12		nop								; trans_v,make v
	maddw.xyzw	vf24,vf19,vf0		nop								; trans_v,-
	sub.w		vf24,vf0,vf31		nop								; make v&n,-
	mulax.xyz	ACC,vf16,vf13		nop								; trans_n,-
	madday.xyz	ACC,vf17,vf13		nop								; trans_n,-
	maddz.xyz	vf25,vf18,vf13		nop								; trans_n,-
	mulaw.xyz	ACC,vf12,vf31		nop								; make v,-
	maddw.xyz	vf12,vf24,vf24		nop								; make v,-
	mulaw.xyz	ACC,vf13,vf31		nop								; make n,-
	maddw.xyz	vf13,vf25,vf24		nop								; make n,-

	mulax.xyzw	ACC,vf4,vf12		lq.xyzw		vf8,M_LIT0(vi0)		; 透視変換,光源処理
	madday.xyzw	ACC,vf5,vf12		lq.xyzw		vf9,M_LIT1(vi0)		; 透視変換,光源処理
	maddaz.xyzw	ACC,vf6,vf12		lq.xyzw		vf10,M_LIT2(vi0)	; 透視変換,光源処理
	maddw.xyzw	vf20,vf7,vf0		lq.xyzw		vf12,2(vi3)			; 透視変換,次ループ準備
	mulax.xyzw	ACC,vf8,vf13		mtir		vi7,vf13w			; 光源処理,描画キック
	madday.xyzw	ACC,vf9,vf13		lq.xyzw		vf8,M_COL0(vi0)		; 光源処理,光源処理
	maddz.xyzw	vf21,vf10,vf13		lq.xyzw		vf13,1(vi3)			; 光源処理,次ループ準備
	itof0.xyz	vf12,vf12			div			Q,vf0w,vf20w		; 次ループ準備,透視変換
	nop								lq.xyzw		vf9,M_COL1(vi0)		; -,光源処理
	itof12.xyz	vf14,vf14			lq.xyzw		vf10,M_COL2(vi0)	; ＳＴ座標,光源処理
	maxx.xyzw	vf21,vf21,vf0		lq.xyzw		vf11,M_COL3(vi0)	; 光源処理,光源処理
	itof12.xyz	vf13,vf13			lq.xyz		vf2,FV_MIN(vi0)		; 次ループ準備,透視変換
;	nop								nop								; -,-
;	nop								nop								; -,-
	mulq.xyzw	vf20,vf20,Q			waitq							; 透視変換,-
	mulax.xyz	ACC,vf8,vf21		move.w		vf29,vf1			; 光源処理,光源処理
	madday.xyz	ACC,vf9,vf21		nop								; 光源処理,-
	maddaz.xyz	ACC,vf10,vf21		nop								; 光源処理,-
	maddw.xyz	vf21,vf11,vf0		nop								; 光源処理,-
	mulq.xyz	vf30,vf14,Q			lq.xyzw		vf14,0(vi3)			; ＳＴ座標,次ループ準備
	max.xyz		vf20,vf20,vf2		lq.xyz		vf2,FV_MAX(vi0)		; 透視変換,透視変換
	itof12.w	vf31,vf12			iaddiu		vi3,vi3,3			; -,先読みアドレスインクリメント
	minix.xyz	vf29,vf21,vf1		isubiu		vi8,vi8,1			; 光源処理,カウンタのデクリメント
	mulax.xyz	ACC,vf16,vf12		sq.xyz		vf30,0(vi2)			; -,ＳＴ座標
	mini.xyz	vf28,vf20,vf2		isw.w		vi7,2(vi2)			; 透視変換,透視変換
	madday.xyz	ACC,vf17,vf12		ibgtz		vi8,_ClampTransEnvelopeLoop	; 光源処理,ループジャンプ
	maddaz.xyz	ACC,vf18,vf12		iaddiu		vi2,vi2,3			; 書き込みアドレスのインクリメント

_ClampTransEnvelopeLoop:
	; 頂点変換処理（途中で次の頂点の情報を読み込んでおく）
	maddw.xyz	vf24,vf19,vf12		nop								; trans_v,-
	sub.w		vf24,vf0,vf31		nop								; make v&n,-
	mulax.xyz	ACC,vf16,vf13		nop								; trans_n,-
	madday.xyz	ACC,vf17,vf13		nop								; trans_n,-
	maddz.xyz	vf25,vf18,vf13		nop								; trans_n,-
	mulaw.xyz	ACC,vf12,vf31		nop								; make v,-
	maddw.xyz	vf12,vf24,vf24		nop								; make v,-
	mulaw.xyz	ACC,vf13,vf31		nop								; make n,-
	maddw.xyz	vf13,vf25,vf24		nop								; make n,-

	mulax.xyzw	ACC,vf4,vf12		lq.xyzw		vf8,M_LIT0(vi0)		; 透視変換,光源処理
	madday.xyzw	ACC,vf5,vf12		lq.xyzw		vf9,M_LIT1(vi0)		; 透視変換,光源処理
	maddaz.xyzw	ACC,vf6,vf12		lq.xyzw		vf10,M_LIT2(vi0)	; 透視変換,光源処理
	maddw.xyzw	vf20,vf7,vf0		lq.xyzw		vf12,2(vi3)			; 透視変換,次ループ準備
	mulax.xyzw	ACC,vf8,vf13		mtir		vi7,vf13w			; 光源処理,描画キック
	madday.xyzw	ACC,vf9,vf13		lq.xyzw		vf8,M_COL0(vi0)		; 光源処理,光源処理
	maddz.xyzw	vf21,vf10,vf13		lq.xyzw		vf13,1(vi3)			; 光源処理,次ループ準備
	itof0.xyz	vf12,vf12			div			Q,vf0w,vf20w		; 次ループ準備,透視変換
	nop								lq.xyzw		vf9,M_COL1(vi0)		; -,光源処理
	itof12.xyz	vf14,vf14			lq.xyzw		vf10,M_COL2(vi0)	; ＳＴ座標,光源処理
	maxx.xyzw	vf21,vf21,vf0		lq.xyzw		vf11,M_COL3(vi0)	; 光源処理,光源処理
	itof12.xyz	vf13,vf13			lq.xyz		vf2,FV_MIN(vi0)		; 次ループ準備,透視変換
	ftoi4.xyz	vf28,vf28			nop								; 遅透視変換,-
	ftoi0.xyzw	vf29,vf29			nop								; 遅光源処理,-
	mulq.xyzw	vf20,vf20,Q			waitq							; 透視変換,-
	mulax.xyz	ACC,vf8,vf21		nop								; 光源処理,-
	madday.xyz	ACC,vf9,vf21		sq.xyz		vf28,2-3(vi2)		; 光源処理,遅透視変換
	maddaz.xyz	ACC,vf10,vf21		sq.xyzw		vf29,1-3(vi2)		; 光源処理,遅光源処理
	maddw.xyz	vf21,vf11,vf0		move.w		vf29,vf1			; 光源処理,光源処理
	mulq.xyz	vf30,vf14,Q			lq.xyzw		vf14,0(vi3)			; ＳＴ座標,次ループ準備
	max.xyz		vf20,vf20,vf2		lq.xyz		vf2,FV_MAX(vi0)		; 透視変換,透視変換
	itof12.w	vf31,vf12			iaddiu		vi3,vi3,3			; -,先読みアドレスインクリメント
	minix.xyz	vf29,vf21,vf1		isubiu		vi8,vi8,1			; 光源処理,カウンタのデクリメント
	mulax.xyz	ACC,vf16,vf12		sq.xyz		vf30,0(vi2)			; -,ＳＴ座標
	mini.xyz	vf28,vf20,vf2		isw.w		vi7,2(vi2)			; 透視変換,透視変換
	madday.xyz	ACC,vf17,vf12		ibgtz		vi8,_ClampTransEnvelopeLoop	; 光源処理,ループジャンプ
	maddaz.xyz	ACC,vf18,vf12		iaddiu		vi2,vi2,3			; 書き込みアドレスのインクリメント

	; 後始末
	ftoi4.xyz	vf28,vf28			nop								; 遅透視変換,-
	ftoi0.xyzw	vf29,vf29			nop								; 遅光源処理,-
	nop								sq.xyz		vf28,2-3(vi2)		; 光源処理,遅透視変換
	nop								sq.xyzw		vf29,1-3(vi2)		; 光源処理,遅光源処理

	; 終端ダミーパケットをキックし待機
	nop								xgkick		vi1					; ＧＩＦへのキック
	nop[e]							b			ClampTransNext		; ジャンプ＆停止
	nop								nop								; 



.if 0
