; マルチテクスチャ用ピクセルシェーダー（グロスマップ付き環境マップ）
; 
;
; 2002.04.21  K.Takabe

ps.1.1

tex t0							; ベーステクスチャ
tex t1							; グロスマップテクスチャ
tex t2							; 環境マップテクスチャ

mul_x2 r0.a,   t0.a,   v0.a			; アルファはテクスチャ０のみを参照
mul    t2.rgb, t2.rgb, t1.a			; 環境マップテクスチャをグロスマップアルファと乗算
mul    r0.rgb, t0.rgb, v0.rgb			; 頂点カラーでベーステクスチャをモジュレート
mad_x2 r0.rgb, t2.rgb, v0.rgb, r0.rgb	; グロスマップと乗算済みの環境マップテクスチャをモジュレート加算

;mul_x2 r0.a,   t0.a,   v0.a			; アルファはテクスチャ０のみを参照
;mul    r0.rgb, t0.rgb, v0.rgb			; 頂点カラーでベーステクスチャをモジュレート
;mul    t2.rgb, t2.rgb, t1.a			; 環境マップテクスチャをグロスマップアルファと乗算
;mul    t1.rgb, t1.rgb, t1.a			; 環境マップテクスチャをグロスマップアルファと乗算
;mad    r0.rgb, -t1.rgb, v0.rgb, r0.rgb	; グロスマップと乗算済みの環境マップテクスチャをモジュレート減算
;mad_x2 r0.rgb, t2.rgb, v0.rgb, r0.rgb	; グロスマップと乗算済みの環境マップテクスチャをモジュレート加算

;; ＭＧＳ２のマルチテクスチャを分解すると・・・
;mul    r0.a,   t0.a    v0.a
;mul    t0.rgb, t0.rgb, v0.rgb
;mul    t1.rgb, t1.rgb, v0.rgb
;mul    t2.rgb, t2.rgb, v0.rgb
;; 各テクスチャ間のブレンディング（４命令以内）
