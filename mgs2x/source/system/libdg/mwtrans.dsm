	madday.xyzw	ACC ,vf05,vf17		lq.xyzw		vf05,0x15(vi11)		; 法線計算,次のマトリクス読み込み
	maddz.xyzw	vf25,vf06,vf17		lq.xyzw		vf06,0x16(vi11)		; 法線計算,次のマトリクス読み込み
	addax.xyzw	ACC ,vf26,vf00		iaddi		vi06,vi06,-1		; 頂点合計加算,マトリクス数減算
	maddx.xyzw	vf26,vf24,vf22		nop								; 頂点合計加算,-
	addax.xyzw	ACC ,vf27,vf00		iblez		vi06,EnvelopeEndLarge	; 頂点合計加算,計算終了
	maddx.xyzw	vf27,vf25,vf22		nop								; 頂点合計加算,-
	; 第６マトリクス計算
	mulax.xyzw	ACC ,vf04,vf16		nop								; 頂点計算,-
	madday.xyzw	ACC ,vf05,vf16		nop								; 頂点計算,-
	maddaz.xyzw	ACC ,vf06,vf16		nop								; 頂点計算,-
	maddw.xyzw	vf24,vf07,vf00		lq.xyzw		vf07,0x1b(vi11)		; 頂点計算,次のマトリクス読み込み
