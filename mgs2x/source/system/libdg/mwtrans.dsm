	madday.xyzw	ACC ,vf05,vf17		lq.xyzw		vf05,0x21(vi11)		; 法線計算,次のマトリクス読み込み
	maddz.xyzw	vf25,vf06,vf17		lq.xyzw		vf06,0x22(vi11)		; 法線計算,次のマトリクス読み込み
