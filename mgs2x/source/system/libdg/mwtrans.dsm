EnvelopeEndLarge:; エンベロープ計算終了

; ----------------------------------------------------------------
; 法線の正規化
; ----------------------------------------------------------------
;	nop								erleng		P,vf27				; 0cycle
;	nop								waitp							; 23cycle
;	nop								mfp.w		vf27,P				; 24cycle
;	mulw.xyz	vf27,vf27,vf27		nop								; 28cycle
; ＜未実装＞
NormalizeEndLarge:

; ----------------------------------------------------------------
; 座標変換＆テクスチャ０セットアップ処理
; ----------------------------------------------------------------
	mulax.xyzw	ACC ,vf08,vf26		sq.xyz		vf26,SRC_VERT(vi09)	; 透視変換,頂点保存
	madday.xyzw	ACC ,vf09,vf26		sq.xyz		vf27,SRC_NORM(vi09)	; 透視変換,法線保存
	maddaz.xyzw	ACC ,vf10,vf26		lq.xyzw		vf04,M_COL0(vi00)	; 透視変換,光源マトリクス読み込み
	maddw.xyzw	vf26,vf11,vf00		lq.xyzw		vf05,M_COL1(vi00)	; 透視変換,光源マトリクス読み込み
	mulax.xyzw	ACC ,vf12,vf27		lq.xyzw		vf06,M_COL2(vi00)	; 光源計算,光源マトリクス読み込み
	madday.xyzw	ACC ,vf13,vf27		lq.xyzw		vf07,M_COL3(vi00)	; 光源計算,光源マトリクス読み込み
	maddz.xyzw	vf27,vf14,vf27		lq.xyzw		vf16,BUF_VERT+BUF_NEXT(vi09); 光源計算,(先)頂点先読み
	clipw.xyz	vf26,vf26			div			Q,vf00w,vf26w		; クリップチェック,透視変換
	mulax.w		ACC ,vf26,vf15		sq.xyzw		vf26,SRC_XYZW(vi09)	; フォグ,クリップ用に保存
	maddy.w		vf26,vf00,vf15		lq.xyzw		vf17,BUF_NORM+BUF_NEXT(vi09); フォグ,(先)法線先読み
	maxx.xyz	vf27,vf27,vf00		loi			128.0				; 光源計算,アルファ設定
	muli.w		vf27,vf00,I			fcand		vi01,0x03ffff		; アルファ設定,クリップチェック
	nop								ibeq		vi01,vi00,l01		; -,クリップチェック
	maxx.w		vf26,vf26,vf00		iaddi		vi08,vi08,-1		; フォグ,ループカウンタ減算
	nop								ibltz		vi07,l01			; ●-,キックフラグチェック
	nop								iaddi		vi01,vi00,-1		; ●-,フラグの作成
	nop								ior			vi07,vi07,vi01		; ●-,フラグの書き込み
	nop								iaddiu		vi15,vi00,1			; ●-,クリップ処理フラグを立てる
l01:mulq.xyz	vf26,vf26,Q			isw.w		vi07,SRC_FLG(vi09)	; 透視変換,フラグの保存
	mulax.xyz	ACC ,vf04,vf27		loi			255.0				; 光源計算,フォグ
	madday.xyz	ACC ,vf05,vf27		iaddiu		vi01,vi00,0x4000	; 光源計算,キックフラグ
	minii.w		vf26,vf26,I			iadd		vi01,vi01,vi01		; フォグ,キックフラグ
	maddaz.xyz	ACC ,vf06,vf27		iand		vi01,vi07,vi01		; 光源計算,キックフラグ
	maddw.xyz	vf27,vf07,vf00		lq.xyzw		vf24,BUF_UV0+BUF_NEXT(vi09)	; 光源計算,(先)ＵＶ０先読み
	mula.xyz	ACC ,vf26,vf02		lq.xyzw		vf19,BUF_UV1+BUF_NEXT(vi09)	; 透視変換,(先)ＵＶ１先読み
	ftoi4.w		vf26,vf26			lq.xyzw		vf20,BUF_UV2+BUF_NEXT(vi09)	; フォグ,(先)ＵＶ２先読み
	maddw.xyz	vf26,vf03,vf00		lq.xyzw		vf21,BUF_WT0+BUF_NEXT(vi09)	; 透視変換,(先)ウェイト値先読み
	minii.xyzw	vf27,vf27,I			lq.xyzw		vf22,BUF_WT1+BUF_NEXT(vi09)	; 光源計算,(先)ウェイト値先読み
	mulq.xyz	vf18,vf18,Q			ilw.w		vi07,BUF_FLG+BUF_NEXT(vi09)	; ＳＴＱ計算,(先)キックフラグ読み込み
	mulq.w		vf25,vf00,Q			mtir		vi06,vf26w			; Ｑ値保存用,フォグ
	ftoi4.xyz	vf26,vf26			loi			0.0078125			; 透視変換,=1.0f/128.0f
	ftoi0.xyzw	vf27,vf27			sq.xyzw		vf27,SRC_COL(vi09)	; 光源計算,クリップ用に保存
	itof4.xyz	vf16,vf16			sq.xyz		vf18,DST_UV0(vi10)	; (先)頂点実数化,ＵＶ書き込み
	itof12.xyz	vf17,vf17			ior			vi06,vi01,vi06		; (先)頂点実数化,フォグ
	itof12.xyz	vf18,vf24			sq.xyz		vf26,DST_XYZ(vi10)	; (先)ＵＶ０実数化,座標書き込み
	itof12.xyz	vf19,vf19			sq.xyzw		vf27,DST_COL(vi10)	; (先)ＵＶ１実数化,カラー書き込み
	itof12.xyz	vf20,vf20			isw.w		vi06,DST_XYZ(vi10)	; (先)ＵＶ２実数化,キック＆フォグ
	itof0.xyzw	vf21,vf21			sq.w		vf25,SRC_UV1(vi09)	; (先)重み実数化,Ｑ値保存
	itof0.xyzw	vf22,vf22			iaddi		vi09,vi09,BUF_NEXT	; (先)重み実数化,読み込みアドレス増加
	sub.xyzw	vf26,vf26,vf26		iaddi		vi10,vi10,DST_NEXT	; (先)合計値初期化,書き込みアドレス増加
	sub.xyzw	vf27,vf27,vf27		ilw.z		vi06,0x00(vi13)		; (先)合計値初期化,(先)マトリクス数読み込み
	muli.xyzw	vf21,vf21,I			lq.xyzw		vf04,0x00(vi11)		; -,(先)最初のマトリクス読み込み
	muli.xyzw	vf22,vf22,I			lq.xyzw		vf05,0x01(vi11)		; -,(先)最初のマトリクス読み込み
	nop								lq.xyzw		vf06,0x02(vi11)		; -,(先)最初のマトリクス読み込み
	nop								ibgtz		vi08,WeightConvertLoopLarge; -,ループ
	nop								lq.xyzw		vf07,0x03(vi11)		; -,(先)最初のマトリクス読み込み

	nop								b			tex0f_start			; 
	nop								nop								; 

; ================================================================
; テクスチャ０の描画
; ================================================================
tex0f_start:
	nop								iaddiu		vi01,vi13,TX0_OFT	; テクスチャ設定
	nop								xgkick		vi01				; テクスチャ設定
	nop								ilw.x		vi08,0x00(vi13)		; GIFTAG書き込み
	nop								lq.xyzw		vf12,0x03(vi13)		; GIFTAG書き込み
	nop								iaddiu		vi01,vi00,0x4000	; GIFTAG書き込み
	nop								iadd		vi01,vi01,vi01		; GIFTAG書き込み
	nop								iadd		vi01,vi08,vi01		; GIFTAG書き込み
	nop								sq.yzw		vf12,0x04(vi13)		; GIFTAG書き込み
	nop								isw.x		vi01,0x04(vi13)		; GIFTAG書き込み
	nop								iaddiu		vi01,vi13,0x04		; キックアドレス設定
	nop								xgkick		vi01				; パケットの描画
tex0f_end:

; ================================================================
; テクスチャ１の描画
; ================================================================
tex1f_start:
	nop								lq.xyzw		vf31,0x01(vi13)		; GIFTAGレジスタリスト読み込み
	nop								iaddiu		vi01,vi00,FLAG_TEX1	; -,テクスチャ１使用フラグ
	nop								ilw.y		vi10,0x00(vi13)		; -,ワーク開始位置取得
	nop								iand		vi01,vi12,vi01		; -,チェック
	nop								ilw.x		vi08,0x00(vi13)		; -,頂点数取得
	nop								ibeq		vi01,vi00,tex1f_end	; -,スキップ
	nop								iaddiu		vi09,vi13,DAT_OFT	; -,データ読み取りアドレス設定
	nop								iadd		vi10,vi13,vi10		; -,データ書き込みアドレス設定

	; テクスチャ座標をＳＴＱに変換する
	; 最初の１回
	nop								lq.xyz		vf18,SRC_UV1(vi09)	; -,ＵＶ値の読み込み
	nop								lq.w		vf18,SRC_UV1(vi09)	; -,Ｑ値の読み込み
;	nop								nop								; -,-
	nop								iaddi		vi08,vi08,-1		; -,カウンタ減算
	nop								iaddiu		vi09,vi09,SRC_NEXT	; -,読み込みアドレス加算
	mulw.xyz	vf19,vf18,vf18		ibgtz		vi08,t1f_l00		; ＳＴＱ計算,ループ
	nop								nop								; -,-
	; ２回目以降
t1f_l00:
	nop								lq.xyz		vf18,SRC_UV1(vi09)	; -,ＵＶ値の読み込み
	nop								lq.w		vf18,SRC_UV1(vi09)	; -,Ｑ値の読み込み
	nop								sq.xyz		vf19,DST_UV1(vi10)	; -,(遅)ＳＴＱ格納
	nop								iaddi		vi08,vi08,-1		; -,カウンタ減算
	nop								iaddiu		vi09,vi09,SRC_NEXT	; -,読み込みアドレス加算
	mulw.xyz	vf19,vf18,vf18		ibgtz		vi08,t1f_l00		; ＳＴＱ計算,ループ
	nop								iaddiu		vi10,vi10,DST_NEXT	; -,(遅)書き込みアドレス加算
	; 最後の書き込み
	nop								sq.xyz		vf19,DST_UV1(vi10)	; -,ＳＴＱ格納

	; テクスチャ設定
	nop								iaddiu		vi01,vi13,TX1_OFT	; -,テクスチャ設定
	nop								xgkick		vi01				; -,テクスチャ設定（＆XGKICKウェイト）
	; GIFTAGは既に書き込まれている為いきなり転送
	nop								iaddiu		vi01,vi13,0x04		; 
	nop								sq.z		vf31,0x00(vi01)		; 
	nop								xgkick		vi01				; 
	nop								nop								; 
tex1f_end:

; ================================================================
; テクスチャ２の描画
; ================================================================
tex2f_start:
	nop								mr32.xyzw	vf31,vf31			; GIFTAGレジスタリストシフト
	nop								iaddiu		vi01,vi00,FLAG_UV2	; -,テクスチャ２使用フラグ
	nop								iand		vi01,vi12,vi01		; -,チェック
	nop								ilw.x		vi08,0x00(vi13)		; -,頂点数取得
	nop								ibeq		vi01,vi00,tex2f_end	; -,スキップ
	nop								ilw.y		vi01,0x00(vi13)		; -,ワーク開始位置取得
	nop								iaddiu		vi09,vi13,DAT_OFT	; -,データ読み取りアドレス設定
	nop								iadd		vi10,vi13,vi01		; -,データ書き込みアドレス設定

	; テクスチャ座標をＳＴＱに変換する
	; 最初の１回
	nop								lq.xyz		vf18,SRC_UV2(vi09)	; -,ＵＶ値の読み込み
	nop								lq.w		vf18,SRC_UV1(vi09)	; -,Ｑ値の読み込み
	nop								nop								; -,-
	nop								iaddi		vi08,vi08,-1		; -,カウンタ減算
	nop								iaddiu		vi09,vi09,SRC_NEXT	; -,読み込みアドレス加算
	mulw.xyz	vf19,vf18,vf18		ibgtz		vi08,t2f_l00		; ＳＴＱ計算,ループ
	nop								nop								; -,-
	; ２回目以降
t2f_l00:
	nop								lq.xyz		vf18,SRC_UV2(vi09)	; -,ＵＶ値の読み込み
	nop								lq.w		vf18,SRC_UV1(vi09)	; -,Ｑ値の読み込み
	nop								lq.xyz		vf19,DST_UV2(vi10)	; -,(遅)ＳＴＱ格納
	nop								iaddi		vi08,vi08,-1		; -,カウンタ減算
	nop								iaddiu		vi09,vi09,SRC_NEXT	; -,読み込みアドレス加算
	mulw.xyz	vf19,vf18,vf18		ibgtz		vi08,t2f_l00		; ＳＴＱ計算,ループ
	nop								iaddiu		vi10,vi10,DST_NEXT	; -,(遅)書き込みアドレス加算
	; 最後の書き込み
	nop								lq.xyz		vf19,DST_UV2(vi10)	; -,ＳＴＱ格納

	; テクスチャ設定
	nop								iaddiu		vi01,vi13,TX2_OFT	; -,テクスチャ設定
	nop								xgkick		vi01				; -,テクスチャ設定（＆XGKICKウェイト）
	; GIFTAGは既に書き込まれている為いきなり転送
	nop								iaddiu		vi01,vi13,0x04		; 
	nop								sq.z		vf31,0x00(vi01)		; 
	nop								xgkick		vi01				; 
	nop								nop								; 
tex2f_end:

; ================================================================
; 環境マッピング計算処理
; ================================================================
;	nop								mr32.xyzw	vf31,vf31			; GIFTAGレジスタリストシフト
	nop								iaddiu		vi01,vi00,FLAG_EMAP	; -,バンプ使用フラグ
	nop								iand		vi01,vi12,vi01		; -,チェック
	nop								ilw.y		vi10,0x00(vi13)		; -,ワーク開始位置取得
	nop								ilw.x		vi08,0x00(vi13)		; -,頂点数取得
	nop								ibeq		vi01,vi00,EnvironmentMappingEnd	; -,スキップ
	nop								iaddiu		vi09,vi13,DAT_OFT	; -,データ読み取りアドレス設定
	nop								iadd		vi10,vi13,vi10		; -,データ書き込みアドレス設定

	nop								lq.xyzw		vf04,TX2_OFT+6(vi13); テクスチャ座標スケール取得
	nop								lq.xyzw		vf05,TX2_OFT+7(vi13); テクスチャ座標オフセット取得
	nop								lq.xyzw		vf12,M_OPT0+0x00(vi00)	; 逆カメラマトリクス取得
	nop								lq.xyzw		vf13,M_OPT0+0x01(vi00)	; 逆カメラマトリクス取得
	nop								lq.xyzw		vf14,M_OPT0+0x02(vi00)	; 逆カメラマトリクス取得
	nop								lq.xyzw		vf16,SRC_NORM(vi09)	; 法線読み込み
	nop								mr32.z		vf18,vf00			; Ｑに１を設定しておく
	; テクスチャ座標をＳＴＱに変換する
	; 最初の１回
;	nop								nop								; (遅)ＵＶ算出,(遅)(遅)ＳＴＱ格納
;	nop								nop								; (遅)ＵＶ算出,(遅)(遅)クリップ用保存
	mulax.xyz	ACC ,vf12,vf16		iaddi		vi08,vi08,-1		; 法線変換,カウンタ減算
	madday.xyz	ACC ,vf13,vf16		iaddiu		vi09,vi09,SRC_NEXT	; 法線変換,読み込みアドレス加算
	maddz.xyz	vf17,vf14,vf16		lq.xyzw		vf16,SRC_NORM(vi09)	; 法線変換,(先)法線読み込み
	nop								lq.w		vf18,SRC_UV1 -SRC_NEXT(vi09); (遅)Ｑ補正,(先)Ｑ値の読み込み
;	nop								nop								; -,ループ
;	nop								nop								; -,(遅)書き込みアドレス加算
	; ２回目
	mula.xyz	ACC ,vf17,vf04		nop								; (遅)ＵＶ算出,(遅)(遅)ＳＴＱ格納
	maddw.xy	vf18,vf05,vf00		nop								; (遅)ＵＶ算出,(遅)(遅)クリップ用保存
	mulax.xyz	ACC ,vf12,vf16		iaddi		vi08,vi08,-1		; 法線変換,カウンタ減算
	madday.xyz	ACC ,vf13,vf16		iaddiu		vi09,vi09,SRC_NEXT	; 法線変換,読み込みアドレス加算
	maddz.xyz	vf17,vf14,vf16		lq.xyzw		vf16,SRC_NORM(vi09)	; 法線変換,(先)法線読み込み
	mulw.xyz	vf19,vf18,vf18		lq.w		vf18,SRC_UV1 -SRC_NEXT(vi09); (遅)Ｑ補正,(先)Ｑ値の読み込み
;	nop								nop								; -,ループ
;	nop								nop								; -,(遅)書き込みアドレス加算
	; ３回目以降
em_l00:
	mula.xyz	ACC ,vf17,vf04		sq.xyz		vf18,SRC_UV2-SRC_NEXT*2(vi09)	; (遅)ＵＶ算出,(遅)(遅)ＳＴＱ格納
	maddw.xy	vf18,vf05,vf00		sq.xyz		vf19,DST_UV2(vi10)	; (遅)ＵＶ算出,(遅)(遅)クリップ用保存
	mulax.xyz	ACC ,vf12,vf16		iaddi		vi08,vi08,-1		; 法線変換,カウンタ減算
	madday.xyz	ACC ,vf13,vf16		iaddiu		vi09,vi09,SRC_NEXT	; 法線変換,読み込みアドレス加算
	maddz.xyz	vf17,vf14,vf16		lq.xyzw		vf16,SRC_NORM(vi09)	; 法線変換,(先)法線読み込み
	mulw.xyz	vf19,vf18,vf18		lq.w		vf18,SRC_UV1 -SRC_NEXT(vi09)	; (遅)Ｑ補正,(先)Ｑ値の読み込み
	nop								ibgtz		vi08,em_l00			; -,ループ
	nop								iaddiu		vi10,vi10,DST_NEXT	; -,(遅)書き込みアドレス加算
	; 最後の書き込み
	mula.xyz	ACC ,vf17,vf04		sq.xyz		vf18,SRC_UV2-SRC_NEXT*2(vi09)	; (遅)ＵＶ算出,(遅)(遅)ＳＴＱ格納
	maddw.xy	vf18,vf05,vf00		sq.xyz		vf19,DST_UV2(vi10)	; (遅)ＵＶ算出,(遅)(遅)クリップ用保存
;	nop								nop								; 法線変換,カウンタ減算
;	nop								nop								; 法線変換,読み込みアドレス加算
;	nop								nop								; 法線変換,(先)法線読み込み
	mulw.xyz	vf19,vf18,vf18		nop								; (遅)Ｑ補正,(先)Ｑ値の読み込み
;	nop								nop								; -,ループ
	nop								iaddiu		vi10,vi10,DST_NEXT	; -,(遅)書き込みアドレス加算

	nop								sq.xyz		vf18,SRC_UV2-SRC_NEXT*1(vi09)	; (遅)ＵＶ算出,(遅)(遅)ＳＴＱ格納
	nop								sq.xyz		vf19,DST_UV2(vi10)	; (遅)ＵＶ算出,(遅)(遅)クリップ用保存
;	nop								nop								; 法線変換,カウンタ減算
;	nop								nop								; 法線変換,読み込みアドレス加算
;	nop								nop								; 法線変換,(先)法線読み込み
;	nop								nop								; (遅)Ｑ補正,(先)Ｑ値の読み込み
;	nop								nop								; -,ループ
;	nop								nop								; -,(遅)書き込みアドレス加算

	; テクスチャ設定
	nop								iaddiu		vi01,vi13,TX2_OFT	; -,テクスチャ設定
	nop								xgkick		vi01				; -,テクスチャ設定（＆XGKICKウェイト）
	; GIFTAGは既に書き込まれている為いきなり転送
	nop								iaddiu		vi01,vi13,0x04		; 
	nop								sq.z		vf31,0x00(vi01)		; 
	nop								xgkick		vi01				; 
	nop								nop								; 
EnvironmentMappingEnd:

; ================================================================
; バンプマッピング計算処理
; ================================================================
	nop								iaddiu		vi01,vi00,FLAG_BMAP	; -,バンプ使用フラグ
	nop								iand		vi01,vi12,vi01		; -,チェック
	nop								ilw.x		vi08,0x00(vi13)		; -,頂点数取得
	nop								ibeq		vi01,vi00,BumpMappingEnd	; -,スキップ
	nop								nop								; 
; ＜未実装＞
BumpMappingEnd:


; ================================================================
; クリップルーチン用レジスタ割り当て
; ================================================================
;	vf00:fix
;	vf01:定数読み込みベクトル
;	vf02:プリミティブ座標変換スケール
;	vf03:プリミティブ座標変換オフセット
;	vf04:クリップ頂点保持用
;	vf05:クリップ頂点保持用
;	vf06:クリップ頂点保持用
;	vf07:クリップ頂点保持用
;	vf08:透視変換マトリクス
;	vf09:透視変換マトリクス
;	vf10:透視変換マトリクス
;	vf11:透視変換マトリクス
;	vf12:
;	vf13:
;	vf14:
;	vf15:フォグパラメータ
;	vf16:
;	vf17:
;	vf18:
;	vf19:
;	vf20:
;	vf21:
;	vf22:
;	vf23:
;	vf24:
;	vf25:
;	vf26:
;	vf27:
;	vf28:
;	vf29:
;	vf30:
;	vf31:汎用

;	vi00:０
;	vi01:条件判断又はテンポラリ
;	vi02:クリップ頂点数
;	vi03:一時使用
;	vi04:一時使用
;	vi05:一時使用
;	vi06:
;	vi07:キックフラグ読み込み用
;	vi08:頂点数
;	vi09:読み込みデータアドレス
;	vi10:書き込みデータアドレス
;	vi11:0x4000定数＆汎用
;	vi12:処理フラグ記憶用
;	vi13:バッファ先頭アドレス
;	vi14:ダブルバッファ切り替えフラグ
;	vi15:リンクレジスタ＆クリップ処理チェックフラグ
; ================================================================
; クリッピングルーチン
; ================================================================
	nop								ibeq		vi15,vi00,ProgramEnd; -,クリップ処理スキップ
	nop								ilw.x		vi08,0(vi13)		; 頂点数読み込み
	nop								iaddiu		vi09,vi13,DAT_OFT+SRC_NEXT*2	; -,読み込みアドレス設定
	nop								ilw.w		vi07,SRC_FLG(vi09)	; クリップフラグ読み込み
	nop								iaddi		vi08,vi08,-2		; ２頂点スキップしているので
	nop								iaddiu		vi01,vi13,TX0_OFT	; テクスチャ設定
	nop								xgkick		vi01				; テクスチャ設定（＝ワークが空くまでのウェイト）
	nop								iaddiu		vi14,vi00,0			; ダブルバッファフラグクリア
	nop								iaddiu		vi11,vi00,0x4000	; 定数設定
ClipLoop:
	nop								iand		vi01,vi07,vi11		; フラグチェック
	nop								iaddiu		vi02,vi00,3			; クリップ処理頂点数設定
	nop								ibeq		vi01,vi00,ClipSkip	; 
	nop								fcset		0					; 
	; クリップポリゴン発見時
	nop								ibne		vi14,vi00,l02		; 
	nop								lq.xyzw		vf04,SRC_XYZW-SRC_NEXT*2(vi09)	; -,第１座標読み込み
	nop								b			l03					; 
	nop								iaddiu		vi10,vi13,CWORK1	; 
l02:nop								iaddiu		vi10,vi13,CWORK2	;
l03:nop								lq.xyzw		vf05,SRC_XYZW-SRC_NEXT*1(vi09)	; -,第２座標読み込み
	nop								lq.xyzw		vf06,SRC_XYZW-SRC_NEXT*0(vi09)	; -,第３座標読み込み
	clipw.xyz	vf04,vf04			lq.xyzw		vf16,SRC_COL -SRC_NEXT*2(vi09)	; ,第１カラー読み込み
	clipw.xyz	vf05,vf05			lq.xyzw		vf17,SRC_UV0 -SRC_NEXT*2(vi09)	; ,第１ＵＶ０読み込み
	clipw.xyz	vf06,vf06			lq.xyzw		vf18,SRC_UV1 -SRC_NEXT*2(vi09)	; ,第１ＵＶ１読み込み
	nop								lq.xyzw		vf19,SRC_UV2 -SRC_NEXT*2(vi09)	; -,第１ＵＶ２読み込み
	nop								fcget		vi03							; 
	nop								fcget		vi04							; 
	nop								iand		vi03,vi03,vi04					; 
	nop								fcget		vi04							; 
	nop								iand		vi03,vi03,vi04					; 
	nop								sq.xyzw		vf16,DST_COL +DST_NEXT*0(vi10)	; 第１カラー書き込み
	nop								ibne		vi03,vi00,ClipSkip				; 
	nop								sq.xyzw		vf17,DST_UV0 +DST_NEXT*0(vi10)	; 第１ＵＶ０書き込み
	nop								sq.xyzw		vf18,DST_UV1 +DST_NEXT*0(vi10)	; 第１ＵＶ１書き込み
	nop								sq.xyzw		vf19,DST_UV2 +DST_NEXT*0(vi10)	; 第１ＵＶ２書き込み
	nop								lq.xyzw		vf16,SRC_COL -SRC_NEXT*1(vi09)	; 第２カラー読み込み
	nop								lq.xyzw		vf17,SRC_UV0 -SRC_NEXT*1(vi09)	; 第２ＵＶ０読み込み
	nop								lq.xyzw		vf18,SRC_UV1 -SRC_NEXT*1(vi09)	; 第２ＵＶ１読み込み
	nop								lq.xyzw		vf19,SRC_UV2 -SRC_NEXT*1(vi09)	; 第２ＵＶ２読み込み
	nop								sq.xyzw		vf16,DST_COL +DST_NEXT*1(vi10)	; 第２カラー書き込み
	nop								sq.xyzw		vf17,DST_UV0 +DST_NEXT*1(vi10)	; 第２ＵＶ０書き込み
	nop								sq.xyzw		vf18,DST_UV1 +DST_NEXT*1(vi10)	; 第２ＵＶ１書き込み
	nop								sq.xyzw		vf19,DST_UV2 +DST_NEXT*1(vi10)	; 第２ＵＶ２書き込み
	nop								lq.xyzw		vf16,SRC_COL -SRC_NEXT*0(vi09)	; 第３カラー読み込み
	nop								lq.xyzw		vf17,SRC_UV0 -SRC_NEXT*0(vi09)	; 第３ＵＶ０読み込み
	nop								lq.xyzw		vf18,SRC_UV1 -SRC_NEXT*0(vi09)	; 第３ＵＶ１読み込み
	nop								lq.xyzw		vf19,SRC_UV2 -SRC_NEXT*0(vi09)	; 第３ＵＶ２読み込み
	nop								sq.xyzw		vf16,DST_COL +DST_NEXT*2(vi10)	; 第３カラー書き込み
	nop								sq.xyzw		vf17,DST_UV0 +DST_NEXT*2(vi10)	; 第３ＵＶ０書き込み
	nop								sq.xyzw		vf18,DST_UV1 +DST_NEXT*2(vi10)	; 第３ＵＶ１書き込み
	nop								sq.xyzw		vf19,DST_UV2 +DST_NEXT*2(vi10)	; 第３ＵＶ２書き込み
	nop								sq.xyzw		vf04,DST_XYZ +DST_NEXT*0(vi10)	; 第１座標書き込み
	nop								sq.xyzw		vf05,DST_XYZ +DST_NEXT*1(vi10)	; 第２座標書き込み
	nop								sq.xyzw		vf06,DST_XYZ +DST_NEXT*2(vi10)	; 第３座標書き込み

	nop								fcand		vi01,0x10410		; 
	nop								ibeq		vi01,vi00,_clip_6	; 
	nop								nop								; 
	nop								bal			vi15,ZClip_p		; Ｚ＝Ｗ面によるクリップ
	nop								nop								; 
_clip_6:
	nop								bal			vi15,CorrectColor	; ＲＧＢＡ補正
	nop								nop								; 
	nop								fcand		vi01,0x820820		; 
	nop								ibeq		vi01,vi00,_clip_1	; 
	nop								nop								; 
	nop								bal			vi15,ZClip_m		; Ｚ＝−Ｗ面によるクリップ
	nop								nop								; 
_clip_1:
	nop								fcand		vi01,0x041041		; 
	nop								ibeq		vi01,vi00,_clip_2	; 
	nop								nop								; 
	nop								bal			vi15,XClip_p		; Ｘ＝Ｗ面によるクリップ
	nop								nop								; 
_clip_2:
	nop								fcand		vi01,0x082082		; 
	nop								ibeq		vi01,vi00,_clip_3	; 
	nop								nop								; 
	nop								bal			vi15,XClip_m		; Ｘ＝−Ｗ面によるクリップ
	nop								nop								; 
_clip_3:
	nop								fcand		vi01,0x104104		; 
	nop								ibeq		vi01,vi00,_clip_4	; 
	nop								nop								; 
	nop								bal			vi15,YClip_p		; Ｙ＝Ｗ面によるクリップ
	nop								nop								; 
_clip_4:
	nop								fcand		vi01,0x208208		; 
	nop								ibeq		vi01,vi00,_clip_5	; 
	nop								nop								; 
	nop								bal			vi15,YClip_m		; Ｙ＝−Ｗ面によるクリップ
	nop								nop								; 
_clip_5:

	; クリップ後に頂点が存在すれば描画を行う
	nop								isubiu		vi01,vi02,3			; 
	nop								lq.xyzw		vf16,2(vi13)		; ＧＩＦタグ読み込み
	nop								ibltz		vi01,ClipSkip		; 
	nop								iaddiu		vi01,vi00,0x4000	; 
	mulx.xyzw	vf27,vf27,vf00		iadd		vi01,vi01,vi01		; 
	nop								ior			vi01,vi01,vi02		; 
	nop								iaddi		vi10,vi10,-1		; 
	nop								loi			0.5					; ＲＧＢＡ四捨五入用定数
	addi.xyz	vf27,vf27,I			sq.yzw		vf16,0(vi10)		; alphaには四捨五入を行なわない
	nop								isw.x		vi01,0(vi10)		; 
	nop								iaddiu		vi03,vi10,1			; 
	; 座標変換処理他
	nop								lq.xyzw		vf16,DST_XYZ(vi03)	; 
	nop								lq.xyzw		vf17,DST_COL(vi03)	; 
	nop								lq.xyzw		vf18,DST_UV0(vi03)	; 
