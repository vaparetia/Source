	mulax.xyzw	ACC ,vf27,vf21		iblez		vi06,EnvelopeEndLarge	; 頂点合計加算,計算終了
	maddy.xyzw	vf27,vf25,vf21		nop								; 頂点合計加算,-

	; 第３マトリクス計算（以下、基本的に繰り返し）
