; --------------------------------------
; ノーマルスプライト用ルーチン
; --------------------------------------

;	浮動小数点レジスタ使用状況
;	vf0:fix
;	vf1:定数読み込みベクトル
;	vf2:プリミティブ座標へのスケール値
;	vf3:プリミティブ座標へのオフセット
;	vf4~vf7:透視変換マトリクス
;	vf8~vf11:作業用
;	vf12:頂点読み込み
;	vf13:色読み込み
;	vf14:スプライトサイズ読み込み
;	vf15:
;	vf16~19:整数＞浮動小数点変換用
;	vf20:透視変換直後座標
;	vf21:アスペクト比
;	vf22~23:作業用
;	vf24~27:作業用
;	vf28:
;	vf29:クリップ処理用
;	vf30:クリップ処理用
;	vf31:フォグパラメータ
;	整数レジスタ使用状況
;	vi0:０固定
;	vi1:フラグ受け取り用
;	vi2:ＧＩＦキックアドレス
;	vi3:読み出し頂点処理アドレス
;	vi4:汎用
;	vi5:汎用
;	vi6:汎用
;	vi7:描画キックフラグの記憶
;	vi8:頂点数（＝ループカウンタ）
;	vi9:描画カウント（画面外に頂点があると３が代入されカウントが０になるとそのポリゴンは完全に画面内と判定できる）
;	vi10:Ｗの符号チェック用定数
;	vi11:Ｗの符号チェック結果格納用変数
;	vi12:リザーブ
;	vi13:バッファ先頭アドレス（インクリメントしてキックアドレスとして使用する）
;	vi14:スタック
;	vi15:リンクレジスタ
;	

	; 長方形スプライトルーチン補足
	; ２頂点分のデータで１つのスプライトを構成する
	; フォグは２頂点めの値のみが有効になるので１頂点目のＦにはゴミが入っている
	; 色はフラットシェーディングにした上で１頂点目のカラーを有効にする
	; （２頂点めのカラーはサイズ情報に使用するためNOPレジスタへの書き込みにしておく）
;	upper		.					lower		.
ClipPrimSprtTransStart:
	; 変換初期化処理
	; バッファアドレス、ループ回数のセットとデータのプリロード処理
	nop								xtop		vi13						; 
	nop								lq.xyzw		vf02,FV_SCN(vi00)			; 
	nop								lq.xyzw		vf03,FV_OFT(vi00)			; 
	nop								lq.xyzw		vf01,FV_PRM(vi00)			; 
	nop								ilw.x		vi08,PACKDAT(vi13)			; -,処理頂点数の読み込み
	nop								lq.yzw		vf04,GIFNORMAL(vi13)		; -,GIFタグ生成
	nop								iaddiu		vi01,vi00,0x4000			; -,GIFタグ生成
	nop								iadd		vi01,vi01,vi01				; -,GIFタグ生成
	nop								ior			vi01,vi01,vi08				; -,GIFタグ生成
	nop								isw.x		vi01,WORK_TOP(vi13)			; -,GIFタグ生成
	nop								sq.yzw		vf04,WORK_TOP(vi13)			; -,GIFタグ生成
	nop								lq.xyzw		vf04,M_OPT0(vi13)			; -,透視変換マトリクスロード
	nop								lq.xyzw		vf05,M_OPT1(vi13)			; -,透視変換マトリクスロード
	nop								lq.xyzw		vf06,M_OPT2(vi13)			; -,透視変換マトリクスロード
	nop								lq.xyzw		vf07,M_OPT3(vi13)			; -,透視変換マトリクスロード
	nop								lq.xyzw		vf21,FV_ASPC(vi00)			; 
	mulx.zw		vf14,vf00,vf00		nop										; 
	nop								iaddiu		vi03,vi13,DATA_OFT			; データ先読みアドレス設定
	nop								lq.xy		vf14,SPRT_WH(vi03)			; （先）サイズ
	nop								lq.xyzw		vf12,SPRT_XYZ(vi03)			; （先）座標
	nop								iaddiu		vi02,vi13,PACK_TOP			; データ書き戻しアドレス設定
	nop								ilw.x		vi08,PACKDAT(vi13)			; 処理頂点数の読み込み
	itof0.xy	vf14,vf14			nop										; （先）サイズ,
	nop								iaddiu		vi09,vi00,0					; 
	nop								iaddiu		vi10,vi00,0x0010			; 
	nop								lq.xyzw		vf31,FV_FOG(vi00)			; フォグ係数読み込み
	nop								iaddiu		vi06,vi00,0x4000			; 
	nop								iadd		vi06,vi06,vi06				; 
	nop								fcset		0							; クリップチェック初期化

_ClipPrimSprtTransLoop:
	mulax.xyzw	ACC ,vf4,vf12		lq.xyzw		vf16,SPRT_UV0(vi03)			; 透視変換,
	madday.xyzw	ACC ,vf5,vf12		lq.xyzw		vf17,SPRT_UV1(vi03)			; 透視変換,
	maddaz.xyzw	ACC ,vf6,vf12		lq.xyzw		vf13,SPRT_COL(vi03)			; 透視変換,
	maddw.xyzw	vf20,vf7,vf00		isw.w		vi06,DST_XYZ+DST_NEXT(vi02)	; 透視変換,とりあえず無条件に非表示に
	itof12.xyz	vf16,vf16			nop										; ＵＶ,
	itof12.xyz	vf17,vf17			nop										; ＵＶ,
	maddaw.xyzw	ACC ,vf07,vf00		nop										; 
	msub.xyzw	vf08,vf14,vf21		div			Q,vf00w,vf20w				; 左上作成,除算
	madd.xyz	vf09,vf14,vf21		fcset		0							; 右下作成,
	mulax.w		ACC ,vf20,vf31		iaddiu		vi03,vi03,SPRT_NEXT			; フォグ,読み込みアドレス増加
	maddy.w		vf09,vf00,vf31		iaddi		vi08,vi08,-1				; フォグ,ループ数減算

	clipw.xyz	vf08,vf08			lq.xy		vf14,SPRT_WH(vi03)			; ＸＹクリップ,（先）サイズ
	clipw.xyz	vf09,vf08			lq.xyzw		vf12,SPRT_XYZ(vi03)			; ＸＹクリップ,（先）座標
	nop								nop										; 
	maxx.w		vf09,vf09,vf00		nop										; フォグ
	itof0.xy	vf14,vf14			nop										; （先）サイズ
	mulq.xyzw	vf08,vf08,Q			fcand		vi01,0x0fff					; 透視変換,完全画面内チェック
	mulq.xyz	vf09,vf09,Q			ibeq		vi01,vi00,_sprt_c3			; 透視変換,
	nop								fcand		vi01,0x0d7a					; 完全画面外チェック
	nop								ibne		vi01,vi00,_sprt_next		; 

	nop								fcand		vi01,0x0080					; 左上−Ｘチェック準備
	sub.x		vf30,vf09,vf08		ibeq		vi01,vi00,_sprt_c0			; 左上−Ｘチェック
	addw.x		vf29,vf09,vf00		fcand		vi01,0x0200					; 左上−Ｙチェック準備
	sub.x		vf29,vf16,vf17		div			Q,vf29x,vf30x				; 
	subw.x		vf08,vf00,vf00		nop										; 
	adda.x		ACC ,vf17,vf00		nop										; 
	maddq.x		vf16,vf29,Q			waitq									; 
_sprt_c0:
	sub.y		vf30,vf09,vf08		ibeq		vi01,vi00,_sprt_c1			; 左上−Ｙチェック
	addw.y		vf29,vf09,vf00		fcand		vi01,0x0001					; 右下＋Ｘチェック準備
	sub.y		vf29,vf16,vf17		div			Q,vf29y,vf30y				; 
	subw.y		vf8,vf00,vf00		nop										; 
	adda.y		ACC ,vf17,vf00		nop										; 
	maddq.y		vf16,vf29,Q			waitq									; 
_sprt_c1:
	sub.x		vf30,vf08,vf09		ibeq		vi01,vi00,_sprt_c2			; 右下＋Ｘチェック
	subw.x		vf29,vf08,vf00		fcand		vi01,0x0004					; 右下＋Ｙチェック準備
	sub.x		vf29,vf17,vf16		div			Q,vf29x,vf30x				; 
	addw.x		vf09,vf00,vf00		nop										; 
	adda.x		ACC ,vf16,vf00		nop										; 
	maddq.x		vf17,vf29,Q			waitq									; 
_sprt_c2:
	sub.y		vf30,vf08,vf09		ibeq		vi01,vi00,_sprt_c3			; 右下＋Ｙチェック
	subw.y		vf29,vf08,vf00		nop										; 
	sub.y		vf29,vf17,vf16		div			Q,vf29y,vf30y				; 
	addw.y		vf09,vf00,vf00		nop										; 
	adda.y		ACC ,vf16,vf00		nop										; 
	maddq.y		vf17,vf29,Q			waitq									; 
_sprt_c3:
	minix.w		vf09,vf09,vf01		nop										; フォグ,
	mula.xyz	ACC ,vf08,vf02		nop										; プリミティブ座標変換
	maddw.xyz	vf08,vf03,vf00		nop										; プリミティブ座標変換
	mula.xyz	ACC ,vf09,vf02		sq.xyzw		vf16,DST_UV0(vi02)			; プリミティブ座標変換,ＵＶ書き込み
	maddw.xyz	vf09,vf03,vf00		sq.xyzw		vf17,DST_UV0+DST_NEXT(vi02)	; プリミティブ座標変換,ＵＶ書き込み
	nop								nop										; 
	ftoi4.xyzw	vf08,vf08			nop										; 座標整数化
	ftoi4.xyzw	vf09,vf09			nop										; 座標整数化
	nop								nop										; 
	nop								sq.xyzw		vf13,DST_COL(vi02)			; ,色書き込み
	nop								sq.xyzw		vf08,DST_XYZ(vi02)			; 
	nop								sq.xyzw		vf09,DST_XYZ+DST_NEXT(vi02)	; 
_sprt_next:
	nop								ibgez		vi08,_ClipPrimSprtTransLoop ;
	nop								iaddiu		vi02,vi02,DST_NEXT*2		; 書き込みアドレス増加

	nop								iaddiu		vi01,vi13,TX0_OFT			; ,テクスチャ設定
	nop								xgkick		vi01						; ,テクスチャ設定
	nop								iaddiu		vi01,vi13,WORK_TOP			; 
	nop								xgkick		vi01						; ＧＩＦへのキック
	nop								nop										; 
	nop[e]							nop										; 
	nop								nop										; 

	; 回転スプライトルーチン補足
	; ４頂点分のデータで１つのスプライトを構成する
	; 最初に必要なデータは通常スプライトと同じであるが、並びが違うので注意
	; データ先頭+00:第１頂点−中心座標
	; 　　　　　+01:第１頂点−色情報
	; 　　　　　+02:第１頂点−ＵＶ左上座標
	; 　　　　　+03:第１頂点−サイズ情報
	; 　　　　　+04:第１頂点−ＵＶ右下座標
	; 　　　　　+0c:第２頂点−ＵＶ左上座標
	; 　　　　　+0d:第２頂点−中心座標
	; 　　　　　 .
	; 　　　　　 .
	; 　　　　　 .
	; 表示は４点のトライアングルストリップとして描画し、クリップルーチンも
	; ポリゴン用と同じ物を使用する

;	upper		.					lower		.
ClipPrimRSprtTransStart:
	; 変換初期化処理
	; バッファアドレス、ループ回数のセットとデータのプリロード処理
	nop								xtop		vi13						; 
	nop								lq.xyzw		vf02,FV_SCN(vi00)			; 
	nop								lq.xyzw		vf03,FV_OFT(vi00)			; 
	nop								lq.xyzw		vf01,FV_PRM(vi00)			; 
	nop								ilw.x		vi08,PACKDAT(vi13)			; -,処理頂点数の読み込み
	nop								lq.yzw		vf04,GIFNORMAL(vi13)		; -,GIFタグ生成
	nop								iaddiu		vi01,vi00,0x4000			; -,GIFタグ生成
	nop								iadd		vi01,vi01,vi01				; -,GIFタグ生成
	nop								iadd		vi04,vi08,vi08				; クリップ処理用頂点数計算
	nop								iadd		vi04,vi04,vi04				; クリップ処理用頂点数計算
	nop								isw.x		vi04,PACKDAT(vi13)			; クリップ処理用頂点数計算
	nop								ior			vi01,vi01,vi04				; -,GIFタグ生成
	nop								isw.x		vi01,WORK_TOP(vi13)			; -,GIFタグ生成
	nop								sq.yzw		vf04,WORK_TOP(vi13)			; -,GIFタグ生成
	nop								lq.xyzw		vf21,FV_ASPC(vi00)			; 
	nop								lq.xyzw		vf04,M_OPT0(vi13)			; -,透視変換マトリクスロード
	nop								lq.xyzw		vf05,M_OPT1(vi13)			; -,透視変換マトリクスロード
	nop								lq.xyzw		vf06,M_OPT2(vi13)			; -,透視変換マトリクスロード
	nop								lq.xyzw		vf07,M_OPT3(vi13)			; -,透視変換マトリクスロード
	mulx.zw		vf14,vf00,vf00		iaddiu		vi03,vi13,DATA_OFT			; データ先読みアドレス設定
	nop								lq.xy		vf14,RSPRT_WH(vi03)			; （先）サイズ
	nop								lq.xyzw		vf12,RSPRT_XYZ(vi03)		; （先）座標
	nop								iaddiu		vi02,vi13,PACK_TOP			; データ書き戻しアドレス設定
	nop								lq.xyzw		vf31,FV_FOG(vi00)			; フォグ係数読み込み
	itof0.xy	vf14,vf14			iaddiu		vi06,vi00,0x4000			; 描画キックフラグ作成
	nop								iadd		vi06,vi06,vi06				; 描画キックフラグ作成
	nop								fcset		0							; クリップチェック初期化
	nop								iaddiu		vi15,vi00,0					; クリップチェック初期化

_ClipPrimRSprtTransLoop:
	mulax.xyzw	ACC ,vf04,vf12		lq.xyzw		vf16,RSPRT_UV0(vi03)		; 透視変換,
	madday.xyzw	ACC ,vf05,vf12		lq.xyzw		vf19,RSPRT_UV1(vi03)		; 透視変換,
	maddaz.xyzw	ACC ,vf06,vf12		lq.xyzw		vf13,RSPRT_COL(vi03)		; 透視変換,
	maddw.xyzw	vf20,vf07,vf00		isw.w		vi06,SRC_FLG+SRC_NEXT*0(vi03);透視変換,クリップ用に無条件に非表示に
	itof12.xyz	vf16,vf16			isw.w		vi06,SRC_FLG+SRC_NEXT*1(vi03);ＵＶ,クリップ用に無条件に非表示に
	itof12.xyz	vf19,vf19			isw.w		vi06,SRC_FLG+SRC_NEXT*2(vi03);ＵＶ,クリップ用に無条件に非表示に
	maddaw.xyzw	ACC ,vf07,vf00		isw.w		vi06,SRC_FLG+SRC_NEXT*3(vi03);頂点増殖準備,クリップ用に無条件に非表示に
	msub.xyzw	vf08,vf21,vf14		div			Q,vf00w,vf20w				; 左上作成,除算
	madd.xyzw	vf11,vf21,vf14		iaddiu		vi03,vi03,RSPRT_NEXT		; 右下作成,読み込みアドレス増加
	maddy.x		vf09,vf21,vf14		move.zw		vf10,vf20					; 頂点増殖,頂点増殖
	msubx.y		vf09,vf21,vf14		fcset		0							; 頂点増殖,クリップ準備
	msuby.x		vf10,vf21,vf14		move.zw		vf09,vf20					; 頂点増殖,頂点増殖
	maddx.y		vf10,vf21,vf14		iaddi		vi08,vi08,-1				; 頂点増殖,ループ数減算
	mulax.w		ACC ,vf20,vf31		move.yz		vf17,vf16					; フォグ,ＵＶ増殖
	maddy.w		vf30,vf00,vf31		move.x		vf17,vf19					; フォグ,ＵＶ増殖

	clipw.xyz	vf08,vf08			move.xz		vf18,vf16					; クリップ,ＵＶ増殖
	clipw.xyz	vf09,vf09			move.y		vf18,vf19					; クリップ,ＵＶ増殖
	clipw.xyz	vf10,vf10			lq.xy		vf14,RSPRT_WH(vi03)			; クリップ,（先）サイズ
	clipw.xyz	vf11,vf11			lq.xyzw		vf12,RSPRT_XYZ(vi03)		; クリップ,（先）座標
	maxx.w		vf30,vf30,vf00		fcget		vi04						; フォグ,クリップ
	nop								fcget		vi05						; ,クリップ
	nop								fcget		vi07						; ,キックフラグ書き込み
	nop								fcand		vi01,0xffffff				; ,完全画面内チェック
	minix.w		vf30,vf30,vf01		ibeq		vi01,vi00,_rsprt_c1			; フォグ,
	nop								fcget		vi01						; ,
	nop								iand		vi01,vi01,vi04				; 
	nop								iand		vi01,vi01,vi05				; 
	nop								iand		vi01,vi01,vi07				; 
	nop								isw.w		vi06,DST_XYZ+DST_NEXT*0(vi02); ,キックフラグ書き込み
	nop								isw.w		vi06,DST_XYZ+DST_NEXT*1(vi02); ,キックフラグ書き込み
	nop								isw.w		vi06,DST_XYZ+DST_NEXT*2(vi02); ,キックフラグ書き込み
	nop								ibne		vi01,vi0,_rsprt_next		; 
	nop								isw.w		vi06,DST_XYZ+DST_NEXT*3(vi02); ,キックフラグ書き込み

_rsprt_c0:
	nop								iaddiu		vi04,vi06,0x4fff			; ,
	nop								isw.w		vi04,SRC_FLG+SRC_NEXT*2-RSPRT_NEXT(vi03); ,キックフラグ書き込み
	nop								isw.w		vi04,SRC_FLG+SRC_NEXT*3-RSPRT_NEXT(vi03); ,キックフラグ書き込み
	itof0.xyzw	vf13,vf13			sq.xyz		vf16,SRC_UV0+SRC_NEXT*0-RSPRT_NEXT(vi03); ,ＵＶ書き込み
	nop								sq.xyz		vf17,SRC_UV0+SRC_NEXT*1-RSPRT_NEXT(vi03); ,ＵＶ書き込み
	nop								sq.xyz		vf18,SRC_UV0+SRC_NEXT*2-RSPRT_NEXT(vi03); ,ＵＶ書き込み
	nop								sq.xyz		vf19,SRC_UV0+SRC_NEXT*3-RSPRT_NEXT(vi03); ,ＵＶ書き込み
	nop								sq.xyzw		vf13,SRC_COL+SRC_NEXT*0-RSPRT_NEXT(vi03); ,色書き込み
	nop								sq.xyzw		vf13,SRC_COL+SRC_NEXT*1-RSPRT_NEXT(vi03); ,色書き込み
	nop								sq.xyzw		vf13,SRC_COL+SRC_NEXT*2-RSPRT_NEXT(vi03); ,色書き込み
	nop								sq.xyzw		vf13,SRC_COL+SRC_NEXT*3-RSPRT_NEXT(vi03); ,色書き込み
	nop								sq.xyzw		vf08,SRC_XYZW+SRC_NEXT*0-RSPRT_NEXT(vi03); ,座標書き込み
	nop								sq.xyzw		vf09,SRC_XYZW+SRC_NEXT*1-RSPRT_NEXT(vi03); ,座標書き込み
	nop								sq.xyzw		vf10,SRC_XYZW+SRC_NEXT*2-RSPRT_NEXT(vi03); ,座標書き込み
	nop								sq.xyzw		vf11,SRC_XYZW+SRC_NEXT*3-RSPRT_NEXT(vi03); ,座標書き込み
	nop								b			_rsprt_next					; 
	nop								iaddiu		vi15,vi15,1					; 

_rsprt_c1:
	mulq.xyzw	vf08,vf08,Q			nop										; 透視変換,
	mulq.xyzw	vf09,vf09,Q			nop										; 透視変換,
	mulq.xyzw	vf10,vf10,Q			nop										; 透視変換,
	mulq.xyzw	vf11,vf11,Q			nop										; 透視変換,
	mula.xyz	ACC ,vf08,vf02		sq.xyzw		vf16,DST_UV0+DST_NEXT*0(vi02); プリミティブ座標変換,ＵＶ書き込み
	maddw.xyz	vf08,vf03,vf00		sq.xyzw		vf17,DST_UV0+DST_NEXT*1(vi02); プリミティブ座標変換,ＵＶ書き込み
	ftoi4.w		vf30,vf30			sq.xyzw		vf18,DST_UV0+DST_NEXT*2(vi02); フォグ,ＵＶ書き込み
	mula.xyz	ACC ,vf09,vf02		sq.xyzw		vf19,DST_UV0+DST_NEXT*3(vi02); プリミティブ座標変換,ＵＶ書き込み
	maddw.xyz	vf09,vf03,vf00		sq.xyzw		vf13,DST_COL+DST_NEXT*0(vi02); プリミティブ座標変換,色書き込み
	mula.xyz	ACC ,vf10,vf02		sq.xyzw		vf13,DST_COL+DST_NEXT*1(vi02); プリミティブ座標変換,色書き込み
	maddw.xyz	vf10,vf03,vf00		mtir		vi04,vf30w					; プリミティブ座標変換,フォグ
	mula.xyz	ACC ,vf11,vf02		sq.xyzw		vf13,DST_COL+DST_NEXT*2(vi02); プリミティブ座標変換,色書き込み
	maddw.xyz	vf11,vf03,vf00		sq.xyzw		vf13,DST_COL+DST_NEXT*3(vi02); プリミティブ座標変換,色書き込み
	ftoi4.xyzw	vf08,vf08			sq.w		vf30,DST_XYZ+DST_NEXT*2(vi02); 座標整数化,キックフラグ書き込み
	ftoi4.xyzw	vf09,vf09			iadd		vi05,vi04,vi06				; 座標整数化,
	ftoi4.xyzw	vf10,vf10			isw.w		vi05,DST_XYZ+DST_NEXT*0(vi02); 座標整数化,キックフラグ書き込み
	ftoi4.xyzw	vf11,vf11			isw.w		vi05,DST_XYZ+DST_NEXT*1(vi02); 座標整数化,キックフラグ書き込み
	nop								sq.xyz		vf08,DST_XYZ+DST_NEXT*0(vi02); ,座標書き込み
	nop								sq.xyz		vf09,DST_XYZ+DST_NEXT*1(vi02); ,座標書き込み
