;
;	t2_prim.vu1
;	クリップ処理付きプリミティブ描画ＶＵ１プログラム（フォグ対応）
;
;	2000/02/17 K.Takabe
;	$Id: t2_prim.vu1,v 1.1.1.3 2002/11/19 11:42:28 Yoshizawa1 Exp $
;

;
;	浮動小数点レジスタ使用状況
;	vf0:fix
;	vf1:定数読み込みベクトル
;	vf2:プリミティブ座標へのスケール値
;	vf3:プリミティブ座標へのオフセット
;	vf4~vf7:透視変換マトリクス
;	vf8~vf11:作業用マトリクス（ライトマトリクス等）
;	vf12:頂点読み込み
;	vf13:法線読み込み
;	vf14:ＵＶ値読み込み
;	vf15:リザーブ（頂点データ読み込み）
;	vf16~19:リザーブ（マトリクス）
;	vf20:透視変換直後座標
;	vf21:光源計算用ワーク
;	vf22~23:作業用
;	vf24~27:作業用
;	vf28:描画頂点データ
;	vf29:色データ
;	vf30:テクスチャ座標
;	vf31:リザーブ（変換後頂点データ）
;	
;	整数レジスタ使用状況
;	vi0:０固定
;	vi1:フラグ受け取り用
;	vi2:ＧＩＦキックアドレス
;	vi3:読み出し頂点処理アドレス
;	vi4:汎用
;	vi5:汎用
;	vi6:汎用
;	vi7:描画キックフラグの記憶
;	vi8:頂点数（＝ループカウンタ）
;	vi9:描画カウント（画面外に頂点があると３が代入されカウントが０になるとそのポリゴンは完全に画面内と判定できる）
;	vi10:Ｗの符号チェック用定数
;	vi11:Ｗの符号チェック結果格納用変数
;	vi12:リザーブ
;	vi13:バッファ先頭アドレス（インクリメントしてキックアドレスとして使用する）
;	vi14:スタック
;	vi15:リンクレジスタ
;	

; メモリ使用構成（ＶＵ１側から見るときには下位４ビットを無視すること）
; 0x0000~0x01ff	プログラムワーク
; 0x0200~0x03ff オブジェクトパラメータ設定（変換マトリクス等）
; 0x0400~0x21ff ダブルバッファ０
;  +0x0000_0x0eff 転送用バッファ
;  +0x0f00_0x1cff 読み込み用バッファ
; 0x2200~0x3fff ダブルバッファ１
;  +0x0000_0x0eff 転送用バッファ
;  +0x0f00_0x1cff 読み込み用バッファ
; 0x4000		最終アドレス
; 

; データフォーマット
; + 0.x    頂点データ数
; + 0.y    データ開始位置
; + 1.xyzw GIFtag（クリップポリゴン用プリミティブ設定ＧＩＦタグ）
; + 2.xyzw PRIM
; + 3.xyzw GIFtag（クリップポリゴン頂点用の転送ＧＩＦタグ）
; + 4.xyzw GIFtag（テクスチャパラメータ設定ＧＩＦタグ）
; + 5.xyzw CLAMP_1
; + 6.xyzw TEX2_1
; + 7.xyzw TEX0_1
; + 8.xyzw ALPHA
; + 9.xyzw GIFtag（頂点の転送ＧＩＦタグ）
; +10.xyzw 第１ＳＴＱ
; +11.xyzw 第１ＲＧＢＡ
; +12.xyzw 第１ＸＹＺＦ
; +13.xyzw 第２ＳＴＱ
; +14.xyzw 第２ＲＧＢＡ
; .
; .
; .
; +f0.xyzw 第１ＵＶデータ
; +f1.xyzw 第１法線データ
; +f2.xyzw 第１頂点データ
; +f3.xyzw 第２ＵＶデータ
; +f4.xyzw 第１法線データ
; 
; 
; 
; 


; --------------------------------------
; 通常ポリゴンプリミティブ用ルーチン
; --------------------------------------
;	upper		.					lower		.
ClipPrimPolyTransStart:
	; 変換初期化処理
	; バッファアドレス、ループ回数のセットとデータのプリロード処理
	nop								xtop		vi13				; -,
	nop								lq.xyzw		vf01,FV_PRM(vi00)	; -,定数読み込み
	nop								lq.xyzw		vf02,FV_SCN(vi00)	; -,定数読みみ込
	nop								lq.xyzw		vf03,FV_OFT(vi00)	; -,定数読み込み
	nop								ilw.x		vi08,PACKDAT(vi13)	; -,処理頂点数の読み込み
	nop								lq.yzw		vf04,GIFNORMAL(vi13); -,GIFタグ生成
	nop								iaddiu		vi01,vi00,0x4000	; -,GIFタグ生成
	nop								iadd		vi01,vi01,vi01		; -,GIFタグ生成
	nop								ior			vi01,vi01,vi08		; -,GIFタグ生成
	nop								isw.x		vi01,WORK_TOP(vi13)	; -,GIFタグ生成
	nop								sq.yzw		vf04,WORK_TOP(vi13)	; -,GIFタグ生成
	nop								iaddiu		vi09,vi13,DATA_OFT	; -,データ先読みアドレス設定
	nop								iaddiu		vi10,vi13,PACK_TOP	; -,データ書き戻しアドレス設定
	nop								lq.xyzw		vf16,BUF_VERT(vi09)	; -,第１頂点読み込み
	nop								lq.xyzw		vf17,BUF_NORM(vi09)	; -,第１法線（＆キック情報）読み込み
	nop								lq.xyzw		vf18,BUF_UV0(vi09)	; -,第１ＵＶ値読み込み
	nop								lq.xyzw		vf04,M_OPT0(vi13)	; -,透視変換マトリクスロード
	nop								lq.xyzw		vf05,M_OPT1(vi13)	; -,透視変換マトリクスロード
	itof0.xyzw	vf23,vf17			lq.xyzw		vf06,M_OPT2(vi13)	; -,透視変換マトリクスロード
	nop								lq.xyzw		vf07,M_OPT3(vi13)	; -,透視変換マトリクスロード
	nop								lq.xyzw		vf31,FV_FOG(vi00)	; フォグ係数読み込み
	nop								iaddiu		vi06,vi00,0x4000	;
	nop								iadd		vi06,vi06,vi06		; vi06 = 0x8000
	nop								iaddiu		vi03,vi06,0x4000	; vi03 = 0xc000
	nop								iaddiu		vi15,vi00,0			; 
	nop								fcset		0						; クリップフラグクリア

	; ディレイ処理の為の前処理
	; 頂点変換処理（途中で次の頂点の情報を読み込んでおく）
	mulax.xyzw	ACC ,vf04,vf16		nop										; 透視変換,(遅)クリップ用保存
	minix.w		vf22,vf22,vf01		ilw.w		vi07,SRC_FLG(vi09)			; (遅)フォグ,描画キック
	madday.xyzw	ACC ,vf05,vf16		iaddiu		vi09,vi09,BUF_NEXT			; 透視変換,先読みアドレス増加
	maddaz.xyzw	ACC ,vf06,vf16		nop										; 透視変換,(遅)ＵＶ座標
	maddw.xyzw	vf19,vf07,vf00		lq.xyzw		vf16,BUF_VERT(vi09)			; 透視変換,(先)頂点読み込み
	add.w		vf22,vf22,vf26		sq.xyzw		vf23,SRC_COL-SRC_NEXT(vi09)	; (遅)フォグ,クリップ用保存
	mula.xyz	ACC ,vf22,vf02		sq.xyzw		vf17,DST_COL(vi10)			; (遅)透視変換,光源計算
	maddw.xyz	vf22,vf03,vf00		iand		vi05,vi07,vi06				; (遅)透視変換,キックフラグ
	clipw.xyz	vf19,vf19			div			Q,vf00w,vf19w				; クリップ,透視変換
	itof12.xyz	vf25,vf18			sq.xyzw		vf19,SRC_XYZW-SRC_NEXT(vi09); ＳＴ座標,クリップ用保存
	mulax.w		ACC ,vf19,vf31		lq.xyzw		vf18,BUF_UV0(vi09)			; フォグ,(先)ＵＶ読み込み
	maddy.w		vf19,vf00,vf31		lq.xyzw		vf17,BUF_NORM(vi09)			; フォグ,(先)光源計算
	ftoi4.xyzw	vf20,vf22			fcand		vi01,0x3ffff				; (遅)透視変換,クリップ
	nop								ibeq		vi01,vi00,la1				; (先)透視変換,クリップ
	nop								isubiu		vi08,vi08,1					; -,カウンタのデクリメント
;	nop								ibltz		vi05,la1					; ●
;	nop								ior			vi05,vi05,vi06				; ●
;	nop								ior			vi07,vi07,vi03				; ●
;	nop								iaddiu		vi15,vi15,1					; ●
la1:mulq.xyz	vf22,vf19,Q			mfir.w		vf26,vi05					; 透視変換,キックフラグ
	maxx.w		vf22,vf19,vf00		nop										; フォグ,(遅)透視変換
	mulq.xyz	vf25,vf25,Q			sq.xyzw		vf25,SRC_UV0-SRC_NEXT(vi09)	; ＳＴ座標,クリップ用保存
	itof0.xyzw	vf23,vf17			ibgtz		vi08,_ClipPrimPolyTransLoop	; 光源計算,ループジャンプ
	itof4.w		vf26,vf26			iaddiu		vi10,vi10,DST_NEXT			; キックフラグ,書き込みアドレス増加

_ClipPrimPolyTransLoop:
	; 頂点変換処理（途中で次の頂点の情報を読み込んでおく）
	mulax.xyzw	ACC ,vf04,vf16		isw.w		vi07,SRC_FLG-SRC_NEXT(vi09)	; 透視変換,(遅)クリップ用保存
	minix.w		vf22,vf22,vf01		ilw.w		vi07,SRC_FLG(vi09)			; (遅)フォグ,描画キック
	madday.xyzw	ACC ,vf05,vf16		iaddiu		vi09,vi09,BUF_NEXT			; 透視変換,先読みアドレス増加
	maddaz.xyzw	ACC ,vf06,vf16		sq.xyz		vf25,DST_UV0-DST_NEXT(vi10)	; 透視変換,(遅)ＵＶ座標
	maddw.xyzw	vf19,vf07,vf00		lq.xyzw		vf16,BUF_VERT(vi09)			; 透視変換,(先)頂点読み込み
	add.w		vf22,vf22,vf26		sq.xyzw		vf23,SRC_COL-SRC_NEXT(vi09)	;(遅)フォグ,クリップ用保存
	mula.xyz	ACC ,vf22,vf02		sq.xyzw		vf17,DST_COL(vi10)			; (遅)透視変換,光源計算
	maddw.xyz	vf22,vf03,vf00		iand		vi05,vi07,vi06				; (遅)透視変換,キックフラグ
	clipw.xyz	vf19,vf19			div			Q,vf00w,vf19w				; クリップ,透視変換
	itof12.xyz	vf25,vf18			sq.xyzw		vf19,SRC_XYZW-SRC_NEXT(vi09); ＳＴ座標,クリップ用保存
	mulax.w		ACC ,vf19,vf31		lq.xyzw		vf18,BUF_UV0(vi09)			; フォグ,(先)ＵＶ読み込み
	maddy.w		vf19,vf00,vf31		lq.xyzw		vf17,BUF_NORM(vi09)			; フォグ,(先)光源計算
	ftoi4.xyzw	vf20,vf22			fcand		vi01,0x3ffff				; (遅)透視変換,クリップ
	nop								ibeq		vi01,vi00,la2				; (先)透視変換,クリップ
	nop								isubiu		vi08,vi08,1					; -,カウンタのデクリメント
	nop								ibltz		vi05,la2					; ●
	nop								ior			vi05,vi05,vi06				; ●
	nop								ior			vi07,vi07,vi03				; ●
	nop								iaddiu		vi15,vi15,1					; ●
la2:mulq.xyz	vf22,vf19,Q			mfir.w		vf26,vi05					; 透視変換,キックフラグ
	maxx.w		vf22,vf19,vf00		sq.xyzw		vf20,DST_XYZ-DST_NEXT(vi10)	; フォグ,(遅)透視変換
	mulq.xyz	vf25,vf25,Q			sq.xyzw		vf25,SRC_UV0-SRC_NEXT(vi09)	; ＳＴ座標,クリップ用保存
	itof0.xyzw	vf23,vf17			ibgtz		vi08,_ClipPrimPolyTransLoop	; 光源計算,ループジャンプ
	itof4.w		vf26,vf26			iaddiu		vi10,vi10,DST_NEXT			; キックフラグ,書き込みアドレス増加

	; 後始末
	minix.w		vf22,vf22,vf01		isw.w		vi07,SRC_FLG-SRC_NEXT(vi09)	; (遅)フォグ,(遅)クリップ用保存
	add.w		vf22,vf22,vf26		sq.xyz		vf25,DST_UV0-DST_NEXT(vi10)	; (遅)フォグ,(遅)ＵＶ座標
	mula.xyz	ACC ,vf22,vf02		nop										; (遅)透視変換,
	maddw.xyz	vf22,vf03,vf00		iaddiu		vi01,vi13,TX0_OFT			; (遅)透視変換,テクスチャ設定
	ftoi4.xyzw	vf22,vf22			xgkick		vi01						; (遅)透視変換,テクスチャ設定
	nop								sq.xyzw		vf22,DST_XYZ-DST_NEXT(vi10)	; -,(遅)透視変換

	; 終端ダミーパケットをキックし待機
	nop								iaddiu		vi01,vi13,WORK_TOP	; 
	nop								xgkick		vi01				; ＧＩＦへのキック
	nop								b			ClipStartFog		; 
	nop								nop								; 

; --------------------------------------
; カリング付きポリゴンプリミティブ用ルーチン
; --------------------------------------
; ＜補足＞
; vf20を最終書き出し頂点用に使用
;	vf26:キックフラグ設定用
;	vf27:１つ前の頂点
;	vf28:１つ前のベクトル
;	vf29:ベクトル計算用テンポラリ
;	vf30:外積計算結果
;	vf31:フォグ係数
; 
;	upper		.					lower		.
CullClipPrimPolyTransStart:
	; 変換初期化処理
	; バッファアドレス、ループ回数のセットとデータのプリロード処理
	nop								xtop		vi13				; -,
	nop								lq.xyzw		vf01,FV_PRM(vi00)	; -,定数読み込み
	nop								lq.xyzw		vf02,FV_SCN(vi00)	; -,定数読みみ込
	nop								lq.xyzw		vf03,FV_OFT(vi00)	; -,定数読み込み
	nop								ilw.x		vi08,PACKDAT(vi13)	; -,処理頂点数の読み込み
	nop								lq.yzw		vf04,GIFNORMAL(vi13); -,GIFタグ生成
	nop								iaddiu		vi01,vi00,0x4000	; -,GIFタグ生成
	nop								iadd		vi01,vi01,vi01		; -,GIFタグ生成
	nop								ior			vi01,vi01,vi08		; -,GIFタグ生成
	nop								isw.x		vi01,WORK_TOP(vi13)	; -,GIFタグ生成
	nop								sq.yzw		vf04,WORK_TOP(vi13)	; -,GIFタグ生成
	nop								iaddiu		vi09,vi13,DATA_OFT	; -,データ先読みアドレス設定
	nop								iaddiu		vi10,vi13,PACK_TOP	; -,データ書き戻しアドレス設定
	nop								lq.xyzw		vf16,BUF_VERT(vi09)	; -,第１頂点読み込み
	nop								lq.xyzw		vf17,BUF_NORM(vi09)	; -,第１法線（＆キック情報）読み込み
	nop								lq.xyzw		vf18,BUF_UV0(vi09)	; -,第１ＵＶ値読み込み
	nop								lq.xyzw		vf04,M_OPT0(vi13)	; -,透視変換マトリクスロード
	nop								lq.xyzw		vf05,M_OPT1(vi13)	; -,透視変換マトリクスロード
	itof0.xyzw	vf23,vf17			lq.xyzw		vf06,M_OPT2(vi13)	; -,透視変換マトリクスロード
	nop								lq.xyzw		vf07,M_OPT3(vi13)	; -,透視変換マトリクスロード
	nop								lq.xyzw		vf31,FV_FOG(vi00)	; フォグ係数読み込み
	nop								iaddiu		vi06,vi00,0x4000	;
	nop								iadd		vi06,vi06,vi06		; vi06 = 0x8000
	nop								iaddiu		vi04,vi06,0x4000	; vi04 = 0xc000
	nop								iaddiu		vi15,vi00,0			; 
	nop								fcset		0						; クリップフラグクリア

	; ディレイ処理の為の前処理
	; 頂点変換処理（途中で次の頂点の情報を読み込んでおく）
	mulax.xyzw	ACC ,vf04,vf16		nop										; 透視変換,(遅)クリップ用保存
	minix.w		vf22,vf22,vf01		ilw.w		vi07,SRC_FLG(vi09)			; (遅)フォグ,描画キック
	madday.xyzw	ACC ,vf05,vf16		iaddiu		vi09,vi09,BUF_NEXT			; 透視変換,先読みアドレス増加
	maddaz.xyzw	ACC ,vf06,vf16		nop										; 透視変換,(遅)ＵＶ座標
	maddw.xyzw	vf19,vf07,vf00		lq.xyzw		vf16,BUF_VERT(vi09)			; 透視変換,(先)頂点読み込み
	add.w		vf22,vf22,vf26		sq.xyzw		vf23,SRC_COL-SRC_NEXT(vi09)	; (遅)フォグ,クリップ用保存
	mula.xyz	ACC ,vf22,vf02		sq.xyzw		vf17,DST_COL(vi10)			; (遅)透視変換,光源計算
	maddw.xyz	vf22,vf03,vf00		iand		vi05,vi07,vi06				; (遅)透視変換,キックフラグ
	clipw.xyz	vf19,vf19			div			Q,vf00w,vf19w				; クリップ,透視変換
	mulaw.xyz	ACC ,vf27,vf19		nop										; カリング,-
	msubw.xyz	vf29,vf19,vf27		move.xyzw	vf27,vf19					; カリング,カリング
	itof12.xyz	vf25,vf18			sq.xyzw		vf19,SRC_XYZW-SRC_NEXT(vi09); ＳＴ座標,クリップ用保存
	mulax.w		ACC ,vf19,vf31		lq.xyzw		vf18,BUF_UV0(vi09)			; フォグ,(先)ＵＶ読み込み
	maddy.w		vf19,vf00,vf31		lq.xyzw		vf17,BUF_NORM(vi09)			; フォグ,(先)光源計算
	opmula.xyz	ACC ,vf28,vf29		iaddiu		vi02,vi00,0x0020			; カリング,カリング
	opmsub.xyz	vf30,vf29,vf28		move.xyzw	vf28,vf29					; カリング,カリング
	ftoi4.xyzw	vf20,vf22			fcand		vi01,0x3ffff				; (遅)透視変換,クリップ
	nop								ibeq		vi01,vi00,la5				; (先)透視変換,クリップ
	nop								isubiu		vi08,vi08,1					; -,カウンタのデクリメント
;	nop								ibltz		vi05,la5					; ●
;	nop								ior			vi05,vi05,vi06				; ●
;	nop								ior			vi07,vi07,vi04				; ●
;	nop								iaddiu		vi15,vi15,1					; ●
la5:mulq.xyz	vf22,vf19,Q			mfir.w		vf26,vi05					; 透視変換,キックフラグ
	maxx.w		vf22,vf19,vf00		nop										; フォグ,(遅)透視変換
	mulq.xyz	vf25,vf25,Q			sq.xyzw		vf25,SRC_UV0-SRC_NEXT(vi09)	; ＳＴ座標,クリップ用保存
	itof0.xyzw	vf23,vf17			ibgtz		vi08,_CullClipPrimPolyTransLoop	; 光源計算,ループジャンプ
	itof4.w		vf26,vf26			iaddiu		vi10,vi10,DST_NEXT			; キックフラグ,書き込みアドレス増加

_CullClipPrimPolyTransLoop:
	; 頂点変換処理（途中で次の頂点の情報を読み込んでおく）
	mulax.xyzw	ACC ,vf04,vf16		isw.w		vi07,SRC_FLG-SRC_NEXT(vi09)	; 透視変換,(遅)クリップ用保存
	minix.w		vf22,vf22,vf01		ilw.w		vi07,SRC_FLG(vi09)			; (遅)フォグ,描画キック
	madday.xyzw	ACC ,vf05,vf16		iaddiu		vi09,vi09,BUF_NEXT			; 透視変換,先読みアドレス増加
	maddaz.xyzw	ACC ,vf06,vf16		sq.xyz		vf25,DST_UV0-DST_NEXT(vi10)	; 透視変換,(遅)ＵＶ座標
	maddw.xyzw	vf19,vf07,vf00		lq.xyzw		vf16,BUF_VERT(vi09)			; 透視変換,(先)頂点読み込み
	add.w		vf22,vf22,vf26		sq.xyzw		vf23,SRC_COL-SRC_NEXT(vi09)	;(遅)フォグ,クリップ用保存
	mula.xyz	ACC ,vf22,vf02		sq.xyzw		vf17,DST_COL(vi10)			; (遅)透視変換,光源計算
	maddw.xyz	vf22,vf03,vf00		iand		vi05,vi07,vi06				; (遅)透視変換,キックフラグ
	clipw.xyz	vf19,vf19			div			Q,vf00w,vf19w				; クリップ,透視変換
	mulaw.xyz	ACC ,vf19,vf27		iaddiu		vi03,vi00,0x0030			; カリング,カリング
	msubw.xyz	vf29,vf27,vf19		move.xyzw	vf27,vf19					; カリング,カリング
	itof12.xyz	vf25,vf18			sq.xyzw		vf19,SRC_XYZW-SRC_NEXT(vi09); ＳＴ座標,クリップ用保存
	mulax.w		ACC ,vf19,vf31		lq.xyzw		vf18,BUF_UV0(vi09)			; フォグ,(先)ＵＶ読み込み
	maddy.w		vf19,vf00,vf31		lq.xyzw		vf17,BUF_NORM(vi09)			; フォグ,(先)光源計算
	opmula.xyz	ACC ,vf28,vf29		iaddiu		vi02,vi00,0x0020			; カリング,カリング
	opmsub.xyz	vf30,vf29,vf28		move.xyzw	vf28,vf29					; カリング,カリング
	ftoi4.xyzw	vf20,vf22			fcand		vi01,0x3ffff				; (遅)透視変換,クリップ
	nop								ibeq		vi01,vi00,la8				; (先)透視変換,クリップ
	nop								isubiu		vi08,vi08,1					; -,カウンタのデクリメント
	nop								ibltz		vi05,la6					; ● 
	nop								ior			vi05,vi05,vi06				; ● vi05 |= 0x8000
	nop								ior			vi07,vi07,vi04				; ● vi07 |= 0xc000
	nop								b			la6							; ● 
	nop								iaddiu		vi15,vi15,1					; ● 
la8:nop								iand		vi03,vi03,vi07				; -,カリング
	nop								fmand		vi02,vi02					; -,カリング
	nop								ibne		vi02,vi03,la6				; -,カリング
	nop								nop										; -,カリング
	nop								ior			vi05,vi05,vi06				; -,カリング
la6:mulq.xyz	vf22,vf19,Q			mfir.w		vf26,vi05					; 透視変換,キックフラグ
	maxx.w		vf22,vf19,vf00		sq.xyzw		vf20,DST_XYZ-DST_NEXT(vi10)	; フォグ,(遅)透視変換
	mulq.xyz	vf25,vf25,Q			sq.xyzw		vf25,SRC_UV0-SRC_NEXT(vi09)	; ＳＴ座標,クリップ用保存
	itof0.xyzw	vf23,vf17			ibgtz		vi08,_CullClipPrimPolyTransLoop	; 光源計算,ループジャンプ
	itof4.w		vf26,vf26			iaddiu		vi10,vi10,DST_NEXT			; キックフラグ,書き込みアドレス増加

	; 後始末
	minix.w		vf22,vf22,vf01		isw.w		vi07,SRC_FLG-SRC_NEXT(vi09)	; (遅)フォグ,(遅)クリップ用保存
	add.w		vf22,vf22,vf26		sq.xyz		vf25,DST_UV0-DST_NEXT(vi10)	; (遅)フォグ,(遅)ＵＶ座標
	mula.xyz	ACC ,vf22,vf02		nop										; (遅)透視変換,
	maddw.xyz	vf22,vf03,vf00		iaddiu		vi01,vi13,TX0_OFT			; (遅)透視変換,テクスチャ設定
	ftoi4.xyzw	vf22,vf22			xgkick		vi01						; (遅)透視変換,テクスチャ設定
	nop								sq.xyzw		vf22,DST_XYZ-DST_NEXT(vi10)	; -,(遅)透視変換

	; 終端ダミーパケットをキックし待機
	nop								iaddiu		vi01,vi13,WORK_TOP	; 
	nop								xgkick		vi01				; ＧＩＦへのキック
	nop								b			ClipStartFog		; 
	nop								nop								; 

; --------------------------------------
; ラインプリミティブ用ルーチン
; --------------------------------------
;	upper		.					lower		.
ClipPrimLineTransStart:
	; 変換初期化処理
	; バッファアドレス、ループ回数のセットとデータのプリロード処理
	nop								xtop		vi13				; -,
	nop								lq.xyzw		vf01,FV_PRM(vi00)	; -,定数読み込み
	nop								lq.xyzw		vf02,FV_SCN(vi00)	; -,定数読みみ込
	nop								lq.xyzw		vf03,FV_OFT(vi00)	; -,定数読み込み
	nop								ilw.x		vi08,PACKDAT(vi13)	; -,処理頂点数の読み込み
	nop								lq.yzw		vf04,GIFNORMAL(vi13); -,GIFタグ生成
	nop								iaddiu		vi01,vi00,0x4000	; -,GIFタグ生成
	nop								iadd		vi01,vi01,vi01		; -,GIFタグ生成
	nop								ior			vi01,vi01,vi08		; -,GIFタグ生成
	nop								isw.x		vi01,WORK_TOP(vi13)	; -,GIFタグ生成
	nop								sq.yzw		vf04,WORK_TOP(vi13)	; -,GIFタグ生成
	nop								iaddiu		vi09,vi13,DATA_OFT	; -,データ先読みアドレス設定
	nop								iaddiu		vi10,vi13,PACK_TOP	; -,データ書き戻しアドレス設定
	nop								lq.xyzw		vf16,BUF_VERT(vi09)	; -,第１頂点読み込み
	nop								lq.xyzw		vf17,BUF_NORM(vi09)	; -,第１法線（＆キック情報）読み込み
	nop								lq.xyzw		vf18,BUF_UV0(vi09)	; -,第１ＵＶ値読み込み
	nop								lq.xyzw		vf04,M_OPT0(vi13)	; -,透視変換マトリクスロード
	nop								lq.xyzw		vf05,M_OPT1(vi13)	; -,透視変換マトリクスロード
	itof0.xyzw	vf23,vf17			lq.xyzw		vf06,M_OPT2(vi13)	; -,透視変換マトリクスロード
	nop								lq.xyzw		vf07,M_OPT3(vi13)	; -,透視変換マトリクスロード
	nop								lq.xyzw		vf31,FV_FOG(vi00)	; フォグ係数読み込み
	nop								iaddiu		vi06,vi00,0x4000	;
	nop								iadd		vi06,vi06,vi06		; 
	nop								iaddiu		vi15,vi00,0			; 
	nop								fcset		0						; クリップフラグクリア

	; ディレイ処理の為の前処理
	; 頂点変換処理（途中で次の頂点の情報を読み込んでおく）
	mulax.xyzw	ACC ,vf04,vf16		ilw.w		vi07,SRC_FLG(vi09)			; 透視変換,描画キック
	minix.w		vf22,vf22,vf01		nop										; (遅)フォグ,(遅)クリップ用保存
	madday.xyzw	ACC ,vf05,vf16		iaddiu		vi09,vi09,BUF_NEXT			; 透視変換,先読みアドレス増加
	maddaz.xyzw	ACC ,vf06,vf16		nop										; 透視変換,(遅)ＵＶ座標
	maddw.xyzw	vf19,vf07,vf00		lq.xyzw		vf16,BUF_VERT(vi09)			; 透視変換,(先)頂点読み込み
	add.w		vf22,vf22,vf26		sq.xyzw		vf23,SRC_COL-SRC_NEXT(vi09)	; (遅)フォグ,クリップ用保存
	mula.xyz	ACC ,vf22,vf02		sq.xyzw		vf17,DST_COL(vi10)			; (遅)透視変換,光源計算
	maddw.xyz	vf22,vf03,vf00		iand		vi05,vi07,vi06				; (遅)透視変換,キックフラグ
	clipw.xyz	vf19,vf19			div			Q,vf00w,vf19w				; クリップ,透視変換
	itof12.xyz	vf25,vf18			sq.xyzw		vf19,SRC_XYZW-SRC_NEXT(vi09); ＳＴ座標,クリップ用保存
	mulax.w		ACC ,vf19,vf31		lq.xyzw		vf18,BUF_UV0(vi09)			; フォグ,(先)ＵＶ読み込み
	maddy.w		vf19,vf00,vf31		lq.xyzw		vf17,BUF_NORM(vi09)			; フォグ,(先)光源計算
	ftoi4.xyzw	vf20,vf22			fcand		vi01,0x00fff				; (遅)透視変換,クリップ
	nop								ibeq		vi01,vi00,la3				; (先)透視変換,クリップ
	nop								isubiu		vi08,vi08,1					; -,カウンタのデクリメント
;	nop								ibltz		vi05,la3					; ●
;	nop								iaddiu		vi01,vi06,0x4000			; ●
;	nop								ior			vi05,vi05,vi01				; ●
;	nop								iaddiu		vi15,vi15,1					; ●
la3:mulq.xyz	vf22,vf19,Q			mfir.w		vf26,vi05					; 透視変換,キックフラグ
	maxx.w		vf22,vf19,vf00		nop										; フォグ,(遅)透視変換
	mulq.xyz	vf25,vf25,Q			sq.xyzw		vf25,SRC_UV0-SRC_NEXT(vi09)	; ＳＴ座標,クリップ用保存
	itof0.xyzw	vf23,vf17			ibgtz		vi08,_ClipPrimLineTransLoop	; 光源計算,ループジャンプ
	itof4.w		vf26,vf26			iaddiu		vi10,vi10,DST_NEXT			; キックフラグ,書き込みアドレス増加

_ClipPrimLineTransLoop:
	; 頂点変換処理（途中で次の頂点の情報を読み込んでおく）
	mulax.xyzw	ACC ,vf04,vf16		ilw.w		vi07,SRC_FLG(vi09)			; 透視変換,描画キック
	minix.w		vf22,vf22,vf01		isw.w		vi05,SRC_FLG-SRC_NEXT(vi09)	; (遅)フォグ,(遅)クリップ用保存
	madday.xyzw	ACC ,vf05,vf16		iaddiu		vi09,vi09,BUF_NEXT			; 透視変換,先読みアドレス増加
	maddaz.xyzw	ACC ,vf06,vf16		sq.xyz		vf25,DST_UV0-DST_NEXT(vi10)	; 透視変換,(遅)ＵＶ座標
	maddw.xyzw	vf19,vf07,vf00		lq.xyzw		vf16,BUF_VERT(vi09)			; 透視変換,(先)頂点読み込み
	add.w		vf22,vf22,vf26		sq.xyzw		vf23,SRC_COL-SRC_NEXT(vi09)	;(遅)フォグ,クリップ用保存
	mula.xyz	ACC ,vf22,vf02		sq.xyzw		vf17,DST_COL(vi10)			; (遅)透視変換,光源計算
	maddw.xyz	vf22,vf03,vf00		iand		vi05,vi07,vi06				; (遅)透視変換,キックフラグ
	clipw.xyz	vf19,vf19			div			Q,vf00w,vf19w				; クリップ,透視変換
	itof12.xyz	vf25,vf18			sq.xyzw		vf19,SRC_XYZW-SRC_NEXT(vi09); ＳＴ座標,クリップ用保存
	mulax.w		ACC ,vf19,vf31		lq.xyzw		vf18,BUF_UV0(vi09)			; フォグ,(先)ＵＶ読み込み
	maddy.w		vf19,vf00,vf31		lq.xyzw		vf17,BUF_NORM(vi09)			; フォグ,(先)光源計算
	ftoi4.xyzw	vf20,vf22			fcand		vi01,0x00fff				; (遅)透視変換,クリップ
	nop								ibeq		vi01,vi00,la4				; (先)透視変換,クリップ
	nop								isubiu		vi08,vi08,1					; -,カウンタのデクリメント
	nop								ibltz		vi05,la4					; ●
	nop								iaddiu		vi01,vi06,0x4000			; ●
	nop								ior			vi05,vi05,vi01				; ●
	nop								iaddiu		vi15,vi15,1					; ●
la4:mulq.xyz	vf22,vf19,Q			mfir.w		vf26,vi05					; 透視変換,キックフラグ
	maxx.w		vf22,vf19,vf00		sq.xyzw		vf20,DST_XYZ-DST_NEXT(vi10)	; フォグ,(遅)透視変換
	mulq.xyz	vf25,vf25,Q			sq.xyzw		vf25,SRC_UV0-SRC_NEXT(vi09)	; ＳＴ座標,クリップ用保存
	itof0.xyzw	vf23,vf17			ibgtz		vi08,_ClipPrimLineTransLoop	; 光源計算,ループジャンプ
	itof4.w		vf26,vf26			iaddiu		vi10,vi10,DST_NEXT			; キックフラグ,書き込みアドレス増加

	; 後始末
	minix.w		vf22,vf22,vf01		isw.w		vi05,SRC_FLG-SRC_NEXT(vi09)	; (遅)フォグ,(遅)クリップ用保存
	add.w		vf22,vf22,vf26		sq.xyz		vf25,DST_UV0-DST_NEXT(vi10)	; (遅)フォグ,(遅)ＵＶ座標
	mula.xyz	ACC ,vf22,vf02		nop										; (遅)透視変換,
	maddw.xyz	vf22,vf03,vf00		iaddiu		vi01,vi13,TX0_OFT			; (遅)透視変換,テクスチャ設定
	ftoi4.xyzw	vf22,vf22			xgkick		vi01						; (遅)透視変換,テクスチャ設定
	nop								sq.xyzw		vf22,DST_XYZ-DST_NEXT(vi10)	; -,(遅)透視変換

	; 終端ダミーパケットをキックし待機
	nop								iaddiu		vi01,vi13,WORK_TOP			; 
	nop								xgkick		vi01						; ＧＩＦへのキック
	nop								ibne		vi15,vi00,ClipLineStartFog	; 
	nop								nop										; 
	nop[e]							nop										; 
	nop								nop										; 



; --------------------------------------
; ラインプリミティブ用クリップルーチン
; --------------------------------------
ClipLineStartFog:
	nop								ibeq		vi15,vi00,ProgramEnd		; -,クリップ処理スキップ
	nop								ilw.x		vi08,PACKDAT(vi13)			; -,処理頂点数の読み込み
	nop								iaddiu		vi09,vi13,DATA_OFT+SRC_NEXT	; -,読み込みアドレス設定
	nop								ilw.w		vi07,SRC_FLG(vi09)			; クリップフラグ読み込み
	nop								iaddi		vi08,vi08,-1				; １頂点スキップしているので
	nop								iaddiu		vi01,vi13,TX0_OFT			; テクスチャ設定
	nop								xgkick		vi01						; テクスチャ設定（＝ウェイト）
	nop								iaddiu		vi14,vi00,0					; ダブルバッファフラグクリア
	nop								iaddiu		vi11,vi00,0x4000			; 定数設定
ClipLineLoop:
	nop								iand		vi01,vi07,vi11				; フラグチェック
	nop								iaddiu		vi02,vi00,2					; クリップ処理頂点数設定
	nop								ibeq		vi01,vi00,ClipLineSkip		; 
	nop								fcset		0							; 
	; クリップポリゴン発見時
	nop								lq.xyzw		vf04,SRC_XYZW-SRC_NEXT*1(vi09)	; -,第１座標読み込み
	nop								lq.xyzw		vf05,SRC_XYZW-SRC_NEXT*0(vi09)	; -,第２座標読み込み
	nop								ibne		vi14,vi00,lb1					; 
	nop								lq.xyzw		vf16,SRC_COL -SRC_NEXT*1(vi09)	; -,第１カラー読み込み
	nop								b			lb2								; 
	nop								iaddiu		vi10,vi13,CWORK1				; 
lb1:nop								iaddiu		vi10,vi13,CWORK2				;
lb2:clipw.xyz	vf04,vf04			lq.xyzw		vf17,SRC_UV0 -SRC_NEXT*1(vi09)	; ,第１ＵＶ０読み込み
	clipw.xyz	vf05,vf05			lq.xyzw		vf18,SRC_COL -SRC_NEXT*0(vi09)	; ,第２カラー読み込み
	nop								lq.xyzw		vf19,SRC_UV0 -SRC_NEXT*0(vi09)	; ,第２ＵＶ０読み込み
	nop								sq.xyzw		vf16,DST_COL +DST_NEXT*0(vi10)	; 第１カラー書き込み
	nop								fcget		vi03							; 
	nop								fcget		vi04							; 
	nop								iand		vi03,vi03,vi04					; 
	nop								sq.xyzw		vf17,DST_UV0 +DST_NEXT*0(vi10)	; 第１ＵＶ０書き込み
	nop								ibne		vi03,vi00,ClipLineSkip			; 
	nop								sq.xyzw		vf18,DST_COL +DST_NEXT*1(vi10)	; 第２カラー書き込み
	nop								sq.xyzw		vf19,DST_UV0 +DST_NEXT*1(vi10)	; 第２ＵＶ０書き込み
	nop								sq.xyzw		vf04,DST_XYZ +DST_NEXT*0(vi10)	; 第１座標書き込み
	nop								sq.xyzw		vf05,DST_XYZ +DST_NEXT*1(vi10)	; 第２座標書き込み

	nop								fcand		vi01,0x00410		; 
	nop								ibeq		vi01,vi00,_cliplf_6	; 
	nop								nop								; 
	nop								bal			vi15,ZClipl_p		; Ｚ＝Ｗ面によるクリップ
	nop								nop								; 
	nop								ibne		vi03,vi00,ClipLineSkip; 完全画面外チェック
	nop								nop								; 
_cliplf_6:
	nop								bal			vi15,CorrectColor	; ＲＧＢＡ補正
	nop								nop								; 
	nop								fcand		vi01,0x000820		; 
	nop								ibeq		vi01,vi00,_cliplf_1	; 
	nop								nop								; 
	nop								bal			vi15,ZClipl_m		; Ｚ＝−Ｗ面によるクリップ
	nop								nop								; 
	nop								ibne		vi03,vi00,ClipLineSkip; 完全画面外チェック
	nop								nop								; 
_cliplf_1:
	nop								fcand		vi01,0x000041		; 
	nop								ibeq		vi01,vi00,_cliplf_2	; 
	nop								nop								; 
	nop								bal			vi15,XClipl_p		; Ｘ＝Ｗ面によるクリップ
	nop								nop								; 
	nop								ibne		vi03,vi00,ClipLineSkip; 完全画面外チェック
	nop								nop								; 
_cliplf_2:
	nop								fcand		vi01,0x000082		; 
	nop								ibeq		vi01,vi00,_cliplf_3	; 
	nop								nop								; 
	nop								bal			vi15,XClipl_m		; Ｘ＝−Ｗ面によるクリップ
	nop								nop								; 
	nop								ibne		vi03,vi00,ClipLineSkip; 完全画面外チェック
	nop								nop								; 
_cliplf_3:
	nop								fcand		vi01,0x000104		; 
	nop								ibeq		vi01,vi00,_cliplf_4	; 
	nop								nop								; 
	nop								bal			vi15,YClipl_p		; Ｙ＝Ｗ面によるクリップ
	nop								nop								; 
	nop								ibne		vi03,vi00,ClipLineSkip; 完全画面外チェック
	nop								nop								; 
_cliplf_4:
	nop								fcand		vi01,0x000208		; 
	nop								ibeq		vi01,vi00,_cliplf_5	; 
	nop								nop								; 
	nop								bal			vi15,YClipl_m		; Ｙ＝−Ｗ面によるクリップ
	nop								nop								; 
	nop								ibne		vi03,vi00,ClipLineSkip; 完全画面外チェック
	nop								nop								; 
_cliplf_5:

	; クリップ後に頂点が存在すれば描画を行う
	nop								isubiu		vi01,vi02,2					; 
	nop								lq.xyzw		vf16,GIFCLIP(vi13)			; ＧＩＦタグ読み込み
	nop								ibltz		vi01,ClipLineSkip			; 
	nop								iaddiu		vi01,vi00,0x4000			; 
	mulx.xyzw	vf27,vf27,vf00		iadd		vi01,vi01,vi01				; 
	nop								ior			vi01,vi01,vi02				; 
	nop								iaddi		vi10,vi10,-1				; 
	nop								loi			0.0005						; ＲＧＢＡ四捨五入用定数
	addi.xyzw	vf27,vf27,I			sq.yzw		vf16,0(vi10)				; alphaには四捨五入を行なわない
	nop								isw.x		vi01,0(vi10)				; 
	nop								iaddiu		vi03,vi10,1					; 
	; 座標変換処理他

	nop								lq.xyzw		vf15,FV_FOG(vi00)	; 
	nop								lq.xyzw		vf16,DST_XYZ(vi03)	; 
	nop								lq.xyzw		vf17,DST_COL(vi03)	; 
	nop								lq.xyzw		vf18,DST_UV0(vi03)	; 
	mulax.w		ACC ,vf16,vf15		div			Q,vf00w,vf16w		; 
	maddy.w		vf16,vf00,vf15		lq.xyzw		vf01,FV_PRM(vi00)	; 
	maxx.w		vf21,vf16,vf00		nop								; 
_cliplf_0:
	mulq.xyz	vf21,vf16,Q			waitq									; 透視変換,-
	mulaq.xyzw	ACC ,vf17,Q			iaddiu		vi03,vi03,DST_NEXT			; ＲＧＢＡ値補正,読み込みアドレス増加
	maddw.xyzw	vf22,vf27,vf00		lq.xyzw		vf16,DST_XYZ(vi03)			; ＲＧＢＡ値補正,(先)頂点読み込み
	minix.w		vf21,vf21,vf01		lq.xyzw		vf17,DST_COL(vi03)			; フォグ,(先)色読み込み
	mula.xyz	ACC ,vf21,vf02		nop										; プリミティブ座標,-
	maddw.xyz	vf21,vf03,vf00		nop										; プリミティブ座標,-
	mulq.xyz	vf23,vf18,Q			div			Q,vf00w,vf16w				; ＳＴＱ０,除数算出
	ftoi0.xyzw	vf22,vf22			lq.xyzw		vf18,DST_UV0(vi03)			; 整数化,(先)ＵＶ０読み込み
	mulax.w		ACC ,vf16,vf15		iaddi		vi02,vi02,-1				; (先)フォグ,頂点数減算
	ftoi4.xyzw	vf21,vf21			nop										; 整数化,-
	maddy.w		vf16,vf00,vf15		sq.xyz		vf23,DST_UV0-DST_NEXT(vi03)	; (先)フォグ,ＵＶ０書き戻し
	nop								sq.xyzw		vf22,DST_COL-DST_NEXT(vi03)	; -,色書き戻し
	nop								ibgtz		vi02,_cliplf_0				; -,ループ
	maxx.w		vf21,vf16,vf00		sq.xyzw		vf21,DST_XYZ-DST_NEXT(vi03)	; (先)フォグ,座標書き戻し

	nop								xgkick		vi10				; 
	nop								iaddiu		vi01,vi00,1			; 
	nop								isub		vi14,vi01,vi14		; バッファ切り替え

