; 点光源シェーダ(適当なので注意)
;
; 2001.05.18  F.Miyauchi
; $Id: plight.psh,v 1.1.1.3 2002/11/19 11:42:19 Yoshizawa1 Exp $
;
;  t1.xyz : 光源→頂点ベクトル
;  t2.xyz : 光源色
;

#ifdef KP_XBOX
xps.1.1
#else
ps.1.1
#endif

tex t0
texcoord t2
texcoord t3
dp3 r0, t3, t3			; r0 = x^2 + y^2 + z^2
mov r0, 1-r0			; r0 = 1.0f - r0^2 (本当は 1 / r0^2)
mul r0.rgb, r0, t2		; 光源色
mul r0.rgb, r0, v0		; diffuse
mul_x2 r0.rgb, r0, t0	; 

mul_x4 r0.a, v0, t0		; アルファ出力
