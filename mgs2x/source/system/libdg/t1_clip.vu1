	mulw.xyzw	vf23,vf16,vf20		fcor		vi01,~0x820			; ＜非共通部分＞
	mulw.xyzw	vf22,vf12,vf21		ibne		vi01,vi00,_clip5_2	; ２点とも領域外
	sub.w		vf14,vf21,vf20		fcand		vi01,0x820			; カラー補間用先行計算,＜非共通部分＞
	mulw.xyzw	vf24,vf13,vf21		ibeq		vi01,vi00,_clip5_1	; ２点とも領域内
	; 切断処理
	mulw.xyzw	vf25,vf17,vf20		fcand		vi01,0x800			; ＜非共通部分＞
	mulw.xyz	vf26,vf14,vf21		ibne		vi01,vi00,_clip5_3	; 
	mulw.xyz	vf27,vf18,vf20		div			Q,vf00w,vf14w		; 
	nop								iaddiu		vi02,vi02,3			; 
	nop								iaddiu		vi11,vi11,1			; 
_clip5_3:
	mulx.z		vf12,vf12,vf00		nop
	sub.xyw		vf12,vf22,vf23		nop								; 座標＜非共通部分＞
	sub.xyzw	vf13,vf24,vf25		nop								; 色
	sub.xyzw	vf14,vf26,vf27		nop								; ＳＴ
	subw.z		vf12,vf12,vf12		nop								; ＜非共通部分＞
	mulq.xyzw	vf13,vf13,Q			waitq							; 
	mulq.xyzw	vf14,vf14,Q			nop								; 
	mulq.xyzw	vf12,vf12,Q			nop								; 
_clip5_1:
	nop								iaddiu		vi11,vi11,1			; 
	nop								sq.xyzw		vf13,1(vi02)		; 
	nop								sq.xyzw		vf14,0(vi02)		; 
	nop								sq.xyzw		vf12,2(vi02)		; 先頭頂点のストア
	nop								iaddiu		vi02,vi02,3			; 
_clip5_2:
	mulw.xyzw	vf12,vf16,vf00		move.w		vf20,vf21			; 終点頂点を先頭頂点用レジスタへコピー
	mulw.xyzw	vf13,vf17,vf00		ibgez		vi05,_clip5_0		; 
	mulw.xyzw	vf14,vf18,vf00		isubiu		vi05,vi05,1			; 

	clipw.xyz	vf08,vf08			nop								; 
	clipw.xyz	vf09,vf09			nop								; リターン
	clipw.xyz	vf10,vf10			nop								; 
	clipw.xyz	vf11,vf11			nop								; 
	nop								nop								; 
	nop								jr			vi15				; 
	nop								nop								; 

	; 色補正処理ＲＧＢＡにＷを乗算する
CorrectColor:
	nop								iaddiu		vi04,vi11,0			; 処理用の頂点数設定
	nop								fcset		0					; 
	nop								lq.xyzw		vf08,2(vi12)			; 
	nop								lq.xyzw		vf20,1(vi12)		;
	nop								lq.xyzw		vf21,1+3(vi12)		;
	nop								lq.xyzw		vf22,1+6(vi12)		;
	nop								lq.xyzw		vf23,1+9(vi12)		;
	nop								ibeq		vi04,vi00,clr_corrc_end0 ;
	nop								iaddi		vi04,vi04,-1			; 
	mulw.xyzw	vf20,vf20,vf08		lq.xyzw		vf09,2+3(vi12)		; 
	clipw.xyz	vf08,vf08			ibeq		vi04,vi00,clr_corrc_end1 ;
	nop								iaddi		vi04,vi04,-1			; 
	mulw.xyzw	vf21,vf21,vf09		lq.xyzw		vf10,2+6(vi12)		; 
	clipw.xyz	vf09,vf09			ibeq		vi04,vi00,clr_corrc_end2 ;
	nop								iaddi		vi04,vi04,-1			; 
	mulw.xyzw	vf22,vf22,vf10		lq.xyzw		vf11,2+9(vi12)		; 
	clipw.xyz	vf10,vf10			ibeq		vi04,vi00,clr_corrc_end3 ;
	nop								iaddi		vi04,vi04,-1			; 
	mulw.xyzw	vf23,vf23,vf11		b			clr_corrc_end4		;
	clipw.xyz	vf11,vf11			nop								; 

clr_corrc_end0:
	nop								move.xyzw	vf08,vf00			; 
clr_corrc_end1:
	nop								move.xyzw	vf09,vf00			; 
clr_corrc_end2:
	nop								move.xyzw	vf10,vf00			; 
clr_corrc_end3:
	nop								move.xyzw	vf11,vf00			; 
clr_corrc_end4:
	nop								sq.xyzw		vf20,1(vi12)		;
	nop								sq.xyzw		vf21,1+3(vi12)		;
	nop								sq.xyzw		vf22,1+6(vi12)		;
	nop								jr			vi15				; 
	nop								sq.xyzw		vf23,1+9(vi12)		;






