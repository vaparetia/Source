	nop								nop								; 
	nop								ibgtz		vi08,ClipLoopFog	; 
	nop								mtir		vi07,vf14w			; 

	nop[e]							b			ClipTransNext		; ジャンプ＆停止
	nop								nop								; 

	; 以下のクリップルーチン共通レジスタ割り当て
	; vf1,vf2,vf3:定数が入っているので破壊してはいけない
	; vf4,vf5,vf6,vf7:透視変換マトリクスが入っているので破壊してはいけない
	; vf8,vf9,vf10,vf11:クリップチェックのベースとなる４頂点が入っているので破壊してはいけない
	; vi3,vi8,vi10,vi13:破壊してはいけないので使用不可
	; vi11:現在の頂点数：終了時に処理により変化
	; vi12:現在処理中の頂点列先頭ポインタ：終了時にアドレス−３（＝１頂点分デクリメント）
	; 内部使用レジスタ
	; vi2,vi4,vi5,vi6
	; vf12,vf13,vf14,vf16,vf17,vf18,
	; vf20,vf21,vf22,vf23,vf24,vf25,vf26,vf27
	; ※終了時にはvf8,vf9,vf10のクリップ処理を終えていなければならないので注意

	; Ｘ＝Ｗ面に対するクリップ処理
XClip_p:
	nop								iaddiu		vi04,vi12,0			; 処理用の頂点読み込みアドレス設定
	nop								iadd		vi06,vi04,vi11		; 計算用最終頂点格納アドレス計算
	nop								iadd		vi06,vi06,vi11		; 計算用最終頂点格納アドレス計算
	nop								iadd		vi06,vi06,vi11		; 計算用最終頂点格納アドレス計算
	nop								isubiu		vi12,vi12,3			; 頂点アドレスのデクリメント
	nop								iaddiu		vi02,vi12,0			; 処理用の頂点格納アドレス設定
	nop								isubiu		vi05,vi11,2			; ループ用カウンタ設定
	nop								iaddiu		vi11,vi00,0			; 新規の頂点数をカウントする為にクリア
	nop								lq.xyzw		vf12,2(vi04)		; 
	nop								lq.xyzw		vf13,1(vi04)		; 
	nop								lq.xyz		vf14,0(vi04)		; 
	nop								iaddiu		vi04,vi04,3			; 
	clipw.xyz	vf12,vf12			sq.xyzw		vf12,2(vi06)		; 計算用最終頂点の生成
	subx.w		vf20,vf12,vf12		sq.xyzw		vf13,1(vi06)		; 計算用最終頂点の生成
	nop								sq.xyz		vf14,0(vi06)		; 計算用最終頂点の生成
_clip0_0:
	nop								lq.xyzw		vf16,2(vi04)		; ＜非共通部分＞
	nop								lq.xyzw		vf17,1(vi04)		; 
	nop								lq.xyz		vf18,0(vi04)		; 
	;nop							nop								; 
	clipw.xyz	vf16,vf16			iaddiu		vi04,vi04,3			; 
	subx.w		vf21,vf16,vf16		sq.xyzw		vf12,2(vi02)		; ＜非共通部分＞
	nop								sq.xyzw		vf13,1(vi02)		; 先頭頂点がクリップ内のときには先にストアしておく
	nop								sq.xyz		vf14,0(vi02)		; 
	; クリップ判定
	mulw.xyzw	vf23,vf16,vf20		fcor		vi01,~0x041			; ＜非共通部分＞
	mulw.yzw	vf22,vf12,vf21		ibne		vi01,vi00,_clip0_2	; ２点とも領域外
	sub.w		vf14,vf21,vf20		fcand		vi01,0x041			; カラー補間用先行計算,＜非共通部分＞
	mulw.xyzw	vf24,vf13,vf21		ibeq		vi01,vi00,_clip0_1	; ２点とも領域内
	; 切断処理
	mulw.xyzw	vf25,vf17,vf20		fcand		vi01,0x040			; ＜非共通部分＞
	mulw.xyz	vf26,vf14,vf21		ibne		vi01,vi00,_clip0_3	; 
	mulw.xyz	vf27,vf18,vf20		div			Q,vf0w,vf14w		; 
	nop								iaddiu		vi02,vi02,3			; 
	nop								iaddiu		vi11,vi11,1			; 
_clip0_3:
	mulx.x		vf12,vf12,vf00		nop								; 
	sub.yzw		vf12,vf22,vf23		nop								; 座標
	sub.xyzw	vf13,vf24,vf25		nop								; 色
	sub.xyz		vf14,vf26,vf27		nop								; ＳＴ
	addw.x		vf12,vf12,vf12		nop								; 
	mulq.xyzw	vf13,vf13,Q			waitq							; 
	mulq.xyzw	vf14,vf14,Q			nop								; 
	mulq.xyzw	vf12,vf12,Q			nop								; 
_clip0_1:
	nop								iaddiu		vi11,vi11,1			; 
	nop								sq.xyzw		vf13,1(vi02)		; 
	nop								sq.xyzw		vf14,0(vi02)		; 
	nop								sq.xyzw		vf12,2(vi02)		; 先頭頂点のストア
	nop								iaddiu		vi02,vi02,3			; 
_clip0_2:
	mulw.xyzw	vf12,vf16,vf00		move.w		vf20,vf21			; 終点頂点を先頭頂点用レジスタへコピー
	mulw.xyzw	vf13,vf17,vf00		ibgez		vi05,_clip0_0		; 
	mulw.xyzw	vf14,vf18,vf00		isubiu		vi05,vi05,1			; 

	clipw.xyz	vf08,vf08			nop								; 
	clipw.xyz	vf09,vf09			nop								; リターン
	clipw.xyz	vf10,vf10			nop								; 
	clipw.xyz	vf11,vf11			nop								; 
	nop								nop								; 
	nop								jr			vi15				; 
	nop								nop								; 

	; Ｘ＝−Ｗ面に対するクリップ処理
XClip_m:
	nop								iaddiu		vi04,vi12,0			; 処理用の頂点読み込みアドレス設定
