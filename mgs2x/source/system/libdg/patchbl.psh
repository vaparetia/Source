/*

	t0:  通常テクスチャ
	t1:  バンプテクスチャ
	t3:	 スペキュラマップテクスチャ
 */

xps.1.1

tex t0
tex t1
;texm3x2pad t2, t1_bx2
;texm3x2tex t3, t1_bx2
texbem t3,t1

;add_x2 r0, v0, t3
mov r0,t0

