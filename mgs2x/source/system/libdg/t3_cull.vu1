_clip_3:
	nop								fcand		vi01,0x104104		; 
	nop								ibeq		vi01,vi00,_clip_4	; 
	nop								nop								; 
	nop								bal			vi15,YClip_p		; Ｙ＝Ｗ面によるクリップ
	nop								nop								; 
_clip_4:
	nop								fcand		vi01,0x208208		; 
	nop								ibeq		vi01,vi00,_clip_5	; 
	nop								nop								; 
	nop								bal			vi15,YClip_m		; Ｙ＝−Ｗ面によるクリップ
	nop								nop								; 
_clip_5:

	; クリップ後に頂点が存在すれば描画を行う
	nop								iaddiu		vi06,vi00,FLAG_CULL			; -,カリングフラグ
	nop								iand		vi06,vi06,vi12				; -,カリングフラグ
	nop								lq.xyzw		vf04,DST_XYZ(vi10)			; -,カリング
	nop								lq.xyzw		vf05,DST_XYZ+DST_NEXT(vi10)	; -,カリング
	nop								lq.xyzw		vf06,DST_XYZ+DST_NEXT*2(vi10); -,カリング
	mulx.xyzw	vf27,vf27,vf00		isubiu		vi01,vi02,3			; 
	nop								lq.xyzw		vf16,GIFCLIP(vi13)	; ＧＩＦタグ読み込み
	mulaw.xyz	ACC ,vf05,vf04		ibltz		vi01,ClipSkip		; カリング,
	msubw.xyz	vf04,vf04,vf05		iaddiu		vi01,vi00,0x4000	; カリング,
	mulaw.xyz	ACC ,vf06,vf05		iadd		vi01,vi01,vi01		; カリング,
	msubw.xyz	vf05,vf05,vf06		ior			vi01,vi01,vi02		; カリング,
	nop								iaddi		vi10,vi10,-1		; 
	nop								loi			0.0001				; ＲＧＢＡ四捨五入用定数
	addi.xyz	vf27,vf27,I			sq.yzw		vf16,0(vi10)		; alphaには四捨五入を行なわない
	opmula.xyz	ACC ,vf04,vf05		isw.x		vi01,0(vi10)		; カリング,
	opmsub.xyz	vf04,vf05,vf04		ibeq		vi06,vi00,no_cull_clip		; カリング,カリングフラグ
	nop								iaddiu		vi03,vi00,0x0030			; ,カリング
	nop								iand		vi03,vi03,vi07				; -,カリング
	nop								iaddiu		vi01,vi00,0x0020			; -,カリング
	nop								fmand		vi01,vi01					; -,カリング
	nop								ibeq		vi01,vi03,ClipSkip			; -,カリング
no_cull_clip:
