; ================================================================
; クリップルーチン用レジスタ割り当て
; ================================================================
;	vf00:fix
;	vf01:定数読み込みベクトル
;	vf02:プリミティブ座標変換スケール
;	vf03:プリミティブ座標変換オフセット
;	vf04:クリップ頂点保持用
;	vf05:クリップ頂点保持用
;	vf06:クリップ頂点保持用
;	vf07:クリップ頂点保持用
;	vf08:
;	vf09:
;	vf10:
;	vf11:
;	vf12:
;	vf13:
;	vf14:
;	vf15:フォグパラメータ
;	vf16:
;	vf17:
;	vf18:
;	vf19:
;	vf20:
;	vf21:
;	vf22:
;	vf23:
;	vf24:
;	vf25:
;	vf26:
;	vf27:
;	vf28:
;	vf29:
;	vf30:
;	vf31:汎用

;	vi00:０
;	vi01:条件判断又はテンポラリ
;	vi02:クリップ頂点数
;	vi03:一時使用
;	vi04:一時使用
;	vi05:一時使用
;	vi06:
;	vi07:キックフラグ読み込み用
;	vi08:頂点数
;	vi09:読み込みデータアドレス
;	vi10:書き込みデータアドレス
;	vi11:0x4000定数＆汎用
;	vi12:処理フラグ記憶用
;	vi13:バッファ先頭アドレス
;	vi14:ダブルバッファ切り替えフラグ
;	vi15:リンクレジスタ＆クリップ処理チェックフラグ

; ================================================================
; クリッピングルーチン
; ================================================================
.if 0
ClipStart:
	nop								ibeq		vi15,vi00,ProgramEnd; -,クリップ処理スキップ
	nop								ilw.x		vi08,PACKDAT(vi13)	; 頂点数読み込み
	nop								iaddiu		vi09,vi13,DATA_OFT+SRC_NEXT*2	; -,読み込みアドレス設定
	nop								ilw.w		vi07,SRC_FLG(vi09)	; クリップフラグ読み込み
	nop								iaddi		vi08,vi08,-2		; ２頂点スキップしているので
	nop								iaddiu		vi01,vi13,TX0_OFT	; テクスチャ設定
	nop								xgkick		vi01				; テクスチャ設定（＝ワークが空くまでのウェイト）
	nop								iaddiu		vi14,vi00,0			; ダブルバッファフラグクリア
	nop								iaddiu		vi11,vi00,0x4000	; 定数設定
ClipLoop:
	nop								iand		vi01,vi07,vi11		; フラグチェック
	nop								iaddiu		vi02,vi00,3			; クリップ処理頂点数設定
	nop								ibeq		vi01,vi00,ClipSkip	; 
	nop								fcset		0					; 
	; クリップポリゴン発見時
	nop								ibne		vi14,vi00,l12		; 
	nop								lq.xyzw		vf04,SRC_XYZW-SRC_NEXT*2(vi09)	; -,第１座標読み込み
	nop								b			l13					; 
	nop								iaddiu		vi10,vi13,CWORK1	; 
l12:nop								iaddiu		vi10,vi13,CWORK2	;
l13:nop								lq.xyzw		vf05,SRC_XYZW-SRC_NEXT*1(vi09)	; -,第２座標読み込み
	nop								lq.xyzw		vf06,SRC_XYZW-SRC_NEXT*0(vi09)	; -,第３座標読み込み
	clipw.xyz	vf04,vf04			lq.xyzw		vf16,SRC_COL -SRC_NEXT*2(vi09)	; ,第１カラー読み込み
	clipw.xyz	vf05,vf05			lq.xyzw		vf17,SRC_UV0 -SRC_NEXT*2(vi09)	; ,第１ＵＶ０読み込み
	clipw.xyz	vf06,vf06			lq.xyzw		vf18,SRC_UV1 -SRC_NEXT*2(vi09)	; ,第１ＵＶ１読み込み
	nop								lq.xyzw		vf19,SRC_UV2 -SRC_NEXT*2(vi09)	; -,第１ＵＶ２読み込み
	nop								fcget		vi03							; 
	nop								fcget		vi04							; 
	nop								iand		vi03,vi03,vi04					; 
	nop								fcget		vi04							; 
	nop								iand		vi03,vi03,vi04					; 
	nop								sq.xyzw		vf16,DST_COL +DST_NEXT*0(vi10)	; 第１カラー書き込み
	nop								ibne		vi03,vi00,ClipSkip				; 
	nop								sq.xyzw		vf17,DST_UV0 +DST_NEXT*0(vi10)	; 第１ＵＶ０書き込み
	nop								sq.xyzw		vf18,DST_UV1 +DST_NEXT*0(vi10)	; 第１ＵＶ１書き込み
	nop								sq.xyzw		vf19,DST_UV2 +DST_NEXT*0(vi10)	; 第１ＵＶ２書き込み
	nop								lq.xyzw		vf16,SRC_COL -SRC_NEXT*1(vi09)	; 第２カラー読み込み
	nop								lq.xyzw		vf17,SRC_UV0 -SRC_NEXT*1(vi09)	; 第２ＵＶ０読み込み
	nop								lq.xyzw		vf18,SRC_UV1 -SRC_NEXT*1(vi09)	; 第２ＵＶ１読み込み
	nop								lq.xyzw		vf19,SRC_UV2 -SRC_NEXT*1(vi09)	; 第２ＵＶ２読み込み
	nop								sq.xyzw		vf16,DST_COL +DST_NEXT*1(vi10)	; 第２カラー書き込み
	nop								sq.xyzw		vf17,DST_UV0 +DST_NEXT*1(vi10)	; 第２ＵＶ０書き込み
	nop								sq.xyzw		vf18,DST_UV1 +DST_NEXT*1(vi10)	; 第２ＵＶ１書き込み
	nop								sq.xyzw		vf19,DST_UV2 +DST_NEXT*1(vi10)	; 第２ＵＶ２書き込み
	nop								lq.xyzw		vf16,SRC_COL -SRC_NEXT*0(vi09)	; 第３カラー読み込み
	nop								lq.xyzw		vf17,SRC_UV0 -SRC_NEXT*0(vi09)	; 第３ＵＶ０読み込み
	nop								lq.xyzw		vf18,SRC_UV1 -SRC_NEXT*0(vi09)	; 第３ＵＶ１読み込み
	nop								lq.xyzw		vf19,SRC_UV2 -SRC_NEXT*0(vi09)	; 第３ＵＶ２読み込み
	nop								sq.xyzw		vf16,DST_COL +DST_NEXT*2(vi10)	; 第３カラー書き込み
	nop								sq.xyzw		vf17,DST_UV0 +DST_NEXT*2(vi10)	; 第３ＵＶ０書き込み
	nop								sq.xyzw		vf18,DST_UV1 +DST_NEXT*2(vi10)	; 第３ＵＶ１書き込み
	nop								sq.xyzw		vf19,DST_UV2 +DST_NEXT*2(vi10)	; 第３ＵＶ２書き込み
	nop								sq.xyzw		vf04,DST_XYZ +DST_NEXT*0(vi10)	; 第１座標書き込み
	nop								sq.xyzw		vf05,DST_XYZ +DST_NEXT*1(vi10)	; 第２座標書き込み
	nop								sq.xyzw		vf06,DST_XYZ +DST_NEXT*2(vi10)	; 第３座標書き込み

	nop								fcand		vi01,0x10410		; 
	nop								ibeq		vi01,vi00,_clip_6	; 
	nop								nop								; 
	nop								bal			vi15,ZClip_p		; Ｚ＝Ｗ面によるクリップ
	nop								nop								; 
_clip_6:
	nop								bal			vi15,CorrectColor	; ＲＧＢＡ補正
	nop								nop								; 
	nop								fcand		vi01,0x820820		; 
	nop								ibeq		vi01,vi00,_clip_1	; 
	nop								nop								; 
	nop								bal			vi15,ZClip_m		; Ｚ＝−Ｗ面によるクリップ
	nop								nop								; 
_clip_1:
	nop								fcand		vi01,0x041041		; 
	nop								ibeq		vi01,vi00,_clip_2	; 
	nop								nop								; 
	nop								bal			vi15,XClip_p		; Ｘ＝Ｗ面によるクリップ
	nop								nop								; 
_clip_2:
	nop								fcand		vi01,0x082082		; 
	nop								ibeq		vi01,vi00,_clip_3	; 
	nop								nop								; 
	nop								bal			vi15,XClip_m		; Ｘ＝−Ｗ面によるクリップ
	nop								nop								; 
_clip_3:
	nop								fcand		vi01,0x104104		; 
	nop								ibeq		vi01,vi00,_clip_4	; 
	nop								nop								; 
	nop								bal			vi15,YClip_p		; Ｙ＝Ｗ面によるクリップ
	nop								nop								; 
_clip_4:
	nop								fcand		vi01,0x208208		; 
	nop								ibeq		vi01,vi00,_clip_5	; 
	nop								nop								; 
	nop								bal			vi15,YClip_m		; Ｙ＝−Ｗ面によるクリップ
	nop								nop								; 
_clip_5:

	; クリップ後に頂点が存在すれば描画を行う
	nop								isubiu		vi01,vi02,3			; 
	nop								lq.xyzw		vf16,GIFCLIP(vi13)	; ＧＩＦタグ読み込み
	nop								ibltz		vi01,ClipSkip		; 
	nop								iaddiu		vi01,vi00,0x4000	; 
	mulx.xyzw	vf27,vf27,vf00		iadd		vi01,vi01,vi01		; 
	nop								ior			vi01,vi01,vi02		; 
	nop								iaddi		vi10,vi10,-1		; 
	nop								loi			0.0001				; ＲＧＢＡ四捨五入用定数
	addi.xyz	vf27,vf27,I			sq.yzw		vf16,0(vi10)		; alphaには四捨五入を行なわない
	nop								isw.x		vi01,0(vi10)		; 
	nop								iaddiu		vi03,vi10,1			; 
	; 座標変換処理他
	nop								lq.xyzw		vf16,DST_XYZ(vi03)			; 
	nop								ilw.z		vi15,PACKDAT(vi13)			; 固定フォグ値読み出し
	nop								lq.xyzw		vf17,DST_COL(vi03)			; 
	nop								lq.xyzw		vf18,DST_UV0(vi03)			; 
	nop								div			Q,vf00w,vf16w				; 
	nop								lq.xyzw		vf19,DST_UV1(vi03)			; 
	nop								lq.xyzw		vf20,DST_UV2(vi03)			; 
	nop								iaddiu		vi01,vi00,0x0fff			; 
	nop								iand		vi15,vi15,vi01				; 
	nop								mfir.w		vf21,vi15					; フォグ値設定
_clip_0:
	mulq.xyz	vf21,vf16,Q			waitq									; 透視変換
	mulaq.xyzw	ACC ,vf17,Q			nop										; ＲＧＢＡ値補正,
	maddw.xyzw	vf22,vf27,vf00		lq.xyzw		vf16,DST_XYZ+DST_NEXT(vi03)	; ＲＧＢＡ値補正,(先)頂点読み込み
	mulq.xyz	vf23,vf18,Q			lq.xyzw		vf17,DST_COL+DST_NEXT(vi03)	; ＳＴＱ０,(先)色読み込み
	mulq.xyzw	vf24,vf19,Q			lq.xyzw		vf18,DST_UV0+DST_NEXT(vi03)	; ＳＴＱ１,(先)ＵＶ０読み込み
	mulq.xyzw	vf25,vf20,Q			lq.xyzw		vf19,DST_UV1+DST_NEXT(vi03)	; ＳＴＱ２,(先)ＵＶ０読み込み
	mula.xyz	ACC ,vf21,vf02		lq.xyzw		vf20,DST_UV2+DST_NEXT(vi03)	; プリミティブ座標,
	maddw.xyz	vf21,vf03,vf00		iaddi		vi02,vi02,-1				; プリミティブ座標,頂点数減算
	ftoi0.xyzw	vf22,vf22			div			Q,vf00w,vf16w				; 色整数化,(先)透視変換
	nop								iaddiu		vi03,vi03,DST_NEXT			; -,読み込みアドレス増加
	nop								sq.xyz		vf23,DST_UV0-DST_NEXT(vi03)	; -,ＵＶ０書き戻し
	ftoi4.xyz	vf21,vf21			sq.xyz		vf24,DST_UV1-DST_NEXT(vi03)	; 頂点整数化,ＵＶ１書き戻し
	nop								sq.xyz		vf25,DST_UV2-DST_NEXT(vi03)	; ,ＵＶ２書き戻し
	nop								sq.xyzw		vf22,DST_COL-DST_NEXT(vi03)	; -,色書き戻し
	nop								ibgtz		vi02,_clip_0				; 
	nop								sq.xyzw		vf21,DST_XYZ-DST_NEXT(vi03)	; -,座標書き戻し

	; テクスチャ０描画
	nop								iaddiu		vi01,vi13,TX0_OFT	; -,テクスチャ設定
	nop								xgkick		vi01				; -,テクスチャ設定（＆XGKICKウェイト）
	nop								lq.xyzw		vf31,GIFREGS(vi13)	; GIFTAGレジスタリスト読み込み
	nop								xgkick		vi10				; 

	; テクスチャ１描画
	nop								iaddiu		vi01,vi00,FLAG_TEX1	; 
	nop								iand		vi01,vi12,vi01		; 
	nop								iaddiu		vi03,vi13,TX1_OFT	; 
	nop								ibeq		vi01,vi00,l14		; 
	nop								nop								; 
	nop								xgkick		vi03				; 
	nop								nop								; 
	nop								sq.z		vf31,0x00(vi10)		; 
	nop								xgkick		vi10				; 
l14:

	; テクスチャ２描画
	nop								iaddiu		vi01,vi00,FLAG_TEX2	; 
	nop								iand		vi01,vi12,vi01		; 
	nop								iaddiu		vi03,vi13,TX2_OFT	; 
	nop								ibeq		vi01,vi00,l15		; 
	nop								mr32.xyzw	vf31,vf31			; 
	nop								xgkick		vi03				; 
	nop								nop								; 
	nop								sq.z		vf31,0x00(vi10)		; 
	nop								xgkick		vi10				; 
l15:

	nop								iaddiu		vi01,vi00,1			; 
	nop								isub		vi14,vi01,vi14		; バッファ切り替え

ClipSkip:
	nop								iaddi		vi08,vi08,-1		; カウンタ減算
	nop								iaddiu		vi09,vi09,SRC_NEXT	; 読み込みアドレス増加
	nop								ilw.w		vi07,SRC_FLG(vi09)	; クリップフラグ読み込み
	nop								ibgtz		vi08,ClipLoop		; 
	nop								iaddiu		vi11,vi00,0x4000	; 定数設定

	nop								b			ProgramEnd			; 
	nop								nop								; 

.else

ClipStart:
	nop								ibeq		vi15,vi00,ProgramEnd; -,クリップ処理スキップ
	nop								ilw.x		vi08,PACKDAT(vi13)	; 頂点数読み込み
	nop								iaddiu		vi09,vi13,DATA_OFT+SRC_NEXT*2	; -,読み込みアドレス設定
	nop								ilw.w		vi07,SRC_FLG(vi09)	; クリップフラグ読み込み
	nop								iaddi		vi08,vi08,-2		; ２頂点スキップしているので
	nop								iaddiu		vi01,vi13,TX0_OFT	; テクスチャ設定
	nop								xgkick		vi01				; テクスチャ設定（＝ワークが空くまでのウェイト）
	nop								iaddiu		vi14,vi00,0			; ダブルバッファフラグクリア
	nop								iaddiu		vi11,vi00,0x4000	; 定数設定
ClipLoop:
	nop								iand		vi01,vi07,vi11		; フラグチェック
	nop								iaddiu		vi02,vi00,3			; クリップ処理頂点数設定
	nop								ibeq		vi01,vi00,ClipSkip	; 
	nop								fcset		0					; 
	; クリップポリゴン発見時
	nop								ibne		vi14,vi00,l12		; 
	nop								lq.xyzw		vf04,SRC_XYZW-SRC_NEXT*2(vi09)	; -,第１座標読み込み
	nop								b			l13					; 
	nop								iaddiu		vi10,vi13,CWORK1	; 
l12:nop								iaddiu		vi10,vi13,CWORK2	;
l13:nop								lq.xyzw		vf05,SRC_XYZW-SRC_NEXT*1(vi09)	; -,第２座標読み込み
	nop								lq.xyzw		vf06,SRC_XYZW-SRC_NEXT*0(vi09)	; -,第３座標読み込み
	clipw.xyz	vf04,vf04			lq.xyzw		vf16,SRC_COL -SRC_NEXT*2(vi09)	; ,第１カラー読み込み
	clipw.xyz	vf05,vf05			lq.xyzw		vf17,SRC_UV0 -SRC_NEXT*2(vi09)	; ,第１ＵＶ０読み込み
	clipw.xyz	vf06,vf06			lq.xyzw		vf18,SRC_UV1 -SRC_NEXT*2(vi09)	; ,第１ＵＶ１読み込み
	nop								lq.xyzw		vf19,SRC_UV2 -SRC_NEXT*2(vi09)	; -,第１ＵＶ２読み込み
	nop								fcget		vi03							; 
	nop								fcget		vi04							; 
	nop								iand		vi03,vi03,vi04					; 
	nop								fcget		vi04							; 
	nop								iand		vi03,vi03,vi04					; 
	nop								sq.xyzw		vf16,DST_COL +DST_NEXT*0(vi10)	; 第１カラー書き込み
	nop								ibne		vi03,vi00,ClipSkip				; 
	nop								sq.xyzw		vf17,DST_UV0 +DST_NEXT*0(vi10)	; 第１ＵＶ０書き込み
	nop								sq.xyzw		vf18,DST_UV1 +DST_NEXT*0(vi10)	; 第１ＵＶ１書き込み
	nop								sq.xyzw		vf19,DST_UV2 +DST_NEXT*0(vi10)	; 第１ＵＶ２書き込み
	nop								lq.xyzw		vf16,SRC_COL -SRC_NEXT*1(vi09)	; 第２カラー読み込み
	nop								lq.xyzw		vf17,SRC_UV0 -SRC_NEXT*1(vi09)	; 第２ＵＶ０読み込み
	nop								lq.xyzw		vf18,SRC_UV1 -SRC_NEXT*1(vi09)	; 第２ＵＶ１読み込み
	nop								lq.xyzw		vf19,SRC_UV2 -SRC_NEXT*1(vi09)	; 第２ＵＶ２読み込み
	nop								sq.xyzw		vf16,DST_COL +DST_NEXT*1(vi10)	; 第２カラー書き込み
