;
;	t3_cull.vu1
;	カリング、クリップ処理付きマルチテクスチャ描画ＶＵ１プログラム（フォグ対応）
;
;	2001/02/13 K.Takabe
;	$Id: t3_cull.vu1,v 1.1.1.3 2002/11/19 11:42:29 Yoshizawa1 Exp $
;

; ================================================================
; 通常レジスタ割り当て
; ================================================================
;	vf00:fix
;	vf01:定数読み込みベクトル
;	vf02:プリミティブ座標変換スケール
;	vf03:プリミティブ座標変換オフセット
;	vf04:透視変換マトリクス
;	vf05:透視変換マトリクス
;	vf06:透視変換マトリクス
;	vf07:透視変換マトリクス
;	vf08:ローカルライトマトリクス
;	vf09:ローカルライトマトリクス
;	vf10:ローカルライトマトリクス
;	vf11:フォグパラメータ
;	vf12:ローカルカラーマトリクス
;	vf13:ローカルカラーマトリクス
;	vf14:ローカルカラーマトリクス
;	vf15:ローカルカラーマトリクス
;	vf16:頂点読み込み
;	vf17:法線読み込み
;	vf18:ＵＶ０読み込み
;	vf19:変換後頂点
;	vf20:変換後法線
;	vf21:
;	vf22:書き込み頂点
;	vf24:書き込みカラー
;	vf25:書き込みＵＶ０
;	vf26:計算用テンポラリ
;	vf27:計算用テンポラリ
;	vf28:エンベロープ計算用マトリクス
;	vf29:エンベロープ計算用マトリクス
;	vf30:エンベロープ計算用マトリクス
;	vf31:エンベロープ計算用マトリクス

;	vi00:０
;	vi01:条件判断又はテンポラリ
;	vi02:条件判断他
;	vi03:条件判他断
;	vi04:定数記憶用
;	vi05:キックフラグチェック用
;	vi06:
;	vi07:キックフラグ読み込み用
;	vi08:頂点数
;	vi09:読み込みデータアドレス
;	vi10:書き込みデータアドレス
;	vi11:エンベロープマトリクス読み取りアドレス
;	vi12:処理フラグ記憶用
;	vi13:バッファ先頭アドレス
;	vi14:クリップフラグ設定定数
;	vi15:リンクレジスタ＆クリップ処理チェックフラグ

CULL_ON:


; ================================================================
; 光源計算付き透視変換ルーチン
; ================================================================
;	upper		.					lower		.
ClipTransStart:
	; 変換初期化処理
	; バッファアドレス、ループ回数のセットとデータのプリロード処理
	nop								xtop		vi13				; -,
	nop								ilw.w		vi01,PACKDAT(vi13)	; -,バウンディングフラグ読み込み
	nop								lq.xyzw		vf01,FV_PRM(vi00)	; -,定数読み込み
	nop								lq.xyzw		vf02,FV_SCN(vi00)	; -,定数読みみ込
	nop								lq.xyzw		vf03,FV_OFT(vi00)	; -,定数読み込み
	nop								ibeq		vi01,vi00,FastTransStart ;	バースト描画
	nop								ilw.x		vi08,PACKDAT(vi13)	; -,処理頂点数の読み込み
	nop								lq.yzw		vf04,GIFNORMAL(vi13); -,GIFタグ生成
	nop								iaddiu		vi01,vi00,0x4000	; -,GIFタグ生成
	nop								iadd		vi01,vi01,vi01		; -,GIFタグ生成
	nop								ior			vi01,vi01,vi08		; -,GIFタグ生成
	nop								isw.x		vi01,WORK_TOP(vi13)	; -,GIFタグ生成
	nop								sq.yzw		vf04,WORK_TOP(vi13)	; -,GIFタグ生成
	nop								iaddiu		vi09,vi13,DATA_OFT	; -,データ先読みアドレス設定
	nop								iaddiu		vi10,vi13,PACK_TOP	; -,データ書き戻しアドレス設定
	nop								lq.xyzw		vf16,BUF_VERT(vi09)	; -,第１頂点読み込み
	nop								lq.xyzw		vf17,BUF_NORM(vi09)	; -,第１法線（＆キック情報）読み込み
	nop								lq.xyzw		vf04,M_PRS0(vi13)	; -,透視変換マトリクスロード
	nop								lq.xyzw		vf05,M_PRS1(vi13)	; -,透視変換マトリクスロード
	itof0.xyzw	vf16,vf16			lq.xyzw		vf06,M_PRS2(vi13)	; -,透視変換マトリクスロード
	itof12.xyz	vf17,vf17			lq.xyzw		vf07,M_PRS3(vi13)	; -,透視変換マトリクスロード
	nop								lq.xyzw		vf08,M_LIT0(vi13)	; -,ローカルライトマトリクス読み込み
	nop								lq.xyzw		vf09,M_LIT1(vi13)	; -,ローカルライトマトリクス読み込み
	nop								lq.xyzw		vf10,M_LIT2(vi13)	; -,ローカルライトマトリクス読み込み
	nop								lq.xyzw		vf12,M_COL0(vi13)	; -,ローカルカラーマトリクス読み込み
	nop								lq.xyzw		vf13,M_COL1(vi13)	; -,ローカルカラーマトリクス読み込み
	nop								lq.xyzw		vf14,M_COL2(vi13)	; -,ローカルカラーマトリクス読み込み
	nop								lq.xyzw		vf15,M_COL3(vi13)	; -,ローカルカラーマトリクス読み込み
	nop								ilw.z		vi06,PACKDAT(vi13)	; -,固定フォグ値記憶
	muly.w		vf20,vf00,vf01		fcset		0					; アルファ設定,クリップチェック初期化
	nop								iaddiu		vi15,vi00,0			; -,全体クリップチェックフラグクリア
	nop								isubiu		vi14,vi00,0x4000	; (vi14 = 0xc000)
	nop								iaddiu		vi04,vi00,0x4000	; キックフラグ用マスク
	nop								iaddiu		vi04,vi04,0x4000	; キックフラグ用マスク(vi04 = 0x8000)
	nop								sq.xyz		vf17,SRC_NORM(vi09)	; ,(先)環境マップ用保存

	nop								isub		vi06,vi06,vi04		; カリング用デバッグコード


	; ディレイ処理の為の前処理
	mulax.xyzw	ACC ,vf04,vf16		ilw.w		vi07,BUF_FLG(vi09)			; 透視変換,キックフラグ
	madday.xyzw	ACC ,vf05,vf16		lq.xyzw		vf18,BUF_UV0(vi09)			; 透視変換,ＵＶ読み込み
	maddaz.xyzw	ACC ,vf06,vf16		iaddiu		vi09,vi09,BUF_NEXT			; 透視変換,読み込みアドレス増加
	maddw.xyzw	vf19,vf07,vf00		lq.xyzw		vf16,BUF_VERT(vi09)			; 透視変換,(先)頂点読み込み
	minix.xyzw	vf24,vf20,vf01		iaddi		vi08,vi08,-1				; (遅)光源計算,カウンタのデクリメント
	mulax.xyz	ACC ,vf08,vf17		nop										; 光源計算,(遅)ＵＶ座標
	madday.xyz	ACC ,vf09,vf17		iand		vi05,vi07,vi04				; 光源計算,キックフラグ
	clipw.xyz	vf19,vf19			div			Q,vf00w,vf19w				; クリップ,透視変換
	maddz.xyz	vf20,vf10,vf17		sq.xyzw		vf19,SRC_XYZW-SRC_NEXT(vi09); 光源計算,クリップ用保存
	ftoi4.xyz	vf22,vf22			lq.xyzw		vf17,BUF_NORM(vi09)			; (遅)透視変換,(先)法線読み込み
	itof0.xyzw	vf16,vf16			nop										; (先)透視変換,(遅)クリップ用保存
	itof12.xyz	vf18,vf18			fcand		vi01,0x3ffff				; ＵＶ座標,クリップ
	maxx.xyzw	vf20,vf20,vf00		ibeq		vi01,vi00,l01				; 光源計算,クリップ
	ftoi0.xyzw	vf24,vf24			ior			vi05,vi05,vi06				; (遅)光源計算,フォグ処理
	nop								ibltz		vi07,l01					; ●
	nop								ior			vi05,vi05,vi04				; ●
	nop								ior			vi07,vi07,vi14				; ●
	nop								iaddiu		vi15,vi15,1					; ●
l01:itof12.xyz	vf17,vf17			isw.w		vi05,DST_XYZ(vi10)			; (先)光源計算,描画キック
	mulq.xyzw	vf22,vf19,Q			nop										; 透視変換,(遅)透視変換
	mulax.xyz	ACC ,vf12,vf20		sq.xyzw		vf18,SRC_UV0-SRC_NEXT(vi09)	; 光源計算,クリップ用保存
	madday.xyz	ACC ,vf13,vf20		nop										; 光源計算,(遅)光源計算
	maddaz.xyz	ACC ,vf14,vf20		isw.w		vi07,SRC_FLG-SRC_NEXT(vi09)	; 光源計算,クリップ用保存
	maddw.xyz	vf20,vf15,vf00		sq.xyz		vf17,SRC_NORM(vi09)			; 光源計算,(先)環境マップ用保存
	mulq.xyz	vf25,vf18,Q			iaddiu		vi10,vi10,DST_NEXT			; ＵＶ座標,書き込みアドレス増加
	mula.xyz	ACC ,vf22,vf02		ibgtz		vi08,_ClipTransLoop			; 透視変換,ループジャンプ
	maddw.xyz	vf22,vf03,vf00		nop										; 透視変換,

_ClipTransLoop:
	; 頂点変換処理（途中で次の頂点の情報を読み込んでおく）
	mulax.xyzw	ACC ,vf04,vf16		ilw.w		vi07,BUF_FLG(vi09)			; 透視変換,キックフラグ
	madday.xyzw	ACC ,vf05,vf16		lq.xyzw		vf18,BUF_UV0(vi09)			; 透視変換,ＵＶ読み込み
	maddaz.xyzw	ACC ,vf06,vf16		iaddiu		vi09,vi09,BUF_NEXT			; 透視変換,読み込みアドレス増加
	maddw.xyzw	vf19,vf07,vf00		lq.xyzw		vf16,BUF_VERT(vi09)			; 透視変換,(先)頂点読み込み
	minix.xyzw	vf24,vf20,vf01		iaddi		vi08,vi08,-1				; (遅)光源計算,カウンタのデクリメント
	mulax.xyz	ACC ,vf08,vf17		sq.xyz		vf25,DST_UV0-DST_NEXT(vi10)	; 光源計算,(遅)ＵＶ座標
	madday.xyz	ACC ,vf09,vf17		iand		vi05,vi07,vi04				; 光源計算,キックフラグ
	clipw.xyz	vf19,vf19			div			Q,vf00w,vf19w				; クリップ,透視変換
	maddz.xyz	vf20,vf10,vf17		sq.xyzw		vf19,SRC_XYZW-SRC_NEXT(vi09); 光源計算,クリップ用保存
	ftoi4.xyz	vf22,vf22			lq.xyzw		vf17,BUF_NORM(vi09)			; (遅)透視変換,(先)法線読み込み
	itof0.xyzw	vf16,vf16			sq.xyzw		vf24,SRC_COL-SRC_NEXT*2(vi09);(先)透視変換,(遅)クリップ用保存
	itof12.xyz	vf18,vf18			fcand		vi01,0x3ffff				; ＵＶ座標,クリップ
	maxx.xyzw	vf20,vf20,vf00		ibeq		vi01,vi00,l02				; 光源計算,クリップ
	ftoi0.xyzw	vf24,vf24			ior			vi05,vi05,vi06				; (遅)光源計算,フォグ処理
	nop								ibltz		vi07,l02					; ●
	nop								ior			vi05,vi05,vi04				; ●
	nop								ior			vi07,vi07,vi14				; ●
	nop								iaddiu		vi15,vi15,1					; ●
l02:itof12.xyz	vf17,vf17			isw.w		vi05,DST_XYZ(vi10)			; (先)光源計算,描画キック
	mulq.xyzw	vf22,vf19,Q			sq.xyz		vf22,DST_XYZ-DST_NEXT(vi10)	; 透視変換,(遅)透視変換
	mulax.xyz	ACC ,vf12,vf20		sq.xyzw		vf18,SRC_UV0-SRC_NEXT(vi09)	; 光源計算,クリップ用保存
	madday.xyz	ACC ,vf13,vf20		sq.xyzw		vf24,DST_COL-DST_NEXT(vi10)	; 光源計算,(遅)光源計算
	maddaz.xyz	ACC ,vf14,vf20		isw.w		vi07,SRC_FLG-SRC_NEXT(vi09)	; 光源計算,クリップ用保存
	maddw.xyz	vf20,vf15,vf00		sq.xyz		vf17,SRC_NORM(vi09)			; 光源計算,環境マップ用保存
	mulq.xyz	vf25,vf18,Q			iaddiu		vi10,vi10,DST_NEXT			; ＵＶ座標,(先)書き込みアドレス増加
	mula.xyz	ACC ,vf22,vf02		ibgtz		vi08,_ClipTransLoop			; 透視変換,ループジャンプ
	maddw.xyz	vf22,vf03,vf00		nop										; 透視変換,

	; 後始末
	nop								ilw.y		vi12,PACKDAT(vi13)	; -,処理フラグ取得
	nop								iaddiu		vi02,vi00,FLAG_CULL			; カリング
	minix.xyzw	vf24,vf20,vf01		iaddiu		vi01,vi13,TX0_OFT			; (遅)光源計算,テクスチャ設定
	ftoi4.xyz	vf22,vf22			xgkick		vi01						; (遅)透視変換,テクスチャ設定
	nop								sq.xyz		vf25,DST_UV0-DST_NEXT(vi10)	; (遅)光源計算,(遅)ＵＶ座標
	nop								iand		vi02,vi02,vi12				; カリング
	ftoi0.xyzw	vf24,vf24			sq.xyzw		vf24,SRC_COL-SRC_NEXT(vi09);-,(遅)クリップ用保存
	nop								sq.xyz		vf22,DST_XYZ-DST_NEXT(vi10)	; -,(遅)透視変換
	nop								sq.xyzw		vf24,DST_COL-DST_NEXT(vi10)	; -,(遅)光源計算
.ifdef CULL_ON
	nop								ibeq		vi02,vi00,2					; カリング（アドレス直指定）
	nop								nop										; カリング
	nop								bal			vi14,CullStart				; カリング
	nop								nop										; カリング
.endif

	; 終端ダミーパケットをキックし待機
	nop								iaddiu		vi01,vi13,WORK_TOP	; 
	nop								xgkick		vi01				; ＧＩＦへのキック
	nop								b			MultiTextureDraw	; 
	nop								nop								; 




; ================================================================
; エンベロープ対応ルーチン
; ================================================================
;	upper		.					lower		.
ClipTransEnvelopeStart:
	; 変換初期化処理
	; バッファアドレス、ループ回数のセットとデータのプリロード処理
	nop								xtop		vi13				; -,
	nop								ilw.w		vi01,PACKDAT(vi13)	; -,バウンディングフラグ読み込み
	nop								lq.xyzw		vf01,FV_PRM(vi00)	; -,定数読み込み
	nop								lq.xyzw		vf02,FV_SCN(vi00)	; -,定数読みみ込
	nop								lq.xyzw		vf03,FV_OFT(vi00)	; -,定数読み込み
	nop								ibeq		vi01,vi00,FastTransEnvelopeStart ;	バースト描画
	nop								ilw.x		vi08,PACKDAT(vi13)	; -,処理頂点数の読み込み
	nop								lq.yzw		vf04,GIFNORMAL(vi13); -,GIFタグ生成
	nop								iaddiu		vi01,vi00,0x4000	; -,GIFタグ生成
	nop								iadd		vi01,vi01,vi01		; -,GIFタグ生成
	nop								ior			vi01,vi01,vi08		; -,GIFタグ生成
	nop								isw.x		vi01,WORK_TOP(vi13)	; -,GIFタグ生成
	nop								sq.yzw		vf04,WORK_TOP(vi13)	; -,GIFタグ生成
	nop								iaddiu		vi09,vi13,DATA_OFT	; -,データ先読みアドレス設定
	nop								iaddiu		vi10,vi13,PACK_TOP	; -,データ書き戻しアドレス設定
	nop								lq.xyzw		vf16,BUF_VERT(vi09)	; -,第１頂点読み込み
	nop								lq.xyzw		vf17,BUF_NORM(vi09)	; -,第１法線（＆キック情報）読み込み
	nop								lq.xyzw		vf28,M_SUP0(vi13)	; エンベロープ補正マトリクス読み込み
	nop								lq.xyzw		vf29,M_SUP1(vi13)	; エンベロープ補正マトリクス読み込み
	itof0.xyz	vf16,vf16			lq.xyzw		vf30,M_SUP2(vi13)	; エンベロープ補正マトリクス読み込み
	itof12.w	vf26,vf16			lq.xyzw		vf31,M_SUP3(vi13)	; エンベロープ補正マトリクス読み込み
	itof12.xyz	vf17,vf17			lq.xyzw		vf04,M_PRS0(vi13)	; -,透視変換マトリクスロード
	nop								lq.xyzw		vf05,M_PRS1(vi13)	; -,透視変換マトリクスロード
	mulax.xyz	ACC ,vf28,vf16		lq.xyzw		vf06,M_PRS2(vi13)	; trans_v,透視変換マトリクスロード
	madday.xyz	ACC ,vf29,vf16		lq.xyzw		vf07,M_PRS3(vi13)	; trans_v,透視変換マトリクスロード
	maddaz.xyz	ACC ,vf30,vf16		lq.xyzw		vf08,M_LIT0(vi13)	; trans_v,ローカルライトマトリクス読み込み
	maddw.xyz	vf26,vf31,vf00		lq.xyzw		vf09,M_LIT1(vi13)	; trans_v,ローカルライトマトリクス読み込み
	sub.w		vf27,vf00,vf26		lq.xyzw		vf10,M_LIT2(vi13)	; make v&n,ローカルライトマトリクス読み込み
	mulax.xyz	ACC ,vf28,vf17		lq.xyzw		vf12,M_COL0(vi13)	; trans_n,ローカルカラーマトリクス読み込み
	madday.xyz	ACC ,vf29,vf17		lq.xyzw		vf13,M_COL1(vi13)	; trans_n,ローカルカラーマトリクス読み込み
	maddz.xyz	vf27,vf30,vf17		lq.xyzw		vf14,M_COL2(vi13)	; trans_n,ローカルカラーマトリクス読み込み
	mulaw.xyz	ACC ,vf16,vf26		lq.xyzw		vf15,M_COL3(vi13)	; make v,ローカルカラーマトリクス読み込み
	maddw.xyz	vf16,vf26,vf27		ilw.z		vi06,PACKDAT(vi13)	; make v,固定フォグ値記憶
	mulaw.xyz	ACC ,vf17,vf26		isubiu		vi14,vi00,0x4000	; make n,vi14 = 0xc000
	maddw.xyz	vf17,vf27,vf27		fcset		0					; make n,クリップチェック初期化
	muly.w		vf20,vf00,vf01		iaddiu		vi15,vi00,0			; アルファ設定,全体クリップチェックフラグクリア
	nop								iaddiu		vi04,vi00,0x4000	; キックフラグ用マスク
	nop								iaddiu		vi04,vi04,0x4000	; キックフラグ用マスク(vi04 = 0x8000)

	nop								isub		vi06,vi06,vi04		; カリング用デバッグコード


	; ディレイ処理の為の前処理
	mulax.xyzw	ACC ,vf04,vf16		ilw.w		vi07,BUF_FLG(vi09)			; 透視変換,キックフラグ
	madday.xyzw	ACC ,vf05,vf16		lq.xyzw		vf18,BUF_UV0(vi09)			; 透視変換,ＵＶ読み込み
	maddaz.xyzw	ACC ,vf06,vf16		iaddiu		vi09,vi09,BUF_NEXT			; 透視変換,読み込みアドレス増加
	maddw.xyzw	vf19,vf07,vf00		lq.xyzw		vf16,BUF_VERT(vi09)			; 透視変換,(先)頂点読み込み
	minix.xyzw	vf24,vf20,vf01		iaddi		vi08,vi08,-1				; (遅)光源計算,カウンタのデクリメント
	mulax.xyz	ACC ,vf08,vf17		nop										; 光源計算,(遅)ＵＶ座標
	madday.xyz	ACC ,vf09,vf17		sq.xyz		vf17,SRC_NORM-SRC_NEXT(vi09); 光源計算,環境マップ用保存
	clipw.xyz	vf19,vf19			div			Q,vf00w,vf19w				; クリップ,透視変換
	maddz.xyz	vf20,vf10,vf17		sq.xyzw		vf19,SRC_XYZW-SRC_NEXT(vi09); 光源計算,クリップ用保存
	ftoi4.xyz	vf22,vf22			lq.xyzw		vf17,BUF_NORM(vi09)			; (遅)透視変換,(先)法線読み込み
	itof0.xyz	vf16,vf16			nop										; (先)透視変換,(遅)クリップ用保存
	itof12.w	vf26,vf16			iand		vi05,vi07,vi04				; (先)エンベロープ,キックフラグ
	itof12.xyz	vf18,vf18			fcand		vi01,0x3ffff				; ＵＶ座標,クリップ
	maxx.xyzw	vf20,vf20,vf00		ibeq		vi01,vi00,l03				; 光源計算,クリップ
	ftoi0.xyzw	vf24,vf24			ior			vi05,vi05,vi06				; (遅)光源計算,フォグ処理
	nop								ibltz		vi07,l03					; ●
	nop								ior			vi05,vi05,vi04				; ●
	nop								ior			vi07,vi07,vi14				; ●
	nop								iaddiu		vi15,vi15,1					; ●
l03:itof12.xyz	vf17,vf17			isw.w		vi05,DST_XYZ(vi10)			; (先)光源計算,描画キック
	mulq.xyzw	vf22,vf19,Q			nop										; 透視変換,(遅)透視変換
	mulax.xyz	ACC ,vf12,vf20		sq.xyzw		vf18,SRC_UV0-SRC_NEXT(vi09)	; 光源計算,クリップ用保存
	madday.xyz	ACC ,vf13,vf20		nop										; 光源計算,(遅)光源計算
	maddaz.xyz	ACC ,vf14,vf20		isw.w		vi07,SRC_FLG-SRC_NEXT(vi09)	; 光源計算,クリップ用保存
	maddw.xyz	vf20,vf15,vf00		ibgtz		vi08,_ClipTransEnvelopeLoop	; 光源計算,ループジャンプ
	mulq.xyz	vf25,vf18,Q			iaddiu		vi10,vi10,DST_NEXT			; ＵＶ座標,書き込みアドレス増加

_ClipTransEnvelopeLoop:
	; 頂点変換処理（途中で次の頂点の情報を読み込んでおく）
	mulax.xyz	ACC ,vf28,vf16		nop								; trans_v
	madday.xyz	ACC ,vf29,vf16		nop								; trans_v,-
	maddaz.xyz	ACC ,vf30,vf16		nop								; trans_v,make v
	maddw.xyz	vf26,vf31,vf00		nop								; trans_v,-
	sub.w		vf27,vf00,vf26		nop								; make v&n,-
	mulax.xyz	ACC ,vf28,vf17		nop								; trans_n,-
	madday.xyz	ACC ,vf29,vf17		nop								; trans_n,-
	maddz.xyz	vf27,vf30,vf17		nop								; trans_n,-
	mulaw.xyz	ACC ,vf16,vf26		nop								; make v,-
	maddw.xyz	vf16,vf26,vf27		nop								; make v,-
	mulaw.xyz	ACC ,vf17,vf26		nop								; make n,-
	maddw.xyz	vf17,vf27,vf27		nop								; make n,-
	mula.xyz	ACC ,vf22,vf02		nop										; 透視変換,
	maddw.xyz	vf22,vf03,vf00		nop										; 透視変換,

	mulax.xyzw	ACC ,vf04,vf16		ilw.w		vi07,BUF_FLG(vi09)			; 透視変換,キックフラグ
	madday.xyzw	ACC ,vf05,vf16		lq.xyzw		vf18,BUF_UV0(vi09)			; 透視変換,ＵＶ読み込み
	maddaz.xyzw	ACC ,vf06,vf16		iaddiu		vi09,vi09,BUF_NEXT			; 透視変換,読み込みアドレス増加
	maddw.xyzw	vf19,vf07,vf00		lq.xyzw		vf16,BUF_VERT(vi09)			; 透視変換,(先)頂点読み込み
	minix.xyzw	vf24,vf20,vf01		iaddi		vi08,vi08,-1				; (遅)光源計算,カウンタのデクリメント
	mulax.xyz	ACC ,vf08,vf17		sq.xyz		vf25,DST_UV0-DST_NEXT(vi10)	; 光源計算,(遅)ＵＶ座標
	madday.xyz	ACC ,vf09,vf17		sq.xyz		vf17,SRC_NORM-SRC_NEXT(vi09); 光源計算,環境マップ用保存
	clipw.xyz	vf19,vf19			div			Q,vf00w,vf19w				; クリップ,透視変換
	maddz.xyz	vf20,vf10,vf17		sq.xyzw		vf19,SRC_XYZW-SRC_NEXT(vi09); 光源計算,クリップ用保存
	ftoi4.xyz	vf22,vf22			lq.xyzw		vf17,BUF_NORM(vi09)			; (遅)透視変換,(先)法線読み込み
	itof0.xyz	vf16,vf16			sq.xyzw		vf24,SRC_COL-SRC_NEXT*2(vi09);(先)透視変換,(遅)クリップ用保存
	itof12.w	vf26,vf16			iand		vi05,vi07,vi04				; (先)エンベロープ,キックフラグ
	itof12.xyz	vf18,vf18			fcand		vi01,0x3ffff				; ＵＶ座標,クリップ
	maxx.xyzw	vf20,vf20,vf00		ibeq		vi01,vi00,l04				; 光源計算,クリップ
	ftoi0.xyzw	vf24,vf24			ior			vi05,vi05,vi06				; (遅)光源計算,フォグ処理
	nop								ibltz		vi07,l04					; ●
	nop								ior			vi05,vi05,vi04				; ●
	nop								ior			vi07,vi07,vi14				; ●
	nop								iaddiu		vi15,vi15,1					; ●
l04:itof12.xyz	vf17,vf17			isw.w		vi05,DST_XYZ(vi10)			; (先)光源計算,描画キック
	mulq.xyzw	vf22,vf19,Q			sq.xyz		vf22,DST_XYZ-DST_NEXT(vi10)	; 透視変換,(遅)透視変換
	mulax.xyz	ACC ,vf12,vf20		sq.xyzw		vf18,SRC_UV0-SRC_NEXT(vi09)	; 光源計算,クリップ用保存
	madday.xyz	ACC ,vf13,vf20		sq.xyzw		vf24,DST_COL-DST_NEXT(vi10)	; 光源計算,(遅)光源計算
	maddaz.xyz	ACC ,vf14,vf20		isw.w		vi07,SRC_FLG-SRC_NEXT(vi09)	; 光源計算,クリップ用保存
	maddw.xyz	vf20,vf15,vf00		ibgtz		vi08,_ClipTransEnvelopeLoop	; 光源計算,ループジャンプ
	mulq.xyz	vf25,vf18,Q			iaddiu		vi10,vi10,DST_NEXT			; ＵＶ座標,書き込みアドレス増加

	; 後始末
	mula.xyz	ACC ,vf22,vf02		nop										; 透視変換,
	maddw.xyz	vf22,vf03,vf00		nop										; 透視変換,
	nop								ilw.y		vi12,PACKDAT(vi13)	; -,処理フラグ取得
	nop								iaddiu		vi02,vi00,FLAG_CULL			; カリング
	minix.xyzw	vf24,vf20,vf01		iaddiu		vi01,vi13,TX0_OFT			; (遅)光源計算,テクスチャ設定
	ftoi4.xyz	vf22,vf22			xgkick		vi01						; (遅)透視変換,テクスチャ設定
	nop								sq.xyz		vf25,DST_UV0-DST_NEXT(vi10)	; (遅)光源計算,(遅)ＵＶ座標
	nop								iand		vi02,vi02,vi12				; カリング
	ftoi0.xyzw	vf24,vf24			sq.xyzw		vf24,SRC_COL-SRC_NEXT(vi09);-,(遅)クリップ用保存
	nop								sq.xyz		vf22,DST_XYZ-DST_NEXT(vi10)	; -,(遅)透視変換
	nop								sq.xyzw		vf24,DST_COL-DST_NEXT(vi10)	; -,(遅)光源計算
.ifdef CULL_ON
	nop								ibeq		vi02,vi00,2					; カリング（アドレス直指定）
	nop								nop										; カリング
	nop								bal			vi14,CullStart				; カリング
	nop								nop										; カリング
.endif

	; 終端ダミーパケットをキックし待機
	nop								iaddiu		vi01,vi13,WORK_TOP	; 
	nop								xgkick		vi01				; ＧＩＦへのキック
	nop								b			MultiTextureDraw	; 
	nop								nop								; 



; ================================================================
; 光源計算＋頂点カラー付き透視変換ルーチン
; ================================================================
;	upper		.					lower		.
ClipTransColStart:
	; 変換初期化処理
	; バッファアドレス、ループ回数のセットとデータのプリロード処理
	nop								xtop		vi13				; -,
	nop								ilw.w		vi01,PACKDAT(vi13)	; -,バウンディングフラグ読み込み
	nop								lq.xyzw		vf01,FV_PRM(vi00)	; -,定数読み込み
	nop								lq.xyzw		vf02,FV_SCN(vi00)	; -,定数読みみ込
	nop								lq.xyzw		vf03,FV_OFT(vi00)	; -,定数読み込み
	nop								ibeq		vi01,vi00,FastTransColStart ;	バースト描画
	nop								ilw.x		vi08,PACKDAT(vi13)	; -,処理頂点数の読み込み
	nop								lq.yzw		vf04,GIFNORMAL(vi13); -,GIFタグ生成
	nop								iaddiu		vi01,vi00,0x4000	; -,GIFタグ生成
	nop								iadd		vi01,vi01,vi01		; -,GIFタグ生成
	nop								ior			vi01,vi01,vi08		; -,GIFタグ生成
	nop								isw.x		vi01,WORK_TOP(vi13)	; -,GIFタグ生成
	nop								sq.yzw		vf04,WORK_TOP(vi13)	; -,GIFタグ生成
	nop								iaddiu		vi09,vi13,DATA_OFT	; -,データ先読みアドレス設定
	nop								iaddiu		vi10,vi13,PACK_TOP	; -,データ書き戻しアドレス設定
	nop								lq.xyzw		vf16,BUF_VERT(vi09)	; -,第１頂点読み込み
	nop								lq.xyzw		vf17,BUF_NORM(vi09)	; -,第１法線（＆キック情報）読み込み
	nop								lq.xyzw		vf04,M_PRS0(vi13)	; -,透視変換マトリクスロード
	nop								lq.xyzw		vf05,M_PRS1(vi13)	; -,透視変換マトリクスロード
	itof0.xyzw	vf16,vf16			lq.xyzw		vf06,M_PRS2(vi13)	; -,透視変換マトリクスロード
	itof12.xyz	vf17,vf17			lq.xyzw		vf07,M_PRS3(vi13)	; -,透視変換マトリクスロード
	nop								lq.xyzw		vf08,M_LIT0(vi13)	; -,ローカルライトマトリクス読み込み
	nop								lq.xyzw		vf09,M_LIT1(vi13)	; -,ローカルライトマトリクス読み込み
	nop								lq.xyzw		vf10,M_LIT2(vi13)	; -,ローカルライトマトリクス読み込み
	nop								lq.xyzw		vf12,M_COL0(vi13)	; -,ローカルカラーマトリクス読み込み
	nop								lq.xyzw		vf13,M_COL1(vi13)	; -,ローカルカラーマトリクス読み込み
	nop								lq.xyzw		vf14,M_COL2(vi13)	; -,ローカルカラーマトリクス読み込み
	nop								lq.xyzw		vf15,M_COL3(vi13)	; -,ローカルカラーマトリクス読み込み
	nop								ilw.z		vi06,PACKDAT(vi13)	; -,固定フォグ値記憶
	muly.w		vf20,vf00,vf01		fcset		0					; アルファ設定,クリップチェック初期化
	nop								iaddiu		vi15,vi00,0			; -,全体クリップチェックフラグクリア
	nop								isubiu		vi14,vi00,0x4000	; (vi14 = 0xc000)
	nop								iaddiu		vi04,vi00,0x4000	; キックフラグ用マスク
	nop								iaddiu		vi04,vi04,0x4000	; キックフラグ用マスク(vi04 = 0x8000)
	nop								sq.xyz		vf17,SRC_NORM(vi09)	; ,(先)環境マップ用保存

	nop								isub		vi06,vi06,vi04		; カリング用デバッグコード

	; ディレイ処理の為の前処理
;	itof12.xyzw	vf24,vf24			nop										; (遅)光源計算,-
;	minix.xyzw	vf20,vf20,vf01		nop										; (遅)光源計算,-
	mulax.xyzw	ACC ,vf04,vf16		ilw.w		vi07,BUF_FLG(vi09)			; 透視変換,キックフラグ
	madday.xyzw	ACC ,vf05,vf16		lq.xyzw		vf18,BUF_UV0(vi09)			; 透視変換,ＵＶ読み込み
	maddaz.xyzw	ACC ,vf06,vf16		iaddiu		vi09,vi09,BUF_NEXT			; 透視変換,読み込みアドレス増加
	maddw.xyzw	vf19,vf07,vf00		lq.xyzw		vf16,BUF_VERT(vi09)			; 透視変換,(先)頂点読み込み
	mul.xyzw	vf24,vf24,vf20		iaddi		vi08,vi08,-1				; (遅)光源計算,カウンタのデクリメント
	mulax.xyz	ACC ,vf08,vf17		nop										; 光源計算,(遅)ＵＶ座標
	madday.xyz	ACC ,vf09,vf17		iand		vi05,vi07,vi04				; 光源計算,キックフラグ
	clipw.xyz	vf19,vf19			div			Q,vf00w,vf19w				; クリップ,透視変換
	maddz.xyz	vf20,vf10,vf17		sq.xyzw		vf19,SRC_XYZW-SRC_NEXT(vi09); 光源計算,クリップ用保存
	ftoi4.xyz	vf22,vf22			lq.xyzw		vf17,BUF_NORM(vi09)			; (遅)透視変換,(先)法線読み込み
	itof0.xyzw	vf16,vf16			nop										; (先)透視変換,(遅)クリップ用保存
	itof12.xyz	vf18,vf18			fcand		vi01,0x3ffff				; ＵＶ座標,クリップ
	maxx.xyzw	vf20,vf20,vf00		ibeq		vi01,vi00,l05				; 光源計算,クリップ
	ftoi0.xyzw	vf24,vf24			ior			vi05,vi05,vi06				; (遅)光源計算,フォグ処理
	nop								ibltz		vi07,l05					; ●
	nop								ior			vi05,vi05,vi04				; ●
	nop								ior			vi07,vi07,vi14				; ●
	nop								iaddiu		vi15,vi15,1					; ●
l05:itof12.xyz	vf17,vf17			isw.w		vi05,DST_XYZ(vi10)			; (先)光源計算,描画キック
	mulq.xyzw	vf22,vf19,Q			nop										; 透視変換,(遅)透視変換
	mulax.xyz	ACC ,vf12,vf20		sq.xyzw		vf18,SRC_UV0-SRC_NEXT(vi09)	; 光源計算,クリップ用保存
	madday.xyz	ACC ,vf13,vf20		nop										; 光源計算,(遅)光源計算
	maddaz.xyz	ACC ,vf14,vf20		isw.w		vi07,SRC_FLG-SRC_NEXT(vi09)	; 光源計算,クリップ用保存
	maddw.xyz	vf20,vf15,vf00		lq.xyzw		vf24,BUF_RGBA-BUF_NEXT(vi09); 光源計算,光源計算
	mulq.xyz	vf25,vf18,Q			iaddiu		vi10,vi10,DST_NEXT			; ＵＶ座標,書き込みアドレス増加
	mula.xyz	ACC ,vf22,vf02		ibgtz		vi08,_ClipTransColLoop		; 透視変換,ループジャンプ
	maddw.xyz	vf22,vf03,vf00		sq.xyz		vf17,SRC_NORM(vi09)			; 透視変換,環境マップ用保存

_ClipTransColLoop:
	; 頂点変換処理（途中で次の頂点の情報を読み込んでおく）
	itof12.xyzw	vf24,vf24			nop										; (遅)光源計算,-
	minix.xyzw	vf20,vf20,vf01		nop										; (遅)光源計算,-
	mulax.xyzw	ACC ,vf04,vf16		ilw.w		vi07,BUF_FLG(vi09)			; 透視変換,キックフラグ
	madday.xyzw	ACC ,vf05,vf16		lq.xyzw		vf18,BUF_UV0(vi09)			; 透視変換,ＵＶ読み込み
	maddaz.xyzw	ACC ,vf06,vf16		iaddiu		vi09,vi09,BUF_NEXT			; 透視変換,読み込みアドレス増加
	maddw.xyzw	vf19,vf07,vf00		lq.xyzw		vf16,BUF_VERT(vi09)			; 透視変換,(先)頂点読み込み
	mul.xyzw	vf24,vf24,vf20		iaddi		vi08,vi08,-1				; (遅)光源計算,カウンタのデクリメント
	mulax.xyz	ACC ,vf08,vf17		sq.xyz		vf25,DST_UV0-DST_NEXT(vi10)	; 光源計算,(遅)ＵＶ座標
	madday.xyz	ACC ,vf09,vf17		iand		vi05,vi07,vi04				; 光源計算,キックフラグ
	clipw.xyz	vf19,vf19			div			Q,vf00w,vf19w				; クリップ,透視変換
	maddz.xyz	vf20,vf10,vf17		sq.xyzw		vf19,SRC_XYZW-SRC_NEXT(vi09); 光源計算,クリップ用保存
	ftoi4.xyz	vf22,vf22			lq.xyzw		vf17,BUF_NORM(vi09)			; (遅)透視変換,(先)法線読み込み
	itof0.xyzw	vf16,vf16			sq.xyzw		vf24,SRC_COL-SRC_NEXT*2(vi09);(先)透視変換,(遅)クリップ用保存
	itof12.xyz	vf18,vf18			fcand		vi01,0x3ffff				; ＵＶ座標,クリップ
	maxx.xyzw	vf20,vf20,vf00		ibeq		vi01,vi00,l06				; 光源計算,クリップ
	ftoi0.xyzw	vf24,vf24			ior			vi05,vi05,vi06				; (遅)光源計算,フォグ処理
	nop								ibltz		vi07,l06					; ●
	nop								ior			vi05,vi05,vi04				; ●
	nop								ior			vi07,vi07,vi14				; ●
	nop								iaddiu		vi15,vi15,1					; ●
l06:itof12.xyz	vf17,vf17			isw.w		vi05,DST_XYZ(vi10)			; (先)光源計算,描画キック
	mulq.xyzw	vf22,vf19,Q			sq.xyz		vf22,DST_XYZ-DST_NEXT(vi10)	; 透視変換,(遅)透視変換
	mulax.xyz	ACC ,vf12,vf20		sq.xyzw		vf18,SRC_UV0-SRC_NEXT(vi09)	; 光源計算,クリップ用保存
	madday.xyz	ACC ,vf13,vf20		sq.xyzw		vf24,DST_COL-DST_NEXT(vi10)	; 光源計算,(遅)光源計算
	maddaz.xyz	ACC ,vf14,vf20		isw.w		vi07,SRC_FLG-SRC_NEXT(vi09)	; 光源計算,クリップ用保存
	maddw.xyz	vf20,vf15,vf00		lq.xyzw		vf24,BUF_RGBA-BUF_NEXT(vi09); 光源計算,光源計算
	mulq.xyz	vf25,vf18,Q			iaddiu		vi10,vi10,DST_NEXT			; ＵＶ座標,(先)書き込みアドレス増加
	mula.xyz	ACC ,vf22,vf02		ibgtz		vi08,_ClipTransColLoop		; 透視変換,ループジャンプ
	maddw.xyz	vf22,vf03,vf00		sq.xyz		vf17,SRC_NORM(vi09)			; 透視変換,環境マップ用保存

	; 後始末
	itof12.xyzw	vf24,vf24			nop										; (遅)光源計算,-
	minix.xyzw	vf20,vf20,vf01		nop										; (遅)光源計算,-
	nop								ilw.y		vi12,PACKDAT(vi13)	; -,処理フラグ取得
	nop								iaddiu		vi02,vi00,FLAG_CULL			; カリング
	mul.xyzw	vf24,vf24,vf20		iaddiu		vi01,vi13,TX0_OFT			; (遅)光源計算,テクスチャ設定
	ftoi4.xyz	vf22,vf22			xgkick		vi01						; (遅)透視変換,テクスチャ設定
	nop								sq.xyz		vf25,DST_UV0-DST_NEXT(vi10)	; (遅)光源計算,(遅)ＵＶ座標
	nop								iand		vi02,vi02,vi12				; カリング
	ftoi0.xyzw	vf24,vf24			sq.xyzw		vf24,SRC_COL-SRC_NEXT(vi09);-,(遅)クリップ用保存
	nop								sq.xyz		vf22,DST_XYZ-DST_NEXT(vi10)	; -,(遅)透視変換
	nop								sq.xyzw		vf24,DST_COL-DST_NEXT(vi10)	; -,(遅)光源計算
.ifdef CULL_ON
	nop								ibeq		vi02,vi00,2					; カリング（アドレス直指定）
	nop								nop										; カリング
	nop								bal			vi14,CullStart				; カリング
	nop								nop										; カリング
.endif

	; 終端ダミーパケットをキックし待機
	nop								iaddiu		vi01,vi13,WORK_TOP	; 
	nop								xgkick		vi01				; ＧＩＦへのキック

	nop								b			MultiTextureDraw	; 
	nop								nop								; 



; ================================================================
; 光源計算＋頂点カラー付きエンベロープ対応ルーチン
; ================================================================
;	upper		.					lower		.
ClipTransEnvelopeColStart:
	; 変換初期化処理
	; バッファアドレス、ループ回数のセットとデータのプリロード処理
	nop								xtop		vi13				; -,
	nop								ilw.w		vi01,PACKDAT(vi13)	; -,バウンディングフラグ読み込み
	nop								lq.xyzw		vf01,FV_PRM(vi00)	; -,定数読み込み
	nop								lq.xyzw		vf02,FV_SCN(vi00)	; -,定数読みみ込
	nop								lq.xyzw		vf03,FV_OFT(vi00)	; -,定数読み込み
	nop								ibeq		vi01,vi00,FastTransEnvelopeColStart ;	バースト描画
	nop								ilw.x		vi08,PACKDAT(vi13)	; -,処理頂点数の読み込み
	nop								lq.yzw		vf04,GIFNORMAL(vi13); -,GIFタグ生成
	nop								iaddiu		vi01,vi00,0x4000	; -,GIFタグ生成
	nop								iadd		vi01,vi01,vi01		; -,GIFタグ生成
	nop								ior			vi01,vi01,vi08		; -,GIFタグ生成
	nop								isw.x		vi01,WORK_TOP(vi13)	; -,GIFタグ生成
	nop								sq.yzw		vf04,WORK_TOP(vi13)	; -,GIFタグ生成
	nop								iaddiu		vi09,vi13,DATA_OFT	; -,データ先読みアドレス設定
	nop								iaddiu		vi10,vi13,PACK_TOP	; -,データ書き戻しアドレス設定
	nop								lq.xyzw		vf16,BUF_VERT(vi09)	; -,第１頂点読み込み
	nop								lq.xyzw		vf17,BUF_NORM(vi09)	; -,第１法線（＆キック情報）読み込み
	nop								lq.xyzw		vf28,M_SUP0(vi13)	; エンベロープ補正マトリクス読み込み
	nop								lq.xyzw		vf29,M_SUP1(vi13)	; エンベロープ補正マトリクス読み込み
	itof0.xyz	vf16,vf16			lq.xyzw		vf30,M_SUP2(vi13)	; エンベロープ補正マトリクス読み込み
	itof12.w	vf26,vf16			lq.xyzw		vf31,M_SUP3(vi13)	; エンベロープ補正マトリクス読み込み
	itof12.xyz	vf17,vf17			lq.xyzw		vf04,M_PRS0(vi13)	; -,透視変換マトリクスロード
	nop								lq.xyzw		vf05,M_PRS1(vi13)	; -,透視変換マトリクスロード
	mulax.xyz	ACC ,vf28,vf16		lq.xyzw		vf06,M_PRS2(vi13)	; trans_v,透視変換マトリクスロード
	madday.xyz	ACC ,vf29,vf16		lq.xyzw		vf07,M_PRS3(vi13)	; trans_v,透視変換マトリクスロード
	maddaz.xyz	ACC ,vf30,vf16		lq.xyzw		vf08,M_LIT0(vi13)	; trans_v,ローカルライトマトリクス読み込み
	maddw.xyz	vf26,vf31,vf00		lq.xyzw		vf09,M_LIT1(vi13)	; trans_v,ローカルライトマトリクス読み込み
	sub.w		vf27,vf00,vf26		lq.xyzw		vf10,M_LIT2(vi13)	; make v&n,ローカルライトマトリクス読み込み
	mulax.xyz	ACC ,vf28,vf17		lq.xyzw		vf12,M_COL0(vi13)	; trans_n,ローカルカラーマトリクス読み込み
	madday.xyz	ACC ,vf29,vf17		lq.xyzw		vf13,M_COL1(vi13)	; trans_n,ローカルカラーマトリクス読み込み
	maddz.xyz	vf27,vf30,vf17		lq.xyzw		vf14,M_COL2(vi13)	; trans_n,ローカルカラーマトリクス読み込み
	mulaw.xyz	ACC ,vf16,vf26		lq.xyzw		vf15,M_COL3(vi13)	; make v,ローカルカラーマトリクス読み込み
	maddw.xyz	vf16,vf26,vf27		ilw.z		vi06,PACKDAT(vi13)	; make v,固定フォグ値記憶
	mulaw.xyz	ACC ,vf17,vf26		isubiu		vi14,vi00,0x4000	; make n,vi14 = 0xc000
	maddw.xyz	vf17,vf27,vf27		fcset		0					; make n,クリップチェック初期化
	muly.w		vf20,vf00,vf01		iaddiu		vi15,vi00,0			; アルファ設定,全体クリップチェックフラグクリア
	nop								iaddiu		vi04,vi00,0x4000	; キックフラグ用マスク
	nop								iaddiu		vi04,vi04,0x4000	; キックフラグ用マスク(vi04 = 0x8000)

	nop								isub		vi06,vi06,vi04		; カリング用デバッグコード

	; ディレイ処理の為の前処理
	mulax.xyzw	ACC ,vf04,vf16		ilw.w		vi07,BUF_FLG(vi09)			; 透視変換,キックフラグ
	madday.xyzw	ACC ,vf05,vf16		lq.xyzw		vf18,BUF_UV0(vi09)			; 透視変換,ＵＶ読み込み
	maddaz.xyzw	ACC ,vf06,vf16		iaddiu		vi09,vi09,BUF_NEXT			; 透視変換,読み込みアドレス増加
	maddw.xyzw	vf19,vf07,vf00		lq.xyzw		vf16,BUF_VERT(vi09)			; 透視変換,(先)頂点読み込み
	minix.xyzw	vf24,vf20,vf01		iaddi		vi08,vi08,-1				; (遅)光源計算,カウンタのデクリメント
	mulax.xyz	ACC ,vf08,vf17		nop										; 光源計算,(遅)ＵＶ座標
	madday.xyz	ACC ,vf09,vf17		sq.xyz		vf17,SRC_NORM-SRC_NEXT(vi09); 光源計算,環境マップ用保存
	clipw.xyz	vf19,vf19			div			Q,vf00w,vf19w				; クリップ,透視変換
	maddz.xyz	vf20,vf10,vf17		sq.xyzw		vf19,SRC_XYZW-SRC_NEXT(vi09); 光源計算,クリップ用保存
	ftoi4.xyz	vf22,vf22			lq.xyzw		vf17,BUF_NORM(vi09)			; (遅)透視変換,(先)法線読み込み
	itof0.xyz	vf16,vf16			nop										; (先)透視変換,(遅)クリップ用保存
	itof12.w	vf26,vf16			iand		vi05,vi07,vi04				; (先)エンベロープ,キックフラグ
	itof12.xyz	vf18,vf18			fcand		vi01,0x3ffff				; ＵＶ座標,クリップ
	maxx.xyzw	vf20,vf20,vf00		ibeq		vi01,vi00,l07				; 光源計算,クリップ
	ftoi0.xyzw	vf24,vf24			ior			vi05,vi05,vi06				; (遅)光源計算,フォグ処理
	nop								ibltz		vi07,l07					; ●
	nop								ior			vi05,vi05,vi04				; ●
	nop								ior			vi07,vi07,vi14				; ●
	nop								iaddiu		vi15,vi15,1					; ●
l07:itof12.xyz	vf17,vf17			isw.w		vi05,DST_XYZ(vi10)			; (先)光源計算,描画キック
	mulq.xyzw	vf22,vf19,Q			nop										; 透視変換,(遅)透視変換
	mulax.xyz	ACC ,vf12,vf20		sq.xyzw		vf18,SRC_UV0-SRC_NEXT(vi09)	; 光源計算,クリップ用保存
	madday.xyz	ACC ,vf13,vf20		nop										; 光源計算,(遅)光源計算
	maddaz.xyz	ACC ,vf14,vf20		isw.w		vi07,SRC_FLG-SRC_NEXT(vi09)	; 光源計算,クリップ用保存
	maddw.xyz	vf20,vf15,vf00		ibgtz		vi08,_ClipTransEnvelopeColLoop	; 光源計算,ループジャンプ
	mulq.xyz	vf25,vf18,Q			iaddiu		vi10,vi10,DST_NEXT			; ＵＶ座標,書き込みアドレス増加

_ClipTransEnvelopeColLoop:
	; 頂点変換処理（途中で次の頂点の情報を読み込んでおく）
	mulax.xyz	ACC ,vf28,vf16		lq.xyzw		vf24,BUF_RGBA-BUF_NEXT(vi09); trans_v,(遅)光源計算
	madday.xyz	ACC ,vf29,vf16		nop										; trans_v,-
	maddaz.xyz	ACC ,vf30,vf16		nop										; trans_v,make v
	maddw.xyz	vf26,vf31,vf00		nop										; trans_v,-
	sub.w		vf27,vf00,vf26		nop										; make v&n,-
	itof12.xyzw	vf24,vf24			nop										; (遅)光源計算,-
	mulax.xyz	ACC ,vf28,vf17		nop										; trans_n,-
	madday.xyz	ACC ,vf29,vf17		nop										; trans_n,-
	maddz.xyz	vf27,vf30,vf17		nop										; trans_n,-
	mulaw.xyz	ACC ,vf16,vf26		nop										; make v,-
	maddw.xyz	vf16,vf26,vf27		nop										; make v,-
	mulaw.xyz	ACC ,vf17,vf26		nop										; make n,-
	maddw.xyz	vf17,vf27,vf27		nop										; make n,-
	mula.xyz	ACC ,vf22,vf02		nop										; 透視変換,
	maddw.xyz	vf22,vf03,vf00		nop										; 透視変換,

	minix.xyzw	vf20,vf20,vf01		nop										; (遅)光源計算,-
	mulax.xyzw	ACC ,vf04,vf16		ilw.w		vi07,BUF_FLG(vi09)			; 透視変換,キックフラグ
	madday.xyzw	ACC ,vf05,vf16		lq.xyzw		vf18,BUF_UV0(vi09)			; 透視変換,ＵＶ読み込み
	maddaz.xyzw	ACC ,vf06,vf16		iaddiu		vi09,vi09,BUF_NEXT			; 透視変換,読み込みアドレス増加
	maddw.xyzw	vf19,vf07,vf00		lq.xyzw		vf16,BUF_VERT(vi09)			; 透視変換,(先)頂点読み込み
	mul.xyzw	vf24,vf24,vf20		iaddi		vi08,vi08,-1				; (遅)光源計算,カウンタのデクリメント
	mulax.xyz	ACC ,vf08,vf17		sq.xyz		vf25,DST_UV0-DST_NEXT(vi10)	; 光源計算,(遅)ＵＶ座標
	madday.xyz	ACC ,vf09,vf17		sq.xyz		vf17,SRC_NORM-SRC_NEXT(vi09); 光源計算,環境マップ用保存
	clipw.xyz	vf19,vf19			div			Q,vf00w,vf19w				; クリップ,透視変換
	maddz.xyz	vf20,vf10,vf17		sq.xyzw		vf19,SRC_XYZW-SRC_NEXT(vi09); 光源計算,クリップ用保存
	ftoi4.xyz	vf22,vf22			lq.xyzw		vf17,BUF_NORM(vi09)			; (遅)透視変換,(先)法線読み込み
	itof0.xyz	vf16,vf16			sq.xyzw		vf24,SRC_COL-SRC_NEXT*2(vi09);(先)透視変換,(遅)クリップ用保存
	itof12.w	vf26,vf16			iand		vi05,vi07,vi04				; (先)エンベロープ,キックフラグ
	itof12.xyz	vf18,vf18			fcand		vi01,0x3ffff				; ＵＶ座標,クリップ
	maxx.xyzw	vf20,vf20,vf00		ibeq		vi01,vi00,l08				; 光源計算,クリップ
	ftoi0.xyzw	vf24,vf24			ior			vi05,vi05,vi06				; (遅)光源計算,フォグ処理
	nop								ibltz		vi07,l08					; ●
	nop								ior			vi05,vi05,vi04				; ●
	nop								ior			vi07,vi07,vi14				; ●
	nop								iaddiu		vi15,vi15,1					; ●
l08:itof12.xyz	vf17,vf17			isw.w		vi05,DST_XYZ(vi10)			; (先)光源計算,描画キック
	mulq.xyzw	vf22,vf19,Q			sq.xyz		vf22,DST_XYZ-DST_NEXT(vi10)	; 透視変換,(遅)透視変換
	mulax.xyz	ACC ,vf12,vf20		sq.xyzw		vf18,SRC_UV0-SRC_NEXT(vi09)	; 光源計算,クリップ用保存
	madday.xyz	ACC ,vf13,vf20		sq.xyzw		vf24,DST_COL-DST_NEXT(vi10)	; 光源計算,(遅)光源計算
	maddaz.xyz	ACC ,vf14,vf20		isw.w		vi07,SRC_FLG-SRC_NEXT(vi09)	; 光源計算,クリップ用保存
	maddw.xyz	vf20,vf15,vf00		ibgtz		vi08,_ClipTransEnvelopeColLoop	; 光源計算,ループジャンプ
	mulq.xyz	vf25,vf18,Q			iaddiu		vi10,vi10,DST_NEXT			; ＵＶ座標,書き込みアドレス増加

	; 後始末
	nop								lq.xyzw		vf24,BUF_RGBA-BUF_NEXT(vi09); trans_v,(遅)光源計算
	minix.xyzw	vf20,vf20,vf01		nop										; (遅)光源計算,-
	itof12.xyzw	vf24,vf24			nop										; (遅)光源計算,-
	mula.xyz	ACC ,vf22,vf02		nop										; 透視変換,
	maddw.xyz	vf22,vf03,vf00		nop										; 透視変換,
	nop								ilw.y		vi12,PACKDAT(vi13)	; -,処理フラグ取得
	nop								iaddiu		vi02,vi00,FLAG_CULL			; カリング
	mul.xyzw	vf24,vf24,vf20		iaddiu		vi01,vi13,TX0_OFT			; (遅)光源計算,テクスチャ設定
	ftoi4.xyz	vf22,vf22			xgkick		vi01						; (遅)透視変換,テクスチャ設定
	nop								sq.xyz		vf25,DST_UV0-DST_NEXT(vi10)	; (遅)光源計算,(遅)ＵＶ座標
	nop								iand		vi02,vi02,vi12				; カリング
	ftoi0.xyzw	vf24,vf24			sq.xyzw		vf24,SRC_COL-SRC_NEXT(vi09);-,(遅)クリップ用保存
	nop								sq.xyz		vf22,DST_XYZ-DST_NEXT(vi10)	; -,(遅)透視変換
	nop								sq.xyzw		vf24,DST_COL-DST_NEXT(vi10)	; -,(遅)光源計算
.ifdef CULL_ON
	nop								ibeq		vi02,vi00,2					; カリング（アドレス直指定）
	nop								nop										; カリング
	nop								bal			vi14,CullStart				; カリング
	nop								nop										; カリング
.endif

	; 終端ダミーパケットをキックし待機
	nop								iaddiu		vi01,vi13,WORK_TOP	; 
	nop								xgkick		vi01				; ＧＩＦへのキック
	nop								b			MultiTextureDraw	; 
	nop								nop								; 


.if 0
; ================================================================
; 光源計算付き透視変換ルーチン
; ================================================================
;	vf28:１つ前の頂点
;	vf29:１つ前のベクトル
;	vf30:ベクトル計算用テンポラリ
;	vf31:外積計算結果
; vi05
; vi06
;	upper		.					lower		.
CullClipTransStart:
	; 変換初期化処理
	; バッファアドレス、ループ回数のセットとデータのプリロード処理
	nop								xtop		vi13				; -,
	nop								lq.xyzw		vf01,FV_PRM(vi00)	; -,定数読み込み
	nop								lq.xyzw		vf02,FV_SCN(vi00)	; -,定数読みみ込
	nop								lq.xyzw		vf03,FV_OFT(vi00)	; -,定数読み込み
	nop								ilw.x		vi08,PACKDAT(vi13)	; -,処理頂点数の読み込み
	nop								lq.yzw		vf04,GIFNORMAL(vi13); -,GIFタグ生成
	nop								iaddiu		vi01,vi00,0x4000	; -,GIFタグ生成
	nop								iadd		vi01,vi01,vi01		; -,GIFタグ生成
	nop								ior			vi01,vi01,vi08		; -,GIFタグ生成
	nop								isw.x		vi01,WORK_TOP(vi13)	; -,GIFタグ生成
	nop								sq.yzw		vf04,WORK_TOP(vi13)	; -,GIFタグ生成
	nop								iaddiu		vi09,vi13,DATA_OFT	; -,データ先読みアドレス設定
	nop								iaddiu		vi10,vi13,PACK_TOP	; -,データ書き戻しアドレス設定
	nop								lq.xyzw		vf16,BUF_VERT(vi09)	; -,第１頂点読み込み
	nop								lq.xyzw		vf17,BUF_NORM(vi09)	; -,第１法線（＆キック情報）読み込み
	nop								lq.xyzw		vf04,M_PRS0(vi13)	; -,透視変換マトリクスロード
	nop								lq.xyzw		vf05,M_PRS1(vi13)	; -,透視変換マトリクスロード
	itof0.xyzw	vf16,vf16			lq.xyzw		vf06,M_PRS2(vi13)	; -,透視変換マトリクスロード
	itof12.xyz	vf17,vf17			lq.xyzw		vf07,M_PRS3(vi13)	; -,透視変換マトリクスロード
	nop								lq.xyzw		vf08,M_LIT0(vi13)	; -,ローカルライトマトリクス読み込み
	nop								lq.xyzw		vf09,M_LIT1(vi13)	; -,ローカルライトマトリクス読み込み
	nop								lq.xyzw		vf10,M_LIT2(vi13)	; -,ローカルライトマトリクス読み込み
	nop								lq.xyzw		vf12,M_COL0(vi13)	; -,ローカルカラーマトリクス読み込み
	nop								lq.xyzw		vf13,M_COL1(vi13)	; -,ローカルカラーマトリクス読み込み
	nop								lq.xyzw		vf14,M_COL2(vi13)	; -,ローカルカラーマトリクス読み込み
	nop								lq.xyzw		vf15,M_COL3(vi13)	; -,ローカルカラーマトリクス読み込み
	nop								ilw.z		vi06,PACKDAT(vi13)	; -,固定フォグ値記憶
	muly.w		vf20,vf00,vf01		fcset		0					; アルファ設定,クリップチェック初期化
	nop								iaddiu		vi15,vi00,0			; -,全体クリップチェックフラグクリア
	nop								isubiu		vi14,vi00,0x4000	; (vi14 = 0xc000)
	nop								iaddiu		vi04,vi00,0x4000	; キックフラグ用マスク
	nop								iaddiu		vi04,vi04,0x4000	; キックフラグ用マスク(vi04 = 0x8000)
	nop								sq.xyz		vf17,SRC_NORM(vi09)	; ,(先)環境マップ用保存
	nop								isub		vi06,vi06,vi04		; カリング用デバッグコード


	; ディレイ処理の為の前処理
	mulax.xyzw	ACC ,vf04,vf16		ilw.w		vi07,BUF_FLG(vi09)			; 透視変換,キックフラグ
	madday.xyzw	ACC ,vf05,vf16		lq.xyzw		vf18,BUF_UV0(vi09)			; 透視変換,ＵＶ読み込み
	maddaz.xyzw	ACC ,vf06,vf16		iaddiu		vi09,vi09,BUF_NEXT			; 透視変換,読み込みアドレス増加
	maddw.xyzw	vf19,vf07,vf00		lq.xyzw		vf16,BUF_VERT(vi09)			; 透視変換,(先)頂点読み込み
	minix.xyzw	vf24,vf20,vf01		iaddi		vi08,vi08,-1				; (遅)光源計算,カウンタのデクリメント
	mulax.xyz	ACC ,vf08,vf17		nop										; 光源計算,(遅)ＵＶ座標
	madday.xyz	ACC ,vf09,vf17		iand		vi05,vi07,vi04				; 光源計算,キックフラグ
	clipw.xyz	vf19,vf19			div			Q,vf00w,vf19w				; クリップ,透視変換
	maddz.xyz	vf20,vf10,vf17		sq.xyzw		vf19,SRC_XYZW-SRC_NEXT(vi09); 光源計算,クリップ用保存
	mulaw.xyz	ACC ,vf19,vf28		iaddiu		vi03,vi00,0x0030			; カリング,カリング
	msubw.xyz	vf30,vf28,vf19		move.xyzw	vf28,vf19					; カリング,カリング
	ftoi4.xyz	vf22,vf22			lq.xyzw		vf17,BUF_NORM(vi09)			; (遅)透視変換,(先)法線読み込み
	itof0.xyzw	vf16,vf16			nop										; (先)透視変換,(遅)クリップ用保存
	itof12.xyz	vf18,vf18			fcand		vi01,0x3ffff				; ＵＶ座標,クリップ
	opmula.xyz	ACC ,vf29,vf30		iaddiu		vi02,vi00,0x0020			; カリング,カリング
	opmsub.xyz	vf31,vf30,vf29		move.xyzw	vf29,vf30					; カリング,カリング
	maxx.xyzw	vf20,vf20,vf00		ibeq		vi01,vi00,l0c				; 光源計算,クリップ
	ftoi0.xyzw	vf24,vf24			ior			vi05,vi05,vi06				; (遅)光源計算,フォグ処理
	nop								ibltz		vi07,l0a					; ●
	nop								ior			vi05,vi05,vi04				; ●
	nop								ior			vi07,vi07,vi14				; ●
	nop								b			l0a							; ●
	nop								iaddiu		vi15,vi15,1					; ●
l0c:nop								iand		vi03,vi03,vi07				; -,カリング
	nop								fmand		vi02,vi02					; -,カリング
	nop								ibne		vi02,vi03,l0a				; -,カリング
	nop								nop										; -,カリング
	nop								ior			vi05,vi05,vi04				; -,カリング
l0a:itof12.xyz	vf17,vf17			isw.w		vi05,DST_XYZ(vi10)			; (先)光源計算,描画キック
	mulq.xyzw	vf22,vf19,Q			nop										; 透視変換,(遅)透視変換
	mulax.xyz	ACC ,vf12,vf20		sq.xyzw		vf18,SRC_UV0-SRC_NEXT(vi09)	; 光源計算,クリップ用保存
	madday.xyz	ACC ,vf13,vf20		nop										; 光源計算,(遅)光源計算
	maddaz.xyz	ACC ,vf14,vf20		isw.w		vi07,SRC_FLG-SRC_NEXT(vi09)	; 光源計算,クリップ用保存
	maddw.xyz	vf20,vf15,vf00		sq.xyz		vf17,SRC_NORM(vi09)			; 光源計算,(先)環境マップ用保存
	mulq.xyz	vf25,vf18,Q			iaddiu		vi10,vi10,DST_NEXT			; ＵＶ座標,書き込みアドレス増加
	mula.xyz	ACC ,vf22,vf02		ibgtz		vi08,_CullClipTransLoop			; 透視変換,ループジャンプ
	maddw.xyz	vf22,vf03,vf00		nop										; 透視変換,

_CullClipTransLoop:
	; 頂点変換処理（途中で次の頂点の情報を読み込んでおく）
	mulax.xyzw	ACC ,vf04,vf16		ilw.w		vi07,BUF_FLG(vi09)			; 透視変換,キックフラグ
	madday.xyzw	ACC ,vf05,vf16		lq.xyzw		vf18,BUF_UV0(vi09)			; 透視変換,ＵＶ読み込み
	maddaz.xyzw	ACC ,vf06,vf16		iaddiu		vi09,vi09,BUF_NEXT			; 透視変換,読み込みアドレス増加
	maddw.xyzw	vf19,vf07,vf00		lq.xyzw		vf16,BUF_VERT(vi09)			; 透視変換,(先)頂点読み込み
	minix.xyzw	vf24,vf20,vf01		iaddi		vi08,vi08,-1				; (遅)光源計算,カウンタのデクリメント
	mulax.xyz	ACC ,vf08,vf17		sq.xyz		vf25,DST_UV0-DST_NEXT(vi10)	; 光源計算,(遅)ＵＶ座標
	madday.xyz	ACC ,vf09,vf17		iand		vi05,vi07,vi04				; 光源計算,キックフラグ
	clipw.xyz	vf19,vf19			div			Q,vf00w,vf19w				; クリップ,透視変換
	maddz.xyz	vf20,vf10,vf17		sq.xyzw		vf19,SRC_XYZW-SRC_NEXT(vi09); 光源計算,クリップ用保存
	mulaw.xyz	ACC ,vf19,vf28		iaddiu		vi03,vi00,0x0030			; カリング,カリング
	msubw.xyz	vf30,vf28,vf19		move.xyzw	vf28,vf19					; カリング,カリング
	ftoi4.xyz	vf22,vf22			lq.xyzw		vf17,BUF_NORM(vi09)			; (遅)透視変換,(先)法線読み込み
	itof0.xyzw	vf16,vf16			sq.xyzw		vf24,SRC_COL-SRC_NEXT*2(vi09);(先)透視変換,(遅)クリップ用保存
	itof12.xyz	vf18,vf18			fcand		vi01,0x3ffff				; ＵＶ座標,クリップ
	opmula.xyz	ACC ,vf29,vf30		iaddiu		vi02,vi00,0x0020			; カリング,カリング
	opmsub.xyz	vf31,vf30,vf29		move.xyzw	vf29,vf30					; カリング,カリング
	maxx.xyzw	vf20,vf20,vf00		ibeq		vi01,vi00,l0d				; 光源計算,クリップ
	ftoi0.xyzw	vf24,vf24			ior			vi05,vi05,vi06				; (遅)光源計算,フォグ処理
	nop								ibltz		vi05,l0b					; ●
	nop								ior			vi05,vi05,vi04				; ●
	nop								ior			vi07,vi07,vi14				; ●
	nop								b			l0b							; ●
	nop								iaddiu		vi15,vi15,1					; ●
l0d:nop								iand		vi03,vi03,vi07				; -,カリング
	nop								fmand		vi02,vi02					; -,カリング
	nop								ibne		vi02,vi03,l0b				; -,カリング
	nop								nop										; -,カリング
	nop								ior			vi05,vi05,vi04				; -,カリング
l0b:itof12.xyz	vf17,vf17			isw.w		vi05,DST_XYZ(vi10)			; (先)光源計算,描画キック
	mulq.xyzw	vf22,vf19,Q			sq.xyz		vf22,DST_XYZ-DST_NEXT(vi10)	; 透視変換,(遅)透視変換
	mulax.xyz	ACC ,vf12,vf20		sq.xyzw		vf18,SRC_UV0-SRC_NEXT(vi09)	; 光源計算,クリップ用保存
	madday.xyz	ACC ,vf13,vf20		sq.xyzw		vf24,DST_COL-DST_NEXT(vi10)	; 光源計算,(遅)光源計算
	maddaz.xyz	ACC ,vf14,vf20		isw.w		vi07,SRC_FLG-SRC_NEXT(vi09)	; 光源計算,クリップ用保存
	maddw.xyz	vf20,vf15,vf00		sq.xyz		vf17,SRC_NORM(vi09)			; 光源計算,環境マップ用保存
	mulq.xyz	vf25,vf18,Q			iaddiu		vi10,vi10,DST_NEXT			; ＵＶ座標,(先)書き込みアドレス増加
	mula.xyz	ACC ,vf22,vf02		ibgtz		vi08,_CullClipTransLoop			; 透視変換,ループジャンプ
	maddw.xyz	vf22,vf03,vf00		nop										; 透視変換,

	; 後始末
	minix.xyzw	vf24,vf20,vf01		iaddiu		vi01,vi13,TX0_OFT			; (遅)光源計算,テクスチャ設定
	ftoi4.xyz	vf22,vf22			xgkick		vi01						; (遅)透視変換,テクスチャ設定
	nop								sq.xyz		vf25,DST_UV0-DST_NEXT(vi10)	; (遅)光源計算,(遅)ＵＶ座標
	ftoi0.xyzw	vf24,vf24			sq.xyzw		vf24,SRC_COL-SRC_NEXT(vi09);-,(遅)クリップ用保存
	nop								sq.xyz		vf22,DST_XYZ-DST_NEXT(vi10)	; -,(遅)透視変換
	nop								sq.xyzw		vf24,DST_COL-DST_NEXT(vi10)	; -,(遅)光源計算

	; 終端ダミーパケットをキックし待機
	nop								ilw.y		vi12,PACKDAT(vi13)	; -,処理フラグ取得
	nop								iaddiu		vi01,vi13,WORK_TOP	; 
	nop								xgkick		vi01				; ＧＩＦへのキック
	nop								b			MultiTextureDraw	; 
	nop								nop								; 
.endif



; ================================================================
; カリングチェックルーチン
; ================================================================
; 計算済みバッファの内容を読み出してカリングチェックを行う
;	vf16:頂点読み込み用
;	vf28:１つ前の頂点
;	vf29:１つ前のベクトル
;	vf30:ベクトル計算用テンポラリ
;	vf31:外積計算結果
;	vi14がリターンアドレスなので注意（クランプフラグを保持するため）
;	upper		.					lower		.
CullStart:
	; 変換初期化処理
	; バッファアドレス、ループ回数のセットとデータのプリロード処理
;	nop								xtop		vi13						; -,
	nop								ilw.x		vi08,PACKDAT(vi13)			; -,処理頂点数の読み込み
	nop								iaddiu		vi09,vi13,DATA_OFT			; -,データ先読みアドレス設定
	nop								iaddiu		vi10,vi13,PACK_TOP			; -,データ書き戻しアドレス設定
	nop								lq.xyzw		vf16,SRC_XYZW(vi09)			; -,第１頂点読み込み
	nop								ilw.w		vi07,SRC_FLG(vi09)			; ,キックフラグ
	nop								ilw.w		vi05,DST_XYZ(vi10)			; ,キックフラグ
	mulaw.xyz	ACC ,vf16,vf28		iaddiu		vi02,vi00,0x0020			; カリング,フラグチェック
	msubw.xyz	vf30,vf28,vf16		move.xyzw	vf28,vf16					; カリング,カリング
	nop								iaddiu		vi03,vi00,0x0030			; -,フラグチェック
	nop								iaddiu		vi04,vi00,0x4000			; 
	nop								iaddiu		vi04,vi04,0x4000			; 
_CullLoop:
	opmula.xyz	ACC ,vf29,vf30		lq.xyzw		vf16,SRC_XYZW+SRC_NEXT(vi09); カリング,(先)頂点読み込み
	opmsub.xyz	vf31,vf30,vf29		move.xyzw	vf29,vf30					; カリング,カリング
	nop								ibltz		vi05,l1b					; キックフラグによる分岐
	nop								iaddi		vi08,vi08,-1				; -,カウンタ減算
	nop								iand		vi06,vi03,vi07				; ●,カリング
	nop								fmand		vi01,vi02					; ●,カリング
	nop								ibne		vi01,vi06,l1b				; ●,カリング
	nop								ior			vi05,vi05,vi04				; ●,カリング
	nop								isw.w		vi05,DST_XYZ(vi10)			; ●,描画キック
l1b:mulaw.xyz	ACC ,vf16,vf28		iaddiu		vi09,vi09,SRC_NEXT			; (先)カリング,(先)書き込みアドレス増加
	msubw.xyz	vf30,vf28,vf16		move.xyzw	vf28,vf16					; (先)カリング,カリング
	nop								iaddiu		vi10,vi10,DST_NEXT			; ,(先)書き込みアドレス増加
	nop								ilw.w		vi05,DST_XYZ(vi10)			; ,(先)キックフラグ
	nop								ibgtz		vi08,_CullLoop				; ,ループジャンプ
	nop								ilw.w		vi07,SRC_FLG(vi09)			; ,(先)キックフラグ

	nop								jr			vi14						; 
	nop								nop										; 




; ================================================================
; ２枚目以降テクスチャ描画処理
; ================================================================
MultiTextureDraw:

; ================================================================
; ２枚目テクスチャ描画処理
; ================================================================
tex1f_start:
	nop								lq.xyzw		vf31,GIFREGS(vi13)			; GIFTAGレジスタリスト読み込み
	nop								iaddiu		vi01,vi00,FLAG_TEX1			; -,テクスチャ１使用フラグ
	nop								iand		vi01,vi12,vi01				; -,チェック
	nop								ilw.x		vi08,PACKDAT(vi13)			; -,頂点数取得
	nop								ibeq		vi01,vi00,tex1f_end			; -,スキップ
	nop								iaddiu		vi09,vi13,DATA_OFT			; -,データ読み取りアドレス設定
	nop								iaddiu		vi10,vi13,PACK_TOP			; -,データ書き込みアドレス設定

	; テクスチャ座標をＳＴＱに変換する
	; 先行読み込み
	nop								lq.xyz		vf17,BUF_UV1(vi09)			; -,(先)ＵＶ値の読み込み
	itof12.xyz	vf18,vf17			iaddiu		vi09,vi09,SRC_NEXT			; (先)ＵＶ,(先)読み込みアドレス加算
	; 最初の１回
	nop								lq.z		vf20,DST_UV0(vi10)			; -,Ｑ値の読み込み
	nop								lq.xyz		vf17,BUF_UV1(vi09)			; -,(先)ＵＶ値の読み込み
	nop								sq.xyz		vf18,SRC_UV1-SRC_NEXT(vi09)	; -,クリップ用保存
;	nop								nop										; -,(遅)ＳＴＱ格納
	nop								iaddi		vi08,vi08,-1				; -,カウンタ減算
	mulz.xyz	vf19,vf18,vf20		iaddiu		vi09,vi09,SRC_NEXT			; ＳＴＱ計算,(先)読み込みアドレス加算
	itof12.xyz	vf18,vf17			ibgtz		vi08,t1f_l00				; (先)ＵＶ,ループ
	nop								nop										; -,(遅)書き込みアドレス加算
	; ２回目以降
t1f_l00:
	nop								lq.z		vf20,DST_UV0+DST_NEXT(vi10)	; -,Ｑ値の読み込み
	nop								lq.xyz		vf17,BUF_UV1(vi09)			; -,(先)ＵＶ値の読み込み
	nop								sq.xyz		vf18,SRC_UV1-SRC_NEXT(vi09)	; -,クリップ用保存
	nop								sq.xyz		vf19,DST_UV1(vi10)			; -,(遅)ＳＴＱ格納
	nop								iaddi		vi08,vi08,-1				; -,カウンタ減算
	mulz.xyz	vf19,vf18,vf20		iaddiu		vi09,vi09,SRC_NEXT			; ＳＴＱ計算,(先)読み込みアドレス加算
	itof12.xyz	vf18,vf17			ibgtz		vi08,t1f_l00				; (先)ＵＶ,ループ
	nop								iaddiu		vi10,vi10,DST_NEXT			; -,(遅)書き込みアドレス加算
	; 後始末
	nop								sq.xyz		vf19,DST_UV1(vi10)			; -,(遅)ＳＴＱ格納

	; テクスチャ設定
	nop								iaddiu		vi01,vi13,TX1_OFT			; -,テクスチャ設定
	nop								xgkick		vi01						; -,テクスチャ設定（＆XGKICKウェイト）
	; GIFTAGは既に書き込まれている為いきなり転送
	nop								iaddiu		vi01,vi13,WORK_TOP			; 
	nop								sq.z		vf31,0x00(vi01)				; 
	nop								xgkick		vi01						; 
	nop								nop										; 
tex1f_end:


; ================================================================
; ３枚目テクスチャ描画処理
; ================================================================
tex2f_start:
	nop								mr32.xyzw	vf31,vf31					; GIFTAGレジスタリストシフト
	nop								iaddiu		vi01,vi00,FLAG_UV2			; -,テクスチャ１使用フラグ
	nop								iand		vi01,vi12,vi01				; -,チェック
	nop								ilw.x		vi08,PACKDAT(vi13)			; -,頂点数取得
	nop								ibeq		vi01,vi00,tex2f_end			; -,スキップ
	nop								iaddiu		vi09,vi13,DATA_OFT			; -,データ読み取りアドレス設定
	nop								iaddiu		vi10,vi13,PACK_TOP			; -,データ書き込みアドレス設定

	; テクスチャ座標をＳＴＱに変換する
	; 先行読み込み
	nop								lq.xyz		vf17,BUF_UV2(vi09)			; -,(先)ＵＶ値の読み込み
	itof12.xyz	vf18,vf17			iaddiu		vi09,vi09,SRC_NEXT			; (先)ＵＶ,(先)読み込みアドレス加算
	; 最初の１回
	nop								lq.z		vf20,DST_UV0(vi10)			; -,Ｑ値の読み込み
	nop								lq.xyz		vf17,BUF_UV2(vi09)			; -,(先)ＵＶ値の読み込み
	nop								sq.xyz		vf18,SRC_UV2-SRC_NEXT(vi09)	; -,クリップ用保存
;	nop								nop										; -,(遅)ＳＴＱ格納
	nop								iaddi		vi08,vi08,-1				; -,カウンタ減算
	mulz.xyz	vf19,vf18,vf20		iaddiu		vi09,vi09,SRC_NEXT			; ＳＴＱ計算,(先)読み込みアドレス加算
	itof12.xyz	vf18,vf17			ibgtz		vi08,t2f_l00				; (先)ＵＶ,ループ
	nop								nop										; -,(遅)書き込みアドレス加算
	; ２回目以降
t2f_l00:
	nop								lq.z		vf20,DST_UV0+DST_NEXT(vi10)	; -,Ｑ値の読み込み
	nop								lq.xyz		vf17,BUF_UV2(vi09)			; -,(先)ＵＶ値の読み込み
	nop								sq.xyz		vf18,SRC_UV2-SRC_NEXT(vi09)	; -,クリップ用保存
	nop								sq.xyz		vf19,DST_UV2(vi10)			; -,(遅)ＳＴＱ格納
	nop								iaddi		vi08,vi08,-1				; -,カウンタ減算
	mulz.xyz	vf19,vf18,vf20		iaddiu		vi09,vi09,SRC_NEXT			; ＳＴＱ計算,(先)読み込みアドレス加算
	itof12.xyz	vf18,vf17			ibgtz		vi08,t2f_l00				; (先)ＵＶ,ループ
	nop								iaddiu		vi10,vi10,DST_NEXT			; -,(遅)書き込みアドレス加算
	; 後始末
	nop								sq.xyz		vf19,DST_UV1(vi10)			; -,(遅)ＳＴＱ格納

	; テクスチャ設定
	nop								iaddiu		vi01,vi13,TX2_OFT			; -,テクスチャ設定
	nop								xgkick		vi01						; -,テクスチャ設定（＆XGKICKウェイト）
	; GIFTAGは既に書き込まれている為いきなり転送
	nop								iaddiu		vi01,vi13,WORK_TOP			; 
	nop								sq.z		vf31,0x00(vi01)				; 
	nop								xgkick		vi01						; 
	nop								nop										; 
tex2f_end:


; ================================================================
; シャドウ（アニメシェード）マッピング描画処理
; ================================================================
ShadowMappingStart:
;	nop								mr32.xyzw	vf31,vf31					; GIFTAGレジスタリストシフト
	nop								iaddiu		vi01,vi00,FLAG_SMAP			; -,テクスチャ１使用フラグ
	nop								iand		vi01,vi12,vi01				; -,チェック
	nop								ilw.x		vi08,PACKDAT(vi13)			; -,頂点数取得
	nop								ibeq		vi01,vi00,ShadowMappingEnd	; -,スキップ
	nop								iaddiu		vi09,vi13,DATA_OFT			; -,データ読み取りアドレス設定
	nop								iaddiu		vi10,vi13,PACK_TOP			; -,データ書き込みアドレス設定

	nop								lq.xyzw		vf04,TX2_OFT+6(vi13)		; テクスチャ座標スケール取得
	nop								lq.xyzw		vf05,TX2_OFT+7(vi13)		; テクスチャ座標オフセット取得
	nop								lq.xzw		vf12,M_LIT0+0x00(vi13)		; ライトマトリクス取得
	mulx.y		vf12,vf00,vf00		lq.xzw		vf13,M_LIT0+0x01(vi13)		; ライトマトリクス取得
	mulx.y		vf13,vf00,vf00		lq.xzw		vf14,M_LIT0+0x02(vi13)		; ライトマトリクス取得
	mulx.y		vf14,vf00,vf00		lq.xyzw		vf16,SRC_NORM(vi09)			; 法線読み込み
	mula.x		ACC ,vf12,vf12		mr32.z		vf18,vf00					; Ｑに１を設定しておく
	madda.x		ACC ,vf13,vf13		nop										; 
	madd.x		vf15,vf14,vf14		nop										; 
	nop								rsqrt		Q,vf00w,vf15x				; 
	mulq.x		vf12,vf12,Q			waitq									; 
	mulq.x		vf13,vf13,Q			b			em_l01						; 以降は環境マッピングルーチンと同じ
	mulq.x		vf14,vf14,Q			nop										; 
ShadowMappingEnd:

; ================================================================
; 環境マッピング描画処理
; ================================================================
EnvironmentMappingStart:
;	nop								mr32.xyzw	vf31,vf31					; GIFTAGレジスタリストシフト
	nop								iaddiu		vi01,vi00,FLAG_EMAP			; -,テクスチャ１使用フラグ
	nop								iand		vi01,vi12,vi01				; -,チェック
	nop								ilw.x		vi08,PACKDAT(vi13)			; -,頂点数取得
	nop								ibeq		vi01,vi00,EnvironmentMappingEnd	; -,スキップ
	nop								iaddiu		vi09,vi13,DATA_OFT			; -,データ読み取りアドレス設定
	nop								iaddiu		vi10,vi13,PACK_TOP			; -,データ書き込みアドレス設定

	nop								lq.xyzw		vf04,TX2_OFT+6(vi13)		; テクスチャ座標スケール取得
	nop								lq.xyzw		vf05,TX2_OFT+7(vi13)		; テクスチャ座標オフセット取得
	nop								lq.xyzw		vf12,M_OPT0+0x00(vi13)		; 逆カメラマトリクス取得
	nop								lq.xyzw		vf13,M_OPT0+0x01(vi13)		; 逆カメラマトリクス取得
	nop								lq.xyzw		vf14,M_OPT0+0x02(vi13)		; 逆カメラマトリクス取得
	nop								lq.xyzw		vf16,SRC_NORM(vi09)			; 法線読み込み
	nop								mr32.z		vf18,vf00					; Ｑに１を設定しておく
em_l01:
	; テクスチャ座標をＳＴＱに変換する
	; 最初の１回
;	nop								nop										; (遅)ＵＶ算出,(遅)(遅)ＳＴＱ格納
;	nop								nop										; (遅)ＵＶ算出,(遅)(遅)クリップ用保存
	mulax.xyz	ACC ,vf12,vf16		iaddi		vi08,vi08,-1				; 法線変換,カウンタ減算
	madday.xyz	ACC ,vf13,vf16		iaddiu		vi09,vi09,SRC_NEXT			; 法線変換,読み込みアドレス加算
	maddz.xyz	vf17,vf14,vf16		lq.xyzw		vf16,SRC_NORM(vi09)			; 法線変換,(先)法線読み込み
	nop								lq.z		vf20,DST_UV0(vi10)			; (遅)Ｑ補正,(先)Ｑ値の読み込み
;	nop								nop										; -,ループ
;	nop								nop										; -,(遅)書き込みアドレス加算
	; ２回目
	mula.xyz	ACC ,vf17,vf04		nop										; (遅)ＵＶ算出,(遅)(遅)ＳＴＱ格納
	maddw.xy	vf18,vf05,vf00		nop										; (遅)ＵＶ算出,(遅)(遅)クリップ用保存
	mulax.xyz	ACC ,vf12,vf16		iaddi		vi08,vi08,-1				; 法線変換,カウンタ減算
	madday.xyz	ACC ,vf13,vf16		iaddiu		vi09,vi09,SRC_NEXT			; 法線変換,読み込みアドレス加算
	maddz.xyz	vf17,vf14,vf16		lq.xyzw		vf16,SRC_NORM(vi09)			; 法線変換,(先)法線読み込み
	mulz.xyz	vf19,vf18,vf20		lq.z		vf20,DST_UV0+DST_NEXT(vi10)	; (遅)Ｑ補正,(先)Ｑ値の読み込み
;	nop								nop										; -,ループ
;	nop								nop										; -,(遅)書き込みアドレス加算
	; ３回目以降
em_l00:
	mula.xyz	ACC ,vf17,vf04		sq.xyz		vf18,SRC_UV2-SRC_NEXT*2(vi09)	; (遅)ＵＶ算出,(遅)(遅)ＳＴＱ格納
	maddw.xy	vf18,vf05,vf00		sq.xyz		vf19,DST_UV2(vi10)			; (遅)ＵＶ算出,(遅)(遅)クリップ用保存
	mulax.xyz	ACC ,vf12,vf16		iaddi		vi08,vi08,-1				; 法線変換,カウンタ減算
	madday.xyz	ACC ,vf13,vf16		iaddiu		vi09,vi09,SRC_NEXT			; 法線変換,読み込みアドレス加算
	maddz.xyz	vf17,vf14,vf16		lq.xyzw		vf16,SRC_NORM(vi09)			; 法線変換,(先)法線読み込み
	mulz.xyz	vf19,vf18,vf20		lq.z		vf20,DST_UV0+DST_NEXT*2(vi10)	; (遅)Ｑ補正,(先)Ｑ値の読み込み
	nop								ibgtz		vi08,em_l00					; -,ループ
	nop								iaddiu		vi10,vi10,DST_NEXT			; -,(遅)書き込みアドレス加算
	; 最後の書き込み
	mula.xyz	ACC ,vf17,vf04		sq.xyz		vf18,SRC_UV2-SRC_NEXT*2(vi09)	; (遅)ＵＶ算出,(遅)(遅)ＳＴＱ格納
	maddw.xy	vf18,vf05,vf00		sq.xyz		vf19,DST_UV2(vi10)			; (遅)ＵＶ算出,(遅)(遅)クリップ用保存
;	nop								nop										; 法線変換,カウンタ減算
;	nop								nop										; 法線変換,読み込みアドレス加算
;	nop								nop										; 法線変換,(先)法線読み込み
	mulz.xyz	vf19,vf18,vf20		nop										; (遅)Ｑ補正,(先)Ｑ値の読み込み
;	nop								nop										; -,ループ
	nop								iaddiu		vi10,vi10,DST_NEXT			; -,(遅)書き込みアドレス加算

	nop								sq.xyz		vf18,SRC_UV2-SRC_NEXT*1(vi09)	; (遅)ＵＶ算出,(遅)(遅)ＳＴＱ格納
	nop								sq.xyz		vf19,DST_UV2(vi10)			; (遅)ＵＶ算出,(遅)(遅)クリップ用保存
;	nop								nop										; 法線変換,カウンタ減算
;	nop								nop										; 法線変換,読み込みアドレス加算
;	nop								nop										; 法線変換,(先)法線読み込み
;	nop								nop										; (遅)Ｑ補正,(先)Ｑ値の読み込み
;	nop								nop										; -,ループ
;	nop								nop										; -,(遅)書き込みアドレス加算

	; テクスチャ設定
	nop								iaddiu		vi01,vi13,TX2_OFT	; -,テクスチャ設定
	nop								xgkick		vi01				; -,テクスチャ設定（＆XGKICKウェイト）
	; GIFTAGは既に書き込まれている為いきなり転送
	nop								iaddiu		vi01,vi13,WORK_TOP	; 
	nop								sq.z		vf31,0x00(vi01)		; 
	nop								xgkick		vi01				; 
	nop								nop								; 
EnvironmentMappingEnd:

