; マルチテクスチャ用ピクセルシェーダー（グロスマップ付き環境マップ）
; 
;
; 2002.04.21  K.Takabe

ps.1.1

tex t0							; ベーステクスチャ
tex t1							; グロスマップテクスチャ
tex t2							; 環境マップテクスチャ

mul_x2	r0.a,   t0,     v0			; アルファはテクスチャ０のみを参照
mul	    r1.rgb, t2,     t1.a		; 環境マップテクスチャをグロスマップアルファと乗算
mul		r0.rgb, t0,     v0	 		; 頂点カラーでベーステクスチャをモジュレート
mad_x2  r0.rgb, r1,     v0,  r0 	; グロスマップと乗算済みの環境マップテクスチャをモジュレート加算

; X-BOXオリジナル
;mul_x2 r0.a,   t0.a,   v0.a			; アルファはテクスチャ０のみを参照
;mul    t2.rgb, t2.rgb, t1.a			; 環境マップテクスチャをグロスマップアルファと乗算
;mul    r0.rgb, t0.rgb, v0.rgb			; 頂点カラーでベーステクスチャをモジュレート
;mad_x2 r0.rgb, t2.rgb, v0.rgb, r0.rgb	; グロスマップと乗算済みの環境マップテクスチャをモジュレート加算

