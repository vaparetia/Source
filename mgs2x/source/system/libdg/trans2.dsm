; ================================================================
; DVPASM設定
; ================================================================


.global Vu1DrawObject2
.global Vu1DrawObject2_Func
.global	Vu1DrawPrim2_Func

; ================================================================
; プログラムアドレステーブル
; ================================================================
Vu1DrawObject2_Func:
;	.word	( FastTransStart / 8 )				; 通常モデル描画
	.word	( ClipTransStart / 8 )				; クリップ処理付き描画
	.word	( ClipTransStart / 8 )				; クリップ処理付き描画
;	.word	( FastTransEnvelopeStart / 8 )		; エンベロープ処理付き描画
	.word	( ClipTransEnvelopeStart / 8 )		; エンベロープ・クリップ処理付き描画
	.word	( ClipTransEnvelopeStart / 8 )		; エンベロープ・クリップ処理付き描画

;	.word	( FastPreshadeTransStart / 8 )		; プリシェードモデル描画
	.word	( ClipPreshadeTransStart / 8 )		; プリシェード・クリップ処理付き描画
	.word	( ClipPreshadeTransStart / 8 )		; プリシェード・クリップ処理付き描画
;	.word	( CullFastPreshadeTransStart / 8 )	; プリシェードモデル描画（カリングＯＮ）
	.word	( CullClipPreshadeTransStart / 8 )	; プリシェード・クリップ処理付き描画（カリングＯＮ）
	.word	( CullClipPreshadeTransStart / 8 )	; プリシェード・クリップ処理付き描画（カリングＯＮ）

	.word	( EndVu1Program / 8 )
	.word	( DummyFunc / 8 )					; テクスチャパケットのキックのみ（描画しない）
	.word	0,0

Vu1DrawPrim2_Func:
	.word	( ClipPrimPolyTransStart / 8 )		; 
	.word	( CullClipPrimPolyTransStart / 8 )		; 
	.word	( ClipPrimLineTransStart / 8 )		; 
	.word	( ClipPrimSprtTransStart / 8 )		; 
	.word	( ClipPrimRSprtTransStart / 8 )		; 

; ================================================================
; データ記述開始
; ================================================================
.data
.DmaPackVif 1			; タグ中のＶＩＦコード有効

; ================================
; プログラム転送ＤＭＡタグ定義
; ================================
Vu1DrawObject2:		; マイクロプログラム読み込み用タグ記憶ポインタ
	DMAref *, _trans	; DMArefによるデータ転送を行う


; ================================================================
; 各種定数定義
; ================================================================

; ＜ワークアドレスオフセット＞
VAR00		= 0		; プログラム用変数領域
VAR00X		= 0		; クリップ用ワーク切り替えフラグ
VAR00Y		= 0		; 
VAR00Z		= 0		; 
VAR00W		= 0		; 
VAR01		= 1		; プログラム用変数領域
; 固定パラメータ類
FV_FOG		= 2		; フォグパラメータ
FV_PRM		= 3		; 各種定数
FV_SCN		= 4		; プリミティブ座標へのスケーリングパラメータ
FV_OFT		= 5		; プリミティブ座標へのオフセット値
FV_PRM2		= 6		; 各種定数２
FV_ASPC		= 7		; アスペクト比

; オブジェクト処理パラメータ類（ダブルバッファ先頭からのオフセット）
M_PRS0		= 0x00	; 透視変換マトリクス０
M_PRS1		= 0x01	; 透視変換マトリクス１
M_PRS2		= 0x02	; 透視変換マトリクス２
M_PRS3		= 0x03	; 透視変換マトリクス３
M_LIT0		= 0x04	; ローカルライトマトリクスＸ = lit0_x,lit1_x,lit2_x,supecular_x
M_LIT1		= 0x05	; ローカルライトマトリクスＹ = lit0_y,lit1_y,lit2_y,supecular_y
M_LIT2		= 0x06	; ローカルライトマトリクスＺ = lit0_z,lit1_z,lit2_z,supecular_z
M_LIT3		= 0x07	; 未使用
M_COL0		= 0x08	; ローカルカラー０ = lit0_r,lit0_g,lit0_b
M_COL1		= 0x09	; ローカルカラー１ = lit1_r,lit1_g,lit1_b
M_COL2		= 0x0a	; ローカルカラー２ = lit2_r,lit2_g,lit2_b
M_COL3		= 0x0b	; アンビエントカラー = amb_r amb_g amb_b
M_SUP0		= 0x0c	; エンベロープ補償マトリクス
M_SUP1		= 0x0d	; エンベロープ補償マトリクス
M_SUP2		= 0x0e	; エンベロープ補償マトリクス
M_SUP3		= 0x0f	; エンベロープ補償マトリクス
M_OPT0		= 0x10	; オプションマトリクス
M_OPT1		= 0x11	; オプションマトリクス
M_OPT2		= 0x12	; オプションマトリクス
M_OPT3		= 0x13	; オプションマトリクス
PACKDAT		= 0x14	; ローカル定数（x:頂点数、y:処理フラグ、z:固定フォグ値、w:リザーブ）
GIFNORMAL	= 0x15	; 通常描画用ＧＩＦタグ（トライアングルストリップ型）
GIFCLIP		= 0x16	; クリップ描画用ＧＩＦタグ（トライアングルファン型）
GIFREGS		= 0x17	; マルチテクスチャ用ＧＩＦレジスタリスト
					; ...
TX0_OFT		= 0xe8	; テクスチャ設定パケット格納アドレスオフセット
TX1_OFT		= 0xf0	; テクスチャ設定パケット格納アドレスオフセット
TX2_OFT		= 0xf8	; テクスチャ設定パケット格納アドレスオフセット
DATA_OFT	= 0x100	; 頂点データ先頭アドレスオフセット

; プログラム使用ワーク
WORK_TOP	= 0x18	; パケット転送ＧＩＦタグ設置エリアアドレスオフセット
PACK_TOP	= 0x19	; パケット生成エリア先頭アドレスオフセット
CWORK1		= 0x19+5* 6+1	; クリップ処理用ワーク先頭アドレスオフセット
CWORK2		= 0x19+5*15+2	; クリップ処理用ワーク先頭アドレスオフセット
WORK_END	= 0xd7	; ワークの終端


; ＜プログラム使用定数＞
; 処理フラグ
FLAG_TEX0	= 0x0008	; テクスチャ０使用（必須なので特に必要ない）
FLAG_TEX1	= 0x0010	; テクスチャ１使用
FLAG_TEX2	= 0x0020	; テクスチャ２使用
FLAG_UV0	= 0x0040	; 通常ＵＶ０使用（必須なので特に必要ない）
FLAG_UV1	= 0x0080	; 通常ＵＶ１使用
; 拡張計算フラグ（下のフラグは共に排他でなければならない）
FLAG_UV2	= 0x0100	; 通常ＵＶ２使用
FLAG_EMAP	= 0x0200	; 環境マッピング（ＵＶ２へ格納）
FLAG_SMAP	= 0x0400	; 環境マッピング影（ＵＶ２へ格納）
FLAG_BMAP	= 0x0800	; バンプマッピング（ＵＶ１をずらしたものをＵＶ２へ格納）


; ＜データ構造定義＞
; パケット構成バッファ使用定数
DST_NEXT	= 3		; 次の頂点データへのオフセット
DST_UV0		= 0		; ＳＴＱデータへのオフセット
DST_COL		= 1		; 頂点カラーデータへのオフセット
DST_XYZ		= 2		; 頂点データへのオフセット

; 透視変換処理後のデータ構造
SRC_NEXT	= 3		; 次の頂点データへのオフセット
SRC_FLG		= 2		; 座標変換処理終了後のキックフラグ格納オフセット（ｗ）
SRC_XYZW	= 0		; 計算済み同時座標へのオフセット（実数）
SRC_NORM	= 1		; 法線データへのオフセット（実数）
SRC_UV0		= 2		; ＵＶ０データへのオフセット（実数）
SRC_COL		= 1		; 算出済み頂点カラーへのオフセット（実数）

; データ読み込み直後のデータ構造
BUF_NEXT	= 3		; 次の頂点データへのオフセット
BUF_FLG		= 1		; 読み込み直後のキックフラグ格納オフセット（ｗ）
BUF_VERT	= 0		; 頂点データへのオフセット(1.15.0)
BUF_NORM	= 1		; 法線データへのオフセット(1.3.12)
BUF_UV0		= 2		; ＵＶ０データへのオフセット(1.3.12)

SPRT_XYZ	= 0		; 
SPRT_COL	= 1		; 
SPRT_UV0	= 2		; 
SPRT_WH		= 4		; 
SPRT_UV1	= 5		; 
SPRT_NEXT	= 6		; 

RSPRT_XYZ	= 0		; 
RSPRT_COL	= 1		; 
RSPRT_UV0	= 2		; 
RSPRT_WH	= 3		; 
RSPRT_UV1	= 4		; 
RSPRT_NEXT	= 12	; 



; ================================================================
; 補足事項
; ================================================================
; マルチパステクスチャを実現する際にパケットとしてＳＴＱ０、ＳＴＱ１
; ＳＴＱ２、ＲＧＢＡ、ＸＹＺＦと言う順番で予めならべておき、ＧＩＦタグ
; 内のレジスタリストを切り替えることで任意のＵＶ値を使用するようにした。


; メモリ使用構成（ＶＵ１側から見るときには下位４ビットを無視すること）
; 0x0000~0x00ff	プログラムワーク
; 0x0100~0x03ff オブジェクトパラメータ設定（未使用）
; 0x0400~0x21ff ダブルバッファ０
;  +0x0000_0x0fff パラメータ＆パケット生成用バッファ
;  +0x1000_0x1cff 頂点読み込み用バッファ
; 0x2200~0x3fff ダブルバッファ１
;  +0x0000_0x0fff パラメータ＆パケット生成用バッファ
;  +0x1000_0x1cff 頂点読み込み用バッファ
; 0x4000		最終アドレス
; 

; データフォーマット
; +14.xyzw 転送用ＧＩＦタグ
; +15.xyzw 第１ＳＴＱ０
; +16.xyzw 第１ＲＧＢＡ
; +17.xyzw 第１ＸＹＺＦ
; +18.xyzw 第２ＳＴＱ０
; +19.xyzw 第２ＲＧＢＡ
; .
; .
; .
;
; +d8.xyzw GIFtag（第１テクスチャパラメータ設定ＧＩＦタグ）
; +d9.xyzw CLAMP_1
; +da.xyzw TEX2_1
; +db.xyzw TEX0_1
; +dc.xyzw ALPHA
;
; +e0.xyzw GIFtag（第２テクスチャパラメータ設定ＧＩＦタグ）
; +e1.xyzw CLAMP_1
; +e2.xyzw TEX2_1
; +e3.xyzw TEX0_1
; +e4.xyzw ALPHA
;
; +e8.xyzw GIFtag（第３テクスチャパラメータ設定ＧＩＦタグ）
; +e9.xyzw CLAMP_1
; +ea.xyzw TEX2_1
; +eb.xyzw TEX0_1
; +ec.xyzw ALPHA
;
; +100.xyzw 第１ＵＶデータ
; +101.xyzw 第１法線データ
; +102.xyzw 第１頂点データ
; +103.xyzw 第２ＵＶデータ
; +104.xyzw 第２法線データ
; 
; 
; 
; 


; ================================
; 転送ＤＭＡデータ部
; ================================
.DmaData _trans			; DMArefで転送するデータの宣言

; ================================
; ＶＩＦ設定
; ================================
FLUSHE						; 
BASE		0x40			; ダブルバッファのベースアドレス
OFFSET		0x1e0			; ダブルバッファのオフセット
STMOD		0				; 加算書き込みＯＦＦ
STMASK		0xffff10		; １サイクルめのＺにROWの値を書き込む（ＵＶデータ用設定）（未使用）
STROW		0,0,4096,0		; Ｚメンバに4096（小数点以下１２ビットの固定小数点で1.0を表す）（未使用）

.if 0
; ================================
; 定数の転送
; ================================
Unpack 4, 4, V4_32, VAR00, *
	.float	0,0,0,0
	.int	0x362e9c14,0,0,0
	.int	0x3f7ffff5,0xbeaaa61c,0x3e4c40a6,0xbe0e6c63
	.int	0x3dc577df,0xbd6501c4,0x3cb31652,0xbb84d7e7
	.int	0x3f490fdb,0x3f490fdb,0x3f490fdb,0x3f490fdb
	.float	1.570796326795, 1.570796326795, 1.570796326795, 1.570796326795
.EndUnpack
.endif

; ================================
; マイクロプログラム転送VIFcode
; ================================
MPG 0,*
.vu

; ================================
; マイクロプログラム記述
; ================================
;.include "t2_fast.vu1"
;.include "t4_fast.vu1"		; カリング実験用
.include "t5_fast.vu1"		; ＋透視変換マトリクスの統一バージョン

;.include "t2_clip.vu1"
;.include "t4_clip.vu1"		; カリング実験用
.include "t5_clip.vu1"		; ＋透視変換マトリクスの統一バージョン

;.include "t1_shdw.vu1"

.include "t2_prim.vu1"


DummyFunc:
	nop		xtop		vi13				; -,
	nop		iaddiu		vi01,vi13,TX0_OFT	; ,テクスチャ設定
	nop		xgkick		vi01				; ,テクスチャ設定
	nop[e]	nop
	nop		nop
	nop		nop

EndVu1Program:

; ================================
; マイクロプログラム転送の終了
; ================================
.EndMPG
; ================================
; DMAref転送データの終了
; ================================
.EndDmaData	






