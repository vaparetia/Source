ps.1.1

;tex t0							; ベーステクスチャ
;tex t1							; グロスマップテクスチャ
tex t2							; 環境マップテクスチャ

;mul_x2 r0.a,   v0.a,   t0.a			; アルファはテクスチャ０のみを参照
;mul_x2 t0.rgb, t0.rgb, v0.rgb		; １枚目乗算
;mul_x2 t2.rgb, t2.rgb, v0.rgb		; ３枚目乗算
;lrp    r0.rgb, t2.a, t0.rgb, t2.rgb	; シャドウマップの乗算

mul_x2 r0.a,   v0.a,   t2.a			; アルファはテクスチャ０のみを参照
mul_x2 r0.rgb, v0.rgb, t2.rgb		; 

