;
;	t2_shdw.vu1
;	新影レンダリング用描画ＶＵ１プログラム（フォグ対応）
;
;	2000/02/16 K.Takabe
;	$Id: t5_shdw.vu1,v 1.1.1.3 2002/11/19 11:42:30 Yoshizawa1 Exp $
;



; ================================================================
; ＵＶ計算部レジスタ割り当て
; ================================================================
;	vf00:fix
;	vf01:定数読み込みベクトル
;	vf02:プリミティブ座標変換スケール
;	vf03:プリミティブ座標変換オフセット
;	vf04:テクスチャ投影マトリクス（モデルローカル座標に変換済み）
;	vf05:テクスチャ投影マトリクス（モデルローカル座標に変換済み）
;	vf06:テクスチャ投影マトリクス（モデルローカル座標に変換済み）
;	vf07:テクスチャ投影マトリクス（モデルローカル座標に変換済み）
;	vf08:
;	vf09:
;	vf10:
;	vf11:
;	vf12:描画色
;	vf13:X:1.0f Y:1.0f Z:1.0f W:減衰最大距離
;	vf14:光源ベクトル（モデルローカル座標に変換済み）
;	vf15:光源内積計算用テンポラリ
;	vf16:頂点読み込み
;	vf17:法線読み込み
;	vf18:ＵＶ０読み込み
;	vf19:変換後頂点
;	vf20:変換後法線
;	vf21:
;	vf22:書き込み頂点
;	vf23:内積値計算用(x)＆減衰値計算用(w)
;	vf24:計算後ＵＶ値
;	vf25:
;	vf26:計算用テンポラリ
;	vf27:計算用テンポラリ
;	vf28:エンベロープ計算用マトリクス
;	vf29:エンベロープ計算用マトリクス
;	vf30:エンベロープ計算用マトリクス
;	vf31:エンベロープ計算用マトリクス

;	vi00:０
;	vi01:条件判断又はテンポラリ
;	vi02:
;	vi06:
;	vi07:キックフラグ読み込み用
;	vi08:頂点数
;	vi09:読み込みデータアドレス
;	vi10:書き込みデータアドレス
;	vi11:エンベロープマトリクス読み取りアドレス
;	vi12:処理フラグ記憶用
;	vi13:バッファ先頭アドレス
;	vi15:リンクレジスタ＆クリップ処理チェックフラグ



; --------------------------------------
; 影テクスチャＵＶ値計算
; --------------------------------------
;	vf04~07:光源ビューポートマトリクス
;	vi03にクリップ頂点存在フラグ
CalcShadowUV:
	nop								fcset		0						; クリップフラグクリア
	nop								iaddiu		vi03,vi00,0				; 
	nop								ilw.x		vi08,PACKDAT(vi13)		; -,処理頂点数の読み込み
	nop								iaddiu		vi09,vi13,DATA_OFT		; データ読み出しアドレス設定
	nop								lq.xyzw		vf12,M_COL0(vi13)		; 描画用ＲＧＢＡ値読み込み
	nop								lq.w		vf13,M_COL1(vi13)		; 減衰最大距離読み込み(w)
	addw.xyz	vf13,vf00,vf00		lq.xyzw		vf14,M_COL2(vi13)		; 光源ベクトル取得
	nop								lq.xyzw		vf16,BUF_VERT(vi09)		; 
	nop								lq.xyzw		vf17,BUF_NORM(vi09)		; 
	nop								lq.xyzw		vf04,M_LIT0(vi13)		; 
	nop								div			Q,vf00w,vf13w			; -,減衰計算
	nop								lq.xyzw		vf05,M_LIT1(vi13)		; ベースカラー
	itof0.xyz	vf16,vf16			lq.xyzw		vf06,M_LIT2(vi13)		; 
	itof12.xyz	vf20,vf17			lq.xyzw		vf07,M_LIT3(vi13)		; 
	mulx.xyzw	vf02,vf00,vf00		loi			0.5						; 定数読み込み
	nop								nop									; 
	nop								nop									; 
	mul.xyz		vf15,vf14,vf20		iaddiu		vi04,vi00,0x4000		; 内積計算,描画マスク用定数設定
	addi.xy		vf02,vf02,I			iadd		vi04,vi04,vi04			; x:0.5 y:0.5 設定,
	mulq.xyzw	vf12,vf12,Q			iaddiu		vi04,vi04,0x6000		; 減衰計算,テクスチャ座標によるクリッピングＯＮ

	mulax.xyzw	ACC ,vf04,vf16		sq.xyz		vf16,BUF_VERT(vi09)		; 透視変換,
	mulw.xyzw	vf22,vf22,vf23		nop									; (遅)減衰処理
	madday.xyzw	ACC ,vf05,vf16		iaddiu		vi09,vi09,BUF_NEXT		; 透視変換,次ループ準備
	maddaz.xyzw	ACC ,vf06,vf16		mtir		vi07,vf17w				; 透視変換,-
	maddw.xyzw	vf19,vf07,vf00		lq.xyz		vf16,BUF_VERT(vi09)		; 透視変換,次の頂点読み出し
	mulax.x		ACC ,vf13,vf15		lq.xyzw		vf17,BUF_NORM(vi09)		; 内積計算,次の法線読み出し
	madday.x	ACC ,vf13,vf15		iaddi		vi08,vi08,-1			; 内積計算,
	maddz.x		vf23,vf13,vf15		nop									; 内積計算,(遅)カラー書き出し
	clipw.xyz	vf19,vf19			nop									; クリップチェック,(遅)ＵＶ書き出し
	sub.w		vf23,vf13,vf19		nop									; 減衰計算,
	itof12.xyz	vf20,vf17			nop									; 次ループ準備,
	maxx.xyz	vf23,vf23,vf00		mr32.z		vf24,vf19				; xには光源方向ベクトルとの内積値,ＱにＷを格納
	itof0.xyz	vf16,vf16			fcand		vi01,0x010410			; 次ループ準備,投影範囲チェック（ニアのみ）
	maxx.w		vf23,vf23,vf13		ibeq		vi01,vi00,_cs_label_0	; 減衰計算,クリップ
	mul.xyz		vf15,vf14,vf20		nop									; 内積計算,値の書き戻し
	; ポリゴンの頂点がニアクリップに引っかかった場合
	nop								ibltz		vi07,_cs_label_0		; 非描画頂点かどうかをチェック
	nop								nop									; 
	nop								ior			vi07,vi07,vi04			; ●描画スキップ
	nop								iaddiu		vi03,vi03,1				; クリップ頂点存在フラグＯＮ
_cs_label_0:
	mulx.xyzw	vf22,vf12,vf23		isw.w		vi07,BUF_UV0-BUF_NEXT(vi09)	; カラー計算,フラグの保存（ＵＶの方に）
	mula.xy		ACC ,vf19,vf02		ibgtz		vi08,CalcShadowLoop			; ＵＶ値設定,
	maddw.xy	vf24,vf02,vf19		nop										; ＵＶ値設定,

CalcShadowLoop:
	mulax.xyzw	ACC ,vf04,vf16		sq.xyz		vf16,BUF_VERT(vi09)		; 透視変換,
	mulw.xyzw	vf22,vf22,vf23		nop									; (遅)減衰処理
	madday.xyzw	ACC ,vf05,vf16		iaddiu		vi09,vi09,BUF_NEXT		; 透視変換,次ループ準備
	maddaz.xyzw	ACC ,vf06,vf16		mtir		vi07,vf17w				; 透視変換,-
	maddw.xyzw	vf19,vf07,vf00		lq.xyz		vf16,BUF_VERT(vi09)		; 透視変換,次の頂点読み出し
	mulax.x		ACC ,vf13,vf15		lq.xyzw		vf17,BUF_NORM(vi09)		; 内積計算,次の法線読み出し
	madday.x	ACC ,vf13,vf15		iaddi		vi08,vi08,-1			; 内積計算,
	maddz.x		vf23,vf13,vf15		sq.xyzw		vf22,BUF_NORM-BUF_NEXT*2(vi09); 内積計算,(遅)カラー書き出し
	clipw.xyz	vf19,vf19			sq.xyz		vf24,BUF_UV0-BUF_NEXT*2(vi09); クリップチェック,(遅)ＵＶ書き出し
	sub.w		vf23,vf13,vf19		nop									; 減衰計算,
	itof12.xyz	vf20,vf17			nop									; 次ループ準備,
	maxx.xyz	vf23,vf23,vf00		mr32.z		vf24,vf19				; xには光源方向ベクトルとの内積値,ＱにＷを格納
	itof0.xyz	vf16,vf16			fcand		vi01,0x010410			; 次ループ準備,投影範囲チェック（ニアのみ）
	maxx.w		vf23,vf23,vf13		ibeq		vi01,vi00,_cs_label_1	; 減衰計算,クリップ
	mul.xyz		vf15,vf14,vf20		nop									; 内積計算,-
	; ポリゴンの頂点がニアクリップに引っかかった場合
	nop								ibltz		vi07,_cs_label_1		; 非描画頂点かどうかをチェック
	nop								nop									; 
	nop								ior			vi07,vi07,vi04			; ●描画スキップ
	nop								iaddiu		vi03,vi03,1				; クリップ頂点存在フラグＯＮ
_cs_label_1:
	mulx.xyzw	vf22,vf12,vf23		isw.w		vi07,BUF_UV0-BUF_NEXT(vi09)	; カラー計算,フラグの保存（ＵＶの方に）
	mula.xy		ACC ,vf19,vf02		ibgtz		vi08,CalcShadowLoop			; ＵＶ値設定,
	maddw.xy	vf24,vf02,vf19		nop										; ＵＶ値設定,

;後始末
	mulw.xyzw	vf22,vf22,vf23		nop								; 
	nop								sq.xyzw		vf22,BUF_NORM-BUF_NEXT(vi09); -,(遅)カラー書き出し
	nop								sq.xyz		vf24,BUF_UV0-BUF_NEXT(vi09)	; -,(遅)ＵＶ書き出し

	nop								jr			vi15					; リターン
	nop								nop									; 


; --------------------------------------
; 影テクスチャＵＶ値計算（エンベロープ対応）
; --------------------------------------
;	vf04~07:光源ビューポートマトリクス
;	vi03にクリップ頂点存在フラグ
CalcEnvelopeShadowUV:
	nop								fcset		0						; クリップフラグクリア
	nop								lq.xyzw		vf28,M_SUP0(vi13)		; 
	nop								lq.xyzw		vf29,M_SUP1(vi13)		; 
	nop								lq.xyzw		vf30,M_SUP2(vi13)		; 
	nop								lq.xyzw		vf31,M_SUP3(vi13)		; 
	nop								iaddiu		vi03,vi00,0				; 
	nop								ilw.x		vi08,PACKDAT(vi13)		; -,処理頂点数の読み込み
	nop								iaddiu		vi09,vi13,DATA_OFT		; データ読み出しアドレス設定
	nop								lq.xyzw		vf12,M_COL0(vi13)		; 描画用ＲＧＢＡ値読み込み
	nop								lq.w		vf13,M_COL1(vi13)		; 減衰最大距離読み込み(w)
	addw.xyz	vf13,vf00,vf00		lq.xyzw		vf14,M_COL2(vi13)		; 光源ベクトル取得
	nop								lq.xyzw		vf16,BUF_VERT(vi09)		; 
	nop								lq.xyzw		vf17,BUF_NORM(vi09)		; 
	nop								lq.xyzw		vf04,M_LIT0(vi13)		; 
	nop								div			Q,vf00w,vf13w			; -,減衰計算
	nop								lq.xyzw		vf05,M_LIT1(vi13)		; ベースカラー
	itof0.xyz	vf16,vf16			lq.xyzw		vf06,M_LIT2(vi13)		; 
	itof12.xyz	vf17,vf17			lq.xyzw		vf07,M_LIT3(vi13)		; 
	mulx.xyzw	vf02,vf00,vf00		loi			0.5						; 定数読み込み
	itof12.w	vf26,vf16			iaddiu		vi04,vi00,0x4000		; 描画マスク用定数設定
	mulax.xyz	ACC ,vf28,vf16		nop									; trans_v
	madday.xyz	ACC ,vf29,vf16		nop									; trans_v,-
	maddaz.xyz	ACC ,vf30,vf16		nop									; trans_v,make v
	maddw.xyz	vf26,vf31,vf00		nop									; trans_v,-
	sub.w		vf27,vf00,vf26		nop									; make v&n,-
	mulax.xyz	ACC ,vf28,vf17		nop									; trans_n,-
	madday.xyz	ACC ,vf29,vf17		nop									; trans_n,-
	maddz.xyz	vf27,vf30,vf17		nop									; trans_n,-
	mulaw.xyz	ACC ,vf16,vf26		nop									; make v,-
	maddw.xyz	vf16,vf26,vf27		nop									; make v,-
	mulaw.xyz	ACC ,vf17,vf26		nop									; make n,-
	maddw.xyz	vf17,vf27,vf27		nop									; make n,-
	addi.xy		vf02,vf02,I			iadd		vi04,vi04,vi04			; x:0.5 y:0.5 設定,
	mulq.xyzw	vf12,vf12,Q			iaddiu		vi04,vi04,0x6000		; 減衰計算,テクスチャ座標によるクリッピングＯＮ

	mulax.xyzw	ACC ,vf04,vf16		sq.xyz		vf16,BUF_VERT(vi09)		; 透視変換,
	mul.xyz		vf20,vf14,vf17		nop									; 内積計算
	mulw.xyzw	vf22,vf22,vf23		nop									; (遅)減衰処理
	madday.xyzw	ACC ,vf05,vf16		iaddiu		vi09,vi09,BUF_NEXT		; 透視変換,次ループ準備
	maddaz.xyzw	ACC ,vf06,vf16		mtir		vi07,vf17w				; 透視変換,-
	maddw.xyzw	vf19,vf07,vf00		lq.xyzw		vf16,BUF_VERT(vi09)		; 透視変換,次の頂点読み出し
	mulax.x		ACC ,vf13,vf20		lq.xyzw		vf17,BUF_NORM(vi09)		; 内積計算,次の法線読み出し
	madday.x	ACC ,vf13,vf20		iaddi		vi08,vi08,-1			; 内積計算,
	maddz.x		vf23,vf13,vf20		nop									; 内積計算,(遅)カラー書き出し
	clipw.xyz	vf19,vf19			nop									; クリップチェック,(遅)ＵＶ書き出し
	sub.w		vf23,vf13,vf19		nop									; 減衰計算,
	itof0.xyz	vf16,vf16			nop									; 次ループ準備,
	maxx.xyz	vf23,vf23,vf00		mr32.z		vf24,vf19				; xには光源方向ベクトルとの内積値,ＱにＷを格納
	itof12.xyz	vf17,vf17			fcand		vi01,0x010410			; 次ループ準備,投影範囲チェック（ニアのみ）
	maxx.w		vf23,vf23,vf13		ibeq		vi01,vi00,_cs_label_2	; 減衰計算,クリップ
	itof12.w	vf26,vf16			nop									; 次ループ準備,値の書き戻し
	; ポリゴンの頂点がニアクリップに引っかかった場合
	nop								ibltz		vi07,_cs_label_2		; 非描画頂点かどうかをチェック
	nop								nop									; 
	nop								ior			vi07,vi07,vi04			; ●描画スキップ
	nop								iaddiu		vi03,vi03,1				; クリップ頂点存在フラグＯＮ
_cs_label_2:
	mulax.xyz	ACC ,vf28,vf16		nop									; trans_v
	madday.xyz	ACC ,vf29,vf16		nop									; trans_v,-
	maddaz.xyz	ACC ,vf30,vf16		nop									; trans_v,make v
	maddw.xyz	vf26,vf31,vf00		nop									; trans_v,-
	sub.w		vf27,vf00,vf26		nop									; make v&n,-
	mulax.xyz	ACC ,vf28,vf17		nop									; trans_n,-
	madday.xyz	ACC ,vf29,vf17		nop									; trans_n,-
	maddz.xyz	vf27,vf30,vf17		nop									; trans_n,-
	mulaw.xyz	ACC ,vf16,vf26		nop									; make v,-
	maddw.xyz	vf16,vf26,vf27		nop									; make v,-
	mulaw.xyz	ACC ,vf17,vf26		nop									; make n,-
	maddw.xyz	vf17,vf27,vf27		nop									; make n,-
	mulx.xyzw	vf22,vf12,vf23		isw.w		vi07,BUF_UV0-BUF_NEXT(vi09)	; カラー計算,フラグの保存（ＵＶの方に）
	mula.xy		ACC ,vf19,vf02		ibgtz		vi08,CalcEnvelopeShadowLoop	; ＵＶ値設定,
	maddw.xy	vf24,vf02,vf19		nop										; ＵＶ値設定,

CalcEnvelopeShadowLoop:
	mul.xyz		vf20,vf14,vf17		nop									; 内積計算,-
	mulax.xyzw	ACC ,vf04,vf16		sq.xyz		vf16,BUF_VERT(vi09)		; 透視変換,
	mulw.xyzw	vf22,vf22,vf23		nop									; (遅)減衰処理
	madday.xyzw	ACC ,vf05,vf16		iaddiu		vi09,vi09,BUF_NEXT		; 透視変換,次ループ準備
	maddaz.xyzw	ACC ,vf06,vf16		mtir		vi07,vf17w				; 透視変換,-
	maddw.xyzw	vf19,vf07,vf00		lq.xyzw		vf16,BUF_VERT(vi09)		; 透視変換,次の頂点読み出し
	mulax.x		ACC ,vf13,vf20		lq.xyzw		vf17,BUF_NORM(vi09)		; 内積計算,次の法線読み出し
	madday.x	ACC ,vf13,vf20		iaddi		vi08,vi08,-1			; 内積計算,
	maddz.x		vf23,vf13,vf20		sq.xyzw		vf22,BUF_NORM-BUF_NEXT*2(vi09); 内積計算,(遅)カラー書き出し
	clipw.xyz	vf19,vf19			sq.xyz		vf24,BUF_UV0-BUF_NEXT*2(vi09); クリップチェック,(遅)ＵＶ書き出し
	sub.w		vf23,vf13,vf19		nop									; 減衰計算,
	itof0.xyz	vf16,vf16			nop									; 次ループ準備,
	maxx.xyz	vf23,vf23,vf00		mr32.z		vf24,vf19				; xには光源方向ベクトルとの内積値,ＱにＷを格納
	itof12.xyz	vf17,vf17			fcand		vi01,0x010410			; 次ループ準備,投影範囲チェック（ニアのみ）
	maxx.w		vf23,vf23,vf13		ibeq		vi01,vi00,_cs_label_3	; 減衰計算,クリップ
	itof12.w	vf26,vf16			nop									; 次ループ準備,-
	; ポリゴンの頂点がニアクリップに引っかかった場合
	nop								ibltz		vi07,_cs_label_3		; 非描画頂点かどうかをチェック
	nop								nop									; 
	nop								ior			vi07,vi07,vi04			; ●描画スキップ
	nop								iaddiu		vi03,vi03,1				; クリップ頂点存在フラグＯＮ
_cs_label_3:
	mulax.xyz	ACC ,vf28,vf16		nop									; trans_v
	madday.xyz	ACC ,vf29,vf16		nop									; trans_v,-
	maddaz.xyz	ACC ,vf30,vf16		nop									; trans_v,make v
	maddw.xyz	vf26,vf31,vf00		nop									; trans_v,-
	sub.w		vf27,vf00,vf26		nop									; make v&n,-
	mulax.xyz	ACC ,vf28,vf17		nop									; trans_n,-
	madday.xyz	ACC ,vf29,vf17		nop									; trans_n,-
	maddz.xyz	vf27,vf30,vf17		nop									; trans_n,-
	mulaw.xyz	ACC ,vf16,vf26		nop									; make v,-
	maddw.xyz	vf16,vf26,vf27		nop									; make v,-
	mulaw.xyz	ACC ,vf17,vf26		nop									; make n,-
	maddw.xyz	vf17,vf27,vf27		nop									; make n,-
	mulx.xyzw	vf22,vf12,vf23		isw.w		vi07,BUF_UV0-BUF_NEXT(vi09)	; カラー計算,フラグの保存（ＵＶの方に）
	mula.xy		ACC ,vf19,vf02		ibgtz		vi08,CalcEnvelopeShadowLoop	; ＵＶ値設定,
	maddw.xy	vf24,vf02,vf19		nop										; ＵＶ値設定,

;後始末
	mulw.xyzw	vf22,vf22,vf23		nop								; 
	nop								sq.xyzw		vf22,BUF_NORM-BUF_NEXT(vi09); -,(遅)カラー書き出し
