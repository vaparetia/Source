; テクスチャの白黒化用ピクセルシェーダー（拡張）
; 
;
; 2002.05.15  K.Takabe

ps.1.1
;def c0, 0.33f, 0.34f, 0.33f, 1.0f
def c0, 0.30f, 0.59f, 0.11f, 1.0f	; グレイスケール定数
def c1, 0, 0, 0, 0					; 加算値

tex t0							; ベーステクスチャ

dp3    r0.rgb, c0, t0			; グレイスケール化
add    r0.rgb, r0, c1			; オフセット加算
mov    r0.a, c0.a
;mul_x2 r0.a,   v0, t0			; アルファはテクスチャ０のみを参照
;mul_x2 r0.rgb, r0, v0			; 頂点カラーでベーステクスチャをモジュレート

