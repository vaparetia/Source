;
;	mwtrans4.dsm
;	フォグ処理付きマルチウェイトモデルパケット処理プログラム
;	（法線正規化＆ＵＶバンプマッピング対応バージョン）
;	（＋マトリクスパレット方式採用バージョン）
;
;	2000/05/29 K.Takabe
;	$Id: mwtrans4.dsm,v 1.1.1.3 2002/11/19 11:42:14 Yoshizawa1 Exp $
;


; ================================================================
; DVPASM設定
; ================================================================


.global Vu1DrawMultiWeight4
.global Vu1DrawMultiWeight4_Func


; ================================================================
; プログラムアドレステーブル
; ================================================================
Vu1DrawMultiWeight4_Func:
	.word	( StartMultiWeightDraw / 8 )				; 
	.word	( StartMultiWeightDrawLarge / 8 )				; 
	.word	( StartMultiWeightDrawBump / 8 )				; 

; ================================================================
; データ記述開始
; ================================================================
.data
.DmaPackVif 1			; タグ中のＶＩＦコード有効

; ================================
; プログラム転送ＤＭＡタグ定義
; ================================
Vu1DrawMultiWeight4:		; マイクロプログラム読み込み用タグ記憶ポインタ
	DMAref *, _trans	; DMArefによるデータ転送を行う


; ================================================================
; 各種定数定義
; ================================================================

; ＜ワークアドレスオフセット＞
VAR00		= 0		; プログラム用変数領域
VAR00X		= 0		; クリップ用ワーク切り替えフラグ
VAR00Y		= 0		; 
VAR00Z		= 0		; 
VAR00W		= 0		; 
VAR01		= 1		; プログラム用変数領域
; 固定パラメータ類
FV_FOG		= 2		; フォグパラメータ
FV_PRM		= 3		; 各種定数
FV_SCN		= 4		; プリミティブ座標へのスケーリングパラメータ
FV_OFT		= 5		; プリミティブ座標へのオフセット値
FV_PRM2		= 6		; 各種定数２
FV_ASPC		= 7		; アスペクト比
M_PRS0		= 8		; 透視変換マトリクス０
M_PRS1		= 9		; 透視変換マトリクス１
M_PRS2		= 10	; 透視変換マトリクス２
M_PRS3		= 11	; 透視変換マトリクス３
; オブジェクト処理パラメータ類
M_OPT0		= 16	; オプションマトリクス０（特殊効果用）
M_OPT1		= 20	; オプションマトリクス１（特殊効果用）
M_LIT0		= 24	; ローカルライトマトリクスＸ = lit0_x,lit1_x,lit2_x,supecular_x
M_LIT1		= 25	; ローカルライトマトリクスＹ = lit0_y,lit1_y,lit2_y,supecular_y
M_LIT2		= 26	; ローカルライトマトリクスＺ = lit0_z,lit1_z,lit2_z,supecular_z
M_LIT3		= 27	; 未使用
M_COL0		= 28	; ローカルカラー０ = lit0_r,lit0_g,lit0_b
M_COL1		= 29	; ローカルカラー１ = lit1_r,lit1_g,lit1_b
M_COL2		= 30	; ローカルカラー２ = lit2_r,lit2_g,lit2_b
M_COL3		= 31	; アンビエントカラー = amb_r amb_g amb_b
M_MAT0		= 32	; エンベロープマトリクス０
M_MAT1		= 36	; エンベロープマトリクス１
M_MAT2		= 40	; エンベロープマトリクス２
M_MAT3		= 44	; エンベロープマトリクス３
M_MAT4		= 48	; エンベロープマトリクス４
M_MAT5		= 52	; エンベロープマトリクス５
M_MAT6		= 56	; エンベロープマトリクス６
M_MAT7		= 60	; エンベロープマトリクス７



PACKDAT		= 0x00	; パケット定数（x:頂点数、y:処理フラグ、z:固定フォグ値、w:マトリクス数）
GIFREGS		= 0x01	; マルチテクスチャ用ＧＩＦレジスタリスト
GIFCLIP		= 0x02	; クリップ描画用ＧＩＦタグ（トライアングルファン型）
GIFNORMAL	= 0x03	; 通常描画用ＧＩＦタグ（トライアングルストリップ型）
WORK_TOP	= 0x05	; パケット生成エリア先頭アドレスオフセット
PACK_TOP	= 0x06	; パケット生成エリア先頭アドレスオフセット
CWORK1		= 0x06+5* 6+1	; クリップ処理用ワーク先頭アドレスオフセット
CWORK2		= 0x06+5*15+2	; クリップ処理用ワーク先頭アドレスオフセット
TX0_OFT		= 0xe8	; テクスチャ設定パケット格納アドレスオフセット
TX1_OFT		= 0xf0	; テクスチャ設定パケット格納アドレスオフセット
TX2_OFT		= 0xf8	; テクスチャ設定パケット格納アドレスオフセット
DATA_OFT		= 0x100	; 頂点データ先頭アドレスオフセット


; ＜プログラム使用定数＞
; 処理フラグ
FLAG_CULL	= 0x0004	; カリング処理ＯＮ
FLAG_TEX0	= 0x0008	; テクスチャ０使用（必須なので特に必要ない）
FLAG_TEX1	= 0x0010	; テクスチャ１使用
FLAG_TEX2	= 0x0020	; テクスチャ２使用
FLAG_UV0	= 0x0040	; 通常ＵＶ０使用（必須なので特に必要ない）
FLAG_UV1	= 0x0080	; 通常ＵＶ１使用
; 拡張計算フラグ（下のフラグは共に排他でなければならない）
FLAG_UV2	= 0x0100	; 通常ＵＶ２使用
FLAG_EMAP	= 0x0200	; 環境マッピング（ＵＶ２へ格納）
FLAG_SMAP	= 0x0400	; 環境マッピング影（ＵＶ２へ格納）
FLAG_BMAP	= 0x0800	; バンプマッピング（ＵＶ１をずらしたものをＵＶ２へ格納）


; ＜データ構造定義＞
; パケット構成バッファ使用定数
DST_NEXT	= 5		; 次の頂点データへのオフセット
DST_UV0		= 0		; ＳＴＱデータへのオフセット
DST_UV1		= 1		; ＳＴＱデータへのオフセット
DST_UV2		= 2		; ＳＴＱデータへのオフセット
DST_COL		= 3		; 頂点カラーデータへのオフセット
DST_XYZ		= 4		; 頂点データへのオフセット

; エンベロープ処理後のデータ構造
SRC_NEXT	= 7		; 次の頂点データへのオフセット
SRC_FLG		= 2		; 座標変換処理終了後のキックフラグ格納オフセット
SRC_VERT	= 0		; 頂点データへのオフセット（実数、Ｗにはフォグ値）
SRC_NORM	= 1		; 法線データへのオフセット（実数）
SRC_UV0		= 2		; ＵＶ０データへのオフセット（実数）
SRC_UV1		= 3		; ＵＶ１データへのオフセット（実数）（ＷにはＱ設定値）
SRC_UV2		= 4		; ＵＶ２データへのオフセット（実数）
SRC_XYZW	= 5		; 計算済み同時座標へのオフセット（実数）
SRC_COL		= 6		; 算出済み頂点カラーへのオフセット（実数）

; データ読み込み直後のデータ構造
BUF_NEXT	= 7		; 次の頂点データへのオフセット
BUF_FLG		= 0		; 読み込み直後のキックフラグ格納オフセット
BUF_VERT	= 0		; 頂点データへのオフセット(1.15.0)
BUF_NORM	= 1		; 法線データへのオフセット(1.3.12)
BUF_UV0		= 2		; ＵＶ０データへのオフセット(1.3.12)
BUF_UV1		= 3		; ＵＶ１データへのオフセット(1.3.12)
BUF_UV2		= 4		; ＵＶ２データへのオフセット(1.3.12)
BUF_WT0		= 5		; 頂点重みデータへのオフセット(1.3.12)
BUF_IDX		= 6		; マトリクスパレット用インデックス番号（＝オフセット値）



; ================================================================
; 補足事項
; ================================================================
; エンベロープ処理ルーチンの流れ
; １）読み込み直後のデータを実数化しながら座標と法線の
; 　　変換後の座標を算出する。
; ２）フラグでＯＮになっている特殊効果がある場合には
; 　　その処理を行なう。（ＵＶの自動計算など）
; ３）クリップされていないポリゴンのみを描画。このとき
; 　　フラグでＯＮになっているテクスチャを全て描画する
; ４）クリップされるポリゴンは無駄なクリップ処理を省略するために
; 　　１枚毎に必要な全てのテクスチャ描画をその都度行なう。
; ＜補足＞
; マルチパステクスチャを実現する際にパケットとしてＳＴＱ０、ＳＴＱ１
; ＳＴＱ２、ＲＧＢＡ、ＸＹＺＦと言う順番で予めならべておき、ＧＩＦタグ
; 内のレジスタリストを切り替えることで任意のＵＶ値を使用するようにした。


; メモリ使用構成（ＶＵ１側から見るときには下位４ビットを無視すること）
; 0x0000~0x00ff	プログラムワーク
; 0x0100~0x03ff オブジェクトパラメータ設定（変換マトリクス等）
; 0x0400~0x21ff ダブルバッファ０
;  +0x0000_0x0fff 転送用バッファ
;  +0x1000_0x1cff 読み込み用バッファ
; 0x2200~0x3fff ダブルバッファ１
;  +0x0000_0x0fff 転送用バッファ
;  +0x1000_0x1cff 読み込み用バッファ
; 0x4000		最終アドレス
; 

; データフォーマット
; + 0.x    頂点データ数
; + 0.y    データ開始位置（=5）
; + 0.z    最大マトリクス数
; + 0.w    処理フラグ

; + 1.x    テクスチャ０描画用ＧＩＦタグ設定レジスタリスト
; + 1.y    テクスチャ１描画用ＧＩＦタグ設定レジスタリスト
; + 1.z    テクスチャ２描画用ＧＩＦタグ設定レジスタリスト
; + 1.w    リザーブ

; + 2.xyzw GIFtag（クリップポリゴン用プリミティブ転送ＧＩＦタグ）
; + 3.xyzw GIFtag（通常描画用プリミティブ転送ＧＩＦタグ）
; + 4.xyzw リザーブ（通常描画用プリミティブ転送ＧＩＦタグ設置エリア）

; +05.xyzw 第１ＳＴＱ０（但し、ＧＩＦタグのレジスタリストで使用する・しないを選択）
; +06.xyzw 第１ＳＴＱ１（但し、ＧＩＦタグのレジスタリストで使用する・しないを選択）
; +07.xyzw 第１ＳＴＱ２（但し、ＧＩＦタグのレジスタリストで使用する・しないを選択）
; +08.xyzw 第１ＲＧＢＡ
; +09.xyzw 第１ＸＹＺＦ
; +0a.xyzw 第２ＳＴＱ０（但し、ＧＩＦタグのレジスタリストで使用する・しないを選択）
; +0b.xyzw 第２ＳＴＱ１（但し、ＧＩＦタグのレジスタリストで使用する・しないを選択）
; +0c.xyzw 第２ＳＴＱ２（但し、ＧＩＦタグのレジスタリストで使用する・しないを選択）
; +0d.xyzw 第２ＲＧＢＡ
; .
; .
; .
;
; +e8.xyzw GIFtag（第１テクスチャパラメータ設定ＧＩＦタグ）
; +e9.xyzw CLAMP_1
; +ea.xyzw TEX2_1
; +eb.xyzw TEX0_1
; +ec.xyzw ALPHA
;
; +f0.xyzw GIFtag（第２テクスチャパラメータ設定ＧＩＦタグ）
; +f1.xyzw CLAMP_1
; +f2.xyzw TEX2_1
; +f3.xyzw TEX0_1
; +f4.xyzw ALPHA
;
; +f8.xyzw GIFtag（第３テクスチャパラメータ設定ＧＩＦタグ）
; +f9.xyzw CLAMP_1
; +fa.xyzw TEX2_1
; +fb.xyzw TEX0_1
; +fc.xyzw ALPHA
;
; +100.xyzw 第１ＵＶデータ
; +101.xyzw 第１法線データ
; +102.xyzw 第１頂点データ
; +103.xyzw 第２ＵＶデータ
; +104.xyzw 第１法線データ
; 
; 
; 
; 


; ================================
; 転送ＤＭＡデータ部
; ================================
.DmaData _trans			; DMArefで転送するデータの宣言

; ================================
; ＶＩＦ設定
; ================================
FLUSHE						; 
BASE		0x40			; ダブルバッファのベースアドレス
OFFSET		0x1e0			; ダブルバッファのオフセット
STMOD		0				; 加算書き込みＯＦＦ
STMASK		0xffff10		; １サイクルめのＺにROWの値を書き込む（ＵＶデータ用設定）（未使用）
STROW		0,0,4096,0		; Ｚメンバに4096（小数点以下１２ビットの固定小数点で1.0を表す）（未使用）

; ================================
; 定数の転送
; ================================

; ================================
; マイクロプログラム転送VIFcode
; ================================
MPG 0,*				; マイクロプログラム転送VIFcode
.vu


; ================================================================
; 通常レジスタ割り当て
; ================================================================
;	vf00:fix
;	vf01:定数読み込みベクトル
;	vf02:プリミティブ座標変換スケール
;	vf03:プリミティブ座標変換オフセット
;	vf04:エンベロープマトリクス
;	vf05:エンベロープマトリクス
;	vf06:エンベロープマトリクス
;	vf07:エンベロープマトリクス
;	vf08:透視変換マトリクス
;	vf09:透視変換マトリクス
;	vf10:透視変換マトリクス
;	vf11:透視変換マトリクス
;	vf12:
;	vf13:
;	vf14:
;	vf15:
;	vf16:頂点読み込み
;	vf17:法線読み込み
;	vf18:
;	vf19:
;	vf20:
;	vf21:ウェイト値読み込み
;	vf22:ウェイト値読み込み
;	vf24:頂点ウェイト計算テンポラリ＆ＳＴＱ値計算用テンポラリ
;	vf25:法線ウェイト計算テンポラリ＆Ｑ値保存用テンポラリ
;	vf26:頂点合計
;	vf27:法線合計
;	vf28:頂点作業用
;	vf29:法線合計

;	vi00:０
;	vi01:条件判断又はテンポラリ
;	vi05:マトリクスインデックス先読み用
;	vi06:マトリクス数カウント用
;	vi07:キックフラグ読み込み用
;	vi08:頂点数
;	vi09:読み込みデータアドレス
;	vi10:書き込みデータアドレス
;	vi11:エンベロープマトリクス読み取りアドレス
;	vi12:処理フラグ記憶用
;	vi13:バッファ先頭アドレス
;	vi15:リンクレジスタ＆クリップ処理チェックフラグ


; ================================================================
; 描画セットアップ処理
; ================================================================
;	upper		.					lower		.
StartMultiWeightDraw:
	nop								xtop		vi13				; -,データアドレス取得
	nop								lq.xyzw		vf01,FV_PRM(vi00)	; -,各種定数読み込み
	nop								lq.xyzw		vf08,M_PRS0(vi00)	; -,透視変換マトリクス読み込み
	nop								lq.xyzw		vf09,M_PRS1(vi00)	; -,透視変換マトリクス読み込み
	nop								lq.xyzw		vf10,M_PRS2(vi00)	; -,透視変換マトリクス読み込み
	nop								lq.xyzw		vf11,M_PRS3(vi00)	; -,透視変換マトリクス読み込み

	nop								ilw.w		vi12,0x00(vi13)		; -,処理フラグ取得
	nop								ilw.z		vi06,PACKDAT(vi13)	; -,マトリクス数取得（追加）
	nop								iaddiu		vi01,vi00,FLAG_BMAP	; -,バンプ使用フラグ
	nop								iand		vi01,vi12,vi01		; -,チェック
	nop								lq.xyzw		vf02,FV_SCN(vi00)	; -,フォグパラメータ読み込み
	nop								ibne		vi01,vi00,StartMultiWeightDrawBump	; -,スキップ
	nop								lq.xyzw		vf03,FV_OFT(vi00)	; -,フォグパラメータ読み込み

	nop								ilw.x		vi08,PACKDAT(vi13)	; -,頂点数取得
	nop								iaddiu		vi09,vi13,DATA_OFT	; -,データ読み取りアドレス設定
	nop								iaddiu		vi01,vi00,1			; -,マトリクス数チェック（追加）
	nop								iaddiu		vi10,vi13,DATA_OFT	; -,データ書き込みアドレス設定
	nop								ibeq		vi06,vi01,StartOneWeightDraw	;（追加）
; ----------------------------------------------------------------
; マルチウェイトエンベロープ合成＆透視変換処理
; ----------------------------------------------------------------
	; エンベロープ頂点合成
	; バッファデータの実数化とその他の前処理
	nop								loi			0.0078125			; =1.0f/128.0f
	nop								ilw.x		vi11,BUF_IDX(vi09)	; -,マトリクスインデックス読み込み
	nop								ilw.y		vi05,BUF_IDX(vi09)	; -,次のM-INDEX読み込み
	nop								lq.xyzw		vf21,BUF_WT0(vi09)	; -,重み読み込み
	nop								lq.xyzw		vf16,BUF_VERT(vi09)	; -,頂点読み込み
	nop								lq.xyzw		vf17,BUF_NORM(vi09)	; -,法線読み込み
	nop								iaddiu		vi11,vi11,M_MAT0	; -,マトリクスアドレス設定
	itof0.xyzw	vf21,vf21			ilw.z		vi06,PACKDAT(vi13)	; 重み実数化,マトリクス数取得
	itof4.xyz	vf16,vf16			lq.xyzw		vf04,0x00(vi11)		; 頂点実数化,最初のマトリクス読み込み
	itof12.xyz	vf17,vf17			lq.xyzw		vf05,0x01(vi11)		; 法線実数化,最初のマトリクス読み込み
	nop								lq.xyzw		vf06,0x02(vi11)		; -,最初のマトリクス読み込み
	muli.xyzw	vf21,vf21,I			lq.xyzw		vf07,0x03(vi11)		; 重み実数化,最初のマトリクス読み込み

; 最初の１頂点目
	; 第１マトリクス計算（無条件にウェイトを考慮せず計算する）
	mulax.xyzw	ACC ,vf04,vf16		iaddi		vi06,vi06,-1		; 頂点計算,マトリクス数減算
	madday.xyzw	ACC ,vf05,vf16		iaddiu		vi09,vi09,BUF_NEXT	; 頂点計算,読み込みアドレス増加
	maddaz.xyzw	ACC ,vf06,vf16		iaddiu		vi11,vi05,M_MAT0	; 頂点計算,マトリクスアドレス設定
	maddw.xyzw	vf26,vf07,vf00		lq.xyzw		vf07,0x03(vi11)		; 頂点計算,次のマトリクス読み込み
	mulax.xyzw	ACC ,vf04,vf17		lq.xyzw		vf04,0x00(vi11)		; 法線計算,次のマトリクス読み込み
	madday.xyzw	ACC ,vf05,vf17		lq.xyzw		vf05,0x01(vi11)		; 法線計算,次のマトリクス読み込み
	maddz.xyzw	vf27,vf06,vf17		lq.xyzw		vf06,0x02(vi11)		; 法線計算,次のマトリクス読み込み
