	mulax.xyzw	ACC ,vf04,vf16		iaddiu		vi09,vi09,BUF_NEXT			; 頂点計算,読み込みアドレス増加
	madday.xyzw	ACC ,vf05,vf16		ilw.x		vi11,BUF_IDX(vi09)			; 頂点計算,最初のマトリクスインデックス
	maddaz.xyzw	ACC ,vf06,vf16		lq.xyzw		vf16,BUF_VERT(vi09)			; 頂点計算,頂点読み込み
	maddw.xyzw	vf26,vf07,vf00		iaddi		vi08,vi08,-1				; 頂点計算,カウンタデクリメント
	mulax.xyzw	ACC ,vf04,vf17		nop										; 法線計算,
	madday.xyzw	ACC ,vf05,vf17		iaddiu		vi11,vi11,M_MAT0			; 法線計算,マトリクスアドレス設定
	maddz.xyzw	vf27,vf06,vf17		lq.xyzw		vf17,BUF_NORM(vi09)			; 法線計算,法線読み込み
	mulax.xyzw	ACC ,vf08,vf26		lq.xyzw		vf04,0x00(vi11)				; 透視変換,最初のマトリクス読み込み
	madday.xyzw	ACC ,vf09,vf26		lq.xyzw		vf05,0x01(vi11)				; 透視変換,最初のマトリクス読み込み
	maddaz.xyzw	ACC ,vf10,vf26		lq.xyzw		vf06,0x02(vi11)				; 透視変換,最初のマトリクス読み込み
	maddw.xyzw	vf26,vf11,vf00		sq.xyz		vf27,BUF_NORM(vi10)			; 透視変換,法線書き戻し
	itof0.xyz	vf16,vf16			lq.xyzw		vf07,0x03(vi11)				; 頂点実数化,最初のマトリクス読み込み
	itof12.xyz	vf17,vf17			iaddiu		vi10,vi10,BUF_NEXT			; 法線実数化,書き込みアドレス増加
	nop								ibgtz		vi08,0b						; -,ループ
	nop								sq.xyzw		vf26,SRC_XYZW-BUF_NEXT(vi10); -,座標書き戻し

; 後始末
	nop								lq.xyzw		vf08,M_LIT0(vi00)			; 
	nop								lq.xyzw		vf09,M_LIT1(vi00)			; 
	nop								lq.xyzw		vf10,M_LIT2(vi00)			; 
	nop								lq.xyzw		vf11,FV_FOG(vi00)			; 
	nop								lq.xyzw		vf12,M_COL0(vi00)			; 
	nop								lq.xyzw		vf13,M_COL1(vi00)			; 
	nop								lq.xyzw		vf14,M_COL2(vi00)			; 
	nop								lq.xyzw		vf15,M_COL3(vi00)			; 
	nop								b			TransMainStart				; 
;	nop								b			CullTransMainStart				; 
	nop								nop										; 



; ================================================================
; 通常レジスタ割り当て
; ================================================================
;	vf00:fix
;	vf01:定数読み込みベクトル
;	vf02:プリミティブ座標変換スケール
;	vf03:プリミティブ座標変換オフセット
;	vf04:
;	vf05:
;	vf06:
;	vf07:
;	vf08:ローカルライトマトリクス
;	vf09:ローカルライトマトリクス
;	vf10:ローカルライトマトリクス
;	vf11:フォグパラメータ
;	vf12:ローカルカラーマトリクス
;	vf13:ローカルカラーマトリクス
;	vf14:ローカルカラーマトリクス
;	vf15:ローカルカラーマトリクス
;	vf16:頂点読み込み
;	vf17:法線読み込み
;	vf18:ＵＶ読み込み
;	vf19:頂点
;	vf20:法線
;	vf21:
;	vf22:頂点
;	vf23:法線
;	vf24:ＵＶ書き込み
;	vf25:頂点書き込み
;	vf26:法線書き込み
;	vf27:１つ前の頂点
;	vf28:１つ前のベクトル
;	vf29:ベクトル計算用テンポラリ
;	vf30:外積計算結果
;	vf31:キックフラグ生成用

;	vi00:０
;	vi01:条件判断又はテンポラリ
;	vi06:マトリクス数カウント用
;	vi07:キックフラグ読み込み用
;	vi08:頂点数
;	vi09:読み込みデータアドレス
;	vi10:書き込みデータアドレス
;	vi11:エンベロープマトリクス読み取りアドレス
;	vi12:処理フラグ記憶用
;	vi13:バッファ先頭アドレス
;	vi15:リンクレジスタ＆クリップ処理チェックフラグ


; ----------------------------------------------------------------
; 光源計算＆ＵＶ補正
; ----------------------------------------------------------------
; 変換開始ルーチン
TransMainStart:
	nop								ilw.x		vi08,GIFREGS(vi13)			; -,バースト描画チェック
	nop								iaddiu		vi01,vi00,FLAG_CULL			; カリング
	nop								iand		vi01,vi01,vi12				; カリング
	nop								ibeq		vi08,vi00,FastTransMainStart ;	-,バースト描画チェック
	muly.w		vf23,vf00,vf01		ilw.x		vi08,PACKDAT(vi13)			; アルファ設定,頂点数取得
	nop								ibne		vi01,vi00,CullTransMainStart	; カリング
	nop								fcset		0							; クリップフラグ初期化
	nop								iaddiu		vi15,vi00,0					; クリップ処理フラグクリア
	nop								ilw.w		vi12,0x00(vi13)				; -,処理フラグ取得
	nop								iaddiu		vi09,vi13,DATA_OFT			; -,データ読み取りアドレス設定
	nop								iaddiu		vi10,vi13,PACK_TOP			; -,データ書き込みアドレス設定
	; エンベロープ頂点合成
	; バッファデータの実数化とその他の前処理
	nop								lq.xyzw		vf16,SRC_XYZW(vi09)			; -,頂点読み込み
	nop								lq.xyzw		vf17,BUF_NORM(vi09)			; -,法線読み込み
	nop								lq.xyzw		vf18,BUF_UV0(vi09)			; -,ＵＶ０読み込み
	nop								ilw.w		vi07,BUF_FLG(vi09)			; 
	nop								iaddiu		vi06,vi00,0x4000			; ＵＶ０実数化,
	nop								iadd		vi06,vi06,vi06				; vi06 = 0x8000
	nop								iaddiu		vi04,vi06,0x4fff			; vi04 = 0xcfff

	; 頂点変換処理（途中で次の頂点の情報を読み込んでおく）
	clipw.xyz	vf16,vf16			div			Q,vf00w,vf16w				; クリップ,透視変換
	mulax.xyz	ACC ,vf08,vf17		nop										; 光源計算,
	madday.xyz	ACC ,vf09,vf17		nop										; 光源計算,
;	ftoi4.xyzw	vf25,vf22			nop										; (遅)整数化,-
;	ftoi0.xyzw	vf26,vf23			nop										; (遅)整数化,(遅)クリップ用保存
	maddz.xyz	vf20,vf10,vf17		iaddiu		vi09,vi09,BUF_NEXT			; 光源計算,読み込みアドレス増加
	itof12.xyz	vf18,vf18			fcand		vi01,0x3ffff				; ＵＶ,クリップ
	mulax.w		ACC ,vf16,vf11		ibeq		vi01,vi00,l00				; フォグ,クリップ
	maddy.w		vf22,vf00,vf11		iand		vi05,vi07,vi06				; フォグ,キックフラグ
;	nop								ibltz		vi07,l00					; ●
;	nop								ior			vi05,vi05,vi06				; ●
;	nop								ior			vi07,vi07,vi04				; ●
;	nop								iaddiu		vi15,vi15,1					; ●
l00:maxx.xyz	vf20,vf20,vf00		mfir.w		vf31,vi05					; 光源計算,キックフラグ
	mulq.xyz	vf22,vf16,Q			isw.w		vi07,SRC_FLG-SRC_NEXT(vi09)	; 透視変換,キックフラグ
	mulq.xyz	vf24,vf18,Q			sq.xyz		vf18,SRC_UV0-SRC_NEXT(vi09)	; ＳＴＱ,クリップ用保存
	maxx.w		vf22,vf22,vf00		nop										; フォグ,(遅)座標書き込み
	itof4.w		vf31,vf31			nop										; フォグ,(遅)カラー書き込み
	mulax.xyz	ACC ,vf12,vf20		nop										; 光源計算,-
	madday.xyz	ACC ,vf13,vf20		sq.xyz		vf24,DST_UV0(vi10)			; 光源計算,ＵＶ書き込み
	minix.w		vf22,vf22,vf01		iaddiu		vi10,vi10,DST_NEXT			; フォグ,-
	maddaz.xyz	ACC ,vf14,vf20		iaddi		vi08,vi08,-1				; 光源計算,カウンタ減算
	maddw.xyz	vf23,vf15,vf00		lq.xyzw		vf16,SRC_XYZW(vi09)			; 光源計算,(先)座標読み込み
	mula.xyz	ACC ,vf22,vf02		lq.xyzw		vf17,BUF_NORM(vi09)			; 透視変換,(先)法線読み込み
	add.w		vf22,vf22,vf31		lq.xyzw		vf18,BUF_UV0(vi09)			; フォグ,(先)ＵＶ読み込み
	maddw.xyz	vf22,vf03,vf00		ibgtz		vi08,_ClipTransLoop			; 透視変換,ループ
	minix.xyz	vf23,vf23,vf01		ilw.w		vi07,BUF_FLG(vi09)			; 光源計算,(先)フラグ読み込み

_ClipTransLoop:
	; 頂点変換処理（途中で次の頂点の情報を読み込んでおく）
	clipw.xyz	vf16,vf16			div			Q,vf00w,vf16w				; クリップ,透視変換
	mulax.xyz	ACC ,vf08,vf17		nop										; 光源計算,
	madday.xyz	ACC ,vf09,vf17		nop										; 光源計算,
	ftoi4.xyzw	vf25,vf22			nop										; (遅)整数化,-
	ftoi0.xyzw	vf26,vf23			sq.xyzw		vf23,SRC_COL-SRC_NEXT(vi09)	; (遅)整数化,(遅)クリップ用保存
	maddz.xyz	vf20,vf10,vf17		iaddiu		vi09,vi09,BUF_NEXT			; 光源計算,読み込みアドレス増加
	itof12.xyz	vf18,vf18			fcand		vi01,0x3ffff				; ＵＶ,クリップ
	mulax.w		ACC ,vf16,vf11		ibeq		vi01,vi00,l01				; フォグ,クリップ
	maddy.w		vf22,vf00,vf11		iand		vi05,vi07,vi06				; フォグ,キックフラグ
	nop								ibltz		vi07,l01					; ●
	nop								ior			vi05,vi05,vi06				; ●
	nop								ior			vi07,vi07,vi04				; ●
	nop								iaddiu		vi15,vi15,1					; ●
l01:maxx.xyz	vf20,vf20,vf00		mfir.w		vf31,vi05					; 光源計算,キックフラグ
	mulq.xyz	vf22,vf16,Q			isw.w		vi07,SRC_FLG-SRC_NEXT(vi09)	; 透視変換,キックフラグ
	mulq.xyz	vf24,vf18,Q			sq.xyz		vf18,SRC_UV0-SRC_NEXT(vi09)	; ＳＴＱ,クリップ用保存
	maxx.w		vf22,vf22,vf00		sq.xyzw		vf25,DST_XYZ-DST_NEXT(vi10)	; フォグ,(遅)座標書き込み
	itof4.w		vf31,vf31			sq.xyzw		vf26,DST_COL-DST_NEXT(vi10)	; フォグ,(遅)カラー書き込み
	mulax.xyz	ACC ,vf12,vf20		nop										; 光源計算,-
	madday.xyz	ACC ,vf13,vf20		sq.xyz		vf24,DST_UV0(vi10)			; 光源計算,ＵＶ書き込み
	minix.w		vf22,vf22,vf01		iaddiu		vi10,vi10,DST_NEXT			; フォグ,-
	maddaz.xyz	ACC ,vf14,vf20		iaddi		vi08,vi08,-1				; 光源計算,カウンタ減算
	maddw.xyz	vf23,vf15,vf00		lq.xyzw		vf16,SRC_XYZW(vi09)			; 光源計算,(先)座標読み込み
	mula.xyz	ACC ,vf22,vf02		lq.xyzw		vf17,BUF_NORM(vi09)			; 透視変換,(先)法線読み込み
	add.w		vf22,vf22,vf31		lq.xyzw		vf18,BUF_UV0(vi09)			; フォグ,(先)ＵＶ読み込み
	maddw.xyz	vf22,vf03,vf00		ibgtz		vi08,_ClipTransLoop			; 透視変換,ループ
	minix.xyz	vf23,vf23,vf01		ilw.w		vi07,BUF_FLG(vi09)			; 光源計算,(先)フラグ読み込み

	; 後始末
	nop								iaddiu		vi01,vi13,TX0_OFT			; -,テクスチャ設定
	nop								xgkick		vi01						; -,テクスチャ設定
	ftoi4.xyzw	vf25,vf22			nop										; (遅)整数化,
	ftoi0.xyzw	vf26,vf23			sq.xyzw		vf23,SRC_COL-SRC_NEXT(vi09)	; (遅)整数化,(遅)クリップ用保存
	nop								sq.xyzw		vf25,DST_XYZ-DST_NEXT(vi10)	; -,(遅)座標書き込み
	nop								b			tex0f_start					; 
	nop								sq.xyzw		vf26,DST_COL-DST_NEXT(vi10)	; -,(遅)カラー書き込み


; ----------------------------------------------------------------
; 光源計算＆ＵＶ補正
; ----------------------------------------------------------------
; 変換開始ルーチン
; カリング対応
CullTransMainStart:
	muly.w		vf23,vf00,vf01		ilw.x		vi08,PACKDAT(vi13)			; アルファ設定,頂点数取得
	nop								fcset		0							; クリップフラグ初期化
	nop								iaddiu		vi15,vi00,0					; クリップ処理フラグクリア
	nop								ilw.w		vi12,0x00(vi13)				; -,処理フラグ取得
	nop								iaddiu		vi09,vi13,DATA_OFT			; -,データ読み取りアドレス設定
	nop								iaddiu		vi10,vi13,PACK_TOP			; -,データ書き込みアドレス設定
	; エンベロープ頂点合成
	; バッファデータの実数化とその他の前処理
	nop								lq.xyzw		vf16,SRC_XYZW(vi09)			; -,頂点読み込み
	nop								lq.xyzw		vf17,BUF_NORM(vi09)			; -,法線読み込み
	nop								lq.xyzw		vf18,BUF_UV0(vi09)			; -,ＵＶ０読み込み
	nop								ilw.w		vi07,BUF_FLG(vi09)			; 
	nop								iaddiu		vi06,vi00,0x4000			; ＵＶ０実数化,
	nop								iadd		vi06,vi06,vi06				; vi06 = 0x8000
;	nop								iaddiu		vi04,vi06,0x4fff			; vi04 = 0xcfff
	nop								iaddiu		vi04,vi06,0x4000			; vi04 = 0xc000

	; 頂点変換処理（途中で次の頂点の情報を読み込んでおく）
	clipw.xyz	vf16,vf16			div			Q,vf00w,vf16w				; クリップ,透視変換
	mulaw.xyz	ACC ,vf16,vf27		iaddiu		vi03,vi00,0x0030			; カリング,カリング
	msubw.xyz	vf29,vf27,vf16		move.xyzw	vf27,vf16					; カリング,カリング
	mulax.xyz	ACC ,vf08,vf17		nop										; 光源計算,
	madday.xyz	ACC ,vf09,vf17		nop										; 光源計算,
;	ftoi4.xyzw	vf25,vf22			nop										; (遅)整数化,-
;	ftoi0.xyzw	vf26,vf23			nop										; (遅)整数化,(遅)クリップ用保存
	maddz.xyz	vf20,vf10,vf17		iaddiu		vi09,vi09,BUF_NEXT			; 光源計算,読み込みアドレス増加
	opmula.xyz	ACC ,vf28,vf29		iaddiu		vi02,vi00,0x0020			; カリング,カリング
	opmsub.xyz	vf30,vf29,vf28		move.xyzw	vf28,vf29					; カリング,カリング
	itof12.xyz	vf18,vf18			fcand		vi01,0x3ffff				; ＵＶ,クリップ
	mulax.w		ACC ,vf16,vf11		ibeq		vi01,vi00,l10				; フォグ,クリップ
	maddy.w		vf22,vf00,vf11		iand		vi05,vi07,vi06				; フォグ,キックフラグ
;	nop								ibltz		vi07,l10					; ●
;	nop								ior			vi05,vi05,vi06				; ●
;	nop								ior			vi07,vi07,vi04				; ●
;	nop								iaddiu		vi15,vi15,1					; ●
l10:maxx.xyz	vf20,vf20,vf00		mfir.w		vf31,vi05					; 光源計算,キックフラグ
	mulq.xyz	vf22,vf16,Q			isw.w		vi07,SRC_FLG-SRC_NEXT(vi09)	; 透視変換,キックフラグ
	mulq.xyz	vf24,vf18,Q			sq.xyz		vf18,SRC_UV0-SRC_NEXT(vi09)	; ＳＴＱ,クリップ用保存
	maxx.w		vf22,vf22,vf00		nop										; フォグ,(遅)座標書き込み
	itof4.w		vf31,vf31			nop										; フォグ,(遅)カラー書き込み
	mulax.xyz	ACC ,vf12,vf20		nop										; 光源計算,-
	madday.xyz	ACC ,vf13,vf20		sq.xyz		vf24,DST_UV0(vi10)			; 光源計算,ＵＶ書き込み
	minix.w		vf22,vf22,vf01		iaddiu		vi10,vi10,DST_NEXT			; フォグ,-
	maddaz.xyz	ACC ,vf14,vf20		iaddi		vi08,vi08,-1				; 光源計算,カウンタ減算
	maddw.xyz	vf23,vf15,vf00		lq.xyzw		vf16,SRC_XYZW(vi09)			; 光源計算,(先)座標読み込み
	mula.xyz	ACC ,vf22,vf02		lq.xyzw		vf17,BUF_NORM(vi09)			; 透視変換,(先)法線読み込み
	add.w		vf22,vf22,vf31		lq.xyzw		vf18,BUF_UV0(vi09)			; フォグ,(先)ＵＶ読み込み
	maddw.xyz	vf22,vf03,vf00		ibgtz		vi08,_CullClipTransLoop			; 透視変換,ループ
	minix.xyz	vf23,vf23,vf01		ilw.w		vi07,BUF_FLG(vi09)			; 光源計算,(先)フラグ読み込み

_CullClipTransLoop:
	; 頂点変換処理（途中で次の頂点の情報を読み込んでおく）
	clipw.xyz	vf16,vf16			div			Q,vf00w,vf16w				; クリップ,透視変換
	mulaw.xyz	ACC ,vf16,vf27		iaddiu		vi03,vi00,0x0030			; カリング,カリング
	msubw.xyz	vf29,vf27,vf16		move.xyzw	vf27,vf16					; カリング,カリング
	mulax.xyz	ACC ,vf08,vf17		nop										; 光源計算,
	madday.xyz	ACC ,vf09,vf17		nop										; 光源計算,
	ftoi4.xyzw	vf25,vf22			nop										; (遅)整数化,-
	ftoi0.xyzw	vf26,vf23			sq.xyzw		vf23,SRC_COL-SRC_NEXT(vi09)	; (遅)整数化,(遅)クリップ用保存
	maddz.xyz	vf20,vf10,vf17		iaddiu		vi09,vi09,BUF_NEXT			; 光源計算,読み込みアドレス増加
	opmula.xyz	ACC ,vf28,vf29		iaddiu		vi02,vi00,0x0020			; カリング,カリング
	opmsub.xyz	vf30,vf29,vf28		move.xyzw	vf28,vf29					; カリング,カリング
	itof12.xyz	vf18,vf18			fcand		vi01,0x3ffff				; ＵＶ,クリップ
	mulax.w		ACC ,vf16,vf11		ibeq		vi01,vi00,l12				; フォグ,クリップ
	maddy.w		vf22,vf00,vf11		iand		vi05,vi07,vi06				; フォグ,キックフラグ
	nop								ibltz		vi07,l11					; ●
	nop								ior			vi05,vi05,vi06				; ●
	nop								ior			vi07,vi07,vi04				; ●
	nop								b			l11							; ●
	nop								iaddiu		vi15,vi15,1					; ●
l12:nop								iand		vi03,vi03,vi07				; -,カリング
	nop								fmand		vi02,vi02					; -,カリング
	nop								ibne		vi02,vi03,l11				; -,カリング
	nop								nop										; -,カリング
	nop								ior			vi05,vi05,vi06				; -,カリング
l11:maxx.xyz	vf20,vf20,vf00		mfir.w		vf31,vi05					; 光源計算,キックフラグ
	mulq.xyz	vf22,vf16,Q			isw.w		vi07,SRC_FLG-SRC_NEXT(vi09)	; 透視変換,キックフラグ
	mulq.xyz	vf24,vf18,Q			sq.xyz		vf18,SRC_UV0-SRC_NEXT(vi09)	; ＳＴＱ,クリップ用保存
	maxx.w		vf22,vf22,vf00		sq.xyzw		vf25,DST_XYZ-DST_NEXT(vi10)	; フォグ,(遅)座標書き込み
	itof4.w		vf31,vf31			sq.xyzw		vf26,DST_COL-DST_NEXT(vi10)	; フォグ,(遅)カラー書き込み
	mulax.xyz	ACC ,vf12,vf20		nop										; 光源計算,-
	madday.xyz	ACC ,vf13,vf20		sq.xyz		vf24,DST_UV0(vi10)			; 光源計算,ＵＶ書き込み
	minix.w		vf22,vf22,vf01		iaddiu		vi10,vi10,DST_NEXT			; フォグ,-
	maddaz.xyz	ACC ,vf14,vf20		iaddi		vi08,vi08,-1				; 光源計算,カウンタ減算
	maddw.xyz	vf23,vf15,vf00		lq.xyzw		vf16,SRC_XYZW(vi09)			; 光源計算,(先)座標読み込み
	mula.xyz	ACC ,vf22,vf02		lq.xyzw		vf17,BUF_NORM(vi09)			; 透視変換,(先)法線読み込み
	add.w		vf22,vf22,vf31		lq.xyzw		vf18,BUF_UV0(vi09)			; フォグ,(先)ＵＶ読み込み
	maddw.xyz	vf22,vf03,vf00		ibgtz		vi08,_CullClipTransLoop			; 透視変換,ループ
	minix.xyz	vf23,vf23,vf01		ilw.w		vi07,BUF_FLG(vi09)			; 光源計算,(先)フラグ読み込み

	; 後始末
	nop								iaddiu		vi01,vi13,TX0_OFT			; -,テクスチャ設定
	nop								xgkick		vi01						; -,テクスチャ設定
	ftoi4.xyzw	vf25,vf22			nop										; (遅)整数化,
	ftoi0.xyzw	vf26,vf23			sq.xyzw		vf23,SRC_COL-SRC_NEXT(vi09)	; (遅)整数化,(遅)クリップ用保存
	nop								sq.xyzw		vf25,DST_XYZ-DST_NEXT(vi10)	; -,(遅)座標書き込み
	nop								b			tex0f_start					; 
	nop								sq.xyzw		vf26,DST_COL-DST_NEXT(vi10)	; -,(遅)カラー書き込み



; ----------------------------------------------------------------
; 光源計算＆ＵＶ補正
; ----------------------------------------------------------------
; 変換開始ルーチン
FastTransMainStart:
	nop								iaddiu		vi01,vi00,FLAG_CULL			; カリング
	nop								iand		vi01,vi01,vi12				; カリング
	muly.w		vf23,vf00,vf01		ilw.x		vi08,PACKDAT(vi13)			; アルファ設定,頂点数取得
	nop								ibne		vi01,vi00,CullFastTransMainStart	; カリング
	nop								fcset		0							; クリップフラグ初期化
	nop								iaddiu		vi15,vi00,0					; クリップ処理フラグクリア
	nop								ilw.w		vi12,0x00(vi13)				; -,処理フラグ取得
	nop								iaddiu		vi09,vi13,DATA_OFT			; -,データ読み取りアドレス設定
	nop								iaddiu		vi10,vi13,PACK_TOP			; -,データ書き込みアドレス設定
	; エンベロープ頂点合成
	; バッファデータの実数化とその他の前処理
	nop								lq.xyzw		vf16,SRC_XYZW(vi09)			; -,頂点読み込み
	nop								lq.xyzw		vf17,BUF_NORM(vi09)			; -,法線読み込み
	nop								lq.xyzw		vf18,BUF_UV0(vi09)			; -,ＵＶ０読み込み
	nop								ilw.w		vi07,BUF_FLG(vi09)			; 
	nop								iaddiu		vi06,vi00,0x4000			; ＵＶ０実数化,
	nop								iadd		vi06,vi06,vi06				; vi06 = 0x8000
	nop								iaddiu		vi04,vi06,0x4fff			; vi04 = 0xcfff

	; 頂点変換処理（途中で次の頂点の情報を読み込んでおく）
	mulax.xyz	ACC ,vf08,vf17		div			Q,vf00w,vf16w				; 光源計算,透視変換
	madday.xyz	ACC ,vf09,vf17		nop										; 光源計算,
;	ftoi4.xyzw	vf25,vf22			nop										; (遅)整数化,-
;	ftoi0.xyzw	vf26,vf23			nop										; (遅)整数化,(遅)クリップ用保存
	maddz.xyz	vf20,vf10,vf17		iaddiu		vi09,vi09,BUF_NEXT			; 光源計算,読み込みアドレス増加
	itof12.xyz	vf18,vf18			nop										; ＵＶ,
	mulax.w		ACC ,vf16,vf11		nop										; フォグ,
	maddy.w		vf22,vf00,vf11		iand		vi05,vi07,vi06				; フォグ,キックフラグ
	maxx.xyz	vf20,vf20,vf00		mfir.w		vf31,vi05					; 光源計算,キックフラグ
	mulq.xyz	vf22,vf16,Q			isw.w		vi07,SRC_FLG-SRC_NEXT(vi09)	; 透視変換,キックフラグ
	mulq.xyz	vf24,vf18,Q			sq.xyz		vf18,SRC_UV0-SRC_NEXT(vi09)	; ＳＴＱ,クリップ用保存
	maxx.w		vf22,vf22,vf00		nop										; フォグ,(遅)座標書き込み
	itof4.w		vf31,vf31			nop										; フォグ,(遅)カラー書き込み
	mulax.xyz	ACC ,vf12,vf20		nop										; 光源計算,-
	madday.xyz	ACC ,vf13,vf20		sq.xyz		vf24,DST_UV0(vi10)			; 光源計算,ＵＶ書き込み
	minix.w		vf22,vf22,vf01		iaddiu		vi10,vi10,DST_NEXT			; フォグ,-
	maddaz.xyz	ACC ,vf14,vf20		iaddi		vi08,vi08,-1				; 光源計算,カウンタ減算
	maddw.xyz	vf23,vf15,vf00		lq.xyzw		vf16,SRC_XYZW(vi09)			; 光源計算,(先)座標読み込み
	mula.xyz	ACC ,vf22,vf02		lq.xyzw		vf17,BUF_NORM(vi09)			; 透視変換,(先)法線読み込み
	add.w		vf22,vf22,vf31		lq.xyzw		vf18,BUF_UV0(vi09)			; フォグ,(先)ＵＶ読み込み
	maddw.xyz	vf22,vf03,vf00		ibgtz		vi08,_FastTransLoop			; 透視変換,ループ
	minix.xyz	vf23,vf23,vf01		ilw.w		vi07,BUF_FLG(vi09)			; 光源計算,(先)フラグ読み込み

_FastTransLoop:
	; 頂点変換処理（途中で次の頂点の情報を読み込んでおく）
	mulax.xyz	ACC ,vf08,vf17		div			Q,vf00w,vf16w				; 光源計算,透視変換
	madday.xyz	ACC ,vf09,vf17		nop										; 光源計算,
	ftoi4.xyzw	vf25,vf22			nop										; (遅)整数化,-
	ftoi0.xyzw	vf26,vf23			sq.xyzw		vf23,SRC_COL-SRC_NEXT(vi09)	; (遅)整数化,(遅)クリップ用保存
	maddz.xyz	vf20,vf10,vf17		iaddiu		vi09,vi09,BUF_NEXT			; 光源計算,読み込みアドレス増加
	itof12.xyz	vf18,vf18			nop										; ＵＶ,
	mulax.w		ACC ,vf16,vf11		nop										; フォグ,
	maddy.w		vf22,vf00,vf11		iand		vi05,vi07,vi06				; フォグ,キックフラグ
	maxx.xyz	vf20,vf20,vf00		mfir.w		vf31,vi05					; 光源計算,キックフラグ
	mulq.xyz	vf22,vf16,Q			isw.w		vi07,SRC_FLG-SRC_NEXT(vi09)	; 透視変換,キックフラグ
	mulq.xyz	vf24,vf18,Q			sq.xyz		vf18,SRC_UV0-SRC_NEXT(vi09)	; ＳＴＱ,クリップ用保存
	maxx.w		vf22,vf22,vf00		sq.xyzw		vf25,DST_XYZ-DST_NEXT(vi10)	; フォグ,(遅)座標書き込み
	itof4.w		vf31,vf31			sq.xyzw		vf26,DST_COL-DST_NEXT(vi10)	; フォグ,(遅)カラー書き込み
	mulax.xyz	ACC ,vf12,vf20		nop										; 光源計算,-
	madday.xyz	ACC ,vf13,vf20		sq.xyz		vf24,DST_UV0(vi10)			; 光源計算,ＵＶ書き込み
	minix.w		vf22,vf22,vf01		iaddiu		vi10,vi10,DST_NEXT			; フォグ,-
	maddaz.xyz	ACC ,vf14,vf20		iaddi		vi08,vi08,-1				; 光源計算,カウンタ減算
	maddw.xyz	vf23,vf15,vf00		lq.xyzw		vf16,SRC_XYZW(vi09)			; 光源計算,(先)座標読み込み
	mula.xyz	ACC ,vf22,vf02		lq.xyzw		vf17,BUF_NORM(vi09)			; 透視変換,(先)法線読み込み
	add.w		vf22,vf22,vf31		lq.xyzw		vf18,BUF_UV0(vi09)			; フォグ,(先)ＵＶ読み込み
	maddw.xyz	vf22,vf03,vf00		ibgtz		vi08,_FastTransLoop			; 透視変換,ループ
	minix.xyz	vf23,vf23,vf01		ilw.w		vi07,BUF_FLG(vi09)			; 光源計算,(先)フラグ読み込み

	; 後始末
	nop								iaddiu		vi01,vi13,TX0_OFT			; -,テクスチャ設定
	nop								xgkick		vi01						; -,テクスチャ設定
	ftoi4.xyzw	vf25,vf22			nop										; (遅)整数化,
	ftoi0.xyzw	vf26,vf23			sq.xyzw		vf23,SRC_COL-SRC_NEXT(vi09)	; (遅)整数化,(遅)クリップ用保存
	nop								sq.xyzw		vf25,DST_XYZ-DST_NEXT(vi10)	; -,(遅)座標書き込み
	nop								b			tex0f_start					; 
	nop								sq.xyzw		vf26,DST_COL-DST_NEXT(vi10)	; -,(遅)カラー書き込み


; ----------------------------------------------------------------
; 光源計算＆ＵＶ補正
; ----------------------------------------------------------------
; 変換開始ルーチン
; カリング対応
CullFastTransMainStart:
	muly.w		vf23,vf00,vf01		ilw.x		vi08,PACKDAT(vi13)			; アルファ設定,頂点数取得
	nop								fcset		0							; クリップフラグ初期化
	nop								iaddiu		vi15,vi00,0					; クリップ処理フラグクリア
	nop								ilw.w		vi12,0x00(vi13)				; -,処理フラグ取得
	nop								iaddiu		vi09,vi13,DATA_OFT			; -,データ読み取りアドレス設定
	nop								iaddiu		vi10,vi13,PACK_TOP			; -,データ書き込みアドレス設定
	; エンベロープ頂点合成
	; バッファデータの実数化とその他の前処理
	nop								lq.xyzw		vf16,SRC_XYZW(vi09)			; -,頂点読み込み
	nop								lq.xyzw		vf17,BUF_NORM(vi09)			; -,法線読み込み
	nop								lq.xyzw		vf18,BUF_UV0(vi09)			; -,ＵＶ０読み込み
	nop								ilw.w		vi07,BUF_FLG(vi09)			; 
	nop								iaddiu		vi06,vi00,0x4000			; ＵＶ０実数化,
	nop								iadd		vi06,vi06,vi06				; vi06 = 0x8000
;	nop								iaddiu		vi04,vi06,0x4fff			; vi04 = 0xcfff
	nop								iaddiu		vi04,vi06,0x4000			; vi04 = 0xc000

	; 頂点変換処理（途中で次の頂点の情報を読み込んでおく）
	mulaw.xyz	ACC ,vf16,vf27		div			Q,vf00w,vf16w				; カリング,透視変換
	msubw.xyz	vf29,vf27,vf16		move.xyzw	vf27,vf16					; カリング,カリング
	mulax.xyz	ACC ,vf08,vf17		iaddiu		vi03,vi00,0x0030			; 光源計算,カリング
	madday.xyz	ACC ,vf09,vf17		nop										; 光源計算,
;	ftoi4.xyzw	vf25,vf22			nop										; (遅)整数化,-
;	ftoi0.xyzw	vf26,vf23			nop										; (遅)整数化,(遅)クリップ用保存
	maddz.xyz	vf20,vf10,vf17		iaddiu		vi09,vi09,BUF_NEXT			; 光源計算,読み込みアドレス増加
	opmula.xyz	ACC ,vf28,vf29		iaddiu		vi02,vi00,0x0020			; カリング,カリング
	opmsub.xyz	vf30,vf29,vf28		move.xyzw	vf28,vf29					; カリング,カリング
	itof12.xyz	vf18,vf18			nop										; ＵＶ,
	mulax.w		ACC ,vf16,vf11		nop										; フォグ,
	maddy.w		vf22,vf00,vf11		iand		vi05,vi07,vi06				; フォグ,キックフラグ

	maxx.xyz	vf20,vf20,vf00		mfir.w		vf31,vi05					; 光源計算,キックフラグ
	mulq.xyz	vf22,vf16,Q			isw.w		vi07,SRC_FLG-SRC_NEXT(vi09)	; 透視変換,キックフラグ
	mulq.xyz	vf24,vf18,Q			sq.xyz		vf18,SRC_UV0-SRC_NEXT(vi09)	; ＳＴＱ,クリップ用保存
	maxx.w		vf22,vf22,vf00		nop										; フォグ,(遅)座標書き込み
	itof4.w		vf31,vf31			nop										; フォグ,(遅)カラー書き込み
	mulax.xyz	ACC ,vf12,vf20		nop										; 光源計算,-
	madday.xyz	ACC ,vf13,vf20		sq.xyz		vf24,DST_UV0(vi10)			; 光源計算,ＵＶ書き込み
	minix.w		vf22,vf22,vf01		iaddiu		vi10,vi10,DST_NEXT			; フォグ,-
	maddaz.xyz	ACC ,vf14,vf20		iaddi		vi08,vi08,-1				; 光源計算,カウンタ減算
	maddw.xyz	vf23,vf15,vf00		lq.xyzw		vf16,SRC_XYZW(vi09)			; 光源計算,(先)座標読み込み
	mula.xyz	ACC ,vf22,vf02		lq.xyzw		vf17,BUF_NORM(vi09)			; 透視変換,(先)法線読み込み
	add.w		vf22,vf22,vf31		lq.xyzw		vf18,BUF_UV0(vi09)			; フォグ,(先)ＵＶ読み込み
	maddw.xyz	vf22,vf03,vf00		ibgtz		vi08,_CullFastTransLoop		; 透視変換,ループ
	minix.xyz	vf23,vf23,vf01		ilw.w		vi07,BUF_FLG(vi09)			; 光源計算,(先)フラグ読み込み

_CullFastTransLoop:
	; 頂点変換処理（途中で次の頂点の情報を読み込んでおく）
	mulaw.xyz	ACC ,vf16,vf27		div			Q,vf00w,vf16w				; カリング,透視変換
	msubw.xyz	vf29,vf27,vf16		move.xyzw	vf27,vf16					; カリング,カリング
	mulax.xyz	ACC ,vf08,vf17		iaddiu		vi03,vi00,0x0030			; 光源計算,カリング
	madday.xyz	ACC ,vf09,vf17		nop										; 光源計算,
	ftoi4.xyzw	vf25,vf22			nop										; (遅)整数化,-
	ftoi0.xyzw	vf26,vf23			sq.xyzw		vf23,SRC_COL-SRC_NEXT(vi09)	; (遅)整数化,(遅)クリップ用保存
	maddz.xyz	vf20,vf10,vf17		iaddiu		vi09,vi09,BUF_NEXT			; 光源計算,読み込みアドレス増加
	opmula.xyz	ACC ,vf28,vf29		iaddiu		vi02,vi00,0x0020			; カリング,カリング
	opmsub.xyz	vf30,vf29,vf28		move.xyzw	vf28,vf29					; カリング,カリング
	itof12.xyz	vf18,vf18			nop										; ＵＶ,
	mulax.w		ACC ,vf16,vf11		iand		vi03,vi03,vi07				; フォグ,カリング
	maddy.w		vf22,vf00,vf11		iand		vi05,vi07,vi06				; フォグ,キックフラグ
	nop								fmand		vi02,vi02					; -,カリング
	nop								ibne		vi02,vi03,0f				; -,カリング
	nop								nop										; -,カリング
	nop								ior			vi05,vi05,vi06				; -,カリング
0:	maxx.xyz	vf20,vf20,vf00		mfir.w		vf31,vi05					; 光源計算,キックフラグ
	mulq.xyz	vf22,vf16,Q			isw.w		vi07,SRC_FLG-SRC_NEXT(vi09)	; 透視変換,キックフラグ
	mulq.xyz	vf24,vf18,Q			sq.xyz		vf18,SRC_UV0-SRC_NEXT(vi09)	; ＳＴＱ,クリップ用保存
	maxx.w		vf22,vf22,vf00		sq.xyzw		vf25,DST_XYZ-DST_NEXT(vi10)	; フォグ,(遅)座標書き込み
	itof4.w		vf31,vf31			sq.xyzw		vf26,DST_COL-DST_NEXT(vi10)	; フォグ,(遅)カラー書き込み
	mulax.xyz	ACC ,vf12,vf20		nop										; 光源計算,-
	madday.xyz	ACC ,vf13,vf20		sq.xyz		vf24,DST_UV0(vi10)			; 光源計算,ＵＶ書き込み
	minix.w		vf22,vf22,vf01		iaddiu		vi10,vi10,DST_NEXT			; フォグ,-
	maddaz.xyz	ACC ,vf14,vf20		iaddi		vi08,vi08,-1				; 光源計算,カウンタ減算
	maddw.xyz	vf23,vf15,vf00		lq.xyzw		vf16,SRC_XYZW(vi09)			; 光源計算,(先)座標読み込み
	mula.xyz	ACC ,vf22,vf02		lq.xyzw		vf17,BUF_NORM(vi09)			; 透視変換,(先)法線読み込み
	add.w		vf22,vf22,vf31		lq.xyzw		vf18,BUF_UV0(vi09)			; フォグ,(先)ＵＶ読み込み
	maddw.xyz	vf22,vf03,vf00		ibgtz		vi08,_CullFastTransLoop		; 透視変換,ループ
	minix.xyz	vf23,vf23,vf01		ilw.w		vi07,BUF_FLG(vi09)			; 光源計算,(先)フラグ読み込み

	; 後始末
	nop								iaddiu		vi01,vi13,TX0_OFT			; -,テクスチャ設定
	nop								xgkick		vi01						; -,テクスチャ設定
	ftoi4.xyzw	vf25,vf22			nop										; (遅)整数化,
	ftoi0.xyzw	vf26,vf23			sq.xyzw		vf23,SRC_COL-SRC_NEXT(vi09)	; (遅)整数化,(遅)クリップ用保存
	nop								sq.xyzw		vf25,DST_XYZ-DST_NEXT(vi10)	; -,(遅)座標書き込み
	nop								b			tex0f_start					; 
	nop								sq.xyzw		vf26,DST_COL-DST_NEXT(vi10)	; -,(遅)カラー書き込み






; ================================================================
; テクスチャ０の描画
; ================================================================
tex0f_start:
	mula.xyz	ACC ,vf08,vf08		ilw.x		vi08,PACKDAT(vi13)			; 光源ベクトル正規化,GIFTAG書き込み
	madda.xyz	ACC ,vf09,vf09		lq.xyzw		vf12,GIFNORMAL(vi13)		; 光源ベクトル正規化,GIFTAG書き込み
	madd.xyz	vf11,vf10,vf10		iaddiu		vi01,vi00,0x4000			; 光源ベクトル正規化,GIFTAG書き込み
	nop								iadd		vi01,vi01,vi01				; GIFTAG書き込み
	nop								iadd		vi01,vi08,vi01				; GIFTAG書き込み
	nop								sq.yzw		vf12,WORK_TOP(vi13)			; GIFTAG書き込み
	nop								isw.x		vi01,WORK_TOP(vi13)			; GIFTAG書き込み
	nop								iaddiu		vi01,vi13,WORK_TOP			; キックアドレス設定
	nop								xgkick		vi01						; パケットの描画
	nop								rsqrt		Q,vf00w,vf11x				; 光源ベクトル正規化
tex0f_end:

; ================================================================
; バンプマッピング計算処理
; ================================================================
	nop								iaddiu		vi01,vi00,FLAG_BMAP			; -,バンプ使用フラグ
	nop								iand		vi01,vi12,vi01				; -,チェック
	nop								ilw.x		vi08,PACKDAT(vi13)			; -,頂点数取得
	nop								ibeq		vi01,vi00,BumpMappingEnd	; -,スキップ
	nop								iaddiu		vi09,vi13,DATA_OFT			; -,データ読み取りアドレス設定
	nop								iaddiu		vi10,vi13,PACK_TOP			; -,データ書き込みアドレス設定

	addw.z		vf22,vf00,vf00		lq.xyz		vf16,DST_UV0(vi10)			; Ｑ値読み込み
	nop								lq.xyz		vf17,SRC_UV1(vi09)			; ベースＵＶ取得
	nop								lq.xyz		vf13,SRC_UV2(vi09)			; Ｕ座標読み込み
	nop								lq.xyz		vf12,SRC_NORM(vi09)			; 法線読み込み
	mulq.x		vf08,vf08,Q			waitq									; 光源ベクトル正規化
	mulq.x		vf09,vf09,Q			nop										; 光源ベクトル正規化
	mulq.x		vf10,vf10,Q			nop										; 光源ベクトル正規化
	itof12.xyz	vf18,vf17			nop										; 
	opmula.xyz	ACC ,vf12,vf13		lq.xyzw		vf04,TX1_OFT+6(vi13)		; Ｖ座標生成,テクスチャ座標スケール取得
	opmsub.xyz	vf14,vf13,vf12		lq.xyzw		vf05,TX1_OFT+7(vi13)		; Ｖ座標生成,テクスチャ座標オフセット取得
.if 0
	nop								rsqrt		Q,vf00w,vf11y				; 光源ベクトル正規化
	mulq.y		vf08,vf08,Q			waitq									; 光源ベクトル正規化
	mulq.y		vf09,vf09,Q			nop										; 光源ベクトル正規化
	mulq.y		vf10,vf10,Q			nop										; 光源ベクトル正規化
	nop								rsqrt		Q,vf00w,vf11z				; 光源ベクトル正規化
	mulq.z		vf08,vf08,Q			waitq									; 光源ベクトル正規化
	mulq.z		vf09,vf09,Q			nop										; 光源ベクトル正規化
	mulq.z		vf10,vf10,Q			nop										; 光源ベクトル正規化
.endif

	mulax.xyz	ACC ,vf08,vf13		iaddiu		vi09,vi09,SRC_NEXT			; 光源内積Ｕ,読み込みアドレス加算
	madday.xyz	ACC ,vf09,vf13		iaddiu		vi10,vi10,DST_NEXT			; 光源内積Ｕ,書き込みアドレス加算
	maddz.xyz	vf19,vf10,vf13		lq.xyz		vf12,SRC_NORM(vi09)			; 光源内積Ｕ,(先)法線読み込み
	mulax.xyz	ACC ,vf08,vf14		lq.xyz		vf13,SRC_UV2(vi09)			; 光源内積Ｖ,(先)Ｕ座標読み込み
	madday.xyz	ACC ,vf09,vf14		iaddi		vi08,vi08,-1				; 光源内積Ｖ,カウンタ減算
	maddz.xyz	vf20,vf10,vf14		sq.xyz		vf18,SRC_UV1-SRC_NEXT(vi09)	; 光源内積Ｖ,クリップ用保存
;	mulz.xyz	vf23,vf22,vf21		nop										; (遅)ＳＴＱ２計算,(遅)クリップ用保存
	mulz.xyz	vf21,vf18,vf16		lq.xyz		vf16,DST_UV0(vi10)			; ＳＴＱ１計算,(先)Ｑ値読み込み
	opmula.xyz	ACC ,vf12,vf13		lq.xyz		vf17,SRC_UV1(vi09)			; (先)Ｖ座標生成,(先)ベースＵＶ読み込み
	opmsub.xyz	vf14,vf13,vf12		nop										; (先)Ｖ座標生成,-
;	nop								nop										;-,(遅)ＳＴＱ２格納
	mulax.x		ACC ,vf04,vf19		nop										; ＵＶ２補正,-
	mulax.y		ACC ,vf04,vf20		sq.xyz		vf21,DST_UV1-DST_NEXT(vi10)	; ＵＶ２補正,ＳＴＱ１格納
.if 1
 madday.x ACC ,vf04,vf19	nop
 maddaz.x ACC ,vf04,vf19	nop
 madday.y ACC ,vf04,vf20	nop
 maddaz.y ACC ,vf04,vf20	nop
.endif
	maddw.xy	vf22,vf18,vf00		ibgtz		vi08,bm_l00					; ＵＶ２補正,ループ
	itof12.xyz	vf18,vf17			nop										; (先)実数化,-

bm_l00:
	mulax.xyz	ACC ,vf08,vf13		iaddiu		vi09,vi09,SRC_NEXT			; 光源内積Ｕ,読み込みアドレス加算
	madday.xyz	ACC ,vf09,vf13		iaddiu		vi10,vi10,DST_NEXT			; 光源内積Ｕ,書き込みアドレス加算
	maddz.xyz	vf19,vf10,vf13		lq.xyz		vf12,SRC_NORM(vi09)			; 光源内積Ｕ,(先)法線読み込み
	mulax.xyz	ACC ,vf08,vf14		lq.xyz		vf13,SRC_UV2(vi09)			; 光源内積Ｖ,(先)Ｕ座標読み込み
	madday.xyz	ACC ,vf09,vf14		iaddi		vi08,vi08,-1				; 光源内積Ｖ,カウンタ減算
	maddz.xyz	vf20,vf10,vf14		sq.xyz		vf18,SRC_UV1-SRC_NEXT(vi09)	; 光源内積Ｖ,クリップ用保存
	mulz.xyz	vf23,vf22,vf21		sq.xyz		vf22,SRC_UV2-SRC_NEXT*2(vi09); (遅)ＳＴＱ２計算,(遅)クリップ用保存
	mulz.xyz	vf21,vf18,vf16		lq.xyz		vf16,DST_UV0(vi10)			; ＳＴＱ１計算,(先)Ｑ値読み込み
	opmula.xyz	ACC ,vf12,vf13		lq.xyz		vf17,SRC_UV1(vi09)			; (先)Ｖ座標生成,(先)ベースＵＶ読み込み
	opmsub.xyz	vf14,vf13,vf12		nop										; (先)Ｖ座標生成,-
	nop								sq.xyz		vf23,DST_UV2-DST_NEXT*2(vi10);-,(遅)ＳＴＱ２格納
	mulax.x		ACC ,vf04,vf19		nop										; ＵＶ２補正,-
	mulax.y		ACC ,vf04,vf20		sq.xyz		vf21,DST_UV1-DST_NEXT(vi10)	; ＵＶ２補正,ＳＴＱ１格納
.if 1
 madday.x ACC ,vf04,vf19	nop
 maddaz.x ACC ,vf04,vf19	nop
 madday.y ACC ,vf04,vf20	nop
 maddaz.y ACC ,vf04,vf20	nop
.endif
	maddw.xy	vf22,vf18,vf00		ibgtz		vi08,bm_l00					; ＵＶ２補正,ループ
	itof12.xyz	vf18,vf17			nop										; (先)実数化,-

	; 後始末
	nop								lq.xyzw		vf31,GIFREGS(vi13)			; GIFTAGレジスタリスト読み込み
	nop								iaddiu		vi01,vi00,0x0029			; テクスチャ設定( 1, 2, 2, 0 )
	nop								iaddiu		vi02,vi00,0x0040			; テクスチャ設定(64)
	mulz.xyz	vf23,vf22,vf21		sq.xyz		vf22,SRC_UV2-SRC_NEXT(vi09)	; (遅)ＳＴＱ２計算,(遅)クリップ用保存
	nop								isw.x		vi01,TX1_OFT+4(vi13)		; テクスチャ設定書き込み
	nop								isw.y		vi02,TX1_OFT+4(vi13)		; テクスチャ設定書き込み
	nop								iaddiu		vi01,vi13,TX1_OFT			; -,テクスチャ設定
	nop								sq.xyz		vf23,DST_UV2-DST_NEXT(vi10)	;-,(遅)ＳＴＱ２格納
	nop								xgkick		vi01						; -,テクスチャ設定（＆XGKICKウェイト）

	; GIFTAGは既に書き込まれている為いきなり転送
	nop								iaddiu		vi01,vi13,WORK_TOP			; 
	nop								sq.z		vf31,0x00(vi01)				; 
	nop								xgkick		vi01						; 

	nop								lq.xyzw		vf16,TX1_OFT+0(vi13)		; 
	nop								lq.xyzw		vf17,TX1_OFT+1(vi13)		; 
	nop								lq.xyzw		vf18,TX1_OFT+2(vi13)		; 
	nop								lq.xyzw		vf19,TX1_OFT+3(vi13)		; 
	nop								lq.xyzw		vf20,TX1_OFT+4(vi13)		; 
	nop								lq.xyzw		vf21,TX1_OFT+5(vi13)		; 
	nop								sq.xyzw		vf16,TX2_OFT+0(vi13)		; 
	nop								sq.xyzw		vf17,TX2_OFT+1(vi13)		; 
	nop								sq.xyzw		vf18,TX2_OFT+2(vi13)		; 
	nop								sq.xyzw		vf19,TX2_OFT+3(vi13)		; 
	nop								sq.xyzw		vf20,TX2_OFT+4(vi13)		; 
	nop								sq.xyzw		vf21,TX2_OFT+5(vi13)		; 

	nop								iaddiu		vi01,vi00,0x00a1			; テクスチャ設定( 1, 0, 2, 2 )
	nop								iaddiu		vi02,vi00,0x00ff			; テクスチャ設定(255)
	nop								isw.x		vi01,TX2_OFT+4(vi13)		; テクスチャ設定書き込み
	nop								isw.y		vi02,TX2_OFT+4(vi13)		; テクスチャ設定書き込み
	nop								iaddiu		vi01,vi13,TX2_OFT			; -,テクスチャ設定
	nop								xgkick		vi01						; -,テクスチャ設定（＆XGKICKウェイト）
	nop								mr32.xyzw	vf31,vf31					; GIFTAGレジスタリストシフト
	nop								iaddiu		vi01,vi13,WORK_TOP			; 
	nop								sq.z		vf31,0x00(vi01)				; 
	nop								xgkick		vi01						; 
	nop								iaddiu		vi02,vi00,FLAG_TEX1|FLAG_TEX2	; 
	nop								b			PolygonClippStart			; 
	nop								ior			vi12,vi12,vi02				; 
BumpMappingEnd:

; ================================================================
; ２枚目テクスチャ描画処理
; ================================================================
tex1f_start:
	nop								lq.xyzw		vf31,GIFREGS(vi13)			; GIFTAGレジスタリスト読み込み
	nop								iaddiu		vi01,vi00,FLAG_TEX1			; -,テクスチャ１使用フラグ
	nop								iand		vi01,vi12,vi01				; -,チェック
	nop								ilw.x		vi08,PACKDAT(vi13)			; -,頂点数取得
	nop								ibeq		vi01,vi00,tex1f_end			; -,スキップ
	nop								iaddiu		vi09,vi13,DATA_OFT			; -,データ読み取りアドレス設定
	nop								iaddiu		vi10,vi13,PACK_TOP			; -,データ書き込みアドレス設定

	; テクスチャ座標をＳＴＱに変換する
	; 先行読み込み
	nop								lq.xyz		vf17,BUF_UV1(vi09)			; -,(先)ＵＶ値の読み込み
	itof12.xyz	vf18,vf17			iaddiu		vi09,vi09,SRC_NEXT			; (先)ＵＶ,(先)読み込みアドレス加算
	; 最初の１回
	nop								lq.z		vf20,DST_UV0(vi10)			; -,Ｑ値の読み込み
	nop								lq.xyz		vf17,BUF_UV1(vi09)			; -,(先)ＵＶ値の読み込み
	nop								sq.xyz		vf18,SRC_UV1-SRC_NEXT(vi09)	; -,クリップ用保存
;	nop								nop										; -,(遅)ＳＴＱ格納
	nop								iaddi		vi08,vi08,-1				; -,カウンタ減算
	mulz.xyz	vf19,vf18,vf20		iaddiu		vi09,vi09,SRC_NEXT			; ＳＴＱ計算,(先)読み込みアドレス加算
	itof12.xyz	vf18,vf17			ibgtz		vi08,t1f_l00				; (先)ＵＶ,ループ
	nop								nop										; -,(遅)書き込みアドレス加算
	; ２回目以降
t1f_l00:
	nop								lq.z		vf20,DST_UV0+DST_NEXT(vi10)	; -,Ｑ値の読み込み
	nop								lq.xyz		vf17,BUF_UV1(vi09)			; -,(先)ＵＶ値の読み込み
	nop								sq.xyz		vf18,SRC_UV1-SRC_NEXT(vi09)	; -,クリップ用保存
	nop								sq.xyz		vf19,DST_UV1(vi10)			; -,(遅)ＳＴＱ格納
	nop								iaddi		vi08,vi08,-1				; -,カウンタ減算
	mulz.xyz	vf19,vf18,vf20		iaddiu		vi09,vi09,SRC_NEXT			; ＳＴＱ計算,(先)読み込みアドレス加算
	itof12.xyz	vf18,vf17			ibgtz		vi08,t1f_l00				; (先)ＵＶ,ループ
	nop								iaddiu		vi10,vi10,DST_NEXT			; -,(遅)書き込みアドレス加算
	; 後始末
	nop								sq.xyz		vf19,DST_UV1(vi10)			; -,(遅)ＳＴＱ格納

	; テクスチャ設定
	nop								iaddiu		vi01,vi13,TX1_OFT			; -,テクスチャ設定
	nop								xgkick		vi01						; -,テクスチャ設定（＆XGKICKウェイト）
	; GIFTAGは既に書き込まれている為いきなり転送
	nop								iaddiu		vi01,vi13,WORK_TOP			; 
	nop								sq.z		vf31,0x00(vi01)				; 
	nop								xgkick		vi01						; 
	nop								nop										; 
tex1f_end:


; ================================================================
; ３枚目テクスチャ描画処理
; ================================================================
tex2f_start:
	nop								mr32.xyzw	vf31,vf31					; GIFTAGレジスタリストシフト
	nop								iaddiu		vi01,vi00,FLAG_UV2			; -,テクスチャ１使用フラグ
	nop								iand		vi01,vi12,vi01				; -,チェック
	nop								ilw.x		vi08,PACKDAT(vi13)			; -,頂点数取得
	nop								ibeq		vi01,vi00,tex2f_end			; -,スキップ
	nop								iaddiu		vi09,vi13,DATA_OFT			; -,データ読み取りアドレス設定
	nop								iaddiu		vi10,vi13,PACK_TOP			; -,データ書き込みアドレス設定

	; テクスチャ座標をＳＴＱに変換する
	; 先行読み込み
	nop								lq.xyz		vf17,BUF_UV2(vi09)			; -,(先)ＵＶ値の読み込み
	itof12.xyz	vf18,vf17			iaddiu		vi09,vi09,SRC_NEXT			; (先)ＵＶ,(先)読み込みアドレス加算
	; 最初の１回
	nop								lq.z		vf20,DST_UV0(vi10)			; -,Ｑ値の読み込み
	nop								lq.xyz		vf17,BUF_UV2(vi09)			; -,(先)ＵＶ値の読み込み
	nop								sq.xyz		vf18,SRC_UV2-SRC_NEXT(vi09)	; -,クリップ用保存
;	nop								nop										; -,(遅)ＳＴＱ格納
	nop								iaddi		vi08,vi08,-1				; -,カウンタ減算
	mulz.xyz	vf19,vf18,vf20		iaddiu		vi09,vi09,SRC_NEXT			; ＳＴＱ計算,(先)読み込みアドレス加算
	itof12.xyz	vf18,vf17			ibgtz		vi08,t2f_l00				; (先)ＵＶ,ループ
	nop								nop										; -,(遅)書き込みアドレス加算
	; ２回目以降
t2f_l00:
	nop								lq.z		vf20,DST_UV0+DST_NEXT(vi10)	; -,Ｑ値の読み込み
	nop								lq.xyz		vf17,BUF_UV2(vi09)			; -,(先)ＵＶ値の読み込み
	nop								sq.xyz		vf18,SRC_UV2-SRC_NEXT(vi09)	; -,クリップ用保存
	nop								sq.xyz		vf19,DST_UV2(vi10)			; -,(遅)ＳＴＱ格納
	nop								iaddi		vi08,vi08,-1				; -,カウンタ減算
	mulz.xyz	vf19,vf18,vf20		iaddiu		vi09,vi09,SRC_NEXT			; ＳＴＱ計算,(先)読み込みアドレス加算
	itof12.xyz	vf18,vf17			ibgtz		vi08,t2f_l00				; (先)ＵＶ,ループ
	nop								iaddiu		vi10,vi10,DST_NEXT			; -,(遅)書き込みアドレス加算
	; 後始末
	nop								sq.xyz		vf19,DST_UV1(vi10)			; -,(遅)ＳＴＱ格納

	; テクスチャ設定
	nop								iaddiu		vi01,vi13,TX2_OFT			; -,テクスチャ設定
	nop								xgkick		vi01						; -,テクスチャ設定（＆XGKICKウェイト）
	; GIFTAGは既に書き込まれている為いきなり転送
	nop								iaddiu		vi01,vi13,WORK_TOP			; 
	nop								sq.z		vf31,0x00(vi01)				; 
	nop								xgkick		vi01						; 
	nop								nop										; 
tex2f_end:


; ================================================================
; シャドウ（アニメシェード）マッピング描画処理
; ================================================================
ShadowMappingStart:
;	nop								mr32.xyzw	vf31,vf31					; GIFTAGレジスタリストシフト
	nop								iaddiu		vi01,vi00,FLAG_SMAP			; -,テクスチャ１使用フラグ
	nop								iand		vi01,vi12,vi01				; -,チェック
	nop								ilw.x		vi08,PACKDAT(vi13)			; -,頂点数取得
	nop								ibeq		vi01,vi00,ShadowMappingEnd	; -,スキップ
	nop								iaddiu		vi09,vi13,DATA_OFT			; -,データ読み取りアドレス設定
	nop								iaddiu		vi10,vi13,PACK_TOP			; -,データ書き込みアドレス設定

	nop								lq.xyzw		vf04,TX2_OFT+6(vi13)		; テクスチャ座標スケール取得
	nop								lq.xyzw		vf05,TX2_OFT+7(vi13)		; テクスチャ座標オフセット取得
	nop								lq.xzw		vf12,M_LIT0(vi00)			; ライトマトリクス取得
	mulx.y		vf12,vf00,vf00		lq.xzw		vf13,M_LIT1(vi00)			; ライトマトリクス取得
	mulx.y		vf13,vf00,vf00		lq.xzw		vf14,M_LIT2(vi00)			; ライトマトリクス取得
	mulx.y		vf14,vf00,vf00		lq.xyzw		vf16,SRC_NORM(vi09)			; 法線読み込み
	mula.x		ACC ,vf12,vf12		mr32.z		vf18,vf00					; Ｑに１を設定しておく
	madda.x		ACC ,vf13,vf13		nop										; 
	madd.x		vf15,vf14,vf14		nop										; 
	nop								rsqrt		Q,vf00w,vf15x				; 
	mulq.x		vf12,vf12,Q			waitq									; 
	mulq.x		vf13,vf13,Q			b			em_l01						; 以降は環境マッピングルーチンと同じ
	mulq.x		vf14,vf14,Q			nop										; 
ShadowMappingEnd:


; ================================================================
; 環境マッピング描画処理
; ================================================================
EnvironmentMappingStart:
;	nop								mr32.xyzw	vf31,vf31					; GIFTAGレジスタリストシフト
	nop								iaddiu		vi01,vi00,FLAG_EMAP			; -,テクスチャ１使用フラグ
	nop								iand		vi01,vi12,vi01				; -,チェック
	nop								ilw.x		vi08,PACKDAT(vi13)			; -,頂点数取得
	nop								ibeq		vi01,vi00,EnvironmentMappingEnd	; -,スキップ
	nop								iaddiu		vi09,vi13,DATA_OFT			; -,データ読み取りアドレス設定
	nop								iaddiu		vi10,vi13,PACK_TOP			; -,データ書き込みアドレス設定

	nop								lq.xyzw		vf04,TX2_OFT+6(vi13)		; テクスチャ座標スケール取得
	nop								lq.xyzw		vf05,TX2_OFT+7(vi13)		; テクスチャ座標オフセット取得
	nop								lq.xyzw		vf12,M_OPT0+0x00(vi0)		; 逆カメラマトリクス取得
	nop								lq.xyzw		vf13,M_OPT0+0x01(vi0)		; 逆カメラマトリクス取得
	nop								lq.xyzw		vf14,M_OPT0+0x02(vi0)		; 逆カメラマトリクス取得
	nop								lq.xyzw		vf16,SRC_NORM(vi09)			; 法線読み込み
	nop								mr32.z		vf18,vf00					; Ｑに１を設定しておく
em_l01:
	; テクスチャ座標をＳＴＱに変換する
	; 最初の１回
;	nop								nop										; (遅)ＵＶ算出,(遅)(遅)ＳＴＱ格納
;	nop								nop										; (遅)ＵＶ算出,(遅)(遅)クリップ用保存
	mulax.xyz	ACC ,vf12,vf16		iaddi		vi08,vi08,-1				; 法線変換,カウンタ減算
	madday.xyz	ACC ,vf13,vf16		iaddiu		vi09,vi09,SRC_NEXT			; 法線変換,読み込みアドレス加算
	maddz.xyz	vf17,vf14,vf16		lq.xyzw		vf16,SRC_NORM(vi09)			; 法線変換,(先)法線読み込み
	nop								lq.z		vf20,DST_UV0(vi10)			; (遅)Ｑ補正,(先)Ｑ値の読み込み
;	nop								nop										; -,ループ
;	nop								nop										; -,(遅)書き込みアドレス加算
	; ２回目
	mula.xyz	ACC ,vf17,vf04		nop										; (遅)ＵＶ算出,(遅)(遅)ＳＴＱ格納
	maddw.xy	vf18,vf05,vf00		nop										; (遅)ＵＶ算出,(遅)(遅)クリップ用保存
	mulax.xyz	ACC ,vf12,vf16		iaddi		vi08,vi08,-1				; 法線変換,カウンタ減算
	madday.xyz	ACC ,vf13,vf16		iaddiu		vi09,vi09,SRC_NEXT			; 法線変換,読み込みアドレス加算
	maddz.xyz	vf17,vf14,vf16		lq.xyzw		vf16,SRC_NORM(vi09)			; 法線変換,(先)法線読み込み
	mulz.xyz	vf19,vf18,vf20		lq.z		vf20,DST_UV0+DST_NEXT(vi10)	; (遅)Ｑ補正,(先)Ｑ値の読み込み
;	nop								nop										; -,ループ
;	nop								nop										; -,(遅)書き込みアドレス加算
	; ３回目以降
em_l00:
	mula.xyz	ACC ,vf17,vf04		sq.xyz		vf18,SRC_UV2-SRC_NEXT*2(vi09)	; (遅)ＵＶ算出,(遅)(遅)ＳＴＱ格納
	maddw.xy	vf18,vf05,vf00		sq.xyz		vf19,DST_UV2(vi10)			; (遅)ＵＶ算出,(遅)(遅)クリップ用保存
	mulax.xyz	ACC ,vf12,vf16		iaddi		vi08,vi08,-1				; 法線変換,カウンタ減算
	madday.xyz	ACC ,vf13,vf16		iaddiu		vi09,vi09,SRC_NEXT			; 法線変換,読み込みアドレス加算
	maddz.xyz	vf17,vf14,vf16		lq.xyzw		vf16,SRC_NORM(vi09)			; 法線変換,(先)法線読み込み
	mulz.xyz	vf19,vf18,vf20		lq.z		vf20,DST_UV0+DST_NEXT*2(vi10)	; (遅)Ｑ補正,(先)Ｑ値の読み込み
	nop								ibgtz		vi08,em_l00					; -,ループ
	nop								iaddiu		vi10,vi10,DST_NEXT			; -,(遅)書き込みアドレス加算
	; 最後の書き込み
	mula.xyz	ACC ,vf17,vf04		sq.xyz		vf18,SRC_UV2-SRC_NEXT*2(vi09)	; (遅)ＵＶ算出,(遅)(遅)ＳＴＱ格納
	maddw.xy	vf18,vf05,vf00		sq.xyz		vf19,DST_UV2(vi10)			; (遅)ＵＶ算出,(遅)(遅)クリップ用保存
;	nop								nop										; 法線変換,カウンタ減算
;	nop								nop										; 法線変換,読み込みアドレス加算
;	nop								nop										; 法線変換,(先)法線読み込み
	mulz.xyz	vf19,vf18,vf20		nop										; (遅)Ｑ補正,(先)Ｑ値の読み込み
;	nop								nop										; -,ループ
	nop								iaddiu		vi10,vi10,DST_NEXT			; -,(遅)書き込みアドレス加算

	nop								sq.xyz		vf18,SRC_UV2-SRC_NEXT*1(vi09)	; (遅)ＵＶ算出,(遅)(遅)ＳＴＱ格納
	nop								sq.xyz		vf19,DST_UV2(vi10)			; (遅)ＵＶ算出,(遅)(遅)クリップ用保存
;	nop								nop										; 法線変換,カウンタ減算
;	nop								nop										; 法線変換,読み込みアドレス加算
;	nop								nop										; 法線変換,(先)法線読み込み
;	nop								nop										; (遅)Ｑ補正,(先)Ｑ値の読み込み
;	nop								nop										; -,ループ
;	nop								nop										; -,(遅)書き込みアドレス加算

	; テクスチャ設定
	nop								iaddiu		vi01,vi13,TX2_OFT	; -,テクスチャ設定
	nop								xgkick		vi01				; -,テクスチャ設定（＆XGKICKウェイト）
	; GIFTAGは既に書き込まれている為いきなり転送
	nop								iaddiu		vi01,vi13,WORK_TOP	; 
	nop								sq.z		vf31,0x00(vi01)		; 
	nop								xgkick		vi01				; 
	nop								nop								; 
EnvironmentMappingEnd:

.if 0
