	; 色補正処理ＲＧＢＡにＷを乗算する
CorrectColor:
	nop								iaddiu		vi04,vi02,0			; 処理用の頂点数設定
	nop								fcset		0					; 
	nop								lq.xyzw		vf04,DST_XYZ+DST_NEXT*0(vi10)	; 
	nop								lq.xyzw		vf20,DST_COL+DST_NEXT*0(vi10)	;
	nop								lq.xyzw		vf21,DST_COL+DST_NEXT*1(vi10)	;
	nop								lq.xyzw		vf22,DST_COL+DST_NEXT*2(vi10)	;
	nop								lq.xyzw		vf23,DST_COL+DST_NEXT*3(vi10)	;
	nop								ibeq		vi04,vi00,clr_corrc_end0 ;
	nop								iaddi		vi04,vi04,-1			; 
	mulw.xyzw	vf20,vf20,vf04		lq.xyzw		vf05,DST_XYZ+DST_NEXT*1(vi10)	; 
	clipw.xyz	vf04,vf04			ibeq		vi04,vi00,clr_corrc_end1 ;
	nop								iaddi		vi04,vi04,-1			; 
	mulw.xyzw	vf21,vf21,vf05		lq.xyzw		vf06,DST_XYZ+DST_NEXT*2(vi10)	; 
	clipw.xyz	vf05,vf05			ibeq		vi04,vi00,clr_corrc_end2 ;
	nop								iaddi		vi04,vi04,-1			; 
	mulw.xyzw	vf22,vf22,vf06		lq.xyzw		vf07,DST_XYZ+DST_NEXT*3(vi10)	; 
	clipw.xyz	vf06,vf06			ibeq		vi04,vi00,clr_corrc_end3 ;
	nop								iaddi		vi04,vi04,-1			; 
	mulw.xyzw	vf23,vf23,vf07		b			clr_corrc_end4		;
	clipw.xyz	vf07,vf07			nop								; 

clr_corrc_end0:
	nop								move.xyzw	vf04,vf00			; 
clr_corrc_end1:
	nop								move.xyzw	vf05,vf00			; 
clr_corrc_end2:
	nop								move.xyzw	vf06,vf00			; 
clr_corrc_end3:
	nop								move.xyzw	vf07,vf00			; 
clr_corrc_end4:
	nop								sq.xyzw		vf20,DST_COL+DST_NEXT*0(vi10)	;
	nop								sq.xyzw		vf21,DST_COL+DST_NEXT*1(vi10)	;
	nop								sq.xyzw		vf22,DST_COL+DST_NEXT*2(vi10)	;
	nop								jr			vi15				; 
	nop								sq.xyzw		vf23,DST_COL+DST_NEXT*3(vi10)	;




; ****************************************************************
; 実験ルーチン
; ****************************************************************

; ================================================================
; 通常レジスタ割り当て
; ================================================================
;	vf00:fix
;	vf01:定数読み込みベクトル
;	vf02:プリミティブ座標変換スケール
;	vf03:プリミティブ座標変換オフセット
;	vf04:エンベロープマトリクス
;	vf05:エンベロープマトリクス
;	vf06:エンベロープマトリクス
;	vf07:エンベロープマトリクス
;	vf08:透視変換マトリクス
;	vf09:透視変換マトリクス
;	vf10:透視変換マトリクス
;	vf11:透視変換マトリクス
;	vf12:逆エンベロープマトリクス（回転成分のみ有効）
;	vf13:逆エンベロープマトリクス（回転成分のみ有効）
;	vf14:逆エンベロープマトリクス（回転成分のみ有効）
;	vf15:Ｕ座標基準ベクトル
;	vf16:頂点読み込み
;	vf17:法線読み込み
;	vf18:バンプ光線ベクトル計算テンポラリ
;	vf19:バンプ光線ベクトル合計
;	vf20:正規化後バンプ光線ベクトル
;	vf21:ウェイト値読み込み
;	vf22:ウェイト値読み込み
;	vf24:頂点ウェイト計算テンポラリ＆ＳＴＱ値計算用テンポラリ
;	vf25:法線ウェイト計算テンポラリ＆Ｑ値保存用テンポラリ
;	vf26:頂点合計
;	vf27:法線合計
;	vf28:法線記憶用１
;	vf29:法線記憶用２

;	vi00:０
;	vi01:条件判断又はテンポラリ
;	vi03:
;	vi06:マトリクス数カウント用
;	vi07:キックフラグ読み込み用
;	vi08:頂点数
;	vi09:読み込みデータアドレス
;	vi10:書き込みデータアドレス
;	vi11:エンベロープマトリクス読み取りアドレス
;	vi12:処理フラグ記憶用
;	vi13:バッファ先頭アドレス
;	vi15:リンクレジスタ＆クリップ処理チェックフラグ

; ================================================================
; 描画セットアップ処理
; ================================================================
;	upper		.					lower		.
StartMultiWeightDrawBump:
;	nop								xtop		vi13				; -,データアドレス取得
;	nop								lq.xyzw		vf01,FV_PRM(vi00)	; -,各種定数読み込み
;	nop								lq.xyzw		vf08,M_PRS0(vi00)	; -,透視変換マトリクス読み込み
;	nop								lq.xyzw		vf09,M_PRS1(vi00)	; -,透視変換マトリクス読み込み
;	nop								lq.xyzw		vf10,M_PRS2(vi00)	; -,透視変換マトリクス読み込み
;	nop								lq.xyzw		vf11,M_PRS3(vi00)	; -,透視変換マトリクス読み込み
;	nop								lq.xyzw		vf02,FV_SCN(vi00)	; -,フォグパラメータ読み込み
;	nop								lq.xyzw		vf03,FV_OFT(vi00)	; -,フォグパラメータ読み込み
	nop								ilw.x		vi08,PACKDAT(vi13)	; -,頂点数取得
	nop								iaddiu		vi01,vi00,1			; -,マトリクス数チェック（追加）
	nop								iaddiu		vi09,vi13,DATA_OFT	; -,データ読み取りアドレス設定
	nop								iaddiu		vi10,vi13,DATA_OFT	; -,データ書き込みアドレス設定
	nop								ibeq		vi06,vi01,StartOneWeightDrawBump	;（追加）

; ----------------------------------------------------------------
; マルチウェイトエンベロープ合成＆透視変換処理
; ----------------------------------------------------------------
	; エンベロープ頂点合成
	; バッファデータの実数化とその他の前処理
	nop								loi			0.0078125			; =1.0f/128.0f
	nop								ilw.x		vi11,BUF_IDX(vi09)	; -,マトリクスインデックス読み込み
	nop								ilw.y		vi05,BUF_IDX(vi09)	; -,次のM-INDEX読み込み
	nop								lq.xyzw		vf21,BUF_WT0(vi09)	; -,重み読み込み
	nop								lq.xyzw		vf16,BUF_VERT(vi09)	; -,頂点読み込み
	nop								lq.xyzw		vf17,BUF_NORM(vi09)	; -,法線読み込み
	nop								lq.xyzw		vf15,BUF_UV2(vi09)	; -,Ｕベクトル読み込み
	nop								iaddiu		vi03,vi13,CWORK2	; -,逆回転マトリクスアドレス設定
	nop								ilw.z		vi06,PACKDAT(vi13)	; ,マトリクス数取得
	itof0.xyzw	vf21,vf21			iaddiu		vi11,vi11,M_MAT0	; 重み実数化,マトリクスアドレス設定
	itof4.xyz	vf16,vf16			lq.xyzw		vf04,0x00(vi11)		; 頂点実数化,最初のマトリクス読み込み
	itof12.xyz	vf17,vf17			lq.xyzw		vf05,0x01(vi11)		; 法線実数化,最初のマトリクス読み込み
	nop								lq.xyzw		vf06,0x02(vi11)		; ,最初のマトリクス読み込み
	muli.xyzw	vf21,vf21,I			lq.xyzw		vf07,0x03(vi11)		; 重み実数化,最初のマトリクス読み込み
	itof12.xyz	vf15,vf15			nop								; Ｕ実数化,-

; 最初の１頂点目
	; 第１マトリクス計算（無条件にウェイトを考慮せず計算する）
	mulax.xyzw	ACC ,vf04,vf16		iaddi		vi06,vi06,-1		; 頂点計算,マトリクス数減算
	madday.xyzw	ACC ,vf05,vf16		iaddiu		vi09,vi09,BUF_NEXT	; 頂点計算,読み込みアドレス増加
	maddaz.xyzw	ACC ,vf06,vf16		iaddiu		vi11,vi05,M_MAT0	; 頂点計算,マトリクスアドレス設定
	maddw.xyzw	vf26,vf07,vf00		lq.xyzw		vf07,0x03(vi11)		; 頂点計算,次のマトリクス読み込み
	mulax.xyzw	ACC ,vf04,vf17		nop								; 法線計算,
	madday.xyzw	ACC ,vf05,vf17		nop								; 法線計算,
	maddz.xyzw	vf27,vf06,vf17		nop								; 法線計算,
	mulax.xyz	ACC ,vf04,vf15		lq.xyzw		vf04,0x00(vi11)		; Ｕ座標計算,次のマトリクス読み込み
	madday.xyz	ACC ,vf05,vf15		lq.xyzw		vf05,0x01(vi11)		; Ｕ座標計算,次のマトリクス読み込み
	maddz.xyz	vf19,vf06,vf15		lq.xyzw		vf06,0x02(vi11)		; Ｕ座標計算,次のマトリクス読み込み
	nop								ilw.z		vi05,BUF_IDX-BUF_NEXT(vi09)	; -,次のマトリクスインデックス読み込み

	; 第２マトリクス計算（他と少し違うので注意！）
	mulax.xyzw	ACC ,vf04,vf16		iblez		vi06,FirstWConvertBumpEnd	; 頂点計算,計算終了
	madday.xyzw	ACC ,vf05,vf16		nop								; 頂点計算,ＵＶ２保存
	maddaz.xyzw	ACC ,vf06,vf16		iaddiu		vi11,vi05,M_MAT0	; 頂点計算,マトリクスアドレス設定
	maddw.xyzw	vf24,vf07,vf00		lq.xyzw		vf07,0x03(vi11)		; 頂点計算,次のマトリクス読み込み
	mulax.xyzw	ACC ,vf04,vf17		nop								; 法線計算,
	madday.xyzw	ACC ,vf05,vf17		nop								; 法線計算,
	maddz.xyzw	vf25,vf06,vf17		nop								; 法線計算,
	mulax.xyz	ACC ,vf04,vf15		lq.xyzw		vf04,0x00(vi11)		; Ｕ座標計算,次のマトリクス読み込み
	madday.xyz	ACC ,vf05,vf15		lq.xyzw		vf05,0x01(vi11)		; Ｕ座標計算,次のマトリクス読み込み
	maddz.xyz	vf18,vf06,vf15		lq.xyzw		vf06,0x02(vi11)		; Ｕ座標計算,次のマトリクス読み込み
	mulax.xyzw	ACC ,vf26,vf21		iaddi		vi06,vi06,-1		; 頂点合計加算,マトリクス数減算
	maddy.xyzw	vf26,vf24,vf21		ilw.w		vi05,BUF_IDX-BUF_NEXT(vi09)	; 頂点合計加算,次のマトリクスインデックス
	mulax.xyzw	ACC ,vf27,vf21		nop								; 頂点合計加算,-
	maddy.xyzw	vf27,vf25,vf21		nop								; 頂点合計加算,-
	mulax.xyzw	ACC ,vf19,vf21		iblez		vi06,FirstWConvertBumpEnd	; 光線計算,計算終了
	maddy.xyzw	vf19,vf18,vf21		nop								; 光線計算,-

	; 第３マトリクス計算（以下、基本的に繰り返し）
	mulax.xyzw	ACC ,vf04,vf16		nop								; 頂点計算,-
	madday.xyzw	ACC ,vf05,vf16		nop								; 頂点計算,-
	maddaz.xyzw	ACC ,vf06,vf16		iaddiu		vi11,vi05,M_MAT0	; 頂点計算,マトリクスアドレス設定
	maddw.xyzw	vf24,vf07,vf00		lq.xyzw		vf07,0x03(vi11)		; 頂点計算,次のマトリクス読み込み
	mulax.xyzw	ACC ,vf04,vf17		nop								; 法線計算,
	madday.xyzw	ACC ,vf05,vf17		nop								; 法線計算,
	maddz.xyzw	vf25,vf06,vf17		nop								; 法線計算,
	mulax.xyz	ACC ,vf04,vf15		lq.xyzw		vf04,0x00(vi11)		; Ｕ座標計算,次のマトリクス読み込み
	madday.xyz	ACC ,vf05,vf15		lq.xyzw		vf05,0x01(vi11)		; Ｕ座標計算,次のマトリクス読み込み
	maddz.xyz	vf18,vf06,vf15		lq.xyzw		vf06,0x02(vi11)		; Ｕ座標計算,次のマトリクス読み込み
	addax.xyzw	ACC ,vf26,vf00		iaddi		vi06,vi06,-1		; 頂点合計加算,マトリクス数減算
	maddz.xyzw	vf26,vf24,vf21		nop								; 頂点合計加算,-
	addax.xyzw	ACC ,vf27,vf00		nop								; 頂点合計加算,-
	maddz.xyzw	vf27,vf25,vf21		nop								; 頂点合計加算,-
	addax.xyzw	ACC ,vf19,vf00		iblez		vi06,FirstWConvertBumpEnd	; 光線計算,計算終了
	maddz.xyzw	vf19,vf18,vf21		nop								; 光線計算,-
	; 第４マトリクス計算
	mulax.xyzw	ACC ,vf04,vf16		nop								; 頂点計算,-
	madday.xyzw	ACC ,vf05,vf16		nop								; 頂点計算,-
	maddaz.xyzw	ACC ,vf06,vf16		nop								; 頂点計算,-
	maddw.xyzw	vf24,vf07,vf00		nop								; 頂点計算,次のマトリクス読み込み
	mulax.xyzw	ACC ,vf04,vf17		nop								; 法線計算,
	madday.xyzw	ACC ,vf05,vf17		nop								; 法線計算,
	maddz.xyzw	vf25,vf06,vf17		nop								; 法線計算,
	mulax.xyz	ACC ,vf04,vf15		nop								; Ｕ座標計算,次のマトリクス読み込み
	madday.xyz	ACC ,vf05,vf15		nop								; Ｕ座標計算,次のマトリクス読み込み
	maddz.xyz	vf18,vf06,vf15		nop								; Ｕ座標計算,次のマトリクス読み込み
	addax.xyzw	ACC ,vf26,vf00		iaddi		vi06,vi06,-1		; 頂点合計加算,マトリクス数減算
	maddw.xyzw	vf26,vf24,vf21		nop								; 頂点合計加算,-
	addax.xyzw	ACC ,vf27,vf00		nop								; 頂点合計加算,-
	maddw.xyzw	vf27,vf25,vf21		nop								; 頂点合計加算,-
	addax.xyzw	ACC ,vf19,vf00		iblez		vi06,FirstWConvertBumpEnd	; 光線計算,計算終了
	maddw.xyzw	vf19,vf18,vf21		nop								; 光線計算,-
FirstWConvertBumpEnd:; エンベロープ計算終了

	nop								ilw.y		vi05,BUF_IDX(vi09)			; -,(遅)法線正規化(23cycle)
	mulax.xyzw	ACC ,vf08,vf26		ilw.x		vi11,BUF_IDX(vi09)			; 透視変換,(遅)法線正規化(24cycle)
	madday.xyzw	ACC ,vf09,vf26		lq.xyzw		vf21,BUF_WT0(vi09)			; 透視変換,重み読み込み
	maddaz.xyzw	ACC ,vf10,vf26		erleng		P,vf27						; 透視変換,法線正規化(0cycle)
	maddw.xyzw	vf26,vf11,vf00		iaddiu		vi11,vi11,M_MAT0			; 透視変換,マトリクスアドレス設定
	nop								lq.xyzw		vf16,BUF_VERT(vi09)			; (遅)法線正規化,頂点読み込み
	itof0.xyzw	vf21,vf21			lq.xyzw		vf17,BUF_NORM(vi09)			; 重み実数化,法線読み込み
	nop								lq.xyz		vf15,BUF_UV2(vi09)			; -,Ｕ座標読み込み
	nop								ilw.z		vi06,PACKDAT(vi13)			; (遅)Ｕ座標,マトリクス数取得
	nop								move.xyzw	vf28,vf27					; ,法線保存
	itof4.xyz	vf16,vf16			move.xyzw	vf30,vf19					; 頂点実数化,光線保存
	itof12.xyz	vf17,vf17			lq.xyzw		vf04,0x00(vi11)				; 法線実数化,最初のマトリクス読み込み
	muli.xyzw	vf21,vf21,I			lq.xyzw		vf05,0x01(vi11)				; 重み実数化,最初のマトリクス読み込み
	nop								lq.xyzw		vf06,0x02(vi11)				; ,最初のマトリクス読み込み
	itof12.xyz	vf15,vf15			lq.xyzw		vf07,0x03(vi11)				; Ｕ座標実数化,最初のマトリクス読み込み
	nop								iaddi		vi08,vi08,-1				; -,カウンタデクリメント
	nop								nop										; -,(遅)Ｕ座標書き戻し
	nop								sq.xyzw		vf26,SRC_XYZW(vi10)			; -,座標書き戻し
	nop								ibgtz		vi08,WeightConvertLoopBump		; -,ループ
	nop								iaddiu		vi10,vi10,BUF_NEXT			; -,書き込みアドレス増加

WeightConvertLoopBump:
	; 第１マトリクス計算（無条件にウェイトを考慮せず計算する）
	mulax.xyzw	ACC ,vf04,vf16		iaddi		vi06,vi06,-1		; 頂点計算,マトリクス数減算
	madday.xyzw	ACC ,vf05,vf16		iaddiu		vi09,vi09,BUF_NEXT	; 頂点計算,読み込みアドレス増加
	maddaz.xyzw	ACC ,vf06,vf16		iaddiu		vi11,vi05,M_MAT0	; 頂点計算,マトリクスアドレス設定
	maddw.xyzw	vf26,vf07,vf00		lq.xyzw		vf07,0x03(vi11)		; 頂点計算,次のマトリクス読み込み
	mulax.xyzw	ACC ,vf04,vf17		nop								; 法線計算,
	madday.xyzw	ACC ,vf05,vf17		nop								; 法線計算,
	maddz.xyzw	vf27,vf06,vf17		nop								; 法線計算,
	mulax.xyz	ACC ,vf04,vf15		lq.xyzw		vf04,0x00(vi11)		; Ｕ座標計算,次のマトリクス読み込み
	madday.xyz	ACC ,vf05,vf15		lq.xyzw		vf05,0x01(vi11)		; Ｕ座標計算,次のマトリクス読み込み
	maddz.xyz	vf19,vf06,vf15		lq.xyzw		vf06,0x02(vi11)		; Ｕ座標計算,次のマトリクス読み込み
	nop								ilw.z		vi05,BUF_IDX-BUF_NEXT(vi09)	; -,次のマトリクスインデックス読み込み

	; 第２マトリクス計算（他と少し違うので注意！）
	mulax.xyzw	ACC ,vf04,vf16		iblez		vi06,WConvertBumpEnd	; 頂点計算,計算終了
	madday.xyzw	ACC ,vf05,vf16		nop								; 頂点計算,ＵＶ２保存
	maddaz.xyzw	ACC ,vf06,vf16		iaddiu		vi11,vi05,M_MAT0	; 頂点計算,マトリクスアドレス設定
	maddw.xyzw	vf24,vf07,vf00		lq.xyzw		vf07,0x03(vi11)		; 頂点計算,次のマトリクス読み込み
	mulax.xyzw	ACC ,vf04,vf17		nop								; 法線計算,
	madday.xyzw	ACC ,vf05,vf17		nop								; 法線計算,
	maddz.xyzw	vf25,vf06,vf17		nop								; 法線計算,
	mulax.xyz	ACC ,vf04,vf15		lq.xyzw		vf04,0x00(vi11)		; Ｕ座標計算,次のマトリクス読み込み
	madday.xyz	ACC ,vf05,vf15		lq.xyzw		vf05,0x01(vi11)		; Ｕ座標計算,次のマトリクス読み込み
	maddz.xyz	vf18,vf06,vf15		lq.xyzw		vf06,0x02(vi11)		; Ｕ座標計算,次のマトリクス読み込み
	mulax.xyzw	ACC ,vf26,vf21		iaddi		vi06,vi06,-1		; 頂点合計加算,マトリクス数減算
	maddy.xyzw	vf26,vf24,vf21		ilw.w		vi05,BUF_IDX-BUF_NEXT(vi09)	; 頂点合計加算,次のマトリクスインデックス
	mulax.xyzw	ACC ,vf27,vf21		nop								; 頂点合計加算,-
	maddy.xyzw	vf27,vf25,vf21		nop								; 頂点合計加算,-
	mulax.xyzw	ACC ,vf19,vf21		iblez		vi06,WConvertBumpEnd	; 光線計算,計算終了
	maddy.xyzw	vf19,vf18,vf21		nop								; 光線計算,-

	; 第３マトリクス計算（以下、基本的に繰り返し）
	mulax.xyzw	ACC ,vf04,vf16		nop								; 頂点計算,-
	madday.xyzw	ACC ,vf05,vf16		nop								; 頂点計算,-
	maddaz.xyzw	ACC ,vf06,vf16		iaddiu		vi11,vi05,M_MAT0	; 頂点計算,マトリクスアドレス設定
	maddw.xyzw	vf24,vf07,vf00		lq.xyzw		vf07,0x03(vi11)		; 頂点計算,次のマトリクス読み込み
	mulax.xyzw	ACC ,vf04,vf17		nop								; 法線計算,
	madday.xyzw	ACC ,vf05,vf17		nop								; 法線計算,
	maddz.xyzw	vf25,vf06,vf17		nop								; 法線計算,
	mulax.xyz	ACC ,vf04,vf15		lq.xyzw		vf04,0x00(vi11)		; Ｕ座標計算,次のマトリクス読み込み
	madday.xyz	ACC ,vf05,vf15		lq.xyzw		vf05,0x01(vi11)		; Ｕ座標計算,次のマトリクス読み込み
	maddz.xyz	vf18,vf06,vf15		lq.xyzw		vf06,0x02(vi11)		; Ｕ座標計算,次のマトリクス読み込み
	addax.xyzw	ACC ,vf26,vf00		iaddi		vi06,vi06,-1		; 頂点合計加算,マトリクス数減算
	maddz.xyzw	vf26,vf24,vf21		nop								; 頂点合計加算,-
	addax.xyzw	ACC ,vf27,vf00		nop								; 頂点合計加算,-
	maddz.xyzw	vf27,vf25,vf21		nop								; 頂点合計加算,-
	addax.xyzw	ACC ,vf19,vf00		iblez		vi06,WConvertBumpEnd	; 光線計算,計算終了
	maddz.xyzw	vf19,vf18,vf21		nop								; 光線計算,-
	; 第４マトリクス計算
	mulax.xyzw	ACC ,vf04,vf16		nop								; 頂点計算,-
	madday.xyzw	ACC ,vf05,vf16		nop								; 頂点計算,-
	maddaz.xyzw	ACC ,vf06,vf16		nop								; 頂点計算,-
	maddw.xyzw	vf24,vf07,vf00		nop								; 頂点計算,次のマトリクス読み込み
	mulax.xyzw	ACC ,vf04,vf17		nop								; 法線計算,
	madday.xyzw	ACC ,vf05,vf17		nop								; 法線計算,
	maddz.xyzw	vf25,vf06,vf17		nop								; 法線計算,
	mulax.xyz	ACC ,vf04,vf15		nop								; Ｕ座標計算,次のマトリクス読み込み
	madday.xyz	ACC ,vf05,vf15		nop								; Ｕ座標計算,次のマトリクス読み込み
	maddz.xyz	vf18,vf06,vf15		nop								; Ｕ座標計算,次のマトリクス読み込み
	addax.xyzw	ACC ,vf26,vf00		iaddi		vi06,vi06,-1		; 頂点合計加算,マトリクス数減算
	maddw.xyzw	vf26,vf24,vf21		nop								; 頂点合計加算,-
	addax.xyzw	ACC ,vf27,vf00		nop								; 頂点合計加算,-
	maddw.xyzw	vf27,vf25,vf21		nop								; 頂点合計加算,-
	addax.xyzw	ACC ,vf19,vf00		iblez		vi06,WConvertBumpEnd	; 光線計算,計算終了
	maddw.xyzw	vf19,vf18,vf21		nop								; 光線計算,-
WConvertBumpEnd:; エンベロープ計算終了

	nop								ilw.y		vi05,BUF_IDX(vi09)			; -,次のマトリクスインデックス
	nop								ilw.x		vi11,BUF_IDX(vi09)			; -,最初のマトリクスインデックス
	nop								waitp									; -,(遅)法線正規化(23cycle)
	mulax.xyzw	ACC ,vf08,vf26		mfp.w		vf28,P						; 透視変換,(遅)法線正規化(24cycle)
	madday.xyzw	ACC ,vf09,vf26		lq.xyzw		vf21,BUF_WT0(vi09)			; 透視変換,重み読み込み
	maddaz.xyzw	ACC ,vf10,vf26		erleng		P,vf27						; 透視変換,法線正規化(0cycle)
	maddw.xyzw	vf26,vf11,vf00		iaddiu		vi11,vi11,M_MAT0			; 透視変換,マトリクスアドレス設定
	mulw.xyz	vf29,vf28,vf28		lq.xyzw		vf16,BUF_VERT(vi09)			; (遅)法線正規化,頂点読み込み
	itof0.xyzw	vf21,vf21			lq.xyzw		vf17,BUF_NORM(vi09)			; 重み実数化,法線読み込み
	nop								lq.xyz		vf15,BUF_UV2(vi09)			; -,Ｕ座標読み込み
	mulw.xyz	vf31,vf30,vf28		ilw.z		vi06,PACKDAT(vi13)			; (遅)Ｕ座標,マトリクス数取得
	nop								move.xyzw	vf28,vf27					; -,法線保存
	itof4.xyz	vf16,vf16			move.xyzw	vf30,vf19					; 頂点実数化,光線保存
	itof12.xyz	vf17,vf17			lq.xyzw		vf04,0x00(vi11)				; 法線実数化,最初のマトリクス読み込み
	muli.xyzw	vf21,vf21,I			lq.xyzw		vf05,0x01(vi11)				; 重み実数化,最初のマトリクス読み込み
	nop								lq.xyzw		vf06,0x02(vi11)				; -,最初のマトリクス読み込み
	itof12.xyz	vf15,vf15			lq.xyzw		vf07,0x03(vi11)				; Ｕ座標実数化,最初のマトリクス読み込み
	nop								iaddi		vi08,vi08,-1				; -,カウンタデクリメント
	nop								sq.xyz		vf29,BUF_NORM-BUF_NEXT(vi10); -,(遅)法線書き戻し
	nop								sq.xyz		vf31,BUF_UV2-BUF_NEXT(vi10); -,(遅)Ｕ座標書き戻し
	nop								sq.xyzw		vf26,SRC_XYZW(vi10)			; -,座標書き戻し
	nop								ibgtz		vi08,WeightConvertLoopBump		; -,ループ
	nop								iaddiu		vi10,vi10,BUF_NEXT			; -,書き込みアドレス増加

; 後始末
	nop								waitp									; -,(遅)法線正規化(23cycle)
	nop								mfp.w		vf28,P						; -,(遅)法線正規化(24cycle)
	nop								lq.xyzw		vf08,M_LIT0(vi00)			; 
	nop								lq.xyzw		vf09,M_LIT1(vi00)			; 
	nop								lq.xyzw		vf10,M_LIT2(vi00)			; 
	mulw.xyz	vf29,vf28,vf28		lq.xyzw		vf11,FV_FOG(vi00)			; (遅)法線正規化,-
	mulw.xyz	vf31,vf30,vf28		lq.xyzw		vf12,M_COL0(vi00)			; (遅)Ｕ座標
	nop								lq.xyzw		vf13,M_COL1(vi00)			; 
	nop								lq.xyzw		vf14,M_COL2(vi00)			; 
	nop								lq.xyzw		vf15,M_COL3(vi00)			; 
	nop								sq.xyz		vf29,BUF_NORM-BUF_NEXT(vi10); -,(遅)法線書き戻し
	nop								sq.xyz		vf31,BUF_UV2-BUF_NEXT(vi10); -,(遅)Ｕ座標書き戻し

	nop								b			TransMainStart				; 
	nop								nop										; 



; ================================================================
; 描画セットアップ処理
; ================================================================
;	upper		.					lower		.
StartOneWeightDrawBump:
; ----------------------------------------------------------------
; マルチウェイトエンベロープ合成＆透視変換処理
; ----------------------------------------------------------------
	; エンベロープ頂点合成
	; バッファデータの実数化とその他の前処理
	nop								ilw.x		vi11,BUF_IDX(vi09)	; -,マトリクスインデックス読み込み
	nop								lq.xyzw		vf16,BUF_VERT(vi09)	; -,頂点読み込み
	nop								lq.xyzw		vf17,BUF_NORM(vi09)	; -,法線読み込み
	nop								lq.xyzw		vf15,BUF_UV2(vi09)	; -,Ｕベクトル読み込み
	nop								iaddiu		vi11,vi11,M_MAT0	; -,マトリクスアドレス設定
	itof4.xyz	vf16,vf16			lq.xyzw		vf04,0x00(vi11)		; 頂点実数化,最初のマトリクス読み込み
	itof12.xyz	vf17,vf17			lq.xyzw		vf05,0x01(vi11)		; 法線実数化,最初のマトリクス読み込み
	itof12.xyz	vf15,vf15			lq.xyzw		vf06,0x02(vi11)		; -,最初のマトリクス読み込み
	nop								lq.xyzw		vf07,0x03(vi11)		; 重み実数化,最初のマトリクス読み込み
0:
	; 第１マトリクス計算（無条件にウェイトを考慮せず計算する）
	mulax.xyzw	ACC ,vf04,vf16		iaddiu		vi09,vi09,BUF_NEXT			; 頂点計算,読み込みアドレス増加
	madday.xyzw	ACC ,vf05,vf16		ilw.x		vi11,BUF_IDX(vi09)			; 頂点計算,最初のマトリクスインデックス
	maddaz.xyzw	ACC ,vf06,vf16		lq.xyzw		vf16,BUF_VERT(vi09)			; 頂点計算,頂点読み込み
	maddw.xyzw	vf26,vf07,vf00		iaddi		vi08,vi08,-1				; 頂点計算,カウンタデクリメント
	mulax.xyz	ACC ,vf04,vf15		iaddiu		vi10,vi10,SRC_NEXT			; Ｕ座標計算,書き込みアドレス増加
	madday.xyz	ACC ,vf05,vf15		iaddiu		vi11,vi11,M_MAT0			; Ｕ座標計算,マトリクスアドレス設定
	maddz.xyz	vf19,vf06,vf15		lq.xyzw		vf15,BUF_UV2(vi09)			; Ｕ座標計算,Ｕ座標読み込み
	mulax.xyzw	ACC ,vf04,vf17		nop										; 法線計算,
	madday.xyzw	ACC ,vf05,vf17		nop										; 法線計算,
	maddz.xyzw	vf27,vf06,vf17		lq.xyzw		vf17,BUF_NORM(vi09)			; 法線計算,法線読み込み
	mulax.xyzw	ACC ,vf08,vf26		lq.xyzw		vf04,0x00(vi11)				; 透視変換,最初のマトリクス読み込み
	madday.xyzw	ACC ,vf09,vf26		lq.xyzw		vf05,0x01(vi11)				; 透視変換,最初のマトリクス読み込み
	maddaz.xyzw	ACC ,vf10,vf26		lq.xyzw		vf06,0x02(vi11)				; 透視変換,最初のマトリクス読み込み
	maddw.xyzw	vf26,vf11,vf00		sq.xyz		vf27,SRC_NORM-SRC_NEXT(vi10); 透視変換,法線書き戻し
	itof4.xyz	vf16,vf16			sq.xyz		vf19,SRC_UV2-SRC_NEXT(vi10)	; Ｕ座標実数化,Ｕ座標書き戻し
	itof12.xyz	vf15,vf15			lq.xyzw		vf07,0x03(vi11)				; 頂点実数化,最初のマトリクス読み込み
	itof12.xyz	vf17,vf17			ibgtz		vi08,0b						; 法線実数化,ループ
	nop								sq.xyzw		vf26,SRC_XYZW-SRC_NEXT(vi10); -,座標書き戻し

; 後始末
	nop								lq.xyzw		vf08,M_LIT0(vi00)			; 
	nop								lq.xyzw		vf09,M_LIT1(vi00)			; 
	nop								lq.xyzw		vf10,M_LIT2(vi00)			; 
	nop								lq.xyzw		vf11,FV_FOG(vi00)			; 
	nop								lq.xyzw		vf12,M_COL0(vi00)			; 
	nop								lq.xyzw		vf13,M_COL1(vi00)			; 
	nop								lq.xyzw		vf14,M_COL2(vi00)			; 
	nop								lq.xyzw		vf15,M_COL3(vi00)			; 
	nop								b			TransMainStart				; 
;	nop								b			CullTransMainStart				; 
	nop								nop										;




	; 回転マトリクスの回転成分のみ反転させる
	; vf04,05,06 > vf12,13,14
InversRotMatrix:
	addz.y			vf14,vf00,vf05	move.x		vf12,vf04			; 
	addx.y			vf12,vf00,vf05	move.y		vf13,vf05			; 
	addx.z			vf12,vf00,vf06	move.z		vf14,vf06			; 
	addy.x			vf13,vf00,vf04	mr32.w		vf12,vf00			; 
	addy.z			vf13,vf00,vf06	mr32.w		vf14,vf00			; 
	nop								jr			vi15				; 
	addz.x			vf14,vf00,vf04	mr32.w		vf13,vf00			; 

EndVu1Program:

.EndMPG					; マイクロプログラム転送の終了
.EndDmaData				; DMAref転送データの終了






