	; ３回目以降
sm_l00:
	mula.xyz	ACC ,vf17,vf04		sq.xyz		vf18,SRC_UV2-SRC_NEXT*2(vi09)	; (遅)ＵＶ算出,(遅)(遅)ＳＴＱ格納
	maddw.xy	vf18,vf05,vf00		sq.xyz		vf19,DST_UV2(vi10)			; (遅)ＵＶ算出,(遅)(遅)クリップ用保存
	mulax.xyz	ACC ,vf12,vf16		iaddi		vi08,vi08,-1				; 法線変換,カウンタ減算
	madday.xyz	ACC ,vf13,vf16		iaddiu		vi09,vi09,SRC_NEXT			; 法線変換,読み込みアドレス加算
