<?xml version="1.0" encoding="Windows-1252"?>
<VisualStudioPropertySheet
	ProjectType="Visual C++"
	Version="8.00"
	Name="CP4 X360 Ship"
	InheritedPropertySheets=".\cp4_common_x360.vsprops"
	>
	<Tool
		Name="VCCLCompilerTool"
		Optimization="3"
		InlineFunctionExpansion="1"
		PreprocessorDefinitions="NDEBUG;GOLD_VERSION"
		RuntimeLibrary="0"
	/>
	<Tool
		Name="VCLinkerTool"
		AdditionalDependencies="d3d9.lib d3dx9.lib xapilib.lib xgraphics.lib xonline.lib xparty.lib xnet.lib xmp.lib xhv2.lib x3daudio.lib xact3.lib xaudio2.lib Xmcore.lib xmedia2.lib xmahal.lib xboxkrnl.lib xwmadecode.lib"
		OptimizeReferences="2"
		EnableCOMDATFolding="2"
	/>
<Tool
	Name="VCCLX360CompilerTool"
	Optimization="3"
	InlineFunctionExpansion="1"
	PreprocessorDefinitions="NDEBUG;GOLD_VERSION"
	RuntimeLibrary="0"
/>
<Tool
	Name="VCX360LinkerTool"
	AdditionalDependencies="d3d9.lib d3dx9.lib xapilib.lib xgraphics.lib xonline.lib xparty.lib xnet.lib xmp.lib xhv2.lib x3daudio.lib xact3.lib xaudio2.lib Xmcore.lib xmedia2.lib xmahal.lib xboxkrnl.lib xwmadecode.lib"
	OptimizeReferences="2"
	EnableCOMDATFolding="2"
/>
</VisualStudioPropertySheet>
