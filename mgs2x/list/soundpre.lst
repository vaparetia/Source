//サウンドパックリスト（プレビュー環境用）

pak r_tnk0/pk000000.sdx	//タンカー常駐
{
	wvx	wvx1/wv00007f.wvx
	wvx	wvx1/wv0000ff.wvx
	mdx	mdx1/sg0000ff.mdx
	efx	efx1/se00007f.efx
}

pak r_plt0/pk000000.sdx	//プラント常駐
{
	wvx	wvx1/wv00005f.wvx
	wvx	wvx1/wv0000ff.wvx
	mdx	mdx1/sg0000ff.mdx
	efx	efx1/se00005f.efx
}

//ファイル名の法則
//pk000[ステージ番号][ステージ記号(a=0,b=1,c=2...)].sdx

pak init/pk000000.sdx
{
	wvx	wvx1/wv00007f.wvx
}

pak preview/pk000000.sdx
{
	wvx	wvx1/wv00007d.wvx
	wvx	wvx1/wv000080.wvx
	efx	efx1/se00007d.efx
	mdx	mdx1/sg000010.mdx
}
