pack_all	ws03a.tri \
	world/vr_weapon/ws03a
option makexti6						//	ＸＢＯＸ用劣化無しテクスチャ用

world		vr_weapon/ws03a
hazard		ws03a.hzx

rol			world/vr_weapon/ws03a/ws03a.rol

