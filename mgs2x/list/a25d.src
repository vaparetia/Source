			debug/morita/w11c_test/w11c2_fire3a_alp.bmp \
			effect/plant_sea/e_oil_sea_alp_ovl_mod0222.bmp
cvd			human/sna_skl/sna_skl.cv2

// 敵兵関連define
// 敵兵タイプ
#define ENE_P_GOL		// w25dは都市迷彩攻撃兵
#define ENE_ATTACKER
#define ENE_MAR '-DDEL_WALKMAN=DUMMY -DDEL_SHIELD=DUMMY -DDEL_SHOTGUN=DUMMY -DDEL_TNG=DUMMY -DDEL_LOCKER=DUMMY -DDEL_TOILET=DUMMY -DDEL_SHOUBEN=DUMMY'

