#define WN_W31A

block .use r_plt0
block .nocache
block .cache

#include	"w31a_game.h"

// キャラクタ 
// ライデン
human		rai_def/rai_def_mh_mt.evm
// オセロット
human	rev_plant/rev_plant_mh_mt.evm
pack_all rev_etc.tri \
		human/rev_def/rev_def_shadow.dar \
		human/rev_coat/rev_hair_fix.dar \
		human/rev_coat/rev_coat_bounding.dar
human	rev_def/rev_def_shadow.kms
human	rev_coat/rev_hair_fix.kms
human	rev_coat/rev_coat_bounding.kms

// 細々した物をまとめる
pack_all obj_etc.tri \
		human/jam_def/jam_def.dar \
		weapon/saa/saa_lefthand.dar \
		item/mo_disk/mo_disk.dar \
		item/item_security_card_lv4/security_card_lv4.dar \
		weapon/usp/usp_sub.dar
human	jam_def/jam_def.kms
weapon	saa/saa_lefthand.kms
item	mo_disk/mo_disk.kms
item	item_security_card_lv4/security_card_lv4.kms
weapon	usp/usp_sub.kms

// リアル影投影モデル
