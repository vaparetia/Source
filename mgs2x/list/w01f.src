// 敵兵固有モーション
mtn 			gbs_w01f.mls

// リネーム
rename			aks_sp.cv2	aks_sp_1.cv2
rename 			gbs_w01f.mar gbsstage.mar
#ifdef MGS2_VMODE_PAL
	rename		w01f_paddemo_1f_pal.rpd		w01f_paddemo_1f.rpd
#endif
