	pack_all	ws41a.tri \
				world/vr_weapon/ws41a
option makexti6

world		vr_weapon/ws41a

hazard		ws41a.hzx
rol			world/vr_weapon/ws41a/ws41a.rol
cvd			world/vr_weapon/ws41a/ws41a.cv2 v

