// キャラクタ
#include	"ene_plant.h"

// 強制モーション
mtn			rai_sp25a.mls
mtn			sna_sp25a.mls

// ワールド
// マルチテクスチャモデル
// それ以外のモデル
option makexti6 -l 1024 -f PAL8 // ↓↓↓↓↓↓ここから テクスチャ品質向上委員会(ゲイツ用)
pack_all	sp25a.tri \
			world/vr_variety/sp25a
option makexti6					// ↑↑↑↑↑↑↑↑ ここまで

world		vr_variety/sp25a
lt2			vr_dark.lt2

hazard		sp25a.hzx
rol			world/vr_variety/sp25a/sp25a.rol


// オブジェクト

pack_all	object.tri
			meca/svc_plant
			meca/gun_camera

meca		svc_plant
meca		gun_camera


// 解体Ｃ４セット(一番最後に描画してもらうためにzからはじめる)
pack_all	z_object.tri \
			goods/c4_kaitai_a \
			goods/c4_kaitai_b

goods		c4_kaitai_a
goods		c4_kaitai_b

//	ＶＲ追加エフェクト
