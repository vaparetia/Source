#define WN_SP25A

// モデル用
// 敵兵関連define
// 敵兵タイプ
// 敵兵タイプ

#define ENE_VR_GOL		// ＶＲ敵兵
#define ENE_ATTACKER	// 攻撃兵
#define ENE_SHIELD		// 盾兵
#define ENE_SHOT		// ショットガン兵
#define ENE_HIGH_TECH	// 人質イベント後はハイテク兵

// 特殊兵のモーション設定
#define ENE_MAR '-DDEL_TNG=DUMMY -DDEL_WALKMAN=DUMMY -DDEL_LOCKER=DUMMY -DDEL_TOILET=DUMMY'

block .use r_vr_r
block .nocache
block .cache

// 各ステージ共通要素
//#include	"vr_def.h"
#include	"p_common.h"
#include	"common.h"
