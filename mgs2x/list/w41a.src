l2d		2D/demo/hold_breath/xbreath.l2d
#elif defined(MGS2_KOREA)
//	韓国版
l2d		2D/demo/hold_breath/breath_kr.l2d
#else
//	韓国版以外
l2d		2D/demo/hold_breath/breath.l2d
#endif

//	全体マップ
l2d         2D/mapbug/mapbug.l2d // map bug

//	振動
vib		program/snake_arm_01.vib
vib		program/org_punch.vib
vib		program/rai_release.vib
vib		program/rai_restriction.vib


// リネーム
