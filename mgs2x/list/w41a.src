				world/door/w41a_dr_left.dar \
				world/door/w41a_dr_right.dar \
				world/door/w41a_cell_sdr.dar \
				world/door/w41a_cell_sdr_02.dar

world		door/w41a_dr_left.kms
world		door/w41a_dr_right.kms
world		door/w41a_cell_sdr.kms
world		door/w41a_cell_sdr_02.kms

// オブジェ関係
goods		locker/neo_locker_door.kms

//	監視カメラ
meca		svc_plant

// アイテム
itembox

