include		ene_tng42.h

// ライデン（本来必要なのは、裸ライデン？）
human	rai_def/rai_def_mh_mt.evm

// ソリダス
pack_all	sol_mh.tri	\
//	human/sol_def/sol_def_face_mh_mt.dar \
	human/sol_def/sol_snakearm_mh_mt.dar \
	human/sol_def/sol_def_mh_mt.dar \
	human/sol_def/sol_gantai_obj.dar

//human	sol_def/sol_def_face_mh_mt.evm
human	sol_def/sol_snakearm_mh_mt.evm
human	sol_def/sol_def_mh_mt.evm

	//	眼帯
human	sol_def/sol_gantai_obj.kms

	//	ぼんぼり
pack_trnall	effect.tri \
			effect/bonbori/w_bonbori.bmp

// オセロット
human	rev_plant/rev_plant_mh_mt.evm
	//	髪の毛
human	rev_coat/rev_hair_fix.kms
human	rev_coat/rev_coat_bounding.kms

// オルガ
human	org_plant/org_plant_mh_mt.evm
	//	髪の毛
human	org_plant/org_plant_hair_mh.evm
human	org_plant/org_plant_dummy.kms

	//	装備品
goods	demo_org_plant_goods

//	映り込み用KMS
	//	ソリダス
human	sol_def/sol_def_sh_mt.kms

	//	オセロット
human	rev_plant/rev_plant_sh_mt.kms

	//	オルガ
human	org_plant/org_plant_sh_mt.kms


//	モーション
	//	強制モーション
mtn		rai_w41a.mls
	//	ロッカー開閉モーション
mtn 	rai_n_locker.mls

	//	ロッカー扉開閉モーション
mtn		locker.mls

	//	ソリダス
mtn		sol_w41a.mls
mtn		sol_snakearm_w41a.mls

	//	オセロット
mtn		rev_w41a.mls
	//	オルガ
mtn		org_w41a.mls


// ワールド
