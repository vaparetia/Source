block ending
{
	mpeg /u/develop/mj001data/fix/movie/mpeg/ed_01.sst 0
	mpeg /u/develop/mj001data/fix/movie/mpeg/ED_02mini.sst 73606
	mpeg /u/develop/mj001data/fix/movie/mpeg/ed_03.sst 91950

	caption /u/develop/mj001data/fix/sound/demo1/cap1/p082_05_m02.cap

	sd_n /u/develop/mj001data/fix/sound/mov1/pcm1/p082_05_m02.pcm
	ac3 /u/develop/mj001data/fix/sound/mov1/pcm1/p082_05_m02_ac3.pcm
}

