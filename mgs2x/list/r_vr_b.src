block .nocache

block .resident

include		keepfont.h

/* これで2.82MBに達したので、これ以上の追加は不可能 */

// 装備メニューアイコン
include		menuicon.h

// 忍者
include 	ninja.h

// 武器
include		wp_vr.h

// 刀セット一式
pack_trnall	katana.tri \
			debug/shibata/staffroll/alpha03_alp_ovl.bmp

pack_all	hfb_mt.tri \
            weapon/hfb/hfb_mt.dar \
            weapon/hfb/hfb_mineuchi_mt.dar \
			weapon/hfb/hfb_sub_mt.dar \
			weapon/hfb/hfb_mineuchi_sub_mt.dar

weapon		hfb/hfb_mt.kms
weapon		hfb/hfb_mineuchi_mt.kms
weapon		hfb/hfb_sub_mt.kms
weapon		hfb/hfb_mineuchi_sub_mt.kms
//カタナ出現エフェクト用 分割カタナモデルと頂点データ 
weapon		hfb/hfb_syutsugen_mt.kms
cvd			weapon/hfb/hfb_syutsugen_mt.cv2 v


mtn			rai_blade.mls

//グラサン
pack_all	glasses.tri \
			human/rai_def/rai_glass_mh_mt.dar

human		rai_def/rai_glass_mh_mt.evm

pack_all	glasses_kms.tri \
			human/rai_def/rai_glass_sh_mt.dar

human		rai_def/rai_glass_sh_mt.kms

// 振動
include		res_vib.h

// ゲームオーバー
l2d			2D/vr_game_over/vr_geme_over.l2d

// 全体マップ
include		allmap_tanker.h
include		allmap_plant.h
include		allmap_arsenal.h

block .cache
//binary		font.row
// pack_allに'-s'と付けることでパレット変更エフェクトの影響を受けなくなる
pack_all	'-s' menu.tri effect/font/font_alp_ovl.bmp effect/font/debug_font_alp_ovl.bmp effect/font/font_mini_alp_ovl.bmp effect/sys_icon/cd_err_alp_ovl.bmp

binary		vram0.raw


