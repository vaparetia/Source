// 敵兵関連define
// 敵兵タイプ
#define ENE_P_GOL		// w25bは都市迷彩攻撃兵
#define ENE_MAR '-DDEL_WALKMAN=DUMMY -DDEL_SHIELD=DUMMY -DDEL_SHOTGUN=DUMMY -DDEL_TNG=DUMMY -DDEL_CARRY=DUMMY -DDEL_HANG=DUMMY -DDEL_BOX=DUMMY -DDEL_NEAR_ATTACK=DUMMY -DDEL_LOCKER=DUMMY -DDEL_SHOUBEN=DUMMY -DDEL_TOILET=DUMMY'

// DEL_WALKMAN ウォークマン兵のモーション
// DEL_SHIELD 盾兵のモーション
// DEL_SHOTGUN ショットガン兵のモーション
// DEL_TNG 天狗兵
// DEL_HIGH ハイテク兵
// DEL_RADIO　無線使用
// DEL_EROTICA　エロ本発見
// DEL_BOX　ダンボール調べ
// DEL_GRD　グレネード投げ
// DEL_NEAR_ATTACK　近接格闘攻撃
// DEL_LOCKER　ロッカー関連
// DEL_HANG　羽交い絞め
// DEL_PARTS　部位ダメージあり
// DEL_CARRY　死体引きずり
// DEL_TOILET　トイレ（w16a専用）
// DEL_SHOUBEN　放尿（w25c専用）


