#define E_HIMATU	// 水飛沫
#define E_SUN		// 太陽
#define E_OTHER1	// 水面、水中、リニアガン、雨、フェード、バルカン人形、ダンボール主観、濁流、ソリダス剣（予定）、カメラ前の水滴
#define E_OTHER2	// プラズマ、剣残像、カミナリ、衝撃波、落下物水飛沫
#define E_OTHER3	// ドッグタグ、ハリアエフェクト、ソリダスエフェクト
