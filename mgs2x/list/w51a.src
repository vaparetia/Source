human	rev_liq/rev_liq_boundhing.kms
human	for_def/for_last_addhand_mh_mt.evm

pack_all demo_raycp.tri \
		meca/ray_w04c1/raycp_canopy2_t12a1d_mt.dar \
		meca/ray_w04c1/raycp_canopy1_t12a1d_mt.dar \
		meca/ray_w04c1/raycp_t12a1d.dar \
