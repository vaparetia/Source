#define WN_W51A

block .use r_plt0
block .nocache
block .cache

#include	"w51a_common.h"

// 強制モーション
mtn		sna_w51a.mls
mtn		sol_w51a.mls
mtn		sol_snakearm_w51a.mls
mtn		fort_w51a.mls
mtn		rev_w51a.mls
mtn		ray_w51a.mls


// 海面(MIPMAP)
#ifndef MGS2_XBOX_1
mipmap w51a/w51a_sea.tri
#else
pack_mip w51a_sea.tri \
	effect/sea_mipmap/w51a_sea_256_alp_ovl.bmp \
	effect/sea_mipmap/w51a_sea_128_alp_ovl.bmp \
	effect/sea_mipmap/w51a_sea_64_alp_ovl.bmp \
	effect/sea_mipmap/w51a_sea_32_alp_ovl.bmp 
#endif

// 以下ポリデモ用
//ライデン
pack_all demo_raiden.tri \
		human/rai_def/rai_def_mt.dar \
		human/rai_def/rai_def_mh_mt.dar
human	rai_def/rai_def_mt.kms
human	rai_def/rai_def_mh_mt.evm

// リアル影投影モデル
world	w51a/w51a_kage/w51a0k.kms
world	w51a/w51a_kage/w51a1k.kms

// 息我慢ボタン用Ｌ２Ｄ
#if defined(MGS2_XBOX)
//	XBOX版
l2d		2D/demo/hold_breath/xbreath.l2d
#elif defined(MGS2_KOREA)
//	韓国版
l2d		2D/demo/hold_breath/breath_kr.l2d
#else
//	韓国版以外
l2d		2D/demo/hold_breath/breath.l2d
#endif

// 振動データ
vib	program/snake_arm_02.vib
vib	program/snake_arm_03.vib

// リネーム
#if defined(MGS2_XBOX)
//	XBOX版
rename	xbreath.o2d breath.o2d
#elif defined(MGS2_KOREA)
//	韓国版
rename	breath_kr.o2d breath.o2d
#endif


pack_all demo_human.tri \
		human/rev_liq/rev_liq_p_addhand_mh_mt.dar \
		human/rev_liq/rev_hair_liq_mh.dar \
		human/rev_liq/rev_liq_boundhing.dar \
