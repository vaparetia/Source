				world/w12b/w12b_obj/w12b0_moni_brk1.bmp \
				world/w12b/w12b_obj/w12b0_moni_brk2.bmp \
				world/w12b/w12b_obj/w12b0_moni_brk3.bmp
pack_trnall	button.tri \
				effect/button/button_alp.bmp

