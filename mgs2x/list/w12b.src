// ワールド
// マルチテクスチャモデル
// それ以外のモデル

pack_all	object.tri \
				world/door/w12b_dr00.dar \
				world/door/w12b_dr01.dar \
				world/door/dr_lv1_00.dar

world		door/w12b_dr00.kms	// 屋上へのドア(左右共用)
world		door/w12b_dr01.kms	// 連絡橋へのドア(左右共用)
world		door/dr_lv1_00.kms	// カードドア

pack_all	w12b0_2.tri \
				world/w12b/w12b0/w12b0_12a0.dar \
				world/w12b/w12b0/w12b0_12a1.dar \
				world/w12b/w12b0/w12b0_13a.dar \
				world/w12b/w12b0/w12b0_23a.dar

option makexti6 -l 1024 -f PAL8
world		w12b/w12b0
world		w12b/w12b1
option makexti6

lt2			w12b.lt2
hazard		w12b.hzx





