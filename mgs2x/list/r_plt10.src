	human/mrl_def/mrl_de_grip.dar			//	デザートイーグルのグリップモデル

//	KMSメリル
human	mrl_def/mrl_def_sh_mt.kms		//	本体
human	mrl_def/mrl_def_hair_mh.evm		//	髪の毛
human	mrl_def/mrl_dummy.kms			//	バウンディングボックス
