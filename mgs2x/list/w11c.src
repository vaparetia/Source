		human/for_coat/for_coat_addhand_mh_mt.dar \
		human/for_coat/for_tears_mh_mt.dar
human	for_coat/for_coat_addhand_mh_mt.evm
human	for_coat/for_tears_mh_mt.evm

// ヴァンプ
