		human/vmp_coat/vmp_kizu_mh.dar \
		human/vmp_coat/vmp_jyuusou_mh.dar
human	vmp_coat/vmp_kizu_mh.evm
human	vmp_coat/vmp_jyuusou_mh.evm

// フォーチュンの涙
// モデル（TRI名に、ema_ooze_blood_mh.tri が欲しいので、まとめない）
