#define WN_W11C

block .use r_plt0
block .nocache
block .cache

#include "w11c_game.h"





// デモ用に延長されたエレベータシャフト
world	elevator/w11_elv_append

// シールズ
human	sel_def/sel_def.kms

// フォーチュン
