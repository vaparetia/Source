block .nocache

block 		.resident

include		keepfont.h

//	全ステージ共通データ
#define		NO_KMS_RAI		//	KMSﾊハイポリライデンなし
#define		NO_KMS_SNA		//	KMSハイポリスネークなし

//#define		NO_BIS		//	ビジネスマンなし
//#define		NO_OL		//	ＯＬなし
//#define		NO_ENEMY	//	ハイテク兵なし
#include	"low_mdl.h"

//	テクスチャパック（EVMライデン、EVMメリル）
pack_all rai_mrl_mh_mt.tri \
	human/rai_def/rai_def_mh_mt.dar		\	//	本体
	human/mrl_def/mrl_def_mh_mt.dar		\	//	本体
	human/mrl_def/mrl_def_hair_mh.dar		//	髪の毛

//	EVMライデン
human		rai_def/rai_def_mh_mt.evm

//	テクスチャパック（EVMソリダス）
pack_all sol_mh_mt.tri \
	human/sol_def/sol_def_mh_mt.dar		\
	human/sol_def/sol_gantai_mh_mt.dar

//	EVMソリダス
human	sol_def/sol_def_mh_mt.evm
human	sol_def/sol_gantai_mh_mt.evm

//	テクスチャパック（EVM忍者ライデン、EVMメリルのいろいろ、EVMタキシード、EVMオタコンのいろいろ）
pack_all nin_mrl_sh_mt.tri \
	human/rai_nin/rai_nin_mh_mt.dar		\		//	本体
//	human/rai_nin/rai_nin_shadow.dar 	\		//	テクスチャ無い
	human/rai_nin/rai_nin_face_open.dar	\		//	オープンフェイス
	human/mrl_def/mrl_dummy.dar			\		//	バウンディングボックス
	human/mrl_def/mrl_waist_mag.dar		\		//	左腰のマグポーチ＆マグパック
	human/mrl_def/mrl_waist_pack.dar	\		//	左腰のマグポーチ＆マグパック
	human/sna_txd/sna_txd_mh_mt.dar		\		//	本体
//	human/sna_txd/sna_txd_bounding.dar	\		//	テクスチャ無い
	human/otc_def/otc_dummy.dar			\		//	バウンディングボックス
	human/otc_def/otc_glasses_mt.dar	\		//	眼鏡
	human/otc_def/otc_shadow.dar				//	影用


//	テクスチャパック（EVMタキシードのすそ、EVMハイクオリティＭＧＳ１、EVMオタコン）
pack_all txd_oss_otc_mh_mt.tri \
	human/sna_oss/sna_oss_mh_mt.dar			\	//	本体
	human/sna_txd/sna_txd_suso_mh_mt.dar	\	//	すそ
	human/otc_def/otc_def_mh_mt.dar			\	//	本体
	human/otc_def/otc_hair_mh.dar			\	//	髪の毛
	human/otc_def/otc_jaket_suso_mh.dar			//	すそ

//	EVMタキシードスネーク
human	sna_txd/sna_txd_mh_mt.evm		//	本体
human	sna_txd/sna_txd_suso_mh_mt.evm	//	すそ
human	sna_txd/sna_txd_bounding.kms	//	バウンディングボックス

//	EVMハイクオリティＭＧＳ１スネーク
human	sna_oss/sna_oss_mh_mt.evm		//	本体
human	sna_oss/sna_oss_shadow.kms		//	影用

//	EVM忍者ライデン
human	rai_nin/rai_nin_mh_mt.evm		//	本体
human	rai_nin/rai_nin_shadow.kms		//	影用
human	rai_nin/rai_nin_face_open.kms	//	オープンフェイス

//	EVMオタコン
human	otc_def/otc_def_mh_mt.evm		//	本体
human	otc_def/otc_hair_mh.evm			//	髪の毛
human	otc_def/otc_jaket_suso_mh.evm	//	すそ
human	otc_def/otc_dummy.kms			//	バウンディングボックス
human	otc_def/otc_glasses_mt.kms		//	眼鏡
human	otc_def/otc_shadow.kms			//	影用


//	EVMメリル
human	mrl_def/mrl_def_mh_mt.evm		//	本体
human	mrl_def/mrl_def_hair_mh.evm		//	髪の毛
human	mrl_def/mrl_dummy.kms			//	バウンディングボックス
human	mrl_def/mrl_waist_mag.kms		//	左腰のマグポーチ＆マグパック
human	mrl_def/mrl_waist_pack.kms 		//	左腰のマグポーチ＆マグパック



#ifdef MGS2_XBOX_1 // menuicon.hでも記述しているので注意！
pack_all	'-s' menu.tri effect/font/font_alp_ovl.bmp effect/font/debug_font_alp_ovl.bmp effect/font/font_mini_alp_ovl.bmp effect/sys_icon/cd_err_alp_ovl.bmp
#endif
block .cache


