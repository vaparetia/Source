#define WN_SP02A

// 的用
#define VR_TGT_MINE 1 // ＶＲ機雷

block .use r_vr_r
block .nocache
block .cache

// 各ステージ共通要素
#include	"vr_def.h"
#include	"p_common.h"
#include	"common.h"
