mtn			sna_sp02a.mls

// ワールド
// マルチテクスチャモデル
// それ以外のモデル 
option makexti6 -l 1024 -f PAL8
pack_all	sp02a.tri \
	world/vr_variety/sp02a
option makexti6

world		vr_variety/sp02a
rol			world/vr_variety/sp02a/sp02a0.rol
rol			world/vr_variety/sp02a/sp02a1.rol
hazard		sp02a.hzx

// ＶＲ的
#include	"vrstage.h"

// オブジェクト

//	ＶＲ追加エフェクト
#include	"vr_effect.h"

// アイテム
itembox

