#define WN_SP01A

// 的用
#define VR_TGT_TRIANGLE 1	// ＶＲ的三角
#define VR_TGT_WALL 1	// ＶＲ的壁
#define VR_TGT_MINE 1	// ＶＲ機雷

block .use r_vr_r
block .nocache
block .cache

// 各ステージ共通要素
#include	"vr_def.h"
#include	"p_common.h"
#include	"common.h"
#include	"c_effect.h"

// 強制モーション
mtn			rai_sp01a.mls
mtn			sna_sp01a.mls

// ワールド
// マルチテクスチャモデル
// それ以外のモデル 
option makexti6 -l 1024 -f PAL8
pack_all	sp01a.tri \
	world/vr_variety/sp01a/sp01a.dar
option makexti6

world		vr_variety/sp01a
rol			world/vr_variety/sp01a/sp01a.rol
hazard		sp01a.hzx

// ＶＲ的
#include	"vrstage.h"

// オブジェクト
pack_all	object.tri \
			world/test/vr_test/vr2_pitfall_a0.dar

world		test/vr_test/vr2_pitfall_a0.kms

//	落し穴
include		pit_effect.h
pack_trn	pitfall_tex.tri \
			effect_vr/pitfall/vr2_pitfall_b0_all_add_alp.bmp

//	ＶＲ追加エフェクト
#include	"vr_effect.h"

// アイテム
itembox

// デバッグ用
// 小さいサイズのテクスチャはまとめておく


// リネーム
