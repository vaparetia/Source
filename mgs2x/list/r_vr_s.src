block .nocache

block 		.resident

include		keepfont.h

// 装備メニューアイコン
include		menuicon.h

// スネーク
include 	snake.h

// 武器				
include		wp_vr_s.h

//グラサン
pack_all	glasses.tri \
			human/sna_def/sna_glass_mh_mt.dar \
			human/sna_def/sna_glass_black_mh_mt.dar

human		sna_def/sna_glass_mh_mt.evm
human		sna_def/sna_glass_black_mh_mt.evm

pack_all	glasses_kms.tri \
			human/sna_def/sna_glass_sh_mt.dar \
			human/sna_def/sna_glass_black_sh_mt.dar

human		sna_def/sna_glass_sh_mt.kms
human		sna_def/sna_glass_black_sh_mt.kms

// 振動
include		res_vib.h

// ゲームオーバー	
l2d			2D/vr_game_over/vr_geme_over.l2d
#ifdef MGS2_XBOX_1
/* YES/NO確認画面 yano 2002.08.08 */
l2d 		2D/end_game_x/end_game.l2d
#endif

// 全体マップ		
include		allmap_tanker.h
include		allmap_plant.h
include		allmap_arsenal.h

block .cache
//binary		font.row
// pack_allに'-s'と付けることでパレット変更エフェクトの影響を受けなくなる
pack_all	'-s' menu.tri effect/font/font_alp_ovl.bmp effect/font/debug_font_alp_ovl.bmp effect/font/font_mini_alp_ovl.bmp effect/sys_icon/cd_err_alp_ovl.bmp

binary		vram0.raw


