//タンカークルーはメモリ確保までコメントアウト (追加水谷)
human	tnr_def/tnr_coat_sgl.kms
cvd human/tnr_def/tnr_coat_sgl.cv2 vn
cvd human/tnr_def/tnr_coat_sgl_anim00.cv2 vn
cvd human/tnr_def/tnr_coat_sgl_anim01.cv2 vn
human	tnr_def/tnr_coat_mlch.evm
goods flashlight/tnr_frashlight.kms
cvd goods/flashlight/tnr_frashlight.cv2 vn

#ifdef MGS2_XBOX_1
pack_trnall	effect.tri \
	effect/cloud/w00_sky_add.bmp /* XBOXの「thunder_flash.c」でのみ使用 */
#endif

