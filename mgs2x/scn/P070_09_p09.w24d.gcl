	chara delay ディレイ -time 200 \
		-exec{
			@濁流ストップ
		}

	chara デモキャンセルチェック デモキャンセル \
		-p demo_cancel
*/
}

//初期マップの表示
command マップ表示 -show アーセナル浮上ステージ



// 各proc設定
//-------------------------------------------------------------------------------------
proc 夜空設定 {
	chara 汎用空 空 \
		-c 3 23 21 \
		-pos 0 0 0 \
		-f d:SKY_FLAGS_NO_MOVE \
		-l 32 \
		-t 4 \
			sky_n1_alp 51 57 56 0 \
			sky_n2_alp 47 50 50 0 \
			0 0 0 0 0 \
			sky_n4_alp 47 49 49 0 \
		-m 2 \
			p_br_sky_wall1 10 13 15 0 0 \
			p_br_sky_wall4 160 160 160 0 0
}

//-------------------------------------------------------------------------------------
// デモデモ再生関連のプロック
//-----------------------------------------------------------
// これはデバッグ用
proc restart_proc {
	restart
}

proc dummy_proc {}

proc null {}

proc demo_cancel {
	command StreamStopAll
}

proc P070_09b_p09終了 {
	@デモ終了時シネマスクリーンオフ
	mesg デモキャンセルチェック デモキャンセル kill
	#if d:DEMO_SKIP_ENABLE
		eval($w:p_story = d:ST:P070_09b_P09ＡＧ起動９ｂポリゴンデモ９終了)
		print '$w:p_story = d:ST:P070_09b_P09ＡＧ起動９ｂポリゴンデモ９終了'
	#else
		print '$w:p_story = d:ST:P070_09b_P09ＡＧ起動９ｂポリゴンデモ９終了'
		eval($w:p_story = d:ST:P070_09b_P09ＡＧ起動９ｂポリゴンデモ９終了)
	#endif

	chara delay ディレイ \
		-time 1 \ 
		-exec{
			restart
		}
}


proc シネマスクリーンセット  {
	chara シネマスクリーン シネマ \
		-top d:CINEMA_BELT_UPPER \
		-bottom d:CINEMA_BELT_LOWER \
		-ftime 60	//デフォルト値（ゼロは駄目）
	mesg シネマスクリーン シネマ フェードアウト 1
}


// 全マップ共通
	// ドア＆マップ切り替え関係
	// ------------------------------------
	proc ドア設置 {
