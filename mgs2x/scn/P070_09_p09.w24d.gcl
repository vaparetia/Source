proc w24aの平行光環境光 {
	chara 環境光 amb \
		 -c 24 45 59

	chara 平行光 para \
		 -c 51 56 45 \
		 -p 0 -9800 -1960	// 原点からこの位置に向かって光が射す
}

proc w20dの平行光環境光 {
	chara 環境光 amb \
		 -c 38 48 48

	chara 平行光 para \
		 -c 58 63 68 \
		 -p 0 -8140 -5800	// 原点からこの位置に向かって光が射す
}

/***************************************************************************************************/
// 濁流
/***************************************************************************************************/
	proc 濁流スタート {
		chara 濁流 NewPassingSplash0 \
			-n  7425 0 -69525 1300 \
			   10425 0 -69525 1300 \
			   10425 0 -39525 1300 \
			-h  1200 \
			-p  2 \
			-s  50

		chara 濁流 NewPassingSplash1 \
			-n  7425 0 -69525 1300 \
			   10425 0 -69525 1300 \
			   10425 0 -39525 1300 \
			-h  1000 \
			-p  1 \
			-s  200

		chara 濁流 NewPassingSplash2 \
			-n  7425 0 -69525 1300 \
			   10425 0 -69525 1300 \
			   10425 0 -39525 1300 \
			-h  1000 \
			-p  0 \
			-s  200

		chara delay ディレイ -time 20 -exec{
			chara 濁流 NewPassingSplash0 \
				-n  7425 500 -69525 1300 \
				   10425 500 -69525 1300 \
				   10425 500 -39525 1300 \
				-h  1200 \
				-p  2 \
				-s  30

#if 0
			chara 濁流 NewPassingSplash1 \
				-n  7425 500 -69525 1300 \
				   10425 500 -69525 1300 \
				   10425 500 -39525 1300 \
				-h  1000 \
				-p  1 \
				-s  200
#endif
			chara 濁流 NewPassingSplash2 \
				-n  7425 500 -69525 1300 \
