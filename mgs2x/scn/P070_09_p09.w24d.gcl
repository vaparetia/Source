/***************************************************************************************************/
// マップ起動
/***************************************************************************************************/
chara マップ アーセナル浮上ステージ -h d:HZX_NAME,0 -l d:LT2_NAME0

/***************************************************************************************************/
// マップ設定
/***************************************************************************************************/

command マップ設定 アーセナル浮上ステージ -set {

//	デモ環境かゲーム環境かで起動を読み分ける。
// ------------------------------------
#if d:MGS2_DEMO

chara デモアクトデバッグ demodebug  -i t:p070_09_p09 -d 'p070_09_p09' -l   \
		-p ステージオン ステージオフ ＡＧ影オン ＡＧ影オフ 濁流スタート 濁流ストップ \
		   衝突防止警告灯オン 衝突防止警告灯オフ

	eval($s:d_num = P070_02_p02)

#else

// 実際の再生
//-----------------------------------------------------------
	// 実際のデモ再生の方も、ストーリーフラグで変える
	// 実際のデモ再生の方も、ストーリーフラグで変える
	if($f:P070_10_R01_ＡＧ起動１０無線機デモ１後から始めます){

		@rt_P070_10_R01ＡＧ起動１０無線機デモ１終了

	}else if($w:p_story == d:ST:P070_09b_P09ＡＧ起動９ｂポリゴンデモ９開始) {
		print '$w:p_story = ST:P070_09b_P09ＡＧ起動９ｂポリゴンデモ９開始'

		/* アーセナル浮上（部分ディテールのみ見せる） */

		// デモ特有の変数代入
		eval($s:d_num = P070_09b_p09)

		@デモモデル差し替え処理
		proc デモ再生_P070_09b_p09 {
			chara demo デモ再生 \
				-i t:p070_09_p09 \
//				-i t:data_dummy_raiden \
				-p ステージオン ステージオフ ＡＧ影オン ＡＧ影オフ 濁流スタート 濁流ストップ \
				   衝突防止警告灯オン 衝突防止警告灯オフ \
				-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
				-next P070_09b_p09終了
		}

		@デモ再生_P070_09b_p09

	} else if(d:ST:P070_09b_P09ＡＧ起動９ｂポリゴンデモ９終了 <= $w:p_story && \
					$w:p_story < d:ST:P070_10_R01ＡＧ起動１０無線機デモ１開始) {
		eval($w:p_story = d:ST:P070_10_R01ＡＧ起動１０無線機デモ１開始)
		print '$w:p_story = ST:P070_10_R01ＡＧ起動１０無線機デモ１開始'

		/* ローズ強制コール　セーブするかしないか聞いてくる */

		// デモ特有の変数代入
		eval($s:d_num = P070_10_r01)

		@rt_P070_10_R01ＡＧ起動１０無線機デモ１
		/* P070_10_r01終了 */
		/*
		eval($w:p_story = d:ST:P070_10_R01ＡＧ起動１０無線機デモ１終了)
		// 拷問部屋へ。polydemo_w41a.h でいきなりムービーを始めるために、
		//もう一個ストーリーフラグを進めておく。
		eval($w:p_story = d:ST:P070_11_M02ＡＧ起動１１ムービーデモ２開始)
		@mv_w24d_w41a_0
		*/

	}

#endif


