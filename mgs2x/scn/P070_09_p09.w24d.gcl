	proc 濁流ストップ {
		mesg 濁流 NewPassingSplash0  殺す
		mesg 濁流 NewPassingSplash1  殺す
		mesg 濁流 NewPassingSplash2  殺す
		mesg 濁流 NewPassingSplash3  殺す
		mesg 濁流 NewPassingSplash4  殺す
		mesg 濁流 NewPassingSplash5  殺す
		mesg 濁流 NewPassingSplash6  殺す
		mesg 濁流 NewPassingSplash7  殺す
		mesg 濁流 NewPassingSplash8  殺す
		mesg 濁流 NewPassingSplash9  殺す
		mesg 濁流 NewPassingSplash10 殺す
	}

/***************************************************************************************************/
// 海面
/***************************************************************************************************/
proc 海面セット {
	chara 巨大海面 seaseasea \
		-mipmap 3 50000 0 \
		-size 400000 400000 \
		-light_enable \
		-tex w10c_oil_sea \
		w10c_oil_sea_256_alp_ovl \
		w10c_oil_sea_128_alp_ovl \
		w10c_oil_sea_64_alp_ovl \
		w10c_oil_sea_32_alp_ovl \
		-pos 0,-40000,0
}

/***************************************************************************************************/
// 衝突防止警告灯
/***************************************************************************************************/
// 2001/08/15 Uehara Masatoshi
proc 衝突防止警告灯 {
	// P001_01_p01.gclでの設定と連動しているので注意
	eval($i:pos_x = 0)
	eval($i:pos_y = 0)
	eval($i:pos_z = 0)
	eval($i:rot_y = 0)
	eval($i:red_a = 64)	// α
	eval($i:nml_a = 96)	// α

	// 赤色警告灯のパラメータ
	eval($s:red_mdl = rcm_l_msk)	// モデル名
	eval($i:red_r = 255)	// Ｒ
	eval($i:red_g = 0)		// Ｇ
	eval($i:red_b = 0)		// Ｂ
	eval($i:red_s = 400)	// スケール
	eval($i:red_f = 180)	// 明滅間隔

	// 通常警告灯のパラメータ
	eval($s:nml_mdl = w_bonbori)	// モデル名
	eval($i:nml_r = 96)		// Ｒ
	eval($i:nml_g = 208)	// Ｇ
	eval($i:nml_b = 96)		// Ｂ
	eval($i:nml_s = 250)	// スケール
	eval($i:nml_f = 0)		// 明滅間隔

	// Ａ脚からＤ脚まで
	chara プラント明滅ライト ＡＥＦ脚赤色警告灯 \
	-t $s:red_mdl \
	-p \
		 18000, 5000,       0, \	// Ａ脚
		 -9250, 5000,   16022, \	// Ａ脚
		 -9250, 5000,  -16022, \	// Ａ脚
		 54037, 42198,  -90043 \	// Ｅ脚クレーン
		 45190, 30851,  -90043 \	// Ｅ脚クレーン
		 34249, 21750,  -90793 \	// Ｅ脚クレーン
		 69808, 12331, -111852 \	// Ｅ脚
		 69808, 12331,  -79734 \	// Ｅ脚
		 43190, 12331,  -79734 \	// Ｅ脚
		 43190, 12331, -111852 \	// Ｅ脚
		 33499,  5000,  -30022 \	// Ｆ脚
		 61249,  5000,  -46043 \	// Ｆ脚
		 61249,  5000,  -14000 \	// Ｆ脚
	-r $i:rot_y \
	-u $i:pos_x, $i:pos_y, $i:pos_z \
	-c $i:red_r, $i:red_g, $i:red_b, $i:red_a \
	-s $i:red_s \
	-f $i:red_f

	chara プラント明滅ライト ＡＥＦ脚通常警告灯 \
	-t $s:nml_mdl \
	-p \
		 -4065, -18000,   1684 \	// Ａ脚
		 -4065, -28500,  -1684 \	// Ａ脚
		 56064, -18000,  -91748 \	// Ｅ脚
		 56064, -28500,  -91748 \	// Ｅ脚
		 47934, -18000,  -31905 \	// Ｆ脚
		 47934, -28500,  -31705 \	// Ｆ脚
	-r $i:rot_y \
	-u $i:pos_x, $i:pos_y, $i:pos_z \
	-c $i:nml_r, $i:nml_g, $i:nml_b, $i:nml_a \
	-s $i:nml_s \
	-f $i:nml_f

	// SHELL１・SHELL２
	chara プラント明滅ライト ＳＨＬ１赤色警告灯 \
	-t $s:red_mdl \
	-p \
		  1284, 24700,  -56103 \	// SHELL１
		-36599, 14800,  -66992 \	// SHELL１
		-14751, 14800,  -59040 \	// SHELL１
		 16059, 15000,  -49689 \	// SHELL１
		-20364,  7000,  -36992 \	// SHELL１
		 20364,  7000,  -83094 \	// SHELL１
		-20364,  7000,  -83094 \	// SHELL１
		 23051,  7000,  -80407 \	// SHELL１
	-r $i:rot_y \
	-u $i:pos_x, $i:pos_y, $i:pos_z \
	-c $i:red_r, $i:red_g, $i:red_b, $i:red_a \
	-s $i:red_s \
	-f $i:red_f

	chara プラント明滅ライト ＳＨＬ１通常警告灯 \
	-t $s:nml_mdl \
	-p \
		-22500,  -9000,  -40543 \	// SHELL１
		-21541, -28500,  -42095 \	// SHELL１
		 22500,  -9000,  -40543 \	// SHELL１
		 21541, -28500,  -42095 \	// SHELL１
		-22500,  -9000,  -79543 \	// SHELL１
		-21541, -28500,  -77991 \	// SHELL１
		 22500,  -9000,  -79543 \	// SHELL１
		 21541, -28500,  -77991 \	// SHELL１
	-r $i:rot_y \
	-u $i:pos_x, $i:pos_y, $i:pos_z \
	-c $i:nml_r, $i:nml_g, $i:nml_b, $i:nml_a \
	-s $i:nml_s \
	-f $i:nml_f


	// ＡＢ・ＢＣ連絡橋
	chara プラント明滅ライト ＡＢＣ連絡橋通常警告灯 \
	-t $s:nml_mdl \
	-p \
		-26964,     0,  -21341 \	// ＡＢ連絡橋
		-20000,     0,  -17341 \	// ＡＢ連絡橋
		-31964,     0,  -12681 \	// ＡＢ連絡橋
		-25035,     0,   -8681 \	// ＡＢ連絡橋
		-50999,     0,  -66043 \	// ＢＣ連絡橋
		-52999,     0,  -66043 \	// ＢＣ連絡橋
		-52999,     0,  -54043 \	// ＢＣ連絡橋
		-50999,     0,  -54043 \	// ＢＣ連絡橋
		-39999, -1500,  -61043 \	// ＢＣ連絡橋シェル１方面
		-39999, -1500,  -59043 \	// ＢＣ連絡橋シェル１方面
		-29999, -1500,  -61043 \	// ＢＣ連絡橋シェル１方面
		-29999, -1500,  -59043 \	// ＢＣ連絡橋シェル１方面
	-r $i:rot_y \
	-u $i:pos_x, $i:pos_y, $i:pos_z \
	-c $i:nml_r, $i:nml_g, $i:nml_b, $i:nml_a \
	-s $i:nml_s \
	-f $i:nml_f

	// ＤＥ・ＥＦ・ＦＡ連絡橋
	chara プラント明滅ライト ＤＥＦＡ連絡橋通常警告灯 \
	-t $s:nml_mdl \
	-p \
		20332,     0, -107209 \	// ＤＥ連絡橋
		31696,     0, -102941 \	// ＤＥ連絡橋
		30696,     0, -101209 \	// ＤＥ連絡橋
		21303,     0, -108941 \	// ＤＥ連絡橋
		50999,     0,  -69043 \	// ＥＦ連絡橋
		52999,     0,  -69043 \	// ＥＦ連絡橋
		52999,     0,  -51043 \	// ＥＦ連絡橋
		50999,     0,  -51043 \	// ＥＦ連絡橋
		39999, -1500,  -61043 \	// ＥＦ連絡橋シェル１方面
		39999, -1500,  -59043 \	// ＥＦ連絡橋シェル１方面
		29999, -1500,  -61043 \	// ＥＦ連絡橋シェル１方面
		29999, -1500,  -59043 \	// ＥＦ連絡橋シェル１方面
		22035,     0,  -13877 \	// ＦＡ連絡橋
		29830,     0,  -18377 \	// ＦＡ連絡橋
		23038,     0,  -12145 \	// ＦＡ連絡橋
		30830,     0,  -16645 \	// ＦＡ連絡橋
	-r $i:rot_y \
	-u $i:pos_x, $i:pos_y, $i:pos_z \
	-c $i:nml_r, $i:nml_g, $i:nml_b, $i:nml_a \
	-s $i:nml_s \
	-f $i:nml_f
}

proc 衝突防止警告灯オン{
	mesg プラント明滅ライト ＡＥＦ脚赤色警告灯 ＯＮ
	mesg プラント明滅ライト ＡＥＦ脚通常警告灯 ＯＮ
	mesg プラント明滅ライト ＳＨＬ１赤色警告灯 ＯＮ
	mesg プラント明滅ライト ＳＨＬ１通常警告灯 ＯＮ
	mesg プラント明滅ライト ＡＢＣ連絡橋通常警告灯 ＯＮ
	mesg プラント明滅ライト ＤＥＦＡ連絡橋通常警告灯 ＯＮ
}

proc 衝突防止警告灯オフ{
	mesg プラント明滅ライト ＡＥＦ脚赤色警告灯 ＯＦＦ
	mesg プラント明滅ライト ＡＥＦ脚通常警告灯 ＯＦＦ
	mesg プラント明滅ライト ＳＨＬ１赤色警告灯 ＯＦＦ
	mesg プラント明滅ライト ＳＨＬ１通常警告灯 ＯＦＦ
	mesg プラント明滅ライト ＡＢＣ連絡橋通常警告灯 ＯＦＦ
	mesg プラント明滅ライト ＤＥＦＡ連絡橋通常警告灯 ＯＦＦ
}

/***************************************************************************************************/
// 切り替えプロック
/***************************************************************************************************/
	proc ステージオン {
		mesg プットオブジェ w24a0 on
		mesg プットオブジェ w24a1 on
		mesg プットオブジェ エレベーター前天井 on
		mesg プットオブジェ アーセナル前天井 on
		mesg プットオブジェ 電算室天井 on
		mesg プットオブジェ エレベーター天井 on
		mesg プットオブジェ ステージ本体０ on
		mesg プットオブジェ ステージ本体１ on
		mesg プットオブジェ ステージ本体２ on
		mesg プットオブジェ ステージ本体３ on
		mesg プットオブジェ ステージ本体４ on
		mesg プットオブジェ POS on
	}
	proc ステージオフ {
		mesg プットオブジェ w24a0 off
		mesg プットオブジェ w24a1 off
		mesg プットオブジェ エレベーター前天井 off
		mesg プットオブジェ アーセナル前天井 off
		mesg プットオブジェ 電算室天井 off
		mesg プットオブジェ エレベーター天井 off
		mesg プットオブジェ ステージ本体０ off
		mesg プットオブジェ ステージ本体１ off
		mesg プットオブジェ ステージ本体２ off
		mesg プットオブジェ ステージ本体３ off
		mesg プットオブジェ ステージ本体４ off
		mesg プットオブジェ POS off
	}

	proc ＡＧ影オン {
		mesg プットオブジェ ＡＧ影 on
	}
	proc ＡＧ影オフ {
		mesg プットオブジェ ＡＧ影 off
	}

/***************************************************************************************************/
// 水中セット
/***************************************************************************************************/

proc 水中セット {
	chara カメラ泡 泡ぶくマン -n 2
	chara カメラダスト ダストマン -n 1
}
