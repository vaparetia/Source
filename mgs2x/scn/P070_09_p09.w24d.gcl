	// フォグ
	// ------------------------------------
	proc フォグ設定 {
		chara フォグ 霧 \
			-c 220,237,198 \
			-n (-16000) \
			-f (800000) \
			-z 					// ファークリップ機能追加（山下）
	}

	// エフェクト関係
	// -----------------------------------
	proc エフェクト設定 {
		//	chara ブラー ブラー

			chara Ｚフォーカス管理 Z_manager
//			mesg Ｚフォーカス管理 Z_manager パラメータ 5000 30

			chara ＯＦＦ制御 off_man
			mesg ＯＦＦ制御 off_man ボディシャドウＯＦＦ
	}



// 各マップ別設定
// ------------------------------------
// シェル１中央棟Ｂ３電算室


	// ステージモデルセット
	// ------------------------------------
	proc シェル１中央棟Ｂ３電算室ステージ本体設置 {
		@w20dの平行光環境光
		chara プットオブジェ ステージ本体０ \
			-m d:KMS_NAME0 \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME1

		chara プットオブジェ ステージ本体１ \
			-m d:KMS_NAME1 \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME1

		chara プットオブジェ ステージ本体２ \
			-m d:KMS_NAME2 \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME1

		chara プットオブジェ ステージ本体３ \
			-m d:KMS_NAME3 \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME1

		chara プットオブジェ ステージ本体４ \
			-m d:KMS_NAME4 \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME1
		@w24aの平行光環境光

		mesg プットオブジェ ステージ本体０ off
		mesg プットオブジェ ステージ本体１ off
		mesg プットオブジェ ステージ本体２ off
		mesg プットオブジェ ステージ本体３ off
		mesg プットオブジェ ステージ本体４ off
	}

/***************************************************************************************************/
// シェル１中央棟Ｂ３電算室天井設置
/***************************************************************************************************/
	proc シェル１中央棟Ｂ３電算室天井設置 {
		@w20dの平行光環境光
		chara プットオブジェ エレベーター前天井 \
			-m d:CEIL_NAME0 \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME1

		chara プットオブジェ アーセナル前天井 \
			-m d:CEIL_NAME1 \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME1

		chara プットオブジェ 電算室天井 \
			-m d:CEIL_NAME2 \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME1
#if 0
		chara プットオブジェ エレベーター天井 \
			-m elv_2r \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME1
#endif
		// これは壁
//		chara プットオブジェ 南側壁 \
//			-m w24d2_wall \
//			-r 0,0,0 \
//			-p 0,0,0 \
//			-s 100,100,100 \
//			-l d:LT2_NAME
		@w24aの平行光環境光

		mesg プットオブジェ エレベーター前天井 off
		mesg プットオブジェ アーセナル前天井 off
		mesg プットオブジェ 電算室天井 off
//		mesg プットオブジェ エレベーター天井 off
	}


/***************************************************************************************************/
// シェル１中央棟１Ｆ
/***************************************************************************************************/
	proc シェル１中央棟１Ｆ {
		chara プットオブジェ w24a0 \
			-m d:KMS_W24A_NAME0 \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME0

		chara プットオブジェ w24a1 \
			-m d:KMS_W24A_NAME1 \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME0

		mesg プットオブジェ w24a0 off
		mesg プットオブジェ w24a1 off
	}

/***************************************************************************************************/
// アーセナル影設置
/***************************************************************************************************/
	proc ＡＧ影 {
		chara プットオブジェ ＡＧ影 \
			-m d:KMS_AG \
			-r 0,0,0 \
			-p 0,-60000,0 \
			-s 1000,1000,1000 \
			-l d:LT2_NAME0

		mesg プットオブジェ ＡＧ影 off
	}


/***************************************************************************************************/
// ポスター設置
/***************************************************************************************************/
	proc ポスター {
		chara プットオブジェ POS \
			-m d:KMS_POS \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME0
		mesg プットオブジェ POS off
	}

