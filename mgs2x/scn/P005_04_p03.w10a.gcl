	chara 汎用空 空 \
		-c 150 175 175 \
		-pos 0 -18000 0 \ //　各ステージの空の位置
		-f 0 \
		-l 32 \
		-t 4 \
			sky_d1_alp 180 196 175 100 \
			sky_d2_alp 152 166 154 50 \
			0 0 0 0 0 \
			sky_d4_alp 145 163 155 50 \
		-m 1 \
			d_sky_wall1 88 98 94 -100 0

	chara 太陽 ソル \
		-p 0 -40000 -150000 \ 	//中心の位置
		-f 3650 -1200 3200 \	//平行光源の-pと同じ値
		-a 9 \					//alpha
		-l 32 \
		-w (240*32) \
		-h (240*32) \
		-t sky_sun_d_alp
}

proc 夜空設置 {
