// 2001/08/09 Uehara Masatoshi
proc かもめ優雅に飛び回る
{
	// 特にランダムにする意味はないのだが
	eval($i:k40_y = 1024 + `%rand 2048`)
	eval($i:k41_y = 1024 + `%rand 2048`)
	eval($i:k42_y = 1024 + `%rand 2048`)
	eval($i:k43_y = 1024 + `%rand 2048`)
	eval($i:k44_y = 1024 + `%rand 2048`)
	eval($i:k45_y = 1024 + `%rand 2048`)
	eval($i:k46_y = 1024 + `%rand 2048`)
	eval($i:k47_y = 1024 + `%rand 2048`)
	eval($i:k48_y = 1024 + `%rand 2048`)
	eval($i:k49_y = 1024 + `%rand 2048`)
	eval($i:k50_y = 1024 + `%rand 2048`)
	eval($i:k51_y = 1024 + `%rand 2048`)
	eval($i:k52_y = 1024 + `%rand 2048`)
