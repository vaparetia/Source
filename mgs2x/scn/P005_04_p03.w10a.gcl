// 2001/08/15 Uehara Masatoshi
proc 衝突防止警告灯 {
	// 冒頭デモ用修正値
	// @プラント遠景モデルセットの値と連動しているので注意！
	eval($i:pos_x = 0)
	eval($i:pos_y = 0)
	eval($i:pos_z = 0)
	eval($i:rot_y = 0)
	eval($i:red_a = 64)	// α
	eval($i:nml_a = 96)	// α

	// 赤色警告灯のパラメータ
	eval($s:red_mdl = rcm_l_msk)	// モデル名
	eval($i:red_r = 255)	// Ｒ
	eval($i:red_g = 0)		// Ｇ
	eval($i:red_b = 0)		// Ｂ
	eval($i:red_s = 400)	// スケール
	eval($i:red_f = 180)	// 明滅間隔

	// 通常警告灯のパラメータ
	eval($s:nml_mdl = w_bonbori)	// モデル名
	eval($i:nml_r = 96)		// Ｒ
	eval($i:nml_g = 208)	// Ｇ
	eval($i:nml_b = 96)		// Ｂ
	eval($i:nml_s = 250)	// スケール
	eval($i:nml_f = 0)		// 明滅間隔

	// Ａ脚からＤ脚まで
	chara プラント明滅ライト ＡＢＣＤ脚赤色警告灯 \
	-t $s:red_mdl \
	-p \
		 18000, 5000,       0, \	// Ａ脚
		 -9250, 5000,   16022, \	// Ａ脚
		 -9250, 5000,  -16022, \	// Ａ脚
		-42749, 5000,  -46043, \	// Ｂ脚
		-42749, 5000,  -14000, \	// Ｂ脚
		-70500, 5000,  -30021, \	// Ｂ脚
		-42749, 5000,  -74043, \	// Ｃ脚
		-70500, 5000,  -90064, \	// Ｃ脚
		-42749, 5000, -106086, \	// Ｃ脚
		  9250, 5000, -104064, \	// Ｄ脚
		  9250, 5000, -136107, \	// Ｄ脚
		-18500, 5000, -120086, \	// Ｄ脚
	-r $i:rot_y \
	-u $i:pos_x, $i:pos_y, $i:pos_z \
	-c $i:red_r, $i:red_g, $i:red_b, $i:red_a \
	-s $i:red_s \
	-f $i:red_f

	chara プラント明滅ライト ＡＢＣＤ脚通常警告灯 \
	-t $s:nml_mdl \
	-p \
		 -4065, -18000,   1684 \	// Ａ脚
		 -4065, -28500,  -1684 \	// Ａ脚
		-47930, -18000, -31705 \	// Ｂ脚
		-47930, -28500, -31705 \	// Ｂ脚
		-47934, -18000, -91748 \	// Ｃ脚
		-47934, -28500, -91748 \	// Ｃ脚
		  4065, -18000, -121770 \	// Ｄ脚
		  4065, -28500, -121770 \	// Ｄ脚
	-r $i:rot_y \
	-u $i:pos_x, $i:pos_y, $i:pos_z \
	-c $i:nml_r, $i:nml_g, $i:nml_b, $i:nml_a \
	-s $i:nml_s \
	-f $i:nml_f

