// 各gclで必要なdefine
// ------------------------------------
// モード
#define		STAGE_PLANT		1		// 共通プロック切り分け用
#define		DEMO_STAGE		1		// デモステージかどうかで起動するキャラを切り分ける

// 各種スイッチ用define
// ------------------------------------
// デバッグ関係
#define		SCREENSHOT		0		// スクリーンショット
#define		USB_KEY			0		// USBキーボード


// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME		d00a3
#define		LT2_NAME		w10a
//#define		LT2_NAME_100	w10a_scale100
//#define		LT2_NAME_PLANT	w10c_plant

#define		LT2_NAME_PLANT_MORNING	w12a
#define		LT2_NAME_PLANT_DAY		w10c_day
#define		LT2_NAME_PLANT_EVENING	w32b

#if d:MGS2_DEMO
	// デモデバッグ用、切り替えスイッチ
	// 0 : p005_04_p03
	// 1 : p014_10_p03
	// 2 : p070_08_p07
	#define DEMO_DAY_STATUS 0
#endif

// include
// ------------------------------------
#include "5sec_bfr_demo.h"
#include "demo_vardef.h"
#include "demo_stdch.h"
#include "demo_stdch2.h"
#include "story.h"
#include "sload.h"

#include "p_force_cdc.ch"

#if d:USB_KEY
	#include "usbkbd.h"
#endif

#if d:PLANT_DEMO_ALL_SKIP
	#define		DEMO_SKIP_ENABLE 1
#else
	#define		DEMO_SKIP_ENABLE 0
#endif

// マップ設定
// ------------------------------------

#if d:MGS2_DEMO
if(d:DEMO_DAY_STATUS == 0) {
	chara マップ プラント遠景ほか -h d:HZX_NAME -l d:LT2_NAME_PLANT_MORNING
} else if(d:DEMO_DAY_STATUS == 1) {
	chara マップ プラント遠景ほか -h d:HZX_NAME -l d:LT2_NAME_PLANT_DAY
} else if(d:DEMO_DAY_STATUS == 2) {
	chara マップ プラント遠景ほか -h d:HZX_NAME -l d:LT2_NAME_PLANT_EVENING
}
#else
if( d:ST:P005_03_R01ライデン昇降機上昇３無線デモ１終了 <= $w:p_story && \
	$w:p_story < d:ST:P005_04_P03ライデン昇降機上昇４ポリゴンデモ３開始) {
		chara マップ プラント遠景ほか -h d:HZX_NAME -l d:LT2_NAME_PLANT_MORNING
} else if($w:p_story == d:ST:P014_10_P03ピーター遭遇１０ポリゴンデモ３開始) {
		chara マップ プラント遠景ほか -h d:HZX_NAME -l d:LT2_NAME_PLANT_DAY
} else if($w:p_story == d:ST:P070_07_P06ＡＧ起動７ポリゴンデモ６終了) {
	chara マップ プラント遠景ほか -h d:HZX_NAME -l d:LT2_NAME_PLANT_EVENING
}
#endif

command マップ設定 プラント遠景ほか -set {

//	デモ環境かゲーム環境かで起動を読み分ける。
// ------------------------------------
#if d:MGS2_DEMO

chara デモアクトデバッグ demodebug  -i t:p005_04_p03 -d 'p005_04_p03' -l   \
		-p 空オフ 空オン

if(d:DEMO_DAY_STATUS == 0) {
	eval($s:d_num = P005_04_p03)
} else if(d:DEMO_DAY_STATUS == 1) {
	eval($s:d_num = P014_10_p03)
} else if(d:DEMO_DAY_STATUS == 2) {
	eval($s:d_num = P070_08_p07)
}


#else

// 実際の再生
//-----------------------------------------------------------
	// 実際のデモ再生の方も、ストーリーフラグで変える
	if( d:ST:P005_03_R01ライデン昇降機上昇３無線デモ１終了 <= $w:p_story && \
					$w:p_story < d:ST:P005_04_P03ライデン昇降機上昇４ポリゴンデモ３開始) {
		eval($w:p_story = d:ST:P005_04_P03ライデン昇降機上昇４ポリゴンデモ３開始)
		print '$w:p_story = ST:P005_04_P03ライデン昇降機上昇４ポリゴンデモ３開始'

		/* 昇降機上昇　ビッグシェル全景表示 */

		// デモ特有の変数代入
		eval($s:d_num = P005_04_p03)

		@デモモデル差し替え処理
		proc デモ再生_P005_04_p03 {
			chara demo デモ再生 \
				-i t:p005_04_p03 \
				-p 空オフ 空オン \
				-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
				-next P005_04_p03終了
		}

		@デモ再生_P005_04_p03

	} else if( d:ST:P005_04_P03ライデン昇降機上昇４ポリゴンデモ３終了 <= $w:p_story && \
					$w:p_story < d:ST:P005_05_R02ライデン昇降機上昇５無線デモ２開始) {

		/* 大佐強制コール　ノード探してみそ */

		// デモ特有の変数代入
		eval($s:d_num = P005_05_r02)

		@rt_P005_05_R02ライデン昇降機上昇５無線デモ２
		/* P005_05_r02終了 */
		/*
		eval($w:p_story = d:ST:P005_05_R02ライデン昇降機上昇５無線デモ２終了)
		// ゲームへ
		@ゲームステージへ戻る
		@mv_w11a2_w12a_0
		*/

	} else if($w:p_story == d:ST:P014_10_P03ピーター遭遇１０ポリゴンデモ３開始) {
		print '$w:p_story = ST:P014_10_P03ピーター遭遇１０ポリゴンデモ３開始'

		/* ビッグシェルの全景　どこを爆破するかの推理 */

		// デモ特有の変数代入
		eval($s:d_num = P014_10_p03)

		@デモモデル差し替え処理
		proc デモ再生_P014_10_p03 {
			chara demo デモ再生 \
//				-i t:data_dummy_raiden \
				-i t:p014_10_p03 \
				-p 空オフ 空オン \
				-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
				-next P014_10_p03終了
		}

		@デモ再生_P014_10_p03

	} else if($w:p_story == d:ST:P070_07_P06ＡＧ起動７ポリゴンデモ６終了) {
		eval( $w:p_story = d:ST:P070_08_P07ＡＧ起動８ポリゴンデモ７開始 )

		eval($s:d_num = P070_08_p07)

		@デモモデル差し替え処理
		chara demo デモ再生 \
			-i t:p070_08_p07 \
			-p 空オフ 空オン \
			-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
			-next P070_08_p07終了
	}

#endif


// 以下、諸々セット
//-----------------------------------------------------------
	// デモキャンセルは全てのデモで共通につかう
	@常駐キャラ設定						// stdch.hで定義

	chara デモキャンセルチェック デモキャンセル \
		-p demo_cancel

	@シネマスクリーンセット

	// デモによる必要なローテーション、オフセット、あるいはモデルそれ自身
	// 確認してセットすること。

	if($s:d_num == P005_04_p03) {
		@朝プラント遠景モデルセット
		@朝空設置
		@朝フォグ設定
		@朝海面セット
		@かもめ優雅に飛び回る
	} else if($s:d_num == P014_10_p03) {
		@昼プラント遠景モデルセット
		@昼空設置
		@昼フォグ設定
		@昼海面セット
		@かもめ優雅に飛び回る
	} else if($s:d_num == P070_08_p07) {
		@夜プラント遠景モデルセット
		@夜空設置
		@夜フォグ設定
		@夜海面セット
		@衝突防止警告灯
	}

	@エフェクト設定
	@デバッグキャラセット

} // 「command マップ設定 プラント遠景ほか」の閉じカッコ

// ====================================
// 初期マップ表示
// ====================================
	command マップ表示 -show プラント遠景ほか



// 各proc設定
//-------------------------------------------------------------------------------------
// デモ環境で共用のプロック
//-----------------------------------------------------------
	proc null {}

	proc demo_cancel {
		command StreamStopAll
	}

	proc restart_proc {
		restart
	}

	proc P005_04_p03終了 {
		@デモ終了時シネマスクリーンオフ
		mesg デモキャンセルチェック デモキャンセル kill

		print '$w:p_story = d:ST:P005_04_P03ライデン昇降機上昇４ポリゴンデモ３終了'
		eval($w:p_story = d:ST:P005_04_P03ライデン昇降機上昇４ポリゴンデモ３終了)

		chara delay ディレイ -time 1 -exec{
//			load 'd005p01'
			restart
		}
	}

	proc P014_10_p03終了 {
		@デモ終了時シネマスクリーンオフ
		mesg デモキャンセルチェック デモキャンセル kill
		#if d:DEMO_SKIP_ENABLE
			print '$w:p_story = d:ST:P014_15_P07ピーター遭遇１５ポリゴンデモ７終了'
			eval($w:p_story = d:ST:P014_15_P07ピーター遭遇１５ポリゴンデモ７終了)
		#else
			print '$w:p_story = d:ST:P014_10_P03ピーター遭遇１０ポリゴンデモ３終了'
			eval($w:p_story = d:ST:P014_10_P03ピーター遭遇１０ポリゴンデモ３終了)
		#endif

		chara delay ディレイ -time 1 -exec{
			load 'd014p01'
		}
	}

	proc P070_08_p07終了 {
		@デモ終了時シネマスクリーンオフ

		mesg デモキャンセルチェック デモキャンセル kill

		print '$w:p_story = d:ST:P070_08_P07ＡＧ起動８ポリゴンデモ７終了'
		eval($w:p_story = d:ST:P070_08_P07ＡＧ起動８ポリゴンデモ７終了)

		chara delay ディレイ \
			-time 1 \
			-exec{
				load 'd070p01'
			}
	}



// シネマスクリーン
proc シネマスクリーンセット {
	chara シネマスクリーン シネマ \
		-top d:CINEMA_BELT_UPPER \
		-bottom d:CINEMA_BELT_LOWER \
		-ftime 60	//デフォルト値（ゼロは駄目）
	mesg シネマスクリーン シネマ フェードアウト 1
}


// 全マップ共通
//-----------------------------------------------------------

	// フォグ
	// ------------------------------------
	proc 朝フォグ設定 {
		chara フォグ 霧 \
			-c 194,199,163 \
			-n (-200000) \
			-f (500000) \
			-z 					// ファークリップ機能追加（山下）
	}

	proc 昼フォグ設定 {
		chara フォグ 霧 \
			-c 200,220,220 \
			-n (-35000) \
			-f (350000)
	}

	proc 夜フォグ設定 {
		chara フォグ 霧 \
			-c 5,17,21 \
			-n (-100000) \
			-f (800000) \
			-z 					// ファークリップ機能追加（山下）
	}

	// エフェクト関係
	// -----------------------------------
	proc エフェクト設定 {
			chara Ｚフォーカス管理 Z_manager
	}



// プラント全景
// ------------------------------------
// プラント全景朝用設定。ライトが違うだけ
proc 朝プラント遠景モデルセット {
	// プラント座標オフセット値
	eval($i:d001p01_plt_x = 0)
	eval($i:d001p01_plt_y = 0)
	eval($i:d001p01_plt_z = 0)

	// プラント回転オフセット値。Ｙのみ必要。
	eval($i:d001p01_rot_y = 0)

	command foreach -argc 2 -repeat 34 \
		 -data { \
//			{ 全景_w10c_12a,     w10c_12a }
			{ 全景_w10c_12a,     w10c_12b }
			{ 全景_w10c_13a,     w10c_13a }
			{ 全景_w10c_14a,     w10c_14a }
			{ 全景_w10c_15a,     w10c_15a }
			{ 全景_w10c_16a,     w10c_16a }
			{ 全景_w10c_17a,     w10c_17a }
			{ 全景_w10c_18a,     w10c_18a }
			{ 全景_w10c_19a,     w10c_19a }
			{ 全景_w10c_20a,     w10c_20a }
			{ 全景_w10c_20b,     w10c_20b }
			{ 全景_w10c_21a,     w10c_21a }
			{ 全景_w10c_22a,     w10c_22a }
			{ 全景_w10c_23a,     w10c_23a }
			{ 全景_w10c_24a,     w10c_24a }
			{ 全景_w10c_25a,     w10c_25a }
			{ 全景_w10c_31a,     w10c_31a }
			{ 全景_w10c_gh,      w10c_gh  }
			{ 全景_w10c_gl,      w10c_gl  }
			{ 全景_w10c_h,       w10c_h   }
			{ 全景_w10c_hi,      w10c_hi  }
			{ 全景_w10c_i,       w10c_i   }
			{ 全景_w10c_ij,      w10c_ij  }
			{ 全景_w10c_j,       w10c_j   }
			{ 全景_w10c_jk,      w10c_jk  }
			{ 全景_w10c_k,       w10c_k   }
			{ 全景_w10c_kl,      w10c_kl  }
			{ 全景_w10c_l,       w10c_l   }
			{ 全景_w10c_crane,   w10c_crane }
			{ 全景_w10c_other00, w10c_other00 }
			{ 全景_w10c_other01, w10c_other01 }
			{ 全景_w10c_other02, w10c_other02 }
			{ 全景_w10c_32a,     w10c_32a }
			{ 全景_w10c_32b,     w10c_32b }
			{ 全景_w10c_32c,     w10c_32c }
		} \
		-exec {
			chara プットオブジェ $1 \
				-m $2 \
				-p $i:d001p01_plt_x, $i:d001p01_plt_y, $i:d001p01_plt_z \
				-r 0, $i:d001p01_rot_y, 0 \
				-s 100,100,100 \
				-l d:LT2_NAME_PLANT_MORNING \
				-f 0x0200
		}

}

// プラント全景昼用設定。ライトが違うだけ
proc 昼プラント遠景モデルセット {
	// プラント座標オフセット値
	eval($i:d001p01_plt_x = 0)
	eval($i:d001p01_plt_y = 0)
	eval($i:d001p01_plt_z = 0)

	// プラント回転オフセット値。Ｙのみ必要。
	eval($i:d001p01_rot_y = 0)

	command foreach -argc 2 -repeat 34 \
		 -data { \
			{ 全景_w10c_12a,     w10c_12a }
			{ 全景_w10c_13a,     w10c_13a }
			{ 全景_w10c_14a,     w10c_14a }
			{ 全景_w10c_15a,     w10c_15a }
			{ 全景_w10c_16a,     w10c_16a }
			{ 全景_w10c_17a,     w10c_17a }
			{ 全景_w10c_18a,     w10c_18a }
			{ 全景_w10c_19a,     w10c_19a }
			{ 全景_w10c_20a,     w10c_20a }
			{ 全景_w10c_20b,     w10c_20b }
			{ 全景_w10c_21a,     w10c_21a }
			{ 全景_w10c_22a,     w10c_22a }
			{ 全景_w10c_23a,     w10c_23a }
			{ 全景_w10c_24a,     w10c_24a }
			{ 全景_w10c_25a,     w10c_25a }
			{ 全景_w10c_31a,     w10c_31a }
			{ 全景_w10c_gh,      w10c_gh  }
			{ 全景_w10c_gl,      w10c_gl  }
			{ 全景_w10c_h,       w10c_h   }
			{ 全景_w10c_hi,      w10c_hi  }
			{ 全景_w10c_i,       w10c_i   }
			{ 全景_w10c_ij,      w10c_ij  }
			{ 全景_w10c_j,       w10c_j   }
			{ 全景_w10c_jk,      w10c_jk  }
			{ 全景_w10c_k,       w10c_k   }
			{ 全景_w10c_kl,      w10c_kl  }
			{ 全景_w10c_l,       w10c_l   }
			{ 全景_w10c_crane,   w10c_crane }
			{ 全景_w10c_other00, w10c_other00 }
			{ 全景_w10c_other01, w10c_other01 }
			{ 全景_w10c_other02, w10c_other02 }
			{ 全景_w10c_32a,     w10c_32a }
			{ 全景_w10c_32b,     w10c_32b }
			{ 全景_w10c_32c,     w10c_32c }
		} \
		-exec {
			chara プットオブジェ $1 \
				-m $2 \
				-p $i:d001p01_plt_x, $i:d001p01_plt_y, $i:d001p01_plt_z \
				-r 0, $i:d001p01_rot_y, 0 \
				-s 100,100,100 \
				-l d:LT2_NAME_PLANT_DAY \
				-f 0x0200
		}
}

// プラント全景夜用設定。ライトが違うだけ
proc 夜プラント遠景モデルセット {
	// プラント座標オフセット値
	eval($i:d001p01_plt_x = 0)
	eval($i:d001p01_plt_y = 0)
	eval($i:d001p01_plt_z = 0)

	// プラント回転オフセット値。Ｙのみ必要。
	eval($i:d001p01_rot_y = 0)

	command foreach -argc 2 -repeat 34 \
		 -data { \
			{ 全景_w10c_12a,     w10c_12a }
			{ 全景_w10c_13a,     w10c_13a }
			{ 全景_w10c_14a,     w10c_14a }
			{ 全景_w10c_15a,     w10c_15a }
			{ 全景_w10c_16a,     w10c_16a }
			{ 全景_w10c_17a,     w10c_17a }
			{ 全景_w10c_18a,     w10c_18a }
			{ 全景_w10c_19a,     w10c_19a }
			{ 全景_w10c_20a,     w10c_20a }
			{ 全景_w10c_20b,     w10c_20b }
			{ 全景_w10c_21a,     w10c_21a }
			{ 全景_w10c_22a,     w10c_22a }
			{ 全景_w10c_23a,     w10c_23a }
			{ 全景_w10c_24a,     w10c_24a }
//			{ 全景_w10c_25a,     w10c_25a }
			{ 全景_w10c_25a,     w10c_25b }
			{ 全景_w10c_31a,     w10c_31a }
			{ 全景_w10c_gh,      w10c_gh  }
			{ 全景_w10c_gl,      w10c_gl  }
			{ 全景_w10c_h,       w10c_h   }
			{ 全景_w10c_hi,      w10c_hi  }
			{ 全景_w10c_i,       w10c_i   }
			{ 全景_w10c_ij,      w10c_ij  }
			{ 全景_w10c_j,       w10c_j   }
			{ 全景_w10c_jk,      w10c_jk  }
			{ 全景_w10c_k,       w10c_k   }
			{ 全景_w10c_kl,      w10c_kl  }
			{ 全景_w10c_l,       w10c_l   }
			{ 全景_w10c_crane,   w10c_crane }
			{ 全景_w10c_other00, w10c_other00 }
			{ 全景_w10c_other01, w10c_other01 }
			{ 全景_w10c_other02, w10c_other02 }
			{ 全景_w10c_32a,     w10c_32a }
			{ 全景_w10c_32b,     w10c_32b }
			{ 全景_w10c_32c,     w10c_32c }
		} \
		-exec {
			chara プットオブジェ $1 \
				-m $2 \
				-p $i:d001p01_plt_x, $i:d001p01_plt_y, $i:d001p01_plt_z \
				-r 0, $i:d001p01_rot_y, 0 \
				-s 100,100,100 \
				-l d:LT2_NAME_PLANT_EVENING \
				-f 0x0200
		}
}

proc 朝空設置 {
//	@朝空（レンズフレア指定）	0 -40000 0	3650 -1200 3200	2
//	@朝空	0 -40000 0	3650 -1200 3200
	chara 汎用空 空 \
		-c 90 110 95 \
		-pos 0 -40000 0 \ //　各ステージの空の位置
		-f 0 \
		-l 32 \
		-t 4 \
			sky_m1_alp 200 211 200 100 \
			sky_m2_alp 155 165 145 50 \
			0 0 0 0 0 \
			sky_m4_alp 148 171 146 50 \
		-m 1 \
			m_sky_wall1 53 64 55 -100 0

/*
	chara 太陽 ソル \
		-p 0 -40000 0 \ 		//中心の位置
		-f 3650 -1200 3200 \	//平行光源の-pと同じ値
		-a 11 \					//alpha
		-l 32 \
		-w (240*32) \
		-h (240*32) \
		-t sky_sun_m_alp
*/
}

proc 昼空設置 {
//	@昼空（レンズフレア指定）	0 -40000 -150000	3650 -1200 3200	2
