		-m 1 \
			m_sky_wall1 27 27 22 -100 0
//			m_sky_wall1 47 35 21 -100 0
}

proc 空オフ {
	mesg 汎用空 デモ用空 非表示
	mesg 太陽 ソル 非表示
}

proc 空オン {
	mesg 汎用空 デモ用空 表示
	mesg 太陽 ソル 表示
}

