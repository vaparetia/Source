// ローカル変数
//	$f:w41a_捕まったふりビハインドフラグ	捕まったふりをしているかどうか
//	$f:w41a_主観デモフラグ					主観デモかどうか
//	$f:w41a_主観デモ完全終了フラグ			主観デモ関連がすべて終了したかどうか
//	$i:w41a_拷問ベッド角度					拷問ベッドの角度
//	$f:w41a_拷問直後開始時処理終了フラグ	拷問直後開始時処理が終了したかどうか

//	$b:w41a_バグステージ名				//	バグったときのステージ名表記用
										//	0	wn_アーセナルギア空腸
										//	1	wn_アーセナルギア胃
										//	2	wn_青山二丁目
										//	3	wn_麻布十番
										//	4	wn_船橋市
										//	5	wn_ニューヨーク52番街

//	$b:w41a_風邪薬フラグ				//	風邪薬をとったかどうか
//	$f:w41a_ロッカー内フラグ			//	プレイヤーがロッカー内にいるかどうか
//	$f:w41a_捕まったふりバレたフラグ	//	捕まったふりがバレたかどうか
//	$f:w41a_ドアランプフラグ			//	ドアランプ点滅用フラグ
//	$f:w41a_拷問機左側引っかかったフラグ	主観デモＳＥ用
//	$f:w41a_拷問機右側引っかかったフラグ	主観デモＳＥ用

//	$f:w41a_ロッカーに敵入れたフラグ	//	アナザー用（本編では裸のため死体引き摺り出来ないので必要なし）

//	司令官音声

resource ghq_caution_voice {
	w41a:
		$t{
			t:vc040601,	//	指揮官　　「了解、総員、警戒を強化せよ」
			-2,
			t:vc049066,	//	指揮官　　「どうしたんだ？」
			-1
		}
}



//	ドア設定用ステージ内ローカル変数(a_mode.hよりも先に定義する)
dim $$b:ドアフラグ[ 2 ]
dim $$s:ドアモデル名[ 3 ]

command	配列セット $$b:ドアフラグ[0] {
	0,	0
}
command	配列セット $$s:ドアモデル名[0] {
	0,	0,	0
}



// ステージ固有モーションリスト
// ------------------------------------
enum ソリダスモーションリスト {
	sol_idle = 0,
	sol_walk,
	sol_breath1,
	sol_glare,
	sol_snakehand,
	sol_breath2
}
enum オセロットモーションリスト {
	rev_idle = 0,
	rev_breath1,
	rev_walk,
	rev_snakehand,
	rev_breath2
}
enum オルガモーションリスト {
	org_idle = 0,
	org_talk,
	org_punch
}

