#define		KMS_NAME3			dr_lamp_cor_off	//	廊下西ドアランプ赤
#define		KMS_NAME4			dr_lamp_cor_on 	//	廊下西ドアランプ青
#define		KMS_NAME5			dr_lamp_cel_off	//	独房ドアランプ赤

#define		CAN					w41a_kan		//	缶
#define		STRAW				w41a_kan_st		//	ストロー
#define		BED					w41a_goumon		//	拷問ベッド

