proc 写真撮影ステージロード $:p_レベル {
	#if d:DEBUG_PRINT
		print 'hold up stage load'
		print '$:p_レベル='$:p_レベル
	#endif

	if ( $s:選択プレイヤー == ライデン ) {
		switch ( $:p_レベル ) {
			case ( d:VRSEL_LEVEL_01 ) {
				@サウンドデータロード d:TANKER_SOUND
				@load_alt_photo_a01a_r
			}
			case ( d:VRSEL_LEVEL_02 ) {
				@サウンドデータロード d:TANKER_SOUND
				@load_alt_photo_a01b
			}
			case ( d:VRSEL_LEVEL_03 ) {
				@サウンドデータロード d:TANKER_SOUND
				@load_alt_photo_a01f
			}
			case ( d:VRSEL_LEVEL_04 ) {
				@サウンドデータロード d:TANKER_SOUND
				@load_alt_photo_a00c
			}
			case ( d:VRSEL_LEVEL_05 ) {
				@サウンドデータロード d:TANKER_SOUND
				@load_alt_photo_a00a
			}
			case ( d:VRSEL_LEVEL_06 ) {
				@サウンドデータロード d:TANKER_SOUND
				@load_alt_photo_a03a
			}
			default {
				#if d:DEBUG_PRINT
					print 'WARNING!!!!!!!ないステージが選ばれました。$:p_レベル='$:p_レベル
				#endif

				command assert ( d:FALSE ) 'player no error  (scenario err) 写真撮影ステージロード'
			}
		}

	} else if ( $s:選択プレイヤー == スネーク ) {
		switch ( $:p_レベル ) {
			case ( d:VRSEL_LEVEL_01 ) {
				@サウンドデータロード d:TANKER_SOUND
				@load_alt_photo_a01a_s1
			}
			case ( d:VRSEL_LEVEL_02 ) {
				@サウンドデータロード d:PLANT_SOUND
				@load_alt_photo_a24g
			}
			case ( d:VRSEL_LEVEL_03 ) {
				@サウンドデータロード d:PLANT_SOUND
				@load_alt_photo_a24a
			}
			case ( d:VRSEL_LEVEL_04 ) {
				@サウンドデータロード d:TANKER_SOUND
				@load_alt_photo_a02b
			}
			case ( d:VRSEL_LEVEL_05 ) {
				@サウンドデータロード d:PLANT_SOUND
				@load_alt_photo_a41b
			}
			case ( d:VRSEL_LEVEL_06 ) {
				@サウンドデータロード d:PLANT_SOUND
				@load_alt_photo_a24f
			}
			case ( d:VRSEL_LEVEL_07 ) {
				@load_alt_photo_a01a_s2
			}
			default {
				#if d:DEBUG_PRINT
					print 'WARNING!!!!!!!ないステージが選ばれました。$:p_レベル='$:p_レベル
				#endif

				command assert ( d:FALSE ) 'player no error  (scenario err) 写真撮影ステージロード'
			}
		}

	} else {
		#if d:DEBUG_PRINT
			print 'WARNING!!!!!!!その人の写真撮影ミッションはないです。$s:選択プレイヤー='$s:選択プレイヤー
		#endif

		command assert ( d:FALSE ) 'player no error  (scenario err) 写真撮影ステージロード'
	}

}





/////////////////////////////////////////////////////////////////////////////////////////////
// まだできてないステージ用ダミープロック
proc このステージはまだできてないです {
	#if d:DEBUG_PRINT
		print 'SORRY!!!!!!!このステージはまだ入ってません。'
	#endif

	load 'mselect';
}

//////////////////////////
//  セーブシーケンス

proc セーブ終了 {
	@キャラ選択状態クリア;
	command セットステージＩＤ (-2) ;	// カーソルを 'SAVE' にあわせる
	restart -save;
}

proc セーブしますか？ {
	// TODO:セーブの必要があるかどうかの判断
	chara セーブ確認画面 セーブ確認 \
		-p セーブしますか？終了 \
		-s セーブ確認文
}

proc セーブしますか？終了 $:result {
	if( $:result == 0 ) {
		chara セーブゲーム画面マネージャー セーブ画面 \
			-d save_load \
			-p ＥＸＩＴセーブ終了 \
			-i sub_vricon \
			-m d:SAVE_LOAD_MODE_VR
	} else {
		@タイトルロードプロック
	}
}

proc ＥＸＩＴセーブ終了 $:result {
	if( $:result == 0 ) {
		@キャラ選択状態クリア;
		command セットステージＩＤ (-3) ;	// カーソルを 'EXIT' にあわせる
		restart -save;
	} else {
		@タイトルロードプロック
	}
}

//////////////////////////
//	ＶＲロード

proc load_VR {

	// 初期設定をやってしまう

	@キャラ選択状態クリア;

	command ミッションズデータ初期化

#ifdef PSX2
	// Document のデータがあるかチェック
	chara セーブファイル個数チェック check -p セーブファイルある？ -s d:DOCUMENT_VR_DATA
#else
	// セーブファイルがあるかどうかチェック
	chara セーブファイル個数チェック check -m d:SAVE_LOAD_MODE_VR -p ロードしますか？
#endif
}

#ifdef PSX2
proc セーブファイルある？ $:result {
	if( $:result > 0 ) {
		print 'The document of MGS2 のデータがある。'
		// ここでフラグ処理などしてください
		$$f:オールオープンフラグ = 1;
	}
	chara delay 個数チェックディレイ -time 3 -exec { // MCMAN が１つしか起動できない	
		// セーブファイルがあるかどうかチェック
		chara セーブファイル個数チェック check2 -m d:SAVE_LOAD_MODE_VR -p ロードしますか？
	}
}

#endif

proc ロードしますか？ $:result {
	// ロードしますか?画面
	if( $:result > 0 ) {
		chara セーブ確認画面 セーブ確認 \
			-p ＶＲロード画面表示
	} else {
		//ネームエントリー
		command ノード画面起動 -map -name
	}
}

proc ＶＲロード画面表示 $:result {
	// ロード画面

	if( $:result == 0 ) {
		chara delay 終了ディレイ -time 3 -exec {	// メモリ解放待ち
			chara ロードゲーム画面マネージャー ロードゲーム画面起動 \
				-d save_load \
				-p ロードＶＲ終了プロシージャー \
				-m d:SAVE_LOAD_MODE_VR
		}
	} else {

		//ネームエントリー
		command ノード画面起動 -map -name

	}
}

proc ロードＶＲ終了プロシージャー $:返り値 {
	if( $:返り値 == 1 ) {
		$$f:オールオープンフラグ = 0;	// ロードが成功した時はDocMGS2の影響はなくなる
		command store_loadedvar
		@キャラ選択状態クリア;
		@resident_clear

		@セレクト画面
	} else {
		//ネームエントリー
		command ノード画面起動 -map -name
	}
}


proc resident_clear {
	/* 常駐ディレクトリ情報クリア（2001．9.4 園山追加） */
	dim $i:常駐ディレクトリ[ 4 ]
	eval ( $i:常駐ディレクトリ[ 0 ] = 0 )
	eval ( $i:常駐ディレクトリ[ 1 ] = 0 )
	eval ( $i:常駐ディレクトリ[ 2 ] = 0 )
	eval ( $i:常駐ディレクトリ[ 3 ] = 0 )
	command varsave $i:常駐ディレクトリ[ 0 ]
	command varsave $i:常駐ディレクトリ[ 1 ]
	command varsave $i:常駐ディレクトリ[ 2 ]
	command varsave $i:常駐ディレクトリ[ 3 ]
}

proc キャラ選択状態クリア {
	$f:ＶＲ／スネークテイルズロードフラグ = 0;
	$s:選択プレイヤー = なし;
	command セットステージＩＤ (-1) ;
}
