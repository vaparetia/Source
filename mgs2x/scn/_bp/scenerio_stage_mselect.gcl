			}
			case ( d:VRSEL_LEVEL_03 ) {
				@load_wp63a
			}
			case ( d:VRSEL_LEVEL_04 ) {
				@load_wp64a
			}
			case ( d:VRSEL_LEVEL_05 ) {
				@load_wp65a
			}
			default {
				#if d:DEBUG_PRINT
					print 'WARNING!!!!!!!ないステージが選ばれました。$:p_レベル='$:p_レベル
				#endif

				command assert ( d:FALSE ) 'player no error  (scenario err) 武器訓練ステージロード'
			}
		}

	} else if ( $:p_武器タイプ == d:VRSEL_WEAPON_HF_BLADE ) {
		// 武器訓練刀ステージ
		$b:モード番号 = d:WEAPON:BLADE;

		switch ( $:p_レベル ) {
			case ( d:VRSEL_LEVEL_01 ) {
				@load_wp71a
			}
			case ( d:VRSEL_LEVEL_02 ) {
				@load_wp72a
			}
			case ( d:VRSEL_LEVEL_03 ) {
				@load_wp73a
			}
			case ( d:VRSEL_LEVEL_04 ) {
				@load_wp74a
			}
			case ( d:VRSEL_LEVEL_05 ) {
				@load_wp75a
			}
			default {
				#if d:DEBUG_PRINT
					print 'WARNING!!!!!!!ないステージが選ばれました。$:p_レベル='$:p_レベル
				#endif

				command assert ( d:FALSE ) 'player no error  (scenario err) 武器訓練ステージロード'
			}
		}

	} else {
		#if d:DEBUG_PRINT
			print 'WARNING!!!!!!!ない武器タイプが選ばれました。$:p_武器タイプ='$:p_武器タイプ
		#endif

		command assert ( d:FALSE ) 'player no error  (scenario err) 武器訓練ステージロード'
	}
}

proc 主観ステージロード $:p_レベル {
	#if d:DEBUG_PRINT
