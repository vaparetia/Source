//=============================================================================
// define
//=============================================================================

//	ステージ用define
// ------------------------------------
#define		STAGE_W43A			1

#define		STAGE_PLANT			1	//	プラント編
#define		STAGE_ALT			1	//	オルタナティブ系のステージでは全て定義する。ゲームオーバーなどで使用
#define		ANOTHER				1	//	VR,オルタナティブ双方で定義。a_stdproc.hで定義されているため、stdch.h内では、使用することができない

//-----------------------------------------------------------------------------
// スイッチ

#define ENEMY_SET  0			// 敵兵の配置
#define STAGE_END  1			// ロードプロック

#define SCREENSHOT 0			// スクリーンショット
#define KEYBOARD   0			// ＵＳＢキーボード

//-----------------------------------------------------------------------------
// マップ関係
#define HZX_NAME   a43a
#define LT2_NAME   w43a

#define KMS_NAME0  w43a
#define KMS_NAME1  w43a_dec		//	もうない（リボン）
//#define KMS_NAME2  w42a_dammy
#define KMS_NAME2  a42a_dummy	//	アナザー用ダミーモデル
#define KMS_NAME3  w44a_dammy

//#define DOOR_NAME1 w02a_l_dr

#define DOOR_NAME_LOAD1A w43a_dr_left
#define DOOR_NAME_LOAD1B w43a_dr_right

// キャラクター関係
#define RAIDEN     1
#if d:RAIDEN
#define PLAYER     ライデン
#else
#define PLAYER     スネーク
#endif

//	薬莢
#define		NPC_SNAKE				1	//	ＮＰＣスネーク

// ２Ｄテクスチャ説明表示
#define		EX_TEX			1		// 説明テクスチャ表示を使用するのに必要
#define		TEX_FADE_TIME	30		// 説明テクスチャのフェードインアウトタイム

#define		POLYDEMO_LOAD		1

//-----------------------------------------------------------------------------
// ローカル

//	$f:フラグ01 					//	第一メタルハンガーへのドア開閉フラグ
//	$f:フラグ02						//	南側ドア前到達フラグ
//	$b:w43a_刀練習時間終了フラグ	//	刀練習時間が終了したかどうかのフラグ 
									//	0 刀振ってない
									//	1 刀を振った
									//	2 練習終了しても良いよ
									//	3 練習終了
//	$i:w43a_スネークライフ			//	スネークのライフ
//	$f:w43a_まおムービー再生中		//	ムービーが再生中かどうか
//	$w:w43a_コンフィグ設定			//	$w:コンフィグ設定の退避用



//	司令官音声



//	ドア設定用ステージ内ローカル変数(a_mode.hよりも先に定義する)
dim $$b:ドアフラグ[ 2 ]
dim $$s:ドアモデル名[ 4 ]

command	配列セット $$b:ドアフラグ[0] {
	0,	0
}
command	配列セット $$s:ドアモデル名[0] {
	0,	0	0,	0
}



//=============================================================================
// include
//=============================================================================

#include "rai_a43a.mh"	// ステージ固有モーションリスト

#include "stdch.h"
#include "enevoice.h"
#include "a_mode.h"	// アナザー各モード別変数設定用ファイル

#include "sload.h"
#include "sound.h"
#include "item_info.h"

#if d:KEYBOARD 
#include "usbkbd.h"
#endif

#include "snake_voice.h"

// アナザー用でマップ設定前に設定する
// ------------------------------------
@アナザー用マップ定義前設定

//=============================================================================
// メイン
//=============================================================================

chara マップ 丸通路 \
//	-k d:KMS_NAME1 \	// 順序が大事
	-k d:KMS_NAME0 \
//	-k d:KMS_NAME2 \	//	プットオブジェに変更
//	-k d:KMS_NAME3 \	//	プットオブジェに変更
	-h d:HZX_NAME, 0 \
	-l d:LT2_NAME

command マップ設定 丸通路 -set {
	// サウンド、キャラクターのセット
	@常駐キャラ設定				// ヘッダーに定義
	@ローカル変数初期化
	@設定値変更
	@プラグイン設定
	@A_プレイヤー設定 sna_a43a rai_a43a
}

// アナザー用でマップ設定後に設定する
// ------------------------------------
@アナザー用マップ定義後設定

command マップ設定 丸通路 -set {
	@弾痕跳弾設定
// マップ切り替え、ロード、ドア
// ------------------------------------
	@ドア設定
	@ロード設定

// ステージ、オブジェクト関連
// ------------------------------------
	@オブジェクト設定
	@フォグ設定
//	@エフェクト設定
	@影設定
	@空中文字設定
	@カメラセット
	@丸通路カメラ設定

	@キャラ用ライト設定

/*
	if ($f:w41a_ノードフラグ == 1) {
		@プラント編全体マップ設定 d:アーセナルギア上行結腸	//	全体マップ表示
	} else {
		@ポーズ時ステージ名表示設定 d:wn_アーセナルギア上行結腸	//	ポーズ時ステージ名表示
	}
*/
}

command マップ表示 -show 丸通路

@丸通路開始時処理



//###################################################################################
//									各proc設定
//###################################################################################



//###################################################################################
//									全マップ共通
//###################################################################################

	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT 
			print 'localvar_init'
		#endif

//		eval ($f:フラグ01 = 0)
//		eval ($f:フラグ02 = d:FALSE)
		eval ($b:w43a_刀練習時間終了フラグ = 0)
		eval ($i:w43a_スネークライフ = 600);

		//	刀説明デモ終了後はデモ再生フラグを戻す
		if ($w:p_story == d:ST:P073_05_S01通路Ａ５シナリオデモ１終了) {
			eval( $f:デモ再生フラグ = 0);
		}

	}

	proc 設定値変更 {
		#if d:DEBUG_PRINT 
			print 'status_set'
		#endif

	}

	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif
		//	風邪用
//		command プラグインくしゃみ
		//	刀
//		command プラグインブレード -m rai_blade
	}

	proc 弾痕跳弾設定 {
		command 弾痕ノーマル -n 0
		command 弾痕ノーマル -n 1
		command 弾痕ノーマル -n 3

		command 跳弾ノーマル -n 0
		command 跳弾ノーマル -n 1
		command 跳弾ノーマル -n 3
	}

//###################################################################################
//									 ドア＆マップ切り替え
//###################################################################################

	proc ドア設定 {
	#if d:DEBUG_PRINT
		print '*** Door Set ***'
	#endif
/*
		@ドアモデル名セット $:配列番号 \
			$:ドア名１				$:ドア名２				$:ドア名３ \
			$:ドア名４				$:ドア名５
			d:DOOR_FLAG_CLOSE 		d:DOOR_FLAG_OPEN		d:DOOR_FLAG_ENEMY_ONLY
			d:DOOR_FLAG_CLOSE_LEVEL	d:DOOR_FLAG_OPEN_LEVEL

		@A_ドア開閉追加設定 $:ドア名 $:フラグ $:ドア位置Ｘ $:ドア位置Ｙ $:ドア位置Ｚ $:ドア回転 $:ドアスライド幅
*/
		//	第二メタルハンガーへのドア
		//	アーセナルドアは両開きのためフラグ１つでモデル２つを管理する
		@ドアモデル名セット 0 d:DOOR_NAME_LOAD1A d:DOOR_NAME_LOAD1A d:DOOR_NAME_LOAD1A d:DOOR_NAME_LOAD1A d:DOOR_NAME_LOAD1A
		switch ( $$b:ドアフラグ[0] ) {
			case ( d:DOOR_FLAG_CLOSE ) {
				$$s:ドアモデル名[2] = d:DOOR_NAME_LOAD1B;
			}
			case ( d:DOOR_FLAG_OPEN ) {
				$$s:ドアモデル名[2] = d:DOOR_NAME_LOAD1B;
			}
			case ( d:DOOR_FLAG_ENEMY_ONLY ) {
				$$s:ドアモデル名[2] = d:DOOR_NAME_LOAD1B;
			}
			case ( d:DOOR_FLAG_CLOSE_LEVEL ) {
				$$s:ドアモデル名[2] = d:DOOR_NAME_LOAD1B;
			}
			case ( d:DOOR_FLAG_OPEN_LEVEL ) {
				$$s:ドアモデル名[2] = d:DOOR_NAME_LOAD1B;
			}
		}

		@A_ドア開閉追加設定 第二メタルハンガードア $$b:ドアフラグ[0] 33500,4000,-91625 0 1500

		//	第一メタルハンガーへのドア
		//	アーセナルドアは両開きのためフラグ１つでモデル２つを管理する
		@ドアモデル名セット 1 d:DOOR_NAME_LOAD1A d:DOOR_NAME_LOAD1A d:DOOR_NAME_LOAD1A d:DOOR_NAME_LOAD1A d:DOOR_NAME_LOAD1A
		switch ( $$b:ドアフラグ[1] ) {
			case ( d:DOOR_FLAG_CLOSE ) {
				$$s:ドアモデル名[3] = d:DOOR_NAME_LOAD1B;
			}
			case ( d:DOOR_FLAG_OPEN ) {
				$$s:ドアモデル名[3] = d:DOOR_NAME_LOAD1B;
			}
			case ( d:DOOR_FLAG_ENEMY_ONLY ) {
				$$s:ドアモデル名[3] = d:DOOR_NAME_LOAD1B;
			}
			case ( d:DOOR_FLAG_CLOSE_LEVEL ) {
				$$s:ドアモデル名[3] = d:DOOR_NAME_LOAD1B;
			}
			case ( d:DOOR_FLAG_OPEN_LEVEL ) {
				$$s:ドアモデル名[3] = d:DOOR_NAME_LOAD1B;
			}
		}

		@A_ドア開閉追加設定 第一メタルハンガードア $$b:ドアフラグ[1] 31625,4000,-61750 1024 1500


		//	第二メタルハンガーへのドア
		chara ドア 第二メタルハンガードア \
			-m $$s:ドアモデル名[0] \
			-d 0,0,0 \
			-p 33500,4000,-91625 \
			-slide d:SD_SLIDE_ARSENAL_LEFT \
			-time d:SD_OPEN_TIME \
			-between 丸通路 丸通路 \
			-w_door $$s:ドアモデル名[2] d:SD_SLIDE_ARSENAL_RIGHT \
			-h 1500 \
			-exec {
				if ( !($:開閉フラグ) ) {
					mesg プットオブジェ ｗ４４ａロードエリア off
				} else {
					mesg プットオブジェ ｗ４４ａロードエリア on
				}
			}
		@主観禁止壁 第二メタルハンガードア壁 33500,4000,-91625 0 1500

		trap dr001 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_SUBJECT \
			-exec {
				if( $3 == 入る ) {
					mesg 透明壁 第二メタルハンガードア壁 on
				} else {
					mesg 透明壁 第二メタルハンガードア壁 off
				}
			}
		trap dr001 ？ -mask ？ \
			-exec {
				if ($3 == 入る) {
					mesg ドア 第二メタルハンガードア open $2
				} else {
					mesg ドア 第二メタルハンガードア close $2
				}
			}

		//	第一メタルハンガーへのドア
		chara ドア 第一メタルハンガードア \
			-m $$s:ドアモデル名[1] \
			-d 0,1024,0 \
			-p 31625,4000,-61750 \
			-slide d:SD_SLIDE_ARSENAL_LEFT \
			-time d:SD_OPEN_TIME \
			-between 丸通路 丸通路 \
			-w_door $$s:ドアモデル名[3] d:SD_SLIDE_ARSENAL_RIGHT \
			-h 1500 \
			-exec {
				if ( !($:開閉フラグ) ) {
					mesg プットオブジェ ｗ４２ａロードエリア off
				} else {
					mesg プットオブジェ ｗ４２ａロードエリア on
				}
			}
		@主観禁止壁 第一メタルハンガードア壁 31625,4000,-61750 1024 1500

		trap dr002 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_SUBJECT \
			-exec {
				if ($3 == 入る) {
					mesg 透明壁 第一メタルハンガードア壁 on
				} else {
					mesg 透明壁 第一メタルハンガードア壁 off
				}
			}
		trap dr002 ？ -mask ？ \
			-exec {
				if ($3 == 入る) {
					mesg ドア 第一メタルハンガードア open $2
				} else {
					mesg ドア 第一メタルハンガードア close $2
				}
			}

		// 南側ドア
		chara ドア 南側ドア \
			-m d:DOOR_NAME_LOAD1A \
			-d 0 2048 0 \
			-p 35000 4000 -41375 \
			-slide d:SD_SLIDE_ARSENAL_LEFT \
			-time d:SD_OPEN_TIME \
			-between 丸通路 丸通路 \
			-w_door d:DOOR_NAME_LOAD1B d:SD_SLIDE_ARSENAL_RIGHT \
			-h 1500 \
			-card_level 9999 \			//	無理矢理開かなくする
			-exec {
			}

		trap dr003 ？ -mask ？ \
			-exec {
				if ($3 == 入る) {
					mesg ドア 南側ドア open $2
				} else {
					mesg ドア 南側ドア close $2
				}
			}

	}



//###################################################################################
//									開始時処理
//###################################################################################

	proc 丸通路開始時処理 {
	#if d:DEBUG_PRINT
		print '*** Stage Start Proc ***'
	#endif

		if ($s:登場ポイント == 天狗通路Ａから) {
			@ステージ開始時処理（ステージ名表示） \
			d:LOAD_TYPE:SL_DOOR_TYPE 第一メタルハンガードア 2500 d:DEFAULT_M_TYPE \
			d:wn_アーセナルギア上行結腸
			@ロード時カメラ設定
			//	ＢＧＭを鳴らす
			command セットサウンドコード -c d:SNG_PLAY_05
		} else if ($s:登場ポイント == 天狗通路Ｂから) {
			@ステージ開始時処理（ステージ名表示） \
			d:LOAD_TYPE:SL_DOOR_TYPE 第二メタルハンガードア 2000 d:DEFAULT_M_TYPE \
			d:wn_アーセナルギア上行結腸
			@ロード時カメラ設定
			//	ＢＧＭを鳴らす
			command セットサウンドコード -c d:SNG_PLAY_05
		}
	}



//###################################################################################
//									ロード設定
//###################################################################################

	proc ロード設定 {
	#if d:DEBUG_PRINT
		print '*** Load Set ***'
	#endif
	// 第二メタルハンガーへ (a44a)
	trap ld001 d:PLAYER \
		-mask 入る \
		-exec {
			if ($f:ロードチェックＯＮフラグ == 1) {
				@ロードカメラ２
				preseek 'a44a'
				@ステージ終了時処理（ステージ名表示） 34250 4000 -93500 2048 mv_a43a_a44a_0 \
				d:DEFAULT_M_TYPE d:wn_アーセナルギア回腸
			}
		}

	// 第一メタルハンガーへ (a42a)
	trap ld002 d:PLAYER \
		-mask 入る \
		-exec {
			if ($f:ロードチェックＯＮフラグ == 1) {
				@ロードカメラ１
				preseek 'a42a'
				@ステージ終了時処理（ステージ名表示） 3000 4000 -62500 3072 mv_a43a_a42a_0 \
				d:DEFAULT_M_TYPE d:wn_アーセナルギア空腸
			}
		}


	}

	proc ロードプロック {
	#if d:DEBUG_PRINT
		print '*** Load Proc ***'
	#endif

		if($s:呼び出しプロック == mv_a43a_a44a_0) {
			// 第二メタルハンガーへ
			@mv_a43a_a44a_0
		} else {
			// 第一メタルハンガーへ
			command セットサウンドコード -c d:SNG_FOUTS_S
			@mv_a43a_a42a_0
		}
	}

	proc ロード時カメラ設定 {
		if ($s:登場ポイント == 天狗通路Ａから) {
			@ロードカメラ１
		} else if ($s:登場ポイント == 天狗通路Ｂから) {
			@ロードカメラ２
		}
		chara プロック連続実行 カメラ戻し管理人 \
			-proc カメラ戻し管理
	}

	proc カメラ戻し管理 {
		command パッドチェック \
			-no_use
		if ($status != 1) {
			chara カメラ設定 ロードカメラ \
				-s -1
			mesg プロック連続実行 カメラ戻し管理人 kill
		}
	}

//	インテグラル
	proc ロードカメラ１ {
		chara カメラ設定 ロードカメラ \
			-c 1 \	
			-p 34341,7459,-59007 -t 33321,5766,-62589 \
			-a 200 \
			-i 0 1 0 0 \
			-s 1
	}

//	インテグラル
	proc ロードカメラ２ {
		chara カメラ設定 ロードカメラ \
			-c 1 \	
			-p 34908,7170,-87531 -t 34422,5582,-90495 \
			-a 156 \
			-i 0 1 0 0 \
			-s 1
	}

//###################################################################################
//									オブジェクト
//###################################################################################

	proc オブジェクト設定 {
		//	w42a側ロードエリア
		chara プットオブジェ ｗ４２ａロードエリア \
			-m d:KMS_NAME2 \
			-r 0,0,0 \
			-p 0,0,0 -l d:LT2_NAME \
			-s 100,100,100
		mesg プットオブジェ ｗ４２ａロードエリア off
		
		//	w44a側ロードエリア
		chara プットオブジェ ｗ４４ａロードエリア \
			-m d:KMS_NAME3 \
			-r 0,0,0 \
			-p 0,0,0 -l d:LT2_NAME \
			-s 100,100,100
		mesg プットオブジェ ｗ４４ａロードエリア off
	}

//###################################################################################
//									 エフェクト
//###################################################################################

	proc フォグ設定 {
	#if d:DEBUG_PRINT
		print '*** Fog Set ***'
	#endif

		// フォグ
		//   -c ＲＧＢカラー  -n ＮＥＡＲ値  -f ＦＡＲ値
		chara フォグ 霧\
			-c 3, 18, 11 \
			-n -4000 \
			-f 35000
	}

	proc エフェクト設定 {
		#if d:DEBUG_PRINT
			print 'effect_set'
		#endif
	}

	// キャラ用ライト設定 
	proc キャラ用ライト設定 {
		#if d:DEBUG_PRINT
			print '*** Chara Light Set ***'
		#endif
		chara 環境光 環境光源 \
			 -c 28 65 49

		chara 平行光 平行光源 \
			 -c 15 40 35 \
			 -p 3170 1648 -3497

	}

	proc 影設定 {
		#if d:DEBUG_PRINT
		print'SHADOW'
		#endif

		//	影写り用モデル
		chara 影投影モデル 影用モデル \
			-model w43a_sdw \
			-pos 0,0,0

		chara 影管理 影管理人 \
			-type 1
	}

	proc 空中文字設定 {

		//	分類１
		chara 回転モデル 空中文字１-１ \
			-O 34250 6000 -41650  \ 					// 起点
			-posz -18150 \
			-spin 0 36000 \								// 軸回転
