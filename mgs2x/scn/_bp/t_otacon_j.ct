}
}


// added by S.Hirano 01/03/02
proc rto_長廊下船倉へ向かえ２:07{
vox t:vc009602 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_長廊下船倉へ向かえ２:オタコン_000]
		//そこの廊下は船倉をぐるっと囲んで
		//るんだ。船倉への扉は幾つかあるけど、
		//ほとんど閉鎖されてる。
	}
}
}


// added by S.Hirano 01/03/02
proc rto_長廊下船倉へ向かえ３:07{
vox t:vc009603 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_長廊下船倉へ向かえ３:オタコン_000]
		//でも、一番奥の扉はまだ閉じられて
		//いないようだね。
	}
}
}


// added by S.Hirano 01/03/02
proc rto_長廊下船倉へ向かえ４:07{
vox t:vc009604 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
