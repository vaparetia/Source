	}
	talk オタコン 標準 -m {
		[TO_レイブン影正体後:オタコン_002]
	}
	talk オタコン 標準 -m {
		[TO_レイブン影正体後:オタコン_003]
	}
	talk オタコン 標準 -m {
		[TO_レイブン影正体後:オタコン_004]
	}
	talk スネーク 標準 -m {
		[TO_レイブン影正体後:スネーク_005]
	}
//} //v
}


proc rto_奈落エルード:07 {
vox t:vc005001 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_奈落エルード:オタコン_000]
		//スネーク、そこから落ちたら、
		//いくら君でも助からない。
		//絶対、落ちたらダメだ。いいね。
	}
} //v
}


proc rto_懸垂握力アップ後:07 {
vox t:vc016101 { //％ない？○
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_懸垂握力アップ後:オタコン_000]
	}
} //v
}

proc rto_開かないロッカー:07 {
vox t:vc005101 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_開かないロッカー:オタコン_000]
		//そのロッカーは開かないみたいだ。
		//鍵でもかかってるんだろう。ロッカーを
		//使いたいんなら他のを探すしかないね。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_長廊下ライト:07 {
vox t:vc005201 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_長廊下ライト:オタコン_000]
		//電灯を銃で撃って壊せば明かりを
		//消すことが出来る。暗くなるけど、
		//敵も君が見にくくなるはずだ。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_長廊下ライトつけろ:07 {
vox t:vc005301 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_長廊下ライトつけろ:オタコン_000]
		//スネーク、暗いところではライトを
		//つけるといい。
	}
	talk オタコン 標準 -m {
		[TO_長廊下ライトつけろ:オタコン_001]
		//君のＵＳＰにはフラッシュライトが装備
		//されてる。ＵＳＰを装備して＃｛□、武器｝＃ボタン
		//で構えれば、その間ライトがつくよ。
	}
	talk オタコン 標準 -m {
		[TO_長廊下ライトつけろ:オタコン_002]
		//でも、ライトをつければ当然敵に
		//見つかりやすくなるから気をつけてくれ。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_長廊下敵暗視ゴーグル:07 {
vox t:vc005401 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_長廊下敵暗視ゴーグル:オタコン_000]
		//スネーク、敵は暗視ゴーグルを装備
		//している。暗闇も見通してくるはずだ。
		//気をつけて。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_長廊下開かない扉:07 {
vox t:vc005501 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_長廊下開かない扉:オタコン_000]
		//そこの扉は開かないみたいだ。
		//北の方に進んでくれ。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_長廊下東ロック扉:07 {
vox t:vc005601 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_長廊下東ロック扉:オタコン_000]
		//スネーク、その扉は外側からロック
		//されたみたいだ。先に進むしかない。
		//南に向かってくれ。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_長廊下東開かない扉:07 {
vox t:vc005701 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_長廊下東開かない扉:オタコン_000]
		//そこの扉は開かないみたいだ。
		//そのまま南に進んでくれ。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_はしご:07 {
//むびＸＸＸＸＸＸＸＸＸ
vox t:vc005801 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_はしご:オタコン_000]
		//スネーク、ハシゴにつかまるには
		//ハシゴに向かって＃｛△、アクション｝＃ボタンを押すんだ。
	}
	talk オタコン 標準 -m {
		[TO_はしご:オタコン_001]
		//ハシゴから離れたくなったら、
		//ハシゴの一番上か一番下でもう一度
		//＃｛△、アクション｝＃ボタンを押せばいい。
	}
	talk オタコン 標準 -m {
		[TO_はしご:オタコン_002]
		//ただ、ハシゴを上り下りしてる間は
		//武器は使えないから、気をつけてくれ。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_プロジェクタ１:07 {
vox t:vc005901 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_プロジェクタ１:オタコン_000]
		//スネーク、そこにプロジェクタが
		//あるだろ。それで前にあるスクリーンに
		//映像を映してるんだ。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_プロジェクタ２:07 {
vox t:vc005902 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_プロジェクタ２:オタコン_000]
		//メタルギアのある一番奥の船倉に
		//海兵隊員が入りきらないからだろう。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_プロジェクタ３:07 {
vox t:vc005903 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_プロジェクタ３:オタコン_000]
		//だから中継してる映像を利用して……。
	}
	talk スネーク 標準 -m {
		[TO_プロジェクタ３:スネーク_000]
		//そもそも、なぜ中継を？
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_プロジェクタ４:07 {
vox t:vc005904 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_プロジェクタ４:オタコン_000]
		//不用意にプロジェクタの前を横切ったら
		//スクリーンに影が映って敵に見つかって
		//しまう。気をつけてくれ。
	}
	talk オタコン 標準 -m {
		[TO_プロジェクタ４:オタコン_001]
		//プロジェクタの前はホフクして進むんだ。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_鳴り床:07 {
vox t:vc006001 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_鳴り床:オタコン_000]
		//スネーク、そこの床は歩くと音が
		//鳴ってしまうみたいだ。
		//足音を聞かれたら厄介なことになる。
	}
}
}


// added by S.Hirano 01/03/02
proc rto_鳴り床２:07 {
vox d:_vc006002 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_鳴り床２:オタコン_000]
		//足音を立てないように進むには、
		//ホフクするか、左スティックの倒し方を
		//少しだけにしてゆっくり歩けばいい。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_船倉兵:07 {
vox t:vc006101 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_船倉兵:オタコン_000]
		//もしも気づかれて海兵隊員が近づいて
		//来たら、見つかる前に素早く倒すか、
		//逃げるかするんだ。
	}
	talk オタコン 標準 -m {
		[TO_船倉兵:オタコン_001]
		//あの人数の海兵隊はとても相手に
		//出来ない。絶対に見つかっちゃダメだ。
		//いいね。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_船倉地下ハッチ:07 {
//むびＸＸＸＸＸＸＸＸＸ
vox t:vc006201 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_船倉地下ハッチ:オタコン_000]
		//スネーク、そこにハッチがある。
		//多分下層のダクトに通じてるんだ。
	}
	talk オタコン 標準 -m {
		[TO_船倉地下ハッチ:オタコン_001]
		//ハッチを開けるには、ハッチに向かって
		//＃｛△、アクション｝＃ボタンを押せばいい。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_船倉ハッチ下:07 {
vox t:vc006301 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_船倉ハッチ下:オタコン_000]
		//そこはダクトの入口になってる
		//みたいだね。
		//ホフクすれば中に入れるはずだ。
	}
	talk オタコン 標準 -m {
		[TO_船倉ハッチ下:オタコン_001]
		//ダクトの中を進むのは上を行くより
		//安全かもしれないな。
		//でも気は抜かないでくれ。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_船倉ロックドア:07 {
vox t:vc006401 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_船倉ロックドア:オタコン_000]
		//スネーク、そこのドアは外からロック
		//されてる。もう後戻りは出来ない。
		//先に進むんだ。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_船倉地下小部屋:07 {
vox t:vc006501 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_船倉地下小部屋:オタコン_000]
		//スネーク、ダクトの中にいても、
		//大きな音を立てたら見つかってしまうと
		//思う。
	}
	talk オタコン 標準 -m {
		[TO_船倉地下小部屋:オタコン_001]
		//あの人数に囲まれたら、
		//いくら君でもどうしようもない。
	}
	talk オタコン 標準 -m {
		[TO_船倉地下小部屋:オタコン_002]
		//絶対に銃を撃ったりしちゃダメだ。
		//いいね。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_船倉ＴＶ兵:07 {
vox t:vc006601 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_船倉ＴＶ兵:オタコン_000]
		//映像はその兵隊が中継してたんだね。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_ポール上:07 {
//むびＸＸＸＸＸＸＸＸＸ
vox t:vc006701 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ポール上:オタコン_000]
		//スネーク、そこにあるポールをつたえば
		//下の階に下りられるはずだ。
	}
	talk オタコン 標準 -m {
		[TO_ポール上:オタコン_001]
		//ポールにつかまるにはポールの方を向いて＃｛△、アクション｝＃ボタンを押せばいい。
	}
	talk オタコン 標準 -m {
		[TO_ポール上:オタコン_002]
		//でも一度下りたら、もう上には上がれ
		//ないだろう。下りるのはその階でしたい
		//ことを全部終えてからの方がいいね。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_ポール下:07 {
vox t:vc006801 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ポール下:オタコン_000]
		//スネーク、そのポール、下からは
		//上れないそうにない。上の階に行くのは
		//諦めたほうがいいね。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_電送機:07 {
//むびＸＸＸＸＸＸＸＸＸ
vox t:vc006901 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_電送機:オタコン_000]
		//スネーク、そこにあるコンピュータが
		//外に繋がってるＷＳだ。
		//それを使って写真をこっちに送ってくれ。
	}
	talk オタコン 標準 -m {
		[TO_電送機:オタコン_001]
		//写真を送信する時は、そのＷＳの前に
		//立って＃｛△、アクション｝＃ボタンを押すだけでいい。
	}
	talk オタコン 標準 -m {
		[TO_電送機:オタコン_002]
		//いい写真を頼むよ！
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_電送機説明:07 {
vox t:vc007001 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_電送機説明:オタコン_000]
		//そのＷＳは軍事ネットワークに
		//繋がってる。演説の映像もそこから送信
		//されているんだ。それを僕らは利用する。
	}
@rt_うんちく＿否＿わからん系デフォルト 100
@rt_うんちく＿是＿詳しいな系デフォルト 50
	talk オタコン 標準 -m {
		[TO_電送機説明:オタコン_001]
		//僕はオハイオにある陸軍の
		//＃｛インターネット、Ｉ｝＃・＃｛コントローラ、Ｃ｝＃・＃｛ルータ、Ｒ｝＃
		//から軍事ネットワークに侵入した。
	}
	talk オタコン 標準 -m {
		[TO_電送機説明:オタコン_002]
		//そこからリンク１６経由でそのＷＳに
		//写真を送信するためのアプリケーション
		//をリモート・インストールしたのさ。
	}
	talk オタコン 標準 -m {
		[TO_電送機説明:オタコン_003]
		//なに、軍事ネットワークは基本的に
		//民生品ベースの技術を応用してるからね。
		//軽いもんだよ。
	}
@rt_うんちく＿否＿わからん系デフォルト 100
@rt_うんちく＿是＿詳しいな系デフォルト 50
	talk オタコン 標準 -m {
		[TO_電送機説明:オタコン_004]
		//それにあらかじめバックドアも仕掛けて
		//あったんだ。ＲＥＸを作ってた時に
		//陸軍のネットにはアクセス出来たから。
	}
	talk オタコン 標準 -m {
		[TO_電送機説明:オタコン_005]
		//ねぇ話聞いてる？
	}
	talk スネーク 標準 -m {
		[TO_電送機説明:スネーク_000]
		//あ、ああ……。
	}
	talk オタコン 標準 -m {
		[TO_電送機説明:オタコン_006]
		//本当に？で、そのアプリは写真のデータ
		//を圧縮・暗号化・分割して送信する。
		//暗号化にはＢＡＴＯＮを使ったよ。
	}
@rt_うんちく＿否＿わからん系デフォルト 100
@rt_うんちく＿是＿詳しいな系デフォルト 50
	talk オタコン 標準 -m {
		[TO_電送機説明:オタコン_007]
		//パケットは＃｛戦術デジタル情報リンク、ＴＡＤＩＬ｝＃
		//Ｊメッセージフォーマットに偽装され、
		//演説の画像に紛れて送信されるんだ。
	}
	talk オタコン 標準 -m {
		[TO_電送機説明:オタコン_008]
		//どう？わかった？
	}
	talk スネーク 標準 -m {
		[TO_電送機説明:スネーク_001]
		//……。
	}
	talk オタコン 標準 -m {
		[TO_電送機説明:オタコン_009]
		//もう一回説明しようか？
	}
	talk スネーク 標準 -m {
		[TO_電送機説明:スネーク_002]
		//いや、もう充分だ。
	}
} //v
}


