// added by S.Hirano 01/03/02
proc rto_長廊下船倉へ向かえ６:07{
vox t:vc009606 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_長廊下船倉へ向かえ６:オタコン_000]
		//その廊下の一番奥にある扉から
		//船倉に入るんだ。南に向かってくれ。
	}
}
}


// added by S.Hirano 01/03/02
proc rto_長廊下以外船倉へ向かえ:07{
vox t:vc009701 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_長廊下以外船倉へ向かえ:オタコン_000]
		//スネーク、新型メタルギアは船倉だ。
	}
	talk オタコン 標準 -m {
		[TO_長廊下以外船倉へ向かえ:オタコン_001]
		//さっき赤外線センサーのトラップを
		//壊したよね。船倉へ行くにはその先を
		//進めばいい。
	}
}
}


// added by S.Hirano 01/03/02
proc rto_長廊下長廊下兵戦え:07{
vox t:vc009801 {
@rt_無茶指令＿否＿お前がやれ系デフォルト 100
@rt_うなづきデフォルト＿是
	talk オタコン 標準 -m {
		[TO_長廊下長廊下兵戦え:オタコン_000]
		//敵も黙って君を通す気はないみたいだ。
		//銃で応戦するしかない。
		//主観攻撃を使って！
	}
}
}


// added by S.Hirano 01/03/02
proc rto_長廊下廊下兵隠れろ:07{
vox t:vc009901 {
@rt_無茶指令＿否＿お前がやれ系デフォルト 60
@rt_うなづきデフォルト＿是
	talk オタコン 標準 -m {
		[TO_長廊下廊下兵隠れろ:オタコン_000]
		//スネーク、遮蔽物があるだろ。
		//それに隠れながら応戦するんだ！
	}
}
}


// added by S.Hirano 01/03/02
proc rto_船倉１２進め:07{
vox t:vc010001 {
	talk オタコン 標準 -m {
		[TO_船倉１２進め:オタコン_000]
		//スネーク、船倉は三つのブロックに
		//分かれている。新型メタルギアは一番
		//奥のブロックだ。北に進んでくれ。
	}
	talk オタコン 標準 -m {
		[TO_船倉１２進め:オタコン_001]
		//相手はその人数だ。もし見つかったら
		//どう考えても勝ち目はない。
		//絶対に見つかったらダメだ。いいね。
	}
}
}


// added by S.Hirano 01/03/02
proc rto_船倉演説終わる前に１:07{
vox t:vc010101 {
	talk オタコン 標準 -m {
		[TO_船倉演説終わる前に１:オタコン_000]
		//スネーク、チャンスは海兵隊司令官の
		//演説が続いている間だけだ。演説が
		//終わる前に写真を撮り終える必要がある。
	}
}
}


// added by S.Hirano 01/03/02
proc rto_船倉演説終わる前に２:07{
vox t:vc010102 {
	talk オタコン 標準 -m {
		[TO_船倉演説終わる前に２:オタコン_000]
		//演説が終わったら、
		//海兵隊員達は持ち場に戻るだろう。
	}
	talk オタコン 標準 -m {
		[TO_船倉演説終わる前に２:オタコン_001]
		//あの人数で警備されたら、
		//見つからずにメタルギアの写真を
		//撮るなんて不可能だ。
	}
	talk オタコン 標準 -m {
		[TO_船倉演説終わる前に２:オタコン_002]
		//そうなる前に全てを片づけてくれ。
	}
}
}


// added by S.Hirano 01/03/02
proc rto_船倉演説終わる前に３:07{
vox t:vc010103 {
	talk オタコン 標準 -m {
		[TO_船倉演説終わる前に３:オタコン_000]
		//もう時間がない。急いで！
	}
}
}


// added by S.Hirano 01/03/02
proc rto_船倉見つかると即死:07{
vox t:vc010201 {
	talk オタコン 標準 -m {
		[TO_船倉見つかると即死:オタコン_000]
		//そこでは絶対に見つかっちゃダメだ。
		//その人数の海兵隊を相手にしたら、
		//いくら君でも勝ち目がない。
	}
	talk オタコン 標準 -m {
		[TO_船倉見つかると即死:オタコン_001]
		//見つかったら終わりだ。
		//とにかく慎重に進んでくれ。
	}
}
}


// added by S.Hirano 01/03/02
proc rto_演説１:07{
vox t:vc010301 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_演説１:オタコン_000]
		//海兵隊は有事の際の緊急展開部隊と
		//しての性格が強い。
	}
@rt_うんちく＿否＿わからん系デフォルト 100
@rt_うんちく＿是＿詳しいな系デフォルト 50
	talk オタコン 標準 -m {
		[TO_演説１:オタコン_001]
		//でも最近陸軍がミディアム旅団を
		//中心に緊急即応の能力を高めている。
	}
	talk オタコン 標準 -m {
		[TO_演説１:オタコン_002]
		//海兵隊はそれに対し、自軍の権益を
		//侵害されるという非常な危機感を
		//持っているようだ。
	}
@rt_うんちく＿否＿わからん系デフォルト 100
@rt_うんちく＿是＿詳しいな系デフォルト 50
	talk オタコン 標準 -m {
		[TO_演説１:オタコン_003]
		//君も知ってる通りメタルギアＲＥＸは
		//陸軍での採用を目的として開発されて
		//いた。
	}
	talk オタコン 標準 -m {
		[TO_演説１:オタコン_004]
		//だから海兵隊が陸軍に対抗して独自の
		//メタルギアを持とうとしてるというのは
		//分からない話じゃないね。
	}
}
}


// added by S.Hirano 01/03/02
proc rto_演説２:07{
vox t:vc010401 {
	talk オタコン 標準 -m {
		[TO_演説２:オタコン_000]
		//司令官が海軍からの圧力があるって
		//言ってたね。
	}
	talk オタコン 標準 -m {
		[TO_演説２:オタコン_001]
		//確かに海軍はその新型メタルギアの
		//開発をおもしろく思ってないだろう。
	}
	talk オタコン 標準 -m {
		[TO_演説２:オタコン_002]
		//新型メタルギアは海からの接敵・攻撃・
		//離脱という作戦行動を単独で可能にする
		//兵器らしい。
	}
	talk オタコン 標準 -m {
		[TO_演説２:オタコン_003]
		//これが完成したら空母や戦艦は勿論、
		//潜水艦までが戦略的意義を失ってしまう
		//かもしれない。
	}
	talk オタコン 標準 -m {
		[TO_演説２:オタコン_004]
		//海軍にとっては死活問題だ。
	}
}
}


// added by S.Hirano 01/03/02
proc rto_演説２x:07{
vox t:vc010402 {
	talk オタコン 標準 -m {
		[TO_演説２x:オタコン_000]
		//まして海軍も別のメタルギアの開発を
		//進めているとあったら尚更だね。
	}
}
}


// added by S.Hirano 01/03/02
proc rto_演説３:07{
//vox t:vc010501 {
	talk オタコン 標準 -m {
		[TO_演説３:オタコン_000]
		//海兵隊司令官の言ってた海軍作戦総長の
		//話なら聞いたことがある。まだ僕が
		//ＡＴ社に居た頃にね。
	}
	talk オタコン 標準 -m {
		[TO_演説３:オタコン_001]
		//ボーダ大将は自殺じゃなくて、
		//殺されたんだっていう噂だ。
	}
	talk オタコン 標準 -m {
		[TO_演説３:オタコン_002]
		//しかもそれを仕組んだのは僕らの
		//会社のベイカー社長とＤＡＲＰＡの
		//アンダーソン局長だ、という話だった。
	}
	talk オタコン 標準 -m {
		[TO_演説３:オタコン_003]
		//ＤＡＲＰＡとＡＴ社が進めようとしていたメタルギア計画はアーセナルシップ
		//計画と戦略的に重複する部分が多い。
	}
	talk オタコン 標準 -m {
		[TO_演説３:オタコン_004]
		//海軍のアーセナルシップ計画が進行中で
		//ある限りメタルギア開発にＧＯサインは
		//出ないような状況だったんだ。
	}
	talk オタコン 標準 -m {
		[TO_演説３:オタコン_005]
		//だけどアーセナルシップ計画は
		//ボーダ大将の死によって打ち切りに
		//なった。
	}
	talk オタコン 標準 -m {
		[TO_演説３:オタコン_006]
		//そしてその予算はＤＡＲＰＡに回されて、
		//メタルギアＲＥＸの開発が始まり、
		//それを受注したのがＡＴ社だ。
	}
	talk オタコン 標準 -m {
		[TO_演説３:オタコン_007]
		//変な噂が立つのも無理はないよね。
	}
	talk オタコン 標準 -m {
		[TO_演説３:オタコン_008]
		//本当のことは僕も知らない。
		//だけどあの社長のことだから、ありうる
		//ことなんじゃないかとは思ってた……。
	}
//}
}


// added by S.Hirano 01/03/02
proc rto_演説４:07{
vox t:vc010601 {
	talk オタコン 標準 -m {
		[TO_演説４:オタコン_000]
		//海兵隊司令官の言ってたＮＭＤって
		//いうのは全米ミサイル防衛のことだ。
	}
	talk オタコン 標準 -m {
		[TO_演説４:オタコン_001]
		//合衆国本土に向かって発射された
		//大陸間弾道弾を迎撃するっていう
		//構想で前世紀末から開発されていた。
	}
	talk オタコン 標準 -m {
		[TO_演説４:オタコン_002]
		//でもそれは、核兵器の多弾頭化や
		//高性能化を呼んで核軍拡を導く
		//という強い批判を生んだんだ。
	}
	talk オタコン 標準 -m {
		[TO_演説４:オタコン_003]
		//弾道弾迎撃ミサイル制限条約に
		//違反するとしてロシアや中国も強く
		//反対した。
	}
	talk オタコン 標準 -m {
		[TO_演説４:オタコン_004]
		//他にも標的と囮の識別等の技術的問題が
		//解決されずに実験が失敗を繰り返した
		//事もあって未だ配備されてないんだ。
	}
}
}


// added by S.Hirano 01/03/02
proc rto_船倉写真条件１:07{
vox t:vc010701 {
	talk オタコン 標準 -m {
		[TO_船倉写真条件１:オタコン_000]
		//ようやく辿り着いたね。
	}
	talk スネーク 標準 -m {
		[TO_船倉写真条件１:スネーク_001]
		//ああ。
		//これが新型メタルギアか……。
	}
	talk オタコン 標準 -m {
		[TO_船倉写真条件１:オタコン_002]
		//そうだ。その姿を世界中の人に
		//見せてやるんだ。
	}
}
}


// added by S.Hirano 01/03/02
proc rto_船倉写真条件２:07{
vox t:vc010702 {
	talk オタコン 標準 -m {
		[TO_船倉写真条件２:オタコン_000]
		//新型メタルギアをカメラに収めてくれ。
	}
}
}


// added by S.Hirano 01/03/02
proc rto_船倉写真条件３:07{
//むびＸＸＸＸＸＸＸＸＸ
vox t:vc010703 {
	talk オタコン 標準 -m {
		[TO_船倉写真条件３:オタコン_000]
		//必要な写真は４枚だ。まずメタルギアを
		//それぞれ右斜め前、正面、左斜め前から
		//撮ったのを１枚ずつ。
	}
	talk オタコン 標準 -m {
		[TO_船倉写真条件３:オタコン_001]
		//それと、メタルギアに描いてある
		//「ＭＡＲＩＮＥＳ」っていう海兵隊の
		//マーキングのアップを１枚。
	}
}
}


// added by S.Hirano 01/03/02
proc rto_船倉写真条件４:07{
vox t:vc010704 {
	talk オタコン 標準 -m {
		[TO_船倉写真条件４:オタコン_000]
	}
}
}


// added by S.Hirano 01/03/02
proc rto_船倉写真条件５:07{
vox t:vc010705 {
	talk オタコン 標準 -m {
		[TO_船倉写真条件５:オタコン_000]
		//写真が撮れたら、そのエリアの南東に
		//あるＷＳを使ってこっちに送信するんだ。
		//良い写真を頼むよ！
	}
}
}


// added by S.Hirano 01/03/02
proc rto_船倉残り写真１:07{
vox t:vc010801 {
	talk オタコン 標準 -m {
		[TO_船倉残り写真１:オタコン_000]
		//右からの写真はＯＫだ。
		//あとは、左、前、「ＭＡＲＩＮＥＳ」の
		//マーキングのアップ、の３枚だ。頼むよ。
	}
}
}


// added by S.Hirano 01/03/02
proc rto_船倉残り写真２:07{
vox t:vc010802 {
	talk オタコン 標準 -m {
		[TO_船倉残り写真２:オタコン_000]
		//左からの写真はこれでいい。あと３枚だ。
