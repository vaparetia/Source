//ＵＳＰ入手後。ＣＡＬＬ？
proc rto_ＵＳＰ注意１:07 {
vox t:vc009401 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ＵＳＰ注意１:オタコン_000]
		//スネーク、ハンドガンを手に入れたね。
	}
	talk スネーク 標準 -m {
		[TO_ＵＳＰ注意１:スネーク_001]
		//ああ。ＵＳＰだ。
	}
} //v
}

// added by S.Hirano 01/03/02
proc rto_ＵＳＰ注意センサー壊せる:07 {
vox t:vc009402 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ＵＳＰ注意センサー壊せる:オタコン_000]
		//その銃なら、さっきあった
		//赤外線センサーのトラップも
		//破壊できるはずだ。
	}
} //v
}


proc rto_ＵＳＰ注意２:07 {
vox t:vc009403 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ＵＳＰ注意２:オタコン_000]
		//ＵＳＰが発射するのはＭ９で使ってる
		//麻酔弾じゃない。実弾だ。
		//わかってるよね。
	}

	talk オタコン 標準 -m {
		[TO_ＵＳＰ注意２:オタコン_001]
		//あと、そのＵＳＰにサプレッサーは
		//装備されてない。撃てば銃声がするから近くに敵が居たら気づかれると思う。
	}

	talk オタコン 標準 -m {
		[TO_ＵＳＰ注意２:オタコン_002]
		//注意してくれ。
	}
	talk オタコン 標準 -m {
		[TO_ＵＳＰ注意２:オタコン_003]
		//ＵＳＰがあれば戦闘が有利になるのは
		//確かだけど、やっぱり敵に見つからない
		//のが一番だ。いいね。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_船倉へ向かえ１:07 {
vox t:vc009501 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_船倉へ向かえ１:オタコン_000]
		//スネーク、メタルギアはタンカー下部の
		//船倉だ。下に向かってくれ。
	}
}
}


// added by S.Hirano 01/03/02
proc rto_船倉へ向かえ２:07 {
vox t:vc009502 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_船倉へ向かえ２:オタコン_000]
		//さっき手に入れたＵＳＰなら、
		//赤外線センサーのトラップも
		//壊せるはずだ。
	}
	talk オタコン 標準 -m {
		[TO_船倉へ向かえ２:オタコン_001]
		//船倉へ行くにはあのトラップを通過する
		//以外に道はない。トラップをクリアして
		//その先へ進んでくれ。
	}
}
}


// added by S.Hirano 01/03/02
proc rto_長廊下船倉へ向かえ１:07{
