proc rto_主観攻撃１の１:07 {
//むびＸＸＸＸＸＸＸＸＸ
vox t:vc013501 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_主観攻撃１の１:オタコン_000]
		//武器を装備した状態で主観にして、
		//＃｛□、武器｝＃ボタンで武器を構えれば、
		//主観攻撃が出来る。
	}
} //v
}

proc rto_主観攻撃１の２:07 {
//むびＸＸＸＸＸＸＸＸＸ
vox t:vc013502 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_主観攻撃１の２:オタコン_000]
		//主観攻撃を使えば、上や下にも撃てるし、
		//敵の足や頭を狙うことも出来るんだ。
	}
} //v
}

proc rto_主観攻撃２の１:07 {
//むびＸＸＸＸＸＸＸＸＸ
vox d:_vc013503 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_主観攻撃２の１:オタコン_000]
		//主観攻撃中にもＬ２ボタン、
		//Ｒ２ボタンで左右ステップしたり、
		//＃｛×、ホフク｝＃ボタンでしゃがんだり出来る。
	}
} //v
}

proc rto_主観攻撃２の２:07 {
//むびＸＸＸＸＸＸＸＸＸ
vox t:vc013504 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_主観攻撃２の２:オタコン_000]
		//うまく使えば、遮蔽物に隠れながら、
		//相手の隙を見て飛び出して撃って
		//また隠れるとか出来るはずだ。
	}
} //v
}


proc rto_銃を構えて下ろす１:07 {
//むびＸＸＸＸＸＸＸＸＸ
vox t:vc013601 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_銃を構えて下ろす１:オタコン_000]
		//ハンドガンは＃｛□、武器｝＃ボタンで構えても、
		//ゆっくり＃｛□、武器｝＃ボタンを離せば
		//発砲せずに銃を下ろすことが出来る。
	}
} //v
}

proc rto_銃を構えて下ろす２:07 {
vox t:vc013602 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_銃を構えて下ろす２:オタコン_000]
		//弾を無駄に使わずに済むし、
		//敵をホールドアップさせた後
		//なんかでも役立つと思う。
	}
} //v
}

proc rto_武器を構えて下ろす１:07 {
vox t:vc013701 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_武器を構えて下ろす１:オタコン_000]
		//武器は＃｛□、武器｝＃ボタンで構えても、
		//ゆっくり＃｛□、武器｝＃ボタンを離せば
		//攻撃せずに下ろすことが出来る。
	}
} //v
}

proc rto_血痕見つかる:07 {
vox t:vc013801 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_血痕見つかる:オタコン_000]
		//スネークが敵の攻撃を受けたら血が
		//飛び散る。血の跡が残るからそれが敵に
		//見つかったら面倒なことになるだろう。
	}
	talk オタコン 標準 -m {
		[TO_血痕見つかる:オタコン_001]
		//血を流すようなことは出来るだけ
		//さけたほうがいい。
	}
} //v
}

proc rto_流血止血条件出血状態:07 {
vox t:vc013901 {
@rt_つっこまれ＿是＿なんで知ってるんだ系デフォルト 100
@rt_うなづきデフォルト＿否
	talk オタコン 標準 -m {
		[TO_流血止血条件出血状態:オタコン_000]
		//スネーク、出血してるのかい！？
	}
} //v
}

proc rto_流血止血条件:07 {
vox t:vc013902 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_流血止血条件:オタコン_001]
		//＃｛ＬＩＦＥ、ライフ｝＃ゲージが赤くなるまで減ると
		//血が止まらなくなるんだ。
	}
	talk オタコン 標準 -m {
		[TO_流血止血条件:オタコン_002]
		//出血してる間は＃｛ＬＩＦＥ、ライフ｝＃も少しずつ
		//減っていくし、血痕を敵に見つけられて
		//追跡されるかもしれない。
	}
	talk オタコン 標準 -m {
		[TO_流血止血条件:オタコン_003]
		//完全に血を止めるには＃｛ＬＩＦＥ、ライフ｝＃ゲージが
		//緑色に戻るまで回復させるしかない。
		//回復にはレーションが一番いいね。
	}
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_流血止血条件:オタコン_004]
		//でも出血してる間はしゃがむかホフク
		//するかして、じっと止まっていれば
		//少しずつ＃｛ＬＩＦＥ、ライフ｝＃が回復するんだ。
	}
	talk オタコン 標準 -m {
		[TO_流血止血条件:オタコン_005]
		//血が止まるまでどこかで隠れているのも
		//いいかもしれない。
	}
} //v
}

//仕様かわったから使えないっす
proc rto_流血止血条件止血剤:07 {
vox t:vc013903 {
	talk オタコン 標準 -m {
		[TO_流血止血条件止血剤:オタコン_000]
		//止血剤を装備すれば血は止まるけど、
		//あくまで応急処置だ。装備から外したら
		//また出血してしまう。気をつけてくれ。
	}
} //v
}

proc rto_麻酔効き方:07 {
vox t:vc014001 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_麻酔効き方:オタコン_000]
		//スネーク、Ｍ９の麻酔弾は、
		//敵のどこに当たったかによって
		//効き方が変わってくるんだ。
	}
	talk オタコン 標準 -m {
		[TO_麻酔効き方:オタコン_001]
		//頭や心臓に当てれば敵はすぐに倒れるし、
		//手や足だったら麻酔が効くまで
		//少し時間がかかる。
	}
	talk オタコン 標準 -m {
		[TO_麻酔効き方:オタコン_002]
		//主観攻撃でよく狙った方がいいね。
	}
} //v
}

proc rto_飛び込み前転:07 {
//むびＸＸＸＸＸＸＸＸＸ
vox t:vc014101 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_飛び込み前転:オタコン_000]
		//走りながら＃｛×、ホフク｝＃ボタンを押すと
		//飛び込み前転が出来る。
	}
	talk オタコン 標準 -m {
		[TO_飛び込み前転:オタコン_001]
		//物陰から物陰に素早く移動したりする
		//時とかにうまく使ってくれ。
	}
} //v
}

proc rto_そろそろ歩き:07 {
vox d:_vc014201 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_そろそろ歩き:オタコン_000]
		//左スティックの倒し具合を少しにすれば、
		//忍び足で歩ける。
	}
	talk オタコン 標準 -m {
		[TO_そろそろ歩き:オタコン_001]
		//移動速度は遅くなるけど足音が
		//しないから、歩くと音が鳴ってしまう
		//床の上では役に立つはずだ。
	}
} //v
}

proc rto_死体隠せ:07 {
vox t:vc014301 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_死体隠せ:オタコン_000]
		//スネーク、敵を倒してもそれだけで
		//安心しちゃダメだ。倒した敵を
		//そのままにしておくのはマズイ。
	}
	talk オタコン 標準 -m {
		[TO_死体隠せ:オタコン_001]
		//倒れた仲間を敵が見つけたら、
		//当然警戒態勢を強化するはずだからね。
	}
	talk オタコン 標準 -m {
		[TO_死体隠せ:オタコン_002]
		//倒した敵の体はどこか人目につかない
		//場所に隠した方がいい。
	}
} //v
}

proc rto_死体引きずり方法１:07 {
vox t:vc014401 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_死体引きずり方法１:オタコン_000]
		//倒れた敵は引きずって
		//移動させることが出来るんだ。
	}
} //v
}

proc rto_死体引きずり方法２:07 {
//むびＸＸＸＸＸＸＸＸＸ
vox t:vc014402 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_死体引きずり方法２:オタコン_000]
		//やり方は、倒れた敵の体の近くで、
		//武器を装備せずに＃｛□、武器｝＃ボタンを押せば、
		//敵の体を抱える。
	}
	talk オタコン 標準 -m {
		[TO_死体引きずり方法２:オタコン_001]
		//これで＃｛□、武器｝＃ボタンを押している間、
		//敵を引きずることが出来る。
		//離す時は＃｛□、武器｝＃ボタンを離せばいい。
	}
} //v
}
proc rto_死体引きずり方法３:07 {
vox t:vc014403 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_死体引きずり方法３:オタコン_000]
		//倒した敵をそのままにしておくのは
		//マズイからね。人目につかない場所に
		//隠すんだ。
	}
} //v
}


proc rto_死体硬直１:07 {
vox t:vc014501 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_死体硬直１:オタコン_000]
		//スネーク、倒した敵の体は
		//すぐ隠すようにした方が良い。
	}
} //v
}


proc rto_死体硬直２:07 {
vox t:vc014502 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_死体硬直２:オタコン_000]
		//眠ったり気絶したりしてる敵はすぐに
		//起き上がってくるし、そうでない敵も
		//しばらくすると硬直して動かせなくなる。
	}
	talk オタコン 標準 -m {
		[TO_死体硬直２:オタコン_001]
		//注意してくれ。
	}
} //v
}

proc rto_死体ロッカー隠し:07 {
//むびＸＸＸＸＸＸＸＸＸ
vox t:vc014601 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_死体ロッカー隠し:オタコン_000]
		//ロッカーの中に倒した敵の体を
		//隠すことも出来る。
	}
	talk オタコン 標準 -m {
		[TO_死体ロッカー隠し:オタコン_001]
		//やり方はロッカーを開けて、
		//そこまで敵の体を引きずっていけばいい。
	}
} //v
}

proc rto_部位ダメージ銃１:07{
vox t:vc014701 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_部位ダメージ銃１:オタコン_000]
		//ハンドガンとかの弾は、
		//敵の体のどこに当たるかによって、
		//与えるダメージが違うんだ。
	}
	talk オタコン 標準 -m {
		[TO_部位ダメージ銃１:オタコン_001]
		//手を撃てば敵は手が使えなくなるし、
		//足を撃てば歩けなくなる。
		//頭や心臓を狙えば一発で倒せるよ。
	}
} //v
}

proc rto_部位ダメージ銃２:07{
vox t:vc014702 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_部位ダメージ銃２:オタコン_000]
		//腰の右後ろにある無線機を撃って壊せば、
		//敵が応援を呼ぶのを防ぐことも出来る。
		//状況に応じて、主観攻撃でよく狙うんだ。
	}
} //v
}

proc rto_ビハインド覗き:07 {
//むびＸＸＸＸＸＸＸＸＸ
vox d:_vc014801 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ビハインド覗き:オタコン_000]
		//ビハインドの時にＬ２ボタンもしくは
		//Ｒ２ボタンを押すと物陰から頭を出して
		//その方向を覗き込むことが出来る。
	}
	talk オタコン 標準 -m {
		[TO_ビハインド覗き:オタコン_001]
		//ビハインドするより遠くまで見えるけど、
		//頭を出すから敵に見つかりやすくなる。
		//そこは気をつけてくれ。
	}
} //v
}

proc rto_ビハインド飛び出し１:07 {
//むびＸＸＸＸＸＸＸＸＸ
vox t:vc014901 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ビハインド飛び出し１:オタコン_000]
		//武器を装備してビハインドしている時に
		//＃｛□、武器｝＃ボタンを押すと、物陰から素早く
		//飛び出して武器を構えることが出来る。
	}
} //v
}

proc rto_ビハインド飛び出し２:07 {
vox t:vc014902 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ビハインド飛び出し２:オタコン_000]
		//立ったままでも、しゃがんだ状態でも
		//可能だ。銃撃戦の時にうまく使ってくれ。
	}
} //v
}

proc rto_ビハインド中右スティック:07 {
//むびＸＸＸＸＸＸＸＸＸ
vox d:_vc015001 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ビハインド中右スティック:オタコン_000]
		//ビハインド中に右スティックを動かせば
		//その方向を伺うことが出来る。
	}
	talk オタコン 標準 -m {
		[TO_ビハインド中右スティック:オタコン_001]
		//Ｌ２ボタン、Ｒ２ボタンの覗き込みと
		//違って体を乗り出さないぶん安全だ。
		//見える範囲は少なくなるけどね。
	}
} //v
}

proc rto_影伸び１:07 {
vox t:vc015101 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_影伸び１:オタコン_000]
		//スネーク、照明の具合によっては
		//影が大きく伸びてしまう場所がある。
		//そういう所では、影にも注意してくれ。
	}
} //v
}

proc rto_影伸び２:07 {
vox t:vc015102 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_影伸び２:オタコン_000]
		//伸びた影を敵に見つけられてしまう
		//ことがあるかもしれないからね。
		//特に曲がり角では気をつけた方が良い。
	}
	talk オタコン 標準 -m {
		[TO_影伸び２:オタコン_001]
		//でも、敵の影も同じように伸びるから、
		//人影を見つけたら近づかないように
		//すれば無用な危険をさけられるはずだ。
	}
} //v
}


proc rto_不審物:07 {
vox t:vc015201 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_不審物:オタコン_000]
		//物はあまり壊したりしない方がいい。
		//潜入の痕跡を発見されると、当然敵に
		//警戒されるからね。気をつけてくれ。
	}
} //v
}

proc rto_探索モード:07 {
vox t:vc015301 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_探索モード:オタコン_000]
		//一度見つかったら、例え逃げ切っても
		//安心しちゃダメだ。
	}
	talk オタコン 標準 -m {
		[TO_探索モード:オタコン_001]
		//敵は君を探して警戒を強化するはず
		//だからね。注意してくれ。
	}
} //v
}

proc rto_クリアリング１:07 {
vox t:vc015401 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_クリアリング１:オタコン_000]
		//スネーク、早くどこかに隠れるんだ！
		//敵は君を徹底的に探し出そうとしてる。
		//クリアリングだ。
	}
} //v
}

proc rto_クリアリング２:07 {
vox t:vc015402 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_クリアリング２:オタコン_000]
		//敵が呼んだ増援部隊は一度侵入者を
		//見失っても簡単にはあきらめない。君が
		//隠れていそうな場所まで探しに来るんだ。
	}

	talk オタコン 標準 -m {
		[TO_クリアリング２:オタコン_001]
		//中途半端な隠れ方じゃ見つかってしまう。
		//どこか見つかりにくい場所に
		//身を隠すんだ。いいね。
	}
} //v
}

proc rto_銃撃戦１:07 {
vox t:vc015501 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_銃撃戦１:オタコン_000]
		//万一、敵に見つかって銃撃戦になったら
		//遮蔽物に隠れながら戦うんだ。無防備に
		//体をさらしてはいけない。
	}
} //v
}

proc rto_銃撃戦２:07 {
//むびＸＸＸＸＸＸＸＸＸ
vox t:vc015502 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_銃撃戦２:オタコン_000]
		//隠れながら左右ステップや伸び上がりを
		//使って主観攻撃で応戦してくれ。
	}
	talk オタコン 標準 -m {
		[TO_銃撃戦２:オタコン_001]
		//でも一度に大勢で来られたら、
		//いくら君でも太刀打ち出来ないだろう。
		//見つからないのが一番だからね。
	}
} //v
}

proc rto_敵の無線連絡１:07 {
vox t:vc015601 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_敵の無線連絡１:オタコン_000]
		//敵は君を見つけると無線で仲間を呼ぶ。
		//それでやって来る増援部隊はかなり
		//手強いはずだ。
	}
} //v
}

proc rto_敵の無線連絡２:07 {
vox t:vc015602 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_敵の無線連絡２:オタコン_000]
		//＃｛防弾衣、ボディ・アーマー｝＃とか、一般の兵士よりも
		//上の装備も持ってるし、何より彼らは
		//戦闘馴れしている。
	}
	talk オタコン 標準 -m {
		[TO_敵の無線連絡２:オタコン_001]
		//チームで攻撃してくるから、
		//いくら君でも一人でまともに
		//やりあうのは危ないと思う。
	}
} //v
}

proc rto_敵の無線連絡３の１:07 {
vox t:vc015603 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_敵の無線連絡３の１:オタコン_000]
		//万一敵に見つかったら、
		//仲間を呼ばれないようにした方が良いね。
	}
} //v
}

proc rto_敵の無線連絡３の２:07 {
vox t:vc015604 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_敵の無線連絡３の２:オタコン_000]
		//無線で仲間を呼ぶ前にその敵を倒せば、
		//増援部隊とは戦わずに済むはずだ。
	}
} //v
}

proc rto_敵の無線連絡４:07 {
vox t:vc015605 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_敵の無線連絡４:オタコン_000]
		//チャフ・グレネードを使って無線を
		//妨害しても、敵が応援を呼ぶのを
		//防げる。
	}
} //v
}


proc rto_敵の無線連絡５:07 {
vox t:vc015606 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_敵の無線連絡５:オタコン_000]
		//無線機を壊せば敵は応援を呼べなくなる
		//はずだ。
	}
	talk オタコン 標準 -m {
		[TO_敵の無線連絡５:オタコン_001]
		//敵は無線機を腰の右後ろにつけてる。
		//主観攻撃で狙えば撃ち抜けるだろう。
	}
} //v
}

proc rto_敵の無線連絡６:07 {
vox t:vc015607 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_敵の無線連絡６:オタコン_000]
		//もしも仲間を呼ばれてしまったら、
		//増援部隊が到着する前に隠れた方が
		//いいね。
	}
} //v
}


proc rto_増援部隊:07 {
vox t:vc015701 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_増援部隊:オタコン_000]
		//敵の増援部隊は＃｛防弾衣、ボディ・アーマー｝＃を着てる。
		//＃｛防弾衣、ボディ・アーマー｝＃で守られてる部分は何発か当て
		//なければダメージを与えられないんだ。
	}
	talk オタコン 標準 -m {
		[TO_増援部隊:オタコン_001]
		//でも頭を狙えば一発だ。
		//主観攻撃で頭を狙ってくれ。
	}
} //v
}

proc rto_ヒドゥンポイント:07 {
vox t:vc015801 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ヒドゥンポイント:オタコン_000]
		//暗がりにいれば、敵も君を見つけにくい
		//はずだ。でもクリアリングの時は
		//見つかってしまうから気をつけてくれよ。
	}
} //v
}

proc rto_マガジン投げ:07 {
//むびＸＸＸＸＸＸＸＸＸ
vox t:vc015901 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_マガジン投げ:オタコン_000]
		//マガジンは装備して＃｛□、武器｝＃ボタンで
		//投げられるんだ。マガジンが床に落ちた
		//時の音で敵をおびき寄せたり出来る。
	}
	talk オタコン 標準 -m {
		[TO_マガジン投げ:オタコン_001]
		//＃｛□、武器｝＃ボタンを押す強さで投擲距離が変わる。
		//主観攻撃で狙って、うまく敵を誘導
		//出来るポイントへ落とすんだ。
	}
} //v
}

proc rto_ホールドアップ:07 {
//むびＸＸＸＸＸＸＸＸＸ
vox t:vc016001 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ホールドアップ:オタコン_000]
		//敵の後ろから銃を突き付ければ、敵を
		//ホールドアップさせられる。その後、
		//無抵抗の相手をどうするかは君次第だ。
	}
} //v
}

// added by S.Hirano 01/03/02
proc rto_武器装備品装備法１:07 {
vox t:vc016201 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_武器装備品装備法１:オタコン_000]
		//武器を装備するには、まず、
		//Ｒ２ボタンを押しっぱなしにして
		//武器モードにするんだ。
	}
	talk オタコン 標準 -m {
		[TO_武器装備品装備法１:オタコン_001]
		//武器のアイコンが表示されるだろ。
		//その中から使いたい武器を左スティック
		//の上下で選んで右下に合わせるんだ。
	}
	talk オタコン 標準 -m {
		[TO_武器装備品装備法１:オタコン_002]
		//同じ系統の武器をいくつか持っている
		//時はアイコンが横に並んで表示される。
	}
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_武器装備品装備法１:オタコン_003]
		//その中から使いたい武器を
		//左スティックの左右で一番右に
		//合わせてくれ。
	}
	talk オタコン 標準 -m {
		[TO_武器装備品装備法１:オタコン_004]
		//そこでＲ２ボタンを離せば、
		//その武器を装備出来るってわけさ。
	}
	talk オタコン 標準 -m {
		[TO_武器装備品装備法１:オタコン_005]
		//それぞれの武器の詳しい使い方は
		//ウィンドウの中の説明を読んでくれ。
	}
}
}


// added by S.Hirano 01/03/02
proc rto_武器装備品装備法２:07 {
vox t:vc016202 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_武器装備品装備法２:オタコン_000]
		//レーションとかの装備品を
		//装備したい時はＬ２ボタンで
		//同じことをすればいい。
	}
}
}


proc rto_武器装備品装備法従来型１:07 {
vox t:vc016301 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_武器装備品装備法従来型１:オタコン_000]
		//武器を装備するには、まず、
		//Ｒ２ボタンを押しっぱなしにして
		//武器モードにするんだ。
	}
	talk オタコン 標準 -m {
		[TO_武器装備品装備法従来型１:オタコン_001]
		//武器のアイコンが表示されるだろ。
		//その中から使いたい武器を左スティック
		//の上下で選んで右下に合わせるんだ。
	}
	talk オタコン 標準 -m {
		[TO_武器装備品装備法従来型１:オタコン_002]
		//そこでＲ２ボタンを離せば、
		//その武器を装備出来るってわけさ。
	}
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_武器装備品装備法従来型１:オタコン_003]
		//それぞれの武器の詳しい使い方は
		//ウィンドウの中の説明を読んでくれ。
	}
} //v
}

proc rto_武器装備品装備法従来型２:07 {
vox t:vc016302 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_武器装備品装備法従来型２:オタコン_000]
		//レーションとかの装備品を
		//装備したい時はＬ２ボタンで
		//同じことをすればいい。
	}
} //v
}


proc rto_無線ＣＡＬＬ:07 {
vox d:_vc016401 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_無線ＣＡＬＬ:オタコン_000]
		//スネーク、僕の方から緊急に伝えたい
		//ことがある場合はＣＡＬＬする。
	}
	talk オタコン 標準 -m {
		[TO_無線ＣＡＬＬ:オタコン_001]
		//ＣＡＬＬサインが出たら、
		//ＳＥＬＥＣＴボタンを押して
		//受信するんだ。いいね。
	}
} //v
}

proc rto_パンチキック:07 {
//むびＸＸＸＸＸＸＸＸＸ
vox t:vc016501 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_パンチキック:オタコン_000]
		//スネーク、接近戦になったら格闘だ。
		//＃｛○、パンチ｝＃ボタンでパンチが出せる。
		//音を立てずに攻撃出来るはずだ。
	}
	talk オタコン 標準 -m {
		[TO_パンチキック:オタコン_001]
		//＃｛○、パンチ｝＃ボタンを連打すれば＃｛連続技、コンボ｝＃になって
		//敵を吹き飛ばせるし、主観攻撃も出来る。
	}
	talk オタコン 標準 -m {
		[TO_パンチキック:オタコン_002]
		//でも一番いいのは、接近戦になるような
		//局面はさけることだ。
	}
} //v
}

proc rto_投げ:07 {
//むびＸＸＸＸＸＸＸＸＸ
vox d:_vc016601 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_投げ:オタコン_000]
		//武器を装備していない時は投げ技が使え
		//る。やり方は敵の近くで左スティックを
		//入れながら＃｛□、武器｝＃ボタンを押せばいい。
	}
	talk オタコン 標準 -m {
		[TO_投げ:オタコン_001]
		//敵を地面に倒せるし、うまくすれば
		//気絶させることも出来るはずだ。
	}
} //v
}

proc rto_首締め１:07 {
vox t:vc016701 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_首締め１:オタコン_000]
		//スネーク、武器を装備していない時は、
		//投げ技の他にも敵の首を絞めることが
		//出来る。
	}
} //v
}

proc rto_首締め２:07 {
//むびＸＸＸＸＸＸＸＸＸ
vox d:_vc016702 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_首締め２:オタコン_000]
		//首を絞めるには、敵の後ろから
		//近づいて左スティックを入れずに
		//＃｛□、武器｝＃ボタンを押すんだ。
	}
	talk オタコン 標準 -m {
		[TO_首締め２:オタコン_001]
		//そのまま＃｛□、武器｝＃ボタンを連打すれば、
		//敵を倒せる。押しっぱなしにすれば
		//敵を引きずって移動することも出来る。
	}
} //v
}

proc rto_首締め３:07 {
vox t:vc016703 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_首締め３:オタコン_000]
		//でも気をつけてくれ。敵の正面からじゃ
		//首は絞められない。首絞めを仕掛ける
		//時は必ず相手の後ろに回りこむんだ。
	}
} //v
}


proc rto_張り付きコンコン１:07 {
//むびＸＸＸＸＸＸＸＸＸ
vox d:_vc016801 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_張り付きコンコン１:オタコン_000]
		//壁の方向に向かって左スティックを
		//押しっぱなしにすると、壁に張り付ける。
	}
} //v
}

proc rto_張り付きコンコン２:07 {
//むびＸＸＸＸＸＸＸＸＸ
vox t:vc016802 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_張り付きコンコン２:オタコン_000]
		//壁に張り付いている時に＃｛○、パンチ｝＃ボタンを
		//押せば、壁を叩いて物音を立てることが
		//出来るんだ。
	}
} //v
}

proc rto_張り付きコンコン３:07 {
vox t:vc016803 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_張り付きコンコン３:オタコン_000]
		//うまくやれば持ち場から動こうとしない
		//敵をおびき寄せたりすることも出来る
		//はずだ。
	}
} //v
}

proc rto_普通のビハインド１:07 {
//むびＸＸＸＸＸＸＸＸＸ
vox t:vc016901 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_普通のビハインド１:オタコン_000]
		//物陰の角に張り付くとビハインドモード
		//になる。自分は隠れながら曲がり角の
		//先とかを覗くことが出来るんだ。
	}
} //v
}

proc rto_普通のビハインド２:07 {
//むびＸＸＸＸＸＸＸＸＸ
vox d:_vc016902 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_普通のビハインド２:オタコン_000]
		//ビハインドモードからはＬ２ボタン、
		//Ｒ２ボタンで覗き込みをしたり、
		//武器を構えて飛び出したり出来る。
	}
	talk オタコン 標準 -m {
		[TO_普通のビハインド２:オタコン_001]
		//うまく使ってくれ。
	}
} //v
}



proc rto_イントルード１:07 {
vox t:vc017001 {	//％分離○
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_イントルード１:オタコン_000]
		//机の下とかにはホフクで潜り込める。
		//そうやって狭い所に入り込んだ時は
		//イントルードモードになるんだ。
	}
} //v
}

proc rto_イントルード２:07 {
vox d:_vc017002 {	//％分離○
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_イントルード２:オタコン_000]
		//イントルードモードの時は
		//左スティックの上で前進、下で後退、
		//左右でその方向を向く。
	}
	talk オタコン 標準 -m {
		[TO_イントルード２:オタコン_001]
		//主観ボタンを使えばまわりを見渡せるし、
		//銃を撃つことも出来る。
	}
} //v
}

proc rto_イントルード３:07 {
vox t:vc017003 {	//％分離○
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_イントルード３:オタコン_000]
		//でも隠れるところを敵に見られたら
		//攻撃されることもあるし、クリアリング
		//の時は見つかってしまうこともある。
	}
	talk オタコン 標準 -m {
		[TO_イントルード３:オタコン_001]
		//イントルードに逃げ込めば
		//安全ってわけじゃないってことだ。
		//気をつけてくれ。
	}
} //v
}

proc rto_ホフク１:07 {
vox t:vc017101 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ホフク１:オタコン_000]
		//スネーク、＃｛×、ホフク｝＃ボタンを押すとしゃがむ
		//ことが出来る。低い遮蔽物に隠れる時は
		//しゃがまなきゃダメだ。
	}
} //v
}

proc rto_ホフク２:07 {
vox d:_vc017102 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ホフク２:オタコン_000]
		//しゃがんでる時に左スティックを押すと、
		//その方向にホフクする。立ち上がるには
		//もう一度＃｛×、ホフク｝＃ボタンを押せばいい。
	}
} //v
}

proc rto_ホフク３:07 {
vox t:vc017103 {	//％分離○
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ホフク３:オタコン_000]
		//足音を立てたくない時や、机の下とかに
		//潜り込みたい時はホフクすればいい。
	}
} //v
}
proc rto_ホフク４:07 {
vox t:vc017104 {	//％分離○
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ホフク４:オタコン_000]
		//ハンドガンならホフクしながらでも
		//撃つことが出来る。隠れながら攻撃
		//したい時には役立つと思う。
	}
} //v
}

proc rto_アイテムボックス１:07 {
vox t:vc017201 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_アイテムボックス１:オタコン_000]
		//アイテムボックスを見かけたら
		//入手した方が良い。何のアイテムかは、
		//よく見れば書いてあると思う。
	}
} //v
}

proc rto_アイテムボックス２:07 {
//むびＸＸＸＸＸＸＸＸＸ
vox t:vc017202 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_アイテムボックス２:オタコン_000]
		//敵を倒して、その体を動かすと
		//アイテムボックスを出すことがある。
		//それを手に入れるのも忘れないようにね。
	}
} //v
}

proc rto_アイテムボックス３:07 {
vox t:vc017203 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_アイテムボックス３:オタコン_000]
		//敵を倒すとアイテムボックスを
		//出すことがある。それを手に入れるのも
		//忘れないようにね。
	}
} //v
}


proc rto_発見されるな:07 {
vox t:vc017301 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_発見されるな:オタコン_000]
		//スネーク、敵に見つからないように
		//してくれよ。敵は君を見つけたら、
		//当然仲間を呼んで攻撃してくる。
	}
	talk オタコン 標準 -m {
		[TO_発見されるな:オタコン_001]
		//組織的に攻撃されたら、いくら君でも
		//勝ち目はない。武装は向こうの方が
		//上だしね。
	}
	talk オタコン 標準 -m {
		[TO_発見されるな:オタコン_002]
		//僕らはテロリストじゃない。
		//無用な戦闘はさけてくれ。
		//あくまでも隠密行動だ。いいね。
	}
} //v
}


proc rto_Ｍ９:07 {
vox t:vc017401 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_Ｍ９:オタコン_000]
		//君が装備してるのはベレッタＭ９２Ｆを
		//改造した麻酔銃だ。命中すれば敵を
		//眠らせることが出来るよ。
	}
	talk オタコン 標準 -m {
		[TO_Ｍ９:オタコン_001]
		//麻酔弾は簡単に言えば小さな注射器
		//みたいなものだ。
	}
@rt_うんちく＿否＿わからん系デフォルト 100
@rt_うんちく＿是＿詳しいな系デフォルト 50
	talk オタコン 標準 -m {
		[TO_Ｍ９:オタコン_002]
		//着弾時の慣性で薬品を混合してガスを
		//発生させ、そのガスでピストンを押して、
		//対象に麻酔を注入する仕組みになってる。
	}
	talk オタコン 標準 -m {
		[TO_Ｍ９:オタコン_003]
		//麻酔弾は当たる場所によって、
		//麻酔が効くまでの時間が
		//変わってくるんだ。
	}
	talk オタコン 標準 -m {
		[TO_Ｍ９:オタコン_004]
		//頭や心臓なら早いし手足なら時間が
		//かかる。主観攻撃でうまく狙ってくれ。
	}
	talk オタコン 標準 -m {
		[TO_Ｍ９:オタコン_005]
		//サプレッサー装備だから銃声で敵に
		//見つかったりすることもないはずだ。
	}
	talk オタコン 標準 -m {
		[TO_Ｍ９:オタコン_006]
		//でもあくまでＭ９は麻酔銃だ。
		//敵を眠らせるだけで倒せるわけじゃない。
		//気をつけてくれ。
	}
} //v
}


proc rto_ＵＳＰ１:07 {
vox t:vc017501 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ＵＳＰ１:オタコン_000]
		//スネーク、君が装備してるハンドガンは
		//ＵＳＰだね。
	}
	talk オタコン 標準 -m {
		[TO_ＵＳＰ１:オタコン_001]
		//ＵＳＰは９ｍｍとか４５口径とか色々な
		//バリエントがあるんだけど、君のは
		//口径９ｍｍ、装弾数１５発のモデルだ。
	}
} //v
}

proc rto_ＵＳＰ２:07 {
vox t:vc017502 {	//％分離○
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ＵＳＰ２:オタコン_000]
		//フラッシュライトもついてるね。
		//暗いところでＵＳＰを装備して
		//構えればライトがつくはずだ。
	}
} //v
}

proc rto_ＵＳＰ３:07 {
vox t:vc017503 {	//％分離○
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ＵＳＰ３:オタコン_000]
		//でもＭ９と違ってサプレッサーは
		//付いてないから、発砲すれば当然
		//銃声がする。撃つ時には注意してくれ。
	}
} //v
}


proc rto_チャフ:07 {
vox t:vc017601 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_チャフ:オタコン_000]
		//チャフ・グレネードを持ってるね。
		//それを使えば少しの間、敵の無線や
		//電子機器を妨害することが出来る。
	}
	talk オタコン 標準 -m {
		[TO_チャフ:オタコン_001]
		//チャフはアルミ箔とか金属コーティング
		//したガラスやプラスティック繊維を散布
		//してレーダーを妨害する電子戦兵器だ。
	}
@rt_うんちく＿否＿わからん系デフォルト 100
@rt_うんちく＿是＿詳しいな系デフォルト 50
	talk オタコン 標準 -m {
		[TO_チャフ:オタコン_002]
		//君が持ってるのは戦闘機とかに
		//搭載されるチャフ・ディスペンサーを
		//携行用に小型化したものだね。
	}
	talk オタコン 標準 -m {
		[TO_チャフ:オタコン_003]
		//点火装置が発火すると微量の爆薬で
		//多数のチャフ片と同時に
		//＃｛小型妨害電波発信機、ミニ・アクティブ・ジャマー｝＃を散布する。
	}
	talk オタコン 標準 -m {
		[TO_チャフ:オタコン_004]
		//大規模なチャフ＃｛回廊、コリドー｝＃やチャフ雲は作り出
		//せないけど個人用としては充分な大きさ
		//の＃｛レーダー有効反射面積、ＲＣＳ｝＃を形成出来る。
	}
	talk オタコン 標準 -m {
		[TO_チャフ:オタコン_005]
		//でもあくまでも電子妨害用の手榴弾
		//だから、それで敵を倒すことは出来ない。
		//注意してくれ。
	}
} //v
}

proc rto_スタン:07 {
vox t:vc017701 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_スタン:オタコン_000]
		//スタン・グレネードを装備してるね。
		//それを使えば敵を殺さずに気絶させる
		//ことが出来る。
	}
	talk オタコン 標準 -m {
		[TO_スタン:オタコン_001]
		//スタン・グレネードは強烈な光と音を
		//発生させて人間を傷つけずに無力化する
		//＃｛非殺傷兵器、ノン・リーサル・ウェポン｝＃だ。
	}
@rt_うんちく＿否＿わからん系デフォルト 100
@rt_うんちく＿是＿詳しいな系デフォルト 50
	talk オタコン 標準 -m {
		[TO_スタン:オタコン_002]
		//投擲後、時限点火装置が作動すると、
		//微量の火薬で内蔵のカートリッジが
		//撃ち出される。
	}
	talk オタコン 標準 -m {
		[TO_スタン:オタコン_003]
		//カートリッジは１００万カンデラ以上の
		//閃光と２００デシベル以上の爆音を放出
		//して爆発し、人間の感覚を失わせるんだ。
	}
	talk オタコン 標準 -m {
		[TO_スタン:オタコン_004]
		//体を傷つける破片は飛び散らないから、
		//敵を気絶させるだけでダメージを
		//負わせることは出来ない。注意してくれ。
	}
} //v
}

proc rto_マガジン:07 {
vox t:vc017801 {
@rt_つっこまれ＿是＿なんで知ってるんだ系デフォルト 100
@rt_つっこまれ＿否＿お前が言うな系デフォルト 100
	talk オタコン 標準 -m {
		[TO_マガジン:オタコン_000]
		//スネーク、君が今持ってるのは、
		//撃ち尽くした銃の弾倉だ。捨てずに
		//取っておくなんて物持ちがいいね。
	}
} //v
}

proc rto_双眼鏡:07 {
vox t:vc017901 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_双眼鏡:オタコン_000]
		//双眼鏡を装備してるね。
		//それを使えば遠くから敵地を偵察出来る。
	}
	talk オタコン 標準 -m {
		[TO_双眼鏡:オタコン_001]
		//ズーム機能もついてるし、フォーカスも
		//オートだ。軍用品だから耐久性も問題
		//ない。壊れたりする心配もないと思う。
	}
} //v
}

proc rto_レーション:07 {
vox t:vc018001 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_レーション:オタコン_000]
		//レーションを装備してるね。
		//軍用の携帯糧食で、使うと＃｛ＬＩＦＥ、ライフ｝＃を
		//ある程度回復するアイテムだ。
	}
	talk オタコン 標準 -m {
		[TO_レーション:オタコン_001]
		//装備しておけば＃｛ＬＩＦＥ、ライフ｝＃が無くなる
		//瞬間、自動的に使って＃｛ＬＩＦＥ、ライフ｝＃を
		//回復出来る。
	}
	talk オタコン 標準 -m {
		[TO_レーション:オタコン_002]
		//ウィンドウで選んで＃｛○、決定｝＃ボタンを押せば、
		//その場で使うことも出来る。
	}
@rt_うんちく＿否＿わからん系デフォルト 100
@rt_うんちく＿是＿詳しいな系デフォルト 50
	talk オタコン 標準 -m {
		[TO_レーション:オタコン_003]
		//レーションは初めから戦場で食べる
		//ことを想定して作られた軍用携帯糧食だ。特に機能性とカロリーを重視してある。
	}
	talk オタコン 標準 -m {
		[TO_レーション:オタコン_004]
		//＃｛米軍調理開発研究所、ＮＲＯＣ｝＃が開発した
		//フリーズドライ方式を使っていて、小型
		//軽量で日持ちもするように出来てるんだ。
	}
} //v
}

proc rto_止血剤１:07 {
vox t:vc018101 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_止血剤１:オタコン_000]
		//止血剤を装備してるね。出血してる時に
		//止血剤を使えば血を止められる。
	}
} //v
}

proc rto_止血剤２:07 {
vox t:vc018102 {
@rt_うんちく＿否＿わからん系デフォルト 100
@rt_うんちく＿是＿詳しいな系デフォルト 50
	talk オタコン 標準 -m {
		[TO_止血剤２:オタコン_000]
		//その止血剤はいわゆるアルギネート材
		//だ。血液や体液を吸収してゲル化する
		//アルギン酸繊維製の吸収パッドだよ。
	}
	talk オタコン 標準 -m {
		[TO_止血剤２:オタコン_001]
		//吸収する時にカルシウムイオンを
		//放出するから止血効果が高いんだ。
	}
} //v
}

// added by S.Hirano 01/03/02
proc rto_カメラ:07 {
vox t:vc018201 {
	talk オタコン 標準 -m {
		[TO_カメラ:オタコン_000]
	}
	talk オタコン 標準 -m {
		[TO_カメラ:オタコン_001]
	}
	talk オタコン 標準 -m {
		[TO_カメラ:オタコン_002]
	}
	talk オタコン 標準 -m {
		[TO_カメラ:オタコン_003]
	}
} //v
}

proc rto_タバコ:07 {
vox t:vc018301 {
@rt_つっこまれ＿是＿なんで知ってるんだ系デフォルト 100
@rt_うなづきデフォルト＿否
	talk オタコン 標準 -m {
		[TO_タバコ:オタコン_000]
		//スネーク、煙草を吸ってるのかい？
		//やめた方が良いと思うよ。
	}
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_タバコ:オタコン_001]
		//暗いところで吸えば火が目立って
		//見つかりやすくなるし、何より健康に
		//良くない。
	}
	talk オタコン 標準 -m {
		[TO_タバコ:オタコン_002]
		//ナオミも肺癌の元だって言ってただろ。
		//だいたい今時煙草なんて流行らない。
	}
	talk スネーク 標準 -m {
		[TO_タバコ:スネーク_003]
		//悪いが流行には興味が無い。
	}
	talk オタコン 標準 -m {
		[TO_タバコ:オタコン_004]
		//ま、命を縮めるのは君の勝手だけど、
		//人の迷惑になるようなことをしちゃ
		//ダメだよ。
	}
	talk スネーク 標準 -m {
		[TO_タバコ:スネーク_005]
		//こいつは副流煙の出ない先折り煙草だ。
		//他人に迷惑はかけんよ。
	}
@rt_つっこまれ＿是＿なんで知ってるんだ系デフォルト 100
@rt_うなづきデフォルト＿否
	talk オタコン 標準 -m {
		[TO_タバコ:オタコン_006]
		//そうかな？
		//君、橋の上でポイ捨てしたろ？
	}
	talk スネーク 標準 -m {
		[TO_タバコ:スネーク_007]
		//……。
	}
	talk オタコン 標準 -m {
		[TO_タバコ:オタコン_008]
		//まったく！
	}
} //v
}

// added by S.Hirano 01/03/02
proc rto_耳栓:07 {
vox t:vc018401 {
	talk オタコン 標準 -m {
		[TO_耳栓:オタコン_000]
	}
	talk オタコン 標準 -m {
		[TO_耳栓:オタコン_001]
	}
	talk オタコン 標準 -m {
		[TO_耳栓:オタコン_002]
	}
}
}


proc rto_ジアゼパム:07 {
vox t:vc018501 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ジアゼパム:オタコン_000]
		//ジアゼパムを装備してるね。
		//アイテムウィンドウで選んで
		//＃｛○、決定｝＃ボタンを押せば使うことが出来る。
	}
@rt_うんちく＿否＿わからん系デフォルト 100
@rt_うんちく＿是＿詳しいな系デフォルト 50
	talk オタコン 標準 -m {
		[TO_ジアゼパム:オタコン_001]
		//ジアゼパムは鬱病とか自律神経失調症、不安神経症なんかの治療に使われる
		//マイナー・トランキライザーだ。
	}
	talk オタコン 標準 -m {
		[TO_ジアゼパム:オタコン_002]
		//ベンゾジアゼピン系の抗不安薬で
		//鎮静作用、抗鬱作用と同時に
		//抗痙攣作用もある。
	}
	talk オタコン 標準 -m {
		[TO_ジアゼパム:オタコン_003]
		//スナイパー・ライフルで精密狙撃を
		//する時とかに手ぶれを抑えられるよ。
		//でも持ってないんじゃ意味ないか……。
	}
@rt_疑惑＿否＿信じられん系デフォルト 100
	talk オタコン 標準 -m {
		[TO_ジアゼパム:オタコン_004]
		//そうだね。船酔いがひどいんだったら
		//飲んでみると良いと思うよ。
	}
} //v
}

proc rto_ダンボール:07 {
vox t:vc018601 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ダンボール:オタコン_000]
		//ダンボール箱をかぶってるね！
		//スネークはやっぱりそうでなくっちゃ。
		//うまく使って敵の目を誤魔化してくれ。
	}
	talk オタコン 標準 -m {
		[TO_ダンボール:オタコン_001]
		//でもダンボールは所詮紙だってことを
		//忘れないでくれ。敵から何度も攻撃を
		//受けたら当然破けてしまう。
	}
	talk オタコン 標準 -m {
		[TO_ダンボール:オタコン_002]
		//使い過ぎてもヘタってくるから
		//気をつけてくれ。あまり濡らしたり
		//しない方がいいんじゃないかな？
	}
} //v
}

/*
追加されました。
*/
proc rto_オルガ戦見つからずに移動せよ:07 {
vox t:vc018701 {
@rt_無茶指令＿否＿お前がやれ系デフォルト 100
@rt_うなづきデフォルト＿是
	talk オタコン 標準 -m {
		[TO_オルガ戦見つからずに移動せよ:オタコン_000]
		//スネーク、相手に君の位置を悟らせるな。
		//物陰に隠れたまま移動すれば、相手は
		//君を見失うはずだ。
	}
	talk オタコン 標準 -m {
		[TO_オルガ戦見つからずに移動せよ:オタコン_001]
		//必ず隙が出来る。そこを狙うんだ。
	}
} //v
}

proc rto_オルガ戦幌は通らない:07 {
vox t:vc018801 {
@rt_無茶指令＿否＿お前がやれ系デフォルト 100
@rt_うなづきデフォルト＿是
	talk オタコン 標準 -m {
		[TO_オルガ戦幌は通らない:オタコン_000]
		//スネーク、相手は幌に隠れながら
		//撃ってきてる。向こうからは
		//君が見えるけど、君からは見えない。
	}
	talk オタコン 標準 -m {
		[TO_オルガ戦幌は通らない:オタコン_001]
		//このままじゃ分が悪すぎる。
		//その幌を何とかするんだ！
	}
} //v
}

// added by S.Hirano 01/03/02
proc rto_オルガ戦ライト眩惑:07 {
vox t:vc018901 {
@rt_無茶指令＿否＿お前がやれ系デフォルト 100
@rt_うなづきデフォルト＿是
	talk オタコン 標準 -m {
		[TO_オルガ戦ライト眩惑:オタコン_000]
		//スネーク、そのライトはマズイ！
		//光に眩惑されて相手が見えなくなる。
		//ライトを消すんだ！
	}
} //v
}

proc rto_オルガ戦ヘッドショット:07 {
vox t:vc019001 {
@rt_無茶指令＿否＿お前がやれ系デフォルト 100
@rt_うなづきデフォルト＿是
	talk オタコン 標準 -m {
		[TO_オルガ戦ヘッドショット:オタコン_000]
		//ハンドガンの弾は相手のどこに
		//当たるかによって威力が変わって
		//くるんだ。
	}
	talk オタコン 標準 -m {
		[TO_オルガ戦ヘッドショット:オタコン_001]
		//頭を狙えばより大きなダメージを
		//与えられる。主観攻撃でよく狙うんだ。
	}
} //v
}

proc rto_Ｌ１ボタンロックオン:07 {
vox d:_vc019101 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_Ｌ１ボタンロックオン:オタコン_000]
		//銃を構えてＬ１ボタンを押すと
		//敵に向かって自動的に照準を合わせる。
	}
	talk オタコン 標準 -m {
		[TO_Ｌ１ボタンロックオン:オタコン_001]
		//＃｛俯瞰、フカン｝＃でも主観でも出来るから、
		//有効に使ってくれ。
	}
} //v
}

proc rto_階段魔人:07 {
vox t:vc019201 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_階段魔人:オタコン_000]
		//スネーク、階段の上に敵が待ち伏せ
		//してる！上から狙い撃ちされたら、
		//とてもその階段を上るのは無理だ！
	}
	talk オタコン 標準 -m {
		[TO_階段魔人:オタコン_001]
		//階段を上るには敵を振り切るしかない。
		//とりあえず逃げるんだ！
	}
} //v
}

proc rto_操舵室デモ後オルガ戦前:07 {
vox t:vc004803 {
	talk オタコン 標準 -m {
		[TO_操舵室デモ後オルガ戦前:オタコン_000]
	}
	talk スネーク 標準 -m {
		[TO_操舵室デモ後オルガ戦前:スネーク_001]
	}
	talk オタコン 標準 -m {
		[TO_操舵室デモ後オルガ戦前:オタコン_002]
	}
} //v
}



//続・追加ファイル達
proc rto_オルガ戦前:07 {
vox t:vc090101 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_オルガ戦前:オタコン_000]
		//船橋の外にいた兵士……何か気になるな。
		//調べておいた方がいい。船橋左舷の
		//水密扉から航海甲板に出られるはずだ。
	}
	talk オタコン 標準 -m {
		[TO_オルガ戦前:オタコン_001]
		//航海甲板に向かってくれ。
	}
}//v
}//d



proc rto_銃撃戦飛び出し撃ち１:07 {
vox t:vc090201 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_銃撃戦飛び出し撃ち１:オタコン_000]
		//敵も黙って君を船倉に入れる気は
		//ないみたいだ。
	}
	talk スネーク 標準 -m {
		[TO_銃撃戦飛び出し撃ち１:スネーク_001]
		//ああ。ここは戦うしかないようだ。
		//ビハインドからの飛び出し撃ちを
		//使ってみるか……。
	}
	talk オタコン 標準 -m {
		[TO_銃撃戦飛び出し撃ち１:オタコン_002]
		//そうだね。
	}
}//v
}//d

//二回目以降 t //e
proc rto_銃撃戦飛び出し撃ち２:07 {
vox t:vc090211 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_銃撃戦飛び出し撃ち２:オタコン_000]
		//飛び出し撃ちを活用すれば、遮蔽物に
		//隠れながら相手の隙をみて銃撃を加える
		//ことが出来るだろう。
	}
	talk オタコン 標準 -m {
		[TO_銃撃戦飛び出し撃ち２:オタコン_001]
		//やり方は、まず銃を装備してから
		//遮蔽物に張り付いてビハインドカメラに
		//する。
	}
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_銃撃戦飛び出し撃ち２:オタコン_002]
		//その状態から□ボタンを押せば
		//飛び出し撃ちができる。□ボタンを
		//離せば素早く遮蔽物の陰に戻る。
	}
	talk オタコン 標準 -m {
		[TO_銃撃戦飛び出し撃ち２:オタコン_003]
		//敵の弾幕が途切れる瞬間を
		//見極めて攻撃に転じるんだ。
	}
}//v
}//d

proc rto_タクティカルリロード１:07 {
vox t:vc090301 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_タクティカルリロード１:オタコン_000]
		//スネーク、撃ち合っている最中に弾が
		//切れたら大きな隙を相手に見せることに
		//なるんじゃないか？
	}
	talk スネーク 標準 -m {
		[TO_タクティカルリロード１:スネーク_001]
		//ああ。だがタクティカル・リロードを
		//使えばそんなことにはならん。
	}
@rt_つっこまれ＿是＿なんで知ってるんだ系デフォルト 100
	talk オタコン 標準 -m {
		[TO_タクティカルリロード１:オタコン_002]
		//敵の目の前で弾切れを起こす危険を
		//回避するため、弾倉が空になる前に
		//あらかじめ弾倉を交換しておく戦術だね。
	}
	talk スネーク 標準 -m {
		[TO_タクティカルリロード１:スネーク_003]
		//そうだ。
	}
}//v
}//d

//二回目以降 t //e
proc rto_タクティカルリロード２:07 {
vox d:_vc090311 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_タクティカルリロード２:オタコン_000]
		//タクティカル・リロードをするには
		//銃を装備から外してからもう一度
		//装備し直せばいい。
	}
	talk オタコン 標準 -m {
		[TO_タクティカルリロード２:オタコン_001]
		//それで新しい弾倉を装填した状態になる。Ｒ２ボタンを素早く押してクイック
		//チェンジを使うといいだろう。
	}
}//v
}//d

proc rto_グレネード注意:07 {
vox t:vc090401 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_グレネード注意:オタコン_000]
		//スネーク、敵はグレネードも装備して
		//いる。グレネードを投げられたらすぐに		//
		//逃げるんだ。
	}
}//v
}//d

proc rto_全滅させなければ駄目:07 {
vox t:vc090501 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_全滅させなければ駄目:オタコン_000]
		//スネーク、敵も必死みたいだ。
		//そこを突破するには敵を全て倒すしか
		//ないだろう。銃で応戦するんだ。
	}
}//v
}//d

proc rto_プロジェクタ切替:07 {
vox t:vc090601 {
	talk オタコン 標準 -m {
		[TO_プロジェクタ切替:オタコン_000]
		//その船倉にはプロジェクタが二つある。映像は交互に切り替えられている
		//みたいだ。
	}
	talk オタコン 標準 -m {
		[TO_プロジェクタ切替:オタコン_001]
		//海兵隊員達は当然映像の映っているプロジェクタの方に注目している。
	}
	talk オタコン 標準 -m {
		[TO_プロジェクタ切替:オタコン_002]
		//つまりプロジェクタが切り替わったら
		//海兵隊員達の見ている方向もかわるって
		//ことだ。
	}
	talk オタコン 標準 -m {
		[TO_プロジェクタ切替:オタコン_003]
		//気をつけてくれ。
		//見つかったら終わりだよ。
	}
}//v
}//d

proc rto_かねきゃっち:07 {
vox t:vc090701 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_かねきゃっち:オタコン_000]
		//エルードから×ボタンで落下している
		//途中につかめそうな場所があったら
		//△ボタンを押してみるといい。
	}
	talk オタコン 標準 -m {
		[TO_かねきゃっち:オタコン_001]
		//うまくすればつかまることが出来る
		//はずだ。多少方向がずれても大丈夫。
		//いろいろ試してみてくれ。
	}
}//v
}//d

proc rto_かねきっく:07 {
vox t:vc090801 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_かねきっく:オタコン_000]
		//エルードから△ボタンで這い上がる時、
		//反動で近くにいる敵にひざを打ち込む
		//ことが出来る。
	}
	talk オタコン 標準 -m {
		[TO_かねきっく:オタコン_001]
		//手すりのあたりを歩いている敵が
		//いたら狙ってみるといい。
	}
}//v
}//d

proc rto_インケン投げ:07 {
vox t:vc090901 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_インケン投げ:オタコン_000]
		//覗き込みをしている時にグレネードを
		//装備していれば□ボタンで遮蔽物に隠れ
		//ながらグレネードを投げることが出来る。
	}
}//v
}//d

proc rto_ホールドアップアイテム搾取１:07 {
vox t:vc091001 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ホールドアップアイテム搾取１:オタコン_000]
		//敵をホールドアップさせた後、
		//うまくやればアイテムを奪うことが
		//出来るだろう。
	}
}//v
}//d

//ドッグタグホールドアップのみの場合 t //e
proc rto_ホールドアップアイテム搾取２:07 {
vox t:vc091011 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ホールドアップアイテム搾取２:オタコン_000]
		//ホールドアップからしか手に入らない
		//アイテムもあるみたいだ。余裕があれば
		//試してみるといい。
	}
}//v
}//d

proc rto_ドッグタグ取得後:07 {
vox t:vc091021 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ドッグタグ取得後:オタコン_000]
		//サーマル赤外線ゴーグルで敵兵士の
		//首のあたりをよく見てみるといい。
	}
	talk オタコン 標準 -m {
		[TO_ドッグタグ取得後:オタコン_001]
		//ドッグタグを持っているかどうかが
		//わかるはずだ。
	}
}//v
}//d



//信管ヤバイよ！ＸＸＸＸＸＸＸｘｘ
proc rto_グレネード:07 {
vox t:vc091101 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_グレネード:オタコン_000]
		//グレネードを装備してるね。
		//投擲用の対人破片手榴弾だ。
		//爆風と破片で敵を倒すことが出来る。
	}
	talk オタコン 標準 -m {
		[TO_グレネード:オタコン_001]
		//□ボタンを押すと信管を抜いて構え、
		//□ボタンを離すと投げる。□ボタンを
		//押した時の強さで投擲距離が変わるよ。
	}
	talk オタコン 標準 -m {
		[TO_グレネード:オタコン_002]
		//構えてから爆発するまで約５秒ある。
		//爆発するまでの時間と投げる距離が
		//変えられる点をうまく使いこなすんだ。
	}
}//v
}//d


proc rto_赤外線ゴーグル１:07 {
vox t:vc091201 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_赤外線ゴーグル１:オタコン_000]
		//サーマル赤外線ゴーグルを使ってるね。
		//赤外線ゴーグルは物体の熱分布を
		//映像化する暗視装置だ。
	}

@rt_うんちく＿否＿わからん系デフォルト 100
@rt_うんちく＿是＿詳しいな系デフォルト 50
	talk オタコン 標準 -m {
		[TO_赤外線ゴーグル１:オタコン_001]
		//二次元固体撮像素子方式を採用して
		//高解像度、高感度で６０フレームの
		//リアルタイム映像を実現している。
	}
}//v
}//d

//ドッグタグもっている場合
proc rto_赤外線ゴーグル２:07 {
vox t:vc091211 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_赤外線ゴーグル２:オタコン_000]
		//サーマル赤外線ゴーグルで敵兵士の
		//首もとを見てみればドッグタグを
		//もってるかどうかわかるかもしれないな。
	}
}//v
}//d

proc rto_Ｍ４:07 {
vox t:vc091301 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_Ｍ４:オタコン_000]
		//Ｍ４を持ってるね。
		//＃｛米特殊作戦、ＵＳ．ＳＯＯＭ｝＃コマンドで正式採用されてる
		//アサルトカービン銃だ。
	}

	talk オタコン 標準 -m {
		[TO_Ｍ４:オタコン_001]
		//Ｍ１６Ａ２と同じ５．５６ｍｍ弾を使う。
		//装弾数は３０発だ
	}
	talk オタコン 標準 -m {
		[TO_Ｍ４:オタコン_002]
		//フラットトップレシーバーと着脱式
		//キャリングハンドルなど特殊部隊の
		//要求に合わせた仕様になっている。
	}
}//v
}//d

proc rto_生体センサー:07 {
vox t:vc091401 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_生体センサー:オタコン_000]
		//生体センサーを使っているね。
		//人間の鼓動や微弱な生体電磁波を
		//検知して振動に変換するデバイスだ。
	}
	talk オタコン 標準 -m {
		[TO_生体センサー:オタコン_001]
		//敵が接近すると振動して知らせてくれる。
		//振動が強いほど敵が近くにいるって
		//ことだ。
	}
	talk オタコン 標準 -m {
		[TO_生体センサー:オタコン_002]
		//ただ、生体センサーを使ってる間は
		//センサーが発生させる振動しか感じ取れ
		//なくなるってことは覚えておいてくれ。
	}
}//v
}//d

proc rto_機関室エルード:07 {
vox t:vc091501 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_機関室エルード:オタコン_000]
		//スネーク、機関室は立体的な構造に
		//なっている。それを利用すれば敵に
		//追われても逃げられるかもしれない。
	}

	talk オタコン 標準 -m {
		[TO_機関室エルード:オタコン_001]
		//エルードをうまく使うんだ。
	}
}//v
}//d

proc rto_タンカーカメラうんちく１:07 {
vox t:vc091601 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_タンカーカメラうんちく１:オタコン_000]
		//カメラの説明をしておこうか。
	}

	talk オタコン 標準 -m {
		[TO_タンカーカメラうんちく１:オタコン_001]
		//君が持ってるのは新型メタルギアの
		//写真を撮るために作った特別製の
		//デジタルカメラだ。
	}

@rt_うんちく＿否＿わからん系デフォルト 100
@rt_うんちく＿是＿詳しいな系デフォルト 50
	talk オタコン 標準 -m {
		[TO_タンカーカメラうんちく１:オタコン_002]
		//写真を撮るとその画像データはまず
		//カメラ本体に内蔵されたメモリーの中に
		//格納される。
	}

	talk オタコン 標準 -m {
		[TO_タンカーカメラうんちく１:オタコン_003]
		//そこで電子的改竄を防ぐための
		//色々な処理が自動的に行われるように
		//なってるんだ。
	}

@rt_うんちく＿否＿わからん系デフォルト 100
@rt_うんちく＿是＿詳しいな系デフォルト 50
	talk オタコン 標準 -m {
		[TO_タンカーカメラうんちく１:オタコン_004]
		//電子透かしを埋め込んだり特製の暗号を
		//かけたりね。だから万一転送途中で誰か
		//にデータをいじられてもすぐにわかる。
	}

	talk オタコン 標準 -m {
		[TO_タンカーカメラうんちく１:オタコン_005]
		//ただ、カメラの内蔵メモリーの容量には
		//限界があるんだ。
	}

	talk オタコン 標準 -m {
		[TO_タンカーカメラうんちく１:オタコン_006]
		//メモリーがいっぱいになったら、
		//いらない写真に上書きするといい。
	}
}//v
}//d

//場合１ t //e
proc rto_タンカーカメラうんちく２:07 {
vox t:vc091611 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_タンカーカメラうんちく２:オタコン_000]
		//カメラを構えた状態でＬ１ボタン、
		//Ｒ１ボタンを押すと画面下のカーソルを
		//それぞれ左右に動かせる。
	}
}//v
}//d

//場合２ t //e
proc rto_タンカーカメラうんちく３:07 {
vox d:_vc091621 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_タンカーカメラうんちく３:オタコン_000]
		//カメラを構えた状態でＬ１ボタン、
		//Ｒ１ボタンを押すと画面下の写真の
		//プレビューをそれぞれ左右に動かせる。
	}
//BP - modifying source to restore original text and string count from JP/SOL.
#ifndef BP_JP_SUBSTANCE_USE_ENGLISH_VOICE
	talk オタコン 標準 -m {
		[TO_タンカーカメラうんちく４:オタコン_000]
		//いらない写真を選んでそのまま写真を
		//撮れば、新しい写真をそこに上書き
		//出来るっていう仕組みだ。
	}
#endif
}//v
}//d

