		//エルード中に＃｛×、ホフク｝＃ボタンを押すと、
		//真下に飛び降りる。
	}
} //v
}

proc rto_エルード４の２:07 {
vox t:vc013308 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_エルード４の２:オタコン_000]
		//でも高過ぎる所から落ちたら＃｛ＬＩＦＥ、ライフ｝＃が
