proc rto_甲板船内入れ:07 {
vox t:vc007301 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_甲板船内入れ:オタコン_000]
		//スネーク、目標は船橋最上階の操舵室だ。
		//まずは船の中に潜入してくれ。
		//船内に入れる扉を探すんだ。
	}
} //v
}

proc rto_新型メタルギア１の１:07 {
vox t:vc007501 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_新型メタルギア１の１:オタコン_000]
		//情報によると、新型メタルギアは
		//世界中に拡散したメタルギアの亜種に
		//対抗するためのものらしい。
	}
} //v
}

proc rto_新型メタルギア１の２:07 {
@rt_うなづきデフォルト
	vox t:vc007502 {
		talk オタコン 標準 -m {
			[TO_新型メタルギア１の２:オタコン_001]
		//シャドーモセス事件の後、生き残った
		//オセロットがメタルギアの技術情報を
		//世界中にばらまいたよね。
		}
		talk スネーク 標準 -m {
			[TO_新型メタルギア１の２:スネーク_002]
		//それで奴は国が一つ買えるくらいの金を
		//手に入れた。
		}
		talk オタコン 標準 -m {
			[TO_新型メタルギア１の２:オタコン_003]
		//……でも思うんだけど、オセロットの
		//目的って本当に金だけだったのかな？
		}
		talk スネーク 標準 -m {
			[TO_新型メタルギア１の２:スネーク_004]
		//他に何か目論んでいたと……？
		}
		talk オタコン 標準 -m {
			[TO_新型メタルギア１の２:オタコン_005]
		//うん。わからないけど何となく……。
		//金を手に入れるのは何かを始めるには
		//一番手ごろな手段だしね。
		}
		talk スネーク 標準 -m {
			[TO_新型メタルギア１の２:スネーク_006]
		//……。
		}
@rt_うんちく＿否＿わからん系デフォルト 100
@rt_うんちく＿是＿詳しいな系デフォルト 50
		talk オタコン 標準 -m {
			[TO_新型メタルギア１の２:オタコン_007]
		//まあそれはともかく情報を得た各国は
		//「見えない核弾頭」を発射する核搭載
		//二足歩行戦車の開発に着手し始めている。
		}
		talk オタコン 標準 -m {
			[TO_新型メタルギア１の２:オタコン_008]
		//世界中がメタルギアを持つように
		//なったら合衆国の軍事的優位性は
		//一気に崩れてしまう。
		}
@rt_うんちく＿否＿わからん系デフォルト 100
@rt_うんちく＿是＿詳しいな系デフォルト 50
		talk オタコン 標準 -m {
			[TO_新型メタルギア１の２:オタコン_009]
		//メタルギアが標準になった世界で「唯一
		//の超大国」としての優位を保つには、
		//メタルギアを超える兵器を持つしかない。
		}
		talk スネーク 標準 -m {
			[TO_新型メタルギア１の２:スネーク_010]
		//そのための新型メタルギアか。
		}
		talk オタコン 標準 -m {
			[TO_新型メタルギア１の２:オタコン_011]
		//そう。
		//目には目を、ってわけさ。
		}
	} //v
}


proc rto_新型メタルギア２の１:07 {
vox t:vc007601 {	//％切り分けなおし○
@rt_うんちく＿否＿わからん系デフォルト 100
@rt_うんちく＿是＿詳しいな系デフォルト 50
	talk オタコン 標準 -m {
		[TO_新型メタルギア２の１:オタコン_000]
		//その偽装タンカーに積まれた
		//新型メタルギアは海兵隊の主導で
		//開発が進められている。
	}
	talk オタコン 標準 -m {
		[TO_新型メタルギア２の１:オタコン_001]
		//だけど……別のメタルギアが海軍で
		//作られてるって噂もあるんだ。
	}
} //v
}

proc rto_新型メタルギア２の２:07 {
@rt_うんちく＿否＿わからん系デフォルト 100
@rt_うんちく＿是＿詳しいな系デフォルト 50
	vox t:vc007602 {	//％きり分け直し○
		talk スネーク 標準 -m {
			[TO_新型メタルギア２の２:スネーク_000]
		//そっちの方の情報は？
		}
		talk オタコン 標準 -m {
			[TO_新型メタルギア２の２:オタコン_001]
		//いや、それが全然。ガードが固くて。
		}
		talk オタコン 標準 -m {
			[TO_新型メタルギア２の２:オタコン_002]
		//巨額の金が動いてることは確かなんだよ。だけど、全ての調査はある名前に
		//ぶつかって止まってしまうんだ。
		}
@rt_謎＿是＿らりるれろ系デフォルト 100
		talk オタコン 標準 -m {
			[TO_新型メタルギア２の２:オタコン_003]
		//『＃｛愛国者達、パトリオッツ｝＃』っていうね。
		}
		talk スネーク 標準 -m {
			[TO_新型メタルギア２の２:スネーク_004]
		//何者だ？
		}
		talk オタコン 標準 -m {
			[TO_新型メタルギア２の２:オタコン_005]
		//それが全くわからないんだ。
		//個人なのか、団体なのかさえ……。
		}
@rt_うなづきデフォルト
		talk オタコン 標準 -m {
			[TO_新型メタルギア２の２:オタコン_006]
		//でも、海兵隊の新型メタルギアの存在を
		//世間にぶちまければ、そっちにも
		//揺さ振りをかけることが出来ると思う。
		}
		talk オタコン 標準 -m {
			[TO_新型メタルギア２の２:オタコン_007]
		//今回の作戦にはそういう意味もあるんだ。
		}
	} //v
}

proc rto_船内に戻れ:07 {
vox t:vc007701 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
