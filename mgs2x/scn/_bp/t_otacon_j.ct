//第三船倉にいる場合 t //e
proc rto_タンカーカメラうんちく５:07 {
vox t:vc091631 {
	talk オタコン 標準 -m {
		[TO_タンカーカメラうんちく５:オタコン_000]
		//写真を撮り終えたらこっちに
		//転送してくれ。
	}
	talk オタコン 標準 -m {
		[TO_タンカーカメラうんちく５:オタコン_001]
		//写真を転送する方法はそのエリアの
		//南東にあるＷＳの前で＃｛△、アクション｝＃ボタンを
		//押すだけだ。いい写真を頼むよ。
	}
}//v
}//d

proc rto_長廊下北＿開かない扉:07 {
vox t:vc092001 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_長廊下北＿開かない扉:オタコン_000]
		//そこの扉は開かないみたいだ。
		//東の方に進んでくれ。
	}
