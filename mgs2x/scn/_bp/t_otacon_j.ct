//XBOXとPSX2で切り替えるべき音声コード
#include "vcvx.h"

/*---------------------------------------------
場所ごとの説明とは？
----------------------------------------------*/
//むびＸＸＸＸＸＸＸＸＸ
proc rto_甲板水密扉:07 {
vox t:vc000101 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_甲板水密扉:オタコン_000]
		//スネーク、そこの扉を開けて
		//船内に入ってくれ。
	}
	talk オタコン 標準 -m {
		[TO_甲板水密扉:オタコン_001]
		//その水密扉を開けるには、扉の前で
		//＃｛△、アクション｝＃ボタンを押してそのままドアが
		//開くまで押しっぱなしにすればいい。
	}
	talk オタコン 標準 -m {
		[TO_甲板水密扉:オタコン_002]
		//ハンドルを回している間、
		//＃｛△、アクション｝＃ボタンを連打すれば早く開けられる。
		//途中で手を放してしまわないようにね。
	}
} //v
}

proc rto_甲板開かない水密扉:07 {
vox t:vc000201 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_甲板開かない水密扉:オタコン_000]
		//スネーク、そこの扉は甲板側からは
		//開かないみたいだよ。他にも扉がある
		//から、そっちから船内に入ってくれ。
	}
} //v
}

proc rto_救命艇近く１:07 {
vox t:vc000301 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_救命艇近く１:オタコン_000]
		//救命艇があるね。
		//全閉囲型の空気自給式耐火救命艇だ。
	}
} //v
}

proc rto_救命艇近く２:07 {
vox t:vc000302 {
@rt_うんちく＿否＿わからん系デフォルト 100
@rt_うんちく＿是＿詳しいな系デフォルト 50
	talk オタコン 標準 -m {
		[TO_救命艇近く２:オタコン_000]
		//散水冷却装置と自蔵式空気維持装置を
		//装備しているから全ての入口を密閉して
		//も乗員と機関に充分な空気を供給出来る。
	}
	talk オタコン 標準 -m {
		[TO_救命艇近く２:オタコン_001]
		//転覆しても自動的に復帰できるし、
		//海上で炎に包まれても大丈夫なように
		//出来てるんだ。
	}
} //v
}

proc rto_救命艇近く３:07 {
vox t:vc000303 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_救命艇近く３:オタコン_000]
		//でもその救命艇は使えない。
		//速度も出ないし、第一、目立ち過ぎる
		//からね。
	}
} //v
}



proc rto_死体捨てられる場所近く１:07 {
vox t:vc000401 { //％分離○
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_死体捨てられる場所近く１:オタコン_000]
		//そこの手すりは開くみたいだよ。
		//倒した敵をそこまで引きずっていけば、
		//船の外に放り出せるはずだ。
	}
} //v
}

proc rto_死体捨てられる場所近く２:07 {
vox t:vc000402 { //％分離○
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_死体捨てられる場所近く２:オタコン_000]
		//倒した敵をそのままにしておくのは
		//マズイ。仲間が倒れてるのを見つけたら
		//敵は当然警戒するからね。
	}
} //v
}


proc rto_嘔吐直後:07 {
vox t:vc000501 {
@rt_つっこまれ＿是＿なんで知ってるんだ系デフォルト 100
@rt_うなづきデフォルト＿否
	talk スネーク 標準 -m {
		[TO_嘔吐直後:スネーク_000]
		//うぅぅうむ……。
	}
	talk オタコン 標準 -m {
		[TO_嘔吐直後:オタコン_001]
		//なんだいスネーク、船酔いかい？
	}
	talk スネーク 標準 -m {
		[TO_嘔吐直後:スネーク_002]
		//いや、そんなことは、ぶごふぁはへぇへぶぉ……。
	}
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_嘔吐直後:オタコン_003]
		//やれやれ。船内に入ればおさまるよ。
		//ジアゼパムを使ってもいいかもしれない。
	}
	talk スネーク 標準 -m {
		[TO_嘔吐直後:スネーク_004]
		//ジアゼパムに船酔いを止める
		//作用なんかあるのか？
		//ナオミはそんなことは……。
	}
	talk オタコン 標準 -m {
		[TO_嘔吐直後:オタコン_005]
		//まあ、騙されたと思って使ってみなよ。
	}
} //v
}

proc rto_ジアゼパム使用後船が揺れない状態:07 {
vox t:vc000601 {
@rt_うなづきデフォルト
	talk スネーク 標準 -m {
		[TO_ジアゼパム使用後船が揺れない状態:スネーク_000]
		//オタコン、お前の言う通りジアゼパムを
		//飲んだら船揺れが止まったぞ。
	}
	talk オタコン 標準 -m {
		[TO_ジアゼパム使用後船が揺れない状態:オタコン_001]
		//え！？ホントに！？
	}
	talk スネーク 標準 -m {
		[TO_ジアゼパム使用後船が揺れない状態:スネーク_002]
		//ホントにってお前……。
	}
@rt_騙された＿否＿騙したな系デフォルト 100
@rt_うなづきデフォルト＿是
	talk オタコン 標準 -m {
		[TO_ジアゼパム使用後船が揺れない状態:オタコン_003]
		//まぁ、効くと思って使えば効く。
		//薬なんてそんなもんさ。
		//しかし君って以外と単純なんだね。
	}
	talk スネーク 標準 -m {
		[TO_ジアゼパム使用後船が揺れない状態:スネーク_004]
		//……。
	}
} //v
}

proc rto_甲板二階の敵は主観攻撃:07 {
vox t:vc000701 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_甲板二階の敵は主観攻撃:オタコン_000]
		//スネーク、船橋の上の階を主観で見るんだ。敵兵が見回ってる。見つかる前に
		//主観攻撃で倒したほうが良い。
	}
} //v
}

proc rto_ロッカー近く１:07 {
vox t:vc000801 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ロッカー近く１:オタコン_000]
		//ロッカーがあるね。
		//敵に見つかりそうになったら
		//ロッカーの中に隠れるのもいいだろう。
	}
} //v
}

proc rto_ロッカー近く２外:07 {
//むびＸＸＸＸＸＸＸＸＸ
vox t:vc000802 {	//％分離○
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ロッカー近く２外:オタコン_000]
		//ロッカーは近くで＃｛△、アクション｝＃ボタンを押せば
		//開けられる。扉を開けて中に入れば
		//隠れることが出来るよ。
	}
} //v
}

proc rto_ロッカー近く２中:07 {
//むびＸＸＸＸＸＸＸＸＸ
vox t:vc000803 {	//％分離○
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ロッカー近く２中:オタコン_000]
		//中に入ってもスリットから外が見える。
		//外に出る時は、まわりを主観でよく
		//確かめるんだ。
	}
	talk オタコン 標準 -m {
		[TO_ロッカー近く２中:オタコン_001]
		//ロッカーから出るには、
		//もう一度＃｛△、アクション｝＃ボタンを押せばいい。
	}
} //v
}

proc rto_ロッカー近く３:07 {
//むびＸＸＸＸＸＸＸＸＸ
vox t:vc000804 {	//％分離○
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ロッカー近く３:オタコン_000]
		//ロッカーの中に倒した敵を隠すことも
		//出来る。やり方はロッカーを開けて
		//敵をそこまで引きずっていけばいい。
	}
} //v
}

proc rto_ロッカードア盾:07 {
vox t:vc000901 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ロッカードア盾:オタコン_000]
		//ロッカーを開ければ、そのドアを
		//盾にして敵の銃撃を防ぐことも出来る。
	}
	talk オタコン 標準 -m {
		[TO_ロッカードア盾:オタコン_001]
		//でも所詮ロッカーだから銃弾を防ぐにも
		//限度が有る。当てにし過ぎちゃダメだ。
		//いいね。
	}
} //v
}


proc rto_ロッカーの中:07 {
vox t:vc001001 {
@rt_うなづきデフォルト
	talk スネーク 標準 -m {
		[TO_ロッカーの中:スネーク_000]
		//初めて会った時のこと思い出すな。
	}
	talk オタコン 標準 -m {
		[TO_ロッカーの中:オタコン_001]
		//あの時、ロッカーに入ってたのは
		//僕の方だったね……。
	}
	talk スネーク 標準 -m {
		[TO_ロッカーの中:スネーク_002]
		//まぁ、俺はパンツを濡らしたりは
		//してないがな。
	}
	talk オタコン 標準 -m {
		[TO_ロッカーの中:オタコン_003]
		//言わないでくれよ、そのことは！
	}
} //v
}

proc rto_蒸気パイプ近く:07 {
//むびＸＸＸＸＸＸＸＸＸ
vox t:vc001101 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_蒸気パイプ近く:オタコン_000]
		//スネーク、壁や天井にあるパイプは
		//中に蒸気が流れてるんだ。薄いから銃で
		//撃ったら穴が開いて蒸気が吹き出す。
	}
	talk オタコン 標準 -m {
		[TO_蒸気パイプ近く:オタコン_001]
		//蒸気は熱いから触らないように
		//気をつけてくれ。でも、うまくやれば
		//トラップに使えるかもしれないね。
	}
} //v
}

proc rto_足跡説明:07 {
vox t:vc001201 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_足跡:オタコン_000]
		//スネーク、そこの床を見てくれ。
		//吹き込んだ雨で濡れてるから、そのまま
		//歩いたら足跡がついてしまう。
	}
	talk オタコン 標準 -m {
		[TO_足跡:オタコン_001]
		//足跡が敵に見つかると追跡されたりして
		//厄介なことになる。足跡をつけないよう
		//にするにはホフクすればいい。
	}
} //v
}


proc rto_前かがみ:07 {
vox t:vc001301 {
@rt_つっこまれ＿是＿なんで知ってるんだ系デフォルト 100
@rt_つっこまれ＿否＿お前が言うな系デフォルト 100
	talk オタコン 標準 -m {
		[TO_前かがみ:オタコン_000]
		//何してるんだい、スネーク……。
		//相変わらず元気だね、君は。
		//任務のことも忘れないようにしてくれよ。
	}
} //v
}

proc rto_居住区一階南開かない扉:07 {
vox t:vc001401 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_居住区一階南開かない扉:オタコン_000]
		//スネーク、その扉は壊れてるみたいだ。
		//他へ回ってくれ。
	}
} //v
}

proc rto_エンジンルームへの階段近く:07 {
vox t:vc001501 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_エンジンルームへの階段近く:オタコン_000]
		//スネーク、その先は船倉だけど、
		//今は船橋最上部の操舵室に行く方が
		//先決だ。まず上へ向かってくれ。
	}
} //v
}

//体験版用
proc rto_エンジンルームへの階段近く体験版:07 {
vox t:vc001601 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_エンジンルームへの階段近く体験版:オタコン_000]
		//スネーク、そこの扉は開きそうもない。
		//目的は船橋最上階の操舵室だ。
		//上に向かってくれ。
	}
} //v
}

proc rto_テレビ１:07 {
vox t:vc001701 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_テレビ１:オタコン_000]
		//そこのＴＶを見て。
		//船倉の様子が映ってる。
	}
} //v
}

proc rto_テレビ２:07 {
vox t:vc001702 {
@rt_うなづきデフォルト
	talk スネーク 標準 -m {
		[TO_テレビ２:スネーク_000]
		//ではこれが……。
	}
	talk オタコン 標準 -m {
		[TO_テレビ２:オタコン_001]
		//新型メタルギアだ。
	}
	talk スネーク 標準 -m {
		[TO_テレビ２:スネーク_002]
		//なぜ中継を？
	}
} //v
}

proc rto_テレビ中継:07 {
vox t:vc001801 {
@rt_つっこまれ＿是＿なんで知ってるんだ系デフォルト 100
@rt_うなづきデフォルト＿否
	talk オタコン 標準 -m {
		[TO_テレビ中継:オタコン_000]
		//演習の記録と……
		//プレゼン、ってところかな？
	}
	talk スネーク 標準 -m {
		[TO_テレビ中継:スネーク_001]
		//プレゼン？
	}
	talk オタコン 標準 -m {
		[TO_テレビ中継:オタコン_002]
		//さっきからその船は軍事データリンクを
		//通して映像を発信してるんだ。
	}
	talk スネーク 標準 -m {
		[TO_テレビ中継:スネーク_003]
		//この「映画」を見てほくそ笑んでる
		//奴等がどこかにいるということか。
	}
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_テレビ中継:オタコン_004]
		//配信先を突き止めようとしてるんだけど、防壁が何重にも張ってあって上手く
		//いかない。もうちょっとやってみるけど。
	}
	talk スネーク 標準 -m {
		[TO_テレビ中継:スネーク_005]
		//どこであれ、きっとエアコンの効いた
		//小奇麗な部屋に違いない。
	}
	talk オタコン 標準 -m {
		[TO_テレビ中継:オタコン_006]
		//その船とは大違いのね。
		//これも戦場の情報革命という奴さ。
	}
} //v
}


proc rto_テレビ２回目:07 {
vox t:vc001901 {
@rt_つっこまれ＿是＿なんで知ってるんだ系デフォルト 100
@rt_うなづきデフォルト＿否
	talk オタコン 標準 -m {
		[TO_テレビ２回目:オタコン_000]
		//スネーク、いつまでテレビを
		//見てるんだい？作戦に戻ってくれ。
	}
} //v
}

proc rto_リフレッシュルーム１:07 {
vox t:vc002001 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_リフレッシュルーム１:オタコン_000]
		//そこはリフレッシュ・ルームみたいだね。
		//本来、タンカーの乗組員が休み時間を
		//くつろぐ場所だ。
	}
} //v
}

proc rto_リフレッシュルーム２:07 {
vox t:vc002002 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_リフレッシュルーム２:オタコン_000]
		//そのへん、いろんな物がおいてあるけど、
		//散らかさないように気をつけた方が
		//いい。
	}
	talk オタコン 標準 -m {
		[TO_リフレッシュルーム２:オタコン_001]
		//敵に異状を悟られたらマズイ。
		//痕跡を残さないのが潜入の基本だろ？
	}
} //v
}

proc rto_二階通路くぼみ:07 {
vox t:vc002101 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_二階通路くぼみ:オタコン_000]
		//細い廊下だね。でも廊下の脇に＃Ｔ｛くぼみ｝＃が
		//ある。敵と鉢合わせしたら、そこに
		//逃げ込めばやり過ごせるんじゃないかな。
	}
} //v
}

proc rto_２Ｆ水密扉近くオルガ戦前:07 {
vox t:vc002201 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_２Ｆ水密扉近くオルガ戦前:オタコン_000]
		//スネーク、その扉の外は甲板だ。
	}
	talk オタコン 標準 -m {
		[TO_２Ｆ水密扉近くオルガ戦前:オタコン_001]
		//目的はあくまでも操舵室に行って
		//その偽装タンカーの行き先を
		//調べることだ。上に向かってくれ。
	}
} //v
}

//製品版のみみん。ほーちみん。
proc rto_２Ｆ水密扉近くオルガ戦後:07 {
vox t:vc002301 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_２Ｆ水密扉近くオルガ戦後:オタコン_000]
		//次は船倉に行って新型メタルギアの
		//写真を撮ってくれ。下に向かうんだ。
	}
} //v
}



proc rto_監視カメラ１:07 {
vox t:vc002401 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_監視カメラ１:オタコン_000]
		//スネーク、監視カメラが設置されてる。
		//監視カメラの視界に入ったら警報を
		//鳴らされてしまう。見つかっちゃダメだ。
	}
} //v
}

proc rto_監視カメラ２:07 {
//むびＸＸＸＸＸＸＸＸＸ
vox t:vc002402 {	//％元にもどしてもらうのだ。
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_監視カメラ２:オタコン_000]
		//監視カメラが別の方向を向いてるうちに
		//走り抜けてくれ。あとカメラの真下は
		//死角になってる。それも利用するんだ。
	}
} //v
}

proc rto_監視カメラ３:07 {
//むびＸＸＸＸＸＸＸＸＸは没
vox t:vc002403 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_監視カメラ３:オタコン_000]
		//チャフ・グレネードを使って電子妨害を
		//仕掛けるのもいいね。そうすれば
		//しばらく監視カメラを無効に出来る。
	}
} //v
}

//動かない監視カメラ用新規
proc rto_監視カメラ４:07 {
vox t:vc002404 {	//％新規○
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_監視カメラ４:オタコン_000]
	}
} //v
}


proc rto_食堂１:07 {
vox t:vc002501 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_食堂１:オタコン_000]
		//そこは食堂だね。
	}
} //v
}

proc rto_食堂２:07 {
vox t:vc002502 {
@rt_うなづきデフォルト
	talk スネーク 標準 -m {
		[TO_食堂２:スネーク_000]
		//船の大きさに比べると小さいな……。
	}
	talk オタコン 標準 -m {
		[TO_食堂２:オタコン_001]
		//今のタンカーは自動化が進んでるから
		//乗組員は２０人くらいなんだ。
	}
	talk オタコン 標準 -m {
		[TO_食堂２:オタコン_002]
		//だから食堂もそれくらいの大きさで
		//充分なのさ。
	}
} //v
}

proc rto_食堂３:07 {
vox t:vc002503 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_食堂３:オタコン_000]
		//色々なものがあるけど
		//散らかさない方が良い。
		//痕跡を残すと敵に気づかれるからね。
	}
} //v
}

proc rto_倉庫:07 {
vox t:vc002601 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_倉庫:オタコン_000]
		//スネーク、そこは倉庫だ。
		//料理の材料とかを置いておく
		//ところだね。
	}
	talk オタコン 標準 -m {
		[TO_倉庫:オタコン_001]
		//ダンボールが一杯積んである……。
		//まわりにとけ込めれば上手く敵の目を
		//誤魔化せるんじゃないかな？
	}
} //v
}

proc rto_食堂死体:07 {
vox t:vc002701 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_食堂死体:オタコン_000]
		//その人、食事をとろうとしてたのかもね。
	}
	talk スネーク 標準 -m {
		[TO_食堂死体:スネーク_001]
		//飯のかわりに食らったのは鉛弾、
		//というわけか……。
	}
} //v
}

proc rto_自動操縦:07 {
vox t:vc002801 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_自動操縦:オタコン_000]
		//そこが操舵室だ。
		//と、言っても舵を取るだけの
		//部屋じゃない。
	}
	talk オタコン 標準 -m {
		[TO_自動操縦:オタコン_001]
		//現代のタンカーでは運航操船機能だけじゃ
		//なく機関制御とか無線とかの主要機能も
		//そこに集約されてるんだ。
	}
	talk オタコン 標準 -m {
		[TO_自動操縦:オタコン_002]
		//舵は航海衛星方式を用いた自動操縦に
		//なってる。精密機器だから下手に
		//触らない方がいいね。
	}
} //v
}

/*
// added by S.Hirano 01/03/02
proc rto_舵:07 {
vox t:<KONAMI> {
	talk オタコン 標準 -m {
		[TO_舵:オタコン_000]
	}
} //v
}
*/

// added by S.Hirano 01/03/02
proc rto_オルガ死体:07 {
vox t:vc002901 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_オルガ死体:オタコン_000]
		//……その人、死んじゃいないよね。
	}
	talk スネーク 標準 -m {
		[TO_オルガ死体:スネーク_001]
		//ああ。麻酔で眠っているだけだ。
	}
	talk オタコン 標準 -m {
		[TO_オルガ死体:オタコン_002]
		//そうか。
	}
@rt_つっこまれ＿是＿なんで知ってるんだ系デフォルト 100
@rt_うなづきデフォルト＿否
	talk スネーク 標準 -m {
		[TO_オルガ死体:スネーク_003]
		//寝顔はかわいいものだな。
	}
	talk オタコン 標準 -m {
		[TO_オルガ死体:オタコン_004]
		//……何か変なこと考えてない？
	}
	talk スネーク 標準 -m {
		[TO_オルガ死体:スネーク_005]
		//いや。
	}
@rt_エロエロ＿是＿たまららん系デフォルト 100
@rt_キテレツさん＿否＿なんだこいつ系デフォルト 100
	talk オタコン 標準 -m {
		[TO_オルガ死体:オタコン_006]
		//確かに眠り姫は王子様のキスで目覚める
		//ものだけど、彼女にはこのまま眠って
		//おいてもらった方が良さそうだね。
	}
	talk スネーク 標準 -m {
		[TO_オルガ死体:スネーク_007]
		//そうだな。戦場でジャジャ馬の相手を
		//するのはもうごめんだ。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_オルガ死体撃った:07 {
vox t:vc003001 {
@rt_つっこまれ＿是＿なんで知ってるんだ系デフォルト 100
@rt_つっこまれ＿否＿お前が言うな系デフォルト 100
	talk オタコン 標準 -m {
		[TO_オルガ死体撃った:オタコン_000]
		//何てことするんだ！
		//倒れてる人を撃つなんて！
		//この人でなし！！
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_マスト最上部:07 {
vox t:vc003101 {
@rt_つっこまれ＿是＿なんで知ってるんだ系デフォルト 100
@rt_無茶指令＿否＿お前がやれ系デフォルト 100
	talk オタコン 標準 -m {
		[TO_マスト最上部:オタコン_000]
		//スネーク、君が高い所が好きなのは
		//分かったから、気が済んだらさっさと
		//下りて船倉に向かってくれ。
	}
	talk オタコン 標準 -m {
		[TO_マスト最上部:オタコン_001]
		//目的は船倉に行ってメタルギアの写真を
		//撮ることだ。忘れないでくれよ。
	}
} //v
}


proc rto_赤外線強制ＣＡＬＬ最初:07 {
vox t:vc003201 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_赤外線強制ＣＡＬＬ最初:オタコン_000]
		//スネーク、待って！
		//そのまま進んじゃいけない！
	}
} //v
}


proc rto_赤外線強制ＣＡＬＬ通り抜け:07 {
vox t:vc003202 {
@rt_うなづきデフォルト
	talk スネーク 標準 -m {
		[TO_赤外線強制ＣＡＬＬ通り抜け:スネーク_000]
		//なに？
	}
	talk オタコン 標準 -m {
		[TO_赤外線強制ＣＡＬＬ通り抜け:オタコン_001]
		//その通路の両側を見るんだ。
	}
	talk スネーク 標準 -m {
		[TO_赤外線強制ＣＡＬＬ通り抜け:スネーク_002]
		//装置が設置されてる……。
		//赤外線センサーか！？
	}
} //v
}

proc rto_赤外線強制ＣＡＬＬ立ち止まり:07 {
vox t:vc003203 {
@rt_うなづきデフォルト
	talk スネーク 標準 -m {
		[TO_赤外線強制ＣＡＬＬ立ち止まり:スネーク_000]
		//ああ。この通路の両側の機械……。
		//赤外線センサーか？
	}
} //v
}


proc rto_赤外線強制ＣＡＬＬ２:07 {
vox t:vc003204 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_赤外線強制ＣＡＬＬ２:オタコン_000]
		//ああ。そしてそのセンサーに
		//つながってるのは……。
	}
	talk スネーク 標準 -m {
		[TO_赤外線強制ＣＡＬＬ２:スネーク_001]
		//セムテックス……。
	}
	talk オタコン 標準 -m {
		[TO_赤外線強制ＣＡＬＬ２:オタコン_002]
		//そう、プラスティック爆弾だ。
	}
} //v
}

proc rto_赤外線強制ＣＡＬＬデモ見てた:07 {
vox t:vc003205 {
@rt_うなづきデフォルト
	talk スネーク 標準 -m {
		[TO_赤外線強制ＣＡＬＬデモ見てた:スネーク_000]
		//奴等が仕掛けたと言っていたのは、
		//これのことか……。
	}
	talk オタコン 標準 -m {
		[TO_赤外線強制ＣＡＬＬデモ見てた:オタコン_001]
		//みたいだね。
	}
} //v
}

proc rto_赤外線強制ＣＡＬＬ３:07 {
vox t:vc003206 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_赤外線強制ＣＡＬＬ３:オタコン_000]
		//もしセンサーにひっかかったら……。
	}
	talk スネーク 標準 -m {
		[TO_赤外線強制ＣＡＬＬ３:スネーク_001]
		//この船ごと海の藻くずだな。
	}
	talk オタコン 標準 -m {
		[TO_赤外線強制ＣＡＬＬ３:オタコン_002]
		//その通り。
	}
} //v
}

proc rto_赤外線センサー見てる:07 {
vox t:vc003301 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_赤外線強制ＣＡＬＬ機関室既に赤外線を見ている場合:オタコン_000]
		//スネーク、そこにも赤外線センサーが
		//セットされてるよ！赤外線に触れたら
		//爆弾が爆発してその船は沈んでしまう。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_赤外線機関室通れない:07 {
vox t:vc003401 {
@rt_うなづきデフォルト
	talk スネーク 標準 -m {
		[TO_赤外線機関室通れない:スネーク_000]
		//海水浴を楽しむ気はないが……。
		//センサーの数が多すぎるな。赤外線に
		//触れずに通り抜けるのは無理のようだ。
	}
	talk オタコン 標準 -m {
		[TO_赤外線機関室通れない:オタコン_001]
		//大丈夫。方法はある。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_赤外線制御装置破壊方法:07 {
//vox t:vc003507 ＸＸＸＸＸＸＸＸｘむび
movie t:vc003507 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_赤外線制御装置破壊方法:オタコン_000]
		//よく見てくれ。爆弾のすぐ近くに
		//緑色に点滅するランプのついた
		//装置があるだろ？
	}
	talk オタコン 標準 -m {
		[TO_赤外線制御装置破壊方法:オタコン_001]
		//それがセンサーの制御装置だ。
	}
//BP - modifying source to restore original text and string count from JP/SOL.
#ifdef BP_JP_SUBSTANCE_USE_ENGLISH_VOICE
	talk オタコン 標準 -m {
		[TO_赤外線制御装置破壊方法:オタコン_001_1]
		//それを壊せば赤外線センサーは
		//機能を停止する。
	}
#endif
	talk オタコン 標準 -m {
		[TO_赤外線制御装置破壊方法:オタコン_002]
		//近づくことは出来ないから、
		//銃で制御装置を撃って破壊するんだ。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_赤外線ＵＳＰ持ってない:07 {
vox t:vc003601 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_赤外線ＵＳＰ持ってない:オタコン_000]
		//でも、君の持ってるＭ９の麻酔弾じゃ
		//壊せないと思う。どこかで銃を探すんだ。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_赤外線ＵＳＰ持ってる:07 {
vox t:vc003701 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_赤外線ＵＳＰ持ってる:オタコン_000]
		//Ｍ９の麻酔弾じゃ壊せないだろう。
		//でもさっき手に入れたＵＳＰなら
		//大丈夫だ。ＵＳＰを使うんだ。
	}
} //v
}


proc rto_赤外線爆弾撃つな１:07 {
vox t:vc003801 {	//％分離○
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_赤外線爆弾撃つな１:オタコン_000]
		//オレンジ色に点滅するランプが
		//ついてるのが爆弾だ。
		//爆弾は絶対撃ってはいけない。
	}

	talk オタコン 標準 -m {
		[TO_赤外線爆弾撃つな１:オタコン_001]
		//爆弾に衝撃が加わると起爆装置が作動
		//して爆発する仕組みになってるみたい
		//だからね。
	}
} //v
}


proc rto_赤外線爆弾撃つな２:07 {
vox t:vc003802 {	//％分離○
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_赤外線爆弾撃つな２:オタコン_000]
		//緑色のランプがついた制御装置だけを
		//撃つんだ。いいね。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_赤外線制御装置探せ:07 {
vox t:vc003901 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_赤外線制御装置探せ:オタコン_000]
		//制御装置はいくつか置いてあるようだ。
		//全て壊さないと通り抜けることは
		//出来ないだろう。
	}
	talk オタコン 標準 -m {
		[TO_赤外線制御装置探せ:オタコン_001]
		//制御装置を破壊すれば赤外線は消える。
		//赤外線が残っているということは破壊
		//されていない制御装置があるってことだ。
	}
	talk オタコン 標準 -m {
		[TO_赤外線制御装置探せ:オタコン_002]
		//制御装置を全部破壊するんだ。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_赤外線主観で狙え:07 {
vox t:vc004001 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_赤外線主観で狙え:オタコン_000]
		//主観攻撃でよく狙って、
		//制御装置だけを壊してくれ。
	}
	talk オタコン 標準 -m {
		[TO_赤外線主観で狙え:オタコン_001]
		//死角にある制御装置も物の上に乗ったり、
		//ホフクしたり伸び上がったりすれば
		//撃てるはずだ。
	}
} //v
}


proc rto_赤外線くぐり抜ける版:07 {
vox t:vc004101 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_赤外線くぐり抜ける版:オタコン_000]
		//赤外線の本数はそんなに多くないね。
		//それくらいなら赤外線に触れないように
		//抜けられるんじゃないか？
	}
} //v
}

proc rto_赤外線見方タバコ:07 {
vox t:vc004201 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_赤外線見方タバコ:オタコン_000]
		//どこに赤外線が走ってるかを見るには
		//いつもの方法を使えば良い。
	}
} //v
}

proc rto_赤外線見方消火器:07 {
vox t:vc004202 {
@rt_うなづきデフォルト
	//消火器
	talk オタコン 標準 -m {
		[TO_赤外線見方消火器:オタコン_000]
		//脇に消火器が置いてあるね。
		//それを壊して消火剤をまいて
		//みるのも良いかもしれない。
	}
} //v
}

// added by S.Hirano 01/03/02
proc rto_赤外線見方粉袋:07 {
vox t:vc004203 {
@rt_うなづきデフォルト
	//粉袋
	talk オタコン 標準 -m {
		[TO_赤外線見方粉袋:オタコン_000]
		//消火剤の袋がおいてあるね。
		//それを撃って消火剤をまき散らして
		//みるのも良いかもしれない。
	}
}
}

proc rto_赤外線さわるな:07 {
vox t:vc004301 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_赤外線さわるな:オタコン_000]
		//センサーに引っかかったら爆弾が爆発
		//する。絶対に赤外線に触れちゃダメだ。
		//いいね。
	}
} //v
}

// added by S.Hirano 01/03/02
proc rto_赤外線制御装置撃て:07 {
vox t:vc004401 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_赤外線制御装置撃て:オタコン_000]
		//赤外線センサーの制御装置だけを
		//銃で撃って破壊するんだ。
		//主観攻撃でよく狙ってくれ。
	}
	talk オタコン 標準 -m {
		[TO_赤外線制御装置撃て:オタコン_001]
		//制御装置は緑色のランプがついた
		//機械だよ。
	}
} //v
}

proc rto_赤外線セムテックス:07 {
vox t:vc004501 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_赤外線セムテックス:オタコン_000]
		//そのプラスティック爆弾は
		//セムテックスだ。
	}
	talk オタコン 標準 -m {
		[TO_赤外線セムテックス:オタコン_001]
		//旧チェコスロバキアで開発された
		//プラスティック爆弾で、Ｃ４と同じく
		//扱いやすいが、強力な爆発力を持ってる。
	}
@rt_うんちく＿是＿詳しいな系デフォルト 50
	talk オタコン 標準 -m {
		[TO_赤外線セムテックス:オタコン_002]
		//組成はＲＤＸとＰＥＴＮ。
		//爆速は毎秒８０００ｍを超え、
		//燃焼温度は華氏３０００度以上になる。
	}
	talk オタコン 標準 -m {
		[TO_赤外線セムテックス:オタコン_003]
		//１９８８年スコットランド上空で
		//起こったパンナム１０３便の爆破テロに
		//使われたとも言われてるね。
	}
	talk スネーク 標準 -m {
		[TO_赤外線セムテックス:スネーク_004]
		//これだけのセムテックスが
		//一度に爆発したら、この船くらい
		//ひとたまりもないな。
	}
	talk オタコン 標準 -m {
		[TO_赤外線セムテックス:オタコン_005]
		//絶対に爆発させないようにね。
		//センサーに触れても、セムテックスに
		//衝撃を与えてもダメだ。
	}
	talk スネーク 標準 -m {
		[TO_赤外線セムテックス:スネーク_006]
		//奴等はメタルギアを奪って、
		//この船を沈めるつもりなのか……？
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_エンジンルーム聴力低い:07 {
vox t:vc004601 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_エンジンルーム聴力低い:オタコン_000]
		//そこは機関室だ。真ん中にあるのが
		//その船のエンジンだよ。
	}
	talk オタコン 標準 -m {
		[TO_エンジンルーム聴力低い:オタコン_001]
		//エンジンの音が随分うるさいけど、
		//その分、敵も物音が聞こえにくいはずだ。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_エンジンルームエンジン:07 {
vox t:vc004701 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_エンジンルームエンジン:オタコン_000]
		//機関が船尾にあるのは、船体中央部の
		//空間を油タンクに出来るからだ。
		//プロペラ軸も短くて済むしね。
	}
	talk オタコン 標準 -m {
		[TO_エンジンルームエンジン:オタコン_001]
		//構造がシンプルになるから、その分
		//船体の強度を高められるということさ。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_レイブン影正体前:07 {
vox t:vc004801 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_レイブン影正体前:オタコン_000]
		//スネーク、あの影は……？
	}
	talk スネーク 標準 -m {
		[TO_レイブン影正体前:スネーク_001]
		//奴だ。間違いない。
	}
	talk オタコン 標準 -m {
		[TO_レイブン影正体前:オタコン_002]
		//だけどレイブンはシャドーモセスで
		//君が……。
	}
	talk スネーク 標準 -m {
		[TO_レイブン影正体前:スネーク_003]
		//ああ。シャーマンのマジックか。
		//それとも奴の神が奇跡でも
		//起こしたか……？
	}
	talk オタコン 標準 -m {
		[TO_レイブン影正体前:オタコン_004]
		//本気で言ってるのかい？
	}
	talk スネーク 標準 -m {
		[TO_レイブン影正体前:スネーク_005]
		//さあな。いずれにせよ、
		//行ってみればわかることだ。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_レイブン影正体前_二回目以降:07 {
vox t:vc004802 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_レイブン影正体前_二回目以降:オタコン_000]
		//スネーク、気をつけてくれよ……。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_レイブン影正体後:07 {
//vox t:vc004901 {
	talk オタコン 標準 -m {
		[TO_レイブン影正体後:オタコン_000]
	}
	talk スネーク 標準 -m {
