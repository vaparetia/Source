proc rto_エルード１の１:07 {
//むびＸＸＸＸＸＸＸＸＸ
vox t:vc013301 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_エルード１の１:オタコン_000]
		//乗り越えられる手すりの近くで
		//＃｛△、アクション｝＃ボタンを押すと、その手すりの
		//向こう側にぶらさがることが出来る。
	}
} //v
}

proc rto_エルード１の２:07 {
//むびＸＸＸＸＸＸＸＸＸ
vox t:vc013302 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_エルード１の２:オタコン_000]
		//これをエルードっていうんだ。
		//移動だけじゃなく、隠れたり敵の背後を
		//とったりするのにも使えるはずだ。
	}
} //v
}


proc rto_エルード２の１:07 {
vox d:_vc013303 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_エルード２の１:オタコン_000]
		//エルード中は左スティックの左右か
		//Ｌ２ボタン、Ｒ２ボタンで左右に
		//移動出来る。
	}
} //v
}

proc rto_エルード２の２:07 {
//むびＸＸＸＸＸＸＸＸＸ
vox t:vc013304 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_エルード２の２:オタコン_000]
		//這い上がりたくなったら、
		//もう一度＃｛△、アクション｝＃ボタンを押せばいい。
	}
} //v
}

proc rto_エルード３の１:07 {
//むびＸＸＸＸＸＸＸＸＸ
vox t:vc013305 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_エルード３の１:オタコン_000]
		//あと、エルード中は＃｛ＬＩＦＥ、ライフ｝＃ゲージの
		//下に＃｛握力、グリップ｝＃ゲージが表示されるんだ。
	}
	talk オタコン 標準 -m {
		[TO_エルード３の１:オタコン_001]
		//＃｛握力、グリップ｝＃ゲージは君の握力を表していて、
		//エルードしている間、少しずつ減って
		//いく。
	}
} //v
}

proc rto_エルード３の２:07 {
//むびＸＸＸＸＸＸＸＸＸ
vox t:vc013306 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_エルード３の２:オタコン_000]
		//＃｛握力、グリップ｝＃ゲージが無くなったら、つかまっていられなくなって下に落ちてしまう。
		//そうなる前に這い上がった方がいいね。
	}
} //v
}

proc rto_エルード４の１:07 {
//むびＸＸＸＸＸＸＸＸＸ
vox t:vc013307 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
