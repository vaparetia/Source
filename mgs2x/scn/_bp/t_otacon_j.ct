		//北に進んでくれ。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_写真公開する１:07 {
vox t:vc007401 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_写真公開する１:オタコン_000]
		//新型メタルギアの写真を撮ったら、
		//僕らのウェブサイトに置いて
		//インターネット上で公開するんだ。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_写真公開する２:07 {
vox t:vc007402 {
	talk スネーク 標準 -m {
		[TO_写真公開する２:スネーク_000]
		//すぐ当局に削除されてしまうんじゃ
		//ないのか？
	}
@rt_うんちく＿否＿わからん系デフォルト 100
@rt_うんちく＿是＿詳しいな系デフォルト 50
	talk オタコン 標準 -m {
		[TO_写真公開する２:オタコン_001]
		//大丈夫。公開した途端、すぐにミラーが
		//作られるよ。頼まなくても、勝手にね。
		//第三者が根絶することなんて出来ない。
	}
	talk オタコン 標準 -m {
		[TO_写真公開する２:オタコン_002]
		//情報はそれ自体に命を持ってるんだ。
		//その命が尽きないうちは形や場所を
		//変えて生き続ける。
	}
	talk スネーク 標準 -m {
		[TO_写真公開する２:スネーク_003]
		//命？
	}
	talk オタコン 標準 -m {
		[TO_写真公開する２:オタコン_004]
		//人がそれを知りたいと思う欲求。
		//つまり需要だ。
	}
	talk スネーク 標準 -m {
		[TO_写真公開する２:スネーク_005]
		//下世話な興味か。
	}
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_写真公開する２:オタコン_006]
		//下世話でない人間なんていないさ。
		//だからそれが真実を導くこともある。
		//僕はそう信じてる。
	}
} //v
}


proc rto_カサッカうんちく:07 {
vox t:vc008001 {
@rt_うんちく＿否＿わからん系デフォルト 100
@rt_うんちく＿是＿詳しいな系デフォルト 50
	talk オタコン 標準 -m {
		[TO_カサッカうんちく:オタコン_000]
		//さっきのヘリはＫａ−６０カサッカだね。
		//ロシアのカモフ設計局で作られた軍用の
		//多目的ヘリコプターだ。
	}

	talk オタコン 標準 -m {
		[TO_カサッカうんちく:オタコン_001]
		//歩兵・武器弾薬の輸送、負傷兵の後送、
		//攻撃ヘリのためのターゲット補足、
		//全天候偵察等、様々な任務に対応できる。
	}

@rt_うんちく＿否＿わからん系デフォルト 100
@rt_うんちく＿是＿詳しいな系デフォルト 50
	talk オタコン 標準 -m {
		[TO_カサッカうんちく:オタコン_002]
		//フェネストロン式テイルローターを
		//採用してるから、君も聞いた通りの
		//独特のローター音がするんだ。
	}

	talk オタコン 標準 -m {
		[TO_カサッカうんちく:オタコン_003]
		//確かにロシア製のヘリだけど
		//民間型のＫａ−６２も作られてるし、
		//輸出モデルのＫａ−６４もある。
	}

	talk オタコン 標準 -m {
		[TO_カサッカうんちく:オタコン_004]
		//だから彼らがロシア軍とは
		//言い切れないね……。
	}
} //v
}

proc rto_オルガ戦逃げられない１:07 {
vox t:vc008101 {
@rt_無茶指令＿否＿お前がやれ系デフォルト 100
@rt_うなづきデフォルト＿是
	talk オタコン 標準 -m {
		[TO_オルガ戦逃げられない１:オタコン_000]
		//スネーク、逃げるのかい？
		//でも相手が見逃してくれるとは思えない。
		//ここは戦うしかないよ！
	}
} //v
}
	//＠オルガ、スネークＬＩＦＥ判断
proc rto_オルガ戦逃げられないスネーク不利:07 {
vox t:vc008102 {
@rt_つっこまれ＿是＿なんで知ってるんだ系デフォルト 100
@rt_無茶指令＿否＿お前がやれ系デフォルト 100
	talk オタコン 標準 -m {
		[TO_オルガ戦逃げられないスネーク不利:オタコン_000]
		//分が悪いからって弱気になった？
		//らしくないね。諦めちゃダメだ。
	}
} //v
}

proc rto_オルガ戦逃げられないスネーク有利:07 {
vox t:vc008103 {
@rt_つっこまれ＿是＿なんで知ってるんだ系デフォルト 100
@rt_無茶指令＿否＿お前がやれ系デフォルト 100
	talk オタコン 標準 -m {
		[TO_オルガ戦逃げられないスネーク有利:オタコン_000]
		//相手もかなり弱ってる。
		//もう少しだ。がんばってくれ！
	}
} //v
}


proc rto_オルガ戦隠れながら撃て:07 {
vox t:vc008201 {
@rt_無茶指令＿否＿お前がやれ系デフォルト 100
@rt_うなづきデフォルト＿是
	talk オタコン 標準 -m {
		[TO_オルガ戦隠れながら撃て:オタコン_000]
		//スネーク、相手も銃を持ってるんだ。
		//無防備に体をさらしたら撃たれてしまう。
		//遮蔽物に身を隠すんだ。
	}

	talk オタコン 標準 -m {
		[TO_オルガ戦隠れながら撃て:オタコン_001]
		//向こうも隠れてるけど、攻撃をしかける
		//時には物陰から出てくる。その一瞬を
		//狙うんだ。主観攻撃を使って！
	}
} //v
}

proc rto_オルガ戦立入禁止:07 {
vox t:vc008301 {
@rt_無茶指令＿否＿お前がやれ系デフォルト 100
@rt_うなづきデフォルト＿是
	talk オタコン 標準 -m {
		[TO_オルガ戦立入禁止:オタコン_000]
		//スネーク、そこから前に出たら相手から
		//丸見えだ。蜂の巣にされたいのかい！？
		//戻って！！
	}
} //v
}

proc rto_オルガ戦主観攻撃１:07 {
vox t:vc008401 {
@rt_無茶指令＿否＿お前がやれ系デフォルト 100
@rt_うなづきデフォルト＿是
	talk オタコン 標準 -m {
		[TO_オルガ戦主観攻撃１:オタコン_000]
		//スネーク、相手は遮蔽物に隠れながら
		//撃ってきてる。こっちも主観攻撃で
		//狙うんだ。
	}
} //v
}

proc rto_オルガ戦主観攻撃２:07 {
vox d:_vc008402 {
@rt_無茶指令＿否＿お前がやれ系デフォルト 100
@rt_うなづきデフォルト＿是
	talk オタコン 標準 -m {
		[TO_オルガ戦主観攻撃２:オタコン_000]
		//Ｒ１ボタンを押すと主観になる。
		//この時に＃｛□、武器｝＃ボタンで武器を構えれば
		//主観攻撃が出来るんだ。
	}
} //v
}

proc rto_オルガ戦主観攻撃３:07 {
vox d:_vc008403 {
@rt_無茶指令＿否＿お前がやれ系デフォルト 100
@rt_うなづきデフォルト＿是
	talk オタコン 標準 -m {
		[TO_オルガ戦主観攻撃３:オタコン_000]
		//主観の時にＬ２ボタン、Ｒ２ボタンを
		//押せば、主観のままそれぞれ左右に
		//ステップする。
	}
} //v
}

proc rto_オルガ戦主観攻撃４:07 {
vox d:_vc008404 {
@rt_無茶指令＿否＿お前がやれ系デフォルト 100
@rt_うなづきデフォルト＿是
	talk オタコン 標準 -m {
		[TO_オルガ戦主観攻撃４:オタコン_000]
		//Ｌ２ボタンとＲ２ボタンを同時に押せば、
		//主観のまま背伸びして上に伸び上がる
		//ことが出来る。うまく使ってくれ。
	}
} //v
}


proc rto_オルガ戦ビハインド活用１:07 {
vox t:vc008501 {
@rt_無茶指令＿否＿お前がやれ系デフォルト 100
@rt_うなづきデフォルト＿是
	talk オタコン 標準 -m {
		[TO_オルガ戦ビハインド活用１:オタコン_000]
		//スネーク、ビハインドを使って、
		//隠れながら相手の隙を見つけるんだ。
	}
} //v
}

proc rto_オルガ戦ビハインド活用２の１:07 {
vox d:_vc008502 {
@rt_無茶指令＿否＿お前がやれ系デフォルト 100
@rt_うなづきデフォルト＿是
	talk オタコン 標準 -m {
		[TO_オルガ戦ビハインド活用２の１:オタコン_000]
		//ビハインドの状態でＲ２ボタン、
		//Ｌ２ボタンを押すと覗き込みが
		//出来る。
	}
} //v
}

proc rto_オルガ戦ビハインド活用２の２:07 {
vox d:_vc008503 {
@rt_無茶指令＿否＿お前がやれ系デフォルト 100
@rt_うなづきデフォルト＿是
	talk オタコン 標準 -m {
		[TO_オルガ戦ビハインド活用２の２:オタコン_000]
		//ビハインドしながら右スティックを
		//動かして、そっちの方を伺うのも有効だ。
	}
} //v
}

proc rto_オルガ戦ビハインド活用３:07 {
vox t:vc008504 {
@rt_無茶指令＿否＿お前がやれ系デフォルト 100
@rt_うなづきデフォルト＿是
	talk オタコン 標準 -m {
		[TO_オルガ戦ビハインド活用３:オタコン_000]
		//武器を装備してるなら、ビハインド中に
		//＃｛□、武器｝＃ボタンを押せば、遮蔽物から素早く
		//飛び出して武器を構えることが出来る。
	}
} //v
}

proc rto_オルガ戦ビハインド活用４:07 {
vox t:vc008505 {
@rt_無茶指令＿否＿お前がやれ系デフォルト 100
@rt_うなづきデフォルト＿是
	talk オタコン 標準 -m {
		[TO_オルガ戦ビハインド活用４:オタコン_000]
		//相手が攻撃してくる時がチャンスだ。
		//撃たれる前に撃て！
	}
} //v
}


proc rto_オルガ戦中空障害物:07 {
vox t:vc008601 {
@rt_無茶指令＿否＿お前がやれ系デフォルト 100
@rt_うなづきデフォルト＿是
	talk オタコン 標準 -m {
		[TO_オルガ戦中空障害物:オタコン_000]
		//主観攻撃を使えばコンテナの隙間からも
		//狙撃出来るはずだ。相手の不意をつける
		//かもしれない。
	}
} //v
}

proc rto_オルガ戦グレネード:07 {
vox t:vc008701 {
@rt_無茶指令＿否＿お前がやれ系デフォルト 100
@rt_うなづきデフォルト＿是
	talk オタコン 標準 -m {
		[TO_オルガ戦グレネード:オタコン_000]
		//スネーク、相手はグレネードを持ってる。
		//ずっと同じ所に隠れていたら危ない。
		//こまめに場所を変えるんだ！
	}
} //v
}

proc rto_オルガ戦何者:07 {
vox t:vc008801 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_オルガ戦何者:オタコン_000]
		//いったい何者なんだろう？
	}
	talk スネーク 標準 -m {
		[TO_オルガ戦何者:スネーク_001]
		//あのスカウトナイフを見る限り
		//スペツナズのようでもあるが……。
	}
	talk オタコン 標準 -m {
		[TO_オルガ戦何者:オタコン_002]
		//スペツナズ……旧＃｛ＧＲＵ。グルー｝＃の特殊部隊か。
		//じゃあ、やっぱりロシアの？
	}
	talk スネーク 標準 -m {
		[TO_オルガ戦何者:スネーク_003]
		//さあな。とりあえず確かなのは
		//射撃の腕が良いということだけだ。
	}
	talk オタコン 標準 -m {
		[TO_オルガ戦何者:オタコン_004]
		//気をつけて。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_エンジンルーム北西行け:07 {
//vox t:vc008901
vox t:vc008902 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_エンジンルーム北西行け:オタコン_000]
		//スネーク、その機関室の北西に
		//船倉へ下りる階段があるはずだ。
		//西に向かってくれ。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_サイファー:07 {
vox t:vc009001 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_サイファー:オタコン_000]
		//サイファーは見た通りの空飛ぶ
		//円盤型偵察機だよ。陸上及び海上監視、
		//通信支援に使われる＃｛無人機、ＵＡＶ｝＃だ。
	}
@rt_うんちく＿否＿わからん系デフォルト 100
@rt_うんちく＿是＿詳しいな系デフォルト 50
	talk オタコン 標準 -m {
		[TO_サイファー:オタコン_001]
		//垂直離着陸が可能で、同軸回転翼と
		//それを囲む環状シュラウドからの
		//ダクテッド・エアストリームで飛ぶ。
	}
	talk オタコン 標準 -m {
		[TO_サイファー:オタコン_002]
		//君が見たのは陸軍で採用されてる
		//タイプのサイファーだったね。
	}
@rt_うんちく＿否＿わからん系デフォルト 100
@rt_うんちく＿是＿詳しいな系デフォルト 50
	talk オタコン 標準 -m {
		[TO_サイファー:オタコン_003]
		//でも海兵隊の極秘プロジェクトに
		//陸軍が公式に協力するなんて
		//考えにくい……。
	}
	talk スネーク 標準 -m {
		[TO_サイファー:スネーク_004]
		//ああ。俺達やロシア兵の他にも
		//新型メタルギアに興味を持っている
		//勢力があるってことだな……。
	}
	talk オタコン 標準 -m {
		[TO_サイファー:オタコン_005]
		//サイファーの滞空時間は３時間位だから、
		//そのすぐ近くに発進・管制をしてる統合
		//モバイル地上ステーションがあるはずだ。
	}
	talk オタコン 標準 -m {
		[TO_サイファー:オタコン_006]
		//多分普通のトラックに偽装して
		//リバーサイドを走ってるんだと思う。
		//そっちの方も調べてみるよ。
	}
	talk スネーク 標準 -m {
		[TO_サイファー:スネーク_007]
		//頼む。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_ゴルルコビッチ:07 {
vox t:vc009101 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ゴルルコビッチ:オタコン_000]
		//まさかゴルルコビッチが絡んでるとはね。
	}
	talk スネーク 標準 -m {
		[TO_ゴルルコビッチ:スネーク_001]
		//旧ロシア軍やＧＲＵ上がりの私兵
		//軍隊を抱えているオセロットの
		//元上官、か……。
	}
	talk オタコン 標準 -m {
		[TO_ゴルルコビッチ:オタコン_002]
		//シャドーモセスの時、リキッドは
		//彼の部隊と合流して蜂起を継続しようと
		//していた……。
	}
	talk スネーク 標準 -m {
		[TO_ゴルルコビッチ:スネーク_003]
		//あの時は結局、オモチャを一台提供した
		//だけだったがな。どうやらスポンサー
		//稼業は廃業したらしい。
	}
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ゴルルコビッチ:オタコン_004]
		//今度はゴルルコビッチが自分で出てきた。
		//やっぱり新型メタルギアを？
	}
	talk スネーク 標準 -m {
		[TO_ゴルルコビッチ:スネーク_005]
		//だろうな。メタルギアには軍事的パワー
		//バランスを一気に覆すだけの戦略的価値
		//がある。目指すはロシアの再興か。
	}
	talk オタコン 標準 -m {
		[TO_ゴルルコビッチ:オタコン_006]
		//あの時と同じだね。進歩の無い奴だ。
	}
	talk スネーク 標準 -m {
		[TO_ゴルルコビッチ:スネーク_007]
		//進歩してないのは現実の方かも
		//しれんがな。
	}
@rt_うなづきデフォルト＿是
@rt_つっこまれ＿否＿お前が言うな系デフォルト 100
	talk オタコン 標準 -m {
		[TO_ゴルルコビッチ:オタコン_008]
		//そうかもしれないね。だから僕らは
		//それを変えるために戦ってる。
		//そうだろ？
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_オルガ戦後オルガ:07 {
vox t:vc009201 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_オルガ戦後オルガ:オタコン_000]
		//あのオルガって女の人、
		//何者だったんだろう？
	}
	talk スネーク 標準 -m {
		[TO_オルガ戦後オルガ:スネーク_001]
		//さあな。ゴルルコビッチの娘らしいが。
		//『国亡き民』、か……。
	}
	talk オタコン 標準 -m {
		[TO_オルガ戦後オルガ:オタコン_002]
		//……ちょっとメリルに似てたね？
	}
	talk スネーク 標準 -m {
		[TO_オルガ戦後オルガ:スネーク_003]
		//……似てないさ。
	}
} //v
}


// added by S.Hirano 01/03/02
proc rto_ＥＥメール:07 {
vox t:vc009301 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_ＥＥメール:オタコン_000]
		//……スネーク、ごめん。
		//妹のこと言えなかったのは……。
	}
	talk スネーク 標準 -m {
		[TO_ＥＥメール:スネーク_001]
		//オタコン、俺がこのバンダナを誰から
		//貰ったか、話したことはあったか？
	}
	talk オタコン 標準 -m {
		[TO_ＥＥメール:オタコン_002]
		//いや、ないけど……。
		//どういうこと？
	}
	talk スネーク 標準 -m {
		[TO_ＥＥメール:スネーク_003]
		//気にするなってことだ。
	}
	talk オタコン 標準 -m {
		[TO_ＥＥメール:オタコン_004]
		//……ありがとう。
	}
} //v
}


/*-------------------------------------
デフォルト説明系会話呼び出しプロックス
クラックキメてぇ。
