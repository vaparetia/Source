/**************************************************************************************************/
// マップ
/**************************************************************************************************/
chara マップ ブリッジ屋上部 -k d:MAP_NAME -h d:MAP_NAME -l d:MAP_NAME

/**************************************************************************************************/
// マップ設定
/**************************************************************************************************/

command マップ設定 \
	ブリッジ屋上部 -s {

	@サウンドセット				// サウンドは始めに
	@常駐キャラ設定
	@ローカル変数初期化
	@プレイヤーセット
	//@タンカー編全体マップ設定 d:船橋五階操舵室マップ	// stdproc.hで定義
	@敵兵セット
	@ルート変更
	@敵兵ルートチェンジセット
	@右舷水密ドア開けるデモ
	@ＢＧＭマネージャー設定		// コマンダーの後で呼び出す事
	@ポーズ時ステージ名表示設定 d:wn_航海甲板ウイング

// エフェクト
	@カメラ揺れ
	@ブラーセット
	@新空_新雷セット
	@天球_風制御セット
	@雨_武器水飛沫セット
	@霧雨_フォグセット
	@川岸のぼかし
	@カメラ雨セット
	@レーダークルクル
	@長階段手すり水飛沫セット
	@マスト手すり水飛沫セット
	@屋上箱２つ水飛沫セット
	@プットテクスチャ関連セット
	@Ｚフォーカス管理セット
	@シナリオデモキャラセット

	@スポットライト_下層左舷投光器セット
	@スポットライト_下層右舷投光器セット
	@スポットライト_上層照明セット
	@影用ハザードセット
	@木箱の上のIRS制御ボックスセット

#if d:E3_VIDEO
#else
	//@波面セット	// フォグがかかってて見えない
	@スネーク隠れ用箱水飛沫セット
	@右舷オブジェ水飛沫セット
//	@下層_床水飛沫
//	@上層_床水飛沫

	@床の水飛沫セット
	@下階層水飛沫セット
	@上階層水飛沫セット
	@下階投光器水飛沫セット
#endif


// カメラ
	@各種カメラ作成
	@デフォルトカメラセット
	@下層階カメラセット１
	@下層階カメラセット２
	@下層階カメラセット３

	@上層階カメラセット１

	@上下つなぎ階段カメラセット

	@上層階動きビハインドカメラセット１
	@上層階動きビハインドカメラセット２
	@上層階動きビハインドカメラセット３
	@上層階動きビハインドカメラセット４
	@上層階動きビハインドカメラセット５
	@上層階動きビハインドカメラセット６

	@中央下層カメラ
	@左下層カメラ
	@右下層カメラ
	@左ウィングカメラ
	@左ウィングビハインドカメラ
	@右ウィングカメラ
	@右ウィングビハインドカメラ
	@下層中央ビハインドカメラ
	@上層部カメラ
	@上層部ビハインドカメラ
	@はしごカメラ

// エルード
	@下層階エルード設定１
	@下層階エルード設定５
	@下層階エルード設定２
	@下層階エルード設定６

	@下層階エルード設定３
	@下層階エルード設定７


// オブジェクト
	@艦橋内_マスト_映り込みセット	// うまくいって無いらしい by 平野
	@鉄箱_木箱セット
	@オルガ隠れ場所セット
	@タンカーぼんぼりセット
	@煙突煙セット
	@クレーンワイヤーセット
	@旗_ワイヤーセット
	@マンハッタンセット
	@船首オブジェセット
	@下層階照明モデルセット
	@底抜け防止モデルセット
	@手前の煙突オブジェクト

	@５０ｃｍ隙間壁

// 梯子
	@はしご最下層部、乗り降り時カメラ
	@はしご最下層部、乗り降りモーション
	//@最下層<->第一層部、上下中のカメラ
	@はしご第一層部、乗り降り時カメラ
	@はしご第一層部、乗り降りモーション
	//@第一層部<->第二層部、上下中のカメラ
	@はしご第二層部、乗り降り時カメラ
	@はしご第二層部、乗り降りモーション
	//@第二層部<->第三層部、上下中のカメラ
	@はしご第三層部、乗り降り時カメラ
	@はしご第三層部、乗り降りモーション

	@床面映り込みセット

	@アイテムセット

	@オルガ引きずりセット

	@自動ジャンプセット
	@クルクルドアセット
	@飛び降り死亡

	@タンカーデジカメ写真判定


#if d:MY_DEBUG
	@遠近ぼかしセット
	@スクリーンショット使用
	@USBキーボード
#endif
} // <command マップ設定 ブリッジ屋上部>の閉じカッコ

/**************************************************************************************************/
// 無線gclのインクルード。
// 必ずマップ設定と、showコマンドの間に置くこと。
/**************************************************************************************************/
#include "w00c_cdc.ch"

/**************************************************************************************************/
// マップ初期表示
/**************************************************************************************************/
	command マップ表示 -show ブリッジ屋上部

/**************************************************************************************************/
// ステージ開始時処理
/**************************************************************************************************/
	if( $s:登場ポイント == w00bから来た ) {
		print 'デモから'
		//if( $f:オルガ戦後デモ終了した == 0 ) {
		eval( $f:オルガ戦後デモ終了した = 1 )
		eval( $w:武器弾数[ d:武器:ＵＳＰ ] = 0 )
		@ロード時フェードイン
		@プレイヤー水飛沫セット
	} else if( $s:登場ポイント == w01e左舷から来た ) {
		print '左舷から'
		@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:WT_DOOR_TYPE 水密君_左 1700 \
												d:DEFAULT_M_TYPE d:wn_航海甲板左舷ウイング

		chara delay 水飛沫ディレイ -time 60 -exec {
			@プレイヤー水飛沫セット
		}
	} else if( $s:登場ポイント == w01e右舷から来た ) {
		print '右舷から'
		@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:WT_DOOR_TYPE 水密君_右 1700 \
												d:DEFAULT_M_TYPE d:wn_航海甲板右舷ウイング
		chara delay 水飛沫ディレイ -time 60 -exec {
			@プレイヤー水飛沫セット
		}
	} else {
		#if d:ASSERT
			command assert ( d:FALSE ) 'unexpected load point'
		#endif
	}

/*
proc オルガ戦後デモ終了 {
	//eval( $i:プレイヤー初期Ｘ位置 = -14788 )
	//eval( $i:プレイヤー初期Ｙ位置 = 13750 )
	//eval( $i:プレイヤー初期Ｚ位置 = -16237 )
	//eval( $i:プレイヤー初期方向 = 0 )
	eval( $f:オルガ戦後デモ終了した = 1 )
	restart -s
}
*/
	proc プレイヤー水飛沫セット {
		chara キャラ付随水飛抹 スネーク水飛沫 \
			-nconcname d:PLAYER \
			-addone 32 \
			-time -1 \
			-rgbadd 0x40404030 \
			-gbsub 0x40404030
	}

/**************************************************************************************************/
// サウンド
/**************************************************************************************************/

proc サウンドセット {
#if d:SOUND
	chara サウンドマネージャー ＳＤマネ -pak 0

	@サウンド効果音設定

	command 弾痕ノーマル -n 0
	command 弾痕ノーマル -n 1
	command 弾痕ノーマル -n 2
	command 弾痕ノーマル -n 3
	command 弾痕ノーマル -n 4
	command 弾痕ノーマル -n 5
	command 弾痕ノーマル -n 6

	command 跳弾ノーマル -n 0
	command 跳弾ノーマル -n 1
	command 跳弾ノーマル -n 2
	command 跳弾ノーマル -n 3
	command 跳弾ノーマル -n 4
	command 跳弾ノーマル -n 5

	command 跳弾ＳＥのみ -n 6
/*
	// 水蒸気の番号設定
	command 弾痕ノーマル -n 5
	command 弾痕ノーマル -n 6
	command 弾痕ノーマル -n 7
	command 跳弾水蒸気小 -n 5
	command 跳弾水蒸気中 -n 6
	command 跳弾水蒸気大 -n 7
*/
	chara ＢＧＭ風音 風音

	//Track0x07 …雨、鉄板系当たり音[場所に貼る]
	chara ＢＧＭフェーダー 雨鉄板系当たり音 \
		-t 0x07 \
		-a -11500,13000,-17050  500,1000,1000 w00b \ // 左舷低階段
		    11500,13000,-17050  500,1000,1000 w00b \ // 右舷低階段
		      250,14000, -9575 2000,2500, 550 w00b \ // 中央階段
		        0,19000,-13750 1500,1000,2250 w00b \ // マスト一段目
		        0,25000,-13000 1500,1000,3000 w00b \ // マスト二段目
		        0,28500,-15325 1500,1000,1625 w00b   // マスト三段目

#endif
}

proc ＢＧＭマネージャー設定 {
#if d:SOUND
	chara ＢＧＭマネージャー ＢＧＭ
#endif
}

/**************************************************************************************************/
// ローカル変数初期化
/**************************************************************************************************/
proc ローカル変数初期化 {
	eval( $f:危険モード = 0 )

}

/**************************************************************************************************/
// エフェクト
/**************************************************************************************************/
proc カメラ揺れ {
	chara カメラ上下振動 波ゆれ \
					-a 96 \
					-c 512
}

proc ブラーセット {
	chara ブラー オカジーブラー
}

proc 煙突煙セット {
	chara 煙突煙 モクモク \
		-n 4 \
		-p	4000,25000,-1000 \
			4000,25000,-3000 \
			-4000,25000,-1000 \
			-4000,25000,-3000
}

proc 新空_新雷セット {
	chara   新空 嵐空 -m w00_sky
	chara   新雷フラッシュ 嵐空
}

proc 天球_風制御セット {

	chara 天球 背景

	chara 風制御 wind \
		-i 100 \
		-j 300 \
		-r -1024 1024 0 \
		-a 4 \
		-b 300 \
		-c 150
}

proc 雨_武器水飛沫セット {

	chara 雨 rain \
		-n 4 \
		-c 120 \
		-b -6000 12000 -21000  6000 15000 -10750

	chara 武器水飛沫 水飛沫
}

proc 波面セット {
	chara 波面 wave \
		-p 0,-6000,0 \
		-s 128 \
		-n 3 \
		-w 5 5 \
		-b 	     0,200,  20500,6,    0,  0 \
			 18000,500,-255000,8, 1251,-50 \
			-18000,500,-245000,8,-1251,-50 \
		-x 0,-135500 20000,132500

	chara 嵐の川波 高波 \
		-tex wave wave06 wave09_alp_ovl \
		-dir 100,-20,100 \
		-color 160,160,160 \
		-ambient 10,10,10 \
		-pos 0,-4000,0
}

proc タンカーぼんぼりセット {
		chara プットテクスチャ タンカー前部ボンボリ \
			-t light07_msk light07_msk light07_msk light07_msk light07_msk light07_msk light07_msk light07_msk \
			-p 	-17000, 3500,  -61000 \
				 17000, 3500,  -61000 \
				-17000, 3500, -121000 \
				 17000, 3500, -121000 \
				-17000, 3500, -181000 \
				 17000, 3500, -181000 \
				 -3500, 4000, -112100 \
				     0, 7000, -218000 \
			-r 0 0 0 0 0 0 0 0 \
			-c 	128 128 128 32 \
				128 128 128 32 \
				128 128 128 32 \
				128 128 128 32 \
				128 128 128 32 \
				128 128 128 32 \
				128 128 128 32 \
				128 128 128 32 \
			-s 	10000 10000 \
				10000 10000 \
				10000 10000 \
				10000 10000 \
				10000 10000 \
				10000 10000 \
				10000 10000 \
				10000 10000
}

proc 霧雨_フォグセット {
/*
#if d:E3_VIDEO
#else
	chara 霧雨 霧雨
#endif
*/

#if 1
	// 雨天
	chara フォグ 霧 \
		 -c 16 32 27 \
		 -n 10000 \
		 -f 28000
#else
	// 晴天
	chara フォグ 霧 \
		 -c 16 32 37 \
		 -n 10000 \
		 -f 28000
#endif
}

proc 川岸のぼかし {
	chara 遠景ぼかし far_blur \
		-plane	2 \
		-near	50000 \
		-far	100000 \
		-enable
}

proc 遠近ぼかしセット {
	chara 遠景ぼかし 遠景ぼかし１ \
		-plane	4 \
		-near	1000 \
		-far	5000

	chara 遠景ぼかし 遠景ぼかし２ \
		-plane	4 \
		-near	5000 \
		-far	10000

	chara 遠景ぼかし 遠景ぼかし３ \
		-plane	4 \
		-near	10000 \
		-far	15000

	chara 近景ぼかし 近景ぼかし１ \
		-plane	3 \
		-near	0 \
		-far	1000

	chara 近景ぼかし 近景ぼかし２ \
		-plane	3 \
		-near	0 \
		-far	2000

	chara 近景ぼかし 近景ぼかし３ \
		-plane	3 \
		-near	0 \
		-far	4000
}

proc カメラ雨セット {
#if d:E3_VIDEO
	chara カメラ雨 カメラ雨 \
	-l 1 // C4爆破時の描画軽減策
#else
	chara カメラ雨 カメラ雨
	//mesg カメラ雨 カメラ雨 オフ

	mesg カメラ雨 カメラ雨 カメラ前水飛沫出っ放し
	mesg カメラ雨 カメラ雨 カメラ前水飛沫制御オン
#endif
}

proc マンハッタンセット {
	chara マンハッタン トランスファー \
		-l d:MAP_NAME
	chara ブルックリン ブルックリン \
		-l d:MAP_NAME
	chara マンハット黄灯 黄灯
	chara マンハット赤灯1 赤灯1
	chara マンハット赤灯2 赤灯2
	chara ブルックリン赤灯 赤灯
}

proc クレーンワイヤーセット {
print 'wire_begin'
	chara ロープモデル２ クレーンワイヤー \
		-n w00a_ch1 \
		-x 10950 7970 6610 \
		-d 0

	chara ロープモデル２ クレーンワイヤー \
		-n w00a_ch1 \
		-x -10950 7970 6610 \
		-d 0
print 'wire_end'
}

proc 旗_ワイヤーセット {
	chara プット頂点アニメオブジェ 旗         \
		-m w00_vfg \
		-b 5 \
		-w 1 \
		-p 0,0,0
	chara プット頂点アニメオブジェ ワイヤー１ \
		-m w00_vw1 \
		-b 5 \
		-w 1 \
		-p 0,0,0
	chara プット頂点アニメオブジェ ワイヤー２ \
		-m w00_vw2 \
		-b 5 \
		-w 1 \
		-p 0,0,0
	chara プット頂点アニメオブジェ ワイヤー３ \
		-m w00_vw3 \
		-b 5 \
		-w 1 \
		-p 0,0,0
	chara プット頂点アニメオブジェ ワイヤー４ \
		-m w00_vw4 \
		-b 5 \
		-w 1 \
		-p 0,0,0
	chara プット頂点アニメオブジェ ワイヤー５ \
		-m w00_vw5 \
		-b 5 \
		-w 1 \
		-p 0,0,0
	chara プット頂点アニメオブジェ ワイヤー６ \
		-m w00_vw6 \
		-b 5 \
		-w 1 \
		-p 0,0,0

	//旗の音
	chara プットＳＥ鳴らし  ＳＥ鳴らし君   -pos 0, 21475, -16430
}

proc プットテクスチャ関連セット {
	chara プットテクスチャクロスフェードワールド wwww \
		-t light12_msk \
		-u light12_msk \
		-p 1800, -1900, 8020 \
		   4200, -1900, 8020 \
		  -4200, -1900, 8020 \
		  -1800, -1900, 8020 \
		-r 0, 0 \
		   0, 0 \
		   0, 0 \
		   0, 0 \
		-s 1300 1700

	chara プットテクスチャクロスフェードカメラ ssss \
		-t xlit04b_alp \
		-u xlit04a_alp \
		-v xlit05b_alp \
		-p \
		   //1800, 2300, 8350 \
		   //4200, 2300, 8350 \
		   //7650, 3800, 4500 \
		   6650, 8675,500 \
		   6650, 8675, 3500 \
		   6650, 8675,-2500 \
		   6650, 8675,-5600 \
		  11000, 8900,-8350 \
