/**************************************************************************************************/
// ＵＳＢキーボード設定
/**************************************************************************************************/
proc USBキーボード{
#if d:MY_DEBUG
	chara USBキーボード実行 test \
		-e d:KPD_1  {	mesg プレイヤー d:PLAYER position 17000 13775 -13923 } \
		-e d:KPD_2  {	mesg プレイヤー d:PLAYER position 0 1000 0 } \
		-e d:KPD_0  {
						eval( $f:危険モード = 0 )
						eval( $f:w00b_左舷投光器壊れた = 0 )
						eval( $f:w00c_右投光器壊れフラグ = 0 )
						eval( $f:オルガ失踪 = 0 )
						eval( $f:global_右水密ドア開くイベント = 0 )
						command varsave
					} \
		-e d:KBD_ESC {	mesg 臨時顔アニメキャラ スネークアニメ モーション再生 normal 30
						mesg 臨時顔アニメキャラ スネークアニメ 視線変更 -1
						mesg 遠景ぼかし 遠景ぼかし１ off
						mesg 遠景ぼかし 遠景ぼかし２ off
						mesg 遠景ぼかし 遠景ぼかし３ off
