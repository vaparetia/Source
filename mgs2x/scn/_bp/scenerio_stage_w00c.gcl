// エルード設定
// ------------------------------------
/*
proc エルード_底抜けモデル消し {
	mesg プットオブジェ 底抜け防止 off
}

proc エルード_底抜けモデル発生 {
	mesg プットオブジェ 底抜け防止 on
}
*/

proc 下層階エルード設定１ {
		trap by000 d:PLAYER \
			-mask いる \
			-key d:PAD_X \	// △ボタン
			-state d:TRP_STATE_STAND,d:TRP_STATE_CAUTION \	//立ち状態or張り付き
			-exec {
				@西向きビヨンド発動 by000 -11900 $6 -11250 -9500 ( d:BY_FALL_DEAD | d:BY_NOFOOTSHADOW )
			}

		// ぶら下がり前
		trap by000 d:PLAYER \
			-mask いる \
			-state d:TRP_STATE_FORCE \	// 強制モーション
			-dir 3072 256 \				// 方向指定
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b -32000,-32000,-32000 32000,32000,32000 \
					-l -32000,-32000,-32000 32000,32000,32000 \
					-r 258,1452,0 -f 5076 \
					-a 200 \
					-i 1 -1 0 0 \
					-s 1
			}

		// ぶら下がり中
		trap by000 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_ELUDE \	// エルード中
			-dir 1024 256 \				// 方向指定
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b -32000,-32000,-32000 32000,32000,32000 \
					-l -32000,-32000,-32000 32000,32000,32000 \
					-r 243,1377,0 -f 6768 \
					-a 200 \
					-i 3 2 0 0 \
					-s $3
			}
	}

