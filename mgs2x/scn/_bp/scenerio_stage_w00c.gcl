// スポットライト関連
// ------------------------------------
proc スポットライト_下層左舷投光器セット {

	if( $f:w00b_左舷投光器壊れた == 0){

		chara スポットライト投影モデル 左舷投光器 \
			-model w00k2 \
			-pos 0,10,0

		chara スポットライト投影モデル 左舷投光器 \
			-model w00k5 \
			-pos 0,10,0


		chara 静止スポットライト設置 左舷投光器 \
			-pos -19765, 14610, -14914 \
			-dir  19700, -12000, -6000 \
			-range /*15000*/8000 \
			-angle 45 \
			-color 152,153,151 \
			-option 0x0000

		chara プット投光器オブジェ 投光器_左 \
			-m  w00_sl2 w00_sl2x \
			-n ブリッジ屋上 左舷投光器 \
			-l d:MAP_NAME \
			-b 左投光器壊れ \
			-p 0,0,0

		chara 固定ボリュームライト 左舷投光器 \
			-p -19670,13610,-14914 \
			-d 0,19000,-11000 \
			-n 32 \		// 16 (max=32)
			-l 15000 \	// 15000
			-w 3000		// 1000

		chara プロック連続実行 左舷投光器連続チェック -time -1 -exec {
			if( $i:プレイヤー位置Ｘ < /*0*/1000 ) {
				if( $f:w00b_左舷投光器壊れた == 0 ) {
					mesg 静止スポットライト設置 左舷投光器 on
				}
			} else {
				if( $f:w00b_左舷投光器壊れた == 0 ) {
					command プレイヤー状態取得
					if( ($status & d:PFLAG_SUBJECT) || ($status & d:PFLAG_BEHIND) ){
						mesg 静止スポットライト設置 左舷投光器 on
					} else {
						mesg 静止スポットライト設置 左舷投光器 off
					}
				}
			}
		}
	} else {
		command 光源消し -pos -20175 14499 -14989
		chara プットオブジェ 壊れ投光器 -m w00_sl2x -r 0,0,0 -p 0,0,0 -l w00c -f d:PUT_OBJ_AUTOREPAINT
	}
}

proc スポットライト_下層右舷投光器セット {
	if( $f:w00c_右投光器壊れフラグ == 0 ) {
		chara スポットライト投影モデル 右舷投光器 \
			-model w00k1 \
			-pos 0,10,0

		chara 静止スポットライト設置 右舷投光器 \
			-pos 19765, 14610, -14914 \
			-dir -19700, -12000, -6000 \
			-range /*15000*/8000 \
			-angle 45 \
			-color 152,153,151 \
			-option 0x0000

		chara プット投光器オブジェ 投光器_右 \
			-m  w00_sl1 w00_sl1x \
			-n ブリッジ屋上 右舷投光器 \
			-l d:MAP_NAME \
			-b 右投光器壊れ \
			-p 0,0,0

		chara 固定ボリュームライト 右舷投光器 \
			-p 19670,13610,-14914 \
			-d 0,19000,-11000 \
			-n 32 \		// 16 (max=32)
			-l 15000 \	// 15000
			-w 3000		// 1000

		chara プロック連続実行 右舷投光器連続チェック -time -1 -exec {
			if( $i:プレイヤー位置Ｘ > /*0*/-1000 ) {
				if( $f:w00c_右投光器壊れフラグ == 0 ) {
					mesg 静止スポットライト設置 右舷投光器 on
				}
			} else {
				if( $f:w00c_右投光器壊れフラグ == 0 ) {
					command プレイヤー状態取得
					if( ($status & d:PFLAG_SUBJECT) || ($status & d:PFLAG_BEHIND) ){
						mesg 静止スポットライト設置 右舷投光器 on
					} else {
						mesg 静止スポットライト設置 右舷投光器 off
					}
				}
			}
		}
	} else {
		command 光源消し -pos 20175 14499 -14989
		chara プットオブジェ 壊れ投光器 -m w00_sl1x -r 0,0,0 -p 0,0,0 -l w00c  -f d:PUT_OBJ_AUTOREPAINT
	}
}

// 投光器壊れた時フラグ
	proc 左投光器壊れ {
		eval( $f:w00b_左舷投光器壊れた = 1 )
		chara delay ディレイ -time 1 -exec {
			mesg 静止スポットライト設置 左舷投光器 off
		}
	}

	proc 右投光器壊れ {
		eval( $f:w00c_右投光器壊れフラグ = 1 )
		chara delay ディレイ -time 1 -exec {
			mesg 静止スポットライト設置 右舷投光器 off
		}
	}



