							} else {				// 腰が水平に位置する場合
								command はしご設定 -s d:モーションリスト:ladder_hold_l_s -700,25000,-11950 1024 \
												   -e d:モーションリスト:ladder_hold_r_e 250,25000,-11950 2048
							}
						} else {
							if($5 < 24500){			// 腰が下寄りに位置する場合
								command はしご設定 -s d:モーションリスト:ladder_up_c_s   0,25000,-11950 2048 \
												   -e d:モーションリスト:ladder_up_r_e 250,24000,-11950 2048
							} else if($5 > 25000){	// 腰が上寄りに位置する場合
								command はしご設定 -s d:モーションリスト:ladder_up_c_s   0,25000,-11950 2048 \
												   -e d:モーションリスト:ladder_down_r_e 250,25500,-11950 2048
							} else {				// 腰が水平に位置する場合
								command はしご設定 -s d:モーションリスト:ladder_up_c_s   0,25000,-11950 2048 \
												   -e d:モーションリスト:ladder_hold_r_e 250,25000,-11950 2048
							}
						}
						mesg プレイヤー d:PLAYER ladder
				}
		/////////////////////////
		// レバーで梯子から降りる時の設定
			// 右側の設定
			trap la002 d:PLAYER \
				-mask 入る \
				-state d:TRP_STATE_LADDER \
				-key d:PAD_R \
				-exec {
					if( !(`command プレイヤー状態取得` & d:PFLAG_SUBJECT) ) {
						if($5 < 24500){			// 腰が下寄りに位置する場合
							command はしご設定 -e d:モーションリスト:ladder_up_r_e     250,24000,-11950 2048
						} else if($5 > 25000){	// 腰が上寄りに位置する場合
							command はしご設定 -e d:モーションリスト:ladder_down_r_e   250,25500,-11950 2048
						} else {				// 腰が水平に位置する場合
							command はしご設定 -e d:モーションリスト:ladder_hold_r_e  250,25000,-11950 2048
						}
						mesg プレイヤー d:PLAYER ladder
					}
				}
			// 左側の設定
			trap la002 d:PLAYER \
				-mask 入る \
				-state d:TRP_STATE_LADDER \
				-key d:PAD_L \
				-exec {
					if( !(`command プレイヤー状態取得` & d:PFLAG_SUBJECT) ) {
