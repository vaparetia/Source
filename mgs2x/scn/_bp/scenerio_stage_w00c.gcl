							command はしご設定 -s d:モーションリスト:sna_non_ladder_hold_c_start   0,28500,-11000 2048 \
											   -e d:モーションリスト:ladder_up_r_e 250,27500,-11950 2048
						} else {				// 腰が水平に位置する場合
							command はしご設定 -s d:モーションリスト:sna_non_ladder_hold_c_start   0,28500,-11000 2048 \
											   -e d:モーションリスト:ladder_hold_r_e 250,28500,-11950 2048
						}
					}
					mesg プレイヤー d:PLAYER ladder
				}
		/////////////////////////
		// レバーで梯子から降りる時の設定
			// 右側の設定
			trap la003 d:PLAYER \
				-mask 入る \
				-state d:TRP_STATE_LADDER \
				-key d:PAD_R \
				-exec {
					if( !(`command プレイヤー状態取得` & d:PFLAG_SUBJECT) ) {
						if($5 < 28000){			// 腰が下寄りに位置する場合
							command はしご設定 -e d:モーションリスト:ladder_up_r_e     250,27500,-11950 2048
						} else {				// 腰が水平に位置する場合
							command はしご設定 -e d:モーションリスト:ladder_hold_r_e  250,28500,-11950 2048
						}
						mesg プレイヤー d:PLAYER ladder
					}
				}
			// 左側の設定
			trap la003 d:PLAYER \
				-mask 入る \
				-state d:TRP_STATE_LADDER \
				-key d:PAD_L \
				-exec {
					if( !(`command プレイヤー状態取得` & d:PFLAG_SUBJECT) ) {
						if($5 < 28000){			// 腰が下寄りに位置する場合
							command はしご設定 -e d:モーションリスト:ladder_up_l_e 0,27500,-11950 2048
						} else {				// 腰が水平に位置する場合
							command はしご設定 -e d:モーションリスト:ladder_hold_l_e 0,28500,-11950 2048
						}
						mesg プレイヤー d:PLAYER ladder
					}
				}

			// レバー上で降りる
			trap la003 d:PLAYER \
			-mask いる \
			-dir 2048,256 \
			-state d:TRP_STATE_LADDER \
			-exec {
				if( !(`command プレイヤー状態取得` & d:PFLAG_SUBJECT) ) {
					command パッドチェック -which 0 -status
					if ( $status & d:PAD_U ) {
						command パッド操作 -press d:PAD_X
					}
				}
			}
	}


// オルガ
// ------------------------------------
proc オルガ隠れ場所セット {
	/*
	chara プット隠れオブジェ オルガ隠れ場所 \
		-m obs_box1 obs_box2 obs_irs \
		-r 0        0        0       \
		-p 0,0,0    0,0,0    0,0,0   \
		-l d:MAP_NAME
	*/
	chara プットオブジェ オルガ隠れ場所1 \
		-m obs_box1 -r 0 0 0 -p 0 0 0 -l w00c -s 100 100 100 -f d:PUT_OBJ_AUTOREPAINT
	chara プットオブジェ オルガ隠れ場所2 \
		-m obs_box2 -r 0 0 0 -p 0 0 0 -l w00c -s 100 100 100 -f d:PUT_OBJ_AUTOREPAINT
	chara プットオブジェ オルガ隠れ場所3 \
		-m obs_irs -r 0 0 0 -p 0 0 0 -l w00c -s 100 100 100 -f d:PUT_OBJ_AUTOREPAINT
}

proc 艦橋内_マスト_映り込みセット {
	// 船内のオブジェ
	chara プットオブジェ 艦橋内映り込み -m w00c_01e -r 0 0 0 \
		-p 0 0 0 -l d:MAP_NAME -s 100 100 100
	chara プットオブジェ 死体たち \
		-m tnc_died_obj -r 0 0 0 -p 0 0 0 -l w00c -s 100 100 100

	// 船外のオブジェ
	chara プットオブジェ マスト映り込み -m w00c_uc1 -r 0 0 0 \
		-p 0 0 0 -l d:MAP_NAME -s 100 100 100

	@船内映り込みＯＮ
}

	proc 船内映り込みＯＮ {
		mesg プットオブジェ 艦橋内映り込み on
		mesg プットオブジェ 死体たち on
		mesg プットオブジェ マスト映り込み off
	}

	proc 船内映り込みＯＦＦ {
		mesg プットオブジェ 艦橋内映り込み off
		mesg プットオブジェ 死体たち off
		mesg プットオブジェ マスト映り込み on
	}




proc 木箱の上のIRS制御ボックスセット {
	chara プットオブジェ ＩＲ制御ボックス -m irs_box -r 3072 (4096-160) 0 \
		-p  -9800 13220 -15600 -l w00c -s 100 100 100
	chara プットオブジェ ＩＲ制御ボックス -m irs_box -r 3072 (4096-50) 0 \
		-p -10250 13220 -15300 -l w00c -s 100 100 100
	chara プットオブジェ ＩＲ制御ボックス -m irs_box -r 3072 1960 0 \
		-p  -9850 13220 -15250 -l w00c -s 100 100 100
	chara プットオブジェ ＩＲ制御ボックス -m irs_box -r 3072 1420 0 \
		-p -10150 13220 -14850 -l w00c -s 100 100 100
}

proc 底抜け防止モデルセット {
// ステージの下にある、海面見え防止用のモデルをセットする。
	chara プットオブジェ 底抜け防止 -m w00c_uc2 -r 0 0 0 \
		-p 0 0 0 -l d:MAP_NAME -s 100 100 100
}

proc 手前の煙突オブジェクト {

	chara プットオブジェ 煙突オブジェ -m w00c_other -r 0 0 0 -p 0 0 0 -l w00c -s 100 100 100

	mesg プットオブジェ 煙突オブジェ off

	chara プロック連続実行 煙突ＯＮ／ＯＦＦ -time -1 -exec {
		command プレイヤー状態取得
		if( ($status & d:PFLAG_SUBJECT) || ($status & d:PFLAG_BEHIND) || \
			($status & d:PFLAG_ELUDE)   || ($status & d:PFLAG_INTRUDE) || \
			($status & d:PFLAG_CAUTION) ){
			mesg プットオブジェ 煙突オブジェ on
		} else {
			mesg プットオブジェ 煙突オブジェ off
		}
	}
}

proc 床面映り込みセット {
	chara 鏡面モデル管理 床面映り込み１ \
		-pos 0,12000,0 \
		-axis 1 // Y軸反転
	chara 鏡面モデル管理 床面映り込み２ \
		-pos 0,(12750-30),0 \
		-axis 1 // Y軸反転
	chara 鏡面モデル管理 床面映り込み３ \
		-pos 0,15000,0 \
		-axis 1 // Y軸反転

	// オルガは無条件で映り込み（移動しないので）。
	//mesg 鏡面モデル管理 床面映り込み１ add オルガ気絶
	//mesg 鏡面モデル管理 床面映り込み２ add オルガ気絶
	//mesg 鏡面モデル管理 床面映り込み３ add オルガ気絶

	// スネークは高さの違う床を行ったり来たりするので、条件でオン／オフする。
	trap ev006 ？ \
		-mask ？ \
		-exec {
			if($3 == 入る){
				mesg 鏡面モデル管理 床面映り込み１ add $2
			} else {
				mesg 鏡面モデル管理 床面映り込み１ del $2
			}
		}

	trap ev007 ？ \
		-mask ？ \
		-exec {
			if($3 == 入る){
				mesg 鏡面モデル管理 床面映り込み２ add $2
			} else {
				mesg 鏡面モデル管理 床面映り込み２ del $2
			}
		}

	trap ev008 d:PLAYER \
		-mask ？ \
		-exec {
			if($3 == 入る){
				mesg 鏡面モデル管理 床面映り込み３ add $2
			} else {
				mesg 鏡面モデル管理 床面映り込み３ del $2
			}
		}

	chara プロック連続実行 連続君 -time -1 -exec {

	// 巡回兵１
		command ゲット敵兵座標 巡回兵１ $i:敵兵Ｘ $i:敵兵Ｙ $i:敵兵Ｚ
		if( $i:敵兵Ｚ < -10750 && $i:敵兵Ｙ > 15000 ) {
			$$f:巡回兵１鏡面モデルフラグ = 1;
		} else {
			$$f:巡回兵１鏡面モデルフラグ = 0;
		}

		if( $i:プレイヤー位置Ｙ < 14000 && \
			`command プレイヤー状態取得` & ( d:PFLAG_SUBJECT | d:PFLAG_BEHIND ) ){
			$$f:巡回兵１鏡面モデルフラグ = 0;
		}

		if( $$f:巡回兵１鏡面モデルフラグ == 1 ) {
			mesg 鏡面モデル管理 床面映り込み３ add 巡回兵１
		} else {
			mesg 鏡面モデル管理 床面映り込み３ del 巡回兵１
		}
		
	//攻撃兵:01
		command ゲット敵兵座標 攻撃兵:01 $i:敵兵Ｘ $i:敵兵Ｙ $i:敵兵Ｚ
		if( $i:敵兵Ｚ < -10750 && $i:敵兵Ｙ > 15000 ) {
			$$f:攻撃兵鏡面モデルフラグ = 1;
		} else {
			$$f:攻撃兵鏡面モデルフラグ = 0;
		}

		
		if( $i:プレイヤー位置Ｙ < 14000 && \
			`command プレイヤー状態取得` & ( d:PFLAG_SUBJECT | d:PFLAG_BEHIND ) ){
			$$f:攻撃兵鏡面モデルフラグ = 0;
		}

		if( $$f:攻撃兵鏡面モデルフラグ == 1 ) {
			mesg 鏡面モデル管理 床面映り込み３ add 攻撃兵:01
		} else {
			mesg 鏡面モデル管理 床面映り込み３ del 攻撃兵:01
		}
	}
}

proc レーダークルクル {
	chara くるくる物体 radar \
		-k w00_radar \
		-p -1500 25600 -15400 \
		-r 32 \
		-s 1 \
		-d 2 200 200 48
}

/**************************************************************************************************/
// アイテム
/**************************************************************************************************/
proc アイテム取得時番号設定 $:ボックス名 {
#if d:DEBUG_PRINT
	print 'item_no_set'
#endif

	if($:ボックス名 == Ｍ９弾薬１) {
		eval($b:w00c_取得ロード回数[0] = $w:グローバルロード回数);
	} else if ($:ボックス名 == レーション１) {
		eval($b:w00c_取得ロード回数[1] = $w:グローバルロード回数);
	}

#if d:DEBUG_PRINT
	print $:ボックス名
	print $w:グローバルロード回数
#endif
}

proc アイテムセット {
/*
	@アイテム再セットチェック $b:w00c_取得ロード回数[0]
	if ($f:再セットフラグ) {
		@弾薬_Ｍ９_初期設置 Ｍ９弾薬１ 0,27500,-10950 d:アイテム水飛沫有
	}
	@アイテム再セットチェック $b:w00c_取得ロード回数[1]
	if ($f:再セットフラグ) {
		@レーション_初期設置 レーション１ 19500 12750 -19000 d:アイテム水飛沫有
	}
*/

	//if($w:アイテム数[ d:アイテム:濡れダンボール ] == 0){
		@濡れダンボール_初期設置 濡れダンボール 18000 12750 -15000 d:アイテム水飛沫有 3
	//}

	//if($w:アイテム数[ d:アイテム:サーマルゴーグル ] == 0){
		@サーマルゴーグル_初期設置 サーマルゴーグル 750 27500 -13000 d:アイテム水飛沫有
	//}

	if( $w:タンカー編クリア回数 >= 1 ) {
		@ＵＳＰサプレッサ_初期設置 ＵＳＰサプレッサ -750 24000 -13250 d:アイテム水飛沫無
	}

	@アイテム再セットチェック $b:w00c_取得ロード回数[1]
	if ($f:再セットフラグ) {
		#if 1
			@レーション_初期設置 レーション１ -11500 12000 (-17750-1000) d:アイテム水飛沫有 // 階段下に置こうと思ったら駄目だった
		#else
			@スタン_初期設置 スタン１ -11500 12000 (-17750-1000) d:アイテム水飛沫有 // 階段下に置こうと思ったら駄目だった
			@スタン_初期設置 スタン２ -11500 12000 (-17750-1250) d:アイテム水飛沫有 // 階段下に置こうと思ったら駄目だった
		#endif
	}
}
/**************************************************************************************************/
// 気絶オルガ
/**************************************************************************************************/

proc オルガ引きずりセット {
	if( $f:オルガ失踪 == 0 ){
		if( $f:w00b_オルガ柵によりかかり == 0 ) {
			chara 死体君 オルガ気絶 \
				-m org_sgl \
				-d 1 \	// 仰向け
				-p -13838,12750,-18139 \
				-r 0,0,0 \
				-s ( d:CORPS_ST_SPRAY | d:CORPS_ST_EVM | d:CORPS_ST_ZZZ | d:CORPS_ST_LIVE ) \
				-e org_def_sleepface \
				-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
				-b rt_オルガ死体撃ちやがった \
				-j ドッグタグ_敵兵	[ dogtag:tnk_w00c_olga_ve ] \
									[ dogtag:tnk_w00c_olga_ea ] \
									[ dogtag:tnk_w00c_olga_no ] \
									[ dogtag:tnk_w00c_olga_ha ] \
									[ dogtag:tnk_w00c_olga_vh ]

			chara プットアタッチコントロール オルガ装備品 \
				-ctrl   オルガ気絶 \
				-atid	2 \
				-flag	0x00010003

		} else {
			chara 死体君 オルガ気絶 \
				-m org_sgl \
				-d 1 \	// 仰向け
				-p -15996,12750,-13835 \
				-r 0,1024,0 \
				-s ( d:CORPS_ST_SPRAY | d:CORPS_ST_EVM | d:CORPS_ST_ZZZ | d:CORPS_ST_LIVE ) \
				-e org_def_sleepface \
				-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
				-b rt_オルガ死体撃ちやがった \
				-j ドッグタグ_敵兵	[ dogtag:tnk_w00c_olga_ve ] \
									[ dogtag:tnk_w00c_olga_ea ] \
									[ dogtag:tnk_w00c_olga_no ] \
									[ dogtag:tnk_w00c_olga_ha ] \
									[ dogtag:tnk_w00c_olga_vh ]
			chara プットアタッチコントロール オルガ装備品 \
				-ctrl   オルガ気絶 \
				-atid	2 \
				-flag	0x00010003
		}

		trap ev102 d:PLAYER -mask 入る \
			-exec {
				mesg プットアタッチコントロール オルガ装備品 殺す

				chara delay 装備解除用ディレイ -time 1 -exec {
					mesg 死体君 オルガ気絶 kill
					command カメラチェックキャラ削除 -name オルガ気絶
				}
		}
	}

}

/**************************************************************************************************/
// 飛び降り死亡
/**************************************************************************************************/

proc 飛び降り死亡 {
	trap dive_dead d:PLAYER \
		-mask 入る \
		-exec {
			print 'ダイビングデッド'
			chara カメラ設定 シナリオカメラ \
				-c 1 \
				-p $i:カメラＸ位置 $i:カメラＹ位置 $i:カメラＺ位置 \
				-t $i:注視点Ｘ位置 $i:注視点Ｙ位置 $i:注視点Ｚ位置 \
				-a 200 \
				-i 1 1 0 0 \
				-s 1 \
		}
}

