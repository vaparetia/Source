proc 各種カメラ作成 {
	chara カメラ ステージカメラ		-c 0 -l 3 -p 0
	chara カメラ ロードカメラ強		-c 0 -l 2 -p 0
	chara カメラ ロードカメラ		-c 0 -l 2 -p 5
	chara カメラ シナリオカメラ		-c 0 -l 2 -p 10
	chara カメラ モーションカメラ強	-c 0 -l 2 -p 20
	chara カメラ モーションカメラ	-c 0 -l 2 -p 30
	chara カメラ 通路カメラ０		-c 0 -l 2 -p 40
	chara カメラ 通路カメラ１		-c 0 -l 2 -p 50
	chara カメラ サブカメラ０		-c 0 -l 2 -p 60
	chara カメラ サブカメラ１		-c 0 -l 2 -p 70
	chara カメラ サブカメラ２		-c 0 -l 2 -p 80


}

// デフォルトカメラ
//----------------------------------------------
proc デフォルトカメラセット {
	chara カメラ設定 ステージカメラ \
		-c 0 \
		-b -32000,-32000,-32000 32000,32000,32000 \
		-l -32000,-32000,-32000 32000,32000,32000 \
		-r 320,2048,0 \
		-f 9000 \
		-a 200 \
		-i 1 -1 0 0 \
		-s 1
}


proc 中央下層カメラ {
	trap c100 d:PLAYER -mask ＊ \
		-camera \
		-exec {
			if( 14000 > $5 ) {
				if( $3 == 入る ) {
					@船内映り込みＯＦＦ
				} else if( $3 == 出る ) {
					@船内映り込みＯＮ
				}
			}

			chara カメラ設定 通路カメラ０ \
				-c 0 \
				-z d:CAMERA_NO_CUSHION \
				-b -20000,-20000,-20000  20000,20000,-4667 \
				-l -20000,-20000,-20000  20000,20000,-9249 \
				-r 550,2048,0 -f 6893 \
				-a 200 \
				-i 3 -1 0 0 \
				-s $3
		}
}

