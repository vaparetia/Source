/**************************************************************************************************/
// オブジェクト関連のON/OFF
/**************************************************************************************************/
proc ５０ｃｍ隙間壁 {

	@南北５０ｃｍ幅透明壁設置 西５０ｃｍ壁 -10500 12000 -19850 2000
	@南北５０ｃｍ幅透明壁設置 東５０ｃｍ壁 -9450 12000 -19850 2000

	trap wallto:01 d:PLAYER \
		-mask ？ \
		-state d:TRP_STATE_CAUTION \
		-exec {
				if( $3 == 入る ) {
					mesg 透明壁 西５０ｃｍ壁 off
					mesg 透明壁 東５０ｃｍ壁 off
				}else{
					mesg 透明壁 西５０ｃｍ壁 on
					mesg 透明壁 東５０ｃｍ壁 on
				}
		}
}

proc 鉄箱_木箱セット {
	chara プットオブジェ 鉄箱１ -m obs_box3 -r 0 1024 0 \
		-p -10000 12000 -18700 -l d:MAP_NAME
	chara プットオブジェ 鉄箱２ -m obs_box3 -r 0    0 0 \
		-p -10000 12000 -17600 -l d:MAP_NAME
	chara プットオブジェ 木箱１ -m obs_box4 -r 0 1024 0 \
		-p -10000 12000 -16000 -l d:MAP_NAME
	chara プットオブジェ 木箱２ -m obs_box4 -r 0 1024 0 \
		-p -10000 12000 -14900 -l d:MAP_NAME
	chara プットオブジェ 鉄箱３ -m obs_box3 -r 0 -200 0 \
		-p -10200 13100 -16900 -l d:MAP_NAME
	chara プットオブジェ 鉄箱４ -m obs_box3 -r 0  350 0 \
		-p -10000 13100 -18200 -l d:MAP_NAME

	chara プットオブジェ 木箱３ -m obs_box4 -r 0 1024 0 \
		-p -11300 12000 -12000 -l d:MAP_NAME
	chara プットオブジェ 木箱４ -m obs_box4 -r 0 1024 0 \
		-p -10200 12000 -11800 -l d:MAP_NAME
	chara プットオブジェ 鉄箱５ -m obs_box3 -r 0  800 0 \
		-p -10600 13100 -12200 -l d:MAP_NAME

/* オルガ戦階段前に追加分 */
	chara プットオブジェ 鉄箱６ -m obs_box3 -r 0 (1024/6) 0 \
		-p -11300 12000 -15000 -l d:MAP_NAME
}

proc 船首オブジェセット {
	chara プットオブジェ 船首１ -m w00_f1 -r 0 0 0 \
