						} else {				// 腰が水平に位置する場合
							command はしご設定 -e d:モーションリスト:ladder_hold_l_e 0,25000,-11950 2048
						}
						mesg プレイヤー d:PLAYER ladder
					}
				}
	}

/////////////////////
// ３階
	proc はしご第三層部、乗り降り時カメラ {
		trap la003 d:PLAYER mask ？ \
			-state d:TRP_STATE_FORCE \
