/**************************************************************************************************/
proc クルクルドアセット {

	chara 水密ドア管理 ドア管理人 -n 2 \
		-seno 1 \
		-motions sna_hatch hatch_door_sna hatch_handle_sna
		//-adjusts 10,50 0,0 0,50 0,50

	///////////////////////////
	// 左舷水密ドア
	//if( $f:オルガ失踪 == 0 ){
	if( $s:登場ポイント == w01e左舷から来た ) {
		eval( $i:ローカル変数Ｉ１ = d:WT_DOOR_FLAG_OPEN_START )
	}else{
		eval( $i:ローカル変数Ｉ１ = d:WT_DOOR_FLAG_NORMAL )
	}

	chara 水密ドア 水密君_左 \
			-kms w00_sdr_l w00_sdr_handle \
			-position -5950,12000,-16525 \
			-rotate 0,3072,0 \
			-type 0 \	// 左軸
			-flag $i:ローカル変数Ｉ１ \
			-hazard -6000 12000 -16750 -6000 12000 -15000 \
			-proc 左舷ロード_艦橋内への移動

	trap dr000 d:PLAYER \
		-mask いる \
		-button d:ACTION_BUTTON \
		-state 0 \
		-exec {
			command 水密ドア状態 -n 水密君_左
			mesg プレイヤー d:PLAYER wt_door 水密君_左 $status 1024,3560 -5950,-16525
		}

	// 水密ドアモーション中のカメラ
	trap dr000a d:PLAYER \
		-mask ？ \
		-state 6 \
		-exec {
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p -8978,15124,-13611 -t -6113,13568,-15589 \
				-r 274,1418,0 -f 3814 \
				-a 200 \
				-i 1 -1 0 0 \
				-s $3
		}

	// ステージ開始時のカメラ
	trap ld000 d:PLAYER \
		-mask ？ \
		-exec {
			if( $f:ロードチェックＯＮフラグ == 0 ) {
				chara カメラ設定 ロードカメラ \
					-c 1 \
					-p -8978,15124,-13611 -t -6113,13568,-15589 \
					-r 274,1418,0 -f 3814 \
					-a 200 \
					-i 3 3 0 0 \
					-s $3
			}
		}

	////////////////////////////
	// 右舷水密ドア
	if( $s:登場ポイント == w01e右舷から来た ) {
		eval( $i:ローカル変数Ｉ１ = d:WT_DOOR_FLAG_OPEN_START )
	} else {
		eval( $i:ローカル変数Ｉ１ = d:WT_DOOR_FLAG_NORMAL )
	}

	chara 水密ドア 水密君_右 \
			-kms w00_sdr_r w00_sdr_handle \
			-position 5950,12000,-16525 \
			-rotate 0,3072,0 \
			-type 1 \	// 右軸
			-hazard 6000 12000 -16750 6000 12000 -15000 \
			-flag $i:ローカル変数Ｉ１ \
			-proc 右舷ロード_艦橋内への移動

	trap dr001 d:PLAYER \
		-mask いる \
		//-button 0 \
		-button d:ACTION_BUTTON \
		-state 0 \
		-exec {
			command 水密ドア状態 -n 水密君_右
			mesg プレイヤー d:PLAYER wt_door 水密君_右 $status 3072,512 5950,-16525
		}


	// 水密ドアモーション中のカメラ
	trap dr001a d:PLAYER \
		-mask ？ \
		-state 6 \
		-exec {
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p 10705,16044,-11424 -t 6600,13578,-15952 \
				-r 250,2528,0 -f 6590 \
				-a 200 \
				-i 2 2 0 0 \
				-s $3
		}

	// ステージ開始時のカメラ
	trap ld001 d:PLAYER \
		-mask ？ \
		-exec {
			if( $f:ロードチェックＯＮフラグ == 0 ) {
				chara カメラ設定 ロードカメラ \
					-c 1 \
					-p 10705,16044,-11424 -t 6600,13578,-15952 \
					-r 250,2528,0 -f 6590 \
					-a 200 \
					-i 3 3 0 0 \
					-s $3
			}
		}
}

/**************************************************************************************************/
// 入出トラップ
/**************************************************************************************************/
// このプロック名は予約。
/*
proc ロードプロック {
	if ($s:呼び出しプロック == mv_w00c_w01e_0) {
		if($w:アラートモード != d:ALERT_MODE_SENNYU ) {
			command セットサウンドコード -c d:SNG_FOUTS_S
		}
		@mv_w00c_w01e_0
	}else if ($s:呼び出しプロック == mv_w00c_w01e_1) {
		if($w:アラートモード != d:ALERT_MODE_SENNYU ) {
			command セットサウンドコード -c d:SNG_FOUTS_S
		}
		@mv_w00c_w01e_1
	}
}
*/
proc ロードプロック {
#if d:FORCED_SNEEZE
	@タンカー風邪引き判定	//stdproc.hの中
#endif

	if ($s:呼び出しプロック == mv_w00c_w01e_0) {
		if($w:アラートモード != d:ALERT_MODE_SENNYU ) {
			command セットサウンドコード -c d:SNG_FOUTS_S
		}
		@mv_w00c_w01e_0
	}else if ($s:呼び出しプロック == mv_w00c_w01e_1) {
		if($w:アラートモード != d:ALERT_MODE_SENNYU ) {
			command セットサウンドコード -c d:SNG_FOUTS_S
		}
		@mv_w00c_w01e_1
	}
}

// 艦橋内へのロード
proc 左舷ロード_艦橋内への移動 $:トリガ $:実行キャラ {
	// 開いたとき
	if ( $:トリガ == 0 && $:実行キャラ == d:PLAYER ) {
		chara カメラ設定 ロードカメラ強 \
				-c 1 \
				-p -8978,15124,-13611 -t -6113,13568,-15589 \
				-r 274,1418,0 -f 3814 \
				-a 200 \
				-i 3 3 0 0 \
				-s 1
/*
		if($w:アラートモード != d:ALERT_MODE_SENNYU ) {
			mesg サウンドマネージャー ＳＤマネ SD_CODE d:SNG_FOUTS_S
		}
*/
		preseek 'w01e'
		@ステージ終了時処理（ステージ名表示） -4750 12000 -16500 1024 \
						mv_w00c_w01e_0 d:M_TYPE:RUN_CHANGE d:wn_船橋五階操舵室

		if( $f:オルガ失踪 == 0 ){
			eval( $f:オルガ失踪 = 1 )
		}
	}
}


proc 右舷ロード_艦橋内への移動 $:トリガ $:実行キャラ {
	// 開いたとき
	if ( $:トリガ == 0 && $:実行キャラ == d:PLAYER ) {
		chara カメラ設定 ロードカメラ強 \
				-c 1 \
				-p 10868,16119,-12402 -t 7915,14154,-14887 \
				-r 307,2616,0 -f 4331 \
				-a 200 \
				-i 3 3 0 0 \
				-s 1
/*
		if($w:アラートモード != d:ALERT_MODE_SENNYU ) {
			mesg サウンドマネージャー ＳＤマネ SD_CODE d:SNG_FOUTS_S
		}
*/
		preseek 'w01e'
		@ステージ終了時処理（ステージ名表示） 4750 12000 -16500 3072 \
						mv_w00c_w01e_1 d:M_TYPE:RUN_CHANGE d:wn_船橋五階操舵室

		if( $f:オルガ失踪 == 0 ){
			eval( $f:オルガ失踪 = 1 )
		}
	}
}

/**************************************************************************************************/
// プレイヤー
/**************************************************************************************************/
proc プレイヤーセット {

	if ( $f:オルガ失踪 == 0 ) {
		if( $f:w00b_オルガ柵によりかかり == 0 ) {
			eval( $i:プレイヤー初期Ｘ位置 = -15294 )
			eval( $i:プレイヤー初期Ｙ位置 = 13750 )
			eval( $i:プレイヤー初期Ｚ位置 = -18578 )
			eval( $i:プレイヤー初期方向 = 1024 )
		} else {
			eval( $i:プレイヤー初期Ｘ位置 = -14410 )
			eval( $i:プレイヤー初期Ｙ位置 = 13750 )
			eval( $i:プレイヤー初期Ｚ位置 = -13420 )
			eval( $i:プレイヤー初期方向 = 3072 )
		}
	}

	if( $s:登場ポイント == w00bから来た ) {
		print '体力 MAX'
		eval($w:体力 = $w:体力最大)
	}

	chara プレイヤー スネーク \
		-m sna_def \
		-a snake \
		-p $i:プレイヤー初期Ｘ位置 $i:プレイヤー初期Ｙ位置 $i:プレイヤー初期Ｚ位置 \
		-d 0,$i:プレイヤー初期方向,0 \
		-l 4000 \
		-f 0x00000001 \
		-s 0 \
		-o sna_w00c

	chara ロープモデル３ バンダナ１ \
		-n sna_bdn1 \
		-d 1 \
		-y スネーク \
		-z 12 \
		-x 0,60,-90 \
		-m 12 \
		-p 250 \
		-k 350 \
		-o 110 \
		-f 1

	chara ロープモデル３ バンダナ２ \
		-n sna_bdn2 \
		-d 1 \
		-y スネーク \
		-z 12 \
		-x 0,50,-90 \
		-m 22 \
		-p 250 \
		-k 350 \
		-o 110 \
		-f 1

	@プレイヤーＬＯＤ設定 d:C_DISTANCE_TYPE 6000

	// ハシゴモード基本セット。プレイヤーの後に記述すること。
	command プラグインはしご

	command はしご設定 \
		-l 16500,28480 \
		-b	d:モーションリスト:ladder_idle \
			d:モーションリスト:ladder_idle_l \
			d:モーションリスト:ladder_up \
			d:モーションリスト:ladder_down \
			d:モーションリスト:sna_non_ladder_dam_r \	// はしごダメージ右手上
			d:モーションリスト:sna_non_ladder_dam_l \	// はしごダメージ左手上
			d:モーションリスト:sna_non_ladder_dam_fall_r_start \	// はしご落下開始
			d:モーションリスト:sna_non_ladder_dam_fall_l_start \	// はしご落下開始
			d:モーションリスト:sna_non_ladder_dam_fall_loop \		// はしご落下ルー
			d:モーションリスト:sna_non_ladder_dam_fall_end \		// はしご落下終了
		-s	d:モーションリスト:ladder_up_c_s   0,16030,-11850 2048 \
		-e	d:モーションリスト:ladder_down_c_e 0,16534,-11850 2048

	command 主観射程距離設定 -len 30000
}

/**************************************************************************************************/
// 攻撃兵
/**************************************************************************************************/
proc 攻撃兵Ａ {
	if( $i:プレイヤー位置Ｘ < 0 ) {
		eval( $b:ローカル変数Ｂ１ = 20 )
	} else {
		eval( $b:ローカル変数Ｂ１ = 19 )
	}
	chara アタッカー 攻撃兵:01 \
		-r $b:ローカル変数Ｂ１ \
		-c 31 \
		-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
		-l $w:敵標準体力 \
		-h $w:敵標準聴力 \
		-f $w:敵標準気絶 \
		-s ( d:ENE_STATUS_GUNLIGHT | d:ENE_STATUS_BODYSPLASH ) \
		-e 0 \
		-q レーション_敵兵 15
}

proc 攻撃兵 {
	/*******************************************************************************************/
	// VERYEASY
	/*******************************************************************************************/
	if($w:ゲーム設定 <= d:LEVEL_VERYEASY) {
		@攻撃兵Ａ
	/*******************************************************************************************/
	// EASY
	/*******************************************************************************************/
	} else if($w:ゲーム設定 <= d:LEVEL_EASY) {
		@攻撃兵Ａ
	/*******************************************************************************************/
	// NORMAL
	/*******************************************************************************************/
	} else if($w:ゲーム設定 <= d:LEVEL_NORMAL) {
		@攻撃兵Ａ
	/*******************************************************************************************/
	// HARD or EXTREME or EUROPEAN_EXTREME
	/*******************************************************************************************/
	} else {
		@攻撃兵Ａ
	}
}

/**************************************************************************************************/
// 警備兵
/**************************************************************************************************/
// 部屋に入ってくる兵
proc 警備兵Ａ {
	chara 警備兵 巡回兵１ -r 29 -n 0 \
		-d 9750,12000,-18750 ブリッジ屋上部 \
		-s ( d:ENE_STATUS_GUNLIGHT | d:ENE_STATUS_BODYSPLASH ) \
		-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
		-l $w:敵標準体力 -f $w:敵標準気絶 -h $w:敵標準聴力 \
		-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
		-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
		-j ドッグタグ_敵兵	[ dogtag:tnk_w00c_guard_ve_01 ] \
							[ dogtag:tnk_w00c_guard_ea_01 ] \
							[ dogtag:tnk_w00c_guard_no_01 ] \
							[ dogtag:tnk_w00c_guard_ha_01 ] \
							[ dogtag:tnk_w00c_guard_vh_01 ]
}

// 通常巡回ルート
proc 警備兵Ｂ {
	chara 警備兵 巡回兵１ -r 0 -n 0 \
		-d 9750,12000,-18750 ブリッジ屋上部 \
		-s ( d:ENE_STATUS_GUNLIGHT | d:ENE_STATUS_BODYSPLASH ) \
		-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
		-l $w:敵標準体力 -f $w:敵標準気絶 -h $w:敵標準聴力 \
		-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
		-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
		-j ドッグタグ_敵兵	[ dogtag:tnk_w00c_guard_ve_01 ] \
							[ dogtag:tnk_w00c_guard_ea_01 ] \
							[ dogtag:tnk_w00c_guard_no_01 ] \
							[ dogtag:tnk_w00c_guard_ha_01 ] \
							[ dogtag:tnk_w00c_guard_vh_01 ]
}





proc 警備兵 {
	/*******************************************************************************************/
	// VERYEASY
	/*******************************************************************************************/
	if($w:ゲーム設定 <= d:LEVEL_VERYEASY) {
		if( $f:global_右水密ドア開くイベント == 0 ) {
			@警備兵Ａ
		} else {
			@警備兵Ｂ
		}

	/*******************************************************************************************/
	// EASY
	/*******************************************************************************************/
	} else if($w:ゲーム設定 <= d:LEVEL_EASY) {
		if( $f:global_右水密ドア開くイベント == 0 ) {
			@警備兵Ａ
		} else {
			@警備兵Ｂ
		}
	/*******************************************************************************************/
	// NORMAL
	/*******************************************************************************************/
	} else if($w:ゲーム設定 <= d:LEVEL_NORMAL) {
		if( $f:global_右水密ドア開くイベント == 0 ) {
			@警備兵Ａ
		} else {
			@警備兵Ｂ
		}
	/*******************************************************************************************/
	// HARD or EXTREME or EUROPEAN_EXTREME
	/*******************************************************************************************/
	} else {
		if( $f:global_右水密ドア開くイベント == 0 ) {
			@警備兵Ａ
		} else {
			@警備兵Ｂ
		}
	}
}

/**************************************************************************************************/
// サポート兵
/**************************************************************************************************/
proc サポート兵 {
}

/**************************************************************************************************/
// コマンダー
/**************************************************************************************************/
proc 警備兵コマンダー {
	chara 警備コマンダー wccomm -e {警備兵 /*サポート兵*/}
}

proc 攻撃兵コマンダー {
	chara 攻撃コマンダー atcomm -e 攻撃兵
}

resource ghq_area_alert_voice {
w00c:
	$t{
		t:vc040023,	//「了解。応援部隊、航海甲板へ向かえ。左舷ウィングを固めろ」
		t:vc040024, //「わかった。増援を航海甲板、左舷ウィングへ派遣する。奴を逃がすな！」
		-2,
		t:vc040026, //「わかった。増援を航海甲板、右舷ウィングへ派遣する。奴を逃がすな！」
		t:vc040025, //「了解。応援部隊、航海甲板へ向かえ。右舷ウィングを固めろ」
		-2,
		t:vc040027, //「了解。バックアップ、マスト基部に向かえ。敵を追い込め！」
		t:vc040028, //「わかった。航海甲板に応援部隊を送る。マスト基部を固めろ！」
		-1
	}
}

resource ghq_caution_voice {
w00c:
	$t{
		t:vc04004d, //「了解。航海甲板を増員する。左舷ウィング、警戒強化」
		t:vc04004e, //「わかった。航海甲板、左舷ウィングを増員。警備を強化しろ」
		t:vc04004f, //「了解。航海甲板、増員。右舷ウィングの警備を固めろ」
		t:vc040050, //「わかった。航海甲板、右舷ウィングを増員。警戒を強化しろ」
		t:vc040051, //「了解。航海甲板、マスト基部を増員。警備を強化せよ」
		t:vc040052, //「わかった。航海甲板を増員する。マスト基部の警備を固めろ」
		-2,
		// 連絡が途絶えた時の音声
		t:vc04006f, //「航海甲板との連絡が途絶えた」
		-1	// 全ての登録終了
	}
}

proc 敵兵セット {
	chara コマンダー 敵兵セット \
		-w 警備兵コマンダー \
	#if d:ATTACKER
		-a 攻撃兵コマンダー \
	#endif
		-r  1000,12000,-9500 ブリッジ屋上部 \
		   -5500,12000,-14500 ブリッジ屋上部 \
		    5500,12000,-14500 ブリッジ屋上部  \
		-c -10750 12000 -13250 ブリッジ屋上部 \
		    11250 12000 -15000 ブリッジ屋上部 \
		-b 0 \ // 生き返る敵兵数
		-z $i:敵標準麻酔持続 \
		-h $i:標準警戒時間 \
		-o $i:敵標準気絶持続 \
		-x [ghq_area_alert_voice:w00c] \
		-y [ghq_caution_voice:w00c] \
		-v [ene_tank_voice:01] \
		-g 0

	if( $f:global_右水密ドア開くイベント == 0 ) {
		mesg 敵兵共通 巡回兵１ 永久アンリアルＯＮ
	}
}


/***************************************************************************************************/
// ルート変更
/***************************************************************************************************/
proc ルート変更 {
	#if d:ATTACKER
	// アタッカーの待機所変更
	trap en006 d:PLAYER \
		-mask 出る \
		-exec {
			if( $4 < 0 ){
				mesg アタッカー 攻撃兵:01 ルート変更 20
				mesg コマンダー 敵兵セット 待機所替え 1
			}else{
				mesg アタッカー 攻撃兵:01 ルート変更 19
				mesg コマンダー 敵兵セット 待機所替え 0
			}
		}

	// 最初の待機所を決定する
	chara delay 待機所決定ディレイ -time 1 -exec {
		if( $s:登場ポイント == w00bから来た ) {
			mesg アタッカー 攻撃兵:01 ルート変更 20
			mesg コマンダー 敵兵セット 待機所替え 1
		} else if( $s:登場ポイント == w01e左舷から来た ) {
			mesg アタッカー 攻撃兵:01 ルート変更 20
			mesg コマンダー 敵兵セット 待機所替え 1
		} else if( $s:登場ポイント == w01e右舷から来た ) {
			mesg アタッカー 攻撃兵:01 ルート変更 19
			mesg コマンダー 敵兵セット 待機所替え 0
		}
	}
	#endif
}

/***************************************************************************************************/
// 右舷ドアを開ける兵
/***************************************************************************************************/
proc 右舷水密ドア開けるデモ {
	trap en011 d:PLAYER \
		-mask 入る \
		-exec {
			if( $f:global_右水密ドア開くイベント == 0 ) {
				eval( $f:global_右水密ドア開くイベント = 1 )
				mesg 敵兵共通 巡回兵１ 永久アンリアルＯＦＦ
/*
				#if d:VAR_SAVE
					command varsave $f:global_右水密ドア開くイベント
				#endif
*/
				//@シナリオデモスタート
				@シナリオデモ開始処理

				mesg 水密ドア 水密君_右 open

				command ＳＥセットモード -s d:SD_A_MITOPN01 -p 5950,12000,-16525 -m 1

				chara delay ルート変更ディレイ -time 30 -exec {
					mesg 警備兵 巡回兵１ ルート変更 30 9750,12000,-18750 ブリッジ屋上部 0
				}

				chara カメラ設定 シナリオカメラ \
					-c 1 \
					-p 8008,15444,-3933 -t 5592,12824,-8941 \
					-r 287,2341,0 -f 6147 \
					-a 200 \
					-i 1 1 0 0 \
					-s $3

				chara delay ディレイ -time 120 -exec {
					mesg 水密ドア 水密君_右 close
					mesg 警備兵 巡回兵１ ルート変更 0 9750,12000,-18750 ブリッジ屋上部 0
					@カメラＯＦＦ シナリオカメラ
					//@シナリオデモ終了
					@シナリオデモ終了処理
				}
			}
		}
}

/***************************************************************************************************/
// シナリオデモ
/***************************************************************************************************/
	// 共通プロック
	proc シナリオデモスタート {
		mesg コマンダー 敵兵セット 視界オフ
		command パッド操作 -release
		command プレイヤー無敵セット
		mesg シネマスクリーン シネマ フェードアウト 0
		command メニュー設定 -menu off -gage off  -radar off -subwin off
	}

	proc シナリオデモ終了 {
		mesg コマンダー 敵兵セット 視界オン
		command プレイヤー無敵解除
		command パッド操作 -cancel
		mesg シネマスクリーン シネマ フェードイン 0
		command メニュー設定 -menu on -gage on -radar on -subwin on
	}

/**************************************************************************************************/
// 敵兵ルートチェンジセット
/**************************************************************************************************/

proc 敵兵ルートチェンジセット {

	trap ev_rc000 d:PLAYER \
		-mask 出る \
		-dir 3072 256 \
		-exec {
			if( $f:global_右水密ドア開くイベント ) {
				print '周り兵元のルートに戻れ'
				mesg 警備兵 巡回兵１ ルート変更 0 -1750 12000 -8500 ブリッジ屋上部
			}
		}

	// スネークがはしごに登ったら巡回兵を周らせる
	trap la000 d:PLAYER \
		-mask いる \
		//-button 0 \
		-button d:ACTION_BUTTON \
		-state d:TRP_STATE_STAND \
		-exec {
			if( $f:global_右水密ドア開くイベント ) {
				mesg 警備兵 巡回兵１ ルート変更 4 -1750 12000 -8500 ブリッジ屋上部 0
				eval( $f:右回り = 1 )
			}
		}

	// ぐるぐる周りなさい
	trap en001 巡回兵１ \
		-mask 入る \
		-exec {
			command rand 4
			print $status
			if( $f:右回り == 1 ){
				if( $status == 0 ){
					// 左回りに変更
					mesg 警備兵 巡回兵１ ルート変更 6 -1750 12000 -8500 ブリッジ屋上部 0
					eval( $f:右回り = 0 )
				}else if( $status == 1 ){
					// 躊躇うだけ
					mesg 警備兵 巡回兵１ ルート変更 8 -1750 12000 -8500 ブリッジ屋上部 0
				}else{
					// 右回り続行
					mesg 警備兵 巡回兵１ ルート変更 4 -1750 12000 -8500 ブリッジ屋上部 0
				}
			}else{
				if( $status == 0 ){
					// 右回りに変更
					mesg 警備兵 巡回兵１ ルート変更 7 -1750 12000 -8500 ブリッジ屋上部 0
					eval( $f:右回り = 1 )
				}else if( $status == 1 ){
					// 躊躇うだけ
					mesg 警備兵 巡回兵１ ルート変更 9 -1750 12000 -8500 ブリッジ屋上部 0
				}else{
					// 左回り続行
					mesg 警備兵 巡回兵１ ルート変更 5 -1750 12000 -8500 ブリッジ屋上部 0
				}
			}
		}
}


/**************************************************************************************************/
// はしごモード各種セット
/**************************************************************************************************/

//////////////
// 最下層
	proc はしご最下層部、乗り降り時カメラ {
		trap la000 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_FORCE \	// 強制モーション中
			-exec {
				chara カメラ設定 モーションカメラ強 \
					-c 1 \
					-p 1731,18704,-8835 -t 339,16551,-11975 \
					-r 365,2320,0 -f 4054 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3
		}
	}

	proc はしご最下層部、乗り降りモーション {

		// 真下から登る
		trap la000 d:PLAYER \
			-mask いる \
			-button d:ACTION_BUTTON \
			-state d:TRP_STATE_STAND,d:TRP_STATE_LADDER \
			-exec {
				command はしご設定 -s d:モーションリスト:ladder_up_c_s   0,16030,-11850 2048 \
								   -e d:モーションリスト:ladder_down_c_e 0,16534,-11850 2048
				mesg プレイヤー d:PLAYER ladder
		}

		// パッドの下で梯子から降りる
		trap la000 d:PLAYER \
			-mask いる \
			-dir 2048,256 \
			-state d:TRP_STATE_LADDER \
			-exec {
				command パッドチェック -which 0 -status
				if ( $status & d:PAD_D ) {
					command パッド操作 -press d:PAD_X
				}
			}
	}

//////////////
// 一階
	proc はしご第一層部、乗り降り時カメラ {
		trap la001 d:PLAYER mask ？ \
			-state d:TRP_STATE_FORCE \
			-exec {
				chara カメラ設定 モーションカメラ強 \
					-c 1 \
					-p 1198,21020,-9412 -t 118,18981,-12332 \
					-r 378,2279,0 -f 3722 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3
		}
	}

	proc はしご第一層部、乗り降りモーション {

		///////////////////////////////////
		// アクションボタンで登り降りの設定
			trap la001 d:PLAYER \
				-mask 入る \
				-button d:ACTION_BUTTON \
				-state d:TRP_STATE_STAND,d:TRP_STATE_LADDER \
				-exec {
						if( $4 > 0 ) {
						// スネーク位置右側の設定
							if($5 < 18500){			// 腰が下寄りに位置する場合
								command はしご設定 -s d:モーションリスト:ladder_hold_r_s 700,19000,-11950 3072 \
												   -e d:モーションリスト:ladder_up_r_e     250,18000,-11950 2048
							} else if($5 > 19000){	// 腰が上寄りに位置する場合
								command はしご設定 -s d:モーションリスト:ladder_hold_r_s 700,19000,-11950 3072 \
												   -e d:モーションリスト:ladder_down_r_e   250,19500,-11950 2048
							} else {				// 腰が水平に位置する場合
								command はしご設定 -s d:モーションリスト:ladder_hold_r_s 700,19000,-11950 3072 \
												   -e d:モーションリスト:ladder_hold_r_e  250,19000,-11950 2048
							}
						} else {
						// スネーク位置左側の設定
							if($5 < 18500){			// 腰が下寄りに位置する場合
								command はしご設定 -s d:モーションリスト:ladder_hold_l_s -700,19000,-11950 1024 \
												   -e d:モーションリスト:ladder_up_r_e     250,18000,-11950 2048
							} else if($5 > 19000){	// 腰が上寄りに位置する場合
								command はしご設定 -s d:モーションリスト:ladder_hold_l_s -700,19000,-11950 1024 \
												   -e d:モーションリスト:ladder_down_r_e   250,19500,-11950 2048
							} else {				// 腰が水平に位置する場合
								command はしご設定 -s d:モーションリスト:ladder_hold_l_s -700,19000,-11950 1024 \
												   -e d:モーションリスト:ladder_hold_r_e  250,19000,-11950 2048
							}
						}
						mesg プレイヤー d:PLAYER ladder
				}
		/////////////////////////
		// レバーで梯子から降りる時の設定
			// 右側の設定
			trap la001 d:PLAYER \
				-mask 入る \
				-state d:TRP_STATE_LADDER \
				-key d:PAD_R \
				-exec {
					if( !(`command プレイヤー状態取得` & d:PFLAG_SUBJECT) ) {
						if($5 < 18500){			// 腰が下寄りに位置する場合
							command はしご設定 -e d:モーションリスト:ladder_up_r_e     250,18000,-11950 2048
						} else if($5 > 19000){	// 腰が上寄りに位置する場合
							command はしご設定 -e d:モーションリスト:ladder_down_r_e   250,19500,-11950 2048
						} else {				// 腰が水平に位置する場合
							command はしご設定 -e d:モーションリスト:ladder_hold_r_e  250,19000,-11950 2048
						}
						mesg プレイヤー d:PLAYER ladder
					}
				}
			// 左側の設定
			trap la001 d:PLAYER \
				-mask 入る \
				-state d:TRP_STATE_LADDER \
				-key d:PAD_L \
				-exec {
					if( !(`command プレイヤー状態取得` & d:PFLAG_SUBJECT) ) {
						if($5 < 18500){			// 腰が下寄りに位置する場合
							command はしご設定 -e d:モーションリスト:ladder_up_l_e 0,18000,-11950 2048
						} else if($5 > 19000){	// 腰が上寄りに位置する場合
							command はしご設定 -e d:モーションリスト:ladder_down_l_e 0,19500,-11950 2048
						} else {				// 腰が水平に位置する場合
							command はしご設定 -e d:モーションリスト:ladder_hold_l_e 0,19000,-11950 2048
						}
						mesg プレイヤー d:PLAYER ladder
					}
				}
	}

////////////////
