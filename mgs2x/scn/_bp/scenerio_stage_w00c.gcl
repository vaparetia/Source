			-state d:TRP_STATE_STAND,d:TRP_STATE_CAUTION \	//立ち状態or張り付き
			-exec {
					@東向きビヨンド発動 by004 6900 $6 -8750 -6000 ( d:BY_FALL_DEAD | d:BY_NOFOOTSHADOW )
				}

		// ぶら下がり前
		trap by004 d:PLAYER \
			-mask いる \
			-state 6 \
			-dir 1024 256 \	//方向指定
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b -32000,-32000,-32000 32000,32000,32000 \
					-l -32000,-32000,-32000 32000,32000,32000 \
					-r 495,2737,0 -f 5736 \
					-a 200 \
					-i 1 -1 0 0 \
					-s 1
			}

		// ぶら下がり中
		trap by004 d:PLAYER \
			-mask ？ \
			-state 5 \
			-dir 3072 256 \	//方向指定
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b -32000,-32000,-32000 32000,32000,32000 \
					-l -32000,-32000,-32000 32000,32000,32000 \
					-r 195,2902,0 -f 8274 \
					-a 200 \
					-i 3 2 0 0 \
					-s $3
			}
	}

