// レーダー用
#define STAGE_TANKER				1
// 薬莢
#define ENE_T_GOL					1		// タンカー編ゴル兵

#define ENE_SHIELD					1		// 盾兵

// サウンド
#define SOUND						1 		// サウンドオン
#define STAGE_W00C					1		// サウンド用ディファイン

#define	VAR_SAVE					1		// フラグのセーブ

#define	PLAYER 						スネーク


#define ATTACKER					1		// 攻撃兵

#define E3_VIDEO					0 		// E3ビデオ撮影用
#define マスト下で定点警備			1 		// マスト下まで来たら定点警備する

#define MAP_NAME				 	w00c	// w00cのデータでステージ構築。

#define はしご方向キーで乗り降り	1 		// はしごの乗り降り、方向キーでも可能

#define LD_FADEOUT					1
#define STAGE_END					1
#define PAN_CAMERA					1

#define STAGE_W00C					1		//通信機・デジカメ用

