//###################################################################################
//									カメラ
//###################################################################################

	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif

		// カメラ
		//   -c チャンネル番号  -l カメラレベル  -p 優先度
		//
		//   シナリオカメラは最大16個までおける。
		//   チャンネル番号 ：
		//       ０：通常画面 １：小窓
		//   カメラレベル ：
		//       ０：カットインカメラ（主観より強） 強
		//       １：カットインカメラ（主観より弱） ↑
		//       ２：エリアカメラ		   ↓
		//       ３：ステージデフォルトカメラ	   弱
		//   優先度 ：
		//       エリアカメラに有効
		//       数字が小さい程優先度高

		chara カメラ ステージカメラ	-c 0 -l 3 -p 0
		chara カメラ サブカメラ１	-c 0 -l 2 -p 50
		chara カメラ サブカメラ２	-c 0 -l 2 -p 40
		chara カメラ サブカメラ３	-c 0 -l 2 -p 30
		chara カメラ ビヨンドカメラ	-c 0 -l 2 -p 20
		chara カメラ ロードカメラ	-c 0 -l 2 -p 10
		chara カメラ シナリオカメラ	-c 0 -l 2 -p 5
		chara カメラ ゲームオーバーカメラ		-c 0 -l 0 -p 5

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 200,2048,0 \
			-f 8000 \
			-a 200 \
			-i 1 -1 0 0 \
			-s 1

	}

