					@CS_スムーズカメラ昇順 $6 -91500 -58500 -91051 -58394
					eval( $i:補完ＴＺ = $i:CS_結果１ );

				} else {
					@CS_スムーズカメラ昇順 $6 -58500 -42500 34206 34302
					eval( $i:補完ＰＸ = $i:CS_結果１ );

					@CS_スムーズカメラ昇順 $6 -58500 -42500 6107 7904
					eval( $i:補完ＰＹ = $i:CS_結果１ );

					@CS_スムーズカメラ昇順 $6 -58500 -42500 -55036 -41730
					eval( $i:補完ＰＺ = $i:CS_結果１ );


					@CS_スムーズカメラ昇順 $6 -58500 -42500 34206 34302
					eval( $i:補完ＴＸ = $i:CS_結果１ );

					@CS_スムーズカメラ昇順 $6 -58500 -42500 5572 5568
					eval( $i:補完ＴＹ = $i:CS_結果１ );

					@CS_スムーズカメラ昇順 $6 -58500 -42500 -58394 -42103
					eval( $i:補完ＴＺ = $i:CS_結果１ );
				}

				chara カメラ設定 サブカメラ１ \
					-c 1 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN 34714,d:CAM_MAX,-41816 \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN 34369,d:CAM_MAX,-42211 \
					-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ \
					-t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ \
					-a 156 \
					-i 0 -1 0 0 \
					-d 1 \
					-z d:CAMERA_LIMITBOUND_EXIST \	//	ビハインドのためリミットを見る
					-s $3
			}





	}

//###################################################################################
//									 ビヨンド
//###################################################################################

	proc ビヨンド設定 {
	#if d:DEBUG_PRINT
		print '*** Beyond Set ***'
	#endif
	}




//###################################################################################
//									ジャンプ
//###################################################################################

	proc ジャンプ設定 {
	#if d:DEBUG_PRINT
		print '*** Jump Set ***'
	#endif
	}



//###################################################################################
//									ストーリーフラグ
//###################################################################################

	proc ストーリー設定 {
	#if d:DEBUG_PRINT
		print '*** Story Set ***'
	#endif

/*
		// ev002
		trap ev002 d:PLAYER \
			-mask 入る \
			-exec {
				eval($f:フラグ02 = d:TRUE)
			}

		// ev001
		trap ev001 d:PLAYER \
			-mask 入る \
			-exec {
				if(($f:フラグ02 ==  d:TRUE) && ($w:p_story < d:ST:P073_01_R01通路Ａ１無線機デモ１終了)) {
					@rt_P073_01_R01通路Ａ１無線機デモ１
				}
			}
*/
		// ev003
		trap ev003 d:PLAYER \
			-mask	いる \
			-exec {
				//	練習終了しても良いフラグが立っているとき
				if ($b:w43a_刀練習時間終了フラグ == 2) {
					print $b:w43a_刀練習時間終了フラグ
					//	スネークの状態が普通ならば
					if ( `command ＮＰＣスネークの状態` == 0 ) {
						print $b:w43a_刀練習時間終了フラグ
						//	ブレードを持っていないときは
						if ($w:武器 != d:武器:ブレード) {
							eval ($w:プレイヤーフラグ = $w:プレイヤーフラグ | 0x0002 )
							eval ($w:武器 = d:武器:ブレード)
						}
						eval( $b:w43a_刀練習時間終了フラグ = 3)
						if($w:アイテム == d:アイテム:ゴル兵制服){
							@ポリゴンデモロード d:ST:P074_01_P01通路Ａ刀後１ポリゴンデモ１開始
						} else {
							@ポリゴンデモスタート d:ST:P074_01_P01通路Ａ刀後１ポリゴンデモ１開始
						}
					}
				}
			}
	}

	proc ポリデモロードスタート {
		//	レジデント５へ読み替える
		load "w43a" -r 'r_plt5'
	}

	proc 通路Ａ１無線機デモ１終了処理 {
		//	ダンボールを外す
		@ダンボール解除
		//	フェードイン
		chara フェードインアウト フェードイン \
			-i 0,0,0 128 \
			-c 0,0,0 0 \
			-t (d:FADEOUT_TIME/2)

		//	シナリオデモ開始
		@シナリオデモ開始処理

		//	ＢＧＭを鳴らす
		command セットサウンドコード -c d:SNG_PLAY_06

		//	歩いていくライデン
		chara delay 強制移動ディレイ \
			-t 60 \
			-e {
				mesg プレイヤー d:PLAYER run \
					34250 4000 -88000 \
					0 \
					2048 \
					0
			}

		//	デモスタートディレイ
		chara delay ポリゴンデモスタートディレイ \
			-t 120 \
			-e {
print 'AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'
				//	デモキャンセルを通らないようにする
				eval($$f:w43a_デモキャンセル駄目フラグ = d:TRUE)
				//	全てを取り戻す
				command 武器アイテム取り返し
				@ポリゴンデモスタート d:ST:P073_02_P01通路Ａ２ポリゴンデモ１開始
		}

		chara デモキャンセルチェック 歩きライデンデモキャンセル -p 歩きライデンデモ終了処理

	}

	proc 歩きライデンデモ終了処理 {
		if ($$f:w43a_デモキャンセル駄目フラグ == d:FALSE) {
print 'BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB'
			mesg delay 強制移動ディレイ kill
			mesg delay ポリゴンデモスタートディレイ kill
			mesg デモキャンセルチェック 歩きライデンデモキャンセル kill
			//	全てを取り戻す
			command 武器アイテム取り返し
			@ポリゴンデモスタート d:ST:P073_02_P01通路Ａ２ポリゴンデモ１開始
		}
	}

	proc 通路Ａ３無線機デモ２終了処理 {

		eval ($s:登場ポイント = スネーク登場デモ後)
		//	再登場位置を代入
		eval( $i:プレイヤー初期Ｘ位置 =  34250 ) ;
		eval( $i:プレイヤー初期Ｙ位置 =   4000 ) ;
		eval( $i:プレイヤー初期Ｚ位置 = -88000 ) ;
		eval ($i:プレイヤー初期方向   = 1706) ;
		//	次のシナリオデモのため
		eval( $f:デモ再生フラグ = 1);

		//	風邪が直る
		command プレイヤー風邪治し

		//	全てを取り戻す
//		command 武器アイテム取り返し
		//	ブレード追加
		eval ($w:武器最大数Ｒ[d:武器:ブレード] = 1)
		eval ($w:武器弾数Ｒ[d:武器:ブレード]   = 1)
		eval ($w:武器最大数[d:武器:ブレード]   = 1)
		eval ($w:武器弾数[d:武器:ブレード]     = 1)
		//	刀を持たせる
		eval ($w:プレイヤーフラグ = $w:プレイヤーフラグ | 0x0002 )
		eval ($w:武器 = d:武器:ブレード)

		//	ダンボールは外す
		if (	($w:アイテム == d:アイテム:ダンボール) || ($w:アイテム == d:アイテム:ダンボールＢ) || \
				($w:アイテム == d:アイテム:ダンボールＣ) || ($w:アイテム == d:アイテム:ダンボールＤ) || \
				($w:アイテム == d:アイテム:ダンボールＥ)	) {
				eval ($w:アイテム = d:アイテム:素手)
		}

	#if 1
		//	日本語版以降から
		//	フナムシ状態を元へ戻す
		eval ($w:メニューフナムシ状態 = $w:w41a_メニューフナムシ状態)
	#endif

		//	難易度別装備

		//	ベリーイージーのときは武器とレーションフル回復
		if ($w:ゲーム設定 == d:LEVEL_VERYEASY) {
			//	武器を持っていれば
			if ($w:武器弾数Ｒ[ d:武器:Ｍ９ ] != -1) {
				eval ($w:武器弾数Ｒ[ d:武器:Ｍ９ ] = $w:武器最大数Ｒ[ d:武器:Ｍ９ ])
			}
/*
			//	ＵＳＰはスネークのみ
			if ($w:武器弾数Ｒ[ d:武器:ＵＳＰ ] != -1) {
				eval ($w:武器弾数Ｒ[ d:武器:ＵＳＰ ] = $w:武器最大数Ｒ[ d:武器:ＵＳＰ ])
			}
*/
			if ($w:武器弾数Ｒ[ d:武器:ソコム ] != -1) {
				eval ($w:武器弾数Ｒ[ d:武器:ソコム ] = $w:武器最大数Ｒ[ d:武器:ソコム ])
			}
			if ($w:武器弾数Ｒ[ d:武器:ＰＳＧ１ ] != -1) {
				eval ($w:武器弾数Ｒ[ d:武器:ＰＳＧ１ ] = $w:武器最大数Ｒ[ d:武器:ＰＳＧ１ ])
			}
			if ($w:武器弾数Ｒ[ d:武器:ＲＧＢ６ ] != -1) {
				eval ($w:武器弾数Ｒ[ d:武器:ＲＧＢ６ ] = $w:武器最大数Ｒ[ d:武器:ＲＧＢ６ ])
			}
			if ($w:武器弾数Ｒ[ d:武器:ニキータ ] != -1) {
				eval ($w:武器弾数Ｒ[ d:武器:ニキータ ] = $w:武器最大数Ｒ[ d:武器:ニキータ ])
			}
			//	スティンガーは必ず持っている（持ってない場合はここであげる）
			eval ($w:武器弾数Ｒ[ d:武器:スティンガー ] = $w:武器最大数Ｒ[ d:武器:スティンガー ])

			if ($w:武器弾数Ｒ[ d:武器:クレイモア ] != -1) {
				eval ($w:武器弾数Ｒ[ d:武器:クレイモア ] = $w:武器最大数Ｒ[ d:武器:クレイモア ])
			}
			if ($w:武器弾数Ｒ[ d:武器:Ｃ４ ] != -1) {
				eval ($w:武器弾数Ｒ[ d:武器:Ｃ４ ] = $w:武器最大数Ｒ[ d:武器:Ｃ４ ])
			}
			if ($w:武器弾数Ｒ[ d:武器:チャフ ] != -1) {
				eval ($w:武器弾数Ｒ[ d:武器:チャフ ] = $w:武器最大数Ｒ[ d:武器:チャフ ])
			}
			if ($w:武器弾数Ｒ[ d:武器:スタン ] != -1) {
				eval ($w:武器弾数Ｒ[ d:武器:スタン ] = $w:武器最大数Ｒ[ d:武器:スタン ])
			}
			if ($w:武器弾数Ｒ[ d:武器:マイク ] != -1) {
				eval ($w:武器弾数Ｒ[ d:武器:マイク ] = $w:武器最大数Ｒ[ d:武器:マイク ])
			}
			if ($w:武器弾数Ｒ[ d:武器:ブレード ] != -1) {
				eval ($w:武器弾数Ｒ[ d:武器:ブレード ] = $w:武器最大数Ｒ[ d:武器:ブレード ])
			}
			if ($w:武器弾数Ｒ[ d:武器:凍結スプレー ] != -1) {
				eval ($w:武器弾数Ｒ[ d:武器:凍結スプレー ] = $w:武器最大数Ｒ[ d:武器:凍結スプレー ])
			}
			if ($w:武器弾数Ｒ[ d:武器:ＡＫＳ ] != -1) {
				eval ($w:武器弾数Ｒ[ d:武器:ＡＫＳ ] = $w:武器最大数Ｒ[ d:武器:ＡＫＳ ])
			}
			if ($w:武器弾数Ｒ[ d:武器:マガジン ] != -1) {
				eval ($w:武器弾数Ｒ[ d:武器:マガジン ] = $w:武器最大数Ｒ[ d:武器:マガジン ])
			}
			if ($w:武器弾数Ｒ[ d:武器:グレネード ] != -1) {
				eval ($w:武器弾数Ｒ[ d:武器:グレネード ] = $w:武器最大数Ｒ[ d:武器:グレネード ])
			}
			if ($w:武器弾数Ｒ[ d:武器:Ｍ４ ] != -1) {
				eval ($w:武器弾数Ｒ[ d:武器:Ｍ４ ] = $w:武器最大数Ｒ[ d:武器:Ｍ４ ])
			}
			if ($w:武器弾数Ｒ[ d:武器:ＰＳＧ１−Ｔ ] != -1) {
				eval ($w:武器弾数Ｒ[ d:武器:ＰＳＧ１−Ｔ ] = $w:武器最大数Ｒ[ d:武器:ＰＳＧ１−Ｔ ])
			}
/*
			//	特殊マイクはデモのみ
			if ($w:武器弾数Ｒ[ d:武器:特殊マイク ] != -1) {
				eval ($w:武器弾数Ｒ[ d:武器:特殊マイク ] = $w:武器最大数Ｒ[ d:武器:特殊マイク ])
			}
*/
			if ($w:武器弾数Ｒ[ d:武器:雑誌 ] != -1) {
				eval ($w:武器弾数Ｒ[ d:武器:雑誌 ] = $w:武器最大数Ｒ[ d:武器:雑誌 ])
			}

			//	レーションをフル回復
			eval ($w:アイテム数Ｒ[ d:アイテム:レーション ] = $w:アイテム最大数Ｒ[ d:アイテム:レーション ])

		//	イージーのときはスティンガーとレーションのみフル回復
		} else if ($w:ゲーム設定 == d:LEVEL_EASY) {
			//	スティンガーは必ず持っている（持ってない場合はここであげる）
			eval ($w:武器弾数Ｒ[ d:武器:スティンガー ] = $w:武器最大数Ｒ[ d:武器:スティンガー ])
			//	レーションをフル回復
			eval ($w:アイテム数Ｒ[ d:アイテム:レーション ] = $w:アイテム最大数Ｒ[ d:アイテム:レーション ])

		//	ノーマルのときはスティンガーのみフル回復
		} else if ($w:ゲーム設定 == d:LEVEL_NORMAL) {
			//	スティンガーは必ず持っている（持ってない場合はここであげる）
			eval ($w:武器弾数Ｒ[ d:武器:スティンガー ] = $w:武器最大数Ｒ[ d:武器:スティンガー ])

		//	ハードのときはスティンガーのみ１部回復
		} else if ($w:ゲーム設定 == d:LEVEL_HARD) {
			//	スティンガーを持っていない人、１０発未満の人は
			if ($w:武器弾数Ｒ[ d:武器:スティンガー ] < 10) {
				eval ($w:武器弾数Ｒ[ d:武器:スティンガー ] = 10)
			}

		//	エクストリームのときはスティンガーのみ１部回復
		} else {
			//	スティンガーを持っていない人、５発未満の人は
			if ($w:武器弾数Ｒ[ d:武器:スティンガー ] < 5) {
				eval ($w:武器弾数Ｒ[ d:武器:スティンガー ] = 5)
			}
		}

		@ポリゴンデモスタート d:ST:P073_03_R02通路Ａ３無線機デモ２終了
	}



//###################################################################################
//									デモ設定
//###################################################################################

	proc 刀説明デモ設定 {
		if ($s:登場ポイント ==  スネーク登場デモ後) {
			eval ($w:p_story = d:ST:P073_05_S01通路Ａ５シナリオデモ１開始)
//			chara デバッグポーズ 刀説明デモポーズ "BLADE_EXPLANATION_DEMO" -p 刀説明デモ終了処理
/*
Vc122307
スネーク　「今のうちに使いこなせるようにしておけ」
Vc122308
スネーク　「ライデン、ブレード刀の練習はしなくていいのか？」
Vc122309
スネーク　「練習はもういいだろう。そろそろ行くぞ」
*/

#if 1
			//	シナリオデモ開始
			@シナリオデモ開始処理
	#if 0
			command パッド操作 \
				-cancel
	#endif
			//	振り向くライデン
			chara パッドデモ 振り向きデモライデン \
				-file  w43a_paddemo

			chara カメラ設定 シナリオカメラ \
				-c 1 \
				-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
				-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
				-p 34613,5363,-88906 -t 34376,5236,-87768 \
				-r 71,3962,0 -f 1170 \
//				-p 35292,6260,-90139 -t 34061,5279,-87128 \
//				-r 191,3843,0 -f 3398 \
				-a 156 \
				-i 0 -1 0 0 \
				-s 1 \
				-z d:CAMERA_NO_CUSHION

			mesg パッドデモ 振り向きデモライデン start

	#if 1
			chara delay 説明開始ディレイ \
				-t 40 \
				-e {
					chara カメラ設定 シナリオカメラ \
						-c 1 \
						-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
						-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
						-p 34800,5006,-83861 -t 34254,4904,-86719 \
						-a 200 \
						-i 0 -1 0 0 \
						-s 1 \
						-z d:CAMERA_NO_CUSHION

		#if 1
					//	説明ストリーム再生
					@刀説明１開始
		#endif
				}
	#endif
		#if 1
			//	デモキャンセル
			chara デモキャンセルチェック 刀説明デモキャンセルチェック -p 刀説明デモ終了処理
		#endif
#endif

		}
	}

	proc 刀説明１開始 {
		//	スネーク　「右スティックを上下に振れば上下に斬り、左右に動かせば水平になぎ払う」
		eval ( $i:STREAM_ID = `%Stream d:_vc122301 -p 縦斬り１開始` )
		chara delay ディレイ -time 1 -exec{
			if($i:STREAM_ID < 0){
				eval ( $i:STREAM_ID = `%Stream d:_vc122301 -p 縦斬り１開始` )
				return 1
			}else{
				return 0
			}
		}
	}
	proc 縦斬り１開始 {
		//	エフェクトオンにする
		command ブレードエフェクトオン

		mesg プレイヤー d:PLAYER motion \
			d:モーションリスト:tategiri_1 \		//	縦斬り１〜３でひとつ
			0 \
			0 \
			0 \
			d:FA_NO_INTERP

		command	強制モーション終了プロック \
			-motion d:モーションリスト:tategiri_1 \
			-proc 縦斬り２開始

		//	説明文表示
	//	イギリス
	if ($w:言語 == d:LANG_ENGLISH_ENGLAND) {
		@説明テクスチャ表示 刀説明 act_telop8_alp_ovl 150
	//	フランス
	} else  if ($w:言語 == d:LANG_FRENCH) {
		@説明テクスチャ表示 刀説明 act_telop08_fr_alp_ovl 150
	//	ドイツ
	} else  if ($w:言語 == d:LANG_GERMANY) {
		@説明テクスチャ表示 刀説明 act_telop08_de_alp_ovl 150
	//	イタリア
	} else  if ($w:言語 == d:LANG_ITALY) {
		@説明テクスチャ表示 刀説明 act_telop08_it_alp_ovl 150
	//	スペイン
	} else  if ($w:言語 == d:LANG_SPANISH) {
		@説明テクスチャ表示 刀説明 act_telop08_es_alp_ovl 150
	// 日本
	} else  if ($w:言語 == d:LANG_JAPANESE) {
		@説明テクスチャ表示 刀説明 act_telop08_jp_alp_ovl 150
	}

	}
	proc 縦斬り２開始 {
		//	エフェクトオンにする
		command ブレードエフェクトオン

		mesg プレイヤー d:PLAYER motion \
			d:モーションリスト:tategiri_2 \		//	縦斬り１〜３でひとつ
			0 \
			0 \
			0 \
			0

		command	強制モーション終了プロック \
			-motion d:モーションリスト:tategiri_2 \
			-proc 縦斬り３開始
	}
	proc 縦斬り３開始 {
		//	エフェクトオンにする
		command ブレードエフェクトオン

		mesg プレイヤー d:PLAYER motion \
			d:モーションリスト:tategiri_3 \		//	縦斬り１〜３でひとつ
			0 \
			0 \
			0 \
			0

		command	強制モーション終了プロック \
			-motion d:モーションリスト:tategiri_3 \
			-proc 横斬り１開始
	}
	proc 横斬り１開始 {
		chara delay 横斬り１開始ディレイ \
			-t 5 \
			-e {
				//	エフェクトオンにする
				command ブレードエフェクトオン

				//	横斬り
				mesg プレイヤー d:PLAYER motion \
					d:モーションリスト:yokogiri_1 \		//	横斬り１〜３でひとつ
					0 \
					0 \
					0 \
					0
			}
		command	強制モーション終了プロック \
			-motion d:モーションリスト:yokogiri_1 \
			-proc 横斬り２開始
	}
	proc 横斬り２開始 {
		//	エフェクトオンにする
		command ブレードエフェクトオン

		mesg プレイヤー d:PLAYER motion \
			d:モーションリスト:yokogiri_2 \		//	横斬り１〜３でひとつ
			0 \
			0 \
			0 \
			0

		command	強制モーション終了プロック \
			-motion d:モーションリスト:yokogiri_2 \
			-proc 横斬り３開始
	}
	proc 横斬り３開始 {
		//	エフェクトオンにする
		command ブレードエフェクトオン

		mesg プレイヤー d:PLAYER motion \
			d:モーションリスト:yokogiri_3 \		//	横斬り１〜３でひとつ
			0 \
			0 \
			0 \
			0

		command	強制モーション終了プロック \
			-motion d:モーションリスト:yokogiri_3 \
			-proc 刀説明２開始
	}



	proc 刀説明２開始 {
		//	スネーク　「一回転させれば回転斬り」
		eval ( $i:STREAM_ID = `%Stream d:_vc122302 -p 回転斬り開始` )
		chara delay ディレイ -time 1 -exec{
			if($i:STREAM_ID < 0){
				eval ( $i:STREAM_ID = `%Stream d:_vc122302 -p 回転斬り開始` )
				return 1
			}else{
				return 0
			}
		}
	}
	proc 回転斬り開始 {
		//	エフェクトオンにする
		command ブレードエフェクトオン

		//	回転斬り
		mesg プレイヤー d:PLAYER motion \
			d:モーションリスト:kaitengiri \
			0 \
			0 \
			0 \
			d:FA_NO_INTERP

		command	強制モーション終了プロック \
			-motion d:モーションリスト:kaitengiri \
			-proc 刀説明３開始

		//	説明文表示
	//	イギリス
	if ($w:言語 == d:LANG_ENGLISH_ENGLAND) {
		@説明テクスチャ表示 刀説明 act_telop9_alp_ovl 150
	//	フランス
	} else  if ($w:言語 == d:LANG_FRENCH) {
		@説明テクスチャ表示 刀説明 act_telop09_fr_alp_ovl 150
	//	ドイツ
	} else  if ($w:言語 == d:LANG_GERMANY) {
		@説明テクスチャ表示 刀説明 act_telop09_de_alp_ovl 150
	//	イタリア
	} else  if ($w:言語 == d:LANG_ITALY) {
		@説明テクスチャ表示 刀説明 act_telop09_it_alp_ovl 150
	//	スペイン
	} else  if ($w:言語 == d:LANG_SPANISH) {
		@説明テクスチャ表示 刀説明 act_telop09_es_alp_ovl 150
	//	日本
	} else  if ($w:言語 == d:LANG_JAPANESE) {
		@説明テクスチャ表示 刀説明 act_telop09_jp_alp_ovl 150
	}

	}



	proc 刀説明３開始 {
		//	スネーク　「押し込めば突きが出せるはずだ」
		eval ( $i:STREAM_ID = `%Stream d:_vc122303 -p 突き開始` )
		chara delay ディレイ -time 1 -exec{
			if($i:STREAM_ID < 0){
				eval ( $i:STREAM_ID = `%Stream d:_vc122303 -p 突き開始` )
				return 1
			}else{
				return 0
			}
		}
	}
	proc 突き開始 {
		//	エフェクトオンにする
		command ブレードエフェクトオン

		//	突き
		mesg プレイヤー d:PLAYER motion \
			d:モーションリスト:tsuki \
			0 \
			0 \
			0 \
			d:FA_NO_INTERP

		command	強制モーション終了プロック \
			-motion d:モーションリスト:tsuki \
			-proc 刀説明４開始

		//	説明文表示
	//	イギリス
	if ($w:言語 == d:LANG_ENGLISH_ENGLAND) {
		@説明テクスチャ表示 刀説明 act_telop10_alp_ovl 150
	//	フランス
	} else  if ($w:言語 == d:LANG_FRENCH) {
		@説明テクスチャ表示 刀説明 act_telop10_fr_alp_ovl 150
	//	ドイツ
	} else  if ($w:言語 == d:LANG_GERMANY) {
		@説明テクスチャ表示 刀説明 act_telop10_de_alp_ovl 150
	//	イタリア
	} else  if ($w:言語 == d:LANG_ITALY) {
		@説明テクスチャ表示 刀説明 act_telop10_it_alp_ovl 150
	//	スペイン
	} else  if ($w:言語 == d:LANG_SPANISH) {
		@説明テクスチャ表示 刀説明 act_telop10_es_alp_ovl 150
	//	日本
	} else  if ($w:言語 == d:LANG_JAPANESE) {
		@説明テクスチャ表示 刀説明 act_telop10_jp_alp_ovl 150
	}

	}



	proc 刀説明４開始 {
		//	スネーク　「エルワンＬ１ボタンを押している間、ブレード刀で防御が出来る」
		eval ( $i:STREAM_ID = `%Stream d:_vc122305 -p ガード１開始` )
		chara delay ディレイ -time 1 -exec{
			if($i:STREAM_ID < 0){
				eval ( $i:STREAM_ID = `%Stream d:_vc122305 -p ガード１開始` )
				return 1
			}else{
				return 0
			}
		}
	}

	proc ガード１開始 {
		//	スネーク　「銃弾くらいなら弾き返せるだろう」
//		eval ( $i:STREAM_ID = `%Stream d:_vc122306` )
		eval ( $i:STREAM_ID = `%Stream d:_vc122306 -p ガード開始２終了` )
		chara delay ディレイ -time 1 -exec{
			if($i:STREAM_ID < 0){
				eval ( $i:STREAM_ID = `%Stream d:_vc122306 -p ガード開始２終了` )
				return 1
			}else{
				return 0
			}
		}

		//	防御
		//	エフェクトオンにする
		command ブレードエフェクトオン

		mesg プレイヤー d:PLAYER motion \
			d:モーションリスト:guard_1 \		//	ガード１〜２でひとつ
			0 \
			0 \
			0 \
			d:FA_NO_INTERP

		command	強制モーション終了プロック \
			-motion d:モーションリスト:guard_1 \
			-proc ガード２開始


		command ＳＥセットモード -s d:SD_P_P_SWIN02 \
			-p	$i:プレイヤー位置Ｘ,$i:プレイヤー位置Ｙ,$i:プレイヤー位置Ｚ \
			-m 1


		//	説明文表示
	//	イギリス
	if ($w:言語 == d:LANG_ENGLISH_ENGLAND) {
		@説明テクスチャ表示 刀説明 act_telop11_alp_ovl 150
	//	フランス
	} else  if ($w:言語 == d:LANG_FRENCH) {
		@説明テクスチャ表示 刀説明 act_telop11_fr_alp_ovl 150
	//	ドイツ
	} else  if ($w:言語 == d:LANG_GERMANY) {
		@説明テクスチャ表示 刀説明 act_telop11_de_alp_ovl 150
	//	イタリア
	} else  if ($w:言語 == d:LANG_ITALY) {
		@説明テクスチャ表示 刀説明 act_telop11_it_alp_ovl 150
	//	スペイン
	} else  if ($w:言語 == d:LANG_SPANISH) {
		@説明テクスチャ表示 刀説明 act_telop11_es_alp_ovl 150
	//	日本
	} else  if ($w:言語 == d:LANG_JAPANESE) {
		@説明テクスチャ表示 刀説明 act_telop11_jp_alp_ovl 150
	}

	}

	proc ガード２開始 {
		//	エフェクトオンにする
		command ブレードエフェクトオン

		mesg プレイヤー d:PLAYER motion \
			d:モーションリスト:guard_2 \
			0 \
			0 \
			0 \
			0

		command 強制モーションループ回数設定 \
			-loop 100000

		command ＳＥセットモード -s d:SD_A_SWIGUARD \
			-p	$i:プレイヤー位置Ｘ,$i:プレイヤー位置Ｙ,$i:プレイヤー位置Ｚ \
			-m 1

		chara delay カメラ切替えディレイ \
			-t 60 \
			-e {
				chara カメラ設定 シナリオカメラ \
					-c 1 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-p 35292,6260,-90139 -t 34061,5279,-87128 \
					-r 191,3843,0 -f 3398 \
					-a 156 \
					-i 0 -1 0 0 \
					-d 1 \
					-s 1 \
					-z d:CAMERA_NO_CUSHION
			}
	}

	proc ガード開始２終了 {
		@刀説明デモ終了処理
	}

	proc 刀説明デモ終了処理 {
		//	デモキャンセルくんを殺す
		mesg デモキャンセルチェック 刀説明デモキャンセルチェック kill

		//	振り向きパッドデモを殺す
		mesg パッドデモ 振り向きデモライデン kill

		//	説明開始ディレイを殺す
		mesg delay 説明開始ディレイ kill

		//	カメラ切替えディレイを殺す
		mesg delay カメラ切替えディレイ kill

		//	再登場位置を代入
		eval ($s:登場ポイント = 刀説明デモ終了後)
		eval( $i:プレイヤー初期Ｘ位置 =  34250 ) ;
		eval( $i:プレイヤー初期Ｙ位置 =   4000 ) ;
		eval( $i:プレイヤー初期Ｚ位置 = -77000 ) ;
		eval( $i:プレイヤー初期方向   =      0 ) ;

		//	シナリオデモ終了処理を行う
//		@シナリオデモ終了処理

//		eval( $f:デモ再生フラグ = 0);
		@ポリゴンデモスタート d:ST:P073_05_S01通路Ａ５シナリオデモ１終了
	}

	proc 刀練習時間設定 {
		if ($w:p_story == d:ST:P073_05_S01通路Ａ５シナリオデモ１終了) {

		
			//	刀以外は使用不能
			command	不可装備設定 \
				-weapon \
					d:武器:Ｍ９ \			// 1
					d:武器:ＵＳＰ \			// 2
					d:武器:ソコム \			// 3
					d:武器:ＰＳＧ１ \		// 4
					d:武器:ＲＧＢ６ \		// 5
					d:武器:ニキータ \		// 6
					d:武器:スティンガー \	// 7
					d:武器:クレイモア \		// 8
					d:武器:Ｃ４ \			// 9
					d:武器:チャフ \			// 10
					d:武器:スタン \			// 11
					d:武器:マイク \			// 12
	//				d:武器:ブレード,		// 13
					d:武器:凍結スプレー \	// 14
					d:武器:ＡＫＳ \			// 15
					d:武器:マガジン \		// 16
					d:武器:グレネード \		// 17
					d:武器:Ｍ４ \			// 18
					d:武器:ＰＳＧ１−Ｔ \	// 19
					d:武器:特殊マイク \		// 20
					d:武器:雑誌				// 21

			//	壁チェックしない
			command ブレード壁チェックなし

			chara プロック連続実行 刀振りチェック \
				-t -1 \
				-e	{
					//	刀を振ったら
					if (`command	ブレード振りチェック ` == 1) {
						if ($b:w43a_刀練習時間終了フラグ == 0) {
							//	刀を振ったよ
							eval ($b:w43a_刀練習時間終了フラグ = 1)
							print $b:w43a_刀練習時間終了フラグ

						//	日本語版
						#ifdef d:JAPANESE
							//	刀を振ってから３０秒で終了しても良いフラグが立つ
							chara delay 刀練習時間ディレイ \
								-t 1800 \
								-e {
									eval ($b:w43a_刀練習時間終了フラグ = 2)
									print $b:w43a_刀練習時間終了フラグ
								}
						//	それ以外
						#else
							//	刀を振ってから４５秒で終了しても良いフラグが立つ
							chara delay 刀練習時間ディレイ \
								-t 2700 \
								-e {
									eval ($b:w43a_刀練習時間終了フラグ = 2)
									print $b:w43a_刀練習時間終了フラグ
								}
						#endif

							mesg プロック連続実行 刀振りチェック kill
						}
					}
				}
			
		}
	}


	proc バグムービー設定 {
		//	現状コンフィグ設定をいったん退避しておく
		eval ($w:w43a_コンフィグ設定 = $w:コンフィグ設定)

		if ($w:p_story < d:ST:P073_01_R01通路Ａ１無線機デモ１終了) {

		//	日本語版
		#ifdef d:JAPANESE
			//	２回無線をとるとまおムービー起動
			chara プロック連続実行 バグムービー管理人 \
				-t -1 \
				-e {
					if ($w:rfp_w43a_PC_発狂ＣＡＬＬ聞いた回数 >= 2) {
						@バグムービー
						mesg プロック連続実行 バグムービー管理人 kill
					}
				}
		//	それ以外
		#else
			//	３回無線をとるとまおムービー起動
			chara プロック連続実行 バグムービー管理人 \
				-t -1 \
				-e {
					if ($w:rfp_w43a_PC_発狂ＣＡＬＬ聞いた回数 >= 3) {
						@バグムービー
						mesg プロック連続実行 バグムービー管理人 kill
					}
				}
		#endif

		}
	}

	proc バグムービー {

		//	現状コンフィグ設定でレーダーオフになっていたら
		if ($w:コンフィグ設定 & d:CONFIG_RADAR_OFF) {
			//	無理矢理レーダーオンに設定し直す
			eval (	$w:コンフィグ設定 = ($w:コンフィグ設定 & ~(d:CONFIG_RADAR_OFF))	)
			command メニュー設定 \
				-node_access on \
				-radar on
		}


		//	ノードにアクセスしてなかったら
		if ($f:w41a_ノードフラグ == 0) {
			//	無理矢理レーダーオンにする
			command メニュー設定 \
				-node_access on \
				-radar on
		}
		eval ($f:w43a_まおムービー再生中 = d:TRUE)
		chara レーダ上動画 まおムービー \
				-data t:rmv001 \
				-movie 128 128 \
				-finaly まおムービー終了

	}

	proc まおムービー終了 {
		eval ($f:w43a_まおムービー再生中 = d:FALSE)

		//	ノードにアクセスしてなかったら
		if ($f:w41a_ノードフラグ == 0) {
			//	レーダーオフにする
			command メニュー設定 \
				-node_access off \
				-radar off
		}

		//	コンフィグ設定をもとに戻す
		eval ($w:コンフィグ設定 = $w:w43a_コンフィグ設定)
		//	もとのコンフィグ設定でレーダーオフになっていたら
		if ($w:コンフィグ設定 & d:CONFIG_RADAR_OFF) {
			//レーダーオフに戻す
			command メニュー設定 \
				-node_access off \
				-radar off
		}

	}





//-p 34201,5899,-59831 -t 34243,5581,-63731 \
//-r 53,2041,0 -f 3913 \
//-a 156 \