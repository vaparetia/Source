//###################################################################################
//									 ドア＆マップ切り替え
//###################################################################################

	proc ドア設定 {
	#if d:DEBUG_PRINT
		print '*** Door Set ***'
	#endif

		// ドア
		//   -m オブジェクト名  -d 向き  -p 場所  -slide スライド量  -time 時間  -between マップ名１ マップ名２  -exec { $:開閉フラグ }

		// 第二メタルハンガーへのドア
		chara ドア 第二メタルハンガードア \
			-m d:DOOR_NAME_LOAD1A \
			-d 0,0,0 \
			-p 33500,4000,-91625 \
			-slide d:SD_SLIDE_ARSENAL_LEFT \
			-time d:SD_OPEN_TIME \
			-between 丸通路 丸通路 \
			-w_door d:DOOR_NAME_LOAD1B d:SD_SLIDE_ARSENAL_RIGHT \
			-h 1500 \
			-card_level 9999 \			//	無理矢理開かなくする
			-exec {
			}

		trap dr001 ？ -mask ？ \
			-exec {
				if ($3 == 入る) {
					mesg ドア 第二メタルハンガードア open $2
				} else {
					mesg ドア 第二メタルハンガードア close $2
				}
			}

		chara ドア 第一メタルハンガードア \
			-m d:DOOR_NAME_LOAD1A \
			-d 0,1024,0 \
			-p 31625,4000,-61750 \
			-slide d:SD_SLIDE_ARSENAL_LEFT \
			-time d:SD_OPEN_TIME \
			-between 丸通路 丸通路 \
			-w_door d:DOOR_NAME_LOAD1B d:SD_SLIDE_ARSENAL_RIGHT \
			-h 1500 \
			-exec {
			}


		//	ドアは開かない
		if ($w:p_story >= d:ST:P073_05_S01通路Ａ５シナリオデモ１終了) {
			mesg ドア 第一メタルハンガードア locked
		}

		trap dr002 ？ -mask ？ \
			-exec {
				if ($3 == 入る) {
					mesg ドア 第一メタルハンガードア open $2
				} else {
					mesg ドア 第一メタルハンガードア close $2
				}
			}

		// 南側ドア
		chara ドア 南側ドア \
			-m d:DOOR_NAME_LOAD1A \
			-d 0 2048 0 \
			-p 35000 4000 -41375 \
			-slide d:SD_SLIDE_ARSENAL_LEFT \
			-time d:SD_OPEN_TIME \
			-between 丸通路 丸通路 \
			-w_door d:DOOR_NAME_LOAD1B d:SD_SLIDE_ARSENAL_RIGHT \
			-h 1500 \
			-card_level 9999 \			//	無理矢理開かなくする
			-exec {
			}

		trap dr003 ？ -mask ？ \
			-exec {
				if ($3 == 入る) {
					mesg ドア 南側ドア open $2
				} else {
					mesg ドア 南側ドア close $2
				}
			}

	}



//###################################################################################
//									開始時処理
//###################################################################################

	proc 丸通路開始時処理 {
	#if d:DEBUG_PRINT
		print '*** Stage Start Proc ***'
	#endif

		// @ステージ開始時処理 タイプ(スライドドア、水密ドア、何もなし)   ドアの名前   移動距離   状態(前のステージ状態、走り、歩き)
		if ($s:登場ポイント == sp_w42a_w43a_0) {
			@ステージ開始時処理（ステージ名表示） \
			d:LOAD_TYPE:SL_DOOR_TYPE 第一メタルハンガードア 2500 d:DEFAULT_M_TYPE \
			d:wn_アーセナルギア上行結腸
			@ロード時カメラ設定
			//	ＢＧＭを鳴らす
			command セットサウンドコード -c d:SNG_PLAY_05

		} else if ($s:登場ポイント == スネーク登場デモ後 ) {
			@ステージ開始時処理 d:LOAD_TYPE:NO_MOVE_TYPE 0 0 0
			//	ＢＧＭを鳴らす
			command セットサウンドコード -c d:SNG_PLAY_06

		} else if ($s:登場ポイント == 刀説明デモ終了後) {
			@ステージ開始時処理 d:LOAD_TYPE:NO_MOVE_TYPE 0 0 0
			//	ＢＧＭを鳴らす
			command セットサウンドコード -c d:SNG_PLAY_06

		}
	}



//###################################################################################
//									ロード設定
//###################################################################################

	proc ロード設定 {
	#if d:DEBUG_PRINT
		print '*** Load Set ***'
	#endif
	}

	proc ロードプロック {
	#if d:DEBUG_PRINT
		print '*** Load Proc ***'
	#endif

		if($s:呼び出しプロック == mv_w43a_w44a_0) {
			// 第二メタルハンガーへ
			@mv_w43a_w44a_0
		}
	}

	proc ロード時カメラ設定 {
		chara カメラ設定 ロードカメラ \
						-c 1 \	
//						-p 35249,6139,-60601 -t 33000,5539,-62500 \
						-p 34341,7459,-59007 -t 33321,5766,-62589 \
						-a 200 \
						-i 0 1 0 0 \
						-s 1

		chara プロック連続実行 カメラ戻し管理人 \
			-proc カメラ戻し管理
	}
	proc カメラ戻し管理 {
		command パッドチェック \
			-no_use
		if ($status != 1) {
			chara カメラ設定 ロードカメラ \
				-s -1
			mesg プロック連続実行 カメラ戻し管理人 kill

			//	２度と開かない
			mesg ドア 第一メタルハンガードア locked
		}
	}


//###################################################################################
//									オブジェクト
//###################################################################################

	// ロッカー設定
	proc ロッカー設定 {
