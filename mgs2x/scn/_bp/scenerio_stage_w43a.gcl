	}

	// その他オブジェクト設定

	//	スネーク死亡
	proc スネーク死亡 {
		if(`command ゲームオーバーチェック` == 1) {
			return
		}

		eval($f:pgo_ＮＰＣスネーク死亡 = 1)

		//	特殊装備解除
		//	特殊装備解除
		@特殊装備解除

		//	ニキータ、サーマル、ナイトビジョンも外す
		if ($w:武器 == d:武器:ニキータ) {
			eval($w:武器 = d:武器:素手)
		}
		if ( ($w:アイテム == d:アイテム:暗視ゴーグル) || \
			($w:アイテム == d:アイテム:サーマルゴーグル) ){
			eval($w:アイテム = d:アイテム:素手)
		}

		//	シネマスクリーン起動
//		mesg シネマスクリーン シネマ フェードアウト 1

		//	ゲームオーバーカメラ設定

		//	念のためサイトを消す
		command サイト表示制御 \
			-switch off

		command コントロール座標取得 \
			スネーク $i:スネークＸ座標変数 $i:スネークＹ座標変数 $i:スネークＺ座標変数

		if ($i:スネークＺ座標変数 < -44000) {
			chara カメラ設定 ゲームオーバーカメラ \
				-c 1\	
				-p 34250,($i:スネークＹ座標変数+3000),($i:スネークＺ座標変数+2000) \
				-t $i:スネークＸ座標変数,$i:スネークＹ座標変数,$i:スネークＺ座標変数 \
//				-t $i:スネークＸ座標変数,4000,($i:スネークＺ座標変数+1000) \
				-a 180 \
				-i 0 -1 0 0 \
				-d 1 \
				-s 1
		} else if ($i:スネークＺ座標変数 < -42000) { 
			chara カメラ設定 ゲームオーバーカメラ \
				-c 1\	
				-p 34196,7852,-41577 \
				-t $i:スネークＸ座標変数,$i:スネークＹ座標変数,$i:スネークＺ座標変数 \
				-a 156 \
				-i 0 -1 0 0 \
				-d 1 \
				-s 1
		} else {
			chara カメラ設定 ゲームオーバーカメラ \
				-c 1\	
				-p 34196,7852,-41577 \
				-t 34196,5723,-42376 \
				-a 156 \
				-i 0 -1 0 0 \
				-d 1 \
				-s 1
		}

	}

	proc その他オブジェクト設定 {
	#if d:DEBUG_PRINT
		print '*** Object Set ***'
	#endif

		//	髭剃りスネーク対応
		@髭剃りスネークテクスチャ入れ替え処理

		if (	($w:p_story >= d:ST:P073_04_P02通路Ａ４ポリゴンデモ２終了) && \
				($w:p_story < d:ST:P073_05_S01通路Ａ５シナリオデモ１終了)	) {
			chara ＮＰＣスネーク スネーク \
				-m sna_def \
				-a npc_snake \
				-c npc_snake_cap \
				-d npc_snake_drag \
				-y sna_npc \
//				-x $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,($i:プレイヤー初期Ｚ位置+3000) \
				-x $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,-80000 \
				-r 0,2000,0 \
				-t 7 \
				-h 1 \
				-n sna_def_mh \
				-u ドッグタグ_敵兵 \
				[dogtag:plt_w43a_snake_ve] [dogtag:plt_w43a_snake_ea] [dogtag:plt_w43a_snake_no] \
				[dogtag:plt_w43a_snake_ha] [dogtag:plt_w43a_snake_vh] \
				-v $i:w43a_スネークライフ \
				-g スネーク死亡

		} else if ($w:p_story >= d:ST:P073_05_S01通路Ａ５シナリオデモ１終了) {
			chara ＮＰＣスネーク スネーク \
				-m sna_def \
				-a npc_snake \
				-c npc_snake_cap \
				-d npc_snake_drag \
				-y sna_npc \
//				-x $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,($i:プレイヤー初期Ｚ位置+3000) \
				-x $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,-74000 \
				-r 0,2000,0 \
				-t 7 \
				-h 1 \
				-n sna_def_mh \
				-u ドッグタグ_敵兵 \
				[dogtag:plt_w43a_snake_ve] [dogtag:plt_w43a_snake_ea] [dogtag:plt_w43a_snake_no] \
				[dogtag:plt_w43a_snake_ha] [dogtag:plt_w43a_snake_vh] \
				-v $i:w43a_スネークライフ \
				-g スネーク死亡
		}
			//バンダナ
			chara ロープモデル３ バンダナ１ \
				-n sna_bdn1 \
				-d 1 \
				-y スネーク \
				-z 12 \
				-x 0,60,-90 \
				-m 12 \
				-p 250 \
				-k 350 \
				-o 110 \
				-v \
				-f 1

			chara ロープモデル３ バンダナ２ \
				-n sna_bdn2 \
				-d 1 \
				-y スネーク \
				-z 12 \
				-x 0,50,-90 \
				-m 22 \
				-p 250 \
				-k 350 \
				-o 110 \
				-v \
				-f 1

			//	息設定
			mesg ＮＰＣスネーク スネーク 白い息 136
			//	スネーク影
			mesg 影管理 影管理人 add スネーク 影用モデル
}



//###################################################################################
//									アイテム
//###################################################################################

	proc アイテム設定 {
	#if d:DEBUG_PRINT
		print '*** Item Set ***'
	#endif

		@アイテム再セットチェック（難易度対応） $b:w43a_取得ロード回数[0]
		if ($f:再セットフラグ) {
			@レーション_初期設置 レーション:01 34250 4000 -42250 0
		}
	}

	proc アイテム取得時番号設定 $:ボックス名 {
		#if d:DEBUG_PRINT
		print '*** Item No Set ***'
		#endif

		if($:ボックス名 == レーション:01) {
			eval($b:w43a_取得ロード回数[0] = $w:グローバルロード回数);
		}

	}



