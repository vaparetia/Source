//-----------------------------------------------------------------------------
// スイッチ

#define ENEMY_SET  0			// 敵兵の配置
#define STAGE_END  1			// ロードプロック

#define SCREENSHOT 0			// スクリーンショット
#define KEYBOARD   0			// ＵＳＢキーボード

//-----------------------------------------------------------------------------
// マップ関係
#define HZX_NAME   w43a
#define LT2_NAME   w43a

#define KMS_NAME0  w43a
#define KMS_NAME1  w43a_dec		//	もうない（リボン）
#define KMS_NAME2  w42a_dammy
#define KMS_NAME3  w44a_dammy

//#define DOOR_NAME1 w02a_l_dr

#define DOOR_NAME_LOAD1A w43a_dr_left
#define DOOR_NAME_LOAD1B w43a_dr_right

// キャラクター関係
#define RAIDEN     1
#if d:RAIDEN
#define PLAYER     ライデン
#else
#define PLAYER     スネーク
#endif

//	薬莢
#define		NPC_SNAKE				1	//	ＮＰＣスネーク

//	ステージ系
#define		STAGE_W43A				1

#define		STAGE_PLANT				1	//	プラント編

// ２Ｄテクスチャ説明表示
#define		EX_TEX			1		// 説明テクスチャ表示を使用するのに必要
#define		TEX_FADE_TIME	30		// 説明テクスチャのフェードインアウトタイム

#define		POLYDEMO_LOAD		1

//-----------------------------------------------------------------------------
// ローカル

//	$f:フラグ01 					//	第一メタルハンガーへのドア開閉フラグ
//	$f:フラグ02						//	南側ドア前到達フラグ
//	$b:w43a_刀練習時間終了フラグ	//	刀練習時間が終了したかどうかのフラグ 
									//	0 刀振ってない
									//	1 刀を振った
									//	2 練習終了しても良いよ
									//	3 練習終了
//	$i:w43a_スネークライフ			//	スネークのライフ
//	$f:w43a_まおムービー再生中		//	ムービーが再生中かどうか
//	$w:w43a_コンフィグ設定			//	$w:コンフィグ設定の退避用


//=============================================================================
// include
//=============================================================================

#include "rai_w43a.mh"	// ステージ固有モーションリスト

#include "stdch.h"
#include "sload.h"
#include "sound.h"
#include "enevoice.h"
#include "item_info.h"

#if d:KEYBOARD 
#include "usbkbd.h"
#endif


#include "snake_voice.h"


//XBOXとPSX2で切り替えるべき音声コード
#include "vcvx.h"


//=============================================================================
// メイン
//=============================================================================

chara マップ 丸通路 \
//	-k d:KMS_NAME1 \	// 順序が大事
	-k d:KMS_NAME0 \
	-k d:KMS_NAME2 \
	-k d:KMS_NAME3 \
	-h d:HZX_NAME, 0 \
	-l d:LT2_NAME

// 平野追加。デモ再生用ヘッダ。この位置を変えないこと。
#include "polydemo_w43a.h"

command マップ設定 丸通路 -set {

	if ($w:p_story < d:ST:P072_01_R01大佐混乱１無線機デモ１終了) {
		eval($w:p_story = d:ST:P072_01_R01大佐混乱１無線機デモ１終了)
	}


	// 平野追加。デモ呼び分け用。
	if($s:d_num == not_demo){
		//----- 基本設定
		@サウンド設定
	}

	//	ノードアクセス関連
	@レーダーオンオフチェック $f:w41a_ノードフラグ
	@常駐キャラ設定				// ヘッダーに定義

	if($s:d_num == not_demo){
		//----- 基本設定
		@ローカル変数初期化
		@設定値変更
		@プラグイン設定

		@プレイヤー設定
	#if d:ENEMY_SET
		@コマンダー設定
	#endif
		@ＢＧＭ設定
		@ドア設定
		@ロード設定
		//----- オブジェクト
		@ロッカー設定
		@天井君設定
		@壊れ物設定
		@その他オブジェクト設定

		//----- アイテム
		@アイテム設定
		//----- エフェクト
		@フォグ設定
		@エフェクト設定
		@影設定
		@空中文字設定

		//----- カメラ
		@カメラセット
		@丸通路カメラ設定
		//----- ビヨンド、ジャンプ
		@ビヨンド設定
		@ジャンプ設定

		@キャラ用ライト設定
		@ストーリー設定
		@刀説明デモ設定
		@シナリオデモキャラセット
		@刀練習時間設定

		if ($f:w41a_ノードフラグ == 1) {
			@プラント編全体マップ設定 d:アーセナルギア上行結腸	//	全体マップ表示
		} else {
			@ポーズ時ステージ名表示設定 d:wn_アーセナルギア上行結腸	//	ポーズ時ステージ名表示
		}

		@バグムービー設定
		@アーセナルくしゃみ間隔

	}
}

#include "w43a_cdc.ch"			// ※※ 通信機の include は移動させないこと！！ ※※
#include "p_force_cdc.ch"

command マップ表示 -show 丸通路

	// 平野追加。デモ呼び分け用。
	if($s:d_num == not_demo){
		@丸通路開始時処理
	}


	//	デバッグ用	//	これをオンにして北に行くといきなりデモ
#if 0
	eval ($w:rfp_w43a_PC_発狂ＣＡＬＬ聞いた回数 =100)
#endif


//###################################################################################
//									各proc設定
//###################################################################################



//###################################################################################
//									全マップ共通
//###################################################################################

	// サウンド設定
	proc サウンド設定 {
	#if d:DEBUG_PRINT
		print '*** Sound Set ***'
	#endif

		chara サウンドマネージャー ＳＤマネ \
			-pak 0	// パック番号

		@サウンド効果音設定
		command 弾痕ノーマル -n 0
		command 弾痕ノーマル -n 1
		command 弾痕ノーマル -n 3

		command 跳弾ノーマル -n 0
		command 跳弾ノーマル -n 1
		command 跳弾ノーマル -n 3

	}

	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT 
			print 'localvar_init'
		#endif

//		eval ($f:フラグ01 = 0)
//		eval ($f:フラグ02 = d:FALSE)
		eval ($b:w43a_刀練習時間終了フラグ = 0)
		eval ($i:w43a_スネークライフ = 600);

		//	刀説明デモ終了後はデモ再生フラグを戻す
		if ($w:p_story == d:ST:P073_05_S01通路Ａ５シナリオデモ１終了) {
			eval( $f:デモ再生フラグ = 0);
		}

	}

	proc 設定値変更 {
		#if d:DEBUG_PRINT 
			print 'status_set'
		#endif

	}

	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif
		//	風邪用
		command プラグインくしゃみ
		//	刀
		command プラグインブレード -m rai_blade
	}



//###################################################################################
//									 プレイヤー
//###################################################################################

	proc プレイヤー設定 {
	#if d:DEBUG_PRINT
		print '*** Player Set ***'
	#endif

	#if d:RAIDEN
		// プレイヤー
		//   -m モデル名  -a モーション名  -p 出現位置  -d 出現方向  -s 出現時姿勢  -o 強制モーションファイル名  -i SE 変換テーブル ID
		if($w:p_story < d:ST:P073_02_P01通路Ａ２ポリゴンデモ１終了) {

			//	裸モード
			command はだかモードセット

			chara プレイヤー d:PLAYER \
				-m rai_naked_sh \
				-a rai_naked \
				-p $i:プレイヤー初期Ｘ位置 $i:プレイヤー初期Ｙ位置 $i:プレイヤー初期Ｚ位置 \
				-d 0,$i:プレイヤー初期方向,0 \
				-s 0 \
				-o rai_w43a \
				-i 0

		} else {
			chara プレイヤー d:PLAYER \
				-m rai_def \
				-a raiden \
				-p $i:プレイヤー初期Ｘ位置 $i:プレイヤー初期Ｙ位置 $i:プレイヤー初期Ｚ位置 \
				-d 0,$i:プレイヤー初期方向,0 \
				-s 0 \
				-o rai_w43a \
				-i 0

			//	ＬＯＤ機能
			@プレイヤーＬＯＤ設定 d:C_DISTANCE_TYPE 4000
		}

		// 髪の毛
		@ライデン髪の毛設定 d:NORMAL_HAIR

		//	プレイヤー影
		mesg 影管理 影管理人 add d:PLAYER 影用モデル

	#else
		// プレイヤー
		chara プレイヤー d:PLAYER \
			-m sna_def \
			-a snake \
			-p $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,$i:プレイヤー初期Ｚ位置 \
			-d 0,$i:プレイヤー初期方向,0 \
			-s 0 \
			-o rai_common

		// ロープモデル３
		//   -n モデル名  -d サンプルデータ番号  -y 着ける相手の名前  -z 着ける場所の OBJ 番号  -x オフセット座標  -m 各 OBJ の重さ  -p 風の影響の割合  -k 速度に対する抵抗の割合  -o 楕円球当たり判定用パラメータ  -f 当たり判定を行うかどうかのフラグ

		// バンダナ
		chara ロープモデル３ バンダナ１ \
			-n sna_bdn1 \
			-d 1 \
			-y スネーク \
			-z 12 \
			-x 0,60,-90 \
			-m 12 \
			-p 250 \
			-k 350 \
			-o 110 \
			-f 1

		chara ロープモデル３ バンダナ２ \
			-n sna_bdn2 \
			-d 1 \
			-y スネーク \
			-z 12 \
			-x 0,60,-90 \
			-m 22 \
			-p 250 \
			-k 350 \
			-o 110 \
			-f 1
	#endif



	// 亀甲床
	chara 亀甲床 亀甲床 \
		-prims 128 \
		-alpha 7 \
		-vertex 5 \
		-user 64 \
		-time 150

	chara 白息 プレイヤー息 \
		-name d:PLAYER \
		-object 12 \
		-shift 0,-30,130 \
		-interval 136
	mesg 白息 プレイヤー息 on
}



