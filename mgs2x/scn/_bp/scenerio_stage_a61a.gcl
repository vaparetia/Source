// 各gclで必要なdefine
// ------------------------------------
// モード
#define		STAGE_PLANT		1		// 共通プロック切り分け用
#define		STAGE_ALT		1		// オルタナティブミッション切り分け用
// ステージ名
#define		STAGE_W61A		1		// 共通プロック切り分け用


// 各種スイッチ用define
// ------------------------------------
// デバッグ関係
#ifdef	d:FIX_MODE
	#define		DEBUG_CHARA		0		// デバッグキャラ全体(FIX時は0)
#else
	#define		DEBUG_CHARA		0		// デバッグキャラ全体
#endif
#define		SCREENSHOT		0		// スクリーンショット


// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME		w61a
#define		KMS_NAME0		w61a
#define		KMS_NAME1		w61a_other1
#define		FLAG_NAME		w61a_flag
#define		POLE_NAME		w61a_flag_pole
#define		GW_NAME			w61a_gw_statue
#define		LT2_NAME		w61a

#define		PLAYER		ライデン	// モーションができるまで名前はスネーク

// ローカル変数


// include
// ------------------------------------
#include "rai_w61a.mh"		// 強制モーションリスト
#include "stdch.h"
#include "a_mode.h"			// アナザーミッション設定ファイル
#include "sload.h"
#include "beyond.h"
#include "beyond2.h"
#include "beyond3.h"
#include "sound.h"
#include "item_info.h"
#include "w61a_common.h"
#include "cap_resource.h"


// アナザー用でマップ設定前に設定する
// ------------------------------------
@アナザー用マップ定義前設定

// マップ設定
// ------------------------------------
chara マップ フェデラルホール -k d:KMS_NAME0 -k d:GW_NAME -h d:HZX_NAME,0 -l d:LT2_NAME

command マップ設定 フェデラルホール -set {
	@常駐キャラ設定
	@ローカル変数初期化
	@設定値変更
	@プラグイン設定
	@シナリオデモキャラセット
	@アイテム状態制御
	@A_プレイヤー設定 sna_w61a sna_w61a
}

// アナザー用でマップ設定後に設定する
// ------------------------------------
@アナザー用マップ定義後設定

command マップ設定 フェデラルホール -set {
	@ソリダスセット
	@遠景設定
	@フェデラルホール旗設置
	@ビル窓設置
	@フォグ設定
	@フェデラルホールビヨンド設定
	@カメラセット
	@体力０で落下死設定
	@落下死カメラ設定
	@キャラ用ライト設置

	#if d:DEBUG_CHARA
	//	@デバッグキャラセット
	#endif
}


// ゲーム時
//初期マップの表示
command マップ表示 -show フェデラルホール
// 全てのセットが終わったところでフェードイン
// フェードインが終わるまではパッドリリース
command パッド操作 -release

$f:ロードチェックＯＮフラグ = 1;

chara フェードインアウト フェードイン \
	-i 255,255,255 128 \
	-c 0,0,0 0 \
	-t d:FADEIN_TIME \
	-s 10

mesg シネマスクリーン シネマ フェードアウト 1
command メニュー設定 -menu off -gage off
chara delay シネマディレイ \
	-time 10 \
	-exec {
		mesg シネマスクリーン シネマ フェードイン (d:FADEIN_TIME-10)
	}
chara delay パッドディレイ \
	-time d:FADEIN_TIME \
	-exec {
			command メニュー設定 -menu on -gage on
			command パッド操作 -cancel
	}





// 各proc設定
//-------------------------------------------------------------------------------------
// 全マップ共通
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT 
			print 'localvar_init'
		#endif

		$f:アイテム再セット１ = 0;
		$f:アイテム再セット２ = 0;
	}

	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT 
			print 'status_set'
		#endif

		command メニュー設定 -radar off

		// スネークのモーションを変えるため、危険モードにする
		$w:アラートモード = d:ALERT_MODE_ALERT;
	}

	// ポリデモ
	// ------------------------------------

	//
	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif

		command プラグイン落下
	}

	// アイテム状態を調整する
	// ------------------------------------
	proc アイテム状態制御 {
		#if d:DEBUG_PRINT
			print 'player_item_set'
		#endif

		// 通常ゲームのとき
		$w:w61a_レーション所持数 = $w:アイテム数Ｒ[ d:アイテム:レーション ];
		$w:w61a_防弾チョッキ所持数 = $w:アイテム数Ｒ[ d:アイテム:防弾チョッキ ];
		$w:w61a_止血剤所持数 = $w:アイテム数Ｒ[ d:アイテム:止血剤 ];
		$w:w61a_デジカメ所持数 = $w:アイテム数Ｒ[ d:アイテム:デジカメ ];
		$w:w61a_ステルス所持数 = $w:アイテム数Ｒ[ d:アイテム:ステルス ];
		$w:w61a_無限カツラ所持数 = $w:アイテム数Ｒ[ d:アイテム:無限カツラ ];
		$w:w61a_カツラＡ所持数 = $w:アイテム数Ｒ[ d:アイテム:カツラＡ ];
		$w:w61a_カツラＢ所持数 = $w:アイテム数Ｒ[ d:アイテム:カツラＢ ];
		$w:w61a_カツラＣ所持数 = $w:アイテム数Ｒ[ d:アイテム:カツラＣ ];
		$w:w61a_カツラＤ所持数 = $w:アイテム数Ｒ[ d:アイテム:カツラＤ ];
		$w:w61a_ドッグタグ所持数 = $w:アイテム数Ｒ[ d:アイテム:ドッグタグ ];

		command	武器アイテム取られ
		
		$w:武器 = d:武器:素手;

		// アイテムのセット
		$w:アイテム数Ｒ[ d:アイテム:レーション ] = $w:w61a_レーション所持数;
		$w:アイテム数Ｒ[ d:アイテム:防弾チョッキ ] = $w:w61a_防弾チョッキ所持数;
		$w:アイテム数Ｒ[ d:アイテム:止血剤 ] = $w:w61a_止血剤所持数;
		$w:アイテム数Ｒ[ d:アイテム:デジカメ ] = $w:w61a_デジカメ所持数;
		$w:アイテム数Ｒ[ d:アイテム:ステルス ] = $w:w61a_ステルス所持数;
		$w:アイテム数Ｒ[ d:アイテム:無限カツラ ] = $w:w61a_無限カツラ所持数;
		$w:アイテム数Ｒ[ d:アイテム:カツラＡ ] = $w:w61a_カツラＡ所持数;
		$w:アイテム数Ｒ[ d:アイテム:カツラＢ ] = $w:w61a_カツラＢ所持数;
		$w:アイテム数Ｒ[ d:アイテム:カツラＣ ] = $w:w61a_カツラＣ所持数;
		$w:アイテム数Ｒ[ d:アイテム:カツラＤ ] = $w:w61a_カツラＤ所持数;
		$w:アイテム数Ｒ[ d:アイテム:ドッグタグ ] = $w:w61a_ドッグタグ所持数;
	}


	// ソリダス関連
	// ------------------------------------
	proc ソリダスセット {
		// 通常ゲームのソリダス
		chara ソリダス ソリダス \
			-model sol_vanim_0_sh_mt \
			-evm sol_def_face_mh_mt \	
			-cv2 sol_vanim_0_sh_mt sol_vanim_1_sh_mt \
			-motion solidus \
			-position 4167,20000,12509 \
			-rotate 0,2048,0 \
			-start_mode 0 \
			-life 75 75 \
			-proc ソリダス戦勝利プロック \
				  ソリダス蛇手外し位置移動開始 \
			 	  ソリダス蛇手外し開始 \
			 	  ソリダス蛇手外し終了 \
			-map_center 6250,16625,13500 \
			-jump_bound 250,5000 10750,21000 \
			-flag 0 \
			#ifdef d:ENGLISH
				-caption [ソリダス字幕リソース:さすがだな] \
						 [ソリダス字幕リソース:ここからだ] \
				#ifdef d:EU
					     [ソリダス字幕リソース:さすがだなＧ] \
						 [ソリダス字幕リソース:ここからだＧ] \
					     [ソリダス字幕リソース:さすがだなＦ] \
						 [ソリダス字幕リソース:ここからだＦ] \
					     [ソリダス字幕リソース:さすがだなＩ] \
						 [ソリダス字幕リソース:ここからだＩ] \
					     [ソリダス字幕リソース:さすがだなＳ] \
						 [ソリダス字幕リソース:ここからだＳ] \
				#endif
			#elif d:JAPANESE
				-caption [ソリダス字幕リソース:さすがだな] \
						 [ソリダス字幕リソース:ここからだ] \
			#endif
			#ifdef d:ENGLISH
				-captiontime 0 60 220 
			#elif d:JAPANESE
				-captiontime 0 100 220 
			#endif

		chara 二体表示カメラ ボス戦カメラ \
			-names d:PLAYER ソリダス \
			-position 10406,20000,9732 \
			-rotate 167,3072,0 \
			-track 6032 \
			-min_track 4000 \
			-bound 50,0,1550 12450,50000,50000 \
			-limit 500,0,2000 12000,50000,50000 \
			-angle 200

		// 欧州、韓国はＳＥ字幕が入る
		#ifdef d:EU || d:KOREA
			#ifdef d:EU
			// 欧州版では言語選択があるためにこのコマンドを使う(:01とかで定義プロックを変えられる)
				command 字幕言語設定
			#endif
			@ソリダスＳＥ字幕リソース
		#endif

	}


	proc ソリダス戦勝利プロック {
		if (($b:ミッション番号 == d:MISSION:スネークテイルズ) && \
			($b:tales_story_no == d:TALES_NO:E) && \
			($b:tales_story_e == d:TALES_E:対ソリダスクリア前)) {
			@紙芝居ステージロード d:TALES_E:対ソリダスクリア中
		} else {
			// 通常ゲームの場合
			mesg サウンドマネージャー ＳＤマネ SD_CODE d:SNG_FOUTS_S
			command 無線設定 -reset
			command パッド操作 -release
			command プレイヤー無敵セット
			mesg コマンダー 敵兵セット 視界オフ
			//eval ( $w:p_story = d:ST:P082_01_P01エンディング１ポリゴンデモ１開始 );
			eval( $f:デモ直後フラグ = 1 );

			// フェードインスタート
			if($w:アイテム == d:アイテム:ゴル兵制服){
				preseek 'r_plt5'
			} else {
				preseek 'd082p01'
			}
			chara フェードインアウト フェードアウト \
				-c 255,255,255 128 \
				-t d:FADEOUT_TIME \
				-p ポリデモロードスタート \
				-s 10

			chara delay シネマディレイ \
				-time 1 \
				-exec {
					chara シネマスクリーン シネマ -top d:CINEMA_BELT_UPPER -bottom d:CINEMA_BELT_LOWER -ftime d:C_FADE_TIME
					mesg シネマスクリーン シネマ フェードアウト (d:FADEOUT_TIME-5)
				}

			command メニュー設定 -menu off -gage off
		}
	}

	proc ポリデモロードスタート {
		#if d:DEBUG_PRINT
			print '*** Poly-Demo Load Start ***'
		#endif
	}

	proc ソリダス蛇手外し位置移動開始 {
		if (`command ゲームオーバーチェック` == 0 ) {
			@シナリオデモ開始処理
		}
	}

	proc ソリダス蛇手外し開始 {
		if (`command ゲームオーバーチェック` == 0 ) {
			//@シナリオデモ開始処理
			if ( $1 == 0 ) {
					chara カメラ設定 プログラムデモカメラ \
						-c 1 \
						-p 5891,17688,6254 -t 5942,17717,3904 \
						-r 4088,2034,0 -f 2350 \
						-a 200 \
						-i 2 2 0 0 \
						-s 1 \
						-z d:CAMERA_CUT_IN
			} else {
					chara カメラ設定 プログラムデモカメラ \
						-c 1 \
						-p 5493,16864,17556 -t 6040,17616,20286 \
						-r 3924,129,0 -f 2884 \
						-a 200 \
						-i 2 2 0 0 \
						-s 1 \
						-z d:CAMERA_CUT_IN
			}
		}
	}

	proc ソリダス蛇手外し終了 {
		@シナリオデモ終了処理
		// 勝利プロックでフェードアウトよりもプライオリティを高くするために一回killして起動しなおす。
		mesg シネマスクリーン シネマ kill
		chara カメラ設定 プログラムデモカメラ -s -1
	}


	// ビル窓設置
	// ------------------------------------
	proc ビル窓設置 {
		#if d:DEBUG_PRINT
			print 'window_set'
		#endif

		chara プット壊れビル窓 ビル窓１ \
			-target (15000-2),49000,27000  (15000-2),0,5000 \
			-model  w61a_window_brk1 w61a_window_brk2 w61a_window_brk3 \
			-pos 14998,16250,24875  -pos 14998,16250,21875  -pos 14998,16250,18875 \
			-pos 14998,16250,15875 	-pos 14998,16250,12875  -pos 14998,16250, 9875 \
			-pos 14998,16250, 6875 	-pos 14998,22000,24875 	-pos 14998,22000,21875 \
			-pos 14998,22000,18875  -pos 14998,22000,15875 	-pos 14998,22000,12875 \
			-pos 14998,22000, 9875  -pos 14998,22000, 6875 	-pos 14998,26000,24875 \
			-pos 14998,26000,21875 	-pos 14998,26000,18875  -pos 14998,26000,15875 \
			-pos 14998,26000,12875 	-pos 14998,26000, 9875  -pos 14998,26000, 6875 \
			-pos 14998,30000,24875  -pos 14998,30000,21875  -pos 14998,30000,18875 \
			-pos 14998,30000,15875  -pos 14998,30000,12875  -pos 14998,30000, 9875 \
			-pos 14998,30000, 6875  -pos 14998,34000,24875 	-pos 14998,34000,21875 \
			-pos 14998,34000,18875  -pos 14998,34000,15875 	-pos 14998,34000,12875 \
			-pos 14998,34000, 9875  -pos 14998,34000, 6875 	-pos 14998,38000,24875 \
			-pos 14998,38000,21875  -pos 14998,38000,18875  -pos 14998,38000,15875 \
			-pos 14998,38000,12875 	-pos 14998,38000, 9875  -pos 14998,38000, 6875 \
			-pos 14998,42000,24875  -pos 14998,42000,21875  -pos 14998,42000,18875 \
			-pos 14998,42000,15875 	-pos 14998,42000,12875  -pos 14998,42000, 9875 \
			-pos 14998,42000, 6875  -pos 14998,46000,18875 	-pos 14998,46000,15875 \
			-pos 14998,46000,12875  -pos 14998,46000, 9875 	-pos 14998,46000, 6875

		chara プット壊れビル窓 ビル窓２ \
			-target 14000,49000,5000    14000,0,-19000 \
			-model  w61a_window_brk1 w61a_window_brk2 w61a_window_brk3 \
			-pos 13998,16250, 3500  -pos 13998,16250,  500  -pos 13998,16250,-2500 \
			-pos 13998,16250,-5500 	-pos 13998,22000, 3500  -pos 13998,22000,  500 \
			-pos 13998,22000,-2500  -pos 13998,22000,-5500 	-pos 13998,26000, 3500 \
			-pos 13998,26000,  500  -pos 13998,26000,-2500  -pos 13998,26000,-5500 \
			-pos 13998,30000, 3500  -pos 13998,30000,  500  -pos 13998,30000,-2500 \
			-pos 13998,30000,-5500 	-pos 13998,34000, 3500  -pos 13998,34000,  500 \
			-pos 13998,34000,-2500  -pos 13998,34000,-5500 	-pos 13998,38000, 3500 \
			-pos 13998,38000,  500  -pos 13998,38000,-2500  -pos 13998,38000,-5500 \
			-pos 13998,42000, 3500  -pos 13998,42000,  500  -pos 13998,42000,-2500 \
			-pos 13998,42000,-5500 	-pos 13998,46000, 3500  -pos 13998,46000,  500 \
			-pos 13998,46000,-2500  -pos 13998,46000,-5500

		chara プット壊れビル窓 ビル窓３ \
			-target 15000,49000,5000    14000,0,5000 \
			-model  w61a_window_brk1 w61a_window_brk2 w61a_window_brk3
	}



	// フォグ
	// ------------------------------------
	proc フォグ設定 {
		#if d:DEBUG_PRINT
			print 'fog_set'
		#endif

		chara フォグ 霧\
			-c 120, 130, 116 \
			-n -3000 \
			-f 160000 
	}

	// キャラ用光源(マップの設置が終わってから設定することで、キャラだけに光を当てる)
	// ------------------------------------
	proc キャラ用ライト設置 {
		#if d:DEBUG_PRINT
			print 'chara_light_set'
		#endif

		chara 環境光 環境光源 \
			 -c 39 55 46

		chara 平行光 平行光源 \
			 -c 29 44 54 \
			 -p -4600 -800 -1600
	}




	// ステージカメラ設定 
	// ------------------------------------
	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0 
		chara カメラ モーションカメラ		-c 0 -l 1 -p 1 

		chara カメラ プログラムデモカメラ -c 0 -l 1 -p 0

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \	
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 340,2048,0 \
			-f 10000 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}


	// ビヨンド設定
	// ------------------------------------
	proc フェデラルホールビヨンド設定 {
		#if d:DEBUG_PRINT
			print 'w61a_beyond_set'
		#endif

		// 東側
		trap by001 d:PLAYER \
			-mask 入る \
			-exec {
				@東向き柵なしビヨンド発動 by001 12500 $6 3000 23000 15250 (d:BY_NOFOOTSHADOW | d:BY_NO_STAMP)
				// バグ防止のためトラップを広く張ったので移動範囲をこちらで設定
				command エルード移動範囲設定 -x_range 12500 12500 -z_range 3000 23000
			}
		trap by001 d:PLAYER \
			-mask いる \
			-state 6 \
			-dir 1024 256 \	//方向指定
			-camera \		//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 791,2252,0 -f 8508 \
					-a 200 \
					-i 0 -1 0 0 \
					-s 1
			}
		trap by001 d:PLAYER \
			-mask ？ \
			-state 5 \
			-dir 3072 256 \	//方向指定
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 26,2162,0 -f 7803 \
					-a 276 \
					-i 3 2 0 0 \
					-s $3 \
					-z d:CAMERA_NO_CUSHION
			}


		// 南側
		trap by002 d:PLAYER \
			-mask 入る \
			-exec {
				@南向き片手ビヨンド発動 by002 23000 $4 -1000 12500 ((-(2750*$4)/12500)+18000) (d:BY_NOFOOTSHADOW | d:BY_NO_STAMP)
			}

		trap by002 d:PLAYER \
			-mask いる \
			-state 6 \
			-dir 0 256 \	//方向指定
			-camera \		//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 683,2110,0 -f 6731 \
					-a 200 \
					-i 0 -1 0 0 \
					-s 1
			}
		trap by002 d:PLAYER \
			-mask ？ \
			-state 5 \
			-dir 2048 256 \	//方向指定
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 4089,2065,0 -f 7342 \
					-a 250 \
					-i 3 2 0 0 \
					-s $3 \
					-z d:CAMERA_NO_CUSHION
			}
	}


	// 体力０で落下死設定
	// ------------------------------------
	proc 体力０で落下死設定 {
		#if d:DEBUG_PRINT
			print 'fall_motion_change'
		#endif

		// 体力０でトラップ内に入ったらモーションを強引にチェンジしてカメラをつける
		// バグ防止のため体力があってエルード以外で落下したとき強引に死亡にする処理も追加する 2002.02.27
		trap de001 d:PLAYER \
			-mask ＊ \
			-exec {
				if ( $w:体力 <= 0 ) {
					if ( $3 == 入る ) {
						#if d:DEBUG_PRINT
							print 'de001-体力０で落ちました'
						#endif
						mesg プレイヤー d:PLAYER rotate 3072			//	それ以外はその向きのまま

						mesg プレイヤー d:PLAYER fall \
							d:モーションリスト:non_elude_fall \
							d:モーションリスト:non_elude_fall \
							d:モーションリスト:non_elude_fall_out \
							0 \	//	この高さまで落ちたらゲームオーバー終了処理が呼ばれる
							0x0004 \
							NULL \
							NULL
					}

					if ( $6 <= 11000 && $6 >= 5000 ) {
						#if d:DEBUG_PRINT
							print 'de001-落下死カメラ箱の上'
						#endif
						// 箱の上にうまく落ちてしまった
						@落下死カメラ東側箱の上 1 $5
					} else {
						#if d:DEBUG_PRINT
							print 'de001-落下死カメラ東側'
						#endif
						@落下死カメラ東側 1 $5
					}
					
				} else {
					// エルードトラップに入らず落下してきた場合は強引にゲームオーバーにする
					if ( (`command ゲームオーバーチェック` == 0) && ($5 < 14000) ) {
						command プレイヤー状態取得
						if ( ((!($status & d:PFLAG_ELUDE))&&(!($status & d:PFLAG_ELUDE_FALL))) ) {
							#if d:DEBUG_PRINT
								print 'de001-体力がある状態で落ちました'
							#endif
							mesg プレイヤー d:PLAYER rotate 3072			//	それ以外はその向きのまま

							mesg プレイヤー d:PLAYER fall \
								d:モーションリスト:non_elude_fall \
								d:モーションリスト:non_elude_fall \
								d:モーションリスト:non_elude_fall_out \
								0 \	//	この高さまで落ちたらゲームオーバー終了処理が呼ばれる
								0x0004 \
								NULL \
								NULL

							if ( $6 <= 11000 && $6 >= 5000 ) {
								// 箱の上にうまく落ちてしまった
								@落下死カメラ東側箱の上 1 $5
							} else {
								@落下死カメラ東側 1 $5
							}
						}
					}
				}
			}

		trap de002 d:PLAYER \
			-mask ＊ \
			-exec {
				if ( $w:体力 <= 0 ) {
					if ( $3 == 入る ) {
						#if d:DEBUG_PRINT
							print 'de001-体力０で落ちました'
						#endif
						mesg プレイヤー d:PLAYER rotate 2048			//	それ以外はその向きのまま

						mesg プレイヤー d:PLAYER fall \
							d:モーションリスト:non_elude_fall \
							d:モーションリスト:non_elude_fall \
							d:モーションリスト:non_elude_fall_out \
							0 \	//	この高さまで落ちたらゲームオーバー終了処理が呼ばれる
							0x0004 \
							NULL \
							NULL
					}

					@落下死カメラ南側

				} else {
					// エルードトラップに入らず落下してきた場合は強引にゲームオーバーにする
					if ( (`command ゲームオーバーチェック` == 0) && ($5 < 14000) ) {
						command プレイヤー状態取得
						if ( ((!($status & d:PFLAG_ELUDE))&&(!($status & d:PFLAG_ELUDE_FALL))) ) {
							#if d:DEBUG_PRINT
								print 'de001-体力がある状態で落ちました'
							#endif
							mesg プレイヤー d:PLAYER rotate 2048			//	それ以外はその向きのまま

							mesg プレイヤー d:PLAYER fall \
								d:モーションリスト:non_elude_fall \
								d:モーションリスト:non_elude_fall \
								d:モーションリスト:non_elude_fall_out \
								0 \	//	この高さまで落ちたらゲームオーバー終了処理が呼ばれる
								0x0004 \
								NULL \
								NULL

							@落下死カメラ南側
						}
					}
				}
			}
	}

	// 落下死カメラ設定
	// ------------------------------------
	proc 落下死カメラ設定 {
		#if d:DEBUG_PRINT
			print 'fall_camera_set'
		#endif

		// 東側
		trap de001 d:PLAYER \
			-mask いる \
			-state d:TRP_STATE_ELUDE_FALL \
			-exec {
				if ( $6 <= 11000 && $6 >= 5000 ) {
					// 箱の上にうまく落ちてしまった
					@落下死カメラ東側箱の上 $3 $5
				} else {
					@落下死カメラ東側 $3 $5
				}
			}


		// 南側
		trap de002 d:PLAYER \
			-mask いる \
			-state d:TRP_STATE_ELUDE_FALL \
			-exec {
				@落下死カメラ南側
			}
	}

	proc 落下死カメラ東側箱の上 $:入る出るフラグ $:プレイヤーＹ位置 {

		@CS_スムーズカメラ降順 $:プレイヤーＹ位置 14200 8000 15266 15122
		eval( $i:補完ＰＸ = $i:CS_結果１ );
		@CS_スムーズカメラ降順 $:プレイヤーＹ位置 14200 8000 23389 10352
		eval( $i:補完ＰＹ = $i:CS_結果１ );
		@CS_スムーズカメラ降順 $:プレイヤーＹ位置 14200 8000 43583 43323
		eval( $i:補完ＰＺ = $i:CS_結果１ );

		@CS_スムーズカメラ降順 $:プレイヤーＹ位置 14200 8000 5967 5918
		eval( $i:補完ＴＸ = $i:CS_結果１ );
		@CS_スムーズカメラ降順 $:プレイヤーＹ位置 14200 8000 17454 16945
		eval( $i:補完ＴＹ = $i:CS_結果１ );
		@CS_スムーズカメラ降順 $:プレイヤーＹ位置 14200 8000 20016 19893
		eval( $i:補完ＴＺ = $i:CS_結果１ );

		chara カメラ設定 モーションカメラ \
			-c 1 \	
			-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ -t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ \
			-r 106,2300,0 -f 20782 \
			-a 200 \
			-i 0 0 0 0 \
			-z d:CAMERA_NO_CUSHION \
			-s $:入る出るフラグ
	}

	proc 落下死カメラ東側 $:入る出るフラグ $:プレイヤーＹ位置 {

		@CS_スムーズカメラ降順 $:プレイヤーＹ位置 14200 1000 15077 14689
		eval( $i:補完ＰＸ = $i:CS_結果１ );
		@CS_スムーズカメラ降順 $:プレイヤーＹ位置 14200 1000 17887 1992
		eval( $i:補完ＰＹ = $i:CS_結果１ );
		@CS_スムーズカメラ降順 $:プレイヤーＹ位置 14200 1000 44085 42447
		eval( $i:補完ＰＺ = $i:CS_結果１ );

		@CS_スムーズカメラ降順 $:プレイヤーＹ位置 14200 1000 7346 7427
		eval( $i:補完ＴＸ = $i:CS_結果１ );
		@CS_スムーズカメラ降順 $:プレイヤーＹ位置 14200 1000 14523 8084
		eval( $i:補完ＴＹ = $i:CS_結果１ );
		@CS_スムーズカメラ降順 $:プレイヤーＹ位置 14200 1000 25090 23958
		eval( $i:補完ＴＺ = $i:CS_結果１ );

		chara カメラ設定 モーションカメラ \
			-c 1 \	
			-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ -t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ \
			-r 106,2300,0 -f 20782 \
			-a 200 \
			-i 0 0 0 0 \
			-z d:CAMERA_NO_CUSHION \
			-s $:入る出るフラグ
	}

	proc 落下死カメラ南側 {
		chara カメラ設定 モーションカメラ \
			-c 0 \	
			-b -6270,2174,30936 -6270,2174,30936 \
			-l 6820,8525,19722 8968,20229,20739 \
			-r 3877,1400,0 -f 21782 \
			-a 322 \
			-z d:CAMERA_NO_CUSHION \
			-i 0 0 0 0 \
			-s 1
	}


