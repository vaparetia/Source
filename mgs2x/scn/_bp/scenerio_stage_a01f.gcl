/**************************************************************************************/
// マップ宣言
/**************************************************************************************/
	chara マップ １Ｆリフレッシュルーム	-k w01f0 0 0 0 -h a01f,0 -l d:LT2_NAME
	chara プットオブジェ ＴＶスペース -m w01f2 -r 0,0,0 -p 0,0,0 -l d:LT2_NAME -s 100,100,100
	chara プットオブジェ Ｂ１スペース -m w01f3 -r 0,0,0 -p 0,0,0 -l d:LT2_NAME -s 100,100,100
	chara プットオブジェ ミニバー -m w01f1 -r 0,0,0 -p 0,0,0 -l d:LT2_NAME -s 100,100,100
	chara プットオブジェ １Ｆ床 -m w01f_floor -r 0,0,0 -p 0,0,0 -l d:LT2_NAME -s 100,100,100

	//プリシェイド無しモデル
	chara プットオブジェ ソファー -m sofa_mt -r 0,0,0 -p 0,0,0 -l d:LT2_NAME -s 100,100,100 -f 1

	// ロード用モデルの表示
	chara プットオブジェ ロード用Ｗ０１ｂ -m w01f_w01b -r 0,0,0 -p 0,0,0 -l d:LT2_NAME -s 100,100,100
	chara プットオブジェ ロード用Ｗ０１ａ１ -m w01f_w01a_1 -r 0,0,0 -p 0,0,0 -l d:LT2_NAME -s 100,100,100
	chara プットオブジェ ロード用Ｗ０１ａ２ -m w01f_w01a_2 -r 0,0,0 -p 0,0,0 -l d:LT2_NAME -s 100,100,100
	chara プットオブジェ ロード用Ｗ０２ａ１ -m w01f_w02_1 -r 0,0,0 -p 0,0,0 -l d:LT2_NAME -s 100,100,100
	chara プットオブジェ ロード用Ｗ０２ａ２ -m w01f_w02_2 -r 0,0,0 -p 0,0,0 -l d:LT2_NAME -s 100,100,100

/**************************************************************************************/
//	各マップのキャラ設定
/**************************************************************************************/
	command マップ設定 １Ｆリフレッシュルーム -set {
		@常駐キャラ設定							// stdch.h
		@ローカル変数初期化
		@A_プレイヤー設定 sna_a01f rai_a01f		// a_stdproc.h
	}

	// アナザー用プロック マップ設定後に設定する
	@アナザー用マップ定義後設定					// a_mode.h

	// １Ｆリフレッシュルーム
	command マップ設定 １Ｆリフレッシュルーム -set{

		@跳弾設定
		@居住区１Ｆカメラ設定

		//@居住区１Ｆ敵兵設定

		//@解体Ｃ４設置

		@エルード設定
		@天井
		@フォグ

		@ロード時のマップ表示
		@リフレッシュルームマップ切替
		@リフレッシュルームの床のＯＮ／ＯＦＦ

	// エフェクト

		@でかガラスオブジェクト
		@ミニバー棚壊れ酒瓶オブジェクト
		@ポプラの樹オブジェクト
		@ミニバー両開き扉オブジェクト
		@雑誌
		@大テレビ
		@アイスボックス

		@窓から見える雨エフェクト

		@植木用透明壁
		@中央階段での天井のＯＮ／ＯＦＦ

	//ドアトラップ
	//	@１Ｆ左舷廻廊ドア
		@水密ドア設定
		@１Ｆ右舷廻廊ドア
		@２Ｆ左舷廻廊ドア
		@２Ｆ右舷廻廊ドア
		@エンジンルーム左舷ドア
		@エンジンルーム右舷ドア
	// ロードトラップ
	//	@左舷から居住区１階左舷廻廊部へロード	// 水密ドアに変更
		@右舷から居住区１階右舷廻廊部へロード
		@中央階段から居住区２階左側へロード
		@中央階段から居住区２階右側へロード
		@左舷地下からエンジンルーム左側へロード
		@右舷地下からエンジンルーム右側へロード

	// カメラ設定
		@子画面設定
		@リフレッシュルームカメラ
		@ミニバー下カメラ
		@中央階段カメラ
		@リフレッシュルーム前通路西カメラ
		@リフレッシュルーム前通路東カメラ
		@中央階段横左カメラ
		@中央階段横右カメラ
		@左舷カメラ
		@右舷カメラ

		@中央階段下スペースカメラ
		@中央階段下スペース匍匐カメラ
		@大ガラス付近カメラ

		@ミニバー前カメラ
		@ミニバーカメラ
		@リフレッシュルーム左部屋カメラ
		// tv
		@リフレッシュルーム左部屋カメラ
		// b1
		@エンジンルームへの左舷階段カメラ上
		@エンジンルームへの左舷階段カメラ下
		@エンジンルーム左舷出入口カメラ
		@エンジンルームへの右舷階段カメラ上
		@エンジンルームへの右舷階段カメラ下
		@エンジンルーム右舷出入口カメラ

	// サウンド
		@サウンド変更
		@窓際の雨音

		//@タンカーデジカメ写真判定
		@ブンブン羽虫
		@大ガラス用透明壁
	#ifndef d:TGS2001F
		@エンジン前コンテナ塞ぎ
	#endif

		if( $s:選択プレイヤー == ライデン ){
			@シナリオデモキャラセット
			@水密ドア取れるハンドル
		}

	// デバッグ用
	#if d:MY_DEBUG
		@遠近ぼかしセット
		//@写真撮影用スクリーンショット
		@ＵＳＢキーボードセット
	#endif
	}

	// 最後に行う処理
	command マップ設定 １Ｆリフレッシュルーム -set{
		@座標取得
		@キャラ専用環境光設定
	}

/***************************************************************************************************/
// マップの表示
/***************************************************************************************************/
	command マップ表示 -show １Ｆリフレッシュルーム

/***************************************************************************************************/
// ステージ開始時処理
/***************************************************************************************************/
// 全てのセットが終わったところでフェードイン
	if( $s:登場ポイント == 居住区一階左舷からロード ) {
		@ステージ開始時処理（ステージ名表示） \
			d:LOAD_TYPE:WT_DOOR_TYPE \
			西側廻廊部水密ドア \
			(1300+1500+150) \
			d:DEFAULT_M_TYPE \
			d:wn_船橋一階リフレッシュルーム左舷

	} else if( $s:登場ポイント == 居住区一階右舷からロード ) {
		@ステージ開始時処理（ステージ名表示） \
			d:LOAD_TYPE:SL_DOOR_TYPE \			// タイプ
			１Ｆ右舷廻廊ドア \					// ドア名
			1475 \								// 移動距離
			d:DEFAULT_M_TYPE \					// モーションタイプ
			d:wn_船橋一階リフレッシュルーム右舷	// 表示文字

	} else if( $s:登場ポイント == 居住区二階右からロード ) {
		@ステージ開始時処理（ステージ名表示） \
			d:LOAD_TYPE:SL_DOOR_TYPE \
			２Ｆ右舷廻廊ドア \
			1500 \
			d:DEFAULT_M_TYPE \
			d:wn_船橋一階リフレッシュルーム

	} else if( $s:登場ポイント == 居住区二階左からロード ) {
		@ステージ開始時処理（ステージ名表示） \
			d:LOAD_TYPE:SL_DOOR_TYPE \
			２Ｆ左舷廻廊ドア \
			1650 \
			d:DEFAULT_M_TYPE \
			d:wn_船橋一階リフレッシュルーム
	} else if( $s:登場ポイント == エンジンルーム右舷からロード ){
		@ステージ開始時処理（ステージ名表示） \
			d:LOAD_TYPE:SL_DOOR_TYPE \
			ドア名必要なし \
			2250 \
			d:DEFAULT_M_TYPE \
			d:wn_機関室右舷入口
		mesg プットオブジェ １Ｆ床 off
	} else if( $s:登場ポイント == エンジンルーム左舷からロード ){
		@ステージ開始時処理（ステージ名表示） \
			d:LOAD_TYPE:SL_DOOR_TYPE \
			ドア名必要なし \
			2250 \
			d:DEFAULT_M_TYPE \
			d:wn_機関室左舷入口
		mesg プットオブジェ １Ｆ床 off
	} else {
		#if d:DEBUG_PRINT
			@デバッグ用オールタナティブミッション表示
		#endif
	}

/***************************************************************************************/
// ローカル変数初期化
/***************************************************************************************/
	proc ローカル変数初期化 {
		eval( $b:w01f_羽虫レーションゲッ虫回数 = 0 )
		eval( $f:a01f_ドア取れフラグ = 0 )
	}

/***************************************************************************************/
// ハンドル取れるイベント
/***************************************************************************************/
	proc 水密ドア取れるハンドル {
		chara プットモーションモデル 取れるハンドル \
			-pos  -10800 0 -10980 \
			-dir 0 \
			-kms w01asdr_handle3 \
			-mar wtdoor_break_rai \
			-number 0 \
			//-status	( 0x04 | 0x08 )
			-status d:PUT_MOT_WAIT

		mesg プットモーションモデル 取れるハンドル 非表示

	}

	proc ドア取れイベント発動チェック {

		print 'ドア取れイベントチェック'

		if( `@シナリオデモ用安全チェック` && !$f:a01f_ドア取れフラグ) {
			eval( $f:a01f_ドア取れフラグ = 1 )
			#if d:VAR_SAVE
				command varsave $f:a01f_ドア取れフラグ
			#endif

			@シナリオデモ開始処理
			mesg コマンダー 敵兵セット 視界オン		// 視界は見えたまま
			@ドア取れイベント安全確認監視

			// 水密ドアのハンドルを非表示
			mesg 水密ドア 西側廻廊部水密ドア handle 0

			// 取れるモーションの表示
			mesg プットモーションモデル 取れるハンドル 表示

			// プレイヤーのモーション発動
			mesg プレイヤー d:PLAYER motion \
				d:モーションリスト:sna_non_hatch_pop_out \
				0 \	// 初期方向
				-1 \	// 終了方向
				0 \		// 終了姿勢(立ち)
				( d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT | d:FA_NO_WEAPON ) \
				-10798 (-11680-0) 1000	//x,z,yの順

			// ハンドルのモーション発動
			mesg プットモーションモデル 取れるハンドル 終了判定  0

			// 終了プロックの登録
			command	強制モーション終了プロック \
				-motion d:モーションリスト:sna_non_hatch_pop_out \
				-proc 取れるハンドル終了プロック

			chara デモキャンセルチェック Ch_ハンドルイベントキャンセル \
				-p Pr_ハンドルイベントキャンセル

			// カメラの設定
			chara カメラ設定 シナリオカメラ \
				-c 1 \
				-p -10194,1996,-13750 -t -10717,995,-11484 \
				-r 265,3948,0 -f 2532 \
				-a 224 \
				-i 1 1 0 0 \
				-s 1
		} else {
			command 水密ドア状態 -n 西側廻廊部水密ドア
			mesg プレイヤー d:PLAYER wt_door 西側廻廊部水密ドア $status 0,1024 -11375,-10950 1
		}

	}

	proc ドア取れイベント安全確認監視 {
		chara プロック連続実行 ドア取れイベント安全確認連続実行 -time -1 -exec {
			if( `@シナリオデモ安全チェック` ) {
				print 'やばい！作戦は中止だ'
				mesg プロック連続実行 ドア取れイベント安全確認連続実行 kill
				@Pr_ハンドルイベントキャンセル
			}
		}
	}

	proc Pr_ハンドルイベントキャンセル {
		print 'ハンドルイベントキャンセル'

		mesg デモキャンセルチェック Ch_ハンドルイベントキャンセル kill

		command 強制モーションキャンセル
	}

	proc 取れるハンドル終了プロック {
		print 'ハンドルデモ終了プロック start'

		mesg デモキャンセルチェック Ch_ハンドルイベントキャンセル kill

		mesg 水密ドア 西側廻廊部水密ドア handle 1
		mesg プットモーションモデル 取れるハンドル 非表示

		@カメラＯＦＦ シナリオカメラ
		@シナリオデモ終了処理

		print 'ハンドルデモ終了プロック end'
	}

/***************************************************************************************************/
// 子画面設定
/***************************************************************************************************/
	proc 子画面設定 {
		chara サブ画面 子画面
	}

/***************************************************************************************************/
// マップ切り替え
/***************************************************************************************************/

	proc ロード時のマップ表示 {
		if( $i:プレイヤー初期Ｘ位置 < 0 ){
			if( $i:プレイヤー初期Ｙ位置 >= 3000 ){
				print '2F'
				mesg  プットオブジェ ＴＶスペース on
				mesg  プットオブジェ ミニバー on
				mesg  プットオブジェ Ｂ１スペース off
			}else if( $i:プレイヤー初期Ｙ位置 >= 0 ){
				print '1F'
				mesg  プットオブジェ ＴＶスペース off
				mesg  プットオブジェ ミニバー on
				mesg  プットオブジェ Ｂ１スペース on
			}else{
				print 'B1'
				mesg  プットオブジェ ＴＶスペース off
				mesg  プットオブジェ ミニバー on
				mesg  プットオブジェ Ｂ１スペース on
			}
		}else{
			if( $i:プレイヤー初期Ｙ位置 >= 3000 ){
				print '2F'
				mesg  プットオブジェ ＴＶスペース on
				mesg  プットオブジェ ミニバー on
				mesg  プットオブジェ Ｂ１スペース off
			}else if( $i:プレイヤー初期Ｙ位置 >= 0 ){
				print '1F'
				mesg  プットオブジェ ＴＶスペース on
				mesg  プットオブジェ ミニバー off
				mesg  プットオブジェ Ｂ１スペース on
			}else{
				print 'B1'
				mesg  プットオブジェ ＴＶスペース on
				mesg  プットオブジェ ミニバー off
				mesg  プットオブジェ Ｂ１スペース on
			}
		}
	}

	proc リフレッシュルームマップ切替 {

		mesg プットオブジェ ＴＶスペース on
		mesg プットオブジェ ミニバー on
		mesg プットオブジェ Ｂ１スペース on

	}

/***************************************************************************************/
// 跳弾の設定
/***************************************************************************************/
	proc 跳弾設定 {
		command 弾痕ノーマル -n 0
		command 弾痕ノーマル -n 1
		command 弾痕ノーマル -n 2
		command 弾痕ノーマル -n 3
		command 弾痕ノーマル -n 4

		command 跳弾ノーマル -n 0
		command 跳弾ノーマル -n 1
		command 跳弾ノーマル -n 2
		command 跳弾ノーマル -n 3
		//command 跳弾ノーマル -n 4
		command 跳弾ＳＥのみ -n 4

		// 水蒸気の番号設定
		command 弾痕ノーマル -n 5
		command 弾痕ノーマル -n 6
		command 弾痕ノーマル -n 7
		command 跳弾水蒸気小 -n 5
		command 跳弾水蒸気中 -n 6
		command 跳弾水蒸気大 -n 7
	}

/***************************************************************************************/
// トラップカメラ設定
/***************************************************************************************/

	proc 居住区１Ｆカメラ設定 {

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0
		chara カメラ 通路カメラ０		-c 0 -l 2 -p 10
		chara カメラ 通路カメラ１		-c 0 -l 2 -p 20
		chara カメラ もっとロードカメラ	-c 0 -l 2 -p 0
		chara カメラ ロードカメラ		-c 0 -l 2 -p 1
		chara カメラ シナリオカメラ		-c 0 -l 2 -p 2
		chara カメラ モーションカメラ	-c 0 -l 2 -p 5
		chara カメラ エルードカメラ		-c 0 -l 2 -p 4
		chara カメラ クリアリングカメラ	-c 1 -l 2 -p 0
		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \
			-b -32000,-32000,-32000 32000,32000,32000 \
			-l -32000,-32000,-32000 32000,32000,32000 \
			-r 640,2048,0 \
			-f 6000 \
			-a 200 \
			-i 1 -1 0 0 \
			-s 1

		// ステージ開始時のカメラ設定
		if( $s:登場ポイント == 居住区一階左舷からロード ) {
			chara カメラ設定 ロードカメラ \
				-c 0 \
				-p -10750,1574,-11752 -t -10750,1554,-11850 \
				-r 127,2048,0 -f 100 \
				-a 170 \
				-z d:CAMERA_NO_CUSHION \
				-i 0 2 0 0 \
				-s 1

			chara delay ロードカメラＯＦＦディレイ -time 90 -exec {
				chara カメラ設定 ロードカメラ -s -1
			}
		}
	}

	proc リフレッシュルームカメラ {
		trap ca000 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				if( $4 < -3734 || $4 > 3734 ){
					eval( $w:カメラ補完方式 = 2 )
				}else{
					eval( $w:カメラ補完方式 = 0 )
				}
				@CS_スムーズカメラ昇順 $6 -19150 -16918 4153 4619
					eval( $i:補完ＢＸ = $i:CS_結果１ )
					eval( $i:補完ＬＸ = $i:CS_結果１ )

				@CS_スムーズカメラ昇順 $6 -18000 -17000 -15924 -15200
					eval( $i:補完ＢＺ = $i:CS_結果１ )

				@CS_スムーズカメラ昇順 $6 -18000 -17000 -18258 -15900
					eval( $i:補完ＬＺ = $i:CS_結果１ )

				chara カメラ設定 通路カメラ１ \
					-c 0 \
					-b -20000 -5000 $i:補完ＢＺ   $i:補完ＢＸ 5000 $i:補完ＢＺ \
					-l -20000 -5000 $i:補完ＬＺ   $i:補完ＬＸ 5000 $i:補完ＬＺ \
					-r 770 2048 0 -f 4964 \
					-a 200 \
					-i $w:カメラ補完方式 -1 0 0 \
					-s $3 \
					-slide 0 5 1000 1000 50 1\
			}
	}

	// 新カメラ設定 ca100からスタート
	proc 中央階段下スペースカメラ {
		trap ca100 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				if( $3 == 入る)	{
					if( $i:前フレーム位置Ｘ < -5000 || $i:前フレーム位置Ｘ > 5000 ){
						if( $i:カメラ切替 == 43 )	{ eval( $w:補完方式 = 1 ) } \
						else						{ eval( $w:補完方式 = 0 ) }
					}else{
						eval( $w:補完方式 = 1 )
					}
				}

				@CS_スムーズカメラ降順 $4 4953 3000 0 1000
					eval( $i:スライド距離Ｌ = $i:CS_結果１ )
				@CS_スムーズカメラ昇順 $4 -4953 -3000 0 1000
					eval( $i:スライド距離Ｒ = $i:CS_結果１ )

				chara カメラ設定 通路カメラ１ \
					-c 0 \
					-b -3361 5159 -10522   3361 5159 -10522 \
					-l -3361 1305 -12264   3361 1305 -12264 \
					-r 424,2048,0 -f 4688 \
					-a 200 \
					-i $w:補完方式 -1 0 0 \
					-slide 0 10 $i:スライド距離Ｌ $i:スライド距離Ｒ 50 0 \
					-s $3
		}
	}

	proc 中央階段下スペース匍匐カメラ {
		trap ca107 d:PLAYER \
			-mask ＊ \
			-camera \
			-state d:TRP_STATE_GROUND \
			-exec {
	/*
	-p 1707,2757,-11085 -t 1707,2060,-12139 \
	-r 381,2048,0 -f 1264 \
	-a 200 \
	*/
				chara カメラ設定 通路カメラ０ \
				-c 0 \
	//			-b -4000 2750 -11000   4000 2750 -11000 \
				-b $4 2750 -11000   $4 2750 -11000 \
	//			-l -4000 2060 -12139   4000 2060 -12139 \
				-l $4 2060 -12139   $4 2060 -12139 \
				-r 320,2048,0 -f 4852 \
				-a 200 \
				-i 2 -1 0 0 \
	//			-slide 0 10 1000 1000 50 0 \
				-s $3
			}
	}

	proc リフレッシュルーム前通路西カメラ {
		trap ca004 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				if( `command PlayerStatus -f d:TRP_STATE_GROUND` ){
					@CS_スムーズカメラ昇順 $4 -8876 -8168 0 700
						eval( $i:スライド距離Ｒ = $i:CS_結果１ )
						eval( $i:スライド距離Ｌ = 700 )
				}else{
					@CS_スムーズカメラ昇順 $4 -8876 -8168 0 1000
						eval( $i:スライド距離Ｒ = $i:CS_結果１ )
						eval( $i:スライド距離Ｌ = 1000 )
				}

				chara カメラ設定 通路カメラ０ \
					-c 0 \
					-b -8168,4787,-12413   -4100,4787,-12413 \
					-l -8168,1607,-13071   -4100,1607,-13071\
					-r 891,2048,0 -f 3247 \

					-a 200 \
					-i 0 -1 0 0 \
					-slide 0 10 $i:スライド距離Ｌ $i:スライド距離Ｒ 50 0\
					-s $3
				// カメラ切替設定 ca100で使用
				if( ($w:プレイヤー方向 > 512) && ($w:プレイヤー方向 < 1536) ){	// 東を向いていたら
					if( $i:カメラ切替 < 43 ){
						eval( $i:カメラ切替 = ( $i:カメラ切替 + 1 ) )
					}
				}else{
					eval( $i:カメラ切替 = 0 )
				}
			}
	}

	proc リフレッシュルーム前通路東カメラ {
		trap ca005 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				if( `command PlayerStatus -f d:TRP_STATE_GROUND` ){	// 匍匐中
					@CS_スムーズカメラ降順 $4 8876 8168 0 700
					eval( $i:スライド距離Ｌ = $i:CS_結果１ )
					eval( $i:スライド距離Ｒ = 700 )
				}else{
					@CS_スムーズカメラ降順 $4 8876 8168 0 1000
					eval( $i:スライド距離Ｌ = $i:CS_結果１ )
					eval( $i:スライド距離Ｒ = 1000 )
				}

				chara カメラ設定 通路カメラ０ \
					-c 0 \
					-b 4100,4787,-12413   8168,4787,-12413 \
					-l 4100,1607,-13071   8168,1607,-13071\
					-r 891,2048,0 -f 3247 \

					-a 200 \
					-i 0 -1 0 0 \
					-slide 0 10 $i:スライド距離Ｌ $i:スライド距離Ｒ 50 0\
					-s $3
				// カメラ切替設定 ca100で使用
				if( ($w:プレイヤー方向 > 2560) && ($w:プレイヤー方向 < 3584) ){	// 西を向いていたら
					if( $i:カメラ切替 < 43 ){
						eval( $i:カメラ切替 = ( $i:カメラ切替 + 1 ) )
					}
				}else{
					eval( $i:カメラ切替 = 0 )
				}
			}
	}

	proc 大ガラス付近カメラ{
		trap ca106 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				if( $3 == 入る ){
				// 南から入った場合
					if( ($w:プレイヤー方向 < 3072) && ($w:プレイヤー方向 > 1024) ) {
						eval( $w:補完方式 = 1 )
				// 北から入った場合
					}else{
						if( $4 < -3734 || $4 > 3734 ){
							eval( $w:補完方式 = 1 )
						}else{
							eval( $w:補完方式 = 0 )
						}
					}
				}
				// スライド距離の設定
				if( $w:プレイヤー方向 < 2048 ){		// プレイヤーが右向きなら
					@CS_スムーズカメラ昇順 $4 -4945 -3909 0 1000
						eval( $i:スライド距離 = $i:CS_結果１ )
				}else{								// プレイヤーが左向きなら
					@CS_スムーズカメラ降順 $4 4945 3909 0 1000
						eval( $i:スライド距離 = $i:CS_結果１ )
				}
				// カメラ補完の設定
				@CS_スムーズカメラ降順 $6 -14000 -14750 3600 4000
						eval( $i:補完ＰＸ = $i:CS_結果１ )
				if( $6 > -15500 ){
					@CS_スムーズカメラ昇順 $6 -14250 -13750 2576 5159
						eval( $i:補完ＢＹ = $i:CS_結果１ )
					@CS_スムーズカメラ昇順 $6 -14250 -13750 -11367 -10522
						eval( $i:補完ＢＺ = $i:CS_結果１ )
					@CS_スムーズカメラ昇順 $6 -14250 -13750 1055 1305
						eval( $i:補完ＬＹ = $i:CS_結果１ )
					@CS_スムーズカメラ昇順 $6 -14250 -13750 -14699 -12264
						eval( $i:補完ＬＺ = $i:CS_結果１ )
				}else{
					@CS_スムーズカメラ降順 $6 -15500 -17500 2576 2147
						eval( $i:補完ＢＹ = $i:CS_結果１ )
					@CS_スムーズカメラ降順 $6 -15500 -17500 -11367 -13099
						eval( $i:補完ＢＺ = $i:CS_結果１ )
					@CS_スムーズカメラ降順 $6 -15500 -17500 1055 1015
						eval( $i:補完ＬＹ = $i:CS_結果１ )
					@CS_スムーズカメラ降順 $6 -15500 -17500 -14699 -15539
						eval( $i:補完ＬＺ = $i:CS_結果１ )
				}

				chara カメラ設定 通路カメラ０ \
					-c 0 \
					-b (-$i:補完ＰＸ) $i:補完ＢＹ $i:補完ＢＺ   $i:補完ＰＸ $i:補完ＢＹ $i:補完ＢＺ \
					-l (-$i:補完ＰＸ) $i:補完ＬＹ $i:補完ＬＺ   $i:補完ＰＸ $i:補完ＬＹ $i:補完ＬＺ \

					-r 279 2048 0 -f 3663 \
					-a 200 \
					-i $w:補完方式 -1 0 0 \
					-slide 0 10 $i:スライド距離 $i:スライド距離 50 0\
					-s $3
		}
	}

	proc ミニバー前カメラ {
		trap ca102 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ昇順 $6 -18000 -17000 -15924 /*-15200*/-15150
