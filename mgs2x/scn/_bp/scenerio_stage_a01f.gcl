/***************************************************************************************************/
// オブジェクトのproc化
/***************************************************************************************************/
	proc 天井 {
		chara 天井君 １Ｆ天井 -m w01fr -h 2700 -p 0,0,0 -l d:LT2_NAME
		chara 天井君 ２Ｆ天井 -m w01fr2 -h 5800 -p 0,0,0 -l d:LT2_NAME
		chara 天井君 Ｂ１天井 -m w01fr4 -h -1000 -p 0,0,0 -l d:LT2_NAME
		chara プットオブジェ １Ｆ天井（プットオブジェ） -m w01fr -r 0,0,0 -p 0,0,0 -l d:LT2_NAME -s 100,100,100
		mesg  プットオブジェ １Ｆ天井（プットオブジェ） off
	//	chara プットオブジェ ミニバー天井 -m w01fr3 -r 0,0,0 -p 0,0,0 -l d:LT2_NAME -s 100,100,100
		//mesg  プットオブジェ ミニバー天井 on

		chara 天井君 ミニバー天井君 -m w01fr3 -h 2800 -p 0,0,0 -l d:LT2_NAME
	}


	proc 中央階段での天井のＯＮ／ＯＦＦ {
		trap ob001 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				if( $3 == 出る ){
					mesg プットオブジェ １Ｆ天井（プットオブジェ） off
				}else{
					if( $6 > -11200 ){
						if( $5 < 1200 ){
							mesg プットオブジェ １Ｆ天井（プットオブジェ） off
						}else{
							mesg プットオブジェ １Ｆ天井（プットオブジェ） on
						}
					}else{
						mesg プットオブジェ １Ｆ天井（プットオブジェ） off
					}
				}
				if( $4 < -1700 || $4 > 1700){
					if( $5 < 2000 ){
						mesg プットオブジェ １Ｆ天井（プットオブジェ） off
					}
				}
			}
	}

	proc でかガラスオブジェクト {
		chara プット大ガラスオブジェ でかガラス \
			-m w01f_gw2 break7d glass_pce -p 0,0,0 -l w01f \
			-broken $f:壊れフラグ＿でかガラス \
			-c ガラス割れ後サウンド設定
	}

