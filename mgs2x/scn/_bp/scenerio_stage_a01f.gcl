	proc ミニバーカメラ {
		trap ca103 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				if( $4 < /*7215*/6800 ){
					eval( $i:補完ＰＸ = /*7215*/6800 )
				}else if( $4 > 7954){
					eval( $i:補完ＰＸ = 7954 )
				}else{
					eval( $i:補完ＰＸ = $4 )
				}

				chara カメラ設定 通路カメラ１ \
					-c 1 \
					-p 7788,4111,-14022 -t 7788,950,-17510 \
					-r 480,2048,0 -f 4707 \
					-a 208 \
					-i 0 0 0 0 \
					-s $3
		}
	}

	proc リフレッシュルーム左部屋カメラ {
		trap ca104 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {

					if( $3 == 入る ){
						eval( $f:カメラフラグ = 1 )
					}

					if( $4 < -7000 ){
						eval( $f:カメラフラグ = 0 )
					}

					if( $f:カメラフラグ == 1 ){
						chara カメラ設定 通路カメラ１ \
							-c 1 \
							-p -7105,6181,-14989 -t -7105,1463,-16515 \
							-r 820,2048,0 -f 4959 \
							-a 200 \
							-i 1 -1 0 0 \
							-s $3
					}else{
						@CS_スムーズカメラ昇順 $4 -7000 -6500 -7105 -4814
							eval( $i:補完ＰＸ = $i:CS_結果１ )

						chara カメラ設定 通路カメラ１ \
							-c 1 \
							-p $i:補完ＰＸ,6181,-14989 \
							-t $i:補完ＰＸ,1463,-16515 \
							-r 820,2048,0 -f 4959 \
							-a 200 \
							-i 1 -1 0 0 \
							-s $3
					}
			}
	}

	// リフレッシュルーム室内（東側ミニバースペース匍匐専用）（ca001）
	proc ミニバー下カメラ {
