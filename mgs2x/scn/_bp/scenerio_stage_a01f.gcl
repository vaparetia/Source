	proc 中央階段カメラ {
		trap ca003 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				if( $4 < -3155 ){
					eval( $i:補完ＢＸ = -3155 )
				}else if( $4 > 3155 ){
					eval( $i:補完ＢＸ = 3155 )
				}else{
					eval( $i:補完ＢＸ = $4 )
				}
				@CS_スムーズカメラ昇順 $6 -11976 -10700 3200 6694
					eval( $i:補完ＢＹ = $i:CS_結果１ )
				@CS_スムーズカメラ昇順 $6 -11976 -10700 1400 2055
					eval( $i:補完ＬＹ = $i:CS_結果１ )
				@CS_スムーズカメラ昇順 $6 -11976 -10700 -9183 -8178
					eval( $i:補完ＢＺ = $i:CS_結果１ )
				@CS_スムーズカメラ昇順 $6 -11976 -10700 -11793 -9686
					eval( $i:補完ＬＺ = $i:CS_結果１ )

				chara カメラ設定 通路カメラ１ \
					-c 0\
					-b $i:補完ＢＸ $i:補完ＢＹ $i:補完ＢＺ   $i:補完ＢＸ $i:補完ＢＹ $i:補完ＢＺ \
					-l $i:補完ＢＸ $i:補完ＬＹ $i:補完ＬＺ   $i:補完ＢＸ $i:補完ＬＹ $i:補完ＬＺ \
					-r 819,2048,0 -f 4878 \
					-a 200 \
					-i 1 -1 0 0 \
					-s $3
			}

		trap ca108 d:PLAYER \
