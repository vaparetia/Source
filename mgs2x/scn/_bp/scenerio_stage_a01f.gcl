	/***************************************************************************************************/
	// 水密ドアの設定
	/***************************************************************************************************/

	proc 水密ドア設定{
		if( `@スネーク達` ) {
			eval( $s:ローカル変数Ｓ１ = sna_hatch )
		} else {
			eval( $s:ローカル変数Ｓ１ = rai_wt_hatch )
		}

		chara 水密ドア管理 水密ドア管理人 \
			-n 1 \
			-seno 1 \
			-motions $s:ローカル変数Ｓ１ hatch_door_sna hatch_handle_sna

		@左舷廻廊への水密ドア
	}

	proc 左舷廻廊への水密ドア {

		if( $$b:ドアフラグ[1] == d:DOOR_FLAG_OPEN ) {
			if( $s:選択プレイヤー == ライデン ){
				// ライデンの時は一方通行
				if( $s:登場ポイント == 居住区一階左舷からロード ) {
					eval( $i:ローカル変数Ｉ１ = ( d:WT_DOOR_FLAG_OPEN_START | d:WT_DOOR_FLAG_NOT_OPEN ) )
				}else{
					eval( $i:ローカル変数Ｉ１ = d:WT_DOOR_FLAG_NOT_OPEN )
				}
			} else {
				if( $s:登場ポイント == 居住区一階左舷からロード ) {
					eval( $i:ローカル変数Ｉ１ = d:WT_DOOR_FLAG_OPEN_START )
				}else{
					eval( $i:ローカル変数Ｉ１ = d:WT_DOOR_FLAG_NORMAL )
				}
			}
		} else {
			eval( $i:ローカル変数Ｉ１ = d:WT_DOOR_FLAG_NOT_OPEN )
		}

		// ドアフラグを元にモデルを設定
		@ドアモデル名セット 1	d:DR_NAME_WT1 d:DR_NAME_WT2 \
								d:DR_NAME_WT3 d:DR_NAME_WT4 d:DR_NAME_WT5

		chara 水密ドア 西側廻廊部水密ドア \
			-kms $$s:ドアモデル名[1] w01asdr_handle \
			-flag $i:ローカル変数Ｉ１ \
			-position -11375 0 -10950 \
			-type 0 \	// 左軸
			-rotate 0,0,0 \
			-hazard -11550,0,-11100 -10050,0,-11100 \
			-proc 左舷廻廊Ｆから左舷廻廊Ａへロード

		trap dr000 d:PLAYER \
			-mask いる -button d:ACTION_BUTTON -state 0 \
			-exec {
				if( $s:選択プレイヤー == ライデン ){
					@ドア取れイベント発動チェック
				} else {
					command 水密ドア状態 -n 西側廻廊部水密ドア
					mesg プレイヤー d:PLAYER wt_door 西側廻廊部水密ドア $status 0,1024 -11375,-10950 1
				}
		}

		// 西側廻廊部水密ドア回し中のカメラ
		trap dr000 d:PLAYER -mask ？ -state d:TRP_STATE_FORCE \
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p -10808,3817,-11542 -t -10808,141,-11649 \
					-r 1005,2048,0 -f 3677 \
					-a 338 \
					-i 1 1 0 0 \
					-s $3
			}
	}

	proc 左舷廻廊Ｆから左舷廻廊Ａへロード $:トリガ {
	#if d:LOAD_W01A0L
		if( $f:ロードチェックＯＮフラグ == 1 ) {
			if ( $:トリガ == 0 ) {
				chara カメラ設定 ロードカメラ \
					-c 1 \
					-p -10750,4650,-11500 -t -10750,1000,-12000 \
					-r 935,2048,0 -f 3684 \
					-a 200 \
					-i 3 0 0 0 \
					-s 1
				preseek 'a01a'
				@ステージ終了時処理（ステージ名表示） \
					-10750 0 -9000 \
					d:SOUTH \
					mv_a01f_a01a_0x \
					d:DEFAULT_M_TYPE \
					d:wn_船橋一階居住区左舷
			}
		}
	#endif
	}

	/***************************************************************************************************/
	// トラップドア
	/***************************************************************************************************/

	////////////////////////
	// １Ｆ右ドア （ドア０）
	proc １Ｆ右舷廻廊ドア {
		/*
		if( $f:a01f_ドアフラグ[0] == d:DOOR_FLAG_OPEN ) {
			eval( $s:a01f_ドアモデル名[0] = d:DOOR_MODEL_1F_R_00 );
			eval( $b:a01f_ドアレベル[0] = 0 );
		} else {
			eval( $s:a01f_ドアモデル名[0] = d:DOOR_MODEL_1F_R_99 );
			eval( $b:a01f_ドアレベル[0] = 99 );
		}
		*/

		// ドアフラグを元にモデルを設定
		@ドアモデル名セット 0 	d:DR_NAME_1F_R1 d:DR_NAME_1F_R2 \
								d:DR_NAME_1F_R3 d:DR_NAME_1F_R4 d:DR_NAME_1F_R5

		chara ドア 南部右舷回廊へのドア \
			-m $$s:ドアモデル名[0] \
			-d 0 2048 0 \
			-p 11550 0 -11000 \
			-slide 2000 \
			-time d:SD_OPEN_TIME \
			-between １Ｆリフレッシュルーム １Ｆリフレッシュルーム \
			-exec{
				if( !($:開閉フラグ) ){
					mesg プットオブジェ ロード用Ｗ０１ａ２ off
				}else{
					mesg プットオブジェ ロード用Ｗ０１ａ２ on
				}
			}

		trap dr001 ？ -mask ？ \
			-exec {
				if ( $3 == 入る ) {
					mesg ドア 南部右舷回廊へのドア open $2
				} else{
					mesg ドア 南部右舷回廊へのドア close $2
				}
			}

		chara 透明壁 覗きこみ禁止壁１ＦＲ \
				-position	9800,0,-11100,2000 \
							11800,0,-11100,2000 \
				-attribute	( d:HZX_SEG_ATR_ALL & ~(d:HZX_SEG_NO_PLAYER ))

		mesg 透明壁 覗きこみ禁止壁１ＦＲ off

		// 主観時の左右覗き込み操作禁止
		trap dr001 d:PLAYER -mask ＊ \
			-exec {
				if( `command PlayerStatus -f d:TRP_STATE_SUBJECT ` ){
					mesg 透明壁 覗きこみ禁止壁１ＦＲ on
				}else{
					mesg 透明壁 覗きこみ禁止壁１ＦＲ off
				}
			}

		// 敵兵のみを通す透明壁等の設定
		@A_ドア開閉追加設定 南部右舷回廊へのドア \
				$$b:ドアフラグ[0] 11550 0 -11000 d:NORTH 2000
	}

	////////////////////////
	// ２Ｆ右ドア （ドア２）
	proc ２Ｆ右舷廻廊ドア {
		/*
		if( $f:a01f_ドアフラグ[2] == d:DOOR_FLAG_OPEN ) {
			eval( $s:a01f_ドアモデル名[2] = d:DOOR_MODEL_2F_R_00 );
