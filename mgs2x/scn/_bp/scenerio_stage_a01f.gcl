	//////////////////////
	// Ｂ１右ドア（ドア４）
	proc エンジンルーム右舷ドア {
		/*
		if( $f:a01f_ドアフラグ[4] == d:DOOR_FLAG_OPEN ) {
			eval( $s:a01f_ドアモデル名[4] = d:DOOR_MODEL_B1_R_00 );
			eval( $b:a01f_ドアレベル[4] = 0 );
