			eval( $b:a01f_ドアレベル[4] = 99 );
		}
		*/
		// ドアフラグを元にモデルを設定
		@ドアモデル名セット 4 	d:DR_NAME_1F_R1 d:DR_NAME_1F_R2 \
								d:DR_NAME_1F_R3 d:DR_NAME_1F_R4 d:DR_NAME_1F_R5

		chara ドア 右舷エンジンルームへのドア \
			-m $$s:ドアモデル名[4] \
			-d 0 1024 0 \
			-p 10600 -5000 -10500 \
			-slide 2000 \
			-time d:SD_OPEN_TIME \
			-between １Ｆリフレッシュルーム １Ｆリフレッシュルーム

		trap dr003 ？ -mask ＊  \
			-exec {
				if ( $3 == 入る ) {
					mesg ドア 右舷エンジンルームへのドア open $2
				} else if( $3 == 出る ){
					mesg ドア 右舷エンジンルームへのドア close $2
				}
			}

		// 主観時の左右覗き込み操作禁止
		chara 透明壁 覗きこみ禁止壁Ｂ１Ｒ \
				-position	10750,-5000,-12000,2000 \
							10750,-5000,-10500,2000 \
				-attribute		( d:HZX_SEG_ATR_ALL & ~(d:HZX_SEG_NO_PLAYER ))

		mesg 透明壁 覗きこみ禁止壁Ｂ１Ｒ off

		trap dr003 d:PLAYER -mask ＊ \
			-exec {
				if( `command PlayerStatus -f d:TRP_STATE_SUBJECT ` ){
					mesg 透明壁 覗きこみ禁止壁Ｂ１Ｒ on
				}else{
					mesg 透明壁 覗きこみ禁止壁Ｂ１Ｒ off
				}
			}
		// 敵兵のみを通す透明壁等の設定
		@A_ドア開閉追加設定 右舷エンジンルームへのドア \
				$$b:ドアフラグ[4] 10600 -5000 -10500 d:EAST 2000
	}

	//////////////////////
	// Ｂ１右ドア（ドア４）
	proc エンジンルーム左舷ドア {
		/*
		if( $f:a01f_ドアフラグ[5] == d:DOOR_FLAG_OPEN ) {
			eval( $s:a01f_ドアモデル名[5] = d:DOOR_MODEL_B1_L_00 );
			eval( $b:a01f_ドアレベル[5] = 0 );
		} else {
			eval( $s:a01f_ドアモデル名[5] = d:DOOR_MODEL_2F_L_99 );
			eval( $b:a01f_ドアレベル[5] = 99 );
		}
		*/
		// ドアフラグを元にモデルを設定
		@ドアモデル名セット 5 	d:DR_NAME_1F_R1 d:DR_NAME_1F_R2 \
								d:DR_NAME_1F_R3 d:DR_NAME_1F_R4 d:DR_NAME_1F_R5

		chara ドア 左舷エンジンルームへのドア \
			-m $$s:ドアモデル名[5] \
			-d 0 1024 0 \
			-p -10600 -5000 -10500 \
			-slide 2000 \
			-time d:SD_OPEN_TIME \
			-between １Ｆリフレッシュルーム １Ｆリフレッシュルーム \
			-exec{
				if( !($:開閉フラグ) ){	// 扉が完全に閉まったら
					mesg プットオブジェ ロード用Ｗ０２ａ１ off
				}else{
					mesg プットオブジェ ロード用Ｗ０２ａ１ on
				}
			}

		trap dr002 ？ -mask ＊ \
			-exec {
				if ( $3 == 入る ) {
					mesg ドア 左舷エンジンルームへのドア open $2
				} else if( $3 == 出る ){
					mesg ドア 左舷エンジンルームへのドア close $2
				}
			}

		// 主観時の左右覗き込み操作禁止
		chara 透明壁 覗きこみ禁止壁Ｂ１Ｌ \
				-position	-10750,-5000,-12000,2000 \
							-10750,-5000,-10500,2000 \
				-attribute	( d:HZX_SEG_ATR_ALL & ~(d:HZX_SEG_NO_PLAYER ))

		mesg 透明壁 覗きこみ禁止壁Ｂ１Ｌ off

		trap dr002 d:PLAYER -mask ＊ /*-d 1024 256*/ \
			-exec {
				if( `command PlayerStatus -f d:TRP_STATE_SUBJECT ` ){
					//command パッド操作 -which 0 -mask ( d:PAD_L2 | d:PAD_R2 )
					mesg 透明壁 覗きこみ禁止壁Ｂ１Ｌ on
				}else{
					//command パッド操作 -which 0 -cancel 2
					mesg 透明壁 覗きこみ禁止壁Ｂ１Ｌ off
				}
			}

		// 敵兵のみを通す透明壁等の設定
		@A_ドア開閉追加設定 左舷エンジンルームへのドア \
				$$b:ドアフラグ[5] -10600 -5000 -10500 d:EAST 2000
	}

	/***************************************************************************************************/
	// 入出ロードのproc化
	/***************************************************************************************************/
	proc ロードプロック {
		if ($s:呼び出しプロック == mv_a01f_a02a3_1) {
			@mv_a01f_a02a3_1
		} else if ($s:呼び出しプロック == mv_a01f_a02a0_0) {
			/*
			if ( $f:w02a_レイブンイベントフラグ == 0 ){
				if($w:アラートモード != d:ALERT_MODE_SENNYU ) {
					command セットサウンドコード -c d:SNG_FOUTS_S
				}
			}
			*/
			@mv_a01f_a02a0_0
		} else if ($s:呼び出しプロック == mv_a01f_a01a_0x) {
			@mv_a01f_a01a_0x
		} else if ($s:呼び出しプロック == mv_a01f_a01a_1) {
			@mv_a01f_a01a_1
		} else if ($s:呼び出しプロック == mv_a01f_a01b_0x) {
			@mv_a01f_a01b_0x
		} else if ($s:呼び出しプロック == mv_a01f_a01b_1) {
			@mv_a01f_a01b_1
		}
	}

	proc 左舷地下からエンジンルーム左側へロード {
	#if d:LOAD_W02AL
		trap ld000 d:PLAYER -mask 入る \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 1 ) {
					chara カメラ設定 ロードカメラ \
						-c 1 \
						-p -12026,-1000,-10500 -t -12026,-3715,-11223 \
						-r 700,2048,0 -f 3300 \
						-a 200 \
						-i 3 0 0 0 \
						-s $3
					preseek 'a02a'
					@ステージ終了時処理（ステージ名表示） \
						-9500 -5000 -11250 \
						d:EAST \
						mv_a01f_a02a3_1 \
						d:DEFAULT_M_TYPE \
						d:wn_機関室左舷
				}
			}

		// ステージ開始時のカメラ
		trap ld000 d:PLAYER -mask ？ \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 0 ) {
					chara カメラ設定 ロードカメラ \
						-c 1 \
						-p -11912,114,-10500 -t -11912,-2945,-11156 \
						-r 886,2048,0 -f 3128 \
						-a 200 \
						-i 3 0 0 0 \
						-s $3
				}
			}
	#endif
	}

