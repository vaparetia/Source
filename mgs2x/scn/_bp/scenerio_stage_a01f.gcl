/***************************************************************************************************/
// エルード設定
/***************************************************************************************************/
	proc 解体Ｃ４設置 {
		chara 解体Ｃ４ 解体Ｃ４ \
			-position 8000 (1125+450) (-20000+50) \
			-rotate 0,0,1024 \
			-type 1 \	// タイプ（０／１：臭いあり／なし）
			-state 0	// 初期状態（０／１：通常／凍結）
	}

/***************************************************************************************************/
// エルード設定
/***************************************************************************************************/

	proc エルード設定 {
		@左舷エルード設定
	#ifdef d:TGS2001F
		@右舷エルード設定
	#else
		if( $b:ミッション番号 == d:MISSION:スネークテイルズ ) {
			if( !`@スネークテイルズ用コンテナチェック` ) {
				@右舷エルード設定
			}
		} else {
			if( !`@コンテナチェック` ) {
				@右舷エルード設定
			}
		}
	#endif
	}

	proc 左舷エルード設定 {
		trap by001 d:PLAYER \
			-mask いる \
			-button d:ACTION_BUTTON \
			-state 0,4 \	//立ち状態or張り付き
			-exec {
				print 'エルード発動'
				@北向きビヨンド発動 $1 -15000 $4 -11550 -11050 0x00000002
			}

		// エルード 入る
		trap by001_ca d:PLAYER \
			-mask ？ \
			-state 	d:TRP_STATE_FORCE \
			-dir 	2048 256 \
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p -11563,2120,-13378 -t -10368,927,-16276 \
					-r 237,1793,0 -f 3353 \
					-a 200 \
					-i 1 0 0 0 \
					-s 1
			}
		// エルード 出る
		trap by001_ca d:PLAYER \
			-mask ？ \
			-state 	d:TRP_STATE_FORCE \
			-dir 	0 256 \
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p -9903,2411,-15199 -t -10901,1476,-14614 \
					-r 443,3418,0 -f 1487 \
					-a 178 \
					-i 1 0 0 0 \
					-s $3
			}

		// エルード中
		trap by001_ca d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_ELUDE \
			-dir 0 256 \	//方向指定
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p -11190,2004,-18253 -t -10944,265,-15442 \
					-r 360,57,0 -f 3314 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3 \
					-z d:CAMERA_NO_CUSHION
			}
	}

	proc 右舷エルード設定 {
		trap by002 d:PLAYER \
			-mask いる \
			-button d:ACTION_BUTTON \
			-state 0,4 \	//立ち状態or張り付き
			-exec {
				print 'エルード発動'
				@北向きビヨンド発動 $1 -15000 $4 11050 11550 0x00000002
			}

		// エルード 入る
		trap by002_ca d:PLAYER \
			-mask ？ \
			-state 	d:TRP_STATE_FORCE \
			-dir 	2048 256 \
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 11680,2579,-13037 -t 10394,1254,-15176 \
					-r 318,2401,0 -f 2826 \
					-a 200 \
					-i 1 0 0 0 \
					-s 1
			}
		// エルード 出る
		trap by002_ca d:PLAYER \
			-mask ？ \
			-state 	d:TRP_STATE_FORCE \
			-dir 	0 256 \
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 9795,2811,-13798 -t 11516,773,-14695 \
					-r 528,1337,0 -f 2814 \
					-a 200 \
					-i 1 1 0 0 \
					-s $3
			}

		// エルード中
		trap by002_ca d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_ELUDE \
			-dir 0 256 \	//方向指定
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 11288,1660,-17565 -t 11088,-130,-14792 \
					-r 373,4049,0 -f 3306 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3 \
					-z d:CAMERA_NO_CUSHION
			}
	}

/************************************************************************************/
// 壊れ物
/************************************************************************************/

	proc セット壊れフラグ＿エロ雑誌 {
		eval( $f:壊れフラグ＿エロ雑誌 = 1 )
	}

	proc 雑誌 {
		chara プット雑誌オブジェ エロ雑誌 \
				-number 14 \
				-break  book_naka book_hahen \
				-hazard d:BRK_HZD_W01F_TV_SPACE2 \
				-proc セット壊れフラグ＿エロ雑誌 \
				-model  book_moto book  -type 0 -rot 240,0,0  -pos -5145,720,(-16900-600) -light w01f \
				-model  book_moto book  -type 1 -rot 240,0,0  -pos -5145,720,(-16900-400) -light w01f \
				-model  book_moto book  -type 2 -rot 240,0,0  -pos -5145,720,(-16900-200) -light w01f \
				-model  book_moto book  -type 3 -rot 240,0,0  -pos -5145,720,(-16900+0  ) -light w01f \  // 真中
				-model  book_moto book  -type 4 /*-height 1*/ -rot 240,0,0  -pos -5145,720,(-16900+200) -light w01f \	//エロ
				-model  book_moto book  -type 5 -rot 240,0,0  -pos -5145,720,(-16900+400) -light w01f \
				-model  book_moto book  -type 6 -rot 240,0,0  -pos -5145,720,(-16900+600) -light w01f \

				-model  book_moto book  -type 6 -rot 240,0,0  -pos -5145,280,(-16900-600) -light w01f \
				-model  book_moto book  -type 7 -rot 240,0,0  -pos -5145,280,(-16900-400) -light w01f \
				-model  book_moto book  -type 5 -rot 240,0,0  -pos -5145,280,(-16900-200) -light w01f \
				-model  book_moto book  -type 8 -rot 240,0,0  -pos -5145,280,(-16900+0  ) -light w01f \  // 真中
				-model  book_moto book  -type 0 -rot 240,0,0  -pos -5145,280,(-16900+200) -light w01f \
				-model  book_moto book  -type 3 -rot 240,0,0  -pos -5145,280,(-16900+400) -light w01f \
				-model  book_moto book  -type 2 -rot 240,0,0  -pos -5145,280,(-16900+600) -light w01f

		if ( $f:壊れフラグ＿エロ雑誌 )
		{
			mesg プット雑誌オブジェ エロ雑誌 もう壊れている
		}
	}

	proc セット壊れフラグ＿テレビ {
		eval( $f:壊れフラグ＿テレビ = 1 )
	}

	proc 大テレビ {
		chara プットテレビオブジェ テレビ \
				-proc セット壊れフラグ＿テレビ \
				-m tv_back \
				-s 100 \
				-l w01f
		if ( $f:壊れフラグ＿テレビ )
		{
			mesg プットテレビオブジェ テレビ もう壊れている
		}
	}

/***************************************************************************************************/
// 毎フレーム行う処理
/***************************************************************************************************/
proc 座標取得 {
	chara プロック連続実行 毎フレーム処理 \
		-time -1 \
		-exec {
			// プレイヤーの１フレーム前の座標を覚える
			eval( $i:前フレーム位置Ｘ = $i:プレイヤー位置Ｘ )
			eval( $i:前フレーム位置Ｚ = $i:プレイヤー位置Ｚ )

			// 主観なら
			if( `command PlayerStatus -f d:TRP_STATE_SUBJECT ` ){
				mesg プットオブジェ ロード用Ｗ０１ｂ on
			// ビハインドなら
			}else if( `command PlayerStatus -f 8 ` ){
				if( ($i:プレイヤー位置Ｘ > -2000) && ($i:プレイヤー位置Ｘ < 2000) ){
					if( ($i:プレイヤー位置Ｚ > -11250) && ($i:プレイヤー位置Ｚ < -10000) ){
						mesg プットオブジェ ロード用Ｗ０１ｂ on
					}
				}
			}else{
				mesg プットオブジェ ロード用Ｗ０１ｂ off
			}
		}
}

/***************************************************************************************************/
// ブンブン羽虫
/***************************************************************************************************/
	proc ブンブン羽虫 {
		// 警備兵にまとわりつく虫
		chara 電灯虫 たかり虫:01 \
			-n	(64 * 3) \
			-p	0 -5000 -12500 \	// ライト位置 ->> プレイヤー誘導時は無視
			-b	0 \	// 下のバウンディングボックスで壁との当たり見るか  1 : 判定あり, 0 : 判定なし
			-s	200 200 200 \	// 最小ボックス座標
			-l	500 500 500	// 最大ボックス座標

		mesg 電灯虫 たかり虫:01 物誘導 警備兵:03

		// 待機虫
		chara 電灯虫 たかり虫:02 \
			-n	(64 * 3) \
			-p	0 -5000 -12500 \	// ライト位置 ->> プレイヤー誘導時は無視
			-b	0 \	// 下のバウンディングボックスで壁との当たり見るか  1 : 判定あり, 0 : 判定なし
			-s	200 200 200 \	// 最小ボックス座標
			-l	500 500 500	// 最大ボックス座標

		chara 電灯虫 たかり虫:03 \
			-n	(64 * 3) \
			-p	0 -5000 -12500 \	// ライト位置 ->> プレイヤー誘導時は無視
			-b	0 \	// 下のバウンディングボックスで壁との当たり見るか  1 : 判定あり, 0 : 判定なし
			-s	200 200 200 \	// 最小ボックス座標
			-l	500 500 500	// 最大ボックス座標

		chara 電灯虫 たかり虫:04 \
			-n	(64 * 3) \
			-p	0 -5000 -12500 \	// ライト位置 ->> プレイヤー誘導時は無視
			-b	0 \	// 下のバウンディングボックスで壁との当たり見るか  1 : 判定あり, 0 : 判定なし
			-s	200 200 200 \	// 最小ボックス座標
			-l	500 500 500	// 最大ボックス座標
	}

/****************************************************************************************/
// サウンド変更
/****************************************************************************************/
	proc サウンド変更 {
		trap ev005 d:PLAYER \
			-mask 出る \
			-exec {
				if( $4 < -10000){
					mesg ＢＧＭマネージャー ＢＧＭ SD_SNEAK_AUTO d:SD_AUTO_FADER1
				}else{
					mesg ＢＧＭマネージャー ＢＧＭ SD_SNEAK_AUTO d:SD_AUTO_FADER2
				}
		}
		trap ev006 d:PLAYER \
			-mask 出る \
			-exec {
				if( $4 > 10000){
					mesg ＢＧＭマネージャー ＢＧＭ SD_SNEAK_AUTO d:SD_AUTO_FADER1

				}else{
					mesg ＢＧＭマネージャー ＢＧＭ SD_SNEAK_AUTO d:SD_AUTO_FADER2
				}
		}
	}

/***************************************************************************************************/
// 大ガラス用透明壁
/***************************************************************************************************/
	proc 大ガラス用透明壁 {

		if( $f:壊れフラグ＿でかガラス == 0 ) {
			chara 透明壁 大ガラス透明壁 \
					-p -2800 0 -14250 2550 \
					   2800 0 -14250 2550 \
					-a (d:HZX_SEG_ATR_ALL & ~(d:HZX_SEG_NO_MISSILE | d:HZX_SEG_NO_C4))
		}
	}

/***************************************************************************************************/
// デバッグ関係の設定
/***************************************************************************************************/
	proc 遠近ぼかしセット {
		chara 遠景ぼかし 遠景ぼかし１ -plane 4 -near 1000 -far 5000
		chara 遠景ぼかし 遠景ぼかし２ -plane 4 -near 5000 -far 10000
		chara 遠景ぼかし 遠景ぼかし３ -plane 4 -near 10000 -far	15000

		chara 近景ぼかし 近景ぼかし１ -plane 3 -near 0 -far 1000
		chara 近景ぼかし 近景ぼかし２ -plane 3 -near 0 -far 3000
		chara 近景ぼかし 近景ぼかし３ -plane 3 -near 0 -far 5000
	}

	proc 写真撮影用スクリーンショット {
		chara スクリーンショット スクリーンショット
	}

	proc セット壊れフラグ＿クーラー {
		eval( $f:壊れフラグ＿クーラー = 1 )
	}

	proc アイスボックス {
		chara プットアイスボックスオブジェ クーラー \
				-model  buket_00 buket_01 ice_00 \
				-rot    0,0,0 \
				-pos    6705,1000,-17670 \
				-hazard d:BRK_HZD_W01F_BAR2 d:BRK_HZD_W01F_BAR3 \
				-flag   0 \
				-proc セット壊れフラグ＿クーラー \
				-number 20
		if ( $f:壊れフラグ＿クーラー )
		{
			mesg プットアイスボックスオブジェ クーラー もう壊れている
