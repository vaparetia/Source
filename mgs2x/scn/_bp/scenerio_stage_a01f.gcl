	/***************************************************************************************************/
	// 左舷カメラと右舷カメラ
	/***************************************************************************************************/
	proc 左舷カメラ {
		trap ca006 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec{
				if( $3 == 入る ){
					if( $6 < -16000 ){
						eval( $w:補完方式 = 2 )	// 階段から進入
					}else{
						eval( $w:補完方式 = 0 )	// 西から進入
					}
				}
				if( $6 > -12000 ) {
					eval( $i:補完ＰＹ = 4458 )
					eval( $i:補完ＰＺ = -11490 )
					eval( $i:補完ＴＺ = -12221 )
				} else if( $6 < -14500 ) {
					eval( $i:補完ＰＹ = 2250 )
					eval( $i:補完ＰＺ = -11250 )
					eval( $i:補完ＴＺ = -14500 )
				} else {
					@CS_スムーズカメラ３ $6 -12000 -14500 4458 2250 -11490 -11250   -12221 -14500
					eval( $i:補完ＰＹ = $i:CS_結果１ )
					eval( $i:補完ＰＺ = $i:CS_結果２ )
					eval( $i:補完ＴＺ = $i:CS_結果３ )
				}
				chara カメラ設定 通路カメラ１ \
					-c 1 \
					-p -10750,$i:補完ＰＹ,$i:補完ＰＺ \
					-t -10750,1000,$i:補完ＴＺ \
					-a 200 \
					-i $w:補完方式 -1 0 0 \
					-s $3
			}
	}

