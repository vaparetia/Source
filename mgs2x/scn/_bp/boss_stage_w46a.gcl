// 各種スイッチ用define
// ------------------------------------
// サウンド
#define		SOUND			1		// サウンドデータは最初に呼ぶ
#define		BGM				1		// BGMは敵兵コマンダーの後に呼ぶ
// キャラクター関係
#define		RAIDEN			1		// SNAKEとは排他
#define		SNAKE			0
#define		ENEMY			0		// コマンダーと警備兵(敵を出すときは必須)
#define		SUPPORT			0		// サポート兵
#define		ATTACKER		0		// 攻撃兵
#define		SHIELD			0		// 盾兵(1) or 通常攻撃兵(0)
// 監視カメラ関係
#define		CYPHER			0		// サイファー
// ドア
#define		SLIDE_DOOR		0		// スライドドア
// 入出トラップ
#define		LOAD_TRAP		0
#define		STAGE_END		0		// ステージ終了時処理を使用可にする
// フォグ
#define		FOG				1
// エフェクト関係
#define		EFFECT			0		// エフェクト全般
#define		BLUR			0		// ブラー
#define		Z_MANAGER		0		// Ｚフォーカス管理(敵のライト等で仕様)
#define		BODY_SHADOW		0		// 敵のライトによって出る影
// 子画面
#define		SUB_CAMERA		0
// カメラ関係
#define		CLEAR_CAMERA	0		// クリアリング専用カメラ(要子画面)

// 天井
#define		CHARA_CEIL		0		// 天井君
// 透明壁
#define		TR_WALL			0		// シナリオ置きの透明壁
// ライト関係
#define		SPOT_LIGHT		0		// スポットライト
// オブジェ関係

// ボス関係
#define		METAL			1		// メタル

// アイテム
#define		ITEM			0
// 強制モーション
#define		BY_MOTION		1		// ビヨンドモーション

// デバッグ関係
#ifdef	d:FIX_MODE
	#define		DEBUG_CHARA		0		// デバッグキャラ全体(FIX時は0)
#else
	#define		DEBUG_CHARA		0		// デバッグキャラ全体
#endif
#define		CHARA_CAMERA	0		// キャラ追従カメラ
#define		TARGET_CHARA	敵兵:01	// キャラ追従カメラのターゲット
#define		SCREENSHOT		0		// スクリーンショット
#define		USB_KEY			0		// USBキーボード


// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME			w46a
#define		KMS_NAME0			w46a
#define		LT2_NAME			w46a

// キャラクター関係
#if d:RAIDEN
	#define		PLAYER		ライデン	// モーションができるまで名前はスネーク
#else
	#define		PLAYER		スネーク
#endif

//	薬莢系

//	ステージ系
#define			STAGE_W46A			1

#define			STAGE_PLANT			1	//	プラント編

#define			POLYDEMO_LOAD		1

// モード（ボスラッシュのファイルには必ず必要）
#define			BOSS_MODE			1	// 共通プロック切り分け用



// ローカル変数
//	$f:w46a_メタル登場フラグ				//	メタルが登場したかどうかのフラグ

//	$i:w46a_メタル戦終了撃墜数				//	メタル戦を終了させるために必要な撃墜数
//	$f:w46a_スティンガー弾01フラグ			//	アイテム再発生用のフラグ
//	$f:w46a_スティンガー弾02フラグ			//	アイテム再発生用のフラグ
//	$f:w46a_スティンガー弾03フラグ			//	アイテム再発生用のフラグ
//	$f:w46a_スティンガー弾04フラグ			//	アイテム再発生用のフラグ
//	$f:w46a_スティンガー弾05フラグ			//	アイテム再発生用のフラグ
//	$f:w46a_スティンガー弾06フラグ			//	アイテム再発生用のフラグ

//	$f:w46a_レーション01フラグ				//	アイテム再発生用のフラグ
//	$b:w46a_レーションカウント				//	レーションの再発生制限用

//	$i:w46a_メタル戦撃墜数					//	メタル撃墜数

// include
// ------------------------------------
#include "stdch.h"
#include "sload.h"
//#include "beyond.h"
#include "sound.h"
//#include "enevoice.h"
#include "item_info.h"
//#include "obl_trap.h"

#if d:USB_KEY
	#include "usbkbd.h"
#endif

//#include "w46a_d_common.h"	//	デモ／ゲーム共通プロック

#include "w46a.gcl"			//	元のファイルをincludeする
#include "boss_item.h"		//	ボス戦用アイテム設定

// マップ設定
// ------------------------------------
chara マップ メタル戦ステージ	\
	-k d:KMS_NAME0 \
	-h d:HZX_NAME,0 \
	-l d:LT2_NAME

// 平野追加。デモ再生用ヘッダ。この位置を変えないこと。
//#include "polydemo_w46a.h"

command マップ設定 メタル戦ステージ -set {

	// 平野追加。デモ呼び分け用。
	if ($s:d_num == not_demo) {
		#if d:SOUND	
//		@サウンド設定	// データは最初に呼ぶ
		#endif
	}
	@常駐キャラ設定

	// 平野追加。デモ呼び分け用。
	if ($s:d_num == not_demo) {
		@ローカル変数初期化
		@設定値変更
		if ($s:ボスラッシュプレイヤー != スネーク) {
			// プラグインの前に刀関連のプレイヤーフラグは設定しないといけないため修正 2002.10.11 吉池
			$w:プレイヤーフラグ = ( $w:プレイヤーフラグ & ~(d:PL_START_STATE_BLADE_OUT) );	// 刀はしまっている
			$w:プレイヤーフラグ = ( $w:プレイヤーフラグ & ~(d:PL_START_STATE_BLADE_INV) );	// 峰うちじゃない
			@プラグイン設定
		}

//		@プレイヤー設定
		// プレイヤー設定の変わりに呼ぶ（X Y Z 方向 姿勢）mlsファイル(snake) mlsファイル(raiden)
		@ボスラッシュプレイヤー設定 0 4000 -2000 -2048 d:FA_END_STAND sna_w46a rai_w46a

		@亀甲床設定
		@刀設定
		#if d:BGM	
		@ＢＧＭ設定	// プレイヤー→敵兵→BGMの順で呼ぶ
		#endif

		#if d:METAL
		@メタル戦設定
		#endif

		#if d:FOG
		@フォグ設定
		#endif
		#if d:EFFECT
		@エフェクト設定
		#endif
		@息設定
		@空設定
		@もやもや管理
		@雷管理
//		@仮ステージ設定

//		@アイテム設定
		//	ボスラッシュ専用のアイテムプロック(boss_item.hで一括管理します)
		@ボスラッシュ用アイテム設定

		@カメラセット
//		@メタル戦ステージカメラ設定
		#if d:DEBUG_CHARA
		@デバッグキャラセット
		#endif

//		@インタラクティブデモ１設定
//			@仮デモ設定
		@レーダーオフ設定
		@装備禁止設定

#if 0
		if ($f:w41a_ノードフラグ == 1) {
			@プラント編全体マップ設定  d:アーセナルギア直腸	//	全体マップ表示
		} else {
			@ポーズ時ステージ名表示設定 d:wn_アーセナルギア直腸	//	ポーズ時ステージ名表示
		}
#endif
		@キャラ用ライト設定		// マップ設定の最後に呼ぶ

		@ボスラッシュ開始時キャラ設定

	}
}

// 無線用include ※位置は動かさないこと
//#include "w46a_cdc.ch"

//初期マップの表示
command マップ表示 -show メタル戦ステージ
