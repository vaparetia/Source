proc rts_ＳＡＶＥ前デフォルト {
	if( \
			 (d:ST_T05a1Dオルガ戦前ポリゴンデモ終了 <= $w:t_story && \
			 	$w:t_story < d:ST_T06a1Dオルガ戦勝利後ポリゴンデモ開始) || \
			 (d:長廊下兵との戦闘突入ポリデモ終了 <= $w:t_story && \
			 	$w:t_story < d:ST_T08a1Dハッチ閉鎖ポリゴンデモ開始) \
		 ){
		@rts_ＳＡＶＥ前緊迫
		eval($f:rft_ＳＡＶＥ前フラグ処理する = 0)
	}else {
		@rts_ＳＡＶＥ前普通
		eval($f:rft_ＳＡＶＥ前フラグ処理する = 1)
	}
}

