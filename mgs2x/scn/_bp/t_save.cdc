enum TS_ＳＡＶＥ後会話 {
	なしよ = 0,
	ＳＡＶＥ後初めて,
	ＳＡＶＥ後序盤１,
	ＳＡＶＥ後序盤２,
	ＳＡＶＥ後序盤３,
	ＳＡＶＥ後序盤４,
	ＳＡＶＥ後序盤５,
	ＳＡＶＥ後序盤６,
	ＳＡＶＥ後序盤７,
	ＳＡＶＥ後序盤８,
	ＳＡＶＥ後中盤１,
	ＳＡＶＥ後中盤２,
	ＳＡＶＥ後中盤３,
	ＳＡＶＥ後中盤４,
	ＳＡＶＥ後メイ・リン登場,
	ＳＡＶＥ後メイ・リン登場後,
}


