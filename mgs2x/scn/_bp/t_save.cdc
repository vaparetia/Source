proc rts_ＳＡＶＥ前普通 {
	if(!$f:rft_ＳＡＶＥ前普通１聞いた) {
		@rto_ＳＡＶＥ前普通１
		eval($f:rft_ＳＡＶＥ前普通１聞いた = 1 )
	
	}else if(!$f:rft_ＳＡＶＥ前普通２聞いた) {
		@rto_ＳＡＶＥ前普通２
		eval($f:rft_ＳＡＶＥ前普通２聞いた = 1 )
	
	}else if(!$f:rft_ＳＡＶＥ前普通３聞いた) {
		@rto_ＳＡＶＥ前普通３
		eval($f:rft_ＳＡＶＥ前普通３聞いた = 1 )

	}else if(!$f:rft_ＳＡＶＥ前普通４聞いた) {
		@rto_ＳＡＶＥ前普通４
		eval($f:rft_ＳＡＶＥ前普通４聞いた = 1 )

	}else {
		rand 4
		eval($w:rft_rand = $status)

		if($w:rft_rand < 1){
			@rto_ＳＡＶＥ前普通１

		}else if($w:rft_rand < 2){
			@rto_ＳＡＶＥ前普通２

		}else if($w:rft_rand < 3){
			@rto_ＳＡＶＥ前普通３
		
		}else {
			@rto_ＳＡＶＥ前普通４
		}
	}
}

