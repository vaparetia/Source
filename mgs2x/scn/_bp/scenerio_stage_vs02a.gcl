// ------------------------------------
// 各gclで必要なdefine
// ------------------------------------
// モード
#define		STAGE_VR 		1		// 共通プロック切り分け用
#define		VR_SNEAKING		1		// 共通プロック切り分け用
// ステージ名
#define		STAGE_VS02A		1		// 共通プロック切り分け用
// 敵兵、ＮＰＣ状況（薬莢を呼び分けるのに必要）
#define		ENE_P_GOL		1		// 都市迷彩ゴル兵
#define		ENE_SHOT		1		// ショットガン兵
#define		ENE_HIGH_TECH	1		// ハイテク兵
#define		ENE_SHIELD		1		// 盾兵


// ------------------------------------
// 各種スイッチ用define
// ------------------------------------
// デバッグ関係
#ifdef	d:FIX_MODE
	#define		DEBUG_CHARA		0		// デバッグキャラ全体(FIX時は0)
#else
	#define		DEBUG_CHARA		0		// デバッグキャラ全体
#endif
#define		CHARA_CAMERA	0		// キャラ追従カメラ
#define		TARGET_CHARA	敵兵:01	// キャラ追従カメラのターゲット
#define		SCREENSHOT		0		// スクリーンショット
#define		USB_KEY			0		// USBキーボード


// ------------------------------------
// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME			vs02a
#define		KMS_NAME			vs02a
#define		TONBO_KMS_NAME		vs02a_tonbo
#define		LINE_KMS_NAME		vs02a_line

// キャラクター関係
#define		PLAYER		ライデン

// ------------------------------------
// 敵兵音声
// ------------------------------------

// ------------------------------------
// 敵兵ルート番号
// ------------------------------------
enum E_R {
	雷電道１ = 0,
	雷電道２,
	雷電道３,
	蛇道１,
	蛇道２,
	蛇道３,
	蛇道４,
	昔蛇道１,
	昔蛇道２,
	昔蛇道３,
	昔蛇道４

};

// ＶＲウィンドウ スニーキング
#define WINDOW_SNEAKING_vs02a		[VRMSG_J:VRM_SNK_SNK_vs02a] [VRMSG_E:VRM_SNK_SNK_vs02a] [VRMSG_G:VRM_SNK_SNK_vs02a] \	// 日、英、独
									[VRMSG_F:VRM_SNK_SNK_vs02a] [VRMSG_I:VRM_SNK_SNK_vs02a] [VRMSG_S:VRM_SNK_SNK_vs02a] \	// 仏、伊、西
									[VRMSG_K:VRM_SNK_SNK_vs02a] \															// 韓
									p:ＶＲステージ開始時処理								// 終了プロック
// ＶＲウィンドウ 全殺し
#define WINDOW_ELIM_ALL_vs02a		[VRMSG_J:VRM_SNK_ELM_vs02a] [VRMSG_E:VRM_SNK_ELM_vs02a] [VRMSG_G:VRM_SNK_ELM_vs02a] \	// 日、英、独
									[VRMSG_F:VRM_SNK_ELM_vs02a] [VRMSG_I:VRM_SNK_ELM_vs02a] [VRMSG_S:VRM_SNK_ELM_vs02a] \	// 仏、伊、西
									[VRMSG_K:VRM_SNK_ELM_vs02a] \															// 韓
									p:ＶＲステージ開始時処理								// 終了プロック

#define	WATCHER_STATUS		d:ENE_STATUS_NORMAL スニーキング２面
// ------------------------------------
// アイテム位置
// ------------------------------------
#define 中央左下	3000 0 -1500
#define 北壁左		0 0 -9000
#define 中央右		8000 0 -5000
#define 北壁右		8000 0 -9000
#define ステージ右下 11000 0 0
#define 中央左上	0 0 -7000

// ------------------------------------
// 標準装備弾数
// ------------------------------------
#define ライデン弾数 24
#define スネーク弾数 15
#define ぷりすき弾数 10
#define たきへび弾数 4

// ------------------------------------
// include
// ------------------------------------
#include "rai_vs01a.mh"		// 強制モーションリスト
#include "stdch.h"
#include "enevoice.h"
#include "a_stdproc.h"		// アナザーミッション設定ファイル
#include "sload.h"
#include "sound.h"
#include "item_info.h"
#include "a_item_info.h"
#include "ene_item.h"
#include "vr_common.h"		// ＶＲステージ共通で使用するプロック
#include "vs02a_common.h"
#if d:USB_KEY
	#include "usbkbd.h"
#endif

// ------------------------------------
// マップ設定
// ------------------------------------
chara マップ スニーキング２面 -k d:KMS_NAME -h d:HZX_NAME,0 -l $s:ＶＲライトファイル名

command マップ設定 スニーキング２面 -set {
	// ローカルの初期化
	// ------------------------------------
	@ローカル変数初期化		// ローカルで使用する変数で初期化をする場合はここで

	// 設定値を変更する場合は以下のプロック内で設定
	// ------------------------------------
	@設定値変更				// 敵兵や的のパラメータをステージ限定で変える時はここで

	// ＶＲで必要な基本プロックのセット(vr_common.hで定義)
	// サウンドの基本パック、ＶＲの基本システム、プレイヤー、ゴール等を設定します
	// ※このプロックを使用する時は「ＶＲクリア時処理」というプロックが必要です
	// ＶＲ共通プロックセット	$:スネークファイル $:雷電ファイル $:クリア条件フラグ
	//							$:ゴールＸ $:ゴールＹ $:ゴールＺ $:タイマー初期値
	//	VR_GOAL_TARGET	/*的全滅でゴールが開く*/
	//	VR_GOAL_FREE	/*ゴールが最初から開いてる*/
	//	VR_GOAL_ENEMY	/*敵全滅でゴールが開く*/
	//	VR_GOAL_SNEAK	/*潜入モード中はゴールが開く*/
	//	VR_GOAL_TIME	/*タイマーがゼロになるとゴールが開く*/
	// ------------------------------------
	@ＶＲスニーキング共通プロックセット sna_vs01a rai_vs01a 11000 0 -11000

	// ＶＲウィンドウの設定
	// ------------------------------------
	@スニーキング２面ＶＲウィンドウ設定

	// クリア時に呼ばれるものの設定
	// ------------------------------------
	@ＶＲクリア設定 p:load_vs03a p:A_ＲＥＴＲＹプロック

	// ステージに引かれるライン
	// ------------------------------------
	@ＶＲアウトライン d:KMS_NAME d:TONBO_KMS_NAME d:LINE_KMS_NAME

	@プラグイン設定			// プレイヤーのプラグインがいる時はここで

	// 敵兵・的関係の設定
	// ------------------------------------
	@コマンダー設定

	// ＢＧＭの設定(プレイヤー→敵兵→BGMの順で呼ぶ)
	// ------------------------------------
	@ＢＧＭ設定
	// アイテムの設定
	// ------------------------------------
	@アイテム設定
	// 光源、オブジェクト、カメラ関連の設定
	// ------------------------------------
	@ＶＲフォグ設定 d:VR_FOG:朝Ｎ 40000 d:VR_FOG:夕Ｎ 33000 d:VR_FOG:夜Ｎ 25000
	@カメラセット					// chara カメラとベースのカメラを設定
	@vs02aカメラ設定				// ステージ固有のカメラ設定がいる時はこのプロックで
	@ＶＲキャラ用ライト設置			// 必ず最後に設定
#if d:DEBUG_CHARA
//	@デバッグキャラセット
#endif
}

//初期マップの表示
command マップ表示 -show スニーキング２面


// 各proc設定
//-------------------------------------------------------------------------------------
// 全マップ共通
	// ＶＲウィンドウの設定と表示
	//------------------------------------------------------------
	proc スニーキング２面ＶＲウィンドウ設定 {
		#if d:DEBUG_PRINT
			print 'vr_window_set'
		#endif
		if( $b:モード番号 == d:SNEAKING:SNEAKING ){
			@ＶＲウィンドウ設定 d:WINDOW_SNEAKING_vs02a
		}else{
			@ＶＲウィンドウ設定 d:WINDOW_ELIM_ALL_vs02a
		}

		// ＶＲウィンドウを表示する
		mesg ＶＲウィンドウ ＶＲウィンドウ君 開く

		// スタート時とクリア時に使用するカットインカメラ
		chara カメラ カットインカメラ		-c 0 -l 0 -p  0

		// スタート時のカメラ(必要な場合)
		chara カメラ設定 カットインカメラ \
			-c 1 \
			-p 11000,5330,-8479 -t 11000,0,-11000 \
			-r 736,2048,0 -f 5896 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1
	}

	//------------------------------------------------------------
	// ステージ開始時処理
	//------------------------------------------------------------
	proc ＶＲステージ開始時処理 {
		#if d:DEBUG_PRINT
			print 'game_start!!!!!'
		#endif

		// プレイヤーやパッドの制御等を行う a_stdproc.hで定義
		@全ミッション共通ステージ開始時処理

		// カメラワークスタート(必要な場合)
		// 全体図
		chara カメラ設定 カットインカメラ \
			-c 1 \
			-p 5355,12421,5168 -t 5355,4751,-837 \
			-r 591,2048,0 -f 9741 \
			-a 180 \
			-i 4 4 d:START_CAMERA_CHANGE_TIME d:START_CAMERA_CHANGE_TIME \
			-s 1

		chara delay ディレイ \
			-time d:START_CAMERA_CHANGE_TIME \
			-exec {
				chara カメラ設定 カットインカメラ -s -1
			}
	}

	// ------------------------------------
	// クリア時の処理
	// ------------------------------------
	proc ＶＲクリア時処理 {
		#if d:DEBUG_PRINT
			print 'clear'
		#endif
		// 強制モーションを発動
		@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_1 2048

		// クリア時にカメラアングルを変える
		chara カメラ設定 クリア時カメラ \
			-c 1 \
			-p 10531,1062,-14833 -t 11506,1094,-9601 \
			-r -4,120,0 -f 5322 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}


	// ------------------------------------
	// パラメータ系の変更
	// ------------------------------------
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT
			print 'localvar_init'
		#endif
	}
	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT
			print 'status_set'
		#endif
//			スニーキング用キャラ別標準装備設定 \
//				$:ELM_ライデン弾数 \
//				$:ELM_スネーク弾数 \
//				$:ELM_プリスキン弾数 \
//				$:ELM_タキシードスネーク弾数

		// 全殺時初期装備の設定
		@スニーキング用キャラ別標準装備設定 d:ライデン弾数 d:スネーク弾数 d:ぷりすき弾数 d:たきへび弾数
	}
	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif
	}



	// ------------------------------------
	// 敵兵や的の処理
	// ------------------------------------
	// 敵兵に関する設定
	//-------------------------------------
	proc 警備兵セット {
		#if d:DEBUG_PRINT
			print 'watcher_set'
		#endif
		if ( $s:選択プレイヤー == ライデン		|| \
			 $s:選択プレイヤー == プリスキン	|| \
			 $s:選択プレイヤー == 刀ライデン	){

			@VR_スニーキング警備兵 敵兵:01 d:E_R:雷電道１	1 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:02 d:E_R:雷電道２	0 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:03 d:E_R:雷電道３	2 d:WATCHER_STATUS

		}else if($s:選択プレイヤー == スネーク			|| \
			 	 $s:選択プレイヤー == タキシードスネーク){

			@VR_スニーキング警備兵 敵兵:01 d:E_R:蛇道１		0 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:02 d:E_R:蛇道２		0 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:03 d:E_R:蛇道３		4 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:04 d:E_R:蛇道４		0 d:WATCHER_STATUS

		}else if( 前作スネーク ){

			@VR_スニーキング警備兵 敵兵:01 d:E_R:昔蛇道１	7 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:02 d:E_R:昔蛇道２	0 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:03 d:E_R:昔蛇道３	0 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:04 d:E_R:昔蛇道４	3 d:WATCHER_STATUS

		}else{// ライデン

			@VR_スニーキング警備兵 敵兵:01 d:E_R:雷電道１	1 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:02 d:E_R:雷電道２	0 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:03 d:E_R:雷電道３	2 d:WATCHER_STATUS
		}
	}

	proc 攻撃兵セット {
		#if d:DEBUG_PRINT
			print 'attacker_set'
		#endif
	}

	proc 警備兵コマンダー {
		#if d:DEBUG_PRINT
			print 'wccomm_set'
		#endif

		chara 警備コマンダー wccomm -e {警備兵セット}
	}

	proc 攻撃兵コマンダー {
		#if d:DEBUG_PRINT
			print 'atcomm_set'
		#endif
	}

	proc コマンダー設定 {
		#if d:DEBUG_PRINT
			print 'commander_set'
		#endif

		chara コマンダー 敵兵セット \
			-w 警備兵コマンダー \
//			-a 攻撃兵コマンダー \
			-d スニーキング２面 \
			-r 11000,0,-11000 スニーキング２面 \
			-c 11000,0,-11000 スニーキング２面 \
			-v [ene_vr_voice:01] \
			-z $i:敵標準麻酔持続 \
			-h $i:標準警戒時間 \
			-o $i:敵標準気絶持続 \
			-s (d:ENE_STAGE_GPS | d:ENE_STAGE_VR_ANOTHER) \
			-b 0 \
			-m d:ALERT_MODE_SENNYU
	}



	// ------------------------------------
	// ＢＧＭの設定
	// ------------------------------------
	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT
			print 'bgm_set'
		#endif

		chara ＢＧＭマネージャー ＢＧＭマネ
	}


	// ------------------------------------
	// アイテムの設定
	// ------------------------------------
	// 再発生が必要な時は以下のプロックの中を記述する
	// ------------------------------------
	proc アイテム取得時番号設定 $:ボックス名 {
		#if d:DEBUG_PRINT
			print 'item_no_set'
		#endif
	}
	// アイテムの設置
	// ------------------------------------
	proc アイテム設定 {
		#if d:DEBUG_PRINT
			print 'item_set'
		#endif
		if(`@スニーキング判定`){
			// 特に無し
		}else{// エリミネート
			switch( $s:選択プレイヤー ){
				case( ライデン ){
					// A_Ｍ９_初期設置 $:ボックス名 $:Ｘ座標 $:Ｙ座標 $:Ｚ座標 $:水飛沫 $:変更アイテム名 $:初期弾数 {
					@A_Ｍ９_初期設置 雷Ｍ９ d:中央左下 0 なし 15
				}
				case( プリスキン ){
					@A_Ｍ９_初期設置 プＭ９ d:中央右 0 なし 6
				}
				case( 刀ライデン ){
					// 無し
				}
				case( スネーク ){
					@A_Ｍ９_初期設置 スＭ９ d:北壁左 0 なし 15
				}
				case( タキシードスネーク ){
					// 無し
				}
				case( 前作スネーク ){
					@A_Ｍ９_初期設置 昔Ｍ９ d:北壁右 0 なし 4
					@A_ＵＳＰ_初期設置 昔ＵＳＰ d:ステージ右下 0 なし 4
					@ＵＳＰサプレッサ_初期設置 さぷれ d:中央左上 0
				}
				default{
					#ifndef d:FIX_MODE
						print '$s:選択プレイヤー = ' $s:選択プレイヤー
						command assert( d:FALSE ) 'player_err(scn : item_set)'
					#endif
				}
			}
		}
	}
