// ------------------------------------
// アイテムの設定
// ------------------------------------
// 再発生が必要な時は以下のプロックの中を記述する
// ------------------------------------
proc アイテム取得時番号設定 $:ボックス名 {
	#if d:DEBUG_PRINT
		print 'item_no_set'
	#endif

	switch ( $:ボックス名 ) {
		case ( Ｍ９弾:01 ) {
			$$f:アイテム再セットフラグ[d:ITEM_NO:M9_01] = 0;
		}
		case ( ソコム弾:01 ) {
			$$f:アイテム再セットフラグ[d:ITEM_NO:SOCOM_01] = 0;
		}
		case ( Ｍ４弾:01 ) {
			$$f:アイテム再セットフラグ[d:ITEM_NO:M4_01] = 0;
		}
		case ( Ｍ４弾:02 ) {
			$$f:アイテム再セットフラグ[d:ITEM_NO:M4_02] = 0;
		}
		case ( ＡＫＳ弾:01 ) {
			$$f:アイテム再セットフラグ[d:ITEM_NO:AKS_01] = 0;
		}
		case ( ＡＫＳ弾:02 ) {
			$$f:アイテム再セットフラグ[d:ITEM_NO:AKS_02] = 0;
		}
		case ( ＰＳＧ１弾:01 ) {
			$$f:アイテム再セットフラグ[d:ITEM_NO:PSG1_01] = 0;
		}
		case ( ＰＳＧ１弾:02 ) {
			$$f:アイテム再セットフラグ[d:ITEM_NO:PSG1_02] = 0;
		}
		case ( ＲＧＢ６弾:01 ) {
			$$f:アイテム再セットフラグ[d:ITEM_NO:RGB6_01] = 0;
		}
		case ( スティンガー弾:01 ) {
			$$f:アイテム再セットフラグ[d:ITEM_NO:STINGER_01] = 0;
		}
		case ( ジアゼパム:01 ) {
			$$f:アイテム再セットフラグ[d:ITEM_NO:DZP_01] = 0;
		}
	}

}

// アイテムの再発生で使用する共通プロック
#define WEAPON_BOX	0
#define ITEM_BOX	1
proc A_アイテム再発生	 $:武器アイテムフラグ $:p_アイテム番号 $:p_再発生開始数 $:p_再セットフラグ番号 \
						 $:p_アイテムプロック $:p_名前 $:p_アイテムＸ $:p_アイテムＹ $:p_アイテムＺ \
{
	switch ( $:武器アイテムフラグ ) {
		case ( d:WEAPON_BOX ) {
			if( ($w:武器弾数Ｒ[$:p_アイテム番号] <= $:p_再発生開始数 ) \
				&& (`command カメラ視界チェック -camera 0x01 \
						-bound ($:p_アイテムＸ-1000) ($:p_アイテムＹ) 		($:p_アイテムＺ-1000) \
						       ($:p_アイテムＸ+1000) ($:p_アイテムＹ+1000)	($:p_アイテムＺ+1000)` == 0)){

				if ( $$f:アイテム再セットフラグ[$:p_再セットフラグ番号] == 0) {
					call $:p_アイテムプロック $:p_名前 $:p_アイテムＸ $:p_アイテムＹ $:p_アイテムＺ 0
					$$f:アイテム再セットフラグ[$:p_再セットフラグ番号] = 1;
				}
			}
		}
		case ( d:ITEM_BOX ) {
			if( ($w:アイテム数Ｒ[$:p_アイテム番号] <= $:p_再発生開始数 ) \
				&& (`command カメラ視界チェック -camera 0x01 \
						-bound ($:p_アイテムＸ-1000) ($:p_アイテムＹ) 		($:p_アイテムＺ-1000) \
						       ($:p_アイテムＸ+1000) ($:p_アイテムＹ+1000)	($:p_アイテムＺ+1000)` == 0)){

				if ( $$f:アイテム再セットフラグ[$:p_再セットフラグ番号] == 0) {
					call $:p_アイテムプロック $:p_名前 $:p_アイテムＸ $:p_アイテムＹ $:p_アイテムＺ 0
					$$f:アイテム再セットフラグ[$:p_再セットフラグ番号] = 1;
				}
			}
		}
	}
}

// アイテムの設置
// ------------------------------------
proc アイテム設定 {
	#if d:DEBUG_PRINT 
		print 'item_set'
	#endif

//	@アイテム再セットチェック $b:w22a_取得ロード回数[d:I_NO:RGB6]
//	if ($f:再セットフラグ) {
		// 本体を持っていたときは自動的に弾になる
//		@ＲＧＢ６_初期設置 ＲＧＢ６本体 45875 0 -39375 0 ＲＧＢ６弾薬	// Ａ倉庫
//	}

	if ( $s:選択プレイヤー == ライデン ) {
		// ライデンのアイテム配置
		switch ( $b:ステージ番号 ) {
			case ( d:ZAKO_STAGE:G_SOL_1 ) {
				@Ｍ９_初期設置 Ｍ９本体 d:ITEM_POS_SP03A_40 0 なし
				@ソコム_初期設置 ソコム本体 d:ITEM_POS_SP03A_25 0 なし
				@グレネード_初期設置 グレネード:01 d:ITEM_POS_SP03A_04 0
				@A_スタン_初期設置 スタン:01 d:ITEM_POS_SP03A_17 0 10
				@レーション_初期設置 レーション:01 d:ITEM_POS_SP03A_28 0
			}
			case ( d:ZAKO_STAGE:G_SOLS_TEAM ) {
				// 前の繰越
				@Ｍ９_初期設置 Ｍ９本体 d:ITEM_POS_SP03A_40 0 なし
				@ソコム_初期設置 ソコム本体 d:ITEM_POS_SP03A_25 0 なし
				// 再発生しないもの
				@ＡＫＳ_初期設置 ＡＫＳ本体 d:ITEM_POS_SP03A_07 0 なし
				@ＰＳＧ１−Ｔ_初期設置 ＰＳＧ１−Ｔ本体 d:ITEM_POS_SP03A_32 0 なし
				@Ｃ４_初期設置 Ｃ４:01 d:ITEM_POS_SP03A_03 0
				@クレイモア_初期設置 クレイモア:02 d:ITEM_POS_SP03A_17 0
				@レーション_初期設置 レーション:01 d:ITEM_POS_SP03A_14 0
				@ジアゼパム_初期設置 ジアゼパム:01 d:ITEM_POS_SP03A_42 0

				// 再発生するもの
				@弾薬_Ｍ９_初期設置 Ｍ９弾:01 d:ITEM_POS_SP03A_34 0
				$$f:アイテム再セットフラグ[d:ITEM_NO:M9_01] = 1;
				@弾薬_ソコム_初期設置 ソコム弾:01 d:ITEM_POS_SP03A_41 0
				$$f:アイテム再セットフラグ[d:ITEM_NO:SOCOM_01] = 1;
				trap ev001 d:PLAYER \
					-mask いる \
					-exec {
						@A_アイテム再発生	 d:WEAPON_BOX d:武器:Ｍ９ 0 d:ITEM_NO:M9_01 \
											 p:弾薬_Ｍ９_初期設置 Ｍ９弾:01 d:ITEM_POS_SP03A_34

						@A_アイテム再発生	 d:WEAPON_BOX d:武器:ソコム 0 d:ITEM_NO:SOCOM_01 \
											 p:弾薬_ソコム_初期設置 ソコム弾:01 d:ITEM_POS_SP03A_41
					}
			}
			case ( d:ZAKO_STAGE:T_G_SOLS_TEAM ) {
				// 前の繰越
				@Ｍ９_初期設置 Ｍ９本体 d:ITEM_POS_SP03A_40 0 なし
				@ソコム_初期設置 ソコム本体 d:ITEM_POS_SP03A_25 0 なし
				@ＡＫＳ_初期設置 ＡＫＳ本体 d:ITEM_POS_SP03A_07 0 ＡＫＳ弾薬
				@ＰＳＧ１−Ｔ_初期設置 ＰＳＧ１−Ｔ本体 d:ITEM_POS_SP03A_32 0 ＰＳＧ１−Ｔ弾薬
				// 再発生しないもの
				@ＰＳＧ１_初期設置 ＰＳＧ１本体 d:ITEM_POS_SP03A_18 0 なし
				@ＲＧＢ６_初期設置 ＲＧＢ６本体 d:ITEM_POS_SP03A_03 0 なし	
				@Ｃ４_初期設置 Ｃ４:01 d:ITEM_POS_SP03A_10 0
				@クレイモア_初期設置 クレイモア:02 d:ITEM_POS_SP03A_04 0
				@レーション_初期設置 レーション:01 d:ITEM_POS_SP03A_09 0
				@ジアゼパム_初期設置 ジアゼパム:01 d:ITEM_POS_SP03A_17 0

				// 再発生するもの
				@弾薬_Ｍ９_初期設置 Ｍ９弾:01 d:ITEM_POS_SP03A_34 0
				$$f:アイテム再セットフラグ[d:ITEM_NO:M9_01] = 1;
				@弾薬_ソコム_初期設置 ソコム弾:01 d:ITEM_POS_SP03A_41 0
				$$f:アイテム再セットフラグ[d:ITEM_NO:SOCOM_01] = 1;
				trap ev001 d:PLAYER \
					-mask いる \
					-exec {
						@A_アイテム再発生	 d:WEAPON_BOX d:武器:Ｍ９ 0 d:ITEM_NO:M9_01 \
											 p:弾薬_Ｍ９_初期設置 Ｍ９弾:01 d:ITEM_POS_SP03A_34

						@A_アイテム再発生	 d:WEAPON_BOX d:武器:ソコム 0 d:ITEM_NO:SOCOM_01 \
											 p:弾薬_ソコム_初期設置 ソコム弾:01 d:ITEM_POS_SP03A_41
					}
			}
			case ( d:ZAKO_STAGE:GURLUGON ) {
				// 前の繰越
				@ＡＫＳ_初期設置 ＡＫＳ本体 d:ITEM_POS_SP03A_07 0 なし
				@ＰＳＧ１_初期設置 ＰＳＧ１本体 d:ITEM_POS_SP03A_18 0 なし
				@ＲＧＢ６_初期設置 ＲＧＢ６本体 d:ITEM_POS_SP03A_03 0 なし	
				// 再発生しないもの
				@スティンガー_初期設置 スティンガー本体 d:ITEM_POS_SP03A_25 0 なし	
				@レーション_初期設置 レーション:01 d:ITEM_POS_SP03A_15 0
				@雑誌_初期設置 雑誌:01 d:ITEM_POS_SP03A_24 0

				// 再発生するもの
				@弾薬_ＡＫＳ_初期設置 ＡＫＳ弾:01 d:ITEM_POS_SP03A_17 0
				$$f:アイテム再セットフラグ[d:ITEM_NO:AKS_01] = 1;
				@弾薬_ＡＫＳ_初期設置 ＡＫＳ弾:02 d:ITEM_POS_SP03A_41 0
				$$f:アイテム再セットフラグ[d:ITEM_NO:AKS_02] = 1;
				@弾薬_ＰＳＧ１_初期設置 ＰＳＧ１弾:01 d:ITEM_POS_SP03A_44 0
				$$f:アイテム再セットフラグ[d:ITEM_NO:PSG1_01] = 1;
				@弾薬_ＰＳＧ１_初期設置 ＰＳＧ１弾:02 d:ITEM_POS_SP03A_29 0
				$$f:アイテム再セットフラグ[d:ITEM_NO:PSG1_02] = 1;
				@弾薬_ＲＧＢ６_初期設置 ＲＧＢ６弾:01 d:ITEM_POS_SP03A_04 0
				$$f:アイテム再セットフラグ[d:ITEM_NO:RGB6_01] = 1;
				@弾薬_スティンガー_初期設置 スティンガー弾:01 d:ITEM_POS_SP03A_08 0
				$$f:アイテム再セットフラグ[d:ITEM_NO:STINGER_01] = 1;
				@ジアゼパム_初期設置 ジアゼパム:01 d:ITEM_POS_SP03A_34 0
				$$f:アイテム再セットフラグ[d:ITEM_NO:DZP_01] = 1;
				trap ev001 d:PLAYER \
					-mask いる \
					-exec {
						@A_アイテム再発生	 d:WEAPON_BOX d:武器:ＡＫＳ 29 d:ITEM_NO:AKS_01 \
											 p:弾薬_ＡＫＳ_初期設置 ＡＫＳ弾:01 d:ITEM_POS_SP03A_17

						@A_アイテム再発生	 d:WEAPON_BOX d:武器:ＡＫＳ 29 d:ITEM_NO:AKS_02 \
											 p:弾薬_ＡＫＳ_初期設置 ＡＫＳ弾:02 d:ITEM_POS_SP03A_41

						@A_アイテム再発生	 d:WEAPON_BOX d:武器:ＰＳＧ１ 19 d:ITEM_NO:PSG1_01 \
											 p:弾薬_ＰＳＧ１_初期設置 ＰＳＧ１弾:01 d:ITEM_POS_SP03A_44

						@A_アイテム再発生	 d:WEAPON_BOX d:武器:ＰＳＧ１ 19 d:ITEM_NO:PSG1_02 \
											 p:弾薬_ＰＳＧ１_初期設置 ＰＳＧ１弾:02 d:ITEM_POS_SP03A_29

						@A_アイテム再発生	 d:WEAPON_BOX d:武器:ＲＧＢ６ 0 d:ITEM_NO:RGB6_01 \
											 p:弾薬_ＲＧＢ６_初期設置 ＲＧＢ６弾:01 d:ITEM_POS_SP03A_04

						@A_アイテム再発生	 d:WEAPON_BOX d:武器:スティンガー 9 d:ITEM_NO:STINGER_01 \
											 p:弾薬_スティンガー_初期設置 スティンガー弾:01 d:ITEM_POS_SP03A_08

						@A_アイテム再発生	 d:ITEM_BOX d:アイテム:ジアゼパム 4 d:ITEM_NO:DZP_01 \
											 p:ジアゼパム_初期設置 ジアゼパム:01 d:ITEM_POS_SP03A_34
					}
			}
		}
		
	} else if ( $s:選択プレイヤー == スネーク ) {
		switch ( $b:ステージ番号 ) {
			case ( d:ZAKO_STAGE:G_SOL_1 ) {
				@Ｍ９_初期設置 Ｍ９本体 d:ITEM_POS_SP03A_25 0 なし
				@A_ＵＳＰ_初期設置 ＵＳＰ本体 d:ITEM_POS_SP03A_17 0 なし 16
				@グレネード_初期設置 グレネード:01 d:ITEM_POS_SP03A_40 0
				@A_スタン_初期設置 スタン:01 d:ITEM_POS_SP03A_08 0 7
				@レーション_初期設置 レーション:01 d:ITEM_POS_SP03A_01 0
			}
			case ( d:ZAKO_STAGE:G_SOLS_TEAM ) {
				// 前の繰越
				@Ｍ９_初期設置 Ｍ９本体 d:ITEM_POS_SP03A_25 0 なし
				@A_ＵＳＰ_初期設置 ＵＳＰ本体 d:ITEM_POS_SP03A_17 0 なし 16
				// 再発生しないもの
				@Ｍ４_初期設置 Ｍ４本体 d:ITEM_POS_SP03A_03 0 なし
				@ＰＳＧ１−Ｔ_初期設置 ＰＳＧ１−Ｔ本体 d:ITEM_POS_SP03A_41 0 なし
				@Ｃ４_初期設置 Ｃ４:01 d:ITEM_POS_SP03A_44 0
				@クレイモア_初期設置 クレイモア:02 d:ITEM_POS_SP03A_37 0
				@ジアゼパム_初期設置 ジアゼパム:01 d:ITEM_POS_SP03A_40 0

				// 再発生するもの
				@弾薬_Ｍ９_初期設置 Ｍ９弾:01 d:ITEM_POS_SP03A_08 0
				$$f:アイテム再セットフラグ[d:ITEM_NO:M9_01] = 1;
				@弾薬_ＵＳＰ_初期設置 ＵＳＰ弾:01 d:ITEM_POS_SP03A_18 0
				$$f:アイテム再セットフラグ[d:ITEM_NO:USP_01] = 1;

				trap ev001 d:PLAYER \
					-mask いる \
					-exec {
						@A_アイテム再発生	 d:WEAPON_BOX d:武器:Ｍ９ 0 d:ITEM_NO:M9_01 \
											 p:弾薬_Ｍ９_初期設置 Ｍ９弾:01 d:ITEM_POS_SP03A_08

						@A_アイテム再発生	 d:WEAPON_BOX d:武器:ＵＳＰ 0 d:ITEM_NO:USP_01 \
											 p:弾薬_ＵＳＰ_初期設置 ＵＳＰ弾:01 d:ITEM_POS_SP03A_18
					}
			}
			case ( d:ZAKO_STAGE:T_G_SOLS_TEAM ) {
				// 前の繰越
				@Ｍ９_初期設置 Ｍ９本体 d:ITEM_POS_SP03A_25 0 なし
				@A_ＵＳＰ_初期設置 ＵＳＰ本体 d:ITEM_POS_SP03A_17 0 なし 16
				@Ｍ４_初期設置 Ｍ４本体 d:ITEM_POS_SP03A_03 0 Ｍ４弾薬
				@ＰＳＧ１−Ｔ_初期設置 ＰＳＧ１−Ｔ本体 d:ITEM_POS_SP03A_41 0 ＰＳＧ１−Ｔ弾薬
				// 再発生しないもの
				@ＰＳＧ１_初期設置 ＰＳＧ１本体 d:ITEM_POS_SP03A_42 0 なし
				@ＲＧＢ６_初期設置 ＲＧＢ６本体 d:ITEM_POS_SP03A_09 0 なし	
				@Ｃ４_初期設置 Ｃ４:01 d:ITEM_POS_SP03A_07 0
				@クレイモア_初期設置 クレイモア:02 d:ITEM_POS_SP03A_10 0
				@レーション_初期設置 レーション:01 d:ITEM_POS_SP03A_28 0
				@ジアゼパム_初期設置 ジアゼパム:01 d:ITEM_POS_SP03A_14 0

				// 再発生するもの
				@弾薬_Ｍ９_初期設置 Ｍ９弾:01 d:ITEM_POS_SP03A_08 0
				$$f:アイテム再セットフラグ[d:ITEM_NO:M9_01] = 1;
				@弾薬_ＵＳＰ_初期設置 ＵＳＰ弾:01 d:ITEM_POS_SP03A_18 0
				$$f:アイテム再セットフラグ[d:ITEM_NO:USP_01] = 1;

				trap ev001 d:PLAYER \
					-mask いる \
					-exec {
						@A_アイテム再発生	 d:WEAPON_BOX d:武器:Ｍ９ 0 d:ITEM_NO:M9_01 \
											 p:弾薬_Ｍ９_初期設置 Ｍ９弾:01 d:ITEM_POS_SP03A_08

						@A_アイテム再発生	 d:WEAPON_BOX d:武器:ＵＳＰ 0 d:ITEM_NO:USP_01 \
											 p:弾薬_ＵＳＰ_初期設置 ＵＳＰ弾:01 d:ITEM_POS_SP03A_18
					}
			}
			case ( d:ZAKO_STAGE:MECHGENOLA ) {
				// 前の繰越
				@Ｍ４_初期設置 Ｍ４本体 d:ITEM_POS_SP03A_03 0 Ｍ４弾薬
				// 再発生しないもの
				@スティンガー_初期設置 スティンガー本体 d:ITEM_POS_SP03A_41 0 なし	
				@レーション_初期設置 レーション:01 d:ITEM_POS_SP03A_29 0
				@A_チャフ_初期設置 チャフ:01 d:ITEM_POS_SP03A_20 0 5
				@弾薬_ＰＳＧ１_初期設置 ＰＳＧ１弾:01 d:ITEM_POS_SP03A_43 0
				@ジアゼパム_初期設置 ジアゼパム:01 d:ITEM_POS_SP03A_40 0

				// 再発生するもの
				@弾薬_Ｍ４_初期設置 Ｍ４弾:01 d:ITEM_POS_SP03A_08 0
				$$f:アイテム再セットフラグ[d:ITEM_NO:M4_01] = 1;
				@弾薬_Ｍ４_初期設置 Ｍ４弾:02 d:ITEM_POS_SP03A_44 0
				$$f:アイテム再セットフラグ[d:ITEM_NO:M4_02] = 1;
				@弾薬_スティンガー_初期設置 スティンガー弾:01 d:ITEM_POS_SP03A_17 0
				$$f:アイテム再セットフラグ[d:ITEM_NO:STINGER_01] = 1;
				trap ev001 d:PLAYER \
					-mask いる \
					-exec {
						@A_アイテム再発生	 d:WEAPON_BOX d:武器:Ｍ４ 29 d:ITEM_NO:M4_01 \
											 p:弾薬_Ｍ４_初期設置 Ｍ４弾:01 d:ITEM_POS_SP03A_08

						@A_アイテム再発生	 d:WEAPON_BOX d:武器:Ｍ４ 29 d:ITEM_NO:M4_02 \
											 p:弾薬_Ｍ４_初期設置 Ｍ４弾:02 d:ITEM_POS_SP03A_44
											 
						@A_アイテム再発生	 d:WEAPON_BOX d:武器:スティンガー 9 d:ITEM_NO:STINGER_01 \
											 p:弾薬_スティンガー_初期設置 スティンガー弾:01 d:ITEM_POS_SP03A_17
					}
			}
		}
	} else if ( $s:選択プレイヤー == 前作スネーク ) {
		switch ( $b:ステージ番号 ) {
			case ( d:ZAKO_STAGE:G_SOL_1 ) {
				@Ｍ９_初期設置 Ｍ９本体 d:ITEM_POS_SP03A_44 0 なし
				@A_ＵＳＰ_初期設置 ＵＳＰ本体 d:ITEM_POS_SP03A_18 0 なし 16
				@グレネード_初期設置 グレネード:01 d:ITEM_POS_SP03A_39 0
				@A_スタン_初期設置 スタン:01 d:ITEM_POS_SP03A_28 0 5
				@サーマルゴーグル_初期設置 赤外線 d:ITEM_POS_SP03A_16 0
			}
			case ( d:ZAKO_STAGE:G_SOLS_TEAM ) {
				// 前の繰越
				@Ｍ９_初期設置 Ｍ９本体 d:ITEM_POS_SP03A_44 0 なし
				@A_ＵＳＰ_初期設置 ＵＳＰ本体 d:ITEM_POS_SP03A_18 0 なし 16
				// 再発生しないもの
				@Ｍ４_初期設置 Ｍ４本体 d:ITEM_POS_SP03A_09 0 なし
				@ＰＳＧ１−Ｔ_初期設置 ＰＳＧ１−Ｔ本体 d:ITEM_POS_SP03A_16 0 なし
				@Ｃ４_初期設置 Ｃ４:01 d:ITEM_POS_SP03A_37 0
				@クレイモア_初期設置 クレイモア:02 d:ITEM_POS_SP03A_01 0
				@ジアゼパム_初期設置 ジアゼパム:01 d:ITEM_POS_SP03A_42 0
				@レーション_初期設置 レーション:01 d:ITEM_POS_SP03A_23 0
				@弾薬_Ｍ９_初期設置 Ｍ９弾:01 d:ITEM_POS_SP03A_33 0
				@弾薬_ＵＳＰ_初期設置 ＵＳＰ弾:01 d:ITEM_POS_SP03A_43 0
			}
			case ( d:ZAKO_STAGE:T_G_SOLS_TEAM ) {
				// 前の繰越
				@Ｍ９_初期設置 Ｍ９本体 d:ITEM_POS_SP03A_44 0 なし
				@A_ＵＳＰ_初期設置 ＵＳＰ本体 d:ITEM_POS_SP03A_18 0 なし 16
				@Ｍ４_初期設置 Ｍ４本体 d:ITEM_POS_SP03A_09 0 Ｍ４弾薬
				@ＰＳＧ１−Ｔ_初期設置 ＰＳＧ１−Ｔ本体 d:ITEM_POS_SP03A_16 0 ＰＳＧ１−Ｔ弾薬
				// 再発生しないもの
				@ＰＳＧ１_初期設置 ＰＳＧ１本体 d:ITEM_POS_SP03A_28 0 なし
				@ＲＧＢ６_初期設置 ＲＧＢ６本体 d:ITEM_POS_SP03A_19 0 なし	
				@Ｃ４_初期設置 Ｃ４:01 d:ITEM_POS_SP03A_33 0
				@クレイモア_初期設置 クレイモア:02 d:ITEM_POS_SP03A_37 0
				@弾薬_Ｍ９_初期設置 Ｍ９弾:01 d:ITEM_POS_SP03A_05 0
				@弾薬_ＵＳＰ_初期設置 ＵＳＰ弾:01 d:ITEM_POS_SP03A_43 0
			}
			case ( d:ZAKO_STAGE:GENOLA ) {
				// 前の繰越
				@Ｍ４_初期設置 Ｍ４本体 d:ITEM_POS_SP03A_07 0 Ｍ４弾薬	
				$$f:アイテム再セットフラグ[d:ITEM_NO:M4_01] = 1;
				// 再発生しないもの
				@スティンガー_初期設置 スティンガー本体 d:ITEM_POS_SP03A_09 0 なし	

				// 再発生するもの
				@弾薬_Ｍ４_初期設置 Ｍ４弾:01 d:ITEM_POS_SP03A_05 0
				$$f:アイテム再セットフラグ[d:ITEM_NO:STINGER_01] = 1;

				trap ev001 d:PLAYER \
					-mask いる \
					-exec {
						@A_アイテム再発生	 d:WEAPON_BOX d:武器:Ｍ４ 29 d:ITEM_NO:M4_01 \
											 p:弾薬_Ｍ４_初期設置 Ｍ４弾:01 d:ITEM_POS_SP03A_05 0
					}
			}
		}
	}
		

}


// ------------------------------------
// カメラ関係の設定 
// ------------------------------------
// ステージカメラ設定 
// ------------------------------------
proc カメラセット {
	#if d:DEBUG_PRINT
		print 'chara_camera & stage_camera_set'
	#endif

	chara カメラ ステージカメラ		-c 0 -l 3 -p 0 
	chara カメラ メインカメラ		-c 0 -l 2 -p 40
	chara カメラ サブカメラ			-c 0 -l 2 -p 20
	chara カメラ サブカメラ２		-c 0 -l 2 -p 10
	#if d:DEMO_DEBUG
		chara カメラ クリア時カメラ		-c 0 -l 1 -p 10
	#else
		chara カメラ クリア時カメラ		-c 0 -l 0 -p 10
	#endif

	// デフォルトカメラ
	chara カメラ設定 ステージカメラ \
		-c 0 \	
		-b d:CAM_MIN,2000,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
		-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
		-r 258,2048,0 \
		-f 8000 \
		-a 200 \
		-i 2 2 0 0 \
		-s 1
}
// ステージ固有のカメラ設定 
// ------------------------------------
proc ザコサバイバルカメラ設定 {
	#if d:DEBUG_PRINT
		print 'stage_camera_set'
	#endif

	// ベースとなるカメラ
	trap ca001 d:PLAYER \
		-mask ？ \
		-camera \
		-exec {
			if ( $b:ステージ番号 == d:ZAKO_STAGE:GENOLA ) {
				// ゲノラステージはリミットをかける
				chara カメラ設定 メインカメラ \
					-c 0 \	
					-b -5000,5250,d:CAM_MIN	 5000,d:CAM_MAX,-3754 \
					-l -5000,2500,d:CAM_MIN	 5000,d:CAM_MAX,-11802 \
					-r 215,2048,0 \
					-f 8500 \
					-a 200 \
					-i 2 -1 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			} else {
				chara カメラ設定 メインカメラ \
					-c 0 \	
					-b -5000,2000,d:CAM_MIN	 5000,d:CAM_MAX,d:CAM_MAX \
					-l -5000,1500,d:CAM_MIN	 5000,d:CAM_MAX,d:CAM_MAX \
					-r 300,2048,0 \
					-f 8000 \
					-a 200 \
					-i 2 -1 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}
		}

	// 左側の２ｍ箱の裏
	trap ca002 d:PLAYER \
		-mask ＊ \
		-camera \
		-exec {
			@CS_スムーズカメラ降順 $6 -5500 -7000 500 300
			$i:補完ＲＸ = $i:CS_結果１;

			chara カメラ設定 サブカメラ \
				-c 0 \	
				-b -5000,2000,d:CAM_MIN	 5000,d:CAM_MAX,d:CAM_MAX \
				-l -5000,1500,d:CAM_MIN	 5000,d:CAM_MAX,d:CAM_MAX \
				-r $i:補完ＲＸ,2048,0 \
				-f 8000 \
				-a 200 \
				-i 3 3 0 0 \
				-z d:CAMERA_NO_CUSHION \
				-s $3
		}

	// 右側の２ｍ箱の裏
	trap ca003 d:PLAYER \
		-mask ＊ \
		-camera \
		-exec {
			@CS_スムーズカメラ降順 $4 6000 4500 500 300
			$i:補完ＲＸ = $i:CS_結果１;

			chara カメラ設定 サブカメラ \
				-c 0 \	
				-b -5000,2000,d:CAM_MIN	 5000,d:CAM_MAX,d:CAM_MAX \
				-l -5000,1500,d:CAM_MIN	 5000,d:CAM_MAX,d:CAM_MAX \
				-r $i:補完ＲＸ,2048,0 \
				-f 8000 \
				-a 200 \
				-i 3 3 0 0 \
				-z d:CAMERA_NO_CUSHION \
				-s $3
		}
		
	//////////////
	// 匍匐カメラ
	//////////////
	// 左側の２ｍ箱の裏
	trap ca004 d:PLAYER \
		-mask ？ \
		-state d:TRP_STATE_SQUAT d:TRP_STATE_GROUND \
		-camera \
		-exec {
			chara カメラ設定 サブカメラ２ \
				-c 0 \	
				-b -5000,2000,d:CAM_MIN	 5000,d:CAM_MAX,d:CAM_MAX \
				-l -5000,1500,d:CAM_MIN	 5000,d:CAM_MAX,d:CAM_MAX \
				-r 825,2048,0 \
				-f 8000 \
				-a 200 \
				-i 3 3 0 0 \
				-z d:CAMERA_NO_CUSHION \
				-s $3
		}

	// 中央左の２ｍ箱の裏
	trap ca005 d:PLAYER \
		-mask ？ \
		-state d:TRP_STATE_SQUAT d:TRP_STATE_GROUND \
		-camera \
		-exec {
			chara カメラ設定 サブカメラ２ \
				-c 0 \	
				-b -5000,2000,d:CAM_MIN	 5000,d:CAM_MAX,d:CAM_MAX \
				-l -5000,1500,d:CAM_MIN	 5000,d:CAM_MAX,d:CAM_MAX \
				-r 825,2048,0 \
				-f 8000 \
				-a 200 \
				-i 3 3 0 0 \
				-z d:CAMERA_NO_CUSHION \
				-s $3
		}

	// 中央右の２ｍ箱の裏
	trap ca006 d:PLAYER \
		-mask ？ \
		-state d:TRP_STATE_SQUAT d:TRP_STATE_GROUND \
		-camera \
		-exec {
			chara カメラ設定 サブカメラ２ \
				-c 0 \	
				-b -5000,2000,d:CAM_MIN	 5000,d:CAM_MAX,d:CAM_MAX \
				-l -5000,1500,d:CAM_MIN	 5000,d:CAM_MAX,d:CAM_MAX \
				-r 825,2048,0 \
				-f 8000 \
				-a 200 \
				-i 3 3 0 0 \
				-z d:CAMERA_NO_CUSHION \
				-s $3
		}

	// 右側の２ｍ箱の裏
	trap ca007 d:PLAYER \
		-mask ？ \
		-state d:TRP_STATE_SQUAT d:TRP_STATE_GROUND \
		-camera \
		-exec {
			chara カメラ設定 サブカメラ２ \
				-c 0 \	
				-b -5000,2000,d:CAM_MIN	 5000,d:CAM_MAX,d:CAM_MAX \
				-l -5000,1500,d:CAM_MIN	 5000,d:CAM_MAX,d:CAM_MAX \
				-r 825,2048,0 \
				-f 8000 \
				-a 200 \
				-i 3 3 0 0 \
				-z d:CAMERA_NO_CUSHION \
				-s $3
		}

}



// ザコサバイバルで必要な追加プロック
proc テロップ表示 {
	#if d:DEBUG_PRINT
		print 'telop_start!!!!!'
	#endif
	chara ザコラッシュテロップ表示 テロップ君 -m 1 -n ゲームスタート

	// 一瞬操作が止まってしまうためdelayでパッドをキャンセルする
	chara delay パッドキャンセルディレイ -time 30 \
		-exec {
			command パッド操作 -cancel
		}

}

proc ポーズ許可 {
	#if d:DEBUG_PRINT
		print 'pause_on!!!!!'
	#endif
	command メニュー設定 -pause on
}

proc ゲームスタート {
	#if d:DEBUG_PRINT
		print 'game_start!!!!!'
	#endif

	command パッド操作 -cancel

	// タイマーを表示
	mesg ＶＲスクリーン ＶＲスクリーン君 表示

	// ゲームオーバー関連処理を有効にするためにフラグを立てる
	$f:ロードチェックＯＮフラグ = 1

	// メニューを表示する
	command メニュー設定 -menu on -gage on -radar on -subwin on -radio on -pause on
	// 敵兵等の動作開始
	command ＶＲステージスタート
}












// -----------------------------------------------------------------------------------
// 以下デバッグ専用proc
// -----------------------------------------------------------------------------------
// デバッグキャラ
// ------------------------------------
proc デバッグキャラセット {
	#if d:DEBUG_PRINT
		print 'debug_chara_set'
	#endif

	#if d:CHARA_CAMERA
		chara キャラカメラ 敵兵カメラ \
			-c d:TARGET_CHARA \
			-s -920,610,200 \
			-r -200,1024,0 
	#endif

	#if d:SCREENSHOT
		chara スクリーンショット shot
	#endif

	#if d:USB_KEY
		chara USBキーボード実行 test \
			-e d:KBD_ESC {	
			} \
			-e d:KBD_1 {	
				$b:ステージ番号 = 1;
				restart -s;
			} \
			-e d:KBD_2 {	
				$b:ステージ番号 = 2;
				restart -s;
			} \
			-e d:KBD_3 {	
				$b:ステージ番号 = 3;
				restart -s;
			} \
			-e d:KBD_4 {	
				@ゴルルゴンステージスタート
			} \
			-e d:KBD_5 {	
				@メカゲノラステージスタート
			} \
			-e d:KBD_6 {	
				@ゲノラステージスタート
			} \
			-e d:KBD_7 {	
				$b:ステージ番号 = 7;
				restart -s;
			} \
	#endif
}
