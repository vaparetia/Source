/////////////////////////////////////////////////////////////////
// 各兵士のコマンダー
proc 後衛兵コマンダー {
	#if d:DEBUG_PRINT
		print 'wccomm_set'
	#endif

	switch ( $s:選択プレイヤー ) {
		case ( ライデン ) {
			@後衛兵コマンダー_ライデン
		}
		case ( スネーク ) {
			@後衛兵コマンダー_スネーク
		}
		case ( 前作スネーク ) {
			@後衛兵コマンダー_前作スネーク
		}
	}
}

proc 前衛兵コマンダー {
	#if d:DEBUG_PRINT
		print 'atcomm_set'
	#endif

	switch ( $s:選択プレイヤー ) {
		case ( ライデン ) {
			@前衛兵コマンダー_ライデン
		}
		case ( スネーク ) {
			@前衛兵コマンダー_スネーク
		}
		case ( 前作スネーク ) {
			@前衛兵コマンダー_前作スネーク
		}
	}
}

proc コマンダー設定 {
	#if d:DEBUG_PRINT
		print 'commander_set'
	#endif

	command 敵兵メモリーオールリセット

	switch ( $b:ステージ番号 ) {
		case ( d:ZAKO_STAGE:G_SOL_1 ) {
			chara コマンダー 敵兵セット \
				-a 後衛兵コマンダー \
				-d ザコサバイバル \
				-r d:R_POS_01 d:R_POS_02 d:R_POS_03 d:R_POS_04 \
				-c d:R_POS_01 d:R_POS_02 d:R_POS_03 d:R_POS_04 \
				-v [ene_plant_voice:01] \
				-z $i:敵標準麻酔持続 \
				-h $i:標準警戒時間 \
				-o $i:敵標準気絶持続 \
				-s (d:ENE_STAGE_VR_ANOTHER) \
				-b 0 \
				-m d:ALERT_MODE_KIKEN
		}
		case ( d:ZAKO_STAGE:G_SOLS_TEAM ) {
			chara コマンダー 敵兵セット \
				-w 前衛兵コマンダー \
				-a 後衛兵コマンダー \
				-d ザコサバイバル \
				-r d:R_POS_01 d:R_POS_02 d:R_POS_03 d:R_POS_04 \
				-c d:R_POS_01 d:R_POS_02 d:R_POS_03 d:R_POS_04 \
				-v [ene_plant_voice:01] \
				-z $i:敵標準麻酔持続 \
				-h $i:標準警戒時間 \
				-o $i:敵標準気絶持続 \
				-s (d:ENE_STAGE_VR_ANOTHER) \
				-b 0 \
				-m d:ALERT_MODE_KIKEN
		}
		case ( d:ZAKO_STAGE:T_G_SOLS_TEAM ) {
			chara コマンダー 敵兵セット \
				-w 前衛兵コマンダー \
				-a 後衛兵コマンダー \
				-d ザコサバイバル \
				-r d:R_POS_01 d:R_POS_02 d:R_POS_03 d:R_POS_04 \
				-c d:R_POS_01 d:R_POS_02 d:R_POS_03 d:R_POS_04 \
				-v [ene_plant_voice:01] \
				-z $i:敵標準麻酔持続 \
				-h $i:標準警戒時間 \
				-o $i:敵標準気絶持続 \
				-s (d:ENE_STAGE_VR_ANOTHER) \
				#if d:DEMO_DEBUG
					-b 0 \		// シナリオデモ作成用
				#else
					-b 255 \	// 本番用
				#endif
				-m d:ALERT_MODE_KIKEN

				switch ( $s:選択プレイヤー ) {
					case ( ライデン ) {
						command ＶＲ敵兵追加 7;
					}
					case ( スネーク ) {
						command ＶＲ敵兵追加 9;
					}
					case ( 前作スネーク ) {
						command ＶＲ敵兵追加 12;
					}
				}
		}
		case ( d:ZAKO_STAGE:GURLUGON ) {
			// ゴルルルゴンはここに入れる
			chara ゴルルゴン ゴルルゴン -s d:GLL_STATUS_FIGHT -p 0,0,-21000 -m 1 \
										-e ザコサバイバルクリア時処理 -g ライデン変装時デモ発動 -c 雑誌反応時デモ発動
		}
		case ( d:ZAKO_STAGE:MECHGENOLA ) {
			// メカゲノラはここに入れる
			chara ゴルルゴン メカゲノラ -s d:GLL_STATUS_FIGHT -p 0,0,-21000 -m 2 -l 24000 \
										-e ザコサバイバルクリア時処理 -c チャフ攻撃時デモ発動
			chara スポットライト投影モデル 投影モデル -m d:KMS_SP03A3 -p 0 10 0
		}
		case ( d:ZAKO_STAGE:GENOLA ) {
			// ゲノラはここに入れる
			chara ゴルルゴン ゲノラ -s d:GLL_STATUS_FIGHT -p 0,-10000,-19000 -m 0 \
									-e ザコサバイバルクリア時処理 -c たらい落下時デモ発動
		}
		default {
			#if d:DEBUG_PRINT
				print 'WARNING!!!!!!!不正な値が入っています。$b:ステージ番号='$b:ステージ番号
			#endif

			command assert ( d:FALSE ) 'stage no error  (scenario err) コマンダー設定'
		}
	}

	mesg コマンダー 敵兵セット 危険レベル減らないプレイヤ発見済み
}


proc デモ用キャラ設置 {
	#if d:DEBUG_PRINT 
		print 'demo_chara_set'
	#endif

	switch ( $s:選択プレイヤー ) {
		case ( ライデン ) {
			chara プットモーションモデル デモゴルルゴン \
				-pos 0 0 -38000 \
				-dir 0 \
				-kms gll_def \
				-mar gll_sp03a \
				-number d:G_MTN:gol_idle \
				-item aks_sp_gll 6 \
				-status ( d:PUT_MOT_WAIT | d:PUT_MOT_INVISIBLE | d:PUT_MOT_10SCALE | d:PUT_MOT_SHADOW | d:PUT_MOT_PAD_VIBRATION )
		}
		case ( スネーク ) {
			chara プットモーションモデル デモメカゲノラ \
				-pos 0 0 -21000 \
				-dir 0 \
				-kms gno_meca_mt \
				-mar gll_sp03a \
				-number d:G_MTN:gno_meca_toujyou \
				-item fms_4gno 6 \
				-status ( d:PUT_MOT_WAIT | d:PUT_MOT_INVISIBLE | d:PUT_MOT_10SCALE )

			chara オブジェクト分解 オブジェクト分解君 -name デモメカゲノラ -time 90 120

		}
		case ( 前作スネーク ) {
			chara プットモーションモデル デモゲノラ \
				-pos -1500,-10000,-21000 \
				-dir 0 \
				-kms gno_def \
				-mar gll_sp03a \
				-number d:G_MTN:gno_come_2 \
				-item fms_4gno 6 \
				-status ( d:PUT_MOT_WAIT | d:PUT_MOT_INVISIBLE | d:PUT_MOT_10SCALE | d:PUT_MOT_SHADOW | d:PUT_MOT_PAD_VIBRATION )

		}
	}

}

proc デモゴルルゴン設置 {
	#if d:DEBUG_PRINT 
		print 'demo_gur_set'
	#endif

	switch ( $s:選択プレイヤー ) {
		case ( ライデン ) {
			chara プットモーションモデル デモゴルルゴン \
				-pos 0,0,-21000 \
				-dir 0 \
				-kms gll_def \
				-mar gll_sp03a \
				-number d:G_MTN:gol_idle \
				-item aks_sp_gll 6 \
				-status ( d:PUT_MOT_WAIT | d:PUT_MOT_INVISIBLE | d:PUT_MOT_10SCALE | d:PUT_MOT_SHADOW | d:PUT_MOT_PAD_VIBRATION )

			chara プットモーションモデル デモライデン \
				-pos 0,0,0 \
				-dir 0 \
				-kms rai_gbs_vsg_mt \
				-mar gll_sp03a \
				-number d:G_MTN:rai_disguise_capture \
				-item aks 6 \
				-world デモゴルルゴン 10 -100,-1050,125	 -1104,1832,1013 \
				-status ( d:PUT_MOT_WAIT | d:PUT_MOT_INVISIBLE )
		}
		case ( 前作スネーク ) {
			chara プットモーションモデル デモゴルルゴン \
				-pos -4000 0 -46000 \
				-dir 0 \
				-kms gll_def \
				-mar gll_sp03a \
				-number d:G_MTN:gol_idle \
				-item aks_sp_gll 6 \
				-status ( d:PUT_MOT_WAIT | d:PUT_MOT_INVISIBLE | d:PUT_MOT_10SCALE | d:PUT_MOT_SHADOW )

			chara プットモーションモデル デモメカゲノラ \
				-pos -6500 -10000 -21000 \
				-dir 1024 \
				-kms gno_meca_mt \
				-mar gll_sp03a \
				-number d:G_MTN:gno_meca_toujyou \
				-item fms_4gno 6 \
				-status ( d:PUT_MOT_WAIT | d:PUT_MOT_INVISIBLE | d:PUT_MOT_10SCALE | d:PUT_MOT_SHADOW )

			chara オブジェクト分解 オブジェクト分解君 -name デモメカゲノラ -time 90 120

			chara プットモーションモデル デモゲノラ \
				-pos 0,-10000,-19000 \
				-dir 0 \
				-kms gno_def \
				-mar gll_sp03a \
				-number d:G_MTN:gol_idle \
				-item fms_4gno 6 \
				-status ( d:PUT_MOT_WAIT | d:PUT_MOT_INVISIBLE | d:PUT_MOT_10SCALE | d:PUT_MOT_SHADOW )

			#if d:DEMO_DEBUG
				// シナリオデモ作成用
				chara ダミーターゲット君 ゴルルゴン的 -p -4000 0 -50000 -s 2000 1000 4000 -e ゲノラ対ゴルルゴンデモ発動
			#else
				// 本番用
				chara ダミーターゲット君 ゴルルゴン的 -p -2000 4000 -50000 -s 2000 1000 4000 -e ゲノラ対ゴルルゴンデモ発動
			#endif

			chara	ＶＲ移動的 メカゲノラターゲット \
					-flag ( d:VR_TRG_HEX | d:VR_TRG_HIDESTART | d:VR_TRG_CIRCLE ) \
					-route 51 0 \
					-dir 0 1024 \
					-kouten	256 2048 32000 \
					-v	240 180 \
					-c ゲノラ対メカゲノラデモ発動

			chara パッドデモ 張り付きパッドデモ１ -file sp03a_paddemo_01
			chara パッドデモ 張り付きパッドデモ２ -file sp03a_paddemo_02
		}
	}
}


