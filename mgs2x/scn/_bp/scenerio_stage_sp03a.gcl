// main
if ( $f:sp03a_ザコサバイバルウィンドウ表示終了フラグ == 0 ) {
	@全ミッション共通システム設定 ( d:VR_GOAL_ENEMY | d:VR_NO_OPEN_SE )
	@ＶＲウィンドウ設定	d:SP03A_WINDOW_RES
	// ＶＲウィンドウを表示する
	mesg ＶＲウィンドウ ＶＲウィンドウ君 開く

} else {
	if ( $f:sp03a_ザコサバイバルゲームフラグ == 0 ) {
	//-------------------------------------------------------------------
	// タイトルテロップ部分
	//-------------------------------------------------------------------
		// このときは操作をさせない
		command パッド操作 -release

		switch ( $s:選択プレイヤー ) {
			case ( ライデン ) {
				$$b:プレイヤー番号 = 1;
			}
			case ( スネーク ) {
				$$b:プレイヤー番号 = 0;
			}
			case ( 前作スネーク ) {
				$$b:プレイヤー番号 = 2;
			}
			default {
				#if d:DEBUG_PRINT
					print 'WARNING!!!!!!!不正な値が入っています。$s:選択プレイヤー='$s:選択プレイヤー
				#endif

				command assert ( d:FALSE ) 'error  (scenario err) タイトルテロップ部分'
			}
		}

		@サウンド設定
		chara ザコラッシュテロップ表示 テロップ君 -m 0 -b $b:ステージ番号 -n ザコサバイバルスタート -p $$b:プレイヤー番号

	} else {
	//-------------------------------------------------------------------
	// ゲーム部分
	//-------------------------------------------------------------------
		// メカゲノラ戦だけはライトファイルを差し替える
		if ( $b:ステージ番号 == d:ZAKO_STAGE:MECHGENOLA ) {
			$s:ＶＲライトファイル名 = vr_dark;
		}

		chara マップ ザコサバイバル -k null -h d:HZX_NAME,0 -l $s:ＶＲライトファイル名

		if ( $b:ステージ番号 <= d:ZAKO_STAGE:T_G_SOLS_TEAM ) {
			// ザコサバイバル用のアタリを追加
			command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 1
			command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 2
			// 壊れＶＲオブジェ
			command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 6
			command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 7
			command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 8
			command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 9
			command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 10
			command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 11
			command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 12
			command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 13
			command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 14
			command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 15
			command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 16
			command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 17
			command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 18

		} else if ( $b:ステージ番号 == d:ZAKO_STAGE:GURLUGON || $b:ステージ番号 == d:ZAKO_STAGE:MECHGENOLA ) {
			// コルルゴン、メカゲノラステージ用のアタリを追加
			command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 3
			// 壊れＶＲオブジェ
			command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 6
			command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 7
			command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 8
			command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 9
			command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 10
			command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 11
			command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 12
			command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 13
			command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 14
			command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 15
			command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 16
			command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 17
			command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 18
			// ゴルルゴンステージはさらにアタリを追加
			if ( $b:ステージ番号 == d:ZAKO_STAGE:GURLUGON ) {
				command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 19
			}

		} else if ( $b:ステージ番号 == d:ZAKO_STAGE:GENOLA ) {
			// ゲノラ用のアタリを追加
			command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 4
			command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 18
		}

		command マップ設定 ザコサバイバル -set {
			// ローカルの初期化
			// ------------------------------------
			@ローカル変数初期化		// ローカルで使用する変数で初期化をする場合はここで

			if ( $b:ステージ番号 > d:ZAKO_STAGE:G_SOL_1 ) {
				// テロップが出た後は前ステージのタイマーを引き継ぐ
				$$i:ライデンタイム 				= $i:ザコサバイバルタイマー残り時間;
				$$i:スネークタイム 				= $i:ザコサバイバルタイマー残り時間;
				$$i:プリスキンタイム 			= $i:ザコサバイバルタイマー残り時間;
				$$i:タキシードスネークタイム 	= $i:ザコサバイバルタイマー残り時間;
				$$i:刀ライデンタイム 			= $i:ザコサバイバルタイマー残り時間;
				$$i:前作スネークタイム			= $i:ザコサバイバルタイマー残り時間;
			}

			@全ミッション共通システム設定 ( d:VR_GOAL_ENEMY | d:VR_NO_OPEN_SE )

			@レーダーオンオフチェック 0								// stdch.hで定義
			@常駐キャラ設定											// stdch.hで定義

			@ザコサバイバルステージ表示

			@サウンド設定
			@A_プレイヤー設定 sna_sp03a rai_sp03a					// a_stdproc.hで定義
			@ＶＲエフェクト設置
			@ＶＲ空設置

	#ifndef d:E_TALES
			@ＶＲウィンドウ設定	d:SP03A_WINDOW_RES
	#else
			@テイルズＶＲウィンドウセット＿ゴルルゴン戦中
	#endif

			// ザコサバイバル固有のクリア設定呼びわけ
			// ------------------------------------
			if ( $b:ステージ番号 <= d:ZAKO_STAGE:T_G_SOLS_TEAM ) {
				@ＶＲポーズ設定
			} else {
	//	テイルズＥ以外では
	#ifndef d:E_TALES
				@ＶＲクリア設定 p:A_ミッションエンド p:A_ＲＥＴＲＹプロック
	//	テイルズＥのときは
	#else
				@テイルズＥ用ＶＲクリア設定２
	#endif
			}

			// ステージに引かれるライン
			// ------------------------------------
			@ザコサバイバル用アウトライン

			// 設定値を変更する場合は以下のプロック内で設定
			// ------------------------------------
			@設定値変更				// 敵兵や的のパラメータをステージ限定で変える時はここで

			// プレイヤーの設定
			// ------------------------------------
			@プラグイン設定			// プレイヤーのプラグインがいる時はここで
			@ジャンプ設定

			// 敵兵・的関係の設定
			// ------------------------------------
			@コマンダー設定
			@シナリオデモキャラセット
			if ( $b:ステージ番号 == d:ZAKO_STAGE:T_G_SOLS_TEAM ) {
				@デモ用キャラ設置
			}
	#ifndef d:E_TALES
			if ( $b:ステージ番号 == d:ZAKO_STAGE:GURLUGON || $b:ステージ番号 == d:ZAKO_STAGE:GENOLA ) {
				@デモゴルルゴン設置
			}
	#endif

			// ＢＧＭの設定(プレイヤー→敵兵→BGMの順で呼ぶ)
			// ------------------------------------
			@ＢＧＭ設定


			// 光源、オブジェクト、カメラ関連の設定
			// ------------------------------------
			if ( $b:ステージ番号 <= d:ZAKO_STAGE:T_G_SOLS_TEAM ) {
				@ＶＲフォグ設定 -10000 85000 -9000 75000 -9000 75000
			} else if ( $b:ステージ番号 == d:ZAKO_STAGE:GURLUGON ) {
				@ゴルルゴン戦フォグ設定
			} else if ( $b:ステージ番号 == d:ZAKO_STAGE:MECHGENOLA ) {
				@メカゲノラ戦フォグ設定
			} else {
				// ゲノラ戦は普通
				@ＶＲフォグ設定 -10000 85000 -9000 75000 -9000 75000
			}

			@カメラセット					// chara カメラとベースのカメラを設定
			@ザコサバイバルカメラ設定		// ステージ固有のカメラ設定がいる時はこのプロックで

			if ( $b:ステージ番号 <= d:ZAKO_STAGE:T_G_SOLS_TEAM ) {
				@ＶＲキャラ用ライト設置				// 必ず最後に設定
			} else if ( $b:ステージ番号 == d:ZAKO_STAGE:GURLUGON ) {
				@ゴルルゴン戦キャラ用ライト設置
			} else if ( $b:ステージ番号 == d:ZAKO_STAGE:MECHGENOLA ) {
				@メカゲノラ戦キャラ用ライト設置
			} else {
				// ゲノラ戦は普通
				@ＶＲキャラ用ライト設置				// 必ず最後に設定
			}

			// アイテムの設定(キャラライトを反映させるためにここで設定)
			// ------------------------------------
	//	テイルズＥ以外では
	#ifndef d:E_TALES
			@アイテム設定
	//	テイルズＥのときは
	#else
			@テイルズＥ用アイテム設定
	#endif

			if ( $b:ステージ番号 <= d:ZAKO_STAGE:T_G_SOLS_TEAM ) {
				chara 六角フェード 六角フェード君 \
					-time	60 \
					-mode	0 \		//0:フェードin 1:フェードout
					-col	0, 0, 0 \
					-proc	ポーズ許可 \
					-ex								//これがあるとロードのフェードより強くなります

				@テロップ表示
			} else {
				// タイマーを表示
				@ゲームスタート
			}

			#if d:DEBUG_CHARA
				@デバッグキャラセット
			#endif
		}

		//初期マップの表示
		command マップ表示 -show ザコサバイバル

	}

	//	テイルズでは
	#ifdef d:E_TALES
		// 全てのセットが終わったところでフェードイン
		@ステージ開始時処理\
		d:LOAD_TYPE:NO_MOVE_TYPE 紙芝居 0 d:DEFAULT_M_TYPE
	#endif
}

//-------------------------------------------------------------------------------------
// 各proc設定
//-------------------------------------------------------------------------------------
//------------------------------------------------------------
// ステージ開始時処理(このステージは空でＯＫ)
//------------------------------------------------------------
proc ＶＲステージ開始時処理 {
	#if d:DEBUG_PRINT
		print 'game_start!!!!!'
	#endif

	$f:sp03a_ザコサバイバルウィンドウ表示終了フラグ = 1;
	chara delay リスタートディレイ -time 30 \
		-exec {
			restart -save 
		}
}

// ------------------------------------
// ステージのリスタート機構
// ------------------------------------
proc ザコサバイバルスタート {
	$b:ステージ番号 = $b:ステージ番号 + 1;
	$f:sp03a_ザコサバイバルゲームフラグ = 1;
	$i:プレイヤー初期Ｘ位置 = 0 ;
	$i:プレイヤー初期Ｙ位置 = 0 ;
	$i:プレイヤー初期Ｚ位置 = 2000 ;
	$i:プレイヤー初期方向 = 2048 ;

	restart -save
}

proc テロップスタート {
	command	ポーズリセット
	$f:sp03a_ザコサバイバルゲームフラグ = 0;
	restart -save
}

proc ゴルルゴンステージスタート {
	$b:ステージ番号 = d:ZAKO_STAGE:GURLUGON;
	$i:プレイヤー初期Ｘ位置 = 550 ;
	$i:プレイヤー初期Ｙ位置 = 0 ;
	$i:プレイヤー初期Ｚ位置 = -3250 ;
	$i:プレイヤー初期方向 = 2048 ;

	restart -save
}

proc メカゲノラステージスタート {
	$b:ステージ番号 = d:ZAKO_STAGE:MECHGENOLA;
	$i:プレイヤー初期Ｘ位置 = -500 ;
	$i:プレイヤー初期Ｙ位置 = 0 ;
	$i:プレイヤー初期Ｚ位置 = -6500 ;
	$i:プレイヤー初期方向 = 2048 ;

	restart -save
}

proc ゲノラステージスタート {
	$b:ステージ番号 = d:ZAKO_STAGE:GENOLA;
	$i:プレイヤー初期Ｘ位置 = -1500 ;
	$i:プレイヤー初期Ｙ位置 = 0 ;
	$i:プレイヤー初期Ｚ位置 = -11500 ;
	$i:プレイヤー初期方向 = 2048 ;

	restart -save
}


// ------------------------------------
// クリア時の処理
// ------------------------------------
proc 敵兵全滅プロック {
	if (`command ゲームオーバーチェック` == 0 ) {
		// タイマーストップ & 引継ぎ
		command ＶＲタイマーポーズ
		$i:ザコサバイバルタイマー残り時間 = `%ＶＲゲットタイム`;
		command varsave $i:ザコサバイバルタイマー残り時間

		// すぐ操作を奪う
		command パッド操作 -release

		command セットサウンドコード -c d:SE_JOUCHUU_OFF
		command 字幕制御 -disable
		command メニュー設定 -menu off -gage off -radar off -pause off

		if ( $b:ステージ番号 < d:ZAKO_STAGE:T_G_SOLS_TEAM ) {
			// WINを表示
			chara ザコラッシュテロップ表示 テロップ君 -m 3 -n テロップスタート
			command	ポーズセット

			chara 六角フェード 六角フェード君 \
				-time	90 \
				-mode	1 \		//0:フェードin 1:フェードout
				-col	0, 0, 0 \
				-ex								//これがあるとロードのフェードより強くなります

		} else {
			// クリア時にカメラアングルを変える
			chara カメラ設定 クリア時カメラ \
				-c 1 \	
				-p -0,312,11317 -t -0,3411,-7396 \
				-r -107,2048,0 -f 18968 \
				-a 200 \
				-i 1 -1 0 0 \
				-s 1

			@シナリオデモ開始処理
			// ゴーグル系も解除
			@プレイヤーアイテム追加解除
			mesg ＶＲスクリーン ＶＲスクリーン君 非表示
			command セットサウンドコード -c d:SNG_FOUTS_S
			
			switch ( $s:選択プレイヤー ) {
				case ( ライデン ) {
					@ゴルルゴン登場デモ
				}
				case ( スネーク ) {
					@メカゲノラ登場デモ
				}
				case ( 前作スネーク ) {
					@ゲノラ登場デモ
				}

			}
		}
	}
}


proc ザコサバイバルクリア時処理 {
	#if d:DEBUG_PRINT 
		print 'zakosava cleard!!'
	#endif

	command ＶＲステージクリア
}

proc ＶＲクリア時処理 {
	#if d:DEBUG_PRINT 
		print 'clear'
	#endif

	// 強制モーションを発動
	@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_2 0

	// シナリオデモクリアのときはシネマスクリーンを消す
	mesg シネマスクリーン シネマ フェードイン 0

	// クリア時にカメラアングルを変える
	switch ( $s:選択プレイヤー ) {
		case ( 前作スネーク ) {
			chara カメラ設定 クリア時カメラ \
				-c 1 \	
				-p 1907,3078,-4103 -t 726,2010,-8474 \
				-r 151,2220,0 -f 4652 \
				-a 200 \
				-i 1 0 0 0 \
				-s 1
		}
		default {
			// 前作スネーク以外
			chara カメラ設定 クリア時カメラ \
				-c 1 \	
				-p -8,7820,14531 -t -8,4915,4954 \
				-r 192,2048,0 -f 10008 \
				-a 200 \
				-i 1 0 0 0 \
				-s 1
		}
	}
}


// ------------------------------------
// パラメータ系の変更
// ------------------------------------
// ローカル変数初期化
// ------------------------------------
proc ローカル変数初期化 {
	#if d:DEBUG_PRINT 
		print 'localvar_init'
	#endif
}
// 設定値を変更
// ------------------------------------
proc 設定値変更 {
	#if d:DEBUG_PRINT 
		print 'status_set'
	#endif

	$w:敵潜入視力 = 30000;
	$w:敵危険視力 = 30000;
	$w:敵回避視力 = 30000;

	// スティンガーの性能を上げる
	command スティンガー性能 \
		-life 360 \
		-s 0,-250 ,0
	

	if ( $b:ステージ番号 == d:ZAKO_STAGE:G_SOL_1 ) {
		switch ( $s:選択プレイヤー ) {
			case ( ライデン ) {
				$w:体力最大 = 100;
				$w:体力 = 100;
				$w:武器最大数Ｒ[ d:武器:ブレード ] = 1;
				$w:武器弾数Ｒ[ d:武器:ブレード ] = 1;
				$w:武器最大数Ｒ[ d:武器:凍結スプレー ] = 1;
				$w:武器弾数Ｒ[ d:武器:凍結スプレー ] = 1;
				command	ゴルキャップあり
				$w:アイテム最大数Ｒ[ d:アイテム:ゴル兵制服 ] = 1;
				$w:アイテム数Ｒ[ d:アイテム:ゴル兵制服 ] = 1;
			}
			case ( スネーク ) {
				$w:体力最大 = 100;
				$w:体力 = 100;
				$w:武器最大数Ｒ[ d:武器:凍結スプレー ] = 1;
				$w:武器弾数Ｒ[ d:武器:凍結スプレー ] = 1;
			}
			case ( 前作スネーク ) {
				$w:体力最大 = 100;
				$w:体力 = 100;
				$w:武器最大数Ｒ[ d:武器:凍結スプレー ] = 1;
				$w:武器弾数Ｒ[ d:武器:凍結スプレー ] = 1;
			}
			default {
				#if d:DEBUG_PRINT
					print 'WARNING!!!!!!!不正な値が入っています。$s:選択プレイヤー='$s:選択プレイヤー
				#endif

				command assert ( d:FALSE ) 'error  (scenario err) 設定値変更'
			}
		}
	}
	// ライデンは刀を持っているので、いつでもこのフラグを管理する
	switch ( $s:選択プレイヤー ) {
		case ( ライデン ) {
			$w:プレイヤーフラグ = ( $w:プレイヤーフラグ & ~(d:PL_START_STATE_BLADE_OUT) );	// 刀はしまっている
			$w:プレイヤーフラグ = ( $w:プレイヤーフラグ & ~(d:PL_START_STATE_BLADE_INV) );	// 峰うちじゃない
		}
	}

	$w:武器 = d:武器:素手;
	$w:アイテム = d:アイテム:素手;
}


// ------------------------------------
// ステージ表示に関する設定
//-------------------------------------
proc ザコサバイバルステージ表示 {
	#if d:DEBUG_PRINT
		print 'stage_object_set'
	#endif

	if ( $b:ステージ番号 <= d:ZAKO_STAGE:T_G_SOLS_TEAM ) {
		// ザコサバイバルステージ
		chara ＶＲオブジェ ゲノラを隠す床			-m d:KMS_SP03A3		 -r 0 0 0 -p 0 0 0 -l $s:ＶＲライトファイル名 
		chara ＶＲオブジェ ゴルルゴンを隠す壁		-m d:KMS_SP03A4		 -r 0 0 0 -p 0 0 0 -l $s:ＶＲライトファイル名
		@ザコサバイバル用オブジェ設置
		chara ＶＲオブジェ ゴルルゴンを隠す壁の影	-m d:KMS_SP03A4_SHD	 -r 0 0 0 -p 0 0 0 -l $s:ＶＲライトファイル名

		if ( $s:選択プレイヤー != 前作スネーク ) {
			chara ＶＲオブジェ 外壁				-m d:KMS_SP03A1				 -r 0 0 0 -p 0 0 0 -l $s:ＶＲライトファイル名
			chara ＶＲオブジェ 外壁の影			-m d:KMS_SP03A1_SHD			 -r 0 0 0 -p 0 4 -2 -l $s:ＶＲライトファイル名
			chara ＶＲオブジェ 箱03への影			-m d:KMS_SP03A1_SHD_BOX03	 -r 0 0 0 -p 0 8 0 -l $s:ＶＲライトファイル名
			chara ＶＲオブジェ 箱09への影			-m d:KMS_SP03A1_SHD_BOX09	 -r 0 0 0 -p 0 8 0 -l $s:ＶＲライトファイル名
			mesg ＶＲオブジェ 外壁 off
			mesg ＶＲオブジェ 外壁の影 off
			mesg ＶＲオブジェ 箱03への影 off
			mesg ＶＲオブジェ 箱09への影 off

		} else {
			chara ＶＲオブジェ ゲノラ床			-m d:KMS_SP03A0				 -r 0 0 0 -p 0 0 0 -l $s:ＶＲライトファイル名
			chara ＶＲオブジェ 外壁				-m d:KMS_SP03A1				 -r 0 0 0 -p 0 0 0 -l $s:ＶＲライトファイル名
			chara ＶＲオブジェ 外壁の影			-m d:KMS_SP03A2				 -r 0 0 0 -p 0 0 0 -l $s:ＶＲライトファイル名

			mesg ＶＲオブジェ ゲノラ床 off
			mesg ＶＲオブジェ 外壁 off
			mesg ＶＲオブジェ 外壁の影 off
		}

		


	} else if ( $b:ステージ番号 == d:ZAKO_STAGE:GURLUGON ) {
		// ゴルルゴンステージ
		chara ＶＲオブジェ ゲノラを隠す床		-m d:KMS_SP03A3				 -r 0 0 0 -p 0 0 0 -l $s:ＶＲライトファイル名
		chara ＶＲオブジェ 外壁				-m d:KMS_SP03A1				 -r 0 0 0 -p 0 0 0 -l $s:ＶＲライトファイル名
		@ザコサバイバル用オブジェ設置
		chara ＶＲオブジェ ふた				-m d:KMS_FUTA				 -r 0 0 0 -p 0 0 0 -l $s:ＶＲライトファイル名
		chara ＶＲオブジェ 外壁の影			-m d:KMS_SP03A1_SHD			 -r 0 0 0 -p 0 0 0 -l $s:ＶＲライトファイル名
		chara ＶＲオブジェ 箱03への影			-m d:KMS_SP03A1_SHD_BOX03	 -r 0 0 0 -p 0 0 0 -l $s:ＶＲライトファイル名
		chara ＶＲオブジェ 箱09への影			-m d:KMS_SP03A1_SHD_BOX09	 -r 0 0 0 -p 0 0 0 -l $s:ＶＲライトファイル名

		// デモ用
		chara ＶＲオブジェ デモ用外壁の影		-m d:KMS_SP03A1_SHD			 -r 0 0 0 -p 0 4 -2 -l $s:ＶＲライトファイル名
		mesg ＶＲオブジェ デモ用外壁の影 off
		chara ＶＲオブジェ デモ用箱03への影			-m d:KMS_SP03A1_SHD_BOX03	 -r 0 0 0 -p 0 10 0 -l $s:ＶＲライトファイル名
		mesg ＶＲオブジェ デモ用箱03への影 off
		chara ＶＲオブジェ デモ用箱09への影			-m d:KMS_SP03A1_SHD_BOX09	 -r 0 0 0 -p 0 8 0 -l $s:ＶＲライトファイル名
		mesg ＶＲオブジェ デモ用箱09への影 off

	} else if ( $b:ステージ番号 == d:ZAKO_STAGE:MECHGENOLA ) {
		// メカゲノラステージ
		chara ＶＲオブジェ ゲノラを隠す床		-m d:KMS_SP03A3				 -r 0 0 0 -p 0 0 0 -l $s:ＶＲライトファイル名
		chara ＶＲオブジェ 外壁				-m d:KMS_SP03A1				 -r 0 0 0 -p 0 0 0 -l $s:ＶＲライトファイル名
		@ザコサバイバル用オブジェ設置_影なし

	} else if ( $b:ステージ番号 == d:ZAKO_STAGE:GENOLA ) {
		// ゲノラステージ
		chara ＶＲオブジェ メインの床	 			-m d:KMS_SP03A0	 -r 0 0 0 -p 0 0 0 -l $s:ＶＲライトファイル名
		chara ＶＲオブジェ 外壁			 			-m d:KMS_SP03A1	 -r 0 0 0 -p 0 0 0 -l $s:ＶＲライトファイル名
		chara ＶＲオブジェ ゴルルゴンを隠す壁		-m d:KMS_SP03A2	 -r 0 0 0 -p 0 0 0 -l $s:ＶＲライトファイル名
		chara ＶＲオブジェ 箱:13 					-m d:KMS_BOX13 	 -r 0,0,0 -p 0,0,0 -l $s:ＶＲライトファイル名 \
													-e ＶＲオブジェ破壊時処理
		chara ＶＲオブジェ デモ箱:13 				-m d:KMS_BOX13 	 -r 0,0,0 -p 0,4,0 -l $s:ＶＲライトファイル名
													
		mesg ＶＲオブジェ デモ箱:13 off
	}
}

proc ザコサバイバル用オブジェ設置 {
	#if d:DEBUG_PRINT
		print 'vr_object_set'
	#endif

	command foreach -argc 2 -repeat 13 \
		-data { \
				{ 箱:04, d:KMS_BOX04 } \
				{ 箱:09, d:KMS_BOX09 } \
				{ 箱:12, d:KMS_BOX12 } \
				{ 箱:01, d:KMS_BOX01 } \
				{ 箱:02, d:KMS_BOX02 } \
				{ 箱:03, d:KMS_BOX03 } \
				{ 箱:05, d:KMS_BOX05 } \
				{ 箱:06, d:KMS_BOX06 } \
				{ 箱:07, d:KMS_BOX07 } \
				{ 箱:08, d:KMS_BOX08 } \
				{ 箱:10, d:KMS_BOX10 } \
				{ 箱:11, d:KMS_BOX11 } \
				{ 箱:13, d:KMS_BOX13 } \
			} \
		-exec { \
				if ( $b:ステージ番号 <= d:ZAKO_STAGE:T_G_SOLS_TEAM ) {
					chara ＶＲオブジェ $1 \
						-m $2 -r 0,0,0 -p 0,0,0 \
						-l $s:ＶＲライトファイル名 \
						-e ＶＲオブジェ破壊時処理
				} else {
					chara ＶＲオブジェ $1 \
						-m $2 -r 0,0,0 -p 0,0,0 \
						-l $s:ＶＲライトファイル名 \
						-f d:PUT_VROBJ_STATUS_TARGET \
						-e ＶＲオブジェ破壊時処理
				}
			}
	chara ＶＲオブジェ 箱影:09 -m d:KMS_BOX09_SHD -r 0,0,0 -p 0,0,0 -l $s:ＶＲライトファイル名
	chara ＶＲオブジェ 箱影:11 -m d:KMS_BOX11_SHD -r 0,0,0 -p 0,0,0 -l $s:ＶＲライトファイル名
	chara ＶＲオブジェ 箱影:12 -m d:KMS_BOX12_SHD -r 0,0,0 -p 0,0,0 -l $s:ＶＲライトファイル名


	// デモ用の箱
	command foreach -argc 2 -repeat 13 \
		-data { \
				{ デモ箱:04, d:KMS_BOX04 } \
				{ デモ箱:09, d:KMS_BOX09 } \
				{ デモ箱:12, d:KMS_BOX12 } \
				{ デモ箱:01, d:KMS_BOX01 } \
				{ デモ箱:02, d:KMS_BOX02 } \
				{ デモ箱:03, d:KMS_BOX03 } \
				{ デモ箱:05, d:KMS_BOX05 } \
				{ デモ箱:06, d:KMS_BOX06 } \
				{ デモ箱:07, d:KMS_BOX07 } \
				{ デモ箱:08, d:KMS_BOX08 } \
				{ デモ箱:10, d:KMS_BOX10 } \
				{ デモ箱:11, d:KMS_BOX11 } \
				{ デモ箱:13, d:KMS_BOX13 } \
			} \
		-exec { \
				chara ＶＲオブジェ $1 \
					-m $2 -r 0,0,0 -p 0,8,0 \
					-l $s:ＶＲライトファイル名

				mesg ＶＲオブジェ $1 off
			}

	chara ＶＲオブジェ デモ箱影:09 -m d:KMS_BOX09_SHD -r 0,0,0 -p 0,8,0 -l $s:ＶＲライトファイル名
	chara ＶＲオブジェ デモ箱影:11 -m d:KMS_BOX11_SHD -r 0,0,0 -p 0,8,0 -l $s:ＶＲライトファイル名
	chara ＶＲオブジェ デモ箱影:12 -m d:KMS_BOX12_SHD -r 0,0,0 -p 0,8,0 -l $s:ＶＲライトファイル名
	mesg ＶＲオブジェ デモ箱影 off
}

proc ザコサバイバル用オブジェ設置_影なし {
	#if d:DEBUG_PRINT
		print 'vr_object_set'
	#endif

	command foreach -argc 2 -repeat 13 \
		-data { \
				{ 箱:04, d:KMS_BOX04_SHDLESS } \
				{ 箱:09, d:KMS_BOX09_SHDLESS } \
				{ 箱:12, d:KMS_BOX12_SHDLESS } \
				{ 箱:01, d:KMS_BOX01_SHDLESS } \
				{ 箱:02, d:KMS_BOX02_SHDLESS } \
				{ 箱:03, d:KMS_BOX03_SHDLESS } \
				{ 箱:05, d:KMS_BOX05_SHDLESS } \
				{ 箱:06, d:KMS_BOX06_SHDLESS } \
				{ 箱:07, d:KMS_BOX07_SHDLESS } \
				{ 箱:08, d:KMS_BOX08_SHDLESS } \
				{ 箱:10, d:KMS_BOX10_SHDLESS } \
				{ 箱:11, d:KMS_BOX11_SHDLESS } \
				{ 箱:13, d:KMS_BOX13_SHDLESS } \
			} \
		-exec { \
				if ( $b:ステージ番号 <= d:ZAKO_STAGE:T_G_SOLS_TEAM ) {
					chara ＶＲオブジェ $1 \
						-m $2 -r 0,0,0 -p 0,0,0 \
						-l $s:ＶＲライトファイル名 \
						-f d:PUT_VROBJ_STATUS_SPOTDRAW \
						-e ＶＲオブジェ破壊時処理
				} else {
					chara ＶＲオブジェ $1 \
						-m $2 -r 0,0,0 -p 0,0,0 \
						-l $s:ＶＲライトファイル名 \
						-f (d:PUT_VROBJ_STATUS_TARGET | d:PUT_VROBJ_STATUS_SPOTDRAW) \
						-e ＶＲオブジェ破壊時処理
				}
			}
}

proc ＶＲオブジェ破壊時処理 {
	#if d:DEBUG_PRINT
		print 'vr_object broken $1='$1
	#endif

	switch ( $1 ) {
		case ( 箱:01 ) {
			command 追加ＨＺＸグループ削除 -hzx_id 0 -add_id 6
			mesg ステージアウトライン 箱ライン:01 非表示
			mesg フェードオブジェ 箱トンボ:01 フェードアウト
			mesg フェードオブジェ アウトライン箱:01 フェードアウト
			mesg ＶＲオブジェ デモ箱:01 kill
		}
		case ( 箱:02 ) {
			command 追加ＨＺＸグループ削除 -hzx_id 0 -add_id 7
			mesg ステージアウトライン 箱ライン:02 非表示
			mesg フェードオブジェ 箱トンボ:02 フェードアウト
			mesg ＶＲオブジェ デモ箱:02 kill
		}
		case ( 箱:03 ) {
			command 追加ＨＺＸグループ削除 -hzx_id 0 -add_id 8
			mesg ＶＲオブジェ 箱03への影 crumble
			mesg ＶＲオブジェ 箱影:09 crumble
			mesg ステージアウトライン 箱ライン:03 非表示
			mesg フェードオブジェ 箱トンボ:03 フェードアウト
			mesg ＶＲオブジェ デモ箱:03 kill
			mesg ＶＲオブジェ デモ用箱03への影 kill
			mesg ＶＲオブジェ デモ箱影:09 kill
		}
		case ( 箱:04 ) {
			command 追加ＨＺＸグループ削除 -hzx_id 0 -add_id 9
			mesg ＶＲオブジェ 箱影:11 crumble
			mesg ステージアウトライン 箱ライン:04 非表示
			mesg ＶＲオブジェ デモ箱:04 kill
			mesg ＶＲオブジェ デモ箱影:11 kill
		}
		case ( 箱:05 ) {
			command 追加ＨＺＸグループ削除 -hzx_id 0 -add_id 10
			mesg ＶＲオブジェ 箱影:12 crumble
			mesg ステージアウトライン 箱ライン:05 非表示
			mesg フェードオブジェ 箱トンボ:05 フェードアウト
			mesg ＶＲオブジェ デモ箱:05 kill
			mesg ＶＲオブジェ デモ箱影:12 kill
		}
		case ( 箱:06 ) {
			command 追加ＨＺＸグループ削除 -hzx_id 0 -add_id 11
			mesg ステージアウトライン 箱ライン:06 非表示
			mesg フェードオブジェ 箱トンボ:06 フェードアウト
			mesg ＶＲオブジェ デモ箱:06 kill
		}
		case ( 箱:07 ) {
			command 追加ＨＺＸグループ削除 -hzx_id 0 -add_id 12
			mesg ステージアウトライン 箱ライン:07 非表示
			mesg フェードオブジェ 箱トンボ:07 フェードアウト
			mesg ＶＲオブジェ デモ箱:07 kill
		}
		case ( 箱:08 ) {
			command 追加ＨＺＸグループ削除 -hzx_id 0 -add_id 13
			mesg ステージアウトライン 箱ライン:08 非表示
			mesg フェードオブジェ 箱トンボ:08 フェードアウト
			mesg ＶＲオブジェ デモ箱:08 kill
		}
		case ( 箱:09 ) {
			command 追加ＨＺＸグループ削除 -hzx_id 0 -add_id 14
			mesg ＶＲオブジェ 箱09への影 crumble
			mesg ＶＲオブジェ 箱影:09 crumble
			command トラップ切り替え -trap ca003 -switch 0
			command トラップ切り替え -trap ca007 -switch 0
			mesg ステージアウトライン 箱ライン:09 非表示
			mesg フェードオブジェ 箱トンボ:09 フェードアウト
			mesg ＶＲオブジェ デモ箱:09 kill
			mesg ＶＲオブジェ デモ用箱09への影 kill
			mesg ＶＲオブジェ デモ箱影:09 kill
		}
		case ( 箱:10 ) {
			command 追加ＨＺＸグループ削除 -hzx_id 0 -add_id 15
			command トラップ切り替え -trap ca005 -switch 0
			mesg ステージアウトライン 箱ライン:10 非表示
			mesg フェードオブジェ 箱トンボ:10 フェードアウト
			mesg ＶＲオブジェ デモ箱:10 kill
		}
		case ( 箱:11 ) {
			command 追加ＨＺＸグループ削除 -hzx_id 0 -add_id 16
			mesg ＶＲオブジェ 箱影:11 crumble
			command トラップ切り替え -trap ca006 -switch 0
			mesg ステージアウトライン 箱ライン:11 非表示
			mesg フェードオブジェ 箱トンボ:11 フェードアウト
			mesg ＶＲオブジェ デモ箱:11 kill
			mesg ＶＲオブジェ デモ箱影:11 kill
		}
		case ( 箱:12 ) {
			command 追加ＨＺＸグループ削除 -hzx_id 0 -add_id 17
			mesg ＶＲオブジェ 箱影:12 crumble
			command トラップ切り替え -trap ca002 -switch 0
			command トラップ切り替え -trap ca004 -switch 0
			mesg ステージアウトライン 箱ライン:12 非表示
			mesg フェードオブジェ 箱トンボ:12 フェードアウト
			mesg ＶＲオブジェ デモ箱:12 kill
			mesg ＶＲオブジェ デモ箱影:12 kill
		}
		case ( 箱:13 ) {
			command 追加ＨＺＸグループ削除 -hzx_id 0 -add_id 18
			mesg ステージアウトライン 箱ライン:13 非表示
			mesg フェードオブジェ 箱トンボ:13 フェードアウト
			mesg ＶＲオブジェ デモ箱:13 kill
		}
	}
}

proc ザコサバイバル用アウトライン {
	#if d:DEBUG_PRINT
		print 'vr_outline set'
	#endif

	if ( $b:ステージ番号 <= d:ZAKO_STAGE:T_G_SOLS_TEAM ) {
		// ザコサバイバルステージ
		command foreach -argc 2 -repeat 14 \
			-data { \
					{ zako_outline ステージ全体ライン } \
					{ sp03a_box01 箱ライン:01 } \
					{ sp03a_box02 箱ライン:02 } \
					{ sp03a_box03 箱ライン:03 } \
					{ sp03a_box04 箱ライン:04 } \
					{ sp03a_box05 箱ライン:05 } \
					{ sp03a_box06 箱ライン:06 } \
					{ sp03a_box07 箱ライン:07 } \
					{ sp03a_box08 箱ライン:08 } \
					{ sp03a_box09 箱ライン:09 } \
					{ sp03a_box10 箱ライン:10 } \
					{ sp03a_box11 箱ライン:11 } \
					{ sp03a_box12 箱ライン:12 } \
					{ sp03a_box13 箱ライン:13 } \
			} \
			-exec { \
					chara ステージアウトライン $2 -file $1 -a_color 100 100 100 128
			}

		command foreach -argc 2 -repeat 3 \
			-data { \
					{ grg_outline ゴルルゴンステージライン } \
					{ mgr_outline メカゲノラステージライン } \
					{ gnr_outline ゲノラステージライン } \
			} \
			-exec { \
					chara ステージアウトライン $2 -file $1 -a_color 100 100 100 128
					mesg ステージアウトライン $2 非表示
			}

		command foreach -argc 2 -repeat 14 \
			-data { \
					{ sp03a3_tonbo ステージトンボ:01 } \
					{ sp03a4_tonbo ステージトンボ:02 } \
					{ sp03a_box01_tonbo 箱トンボ:01 } \
					{ sp03a_box02_tonbo 箱トンボ:02 } \
					{ sp03a_box03_tonbo 箱トンボ:03 } \
					{ sp03a_box05_tonbo 箱トンボ:05 } \
					{ sp03a_box06_tonbo 箱トンボ:06 } \
					{ sp03a_box07_tonbo 箱トンボ:07 } \
					{ sp03a_box08_tonbo 箱トンボ:08 } \
					{ sp03a_box09_tonbo 箱トンボ:09 } \
					{ sp03a_box10_tonbo 箱トンボ:10 } \
					{ sp03a_box11_tonbo 箱トンボ:11 } \
					{ sp03a_box12_tonbo 箱トンボ:12 } \
					{ sp03a_box13_tonbo 箱トンボ:13 } \
			} \
			-exec { \
				chara フェードオブジェ $2 \
					-pos 0, 0, 0 \
					-rgb 80 80 80 \	/*最も明るくなったときの値*/
					-time 90 \			/*最も明るくなるまでの時間*/
					-kms $1
			}

		chara フェードオブジェ アウトライン \
			-pos 0, 0, 0 \
			-rgb 160, 160, 160 \	/*最も明るくなったときの値*/
			-time 45 \			/*最も明るくなるまでの時間*/
			-kms sp03a3_line

		chara フェードオブジェ アウトライン箱:01 \
			-pos 0, 0, 0 \
			-rgb 160, 160, 160 \	/*最も明るくなったときの値*/
			-time 45 \			/*最も明るくなるまでの時間*/
			-kms sp03a_box01_line

	} else if ( $b:ステージ番号 == d:ZAKO_STAGE:GURLUGON ) {
		// ゴルルゴンステージ
		command foreach -argc 2 -repeat 14 \
			-data { \
					{ grg_outline ステージ全体ライン } \
					{ sp03a_box01 箱ライン:01 } \
					{ sp03a_box02 箱ライン:02 } \
					{ sp03a_box03 箱ライン:03 } \
					{ sp03a_box04 箱ライン:04 } \
					{ sp03a_box05 箱ライン:05 } \
					{ sp03a_box06 箱ライン:06 } \
					{ sp03a_box07 箱ライン:07 } \
					{ sp03a_box08 箱ライン:08 } \
					{ sp03a_box09 箱ライン:09 } \
					{ sp03a_box10 箱ライン:10 } \
					{ sp03a_box11 箱ライン:11 } \
					{ sp03a_box12 箱ライン:12 } \
					{ sp03a_box13 箱ライン:13 } \
			} \
			-exec { \
					chara ステージアウトライン $2 -file $1 -a_color 100 100 100 128
			}

		command foreach -argc 2 -repeat 14 \
			-data { \
					{ sp03a3_tonbo ステージトンボ:01 } \
					{ sp03a1_tonbo ステージトンボ:02 } \
					{ sp03a_box01_tonbo 箱トンボ:01 } \
					{ sp03a_box02_tonbo 箱トンボ:02 } \
					{ sp03a_box03_tonbo 箱トンボ:03 } \
					{ sp03a_box05_tonbo 箱トンボ:05 } \
					{ sp03a_box06_tonbo 箱トンボ:06 } \
					{ sp03a_box07_tonbo 箱トンボ:07 } \
					{ sp03a_box08_tonbo 箱トンボ:08 } \
					{ sp03a_box09_tonbo 箱トンボ:09 } \
					{ sp03a_box10_tonbo 箱トンボ:10 } \
					{ sp03a_box11_tonbo 箱トンボ:11 } \
					{ sp03a_box12_tonbo 箱トンボ:12 } \
					{ sp03a_box13_tonbo 箱トンボ:13 } \
			} \
			-exec { \
				chara フェードオブジェ $2 \
					-pos 0, 0, 0 \
					-rgb 80 80 80 \	/*最も明るくなったときの値*/
					-time 90 \			/*最も明るくなるまでの時間*/
					-kms $1
			}

		chara フェードオブジェ アウトライン \
			-pos 0, 0, 0 \
			-rgb 160, 160, 160 \	/*最も明るくなったときの値*/
			-time 45 \			/*最も明るくなるまでの時間*/
			-kms sp03a3_line

		chara フェードオブジェ アウトライン箱:01 \
			-pos 0, 0, 0 \
			-rgb 160, 160, 160 \	/*最も明るくなったときの値*/
			-time 45 \			/*最も明るくなるまでの時間*/
			-kms sp03a_box01_line

	} else if ( $b:ステージ番号 == d:ZAKO_STAGE:MECHGENOLA ) {
		// メカゲノラステージ
		command foreach -argc 2 -repeat 14 \
			-data { \
					{ mgr_outline ステージ全体ライン } \
					{ sp03a_box01 箱ライン:01 } \
					{ sp03a_box02 箱ライン:02 } \
					{ sp03a_box03 箱ライン:03 } \
					{ sp03a_box04 箱ライン:04 } \
					{ sp03a_box05 箱ライン:05 } \
					{ sp03a_box06 箱ライン:06 } \
					{ sp03a_box07 箱ライン:07 } \
					{ sp03a_box08 箱ライン:08 } \
					{ sp03a_box09 箱ライン:09 } \
					{ sp03a_box10 箱ライン:10 } \
					{ sp03a_box11 箱ライン:11 } \
					{ sp03a_box12 箱ライン:12 } \
					{ sp03a_box13 箱ライン:13 } \
			} \
			-exec { \
					chara ステージアウトライン $2 -file $1 -a_color 100 100 100 128
			}

		command foreach -argc 2 -repeat 14 \
			-data { \
					{ sp03a3_tonbo ステージトンボ:01 } \
					{ sp03a1_tonbo ステージトンボ:02 } \
					{ sp03a_box01_tonbo 箱トンボ:01 } \
					{ sp03a_box02_tonbo 箱トンボ:02 } \
					{ sp03a_box03_tonbo 箱トンボ:03 } \
					{ sp03a_box05_tonbo 箱トンボ:05 } \
					{ sp03a_box06_tonbo 箱トンボ:06 } \
					{ sp03a_box07_tonbo 箱トンボ:07 } \
					{ sp03a_box08_tonbo 箱トンボ:08 } \
					{ sp03a_box09_tonbo 箱トンボ:09 } \
					{ sp03a_box10_tonbo 箱トンボ:10 } \
					{ sp03a_box11_tonbo 箱トンボ:11 } \
					{ sp03a_box12_tonbo 箱トンボ:12 } \
					{ sp03a_box13_tonbo 箱トンボ:13 } \
			} \
			-exec { \
				chara フェードオブジェ $2 \
					-pos 0, 0, 0 \
					-rgb 80 80 80 \	/*最も明るくなったときの値*/
					-time 90 \			/*最も明るくなるまでの時間*/
					-kms $1
			}

		chara フェードオブジェ アウトライン \
			-pos 0, 0, 0 \
			-rgb 160, 160, 160 \	/*最も明るくなったときの値*/
			-time 45 \			/*最も明るくなるまでの時間*/
			-kms sp03a3_line

		chara フェードオブジェ アウトライン箱:01 \
			-pos 0, 0, 0 \
			-rgb 160, 160, 160 \	/*最も明るくなったときの値*/
			-time 45 \			/*最も明るくなるまでの時間*/
			-kms sp03a_box01_line

	} else if ( $b:ステージ番号 == d:ZAKO_STAGE:GENOLA ) {
		// ゲノラステージ
		command foreach -argc 2 -repeat 2 \
			-data { \
					{ gnr_outline ステージ全体ライン } \
					{ sp03a_box13 箱ライン:13 } \
			} \
			-exec { \
					chara ステージアウトライン $2 -file $1 -a_color 100 100 100 128
			}

		command foreach -argc 2 -repeat 2 \
			-data { \
					{ sp03a0 対決ステージライン } \
					{ gnr_outline2 ステージ全体ライン壁なし } \
			} \
			-exec { \
					chara ステージアウトライン $2 -file $1 -a_color 100 100 100 128
					mesg ステージアウトライン $2 非表示
			}

		command foreach -argc 2 -repeat 3 \
			-data { \
					{ sp03a0_tonbo ステージトンボ:01 } \
					{ sp03a1_tonbo ステージトンボ:02 } \
					{ sp03a_box13_tonbo 箱トンボ:13 } \
			} \
			-exec { \
				chara フェードオブジェ $2 \
					-pos 0, 0, 0 \
					-rgb 80 80 80 \	/*最も明るくなったときの値*/
					-time 90 \			/*最も明るくなるまでの時間*/
					-kms $1
			}

		chara フェードオブジェ アウトライン \
			-pos 0, 0, 0 \
			-rgb 160, 160, 160 \	/*最も明るくなったときの値*/
			-time 45 \			/*最も明るくなるまでの時間*/
			-kms sp03a0_line

	}

}


// ------------------------------------
// プレイヤーに関する設定
//-------------------------------------
// プラグインプログラム
// ------------------------------------
proc プラグイン設定 {
	#if d:DEBUG_PRINT
		print 'plugin_set'
	#endif

	command プラグイン自動ジャンプ
	command プラグイン落下
	if ( $s:選択プレイヤー == ライデン ) {
		if ( $b:ステージ番号 == d:ZAKO_STAGE:GURLUGON ) {
			// ゴルルゴンステージではプラグインがぶつかるので、使用不可
			command	不可装備設定 -weapon d:武器:ブレード
		} else {
			command プラグインブレード -m rai_blade
		}
	}

	if ( $b:ステージ番号 == d:ZAKO_STAGE:GURLUGON ) {
		// ゴルルゴンが行う
		command プラグイン影縛り
	}

}
//-------------------------------------
// 台登り
// ------------------------------------
proc ジャンプ設定 {
	#if d:DEBUG_PRINT
		print 'jump_set'
	#endif

	trap ky001 d:PLAYER \
		-mask 入る \
		-exec {
			@ジャンプ発動 ky001 1000 10
		}
}


// ------------------------------------
// 敵兵や的の処理
// ------------------------------------
// 敵兵に関する設定
//-------------------------------------
// ザコサバイバル専用共通プロック
proc ザコサバイバル兵_ゴル兵 $:p_名前 $:p_ルート $:p_ステータス $:p_拡張ステータス $:p_装備 $:p_拡張フラグ {
	#if d:DEBUG_PRINT
		print 'zako_soldier_gol_set'
	#endif

	chara 長廊下兵 $:p_名前 \
		-r $:p_ルート \
		-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
		-l $w:敵標準体力 -f $w:敵標準気絶 \
		-s $:p_ステータス \
		-k $:p_拡張ステータス \
		-e $:p_装備 \
		-v $:p_拡張フラグ \
		-t 0

}

proc ザコサバイバル兵_天狗兵 $:p_名前 $:p_ルート $:p_ステータス $:p_拡張ステータス $:p_タイプ {
	#if d:DEBUG_PRINT
		print 'zako_soldier_gol_set'
	#endif

	chara 天狗兵Ｂ $:p_名前 \
		-k $:p_拡張ステータス \ /*警備兵と共通*/
		-r $:p_ルート \
		-s $:p_ステータス \
		-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
		-l $w:敵標準体力 -f $w:敵標準気絶 \
		-type $:p_タイプ
}





/////////////////////////////////////////////
// ザコサバイバル-ライデンのセット
// 後衛で拠点防衛する兵士のセット（ライデン）
proc 後衛兵セット_ライデン {
	#if d:DEBUG_PRINT 
		print 'watcher_set'
	#endif

	switch ( $b:ステージ番号 ) {
		case ( d:ZAKO_STAGE:G_SOL_1 ) {
			@ザコサバイバル兵_ゴル兵 敵兵:01 0 d:ENE_NOM_STATUS_SP03A 0
		}
		case ( d:ZAKO_STAGE:G_SOLS_TEAM ) {
			@ザコサバイバル兵_ゴル兵 敵兵:01 1 d:ENE_NOM_STATUS_SP03A d:アナザーダーク 
			@ザコサバイバル兵_ゴル兵 敵兵:02 2 d:ENE_NOM_STATUS_SP03A d:アナザーダーク
			@ザコサバイバル兵_ゴル兵 敵兵:03 3 d:ENE_NOM_STATUS_SP03A d:アナザーダーク
			@ザコサバイバル兵_ゴル兵 敵兵:04 4 d:ENE_NOM_STATUS_SP03A d:アナザーダーク
		}
		case ( d:ZAKO_STAGE:T_G_SOLS_TEAM ) {
			#if d:DEMO_DEBUG
				// シナリオデモ作成用
				@ザコサバイバル兵_ゴル兵 敵兵:01 7 d:ENE_NOM_STATUS_SP03A 0
			#else
				// 本番用
				@ザコサバイバル兵_ゴル兵 敵兵:01 7 d:ENE_NOM_STATUS_SP03A 0
				@ザコサバイバル兵_ゴル兵 敵兵:02 8 d:ENE_NOM_STATUS_SP03A 0
				@ザコサバイバル兵_ゴル兵 敵兵:03 9 d:ENE_NOM_STATUS_SP03A d:アナザーダーク
				@ザコサバイバル兵_ゴル兵 敵兵:04 10 d:ENE_NOM_STATUS_SP03A d:アナザーダーク
				@ザコサバイバル兵_ゴル兵 敵兵:05 11 d:ENE_NOM_STATUS_SP03A d:アナザーダーク
			#endif
		}
		default {
			#if d:DEBUG_PRINT
				print 'WARNING!!!!!!!不正な値が入っています。$b:ステージ番号='$b:ステージ番号
			#endif

			command assert ( d:FALSE ) 'stage no error  (scenario err) 後衛兵セット_ライデン'
			
		}
	}
}

// 後衛兵用のコマンダー（ライデン用）
proc 後衛兵コマンダー_ライデン {
	#if d:DEBUG_PRINT 
		print 'watcher_com_set'
	#endif

	switch ( $b:ステージ番号 ) {
		case ( d:ZAKO_STAGE:G_SOL_1 ) {
			chara 長廊下コマンダー wccomm \
				-e { 後衛兵セット_ライデン } \
				-defense \
					d:D_POS_1F_33 \
					d:D_POS_1F_29 \
					d:D_POS_1F_25 \
					d:D_POS_1F_26 \
					d:D_POS_1F_32 \
					d:D_POS_1F_34 \
					d:D_POS_1F_35 \
					d:D_POS_1F_43 \
					d:D_POS_1F_21 \
					d:D_POS_1F_22 \
					d:D_POS_1F_23 \
					d:D_POS_1F_24 \
					d:D_POS_1F_27 \
					d:D_POS_1F_28 \
					d:D_POS_1F_30 \
					d:D_POS_1F_31 \
				-type	0 \
				-final	d:FINAL_POS_01

		}
		case ( d:ZAKO_STAGE:G_SOLS_TEAM ) {
			chara 長廊下コマンダー wccomm \
				-e { 後衛兵セット_ライデン } \
				-defense \
					d:D_POS_3F_02 \
					d:D_POS_2F_19 \
					d:D_POS_1F_26 \
					d:D_POS_1F_34 \
					d:D_POS_3F_03 \
					d:D_POS_3F_08 \
					d:D_POS_3F_09 \
					d:D_POS_2F_16 \
					d:D_POS_1F_23 \
					d:D_POS_1F_24 \
					d:D_POS_1F_25 \
					d:D_POS_1F_28 \
					d:D_POS_1F_31 \
					d:D_POS_1F_32 \
					d:D_POS_1F_33 \
					d:D_POS_1F_35 \
				-type	0 \
				-final	d:FINAL_POS_01
		}
		case ( d:ZAKO_STAGE:T_G_SOLS_TEAM ) {
			chara 長廊下コマンダー wccomm \
				-e { 後衛兵セット_ライデン  } \
				-defense \
					d:D_POS_2F_16 \
					d:D_POS_3F_08 \
					d:D_POS_1F_33 \
					d:D_POS_1F_25 \
					d:D_POS_1F_34 \
					d:D_POS_3F_01 \
					d:D_POS_3F_03 \
					d:D_POS_3F_10 \
					d:D_POS_2F_19 \
					d:D_POS_1F_43 \
					d:D_POS_1F_24 \
					d:D_POS_1F_26 \
					d:D_POS_1F_28 \
					d:D_POS_1F_31 \
					d:D_POS_1F_36 \
					d:D_POS_1F_37 \
				-type	0 \
				-final	d:FINAL_POS_01 \
				#if d:DEMO_DEBUG
					-k 0	// シナリオデモ作成用
				#else
					-k 3	// 本番用
				#endif

		}
		default {
			#if d:DEBUG_PRINT
				print 'WARNING!!!!!!!不正な値が入っています。$b:ステージ番号='$b:ステージ番号
			#endif

			command assert ( d:FALSE ) 'stage no error  (scenario err) 後衛兵コマンダー_ライデン'
		}
	}
}

// 前衛で突撃してくる兵士のセット（ライデン）
proc 前衛兵セット_ライデン {
	#if d:DEBUG_PRINT 
		print 'attacker_set'
	#endif
	switch ( $b:ステージ番号 ) {
		case ( d:ZAKO_STAGE:G_SOL_1 ) {
		}
		case ( d:ZAKO_STAGE:G_SOLS_TEAM ) {
			@A_拡張攻撃兵 敵兵:11 5 d:ENE_STATUS_NORMAL d:ENE_STST_FAINT_EXIT d:ENE_EQUIP_TYPE_SHIELD
			@A_拡張攻撃兵 敵兵:12 6 d:ENE_STATUS_NORMAL d:ENE_STST_FAINT_EXIT d:ENE_EQUIP_TYPE_SHIELD
		}
		case ( d:ZAKO_STAGE:T_G_SOLS_TEAM ) {
			#if d:DEMO_DEBUG
				// シナリオデモ作成用
				@ザコサバイバル兵_天狗兵 敵兵:01 12 d:ENE_STATUS_NORMAL d:ENE_STST_FAINT_EXIT d:EQUIP_BLADE
			#else
				// 本番用
				@ザコサバイバル兵_天狗兵 敵兵:01 12 d:ENE_STATUS_NORMAL d:ENE_STST_FAINT_EXIT d:EQUIP_BLADE
				@ザコサバイバル兵_天狗兵 敵兵:02 13 d:ENE_STATUS_NORMAL d:ENE_STST_FAINT_EXIT d:EQUIP_P90
			#endif
		}
		default {
			#if d:DEBUG_PRINT
				print 'WARNING!!!!!!!不正な値が入っています。$b:ステージ番号='$b:ステージ番号
			#endif

			command assert ( d:FALSE ) 'stage no error  (scenario err) 前衛兵セット_ライデン'
			
		}
	}

}

// 前衛兵用のコマンダー（ライデン用）
proc 前衛兵コマンダー_ライデン {
	#if d:DEBUG_PRINT 
		print 'attacker_com_set'
	#endif

	switch ( $b:ステージ番号 ) {
		case ( d:ZAKO_STAGE:G_SOL_1 ) {
		}
		case ( d:ZAKO_STAGE:G_SOLS_TEAM ) {
			chara 攻撃コマンダー atcomm -e { 前衛兵セット_ライデン }
		}
		case ( d:ZAKO_STAGE:T_G_SOLS_TEAM ) {
			chara 天狗兵コマンダー tng_com \
				-e { 前衛兵セット_ライデン } \
				-type 1	\ //0でw42用 1でw44w45用
				-res d:R_POS_11 d:R_POS_12 d:R_POS_13 d:R_POS_14 d:R_POS_15 \
				-mode d:TNG_COM_MULTITEX_AUTO \
				-warp re001 \	/*強制移動トラップ名前*/
				#if d:DEMO_DEBUG
					-k 0	// シナリオデモ作成用
				#else
					-k 4	// 本番用
				#endif
		}
		default {
			#if d:DEBUG_PRINT
				print 'WARNING!!!!!!!不正な値が入っています。$b:ステージ番号='$b:ステージ番号
			#endif

			command assert ( d:FALSE ) 'stage no error  (scenario err) 前衛兵コマンダー_ライデン'
		}
	}
}





/////////////////////////////////////////////
// ザコサバイバル-スネークのセット
// 後衛で拠点防衛する兵士のセット（スネーク）
proc 後衛兵セット_スネーク {
	#if d:DEBUG_PRINT 
		print 'watcher_set'
	#endif

	switch ( $b:ステージ番号 ) {
		case ( d:ZAKO_STAGE:G_SOL_1 ) {
			@ザコサバイバル兵_ゴル兵 敵兵:01 14 d:ENE_NOM_STATUS_SP03A 0
		}
		case ( d:ZAKO_STAGE:G_SOLS_TEAM ) {
			@ザコサバイバル兵_ゴル兵 敵兵:01 15 d:ENE_NOM_STATUS_SP03A d:アナザーダーク
			@ザコサバイバル兵_ゴル兵 敵兵:02 16 d:ENE_NOM_STATUS_SP03A d:アナザーダーク
			@ザコサバイバル兵_ゴル兵 敵兵:03 17 d:ENE_NOM_STATUS_SP03A 0
			@ザコサバイバル兵_ゴル兵 敵兵:04 18 d:ENE_NOM_STATUS_SP03A d:アナザーダーク
			@ザコサバイバル兵_ゴル兵 敵兵:05 19 d:ENE_NOM_STATUS_SP03A d:アナザーダーク
		}
		case ( d:ZAKO_STAGE:T_G_SOLS_TEAM ) {
			#if d:DEMO_DEBUG
				// シナリオデモ作成用
				@ザコサバイバル兵_ゴル兵 敵兵:01 23 d:ENE_NOM_STATUS_SP03A d:アナザーダーク
			#else
				// 本番用
				@ザコサバイバル兵_ゴル兵 敵兵:01 23 d:ENE_NOM_STATUS_SP03A d:アナザーダーク
				@ザコサバイバル兵_ゴル兵 敵兵:02 24 d:ENE_NOM_STATUS_SP03A d:アナザーダーク
				@ザコサバイバル兵_ゴル兵 敵兵:03 25 d:ENE_NOM_STATUS_SP03A d:アナザーダーク
				@ザコサバイバル兵_ゴル兵 敵兵:04 26 d:ENE_NOM_STATUS_SP03A 0
				@ザコサバイバル兵_ゴル兵 敵兵:05 27 d:ENE_NOM_STATUS_SP03A d:アナザーダーク
				@ザコサバイバル兵_ゴル兵 敵兵:06 28 d:ENE_NOM_STATUS_SP03A d:アナザーダーク
			#endif
		}
		default {
			#if d:DEBUG_PRINT
				print 'WARNING!!!!!!!不正な値が入っています。$b:ステージ番号='$b:ステージ番号
			#endif

			command assert ( d:FALSE ) 'stage no error  (scenario err) 後衛兵セット_スネーク'
			
		}
	}
}

// 後衛兵用のコマンダー（スネーク用）
proc 後衛兵コマンダー_スネーク {
	#if d:DEBUG_PRINT 
		print 'watcher_com_set'
	#endif

	switch ( $b:ステージ番号 ) {
		case ( d:ZAKO_STAGE:G_SOL_1 ) {
			chara 長廊下コマンダー wccomm \
				-e { 後衛兵セット_スネーク } \
				-defense \
					d:D_POS_1F_29 \
					d:D_POS_1F_33 \
					d:D_POS_1F_32 \
					d:D_POS_1F_26 \
					d:D_POS_1F_27 \
					d:D_POS_1F_34 \
					d:D_POS_1F_35 \
					d:D_POS_1F_24 \
					d:D_POS_1F_23 \
					d:D_POS_1F_30 \
					d:D_POS_1F_31 \
					d:D_POS_1F_43 \
					d:D_POS_1F_21 \
					d:D_POS_1F_22 \
					d:D_POS_1F_25 \
					d:D_POS_1F_28 \
				-type	0 \
				-final	d:FINAL_POS_01

		}
		case ( d:ZAKO_STAGE:G_SOLS_TEAM ) {
			chara 長廊下コマンダー wccomm \
				-e { 後衛兵セット_スネーク } \
				-defense \
					d:D_POS_3F_10 \
					d:D_POS_2F_16 \
					d:D_POS_1F_24 \
					d:D_POS_1F_26 \
					d:D_POS_1F_32 \
					d:D_POS_3F_01 \
					d:D_POS_1F_25 \
					d:D_POS_2F_20 \
					d:D_POS_1F_28 \
					d:D_POS_1F_34 \
					d:D_POS_3F_03 \
					d:D_POS_1F_31 \
					d:D_POS_3F_08 \
					d:D_POS_1F_43 \
					d:D_POS_1F_23 \
					d:D_POS_1F_30 \
				-type	0 \
				-final	d:FINAL_POS_01
		}
		case ( d:ZAKO_STAGE:T_G_SOLS_TEAM ) {
			chara 長廊下コマンダー wccomm \
				-e { 後衛兵セット_スネーク  } \
				-defense \
					d:D_POS_3F_04 \
					d:D_POS_2F_19 \
					d:D_POS_3F_10 \
					d:D_POS_1F_30 \
					d:D_POS_1F_32 \
					d:D_POS_1F_25 \
					d:D_POS_3F_01 \
					d:D_POS_2F_15 \
					d:D_POS_1F_39 \
					d:D_POS_1F_31 \
					d:D_POS_1F_34 \
					d:D_POS_1F_24 \
					d:D_POS_3F_08 \
					d:D_POS_1F_27 \
					d:D_POS_1F_23 \
					d:D_POS_1F_40 \
				-type	0 \
				-final	d:FINAL_POS_01 \
				#if d:DEMO_DEBUG
					-k 0 // シナリオデモ作成用
				#else
					-k 5 // 本番用
				#endif

		}
		default {
			#if d:DEBUG_PRINT
				print 'WARNING!!!!!!!不正な値が入っています。$b:ステージ番号='$b:ステージ番号
			#endif

			command assert ( d:FALSE ) 'stage no error  (scenario err) 後衛兵コマンダー_スネーク'
		}
	}
}

// 前衛で突撃してくる兵士のセット（スネーク）
proc 前衛兵セット_スネーク {
	#if d:DEBUG_PRINT 
		print 'attacker_set'
	#endif
	switch ( $b:ステージ番号 ) {
		case ( d:ZAKO_STAGE:G_SOL_1 ) {
		}
		case ( d:ZAKO_STAGE:G_SOLS_TEAM ) {
			@A_拡張攻撃兵 敵兵:11 20 d:ENE_STATUS_NORMAL d:ENE_STST_FAINT_EXIT d:ENE_EQUIP_TYPE_SHIELD
			@A_拡張攻撃兵 敵兵:12 21 d:ENE_STATUS_NORMAL d:ENE_STST_FAINT_EXIT d:ENE_EQUIP_TYPE_SHOTGUN
			@A_拡張攻撃兵 敵兵:13 22 d:ENE_STATUS_NORMAL d:ENE_STST_FAINT_EXIT d:ENE_EQUIP_TYPE_HITECH_1
		}
		case ( d:ZAKO_STAGE:T_G_SOLS_TEAM ) {
			#if d:DEMO_DEBUG
				// シナリオデモ作成用
				@ザコサバイバル兵_天狗兵 敵兵:01 29 d:ENE_STATUS_NORMAL d:ENE_STST_FAINT_EXIT d:EQUIP_BLADE
			#else
				// 本番用
				@ザコサバイバル兵_天狗兵 敵兵:01 29 d:ENE_STATUS_NORMAL d:ENE_STST_FAINT_EXIT d:EQUIP_BLADE
				@ザコサバイバル兵_天狗兵 敵兵:02 30 d:ENE_STATUS_NORMAL d:ENE_STST_FAINT_EXIT d:EQUIP_BLADE
				@ザコサバイバル兵_天狗兵 敵兵:03 31 d:ENE_STATUS_NORMAL d:ENE_STST_FAINT_EXIT d:EQUIP_P90
			#endif
		}
		default {
			#if d:DEBUG_PRINT
				print 'WARNING!!!!!!!不正な値が入っています。$b:ステージ番号='$b:ステージ番号
			#endif

			command assert ( d:FALSE ) 'stage no error  (scenario err) 前衛兵セット_スネーク'
			
		}
	}
}

// 前衛兵用のコマンダー（スネーク用）
proc 前衛兵コマンダー_スネーク {
	#if d:DEBUG_PRINT 
		print 'attacker_com_set'
	#endif

	switch ( $b:ステージ番号 ) {
		case ( d:ZAKO_STAGE:G_SOL_1 ) {
		}
		case ( d:ZAKO_STAGE:G_SOLS_TEAM ) {
			chara 攻撃コマンダー atcomm -e { 前衛兵セット_スネーク }
		}
		case ( d:ZAKO_STAGE:T_G_SOLS_TEAM ) {
			chara 天狗兵コマンダー tng_com \
				-e { 前衛兵セット_スネーク } \
				-type 1	\ //0でw42用 1でw44w45用
				-res d:R_POS_11 d:R_POS_12 d:R_POS_13 d:R_POS_14 d:R_POS_15 \
				-mode d:TNG_COM_MULTITEX_AUTO \
				-warp re001 \	/*強制移動トラップ名前*/
				#if d:DEMO_DEBUG
					-k 0 // シナリオデモ作成用
				#else
					-k 4 // 本番用
				#endif
		}
		default {
			#if d:DEBUG_PRINT
				print 'WARNING!!!!!!!不正な値が入っています。$b:ステージ番号='$b:ステージ番号
			#endif

			command assert ( d:FALSE ) 'stage no error  (scenario err) 前衛兵コマンダー_スネーク'
		}
	}
}





