//////////////////////////
//	ブレード２面用
//////////////////////////

	//	スタート処理
	proc 忍者的２面スタート処理 {
		mesg ＶＲ的共通 移動的:01 移動開始
		mesg ＶＲ的共通 移動的:02 移動開始

	}

	//	破壊時処理
	proc 忍者的２面破壊処理 {
		if ( ($1 == 移動的:01) ||($1 == 移動的:02) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 2) {
				mesg ＶＲ的共通 移動的:03 移動開始
				mesg ＶＲ的共通 移動的:04 移動開始

				eval ($$i:的起動フラグ = 0)
			}
		} else if ( ($1 == 移動的:03) || ($1 == 移動的:04) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 2) {
				mesg ＶＲ的共通 移動的:05 移動開始
				mesg ＶＲ的共通 移動的:06 移動開始

				eval ($$i:的起動フラグ = 0)
			}

		} else if ( ($1 == 移動的:05) || ($1 == 移動的:06) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 2) {
				mesg ＶＲ的共通 移動的:07 移動開始
				mesg ＶＲ的共通 移動的:08 移動開始
				mesg ＶＲ的共通 移動的:09 移動開始
				mesg ＶＲ的共通 移動的:10 移動開始
				eval ($$i:的起動フラグ = 0)
			}

		} else if ( ($1 == 移動的:07) || ($1 == 移動的:08) || ($1 == 移動的:09) || \
					($1 == 移動的:10) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 4) {
				mesg ＶＲ的共通 移動的:11 移動開始
				mesg ＶＲ的共通 移動的:12 移動開始
				mesg ＶＲ的共通 移動的:13 移動開始
				mesg ＶＲ的共通 移動的:14 移動開始
				eval ($$i:的起動フラグ = 0)
			}

		} else if ( ($1 == 移動的:11) || ($1 == 移動的:12) || ($1 == 移動的:13) || \
					($1 == 移動的:14) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 4) {
				mesg ＶＲ的共通 移動的:15 移動開始

				chara delay 的起動ディレイ \
					-t (60*1/2) \	//	30フレーム
					-e {
						mesg ＶＲ的共通 移動的:16 移動開始
					}
				chara delay 的起動ディレイ \
					-t (60*1/2*2) \
					-e {
						mesg ＶＲ的共通 移動的:17 移動開始
					}
				chara delay 的起動ディレイ \
					-t (60*1/2*3) \
					-e {
						mesg ＶＲ的共通 移動的:18 移動開始
					}
				chara delay 的起動ディレイ \
					-t (60*1/2*4) \
					-e {
						mesg ＶＲ的共通 移動的:19 移動開始
					}
				chara delay 的起動ディレイ \
					-t (60*1/2*5) \
					-e {
						mesg ＶＲ的共通 移動的:20 移動開始
					}
				eval ($$i:的起動フラグ = 0)
			}

		} else if ( ($1 == 移動的:15) || ($1 == 移動的:16) || ($1 == 移動的:17) || \
					($1 == 移動的:18) || ($1 == 移動的:19) || ($1 == 移動的:20) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 6) {
				mesg ＶＲ的共通 移動的:21 移動開始
				mesg ＶＲ移動的 移動的:21 即ルート変更 d:２面的ルート:移部屋＿忍１１

				chara delay 的起動ディレイ \
					-t (60*1/2) \
					-e {
						mesg ＶＲ的共通 移動的:22 移動開始
						mesg ＶＲ移動的 移動的:22 即ルート変更 d:２面的ルート:移部屋＿忍１２
					}
				chara delay 的起動ディレイ \
					-t (60*1/2*2) \
					-e {
						mesg ＶＲ的共通 移動的:23 移動開始
						mesg ＶＲ移動的 移動的:23 即ルート変更 d:２面的ルート:移部屋＿忍１１
					}
				chara delay 的起動ディレイ \
					-t (60*1/2*3) \
					-e {
						mesg ＶＲ的共通 移動的:24 移動開始
						mesg ＶＲ移動的 移動的:24 即ルート変更 d:２面的ルート:移部屋＿忍１２
					}
				chara delay 的起動ディレイ \
					-t (60*1/2*4) \
					-e {
						mesg ＶＲ的共通 移動的:25 移動開始
						mesg ＶＲ移動的 移動的:25 即ルート変更 d:２面的ルート:移部屋＿忍１１
					}
				chara delay 的起動ディレイ \
					-t (60*1/2*5) \
					-e {
						mesg ＶＲ的共通 移動的:26 移動開始
						mesg ＶＲ移動的 移動的:26 即ルート変更 d:２面的ルート:移部屋＿忍１２
					}
				chara delay 的起動ディレイ \
					-t (60*1/2*6) \
					-e {
						mesg ＶＲ的共通 移動的:27 移動開始
						mesg ＶＲ移動的 移動的:27 即ルート変更 d:２面的ルート:移部屋＿忍１１
					}
				chara delay 的起動ディレイ \
					-t (60*1/2*7) \
					-e {
						mesg ＶＲ的共通 移動的:28 移動開始
						mesg ＶＲ移動的 移動的:28 即ルート変更 d:２面的ルート:移部屋＿忍１２
					}
				chara delay 的起動ディレイ \
					-t (60*1/2*8) \
					-e {
						mesg ＶＲ的共通 移動的:29 移動開始
						mesg ＶＲ移動的 移動的:29 即ルート変更 d:２面的ルート:移部屋＿忍１１
					}
				eval ($$i:的起動フラグ = 0)
			}

		} else if ( ($1 == 移動的:21) || ($1 == 移動的:22) || ($1 == 移動的:23) || \
					($1 == 移動的:24) || ($1 == 移動的:25) || ($1 == 移動的:26) || \
					($1 == 移動的:27) || ($1 == 移動的:28) || ($1 == 移動的:29) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 9) {
				chara delay 的起動ディレイ \
					-t (60*1/2) \
					-e {
						mesg ＶＲ的共通 移動的:30 移動開始
					}
				eval ($$i:的起動フラグ = 0)
			}

		}

	}

	//	的配置
	proc 忍者的２面設定 {

	//	@ＶＲ標的基本設定 \
	//	$:p_名前 $:p_的ステータス $:p_ルート $:p_ノード $:p_破壊プロック $:p_初期方向 $:p_的スピード

	//	@ＶＲ標的基本設定（シフトつき） \
	//	$:p_名前 $:p_的ステータス $:p_ルート $:p_ノード $:p_破壊プロック $:p_シフトＸ $:p_シフトＹ $:p_シフトＺ $:p_初期方向 $:p_自転速度 $:p_的スピード

		//	ルーム
		@ＶＲ標的基本設定 \
		移動的:01 $$i:的ステータス d:２面的ルート:移部屋＿忍０ 0 p:武器訓練ブレード２面ＶＲ標的破壊処理 0 $$i:的スピード
		@ＶＲ標的基本設定（シフトつき） \
		移動的:02 $$i:的ステータス d:２面的ルート:移部屋＿忍０ 0 p:武器訓練ブレード２面ＶＲ標的破壊処理 -500 0 0 0 0 $$i:的スピード

		@ＶＲ標的基本設定 \
		移動的:03 $$i:的ステータス d:２面的ルート:移部屋＿忍１ 0 p:武器訓練ブレード２面ＶＲ標的破壊処理 0 $$i:的スピード
		@ＶＲ標的基本設定（シフトつき） \
		移動的:04 $$i:的ステータス d:２面的ルート:移部屋＿忍１ 0 p:武器訓練ブレード２面ＶＲ標的破壊処理 500 0 0 0 0 $$i:的スピード

		@ＶＲ標的基本設定 \
		移動的:05 $$i:的ステータス d:２面的ルート:移部屋＿忍２ 0 p:武器訓練ブレード２面ＶＲ標的破壊処理 1024 $$i:的スピード
		@ＶＲ標的基本設定（シフトつき） \
		移動的:06 $$i:的ステータス d:２面的ルート:移部屋＿忍２ 0 p:武器訓練ブレード２面ＶＲ標的破壊処理 0 -500 0 1024 0 $$i:的スピード

		@ＶＲ標的基本設定 \
		移動的:07 $$i:的ステータス d:２面的ルート:移部屋＿忍３ 0 p:武器訓練ブレード２面ＶＲ標的破壊処理 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:08 $$i:的ステータス d:２面的ルート:移部屋＿忍４ 0 p:武器訓練ブレード２面ＶＲ標的破壊処理 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:09 $$i:的ステータス d:２面的ルート:移部屋＿忍５ 0 p:武器訓練ブレード２面ＶＲ標的破壊処理 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:10 $$i:的ステータス d:２面的ルート:移部屋＿忍６ 0 p:武器訓練ブレード２面ＶＲ標的破壊処理 0 $$i:的スピード

		@ＶＲ標的基本設定 \
		移動的:11 $$i:的ステータス d:２面的ルート:移部屋＿忍７ 0 p:武器訓練ブレード２面ＶＲ標的破壊処理 1024 $$i:的スピード
		@ＶＲ標的基本設定（シフトつき） \
		移動的:12 $$i:的ステータス d:２面的ルート:移部屋＿忍７ 0 p:武器訓練ブレード２面ＶＲ標的破壊処理 0 -250 0 1024 0 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:13 $$i:的ステータス d:２面的ルート:移部屋＿忍８ 0 p:武器訓練ブレード２面ＶＲ標的破壊処理 1024 $$i:的スピード
		@ＶＲ標的基本設定（シフトつき） \
		移動的:14 $$i:的ステータス d:２面的ルート:移部屋＿忍８ 0 p:武器訓練ブレード２面ＶＲ標的破壊処理 0 250 0 1024 0 $$i:的スピード

		@ＶＲ標的基本設定 \
		移動的:15 $$i:的ステータス d:２面的ルート:移部屋＿忍９ 0 p:武器訓練ブレード２面ＶＲ標的破壊処理 1024 $$i:的スピードＡ
		@ＶＲ標的基本設定 \
		移動的:16 $$i:的ステータス d:２面的ルート:移部屋＿忍１０ 0 p:武器訓練ブレード２面ＶＲ標的破壊処理 1024 $$i:的スピードＡ
		@ＶＲ標的基本設定 \
		移動的:17 $$i:的ステータス d:２面的ルート:移部屋＿忍９ 0 p:武器訓練ブレード２面ＶＲ標的破壊処理 1024 $$i:的スピードＡ
		@ＶＲ標的基本設定 \
		移動的:18 $$i:的ステータス d:２面的ルート:移部屋＿忍１０ 0 p:武器訓練ブレード２面ＶＲ標的破壊処理 1024 $$i:的スピードＡ
		@ＶＲ標的基本設定 \
		移動的:19 $$i:的ステータス d:２面的ルート:移部屋＿忍９ 0 p:武器訓練ブレード２面ＶＲ標的破壊処理 1024 $$i:的スピードＡ
		@ＶＲ標的基本設定 \
		移動的:20 $$i:的ステータス d:２面的ルート:移部屋＿忍１０ 0 p:武器訓練ブレード２面ＶＲ標的破壊処理 1024 $$i:的スピードＡ

		@ＶＲ標的基本設定 \
		移動的:21 $$i:的ステータス d:２面的ルート:待部屋＿０ 0 p:武器訓練ブレード２面ＶＲ標的破壊処理 0 $$i:的スピードＡ
		@ＶＲ標的基本設定 \
		移動的:22 $$i:的ステータス d:２面的ルート:待部屋＿１ 0 p:武器訓練ブレード２面ＶＲ標的破壊処理 0 $$i:的スピードＡ
		@ＶＲ標的基本設定 \
		移動的:23 $$i:的ステータス d:２面的ルート:待部屋＿０ 0 p:武器訓練ブレード２面ＶＲ標的破壊処理 0 $$i:的スピードＡ
		@ＶＲ標的基本設定 \
		移動的:24 $$i:的ステータス d:２面的ルート:待部屋＿１ 0 p:武器訓練ブレード２面ＶＲ標的破壊処理 0 $$i:的スピードＡ
		@ＶＲ標的基本設定 \
		移動的:25 $$i:的ステータス d:２面的ルート:待部屋＿０ 0 p:武器訓練ブレード２面ＶＲ標的破壊処理 0 $$i:的スピードＡ
		@ＶＲ標的基本設定 \
		移動的:26 $$i:的ステータス d:２面的ルート:待部屋＿１ 0 p:武器訓練ブレード２面ＶＲ標的破壊処理 0 $$i:的スピードＡ
		@ＶＲ標的基本設定 \
		移動的:27 $$i:的ステータス d:２面的ルート:待部屋＿０ 0 p:武器訓練ブレード２面ＶＲ標的破壊処理 0 $$i:的スピードＡ
		@ＶＲ標的基本設定 \
		移動的:28 $$i:的ステータス d:２面的ルート:待部屋＿１ 0 p:武器訓練ブレード２面ＶＲ標的破壊処理 0 $$i:的スピードＡ
		@ＶＲ標的基本設定 \
		移動的:29 $$i:的ステータス d:２面的ルート:待部屋＿０ 0 p:武器訓練ブレード２面ＶＲ標的破壊処理 0 $$i:的スピードＡ

		@ＶＲ標的基本設定 \
		移動的:30 ($$i:的ステータス | d:VR_TRG_X_ROT) d:２面的ルート:移部屋＿忍１４ 0 p:武器訓練ブレード２面ＶＲ標的破壊処理 0 $$i:的スピード
	}




