// ------------------------------------
// マップ設定
// ------------------------------------
chara マップ 武器訓練ブレード１面 -k d:KMS_NAME -h d:HZX_NAME,0 -l $s:ＶＲライトファイル名

command マップ設定 武器訓練ブレード１面 -set {
	// ローカルの初期化
	// ------------------------------------
	@ローカル変数初期化		// ローカルで使用する変数で初期化をする場合はここで

	// ＶＲで必要な基本プロックのセット(vr_common.hで定義)
	// サウンドの基本パック、ＶＲの基本システム、プレイヤー、ゴール等を設定します
	// ※このプロックを使用する時は「ＶＲクリア時処理」というプロックが必要です
	// ＶＲ共通プロックセット	$:スネークファイル $:雷電ファイル $:クリア条件フラグ
	//							$:ゴールＸ $:ゴールＹ $:ゴールＺ
	//	VR_GOAL_TARGET	/*的全滅でゴールが開く*/
	//	VR_GOAL_FREE	/*ゴールが最初から開いてる*/
	//	VR_GOAL_ENEMY	/*敵全滅でゴールが開く*/
	//	VR_GOAL_SNEAK	/*潜入モード中はゴールが開く*/
	//	VR_GOAL_TIME	/*タイマーがゼロになるとゴールが開く*/
	// ------------------------------------
#ifndef	d:WP72A
	@ＶＲ共通プロックセット sna_wp71a rai_wp71a d:VR_GOAL_TARGET 0 0 -25000	//	ブレード１面用
#else
	@ＶＲ共通プロックセット sna_wp72a rai_wp72a d:VR_GOAL_TARGET 0 0 -25000	//	ブレード２面用
#endif

	// カメラ設定
	@カメラセット					// chara カメラとベースのカメラを設定

	// ＶＲウィンドウの設定
	// ------------------------------------
	@武器訓練ブレード１面ＶＲウィンドウ設定

//@ＶＲクリア設定 $:ＮＥＸＴＳＴＡＧＥプロック $:ＴＲＹＡＧＡＩＮプロック $:ＥＸＩＴプロック
#ifndef	d:WP72A
	@ＶＲクリア設定 p:load_wp72a p:A_ＲＥＴＲＹプロック
#else
	@ＶＲクリア設定 p:load_wp73a p:A_ＲＥＴＲＹプロック
#endif

	// ステージに引かれるライン
	// ------------------------------------
	@ＶＲアウトライン d:KMS_NAME d:TONBO_KMS_NAME d:LINE_KMS_NAME

	// 設定値を変更する場合は以下のプロック内で設定
	// ------------------------------------
	@設定値変更				// 敵兵や的のパラメータをステージ限定で変える時はここで
	@プラグイン設定			// プレイヤーのプラグインがいる時はここで

	// 的関係の設定
	// ------------------------------------
#ifndef	d:WP72A
	@武器訓練ブレード１面ＶＲ標的設定				// ＶＲシステム起動後に呼ぶ　ブレード１面用
#else
	@武器訓練ブレード２面ＶＲ標的設定				// ＶＲシステム起動後に呼ぶ　ブレード２面用
#endif

	// ＢＧＭの設定(プレイヤー→敵兵→BGMの順で呼ぶ。的の場合は関係ないがとりあえずここに)
	// ------------------------------------
	@ＢＧＭ設定

	// アイテムの設定
	// ------------------------------------
	@アイテム設定

	// 光源、オブジェクト、カメラ関連の設定
	// ------------------------------------
	@ＶＲフォグ設定 d:VR_FOG:朝Ｎ 45000 d:VR_FOG:夕Ｎ 42000 d:VR_FOG:夜Ｎ 40000
	@武器訓練ブレード１面カメラ設定		// ステージ固有のカメラ設定がいる時はこのプロックで
	@ＶＲキャラ用ライト設置					// vr_common.hに定義。必ず最後に設定

#if d:DEBUG_CHARA
//	@デバッグキャラセット
#endif

	@ジャンプ設定

}

//初期マップの表示
command マップ表示 -show 武器訓練ブレード１面


//###################################################################################
//									各proc設定
//###################################################################################



//###################################################################################
//									全マップ共通
//###################################################################################
	// ------------------------------------
	// 全マップ共通
	// ------------------------------------
	// ------------------------------------
	// クリア時の処理
	// ------------------------------------
	proc ＶＲクリア時処理 {
		#if d:DEBUG_PRINT
			print 'clear'
		#endif

		// 強制モーションを発動
		@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_1 2048

		// クリア時にカメラアングルを変える
		chara カメラ設定 カットインカメラ \
			-c 1 \
			-p 398,1773,-28672 -t 398,1081,-24610 \
			-r 110,0,0 -f 4121 \
			-a 200 \
			-i 1 1 0 0 \
			-s 1

	}



	// ------------------------------------
	// パラメータ系の変更
	// ------------------------------------
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT
			print 'localvar_init'
		#endif

		//	的フラグを初期化する
		eval ($$i:的起動フラグ = 0)

		//	的ステータスを初期化する
		eval ($$i:的基本ステータス = 0);
		eval ($$i:的ステータス = 0)

		//	的スピードを初期化する
		eval ($$i:的スピード = 0)
		eval ($$i:的スピードＡ = 0)

		//	的セット数を初期化する
		eval ($$b:的セット数 = 0);

	}
	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT
			print 'status_set'
		#endif

		// 初期装備の設定
		/*	@ＶＲ共通プロックセット内で設定	*/

	}
	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif

		/*	@ＶＲ共通プロックセット内で設定	*/

	}



//###################################################################################
//									 総合　的設定
//###################################################################################

//////////////////////////
//	基本的プロック
//////////////////////////

	// 移動的プロック
	// ------------------------------------
	proc ＶＲ標的基本設定 \
	$:p_名前 $:p_的ステータス $:p_ルート $:p_ノード $:p_破壊プロック $:p_初期方向 $:p_的スピード {

		//	点滅用処理
		@点滅割り振り設定 $:p_名前

		chara	ＶＲ移動的 $:p_名前 \
			-flag ($$i:的基本ステータス | $:p_的ステータス) \
			-route $:p_ルート $:p_ノード \
			-c $:p_破壊プロック \
			-dir $:p_初期方向 0 \
			-speed $:p_的スピード
	}

	proc ＶＲ標的基本設定（シフトつき） \
	$:p_名前 $:p_的ステータス $:p_ルート $:p_ノード $:p_破壊プロック $:p_シフトＸ $:p_シフトＹ $:p_シフトＺ $:p_初期方向 $:p_自転速度 $:p_的スピード {

		//	点滅用処理
		@点滅割り振り設定 $:p_名前

		chara	ＶＲ移動的 $:p_名前 \
			-flag ($$i:的基本ステータス | $:p_的ステータス | d:VR_TRG_ABSSHIFT) \	//	絶対座標シフト
			-route $:p_ルート $:p_ノード \
			-c $:p_破壊プロック \
			-yshift $:p_シフトＸ $:p_シフトＹ $:p_シフトＺ \
			-dir $:p_初期方向 $:p_自転速度 \
			-speed $:p_的スピード
	}


//////////////////////////
//	点滅割り振り設定
//////////////////////////
	proc 点滅割り振り設定 $:p_名前 {
		//	プリスキンかタキシードスネークは、点滅する
		if( ($s:選択プレイヤー == プリスキン) || \
			($s:選択プレイヤー == タキシードスネーク) ) {
			//	的セット数をカウントする
			$$b:的セット数 = $$b:的セット数 + 1;

//	ブレード１面
#ifndef d:WP72A
			@ブレード１面点滅割り振り設定 $:p_名前

//	ブレード２面
#else
			@ブレード２面点滅割り振り設定 $:p_名前
#endif

		//	そのほかのキャラは点滅しない
		} else {
			eval ($$i:的基本ステータス = $$i:的基本ステータス)
		}

	}

	//	基本点滅割り振り設定
	proc 基本点滅割り振り設定 {
		//	奇数ならば（＝的セット数が割り切れなければ）、消え状態からスタート
		if( $$b:的セット数 % 2 ) {
			eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)

		//	偶数ならば（＝的セット数が割り切れれば）、点き状態からスタート
		} else {
			eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
		}
	}

	//	ブレード１面例外措置
	proc ブレード１面点滅割り振り設定 $:p_名前 {
		//	プリスキンの場合
		if ($s:選択プレイヤー == プリスキン) {
			if ($:p_名前 == 移動的:02) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			//	それ以外の的は
			} else {
				//	奇数ならば（＝的セット数が割り切れなければ）、点き状態からスタート
				if( $$b:的セット数 % 2 ) {
					eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

				//	偶数ならば（＝的セット数が割り切れれば）、消え状態からスタート
				} else {
					eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
				}
			}

		//	タキシードの場合
		} else {
			if ($:p_名前 == 移動的:01) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			//	それ以外の的は
			} else {
				@基本点滅割り振り設定
			}

		}

	}

	//	ブレード２面例外措置
	proc ブレード２面点滅割り振り設定 $:p_名前 {
		//	プリスキンの場合
		if ($s:選択プレイヤー == プリスキン) {
			if ($:p_名前 == 移動的:01) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			} else if ($:p_名前 == 移動的:03) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			} else if ($:p_名前 == 移動的:06) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ($:p_名前 == 移動的:07) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			//	移動的:12〜移動的:15は
			} else if ( ($$b:的セット数 >= 12) && ($$b:的セット数 <= 15) ) {
				//	奇数ならば（＝的セット数が割り切れなければ）、点き状態からスタート
				if( $$b:的セット数 % 2 ) {
					eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

				//	偶数ならば（＝的セット数が割り切れれば）、消え状態からスタート
				} else {
					eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
				}

			//	それ以外の的は
			} else {
				@基本点滅割り振り設定
			}

		//	タキシードの場合
		} else {
			if ($:p_名前 == 移動的:01) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			} else if ($:p_名前 == 移動的:05) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			} else if ($:p_名前 == 移動的:06) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ( ($:p_名前 == 移動的:07) || ($:p_名前 == 移動的:08) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ( ($:p_名前 == 移動的:09) || ($:p_名前 == 移動的:10) || \
						($:p_名前 == 移動的:11) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			//	それ以外の的は
			} else {
				@基本点滅割り振り設定
			}
		}

	}





//////////////////////////
//	ブレード１面用
//////////////////////////

	//	スタート処理
	// ------------------------------------
	proc 武器訓練ブレード１面ＶＲ標的スタート処理 {
		//	ライデンを選択
		if ($s:選択プレイヤー == ライデン) {
			@ライデン的１面スタート処理

		//	スネークを選択
		} else if ($s:選択プレイヤー == スネーク) {
			@スネーク的１面スタート処理

		//	プリスキンを選択（ライデンとコンパチ？）
		} else if ($s:選択プレイヤー == プリスキン) {
			@ライデン的１面スタート処理

		//	タキシードスネークを選択（スネークとコンパチ）
		} else if ($s:選択プレイヤー == タキシードスネーク) {
			@スネーク的１面スタート処理

		//	前作スネークを選択
		} else if ($s:選択プレイヤー == 前作スネーク) {
			@前作スネーク的１面スタート処理

		//	忍者を選択
		} else if ($s:選択プレイヤー == 刀ライデン) {
			@忍者的１面スタート処理
		}

	}

	// 破壊時処理
	// ------------------------------------
	proc 武器訓練ブレード１面ＶＲ標的破壊処理 {
		//	ライデンを選択
		if ($s:選択プレイヤー == ライデン) {
			@ライデン的１面破壊処理 $1

		//	スネークを選択
		} else if ($s:選択プレイヤー == スネーク) {
			@スネーク的１面破壊処理 $1

		//	プリスキンを選択（ライデンとコンパチ？）
		} else if ($s:選択プレイヤー == プリスキン) {
			@ライデン的１面破壊処理 $1

		//	タキシードスネークを選択（スネークとコンパチ）
		} else if ($s:選択プレイヤー == タキシードスネーク) {
			@スネーク的１面破壊処理 $1

		//	前作スネークを選択
		} else if ($s:選択プレイヤー == 前作スネーク) {
			@前作スネーク的１面破壊処理 $1

		//	忍者を選択
		} else if ($s:選択プレイヤー == 刀ライデン) {
			@忍者的１面破壊処理 $1
		}

	}

	// 的配置
	// ------------------------------------
	proc 武器訓練ブレード１面ＶＲ標的設定 {
		eval ($$i:的ステータス = ($$i:的ステータス | d:VR_TRG_KATANA | d:VR_TRG_WAIT | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST) )

		//	ライデンを選択
		if ($s:選択プレイヤー == ライデン) {
			@ライデン的１面設定

		//	スネークを選択
		} else if ($s:選択プレイヤー == スネーク) {
			@スネーク的１面設定

		//	プリスキンを選択（ライデンとコンパチ？）
		} else if ($s:選択プレイヤー == プリスキン) {
			@ライデン的１面設定

		//	タキシードスネークを選択（スネークとコンパチ）
		} else if ($s:選択プレイヤー == タキシードスネーク) {
			@スネーク的１面設定

		//	前作スネークを選択
		} else if ($s:選択プレイヤー == 前作スネーク) {
			@前作スネーク的１面設定

		//	忍者を選択
		} else if ($s:選択プレイヤー == 刀ライデン) {
			@忍者的１面設定
		}

	}



