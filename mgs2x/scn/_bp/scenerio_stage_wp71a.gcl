		//	前作スネークを選択
		} else if ($s:選択プレイヤー == 前作スネーク) {
			@前作スネーク的２面破壊処理 $1

		//	忍者を選択
		} else if ($s:選択プレイヤー == 刀ライデン) {
			@忍者的２面破壊処理 $1
		}

	}

	// 的配置
	// ------------------------------------
	proc 武器訓練ブレード２面ＶＲ標的設定 {
		eval ($$i:的ステータス = ($$i:的ステータス | d:VR_TRG_KATANA | d:VR_TRG_WAIT | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST) )
		eval ($$i:的スピード = 35)
		eval ($$i:的スピードＡ = 40)

		//	ライデンを選択
		if ($s:選択プレイヤー == ライデン) {
			@ライデン的２面設定

		//	スネークを選択
		} else if ($s:選択プレイヤー == スネーク) {
			@スネーク的２面設定

		//	プリスキンを選択（ライデンとコンパチ？）
		} else if ($s:選択プレイヤー == プリスキン) {
			@ライデン的２面設定

		//	タキシードスネークを選択（スネークとコンパチ）
		} else if ($s:選択プレイヤー == タキシードスネーク) {
			@スネーク的２面設定

		//	前作スネークを選択
		} else if ($s:選択プレイヤー == 前作スネーク) {
			@前作スネーク的２面設定

		//	忍者を選択
		} else if ($s:選択プレイヤー == 刀ライデン) {
			@忍者的２面設定
		}

	}



//###################################################################################
//									 ライデン　的設定
//###################################################################################

//////////////////////////
//	ブレード１面用
//////////////////////////

	//	スタート処理
	proc ライデン的１面スタート処理 {
		mesg ＶＲ的共通 移動的:01 移動開始

	}

	//	破壊時処理
	proc ライデン的１面破壊処理 {
		if ($1 == 移動的:01) {
			mesg ＶＲ的共通 移動的:02 移動開始
		} else if ($1 == 移動的:02) {
			mesg ＶＲ的共通 移動的:03 移動開始
			mesg ＶＲ的共通 移動的:04 移動開始
		} else if ( ($1 == 移動的:03) || ($1 == 移動的:04) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 2) {
				mesg ＶＲ的共通 移動的:05 移動開始
				mesg ＶＲ的共通 移動的:06 移動開始
				eval ($$i:的起動フラグ = 0)
			}
		} else if ( ($1 == 移動的:05) || ($1 == 移動的:06) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 2) {
				mesg ＶＲ的共通 移動的:07 移動開始
				mesg ＶＲ的共通 移動的:08 移動開始
				mesg ＶＲ的共通 移動的:09 移動開始
				eval ($$i:的起動フラグ = 0)
			}
		} else if ( ($1 == 移動的:07) || ($1 == 移動的:08) || ($1 == 移動的:09) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 3) {
				mesg ＶＲ的共通 移動的:10 移動開始
				mesg ＶＲ的共通 移動的:11 移動開始
				mesg ＶＲ的共通 移動的:12 移動開始
				mesg ＶＲ的共通 移動的:13 移動開始
				eval ($$i:的起動フラグ = 0)
			}
		}
	}

	//	的配置
	proc ライデン的１面設定 {

	//	@ＶＲ標的基本設定 \
	//	$:p_名前 $:p_的ステータス $:p_ルート $:p_ノード $:p_破壊プロック $:p_初期方向 $:p_的スピード

		//	ルーム
		@ＶＲ標的基本設定 \
		移動的:01 $$i:的ステータス d:１面的ルート:移部屋＿０ 0 p:武器訓練ブレード１面ＶＲ標的破壊処理 0 0

		@ＶＲ標的基本設定 \
		移動的:02 $$i:的ステータス d:１面的ルート:移部屋＿１ 0 p:武器訓練ブレード１面ＶＲ標的破壊処理 1024 0

		@ＶＲ標的基本設定 \
		移動的:03 $$i:的ステータス d:１面的ルート:移部屋＿２ 0 p:武器訓練ブレード１面ＶＲ標的破壊処理 0 0
		@ＶＲ標的基本設定 \
		移動的:04 $$i:的ステータス d:１面的ルート:移部屋＿３ 0 p:武器訓練ブレード１面ＶＲ標的破壊処理 0 0

		@ＶＲ標的基本設定 \
		移動的:05 $$i:的ステータス d:１面的ルート:移部屋＿４ 0 p:武器訓練ブレード１面ＶＲ標的破壊処理 1024 0
		@ＶＲ標的基本設定 \
		移動的:06 $$i:的ステータス d:１面的ルート:移部屋＿５ 0 p:武器訓練ブレード１面ＶＲ標的破壊処理 1024 0

		@ＶＲ標的基本設定 \
		移動的:07 $$i:的ステータス d:１面的ルート:移部屋＿６ 0 p:武器訓練ブレード１面ＶＲ標的破壊処理 0 0
		@ＶＲ標的基本設定 \
		移動的:08 $$i:的ステータス d:１面的ルート:移部屋＿７ 0 p:武器訓練ブレード１面ＶＲ標的破壊処理 0 0
		@ＶＲ標的基本設定 \
		移動的:09 $$i:的ステータス d:１面的ルート:移部屋＿８ 0 p:武器訓練ブレード１面ＶＲ標的破壊処理 0 0

		@ＶＲ標的基本設定 \
		移動的:10 $$i:的ステータス d:１面的ルート:移部屋＿９ 0 p:武器訓練ブレード１面ＶＲ標的破壊処理 1024 0
		@ＶＲ標的基本設定 \
		移動的:11 $$i:的ステータス d:１面的ルート:移部屋＿１０ 0 p:武器訓練ブレード１面ＶＲ標的破壊処理 1024 0
		@ＶＲ標的基本設定 \
		移動的:12 $$i:的ステータス d:１面的ルート:移部屋＿１１ 0 p:武器訓練ブレード１面ＶＲ標的破壊処理 1024 0
		@ＶＲ標的基本設定 \
		移動的:13 $$i:的ステータス d:１面的ルート:移部屋＿１２ 0 p:武器訓練ブレード１面ＶＲ標的破壊処理 1024 0
	}



//////////////////////////
//	ブレード２面用
//////////////////////////

	//	スタート処理
	proc ライデン的２面スタート処理 {
		mesg ＶＲ的共通 移動的:01 移動開始

	}

	//	破壊時処理
	proc ライデン的２面破壊処理 {
		if ($1 == 移動的:01) {
			mesg ＶＲ的共通 移動的:02 移動開始

		} else if ($1 == 移動的:02) {
			mesg ＶＲ的共通 移動的:03 移動開始

		} else if ($1 == 移動的:03) {
			mesg ＶＲ的共通 移動的:04 移動開始
			mesg ＶＲ的共通 移動的:05 移動開始

		} else if ( ($1 == 移動的:04) || ($1 == 移動的:05) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 2) {
				mesg ＶＲ的共通 移動的:06 移動開始
				mesg ＶＲ的共通 移動的:07 移動開始

				eval ($$i:的起動フラグ = 0)
			}

		} else if ( ($1 == 移動的:06) || ($1 == 移動的:07) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 2) {
				mesg ＶＲ的共通 移動的:08 移動開始

				chara delay 的起動ディレイ \
					-t (60*1/2) \	//	30フレーム
					-e {
						mesg ＶＲ的共通 移動的:09 移動開始
					}
				chara delay 的起動ディレイ \
					-t (60*1/2*2) \
					-e {
						mesg ＶＲ的共通 移動的:10 移動開始
					}
				chara delay 的起動ディレイ \
					-t (60*1/2*3) \
					-e {
						mesg ＶＲ的共通 移動的:11 移動開始
					}

				eval ($$i:的起動フラグ = 0)
			}

		} else if (	($1 == 移動的:08) || ($1 == 移動的:09) || ($1 == 移動的:10) || \
					($1 == 移動的:11) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 4) {
				mesg ＶＲ的共通 移動的:12 移動開始
				mesg ＶＲ移動的 移動的:12 即ルート変更 d:２面的ルート:移部屋＿９

				chara delay 的起動ディレイ \
					-t (60*1/2) \	//	30フレーム
					-e {
						mesg ＶＲ的共通 移動的:13 移動開始
						mesg ＶＲ移動的 移動的:13 即ルート変更 d:２面的ルート:移部屋＿１０
					}
				chara delay 的起動ディレイ \
					-t (60*1/2*2) \
					-e {
						mesg ＶＲ的共通 移動的:14 移動開始
						mesg ＶＲ移動的 移動的:14 即ルート変更 d:２面的ルート:移部屋＿９
					}
				chara delay 的起動ディレイ \
					-t (60*1/2*3) \
					-e {
						mesg ＶＲ的共通 移動的:15 移動開始
						mesg ＶＲ移動的 移動的:15 即ルート変更 d:２面的ルート:移部屋＿１０
					}

				eval ($$i:的起動フラグ = 0)
			}

		} else if (	($1 == 移動的:12) || ($1 == 移動的:13) || ($1 == 移動的:14) || \
					($1 == 移動的:15) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 4) {
				mesg ＶＲ的共通 移動的:16 移動開始

				eval ($$i:的起動フラグ = 0)
			}

		}

