// 各gclで必要なdefine
// ------------------------------------
// モード
#define		STAGE_PLANT		1		// 共通プロック切り分け用
#define		STAGE_ALT		1		// オルタナティブミッション切り分け用
#define		ANOTHER			1	// アナザーミッションステージ切り分け用
// ステージ名
#define		STAGE_W31D		1		// 共通プロック切り分け用
// 敵兵、ＮＰＣ状況（薬莢を呼び分けるのに必要）
#define		ENE_P_GOL		1		// 都市迷彩ゴル兵
#define		GUN_MECA		1 		// ガンカメ ガンサイファー 
//#define		ENE_SHOT		1		// ショットガン兵
#define		ENE_HIGT_TECH	1		// ハイテク兵
#define		ENE_SHIELD		1		// 盾兵


// 各種スイッチ用define
// ------------------------------------
// エレベーター
#define		ELEVATOR_SET	1		// エレベーター設置を有効にする
#define		ELEVATOR_Y		0		// エレベーターをＹ軸にいくつずらすか
#define		ELEVATOR_Z		-180250	// エレベーターをＺ軸にいくつずらすか
#define		ELV_1F			1		// ステージの階数を定義
#define		SHELL			1		// シェル２は１で定義
#define		ELE_CHECK		1		// 外のボタンを押した時の処理を独自でするために必要 stdproc.h で使用
// 入出トラップ
#define		STAGE_END		1		// ステージ終了時処理を使用可にする
// カメラ関係
#define		START_CAMERA	1		// ステージ開始時のカメラ

// デバッグ関係
#ifdef	d:FIX_MODE
	#define		DEBUG_CHARA		0		// デバッグキャラ全体(FIX時は0)
#else
	#define		DEBUG_CHARA		0		// デバッグキャラ全体
#endif
#define		CHARA_CAMERA	0		// キャラ追従カメラ
#define		TARGET_CHARA	敵兵:01	// キャラ追従カメラのターゲット
#define		SCREENSHOT		0		// スクリーンショット
#define		USB_KEY			0		// USBキーボード


// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME			a31a
#define		KMS_NAME0			w31a0
#define		KMS_NAME1			elv_2
#define		KMS_NAME2			w31a_pipe
#define		KMS_NAME3			w31a_25c
#define		KMS_NAME4			w31a1
#define		PANEL_KMS_NAME0		aw31a_panel0
#define		PANEL_KMS_NAME1		aw31a_panel1
#define		CEIL_NAME0			w31ar
#define		CEIL_NAME1			elv_2r
#define		WALL_NAME0			w31a_wall01
#define		DOOR_NAME			dr_free
#define		DOOR_NAME_LOAD		w31a_dr00		// ロード用
#define		LT2_NAME			w31a


// キャラクター関係
#define		PLAYER		ライデン	// モーションができるまで名前はスネーク

// ------------------------------------
// 敵兵音声
// ------------------------------------
// 司令官、危険モード時の音声リソース
resource ghq_area_alert_voice {
	w31d:
		$t{
			// PLAREA0 ＫＬ連絡橋側
			t:vc040258,		// 指揮官「了解。バックアップ、シェル２中央棟１Ｆに向かえ！ＫＬ連絡橋への扉を守れ！」
			t:vc040259,		// 指揮官「了解。増援部隊をシェル２中央棟１Ｆ・ＫＬ連絡橋への扉付近に送る。敵を逃がすな！」
			-2, // PLAREA0の登録終了
			// PLAREA1 通路
			t:vc040260,		// 指揮官「了解。増援部隊、シェル２中央棟１Ｆ・通路に向かえ。敵を包囲せよ！」
			t:vc040261,		// 指揮官「了解。応援部隊をシェル２中央棟１Ｆに送る。通路を守れ！」
			t:vc040262,		// 指揮官「了解。増援部隊、シェル２中央棟１Ｆに向かえ！侵入者を包囲せよ」
			t:vc040263,		// 指揮官「了解。増援部隊をシェル２中央棟１Ｆに派遣する！敵を逃がすな！」
			-1 // 全ての登録終了
		}
}

// 司令官、警戒モード時の音声リソース
resource ghq_caution_voice {
	w31d:
		$t{
			t:vc040416,		// 指揮官「了解。シェル２中央棟１Ｆに増員を送る。警戒を強化しろ」
			t:vc040415,		// 指揮官「了解。シェル２中央棟１Ｆに増員を派遣する。通路の戒を強化しろ」
			t:vc040414,		// 指揮官「了解。シェル２中央棟１Ｆ通路を増員。警備を強化しろ」
			-2
			t:vc040435,		// 指揮官「シェル２中央棟１Ｆとの連絡が途絶えた」
			-1
		}
}

// 敵兵ルート番号
#define		攻撃兵待機ルート			5
#define		休憩室ルート				6
#define		ＨＩ連絡橋ルート			7
#define		南通路ルート１				8
#define		南通路ルート２				9
#define		休憩室ルートＨＤ			10
#define		南通路ルート２ＨＤ			11
#define		イベント１ルート待機		12
#define		イベント１ルート巡回		13
#define		イベント２ルート待機		14
#define		イベント２ルート巡回		15
#define		ＨＩ側通路ルートＥＸ		16
#define		ＨＩ側通路ルート２ＥＸ		17
#define		南通路ルートＥＸ			18
#define		南通路ルート２ＥＸ			19
#define		イベント１ルート待機ＥＸ	20
#define		イベント１ルート巡回ＥＸ	21
#define		イベント２ルート待機ＥＸ	22
#define		イベント２ルート巡回ＥＸ	23
#define		追加警備ルート				24

// クリアリングルート
// ------------------------------------
// クリアリングエリア０
enum C_R0 {
	先頭兵ルート = 0,
	先頭兵左チェックルート,
	先頭兵右チェックルート,
	２番兵ルート
}



// ローカル変数
// ドア設定用ステージ内ローカル変数(a_mode.hよりも先に定義する)
dim $$b:ドアフラグ[ 3 ]
dim $$s:ドアモデル名[ 3 ]

command	配列セット $$b:ドアフラグ[0] {
	0,	0,	0
}
command	配列セット $$s:ドアモデル名[0] {
	0,	0,	0
}

// 鏡面モデルをローカルで設定するフラグ(ステルス兵対応用)
$$f:鏡面モデルローカル設定フラグ = 0;



// include
// ------------------------------------
#include "rai_a31a.mh"		// 強制モーションリスト
#include "stdch.h"
#include "enevoice.h"
#include "w31ad_common.h" 
#include "a_mode.h"			// アナザーミッション設定ファイル
#include "sload.h"
#include "jump.h"
#include "sound.h"
//#include "emavoice.h" /* エマ用の音声 */
#include "item_info.h"
#include "node_res.h"
#include "ene_item.h"

#if d:USB_KEY
	#include "usbkbd.h"
#endif

// アナザー用でマップ設定前に設定する
// ------------------------------------
//	スネークテイルズＤの電撃床破壊中はポリデモ再生
if (	($b:ミッション番号 != d:MISSION:スネークテイルズ) || \
		($b:tales_story_no != d:TALES_NO:D) || \
		($b:tales_story_d != d:TALES_D:電撃床破壊中)	) {

	@アナザー用マップ定義前設定
}

// マップ設定
// ------------------------------------
if ( $b:ミッション番号 == d:MISSION:スネークテイルズ ) {
	chara マップ シェル２中央棟１Ｆ -k d:KMS_NAME0 -k d:KMS_NAME3 -k d:KMS_NAME4 -h d:HZX_NAME,0 -l d:LT2_NAME
} else {
	chara マップ シェル２中央棟１Ｆ -k d:KMS_NAME0 -k d:KMS_NAME3 -k d:KMS_NAME4 -k d:PANEL_KMS_NAME1 -h d:HZX_NAME,0 -l d:LT2_NAME}

//	スネークテイルズＤの電撃床破壊中はポリデモ再生
if (	($b:ミッション番号 == d:MISSION:スネークテイルズ) && \
		($b:tales_story_no == d:TALES_NO:D) && \
		($b:tales_story_d == d:TALES_D:電撃床破壊中)	) {
	#include "polydemo_a31a.h"
}

command マップ設定 シェル２中央棟１Ｆ -set {
	// サウンド、キャラクターのセット
	// ------------------------------------
	@常駐キャラ設定			// stdch.hで定義

	//	スネークテイルズＤの電撃床破壊中はポリデモ再生
	if (	($b:ミッション番号 != d:MISSION:スネークテイルズ) || \
			($b:tales_story_no != d:TALES_NO:D) || \
			($b:tales_story_d != d:TALES_D:電撃床破壊中)	) {
		@ローカル変数初期化		// w31ad_common.hで定義
		@設定値変更				// w31ad_common.hで定義
		@プラグイン設定			// w31ad_common.hで定義
		@A_プレイヤー設定 sna_a31a rai_a31a
	}
}

// アナザー用でマップ設定後に設定する
// ------------------------------------
//	スネークテイルズＤの電撃床破壊中はポリデモ再生
if (	($b:ミッション番号 != d:MISSION:スネークテイルズ) || \
		($b:tales_story_no != d:TALES_NO:D) || \
		($b:tales_story_d != d:TALES_D:電撃床破壊中)	) {

	@アナザー用マップ定義後設定
}

command マップ設定 シェル２中央棟１Ｆ -set {
	//	スネークテイルズＤの電撃床破壊中はポリデモ再生
	if (	($b:ミッション番号 != d:MISSION:スネークテイルズ) || \
		($b:tales_story_no != d:TALES_NO:D) || \
		($b:tales_story_d != d:TALES_D:電撃床破壊中)	) {

		if ( $$f:鏡面モデルローカル設定フラグ == 0 ) {
			@鏡面モデル設定			// w31ad_common.hで定義
		}
		@弾痕跳弾設定			// w31ad_common.hで定義

		// ステージ、オブジェクト関連
		// ------------------------------------
		@エレベーター設置 シェル２中央棟１Ｆ	// stdproc.hで定義
		@パイプ部屋パイプ設置					// w31ad_common.hで定義
		@A_ドア設置								// 本編と共通で持つと危険なため独自で設置
		@主観禁止壁設定							// w31ad_common.hで定義
		@イントルード金網設定					// w31ad_common.hで定義
		@ロード設定								// w31ad_common.hで定義
		@フォグ設定				// w31ad_common.hで定義
		@カメラセット			// w31ad_common.hで定義
		@子画面設定
		@シェル２中央棟１Ｆ天井設置	// w31ad_common.hで定義
		@シェル２中央棟１Ｆ南壁設置	// w31ad_common.hで定義
		@シェル２中央棟１Ｆジャンプ設定	// w31ad_common.hで定義
		@シェル２中央棟１Ｆカメラ設定	// w31ad_common.hで定義
		@キャラ用ライト設置				// マップ設定の最後に呼ぶ。w31ad_common.hで定義

		// デバッグ関係
		// ------------------------------------
		#if d:DEBUG_CHARA
		//	@デバッグキャラセット
		#endif
	}
}



if (	($b:ミッション番号 != d:MISSION:スネークテイルズ) || \
		($b:tales_story_no != d:TALES_NO:D) || \
		($b:tales_story_d != d:TALES_D:電撃床破壊中)	) {

	// 全てのセットが終わったところでフェードイン
	if( $s:登場ポイント == ＫＬ連絡橋から ) {
		// ＫＬ連絡橋から
		//初期マップの表示
		command マップ表示 -show シェル２中央棟１Ｆ
		// 全てのセットが終わったところでフェードイン
		@ステージ開始時処理（ステージ名表示） \
			d:LOAD_TYPE:SL_DOOR_TYPE １Ｆ右ドア 2000 d:DEFAULT_M_TYPE \
			d:wn_シェル２中央棟１Ｆ空気清浄室

	} else if ($s:登場ポイント == テイルズＤシェル２中央棟到着紙芝居後から) {
		//	テイルズＤシェル２中央棟到着紙芝居後から
		//初期マップの表示
		command マップ表示 -show シェル２中央棟１Ｆ
		@ステージ開始時処理（ステージ名表示） \
			d:LOAD_TYPE:NO_MOVE_TYPE 紙芝居 0 d:DEFAULT_M_TYPE \
			d:wn_シェル２中央棟１Ｆ空気清浄室

	} else if ($s:登場ポイント == テイルズＤ電撃床破壊後から) {
		//	テイルズＤ電撃床破壊後から
		//初期マップの表示
		command マップ表示 -show シェル２中央棟１Ｆ
		@ステージ開始時処理 \
			d:LOAD_TYPE:NO_MOVE_TYPE 紙芝居 0 d:DEFAULT_M_TYPE

	} else if ($s:登場ポイント == テイルズＤ海軍大佐語り紙芝居後から) {
		//	テイルズＤ海軍大佐語り紙芝居後から
		//初期マップの表示
		command マップ表示 -show シェル２中央棟１Ｆ
		@ステージ開始時処理 \
			d:LOAD_TYPE:NO_MOVE_TYPE 紙芝居 0 d:DEFAULT_M_TYPE

	} else {
		// 武装解除訓練10面用
		//初期マップの表示
		command マップ表示 -show シェル２中央棟１Ｆ
	}

//	スネークテイルズＤの電撃床破壊中はポリデモ再生
} else {
	//初期マップの表示
	command マップ表示 -show シェル２中央棟１Ｆ
}




// 各proc設定
//-------------------------------------------------------------------------------------
// 全マップ共通
	// エレベーターのボタンを押したときの処理
	// ------------------------------------
	proc エレベータボタン押した終了 {
		#if d:DEBUG_PRINT
			print 'elevator_door_push'
		#endif

		if (($b:ミッション番号 == d:MISSION:スネークテイルズ) && \
			($b:tales_story_no == d:TALES_NO:D) && \
			($b:tales_story_d == d:TALES_D:エレベータ搭乗前)	) {
		// スネークテイルズＤのエレベータ搭乗前では独自にa31a_tale.hで設定
			@スネークテイルズＤ用エレベータ設定
		} else {
			command パッド操作 -cancel
			chara カメラ設定 モーションカメラ -s -1
			command ＳＥセットモード -s d:SD_S_BUZZER01 -p 0,0,0  -m 1
		}
	}



	// ドア＆マップ切り替え関係
	// ------------------------------------
	proc A_ドア設置 {
		#if d:DEBUG_PRINT
			print 'slide_door_set'
		#endif

		// ドアフラグを元にモデルを設定(※全てのパターンのモデルを用意するのはもったいないので使うところのみ変更していく)
		// ドアモデル名セット $:配列番号 $:ドア名１(close) $:ドア名２(open) $:ドア名３(enemy) $:ドア名４(lv_close) $:ドア名５(lv_open)
		// １Ｆ右ドア
		@ドアモデル名セット 0 d:DOOR_NAME_LOAD d:DOOR_NAME_LOAD d:DOOR_NAME_LOAD d:DOOR_NAME_LOAD d:DOOR_NAME_LOAD
		// 倉庫ドア
		@ドアモデル名セット 1 d:DOOR_NAME d:DOOR_NAME d:DOOR_NAME d:DOOR_NAME d:DOOR_NAME
		// 監禁室ドア
		@ドアモデル名セット 2 d:DOOR_NAME d:DOOR_NAME d:DOOR_NAME d:DOOR_NAME d:DOOR_NAME

		@ドアランプ設定 １Ｆ右ドアランプ 1024 19125,0,-234250 2
		chara ドア １Ｆ右ドア \
			-m $$s:ドアモデル名[0] \
			-d 0,1024,0 \
			-p 19125,0,-234250 \
			-slide d:SD_SLIDE_OUTSIDE \
			-time d:SD_OPEN_TIME \
			-between シェル２中央棟１Ｆ シェル２中央棟１Ｆ \
			-A １Ｆ右ドアランプ \
			-exec {
			}
		trap dr001 ？ \
			-mask ？ \	
			-exec {
					if($3==入る){
						mesg ドア １Ｆ右ドア open $2
					}else{
						mesg ドア １Ｆ右ドア close $2
					}
			}
		trap dr001 d:PLAYER -mask ？ \
			-state d:TRP_STATE_SUBJECT \
			-exec {
				if($3 == 入る) {
					mesg 透明壁 １Ｆ右ドアへの透明壁 on
				} else if($3 == 出る) {
					mesg 透明壁 １Ｆ右ドアへの透明壁 off
				}
			}
		@A_ドア開閉追加設定 １Ｆ右ドア $$b:ドアフラグ[0] 19125,0,-234250 1024 d:SD_SLIDE_OUTSIDE


		// 開かずの扉(デモでは写らないのでいれない)
		@壊れドアエフェクト設定 壊れドアエフェクト 1024 -19125,0,-234250 0
		chara ドア １Ｆ左ドア \
			-m d:DOOR_NAME_LOAD \
			-d 0,1024,0 \
			-p -19125,0,-234250 \
			-slide d:SD_SLIDE_OUTSIDE \
			-time d:SD_OPEN_TIME \
			-between シェル２中央棟１Ｆ シェル２中央棟１Ｆ \
			-card_level 9999 \
			-exec {
			}


		@ドアランプ設定 倉庫ドアランプ 1024 -8875,0,-231500 1
		chara ドア 倉庫ドア \
			-m $$s:ドアモデル名[1] \
			-d 0,1024,0 \
			-p -8875,0,-231500 \
			-slide d:SD_SLIDE_INSIDE \
			-time d:SD_OPEN_TIME \
			-between シェル２中央棟１Ｆ シェル２中央棟１Ｆ \
			-A 倉庫ドアランプ \
			-exec {
			}
		trap dr002 ？ \
			-mask ？ \	
			-exec {
					if($3==入る){
						mesg ドア 倉庫ドア open $2
					}else{
						mesg ドア 倉庫ドア close $2
					}
			}
		@A_ドア開閉追加設定 倉庫ドア $$b:ドアフラグ[1] -8875,0,-231500 1024 d:SD_SLIDE_INSIDE

		@ドアランプ設定 監禁室ドアランプ 1024 3625,0,-240000 0
		@ドアランプ設定 監禁室ドアランプ 1024 3375,0,-240000 1
		chara ドア 監禁室ドア \
			-m $$s:ドアモデル名[2] \
			-d 0,1024,0 \
			-p 3500,0,-240000 \
			-slide 1500 \
			-time d:SD_OPEN_TIME \
			-between シェル２中央棟１Ｆ シェル２中央棟１Ｆ \
			-A 監禁室ドアランプ \
			-exec {
			}

		trap dr003 ？ \
			-mask ？ \	
			-exec {
				if (($b:ミッション番号 == d:MISSION:スネークテイルズ) && \
					($b:tales_story_no == d:TALES_NO:D) && \
					($b:tales_story_d == d:TALES_D:海軍大佐語り前)	) {
				// スネークテイルズＤの海軍大佐語り前では独自にa31a_tale.hで設定

				} else {
					if($3==入る){
						mesg ドア 監禁室ドア open $2
					} else {
						mesg ドア 監禁室ドア close $2
					}
				}
			}
		@A_ドア開閉追加設定 監禁室ドア $$b:ドアフラグ[2] 3500,0,-240000 1024 1500

	}



	// クリアリング設定
	//--------------------------------------------------------
	proc クリアリングエリア０初期設定 {
		#if d:DEBUG_PRINT 
			print '$b:w31a_クリアリング回避回数='$b:w31a_クリアリング回避回数
		#endif

		command セットクリアリング \
			-i	d:C_R0:先頭兵ルート, \
				d:C_R0:２番兵ルート, \
			-p	0, d:C_R0:先頭兵ルート, 1, スタンチェック０ \
				0, d:C_R0:先頭兵ルート, 7, クリアリングコース選択 \
				0, d:C_R0:先頭兵ルート, 0,子画面オンオフチェック０ \
				0, d:C_R0:先頭兵ルート, 0,クリアリングカメラ１ \
				0, d:C_R0:先頭兵ルート, 4,クリアリングカメラ２ \
				0, d:C_R0:先頭兵左チェックルート, 0, クリアリングカメラ３ \
				0, d:C_R0:先頭兵右チェックルート, 0, クリアリングカメラ３ \
				0, d:C_R0:先頭兵左チェックルート, 9, クリアリングカメラ４ \
				0, d:C_R0:先頭兵右チェックルート, 6, クリアリングカメラ４

		if ( $f:エマ存在フラグ == 1 ) {
			mesg エマ・エメリッヒ 手繋ぎエマ 徘徊不可能
		}
	}

	proc クリアリングエリア１初期設定 {
		#if d:DEBUG_PRINT 
			print '$b:w31a_クリアリング回避回数='$b:w31a_クリアリング回避回数
		#endif

		// ０も１も中身は一緒
		command セットクリアリング \
			-i	d:C_R0:先頭兵ルート, \
				d:C_R0:２番兵ルート, \
			-p	1, d:C_R0:先頭兵ルート, 1, スタンチェック０ \
				1, d:C_R0:先頭兵ルート, 7, クリアリングコース選択 \
				1, d:C_R0:先頭兵ルート, 0,子画面オンオフチェック０ \
				1, d:C_R0:先頭兵ルート, 0,クリアリングカメラ１ \
				1, d:C_R0:先頭兵ルート, 4,クリアリングカメラ２ \
				1, d:C_R0:先頭兵左チェックルート, 0, クリアリングカメラ３ \
				1, d:C_R0:先頭兵右チェックルート, 0, クリアリングカメラ３ \
				1, d:C_R0:先頭兵左チェックルート, 9, クリアリングカメラ４ \
				1, d:C_R0:先頭兵右チェックルート, 6, クリアリングカメラ４

		if ( $f:エマ存在フラグ == 1 ) {
			mesg エマ・エメリッヒ 手繋ぎエマ 徘徊不可能
		}
	}

	proc スタンチェック０ {
		// 規定回数に行くまでおよび、プレイヤーが中にいない、エマが中にいるときはスタン投げを飛ばす
		if ( $b:w31a_クリアリング回避回数 < $w:クリアリングレベルアップ回数 || \
			 $f:w31a_プレイヤークリアリングエリア内にいるフラグ == 0 || \
			 $f:w31a_エマクリアリングエリア内にいるフラグ == 1 ) {
			command チェンジクリアリングルート 敵兵:61 -r d:C_R0:先頭兵ルート -p 3
		}
	}

	proc クリアリングコース選択 {
		// ノーマル以下はプレイヤーがいるほうの重点チェックをしない
		if ( $i:プレイヤー位置Ｘ > 2000 ) {
			if ( $b:w31a_クリアリング回避回数 <= $w:クリアリングレベルアップ回数 || \
				 $w:ゲーム設定 <= d:LEVEL_NORMAL ) {
				command チェンジクリアリングルート 敵兵:61 -r d:C_R0:先頭兵左チェックルート -p 0
			} else {
				command チェンジクリアリングルート 敵兵:61 -r d:C_R0:先頭兵右チェックルート -p 0
			}
		} else {
			if ( $b:w31a_クリアリング回避回数 <= $w:クリアリングレベルアップ回数 || \
				 $w:ゲーム設定 <= d:LEVEL_NORMAL ) {
				command チェンジクリアリングルート 敵兵:61 -r d:C_R0:先頭兵右チェックルート -p 0
			} else {
				command チェンジクリアリングルート 敵兵:61 -r d:C_R0:先頭兵左チェックルート -p 0
			}
		}
	}

	proc クリアリングカメラ１ {
		eval( $f:クリアリング中フラグ = 1 );
		command カメラマップ設定 -chanl 1 -map シェル２中央棟１Ｆ
		chara カメラ設定 クリアリングカメラ \
			-c 1 \	
			-p 8591,3657,-239960 -t 5703,1561,-241261 \
			-r 381,2796,0 -f 3798 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1

		chara カメラ設定 クリアリングカメラ \
			-c 1 \	
			-p 9226,2199,-239753 -t 5927,1054,-241234 \
			-r 200,2797,0 -f 3793 \
			-a 200 \
			-i 0 -1 0 0 \
			-z d:CAMERA_INTERP_CAMERA \ // 補完カメラフラグを指定。
			-interp_time (60*7) \ // 補完時間を指定
			-s 1
	}

	proc クリアリングカメラ２ {
		chara カメラ設定 クリアリングカメラ \
			-c 1 \	
			-p -1660,4856,-243396 -t 2128,1914,-241540 \
			-r 397,727,0 -f 5143 \
			-a 276 \
			-i 0 -1 0 0 \
			-s 1

		chara カメラ設定 クリアリングカメラ \
			-c 1 \	
			-p -2463,3373,-242858 -t 2038,1548,-241193 \
			-r 237,793,0 -f 5134 \
			-a 276 \
			-i 0 -1 0 0 \
			-z d:CAMERA_INTERP_CAMERA \ // 補完カメラフラグを指定。
			-interp_time (60*2) \ // 補完時間を指定
			-s 1
	}

	proc クリアリングカメラ３ {
		if ( $f:w31a_エマクリアリングエリア内にいるフラグ == 1 ) {
			chara カメラ設定 クリアリングカメラ \
				-c 1 \	
				-p -2021,2343,-244085 -t -1488,2202,-243844 \
				-r 154,747,0 -f 602 \
				-a 200 \
				-i 2 -1 0 0 \
				-s 1

			chara カメラ設定 クリアリングカメラ \
				-c 1 \	
				-p -1527,2269,-245658 -t -955,2116,-245580 \
				-r 168,936,0 -f 597 \
				-a 342 \
				-i 0 -1 0 0 \
				-z d:CAMERA_INTERP_CAMERA \ // 補完カメラフラグを指定。
				-interp_time (60*8) \ // 補完時間を指定
				-s 1
		} else {
			if ( $i:プレイヤー位置Ｚ > -239500 ) {
				chara カメラ設定 クリアリングカメラ \
					-c 1 \	
					-p -2446,2903,-244701 -t 993,1460,-241335 \
					-r 190,519,0 -f 5024 \
					-a 287 \
					-i 2 -1 0 0 \
					-s 1

				chara カメラ設定 クリアリングカメラ \
					-c 1 \	
					-p -1885,3320,-244861 -t -849,890,-240587 \
					-r 329,155,0 -f 5025 \
					-a 200 \
					-i 0 -1 0 0 \
					-z d:CAMERA_INTERP_CAMERA \ // 補完カメラフラグを指定。
					-interp_time (60*8) \ // 補完時間を指定
					-s 1
			} else {
				chara カメラ設定 クリアリングカメラ \
					-c 1 \	
					-p -2021,2343,-244085 -t -1488,2202,-243844 \
					-r 154,747,0 -f 602 \
					-a 200 \
					-i 2 -1 0 0 \
					-s 1

				chara カメラ設定 クリアリングカメラ \
					-c 1 \	
					-p -1527,2269,-245658 -t -955,2116,-245580 \
					-r 168,936,0 -f 597 \
					-a 342 \
					-i 0 -1 0 0 \
					-z d:CAMERA_INTERP_CAMERA \ // 補完カメラフラグを指定。
					-interp_time (60*8) \ // 補完時間を指定
					-s 1
			}
		}
	}

	proc クリアリングカメラ４ {
		chara カメラ設定 クリアリングカメラ \
			-c 1 \	
			-p -2499,2039,-239664 -t -1960,1897,-239917 \
			-r 152,1310,0 -f 612 \
			-a 200 \
			-i 2 0 0 0 \
			-s 1
	}


	proc 子画面オンオフチェック０ {
		eval( $f:クリアリング子画面フラグ = 1 );
	}

	// クリアリングが終了したら呼ぶプロック
	//---------------------------------------
	proc クリアリング回避回数処理 {
		if ( $b:w31a_クリアリング回避回数 < 255 ) {
			eval( $b:w31a_クリアリング回避回数 = $b:w31a_クリアリング回避回数 + 1 );
		}
	}

	// すべてのクリアリングのキャンセル＆終了プロック
	//---------------------------------------
	proc クリアリングカメラオフ {
		eval( $f:クリアリング中フラグ = 0 );
		chara カメラ設定 クリアリングカメラ -s -1
		eval( $f:クリアリング子画面フラグ = 0 );
		if ( $f:エマ存在フラグ == 1 ) {
			mesg エマ・エメリッヒ 手繋ぎエマ 徘徊可能
		}

		mesg サブ画面 子画面 off
	}

	// クリアリング子画面チェック
	//---------------------------------------
	proc クリアリング子画面チェック {
		#if d:DEBUG_PRINT 
			print 'clearing_sub_camera_check'
		#endif

		chara プロック連続実行 子画面チェック \
			-time -1 \
			-exec { \
				if ( $f:クリアリング子画面フラグ == 1 ) {
					if ( `command プレイヤー状態取得` & d:PFLAG_INTRUDE ) {

						command ゲットゲームステータス $i:ローカル変数Ｉ２
						if ( $i:ローカル変数Ｉ２ & d:STATE_CLEARING ) {
							mesg サブ画面 子画面 on
						}
					} else {
						mesg サブ画面 子画面 off
					}
				}
			}
	}


	// クリアリングチェック設定
	//---------------------------------------
	proc クリアリングエリアチェック設定 {
		#if d:DEBUG_PRINT 
			print 'clearing_area_check_set'
		#endif

		trap cl001 d:PLAYER \
			-mask ？ \
			-exec {
				if ($3 == 入る) {
					eval( $f:w31a_プレイヤークリアリングエリア内にいるフラグ = 1 );
				} else if ($3 == 出る) {
					eval( $f:w31a_プレイヤークリアリングエリア内にいるフラグ = 0 );
				}
			}

		trap cl001 手繋ぎエマ \
			-mask ？ \
			-exec {
				if ($3 == 入る) {
					eval( $f:w31a_エマクリアリングエリア内にいるフラグ = 1 );
				} else if ($3 == 出る) {
					eval( $f:w31a_エマクリアリングエリア内にいるフラグ = 0 );
				}
			}
	}





