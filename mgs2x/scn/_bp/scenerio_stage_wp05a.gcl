// ------------------------------------
// include
// ------------------------------------
#include "rai_wp05a.mh"		// 強制モーションリスト
#include "stdch.h"
#include "enevoice.h"
#include "a_stdproc.h"			// アナザーミッション設定ファイル
#include "sload.h"
#include "sound.h"
#include "item_info.h"
#include "ene_item.h"
#include "vr_common.h"		// ＶＲステージ共通で使用するプロック
#include "jump.h"

#if d:USB_KEY
	#include "usbkbd.h"
#endif

// ------------------------------------
// マップ設定
// ------------------------------------
chara マップ 武器訓練ハンドガン５面 -k d:KMS_NAME -h d:HZX_NAME,0 -l $s:ＶＲライトファイル名

command マップ設定 武器訓練ハンドガン５面 -set {
	// ローカルの初期化
	// ------------------------------------
	@ローカル変数初期化		// ローカルで使用する変数で初期化をする場合はここで

	// ＶＲで必要な基本プロックのセット(vr_common.hで定義)
	// サウンドの基本パック、ＶＲの基本システム、プレイヤー、ゴール等を設定します
	// ※このプロックを使用する時は「ＶＲクリア時処理」というプロックが必要です
	// ＶＲ共通プロックセット	$:スネークファイル $:雷電ファイル $:クリア条件フラグ
	//							$:ゴールＸ $:ゴールＹ $:ゴールＺ
	//	VR_GOAL_TARGET	/*的全滅でゴールが開く*/
	//	VR_GOAL_FREE	/*ゴールが最初から開いてる*/
	//	VR_GOAL_ENEMY	/*敵全滅でゴールが開く*/
	//	VR_GOAL_SNEAK	/*潜入モード中はゴールが開く*/
	//	VR_GOAL_TIME	/*タイマーがゼロになるとゴールが開く*/
	// ------------------------------------
	@ＶＲ共通プロックセット sna_wp05a rai_wp05a d:VR_GOAL_TARGET 0 4000 -59500

	// カメラ設定
	@カメラセット					// chara カメラとベースのカメラを設定

	// ＶＲウィンドウの設定
	// ------------------------------------
	@武器訓練ハンドガン５面ＶＲウィンドウ設定

//	@ＶＲクリア設定 $:ＮＥＸＴＳＴＡＧＥプロック $:ＴＲＹＡＧＡＩＮプロック $:ＥＸＩＴプロック
	@ＶＲクリア設定 p:load_select p:A_ＲＥＴＲＹプロック

	// ステージに引かれるライン
	// ------------------------------------
	@ＶＲアウトライン d:KMS_NAME d:TONBO_KMS_NAME d:LINE_KMS_NAME

	// 設定値を変更する場合は以下のプロック内で設定
	// ------------------------------------
	@設定値変更				// 敵兵や的のパラメータをステージ限定で変える時はここで
	@プラグイン設定			// プレイヤーのプラグインがいる時はここで

	// 的関係の設定
	// ------------------------------------
	@武器訓練ハンドガン５面ＶＲ標的設定				// ＶＲシステム起動後に呼ぶ

	// ＢＧＭの設定(プレイヤー→敵兵→BGMの順で呼ぶ。的の場合は関係ないがとりあえずここに)
	// ------------------------------------
	@ＢＧＭ設定

	// アイテムの設定
	// ------------------------------------
	@アイテム設定

	// 光源、オブジェクト、カメラ関連の設定
	// ------------------------------------
	@ＶＲフォグ設定 -5000 80000 -25000 80000 -35000 70000
	@武器訓練ハンドガン５面カメラ設定		// ステージ固有のカメラ設定がいる時はこのプロックで
	@ＶＲキャラ用ライト設置					// vr_common.hに定義。必ず最後に設定

#if d:DEBUG_CHARA
//	@デバッグキャラセット
#endif

}

//初期マップの表示
command マップ表示 -show 武器訓練ハンドガン５面


//###################################################################################
//									各proc設定
//###################################################################################



//###################################################################################
//									全マップ共通
//###################################################################################
	// ------------------------------------
	// 全マップ共通
	// ------------------------------------
	// ------------------------------------
	// クリア時の処理
	// ------------------------------------
	proc ＶＲクリア時処理 {
		#if d:DEBUG_PRINT
			print 'clear'
		#endif

		// 強制モーションを発動
		@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_2 2048

		// クリア時にカメラアングルを変える
		chara カメラ設定 カットインカメラ \
			-c 1 \
			//-p 575,5480,-63088 -t 575,5104,-59384 \
			//-r 66,0,0 -f 3723 \
			//-a 200 \
			-p 366,5904,-63152 -t 366,5060,-59198 \
			-r 137,0,0 -f 4043 \
			-a 200 \
			-i 1 1 0 0 \
			-s 1
	}



	// ------------------------------------
	// パラメータ系の変更
	// ------------------------------------
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT
			print 'localvar_init'
		#endif
		
		//	的フラグを初期化する
		eval ($$i:的起動フラグ = 0)
		eval ($$i:的起動フラグＡ = 0)
		eval ($$i:的起動フラグＢ = 0)
		eval ($$i:的起動フラグＣ = 0)

		//	的ステータスを初期化
		eval ($$i:的基本ステータス = 0);
		eval ($$i:的ステータス = 0)
		eval ($$i:的ステータスＡ = 0)
		eval ($$i:的ステータスＢ = 0)
		eval ($$i:的ステータスＣ = 0)

		eval ($$i:的ステータスＤ = 0)
		eval ($$i:的ステータスＥ = 0)
		eval ($$i:的ステータスＦ = 0)
		eval ($$i:的ステータスＧ = 0)

		//	的スピードを初期化
		eval ($$i:的スピード = 0)

		//	的セット数を初期化する
		eval ($$b:的セット数 = 0);

	}
	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT
			print 'status_set'
		#endif

		// 初期装備の設定
		@武器訓練用キャラ別標準装備設定
	}
	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif
	}



//###################################################################################
//									 総合　的設定
//###################################################################################

//////////////////////////
//	基本的プロック
//////////////////////////

	// 移動的プロック
	// ------------------------------------
	proc ＶＲ標的基本設定 \
	$:p_名前 $:p_的ステータス $:p_ルート $:p_ノード $:p_破壊プロック $:p_初期方向 $:p_的スピード {

		//	点滅用処理
		@点滅割り振り設定 $:p_名前

		chara	ＶＲ移動的 $:p_名前 \
			-flag ($$i:的基本ステータス | $:p_的ステータス) \
			-route $:p_ルート $:p_ノード \
			-c $:p_破壊プロック \
			-dir $:p_初期方向 0 \
			-speed $:p_的スピード
	}

	// 子的プロック
	// ------------------------------------
	proc ＶＲ子的基本設定 \
	$:p_名前 $:p_親名前 $:p_的ステータス $:p_破壊プロック $:p_Ｘシフト $:p_Ｙシフト $:p_Ｚシフト $:p_初期方向 {

		//	点滅用処理
		@点滅割り振り設定 $:p_名前

		chara	ＶＲ子的 $:p_名前 \
			-parent $:p_親名前 \
			-flag ($$i:的基本ステータス | $:p_的ステータス) \
			-c $:p_破壊プロック \
			-yshift $:p_Ｘシフト $:p_Ｙシフト $:p_Ｚシフト \
			-dir $:p_初期方向 0 
	}


//////////////////////////
//	点滅割り振り設定
//////////////////////////
	proc 点滅割り振り設定 $:p_名前 {
		//	プリスキンかタキシードスネークは、点滅する
		if( ($s:選択プレイヤー == プリスキン) || \
			($s:選択プレイヤー == タキシードスネーク) ) {
			//	的セット数をカウントする
			$$b:的セット数 = $$b:的セット数 + 1;

			@ハンドガン５面点滅割り振り設定 $:p_名前

		//	そのほかのキャラは点滅しない
		} else {
			eval ($$i:的基本ステータス = $$i:的基本ステータス)
		}

	}

	//	基本点滅割り振り設定
	proc 基本点滅割り振り設定 {
		//	奇数ならば（＝的セット数が割り切れなければ）、消え状態からスタート
		if( $$b:的セット数 % 2 ) {
			eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)

		//	偶数ならば（＝的セット数が割り切れれば）、点き状態からスタート
		} else {
			eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
		}
	}

	//	ハンドガン５面例外措置
	proc ハンドガン５面点滅割り振り設定 $:p_名前 {
		//	プリスキンの場合
		if ($s:選択プレイヤー == プリスキン) {
			if ( ($:p_名前 == 移動的:01) || ($:p_名前 == 移動的:03) ) {
				eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ($:p_名前 == 移動的:02){
				eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)

			//	移動的:11〜移動的:28、移動的:29〜移動的:36、移動的:37〜移動的:44は
			} else if ( ($$b:的セット数 >= 11) && ($$b:的セット数 <= 28) || \
						($$b:的セット数 >= 29) && ($$b:的セット数 <= 36) || \
						($$b:的セット数 >= 37) && ($$b:的セット数 <= 44) ) {
				//	奇数ならば（＝的セット数が割り切れなければ）、点き状態からスタート
				if( $$b:的セット数 % 2 ) {
					eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

				//	偶数ならば（＝的セット数が割り切れれば）、消え状態からスタート
				} else {
					eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
				}

			//	それ以外の的は
			} else {
				@基本点滅割り振り設定
			}

		//	タキシードの場合
		} else {
			//	移動的:01〜移動的:06は
			if ( ($$b:的セット数 >= 1) && ($$b:的セット数 <= 6) ) {
				//	奇数ならば（＝的セット数が割り切れなければ）、点き状態からスタート
				if( $$b:的セット数 % 2 ) {
					eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

				//	偶数ならば（＝的セット数が割り切れれば）、消え状態からスタート
				} else {
					eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
				}

			//	セット１
			} else if ($:p_名前 == 移動的:15) {
					eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ( ($:p_名前 == 移動的:16) || ($:p_名前 == 移動的:17) ) {
					eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)

			//	セット２
			} else if ($:p_名前 == 移動的:18) {
					eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ( ($:p_名前 == 移動的:19) || ($:p_名前 == 移動的:20) ) {
					eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			//	セット３
			} else if ($:p_名前 == 移動的:21) {
					eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ( ($:p_名前 == 移動的:22) || ($:p_名前 == 移動的:23) ) {
					eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)

			//	セット４
			} else if ($:p_名前 == 移動的:24) {
					eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ( ($:p_名前 == 移動的:25) || ($:p_名前 == 移動的:26) ) {
					eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			//	セット５
			} else if ($:p_名前 == 移動的:27) {
					eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ( ($:p_名前 == 移動的:28) || ($:p_名前 == 移動的:29) ) {
					eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)

			//	セット６
			} else if ($:p_名前 == 移動的:30) {
					eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ( ($:p_名前 == 移動的:31) || ($:p_名前 == 移動的:32) ) {
					eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			//	セット７
			} else if ($:p_名前 == 移動的:33) {
					eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ( ($:p_名前 == 移動的:34) || ($:p_名前 == 移動的:35) ) {
					eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)

			//	セット８
			} else if ($:p_名前 == 移動的:36) {
					eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ( ($:p_名前 == 移動的:37) || ($:p_名前 == 移動的:38) ) {
					eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			//	セット９
			} else if ($:p_名前 == 移動的:39) {
					eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)
			} else if ( ($:p_名前 == 移動的:40) || ($:p_名前 == 移動的:41) ) {
					eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)

			//	セット１０
			} else if ($:p_名前 == 移動的:42) {
					eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
			} else if ( ($:p_名前 == 移動的:43) || ($:p_名前 == 移動的:44) ) {
					eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

			//	移動的:45〜移動的:47、移動的:51〜移動的:56は
			} else if ( ($$b:的セット数 >= 45) && ($$b:的セット数 <= 47) || \
						($$b:的セット数 >= 51) && ($$b:的セット数 <= 56) ) {
				//	奇数ならば（＝的セット数が割り切れなければ）、点き状態からスタート
				if( $$b:的セット数 % 2 ) {
					eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

				//	偶数ならば（＝的セット数が割り切れれば）、消え状態からスタート
				} else {
					eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
				}

			//	移動的:57〜移動的:60、移動的:61〜移動的:62、移動的:63〜移動的:66は
			} else if ( ($$b:的セット数 >= 57) && ($$b:的セット数 <= 60) || \
						($$b:的セット数 >= 61) && ($$b:的セット数 <= 62) || \
						($$b:的セット数 >= 63) && ($$b:的セット数 <= 66) ) {
				//	奇数ならば（＝的セット数が割り切れなければ）、点き状態からスタート
				if( $$b:的セット数 % 2 ) {
					eval ($$i:的基本ステータス = d:VR_TRG_VISIBLESTART)

				//	偶数ならば（＝的セット数が割り切れれば）、消え状態からスタート
				} else {
					eval ($$i:的基本ステータス = d:VR_TRG_HIDESTART)
				}

			//	それ以外の的は
			} else {
				@基本点滅割り振り設定
			}
		}

	}



//////////////////////////
//	ハンドガン５面用
//////////////////////////

	//	スタート処理
	// ------------------------------------
	proc 武器訓練ハンドガン５面ＶＲ標的スタート処理 {
		//	ライデンを選択
		if ($s:選択プレイヤー == ライデン) {
			@ライデン的スタート処理

		//	スネークを選択
		} else if ($s:選択プレイヤー == スネーク) {
			@スネーク的スタート処理

		//	プリスキンを選択（ライデンとコンパチ）
		} else if ($s:選択プレイヤー == プリスキン) {
			@ライデン的スタート処理

		//	タキシードスネークを選択（スネークとコンパチ）
		} else if ($s:選択プレイヤー == タキシードスネーク) {
			@スネーク的スタート処理

		//	前作スネークを選択
		} else if ($s:選択プレイヤー == 前作スネーク) {
			@前作スネーク的スタート処理
		}

	}

	// 破壊時処理
	// ------------------------------------
	proc 武器訓練ハンドガン５面ＶＲ標的破壊処理 {
		//	ライデンを選択
		if ($s:選択プレイヤー == ライデン) {
			@ライデン的破壊処理 $1

		//	スネークを選択
		} else if ($s:選択プレイヤー == スネーク) {
			@スネーク的破壊処理 $1

		//	プリスキンを選択（ライデンとコンパチ）
		} else if ($s:選択プレイヤー == プリスキン) {
			@ライデン的破壊処理 $1

		//	タキシードスネークを選択（スネークとコンパチ）
		} else if ($s:選択プレイヤー == タキシードスネーク) {
			@スネーク的破壊処理 $1

		//	前作スネークを選択
		} else if ($s:選択プレイヤー == 前作スネーク) {
			@前作スネーク的破壊処理 $1
		}

	}

	// 的配置
	// ------------------------------------
	proc 武器訓練ハンドガン５面ＶＲ標的設定 {
		eval ($$i:的ステータス = ($$i:的ステータス | d:VR_TRG_NORMAL | d:VR_TRG_WAIT | d:VR_TRG_NO_GHOST) )					//	ノーマル的
		eval ($$i:的ステータスＡ = ($$i:的ステータスＡ | d:VR_TRG_ONE_TRI | d:VR_TRG_WAIT | d:VR_TRG_NO_GHOST) )			//	部位無し的

		eval ($$i:的ステータスＢ = ($$i:的ステータス | d:VR_TRG_NO_APPEAR_EF) )								//	ノーマル的出現エフェクトオフ
		eval ($$i:的ステータスＣ = ($$i:的ステータスＡ | d:VR_TRG_NO_APPEAR_EF) )							//	部位無し的出現エフェクトオフ

		//	子的が動く場合
		eval ($$i:的ステータスＤ = ($$i:的ステータスＤ | d:VR_TRG_NORMAL | d:VR_TRG_WAIT) )					//	ノーマル的付属子的動く場合
		eval ($$i:的ステータスＥ = ($$i:的ステータスＥ | d:VR_TRG_ONE_TRI | d:VR_TRG_WAIT) )				//	部位無し的付属子的動く場合

		eval ($$i:的ステータスＦ = ($$i:的ステータスＤ | d:VR_TRG_NO_APPEAR_EF) )			//	ノーマル的付属子的動く場合出現エフェクトオフ
		eval ($$i:的ステータスＧ = ($$i:的ステータスＥ | d:VR_TRG_NO_APPEAR_EF) )			//	部位無し的付属子的動く場合出現エフェクトオフ

		eval ($$i:的スピード = 20)

//	Ｘボックスでは、爆発が重いので、
#ifdef d:XBOX
		//	爆発が重いので
		command セットＶＲステータス d:VR_LOW_BLAST_EF
#endif

		//	ライデンを選択
		if ($s:選択プレイヤー == ライデン) {
			@ライデン的設定

		//	スネークを選択
		} else if ($s:選択プレイヤー == スネーク) {
			@スネーク的設定

		//	プリスキンを選択（ライデンとコンパチ）
		} else if ($s:選択プレイヤー == プリスキン) {
			@ライデン的設定

		//	タキシードスネークを選択（スネークとコンパチ）
		} else if ($s:選択プレイヤー == タキシードスネーク) {
			@スネーク的設定

		//	前作スネークを選択
		} else if ($s:選択プレイヤー == 前作スネーク) {
			//	爆発が重いので
			command セットＶＲステータス d:VR_LOW_BLAST_EF

			@前作スネーク的設定
		}

	}



//###################################################################################
//									 ライデン　的設定
//###################################################################################

	//	スタート処理
	proc ライデン的スタート処理 {
		mesg ＶＲ的共通 移動的:01 移動開始
		mesg ＶＲ的共通 移動的:02 移動開始
		mesg ＶＲ的共通 移動的:03 移動開始
	}

	//	破壊時処理
	proc ライデン的破壊処理 {
		//	スタート地点の的が全て破壊されたら
		if ( ($1 == 移動的:01) || ($1 == 移動的:02) || ($1 == 移動的:03) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 3) {
				//	ルーム１
				mesg ＶＲ的共通  移動的:04 移動開始
				mesg ＶＲ的共通  移動的:05 移動開始
				mesg ＶＲ的共通  移動的:06 移動開始

				eval ($$i:的起動フラグ = 0)
			}

		//	ルーム１の的が全て破壊されたら
		} else if ( ($1 == 移動的:04) || ($1 == 移動的:05) || ($1 == 移動的:06) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 3) {
				//	ルーム２手前
				mesg ＶＲ的共通  移動的:07 移動開始
				mesg ＶＲ的共通  移動的:08 移動開始
				mesg ＶＲ的共通  移動的:09 移動開始
				mesg ＶＲ的共通  移動的:10 移動開始

				//	ルーム２奥
				mesg ＶＲ的共通  移動的:11 移動開始
				mesg ＶＲ的共通  移動的:12 移動開始
				mesg ＶＲ的共通  移動的:13 移動開始
				mesg ＶＲ的共通  移動的:14 移動開始
				mesg ＶＲ的共通  移動的:15 移動開始
				mesg ＶＲ的共通  移動的:16 移動開始
				mesg ＶＲ的共通  移動的:17 移動開始
				mesg ＶＲ的共通  移動的:18 移動開始
				mesg ＶＲ的共通  移動的:19 移動開始
				mesg ＶＲ的共通  移動的:20 移動開始
				mesg ＶＲ的共通  移動的:21 移動開始
				mesg ＶＲ的共通  移動的:22 移動開始
				mesg ＶＲ的共通  移動的:23 移動開始
				mesg ＶＲ的共通  移動的:24 移動開始
				mesg ＶＲ的共通  移動的:25 移動開始
				mesg ＶＲ的共通  移動的:26 移動開始
				mesg ＶＲ的共通  移動的:27 移動開始
				mesg ＶＲ的共通  移動的:28 移動開始

				eval ($$i:的起動フラグ = 0)
			}

		//	ルーム２の手前的が全て破壊されたら
		} else if (	($1 == 移動的:07) || ($1 == 移動的:08) || ($1 == 移動的:09) || \
					($1 == 移動的:10) ) {
			eval ($$i:的起動フラグＡ = $$i:的起動フラグＡ + 1)
			if ($$i:的起動フラグＡ == 4) {

				//	ルーム２外周
				mesg ＶＲ的共通  移動的:29 移動開始
				mesg ＶＲ的共通  移動的:30 移動開始

				mesg ＶＲ的共通  移動的:31 移動開始
				mesg ＶＲ的共通  移動的:32 移動開始

				mesg ＶＲ的共通  移動的:33 移動開始
				mesg ＶＲ的共通  移動的:34 移動開始

				mesg ＶＲ的共通  移動的:35 移動開始

				mesg ＶＲ的共通  移動的:36 移動開始

				eval ($$i:的起動フラグＡ = 0)
			}

		//	ルーム２の奥、外周的が全て破壊されたら
		} else if ( ($1 == 移動的:11) || ($1 == 移動的:12) || ($1 == 移動的:13) || \
					($1 == 移動的:14) || ($1 == 移動的:15) || ($1 == 移動的:16) || \
					($1 == 移動的:17) || ($1 == 移動的:18) || ($1 == 移動的:19) || \
					($1 == 移動的:20) || ($1 == 移動的:21) || ($1 == 移動的:22) || \
					($1 == 移動的:23) || ($1 == 移動的:24) || ($1 == 移動的:25) || \
					($1 == 移動的:26) || ($1 == 移動的:27) || ($1 == 移動的:28) || \
					($1 == 移動的:29) || ($1 == 移動的:30) || ($1 == 移動的:31) || \
					($1 == 移動的:32) || ($1 == 移動的:33) || ($1 == 移動的:34) || \
					($1 == 移動的:35) || ($1 == 移動的:36) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 26) {
			//	ルーム３の１番手前の左右的
				mesg ＶＲ的共通  移動的:37 移動開始
				mesg ＶＲ的共通  移動的:38 移動開始		/*	NG	*/

				eval ($$i:的起動フラグ = 0)
			}

		//	ルーム３の一番手前の左右的が破壊されたら
		} else if ($1 == 移動的:37) {
			//	ルーム３の２番目の上下的
			mesg ＶＲ的共通  移動的:39 移動開始
			mesg ＶＲ的共通  移動的:40 移動開始		/*	NG	*/

			mesg ＶＲ的共通  移動的:38 消滅

		//	ルーム３の２番目の上下的が破壊されたら
		} else if ($1 == 移動的:39) {
			//	ルーム３の３番目の左右的
			mesg ＶＲ的共通  移動的:41 移動開始		/*	NG	*/
			mesg ＶＲ的共通  移動的:42 移動開始

			mesg ＶＲ的共通  移動的:40 消滅

		//	ルーム３の左右的が破壊されたら
		} else if ($1 == 移動的:42) {
			//	ルーム３の最後の上下的
			mesg ＶＲ的共通  移動的:43 移動開始		/*	NG	*/
			mesg ＶＲ的共通  移動的:44 移動開始

			mesg ＶＲ的共通  移動的:41 消滅

		//	ルーム３の最後の上下的が破壊されたら
		} else if ($1 == 移動的:44) {
			mesg ＶＲ的共通  移動的:43 消滅
		}

	}

	//	的配置
	proc ライデン的設定 {

	//	@ＶＲ標的基本設定 \
	//	$:p_名前 $:p_的ステータス $:p_ルート $:p_ノード $:p_破壊プロック $:p_初期方向 $:p_的スピード

		//	スタート地点
		@ＶＲ標的基本設定 \
		移動的:01 $$i:的ステータス d:５面的ルート:移開始＿２ 0 p:武器訓練ハンドガン５面ＶＲ標的破壊処理 0 0
		@ＶＲ標的基本設定 \
		移動的:02 $$i:的ステータス d:５面的ルート:移開始＿３ 0 p:武器訓練ハンドガン５面ＶＲ標的破壊処理 0 0
		@ＶＲ標的基本設定 \
