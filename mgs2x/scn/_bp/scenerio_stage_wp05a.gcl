	//	スタート処理
	proc 前作スネーク的スタート処理 {
		mesg ＶＲ的共通 移動的:01 移動開始
		mesg ＶＲ的共通 移動的:02 移動開始
		mesg ＶＲ的共通 移動的:03 移動開始
		mesg ＶＲ的共通 移動的:04 移動開始
		mesg ＶＲ的共通 移動的:05 移動開始
		mesg ＶＲ的共通 移動的:06 移動開始
		mesg ＶＲ的共通 移動的:07 移動開始
		mesg ＶＲ的共通 移動的:08 移動開始
	}

	//	破壊時処理
	proc 前作スネーク的破壊処理 {
		//	スタート地点の的が全て破壊されたら
		if (	($1 == 移動的:01) || ($1 == 移動的:02) || ($1 == 移動的:03) || \
				($1 == 移動的:04) || ($1 == 移動的:05) || ($1 == 移動的:06) || \
				($1 == 移動的:07) || ($1 == 移動的:08) ) {

			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 8) {
				//	ルーム１
				mesg ＶＲ的共通  移動的:09 移動開始
				mesg ＶＲ的共通  移動的:10 移動開始
				mesg ＶＲ的共通  移動的:11 移動開始

				eval ($$i:的起動フラグ = 0)
			}

		//	ルーム１の的が全て破壊されたら
		} else if ( ($1 == 移動的:09) || ($1 == 移動的:10) || ($1 == 移動的:11) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 3) {
				//	ルーム２手前
				mesg ＶＲ的共通  移動的:12 移動開始
				mesg ＶＲ的共通  移動的:13 移動開始
				mesg ＶＲ的共通  移動的:14 移動開始

				mesg ＶＲ的共通  移動的:15 移動開始
				mesg ＶＲ的共通  移動的:16 移動開始

				mesg ＶＲ的共通  移動的:17 移動開始
				mesg ＶＲ的共通  移動的:18 移動開始

				eval ($$i:的起動フラグ = 0)
			}

		//	ルーム２手前の中央的が全て破壊されたら
		} else if ( ($1 == 移動的:12) || ($1 == 移動的:13) || ($1 == 移動的:14) ) {
			eval ($$i:的起動フラグＡ = $$i:的起動フラグＡ + 1)
			if ($$i:的起動フラグＡ == 3) {
				//	ルーム２奥中央
				mesg ＶＲ的共通 移動的:19 移動開始
				mesg ＶＲ的共通 移動的:20 移動開始
				mesg ＶＲ的共通 移動的:21 移動開始

				mesg ＶＲ的共通 移動的:22 移動開始
				mesg ＶＲ的共通 移動的:23 移動開始
				mesg ＶＲ的共通 移動的:24 移動開始

				eval ($$i:的起動フラグＡ = 0)
			}

		//	ルーム２手前の左的が全て破壊されたら
		} else if ( ($1 == 移動的:15) || ($1 == 移動的:16) ) {
			eval ($$i:的起動フラグＢ = $$i:的起動フラグＢ + 1)
			if ($$i:的起動フラグＢ == 2) {
				//	ルーム２奥左
				mesg ＶＲ的共通 移動的:25 移動開始
				mesg ＶＲ的共通 移動的:26 移動開始
				mesg ＶＲ的共通 移動的:27 移動開始

				mesg ＶＲ的共通 移動的:28 移動開始
				mesg ＶＲ的共通 移動的:29 移動開始
				mesg ＶＲ的共通 移動的:30 移動開始

				mesg ＶＲ的共通 移動的:31 移動開始
				mesg ＶＲ的共通 移動的:32 移動開始
				mesg ＶＲ的共通 移動的:33 移動開始

				eval ($$i:的起動フラグＢ = 0)
			}

		//	ルーム２手前の右的が全て破壊されたら
		} else if ( ($1 == 移動的:17) || ($1 == 移動的:18) ) {
			eval ($$i:的起動フラグＣ = $$i:的起動フラグＣ + 1)
			if ($$i:的起動フラグＣ == 2) {
				//	ルーム２奥右
				mesg ＶＲ的共通 移動的:34 移動開始
				mesg ＶＲ的共通 移動的:35 移動開始
				mesg ＶＲ的共通 移動的:36 移動開始

				mesg ＶＲ的共通 移動的:37 移動開始
				mesg ＶＲ的共通 移動的:38 移動開始
				mesg ＶＲ的共通 移動的:39 移動開始

				mesg ＶＲ的共通 移動的:40 移動開始
				mesg ＶＲ的共通 移動的:41 移動開始
				mesg ＶＲ的共通 移動的:42 移動開始

				eval ($$i:的起動フラグＣ = 0)
			}

		//	ルーム２の奥の的が全て破壊されたら
		} else if ( ($1 == 移動的:19) || ($1 == 移動的:20) || ($1 == 移動的:21) || \
					($1 == 移動的:22) || ($1 == 移動的:23) || ($1 == 移動的:24) || \
					($1 == 移動的:25) || ($1 == 移動的:26) || ($1 == 移動的:27) || \
					($1 == 移動的:28) || ($1 == 移動的:29) || ($1 == 移動的:30) || \
					($1 == 移動的:31) || ($1 == 移動的:32) || ($1 == 移動的:33) || \
					($1 == 移動的:34) || ($1 == 移動的:35) || ($1 == 移動的:36) || \
					($1 == 移動的:37) || ($1 == 移動的:38) || ($1 == 移動的:39) || \
					($1 == 移動的:40) || ($1 == 移動的:41) || ($1 == 移動的:42) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 24) {
				//	ルーム２外周
				mesg ＶＲ的共通 移動的:43 移動開始
				mesg ＶＲ的共通 移動的:44 移動開始
				mesg ＶＲ的共通 移動的:45 移動開始
				mesg ＶＲ的共通 移動的:46 移動開始
				mesg ＶＲ的共通 移動的:47 移動開始
				mesg ＶＲ的共通 移動的:48 移動開始

				mesg ＶＲ的共通 移動的:49 移動開始
				mesg ＶＲ的共通 移動的:50 移動開始

				mesg ＶＲ的共通 移動的:51 移動開始
				mesg ＶＲ的共通 移動的:52 移動開始
				mesg ＶＲ的共通 移動的:53 移動開始
				mesg ＶＲ的共通 移動的:54 移動開始
				mesg ＶＲ的共通 移動的:55 移動開始
				mesg ＶＲ的共通 移動的:56 移動開始
				mesg ＶＲ的共通 移動的:57 移動開始
				mesg ＶＲ的共通 移動的:58 移動開始
				mesg ＶＲ的共通 移動的:59 移動開始
				mesg ＶＲ的共通 移動的:60 移動開始

				mesg ＶＲ的共通 移動的:61 移動開始
				mesg ＶＲ的共通 移動的:62 移動開始

				mesg ＶＲ的共通 移動的:63 移動開始
				mesg ＶＲ的共通 移動的:64 移動開始
				mesg ＶＲ的共通 移動的:65 移動開始
				mesg ＶＲ的共通 移動的:66 移動開始
				mesg ＶＲ的共通 移動的:67 移動開始
				mesg ＶＲ的共通 移動的:68 移動開始
				mesg ＶＲ的共通 移動的:69 移動開始
				mesg ＶＲ的共通 移動的:70 移動開始

				mesg ＶＲ的共通 移動的:71 移動開始
				mesg ＶＲ的共通 移動的:72 移動開始
				mesg ＶＲ的共通 移動的:73 移動開始

				mesg ＶＲ的共通 移動的:74 移動開始
				mesg ＶＲ的共通 移動的:75 移動開始
				mesg ＶＲ的共通 移動的:76 移動開始

				mesg ＶＲ的共通 移動的:77 移動開始
				mesg ＶＲ的共通 移動的:78 移動開始
				mesg ＶＲ的共通 移動的:79 移動開始

				mesg ＶＲ的共通 移動的:80 移動開始
				mesg ＶＲ的共通 移動的:81 移動開始
				mesg ＶＲ的共通 移動的:82 移動開始

				eval ($$i:的起動フラグ = 0)
			}

		//	ルーム２の外周的が全て破壊されたら
		} else if ( ($1 == 移動的:43) || ($1 == 移動的:44) || ($1 == 移動的:45) || \
					($1 == 移動的:46) || ($1 == 移動的:47) || ($1 == 移動的:48) || \
					($1 == 移動的:49) || ($1 == 移動的:50) || ($1 == 移動的:51) || \
					($1 == 移動的:52) || ($1 == 移動的:53) || ($1 == 移動的:54) || \
					($1 == 移動的:55) || ($1 == 移動的:56) || ($1 == 移動的:57) || \
					($1 == 移動的:58) || ($1 == 移動的:59) || ($1 == 移動的:60) || \
					($1 == 移動的:61) || ($1 == 移動的:62) || ($1 == 移動的:63) || \
					($1 == 移動的:64) || ($1 == 移動的:65) || ($1 == 移動的:66) || \
					($1 == 移動的:67) || ($1 == 移動的:68) || ($1 == 移動的:69) || \
					($1 == 移動的:70) || ($1 == 移動的:71) || ($1 == 移動的:72) || \
					($1 == 移動的:73) || ($1 == 移動的:74) || ($1 == 移動的:75) || \
					($1 == 移動的:76) || ($1 == 移動的:77) || ($1 == 移動的:78) || \
					($1 == 移動的:79) || ($1 == 移動的:80) || ($1 == 移動的:81) || \
					($1 == 移動的:82) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 40) {
				//	ルーム３左右的
				mesg ＶＲ的共通 移動的:83 移動開始	/*	NG	*/
				mesg ＶＲ的共通 移動的:84 移動開始
				mesg ＶＲ的共通 移動的:85 移動開始	/*	NG	*/
				mesg ＶＲ的共通 移動的:86 移動開始	/*	NG	*/
				
				eval ($$i:的起動フラグ = 0)
			}

		//	ルーム３の左右的が破壊されたら
		} else if ($1 == 移動的:84) {
			//	ルーム３上下的
			mesg ＶＲ的共通 移動的:87 移動開始
			mesg ＶＲ的共通 移動的:88 移動開始	/*	NG	*/
	
			mesg ＶＲ的共通 移動的:83 消滅
			mesg ＶＲ的共通 移動的:85 消滅
			mesg ＶＲ的共通 移動的:86 消滅
				
		//	ルーム３の上下的が破壊されたら
		} else if ($1 == 移動的:87) {
			//	ルーム３左右的
			mesg ＶＲ的共通 移動的:89 移動開始	/*	NG	*/
			mesg ＶＲ的共通 移動的:90 移動開始
			mesg ＶＲ的共通 移動的:91 移動開始
			mesg ＶＲ的共通 移動的:92 移動開始	/*	NG	*/
				
			mesg ＶＲ的共通 移動的:88 消滅

		//	ルーム３の左右的が破壊されたら
		} else if ( ($1 == 移動的:90) || ($1 == 移動的:91) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 2) {
				//	ルーム３上下的
				mesg ＶＲ的共通 移動的:93 移動開始
				mesg ＶＲ的共通 移動的:94 移動開始

				mesg ＶＲ的共通 移動的:89 消滅
				mesg ＶＲ的共通 移動的:92 消滅

				eval ($$i:的起動フラグ = 0)
			}

		}

	}

	//	的配置
	proc 前作スネーク的設定 {

	//	@ＶＲ標的基本設定 \
	//	$:p_名前 $:p_的ステータス $:p_ルート $:p_ノード $:p_破壊プロック $:p_初期方向 $:p_的スピード

		//	スタート地点
		@ＶＲ標的基本設定 \
		移動的:01 $$i:的ステータス d:５面的ルート:移開始＿０ 0 p:武器訓練ハンドガン５面ＶＲ標的破壊処理 512 0
		@ＶＲ標的基本設定 \
		移動的:02 $$i:的ステータス d:５面的ルート:移開始＿６ 0 p:武器訓練ハンドガン５面ＶＲ標的破壊処理 512 0
		@ＶＲ標的基本設定 \
		移動的:03 $$i:的ステータス d:５面的ルート:移開始＿７ 0 p:武器訓練ハンドガン５面ＶＲ標的破壊処理 512 0
		@ＶＲ標的基本設定 \
		移動的:04 $$i:的ステータス d:５面的ルート:移開始＿２ 0 p:武器訓練ハンドガン５面ＶＲ標的破壊処理 0 0
		@ＶＲ標的基本設定 \
		移動的:05 $$i:的ステータス d:５面的ルート:移開始＿８ 0 p:武器訓練ハンドガン５面ＶＲ標的破壊処理 0 0
		@ＶＲ標的基本設定 \
		移動的:06 $$i:的ステータス d:５面的ルート:移開始＿９ 0 p:武器訓練ハンドガン５面ＶＲ標的破壊処理 0 0
		@ＶＲ標的基本設定 \
		移動的:07 $$i:的ステータス d:５面的ルート:移開始＿４ 0 p:武器訓練ハンドガン５面ＶＲ標的破壊処理 3584 0
		@ＶＲ標的基本設定 \
		移動的:08 $$i:的ステータス d:５面的ルート:移開始＿５ 0 p:武器訓練ハンドガン５面ＶＲ標的破壊処理 3584 0

		//	ルーム１
		@ＶＲ標的基本設定 \
