				//	左
		@ＶＲ標的基本設定 \
		移動的:09 $$i:的ステータス d:５面的ルート:移部屋２前左＿１ 1 p:武器訓練ハンドガン５面ＶＲ標的破壊処理 0 $$i:的スピード

				//	右
		@ＶＲ標的基本設定 \
		移動的:10 $$i:的ステータス d:５面的ルート:移部屋２前右＿１ 1 p:武器訓練ハンドガン５面ＶＲ標的破壊処理 0 $$i:的スピード

	//	@ＶＲ子的基本設定 \
	//	$:p_名前 $:p_親名前 $:p_的ステータス $:p_破壊プロック $:p_Ｘシフト $:p_Ｙシフト $:p_Ｚシフト $:p_初期方向

			//	奥
				//	中央
		@ＶＲ標的基本設定 \
		移動的:11 $$i:的ステータスＦ d:５面的ルート:移部屋２奥中新＿０ 0 p:武器訓練ハンドガン５面ＶＲ標的破壊処理 0 $$i:的スピード
		@ＶＲ子的基本設定 \
		移動的:12 移動的:11 ($$i:的ステータスＦ | d:VR_TRG_BLAST) p:武器訓練ハンドガン５面ＶＲ標的破壊処理 -1000 0 0 0
		@ＶＲ子的基本設定 \
		移動的:13 移動的:12 $$i:的ステータスＢ p:武器訓練ハンドガン５面ＶＲ標的破壊処理 -1000 0 0 0

		@ＶＲ標的基本設定 \
		移動的:14 ($$i:的ステータスＦ | d:VR_TRG_BLAST) d:５面的ルート:移部屋２奥中新＿１ 0 p:武器訓練ハンドガン５面ＶＲ標的破壊処理 0 $$i:的スピード
		@ＶＲ子的基本設定 \
		移動的:15 移動的:14 $$i:的ステータスＦ p:武器訓練ハンドガン５面ＶＲ標的破壊処理 -1000 0 0 0
		@ＶＲ子的基本設定 \
		移動的:16 移動的:15 ($$i:的ステータスＢ | d:VR_TRG_BLAST) p:武器訓練ハンドガン５面ＶＲ標的破壊処理 -1000 0 0 0

		@ＶＲ標的基本設定 \
		移動的:17 ($$i:的ステータスＦ | d:VR_TRG_BLAST) d:５面的ルート:移部屋２奥中新＿２ 0 p:武器訓練ハンドガン５面ＶＲ標的破壊処理 0 $$i:的スピード
		@ＶＲ子的基本設定 \
		移動的:18 移動的:17 $$i:的ステータスＦ p:武器訓練ハンドガン５面ＶＲ標的破壊処理 1000 0 0 0
		@ＶＲ子的基本設定 \
		移動的:19 移動的:18 ($$i:的ステータスＢ | d:VR_TRG_BLAST) p:武器訓練ハンドガン５面ＶＲ標的破壊処理 1000 0 0 0

		@ＶＲ標的基本設定 \
		移動的:20 $$i:的ステータスＦ d:５面的ルート:移部屋２奥中新＿３ 0 p:武器訓練ハンドガン５面ＶＲ標的破壊処理 0 $$i:的スピード
		@ＶＲ子的基本設定 \
		移動的:21 移動的:20 ($$i:的ステータスＦ | d:VR_TRG_BLAST) p:武器訓練ハンドガン５面ＶＲ標的破壊処理 1000 0 0 0
		@ＶＲ子的基本設定 \
		移動的:22 移動的:21 $$i:的ステータスＢ p:武器訓練ハンドガン５面ＶＲ標的破壊処理 1000 0 0 0

				//	左
		@ＶＲ標的基本設定 \
		移動的:23 $$i:的ステータスＦ d:５面的ルート:移部屋２奥左新＿３ 0 p:武器訓練ハンドガン５面ＶＲ標的破壊処理 0 $$i:的スピード
		@ＶＲ子的基本設定 \
		移動的:24 移動的:23 ($$i:的ステータスＦ | d:VR_TRG_BLAST) p:武器訓練ハンドガン５面ＶＲ標的破壊処理 -1000 0 0 0
		@ＶＲ子的基本設定 \
		移動的:25 移動的:24 $$i:的ステータスＢ p:武器訓練ハンドガン５面ＶＲ標的破壊処理 -1000 0 0 0

				//	右
		@ＶＲ標的基本設定 \
		移動的:26 $$i:的ステータスＦ d:５面的ルート:移部屋２奥右新＿３ 0 p:武器訓練ハンドガン５面ＶＲ標的破壊処理 0 $$i:的スピード
		@ＶＲ子的基本設定 \
		移動的:27 移動的:26 ($$i:的ステータスＦ | d:VR_TRG_BLAST) p:武器訓練ハンドガン５面ＶＲ標的破壊処理 1000 0 0 0
		@ＶＲ子的基本設定 \
		移動的:28 移動的:27 $$i:的ステータスＢ p:武器訓練ハンドガン５面ＶＲ標的破壊処理 1000 0 0 0

			//	外周
		@ＶＲ標的基本設定 \
		移動的:29 $$i:的ステータスＡ d:５面的ルート:移部屋２外追＿１２ 0 p:武器訓練ハンドガン５面ＶＲ標的破壊処理 3072 0
		@ＶＲ標的基本設定 \
		移動的:30 $$i:的ステータスＡ d:５面的ルート:移部屋２外追＿１４ 0 p:武器訓練ハンドガン５面ＶＲ標的破壊処理 3072 0
		@ＶＲ標的基本設定 \
		移動的:31 $$i:的ステータスＡ d:５面的ルート:移部屋２外追＿１５ 0 p:武器訓練ハンドガン５面ＶＲ標的破壊処理 0 0
		@ＶＲ標的基本設定 \
		移動的:32 $$i:的ステータスＡ d:５面的ルート:移部屋２外追＿１７ 0 p:武器訓練ハンドガン５面ＶＲ標的破壊処理 0 0
		@ＶＲ標的基本設定 \
		移動的:33 $$i:的ステータスＡ d:５面的ルート:移部屋２外追＿１８ 0 p:武器訓練ハンドガン５面ＶＲ標的破壊処理 1024 0
		@ＶＲ標的基本設定 \
		移動的:34 $$i:的ステータスＡ d:５面的ルート:移部屋２外追＿８ 0 p:武器訓練ハンドガン５面ＶＲ標的破壊処理 1024 0
		@ＶＲ標的基本設定 \
		移動的:35 $$i:的ステータスＡ d:５面的ルート:移部屋２外追＿１０ 0 p:武器訓練ハンドガン５面ＶＲ標的破壊処理 0 0

		@ＶＲ標的基本設定 \
		移動的:36 $$i:的ステータスＡ d:５面的ルート:移部屋２外＿６ 0 p:武器訓練ハンドガン５面ＶＲ標的破壊処理 0 0

		//	ルーム３
			//	左右
		@ＶＲ標的基本設定 \
		移動的:37 $$i:的ステータスＡ d:５面的ルート:移部屋３左＿０ 0 p:武器訓練ハンドガン５面ＶＲ標的破壊処理 0 ($$i:的スピード + 30)
		@ＶＲ標的基本設定 \
		移動的:38 ($$i:的ステータスＡ | d:VR_TRG_NG) d:５面的ルート:移部屋３右＿０ 0 p:武器訓練ハンドガン５面ＶＲ標的破壊処理 0 ($$i:的スピード + 30)

			//	下上
		@ＶＲ標的基本設定 \
		移動的:39 $$i:的ステータスＡ d:５面的ルート:移部屋３穴＿１ 0 p:武器訓練ハンドガン５面ＶＲ標的破壊処理 0 ($$i:的スピード + 30)
		@ＶＲ標的基本設定 \
		移動的:40 ($$i:的ステータスＡ | d:VR_TRG_NG) d:５面的ルート:移部屋３空＿１ 0 p:武器訓練ハンドガン５面ＶＲ標的破壊処理 0 ($$i:的スピード + 30)

			//	左右
		@ＶＲ標的基本設定 \
		移動的:41 ($$i:的ステータスＡ | d:VR_TRG_NG) d:５面的ルート:移部屋３左＿９ 0 p:武器訓練ハンドガン５面ＶＲ標的破壊処理 0 ($$i:的スピード + 30)
		@ＶＲ標的基本設定 \
		移動的:42 $$i:的ステータスＡ d:５面的ルート:移部屋３右＿９ 0 p:武器訓練ハンドガン５面ＶＲ標的破壊処理 0 ($$i:的スピード + 30)

			//	下上
		@ＶＲ標的基本設定 \
		移動的:43 ($$i:的ステータスＡ | d:VR_TRG_NG) d:５面的ルート:移部屋３穴＿４ 0 p:武器訓練ハンドガン５面ＶＲ標的破壊処理 0 ($$i:的スピード + 30)
		@ＶＲ標的基本設定 \
		移動的:44 $$i:的ステータスＡ d:５面的ルート:移部屋３空＿４ 0 p:武器訓練ハンドガン５面ＶＲ標的破壊処理 0 ($$i:的スピード + 30)
	}



//###################################################################################
//									 スネーク　的設定
//###################################################################################

	//	スタート処理
	proc スネーク的スタート処理 {
		mesg ＶＲ的共通 移動的:01 移動開始
		mesg ＶＲ的共通 移動的:02 移動開始
		mesg ＶＲ的共通 移動的:03 移動開始
		mesg ＶＲ的共通 移動的:04 移動開始
		mesg ＶＲ的共通 移動的:05 移動開始
		mesg ＶＲ的共通 移動的:06 移動開始
	}

	//	破壊時処理
	proc スネーク的破壊処理 {
		//	スタート地点の的が全て破壊されたら
		if (	($1 == 移動的:01) || ($1 == 移動的:02) || ($1 == 移動的:03) || \
				($1 == 移動的:04) || ($1 == 移動的:05) || ($1 == 移動的:06) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 6) {
				//	ルーム１
				mesg ＶＲ的共通  移動的:07 移動開始
				mesg ＶＲ的共通  移動的:08 移動開始

				eval ($$i:的起動フラグ = 0)
			}

		//	ルーム１の的が全て破壊されたら
		} else if ( ($1 == 移動的:07) || ($1 == 移動的:08) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 2) {
				//	ルーム２手前
				mesg ＶＲ的共通  移動的:09 移動開始
				mesg ＶＲ的共通  移動的:10 移動開始
				mesg ＶＲ的共通  移動的:11 移動開始
				mesg ＶＲ的共通  移動的:12 移動開始
				mesg ＶＲ的共通  移動的:13 移動開始
				mesg ＶＲ的共通  移動的:14 移動開始

				eval ($$i:的起動フラグ = 0)
			}

		//	ルーム２手前の中央的が全て破壊されたら
		} else if ( ($1 == 移動的:09) || ($1 == 移動的:10) ) {
			eval ($$i:的起動フラグＡ = $$i:的起動フラグＡ + 1)
			if ($$i:的起動フラグＡ == 2) {
				//	ルーム２奥左
				mesg ＶＲ的共通  移動的:15 移動開始
				mesg ＶＲ的共通  移動的:16 移動開始
				mesg ＶＲ的共通  移動的:17 移動開始

				mesg ＶＲ的共通  移動的:18 移動開始
				mesg ＶＲ的共通  移動的:19 移動開始
				mesg ＶＲ的共通  移動的:20 移動開始

				mesg ＶＲ的共通  移動的:21 移動開始
				mesg ＶＲ的共通  移動的:22 移動開始
				mesg ＶＲ的共通  移動的:23 移動開始

				mesg ＶＲ的共通  移動的:24 移動開始
				mesg ＶＲ的共通  移動的:25 移動開始
				mesg ＶＲ的共通  移動的:26 移動開始

				mesg ＶＲ的共通  移動的:27 移動開始
				mesg ＶＲ的共通  移動的:28 移動開始
				mesg ＶＲ的共通  移動的:29 移動開始

				eval ($$i:的起動フラグＡ = 0)
			}
		
		//	ルーム２手前の左的が全て破壊されたら
		} else if ( ($1 == 移動的:11) || ($1 == 移動的:12) ) {
			eval ($$i:的起動フラグＢ = $$i:的起動フラグＢ + 1)
			if ($$i:的起動フラグＢ == 2) {
				//	ルーム２外周
				mesg ＶＲ的共通  移動的:45 移動開始
