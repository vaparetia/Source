		#if d:DEBUG_PRINT
			print 'item_set'
		#endif
	}



//###################################################################################
//									 エフェクト
//###################################################################################

	// ------------------------------------
	// 光源関係
	// ------------------------------------
	// フォグ
	// ------------------------------------
	proc フォグ設定 {
		#if d:DEBUG_PRINT
			print 'fog_set'
		#endif

		chara フォグ 霧\
			-c	180 180 140 \
			-n	-20000 \
			-f	175000
	}
	// キャラ用光源(マップの設置が終わってから設定することで、キャラだけに光を当てる)
	// ------------------------------------
	proc キャラ用ライト設置 {
		#if d:DEBUG_PRINT
			print 'chara_light_set'
		#endif

		chara 環境光 環境光源 \
			 -c 51 63 68

		chara 平行光 平行光源 \
			 -c 44 64 62 \
			 -p 2488 -3705 -2255
	}



//###################################################################################
//									 カメラ
//###################################################################################
	// ------------------------------------
	// カメラ関係の設定
	// ------------------------------------
	// ステージカメラ設定
	// ------------------------------------
	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'chara_camera & stage_camera_set'
		#endif

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0
		chara カメラ メインカメラ		-c 0 -l 2 -p 50
		chara カメラ サブカメラ			-c 0 -l 2 -p 40
		chara カメラ カットインカメラ 	-c 0 -l 0 -p 0

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
//			-r 285,2048,0 \
			-r 295,2048,0 \
			-f 14000 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}
	// ステージ固有のカメラ設定
	// ------------------------------------
	proc 武器訓練ハンドガン５面カメラ設定 {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif

		trap ca001 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 メインカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 285,2048,0 \
					-f 14000 \
					-a 200 \
					-i 2 2 0 0 \
					-s $3
			}

		trap ca002 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 510,2048,0 \
					-f 14000 \
					-a 200 \
					-i 2 2 0 0 \
					-s $3
			}

		trap ca003 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 135,2048,0 \
					-f 5500 \
					-a 200 \
					-i 2 2 0 0 \
					-s $3
			}

	}



//###################################################################################
//									ＶＲウィンドウの設定と表示
//###################################################################################

	//------------------------------------------------------------
	// ＶＲウィンドウの設定と表示
	//------------------------------------------------------------
	proc 武器訓練ハンドガン５面ＶＲウィンドウ設定 {
	#if d:DEBUG_PRINT
		print 'vr_window_set-weapon handgun LEVEL 5'
	#endif

		//	ＶＲウィンドウの設定。各言語のリソースと終了プロックが引数
		//	リソースはvr_window_j.h等で定義(a_stdproc.hでinclude済み)
		//	プロック名を引数にする場合は先頭にp:をつけること！
		@ＶＲウィンドウ設定	\
			[VRMSG_J:VRM_WPN_HGN_wp05a] [VRMSG_E:VRM_WPN_HGN_wp05a] [VRMSG_G:VRM_WPN_HGN_wp05a] \	//	日、英、独
			[VRMSG_F:VRM_WPN_HGN_wp05a] [VRMSG_I:VRM_WPN_HGN_wp05a] [VRMSG_S:VRM_WPN_HGN_wp05a] \	//	仏、伊、西
			[VRMSG_K:VRM_WPN_HGN_wp05a] \												//	韓
			p:武器訓練ハンドガン５面ステージ開始時処理								//	終了プロック

		//	ＶＲウィンドウを表示する(名前はＶＲウィンドウ君で固定)
		mesg ＶＲウィンドウ ＶＲウィンドウ君 開く

		//	スタート時とクリア時に使用するカットインカメラ
		//	自分でカメラを定義する際にはなるべくロード時に起動する
		chara カメラ設定 カットインカメラ \
			-c 1 \
			-p 0,9988,-52052 -t 0,1241,-62981 \
			-r 440,2048,0 -f 13998 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1
	}


	//------------------------------------------------------------
	// ステージ開始時処理(ＶＲウィンドウが閉じた後行う処理)
	//------------------------------------------------------------
	proc 武器訓練ハンドガン５面ステージ開始時処理 {
	#if d:DEBUG_PRINT
		print 'game_start!!!!!'
	#endif

		//	プレイヤーやパッドの制御等を行う a_stdproc.hで定義
		@全ミッション共通ステージ開始時処理

		//	カメラワークスタート(必要な場合)
		//	全体図（補間のフレーム数は全て統一するためdefineで固定）
		chara カメラ設定 カットインカメラ \
			-c 1 \
			-p 0,41451,-17295 -t 0,28620,-22889 \
			-r 756,2048,0 -f 13997 \
			-a 200 \
			-i 4 4 d:START_CAMERA_CHANGE_TIME d:START_CAMERA_CHANGE_TIME \
			-s 1

		chara delay ディレイ \
			-time d:START_CAMERA_CHANGE_TIME \
			-exec {
				//	カメラの補間が終わった直後にステージカメラへ移行する
				chara カメラ設定 カットインカメラ -s -1
			}
	}


	proc ゲーム開始直後処理 {
		//	的をスタートさせる
		@武器訓練ハンドガン５面ＶＲ標的スタート処理
	}



//###################################################################################
//									 その他
//###################################################################################


// -----------------------------------------------------------------------------------
// 以下デバッグ専用proc
// -----------------------------------------------------------------------------------
// デバッグキャラ
// ------------------------------------
proc デバッグキャラセット {
	#if d:DEBUG_PRINT
		print 'debug_chara_set'
	#endif

	#if d:CHARA_CAMERA
		chara キャラカメラ 敵兵カメラ \
			-c d:TARGET_CHARA \
			-s -920,610,200 \
			-r -200,1024,0
	#endif

	#if d:SCREENSHOT
		chara スクリーンショット shot
	#endif

	#if d:USB_KEY
		chara USBキーボード実行 test \
			-e d:KBD_ESC {
				mesg プレイヤー d:PLAYER position -5500, -13000, -500
			} \
	#endif
}

