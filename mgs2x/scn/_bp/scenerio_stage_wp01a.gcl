	//	的配置
	proc スネーク的１面設定 {
	//	@ＶＲ標的基本設定 	\
	//	$:p_名前 $:p_的ステータス $:p_ルート $:p_ノード $:p_破壊プロック $:p_的スピード {

		//	１回目
		@ＶＲ標的基本設定 \
		移動的:01 $$i:的ステータス d:１面的ルート:移＿２ 0 p:武器訓練ハンドガン１面ＶＲ標的破壊処理 $$i:的スピード

		//	２回目
		@ＶＲ標的基本設定 \
		移動的:02 $$i:的ステータス d:１面的ルート:移＿３ 0 p:武器訓練ハンドガン１面ＶＲ標的破壊処理 $$i:的スピード

		//	３回目
