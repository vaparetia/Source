//###################################################################################

//////////////////////////
//	ハンドガン１面用
//////////////////////////

	//	スタート処理
	proc ライデン的１面スタート処理 {
		mesg ＶＲ的共通 移動的:01 移動開始

	}

	//	破壊時処理
	proc ライデン的１面破壊処理 {
		if ($1 == 移動的:01) {
			mesg ＶＲ的共通 移動的:02 移動開始

		} else if ($1 == 移動的:02) {
			mesg ＶＲ的共通 移動的:03 移動開始
			mesg ＶＲ的共通 移動的:04 移動開始

		} else if ( ($1 == 移動的:03) || ($1 == 移動的:04) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 2) {
				mesg ＶＲ的共通 移動的:05 移動開始
				mesg ＶＲ的共通 移動的:06 移動開始
				mesg ＶＲ的共通 移動的:07 移動開始

				eval ($$i:的起動フラグ = 0)
			}

		} else if ( ($1 == 移動的:05) || ($1 == 移動的:06) || ($1 == 移動的:07) ) {
			eval ($$i:的起動フラグ = $$i:的起動フラグ + 1)
			if ($$i:的起動フラグ == 3) {
				mesg ＶＲ的共通 移動的:08 移動開始
				mesg ＶＲ的共通 移動的:09 移動開始
				mesg ＶＲ的共通 移動的:10 移動開始

				eval ($$i:的起動フラグ = 0)
			}

		}

	}

	//	的配置
	proc ライデン的１面設定 {

	//	@ＶＲ標的基本設定 	\
	//	$:p_名前 $:p_的ステータス $:p_ルート $:p_ノード $:p_破壊プロック $:p_的スピード {

		//	１回目
		@ＶＲ標的基本設定 \
		移動的:01 $$i:的ステータス d:１面的ルート:移＿３ 0 p:武器訓練ハンドガン１面ＶＲ標的破壊処理 $$i:的スピード

		//	２回目
		@ＶＲ標的基本設定 \
		移動的:02 $$i:的ステータス d:１面的ルート:移＿２ 0 p:武器訓練ハンドガン１面ＶＲ標的破壊処理 $$i:的スピード

		//	３回目
		@ＶＲ標的基本設定 \
		移動的:03 $$i:的ステータス d:１面的ルート:移＿０ 0 p:武器訓練ハンドガン１面ＶＲ標的破壊処理 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:04 $$i:的ステータス d:１面的ルート:移＿１ 0 p:武器訓練ハンドガン１面ＶＲ標的破壊処理 $$i:的スピード

		//	４回目
		@ＶＲ標的基本設定 \
		移動的:05 $$i:的ステータス d:１面的ルート:移＿６ 0 p:武器訓練ハンドガン１面ＶＲ標的破壊処理 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:06 $$i:的ステータス d:１面的ルート:移＿７ 0 p:武器訓練ハンドガン１面ＶＲ標的破壊処理 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:07 $$i:的ステータス d:１面的ルート:移＿８ 0 p:武器訓練ハンドガン１面ＶＲ標的破壊処理 $$i:的スピード

		//	５回目
		@ＶＲ標的基本設定 \
		移動的:08 $$i:的ステータス d:１面的ルート:移＿１０ 0 p:武器訓練ハンドガン１面ＶＲ標的破壊処理 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:09 $$i:的ステータス d:１面的ルート:移＿１１ 0 p:武器訓練ハンドガン１面ＶＲ標的破壊処理 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:10 $$i:的ステータス d:１面的ルート:移＿１２ 0 p:武器訓練ハンドガン１面ＶＲ標的破壊処理 $$i:的スピード
	}



