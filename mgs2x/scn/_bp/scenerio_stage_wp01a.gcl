	//	スタート処理
	proc ライデン的２面スタート処理 {
		mesg ＶＲ的共通 移動的:01 移動開始

	}

	//	破壊時処理
	proc ライデン的２面破壊処理 {
		if ($1 == 移動的:01) {
			mesg ＶＲ的共通 移動的:02 移動開始
			mesg ＶＲ移動的 移動的:02 即ルート変更 d:２面的ルート:移＿１

			mesg ＶＲ的共通 移動的:03 移動開始

		} else if ($1 == 移動的:02) {
			mesg ＶＲ的共通 移動的:04 移動開始

		} else if ($1 == 移動的:03) {
			mesg ＶＲ的共通 移動的:05 移動開始

		} else if ($1 == 移動的:04) {
			mesg ＶＲ的共通 移動的:06 移動開始

		} else if ($1 == 移動的:05) {
			mesg ＶＲ的共通 移動的:07 移動開始

			mesg ＶＲ的共通 移動的:08 移動開始
			mesg ＶＲ移動的 移動的:08 即ルート変更 d:２面的ルート:移＿８

		} else if ($1 == 移動的:06) {
			mesg ＶＲ的共通 移動的:09 移動開始
			mesg ＶＲ移動的 移動的:09 即ルート変更 d:２面的ルート:移＿１１

		} else if ($1 == 移動的:07) {
			mesg ＶＲ的共通 移動的:10 移動開始
			mesg ＶＲ移動的 移動的:10 即ルート変更 d:２面的ルート:移＿３

		}

	}

	//	的配置
	proc ライデン的２面設定 {

	//	@ＶＲ標的基本設定 	\
	//	$:p_名前 $:p_的ステータス $:p_ルート $:p_ノード $:p_破壊プロック $:p_的スピード {

		//	１回目
		@ＶＲ標的基本設定 \
		移動的:01 $$i:的ステータス d:２面的ルート:移＿１ 0 p:武器訓練ハンドガン２面ＶＲ標的破壊処理 $$i:的スピード

		//	２回目
		@ＶＲ標的基本設定 \
		移動的:02 $$i:的ステータス d:２面的ルート:待＿１ 0 p:武器訓練ハンドガン２面ＶＲ標的破壊処理 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:03 $$i:的ステータス d:２面的ルート:移＿５ 0 p:武器訓練ハンドガン２面ＶＲ標的破壊処理 $$i:的スピード

		//	３回目
		@ＶＲ標的基本設定 \
		移動的:04 $$i:的ステータス d:２面的ルート:移＿２３ 0 p:武器訓練ハンドガン２面ＶＲ標的破壊処理 $$i:的スピード

		//	４回目
		@ＶＲ標的基本設定 \
		移動的:05 $$i:的ステータス d:２面的ルート:移＿２４ 0 p:武器訓練ハンドガン２面ＶＲ標的破壊処理 $$i:的スピード

		//	５回目
		@ＶＲ標的基本設定 \
		移動的:06 $$i:的ステータス d:２面的ルート:移＿１９ 1 p:武器訓練ハンドガン２面ＶＲ標的破壊処理 $$i:的スピード

		//	６回目
		@ＶＲ標的基本設定 \
		移動的:07 $$i:的ステータス d:２面的ルート:移＿２５ 0 p:武器訓練ハンドガン２面ＶＲ標的破壊処理 $$i:的スピード
		@ＶＲ標的基本設定 \
		移動的:08 $$i:的ステータス d:２面的ルート:待＿８ 0 p:武器訓練ハンドガン２面ＶＲ標的破壊処理 $$i:的スピード

		//	７回目
		@ＶＲ標的基本設定 \
		移動的:09 $$i:的ステータス d:２面的ルート:待＿１１ 0 p:武器訓練ハンドガン２面ＶＲ標的破壊処理 $$i:的スピード

		//	８回目
		@ＶＲ標的基本設定 \
		移動的:10 $$i:的ステータス d:２面的ルート:待＿３ 0 p:武器訓練ハンドガン２面ＶＲ標的破壊処理 $$i:的スピード
	}



