//###################################################################################
//									 カメラ
//###################################################################################
	// ------------------------------------
	// カメラ関係の設定
	// ------------------------------------
	// ステージカメラ設定
	// ------------------------------------
	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'chara_camera & stage_camera_set'
		#endif

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0
		chara カメラ メインカメラ		-c 0 -l 2 -p 40
		chara カメラ カットインカメラ	-c 0 -l 0 -p 0

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 175,2048,0 \
			-f 9000 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1

	}

	// ステージ固有のカメラ設定
	// ------------------------------------
	proc 武器訓練ハンドガン１面カメラ設定 {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif

		//---------------------
		// 通常のステージカメラ
		//---------------------
		trap ca001 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 メインカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 175,2048,0 \
					-f 9000 \
					-a 200 \
					-i 2 2 0 0 \
					-s $3
		 	}

	}



//###################################################################################
//									ＶＲウィンドウの設定と表示
//###################################################################################

	//------------------------------------------------------------
	// ＶＲウィンドウの設定と表示
	//------------------------------------------------------------
	proc 武器訓練ハンドガン１面ＶＲウィンドウ設定 {
	#if d:DEBUG_PRINT
		print 'vr_window_set-weapon handgun LEVEL 1'
	#endif

		//	ＶＲウィンドウの設定。各言語のリソースと終了プロックが引数
		//	リソースはvr_window_j.h等で定義(a_stdproc.hでinclude済み)
		//	プロック名を引数にする場合は先頭にp:をつけること！
	
#ifndef	d:WP02A
		@ＶＲウィンドウ設定	\		//	ハンドガン１面用
			[VRMSG_J:VRM_WPN_HGN_wp01a] [VRMSG_E:VRM_WPN_HGN_wp01a] [VRMSG_G:VRM_WPN_HGN_wp01a] \	//	日、英、独
			[VRMSG_F:VRM_WPN_HGN_wp01a] [VRMSG_I:VRM_WPN_HGN_wp01a] [VRMSG_S:VRM_WPN_HGN_wp01a] \	//	仏、伊、西
			[VRMSG_K:VRM_WPN_HGN_wp01a] \												//	韓
			p:武器訓練ハンドガン１面ステージ開始時処理								//	終了プロック
#else
		@ＶＲウィンドウ設定	\		//	ハンドガン２面用
			[VRMSG_J:VRM_WPN_HGN_wp02a] [VRMSG_E:VRM_WPN_HGN_wp02a] [VRMSG_G:VRM_WPN_HGN_wp02a] \	//	日、英、独
			[VRMSG_F:VRM_WPN_HGN_wp02a] [VRMSG_I:VRM_WPN_HGN_wp02a] [VRMSG_S:VRM_WPN_HGN_wp02a] \	//	仏、伊、西
			[VRMSG_K:VRM_WPN_HGN_wp02a] \												//	韓
			p:武器訓練ハンドガン１面ステージ開始時処理								//	終了プロック
#endif

		//	ＶＲウィンドウを表示する(名前はＶＲウィンドウ君で固定)
		mesg ＶＲウィンドウ ＶＲウィンドウ君 開く

		//	スタート時とクリア時に使用するカットインカメラ
		//	自分でカメラを定義する際にはなるべくロード時に起動する
		chara カメラ設定 カットインカメラ \
			-c 1 \
			-p 0,5757,8594 -t 0,-1390,3138 \
			-r 599,2048,0 -f 8992 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1
	}


	//------------------------------------------------------------
	// ステージ開始時処理(ＶＲウィンドウが閉じた後行う処理)
	//------------------------------------------------------------
	proc 武器訓練ハンドガン１面ステージ開始時処理 {
	#if d:DEBUG_PRINT
		print 'game_start!!!!!'
	#endif

		//	プレイヤーやパッドの制御等を行う a_stdproc.hで定義
		@全ミッション共通ステージ開始時処理

		//	カメラワークスタート(必要な場合)
		//	全体図（補間のフレーム数は全て統一するためdefineで固定）
		chara カメラ設定 カットインカメラ \
			-c 1 \
			-p 0,18800,11772 -t 0,11710,6239 \
			-r 592,2048,0 -f 8994 \
			-a 200 \
			-i 4 4 d:START_CAMERA_CHANGE_TIME d:START_CAMERA_CHANGE_TIME \
			-s 1

		chara delay ディレイ \
			-time d:START_CAMERA_CHANGE_TIME \
			-exec {
				//	カメラの補間が終わった直後にステージカメラへ移行する
				chara カメラ設定 カットインカメラ -s -1
			}

	}


	proc ゲーム開始直後処理 {
		//	的をスタートさせる
#ifndef	d:WP02A
		@武器訓練ハンドガン１面ＶＲ標的スタート処理		//	ハンドガン１面用
#else
		@武器訓練ハンドガン２面ＶＲ標的スタート処理		//	ハンドガン２面用
#endif
	}



//###################################################################################
//									 その他
//###################################################################################



// -----------------------------------------------------------------------------------
// 以下デバッグ専用proc
// -----------------------------------------------------------------------------------
// デバッグキャラ
// ------------------------------------
proc デバッグキャラセット {
	#if d:DEBUG_PRINT
		print 'debug_chara_set'
	#endif

	#if d:CHARA_CAMERA
		chara キャラカメラ 敵兵カメラ \
			-c d:TARGET_CHARA \
			-s -920,610,200 \
			-r -200,1024,0
	#endif

	#if d:SCREENSHOT
		chara スクリーンショット shot
	#endif

	#if d:USB_KEY
		chara USBキーボード実行 test \
			-e d:KBD_ESC {
				mesg プレイヤー d:PLAYER position -5500, -13000, -500
			} \
	#endif
}

