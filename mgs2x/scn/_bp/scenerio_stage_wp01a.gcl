enum １面的ルート {

//	移動ルート
	移＿０ = 0,		//	手前左側柱
	移＿１,			//	手前左側柱

	移＿２,			//	手前真ん中柱
	移＿３,			//	手前真ん中柱

	移＿４,			//	手前右側柱
	移＿５,			//	手前右側柱

	移＿６,			//	奥左側柱
	移＿７,			//	奥左側柱

	移＿８,			//	奥真ん中柱
	移＿９,			//	奥真ん中柱
	移＿１０,		//	奥真ん中柱

	移＿１１,		//	奥右側柱
	移＿１２,		//	奥右側柱
}

//////////////////////////
//	ハンドガン２面用
//////////////////////////
enum ２面的ルート {

//	移動ルート
	移＿０ = 50,	//	手前正面向き左
	移＿１,			//	手前正面向き右

	移＿２,			//	右側正面向き上		//	隠れる動き
	移＿３,			//	右側正面向き下

	移＿４,			//	左側側面向き手前
	移＿５,			//	手前正面向き真ん中

	移＿６,			//	左側正面向き左
	移＿７,			//	左側正面向き右

	移＿８,			//	左側側面向き手前上
	移＿９,			//	右側側面向き手前上

	移＿１０,		//	右側側面向き奥上
	移＿１１,		//	奥右側柱

	移＿１２,		//	左側側面向き手前	//	隠れる動き
	移＿１３,		//	左側側面向き奥

	移＿１４,		//	奥正面向き左
	移＿１５,		//	奥正面向き左
	移＿１６,		//	奥正面向き真ん中
	移＿１７,		//	奥正面向き右
	移＿１８,		//	奥正面向き右

	移＿１９,		//	奥右側柱　奥左側柱横断	//	隠れる動き
	移＿２０,		//	左側側面向き奥　奥真ん中柱横断	//	隠れる動き

	移＿２１,		//	正面右　上下移動	//	隠れる動き
	移＿２２,		//	正面左　上下移動	//	隠れる動き
	移＿２３,		//	左側正面向き右　上下移動	//	隠れる動き
	移＿２４,		//	奥正面向き左　上下移動	//	隠れる動き
	移＿２５,		//	奥正面向き右　上下移動	//	隠れる動き
	移＿２６,		//	手前正面向き右
	移＿２７,		//	手前正面向き左
	移＿２８,		//	手前真ん中柱	//	隠れる動き
	移＿２９,		//	左側側面向き手前	//	隠れる動き

	移＿３０,		//	奥真ん中柱	//	隠れる動き
	移＿３１,		//	奥真ん中柱	//	隠れる動き
	移＿３２,		//	奥右側柱	//	隠れる動き

	移＿３３,		//	奥正面向き左	//	隠れる動き
	移＿３４,		//	奥正面向き左	//	隠れる動き
	移＿３５,		//	奥正面向き真ん中	//	隠れる動き
	移＿３６,		//	奥正面向き右	//	隠れる動き
	移＿３７,		//	奥正面向き右	//	隠れる動き
	移＿３８,		//	奥右側柱　奥左側柱横断後ろ	//	隠れる動き
	移＿３９,		//	奥右側柱　奥左側柱横断	//	隠れる動き



//	待機ルート
	待＿０ = 100,	//	手前正面向き左
	待＿１,			//	手前正面向き右

	待＿２,			//	右側正面向き上
	待＿３,			//	右側正面向き下

	待＿４,			//	左側側面向き手前
	待＿５,			//	手前正面向き真ん中

	待＿６,			//	左側正面向き左
	待＿７,			//	左側正面向き右

	待＿８,			//	右側側面向き手前上
	待＿９,			//	右側側面向き手前下

	待＿１０,		//	右側側面向き奥上
	待＿１１,		//	奥右側柱

	待＿１２,		//	左側側面向き手前
	待＿１３,		//	左側側面向き奥

	待＿１４,		//	奥正面向き左
	待＿１５,		//	奥正面向き左
	待＿１６,		//	奥正面向き真ん中
	待＿１７,		//	奥正面向き右
	待＿１８,		//	奥正面向き右

	待＿１９,		//	奥右側柱　奥左側柱横断
	待＿２０		//	左側側面向き奥　奥真ん中柱横断
}


