// 各種スイッチ用define
// ------------------------------------
// プラント編識別
#define STAGE_PLANT			1
#define	STAGE_ALT			1		// オルタナティブミッション切り分け用
#define STAGE_W28A			1 

// 敵兵、ＮＰＣ状況（薬莢を呼び分けるのに必要）
#define		ENE_P_GOL		1		// 都市迷彩ゴル兵

// 入出トラップ
#define		STAGE_END		0		// ステージ終了時処理を使用可にする
// 強制モーション
#define		FADE_TIME		200		// フェードアウト時間

// デバッグ関係
#ifdef	d:FIX_MODE
	#define		DEBUG_CHARA	0		// デバッグキャラ全体(FIX時は0)
#else
	#define		DEBUG_CHARA	1		// デバッグキャラ全体
#endif

#define		TARGET_CHARA		敵兵:01		// キャラ追従カメラのターゲット

// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME		a28a
#define		KMS_NAME0		w28a
//#define		KMS_NAME1		w28a_dummy
/*	ロードモデルを修正ＰＳ２Ｊ以降から2002/09/11	*/
#define		KMS_NAME1		a28a_dummy
#define		KMS_NAME2		w28a_outside
#define		DOOR_NAME_KL_LV5		w28a_dr00	// ロード用
#define		DOOR_NAME_KL_LV0		w28a_dr00x	// ロード用 レベルなし

#define		CIEL_NAME		w28a_roof	// 天井
#define		LT2_NAME		w28a
#define		KMS_NAME_SEA		sea
#define		HATCH_NAME		w28_hatch
#define		SHADOW_KMS_NAME0	w28a_kage

#define		PLAYER		ライデン	// モーションができるまで名前はスネーク



// ローカル変数

// ------------------------------------
// 敵兵音声
// ------------------------------------
resource ghq_area_alert_voice {
	w28a:
		$t{
			// PLAREA0
			t:vc049009	// 指揮官「了解！敵を殲滅せよ！」
			-1
		}
}

resource ghq_caution_voice {
	w28a:
		$t{
			// PLAREA0
			t:vc040601,	// 指揮官　　「了解！僧院警戒を強化せよ！」
			-2,
			t:vc040065,	// 指揮官　　「どうした、応答しろ！」
			-1
		}
}



// ドア設定用ステージ内ローカル変数(a_mode.hよりも先に定義する)
dim $$b:ドアフラグ[ 1 ]
dim $$s:ドアモデル名[ 1 ]

command	配列セット $$b:ドアフラグ[0] {
	0
}
command	配列セット $$s:ドアモデル名[0] {
	0
}



// モーション関係
// ------------------------------------
#include "rai_a28a.mh"

// include
// ------------------------------------
#include "stdch.h"
#include "enevoice.h"
#include "a_mode.h"			// アナザーミッション設定ファイル
#include "sload.h"
#include "jump.h"
#include "beyond.h"
#include "sound.h"
#include "item_info.h"



// アナザー用でマップ設定前に設定する
// ------------------------------------
@アナザー用マップ定義前設定

// マップ設定
// ------------------------------------
chara マップ Ｌ脚	-k d:KMS_NAME0 \
			-k d:KMS_NAME1 \
			-k d:KMS_NAME2 \
			-h d:HZX_NAME,0 -l d:LT2_NAME

command マップ設定 Ｌ脚 -set {
	@レーダー設定
	@常駐キャラ設定
	@ローカル変数初期化
	@A_プレイヤー設定 sna_a28a rai_a28a
}

// アナザー用でマップ設定後に設定する
// ------------------------------------
@アナザー用マップ定義後設定

command マップ設定 Ｌ脚 -set {
	@弾痕跳弾設定
	@カメラセット
	@リアル影設定
	@主観禁止壁設定
	@Ｌ脚カメラ設定
	@Ｌ脚天井設置
	@ロード設定
	@ドア設置
	@ハッチ設定
	@電灯虫設定
	@フォグ設定
	@キャラ用ライト設置		// マップ設定の最後に呼ぶ
}

//初期マップの表示
command マップ表示 -show Ｌ脚

// 全てのセットが終わったところでフェードイン
if( $s:登場ポイント == ＫＬ連絡橋から ) {
	// 全てのセットが終わったところでフェードイン
	@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:SL_DOOR_TYPE 北側ドア 2500 d:DEFAULT_M_TYPE d:wn_Ｌ脚汚水処理場

} else if ($s:登場ポイント == テイルズＤＥ脚梯子部屋到着紙芝居後から) {
//	テイルズＤＥ脚梯子部屋到着紙芝居後から
	@ステージ開始時処理（ステージ名表示） \
	d:LOAD_TYPE:NO_MOVE_TYPE 紙芝居 0 d:DEFAULT_M_TYPE d:wn_Ｌ脚汚水処理場

}



// 各proc設定
//-------------------------------------------------------------------------------------
// 全マップ共通
	// 弾痕跳弾関係の設定
	// ------------------------------------
	proc 弾痕跳弾設定 {
		#if d:DEBUG_PRINT 
			print 'recoil_set'
		#endif

		command 弾痕ノーマル -n 0	// 通常
		command 弾痕ノーマル -n 1	// 階段、通常
		command 弾痕ノーマル -n 2	// 鉄板
		command 弾痕ノーマル -n 3	// 鉄筋
		command 弾痕ノーマル -n 4	// ダンボール
		command 弾痕ノーマル -n 5	// 木箱
		command 弾痕ノーマル -n 6	// パイプ中
		command 弾痕ノーマル -n 7	// パイプ大

		command 跳弾ノーマル -n 0
		command 跳弾ノーマル -n 1
		command 跳弾ノーマル -n 2
		command 跳弾ノーマル -n 3
		command	跳弾水蒸気小 -n 5	// 蒸気パイプ 2001.10.6
		command	跳弾水蒸気中 -n 6	// 蒸気パイプ 2001.10.6
		command	跳弾水蒸気大 -n 7	// 蒸気パイプ 2001.10.6
	}

	// リアル影
	// ------------------------------------
	proc リアル影設定 {
		#if d:DEBUG_PRINT
			print 'real_shadow'
		#endif
		// 影投影モデル
		command	影投影ハザード -name Ｌ脚 -group 1

		// 影投影モデル -m 影投影専用モデル -p 設置位置
		chara 影投影モデル 影投影モデル -m d:SHADOW_KMS_NAME0 -p -3,6,-3

		// 影管理 -t 光源タイプ -l 光源距離(並行光源時のみ有効) -p 並行光源方向直接指定
		//chara 影管理 影管理 -t 0 -l 6000 -p -2700 -3100 -2700
		chara 影管理 影管理 -t 1

		trap ca004 ？ -mask ？ -exec {
			if ( $3 == 入る ) {
				mesg 影管理 影管理 add $2 影投影モデル
			} else {
				mesg 影管理 影管理 del $2
			}
		}

	}
	// レーダー
	// ------------------------------------
	proc レーダー設定 {
		#if d:DEBUG_PRINT 
			print 'menu set'
		#endif
	}

	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT 
			print 'localvar_init'
		#endif
		eval( $f:エマゲームオーバーフラグ = 0 );
	}

	// 電灯虫設定 
	// ------------------------------------
	proc 電灯虫設定 {
		chara 電灯虫 w28a電灯虫 \
			-n 32 \ 	
			-p 48665,2800,-223151 \		// ライト位置 ->> プレイヤー誘導時は無視
			-b 1 \			// 下のバウンディングボックスで壁との当たり見るか  1 : 判定あり, 0 : 判定なし
			-s (48665-1500),(        0),(-223151) \	// 最小ボックス座標
			-l (48665+1500),(2800+1000),(-223151+1000)	// 最大ボックス座標
		chara 電灯虫 w28a電灯虫 \
			-n 16 \ 	
			-p 52000,2750,-214879 \		// ライト位置 ->> プレイヤー誘導時は無視
			-b 1 \			// 下のバウンディングボックスで壁との当たり見るか  1 : 判定あり, 0 : 判定なし
			-s (52000-1500),(        0),(-214879-1000) \	// 最小ボックス座標
			-l (52000+1500),(2750+1000),(-214879)	// 最大ボックス座標
		chara 電灯虫 w28a電灯虫 \
			-n 16 \ 	
			-p 52000,2750,-213474 \		// ライト位置 ->> プレイヤー誘導時は無視
			-b 1 \			// 下のバウンディングボックスで壁との当たり見るか  1 : 判定あり, 0 : 判定なし
			-s (52000-1500),(        0),(-213474) \	// 最小ボックス座標
			-l (52000+1500),(4000+1000),(-213474+1000)	// 最大ボックス座標
	}



	// ドア＆マップ切り替え関係
	// ------------------------------------
	proc ドア設置 {
		#if d:DEBUG_PRINT
			print 'slide_door_set'
		#endif

		local $$:開閉用モーションファイル名;

		// ドアフラグを元にモデルを設定(※全てのパターンのモデルを用意するのはもったいないので使うところのみ変更していく)
		// ドアモデル名セット $:配列番号 $:ドア名１(close) $:ドア名２(open) $:ドア名３(enemy) $:ドア名４(lv_close) $:ドア名５(lv_open)
		// 北側へのドア
		@ドアモデル名セット 0 d:DOOR_NAME_KL_LV0 d:DOOR_NAME_KL_LV0 d:DOOR_NAME_KL_LV0 d:DOOR_NAME_KL_LV0 d:DOOR_NAME_KL_LV0

		chara ドア 北側ドア \
			-m $$s:ドアモデル名[0] \
			-d 0,0,0 \
			-p 48000,0,-223625 \
			-slide d:SD_SLIDE_OUTSIDE \
			-A 北側ドアランプ \
			-time d:SD_OPEN_TIME \
			-exec {
			}
		@ドアランプ設定 北側ドアランプ 0 48000,0,-223625 0
		trap dr001 ？ \
			-mask ？ \	
			-exec {
					if($3==入る){
						mesg ドア 北側ドア open $2
					}else{
						mesg ドア 北側ドア close $2
					}
			}
		trap dr001 d:PLAYER -mask ？ \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 0 ) {
					chara カメラ設定 ロードカメラ \
							-c 1 \
							-p 49080,3864,-222625 -t 48832,1757,-223636 \
							-r 725,2205,0 -f 2350 \
							-a 200 \
							-i 1 2 0 0 \
							-s $3
				}
			}
		@A_ドア開閉追加設定 北側ドア $$b:ドアフラグ[0] 48000,0,-223625 0 d:SD_SLIDE_OUTSIDE




		// 南側は水密ドア
		switch ( $s:選択プレイヤー ) {
			case ( ライデン ) {
				$$:開閉用モーションファイル名 = rai_wt_hatch;
			}
			case ( 刀ライデン ) {
				$$:開閉用モーションファイル名 = rai_wt_hatch;
			}
			default {
				$$:開閉用モーションファイル名 = sna_hatch;
			}
		}

		chara 水密ドア管理 ドア管理モジュール -n 1 -seno 3 \
			-motions $$:開閉用モーションファイル名 hatch_door_sna hatch_handle_sna 

		//	スネークテイルズＤでは水密ドア開けた状態からスタート
		if ( ($b:ミッション番号 == d:MISSION:スネークテイルズ) && \
			($b:tales_story_no == d:TALES_NO:D) ) {
			eval ($f:w28a水密ドア開けた = 1 )
		}

		if( $f:w28a水密ドア開けた == 0 ) {
			// 閉まっている
			eval( $i:水密ドア状態 = 0 )
		} else {
			// 既に開いている
			eval( $i:水密ドア状態 = d:WT_DOOR_FLAG_OPEN_START )
		}

		chara 水密ドア 南側ドア \
			-kms w28a_sdr_r w28_sdr_handle \
			-position 53250,0,-205850 \
			-type 1 \	  //０：左軸 １：右軸 省略時は０
			-rotate 0,2048,0 \
			-hazard 52000,0,-206000 53125,0,-206000 \
			-flag $i:水密ドア状態 \
			-proc 水密ドア開け

		trap dr002 d:PLAYER \
			-mask いる \
			-button d:ACTION_BUTTON \
			-state 0 \
			-exec {
				command 水密ドア状態 -n 南側ドア
				mesg プレイヤー d:PLAYER wt_door \	
					南側ドア $status \		//$s:水密ドアの名前 $i:そのドアの状態
					0,1024 \			//$w:ドアに正対した方向 $w:方向幅
					53125,-206000			//$i:ドア位置Ｘ $i:ドア位置Ｚ
			}
		trap dr002 d:PLAYER -mask ？ -state 6 \
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 50604,3790,-210924 -t 52303,1590,-207402 \
					-r 334,293,0 -f 4486 \
					-a 287 \
					-i 0 0 0 0 \
					-s $3
				}


		// 通過できないドアの壊れエフェクト
		@壊れドアエフェクト設定 壊れドアエフェクト 1024 46375 0 -221500 0	// Ｇ脚側
		@壊れドアエフェクト設定 壊れドアエフェクト 1024 57625 0 -221500 1	// 海側
	}
	
	proc 水密ドア開け {
		eval( $f:w28a水密ドア開けた = 1 ) ;
	}

	proc 主観禁止壁設定 {
		@主観禁止壁 北側ドア壁 48000 0 -223625 0 d:SD_SLIDE_OUTSIDE
		trap dr001 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_SUBJECT \
			-exec {
				if( $3 == 入る ) {
					mesg 透明壁 北側ドア壁 on
				} else {
					mesg 透明壁 北側ドア壁 off
				}
			}
	}


	// 入出トラップ
	// ------------------------------------
	proc ロードプロック {
		#if d:DEBUG_PRINT 
			print 'load_proc'
		#endif

		if ($s:呼び出しプロック == mv_a28a_a25d_0) {
			// ＫＬ連絡橋へ
			@mv_a28a_a25d_0
		}
	}

	proc ロード設定 {
		#if d:DEBUG_PRINT 
			print 'load_set'
		#endif
		// 
		trap ld001 d:PLAYER \
			-mask 入る \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 1 ) {
					@ステージ終了時処理（ステージ名表示） 48750 0 -225500 2048 \
						mv_a28a_a25d_0 d:DEFAULT_M_TYPE d:wn_ＫＬ連絡橋
				}
			}
	}


	// フォグ
	// ------------------------------------
	proc フォグ設定 {
		#if d:DEBUG_PRINT
			print 'fog_set'
		#endif

		chara フォグ 霧\
			-c 65, 40, 0 \
			-n 1000 \
			-f 29000
	}
	// キャラ用光源(マップの設置が終わってから設定することで、キャラだけに光を当てる)
	// ------------------------------------
	proc キャラ用ライト設置 {
		#if d:DEBUG_PRINT
			print 'chara_light_set'
		#endif

		chara 環境光 環境光源 \
			 -c 63 63 32

		chara 平行光 平行光源 \
			 -c 70 79 47 \
			 -p 3075 -394 -66
	}


	// ステージカメラ設定 
	// ------------------------------------
	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0 
		chara カメラ 通路カメラ			-c 0 -l 2 -p 50
		chara カメラ 小部屋カメラ		-c 0 -l 2 -p 40
		chara カメラ ロードカメラ		-c 0 -l 2 -p 30
		chara カメラ ビヨンドカメラ		-c 0 -l 2 -p 20
		chara カメラ モーションカメラ		-c 0 -l 2 -p 10
		chara カメラ エマ死にカメラ		-c 0 -l 1 -p 25 
		chara カメラ ノードカメラ		-c 0 -l 1 -p 20 

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \	
			-b 47861,-320000,-223338 56379 320000 -221178 \
			-l 47861,-320000,-223366 56379 320000 -222762 \
			-r 750,2048,0 \
			-f 6500 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}


// 各マップ別設定
// ------------------------------------
// Ｌ脚
	// 天井設置
	// ------------------------------------
	proc Ｌ脚天井設置 {
		#if d:DEBUG_PRINT
			print 'w28a0_ceil_set'
		#endif
		chara 天井君 Ｌ脚天井 \
			-m d:CIEL_NAME -p 0 0 0  -l d:LT2_NAME -h 3950
	}


	// ハッチ設定
	// ------------------------------------
	proc ハッチ設定 {
		chara 透明床 ハッチ \
			-position 50500 0 -205500 \
				  50500 0 -204500 \
				  51500 0 -204500 \
				  51500 0 -205500 \
			-n_points 4 \
			-map Ｌ脚

		chara プットモーションモデル w28aハッチ \
			-pos 51000,0,-205500 \			//$v:配置座標
			-dir 3072 \				//$i:方向
			-kms d:HATCH_NAME \			//$s:KMSモデル名
			-mar rai_hatch \			//$s:モーションファイル名
			-number 0 \				//$i:基本モーション番号 ... 
			-status	0x0e 				//$w:ステータス 
	}

	// 各種カメラの設定
	// ------------------------------------
	proc Ｌ脚カメラ設定 {
		#if d:DEBUG_PRINT
			print 'w28a_camera_set'
		#endif

		// 廊下部分
		trap ca001 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 通路カメラ \
					-c 0 \	
					-b 52000,2200,-320000 52000 2200 -210000 \
					-l 52000,-320000,-320000 52000 320000 -210000 \
					-r 75,2048,0 -f 8842 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3
			}

		// シャフト上
		trap ca002 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 小部屋カメラ \
					-c 0 \	
					-b 51382,   7264,-206655 51382,  7264,-206655 \
					-l 51382,-320000,-210358 51382,320000,-207525 \
					-r 850,2048,0 -f 6000 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3
			}

		// 手前の部屋（はしご部屋）
		trap ca003 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 通路カメラ \
					-c 0 \	
					-b -320000,-320000,-320000 53106 320000 -204002 \
					-l -320000,-320000,-320000 53106 320000 -204443 \
					-r 640,2048,0 -f 4500 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3
			}

		// 北側の部屋（w25dより入ってきたところ）
		trap ca004 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 通路カメラ \
					-c 0 \	
					-b 47832,5988,-221432 56290 5988 -221432 \
					-l 47832,1558,-222222 56290 1558 -222222 \
					-r 909,2048,0 -f 4500 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3
			}
	}


