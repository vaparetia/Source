/***************************************************************************************************/
// サウンドのproc化
/***************************************************************************************************/
proc 居住区１Ｆサウンドマネージャー設定 {
	chara サウンドマネージャー ＳＤマネ -pak 0

	if( $f:壊れフラグ＿でかガラス ) {
		@ガラス割れ後サウンド設定
	} else {
		@サウンド効果音設定
	}



	command 弾痕ノーマル -n 0
	command 弾痕ノーマル -n 1
	command 弾痕ノーマル -n 2
	command 弾痕ノーマル -n 3
	command 弾痕ノーマル -n 4

	command 跳弾ノーマル -n 0
	command 跳弾ノーマル -n 1
	command 跳弾ノーマル -n 2
	command 跳弾ノーマル -n 3
	//command 跳弾ノーマル -n 4
	command 跳弾ＳＥのみ -n 4

	// 水蒸気の番号設定
	command 弾痕ノーマル -n 5
	command 弾痕ノーマル -n 6
	command 弾痕ノーマル -n 7
	command 跳弾水蒸気小 -n 5
	command 跳弾水蒸気中 -n 6
	command 跳弾水蒸気大 -n 7
}

proc 居住区１ＦＢＧＭマネージャー設定 {
	chara ＢＧＭマネージャー ＢＧＭ
}

/***************************************************************************************************/
// エルード設定
/***************************************************************************************************/

	proc エルード設定 {
		@左舷エルード設定
	#ifdef d:TGS2001F
		@右舷エルード設定
	#else
		if( !`@コンテナチェック` ) {
			@右舷エルード設定
		}
	#endif
	}

	proc 左舷エルード設定 {
		trap by001 d:PLAYER \
			-mask いる \
			-button d:ACTION_BUTTON \
			-state 0,4 \	//立ち状態or張り付き
			-exec {
				print 'エルード発動'
				@北向きビヨンド発動 $1 -15000 $4 -11550 -11050 0x00000002
			}

		// エルード 入る
		trap by001_ca d:PLAYER \
			-mask ？ \
			-state 	d:TRP_STATE_FORCE \
			-dir 	2048 256 \
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p -11563,2120,-13378 -t -10368,927,-16276 \
					-r 237,1793,0 -f 3353 \
					-a 200 \
					-i 1 0 0 0 \
					-s 1
			}
		// エルード 出る
		trap by001_ca d:PLAYER \
			-mask ？ \
			-state 	d:TRP_STATE_FORCE \
			-dir 	0 256 \
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p -9903,2411,-15199 -t -10901,1476,-14614 \
					-r 443,3418,0 -f 1487 \
					-a 178 \
					-i 1 0 0 0 \
					-s $3
			}

		// エルード中
		trap by001_ca d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_ELUDE \
			-dir 0 256 \	//方向指定
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p -11190,2004,-18253 -t -10944,265,-15442 \
					-r 360,57,0 -f 3314 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3 \
					-z d:CAMERA_NO_CUSHION
			}
	}

	proc 右舷エルード設定 {
		trap by002 d:PLAYER \
			-mask いる \
			-button d:ACTION_BUTTON \
			-state 0,4 \	//立ち状態or張り付き
			-exec {
				print 'エルード発動'
				@北向きビヨンド発動 $1 -15000 $4 11050 11550 0x00000002
			}

		// エルード 入る
		trap by002_ca d:PLAYER \
			-mask ？ \
			-state 	d:TRP_STATE_FORCE \
			-dir 	2048 256 \
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 11680,2579,-13037 -t 10394,1254,-15176 \
					-r 318,2401,0 -f 2826 \
					-a 200 \
					-i 1 0 0 0 \
					-s 1
			}
		// エルード 出る
		trap by002_ca d:PLAYER \
			-mask ？ \
			-state 	d:TRP_STATE_FORCE \
			-dir 	0 256 \
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 9795,2811,-13798 -t 11516,773,-14695 \
					-r 528,1337,0 -f 2814 \
					-a 200 \
					-i 1 1 0 0 \
					-s $3
			}

		// エルード中
		trap by002_ca d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_ELUDE \
			-dir 0 256 \	//方向指定
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 11288,1660,-17565 -t 11088,-130,-14792 \
					-r 373,4049,0 -f 3306 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3 \
					-z d:CAMERA_NO_CUSHION
			}
	}

/***************************************************************************************************/
// プレイヤーのproc化
/***************************************************************************************************/
proc プレイヤー設定 {
#if d:SNAKE
	chara プレイヤー スネーク \
		-m sna_def \
		-a snake \
		-p $i:プレイヤー初期Ｘ位置 $i:プレイヤー初期Ｙ位置 $i:プレイヤー初期Ｚ位置 \
		-d 0,$i:プレイヤー初期方向,0 \
		-l 2800 \
		-o sna_w01f \
		//-f d:PLY_NO_FOOT_SHADOW \
		-i 0 \		// 足音
		//-homing 10000 128 \
		-s 0

	chara ロープモデル３ バンダナ１ \
		-n sna_bdn1 \
		-d 1 \
		-y スネーク \
		-z 12 \
		-x 0,60,-90 \
		-m 12 \
		-p 250 \
		-k 350 \
		-o 110 \
		-f 1

	chara ロープモデル３ バンダナ２ \
		-n sna_bdn2 \
		-d 1 \
		-y スネーク \
		-z 12 \
		-x 0,50,-90 \
		-m 20 \
		-p 250 \
		-k 350 \
		-o 110 \
		-f 1

#else if d:RAIDEN
	chara プレイヤー d:PLAYER \
		-p $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,$i:プレイヤー初期Ｚ位置 \
		-d 0,$i:プレイヤー初期方向,0 \
		-s 0 \
		-o rai_m00
#endif

#if d:MULTI_MODEL
	// ビデオ用マルチウェイト
	chara マルチウェイトキャラ マルチ \
		-name d:PLAYER \
		-model sna_def_mh

	chara 臨時顔アニメキャラ アニメキャラ \
		-chara	d:PLAYER
#endif

#if d:ＬＯＤ使用
	@プレイヤーＬＯＤ設定 d:C_DISTANCE_TYPE 6000
#endif
}

/***************************************************************************************************/
// 攻撃兵の設定
/***************************************************************************************************/

#if d:ENEMY
	proc アタッカーA {
		// 二階右舷
		chara アタッカー 攻撃兵:01 \
			-r 7 \
			-c 10 \
			-e 0 \
			-i	$w:敵潜入視力 12000 $w:敵回避視力 \
			-l $w:敵標準体力 \
			-h $w:敵標準聴力 \
			-f $w:敵標準気絶 \
			-q	レーション_敵兵 15
	}

	proc アタッカーB {
		// 二階右舷
		chara アタッカー 攻撃兵:02 \
			-r 7 \
			-c 11 \
			-e 0 \
			-i	$w:敵潜入視力 12000 $w:敵回避視力 \
			-l $w:敵標準体力 \
			-h $w:敵標準聴力 \
			-f $w:敵標準気絶 \
			-q	レーション_敵兵 15
	}

	proc アタッカーC {
		// 地下一階右舷
		chara アタッカー 攻撃兵:01 \
			-r 15 \
			-c 10 \
			-e 0 \
			-i	$w:敵潜入視力 12000 $w:敵回避視力 \
			-l $w:敵標準体力 \
			-h $w:敵標準聴力 \
			-f $w:敵標準気絶 \
			-q	レーション_敵兵 15
	}

	proc アタッカーD {
		// 地下一階右舷
		chara アタッカー 攻撃兵:02 \
			-r 16 \
			-c 11 \
			-e 0 \
			-i	$w:敵潜入視力 12000 $w:敵回避視力 \
			-l $w:敵標準体力 \
			-h $w:敵標準聴力 \
			-f $w:敵標準気絶 \
			-q	レーション_敵兵 15
	}

	proc アタッカーE {
		chara アタッカー 攻撃兵:01 \
			-r 13 \
			-c 10 \
			-e 0 \
			-i	$w:敵潜入視力 12000 $w:敵回避視力 \
			-l $w:敵標準体力 \
			-h $w:敵標準聴力 \
			-f $w:敵標準気絶 \
			-q	レーション_敵兵 15
	}

	proc アタッカーF {
		chara アタッカー 攻撃兵:02 \
			-r 14 \
			-c 11 \
			-e 0 \
			-i	$w:敵潜入視力 12000 $w:敵回避視力 \
			-l $w:敵標準体力 \
			-h $w:敵標準聴力 \
			-f $w:敵標準気絶 \
			-q	レーション_敵兵 15
	}

	proc アタッカーG {
		// 一階右舷
		chara アタッカー 攻撃兵:01 \
			-r 6 \
			-c 10 \
			-e 0 \
			-i	$w:敵潜入視力 12000 $w:敵回避視力 \
			-l $w:敵標準体力 \
			-h $w:敵標準聴力 \
			-f $w:敵標準気絶 \
			-q	レーション_敵兵 15
	}

	proc アタッカーH {
		// 一階右舷
		chara アタッカー 攻撃兵:02 \
			-r 4 \
			-c 11 \
			-e 0 \
			-i	$w:敵潜入視力 12000 $w:敵回避視力 \
			-l $w:敵標準体力 \
			-h $w:敵標準聴力 \
			-f $w:敵標準気絶 \
			-q	レーション_敵兵 15
	}

	proc アタッカーセット {
		if( $s:登場ポイント == 居住区二階右からロード ) {
			if( $w:スタートアラートモード == d:ALERT_MODE_KIKEN ) {
				// 危険モード時のロードでは後ろから来るように設定
				@アタッカーA	// 二階右舷
				@アタッカーB	// 二階右舷
			} else {
				@アタッカーG	// 一階右舷
				@アタッカーH	// 一階右舷
			}
		} else if( $s:登場ポイント == エンジンルーム右舷からロード ) {
			if( $w:スタートアラートモード == d:ALERT_MODE_KIKEN ) {
				// 危険モード時のロードでは後ろから来るように設定
				@アタッカーC	// 地下一階右舷
				@アタッカーD	// 地下一階右舷
			} else {
				@アタッカーA	// 二階右舷
				@アタッカーB	// 二階右舷
			}
		} else if( $s:登場ポイント == エンジンルーム左舷からロード ) {
			if( $w:スタートアラートモード == d:ALERT_MODE_KIKEN ) {
				@アタッカーE	// 地下一階左舷
				@アタッカーF	// 地下一階左舷
			} else {
				@アタッカーA	// 二階右舷
				@アタッカーB	// 二階右舷
			}
		}else if( $s:登場ポイント == 居住区一階右舷からロード ){
			if( $w:スタートアラートモード == d:ALERT_MODE_KIKEN ) {
				// 危険モード時のロードでは後ろから来るように設定
				@アタッカーG	// 一階右舷
				@アタッカーH	// 一階右舷
			} else {
				@アタッカーA	// 二階右舷
				@アタッカーB	// 二階右舷
			}
		} else if ( $s:登場ポイント == 居住区二階左からロード ) {
			#if d:ASSERT
				command assert ( d:FALSE ) \
					'Attacker set error! 居住区二階左からロードからロードしています'
			#endif
		} else {
			#if d:ASSERT
				command assert ( d:FALSE ) \
					'Attacker set error! 予期されていないロードポイントです'
			#endif
		}

	}

/***************************************************************************************************/
// 警備兵の設定
/***************************************************************************************************/

	/////////////////////
	// 羽虫レーション設定
	proc レーション_敵兵羽虫 $:マップ $:Ｘ座標 $:Ｙ座標 $:Ｚ座標 {

		if( $w:ゲーム設定 <= d:LEVEL_EXTREME ) {
			eval( $b:w01f_羽虫レーションゲッ虫回数 = $b:w01f_羽虫レーションゲッ虫回数 + 1 )

			eval($i:w01f_Ｘ座標 = $:Ｘ座標)
			eval($i:w01f_Ｙ座標 = $:Ｙ座標)
			eval($i:w01f_Ｚ座標 = $:Ｚ座標)

			if( $b:w01f_羽虫レーションゲッ虫回数 == 1 ) {
				command マップ設定 $:マップ -set {
					chara アイテム 羽虫レーション１ \
						-b d:敵兵の発生パターン \				// 発生パターン
						-p $i:w01f_Ｘ座標,$i:w01f_Ｙ座標,$i:w01f_Ｚ座標 \		// 発生位置
						-k ration_ibox \						// モデル：箱本体
						-s ration_ibox_sh \						// モデル：箱影
						-l rtn_label \							// モデル：ラベル
						-f d:アイテム種別:アイテム \			// ＩＤ：from ..../scn/equip.h
						-i d:アイテム:レーション \				// ＩＤ：from ..../scn/equip.h
						-n 1 \									// 個数
						-r 0 \									// 0で飛沫無し。
						-h d:敵兵の高さ \						// 床面からの高さ
						-x {
							print '虫の集ったレーションゲッ虫'
							mesg 電灯虫 たかり虫:01 人誘導 d:PLAYER
						}
				}
				mesg 電灯虫 たかり虫:01 物誘導 羽虫レーション１

			} else if( $b:w01f_羽虫レーションゲッ虫回数 == 2 ) {
				command マップ設定 $:マップ -set {
					chara アイテム 羽虫レーション２ \
						-b d:敵兵の発生パターン \				// 発生パターン
						-p $i:w01f_Ｘ座標,$i:w01f_Ｙ座標,$i:w01f_Ｚ座標 \		// 発生位置
						-k ration_ibox \						// モデル：箱本体
						-s ration_ibox_sh \						// モデル：箱影
						-l rtn_label \							// モデル：ラベル
						-f d:アイテム種別:アイテム \			// ＩＤ：from ..../scn/equip.h
						-i d:アイテム:レーション \				// ＩＤ：from ..../scn/equip.h
						-n 1 \									// 個数
						-r 0 \									// 0で飛沫無し。
						-h d:敵兵の高さ \						// 床面からの高さ
						-x {
							print '虫の集ったレーションゲッ虫'
							mesg 電灯虫 たかり虫:02 人誘導 d:PLAYER
						}
				}
				mesg 電灯虫 たかり虫:02 物誘導 羽虫レーション２

			} else if( $b:w01f_羽虫レーションゲッ虫回数 == 3 ) {
				command マップ設定 $:マップ -set {
					chara アイテム 羽虫レーション３ \
						-b d:敵兵の発生パターン \				// 発生パターン
						-p $i:w01f_Ｘ座標,$i:w01f_Ｙ座標,$i:w01f_Ｚ座標 \		// 発生位置
						-k ration_ibox \						// モデル：箱本体
						-s ration_ibox_sh \						// モデル：箱影
						-l rtn_label \							// モデル：ラベル
						-f d:アイテム種別:アイテム \			// ＩＤ：from ..../scn/equip.h
						-i d:アイテム:レーション \				// ＩＤ：from ..../scn/equip.h
						-n 1 \									// 個数
						-r 0 \									// 0で飛沫無し。
						-h d:敵兵の高さ \						// 床面からの高さ
						-x {
							print '虫の集ったレーションゲッ虫'
							mesg 電灯虫 たかり虫:03 人誘導 d:PLAYER
						}
				}
				mesg 電灯虫 たかり虫:03 物誘導 羽虫レーション３

			} else if( $b:w01f_羽虫レーションゲッ虫回数 == 4 ) {
				command マップ設定 $:マップ -set {
					chara アイテム 羽虫レーション４ \
						-b d:敵兵の発生パターン \				// 発生パターン
						-p $i:w01f_Ｘ座標,$i:w01f_Ｙ座標,$i:w01f_Ｚ座標 \		// 発生位置
						-k ration_ibox \						// モデル：箱本体
						-s ration_ibox_sh \						// モデル：箱影
						-l rtn_label \							// モデル：ラベル
						-f d:アイテム種別:アイテム \			// ＩＤ：from ..../scn/equip.h
						-i d:アイテム:レーション \				// ＩＤ：from ..../scn/equip.h
						-n 1 \									// 個数
						-r 0 \									// 0で飛沫無し。
						-h d:敵兵の高さ \						// 床面からの高さ
						-x {
							print '虫の集ったレーションゲッ虫'
							mesg 電灯虫 たかり虫:04 人誘導 d:PLAYER
						}
				}
				mesg 電灯虫 たかり虫:04 物誘導 羽虫レーション４
			}
		}
	}

	/*
	proc ポスター装備 {
		if( $f:w01f_ポスター装着FLG == 1 ) {
			chara 装備品Ｃ ポスターＡ \
				-n w01alc_tobira_nu \
				-y 警備兵:03 \
				-z 2 \
				-x 500 -1000 -300 \
				-r 0 0 0 \
				-f 1
		}
	}
	*/

#define ENE_DEF_X_1  	0
#define ENE_DEF_Y_1  	0
#define ENE_DEF_Z_1  	-13000

#define ENE_DEF_X_2		10250
#define ENE_DEF_Y_2		0
#define ENE_DEF_Z_2		-18500

#define ENE_DEF_X_3		3500
#define ENE_DEF_Y_3		0
#define ENE_DEF_Z_3		-11000



	proc 中央階段守備兵 $:名前 $:ルート{
		chara 警備兵 $:名前 \
			-r $:ルート \
			-n 0 \
			-d d:ENE_DEF_X_1 d:ENE_DEF_Y_1 d:ENE_DEF_Z_1 １Ｆリフレッシュルーム \
			-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
			-l $w:敵標準体力 -f $w:敵標準気絶 -h $w:敵標準聴力 \
			-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
			-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
			-j ドッグタグ_敵兵	[ dogtag:tnk_w01f_guard_ve_01 ] \
								[ dogtag:tnk_w01f_guard_ea_01 ] \
								[ dogtag:tnk_w01f_guard_no_01 ] \
								[ dogtag:tnk_w01f_guard_ha_01 ] \
								[ dogtag:tnk_w01f_guard_vh_01 ]
	}

	proc 居眠り兵 $:名前 $:ルート{
		chara 警備兵 $:名前 \
			-r $:ルート -n 0 \
			-d d:ENE_DEF_X_2 d:ENE_DEF_Y_2 d:ENE_DEF_Z_2 １Ｆリフレッシュルーム \
			-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
			-l $w:敵標準体力 -f $w:敵標準気絶 -h $w:敵標準聴力 \
			-q レーション_敵兵羽虫 100  レーション_敵兵羽虫 100 \
			-a レーション_敵兵羽虫 100 レーション_敵兵羽虫 100 \
			-j ドッグタグ_敵兵	[ dogtag:tnk_w01f_guard_ve_02 ] \
								[ dogtag:tnk_w01f_guard_ea_02 ] \
								[ dogtag:tnk_w01f_guard_no_02 ] \
								[ dogtag:tnk_w01f_guard_ha_02 ] \
								[ dogtag:tnk_w01f_guard_vh_02 ]
		//@ポスター装備
	}

	proc 左舷守備兵 $:名前 $:ルート{
		chara 警備兵 $:名前 \
			-r $:ルート -n 0 \
			-d d:ENE_DEF_X_3 d:ENE_DEF_Y_3 d:ENE_DEF_Z_3 １Ｆリフレッシュルーム \
			//-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
			-i 5000 5000 5000 \
			-l $w:敵標準体力 -f $w:敵標準気絶 -h $w:敵標準聴力 \
			-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
			-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
			-j ドッグタグ_敵兵	[ dogtag:tnk_w01f_guard_ve_03 ] \
								[ dogtag:tnk_w01f_guard_ea_03 ] \
								[ dogtag:tnk_w01f_guard_no_03 ] \
								[ dogtag:tnk_w01f_guard_ha_03 ] \
								[ dogtag:tnk_w01f_guard_vh_03 ]
	}

	proc 警備兵セット {
		/*******************************************************************************************/
		// VERYEASY
		/*******************************************************************************************/
		if($w:ゲーム設定 <= d:LEVEL_VERYEASY) {
			if( $s:登場ポイント == 居住区一階右舷からロード ) {
				@中央階段守備兵 警備兵:01 12
				@居眠り兵		警備兵:03 5
			}else if( $s:登場ポイント == 居住区二階右からロード ) {
				@居眠り兵		警備兵:03 5
				@左舷守備兵   警備兵:02 18
			}else if( $s:登場ポイント == エンジンルーム右舷からロード ) {
				@中央階段守備兵 警備兵:01 12
				@居眠り兵		警備兵:03 5
			}else if( $s:登場ポイント == エンジンルーム左舷からロード ) {
				@中央階段守備兵 警備兵:01 12
				@居眠り兵		警備兵:03 17
			}
		/*******************************************************************************************/
		// EASY
		/*******************************************************************************************/

		} else if($w:ゲーム設定 <= d:LEVEL_EASY) {
			if( $s:登場ポイント == 居住区一階右舷からロード ) {
				@中央階段守備兵 警備兵:01 12
				@左舷守備兵		警備兵:02 2
				@居眠り兵		警備兵:03 5
			}else if( $s:登場ポイント == 居住区二階右からロード ) {
				@左舷守備兵		警備兵:02 18
				@居眠り兵		警備兵:03 5
			}else if( $s:登場ポイント == エンジンルーム右舷からロード ) {
				@中央階段守備兵 警備兵:01 12
				@左舷守備兵		警備兵:02 2
				@居眠り兵		警備兵:03 5
			}else if( $s:登場ポイント == エンジンルーム左舷からロード ) {
				@中央階段守備兵 警備兵:01 12
				@左舷守備兵	   警備兵:02 2
				@居眠り兵		警備兵:03 17
			}
		/*******************************************************************************************/
		// NORMAL
		/*******************************************************************************************/
		} else if($w:ゲーム設定 <= d:LEVEL_NORMAL) {
			if( $s:登場ポイント == 居住区一階右舷からロード ) {
				@中央階段守備兵 警備兵:01 20
				@左舷守備兵		警備兵:02 2
				@居眠り兵		警備兵:03 5
			}else if( $s:登場ポイント == 居住区二階右からロード ) {
				@左舷守備兵		警備兵:02 18
				@居眠り兵		警備兵:03 5
			}else if( $s:登場ポイント == エンジンルーム右舷からロード ) {
				@中央階段守備兵 警備兵:01 20
				@左舷守備兵		警備兵:02 2
				@居眠り兵		警備兵:03 5
			}else if( $s:登場ポイント == エンジンルーム左舷からロード ) {
				@中央階段守備兵 警備兵:01 20
				@左舷守備兵		警備兵:02 2
				@居眠り兵		警備兵:03 17
			}

		/*******************************************************************************************/
		// HARD
		/*******************************************************************************************/
		} else if($w:ゲーム設定 <= d:LEVEL_HARD) {
			if( $s:登場ポイント == 居住区一階右舷からロード ) {
				@中央階段守備兵 警備兵:01 20
				@左舷守備兵		警備兵:02 2
				@居眠り兵		警備兵:03 5
			}else if( $s:登場ポイント == 居住区二階右からロード ) {
				@中央階段守備兵 警備兵:01 20
				@左舷守備兵		警備兵:02 18
				@居眠り兵		警備兵:03 5
			}else if( $s:登場ポイント == エンジンルーム右舷からロード ) {
				@中央階段守備兵 警備兵:01 20
				@左舷守備兵		警備兵:02 2
				@居眠り兵		警備兵:03 5
			}else if( $s:登場ポイント == エンジンルーム左舷からロード ) {
				@中央階段守備兵 警備兵:01 20
				@左舷守備兵		警備兵:02 2
				@居眠り兵		警備兵:03 17
			}
		/*******************************************************************************************/
		// EXTREME or EUROPEAN_EXTREME
		/*******************************************************************************************/
		} else {
			if( $s:登場ポイント == 居住区一階右舷からロード ) {
				@中央階段守備兵 警備兵:01 21
				@左舷守備兵		警備兵:02 2
				@居眠り兵		警備兵:03 19
			}else if( $s:登場ポイント == 居住区二階右からロード ) {
				@中央階段守備兵 警備兵:01 21
				@左舷守備兵		警備兵:02 18
				@居眠り兵		警備兵:03 19
			}else if( $s:登場ポイント == エンジンルーム右舷からロード ) {
				@中央階段守備兵 警備兵:01 21
				@左舷守備兵		警備兵:02 2
				@居眠り兵		警備兵:03 19
			}else if( $s:登場ポイント == エンジンルーム左舷からロード ) {
				@中央階段守備兵 警備兵:01 21
				@左舷守備兵		警備兵:02 2
				@居眠り兵		警備兵:03 19
			}
		}
	}

/***************************************************************************************************/
// コマンダー設置プロック
/***************************************************************************************************/

	///////////////////
	// 警備兵コマンダー
	proc 警備兵コマンダー１ {
		chara 警備コマンダー 警備コマンダー -e 警備兵セット
	}

	///////////////////
	// 攻撃兵コマンダー

	proc 攻撃兵コマンダー１ {
		chara 攻撃コマンダー 攻撃コマンダー \
			// -status 0x01 \	// 危険モード時にワープ
			-e { アタッカーセット } \
			-cover 1 \
				 5000,0,-19500  9250,3000,-14500 \	// バーを挟んでのでの戦闘
				-7250,0,-19750  -3500,3000,-14000	// 本棚を挟んでの戦闘
	}

	/////////////////
	// コマンダー音声
	resource ghq_area_alert_voice {
		w01f:
			$t{
				// PLAREA0
				t:vc040010,	//「了解。階段に増援を送る。奴を止めろ」（オルガ戦前）
				-2,
				// PLAREA1
				t:vc040011,	//「了解。バックアップはリフレッシュルームへ向かえ。階段を固めろ」（オルガ戦前）
				//t:vc040012, //「了解。応援部隊、船橋一階居住区へ急行せよ。機関室への階段を固めるんだ」（オルガ戦後）
				//t:vc040013, //「わかった。増援部隊を機関室への階段に送る。奴を仕留めろ！」（オルガ戦後）
				-1
			}
	}

	resource ghq_caution_voice {
		w01f:
			$t{
				t:vc040039,	//「了解。階段に増員を送る。警戒強化せよ」（オルガ戦前）
				t:vc04003a,	//「了解。リフレッシュルームを増員。階段を固めろ」（オルガ戦前）
				//t:vc04003b, //「了解。船橋一階を増員する｡機関室への階段を固めろ」（オルガ戦後）
				//t:vc04003c, //「わかった。船橋一階階段の警備を増員する｡警戒を強化せよ」（オルガ戦後）
				-2,
				t:vc04006a,	//「リフレッシュルームとの連絡が途絶えた。」
				-1
			}
	}

	/////////////////
	// コマンダー設定

	proc 居住区１Ｆ敵兵設定 {
		chara コマンダー 敵兵セット \
			-a 攻撃兵コマンダー１ \
			-w 警備兵コマンダー１ \
			-m $w:スタートアラートモード \
			-r 7000,3000,-3000 １Ｆリフレッシュルーム \
			-c 0,0,-7000 １Ｆリフレッシュルーム \
			-b $w:敵標準再発生数 \ 		// 生き返る敵兵数
			-z $i:敵標準麻酔持続 \
			-h $i:標準警戒時間 \
			-o $i:敵標準気絶持続 \
			-x [ghq_area_alert_voice:w01f] \
			-y [ghq_caution_voice:w01f] \
			-v [ene_tank_voice:01]
	}

	// 敵兵ルート変更プロック
	proc 敵兵ルート変更 {

	}
#endif
