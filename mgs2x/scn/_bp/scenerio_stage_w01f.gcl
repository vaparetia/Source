// エフェクト
#define FOG					1	// フォグの設定
#define W01F_NEWYORK		0	// 船外景色一式
#define BONBON				0	// タンカーぼんぼり
#define RAIN_WINDOW			1	// 窓の雨粒
#define RAIN				0	// 船外の雨
