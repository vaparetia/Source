proc でかガラスオブジェクト {
#if d:LARGEGLASS
	chara プット大ガラスオブジェ でかガラス \
		-m w01f_gw2 break7d glass_pce -p 0,0,0 -l w01f \
		-broken $f:壊れフラグ＿でかガラス \
		-c ガラス割れ後サウンド設定
#endif
}

