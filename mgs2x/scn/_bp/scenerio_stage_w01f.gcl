					chara カメラ設定 ロードカメラ \
						-c 1 \
						-p 11912,114,-10500 -t 11912,-2945,-11156 \
						-r 886,2048,0 -f 3128 \
						-a 200 \
						-i 3 0 0 0 \
						-s $3

					preseek 'w02a'
					@ステージ終了時処理（ステージ名表示） 9500 -5000 -11250 3072 mv_w01f_w02a0_0 d:DEFAULT_M_TYPE d:wn_機関室右舷
				}
			}

		// ステージ開始時のカメラ
		trap ld001 d:PLAYER -mask ？ \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 0 ) {
					chara カメラ設定 ロードカメラ \
						-c 1 \
						-p 11912,114,-10500 -t 11912,-2945,-11156 \
						-r 886,2048,0 -f 3128 \
						-a 200 \
						-i 3 0 0 0 \
						-s $3
				}
			}
	#endif
#endif
}

