/***************************************************************************************************/
// マップ宣言
/***************************************************************************************************/
chara マップ １Ｆリフレッシュルーム	-k w01f0 0 0 0 -h w01f,0 -l d:LT2_NAME
chara プットオブジェ ＴＶスペース -m w01f2 -r 0,0,0 -p 0,0,0 -l d:LT2_NAME -s 100,100,100
chara プットオブジェ Ｂ１スペース -m w01f3 -r 0,0,0 -p 0,0,0 -l d:LT2_NAME -s 100,100,100
//chara プットオブジェ Ｂ１スペース天井 -m w01fr4 -r 0,0,0 -p 0,0,0 -l d:LT2_NAME -s 100,100,100
chara プットオブジェ ミニバー -m w01f1 -r 0,0,0 -p 0,0,0 -l d:LT2_NAME -s 100,100,100
chara プットオブジェ １Ｆ床 -m w01f_floor -r 0,0,0 -p 0,0,0 -l d:LT2_NAME -s 100,100,100

/* プリシェイド無しモデル */
chara プットオブジェ ソファー -m sofa_mt -r 0,0,0 -p 0,0,0 -l d:LT2_NAME -s 100,100,100 -f 1

/***************************************************************************************************/
// ロード用モデルの表示
/***************************************************************************************************/
chara プットオブジェ ロード用Ｗ０１ｂ -m w01f_w01b -r 0,0,0 -p 0,0,0 -l d:LT2_NAME -s 100,100,100
chara プットオブジェ ロード用Ｗ０１ａ１ -m w01f_w01a_1 -r 0,0,0 -p 0,0,0 -l d:LT2_NAME -s 100,100,100
chara プットオブジェ ロード用Ｗ０１ａ２ -m w01f_w01a_2 -r 0,0,0 -p 0,0,0 -l d:LT2_NAME -s 100,100,100
chara プットオブジェ ロード用Ｗ０２ａ１ -m w01f_w02_1 -r 0,0,0 -p 0,0,0 -l d:LT2_NAME -s 100,100,100
chara プットオブジェ ロード用Ｗ０２ａ２ -m w01f_w02_2 -r 0,0,0 -p 0,0,0 -l d:LT2_NAME -s 100,100,100

#if d:体験版
mesg プットオブジェ ロード用Ｗ０１ｂ off
mesg プットオブジェ ロード用Ｗ０１ａ１ off
mesg プットオブジェ ロード用Ｗ０１ａ２ off
mesg プットオブジェ ロード用Ｗ０２ａ１ off
mesg プットオブジェ ロード用Ｗ０２ａ２ off
#endif
/***************************************************************************************************/
// 居住区１Ｆリフレッシュルーム側全共通
/***************************************************************************************************/

// １Ｆリフレッシュルーム
command マップ設定 １Ｆリフレッシュルーム \
-set{

	@居住区１Ｆサウンドマネージャー設定	// ステージの最初で読み込み

	@常駐キャラ設定
	@ローカル変数初期化
	@居住区１Ｆカメラ設定
	@プレイヤー設定
	@ポーズ時ステージ名表示設定 d:wn_船橋一階リフレッシュルーム
#if d:ENEMY
	@居住区１Ｆ敵兵設定
	@敵兵ルート変更
#endif
	@居住区１ＦＢＧＭマネージャー設定	//

	@エルード設定

	@天井
	@フォグ
//	@レーダー設定
	@シナリオデモキャラセット

	@ロード時のマップ表示
	@リフレッシュルームマップ切替
	@リフレッシュルームの床のＯＮ／ＯＦＦ


// エフェクト

	@でかガラスオブジェクト
	@ミニバー棚壊れ酒瓶オブジェクト
	@ミニバーカウンター壊れグラスオブジェクト
	@テーブル壊れ酒瓶オブジェクト
	@ポプラの樹オブジェクト
	@ミニバー両開き扉オブジェクト
	@雑誌
	@大テレビ
	@アイスボックス

	@船首オブジェクト

	@船外景色エフェクト
	@タンカーぼんぼりエフェクト
	@窓から見える雨エフェクト

	@暴風エフェクト
	@植木用透明壁
	@中央階段での天井のＯＮ／ＯＦＦ

//ドアトラップ
//	@１Ｆ左舷廻廊ドア
	@水密ドア設定
	@１Ｆ右舷廻廊ドア
	@２Ｆ左舷廻廊ドア
	@２Ｆ右舷廻廊ドア
	@エンジンルーム左舷ドア
	@エンジンルーム右舷ドア
// ロードトラップ
//	@左舷から居住区１階左舷廻廊部へロード	// 水密ドアに変更
	@右舷から居住区１階右舷廻廊部へロード
	@中央階段から居住区２階左側へロード
	@中央階段から居住区２階右側へロード
	@左舷地下からエンジンルーム左側へロード
	@右舷地下からエンジンルーム右側へロード

// カメラ設定
	@子画面設定
	@リフレッシュルームカメラ
	@ミニバー下カメラ
	@中央階段カメラ
	@リフレッシュルーム前通路西カメラ
	@リフレッシュルーム前通路東カメラ
	@中央階段横左カメラ
	@中央階段横右カメラ
	@左舷カメラ
	@右舷カメラ
	// 新カメラ
	@中央階段下スペースカメラ
	@中央階段下スペース匍匐カメラ
	@大ガラス付近カメラ

	@ミニバー前カメラ
	@ミニバーカメラ
	@リフレッシュルーム左部屋カメラ
	// tv
	@リフレッシュルーム左部屋カメラ
	// b1
	@エンジンルームへの左舷階段カメラ上
	@エンジンルームへの左舷階段カメラ下
	@エンジンルーム左舷出入口カメラ
	@エンジンルームへの右舷階段カメラ上
	@エンジンルームへの右舷階段カメラ下
	@エンジンルーム右舷出入口カメラ

// アイテム
	@アイテム初期設定

// サウンド
	@サウンド変更
	@窓際の雨音

	@タンカーデジカメ写真判定
	@ブンブン羽虫
	@大ガラス用透明壁
#ifndef d:TGS2001F
	@エンジン前コンテナ塞ぎ
#endif
// 最後に行う処理
	@座標取得

// デバッグ用
#if d:MY_DEBUG
	@遠近ぼかしセット
	@写真撮影用スクリーンショット
	@ＵＳＢキーボードセット
#endif
}

/***************************************************************************************************/
// 無線関係のインクルード 位置変更不可
/***************************************************************************************************/
#include "w01f_cdc.ch"

/***************************************************************************************************/
// マップの起動
/***************************************************************************************************/
command マップ表示 -show １Ｆリフレッシュルーム

// とりあえず最後にキャラ環境光設定
@キャラ専用環境光設定

/***************************************************************************************************/
// ステージ開始時処理
/***************************************************************************************************/
// 全てのセットが終わったところでフェードイン
	if( $s:登場ポイント == 居住区一階左舷からロード ) {
		//@ステージ開始時処理 d:LOAD_TYPE:WT_DOOR_TYPE 西側廻廊部水密ドア 1300 d:M_TYPE:RUN_CHANGE
	} else if( $s:登場ポイント == 居住区一階右舷からロード ) {
		// パッドデモ表示
		if( $f:w01f_パッドデモ＿フラグ == 0 && ( $w:アラートモード == 0 )) {
			@ステージ開始時処理（デモ表示） \
					d:LOAD_TYPE:SL_DOOR_TYPE \		// タイプ
					１Ｆ右舷廻廊ドア \				// ドア名
					1475 \							// 移動距離
					d:DEFAULT_M_TYPE \				// モーションタイプ
					d:wn_船橋一階リフレッシュルーム右舷 \	// 表示文字
					w01f_paddemo_1f \				// デモファイル名
					d:ALL_OFF \						// 表示フラグ
					10274 1000 -11866 1024 \
					d:P_F_STANCE_STAND

			eval( $f:w01f_パッドデモ＿フラグ = 1 )
			#if d:VAR_SAVE
				command varsave $f:w01f_パッドデモ＿フラグ
			#endif
		}else{
			@ステージ開始時処理（ステージ名表示） \
					d:LOAD_TYPE:SL_DOOR_TYPE \			// タイプ
					１Ｆ右舷廻廊ドア \					// ドア名
					1475 \								// 移動距離
					d:DEFAULT_M_TYPE \					// モーションタイプ
					d:wn_船橋一階リフレッシュルーム右舷	// 表示文字
		}
	} else if( $s:登場ポイント == 居住区二階右からロード ) {
		if( $f:w01f_パッドデモ＿フラグ == 0 && ( $w:アラートモード == 0 )) {
			@ステージ開始時処理（デモ表示）\
				 d:LOAD_TYPE:SL_DOOR_TYPE \
				 ２Ｆ右舷廻廊ドア \
				 1500 \
				 d:DEFAULT_M_TYPE \
				 d:wn_船橋一階リフレッシュルーム \
				 w01f_paddemo_2f \
				 d:ALL_OFF \
				 2784 4000 -9326 0 \
				 d:P_F_STANCE_STAND
			eval( $f:w01f_パッドデモ＿フラグ = 1 )
			#if d:VAR_SAVE
				command varsave $f:w01f_パッドデモ＿フラグ
			#endif
		}else{
			@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:SL_DOOR_TYPE ２Ｆ右舷廻廊ドア 1500 d:DEFAULT_M_TYPE d:wn_船橋一階リフレッシュルーム
		}
	} else if( $s:登場ポイント == エンジンルーム右舷からロード ){
		@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:SL_DOOR_TYPE ドア名必要なし 2250 d:DEFAULT_M_TYPE d:wn_機関室右舷入口
		mesg プットオブジェ １Ｆ床 off
	} else if( $s:登場ポイント == エンジンルーム左舷からロード ){
		@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:SL_DOOR_TYPE ドア名必要なし 2250 d:DEFAULT_M_TYPE d:wn_機関室左舷入口
		mesg プットオブジェ １Ｆ床 off
	}

/***************************************************************************************************/
// ローカル変数初期化
/***************************************************************************************************/
	proc ローカル変数初期化 {
		eval( $b:w01f_羽虫レーションゲッ虫回数 = 0 )
	}

/***************************************************************************************************/
// 子画面設定
/***************************************************************************************************/
proc 子画面設定 {
	chara サブ画面 子画面
}

/***************************************************************************************************/
// マップ切り替え
/***************************************************************************************************/

proc ロード時のマップ表示 {
	if( $i:プレイヤー初期Ｘ位置 < 0 ){
		if( $i:プレイヤー初期Ｙ位置 >= 3000 ){
print '2F'
			mesg  プットオブジェ ＴＶスペース on
			mesg  プットオブジェ ミニバー on
			mesg  プットオブジェ Ｂ１スペース off
//			mesg  プットオブジェ Ｂ１スペース天井 off
		}else if( $i:プレイヤー初期Ｙ位置 >= 0 ){
print '1F'
			mesg  プットオブジェ ＴＶスペース off
			mesg  プットオブジェ ミニバー on
			mesg  プットオブジェ Ｂ１スペース on
//			mesg  プットオブジェ Ｂ１スペース天井 on
		}else{
print 'B1'
			mesg  プットオブジェ ＴＶスペース off
			mesg  プットオブジェ ミニバー on
			mesg  プットオブジェ Ｂ１スペース on
//			mesg  プットオブジェ Ｂ１スペース天井 on
		}
	}else{
		if( $i:プレイヤー初期Ｙ位置 >= 3000 ){
print '2F'
			mesg  プットオブジェ ＴＶスペース on
			mesg  プットオブジェ ミニバー on
			mesg  プットオブジェ Ｂ１スペース off
//			mesg  プットオブジェ Ｂ１スペース天井 off
		}else if( $i:プレイヤー初期Ｙ位置 >= 0 ){
print '1F'
			mesg  プットオブジェ ＴＶスペース on
			mesg  プットオブジェ ミニバー off
			mesg  プットオブジェ Ｂ１スペース on
//			mesg  プットオブジェ Ｂ１スペース天井 on
		}else{
print 'B1'
			mesg  プットオブジェ ＴＶスペース on
			mesg  プットオブジェ ミニバー off
			mesg  プットオブジェ Ｂ１スペース on
//			mesg  プットオブジェ Ｂ１スペース天井 on
		}
	}
}

