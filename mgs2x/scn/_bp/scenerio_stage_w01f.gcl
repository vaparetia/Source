/***************************************************************************************************/
// 水密ドアの設定
/***************************************************************************************************/

proc 水密ドア設定{
	chara 水密ドア管理 水密ドア管理人 \
			-n 1 \
			-seno 1 \
			-motions sna_hatch hatch_door_sna hatch_handle_sna
			//-adjusts 0 0 \		// 左軸ドア引き時
					 //-10 25 \	// 左軸ドア押し時
					 //0 0 \		// 右軸ドア引き時
					 //0 0 		// 右軸ドア押し時

	@左舷廻廊への水密ドア
}

proc 左舷廻廊への水密ドア {
	if( $s:登場ポイント == 居住区一階左舷からロード ) {
		chara 水密ドア 西側廻廊部水密ドア \
			-kms w01asdr_body_r w01asdr_handle \
			-position -11375 0 -10950 \
			-type 0 \	// 左軸
			-rotate 0,0,0 \
			-flag d:WT_DOOR_FLAG_OPEN_START \
			-hazard -11550,0,-11100 -10050,0,-11100 \
			-proc 左舷廻廊Ｆから左舷廻廊Ａへロード
	}else{
		chara 水密ドア 西側廻廊部水密ドア \
			-kms w01asdr_body_r w01asdr_handle \
			-position -11375 0 -10950 \
			-type 0 \	// 左軸
			-rotate 0,0,0 \
			-hazard -11550,0,-11100 -10050,0,-11100 \
			-proc 左舷廻廊Ｆから左舷廻廊Ａへロード
	}

	trap dr000 d:PLAYER \
		-mask いる -button d:ACTION_BUTTON -state 0 \
		-exec {
			command 水密ドア状態 -n 西側廻廊部水密ドア
			mesg プレイヤー d:PLAYER wt_door 西側廻廊部水密ドア $status 0,1024 -11375,-10950 1
	}

	trap dr000 d:PLAYER -mask ？ -state 6 \
		-exec {
			if( $w:アラートモード == 0 ){
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p -10808,3817,-11542 -t -10808,141,-11649 \
					-r 1005,2048,0 -f 3677 \
					-a 338 \
					-i 3 3 0 0 \
					-s $3
			}else{
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p -10750,4650,-11500 -t -10750,1000,-12000 \
					-r 935,2048,0 -f 3684 \
					-a 200 \
					-i 3 3 0 0 \
					-s $3
			}
		}
}

proc 左舷廻廊Ｆから左舷廻廊Ａへロード $:トリガ {
#if d:LOAD_W01A0L
	if( $f:ロードチェックＯＮフラグ == 1 ) {
		if ( $:トリガ == 0 ) {
			chara カメラ設定 ロードカメラ \
				-c 1 \
				-p -10750,4650,-11500 -t -10750,1000,-12000 \
				-r 935,2048,0 -f 3684 \
				-a 200 \
				-i 3 0 0 0 \
				-s 1
			preseek 'w01a'
			@ステージ終了時処理（ステージ名表示） -10750 0 -9000 0 mv_w01f_w01a_0x d:DEFAULT_M_TYPE d:wn_船橋一階居住区左舷
		}
	}
#endif
}

/***************************************************************************************************/
// トラップドア
/***************************************************************************************************/

/*
proc １Ｆ左舷廻廊ドア {
	chara ドア 南部左舷回廊へのドア \
		-m w01a_dr -d 0 0 0 -p -11550 0 -11000 -slide 2000 -time d:SD_OPEN_TIME \
		-between １Ｆリフレッシュルーム １Ｆリフレッシュルーム \
		-exec{
			if( !($:開閉フラグ) ){
				mesg プットオブジェ ロード用Ｗ０１ａ１ off
			}else{
				mesg プットオブジェ ロード用Ｗ０１ａ１ on
			}
		}
	trap dr000 ？ -mask ？ \
		-exec {
			if ( $3 == 入る ) {
				mesg ドア 南部左舷回廊へのドア open
			} else{
				mesg ドア 南部左舷回廊へのドア close
			}
		}
}
*/

proc １Ｆ右舷廻廊ドア {
	chara ドア 南部右舷回廊へのドア \
		-m w01a_dr -d 0 2048 0 -p 11550 0 -11000 -slide 2000 -time d:SD_OPEN_TIME \
		-between １Ｆリフレッシュルーム １Ｆリフレッシュルーム \
		-exec{
			if( !($:開閉フラグ) ){
				mesg プットオブジェ ロード用Ｗ０１ａ２ off
			}else{
				mesg プットオブジェ ロード用Ｗ０１ａ２ on
			}
		}

	trap dr001 ？ -mask ？ \
		-exec {
			if ( $3 == 入る ) {
				mesg ドア 南部右舷回廊へのドア open
			} else{
				mesg ドア 南部右舷回廊へのドア close
			}
		}

	chara 透明壁 覗きこみ禁止壁１ＦＲ \
			-position	9800,0,-11100,2000 \
						11800,0,-11100,2000 \
			-attribute	( d:HZX_SEG_ATR_ALL & ~(d:HZX_SEG_NO_PLAYER ))

	mesg 透明壁 覗きこみ禁止壁１ＦＲ off

	// 主観時の左右覗き込み操作禁止
	trap dr001 d:PLAYER -mask ＊ \
		-exec {
			if( `command PlayerStatus -f d:TRP_STATE_SUBJECT ` ){
				mesg 透明壁 覗きこみ禁止壁１ＦＲ on
			}else{
				mesg 透明壁 覗きこみ禁止壁１ＦＲ off
			}
		}
}

proc エンジンルーム左舷ドア {
	if( $f:w02a_ドア修理イベント == 0 ) {
		eval( $w:ローカル変数Ｗ１ = 9999 )
	} else {
		eval( $w:ローカル変数Ｗ１ = 0 )
	}
	chara ドア 左舷エンジンルームへのドア \
		-m w01a_dr -d 0 1024 0 -p -10600 -5000 -10500 -slide 2000 -time d:SD_OPEN_TIME \
		-card_level $w:ローカル変数Ｗ１ \
		-between １Ｆリフレッシュルーム １Ｆリフレッシュルーム \
		-exec{
			if( !($:開閉フラグ) ){	// 扉が完全に閉まったら
				mesg プットオブジェ ロード用Ｗ０２ａ１ off
			}else{
				mesg プットオブジェ ロード用Ｗ０２ａ１ on
			}
		}

	if( $f:w02a_ドア修理イベント == 0 ) {
		trap dr002 d:PLAYER -mask 入る \
		-exec {
			command ＳＥセットモード -s d:SD_S_BUZZER01 -p -10600 -4000 -10500 -m 0
		}
	}else{
		trap dr002 ？ -mask ＊ \
			-exec {
				if ( $3 == 入る ) {
					mesg ドア 左舷エンジンルームへのドア open
				} else if( $3 == 出る ){
					mesg ドア 左舷エンジンルームへのドア close
				}
			}
	}

	chara 透明壁 覗きこみ禁止壁Ｂ１Ｌ \
			-position	-10750,-5000,-12000,2000 \
						-10750,-5000,-10500,2000 \
			-attribute	( d:HZX_SEG_ATR_ALL & ~(d:HZX_SEG_NO_PLAYER ))

	mesg 透明壁 覗きこみ禁止壁Ｂ１Ｌ off

	// 主観時の左右覗き込み操作禁止
	trap dr002 d:PLAYER -mask ＊ /*-d 1024 256*/ \
		-exec {
			if( `command PlayerStatus -f d:TRP_STATE_SUBJECT ` ){
				//command パッド操作 -which 0 -mask ( d:PAD_L2 | d:PAD_R2 )
				mesg 透明壁 覗きこみ禁止壁Ｂ１Ｌ on
			}else{
				//command パッド操作 -which 0 -cancel 2
				mesg 透明壁 覗きこみ禁止壁Ｂ１Ｌ off
			}
		}
}

