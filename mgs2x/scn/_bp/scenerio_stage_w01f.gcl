/***************************************************************************************************/
// ビハインド時に透明壁を張って強制モーションをコントロールする
/***************************************************************************************************/
proc 植木用透明壁 {
	chara 透明壁 植木用透明壁左下 \
		-position	-6000 0 -14000 2000 \
	  				-5000 0 -14000 2000 \
	  	/*
		-attribute ( d:HZX_SEG_NO_ENEMY | d:HZX_SEG_NO_BULLET | d:HZX_SEG_NO_MISSILE | d:HZX_SEG_NO_C4 | \
					 d:HZX_SEG_NO_RECOIL | d:HZX_SEG_NO_DISP_RADAR | d:HZX_SEG_NO_BULLETHOLE | d:HZX_SEG_NO_SPRAY )
		*/
		-attribute	( d:HZX_SEG_ATR_ALL & ~(d:HZX_SEG_NO_PLAYER ))

	mesg 透明壁 植木用透明壁左下 off
	trap ev002 d:PLAYER \
		-mask ？ -state 8 \
		-exec {
			if( $3 == 入る ){
				mesg 透明壁 植木用透明壁左下 on
			}else{
				mesg 透明壁 植木用透明壁左下 off
			}
		}

	chara 透明壁 植木用透明壁左上 \
		-position	-6000 0 -14500 2000 \
	  				-5000 0 -14500 2000 \
	  	/*
		-attribute ( d:HZX_SEG_NO_ENEMY | d:HZX_SEG_NO_BULLET | d:HZX_SEG_NO_MISSILE | d:HZX_SEG_NO_C4 | \
					 d:HZX_SEG_NO_RECOIL | d:HZX_SEG_NO_DISP_RADAR | d:HZX_SEG_NO_BULLETHOLE | d:HZX_SEG_NO_SPRAY )
		*/
		-attribute		( d:HZX_SEG_ATR_ALL & ~(d:HZX_SEG_NO_PLAYER ))

	mesg 透明壁 植木用透明壁左上 off
	trap ev003 d:PLAYER \
		-mask ？ -state 8 \
		-exec {
			if( $3 == 入る ){
				mesg 透明壁 植木用透明壁左上 on
			}else{
				mesg 透明壁 植木用透明壁左上 off
			}
		}

	chara 透明壁 植木用透明壁右下 \
		-position	6000 0 -14000 2000 \
	  				5000 0 -14000 2000 \
/*
		-attribute ( d:HZX_SEG_NO_ENEMY | d:HZX_SEG_NO_BULLET | d:HZX_SEG_NO_MISSILE | d:HZX_SEG_NO_C4 | \
					 d:HZX_SEG_NO_RECOIL | d:HZX_SEG_NO_DISP_RADAR | d:HZX_SEG_NO_BULLETHOLE | d:HZX_SEG_NO_SPRAY )
*/
		-attribute	( d:HZX_SEG_ATR_ALL & ~(d:HZX_SEG_NO_PLAYER ))
	mesg 透明壁 植木用透明壁右下 off
	trap ev004 d:PLAYER \
		-mask ？ -state 8 \
		-exec {
			if( $3 == 入る ){
				mesg 透明壁 植木用透明壁右下 on
			}else{
				mesg 透明壁 植木用透明壁右下 off
			}
		}

}

