proc レーダー設定 {
#if d:RADAR
	chara レーダー レーダー

	if( $f:レーダーフラグ ) {
		mesg レーダー レーダー on
	}else{
		mesg レーダー レーダー off
	}
#endif
}

/***************************************************************************************************/
// 毎フレーム行う処理
/***************************************************************************************************/


proc 座標取得 {
	chara プロック連続実行 毎フレーム処理 \
		-time -1 \
		-exec {
			// プレイヤーの１フレーム前の座標を覚える
			eval( $i:前フレーム位置Ｘ = $i:プレイヤー位置Ｘ )
			eval( $i:前フレーム位置Ｚ = $i:プレイヤー位置Ｚ )

			// 主観なら
			if( `command PlayerStatus -f d:TRP_STATE_SUBJECT ` ){
				mesg プットオブジェ ロード用Ｗ０１ｂ on
				#if d:SHIP_HEAD
					mesg プットオブジェ 船首１ on
					mesg プットオブジェ 船首２ on
					mesg プットオブジェ 船首３ on
					mesg プットオブジェ 船首４ on
				#endif
			// ビハインドなら
			}else if( `command PlayerStatus -f d:BEHIND ` ){
print 'ON'
				if( ($i:プレイヤー位置Ｘ > -2000) && ($i:プレイヤー位置Ｘ < 2000) ){
					if( ($i:プレイヤー位置Ｚ > -11250) && ($i:プレイヤー位置Ｚ < -10000) ){
						mesg プットオブジェ ロード用Ｗ０１ｂ on
					}
				}
			}else{
				mesg プットオブジェ ロード用Ｗ０１ｂ off
				#if d:SHIP_HEAD
					mesg プットオブジェ 船首１ off
					mesg プットオブジェ 船首２ off
					mesg プットオブジェ 船首３ off
					mesg プットオブジェ 船首４ off
				#endif
			}
		}
}


/*
proc 座標取得 {
	trap ob000 d:PLAYER \
		-mask ＊ \
		-exec {
			// プレイヤーの１フレーム前の座標を覚える
			eval( $i:前フレーム位置Ｘ = $i:プレイヤー位置Ｘ )
			eval( $i:前フレーム位置Ｚ = $i:プレイヤー位置Ｚ )

			// 主観なら
			if( `command PlayerStatus -f d:TRP_STATE_SUBJECT ` ){
				mesg プットオブジェ ロード用Ｗ０１ｂ on
				#if d:SHIP_HEAD
					mesg プットオブジェ 船首１ on
					mesg プットオブジェ 船首２ on
					mesg プットオブジェ 船首３ on
					mesg プットオブジェ 船首４ on
				#endif
			// ビハインドなら
			}else if( `command PlayerStatus -f d:BEHIND ` ){
				if( ($i:プレイヤー位置Ｘ > -2000) && ($i:プレイヤー位置Ｘ < 2000) ){
					if( ($i:プレイヤー位置Ｚ > -11250) && ($i:プレイヤー位置Ｚ < -10000) ){
						mesg プットオブジェ ロード用Ｗ０１ｂ on
					}
				}
			}else{
				mesg プットオブジェ ロード用Ｗ０１ｂ off
				#if d:SHIP_HEAD
					mesg プットオブジェ 船首１ off
					mesg プットオブジェ 船首２ off
					mesg プットオブジェ 船首３ off
					mesg プットオブジェ 船首４ off
				#endif
			}
		}
}
*/

/***************************************************************************************************/
// ブンブン羽虫
/***************************************************************************************************/
	proc ブンブン羽虫 {
#if 1
		// 警備兵にまとわりつく虫
		chara 電灯虫 たかり虫:01 \
			-n	(64 * 3) \
			-p	0 -5000 -12500 \	// ライト位置 ->> プレイヤー誘導時は無視
			-b	0 \	// 下のバウンディングボックスで壁との当たり見るか  1 : 判定あり, 0 : 判定なし
			-s	200 200 200 \	// 最小ボックス座標
			-l	500 500 500	// 最大ボックス座標

		mesg 電灯虫 たかり虫:01 物誘導 警備兵:03

		// 待機虫
		chara 電灯虫 たかり虫:02 \
			-n	(64 * 3) \
			-p	0 -5000 -12500 \	// ライト位置 ->> プレイヤー誘導時は無視
			-b	0 \	// 下のバウンディングボックスで壁との当たり見るか  1 : 判定あり, 0 : 判定なし
			-s	200 200 200 \	// 最小ボックス座標
			-l	500 500 500	// 最大ボックス座標

		chara 電灯虫 たかり虫:03 \
			-n	(64 * 3) \
			-p	0 -5000 -12500 \	// ライト位置 ->> プレイヤー誘導時は無視
			-b	0 \	// 下のバウンディングボックスで壁との当たり見るか  1 : 判定あり, 0 : 判定なし
			-s	200 200 200 \	// 最小ボックス座標
			-l	500 500 500	// 最大ボックス座標

		chara 電灯虫 たかり虫:04 \
			-n	(64 * 3) \
			-p	0 -5000 -12500 \	// ライト位置 ->> プレイヤー誘導時は無視
			-b	0 \	// 下のバウンディングボックスで壁との当たり見るか  1 : 判定あり, 0 : 判定なし
			-s	200 200 200 \	// 最小ボックス座標
			-l	500 500 500	// 最大ボックス座標
#endif
	}

/*

chara 電灯虫[NewFlyingWarmScn] $s:名前 \
	-n		$i:匹数 \
	-p		$v:位置 \	// ライト位置 ->> プレイヤー誘導時は無視
	-b		$i:フラグ \	// 下のバウンディングボックスで壁との当たり見るか  1 : 判定あり, 0 : 判定なし
