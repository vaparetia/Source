/***************************************************************************************************/
// 入出ロードのproc化
/***************************************************************************************************/
proc ロードプロック {
	if ($s:呼び出しプロック == mv_w01f_w02a3_1) {
		@mv_w01f_w02a3_1
	} else if ($s:呼び出しプロック == mv_w01f_w02a0_0) {
		if ( $f:w02a_レイブンイベントフラグ == 0 ){
			if($w:アラートモード != d:ALERT_MODE_SENNYU ) {
				command セットサウンドコード -c d:SNG_FOUTS_S
			}
		}
		@mv_w01f_w02a0_0
	} else if ($s:呼び出しプロック == mv_w01f_w01a_0x) {
		@mv_w01f_w01a_0x
	} else if ($s:呼び出しプロック == mv_w01f_w01a_1) {
		@mv_w01f_w01a_1
	} else if ($s:呼び出しプロック == mv_w01f_w01b_0x) {
		@mv_w01f_w01b_0x
	} else if ($s:呼び出しプロック == mv_w01f_w01b_1) {
		@mv_w01f_w01b_1
	}
}

proc 左舷地下からエンジンルーム左側へロード {
#if d:LOAD_W02AL
	#if d:体験版
	#else
		trap ld000 d:PLAYER -mask 入る \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 1 ) {
					chara カメラ設定 ロードカメラ \
						-c 1 \
						-p -12026,-1000,-10500 -t -12026,-3715,-11223 \
						-r 700,2048,0 -f 3300 \
						-a 200 \
						-i 3 0 0 0 \
						-s $3
					preseek 'w02a'
					@ステージ終了時処理（ステージ名表示） -9500 -5000 -11250 1024 mv_w01f_w02a3_1 d:DEFAULT_M_TYPE d:wn_機関室左舷
				}
			}

		// ステージ開始時のカメラ
		trap ld000 d:PLAYER -mask ？ \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 0 ) {
					chara カメラ設定 ロードカメラ \
						-c 1 \
						-p -11912,114,-10500 -t -11912,-2945,-11156 \
						-r 886,2048,0 -f 3128 \
						-a 200 \
						-i 3 0 0 0 \
						-s $3
				}
			}
	#endif
#endif
}

