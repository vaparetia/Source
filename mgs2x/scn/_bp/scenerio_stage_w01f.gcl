proc 遠近ぼかしセット {
	chara 遠景ぼかし 遠景ぼかし１ -plane 4 -near 1000 -far 5000
	chara 遠景ぼかし 遠景ぼかし２ -plane 4 -near 5000 -far 10000
	chara 遠景ぼかし 遠景ぼかし３ -plane 4 -near 10000 -far	15000

	chara 近景ぼかし 近景ぼかし１ -plane 3 -near 0 -far 1000
	chara 近景ぼかし 近景ぼかし２ -plane 3 -near 0 -far 3000
	chara 近景ぼかし 近景ぼかし３ -plane 3 -near 0 -far 5000
}

proc 写真撮影用スクリーンショット {
	chara スクリーンショット スクリーンショット
}

proc アイテム初期設定 {
#if d:ITEM
	@アイテム再セットチェック $b:w01f_取得ロード回数[0]
	if ($f:再セットフラグ) {
		@弾薬_Ｍ９_初期設置 弾薬Ｍ９ 9000 0 -18500 0 			// バーの中
	}

	if( $w:ゲーム設定 <= d:LEVEL_NORMAL ){
		@アイテム再セットチェック $b:w01f_取得ロード回数[1]
		if ($f:再セットフラグ) {
			@レーション_初期設置 レーション -8600 0 -18250 0 		// テーブル横
		}
	}


	//if ( $b:w01f_取得ロード回数[2] == 0 ) {
	@アイテム再セットチェック $b:w01f_取得ロード回数[2]
	if ($f:再セットフラグ) {
		@弾薬_ＵＳＰ_初期設置 弾薬ＵＳＰ -12500 -5000 -12500 0 		// 左舷地下
	}

	// VERY HARDではスタンは役立たず ← 体験版のなごり 本当は役に立つけど修正しない
	//if( $w:ゲーム設定 != d:LEVEL_EXTREME ) {
	if( $w:ゲーム設定 < d:LEVEL_EXTREME ) {
		@アイテム再セットチェック $b:w01f_取得ロード回数[3]
		if ($f:再セットフラグ) {
			@スタン_初期設置 スタン 12500 -5000 -12500 0 			// 右舷地下
		}
	}
#endif
}

proc アイテム取得時番号設定 $:ボックス名 {
#if d:DEBUG_PRINT
	print 'item_no_set'
#endif

	if($:ボックス名 == 弾薬Ｍ９) {
		eval($b:w01f_取得ロード回数[0] = $w:グローバルロード回数);
	} else if ($:ボックス名 == レーション) {
		eval($b:w01f_取得ロード回数[1] = $w:グローバルロード回数);
	} else if ($:ボックス名 == 弾薬ＵＳＰ) {
		eval($b:w01f_取得ロード回数[2] = $w:グローバルロード回数);
	} else if ($:ボックス名 == スタン) {
		eval($b:w01f_取得ロード回数[3] = $w:グローバルロード回数);
	}

#if d:DEBUG_PRINT
	print $:ボックス名
	print $w:グローバルロード回数
#endif
}



