proc リフレッシュルーム前通路西カメラ {
	trap ca004 d:PLAYER \
		-mask ＊ \
		-camera \
		-exec {
			if( `command PlayerStatus -f d:TRP_STATE_GROUND` ){
				@CS_スムーズカメラ昇順 $4 -8876 -8168 0 700
					eval( $i:スライド距離Ｒ = $i:CS_結果１ )
					eval( $i:スライド距離Ｌ = 700 )
			}else{
				@CS_スムーズカメラ昇順 $4 -8876 -8168 0 1000
					eval( $i:スライド距離Ｒ = $i:CS_結果１ )
					eval( $i:スライド距離Ｌ = 1000 )
			}

			chara カメラ設定 通路カメラ０ \
				-c 0 \
				-b -8168,4787,-12413   -4100,4787,-12413 \
				-l -8168,1607,-13071   -4100,1607,-13071\
				-r 891,2048,0 -f 3247 \

				-a 200 \
				-i 0 -1 0 0 \
				-slide 0 10 $i:スライド距離Ｌ $i:スライド距離Ｒ 50 0\
				-s $3
			// カメラ切替設定 ca100で使用
			if( ($w:プレイヤー方向 > 512) && ($w:プレイヤー方向 < 1536) ){	// 東を向いていたら
				if( $i:カメラ切替 < 43 ){
					eval( $i:カメラ切替 = ( $i:カメラ切替 + 1 ) )
				}
			}else{
				eval( $i:カメラ切替 = 0 )
			}
		}
}

proc リフレッシュルーム前通路東カメラ {
	trap ca005 d:PLAYER \
		-mask ＊ \
		-camera \
		-exec {
			if( `command PlayerStatus -f d:TRP_STATE_GROUND` ){	// 匍匐中
				@CS_スムーズカメラ降順 $4 8876 8168 0 700
				eval( $i:スライド距離Ｌ = $i:CS_結果１ )
				eval( $i:スライド距離Ｒ = 700 )
			}else{
				@CS_スムーズカメラ降順 $4 8876 8168 0 1000
				eval( $i:スライド距離Ｌ = $i:CS_結果１ )
				eval( $i:スライド距離Ｒ = 1000 )
			}

			chara カメラ設定 通路カメラ０ \
				-c 0 \
				-b 4100,4787,-12413   8168,4787,-12413 \
				-l 4100,1607,-13071   8168,1607,-13071\
				-r 891,2048,0 -f 3247 \

				-a 200 \
				-i 0 -1 0 0 \
				-slide 0 10 $i:スライド距離Ｌ $i:スライド距離Ｒ 50 0\
				-s $3
			// カメラ切替設定 ca100で使用
			if( ($w:プレイヤー方向 > 2560) && ($w:プレイヤー方向 < 3584) ){	// 西を向いていたら
				if( $i:カメラ切替 < 43 ){
					eval( $i:カメラ切替 = ( $i:カメラ切替 + 1 ) )
				}
			}else{
				eval( $i:カメラ切替 = 0 )
			}
		}
}

proc 大ガラス付近カメラ{
	trap ca106 d:PLAYER \
		-mask ＊ \
		-camera \
		-exec {
			if( $3 == 入る ){
			// 南から入った場合
				if( ($w:プレイヤー方向 < 3072) && ($w:プレイヤー方向 > 1024) ) {
					eval( $w:補完方式 = 1 )
			// 北から入った場合
				}else{
					if( $4 < -3734 || $4 > 3734 ){
						eval( $w:補完方式 = 1 )
					}else{
						eval( $w:補完方式 = 0 )
					}
				}
			}
			// スライド距離の設定
			if( $w:プレイヤー方向 < 2048 ){		// プレイヤーが右向きなら
				@CS_スムーズカメラ昇順 $4 -4945 -3909 0 1000
					eval( $i:スライド距離 = $i:CS_結果１ )
			}else{								// プレイヤーが左向きなら
				@CS_スムーズカメラ降順 $4 4945 3909 0 1000
					eval( $i:スライド距離 = $i:CS_結果１ )
			}
			// カメラ補完の設定
			@CS_スムーズカメラ降順 $6 -14000 -14750 3600 4000
					eval( $i:補完ＰＸ = $i:CS_結果１ )
			if( $6 > -15500 ){
				@CS_スムーズカメラ昇順 $6 -14250 -13750 2576 5159
					eval( $i:補完ＢＹ = $i:CS_結果１ )
				@CS_スムーズカメラ昇順 $6 -14250 -13750 -11367 -10522
					eval( $i:補完ＢＺ = $i:CS_結果１ )
				@CS_スムーズカメラ昇順 $6 -14250 -13750 1055 1305
					eval( $i:補完ＬＹ = $i:CS_結果１ )
				@CS_スムーズカメラ昇順 $6 -14250 -13750 -14699 -12264
					eval( $i:補完ＬＺ = $i:CS_結果１ )
			}else{
				@CS_スムーズカメラ降順 $6 -15500 -17500 2576 2147
					eval( $i:補完ＢＹ = $i:CS_結果１ )
				@CS_スムーズカメラ降順 $6 -15500 -17500 -11367 -13099
					eval( $i:補完ＢＺ = $i:CS_結果１ )
				@CS_スムーズカメラ降順 $6 -15500 -17500 1055 1015
					eval( $i:補完ＬＹ = $i:CS_結果１ )
				@CS_スムーズカメラ降順 $6 -15500 -17500 -14699 -15539
					eval( $i:補完ＬＺ = $i:CS_結果１ )
			}

			chara カメラ設定 通路カメラ０ \
				-c 0 \
				-b (-$i:補完ＰＸ) $i:補完ＢＹ $i:補完ＢＺ   $i:補完ＰＸ $i:補完ＢＹ $i:補完ＢＺ \
				-l (-$i:補完ＰＸ) $i:補完ＬＹ $i:補完ＬＺ   $i:補完ＰＸ $i:補完ＬＹ $i:補完ＬＺ \

				-r 279 2048 0 -f 3663 \
				-a 200 \
				-i $w:補完方式 -1 0 0 \
				-slide 0 10 $i:スライド距離 $i:スライド距離 50 0\
				-s $3
	}
}

