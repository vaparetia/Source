proc セット壊れフラグ＿テレビ {
	eval( $f:壊れフラグ＿テレビ = 1 )
}

proc 大テレビ {
#if d:TELEVISION
	chara プットテレビオブジェ テレビ \
			-proc セット壊れフラグ＿テレビ \
			-m tv_back \
			-s 100 \
			-l w01f
	if ( $f:壊れフラグ＿テレビ )
	{
