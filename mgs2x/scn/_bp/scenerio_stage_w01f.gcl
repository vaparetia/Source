/***************************************************************************************************/
// トラップカメラ設定
/***************************************************************************************************/

proc 居住区１Ｆカメラ設定 {
/*
	chara カメラ ステージカメラ	-c 0 -l 3 -p 0
	chara カメラ 強制カメラ			-c 0 -l 2 -p 1
	chara カメラ 通路カメラ０		-c 0 -l 2 -p 2
	chara カメラ 通路カメラ１		-c 0 -l 2 -p 3
	chara カメラ ロードカメラ		-c 0 -l 2 -p 0
	chara カメラ モーションカメラ	-c 0 -l 2 -p 1
*/
	chara カメラ ステージカメラ		-c 0 -l 3 -p 0
	chara カメラ 通路カメラ０		-c 0 -l 2 -p 10
	chara カメラ 通路カメラ１		-c 0 -l 2 -p 20
	chara カメラ ロードカメラ		-c 0 -l 2 -p 0
	chara カメラ モーションカメラ	-c 0 -l 2 -p 5
	chara カメラ エルードカメラ		-c 0 -l 2 -p 4
	chara カメラ クリアリングカメラ	-c 1 -l 2 -p 0
	// デフォルトカメラ
	chara カメラ設定 ステージカメラ \
		-c 0 \
		-b -32000,-32000,-32000 32000,32000,32000 \
		-l -32000,-32000,-32000 32000,32000,32000 \
		-r 640,2048,0 \
		-f 6000 \
		-a 200 \
		-i 1 -1 0 0 \
		-s 1
}

proc リフレッシュルームカメラ {
	trap ca000 d:PLAYER \
		-mask ＊ \
		-camera \
		-exec {
			if( $4 < -3734 || $4 > 3734 ){
				eval( $w:カメラ補完方式 = 2 )
			}else{
				eval( $w:カメラ補完方式 = 0 )
			}
			@CS_スムーズカメラ昇順 $6 -19150 -16918 4153 4619
				eval( $i:補完ＢＸ = $i:CS_結果１ )
				eval( $i:補完ＬＸ = $i:CS_結果１ )

			@CS_スムーズカメラ昇順 $6 -18000 -17000 -15924 -15200
				eval( $i:補完ＢＺ = $i:CS_結果１ )

			@CS_スムーズカメラ昇順 $6 -18000 -17000 -18258 -15900
				eval( $i:補完ＬＺ = $i:CS_結果１ )

			chara カメラ設定 通路カメラ１ \
				-c 0 \
				-b -20000 -5000 $i:補完ＢＺ   $i:補完ＢＸ 5000 $i:補完ＢＺ \
				-l -20000 -5000 $i:補完ＬＺ   $i:補完ＬＸ 5000 $i:補完ＬＺ \
				-r 770 2048 0 -f 4964 \
				-a 200 \
				-i $w:カメラ補完方式 -1 0 0 \
				-s $3 \
				-slide 0 5 1000 1000 50 1\
		}
}

// 新カメラ設定 ca100からスタート
proc 中央階段下スペースカメラ {
	trap ca100 d:PLAYER \
		-mask ＊ \
		-camera \
		-exec {
			if( $3 == 入る)	{
				if( $i:前フレーム位置Ｘ < -5000 || $i:前フレーム位置Ｘ > 5000 ){
					if( $i:カメラ切替 == 43 )	{ eval( $w:補完方式 = 1 ) } \
					else						{ eval( $w:補完方式 = 0 ) }
				}else{
					eval( $w:補完方式 = 1 )
				}
			}

			@CS_スムーズカメラ降順 $4 4953 3000 0 1000
				eval( $i:スライド距離Ｌ = $i:CS_結果１ )
			@CS_スムーズカメラ昇順 $4 -4953 -3000 0 1000
				eval( $i:スライド距離Ｒ = $i:CS_結果１ )

			chara カメラ設定 通路カメラ１ \
				-c 0 \
				-b -3361 5159 -10522   3361 5159 -10522 \
				-l -3361 1305 -12264   3361 1305 -12264 \
				-r 424,2048,0 -f 4688 \
				-a 200 \
				-i $w:補完方式 -1 0 0 \
				-slide 0 10 $i:スライド距離Ｌ $i:スライド距離Ｒ 50 0 \
				-s $3
	}
}

proc 中央階段下スペース匍匐カメラ {
	trap ca107 d:PLAYER \
