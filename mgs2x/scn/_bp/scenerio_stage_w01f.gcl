/***************************************************************************************************/
// エンジン前コンテナ塞ぎ
/***************************************************************************************************/
	proc エンジン前コンテナ塞ぎ {
		if( `@コンテナチェック` ) {
			// コンテナ設置
			chara プットオブジェ コンテナ -m w01f_box -r 0 0 0 -p 0 0 0 -l d:LT2_NAME -s 100 100 100

			// ゾーン変更
			command セットゾーンフラグ d:HZX_ZONE_ZINTRPT 11250 0 -19000
			// 跳弾当たり追加
			command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 1
		}
	}

	proc コンテナチェック {
		#ifdef d:EU_TRIAL
			#ifdef d:GERMAN_TRIAL
				if( ($w:t_story < d:ST_T06b1Rオルガ戦勝利後無線機デモ終了) ) {
					return 1;
				} else {
					return 0;
				}
			#else
				if( ($w:t_story < d:ST_T06b1Rオルガ戦勝利後無線機デモ終了) && ($w:ゲーム設定 <= d:LEVEL_EASY) ) {
					return 1;
				} else {
					return 0;
				}
			#endif
		#else
			if( ($w:t_story < d:ST_T06b1Rオルガ戦勝利後無線機デモ終了) && ($w:ゲーム設定 <= d:LEVEL_EASY) ) {
				return 1;
			} else {
				return 0;
			}
		#endif
	}

