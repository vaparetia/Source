		-exec {
			command パッドチェック -which 0 -press
			if( $status & d:PAD_A){
				print 'push'
				command ゲット雑誌オブジェ座標 4 $i:Ｘ座標変数 $i:Ｙ座標変数 $i:Ｚ座標変数 $f:有効フラグ
				print 'X '$i:Ｘ座標変数
