*/
/***************************************************************************************************/
// サウンド変更
/***************************************************************************************************/
proc サウンド変更 {
#if d:SOUND_CHANGE
	trap ev005 d:PLAYER \
		-mask 出る \
		-exec {
			if( $4 < -10000){
				//mesg サウンドマネージャー ＳＤマネ SD_AUTO d:SD_AUTO_FADER1
				mesg ＢＧＭマネージャー ＢＧＭ SD_SNEAK_AUTO d:SD_AUTO_FADER1
			}else{
				//mesg サウンドマネージャー ＳＤマネ SD_AUTO d:SD_AUTO_FADER2
				mesg ＢＧＭマネージャー ＢＧＭ SD_SNEAK_AUTO d:SD_AUTO_FADER2
			}
	}
	trap ev006 d:PLAYER \
		-mask 出る \
		-exec {
			if( $4 > 10000){
				//mesg サウンドマネージャー ＳＤマネ SD_AUTO d:SD_AUTO_FADER1
				mesg ＢＧＭマネージャー ＢＧＭ SD_SNEAK_AUTO d:SD_AUTO_FADER1

			}else{
				//mesg サウンドマネージャー ＳＤマネ SD_AUTO d:SD_AUTO_FADER2
				mesg ＢＧＭマネージャー ＢＧＭ SD_SNEAK_AUTO d:SD_AUTO_FADER2
			}
	}
#endif
}

/***************************************************************************************************/
// 大ガラス用透明壁
/***************************************************************************************************/
proc 大ガラス用透明壁 {

	if( $f:壊れフラグ＿でかガラス == 0 ) {
		chara 透明壁 大ガラス透明壁 \
				-p -2800 0 -14250 2550 \
				   2800 0 -14250 2550 \
				-a (d:HZX_SEG_ATR_ALL & ~(d:HZX_SEG_NO_MISSILE | d:HZX_SEG_NO_C4))
	}
}

/***************************************************************************************************/
// USBキーボード
/***************************************************************************************************/
proc ＵＳＢキーボードセット {
#if d:MY_DEBUG
	chara USBキーボード実行 ＵＳＢキーボード \
			-e d:KPD_7 {
				print '7'
				eval( $f:w01f_ポスター装着FLG = 1 )
			} \
			-e d:KBD_R	{ 	command メニュー設定 -menu on -gage on -radar on -subwin on	} \
			-e d:KBD_T	{	command メニュー設定 -menu off -gage off -radar off -subwin off	} \
			-e d:KBD_0	{ restart }
#endif
}
