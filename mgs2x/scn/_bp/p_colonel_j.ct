	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_Ｅ脚１Ｆ＿ベルトコンベア＿荷物に隠れろ２:大佐_001]
		//なるほど。
	}
}//v
}//d
