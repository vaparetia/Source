//潜入プール d//e
//XBOXとPSX2で切り替えるべき音声コード
#include "vcvx.h"

//フナムシの捨て方 h //e
//proc rp_PC_フナムシ＿捨て方１:07
proc rp_PC_フナムシ＿捨て方１:07 {
vox t:vc260011 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_フナムシ＿捨て方１:大佐_000]
		//装備品をフナムシから守るには、
		//装備品をゆすってみればいい。
	}
}//v
}//d

//フナムシがレーションを食っている状態での会話 h //e
//proc rp_PC_フナムシ＿捨て方ズバリ:07
proc rp_PC_フナムシ＿捨て方ズバリ:07 {
vox t:vc260021 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_フナムシ＿捨て方ズバリ:大佐_000]
		//ライデン、レーションがフナムシに
		//食われているぞ。装備品ウィンドウを
		//揺すってフナムシを払い落とすんだ。
	}
}//v
}//d


//開かない金網ドア h //e
//proc rp_PC_開かない金網ドア:07
proc rp_PC_開かない金網ドア:07 {
vox t:vc260031 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_開かない金網ドア:大佐_000]
		//ライデン、そこの扉は開きそうにない。
		//向こう側に行くには別の経路を探す
		//しかないぞ。
	}
}//v
}//d

//ダクト近く h //e
//proc rp_PC_ダクト:07
proc rp_PC_ダクト:07 {
vox t:vc260041 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ダクト:大佐_000]
		//ライデン、足元を良く見ろ。
		//ダクトがあるぞ。ダクトには
		//ホフクすれば入り込むことが出来る。
	}
}//v
}//d
//イントルード説明へ t //e

//ホフクでくぐれるもの近く h //e
//proc rp_PC_ホフクポイント:07
proc rp_PC_ホフクポイント:07 {
vox t:vc260051 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ホフクポイント:大佐_000]
		//ライデン、その下はホフクすれば
		//潜り込むことができそうだ。
	}
	talk 大佐 標準 -m {
		 [PC_ホフクポイント:大佐_001]
		//敵に追われた時にうまく隠れれば、
		//敵から逃げることも出来るかも
		//しれないな。
	}
}//v
//イントルード説明へ t//e
}//d

//イントルード説明 h //e
//proc rp_PC_イントルード１:07
proc rp_PC_イントルード１:07 {
vox t:vc260061 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_イントルード１:大佐_000]
		//狭い所に入り込んだ時は、自動的に
		//イントルードカメラになる。
	}
}//v
}//d

//proc rp_PC_イントルード２:07
proc rp_PC_イントルード２:07 {
vox d:_vc260071 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_イントルード２:大佐_000]
		//左スティックの上で前進、下で後退、
		//左右はそれぞれの方向を向く。
	}
}//v
}//d

//proc rp_PC_イントルード３:07
proc rp_PC_イントルード３:07 {
vox t:vc260081 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_イントルード３:大佐_000]
		//敵の様子を伺いつつ、身を隠しながら
		//進むんだ。絶対に見つかるんじゃないぞ。
	}
}//v
}//d
//proc rp_PC_イントルード＿銃撃てる:07
proc rp_PC_イントルード＿銃撃てる:07 {
vox t:vc260091 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_イントルード＿銃撃てる:大佐_000]
		//ＶＲ訓練の時とは違いイントルード
		//カメラの時でも銃を撃つことが出来る。
		//忘れるなよ。
	}
}//v
}//d
//proc rp_PC_イントルード＿危険性:07
proc rp_PC_イントルード＿危険性:07 {
vox t:vc260101 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_イントルード＿危険性:大佐_000]
		//イントルードは決して安全と言うわけ
		//ではない。敵に発見されれば当然
		//攻撃を受ける。
	}
	talk 大佐 標準 -m {
		 [PC_イントルード＿危険性:大佐_001]
		//潜り込むところを敵に見られないように
		//気をつけろ。
	}
	talk 大佐 標準 -m {
		 [PC_イントルード＿危険性:大佐_002]
		//イントルードで隠れていても敵が
		//覗き込んでくる時もあるだろう。
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_イントルード＿危険性:大佐_003]
		//その時はイントルードで移動しながら
		//敵の視線をかわさなければならない。
	}
	talk 大佐 標準 -m {
		 [PC_イントルード＿危険性:大佐_004]
		//イントルードでも油断するんじゃないぞ。
		//いいな。
	}
}//v
}//d


//泳ぎ、落ちたらＣＡＬＬ h //e
//proc rp_PC_水中＿操作説明:07
proc rp_PC_水中＿操作説明:07 {
vox t:vc260111 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_水中＿操作説明:大佐_000]
		//水に入ったようだな。
		//泳ぎの基本操作はこうだ。
	}
}//v
}//d
//水面にいる h //e
//移動 t //e
//proc rp_PC_水中＿水面＿移動:07
proc rp_PC_水中＿水面＿移動:07 {
vox d:_vc260121 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_水中＿水面＿移動:大佐_000]
		//水面を泳いでいる時は左スティックの
		//上下左右でそれぞれの方向に泳ぐことが
		//出来る。
	}
}//v
}//d
//潜航 t //e
//proc rp_PC_水中＿水面＿潜航１:07
proc rp_PC_水中＿水面＿潜航１:07 {
vox t:vc260131 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_水中＿水面＿潜航１:大佐_000]
		//水面から水中に潜る時は
		//○ボタンか×ボタンを押せばいい。
	}
}//v
}//d
//proc rp_PC_水中＿水面＿潜航２:07
proc rp_PC_水中＿水面＿潜航２:07 {
vox t:vc260141 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_水中＿水面＿潜航２:大佐_000]
		//水面から水中に潜る時は○ボタンを
		//押せばいい。
	}
}//v
}//d
//水中 h //e
//proc rp_PC_水中＿前進:07
proc rp_PC_水中＿前進:07 {
vox t:vc260151 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_水中＿前進:大佐_000]
		//○ボタンを押すと水をかいて前進する。
		//連打すれば早く泳ぐことが出来るぞ。
	}
}//v
}//d
//proc rp_PC_水中＿左スティック＿正:07
proc rp_PC_水中＿左スティック＿正:07 {
vox d:_vc260161 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_水中＿左スティック＿正:大佐_000]
		//泳ぐ方向は左スティックで変えられる。
		//上で上の方、下で下の方、左右で
		//それぞれの方向を向く。
	}
}//v
}//d
//proc rp_PC_水中＿左スティック＿逆:07
proc rp_PC_水中＿左スティック＿逆:07 {
vox t:vc260171 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_水中＿左スティック＿逆:大佐_000]
		//泳ぐ方向は左スティックで変えられる。
		//上で下の方、下で上の方、左右で
		//それぞれの方向を向く。
	}
}//v
}//d
//Ｏ２について h //e
//proc rp_PC_水中＿Ｏ２:07
proc rp_PC_水中＿Ｏ２:07 {
vox t:vc260181 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_水中＿Ｏ２:大佐_000]
		//水中にいる間、ＬＩＦＥゲージの下に
		//Ｏ２ゲージが表示される。
		//Ｏ２ゲージが一回の息継ぎに相当する。
	}
	talk 大佐 標準 -m {
		 [PC_水中＿Ｏ２:大佐_001]
		//Ｏ２ゲージがゼロになると続いて、
		//ＬＩＦＥが減るぞ。注意するんだ。
	}
}//v
}//d
//一回目のみ t //e
//proc rp_PC_海底ドッグ水中:07
proc rp_PC_海底ドッグ水中:07 {
vox t:vc260191 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_海底ドッグ水中:大佐_000]
		//ＶＲミッションに水中訓練は無かった
		//だろう。いずれ水中でミッションを
		//行う必要が出てくるかも知れん。
	}
	talk 大佐 標準 -m {
		 [PC_海底ドッグ水中:大佐_001]
		//今のうちに身につけておくのも
		//いいだろう。
	}
}//v
}//d


//急速回転 h //e
//proc rp_PC_水中＿右スティック:07
proc rp_PC_水中＿右スティック:07 {
vox d:_vc260201 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_水中＿右スティック:大佐_000]
		//右スティックを使えば素早く方向を
		//変えることが出来る。左右でそれぞれの
		//方向に９０度、下で真後ろを向く。
	}
}//v
}//d
//急速浮上 h //e
//proc rp_PC_水中＿急速浮上:07
proc rp_PC_水中＿急速浮上:07 {
vox t:vc260211 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_水中＿急速浮上:大佐_000]
		//□ボタンを押せば急速に浮上することが
		//出来る。息が苦しくなった時などに
		//使うといい。
	}
}//v
}//d
//武器なし h //e
//proc rp_PC_水中＿武器ナシ:07
proc rp_PC_水中＿武器ナシ:07 {
vox t:vc260221 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_水中＿武器ナシ:大佐_000]
		//水中で武器は一切使えなくなるから
		//注意しろ。水中に敵が潜んでいるとは
		//思えんがな……。
	}
}//v
}//d
//息ガマン h //e
//proc rp_PC_水中＿息ガマン:07
proc rp_PC_水中＿息ガマン:07 {
vox t:vc260231 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_水中＿息ガマン:大佐_000]
		//水中で息が苦しくなったら△ボタンを
		//連打するんだ。そうすれば息を詰めて
		//Ｏ２ゲージの減り具合を少なく出来る。
	}
}//v
}//d

//スカルスーツの秘密 h //e
//proc rp_PC_水中＿スカルスーツ:07
proc rpb_PC_水中＿スカルスーツ:07 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_水中＿スカルスーツ:大佐_000]
		//ライデン、君のそのスカルスーツは
		//水の抵抗を最小減に抑える仕組みに
		//なっている。スーツの表面を撫でてみろ。
	}
	talk ライデン 標準 -m {
		 [PC_水中＿スカルスーツ:ライデン_001]
		//……ザラザラしている。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_水中＿スカルスーツ:大佐_002]
		//目には見えないが、表面に微少の溝が
		//並んでいるんだ。その溌水加工された
		//ウロコ状の凹凸が、水流をうち消す。
	}
	talk 大佐 標準 -m {
		 [PC_水中＿スカルスーツ:大佐_003]
		//通常よりも１０％の抵抗削減に
		//成功している。鮫の肌にヒントを
		//創られた、いわば鮫肌スーツだ。
	}
	talk 大佐 標準 -m {
		 [PC_水中＿スカルスーツ:大佐_004]
		//陸上でも空気抵抗を削減するように
		//凹凸を利用している。ゴルフボールで
		//使われている整流効果を改良したものだ。
	}
	talk ライデン 標準 -m {
		 [PC_水中＿スカルスーツ:ライデン_005]
		//なるほど、オリンピックにも
		//出場できそうだな。
	}
}
/*
proc rp_PC_水中＿スカルスーツ:07 {
vox t:vc260241 {
	@rpb_PC_水中＿スカルスーツ
}//v
}//d
*/


//ハシゴ近く h //e
//proc rp_PC_ハシゴ:07
proc rp_PC_ハシゴ:07 {
vox t:vc260251 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ハシゴ:大佐_000]
		//ライデン、ハシゴがあるな。ハシゴを
		//使うには、ハシゴに近寄って△ボタンを
		//押せばいい。
	}
}//v
}//d


//ロッカー近く h //e
//proc rp_PC_ロッカー近く１:07
proc rp_PC_ロッカー近く１:07 {
vox t:vc260261 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ロッカー近く１:大佐_000]
		//ライデン、見ろ。ロッカーがあるぞ。
		//うまくその中に隠れれば敵を
		//やりすごすことも出来るだろう。
	}
}//v
}//d
//proc rp_PC_ロッカー近く２外:07
proc rp_PC_ロッカー近く２外:07 {
vox t:vc260271 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ロッカー近く２外:大佐_000]
		//ロッカーに向かって△ボタンを押すと
		//扉を開ける。扉を開けたロッカーの中に
		//入れば、扉を閉めて隠れることが出来る。
	}
}//v
}//d
//proc rp_PC_ロッカー近く２中:07
proc rp_PC_ロッカー近く２中:07 {
vox t:vc260281 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ロッカー近く２中:大佐_000]
		//ロッカーから出るには、
		//もう一度△ボタンを押せばいい。
	}
	talk 大佐 標準 -m {
		 [PC_ロッカー近く２中:大佐_001]
		//中に入ってもスリットから外が見える。
		//外へ出る時は、敵がいないかどうか
		//よく主観で確かめるようにしろ。
	}
}//v
}//d
//proc rp_PC_ロッカー近く３:07
proc rp_PC_ロッカー近く３:07 {
vox t:vc260291 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ロッカー近く３:大佐_000]
		//扉を開けたロッカーまで倒した敵を
		//引きずっていけば、ロッカーの中に
		//敵の体を隠すことも出来る。
	}
}//v
}//d
//proc rp_PC_ロッカードア盾:07
proc rp_PC_ロッカードア盾:07 {
vox t:vc260301 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ロッカードア盾:大佐_000]
		//ロッカーを開ければ、その扉を
		//盾にして敵の銃撃を防ぐことも出来る。
	}
	talk 大佐 標準 -m {
		 [PC_ロッカードア盾:大佐_001]
		//遮蔽物が全く見当たらない時などに
		//試してみるといい。
	}
}//v
}//d
//proc rp_PC_ロッカー扉破壊:07
proc rp_PC_ロッカー扉破壊:07 {
vox t:vc260311 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ロッカー扉破壊:大佐_000]
		//ロッカーの扉は破壊することも出来る。
		//どうしても鍵のかかったロッカーを
		//開けたいのならば、壊してみろ。
	}
}//v
}//d
//proc rp_PC_ロッカー開かない:07
proc rp_PC_ロッカー開かない:07 {
vox t:vc260321 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ロッカー開かない:大佐_000]
		//ライデン、そのロッカーは鍵が
		//かかっているようだ。ロッカーを
		//使いたいなら別のを探せ。
	}
}//v
}//d

//登れる台 h //e
//proc rp_PC_段差上り１:07
proc rp_PC_段差上り１:07 {
vox t:vc260331 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_段差上り１:大佐_000]
		//ライデン、腰くらいの高さのものは
		//△ボタンを押せば上に登ることが
		//出来る。うまく使うんだ。
	}
}//v
}//d

//エルード h //e
//＊ムービー t //e
//proc rp_PC_エルード１の１:07
proc rp_PC_エルード１の１:07 {
vox t:vc260341 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エルード１の１:大佐_000]
		//腰くらいの高さの手すりは、近くで
		//△ボタンを押せば、手すりを乗り越えて
		//向こう側にぶらさがることが出来る。
	}
}//v
}//d
//＊ムービー t //e
//proc rp_PC_エルード１の２:07
proc rp_PC_エルード１の２:07 {
vox t:vc260351 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エルード１の２:大佐_000]
		//これがエルードだ。敵の視界を避ける
		//だけでなく、歩いては行けない場所に
		//辿り着くことも出来るかもしれない。
	}
}//v
}//d
//＊ムービー t //e
//proc rp_PC_エルード２の１:07
proc rp_PC_エルード２の１:07 {
vox t:vc260361 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エルード２の１:大佐_000]
		//エルード中も手すりにぶらさがりながら
		//左右に移動出来る。敵の死角に入った
		//まま移動することも可能だ。
	}
}//v
}//d
//＊ムービー t //e
//proc rp_PC_エルード２の２:07
proc rp_PC_エルード２の２:07 {
vox t:vc260371 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エルード２の２:大佐_000]
		//エルードから這い上がる時は
		//もう一度△ボタンを押せばいい。
	}
}//v
}//d
//＊ムービー t //e
//proc rp_PC_エルード３の１:07
proc rp_PC_エルード３の１:07 {
vox t:vc260381 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エルード３の１:大佐_000]
		//エルード中、ＬＩＦＥゲージの
		//下に握力ゲージが表示される。
	}
	talk 大佐 標準 -m {
		 [PC_エルード３の１:大佐_001]
		//握力ゲージは君の握力を表している。
		//エルードしている間、時間と共に
		//少しずつ減っていく。
	}
}//v
}//d
//＊ムービー t //e
//proc rp_PC_エルード３の２:07
proc rp_PC_エルード３の２:07 {
vox t:vc260391 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エルード３の２:大佐_000]
		//握力ゲージが無くなると、落下して
		//しまうぞ。そうなる前に這い上がるんだ。
	}
}//v
}//d
//エルード飛び降り h //e
//＊ムービー t //e
//proc rp_PC_エルード＿飛び降り１:07
proc rp_PC_エルード＿飛び降り１:07 {
vox t:vc260401 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エルード＿飛び降り１:大佐_000]
		//エルード中に×ボタンを押すと、
		//その場から真下に飛び降りる。
	}
}//v
}//d
//＊ムービー t //e
//proc rp_PC_エルード＿飛び降り２:07
proc rp_PC_エルード＿飛び降り２:07 {
vox t:vc260411 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エルード＿飛び降り２:大佐_000]
		//だが高過ぎる所から落ちるとＬＩＦＥが
		//減るぞ。飛び降りる時は主観で真下を
		//確認してからにするんだ。
	}
}//v
}//d

//プレイヤーの催促 h //e
//長時間いると催促される t //e
//proc rp_PC_海底ドック催促:07
proc rp_PC_海底ドック催促:07 {
vox t:vc260421 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_海底ドック催促:大佐_000]
		//ライデン、もう操作には充分慣れた
		//だろう？任務を進めてくれ。時間がない。
	}
	talk 大佐 標準 -m {
		 [PC_海底ドック催促:大佐_001]
		//そのエリアの奥にある昇降機に乗って、
		//『ビッグ・シェル』上部に上がるんだ。
	}
}//v
}//d


//水密扉。近くでＣＡＬＬ h //e
//proc rp_PC_水密扉１:07
proc rp_PC_水密扉１:07 {
vox t:vc260431 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_水密扉１:大佐_000]
		//ライデン、その扉は水密扉だ。
	}
}//v
}//d
//タンカー編をプレイしているユーザーの場合 t //e
//proc rp_PC_水密扉２:07
/*
proc rp_PC_水密扉２:07 {
vox t:vc260441 {
	@rpb_PC_水密扉２
}//v
}//d
*/

proc rpb_PC_水密扉２:07 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_水密扉２:ライデン_000]
		//ああ。開け方はわかっている。
		//ＶＲ訓練で経験済みだ。
	}
	talk 大佐 標準 -m {
		 [PC_水密扉２:大佐_001]
		//そうだったな。
		//慎重に行けよ。
	}
}//d

//タンカー編をプレイしていないユーザーの場合 t //e
//proc rp_PC_水密扉３:07
proc rp_PC_水密扉３:07 {
vox t:vc260451 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_水密扉３:大佐_000]
		//その扉を開けるには、
		//ハンドルを回さなければならない。
	}
	talk 大佐 標準 -m {
		 [PC_水密扉３:大佐_001]
		//ハンドルを回すには扉に向かって
		//△ボタンを押したままにすればいい。
	}
	talk 大佐 標準 -m {
		 [PC_水密扉３:大佐_002]
		//早く回したければ△ボタンを連打する
		//ことだ。
	}
}//v
}//d

//昇降機ホール h //e
//放置武器使用不可の説明 h //e
//敵兵を倒した際、敵兵の近くにいるとＣＡＬＬ。 t//e
//proc rp_PC_敵武器使用不可１:07
/*
proc rp_PC_敵武器使用不可１:07 {
vox t:vc260461 {
	@rpb_PC_敵武器使用不可１
}//v
}//d
*/

proc rpb_PC_敵武器使用不可１:07 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_敵武器使用不可１:大佐_000]
		//ライデン、敵の装備品は使用できないぞ。
	}
	talk ライデン 標準 -m {
		 [PC_敵武器使用不可１:ライデン_001]
		//なぜだ？
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
@rp_うんちく＿是１＿詳しいな系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_敵武器使用不可１:大佐_002]
		//わかっているだろうが、装備済みの
		//銃火器には全て個人認識装置が
		//埋め込まれている。
	}
	talk 大佐 標準 -m {
		 [PC_敵武器使用不可１:大佐_003]
		//銃火器登録時、あるいは作戦開始時に
		//認識データを入力する仕組みになって
		//いるのだ。
	}
	talk 大佐 標準 -m {
		 [PC_敵武器使用不可１:大佐_004]
		//その登録者以外がトリガーを引いても、
		//反応しないシステムが導入されている。
	}
	talk ライデン 標準 -m {
		 [PC_敵武器使用不可１:ライデン_005]
		//ロシアなどから密輸される闇銃火器には
		//これらの登録システムは採用されて
		//いないはずだが？
	}
	talk 大佐 標準 -m {
		 [PC_敵武器使用不可１:大佐_006]
		//自前で組み込んだのだろう。
		//彼らはプロだ。自分たちの装備が
		//我々の手に落ちないようにしている。
	}
	talk ライデン 標準 -m {
		 [PC_敵武器使用不可１:ライデン_007]
		//ＳＥＡＬＳの装備も同じか？
	}
	talk 大佐 標準 -m {
		 [PC_敵武器使用不可１:大佐_008]
		//そうだ。
	}
	talk ライデン 標準 -m {
		 [PC_敵武器使用不可１:ライデン_009]
		//では武器はどうやって
		//調達すればいいんだ？
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_敵武器使用不可１:大佐_010]
		//まだＩＤ登録されていないものを
		//探すんだ。
	}
	talk 大佐 標準 -m {
		 [PC_敵武器使用不可１:大佐_011]
		//登録前のものはアイテムボックスに
		//入っている。既にＶＲ訓練で学習済み
		//だろう。
	}
}//d

//無線機画面のスクリーン内にアイテムＢＯＸの映像。 t //e
//proc rp_PC_敵武器使用不可２:07
/*
proc rp_PC_敵武器使用不可２:07 {
vox t:vc260471 {
	@rpb_PC_敵武器使用不可２
}//v
}//d
*/

proc rpb_PC_敵武器使用不可２:07 {
	talk ライデン 標準 -m {
		 [PC_敵武器使用不可２:ライデン_000]
		//ああ、あれならわかる。
	}
}//d

//proc rp_PC_敵武器使用不可３:07
proc rp_PC_敵武器使用不可３:07 {
vox t:vc260481 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_敵武器使用不可３:大佐_000]
		//アイテムボックスの中に入っている
		//アイテムは自由に使用できる。
	}
	talk 大佐 標準 -m {
		 [PC_敵武器使用不可３:大佐_001]
		//武器と装備品はアイテムボックスから
		//調達するんだ。
	}
}//v
}//d

//倒れた敵兵について h //e
//・死体引きずり方法 h //e
//proc rp_PC_死体隠せ:07
proc rp_PC_死体隠せ:07 {
vox t:vc260491 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_死体隠せ:大佐_000]
		//倒した敵をそのままにしておくのは
		//危険だ。仲間が倒されたのを知れば
		//敵は当然警戒を強化してくるだろう。
	}
	talk 大佐 標準 -m {
		 [PC_死体隠せ:大佐_001]
		//敵を倒したら、すぐにその体を
		//人目につかない場所に隠すんだ。
	}
}//v
}//d
//proc rp_PC_死体引きずり方法１:07
proc rp_PC_死体引きずり方法１:07 {
vox t:vc260501 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_死体引きずり方法１:大佐_000]
		//倒れた敵の体は引きずって移動させる
		//ことが出来る。
	}
}//v
}//d
//＊ムービー t //e
//proc rp_PC_死体引きずり方法２:07
proc rp_PC_死体引きずり方法２:07 {
vox t:vc260511 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_死体引きずり方法２:大佐_000]
		//やり方は、こうだ。まず倒れた敵の近く
		//で、武器を装備せずに□ボタンを押して、
		//敵の体を抱える。
	}
	talk 大佐 標準 -m {
		 [PC_死体引きずり方法２:大佐_001]
		//□ボタンを押している間、敵を引きずり
		//ながら移動することが出来る。
		//体を下ろすには□ボタンを離せばいい。
	}
}//v
}//d


//・死体硬直 h //e
//proc rp_PC_死体硬直１:07
proc rp_PC_死体硬直１:07 {
vox t:vc260521 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_死体硬直１:大佐_000]
		//ライデン、倒した敵の体を
		//隠すつもりなら、すぐに移動させる
		//必要があるぞ。
	}
}//v
}//d
//proc rp_PC_死体硬直２:07
proc rp_PC_死体硬直２:07 {
vox t:vc260531 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_死体硬直２:大佐_000]
		//意識を失った敵はしばらくすれば目を
		//覚ます。そうでない敵も時間が経つと
		//硬直して動かせなくなる。注意しろ。
	}
}//v
}//d




//ＶＲ１面のマップ（伏線） h //e
//入り口付近。前作をプレイしている人のみ。 t //e
//proc rp_PC_海底ドックＶＲ１:07
/*
proc rp_PC_海底ドックＶＲ１:07 {
vox t:vc260541 {
	@rpb_PC_海底ドックＶＲ１
}//v
}//d
*/

proc rpb_PC_海底ドックＶＲ１:07 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_海底ドックＶＲ１:ライデン_000]
		//大佐、ここに来た記憶がある……。
	}
	talk 大佐 標準 -m {
		 [PC_海底ドックＶＲ１:大佐_001]
		//そうだろう、ＶＲミッションの１面だ。
	}
}//d

//小画面にＶＲ画面が出る。t //e
//proc rp_PC_海底ドックＶＲ２:07
/*
proc rp_PC_海底ドックＶＲ２:07 {
vox t:vc260551 {
	@rpb_PC_海底ドックＶＲ２
}//v
}//d
*/

proc rpb_PC_海底ドックＶＲ２:07 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_海底ドックＶＲ２:ライデン_000]
		//なるほど、そういえばそうだ。
	}
	talk 大佐 標準 -m {
		 [PC_海底ドックＶＲ２:大佐_001]
		//君には実戦経験こそないが、
		//それ以上にリアルなシミュレーション
		//での疑似体験がある。
	}
	talk 大佐 標準 -m {
		 [PC_海底ドックＶＲ２:大佐_002]
		//恐れるな。
		//訓練通りに進めれば問題はない。
	}
}//d

//危険モードになったら逃げろＣＡＬＬ h //e
//proc rp_PC_海底ドック危険モード回避のススメ１:07
proc rp_PC_海底ドック危険モード回避のススメ１:07 {
vox t:vc260561 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_海底ドック危険モード回避のススメ１:大佐_000]
		//ライデン、君は武器をもっていない。
		//まともにやり合っても勝ち目はないぞ！
		//南に逃げろ！通路を戻るんだ！
	}
}//v
}//d
//一回目のみ t //e
//proc rp_PC_海底ドック危険モード回避のススメ２:07
proc rp_PC_海底ドック危険モード回避のススメ２:07 {
vox t:vc260571 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_海底ドック危険モード回避のススメ２:ローズ_000]
		//ジャック！逃げて！お願い！！
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_海底ドック危険モード回避のススメ２:大佐_001]
		//南のエリアに戻れば隠れる場所がある。
		//そっちに逃げ込むんだ。
	}
}//v
}//d


//クリアリングの説明（ＣＡＬＬ）h //e
//proc rp_PC_海底ドッククリアリング中ＣＡＬＬ:07
proc rp_PC_海底ドッククリアリング中ＣＡＬＬ:07 {
vox t:vc260581 {
	talk 大佐 標準 -m {
		 [PC_海底ドッククリアリング中ＣＡＬＬ:大佐_000]
		//ライデン、じっとしているんだ！
		//奴等はクリアリングをしている。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_海底ドッククリアリング中ＣＡＬＬ:ローズ_001]
		//クリアリングって？
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_海底ドッククリアリング中ＣＡＬＬ:大佐_002]
		//クリアリングとは敵が存在する、または
		//その存在が予想される部屋、家屋などの
		//危険エリアを掃討することだ。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
@rp_うんちく＿是１＿詳しいな系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_海底ドッククリアリング中ＣＡＬＬ:大佐_003]
		//種々のＣＱＢテクニックを駆使してな。
		//クリアリングには大きくわけて二種類の
		//突入方法がある。
	}
	talk 大佐 標準 -m {
		 [PC_海底ドッククリアリング中ＣＡＬＬ:大佐_004]
		//一つがスピードと奇襲にものを言わせて
		//突入し一気に敵を制圧するダイナミック
		//エントリー。
	}
	talk 大佐 標準 -m {
		 [PC_海底ドッククリアリング中ＣＡＬＬ:大佐_005]
		//そしてもう一つがその反対に隠密裏に
		//エリアに進入、接敵し、主導権を奪う
		//ステルスエントリーだ。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_海底ドッククリアリング中ＣＡＬＬ:ローズ_006]
		//つまり、じっと隠れていないと
		//見つかるってこと？
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_海底ドッククリアリング中ＣＡＬＬ:大佐_007]
		//そういうことだな。
		//彼らは訓練されたプロだ。
		//適切な隠れ場所を見つけるんだ。
	}
}//v
}//d


//ＬＩＦＥゼロ寸前（ＣＡＬＬ／ＥＡＳＹのみ） h //e
//proc rp_PC_ＬＩＦＥゼロ寸前ＣＡＬＬ１:07
proc rp_PC_ＬＩＦＥゼロ寸前ＣＡＬＬ１:07  {
vox t:vc260591 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ＬＩＦＥゼロ寸前ＣＡＬＬ１:大佐_000]
		//ライデン、ＬＩＦＥがゼロになるぞ！
	}
}//v
}//d
//レーション持ってない場合 t //e
//proc rp_PC_ＬＩＦＥゼロ寸前ＣＡＬＬ＿レーション探せ:07
