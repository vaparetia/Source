		//聞いてみたら？
	}
}//v
}//d
//proc rp_PC_プリスキン周波数３:07
proc rp_PC_プリスキン周波数３:07 {
vox t:vc266391 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_プリスキン周波数３:ローズ_000]
		//プリスキン中尉の周波数は
		//１４１．８０でしょ？
	}
}//v
}//d

//各部の機能説明 d //e
//一般的説明 h //e
//proc rp_PC_一般機能説明:07
proc rp_PC_一般機能説明:07 {
vox t:vc266401 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_一般機能説明:ローズ_000]
		//ジャック、『ビッグ・シェル』について
		//調べてみたの。
	}
	talk ローズ 標準 -m {
		 [PC_一般機能説明:ローズ_001]
		//２年前のタンカー沈没事件によって
		//大規模な原油流出が引き起こされた。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_一般機能説明:ローズ_002]
		//『ビッグ・シェル』はその原油を回収・
		//処理し、ＮＹ湾の環境回復を図るために
		//建設された海上除染施設なの。
	}
	talk ローズ 標準 -m {
		 [PC_一般機能説明:ローズ_003]
		//『ビッグ・シェル』の周囲の海域には
		//オイルフェンスが張り巡らされて原油の
		//拡散を防いでいる。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_一般機能説明:ローズ_004]
		//フェンスのあちこちに尖塔が立ってる
		//でしょ。それが汚染海水をくみ上げる
		//ためのパイル。
	}
	talk ローズ 標準 -m {
		 [PC_一般機能説明:ローズ_005]
		//くみ上げられた海水はＡ脚のポンプ室を
		//通って、一度Ｄ脚にある第一沈殿槽に
		//溜められて大きなゴミを取り除かれる。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_一般機能説明:ローズ_006]
		//その後シェル２中央棟にある貯水槽で
		//微生物を使った二段階の浄化をされて
		//原油が取り除かれる。
	}
	talk ローズ 標準 -m {
		 [PC_一般機能説明:ローズ_007]
		//そしてＬ脚に送られて殺菌された後、
		//もう一度海上のパイルに送られて
		//放流されるって流れ。
	}
	talk ライデン 標準 -m {
		 [PC_一般機能説明:ライデン_008]
		//軍のデータベースには海上除染施設の
		//構造まで入力されてるのか。
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_一般機能説明:ローズ_009]
		//いいえ。データベースは使ってないわ。
	}
	talk ライデン 標準 -m {
		 [PC_一般機能説明:ライデン_010]
		//え？
	}
	talk ローズ 標準 -m {
		 [PC_一般機能説明:ローズ_011]
		//パンフレットに載ってたの。
	}
}//v
}//d


//Ａ脚の役割について h //e
//proc rp_PC_Ａ脚機能説明:07
proc rp_PC_Ａ脚機能説明:07 {
vox t:vc266411 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_Ａ脚機能説明:ローズ_000]
		//Ａ脚は汚染海水を海上からくみ上げ、
		//『ビッグ・シェル』各部を巡回させる
		//ための動力を供給するポンプ施設ね。
	}
	talk ローズ 標準 -m {
		 [PC_Ａ脚機能説明:ローズ_001]
		//南側がポンプ施設本体、
		//北側がその制御施設になってる。
	}
}//v
}//d

//Ｂ脚の役割について h //e
//proc rp_PC_Ｂ脚機能説明:07
proc rp_PC_Ｂ脚機能説明:07 {
vox t:vc266421 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_Ｂ脚機能説明:ローズ_000]
		//Ｂ脚は『ビッグ・シェル』の
		//電力をまかなう発電施設なの。
		//１Ｆはそのための変電設備ね。
	}
}//v
}//d


//Ｃ脚の役割について h //e
//proc rp_PC_Ｃ脚機能説明:07
proc rp_PC_Ｃ脚機能説明:07 {
vox t:vc266431 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_Ｃ脚機能説明:ローズ_000]
		//Ｃ脚は居住区。『ビッグ・シェル』
		//職員の洋上生活を支えるための施設。
	}
	talk ローズ 標準 -m {
		 [PC_Ｃ脚機能説明:ローズ_001]
		//といっても、『ビッグ・シェル』は
		//全システムがほぼ自動化されているから
		//職員の数は少ないんだけど。
	}
}//v
}//d


//Ｄ脚の役割について h //e
//proc rp_PC_Ｄ脚機能説明:07
proc rp_PC_Ｄ脚機能説明:07 {
vox t:vc266441 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_Ｄ脚機能説明:ローズ_000]
		//Ｄ脚は第一沈殿池。くみ上げた
		//汚染海水を静かに溜めて大きなゴミを
		//沈殿させ、除去するための施設ね。
	}
}//v
}//d


//Ｅ脚の役割について h //e
//proc rp_PC_Ｅ脚機能説明１:07
proc rp_PC_Ｅ脚機能説明１:07 {
vox t:vc266451 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_Ｅ脚機能説明１:ローズ_000]
		//Ｅ脚は屋上がヘリポート、
		//内部が空輸された資材を各脚に
		//送り出す施設。
	}
}//v
}//d
//屋上の場合 t //e
//proc rp_PC_Ｅ脚機能説明＿屋上:07
proc rp_PC_Ｅ脚機能説明＿屋上:07 {
vox t:vc266461 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_Ｅ脚機能説明＿屋上:ローズ_000]
		//海上がオイルフェンスで閉鎖されている
		//から、船による『ビッグ・シェル』への
		//物資輸送はほとんど行われていないの。
	}
	talk ローズ 標準 -m {
		 [PC_Ｅ脚機能説明＿屋上:ローズ_001]
		//ほぼ全ての物資が屋上のヘリポートから
		//持ち込まれるというわけね。
	}
}//v
}//d

//屋内の場合 t //e
//proc rp_PC_Ｅ脚機能説明＿集配場:07
proc rp_PC_Ｅ脚機能説明＿集配場:07 {
vox t:vc266471 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_Ｅ脚機能説明＿集配場:ローズ_000]
		//Ｅ脚内部には物資を自動でよりわける
		//システムが完備されているわ。
	}
	talk ローズ 標準 -m {
		 [PC_Ｅ脚機能説明＿集配場:ローズ_001]
		//ダンボール箱を認識して判別している
		//みたい。自動で荷物を各脚に配送する
		//ことで省人力化を図っているってことね。
	}
}//v
}//d

//Ｆ脚の役割について h //e
//proc rp_PC_Ｆ脚機能説明:07
proc rp_PC_Ｆ脚機能説明:07 {
vox t:vc266481 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_Ｆ脚機能説明:ローズ_000]
		//Ｆ脚は倉庫。『ビッグ・シェル』の
		//メンテナンス用に様々な資材が
		//備蓄されていると思う。
	}
	talk ローズ 標準 -m {
		 [PC_Ｆ脚機能説明:ローズ_001]
		//あなたの役に立つものもあるかも
		//しれない。探してみたら？
	}
}//v
}//d


//シェル１中央棟の役割について h //e
//proc rp_PC_シェル１中央棟機能説明:07
proc rp_PC_シェル１中央棟機能説明:07 {
vox t:vc266491 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_シェル１中央棟機能説明:ローズ_000]
		//シェル１中央棟は文字どおり
		//『ビッグ・シェル』の中心ね。
	}
	talk ローズ 標準 -m {
		 [PC_シェル１中央棟機能説明:ローズ_001]
		//Ｂ１には大規模な集会場がある。
		//そこで大統領と環境保護視察団の歓迎
		//レセプションが行われたはずよ。
	}
	talk ローズ 標準 -m {
		 [PC_シェル１中央棟機能説明:ローズ_002]
		//でもその機能の中枢はＢ２にある
		//電算室に集約されてるの。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_シェル１中央棟機能説明:ローズ_003]
		//この電算室で汚染海水の循環や除染
		//状態の監視等、各施設の管理を全て
		//行うようになってる。
	}
	talk ローズ 標準 -m {
		 [PC_シェル１中央棟機能説明:ローズ_004]
		//警備が厳重なのもうなずけるわね。
	}
}//v
}//d

//シェル２中央棟の役割について h //e
//proc rp_PC_シェル２中央棟機能説明:07
proc rp_PC_シェル２中央棟機能説明:07 {
vox t:vc266501 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_シェル２中央棟機能説明:ローズ_000]
		//シェル２中央棟は汚染海水を除染する
		//システムの本体……だった。
		//今は見る影もないけど……。
	}
	talk ローズ 標準 -m {
		 [PC_シェル２中央棟機能説明:ローズ_001]
		//炭化水素分解細菌等の微生物を使って、
		//くみ上げた原油混じりの海水を
		//除染する施設。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_シェル２中央棟機能説明:ローズ_002]
		//Ｂ１以下はそのための巨大な水槽に
		//なっていたの。それが壊れて浸水
		//してるってわけね。
	}
	talk ローズ 標準 -m {
		 [PC_シェル２中央棟機能説明:ローズ_003]
		//浸水していない１Ｆは汚染海水の悪臭を
		//除去するための空気清浄施設。
	}
	talk ローズ 標準 -m {
		 [PC_シェル２中央棟機能説明:ローズ_004]
		//マンハッタンのすぐ近くだもの。
		//気を使うことが多いみたいね。
	}
}//v
}//d

