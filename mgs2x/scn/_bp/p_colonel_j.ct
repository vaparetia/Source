//ソリダス戦中 愛国説教 h //e
//proc rp_PC_ソリダス戦中＿愛国説教:07
proc rp_PC_ソリダス戦中＿愛国説教:07 {
vox t:vc266861 {
@rp_うなづきデフォルト＿是
@rp_邪道外道＿否１＿サイテー系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_ソリダス戦中＿愛国説教:大佐_000]
		//ライデン、ソリダスと戦え！
		//それが君の最後の役割だ！
	}
	talk ライデン 標準 -m {
		 [PC_ソリダス戦中＿愛国説教:ライデン_001]
		//俺達はシミレーション・ゲームの
		//駒じゃない！
	}
	@rpd_ローズ顔表示
@rp_愛国ローズ白目変化
@rp_セクハラ＿是１＿かわいい系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_ソリダス戦中＿愛国説教:ローズ_002]
		//いいえ。あなた達はただの兵器。
		//戦闘機や戦車とかわりないのよ。
	}
@rp_愛国ローズ白目変化
	talk ライデン 標準 -m {
		 [PC_ソリダス戦中＿愛国説教:ライデン_003]
		//なんだと？
	}
	@rp_発狂中大佐顔初期化処理
	@rp_大佐発狂中顔表示
@rp_うなづきデフォルト＿是
	talk 大佐 標準 -m {
		 [PC_ソリダス戦中＿愛国説教:大佐_004]
		//４年前に破壊された旧型は『ＲＥＸ』……
	}
	@rpd_ローズ顔表示
@rp_愛国ローズ白目変化
@rp_セクハラ＿是＿やりたがり系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_ソリダス戦中＿愛国説教:ローズ_005]
		//新型の水陸両用は『ＲＡＹ』……
	}
	@rp_発狂中大佐顔初期化処理
	@rp_大佐発狂中顔表示
@rp_うなづきデフォルト＿是
	talk 大佐 標準 -m {
		 [PC_ソリダス戦中＿愛国説教:大佐_006]
		//どちらも第二次大戦中、米軍が日本軍の
		//軍用機につけたコードネーム。
	}
	@rpd_ローズ顔表示
@rp_愛国ローズ白目変化
@rp_セクハラ＿是１＿かわいい系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_ソリダス戦中＿愛国説教:ローズ_007]
		//あなたのコードネーム『ライデン』も
		//日本海軍の局地戦闘機『雷電』から
		//来ている……。
	}
@rp_愛国ローズ白目変化
	talk ライデン 標準 -m {
		 [PC_ソリダス戦中＿愛国説教:ライデン_008]
		//ふざけるな！俺は兵器じゃない！！
	}
@rp_愛国ローズ白目変化
	talk ローズ 標準 -m {
		 [PC_ソリダス戦中＿愛国説教:ローズ_009]
		//そうかしら？
		//『雷電』に米軍がつけたコードネームが
		//なんだか知ってる？
	}
	@rp_発狂中大佐顔初期化処理
	@rp_大佐発狂中顔表示
@rp_うなづきデフォルト＿是
	talk 大佐 標準 -m {
		 [PC_ソリダス戦中＿愛国説教:大佐_010]
		//ジャックだよ。
	}
	talk 大佐 標準 -m {
		 [PC_ソリダス戦中＿愛国説教:大佐_011]
		//貴様らは利用されて捨てられる
		//兵器なのだ。
	}
	@rpd_ローズ顔表示
@rp_愛国ローズ白目変化
@rp_セクハラ＿是＿やりたがり系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_ソリダス戦中＿愛国説教:ローズ_012]
		//兵器として戦場で利用される。
		//まさにゲームの駒。
	}
	@rp_発狂中大佐顔初期化処理
	@rp_大佐発狂中顔表示
@rp_うなづきデフォルト＿是
	talk 大佐 標準 -m {
		 [PC_ソリダス戦中＿愛国説教:大佐_013]
		//兵器に考える資格はない！
		//さあ、役割を果たせ！
		//ソリダスを倒すんだ！！
	}
}//v
}//d

