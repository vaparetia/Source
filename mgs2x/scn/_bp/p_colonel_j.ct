//★P055_04_P03ヴァンプ戦前４ポリゴンデモ３終了＜フラグ＜P057_01_P01ヴァンプ戦終了１ポリゴンデモ１開始 d //e
//ヴァンプ戦 h //e
//弾が当たらない。h //e
//proc rp_PC_ヴァンプ戦＿弾当たらない１:07
proc rp_PC_ヴァンプ戦＿弾当たらない１:07 {
vox t:vc264011 {
@rp_うなづきデフォルト＿是
@rp_無茶指令＿否１＿お前がやれ系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_ヴァンプ戦＿弾当たらない１:大佐_000]
		//ヴァンプは君の筋肉の動きから銃口の
		//向きを予測し、着弾点を読むようだ。
	}
	talk 大佐 標準 -m {
		 [PC_ヴァンプ戦＿弾当たらない１:大佐_001]
		//だが完璧な読みなどありえない。
		//必ず奴に攻撃を当てる方法はあるはずだ。
	}
}//v
}//d

//ズバリヒント h //e
//proc rp_PC_ヴァンプ戦＿弾当たらないズバリ:07
proc rp_PC_ヴァンプ戦＿弾当たらないズバリ:07 {
vox t:vc264021 {
@rp_うなづきデフォルト＿是
@rp_無茶指令＿否１＿お前がやれ系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_ヴァンプ戦＿弾当たらないズバリ:大佐_000]
		//ライデン、ロックオンは使うな。
		//弾筋を読まれるぞ。主観攻撃で狙うんだ。
		//自動小銃で弾幕を張ってもいいだろう。
	}
}//v
}//d

//基本戦法 h //e
//proc rp_PC_ヴァンプ戦＿基本戦法１:07
proc rp_PC_ヴァンプ戦＿基本戦法１:07 {
vox t:vc264031 {
@rp_うなづきデフォルト＿是
@rp_無茶指令＿否１＿お前がやれ系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_ヴァンプ戦＿基本戦法１:大佐_000]
		//ライデン、奴が水の上にいる時は不利だ。
		//陸に上がった時に攻撃する方がいい
		//だろう。
	}
	talk 大佐 標準 -m {
		 [PC_ヴァンプ戦＿基本戦法１:大佐_001]
		//奴が近づいてきた時がチャンスだ。
		//主観攻撃で狙え！
	}
}//v
}//d

//水中では弾は効かない。h //e
//proc rp_PC_ヴァンプ戦＿水中弾当たらん:07
