@rp_うなづきデフォルト＿是
@rp_キテレツさん＿否２＿意味不明系デフォルト 50
	talk 大佐 標準 -m {
		 [PC_発狂＿ＭＧＳ２:大佐_000]
		//ＰＳＧ１を手に入れたんだな？それが
		//あればスナイパー・ウルフに対抗できる
		//はずだ。メリルを助けてくれ！
	}
}//v
}//d
