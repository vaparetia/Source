@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_拘束解除後＿合流しろ＿拷問部屋以外:大佐_000]
		//ライデン、あの男と合流して装備を
		//取り戻すんだ。二階の北東に扉がある。
		//そちらへ向かえ。
	}
}//v
}//d

//裸注意 h //e
//proc rp_PC_裸注意＿操作制限１:07
proc rp_PC_裸注意＿操作制限１:07 {
vox t:vc264581 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_裸注意＿操作制限１:大佐_000]
		//ライデン、今の状態ではエルード、
		//投げ、首絞めなどは使えないぞ
	}
}//v
}//d
//一回目のみ t //e
//proc rp_PC_裸注意＿操作制限２:07
proc rp_PC_裸注意＿操作制限２:07 {
vox t:vc264591 {
	talk ライデン 標準 -m {
		 [PC_裸注意＿操作制限２:ライデン_000]
		//なぜ？
	}
	talk 大佐 標準 -m {
		 [PC_裸注意＿操作制限２:大佐_001]
		//なぜって……そのざまでそんなことを
		//したらいろいろと問題があるだろう。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_キテレツさん＿否１＿なんだこいつ系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_裸注意＿操作制限２:ローズ_002]
		//もう……わかるでしょ、ジャック？
		//いやね。
	}
	talk ライデン 標準 -m {
		 [PC_裸注意＿操作制限２:ライデン_003]
		//……？
	}
}//v
}//d

//裸操作 h //e
//proc rp_PC_裸注意＿操作制限３:07
proc rp_PC_裸注意＿操作制限３:07 {
vox t:vc264601 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_裸注意＿操作制限３:大佐_000]
		//ライデン、今の君は武器を何も持って
		//いない。パンチも片手だけになって
		//連続技も出せないだろう。
	}
	talk 大佐 標準 -m {
		 [PC_裸注意＿操作制限３:大佐_001]
		//つまり敵に発見されたら反撃する術は
		//ほとんどないということだ。
		//絶対に見つからないようにしろよ。
	}
}//v
}//d

//風邪状態 h //e
//一回目のみ t //e
//proc rp_PC_裸注意＿風邪１:07
proc rp_PC_裸注意＿風邪１:07 {
vox t:vc264611 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_裸注意＿風邪１:ライデン_000]
		//ハックション！
	}
	talk 大佐 標準 -m {
		 [PC_裸注意＿風邪１:大佐_001]
		//どうしたライデン、風邪か？
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_セクハラ＿否１＿ワガママ系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_裸注意＿風邪１:ローズ_002]
		//寒いところをそんな格好でうろちょろ
		//するから……。大丈夫？
	}
	talk ライデン 標準 -m {
		 [PC_裸注意＿風邪１:ライデン_003]
		//ああ。大丈夫……ハックション！
	}
	talk ローズ 標準 -m {
		 [PC_裸注意＿風邪１:ローズ_004]
		//でもないみたいね。
	}
}//v
}//d
//proc rp_PC_裸注意＿風邪２:07
proc rp_PC_裸注意＿風邪２:07 {
vox t:vc264621 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_裸注意＿風邪２:大佐_000]
		//風邪はなんとかした方がいいな。
		//くしゃみを連発していたらその音で
		//敵に見つかるかもしれない。
	}
	talk 大佐 標準 -m {
		 [PC_裸注意＿風邪２:大佐_001]
		//風邪薬を飲めば何とかなるだろう。
	}
}//v
}//d
//あいまいヒント t //e
//proc rp_PC_裸注意＿風邪３:07
proc rp_PC_裸注意＿風邪３:07 {
vox t:vc264631 {
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_裸注意＿風邪３:ローズ_000]
		//とりあえずあったかくするのも
		//いいんじゃない？
	}
}//v
}//d
//ズバリヒント t //e
//proc rp_PC_裸注意＿風邪＿ダンボール:07
proc rp_PC_裸注意＿風邪＿ダンボール:07 {
vox t:vc264641 {
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_裸注意＿風邪＿ダンボール:ローズ_000]
		//ダンボール箱でもかぶってみたら？
		//そのカッコよりはましでしょ。
	}
}//v
}//d

//裸時はダメージも大きい h //e
//proc rp_PC_裸注意＿ダメージ:07
proc rp_PC_裸注意＿ダメージ:07 {
vox t:vc264651 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_裸注意＿ダメージ:大佐_000]
		//ライデン、身を守るものが何もない
		//その状態では受けるダメージも普段より
		//大きくなる。絶対に戦闘はさけろよ。
	}
}//v
}//d


//★P072_01_R01大佐混乱１無線機デモ１終了＜フラグ＜P073_01_R01通路Ａ１無線機デモ１開始 d //e
//大佐発狂 h //e
