	}
	talk ライデン 標準 -m {
		 [PC_シェル１中央棟Ｂ２＿エマ席:ライデン_002]
		//ああ。仮にも仕事場にこんなものを
		//持ち込むなんて、きっとろくでもない
		//奴に違いない。顔が見てみたいものだ。
	}
@rp_うなづきデフォルト
}//v
}//d

//シェル１中央棟Ｂ１ホール(w24c) d //e
//エイムズ探し h //e
//マイクを使え h //e
//proc rp_PC_人質＿マイク使え:07
proc rp_PC_人質＿マイク使え:07 {
vox t:vc261811 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_人質＿マイク使え:大佐_000]
		//ライデン、そこに捕らわれている
		//人質達の中にエイムズがいる。
	}
	talk 大佐 標準 -m {
		 [PC_人質＿マイク使え:大佐_001]
		//エイムズは心臓にペースメイカーを
		//つけているらしい。心音が違うはずだ。
		//指向性マイクを使って聞き分けろ。
	}
}//v
}//d
//マイクを持っている場合 t //e
//proc rp_PC_人質＿あんたがエイムズ１:07
proc rp_PC_人質＿あんたがエイムズ１:07 {
vox t:vc261821 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_人質＿あんたがエイムズ１:大佐_000]
		//心音を聞いてエイムズを特定したら、
		//マイクをその人質に向けたまま
		//△ボタンを押して呼びかけるんだ。
	}
}//v
}//d
//一回目のみ t //e
//proc rp_PC_人質＿あんたがエイムズ２:07
proc rp_PC_人質＿あんたがエイムズ２:07 {
vox t:vc261831 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_人質＿あんたがエイムズ２:大佐_000]
		//その人質が本当にエイムズだったら、
		//何らかの反応を示すはず。
	}
	talk ライデン 標準 -m {
		 [PC_人質＿あんたがエイムズ２:ライデン_001]
		//もし間違ったら？
	}
	talk 大佐 標準 -m {
		 [PC_人質＿あんたがエイムズ２:大佐_002]
		//物音を聞きつけて敵がやってくるかも
		//しれんな。場合によっては警備が
		//強化されるかもしれん。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_人質＿あんたがエイムズ２:ローズ_003]
		//うかつに呼びかけない方がよさそうね。
	}
}//v
}//d
//proc rp_PC_人質＿あんたがエイムズ３:07
proc rp_PC_人質＿あんたがエイムズ３:07 {
vox t:vc261841 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_人質＿あんたがエイムズ３:大佐_000]
		//エイムズに△ボタンで呼びかけるのは
		//その相手がエイムズだと確信出来て
		//からにしろ。
	}
	talk 大佐 標準 -m {
		 [PC_人質＿あんたがエイムズ３:大佐_001]
		//もし間違えたら、敵に見つかる前に
		//マイクをＡＫに持ち替えてその場を
		//離れた方がいい。
	}
}//v
}//d
//人質＿見つかるな２へ t //e
//マイクを持っていない場合 //e
//proc rp_PC_人質＿マイク探せ:07
proc rp_PC_人質＿マイク探せ:07 {
vox t:vc261851 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_人質＿マイク探せ:大佐_000]
		//だが君は指向性マイクを持っていない
		//ようだな。まずは指向性マイクを手に
		//入れるんだ。
	}
	talk 大佐 標準 -m {
		 [PC_人質＿マイク探せ:大佐_001]
		//マイクを使うしかエイムズを
		//見分ける方法はない。
	}
}//v
}//d
//proc rp_PC_人質＿マイク場所１:07
proc rp_PC_人質＿マイク場所１:07 {
vox t:vc261861 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_人質＿マイク場所１:大佐_000]
		//指向性マイクはシェル１中央棟の
		//どこかにあるはずだ。
	}
}//v
}//d
//proc rp_PC_人質＿マイク場所２:07
proc rp_PC_人質＿マイク場所２:07 {
vox t:vc261871 {
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_人質＿マイク場所２:ローズ_000]
		//中央棟のＢ２は調べてみた？
	}
}//v
}//d
//マイクの使い方 h //e
//proc rp_PC_人質＿マイク使い方:07
proc rp_PC_人質＿マイク使い方:07 {
vox d:_vc261881 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_人質＿マイク使い方:大佐_000]
		//指向性マイクを装備すると主観画面に
		//なる。左スティックでマイクを人質の
		//方向に向けるんだ。
	}
	talk 大佐 標準 -m {
		 [PC_人質＿マイク使い方:大佐_001]
		//それで人質の心音を聞くことが出来る。
		//ペースメイカーの音を聞き分けろ。
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_人質＿マイク使い方:大佐_002]
		//その相手がエイムズだと確信したら
		//マイクを向けたまま△ボタンを押して
		//呼びかけるんだ。
	}
	talk 大佐 標準 -m {
		 [PC_人質＿マイク使い方:大佐_003]
		//手当たり次第に呼びかけたりするなよ。
		//敵に怪しまれるぞ。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_人質＿マイク使い方:ローズ_004]
		//あと指向性マイクを装備している間は
		//移動が出来なくなるから気をつけてね。
	}
}//v
}//d
//マイク注意 h //e
//proc rp_PC_人質＿マイク注意:07
proc rp_PC_人質＿マイク注意:07 {
vox t:vc261891 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_人質＿マイク注意:大佐_000]
		//指向性マイクを使っているところを
		//敵に見つかると怪しまれるぞ。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_人質＿マイク注意:ローズ_001]
		//マイクを装備するのはまわりに誰も
		//いないのを確かめてからにした方が
		//いいと思う。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_人質＿マイク注意:大佐_002]
		//万一、怪しまれたらすぐに武器を
		//ＡＫに持ち変えろ。見つかったら
		//終わりだぞ。いいな。
	}
}//v
}//d

//見つかると即ゲームオーバー h //e
//proc rp_PC_人質＿見つかるな１:07
proc rp_PC_人質＿見つかるな１:07 {
vox t:vc261901 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_人質＿見つかるな１:大佐_000]
		//ライデン、その集会場では絶対に
		//見つかるなよ。そのエリアには
		//出入口が一つしかない。
	}
}//v
}//d
//proc rp_PC_人質＿見つかるな２:07
proc rp_PC_人質＿見つかるな２:07 {
vox t:vc261911 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_人質＿見つかるな２:大佐_000]
		//そこで敵に見つかったら退路を
		//断たれた上に増援部隊を呼ばれる。
		//とても切り抜けることは出来ないだろう。
	}
	talk 大佐 標準 -m {
		 [PC_人質＿見つかるな２:大佐_001]
		//見つかったら終わりだ。変装して、敵の
		//目をあざむきならがエイムズを探すんだ。
		//いいな。
	}
}//v
}//d

//敵は定期連絡してる h //e
//proc rp_PC_人質＿敵兵定時連絡:07
proc rp_PC_人質＿敵兵定時連絡:07 {
vox t:vc261921 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_人質＿敵兵定時連絡:大佐_000]
		//ライデン、人質の見張りをしている
		//敵兵士は定期的に仲間と連絡をとって
		//いるようだ。
	}
	talk 大佐 標準 -m {
		 [PC_人質＿敵兵定時連絡:大佐_001]
		//気絶させたり眠らせたりして定期連絡が
		//途絶えると見つかるぞ。そのエリアでは
		//敵に一切手を出すな。
	}
}//v
}//d

//人質殺してはいけない h //e
//一回目のみ t //e
//proc rp_PC_人質＿人質殺すな１:07
proc rp_PC_人質＿人質殺すな１:07 {
vox t:vc261931 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_人質＿人質殺すな１:大佐_000]
		//ライデン、わかっていると思うが、
		//人質を傷つけたりするなよ。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_人質＿人質殺すな１:ローズ_001]
		//言われなくてもそんなヒドイこと
		//しないわよね？
	}
}//v
}//d
//proc rp_PC_人質＿人質殺すな２:07
proc rp_PC_人質＿人質殺すな２:07 {
vox t:vc261941 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_人質＿人質殺すな２:大佐_000]
		//敵は人質を見張っている。人質に
		//異状が起きれば、すぐに侵入者がいると
		//気づくはずだ。
	}
	talk 大佐 標準 -m {
