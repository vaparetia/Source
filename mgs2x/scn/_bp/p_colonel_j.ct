		//すれば、その間エマと手をつなぐ。
	}
	talk 大佐 標準 -m {
		 [PC_エマ手つなぎ＿手つなぎ:大佐_001]
		//そのまま移動すればエマの手を引いて
		//歩くことが出来る。
	}
	talk 大佐 標準 -m {
		 [PC_エマ手つなぎ＿手つなぎ:大佐_002]
		//手を離したくなったら△ボタンを
		//離せばいい。
	}
}//v
}//d
