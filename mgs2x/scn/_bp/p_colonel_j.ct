//Ｌ１ボタンロックオン h //e
//proc rp_PC_Ｌ１ボタンロックオン:07
proc rp_PC_Ｌ１ボタンロックオン:07 {
vox d:_vc266351 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_Ｌ１ボタンロックオン:大佐_000]
		//銃を構えた状態でＬ１ボタンを押すと
		//ロックオンが出来る。素早く狙いを
		//定める時には役立つはずだ。
	}
	talk 大佐 標準 -m {
		 [PC_Ｌ１ボタンロックオン:大佐_001]
		//ただロックオンで狙えるのは
		//敵の胴体のみだ。急所を狙う場合は
		//主観攻撃を使え。
	}
}//v
}//d

//エレベータは敵兵が中にいると動かない h //e
//proc rp_PC_エレベータ敵兵動かない:07
proc rp_PC_エレベータ敵兵動かない:07 {
vox t:vc266361 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エレベータ敵兵動かない:大佐_000]
		//ライデン、エレベータは中に敵が
		//いる時は動作しない。エレベータの外に
		//敵を連れ出すんだ。
	}
}//v
}//d
//スネークの周波数 無線していない場合１ h //e
