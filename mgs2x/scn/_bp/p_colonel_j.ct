vox t:vc260601 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ＬＩＦＥゼロ寸前ＣＡＬＬ＿レーション探せ:大佐_000]
		//レーションを探すんだ。レーションを
		//使えばＬＩＦＥを回復出来る。
		//南のエリアの東にあったはずだ。
	}
}//v
}//d

//レーション持っている場合 t //e
//proc rp_PC_ＬＩＦＥゼロ寸前ＣＡＬＬ＿レーション使え:07
