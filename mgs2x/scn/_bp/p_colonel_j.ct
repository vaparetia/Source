	}
	talk ライデン 標準 -m {
		 [PC_エマ手つなぎ＿引きずり２:ライデン_002]
		//いや、なにも。
	}
	talk ローズ 標準 -m {
		 [PC_エマ手つなぎ＿引きずり２:ローズ_003]
		//ふーん……。
	}
}//v
}//d
//proc rp_PC_エマ手つなぎ＿引きずり３:07
proc rp_PC_エマ手つなぎ＿引きずり３:07 {
vox t:vc264261 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エマ手つなぎ＿引きずり３:大佐_000]
		//意識を失ったエマを危険な場所に放って
		//おくな。安全な場所まで引きずってて
		//でも連れて行くんだ。
	}
}//v
}//d

