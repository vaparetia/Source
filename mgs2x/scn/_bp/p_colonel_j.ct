		//『ビッグ・シェル』外部でリモコン
		//ミサイルは使えないぞ。ＰＳＧ１で
		//エマを攻撃するものを排除するんだ。
	}
}//v
}//d

//エマ撃つな h //e
//proc rp_PC_エマ狙撃＿エマ撃つな１:07
proc rp_PC_エマ狙撃＿エマ撃つな１:07 {
vox t:vc266241 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エマ狙撃＿エマ撃つな１:大佐_000]
		//ライデン、わかっているとは思うが
		//エマを攻撃したりするなよ。
	}
}//v
}//d
//攻撃したことがある場合 t //e
//proc rp_PC_エマ狙撃＿エマ撃つな２:07
proc rp_PC_エマ狙撃＿エマ撃つな２:07 {
vox t:vc266251 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_エマ狙撃＿エマ撃つな２:ローズ_000]
		//そんなことしないわよね？
	}
	talk ライデン 標準 -m {
		 [PC_エマ狙撃＿エマ撃つな２:ライデン_001]
		//……。
	}
@rp_つっこまれ＿是１＿なんで知ってるんだ系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_エマ狙撃＿エマ撃つな２:ローズ_002]
		//まさか……またやる気？
	}
	talk ライデン 標準 -m {
		 [PC_エマ狙撃＿エマ撃つな２:ライデン_003]
		//まさか！そんなわけないだろう。
	}
	talk ローズ 標準 -m {
		 [PC_エマ狙撃＿エマ撃つな２:ローズ_004]
		//そうよね。まさか！
	}
	talk ライデン 標準 -m {
		 [PC_エマ狙撃＿エマ撃つな２:ライデン_005]
		//そう、まさか！はははは……
	}
	talk ローズ 標準 -m {
		 [PC_エマ狙撃＿エマ撃つな２:ローズ_006]
		//ふふふふ……
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_エマ狙撃＿エマ撃つな２:ローズ_007]
		//いい、ジャック？今度やったら？
	}
	talk ライデン 標準 -m {
		 [PC_エマ狙撃＿エマ撃つな２:ライデン_008]
		//やったら？
	}
	talk ローズ 標準 -m {
		 [PC_エマ狙撃＿エマ撃つな２:ローズ_009]
		//記録させない。わかった？
	}
}//v
}//d


//大佐発狂後 d //e
//ＭＳＸ２版 h //e
//proc rp_PC_発狂＿ＭＳＸ１:07
proc rp_PC_発狂＿ＭＳＸ１:07 {
