//ＭＧＳのメイリンの格言２ h //e
//proc rp_PC_発狂＿格言２:07
proc rp_PC_発狂＿格言２:07 {
vox t:vc266651 {
@rp_うなづきデフォルト＿是
@rp_キテレツさん＿否２＿意味不明系デフォルト 50
	talk 大佐 標準 -m {
		 [PC_発狂＿格言２:大佐_000]
		//中国では『欲多ければ則ち生を傷る』っ
		//て言うことがあるの。
	}
@rp_大佐発狂中顔表示
	talk 大佐 標準 -m {
		 [PC_発狂＿格言２:大佐_001]
		//欲をかくと、体を傷めることになるって
		//いう意味よ。
	}
@rp_大佐発狂中顔表示
	talk 大佐 標準 -m {
		 [PC_発狂＿格言２:大佐_002]
		//アイテムを取るのに欲張りすぎると、
		//怪我をするわ。気をつけてね。
	}
}//v
}//d

//能勢電の駅名 h //e
//proc rp_PC_発狂＿格言１:07
proc rp_PC_発狂＿能勢電:07 {
vox t:vc266661 {
@rp_うなづきデフォルト＿是
@rp_キテレツさん＿否２＿意味不明系デフォルト 50
	talk 大佐 標準 -m {
		 [PC_発狂＿能勢電:大佐_000]
		//川西能勢口、絹延橋、滝山、鴬の森、
		//皷滝、多田、平野、一の鳥居、畦野、
		//山下、笹部、光風台、ときわ台、妙見口。
	}
}//v
}//d


//デフォルト操作説明系 d //e

//プラント外部でリモコン装備時 h //e
//proc rp_PC_リモコンミサイル使えない１:07
proc rp_PC_リモコンミサイル使えない１:07 {
vox t:vc266261 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_リモコンミサイル使えない１:大佐_000]
		//ライデン、リモコンミサイルは
		//『ビッグ・シェル』内部でしか
		//使えないぞ。
	}
}//v
}//d
//一回目のみ t //e
//proc rp_PC_リモコンミサイル使えない２:07
proc rp_PC_リモコンミサイル使えない２:07 {
vox t:vc266271 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_リモコンミサイル使えない２:ライデン_000]
		//なぜだ？
	}
	talk 大佐 標準 -m {
		 [PC_リモコンミサイル使えない２:大佐_001]
		//妨害電波だ。『ビッグ・シェル』
		//周辺一帯に電子妨害がかけられている。
	}
	talk ライデン 標準 -m {
		 [PC_リモコンミサイル使えない２:ライデン_002]
		//テロリスト達が？
	}
	talk 大佐 標準 -m {
		 [PC_リモコンミサイル使えない２:大佐_003]
		//おそらくな。我々がＵＡＶ等で偵察を
		//行うのを阻止するつもりなのだろう。
	}
	talk ライデン 標準 -m {
		 [PC_リモコンミサイル使えない２:ライデン_004]
		//しかし奴等も無線やサイファーを
		//使っている？
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_リモコンミサイル使えない２:大佐_005]
		//当然だ。自分達で使用する周波数帯に
		//まで妨害をかけるわけがない。影響を
		//受けるのは君のリモコンミサイルだけだ。
	}
	talk 大佐 標準 -m {
		 [PC_リモコンミサイル使えない２:大佐_006]
		//だが幸いなことに妨害電波はそれほど
		//強くない。
	}
	talk 大佐 標準 -m {
		 [PC_リモコンミサイル使えない２:大佐_007]
		//『ビッグ・シェル』内部なら問題なく
		//リモコンミサイルも使えるはずだ。
	}
}//v
}//d

//懸垂で握力ＵＰ ＬＥＶＥＬ１ h //e
