proc rp_PC_プリスキン周波数１:07 {
vox t:vc266371 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_プリスキン周波数１:ローズ_000]
		//プリスキン中尉なら何か知っているかも
		//知れない。聞いてみたら？
	}
}//v
}//d
//proc rp_PC_プリスキン周波数２:07
proc rp_PC_プリスキン周波数２:07 {
vox t:vc266381 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
