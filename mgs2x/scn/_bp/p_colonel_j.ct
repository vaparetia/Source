//シェル１中央棟Ｂ２ 電算室 d //e
//アーセナルギア扉近く h //e
//proc rp_PC_シェル１中央棟Ｂ２＿ＡＧ扉１:07
proc rp_PC_シェル１中央棟Ｂ２＿ＡＧ扉１:07 {
vox t:vc261781 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_シェル１中央棟Ｂ２＿ＡＧ扉１:ライデン_000]
