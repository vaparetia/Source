@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_海底ドック潜入者:ライデン_000]
		//大佐、さっきの影は……？
	}
	talk 大佐 標準 -m {
		 [PC_海底ドック潜入者:大佐_001]
		//わからん。
	}
	talk ライデン 標準 -m {
		 [PC_海底ドック潜入者:ライデン_002]
		//一体何者なんだ？
	}
	talk 大佐 標準 -m {
		 [PC_海底ドック潜入者:大佐_003]
		//ＳＥＡＬＳでないことだけは確かだ。
		//気をつけろ……。
	}
}//d

