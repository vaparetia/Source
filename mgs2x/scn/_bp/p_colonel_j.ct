@rp_大佐発狂中顔表示
	talk 大佐 標準 -m {
		 [PC_発狂＿ＭＳＸ３:大佐_001]
		//キオ・マルフをダッシュすること。
	}
}//v
}//d

//ＭＧＳの台詞をしゃべる１ h //e
//proc rp_PC_発狂＿ＭＧＳ１:07
proc rp_PC_発狂＿ＭＧＳ１:07 {
vox t:vc266551 {
@rp_うなづきデフォルト＿是
@rp_キテレツさん＿否２＿意味不明系デフォルト 50
	talk 大佐 標準 -m {
		 [PC_発狂＿ＭＧＳ１:大佐_000]
		//ベイカー社長は、地下二階で君が壊した壁の南のエリアに捕えられているはずだ。
	}
@rp_大佐発狂中顔表示
	talk 大佐 標準 -m {
		 [PC_発狂＿ＭＧＳ１:大佐_001]
		//テロリストが起爆コードを聞き出す前に、彼を救出するんだ。
	}
}//v
}//d
//ＭＧＳの台詞をしゃべる２ h //e
//proc rp_PC_発狂＿ＭＧＳ２:07
proc rp_PC_発狂＿ＭＧＳ２:07 {
