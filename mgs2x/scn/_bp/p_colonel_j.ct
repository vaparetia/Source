//最終爆弾ズバリ h //e
//proc rp_PC_ファットマン戦後＿最終爆弾ズバリ:07
proc rp_PC_ファットマン戦後＿最終爆弾ズバリ:07 {
vox t:vc263201 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ファットマン戦後＿最終爆弾ズバリ:大佐_000]
		//ライデン、爆弾は？
	}
	talk ライデン 標準 -m {
		 [PC_ファットマン戦後＿最終爆弾ズバリ:ライデン_001]
		//まだだ……。
	}
	talk 大佐 標準 -m {
		 [PC_ファットマン戦後＿最終爆弾ズバリ:大佐_002]
		//一体どこに……もう時間がないぞ。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_ファットマン戦後＿最終爆弾ズバリ:ローズ_003]
		//ファットマンの体の下は？
	}
	talk ライデン 標準 -m {
		 [PC_ファットマン戦後＿最終爆弾ズバリ:ライデン_004]
		//なんだって？
		//そんなわけないだろ。
	}
	talk ローズ 標準 -m {
		 [PC_ファットマン戦後＿最終爆弾ズバリ:ローズ_005]
		//わからないじゃない。
	}
	talk ライデン 標準 -m {
		 [PC_ファットマン戦後＿最終爆弾ズバリ:ライデン_006]
		//根拠は？
	}
@rp_キテレツさん＿否１＿なんだこいつ系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_ファットマン戦後＿最終爆弾ズバリ:ローズ_007]
		//ないけど。
	}
	talk ライデン 標準 -m {
		 [PC_ファットマン戦後＿最終爆弾ズバリ:ライデン_008]
		//……ふぅ……ローズ……。
		//素人は黙っててくれ。
		//こっちは命がかかってるんだ。
	}
	talk ローズ 標準 -m {
		 [PC_ファットマン戦後＿最終爆弾ズバリ:ローズ_009]
		//……。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ファットマン戦後＿最終爆弾ズバリ:大佐_010]
		//ライデン、そう言わずに
		//とりあえず調べてみたらどうだ。
	}
}//v
}//d


//★P035_01_R01ファットマン爆弾解体終了１無線デモ１終了＜フラグ＜P036_01_P01忍者登場１ポリゴンデモ１開始 d //e
//ヘリポートから下りろ h //e
//proc rp_PC_忍者登場前＿ヘリポート:07
proc rp_PC_忍者登場前＿ヘリポート:07 {
vox t:vc263211 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_忍者登場前＿ヘリポート:大佐_000]
		//ライデン、大統領救出任務に戻れ。
		//まだ調べていないシェル１中央棟に
		//向かうんだ。
	}
}//v
}//d

//ローズに爆弾位置を教えてもらった場合 h //e
//proc rp_PC_忍者登場前＿ローズ助けられ:07
proc rp_PC_忍者登場前＿ローズ助けられ:07 {
vox t:vc263221 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_忍者登場前＿ローズ助けられ:ローズ_000]
		//ジャック？
	}
	talk ライデン 標準 -m {
		 [PC_忍者登場前＿ローズ助けられ:ライデン_001]
		//……なんだ？
	}
	talk ローズ 標準 -m {
		 [PC_忍者登場前＿ローズ助けられ:ローズ_002]
		//またとぼけて。
	}
	talk ライデン 標準 -m {
		 [PC_忍者登場前＿ローズ助けられ:ライデン_003]
		//……わかったよ。確かに爆弾は君の
		//言った場所に仕掛けてあった。君が
		//正しかった。君のおかげで助かった！
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_セクハラ＿否１＿ワガママ系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_忍者登場前＿ローズ助けられ:ローズ_004]
		//わかればよろしい。
	}
	talk ライデン 標準 -m {
		 [PC_忍者登場前＿ローズ助けられ:ライデン_005]
		//しかし意外だったよ。
		//本当に君の言った通りだったとは……。
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_忍者登場前＿ローズ助けられ:ローズ_006]
		//ふーん。
		//それ、私は役に立たないって思って
		//たってこと？
	}
	talk ライデン 標準 -m {
		 [PC_忍者登場前＿ローズ助けられ:ライデン_007]
		//いや、そういうわけじゃないが。
		//女の勘って奴はあなどれないな、と。
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_セクハラ＿否１＿ワガママ系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_忍者登場前＿ローズ助けられ:ローズ_008]
		//その言い方、何か女性差別的。
	}
	talk ライデン 標準 -m {
		 [PC_忍者登場前＿ローズ助けられ:ライデン_009]
		//いちいち突っかからないでくれ。
		//あやまったじゃないか……。
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_忍者登場前＿ローズ助けられ:ローズ_010]
		//ふふ。うそ。冗談よ。
		//気にしないで。
	}
	talk ローズ 標準 -m {
		 [PC_忍者登場前＿ローズ助けられ:ローズ_011]
		//……私もあなたの役に立つって……
		//あなたのこと本当に心配してるって
		//認めてもらいたかっただけ……。
	}
	talk ライデン 標準 -m {
		 [PC_忍者登場前＿ローズ助けられ:ライデン_012]
		//ローズ……。
	}
	talk ローズ 標準 -m {
		 [PC_忍者登場前＿ローズ助けられ:ローズ_013]
		//がんばってね。
	}
}//v
}//d

//★P036_13_R04忍者登場１３無線デモ４終了＜フラグ＜P037_01_R01スネークの遺体１無線デモ１開始 d //e
//中央棟に人質 h //e
//proc rp_PC_人質＿中央棟行け:07
proc rp_PC_人質＿中央棟行け:07 {
vox t:vc263231 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_人質＿中央棟行け:大佐_000]
		//ライデン、エイムズに接触して大統領の
		//居所を聞き出すんだ。
	}
	talk 大佐 標準 -m {
		 [PC_人質＿中央棟行け:大佐_001]
		//エイムズはシェル１中央棟のＢ１に
		//人質として捕らえられているらしい。
		//シェル１中央棟に向かえ。
	}
}//v
}//d

//指向性マイク h //e
//一回目のみ t //e
//proc rp_PC_人質＿指向性マイク１:07
proc rp_PC_人質＿指向性マイク１:07 {
vox t:vc263241 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_人質＿指向性マイク１:大佐_000]
		//エイムズは他の人質と一緒に
		//捕らえられているらしい。
	}
	talk ライデン 標準 -m {
		 [PC_人質＿指向性マイク１:ライデン_001]
		//ああ。だが俺はエイムズの顔を知らない。
	}
}//v
}//d

//proc rp_PC_人質＿指向性マイク２:07
proc rp_PC_人質＿指向性マイク２:07 {
vox t:vc263251 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_人質＿指向性マイク２:大佐_000]
		//エイムズを他の人質から見分けるには
		//指向性マイクを使うしかないようだ。
	}
	talk 大佐 標準 -m {
		 [PC_人質＿指向性マイク２:大佐_001]
		//エイムズは心臓にペースメイカーを埋め
		//込んでいるらしい。心音が違うはずだ。
		//それを指向性マイクで聞き分けるんだ。
	}
}//v
}//d
//マイク持ってない場合 t //e
//proc rp_PC_人質＿指向性マイク３:07
proc rp_PC_人質＿指向性マイク３:07 {
vox t:vc263261 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_人質＿指向性マイク３:大佐_000]
		//指向性マイクはシェル１中央棟の
		//どこかにあるんだろう？
	}
}//v
}//d


//変装方法 h //e
//proc rp_PC_変装＿変装方法１:07
proc rp_PC_変装＿変装方法１:07 {
vox t:vc263271 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_変装＿変装方法１:大佐_000]
		//シェル１中央棟の警備は厳重だ。
		//敵に変装して潜入するんだ。
	}
	talk 大佐 標準 -m {
		 [PC_変装＿変装方法１:大佐_001]
		//変装するには、まずあの忍者から
		//渡された敵兵士の野戦服を装備するんだ。
		//それで敵の服装を真似ることが出来る。
	}
}//v
}//d
//proc rp_PC_変装＿変装方法２:07
proc rp_PC_変装＿変装方法２:07 {
vox t:vc263281 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_変装＿変装方法２:大佐_000]
		//だがそれだけでは不十分だ。
	}
}//v
}//d
//proc rp_PC_変装＿ＡＫ装備:07
proc rp_PC_変装＿ＡＫ装備:07 {
vox t:vc263291 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_変装＿ＡＫ装備:大佐_000]
		//敵兵士と同じ武器を装備していなければ
		//怪しまれるぞ。
	}
	talk 大佐 標準 -m {
		 [PC_変装＿ＡＫ装備:大佐_001]
		//中央棟の敵兵士は武器として
		//ＡＫ７４Ｕを装備している。
		//変装する時はＡＫを装備しろ。
	}
}//v
}//d
//ＡＫ持っていない場合 t //e
//proc rp_PC_変装＿ＡＫ探せ:07
proc rp_PC_変装＿ＡＫ探せ:07 {
vox t:vc263301 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_変装＿ＡＫ探せ:大佐_000]
		//ＡＫを探すんだ。カード２を手に入れた
		//だろう。Ｆ脚の倉庫を探してみては
		//どうだ？
	}
}//v
}//d
//変装中攻撃すると見つかる h //e
//proc rp_PC_変装＿攻撃するな:07
proc rp_PC_変装＿攻撃するな:07 {
vox t:vc263311 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_変装＿攻撃するな:大佐_000]
		//変装に成功していても敵に攻撃を
		//しかけたりしてはたちまち正体が
		//ばれるぞ。
	}
	talk 大佐 標準 -m {
		 [PC_変装＿攻撃するな:大佐_001]
		//変装中は敵に手を出してはいけない。
		//いいな。
	}
}//v
}//d
//変装中も怪しい行動はするな h //e
//proc rp_PC_変装＿怪しい行動:07
proc rp_PC_変装＿怪しい行動:07 {
vox t:vc263321 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_変装＿怪しい行動:大佐_000]
		//ライデン、敵に怪しまれるような
		//行動はするなよ。
	}
	talk 大佐 標準 -m {
		 [PC_変装＿怪しい行動:大佐_001]
		//いくら変装が完璧でもおかしな行動を
		//とれば正体を見破られてしまうぞ。
		//注意するんだ。
	}
}//v
}//d

//変装接触で装備が外れる h //e
//proc rp_PC_変装＿接触脱ぎ１:07
proc rp_PC_変装＿接触脱ぎ１:07 {
vox t:vc263331 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_変装＿接触脱ぎ１:大佐_000]
		//変装していても敵と接触すると
		//野戦服が装備から外れてしまう。
		//気をつけてくれ。
	}
}//v
}//d
//一回目のみ t //e
//proc rp_PC_変装＿接触脱ぎ２:07
proc rp_PC_変装＿接触脱ぎ２:07 {
vox t:vc263341 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_変装＿接触脱ぎ２:ローズ_000]
		//その服、きっとサイズがあってないのね。
	}
	talk ライデン 標準 -m {
		 [PC_変装＿接触脱ぎ２:ライデン_001]
		//ああ。
		//実はかなりきついんだ……。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト＿是
@rp_キテレツさん＿否１＿なんだこいつ系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_変装＿接触脱ぎ２:大佐_002]
		//そうか。君よりもむしろローズ君に
		//着てもらいたいところだな。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_変装＿接触脱ぎ２:ローズ_003]
		//はい！？
	}
	talk ライデン 標準 -m {
		 [PC_変装＿接触脱ぎ２:ライデン_004]
		//大佐……。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト＿是
@rp_邪道外道＿否１＿サイテー系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_変装＿接触脱ぎ２:大佐_005]
		//冗談だ。
		//ライデン、任務に戻れ。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_セクハラ＿否１＿ワガママ系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_変装＿接触脱ぎ２:ローズ_006]
		//信じられない……。
	}
}//v
}//d

//激しい行動をとると脱げる h //e
//proc rp_PC_変装＿激し脱げ:07
proc rp_PC_変装＿激し脱げ:07 {
vox t:vc263351 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
