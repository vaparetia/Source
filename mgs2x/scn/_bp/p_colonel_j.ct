		 [PC_エマのぞき＿執拗:ローズ_001]
		//ジャック？
	}
	talk ライデン 標準 -m {
		 [PC_エマのぞき＿執拗:ライデン_002]
		//……。
	}
	talk ローズ 標準 -m {
		 [PC_エマのぞき＿執拗:ローズ_003]
		//ジャック！
	}
	talk ライデン 標準 -m {
		 [PC_エマのぞき＿執拗:ライデン_004]
		//ああ、ローズか？
		//なんだ？
	}
@rp_つっこまれ＿是１＿なんで知ってるんだ系デフォルト 100
@rp_セクハラ＿否２＿うっとおしい系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_エマのぞき＿執拗:ローズ_005]
		//なんだじゃないでしょう……？
		//ずいぶん熱心にご覧になってたわね。
		//何か気になるものでもあったのかしら？
	}
	talk ライデン 標準 -m {
		 [PC_エマのぞき＿執拗:ライデン_006]
		//いや、その……敵地偵察だよ。
	}
	talk ローズ 標準 -m {
		 [PC_エマのぞき＿執拗:ローズ_007]
		//説得力、全然ない。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト＿是
@rp_つっこまれ＿否１＿逆ギレ系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_エマのぞき＿執拗:大佐_008]
		//度し難いな……。
		//早く任務に戻ってくれ。
	}
}//v
}//d



//アーセナル内部 d //e
//アーセナル内部は寒い h //e
//proc rp_PC_天狗通路Ａ＿寒い:07
proc rp_PC_天狗通路Ａ＿寒い:07 {
vox t:vc265531 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_天狗通路Ａ＿寒い:大佐_000]
		//ライデン、そのエリアは随分気温が
		//低いようだな。
	}
	talk ライデン 標準 -m {
		 [PC_天狗通路Ａ＿寒い:ライデン_001]
		//ああ。まるで冷蔵庫だ。
	}
	talk 大佐 標準 -m {
		 [PC_天狗通路Ａ＿寒い:大佐_002]
		//『Ｇ．Ｗ』を冷却しておくためかも
		//しれんな。光ニューロＡＩの素子に
		//高温は禁物だ。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_天狗通路Ａ＿寒い:ローズ_003]
		//風邪なんか引かないようにね。
	}
}//v
}//d

//天狗通路 d //e
//天狗兵の説明 h //e
//proc rp_PC_天狗通路＿天狗兵１:07
proc rp_PC_天狗通路＿天狗兵１:07 {
vox t:vc265541 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_天狗通路＿天狗兵１:大佐_000]
		//ライデン、気をつけろ。
		//そこの兵士は特殊兵装を身につけている。
	}
	talk ライデン 標準 -m {
		 [PC_天狗通路＿天狗兵１:ライデン_001]
		//ああ。これが……。
	}
	talk 大佐 標準 -m {
		 [PC_天狗通路＿天狗兵１:大佐_002]
		//天狗と呼ばれている
		//アーセナルギア兵装だろう。
	}
}//v
}//d
//proc rp_PC_天狗兵:07
proc rp_PC_天狗兵:07 {
vox t:vc265551 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_天狗兵:大佐_000]
		//外骨格技術を採用した兵装だ。
		//人工筋肉で人間の力を増幅し、
		//機動力を増している。
	}
	talk 大佐 標準 -m {
		 [PC_天狗兵:大佐_001]
		//武器・装備のない状態でたちうち出来る
		//相手ではない。見つからないように
		//進むしかない。いいな。
	}
}//v
}//d


//ヴァンプ遭遇後 d //e
//デッドセルについて h //e
//proc rp_PC_デッドセルについて１:07
proc rp_PC_デッドセルについて１:07 {
vox t:vc265561 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_デッドセルについて１:ライデン_000]
		//大佐、あのデッドセルという連中は……？
	}
	talk 大佐 標準 -m {
		 [PC_デッドセルについて１:大佐_001]
		//奴等については、大体あのプリスキンと
		//いう男が言った通りだ。
	}
	talk ライデン 標準 -m {
		 [PC_デッドセルについて１:ライデン_002]
		//前大統領子飼いの特殊部隊……
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_デッドセルについて１:大佐_003]
		//奴等との交戦はいずれ避けられない
		//だろうな。
	}
	talk ライデン 標準 -m {
		 [PC_デッドセルについて１:ライデン_004]
		//自信がない。
	}
}//v
}//d
//前作やっている場合 h //e
//proc rp_PC_デッドセルについて２:07
proc rp_PC_デッドセルについて２:07 {
vox t:vc265571 {
@rp_うなづきデフォルト＿是
@rp_無茶指令＿否１＿お前がやれ系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_デッドセルについて２:大佐_000]
		//君はＶＲ訓練でＦＯＸＨＯＵＮＤとの
		//闘いを経験しているだろう？大丈夫だ。
		//自信を持て。
	}
}//v
}//d
//proc rp_PC_デッドセルについて３:07
proc rp_PC_デッドセルについて３:07 {
vox t:vc265581 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_デッドセルについて３:ローズ_000]
		//ジャック……無理しないで。
	}
	talk ライデン 標準 -m {
		 [PC_デッドセルについて３:ライデン_001]
		//俺だってしたくない。だが……。
	}
	talk ローズ 標準 -m {
		 [PC_デッドセルについて３:ローズ_002]
		//わかった。わたしに出来ることない？
	}
	talk ライデン 標準 -m {
		 [PC_デッドセルについて３:ライデン_003]
		//そうだな。
		//奴等のデータを調べておいてくれないか。
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_デッドセルについて３:ローズ_004]
		//わかった。やっておく。
		//がんばって。
	}
}//v
}//d

//プリスキンは信用するな。 h //e
//proc rp_PC_プリスキン信用するな:07
proc rp_PC_プリスキン信用するな:07 {
vox t:vc265591 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_プリスキン信用するな:大佐_000]
		//ライデン、あのプリスキンと言う男を
		//信用しているのではあるまいな？
	}
	talk ライデン 標準 -m {
		 [PC_プリスキン信用するな:ライデン_001]
		//……信用しているさ。
		//あの男には何かがある。何か崇高な
		//意志というか……信ずるに足る……。
	}
	talk 大佐 標準 -m {
		 [PC_プリスキン信用するな:大佐_002]
		//ライデン！
	}
	talk ライデン 標準 -m {
		 [PC_プリスキン信用するな:ライデン_003]
		//！？
	}
@rp_うなづきデフォルト＿是
@rp_キテレツさん＿否２＿意味不明系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_プリスキン信用するな:大佐_004]
		//あの男はシミュレーションには入って
		//いない。あの男に頼るな。決してだ。
		//いいな。
	}
	talk ライデン 標準 -m {
		 [PC_プリスキン信用するな:ライデン_005]
		//……了解。
	}
}//v
}//d

//ＶＲ訓練について h //e
//proc rp_PC_ＶＲ訓練について:07
proc rp_PC_ＶＲ訓練について:07 {
vox t:vc265601 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ＶＲ訓練について:大佐_000]
		//ライデン、プリスキンの言ったことなど
		//気にするな。君の行なってきた
		//ＶＲ訓練は最高の訓練プログラムだ。
	}
	talk 大佐 標準 -m {
		 [PC_ＶＲ訓練について:大佐_001]
		//疑問など持つ必要はない。自信を持て。
		//いいな。
	}
}//v
}//d

//ソリッド・スネークについて h //e
//proc rp_PC_スネークについて:07
proc rp_PC_スネークについて:07 {
vox t:vc265611 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_スネークについて:ライデン_000]
		//大佐、テロの首謀者は本当に
		//あのソリッド・スネークなのか？
	}
	talk 大佐 標準 -m {
		 [PC_スネークについて:大佐_001]
		//その通りだ。
	}
	talk ライデン 標準 -m {
		 [PC_スネークについて:ライデン_002]
		//だがスネークはシャドーモセス事件の……
	}
	talk 大佐 標準 -m {
		 [PC_スネークについて:大佐_003]
		//英雄か？
	}
	talk ライデン 標準 -m {
		 [PC_スネークについて:ライデン_004]
		//ああ。
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_スネークについて:大佐_005]
		//確かに、君にはＶＲ訓練を経験して
		//もらった。だがあれが事実の全てを
		//再現しているわけではないのだ。
	}
	talk 大佐 標準 -m {
		 [PC_スネークについて:大佐_006]
		//それに……人は変わる。
	}
	talk ライデン 標準 -m {
		 [PC_スネークについて:ライデン_007]
		//……大佐もか？
	}
@rp_うなづきデフォルト＿是
@rp_かみあわない＿否１＿話聞けよ系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_スネークについて:大佐_008]
		//ライデン、任務に集中しろ。
		//ソリッド・スネークはテロリストの
		//リーダー。油断のならない敵だ。いいな。
	}
}//v
}//d

//タンカー事件について。 h //e
//proc rp_PC_タンカー事件について１:07
proc rp_PC_タンカー事件について１:07 {
vox t:vc265621 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_タンカー事件について１:大佐_000]
		//二年前、そこで起こったタンカー沈没
		//事件についてだが……
	}
	talk ライデン 標準 -m {
		 [PC_タンカー事件について１:ライデン_001]
		//ああ。ＶＲ訓練で体験した。
		//だがタンカーを沈めたのはスネークでは
		//なく……。
	}
	talk 大佐 標準 -m {
		 [PC_タンカー事件について１:大佐_002]
		//ライデン、あのＶＲ訓練は事実の全てを
		//再現したものではないのだ。
	}
	talk ライデン 標準 -m {
		 [PC_タンカー事件について１:ライデン_003]
		//どういう意味だ？
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_タンカー事件について１:大佐_004]
		//いいか。事実はこれだ。
	}
	talk 大佐 標準 -m {
		 [PC_タンカー事件について１:大佐_005]
		//テロリスト、ソリッド・スネークが
		//原油を満載したタンカーを沈め、結果、
		//ＮＹ湾は甚大な環境汚染を被った。
	}
	talk 大佐 標準 -m {
		 [PC_タンカー事件について１:大佐_006]
		//スネークが英雄だなんて幻想は捨てろ。
		//奴はテロリストだ。いいな。
	}
}//v
}//d


//フォーチュン遭遇後 d //e
//ハリアーについて  h //e
//proc rp_PC_ハリアー１:07
proc rp_PC_ハリアーうんちく:07 {
vox t:vc265631 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_ハリアーうんちく:ライデン_000]
		//大佐、テロリストはハリアーを
		//持っているのか？
	}
	talk 大佐 標準 -m {
		 [PC_ハリアーうんちく:大佐_001]
		//ああ。
		//海兵隊向けのＡＶ８Ｂハリアー２だ。
	}
@rp_うなづきデフォルト＿是
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_ハリアーうんちく:大佐_002]
		//２５ｍｍ機関砲、空対空ミサイル・
		//アムラーム、対地攻撃用ロケット弾等を
		//装備した垂直離着陸攻撃機。
	}
	talk 大佐 標準 -m {
		 [PC_ハリアーうんちく:大佐_003]
		//ＳＥＡＬＳのヘリで対抗できる
		//相手ではない。
	}
	talk ライデン 標準 -m {
		 [PC_ハリアーうんちく:ライデン_004]
		//生身ならなおさらだろうな。
		//大佐、奴等はどこからそんなものを？
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ハリアーうんちく:大佐_005]
		//わからん。
	}
	talk ライデン 標準 -m {
		 [PC_ハリアーうんちく:ライデン_006]
		//奴等は本当にただのテロリストなのか？
	}
	talk 大佐 標準 -m {
		 [PC_ハリアーうんちく:大佐_007]
		//落ち着け、ライデン。
		//今は任務を遂行することだけを
		//考えろ。いいな。
	}
}//v
}//d

//テロリストの報復について h //e
//proc rp_PC_報復:07
proc rp_PC_報復:07 {
vox t:vc265641 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_報復:ライデン_000]
		//大佐、本当に奴等は
		//『ビッグ・シェル』を爆破すると？
	}
	talk 大佐 標準 -m {
		 [PC_報復:大佐_001]
		//充分にありうる。このまま要求が
		//受け入れられなければな。奴等はプロだ。
		//一度決断すれば、ためらうことなどない。
	}
	talk ライデン 標準 -m {
		 [PC_報復:ライデン_002]
		//要求に応じるつもりは？
	}
	talk 大佐 標準 -m {
		 [PC_報復:大佐_003]
		//一切ない。
	}
	talk ライデン 標準 -m {
		 [PC_報復:ライデン_004]
		//くっ！
	}
@rp_うなづきデフォルト＿是
@rp_無茶指令＿否１＿お前がやれ系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_報復:大佐_005]
		//君だけが頼りなんだ。
		//爆弾の排除を急いでくれ。
	}
}//v
}//d
//有毒物質 h //e
//proc rp_PC_有毒物質:07
proc rp_PC_有毒物質:07 {
vox t:vc265651 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_有毒物質:大佐_000]
		//『ビッグ・シェル』が爆発すれば、
		//海水殺菌などに使われる多量の塩素系
		//化学薬品が原油と共に炎上するだろう。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_有毒物質:大佐_001]
		//そうなるとダイオキシン類を含む
		//大量の有毒化学物質が発生することが
		//予想される。
	}
	talk 大佐 標準 -m {
		 [PC_有毒物質:大佐_002]
		//ダイオキシン類はポリ塩化ジベンゾ・
		//パラ・ジオキシンとポリ塩化ジベンゾ・
		//フランの総称だ。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_有毒物質:大佐_003]
		//強い急性毒性を持つ有機性塩素化合物で
		//発癌性、催奇性、生殖毒性が非常に強い。
	}
	talk 大佐 標準 -m {
		 [PC_有毒物質:大佐_004]
		//その上、分解されにくく難水溶性で
		//体内に蓄積されやすいんだ。
	}
	talk 大佐 標準 -m {
		 [PC_有毒物質:大佐_005]
		//湾内および沿岸の生態系に及ぼす影響は
		//計り知れない。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_有毒物質:大佐_006]
		//おそらく環境回復には何世代もかかる
		//だろう。
	}
	talk 大佐 標準 -m {
		 [PC_有毒物質:大佐_007]
		//奴等に『ビッグ・シェル』を
		//爆破させてはならない。
		//ライデン、Ｃ４を除去するんだ。
	}
}//v
}//d


//ピーター遭遇後 d //e
//ピーターについて最初 h //e
//proc rp_PC_ピーター１:07
proc rp_PC_ピーター１:07 {
vox t:vc265661 {
@rp_うなづきデフォルト＿是
@rp_無茶指令＿否１＿お前がやれ系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_ピーター１:大佐_000]
		//ライデン、スティルマンは爆弾処理の
		//第一人者だ。彼の指示に従って爆弾を
		//処理しろ。
	}
}//v
}//d
//proc rp_PC_ピーター２:07
proc rp_PC_ピーター２:07 {
vox t:vc265671 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_ピーター２:ライデン_000]
		//わかった。だがスティルマンとは
		//どういう人間なんだ？
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_ピーター２:ローズ_001]
		//わかった。調べておく。
		//少し待ってて。
	}
}//v
}//d

//ピーター しばらくしてから h //e
//proc rp_PC_ピーター詳細１:07
proc rp_PC_ピーター詳細１:07 {
vox t:vc265681 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ピーター詳細１:大佐_000]
		//ライデン、ローズ君から話がある。
	}
}//v
}//d
//proc rp_PC_ピーター詳細２:07
proc rp_PC_ピーター詳細２:07 {
vox t:vc265691 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_ピーター詳細２:ローズ_000]
		//スティルマンさんのファイルを
		//調べてみたの。
	}
}//v
}//d
//proc rp_PC_ピーター詳細３:07
proc rp_PC_ピーター詳細３:07 {
vox t:vc265701 {
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_ピーター詳細３:ローズ_000]
		//ピーター・スティルマン。
		//通称、義足のピーター。
		//伝説的な爆弾処理技術者。
	}
/*
	talk ローズ 標準 -m {
		 [PC_ピーター詳細３:ローズ_001]
		//１９９３年の世界貿易センター爆破
		//テロや１９９５年のオクラホマ連邦ビル
		//爆破事件などの捜査にも参加してる。
	}
*/
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_ピーター詳細３:ローズ_002]
		//長年、海軍爆発物処理学校の教官と
		//ＮＹＰＤの爆発物処理顧問も務めてるわ。
	}
	talk ローズ 標準 -m {
		 [PC_ピーター詳細３:ローズ_003]
		//でも５年前に事故を起こして片足を
		//失くしてしまって……それ以来一線を
		//退いて教官に専念している。
	}
	talk ローズ 標準 -m {
		 [PC_ピーター詳細３:ローズ_004]
		//この作戦に招集されたのは本人の言う
		//通り、ファットマンに対抗出来る爆弾の
		//専門家が彼しかいなかったからみたいね。
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_ピーター詳細３:ローズ_005]
		//現役を退いたとは言え、爆弾解体に
		//おける第一人者であることは間違いない
		//みたい。頼りになると思うわ。
	}
}//v
}//d

//段ボールをかぶった男を見た後 h //e
//proc rp_PC_怪奇箱男１:07
proc rp_PC_怪奇箱男１:07 {
vox t:vc265711 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_怪奇箱男１:ライデン_000]
		//大佐、さっきダンボールを
		//かぶって走る奴を見た。
	}
	talk 大佐 標準 -m {
		 [PC_怪奇箱男１:大佐_001]
		//ダンボール？
	}
	talk ライデン 標準 -m {
		 [PC_怪奇箱男１:ライデン_002]
		//あれはなんなんだ？
		//デッドセルか？
	}
@rp_つっこまれ＿否１＿逆ギレ系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_怪奇箱男１:大佐_003]
		//いくらデッドセルが変人ぞろいでも
		//ダンボールはないだろう……。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_怪奇箱男１:ローズ_004]
		//調べてみるわ。
	}
	talk ライデン 標準 -m {
		 [PC_怪奇箱男１:ライデン_005]
		//頼む。
	}
}//v
}//d

//箱男 しばらくしてから h //e
//proc rp_PC_怪奇箱男２:07
proc rp_PC_怪奇箱男２:07 {
vox t:vc265721 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_怪奇箱男２:大佐_000]
		//ライデン、ローズ君から報告がある
		//そうだ。
	}
}//v
}//d
//proc rp_PC_怪奇箱男３:07
proc rp_PC_怪奇箱男３:07 {
vox t:vc265731 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_怪奇箱男３:ローズ_000]
		//ジャック、さっきのダンボールの人の
		//こと、調べてみたんだけど……。
	}
	talk ライデン 標準 -m {
		 [PC_怪奇箱男３:ライデン_001]
		//何かわかったか？
	}
	talk ローズ 標準 -m {
		 [PC_怪奇箱男３:ローズ_002]
		//いいえ。デッドセルにもゴルルコビッチ
		//大佐のロシア私兵部隊にも該当する
		//データはなかった。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_怪奇箱男３:大佐_003]
		//ＳＥＡＬ１０の生き残りという線は？
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_怪奇箱男３:ローズ_004]
		//勿論調べました。でも……。
	}
	talk ライデン 標準 -m {
		 [PC_怪奇箱男３:ライデン_005]
		//見つからなかった？
	}
	talk ローズ 標準 -m {
		 [PC_怪奇箱男３:ローズ_006]
		//ええ……ごめんなさい。役に立てなくて。
	}
	talk ライデン 標準 -m {
		 [PC_怪奇箱男３:ライデン_007]
		//一体あれは……。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_怪奇箱男３:大佐_008]
		//ライデン、気をつけろ。
	}
}//v
}//d

//プリスキンはやはり怪しい h //e
//proc rp_PC_爆弾解体プリスキン怪しい:07
proc rp_PC_爆弾解体プリスキン怪しい:07 {
vox t:vc265741 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_爆弾解体プリスキン怪しい:大佐_000]
		//ライデン、プリスキンの方はどうなんだ？
	}
	talk ライデン 標準 -m {
		 [PC_爆弾解体プリスキン怪しい:ライデン_001]
		//順調のようだが……。
	}
	talk 大佐 標準 -m {
		 [PC_爆弾解体プリスキン怪しい:大佐_002]
		//スティルマンも言っていた通り、
		//あの男は怪しい。気を許すんじゃないぞ。
		//いいな。
	}
}//v
}//d

//ミスターＸ h //e
//proc rp_PC_ミスターＸ:07
proc rp_PC_ミスターＸ:07 {
vox t:vc265751 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_ミスターＸ:ライデン_000]
		//大佐、
		//さっきのミスターＸというのは……。
	}
	talk 大佐 標準 -m {
		 [PC_ミスターＸ:大佐_001]
		//ＦＯＸＨＯＵＮＤの隊員ではない。
	}
	talk ライデン 標準 -m {
		 [PC_ミスターＸ:ライデン_002]
		//奴はディープスロートと名乗ったんだ。
		//まるでシャドーモセスの……。
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ミスターＸ:大佐_003]
		//ライデン、言いたいことはわかる。
		//だがそれはありえない。
	}
	talk ライデン 標準 -m {
		 [PC_ミスターＸ:ライデン_004]
		//……。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_ミスターＸ:ローズ_005]
		//ジャック、調べてみるから……
		//少し待ってて。
	}
}//v
}//d

//ミスターＸ しばらくしてから h //e
//proc rp_PC_ミスターＸ２:07
proc rp_PC_ミスターＸ２:07 {
vox t:vc265761 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ミスターＸ２:大佐_000]
		//ローズ君が例のミスターＸに
		//ついて調べてくれた。
	}
}//v
}//d
//proc rp_PC_ミスターＸ３:07
proc rp_PC_ミスターＸ３:07 {
vox t:vc265771 {
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_ミスターＸ３:ローズ_000]
		//ジャック、ミスターＸ……というより
		//ディープスロートについて調べたわ。
	}
	talk ローズ 標準 -m {
		 [PC_ミスターＸ３:ローズ_001]
		//確かにソリッド・スネークはシャドー
		//モセス事件で、ディープスロートと
		//名乗る男のサポートを受けている。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_ミスターＸ３:ローズ_002]
		//その正体は元ＦＯＸＨＯＵＮＤ隊員
		//グレイ・フォックスだったそうよ。
	}
	talk ライデン 標準 -m {
		 [PC_ミスターＸ３:ライデン_003]
		//グレイ・フォックス……。
	}
	talk ローズ 標準 -m {
		 [PC_ミスターＸ３:ローズ_004]
		//そう。本名はフランク・イェーガー。
		//ＦＯＸＨＯＵＮＤで唯一ＦＯＸの称号を
		//許された、最優秀の隊員。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_ミスターＸ３:ローズ_005]
		//ＯＵＴＥＲ　ＨＥＡＶＥＮでは
		//スネークに先駆けて要塞に潜入。
		//彼を助けて事件を収束に導いた。
	}
	talk ローズ 標準 -m {
		 [PC_ミスターＸ３:ローズ_006]
		//でもザンジバーランドではビッグボスと
		//結託して騒乱の首謀者になってる。
		//彼はそこでスネークと戦い敗れた……。
	}
	talk ローズ 標準 -m {
		 [PC_ミスターＸ３:ローズ_007]
		//瀕死の重傷を負ったフォックスは軍に
		//回収されたようね。
	}
	talk ローズ 標準 -m {
		 [PC_ミスターＸ３:ローズ_008]
		//その後、強化骨格と遺伝子治療の
		//実験体になっていたみたい……。
	}
	talk ライデン 標準 -m {
		 [PC_ミスターＸ３:ライデン_009]
		//強化骨格？
	}
	talk ローズ 標準 -m {
		 [PC_ミスターＸ３:ローズ_010]
		//サイボーグ忍者。そんな風に呼んでた
		//人もいるようね。研究所の焼失で詳しい
		//記録は残ってないんだけど……。
	}
	talk ライデン 標準 -m {
		 [PC_ミスターＸ３:ライデン_011]
		//その後、彼はシャドーモセスに？
	}
	talk ローズ 標準 -m {
		 [PC_ミスターＸ３:ローズ_012]
		//ええ。でも、なぜそこに現われたのかに
		//ついては記録にないの。
	}
	talk ローズ 標準 -m {
		 [PC_ミスターＸ３:ローズ_013]
		//スネークへの復讐だったって見解も
		//あるみたいけど確かなことはわからない。
	}
	talk ライデン 標準 -m {
		 [PC_ミスターＸ３:ライデン_014]
		//じゃあ今度も奴が……。
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_ミスターＸ３:ローズ_015]
		//いえ、彼はシャドーモセスで死んでいる。
		//それは確か。
	}
	talk ライデン 標準 -m {
		 [PC_ミスターＸ３:ライデン_016]
		//……では奴は一体？
	}
	talk ローズ 標準 -m {
		 [PC_ミスターＸ３:ローズ_017]
		//わからない。でも気をつけて。
	}
}//v
}//d



//死んだピーターについて h //e
//proc rp_PC_ピーター死１:07
proc rp_PC_ピーター死１:07 {
vox t:vc265781 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_ピーター死１:ライデン_000]
		//大佐、ピーターが死んだ。
	}
	talk 大佐 標準 -m {
		 [PC_ピーター死１:大佐_001]
		//わかっている。しっかりしろ、ライデン。
	}
	talk ライデン 標準 -m {
		 [PC_ピーター死１:ライデン_002]
		//もうダメだ。俺にはできない。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_ピーター死１:ローズ_003]
		//ジャック、いい？
		//落ち着いて。
	}
	talk ライデン 標準 -m {
		 [PC_ピーター死１:ライデン_004]
		//ピーターが死んだ。
		//爆弾の専門家はもういない。
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_キテレツさん＿否１＿なんだこいつ系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_ピーター死１:ローズ_005]
		//あなたは大丈夫。私が死なせない。
	}
	talk ライデン 標準 -m {
		 [PC_ピーター死１:ライデン_006]
		//ローズ？
	}
	talk ローズ 標準 -m {
		 [PC_ピーター死１:ローズ_007]
		//さあ、センサーＢを装備して？
	}
	talk ライデン 標準 -m {
		 [PC_ピーター死１:ライデン_008]
		//ああ……。
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_ピーター死１:ローズ_009]
		//反応がないかどうか調べて。
		//ジャック、なんとしても、
		//この危機を脱するのよ。
	}
	talk ライデン 標準 -m {
		 [PC_ピーター死１:ライデン_010]
		//わかった……。
	}
}//v
}//d


//爆発の余波について h //e
//proc rp_PC_ピーター死＿爆発余波:07
proc rp_PC_ピーター死＿爆発余波:07 {
vox t:vc265791 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_ピーター死＿爆発余波:ライデン_000]
		//大佐、爆発の影響はどの程度なんだ？
	}
	talk 大佐 標準 -m {
		 [PC_ピーター死＿爆発余波:大佐_001]
		//現在細かいところを調査している。
	}
	talk ライデン 標準 -m {
		 [PC_ピーター死＿爆発余波:ライデン_002]
		//プリスキンは？
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ピーター死＿爆発余波:大佐_003]
		//わからん……。
	}
	talk ライデン 標準 -m {
		 [PC_ピーター死＿爆発余波:ライデン_004]
		//大丈夫だろうか……？
	}
	talk 大佐 標準 -m {
		 [PC_ピーター死＿爆発余波:大佐_005]
		//ライデン、あの男を気遣うような暇が
		//あるなら爆弾を処理するんだ。いいな。
	}
}//v
}//d

//フォーチュンについて h //e
//proc rp_PC_フォーチュン１:07
proc rp_PC_フォーチュン１:07 {
vox t:vc265801 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_フォーチュン１:ライデン_000]
		//大佐……あの女はいったい……。
	}
	talk 大佐 標準 -m {
		 [PC_フォーチュン１:大佐_001]
		//あれはフォーチュン。
		//デッドセルのリーダーだ。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_フォーチュン１:ローズ_002]
		//ちょっと待ってて。
		//調べてみるから。
	}
}//v
}//d

//フォーチュンについてしばらくしてから h //e
//proc rp_PC_フォーチュン２:07
proc rp_PC_フォーチュン２:07 {
vox t:vc265811 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_フォーチュン２:大佐_000]
		//ローズ君がフォーチュンについて
		//調べてくれた。
	}
}//v
}//d
//proc rp_PC_フォーチュン３:07
proc rp_PC_フォーチュン３:07 {
vox t:vc265821 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_フォーチュン３:ローズ_000]
		//ジャック、フォーチュンについての
		//データよ。
	}
	talk ローズ 標準 -m {
		 [PC_フォーチュン３:ローズ_001]
		//通称、フォーチュン。
		//デッドセルのリーダー。
		//本名、ヘレナ・ドルフ・ジャクソン。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_フォーチュン３:ローズ_002]
		//父親は二年前、演習中に事故死した
		//海兵隊司令官スコット・ドルフ。
	}
	talk ローズ 標準 -m {
		 [PC_フォーチュン３:ローズ_003]
		//夫はデッドセルの元リーダー、
		//ジャクソン大佐……。
		//彼は獄死……とあるわ。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_フォーチュン３:ローズ_004]
		//夫の死の直後、彼女は軍に入隊してる。
	}
	talk ローズ 標準 -m {
		 [PC_フォーチュン３:ローズ_005]
		//戦闘経験は全くなかった彼女だけど
		//すぐにある特質を見出されて
		//デッドセルに編入された。
	}
	talk ライデン 標準 -m {
		 [PC_フォーチュン３:ライデン_006]
		//特質？
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_フォーチュン３:ローズ_007]
		//運が良かったのよ。奇跡みたいな強運。
		//彼女が行くところ、弾はよけ作戦は
		//必ず成功する……。
	}
	talk ライデン 標準 -m {
		 [PC_フォーチュン３:ライデン_008]
		//そんな馬鹿な。
	}
	talk ローズ 標準 -m {
		 [PC_フォーチュン３:ローズ_009]
		//私もそう思う。でも彼女が負傷したと
		//いう記録は一切ない。かすり傷一つ
		//負っていないの。
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_フォーチュン３:ローズ_010]
		//ジャック、気をつけて……。
	}
}//v
}//d



//レールガン設定 h //e
//proc rp_PC_フォーチュン戦＿レールガン:07
proc rp_PC_フォーチュン戦＿レールガン:07 {
vox t:vc265831 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_フォーチュン戦＿レールガン:大佐_000]
		//ライデン、ローズ君がフォーチュンの
		//武器について調べてくれた。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_フォーチュン戦＿レールガン:ローズ_001]
		//彼女の持ってる大きなライフルは
		//個人用のレールガンみたい。
	}
	talk ライデン 標準 -m {
		 [PC_フォーチュン戦＿レールガン:ライデン_002]
		//レールガンだって？
	}
	talk ローズ 標準 -m {
		 [PC_フォーチュン戦＿レールガン:ローズ_003]
		//そう。磁力で弾を射出する電磁砲。
		//可動導体としてプラズマ電気子を使用
		//することで加速性能を上げている。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_フォーチュン戦＿レールガン:ローズ_004]
		//その砲弾の運動エネルギーは約１０ＭＪ。ちなみに１４０ｍｍ滑腔砲弾のそれが
		//約２０ＭＪ……。
	}
	talk ライデン 標準 -m {
		 [PC_フォーチュン戦＿レールガン:ライデン_005]
		//そんなものが実用化されて
		//いるとは……。
	}
	talk ローズ 標準 -m {
		 [PC_フォーチュン戦＿レールガン:ローズ_006]
		//実用化はされていないわ。
		//あれはあくまで試作品。
	}
	talk ライデン 標準 -m {
		 [PC_フォーチュン戦＿レールガン:ライデン_007]
		//あれのどこが試作品なんだ！
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_フォーチュン戦＿レールガン:ローズ_008]
		//レール材のプラズマ化やレール間放電
		//などの問題が解決されてないらしいの。
	}
	talk ローズ 標準 -m {
		 [PC_フォーチュン戦＿レールガン:ローズ_009]
		//暴発の危険性が高すぎて兵器としての
		//実用性はないっていう評価が残ってるわ。
	}
	talk ライデン 標準 -m {
		 [PC_フォーチュン戦＿レールガン:ライデン_010]
		//だが奴のは暴発なんか……
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_フォーチュン戦＿レールガン:ローズ_011]
		//……きっと……
		//運がいいんからじゃないかしら？
	}
	talk ライデン 標準 -m {
		 [PC_フォーチュン戦＿レールガン:ライデン_012]
		//そんな……。
	}
	talk ローズ 標準 -m {
		 [PC_フォーチュン戦＿レールガン:ローズ_013]
		//どちらにせよ彼女にしか扱えない
		//武器というのは間違いないみたい。
	}
	talk ライデン 標準 -m {
		 [PC_フォーチュン戦＿レールガン:ライデン_014]
		//始末におえない武器だってこともな。
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_フォーチュン戦＿レールガン:ローズ_015]
		//気をつけて、ジャック！
	}
}//v
}//d


//ファットマンについて h //e
//proc rp_PC_ファットマンについて１:07
proc rp_PC_ファットマンについて１:07 {
vox t:vc265841 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_ファットマンについて１:ライデン_000]
		//ファットマンというのはどんな奴なんだ？
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_ファットマンについて１:ローズ_001]
		//待ってて。調べてみるから。
	}
}//v
}//d
//ファットマンについて しばらくしてからh //e
//proc rp_PC_ファットマンについて２:07
proc rp_PC_ファットマンについて２:07 {
vox t:vc265851 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ファットマンについて２:大佐_000]
		//ローズ君がデータの検索をおえたそうだ。
	}
}//v
}//d
//proc rp_PC_ファットマンについて３:07
proc rp_PC_ファットマンについて３:07 {
vox t:vc265861 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_ファットマンについて３:ローズ_000]
		//ジャック、ファットマンについて
		//調べたわ。
	}
	talk ローズ 標準 -m {
		 [PC_ファットマンについて３:ローズ_001]
		//爆弾王ファットマン。
		//１０歳の時に原爆を組み立てたって
		//話は聞いたわよね。
	}
	talk ローズ 標準 -m {
		 [PC_ファットマンについて３:ローズ_002]
		//子供の頃から爆弾の世界では名前を
		//知られていたみたい。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_ファットマンについて３:ローズ_003]
		//インディアンヘッドの海軍爆発物処理
		//専門学校に入学。首席で卒業。
		//スティルマンさんに会ったのはこの頃ね。
	}
	talk ローズ 標準 -m {
		 [PC_ファットマンについて３:ローズ_004]
		//そして核緊急捜索チームに加入。
		//でもすぐに辞めている。
	}
	talk ローズ 標準 -m {
		 [PC_ファットマンについて３:ローズ_005]
		//その後デッドセルに爆弾の専門家として
		//参加……今にいたるというわけね。
	}
}//v
}//d
//ピーターまだ生きている場合 t //e
//proc rp_PC_ファットマンについて４:07
proc rp_PC_ファットマンについて４:07 {
vox t:vc265871 {
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_ファットマンについて４:ローズ_000]
		//スティルマンさんにも聞いてみたら？
		//きっと詳しいことを知っていると思う。
	}
}//v
}//d

//ヴァンプについて h //e
//proc rp_PC_ヴァンプについて１:07
proc rp_PC_ヴァンプについて１:07 {
vox t:vc265881 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_ヴァンプについて１:ライデン_000]
		//ヴァンプと言ったか……あいつについて
		//何か情報はないか？
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_ヴァンプについて１:ローズ_001]
		//待ってて。調べてみる。
	}
}//v
}//d
//ヴァンプについて しばらくしてから h //e
//proc rp_PC_ヴァンプについて２:07
proc rp_PC_ヴァンプについて２:07 {
vox t:vc265891 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ヴァンプについて２:大佐_000]
		//ライデン、ローズ君から何かあるそうだ。
	}
}//v
}//d
//proc rp_PC_ヴァンプについて３:07
proc rp_PC_ヴァンプについて３:07 {
vox t:vc265901 {
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_ヴァンプについて３:ローズ_000]
		//ジャック、ヴァンプについてのデータが
		//手に入ったわ。
	}
	talk ローズ 標準 -m {
		 [PC_ヴァンプについて３:ローズ_001]
		//デッドセルの創立期からのメンバーで、
		//プリスキン中尉の言った通り、
		//ルーマニア出身のナイフの達人ね。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_ヴァンプについて３:ローズ_002]
		//でも……ただのナイフ使いじゃない
		//みたい。
	}
	talk ライデン 標準 -m {
		 [PC_ヴァンプについて３:ライデン_003]
		//どういうことだ？
	}
	talk ローズ 標準 -m {
		 [PC_ヴァンプについて３:ローズ_004]
		//銃弾をよけるって。
	}
	talk ライデン 標準 -m {
		 [PC_ヴァンプについて３:ライデン_005]
		//ああ、俺も見た。あれは一体？
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_ヴァンプについて３:ローズ_006]
		//わからない。他にもいろいろ人間離れ
		//したところがあるみたい。詳しい記録は
		//ないんだけど……。気をつけて。
	}
}//v
}//d

//ファットマン戦 d //e
//ボムブラストスーツうんちく h //e
//proc rp_PC_ファットマン戦＿ボムブラストスーツ１:07
proc rp_PC_ファットマン戦＿ボムブラストスーツ１:07 {
vox t:vc265911 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿ボムブラストスーツ１:大佐_000]
		//ファットマンが着ているのは
		//ボムブラストスーツ。
	}
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿ボムブラストスーツ１:大佐_001]
		//爆弾処理の際に着用し、着用者を爆風、
		//熱、破片から守るものだ。基本的に
		//防弾衣と同じ特殊繊維で出来ている。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿ボムブラストスーツ１:大佐_002]
		//首と体の前面はラミネート・
		//バリスティック・インサートで
		//防護されている。
	}
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿ボムブラストスーツ１:大佐_003]
		//背面にも、爆風で吹き飛ばされた場合、
		//脊髄への衝撃を和らげるための
		//プロテクターが装備されている。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿ボムブラストスーツ１:大佐_004]
		//体への攻撃は効果が薄いだろう。
	}
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿ボムブラストスーツ１:大佐_005]
		//一見動きにくそうに見えるだろうが
		//爆弾処理に支障をきたさないよう、
		//非常にフレキシブルに作られている。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿ボムブラストスーツ１:大佐_006]
		//鞍馬や平行棒のような器械体操まで
		//こなせるそうだ。
	}
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿ボムブラストスーツ１:大佐_007]
		//問題としては通気性が悪く、長時間
		//着ていると着用者が熱中症を起こす
		//という可能性がある。
	}
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿ボムブラストスーツ１:大佐_008]
		//だがそのスーツには宇宙服と同様に
		//冷却水をチューブに流す冷却システムが
		//備えられている。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿ボムブラストスーツ１:大佐_009]
		//奴が熱中症で倒れることはないだろうな。
	}
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿ボムブラストスーツ１:大佐_010]
		//しかしそのコンフィギュレーション
		//ならスーツの総重量は５０キロを超える。
	}
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿ボムブラストスーツ１:大佐_011]
		//ローラーブレードで走るには重過ぎる
		//重量だ。衝撃を加えればバランスを
		//崩して転ぶこともあるだろう。
	}
}//v
}//d
//proc rp_PC_ファットマン戦＿ボムブラストスーツ２:07
proc rp_PC_ファットマン戦＿ボムブラストスーツ２:07 {
vox t:vc265921 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿ボムブラストスーツ２:大佐_000]
		//スーツの部分を銃で撃っても効果は薄い
		//ぞ。むき出しの頭部を狙うんだ。奴が
		//転んでから起き上がる時がチャンスだ。
	}
}//v
}//d

//グロックうんちく h //e
//proc rp_PC_ファットマン戦＿グロック:07
proc rp_PC_ファットマン戦＿グロック:07 {
vox t:vc265931 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿グロック:大佐_000]
		//ファットマンが持っているのは
		//グロック１８。グロック１７を
		//フルオート化したマシンピストルだ。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿グロック:大佐_001]
		//毎秒２０発の９ｍｍ弾を発射する。
		//弾幕を張られると厄介だぞ。
	}
	talk ライデン 標準 -m {
		 [PC_ファットマン戦＿グロック:ライデン_002]
		//だが元々マシンピストルは
		//要人警護部隊で使われるものだろう？
		//テロリストの足を止めるために？
	}
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿グロック:大佐_003]
		//そうだ。携帯可能な大火力としてな。
	}
	talk ライデン 標準 -m {
		 [PC_ファットマン戦＿グロック:ライデン_004]
		//そんなものを、しかも片手で扱うなんて？
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿グロック:大佐_005]
		//奴はデッドセルだぞ。
	}
	talk ライデン 標準 -m {
		 [PC_ファットマン戦＿グロック:ライデン_006]
		//……。
	}
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿グロック:大佐_007]
		//それにあんなものを着て動き回れるんだ。
		//筋力には自信があるんだろう。
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿グロック:大佐_008]
		//正面から撃ち合うような真似はするな。
		//リロードの隙をついて攻撃するんだ。
	}
}//v
}//d

//ファットマン死後爆弾残り h //e
//proc rp_PC_ファットマン戦＿死後爆弾残り:07
proc rp_PC_ファットマン戦＿死後爆弾残り:07 {
vox t:vc265941 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿死後爆弾残り:大佐_000]
		//ライデン、ファットマンは倒れたが
		//油断するな。まだ奴の仕掛けた爆弾が
		//残っている。爆弾を全て処理するんだ。
	}
}//v
}//d


//ファットマン戦後 d //e
//プリスキンは生きていた h //e
//proc rp_PC_プリスキン生きていた:07
proc rp_PC_プリスキン生きていた:07 {
vox t:vc265951 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_プリスキン生きていた:ライデン_000]
		//大佐、プリスキン達は無事だった。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_プリスキン生きていた:ローズ_001]
		//うれしそうね、ジャック。
	}
	talk ライデン 標準 -m {
		 [PC_プリスキン生きていた:ライデン_002]
		//ああ……。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_プリスキン生きていた:大佐_003]
		//ライデン、奴を信用するな。
	}
	talk ライデン 標準 -m {
		 [PC_プリスキン生きていた:ライデン_004]
		//なんだって？
	}
	talk 大佐 標準 -m {
		 [PC_プリスキン生きていた:大佐_005]
		//おかしいとは思わないか？
		//奴一人だけ助かるなんて、
		//あまりにも都合が良すぎる。
	}
	talk ライデン 標準 -m {
		 [PC_プリスキン生きていた:ライデン_006]
		//……。
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_プリスキン生きていた:大佐_007]
		//ライデン。奴を頼りにするな。
		//君が独りで任務を遂行するんだ。
		//いいな。
	}
}//v
}//d

//忍者について h //e
//proc rp_PC_忍者接触後＿忍者:07
proc rp_PC_忍者接触後＿忍者:07 {
vox t:vc265961 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_忍者接触後＿忍者:大佐_000]
		//ライデン、エイムズと接触するんだ。
	}
	talk ライデン 標準 -m {
		 [PC_忍者接触後＿忍者:ライデン_001]
		//大佐、あいつの言うことを本当に
		//信用していいのか？
	}
	talk 大佐 標準 -m {
		 [PC_忍者接触後＿忍者:大佐_002]
		//それ以外に方法がないのが事実だ。
		//残念ながらな。
	}
	talk ライデン 標準 -m {
		 [PC_忍者接触後＿忍者:ライデン_003]
		//行ってみればわかるということか……。
	}
}//v
}//d



//エイムズについて h //e
//proc rp_PC_エイムズ１:07
proc rp_PC_エイムズ１:07 {
vox t:vc265971 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_エイムズ１:ライデン_000]
		//大佐、エイムズというのは何者なんだ？
	}
}//v
}//d
//proc rp_PC_エイムズ２:07
proc rp_PC_エイムズ２:07 {
vox t:vc265981 {
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_エイムズ２:ローズ_000]
		//大統領に随伴したシークレットサービス
		//の名簿を調べてみた。確かにエイムズっ
		//ていういう名前があるわ。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エイムズ２:大佐_001]
		//あの忍者の言ったことは嘘ではなかった
		//ということだな。
	}
	talk ライデン 標準 -m {
		 [PC_エイムズ２:ライデン_002]
		//リストの上ではな。
		//ローズ、他に情報は？
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_エイムズ２:ローズ_003]
		//わかった。調べてみる。
	}
	talk ライデン 標準 -m {
		 [PC_エイムズ２:ライデン_004]
		//頼む。
	}
}//v
}//d
//エイムズしばらくしてから h //e
//proc rp_PC_エイムズ２＿２:07
proc rp_PC_エイムズ２＿２:07 {
vox t:vc265991 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エイムズ２＿２:大佐_000]
		//ライデン、ローズ君から報告がある。
		//エイムズについてだ。
	}
}//v
}//d
//proc rp_PC_エイムズ３:07
proc rp_PC_エイムズ３:07 {
vox t:vc266001 {
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_エイムズ３:ローズ_000]
		//ジャック？
		//エイムズのことだけど……。
	}
	talk ライデン 標準 -m {
		 [PC_エイムズ３:ライデン_001]
		//何かわかったか？
	}
@rp_キテレツさん＿否２＿意味不明系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_エイムズ３:ローズ_002]
		//ええ。
		//何もわからないってことがわかった。
	}
	talk ライデン 標準 -m {
		 [PC_エイムズ３:ライデン_003]
		//なんだって？
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_エイムズ３:ローズ_004]
		//記録が何もないの。社会保障番号や
		//住所、経歴はおろか、性別も年齢も
		//フルネームさえ……。
	}
	talk ライデン 標準 -m {
		 [PC_エイムズ３:ライデン_005]
		//どういうことだ？
	}
	talk ローズ 標準 -m {
		 [PC_エイムズ３:ローズ_006]
		//わからない。わかったのはエイムズ。
		//その一語だけ。
	}
	talk ライデン 標準 -m {
		 [PC_エイムズ３:ライデン_007]
		//……。
	}
}//v
}//d
//proc rp_PC_エイムズ４:07
proc rp_PC_エイムズ４:07 {
vox t:vc266011 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エイムズ４:大佐_000]
		//それでも大統領への手がかりはエイムズ
		//だけだ。接触してみるしかない。
		//シェル１中央棟のＢ１に向かうんだ。
	}
}//v
}//d

//核について h //e
//proc rp_PC_核について:07
proc rp_PC_核について:07 {
vox t:vc266021 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_核について:ライデン_000]
		//大佐、この『ビッグ・シェル』に
		//メタルギアがあるって話は……。
	}
	talk 大佐 標準 -m {
		 [PC_核について:大佐_001]
		//まだ調査中だ。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_核について:ローズ_002]
		//ごめんなさい、ジャック。
	}
	talk ライデン 標準 -m {
		 [PC_核について:ライデン_003]
		//『ビッグ・シェル』が偽装だという
		//話も？
	}
	talk ローズ 標準 -m {
		 [PC_核について:ローズ_004]
		//ええ。どの記録を見てもれっきとした
		//海上除染施設ということになってる。
		//記録上、疑う余地はないんだけど……。
	}
	talk ライデン 標準 -m {
		 [PC_核について:ライデン_005]
		//エイムズとやらに直接聞くしかない、
		//ということか……。
	}
}//v
}//d

//エイムズ後 d //e
//人質は殺されていない？ h //e
//proc rp_PC_エイムズ死後＿人質:07
proc rp_PC_エイムズ死後＿人質:07 {
vox t:vc266031 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_エイムズ死後＿人質:ライデン_000]
		//大佐、エイムズはＳＥＡＬ１０突入の
		//報復に人質が殺されたことも
		//知らなかったようだが？
	}
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿人質:大佐_001]
		//ああ。おそらく人質は他の部屋にも
		//いたんだろう。
	}
	talk ライデン 標準 -m {
		 [PC_エイムズ死後＿人質:ライデン_002]
		//……。
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿人質:大佐_003]
		//ライデン、任務に集中しろ。
		//今は大統領救出に集中するんだ。
		//シェル２中央棟の１Ｆに向かえ。
	}
}//v
}//d

//ブラックケースについて h //e
//proc rp_PC_エイムズ死後＿ブラックケース１:07
proc rp_PC_エイムズ死後＿ブラックケース１:07 {
vox t:vc266041 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_エイムズ死後＿ブラックケース１:ライデン_000]
		//エイムズの言っていたブラックケースの
		//話……本当なんだろうか。
	}
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿ブラックケース１:大佐_001]
		//ローズ君。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_エイムズ死後＿ブラックケース１:ローズ_002]
		//わかりました。
		//ジャック、調べてみるから。
	}
}//v
}//d
//ブラックケース しばらくしてから h //e
//proc rp_PC_エイムズ死後＿ブラックケース２:07
proc rp_PC_エイムズ死後＿ブラックケース２:07 {
vox t:vc266051 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿ブラックケース２:大佐_000]
		//ライデン、ローズ君の調べがついた
		//そうだ。
	}
}//v
}//d
//proc rp_PC_エイムズ死後＿ブラックケース３:07
proc rp_PC_エイムズ死後＿ブラックケース３:07 {
vox t:vc266061 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_エイムズ死後＿ブラックケース３:ローズ_000]
		//ジャック、核起爆暗号を解除する
		//ブラックケースのデータを見つけたわ。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_エイムズ死後＿ブラックケース３:ローズ_001]
		//大統領のＤＮＡを取り出して、その特定
		//部分の塩基配列と入力時の生体データ
		//から鍵を生成する認証システムらしいわ。
	}
	talk ローズ 標準 -m {
		 [PC_エイムズ死後＿ブラックケース３:ローズ_002]
		//そのプロテクトを破ることは不可能って
		//評価されてる。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk ライデン 標準 -m {
		 [PC_エイムズ死後＿ブラックケース３:ライデン_003]
		//つまり大統領本人でなければコードを
		//入力できない？
	}
	talk ローズ 標準 -m {
		 [PC_エイムズ死後＿ブラックケース３:ローズ_004]
		//ええ。その上、エイムズさんの言う通り、
		//大統領の脳波・心拍数等が異常な状態
		//での入力は無効と判定されるようね。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk ライデン 標準 -m {
		 [PC_エイムズ死後＿ブラックケース３:ライデン_005]
		//やはり大統領が自分の意志でコードを
		//入力したということか。だがなぜ合衆国
		//大統領がテロリストに手を貸す？
	}
	talk ローズ 標準 -m {
		 [PC_エイムズ死後＿ブラックケース３:ローズ_006]
		//そんなの……
		//記録にあるわけないじゃない。
	}
	talk ライデン 標準 -m {
		 [PC_エイムズ死後＿ブラックケース３:ライデン_007]
		//……それはそうだな……。
	}
	talk ローズ 標準 -m {
		 [PC_エイムズ死後＿ブラックケース３:ローズ_008]
		//あと、一定時間ごとにコードの再確認が
		//されるってのも本当みたい。
	}
	talk ライデン 標準 -m {
		 [PC_エイムズ死後＿ブラックケース３:ライデン_009]
		//つまりそれまで大統領は無事……か。
		//ブラックケースが新型メタルギア起動の
		//鍵も兼ねているって言う話は？
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_エイムズ死後＿ブラックケース３:ローズ_010]
		//それは記録になかった。
	}
	talk ライデン 標準 -m {
		 [PC_エイムズ死後＿ブラックケース３:ライデン_011]
		//うぅむ。
	}
}//v
}//d
//proc rp_PC_エイムズ死後＿ブラックケース４:07
proc rp_PC_エイムズ死後＿ブラックケース４:07 {
vox t:vc266071 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿ブラックケース４:大佐_000]
		//ライデン、新型メタルギアの話は
		//ともかく、奴等がコード入力を終了し、
		//核を撃とうとしていることは確かだ。
	}
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿ブラックケース４:大佐_001]
		//大統領に会って事態を確かめろ。急げ。
		//彼が生かされているうちに接触するんだ。
	}
}//v
}//d

//テロボススネーク h //e
//proc rp_PC_エイムズ死後＿テロボススネーク:07
proc rp_PC_エイムズ死後＿テロボススネーク:07 {
vox t:vc266081 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_エイムズ死後＿テロボススネーク:ライデン_000]
		//大佐、テロリストのリーダーの姿を見た。
		//あれがソリッド・スネークなのか？
	}
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿テロボススネーク:大佐_001]
		//そうだ。
		//２年前にこの地でタンカーを沈めた
		//テロリストだ。
	}
	talk ライデン 標準 -m {
		 [PC_エイムズ死後＿テロボススネーク:ライデン_002]
		//……。
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿テロボススネーク:大佐_003]
		//ライデン、奴のことを英雄だと
		//思っているのか？奴が話しているのを
		//聞いただろう？
	}
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿テロボススネーク:大佐_004]
		//ソリッド・スネークはテロリストだ。
		//君は奴と戦わねばならん。いいな。
	}
}//v
}//d

//大統領について h //e
//proc rp_PC_エイムズ死後＿大統領:07
proc rp_PC_エイムズ死後＿大統領:07 {
vox t:vc266091 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿大統領:大佐_000]
		//ライデン、大統領を救出するんだ。
		//シェル２中央棟の１Ｆに向かえ。
	}
	talk ライデン 標準 -m {
		 [PC_エイムズ死後＿大統領:ライデン_001]
		//大佐、大統領は奴等の仲間なんじゃ
		//ないか？エイムズは大統領が自分で
		//核発射のコード入力をしたと……。
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿大統領:大佐_002]
		//だが奴等が大統領を始末しようと
		//している話も聞いただろう？
	}
	talk ライデン 標準 -m {
		 [PC_エイムズ死後＿大統領:ライデン_003]
		//ああ……。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_エイムズ死後＿大統領:ローズ_004]
		//仲間割れ？
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿大統領:大佐_005]
		//いや、そもそも大統領がテロリストに
		//荷担していたと決まったわけではない。
	}
	talk ライデン 標準 -m {
		 [PC_エイムズ死後＿大統領:ライデン_006]
		//……。
	}
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿大統領:大佐_007]
		//疑問なら彼に直接接触して話を聞け。
	}
	talk ライデン 標準 -m {
		 [PC_エイムズ死後＿大統領:ライデン_008]
		//了解……。
	}
}//v
}//d

//ＯＵＴＥＲ　ＨＥＡＶＥＮについて h //e
//proc rp_PC_エイムズ死後＿アウターヘブン:07
proc rp_PC_エイムズ死後＿アウターヘブン:07 {
vox t:vc266101 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_エイムズ死後＿アウターヘブン:ライデン_000]
		//大佐、スネークが言っていた
		//ＯＵＴＥＲ　ＨＥＡＶＥＮとは
		//あの……？
	}
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿アウターヘブン:大佐_001]
		//ああ。スネークの遺伝学上の父親、
		//史上最高の兵士、ビッグボスと呼ばれた
		//男がかって建設した独裁軍事国家だ。
	}
	talk ライデン 標準 -m {
		 [PC_エイムズ死後＿アウターヘブン:ライデン_002]
		//奴はその再興を？
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿アウターヘブン:大佐_003]
		//わからん。だが奴の兄弟である
		//リキッド・スネークもＯＵＴＥＲ
		//ＨＥＡＶＥＮを望んだという噂もある。
	}
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿アウターヘブン:大佐_004]
		//奴等兄弟にとっては何か特別なもの
		//なのかもしれんな……。
	}
}//v
}//d

//核兵器による電磁波攻撃について h //e
//proc rp_PC_エイムズ死後＿ＮＥＭＰ:07
proc rp_PC_エイムズ死後＿ＮＥＭＰ:07 {
vox t:vc266111 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿ＮＥＭＰ:大佐_000]
		//奴等がマンハッタン上空で核爆発を
		//起こせば大変なことになる。
	}
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿ＮＥＭＰ:大佐_001]
		//高々度核爆発のエネルギーは大部分が
		//ガンマ線となって放出される。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿ＮＥＭＰ:大佐_002]
		//これが大気圏内の二次反応により強大な電磁パルスを発生させるんだ。
	}
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿ＮＥＭＰ:大佐_003]
		//パルス持続時間は５００ナノ秒という
		//短時間だがその強度は瞬間的に
		//５兆メガワットを超える。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿ＮＥＭＰ:大佐_004]
		//この電磁パルスによってアンテナや
		//ケーブル等に高電圧のサージが発生し、
		//急激な電圧上昇が回路を焼き切る。
	}
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿ＮＥＭＰ:大佐_005]
		//核爆発によるスカラー電磁波は
		//通常の電磁波よりも貫通性が高い。
		//民生の電磁防護機器など役にはたたん。
	}
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿ＮＥＭＰ:大佐_006]
		//その効果も半径数千キロに及ぶと
		//いわれている。ニューヨーク全域の
		//電子機器が完全に破壊されるだろうな。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_エイムズ死後＿ＮＥＭＰ:ローズ_007]
		//そんなことになったら……
	}
	talk ライデン 標準 -m {
		 [PC_エイムズ死後＿ＮＥＭＰ:ライデン_008]
		//世界的な大混乱は避けらない。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト＿是
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿ＮＥＭＰ:大佐_009]
		//核兵器による電磁波攻撃は古くから
		//研究されていた。
	}
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿ＮＥＭＰ:大佐_010]
		//１９６２年、南太平洋ジョンストン島で
		//行われたスターフィッシュ計画もそうだ。
	}
	talk ライデン 標準 -m {
		 [PC_エイムズ死後＿ＮＥＭＰ:ライデン_011]
		//あれは高々度核爆発の無線や
		//レーダーに対する影響を調べるため
		//じゃなかったのか？
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿ＮＥＭＰ:大佐_012]
		//それは表向きの話だ。
		//電磁波兵器の開発はその前のアーガス
		//計画の時から始まっていた。
	}
	talk ライデン 標準 -m {
		 [PC_エイムズ死後＿ＮＥＭＰ:ライデン_013]
		//今、奴等はそれを実践しようと
		//している……？
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿ＮＥＭＰ:大佐_014]
		//我が国の心臓部を標的にしてな。
		//奴等に核を撃たせてはならん。
		//急ぐんだ、ライデン。
	}
}//v
}//d

//忍者について h //e
//proc rp_PC_エイムズ死後＿忍者:07
proc rp_PC_エイムズ死後＿忍者:07 {
vox t:vc266121 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_エイムズ死後＿忍者:ライデン_000]
		//またあの忍者に助けられた。
		//あいつについての情報は何か手に
		//入ったか？
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_エイムズ死後＿忍者:ローズ_001]
		//ごめんなさい。
		//いろいろ調べたんだけど、まだ……。
	}
@rp_うなづきデフォルト
	@rpd_大佐顔表示
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿忍者:大佐_002]
		//奴の目的は分からんが彼が君を
		//助けようとしていることは確かだ。
		//だが油断はするなよ。
	}
}//v
}//d

//ハリアー戦中 d //e
//クラスター爆弾 h //e
//proc rp_PC_ハリアー戦＿クラスター爆弾前:07
proc rp_PC_ハリアー戦＿クラスター爆弾前:07 {
vox t:vc266131 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ハリアー戦＿クラスター爆弾前:大佐_000]
		//ハリアー２はクラスター爆弾を
		//装備している。多数の小型爆弾を
		//内蔵したいわゆる親子爆弾だ。
	}
}//v
}//d
//proc rp_PC_ハリアー戦＿クラスター爆弾よけ方:07
proc rp_PC_ハリアー戦＿クラスター爆弾よけ方:07 {
vox t:vc266141 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ハリアー戦＿クラスター爆弾よけ方:大佐_000]
		//クラスター爆弾の攻撃範囲は広い。
		//連絡橋の上階にいてはさけられないぞ。
		//下階に逃げるんだ。
	}
}//v
}//d


//ロケット h //e
//proc rp_PC_ハリアー戦＿ロケットミサイル:07
proc rp_PC_ハリアー戦＿ロケットミサイル:07 {
vox t:vc266151 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ハリアー戦＿ロケットミサイル:大佐_000]
		//ハリアーは両翼に
		//対地攻撃用ロケット弾ポッドを
		//搭載している。
	}
	talk 大佐 標準 -m {
		 [PC_ハリアー戦＿ロケットミサイル:大佐_001]
		//ロケット弾は無誘導だ。
		//移動すれば避けられるだろう。
		//ただし爆風には注意しろよ。
	}
}//v
}//d

//突撃 h //e
//proc rp_PC_ハリアー戦＿突撃:07
proc rp_PC_ハリアー戦＿突撃:07 {
vox t:vc266161 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ハリアー戦＿突撃:大佐_000]
		//ハリアーが飛び去って
		//目視出来なくなっても慌ててはいけない。
	}
	talk 大佐 標準 -m {
		 [PC_ハリアー戦＿突撃:大佐_001]
		//ハリアーが機首を君の方に向けた時、
		//機体が太陽の反射で一瞬光るはずだ。
		//それを見逃すな。
	}
	talk 大佐 標準 -m {
		 [PC_ハリアー戦＿突撃:大佐_002]
		//少しでも早く発見してスティンガーを
		//当てるんだ。遅れれば攻撃を受けるぞ。
	}
}//v
}//d

//焼き攻撃 h //e
//proc rp_PC_ハリアー戦＿焼き攻撃:07
proc rp_PC_ハリアー戦＿焼き攻撃:07 {
vox t:vc266171 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ハリアー戦＿焼き攻撃:大佐_000]
		//ハリアーの排気炎は高熱だ。
		//巻き込まれてはいけない。ハリアーが
		//接近してきたら下の階に逃げるんだ。
	}
}//v
}//d

//フレア h //e
//proc rp_PC_ハリアー戦＿フレア:07
proc rp_PC_ハリアー戦＿フレア:07 {
vox t:vc266181 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ハリアー戦＿フレア:大佐_000]
		//ハリアーはＩＲフレアを装備している。
		//マグネシウム等を空中で燃焼させ赤外線
		//誘導ミサイルを欺瞞する対抗兵器だ。
	}
	talk 大佐 標準 -m {
		 [PC_ハリアー戦＿フレア:大佐_001]
		//フレアを射出されると、発射した
		//スティンガーミサイルがフレアの方に
		//引き寄せられてしまうぞ。
	}
}//v
}//d





//ハリアー戦後 d //e
//スネークについて h //e
//proc rp_PC_ハリアー戦後＿スネーク:07
proc rp_PC_ハリアー戦後＿スネーク:07 {
vox t:vc266191 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_ハリアー戦後＿スネーク:ライデン_000]
		//大佐、プリスキンはやはりスネーク
		//だった……。
	}
	talk 大佐 標準 -m {
		 [PC_ハリアー戦後＿スネーク:大佐_001]
		//奴いわく、な。
	}
	talk ライデン 標準 -m {
		 [PC_ハリアー戦後＿スネーク:ライデン_002]
		//なんだって？
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ハリアー戦後＿スネーク:大佐_003]
		//いいか、ライデン。何度でも言うぞ。
		//奴はシミュレーションには入っていない。
	}
	talk ライデン 標準 -m {
		 [PC_ハリアー戦後＿スネーク:ライデン_004]
		//またシミュレーションか……。
	}
	talk 大佐 標準 -m {
		 [PC_ハリアー戦後＿スネーク:大佐_005]
		//奴に頼るな。奴を信用するな。いいな。
	}
}//v
}//d


//大統領後 d //e
//愛国者達 h //e
//proc rp_PC_愛国者達:07
proc rp_PC_愛国者達:07 {
vox t:vc266201 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_愛国者達:ライデン_000]
		//大佐、『愛国者達』という連中に
		//ついては何かわかったか？
	}
	talk 大佐 標準 -m {
		 [PC_愛国者達:大佐_001]
		//いや、まだだ……。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_愛国者達:ローズ_002]
		//どこにもそんなデータは見つからないの。
	}
	talk ライデン 標準 -m {
		 [PC_愛国者達:ライデン_003]
		//だが大統領は……。
	}
	talk ローズ 標準 -m {
		 [PC_愛国者達:ローズ_004]
		//ジャック、データはないの。
	}
	talk ライデン 標準 -m {
		 [PC_愛国者達:ライデン_005]
		//大佐、あんたは何か知ってるんじゃ
		//ないのか？
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_愛国者達:大佐_006]
		//いや。何も知らん……。
		//もう少し時間をくれ。
	}
}//v
}//d



//オセロットはなぜ大統領を殺したのか？ h //e
//proc rp_PC_大統領後＿なぜ大統領を殺したのか:07
proc rp_PC_大統領後＿なぜ大統領を殺したのか:07 {
vox t:vc266211 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_大統領後＿なぜ大統領を殺したのか:ライデン_000]
		//大佐、なぜオセロットは大統領を
		//殺したんだろう？
	}
	talk 大佐 標準 -m {
		 [PC_大統領後＿なぜ大統領を殺したのか:大佐_001]
		//仲間割れじゃないか？
	}
	talk ライデン 標準 -m {
		 [PC_大統領後＿なぜ大統領を殺したのか:ライデン_002]
		//……似てないか？
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_大統領後＿なぜ大統領を殺したのか:大佐_003]
		//何だって？
	}
	talk ライデン 標準 -m {
		 [PC_大統領後＿なぜ大統領を殺したのか:ライデン_004]
		//シャドーモセス事件とだ。
	}
	talk 大佐 標準 -m {
		 [PC_大統領後＿なぜ大統領を殺したのか:大佐_005]
		//馬鹿な……。
	}
	talk ライデン 標準 -m {
		 [PC_大統領後＿なぜ大統領を殺したのか:ライデン_006]
		//そう言い切れるか？
		//エイムズの死、忍者の出現、大統領の死、
		//そしてウィルス……。
	}
	talk 大佐 標準 -m {
		 [PC_大統領後＿なぜ大統領を殺したのか:大佐_007]
		//考え過ぎだ。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_大統領後＿なぜ大統領を殺したのか:ローズ_008]
		//そうよ、ジャック。
		//あなたは疲れてるの。
	}
	talk ライデン 標準 -m {
		 [PC_大統領後＿なぜ大統領を殺したのか:ライデン_009]
		//……。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト＿是
@rp_無茶指令＿否１＿お前がやれ系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_大統領後＿なぜ大統領を殺したのか:大佐_010]
		//ライデン、余計なことは考えるな。
		//任務を遂行することに全力を注ぐんだ。
		//いいな。
	}
}//v
}//d


//タンカー編整理後 d //e
//スネークのこと h //e
//proc rp_PC_大統領後＿スネーク:07
proc rp_PC_大統領後＿スネーク:07 {
vox t:vc266221 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_大統領後＿スネーク:ライデン_000]
		//大佐、聞いたか、シャドーモセスの
		//真実を？
	}
	talk 大佐 標準 -m {
		 [PC_大統領後＿スネーク:大佐_001]
		//ああ。
	}
	talk ライデン 標準 -m {
		 [PC_大統領後＿スネーク:ライデン_002]
		//スネークはテロリストではなかった。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_大統領後＿スネーク:ローズ_003]
		//うれしそうね？
	}
	talk ライデン 標準 -m {
		 [PC_大統領後＿スネーク:ライデン_004]
		//ん？ああ……。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_大統領後＿スネーク:大佐_005]
		//それで君はあの男の言ったことを
		//そのまま信じているのか？
	}
	talk ライデン 標準 -m {
		 [PC_大統領後＿スネーク:ライデン_006]
		//なんだって？
	}
	talk 大佐 標準 -m {
		 [PC_大統領後＿スネーク:大佐_007]
		//奴を信用するな。
		//奴はシミュレーションには入っていない。
	}
	talk ライデン 標準 -m {
		 [PC_大統領後＿スネーク:ライデン_008]
		//またシミュレーションか？
		//一体どういうことなんだ？
	}
	talk 大佐 標準 -m {
		 [PC_大統領後＿スネーク:大佐_009]
		//奴を頼るな。君の力で任務を
		//遂行するんだ。いいな。ライデン。
	}
}//v
}//d

//エマ狙撃 d //e
//リモコンミサイル装備時 h //e
//proc rp_PC_エマ狙撃＿リモコンミサイル使えない:07
proc rp_PC_エマ狙撃＿リモコンミサイル使えない:07 {
vox t:vc266231 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
