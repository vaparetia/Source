	talk 大佐 標準 -m {
		 [PC_ＬＩＦＥゼロ寸前ＣＡＬＬ＿レーション使え:大佐_000]
		//レーションを使うんだ！
	}
}//v
}//d

//レーションの説明 h //e
//レーション入手時にＣＡＬＬ t //e
//proc rp_PC_レーションＣＡＬＬ１:07
proc rp_PC_レーションＣＡＬＬ１:07 {
vox t:vc260621 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_レーションＣＡＬＬ１:大佐_000]
		//レーションを手に入れたな。
		//ＬＩＦＥを回復出来る軍用携帯糧食だ。
	}
}//v
}//d

//操作説明 t //e
//proc rp_PC_レーション操作説明:07
/*
proc rp_PC_レーション操作説明:07 {
vox t:vc260631 {
	@rpb_PC_レーション操作説明
}//v
}//d
*/

proc rpb_PC_レーション操作説明:07 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_レーション操作説明:大佐_000]
		//レーションをウィンドウで選択して
		//○ボタンを押せば、その場で使用して
		//ＬＩＦＥを一定量回復する。
	}
	talk 大佐 標準 -m {
		 [PC_レーション操作説明:大佐_001]
		//装備していればＬＩＦＥがなくなった
		//瞬間、自動的に使用してＬＩＦＥを
		//回復することが出来る。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
@rp_うんちく＿是１＿詳しいな系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_レーション操作説明:大佐_002]
		//栄養補給だけではなく免疫システムを
		//活性化させ、ストレスを緩和させる
		//効果も合わせ持っている。
	}
	talk ライデン 標準 -m {
		 [PC_レーション操作説明:ライデン_003]
		//結構、味気無さそうに見えるんだが。
	}
	talk 大佐 標準 -m {
		 [PC_レーション操作説明:大佐_004]
		//文句を言うな、ライデン……。
		//戦場なんだぞ……。
	}
}//v

//ローズがいる場合 t //e
//proc rp_PC_レーション操作説明＿ローズ:07
/*
proc rp_PC_レーション操作説明＿ローズ:07 {
vox t:vc260641 {
	@rpb_PC_レーション操作説明＿ローズ
}//v
}//d
*/

proc rpb_PC_レーション操作説明＿ローズ:07 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_レーション操作説明＿ローズ:ローズ_000]
		//がまんして、ジャック。
		//任務が終わったら、私の得意料理を
		//ごちそうするから。
	}
	talk ライデン 標準 -m {
		 [PC_レーション操作説明＿ローズ:ライデン_001]
		//え！？
	}
	talk ローズ 標準 -m {
		 [PC_レーション操作説明＿ローズ:ローズ_002]
		//ん？
	}
	talk ライデン 標準 -m {
		 [PC_レーション操作説明＿ローズ:ライデン_003]
		//あ、いや、何でもない。
		//楽しみだよ。ははは……。
	}
}//d

//ノード前 h //e
//接続前 t //e
//proc rp_PC_ノード前接続前１:07
/*
proc rp_PC_ノード前接続前１:07 {
vox t:vc260651 {
	@rpb_PC_ノード前接続前１
}//v
}//d
*/

proc rpb_PC_ノード前接続前１:07 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ノード前接続前１:大佐_000]
		//ライデン、そこにあるコンピュータ
		//端末がノードだ。
	}
	talk ライデン 標準 -m {
		 [PC_ノード前接続前１:ライデン_001]
		//これが……。
	}
	talk 大佐 標準 -m {
		 [PC_ノード前接続前１:大佐_002]
		//そうだ。早くノードにアクセスしろ。
		//やり方は、ノードの前に立って
		//△ボタンを押すだけだ。
	}
}//d

//proc rp_PC_ノード前接続前２:07
proc rp_PC_ノード前接続前２:07 {
vox t:vc260661 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ノード前接続前２:大佐_000]
		//危険モードの状態ではノードにアクセス
		//することは出来ない。アクセスする前に
		//必ず敵を振り切るんだ。
	}
}//v
}//d
//proc rp_PC_ノード前接続前３:07
proc rp_PC_ノード前接続前３:07 {
vox t:vc260662 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ノード前接続前３:大佐_000]
		//ノードには潜入モードの状態でしか
		//アクセス出来ない。
	}
	talk 大佐 標準 -m {
		 [PC_ノード前接続前３:大佐_001]
		//アクセスを試みる時は、敵の目を
		//かいくぐってノードに接近する必要が
		//ある。
	}
}//v
}//d

//ノードについて h //e
//proc rp_PC_ノード機能説明１:07
proc rp_PC_ノード機能説明１:07 {
vox t:vc260671 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ノード機能説明１:大佐_000]
		//ノードに接続すれば、そのエリアの
		//レーダーと全体マップが利用できる
		//ようになる。
	}
	talk 大佐 標準 -m {
		 [PC_ノード機能説明１:大佐_001]
		//だがそれ以外にもオプションの変更等、
		//様々な機能が利用できる。君の好みに
		//あわせて設定を変えるといい。
	}
}//v
}//d


//レーダー説明 h //e
//proc rp_PC_ノード機能説明２:07
proc rp_PC_ノード機能説明２:07 {
vox t:vc260681 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ノード機能説明２:大佐_000]
		//ライデン、レーダーを活用するんだ。
		//敵の動きと視界を把握出来るレーダーは
		//潜入任務の大きな助けになるはずだ。
	}
	talk 大佐 標準 -m {
		 [PC_ノード機能説明２:大佐_001]
		//だがレーダーばかりを見ていると
		//思わぬ見落としをする可能性もある。
		//主観でまわりを伺うことも忘れるなよ。
	}
}//v
}//d

//昇降機前 h //e
//ノード接続前 t //e
//proc rp_PC_海底ドック昇降機前ノード接続前:07
proc rp_PC_海底ドック昇降機前ノード接続前:07 {
vox t:vc260691 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_海底ドック昇降機前ノード接続前:大佐_000]
		//ふむ。昇降機は上の階に上ったまま
		//らしいな。昇降機が下りてくるまで
		//待つしかない。
	}
	talk 大佐 標準 -m {
		 [PC_海底ドック昇降機前ノード接続前:大佐_001]
		//ノードがその東側の脇にあるのが見える
		//だろう？とりあえずノードにアクセス
		//するんだ。
	}
}//v
}//d

//ノード接続後 h //e
//proc rp_PC_海底ドック昇降機前ノード接続後１:07
proc rp_PC_海底ドック昇降機前ノード接続後１:07 {
vox t:vc260701 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_海底ドック昇降機前ノード接続後１:大佐_000]
		//ライデン、昇降機は下へ向かっている。
		//だが到着にはもう少し時間がかかり
		//そうだ。
	}
	talk 大佐 標準 -m {
		 [PC_海底ドック昇降機前ノード接続後１:大佐_001]
		//昇降機が下りてくるまで待て。
		//それまで敵に見つからないように
		//身を隠すんだ。
	}
}//v
}//d
//一回目のみ t //e
//proc rp_PC_海底ドック昇降機前ノード接続後２:07
/*
proc rp_PC_海底ドック昇降機前ノード接続後２:07 {
vox t:vc260711 {
	@rpb_PC_海底ドック昇降機前ノード接続後２
}//v
}//d
*/

proc rpb_PC_海底ドック昇降機前ノード接続後２:07 {
	talk ライデン 標準 -m {
		 [PC_海底ドック昇降機前ノード接続後２:ライデン_000]
		//待つのは苦手だ。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_海底ドック昇降機前ノード接続後２:ローズ_001]
		//そうね。待たされるのはいつも
		//私の方だった。
	}
	@rpd_大佐顔表示
@rp_つっこまれ＿是１＿なんで知ってるんだ系デフォルト 100
@rp_うなづきデフォルト＿否
	talk 大佐 標準 -m {
		 [PC_海底ドック昇降機前ノード接続後２:大佐_002]
		//時計を見るのも苦手なのか？
		//とにかく昇降機が下りてくるまで
		//隠れているんだ。
	}
}//d


