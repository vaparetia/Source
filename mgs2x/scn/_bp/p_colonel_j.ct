	talk 大佐 標準 -m {
		 [PC_懸垂握力上がらない１:大佐_000]
		//ライデン……いつまでやってるんだ。
		//懸垂はもういいから、そろそろ任務に
		//戻ってくれ。
	}
}//v
}//d
//proc rp_PC_懸垂握力上がらない２:07
proc rp_PC_懸垂握力上がらない２:07 {
vox t:vc266341 {
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_懸垂握力上がらない２:ローズ_000]
