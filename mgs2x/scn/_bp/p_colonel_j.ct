//敵兵をつれてこい h //e
//proc rp_PC_網膜センサー＿羽交絞め１:07
proc rp_PC_網膜センサー＿羽交絞め１:07 {
vox t:vc261701 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_網膜センサー＿羽交絞め１:大佐_000]
		//ライデン、バイオメトリックスを
		//突破するには敵兵士を網膜センサーの
		//所まで連れてくるしかないぞ。
	}
}//v
}//d
//proc rp_PC_網膜センサー＿羽交絞めヒント１:07
proc rp_PC_網膜センサー＿羽交絞めヒント１:07 {
vox t:vc261711 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_網膜センサー＿羽交絞めヒント１:ライデン_000]
		//どうすればいい？
	}
}//v
}//d
//proc rp_PC_網膜センサー＿羽交絞めヒント２:07
proc rp_PC_網膜センサー＿羽交絞めヒント２:07 {
//vox t:vc261721
movie t:vc261722 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_網膜センサー＿羽交絞めヒント２:大佐_000]
		//敵兵士を首絞めで捕まえて、そのまま
		//網膜センサーのところまで引きずって
		//いくんだ。
	}
	talk 大佐 標準 -m {
		 [PC_網膜センサー＿羽交絞めヒント２:大佐_001]
		//首絞めをかけるには、敵の後ろから
		//近づいて武器を装備せずに□ボタンを
		//押せばいい。
	}
}//v
}//d
//proc rp_PC_網膜センサー＿羽交絞めヒント３:07
proc rp_PC_網膜センサー＿羽交絞めヒント３:07 {
vox t:vc261731 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_網膜センサー＿羽交絞めヒント３:大佐_000]
		//予め敵の無線機を壊しておけばセンサー
		//まで連れて行く途中で逃げられても増援
		//部隊を呼ばれる心配はないだろう。
	}
	talk 大佐 標準 -m {
		 [PC_網膜センサー＿羽交絞めヒント３:大佐_001]
		//無線機は敵の腰の右後ろだ。
		//主観攻撃で破壊できる。
	}
}//v
}//d
//死んだ敵兵をつれてきた h //e
//proc rp_PC_網膜センサー＿生きた敵兵:07
proc rp_PC_網膜センサー＿生きた敵兵:07 {
vox t:vc261741 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_網膜センサー＿生きた敵兵:大佐_000]
		//ライデン、網膜センサーは敵兵士が
		//目を開けていなければ認証を行うことは
		//出来ない。
	}
	talk 大佐 標準 -m {
		 [PC_網膜センサー＿生きた敵兵:大佐_001]
		//敵兵士の意識を失わせては駄目だ。
		//注意しろ。
	}
}//v
}//d
///潜入じゃなきゃ駄目 h //e
//proc rp_PC_網膜センサー＿潜入モードのみ:07
proc rp_PC_網膜センサー＿潜入モードのみ:07 {
vox t:vc261751 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_網膜センサー＿潜入モードのみ:大佐_000]
		//網膜センサーは危険モードの時には
		//ロックされる。敵に見つかったら
		//敵を一度完全に振り切る必要があるぞ。
	}
}//v
}//d

//自分でのぞいても駄目 h //e
//proc rp_PC_網膜センサー＿自分でのぞいた:07
proc rp_PC_網膜センサー＿自分でのぞいた:07 {
vox t:vc261761 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_網膜センサー＿自分でのぞいた:大佐_000]
		//ライデン、網膜センサーに登録されて
		//いるのは敵兵士のデータだ。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_網膜センサー＿自分でのぞいた:ローズ_001]
		//あなたがのぞいても駄目にきまってる
		//じゃない……。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_網膜センサー＿自分でのぞいた:大佐_002]
		//なんとかして敵兵士を網膜センサーまで
		//連れてくるんだ。
	}
}//v
}//d

//エイムズ以降壊れている場合 h //e
//proc rp_PC_網膜センサー＿壊れた:07
