//proc rp_PC_発狂＿ムービー:07
proc rp_PC_発狂＿ムービー:07 {
vox t:vc264661 {
@rp_うなづきデフォルト＿是
@rp_キテレツさん＿否２＿意味不明系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_発狂＿ムービー:大佐_000]
		//ライデン、大変だっ！
		//ＴＶに切り替えてみろ！
	}
}//v
}//d


//★P073_05_S01通路Ａ５シナリオデモ１終了＜フラグ＜P074_01_P01通路Ａ刀後１ポリゴンデモ１開始 d //e
//ソリダス戦中 h //e
//proc rp_PC_ソリダス戦＿倒せ:07
proc rp_PC_ソリダス戦＿倒せ:07 {
vox t:vc264671 {
@rp_うなづきデフォルト＿是
@rp_邪道外道＿否１＿サイテー系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_ソリダス戦＿倒せ:大佐_000]
		//ライデン、ソリダスを倒せ！
		//オルガの子供とローズ君がどうなっても
		//いいのか！？ソリダスを倒すんだ！！
	}
}//v
}//d

//デフォルト会話 d //e
//流血説明 h //e
//無線機ウィンドウ、ライデンのバストアップに戻る。ライデンのカメラ、再び動かせる。 t //e
//proc rp_PC_流血説明１:07
/*
proc rp_PC_流血説明１:07 {
vox t:vc264681 {
	@rpb_PC_流血説明１
}//v
}//d
*/

proc rpb_PC_流血説明１:07 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_流血説明１:大佐_000]
		//君にはナノマシンが混合された
		//人工血液が使用されている。
	}
	talk ライデン 標準 -m {
		 [PC_流血説明１:ライデン_001]
		//俺のオリジナルは？
	}
	talk 大佐 標準 -m {
		 [PC_流血説明１:大佐_002]
		//冷凍保存している。
		//帰還後に入れ替える手筈だ。
	}
}//d

//無線機ウィンドウにライデンが出血しているゲーム映像。足下に赤い血が流血している。 t //e
//proc rp_PC_流血説明２:07
proc rp_PC_流血説明２:07 {
vox t:vc264691 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_流血説明２:大佐_000]
		//ＬＩＦＥゲージが赤くなるまで減ると
		//血が止まらなくなる。血痕を敵に
		//追跡される恐れがあるぞ。注意するんだ。
	}
}//v
}//d
//ゲーム画面内で止血剤を使用している映像。 t //e
//proc rp_PC_流血説明３:07
proc rp_PC_流血説明３:07 {
vox t:vc264701 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_流血説明３:大佐_000]
		//止血するにはアイテムの止血剤を
		//使うか……。
	}
}//v
}//d
//しゃがんで流血回復ムービー t //e
//proc rp_PC_流血説明４:07
proc rp_PC_流血説明４:07 {
vox t:vc264711 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_流血説明４:大佐_000]
		//しゃがむかホフクして
		//しばらくじっとしている事だ。
		//動かずにな。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_流血説明４:大佐_001]
		//一定時間、じっとしていれば体内の
		//ナノマシンが大量の血小板を作り出して
		//止血してくれる。
	}
}//v
}//d

//初めての敵兵。対処の初歩の初歩 h //e
//proc rp_PC_戦闘＿素手:07
proc rp_PC_戦闘＿素手:07 {
vox t:vc264721 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_戦闘＿素手:大佐_000]
		//君はまだ武器を手に入れていない。
		//戦闘になったら素手で切り抜ける
		//しかないぞ。
	}
}//v
}//d
//proc rp_PC_戦闘＿パンチ:07
proc rp_PC_戦闘＿パンチ:07 {
vox t:vc264731 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_戦闘＿パンチ:大佐_000]
		//素手で敵と戦う場合の基本はパンチだ。
		//○ボタンを押せ。
	}
	talk 大佐 標準 -m {
		 [PC_戦闘＿パンチ:大佐_001]
		//連打すれば連続技で
		//敵を吹き飛ばすことが出来るぞ。
	}
	talk 大佐 標準 -m {
		 [PC_戦闘＿パンチ:大佐_002]
		//ＶＲ訓練とは違って主観でも攻撃できる。
		//うまく使うんだ。
	}
}//v
}//d
//投げ h //e
//proc rp_PC_戦闘＿投げ:07
proc rp_PC_戦闘＿投げ:07 {
vox t:vc264741 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_戦闘＿投げ:大佐_000]
		//武器を装備していない場合のみ、
		//敵に接近して□ボタンで投げ技が使える。
	}
	talk 大佐 標準 -m {
		 [PC_戦闘＿投げ:大佐_001]
		//パンチよりも大きなダメージを
		//与えることが出来るぞ。
	}
}//v
}//d
//首絞め h //e
//proc rp_PC_戦闘＿首絞め:07
proc rp_PC_戦闘＿首絞め:07 {
vox d:_vc264751 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_戦闘＿首絞め:大佐_000]
		//敵の背後から左スティックを入れずに
		//□ボタンを押せば、相手の首を絞める
		//ことが出来るぞ。
	}
	talk 大佐 標準 -m {
		 [PC_戦闘＿首絞め:大佐_001]
		//また、そのまま絞め続ければ、
		//相手を倒す事も出来る。活殺自在だ。
		//うまく使うんだぞ。
	}
}//v
}//d
//水中安全 h //e
//proc rp_PC_海底ドック＿水中逃げろ:07
proc rp_PC_海底ドック＿水中逃げろ:07 {
vox t:vc264761 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_海底ドック＿水中逃げろ:大佐_000]
		//ライデン、敵に追われているのか？
		//敵も水中までは追ってこれないはずだ。
		//水中に飛び込め。
	}
}//v
}//d
//主観左右ステップ h //e
//proc rp_PC_主観左右ステップ:07
proc rp_PC_主観左右ステップ:07 {
vox d:_vc264771 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_主観左右ステップ:大佐_000]
		//ライデン、主観カメラの時にＲ１ボタン
		//を押すと右、Ｌ１ボタンを押すと左に
		//一歩ステップすることが出来る。
	}
	talk 大佐 標準 -m {
		 [PC_主観左右ステップ:大佐_001]
		//物陰からさっと体を出して、
		//先の様子を伺うことができるわけだ。
	}
	talk 大佐 標準 -m {
		 [PC_主観左右ステップ:大佐_002]
		//だが物陰から出てる間は、
		//当然見つかりやすくなる。
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_主観左右ステップ:大佐_003]
		//だから敵が迫ってきたらボタンを離して
		//すぐに物陰に戻る事を忘れるな。
	}
}//v
}//d
//無線操作 h //e
//proc rp_PC_無線操作:07
proc rp_PC_無線操作:07 {
vox d:_vc264781 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_無線操作:大佐_000]
		//無線機画面に入ったら、左スティックの
		//左右で周波数を合わるんだ。
	}
	talk 大佐 標準 -m {
		 [PC_無線操作:大佐_001]
		//それから左スティックの上か○ボタンを
		//押せば、その周波数で通信をすることが
		//できる。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_無線操作:大佐_002]
		//無線機には一度会話した相手の周波数を
		//記憶しておく機能もついている。
	}
	talk 大佐 標準 -m {
		 [PC_無線操作:大佐_003]
		//無線機画面で左スティックの下を押せば、
		//メモリーウインドウが開く。
	}
	talk 大佐 標準 -m {
		 [PC_無線操作:大佐_004]
		//メモリーウインドウの中には、
		//記憶された周波数のリストが表示される。
	}
	talk 大佐 標準 -m {
		 [PC_無線操作:大佐_005]
		//通信したい周波数を選択して○ボタンを
		//押すだけで、その周波数で通信を
		//することが出来るぞ。
	}
}//v
}//d

//ビハインド h //e
//proc rp_PC_ビハインド１:07
proc rp_PC_ビハインド１:07 {
vox t:vc264791 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ビハインド１:大佐_000]
		//ライデン、物陰の角に張り付くと、
		//自分は隠れながら背後の様子を
		//覗き見ることが出来る。
	}
	talk 大佐 標準 -m {
		 [PC_ビハインド１:大佐_001]
		//それがビハインドカメラだ。
		//これを利用して敵の隙を伺い、
		//発見されないように進むんだ。
	}
}//v
}//d
//proc rp_PC_ビハインド２:07
proc rp_PC_ビハインド２:07 {
vox d:_vc264801 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ビハインド２:大佐_000]
		//ＶＲ訓練の時とは違い、左右に移動が
		//出来る。
	}
	talk 大佐 標準 -m {
		 [PC_ビハインド２:大佐_001]
		//Ｌ２ボタン、Ｒ２ボタンで覗き込み、
		//□ボタンで飛び出し撃ちなど可能だ。
		//有効に使え。
	}
}//v
}//d

//壁叩き h //e
//proc rp_PC_壁叩き１:07
proc rp_PC_壁叩き１:07 {
vox t:vc264811 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_壁叩き１:大佐_000]
		//壁に張りついて○ボタンを押せば、
		//壁を叩いて物音を立てることが
		//出来る。
	}
}//v
}//d
//一回目のみ t //e
//proc rp_PC_壁叩き２:07
proc rp_PC_壁叩き２:07 {
vox t:vc264821 {
@rp_うなづきデフォルト＿是
@rp_キテレツさん＿否２＿意味不明系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_壁叩き２:大佐_000]
		//敵を騙しておびきよせることもできるな。
	}
	talk 大佐 標準 -m {
		 [PC_壁叩き２:大佐_001]
		//騙すのはお得意だろう？
	}
	talk 大佐 標準 -m {
		 [PC_壁叩き２:大佐_002]
		//美人相手でなければ、その甲斐もないか。
	}
}//v
}//d

//アイテムボックス h //e
//proc rp_PC_アイテムボックス:07
proc rp_PC_アイテムボックス:07 {
vox t:vc264831 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_アイテムボックス:大佐_000]
		//アイテムボックスを見つけたら、
		//取る前に近寄って主観で見てみるといい。
	}
	talk 大佐 標準 -m {
		 [PC_アイテムボックス:大佐_001]
		//ボックスの中に何が入っているか
		//わかるはずだ。
	}
}//v
}//d

//アイテムボックス入手 h //e
//proc rp_PC_アイテムボックス入手:07
proc rp_PC_アイテムボックス入手:07 {
vox t:vc264841 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_アイテムボックス入手:大佐_000]
		//倒した敵の体を動かすと
		//アイテムボックスがこぼれ落ちることが
		//ある。すかさず手に入れるんだ。
	}
}//v
}//d

//敵兵盾 h //e
//proc rp_PC_敵兵盾:07
proc rp_PC_敵兵盾:07 {
vox t:vc264851 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_敵兵盾:大佐_000]
		//背後から敵の首を絞めると、
		//手を離さなければ、そのままひきずって
		//移動することが出来る。
	}
@rp_邪道外道＿否２＿ひどい系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_敵兵盾:大佐_001]
		//つまり、敵を自分の盾にする事も可能だ。
	}
}//v
}//d

//見つかるな注意 h //e
//proc rp_PC_見つかるな注意:07
proc rp_PC_見つかるな注意:07 {
vox t:vc264861 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_見つかるな注意:大佐_000]
		//これが潜入任務だということを忘れるな、
		//ライデン。
	}
	talk 大佐 標準 -m {
		 [PC_見つかるな注意:大佐_001]
		//敵は多数、君は一人。
		//もし見つかってしまったら、
		//あっという間に取り囲まれるぞ。
	}
}//v
}//d

//主観攻撃 h //e
//proc rp_PC_主観攻撃１:07
proc rp_PC_主観攻撃１:07 {
vox d:_vc264871 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_主観攻撃１:大佐_000]
		//武器を装備して、Ｒ１ボタンで
		//主観カメラにすれば、□ボタンで
		//主観攻撃が出来る。
	}
}//v
}//d
//proc rp_PC_主観攻撃２:07
proc rp_PC_主観攻撃２:07 {
vox t:vc264881 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_主観攻撃２:大佐_000]
		//主観攻撃ならば敵の頭や足などを
		//狙うことが出来る。上や下など俯瞰では
		//攻撃出来ない方向にも攻撃出来る。
	}
}//v
}//d
//＊ムービー t //e
//proc rp_PC_主観攻撃＿左右ステップ１:07
proc rp_PC_主観攻撃＿左右ステップ１:07 {
vox d:_vc264891 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_主観攻撃＿左右ステップ１:大佐_000]
		//主観攻撃中にもＬ２ボタン、Ｒ２ボタン
		//を押せば左右にステップし、×ボタンを
		//押せばしゃがむことが出来る。
	}
	talk 大佐 標準 -m {
		 [PC_主観攻撃＿左右ステップ１:大佐_001]
		//Ｌ２ボタンとＲ２ボタンを動じに押せば
		//背伸びをすることも可能だ。
	}
	talk 大佐 標準 -m {
		 [PC_主観攻撃＿左右ステップ１:大佐_002]
		//遮蔽物に隠れながらの銃撃戦では
		//有効になる。うまく使うんだ。
	}
}//v
}//d
//銃構えおろし h //e
//proc rp_PC_銃構えおろし１＿１:07
proc rp_PC_銃構えおろし１＿１:07 {
vox t:vc264901 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_銃構えおろし１＿１:大佐_000]
		//ハンドガンは□ボタンを押して構えても
		//ボタンをそっと離せば発砲せずに
		//銃を下ろすことが出来る。
	}
}//v
}//d

//ローズいる場合 t //e
//proc rp_PC_銃構えおろし２:07
proc rp_PC_銃構えおろし２:07 {
vox t:vc264911 {
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_銃構えおろし２:ローズ_000]
		//ホールドアップさせても撃たずに
		//すませられるってことね。
	}
}//v
}//d
//麻酔部位ダメージ h //e
//proc rp_PC_麻酔部位ダメージ:07
proc rp_PC_麻酔部位ダメージ:07 {
vox t:vc264921 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_麻酔部位ダメージ:大佐_000]
		//ライデン、麻酔弾は敵の体のどこに
		//命中したかで効き方が変わる。
	}
	talk 大佐 標準 -m {
		 [PC_麻酔部位ダメージ:大佐_001]
		//手足など体の末端に当たった場合は
		//麻酔が効くまでに時間がかかる。
	}
	talk 大佐 標準 -m {
		 [PC_麻酔部位ダメージ:大佐_002]
		//頭や心臓に当てれば即座に昏倒させる
		//ことが出来る。主観攻撃でよく狙うんだ。
	}
}//v
}//d

//部位ダメージ h //e
//proc rp_PC_部位ダメージ:07
proc rp_PC_部位ダメージ:07 {
vox t:vc264931 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_部位ダメージ:大佐_000]
		//ハンドガンや自動小銃の弾は、
		//命中した個所によって与えるダメージが
		//変わる。
	}
	talk 大佐 標準 -m {
		 [PC_部位ダメージ:大佐_001]
		//右手を撃ち抜けば右手が使えなくなり、
		//足を撃ち抜けば走れなくなる。頭や心臓、
		//急所を撃てば一撃で倒すことが出来る。
	}
	talk 大佐 標準 -m {
		 [PC_部位ダメージ:大佐_002]
		//状況に応じて効果的な部位を撃つんだ。
		//主観攻撃でよく狙え。
	}
}//v
}//d
//無線機破壊 h //e
//proc rp_PC_無線機破壊:07
proc rp_PC_無線機破壊:07 {
vox t:vc264941 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_無線機破壊:大佐_000]
		//腰の右後ろにある無線機を撃って壊せば、
		//敵が応援を呼ぶのを防ぐことが出来る。
		//主観攻撃でよく狙うんだ。
	}
}//v
}//d

//ローリング h //e
//＊ムービー t //e
//proc rp_PC_ローリング:07
proc rp_PC_ローリング:07 {
vox t:vc264951 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ローリング:大佐_000]
		//走りながらＸボタンを押すと
		//ローリングになる。
	}
	talk 大佐 標準 -m {
		 [PC_ローリング:大佐_001]
		//短い距離をジャンプ出来るし、
		//ローリングに巻き込めば
		//敵を吹き飛ばすことも可能だ。
	}
}//v
}//d

//そろそろ歩き h //e
//proc rp_PC_そろそろ歩き:07
proc rp_PC_そろそろ歩き:07 {
vox d:_vc264961 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_そろそろ歩き:大佐_000]
		//左スティックの倒し具合を少しに
		//すればゆっくり歩くことが出来る。
	}
	talk 大佐 標準 -m {
		 [PC_そろそろ歩き:大佐_001]
		//走ると音が鳴ってしまう場所でも足音を立てずに歩けるはずだ。
	}
}//v
}//d
//覗き込み h //e
//＊ムービー t //e
//proc rp_PC_覗き込み:07
proc rp_PC_覗き込み:07 {
vox d:_vc264971 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_覗き込み:大佐_000]
		//ビハインドカメラ時にＬ２ボタンまたは
		//Ｒ２ボタンを押すと物陰から頭を出して
		//その方向を覗き込むことが出来る。
	}
	talk 大佐 標準 -m {
		 [PC_覗き込み:大佐_001]
		//より遠くを見通すことが出来るが、
		//頭を出しているところを敵に
		//見つからないように注意しろ。
	}
}//v
}//d
//ビハインド右スティック h //e
//＊ムービー t //e
//proc rp_PC_右スティック:07
proc rp_PC_右スティック:07 {
vox d:_vc264981 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_右スティック:大佐_000]
		//ビハインドカメラ時に右スティックを
		//動かせばその方向を伺うことが出来る。
	}
	talk 大佐 標準 -m {
		 [PC_右スティック:大佐_001]
		//通常のビハインドよりも多くの
		//情報を収集できるはずだ。
	}
	talk 大佐 標準 -m {
		 [PC_右スティック:大佐_002]
		//Ｌ２ボタン、Ｒ２ボタンによる
		//覗き込みとは違い、体を乗り出さない
		//ぶん安全でもある。有効に使え。
	}
}//v
}//d

//飛び出し撃ち h //e
//ムービー t //e
//proc rp_PC_飛び出し撃ち:07
proc rp_PC_飛び出し撃ち:07 {
vox t:vc264991 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_飛び出し撃ち:大佐_000]
		//ビハインドカメラの時にハンドガンや
		//自動小銃を装備しているなら、
		//□ボタンで飛び出し撃ちが出来る。
	}
	talk 大佐 標準 -m {
		 [PC_飛び出し撃ち:大佐_001]
		//遮蔽物に隠れながら様子を伺い、
		//相手の隙を見て素早く銃撃を加える
		//ことが出来るぞ。
	}
}//v
}//d

//インケン投げ（仮） h //e
//ムービー t //e
//proc rp_PC_インケン投げ:07
proc rp_PC_インケン投げ:07 {
vox t:vc265001 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_インケン投げ:大佐_000]
		//覗き込みをしている時にグレネードを
		//装備していれば□ボタンで遮蔽物を背に
		//グレネードを投げることが出来る。
	}
	talk 大佐 標準 -m {
		 [PC_インケン投げ:大佐_001]
		//曲がり角の向こう側に多数の敵を
		//発見した時などに有効だろう。
		//うまく使ってくれ。
	}
}//v
}//d

//影が見つかる h //e
//ムービー t //e
//proc rp_PC_影が見つかる:07
proc rp_PC_影が見つかる:07 {
vox t:vc265011 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_影が見つかる:大佐_000]
		//影が大きく伸びるような場所では自分の
		//影に注意しろ。伸びた影で敵に存在を
		//気取られてしまうこともあるかもしれん。
	}
}//v
}//d

//壊れ物壊すな h //e
//proc rp_PC_コワレモノ:07
proc rp_PC_コワレモノ:07 {
vox t:vc265021 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_コワレモノ:大佐_000]
		//ライデン、潜入任務の基本は隠密行動に
		//ある。潜入の痕跡は残さない方が賢明だ。
		//物を破壊するのは控えた方がいい。
	}
}//v
}//d

//探索モード h //e
//proc rp_PC_探索モード:07
proc rp_PC_探索モード:07 {
vox t:vc265031 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_探索モード:大佐_000]
		//ライデン、一度発見されたら追跡を
		//振り切っても気を抜いてはいけない。
	}
	talk 大佐 標準 -m {
		 [PC_探索モード:大佐_001]
		//敵は侵入者、つまり君を刈り出すために
		//警戒を強化するだろう。見張りも
		//増員されるかもしれん。気をつけろ。
	}
}//v
}//d

//暗がりに隠れられる h //e
//proc rp_PC_ヒドゥンポイント:07
proc rp_PC_ヒドゥンポイント:07 {
vox t:vc265041 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ヒドゥンポイント:大佐_000]
		//暗い場所では敵も君の姿が見にくくなる。
		//暗がりにいれば敵をやりすごせる確率も
		//高くなるだろう。
	}
}//v
}//d

//マガジンもっている時 h //e
//＊ムービー t //e
//proc rp_PC_マガジン投げ:07
proc rp_PC_マガジン投げ:07 {
vox t:vc265051 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_マガジン投げ:大佐_000]
		//マガジンは撃ち尽くして空になった
		//ハンドガンや自動小銃の弾倉だ。
		//□ボタンで投げることが出来る。
	}
	talk 大佐 標準 -m {
		 [PC_マガジン投げ:大佐_001]
		//殺傷能力があるわけではないが、
		//地面に落ちた時の音で敵の気を引く
		//ことが出来るだろう。
	}
	talk 大佐 標準 -m {
		 [PC_マガジン投げ:大佐_002]
		//敵をおびき寄せるのに役立つかもな。
	}
}//v
}//d



//武器・アイテム装備方法 h //e
//proc rp_PC_武器装備品装備法１:07
proc rp_PC_武器装備品装備法１:07 {
vox d:_vc265061 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_武器装備品装備法１:大佐_000]
		//武器を装備するには、Ｒ２ボタンを
		//押しっぱなしにして武器ウィンドウを
		//開け。武器のアイコンが表示される。
	}
	talk 大佐 標準 -m {
		 [PC_武器装備品装備法１:大佐_001]
		//その中から使いたい武器を
		//左スティックの上下で選んで
		//右下に合わせるんだ。
	}
@rp_うなづきデフォルト＿是
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_武器装備品装備法１:大佐_002]
		//ＶＲ訓練と少し違うのは同じ系統の
		//武器をいくつか持っている場合、
		//アイコンが横に並んで表示されることだ。
	}
	talk 大佐 標準 -m {
		 [PC_武器装備品装備法１:大佐_003]
		//横に並んでいる武器の中から使いたい
		//ものを左スティックの左右で選んで
		//一番右に合わせろ。
	}
	talk 大佐 標準 -m {
		 [PC_武器装備品装備法１:大佐_004]
		//そこでＲ２ボタンを離せば、
		//君の手に選んだ武器が握られている
		//はずだ。
	}
	talk 大佐 標準 -m {
		 [PC_武器装備品装備法１:大佐_005]
		//それぞれの武器の使い方は、
		//ウィンドウに表示される説明に
		//従ってくれ。
	}
}//v
}//d

//proc rp_PC_武器装備品装備法２:07
proc rp_PC_武器装備品装備法２:07 {
vox d:_vc265071 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_武器装備品装備法２:大佐_000]
		//レーション等の装備品を装備する時は
		//Ｌ２ボタンで同じことをすればいい。
	}
}//v
}//d

//ＣＡＬＬ受信していない場合 h //e
//proc rp_PC_ＣＡＬＬ:07
proc rp_PC_ＣＡＬＬ:07 {
vox d:_vc265081 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ＣＡＬＬ:大佐_000]
		//ライデン、こちらから連絡のある場合は
		//ＣＡＬＬする。
	}
	talk 大佐 標準 -m {
		 [PC_ＣＡＬＬ:大佐_001]
		//ＣＡＬＬサインが出たら
		//ＳＥＬＥＣＴボタンを押して
		//受信するんだ。
	}
}//v
}//d

//足跡エリア h //e
//proc rp_PC_足跡:07
proc rp_PC_足跡:07 {
vox t:vc265091 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_足跡:大佐_000]
		//ライデン、濡れた足で歩けば当然足跡が
		//残る。そして敵がそれを見逃すはずも
		//ない。
	}
	talk 大佐 標準 -m {
		 [PC_足跡:大佐_001]
		//足跡を残さないようにするには
		//ホフクで進めばいい。
	}
}//v
}//d

//爆発しない赤外線センサー h //e
//proc rp_PC_赤外センサー＿警報:07
proc rp_PC_赤外センサー＿警報:07 {
vox t:vc265101 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_赤外センサー＿警報:大佐_000]
		//ライデン、気をつけろ。
		//そこには赤外線センサーが
		//仕掛けられている。
	}
	talk 大佐 標準 -m {
		 [PC_赤外センサー＿警報:大佐_001]
		//赤外線に触れると警報がなるぞ。
		//赤外線には触れるな。
	}
}//v
}//d

//赤外線センサーかわせる h //e
//proc rp_PC_くぐる赤外センサー:07
proc rp_PC_くぐる赤外センサー:07 {
vox t:vc265111 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_くぐる赤外センサー:大佐_000]
		//赤外線の本数はそれほど多くないな。
		//うまくやれば触れずに通り抜けられる
		//だろう。
	}
}//v
}//d
//赤外線センサー制御装置がない h //e
//proc rp_PC_赤外センサー＿制御装置なし:07
proc rp_PC_赤外センサー＿制御装置なし:07 {
vox t:vc265121 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_赤外センサー＿制御装置なし:大佐_000]
		//その赤外線センサーに制御装置は
		//見当たらない。
	}
	talk 大佐 標準 -m {
		 [PC_赤外センサー＿制御装置なし:大佐_001]
		//制御装置を破壊してセンサーを
		//無効にする方法は使えないだろう。
	}
	talk 大佐 標準 -m {
		 [PC_赤外センサー＿制御装置なし:大佐_002]
		//赤外線に触れないように
		//通り抜けるしかないようだな。
	}
}//v
}//d







//後回し会話 d //e
//海底ドック d //e
//フナムシ説明 h//e
//proc rp_PC_フナムシ１:07
/*
proc rp_PC_フナムシ１:07 {
vox t:vc265131 {
	@rpb_PC_フナムシ１
}//v
}//d
*/

proc rpb_PC_フナムシ１:07 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_フナムシ１:ライデン_000]
		//すこい虫だ……。海水が原油で汚染
		//されているのに、なぜフナムシが？
	}
}//d

//無線機内スクリーンに船虫の映像か、ＰＩＣＴ。 t//e
//proc rp_PC_フナムシ２:07
/*
proc rp_PC_フナムシ２:07 {
vox t:vc265141 {
	@rpb_PC_フナムシ２
}//v
}//d
*/

proc rpb_PC_フナムシ２:07 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_フナムシ２:大佐_000]
		//その虫は原油を分解する働きを持った、
		//言わば創られた虫だ。
	}
	talk ライデン 標準 -m {
		 [PC_フナムシ２:ライデン_001]
		//創られた？
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_フナムシ２:大佐_002]
		//ああ。遺伝子操作でな。頻繁に発生する
		//原油流出事故対応の為に研究所で
		//生まれたものだ。自然界には存在しない。
	}
	talk 大佐 標準 -m {
		 [PC_フナムシ２:大佐_003]
		//その虫には石油を分解するバクテリア、
		//プセドウモナスの遺伝子が取り入れて
		//ある。
	}
	talk 大佐 標準 -m {
		 [PC_フナムシ２:大佐_004]
		//体内に石油を分解する酵素を持って
		//いて、吸着した原油を食べる習性を
		//与えられているんだ。
	}
@rp_うなづきデフォルト＿是
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_フナムシ２:大佐_005]
		//『ビッグ・シェル』があまり油で
		//汚れていないのはその虫のおかげとも
		//言える。
	}
	talk 大佐 標準 -m {
		 [PC_フナムシ２:大佐_006]
		//メンテナンス要員と費用の削減にも
		//役立っている。
	}
	talk 大佐 標準 -m {
		 [PC_フナムシ２:大佐_007]
		//一種のバイオレメディエーションだ。
		//基本的に害はないから安心しろ。
	}
}//d

//proc rp_PC_フナムシ４:07
proc rp_PC_フナムシ４:07 {
vox t:vc265151 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_フナムシ４:大佐_000]
		//そこにいる虫は食欲旺盛だ。
		//レーションを食われないように注意しろ。
	}
}//v
}//d


//潜水艇近く h //e
//proc rp_PC_海底ドック潜水艇１:07
proc rp_PC_海底ドック潜水艇１:07 {
vox t:vc265161 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_海底ドック潜水艇１:大佐_000]
		//ライデン、そこにあるのは海底作業用の
		//潜水艇だ。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_海底ドック潜水艇１:大佐_001]
		//『ビッグ・シェル』の水中部分の補修や
		//海底の生態系、水質変化などを調査する
		//ために使われているようだな。
	}
	talk 大佐 標準 -m {
		 [PC_海底ドック潜水艇１:大佐_002]
		//５００ｍ程度まで潜航することが出来、
		//最大速力は約三ノット。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_海底ドック潜水艇１:大佐_003]
		//通常耐水ライトの他に濁水用耐水ライトも装備されている。
	}
	talk 大佐 標準 -m {
		 [PC_海底ドック潜水艇１:大佐_004]
		//だが君には動かすことは出来ないだろう。
	}
}//v
}//d
//二回目以降 t //e
//proc rp_PC_海底ドック潜水艇２:07
proc rp_PC_海底ドック潜水艇２:07 {
vox t:vc265171 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_海底ドック潜水艇２:大佐_000]
		//その潜水艇は利用できない。
		//脅威にもならないだろう。
		//構わずに任務を続行するんだ。
	}
}//v
}//d

//ジムスーツ h //e
//proc rp_PC_ジムスーツ１:07
/*
proc rp_PC_ジムスーツ１:07 {
vox t:vc265181 {
	@rpb_PC_ジムスーツ１
}//v
}//d
*/

proc rpb_PC_ジムスーツ１:07 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_ジムスーツ１:ライデン_000]
		//大佐、
		//ジムスーツがある。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_ジムスーツ１:大佐_001]
		//ああ。大気圧潜水服だな。
		//スーツ内を１気圧に保つことで３００ｍ
		//ほどでの海中作業が可能なはず。
	}
	talk 大佐 標準 -m {
		 [PC_ジムスーツ１:大佐_002]
		//しかしそいつは利用出来そうもないぞ。
		//かなりの旧式だ。
	}
	talk ライデン 標準 -m {
		 [PC_ジムスーツ１:ライデン_003]
		//ああ。しかもあちこち錆びついている。
		//使われた形跡もない……？
	}
}//d

//二回目以降 t //e
//proc rp_PC_ジムスーツ２:07
proc rp_PC_ジムスーツ２:07 {
vox t:vc265191 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ジムスーツ２:大佐_000]
		//ライデン、その潜水服は使えそうもない。
		//構わずに任務を続行するんだ。
	}
}//v
}//d

//proc rp_PC_ノードうんちく:07
proc rp_PC_ノードうんちく:07 {
vox t:vc265201 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ノードうんちく:大佐_000]
		//ノードは『ビッグ・シェル』の
		//作業支援用コンピュータネットワークの
		//端末だ。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_ノードうんちく:大佐_001]
		//勿論、『ビッグ・シェル』職員以外は
		//アクセスできないし、職分によって
		//権限もアクセスできる対象も異なる。
	}
	talk 大佐 標準 -m {
		 [PC_ノードうんちく:大佐_002]
		//君のナノマシンにアクセス権限無制限の
		//パスコードを自動的に入力する仕組みを
		//インストールしておいた。
	}
	talk 大佐 標準 -m {
		 [PC_ノードうんちく:大佐_003]
		//ノードの前で△ボタンを押せばそれが
		//発動するようにしてある。ノードを
		//使うには端末の前で△ボタンを押すんだ。
	}
}//v
}//d


//Ａ脚屋上 d //e
//金網近く h //e
//proc rp_PC_Ａ脚屋上ホフク金網３:07
proc rp_PC_Ａ脚屋上ホフク金網３:07 {
vox t:vc265211 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_Ａ脚屋上ホフク金網３:ライデン_000]
		//大佐、ここだけ金網が外れているのは
		//変じゃないか？
	}
	talk 大佐 標準 -m {
		 [PC_Ａ脚屋上ホフク金網３:大佐_001]
		//確かにな。
	}
	talk ライデン 標準 -m {
		 [PC_Ａ脚屋上ホフク金網３:ライデン_002]
		//まさかさっきの男が……。
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_Ａ脚屋上ホフク金網３:大佐_003]
		//その可能性はある。
		//油断するな。
	}
	talk ライデン 標準 -m {
		 [PC_Ａ脚屋上ホフク金網３:ライデン_004]
		//……了解。
	}
}//v
}//d

//海鳥の糞について h //e
//proc rp_PC_海鳥糞１:07
proc rp_PC_海鳥糞１:07 {
vox t:vc265221 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_海鳥糞１:大佐_000]
		//ライデン、そのあたりには海鳥の糞が
		//たまっている。走ると滑るぞ。注意しろ。
	}
}//v
}//d
//一回目のみ t //e
//proc rp_PC_海鳥糞２:07
proc rp_PC_海鳥糞２:07 {
vox t:vc265231 {
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_海鳥糞２:大佐_000]
		//二年前のタンカー事件で流出した
		//原油には環境ホルモンが多量に
		//含まれていた。
	}
	talk 大佐 標準 -m {
		 [PC_海鳥糞２:大佐_001]
		//それを飲み込んだ魚を食べている
		//海鳥の体内ではさらに環境ホルモンが
		//濃縮されている。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_海鳥糞２:大佐_002]
		//それがどのような結果を生むのかは
		//いまだ調査中で結果は出ていない。
	}
	talk 大佐 標準 -m {
		 [PC_海鳥糞２:大佐_003]
		//海上の原油を処理し終わったとしても
		//それで環境回復が終了するわけでは
		//ないということだ。
	}
}//v
}//d


//Ｆ脚倉庫 d //e
//武器取得後 h //e
//proc rp_PC_Ｆ脚武器入手後:07
proc rp_PC_Ｆ脚武器入手後:07 {
vox t:vc265241 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_Ｆ脚武器入手後:大佐_000]
		//ライデン、武器を手に入れたな。
	}
	talk ライデン 標準 -m {
		 [PC_Ｆ脚武器入手後:ライデン_001]
		//なぜこんなところに武器が……？
		//この『ビッグ・シェル』はただの
		//海洋除染施設のはずだろう？
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_Ｆ脚武器入手後:ローズ_002]
		//テロリストが持ち込んだんじゃないの？
	}
	talk ライデン 標準 -m {
		 [PC_Ｆ脚武器入手後:ライデン_003]
		//……そうだろうか？
		//まるで初めからここにあったような
		//感じだ。
	}
	talk ローズ 標準 -m {
		 [PC_Ｆ脚武器入手後:ローズ_004]
		//そんなことって……？
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_Ｆ脚武器入手後:大佐_005]
		//ライデン、余計な疑念を差し挟んでいる
		//時間はないぞ。任務に集中するんだ。
	}
	talk ライデン 標準 -m {
		 [PC_Ｆ脚武器入手後:ライデン_006]
		//……了解。
	}
}//v
}//d


//Ｂ脚 d //e
//ＳＥＡＬＳ死体近く h //e
//proc rp_PC_ＳＥＡＬＳ死体１:07
proc rp_PC_ＳＥＡＬＳ死体１:07 {
vox t:vc265251 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_ＳＥＡＬＳ死体１:ライデン_000]
		//大佐！
	}
	talk 大佐 標準 -m {
		 [PC_ＳＥＡＬＳ死体１:大佐_001]
		//ああ。ＳＥＡＬ１０の隊員に違いない。
	}
	talk ライデン 標準 -m {
		 [PC_ＳＥＡＬＳ死体１:ライデン_002]
		//しかし妙だ。銃撃戦の痕跡があるが
		//交戦相手の痕跡はない……。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_ＳＥＡＬＳ死体１:ローズ_003]
		//どういうこと？
	}
	talk ライデン 標準 -m {
		 [PC_ＳＥＡＬＳ死体１:ライデン_004]
		//ＳＥＡＬ１０が一方的に
		//壊滅させられたってことだ。
	}
	talk ローズ 標準 -m {
		 [PC_ＳＥＡＬＳ死体１:ローズ_005]
		//そんなことって……？
		//ＳＥＡＬＳは海軍の精鋭中の
		//精鋭でしょう？
	}
	talk ライデン 標準 -m {
		 [PC_ＳＥＡＬＳ死体１:ライデン_006]
		//ああ……。弾痕の様子を見ると何か
		//パニック状態で撃ちまくったようにも
		//とれる。……一体……？
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ＳＥＡＬＳ死体１:大佐_007]
		//わからん。だが大統領の身が危ないこと
		//だけは確かだ。ライデン、急ぐんだ。
	}
	talk ライデン 標準 -m {
		 [PC_ＳＥＡＬＳ死体１:ライデン_008]
		//……了解。
	}
}//v
}//d

//眠りプリスキン近く h //e
//proc rp_PC_眠りプリスキン:07
proc rp_PC_眠りプリスキン:07 {
vox t:vc265261 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_眠りプリスキン:大佐_000]
		//ライデン、その男のことは放っておけ。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
