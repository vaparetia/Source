	}
}//v
}//d

//エマの座り込み h //e
//proc rp_PC_エマ手つなぎ＿座り込み１:07
proc rp_PC_エマ手つなぎ＿座り込み１:07 {
vox t:vc264221 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エマ手つなぎ＿座り込み１:大佐_000]
		//ライデン、エマの様子はどうだ？
	}
	talk ライデン 標準 -m {
		 [PC_エマ手つなぎ＿座り込み１:ライデン_001]
		//オセロットに打たれた薬物の影響が
		//まだ残っているようだ。足元がかなり
		//おぼつかない。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_エマ手つなぎ＿座り込み１:ローズ_002]
		//かわいそう。守ってあげてね。
	}
	talk ライデン 標準 -m {
		 [PC_エマ手つなぎ＿座り込み１:ライデン_003]
		//わかってる。
	}
}//v
}//d
//proc rp_PC_エマ手つなぎ＿座り込み２:07
proc rp_PC_エマ手つなぎ＿座り込み２:07 {
vox t:vc264231 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エマ手つなぎ＿座り込み２:大佐_000]
		//薬物の影響で、エマは一人で歩くことも
		//ままならない。君が手を離すと、彼女は
		//その場に座り込んでしまうだろう。
	}
	talk 大佐 標準 -m {
		 [PC_エマ手つなぎ＿座り込み２:大佐_001]
		//手を離す時は安全な場所で離すように
		//するんだ。間違っても敵の真ん中に
		//エマを放り出したりするな。
	}
}//v
}//d

