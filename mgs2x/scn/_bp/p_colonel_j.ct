//死体の隠し方 h //e
//proc rp_PC_Ａ脚１Ｆ死体隠せ１:07
proc rp_PC_Ａ脚１Ｆ死体隠せ１:07 {
vox t:vc260841 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_Ａ脚１Ｆ死体隠せ１:大佐_000]
		//敵を倒したな、ライデン。敵の体を
		//その場に放っておいてはいけない。
		//すぐに隠すんだ。
	}
	talk 大佐 標準 -m {
		 [PC_Ａ脚１Ｆ死体隠せ１:大佐_001]
		//屋上に行った敵が戻って来て、
		//倒れた仲間を発見すれば警戒を強化する
		//だろう。面倒なことになる。
	}
}//v
}//d
//proc rp_PC_Ａ脚１Ｆ死体隠せ２:07
proc rp_PC_Ａ脚１Ｆ死体隠せ２:07 {
vox t:vc260851 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_Ａ脚１Ｆ死体隠せ２:大佐_000]
		//倒した敵の体は、敵が見回りに来そうも
		//ない所、見つかりそうもないところに
		//隠すといい。
	}
}//v
}//d
//死体引きずり方法説明へ t //e

//死体定時連絡 h //e
//proc rp_PC_死体定時連絡:07
proc rp_PC_死体定時連絡:07 {
vox t:vc260861 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_死体定時連絡:大佐_000]
		//敵は一定時間毎に定時連絡を行っている。
		//応えない隊員がいれば、状況を確かめる
		//ために増員が送られてくるはずだ。
	}
	talk 大佐 標準 -m {
		 [PC_死体定時連絡:大佐_001]
		//増員が倒れた仲間を発見すれば、敵は
		//当然警戒を強化するだろう。倒した敵の
		//体は発見されにくい場所に隠すんだ。
	}
}//v
}//d


//敵が仲間を呼ぶ h //e
//proc rp_PC_敵の無線連絡１:07
proc rp_PC_敵の無線連絡１:07 {
vox t:vc260871 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_敵の無線連絡１:大佐_000]
		//ライデン、気をつけろ。
		//敵が無線を使えないのは
		//海底ドックだけだ。
	}
}//v
}//d

//proc rp_PC_敵の無線連絡２:07
proc rp_PC_敵の無線連絡２:07 {
vox t:vc260881 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_敵の無線連絡２:大佐_000]
		//敵は君を見つけると無線で増援部隊を
		//呼ぶぞ。増援部隊は手強い。まともに
		//やりあうのは危険だ。
	}
}//v
}//d

//増援部隊について h //e
//proc rp_PC_増援部隊１:07
proc rp_PC_増援部隊１:07 {
vox t:vc260891 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_増援部隊１:大佐_000]
		//敵の増援部隊は全身を防弾装備で
		//覆っている。倒すには頭を狙うしか
		//ないぞ。主観攻撃を使うんだ。
	}
}//v
}//d
//proc rp_PC_増援部隊２:07
proc rp_PC_増援部隊２:07 {
vox t:vc260901 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_増援部隊２:大佐_000]
		//敵の増援部隊は全身を防弾装備で
		//覆っている。頭以外への攻撃は効果が
		//薄いぞ。主観攻撃で頭を狙うんだ。
	}
}//v
}//d
//主観攻撃説明を聞いていない場合、主観攻撃説明へ t //e


//仲間を呼ばせない方法 h //e
//proc rp_PC_仲間を呼ばせない方法１:07
proc rp_PC_仲間を呼ばせない方法１:07 {
vox t:vc260911 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_仲間を呼ばせない方法１:大佐_000]
		//例え敵に見つかっても増援が
		//呼ばれるのを防ぐ方法はいくつかある。
	}
}//v
}//d
//proc rp_PC_仲間を呼ばせない方法＿倒す:07
proc rp_PC_仲間を呼ばせない方法＿倒す:07 {
vox t:vc260921 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_仲間を呼ばせない方法＿倒す:大佐_000]
		//敵が無線連絡をする前、つまり無線機を
		//手にとる前にその敵を倒せば増援部隊を
		//呼ぶのを防ぐことが出来る。
	}
}//v
}//d

//proc rp_PC_仲間を呼ばせない方法＿チャフ:07
proc rp_PC_仲間を呼ばせない方法＿チャフ:07 {
vox t:vc260931 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_仲間を呼ばせない方法＿チャフ:大佐_000]
		//チャフ・グレネードを使って電子妨害を
		//仕掛ければ敵の無線は使用不能になる。
		//敵は増援部隊を呼べなくなるはずだ。
	}
}//v
}//d

//proc rp_PC_仲間を呼ばせない方法＿無線破壊:07
proc rp_PC_仲間を呼ばせない方法＿無線破壊:07 {
vox t:vc260941 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_仲間を呼ばせない方法＿無線破壊:大佐_000]
		//敵が持っている無線機を破壊すれば、
		//当然敵は無線連絡が出来なくなる。
		//増援を呼ばれる危険もなくなるだろう。
	}
	talk 大佐 標準 -m {
		 [PC_仲間を呼ばせない方法＿無線破壊:大佐_001]
		//敵は無線機を腰の右後ろにつけている。
		//主観攻撃で狙えば撃ち抜けるはずだ。
	}
}//v
}//d

//敵からのアイテム入手の方法 h //e
//proc rp_PC_敵からのアイテム入手１:07
proc rp_PC_敵からのアイテム入手１:07 {
vox t:vc260951 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_敵からのアイテム入手１:大佐_000]
		//見つからずに敵を倒すと
		//アイテムボックスを出すことがある。
		//忘れずに回収しておくんだ。
	}
}//v
}//d


//ホールドアップ h //e
//proc rp_PC_ホールドアップ１:07
proc rp_PC_ホールドアップ１:07 {
vox t:vc260961 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ホールドアップ１:大佐_000]
		//見つからないように敵へ接近して
		//死角からいきなり銃を突き付ければ、
		//敵をホールドアップさせることが出来る。
	}
	talk 大佐 標準 -m {
		 [PC_ホールドアップ１:大佐_001]
		//両手を上げた敵は完全に無抵抗だ。
		//その後どうするかは君次第だな。
	}
}//v
}//d



//ＡＢ連絡橋 d //e
//狭いから見つかると死ぬ注意 h //e
//proc rp_PC_ＡＢ連絡橋見つかるな注意:07
proc rp_PC_ＡＢ連絡橋見つかるな注意:07  {
vox t:vc260971 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ＡＢ連絡橋見つかるな注意:大佐_000]
		//ライデン、そこでは絶対に見つかるなよ。
		//狭い橋の上では逃げ場がない。
		//蜂の巣にされるぞ。
	}
	talk 大佐 標準 -m {
		 [PC_ＡＢ連絡橋見つかるな注意:大佐_001]
		//敵も手すりの向こう側は警戒していない
		//ようだ。エルードを使えば敵の死角から
		//進むことが出来る。エルードを使え。
	}
}//v
}//d

//難度ＨＡＲＤ以上は危険モード時扉開かない。 h //e
//proc rp_PC_ＡＢ連絡橋扉開かない:07
proc rp_PC_ＡＢ連絡橋扉開かない:07  {
vox t:vc260981 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ＡＢ連絡橋扉開かない:大佐_000]
		//ライデン、その扉は危険モード中ロック
		//されるようだ。危険モードの間は開ける
		//ことが出来ない。敵を振り切るんだ。
	}
}//v
}//d

//鳴り床近く h //e
//proc rp_PC_鳴り床１:07
proc rp_PC_鳴り床１:07 {
vox t:vc260991 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_鳴り床１:大佐_000]
		//ライデン、そこの床は走ると足音が
		//するぞ。物音を立てると敵に気付かれる。
	}
}//v
}//d
//proc rp_PC_鳴り床＿そろそろ歩き:07
proc rp_PC_鳴り床＿そろそろ歩き:07 {
vox d:_vc261001 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_鳴り床＿そろそろ歩き:大佐_000]
		//左スティックを少しだけ倒すように
		//すれば、足音を立てずに歩くことが
		//出来る。
	}
}//v
}//d
//proc rp_PC_鳴り床＿ホフク:07
proc rp_PC_鳴り床＿ホフク:07 {
vox t:vc261011 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_鳴り床＿ホフク:大佐_000]
		//ホフクしても足音を立てないで
		//進むことが出来るだろう。
		//うまく使うんだ。
	}
}//v
}//d


//鳥がいるエルードポイント h //e
//proc rp_PC_鳥エルード:07
proc rp_PC_鳥エルード:07 {
//vox t:vc261021 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_鳥エルード:大佐_000]
		//海鳥がとまっている手すりはエルードで
		//進むことが出来ない。飛び立つまで
		//待つか、鳥を追い払うんだ。
	}
//}//v
}//d

//鳥を殺し過ぎた h //e
//proc rp_PC_鳥殺し過ぎ:07
proc rp_PC_鳥殺し過ぎ:07 {
vox t:vc261031 {
@rp_つっこまれ＿否１＿逆ギレ系デフォルト 100
@rp_つっこまれ＿是１＿なんで知ってるんだ系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_鳥殺し過ぎ:大佐_000]
		//ライデン……小動物を虐待するのが
		//そんなに楽しいか？
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_鳥殺し過ぎ:ローズ_001]
		//信じられない！
		//そんな人だとは思わなかった……。
	}
	@rpd_大佐顔表示
@rp_つっこまれ＿否１＿逆ギレ系デフォルト 100
@rp_つっこまれ＿是１＿なんで知ってるんだ系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_鳥殺し過ぎ:大佐_002]
		//まったく度し難いな……。
		//満足したら任務に戻ってくれ……。
	}
}//v
}//d

//落ちたら死ぬ手すり h //e
//proc rp_PC_奈落エルード:07
proc rp_PC_奈落エルード:07 {
vox t:vc261041 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_奈落エルード:大佐_000]
		//ライデン、そこから落ちれば到底
		//助からない。握力ゲージが無くなる
		//前に這い上がるんだ。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_奈落エルード:ローズ_001]
		//間違っても自分から手を放したり
		//しなでね。
	}
}//v
}//d

//落とし穴 h //e
//proc rp_PC_落とし穴:07
proc rp_PC_落とし穴:07 {
vox t:vc261051 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_落とし穴:大佐_000]
		//ライデン、そこの床に気をつけろ。
		//上に乗っていると落ちてしまうぞ。
		//一気に走り抜けるんだ。
	}
}//v
}//d


//ＡＦ連絡橋(w23a) d //e
//サイファー h //e
//proc rp_PC_サイファー１:07
proc rp_PC_サイファー１:07 {
vox t:vc261061 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_サイファー１:大佐_000]
		//サイファーは無人偵察機の一種だ。
		//侵入者を発見すると警報を鳴らす。
		//見つかれば増援部隊を呼ばれるぞ。
	}
}//v
}//d
//チャフ h //e
//proc rp_PC_サイファー回避＿チャフ:07
proc rp_PC_サイファー回避＿チャフ:07 {
vox t:vc261071 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_サイファー回避＿チャフ:大佐_000]
		//チャフ・グレネードを使って電子装置を
		//妨害すれば、チャフが効いている間、
		//サイファーを無力化出来る。
	}
}//v
}//d
//破壊 h //e
//proc rp_PC_サイファー回避＿破壊１:07
proc rp_PC_サイファー回避＿破壊１:07 {
vox t:vc261081 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_サイファー回避＿破壊１:大佐_000]
		//サイファーはカメラ部分を破壊すれば
		//撃墜することが出来る。
	}
}//v
}//d
//proc rp_PC_サイファー回避＿破壊２:07
proc rp_PC_サイファー回避＿破壊２:07 {
vox t:vc261091 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_サイファー回避＿破壊２:大佐_000]
		//だがサイファーからの連絡が途絶えると
		//敵が確認にやってくるかもしれない。
		//あまり得策ではないだろうな。
	}
}//v
}//d

//エルード回避 h //e
//proc rp_PC_サイファー回避＿エルード１:07
proc rp_PC_サイファー回避＿エルード１:07 {
vox t:vc261101 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_サイファー回避＿エルード１:大佐_000]
		//ライデン、サイファーに発見されると
		//まずい。サイファーの視界に入らない
		//ように隠れるんだ。
	}
	talk ライデン 標準 -m {
		 [PC_サイファー回避＿エルード１:ライデン_001]
		//しかし大佐、ここには隠れられる場所が
		//無い……。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_サイファー回避＿エルード１:ローズ_002]
		//ジャック、弱気にならないで。
	}
}//v
}//d
//二回目以降 t //e
//proc rp_PC_サイファー回避＿エルード２:07
proc rp_PC_サイファー回避＿エルード２:07 {
vox t:vc261111 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_サイファー回避＿エルード２:大佐_000]
		//手すりにぶらさがってサイファーを
		//やりすごすんだ。エルードを使え。
		//握力ゲージに気をつけろ。
	}
}//v
}//d

//ＢＣ連絡橋(w15a) d //e
//壊された橋 h //e
//proc rp_PC_ＢＣ連絡橋壊れた橋:07
proc rp_PC_ＢＣ連絡橋壊れた橋:07 {
vox t:vc261121 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ＢＣ連絡橋壊れた橋:大佐_000]
		//ライデン、そこから東に見えるのが
		//シェル１の中央棟だ。だが連絡橋は
		//完全に破壊されている。
	}
	talk 大佐 標準 -m {
		 [PC_ＢＣ連絡橋壊れた橋:大佐_001]
		//そちらから中央棟に渡るのは無理だ。
		//中央棟へは反対側のＥＦ連絡橋から
		//行くしかないだろうな……。
	}
}//v
}//d


//Ｃ脚(w16a) d //e


//ダンボール置き場近く h //e
//proc rp_PC_Ｃ脚食堂ダンボール近く１:07
proc rp_PC_Ｃ脚食堂ダンボール近く１:07 {
vox t:vc261131 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_Ｃ脚食堂ダンボール近く１:大佐_000]
		//ライデン、見てみろ。
		//ダンボール箱が積んである。
	}
}//v
}//d
//proc rp_PC_Ｃ脚食堂ダンボール近く＿ヒント１:07
proc rp_PC_Ｃ脚食堂ダンボール近く＿ヒント１:07 {
vox t:vc261141 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_Ｃ脚食堂ダンボール近く＿ヒント１:大佐_000]
		//大佐まわりにうまくとけ込めば
		//敵の目を誤魔化せるんじゃないか？
	}
}//v
}//d
//proc rp_PC_Ｃ脚食堂ダンボール近く＿ヒント２:07
proc rp_PC_Ｃ脚食堂ダンボール近く＿ヒント２:07 {
vox t:vc261151 {
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_Ｃ脚食堂ダンボール近く＿ヒント２:ローズ_000]
