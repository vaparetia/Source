proc rp_PC_監視カメラ１:07 {
vox t:vc261461 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_監視カメラ１:大佐_000]
		//ライデン、監視カメラがあるぞ。
		//発見されないように気をつけろ。
	}
}//v
}//d
//proc rp_PC_監視カメラ＿避け方＿真下:07
proc rp_PC_監視カメラ＿避け方＿真下:07 {
vox t:vc261471 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_監視カメラ＿避け方＿真下:大佐_000]
		//監視カメラの視界に入らないように
		//するんだ。カメラの真下は死角のはず。
		//壁に張り付いて進めば大丈夫だろう。
	}
}//v
}//d
//proc rp_PC_監視カメラ＿避け方＿首振り:07
proc rp_PC_監視カメラ＿避け方＿首振り:07 {
vox t:vc261481 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_監視カメラ＿避け方＿首振り:大佐_000]
		//監視カメラが別の方向を向いている
		//うちに走り抜けるのも良い。
		//うまく隙を突くんだ。
	}
}//v
}//d
//proc rp_PC_監視カメラ＿避け方＿チャフ:07
proc rp_PC_監視カメラ＿避け方＿チャフ:07 {
vox t:vc261491 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_監視カメラ＿避け方＿チャフ:大佐_000]
		//チャフを使えば、一定時間、電波妨害が
		//可能だ。監視カメラもしばらくの間、
		//機能を停止するだろう。
	}
}//v
}//d
//proc rp_PC_監視カメラ＿避け方＿破壊:07
proc rp_PC_監視カメラ＿避け方＿破壊:07 {
vox t:vc261501 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_監視カメラ＿避け方＿破壊:大佐_000]
		//監視カメラは銃で撃って破壊することが
		//可能だ。
	}
	talk 大佐 標準 -m {
		 [PC_監視カメラ＿避け方＿破壊:大佐_001]
		//だがカメラからの映像が途絶えれば、
		//いずれ敵が確認にやってくると思われる。
		//すぐにその場を離れた方がいいだろうな。
	}
}//v
}//d


