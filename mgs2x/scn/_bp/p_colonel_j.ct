vox t:vc264041 {
@rp_うなづきデフォルト＿是
@rp_無茶指令＿否１＿お前がやれ系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_ヴァンプ戦＿水中弾当たらん:大佐_000]
		//ライデン、水中では弾道が曲がる。奴が
		//水中にいる間はハンドガンや自動小銃は効果がないぞ。グレネードを使うんだ。
	}
}//v
}//d

//プール落ちたら死ぬ h //e
//proc rp_PC_ヴァンプ戦＿プール一発氏に:07
proc rp_PC_ヴァンプ戦＿プール一発氏に:07 {
vox t:vc264051 {
@rp_うなづきデフォルト＿是
@rp_無茶指令＿否１＿お前がやれ系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_ヴァンプ戦＿プール一発氏に:大佐_000]
		//ヴァンプが言っていた通り、
		//その生物反応槽に落ちたら命はないぞ。
		//自分から落ちるような真似はするな。
	}
}//v
}//d

