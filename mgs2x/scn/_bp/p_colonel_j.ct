//ゴーストバベルの台詞をしゃべる１ h //e
//proc rp_PC_発狂＿ばべる１:07
proc rp_PC_発狂＿ばべる１:07 {
vox t:vc266581 {
@rp_うなづきデフォルト＿是
@rp_キテレツさん＿否２＿意味不明系デフォルト 50
	talk 大佐 標準 -m {
		 [PC_発狂＿ばべる１:大佐_000]
		//君の任務は武装要塞ガルエードに潜入し、捕虜を救出して、メタルギアの組み立てが終わる前に破壊することだ。
	}
}//v
}//d

//ゴーストバベルの台詞をしゃべる２ h //e
//proc rp_PC_発狂＿ばべる２:07
proc rp_PC_発狂＿ばべる２:07 {
vox t:vc266591 {
@rp_うなづきデフォルト＿是
@rp_キテレツさん＿否２＿意味不明系デフォルト 50
	talk 大佐 標準 -m {
		 [PC_発狂＿ばべる２:大佐_000]
		//ベルトコンベアの分岐点があるようだ。
		//何かの仕組みで機械が勝手に荷物を
		//仕分けしているんだろう。
	}
@rp_大佐発狂中顔表示
	talk 大佐 標準 -m {
		 [PC_発狂＿ばべる２:大佐_001]
		//機械をよく見てみるんだ。
	}
}//v
}//d

//ゴーストバベルの台詞をしゃべる３ h //e
//proc rp_PC_発狂＿ばべる３:07
proc rp_PC_発狂＿ばべる３:07 {
vox t:vc266601 {
@rp_うなづきデフォルト＿是
@rp_キテレツさん＿否２＿意味不明系デフォルト 50
