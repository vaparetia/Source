vox t:vc261301 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ＥＦ連絡橋＿赤外線センサー＿制御装置破壊:大佐_000]
		//センサーの制御装置を破壊するんだ。
		//爆弾の近くに緑色に点滅するランプの
		//ついた装置がある。それが制御装置だ。
	}
	talk 大佐 標準 -m {
		 [PC_ＥＦ連絡橋＿赤外線センサー＿制御装置破壊:大佐_001]
		//制御装置を破壊すれば赤外線センサーは
		//機能を停止する。制御装置を銃で
		//撃ち抜くんだ。
	}
}//v
}//d
