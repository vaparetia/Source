		//ＭＥＴＡＬ　ＧＥＡＲ　ヲ
		//ハカイ　セヨ！
	}
}//v
}//d

//proc rp_PC_発狂＿ＭＳＸ２:07
proc rp_PC_発狂＿ＭＳＸ２:07 {
vox t:vc266531 {
@rp_うなづきデフォルト＿是
@rp_キテレツさん＿否２＿意味不明系デフォルト 50
	talk 大佐 標準 -m {
