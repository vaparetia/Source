//拷問部屋にいる場合 t //e
//proc rp_PC_拘束解除後＿合流しろ＿拷問部屋:07
proc rp_PC_拘束解除後＿合流しろ＿拷問部屋:07 {
vox t:vc264551 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_拘束解除後＿合流しろ＿拷問部屋:大佐_000]
		//その先であの男が待っていると
		//オルガが言っていただろう？
		//その部屋から出て北に進むんだ。
	}
}//v
}//d
//拷問部屋外にいる場合 t //e
//proc rp_PC_拘束解除後＿合流しろ＿拷問部屋外:07
proc rp_PC_拘束解除後＿合流しろ＿拷問部屋外:07 {
vox t:vc264561 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_拘束解除後＿合流しろ＿拷問部屋外:大佐_000]
		//ライデン、あの男と合流するんだ。
		//北東の扉をくぐって北に進め。
	}
}//v
}//d

//天狗通路Ａ t //e
//proc rp_PC_拘束解除後＿合流しろ＿拷問部屋以外:07
proc rp_PC_拘束解除後＿合流しろ＿拷問部屋以外:07 {
