proc rp_PC_シェル１中央棟＿変装してない:07 {
vox t:vc261611 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_シェル１中央棟＿変装してない:大佐_000]
		//ライデン、その狭い通路では身を隠す
		//場所がまるでない。監視カメラも多数
		//設置されている。
	}
	talk 大佐 標準 -m {
		 [PC_シェル１中央棟＿変装してない:大佐_001]
		//普通の方法で見つからずに進むことは
		//不可能だろう。敵兵士に変装するんだ。
		//ＡＫを装備するのも忘れるな。
	}
}//v
}//d

//エレベータパネル前 h //e
//proc rp_PC_シェル１中央棟１Ｆ＿エレベータ説明:07
proc rp_PC_シェル１中央棟１Ｆ＿エレベータ説明:07 {
vox t:vc261621 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_シェル１中央棟１Ｆ＿エレベータ説明:大佐_000]
		//エレベータがあるな。エレベータに
		//乗ればフロアからフロアへ移動が出来る。
	}
	talk 大佐 標準 -m {
		 [PC_シェル１中央棟１Ｆ＿エレベータ説明:大佐_001]
		//エレベータを呼ぶには、近くにある
		//パネルの前で△ボタンを押せばいい。
	}
	talk 大佐 標準 -m {
		 [PC_シェル１中央棟１Ｆ＿エレベータ説明:大佐_002]
		//しばらく待てばエレベータが来るはずだ。
	}
}//v
}//d
//危険モード中はだめ h //e
//proc rp_PC_シェル１中央棟１Ｆ＿エレベータ＿危険:07
proc rp_PC_シェル１中央棟１Ｆ＿エレベータ＿危険:07 {
vox t:vc261631 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_シェル１中央棟１Ｆ＿エレベータ＿危険:大佐_000]
		//敵は危険モード中、エレベータの運行を
		//停止するはずだ。侵入者、つまり君を
		//逃がさないためにな。
	}
	talk 大佐 標準 -m {
		 [PC_シェル１中央棟１Ｆ＿エレベータ＿危険:大佐_001]
		//つまりエレベータに乗るには、まず敵を
		//振り切らなければならないということだ。
		//注意してくれ。
	}
}//v
}//d
//変装エレベータ説明 h //e
//proc rp_PC_シェル１中央棟１Ｆ＿エレベータ説明１:07
proc rp_PC_シェル１中央棟１Ｆ＿エレベータ説明１:07 {
vox t:vc261641 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_シェル１中央棟１Ｆ＿エレベータ説明１:大佐_000]
		//そこのエレベータは特別だ。パネルの
		//上に変わった形の監視カメラがついて
		//いるだろう。
	}
	talk ライデン 標準 -m {
		 [PC_シェル１中央棟１Ｆ＿エレベータ説明１:ライデン_001]
		//ああ。視界に入っても反応しない
		//ようだが、これは……？
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_シェル１中央棟１Ｆ＿エレベータ説明１:ローズ_002]
		//そのカメラはパネルが押されると起動
		//してエレベータに乗ろうとしてる人間を
		//チェックする仕掛けになってるみたい。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_シェル１中央棟１Ｆ＿エレベータ説明１:大佐_003]
		//つまり敵兵士に変装していないと
		//エレベータを呼んだ瞬間に発見されると
		//いうことだ。
	}
}//v
}//d
//変装エレベータ 二回目以降 h //e
//proc rp_PC_シェル１中央棟１Ｆ＿エレベータ説明２:07
proc rp_PC_シェル１中央棟１Ｆ＿エレベータ説明２:07 {
vox t:vc261651 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_シェル１中央棟１Ｆ＿エレベータ説明２:大佐_000]
		//そこのエレベータはパネルが押されると
		//監視カメラによるチェックが行われる
		//仕組みになっている。
	}
	talk 大佐 標準 -m {
		 [PC_シェル１中央棟１Ｆ＿エレベータ説明２:大佐_001]
		//エレベータを呼ぶ時は敵兵士に
		//変装してからパネルを押すように
		//するんだ。
	}
	talk 大佐 標準 -m {
		 [PC_シェル１中央棟１Ｆ＿エレベータ説明２:大佐_002]
		//パネルを押すにはパネルの前で
		//△ボタンを押せばいい。
	}
}//v
}//d

//チャフを使っている時 h //e
//proc rp_PC_シェル１中央棟１Ｆ＿エレベータ＿チャフ状態:07
proc rp_PC_シェル１中央棟１Ｆ＿エレベータ＿チャフ状態:07 {
vox t:vc261661 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_シェル１中央棟１Ｆ＿エレベータ＿チャフ状態:大佐_000]
		//ライデン、エレベータを使う気なら
		//そのフロアでチャフは使うな。
	}
	talk 大佐 標準 -m {
		 [PC_シェル１中央棟１Ｆ＿エレベータ＿チャフ状態:大佐_001]
		//そのフロアのエレベータは脇の
		//監視カメラで乗り込もうとする人間を
		//チェックする仕組みになっている。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_シェル１中央棟１Ｆ＿エレベータ＿チャフ状態:ローズ_002]
		//チャフで監視カメラを電子妨害したら
		//チェック自体が行われなくなって
		//エレベータも動かなくなってしまうわ。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_シェル１中央棟１Ｆ＿エレベータ＿チャフ状態:大佐_003]
		//そのエレベータに乗るには敵兵士に
		//変装してパネルを押すしかない。
		//敵の野戦服を装備しろ。
	}
}//v
}//d


//エレベータ内 h //e
//proc rp_PC_シェル１中央棟１Ｆ＿エレベータ内＿使い方:07
proc rp_PC_シェル１中央棟１Ｆ＿エレベータ内＿使い方:07 {
vox d:_vc261671 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_シェル１中央棟１Ｆ＿エレベータ内＿使い方:大佐_000]
		//エレベータを操作するには、
		//入って左側の扉の脇にあるパネルの
		//前で△ボタンを押せばいい。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_シェル１中央棟１Ｆ＿エレベータ内＿使い方:ローズ_001]
		//出てきたパネルの中から行きたい
		//フロアを選んで○ボタンを押せば
		//エレベータが動き出すみたいよ。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_シェル１中央棟１Ｆ＿エレベータ内＿使い方:大佐_002]
		//この間、右スティックを使ってまわりを
		//見渡すことも出来る。敵が近づいて
		//こないか気を配っておけ。
	}
}//v
}//d


//シェル１中央棟Ｂ１ d //e
