//ＭＧＳのメイリンの格言１ h //e
//proc rp_PC_発狂＿格言１:07
proc rp_PC_発狂＿格言１:07 {
//vox t:vc266641
movie t:vc266641 {
@rp_うなづきデフォルト＿是
@rp_キテレツさん＿否２＿意味不明系デフォルト 50
	talk 大佐 標準 -m {
		 [PC_発狂＿格言１:大佐_000]
		//中国にはね、『匹夫の勇、一人に敵する
		//ものなり』っていう諺があるの。
	}
@rp_大佐発狂中顔表示
	talk 大佐 標準 -m {
		 [PC_発狂＿格言１:大佐_001]
		//無闇に戦いを求める愚か者の勇気は、
		//一人の敵を相手にするのが
		//精いっぱいって意味よ。
	}
@rp_大佐発狂中顔表示
	talk 大佐 標準 -m {
		 [PC_発狂＿格言１:大佐_002]
		//スネークはたった一人で敵の中に
		//潜入してるんだから、やたらと戦闘を
		//仕掛けたりしないで、慎重に行動してね。
	}
}//v
}//d

