//proc rp_PC_網膜センサー＿説明２:07
proc rp_PC_網膜センサー＿説明２:07 {
vox t:vc261691 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_網膜センサー＿説明２:大佐_000]
		//そこの扉を開けるには、敵兵士を
		//連れて来てセンサーを覗き込ませる
