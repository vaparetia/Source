	talk 大佐 標準 -m {
		 [PC_シェル１中央棟Ｂ２＿ＡＧ扉１:大佐_001]
		//わからん。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_シェル１中央棟Ｂ２＿ＡＧ扉１:ローズ_002]
		//大きな扉ね……何かしら？
		//データにはないけれど……。
	}
@rp_うなづきデフォルト
}//v
}//d
//二回目以降 t //e
//proc rp_PC_シェル１中央棟Ｂ２＿ＡＧ扉２:07
proc rp_PC_シェル１中央棟Ｂ２＿ＡＧ扉２:07 {
vox t:vc261791 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_シェル１中央棟Ｂ２＿ＡＧ扉２:大佐_000]
		//ライデン、その扉を開ける方法はない。
		//構わずに任務を続行するんだ。いいな
	}
}//v
}//d


//エマ席 オタクグッズでいっぱい h //e
//proc rp_PC_シェル１中央棟Ｂ２＿エマ席:07
