// ------------------------------------
// 敵兵ルート番号
// ------------------------------------
enum E_R {
	敵増援出現ポイント		= 0, // ゴールのところ。
	雷電道１西の南北通路	= 1,
	雷電道２中央通路		= 2,
	雷電道３ゴール前		= 3,
	雷電道４増援			= 4, // 増援
	雷電道５東高台			= 5,
	蛇道１穴障害物北		= 11,
	蛇道２階段前障害物北	= 12,
	蛇道３東高台下南北通路	= 13,
	蛇道４東高台南北通路	= 14,
	蛇道５ゴール階段脇増援	= 15, // 増援
	昔蛇１,
	昔蛇２,
	昔蛇３,
	昔蛇４,
	昔蛇５,
};
// ＶＲウィンドウ スニーキング
#define WINDOW_SNEAKING_VS08A		[VRMSG_J:VRM_SNK_SNK_vs08a] [VRMSG_E:VRM_SNK_SNK_vs08a] [VRMSG_G:VRM_SNK_SNK_vs08a] \	// 日、英、独
									[VRMSG_F:VRM_SNK_SNK_vs08a] [VRMSG_I:VRM_SNK_SNK_vs08a] [VRMSG_S:VRM_SNK_SNK_vs08a] \	// 仏、伊、西
									[VRMSG_K:VRM_SNK_SNK_vs08a] \															// 韓
									p:ＶＲステージ開始時処理								// 終了プロック
// ＶＲウィンドウ 全殺し
#define WINDOW_ELIM_ALL_VS08A		[VRMSG_J:VRM_SNK_ELM_vs08a] [VRMSG_E:VRM_SNK_ELM_vs08a] [VRMSG_G:VRM_SNK_ELM_vs08a] \	// 日、英、独
									[VRMSG_F:VRM_SNK_ELM_vs08a] [VRMSG_I:VRM_SNK_ELM_vs08a] [VRMSG_S:VRM_SNK_ELM_vs08a] \	// 仏、伊、西
									[VRMSG_K:VRM_SNK_ELM_vs08a] \															// 韓
									p:ＶＲステージ開始時処理								// 終了プロック

#define	WATCHER_STATUS		d:ENE_STATUS_NORMAL スニーキング８面
#define ATTACKER_STATUS		d:E_R:敵増援出現ポイント d:ENE_STATUS_NORMAL d:ENE_EQUIP_TYPE_NORMAL

// アイテム位置
#define スタート地点北柱左	0 0 -4000
#define ステージ右下		15000 0 0
#define 最初右Ｔ字路		6000 0 0
#define ゴール階段前箱右	8500 0 -22000
#define 最初北箱上			0 2000 -6000
#define ステージ右下		15000 0 0
#define 中央通路中央		7500 0 -6500
#define 右高台北見張		11000 3000 -22000
#define 右高台左下			10000 3000 -4000
#define 右高台中央箱左		13000 3000 -14500
#define ステージ中央穴北	9500 0 -20000
// ------------------------------------
// 弾数設定
// ------------------------------------
#define ライデソ弾数 12
#define スネーク弾数 10
#define ぷりすき弾数 3
#define たきへび弾数 4
