		0,				/* 無限カツラ */
		0,				/* カツラＡ */
		0,				/* カツラＢ */
		0, 				/* カツラＣ */
		0,				/* カツラＤ	*/
	}

	preseek 'w00b'
	if ( $s:ボスラッシュプレイヤー == スネーク ) {
		chara ボスラッシュ２テロップ表示 テロップ君 -m 0 -b $b:ボスラッシュステージ -n 次のステージをロード -p 0
	} else {
		chara ボスラッシュ２テロップ表示 テロップ君 -m 0 -b $b:ボスラッシュステージ -n 次のステージをロード -p 1
	}
}
