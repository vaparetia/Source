// ------------------------------------
// 各gclで必要なdefine
// ------------------------------------
// モード
#define		STAGE_VR		1		// 共通プロック切り分け用
#define		STAGE_START		1	//	ゲーム開始直後処理を有効にするため
// ステージ名
#define		STAGE_SP01A		1		// 共通プロック切り分け用
// オブジェクト
#define		SD_LOCKER_FLR	4		// ロッカー扉SE番号(倒れバージョン)
#define		SD_LOCKER_HZD	4		// ロッカー扉SE番号(扉バージョン)

// ------------------------------------
// 各種スイッチ用define
// ------------------------------------
// デバッグ関係
#ifdef	d:FIX_MODE
	#define		DEBUG_CHARA		0		// デバッグキャラ全体(FIX時は0)
#else
	#define		DEBUG_CHARA		0		// デバッグキャラ全体
#endif
#define		CHARA_CAMERA	0		// キャラ追従カメラ
#define		TARGET_CHARA	敵兵:01	// キャラ追従カメラのターゲット
#define		SCREENSHOT		0		// スクリーンショット
#define		USB_KEY			0		// USBキーボード


// ------------------------------------
// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME			sp01a
#define		KMS_NAME			sp01a
#define		TONBO_KMS_NAME		sp01a_tonbo
#define		LINE_KMS_NAME		sp01a_line

// キャラクター関係
#define		PLAYER		ライデン


// ------------------------------------
// ゴールの位置
// ------------------------------------
#define	GOAL_POS_SP01A		21000 0 -47000

// ------------------------------------
// ＶＲウィンドウのリソース等
// ------------------------------------
#define	SP01A_1_WINDOW_RES	 [VRMSG_J:VRM_VRT_sp01a_1] [VRMSG_E:VRM_VRT_sp01a_1] [VRMSG_G:VRM_VRT_sp01a_1] \	// 日、英、独
							 [VRMSG_F:VRM_VRT_sp01a_1] [VRMSG_I:VRM_VRT_sp01a_1] [VRMSG_S:VRM_VRT_sp01a_1] \	// 仏、伊、西
							 [VRMSG_K:VRM_VRT_sp01a_1] \															// 韓
							 p:ＶＲステージ開始時処理		// 終了プロック

#define	SP01A_2_WINDOW_RES	 [VRMSG_J:VRM_VRT_sp01a_2] [VRMSG_E:VRM_VRT_sp01a_2] [VRMSG_G:VRM_VRT_sp01a_2] \	// 日、英、独
							 [VRMSG_F:VRM_VRT_sp01a_2] [VRMSG_I:VRM_VRT_sp01a_2] [VRMSG_S:VRM_VRT_sp01a_2] \	// 仏、伊、西
							 [VRMSG_K:VRM_VRT_sp01a_2] \															// 韓
							 p:ＶＲステージ開始時処理		// 終了プロック


// ------------------------------------
// アイテムのポジション
// ------------------------------------
#define	ITEM_POS_01		 2000	 5000	 -36000		// 橋の中継地点
#define	ITEM_POS_02		 6500	 7000	 -32500		// ローリングしていく１つ目の島、階段上がったところ
#define	ITEM_POS_03		 13000	 7000	 -34500		// ローリングしていく２つ目の島の中央
#define	ITEM_POS_04		 17000	 5000	 -43000		// 橋を渡りきったところ
#define	ITEM_POS_05		 18000	 5000	 -39000		// エルード柵の前
#define	ITEM_POS_06		 21000	 0		 -39000		// エルード降りた島の南
#define	ITEM_POS_07		 22500	 0		 -38500		// エルード降りた島の南東


// ------------------------------------
// include
// ------------------------------------
#include "rai_sp01a.mh"		// 強制モーションリスト
#include "stdch.h"
#include "a_stdproc.h"			// アナザーミッション設定ファイル
#include "sload.h"
#include "sound.h"
#include "jump.h"
#include "fall.h"
#include "beyond.h"
#include "beyond3.h"
#include "item_info.h"
#include "vr_common.h"		// ＶＲステージ共通で使用するプロック

#if d:USB_KEY
	#include "usbkbd.h"
#endif

// ------------------------------------
// マップ設定
// ------------------------------------
chara マップ アスレチック -k d:KMS_NAME -h d:HZX_NAME,0 -l $s:ＶＲライトファイル名

command マップ設定 アスレチック -set {
	// ローカルの初期化
	// ------------------------------------
	@ローカル変数初期化		// ローカルで使用する変数で初期化をする場合はここで
	// 設定値を変更する場合は以下のプロック内で設定
	// ------------------------------------
	@設定値変更				// 敵兵や的のパラメータをステージ限定で変える時はここで

	// ＶＲで必要な基本プロックのセット(vr_common.hで定義)
	// サウンドの基本パック、ＶＲの基本システム、プレイヤー、ゴール等を設定します
	// ※このプロックを使用する時は「ＶＲクリア時処理」というプロックが必要です
	// ＶＲ共通プロックセット	$:スネークファイル $:雷電ファイル $:クリア条件フラグ
	//							$:ゴールＸ $:ゴールＹ $:ゴールＺ $:タイマー初期値
	//	VR_GOAL_TARGET	/*的全滅でゴールが開く*/
	//	VR_GOAL_FREE	/*ゴールが最初から開いてる*/
	//	VR_GOAL_ENEMY	/*敵全滅でゴールが開く*/
	//	VR_GOAL_SNEAK	/*潜入モード中はゴールが開く*/
	//	VR_GOAL_TIME	/*タイマーがゼロになるとゴールが開く*/
	// ------------------------------------
	if ( $b:ステージ番号 == 1 ) {
		// 一面は機雷バージョン
		@ＶＲ共通プロックセット sna_sp01a rai_sp01a d:VR_GOAL_FREE d:GOAL_POS_SP01A
	} else {
		// 二面は的破壊バージョン
		@ＶＲ共通プロックセット sna_sp01a rai_sp01a d:VR_GOAL_TARGET d:GOAL_POS_SP01A
	}

	// ＶＲウィンドウの設定
	// ------------------------------------
	@アスレチックＶＲウィンドウ設定

	// クリア時に呼ばれるものの設定
	// ------------------------------------
	if ( $b:ステージ番号 == 1 ) {
		@ＶＲクリア設定 p:load_sp01a_02 p:A_ＲＥＴＲＹプロック
	} else {
		@ＶＲクリア設定 p:load_sp02a p:A_ＲＥＴＲＹプロック
	}

	// ステージに引かれるライン
	// ------------------------------------
	@ＶＲアウトライン d:KMS_NAME d:TONBO_KMS_NAME d:LINE_KMS_NAME

	// プレイヤーの設定
	// ------------------------------------
	@プラグイン設定			// プレイヤーのプラグインがいる時はここで
	@ジャンプ設定
	@橋上トラップチェック
	@エルード設定

	// 敵兵・的関係の設定
	// ------------------------------------
	if ( $b:ステージ番号 == 1 ) {
		// 一面は機雷バージョン
		@ＶＲ機雷設定
	} else {
		// 二面は的破壊バージョン
		@ＶＲ的設定
		@アスレチックステージＶＲ的設定
	}

	// ＢＧＭの設定(プレイヤー→敵兵→BGMの順で呼ぶ)
	// ------------------------------------
	@ＢＧＭ設定

	// アイテムの設定
	// ------------------------------------
	if ( $b:ステージ番号 == 2 ) {
		// 的破壊の時は武器を拾っていく
		@アイテム設定
	}

	// 光源、オブジェクト、カメラ関連の設定
	// ------------------------------------
	@落下死処理設定
	@落とし穴設置
	@ＶＲフォグ設定 -7000 70000 -5000 55000 -5000 55000
	@カメラセット					// chara カメラとベースのカメラを設定
	@アスレチックカメラ設定		// ステージ固有のカメラ設定がいる時はこのプロックで
	@ＶＲキャラ用ライト設置				// 必ず最後に設定
#if d:DEBUG_CHARA
	@デバッグキャラセット
#endif
}

//初期マップの表示
command マップ表示 -show アスレチック



// 各proc設定
//-------------------------------------------------------------------------------------
// 全マップ共通
	//------------------------------------------------------------
	// ＶＲウィンドウの設定と表示
	//------------------------------------------------------------
	proc アスレチックＶＲウィンドウ設定 {
		#if d:DEBUG_PRINT
			print 'vr_window_set'
		#endif

		if ( $b:ステージ番号 == 1 ) {
			@ＶＲウィンドウ設定	d:SP01A_1_WINDOW_RES
		} else {
			@ＶＲウィンドウ設定	d:SP01A_2_WINDOW_RES
		}


		// ＶＲウィンドウを表示する
		mesg ＶＲウィンドウ ＶＲウィンドウ君 開く

		// スタート時とクリア時に使用するカットインカメラ
		chara カメラ カットインカメラ		-c 0 -l 0 -p  0

		// スタート時のカメラ(必要な場合)
		chara カメラ設定 カットインカメラ \
			-c 1 \	
			-p 21000,7186,-44776 -t 21000,-15,-46948 \
			-r 833,2048,0 -f 7521 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1
	}

	//------------------------------------------------------------
	// ステージ開始時処理
	//------------------------------------------------------------
	proc ＶＲステージ開始時処理 {
		#if d:DEBUG_PRINT
			print 'game_start!!!!!'
		#endif

		// プレイヤーやパッドの制御等を行う a_stdproc.hで定義
		@全ミッション共通ステージ開始時処理

		// カメラワークスタート(必要な場合)
		// 全体図
		chara カメラ設定 カットインカメラ \
			-c 1 \	
			-p 2759,49129,9563 -t 2759,41369,5024 \
			-r 679,2048,0 -f 8990 \
			-a 200 \
			-i 4 4 d:START_CAMERA_CHANGE_TIME d:START_CAMERA_CHANGE_TIME \
			-s 1

		chara delay ディレイ \
			-time d:START_CAMERA_CHANGE_TIME \
			-exec {
				chara カメラ設定 カットインカメラ -s -1
			}
	}

	proc ゲーム開始直後処理 {
		if ( $b:ステージ番号 == 2 ) {
			mesg ＶＲ的共通 三角的 移動開始
			mesg ＶＲ的共通 壁 移動開始
		}
	}

	// ------------------------------------
	// クリア時の処理
	// ------------------------------------
	proc ＶＲクリア時処理 {
		#if d:DEBUG_PRINT 
			print 'clear'
		#endif

		// 強制モーションを発動
		@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_1 2048

		// クリア時にカメラアングルを変える
		if ( $b:ステージ番号 == 1 ) {
			chara カメラ設定 クリア時カメラ \
				-c 1 \	
				-p 24382,463,-50007 -t 20659,1109,-46132 \
				-r -78,3597,0 -f 5412 \
				-a 200 \
				-i 1 0 0 0 \
				-s 1
		} else {
			chara カメラ設定 クリア時カメラ \
				-c 1 \	
				-p 22625,716,-51053 -t 20965,906,-45923 \
				-r -23,3892,0 -f 5395 \
				-a 200 \
				-i 1 0 0 0 \
				-s 1
		}
	}



	// ------------------------------------
	// パラメータ系の変更
	// ------------------------------------
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT 
			print 'localvar_init'
		#endif

		// このステージで使用するローカル変数
		$$s:橋上トラップ名 = ev000;
	}



	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT 
			print 'status_set'
		#endif

		// 初期装備の設定
		if ( $b:ステージ番号 == 2 ) {
			if ( $s:選択プレイヤー == ライデン ) {
				// ライデンの初期装備
				eval ( $w:武器弾数Ｒ[ d:武器:ソコム ] = 25 )
				eval ( $w:武器= d:武器:ソコム );
			} else if ( $s:選択プレイヤー == スネーク ) {
				// スネークの初期装備
				eval ( $w:武器弾数Ｒ[ d:武器:ＵＳＰ ] = 16 )
				eval ( $w:武器= d:武器:ＵＳＰ );
			}
		}

		command 配列セット $w:スネークグリップ最大[0] {
			1000, 3600, 5400, 0
		}

		command 配列セット $w:ライデングリップ最大[0] {
			1300, 3600, 5400, 0
		}
	}



	// ------------------------------------
	// プレイヤーに関する設定
	//-------------------------------------
	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif

		command プラグイン自動ジャンプ
		command プラグイン落下
	}
	//-------------------------------------
	// 台登り
	// ------------------------------------
	proc ジャンプ設定 {
		#if d:DEBUG_PRINT
			print 'jump_set'
		#endif

		trap ky001 d:PLAYER \
			-mask 入る \
			-exec {
				@ジャンプ発動 ky001 1000 10
			}
	}

	//-------------------------------------
	// エルードする方向を確定するために橋のどこにいるか位置を調査する
	// ------------------------------------
	proc 橋上トラップチェック {
		#if d:DEBUG_PRINT
			print 'beyond_set'
		#endif

		command foreach -argc 1 -repeat 16 \
			-data { \
					{ ev001 } \
					{ ev002 } \
					{ ev003 } \
					{ ev004 } \
					{ ev005 } \
					{ ev006 } \
					{ ev007 } \
					{ ev008 } \
					{ ev009 } \
					{ ev010 } \
					{ ev011 } \
					{ ev012 } \
					{ ev013 } \
					{ ev014 } \
					{ ev015 } \
					{ ev016 } \
				} \
				-exec { \
					trap $1 d:PLAYER \
						-mask 入る \
						-exec {
							$$s:橋上トラップ名 = $1;
							print '$$s:橋上トラップ名'$$s:橋上トラップ名
						}
				}
		
	}


	//-------------------------------------
	// エルード
	// ------------------------------------
	// エルードで使用する共通プロック
	// タイプ 0:南北方向に向かってエルード 1:東西方向に向かってエルード
#define エルードカメラセット１	trap TRAPNAME d:PLAYER \
									-mask いる \
									-state 6 \
									-dir DIR_1 256 \
									-camera \
									-exec { \
										@エルード時共通カメラ１ DIR_1 \
									}

#define エルードカメラセット２	trap TRAPNAME d:PLAYER \
									-mask ？ \
									-state 5 \
									-dir DIR_1 256 \
									-camera \
									-exec { \
										@エルード時共通カメラ２ DIR_1 $3 \
									}


	
	
	proc エルード移動範囲設定 $:p_タイプ $:p_柵座標 $:p_トラップ端１ $:p_トラップ端２ {
		if ( $:p_タイプ == 0 ) {
			command エルード移動範囲設定 \
				-x_range ($:p_トラップ端１+250) ($:p_トラップ端２-250) -z_range ($:p_柵座標-500) ($:p_柵座標+500)
		} else {
			command エルード移動範囲設定 \
				-x_range ($:p_柵座標-500) ($:p_柵座標+500) -z_range ($:p_トラップ端１+250) ($:p_トラップ端２-250)
		}
	}

	proc エルード時共通カメラ１ $:p_方向 {
		switch ( $:p_方向 ) {
			case ( 0 ) {
				// 南からきたときのカメラ
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,10000,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 575,2139,0 -f 5004 \
					-a 200 \
					-i 0 -1 0 0 \
					-s 1
			}
			case ( 1024 ) {
				// 東からきたときのカメラ
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,10000,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 728,1843,0 -f 5138 \
					-a 200 \
					-i 0 -1 0 0 \
					-s 1
			}
			case ( 2048 ) {
				// 北からきたときのカメラ
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,10000,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 546,2191,0 -f 5067 \
					-a 200 \
					-i 0 -1 0 0 \
					-s 1
			}
			case ( 3072 ) {
				// 西からきたときのカメラ
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,10000,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 537,2284,0 -f 5053 \
					-a 200 \
					-i 0 -1 0 0 \
					-s 1
			}
		}
	}

	// エルードした後のカメラ方向の数値が逆になる
	proc エルード時共通カメラ２ $:p_方向 $:p_入る出るフラグ {
		switch ( $:p_方向 ) {
			case ( 0 ) {
				// 北からきたときのカメラ
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,10000,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 931,1927,0 -f 7000 \
					-a 250 \
					-i 3 2 0 0 \
					-s $:p_入る出るフラグ \
					-z d:CAMERA_NO_CUSHION
			}
			case ( 1024 ) {
				// 西からきたときのカメラ
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,10000,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 700,1874,0 -f 7500 \
					-a 275 \
					-i 3 2 0 0 \
					-s $:p_入る出るフラグ \
					-z d:CAMERA_NO_CUSHION
			}
			case ( 2048 ) {
				// 南からきたときのカメラ
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,10000,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 713,1956,0 -f 7000 \
					-a 250 \
					-i 3 2 0 0 \
					-s $:p_入る出るフラグ \
					-z d:CAMERA_NO_CUSHION
			}
			case ( 3072 ) {
				// 東からきたときのカメラ
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,10000,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 685,2198,0 -f 7500 \
					-a 275 \
					-i 3 2 0 0 \
					-s $:p_入る出るフラグ \
					-z d:CAMERA_NO_CUSHION
			}
		}
	}


	proc エルード設定 {
		#if d:DEBUG_PRINT
			print 'beyond_set'
		#endif

		// 最初の山部分のエルード
		//---------------------------------
		// 三段目
		trap by001 d:PLAYER \
			-mask 入る \
			-exec {
				command プレイヤー状態取得 ;
				if( ($status == 0) || ($status & d:PFLAG_WALK) || \
					($status & d:PFLAG_DAMAGED) || ($status & d:PFLAG_SUBJECT) ) {
					@東向き柵なしビヨンド発動 by001 3000 $6 -29000 -27000 3000 (d:BY_NOFOOTSHADOW | d:BY_NO_STAMP)
					@エルード移動範囲設定 1 3000 -29000 -27000
				}
			}
		d:エルードカメラセット１("/TRAPNAME/by001/","/DIR_1/1024/");
		d:エルードカメラセット２("/TRAPNAME/by001/","/DIR_1/3072/");


		// 五段目
		trap by002 d:PLAYER \
			-mask 入る \
			-exec {
				command プレイヤー状態取得 ;
