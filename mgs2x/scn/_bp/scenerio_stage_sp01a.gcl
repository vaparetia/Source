					@ジャンプ落下死発動 0x0004 -10000
				}
				@落下死カメラ -38000
			}

		trap de012 d:PLAYER \
			-mask 入る \
			-exec {
				if ( `%ゲームオーバーチェック` == 0 ) {
					d:プレイヤー落下時移動Ｘ("/X_MIN/6500/","/X_MAX/11000/");
					d:プレイヤー落下時移動Ｚ("/Z_MIN/-38500/","/Z_MAX/-35000/");

					@ジャンプ落下死発動 0x0004 -10000
				}
				@落下死カメラ -34000
			}

		trap de013 d:PLAYER \
			-mask 入る \
			-exec {
				if ( `%ゲームオーバーチェック` == 0 ) {
					d:プレイヤー落下時移動Ｘ("/X_MIN/12500/","/X_MAX/15000/");
					d:プレイヤー落下時移動Ｚ("/Z_MIN/-38500/","/Z_MAX/-37000/");

					@ジャンプ落下死発動 0x0004 -10000
				}
				@落下死カメラ -36000
			}

		trap de014 d:PLAYER \
			-mask 入る \
			-exec {
				if ( `%ゲームオーバーチェック` == 0 ) {
					d:プレイヤー落下時移動Ｘ("/X_MIN/13500/","/X_MAX/15000/");
					d:プレイヤー落下時移動Ｚ("/Z_MIN/-41500/","/Z_MAX/-39500/");

					@ジャンプ落下死発動 0x0004 -10000
				}
				@落下死カメラ -38000
			}

		trap de015 d:PLAYER \
			-mask 入る \
			-exec {
				if ( `%ゲームオーバーチェック` == 0 ) {
					d:プレイヤー落下時移動Ｘ("/X_MIN/15000/","/X_MAX/23000/");
					d:プレイヤー落下時移動Ｚ("/Z_MIN/-37000/","/Z_MAX/-19000/");

					@ジャンプ落下死発動 0x0004 -10000
				}
				@落下死カメラ -18000
			}

		trap de016 d:PLAYER \
			-mask 入る \
			-exec {
				if ( `%ゲームオーバーチェック` == 0 ) {
					d:プレイヤー落下時移動Ｘ("/X_MIN/10000/","/X_MAX/11000/");
					d:プレイヤー落下時移動Ｚ("/Z_MIN/-33950/","/Z_MAX/-33900/");

					@ジャンプ落下死発動 0x0004 -10000
				}
				@落下死カメラ -33000
			}

		trap de017 d:PLAYER \
			-mask 入る \
			-exec {
				if ( `%ゲームオーバーチェック` == 0 ) {
					d:プレイヤー落下時移動Ｘ("/X_MIN/12000/","/X_MAX/13500/");
					d:プレイヤー落下時移動Ｚ("/Z_MIN/-32000/","/Z_MAX/-19000/");

					@ジャンプ落下死発動 0x0004 -10000
				}
				@落下死カメラ -18000
			}

		trap de018 d:PLAYER \
			-mask 入る \
			-exec {
				if ( `%ゲームオーバーチェック` == 0 ) {
