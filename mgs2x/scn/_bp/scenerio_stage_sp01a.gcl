			}
		d:エルードカメラセット１("/TRAPNAME/by125/","/DIR_1/2048/");
		d:エルードカメラセット２("/TRAPNAME/by125/","/DIR_1/0/");


		// ev009西側
		trap by126 d:PLAYER \
