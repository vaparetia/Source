					d:プレイヤー落下時移動Ｘ("/X_MIN/-500/","/X_MAX/0/");
					d:プレイヤー落下時移動Ｚ("/Z_MIN/-36950/","/Z_MAX/-36900/");

					@ジャンプ落下死発動 0x0004 -10000
				}
				@落下死カメラ -36000
			}

		trap de007 d:PLAYER \
			-mask 入る \
			-exec {
				if ( `%ゲームオーバーチェック` == 0 ) {
					d:プレイヤー落下時移動Ｘ("/X_MIN/-5000/","/X_MAX/-5000/");
					d:プレイヤー落下時移動Ｚ("/Z_MIN/-41500/","/Z_MAX/-33000/");

					@ジャンプ落下死発動 0x0004 -10000
				}
				@落下死カメラ -32000
			}

		trap de008 d:PLAYER \
			-mask 入る \
			-exec {
				if ( `%ゲームオーバーチェック` == 0 ) {
					d:プレイヤー落下時移動Ｘ("/X_MIN/-3500/","/X_MAX/-3000/");
					d:プレイヤー落下時移動Ｚ("/Z_MIN/-38500/","/Z_MAX/-33000/");

					@ジャンプ落下死発動 0x0004 -10000
				}
				@落下死カメラ -32000
			}

		trap de009 d:PLAYER \
			-mask 入る \
			-exec {
				if ( `%ゲームオーバーチェック` == 0 ) {
					d:プレイヤー落下時移動Ｘ("/X_MIN/-1500/","/X_MAX/2500/");
					d:プレイヤー落下時移動Ｚ("/Z_MIN/-34500/","/Z_MAX/-33000/");

					@ジャンプ落下死発動 0x0004 -10000
				}
				@落下死カメラ -32000
			}

		trap de010 d:PLAYER \
			-mask 入る \
			-exec {
				if ( `%ゲームオーバーチェック` == 0 ) {
					d:プレイヤー落下時移動Ｘ("/X_MIN/4000/","/X_MAX/5000/");
					d:プレイヤー落下時移動Ｚ("/Z_MIN/-38500/","/Z_MAX/-33000/");

					@ジャンプ落下死発動 0x0004 -10000
				}
				@落下死カメラ -32000
			}

		trap de011 d:PLAYER \
			-mask 入る \
			-exec {
				if ( `%ゲームオーバーチェック` == 0 ) {
					d:プレイヤー落下時移動Ｘ("/X_MIN/5500/","/X_MAX/7000/");
