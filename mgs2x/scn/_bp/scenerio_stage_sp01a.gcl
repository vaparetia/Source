					-r 742,2270,0 -f 6573 \
					-a 250 \
					-i 3 2 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

	}



	// ------------------------------------
	// 敵兵や的の処理
	// ------------------------------------
	proc ＶＲ機雷設定 {
		#if d:DEBUG_PRINT 
			print 'vr_bomb_set'
		#endif

		if ( $s:選択プレイヤー == ライデン ) {
			command foreach -argc 3 -repeat 13 \
				-data { \
						{ 機雷:01, 0 0 } \
						{ 機雷:02, 1 0 } \
						{ 機雷:03, 2 0 } \
						{ 機雷:04, 3 0 } \
						{ 機雷:05, 4 0 } \
						{ 機雷:06, 5 0 } \
						{ 機雷:07, 6 0 } \
						{ 機雷:08, 7 0 } \
						{ 機雷:09, 8 0 } \
						{ 機雷:10, 9 0 } \
						{ 機雷:11, 9 2 } \
						{ 機雷:12, 9 4 } \
						{ 機雷:13, 9 6 } \
					} \
					-exec { \
						chara	ＶＲ移動的 $1 \
							-flag ( d:VR_TRG_MINE | d:VR_TRG_FL_MARK ) \
							-route $2 $3 \
							-speed 50
					}
		} else {
			command foreach -argc 3 -repeat 15 \
				-data { \
						{ 機雷:01, 11 0 } \
						{ 機雷:02, 12 0 } \
						{ 機雷:03, 13 3 } \
						{ 機雷:04, 14 1 } \
						{ 機雷:05, 15 3 } \
						{ 機雷:06, 16 0 } \
						{ 機雷:07, 17 0 } \
						{ 機雷:08, 18 0 } \
						{ 機雷:09, 19 0 } \
						{ 機雷:10, 20 0 } \
						{ 機雷:10, 20 2 } \
						{ 機雷:11, 21 0 } \
						{ 機雷:12, 22 3 } \
						{ 機雷:13, 23 2 } \
						{ 機雷:14, 24 2 } \
					} \
					-exec { \
						chara	ＶＲ移動的 $1 \
							-flag ( d:VR_TRG_MINE | d:VR_TRG_FL_MARK ) \
							-route $2 $3 \
							-speed 50
					}
		}
	}

	proc アスレチックステージＶＲ的設定 {
		#if d:DEBUG_PRINT 
			print 'vr_bomb_set'
		#endif

		if ( $s:選択プレイヤー == ライデン ) {
		// ライデンバージョンの的配置
			command foreach -argc 4 -repeat 14 \
				-data { \
						{ 三角的:01, d:VR_TRG_DIR 31 0 } \
						{ 三角的:02, d:VR_TRG_DIR 32 0 } \
						{ 三角的:03, d:VR_TRG_DIR 33 0 } \
						{ 三角的:04, d:VR_TRG_DIR 34 0 } \
						{ 三角的:05, d:VR_TRG_DIR 35 0 } \
						{ 三角的:06, d:VR_TRG_DIR 36 0 } \
						{ 三角的:07, d:VR_TRG_DIR 37 0 } \
						{ 三角的:08, d:VR_TRG_DIR 38 0 } \
						{ 三角的:09, d:VR_TRG_DIR 39 0 } \
						{ 三角的:10, d:VR_TRG_DIR 40 0 } \
						{ 三角的:11, d:VR_TRG_DIR 41 0 } \
						{ 三角的:12, d:VR_TRG_DIR 42 0 } \
						{ 三角的:13, d:VR_TRG_DIR 43 0 } \
						{ 三角的:14, d:VR_TRG_DIR 44 0 } \
					} \
					-exec { \
						chara	ＶＲ移動的 $1 \
							-flag ( d:VR_TRG_ONE_TRI | d:VR_TRG_WAIT | $2 ) \
							-route $3 $4 \
							-speed 50
					}

			command foreach -argc 2 -repeat 4 \
				-data { \
						{ 壁:01, -40000 } \
						{ 壁:02, -42000 } \
						{ 壁:03, -44000 } \
						{ 壁:03, -46000 } \
					} \
					-exec { \
						chara ＶＲ壁 $1 \
							-flag ( d:VR_TRG_NORMAL | d:VR_TRG_WAIT ) \
							-pos	21000 0 $2 \
							-dir	0	/*Ｘ軸に平行 １＝Ｚ軸に平行*/
					}
		} else {
		// スネークバージョンの的配置
			command foreach -argc 4 -repeat 17 \
				-data { \
						{ 三角的:01, d:VR_TRG_DIR 51 0 } \
						{ 三角的:02, d:VR_TRG_DIR 52 0 } \
						{ 三角的:03, d:VR_TRG_P_DIR 53 0 } \
						{ 三角的:04, d:VR_TRG_DIR 54 0 } \
						{ 三角的:05, d:VR_TRG_DIR 55 0 } \
						{ 三角的:06, d:VR_TRG_DIR 56 0 } \
						{ 三角的:07, d:VR_TRG_DIR 57 0 } \
						{ 三角的:08, d:VR_TRG_P_DIR 58 0 } \
						{ 三角的:09, d:VR_TRG_P_DIR 59 0 } \
						{ 三角的:10, d:VR_TRG_P_DIR 60 0 } \
						{ 三角的:11, d:VR_TRG_P_DIR 61 0 } \
						{ 三角的:12, d:VR_TRG_P_DIR 62 0 } \
						{ 三角的:13, d:VR_TRG_DIR 63 0 } \
						{ 三角的:14, d:VR_TRG_DIR 64 0 } \
						{ 三角的:15, d:VR_TRG_DIR 64 1 } \
						{ 三角的:16, d:VR_TRG_DIR 64 2 } \
						{ 三角的:17, d:VR_TRG_DIR 64 3 } \
					} \
					-exec { \
						chara	ＶＲ移動的 $1 \
							-flag ( d:VR_TRG_ONE_TRI | d:VR_TRG_WAIT | $2 ) \
							-route $3 $4 \
							-speed 50
					}

			command foreach -argc 4 -repeat 6 \
				-data { \
						{ 壁:01, 21000 -41000 0 } \
						{ 壁:02, 21000 -42000 0 } \
						{ 壁:03, 21000 -43000 0 } \
						{ 壁:04, 21000 -44000 0 } \
						{ 壁:05, 21000 -45000 0 } \
						{ 壁:06, 21000 -46000 0 } \
//						{ 壁:07, -3000 -7000 1 } \
					} \
					-exec { \
						chara ＶＲ壁 $1 \
							-flag ( d:VR_TRG_NORMAL | d:VR_TRG_WAIT ) \
							-pos	$2 0 $3 \
							-dir	$4	/*Ｘ軸に平行 １＝Ｚ軸に平行*/
					}
		}
	}

	// ------------------------------------
	// ＢＧＭの設定
	// ------------------------------------
	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT 
			print 'bgm_set'
		#endif

		chara ＢＧＭマネージャー ＢＧＭマネ
	}


	// ------------------------------------
	// アイテムの設定
	// ------------------------------------
	// 再発生が必要な時は以下のプロックの中を記述する
	// ------------------------------------
	proc アイテム取得時番号設定 $:ボックス名 {
		#if d:DEBUG_PRINT
			print 'item_no_set'
		#endif
	}
	// アイテムの設置
	// ------------------------------------
	proc アイテム設定 {
		#if d:DEBUG_PRINT 
			print 'item_set'
		#endif

		if ( $s:選択プレイヤー == ライデン ) {
		// ライデンのアイテム配置
			@弾薬_ソコム_初期設置 ソコム弾 d:ITEM_POS_01 0
			@ジアゼパム_初期設置 ジアゼパム d:ITEM_POS_02 0
			@ＰＳＧ１_初期設置 ＰＳＧ１本体 d:ITEM_POS_03 0 なし
			@ＡＫＳ_初期設置 ＡＫＳ本体 d:ITEM_POS_05 0 なし
			@弾薬_ＡＫＳ_初期設置 ＡＫＳ弾 d:ITEM_POS_07 0
		} else {
		// スネークのアイテム配置
			@弾薬_ＵＳＰ_初期設置 ＵＳＰ弾 d:ITEM_POS_01 0
			@ＰＳＧ１_初期設置 ＰＳＧ１本体 d:ITEM_POS_04 0 なし
			@ジアゼパム_初期設置 ジアゼパム d:ITEM_POS_05 0
			@Ｍ４_初期設置 Ｍ４本体 d:ITEM_POS_06 0 なし
		}
		
	}



	// ------------------------------------
	// その他オブジェクト関係
	// ------------------------------------

	// ------------------------------------
	// 下に落下したときの処理
	// ------------------------------------
#define	プレイヤー落下時移動Ｘ	if ( $4 < X_MIN ) { \
									mesg プレイヤー d:PLAYER position2 0 X_MIN \
								} else if ( $4 > X_MAX ) { \
									mesg プレイヤー d:PLAYER position2 0 X_MAX \
								}

#define	プレイヤー落下時移動Ｚ	if ( $6 < Z_MIN ) { \
									mesg プレイヤー d:PLAYER position2 2 Z_MIN \
								} else if ( $6 > Z_MAX ) { \
									mesg プレイヤー d:PLAYER position2 2 Z_MAX \
								}

	proc 落下死カメラ $:p_トラップ下端 {
		chara delay ディレイ \
			-time 1 \
			-arg $:p_トラップ下端 \
			-exec {
				#if d:DEBUG_PRINT
					print 'fall camera set'
				#endif
				
				chara カメラ設定 落下死カメラ \
					-c 0 \	
					-b d:CAM_MIN,10000,d:CAM_MIN		 d:CAM_MAX,d:CAM_MAX,$1 \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,($1-700) \
					-r 945,2150,0 -f 5627 \
					-a 200 \
					-z d:CAMERA_NO_CUSHION \
					-i 0 0 0 0 \
					-s 1
			}
	}
	
	
	proc 落下死処理設定 {
		#if d:DEBUG_PRINT
			print 'fall_proc_set'
		#endif

		trap de001 d:PLAYER \
			-mask 入る \
			-exec {
				if ( `%ゲームオーバーチェック` == 0 ) {
					d:プレイヤー落下時移動Ｘ("/X_MIN/-9000/","/X_MAX/14000/");
					d:プレイヤー落下時移動Ｚ("/Z_MIN/-50000/","/Z_MAX/-44000/");

					@ジャンプ落下死発動 0x0004 -10000
				}
				@落下死カメラ -43000
			}

		trap de002 d:PLAYER \
			-mask 入る \
			-exec {
				if ( `%ゲームオーバーチェック` == 0 ) {
					d:プレイヤー落下時移動Ｘ("/X_MIN/-2500/","/X_MAX/3000/");
					d:プレイヤー落下時移動Ｚ("/Z_MIN/-42500/","/Z_MAX/-41000/");

					@ジャンプ落下死発動 0x0004 -10000
				}
				@落下死カメラ -40000
			}

		trap de003 d:PLAYER \
			-mask 入る \
