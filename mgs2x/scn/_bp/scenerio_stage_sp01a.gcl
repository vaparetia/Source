		trap by401 d:PLAYER \
			-mask いる \
			-key d:PAD_ACTION \	//アクションボタン
			-state 0,4 \		//立ち状態or張り付き
			-exec {
				@東向きビヨンド発動 by401 19000 $6 -40000 -38000 d:BY_NOFOOTSHADOW
