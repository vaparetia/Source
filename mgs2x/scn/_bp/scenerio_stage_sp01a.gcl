		// 本来このトラップに入る前にゲームオーバーになると思われるが、万が一の保険のため用意する
		trap de100 d:PLAYER \
			-mask 入る \
			-exec {
				if ( `%ゲームオーバーチェック` == 0 ) {
					#if d:DEBUG_PRINT
						print '$i:プレイヤー位置Ｘ $i:プレイヤー位置Ｙ $i:プレイヤー位置Ｚ='$i:プレイヤー位置Ｘ $i:プレイヤー位置Ｙ $i:プレイヤー位置Ｚ
					#endif
					command assert ( d:FALSE ) 'trap error  (scenario err) 最終トラップに引っかかりました。'
					@ジャンプ落下死発動 0x0004 -34000
				}
				@落下死カメラ -19000
			}

	}



	// ------------------------------------
	// 落とし穴
	// ------------------------------------
	proc 落とし穴設置 {
		#if d:DEBUG_PRINT
			print 'pitfall_set'
		#endif

		command foreach -argc 3 -repeat 10 \
			-data { \
					{ 落とし穴:01, 2000, -3000 } \
					{ 落とし穴:02, 2000, -5000 } \
					{ 落とし穴:03, 2000, -7000 } \
					{ 落とし穴:04, 0, -7000 } \
					{ 落とし穴:05, -2000, -7000 } \
					{ 落とし穴:06, -4000, -7000 } \
					{ 落とし穴:07, -4000, -9000 } \
					{ 落とし穴:08, -4000, -11000 } \
					{ 落とし穴:09, -2000, -11000 } \
					{ 落とし穴:10, 0, -11000 } \
				} \
				-exec { \
					chara ＶＲ落とし穴 $1 \
						-position $2, 0, $3 \
						-rotate 0,0,0 \
						-map アスレチック \
						-model vr2_pitfall_a0 vr2_pitfall_a0 \
						-hazard	($2-1000), 0, ($3-1000) \	/*min maz の2点指定 */
								($2+1000), 0, ($3+1000) \
						-fall_time 40 \
						-fall_pattern 7 \
						-status 0 \
						-proc 落し穴落下時処理
				}
	}

	proc 落し穴落下時処理 {
		#if d:DEBUG_PRINT
			print 'pitfall_gameover'
		#endif

		switch ( $1 ) {
			case ( 落とし穴:01 ) {
				mesg プレイヤー d:PLAYER position 2000,$i:プレイヤー位置Ｙ,-3000
				@落とし穴落下時カメラセット 2000 0 -3000
				@ジャンプ落下死発動 0x0004 -10000
				mesg ＶＲ落とし穴 落とし穴:01 fall
			}
			case ( 落とし穴:02 ) {
				mesg プレイヤー d:PLAYER position 2000,$i:プレイヤー位置Ｙ,-5000
				@落とし穴落下時カメラセット 2000 0 -5000
				@ジャンプ落下死発動 0x0004 -10000
				mesg ＶＲ落とし穴 落とし穴:02 fall
			}
			case ( 落とし穴:03 ) {
				mesg プレイヤー d:PLAYER position 2000,$i:プレイヤー位置Ｙ,-7000
				@落とし穴落下時カメラセット 2000 0 -7000
				@ジャンプ落下死発動 0x0004 -10000
				mesg ＶＲ落とし穴 落とし穴:03 fall
			}
			case ( 落とし穴:04 ) {
				mesg プレイヤー d:PLAYER position 0,$i:プレイヤー位置Ｙ,-7000
				@落とし穴落下時カメラセット 0 0 -7000
				@ジャンプ落下死発動 0x0004 -10000
				mesg ＶＲ落とし穴 落とし穴:04 fall
			}
			case ( 落とし穴:05 ) {
				mesg プレイヤー d:PLAYER position -2000,$i:プレイヤー位置Ｙ,-7000
				@落とし穴落下時カメラセット -2000 0 -7000
				@ジャンプ落下死発動 0x0004 -10000
				mesg ＶＲ落とし穴 落とし穴:05 fall
			}
			case ( 落とし穴:06 ) {
				mesg プレイヤー d:PLAYER position -4000,$i:プレイヤー位置Ｙ,-7000
				@落とし穴落下時カメラセット -4000 0 -7000
				@ジャンプ落下死発動 0x0004 -10000
				mesg ＶＲ落とし穴 落とし穴:06 fall
			}
			case ( 落とし穴:07 ) {
				mesg プレイヤー d:PLAYER position -4000,$i:プレイヤー位置Ｙ,-9000
				@落とし穴落下時カメラセット -4000 0 -9000
				@ジャンプ落下死発動 0x0004 -10000
				mesg ＶＲ落とし穴 落とし穴:07 fall
			}
			case ( 落とし穴:08 ) {
				mesg プレイヤー d:PLAYER position -4000,$i:プレイヤー位置Ｙ,-11000
				@落とし穴落下時カメラセット -4000 0 -11000
				@ジャンプ落下死発動 0x0004 -10000
				mesg ＶＲ落とし穴 落とし穴:08 fall
			}
			case ( 落とし穴:09 ) {
				mesg プレイヤー d:PLAYER position -2000,$i:プレイヤー位置Ｙ,-11000
				@落とし穴落下時カメラセット -2000 0 -11000
				@ジャンプ落下死発動 0x0004 -10000
				mesg ＶＲ落とし穴 落とし穴:01 fall
			}
			case ( 落とし穴:10 ) {
				mesg プレイヤー d:PLAYER position 0,$i:プレイヤー位置Ｙ,-11000
				@落とし穴落下時カメラセット 0 0 -11000
				@ジャンプ落下死発動 0x0004 -10000
				mesg ＶＲ落とし穴 落とし穴:10 fall
			}
		}
	}

	// 落下したときに出るカメラ(落とし穴中心のＸＹＺを入力)
	proc 落とし穴落下時カメラセット $:p_Ｘ $:p_Ｙ $:p_Ｚ {
		chara delay ディレイ \
			-time 1 \
			-arg $:p_Ｘ $:p_Ｙ $:p_Ｚ \
			-exec {
				#if d:DEBUG_PRINT
					print 'fall camera set'
				#endif

				chara カメラ設定 クリア時カメラ \
					-c 1 \
					-p ($1+160),5115,($3+1072) \ 
					-t ($1-58),1987,($3+78) \
					-r 819,2189,0 -f 3289 \
					-a 200 \
					-i 0 -1 0 0 \
					-s 1
			}
	}

	// ジャンプ落下死発動から呼ばれるプロック
	proc ジャンプ落下死開始処理 {
		#if d:DEBUG_PRINT
			print 'jump_gameover_start'
		#endif

		@ゲームオーバー開始処理
	}

	// 最終的に落ちたときに呼ばれるプロック（サウンドや振動を呼ぶ）
	proc ゲームオーバー終了処理 {
	}


	// ------------------------------------
	// 光源関係
	// ------------------------------------


	// ------------------------------------
	// カメラ関係の設定 
	// ------------------------------------
	// ステージカメラ設定 
	// ------------------------------------
	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'chara_camera & stage_camera_set'
		#endif

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0 
		chara カメラ メインカメラ		-c 0 -l 2 -p 40
		chara カメラ サブカメラ			-c 0 -l 2 -p 30
		chara カメラ モーションカメラ	-c 0 -l 1 -p 1 
		chara カメラ 落下死カメラ		-c 0 -l 0 -p 15
		chara カメラ クリア時カメラ		-c 0 -l 0 -p 10

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \	
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 740,2048,0 \
			-f 9000 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}
	// ステージ固有のカメラ設定 
	// ------------------------------------
	proc アスレチックカメラ設定 {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif

		// スタート地点から落とし穴までのカメラ
		trap ca001 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 メインカメラ \
					-c 0 \	
					-b d:CAM_MIN,2000,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,4000 \
					-l d:CAM_MIN,1500,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,-1000 \
					-r 650,2048,0 \
					-f 9000 \
					-a 200 \
					-i 3 3 0 0 \
					-s $3
			}

		// 落とし穴地帯のカメラ
		trap ca002 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ降順 $6 -4000 -6000 650 800
				$i:補完ＲＸ = $i:CS_結果１;

				chara カメラ設定 メインカメラ \
					-c 0 \	
					-b -3000,2000,d:CAM_MIN	 1000,d:CAM_MAX,d:CAM_MAX \
					-l -3000,1500,d:CAM_MIN	 1000,d:CAM_MAX,d:CAM_MAX \
					-r $i:補完ＲＸ,2048,0 \
					-f 9000 \
					-a 200 \
					-i 3 3 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// 落とし穴地帯〜イントルード地帯のカメラ
		trap ca003 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ降順 $6 -12000 -15500 800 500
				$i:補完ＲＸ = $i:CS_結果１;

				chara カメラ設定 メインカメラ \
					-c 0 \	
					-b -3000,2000,d:CAM_MIN	 1000,d:CAM_MAX,d:CAM_MAX \
					-l -3000,1500,d:CAM_MIN	 1000,d:CAM_MAX,d:CAM_MAX \
					-r $i:補完ＲＸ,2048,0 \
					-f 9000 \
					-a 200 \
					-i 3 3 0 0 \
					-s $3
			}

		// イントルード地帯出た部分のカメラ
		trap ca004 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ降順 $6 -18500 -20500 750 500
				eval( $i:補完ＲＸ = $i:CS_結果１ );

				chara カメラ設定 メインカメラ \
					-c 0 \	
					-b d:CAM_MIN,2000,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,-17000 \
					-l d:CAM_MIN,1500,d:CAM_MIN	 d:CAM_MAX,d:CAM_MAX,-20500 \
					-r $i:補完ＲＸ,2048,0 \
					-f 9000 \
					-a 200 \
					-i 3 3 0 0 \
					-s $3
			}

		// イントルード地帯出た後、メインとなるカメラ
		trap ca005 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 メインカメラ \
					-c 0 \	
					-b -6000,2000,d:CAM_MIN	 20500,d:CAM_MAX,-17000 \
					-l -6000,1500,d:CAM_MIN	 20500,d:CAM_MAX,-20500 \
					-r 500,2048,0 \
					-f 9000 \
					-a 200 \
					-i 3 3 0 0 \
					-s $3
			}

		// 橋地帯のカメラ
		trap ca006 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				if ( $4 < 0 ) {
					@CS_スムーズカメラ昇順 $4 -6000 -3000 500 750
					$i:補完ＲＸ = $i:CS_結果１;
					@CS_スムーズカメラ昇順 $4 -6000 -3000 9000 10000
					$w:補完距離 = $i:CS_結果１;
				} else {
					@CS_スムーズカメラ昇順 $4 12000 15000 750 500
					$i:補完ＲＸ = $i:CS_結果１;
					@CS_スムーズカメラ昇順 $4 12000 15000 10000 9000
					$w:補完距離 = $i:CS_結果１;
				}
				

				chara カメラ設定 メインカメラ \
					-c 0 \	
					-b -6000,2000,d:CAM_MIN	 20500,d:CAM_MAX,-17000 \
					-l -6000,1500,d:CAM_MIN	 20500,d:CAM_MAX,-20500 \
					-r $i:補完ＲＸ,2048,0 \
					-f $w:補完距離 \
					-a 200 \
					-i 3 3 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}


		// ゴール付近のカメラ
		trap ca007 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 メインカメラ \
					-c 0 \	
					-b 20000,2000,d:CAM_MIN	 22000,d:CAM_MAX,-34000 \
					-l 20000,1500,d:CAM_MIN	 22000,d:CAM_MAX,-39250 \
					-r 500,2048,0 \
					-f 7000 \
					-a 200 \
					-i 2 2 0 0 \
					-s $3
			}

		// 手すりの張り付きカメラ
		trap ca101 d:PLAYER \
			-mask ？ \
			-dir 3072 512 \
			-state d:TRP_STATE_CAUTION \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ \
					-c 0 \	
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,-37500 \
					-l d:CAM_MIN,6500,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,-39000 \
					-r 787,2048,0 -f 4585 \
					-a 200 \
					-i 3 3 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}
	}





// -----------------------------------------------------------------------------------
// 以下デバッグ専用proc
// -----------------------------------------------------------------------------------
// デバッグキャラ
// ------------------------------------
proc デバッグキャラセット {
	#if d:DEBUG_PRINT
		print 'debug_chara_set'
	#endif

	#if d:CHARA_CAMERA
		chara キャラカメラ 敵兵カメラ \
			-c d:TARGET_CHARA \
			-s -920,610,200 \
			-r -200,1024,0 
	#endif

	#if d:SCREENSHOT
		chara スクリーンショット shot
	#endif

	#if d:USB_KEY
		chara USBキーボード実行 test \
			-e d:KBD_ESC {	
				mesg プレイヤー d:PLAYER position 13000, 8000, -34500
			} \
	#endif
}
