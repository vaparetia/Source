					-s $3
			}
#else

		trap ca001 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
					chara カメラ設定 小部屋カメラ \
						-c 0 \	
/*
						-b -4546,d:CAM_MIN,-7351 2328,6000,1055 \
						-l -4546,d:CAM_MIN,-7251 2328,1543,1006 \
*/
						-b -4546,d:CAM_MIN,-3402 2328,6000,1055 \
