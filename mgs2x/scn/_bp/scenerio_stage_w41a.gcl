//###################################################################################
//									アイテム
//###################################################################################

	proc アイテム設定 {
		#if d:DEBUG_PRINT
			print 'item_set'
		#endif

		//	レーション
		@アイテム再セットチェック（難易度対応） $b:w41a_取得ロード回数[0] 
		if ($f:再セットフラグ) {
			@レーション_初期設置 レーション:01 -5250 0 -3500 0			//	左側イントルードの中
		}


		//	風邪薬
		if ($b:w41a_風邪薬フラグ == d:FALSE) {
			chara アイテム 風邪薬:01 \
				-b d:シナリオの発生パターン \		// 発生パターン
				-p 2500,200,-7200 \		// 発生位置
				-k medicine_ibox \					// モデル：箱本体
				-s medicine_ibox_sh \				// モデル：箱影
				-l cold_medicine_label \			// モデル：ラベル
				-f d:アイテム種別:アイテム \		// ＩＤ：from ..../scn/equip.h
				-i d:アイテム:風邪薬 \				// ＩＤ：from ..../scn/equip.h
				-n 1 \								// 個数
				-r 0 \						// 0で飛沫無し。
				-h d:シナリオの高さ \				// 床面からの高さ
				-x {
					eval ($b:w41a_風邪薬フラグ = d:TRUE)
				}
		}

	}

	proc アイテム取得時番号設定 $:ボックス名 {
		#if d:DEBUG_PRINT
			print 'item_no_set'
		#endif

		if ($:ボックス名 == レーション:01) {
			eval($b:w41a_取得ロード回数[0] = $w:グローバルロード回数);
		}
	}



