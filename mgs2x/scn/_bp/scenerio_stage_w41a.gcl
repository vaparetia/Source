	proc 映り込み設定 {
		chara 鏡面モデル管理 床映り込み \
			-pos	0,0,0 \
			-axis	1		// Y軸反点

		if ($f:w41a_主観デモフラグ == d:FALSE) {
			//	拷問部屋内に入ったものは映り込む
			trap ca001 ？ \
				-mask ？ \
				-exec {
					if ($3 == 入る) {
						mesg 鏡面モデル管理 床映り込み add $2
					} else if ($3 == 出る){
						mesg 鏡面モデル管理 床映り込み del $2
					}
				}
	
			trap ca003 ？ \
				-mask ？ \
				-exec {
					if ($3 == 入る) {
						mesg 鏡面モデル管理 床映り込み add $2
					} else if ($3 == 出る){
						mesg 鏡面モデル管理 床映り込み del $2
					}
				}
		}
	
	}

	proc キャラ用ライト設定 {
		#if d:DEBUG_PRINT
			print 'chara_light_set'
		#endif

		chara 環境光 環境光源 \
			 -c 25 65 60

		chara 平行光 平行光源 \
			 -c 41 47 32 \
			 -p -4430 1691 -1585
	}


	proc 影設定 {
		#if d:DEBUG_PRINT
		print'SHADOW'
		#endif

		//	影写り用モデル
			//	部屋
		chara 影投影モデル 影用モデル \
			-model w41a_sdw \
			-pos 0,0,0
			//	廊下
		chara 影投影モデル 影用モデル２ \
			-model w41a_sdw_02 \
			-pos 0,0,0


		//	影写り用ハザード　敵兵が影を発見
/*
		command	影投影ハザード \
			-name 拷問部屋 \
			-group 1
*/
		chara 影管理 影管理人 \
			-type 1

		if ($f:w41a_主観デモフラグ == d:FALSE) {
			//	部屋
			trap sh001 ？ \
				-mask  ？ \
				-exec {
					if ($3 == 入る) {
						print '#############################################################ROOM_SDWON'
						mesg 影管理 影管理人 add $2 影用モデル
					} else if ($3 == 出る) {
						print '#############################################################ROOM_SDWOFF'
						mesg 影管理 影管理人 del $2
					}
				}
			//	廊下
			trap sh002 ？ \
				-mask  ？ \
				-exec {
					if ($3 == 入る) {
						print '#############################################################COR_SDWON'
						mesg 影管理 影管理人 add $2 影用モデル２
					} else if ($3 == 出る) {
						print '#############################################################COR_SDWOFF'
						mesg 影管理 影管理人 del $2
					}
				}
		}
	}

//###################################################################################
//									カメラ
//###################################################################################

	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0 
		chara カメラ 通路カメラ			-c 0 -l 2 -p 60
		chara カメラ 小部屋カメラ		-c 0 -l 2 -p 50
		chara カメラ 張り付きカメラ		-c 0 -l 2 -p 30
		chara カメラ モーションカメラ	-c 0 -l 0 -p 20
		chara カメラ モーションカメラ２	-c 0 -l 0 -p 15
		chara カメラ 捕まったふりカメラ	-c 0 -l 0 -p 10
		chara カメラ シナリオカメラ		-c 0 -l 1 -p 6
		chara カメラ ロードカメラ		-c 0 -l 1 -p 5

		chara カメラ クリアリングカメラ		-c 1 -l 2 -p 0

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \	
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 250,2048,0 \
			-f 6500 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}

