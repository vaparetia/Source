						-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,1155\
						-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
						-c 1 \	
						-p 5276,6000,1055 -t 5276,1370,751 \
						-r 981,2048,0 -f 4640 \
						-a 200 \
						-i 0 -1 0 0 \
						-z d:CAMERA_LIMITBOUND_EXIST \
						-s $3
			}







#endif

		// 通路
		trap ca002 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 通路カメラ \
					-c 0 \	
