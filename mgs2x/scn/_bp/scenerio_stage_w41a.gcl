					return 0
				}
			}
	}
	proc 拷問１＿Ｄ終了 {
		//	デモキャンセルが押された場合はこの処理は通らないようにする
		if ($1 == 1) {
			//	念のため
			mesg デモキャンセルチェック オルガ主観デモキャンセル kill
			return 
		}

		eval ( $i:STREAM_ID = `%Stream t:vc107005 -p 拷問１＿Ｅ終了 -action 拷問１＿Ｅプロック` )
		chara delay ディレイ \
			-time 1 \
			-exec{
				if ($i:STREAM_ID < 0) {
					eval ( $i:STREAM_ID = `%Stream t:vc107005 -p 拷問１＿Ｅ終了 -action 拷問１＿Ｅプロック` )
					return 1
				} else {
					return 0
				}
			}
	}
	proc 拷問１＿Ｅ終了 {
		//	デモキャンセルが押された場合はこの処理は通らないようにする
		if ($1 == 1) {
			//	念のため
			mesg デモキャンセルチェック オルガ主観デモキャンセル kill
			return 
		}

		eval ( $i:STREAM_ID = `%Stream t:vc107006 -p 拷問１＿Ｆ終了 -action 拷問１＿Ｆプロック` )
		chara delay ディレイ \
			-time 1 \
			-exec{
				if ($i:STREAM_ID < 0) {
					eval ( $i:STREAM_ID = `%Stream t:vc107006 -p 拷問１＿Ｆ終了 -action 拷問１＿Ｆプロック` )
					return 1
				} else {
					return 0
				}
			}
	}
	proc 拷問１＿Ｆ終了 {
		//	デモキャンセルが押された場合はこの処理は通らないようにする
		if ($1 == 1) {
			//	念のため
			mesg デモキャンセルチェック オルガ主観デモキャンセル kill
			return 
		}

		eval ( $i:STREAM_ID = `%Stream t:vc107007 -p 主観デモ終了 -action 拷問１＿Ｇプロック` )
		chara delay ディレイ \
			-time 1 \
			-exec{
				if ($i:STREAM_ID < 0) {
					eval ( $i:STREAM_ID = `%Stream t:vc107007 -p 主観デモ終了 -action 拷問１＿Ｇプロック` )
					return 1
				} else {
					return 0
				}
			}
	}

	proc 拷問１＿Ａプロック $:ストリームＩＤ $:話者名 $:アクションコード {
		if ($:アクションコード == 0) {
			//	「久しぶり…」
	//		mesg ルートデモ人形 ソリダス ルートノード変更 2 2

		} else if ($:アクションコード == 1) {
			//	「ジャック…」オセロットソリダスを見て一歩前に出る
			mesg ルートデモ人形 オセロット ルートノード変更 3 1
		}
	}

	proc 拷問１＿Ｂプロック $:ストリームＩＤ $:話者名 $:アクションコード {
		if ($:アクションコード == 0) {
			//「この男を…」	から９０フレーム後にオセロットをにらむ
			mesg ルートデモ人形 ソリダス ルートノード変更 2 3
		}

	}
	proc 拷問１＿Ｃプロック $:ストリームＩＤ $:話者名 $:アクションコード {
		if ($:アクションコード == 0) {
			//	「私を覚えている…」
//			mesg ルートデモ人形 ソリダス ルートノード変更 2 4
		}
	}
	proc 拷問１＿Ｄプロック $:ストリームＩＤ $:話者名 $:アクションコード {
		//	「大きくなった…」のあと
		 if ($:アクションコード == 0) {
			//	蛇手伸びる
			mesg ルートデモ人形 ソリダス ルートノード変更 2 5
			mesg デモ蛇手 ソリダス蛇手 motion 1


			//	蛇手がプレイヤーにからんだ直後
			chara delay パッド振動ディレイ \
				-t 46 \
				-e {
					//	振動
					chara パッド振動 首締めパッド振動 -vibfile snake_arm_01
				}

			//	蛇手がプレイヤーにからんだ直後
			chara delay カメラ振動ディレイ \
				-t 60 \
				-e {
					//	ライデン首が動かなくなる
					mesg 主観デモプレイヤー ライデン rotate -64 0 1
					mesg 主観デモプレイヤー ライデン rx_limit 1 1
					mesg 主観デモプレイヤー ライデン ry_limit 1 1

					chara シナリオカメラ振動 首締め振動 \
						-xlevel 10 \
						-ylevel 60 \
						-time 900 \
						-mode 0

				}

			//	プラズマずしゃ〜ん
//			mesg デモ蛇手 ソリダス蛇手 flow 1
			//	オセロットビックリ
			mesg ルートデモ人形 オセロット ルートノード変更 3 3
		}
	}

	proc ソリダス蛇手終了 {
		if ($1 == 1) {
			//	蛇手伸びたあとのループ
			mesg デモ蛇手 ソリダス蛇手 motion 2
			//	プラズマずしゃ〜んオフ
//			mesg デモ蛇手 ソリダス蛇手 flow 0

			//	Ｏ２が減っていく
			chara Ｏ２ゲージ ソリダス首締めくん \
				-max 2500 -length d:O2_GAGE
			command Ｏ２ゲージ表示
			command Ｏ２ゲージ回復力設定 32
			@０２設定

			//	ガマン説明テクスチャ表示
			//	イギリス
			if ($w:言語 == d:LANG_ENGLISH_ENGLAND) {
				chara 簡易レイアウトプレイヤ 息我慢ボタン \
					-c 4					\
					-l breath				\
					-i DefaultAction		\
					-b OpenBreath			\
					-e Close_Breath
			//	フランス
			} else if ($w:言語 == d:LANG_FRENCH) {
				chara 簡易レイアウトプレイヤ 息我慢ボタン \
					-c 4					\
					-l breath				\
					-i DefaultAction		\
					-b OpenBreath-fr		\
					-e Close_Breath-fr
			//	ドイツ
			} else if ($w:言語 == d:LANG_GERMANY) {
				chara 簡易レイアウトプレイヤ 息我慢ボタン \
					-c 4					\
					-l breath				\
					-i DefaultAction		\
					-b OpenBreath-de		\
					-e Close_Breath-de
			//	イタリア
			} else if ($w:言語 == d:LANG_ITALY ) {
				chara 簡易レイアウトプレイヤ 息我慢ボタン \
					-c 4					\
					-l breath				\
					-i DefaultAction		\
					-b OpenBreath-it		\
					-e Close_Breath-it
			//	スペイン
			} else if ($w:言語 == d:LANG_SPANISH) {
				chara 簡易レイアウトプレイヤ 息我慢ボタン \
					-c 4					\
					-l breath				\
					-i DefaultAction		\
					-b OpenBreath-es		\
					-e Close_Breath-es
			} else if ($w:言語 == d:LANG_JAPANESE) {
				chara 簡易レイアウトプレイヤ 息我慢ボタン \
					-c 4					\
					-l breath				\
					-i DefaultAction		\
					-b OpenBreath-jp		\
					-e Close_Breath-jp
			}

			//	蛇手スキャン音設定
			@蛇手スキャン音設定
		}
	}

	proc ０２設定 {
		chara プロック連続実行 Ｏ２管理人 \
			-t -1 \
			-e {
//				if ($w:Ｏ２ > 2) {
				if ($w:Ｏ２ > 4) {
					eval($w:Ｏ２ = $w:Ｏ２- 4)
//					eval($w:Ｏ２ = $w:Ｏ２- 2)
				}
			}
	}

	proc 蛇手スキャン音設定 {
		@蛇手スキャン音実行
	}
	proc 蛇手スキャン音実行 {
		chara delay 蛇手スキャン音ディレイ \
			-t 12 \
			-e {
				command ＳＥセットモード -s d:se_code:SD_A_HEBSCAN1 \
					-p	$i:プレイヤー位置Ｘ,$i:プレイヤー位置Ｙ,$i:プレイヤー位置Ｚ \
					-m 1
				@蛇手スキャン音実行
			}
	}

	proc 拷問１＿Ｅプロック $:ストリームＩＤ $:話者名 $:アクションコード {
		//	ぐわぁぁぁ
	}

	proc 拷問１＿Ｆプロック $:ストリームＩＤ $:話者名 $:アクションコード {
		if ($:アクションコード == 0) {
			//	「大量の…」
			mesg ルートデモ人形 ソリダス ルートノード変更 2 6
		}
	}

	proc 拷問１＿Ｇプロック $:ストリームＩＤ $:話者名 $:アクションコード {
		//	ぐわぁぁぁ
	}

/*
	proc 拷問１プロック $:ストリームＩＤ $:話者名 $:アクションコード {
			if ($:アクションコード == 0) {
				//	「久しぶり…」
	//			mesg ルートデモ人形 ソリダス ルートノード変更 2 2

			} else if ($:アクションコード == 1) {
				//	オセロットをにらむ
				mesg ルートデモ人形 ソリダス ルートノード変更 2 3

			} else if ($:アクションコード == 2) {
				//	「私を覚えている…」
				mesg ルートデモ人形 ソリダス ルートノード変更 2 4

			} else if ($:アクションコード == 3) {
				//	蛇手伸びる
				mesg ルートデモ人形 ソリダス ルートノード変更 2 5
				//	オセロットビックリ
				mesg ルートデモ人形 オセロット ルートノード変更 3 3

			} else if ($:アクションコード == 4) {
				//	「大量の…」
	//			mesg ルートデモ人形 ソリダス ルートノード変更 2 6

			} else if ($:アクションコード == 5) {
				//	「この男を…」
				mesg ルートデモ人形 オセロット ルートノード変更 3 1
			}
	}
*/



	proc 拷問２プロック $:ストリームＩＤ $:話者名 $:アクションコード {
		if ($:アクションコード == 0) {
			mesg ルートデモ人形 オルガ ルートノード変更 4 1

			//	振動
			chara delay パッド振動ディレイ \
				-t 178 \
				-e {
					//	振動
					chara パッド振動 殴られパッド振動 -vibfile org_punch
				}





		} else if ($:アクションコード == 1) {
			//	パンチを食らうとダメージ
			command プレイヤーライフ値操作 \
				-type 1 \
				-value -10

			//	うぐ！
			mesg 主観デモプレイヤー ライデン rotate 512 0 1
			mesg 主観デモプレイヤー ライデン rx_limit 1 1
			mesg 主観デモプレイヤー ライデン ry_limit 1 1

			chara シナリオカメラ振動 殴られ振動 \
				-xlevel 10 \
				-ylevel 60 \
				-time 60 \
				-mode 0

			mesg ブラー 視界ブラー パラメータ 120 180

		}
	
	}


	proc 主観デモ設定 {
		//	主観デモ中のみ起動
		if ($f:w41a_主観デモフラグ == d:TRUE) {

			//	レーダーは消す　武器・アイテムメニューのオフ　無線オフ　ポーズオフ
			command メニュー設定 \
				-radar off -menu off \
				-radio off -pause off

			//	ブラーを入れる
			chara ブラー 視界ブラー \
					-i 96

			//	毎回外しておかないと音がなる
			eval($w:武器 = d:武器:素手);
			eval($w:アイテム = d:アイテム:素手);

			//	ガチャガチャ音設定
			@拷問枷音設定

			//	ストーリーフラグで分岐
			if ($w:p_story < d:ST:P070_13_P09ＡＧ起動１３ポリゴンデモ９開始) {

				//	ＢＧＭを鳴らす
				command セットサウンドコード -c d:SNG_PLAY_05

				//	シネマスクリーン起動
				mesg シネマスクリーン シネマ フェードアウト 1

				//	シネマスクリーン解除
				chara delay シネマスクリーンディレイ \
					-t 240 \
					-e {
						mesg シネマスクリーン シネマ フェードイン 0
					}

				//	武器アイテムを取り上げる
				command	武器アイテム取られ

				//	主観プレイヤー起動
				chara 主観デモプレイヤー ライデン \
					-k rah_def_dummy \
//					-e rah_def_mh_mt \
					-e rah_naked_mh_mt \
					-m rai_w41a \
					-p -2000,1750,-3400 \
					-r 512,0,0		//	拷問起きをする場合
//					-r 0,0,0

				//	プレイヤー視界制限
				mesg 主観デモプレイヤー ライデン ry_limit 512  512

			
				//	顔を起こす
				@拷問起き設定


				//	ソリダス起動
				chara ルートデモ人形 ソリダス \
					-route 2 0 \ 
					-kms sol_def_sh_mt \		//	影／映り込み用
					-evm sol_def_mh_mt \
					-mar sol_w41a \
					-number d:ソリダスモーションリスト:sol_breath1 \
					-face ソリダス \
					-item sol_gantai_obj 12 \
					-proc 拷問開始 1


				chara デモ蛇手 ソリダス蛇手 \
					-model sol_snakearm_mh_mt \
					-motion sol_snakearm_w41a \
					-parent ソリダス \
					-unit 2 \
					-proc ソリダス蛇手終了

				mesg デモ蛇手 ソリダス蛇手 flow 0

				//	映り込みモデル表示
//				mesg 鏡面モデル管理 床映り込み add ソリダス
//				mesg 影管理 影管理人 add ソリダス 影用モデル

				//	オセロット起動
				chara ルートデモ人形 オセロット \
					-route 3 0 \
					-kms rev_plant_sh_mt \		//	影／映り込み用
					-evm rev_plant_mh_mt \
					-mar rev_w41a \
					-face オセロット \
					-number d:オセロットモーションリスト:rev_breath1

				//	オセロット髪の毛
				chara ロープモデル３ オセロットの髪の毛 \
					-n rev_hair_fix \
					-d 4 \
					-y オセロット \
					-z 2 \
					-o 100 \
					-b rev_coat_bounding \
					-f 1 \
					-h 1

				//	映り込みモデル表示
//				mesg 鏡面モデル管理 床映り込み add オセロット
//				mesg 影管理 影管理人 add オセロット 影用モデル

				chara 台詞発生源君 発生源君 \
					-n ライデン ソリダス オセロット \
					-m d:STRFAD_MODE_NO_JIMAKU

				//	キャンセルできないようにする
//				chara デモキャンセルチェック 主観デモキャンセル -p ソリダスデモキャンセル

			} else if ($w:p_story < d:ST:P070_23_R04ＡＧ起動２３無線機デモ４開始) {

				//	ＢＧＭを鳴らす
				command セットサウンドコード -c d:SNG_PLAY_05

				//	主観プレイヤー起動
				chara 主観デモプレイヤー ライデン \
					-k rah_def_dummy \
//					-e rah_def_mh_mt \
					-e rah_naked_mh_mt \
					-m rai_w41a \
					-p -2000,1750,-3400 \
					-r 0,0,0

				//	プレイヤー視界制限
				mesg 主観デモプレイヤー ライデン ry_limit 512  512

				//	オルガ起動
				chara ルートデモ人形 オルガ \
					-route 4 0 \
					-kms org_plant_sh_mt \		//	影／映り込み用
					-evm org_plant_mh_mt \
					-mar org_w41a \
					-face オルガ \
					-number d:オルガモーションリスト:org_talk

				chara マルチウェイト髪の毛モデル プラントオルガの髪 \
					-n org_plant_hair_mh\
					-d 20 \
					-y オルガ \
					-b org_plant_dummy \
					-z 11 12 \
					-o 100 \
					-f 1 \
					-c 2 { 11 12 }

				//	オルガ装備品
				chara 装備品Ｃ ピストル \
					-n demo_org_plant_hlst \
					-y オルガ \
					-z 0 \
					-x -117,93,72 \
					-f 1
				chara 装備品Ｃ 無線機 \
					-n demo_org_plant_radio \
					-y オルガ \
					-z 0 \
					-x 81,147,-77 \
					-f 1
				chara 装備品Ｂ ナイフ \
					-n demo_org_plant_ssk \
					-y オルガ \
					-z 0 \
					-x 112,47,87 \
					-q 17 \
					-p 37,-164,122

				//	映り込みモデル表示
//				mesg 鏡面モデル管理 床映り込み add オルガ
				//	影モデル表示
//				mesg 影管理 影管理人 add オルガ 影用モデル

				//	ストリーム再生
//				eval ( $i:STREAM_ID = `%Stream t:vc107011 -p 主観デモ終了 -action 拷問２プロック` )
				eval ( $i:STREAM_ID = `%Stream t:vc107011 -p オルガ主観デモ終了 -action 拷問２プロック` )
				chara delay ディレイ \
					-time 1 \
					-exec{
						if ($i:STREAM_ID < 0) {
							eval ( $i:STREAM_ID = `%Stream t:vc107011 -p オルガ主観デモ終了 -action 拷問２プロック` )
							return 1
						} else {
							return 0
						}
					}

				chara 台詞発生源君 発生源君 \
					-n ライデン オルガ \
					-m d:STRFAD_MODE_NO_JIMAKU

				//	キャンセルできないようにする
//					chara デモキャンセルチェック オルガ主観デモキャンセル -p オルガ主観デモキャンセル

			}
#if 0
			//	使ってない
			} else if ($w:p_story ==  d:ST:P070_23_R04ＡＧ起動２３無線機デモ４開始) {

				//	主観プレイヤー起動
				chara 主観デモプレイヤー ライデン \
					-k rah_def_dummy \
//					-e rah_def_mh_mt \
					-e rah_naked_mh_mt \
					-m rai_w41a \
					-p -2000,1750,-3400 \
					-r 0,0,0

				mesg 主観デモプレイヤー ライデン ry_limit 512  512

				//	かけなかったら２０秒後に無線
				chara delay 無線機ディレイ \
					-t 600 \
					-e {
						@rt_P070_23_R04ＡＧ起動２３無線機デモ４
					}
			}
#endif
		}
	}

	//	主観デモキャンセル
	proc ソリダスデモキャンセル {
		print '##############################################DEMOSTOP'
			@主観デモ終了
		//	鳴っているときは
	}
	proc オルガ主観デモキャンセル {
		mesg デモキャンセルチェック オルガ主観デモキャンセル kill
		eval ($w:p_story = d:ST:P070_23_R04ＡＧ起動２３無線機デモ４開始)
		if ($w:p_story < d:ST:P070_23_R04ＡＧ起動２３無線機デモ４終了) {
			//	無線がかかってくる
			chara フェードインアウト フェードアウト \
				-c 0,0,0 128 \
				-t d:FADEOUT_TIME \
				-p rt_P070_23_R04ＡＧ起動２３無線機デモ４
		} else {
			@w41a_拘束開放処理
		}
	}

	//	オルガ主観デモ終了
	proc オルガ主観デモ終了 {
		//	デモキャンセルが押された場合はこの処理は通らないようにする
		if ($1 == 1) {
			//	念のため
			mesg デモキャンセルチェック オルガ主観デモキャンセル kill
			return 
		}

		chara delay 主観デモ終了ディレイ \
			-t 210 \
			-e {
				eval( $w:p_story = d:ST:P070_23_R04ＡＧ起動２３無線機デモ４開始)

				mesg 装備品Ｃ ピストル kill
				mesg 装備品Ｃ 無線機 kill
				mesg 装備品Ｂ ナイフ kill
				mesg マルチウェイト髪の毛モデル プラントオルガの髪 kill

				mesg ルートデモ人形 オルガ kill
	

				//	ドア開く
				mesg ドア 廊下西ドア open


				chara delay 主観復帰ディレイ \
					-t 120 \
					-e {
						//	ドア閉まる
						mesg ドア 廊下西ドア close


						//	ライデン首を上げる
						eval ($i:w41a_拷問ベッド角度 = 512)
						chara プロック連続実行 ライデン起き上がり \
							-t -1 \
							-e {
								if ($i:w41a_拷問ベッド角度 >= 0) {
									eval( $i:w41a_拷問ベッド角度 = $i:w41a_拷問ベッド角度 - 5)
									mesg 主観デモプレイヤー ライデン rotate $i:w41a_拷問ベッド角度 -1
								} else {
									mesg ブラー 視界ブラー パラメータ 0 600
									mesg 主観デモプレイヤー ライデン rotate 128 -1 0	//-1で無視
									//	無線復帰
									command メニュー設定 -radio on

									mesg プロック連続実行 ライデン起き上がり kill


								}
							}
						
						//	主観操作復帰
						mesg 主観デモプレイヤー ライデン ry_limit 512 512
						mesg 主観デモプレイヤー ライデン rx_limit 640 800

					}

				//	かけなかったら２０秒後に無線
				chara delay 無線機ディレイ \
					-t 1200 \
					-e {
						@rt_P070_23_R04ＡＧ起動２３無線機デモ４
					}
			}
	}

	//	無線機の終了の中で呼ばれる
	proc w41a_拘束開放処理 {
		mesg デモキャンセルチェック オルガ主観デモキャンセル kill
		mesg delay 無線機ディレイ kill
#if 0
		chara delay 主観デモ終了ディレイ \
			-t 120 \
			-e {
				//	ＳＥ呼び
				command ＳＥセットモード -s d:se_code:SD_A_KASEOPEN \
					-p	$i:プレイヤー位置Ｘ,$i:プレイヤー位置Ｙ,$i:プレイヤー位置Ｚ \
					-m 1
				//	振動
				chara パッド振動 外れパッド振動 -vibfile rai_release
				chara delay 主観デモ終了ディレイ \
					-t 10 \
					-e {
						@主観デモ終了
					}
		}
#else
		//	ＳＥ呼び
		command ＳＥセットモード -s d:se_code:SD_A_KASEOPEN \
			-p	$i:プレイヤー位置Ｘ,$i:プレイヤー位置Ｙ,$i:プレイヤー位置Ｚ \
			-m 1
		//	振動
		chara パッド振動 外れパッド振動 -vibfile rai_release
		chara delay 主観デモ終了ディレイ \
			-t 10 \
			-e {
				@主観デモ終了
			}

#endif
	}

	proc 拷問枷音設定 {
		chara プロック連続実行 拷問枷音管理人 \
			-t -1 \
			-e {
				//	左側
				if ( ($w:プレイヤー方向 >= 510) && ($w:プレイヤー方向 <= 2048) ) {
					//	左側引っかかっていない場合
					if ($f:w41a_拷問機左側引っかかったフラグ == d:FALSE) {
						//	押しっぱなしでチェック
						if (`command パッドチェック -status` & d:PAD_L) {
							eval ($f:w41a_拷問機左側引っかかったフラグ = d:TRUE)
							command ＳＥセットモード -s d:se_code:SD_A_KASESTOP \
								-p	$i:プレイヤー位置Ｘ,$i:プレイヤー位置Ｙ,$i:プレイヤー位置Ｚ \
								-m 1
							//	振動
							chara パッド振動 枷音パッド振動 -vibfile rai_restriction
						}
					//	引っかかった場合
					} else {
						//	押されたでチェック
						if (`command パッドチェック -press` & d:PAD_L) {
							command ＳＥセットモード -s d:se_code:SD_A_KASESTOP \
								-p	$i:プレイヤー位置Ｘ,$i:プレイヤー位置Ｙ,$i:プレイヤー位置Ｚ \
								-m 1
							//	振動
							chara パッド振動 枷音パッド振動 -vibfile rai_restriction
						}
					}
				//	右側
				 } else if ( ($w:プレイヤー方向 > 2048) && ($w:プレイヤー方向 <= 3586) ) {
					//	右側引っかかっていない場合
					if ($f:w41a_拷問機右側引っかかったフラグ == d:FALSE) {
						//	押しっぱなしでチェック
						if (`command パッドチェック -status` & d:PAD_R) {
							eval ($f:w41a_拷問機右側引っかかったフラグ = d:TRUE)
							command ＳＥセットモード -s d:se_code:SD_A_KASESTOP \
								-p	$i:プレイヤー位置Ｘ,$i:プレイヤー位置Ｙ,$i:プレイヤー位置Ｚ \
								-m 1
							//	振動
							chara パッド振動 枷音パッド振動 -vibfile rai_restriction
						}
					//	引っかかった場合
					} else {
						if (`command パッドチェック -press` & d:PAD_R) {
							eval ($f:w41a_拷問機右側引っかかったフラグ = d:TRUE)
							command ＳＥセットモード -s d:se_code:SD_A_KASESTOP \
								-p	$i:プレイヤー位置Ｘ,$i:プレイヤー位置Ｙ,$i:プレイヤー位置Ｚ \
								-m 1
							//	振動
							chara パッド振動 枷音パッド振動 -vibfile rai_restriction
						}
					}
				//	それ以外
				} else {
					//	フラグを初期化する
					eval ($f:w41a_拷問機左側引っかかったフラグ = d:FALSE)
					eval ($f:w41a_拷問機右側引っかかったフラグ = d:FALSE)
				}
			}
	}



//###################################################################################
//									特殊処理
//###################################################################################

	proc 捕まったふり監視 {
#if 0
		if ($f:w41a_捕まったふりバレたフラグ == d:FALSE) {
			if ($w:アラートモード == d:ALERT_MODE_KIKEN) {
				#if d:DEBUG_PRINT
				print 'BARETA-BARETA-BARETA-BARETA-BARETA-BARETA-BARETA'
				#endif
				eval ($f:w41a_捕まったふりバレたフラグ = d:TRUE)
			}
		}
#else
		trap cl001 d:PLAYER \
			-mask ＊ \
			-exec {
				if ($3 == いる) {
					if ($f:w41a_捕まったふりバレたフラグ == d:FALSE) {
						if ($w:アラートモード == d:ALERT_MODE_KIKEN) {
							eval ($f:w41a_捕まったふりバレたフラグ = d:TRUE)
						}
					}
		/*
					} else if ($f:w41a_捕まったふりバレたフラグ == d:TRUE) {
						if ($w:アラートモード != d:ALERT_MODE_KIKEN) {
							eval ($f:w41a_捕まったふりバレたフラグ = d:FALSE)
						}
					}
		*/
				} else if ($3 == 出る) {
					if ($f:w41a_捕まったふりバレたフラグ == d:TRUE) {
						if ($w:アラートモード != d:ALERT_MODE_KIKEN) {
							eval ($f:w41a_捕まったふりバレたフラグ = d:FALSE)
						}
					}
				}
			}
#endif
	}




	proc 捕まったふり設定 {
		trap enhidden d:PLAYER \
			-mask いる \
			-exec {
//				print 'ENEHIDDENENEHIDDENENEHIDDENENEHIDDENENEHIDDENENEHIDDENENEHIDDENENEHIDDENENEHIDDENENEHIDDEN'
			}
	
		//	捕まったふり監視
#if 0
		if ($f:w41a_捕まったふりバレたフラグ == d:FALSE) {
			chara プロック連続実行 捕まったふり監視人 \
				-t -1 \
				-p 捕まったふり監視
		}
#else

		@捕まったふり監視
#endif

		//	エネミーから隠れるトラップをオフにしておく
		command トラップ切り替え \
			-trap enhidden \
			-switch 0

		//	捕まったふりビハインド
		trap ky001 d:PLAYER \
			-mask いる \
			-dir 0 512 \	//	プレイヤーがこちらを向いているとき
			-exec {
				//	主観中は起動しない
				if (`command プレイヤー状態取得` & d:PFLAG_SUBJECT ) {
					return ;
				}

				//	ダンボールを装備していなかったら
				if (	($w:アイテム !=d:アイテム:ダンボール) && ($w:アイテム !=d:アイテム:ダンボールＢ) && \
						($w:アイテム !=d:アイテム:ダンボールＣ) && ($w:アイテム !=d:アイテム:ダンボールＤ) && \
						($w:アイテム !=d:アイテム:ダンボールＥ)	) {

					//	拷問直後開始時処理が終了したら
					if ($f:w41a_拷問直後開始時処理終了フラグ == d:TRUE) {
						//	捕まったふりがバレていないとき
						if ($f:w41a_捕まったふりバレたフラグ == d:FALSE) {
							//	パッドチェックを行う
							command パッドチェック \
								-status
							//	パッド上が押され続けていたら
							if ($status & d:PAD_U) {
								//	捕まったふりビハインド発動	最初の強制モーションは１回のみ
								if ($f:w41a_捕まったふりビハインドフラグ == d:FALSE) {
									eval ($f:w41a_捕まったふりビハインドフラグ = d:TRUE)
									mesg プレイヤー d:PLAYER motion \
										d:モーションリスト:behind_goumon \
										0 \
										0 \
										0 \
										( d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_INTERP) \
										-2000,-3400,1142	//	これはアタリの中なので取り扱い要注意

								//	見つからないエリアオン
									command トラップ切り替え \
										-trap enhidden \
										-switch 1
								}

							//	ループは呼び続ける。ループ回数は１だとだめ
							command 強制モーションループ回数設定 \
								-loop 2

							//	パッド上が押され続けていなかったら
							} else {
								//	捕まったふりビハインド発動が発動していた場合
								if ($f:w41a_捕まったふりビハインドフラグ == d:TRUE) {
									command パッド操作 \
										-release

									//	プレイヤーをアタリの外へ瞬間移動させる
									mesg プレイヤー d:PLAYER position \
										-2000,1042,-2500

									//	プレイヤーの強制モーションを終了する
									chara delay 強制モーションキャンセルディレイ \
										-t 1 \
										-e {
											command 強制モーションキャンセル
										}

								//	見つからないエリアオフ
									command トラップ切り替え \
										-trap enhidden \
										-switch 0
								}
							}

						//	捕まったふりがバレたとき
						} else if ($f:w41a_捕まったふりバレたフラグ == d:TRUE) {
							//	捕まったふりビハインド発動が発動していた場合
							if ($f:w41a_捕まったふりビハインドフラグ == d:TRUE) {
								command パッド操作 \
									-release

								//	プレイヤーをアタリの外へ瞬間移動させる
								mesg プレイヤー d:PLAYER position \
									-2000,1042,-2500

								//	プレイヤーの強制モーションを終了する
								chara delay 強制モーションキャンセルディレイ \
									-t 1 \
									-e {
										command 強制モーションキャンセル
									}

								//	見つからないエリアオフ
								command トラップ切り替え \
									-trap enhidden \
									-switch 0
							}
						}
					}

				}
			}

		//	捕まったふり用近景ぼかし
		chara 近景ぼかし 近景ぼかし１ \
			-plane 8 -near 1500 -far 5000


		trap ky001 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_FORCE \
			-exec {
				if ($f:w41a_拷問直後開始時処理終了フラグ == d:TRUE) {
					if ($3 == 入る) {
							//	カメラ設定
							chara カメラ設定 捕まったふりカメラ \
								-c 1 \
			//					-p -1565,1224,2326 -t -1114,-628,-3795 \
			//					-p -1565,1228,2326 -t -1114,-628,-3795 \
								-p -1572,1223,2207 -t -2062,343,-2615 \
								-a 500 \
								-i 0 0 0 0 \
								-s 1

							chara カメラ設定 捕まったふりカメラ \
								-c 1 \
			//					-p -1565,1224,2326 -t -1114,-628,-3795 \
			//					-p -1565,1228,2326 -t -1114,-628,-3795 \
								-p -1572,1223,2207 -t -2062,343,-2615 \
								-a 158 \
								-i 0 0 0 0 \
								-z d:CAMERA_INTERP_CAMERA \ // 補完カメラフラグを指定。
								-interp_time 30 \ // 補完時間を指定
								-s 1
							//	ぼかし処理
							mesg 近景ぼかし 近景ぼかし１ on
					} else {
						//	保険
						command パッド操作 \
							-release

						chara カメラ設定 捕まったふりカメラ \
							-c 1 \
							-p 1382,3,-3752 -t -1226,961,-3340 \
							-r -324,2074,0 -f 2828 \
							-a 200 \
							-i 0 0 0 0 \
							-s 1

						chara delay カメラ復帰 \
							-t 45 \
							-e {
								//	カメラを戻す
								chara カメラ設定 捕まったふりカメラ \
									-s -1
								//	ぼかし処理解除
								mesg 近景ぼかし 近景ぼかし１ off
							}

						chara delay パッド復帰 \
							-t 60 \
							-e {
								eval ($f:w41a_捕まったふりビハインドフラグ = d:FALSE)
								command パッド操作 \
									-cancel
							}

					}

				}
			}

	}

	proc 全体マップ設定 {
		//	ノードにアクセスしていたら全体マップを出す
		if ($f:w41a_ノードフラグ == 1) {
			if ($b:w41a_バグステージ名 == 0) {
				//	ここには来ないはず
				@プラント編全体マップ設定 d:アーセナルギア空腸	//	全体マップ表示
			} else if ($b:w41a_バグステージ名 == 1) {
				@プラント編全体マップ設定 d:アーセナルギア胃 	//	全体マップ表示
			} else if ($b:w41a_バグステージ名 == 2) {
				@プラント編全体マップ設定 d:青山二丁目 			//	全体マップ表示
			} else if ($b:w41a_バグステージ名 == 3) {
				@プラント編全体マップ設定 d:麻布十番 			//	全体マップ表示
			} else if ($b:w41a_バグステージ名 == 4) {
				@プラント編全体マップ設定 d:船橋市 				//	全体マップ表示
			} else if ($b:w41a_バグステージ名 == 5) {
				@プラント編全体マップ設定 d:ニューヨーク52番街 	//	全体マップ表示
			}

		//	ノードにアクセスしていない、かつw42aから戻ってきたときステージ名を表示する
		} else {
			if ($w:p_story >= d:ST:P071_01_R01拷問部屋脱出１無線機デモ１終了) {
				if ($b:w41a_バグステージ名 == 0) {
					//	ここには来ないはず
					@ポーズ時ステージ名表示設定 d:wn_アーセナルギア空腸
				} else if ($b:w41a_バグステージ名 == 1) {
					@ポーズ時ステージ名表示設定 d:wn_アーセナルギア胃
				} else if ($b:w41a_バグステージ名 == 2) {
					@ポーズ時ステージ名表示設定 d:wn_青山二丁目
				} else if ($b:w41a_バグステージ名 == 3) {
					@ポーズ時ステージ名表示設定 d:wn_麻布十番
				} else if ($b:w41a_バグステージ名 == 4) {
					@ポーズ時ステージ名表示設定 d:wn_船橋市
				} else if ($b:w41a_バグステージ名 == 5) {
					@ポーズ時ステージ名表示設定 d:wn_ニューヨーク52番街
				}
			}
		}
	}


	proc くしゃみ設定 {
		//	w42aから戻ってきたとき
		if ($w:p_story >= d:ST:P071_01_R01拷問部屋脱出１無線機デモ１終了) {
			@アーセナルくしゃみ間隔
		}
	}







// 以下仮キャラ用proc
// -----------------------------------------------------------------------------------
// 仮キャラ
// ------------------------------------
proc 水面セット {
	#if d:DEBUG_PRINT
		print 'water_set'
	#endif

	chara 頂点アニメブラー 仮水面 \
		-model w31a_sea \
		-base 10 \
		-width 1 \
		-flag 5 \
		-pos 0,0,0
}

	proc 死体歩き設定 {
		trap wa001 d:PLAYER \
			-mask いる \
			-exec {
					command プレイヤー死体歩き
			}
	}

































// 以下デバッグ専用proc
// -----------------------------------------------------------------------------------
// デバッグキャラ
// ------------------------------------
proc デバッグキャラセット {
	#if d:DEBUG_PRINT
		print 'debug_chara_set'
	#endif

	#if d:CHARA_CAMERA
		chara キャラカメラ 敵兵カメラ \
			-c d:TARGET_CHARA \
			-s -920,610,200 \
			-r -200,1024,0 
	#endif

	#if d:SCREENSHOT
		chara スクリーンショット shot
	#endif

	#if d:USB_KEY
		chara USBキーボード実行 test \
			-e d:KBD_ESC {	
				mesg プレイヤー d:PLAYER position -5500, -13000, -500
			} \
	#endif
}
