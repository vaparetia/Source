//###################################################################################
//									デモ設定
//###################################################################################

	proc ホワイトフェードポリデモスタート $:ストーリーフラグ {
		command 無線設定 -reset
		command パッド操作 -release
		command プレイヤー無敵セット
		mesg コマンダー 敵兵セット 視界オフ
		eval ( $w:p_story = $:ストーリーフラグ );
		// ポリデモのときはレーダーオフするためのフラグ
		eval($f:global_polygon_demo = 1);

		chara フェードインアウト フェードアウト \
			-c 128,128,128 128 \
			-t (d:FADEOUT_TIME*2) \
			-s 1 \
			-p フェードアウト終了
	}

	proc フェードアウト終了 {
		chara delay フェードアウト終了ディレイ \
			-t 5 \
			-p mv_w41a_d070px9_0
	}

	proc ポリデモロードスタート {
		@mv_w41a_d070px9_0
	}

	proc 無線機デモスタート $:ストーリーフラグ {
		command 無線設定 -reset
		command パッド操作 -release
		command プレイヤー無敵セット
		mesg コマンダー 敵兵セット 視界オフ
		eval ( $w:p_story = $:ストーリーフラグ );

		// ポリデモのときはレーダーオフするためのフラグ
		eval($f:global_polygon_demo = 1);

		chara フェードインアウト フェードアウト \
			-c 0,0,0 128 \
			-t d:FADEOUT_TIME \
			-p 黒フェードアウト終了

	}
	proc 黒フェードアウト終了 {
		chara delay フェードアウト終了ディレイ \
			-t 180 \
			-e {
				restart
			}
	}

	proc 主観デモ終了 {

		if ($w:p_story < d:ST:P070_13_P09ＡＧ起動１３ポリゴンデモ９開始) {
			mesg デモキャンセルチェック 主観デモキャンセル kill
			mesg シネマスクリーン シネマ フェードアウト 0
			command メニュー設定 -gage off
			mesg 簡易レイアウトプレイヤ 息我慢ボタン 再生終了 d:L2D_BREAK

			@ホワイトフェードポリデモスタート d:ST:P070_13_P09ＡＧ起動１３ポリゴンデモ９開始

		//	現在使用していない
		} else if ($w:p_story < d:ST:P070_23_R04ＡＧ起動２３無線機デモ４開始) {
			chara delay オルガ殴られディレイ \
				-t 210 \
				-e {
//					@ポリゴンデモロード d:ST:P070_23_R04ＡＧ起動２３無線機デモ４開始
					@無線機デモスタート d:ST:P070_23_R04ＡＧ起動２３無線機デモ４開始

				}

		//	ストーリーフラグがこのときは主観デモが完全に終了する
		} else if ($w:p_story ==  d:ST:P070_23_R04ＡＧ起動２３無線機デモ４終了) {
			//	プレイヤー初期位置を代入
			eval($i:プレイヤー初期Ｘ位置 = -2000) 
			eval($i:プレイヤー初期Ｚ位置 = -3400) 
			//	リスタートかけてゲームに戻る
			eval ($f:w41a_主観デモ完全終了フラグ = d:TRUE)
			eval ($s:登場ポイント = 拷問直後)
			restart -s
		}
	}


	proc 拷問起き設定 {
		//	初期角度代入
		eval ($i:w41a_拷問ベッド角度 = 512)
		//	ベッド起動
		chara delay 拷問起きディレイ \
		-t 60 \
		-e {
			chara プロック連続実行 拷問起き管理人 \
				-p 拷問起き管理 \
				-t -1
		}
	}
	proc 拷問起き管理 {
		if ($i:w41a_拷問ベッド角度 > 1) {
			eval ( $i:w41a_拷問ベッド角度 = $i:w41a_拷問ベッド角度 - 3)
			mesg 主観デモプレイヤー ライデン rotate $i:w41a_拷問ベッド角度 -1
		} else {
			mesg プロック連続実行 拷問起き管理人 kill
		}
	}

	proc 拷問開始 {
		//	ストリーム再生
		eval ( $i:STREAM_ID = `%Stream t:vc107001 -p 拷問１＿Ａ終了 -action 拷問１＿Ａプロック` )
//		eval ( $i:STREAM_ID = `%Stream t:vc107001 -p 主観デモ終了` )
		chara delay ディレイ \
			-time 1 \
			-exec{
				if ($i:STREAM_ID < 0) {
					eval ( $i:STREAM_ID = `%Stream t:vc107001 -p 拷問１＿Ａ終了 -action 拷問１＿Ａプロック` )
					return 1
				} else {
					return 0
				}
			}
	}

	proc 拷問１＿Ａ終了 {
	//	デモキャンセルが押された場合はこの処理は通らないようにする
	if ($1 == 1) {
		//	念のため
		mesg デモキャンセルチェック オルガ主観デモキャンセル kill
		return 
	}

	//	英語の場合は時間調整のためディレイをずらす
	#ifdef d:ENGLISH
		chara delay 拷問音声ディレイ \
		-t 275 \
		-e {
			eval ( $i:STREAM_ID = `%Stream t:vc107002 -p 拷問１＿Ｂ終了 -action 拷問１＿Ｂプロック` )
			chara delay ディレイ \
				-time 1 \
				-exec{
					if ($i:STREAM_ID < 0) {
						eval ( $i:STREAM_ID = `%Stream t:vc107002 -p 拷問１＿Ｂ終了 -action 拷問１＿Ｂプロック` )
						return 1
					} else {
						return 0
					}
				}
		}
	//	それ以外は
	#else
		chara delay 拷問音声ディレイ \
		-t 180 \
		-e {
			eval ( $i:STREAM_ID = `%Stream t:vc107002 -p 拷問１＿Ｂ終了 -action 拷問１＿Ｂプロック` )
			chara delay ディレイ \
				-time 1 \
				-exec{
					if ($i:STREAM_ID < 0) {
						eval ( $i:STREAM_ID = `%Stream t:vc107002 -p 拷問１＿Ｂ終了 -action 拷問１＿Ｂプロック` )
						return 1
					} else {
						return 0
					}
				}
		}
	#endif
	}

	proc 拷問１＿Ｂ終了 {
		//	デモキャンセルが押された場合はこの処理は通らないようにする
		if ($1 == 1) {
			//	念のため
			mesg デモキャンセルチェック オルガ主観デモキャンセル kill
			return 
		}

		chara delay 拷問音声ディレイ \
		-t 60 \
		-e {
			eval ( $i:STREAM_ID = `%Stream t:vc107003 -p 拷問１＿Ｃ終了 -action 拷問１＿Ｃプロック` )
			chara delay ディレイ \
				-time 1 \
				-exec{
					if ($i:STREAM_ID < 0) {
						eval ( $i:STREAM_ID = `%Stream t:vc107003 -p 拷問１＿Ｃ終了 -action 拷問１＿Ｃプロック` )
						return 1
					} else {
						return 0
					}
				}
		}
	}
