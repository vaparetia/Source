// 各種スイッチ用define
// ------------------------------------
// サウンド
#define		SOUND			1		// サウンドデータは最初に呼ぶ
#define		BGM				1		// BGMは敵兵コマンダーの後に呼ぶ
// デモ
#define		DEMO			0
// ノード端末
#define		NODE			1
// キャラクター関係
#define		RAIDEN			1		// SNAKEとは排他
#define		SNAKE			0
#define		ENEMY			1		// コマンダーと警備兵(敵を出すときは必須)
#define		SUPPORT			0		// サポート兵
#define		ATTACKER		1		// 攻撃兵
#define		SHIELD			0		// 盾兵(1) or 通常攻撃兵(0)
// ドア
#define		WT_DOOR			0		// 水密ドア
#define		SLIDE_DOOR		1		// スライドドア
// 入出トラップ
#define		LOAD_TRAP		1
#define		STAGE_END		1		// ステージ終了時処理を使用可にする
// フォグ
#define		FOG				1
// エフェクト関係
#define		EFFECT			0		// エフェクト全般
#define		BLUR			0		// ブラー
#define		Z_MANAGER		0		// Ｚフォーカス管理(敵のライト等で仕様)
#define		BODY_SHADOW		0		// 敵のライトによって出る影

// 子画面
#define		SUB_CAMERA		0
// カメラ関係
#define		CLEAR_CAMERA	0		// クリアリング専用カメラ(要子画面)

// 天井
#define		CHARA_CEIL		1		// 天井君
// 透明壁
#define		TR_WALL			0		// シナリオ置きの透明壁
// ライト関係
#define		SPOT_LIGHT		0		// スポットライト
#define		CHARA_LIGHT		1		// キャラ専用ライト
// オブジェ関係
#define		LOCKER			1		// ロッカー
// アイテム
#define		ITEM			1

// デバッグ関係
#ifdef	d:FIX_MODE
	#define		DEBUG_CHARA		0		// デバッグキャラ全体(FIX時は0)
#else
	#define		DEBUG_CHARA		0		// デバッグキャラ全体
#endif
#define		CHARA_CAMERA	0		// キャラ追従カメラ
#define		TARGET_CHARA	敵兵:01	// キャラ追従カメラのターゲット
#define		SCREENSHOT		0		// スクリーンショット
#define		USB_KEY			0		// USBキーボード


// 各種設定用define
// ------------------------------------
//	マップ関係
//	アタリ
#define		HZX_NAME			w41a


#define		KMS_NAME0			w41a			//	本体
#define		KMS_NAME1			w41a_corridor	//	廊下


//	ドア
#define		DOOR_NAME			w41a_cell_sdr		//	独房用
#define		DOOR_NAME2			w41a_cell_sdr_02	//	右ドア用
#define		DOOR_NAME_LOAD		w01f_dr			// 	ロード用使ってない
#define		DOOR_NAME_LOAD1A	w41a_dr_left	// 	ロード用
#define		DOOR_NAME_LOAD1B	w41a_dr_right	// 	ロード用

//	天井君で置くもの
#define		CEIL_NAME0			w41a_ar			//	屋根

//	プットオブジェで置くもの
#define		KMS_NAME2			w42a_dummy		//	ロードエリア

#define		KMS_NAME3			dr_lamp_cor_off	//	廊下西ドアランプ赤
#define		KMS_NAME4			dr_lamp_cor_on 	//	廊下西ドアランプ青
#define		KMS_NAME5			dr_lamp_cel_off	//	独房ドアランプ赤

#define		CAN					w41a_kan		//	缶
#define		STRAW				w41a_kan_st		//	ストロー
#define		BED					w41a_goumon		//	拷問ベッド

#define		LT2_NAME			w41a


//	キャラクター関係
#if d:RAIDEN
	#define		PLAYER		ライデン
#else
	#define		PLAYER		スネーク
#endif

//	強制モーション

//	薬莢系
#define			ENE_TNG				1	//	天狗兵

//	ステージ系
#define			STAGE_W41A			1

#define			STAGE_PLANT			1	//	プラント編

#define			POLYDEMO_LOAD		1

// ローカル変数
//	$f:w41a_捕まったふりビハインドフラグ	捕まったふりをしているかどうか
//	$f:w41a_主観デモフラグ					主観デモかどうか
//	$f:w41a_主観デモ完全終了フラグ			主観デモ関連がすべて終了したかどうか
//	$i:w41a_拷問ベッド角度					拷問ベッドの角度
//	$f:w41a_拷問直後開始時処理終了フラグ	拷問直後開始時処理が終了したかどうか

//	$b:w41a_バグステージ名				//	バグったときのステージ名表記用
										//	0	wn_アーセナルギア空腸
										//	1	wn_アーセナルギア胃
										//	2	wn_青山二丁目
										//	3	wn_麻布十番
										//	4	wn_船橋市
										//	5	wn_ニューヨーク52番街

//	$b:w41a_風邪薬フラグ				//	風邪薬をとったかどうか
//	$f:w41a_ロッカー内フラグ			//	プレイヤーがロッカー内にいるかどうか
//	$f:w41a_捕まったふりバレたフラグ	//	捕まったふりがバレたかどうか
//	$f:w41a_ドアランプフラグ			//	ドアランプ点滅用フラグ
//	$f:w41a_拷問機左側引っかかったフラグ	主観デモＳＥ用
//	$f:w41a_拷問機右側引っかかったフラグ	主観デモＳＥ用

//	$f:w41a_ロッカーに敵入れたフラグ	//	裸のため死体引き摺り出来ないので必要ないはずだが念のため

// ステージ固有モーションリスト
// ------------------------------------
enum ソリダスモーションリスト {
	sol_idle = 0,
	sol_walk,
	sol_breath1,
	sol_glare,
	sol_snakehand,
	sol_breath2
}
enum オセロットモーションリスト {
	rev_idle = 0,
	rev_breath1,
	rev_walk,
	rev_snakehand,
	rev_breath2
}
enum オルガモーションリスト {
	org_idle = 0,
	org_talk,
	org_punch
}

#include "rai_w41a.mh"


// include
// ------------------------------------
#include "stdch.h"
#include "sload.h"
#include "sound.h"
#include "enevoice.h"
#include "item_info.h"
#include "commdef.h"

#if d:USB_KEY
	#include "usbkbd.h"
#endif

#include "w41a_d_common.h"	//	デモ／ゲーム共通プロック
#include "node_res.h"


// マップ設定
// ------------------------------------
chara マップ 拷問部屋	-k	d:KMS_NAME0 \
						-k	d:KMS_NAME1	\
						-h 	d:HZX_NAME,0 -l d:LT2_NAME

//	デバッグ用
/*
	if ($w:p_story < d:ST:P070_21_P12ＡＧ起動２１ポリゴンデモ１２終了) {
		eval($w:p_story = d:ST:P070_21_P12ＡＧ起動２１ポリゴンデモ１２終了)
	}
*/
command マップ設定 拷問部屋 -set {

	#if d:SOUND	
	@サウンド設定	// データは最初に呼ぶ
	#endif

	//	ノードアクセス関連
	@レーダーオンオフチェック $f:w41a_ノードフラグ
	@常駐キャラ設定
	command	プレイヤーパッド設定 //プレイヤーのパッドタイプを設定する(実質ＸＢＯＸ版のみに意味があるがＰＳ２であってもＯＫ)

	@ローカル変数初期化
	#if d:NODE
	@ノード端末設定 2048
//	@ノードディスプレイ設定		//	ノード設定の中でまとめられた
	#endif
	@設定値変更
	@プラグイン設定
	@プレイヤー設定
	#if d:ENEMY
	@コマンダー設定
	#endif
	#if d:BGM	
	@ＢＧＭ設定	// プレイヤー→敵兵→BGMの順で呼ぶ
	#endif
	#if d:SLIDE_DOOR
	@ドア設置
	@主観禁止壁設定
	#endif
	#if d:LOAD_TRAP
	@ロード設定
	#endif
	@オブジェクト設定
	@拷問台設定
	#if d:CHARA_CEIL
	@天井設定
	#endif
	#if d:LOCKER
	@ロッカー設定
	# endif
	@監視カメラ設定

	#if d:ITEM
	@アイテム設定
	#endif
	#if d:FOG
	@フォグ設定
	#endif
	#if d:EFFECT
	@エフェクト設定
	#endif
	@映り込み設定

	@カメラセット
	@拷問部屋カメラ設定
	@子画面設定

	@捕まったふり設定

	@主観デモ設定

	@影設定
//	@死体歩き設定
	#if d:CHARA_LIGHT
	@キャラ用ライト設定		// マップ設定の最後に呼ぶ
	#endif
	@全体マップ設定

	#if d:DEBUG_CHARA
	//	@デバッグキャラセット
	#endif

	@シナリオデモキャラセット
}

// 無線用include ※位置は動かさないこと
#include "w41a_cdc.ch"

#include "p_force_cdc.ch"


//初期マップの表示
command マップ表示 	-add 拷問部屋

// 全てのセットが終わったところでフェードイン
@拷問部屋開始時処理



//###################################################################################
//									各proc設定
//###################################################################################



//###################################################################################
//									全マップ共通
//###################################################################################

	proc サウンド設定 {
		#if d:DEBUG_PRINT 
			print 'sound_set'
		#endif

		if ($w:p_story < d:ST:P071_01_R01拷問部屋脱出１無線機デモ１終了) {
			chara サウンドマネージャー ＳＤマネ -pak 0
		} else {
			chara サウンドマネージャー ＳＤマネ -pak 1
		}


		@サウンド効果音設定
		command 弾痕ノーマル -n 0
		command 弾痕ノーマル -n 1
		command 弾痕ノーマル -n 3

		command 跳弾ノーマル -n 0
		command 跳弾ノーマル -n 1
		command 跳弾ノーマル -n 3
	}

	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT 
			print 'localvar_init'
		#endif

		eval ($f:w41a_捕まったふりビハインドフラグ = d:FALSE)

		if ($f:w41a_主観デモ完全終了フラグ == d:FALSE) {
			eval ($f:w41a_主観デモフラグ = d:TRUE)
		} else {
			eval ($f:w41a_主観デモフラグ = d:FALSE)
		}

		eval ($f:w41a_捕まったふりバレたフラグ = d:FALSE)
		eval ($f:w41a_ドアランプフラグ = d:FALSE)

		eval ($f:w41a_拷問機左側引っかかったフラグ = d:FALSE)
		eval ($f:w41a_拷問機右側引っかかったフラグ = d:FALSE)

		//	必要ないはずだが念のため
		eval ($f:w41a_ロッカーに敵入れたフラグ = d:FALSE)
	}

	proc 設定値変更 {
		#if d:DEBUG_PRINT 
			print 'status_set'
		#endif
	}

	proc ノード接続時プロック {
		#if d:DEBUG_PRINT
			print 'node_set'
		#endif

	// 必ず必要。フラグの初期化はvarinit.hですでに行っています。
		eval($f:ノードフラグ = $f:w41a_ノードフラグ);
	}

	// 接続したフラグをたてたりする
	proc ノード接続後プロック {
		#if d:DEBUG_PRINT
			print 'node_event_go'
		#endif

		if ($f:w41a_ノードフラグ == 0) {
			//	ノードにアクセスしたら全体マップが出るのでポーズ時ステージ名表示は殺す
			mesg ２Ｄスプライト表示＿ポーズ ポーズ時マップネーム表示 kill
			@プラント編全体マップ設定 d:アーセナルギア胃 	//	全体マップ表示
		}
		eval($f:w41a_ノードフラグ = 1);
		command メニュー設定 -node_access on 
	print '#################################################################################SKOBA'

/*
		chara フェードインアウト フェードアウト \
			-c 0,0,0 128 \
			-t 1 \
			-p ノードアクセス終了
*/
	}

	proc ノードアクセス終了 {
			eval ($i:プレイヤー初期Ｘ位置 = $i:プレイヤー位置Ｘ)
			eval ($i:プレイヤー初期Ｙ位置 = $i:プレイヤー位置Ｙ)
			eval ($i:プレイヤー初期Ｚ位置 = $i:プレイヤー位置Ｚ)
			eval ($i:プレイヤー初期方向 = $w:プレイヤー方向)
			eval ($s:登場ポイント = ノードアクセス後)
			restart
	}

	proc ノードディスプレイ設定 {
		chara ノード端末ディスプレイ NewNodeLamp \
			-r 0 \
			-p 5650 0 -8500
	}


	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif
		//	風邪用
		command プラグインくしゃみ

	}



//###################################################################################
//									 プレイヤー
//###################################################################################

	proc プレイヤー設定 {
		#if d:DEBUG_PRINT
			print 'player_set'
		#endif

		//	主観デモ中はプレイヤー起動だめ！
		if ($f:w41a_主観デモフラグ == d:FALSE) {
			#if d:RAIDEN

				//	裸モード
				command はだかモードセット

				print 'PLAYERPLAYERPLAYERPLAYERPLAYERPLAYERPLAYERPLAYERPLAYERPLAYERPLAYERPLAYERPLAYERPLAYER'
				chara プレイヤー d:PLAYER \
					-p $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,$i:プレイヤー初期Ｚ位置 \
					-d 0,$i:プレイヤー初期方向,0 \
					-s 0 \
//					-m rai_def -a raiden \
					-m rai_naked_sh -a raiden \
					-o rai_w41a \
					-f d:PLY_NO_FOOT_SHADOW

				//	髪の毛
				@ライデン髪の毛設定 d:NORMAL_HAIR

			#else if d:SNAKE
				chara プレイヤー d:PLAYER \
					-p $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,$i:プレイヤー初期Ｚ位置 \
//					-p -18000, -46000, 23000 \
					-d 0,$i:プレイヤー初期方向,0 \
					-s 0 \
					-m sna_def -a snake -o rai_common

					//バンダナ
					chara ロープモデル３ バンダナ１ \
						-n sna_bdn1 \
						-d 1 \
						-y スネーク \
						-z 12 \
						-x 0,60,-90 \
						-m 12 \
						-p 250 \
						-k 350 \
						-o 110 \
						-f 1

					chara ロープモデル３ バンダナ２ \
						-n sna_bdn2 \
						-d 1 \
						-y スネーク \
						-z 12 \
						-x 0,50,-90 \
						-m 22 \
						-p 250 \
						-k 350 \
						-o 110 \
						-f 1
			#endif
		}
	}

//###################################################################################
//								敵兵
//###################################################################################

//	敵兵配置

//	基本セット
	proc 天狗兵セット {
		@天狗兵０
	}


//	コマンダーセット
	proc 天狗兵コマンダー {
		chara 天狗兵コマンダー tng_com \
			-e { 天狗兵セット } \
			-type 0 \
			-avoid -1000,0,-2000 300
	}

	//	コマンダー
	//	司令官音声

	resource ghq_caution_voice {
	w41a:
		$t{
			t:vc040601,	//	指揮官　　「了解、総員、警戒を強化せよ」
			-2,
			t:vc049066,	//	指揮官　　「どうしたんだ？」
			-1
		}
	}

	proc コマンダー設定 {
		//	主観デモ中はコマンダ起動だめ！
		if ($f:w41a_主観デモフラグ == d:FALSE) {
			#if d:DEBUG_PRINT
				print 'commander_set'
			#endif

			chara コマンダー 敵兵セット \
				-a 天狗兵コマンダー \
				-r 7000,0,-11000 拷問部屋 7000,0,-1500 拷問部屋 \
				-c 7000,0,-11000 拷問部屋 \
				-p 0,-1,-1 拷問部屋クリアリング設定 \
/*
				-j	0 1 1 t:vc045071 t:vc045071_len \
					0 1 2 t:vc045072 t:vc045072_len \
					0 1 4 t:vc045073 t:vc045073_len \
*/
				-j	0 1 1 t:vc045072 t:vc045072_len \
					0 1 2 t:vc045071 t:vc045071_len \
					0 1 4 t:vc045073 t:vc045073_len \

				-v [ene_plant_voice:04] \
				-y [ghq_caution_voice:w41a] \
				-z $i:敵標準麻酔持続 \
				-o $i:敵標準気絶持続 \
				-b $w:敵標準再発生数 \
				-s d:ENE_STAGE_GPS \
				-m $w:スタートアラートモード \
				-h $i:標準警戒時間		// 警戒時間

		}
	}



//	敵兵配置０

	proc 天狗兵０ {
		chara 天狗兵Ａ 敵兵:61 \
		-r 5 \
		-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
		-l $w:敵標準体力 -h $w:敵標準聴力 -f $w:敵標準気絶
	}



//###################################################################################
//								クリアリング
//###################################################################################

	proc 拷問部屋クリアリング設定 {
		command セットクリアリング \
			-p	-1,-1,-1 クリアリングカメラ設定 \
				0,0,0 クリアリングカメラ０ \
				0,0,2 クリアリングカメラ１ \
				0,0,4 クリアリングルート変更 \
				0,0,5 クリアリングカメラ２ \
				0,0,7 クリアリングカメラ３ \

				0,1,0 クリアリングカメラオフ \
				-2,-2,-2,クリアリングカメラオフ \
			-i 0
	}

	proc クリアリングカメラ設定 {

	}

	proc クリアリングカメラ０ {
		chara カメラ設定 クリアリングカメラ \
			-c 1 \
			-p 4784,3595,-4157 -t 7009,1464,-6697 \
			-r 367,1579,0 -f 3993 \
			-a 139 \
			-i 0 0 0 0 \
			-s 1

		command カメラマップ設定 -chanl 1 -map 拷問部屋
		mesg サブ画面 子画面 on

	}

