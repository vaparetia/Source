					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN 3672,d:CAM_MAX,d:CAM_MAX \
					-r 202,0,0 -f 2751 \
					-a 200 \
					-i 2 1 0 0 \
					-s $3 \
					-z (d:CAMERA_NO_CUSHION | d:CAMERA_NO_PAD_ADJUST)
			}

		trap bh002 d:PLAYER \
			-mask ？ \
			-state 8 \	//張り付き
			-dir 2048 256 \	// 方向指定
			-camera \
			-exec {
				chara カメラ設定 張り付きカメラ \
					-c 0 \	
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 97,0,0 -f 1516 \
					-a 200 \
					-i 2 1 0 0 \
					-s $3 \
					-z (d:CAMERA_NO_CUSHION | d:CAMERA_NO_PAD_ADJUST)
			}











	}


