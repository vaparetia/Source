	proc クリアリングルート変更 {
/*
		chara delay カメラオフディレイ \
			-t 120 \
			-p	クリアリングカメラオフ
*/
		print 'SSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSSS'
		if ($f:w41a_捕まったふりビハインドフラグ == d:TRUE) {
		print 'CHANGE-CHANGE-CHANGE-CHANGE-CHANGE-CHANGE-CHANGE-CHANGE-CHANGE-CHANGE'
			command チェンジクリアリングルート \
				敵兵:61 -r 1 -p 0
		}
	}

	proc クリアリングカメラオフ {
//		mesg delay カメラオフディレイ kill
		mesg サブ画面 子画面 off
		chara カメラ設定 クリアリングカメラ -s 0
	}



	proc 子画面設定 {
		chara サブ画面 子画面 \
			-w (512-d:SUB_MARGIN-d:SUB_WIDTH),d:SUB_MARGIN (512-d:SUB_MARGIN),(d:SUB_HEIGHT+d:SUB_MARGIN)
	}


