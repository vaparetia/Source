	proc 主観禁止壁設定 {

		@主観禁止壁 廊下東ドア壁 10625,0,-8000 3072 1500
		@主観禁止床 廊下東ドア床１ 廊下東ドア床２ 10625,0,-8000 3072 1500

		trap dr001 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_SUBJECT \
			-exec {
				if( $3 == 入る ) {
					mesg 透明壁 廊下東ドア壁 on
				} else {
					mesg 透明壁 廊下東ドア壁 off
				}
			}

		trap dr002 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_SUBJECT \
			-exec {
				if( $3 == 入る ) {
					mesg 透明壁 Ｄ脚ドア壁 on
				} else {
					mesg 透明壁 Ｄ脚ドア壁 off
				}
			}



	
	}



//###################################################################################
//									開始時処理
//###################################################################################

	proc 拷問部屋開始時処理 {
		if( $s:登場ポイント == sp_w24d_w41a_0 ) {
			//	シェル１中央棟Ｂ３から
//			@ステージ開始時処理 d:LOAD_TYPE:NO_MOVE_TYPE エレベーター 0 d:M_TYPE:WALK_CHANGE
			@拷問開始時処理
		} else if ( $s:登場ポイント == sp_w42a_w41a_0 ) {
			print '$b:w41a_バグステージ名'$b:w41a_バグステージ名
			//	アーセナルギア通路Ａから
			if ($b:w41a_バグステージ名 == 1) {
				@ステージ開始時処理（ステージ名表示） \
				d:LOAD_TYPE:SL_DOOR_TYPE 廊下東ドア 2500 d:DEFAULT_M_TYPE \
				d:wn_アーセナルギア胃
			} else if ($b:w41a_バグステージ名 == 2) {
				@ステージ開始時処理（ステージ名表示） \
				d:LOAD_TYPE:SL_DOOR_TYPE 廊下東ドア 2500 d:DEFAULT_M_TYPE \
				d:wn_青山二丁目
			} else if ($b:w41a_バグステージ名 == 3) {
				@ステージ開始時処理（ステージ名表示） \
				d:LOAD_TYPE:SL_DOOR_TYPE 廊下東ドア 2500 d:DEFAULT_M_TYPE \
				d:wn_麻布十番
			} else if ($b:w41a_バグステージ名 == 4) {
				@ステージ開始時処理（ステージ名表示） \
				d:LOAD_TYPE:SL_DOOR_TYPE 廊下東ドア 2500 d:DEFAULT_M_TYPE \
				d:wn_船橋市
			} else if ($b:w41a_バグステージ名 == 5) {
				@ステージ開始時処理（ステージ名表示） \
				d:LOAD_TYPE:SL_DOOR_TYPE 廊下東ドア 2500 d:DEFAULT_M_TYPE \
				d:wn_ニューヨーク52番街
			} else {
				//	バグだよここにくるのは
				@ステージ開始時処理（ステージ名表示） \
				d:LOAD_TYPE:SL_DOOR_TYPE 廊下東ドア 2500 d:DEFAULT_M_TYPE \
				d:wn_アーセナルギア胃
			}
			//	ロード時カメラ
			@ロード時カメラ設定
		} else if ( $s:登場ポイント == 拷問直後 ) {
			//	デモ直後から
			@拷問直後開始時処理
		} else if ( $s:登場ポイント == ノードアクセス後 ){
			//	ノードアクセス後
			@ステージ開始時処理 d:LOAD_TYPE:NO_MOVE_TYPE エレベーター 0 d:M_TYPE:WALK_CHANGE
		}
	}

	//	拷問時のステージ開始時は特殊
	proc 拷問開始時処理 {
		@特殊装備解除

		// パッド操作を奪う(無線やポーズも不許可にする)
		command パッド操作 -release
		command メニュー設定 -radio off -pause off
		// フェードインスタート

		//	シェル１中央棟Ｂ３から
		if ($w:p_story < d:ST:P070_11_M02ＡＧ起動１１ムービーデモ２開始) {
			chara フェードインアウト フェードイン \
				-i 0,0,0 128 \
				-c 0,0,0 0 \
				-t (d:FADEIN_TIME*2)
		} else {
			chara フェードインアウト フェードイン \
				-i 0,0,0 128 \
				-c 0,0,0 0 \
				-t d:FADEIN_TIME
		}
		chara delay パッドディレイ \
			-time (d:FADEIN_TIME*2) \
			-e {
				//	無線とポーズは不許可のまま
				command パッド操作 -cancel
				eval($f:ロードチェックＯＮフラグ = 1);
			}
	}
	//	拷問終了直後のステージ開始時は特殊
	proc 拷問直後開始時処理 {
	#if d:DEBUG_PRINT 
		print 'stage_start'
	#endif

		//	ＢＧＭを鳴らす
		command セットサウンドコード -c d:SNG_PLAY_05
		//	ポーズ時ステージ表示を入れる
		@ポーズ時ステージ名表示設定 d:wn_アーセナルギア胃

		//	シナリオデモ開始処理を行う
		command シナリオデモ開始
		command 無線設定 -reset
		command メニュー設定 -menu off -gage off -radar off -subwin off
		mesg シネマスクリーン シネマ フェードアウト 1
		command パッド操作 -release
		command プレイヤー無敵セット
		mesg コマンダー 敵兵セット 視界オフ
		@特殊装備解除


		//	捕まった状態から始める
		mesg プレイヤー d:PLAYER motion \
//			d:モーションリスト:behind_goumon \
			d:モーションリスト:escape_goumon \
				0 \
				0 \
				0 \
				( d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_INTERP) \
//				( d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR ) \
//				-2000,-3400		//	モーションが修正されたらこちら
				-2000,-3250

		command	強制モーション終了プロック \
				-motion d:モーションリスト:escape_goumon \
				-proc 拷問直後開始時処理終了
//				-proc 拷問直後歩き処理
		
		//	強制モーション用カメラ
		chara カメラ設定 シナリオカメラ \
			-c 1 \
			-p -912,515,582 -t -2011,1571,-3274 \
			-r 3928,2229,0 -f 4146 \
			-a 465 \
			-i 0 -1 0 0 \
			-s 1

		chara delay シナリオカメラディレイ \
			-t 300 \
			-e {
				chara カメラ設定 シナリオカメラ \
					-c 1 \
					-p 1382,3,-3752 -t -1226,961,-3340 \
					-r -324,2074,0 -f 2828 \
					-a 200 \
					-i 0 -1 0 0 \
					-s 1
			}
	}

	proc 拷問直後開始時処理終了 {
		chara カメラ設定 シナリオカメラ \
			-s -1
//		mesg プレイヤー d:PLAYER position \
//			-2000,$i:プレイヤー位置Ｙ,-2400

		//	シナリオデモ終了処理を行う
		@シナリオデモ終了処理
		chara delay ゲーム復帰ディレイ \
			-t d:C_FADE_TIME \
			-e {
			command パッド操作 -cancel
			command メニュー設定 -radio on -pause on
			eval ($f:ロードチェックＯＮフラグ = 1)
			eval ($f:w41a_拷問直後開始時処理終了フラグ = d:TRUE)
		}

		//	風邪をひく
		if($w:風邪状態 == 0) {
		print '#######################################COLD_START'
			eval ( $i:風邪引きカウンタ = 0 )
			command プレイヤー風邪引かせ \
				-time 120	//	$i:くしゃみ間隔（秒）

			//	くしゃみ間隔セット
			@アーセナルくしゃみ間隔
		}
	}





//###################################################################################
//									ロード設定
//###################################################################################

	proc バグステージ名設定 {

		// バグステージ名の決定
		if($b:w41a_バグステージ名 < 2) {
			command rand 4
			eval($b:w41a_バグステージ名 = ($status + 2))
		} else {
			command rand 3
			if($b:w41a_バグステージ名 > ($status + 2)) {
				eval($b:w41a_バグステージ名 = ($status + 2))
			} else {
				eval($b:w41a_バグステージ名 = ($status + 3))
			}
		}

	}

	proc ロードプロック {
		#if d:DEBUG_PRINT 
			print 'load_proc'
		#endif

		if ($s:呼び出しプロック == mv_w41a_w42a_0) {
			// アーセナルギア通路Ａへ
			@mv_w41a_w42a_0
		}
	}

	proc ロード設定 {
		#if d:DEBUG_PRINT 
			print 'load_set'
		#endif

		trap ld001 d:PLAYER \
			-mask 入る \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 1 ) {
					//	初めてここを出るときは
					if ($w:p_story < d:ST:P071_01_R01拷問部屋脱出１無線機デモ１終了) {

						//	ＢＧＭをフェードアウト
						command セットサウンドコード -c d:SNG_FOUTS_S

						// アーセナルギア通路Ａへ
						eval ($b:w41a_バグステージ名 = 0)
						@ステージ終了時処理（ステージ名表示）\
						12250 0 -7250 1024 mv_w41a_w42a_0 d:DEFAULT_M_TYPE \
						d:wn_アーセナルギア空腸

					//	２回目以降は
					} else {
						// アーセナルギア通路Ａへ
						@バグステージ名設定
						if ($b:w41a_バグステージ名 == 2) {
							@ステージ終了時処理（ステージ名表示）\
							12250 0 -7250 1024 mv_w41a_w42a_0 d:DEFAULT_M_TYPE \
							d:wn_青山二丁目
						} else if ($b:w41a_バグステージ名 == 3) {
							@ステージ終了時処理（ステージ名表示）\
							12250 0 -7250 1024 mv_w41a_w42a_0 d:DEFAULT_M_TYPE \
							d:wn_麻布十番
						} else if ($b:w41a_バグステージ名 == 4) {
							@ステージ終了時処理（ステージ名表示）\
							12250 0 -7250 1024 mv_w41a_w42a_0 d:DEFAULT_M_TYPE \
							d:wn_船橋市
						} else if ($b:w41a_バグステージ名 == 5) {
							@ステージ終了時処理（ステージ名表示）\
							12250 0 -7250 1024 mv_w41a_w42a_0 d:DEFAULT_M_TYPE \
							d:wn_ニューヨーク52番街
						}
					}
					//	ロード時カメラ
					@ロード時カメラ設定
					//	先読み
					preseek 'w42a'
				}
			}
	}

	proc ロード時カメラ設定 {
		chara カメラ設定 ロードカメラ \
						-c 1 \	
						-p 8070,3871,-4382 \
						-t 9649,1539,-7219 \
						-a 200 \
						-i 0 1 0 0 \
						-s 1

		chara プロック連続実行 カメラ戻し管理人 \
			-proc カメラ戻し管理
	}

	proc カメラ戻し管理 {
		command パッドチェック \
			-no_use
		if ($status != 1) {
			chara カメラ設定 ロードカメラ \
				-s -1
			mesg プロック連続実行 カメラ戻し管理人 kill
		}
	}


//###################################################################################
//									オブジェクト
//###################################################################################

#if 0
	//	w41a_d_common.h内に記述
	proc オブジェクト設定 {
		//	股間隠し系
		chara プットオブジェ コーラ -m d:CAN \
			-r 0,0,0 \
			-p -1500,1000,1950  -l d:LT2_NAME \
			-s 100,100,100
		chara プットオブジェ ストロー -m d:STRAW \
			-r 0,512,0 \
//			-p (-1500-25),(1000+160),1950  -l d:LT2_NAME \
			-p (-1490),1120,1970  -l d:LT2_NAME \
			-s 100,100,100

		//	主観デモ中は邪魔になるので拷問ベッドオフ
		if ($f:w41a_主観デモフラグ == d:FALSE) {
			chara プットオブジェ 拷問ベッド -m d:BED \
				-r 0,0,0 \
				-p 0,0,0  -l d:LT2_NAME \
				-s 100,100,100
		}

		//	ロードエリア
		chara プットオブジェ 拷問部屋ロードエリア \
			-m 	d:KMS_NAME2 -r 0 0 0 -p 0 0 0  -l d:LT2_NAME
		mesg プットオブジェ 拷問部屋ロードエリア off

		//	ドアランプ
		//	廊下西ドアランプ
		chara プットオブジェ 廊下西ドアランプ赤 \
			-m 	d:KMS_NAME3 -r 0 0 0 -p 0 0 0  -l d:LT2_NAME

		chara プットオブジェ 廊下西ドアランプ青 \
			-m 	d:KMS_NAME4 -r 0 0 0 -p 0 0 0  -l d:LT2_NAME
			mesg プットオブジェ 廊下西ドアランプ青 off

		//	独房ドアランプ
		chara プットオブジェ 独房ドアランプ赤 \
			-m 	d:KMS_NAME5 -r 0 0 0 -p 0 0 0  -l d:LT2_NAME

	}
#endif

	proc 拷問台設定 {
		//	主観デモ中は邪魔になるので拷問ベッドオフ
		if ($f:w41a_主観デモフラグ == d:FALSE) {
			chara プットオブジェ 拷問ベッド -m d:BED \
				-r 0,0,0 \
				-p 0,0,0  -l d:LT2_NAME \
				-s 100,100,100
		}
	
	}

/*
	//	w41a_d_common.h内に記述
	proc 天井設定 {
		#if d:DEBUG_PRINT
			print 'w41a_ceil_set'
		#endif

		chara 天井君 拷問部屋天井 -m d:CEIL_NAME0 -h 4000 -p 0,0,0 -l d:LT2_NAME
	}
*/

	proc ロッカーチェック $:番号 {
		@壊れ物再セットチェック $i:w41a_ロッカーロード回数[$:番号]
		if($f:再セットフラグ) {
			eval($i:w41a_ロッカー状態[$:番号] = 0)
		}
	}

	proc ロッカー状態保存 $:番号 $:行動 $:ロッカー名 {
		if(($:行動 != 6) && ($:行動 != 8)) {
			// 状態変化時
			eval($i:w41a_ロッカーロード回数[$:番号] = $w:グローバルロード回数);
		} else if($:行動 == 8) {
			// ステージ終了時
			command ロッカー状態 -n $:ロッカー名
			eval($i:w41a_ロッカー状態[$:番号] = $status)
		}
	}


	proc ロッカー設定 {
		#if d:DEBUG_PRINT
			print 'w11a0_locker_set'
		#endif

		chara ロッカー管理 管理人さん -n 1
		command ロッカーモーション -motion locker
		command プレイヤーロッカーモーション -motion rai_n_locker

		@ロッカーチェック 0
		chara ロッカー ロッカー１ \
			-kms neo_locker_door \
			-p 2950, 0,-6900 \
			-r 0,0,0 \
			-s 0 \
			-flag 0x0001 \
			-seno 1 \
			-sefloor 1 \
			-load_state $i:w41a_ロッカー状態[0]  \
			-exec {
				@ロッカー状態保存 0 $3 $4
				//	必要ないはずだが念のため
				//	敵が中にいるときドアを（壊して）開けたら
				if ( ($3 == 0) || ($3 == 4) ) {
					if ($f:w41a_ロッカーに敵入れたフラグ == d:TRUE) {
						eval ($f:w41a_ロッカーに敵入れたフラグ = d:FALSE)
					}
				//	敵を中に入れたら
				} else if ($3 == 5) {
					if ($f:w41a_ロッカーに敵入れたフラグ == d:FALSE) {
						eval ($f:w41a_ロッカーに敵入れたフラグ = d:TRUE)
					}
				}
			}

		trap lk001 d:PLAYER \
			-and \
			-mask いる \
			-state 0,4 \
			-dir 2048,512 0,512 \
			-button d:ACTION_BUTTON,-1 \
			-exec {
				command ロッカー状態 -n ロッカー１
				mesg プレイヤー d:PLAYER locker ロッカー１ $status 2048 512 2950,-6900
			}


		//	ロッカー手前
		trap lk002 d:PLAYER \
			-mask ？ \
			-state 6 \			//強制モーション中
			-camera \			//カメラトラップであることを明示
			-exec {
				if ($3 == 入る) {
					if ( ($w:プレイヤー方向 >= 1024) && ($w:プレイヤー方向 <= 3072) ) {
						chara カメラ設定 モーションカメラ \
							-c 1 \
							-p 3341,5092,-5244 -t 2939,2257,-6127 \
							-r 809,2326,0 -f 2996 \
							-a 200 \
							-i 0 2 0 0 \
							-s $3
					} else {
						chara カメラ設定 モーションカメラ \
							-c 1 \
//							-p 1357,1308,-2331 -t 2402,1161,-5129 \
							-p 1157,1308,-2331 -t 2402,1161,-5129 \
							-r 32,1815,0 -f 2990 \
							-a 200 \
							-i 0 0 0 0 \
							-s 1
						chara delay モーションカメラディレイ \
							-t 45 \
							-e {
								chara カメラ設定 モーションカメラ \
									-c 1 \
									-p 3341,5092,-5244 -t 2939,2257,-6127 \
									-r 809,2326,0 -f 2996 \
									-a 200 \
									-i 0 2 0 0 \
									-s 1
							}
					}
				} else {
					chara カメラ設定 モーションカメラ \
						-s $3
				}
			}
		trap lk002 d:PLAYER \
			-mask 出る \
			-exec {
				if ($f:w41a_ロッカー内フラグ == d:TRUE) {
					eval ($f:w41a_ロッカー内フラグ = d:FALSE)
				}
			}

		//	ロッカー内
		trap lk003 d:PLAYER \
			-mask ？ \
			-state 6 \			//強制モーション中
			-camera \			//カメラトラップであることを明示
			-exec {
				//	必要ないはずだが念のため
				//	敵を中に入れているときは
				if ($f:w41a_ロッカーに敵入れたフラグ == d:TRUE) {
					//	カメラ切り替えは無し
					return;
				}
				
				if ($3 == 入る) {
					if ( ($w:プレイヤー方向 <= 1024) || ($w:プレイヤー方向 >= 3072) ) {
						chara カメラ設定 モーションカメラ \
							-c 1 \
							-p 1357,1308,-2331 -t 2402,1161,-5129 \
							-r 32,1815,0 -f 2990 \
							-a 200 \
							-i 0 0 0 0 \
							-s 1
				
						if ($f:w41a_ロッカー内フラグ == d:FALSE) {

							chara delay モーションカメラディレイ \
								-t 45 \
								-e {
									eval ($f:w41a_ロッカー内フラグ = d:TRUE)
									chara カメラ設定 モーションカメラ２ \
										-c 1 \
										-p 3341,5092,-5244 -t 2939,2257,-6127 \
										-r 809,2326,0 -f 2996 \
										-a 200 \
										-i 0 0 0 0 \
										-s 1
								}
						}
					}
				} else if ($3 == 出る) {
					if ($f:w41a_ロッカー内フラグ == d:TRUE) {
						chara カメラ設定 モーションカメラ２ \
							-s -1
					}

					chara カメラ設定 モーションカメラ \
						-c 1 \
						-p 1357,1308,-2331 -t 2402,1161,-5129 \
						-r 32,1815,0 -f 2990 \
						-a 200 \
						-i 0 0 0 0 \
						-s $3
				}
			}
	}


#if 0
	//	w41a_d_common.h内に記述
	//	監視カメラ
	proc 監視カメラ設定 {

	/*
