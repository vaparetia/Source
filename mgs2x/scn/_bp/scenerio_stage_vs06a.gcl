					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN	d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,1500,d:CAM_MIN			d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 900,2048,0 -f 7500 \
					-a 200 \
					-i 3 3 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}
		// ゴール前穴南側 張りつき時
		trap ca102 d:PLAYER \
			-mask ？ \
			-dir 0 512 \
			-state d:TRP_STATE_CAUTION \
			-camera \
			-exec {
				chara カメラ設定 メインカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN	d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,1500,d:CAM_MIN			d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 900,2048,0 -f 7500 \
					-a 200 \
					-i 3 3 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}
		// 西向き張りつき
		// --------------------
		// 右大穴東側
		trap ca111 d:PLAYER \
			-mask ？ \
			-dir 3072 512 \
			-state d:TRP_STATE_CAUTION \
			-camera \
			-exec {
				chara カメラ設定 メインカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN	d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,1500,d:CAM_MIN			d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 900,2048,0 -f 7500 \
					-a 200 \
					-i 3 3 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}
		// 北向張りつき
		//----------------
		// ゴール前穴北側柵
		trap ca121 d:PLAYER \
			-mask ？ \
			-dir 2048 512 \
			-state d:TRP_STATE_CAUTION \
			-camera \
			-exec {
				chara カメラ設定 メインカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN	d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,1500,d:CAM_MIN			d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 900,2048,0 -f 7500 \
					-a 200 \
					-i 3 3 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}
		// 東向き張りつき
		// ------------------
		// ステージ中央穴西側柵
		trap ca131 d:PLAYER \
			-mask ？ \
			-dir 1024 512 \
			-state d:TRP_STATE_CAUTION \
			-camera \
			-exec {
				chara カメラ設定 メインカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN	d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,1500,d:CAM_MIN			d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 900,2048,0 -f 7500 \
					-a 200 \
					-i 3 3 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}
	}




// -----------------------------------------------------------------------------------
// 以下デバッグ専用proc
// -----------------------------------------------------------------------------------
// デバッグキャラ
// ------------------------------------
proc デバッグキャラセット {
	#if d:DEBUG_PRINT
		print 'debug_chara_set'
	#endif

	#if d:CHARA_CAMERA
		chara キャラカメラ 敵兵カメラ \
			-c d:TARGET_CHARA \
			-s -920,610,200 \
			-r -200,1024,0
	#endif

	#if d:SCREENSHOT
		chara スクリーンショット shot
	#endif

	#if d:USB_KEY
		chara USBキーボード実行 test \
			-e d:KBD_ESC {
				mesg プレイヤー d:PLAYER position -5500, -13000, -500
			} \
	#endif
}
