//----- 敵兵設定

proc 敵兵設定 {
#if d:DEBUG_PRINT
	print '*** Enemy Set ***'
#endif

	//---------------------------------------------------------
	// コマンダー
	if($s:登場ポイント == sp_w43a_w44a_0) {
		// シナリオデモ

		// コマンダー
		//   -w 警備コマンダーproc  -a 攻撃コマンダーproc  -r 復活場所 マップＩＤ  -c 待機場所 マップＩＤ  -v 音声  -m 危険モード  -p クリアリングエリア ルート ポイント プロック  -x 司令官危険音声  -y 司令官警戒音声  -g 銃ライト  -z 麻酔持続時間  -b 危険モードでの復活人数 
		chara コマンダー 敵兵セット \
			-s (d:ENE_STAGE_NO_WC_GOVER)

	} else {
#ifndef d:BOSS_MODE
		// 天狗イベント
		if($w:ゲーム設定 == d:LEVEL_VERYEASY) {
			chara コマンダー 敵兵セット \
				-a 天狗兵コマンダー４ \
				-v [ene_plant_voice:01] \
				-m $w:スタートアラートモード \
				-s (d:ENE_STAGE_NPC_SNAKE | d:ENE_STAGE_NO_STRM | d:ENE_STAGE_ALERT2SNEAK | d:ENE_STAGE_NO_WC_GOVER) \
				-d 第二メタルハンガー \
				-h $i:標準警戒時間 \
				-b 20 \								// ４ ＊ ５
				-k 20

		} else if($w:ゲーム設定 == d:LEVEL_EASY) {
			chara コマンダー 敵兵セット \
				-a 天狗兵コマンダー５ \
				-v [ene_plant_voice:01] \
				-m $w:スタートアラートモード \
				-s (d:ENE_STAGE_NPC_SNAKE | d:ENE_STAGE_NO_STRM | d:ENE_STAGE_ALERT2SNEAK | d:ENE_STAGE_NO_WC_GOVER) \
				-d 第二メタルハンガー \
				-h $i:標準警戒時間 \
				-b 25 \								// ５ ＊ ５
				-k 25

		} else if($w:ゲーム設定 == d:LEVEL_NORMAL) {
			chara コマンダー 敵兵セット \
				-a 天狗兵コマンダー６ \
				-v [ene_plant_voice:01] \
				-m $w:スタートアラートモード \
				-s (d:ENE_STAGE_NPC_SNAKE | d:ENE_STAGE_NO_STRM | d:ENE_STAGE_ALERT2SNEAK | d:ENE_STAGE_NO_WC_GOVER) \
				-d 第二メタルハンガー \
				-h $i:標準警戒時間 \
				-b 36 \								// ６ ＊ ６
				-k 36

		} else if($w:ゲーム設定 == d:LEVEL_HARD) {
			chara コマンダー 敵兵セット \
				-a 天狗兵コマンダー７ \
				-v [ene_plant_voice:01] \
				-m $w:スタートアラートモード \
				-s (d:ENE_STAGE_NPC_SNAKE | d:ENE_STAGE_NO_STRM | d:ENE_STAGE_ALERT2SNEAK | d:ENE_STAGE_NO_WC_GOVER) \
				-d 第二メタルハンガー \
				-h $i:標準警戒時間 \
				-b 42 \								// ７ ＊ ６
				-k 42

		} else {
			chara コマンダー 敵兵セット \
				-a 天狗兵コマンダー７ \
				-v [ene_plant_voice:01] \
				-m $w:スタートアラートモード \
				-s (d:ENE_STAGE_NPC_SNAKE | d:ENE_STAGE_NO_STRM | d:ENE_STAGE_ALERT2SNEAK | d:ENE_STAGE_NO_WC_GOVER) \
				-d 第二メタルハンガー \
				-h $i:標準警戒時間 \
				-b 42 \								// ７ ＊ ６
				-k 42
		}
#else
// ボスサバイバル用の設定
		// 天狗イベント
		if( $w:ゲーム設定 < d:LEVEL_EASY ) {
			chara コマンダー 敵兵セット \
				-a 天狗兵コマンダー４ \
				-v [ene_plant_voice:01] \
				-m $w:スタートアラートモード \
				-s (d:ENE_STAGE_NPC_SNAKE | d:ENE_STAGE_NO_STRM | d:ENE_STAGE_ALERT2SNEAK | d:ENE_STAGE_NO_WC_GOVER) \
				-d 第二メタルハンガー \
				-h $i:標準警戒時間 \
				-b 16 \								// ４ ＊ ４
				-k 16

		} else if( $w:ゲーム設定 == d:LEVEL_EASY ) {
			chara コマンダー 敵兵セット \
				-a 天狗兵コマンダー４ \
				-v [ene_plant_voice:01] \
				-m $w:スタートアラートモード \
				-s (d:ENE_STAGE_NPC_SNAKE | d:ENE_STAGE_NO_STRM | d:ENE_STAGE_ALERT2SNEAK | d:ENE_STAGE_NO_WC_GOVER) \
				-d 第二メタルハンガー \
				-h $i:標準警戒時間 \
				-b 18 \								// ４ ＊ ４ +2
				-k 18

		} else {
			chara コマンダー 敵兵セット \
				-a 天狗兵コマンダー５ \
				-v [ene_plant_voice:01] \
				-m $w:スタートアラートモード \
				-s (d:ENE_STAGE_NPC_SNAKE | d:ENE_STAGE_NO_STRM | d:ENE_STAGE_ALERT2SNEAK | d:ENE_STAGE_NO_WC_GOVER) \
				-d 第二メタルハンガー \
				-h $i:標準警戒時間 \
				-b 20 \								// ５ ＊ ４
				-k 20
		}
#endif


		//---------------------------------------------------------
		// 天狗コマンダーのレベルアップ
		trap tng02 d:PLAYER \
			-mask 入る \
			-exec {
				#if d:DEBUG_PRINT
					print '*** tng02 ***'
				#endif

				mesg 天狗兵コマンダー tng_com レベルＵＰ 2
			}
		trap tng02 ＮＰＣスネーク \
			-mask 入る \
			-exec {
				#if d:DEBUG_PRINT
					print '*** tng02 ***'
				#endif

				mesg 天狗兵コマンダー tng_com レベルＵＰ 2
			}
		trap tng03 d:PLAYER \
			-mask 入る \
			-exec {
				#if d:DEBUG_PRINT
					print '*** tng03 ***'
				#endif

				mesg 天狗兵コマンダー tng_com レベルＵＰ 3
			}
		trap tng03 ＮＰＣスネーク \
			-mask 入る \
			-exec {
				#if d:DEBUG_PRINT
					print '*** tng03 ***'
				#endif

				mesg 天狗兵コマンダー tng_com レベルＵＰ 3
			}
		trap tng04 d:PLAYER \
			-mask 入る \
			-exec {
				#if d:DEBUG_PRINT
					print '*** tng04 ***'
				#endif

				mesg 天狗兵コマンダー tng_com レベルＵＰ 4
				mesg 透明壁 最後のラッシュ壁 on
				mesg ＮＰＣスネーク ＮＰＣスネーク Ｗ４４Ａ最後の山場
			}
	//	trap tng04 ＮＰＣスネーク \
	//		-mask 入る \
	//		-exec {
	//			#if d:DEBUG_PRINT
	//				print '*** tng04 ***'
	//			#endif
	//
	//			mesg 天狗兵コマンダー tng_com レベルＵＰ 4
	//		}

		chara 透明壁 最後のラッシュ壁 \
			-p 31250 4000 -135250 4000 \
			   37250 4000 -135250 4000 \
			-a (d:HZX_SEG_ATR_ALL & ~(d:HZX_SEG_NO_PLAYER)) \
			-map 第二メタルハンガー
		mesg 透明壁 最後のラッシュ壁 off
	}

	#ifdef d:BOSS_MODE
		// 天狗イベント開始！(ボスサバイバルではデモがないので自前で呼ぶ)
		mesg 天狗兵コマンダー tng_com レベルＵＰ 1
		mesg 天狗兵コマンダー tng_com 危険開始
	#endif
}

//-----------------------------------------------------------------------------
// 天狗全滅プロック
proc 天狗全滅プロック {
#if d:DEBUG_PRINT
	print '*** Tengu Eliminated ***'
#endif

#ifndef d:BOSS_MODE
	eval($w:Ｓローカル変数Ｗ１ = 1)
#else
	// ボスラッシュモードの設定
	@ボスラッシュ終了時処理
#endif
}





//=============================================================================
// オブジェクト
//=============================================================================

//-----------------------------------------------------------------------------
// ドア設定
proc ドア設定 {
#if d:DEBUG_PRINT
	print '*** Door Set ***'
#endif

	// ドア
	//   -m オブジェクト名  -d 向き  -p 場所  -slide スライド量  -time 時間  -between マップ名１ マップ名２  -exec { $:開閉フラグ }

	// 円形エレベーターへのドア
	@主観禁止壁 円形エレベーターへのドア壁 33500 4000 -150375 0 d:SD_SLIDE_INSIDE
	chara ドア 円形エレベーターへのドア \
		-m d:DOOR_NAME1 \
		-d 0 0 0 \
		-p 33500 4000 -150375 \
		-s d:SD_SLIDE_ARSENAL_LEFT \
		-t d:SD_OPEN_TIME \
		-b 第二メタルハンガー 第二メタルハンガー \
		-w d:DOOR_NAME2 d:SD_SLIDE_ARSENAL_RIGHT \
		-hazard_width 1500 \
		-exec {
			if(!($:開閉フラグ)) {
				mesg プットオブジェ 円形エレベーターロード部 off		// ロード部モデル
			} else {
				mesg プットオブジェ 円形エレベーターロード部 on			// ロード部モデル
			}
		}
	trap dr001 d:PLAYER -mask ？ \
		-exec {
			if($3 == 入る) {
				if($w:Ｓローカル変数Ｗ１ < 2) {
					command ＳＥセットモード -s d:SD_S_BUZZER01 -p 33500 4000 -150375 -m 0
				}
			} else if($3 == 出る) {
			}
		}
	trap dr001 d:PLAYER -mask ？ \
		-state d:TRP_STATE_SUBJECT \
		-exec {
			if($3 == 入る) {
				mesg 透明壁 円形エレベーターへのドア壁 on
			} else if($3 == 出る) {
				mesg 透明壁 円形エレベーターへのドア壁 off
			}
		}

	// 丸通路へのドア
	chara ドア 丸通路へのドア \
		-m d:DOOR_NAME1 \
		-d 0 2048 0 \
		-p 35000 4000 -91125 \
		-s d:SD_SLIDE_ARSENAL_LEFT \
		-t d:SD_OPEN_TIME \
		-b 第二メタルハンガー 第二メタルハンガー \
		-w d:DOOR_NAME2 d:SD_SLIDE_ARSENAL_RIGHT \
		-hazard_width 1500 \
		-exec {
			if(!($:開閉フラグ)) {
			} else {
			}
		}
	trap dr002 d:PLAYER -mask ？ \
		-exec {
			if($3 == 入る) {
				command ＳＥセットモード -s d:SD_S_BUZZER01 -p 35000 4000 -91125 -m 0
			} else if($3 == 出る) {
			}
		}
}

//-----------------------------------------------------------------------------
// その他オブジェクト設定
proc その他オブジェクト設定 {
#if d:DEBUG_PRINT
	print '*** Object Set ***'
#endif

	//---------------------------------------------------------
	// 円形エレベータ
	@SS_プットオブジェ  円形エレベーターロード部 d:KMS_NAME1
	mesg プットオブジェ 円形エレベーターロード部 off

	//---------------------------------------------------------
	// ニキータ対処
	command ミサイル移動範囲設定 \
		29250 4000 -150250 \
		39250 8000  -91250

	//---------------------------------------------------------
	// 量産メタル
	@SS_プットオブジェ 量産メタル表 d:OBJ_NAME1
	@SS_プットオブジェ 量産メタル裏 d:OBJ_NAME2
	chara プロック連続実行 連続実行 \
		-time -1 \
		-exec {
			command プレイヤー状態取得 -d

			if(($f:Ｓローカルフラグ１ == 1) && (($status & d:PFLAG_SUBJECT) || ($status & d:PFLAG_CAUTION) || ($status & d:PFLAG_NIKITA_ALIVE))) {
				#if d:DEBUG_PRINT
					print '*** Metal Ura ON  ***'
				#endif

				eval($f:Ｓローカルフラグ１ = 0)
				mesg プットオブジェ 量産メタル裏 on

			} else if(($f:Ｓローカルフラグ１ == 0) && ((($status & d:PFLAG_SUBJECT) == 0) && (($status & d:PFLAG_CAUTION) == 0) && (($status & d:PFLAG_NIKITA_ALIVE) == 0))) {
				#if d:DEBUG_PRINT
					print '*** Metal Ura OFF ***'
				#endif

				eval($f:Ｓローカルフラグ１ = 1)
				mesg プットオブジェ 量産メタル裏 off
			}
		}

	//---------------------------------------------------------
	// リボン
	@SS_プットオブジェ リボン d:KMS_NAME2

	//---------------------------------------------------------
	// 回転リボン
	chara 回転モデル 回転モデル \
		-O        34250 10000 -108625 \	// 起点
		-posz     0 \
		-spin     0 (-300 * 60 * 4) \	// 軸回転
		-model    d:KMS_NAME3			// 使用モデル名

	chara 回転モデル 回転モデル \
		-O        34250 10000 -108625 \	// 起点
		-posz     -12000 \
		-spin     0 (300 * 60 * 4) \	// 軸回転
		-model    d:KMS_NAME3			// 使用モデル名

	chara 回転モデル 回転モデル \
		-O        34250 10000 -108625 \	// 起点
		-posz     -24000 \
		-spin     0 (-300 * 60 * 4) \	// 軸回転
		-model    d:KMS_NAME3			// 使用モデル名

	//---------------------------------------------------------
	// 天狗兵ステージモニターW44a
	chara 天狗兵ステージモニターW44a モニター

/*
	//---------------------------------------------------------
	// 空中文字  $:ＯＸ $:ＯＹ $:ＯＺ $:半径 $:Ｙシフト $:絵幅 $:絵高さ $:ＴＲＩ名 $:枠テクスチャ名 $:文字テクスチャ名 $:文字表示枠Ｙ１ $:文字表示枠Ｙ２ $:初期方向 $:１スクロール秒 $:スクロール１ $:スクロール２ {
	@SS_空中文字 34250 4000 -107265 (6750) 5508 (1625) (850) stage_effect w44a_efct_disp_01_alp_add_ovl w44a_efct_disp_01_scr_alp_add_ovl 222 653 (3072) (10) 480 520
	@SS_空中文字 34250 4000 -119265 (6750) 5508 (1625) (850) stage_effect w44a_efct_disp_01_alp_add_ovl w44a_efct_disp_01_scr_alp_add_ovl 222 653 (3072) (11) 480 520
	@SS_空中文字 34250 4000 -131265 (6750) 5508 (1625) (850) stage_effect w44a_efct_disp_01_alp_add_ovl w44a_efct_disp_01_scr_alp_add_ovl 222 653 (3072) (12) 480 520

