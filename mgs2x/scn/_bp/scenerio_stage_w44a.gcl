				36625,4000,-125625 0x00000012 \
/*******羽交い絞め OFF***********/
				32375,4000,-129000 0x00000000 \
				33750,4000,-129000 0x00010011 \		// 羽交い絞め１
				36125,4000,-129000 0x00000000 \
				34750,4000,-129000 0x00010021 \		// 羽交い絞め１

				32250,4000,-134000 0x00000000 \
				30875,4000,-134000 0x00010021 \		// 羽交い絞め１
