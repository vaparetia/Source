//-----------------------------------------------------------------------------
// スイッチ

#define STAGE_PLANT 1
#define STAGE_W44A  1

#define ENE_TNG     1	// 天狗兵
#define NPC_SNAKE   1	// ＮＰＣスネーク



#define RAIDEN     1
#if d:RAIDEN
#define PLAYER     ライデン
#else
#define PLAYER     スネーク
#endif

#define ENEMY_SET     1			// 敵兵の配置
#define STAGE_END     1			// ロードプロック
#define SUPPORT_SNAKE 1			// サポートスネーク

#define SCREENSHOT    0			// スクリーンショット
#define KEYBOARD      0			// ＵＳＢキーボード

//-----------------------------------------------------------------------------
// マップ関係

#define HZX_NAME   w44a
#define LT2_NAME   w44a

#define KMS_NAME0  w44a
#define KMS_NAME1  w45a_dammy
#define KMS_NAME2  w44a_efct
#define KMS_NAME3  w44a_rbn_ring

#define OBJ_NAME1  w44a_pdray_front
#define OBJ_NAME2  w44a_pdray_back

#define DOOR_NAME1 w42a_dr_left
#define DOOR_NAME2 w42a_dr_right





