				35250,4000,-137625 0x00000000 \
				36625,4000,-137625 0x00020012 \		// 羽交い絞め２

				31250,4000,-143500 0x00000000 \
				34250,4000,-143500 0x00000000 \
				37250,4000,-143500 0x00000000
/**********
				32375,4000,-129000 0x00000000 \
				33750,4000,-129000 0x00010111 \		// 羽交い絞め１
				36125,4000,-129000 0x00000000 \
				34750,4000,-129000 0x00010121 \		// 羽交い絞め１

				32250,4000,-134000 0x00000000 \
				30875,4000,-134000 0x00010121 \		// 羽交い絞め１
				36250,4000,-134000 0x00000000 \
				37625,4000,-134000 0x00010111 \		// 羽交い絞め１

				33250,4000,-137625 0x00000000 \
				31875,4000,-137625 0x00020122 \		// 羽交い絞め２
