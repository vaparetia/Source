				31250,4000,-143500 0x00000000 \
				34250,4000,-143500 0x00000000 \
				37250,4000,-143500 0x00000000
*************/
		//---------------------------------------------------------
		// アイテム数制御
		mesg ＮＰＣスネーク ＮＰＣスネーク アイテムを出す数の制限     $i:w44a_スネークレーション数 $i:w44a_スネークソコム数 $i:w44a_スネークＭ４数
		mesg ＮＰＣスネーク ＮＰＣスネーク ＲＧＢ６のマガジン数の制限 $i:w44a_スネークＲＧＢ６数

		//---------------------------------------------------------
		// 羽交い絞め発生レベル
		if($i:w44a_サポートレベル < 7) {
			mesg ＮＰＣスネーク ＮＰＣスネーク 羽交い締めフラグ 1
		} else {
			mesg ＮＰＣスネーク ＮＰＣスネーク 羽交い締めフラグ 0
		}

		//---------------------------------------------------------
		// バンダナ
		chara ロープモデル３ バンダナ１ \
			-n sna_bdn1 \
			-d 1 \
			-y ＮＰＣスネーク \
			-z 12 \
			-x 0,60,-90 \
			-m 12 \
			-p 250 \
			-k 350 \
			-o 110 \
			-v \
			-f 1
		chara ロープモデル３ バンダナ２ \
			-n sna_bdn2 \
			-d 1 \
			-y ＮＰＣスネーク \
			-z 12 \
			-x 0,50,-90 \
			-m 22 \
			-p 250 \
			-k 350 \
			-o 110 \
			-v \
			-f 1

		//---------------------------------------------------------
		// 白息
		chara 白息 ＮＰＣスネーク息 \
			-name     ＮＰＣスネーク \
			-object   12 \
			-shift    0,-30,130 \
			-interval 136
		mesg 白息 ＮＰＣスネーク息 on
#endif
	}
}
proc 羽交い絞めプロック {
#if d:DEBUG_PRINT
	print '*** Full Nelson ***'
#endif

	if($1 == 1) {
		// 羽交い絞め１
		mesg 天狗兵コマンダー tng_com 首絞めレベルＵＰ 21

	} else if($1 == 2) {
		// 羽交い絞め２
		mesg 天狗兵コマンダー tng_com 首絞めレベルＵＰ 33
	}
}
proc スネーク死亡プロック {
#if d:DEBUG_PRINT
	print '*** Snake Dead ***'
#endif

	if(`command ゲームオーバーチェック` == 1) {
		return
	}

	eval($f:pgo_ＮＰＣスネーク死亡 = 1)

	//	8/21向手追加
	@スネークゲームオーバーカメラ設定
}
proc スネークゲームオーバーカメラ設定 {

		//	特殊装備解除
		@特殊装備解除

		//	ニキータ、サーマル、ナイトビジョンも外す
		if ($w:武器 == d:武器:ニキータ) {
			eval($w:武器 = d:武器:素手)
		}
		if ( ($w:アイテム == d:アイテム:暗視ゴーグル) || \
			($w:アイテム == d:アイテム:サーマルゴーグル) ){
			eval($w:アイテム = d:アイテム:素手)
		}

		//	ゲームオーバーカメラ設定
		command コントロール座標取得 \
			ＮＰＣスネーク $i:スネークＸ座標変数 $i:スネークＹ座標変数 $i:スネークＺ座標変数

		//	リミットを設ける
		//	手前壁めりこみ防止のため
		if ($i:スネークＺ座標変数 > -92500) {
			chara カメラ設定 ゲームオーバーカメラ \
				-c 1 \
				-p $i:スネークＸ座標変数,7350,-92000 \
				-t $i:スネークＸ座標変数,4000,-92500 \
				-a 185 \
				-i 0 0 0 0 \
				-s 1
		} else if ($i:スネークＺ座標変数 > -94000) {
			chara カメラ設定 ゲームオーバーカメラ \
				-c 1 \
				-p $i:スネークＸ座標変数,7350,-92000 \
				-t $i:スネークＸ座標変数,4000,$i:スネークＺ座標変数 \
				-a 185 \
				-i 0 0 0 0 \
				-s 1
		//	それ以外のとき
		} else {
			//	左側柱影防止のため
			if ($i:スネークＸ座標変数 < 30500) {
				chara カメラ設定 ゲームオーバーカメラ \
					-c 1 \
					-p 32000                ,7350,($i:スネークＺ座標変数+1200) \
					-t $i:スネークＸ座標変数,4000,$i:スネークＺ座標変数 \
					-a 185 \
					-i 0 0 0 0 \
					-s 1

			//	右側柱影防止のため
			} else if ($i:スネークＸ座標変数 > 38000) {
				chara カメラ設定 ゲームオーバーカメラ \
					-c 1 \
					-p 36500                ,7350,($i:スネークＺ座標変数+1200) \
					-t $i:スネークＸ座標変数,4000,$i:スネークＺ座標変数 \
					-a 185 \
					-i 0 0 0 0 \
					-s 1

			//	それ以外のときは
			} else {
				chara カメラ設定 ゲームオーバーカメラ \
					-c 1 \
					-p $i:スネークＸ座標変数,7350,($i:スネークＺ座標変数+2000) \
					-t $i:スネークＸ座標変数,4000,$i:スネークＺ座標変数 \
					-a 185 \
					-i 0 0 0 0 \
					-s 1
			}
		}
}





