//-----------------------------------------------------------------------------
// ローカル

eval($f:Ｓローカルフラグ１ = 0)		// 量産メタル裏の制御
eval($f:Ｓローカルフラグ３ = 0)		// デモ処理フラグ
eval($w:Ｓローカル変数Ｗ１ = 0)		// 初期値０   全滅１   ドア開く２   退場デモ３

//eval($w:プレイヤーフラグ = $w:プレイヤーフラグ | d:PL_GAVE_SHAVER_TO_SNAKE)

