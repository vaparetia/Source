			mesg ＯＦＦ制御 off_man ボディシャドウＯＦＦ
		#endif
	}
	proc キャラ用ライト設定 {
		chara 環境光 Amb \
			-c 55 63 38

		chara 平行光 Para \
			-c 163 164 150 \
			-p -2200 -4400 600
	}

	proc ＤＥ連絡橋風設定 {
		@風設定 ca002
	}

//###################################################################################
//									カメラ
//###################################################################################

	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0 
		chara カメラ 通路カメラ		-c 0 -l 2 -p 50
		chara カメラ 小部屋カメラ		-c 0 -l 2 -p 40
		chara カメラ ビヨンドカメラ		-c 0 -l 2 -p 20
		chara カメラ 張り付きカメラ		-c 0 -l 2 -p 10
//		chara カメラ シナリオカメラ		-c 0 -l 2 -p 6
		chara カメラ シナリオカメラ		-c 0 -l 0 -p 6
		chara カメラ ロードカメラ		-c 0 -l 1 -p 5
		chara カメラ ゲームオーバーカメラ	c 0 -l 1 -p 4

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \	
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 425,2048,0 \
			-f 7500 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}
	proc ＤＥ連絡橋カメラ設定 {
		#if d:DEBUG_PRINT
			print 'w19a_camera_set'
		#endif

		// Ｄ脚１Ｆドア前
		trap ca001 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
//-p -15274,4142,5689 -t -16042,1912,2014 \
//-p -15455,5581,3364 -t -15528,1140,3017 \

					@CS_スムーズカメラ昇順 $6 -1000 3000 -15274 -15455
					eval( $i:補完ＰＸ = $i:CS_結果１ );

					@CS_スムーズカメラ昇順 $6 -1000 3000 4142 5581
					eval( $i:補完ＰＹ = $i:CS_結果１ );

					@CS_スムーズカメラ昇順 $6 -1000 3000 5689 3364
					eval( $i:補完ＰＺ = $i:CS_結果１ );


					@CS_スムーズカメラ昇順 $6 -1000 3000 -16042 -15528
					eval( $i:補完ＴＸ = $i:CS_結果１ );

					@CS_スムーズカメラ昇順 $6 -1000 3000 1912 1140
					eval( $i:補完ＴＹ = $i:CS_結果１ );

					@CS_スムーズカメラ昇順 $6 -1000 3000 2014 3017
					eval( $i:補完ＴＺ = $i:CS_結果１ );

				chara カメラ設定 小部屋カメラ \
					-c 1 \
					-b -15875,d:CAM_MIN,d:CAM_MIN -14500,d:CAM_MAX,d:CAM_MAX \
					-l -15875,d:CAM_MIN,d:CAM_MIN -14500,d:CAM_MAX,d:CAM_MAX \
					-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ \
					-t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ \
					-a 200 \
					-i 0 -1 0 0 \
					-d 1 \
					-z d:CAMERA_LIMITBOUND_EXIST \	//	ビハインドのためリミットを見る
					-s $3
			}



		// 連絡橋
		trap ca002 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
# if 1
				//	高さ１３０以上のとき
				if ($5 > 130) {
					//	プレイヤーのＸ座標に沿ってＸロットが変化
					@CS_スムーズカメラ昇順 $4  -12000 12000 450 650
				//	高さ１３０以下のとき
				} else if ($5 > -2700) {
					//	高さ１３０のときのＸロットを求める。
					@CS_スムーズカメラ昇順 $4  -12000 12000 450 650
					//	求めたＸロットを別の変数に代入。このＸロットからスムーズにつながる
					eval ($i:現状ＲＸ１ = $i:CS_結果１);

					//	高さ−２７００のときのＸロットを求める。
					@CS_スムーズカメラ昇順 $4  -12000 12000 300 650
					//	求めたＸロットを別の変数に代入。このＸロットからスムーズにつながる
					eval ($i:現状ＲＸ２ = $i:CS_結果１);

					//	プレイヤーのＹ座標に沿ってＸロットが変化
					@CS_スムーズカメラ降順 $5  100 -2700 $i:現状ＲＸ１ $i:現状ＲＸ２
				} else {
					@CS_スムーズカメラ昇順 $4  -12000 12000 300 650

				}
				//	最終的に求めたＸロットを代入
				eval( $i:補完ＲＸ = $i:CS_結果１ );

				@CS_スムーズカメラ降順 $5  -600 -2700 -7823 -13000
				eval( $i:補完ＢＸ１ = $i:CS_結果１ );

				@CS_スムーズカメラ降順 $5  -600 -2700 -7823 -13000
				eval( $i:補完ＬＸ１ = $i:CS_結果１ );

				@CS_スムーズカメラ降順 $5  -600 -2700 13500 14000
				eval( $i:補完ＢＸ２ = $i:CS_結果１ );

				@CS_スムーズカメラ降順 $5  -600 -2700 8861 9405
				eval( $i:補完ＬＸ２ = $i:CS_結果１ );




				chara カメラ設定 通路カメラ \
					-c 0 \	
					-b $i:補完ＢＸ１,d:CAM_MIN,d:CAM_MIN $i:補完ＢＸ２,10500,d:CAM_MAX \
					-l $i:補完ＬＸ１,d:CAM_MIN,d:CAM_MIN $i:補完ＬＸ２,d:CAM_MAX,d:CAM_MAX \

					-r $i:補完ＲＸ,2496,0 -f 11000 \
					-a 200 \
					-i 0 -1 0 0 \
					-d 1 \
					-s $3

# else
				@CS_スムーズカメラ降順 $5 -500 -2000 605 505
				eval( $i:補完ＲＸ = $i:CS_結果１ );

				chara カメラ設定 通路カメラ \
					-c 0 \	
					-b -9000,d:CAM_MIN,d:CAM_MIN 13886,d:CAM_MAX,d:CAM_MAX \
					-l -9000,d:CAM_MIN,d:CAM_MIN 9500,d:CAM_MAX,d:CAM_MAX \
					-r $i:補完ＲＸ,2393,0 -f 10132 \
					-r $i:補完ＲＸ,2496,0 -f 11000 \
					-a 200 \
					-i 0 -1 0 0 \
					-d 1 \
					-s $3
# endif
			}

		//	Ｅ脚側出入口付近
		trap ca005 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 小部屋カメラ \
					-c 1 \	
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN 16753,d:CAM_MAX,-3919 \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN 16753, d:CAM_MAX,-4776 \
//					-p 16384,6141,-3731 -t 16384,1695,-5192 \
//					-r 904,2048,0 -f 4684 \
//					-a 200 \
					-p 16730,5459,-4186 -t 16730,1563,-4912 \
					-r 904,2048,0 -f 3963 \
					-a 200 \
					-i 0 -1 0 0 \
					-d 1 \
					-z d:CAMERA_LIMITBOUND_EXIST \	//	ビハインドのためリミットを見る
					-s $3

			}

		//	Ｅ脚通路
		trap ca003 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
//-p 15791,2470,3473 -t 14584,1477,-2455 \
//-p 15644,4199,2742 -t 14787,1441,-1461 \
					@CS_スムーズカメラ昇順 $6 -4000 1000 15644 15369
					eval( $i:補完ＰＸ = $i:CS_結果１ );

					@CS_スムーズカメラ昇順 $6  -4000 1000 4199 5554
					eval( $i:補完ＰＹ = $i:CS_結果１ );

					@CS_スムーズカメラ昇順 $6  -4000 1000 2742 1384
					eval( $i:補完ＰＺ = $i:CS_結果１ );


					@CS_スムーズカメラ昇順 $6  -4000 1000 14787 15166
					eval( $i:補完ＴＸ = $i:CS_結果１ );

					@CS_スムーズカメラ昇順 $6  -4000 1000 1441 -484
					eval( $i:補完ＴＹ = $i:CS_結果１ );

					@CS_スムーズカメラ昇順 $6  -4000 1000 -1461 385
					eval( $i:補完ＴＺ = $i:CS_結果１ );

		
				chara カメラ設定 小部屋カメラ \
					-c 1 \
					-b 14375,d:CAM_MIN,d:CAM_MIN 16125,d:CAM_MAX,1750 \
					-l 14375,d:CAM_MIN,d:CAM_MIN 16125,d:CAM_MAX,1750 \
					-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ \
					-t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ \
					-a 200 \
					-i 0 -1 0 0 \
					-d 1 \
					-z d:CAMERA_LIMITBOUND_EXIST \	//	ビハインドのためリミットを見る
					-s $3
			}

		// Ｄ脚Ｂ１ドア前
		trap ca004 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
//-p -15265,-921,4950 -t -15753,-2624,2575 \
//-p -15559,-3,3645 -t -15672,-2916,3100 \

					@CS_スムーズカメラ昇順 $6 -1000 3000 -15265 -15559
					eval( $i:補完ＰＸ = $i:CS_結果１ );

					@CS_スムーズカメラ昇順 $6 -1000 3000 -921 -3
					eval( $i:補完ＰＹ = $i:CS_結果１ );

					@CS_スムーズカメラ昇順 $6 -1000 3000 4950 3645
					eval( $i:補完ＰＺ = $i:CS_結果１ );


					@CS_スムーズカメラ昇順 $6 -1000 3000 -15753 -15672
					eval( $i:補完ＴＸ = $i:CS_結果１ );

					@CS_スムーズカメラ昇順 $6 -1000 3000 -2624 -2916
					eval( $i:補完ＴＹ = $i:CS_結果１ );

					@CS_スムーズカメラ昇順 $6 -1000 3000 2575 3100
					eval( $i:補完ＴＺ = $i:CS_結果１ );

				chara カメラ設定 小部屋カメラ \
					-c 1 \
					-b -15875,d:CAM_MIN,d:CAM_MIN -14500,d:CAM_MAX,d:CAM_MAX \
					-l -15875,d:CAM_MIN,d:CAM_MIN -14500,d:CAM_MAX,d:CAM_MAX \
					-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ \
					-t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ \
					-a 139 \
					-i 0 -1 0 0 \
					-d 1 \
					-z d:CAMERA_LIMITBOUND_EXIST \	//	ビハインドのためリミットを見る
					-s $3
			}



		//	張り付き移動

		//１Ｆ
		//	Ｄ脚入口付近北側
		trap bh001 d:PLAYER \
			-mask ？ \
			-state 8 \	//張り付き
			-dir 0 256 \	// 方向指定
			-camera \
			-exec {
				@張り付き移動カメラ１Ｆ $3
			}
		//	Ｄ脚入口付近南側
		trap bh002 d:PLAYER \
			-mask ？ \
			-state 8 \	//張り付き
			-dir 2048 256 \	// 方向指定
			-camera \
			-exec {
				@張り付き移動カメラ１Ｆ $3
			}
		//	Ｅ脚入口付近北側
		trap bh003 d:PLAYER \
			-mask ？ \
			-state 8 \	//張り付き
			-dir 0 256 \	// 方向指定
			-camera \
			-exec {
				@張り付き移動カメラ１Ｆ $3
			}
		//	Ｅ脚入口付近南側
		trap bh004 d:PLAYER \
			-mask ？ \
			-state 8 \	//張り付き
			-dir 2048 256 \	// 方向指定
			-camera \
			-exec {
				@張り付き移動カメラ１Ｆ $3
			}

		//Ｂ１
		//	Ｄ脚入口付近北側
		trap bh101 d:PLAYER \
			-mask ？ \
			-state 8 \	//張り付き
			-dir 0 256 \	// 方向指定
			-camera \
			-exec {
				@張り付き移動カメラＢ１北 $3
			}
		//	中央付近北側
		trap bh102 d:PLAYER \
			-mask ？ \
			-state 8 \	//張り付き
			-dir 0 256 \	// 方向指定
			-camera \
			-exec {
				@張り付き移動カメラＢ１北 $3
			}
		//	中央付近北側２
		trap bh103 d:PLAYER \
			-mask ？ \
			-state 8 \	//張り付き
			-dir 0 256 \	// 方向指定
			-camera \
			-exec {
				@張り付き移動カメラＢ１北 $3
			}
		//	Ｅ脚側北側
		trap bh104 d:PLAYER \
			-mask ？ \
			-state 8 \	//張り付き
			-dir 0 256 \	// 方向指定
			-camera \
			-exec {
				@張り付き移動カメラＢ１南 $3		//	カメラを立てても大丈夫なので南を使う
			}
		//	Ｅ脚側南側１
		trap bh105 d:PLAYER \
			-mask ？ \
			-state 8 \	//張り付き
			-dir 2048 256 \	// 方向指定
			-camera \
			-exec {
				@張り付き移動カメラＢ１南 $3
			}
		//	Ｅ脚側南側２
		trap bh106 d:PLAYER \
			-mask ？ \
			-state 8 \	//張り付き
			-dir 2048 256 \	// 方向指定
			-camera \
			-exec {
				@張り付き移動カメラＢ１南 $3
			}

		//	Ｄ脚側南北通路
		trap bh107 d:PLAYER \
			-mask ？ \
			-state 8 \	//張り付き
			-dir 1024 256 \	// 方向指定
			-camera \
			-exec {
				@張り付き移動カメラＢ１南 $3
			}
		//	右階段南北通路
		trap bh108 d:PLAYER \
			-mask ？ \
			-state 8 \	//張り付き
			-dir 1024 256 \	// 方向指定
			-camera \
			-exec {
				@張り付き移動カメラＢ１南 $3
			}
		//	Ｄ脚側南北通路
		trap bh109 d:PLAYER \
			-mask ？ \
			-state 8 \	//張り付き
			-dir 3072 256 \	// 方向指定
			-camera \
			-exec {
				@張り付き移動カメラＢ１南 $3
			}

		//	エルード用特殊
		trap bh110 d:PLAYER \
			-mask ？ \
			-state 8 \	//張り付き
			-dir 2048 256 \	//方向指定
			-camera \
			-exec {
				chara カメラ設定 張り付きカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 950,2496,0 -f 9000 \
					-a 200 \
					-i 2 2 0 0 \
					-s $3 \
					-z (d:CAMERA_NO_CUSHION | d:CAMERA_NO_PAD_ADJUST)
			}




		//階段
		//	左側階段
		trap bh201 d:PLAYER \
			-mask ？ \
			-state 8 \	//張り付き
			-dir 2048 256 \	// 方向指定
			-camera \
			-exec {
				@張り付き移動カメラ階段 $3
			}
		trap bh202 d:PLAYER \
			-mask ？ \
			-state 8 \	//張り付き
			-dir 3072 256 \	// 方向指定
			-camera \
			-exec {
				@張り付き移動カメラ階段 $3
			}
		trap bh203 d:PLAYER \
			-mask ？ \
			-state 8 \	//張り付き
			-dir 2048 256 \	// 方向指定
			-camera \
			-exec {
				@張り付き移動カメラ階段 $3
			}
		trap bh204 d:PLAYER \
			-mask ？ \
			-state 8 \	//張り付き
			-dir 3072 256 \	// 方向指定
			-camera \
			-exec {
				@張り付き移動カメラ階段 $3
			}
		
		


	}


	proc 張り付き移動カメラ１Ｆ {
		chara カメラ設定 張り付きカメラ \
			-c 0 \
//-p 11225,8163,-720 -t 11199,1622,-751 \
//-p -12416,8164,-1720 -t -12441,1623,-1751 \
			-b -12416,d:CAM_MIN,d:CAM_MIN 11225,d:CAM_MAX,d:CAM_MAX \
