					-l $w:敵標準体力 \
					-f $w:敵標準気絶 \
					-s 0x40000000 \		//	サポート兵化
					-b 敵兵:01 \
					-e d:ENE_EQUIP_TYPE_NORMAL	//	$w:装備タイプ
			}

		} else if ($f:w19a_敵配置フラグ == d:STRUT_E) {
			chara アタッカー 敵兵:61 \
				-r 4 \
				-h $w:敵標準聴力 \
				-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
				-l $w:敵標準体力 \
				-f $w:敵標準気絶 \
				-s 0x40000000 \		//	サポート兵化
				-b 敵兵:01 \
				-e d:ENE_EQUIP_TYPE_NORMAL	//	$w:装備タイプ
		}
	}



//###################################################################################
//								ＢＧＭ設定
//###################################################################################

	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT 
			print 'bgm_set'
		#endif

		chara ＢＧＭマネージャー ＢＧＭマネ \
			-s 0x00000001
		chara ＢＧＭ風音 風音 \
		-s d:BGM_WINDNOISE_WEATHER_FAIN

	}

//###################################################################################
//									 ドア＆マップ切り替え
//###################################################################################

	proc ドア設置 {
		#if d:DEBUG_PRINT
			print 'slide_door_set'
		#endif

		chara ドア Ｄ脚１Ｆドア \
			-m d:DOOR_NAME_LOAD1 \
			-d 0,1024,0 \
			-p -16875,0,4000 \
			-slide d:SD_SLIDE_OUTSIDE \
			-time d:SD_OPEN_TIME \
			-between ＤＥ連絡橋 ＤＥ連絡橋 \
			-A Ｄ脚１Ｆドアランプ \
			-exec {
				if( !($:開閉フラグ) ){
					mesg プットオブジェ Ｄ脚ロードエリア off
				}else{
					mesg プットオブジェ Ｄ脚ロードエリア on
				}
			}
		@ドアランプ設定 Ｄ脚１Ｆドアランプ 1024 -16875 0 4000 0
		trap dr001 ？ \
			-mask ？ \	
			-exec {
				if ($3 == 入る) {
					mesg ドア Ｄ脚１Ｆドア open $2
				} else {
					mesg ドア Ｄ脚１Ｆドア close $2
				}
			}

		chara ドア Ｄ脚Ｂ１ドア \
			-m d:DOOR_NAME_LOAD2 \
			-d 0,1024,0 \
			-p -16875,-4500,4000 \
			-slide d:SD_SLIDE_OUTSIDE \
			-time d:SD_OPEN_TIME \
			-A Ｄ脚Ｂ１ドアランプ \
			-exec {
				if ( !($:開閉フラグ) ){
					mesg プットオブジェ Ｄ脚Ｂ１ロードエリア off
				} else {
					mesg プットオブジェ Ｄ脚Ｂ１ロードエリア on
				}
			}
		@ドアランプ設定 Ｄ脚Ｂ１ドアランプ 1024 -16875 -4500 4000 0
		trap dr003 ？ \
			-mask ？ \	
			-exec {
				if ($3 == 入る) {
					mesg ドア Ｄ脚Ｂ１ドア open $2
				} else {
					mesg ドア Ｄ脚Ｂ１ドア close $2
				}
			}

		chara ドア Ｅ脚ドア \
			-m d:DOOR_NAME_LOAD1 \
			-d 0,1024,0 \
			-p 18125,0,-4000 \
			-slide d:SD_SLIDE_OUTSIDE \
			-time d:SD_OPEN_TIME \
			-between ＤＥ連絡橋 ＤＥ連絡橋 \
			-A Ｅ脚ドアランプ \
			-exec {
				if ( !($:開閉フラグ) ){
					mesg プットオブジェ Ｅ脚ロードエリア off
				} else {
					mesg プットオブジェ Ｅ脚ロードエリア on
				}
			}
		@ドアランプ設定 Ｅ脚ドアランプ 1024 18125 0 -4000 1
		trap dr002 ？ \
			-mask ？ \	
			-exec {
				if ($3 == 入る) {
					mesg ドア Ｅ脚ドア open $2
				} else {
					mesg ドア Ｅ脚ドア close $2
				}
			}

	}

	proc 主観禁止壁設定 {

		@主観禁止壁 Ｄ脚１Ｆドア壁 -16875 0 4000 1024 d:SD_SLIDE_OUTSIDE
		@主観禁止床 Ｄ脚１Ｆドア床１ Ｄ脚１Ｆドア床２ -16875 0 4000 1024 d:SD_SLIDE_OUTSIDE
		trap dr001 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_SUBJECT \
			-exec {
				if ($3 == 入る) {
					mesg 透明壁 Ｄ脚１Ｆドア壁 on
				} else {
					mesg 透明壁 Ｄ脚１Ｆドア壁 off
				}
			}

		@主観禁止壁 Ｄ脚Ｂ１ドア壁 -16875 -4500 4000 1024 d:SD_SLIDE_OUTSIDE
		@主観禁止床 Ｄ脚Ｂ１ドア床１ Ｄ脚Ｂ１ドア床２ -16875 -4500 4000 1024 d:SD_SLIDE_OUTSIDE
		trap dr003 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_SUBJECT \
			-exec {
				if ($3 == 入る) {
					mesg 透明壁 Ｄ脚Ｂ１ドア壁 on
				} else {
					mesg 透明壁 Ｄ脚Ｂ１ドア壁 off
				}
			}

		@主観禁止壁 Ｅ脚ドア壁 18125 0 -4000 1024 d:SD_SLIDE_OUTSIDE
		@主観禁止床 Ｅ脚ドア床１ Ｅ脚ドア床２ 18125 0 -4000 1024 d:SD_SLIDE_OUTSIDE
		trap dr002 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_SUBJECT \
			-exec {
				if( $3 == 入る ) {
					mesg 透明壁 Ｅ脚ドア壁 on
				} else {
					mesg 透明壁 Ｅ脚ドア壁 off
				}
			}

	}


//###################################################################################
//									開始時処理
//###################################################################################

	proc ＤＥ連絡橋開始時処理 {
		//	双眼鏡兵遭遇デモ後は
		if ($s:登場ポイント == 双眼鏡兵遭遇デモ後) {
				@ステージ開始時処理  d:LOAD_TYPE:NO_MOVE_TYPE 0 0 0

		//	それ以外は
		} else {
			if( $s:登場ポイント == sp_w18a_w19a_0 ) {
				// Ｄ脚１Ｆから
				if ($f:w19a_双眼鏡兵遭遇デモフラグ == d:FALSE) {
					//	双眼鏡兵遭遇デモフラグを立てる（危険モード時はデモは二度と見ない）
					eval ($f:w19a_双眼鏡兵遭遇デモフラグ = d:TRUE)
					//	潜入モード時のみデモが流れる
					if ($w:スタートアラートモード == d:ALERT_MODE_SENNYU) {
//	PAL版のみ
#ifdef d:PAL
						@ステージ開始時処理（デモ表示） \
						d:LOAD_TYPE:SL_DOOR_TYPE Ｄ脚１Ｆドア 1500 d:DEFAULT_M_TYPE \
						d:wn_ＤＥ連絡橋 \
						w19a_paddemo_00_pal d:ALL_OFF -15000 1066 1500 3072 d:FA_END_STAND
//	PAL版以外
#else
						@ステージ開始時処理（デモ表示） \
						d:LOAD_TYPE:SL_DOOR_TYPE Ｄ脚１Ｆドア 1500 d:DEFAULT_M_TYPE \
						d:wn_ＤＥ連絡橋 \
						w19a_paddemo_00 d:ALL_OFF -15000 1066 1500 3072 d:FA_END_STAND
#endif
					} else {
						@ステージ開始時処理（ステージ名表示） \
						d:LOAD_TYPE:SL_DOOR_TYPE Ｄ脚１Ｆドア 1500 d:DEFAULT_M_TYPE \
						d:wn_ＤＥ連絡橋
					}
				} else {
					@ステージ開始時処理（ステージ名表示） \
					d:LOAD_TYPE:SL_DOOR_TYPE Ｄ脚１Ｆドア 1500 d:DEFAULT_M_TYPE \
					d:wn_ＤＥ連絡橋
				}

			} else if( $s:登場ポイント == sp_w18a_w19a_1 ) {
				// Ｄ脚Ｂ１から
				if ($f:w19a_双眼鏡兵遭遇デモフラグ == d:FALSE) {
					//	双眼鏡兵遭遇デモフラグを立てる。Ｂ１のときは見ない
					eval ($f:w19a_双眼鏡兵遭遇デモフラグ = d:TRUE)
				}
				@ステージ開始時処理（ステージ名表示） \
				d:LOAD_TYPE:SL_DOOR_TYPE Ｄ脚Ｂ１ドア 1500 d:DEFAULT_M_TYPE \
				d:wn_ＤＥ連絡橋

			} else if( $s:登場ポイント == sp_w20a0_w19a_0 ) {
				// Ｅ脚１Ｆから
				@ステージ開始時処理（ステージ名表示） \
				d:LOAD_TYPE:SL_DOOR_TYPE Ｅ脚ドア 2250 d:DEFAULT_M_TYPE \
				d:wn_ＤＥ連絡橋
			}
		}
	}



	//	開始時カメラ
	proc スタートカメラセット {
		if( $s:登場ポイント == sp_w18a_w19a_0 ) {
			chara カメラ設定 ロードカメラ \
				-c 1 \	
				-p -15344,4017,4477 \
				-t -16052,1278,2774 \
				-a 200 \
				-i 0 1 0 0 \
				-s 1
		} else if( $s:登場ポイント == sp_w18a_w19a_1 ) {
			chara カメラ設定 ロードカメラ \
				-c 1 \
				-p -15344,(4017 -4500),4477 \
				-t -16052,(1278 -4500),2774 \
				-a 200 \
				-i 0 1 0 0 \
				-s 1
		} else if( $s:登場ポイント == sp_w20a0_w19a_0 ) {
			chara カメラ設定 ロードカメラ \
				-c 1 \
	//			-p 14749,3325,-2858 \
	//			-t 17272,1054,-5986 \
				-p 14749,3325,-3108 \
				-t 16942,1054,-5986 \
				-a 200 \
				-i 0 1 0 0 \
				-s 1
		}
	}

	proc スタートカメラオフ {
		chara カメラ設定 ロードカメラ \
			-s -1
	}



//###################################################################################
//									ロード設定
//###################################################################################

	proc ロードプロック {
		#if d:DEBUG_PRINT 
			print 'load_proc'
		#endif

		if ($s:呼び出しプロック == mv_w19a_w18a_0) {
			// Ｄ脚１Ｆへ
			@mv_w19a_w18a_0
		} else if ($s:呼び出しプロック == mv_w19a_w18a_1) {
			// Ｄ脚Ｂ１へ
			@mv_w19a_w18a_1
		} else if ($s:呼び出しプロック == mv_w19a_w20a0_0) {
			// Ｅ脚１Ｆへ
			@mv_w19a_w20a0_0
		}
	}
	proc ロード設定 {
		#if d:DEBUG_PRINT 
			print 'load_set'
		#endif

		trap ld001 d:PLAYER \
			-mask いる \
			-exec {
				if ($f:ロードチェックＯＮフラグ == 1) {
					//	爆弾イベント用
					@爆弾タイマー残り時間保存
/*
					//	双眼鏡兵を復活させるためにフラグを寝かす
					if ($f:w20b_２Ｆ敵兵死亡フラグ == d:TRUE) {
						eval ($f:w20b_２Ｆ敵兵死亡フラグ = d:FALSE)
					}
					//	屋上兵を復活させるためにフラグを寝かす
					if ($f:w20b_屋上敵兵死亡フラグ == d:TRUE) {
						eval ($f:w20b_屋上敵兵死亡フラグ = d:FALSE)
					}
*/
					//	双眼鏡兵と屋上兵の状態を記憶する
					@敵兵状態保存 敵兵:02 敵兵:03

					// Ｄ脚１Ｆへ
					@ステージ終了時処理（ステージ名表示） \
					-17625 0 3250 3072 mv_w19a_w18a_0 d:DEFAULT_M_TYPE \
					d:wn_Ｄ脚第一沈殿池
					//	ロード時カメラ
					@Ｄ脚１Ｆロード時カメラ設定
					//	先読み
					preseek 'w18a'
				}
			}

		trap ld003 d:PLAYER \
			-mask いる \
			-exec {
				if ($f:ロードチェックＯＮフラグ == 1) {
					//	爆弾イベント用
					@爆弾タイマー残り時間保存
/*
					//	双眼鏡兵を復活させるためにフラグを寝かす
					if ($f:w20b_２Ｆ敵兵死亡フラグ == d:TRUE) {
						eval ($f:w20b_２Ｆ敵兵死亡フラグ = d:FALSE)
					}
					//	屋上兵を復活させるためにフラグを寝かす
					if ($f:w20b_屋上敵兵死亡フラグ == d:TRUE) {
						eval ($f:w20b_屋上敵兵死亡フラグ = d:FALSE)
					}
*/
					//	双眼鏡兵と屋上兵の状態を記憶する
					@敵兵状態保存 敵兵:02 敵兵:03

					// Ｄ脚Ｂ１へ
					@ステージ終了時処理（ステージ名表示） \
					-17625 -4500 3250 3072 mv_w19a_w18a_1 d:DEFAULT_M_TYPE \
					d:wn_Ｄ脚第一沈殿池
					//	ロード時カメラ
					@Ｄ脚Ｂ１ロード時カメラ設定
					//	先読み
					preseek 'w18a'
				}
			}

		trap ld002 d:PLAYER \
			-mask いる \
			-exec {
				if ($f:ロードチェックＯＮフラグ == 1) {
					//	爆弾イベント用
					@爆弾タイマー残り時間保存
/*
					//	双眼鏡兵を復活させるためにフラグを寝かす
					if ($f:w20b_２Ｆ敵兵死亡フラグ == d:TRUE) {
						eval ($f:w20b_２Ｆ敵兵死亡フラグ = d:FALSE)
					}
					//	屋上兵を復活させるためにフラグを寝かす
					if ($f:w20b_屋上敵兵死亡フラグ == d:TRUE) {
						eval ($f:w20b_屋上敵兵死亡フラグ = d:FALSE)
					}
*/
					//	双眼鏡兵と屋上兵の状態を記憶する
					@敵兵状態保存 敵兵:02 敵兵:03

					// Ｅ脚１Ｆへ
					@ステージ終了時処理（ステージ名表示） \
//					20250 0 -4750 1024 mv_w19a_w20a0_0 d:DEFAULT_M_TYPE \
					19750 0 -4750 1024 mv_w19a_w20a0_0 d:DEFAULT_M_TYPE \
					d:wn_Ｅ脚集配場１Ｆ
					//	ロード時カメラ
					@Ｅ脚ロード時カメラ設定
					//	先読み
					preseek 'w20a'
				}
			}
	}



	//	終了時カメラ
	proc Ｄ脚１Ｆロード時カメラ設定 {
		chara カメラ設定 ロードカメラ \
			-c 1 \	
			-p -15344,4017,4477 \
			-t -16052,1278,2774 \
			-a 200 \
			-i 0 1 0 0 \
			-s 1

		chara プロック連続実行 カメラ戻し管理人 \
			-proc カメラ戻し管理
	}
	proc Ｄ脚Ｂ１ロード時カメラ設定 {
		chara カメラ設定 ロードカメラ \
			-c 1 \
			-p -15344,(4017 -4500),4477 \
			-t -16052,(1278 -4500),2774 \
			-a 200 \
			-i 0 1 0 0 \
			-s 1

		chara プロック連続実行 カメラ戻し管理人 \
			-proc カメラ戻し管理
	}
	proc Ｅ脚ロード時カメラ設定 {
		chara カメラ設定 ロードカメラ \
			-c 1 \
//			-p 14749,3325,-2858 \
//			-t 17272,1054,-5986 \
			-p 14749,3325,-3108 \
			-t 16942,1054,-5986 \
			-a 200 \
			-i 0 1 0 0 \
			-s 1

		chara プロック連続実行 カメラ戻し管理人 \
			-proc カメラ戻し管理
	}
	proc カメラ戻し管理 {
		command パッドチェック \
			-no_use
		if ($status != 1) {
			chara カメラ設定 ロードカメラ \
				-s -1
			mesg プロック連続実行 カメラ戻し管理人 kill
		}
	}











//###################################################################################
//									オブジェクト
//###################################################################################

	proc オブジェクト設定 {
		chara プットオブジェ Ｄ脚ロードエリア \
			-m 	d:KMS_NAME23 -r 0 0 0 -p 0 0 0  -l d:LT2_NAME
		mesg プットオブジェ Ｄ脚ロードエリア off

		chara プットオブジェ Ｄ脚Ｂ１ロードエリア \
			-m 	d:KMS_NAME25 -r 0 0 0 -p 0 0 0  -l d:LT2_NAME
		mesg プットオブジェ Ｄ脚Ｂ１ロードエリア off

		chara プットオブジェ Ｅ脚ロードエリア \
			-m 	d:KMS_NAME24 -r 0 0 0 -p 0 0 0  -l d:LT2_NAME
			mesg プットオブジェ Ｅ脚ロードエリア off
	}

	proc 水位設定 {
		command 水位設定 -lv -40000
	}

	proc 海面設定 {
		#if d:DEBUG_PRINT
			print 'w19a_sea_set'
		#endif

		chara プラント海面 seaseasea \
			-tex oil d_oil_sea_alp_ovl_mod0222 d_oil_ref_add_alp_ovl_mod1120 \
			-w 1,2,3 \
			-l \
			-pos 0,-40000,0

		chara 拡張海表示 sea_serface_ex \
			-tex d_oil_sea_alp_ovl_mod0222 \
			-pos 0,-40000,0 \
			-color 145 185 120			/*色合い調整 省略可*/

		chara 水面監視水飛沫 落下水飛沫 \
			-n d:PLAYER \
			-n 敵兵
		command 弾水飛沫処理
	}

	proc 空設定 {
		#if d:DEBUG_PRINT
			print 'w19a_sky_set'
		#endif

//		@昼空	0 -40000 0 -2200 -4400 600
		@昼空（レンズフレア指定）	0 -40000 0 -2200 -4400 600 1

	}

	proc 天井設定 {
		#if d:DEBUG_PRINT
			print 'ceil_set'
		#endif
		chara 天井君 Ｄ脚天井 -m d:KMS_NAME9 -p 0,0,0  -l d:LT2_NAME -c -14000,0,0 -a 0
//		chara 天井君 Ｄ脚廊下 -m d:KMS_NAME11 -p 0,0,0  -l d:LT2_NAME -c -14000,0,0 0,1000,0 -a 0 2 -e 2 1
		chara 天井君 Ｄ脚廊下 -m d:KMS_NAME11 -p 0,0,0  -l d:LT2_NAME -c -14000,0,0 0,287,0 -a 0 2 -e 2 1
		chara 天井君 Ｅ脚天井  -m d:KMS_NAME3 -p 0,0,0  -l d:LT2_NAME -c 14000,0,0 -a 1
		chara 天井君 ヘリポート -m d:KMS_NAME10 -p 0,0,0  -l d:LT2_NAME -c 14000,0,0 -a 1
	
	}



//###################################################################################
//									アイテム
//###################################################################################

	proc アイテム設定 {
		#if d:DEBUG_PRINT
			print 'item_set'
		#endif

		@アイテム再セットチェック $b:w19a_取得ロード回数[0]
		if ($f:再セットフラグ) {
			@スタン_初期設置 スタン:01 13250 -4500 2750 0		//	Ｂ１東側
		}
		@アイテム再セットチェック $b:w19a_取得ロード回数[1]
		if ($f:再セットフラグ) {
			@弾薬_ソコム_初期設置 ソコム弾:01 12750 -4500 3500 0		//	Ｂ１東側
		}
/*
		@アイテム再セットチェック $b:w19a_取得ロード回数[2]
		if ($f:再セットフラグ) {
			@弾薬_Ｍ９_初期設置 Ｍ９弾:01 13250 -4500 4250 0		//	Ｂ１東側
		}
*/



	}

	proc アイテム取得時番号設定 $:ボックス名 {
		#if d:DEBUG_PRINT
		print '*** Item No Set ***'
		#endif

		if($:ボックス名 == スタン:01) {
			eval($b:w19a_取得ロード回数[0] = $w:グローバルロード回数);
		} else if ( $:ボックス名 == ソコム弾:01 ) {
			eval($b:w19a_取得ロード回数[1] = $w:グローバルロード回数);
		} else if ( $:ボックス名 == Ｍ９弾:01 ) {
			eval($b:w19a_取得ロード回数[2] = $w:グローバルロード回数);
		}
	}


