			-state 6 \
			-dir 0 256 \	//方向指定
			-camera \			//カメラトラップであることを明示
			-exec {
				if ($f:w19a_エルード中フラグ == d:TRUE) {
					chara カメラ設定 ビヨンドカメラ \
						-c 0 \
						-b d:CAM_MIN,-2244,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
						-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,-3181,d:CAM_MAX \
						-r 100,2396,0 -f 6000 \
						-a 200 \
						-i 0 -1 0 0 \
						-s 1
				}
			}
		//	エルードカメラ
		trap by008 d:PLAYER \
			-mask ？ \
			-state 5 \
			-dir 2048 256 \	//方向指定
			-camera \			//カメラトラップであることを明示
			-exec {
				if ($f:w19a_エルード中フラグ == d:TRUE) {
					chara カメラ設定 ビヨンドカメラ \
						-c 0 \
						-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
						-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
						-r 3950,2300,0 -f 8000 \
						-a 425 \
						-i 3 2 0 0 \
						-s $3 \
						-z d:CAMERA_NO_CUSHION
					
					//	エルードカメラから出るとき（=エルード終了時）エルード中フラグをおろす
					if ($3 == 出る) {
						eval($f:w19a_エルード中フラグ = d:FALSE)
					}
				}
			}
		//	張り付きカメラ
		trap by008 d:PLAYER \
			-mask ？ \
			-state 8 \
			-dir 2048 256 \	//方向指定
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 張り付きカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 950,2496,0 -f 9000 \
					-a 200 \
					-i 2 2 0 0 \
					-s $3 \
					-z (d:CAMERA_NO_CUSHION | d:CAMERA_NO_PAD_ADJUST)
			}
// 連絡橋Ｂ１南側一番右
		//	エルード発動
		trap by009 d:PLAYER \
			-mask いる \
			-button d:ACTION_BUTTON \		//アクションボタン
			-state 0,4 \	//立ち状態or張り付き
			-exec {
				@南向きビヨンドハイ発動 by009 3000 $4 2250 3500 0x00000002
			}
		//	発動カメラ
		trap by009 d:PLAYER \
			-mask いる \
			-state 6 \
			-dir 0 256 \	//方向指定
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 ビヨンドカメラ \
					-c 0 \
					-b d:CAM_MIN,-2244,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,-3181,d:CAM_MAX \
					-r 100,2200,0 -f 6000 \
					-a 200 \
					-i 0 -1 0 0 \
					-s 1
			}
		//	エルードカメラ
		trap by009 d:PLAYER \
			-mask ？ \
			-state 5 \
			-dir 2048 256 \	//方向指定
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 ビヨンドカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 3950,2300,0 -f 8000 \
					-a 425 \
					-i 3 2 0 0 \
					-s $3 \
					-z d:CAMERA_NO_CUSHION
			}
		//	張り付きカメラ
		trap by009 d:PLAYER \
			-mask ？ \
			-state 8 \
			-dir 2048 256 \	//方向指定
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 張り付きカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 950,2496,0 -f 9000 \
					-a 200 \
					-i 2 2 0 0 \
					-s $3 \
					-z (d:CAMERA_NO_CUSHION | d:CAMERA_NO_PAD_ADJUST)
			}



	//	カネキャッチ
		trap by005 d:PLAYER \
			-mask いる \
			-button d:ACTION_BUTTON \
			-state  d:TRP_STATE_ELUDE_FALL \
			-exec {
				@エルード落下キャッチハイ by001 $1 -4500 $4 $5 $6 0  0x00000002
			}


	}





//###################################################################################
//									シナリオデモ
//###################################################################################

//	双眼鏡兵遭遇デモ開始チェック
	proc 双眼鏡兵遭遇デモ開始チェック {
		if ($w:p_story >= d:ST:P023_01_R01爆弾解体最後の一つ１無線デモ１終了) {
			eval($f:w19a_双眼鏡兵遭遇デモフラグ = d:TRUE)
		}
	}

//	双眼鏡兵遭遇デモ
	proc 双眼鏡兵遭遇デモ設定 {
		//	１Ｆ
		trap sc001 d:PLAYER  \
			-mask 入る \
			-e {
				if ($f:w19a_双眼鏡兵遭遇デモフラグ == d:FALSE) {
						//	双眼鏡兵遭遇デモフラグを立てる（危険モード時はデモは二度と見ない）
					eval ($f:w19a_双眼鏡兵遭遇デモフラグ = d:TRUE)

					//	潜入モード時のみデモが流れる
					if ($w:スタートアラートモード == d:ALERT_MODE_SENNYU) {
//						@双眼鏡兵遭遇デモ $1
						@双眼鏡兵遭遇デモ管理設定
					}
				}
			}
		//	Ｂ１
		trap sc002 d:PLAYER  \
			-mask 入る \
			-e {
				if ($f:w19a_双眼鏡兵遭遇デモフラグ == d:FALSE) {
						//	双眼鏡兵遭遇デモフラグを立てる（危険モード時はデモは二度と見ない）
					eval ($f:w19a_双眼鏡兵遭遇デモフラグ = d:TRUE)

					//	なしなし
					#if 0
					//	潜入モード時のみデモが流れる
					if ($w:スタートアラートモード == d:ALERT_MODE_SENNYU) {
						@双眼鏡兵遭遇デモ $1
					}
					#endif
				}
			}

	}

	proc 双眼鏡兵遭遇デモ管理設定 {
		chara プロック連続実行 双眼鏡兵遭遇デモ管理人 \
		-p 双眼鏡兵遭遇デモ管理
	}

	proc 双眼鏡兵遭遇デモ管理 {
		command パッドチェック \
			-no_use
		//	パッドが戻ったら（ステージ開始処理が終了したら）
		if ($status != 1) {
			//	なぜかロードカメラ死なないので
			chara カメラ設定 ロードカメラ \
				-s -1
			@双眼鏡兵遭遇デモ
			mesg プロック連続実行 双眼鏡兵遭遇デモ管理人 kill
		}
	}

	proc 双眼鏡兵遭遇デモ {

		//	シナリオデモ開始処理を行う
		@シナリオデモ開始処理
		//	特殊装備、ダンボールも解除
		@特殊装備解除
		@ダンボール解除

		//	パッドデモ再生＆デモ用敵兵起動
		chara パッドデモ 双眼鏡兵遭遇デモライデン \
			-file  w19a_paddemo_00 \
			-e 双眼鏡兵遭遇デモ終了処理

		mesg パッドデモ 双眼鏡兵遭遇デモライデン start

		//	キャンセルできるように
		chara デモキャンセルチェック 双眼鏡兵遭遇デモ -p 双眼鏡兵遭遇デモ終了後処理
	}

	proc 双眼鏡兵遭遇デモ終了処理 {
		@双眼鏡兵遭遇デモ終了後処理
	}

	proc 双眼鏡兵遭遇デモ終了後処理 {
		eval ($s:登場ポイント = 双眼鏡兵遭遇デモ後)
		eval ($i:プレイヤー初期Ｘ位置 = -15000)
		eval ($i:プレイヤー初期Ｙ位置 = 0)
		eval ($i:プレイヤー初期Ｚ位置 =  1500)
		eval ($i:プレイヤー初期方向 =  3072)
		eval ($b:プレイヤー初期姿勢 = d:FA_END_STAND)

		//	シナリオデモ終了処理を行う
		@シナリオデモ終了処理

		mesg パッドデモ 双眼鏡兵遭遇デモライデン kill
		mesg デモキャンセルチェック 双眼鏡兵遭遇デモ kill

		restart -s
	}



//	双眼鏡兵発見デモ
	proc 双眼鏡兵監視人 {
		#if d:DEBUG_PRINT
//			print 'KANSHIKANSHIKANSHIKANSHIKANSHIKANSHIKANSHIKANSHIKANSHIKANSHIKANSHIKANSHIKANSHIKANSHIKANSHI'
		#endif

		//	ゲームステータス取得
		command ゲットゲームステータス $i:ゲームステータス
		//	敵兵状態取得
		command ゲット敵兵モード 敵兵:02 $i:w19a_敵兵モード

		//	潜入モードのとき
		if ($w:アラートモード == d:ALERT_MODE_SENNYU) {
			//	発見〜危険の間
			if ( ($i:ゲームステータス & d:STATE_DETECT) == 0 ) {
				//	双眼鏡兵がプレイヤーを発見したら
				if ($i:w19a_敵兵モード & d:ENE_NOTICE_DETECT) {
					#if d:DEBUG_PRINT
					print 'DISCOVERDISCOVERDISCOVERDISCOVERDISCOVERDISCOVERDISCOVERDISCOVERDISCOVERDISCOVERDISCOVER'
					#endif

					eval ($f:w19a_双眼鏡兵発見デモフラグ = d:TRUE)
					command パッド操作 -release
					
					//	シナリオカメラ起動
					chara カメラ設定 シナリオカメラ \
						-c 1 \
						-p -9140,2049,-1039 -t 1643,4110,-576 \
						-a 1001 \
						-i 0 0 0 0 \
						-s 1

					//	シネマスクリーン起動
					mesg シネマスクリーン シネマ フェードアウト 1
					//	サイトを消す
					command サイト表示制御 \
						-switch off

					//	シナリオカメラを殺す
					chara delay シナリオカメラ終了ディレイ \
						-t 60\
						-e {
							chara カメラ設定 シナリオカメラ \
								-s -1
							command パッド操作 -cancel
							mesg シネマスクリーン シネマ フェードイン 1
							//	サイトを出す
							command サイト表示制御 \
								-switch on
						}
				}
			}
		}
	}

	proc 双眼鏡兵発見デモ設定 {
		trap en001 敵兵:02 \
			-mask ＊ \
			-exec {
				if ($3 == いる) {
					if ($f:w19a_双眼鏡兵所定位置フラグ == d:FALSE) {
						eval ($f:w19a_双眼鏡兵所定位置フラグ =d:TRUE)
						print '######################################################IN'
					}
				} else if ($3 == 出る) {
					if ($f:w19a_双眼鏡兵所定位置フラグ == d:TRUE) {
						eval ($f:w19a_双眼鏡兵所定位置フラグ =d:FALSE)
						print '######################################################OUT'
					}
				}
			}

		trap ca002 d:PLAYER \
			-mask いる \
			-exec {
				//	双眼鏡兵が生きているときのみ
//				if ($f:w20b_２Ｆ敵兵死亡フラグ == d:FALSE) {
				if ($b:w20b_２Ｆ敵兵状態 != d:DEAD) {
					//	双眼鏡兵発見デモを見ていない場合
					if ($f:w19a_双眼鏡兵発見デモフラグ == d:FALSE) {
						//	双眼鏡兵が所定位置にいるときのみ
						if ($f:w19a_双眼鏡兵所定位置フラグ == d:TRUE) {
							//	双眼鏡兵が覗いているときのみ
							if ($f:w19a_双眼鏡兵覗きフラグ == d:TRUE) {
								//	双眼鏡兵を監視する
								@双眼鏡兵監視人
							}
						}
					}
				}
			}
	}

	//	覗き始めたら
	proc 双眼鏡兵覗き開始 {
		eval ($f:w19a_双眼鏡兵覗きフラグ = d:TRUE)
	
	}
	proc 双眼鏡兵覗き終了 {
		eval ($f:w19a_双眼鏡兵覗きフラグ = d:FALSE)
	}



