	//	デバッグ用
//	eval ($w:p_story = d:ST:P041_02_R01エイムズ死亡後２無線デモ１終了)

command マップ設定 ＤＥ連絡橋 -set {
	//	デモが起きるかどうかのチェック
	@双眼鏡兵遭遇デモ開始チェック

#if d:SOUND	
	@サウンド設定	// データは最初に呼ぶ
#endif
	//	ノードアクセス関連
	if ( $f:w18a_ノードフラグ == 1 || $f:w20a_ノードフラグ == 1) {
		@レーダーオンオフチェック 1
	} else {
		@レーダーオンオフチェック 0
	}
	@常駐キャラ設定
	@ローカル変数初期化
	@設定値変更
	@プラグイン設定
	@水位設定
	@プレイヤー設定

#if d:ENEMY
	@敵配置チェック
	@コマンダー設定
#endif
#if d:BGM	
	@ＢＧＭ設定	// プレイヤー→敵兵→BGMの順で呼ぶ
#endif
#if d:SLIDE_DOOR
	@ドア設置
	@主観禁止壁設定
#endif
#if d:LOAD_TRAP
	@ロード設定
#endif
	@オブジェクト設定

#if d:SEA
	@海面設定
#endif
#if d:SKY
	@空設定
#endif
	@天井設定
#if d:ITEM
	@アイテム設定
#endif
#if d:FOG
	@フォグ設定
#endif
#if d:EFFECT
	@エフェクト設定
#endif
	@ＤＥ連絡橋風設定
#if d:BY_MOTION
	@ＤＥ連絡橋ビヨンド設定
#endif
	@カメラセット
	@ＤＥ連絡橋カメラ設定
#if d:DEBUG_CHARA
//	@デバッグキャラセット
#endif

	@エルード落下死設定
	@ジャンプ落下死設定

#if d:SCN_DEMO
//	@双眼鏡兵遭遇デモ設定		//	開始時処理の中へ
	@シナリオデモキャラセット

	@双眼鏡兵発見デモ設定
# endif

#if d:CHARA_LIGHT
	@キャラ用ライト設定
# endif
	@爆弾タイマー設置	//	爆弾イベント用
	@プラント編全体マップ設定  d:ＤＥ連絡橋マップ	//	全体マップ表示

}

// 無線用include ※位置は動かさないこと
#include "w19a_cdc.ch"


//初期マップの表示
command マップ表示 -show ＤＥ連絡橋


// 全てのセットが終わったところでフェードイン
@ＤＥ連絡橋開始時処理

//###################################################################################
//									各proc設定
//###################################################################################



//###################################################################################
//									全マップ共通
//###################################################################################

	proc サウンド設定 {
		#if d:DEBUG_PRINT 
			print 'sound_set'
		#endif
	//	英語版は
	#ifdef d:ENGLISH
		if ($w:p_story < d:ST:P041_02_R01エイムズ死亡後２無線デモ１終了) {
			chara サウンドマネージャー ＳＤマネ -pak 0
		} else {
			chara サウンドマネージャー ＳＤマネ -pak 1
		}

	//	それ以外は
	#else
		chara サウンドマネージャー ＳＤマネ -pak 0
	#endif

		//		ＳＥ設定
		@サウンド効果音設定
		command 弾痕ノーマル -n 0
		command 弾痕ノーマル -n 1
		command 弾痕ノーマル -n 3
		command 弾痕ノーマル -n 4

		command 跳弾ノーマル -n 0
		command 跳弾ノーマル -n 1
		command 跳弾ノーマル -n 3
		command 跳弾ノーマル -n 4
		command 跳弾ＳＥのみ -n 6

	}

	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT 
			print 'localvar_init'
		#endif
		eval($f:w19a_双眼鏡兵覗きフラグ = d:FALSE)
		eval($i:w19a_敵兵モード = 0)
		eval($f:w19a_双眼鏡兵所定位置フラグ = d:FALSE)

	}

	proc 設定値変更 {
		#if d:DEBUG_PRINT 
			print 'status_set'
		#endif
	}

	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif
		command プラグイン落下
	}

//###################################################################################
//									 プレイヤー
//###################################################################################

	proc プレイヤー設定 {
		#if d:DEBUG_PRINT
			print 'player_set'
		#endif

		#if d:RAIDEN
			chara プレイヤー d:PLAYER \
				-p $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,$i:プレイヤー初期Ｚ位置 \
				-d 0,$i:プレイヤー初期方向,0 \
				-s 0 \
				-m rai_def \
				-a raiden \
				-o rai_w19a

				//髪の毛
				@ライデン髪の毛設定 d:NORMAL_HAIR

				//	ＬＯＤ機能
//				@プレイヤーＬＯＤ設定 d:C_DISTANCE_TYPE 5000
//				@プレイヤーＬＯＤ設定 d:P_STATE_TYPE d:TRP_STATE_BEHIND

				chara ＬＯＤ制御 プレイヤーＬＯＤ \
				-name d:PLAYER \
				-type 2 \
				-model d:LOD_KMS_NAME \
				-value d:TRP_STATE_ELUDE \
				-value2 5000


		#else if d:SNAKE
			chara プレイヤー d:PLAYER \
				-p $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,$i:プレイヤー初期Ｚ位置 \
				-d 0,$i:プレイヤー初期方向,0 \
				-s 0 \
				-m sna_def -a snake -o rai_w19a

				//バンダナ
				chara ロープモデル３ バンダナ１ \
					-n sna_bdn1 \
					-d 1 \
					-y スネーク \
					-z 12 \
					-x 0,60,-90 \
					-m 12 \
					-p 250 \
					-k 350 \
					-o 110 \
					-f 1

				chara ロープモデル３ バンダナ２ \
					-n sna_bdn2 \
					-d 1 \
					-y スネーク \
					-z 12 \
					-x 0,50,-90 \
					-m 22 \
					-p 250 \
					-k 350 \
					-o 110 \
					-f 1
		#endif
	}

//###################################################################################
//								敵兵
//###################################################################################

	proc 敵配置チェック {
//		自分の来た場所で敵配置変更
		if ( ($s:登場ポイント == sp_w18a_w19a_0) || ($s:登場ポイント == sp_w18a_w19a_1) ) {
			eval($f:w19a_敵配置フラグ = d:STRUT_D)
		} else if ($s:登場ポイント == sp_w20a0_w19a_0) {
			eval($f:w19a_敵配置フラグ = d:STRUT_E)
		}
	}



//	敵兵配置

//	基本セット

	//	警備兵
	proc 警備兵セット {

		//	ストーリーフラグや難易度で分岐

		//	ファットマン戦まで
		if ($w:p_story < d:ST:P035_01_R01ファットマン爆弾解体終了１無線デモ１終了) {
			@警備兵０	//	敵３人	双眼鏡兵、屋上兵、１Ｆ〜Ｂ１兵

		//	ファットマン戦後
		} else {
			@警備兵１	//	敵４人	双眼鏡兵、屋上兵、１Ｆ〜Ｂ１兵
		}
	}

	//	攻撃兵
	proc 攻撃兵セット {
		//	ストーリーフラグや難易度で分岐
		//	エイムズ死亡まで
		if ($w:p_story < d:ST:P041_02_R01エイムズ死亡後２無線デモ１終了) {

			//	ノーマル以下
			if ($w:ゲーム設定 <= d:LEVEL_NORMAL) {
//				@攻撃兵０	//	敵１人	ノーマル
				@攻撃兵６	//	敵１人	ノーマル（サポート兵化）
//				@攻撃兵６Ａ
			//	ハード
			} else if ($w:ゲーム設定 <= d:LEVEL_HARD) {
//				@攻撃兵１	//	敵２人	ノーマル
				@攻撃兵７	//	敵２人	ノーマル（サポート兵化）

			//	エクストリーム
			} else {
				@攻撃兵Ａ	//	敵４人	ノーマル（サポート兵化）
			}

		//	エイムズ死亡後から
		} else {

			//	ノーマル以下
			if ($w:ゲーム設定 <= d:LEVEL_NORMAL) {
//				@攻撃兵５	//	敵１人	ハイテクノーマル
				@攻撃兵９	//	敵１人	ハイテクノーマル（サポート兵化）

			//	ハード
			} else if ($w:ゲーム設定 <= d:LEVEL_HARD) {
//				@攻撃兵４	//	敵２人	ハイテクノーマル
				@攻撃兵８	//	敵２人	ハイテクノーマル（サポート兵化）

			//	エクストリーム
			} else {
				@攻撃兵Ｂ	//	敵４人	ハイテクノーマル（サポート兵化）
			}

		}
	}

	//	@攻撃兵０	//	敵１人	ノーマル
	//	@攻撃兵１	//	敵２人	ノーマル
	//	@攻撃兵２	//	敵２人	盾兵
	//	@攻撃兵３	//	敵２人	ショットガン
	//	@攻撃兵４	//	敵２人	ハイテクノーマル
	//	@攻撃兵５	//	敵１人	ハイテクノーマル

	//	@攻撃兵６	//	敵１人	ノーマル（サポート兵化）
	//	@攻撃兵７	//	敵２人	ノーマル（サポート兵化）
	//	@攻撃兵８	//	敵２人	ハイテクノーマル（サポート兵化）
	//	@攻撃兵９	//	敵１人	ハイテクノーマル（サポート兵化）

	//	@攻撃兵Ａ	//	敵４人	ノーマル（サポート兵化）
	//	@攻撃兵Ｂ	//	敵４人	ハイテクノーマル（サポート兵化）

	//	@攻撃兵６Ａ	//	敵１人	ノーマル（サポート兵化）Ｂ１対応


//	コマンダーセット

	//	警備兵
	proc 警備兵コマンダー {
		#if d:DEBUG_PRINT
			print 'wccomm_set'
		#endif
		
		chara 警備コマンダー wccomm -e { 警備兵セット }

	}

	//	攻撃兵
	proc 攻撃兵コマンダー {
		#if d:DEBUG_PRINT
			print 'atcomm_set'
		#endif

		chara 攻撃コマンダー atcomm \
			-e {攻撃兵セット} \
			-wait (60*3) \			/*危険開始時の出動遅らせ時間*/
			-avoidwait (60*5) \		/*回避モードで始まる場合のみ有効*/
			-status 0x01
	}

	//	コマンダー

	//	司令官音声
	resource ghq_area_alert_voice {
	w19a:
		$t{
			// PLAREA0
			t:vc040174,	//	指揮官　　「了解。増援部隊をＤＥ連絡橋に派遣する！侵入者を止めろ！」
			t:vc040175,	//	指揮官　　「了解。応援部隊、ＤＥ連絡橋へ急行せよ！敵を逃がすな」
			-2,
			// PLAREA1
			t:vc040170,	//	指揮官　　「了解。増援部隊、ＤＥ連絡橋に急行せよ！Ｄ脚入口を守れ！」
			t:vc040171,	//	指揮官　　「了解。増援部隊をＤＥ連絡橋・Ｄ脚入口に送る！奴を逃がすな！」
			-2,
			// PLAREA2
			t:vc040172,	//	指揮官　　「了解。応援部隊、ＤＥ連絡橋に向かえ！Ｅ脚入口を守れ！」
			t:vc040173,	//	指揮官　　「了解。増援部隊、ＤＥ連絡橋・Ｅ脚入口へ向かえ！敵を仕留めろ！」
			// PLAREA0
			t:vc040174,	//	指揮官　　「了解。増援部隊をＤＥ連絡橋に派遣する！侵入者を止めろ！」
			t:vc040175,	//	指揮官　　「了解。応援部隊、ＤＥ連絡橋へ急行せよ！敵を逃がすな」
			-1
		}
	}

	resource ghq_caution_voice {

	//	攻撃兵が残っていない場合
	w19a:
		$t{
			t:vc040601,	//	指揮官　　「了解、総員、警戒を強化せよ」

			t:vc040491,	//	指揮官　　「攻撃チームは引き返せ、警戒チームはそのまま現場に残れ」
			t:vc040492,	//	指揮官　　「攻撃チームは撤収、警戒チームは警戒を続行せよ」
			t:vc040493,	//	指揮官　　「攻撃チーム帰投せよ、警戒チームはそのまま警戒に当たれ」
			t:vc040496,	//	指揮官　　「攻撃チーム、配置に戻れ」
			t:vc040497,	//	指揮官　　「攻撃チーム、撤収せよ」
			-2,
			t:vc040426,	//	指揮官　　「ＤＥ連絡橋との連絡が途絶えた」
			-1
		}

	//	攻撃兵が残っている場合
	w19a-2:
		$t{
			// PLAREA0
			t:vc040337,	//	指揮官　　「了解。ＤＥ連絡橋を増員する。警戒を強化しろ」

			t:vc040333,	//	指揮官　　「了解。ＤＥ連絡橋・Ｄ脚入口に増員を派遣する。警戒を強化しろ」
			t:vc040334,	//	指揮官　　「了解。ＤＥ連絡橋に増員。Ｄ脚入口の警備を固めろ」

			t:vc040335,	//	指揮官　　「了解。ＤＥ連絡橋・Ｅ脚入口に増員を派遣する。警戒を強化しろ」
			t:vc040336,	//	指揮官　　「了解。ＤＥ連絡橋に増員。Ｅ脚入口の警備を固めろ」
			-2,
			t:vc040426,	//	指揮官　　「ＤＥ連絡橋との連絡が途絶えた」
			-1
		}
	}

	proc コマンダー設定 {
		#if d:DEBUG_PRINT
			print 'commander_set'
		#endif

		chara コマンダー 敵兵セット \
			-w 警備兵コマンダー \
			-a 攻撃兵コマンダー \
			-r 25750,0,2250 ＤＥ連絡橋 -17750,0,-3000 ＤＥ連絡橋 -18500,-4500,-4000 ＤＥ連絡橋 \
			-c 25750,0,2250 ＤＥ連絡橋 -17750,0,-3000 ＤＥ連絡橋 -18500,-4500,-4000 ＤＥ連絡橋 \
			-v [ene_plant_voice:01] \
			-x [ghq_area_alert_voice:w19a] \
			-y [ghq_caution_voice:w19a-2] \
			-z $i:敵標準麻酔持続 \
			-o $i:敵標準気絶持続 \
			-b $w:敵標準再発生数 \
			-s d:ENE_STAGE_GPS \
			-m $w:スタートアラートモード \
			-h $i:標準警戒時間 \		// 警戒時間
			-e	1 0 双眼鏡兵覗き開始 \
				1 8 双眼鏡兵覗き終了

	}



//	警備兵セット

	//	警備兵３人	双眼鏡兵、屋上兵、１Ｆ〜Ｂ１兵
	proc 警備兵０ {
		#if d:DEBUG_PRINT
			print 'watcher_set'
		#endif
		if ($f:w19a_敵配置フラグ == d:STRUT_D) {
			print 'DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD'
			chara 警備兵 敵兵:01 \
				-r 0 -n 0 -d 13000,0,0 ＤＥ連絡橋 \
				-h $w:敵標準聴力 \
				-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
				-l $w:敵標準体力 \
				-f $w:敵標準気絶 \
				-j ドッグタグ_敵兵 \
					[dogtag:plt_w19a_guard_ve_01] [dogtag:plt_w19a_guard_ea_01] [dogtag:plt_w19a_guard_no_01] \
					[dogtag:plt_w19a_guard_ha_01] [dogtag:plt_w19a_guard_vh_01] \
				-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
				-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３

		} else if ($f:w19a_敵配置フラグ == d:STRUT_E) {
			print 'EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE'
			chara 警備兵 敵兵:01 \
				-r 5 -n 0 -d -13000,0,0 ＤＥ連絡橋 \
				-h $w:敵標準聴力 \
				-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
				-l $w:敵標準体力 \
				-f $w:敵標準気絶 \
				-j ドッグタグ_敵兵 \
					[dogtag:plt_w19a_guard_ve_01] [dogtag:plt_w19a_guard_ea_01] [dogtag:plt_w19a_guard_no_01] \
					[dogtag:plt_w19a_guard_ha_01] [dogtag:plt_w19a_guard_vh_01] \
				-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
				-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３
		}


		//	開始時の敵兵状態をセットする
		@敵兵開始状態チェック	w19a ＤＥ連絡橋 敵兵:02 18250 5500 0 2048 \
								w19a ＤＥ連絡橋 敵兵:03 24250 11500 -12500 2048

		//	Ｅ脚双眼鏡兵
#if 0
		//	死んでいなかったら
//		if ($f:w20b_２Ｆ敵兵死亡フラグ == d:FALSE) {
		if ($b:w20b_２Ｆ敵兵状態 != d:DEAD) {
			chara 警備兵 敵兵:02 \
//				-r 1 -n 0 -d 17500,5500,-3125 ＤＥ連絡橋 \
				-r 1 -n 0 -d 34000,5500,8500 ＤＥ連絡橋 \
				-h $w:敵標準聴力 \
				-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
				-l $w:敵標準体力 \
