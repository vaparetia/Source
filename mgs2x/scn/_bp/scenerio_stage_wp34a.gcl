// ------------------------------------
// 各gclで必要なdefine
// ------------------------------------
// 共通プロック切り分け用
#define		STAGE_VR		1		// モード
#define		STAGE_WP34A		1		// ステージ名
#define		VR_WEAPON		1		// VRステージの呼び分け

#define		STAGE_START		1		// ステージ開始直後処理


// ------------------------------------
// 各種スイッチ用define
// ------------------------------------
// デバッグ関係
#ifdef	d:FIX_MODE
	#define		DEBUG_CHARA		0		// デバッグキャラ全体(FIX時は0)
#else
	#define		DEBUG_CHARA		0		// デバッグキャラ全体
#endif
#define		CHARA_CAMERA	0		// キャラ追従カメラ
#define		TARGET_CHARA	敵兵:01	// キャラ追従カメラのターゲット
#define		SCREENSHOT		0		// スクリーンショット
#define		USB_KEY			0		// USBキーボード


// ------------------------------------
// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME			ws34a
#define		KMS_NAME			ws34a
#define		TONBO_KMS_NAME		ws34a_tonbo
#define		LINE_KMS_NAME		ws34a_line

// キャラクター関係
#define		PLAYER		ライデン


// ------------------------------------
// ローカル変数
// ------------------------------------


// ------------------------------------
// 的ルート番号
// ------------------------------------
enum M_R {
	//	グレネード４面用
//	共通ルート０ = 0,	// 欠番
	ライデンルート１ = 1,
	ライデンルート２, ライデンルート３, ライデンルート４, ライデンルート５, ライデンルート６,

	スネークルート７, スネークルート８, スネークルート９, スネークルート１０, スネークルート１１,
	スネークルート１２, スネークルート１３, スネークルート１４,

	前作スネークルート１５, 前作スネークルート１６, 前作スネークルート１７, 前作スネークルート１８, 前作スネークルート１９,
	前作スネークルート２０, 前作スネークルート２１, 前作スネークルート２２,

//	スネークルート２３, スネークルート２４, スネークルート２５, スネークルート２６,
//	スネークルート２７, スネークルート２８, スネークルート２９, スネークルート３０, スネークルート３１,
}


// ------------------------------------
// include
// ------------------------------------

#include "rai_wp34a.mh"		// 強制モーションリスト

#include "stdch.h"			// 常駐キャラ
//#include "enevoice.h"
#include "a_stdproc.h"		// アナザーミッション設定ファイル
#include "sload.h"			// ロード関数
#include "sound.h"
#include "item_info.h"
#include "a_item_info.h"
