		} else if ( ($s:選択プレイヤー == スネーク) || ($s:選択プレイヤー == プリスキン) ) {

			// act 2
			// ==========================
/*
			if ( ($1 == 壁:01) || ($1 == 壁:02) || ($1 == 壁:03) || ($1 == 壁:04) || ($1 == 壁:05) ) {
			} else if ( ($1 == 壁:06) || ($1 == 壁:07) || ($1 == 壁:08) || ($1 == 壁:09) || ($1 == 壁:10) ) {
//				mesg ＶＲ的共通 移動的:07 移動開始
			} else if ( ($1 == 壁:11) || ($1 == 壁:12) || ($1 == 壁:13) || ($1 == 壁:14) || ($1 == 壁:15) ) {
			}
*/
		// 前作スネークを選択
		} else if ( $s:選択プレイヤー == 前作スネーク ) {

		}
	}

	// 敵兵や的の処理
	// ------------------------------------
	proc ＶＲ標的グレネード４面設定 {

			// 共通壁
			// ==========================
			command foreach -argc 4 -repeat 15 \
			-data { \
				// 壁名, Ｘ, Ｙ, Ｚ 
				{ 壁:01,  3000,  4000, -10050 }\
				{ 壁:02,  3000,  2000, -10050 }\
				{ 壁:03,  3000,     0, -10050 }\
				{ 壁:04,  3000, -2000, -10050 }\
				{ 壁:05,  3000, -4000, -10050 }\
				{ 壁:06,     0,  4000, -10050 }\
				{ 壁:07,     0,  2000, -10050 }\
				{ 壁:08,     0,     0, -10050 }\
				{ 壁:09,     0, -2000, -10050 }\
				{ 壁:10,     0, -4000, -10050 }\
				{ 壁:11, -3000,  4000, -10050 }\
				{ 壁:12, -3000,  2000, -10050 }\
				{ 壁:13, -3000,     0, -10050 }\
				{ 壁:14, -3000, -2000, -10050 }\
				{ 壁:15, -3000, -4000, -10050 }\
			} \
			-exec { \
				chara ＶＲ壁 $1 \
//					-flag $i:壁フラグＡ \
					-pos $2 $3 $4
			}

		// ライデン or タキシードスネークを選択
		if ( ($s:選択プレイヤー == ライデン) ||  ($s:選択プレイヤー == タキシードスネーク) ) {

			// act 1
			// ==========================
			command foreach -argc 3 -repeat 6 \
			-data { \
				// 的名,     ルート,              スピード
				// act 1 ----------
				{ 移動的:01, d:M_R:ライデンルート１, 40 }\
				{ 移動的:02, d:M_R:ライデンルート２, 40 }\
				{ 移動的:03, d:M_R:ライデンルート３, 60 }\
				{ 移動的:04, d:M_R:ライデンルート４, 60 }\
				{ 移動的:05, d:M_R:ライデンルート５, 20 }\
				{ 移動的:06, d:M_R:ライデンルート６, 10 }\
			} \
			-exec { \
				if( $s:選択プレイヤー == タキシードスネーク ) {
					$$b:標的セット数 = $$b:標的セット数 + 1;
					if( $$b:標的セット数 % 2 ) {
						$$i:標的フラグ = ( $$i:標的フラグＥ | d:VR_TRG_HIDESTART );
					} else {
						$$i:標的フラグ = ( $$i:標的フラグＥ | d:VR_TRG_VISIBLESTART );
					}
				} else {
					$$i:標的フラグ = $$i:標的フラグＥ;
				}

				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグ \
					-route $2 \
					-speed $3
			}

		// スネーク or プリスキンを選択
		} else if ( ($s:選択プレイヤー == スネーク) || ($s:選択プレイヤー == プリスキン) ) {

			command foreach -argc 4 -repeat 8 \
			-data { \
				// 的名,     フラグ,            ルート,                 スピード
				// act 1 ----------
				{ 移動的:01, $$i:標的フラグＥ, d:M_R:スネークルート７,    60 }\
				{ 移動的:02, $$i:標的フラグＥ, d:M_R:スネークルート８,    60 }\
				{ 移動的:03, $$i:標的フラグＤ, d:M_R:スネークルート９,    20 }\
				{ 移動的:04, $$i:標的フラグＤ, d:M_R:スネークルート１０,  40 }\
				{ 移動的:05, $$i:標的フラグＥ, d:M_R:スネークルート１１,  40 }\
				{ 移動的:06, $$i:標的フラグＥ, d:M_R:スネークルート１２,  40 }\
				{ 移動的:07, $$i:標的フラグＤ, d:M_R:スネークルート１３,  20 }\
				{ 移動的:08, $$i:標的フラグＤ, d:M_R:スネークルート１４,  75 }\
			} \
			-exec { \
				if( $s:選択プレイヤー == プリスキン ) {
					$$b:標的セット数 = $$b:標的セット数 + 1;
					if( $$b:標的セット数 % 2 ) {
						$$i:標的フラグ = ( $2 | d:VR_TRG_HIDESTART );
					} else {
						$$i:標的フラグ = ( $2 | d:VR_TRG_VISIBLESTART );
					}
//					$$i:標的フラグ = ( $$i:標的フラグＥ | d:VR_TRG_STEALTH );
				} else {
					$$i:標的フラグ = $2;
				}

				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグ \
					-route $3 \
					-speed $4
			}

			// act 2 （壁の裏に蠢く物が...）
			// ==========================

		//	前作スネークを選択
		} else if ( $s:選択プレイヤー == 前作スネーク ) {

			command foreach -argc 3 -repeat 8 \
			-data { \
				// 的名,     ルート,                 スピード
				// act 1 ----------
				{ 移動的:01, d:M_R:前作スネークルート１５,  0 }\
				{ 移動的:02, d:M_R:前作スネークルート１６,  0 }\
				{ 移動的:03, d:M_R:前作スネークルート１７,  0 }\
				{ 移動的:04, d:M_R:前作スネークルート１８,  0 }\
				{ 移動的:05, d:M_R:前作スネークルート１９,  0 }\
				{ 移動的:06, d:M_R:前作スネークルート２０,  0 }\
				{ 移動的:07, d:M_R:前作スネークルート２１,  0 }\
				{ 移動的:08, d:M_R:前作スネークルート２２,  0 }\
			} \
			-exec { \
				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグＤ \
					-route $2 \
					-speed $3
			}

		}

	}

	proc ＶＲ初期配置標的グレネード４面設定 {
		// 共通標的 （主にライデン）
		mesg ＶＲ的共通 移動的:01 移動開始
		mesg ＶＲ的共通 移動的:02 移動開始
		mesg ＶＲ的共通 移動的:03 移動開始
		mesg ＶＲ的共通 移動的:04 移動開始
		mesg ＶＲ的共通 移動的:05 移動開始
		mesg ＶＲ的共通 移動的:06 移動開始

		// 他キャラ選択時の追加標的s
		// スネーク or プリスキン or 前作スネーク
		if ( ($s:選択プレイヤー == スネーク) || ($s:選択プレイヤー == プリスキン) || ($s:選択プレイヤー == 前作スネーク) ) {
			mesg ＶＲ的共通 移動的:07 移動開始
			mesg ＶＲ的共通 移動的:08 移動開始
		}
	}


//###################################################################################
//									 ＢＧＭ
//###################################################################################

	// ------------------------------------
	// ＢＧＭの設定
	// ------------------------------------
	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT
			print 'bgm_set'
		#endif

		chara ＢＧＭマネージャー ＢＧＭマネ
	}


//###################################################################################
//									 アイテム
//###################################################################################

	// ------------------------------------
	// アイテムの設定
	// ------------------------------------
	// 再発生が必要な時は以下のプロックの中を記述する
	// ------------------------------------
	proc アイテム取得時番号設定 $:ボックス名 {
		#if d:DEBUG_PRINT
			print 'item_no_set'
		#endif
	}
	// アイテムの設置
	// ------------------------------------
	proc アイテム設定 {
		#if d:DEBUG_PRINT
			print 'item_set'
		#endif

		// ライデン or スネークを選択
		if ( ($s:選択プレイヤー == ライデン) ||  ($s:選択プレイヤー == スネーク) ) {
				@A_グレネード_初期設置 グレネード弾薬 -1500 -150 0 0 なし 6

		// タキシードスネーク or プリスキンを選択
		} else if ( ($s:選択プレイヤー == タキシードスネーク) || ($s:選択プレイヤー == プリスキン) ) {
				@A_ＲＧＢ６_初期設置 ＲＧＢ６本体 1500 -150 0 0 なし 24
				@弾薬_ＲＧＢ６_初期設置 ＲＧＢ６弾薬:01  4000 -1150 -1000 0
				@弾薬_ＲＧＢ６_初期設置 ＲＧＢ６弾薬:02 -4000 -1150 -1000 0

		}
		// 前作スネークはグレネード一筋
	}



//###################################################################################
//									 エフェクト
//###################################################################################

	// ------------------------------------
	// 光源関係
	// ------------------------------------
	// フォグ
	// ------------------------------------
	// キャラ用光源(マップの設置が終わってから設定することで、キャラだけに光を当てる)
	// ------------------------------------



//###################################################################################
//									 カメラ
//###################################################################################
	// ------------------------------------
	// カメラ関係の設定
	// ------------------------------------
	// ステージカメラ設定
	// ------------------------------------
	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'chara_camera & stage_camera_set'
		#endif

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0
		chara カメラ メインカメラ		-c 0 -l 2 -p 40
		chara カメラ クリア時カメラ		-c 0 -l 0 -p 10

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 100,2048,0 \
			-f 9000 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}
	// ステージ固有のカメラ設定
	// ------------------------------------
	proc 武器訓練グレネード４面カメラ設定 {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif
	}



//###################################################################################
//									 その他
//###################################################################################


// -----------------------------------------------------------------------------------
// 以下デバッグ専用proc
// -----------------------------------------------------------------------------------
// デバッグキャラ
// ------------------------------------
proc デバッグキャラセット {
	#if d:DEBUG_PRINT
		print 'debug_chara_set'
	#endif

	#if d:CHARA_CAMERA
		chara キャラカメラ 敵兵カメラ \
			-c d:TARGET_CHARA \
			-s -920,610,200 \
			-r -200,1024,0
	#endif

	#if d:SCREENSHOT
		chara スクリーンショット shot
	#endif

	#if d:USB_KEY
		chara USBキーボード実行 test \
			-e d:KBD_ESC {
				mesg プレイヤー d:PLAYER position -5500, -13000, -500
			} \
	#endif
}

