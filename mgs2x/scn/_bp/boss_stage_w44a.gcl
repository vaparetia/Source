// 各gclで必要なdefine
// ------------------------------------
// モード
#define		BOSS_MODE		1		// 共通プロック切り分け用

// include
// ------------------------------------
#include "w44a.gcl"

// マップ設定は各boss.gclで
// ------------------------------------
chara マップ 第二メタルハンガー \
	-k d:KMS_NAME0 \
	-h d:HZX_NAME, 0 \
	-l d:LT2_NAME

command マップ設定 第二メタルハンガー -set {
	//----- 基本設定
	@ボスサバイバル用設定値変更
	@SS_跳弾弾痕設定
	@常駐キャラ設定

	@難易度調整
	@ボスラッシュプレイヤー設定 33000 4000 -94000 2048 d:FA_END_STAND sna_w44a rai_w44a
	@敵兵設定

	//----- オブジェクト
	@ドア設定
	@その他オブジェクト設定

	//----- フォグ、カメラ、ロード
	@SS_フォグ_キャラ用ライト設定
	@カメラ設定

	@ボスラッシュ用アイテム設定

	@ボスラッシュ開始時キャラ設定
}


// 全てのセットが終わったところでフェードイン
//初期マップの表示
command マップ表示 -show 第二メタルハンガー



// 各proc設定
//-------------------------------------------------------------------------------------
proc ボスサバイバル用設定値変更 {
	if ( $s:ボスラッシュプレイヤー == スネーク ) {
	} else {
		// ブレード(プレイヤーより前に)
		command プラグインブレード -m rai_blade
	}

	$s:登場ポイント = ボスサバイバルスタート;
}
