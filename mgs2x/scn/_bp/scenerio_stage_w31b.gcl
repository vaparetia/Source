	// 子画面設定
	// ------------------------------------
	proc 子画面設定 {
		#if d:DEBUG_PRINT
			print 'sub_camera_set'
		#endif

		chara サブ画面 子画面 \
			-w (512-d:SUB_MARGIN-d:SUB_WIDTH),d:SUB_MARGIN (512-d:SUB_MARGIN),(d:SUB_HEIGHT+d:SUB_MARGIN)
	}


/****************************************************************************************/
// 機雷
/****************************************************************************************/
	proc 機雷Ａ{
		if( $f:w31b_機雷01爆発した == 0 ) {
			chara 水中機雷 機雷:01 \
				-position 4750 -9000 -243000 \
				-rotate 0 0 0 \
				-proc 機雷爆破
		}
	}
	proc 機雷Ｂ{
		if( $f:w31b_機雷02爆発した == 0 ) {
			eval($f:w31b_機雷02爆発した =0)
			chara 水中機雷 機雷:02 \
				-position 9000 -7500 -228000 \
				-rotate 0 0 0 \
				-proc 機雷爆破
		}
	}
	proc 機雷Ｃ{
		if( $f:w31b_機雷03爆発した == 0 ) {
			eval($f:w31b_機雷03爆発した =0)
			chara 水中機雷 機雷:03 \
				-position 9000 -9700 (-228000 + 2500 ) \
				-rotate 0 0 0 \
				-proc 機雷爆破
		}
	}

	proc 機雷設置 {
		#if d:DEBUG_PRINT
			print 'kirai_set'
		#endif
/*
		if( `@壊れ物再セットチェック $b:w31b_機雷破壊フラグ[0]` ) {
			eval($f:w31b_機雷01爆発した =0)
			chara 水中機雷 機雷:01 \
				-position 4750 -9000 -243000 \
				-rotate 0 0 0 \
				-proc 機雷爆破
		}

		if( `@壊れ物再セットチェック $b:w31b_機雷破壊フラグ[1]` ) {
			eval($f:w31b_機雷02爆発した =0)
			chara 水中機雷 機雷:02 \
				-position 9000 -7500 -228000 \
				-rotate 0 0 0 \
				-proc 機雷爆破
		}

		if( `@壊れ物再セットチェック $b:w31b_機雷破壊フラグ[2]` ) {
			eval($f:w31b_機雷03爆発した =0)
			chara 水中機雷 機雷:03 \
				-position 9000 -9700 (-228000 + 2500 ) \
				-rotate 0 0 0 \
				-proc 機雷爆破
		}
*/
		if( $w:ゲーム設定 == d:LEVEL_VERYEASY ) {
			@機雷Ｂ
		} else if( $w:ゲーム設定 == d:LEVEL_EASY ) {
			@機雷Ａ
			@機雷Ｂ
		} else {
			@機雷Ａ
			@機雷Ｂ
			@機雷Ｃ
		}
	}

	proc 機雷爆破 {

		// 爆破時なら
/*
		if( $2 == 1 ) {
			if( $1 == 機雷:01 ) {
				eval( $b:w31b_機雷破壊フラグ[0] = $w:グローバルロード回数 )
				eval($f:w31b_機雷01爆発した =1)
			}
			if( $1 == 機雷:02 ) {
				eval( $b:w31b_機雷破壊フラグ[1] = $w:グローバルロード回数 )
				eval($f:w31b_機雷02爆発した =1)
			}
			if( $1 == 機雷:03 ) {
				eval( $b:w31b_機雷破壊フラグ[2] = $w:グローバルロード回数 )
				eval($f:w31b_機雷03爆発した =1)
			}
		}
*/
		if( $2 == 1 ) {
			if( $1 == 機雷:01 ) {
				eval($f:w31b_機雷01爆発した =1)
			}
			if( $1 == 機雷:02 ) {
				eval($f:w31b_機雷02爆発した =1)
			}
			if( $1 == 機雷:03 ) {
				eval($f:w31b_機雷03爆発した =1)
			}
		}
	}

	proc パイプ滝 { // added by Okuta 2001/07/17

		if( $w:p_story < ( d:ST:P062_01_P01エマとＡＩ１ポリゴンデモ１開始 -1 ) ) {
	        chara パイプ流水 ぱいぷみず \
				-unit 		8	\
				-vert 		12 	\
				-nring		12	\
				-pos		9400, -4500, -257800	\
				-fally		-6500	\
				-rot		0, 0, 0	\
				-offset		10, 0, 0	\
				-ang		16, 124, 0	\
				-initspd	30		\
				-speed		55		\
				-binitsize	5		\
				-daimsize	250		\
				-color		0x20202015	\
				-gravity	5

			mesg パイプ流水 ぱいぷみず スリープモード

		}

	}

