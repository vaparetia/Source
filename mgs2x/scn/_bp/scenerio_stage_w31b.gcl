			-exec {
				chara カメラ設定 水面カメラ０ \
					-c 0 \
					-b 11320 -2818 -255684  11320 -2818 -255684 \
					-l 11320 d:CAM_MIN -257762  11320 d:CAM_MAX -256178 \
					-r 933,2039,0 -f 4288 \
