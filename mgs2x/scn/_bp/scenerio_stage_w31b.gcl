// マップ設定
// ------------------------------------
	chara マップ シェル２中央棟Ｂ１ -h d:HZX_NAME,0 \
									-l d:LT2_NAME

// 平野追加。デモ再生用ヘッダ。この位置を変えないこと。

command マップ設定 シェル２中央棟Ｂ１ -set {

	#if d:SOUND
		@サウンド設定	// データは最初に呼ぶ
	#endif
		@レーダーオンオフチェック $f:w31b_ノードフラグ		// 常駐より前に
		@常駐キャラ設定
		@ローカル変数初期化
		@設定値変更
		@プラグイン設定
		@プレイヤー設定
		@プラント編全体マップ設定 d:シェル２中央棟マップ	// stdproc.hで定義
		@マップをプットオブジェで表示
	#if d:BGM
		@ＢＧＭ設定	// プレイヤー→敵兵→BGMの順で呼ぶ
	#endif
		@ノード端末設定 2048

	#if d:WT_DOOR
		@水密ドア設置
	#endif
	#if d:SLIDE_DOOR
		@ドア設置
	#endif
	#if d:ELEVATOR
		@エレベーター設置 シェル２中央棟Ｂ１
	#endif
	#if d:LOAD_TRAP
		@ロード設定
	#endif
		@シナリオデモキャラセット
		@アイテム設置
	#if d:FOG
		@フォグ設定
	#endif
	#if d:EFFECT
		@エフェクト設定
		//@水溜まり
	#endif

		@スポットライト設置

	#if d:WATER
		@水中モード基本キャラ設定
		@水中モードプレイヤー連動キャラ設定 water
		@息継ぎレーダー

		@水中セット
		@水中出入り処理
		@水上フォグ検査設定
		@パイプ滝 // added by Okuta 2001/07/17
		@水中差し込み光
	#endif
		@息継ぎポイント設定		// 新プラグイン水中を起動してから設定
		@息継ぎポイントカメラ設定
		@カメラセット
		@シェル２中央棟Ｂ１カメラ設定

		@機雷設置
		@エマ設置
		@ピーターさん
		@崩落血セット

		@かみかみまん
		@エリアダスト
		@水中エフェクト
		@浮遊物

		@ふなむし設置		// ヴァンプ戦後設置される
		@壁ふなむし

		#if d:MY_DEBUG
			@デバッグキャラセット
		#endif
}

/***************************************************************************************************/
// 無線用include ※位置は動かさないこと
/***************************************************************************************************/
#include "w31b_cdc.ch"
#include "p_force_cdc.ch"

/***************************************************************************************************/
// ステージ開始時処理
/***************************************************************************************************/

	command マップ表示 -show シェル２中央棟Ｂ１
	@キャラ用ライト設定

print '登場ポイント'
	// 全てのセットが終わったところでフェードイン
	if( $s:登場ポイント == sp_w31a_w31b_0 ) {
print 'sp_w31a_w31b_0'
	///////////////////////
	// エレベーターから

		@ステージ開始時処理（エレベーター） d:wn_シェル２中央棟Ｂ１第一濾過室

		// 南側モデルと天井の非表示
		mesg 天井君 天井モデル３ 常に表示		// 消える
		mesg プットオブジェ モデル３ off

		eval ( $f:水中判定フラグ = 0 )
		eval ( $f:カメラ前曇りフラグ = 0 )

	} else if ( $s:登場ポイント == sp_w31c0_w31b_0 ) {
print 'sp_w31c0_w31b_0'
	///////////////////////
	// ヴァンプステージから

		@ステージ開始時処理（ステージ名表示） \
				d:LOAD_TYPE:SL_DOOR_TYPE \
				ヴァンプ戦ドア \
				3400 \
				d:DEFAULT_M_TYPE \
				d:wn_シェル２中央棟Ｂ１第一濾過室

		// 北側モデルと天井の非表示
		mesg 天井君 天井モデル１ 常に表示		// 消える
		mesg プットオブジェ モデル１ off

	} else if ( $s:登場ポイント == ピーターデモ後 ) {
print 'ピーターデモ後'
	/////////////////////////////
	// ピーターデモからリスタート
		eval( $f:ピーターデモ後スポットライト配置 = 1 )

		@ステージ開始時処理 \
				d:LOAD_TYPE:NO_MOVE_TYPE \
				ドア指定無し \
				0 \
				d:DEFAULT_M_TYPE

		eval( $s:登場ポイント = sp_w31a_w31b_0 )
		eval( $i:プレイヤー初期Ｘ位置 = -1276 ) ;
		eval( $i:プレイヤー初期Ｙ位置 = -4000 ) ;
		eval( $i:プレイヤー初期Ｚ位置 = -254172 ) ;
		eval( $i:プレイヤー初期方向 = 0 ) ;

		command varsave $s:登場ポイント
		command varsave $i:プレイヤー初期Ｘ位置
		command varsave $i:プレイヤー初期Ｙ位置
		command varsave $i:プレイヤー初期Ｚ位置
		command varsave $i:プレイヤー初期方向

		mesg プレイヤー d:PLAYER water 水底から 0 d:WEST

		eval( $f:global_水中環境音フラグ = 0 )

	} else if( $s:登場ポイント == ポリデモ全て終了 ) {
print '****************'
print '****************'
print '****************'
print '****************'
print 'ポリデモ全て終了'
	////////////////////
	// ＭＯ渡しデモ後
		@ステージ開始時処理 d:LOAD_TYPE:NO_MOVE_TYPE ドア無し 0 d:DEFAULT_M_TYPE
		command varsave $w:p_story

		@ダンボール解除
		if ( $w:アイテム == d:アイテム:煙草 ) {
			eval($w:アイテム = d:アイテム:素手);
		}

		mesg プレイヤー d:PLAYER water 水面から 0 d:SOUTH

	} else {
		#if d:ASSERT
			if($s:d_num == not_demo) {
				command assert ( d:FALSE ) 'unexpected load point'
			}
		#endif
	}


/***************************************************************************************************/
// 各proc設定
/***************************************************************************************************/
	proc マップをプットオブジェで表示 {

		chara プットオブジェ ポスター -m w31b_poster -r 0,0,0 -p 0,0,0 -s 100,100,100 -l d:LT2_NAME

		chara プットオブジェ モデル０ -m w31b0 -r 0,0,0 -p 0,0,0 -s 100,100,100 -l d:LT2_NAME
		chara プットオブジェ モデル３ -m w31b3 -r 0,0,0 -p 0,0,0 -s 100,100,100 -l d:LT2_NAME
//		chara プットオブジェ ヒカリ -m w31b0_light_test -r 0,0,0 -p 0,0,0 -s 100,100,100 -l d:LT2_NAME

		//chara 天井君 天井モデル０ -m w31b0r -h 0 -p 0,0,0 -l d:LT2_NAME
		chara 天井君 天井モデル００ -m w31b0r0 -h 0 -p 0,0,0 -l d:LT2_NAME
		chara 天井君 天井モデル０１ -m w31b0r1 -h 1000 -p 0,0,0 -l d:LT2_NAME

		chara 天井君 天井モデル３ -m w31b3r -h 0 -p 0,0,0 -l d:LT2_NAME
		chara 天井君 手前壁 -m w31b0_wall -a 5 -c 0 0 -250000 -p 0,0,0 -l d:LT2_NAME

		trap mp001 d:PLAYER \
			-mask 出る \
			-exec {
				if( $6 > -237000 ) {
					print '南側マップＯＮ'
					mesg 天井君 天井モデル３ 常に表示ＯＦＦ		// 表れる
					mesg プットオブジェ モデル３ on
				} else {
					print '南側マップＯＦＦ'
					mesg 天井君 天井モデル３ 常に表示		// 消える
					mesg プットオブジェ モデル３ off
				}
			}

		trap mp002 d:PLAYER \
			-mask 出る \
			-exec {
				if( $4 > 6000 ) {
					print '北側マップＯＮ'
					mesg 天井君 天井モデル００ 常に表示ＯＦＦ		// 表れる
					mesg 天井君 天井モデル０１ 常に表示ＯＦＦ		// 表れる
					mesg プットオブジェ モデル０ on
				} else {
					print '北側マップＯＦＦ'
					mesg 天井君 天井モデル００ 常に表示		// 消える
					mesg 天井君 天井モデル０１ 常に表示		// 消える
					mesg プットオブジェ モデル０ off
				}
			}
	}

/***************************************************************************************************/
// エマ
/***************************************************************************************************/

	proc エマ設置 {
		// ヴァンプ戦後ならエマ設置
		if( $w:p_story >= ( d:ST:P062_01_P01エマとＡＩ１ポリゴンデモ１開始 -1 ) ) {

			eval( $f:入出水処理中フラグ = 0 )


			if( $f:エマ存在フラグ == 1 && $s:登場ポイント == ポリデモ全て終了 ) {
			// ＡＩポリデモ後 エマと一緒
				eval( $f:エマ存在フラグ = 1 );
				eval( $f:エマと一緒に水の中 = 1 )

				eval( $w:武器 = d:武器:素手 )

				@水中エマ設置 1

				chara エマ・エメリッヒ 手繋ぎエマ \
					-pos	$i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,($i:プレイヤー初期Ｚ位置-500) \
					-hide  (-2800-300),-3500,-251000  7054,-3500,-251000 \
					-dir 0 \
					-voice [emma_voice:vox_list] \
					-hate_slater \
					-no_glasses \
					-idcard $f:IDcard \
					-stage d:EMA_STG_W31B \
					-proc 手繋ぎエマゲームオーバー

				mesg エマ・エメリッヒ 手繋ぎエマ 待機
				command プラグインエマ手繋ぎ -motion rai_ee
			} else if( $f:エマ存在フラグ == 1 && $s:登場ポイント == sp_w31a_w31b_0 ) {
			// エマと一緒にエレベーター側からロード
				chara エマ・エメリッヒ 手繋ぎエマ \
					-pos 750,-2500,-255000 \
					-hide (-2800-300),-3500,-251000  7054,-3500,-251000 \
					-dir 0 \
					-voice [emma_voice:vox_list] \
					-hate_slater \
					-no_glasses \
					-idcard $f:IDcard \
					-stage d:EMA_STG_W31B \
					-proc 手繋ぎエマゲームオーバー

				command プラグインエマ手繋ぎ -motion rai_ee

				@水中エマ設置 0

			} else if( $f:エマ存在フラグ == 1 && $s:登場ポイント == sp_w31c0_w31b_0 ) {
			// エマと一緒にヴァンプステージ側からロード
				chara エマ・エメリッヒ 手繋ぎエマ \
					-pos	$i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,($i:プレイヤー初期Ｚ位置-500) \
					-hide  (-2800-300),-3500,-251000  7054,-3500,-251000 \
					-dir 0 \
					-voice [emma_voice:vox_list] \
					-no_glasses \
					-vitality $i:エマライフ最大値 $i:エマライフ現在値 \
					-idcard $f:IDcard \
					-hate_slater \
					-stage d:EMA_STG_W31B \
					-proc 手繋ぎエマゲームオーバー

				command プラグインエマ手繋ぎ -motion rai_ee

				@水中エマ設置 0

			} else if ( $f:エマ存在フラグ == 0 && $s:エマ存在ステージ == w31b ) {
			// シェル２中央棟Ｂ１に置き去りにされていた
				chara エマ・エメリッヒ 手繋ぎエマ \
					-pos	$i:エマ初期位置Ｘ,$i:エマ初期位置Ｙ,$i:エマ初期位置Ｚ \
					-dir	0 \
					-voice [emma_voice:vox_list] \
					-no_glasses \
					-hide	(-2800-300),-3500,-251000  7054,-3500,-251000  -9250,-3500,-231500 \
					-vitality $i:エマライフ最大値 $i:エマライフ現在値 \
					-hate_slater \
					-idcard $f:IDcard \
					-stage d:EMA_STG_W31B \
					-proc 手繋ぎエマゲームオーバー

				command プラグインエマ手繋ぎ -motion rai_ee

				@水中エマ設置 0
			} else if ( $f:エマ存在フラグ == 0 && $s:エマ存在ステージ == w31c ) {
				print 'ヴァンプ戦に置き去りエマ'
				print 'ヴァンプ戦に置き去りエマ'
				print 'ヴァンプ戦に置き去りエマ'
				print 'ヴァンプ戦に置き去りエマ'
				print 'ヴァンプ戦に置き去りエマ'
				print 'ヴァンプ戦に置き去りエマ'
			} else {
				print '$s:登場ポイント:'$s:登場ポイント
				print '$f:エマ存在フラグ:'$f:エマ存在フラグ
				print '$s:エマ存在ステージ:'$s:エマ存在ステージ
				/*
				command assert ( d:FALSE ) 'EMMA ERROR'
				*/
			}

			trap ld002 手繋ぎエマ \
				-mask ？ \
				-exec {
					if ( $3 == 入る ) {
						eval( $s:エマ存在ステージ = w31c );
					} else {
						eval( $s:エマ存在ステージ = w31b );
					}
				}

		}

		/*
		chara プロック連続実行 エマ座標チェック連続実行 -time -1 -exec {
			command ゲットエマ座標 $i:Ｘ座標変数 $i:Ｙ座標変数 $i:Ｚ座標変数
			@入水エマ幅チェック $i:プレイヤー位置Ｘ $i:Ｘ座標変数
			@入水エマ奥行きチェック $i:プレイヤー位置Ｚ $i:Ｚ座標変数
		}
		*/
	}

/*
	proc エマゲームオーバー時カメラ {
		command ゲットエマ足元座標 $i:epx , $i:epy , $i:epz
		eval( $f:エマゲームオーバーフラグ = 1 );
		chara カメラ設定 モーションカメラ \
			-c 1 \
			-p ($i:epx + 30) , ($i:epy + 2450) , ($i:epz + 30)  \
			-t $i:epx , $i:epy , $i:epz \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1
		chara delay カメラディレイ \
			-time 60 \
			-exec {
				command ゲットエマ足元座標 $i:epx , $i:epy , $i:epz
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p ($i:epx + 30) , ($i:epy + 2450) , ($i:epz + 30)  \
					-t $i:epx , $i:epy , $i:epz \
					-a 200 \
					-z d:CAMERA_INTERP_CAMERA \ // 補完カメラフラグを指定。
					-interp_time 10 \ // 補完時間を指定
					-s 1
			}
	}
*/
proc エマゲームオーバー時カメラ {
		command ゲットエマ足元座標 $i:epx , $i:epy , $i:epz
		eval( $f:エマゲームオーバーフラグ = 1 );

		if ( ($i:epx < -7250) && ($i:epz < -232250) ) {
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p -8402,-2706,-230222 -t -8402,-5110,-232045 \
				-r 601,2048,0 -f 3017 \
				-a 200 \
				-i 0 -1 0 0 \
				-s 1
		} else {
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p ($i:epx + 30) , ($i:epy + 2450) , ($i:epz + 30)  \
				-t $i:epx , $i:epy , $i:epz \
				-a 200 \
				-i 0 -1 0 0 \
				-s 1
			chara delay カメラディレイ \
				-time 60 \
				-exec {
					command ゲットエマ足元座標 $i:epx , $i:epy , $i:epz
					chara カメラ設定 モーションカメラ \
						-c 1 \
						-p ($i:epx + 30) , ($i:epy + 2450) , ($i:epz + 30)  \
						-t $i:epx , $i:epy , $i:epz \
						-a 200 \
						-z d:CAMERA_INTERP_CAMERA \ // 補完カメラフラグを指定。
						-interp_time 10 \ // 補完時間を指定
						-s 1
				}
		}
	}

	proc 水中エマ設置 $:モード {
		command ゲットエマライフ $i:エマライフ現在値

		chara 水中エマ 引っ付き水中エマ \
			-life $i:エマライフ現在値 $i:エマライフ最大値 \
			-o2 $w:エマＯ２最大 \
			-card $f:IDcard \
			-model ema_def_sh_mt \
			-motion ee_swim \
			-force_act_motion ee_force \
			-procs 水中エマゲームオーバー \
			-start_mode $:モード		// 0:off状態  1:くっつき状態
	}

	proc ピーターさん {

		if( $f:ピーター浮遊死体デモ見た == 1 ) {
			chara プットモーションモデル 死体ピーター \
				-pos 11500 -7900 -223300 \
				-dir 0 \
				-kms rai_def \
				-evm ptr_dead_mh_mt \
				-mar w31b_ptr \
				-number 0 \
				-status 0x80 	// 非表示で起動

			trap pt d:PLAYER \
				-mask ？ \
				-exec {
					if( $3 == 入る ) {
						mesg プットモーションモデル 死体ピーター 表示
						eval( $f:w31b_ピーター血に染まれ = 1 )
					} else {
						mesg プットモーションモデル 死体ピーター 非表示
						eval( $f:w31b_ピーター血に染まれ = 0 )
					}
				}

			@ピーター出血
		}
	}

	proc ピーター出血 {

		chara delay 出血ディレイ -t 150 -exec {
			if( $f:w31b_ピーター血に染まれ == 1 ) {
				chara 水中血 ピーター出血 \
					-p (11400 + `%rand 200`) (-7100 + `%rand 200`) (-223100 + `%rand 200`) \
					-r 0 0 0 \
					-f 10

				chara 水中血 ピーター出血 \
					-p (11500 + `%rand 200`) (-7100 + `%rand 200`) (-222850 + `%rand 200`) \
					-r 0 0 0 \
					-f 10

				chara 水中血 ピーター出血 \
					-p (11428 + `%rand 10`) (-6676 + `%rand 10`) (-222650 + `%rand 10`) \
					-r 0 0 0 \
					-f 10
			}
			@ピーター出血
		}
	}

/***************************************************************************************************/
// 崩落地帯の血
/***************************************************************************************************/

	proc 崩落血セット {
		trap blood d:PLAYER \
			-mask ？ \
			-exec {
				if( $3 == 入る ) {
					eval( $f:w31b_崩落血 = 1 )
				} else {
					eval( $f:w31b_崩落血 = 0 )
				}
			}
		@崩落血
	}
	proc 崩落血 {
		chara delay 崩落血ディレイ -t 150 -exec {
			if( $f:w31b_崩落血 == 1 ) {
				print '崩落血'
				chara 水中血 水中崩落血 \
					-p (4000 ) (-10000 ) (-222000 ) \
					-r 0 0 0 \
					-f 10 \
					-d 1

				chara 水中血 水中崩落血 \
					-p (4000 ) (-9800 ) (-222000 ) \
					-r 0 0 0 \
					-f 10 \
					-d 1
			}
			@崩落血
		}
	}


/***************************************************************************************************/
// ふなむし
/***************************************************************************************************/
	proc 壁ふなむし {
		if( $w:p_story >= ( d:ST:P062_01_P01エマとＡＩ１ポリゴンデモ１開始 -1 ) ) {
			chara フナ虫リーダー ゴールドリーダー１ \
				-n_obj	1 \
				-obj	d:PLAYER \
				-flag	d:ALLSLT_FLAG_NO_STOMP \
				-pos	-2000 -3000 (-253000+10) \	//中心
				-wide	500 1000 \					//幅
				-rot	1024 0 0 \					//回転
				-R		2 \							//逃げ込みエリア数
				-E 0 1500 500 500 \		//
				-e 0 2500 500 500 \		//-R個
				-E 0 -1500 500 500 \	//
				-e 0 -2500 500 500 		//-R個
			//-debug

/*
			chara 舟虫 ゴールド１ \
				-group 3 \
				-in_group 16 \
					-data  150  200 600 \
					-data -150  200 600 \
					-data  150 -200 600
*/
			chara 舟虫 ゴールド１ \
				-group 12 \
				-in_group 4 \
					-data  75     0  300 \
					-data -75    50  300 \
					-data  0     75  300 \
					-data  150  100 300 \
					-data  -150 150 300 \
					-data  25   200 300 \
					-data  75   250 300 \
					-data -75   300 300 \
					-data  0    350 300 \
					-data  150  400 300 \
					-data  -150 450 300 \
					-data  25   500 300

			chara フナ虫リーダー ゴールドリーダー２ \
				-n_obj	1 \
				-obj	d:PLAYER \
				-flag	d:ALLSLT_FLAG_NO_STOMP \
				-pos	2000 -3000 (-253000+10) \	//中心
				-wide	500 2000 \					//幅
				-rot	1024 0 0 \					//回転
				-R		1 \							//逃げ込みエリア数
				-E 0 1500 500 500 \		//
				-e 0 2500 500 500 		//-R個
			//-debug

			chara 舟虫 ゴールド２ \
				-group 12 \
				-in_group 4 \
					-data  75     0  300 \
					-data -75    50  300 \
					-data  0     75  300 \
					-data  150  100 300 \
					-data  -150 150 300 \
					-data  25   200 300 \
					-data  75   250 300 \
					-data -75   300 300 \
					-data  0    350 300 \
					-data  150  400 300 \
					-data  -150 450 300 \
					-data  25   500 300
		}
	}

	proc ふなむし設置 {
		if( $w:p_story >= ( d:ST:P062_01_P01エマとＡＩ１ポリゴンデモ１開始 -1 ) ) {
			print 'エマ虫起動'
			chara エマ虫 かさかさ \
				-group 2 \
				-atrap all_funa \
				-trap funa1 \
				-n_rfg 4 \
				-refuge refuge1 escape1 \
						refuge2 escape2 \
						refuge3 escape3 \
						refuge4 escape4
			chara エマ虫 かさかさ \
				-group 2 \
				-atrap all_funa \
				-trap funa2 \
				-n_rfg 4 \
				-refuge refuge1 escape1 \
						refuge2 escape2 \
						refuge3 escape3 \
						refuge4 escape4
			chara エマ虫 かさかさ \
				-group 2 \
				-atrap all_funa \
				-trap funa3 \
				-n_rfg 4 \
				-refuge refuge1 escape1 \
						refuge2 escape2 \
						refuge3 escape3 \
						refuge4 escape4
			chara エマ虫 かさかさ \
				-group 2 \
				-atrap all_funa \
				-trap funa4 \
				-n_rfg 4 \
				-refuge refuge1 escape1 \
						refuge2 escape2 \
						refuge3 escape3 \
						refuge4 escape4

			if ( $f:エマ存在フラグ == 0 && $s:エマ存在ステージ != w31b ) {
				print 'エマはいません'
				chara 船虫踏み潰し管理 かさかさ親分 \
					-group 2 \
					-atrap all_funa \
					-n_obj 1 \
					-obj d:PLAYER
			} else {
				print 'エマがいます かさかさ親分に追加'
				chara 船虫踏み潰し管理 かさかさ親分 \
					-group 2 \
					-atrap all_funa \
					-n_obj 2 \
					-obj d:PLAYER 手繋ぎエマ
			}


			chara 潰れふなむし ぺちゃんこ

			// スタート時はＯＦＦ
			print '第一フナムシ非表示メッセージ'
			mesg エマ虫 かさかさ 非表示
			// トラップによるＯＮ・ＯＦＦ
			trap fm000 d:PLAYER \
				-mask ？ \
				-exec {
					if( $3 == 入る ) {
						print 'ふなむし表示'
						mesg エマ虫 かさかさ 表示
					} else {
						print 'ふなむし非表示'
						mesg エマ虫 かさかさ 非表示
					}

				}

			@メニューフナムシ取り付き設定

		} else {
			// メニューフナムシトラップをOFFにしておく
			command トラップ切り替え -trap menu_funa -switch 0
		}
	}

	proc 身体這いフナムシチェック {
		chara delay 身体這いフナムシチェックディレイ -time 120 -exec {
			print 'フナムシついた'
			mesg 体舟虫 身体虫 這う
		}
	}
	proc 身体這いフナム取れる {
		print 'フナムシとれた'
		mesg delay 身体這いフナムシチェックディレイ kill
		mesg 体舟虫 身体虫 落とす
	}

/***************************************************************************************************/
// 全マップ共通
/***************************************************************************************************/

	proc サウンド設定 {
		#if d:DEBUG_PRINT
			print 'sound_set'
		#endif

		if( $w:p_story >= ( d:ST:P062_01_P01エマとＡＩ１ポリゴンデモ１開始 -1 ) ) {
		// エマ救出後
			chara サウンドマネージャー ＳＤマネ -pak 1
		} else {
			chara サウンドマネージャー ＳＤマネ -pak 0
		}

		@サウンド効果音設定
		command 弾痕ノーマル -n 0
		command 弾痕ノーマル -n 1
		command 弾痕ノーマル -n 2
		command 弾痕ノーマル -n 3
		command 弾痕ノーマル -n 4

		command 跳弾ノーマル -n 0
		command 跳弾ノーマル -n 1
		command 跳弾ノーマル -n 2
		command 跳弾ノーマル -n 3
		command 跳弾ノーマル -n 4

		eval( $f:ＢＧＭマネージャー起動フラグ = 0 );
	}
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT
			print 'localvar_init'
		#endif
		eval( $f:エマゲームオーバーフラグ = 0 );
	}
	proc 設定値変更 {
		#if d:DEBUG_PRINT
			print 'status_set'
		#endif
	}

/***************************************************************************************************/
// ノード処理
/***************************************************************************************************/
	proc ノード接続時プロック {
		#if d:DEBUG_PRINT
			print 'node_set'
		#endif
		eval( $f:ノードフラグ = $f:w31b_ノードフラグ );
	}

	proc ノード接続後プロック {
		#if d:DEBUG_PRINT
			print 'node_event_go'
		#endif
		eval( $f:w31b_ノードフラグ = 1 );
		//eval( $w:コンフィグ設定 = ($w:コンフィグ設定 & ~(d:CONFIG_RADAR_OFF)) );
		command メニュー設定 -node_access on
	}

/***************************************************************************************************/
// プラグインプログラム
/***************************************************************************************************/
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif

		command プラグインくしゃみ
	}

/***************************************************************************************************/
// プレイヤー
/***************************************************************************************************/

	proc プレイヤー設定 {
		#if d:DEBUG_PRINT
			print 'player_set'
		#endif

		#if d:RAIDEN
			chara プレイヤー d:PLAYER \
				-p $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,$i:プレイヤー初期Ｚ位置 \
//				-p -18000, -46000, 22000 \
				-d 0,$i:プレイヤー初期方向,0 \
				-s 0 \
				-m rai_def -a raiden \
				//-f d:PLY_NO_FOOT_SHADOW \
				-o rai_w31b

			// 髪の毛
			//@ライデン髪の毛設定 d:WATER_HAIR
			@ライデン髪の毛設定 d:NORMAL_HAIR

			@プレイヤーＬＯＤ設定 d:C_DISTANCE_TYPE 6000


		#endif

		// 酸素ゲージ

		if( $s:登場ポイント == ピーターデモ後 ) {
			print 'w31b_ピータデモ後の酸素:'$w:w31b_ピータデモ後の酸素
			eval( $w:Ｏ２ = $w:w31b_ピータデモ後の酸素 )
			chara Ｏ２ゲージ ライデンＯ２ -max $w:Ｏ２最大 \
										  -start_value $w:w31b_ピータデモ後の酸素 \
										  -length d:O2_GAGE
		} else {
			chara Ｏ２ゲージ ライデンＯ２ -max $w:Ｏ２最大 \
										  -length d:O2_GAGE
		}



	}

/***************************************************************************************************/
// 敵兵
/***************************************************************************************************/

//	なし

/***************************************************************************************************/
// ＢＧＭ
/***************************************************************************************************/

	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT
			print 'bgm_set'
		#endif
		chara ＢＧＭマネージャー ＢＧＭマネ
		command 弾水飛沫処理
		eval( $f:ＢＧＭマネージャー起動フラグ = 1 );
	}

/***************************************************************************************************/
// ドア＆マップ切り替え
/***************************************************************************************************/

	proc 水密ドア設置 {
		#if d:DEBUG_PRINT
			print 'wt_door_set'
		#endif

		chara 水密ドア管理 ドア管理人 -n 4 \
			-seno 3 \
			-motions rai_wt_hatch hatch_door_sna hatch_handle_sna
			//-adjusts 0 \//$i:左軸ドア引き時プレイヤー位置調整Ｘ \
				//-50 \//$i:左軸ドア引き時プレイヤー位置調整Ｚ \
				//0 \//$i:左軸ドア押し時プレイヤー位置調整Ｘ \
				//0 \//$i:左軸ドア押し時プレイヤー位置調整Ｚ \
				//-50 \//$i:右軸ドア引き時プレイヤー位置調整Ｘ \
				//0 \//$i:右軸ドア引き時プレイヤー位置調整Ｚ \
				//0 \//$i:右軸ドア押し時プレイヤー位置調整Ｘ \
				//0 //$i:右軸ドア押し時プレイヤー位置調整Ｚ

	////////////////////
	//	右はしの水密ドア
		chara 水密ドア 水密君１ \
			-kms w11a_sdr_body_r w11a_sdr_handle \
			-position 12050,-10500,-221425 \
			-type 1 \
			-rotate 0,1024,0 \
			-flag 	d:WT_DOOR_FLAG_NOT_OPEN

		trap wdr001 d:PLAYER \
			-mask いる \
			-button d:ACTION_BUTTON \
			-state d:TRP_STATE_WATER \
			-exec {
				command 水密ドア状態 -n 水密君１
				mesg プレイヤー d:PLAYER wt_door 水密君１ $status 1024,512 12125,-222500
				if( $f:エマと一緒に水の中 == 1 ) {
					mesg 水中エマ 引っ付き水中エマ wt_door
				}
			}
		trap wdr001 d:PLAYER \
			-mask ？ \
			-state 6 \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 10264,-7501,-220644 -t 11427,-8986,-221980 \
					-r 455,1581,0 -f 2311 \
					-a 160 \
					-i 0 2 0 0 \
					-s $3
			}

	///////////////////////////////////////////
	// 右端対面水密ドア （開けるとピーターデモ）

		if( $f:ピーター浮遊死体デモ見た == 0 ) {
			print '$f:ピーター浮遊死体デモ見た'$f:ピーター浮遊死体デモ見た
			print '$f:ピーター浮遊死体デモ見た'$f:ピーター浮遊死体デモ見た
			print '$f:ピーター浮遊死体デモ見た'$f:ピーター浮遊死体デモ見た
			eval( $i:ローカル変数Ｉ１ = d:WT_DOOR_FLAG_NORMAL )
			command 水密ドアハンドル２回転時プロックコール -proc ピーターデモの開始
		} else {
			print '$f:ピーター浮遊死体デモ見た'$f:ピーター浮遊死体デモ見た
			print '$f:ピーター浮遊死体デモ見た'$f:ピーター浮遊死体デモ見た
			print '$f:ピーター浮遊死体デモ見た'$f:ピーター浮遊死体デモ見た
			eval( $i:ローカル変数Ｉ１ = d:WT_DOOR_FLAG_OPEN_START )
		}

		chara 水密ドア 水密君２ \
			-kms w11a_sdr_body_l w11a_sdr_handle \
			-position 7450,-10500,-221425 \
			-type 0 \
			-rotate 0,1024,0 \
			-flag $i:ローカル変数Ｉ１ \
			-hazard 7375,-10500,-222500 7375,-10500,-221500 \
			-exec {
				if( $:トリガ == 1 ) {
					print '取っ手掴んだ'
					mesg 連続発生線状泡 プクプク水密泡 オン
				} else if( $:トリガ == 2 ) {
					print '取っ手放した'
					mesg 連続発生線状泡 プクプク水密泡 オフ
				} else if( $:トリガ == 0 ) {
					print '開け終わった'
					command トラップ切り替え -trap fg002 -switch 1
				}
			}

		// 右から開ける
		trap wdr002_R d:PLAYER \
			-mask いる \
			-button d:ACTION_BUTTON \
			-state d:TRP_STATE_WATER \
			-exec {
				command 水密ドア状態 -n 水密君２
				mesg プレイヤー d:PLAYER wt_door 水密君２ $status 3072,512 7450,-221425
				if( $f:エマと一緒に水の中 == 1 ) {
					mesg 水中エマ 引っ付き水中エマ wt_door
				}
			}

		trap wdr002_R d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_FORCE \
			-camera \
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 9455,-8083,-222915 -t 8197,-8658,-222341 \
					-r 257,3351,0 -f 1498 \
					-a 160 \
					-i 0 2 0 0 \
					-s $3
			}

		// 左から開ける
		trap wdr002_L d:PLAYER \
			-mask いる \
			-button d:ACTION_BUTTON \
			-state d:TRP_STATE_WATER \
			-exec {
				command 水密ドア状態 -n 水密君２
				mesg プレイヤー d:PLAYER wt_door 水密君２ $status 1024,512 7450,-221425
				if( $f:エマと一緒に水の中 == 1 ) {
					mesg 水中エマ 引っ付き水中エマ wt_door
				}
			}

		trap wdr002_L d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_FORCE \
			-camera \
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 5678,-7355,-221238 -t 6609,-8479,-221935 \
					-r 501,1443,0 -f 1618 \
					-a 160 \
					-i 0 2 0 0 \
					-s $3
			}

	///////////////////////
	// 左端対面水密ドア
		if( $f:w31b_左の水密ドアを開けました == 0 ) {
			eval( $i:ローカル変数Ｉ１ = d:WT_DOOR_FLAG_NORMAL )
		} else {
			eval( $i:ローカル変数Ｉ１ = d:WT_DOOR_FLAG_OPEN_START )
		}

		chara 水密ドア 水密君３ \
			-kms w11a_sdr_body_r w11a_sdr_handle \
			-position -7200,-10500,-221425 \
			-type 1 \	// 左軸
			-rotate 0,1024,0 \
			-flag $i:ローカル変数Ｉ１ \
			-hazard -7375,-10500,-222500 -7375,-10500,-221500 \
			-exec {
				if( $:トリガ == 0 ) {
					print '左 水密ドア 開いた'
					eval( $f:w31b_左の水密ドアを開けました = 1 )
				} else if( $:トリガ == 1 ) {
					print '左 水密ドア 取っ手掴んだ'
					mesg 連続発生線状泡 左水密泡 オン
				} else if( $:トリガ == 2 ) {
					print '左 水密ドア 取っ手放した'
					mesg 連続発生線状泡 左水密泡 オフ
				}

			}

		trap wdr003_R d:PLAYER \
			-mask いる \
			-button d:ACTION_BUTTON \
			-state d:TRP_STATE_WATER \
			-exec {
				print 'wdr003_R'
				command 水密ドア状態 -n 水密君３
				mesg プレイヤー d:PLAYER wt_door 水密君３ $status 3072,512 -7375,(-222500-1000)
				if( $f:エマと一緒に水の中 == 1 ) {
					mesg 水中エマ 引っ付き水中エマ wt_door
				}
			}

		// 右側の設定
		trap wdr003_R d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_FORCE \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p -5721,-7698,-222901 -t -6727,-8991,-222006 \
					-r 499,3546,0 -f 1867 \
					-a 160 \
					-i 0 2 0 0 \
					-s $3
			}

		trap wdr003_L d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_FORCE \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p -5352,-8101,-223039 -t -6633,-9015,-222174 \
					-r 348,3459,0 -f 1796 \
					-a 160 \
					-i 0 2 0 0 \
					-s $3
			}

		// 左側の設定
		trap wdr003_L d:PLAYER \
			-mask いる \
			-button d:ACTION_BUTTON \
			-state d:TRP_STATE_WATER \
			-exec {
				print 'wdr003_L'
				command 水密ドア状態 -n 水密君３
				mesg プレイヤー d:PLAYER wt_door 水密君３ $status 1024,512 -7375,(-222500-1000)
				if( $f:エマと一緒に水の中 == 1 ) {
					mesg 水中エマ 引っ付き水中エマ wt_door
				}
			}

		trap wdr003_L d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_FORCE \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p -8652,-7470,-221502 -t -7812,-8632,-221955 \
					-r 576,1346,0 -f 1504 \
					-a 201 \
					-i 0 2 0 0 \
					-s $3
			}



	//////////////////
	// 左はし水密ドア

		chara 水密ドア 水密君４ \
			-kms w11a_sdr_body_l w11a_sdr_handle \
			-position -11800,-10500,-221425 \
			-type 1 \	// 左軸
			-rotate 0,1024,0 \
			-flag 	d:WT_DOOR_FLAG_NOT_OPEN

		trap wdr004 d:PLAYER \
			-mask いる \
			-button d:ACTION_BUTTON \
			-state d:TRP_STATE_WATER \
			-exec {
				command 水密ドア状態 -n 水密君４
				mesg プレイヤー d:PLAYER wt_door 水密君４ $status 3072,512 -11800,-221400
				if( $f:エマと一緒に水の中 == 1 ) {
					mesg 水中エマ 引っ付き水中エマ wt_door
				}
			}
		trap wdr004 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_FORCE \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p -10192,-7425,-223628 -t -11475,-8986,-222159 \
					-r 440,3628,0 -f 2498 \
					-a 160 \
					-i 0 2 0 0 \
					-s $3
			}

/*
	// トラップから出たら強制的にCLOSE
		trap wdr002_close d:PLAYER \
			-mask 出る \
			-exec {
				mesg 水密ドア 水密君２ close
			}

		trap wdr003_close d:PLAYER \
			-mask 出る \
			-exec {
				mesg 水密ドア 水密君３ close
			}
*/
	}


	proc ピーターデモの開始 {
		//eval( $f:ピーター浮遊死体デモ見た = 1 )	// デモの方で代入する

		if( $w:Ｏ２ > 500 ) {
			eval( $w:w31b_ピータデモ後の酸素 = $w:Ｏ２ )
			command varsave $w:w31b_ピータデモ後の酸素
		} else {
			eval( $w:w31b_ピータデモ後の酸素 = 500 )
			command varsave $w:w31b_ピータデモ後の酸素
		}

		print '*****************************************************'
		print '*************                       *****************'
		print '*************         Seek          *****************'
		print '*************                       *****************'
		print '*****************************************************'


		if($w:アイテム == d:アイテム:ゴル兵制服){
			print 'ゴル兵装 r_plt5'
			preseek 'r_plt5'
		} else {
			print 'スニーキングスーツ d053p01'
			preseek 'd053p01'
		}

		chara フェードインアウト フェードアウト \
			-c 0,0,0 128 \
			-t d:FADEOUT_TIME \
			-p mv_P054_01_P01_0
	}


/************************************************************************************************/
// ヴァンプステージ用スライドドア
/************************************************************************************************/
	proc ドア設置 {
		#if d:DEBUG_PRINT
			print 'slide_door_set'
		#endif

		@ドアランプ設定 ドアランプ名１ 2048 (-9250+1500) -6250 -232375 1

		chara ドア ヴァンプ戦ドア \
			-m d:DOOR_NAME2 \
			-d 0,2048,0 \
			-p (-9250+1500),-6250,-232375 \
			-slide d:SD_SLIDE_INSIDE \
			-time d:SD_OPEN_TIME \
			-card_level 4 \
			-lamp ドアランプ名１ \
			-between シェル２中央棟Ｂ１ シェル２中央棟Ｂ１ \
			-exec {
				if( $:開閉フラグ == 0 ){
					//	mesg マップ接合 連結ハッチ／昇降機ホール off
				} else {
					//	mesg マップ接合 連結ハッチ／昇降機ホール on
				}
			}
		trap dr001 ？ \
			-mask ？ \
			-exec {
				if($3==入る){
					mesg ドア ヴァンプ戦ドア open $2
				}else{
					if( $f:エマゲームオーバーフラグ == 0 ) {
						mesg ドア ヴァンプ戦ドア close $2
					}
				}
			}

		@主観禁止壁 ヴァンプ戦ドア透明壁 -7750 -6250 -232375 2048 d:SD_SLIDE_INSIDE
		trap dr001 d:PLAYER -mask ？ \
		-state d:TRP_STATE_SUBJECT \
		-exec {
			if($3 == 入る) {
				mesg 透明壁 ヴァンプ戦ドア透明壁 on
			} else if($3 == 出る) {
				mesg 透明壁 ヴァンプ戦ドア透明壁 off
			}
		}

	}

/************************************************************************************************/
// エレベーター
/************************************************************************************************/

	proc 強制ドアクローズ終了_1Fへ {
		#if d:DEBUG_PRINT
			print 'w31b_load_go'
		#endif

		if( $f:ロードチェックＯＮフラグ == 1 ) {
			@エマエレベーター内チェック w31d			// 小人Ｙ追加 2001.0629
			preseek 'w31a'
			@ステージ終了時処理（ステージ名表示） 0 0 0 0 mv_w31b_w31a_0 d:NO_MOVE_M_TYPE d:wn_シェル２中央棟１Ｆ空気清浄室

print 'エマ座標'
print 'エマ座標'
print 'エマ座標'
print 'エマ座標'
print 'エマ座標'
print 'エマ座標'
print 'エマ座標'
print $i:エマ初期位置Ｘ
print $i:エマ初期位置Ｙ
print $i:エマ初期位置Ｚ
		}
	}

	proc 強制ドアクローズ終了_B2へ {
		#if d:DEBUG_PRINT
			print 'no_load_go'
		#endif

		// B2へは行けないのでとりあえず1Fを呼んでおく
		if( $f:ロードチェックＯＮフラグ == 1 ) {
			preseek 'w31a'
			@ステージ終了時処理（ステージ名表示） 0 0 0 0 mv_w31b_w31a_0 d:NO_MOVE_M_TYPE d:wn_シェル２中央棟１Ｆ空気清浄室
		}
	}


/************************************************************************************************/
// ロード
/************************************************************************************************/

	proc ロードプロック {
		#if d:DEBUG_PRINT
			print 'load_proc'
		#endif
/*
		if ($s:呼び出しプロック == mv_w31b_w31a_0) {
			// シェル２中央棟１Ｆへ
			@mv_w31b_w31a_0
		}
*/
		if ( $s:呼び出しプロック == mv_w31b_w31c0_0 ) {
			@mv_w31b_w31c0_0
		} else if( $s:呼び出しプロック == mv_w31b_w31a_0 ) {
			@mv_w31b_w31a_0
		}
	}

	proc ロード設定 {
		#if d:DEBUG_PRINT
			print 'load_set'
		#endif

		trap ld002 d:PLAYER \
			-mask 入る \
			-exec {
				print 'ロード'$f:ロードチェックＯＮフラグ
				if( $f:ロードチェックＯＮフラグ == 1 ) {
					// ヴァンプ戦ステージへ
					if( $w:p_story >= ( d:ST:P055_01_P01ヴァンプ戦前１ポリゴンデモ１開始 ) ) {
						preseek 'w31f'
						@ステージ終了時処理（ステージ名表示） -8500 -4000 -234064 2048 mv_w31b_w31c0_0 d:DEFAULT_M_TYPE d:wn_シェル２中央棟Ｂ１第二濾過室
					} else {
						preseek 'w31c'
						@ステージ終了時処理 -8500 -4000 -234064 2048 mv_w31b_w31c0_0 d:DEFAULT_M_TYPE
					}

				}
			}
		trap ld002 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
/*
-p -9160,-2281,-230475 -t -8501,-4218,-231731 \
-r 612,1733,0 -f 2401 \
-a 200 \
*/
				chara カメラ設定 ロードカメラ \
					-c 1 \
					-p -9422,-2469,-230872 -t -8634,-4462,-231973 \
					-r 635,1643,0 -f 2409 \
					-a 200 \
					-i 0 1 0 0 \
					-s $3
			}
	}

/***************************************************************************************************/
// アイテム
/***************************************************************************************************/

#define	item_リモコンミサイル		0
#define	item_Ｍ４弾					1
#define	item_暗視ゴーグル			2
#define item_グレネード				3
#define item_ＰＳＧ１−Ｔ			4
#define item_レーション				5
#define item_ＲＧＢ６				6
#define item_Ｍ９弾					7
#define item_スティンガー弾			8


	proc アイテム取得時番号設定 $:ボックス名 {
		#if d:DEBUG_PRINT
			print 'item_no_set'
		#endif

		if( $:ボックス名 == リモコンミサイル ) {
			eval( $b:w31b_取得ロード回数[ d:item_リモコンミサイル ] = $w:グローバルロード回数 );
		}
		if( $:ボックス名 == Ｍ４弾 ) {
			eval( $b:w31b_取得ロード回数[ d:item_Ｍ４弾 ] = $w:グローバルロード回数 );
		}
		if( $:ボックス名 == 暗視ゴーグル ) {
			eval( $b:w31b_取得ロード回数[ d:item_暗視ゴーグル ] = $w:グローバルロード回数 );
		}
		if( $:ボックス名 == グレネード ) {
			eval( $b:w31b_取得ロード回数[ d:item_グレネード ] = $w:グローバルロード回数 );
		}
		if( $:ボックス名 == ＰＳＧ１−Ｔ ) {
			eval( $b:w31b_取得ロード回数[ d:item_ＰＳＧ１−Ｔ ] = $w:グローバルロード回数 );
		}
		if( $:ボックス名 == レーション ) {
			eval( $b:w31b_取得ロード回数[ d:item_レーション ] = $w:グローバルロード回数 );
		}
		if( $:ボックス名 == ソコム弾 ) {
			eval( $b:w31b_取得ロード回数[ d:item_ＲＧＢ６ ] = $w:グローバルロード回数 );
		}
		if( $:ボックス名 == Ｍ９弾 ) {
			eval( $b:w31b_取得ロード回数[ d:item_Ｍ９弾 ] = $w:グローバルロード回数 );
		}
		if( $:ボックス名 == スティンガー弾 ) {
			eval( $b:w31b_取得ロード回数[ d:item_スティンガー弾 ] = $w:グローバルロード回数 );
		}
	}

	proc アイテム設置 {
		// リモコンミサイル
		//if ( $w:武器弾数Ｒ[ d:武器:ニキータ ] == -1 ) {
		if( 1 ) {		// 武器に関しては判定が不要
			if( $w:ゲーム設定 == d:LEVEL_VERYEASY ) {
				@ニキータ_初期設置 リモコンミサイル 11500 -10250 -249500 d:アイテム水飛沫無 レーション
			} else if( $w:ゲーム設定 == d:LEVEL_EASY ) {
				@ニキータ_初期設置 リモコンミサイル -750 -10250 -242750 d:アイテム水飛沫無 レーション
			} else {
				@ニキータ_初期設置 リモコンミサイル 5000 -10250 -236250 d:アイテム水飛沫無 レーション
			}
			mesg アイテム リモコンミサイル オフ		// 影を消す
		}
		// Ｍ４弾
		if( `@アイテム再セットチェック $b:w31b_取得ロード回数[ d:item_Ｍ４弾 ]` ) {
			@弾薬_Ｍ４_初期設置 Ｍ４弾 9500 -10500 -237500 d:アイテム水飛沫無
			mesg アイテム Ｍ４弾 オフ
		}
		// 暗視ゴーグル
		if ( $w:アイテム数Ｒ[ d:アイテム:暗視ゴーグル ] == 0 ) {
			@暗視ゴーグル_初期設置 暗視ゴーグル 4250 -10500 -244750 d:アイテム水飛沫無
			mesg アイテム 暗視ゴーグル オフ
		}
		// グレネード
		if( `@アイテム再セットチェック $b:w31b_取得ロード回数[ d:item_グレネード ]` ) {
			@グレネード_初期設置 グレネード -1500 -6250 -2335750 d:アイテム水飛沫無
			mesg アイテム グレネード オフ
		}
		// ＰＳＧ１−Ｔ
		if( `@アイテム再セットチェック $b:w31b_取得ロード回数[ d:item_ＰＳＧ１−Ｔ ]` ) {
			@ＰＳＧ１−Ｔ_初期設置 ＰＳＧ１−Ｔ -2000 -6250 -223000 d:アイテム水飛沫無 なし
			mesg アイテム ＰＳＧ１−Ｔ オフ
		}
		// レーション
		if( `@アイテム再セットチェック $b:w31b_取得ロード回数[ d:item_レーション ]` ) {
			@レーション_初期設置 レーション -9500 -6250 -222000 d:アイテム水飛沫無
			mesg アイテム レーション オフ
		}
		// ＲＧＢ６
		if( `@アイテム再セットチェック $b:w31b_取得ロード回数[ d:item_ＲＧＢ６ ]` ) {
			@ＲＧＢ６_初期設置 ＲＧＢ６ -1500 -6250 -249500 d:アイテム水飛沫無 なし
			mesg アイテム ＲＧＢ６ オフ
		}
/*
		// 防弾チョッキ
		if ( $w:アイテム数Ｒ[ d:アイテム:防弾チョッキ ] == 0 ) {
			@防弾チョッキ_初期設置 防弾チョッキ 1000 -10000 -221500 d:アイテム水飛沫無
			mesg アイテム 防弾チョッキ オフ
		}
*/
		// Ｍ９弾
		if( $w:p_story >= ( d:ST:P062_01_P01エマとＡＩ１ポリゴンデモ１開始 -1 ) ) {
			if( `@アイテム再セットチェック $b:w31b_取得ロード回数[ d:item_Ｍ９弾 ]` ) {
				@弾薬_Ｍ４_初期設置 Ｍ９弾 -2750 -4000 -250750 d:アイテム水飛沫無 なし
			}
		}
		// スティンガー弾
		if( `@アイテム再セットチェック $b:w31b_取得ロード回数[ d:item_スティンガー弾 ]` ) {
			@弾薬_スティンガー_初期設置 スティンガー弾 -2000 -10500 -223000 d:アイテム水飛沫無 なし
		}
	}

/***************************************************************************************************/
// フォグ設定
/***************************************************************************************************/

	proc フォグ設定 {
		#if d:DEBUG_PRINT
			print 'fog_set'
		#endif

		chara フォグコントローラ フォグコン \
			-n 11 \
			-z \
			-d   50 69 50   0  36000  36000 36000 \	// 0:地上
				 48 112 96  -5800  40000  16000  4000 \	// 1:以下は水中
				 48 112 96  -5800  35000  16000  4000 \	// 2
				 48 112 96  -5800  30000 16000 4000 \	// 3
				 48 112 96  -5800  25000 16000 4000 \	// 4
				 48 112 96  -5800  20000 16000 4000 \	// 5
				 48 112 96  -5800  17500 16000 4000 \	// 6
				 48 112 96  -5800  15000 16000 4000 \	// 7
				 48 100 67  -9000  10000 16000 4000 \	// 8 濁り
				 90 150 114 -11600  60000 3000 8000	\	// 9  光1
				 90 150 114 -5800  30000 3000 8000 		// 10 光7
//				 80 140 110  -8000  15000 3000 8000 	// 11 光8

		mesg フォグコントローラ フォグコン セット 0 0
	}

	proc キャラ用ライト設定 {
		chara 平行光 パラ \
			 //-c 86 96 81 \
			 -c 86 97 102 \
			 -p -1566 -3626 -3065
	}



	proc 水上フォグ検査設定 {
		#if d:DEBUG_PRINT
			print 'water_fog_set'
		#endif

		// 北側部分 水中に入った時

		trap fg001 d:PLAYER \
			-mask ＊ \
			-exec {
				command プレイヤー状態取得
				if (( $status & d:PFLAG_WATER ) && (!( $status & d:PFLAG_WATER_SURFACE ))){
					// 水中モードであるが水面ではない
//					print 'フォグ 1'
					mesg フォグコントローラ フォグコン セット 1 0
				} else {
//					print 'フォグ 0'
					mesg フォグコントローラ フォグコン セット 0 0
				}
			}


		// 南側部分 水中に入った時
		trap fg003 d:PLAYER \
			-mask ＊ \
			-exec {
				command プレイヤー状態取得
				if (( $status & d:PFLAG_WATER ) && (!( $status & d:PFLAG_WATER_SURFACE ))){
					// 水中モードであるが水面ではない
//					print 'フォグ 4'
					mesg フォグコントローラ フォグコン セット 4 0
				} else {
//					print 'フォグ 0'
					mesg フォグコントローラ フォグコン セット 0 0
				}
			}




		trap fg002:01 d:PLAYER \
			-mask 入る \
			-exec {
				print 'fog1 in'
				mesg フォグコントローラ フォグコン セット 1 30
			}
		trap fg002:02 d:PLAYER \
			-mask 入る \
			-exec {
				print 'fog2 in'
				mesg フォグコントローラ フォグコン セット 2 30
			}
		trap fg002:03 d:PLAYER \
			-mask 入る \
			-exec {
				print 'fog3 in'
				mesg フォグコントローラ フォグコン セット 3 30
			}
		trap fg002:04 d:PLAYER \
			-mask 入る \
			-exec {
				print 'fog4 in'
				mesg フォグコントローラ フォグコン セット 4 30
			}
		trap fg002:05 d:PLAYER \
			-mask 入る \
			-exec {
				print 'fog5 in'
				mesg フォグコントローラ フォグコン セット 5 30
			}
		trap fg002:06 d:PLAYER \
			-mask 入る \
			-exec {
				print 'fog6 in'
				mesg フォグコントローラ フォグコン セット 6 30
			}
		trap fg002:07 d:PLAYER \
			-mask 入る \
			-exec {
				print 'fog7 in'
				mesg フォグコントローラ フォグコン セット 7 30
			}
		trap fg002:08 d:PLAYER \
			-mask 入る \
			-exec {
				print 'fog8 in'
				mesg フォグコントローラ フォグコン セット 8 30
			}

		// ピーター前はフォグチェンジ無し
		/*
		if( $w:p_story < d:ST:P054_01_P01ピーター死体１ポリゴンデモ１開始 ) {
			command トラップ切り替え -trap fg002 -switch 0
		}
		*/
		if( $f:ピーター浮遊死体デモ見た == 0 ) {
			command トラップ切り替え -trap fg002 -switch 0
		}

	}

/***************************************************************************************************/
// エフェクト
/***************************************************************************************************/
	proc エフェクト設定 {
		#if d:DEBUG_PRINT
			print 'effect_set'
		#endif

		#if d:BLUR
			chara ブラー ブラー
		#endif

		#if d:Z_MANAGER
			chara Ｚフォーカス管理 Z_manager
			mesg Ｚフォーカス管理 Z_manager パラメータ 5000 30
		#endif

		#if d:BODY_SHADOW
			chara ＯＦＦ制御 off_man
			mesg ＯＦＦ制御 off_man ボディシャドウＯＦＦ
		#endif

	}

	proc 水溜まり {
		chara 水溜り管理 水溜り管理人 \
			-n_obj 1 \
			-obj   d:PLAYER

		trap puddle d:PLAYER \
			-mask ？ \
			-exec {
				if($3 == 入る){
					print '水溜まり IN'
					mesg 水溜り管理 水溜り管理人 入る $2
				}else{
					print '水溜まり IN'
					mesg 水溜り管理 水溜り管理人 出る $2
				}
			}
	}

