	}

/***************************************************************************************************/
// 息継ぎポイント設定
/***************************************************************************************************/
	proc 息継ぎポイント設定 {
		chara 息継ぎポイント管理 息継ぎ管理

		command 息継ぎポイント登録 -position 11500 d:WATER_SURFACE -249375
		command 息継ぎポイント登録 -position 11500 d:WATER_SURFACE -236000
		command 息継ぎポイント登録 -position 9750 d:WATER_SURFACE -222000

		command 息継ぎポイント登録 -position -1500 d:WATER_SURFACE -249375
		command 息継ぎポイント登録 -position -1500 d:WATER_SURFACE -236000
		command 息継ぎポイント登録 -position -9500 d:WATER_SURFACE -222000

		command 息継ぎポイント登録 -position 2000 d:WATER_SURFACE -223000
		command 息継ぎポイント登録 -position -2000 d:WATER_SURFACE -223000

	}
/***************************************************************************************************/
// 息継ぎポイントカメラ設定
/***************************************************************************************************/
	proc 息継ぎポイントカメラ設定 {
		//	息継ぎ場所	右上
		trap breath:01 d:PLAYER \
			-mask ？ \
			-camera \
			-state d:TRP_STATE_WATER \
			-exec {
				print 'breath 01'
				chara カメラ設定 息継ぎカメラ \
					-c 1 \
					//-p 11435,-4183,-249154 -t 11435,-6509,-249372 \
					//-r 963,2048,0 -f 2337 \
					//-a 200 \
					-p 11453,-4223,-248631 -t 11453,-6308,-249668 \
					-r 723,2048,0 -f 2328 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3

				if( $3 == 入る ) {
					mesg 通路用水面 キラキラ水面 開始
					mesg 通路用水面 キラキラ水面 表示位置移動 11500 d:WATER_SURFACE -249375
				} else {
					mesg 通路用水面 キラキラ水面 停止
				}
			}

		trap bre d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_WATER \
			-exec {
				if( ($1 == bre:03) && ( $f:ピーター浮遊死体デモ見た == 0 ) ) {
				// ピーター部
				print 'ピーター部'
					if( $3 == 入る ) {
						print '光の中 10'
						mesg フォグコントローラ フォグコン セット 10 0
					} else {
						if( $i:カメラＹ位置 > d:WATER_SURFACE ) {
							print '天井に出た'
							mesg フォグコントローラ フォグコン セット 0 0
						} else {
							print '普通のフォグ 7'
							mesg フォグコントローラ フォグコン セット 7 0
						}
					}
				} else if( ($1 == bre:06) || ($1 == bre:07) ) {
				// 崩落部
				/*
				print '崩落部'
					if( $3 == 入る ) {
						print '光の中'
						mesg フォグコントローラ フォグコン セット 11 0
					} else {
						if( $i:カメラＹ位置 > d:WATER_SURFACE ) {
							print '天井に出た'
							mesg フォグコントローラ フォグコン セット 0 0
						} else {
							print '普通のフォグ'
							mesg フォグコントローラ フォグコン セット 8 0
						}
					}
				*/
					if( $3 == 入る ) {
						print '光の中  普通のフォグ 8'
						mesg フォグコントローラ フォグコン セット 8 0
					} else {
						if( $i:カメラＹ位置 > d:WATER_SURFACE ) {
							print '天井に出た'
							mesg フォグコントローラ フォグコン セット 0 0
						} else {
							print '普通のフォグ 8'
							mesg フォグコントローラ フォグコン セット 8 0
						}
					}
				} else if( $1 == bre:08 ) {
				// 左
				print '左部'
					if( $3 == 入る ) {
						print '光の中 10'
						mesg フォグコントローラ フォグコン セット 10 0
					} else {
						if( $i:カメラＹ位置 > d:WATER_SURFACE ) {
							print '天井に出た'
							mesg フォグコントローラ フォグコン セット 0 0
						} else {
							print '普通のフォグ 7'
							mesg フォグコントローラ フォグコン セット 7 0
						}
					}
				} else {
					if( $3 == 入る ) {
						print '光の中 9'
						mesg フォグコントローラ フォグコン セット 9 0
					} else {
						if( $i:カメラＹ位置 > d:WATER_SURFACE ) {
							print '天井に出た'
							mesg フォグコントローラ フォグコン セット 0 0
						} else {
							print '普通のフォグ 1'
							mesg フォグコントローラ フォグコン セット 1 0
						}
					}
				}
			}


		//	息継ぎ場所	右中
		trap breath:02 d:PLAYER \
			-mask ？ \
			-camera \
			-state d:TRP_STATE_WATER \
			-exec {
				print 'breath 2'
				chara カメラ設定 息継ぎカメラ \
					-c 1 \
					//-p 11422,-4174,-235376 -t 11422,-6100,-235954 \
					//-r 834,2048,0 -f 2011 \
					//-a 200 \
					-p 11446,-4152,-235250 -t 11446,-6402,-236382 \
					-r 720,2048,0 -f 2519 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3

				if( $3 == 入る ) {
					mesg 通路用水面 キラキラ水面 開始
					mesg 通路用水面 キラキラ水面 表示位置移動 11500 d:WATER_SURFACE -236000
				} else {
					mesg 通路用水面 キラキラ水面 停止
				}

				if( $3 == 入る ) {
//					print 'フォグ 0'
					mesg フォグコントローラ フォグコン セット 0 0
				} else {
//					print 'フォグ 1'
					mesg フォグコントローラ フォグコン セット 1 0
				}
			}

		//	息継ぎ場所	右下
		trap breath:03 d:PLAYER \
			-mask ？ \
			-camera \
			-state d:TRP_STATE_WATER \
			-exec {
				print 'breath 3'
				chara カメラ設定 息継ぎカメラ \
					-c 1 \
					//-p 9661,-4001,-221508 -t 9661,-6795,-222131 \
					//-r 881,2048,0 -f 2863 \
					//-a 200 \
					-p 9765,-4123,-221277 -t 9765,-6715,-222478 \
					-r 741,2048,0 -f 2857 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3

				if( $3 == 入る ) {
					mesg 通路用水面 キラキラ水面 開始
					mesg 通路用水面 キラキラ水面 表示位置移動 9750 d:WATER_SURFACE -222000
				} else {
					mesg 通路用水面 キラキラ水面 停止
				}
/*
