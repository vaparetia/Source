	proc かみかみまん {
		chara 浮遊紙 ペーパー \
			-c 1 \
			-o d:PLAYER \
			-n 8 \
			-m paper_a -g 3 -t kami1 \
			-m paper_b -g 3 -t kami1 \
			-m paper_a -g 3 -t kami1 \
			-m paper_a -g 3 -t kami1 \
			-m paper_b -g 3 -t kami1 \
			-m paper_a -g 3 -t kami1 \
			-m paper_b -g 3 -t kami1 \
			-m paper_b -g 3 -t kami1
	}

/***************************************************************************************************/
// 浮遊物
/***************************************************************************************************/

#define TRASH_GROUP		3

	proc 浮遊物 {
		@浮遊物Ａ
		@浮遊物Ｃ
		@浮遊物Ｄ
		@空缶
	}

#define ペットボトル大		wtd_petbottle_mt
#define ペットボトル小		wtd_smallpet_mt
#define 紙コップ			wtd_papercup
#define バルカン人形		wtd_vul_figure

	proc 浮遊物Ａ {
		chara 浮遊物 浮遊物:01 -group d:TRASH_GROUP -trap pet1:01 -m d:ペットボトル小 -y d:PET_MODE_SMALL
		chara 浮遊物 浮遊物:01 -group d:TRASH_GROUP -trap pet1:02 -m d:ペットボトル小 -y d:PET_MODE_SMALL
		chara 浮遊物 浮遊物:01 -group d:TRASH_GROUP -trap pet1:03 -m d:紙コップ -y d:PET_MODE_NORMAL
		chara 浮遊物 浮遊物:01 -group d:TRASH_GROUP -trap pet1:04 -m d:ペットボトル小 -y d:PET_MODE_SMALL
		chara 浮遊物 浮遊物:01 -group d:TRASH_GROUP -trap pet1:05 -m d:紙コップ -y d:PET_MODE_NORMAL
		chara 浮遊物 浮遊物:01 -group d:TRASH_GROUP -trap pet1:06 -m d:紙コップ -y d:PET_MODE_NORMAL
		chara 浮遊物 浮遊物:01 -group d:TRASH_GROUP -trap pet1:07 -m d:ペットボトル大 -y d:PET_MODE_BIG

		mesg 浮遊物 浮遊物:01 非表示

		trap gomi:01 d:PLAYER \
			-mask ? \
			-exec {
				if( $3 == 入る ) {
					print '浮遊物:01 表示'
					mesg 浮遊物 浮遊物:01 表示
				} else {
					print '浮遊物:01 非表示'
					mesg 浮遊物 浮遊物:01 非表示
				}
			}
	}

	proc 浮遊物Ｃ {
		chara 浮遊物 浮遊物:03 -group d:TRASH_GROUP -trap pet3:01 -m d:ペットボトル小 -y d:PET_MODE_SMALL
		chara 浮遊物 浮遊物:03 -group d:TRASH_GROUP -trap pet3:02 -m d:ペットボトル小 -y d:PET_MODE_SMALL
		chara 浮遊物 浮遊物:03 -group d:TRASH_GROUP -trap pet3:03 -m d:ペットボトル小 -y d:PET_MODE_SMALL
		chara 浮遊物 浮遊物:03 -group d:TRASH_GROUP -trap pet3:04 -m d:ペットボトル小 -y d:PET_MODE_SMALL
		chara 浮遊物 浮遊物:03 -group d:TRASH_GROUP -trap pet3:05 -m d:ペットボトル小 -y d:PET_MODE_SMALL
		chara 浮遊物 浮遊物:03 -group d:TRASH_GROUP -trap pet3:06 -m d:紙コップ -y d:PET_MODE_NORMAL
		chara 浮遊物 浮遊物:03 -group d:TRASH_GROUP -trap pet3:07 -m d:ペットボトル小 -y d:PET_MODE_SMALL
		chara 浮遊物 浮遊物:03 -group d:TRASH_GROUP -trap pet3:08 -m d:ペットボトル小 -y d:PET_MODE_SMALL
		chara 浮遊物 浮遊物:03 -group d:TRASH_GROUP -trap pet3:09 -m d:ペットボトル小 -y d:PET_MODE_SMALL
		chara 浮遊物 浮遊物:03 -group d:TRASH_GROUP -trap pet3:10 -m d:紙コップ -y d:PET_MODE_NORMAL
		chara 浮遊物 浮遊物:03 -group d:TRASH_GROUP -trap pet3:11 -m d:ペットボトル小 -y d:PET_MODE_SMALL
		chara 浮遊物 浮遊物:03 -group d:TRASH_GROUP -trap pet3:12 -m d:ペットボトル小 -y d:PET_MODE_SMALL
		chara 浮遊物 浮遊物:03 -group d:TRASH_GROUP -trap pet3:13 -m d:紙コップ -y d:PET_MODE_NORMAL
		chara 浮遊物 浮遊物:03 -group d:TRASH_GROUP -trap pet3:14 -m d:ペットボトル小 -y d:PET_MODE_SMALL
		chara 浮遊物 浮遊物:03 -group d:TRASH_GROUP -trap pet3:15 -m d:ペットボトル小 -y d:PET_MODE_SMALL
		chara 浮遊物 浮遊物:03 -group d:TRASH_GROUP -trap pet3:16 -m d:ペットボトル小 -y d:PET_MODE_SMALL

		mesg 浮遊物 浮遊物:03 非表示

		trap gomi:03 d:PLAYER \
			-mask ? \
			-exec {
				if( $3 == 入る ) {
					print '浮遊物:03 表示'
					mesg 浮遊物 浮遊物:03 表示
				} else {
					print '浮遊物:03 非表示'
					mesg 浮遊物 浮遊物:03 非表示
				}
			}
	}


	proc 浮遊物Ｄ {
		chara 浮遊紙 ペーパーＢ \
			-c 1 \
			-o d:PLAYER \
			-n 10 \
			-m paper_a -g 3 -t kami5 \
			-m paper_b -g 3 -t kami5 \
			-m paper_a -g 3 -t kami5 \
			-m paper_b -g 3 -t kami6 \
			-m paper_a -g 3 -t kami6 \
			-m paper_b -g 3 -t kami6 \
			-m paper_a -g 3 -t kami6 \
			-m paper_b -g 3 -t kami7 \
			-m paper_a -g 3 -t kami7 \
			-m paper_b -g 3 -t kami7

		mesg 浮遊紙 ペーパーＢ 非表示

		chara 浮遊物 浮遊物:04 -group d:TRASH_GROUP -trap pet4:01 -m d:バルカン人形 -y d:PET_MODE_NORMAL
		chara 浮遊物 浮遊物:04 -group d:TRASH_GROUP -trap pet4:02 -m d:ペットボトル大 -y d:PET_MODE_BIG
		chara 浮遊物 浮遊物:04 -group d:TRASH_GROUP -trap pet4:03 -m d:ペットボトル大 -y d:PET_MODE_BIG

		trap gomi:04 d:PLAYER \
			-mask ? \
			-exec {
				if( $3 == 入る ) {
					print '浮遊物:04 表示'
					mesg 浮遊物 浮遊物:04 表示
					mesg 浮遊紙 ペーパーＢ 表示
				} else {
					print '浮遊物:04 非表示'
					mesg 浮遊物 浮遊物:04 非表示
					mesg 浮遊紙 ペーパーＢ 非表示
				}
			}

	}

	proc 空缶 {

		if( $w:p_story < ( d:ST:P062_01_P01エマとＡＩ１ポリゴンデモ１開始 -1 ) ) {
			eval( $f:ローカルフラグ１ = 1 );
		} else {
			eval( $f:ローカルフラグ１ = 0 );
		}

		chara あきかん 空き缶:01 \
			-p 8250 0 -258500 \
			-c 0 \	// 浮かんでる
			-w $f:ローカルフラグ１ \
			-m wtd_kan

		chara あきかん 空き缶:02 \
			-p 9000 0 -257500 \
			-c 0 \	// 浮かんでる
			-w $f:ローカルフラグ１ \
			-m wtd_kan

		chara あきかん 空き缶:03 \
			-p 10000 0 -258000 \
			-c 0 \	// 浮かんでる
			-w $f:ローカルフラグ１ \
			-m wtd_kan

		chara あきかん 空き缶:04 \
			-p 10750 0 -252500 \
			-c 1 \	// 沈んでる
			-w $f:ローカルフラグ１ \
			-m kan

		chara あきかん 空き缶:05 \
			-p 11750 0 -249000 \
			-c 1 \	// 沈んでる
			-w $f:ローカルフラグ１ \
			-m kan

		chara あきかん ひよこ \
			-p -1500 0 -236000 \
			-c 0 \	// 浮かんでる
			-w $f:ローカルフラグ１ \
			-m wtd_hiyoko
	}


// 以下デバッグ専用proc
// -----------------------------------------------------------------------------------
// デバッグキャラ
// ------------------------------------
proc デバッグキャラセット {
	#if d:DEBUG_PRINT
		print 'debug_chara_set'
	#endif

	#if d:MY_DEBUG
	chara スクリーンショット shot

	chara USBキーボード実行 test \
		-e d:KPD_0 {	// フラグ初期化
						//print 'O2'
						//eval( $w:Ｏ２ = ( $w:Ｏ２ + 1000 ) )
						mesg サウンドマネージャー ＳＤマネ SD_CODE d:SNG_FIN_S

				   } \
		-e d:KPD_1 {	// ポジション移動１
						mesg プレイヤー d:PLAYER position 9000, -9000, -222000
						mesg プレイヤー d:PLAYER water 入る 1 3072
						mesg プットオブジェ モデル３ on
				   } \
		-e d:KPD_2 {	// ポジション移動２
						mesg プレイヤー d:PLAYER position -9500, -9000, -222000
						mesg プレイヤー d:PLAYER water 入る 1 2048
						mesg プットオブジェ モデル３ on
				   } \
		-e d:KPD_3 {
						print 'close close'
						mesg 水密ドア 水密君２ close
				   } \
		-e d:KPD_4 {
						print 'open open'
						mesg 水密ドア 水密君２ open
				   } \
		-e d:KPD_5 {
						print 'Ｏ２:'$w:Ｏ２
				   } \
		-e d:KPD_MINUS {
						command プレイヤー無敵セット
						mesg コマンダー 敵兵セット 視界オフ
				   } \
		-e d:KPD_PLUS {
						command プレイヤー無敵解除
						mesg コマンダー 敵兵セット 視界オン
				   }
	#endif
}

