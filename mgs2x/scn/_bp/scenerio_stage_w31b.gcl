	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif

		chara カメラ ロードカメラ		-c 0 -l 1 -p 10
		chara カメラ 息継ぎカメラ		-c 0 -l 1 -p 20
		chara カメラ ノードカメラ		-c 0 -l 1 -p 40
		chara カメラ モーションカメラ	-c 0 -l 1 -p 50

		chara カメラ 水面カメラ０		-c 0 -l 2 -p 20
		chara カメラ 水面カメラ１		-c 0 -l 2 -p 25
		chara カメラ 張り付きカメラ		-c 0 -l 2 -p 29
		chara カメラ 通路カメラ０		-c 0 -l 2 -p 30
		chara カメラ 通路カメラ１		-c 0 -l 2 -p 40

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0


		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 150,2048,0 \
			-f 1500 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1

	}
	proc シェル２中央棟Ｂ１カメラ設定 {
		#if d:DEBUG_PRINT
			print 'w31b_camera_set'
