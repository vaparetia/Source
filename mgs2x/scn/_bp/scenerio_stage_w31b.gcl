			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 通路カメラ１ \
					-c 1 \
					-p 9004,-362,-249540 -t 8535,-3839,-252736 \
					-r 536,2143,0 -f 4746 \
					-a 200 \
					-i 2 2 0 0 \
					-s $3
			}

		// 水中
		trap ca003 d:PLAYER \
			-mask ？ \
			-camera \
			-state d:TRP_STATE_WATER \
