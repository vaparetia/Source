					-l -2129,-1898,-251274  8746,-1898,-251274 \
					-r 90,2048,0 -f 5078 \
					-a 200 \
					-i 2 2 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// エレベータ横階段左
