#define		ELEVATOR		1		// エレベーター
#define		CHARA_CEIL		1		// 天井君

// エレベーター
#define		ELEVATOR_SET	1
#define		ELEVATOR_Y		-4000
//#define		ELEVATOR_Z		-180000
#define		ELEVATOR_Z		-180250
#define		ELV_B1			1
#define		SHELL			1		// エレベーター用 シェル2

// 強制モーション



// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME		w31b
#define		KMS_NAME0		w31b
#define		KMS_NAME1		w31c0	// ヴァンプ戦
													//#define		CEIL_NAME0		w31br0	//	２階天井
													//#define		CEIL_NAME1		w31br1	//	階段以下天井
#define		CEIL_NAME0		w31br0			// エレベーター前天井
#define		CEIL_NAME1		w31br1			// 北側階段天井
#define		CEIL_NAME2		w31br2			// 水没部分天井
#define		CEIL_NAME3		w31br3			// 南側階分天井
#define		CEIL_NAME4		w31br_ikitugi	// 息継ぎポイント

//#define		CEIL_NAME2		w31c0r
//#define		CEIL_NAME3		w31c1r
#define		DOOR_NAME0		dr1_a			//	水密ドア
#define		DOOR_NAME1		dr1_b			//	水密ドア
#define		DOOR_NAME2		dr_lv4_00		//	スライドドア
#define		LT2_NAME		w31b

#define		DOOR_NAME_ELV_1	elv_dr1			// エレベータ用１
#define		DOOR_NAME_ELV_2	elv_dr2			// エレベータ用２

// キャラクター関係
#if d:RAIDEN
	#define		PLAYER		ライデン
#else
	#define		PLAYER		スネーク
#endif

// 水中用ディファイン
#define	WATER_MODE			1		// 水中モード基本キャラ設定を使用するのに必要
#define WATER_SURFACE		-6450	// 水面の高さ
#define	WATER_CAMERA_ZONE	1		// 追従カメラが使用するゾーンのあるグループ番号(必要があれば定義する)
#define	CAMERA_BUBBLE_NUM	9		// カメラ泡の個数(いらない場合は定義しない)
#define	CAMERA_DUST_NUM		10		// カメラダストの個数(いらない場合は定義しない)
