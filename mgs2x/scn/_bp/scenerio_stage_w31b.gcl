		chara 天窓の光 ひかり７ \
			-pos 	1500, -6250, -223500, 2500, -6250, -222500 \
					(1500-500), -10500, (-223500-500), (2500+500), -10500, (-222500+500) \
			-color	0x34323030 \
			-dcol	0x34323010

		chara 天窓の光 ひかり８ \
			-pos 	-2500, -6250, -223500, -1500, -6250, -222500 \
					(-2500-500), -10500, (-223500-500), (-1500+500), -10500, (-222500+500) \
			-color	0x34323030 \
			-dcol	0x34323010

		chara 天窓の光 ひかり６ \
			-pos 	-10250, -6250, -222750, -8750, -6250, -221250 \
					(-10250-500), -10500, (-222750-500), (-8750+500), -10500, (-221250+500) \
			-color	0x34323030 \
			-dcol	0x34323010
	}

	proc スポットライト設置 {
		#if d:DEBUG_PRINT
			print 'debug_spot_light_set'
		#endif
	///////
	// 上
		// ホールライト１
		chara スポットライト投影モデル ホールライト１ \
			-m w31b_k0 \
			-p 0,0,0

		chara 静止スポットライト設置 ホールライト１ \
			-p 11250,-5000,-249500 \
			-dir 1000,2048,0 \
			-range 7878 \
			-angle 13 \
			-color 38,87,100 \
			-option 0x0001

		// ホールライト２
		chara スポットライト投影モデル ホールライト２ \
			-m w31b_k2 \
			-p 0,0,0

		chara 静止スポットライト設置 ホールライト２ \
			-p -1500,-5000,-249500 \
			-dir 1000,2048,0 \
			-range 7878 \
			-angle 12 \
			-color 38,87,100 \
			-option 0x0001

	///////
	// 中
		// ホールライト３
		chara スポットライト投影モデル ホールライト３ \
			-m w31b_k1 \
			-p 0,0,0

		chara 静止スポットライト設置 ホールライト３ \
			-p 11500,-5000,-236000 \
			-dir 1000,2048,0 \
			-range 7878 \
			-angle 13 \
			-color 38,87,100 \
			-option 0x0001

		// ホールライト４
		chara スポットライト投影モデル ホールライト４ \
			-m w31b_k3 \
			-p 0,0,0

		chara 静止スポットライト設置 ホールライト４ \
			-p -1500,-5000,-236000 \
			-dir 1000,2048,0 \
			-range 7878 \
			-angle 13 \
			-color 38,87,100 \
			-option 0x0001

	///////
	// 下
		// ホールライト５
		chara スポットライト投影モデル ホールライト５ \
			-m w31b_k4 \
			-p 0,0,0

		chara 静止スポットライト設置 ホールライト５ \
			-p 9750,-5000,-222000 \
			-dir 1000,2048,0 \
			-range 7878 \
			-angle 13 \
			-color 38,87,100 \
			-option 0x0001

		// ホールライト６
		chara スポットライト投影モデル ホールライト６ \
			-m w31b_k7 \
			-p 0,0,0

		chara 静止スポットライト設置 ホールライト６ \
			-p -9500,-5000,-222000 \
			-dir 1000,2048,0 \
			-range 7878 \
			-angle 13 \
			-color 38,87,100 \
			-option 0x0001

	///////////
	// 小部屋
		// ホールライト７
		chara スポットライト投影モデル ホールライト７ \
			-m w31b_k5 \
			-p 0,4,0

		chara 静止スポットライト設置 ホールライト７ \
			-p 2000,-5000,-223000 \
			-dir 1000,2048,0 \
			-range 7878 \
			-angle 13 \
			-color 38,87,100 \
			-option 0x0001

		// ホールライト８
		chara スポットライト投影モデル ホールライト８ \
			-m w31b_k6 \
			-p 0,4,0

		chara 静止スポットライト設置 ホールライト８ \
			-p -2000,-5000,-223000 \
			-dir 1000,2048,0 \
			-range 7878 \
			-angle 13 \
			-color 38,87,100 \
			-option 0x0001

	/////////////////////////////////////////
	// ステージ開始時は全てをＯＦＦにしておく
		chara delay 泡ディレイ -time 2 -exec {
		// ※スタート時にmesgが32個以上飛んでいるので1フレーム遅らせる
			mesg 静止スポットライト設置 ホールライト１ off
			mesg 静止スポットライト設置 ホールライト２ off
			mesg 静止スポットライト設置 ホールライト３ off
			mesg 静止スポットライト設置 ホールライト４ off

			mesg 天窓の光 ひかり１ スリープモード
			mesg 天窓の光 ひかり２ スリープモード
			mesg 天窓の光 ひかり３ スリープモード
			mesg 天窓の光 ひかり４ スリープモード

			if( $s:登場ポイント != ポリデモ全て終了 ) {
				mesg 静止スポットライト設置 ホールライト６ off
				mesg 天窓の光 ひかり６ スリープモード
			}

			if( $f:ピーターデモ後スポットライト配置 != 1 ) {
				mesg 静止スポットライト設置 ホールライト５ off
				mesg 静止スポットライト設置 ホールライト７ off
				mesg 静止スポットライト設置 ホールライト８ off

				mesg 天窓の光 ひかり５ スリープモード
				mesg 天窓の光 ひかり７ スリープモード
				mesg 天窓の光 ひかり８ スリープモード
			} else {
				eval( $f:ピーターデモ後スポットライト配置 = 0 )
				// 通常はstdproc.hでオフにされている
				mesg カメラ泡     泡ぶくマン オン
				mesg カメラダスト ダストマン オン
			}
		}

	/////////////////////////////
	// トラップによるＯＮ・ＯＦＦ

		trap sl001 d:PLAYER \
			-mask ？ \
			-exec {
				if( $3 == 入る ) {
					print 'ホールライト１ on'
					mesg 静止スポットライト設置 ホールライト１ on
					mesg 天窓の光 ひかり１ アクティブモード
				} else {
					print 'ホールライト１ off'
					mesg 静止スポットライト設置 ホールライト１ off
					mesg 天窓の光 ひかり１ スリープモード
				}
			}

		trap sl002 d:PLAYER \
			-mask ？ \
			-exec {
				if( $3 == 入る ) {
					print 'ホールライト２ on'
					mesg 静止スポットライト設置 ホールライト２ on
					mesg 天窓の光 ひかり２ アクティブモード
				} else {
					print 'ホールライト２ off'
					mesg 静止スポットライト設置 ホールライト２ off
					mesg 天窓の光 ひかり２ スリープモード
				}
			}

		trap sl003 d:PLAYER \
			-mask ？ \
			-exec {
				if( $3 == 入る ) {
					print 'ホールライト３ on'
					mesg 静止スポットライト設置 ホールライト３ on
					mesg 天窓の光 ひかり３ アクティブモード

				} else {
					print 'ホールライト３ off'
					mesg 静止スポットライト設置 ホールライト３ off
					mesg 天窓の光 ひかり３ スリープモード
				}
			}

		trap sl004 d:PLAYER \
			-mask ？ \
			-exec {
				if( $3 == 入る ) {
					print 'ホールライト４ on'
					mesg 静止スポットライト設置 ホールライト４ on
					mesg 天窓の光 ひかり４ アクティブモード
				} else {
					print 'ホールライト４ off'
					mesg 静止スポットライト設置 ホールライト４ off
					mesg 天窓の光 ひかり４ スリープモード
				}
			}

		trap sl005 d:PLAYER \
			-mask ？ \
			-exec {
				if( $3 == 入る ) {
					print 'ホールライト５ on'
					mesg 静止スポットライト設置 ホールライト５ on
					mesg 天窓の光 ひかり５ アクティブモード
				} else {
					print 'ホールライト５ off'
					mesg 静止スポットライト設置 ホールライト５ off
					mesg 天窓の光 ひかり５ スリープモード
				}
			}

		trap sl006 d:PLAYER \
			-mask ？ \
			-exec {
				if( $3 == 入る ) {
					print 'ホールライト６ on'
					mesg 静止スポットライト設置 ホールライト６ on
					mesg 天窓の光 ひかり６ アクティブモード
				} else {
					print 'ホールライト６ off'
					mesg 静止スポットライト設置 ホールライト６ off
					mesg 天窓の光 ひかり６ スリープモード
				}
			}

		// 小部屋右
		trap sl007 d:PLAYER \
			-mask ？ \
			-exec {
				if( $3 == 入る ) {
					print 'ホールライト７ on'
					mesg 静止スポットライト設置 ホールライト７ on
					mesg 天窓の光 ひかり７ アクティブモード
				} else {
					print 'ホールライト７ off'
					mesg 静止スポットライト設置 ホールライト７ off
					mesg 天窓の光 ひかり７ スリープモード
				}
			}

		// 小部屋左
		trap sl007 d:PLAYER \
			-mask ？ \
			-exec {
				if( $3 == 入る ) {
					print 'ホールライト８ on'
					mesg 静止スポットライト設置 ホールライト８ on
					mesg 天窓の光 ひかり８ アクティブモード
				} else {
					print 'ホールライト８ off'
					mesg 静止スポットライト設置 ホールライト８ off
					mesg 天窓の光 ひかり８ スリープモード
				}
			}


		trap sl005_006 d:PLAYER \
			-mask 入る \
			-dir 1024 512 \
			-exec {
				print '右'
				mesg 静止スポットライト設置 ホールライト５ on
				mesg 静止スポットライト設置 ホールライト６ off
				mesg 天窓の光 ひかり５ アクティブモード
				mesg 天窓の光 ひかり６ スリープモード
			}
		trap sl005_006 d:PLAYER \
			-mask 入る \
			-dir 3072 512 \
			-exec {
				print '左'
				mesg 静止スポットライト設置 ホールライト５ off
				mesg 静止スポットライト設置 ホールライト６ on
				mesg 天窓の光 ひかり５ スリープモード
				mesg 天窓の光 ひかり６ アクティブモード

			}
	}




