				chara カメラ設定 水面カメラ１ \
					-c 0 \
					-b 7912 d:CAM_MIN -253903  8998 d:CAM_MAX -254654 \
					-l 7912 d:CAM_MIN -256332  8998 d:CAM_MAX -257083 \
					-r 615,2048,0 -f 4138 \
