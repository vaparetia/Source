/***************************************************************************************************/
// 水中処理
/***************************************************************************************************/

	proc 水中セット {

		chara 通路用水面 キラキラ水面 \
			-tex water w31b_ref_water_alp_ovl_01 \
			-scale 150 \
			-pos 10000, (d:WATER_SURFACE), -257000 \
			-wave 30 170 12 \
			-ctrl \
			-alpha_blend \
			-force 10

		// エレベータ側の場合は停止しておく
		if( $s:登場ポイント == sp_w31a_w31b_0 ) {
			mesg 通路用水面 キラキラ水面 停止
		}

		trap sf001 d:PLAYER \
			-mask ？ \
			-exec {
				if( $3 == 入る ) {
					mesg 通路用水面 キラキラ水面 開始
					mesg 通路用水面 キラキラ水面 表示位置移動 10000 (d:WATER_SURFACE) -257000

					mesg パイプ流水 ぱいぷみず アクティブモード
				} else {
					mesg 通路用水面 キラキラ水面 停止

					mesg パイプ流水 ぱいぷみず スリープモード

				}
			}

		trap sf002 d:PLAYER \
			-mask ？ \
			-exec {
				if( $3 == 入る ) {
					mesg 通路用水面 キラキラ水面 開始
					mesg 通路用水面 キラキラ水面 表示位置移動 -8500 (d:WATER_SURFACE) -228000
				} else {
					mesg 通路用水面 キラキラ水面 停止
				}
			}
	}

