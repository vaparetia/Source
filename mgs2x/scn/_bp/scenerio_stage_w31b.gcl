	proc 水中出入り処理  {

	// エレベーター側
		trap wa001 d:PLAYER \
			-mask ＊ \
			-exec {
				if( `@入出水チェック` ) {
					eval( $b:入水ポイント = 1 )
					if( !( `command プレイヤー状態取得` & d:PFLAG_WATER ) ) {
						@入水処理実行 8750 -4000 -252000 d:NORTH 4000 120 370
					} else {
						// 水中で水面
						if (( $status & d:PFLAG_WATER ) && ( $status & d:PFLAG_WATER_SURFACE )){
							@出水処理実行 8750 -8000 (-256000+100) d:SOUTH 4000 5 5
						}
					}
				}
			}

	// ヴァンプ戦側
		trap wa002 d:PLAYER \
			-mask ＊ \
			-exec {
				if( `@入出水チェック` ) {
					eval( $b:入水ポイント = 2 )
					if( !( `command プレイヤー状態取得` & d:PFLAG_WATER ) ) {
						@入水処理実行 -8500 -6250 -230000 d:SOUTH 1500 5 245
					} else {
						// 水中で水面
						if (( $status & d:PFLAG_WATER ) && ( $status & d:PFLAG_WATER_SURFACE )){
							@出水処理実行 -8500 -7750 (-228500-100) d:NORTH 1500 5 5
						}
					}
				}
			}
/*
		trap wa002 d:PLAYER \
			-mask 入る \
			-camera \
			-state d:TRP_STATE_FORCE \
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN  d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN  d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 291,2154,0 -f 1889 \
					-a 200 \
					-i 1 1 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}
*/
	}

