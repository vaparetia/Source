#else
	#define MY_DEBUG	0		// デバッグ
	#define ASSERT		0		// Assert関数使用
#endif

// レーダー用
#define 	STAGE_PLANT		1		// プラントレーダー

// 各種スイッチ用define
#define		NODE			1		// ノード端末

// サウンド
#define STAGE_W31B			1		// サウンド用ディファイン


// サウンド
#define		SOUND			1		// サウンドデータは最初に呼ぶ
#define		BGM				1		// BGMは敵兵コマンダーの後に呼ぶ

#define		DEMO			0		// デモ
// ノード端末
// キャラクター関係
