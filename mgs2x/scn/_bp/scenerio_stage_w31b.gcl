	proc 背負いカメラＩＮ {
		if( $b:入水ポイント == 1 ) {
			// エレベーター側
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p 7675,-2116,-249327 -t 8652,-3095,-251761 \
				-r 233,1799,0 -f 2800 \
				-a 200 \
				-i 2 -1 0 0 \
				-s 1
		} else {
			// ヴァンプ戦側
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p -7861,-5114,-227619 -t -8507,-5290,-229968 \
				-r 47,2223,0 -f 2443 \
				-a 200 \
				-i 2 -1 0 0 \
				-s 1
