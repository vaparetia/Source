	proc 水中エフェクト{

		// 連続発生泡
		chara 連続発生線状泡 プクプク泡 -p 4000 -10500 -222500
		chara 連続発生線状泡 プクプク泡 -p 4500 -10500 -222000
		chara 連続発生線状泡 プクプク泡 -p 4000 -10500 -218000
		chara 連続発生線状泡 プクプク泡 -p 1000 -10500 -221500
		chara 連続発生線状泡 プクプク泡 -p -4000 -10500 -218000

		chara 連続発生線状泡 プクプク水密泡 -p 7500 -10500 -222000

		chara 連続発生線状泡 左水密泡 -p -6500 -10000 -222000
		chara 連続発生線状泡 左水密泡 -p -6500 -10000 (-222000+300)
		chara 連続発生線状泡 左水密泡 -p -6500 -10000 (-222000-300)

		chara delay 泡ディレイ -time 2 -exec {
		// ※スタート時にmesgが32個以上飛んでいるので1フレーム遅らせる
			mesg 連続発生線状泡 プクプク水密泡 オフ
			mesg 連続発生線状泡 左水密泡 オフ
		}
	}

