}
//dv}//v
}//d

//ガンサイファー h //e
resource PC_エマ狙撃＿ガンサイファー {
//vox t:vc264481 {
大佐_000: {
雷電、ガンサイファーに気をつけろ。
エマへ接近する前に撃墜するんだ。
}
//dv}//v
}//d


//ヴァンプ狙撃 h //e
resource PC_エマ狙撃＿ヴァンプ狙撃＿基本 {
//vox t:vc264491 {
大佐_000: {
雷電、エマが危ない。
ヴァンプだけを狙撃するんだ。絶対に
