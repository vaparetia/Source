}
//dv}//v
}//d

//★P065_06_R02Ｌ脚エマ６無線機デモ２終了＜フラグ＜P067_01_R01エマ狙撃１無線機デモ１開始 d //e
//狙撃イベント h //e
//基本指示 h //e
resource PC_エマ狙撃＿基本指示１ {
//vox t:vc264361 {
大佐_000: {
エマがオイルフェンスを渡りきるまで
そこから援護するんだ。ＰＳＧ１で
狙撃して邪魔するものを排除しろ。
}
//dv}//v
}//d
//弾を補給しろ h //e
resource PC_エマ狙撃＿弾 {
//vox t:vc264371 {
大佐_000: {
ＰＳＧ１の弾がなくなったら
補給するのを忘れるな。
近くにあるはずだ。
}
//dv}//v
}//d
//姿勢によっててぶれ h //e
resource PC_エマ狙撃＿姿勢 {
//vox t:vc264381 {
大佐_000: {
ＰＳＧ１で狙撃する時は
どうしても手ぶれが起こる。
}
大佐_001: {
だが＃｛伏せ姿勢、プローン・ポジション｝＃で構えれば手ぶれを
かなり抑えることができるだろう。
ホフクしてＰＳＧ１を装備するんだ。
}
//dv}//v
}//d


//エマが海に落ちるとアウト h //e
resource PC_エマ狙撃＿桟橋ゆれアウト {
//vox t:vc264391 {
大佐_000: {
もし海に落ちたらエマは
助からないだろう。
}
大佐_001: {
近くで爆発が起きたらオイルフェンスが
大きく揺れてエマが海に落ちてしまう
かも知れん。
}
大佐_002: {
スティンガーを使う時等は気をつけろ。
}
//dv}//v
}//d


//クレイモア h //e
resource PC_エマ狙撃＿クレイモア {
//vox t:vc264401 {
大佐_000: {
雷電、気をつけるんだ。肉眼では
見えないが、オイルフェンスに
クレイモア地雷が敷設してあるようだ。
}
大佐_001: {
クレイモアは＃｛赤外線、サーマル｝＃ゴーグルを
装備すれば見えるようになる。
クレイモアを狙撃して排除するんだ。
}
//dv}//v
}//d

//エマ足止め h //e
resource PC_エマ狙撃＿エマ足止め１ {
//vox t:vc264411 {
大佐_000: {
エマは薬物の影響でまだ体の自由が
きかないようだ。とっさの判断力も
