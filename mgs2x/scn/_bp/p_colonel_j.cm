//BP - modifying source to restore original text and string count from JP/SOL.
#ifndef BP_JP_SUBSTANCE_USE_ENGLISH_VOICE

//ＭＧＳのメイリンの格言１ h //e
resource PC_発狂＿格言１ {
//vox t:vc266641 {
大佐_000: {
中国にはね、『匹夫の勇、１人に敵する
ものなり』っていう諺があるの。
}
大佐_001: {
無闇に戦いを求める愚か者の勇気は、
１人の敵を相手にするのが
精いっぱいって意味よ。
}
大佐_002: {
スネークはたった１人で敵の中に
潜入してるんだから、やたらと戦闘を
仕掛けたりしないで、慎重に行動してね。
}
//dv}//v
}//d

//ＭＧＳのメイリンの格言２ h //e
resource PC_発狂＿格言２ {
//vox t:vc266651 {
大佐_000: {
中国では『欲多ければ則ち生を傷る』っ
て言うことがあるの。
}
大佐_001: {
欲をかくと、体を傷めることになるって
いう意味よ。
}
大佐_002: {
アイテムを取るのに欲張りすぎると、
怪我をするわ。気をつけてね。
}
//dv}//v
}//d


#else //BP

//ＭＧＳのメイリンの格言１ h //e
resource PC_発狂＿格言１ {
//vox t:vc266641 {
大佐_000: {
ドゴールの言葉を忘れないで。
}
大佐_000_1: {
「墓地は自称勇者で溢れている」
}
/*
中国にはね、『匹夫の勇、１人に敵する
ものなり』っていう諺があるの。
*/
大佐_001: {
無闇に戦いを求める愚か者の勇気は、
１人の敵を相手にするのが
精いっぱいって意味よ。
}
大佐_002: {
スネークはたった１人で敵の中に
潜入してるんだから、やたらと戦闘を
仕掛けたりしないで、慎重に行動してね。
}
//dv}//v
}//d

//ＭＧＳのメイリンの格言２ h //e
resource PC_発狂＿格言２ {
//vox t:vc266651 {
大佐_000: {
スネーク、シェイクスピアにも、
「満足を知らぬ欲望の中では、人間は何を
所有する事もかなわず、全てを使い果たして
しまう」とあるわ。
}
/*中国では『欲多ければ則ち生を傷る』っ
て言うことがあるの。
*/
大佐_001: {
人間は、気をつけてないと欲をかいて
困ったことになりがちだっていうような
意味よ。
}
/*
欲をかくと、体を傷めることになるって
いう意味よ。
*/
大佐_002: {
アイテムを取るのに欲張りすぎると、
怪我をするわ。気をつけてね。
}
//dv}//v
}//d

#endif //BP


//能勢電の駅名 h //e
resource PC_発狂＿能勢電 {
//vox t:vc266661 {
大佐_000: {
川西能勢口、絹延橋、滝山、鴬の森、
皷滝、多田、平野、一の鳥居、畦野、
山下、笹部、光風台、ときわ台、妙見口。
}
//dv}//v
}//d


//デフォルト操作説明系 d //e

//プラント外部でリモコン装備時 h //e
resource PC_リモコンミサイル使えない１ {
//vox t:vc266261 {
大佐_000: {
雷電、リモコンミサイルは
『ビッグ・シェル』外部では
使えないぞ。
}
//dv}//v
}//d
//一回目のみ t //e
resource PC_リモコンミサイル使えない２ {
//vox t:vc266271 {
ライデン_000: {
なぜだ？
}
大佐_001: {
妨害電波だ。『ビッグ・シェル』
周辺一帯に電子妨害がかけられている。
}
ライデン_002: {
テロリスト達が？
}
大佐_003: {
おそらくな。我々が＃｛無人偵察機、ＵＡＶ｝＃等で
偵察を行うのを阻止するつもり
なのだろう。
}
ライデン_004: {
しかし奴等も無線やサイファーを
使っている？
}
大佐_005: {
当然だ。自分達で使用する周波数帯に
まで妨害をかける訳がない。影響を
受けるのは君のリモコンミサイルだけだ。
}
大佐_006: {
だが幸いなことに妨害電波は
それほど強くない。
}
大佐_007: {
『ビッグ・シェル』内部なら問題なく
リモコンミサイルも使えるはずだ。
}
//dv}//v
}//d

//懸垂で握力ＵＰ ＬＥＶＥＬ１ h //e
resource PC_懸垂握力ＬＶ１ {
//vox t:vc266281 {
大佐_000: {
雷電、握力が上がったぞ。
懸垂で体を鍛えたかいがあったな！
}
//dv}//v
}//d

//懸垂で握力ＵＰ ＬＥＶＥＬ２ h //e
resource PC_懸垂握力ＬＶ２＿１ {
//vox t:vc266291 {
大佐_000: {
雷電、また握力が上がったぞ！
}
//dv}//v
}//d
resource PC_懸垂握力ＬＶ２＿２ {
//vox t:vc266301 {
ローズ_000: {
ジャック、すごい！
}
//dv}//v
}//d

//懸垂で握力ＵＰ ＬＥＶＥＬ３ h //e
resource PC_懸垂握力ＬＶ３＿１ {
//vox t:vc266311 {
大佐_000: {
雷電、さらに握力が上がったぞ！
}
//dv}//v
}//d
resource PC_懸垂握力ＬＶ３＿２ {
//vox t:vc266321 {
ローズ_000: {
ジャックったら、もうすごすぎ！！
}
//dv}//v
}//d
//もう握力は上がりません h //e
resource PC_懸垂握力上がらない１ {
//vox t:vc266331 {
大佐_000: {
雷電……いつまでやってるんだ。
懸垂はもういいから、そろそろ任務に
戻ってくれ。
}
//dv}//v
}//d
resource PC_懸垂握力上がらない２ {
//vox t:vc266341 {
ローズ_000: {
ジャック……あなた調子に乗りすぎ。
ものには限度ってものがあるのよ。
}
//dv}//v
}//d


//Ｌ１ボタンロックオン h //e
resource PC_Ｌ１ボタンロックオン {
//vox t:vc266351 {
大佐_000: {
銃を構えた状態でＬ１ボタンを押すと
ロックオンができる。素早く狙いを
定める時には役立つはずだ。
}
大佐_001: {
ただロックオンで狙えるのは敵の胴体
のみだ。急所を狙う場合は主観攻撃を
使え。
}
//dv}//v
}//d

//エレベータは敵兵が中にいると動かない h //e
resource PC_エレベータ敵兵動かない {
//vox t:vc266361 {
大佐_000: {
雷電、エレベータは中に敵がいる時は
作動しない。エレベータの外に敵を
連れ出すんだ。
}
//dv}//v
}//d
//スネークの周波数 無線していない場合１ h //e
resource PC_プリスキン周波数１ {
//vox t:vc266371 {
ローズ_000: {
プリスキン中尉なら何か知っているかも
知れない。聞いてみたら？
}
//dv}//v
}//d
resource PC_プリスキン周波数２ {
//vox t:vc266381 {
ローズ_000: {
プリスキン中尉の方はどうかしら？
聞いてみたら？
}
//dv}//v
}//d
resource PC_プリスキン周波数３ {
//vox t:vc266391 {
ローズ_000: {
プリスキン中尉の周波数は
１４１．８０でしょ？
}
//dv}//v
}//d

//各部の機能説明 d //e
//一般的説明 h //e
resource PC_一般機能説明 {
//vox t:vc266401 {
ローズ_000: {
ジャック、『ビッグ・シェル』について
調べてみたの。
}
ローズ_001: {
２年前のタンカー沈没事件によって
大規模な原油流出が引き起こされた。
}
ローズ_002: {
『ビッグ・シェル』はその原油を回収・
処理し、ＮＹ湾の環境回復を図るために
建設された海上除染施設なの。
}
ローズ_003: {
『ビッグ・シェル』の周囲の海域には
オイルフェンスが張り巡らされて
原油の拡散を防いでいる。
}
ローズ_004: {
フェンスのあちこちに尖塔が立ってる
でしょ。それが汚染海水をくみ上げる
ためのパイル。
}
ローズ_005: {
くみ上げられた海水はＡ脚のポンプ室を
通って、一度Ｄ脚にある第一沈殿槽に
溜められて大きなゴミを取り除かれる。
}
ローズ_006: {
その後シェル２中央棟にある貯水槽で
微生物を使った二段階の浄化をされて
原油が取り除かれる。
}
ローズ_007: {
そしてＬ脚に送られて殺菌された後、
もう一度海上のパイルに送られて
放流されるって流れ。
}
ライデン_008: {
軍のデータベースには海上除染施設の
構造まで入力されてるのか。
}
ローズ_009: {
いいえ。
データベースは使ってないわ。
}
ライデン_010: {
え？
}
ローズ_011: {
パンフレットに載ってたの。
}
//dv}//v
}//d


//Ａ脚の役割について h //e
resource PC_Ａ脚機能説明 {
//vox t:vc266411 {
ローズ_000: {
Ａ脚は汚染海水を海上からくみ上げ、
『ビッグ・シェル』各部を巡回させる
ための動力を供給するポンプ施設ね。
}
ローズ_001: {
南側がポンプ施設本体、
北側がその制御施設になってる。
}
//dv}//v
}//d

//Ｂ脚の役割について h //e
resource PC_Ｂ脚機能説明 {
//vox t:vc266421 {
ローズ_000: {
Ｂ脚は『ビッグ・シェル』の
電力をまかなう発電施設なの。
１Ｆはそのための変電設備ね。
}
//dv}//v
}//d


//Ｃ脚の役割について h //e
resource PC_Ｃ脚機能説明 {
//vox t:vc266431 {
ローズ_000: {
Ｃ脚は居住区。『ビッグ・シェル』
職員の洋上生活を支えるための施設。
}
ローズ_001: {
と言っても、『ビッグ・シェル』は
全システムがほぼ自動化されているから
職員の数は少ないんだけど。
}
//dv}//v
}//d


//Ｄ脚の役割について h //e
resource PC_Ｄ脚機能説明 {
//vox t:vc266441 {
ローズ_000: {
Ｄ脚は第一沈殿池。くみ上げた
汚染海水を静かに溜めて大きなゴミを
沈殿させ、除去するための施設ね。
}
//dv}//v
}//d


//Ｅ脚の役割について h //e
resource PC_Ｅ脚機能説明１ {
//vox t:vc266451 {
ローズ_000: {
Ｅ脚は、屋上がヘリポート。
内部が空輸された資材を
各脚に送り出す施設。
}
//dv}//v
}//d
//屋上の場合 t //e
resource PC_Ｅ脚機能説明＿屋上 {
//vox t:vc266461 {
ローズ_000: {
海上がオイルフェンスで閉鎖されている
から、船による『ビッグ・シェル』への
物資輸送はほとんど行われていないの。
}
ローズ_001: {
ほぼ全ての物資が屋上のヘリポートから
持ち込まれるという訳ね。
}
//dv}//v
}//d

//屋内の場合 t //e
resource PC_Ｅ脚機能説明＿集配場 {
//vox t:vc266471 {
ローズ_000: {
Ｅ脚内部には物資を自動でより分ける
システムが完備されているわ。
}
ローズ_001: {
ダンボール箱を認識して判別している
みたい。自動で荷物を各脚に配送する
ことで省人力化を図っているってことね。
}
//dv}//v
}//d

//Ｆ脚の役割について h //e
resource PC_Ｆ脚機能説明 {
//vox t:vc266481 {
ローズ_000: {
Ｆ脚は倉庫。『ビッグ・シェル』の
メンテナンス用に様々な資材が
備蓄されていると思う。
}
ローズ_001: {
あなたの役に立つ物もあるかも
知れない。探してみたら？
}
//dv}//v
}//d


//シェル１中央棟の役割について h //e
resource PC_シェル１中央棟機能説明 {
//vox t:vc266491 {
ローズ_000: {
シェル１中央棟は文字どおり
『ビッグ・シェル』の中心ね。
}
ローズ_001: {
Ｂ１には大規模な＃｛集会場、ホール｝＃がある。
そこで大統領と環境保護視察団の
歓迎レセプションが行われたはずよ。
}
ローズ_002: {
でもその機能の中枢はＢ２にある
電算室に集約されてるの。
}
ローズ_003: {
この電算室で汚染海水の循環や
除染状態の監視等、各施設の管理を
全て行うようになってる。
}
ローズ_004: {
警備が厳重なのもうなずけるわね。
}
//dv}//v
}//d

//シェル２中央棟の役割について h //e
resource PC_シェル２中央棟機能説明 {
//vox t:vc266501 {
ローズ_000: {
シェル２中央棟は汚染海水を除染する
システムの本体……だった。
今は見る影もないけど……。
}
ローズ_001: {
炭化水素分解細菌とかの微生物を使って、
くみ上げた原油混じりの海水を除染する
施設。
}
ローズ_002: {
Ｂ１以下はそのための巨大な水槽に
なっていたの。それが壊れて浸水
してるって訳ね。
}
ローズ_003: {
浸水していない１Ｆは汚染海水の
悪臭を除去するための空気清浄施設。
}
ローズ_004: {
マンハッタンのすぐ近くだもの。
気を遣うことが多いみたいね。
}
//dv}//v
}//d

//Ｌ脚の役割について h //e
resource PS_Ｌ脚機能説明 {
//vox t:vc266511 {
ローズ_000: {
Ｌ脚は汚水処理施設……だった。
}
ローズ_001: {
原油を取り除いた海水を塩素等の化学
薬品を使って殺菌・消毒して放流可能な
状態にするための施設だったみたいね。
}
//dv}//v
}//d



//大佐発狂中会話 d //e
//ゲームオーバーが多い場合 h //e
resource PC_発狂＿ゲームオーバー回数 {
//vox t:vc266671 {
大佐_000: {
前から思っていたんだが、
君はゲームオーバーになりすぎだ。
こう言っては何だがかなりヘタだな。
}
//dv}//v
}//d
//プレイ時間が長すぎる場合 h //e
resource PC_発狂＿プレイ時間 {
//vox t:vc266681 {
大佐_000: {
しかし、随分長い間ゲームしてるな。
他にすることはないのか？まったく……。
}
//dv}//v
}//d
//殺しすぎな場合 h //e
resource PC_発狂＿殺しすぎ {
//vox t:vc266691 {
大佐_000: {
君は敵を倒すのが随分好きなようだな。
何か欲求不満なことでもあるのか？
}
//dv}//v
}//d
//無線していない場合 h //e
resource PC_発狂＿無線してない {
//vox t:vc266701 {
大佐_000: {
ん？君は今までほとんど連絡して
来なかったじゃないか。こういう時だけ
人に頼るのか？まったく……。
}
//dv}//v
}//d

//ツーハンを朗読 h //e
resource PC_発狂＿ツーハン {
//vox t:vc266711 {
大佐_000: {
連続通信機ドラマ
「アイデアスパイ２．５」
第１回
}
大佐_001: {
ニューヨーク。人々の欲望渦巻くこの
大都会では、今日も誰かが何かを買い、
売り、そして捨て、平和に暮らしている。
}
大佐_002: {
だが、そんな平和の裏側で、粗悪な
商品を売りつけ私腹を肥やす悪の組織、
『＃｛Ｊ．Ｅ、ジャンカー・エクスペンシブ｝＃』社が暗躍していた。
}
大佐_003: {
汚れなき市民を巧みにあざむき、
ガラクタを高値で売りつける
『Ｊ．Ｅ』の野望を＃ー
}
大佐_004: {
打ち砕くべく
ＦＢＩは極秘に対抗チームを結成。
}
大佐_005: {
悪の通信販売会社『Ｊ．Ｅ』から
市民を守るべく誕生した極秘スパイ、
その名も『２．５（ツー・ハン）』
}
//dv}//v
}//d
//電波系のことを言う。 h  //e
resource PC_発狂＿電波 {
//vox t:vc266721 {
大佐_000: {
巻き舌宇宙で有名な紫ミミズの剥製は
ハラキリ岩の上で音叉が生まばたきする
といいらしいぞ。要ハサミだ。６１！
}
//dv}//v
}//d

//今までにしたエロ行為を突っ込まれる h //e
resource PC_発狂＿エロ行為ツッコミ {
//vox t:vc266731 {
大佐_000: {
やれやれ。女子便所でおかしなことを
していた奴がここまで辿り着くとは。
世も末だ……。
}
//dv}//v
}//d

//らりるれろ！らりるれろ！と叫ぶ。 h //e
resource PC_発狂＿らりるれろ {
//vox t:vc266741 {
大佐_000: {
らりるれろ！
らりるれろ！！
らりるれろ！！！
}
//dv}//v
}//d


//飯を食っている h //e
resource PC_発狂＿食事中 {
//vox t:vc266751 {
大佐_000: {
むしゃむしゃ……。
ん？雷電か？今、食事中だ。
あとにしてくれ……むしゃむしゃ……。
}
//dv}//v
}//d

//前世の話をする。 h //e
resource PC_発狂＿前世 {
//vox t:vc266761 {
大佐_000: {
私は前世でアメリカシロヒトリ
だったんだ。あの頃は楽しかった……。
君の前世は何だ？
}
//dv}//v
}//d

//大佐が出撃するという h //e
resource PC_発狂＿大佐出撃 {
//vox t:vc266771 {
大佐_000: {
私の我慢にも限度がある。
もう君には任せておけん。
私が出撃する！君はもう帰れ！！
}
//dv}//v
}//d

//借金の話をする。 h //e
resource PC_発狂＿借金 {
//vox t:vc266781 {
大佐_000: {
実は私はかなり金に困っているんだ。
離婚した元妻への慰謝料とかな……。
}
大佐_001: {
この前、食事代を君に払わせて
しまったのも仕方のないこと
だったんだよ。申し訳ない……。
}
//dv}//v
}//d

