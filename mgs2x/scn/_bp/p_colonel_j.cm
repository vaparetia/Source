}
//dv}//v
}//d

//ゴーストバベルの台詞をしゃべる３ h //e
resource PC_発狂＿ばべる３ {
//vox t:vc266601 {
大佐_000: {
発電所を爆破するんだ。
発電所を爆破するには４つの
