// ------------------------------------
// 敵兵音声
// ------------------------------------
resource ghq_area_alert_voice {
	w25d:
		$t{
			// PLAREA0
			t:vc049009	// 指揮官「了解！敵を殲滅せよ！」
			-1
		}
}

resource ghq_caution_voice {
	w25d:
		$t{
			// PLAREA0
			t:vc040601,	// 指揮官　　「了解！僧院警戒を強化せよ！」
			-2,
			t:vc040614,	// 指揮官　　「ＫＬ連絡橋で異常発生。至急確認へ向かえ」
			-3,
			t:vc040613,	// 指揮官　　「ＫＬ連絡橋で異常発生。至急確認へ向かえ」
			-1
		}
}


// ローカル変数
// ドア設定用ステージ内ローカル変数(a_mode.hよりも先に定義する)
dim $$b:ドアフラグ[ 2 ]
dim $$s:ドアモデル名[ 2 ]

command	配列セット $$b:ドアフラグ[0] {
	0,	0
}
command	配列セット $$s:ドアモデル名[0] {
	0,	0
}



