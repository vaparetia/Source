// ------------------------------------
// 各gclで必要なdefine
// ------------------------------------
// 共通プロック切り分け用
#define		STAGE_VR		1		// モード
#define		STAGE_WP24A		1		// ステージ名
#define		VR_WEAPON		1		// VRステージの呼び分け

#define		STAGE_START		1		// ステージ開始直後処理
#define		CUSTOM_TRG_SPEED	1	// 前作スネークのスピードカスタム機能を停止

// ------------------------------------
// 各種スイッチ用define
// ------------------------------------
// デバッグ関係
#ifdef	d:FIX_MODE
	#define		DEBUG_CHARA		0		// デバッグキャラ全体(FIX時は0)
#else
	#define		DEBUG_CHARA		0		// デバッグキャラ全体
#endif
#define		CHARA_CAMERA	0		// キャラ追従カメラ
#define		TARGET_CHARA	敵兵:01	// キャラ追従カメラのターゲット
#define		SCREENSHOT		0		// スクリーンショット
#define		USB_KEY			0		// USBキーボード


// ------------------------------------
// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME			ws24a
#define		KMS_NAME			ws24a
#define		TONBO_KMS_NAME		ws24a_tonbo
#define		LINE_KMS_NAME		ws24a_line

// キャラクター関係
#define		PLAYER		ライデン


// ------------------------------------
// ローカル変数
// ------------------------------------


// ------------------------------------
// 的ルート番号
// ------------------------------------
enum M_R {
	//	トラップ１面用
//	共通ルート０ = 0,	// 欠番
	ライデンルート１ = 1,
	ライデンルート２, ライデンルート３, ライデンルート４, ライデンルート５, ライデンルート６,
	ライデンルート７, ライデンルート８, ライデンルート９, ライデンルート１０,

	スネークルート１１, スネークルート１２, スネークルート１３, スネークルート１４, スネークルート１５,
	スネークルート１６, スネークルート１７, スネークルート１８, スネークルート１９, スネークルート２０,

	前作スネークルート２１, 前作スネークルート２２, 前作スネークルート２３, 前作スネークルート２４, 前作スネークルート２５,
	前作スネークルート２６, 前作スネークルート２７, 前作スネークルート２８, 前作スネークルート２９, 前作スネークルート３０,
}


// ------------------------------------
// include
// ------------------------------------

#include "rai_wp24a.mh"		// 強制モーションリスト

#include "stdch.h"			// 常駐キャラ
//#include "enevoice.h"
#include "a_stdproc.h"		// アナザーミッション設定ファイル
#include "sload.h"			// ロード関数
#include "sound.h"
#include "item_info.h"
#include "a_item_info.h"
//#include "ene_item.h"
//#include "jump.h"			// 自動ジャンプ関係
#include "vr_common.h"		// ＶＲステージ共通で使用するプロック

#if d:USB_KEY
	#include "usbkbd.h"
#endif



// ------------------------------------
// マップ設定
// ------------------------------------
chara マップ 武器訓練トラップ４面 -k d:KMS_NAME -h d:HZX_NAME,0 -l $s:ＶＲライトファイル名

command マップ設定 武器訓練トラップ４面 -set {
	// ローカルの初期化
	// ------------------------------------
	@ローカル変数初期化		// ローカルで使用する変数で初期化をする場合はここで

	// ＶＲで必要な基本プロックのセット(vr_common.hで定義)
	// サウンドの基本パック、ＶＲの基本システム、プレイヤー、ゴール等を設定します
	// ※このプロックを使用する時は「ＶＲクリア時処理」というプロックが必要です
	// ------------------------------------
	@ＶＲ共通プロックセット sna_wp24a rai_wp24a d:VR_GOAL_TARGET 0 0 0

	// ＶＲウィンドウの設定
	// ------------------------------------
	@武器訓練トラップ４面ＶＲウィンドウ設定

	// クリア時に呼ばれるものの設定
	// ------------------------------------
	@ＶＲクリア設定 p:load_wp25a p:load_wp24a

	// ステージに引かれるライン
	// ------------------------------------
	@ＶＲアウトライン d:KMS_NAME d:TONBO_KMS_NAME d:LINE_KMS_NAME

	// 設定値を変更する場合は以下のプロック内で設定
	// ------------------------------------
	@設定値変更				// 敵兵や的のパラメータをステージ限定で変える時はここで
	@プラグイン設定			// プレイヤーのプラグインがいる時はここで

	// 的関係の設定
	// ------------------------------------
	@ＶＲ標的トラップ４面設定				// ＶＲシステム起動後に呼ぶ

	// ＢＧＭの設定(プレイヤー→敵兵→BGMの順で呼ぶ。的の場合は関係ないがとりあえずここに)
	// ------------------------------------
	@ＢＧＭ設定

	// アイテムの設定
	// ------------------------------------
	@アイテム設定

	// 光源、オブジェクト、カメラ関連の設定
	// ------------------------------------
	@水溜りエフェクト設置
	@ＶＲフォグ設定 d:VR_FOG:朝Ｎ 35000 -1000 30000 d:VR_FOG:夜Ｎ 25000
	@カメラセット						// chara カメラとベースのカメラを設定
	@武器訓練トラップ４面カメラ設定	// ステージ固有のカメラ設定がいる時はこのプロックで
	@ＶＲキャラ用ライト設置				// vr_common.hに定義。必ず最後に設定
#if d:DEBUG_CHARA
//	@デバッグキャラセット
#endif

}

//初期マップの表示
command マップ表示 -show 武器訓練トラップ４面


//###################################################################################
//									各proc設定
//###################################################################################



//###################################################################################
//									全マップ共通
//###################################################################################
	// ------------------------------------
	// 全マップ共通
	// ------------------------------------
	//------------------------------------------------------------
	// ＶＲウィンドウの設定と表示
	//------------------------------------------------------------
	proc 武器訓練トラップ４面ＶＲウィンドウ設定 {
		#if d:DEBUG_PRINT
			print 'vr_window_set'
		#endif

		@ＶＲウィンドウ設定	[VRMSG_J:VRM_WPN_C4C_wp24a] [VRMSG_E:VRM_WPN_C4C_wp24a] [VRMSG_G:VRM_WPN_C4C_wp24a] \	// 日、英、独
							[VRMSG_F:VRM_WPN_C4C_wp24a] [VRMSG_I:VRM_WPN_C4C_wp24a] [VRMSG_S:VRM_WPN_C4C_wp24a] \	// 仏、伊、西
							[VRMSG_K:VRM_WPN_C4C_wp24a] \															// 韓
							p:ＶＲステージ開始時処理								// 終了プロック


		// ＶＲウィンドウを表示する
		mesg ＶＲウィンドウ ＶＲウィンドウ君 開く

		// スタート時とクリア時に使用するカットインカメラ
		chara カメラ カットインカメラ		-c 0 -l 0 -p 0

		// スタート時のカメラ(必要な場合)
		chara カメラ設定 カットインカメラ \
			-c 1 \	
			-p 0,6600,2350 -t 0,0,0 \
			-r 800,2048,0 -f 7000 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1
	}

	//------------------------------------------------------------
	// ステージ開始時処理
	//------------------------------------------------------------
	proc ＶＲステージ開始時処理 {
		#if d:DEBUG_PRINT
			print 'game_start!!!!!'
		#endif

		// プレイヤーやパッドの制御等を行う a_stdproc.hで定義
		@全ミッション共通ステージ開始時処理

		// カメラワークスタート(必要な場合)
		// 全体図
		chara カメラ設定 カットインカメラ \
			-c 1 \	
			-p 0,20000,20000 -t 0,12350,10750 \
			-r 450,2048,0 -f 12000 \
			-a 200 \
			-i 4 4 d:START_CAMERA_CHANGE_TIME d:START_CAMERA_CHANGE_TIME \
			-s 1

		chara delay ディレイ \
			-time d:START_CAMERA_CHANGE_TIME \
			-exec {
				chara カメラ設定 カットインカメラ -s -1
			}
	}

	// ------------------------------------
	// クリア時の処理
	// ------------------------------------
	proc ＶＲクリア時処理 {
		#if d:DEBUG_PRINT
			print 'clear'
		#endif

//		@トラップ４面破壊数カウント変数初期化

		// 強制モーションを発動
		@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_1 0

		// クリア時にカメラアングルを変える
		chara カメラ設定 クリア時カメラ \
			-c 1 \
			-p -250,1000,4000 -t -250,1250,0 \
			-r 4055,2048,0 -f 4000 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}

	//------------------------------------------------------------
	// ステージ開始直後処理
	//------------------------------------------------------------
	proc ゲーム開始直後処理 {
		// 初期配置標的の起動（command ＶＲステージスタート の起動直後に行う必要がある）
		@ＶＲ初期配置標的トラップ４面設定
	}


	// ------------------------------------
	// パラメータ系の変更
	// ------------------------------------
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT
			print 'localvar_init'
		#endif

		//	的管理用各種フラグを初期化する
		$$b:標的セット数 = 0;
		$$i:標的フラグ = 0;

//		$$i:標的フラグＡ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NO_GHOST );
//		$$i:標的フラグＢ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST );
//		$$i:標的フラグＣ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    );
		$$i:標的フラグＤ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST                  | d:VR_TRG_WAIT );
		$$i:標的フラグＥ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST | d:VR_TRG_WAIT );
//		$$i:標的フラグＦ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    | d:VR_TRG_WAIT );
//		$$i:標的フラグＧ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST                  | d:VR_TRG_WAIT | d:VR_TRG_CIRCLE );
//		$$i:標的フラグＨ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST | d:VR_TRG_WAIT | d:VR_TRG_CIRCLE );
//		$$i:標的フラグＩ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    | d:VR_TRG_WAIT | d:VR_TRG_CIRCLE );
//		$$i:標的フラグＪ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST                  | d:VR_TRG_WAIT | d:VR_TRG_NO_APPEAR_EF );
//		$$i:標的フラグＫ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST | d:VR_TRG_WAIT | d:VR_TRG_NO_APPEAR_EF );
//		$$i:標的フラグＬ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    | d:VR_TRG_WAIT | d:VR_TRG_NO_APPEAR_EF );
	}

	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT
			print 'status_set'
		#endif

		// 初期装備の設定
		$w:武器弾数Ｒ[ d:武器:クレイモア ] = 0
		$w:武器弾数Ｒ[ d:武器:Ｃ４ ] = 0
	}

	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif

	}


//###################################################################################
//									 的兵
//###################################################################################

	// ------------------------------------
	// トラップ４面
	// ------------------------------------
	// 敵兵や的の処理
	// ------------------------------------
	proc ＶＲ標的トラップ４面設定 {

		// ライデン or タキシードスネークを選択
		if ( ($s:選択プレイヤー == ライデン) ||  ($s:選択プレイヤー == タキシードスネーク) ) {

			command foreach -argc 4 -repeat 10 \
			-data { \
				// 的名,     フラグ,             ルート,            スタートノード
				// act 1 ----------
				{ 移動的:01, $$i:標的フラグＥ, d:M_R:ライデンルート１,   0 }\
				{ 移動的:02, $$i:標的フラグＥ, d:M_R:ライデンルート２,   0 }\
				{ 移動的:03, $$i:標的フラグＥ, d:M_R:ライデンルート３,   0 }\
				// act 2 ----------
				{ 移動的:04, $$i:標的フラグＤ, d:M_R:ライデンルート４,   0 }\
				{ 移動的:05, $$i:標的フラグＤ, d:M_R:ライデンルート５,   0 }\
				{ 移動的:06, $$i:標的フラグＤ, d:M_R:ライデンルート６,   0 }\
				{ 移動的:07, $$i:標的フラグＤ, d:M_R:ライデンルート７,   0 }\
				{ 移動的:08, $$i:標的フラグＤ, d:M_R:ライデンルート８,   0 }\
				{ 移動的:09, $$i:標的フラグＤ, d:M_R:ライデンルート９,   0 }\
				{ 移動的:10, $$i:標的フラグＤ, d:M_R:ライデンルート１０, 0 }\
			} \
			-exec { \
				if( $s:選択プレイヤー == タキシードスネーク ) {
					$$b:標的セット数 = $$b:標的セット数 + 1;
					if( $$b:標的セット数 % 2 ) {
						$$i:標的フラグ = ( $2 | d:VR_TRG_HIDESTART );
					} else {
						$$i:標的フラグ = ( $2 | d:VR_TRG_VISIBLESTART );
					}
				} else {
					$$i:標的フラグ = $2;
				}

				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグ \
					-route $3 $4 \
					-speed 20
			}

		// スネーク or プリスキンを選択
		} else if ( ($s:選択プレイヤー == スネーク) || ($s:選択プレイヤー == プリスキン) ) {

			command foreach -argc 4 -repeat 10 \
			-data { \
				// 的名,     フラグ,             ルート,      スタートノード
				// act 1 ----------
				{ 移動的:01, $$i:標的フラグＥ, d:M_R:スネークルート１１, 0 }\
				{ 移動的:02, $$i:標的フラグＥ, d:M_R:スネークルート１２, 0 }\
				{ 移動的:03, $$i:標的フラグＥ, d:M_R:スネークルート１３, 0 }\
				// act 2 ----------
				{ 移動的:04, $$i:標的フラグＤ, d:M_R:スネークルート１４, 0 }\
				{ 移動的:05, $$i:標的フラグＤ, d:M_R:スネークルート１５, 0 }\
				{ 移動的:06, $$i:標的フラグＤ, d:M_R:スネークルート１６, 1 }\
				{ 移動的:07, $$i:標的フラグＤ, d:M_R:スネークルート１７, 0 }\
				{ 移動的:08, $$i:標的フラグＤ, d:M_R:スネークルート１８, 0 }\
				{ 移動的:09, $$i:標的フラグＤ, d:M_R:スネークルート１９, 1 }\
				{ 移動的:10, $$i:標的フラグＤ, d:M_R:スネークルート２０, 0 }\
			} \
			-exec { \
				if( $s:選択プレイヤー == プリスキン ) {
					$$b:標的セット数 = $$b:標的セット数 + 1;
					if( $$b:標的セット数 % 2 ) {
						$$i:標的フラグ = ( $2 | d:VR_TRG_HIDESTART );
					} else {
						$$i:標的フラグ = ( $2 | d:VR_TRG_VISIBLESTART );
					}
				} else {
					$$i:標的フラグ = $2;
				}

				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグ \
					-route $3 $4 \
					-speed 25
			}

		//	前作スネークを選択
		} else if ( $s:選択プレイヤー == 前作スネーク ) {

			command foreach -argc 5 -repeat 10 \
			-data { \
				// 的名,     フラグ,             ルート,      スタートノード, スピード
				// act 1 ----------
				{ 移動的:01, $$i:標的フラグＥ, d:M_R:前作スネークルート２１, 0, 50 }\
				{ 移動的:02, $$i:標的フラグＥ, d:M_R:前作スネークルート２２, 0, 50 }\
				{ 移動的:03, $$i:標的フラグＥ, d:M_R:前作スネークルート２３, 0, 50 }\
				// act 2 ----------
				{ 移動的:04, $$i:標的フラグＤ, d:M_R:前作スネークルート２４, 0, 25 }\
				{ 移動的:05, $$i:標的フラグＤ, d:M_R:前作スネークルート２５, 0, 25 }\
				{ 移動的:06, $$i:標的フラグＤ, d:M_R:前作スネークルート２６, 0, 25 }\
				{ 移動的:07, $$i:標的フラグＤ, d:M_R:前作スネークルート２７, 0, 50 }\
				{ 移動的:08, $$i:標的フラグＤ, d:M_R:前作スネークルート２８, 1, 50 }\
				{ 移動的:09, $$i:標的フラグＤ, d:M_R:前作スネークルート２９, 1, 50 }\
				{ 移動的:10, $$i:標的フラグＤ, d:M_R:前作スネークルート３０, 3, 50 }\
			} \
			-exec { \
				// 前作スネークは順番を逆にする
				$$b:標的セット数 = $$b:標的セット数 + 1;
				if( $$b:標的セット数 % 2 ) {
					$$i:標的フラグ = ( $2 | d:VR_TRG_VISIBLESTART );
				} else {
					$$i:標的フラグ = ( $2 | d:VR_TRG_HIDESTART );
				}

				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグ \
					-route $3 $4 \
					-speed $5
			}

		}

	}

	proc ＶＲ初期配置標的トラップ４面設定 {
		// 共通標的
		mesg ＶＲ的共通 移動的:01 移動開始
		mesg ＶＲ的共通 移動的:02 移動開始
		mesg ＶＲ的共通 移動的:03 移動開始
		mesg ＶＲ的共通 移動的:04 移動開始
		mesg ＶＲ的共通 移動的:05 移動開始
		mesg ＶＲ的共通 移動的:06 移動開始
		mesg ＶＲ的共通 移動的:07 移動開始
		mesg ＶＲ的共通 移動的:08 移動開始
		mesg ＶＲ的共通 移動的:09 移動開始
		mesg ＶＲ的共通 移動的:10 移動開始
	}


//###################################################################################
//									 ＢＧＭ
//###################################################################################

	// ------------------------------------
	// ＢＧＭの設定
	// ------------------------------------
	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT
			print 'bgm_set'
		#endif

		chara ＢＧＭマネージャー ＢＧＭマネ
	}


//###################################################################################
//									 アイテム
//###################################################################################

	// ------------------------------------
	// アイテムの設定
	// ------------------------------------
	// 再発生が必要な時は以下のプロックの中を記述する
	// ------------------------------------
	proc アイテム取得時番号設定 $:ボックス名 {
		#if d:DEBUG_PRINT
			print 'item_no_set'
		#endif
	}
	// アイテムの設置
	// ------------------------------------
	proc アイテム設定 {
		#if d:DEBUG_PRINT
			print 'item_set'
		#endif

		@A_Ｃ４_初期設置 Ｃ４:01 -1500 0   500 0 24
//		@A_Ｃ４_初期設置 Ｃ４:02  7000 0 -6000 0 18

		@A_クレイモア_初期設置 クレイモア:01  1500 0   500 0 24
//		@A_クレイモア_初期設置 クレイモア:02 -4000 0 -8000 0 18


	}



//###################################################################################
//									 エフェクト
//###################################################################################

	// ------------------------------------
	// 光源関係
	// ------------------------------------
	// フォグ
	// ------------------------------------
	// キャラ用光源(マップの設置が終わってから設定することで、キャラだけに光を当てる)
	// ------------------------------------
	// ------------------------------------
	// 水溜りエフェクト
	// ------------------------------------
	proc 水溜りエフェクト設置 {
		#if d:DEBUG_PRINT
			print 'ripple_set'
		#endif

		command foreach -argc 2 -repeat 47 \
			-data { \
					{ -5500, -10500 } \
					{ -4500, -10500 } \
					{ -3500, -10500 } \
					{ -2500, -10500 } \
					{ -1500, -10500 } \
					{ -5500,  -9500 } \
					{ -1500,  -9500 } \
					{  2500,  -9500 } \
					{  3500,  -9500 } \
					{  4500,  -9500 } \
					{ -5500,  -8500 } \
					{ -4500,  -8500 } \
					{ -3500,  -8500 } \
					{ -1500,  -8500 } \
					{  -500,  -8500 } \
					{   500,  -8500 } \
					{  1500,  -8500 } \
					{  2500,  -8500 } \
					{  4500,  -8500 } \
					{  5500,  -8500 } \
					{  6500,  -8500 } \
					{ -3500,  -7500 } \
					{ -2500,  -7500 } \
					{ -1500,  -7500 } \
					{  2500,  -7500 } \
					{  6500,  -7500 } \
					{ -1500,  -6500 } \
					{  2500,  -6500 } \
					{  3500,  -6500 } \
					{  4500,  -6500 } \
					{  5500,  -6500 } \
					{  6500,  -6500 } \
					{ -1500,  -5500 } \
					{  2500,  -5500 } \
					{ -1500,  -4500 } \
					{  2500,  -4500 } \
					{ -1500,  -3500 } \
					{  -500,  -3500 } \
					{   500,  -3500 } \
					{  1500,  -3500 } \
					{  2500,  -3500 } \
					{ -1500,  -2500 } \
					{  1500,  -2500 } \
					{ -1500,  -1500 } \
					{  -500,  -1500 } \
					{   500,  -1500 } \
					{  1500,  -1500 } \
				} \
				-exec { \
					chara ＶＲ床パネル ＶＲ床パネル -pos $1 0 $2
				}
	}



//###################################################################################
//									 カメラ
//###################################################################################
	// ------------------------------------
	// カメラ関係の設定
	// ------------------------------------
	// ステージカメラ設定
	// ------------------------------------
	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'chara_camera & stage_camera_set'
		#endif

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0
		chara カメラ メインカメラ		-c 0 -l 2 -p 40
		chara カメラ クリア時カメラ		-c 0 -l 0 -p 10

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 500,2048,0 \
			-f 9000 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}
	// ステージ固有のカメラ設定
	// ------------------------------------
	proc 武器訓練トラップ４面カメラ設定 {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif
	}



//###################################################################################
//									 その他
//###################################################################################


// -----------------------------------------------------------------------------------
// 以下デバッグ専用proc
// -----------------------------------------------------------------------------------
// デバッグキャラ
// ------------------------------------
proc デバッグキャラセット {
	#if d:DEBUG_PRINT
		print 'debug_chara_set'
	#endif

	#if d:CHARA_CAMERA
		chara キャラカメラ 敵兵カメラ \
			-c d:TARGET_CHARA \
			-s -920,610,200 \
			-r -200,1024,0
	#endif

	#if d:SCREENSHOT
		chara スクリーンショット shot
	#endif

	#if d:USB_KEY
		chara USBキーボード実行 test \
			-e d:KBD_ESC {
				mesg プレイヤー d:PLAYER position -5500, -13000, -500
			} \
	#endif
}

