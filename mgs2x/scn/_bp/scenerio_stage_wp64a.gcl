	#include "usbkbd.h"
#endif



// ------------------------------------
// マップ設定
// ------------------------------------
chara マップ 武器訓練ニキータ４面 -k d:KMS_NAME -h d:HZX_NAME,0 -l $s:ＶＲライトファイル名

command マップ設定 武器訓練ニキータ４面 -set {
	// ローカルの初期化
	// ------------------------------------
	@ローカル変数初期化		// ローカルで使用する変数で初期化をする場合はここで

	// ＶＲで必要な基本プロックのセット(vr_common.hで定義)
	// サウンドの基本パック、ＶＲの基本システム、プレイヤー、ゴール等を設定します
	// ※このプロックを使用する時は「ＶＲクリア時処理」というプロックが必要です
	// ------------------------------------
	@ＶＲ共通プロックセット sna_wp64a rai_wp64a d:VR_GOAL_TARGET -2000 0 21000

	// ＶＲウィンドウの設定
	// ------------------------------------
	@武器訓練ニキータ４面ＶＲウィンドウ設定

	// クリア時に呼ばれるものの設定
	// ------------------------------------
	@ＶＲクリア設定 p:load_wp65a p:load_wp64a

	// ステージに引かれるライン
	// ------------------------------------
	@ＶＲアウトライン d:KMS_NAME d:TONBO_KMS_NAME d:LINE_KMS_NAME

	// 設定値を変更する場合は以下のプロック内で設定
	// ------------------------------------
	@設定値変更				// 敵兵や的のパラメータをステージ限定で変える時はここで
	@プラグイン設定			// プレイヤーのプラグインがいる時はここで

	// 的関係の設定
	// ------------------------------------
	@ＶＲ標的ニキータ４面設定				// ＶＲシステム起動後に呼ぶ
//	@ＶＲ対ニキータ用ガンカメラ設置


	// ＢＧＭの設定(プレイヤー→敵兵→BGMの順で呼ぶ。的の場合は関係ないがとりあえずここに)
	// ------------------------------------
	@ＢＧＭ設定

	// アイテムの設定
	// ------------------------------------
	@アイテム設定

	// 光源、オブジェクト、カメラ関連の設定
	// ------------------------------------
	@ＶＲフォグ設定 d:VR_FOG:朝Ｎ 60000 -7500 70000 -7000 55000
	@カメラセット						// chara カメラとベースのカメラを設定
	@武器訓練ニキータ４面カメラ設定		// ステージ固有のカメラ設定がいる時はこのプロックで
	@ＶＲキャラ用ライト設置				// vr_common.hに定義。必ず最後に設定
#if d:DEBUG_CHARA
//	@デバッグキャラセット
#endif

}

//初期マップの表示
command マップ表示 -show 武器訓練ニキータ４面


//###################################################################################
//									各proc設定
//###################################################################################



//###################################################################################
//									全マップ共通
//###################################################################################
	// ------------------------------------
	// 全マップ共通
	// ------------------------------------
	//------------------------------------------------------------
	// ＶＲウィンドウの設定と表示
	//------------------------------------------------------------
	proc 武器訓練ニキータ４面ＶＲウィンドウ設定 {
		#if d:DEBUG_PRINT
			print 'vr_window_set'
		#endif

		@ＶＲウィンドウ設定	[VRMSG_J:VRM_WPN_NKT_wp64a] [VRMSG_E:VRM_WPN_NKT_wp64a] [VRMSG_G:VRM_WPN_NKT_wp64a] \	// 日、英、独
							[VRMSG_F:VRM_WPN_NKT_wp64a] [VRMSG_I:VRM_WPN_NKT_wp64a] [VRMSG_S:VRM_WPN_NKT_wp64a] \	// 仏、伊、西
							[VRMSG_K:VRM_WPN_NKT_wp64a] \															// 韓
							p:ＶＲステージ開始時処理								// 終了プロック


		// ＶＲウィンドウを表示する
		mesg ＶＲウィンドウ ＶＲウィンドウ君 開く

		// スタート時とクリア時に使用するカットインカメラ
		chara カメラ カットインカメラ		-c 0 -l 0 -p 0

		// スタート時のカメラ(必要な場合)
		chara カメラ設定 カットインカメラ \
			-c 1 \	
			-p -2000,4500,26350 -t -2000,0,21000 \
			-r 450,2048,0 -f 7000 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1
	}

	//------------------------------------------------------------
	// ステージ開始時処理
	//------------------------------------------------------------
	proc ＶＲステージ開始時処理 {
		#if d:DEBUG_PRINT
			print 'game_start!!!!!'
		#endif

		// プレイヤーやパッドの制御等を行う a_stdproc.hで定義
		@全ミッション共通ステージ開始時処理

		// カメラワークスタート(必要な場合)
		// 全体図
		chara カメラ設定 カットインカメラ \
			-c 1 \	
			-p -1000,28500,40000 -t -1000,24000,34500 \
			-r 450,2048,0 -f 8000 \
			-a 200 \
			-i 4 4 d:START_CAMERA_CHANGE_TIME d:START_CAMERA_CHANGE_TIME \
			-s 1

		chara delay ディレイ \
			-time d:START_CAMERA_CHANGE_TIME \
			-exec {
				chara カメラ設定 カットインカメラ -s -1
			}
	}

	// ------------------------------------
	// クリア時の処理
	// ------------------------------------
	proc ＶＲクリア時処理 {
		#if d:DEBUG_PRINT
			print 'clear'
		#endif

		// 強制モーションを発動
		@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_1 3948

		// クリア時にカメラアングルを変える
		chara カメラ設定 クリア時カメラ \
			-c 1 \
			-p -3500,500,24850 -t -2500,1250,21000 \
			-r -120,1900,0 -f 4000 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}

	//------------------------------------------------------------
	// ステージ開始直後処理
	//------------------------------------------------------------
	proc ゲーム開始直後処理 {
		// 初期配置標的の起動（command ＶＲステージスタート の起動直後に行う必要がある）
		@ＶＲ初期配置標的ニキータ４面設定
	}


	// ------------------------------------
	// パラメータ系の変更
	// ------------------------------------
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT
			print 'localvar_init'
		#endif

		//	的管理用各種フラグを初期化する
		$$b:標的セット数 = 0;
		$$i:標的フラグ = 0;

//		$$i:標的フラグＡ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NO_GHOST );
//		$$i:標的フラグＢ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST );
//		$$i:標的フラグＣ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    );
		$$i:標的フラグＤ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST                  | d:VR_TRG_WAIT );
//		$$i:標的フラグＥ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST | d:VR_TRG_WAIT );
		$$i:標的フラグＦ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    | d:VR_TRG_WAIT );
//		$$i:標的フラグＧ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST                  | d:VR_TRG_WAIT | d:VR_TRG_CIRCLE );
//		$$i:標的フラグＨ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST | d:VR_TRG_WAIT | d:VR_TRG_CIRCLE );
//		$$i:標的フラグＩ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    | d:VR_TRG_WAIT | d:VR_TRG_CIRCLE );
//		$$i:標的フラグＪ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST                  | d:VR_TRG_WAIT | d:VR_TRG_NO_APPEAR_EF );
//		$$i:標的フラグＫ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST | d:VR_TRG_WAIT | d:VR_TRG_NO_APPEAR_EF );
		$$i:標的フラグＬ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    | d:VR_TRG_WAIT | d:VR_TRG_NO_APPEAR_EF );
	}

	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT
			print 'status_set'
		#endif

		// 初期装備の設定
		$w:武器弾数Ｒ[ d:武器:ニキータ ] = 12
		$w:武器 = d:武器:ニキータ

		command ニキータタイマー設定 -time (60*40)

		// ニキータ防止
		command ミサイル移動範囲設定 -110000 -110000 -110000 110000 110000 110000
	}

	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif


	}



//###################################################################################
//									 的兵
//###################################################################################

	// ------------------------------------
	// ニキータ４面
	// ------------------------------------

	// 破壊時処理
	// ------------------------------------
	proc ＶＲ標的破壊ニキータ４面処理 {

		// ライデンを選択
		if ( $s:選択プレイヤー == ライデン ) {

			// 追加仕様
			if ( $1 == 移動的:01 ){
				command foreach -argc 1 -repeat 3 \
				-data { \
					// 的名
					{ 移動的:02 }{ 移動的:03 }{ 移動的:04 }\
				} \
				-exec { \
					mesg ＶＲ的共通 $1 消滅
				}
			}

		// スネークを選択
		} else if ( $s:選択プレイヤー == スネーク ) {

			if ( $1 == 移動的:01 ){
				command foreach -argc 1 -repeat 10 \
				-data { \
					// 的名
					{ 移動的:02 }{ 移動的:03 }{ 移動的:04 }{ 移動的:05 }{ 移動的:06 }\
					{ 移動的:07 }{ 移動的:08 }{ 移動的:09 }{ 移動的:10 }{ 移動的:11 }\
				} \
				-exec { \
					mesg ＶＲ的共通 $1 消滅
				}
			}

		// プリスキンを選択
		} else if ( $s:選択プレイヤー == プリスキン ) {

			if ( $1 == 移動的:01 ){
				command foreach -argc 1 -repeat 14 \
				-data { \
					// 的名
					{ 移動的:02 }{ 移動的:03 }{ 移動的:04 }{ 移動的:05 }{ 移動的:06 }\
					{ 移動的:07 }{ 移動的:08 }{ 移動的:09 }{ 移動的:10 }{ 移動的:11 }\
					{ 移動的:12 }{ 移動的:13 }{ 移動的:14 }{ 移動的:15 }\
				} \
				-exec { \
					mesg ＶＲ的共通 $1 消滅
				}
			}

		// タキシードスネークを選択
		} else if ( $s:選択プレイヤー == タキシードスネーク ) {

			if ( $1 == 移動的:01 ){
				command foreach -argc 1 -repeat 12 \
				-data { \
					// 的名
					{ 移動的:02 }{ 移動的:03 }{ 移動的:04 }{ 移動的:05 }{ 移動的:06 }\
					{ 移動的:07 }{ 移動的:08 }{ 移動的:09 }{ 移動的:10 }{ 移動的:11 }\
					{ 移動的:12 }{ 移動的:13 }\
				} \
				-exec { \
					mesg ＶＲ的共通 $1 消滅
				}
			}

		// 前作スネークを選択
		} else if ( $s:選択プレイヤー == 前作スネーク ) {

			if ( $1 == 移動的:01 ){
				command foreach -argc 1 -repeat 18 \
				-data { \
					// 的名
					{ 移動的:02 }{ 移動的:03 }{ 移動的:04 }{ 移動的:05 }{ 移動的:06 }\
					{ 移動的:07 }{ 移動的:08 }{ 移動的:09 }{ 移動的:10 }{ 移動的:11 }\
					{ 移動的:12 }{ 移動的:13 }{ 移動的:14 }{ 移動的:15 }{ 移動的:16 }\
					{ 移動的:17 }{ 移動的:18 }{ 移動的:19 }\
				} \
				-exec { \
					mesg ＶＲ的共通 $1 消滅
				}
			}
		}

	}

	// 敵兵や的の処理
	// ------------------------------------
	proc ＶＲ標的ニキータ４面設定 {

		// 標的は全キャラ共通です
		// act 1 ----------
		chara ＶＲ移動的 移動的:01 \
			-flag $$i:標的フラグＤ \
			-route d:M_R:共通ルート１ \
			-c ＶＲ標的破壊ニキータ４面処理

		// 以下はＮＧ的の設定
		// ライデンを選択
		if ( $s:選択プレイヤー == ライデン ) {

			// 追加仕様
			command foreach -argc 2 -repeat 3 \
			-data { \
				// 的名,     ルート
				// act 2 ----------
				{ 移動的:02, d:M_R:ライデンルート５６ }\
				{ 移動的:03, d:M_R:ライデンルート５７ }\
				{ 移動的:04, d:M_R:ライデンルート５８ }\
			} \
			-exec { \
				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグＬ \
					-route $2
			}
		// スネークを選択
		} else if ( $s:選択プレイヤー == スネーク ) {

			command foreach -argc 2 -repeat 10 \
			-data { \
				// 的名,     ルート
				// act 2 ----------
				{ 移動的:02, d:M_R:スネークルート２ }\
				{ 移動的:03, d:M_R:スネークルート３ }\
				{ 移動的:04, d:M_R:スネークルート４ }\
				{ 移動的:05, d:M_R:スネークルート５ }\
				{ 移動的:06, d:M_R:スネークルート６ }\
				{ 移動的:07, d:M_R:スネークルート７ }\
				{ 移動的:08, d:M_R:スネークルート８ }\
				{ 移動的:09, d:M_R:スネークルート９ }\
				{ 移動的:10, d:M_R:スネークルート１０ }\
				{ 移動的:11, d:M_R:スネークルート１１ }\
			} \
			-exec { \
				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグＬ \
					-route $2 \
					-speed 50
			}

		// プリスキンを選択
		} else if ( $s:選択プレイヤー == プリスキン ) {

			command foreach -argc 2 -repeat 14 \
			-data { \
				// 的名,     ルート
				// act 2 ----------
				{ 移動的:02, d:M_R:プリスキンルート１２ }\
				{ 移動的:03, d:M_R:プリスキンルート１３ }\
				{ 移動的:04, d:M_R:プリスキンルート１４ }\
				{ 移動的:05, d:M_R:プリスキンルート１５ }\
				{ 移動的:06, d:M_R:プリスキンルート１６ }\
				{ 移動的:07, d:M_R:プリスキンルート１７ }\
				{ 移動的:08, d:M_R:プリスキンルート１８ }\
				{ 移動的:09, d:M_R:プリスキンルート１９ }\
				{ 移動的:10, d:M_R:プリスキンルート２０ }\
				{ 移動的:11, d:M_R:プリスキンルート２１ }\
				{ 移動的:12, d:M_R:プリスキンルート２２ }\
				{ 移動的:13, d:M_R:プリスキンルート２３ }\
				{ 移動的:14, d:M_R:プリスキンルート２４ }\
				{ 移動的:15, d:M_R:プリスキンルート２５ }\
			} \
			-exec { \
				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグＬ \
					-route $2 \
					-speed 50
			}

		// タキシードスネークを選択
		} else if ( $s:選択プレイヤー == タキシードスネーク ) {

			command foreach -argc 2 -repeat 12 \
			-data { \
				// 的名,     ルート
				// act 2 ----------
				{ 移動的:02, d:M_R:タキシードルート２６ }\
				{ 移動的:03, d:M_R:タキシードルート２７ }\
				{ 移動的:04, d:M_R:タキシードルート２８ }\
				{ 移動的:05, d:M_R:タキシードルート２９ }\
				{ 移動的:06, d:M_R:タキシードルート３０ }\
				{ 移動的:07, d:M_R:タキシードルート３１ }\
				{ 移動的:08, d:M_R:タキシードルート３２ }\
				{ 移動的:09, d:M_R:タキシードルート３３ }\
				{ 移動的:10, d:M_R:タキシードルート３４ }\
				{ 移動的:11, d:M_R:タキシードルート３５ }\
				{ 移動的:12, d:M_R:タキシードルート３６ }\
				{ 移動的:13, d:M_R:タキシードルート３７ }\
			} \
			-exec { \
				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグＬ \
					-route $2 \
					-speed 50
			}


		//	前作スネークを選択
		} else if ( $s:選択プレイヤー == 前作スネーク ) {

			command foreach -argc 2 -repeat 18 \
			-data { \
				// 的名,     ルート
				// act 2 ----------
				{ 移動的:02, d:M_R:前作スネークルート３８ }\
				{ 移動的:03, d:M_R:前作スネークルート３９ }\
				{ 移動的:04, d:M_R:前作スネークルート４０ }\
				{ 移動的:05, d:M_R:前作スネークルート４１ }\
				{ 移動的:06, d:M_R:前作スネークルート４２ }\
				{ 移動的:07, d:M_R:前作スネークルート４３ }\
				{ 移動的:08, d:M_R:前作スネークルート４４ }\
				{ 移動的:09, d:M_R:前作スネークルート４５ }\
				{ 移動的:10, d:M_R:前作スネークルート４６ }\
				{ 移動的:11, d:M_R:前作スネークルート４７ }\
				{ 移動的:12, d:M_R:前作スネークルート４８ }\
				{ 移動的:13, d:M_R:前作スネークルート４９ }\
				{ 移動的:14, d:M_R:前作スネークルート５０ }\
				{ 移動的:15, d:M_R:前作スネークルート５１ }\
				{ 移動的:16, d:M_R:前作スネークルート５２ }\
				{ 移動的:17, d:M_R:前作スネークルート５３ }\
				{ 移動的:18, d:M_R:前作スネークルート５４ }\
				{ 移動的:19, d:M_R:前作スネークルート５５ }\
			} \
			-exec { \
				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグＬ \
					-route $2 \
					-speed 75
			}

		}

	}

	proc ＶＲ初期配置標的ニキータ４面設定 {
		// 共通標的 （主にライデン）
		mesg ＶＲ的共通 移動的:01 移動開始

		// 他キャラ選択時の追加標的
		if ( $s:選択プレイヤー != ライデン ) {
			// ライデン以外（主にスネーク）
			mesg ＶＲ的共通 移動的:02 移動開始
			mesg ＶＲ的共通 移動的:03 移動開始
			mesg ＶＲ的共通 移動的:04 移動開始
			mesg ＶＲ的共通 移動的:05 移動開始
			mesg ＶＲ的共通 移動的:06 移動開始
			mesg ＶＲ的共通 移動的:07 移動開始
			mesg ＶＲ的共通 移動的:08 移動開始
			mesg ＶＲ的共通 移動的:09 移動開始
			mesg ＶＲ的共通 移動的:10 移動開始
			mesg ＶＲ的共通 移動的:11 移動開始
			// プリスキン
			if ( $s:選択プレイヤー == プリスキン ) {
				mesg ＶＲ的共通 移動的:12 移動開始
				mesg ＶＲ的共通 移動的:13 移動開始
				mesg ＶＲ的共通 移動的:14 移動開始
				mesg ＶＲ的共通 移動的:15 移動開始
			// タキシードスネーク
			} else if ( $s:選択プレイヤー == タキシードスネーク ) {
				mesg ＶＲ的共通 移動的:12 移動開始
				mesg ＶＲ的共通 移動的:13 移動開始
			// 前作スネーク
			} else if ( $s:選択プレイヤー == 前作スネーク ) {
				mesg ＶＲ的共通 移動的:12 移動開始
				mesg ＶＲ的共通 移動的:13 移動開始
				mesg ＶＲ的共通 移動的:14 移動開始
				mesg ＶＲ的共通 移動的:15 移動開始
				mesg ＶＲ的共通 移動的:16 移動開始
				mesg ＶＲ的共通 移動的:17 移動開始
				mesg ＶＲ的共通 移動的:18 移動開始
				mesg ＶＲ的共通 移動的:19 移動開始
			}
		} else {
			// ライデンは３つ（追加仕様）
			mesg ＶＲ的共通 移動的:02 移動開始
			mesg ＶＲ的共通 移動的:03 移動開始
			mesg ＶＲ的共通 移動的:04 移動開始
		}
	}


