// ------------------------------------
// 各gclで必要なdefine
// ------------------------------------
// 共通プロック切り分け用
#define		STAGE_VR		1		// モード
#define		STAGE_WP64A		1		// ステージ名
#define		VR_WEAPON		1		// VRステージの呼び分け

#define		STAGE_START		1		// ステージ開始直後処理
#define		CUSTOM_TRG_SPEED	1	// 前作スネークのスピードカスタム機能を停止


// ------------------------------------
// 各種スイッチ用define
// ------------------------------------
// デバッグ関係
#ifdef	d:FIX_MODE
	#define		DEBUG_CHARA		0		// デバッグキャラ全体(FIX時は0)
#else
	#define		DEBUG_CHARA		0		// デバッグキャラ全体
#endif
#define		CHARA_CAMERA	0		// キャラ追従カメラ
#define		TARGET_CHARA	敵兵:01	// キャラ追従カメラのターゲット
#define		SCREENSHOT		0		// スクリーンショット
#define		USB_KEY			0		// USBキーボード


// ------------------------------------
// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME			ws64a
#define		KMS_NAME			ws64a
#define		TONBO_KMS_NAME		ws64a_tonbo
#define		LINE_KMS_NAME		ws64a_line

// キャラクター関係
#define		PLAYER		ライデン


// ------------------------------------
// ローカル変数
// ------------------------------------


// ------------------------------------
// 的ルート番号
// ------------------------------------
enum M_R {
	//	ニキータ４面用
//	共通ルート０ = 0,	// 欠番
	共通ルート１ = 1,

	スネークルート２, スネークルート３, スネークルート４, スネークルート５, スネークルート６,
	スネークルート７, スネークルート８, スネークルート９, スネークルート１０, スネークルート１１,

	プリスキンルート１２, プリスキンルート１３, プリスキンルート１４, プリスキンルート１５, プリスキンルート１６,
	プリスキンルート１７, プリスキンルート１８, プリスキンルート１９, プリスキンルート２０, プリスキンルート２１,
	プリスキンルート２２, プリスキンルート２３, プリスキンルート２４, プリスキンルート２５,

	タキシードルート２６, タキシードルート２７, タキシードルート２８, タキシードルート２９, タキシードルート３０,
	タキシードルート３１, タキシードルート３２, タキシードルート３３, タキシードルート３４, タキシードルート３５,
	タキシードルート３６, タキシードルート３７,

	前作スネークルート３８, 前作スネークルート３９, 前作スネークルート４０, 前作スネークルート４１, 前作スネークルート４２,
	前作スネークルート４３, 前作スネークルート４４, 前作スネークルート４５, 前作スネークルート４６, 前作スネークルート４７,
	前作スネークルート４８, 前作スネークルート４９, 前作スネークルート５０, 前作スネークルート５１, 前作スネークルート５２,
	前作スネークルート５３, 前作スネークルート５４, 前作スネークルート５５,

	// 追加仕様
	ライデンルート５６, ライデンルート５７, ライデンルート５８,

}


// ------------------------------------
// include
// ------------------------------------

#include "rai_wp64a.mh"		// 強制モーションリスト

#include "stdch.h"			// 常駐キャラ
