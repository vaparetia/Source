//<ページ数変更>
ライデン_011_1: {
&~?Por qu&'e tienes tantas ganas de hablar
sobre m&'i?
}
//	<<<ENGLISH>>>
//	Why do you want to talk
//	about me so badly?

/*面白い話なんか別にないよ。
どうしてそんなこと聞きたいんだ？
*/
ローズ_012: {
Porque tengo curiosidad.
}
//	<<<ENGLISH>>>
//	Because I'm curious.

/*知りたいんだもの。*/
ライデン_013: {
&~?Pero por qu&'e?
}
//	<<<ENGLISH>>>
//	But why?

/*だからどうして？*/
ローズ_014: {
&~?Tan raro te parece que quiera conocer
mejor a la persona que amo?
}
//	<<<ENGLISH>>>
//	Is it really that strange to
//	want to know more about
//	someone you love?

/*好きな人のこと知りたいって思うの、
そんなにおかしい？
*/
ライデン_015: {
No, no es raro, pero...
}
//	<<<ENGLISH>>>
//	No, it's not strange, but...

/*おかしくはないが……*/
ローズ_016: {
Sabes, a veces yo...
}
//	<<<ENGLISH>>>
//	You know, sometimes I...

/*私、時々ね……*/
ローズ_017: {
Ya estamos otra vez hablando
de m&'i y no de ti.
}
//	<<<ENGLISH>>>
//	Oh, look, now we're talking
//	about me, not you.

/*ってほら、もう私の話になってる。
あなたのじゃなくて。
*/
ライデン_018: {
...
}
//	<<<ENGLISH>>>
//	...

/*……*/
//dv}//v
}//d

