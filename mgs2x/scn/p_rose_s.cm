}//d

//エマと手つなぎ中 h //e
resource PR_ＳＡＶＥ後＿エマと手つなぎ__s {
//vox t:vc250691 {
ローズ_000: {
Vale, la informaci&'on ha sido guardada.
Adi&'os.
}
//	<<<ENGLISH>>>
//	Right, save complete.
//	Goodbye.

/*はい記録終了。じゃ、さよなら。*/
ライデン_001: {
Espera un poco. &~?Qu&'e te pasa?
}
//	<<<ENGLISH>>>
//	Wait a minute.
//	What's wrong?

/*ちょっと待てよ。どうしたんだ？*/
ローズ_002: {
Nada. &~?Por qu&'e lo dices?
}
//	<<<ENGLISH>>>
//	Nothing. What are you
//	talking about?

/*どうしたって、なにが？
*/
ライデン_003: {
Te noto un poco fr&'ia...
}
//	<<<ENGLISH(2)>>>
//	What am I...aren't you
//	being a little cold?

/*なにって……冷たいじゃないか。
*/
ローズ_004: {
&~?De verdad? &~?No ser&'a que te lo est&'as
imaginando todo?
}
//	<<<ENGLISH>>>
//	Really? Aren't you just
//	imagining things?
//<ページ数変更>
ローズ_004_1: {
O igual es que no estoy tan caliente como
la mano que llevas un buen rato
agarrando...
}
//	<<<ENGLISH>>>
//	Maybe I'm just not as warm as
//	that hand you've been holding
//	for quite some time now.

/*そう？気のせいじゃない？確かに
あなたがずっっっと握ってる手ほどには
