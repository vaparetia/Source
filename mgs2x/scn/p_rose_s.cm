resource PR_ＳＡＶＥ後＿ピーター死直後４__s {
//vox t:vc250601 {
ライデン_000: {
No es el tipo de t&'io que se rinde
f&'acilmente... Seguro que todav&'ia est&'a vivo.
}
//	<<<ENGLISH>>>
//	He's not the kind of guy who'd
//	fold that easily... I'm sure he's
//	still alive.

/*だが簡単にくたばるような
奴じゃない……。きっと生きてる。
*/
ローズ_001: {
Pues entonces lo &'unico que podemos
hacer es rezar por &'el.
}
//	<<<ENGLISH>>>
//	I guess there's nothing we can
//	do but pray for his safety.

/*今は無事を祈るしかないわね。
*/
ライデン_002: {
S&'i. Pero si no conseguimos acabar con
esas bombas pronto, de nada valdr&'a rezar.
}
//	<<<ENGLISH>>>
//	Yeah. But if we don't take care
//	of these bombs soon, there'll be
//	nothing left to pray for.

/*ああ。早く爆弾を処理しなければ、
心配することも出来なくなってしまう。
*/
ローズ_003: {
Tienes raz&'on.
&~!S&'e que lo puedes hacer Jack!
}
//	<<<ENGLISH>>>
//	You're right. I know
//	you can do it, Jack!

/*そうね。ジャック、がんばって。
*/
//dv}//v
}//d

//プリスキン嫉妬 h //e
resource PR_ＳＡＶＥ後＿プリスキン嫉妬１__s {
//vox t:vc250611 {
ローズ_000: {
Jack, seguro que est&'as bien,
pero no te rindas.
}
//	<<<ENGLISH>>>
//	Jack, I know you're probably doing
//	fine, but don't get discouraged.
//<ページ数変更>
ローズ_000_1: {
Recuerda, el Teniente Pliskin est&'a
contigo. Todo va a salir bien.
}
//	<<<ENGLISH>>>
//	Remember, Lieutenant J.G.
//	Pliskin is with you too.
//	You'll be all right.

/*ジャック、大変だろうけど、弱気に
ならないで。プリスキン中尉もいるし。
きっと大丈夫。
*/
ライデン_001: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……（むすっ）*/
ローズ_002: {
&~?Qu&'e pasa?
}
//	<<<ENGLISH(2)>>>
//	What's wrong?

/*どうしたの？*/
ライデン_003: {
Nada.
}
//	<<<ENGLISH(2)>>>
//	Nothing.

/*（不機嫌）なんでもない。*/
ローズ_004: {
Vale ya Raiden. Cada vez que me dices
"nada" es que hay algo que te preocupa.
&~?Qu&'e te pasa?
}
//	<<<ENGLISH>>>
//	Don't give me that. Every time
//	you say "nothing," it's always
//	something. What's wrong?

/*あなたがなんでもないって言う時って、
大抵なんでもなくないじゃない。
どうしたの？
*/
ライデン_005: {
Me da la impresi&'on de que tienes
un concepto muy alto de &'el.
}
//	<<<ENGLISH>>>
//	It's just that, you know...you seem
//	to think pretty highly of him.

/*いや。ただ、えらくあいつのこと気に
するんだな、と。
*/
ローズ_006: {
Y...
}
//	<<<ENGLISH>>>
//	Well...

/*だって……。*/
ライデン_007: {
S&'i. Que Pliskin es la clase de t&'io
que a ti te mola &~?no?
}
//	<<<ENGLISH>>>
//	Yeah. Pliskin's the kind of guy you
//	can really depend on. Isn't he?

/*ああ。プリスキンは頼り甲斐のある
奴だよ。だろ？
*/
ローズ_008: {
&~?Qu&'e...?
}
//	<<<ENGLISH>>>
//	Wha-?

/*あ……？（ひょっとしてやきもちやいてる？）。*/
//dv}//v
}//d

resource PR_ＳＡＶＥ後＿プリスキン嫉妬２__s {
//vox t:vc250621 {
ライデン_000: {
&~?&~!Qu&'e!?
}
//	<<<ENGLISH>>>
//	What!?

/*なんだよ*/
ローズ_001: {
Je, je. S&'i, la verdad es que Pliskin es total,
&~?no? Es tan chachi, tan seguro de
s&'i mismo.
}
//	<<<ENGLISH>>>
//	Heh heh. Yeah, Pliskin is one heck
//	of a man, isn't he? He's so cool,
//	so -- confident!

/*ふふん。確かにプリスキン中尉って
男前よね。すっごく渋くって。素敵。
*/
ライデン_002: {
... S&'i, s&'i...
}
//	<<<ENGLISH>>>
//	...Yeah, yeah...


/*……だろうな（むすっ）*/
ローズ_003: {
Pero no es tan aut&'entico como t&'u.
T&'u siempre ser&'as mi favorito. Siempre.
}
//	<<<ENGLISH>>>
//	But he's nowhere near as cool
//	as you. You'll always be my No. 1.
//	Always.

/*でもあなたほどじゃない。
私にはあなたが一番。いつでもね。
*/
ライデン_004: {
Pero... yo no estaba insinuando que..
}
//	<<<ENGLISH>>>
//	But...that's not what I meant...


/*あ、いや……俺はそんなつもりじゃ……。*/
ローズ_005: {
Je, je. Sabes, a veces eres tan mono.
Adi&'os Jack.
}
//	<<<ENGLISH>>>
//	Hee hee. You know, you're kinda
//	cute sometimes. Bye, Jack.

/*ふふふ。あなたって時々かわいい。
じゃあね、ジャック。
*/
//dv}//v
}//d


//しばらくセーブしなかった h //e
resource PR_ＳＡＶＥ後＿しばらくＳＡＶＥしてない__s {
//vox t:vc250631 {
ローズ_000: {
Parece que al final te has dado cuenta
de que estoy aqu&'i.
}
//	<<<ENGLISH>>>
//	So, looks like you remembered
//	I'm still here after all. 

/*（皮肉）あら、まだ私がいること覚えててくれた
みたいね。よかったわ。
*/
ライデン_001: {
&~?Eh?
}
//	<<<ENGLISH>>>
//	Huh?

/*は？*/
ローズ_002: {
Pensaba que te hab&'ias olvidado
de que existo.
}
//	<<<ENGLISH>>>
//	I thought you'd completely
//	forgotten that I existed.

/*すっかり忘れちゃったのかと思ってた。
*/
ライデン_003: {
&~!Pues claro que no! &~?Qu&'e te pasa?
}
//	<<<ENGLISH>>>
//	Of course not!
//	What's wrong with you?

/*そんなわけないじゃないか。
一体どうしたんだ？
*/
ローズ_004: {
Es que... hace ya un buen rato
que no has guardado.
}
//	<<<ENGLISH(2)>>>
//	It's just...you haven't saved
//	in a while.

/*だって、あなた……
ずっと記録してなかったから。
*/
ライデン_005: {
Eso no quiere decir que me haya olvidado
de ti.
}
//	<<<ENGLISH>>>
//	That doesn't mean I forgot.

/*忘れてたわけじゃないよ。*/
ローズ_006: {
&~?No? &~?Y no se te ocurre pensar
que puedo estar preocupada?
}
//	<<<ENGLISH>>>
//	Is that so? And didn't you
//	think I'd be worried?

/*そう？でも私が心配してるんじゃないか、
とは思わなかったわけね？
*/
ライデン_007: {
Pero...
}
//	<<<ENGLISH>>>
//	But...

/*いや……。*/
ローズ_008: {
Pues estaba muy preocupada...
Est&'as bien &~?verdad?
}
//	<<<ENGLISH(2)>>>
//	I was really worried...
//	You're okay, right?

/*本当に心配してたのよ……大丈夫よね？
*/
ライデン_009: {
S&'i.
}
//	<<<ENGLISH>>>
//	Yeah.

/*ああ。*/
ローズ_010: {
Bien.
}
//	<<<ENGLISH>>>
//	Good.

/*よかった。*/
//dv}//v
}//d


//ローズを怒らせた後 h //e
resource PR_ＳＡＶＥ前＿怒らせた後１__s {
