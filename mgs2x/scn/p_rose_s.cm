/*だから……ちゃんと戻ってきて。*/
ライデン_005: {
Lo s&'e.
}
//	<<<ENGLISH>>>
//	I know.

/*わかってる。*/
//dv}//v
}//d


//キライな話題 h //e
resource PR_ＳＡＶＥ後＿キライな話題１__s {
//vox t:vc250731 {
ローズ_000: {
Jack, &~?c&'omo va la misi&'on?
