resource PR_ＳＡＶＥ後＿変装＿３__s {
//vox t:vc250501 {
ローズ_000: {
No me importar&'ia si no fueras siempre
tan bien arreglado.
}
//	<<<ENGLISH>>>
//	It'd be nice if you were
//	this stylish all the time.

/*もっと普段からおしゃれすればいいのに。
*/
ライデン_001: {
Demasiado esfuerzo para nada.
}
//	<<<ENGLISH>>>
//	It's too much of a hassle.

/*めんどくさいんだ。*/
ローズ_002: {
Bueno, al menos, te pod&'ias preocupar
un poco m&'as por tu apariencia.
}
//	<<<ENGLISH>>>
//	Well, at least you could care
//	a little bit more about how
//	you look.

/*もうちょっと気を使ってみてもいいと
思うけどな。
*/
ライデン_003: {
Ya te preocupas t&'u por los dos.
}
//	<<<ENGLISH>>>
//	You care enough for both of us.

/*君は気を使う方だよな。*/
ローズ_003: {
S&'i, eso es verdad. Pero es que quiero
estar guap&'isima siempre.
}
//	<<<ENGLISH>>>
//	Yeah, that's true. But
//	I want to be beautiful.

/*ええ。勿論。だってキレイでいたいもの。*/
ライデン_004: {
&~?Quieres que la gente te haga cumplidos?
}
//	<<<ENGLISH>>>
//	You want people to compliment you?

/*人にほめられたい？*/
ローズ_005: {
S&'i... especialmente t&'u.
}
//	<<<ENGLISH>>>
//	Yeah... especially you.

/*ええ。特にあなたに。*/
ライデン_006: {
&~?Yo?
}
//	<<<ENGLISH>>>
//	Me?

/*俺？*/
ローズ_007: {
S&'i. &~?Qu&'e pasa, te parece raro?
}
//	<<<ENGLISH>>>
//	Yes. Is that strange?

/*ええ。おかしい？*/
ライデン_008: {
En absoluto.
}
//	<<<ENGLISH>>>
//	Not at all.

/*そんなことないよ。*/
ローズ_009: {
&~?De verdad? Pues a ver si la pr&'oxima vez
que me veas me haces alg&'un cumplido.
}
//	<<<ENGLISH>>>
//	Really? Well then, next time
//	be sure to compliment me!

/*そう？じゃ、今度ちゃんとほめてね。
*/
//dv}//v
}//d

//たばこ装備時 h //e
resource PR_ＳＡＶＥ後＿たばこ__s {
//vox t:vc250511 {
ローズ_000: {
Por cierto Jack, &~?est&'as fumando?
}
//	<<<ENGLISH>>>
//	By the way, Jack,
//	are you smoking?

/*ところでジャック、煙草吸ってるの？*/
ライデン_001: {
S&'i.
}
//	<<<ENGLISH>>>
//	Yep.

/*ああ……ぷはー。（うまそうに一服）*/
ローズ_002: {
&~!Pensaba que hab&'ias dejado de fumar!
&~?Por qu&'e has vuelto?
}
//	<<<ENGLISH>>>
//	I thought you quit smoking!
//	Why did you start again?

/*ずっと禁煙してたじゃない？どうして？
*/
ライデン_003: {
Por muchas razones...
}
//	<<<ENGLISH>>>
//	There are lots of reasons...

/*これにはいろいろ事情が……*/
ローズ_004: {
Escucha, lo &'unico que estoy haciendo
es preocuparme por tu salud, &~?vale?
Acu&'erdate cu&'anto te cost&'o dejarlo
la &'ultima vez.
}
//	<<<ENGLISH>>>
//	Look, I'm only thinking about your
//	health, okay? Remember the last
//	time you quit -- how hard it was?

/*もう、あなたの体のこと思って言ってる
のに。やめる時大変だったでしょ。
忘れたの？
*/
ライデン_005: {
S&'i... la verdad es que fue muy duro...
}
//	<<<ENGLISH>>>
//	Yeah... it was pretty tough...

/*ああ。あれはつらかった……。*/
ローズ_006: {
&~?Verdad? Por eso deber&'ias...
}
//	<<<ENGLISH>>>
//	Wasn't it? So you should...

/*でしょ。だったら……*/
ライデン_007: {
Ya lo s&'e Rose. Pero he encontrado
una soluci&'on para que esta vez no
me cueste tanto.
}
//	<<<ENGLISH>>>
//	I've got it, Rose. I've thought of
//	a way to avoid all that pain and
//	suffering.

/*そうだ。ローズ、あの苦しみを
味わわずに済む方法を思い付いたぞ。
*/
ローズ_008: {
&~?Qu&'e vas a hacer?
}
//	<<<ENGLISH(2)>>>
//	What are you going to do?

/*どうするの？*/
ライデン_009: {
Seguir fumando.
}
//	<<<ENGLISH>>>
//	Keep smoking.

/*禁煙しなきゃいい。*/
ローズ_010: {
&~!Jack!
}
//	<<<ENGLISH>>>
//	Jack!

/*ジャック！*/
ライデン_011: {
Estoy bromeando. Ya s&'e que es malo
para mi salud. En cuanto vuelva,
lo dejar&'e definitivamente.
}
//	<<<ENGLISH>>>
//	Just kidding. I know it's bad
//	for me. I'll quit as soon as
//	I get back.

/*冗談だよ。煙草は体に良くないからな。
帰ったらちゃんとやめる。ふぅー。（またうまそうに一服）
*/
ローズ_012: {
...
}
//	<<<ENGLISH>>>
//	...

/*……。
*/
//dv}//v
}//d


//エロ本装備時 h //e
resource PR_ＳＡＶＥ後＿エロ本__s {
//vox t:vc250521 {
ローズ_000: {
Por cierto Jack... &~?qu&'e tienes
en la mano?
}
//	<<<ENGLISH(2)>>>
//	By the way, Jack...what's
//	that you're holding?

/*ところでジャック……何持ってるの？
*/
ライデン_001: {
&~!Ah esto...!
}
//	Uh, well...

/*あ、いや……。*/
ローズ_002: {
Mira, si te est&'a molestando tanto,
lo deber&'ias de decir.
}
//	Look, if it's bothering you that
//	much, you should just say so.

/*もう、そんなに困ってるなら
一言いってくれればいいのに。
*/
ライデン_003: {
&~?Eh? &~?Y si te lo digo?
}
//	<<<ENGLISH>>>
//	Eh? And if I do?

/*え？言ったら？*/
ローズ_004: {
Je, je, je...
}
//	<<<ENGLISH>>>
//	Uh hn...

/*ふふふ……*/
ローズ_005: {
Paciencia cari&~no, paciencia.
}
//	<<<ENGLISH>>>
//	Just be patient, dear!

/*がまんなさいってアドバイスしてあげる！*/
//dv}//v
}//d

//何人か殺した後 h //e
resource PR_ＳＡＶＥ後＿殺した__s {
//vox t:vc250531 {
ライデン_000: {
Rose, &~?no tienes nada que decir?
}
//	<<<ENGLISH>>>
//	Rose... no comment?

/*ローズ……何か言わないのか？*/
ローズ_001: {
&~?Sobre qu&'e...?
}
//	<<<ENGLISH>>>
//	About...?

/*何を？*/
ライデン_002: {
He matado a alguien.
}
//	<<<ENGLISH>>>
//	I've killed someone.

/*俺は人を殺した。*/
ローズ_003: {
Jack, es una guerra...
}
//	<<<ENGLISH>>>
//	Jack, it's a battlefield...

/*ジャック……戦場なんだから……。*/
ライデン_004: {
Mis oponentes son personas, como yo.
&~!Esto no es como el entrenamiento
de RV!
}
//	<<<ENGLISH>>>
//	My opponents are living,
//	breathing human beings!
//	This isn't like the VR training!
//<ページ数変更>
ライデン_004_1: {
&~!Son personas! &~!Son seres humanos,
con vida! Y yo se las he arrebatado.
}
//	<<<ENGLISH>>>
//	They have bodies. They have --
//	had -- lives. I took all that away
//	from them.

/*相手は生身の人間だ。ＶＲ訓練とは違う。
実体がある。人生も……あった。
俺はそれを奪ったんだ。
*/
ローズ_005: {
Pero si quieres seguir vivo,
no tienes otra opci&'on...
}
//	<<<ENGLISH>>>
//	But you've got no choice
//	if you want to survive...

/*でも生き残るためには仕方が……
*/
ライデン_006: {
S&'i, ya, pero puede que sea por los
entrenamientos de RV, pero todav&'ia no
he conseguido desconectar de la realidad.
}
//	<<<ENGLISH>>>
//	And yet... maybe because of
//	the VR training... I can't help
//	but try and block out that reality.
//<ページ数変更>
ライデン_006_1: {
S&'olo as&'i podr&'e luchar.
}
//	<<<ENGLISH>>>
//	It's the only way I can
//	manage to fight...

/*それに、俺はあまりショックを受けて
ないんだ。ははは。これもＶＲ訓練の
成果なのかな……。
*/
ローズ_007: {
Jack!
}
//	<<<ENGLISH>>>
//	Jack!

/*ジャック！*/
ライデン_008: {
&~?Eh?
}
//	<<<ENGLISH>>>
//	What?

/*え？*/
ローズ_009: {
No me importa lo que tengas que hacer,
siempre y cuando vuelvas vivo.
}
//	<<<ENGLISH>>>
//	I don't care what it takes, just
//	as long as you come back alive.
//<ページ数変更>
ローズ_009_1: {
Haz lo que sea. &~!Por favor!
&~!Regresa vivo!
}
//	<<<ENGLISH>>>
//	Do whatever it takes. Please!
//	Just come back in one piece!

/*私、あなたが生きて戻ってきてくれる
なら何だって構わない。何したっていい
から。だからお願い。無事で帰ってきて。
*/
ライデン_010: {
... Vale.
}
//	<<<ENGLISH>>>
//	...OK.

/*……ああ。*/
//dv}//v
}//d

//帰還パーティー h //e
resource PR_ＳＡＶＥ後＿帰還パーティー__s {
//vox t:vc250541 {
ローズ_000: {
Jack... cuando vuelvas a casa, hagamos
una fiesta de bienvenida. T&'u y yo solos.
}
//	<<<ENGLISH>>>
//	Jack... when you get home, let's
//	have a homecoming party. Just
//	the two of us.

/*ジャック……
帰ったら、帰還パーティー開きましょう。
二人だけで。
*/
ライデン_001: {
S&'i, es una buena idea.
}
//	<<<ENGLISH>>>
//	Yeah, that's a good idea.

/*ああ。いいな、それ。*/
ローズ_002: {
Cocinar&'e para ti.
}
//	<<<ENGLISH>>>
//	I'll make dinner.

/*私、料理つくるから。*/
ライデン_003: {
&~?Eh?
}
//	<<<ENGLISH>>>
//	Eh?

/*え！？（まじかよ、やめてくれ！）*/
ローズ_004: {
&~?Qu&'e te pasa?
}
//	<<<ENGLISH>>>
//	What's wrong?

/*どうかした？*/
ライデン_005: {
No nada, que me parece una buena idea,
pero &~?por qu&'e no salimos a cenar fuera?
}
//	<<<ENGLISH>>>
//	Well, that sounds good, but
//	how about we eat out at that
//	one restaurant instead?

/*あ、いや、それもいいが、そうだ、
あの店行かないか？
*/
ライデン_006: {
Sabes, a ese restaurante que fuimos
hace poco, el de la langosta...
}
//	<<<ENGLISH>>>
//	You know, the place that we
//	went to recently, with the
//	amazing lobster...
//<ページ数変更>
ライデン_006_1: {
Me gust&'o much&'isimo.
}
//	<<<ENGLISH>>>
//	I really liked that place.

/*ほら、この前行った、ロブスターの
美味い……あそこ気にいってるんだ。
*/
ローズ_007: {
Bien vale, podemos ir ah&'i.
}
//	<<<ENGLISH>>>
//	Well...yeah, I guess
//	that's okay too.

/*え？いいけど？
*/
ライデン_008: {
Ufff...
}
//	<<<ENGLISH>>>
//	Whew...

/*ふぅ……。（安堵）*/
ローズ_009: {
&~?Eh?
}
//	<<<ENGLISH>>>
//	Huh?

/*は？*/
ライデン_010: {
No, nada. Me encanta la langosta.
S&'i. No aguanto las ganas.
}
//	<<<ENGLISH>>>
//	Er, nothing. I-I just love lobster.
//	Yeah. Can't wait. Woo-hoo!

/*あ、いやなんでもない。
ロブスター大好きなんだ。
うん。楽しみだな。はは。
*/
ローズ_011: {
&~?...? Bueno, pues har&'e
la reserva.
}
//	<<<ENGLISH>>>
//	...? Well then, I'll
//	make a reservation.

/*……？（なんか変だなと思いつつ）じゃ、予約入れとくから。
*/
ローズ_012: {
Prom&'eteme que volver&'as sano y salvo.
}
//	<<<ENGLISH>>>
//	Promise me you'll
//	come back safely.

/*必ず無事で戻ってね。*/
ライデン_013: {
&~!No te preocupes!
}
//	<<<ENGLISH>>>
//	Don't worry!

/*勿論だ。*/
//dv}//v
}//d

//序盤 しばらくしてから h //e
resource PR_ＳＡＶＥ後＿しばらくしてから__s {
//vox t:vc250551 {
ライデン_000: {
Rose... &~?est&'as bien?
}
//	<<<ENGLISH>>>
//	Rose...are you okay?

/*ローズ……君の方は大丈夫か？*/
ローズ_001: {
S&'i. Gracias... al principio estaba muy
asustada, pero creo que ya me voy
acostumbrando.
}
//	<<<ENGLISH>>>
//	Yes. Thank you... i-it really scared
//	me at first, but I think I've gotten
//	used to it.

/*ええ。ありがとう。……最初はすごく
恐かったけど、だいぶ馴れてきたみたい。
*/
ローズ_002: {
Estar&'e contigo hasta el final,
no te preocupes.
}
//	<<<ENGLISH>>>
//	I'll be behind you all the
//	way, so don't worry.

/*ちゃんとサポートできるから。
心配しないで。
*/
ライデン_003: {
Al final va a ser verdad que las mujeres
sois muy fuertes.
}
//	<<<ENGLISH>>>
//	I guess women really are strong.

/*女は強いな。*/
ローズ_004: {
No. No son las mujeres las que son
fuertes, soy yo.
}
//	<<<ENGLISH>>>
//	Not quite. It's not women
//	that are strong -- it's me.

/*それ、ちょっと違う。女が、じゃなくて私が、強いの。
*/
ライデン_005: {
Siempre y cuando pueda contar contigo.
}
//	<<<ENGLISH>>>
//	Just as long as
//	I can count on you.

/*頼もしい限りだ。*/
ローズ_006: {
Bueno... lo cierto es que no es verdad.
Estoy cagada de miedo.
}
//	<<<ENGLISH>>>
//	... actually, that's not true.
//	It still scares me to death.
//<ページ数変更>
ローズ_006_1: {
Pero ser&'e fuerte. Lo voy a intentar, por ti.
&~!Buena suerte!
}
//	<<<ENGLISH>>>
//	But I'll be strong. I'll try
//	-- for you. Good luck!

/*……嘘。ホントは今も恐くてたまらない。
でも強くなる。なるようにする。
あなたのために。がんばって。
*/
//dv}//v
}//d


//爆弾解体中 スネーク嫉妬 h //e
resource PR_ＳＡＶＥ後＿爆弾解体中スネーク__s {
//vox t:vc250561 {
ローズ_000: {
Lo est&'as haciendo muy bien.
}
//	<<<ENGLISH>>>
//	You're looking pretty good.

/*順調みたいね。*/
ライデン_001: {
S&'i.
}
//	<<<ENGLISH>>>
//	Yeah.

/*ああ。*/
ローズ_002: {
Me pregunto c&'omo lo estar&'a haciendo
el Teniente Pliskin...
}
//	<<<ENGLISH>>>
//	I wonder how Lieutenant J.G.
//	Pliskin is doing...

/*プリスキン中尉の方はどうかしら？
*/
ライデン_003: {
&'El tambi&'en lo est&'a haciendo muy bien.
}
//	<<<ENGLISH>>>
//	Well, he's doing pretty good too.

/*ああ。あっちも順調みたいだ。*/
ローズ_004: {
&~?De verdad? &~!Me alegro!
}
//	<<<ENGLISH>>>
//	Oh, really? I'm glad!

/*そう。それはよかった。*/
ライデン_005: {
&~?Por qu&'e est&'as tan preocupada?
}
//	<<<ENGLISH>>>
//	Why are you so worried?

/*気になるのか？*/
ローズ_006: {
&~?Eh?
}
//	<<<ENGLISH>>>
//	Huh?

/*え？*/
ライデン_007: {
Por Pliskin.
}
//	<<<ENGLISH>>>
//	About Pliskin.

/*……プリスキン。*/
ローズ_008: {
Bueno, &'el est&'a desactivando las bombas
contigo. Si &'el no lo hace bien, t&'u estar&'as...
}
//	<<<ENGLISH>>>
//	Well, I mean, he's defusing
//	the bombs along with you. If he
//	screws something up, you'll be...

/*だって一緒に爆弾処理してるんでしょ。
向こうが失敗したらあなたも……
*/
ライデン_009: {
Pero estoy seguro que &'el va a estar bien.
No te preocupes.
}
//	<<<ENGLISH>>>
//	I guess so. He'll be all right,
//	I'm sure. Don't worry about it.

/*ああ。そうだな。あいつの方はきっと
大丈夫だ。心配はいらないと思う。
*/
ローズ_010: {
Vale. Aguanta.
}
//	<<<ENGLISH>>>
//	Okay. Hang in there.

/*そう。あなたもがんばってね。*/
//dv}//v
}//d

//ピーター死の直後 h //e
resource PR_ＳＡＶＥ後＿ピーター死直後１__s {
