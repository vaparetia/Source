ローズ_000: {
Jack, &~?est&'as bien?
}
//	<<<ENGLISH(2)>>>
//	Jack, are you all right?

/*ジャック……大丈夫？*/
ライデン_001: {
S&'i, estoy bien, pero Stillman...
voy a tener que hacerlo yo solo.
}
//	<<<ENGLISH>>>
//	Yeah. I'm okay, but Stillman...
//	I'm going to have to finish this
//	myself.

/*ああ。スティルマンはもう……。
俺がやるしかない。
*/
ローズ_002: {
&~?Y por qu&'e no te ayuda
el Teniente Pliskin?
}
//	<<<ENGLISH>>>
