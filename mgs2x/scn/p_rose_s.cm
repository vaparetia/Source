}//d

resource PR_ＳＡＶＥ後＿つらそう２__s {
//vox t:vc250841 {
ローズ_000: {
Y no s&'e qu&'e es lo que te est&'a haciendo
sufrir tanto. Y eso es muy duro para m&'i.
Si al menos hablaras conmigo sobre ello...
}
//	<<<ENGLISH>>>
//	And I have no idea what's making
//	you suffer so much. That's hard for
//	me. If only you'd talk to me about it...

/*でも私にはあなたが何をそんなに苦しん
でるのかわからない。それがつらいのよ。
もし話してくれれば……（力になれると思う）
*/
ライデン_001: {
Hay cosas que quiero que t&'u entiendas
sin tener que explic&'artelas.
}
//	<<<ENGLISH>>>
//	There are some things I want you
//	to understand without me having
//	to explain.

/*話さずにわかってもらいたいことだって
あるじゃないか。
*/
ローズ_002: {
No puedes pretender que yo...
}
//	<<<ENGLISH>>>
//	You can't possibly expect me to...

/*そんな都合のいいことあるわけ……*/
ローズ_003: {
...
}
//	<<<ENGLISH>>>
//	...

/*……（ふと気づいて突然黙り込む）*/
ライデン_004: {
&~?Rose?
}
//	<<<ENGLISH>>>
//	Rose?

/*ローズ？*/
ローズ_005: {
...S&'i, imagino que tienes raz&'on.
}
//	<<<ENGLISH>>>
//	...I guess you're right.

/*……（ため息）あるのかもね。*/
ローズ_006: {
Igual si fu&'eramos m&'as compatibles, podr&'ia
entenderlo sin que t&'u me lo tuvieras que
decir.
}
//	<<<ENGLISH>>>
//	Maybe if I were a better match for
//	you, I could understand without
//	being told.

/*本当にあなたにぴったりの人だったら
何も言われなくてもわかってあげられる
のかも。
*/
ローズ_007: {
Pero no lo somos.
Me temo que somos muy diferentes.
}
//	<<<ENGLISH>>>
//	But I'm guess I'm not. I guess
//	I'm just too different.

/*私はそうじゃないのかも。
違うってだけなのかも。
*/
ライデン_008: {
Rose, eso...
}
//	<<<ENGLISH>>>
//	Rose, that's...

/*ローズ……そんなことは……*/
ローズ_009: {
&~?No es verdad?
}
//	<<<ENGLISH>>>
//	Not true?

/*ないって？*/
ライデン_010: {
No. Eres perfecta para mi.
Eres, como decirlo... mi mujer ideal.
}
//	<<<ENGLISH>>>
//	Yeah. You're perfect for me.
//	The ideal woman...so to speak.

/*ああ。君は俺にぴったりだよ。
理想の女性……といってもいい。
*/
ローズ_011: {
&~?Ideal...?
}
//	<<<ENGLISH>>>
//	Ideal...?

/*理想……？（ローズはライデンの夢の女性像を演じるよう命じられている）*/
ライデン_012: {
S&'i.
}
//	<<<ENGLISH>>>
//	Yeah.

/*ああ。*/
ローズ_013: {
... Si...
}
//	<<<ENGLISH>>>
//	...If...

/*……もし……*/
ライデン_014: {
&~?Eh?
}
//	<<<ENGLISH>>>
//	Huh?

/*え？*/
ローズ_015: {
... Si... si yo estuviera...
}
//	<<<ENGLISH>>>
//	...if...if I was...

/*……もしもよ……私がその理想を……（演じていただけだとしたら？）*/
ライデン_016: {
&~?Qu&'e est&'as intentando decir?
}
//	<<<ENGLISH>>>
//	What are you trying to say?

/*なんだ？*/
ローズ_017: {
... Nada, olv&'idalo. Lo siento, he estado a
punto de decir una estupidez. Vuelve a
la misi&'on.
}
//	<<<ENGLISH>>>
//	...Nothing, never mind. Sorry,
//	I was about to say something
//	stupid. Get back to the mission.

/*……いいえ。何でもない。ごめんなさい。変なこと言って。任務に戻って。
*/
//dv}//v
}//d


