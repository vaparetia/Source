}//d

resource PR_ＳＡＶＥ後＿少年兵後２__s {
//vox t:vc250861 {
ローズ_000: {
Pero &'ese no era el problema...
hab&'ia algo m&'as serio...
}
//	<<<ENGLISH>>>
//	But that wasn't the problem...
//	there was something deeper...

/*でも問題はそんなことじゃなかった……。
もっと根本的な……
*/
ライデン_001: {
Lo siento.
}
//	<<<ENGLISH>>>
//	I'm sorry.

/*すまない。*/
ローズ_002: {
... Imagino que es imposible
para m&'i...
}
//	<<<ENGLISH>>>
//	...I guess it's impossible
//	for me...

/*……やっぱり私には無理だった……。（スパイをやり通すのは無理だった）
*/
ライデン_003: {
&~?Qu&'e est&'as diciendo?
}
//	<<<ENGLISH>>>
//	What are you saying?

/*なんだって？*/
ローズ_004: {
Lo siento Jack. Te quiero.
De verdad.
}
//	<<<ENGLISH>>>
//	I'm sorry, Jack. I love you.
//	I really do.
//<ページ数変更>
ローズ_004_1: {
Tienes que creerme,
pase lo que pase...
}
//	<<<ENGLISH>>>
//	Please believe me...
//	...whatever happens.

/*ごめんなさい。ジャック。愛してる。
本当よ。それだけは信じて。
……何があっても。
*/
ライデン_005: {
&~?Rose?
}
//	<<<ENGLISH>>>
//	Rose?

/*ローズ？*/
ローズ_006: {
Adi&'os, Jack.
}
//	<<<ENGLISH>>>
//	Bye, Jack.

/*……じゃあね。*/
