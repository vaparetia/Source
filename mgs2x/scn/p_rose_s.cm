//ＳＡＶＥ後会話 d //e
//ダンボールかぶった状態 h //e
resource PR_ＳＡＶＥ後＿ダンボール__s {
//vox t:vc250471 {
ローズ_000: {
&~!No me lo puedo creer!
&~?Qu&'e llevas puesto?
}
//	<<<ENGLISH(2)>>>
//	What -- I-I can't believe this!
//	What are you wearing?

/*って、信じられない。何そのカッコ？
*/
ライデン_001: {
Mmm... es un disfraz.
}
//	<<<ENGLISH>>>
//	Er... it's a disguise.


/*ええと、偽装だ。*/
ローズ_002: {
&~?Un disfraz? &~?Pero qu&'e clase de disfraz
es &'ese?
}
//	<<<ENGLISH>>>
//	A disguise?
//	What kind of disguise?

/*偽装？なんの？
*/
ライデン_003: {
Bueno, lo iba a utilizar para camuflarme...
ya sabes,
}
//	<<<ENGLISH>>>
//	Well, I was hoping I could use it
//	kind of like camouflage... you know,
//<ページ数変更>
ライデン_003_1: {
para que el enemigo creyera
que era una caja.
}
//	<<<ENGLISH>>>
//	fool the enemy into
//	thinking I was a box..

/*いや、
これで敵の目を誤魔化せるかな、と。
*/
ローズ_004: {
&~!&~!Pues ya tienen que ser idiotas
para cre&'erselo!!
}
//	<<<ENGLISH>>>
//	You'd have to be an absolute
//	idiot to be fooled by that!

/*それで誤魔化されるのって相当
マヌケじゃない？
*/
ライデン_005: {
Puede que s&'i, pero hay m&'as idiotas
sueltos de los que t&'u crees.
}
//	<<<ENGLISH>>>
//	Yeah, maybe, but there are more
//	idiots in this world than you think.

/*そうかもしれないが、君が思ってるより
マヌケってのは多いらしい。
*/
ローズ_006: {
&~?... como por ejemplo t&'u?
}
//	<<<ENGLISH>>>
//	...You mean like you?

/*……あなたもそのクチみたいね。*/
ライデン_007: {
&~?Qu&'e?
}
//	<<<ENGLISH>>>
//	Huh?

/*は？*/
ローズ_008: {
Olv&'idalo. De todas formas, &~!buena suerte!
&~!La vas a necesitar con esa caja encima
de la cabeza!
}
//	<<<ENGLISH>>>
//	Never mind. Anyway, good luck!
//	You'll probably need it with that
//	stupid box on your head!

/*なんでもない。じゃせいぜいがんばって。変な箱かぶりながら！
*/
//dv}//v
}//d

