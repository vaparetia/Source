proc デモ風設定 {
	chara 風制御 風	\
		-i 100 \
		-j 150 \
		-r -1024 0 0 \
		-a 512 \
		-b 300 \
		-c 150
}

proc ヴァンプセット {
	#if d:DEBUG_PRINT 
		print 'set vmp model'
	#endif
	chara プットオブジェ こっそりヴァンプ \
		-m d:KMS_NAME_VMP \
		-r 0,0,0 \
		-p 60000,0,32000 \
		-l d:LT2_NAME_0730 \
		-f 0x0010 \
		-s 1000,1000,1000
}

proc ヴァンプオン { mesg プットオブジェ こっそりヴァンプ on }
proc ヴァンプオフ { mesg プットオブジェ こっそりヴァンプ off }

// [追加] 2001/09/05 Uehara Masatoshi
proc リアル影セット {
	chara 影投影モデル フェデ前通りの影もでる \
		-m w62a_demo_sdw_1 \
		-p 0 2 0

	chara 影管理 影かんり \
		-t 0 \
		-p -4000 -3000 -3000
}
proc ライデン影オン {
	mesg 影管理 影かんり demo_add "rai_def ライデン01" フェデ前通りの影もでる	// ライデン
}
proc ライデン影オフ {
	mesg 影管理 影かんり del "rai_def ライデン01"	// ライデン
}
