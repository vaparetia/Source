//ＥＦ連絡橋 d //e
//地雷探知器のありか h //e
//一回目のみ t //e
resource PS_地雷探知器のありか１__e {
//vox t:vc210011 {
ライデン_000: {
Pliskin, there are landmines
in this area...
}
/*プリスキン、こっちに地雷が
仕掛けられていて……。*/
//dv}//v
}//d
resource PS_地雷探知器のありか２＿１__e {
//vox t:vc210021 {
プリスキン_000: {
There should be a mine detector
on Floor B1 of Strut E.
}
/*地雷探知機ならＥ脚のＢ１にあるはずだ。*/
//dv}//v
}//d
resource PS_地雷探知器のありか２＿２__e {
//vox t:vc210031 {
プリスキン_000: {
There should be a mine detector
on the first floor of Strut E.
}
/*地雷探知機ならＥ脚の１Ｆにあるはずだ。*/
//dv}//v
}//d
resource PS_地雷探知器のありか２＿３__e {
//vox t:vc210041 {
プリスキン_000: {
There should be a mine
detector in Strut F.
}
/*地雷探知機ならＦ脚にあるはずだ。*/
//dv}//v
}//d

//一回目のみ t //e
resource PS_地雷探知器のありか３__e {
//vox t:vc210051 {
ライデン_000: {
How do you know?
}
/*なぜわかる？*/
プリスキン_001: {
Use your head. They can't see those
Claymore mines either, even if they
did the planting.
}
//<ページ数変更>
プリスキン_001_1: {
So they need to keep a
mine detector handy.
}
/*考えてみろ。クレイモアを仕掛けた
奴らも地雷が見えないんだ。探知機を
そばにおいておくに違いない。
*/
ライデン_002: {
I wouldn't have thought
of that. You're right.
}
/*凄い読みだな。*/
プリスキン_003: {
I don't think they taught you
this in all that VR training,
}//<ページ数変更>
プリスキン_003_1: {
but intuition counts for
something in battle.
}//<ページ数変更>
プリスキン_003_2: {
Use your wits and senses to
detect the danger. Got it?
}
/*ＶＲ訓練では教わっていないようだが、
戦場では勘が大切なんだ。理屈ではなく、
全神経で危険を感じ取れ。いいな。
*/
//dv}//v
}//d

