}//d



//部位攻撃 h //e
resource PS_敵の部位攻撃__e {
//vox t:vc211571 {
プリスキン_000: {
Think about what the ideal spot to
aim for is, depending on time and
circumstances.
}
/*時と場合によって敵を狙う部位を
考えるんだ。*/
プリスキン_001: {
Go for the central nervous
system if you absolutely have
to take someone out.
}
/*とくかく相手を倒すには中枢神経系を
