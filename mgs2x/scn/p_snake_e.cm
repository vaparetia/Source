//dv}//v
}//d
resource PS_シェル２中央棟＿南西行け２__e {
//vox t:vc210161 {
プリスキン_000: {
Start out by swimming south.
}
/*まずは南の方に泳いで行くんだ。*/
//dv}//v
}//d
//Ｂ１南にいる t //e
resource PS_シェル２中央棟＿西行け１__e {
//vox t:vc210171 {
プリスキン_000: {
Swim as far west as you can.
Then head north and you should
