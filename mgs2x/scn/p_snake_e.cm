//dv}//v
}//d

//投擲距離 h //e
resource PS_投擲距離__e {
//vox t:vc211401 {
プリスキン_000: {
To throw something,
such as a grenade or
a magazine --
}//<ページ数変更>
プリスキン_000_1: {
press the Weapon button to cock
your arm and release the Weapon
button to throw the object.
}
/*各種グレネードやマガジンなど
手で投げるものは□ボタンを押すと
構え、□ボタンを離すと投げる。
*/
プリスキン_001: {
Remember, the distance thrown
varies, depending on how hard
you press the Weapon button.
}
/*この時□ボタンを押し込む強さを
変えれば投擲距離を変えられるという
ことを覚えておけ。*/
プリスキン_002: {
Make sure you target the throw
at the most effective spot.
}
/*必要な時にもっとも効果的な場所へ
投げ込めるようにしておくんだ。*/
//dv}//v
}//d
