it will be fully reloaded
automatically.
}//<ページ数変更>
#ifdef d:XBOX
プリスキン_001_2: {
You can easily do this by using 
the weapon menu button to change 
equipment quickly.
}
#else
プリスキン_001_2: {
You can easily do this by using
the R2 button to change equipment
quickly.
}
#endif
/*銃を一度装備から外すとマガジンの最大
数まで装弾する。Ｒ２ボタンのクイック
チェンジを使えば楽に出来るはずだ。
*/
//dv}//v
}//d



//Ｃ脚 d //e
//女子便所 h //e
