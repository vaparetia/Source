}
/*グレネードを使えば戦闘を有利に
進められるはずだ。
*/
//dv}//v
}//d

//ニキータスピードアップ h //e
resource PS_ニキータスピードアップ__e {
//vox t:vc211671 {
プリスキン_000: {
The less you manipulate a
remote-controlled missile,
the faster it'll travel.
}
/*リモコンミサイルは操作しなければ
飛行速度が上がる。*/
プリスキン_001: {
Use this and you'll be able to
