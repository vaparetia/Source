//dv}//v
}//d
//Ｂ１南西にいる t //e
resource PS_シェル２中央棟＿北行け１__e {
//vox t:vc210181 {
プリスキン_000: {
Filter Chamber No. 2 should be
just north of your present location.
Head northward.
}
/*第二濾過室はその北だ。
北に向かえ。*/
//dv}//v
}//d




