//dv}//v
}//d
//水中機雷 h //e
resource PS_シェル２中央棟＿水中機雷１__e {
//vox t:vc210111 {
プリスキン_000: {
Raiden, watch out for
that underwater mine.
}//<ページ数変更>
プリスキン_000_1: {
It'll detonate on contact,
so make sure you avoid it.
}
/*ライデン、水中機雷に気をつけろ。
触れると爆発するぞ。機雷をよけて
泳ぐんだ。
*/
//dv}//v
}//d
//一回目のみ t //e
resource PS_シェル２中央棟＿水中機雷２__e {
//vox t:vc210121 {
ライデン_000: {
Why would there be a mine here?
}
/*なぜこんなところに水中機雷があるんだ？*/
プリスキン_001: {
Because someone planted one.
}
/*誰かが仕掛けたからだろう。*/
オタコン_002: {
What about that guy who was
running on water? Could have
been him.
}
/*あいつじゃないか？
水面を走っていた男……。*/
プリスキン_003: {
You'd better watch your back.
He may be waiting to ambush.
}
/*気をつけたほうがいいな。
待ち伏せしているかもしれん。*/
ライデン_004: {
OK...
}
/*……ああ……。*/
//dv}//v
}//d
