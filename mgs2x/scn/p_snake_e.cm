//dv}//v
}//d
//Ｂ１にいる t //e
resource PS_シェル２中央棟Ｂ１＿エマ居場所２__e {
//vox t:vc210141 {
プリスキン_000: {
It's in the northeast section
of the floor you're on.
}
/*お前がいるフロアの北東部だ。*/
//dv}//v
}//d
//Ｂ１北にいる t //e
resource PS_シェル２中央棟＿南西行け１__e {
//vox t:vc210151 {
プリスキン_000: {
Go around from the south and
you should be able to reach her.
}
/*南の方からまわっていけば辿り着ける
