//刀の説明 h //e
resource PS_刀説明１__e {
//vox t:vc211081 {
#ifdef d:XBOX
プリスキン_000: {
Move the right thumbstick
to control the blade.
}//<ページ数変更>
プリスキン_000_1: {
Move the right thumbstick up and down 
to slash up or down, and left and
right to slice the blade horizontally.
}
#else
プリスキン_000: {
Use the right analog stick
to control the blade.
}//<ページ数変更>
プリスキン_000_1: {
Move the stick up and down to
swish up or down, and left and
right to slice the blade horizontally.
}
#endif
/*刀の操作は右スティックを使う。
右スティックを上下に振れば上下に斬り、
左右に動かせば水平になぎ払う。
*/
//dv}//v
}//d
resource PS_刀説明２__e {
//vox t:vc211091 {
#ifdef d:XBOX
プリスキン_000: {
Move the right thumbstick in a circle 
to twirl the blade.
}
#else
プリスキン_000: {
Rotate the right analog
stick to twirl the blade.
}
#endif
/*右スティックを一回転させるように
まわせば回転斬りだ。*/
//dv}//v
}//d
resource PS_刀説明３__e {
//vox t:vc211101 {
#ifdef d:XBOX
プリスキン_000: {
Click the right thumbstick 
to get a stabbing strike.
}//<ページ数変更>
#else
プリスキン_000: {
Push the right analog stick
forward to get a stabbing
strike.
}//<ページ数変更>
#endif
プリスキン_000_1: {
It has more reach and power than
normal strikes, but you're also
more open to counterattacks.
}//<ページ数変更>
プリスキン_000_2: {
Weigh the pros and cons well.
}
/*右スティックを押し込めば突きが出せる。
通常の攻撃よりもリーチが長く強力だが、
隙も大きい。そこは注意しろ。
*/
//dv}//v
}//d
resource PS_刀説明＿防御１__e {
//vox t:vc211111 {
プリスキン_000: {
Push the Weapon button with
the blade selected to block.
}//<ページ数変更>
プリスキン_000_1: {
With the Weapon button pressed,
you'll be able to deflect enemy
gunfire.
}
/*刀の装備中に□ボタンを押せば防御だ。
□ボタンを押している間、敵の銃弾を
弾き返すことが出来る。
*/
//dv}//v
}//d
resource PS_刀説明＿防御２__e {
//vox t:vc211121 {
#ifdef d:XBOX
プリスキン_000: {
Push the lock-on button with the
blade selected to block.
}//<ページ数変更>
プリスキン_000_1: {
With the lock-on button pressed, 
you'll be able to deflect enemy 
gunfire.
}
#else
プリスキン_000: {
Push the L1 button with the
blade selected to block.
}//<ページ数変更>
プリスキン_000_1: {
With the L1 button pressed, you'll
be able to deflect enemy gunfire.
}
#endif
/*刀の装備中にＬ１ボタンを押せば防御だ。
Ｌ１ボタンを押している間、敵の銃弾を
弾き返すことが出来る。
*/
//dv}//v
}//d

resource PS_刀説明＿防御３__e {
//vox t:vc211131 {
プリスキン_000: {
Be careful, though -- blocking
works only for frontal attacks.
}
/*だが気をつけろ。
防御が有効なのは前方からの攻撃に
対してだけだ。*/
//dv}//v
}//d
