proc ビッグシェル全景_空設置 {
	chara 汎用空 デモ用空 \
		-c 7 31 37\
		-pos 52000 -41000 -210000 \
		-l   (32*20) \
		-f	 0 \
		-t 4 sky_n1_alp 198 54 42 50 \
			 sky_n2_alp 125 44 34 50 \
			 sky_n3_alp 0 0 0 0 \
			 sky_n4_alp 154 73 53 50 \
		-m 1 n_sky_wall1 25 24 24 -100 0

		chara 太陽 ソル \
			-l (32*20) \
			-p 0 0 0 \    		//中心の位置
			-f -4700 350 -1600 \    //平行光源の-pと同じ値
			-a 9
}

proc ビッグシェル全景_海面セット {
	chara 巨大海面 seaseasea \
		-mipmap 3 50000 0 \
		-size 400000 400000 \
		-light_enable \
		-tex w10a_sea \
		w10a_v2_sea02_256_alp_ovl \
		w10a_v2_sea02_128_alp_ovl \
		w10a_v2_sea02_64_alp_ovl \
		w10a_v2_sea02_32_alp_ovl \
		-pos 60000,0,-200000 
}
#endif

