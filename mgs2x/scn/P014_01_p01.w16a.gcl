					-number 3 \
					-status	(d:PUT_MOT_PRESHADE | d:PUT_MOT_WAIT) 				//$w:ステータス

/*
	chara プットオブジェ w18aステージSAKU0 \
		-m d:KMS_NAME_W18A2 -r 0,0,0 -p 10325,-4000,-119000 -s 100,100,100 -l d:LT2_NAME_W18A
	chara プットオブジェ w18aステージSAKU1 \
		-m d:KMS_NAME_W18A2 -r 0,0,0 -p -10325,-4000,-119000 -s 100,100,100 -l d:LT2_NAME_W18A
	chara プットオブジェ w18aステージSAKU2 \
		-m d:KMS_NAME_W18A2 -r 0,1024,0 -p 5500,-1000,-131075 -s 100,100,100 -l d:LT2_NAME_W18A
*/
	chara プットオブジェ w18aステージ天井 \
