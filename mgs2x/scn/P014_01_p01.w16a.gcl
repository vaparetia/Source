#define PETER_X -52200
#define PETER_Z -102125

proc 壊れ物以外の物を置くセット {
	chara プットオブジェ ポスター \
		-m w16a0_poster -p 0,0,0 \
		-r 0,0,0 -s 100,100,100 \
		-l d:LT2_NAME

	chara プットオブジェ Ｃ４ \
		-p (d:PETER_X+638),1000, (d:PETER_Z+300) \
		-r -1024,(1024+2048),0 \
		-m c4_kaitai_a1 \
		-s 100,100,100 \
		-l d:LT2_NAME

	chara プットオブジェ ピーターＣ４_冷却２ \
		-p (d:PETER_X+638),1000, (d:PETER_Z+300) \
		-r -1024,(1024+2048),0 \
		-m c4_kaitai_a1_frost_cm \
		-s 100,100,100 \
//		-f d:PUT_OBJ_CALC_LIGHT \
		-l d:LT2_NAME
}

proc 壊れ物以外の物を置くセット２ {
	chara プットオブジェ 冷却スプレー１ \
		-p (d:PETER_X+250),1112,(d:PETER_Z-450) \
		-r -1024,(1024+284),0 \
		-m cls_sub \
		-s 100,100,100 \
		-l d:LT2_NAME

	chara プットオブジェ 冷却スプレー２ \
		-p (d:PETER_X+500),1112,(d:PETER_Z-800) \
		-r -1024,(1024-796),0 \
		-m cls_sub \
		-s 100,100,100 \
		-l d:LT2_NAME

	chara プットオブジェ センサーＡ１ \
		-p (d:PETER_X+564),1394,(d:PETER_Z-184) \
		-r -34, -571, 1010 \
		-m bombsensor_a \
		-s 100,100,100 \
		-l d:LT2_NAME

	chara プットオブジェ センサーＡ２ \
		-p (d:PETER_X+600),1394,(d:PETER_Z-350) \
		-r 0,(1024+57),0 \
		-m bombsensor_a \
		-s 100,100,100 \
		-l d:LT2_NAME
}


// サウンド
proc サウンドマネージャーセット {
	chara サウンドマネージャー ＳＤマネ -pak -1		// パックをロードしない
}

proc サウンドマネージャー_mesg_1 {
	command セットサウンドコード -c d:SNG_PLAY_06
}

proc サウンドマネージャー_mesg_2 {
	command セットサウンドコード -c d:SNG_FOUTS_S
}

