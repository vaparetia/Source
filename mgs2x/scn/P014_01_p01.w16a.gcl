// フォグ設定
proc フォグ設定 {
	// フォグ
	chara フォグ 霧\
		-c 34, 61, 54 \
		-n -1000 \
		-f 32000
}

proc ｗ１８ａ_フォグ設定 {
	// フォグ
	chara フォグ 霧\
		-c 20,20,30 \
		-n 15000 \
		-f 40000 
}

