// ステージモデル設定
proc ステージモデルセット {
	chara プットオブジェ 食堂 \
		-m d:KMS_NAME0 -r 0,0,0 -p 0,0,0 -s 100,100,100 -l d:LT2_NAME
	chara プットオブジェ 食堂天井 \
		-m d:CEIL_NAME0 -r 0,0,0 -p 0,0,0 -s 100,100,100 -l d:LT2_NAME

	chara プットオブジェ 廊下 \
		-m d:KMS_NAME1 -r 0,0,0 -p 0,0,0 -s 100,100,100 -l d:LT2_NAME
	chara プットオブジェ 廊下天井 \
		-m d:CEIL_NAME1 -r 0,0,0 -p 0,0,0 -s 100,100,100 -l d:LT2_NAME
}

proc ｗ１８ａステージモデルセット {
	chara プットオブジェ w18aステージ０ \
		-m d:KMS_NAME_W18A0 -r 0,0,0 -p 0,0,0 -s 100,100,100 -l d:LT2_NAME_W18A

	chara プットモーションモデル w18aハッチ1F北西 \
		-pos -10170 -4000 -128125 \		//$v:配置座標
		-dir 3794 \				//$i:方向
		-kms d:W18A_HATCH_MDL \			//$s:KMSモデル名
		-mar d:W18A_HATCH_MTN \			//$s:モーションファイル名
		-number 0 \				//$i:基本モーション番号 ... 
		-status	(d:PUT_MOT_PRESHADE | d:PUT_MOT_WAIT) 				//$w:ステータス 

	chara プットモーションモデル w18aハッチ1F西 \
		-pos -10525 -4000 -112579 \		//$v:配置座標
		-dir 302 \				//$i:方向
		-kms d:W18A_HATCH_MDL \			//$s:KMSモデル名
		-mar d:W18A_HATCH_MTN \			//$s:モーションファイル名
		-number 0 \				//$i:基本モーション番号 ... 
		-status	(d:PUT_MOT_PRESHADE | d:PUT_MOT_WAIT) 				//$w:ステータス 

	chara プットモーションモデル w18aハッチ1F中央 \
		-pos 1500 -4000 -133750 \		//$v:配置座標
		-dir 3072 \				//$i:方向
		-kms d:W18A_HATCH_MDL \			//$s:KMSモデル名
		-mar d:W18A_HATCH_MTN \			//$s:モーションファイル名
		-number 0 \				//$i:基本モーション番号 ... 
		-status	(d:PUT_MOT_PRESHADE | d:PUT_MOT_WAIT) 				//$w:ステータス 

	chara プットモーションモデル w18aハッチ1F東 \
		-pos 10170 -4000 -128125 \		//$v:配置座標
		-dir 2350 \				//$i:方向
		-kms d:W18A_HATCH_MDL \			//$s:KMSモデル名
		-mar d:W18A_HATCH_MTN \			//$s:モーションファイル名
		-number 0 \				//$i:基本モーション番号 ... 
		-status	(d:PUT_MOT_PRESHADE | d:PUT_MOT_WAIT) 				//$w:ステータス 

	chara プットモーションモデル w18aハッチ2F西 \
		-pos -10170 -1000 -128125 \		//$v:配置座標
		-dir 3794 \				//$i:方向
		-kms d:W18A_HATCH_MDL \			//$s:KMSモデル名
		-mar d:W18A_HATCH_MTN \			//$s:モーションファイル名
		-number 0 \				//$i:基本モーション番号 ... 
		-status	(d:PUT_MOT_PRESHADE | d:PUT_MOT_WAIT) 				//$w:ステータス 

	chara プットモーションモデル w18aハッチ2F東 \
		-pos 10170 -1000 -128125 \		//$v:配置座標
		-dir 2350 \				//$i:方向
		-kms d:W18A_HATCH_MDL \			//$s:KMSモデル名
		-mar d:W18A_HATCH_MTN \			//$s:モーションファイル名
		-number 0 \				//$i:基本モーション番号 ... 
		-status	(d:PUT_MOT_PRESHADE | d:PUT_MOT_WAIT) 				//$w:ステータス 
/*
	chara プットオブジェ w18aステージHATCH0 \
		-m d:KMS_NAME_W18A1 -r 0,3794,1024 -p -10170,-4000,-128125 -s 100,100,100 -l d:LT2_NAME_W18A
	chara プットオブジェ w18aステージHATCH1 \
		-m d:KMS_NAME_W18A1 -r 0,302,1024 -p -10525,-4000,-112579 -s 100,100,100 -l d:LT2_NAME_W18A
	chara プットオブジェ w18aステージHATCH2 \
		-m d:KMS_NAME_W18A1 -r 0,3072,1024 -p 1500,-4000,-133750 -s 100,100,100 -l d:LT2_NAME_W18A
	chara プットオブジェ w18aステージHATCH3 \
		-m d:KMS_NAME_W18A1 -r 0,2350,1024 -p 10170,-4000,-128125 -s 100,100,100 -l d:LT2_NAME_W18A
	chara プットオブジェ w18aステージHATCH4 \
		-m d:KMS_NAME_W18A1 -r 0,3794,1024 -p 10170,-1000,-128125 -s 100,100,100 -l d:LT2_NAME_W18A
	chara プットオブジェ w18aステージHATCH4 \
		-m d:KMS_NAME_W18A1 -r 0,2350,1024 -p 10170,-1000,-128125 -s 100,100,100 -l d:LT2_NAME_W18A
*/
				chara プットモーションモデル w18a1F東 \
					-pos 10325,-4000,-119000 \		//$v:配置座標
					-dir 0 \				//$i:方向
					-kms d:W18A_SAKU_MDL \			//$s:KMSモデル名
					-mar d:W18A_SAKU_MTN \			//$s:モーションファイル名
