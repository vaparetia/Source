proc ｗ１８ａ_ドアセット {
	// 2001/08/06 Uehara Masatoshi
	// ドアランプの追加（w18a.gclよりコピーなので注意！）
	chara プットオブジェ Ｃ脚方面ドア \ // w17a
		-m w18a_dr00 \
		-r 0 (1327+2048) 0 \
		-p -10450,0,-111650 \
		-l d:LT2_NAME_W18A \
		-s 100 100 100
		@ドアランプ設定 Ｃ脚方面ドアランプ 1326 -9700,0,-110150 0

	chara プットオブジェ Ｅ脚方面ドア上 \ // w19a
		-m w18a_dr00 \
		-r 0 (2769+2048) 0 \
//		-p 10450,0,-111650 \
		-p 9700,0,-110150 \
		-l d:LT2_NAME_W18A \
		-s 100 100 100
		@ドアランプ設定 Ｅ脚方面ドア上ランプ 722 9700,0,-110150 1

	chara プットオブジェ Ｅ脚方面ドア下 \ // w19a
		-m w18a_dr01 \
		-r 0 2769 0 \
		-p 10450,-4000,-111650 \
		-l d:LT2_NAME_W18A \
		-s 100 100 100
		@ドアランプ設定 Ｅ脚方面ドア下ランプ 722 9700,-4000,-110150 1

	chara プットオブジェ Ｇ脚方面ドア \ // w25a
		-m w18a_dr02 \
		-r 0 0 0 \
		-p -3000,500,-134125 \
		-l d:LT2_NAME_W18A \
		-s 100 100 100
		@ドアランプ設定 Ｇ脚方面ドアランプ 0 -3000,500,-134125 0
}

