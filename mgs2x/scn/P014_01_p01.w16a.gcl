#if d:MGS2_DEMO
	#define ステージ切り替え 1	// 0 : 食堂  1 : 沈殿池
#endif
//=============================================================================
// メイン
//=============================================================================

#if d:MGS2_DEMO
//＜↓↓↓同期せよ↓↓↓＞
if(d:ステージ切り替え == 0) {
	print 'w16a light'
	chara マップ 食堂＆トイレ -h d:HZX_NAME -l d:LT2_NAME
} else {
	print 'w18a light'
	chara マップ 食堂＆トイレ -h d:HZX_NAME -l d:LT2_NAME_W18A
}
#else
if(d:ST:P014_11_P04ピーター遭遇１１ポリゴンデモ４終了 <= $w:p_story && \
			$w:p_story < d:ST:P014_12_P05ピーター遭遇１２ポリゴンデモ５開始) {
	chara マップ 食堂＆トイレ -h d:HZX_NAME -l d:LT2_NAME_W18A
} else {
	chara マップ 食堂＆トイレ -h d:HZX_NAME -l d:LT2_NAME
}
#endif

command マップ設定 食堂＆トイレ -set {

//	デモ環境かゲーム環境かで起動を読み分ける。
// ------------------------------------
#if d:MGS2_DEMO

chara デモアクトデバッグ demodebug  -i t:p014_01_p01 -d 'p014_01_p01' -l   \
		-p null_x

		// t01 を再生するとき
//			eval($s:d_num = t01a1D)

	// 2001/08/06 Uehara Masatoshi
	// P014_12_p05(w18a D脚沈殿池)を再生するときは、//をはずして下さい
if(d:ステージ切り替え == 0){
	eval($s:d_num = P014_11_p04)
}else{
	eval($s:d_num = P014_12_p05)
}

#else

// 実際の再生
//-----------------------------------------------------------
	// 実際のデモ再生の方も、ストーリーフラグで変える
	// ゲームステージ(w16a）から来る
	if($w:p_story == d:ST:P014_01_P01ピーター遭遇１ポリゴンデモ１開始) {
		print '$w:p_story = ST:P014_01_P01ピーター遭遇１ポリゴンデモ１開始'

		/* ピーターと初遭遇する */

		// デモ特有の変数代入
		eval($s:d_num = P014_01_p01)

		@デモモデル差し替え処理
		proc デモ再生_P014_01_p01 {
			#if 0
chara デモアクトデバッグ demodebug  -i t:p014_01_p01 -d 'p014_01_p01' -l   \
					-i t:p014_01_p01 -d 'p014_01_p01' -l -s 'p014_01_p01' \
					-next P014_01_p01終了 \
					-p null_x
			#else
				chara demo デモ再生 \
					-i t:p014_01_p01 \
					-p null_x \
					-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
					-next P014_01_p01終了
			#endif
		}

		@デモ再生_P014_01_p01

#if d:USE_WMOVIE_STAGE
// ムービーはメモリ不足で再生できなかったため、wmovie へ飛ばす。
	} else if(d:ST:P014_01_P01ピーター遭遇１ポリゴンデモ１終了 <= $w:p_story && \
					$w:p_story < d:ST:P014_02_M01ピーター遭遇２ムービーデモ１開始) {
		eval($w:p_story = d:ST:P014_02_M01ピーター遭遇２ムービーデモ１開始)
		print '$w:p_story = ST:P014_02_M01ピーター遭遇２ムービーデモ１開始'

		/* ファットマンの紹介映像 */

		// デモ特有の変数代入
		eval($s:d_num = P014_02_m01)

//			chara デバッグポーズ pause 'MOVIE_P014_02_m01' -p P014_02_m01終了		// 01.07.18 山下修正
		chara MOVIE再生 p014_02_m01 -file t:p014_02_m01 -top 0, 36 -size 512, 320 -proc P014_02_m01終了

#endif

	} else if(d:ST:P014_02_M01ピーター遭遇２ムービーデモ１終了 <= $w:p_story && \
					$w:p_story < d:ST:P014_03_P02ピーター遭遇３ポリゴンデモ２開始) {
		eval($w:p_story = d:ST:P014_03_P02ピーター遭遇３ポリゴンデモ２開始)
		print '$w:p_story = ST:P014_03_P02ピーター遭遇３ポリゴンデモ２開始'

		/* プリスキン、ピーターに自己紹介 */

		// デモ特有の変数代入
		eval($s:d_num = P014_03_p02)

		@デモモデル差し替え処理
		proc デモ再生_P014_03_p02 {
			chara demo デモ再生 \
				-i t:p014_03_p02 \
				-p null_x \
				-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
				-next P014_03_p02終了
		}

		@デモ再生_P014_03_p02

#if d:USE_WMOVIE_STAGE
	} else if(d:ST:P014_03_P02ピーター遭遇３ポリゴンデモ２終了 <= $w:p_story && \
					$w:p_story < d:ST:P014_04_M02ピーター遭遇４ムービーデモ２開始) {
		eval($w:p_story = d:ST:P014_04_M02ピーター遭遇４ムービーデモ２開始)
		print '$w:p_story = ST:P014_04_M02ピーター遭遇４ムービーデモ２開始'

		/* オタコンがビッグシェルに来たことを示すムービー */

		// デモ特有の変数代入
		eval($s:d_num = P014_04_m02)

		#if 1
//			chara デバッグポーズ pause 'MOVIE_P014_04_m02' -p P014_04_m02終了		// 01.07.18 山下修正
			chara MOVIE再生 p014_04_m02 -file t:p014_04_m02 -top 0, 36 -size 512, 320 -proc P014_04_m02終了
		#else
			/* ムービー再生キャラ */
			/* P014_04_m02終了 */
		#endif
#endif

// wmovie.gcl に移行  2001.08.13
#if 0
	} else if(d:ST:P014_04_M02ピーター遭遇４ムービーデモ２終了 <= $w:p_story && \
					$w:p_story < d:ST:P014_05_R01ピーター遭遇５無線デモ１開始) {
		eval($w:p_story = d:ST:P014_05_R01ピーター遭遇５無線デモ１開始)
		print '$w:p_story = ST:P014_05_R01ピーター遭遇５無線デモ１開始'

		/* 大佐強制コール　大佐に相談＞爆弾処理していい？ */

		// デモ特有の変数代入
		eval($s:d_num = P014_05_r01)

		@rt_P014_05_R01ピーター遭遇５無線デモ１
		/* P014_05_r01終了 */
		/*
		eval($w:p_story = d:ST:P014_05_R01ピーター遭遇５無線デモ１終了)
		// ゲームへ
		@ゲームステージへ戻る
		@mv_demo1_w16a_0
		*/
#endif
	// ゲーム(w16a)から戻ってくる
	} else if($w:p_story == d:ST:P014_07_M03ピーター遭遇７ムービーデモ３開始) {
		print '$w:p_story = ST:P014_07_M03ピーター遭遇７ムービーデモ３開始'

		/* ファットマンは香水を使う、ムービー */

		// デモ特有の変数代入
		eval($s:d_num = P014_07_m03)

		chara delay ディレイ \
			-time 1 \ 
			-exec{
				#if d:USE_WMOVIE_STAGE
					load 'wmovie'
				#else
					restart
				#endif
			}

	} else if(d:ST:P014_10_P03ピーター遭遇１０ポリゴンデモ３終了 <= $w:p_story && \
					$w:p_story < d:ST:P014_11_P04ピーター遭遇１１ポリゴンデモ４開始) {
		eval($w:p_story = d:ST:P014_11_P04ピーター遭遇１１ポリゴンデモ４開始)
		print '$w:p_story = ST:P014_11_P04ピーター遭遇１１ポリゴンデモ４開始'

		/* カード１をもらう */

		// デモ特有の変数代入
		eval($s:d_num = P014_11_p04)

		@サウンドマネージャーセット
		@サウンドマネージャー_mesg_1

		@デモモデル差し替え処理
		proc デモ再生_P014_11_p04 {
			chara demo デモ再生 \
				-i t:p014_11_p04 \
				-p null_x \
				-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
				-next P014_11_p04終了
		}

		@デモ再生_P014_11_p04

	// セットするステージは w18a のもの。
	// ＜↑↑↑同期せよ↑↑↑＞
	} else if(d:ST:P014_11_P04ピーター遭遇１１ポリゴンデモ４終了 <= $w:p_story && \
			$w:p_story < d:ST:P014_12_P05ピーター遭遇１２ポリゴンデモ５開始) {
		eval($w:p_story = d:ST:P014_12_P05ピーター遭遇１２ポリゴンデモ５開始)
		print '$w:p_story = d:ST:P014_12_P05ピーター遭遇１２ポリゴンデモ５開始'

	/* セキュリティカードの説明 */ 

	// デモ特有の変数代入
	eval($s:d_num = P014_12_p05)

	@デモモデル差し替え処理
	proc デモ再生_P014_12_p05 {
		chara demo デモ再生 \
			-i t:p014_12_p05 \
//			-i t:data_dummy_raiden \
			-p null_x \
			-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
			-next P014_12_p05終了
	}

	@デモ再生_P014_12_p05

	} else if(d:ST:P014_12_P05ピーター遭遇１２ポリゴンデモ５終了 <= $w:p_story && \
					$w:p_story < d:ST:P014_13_P06ピーター遭遇１３ポリゴンデモ６開始) {
		eval($w:p_story = d:ST:P014_13_P06ピーター遭遇１３ポリゴンデモ６開始)
		print '$w:p_story = ST:P014_13_P06ピーター遭遇１３ポリゴンデモ６開始'

		/* プリスキン、ピーターの同道を断る */

		// デモ特有の変数代入
		eval($s:d_num = P014_13_p06)

		@サウンドマネージャーセット
		@サウンドマネージャー_mesg_1

		@デモモデル差し替え処理
		proc デモ再生_P014_13_p06 {
			chara demo デモ再生 \
				-i t:p014_13_p06 \
				-p null_x \
				-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
				-next P014_13_p06終了
		}

		@デモ再生_P014_13_p06

	} else if(d:ST:P014_13_P06ピーター遭遇１３ポリゴンデモ６終了 <= $w:p_story && \
					$w:p_story <= d:ST:P014_14_M04ピーター遭遇１４ムービーデモ４開始) {
		eval($w:p_story = d:ST:P014_14_M04ピーター遭遇１４ムービーデモ４開始)
		print '$w:p_story = ST:P014_14_M04ピーター遭遇１４ムービーデモ４開始'

		/* プリスキンが偽SEALだと語るピーター */

		// デモ特有の変数代入
		eval($s:d_num = P014_14_m04)

		chara delay ディレイ \
			-time 1 \ 
			-exec{
				#if d:USE_WMOVIE_STAGE
					load 'wmovie'
				#else
					restart
				#endif
			}
/*
		#if 1
			chara デバッグポーズ pause 'MOVIE_P014_14_m04' -p P014_14_m04終了
		#else
			/* ムービー再生キャラ */
			/* P014_14_m04終了 */
		#endif
*/

	} else if(d:ST:P014_14_M04ピーター遭遇１４ムービーデモ４終了 <= $w:p_story && \
					$w:p_story < d:ST:P014_15_P07ピーター遭遇１５ポリゴンデモ７開始) {
		eval($w:p_story = d:ST:P014_15_P07ピーター遭遇１５ポリゴンデモ７開始)
		print '$w:p_story = ST:P014_15_P07ピーター遭遇１５ポリゴンデモ７開始'

		/* ピーターと別れる。ゲームへ */

		// デモ特有の変数代入
		eval($s:d_num = P014_15_p07)

		@デモモデル差し替え処理
		proc デモ再生_P014_15_p07 {
			chara demo デモ再生 \
				-i t:p014_15_p07 \
				-p null_x \
				-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
				-next P014_15_p07終了
		}

		@デモ再生_P014_15_p07

	}



#endif

	// デモキャンセルは全てのデモで共通につかう
	chara デモキャンセルチェック デモキャンセル \
		-p demo_cancel

// 以下、諸々セット
//-----------------------------------------------------------
	@常駐キャラ設定						// stdch.hで定義

	//----- 基本設定
	if($s:d_num == P014_12_p05){
		@ｗ１８ａステージモデルセット
		@ｗ１８ａ_フォグ設定
		@ｗ１８ａ_ドアセット
		// 2001/08/06 Uehara Masatoshi
		@壊れライト設定
		@電灯虫設定
//	} else if($s:d_num == P014_10_p03){
//		@ビッグシェル全景_フォグ設定
//		@ビッグシェル全景_空設置
//		@ビッグシェル全景_海面セット
	} else {
		@ステージモデルセット
		@ドア設定
		@壊れ物食堂
		@壊れ物以外の物を置くセット
		if( ($s:d_num == P014_01_p01) || ($s:d_num == P014_03_p02) ){
			@壊れ物以外の物を置くセット２
		}

		@フォグ設定
	}

	// 無線ではシネマスクリーン起動しない
	if($s:d_num != P014_05_r01){
		@シネマスクリーンセット
	}
}


command マップ表示 -show 食堂＆トイレ





//=============================================================================
// プロシージャ
//=============================================================================
// デモデモ再生関連のプロック
//-----------------------------------------------------------
proc null_x {}

proc demo_cancel {
	command StreamStopAll
}

proc P014_01_p01終了 {
	@デモ終了時シネマスクリーンオフ
	mesg デモキャンセルチェック デモキャンセル kill
	#if d:DEMO_SKIP_ENABLE
		eval($w:p_story = )
	#else
		print '$w:p_story = d:ST:P014_01_P01ピーター遭遇１ポリゴンデモ１終了'
		eval($w:p_story = d:ST:P014_01_P01ピーター遭遇１ポリゴンデモ１終了)
	#endif

	chara delay ディレイ \
		-time 1 \ 
		-exec{
			#if d:USE_WMOVIE_STAGE
				load 'wmovie'
			#else
				restart
			#endif
		}
}

#if d:USE_WMOVIE_STAGE
proc P014_02_m01終了 {
	@デモ終了時シネマスクリーンオフ
	#if d:DEMO_SKIP_ENABLE
		print '$w:p_story = d:ST:P014_04_M02ピーター遭遇４ムービーデモ２終了'
		eval($w:p_story = d:ST:P014_04_M02ピーター遭遇４ムービーデモ２終了)
	#else
		eval($w:p_story = d:ST:P014_02_M01ピーター遭遇２ムービーデモ１終了)
	#endif
	restart
}
#endif

proc P014_03_p02終了 {
	@デモ終了時シネマスクリーンオフ
	mesg デモキャンセルチェック デモキャンセル kill
	#if d:DEMO_SKIP_ENABLE
		print '$w:p_story = d:ST:P014_04_M02ピーター遭遇４ムービーデモ２終了'
		eval($w:p_story = d:ST:P014_04_M02ピーター遭遇４ムービーデモ２終了)
	#else
		print '$w:p_story = d:ST:P014_03_P02ピーター遭遇３ポリゴンデモ２終了'
		eval($w:p_story = d:ST:P014_03_P02ピーター遭遇３ポリゴンデモ２終了)
	#endif

	chara delay ディレイ \
		-time 1 \ 
		-exec{
			#if d:USE_WMOVIE_STAGE
				load 'wmovie'
			#else
				restart
			#endif
		}
}

#if d:USE_WMOVIE_STAGE
proc P014_04_m02終了 {
	@デモ終了時シネマスクリーンオフ
	eval($w:p_story = d:ST:P014_04_M02ピーター遭遇４ムービーデモ２終了)
	restart
}
#endif

