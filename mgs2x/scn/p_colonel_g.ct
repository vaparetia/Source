	}
	talk 大佐 標準 -m {
		 [PC_変装＿接触脱ぎ１__g:大佐_000_1]
		//変装していても敵と接触すると
		//野戦服が装備から外れてしまう。
		//気をつけてくれ。
	}
}//v
}//d
//一回目のみ t //e
//resource PC_変装＿接触脱ぎ２
proc rp_PC_変装＿接触脱ぎ２:03  {
vox t:vc263341 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_変装＿接触脱ぎ２__g:ローズ_000]
		//その服、きっとサイズがあってないのね。
	}
	talk ライデン 標準 -m {
		 [PC_変装＿接触脱ぎ２__g:ライデン_001]
		//ああ。
		//実はかなりきついんだ……。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト＿是
@rp_キテレツさん＿否１＿なんだこいつ系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_変装＿接触脱ぎ２__g:大佐_002]
		//そうか。君よりもむしろローズ君に
		//着てもらいたいところだな。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_変装＿接触脱ぎ２__g:ローズ_003]
		//はい！？
	}
	talk ライデン 標準 -m {
		 [PC_変装＿接触脱ぎ２__g:ライデン_004]
		//大佐……。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト＿是
@rp_邪道外道＿否１＿サイテー系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_変装＿接触脱ぎ２__g:大佐_005]
		//冗談だ。
		//ライデン、任務に戻れ。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_セクハラ＿否１＿ワガママ系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_変装＿接触脱ぎ２__g:ローズ_006]
		//信じられない……。
	}
}//v
}//d

//激しい行動をとると脱げる h //e
