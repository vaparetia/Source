	talk 大佐 標準 -m {
		 [PC_Ｃ脚女子トイレピーター前__g:大佐_009]
		//……君の気持ちもよくわかるがな……。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否

