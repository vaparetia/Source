	}
	talk 大佐 標準 -m {
		 [PC_忍者登場前＿ヘリポート__g:大佐_000_1]
		//ライデン、大統領救出任務に戻れ。
		//まだ調べていないシェル１中央棟に
		//向かうんだ。
	}
}//v
