		 [PC_Ｅ脚オルガ__g:大佐_001]
		//オルガ・ゴルルコビッチ。
		//あの男の言う通り、
		//ロシア私兵部隊のリーダーだ。
	}
	talk ライデン 標準 -m {
		 [PC_Ｅ脚オルガ__g:ライデン_002]
		//他には？
	}
	talk 大佐 標準 -m {
		 [PC_Ｅ脚オルガ__g:大佐_003]
		//他？
	}
	talk ライデン 標準 -m {
		 [PC_Ｅ脚オルガ__g:ライデン_004]
		//ああ。他には？
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_Ｅ脚オルガ__g:ローズ_005]
		//どうしてそんなに気にするの？
	}
	talk ライデン 標準 -m {
