proc rp_PC_エルード２の１:03  {
vox t:vc260361 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エルード２の１__g:大佐_000]
		//エルード中も手すりにぶらさがりながら
		//左右に移動出来る。敵の死角に入った
		//まま移動することも可能だ。
	}
}//v
}//d
//＊ムービー t //e
