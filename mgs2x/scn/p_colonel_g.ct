	talk 大佐 標準 -m {
		 [PC_エルード２の２__g:大佐_000]
		//エルードから這い上がる時は
		//もう一度△ボタンを押せばいい。
	}
}//v
}//d
//＊ムービー t //e
//resource PC_エルード３の１
proc rp_PC_エルード３の１:03  {
vox t:vc260381 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エルード３の１__g:大佐_000]
		//エルード中、ＬＩＦＥゲージの
		//下に握力ゲージが表示される。
	}
	talk 大佐 標準 -m {
		 [PC_エルード３の１__g:大佐_001]
		//握力ゲージは君の握力を表している。
		//エルードしている間、時間と共に
		//少しずつ減っていく。
	}
	talk 大佐 標準 -m {
		 [PC_エルード３の１__g:大佐_001_1]
		//握力ゲージは君の握力を表している。
		//エルードしている間、時間と共に
		//少しずつ減っていく。
	}
}//v
}//d
//＊ムービー t //e
