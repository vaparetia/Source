*/

proc rpb_PC_敵武器使用不可２:03  {
	talk ライデン 標準 -m {
		 [PC_敵武器使用不可２__g:ライデン_000]
		//ああ、あれならわかる。
	}
}//d
//resource PC_敵武器使用不可３
proc rp_PC_敵武器使用不可３:03  {
vox t:vc260481 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_敵武器使用不可３__g:大佐_000]
		//アイテムボックスの中に入っている
		//アイテムは自由に使用できる。
	}
	talk 大佐 標準 -m {
		 [PC_敵武器使用不可３__g:大佐_001]
		//武器と装備品はアイテムボックスから
		//調達するんだ。
	}
}//v
}//d

//倒れた敵兵について h //e
//・死体引きずり方法 h //e
//resource PC_死体隠せ
proc rp_PC_死体隠せ:03  {
vox t:vc260491 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_死体隠せ__g:大佐_000]
		//倒した敵をそのままにしておくのは
		//危険だ。仲間が倒されたのを知れば
		//敵は当然警戒を強化してくるだろう。
	}
	talk 大佐 標準 -m {
		 [PC_死体隠せ__g:大佐_000_1]
		//倒した敵をそのままにしておくのは
		//危険だ。仲間が倒されたのを知れば
		//敵は当然警戒を強化してくるだろう。
	}
	talk 大佐 標準 -m {
		 [PC_死体隠せ__g:大佐_001]
		//敵を倒したら、すぐにその体を
		//人目につかない場所に隠すんだ。
	}
}//v
}//d
//resource PC_死体引きずり方法１
proc rp_PC_死体引きずり方法１:03  {
vox t:vc260501 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_死体引きずり方法１__g:大佐_000]
		//倒れた敵の体は引きずって移動させる
		//ことが出来る。
	}
}//v
}//d
//＊ムービー t //e
//resource PC_死体引きずり方法２
proc rp_PC_死体引きずり方法２:03  {
vox t:vc260511 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_死体引きずり方法２__g:大佐_000]
		//やり方は、こうだ。まず倒れた敵の近く
		//で、武器を装備せずに□ボタンを押して、
		//敵の体を抱える。
	}
	talk 大佐 標準 -m {
		 [PC_死体引きずり方法２__g:大佐_000_1]
		//やり方は、こうだ。まず倒れた敵の近く
		//で、武器を装備せずに□ボタンを押して、
		//敵の体を抱える。
	}
	talk 大佐 標準 -m {
		 [PC_死体引きずり方法２__g:大佐_001]
		//□ボタンを押している間、敵を引きずり
		//ながら移動することが出来る。
		//体を下ろすには□ボタンを離せばいい。
	}
	talk 大佐 標準 -m {
		 [PC_死体引きずり方法２__g:大佐_001_1]
		//□ボタンを押している間、敵を引きずり
		//ながら移動することが出来る。
		//体を下ろすには□ボタンを離せばいい。
	}
}//v
}//d


