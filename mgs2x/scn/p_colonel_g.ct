proc rp_PC_人質部屋＿敵兵定時連絡２:03  {
vox t:vc267151 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[PC_人質部屋＿敵兵定時連絡２__g:大佐_000]
		//人質の見張りをしている敵兵士は
		//定期的に仲間と連絡をとりあっている。
	}
	talk 大佐 標準 -m {
		[PC_人質部屋＿敵兵定時連絡２__g:大佐_001]
		//定期連絡が途絶えることは君の潜入が
		//発覚することを意味する。そのエリアで
		//敵に囲まれれば到底助からないぞ。
	}
	talk 大佐 標準 -m {
		[PC_人質部屋＿敵兵定時連絡２__g:大佐_001_1]
		//定期連絡が途絶えることは君の潜入が
		//発覚することを意味する。そのエリアで
		//敵に囲まれれば到底助からないぞ。
	}
	talk 大佐 標準 -m {
		[PC_人質部屋＿敵兵定時連絡２__g:大佐_002]
		//そのエリアでは敵の無線機を壊したり
		//チャフを使って定期連絡を妨害しては
		//ならない。いいな。
	}
}//v
}//d

