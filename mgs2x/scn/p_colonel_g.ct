	talk ローズ 標準 -m {
		 [PC_ファットマン戦後＿最終爆弾ズバリ__g:ローズ_009]
		//……。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ファットマン戦後＿最終爆弾ズバリ__g:大佐_010]
		//ライデン、そう言わずに
		//とりあえず調べてみたらどうだ。
	}
}//v
}//d


//★P035_01_R01ファットマン爆弾解体終了１無線デモ１終了＜フラグ＜P036_01_P01忍者登場１ポリゴンデモ１開始 d //e
