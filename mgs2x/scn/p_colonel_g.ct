//核兵器による電磁波攻撃について h //e
//resource PC_エイムズ死後＿ＮＥＭＰ
proc rp_PC_エイムズ死後＿ＮＥＭＰ:03  {
vox t:vc266111 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿ＮＥＭＰ__g:大佐_000]
		//奴等がマンハッタン上空で核爆発を
		//起こせば大変なことになる。
	}
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿ＮＥＭＰ__g:大佐_001]
		//高々度核爆発のエネルギーは大部分が
		//ガンマ線となって放出される。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿ＮＥＭＰ__g:大佐_002]
		//これが大気圏内の二次反応により強大な電磁パルスを発生させるんだ。
	}
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿ＮＥＭＰ__g:大佐_002_1]
		//これが大気圏内の二次反応により強大な電磁パルスを発生させるんだ。
	}
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿ＮＥＭＰ__g:大佐_003]
		//パルス持続時間は５００ナノ秒という
		//短時間だがその強度は瞬間的に
		//５兆メガワットを超える。
	}
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿ＮＥＭＰ__g:大佐_003_1]
		//パルス持続時間は５００ナノ秒という
		//短時間だがその強度は瞬間的に
		//５兆メガワットを超える。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿ＮＥＭＰ__g:大佐_004]
		//この電磁パルスによってアンテナや
		//ケーブル等に高電圧のサージが発生し、
		//急激な電圧上昇が回路を焼き切る。
	}
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿ＮＥＭＰ__g:大佐_004_1]
		//この電磁パルスによってアンテナや
		//ケーブル等に高電圧のサージが発生し、
		//急激な電圧上昇が回路を焼き切る。
	}
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿ＮＥＭＰ__g:大佐_005]
		//核爆発によるスカラー電磁波は
		//通常の電磁波よりも貫通性が高い。
		//民生の電磁防護機器など役にはたたん。
	}
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿ＮＥＭＰ__g:大佐_005_1]
		//核爆発によるスカラー電磁波は
		//通常の電磁波よりも貫通性が高い。
		//民生の電磁防護機器など役にはたたん。
	}
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿ＮＥＭＰ__g:大佐_006]
		//その効果も半径数千キロに及ぶと
		//いわれている。ニューヨーク全域の
		//電子機器が完全に破壊されるだろうな。
	}
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿ＮＥＭＰ__g:大佐_006_1]
		//その効果も半径数千キロに及ぶと
		//いわれている。ニューヨーク全域の
		//電子機器が完全に破壊されるだろうな。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_エイムズ死後＿ＮＥＭＰ__g:ローズ_007]
		//そんなことになったら……
	}
	talk ライデン 標準 -m {
		 [PC_エイムズ死後＿ＮＥＭＰ__g:ライデン_008]
		//世界的な大混乱は避けらない。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト＿是
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿ＮＥＭＰ__g:大佐_009]
		//核兵器による電磁波攻撃は古くから
		//研究されていた。
	}
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿ＮＥＭＰ__g:大佐_009_1]
		//核兵器による電磁波攻撃は古くから
		//研究されていた。
	}
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿ＮＥＭＰ__g:大佐_010]
		//１９６２年、南太平洋ジョンストン島で
		//行われたスターフィッシュ計画もそうだ。
	}
	talk ライデン 標準 -m {
		 [PC_エイムズ死後＿ＮＥＭＰ__g:ライデン_011]
		//あれは高々度核爆発の無線や
		//レーダーに対する影響を調べるため
		//じゃなかったのか？
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿ＮＥＭＰ__g:大佐_012]
		//それは表向きの話だ。
		//電磁波兵器の開発はその前のアーガス
		//計画の時から始まっていた。
	}
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿ＮＥＭＰ__g:大佐_012_1]
		//それは表向きの話だ。
		//電磁波兵器の開発はその前のアーガス
		//計画の時から始まっていた。
	}
	talk ライデン 標準 -m {
		 [PC_エイムズ死後＿ＮＥＭＰ__g:ライデン_013]
		//今、奴等はそれを実践しようと
		//している……？
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿ＮＥＭＰ__g:大佐_014]
		//我が国の心臓部を標的にしてな。
		//奴等に核を撃たせてはならん。
		//急ぐんだ、ライデン。
	}
}//v
}//d

//忍者について h //e
