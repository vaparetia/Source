//武器・アイテム装備方法 h //e
//resource PC_武器装備品装備法１
proc rp_PC_武器装備品装備法１:03  {
vox d:_vc265061 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_武器装備品装備法１__g:大佐_000]
		//武器を装備するには、Ｒ２ボタンを
		//押しっぱなしにして武器ウィンドウを
		//開け。武器のアイコンが表示される。
	}
	talk 大佐 標準 -m {
		 [PC_武器装備品装備法１__g:大佐_000_1]
		//武器を装備するには、Ｒ２ボタンを
		//押しっぱなしにして武器ウィンドウを
		//開け。武器のアイコンが表示される。
	}
	talk 大佐 標準 -m {
		 [PC_武器装備品装備法１__g:大佐_001]
		//その中から使いたい武器を
		//左スティックの上下で選んで
		//右下に合わせるんだ。
	}
	talk 大佐 標準 -m {
		 [PC_武器装備品装備法１__g:大佐_001_1]
		//その中から使いたい武器を
		//左スティックの上下で選んで
		//右下に合わせるんだ。
	}
@rp_うなづきデフォルト＿是
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_武器装備品装備法１__g:大佐_002]
		//ＶＲ訓練と少し違うのは同じ系統の
		//武器をいくつか持っている場合、
		//アイコンが横に並んで表示されることだ。
	}
	talk 大佐 標準 -m {
		 [PC_武器装備品装備法１__g:大佐_002_1]
		//ＶＲ訓練と少し違うのは同じ系統の
		//武器をいくつか持っている場合、
		//アイコンが横に並んで表示されることだ。
	}
	talk 大佐 標準 -m {
		 [PC_武器装備品装備法１__g:大佐_003]
		//横に並んでいる武器の中から使いたい
		//ものを左スティックの左右で選んで
		//一番右に合わせろ。
	}
	talk 大佐 標準 -m {
		 [PC_武器装備品装備法１__g:大佐_003_1]
		//横に並んでいる武器の中から使いたい
		//ものを左スティックの左右で選んで
		//一番右に合わせろ。
	}
	talk 大佐 標準 -m {
		 [PC_武器装備品装備法１__g:大佐_004]
		//そこでＲ２ボタンを離せば、
		//君の手に選んだ武器が握られている
		//はずだ。
	}
	talk 大佐 標準 -m {
