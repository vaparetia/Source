	}
}//v
}//d
//一回目のみ t //e
//resource PC_海鳥糞２
proc rp_PC_海鳥糞２:03  {
vox t:vc265231 {
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_海鳥糞２__g:大佐_000]
		//二年前のタンカー事件で流出した
		//原油には環境ホルモンが多量に
		//含まれていた。
	}
	talk 大佐 標準 -m {
		 [PC_海鳥糞２__g:大佐_000_1]
		//二年前のタンカー事件で流出した
		//原油には環境ホルモンが多量に
		//含まれていた。
	}
	talk 大佐 標準 -m {
		 [PC_海鳥糞２__g:大佐_001]
		//それを飲み込んだ魚を食べている
		//海鳥の体内ではさらに環境ホルモンが
		//濃縮されている。
	}
	talk 大佐 標準 -m {
		 [PC_海鳥糞２__g:大佐_001_1]
		//それを飲み込んだ魚を食べている
		//海鳥の体内ではさらに環境ホルモンが
		//濃縮されている。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_海鳥糞２__g:大佐_002]
		//それがどのような結果を生むのかは
		//いまだ調査中で結果は出ていない。
	}
	talk 大佐 標準 -m {
		 [PC_海鳥糞２__g:大佐_003]
		//海上の原油を処理し終わったとしても
		//それで環境回復が終了するわけでは
		//ないということだ。
	}
	talk 大佐 標準 -m {
		 [PC_海鳥糞２__g:大佐_003_1]
		//海上の原油を処理し終わったとしても
		//それで環境回復が終了するわけでは
		//ないということだ。
	}
}//v
}//d


//Ｆ脚倉庫 d //e
//武器取得後 h //e
//resource PC_Ｆ脚武器入手後
proc rp_PC_Ｆ脚武器入手後:03  {
vox t:vc265241 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_Ｆ脚武器入手後__g:大佐_000]
		//ライデン、武器を手に入れたな。
