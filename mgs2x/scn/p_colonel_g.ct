//おもしろ追加
//resource PC_マイク入手時ＣＡＬＬ 
proc rp_PC_マイク入手時ＣＡＬＬ:03  {
vox t:vc263252 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[PC_マイク入手時ＣＡＬＬ__g:大佐_000]
		//指向性マイクを手に入れたな。
		//それで人質の心音を聞くことが出来る。
	}
	talk 大佐 標準 -m {
		[PC_マイク入手時ＣＡＬＬ__g:大佐_001]
		//エイムズは心臓にペースメイカーを埋め
		//込んでいるらしい。心音が違うはずだ。
		//それを指向性マイクで聞き分けるんだ。
	}
	talk 大佐 標準 -m {
		[PC_マイク入手時ＣＡＬＬ__g:大佐_001_1]
		//エイムズは心臓にペースメイカーを埋め
		//込んでいるらしい。心音が違うはずだ。
		//それを指向性マイクで聞き分けるんだ。
	}
	talk 大佐 標準 -m {
		[PC_マイク入手時ＣＡＬＬ__g:大佐_001_2]
		//エイムズは心臓にペースメイカーを埋め
		//込んでいるらしい。心音が違うはずだ。
		//それを指向性マイクで聞き分けるんだ。
	}
}//v
}//d


