//デフォルト操作説明系 d //e

//プラント外部でリモコン装備時 h //e
//resource PC_リモコンミサイル使えない１
proc rp_PC_リモコンミサイル使えない１:03  {
vox t:vc266261 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_リモコンミサイル使えない１__g:大佐_000]
		//ライデン、リモコンミサイルは
		//『ビッグ・シェル』内部でしか
		//使えないぞ。
	}
}//v
}//d
//一回目のみ t //e
//resource PC_リモコンミサイル使えない２
proc rp_PC_リモコンミサイル使えない２:03  {
vox t:vc266271 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_リモコンミサイル使えない２__g:ライデン_000]
		//なぜだ？
	}
	talk 大佐 標準 -m {
		 [PC_リモコンミサイル使えない２__g:大佐_001]
		//妨害電波だ。『ビッグ・シェル』
		//周辺一帯に電子妨害がかけられている。
	}
	talk ライデン 標準 -m {
		 [PC_リモコンミサイル使えない２__g:ライデン_002]
		//テロリスト達が？
	}
	talk 大佐 標準 -m {
		 [PC_リモコンミサイル使えない２__g:大佐_003]
		//おそらくな。我々がＵＡＶ等で偵察を
		//行うのを阻止するつもりなのだろう。
	}
	talk ライデン 標準 -m {
		 [PC_リモコンミサイル使えない２__g:ライデン_004]
		//しかし奴等も無線やサイファーを
		//使っている？
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_リモコンミサイル使えない２__g:大佐_005]
		//当然だ。自分達で使用する周波数帯に
		//まで妨害をかけるわけがない。影響を
		//受けるのは君のリモコンミサイルだけだ。
	}
	talk 大佐 標準 -m {
		 [PC_リモコンミサイル使えない２__g:大佐_005_1]
		//当然だ。自分達で使用する周波数帯に
		//まで妨害をかけるわけがない。影響を
		//受けるのは君のリモコンミサイルだけだ。
	}
	talk 大佐 標準 -m {
		 [PC_リモコンミサイル使えない２__g:大佐_006]
		//だが幸いなことに妨害電波はそれほど
		//強くない。
	}
	talk 大佐 標準 -m {
		 [PC_リモコンミサイル使えない２__g:大佐_007]
		//『ビッグ・シェル』内部なら問題なく
		//リモコンミサイルも使えるはずだ。
	}
}//v
}//d

