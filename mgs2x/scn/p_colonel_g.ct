	talk ローズ 標準 -m {
		 [PC_人質＿人質ぱんつ__g:ローズ_007]
		//なんですって！？
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_人質＿人質ぱんつ__g:大佐_008]
		//あ、いや……。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_セクハラ＿否１＿ワガママ系デフォルト 100
	talk ローズ 標準 -m {
