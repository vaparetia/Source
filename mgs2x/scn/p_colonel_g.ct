//銃は撃つと音がする注意 h //e
//resource PC_銃入手注意
proc rp_PC_銃入手注意:03  {
vox t:vc262651 {
@rp_つっこまれ＿是１＿なんで知ってるんだ系デフォルト 100
@rp_うなづきデフォルト＿否
	talk 大佐 標準 -m {
		 [PC_銃入手注意__g:大佐_000]
		//銃を手に入れたな。
	}
	talk ライデン 標準 -m {
		 [PC_銃入手注意__g:ライデン_001]
		//ああ。プリスキンがくれた。
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_銃入手注意__g:大佐_002]
		//あの男は信用できんが……
		//銃自体は信用しても良いだろう。
	}
	talk 大佐 標準 -m {
		 [PC_銃入手注意__g:大佐_003]
		//だがその銃はサプレッサーを装着して
		//いない。撃てば当然銃声がするぞ。
		//銃声を敵に聞かれれば発見されてしまう。
	}
	talk 大佐 標準 -m {
		 [PC_銃入手注意__g:大佐_003_1]
		//だがその銃はサプレッサーを装着して
		//いない。撃てば当然銃声がするぞ。
		//銃声を敵に聞かれれば発見されてしまう。
	}
	talk 大佐 標準 -m {
		 [PC_銃入手注意__g:大佐_003_2]
		//だがその銃はサプレッサーを装着して
		//いない。撃てば当然銃声がするぞ。
		//銃声を敵に聞かれれば発見されてしまう。
	}
	talk 大佐 標準 -m {
		 [PC_銃入手注意__g:大佐_004]
		//潜入任務の基本は隠密行動だ。まず銃を
		//使うような局面に陥らないことをこころ
		//がけろ。戦闘は可能な限り避けるんだ。
	}
	talk 大佐 標準 -m {
		 [PC_銃入手注意__g:大佐_004_1]
		//潜入任務の基本は隠密行動だ。まず銃を
		//使うような局面に陥らないことをこころ
		//がけろ。戦闘は可能な限り避けるんだ。
	}
	talk 大佐 標準 -m {
		 [PC_銃入手注意__g:大佐_004_2]
		//潜入任務の基本は隠密行動だ。まず銃を
		//使うような局面に陥らないことをこころ
		//がけろ。戦闘は可能な限り避けるんだ。
	}
}//v
}//d



//★P011_01_R01ＢＣ連絡橋ＣＡＬＬ１無線デモ１終了＜フラグ＜P012_01_P01フォーチュン遭遇１ポリゴンデモ１開始 d //e
//フォーチュン対ＳＥＡＬＳの音 h //e
//resource PC_フォーチュン対ＳＥＡＬＳ１
proc rp_PC_フォーチュン対ＳＥＡＬＳ１:03  {
vox t:vc262661 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_フォーチュン対ＳＥＡＬＳ１__g:ライデン_000]
		//大佐、あの音は！？
	}
	talk 大佐 標準 -m {
		 [PC_フォーチュン対ＳＥＡＬＳ１__g:大佐_001]
		//ＳＥＡＬ１０と大統領が何者かに
		//襲われているに違いない。
	}
	talk ライデン 標準 -m {
		 [PC_フォーチュン対ＳＥＡＬＳ１__g:ライデン_002]
		//デッドセルか！？
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_フォーチュン対ＳＥＡＬＳ１__g:大佐_003]
		//わからん。だがおそらくは……。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_フォーチュン対ＳＥＡＬＳ１__g:ローズ_004]
		//ジャック……。
	}
	talk ライデン 標準 -m {
		 [PC_フォーチュン対ＳＥＡＬＳ１__g:ライデン_005]
		//ああ……。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_フォーチュン対ＳＥＡＬＳ１__g:大佐_006]
		//迷っている暇はない。
		//急ぐんだ、ライデン！
	}
}//v
}//d


