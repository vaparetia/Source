	talk ライデン 標準 -m {
		 [PC_Ｆ脚武器入手後__g:ライデン_001]
		//なぜこんなところに武器が……？
		//この『ビッグ・シェル』はただの
		//海洋除染施設のはずだろう？
	}
	talk ライデン 標準 -m {
		 [PC_Ｆ脚武器入手後__g:ライデン_001_1]
		//なぜこんなところに武器が……？
		//この『ビッグ・シェル』はただの
		//海洋除染施設のはずだろう？
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_Ｆ脚武器入手後__g:ローズ_002]
		//テロリストが持ち込んだんじゃないの？
