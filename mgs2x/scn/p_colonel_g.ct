//グロックうんちく h //e
//resource PC_ファットマン戦＿グロック
proc rp_PC_ファットマン戦＿グロック:03  {
vox t:vc265931 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿グロック__g:大佐_000]
		//ファットマンが持っているのは
		//グロック１８。グロック１７を
		//フルオート化したマシンピストルだ。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿グロック__g:大佐_001]
		//毎秒２０発の９ｍｍ弾を発射する。
		//弾幕を張られると厄介だぞ。
	}
	talk ライデン 標準 -m {
		 [PC_ファットマン戦＿グロック__g:ライデン_002]
		//だが元々マシンピストルは
		//要人警護部隊で使われるものだろう？
		//テロリストの足を止めるために？
	}
	talk ライデン 標準 -m {
		 [PC_ファットマン戦＿グロック__g:ライデン_002_1]
		//だが元々マシンピストルは
		//要人警護部隊で使われるものだろう？
		//テロリストの足を止めるために？
	}
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿グロック__g:大佐_003]
		//そうだ。携帯可能な大火力としてな。
	}
	talk ライデン 標準 -m {
		 [PC_ファットマン戦＿グロック__g:ライデン_004]
		//そんなものを、しかも片手で扱うなんて？
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿グロック__g:大佐_005]
		//奴はデッドセルだぞ。
	}
	talk ライデン 標準 -m {
		 [PC_ファットマン戦＿グロック__g:ライデン_006]
		//……。
	}
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿グロック__g:大佐_007]
		//それにあんなものを着て動き回れるんだ。
		//筋力には自信があるんだろう。
	}
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿グロック__g:大佐_007_1]
		//それにあんなものを着て動き回れるんだ。
		//筋力には自信があるんだろう。
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿グロック__g:大佐_008]
		//正面から撃ち合うような真似はするな。
		//リロードの隙をついて攻撃するんだ。
	}
}//v
}//d

