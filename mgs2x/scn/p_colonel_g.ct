vox t:vc264681 {
	@rpb_PC_流血説明１
}//v
}//d
*/

proc rpb_PC_流血説明１:03  {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_流血説明１__g:大佐_000]
		//君にはナノマシンが混合された
		//人工血液が使用されている。
	}
	talk ライデン 標準 -m {
		 [PC_流血説明１__g:ライデン_001]
		//俺のオリジナルは？
	}
	talk 大佐 標準 -m {
		 [PC_流血説明１__g:大佐_002]
		//冷凍保存している。
		//帰還後に入れ替える手筈だ。
	}
}//d
//無線機ウィンドウにライデンが出血しているゲーム映像。足下に赤い血が流血している。 t //e
//resource PC_流血説明２
proc rp_PC_流血説明２:03  {
vox t:vc264691 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_流血説明２__g:大佐_000]
		//ＬＩＦＥゲージが赤くなるまで減ると
		//血が止まらなくなる。血痕を敵に
		//追跡される恐れがあるぞ。注意するんだ。
	}
	talk 大佐 標準 -m {
		 [PC_流血説明２__g:大佐_000_1]
		//ＬＩＦＥゲージが赤くなるまで減ると
		//血が止まらなくなる。血痕を敵に
		//追跡される恐れがあるぞ。注意するんだ。
	}
