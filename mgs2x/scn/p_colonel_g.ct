//戦闘方法 h //e
//resource PC_エマ手つなぎ＿基本戦法１
proc rp_PC_エマ手つなぎ＿基本戦法１:03  {
vox t:vc264291 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エマ手つなぎ＿基本戦法１__g:大佐_000]
		//エマの手を引いている間、君は武器を
		//手に持つことが出来なくなる。攻撃を
		//行うにはエマから手を離すしかない。
	}
	talk 大佐 標準 -m {
		 [PC_エマ手つなぎ＿基本戦法１__g:大佐_000_1]
		//エマの手を引いている間、君は武器を
		//手に持つことが出来なくなる。攻撃を
		//行うにはエマから手を離すしかない。
	}
	talk 大佐 標準 -m {
		 [PC_エマ手つなぎ＿基本戦法１__g:大佐_001]
		//敵が現れたらまずエマを安全な場所に
		//隠せ。そして敵を排除してから
		//彼女を迎えに行くんだ。
	}
	talk 大佐 標準 -m {
