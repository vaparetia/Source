		//敵が現れたらまずエマを安全な場所に
		//隠せ。そして敵を排除してから
		//彼女を迎えに行くんだ。
	}
}//v
}//d


//★P062_08_P04エマとＡＩ８ポリゴンデモ４終了＜フラグ＜P063_01_P01カード五１ポリゴンデモ１開始 d //e

//虫エリア h //e
