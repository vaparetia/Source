//resource PC_エイムズ探せ＿シェル１中央棟＿Ｂ１
proc rp_PC_エイムズ探せ＿シェル１中央棟＿Ｂ１:03  {
vox t:vc266991 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エイムズ探せ＿シェル１中央棟＿Ｂ１__g:大佐_000]
		//エイムズは今君がいるシェル１中央棟
		//Ｂ１の集会場に捕らえられている。
	}
	talk 大佐 標準 -m {
		 [PC_エイムズ探せ＿シェル１中央棟＿Ｂ１__g:大佐_001]
		//集会場に入るには網膜センサーを使った
		//セキュリティで守られた扉を通るしか
		//ないようだ。
	}
