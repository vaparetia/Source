*/

proc rpb_PC_海底ドック昇降機前ノード接続後２:03  {
	talk ライデン 標準 -m {
		 [PC_海底ドック昇降機前ノード接続後２__g:ライデン_000]
		//待つのは苦手だ。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_海底ドック昇降機前ノード接続後２__g:ローズ_001]
		//そうね。待たされるのはいつも
		//私の方だった。
	}
	@rpd_大佐顔表示
@rp_つっこまれ＿是１＿なんで知ってるんだ系デフォルト 100
@rp_うなづきデフォルト＿否
	talk 大佐 標準 -m {
		 [PC_海底ドック昇降機前ノード接続後２__g:大佐_002]
		//時計を見るのも苦手なのか？
		//とにかく昇降機が下りてくるまで
		//隠れているんだ。
	}
	talk 大佐 標準 -m {
		 [PC_海底ドック昇降機前ノード接続後２__g:大佐_002_1]
		//時計を見るのも苦手なのか？
		//とにかく昇降機が下りてくるまで
		//隠れているんだ。
	}
}//d

