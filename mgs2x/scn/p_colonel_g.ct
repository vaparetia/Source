//ローズに爆弾位置を教えてもらった場合 h //e
//resource PC_忍者登場前＿ローズ助けられ
proc rp_PC_忍者登場前＿ローズ助けられ:03  {
vox t:vc263221 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_忍者登場前＿ローズ助けられ__g:ローズ_000]
		//ジャック？
	}
	talk ライデン 標準 -m {
		 [PC_忍者登場前＿ローズ助けられ__g:ライデン_001]
		//……なんだ？
	}
	talk ローズ 標準 -m {
		 [PC_忍者登場前＿ローズ助けられ__g:ローズ_002]
		//またとぼけて。
	}
	talk ライデン 標準 -m {
		 [PC_忍者登場前＿ローズ助けられ__g:ライデン_003]
		//……わかったよ。確かに爆弾は君の
		//言った場所に仕掛けてあった。君が
		//正しかった。君のおかげで助かった！
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_セクハラ＿否１＿ワガママ系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_忍者登場前＿ローズ助けられ__g:ローズ_004]
		//わかればよろしい。
	}
	talk ライデン 標準 -m {
		 [PC_忍者登場前＿ローズ助けられ__g:ライデン_005]
		//しかし意外だったよ。
		//本当に君の言った通りだったとは……。
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_忍者登場前＿ローズ助けられ__g:ローズ_006]
		//ふーん。
		//それ、私は役に立たないって思って
		//たってこと？
	}
	talk ライデン 標準 -m {
		 [PC_忍者登場前＿ローズ助けられ__g:ライデン_007]
		//いや、そういうわけじゃないが。
		//女の勘って奴はあなどれないな、と。
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_セクハラ＿否１＿ワガママ系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_忍者登場前＿ローズ助けられ__g:ローズ_008]
		//その言い方、何か女性差別的。
	}
	talk ライデン 標準 -m {
		 [PC_忍者登場前＿ローズ助けられ__g:ライデン_009]
		//いちいち突っかからないでくれ。
		//あやまったじゃないか……。
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_忍者登場前＿ローズ助けられ__g:ローズ_010]
		//ふふ。うそ。冗談よ。
		//気にしないで。
	}
	talk ローズ 標準 -m {
		 [PC_忍者登場前＿ローズ助けられ__g:ローズ_011]
		//……私もあなたの役に立つって……
		//あなたのこと本当に心配してるって
		//認めてもらいたかっただけ……。
	}
	talk ライデン 標準 -m {
		 [PC_忍者登場前＿ローズ助けられ__g:ライデン_012]
		//ローズ……。
	}
	talk ローズ 標準 -m {
		 [PC_忍者登場前＿ローズ助けられ__g:ローズ_013]
		//がんばってね。
	}
}//v
}//d

