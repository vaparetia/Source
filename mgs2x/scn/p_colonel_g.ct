@rp_つっこまれ＿是１＿なんで知ってるんだ系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_エマ狙撃＿エマ撃つな２__g:ローズ_002]
		//まさか……またやる気？
	}
	talk ライデン 標準 -m {
		 [PC_エマ狙撃＿エマ撃つな２__g:ライデン_003]
		//まさか！そんなわけないだろう。
	}
	talk ローズ 標準 -m {
		 [PC_エマ狙撃＿エマ撃つな２__g:ローズ_004]
		//そうよね。まさか！
	}
	talk ライデン 標準 -m {
		 [PC_エマ狙撃＿エマ撃つな２__g:ライデン_005]
		//そう、まさか！はははは……
	}
	talk ローズ 標準 -m {
		 [PC_エマ狙撃＿エマ撃つな２__g:ローズ_006]
		//ふふふふ……
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_エマ狙撃＿エマ撃つな２__g:ローズ_007]
		//いい、ジャック？今度やったら？
	}
	talk ライデン 標準 -m {
		 [PC_エマ狙撃＿エマ撃つな２__g:ライデン_008]
		//やったら？
	}
	talk ローズ 標準 -m {
		 [PC_エマ狙撃＿エマ撃つな２__g:ローズ_009]
		//記録させない。わかった？
	}
}//v
}//d


