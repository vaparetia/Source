//核について h //e
//resource PC_核について
proc rp_PC_核について:03  {
vox t:vc266021 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_核について__g:ライデン_000]
		//大佐、この『ビッグ・シェル』に
		//メタルギアがあるって話は……。
	}
	talk 大佐 標準 -m {
		 [PC_核について__g:大佐_001]
		//まだ調査中だ。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_核について__g:ローズ_002]
		//ごめんなさい、ジャック。
	}
	talk ライデン 標準 -m {
		 [PC_核について__g:ライデン_003]
		//『ビッグ・シェル』が偽装だという
		//話も？
	}
	talk ローズ 標準 -m {
		 [PC_核について__g:ローズ_004]
		//ええ。どの記録を見てもれっきとした
		//海上除染施設ということになってる。
		//記録上、疑う余地はないんだけど……。
	}
	talk ローズ 標準 -m {
		 [PC_核について__g:ローズ_004_1]
		//ええ。どの記録を見てもれっきとした
		//海上除染施設ということになってる。
		//記録上、疑う余地はないんだけど……。
	}
	talk ライデン 標準 -m {
		 [PC_核について__g:ライデン_005]
		//エイムズとやらに直接聞くしかない、
		//ということか……。
	}
}//v
}//d

