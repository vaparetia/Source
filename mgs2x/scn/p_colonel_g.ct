		//Ｃ脚は居住区。『ビッグ・シェル』
		//職員の洋上生活を支えるための施設。
	}
	talk ローズ 標準 -m {
		 [PC_Ｃ脚機能説明__g:ローズ_001]
		//といっても、『ビッグ・シェル』は
		//全システムがほぼ自動化されているから
		//職員の数は少ないんだけど。
	}
}//v
