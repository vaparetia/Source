proc rp_PC_エマ狙撃＿エマ撃つな２:03  {
vox t:vc266251 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
