	}
	talk ライデン 標準 -m {
		 [PC_Ｆ脚武器入手後__g:ライデン_006]
		//……了解。
	}
}//v
}//d


//Ｂ脚 d //e
//ＳＥＡＬＳ死体近く h //e
//resource PC_ＳＥＡＬＳ死体１
proc rp_PC_ＳＥＡＬＳ死体１:03  {
vox t:vc265251 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_ＳＥＡＬＳ死体１__g:ライデン_000]
		//大佐！
	}
	talk 大佐 標準 -m {
		 [PC_ＳＥＡＬＳ死体１__g:大佐_001]
		//ああ。ＳＥＡＬ１０の隊員に違いない。
	}
	talk ライデン 標準 -m {
		 [PC_ＳＥＡＬＳ死体１__g:ライデン_002]
		//しかし妙だ。銃撃戦の痕跡があるが
		//交戦相手の痕跡はない……。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_ＳＥＡＬＳ死体１__g:ローズ_003]
		//どういうこと？
	}
	talk ライデン 標準 -m {
		 [PC_ＳＥＡＬＳ死体１__g:ライデン_004]
		//ＳＥＡＬ１０が一方的に
		//壊滅させられたってことだ。
	}
	talk ローズ 標準 -m {
		 [PC_ＳＥＡＬＳ死体１__g:ローズ_005]
		//そんなことって……？
		//ＳＥＡＬＳは海軍の精鋭中の
		//精鋭でしょう？
	}
	talk ライデン 標準 -m {
		 [PC_ＳＥＡＬＳ死体１__g:ライデン_006]
		//ああ……。弾痕の様子を見ると何か
		//パニック状態で撃ちまくったようにも
		//とれる。……一体……？
	}
	talk ライデン 標準 -m {
		 [PC_ＳＥＡＬＳ死体１__g:ライデン_006_1]
		//ああ……。弾痕の様子を見ると何か
		//パニック状態で撃ちまくったようにも
		//とれる。……一体……？
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ＳＥＡＬＳ死体１__g:大佐_007]
		//わからん。だが大統領の身が危ないこと
		//だけは確かだ。ライデン、急ぐんだ。
	}
	talk ライデン 標準 -m {
		 [PC_ＳＥＡＬＳ死体１__g:ライデン_008]
		//……了解。
	}
}//v
}//d

