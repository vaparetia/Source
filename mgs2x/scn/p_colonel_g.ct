	talk ライデン 標準 -m {
		 [PC_プリスキン信用するな__g:ライデン_001]
		//……信用しているさ。
		//あの男には何かがある。何か崇高な
		//意志というか……信ずるに足る……。
	}
	talk ライデン 標準 -m {
		 [PC_プリスキン信用するな__g:ライデン_001_1]
		//……信用しているさ。
		//あの男には何かがある。何か崇高な
		//意志というか……信ずるに足る……。
	}
	talk 大佐 標準 -m {
		 [PC_プリスキン信用するな__g:大佐_002]
		//ライデン！
	}
	talk ライデン 標準 -m {
		 [PC_プリスキン信用するな__g:ライデン_003]
		//！？
	}
@rp_うなづきデフォルト＿是
@rp_キテレツさん＿否２＿意味不明系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_プリスキン信用するな__g:大佐_004]
		//あの男はシミュレーションには入って
		//いない。あの男に頼るな。決してだ。
		//いいな。
	}
	talk ライデン 標準 -m {
		 [PC_プリスキン信用するな__g:ライデン_005]
		//……了解。
	}
}//v
}//d

//ＶＲ訓練について h //e
//resource PC_ＶＲ訓練について
proc rp_PC_ＶＲ訓練について:03  {
vox t:vc265601 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ＶＲ訓練について__g:大佐_000]
		//ライデン、プリスキンの言ったことなど
		//気にするな。君の行なってきた
		//ＶＲ訓練は最高の訓練プログラムだ。
	}
	talk 大佐 標準 -m {
		 [PC_ＶＲ訓練について__g:大佐_000_1]
		//ライデン、プリスキンの言ったことなど
		//気にするな。君の行なってきた
		//ＶＲ訓練は最高の訓練プログラムだ。
	}
	talk 大佐 標準 -m {
		 [PC_ＶＲ訓練について__g:大佐_001]
		//疑問など持つ必要はない。自信を持て。
		//いいな。
	}
}//v
}//d

//ソリッド・スネークについて h //e
//resource PC_スネークについて
proc rp_PC_スネークについて:03  {
vox t:vc265611 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_スネークについて__g:ライデン_000]
		//大佐、テロの首謀者は本当に
		//あのソリッド・スネークなのか？
	}
	talk 大佐 標準 -m {
		 [PC_スネークについて__g:大佐_001]
		//その通りだ。
	}
	talk ライデン 標準 -m {
		 [PC_スネークについて__g:ライデン_002]
		//だがスネークはシャドーモセス事件の……
	}
	talk 大佐 標準 -m {
		 [PC_スネークについて__g:大佐_003]
		//英雄か？
	}
	talk ライデン 標準 -m {
		 [PC_スネークについて__g:ライデン_004]
		//ああ。
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_スネークについて__g:大佐_005]
		//確かに、君にはＶＲ訓練を経験して
		//もらった。だがあれが事実の全てを
		//再現しているわけではないのだ。
	}
	talk 大佐 標準 -m {
		 [PC_スネークについて__g:大佐_005_1]
		//確かに、君にはＶＲ訓練を経験して
		//もらった。だがあれが事実の全てを
		//再現しているわけではないのだ。
	}
	talk 大佐 標準 -m {
		 [PC_スネークについて__g:大佐_006]
		//それに……人は変わる。
	}
	talk ライデン 標準 -m {
		 [PC_スネークについて__g:ライデン_007]
		//……大佐もか？
	}
@rp_うなづきデフォルト＿是
@rp_かみあわない＿否１＿話聞けよ系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_スネークについて__g:大佐_008]
		//ライデン、任務に集中しろ。
		//ソリッド・スネークはテロリストの
		//リーダー。油断のならない敵だ。いいな。
	}
	talk 大佐 標準 -m {
		 [PC_スネークについて__g:大佐_008_1]
		//ライデン、任務に集中しろ。
		//ソリッド・スネークはテロリストの
		//リーダー。油断のならない敵だ。いいな。
	}
}//v
}//d

//タンカー事件について。 h //e
//resource PC_タンカー事件について１
proc rp_PC_タンカー事件について１:03  {
vox t:vc265621 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_タンカー事件について１__g:大佐_000]
		//二年前、そこで起こったタンカー沈没
		//事件についてだが……
	}
	talk ライデン 標準 -m {
		 [PC_タンカー事件について１__g:ライデン_001]
		//ああ。ＶＲ訓練で体験した。
		//だがタンカーを沈めたのはスネークでは
		//なく……。
	}
	talk 大佐 標準 -m {
		 [PC_タンカー事件について１__g:大佐_002]
		//ライデン、あのＶＲ訓練は事実の全てを
		//再現したものではないのだ。
	}
	talk ライデン 標準 -m {
		 [PC_タンカー事件について１__g:ライデン_003]
		//どういう意味だ？
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_タンカー事件について１__g:大佐_004]
		//いいか。事実はこれだ。
	}
	talk 大佐 標準 -m {
		 [PC_タンカー事件について１__g:大佐_005]
		//テロリスト、ソリッド・スネークが
		//原油を満載したタンカーを沈め、結果、
		//ＮＹ湾は甚大な環境汚染を被った。
	}
	talk 大佐 標準 -m {
		 [PC_タンカー事件について１__g:大佐_005_1]
		//テロリスト、ソリッド・スネークが
		//原油を満載したタンカーを沈め、結果、
		//ＮＹ湾は甚大な環境汚染を被った。
	}
	talk 大佐 標準 -m {
		 [PC_タンカー事件について１__g:大佐_006]
		//スネークが英雄だなんて幻想は捨てろ。
		//奴はテロリストだ。いいな。
	}
}//v
}//d


//フォーチュン遭遇後 d //e
//ハリアーについて  h //e
//resource PC_ハリアー１
proc rp_PC_ハリアーうんちく:03  {
vox t:vc265631 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_ハリアーうんちく__g:ライデン_000]
		//大佐、テロリストはハリアーを
		//持っているのか？
	}
	talk 大佐 標準 -m {
		 [PC_ハリアーうんちく__g:大佐_001]
		//ああ。
		//海兵隊向けのＡＶ８Ｂハリアー２だ。
	}
@rp_うなづきデフォルト＿是
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_ハリアーうんちく__g:大佐_002]
		//２５ｍｍ機関砲、空対空ミサイル・
		//アムラーム、対地攻撃用ロケット弾等を
		//装備した垂直離着陸攻撃機。
	}
	talk 大佐 標準 -m {
		 [PC_ハリアーうんちく__g:大佐_002_1]
		//２５ｍｍ機関砲、空対空ミサイル・
		//アムラーム、対地攻撃用ロケット弾等を
		//装備した垂直離着陸攻撃機。
	}
	talk 大佐 標準 -m {
		 [PC_ハリアーうんちく__g:大佐_003]
		//ＳＥＡＬＳのヘリで対抗できる
		//相手ではない。
	}
	talk ライデン 標準 -m {
		 [PC_ハリアーうんちく__g:ライデン_004]
		//生身ならなおさらだろうな。
		//大佐、奴等はどこからそんなものを？
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ハリアーうんちく__g:大佐_005]
		//わからん。
	}
	talk ライデン 標準 -m {
		 [PC_ハリアーうんちく__g:ライデン_006]
		//奴等は本当にただのテロリストなのか？
	}
	talk 大佐 標準 -m {
		 [PC_ハリアーうんちく__g:大佐_007]
		//落ち着け、ライデン。
		//今は任務を遂行することだけを
		//考えろ。いいな。
	}
}//v
}//d

//テロリストの報復について h //e
//resource PC_報復
proc rp_PC_報復:03  {
vox t:vc265641 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_報復__g:ライデン_000]
		//大佐、本当に奴等は
		//『ビッグ・シェル』を爆破すると？
	}
	talk 大佐 標準 -m {
		 [PC_報復__g:大佐_001]
		//充分にありうる。このまま要求が
		//受け入れられなければな。奴等はプロだ。
		//一度決断すれば、ためらうことなどない。
	}
	talk 大佐 標準 -m {
		 [PC_報復__g:大佐_001_1]
		//充分にありうる。このまま要求が
		//受け入れられなければな。奴等はプロだ。
		//一度決断すれば、ためらうことなどない。
	}
	talk ライデン 標準 -m {
		 [PC_報復__g:ライデン_002]
		//要求に応じるつもりは？
	}
	talk 大佐 標準 -m {
		 [PC_報復__g:大佐_003]
		//一切ない。
	}
	talk ライデン 標準 -m {
		 [PC_報復__g:ライデン_004]
		//くっ！
	}
@rp_うなづきデフォルト＿是
@rp_無茶指令＿否１＿お前がやれ系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_報復__g:大佐_005]
		//君だけが頼りなんだ。
		//爆弾の排除を急いでくれ。
	}
}//v
}//d
//有毒物質 h //e
//resource PC_有毒物質
proc rp_PC_有毒物質:03  {
vox t:vc265651 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_有毒物質__g:大佐_000]
		//『ビッグ・シェル』が爆発すれば、
		//海水殺菌などに使われる多量の塩素系
		//化学薬品が原油と共に炎上するだろう。
	}
	talk 大佐 標準 -m {
		 [PC_有毒物質__g:大佐_000_1]
		//『ビッグ・シェル』が爆発すれば、
		//海水殺菌などに使われる多量の塩素系
		//化学薬品が原油と共に炎上するだろう。
	}
	talk 大佐 標準 -m {
		 [PC_有毒物質__g:大佐_000_2]
		//『ビッグ・シェル』が爆発すれば、
		//海水殺菌などに使われる多量の塩素系
		//化学薬品が原油と共に炎上するだろう。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_有毒物質__g:大佐_001]
		//そうなるとダイオキシン類を含む
		//大量の有毒化学物質が発生することが
		//予想される。
	}
	talk 大佐 標準 -m {
		 [PC_有毒物質__g:大佐_001_1]
		//そうなるとダイオキシン類を含む
		//大量の有毒化学物質が発生することが
		//予想される。
	}
	talk 大佐 標準 -m {
		 [PC_有毒物質__g:大佐_002]
		//ダイオキシン類はポリ塩化ジベンゾ・
		//パラ・ジオキシンとポリ塩化ジベンゾ・
		//フランの総称だ。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_有毒物質__g:大佐_003]
		//強い急性毒性を持つ有機性塩素化合物で
		//発癌性、催奇性、生殖毒性が非常に強い。
	}
	talk 大佐 標準 -m {
		 [PC_有毒物質__g:大佐_003_1]
		//強い急性毒性を持つ有機性塩素化合物で
		//発癌性、催奇性、生殖毒性が非常に強い。
	}
	talk 大佐 標準 -m {
		 [PC_有毒物質__g:大佐_004]
		//その上、分解されにくく難水溶性で
		//体内に蓄積されやすいんだ。
	}
	talk 大佐 標準 -m {
		 [PC_有毒物質__g:大佐_004_1]
		//その上、分解されにくく難水溶性で
		//体内に蓄積されやすいんだ。
	}
	talk 大佐 標準 -m {
		 [PC_有毒物質__g:大佐_005]
		//湾内および沿岸の生態系に及ぼす影響は
		//計り知れない。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_有毒物質__g:大佐_006]
		//おそらく環境回復には何世代もかかる
		//だろう。
	}
	talk 大佐 標準 -m {
		 [PC_有毒物質__g:大佐_007]
		//奴等に『ビッグ・シェル』を
		//爆破させてはならない。
		//ライデン、Ｃ４を除去するんだ。
	}
}//v
}//d


//ピーター遭遇後 d //e
//ピーターについて最初 h //e
//resource PC_ピーター１
proc rp_PC_ピーター１:03  {
vox t:vc265661 {
@rp_うなづきデフォルト＿是
@rp_無茶指令＿否１＿お前がやれ系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_ピーター１__g:大佐_000]
		//ライデン、スティルマンは爆弾処理の
		//第一人者だ。彼の指示に従って爆弾を
		//処理しろ。
	}
}//v
}//d
//resource PC_ピーター２
proc rp_PC_ピーター２:03  {
vox t:vc265671 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_ピーター２__g:ライデン_000]
		//わかった。だがスティルマンとは
		//どういう人間なんだ？
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_ピーター２__g:ローズ_001]
		//わかった。調べておく。
		//少し待ってて。
	}
}//v
}//d

//ピーター しばらくしてから h //e
//resource PC_ピーター詳細１
proc rp_PC_ピーター詳細１:03  {
vox t:vc265681 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ピーター詳細１__g:大佐_000]
		//ライデン、ローズ君から話がある。
	}
}//v
}//d
//resource PC_ピーター詳細２
proc rp_PC_ピーター詳細２:03  {
vox t:vc265691 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_ピーター詳細２__g:ローズ_000]
		//スティルマンさんのファイルを
		//調べてみたの。
	}
}//v
}//d
//resource PC_ピーター詳細３
proc rp_PC_ピーター詳細３:03  {
vox t:vc265701 {
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_ピーター詳細３__g:ローズ_000]
		//ピーター・スティルマン。
		//通称、義足のピーター。
		//伝説的な爆弾処理技術者。
	}
	talk ローズ 標準 -m {
		 [PC_ピーター詳細３__g:ローズ_000_1]
		//ピーター・スティルマン。
		//通称、義足のピーター。
		//伝説的な爆弾処理技術者。
	}
/*
	talk ローズ 標準 -m {
		 [PC_ピーター詳細３__g:ローズ_001]
		//１９９３年の世界貿易センター爆破
		//テロや１９９５年のオクラホマ連邦ビル
		//爆破事件などの捜査にも参加してる。
	}
	talk ローズ 標準 -m {
		 [PC_ピーター詳細３__g:ローズ_001_1]
		//１９９３年の世界貿易センター爆破
		//テロや１９９５年のオクラホマ連邦ビル
		//爆破事件などの捜査にも参加してる。
	}
*/
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_ピーター詳細３__g:ローズ_002]
		//長年、海軍爆発物処理学校の教官と
		//ＮＹＰＤの爆発物処理顧問も務めてるわ。
	}
	talk ローズ 標準 -m {
		 [PC_ピーター詳細３__g:ローズ_002_1]
		//長年、海軍爆発物処理学校の教官と
		//ＮＹＰＤの爆発物処理顧問も務めてるわ。
	}
	talk ローズ 標準 -m {
		 [PC_ピーター詳細３__g:ローズ_003]
		//でも５年前に事故を起こして片足を
		//失くしてしまって……それ以来一線を
		//退いて教官に専念している。
	}
	talk ローズ 標準 -m {
		 [PC_ピーター詳細３__g:ローズ_003_1]
		//でも５年前に事故を起こして片足を
		//失くしてしまって……それ以来一線を
		//退いて教官に専念している。
	}
	talk ローズ 標準 -m {
		 [PC_ピーター詳細３__g:ローズ_004]
		//この作戦に招集されたのは本人の言う
		//通り、ファットマンに対抗出来る爆弾の
		//専門家が彼しかいなかったからみたいね。
	}
	talk ローズ 標準 -m {
		 [PC_ピーター詳細３__g:ローズ_004_1]
		//この作戦に招集されたのは本人の言う
		//通り、ファットマンに対抗出来る爆弾の
		//専門家が彼しかいなかったからみたいね。
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_ピーター詳細３__g:ローズ_005]
		//現役を退いたとは言え、爆弾解体に
		//おける第一人者であることは間違いない
		//みたい。頼りになると思うわ。
	}
	talk ローズ 標準 -m {
		 [PC_ピーター詳細３__g:ローズ_005_1]
		//現役を退いたとは言え、爆弾解体に
		//おける第一人者であることは間違いない
		//みたい。頼りになると思うわ。
	}
	talk ローズ 標準 -m {
		 [PC_ピーター詳細３__g:ローズ_005_2]
		//現役を退いたとは言え、爆弾解体に
		//おける第一人者であることは間違いない
		//みたい。頼りになると思うわ。
	}
}//v
}//d

//段ボールをかぶった男を見た後 h //e
//resource PC_怪奇箱男１
proc rp_PC_怪奇箱男１:03  {
vox t:vc265711 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_怪奇箱男１__g:ライデン_000]
		//大佐、さっきダンボールを
		//かぶって走る奴を見た。
	}
	talk 大佐 標準 -m {
		 [PC_怪奇箱男１__g:大佐_001]
		//ダンボール？
	}
	talk ライデン 標準 -m {
		 [PC_怪奇箱男１__g:ライデン_002]
		//あれはなんなんだ？
		//デッドセルか？
	}
@rp_つっこまれ＿否１＿逆ギレ系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_怪奇箱男１__g:大佐_003]
		//いくらデッドセルが変人ぞろいでも
		//ダンボールはないだろう……。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_怪奇箱男１__g:ローズ_004]
		//調べてみるわ。
	}
	talk ライデン 標準 -m {
		 [PC_怪奇箱男１__g:ライデン_005]
		//頼む。
	}
}//v
}//d

//箱男 しばらくしてから h //e
//resource PC_怪奇箱男２
proc rp_PC_怪奇箱男２:03  {
vox t:vc265721 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_怪奇箱男２__g:大佐_000]
		//ライデン、ローズ君から報告がある
		//そうだ。
	}
}//v
}//d
//resource PC_怪奇箱男３
proc rp_PC_怪奇箱男３:03  {
vox t:vc265731 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_怪奇箱男３__g:ローズ_000]
		//ジャック、さっきのダンボールの人の
		//こと、調べてみたんだけど……。
	}
	talk ライデン 標準 -m {
		 [PC_怪奇箱男３__g:ライデン_001]
		//何かわかったか？
	}
	talk ローズ 標準 -m {
		 [PC_怪奇箱男３__g:ローズ_002]
		//いいえ。デッドセルにもゴルルコビッチ
		//大佐のロシア私兵部隊にも該当する
		//データはなかった。
	}
	talk ローズ 標準 -m {
		 [PC_怪奇箱男３__g:ローズ_002_1]
		//いいえ。デッドセルにもゴルルコビッチ
		//大佐のロシア私兵部隊にも該当する
		//データはなかった。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_怪奇箱男３__g:大佐_003]
		//ＳＥＡＬ１０の生き残りという線は？
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_怪奇箱男３__g:ローズ_004]
		//勿論調べました。でも……。
	}
	talk ライデン 標準 -m {
		 [PC_怪奇箱男３__g:ライデン_005]
		//見つからなかった？
	}
	talk ローズ 標準 -m {
		 [PC_怪奇箱男３__g:ローズ_006]
		//ええ……ごめんなさい。役に立てなくて。
	}
	talk ライデン 標準 -m {
		 [PC_怪奇箱男３__g:ライデン_007]
		//一体あれは……。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_怪奇箱男３__g:大佐_008]
		//ライデン、気をつけろ。
	}
}//v
}//d

//プリスキンはやはり怪しい h //e
//resource PC_爆弾解体プリスキン怪しい
proc rp_PC_爆弾解体プリスキン怪しい:03  {
vox t:vc265741 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_爆弾解体プリスキン怪しい__g:大佐_000]
		//ライデン、プリスキンの方はどうなんだ？
	}
	talk ライデン 標準 -m {
		 [PC_爆弾解体プリスキン怪しい__g:ライデン_001]
		//順調のようだが……。
	}
	talk 大佐 標準 -m {
		 [PC_爆弾解体プリスキン怪しい__g:大佐_002]
		//スティルマンも言っていた通り、
		//あの男は怪しい。気を許すんじゃないぞ。
		//いいな。
	}
	talk 大佐 標準 -m {
		 [PC_爆弾解体プリスキン怪しい__g:大佐_002_1]
		//スティルマンも言っていた通り、
		//あの男は怪しい。気を許すんじゃないぞ。
		//いいな。
	}
}//v
}//d

//ミスターＸ h //e
//resource PC_ミスターＸ
proc rp_PC_ミスターＸ:03  {
vox t:vc265751 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_ミスターＸ__g:ライデン_000]
		//大佐、
		//さっきのミスターＸというのは……。
	}
	talk 大佐 標準 -m {
		 [PC_ミスターＸ__g:大佐_001]
		//ＦＯＸＨＯＵＮＤの隊員ではない。
	}
	talk ライデン 標準 -m {
		 [PC_ミスターＸ__g:ライデン_002]
		//奴はディープスロートと名乗ったんだ。
		//まるでシャドーモセスの……。
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ミスターＸ__g:大佐_003]
		//ライデン、言いたいことはわかる。
		//だがそれはありえない。
	}
	talk ライデン 標準 -m {
		 [PC_ミスターＸ__g:ライデン_004]
		//……。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_ミスターＸ__g:ローズ_005]
		//ジャック、調べてみるから……
		//少し待ってて。
	}
}//v
}//d

//ミスターＸ しばらくしてから h //e
//resource PC_ミスターＸ２
proc rp_PC_ミスターＸ２:03  {
vox t:vc265761 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ミスターＸ２__g:大佐_000]
		//ローズ君が例のミスターＸに
		//ついて調べてくれた。
	}
}//v
}//d
//resource PC_ミスターＸ３
proc rp_PC_ミスターＸ３:03  {
vox t:vc265771 {
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_ミスターＸ３__g:ローズ_000]
		//ジャック、ミスターＸ……というより
		//ディープスロートについて調べたわ。
	}
	talk ローズ 標準 -m {
		 [PC_ミスターＸ３__g:ローズ_001]
		//確かにソリッド・スネークはシャドー
		//モセス事件で、ディープスロートと
		//名乗る男のサポートを受けている。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_ミスターＸ３__g:ローズ_002]
		//その正体は元ＦＯＸＨＯＵＮＤ隊員
		//グレイ・フォックスだったそうよ。
	}
	talk ライデン 標準 -m {
		 [PC_ミスターＸ３__g:ライデン_003]
		//グレイ・フォックス……。
	}
	talk ローズ 標準 -m {
		 [PC_ミスターＸ３__g:ローズ_004]
		//そう。本名はフランク・イェーガー。
		//ＦＯＸＨＯＵＮＤで唯一ＦＯＸの称号を
		//許された、最優秀の隊員。
	}
	talk ローズ 標準 -m {
		 [PC_ミスターＸ３__g:ローズ_004_1]
		//そう。本名はフランク・イェーガー。
		//ＦＯＸＨＯＵＮＤで唯一ＦＯＸの称号を
		//許された、最優秀の隊員。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_ミスターＸ３__g:ローズ_005]
		//ＯＵＴＥＲ　ＨＥＡＶＥＮでは
		//スネークに先駆けて要塞に潜入。
		//彼を助けて事件を収束に導いた。
	}
	talk ローズ 標準 -m {
		 [PC_ミスターＸ３__g:ローズ_005_1]
		//ＯＵＴＥＲ　ＨＥＡＶＥＮでは
		//スネークに先駆けて要塞に潜入。
		//彼を助けて事件を収束に導いた。
	}
	talk ローズ 標準 -m {
		 [PC_ミスターＸ３__g:ローズ_006]
		//でもザンジバーランドではビッグボスと
		//結託して騒乱の首謀者になってる。
		//彼はそこでスネークと戦い敗れた……。
	}
	talk ローズ 標準 -m {
		 [PC_ミスターＸ３__g:ローズ_006_1]
		//でもザンジバーランドではビッグボスと
		//結託して騒乱の首謀者になってる。
		//彼はそこでスネークと戦い敗れた……。
	}
	talk ローズ 標準 -m {
		 [PC_ミスターＸ３__g:ローズ_007]
		//瀕死の重傷を負ったフォックスは軍に
		//回収されたようね。
	}
	talk ローズ 標準 -m {
		 [PC_ミスターＸ３__g:ローズ_008]
		//その後、強化骨格と遺伝子治療の
		//実験体になっていたみたい……。
	}
	talk ローズ 標準 -m {
		 [PC_ミスターＸ３__g:ローズ_008_1]
		//その後、強化骨格と遺伝子治療の
		//実験体になっていたみたい……。
	}
	talk ライデン 標準 -m {
		 [PC_ミスターＸ３__g:ライデン_009]
		//強化骨格？
	}
	talk ローズ 標準 -m {
		 [PC_ミスターＸ３__g:ローズ_010]
		//サイボーグ忍者。そんな風に呼んでた
		//人もいるようね。研究所の焼失で詳しい
		//記録は残ってないんだけど……。
	}
	talk ローズ 標準 -m {
		 [PC_ミスターＸ３__g:ローズ_010_1]
		//サイボーグ忍者。そんな風に呼んでた
		//人もいるようね。研究所の焼失で詳しい
		//記録は残ってないんだけど……。
	}
	talk ライデン 標準 -m {
		 [PC_ミスターＸ３__g:ライデン_011]
		//その後、彼はシャドーモセスに？
	}
	talk ローズ 標準 -m {
		 [PC_ミスターＸ３__g:ローズ_012]
		//ええ。でも、なぜそこに現われたのかに
		//ついては記録にないの。
	}
	talk ローズ 標準 -m {
		 [PC_ミスターＸ３__g:ローズ_013]
		//スネークへの復讐だったって見解も
		//あるみたいけど確かなことはわからない。
	}
	talk ライデン 標準 -m {
		 [PC_ミスターＸ３__g:ライデン_014]
		//じゃあ今度も奴が……。
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_ミスターＸ３__g:ローズ_015]
		//いえ、彼はシャドーモセスで死んでいる。
		//それは確か。
	}
	talk ライデン 標準 -m {
		 [PC_ミスターＸ３__g:ライデン_016]
		//……では奴は一体？
	}
	talk ローズ 標準 -m {
		 [PC_ミスターＸ３__g:ローズ_017]
		//わからない。でも気をつけて。
	}
}//v
}//d



//死んだピーターについて h //e
//resource PC_ピーター死１
proc rp_PC_ピーター死１:03  {
vox t:vc265781 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_ピーター死１__g:ライデン_000]
		//大佐、ピーターが死んだ。
	}
	talk 大佐 標準 -m {
		 [PC_ピーター死１__g:大佐_001]
		//わかっている。しっかりしろ、ライデン。
	}
	talk ライデン 標準 -m {
		 [PC_ピーター死１__g:ライデン_002]
		//もうダメだ。俺にはできない。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_ピーター死１__g:ローズ_003]
		//ジャック、いい？
		//落ち着いて。
	}
	talk ライデン 標準 -m {
		 [PC_ピーター死１__g:ライデン_004]
		//ピーターが死んだ。
		//爆弾の専門家はもういない。
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_キテレツさん＿否１＿なんだこいつ系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_ピーター死１__g:ローズ_005]
		//あなたは大丈夫。私が死なせない。
	}
	talk ライデン 標準 -m {
		 [PC_ピーター死１__g:ライデン_006]
		//ローズ？
	}
	talk ローズ 標準 -m {
		 [PC_ピーター死１__g:ローズ_007]
		//さあ、センサーＢを装備して？
	}
	talk ライデン 標準 -m {
		 [PC_ピーター死１__g:ライデン_008]
		//ああ……。
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_ピーター死１__g:ローズ_009]
		//反応がないかどうか調べて。
		//ジャック、なんとしても、
		//この危機を脱するのよ。
	}
	talk ライデン 標準 -m {
		 [PC_ピーター死１__g:ライデン_010]
		//わかった……。
	}
}//v
}//d


//爆発の余波について h //e
//resource PC_ピーター死＿爆発余波
proc rp_PC_ピーター死＿爆発余波:03  {
vox t:vc265791 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
