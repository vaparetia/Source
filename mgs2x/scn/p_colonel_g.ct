//死体定時連絡 h //e
//resource PC_死体定時連絡
proc rp_PC_死体定時連絡:03  {
vox t:vc260861 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_死体定時連絡__g:大佐_000]
		//敵は一定時間毎に定時連絡を行っている。
		//応えない隊員がいれば、状況を確かめる
		//ために増員が送られてくるはずだ。
	}
	talk 大佐 標準 -m {
		 [PC_死体定時連絡__g:大佐_000_1]
		//敵は一定時間毎に定時連絡を行っている。
		//応えない隊員がいれば、状況を確かめる
		//ために増員が送られてくるはずだ。
	}
	talk 大佐 標準 -m {
		 [PC_死体定時連絡__g:大佐_001]
		//増員が倒れた仲間を発見すれば、敵は
		//当然警戒を強化するだろう。倒した敵の
		//体は発見されにくい場所に隠すんだ。
	}
	talk 大佐 標準 -m {
		 [PC_死体定時連絡__g:大佐_001_1]
		//増員が倒れた仲間を発見すれば、敵は
		//当然警戒を強化するだろう。倒した敵の
		//体は発見されにくい場所に隠すんだ。
	}
}//v
}//d


