//爆弾解体の事はピーターに聞け。h //e
//resource PC_ピーターに聞け
proc rp_PC_ピーターに聞け:03  {
vox t:vc262791 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ピーターに聞け__g:大佐_000]
		//ライデン、スティルマンは爆弾処理の
		//専門家だ。彼にアドバイスを聞いてみろ。
		//周波数は１４１．２５だろう？
	}
	talk 大佐 標準 -m {
		 [PC_ピーターに聞け__g:大佐_000_1]
