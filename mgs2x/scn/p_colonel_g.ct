	talk ライデン 標準 -m {
		 [PC_人質＿人質ぱんつ__g:ライデン_003]
		//ああ……いや、これは……。
	}
	@rpd_ローズ顔表示
	talk ローズ 標準 -m {
		 [PC_人質＿人質ぱんつ__g:ローズ_004]
		//なにが「これは」よ！？
	}
	@rpd_大佐顔表示
	talk 大佐 標準 -m {
		 [PC_人質＿人質ぱんつ__g:大佐_005]
		//うむ。ローズ君の言う通りだ。
		//例え戦場でも品位を失ってはいかん……。
	}
	talk 大佐 標準 -m {
		 [PC_人質＿人質ぱんつ__g:大佐_005_1]
		//うむ。ローズ君の言う通りだ。
		//例え戦場でも品位を失ってはいかん……。
