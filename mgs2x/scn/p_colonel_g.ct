		//Ｂ１には大規模な集会場がある。
		//そこで大統領と環境保護視察団の歓迎
		//レセプションが行われたはずよ。
	}
	talk ローズ 標準 -m {
		 [PC_シェル１中央棟機能説明__g:ローズ_001_2]
		//Ｂ１には大規模な集会場がある。
		//そこで大統領と環境保護視察団の歓迎
		//レセプションが行われたはずよ。
	}
	talk ローズ 標準 -m {
		 [PC_シェル１中央棟機能説明__g:ローズ_002]
		//でもその機能の中枢はＢ２にある
		//電算室に集約されてるの。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_シェル１中央棟機能説明__g:ローズ_003]
		//この電算室で汚染海水の循環や除染
		//状態の監視等、各施設の管理を全て
		//行うようになってる。
	}
	talk ローズ 標準 -m {
		 [PC_シェル１中央棟機能説明__g:ローズ_003_1]
		//この電算室で汚染海水の循環や除染
		//状態の監視等、各施設の管理を全て
		//行うようになってる。
	}
	talk ローズ 標準 -m {
		 [PC_シェル１中央棟機能説明__g:ローズ_004]
		//警備が厳重なのもうなずけるわね。
	}
}//v
}//d

