//レーションの説明 h //e
//レーション入手時にＣＡＬＬ t //e
//resource PC_レーションＣＡＬＬ１
proc rp_PC_レーションＣＡＬＬ１:03  {
vox t:vc260621 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_レーションＣＡＬＬ１__g:大佐_000]
		//レーションを手に入れたな。
		//ＬＩＦＥを回復出来る軍用携帯糧食だ。
	}
	talk 大佐 標準 -m {
		 [PC_レーションＣＡＬＬ１__g:大佐_000_1]
		//レーションを手に入れたな。
		//ＬＩＦＥを回復出来る軍用携帯糧食だ。
	}
}//v
}//d

//操作説明 t //e
//resource PC_レーション操作説明

proc rpb_PC_レーション操作説明:03  {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_レーション操作説明__g:大佐_000]
		//レーションをウィンドウで選択して
		//○ボタンを押せば、その場で使用して
		//ＬＩＦＥを一定量回復する。
	}
	talk 大佐 標準 -m {
		 [PC_レーション操作説明__g:大佐_000_1]
		//レーションをウィンドウで選択して
		//○ボタンを押せば、その場で使用して
		//ＬＩＦＥを一定量回復する。
	}
	talk 大佐 標準 -m {
		 [PC_レーション操作説明__g:大佐_001]
		//装備していればＬＩＦＥがなくなった
		//瞬間、自動的に使用してＬＩＦＥを
		//回復することが出来る。
	}
	talk 大佐 標準 -m {
		 [PC_レーション操作説明__g:大佐_001_1]
		//装備していればＬＩＦＥがなくなった
		//瞬間、自動的に使用してＬＩＦＥを
		//回復することが出来る。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
@rp_うんちく＿是１＿詳しいな系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_レーション操作説明__g:大佐_002]
		//栄養補給だけではなく免疫システムを
		//活性化させ、ストレスを緩和させる
		//効果も合わせ持っている。
	}
	talk 大佐 標準 -m {
		 [PC_レーション操作説明__g:大佐_002_1]
		//栄養補給だけではなく免疫システムを
		//活性化させ、ストレスを緩和させる
		//効果も合わせ持っている。
	}
	talk ライデン 標準 -m {
		 [PC_レーション操作説明__g:ライデン_003]
		//結構、味気無さそうに見えるんだが。
	}
	talk 大佐 標準 -m {
		 [PC_レーション操作説明__g:大佐_004]
		//文句を言うな、ライデン……。
		//戦場なんだぞ……。
	}
}//d

//ローズがいる場合 t //e
//resource PC_レーション操作説明＿ローズ
/*
proc rp_PC_レーション操作説明＿ローズ:03  {
vox t:vc260641 {
	@rpb_PC_レーション操作説明＿ローズ
}//v
}//d
*/

proc rpb_PC_レーション操作説明＿ローズ:03  {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_レーション操作説明＿ローズ__g:ローズ_000]
		//がまんして、ジャック。
		//任務が終わったら、私の得意料理を
		//ごちそうするから。
	}
	talk ライデン 標準 -m {
		 [PC_レーション操作説明＿ローズ__g:ライデン_001]
		//え！？
	}
	talk ローズ 標準 -m {
		 [PC_レーション操作説明＿ローズ__g:ローズ_002]
		//ん？
	}
	talk ライデン 標準 -m {
		 [PC_レーション操作説明＿ローズ__g:ライデン_003]
		//あ、いや、何でもない。
		//楽しみだよ。ははは……。
	}
}//d

//ノード前 h //e
//接続前 t //e
//resource PC_ノード前接続前１
/*
proc rp_PC_ノード前接続前１:03  {
vox t:vc260651 {
	@rpb_PC_ノード前接続前１
}//v
}//d
*/

proc rpb_PC_ノード前接続前１:03  {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ノード前接続前１__g:大佐_000]
		//ライデン、そこにあるコンピュータ
		//端末がノードだ。
	}
	talk ライデン 標準 -m {
		 [PC_ノード前接続前１__g:ライデン_001]
		//これが……。
	}
	talk 大佐 標準 -m {
		 [PC_ノード前接続前１__g:大佐_002]
		//そうだ。早くノードにアクセスしろ。
		//やり方は、ノードの前に立って
		//△ボタンを押すだけだ。
	}
}//d
//resource PC_ノード前接続前２
proc rp_PC_ノード前接続前２:03  {
vox t:vc260661 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ノード前接続前２__g:大佐_000]
		//危険モードの状態ではノードにアクセス
		//することは出来ない。アクセスする前に
		//必ず敵を振り切るんだ。
	}
	talk 大佐 標準 -m {
		 [PC_ノード前接続前２__g:大佐_000_1]
		//危険モードの状態ではノードにアクセス
		//することは出来ない。アクセスする前に
		//必ず敵を振り切るんだ。
	}
}//v
}//d
//resource PC_ノード前接続前３
proc rp_PC_ノード前接続前３:03  {
vox t:vc260662 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ノード前接続前３__g:大佐_000]
		//ノードには潜入モードの状態でしか
		//アクセス出来ない。
	}
	talk 大佐 標準 -m {
