//フォーチュンについてしばらくしてから h //e
//resource PC_フォーチュン２
proc rp_PC_フォーチュン２:03  {
vox t:vc265811 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_フォーチュン２__g:大佐_000]
		//ローズ君がフォーチュンについて
		//調べてくれた。
	}
}//v
}//d
//resource PC_フォーチュン３
proc rp_PC_フォーチュン３:03  {
vox t:vc265821 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_フォーチュン３__g:ローズ_000]
		//ジャック、フォーチュンについての
		//データよ。
	}
	talk ローズ 標準 -m {
		 [PC_フォーチュン３__g:ローズ_001]
		//通称、フォーチュン。
		//デッドセルのリーダー。
		//本名、ヘレナ・ドルフ・ジャクソン。
	}
	talk ローズ 標準 -m {
		 [PC_フォーチュン３__g:ローズ_001_1]
		//通称、フォーチュン。
		//デッドセルのリーダー。
		//本名、ヘレナ・ドルフ・ジャクソン。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_フォーチュン３__g:ローズ_002]
		//父親は二年前、演習中に事故死した
		//海兵隊司令官スコット・ドルフ。
	}
	talk ローズ 標準 -m {
		 [PC_フォーチュン３__g:ローズ_002_1]
		//父親は二年前、演習中に事故死した
		//海兵隊司令官スコット・ドルフ。
	}
	talk ローズ 標準 -m {
		 [PC_フォーチュン３__g:ローズ_003]
		//夫はデッドセルの元リーダー、
		//ジャクソン大佐……。
		//彼は獄死……とあるわ。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_フォーチュン３__g:ローズ_004]
		//夫の死の直後、彼女は軍に入隊してる。
	}
	talk ローズ 標準 -m {
		 [PC_フォーチュン３__g:ローズ_005]
		//戦闘経験は全くなかった彼女だけど
		//すぐにある特質を見出されて
		//デッドセルに編入された。
	}
	talk ローズ 標準 -m {
		 [PC_フォーチュン３__g:ローズ_005_1]
		//戦闘経験は全くなかった彼女だけど
		//すぐにある特質を見出されて
		//デッドセルに編入された。
	}
	talk ライデン 標準 -m {
		 [PC_フォーチュン３__g:ライデン_006]
		//特質？
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_フォーチュン３__g:ローズ_007]
		//運が良かったのよ。奇跡みたいな強運。
		//彼女が行くところ、弾はよけ作戦は
		//必ず成功する……。
	}
	talk ローズ 標準 -m {
		 [PC_フォーチュン３__g:ローズ_007_1]
		//運が良かったのよ。奇跡みたいな強運。
		//彼女が行くところ、弾はよけ作戦は
		//必ず成功する……。
	}
	talk ライデン 標準 -m {
		 [PC_フォーチュン３__g:ライデン_008]
		//そんな馬鹿な。
	}
	talk ローズ 標準 -m {
		 [PC_フォーチュン３__g:ローズ_009]
		//私もそう思う。でも彼女が負傷したと
		//いう記録は一切ない。かすり傷一つ
		//負っていないの。
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_フォーチュン３__g:ローズ_010]
		//ジャック、気をつけて……。
	}
}//v
}//d



//レールガン設定 h //e
//resource PC_フォーチュン戦＿レールガン
proc rp_PC_フォーチュン戦＿レールガン:03  {
vox t:vc265831 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_フォーチュン戦＿レールガン__g:大佐_000]
		//ライデン、ローズ君がフォーチュンの
		//武器について調べてくれた。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_フォーチュン戦＿レールガン__g:ローズ_001]
		//彼女の持ってる大きなライフルは
		//個人用のレールガンみたい。
	}
	talk ライデン 標準 -m {
		 [PC_フォーチュン戦＿レールガン__g:ライデン_002]
		//レールガンだって？
	}
	talk ローズ 標準 -m {
		 [PC_フォーチュン戦＿レールガン__g:ローズ_003]
		//そう。磁力で弾を射出する電磁砲。
		//可動導体としてプラズマ電気子を使用
		//することで加速性能を上げている。
	}
	talk ローズ 標準 -m {
		 [PC_フォーチュン戦＿レールガン__g:ローズ_003_1]
		//そう。磁力で弾を射出する電磁砲。
		//可動導体としてプラズマ電気子を使用
		//することで加速性能を上げている。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_フォーチュン戦＿レールガン__g:ローズ_004]
		//その砲弾の運動エネルギーは約１０ＭＪ。ちなみに１４０ｍｍ滑腔砲弾のそれが
		//約２０ＭＪ……。
	}
	talk ローズ 標準 -m {
		 [PC_フォーチュン戦＿レールガン__g:ローズ_004_1]
		//その砲弾の運動エネルギーは約１０ＭＪ。ちなみに１４０ｍｍ滑腔砲弾のそれが
		//約２０ＭＪ……。
	}
	talk ライデン 標準 -m {
		 [PC_フォーチュン戦＿レールガン__g:ライデン_005]
		//そんなものが実用化されて
		//いるとは……。
	}
	talk ローズ 標準 -m {
		 [PC_フォーチュン戦＿レールガン__g:ローズ_006]
		//実用化はされていないわ。
		//あれはあくまで試作品。
	}
	talk ライデン 標準 -m {
		 [PC_フォーチュン戦＿レールガン__g:ライデン_007]
		//あれのどこが試作品なんだ！
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_フォーチュン戦＿レールガン__g:ローズ_008]
		//レール材のプラズマ化やレール間放電
		//などの問題が解決されてないらしいの。
	}
	talk ローズ 標準 -m {
		 [PC_フォーチュン戦＿レールガン__g:ローズ_009]
		//暴発の危険性が高すぎて兵器としての
		//実用性はないっていう評価が残ってるわ。
	}
	talk ローズ 標準 -m {
		 [PC_フォーチュン戦＿レールガン__g:ローズ_009_1]
		//暴発の危険性が高すぎて兵器としての
		//実用性はないっていう評価が残ってるわ。
	}
	talk ライデン 標準 -m {
		 [PC_フォーチュン戦＿レールガン__g:ライデン_010]
		//だが奴のは暴発なんか……
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_フォーチュン戦＿レールガン__g:ローズ_011]
		//……きっと……
		//運がいいんからじゃないかしら？
	}
	talk ライデン 標準 -m {
		 [PC_フォーチュン戦＿レールガン__g:ライデン_012]
		//そんな……。
	}
	talk ローズ 標準 -m {
		 [PC_フォーチュン戦＿レールガン__g:ローズ_013]
		//どちらにせよ彼女にしか扱えない
		//武器というのは間違いないみたい。
	}
	talk ライデン 標準 -m {
		 [PC_フォーチュン戦＿レールガン__g:ライデン_014]
		//始末におえない武器だってこともな。
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_フォーチュン戦＿レールガン__g:ローズ_015]
		//気をつけて、ジャック！
	}
}//v
}//d


