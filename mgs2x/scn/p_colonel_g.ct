vox t:vc266201 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_愛国者達__g:ライデン_000]
		//大佐、『愛国者達』という連中に
		//ついては何かわかったか？
	}
	talk 大佐 標準 -m {
		 [PC_愛国者達__g:大佐_001]
		//いや、まだだ……。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_愛国者達__g:ローズ_002]
		//どこにもそんなデータは見つからないの。
	}
	talk ライデン 標準 -m {
		 [PC_愛国者達__g:ライデン_003]
		//だが大統領は……。
	}
	talk ローズ 標準 -m {
		 [PC_愛国者達__g:ローズ_004]
		//ジャック、データはないの。
	}
	talk ライデン 標準 -m {
		 [PC_愛国者達__g:ライデン_005]
		//大佐、あんたは何か知ってるんじゃ
		//ないのか？
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_愛国者達__g:大佐_006]
		//いや。何も知らん……。
		//もう少し時間をくれ。
	}
}//v
}//d



//オセロットはなぜ大統領を殺したのか？ h //e
//resource PC_大統領後＿なぜ大統領を殺したのか
proc rp_PC_大統領後＿なぜ大統領を殺したのか:03  {
vox t:vc266211 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_大統領後＿なぜ大統領を殺したのか__g:ライデン_000]
		//大佐、なぜオセロットは大統領を
		//殺したんだろう？
	}
	talk 大佐 標準 -m {
		 [PC_大統領後＿なぜ大統領を殺したのか__g:大佐_001]
		//仲間割れじゃないか？
	}
	talk ライデン 標準 -m {
		 [PC_大統領後＿なぜ大統領を殺したのか__g:ライデン_002]
		//……似てないか？
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_大統領後＿なぜ大統領を殺したのか__g:大佐_003]
		//何だって？
	}
	talk ライデン 標準 -m {
		 [PC_大統領後＿なぜ大統領を殺したのか__g:ライデン_004]
		//シャドーモセス事件とだ。
	}
	talk 大佐 標準 -m {
		 [PC_大統領後＿なぜ大統領を殺したのか__g:大佐_005]
		//馬鹿な……。
	}
	talk ライデン 標準 -m {
		 [PC_大統領後＿なぜ大統領を殺したのか__g:ライデン_006]
		//そう言い切れるか？
		//エイムズの死、忍者の出現、大統領の死、
		//そしてウィルス……。
	}
	talk ライデン 標準 -m {
		 [PC_大統領後＿なぜ大統領を殺したのか__g:ライデン_006_1]
		//そう言い切れるか？
		//エイムズの死、忍者の出現、大統領の死、
		//そしてウィルス……。
	}
	talk 大佐 標準 -m {
		 [PC_大統領後＿なぜ大統領を殺したのか__g:大佐_007]
		//考え過ぎだ。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_大統領後＿なぜ大統領を殺したのか__g:ローズ_008]
		//そうよ、ジャック。
		//あなたは疲れてるの。
	}
	talk ライデン 標準 -m {
		 [PC_大統領後＿なぜ大統領を殺したのか__g:ライデン_009]
		//……。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト＿是
@rp_無茶指令＿否１＿お前がやれ系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_大統領後＿なぜ大統領を殺したのか__g:大佐_010]
		//ライデン、余計なことは考えるな。
		//任務を遂行することに全力を注ぐんだ。
		//いいな。
	}
	talk 大佐 標準 -m {
		 [PC_大統領後＿なぜ大統領を殺したのか__g:大佐_010_1]
		//ライデン、余計なことは考えるな。
		//任務を遂行することに全力を注ぐんだ。
		//いいな。
	}
}//v
}//d


//タンカー編整理後 d //e
//スネークのこと h //e
//resource PC_大統領後＿スネーク
proc rp_PC_大統領後＿スネーク:03  {
vox t:vc266221 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_大統領後＿スネーク__g:ライデン_000]
		//大佐、聞いたか、シャドーモセスの
		//真実を？
	}
	talk 大佐 標準 -m {
		 [PC_大統領後＿スネーク__g:大佐_001]
		//ああ。
	}
	talk ライデン 標準 -m {
		 [PC_大統領後＿スネーク__g:ライデン_002]
		//スネークはテロリストではなかった。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_大統領後＿スネーク__g:ローズ_003]
		//うれしそうね？
	}
	talk ライデン 標準 -m {
		 [PC_大統領後＿スネーク__g:ライデン_004]
		//ん？ああ……。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_大統領後＿スネーク__g:大佐_005]
		//それで君はあの男の言ったことを
		//そのまま信じているのか？
	}
	talk ライデン 標準 -m {
		 [PC_大統領後＿スネーク__g:ライデン_006]
		//なんだって？
	}
	talk 大佐 標準 -m {
		 [PC_大統領後＿スネーク__g:大佐_007]
		//奴を信用するな。
		//奴はシミュレーションには入っていない。
	}
	talk ライデン 標準 -m {
		 [PC_大統領後＿スネーク__g:ライデン_008]
		//またシミュレーションか？
		//一体どういうことなんだ？
	}
	talk 大佐 標準 -m {
		 [PC_大統領後＿スネーク__g:大佐_009]
		//奴を頼るな。君の力で任務を
		//遂行するんだ。いいな。ライデン。
	}
}//v
}//d

