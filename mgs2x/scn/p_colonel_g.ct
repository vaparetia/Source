		//かぶれることがある。剪定する時は
		//手袋をした方がいいかもしれんな。
	}
}//v
}//d

//追加 d //e
//没！ＸＸＸＸＸＸＸＸＸＸｘ
//Ｄ脚みずしぶき警告 h //e
//resource PC_Ｄ脚＿水飛沫
proc rp_PC_Ｄ脚＿水飛沫:03  {
//vox t:vc266851 {
	talk 大佐 標準 -m {
		 [PC_Ｄ脚＿水飛沫__g:大佐_000]
		//ライデン、そこの貯水槽は泳ぐことが
		//出来る。泳がなければ辿り着けない
		//ところもあるはずだ。
	}
	talk 大佐 標準 -m {
		 [PC_Ｄ脚＿水飛沫__g:大佐_001]
		//だが気をつけろ。水面に勢いよく落ちる
		//と水しぶきが上がってしまう。敵にその
		//音を聞きつけられたら厄介なことになる。
	}
	talk 大佐 標準 -m {
		 [PC_Ｄ脚＿水飛沫__g:大佐_001_1]
		//だが気をつけろ。水面に勢いよく落ちる
		//と水しぶきが上がってしまう。敵にその
		//音を聞きつけられたら厄介なことになる。
	}
	talk 大佐 標準 -m {
		 [PC_Ｄ脚＿水飛沫__g:大佐_002]
		//音をさせないように水面へ下りるには、
		//ハシゴを使えばいいだろう。
	}
//}//v
}//d


//ソリダス戦中 愛国説教 h //e
//resource PC_ソリダス戦中＿愛国説教
proc rp_PC_ソリダス戦中＿愛国説教:03  {
vox t:vc266861 {
@rp_うなづきデフォルト＿是
@rp_邪道外道＿否１＿サイテー系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_ソリダス戦中＿愛国説教__g:大佐_000]
		//ライデン、ソリダスと戦え！
		//それが君の最後の役割だ！
	}
	talk ライデン 標準 -m {
		 [PC_ソリダス戦中＿愛国説教__g:ライデン_001]
		//俺達はシミレーション・ゲームの
		//駒じゃない！
	}
	@rpd_ローズ顔表示
@rp_愛国ローズ白目変化
@rp_セクハラ＿是１＿かわいい系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_ソリダス戦中＿愛国説教__g:ローズ_002]
		//いいえ。あなた達はただの兵器。
		//戦闘機や戦車とかわりないのよ。
	}
@rp_愛国ローズ白目変化
	talk ライデン 標準 -m {
		 [PC_ソリダス戦中＿愛国説教__g:ライデン_003]
		//なんだと？
	}
	
	@rp_発狂中大佐顔初期化処理
	@rp_大佐発狂中顔表示
@rp_うなづきデフォルト＿是
	talk 大佐 標準 -m {
		 [PC_ソリダス戦中＿愛国説教__g:大佐_004]
		//４年前に破壊された旧型は『ＲＥＸ』……
	}
	@rpd_ローズ顔表示
@rp_愛国ローズ白目変化
@rp_セクハラ＿是＿やりたがり系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_ソリダス戦中＿愛国説教__g:ローズ_005]
		//新型の水陸両用は『ＲＡＹ』……
	}
	
	@rp_発狂中大佐顔初期化処理
	@rp_大佐発狂中顔表示
@rp_うなづきデフォルト＿是

	talk 大佐 標準 -m {
		 [PC_ソリダス戦中＿愛国説教__g:大佐_006]
		//どちらも第二次大戦中、米軍が日本軍の
		//軍用機につけたコードネーム。
	}
	talk 大佐 標準 -m {
		 [PC_ソリダス戦中＿愛国説教__g:大佐_006_1]
		//どちらも第二次大戦中、米軍が日本軍の
		//軍用機につけたコードネーム。
	}
	@rpd_ローズ顔表示
@rp_愛国ローズ白目変化
@rp_セクハラ＿是１＿かわいい系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_ソリダス戦中＿愛国説教__g:ローズ_007]
		//あなたのコードネーム『ライデン』も
		//日本海軍の局地戦闘機『雷電』から
		//来ている……。
	}
@rp_愛国ローズ白目変化
	talk ライデン 標準 -m {
		 [PC_ソリダス戦中＿愛国説教__g:ライデン_008]
		//ふざけるな！俺は兵器じゃない！！
	}
@rp_愛国ローズ白目変化
	talk ローズ 標準 -m {
		 [PC_ソリダス戦中＿愛国説教__g:ローズ_009]
		//そうかしら？
		//『雷電』に米軍がつけたコードネームが
		//なんだか知ってる？
	}
	@rp_発狂中大佐顔初期化処理
	@rp_大佐発狂中顔表示
@rp_うなづきデフォルト＿是
	talk 大佐 標準 -m {
		 [PC_ソリダス戦中＿愛国説教__g:大佐_010]
		//ジャックだよ。
	}
	talk 大佐 標準 -m {
		 [PC_ソリダス戦中＿愛国説教__g:大佐_011]
		//貴様らは利用されて捨てられる
		//兵器なのだ。
	}
	@rpd_ローズ顔表示
@rp_愛国ローズ白目変化
@rp_セクハラ＿是＿やりたがり系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_ソリダス戦中＿愛国説教__g:ローズ_012]
		//兵器として戦場で利用される。
		//まさにゲームの駒。
	}
	@rp_発狂中大佐顔初期化処理
	@rp_大佐発狂中顔表示
@rp_うなづきデフォルト＿是
	talk 大佐 標準 -m {
		 [PC_ソリダス戦中＿愛国説教__g:大佐_013]
		//兵器に考える資格はない！
		//さあ、役割を果たせ！
		//ソリダスを倒すんだ！！
	}
	talk 大佐 標準 -m {
		 [PC_ソリダス戦中＿愛国説教__g:大佐_013_1]
		//兵器に考える資格はない！
		//さあ、役割を果たせ！
		//ソリダスを倒すんだ！！
	}
}//v
}//d

