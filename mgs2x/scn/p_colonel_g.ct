		//屋上に行った敵が戻って来て、
		//倒れた仲間を発見すれば警戒を強化する
		//だろう。面倒なことになる。
	}
	talk 大佐 標準 -m {
		 [PC_Ａ脚１Ｆ死体隠せ１__g:大佐_001_1]
		//屋上に行った敵が戻って来て、
		//倒れた仲間を発見すれば警戒を強化する
		//だろう。面倒なことになる。
	}
}//v
}//d
