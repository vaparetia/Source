//改造コードの話。 h //e
//resource PC_発狂＿改造コード
proc rp_PC_発狂＿改造コード:03  {
vox t:vc266791 {
@rp_うなづきデフォルト＿是
@rp_キテレツさん＿否２＿意味不明系デフォルト 50
	talk 大佐 標準 -m {
		 [PC_発狂＿改造コード__g:大佐_000]
		//まさか君は不正な手段でインチキな
		//スコアをだそうとはしていないだろうな？
		//それは最悪の行為だぞ。全く……。
	}
	talk 大佐 標準 -m {
		 [PC_発狂＿改造コード__g:大佐_000_1]
		//まさか君は不正な手段でインチキな
		//スコアをだそうとはしていないだろうな？
		//それは最悪の行為だぞ。全く……。
	}
}//v
}//d

//誰も知らない人の話をする。 h //e
//resource PC_発狂＿知らない人
proc rp_PC_発狂＿知らない人:03  {
