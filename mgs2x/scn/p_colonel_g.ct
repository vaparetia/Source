//ファットマン戦 d //e
//ボムブラストスーツうんちく h //e
//resource PC_ファットマン戦＿ボムブラストスーツ１
proc rp_PC_ファットマン戦＿ボムブラストスーツ１:03  {
vox t:vc265911 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿ボムブラストスーツ１__g:大佐_000]
		//ファットマンが着ているのは
		//ボムブラストスーツ。
	}
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿ボムブラストスーツ１__g:大佐_001]
		//爆弾処理の際に着用し、着用者を爆風、
		//熱、破片から守るものだ。基本的に
		//防弾衣と同じ特殊繊維で出来ている。
	}
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿ボムブラストスーツ１__g:大佐_001_1]
		//爆弾処理の際に着用し、着用者を爆風、
		//熱、破片から守るものだ。基本的に
		//防弾衣と同じ特殊繊維で出来ている。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿ボムブラストスーツ１__g:大佐_002]
		//首と体の前面はラミネート・
		//バリスティック・インサートで
		//防護されている。
	}
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿ボムブラストスーツ１__g:大佐_003]
		//背面にも、爆風で吹き飛ばされた場合、
		//脊髄への衝撃を和らげるための
		//プロテクターが装備されている。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿ボムブラストスーツ１__g:大佐_004]
		//体への攻撃は効果が薄いだろう。
	}
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿ボムブラストスーツ１__g:大佐_005]
		//一見動きにくそうに見えるだろうが
		//爆弾処理に支障をきたさないよう、
		//非常にフレキシブルに作られている。
	}
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿ボムブラストスーツ１__g:大佐_005_1]
		//一見動きにくそうに見えるだろうが
		//爆弾処理に支障をきたさないよう、
		//非常にフレキシブルに作られている。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿ボムブラストスーツ１__g:大佐_006]
		//鞍馬や平行棒のような器械体操まで
		//こなせるそうだ。
	}
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿ボムブラストスーツ１__g:大佐_007]
		//問題としては通気性が悪く、長時間
		//着ていると着用者が熱中症を起こす
		//という可能性がある。
	}
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿ボムブラストスーツ１__g:大佐_007_1]
		//問題としては通気性が悪く、長時間
		//着ていると着用者が熱中症を起こす
		//という可能性がある。
	}
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿ボムブラストスーツ１__g:大佐_008]
		//だがそのスーツには宇宙服と同様に
		//冷却水をチューブに流す冷却システムが
		//備えられている。
	}
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿ボムブラストスーツ１__g:大佐_008_1]
		//だがそのスーツには宇宙服と同様に
		//冷却水をチューブに流す冷却システムが
		//備えられている。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿ボムブラストスーツ１__g:大佐_009]
		//奴が熱中症で倒れることはないだろうな。
	}
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿ボムブラストスーツ１__g:大佐_010]
		//しかしそのコンフィギュレーション
		//ならスーツの総重量は５０キロを超える。
	}
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿ボムブラストスーツ１__g:大佐_011]
		//ローラーブレードで走るには重過ぎる
		//重量だ。衝撃を加えればバランスを
		//崩して転ぶこともあるだろう。
	}
	talk 大佐 標準 -m {
		 [PC_ファットマン戦＿ボムブラストスーツ１__g:大佐_011_1]
		//ローラーブレードで走るには重過ぎる
		//重量だ。衝撃を加えればバランスを
		//崩して転ぶこともあるだろう。
	}
}//v
}//d
