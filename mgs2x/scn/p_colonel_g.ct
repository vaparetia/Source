//マイクの使い方 h //e
//resource PC_人質＿マイク使い方
proc rp_PC_人質＿マイク使い方:03  {
vox d:_vc261881 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_人質＿マイク使い方__g:大佐_000]
		//指向性マイクを装備すると主観画面に
		//なる。左スティックでマイクを人質の
		//方向に向けるんだ。
	}
	talk 大佐 標準 -m {
		 [PC_人質＿マイク使い方__g:大佐_000_1]
		//指向性マイクを装備すると主観画面に
		//なる。左スティックでマイクを人質の
		//方向に向けるんだ。
	}
	talk 大佐 標準 -m {
		 [PC_人質＿マイク使い方__g:大佐_001]
		//それで人質の心音を聞くことが出来る。
		//ペースメイカーの音を聞き分けろ。
	}
	talk 大佐 標準 -m {
		 [PC_人質＿マイク使い方__g:大佐_001_1]
		//それで人質の心音を聞くことが出来る。
		//ペースメイカーの音を聞き分けろ。
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_人質＿マイク使い方__g:大佐_002]
		//その相手がエイムズだと確信したら
		//マイクを向けたまま△ボタンを押して
		//呼びかけるんだ。
	}
	talk 大佐 標準 -m {
		 [PC_人質＿マイク使い方__g:大佐_002_1]
		//その相手がエイムズだと確信したら
		//マイクを向けたまま△ボタンを押して
		//呼びかけるんだ。
	}
	talk 大佐 標準 -m {
		 [PC_人質＿マイク使い方__g:大佐_003]
		//手当たり次第に呼びかけたりするなよ。
		//敵に怪しまれるぞ。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_人質＿マイク使い方__g:ローズ_004]
		//あと指向性マイクを装備している間は
		//移動が出来なくなるから気をつけてね。
	}
	talk ローズ 標準 -m {
		 [PC_人質＿マイク使い方__g:ローズ_004_1]
		//あと指向性マイクを装備している間は
		//移動が出来なくなるから気をつけてね。
	}
}//v
}//d
