//後回し会話 d //e
//海底ドック d //e
//フナムシ説明 h//e
//resource PC_フナムシ１
/*
proc rp_PC_フナムシ１:03  {
vox t:vc265131 {
	@rpb_PC_フナムシ１
}//v
}//d
*/

proc rpb_PC_フナムシ１:03  {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_フナムシ１__g:ライデン_000]
		//すこい虫だ……。海水が原油で汚染
		//されているのに、なぜフナムシが？
	}
	talk ライデン 標準 -m {
		 [PC_フナムシ１__g:ライデン_000_1]
		//すこい虫だ……。海水が原油で汚染
		//されているのに、なぜフナムシが？
	}
}//d
//無線機内スクリーンに船虫の映像か、ＰＩＣＴ。 t//e
//resource PC_フナムシ２
/*
proc rp_PC_フナムシ２:03  {
vox t:vc265141 {
	@rpb_PC_フナムシ２
}//v
}//d
*/

proc rpb_PC_フナムシ２:03  {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_フナムシ２__g:大佐_000]
		//その虫は原油を分解する働きを持った、
		//言わば創られた虫だ。
	}
	talk ライデン 標準 -m {
		 [PC_フナムシ２__g:ライデン_001]
		//創られた？
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_フナムシ２__g:大佐_002]
		//ああ。遺伝子操作でな。頻繁に発生する
		//原油流出事故対応の為に研究所で
		//生まれたものだ。自然界には存在しない。
	}
	talk 大佐 標準 -m {
		 [PC_フナムシ２__g:大佐_002_1]
		//ああ。遺伝子操作でな。頻繁に発生する
		//原油流出事故対応の為に研究所で
		//生まれたものだ。自然界には存在しない。
	}
	talk 大佐 標準 -m {
		 [PC_フナムシ２__g:大佐_003]
		//その虫には石油を分解するバクテリア、
		//プセドウモナスの遺伝子が取り入れて
		//ある。
	}
	talk 大佐 標準 -m {
		 [PC_フナムシ２__g:大佐_003_1]
		//その虫には石油を分解するバクテリア、
		//プセドウモナスの遺伝子が取り入れて
		//ある。
	}
	talk 大佐 標準 -m {
		 [PC_フナムシ２__g:大佐_004]
		//体内に石油を分解する酵素を持って
		//いて、吸着した原油を食べる習性を
		//与えられているんだ。
	}
	talk 大佐 標準 -m {
		 [PC_フナムシ２__g:大佐_004_1]
		//体内に石油を分解する酵素を持って
		//いて、吸着した原油を食べる習性を
		//与えられているんだ。
	}
@rp_うなづきデフォルト＿是
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_フナムシ２__g:大佐_005]
		//『ビッグ・シェル』があまり油で
		//汚れていないのはその虫のおかげとも
		//言える。
	}
	talk 大佐 標準 -m {
		 [PC_フナムシ２__g:大佐_006]
		//メンテナンス要員と費用の削減にも
		//役立っている。
	}
	talk 大佐 標準 -m {
		 [PC_フナムシ２__g:大佐_007]
		//一種のバイオレメディエーションだ。
		//基本的に害はないから安心しろ。
	}
}//d
//resource PC_フナムシ４
proc rp_PC_フナムシ４:03  {
vox t:vc265151 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_フナムシ４__g:大佐_000]
		//そこにいる虫は食欲旺盛だ。
		//レーションを食われないように注意しろ。
	}
}//v
}//d


