		//報復に人質が殺されたことも
		//知らなかったようだが？
	}
	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿人質__g:大佐_001]
		//ああ。おそらく人質は他の部屋にも
		//いたんだろう。
