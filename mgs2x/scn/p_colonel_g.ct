		//ライデン、腰くらいの高さのものは
		//△ボタンを押せば上に登ることが
		//出来る。うまく使うんだ。
	}
	talk 大佐 標準 -m {
		 [PC_段差上り１__g:大佐_000_1]
		//ライデン、腰くらいの高さのものは
		//△ボタンを押せば上に登ることが
		//出来る。うまく使うんだ。
	}
