	talk 大佐 標準 -m {
		 [PC_エイムズ死後＿人質__g:大佐_003_1]
		//ライデン、任務に集中しろ。
		//今は大統領救出に集中するんだ。
		//シェル２中央棟の１Ｆに向かえ。
