proc rp_PC_エルード１の２:03  {
vox t:vc260351 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エルード１の２__g:大佐_000]
		//これがエルードだ。敵の視界を避ける
		//だけでなく、歩いては行けない場所に
		//辿り着くことも出来るかもしれない。
	}
	talk 大佐 標準 -m {
		 [PC_エルード１の２__g:大佐_000_1]
		//これがエルードだ。敵の視界を避ける
		//だけでなく、歩いては行けない場所に
		//辿り着くことも出来るかもしれない。
	}
}//v
}//d
