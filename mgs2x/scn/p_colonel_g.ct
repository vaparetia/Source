	talk ライデン 標準 -m {
		 [PC_Ｃ脚女子トイレピーター前__g:ライデン_001]
		//いや、爆弾処理の教官がいるかと……。
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_Ｃ脚女子トイレピーター前__g:ローズ_002]
		//いるわけないでしょ。
	}
	talk ライデン 標準 -m {
		 [PC_Ｃ脚女子トイレピーター前__g:ライデン_003]
		//わからないじゃないか。
		//異常事態なんだし……。
	}
@rp_つっこまれ＿是１＿なんで知ってるんだ系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_Ｃ脚女子トイレピーター前__g:ローズ_004]
		//異常事態でも普通の男の人は
		//女性用トイレになんか入りません！
		//そんなのあなただけ！
	}
	talk ローズ 標準 -m {
		 [PC_Ｃ脚女子トイレピーター前__g:ローズ_004_1]
		//異常事態でも普通の男の人は
		//女性用トイレになんか入りません！
		//そんなのあなただけ！
	}
@rp_つっこまれ＿否１＿逆ギレ系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_Ｃ脚女子トイレピーター前__g:ローズ_005]
		//っていうか、あなたが異常！！
