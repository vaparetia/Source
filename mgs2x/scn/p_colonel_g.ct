//resource PC_ファットマンについて３
proc rp_PC_ファットマンについて３:03  {
vox t:vc265861 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_ファットマンについて３__g:ローズ_000]
		//ジャック、ファットマンについて
		//調べたわ。
	}
	talk ローズ 標準 -m {
		 [PC_ファットマンについて３__g:ローズ_001]
		//爆弾王ファットマン。
		//１０歳の時に原爆を組み立てたって
		//話は聞いたわよね。
	}
	talk ローズ 標準 -m {
		 [PC_ファットマンについて３__g:ローズ_001_1]
		//爆弾王ファットマン。
		//１０歳の時に原爆を組み立てたって
		//話は聞いたわよね。
	}
	talk ローズ 標準 -m {
		 [PC_ファットマンについて３__g:ローズ_002]
		//子供の頃から爆弾の世界では名前を
		//知られていたみたい。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_ファットマンについて３__g:ローズ_003]
		//インディアンヘッドの海軍爆発物処理
		//専門学校に入学。首席で卒業。
		//スティルマンさんに会ったのはこの頃ね。
	}
	talk ローズ 標準 -m {
		 [PC_ファットマンについて３__g:ローズ_003_1]
		//インディアンヘッドの海軍爆発物処理
		//専門学校に入学。首席で卒業。
		//スティルマンさんに会ったのはこの頃ね。
	}
	talk ローズ 標準 -m {
		 [PC_ファットマンについて３__g:ローズ_004]
		//そして核緊急捜索チームに加入。
		//でもすぐに辞めている。
	}
	talk ローズ 標準 -m {
		 [PC_ファットマンについて３__g:ローズ_005]
		//その後デッドセルに爆弾の専門家として
		//参加……今にいたるというわけね。
	}
}//v
}//d
