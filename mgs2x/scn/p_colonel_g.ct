		 [PC_Ｃ脚女子トイレピーター前__g:ローズ_007]
		//ですが……。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_Ｃ脚女子トイレピーター前__g:大佐_008]
