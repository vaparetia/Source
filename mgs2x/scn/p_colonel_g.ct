//ＭＧＳのメイリンの格言１ h //e
//resource PC_発狂＿格言１
proc rp_PC_発狂＿格言１:03  {
//vox t:vc266641 
movie t:vc266641 {
@rp_うなづきデフォルト＿是
@rp_キテレツさん＿否２＿意味不明系デフォルト 50
	talk 大佐 標準 -m {
		 [PC_発狂＿格言１__g:大佐_000]
		//中国にはね、『匹夫の勇、一人に敵する
		//ものなり』っていう諺があるの。
	}
	talk 大佐 標準 -m {
		 [PC_発狂＿格言１__g:大佐_000_1]
		//中国にはね、『匹夫の勇、一人に敵する
		//ものなり』っていう諺があるの。
	}
@rp_大佐発狂中顔表示
	talk 大佐 標準 -m {
		 [PC_発狂＿格言１__g:大佐_001]
		//無闇に戦いを求める愚か者の勇気は、
		//一人の敵を相手にするのが
		//精いっぱいって意味よ。
	}
@rp_大佐発狂中顔表示
	talk 大佐 標準 -m {
		 [PC_発狂＿格言１__g:大佐_002]
		//スネークはたった一人で敵の中に
		//潜入してるんだから、やたらと戦闘を
		//仕掛けたりしないで、慎重に行動してね。
	}
}//v
}//d

//ＭＧＳのメイリンの格言２ h //e
//resource PC_発狂＿格言２
proc rp_PC_発狂＿格言２:03  {
vox t:vc266651 {
@rp_うなづきデフォルト＿是
@rp_キテレツさん＿否２＿意味不明系デフォルト 50
	talk 大佐 標準 -m {
		 [PC_発狂＿格言２__g:大佐_000]
		//中国では『欲多ければ則ち生を傷る』っ
		//て言うことがあるの。
	}
	talk 大佐 標準 -m {
		 [PC_発狂＿格言２__g:大佐_000_1]
		//中国では『欲多ければ則ち生を傷る』っ
		//て言うことがあるの。
	}
@rp_大佐発狂中顔表示
	talk 大佐 標準 -m {
		 [PC_発狂＿格言２__g:大佐_001]
		//欲をかくと、体を傷めることになるって
		//いう意味よ。
	}
@rp_大佐発狂中顔表示
	talk 大佐 標準 -m {
		 [PC_発狂＿格言２__g:大佐_002]
		//アイテムを取るのに欲張りすぎると、
		//怪我をするわ。気をつけてね。
	}
}//v
}//d

