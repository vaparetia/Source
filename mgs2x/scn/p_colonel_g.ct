//主観左右ステップ h //e
//resource PC_主観左右ステップ
proc rp_PC_主観左右ステップ:03  {
vox d:_vc264771 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_主観左右ステップ__g:大佐_000]
		//ライデン、主観カメラの時にＲ１ボタン
		//を押すと右、Ｌ１ボタンを押すと左に
		//一歩ステップすることが出来る。
	}
	talk 大佐 標準 -m {
		 [PC_主観左右ステップ__g:大佐_000_1]
		//ライデン、主観カメラの時にＲ１ボタン
		//を押すと右、Ｌ１ボタンを押すと左に
		//一歩ステップすることが出来る。
	}
	talk 大佐 標準 -m {
		 [PC_主観左右ステップ__g:大佐_001]
		//物陰からさっと体を出して、
		//先の様子を伺うことができるわけだ。
	}
	talk 大佐 標準 -m {
		 [PC_主観左右ステップ__g:大佐_002]
		//だが物陰から出てる間は、
		//当然見つかりやすくなる。
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_主観左右ステップ__g:大佐_003]
		//だから敵が迫ってきたらボタンを離して
		//すぐに物陰に戻る事を忘れるな。
	}
}//v
}//d
//無線操作 h //e
//resource PC_無線操作
proc rp_PC_無線操作:03  {
vox d:_vc264781 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_無線操作__g:大佐_000]
		//無線機画面に入ったら、左スティックの
		//左右で周波数を合わるんだ。
	}
	talk 大佐 標準 -m {
		 [PC_無線操作__g:大佐_001]
		//それから左スティックの上か○ボタンを
		//押せば、その周波数で通信をすることが
		//できる。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_無線操作__g:大佐_002]
		//無線機には一度会話した相手の周波数を
		//記憶しておく機能もついている。
	}
	talk 大佐 標準 -m {
		 [PC_無線操作__g:大佐_003]
		//無線機画面で左スティックの下を押せば、
		//メモリーウインドウが開く。
	}
	talk 大佐 標準 -m {
		 [PC_無線操作__g:大佐_004]
		//メモリーウインドウの中には、
		//記憶された周波数のリストが表示される。
	}
	talk 大佐 標準 -m {
		 [PC_無線操作__g:大佐_005]
		//通信したい周波数を選択して○ボタンを
		//押すだけで、その周波数で通信を
		//することが出来るぞ。
	}
}//v
}//d

