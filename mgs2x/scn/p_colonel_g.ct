//ローズの浮気をちくる h //e
//resource PC_発狂＿ローズの浮気
proc rp_PC_発狂＿ローズの浮気:03  {
vox t:vc266831 {
@rp_うなづきデフォルト＿是
@rp_キテレツさん＿否２＿意味不明系デフォルト 50
	talk 大佐 標準 -m {
		 [PC_発狂＿ローズの浮気__g:大佐_000]
		//実は言うべきか言うまいか迷っていた
		//ことがあってな……。
		//やはり言っておこうと思う。
	}
	talk 大佐 標準 -m {
		 [PC_発狂＿ローズの浮気__g:大佐_000_1]
		//実は言うべきか言うまいか迷っていた
		//ことがあってな……。
		//やはり言っておこうと思う。
	}
@rp_大佐発狂中顔表示
	talk 大佐 標準 -m {
		 [PC_発狂＿ローズの浮気__g:大佐_001]
		//先週の土曜日の朝……
		//ローズ君の部屋から男が出てくるのを
		//見たんだ……。
	}
@rp_大佐発狂中顔表示
	talk 大佐 標準 -m {
		 [PC_発狂＿ローズの浮気__g:大佐_002]
		//なんというか、その……とても親密な
		//感じだった。すまない。
		//任務中にこんなことを……。
	}
	talk 大佐 標準 -m {
		 [PC_発狂＿ローズの浮気__g:大佐_002_1]
		//なんというか、その……とても親密な
		//感じだった。すまない。
		//任務中にこんなことを……。
	}
}//v
}//d

//役に立つ豆知識 h //e
