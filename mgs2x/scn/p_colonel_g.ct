//resource PC_エイムズ２
proc rp_PC_エイムズ２:03  {
vox t:vc265981 {
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_エイムズ２__g:ローズ_000]
		//大統領に随伴したシークレットサービス
		//の名簿を調べてみた。確かにエイムズっ
		//ていういう名前があるわ。
	}
	talk ローズ 標準 -m {
		 [PC_エイムズ２__g:ローズ_000_1]
		//大統領に随伴したシークレットサービス
		//の名簿を調べてみた。確かにエイムズっ
		//ていういう名前があるわ。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エイムズ２__g:大佐_001]
		//あの忍者の言ったことは嘘ではなかった
		//ということだな。
	}
	talk ライデン 標準 -m {
		 [PC_エイムズ２__g:ライデン_002]
		//リストの上ではな。
		//ローズ、他に情報は？
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_エイムズ２__g:ローズ_003]
		//わかった。調べてみる。
	}
	talk ライデン 標準 -m {
		 [PC_エイムズ２__g:ライデン_004]
		//頼む。
	}
}//v
}//d
//エイムズしばらくしてから h //e
//resource PC_エイムズ２＿２
proc rp_PC_エイムズ２＿２:03  {
vox t:vc265991 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エイムズ２＿２__g:大佐_000]
		//ライデン、ローズ君から報告がある。
		//エイムズについてだ。
	}
}//v
}//d
//resource PC_エイムズ３
proc rp_PC_エイムズ３:03  {
vox t:vc266001 {
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_エイムズ３__g:ローズ_000]
		//ジャック？
		//エイムズのことだけど……。
	}
	talk ライデン 標準 -m {
		 [PC_エイムズ３__g:ライデン_001]
		//何かわかったか？
	}
@rp_キテレツさん＿否２＿意味不明系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_エイムズ３__g:ローズ_002]
		//ええ。
		//何もわからないってことがわかった。
	}
	talk ライデン 標準 -m {
		 [PC_エイムズ３__g:ライデン_003]
		//なんだって？
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_エイムズ３__g:ローズ_004]
		//記録が何もないの。社会保障番号や
		//住所、経歴はおろか、性別も年齢も
		//フルネームさえ……。
	}
	talk ローズ 標準 -m {
		 [PC_エイムズ３__g:ローズ_004_1]
		//記録が何もないの。社会保障番号や
		//住所、経歴はおろか、性別も年齢も
		//フルネームさえ……。
	}
	talk ライデン 標準 -m {
		 [PC_エイムズ３__g:ライデン_005]
		//どういうことだ？
	}
	talk ローズ 標準 -m {
		 [PC_エイムズ３__g:ローズ_006]
		//わからない。わかったのはエイムズ。
		//その一語だけ。
	}
	talk ライデン 標準 -m {
		 [PC_エイムズ３__g:ライデン_007]
		//……。
	}
}//v
}//d
//resource PC_エイムズ４
proc rp_PC_エイムズ４:03  {
vox t:vc266011 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エイムズ４__g:大佐_000]
		//それでも大統領への手がかりはエイムズ
		//だけだ。接触してみるしかない。
		//シェル１中央棟のＢ１に向かうんだ。
	}
	talk 大佐 標準 -m {
		 [PC_エイムズ４__g:大佐_000_1]
		//それでも大統領への手がかりはエイムズ
		//だけだ。接触してみるしかない。
