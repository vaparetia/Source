proc rp_PC_エルード３の２:03  {
vox t:vc260391 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エルード３の２__g:大佐_000]
		//握力ゲージが無くなると、落下して
		//しまうぞ。そうなる前に這い上がるんだ。
	}
}//v
}//d
//エルード飛び降り h //e
//＊ムービー t //e
//resource PC_エルード＿飛び降り１
proc rp_PC_エルード＿飛び降り１:03  {
vox t:vc260401 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エルード＿飛び降り１__g:大佐_000]
		//エルード中に×ボタンを押すと、
		//その場から真下に飛び降りる。
	}
}//v
}//d
//＊ムービー t //e
//resource PC_エルード＿飛び降り２
proc rp_PC_エルード＿飛び降り２:03  {
vox t:vc260411 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エルード＿飛び降り２__g:大佐_000]
		//だが高過ぎる所から落ちるとＬＩＦＥが
		//減るぞ。飛び降りる時は主観で真下を
		//確認してからにするんだ。
	}
	talk 大佐 標準 -m {
		 [PC_エルード＿飛び降り２__g:大佐_000_1]
		//だが高過ぎる所から落ちるとＬＩＦＥが
		//減るぞ。飛び降りる時は主観で真下を
		//確認してからにするんだ。
	}
}//v
}//d

//プレイヤーの催促 h //e
//長時間いると催促される t //e
//resource PC_海底ドック催促
proc rp_PC_海底ドック催促:03  {
vox t:vc260421 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_海底ドック催促__g:大佐_000]
		//ライデン、もう操作には充分慣れた
		//だろう？任務を進めてくれ。時間がない。
	}
	talk 大佐 標準 -m {
		 [PC_海底ドック催促__g:大佐_000_1]
		//ライデン、もう操作には充分慣れた
		//だろう？任務を進めてくれ。時間がない。
	}
	talk 大佐 標準 -m {
		 [PC_海底ドック催促__g:大佐_001]
		//そのエリアの奥にある昇降機に乗って、
		//『ビッグ・シェル』上部に上がるんだ。
	}
}//v
}//d


//水密扉。近くでＣＡＬＬ h //e
//resource PC_水密扉１
proc rp_PC_水密扉１:03  {
vox t:vc260431 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_水密扉１__g:大佐_000]
		//ライデン、その扉は水密扉だ。
	}
}//v
}//d
//タンカー編をプレイしているユーザーの場合 t //e
//resource PC_水密扉２
/*
proc rp_PC_水密扉２:03  {
vox t:vc260441 {
	@rpb_PC_水密扉２
}//v
}//d
*/

proc rpb_PC_水密扉２:03  {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_水密扉２__g:ライデン_000]
		//ああ。開け方はわかっている。
		//ＶＲ訓練で経験済みだ。
	}
	talk 大佐 標準 -m {
		 [PC_水密扉２__g:大佐_001]
		//そうだったな。
		//慎重に行けよ。
	}
}//d
//タンカー編をプレイしていないユーザーの場合 t //e
//resource PC_水密扉３
proc rp_PC_水密扉３:03  {
vox t:vc260451 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_水密扉３__g:大佐_000]
		//その扉を開けるには、
		//ハンドルを回さなければならない。
	}
	talk 大佐 標準 -m {
		 [PC_水密扉３__g:大佐_001]
		//ハンドルを回すには扉に向かって
		//△ボタンを押したままにすればいい。
	}
	talk 大佐 標準 -m {
		 [PC_水密扉３__g:大佐_002]
		//早く回したければ△ボタンを連打する
		//ことだ。
	}
}//v
}//d

//昇降機ホール h //e
//放置武器使用不可の説明 h //e
//敵兵を倒した際、敵兵の近くにいるとＣＡＬＬ。 t//e
//resource PC_敵武器使用不可１
/*
proc rp_PC_敵武器使用不可１:03  {
vox t:vc260461 {
	@rpb_PC_敵武器使用不可１
}//v
}//d
*/
proc rpb_PC_敵武器使用不可１:03  {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_敵武器使用不可１__g:大佐_000]
		//ライデン、敵の装備品は使用できないぞ。
	}
	talk ライデン 標準 -m {
		 [PC_敵武器使用不可１__g:ライデン_001]
		//なぜだ？
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
@rp_うんちく＿是１＿詳しいな系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_敵武器使用不可１__g:大佐_002]
		//わかっているだろうが、装備済みの
		//銃火器には全て個人認識装置が
		//埋め込まれている。
	}
	talk 大佐 標準 -m {
		 [PC_敵武器使用不可１__g:大佐_003]
		//銃火器登録時、あるいは作戦開始時に
		//認識データを入力する仕組みになって
		//いるのだ。
	}
	talk 大佐 標準 -m {
		 [PC_敵武器使用不可１__g:大佐_003_1]
		//銃火器登録時、あるいは作戦開始時に
		//認識データを入力する仕組みになって
		//いるのだ。
	}
	talk 大佐 標準 -m {
		 [PC_敵武器使用不可１__g:大佐_004]
		//その登録者以外がトリガーを引いても、
		//反応しないシステムが導入されている。
	}
	talk 大佐 標準 -m {
		 [PC_敵武器使用不可１__g:大佐_004_1]
		//その登録者以外がトリガーを引いても、
		//反応しないシステムが導入されている。
	}
	talk ライデン 標準 -m {
		 [PC_敵武器使用不可１__g:ライデン_005]
		//ロシアなどから密輸される闇銃火器には
		//これらの登録システムは採用されて
		//いないはずだが？
	}
	talk 大佐 標準 -m {
		 [PC_敵武器使用不可１__g:大佐_006]
		//自前で組み込んだのだろう。
		//彼らはプロだ。自分たちの装備が
		//我々の手に落ちないようにしている。
	}
	talk 大佐 標準 -m {
		 [PC_敵武器使用不可１__g:大佐_006_1]
		//自前で組み込んだのだろう。
		//彼らはプロだ。自分たちの装備が
		//我々の手に落ちないようにしている。
	}
	talk 大佐 標準 -m {
		 [PC_敵武器使用不可１__g:大佐_006_2]
		//自前で組み込んだのだろう。
		//彼らはプロだ。自分たちの装備が
		//我々の手に落ちないようにしている。
	}
	talk ライデン 標準 -m {
		 [PC_敵武器使用不可１__g:ライデン_007]
		//ＳＥＡＬＳの装備も同じか？
	}
	talk 大佐 標準 -m {
		 [PC_敵武器使用不可１__g:大佐_008]
		//そうだ。
	}
	talk ライデン 標準 -m {
		 [PC_敵武器使用不可１__g:ライデン_009]
		//では武器はどうやって
		//調達すればいいんだ？
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_敵武器使用不可１__g:大佐_010]
		//まだＩＤ登録されていないものを
		//探すんだ。
	}
	talk 大佐 標準 -m {
		 [PC_敵武器使用不可１__g:大佐_011]
		//登録前のものはアイテムボックスに
		//入っている。既にＶＲ訓練で学習済み
		//だろう。
	}
}//d
//無線機画面のスクリーン内にアイテムＢＯＸの映像。 t //e
//resource PC_敵武器使用不可２
/*
