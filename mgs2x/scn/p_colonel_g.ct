}//v
}//d


//Ｃ脚の役割について h //e
//resource PC_Ｃ脚機能説明
proc rp_PC_Ｃ脚機能説明:03  {
vox t:vc266431 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
