//各部の機能説明 d //e
//一般的説明 h //e
//resource PC_一般機能説明
proc rp_PC_一般機能説明:03  {
vox t:vc266401 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_一般機能説明__g:ローズ_000]
		//ジャック、『ビッグ・シェル』について
		//調べてみたの。
	}
	talk ローズ 標準 -m {
		 [PC_一般機能説明__g:ローズ_001]
		//２年前のタンカー沈没事件によって
		//大規模な原油流出が引き起こされた。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_一般機能説明__g:ローズ_002]
		//『ビッグ・シェル』はその原油を回収・
		//処理し、ＮＹ湾の環境回復を図るために
		//建設された海上除染施設なの。
	}
	talk ローズ 標準 -m {
		 [PC_一般機能説明__g:ローズ_002_1]
		//『ビッグ・シェル』はその原油を回収・
		//処理し、ＮＹ湾の環境回復を図るために
		//建設された海上除染施設なの。
	}
	talk ローズ 標準 -m {
		 [PC_一般機能説明__g:ローズ_003]
		//『ビッグ・シェル』の周囲の海域には
		//オイルフェンスが張り巡らされて原油の
		//拡散を防いでいる。
	}
	talk ローズ 標準 -m {
		 [PC_一般機能説明__g:ローズ_003_1]
		//『ビッグ・シェル』の周囲の海域には
		//オイルフェンスが張り巡らされて原油の
		//拡散を防いでいる。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_一般機能説明__g:ローズ_004]
		//フェンスのあちこちに尖塔が立ってる
		//でしょ。それが汚染海水をくみ上げる
		//ためのパイル。
	}
	talk ローズ 標準 -m {
		 [PC_一般機能説明__g:ローズ_004_1]
		//フェンスのあちこちに尖塔が立ってる
		//でしょ。それが汚染海水をくみ上げる
		//ためのパイル。
	}
	talk ローズ 標準 -m {
		 [PC_一般機能説明__g:ローズ_005]
		//くみ上げられた海水はＡ脚のポンプ室を
		//通って、一度Ｄ脚にある第一沈殿槽に
		//溜められて大きなゴミを取り除かれる。
	}
	talk ローズ 標準 -m {
		 [PC_一般機能説明__g:ローズ_005_1]
		//くみ上げられた海水はＡ脚のポンプ室を
		//通って、一度Ｄ脚にある第一沈殿槽に
		//溜められて大きなゴミを取り除かれる。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk ローズ 標準 -m {
		 [PC_一般機能説明__g:ローズ_006]
		//その後シェル２中央棟にある貯水槽で
		//微生物を使った二段階の浄化をされて
		//原油が取り除かれる。
	}
	talk ローズ 標準 -m {
		 [PC_一般機能説明__g:ローズ_006_1]
		//その後シェル２中央棟にある貯水槽で
		//微生物を使った二段階の浄化をされて
		//原油が取り除かれる。
	}
	talk ローズ 標準 -m {
		 [PC_一般機能説明__g:ローズ_007]
		//そしてＬ脚に送られて殺菌された後、
		//もう一度海上のパイルに送られて
		//放流されるって流れ。
	}
	talk ローズ 標準 -m {
		 [PC_一般機能説明__g:ローズ_007_1]
		//そしてＬ脚に送られて殺菌された後、
		//もう一度海上のパイルに送られて
		//放流されるって流れ。
	}
	talk ライデン 標準 -m {
		 [PC_一般機能説明__g:ライデン_008]
		//軍のデータベースには海上除染施設の
		//構造まで入力されてるのか。
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_一般機能説明__g:ローズ_009]
		//いいえ。データベースは使ってないわ。
	}
	talk ライデン 標準 -m {
		 [PC_一般機能説明__g:ライデン_010]
		//え？
	}
	talk ローズ 標準 -m {
		 [PC_一般機能説明__g:ローズ_011]
		//パンフレットに載ってたの。
	}
}//v
}//d


//Ａ脚の役割について h //e
//resource PC_Ａ脚機能説明
proc rp_PC_Ａ脚機能説明:03  {
vox t:vc266411 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_Ａ脚機能説明__g:ローズ_000]
		//Ａ脚は汚染海水を海上からくみ上げ、
		//『ビッグ・シェル』各部を巡回させる
		//ための動力を供給するポンプ施設ね。
	}
	talk ローズ 標準 -m {
		 [PC_Ａ脚機能説明__g:ローズ_000_1]
		//Ａ脚は汚染海水を海上からくみ上げ、
		//『ビッグ・シェル』各部を巡回させる
		//ための動力を供給するポンプ施設ね。
	}
	talk ローズ 標準 -m {
		 [PC_Ａ脚機能説明__g:ローズ_001]
		//南側がポンプ施設本体、
		//北側がその制御施設になってる。
	}
}//v
}//d

//Ｂ脚の役割について h //e
//resource PC_Ｂ脚機能説明
proc rp_PC_Ｂ脚機能説明:03  {
