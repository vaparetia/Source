//ツーハンを朗読 h //e
//resource PC_発狂＿ツーハン
proc rp_PC_発狂＿ツーハン:03  {
vox t:vc266711 {
@rp_うなづきデフォルト＿是
@rp_キテレツさん＿否２＿意味不明系デフォルト 50
	talk 大佐 標準 -m {
		 [PC_発狂＿ツーハン__g:大佐_000]
		//連続通信機ドラマ
		//「アイデアスパイ２．５」
		//第１回
	}
	talk 大佐 標準 -m {
		 [PC_発狂＿ツーハン__g:大佐_001]
		//ニューヨーク。人々の欲望渦巻くこの
		//大都会では、今日も誰かが何かを買い、
		//売り、そして捨て、平和に暮らしている。
	}
	talk 大佐 標準 -m {
		 [PC_発狂＿ツーハン__g:大佐_001_1]
		//ニューヨーク。人々の欲望渦巻くこの
		//大都会では、今日も誰かが何かを買い、
		//売り、そして捨て、平和に暮らしている。
	}
	talk 大佐 標準 -m {
		 [PC_発狂＿ツーハン__g:大佐_002]
		//だが、そんな平和の裏側で、粗悪な
		//商品を売りつけ私腹を肥やす悪の組織
		//『Ｊ・Ｅ社』が暗躍していた。
	}
	talk 大佐 標準 -m {
		 [PC_発狂＿ツーハン__g:大佐_002_1]
		//だが、そんな平和の裏側で、粗悪な
		//商品を売りつけ私腹を肥やす悪の組織
		//『Ｊ・Ｅ社』が暗躍していた。
	}
	talk 大佐 標準 -m {
		 [PC_発狂＿ツーハン__g:大佐_002_2]
		//だが、そんな平和の裏側で、粗悪な
		//商品を売りつけ私腹を肥やす悪の組織
		//『Ｊ・Ｅ社』が暗躍していた。
	}
	talk 大佐 標準 -m {
		 [PC_発狂＿ツーハン__g:大佐_003]
		//汚れなき市民を巧みに欺き、ガラクタを
		//高値で売りつける『Ｊ・Ｅ』の野望を
		//打ち砕くべく
	}
	talk 大佐 標準 -m {
		 [PC_発狂＿ツーハン__g:大佐_004]
		//ＦＢＩは極秘に対抗チームを結成。
	}
	talk 大佐 標準 -m {
		 [PC_発狂＿ツーハン__g:大佐_005]
		//悪の通信販売会社『Ｊ・Ｅ』から市民を
		//守るべく誕生した極秘スパイ、その名も
		//『２．５（ツー・ハン）』
	}
	talk 大佐 標準 -m {
		 [PC_発狂＿ツーハン__g:大佐_005_1]
		//悪の通信販売会社『Ｊ・Ｅ』から市民を
		//守るべく誕生した極秘スパイ、その名も
		//『２．５（ツー・ハン）』
