//危険モードになったら逃げろＣＡＬＬ h //e
//resource PC_海底ドック危険モード回避のススメ１
proc rp_PC_海底ドック危険モード回避のススメ１:03  {
vox t:vc260561 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_海底ドック危険モード回避のススメ１__g:大佐_000]
		//ライデン、君は武器をもっていない。
		//まともにやり合っても勝ち目はないぞ！
		//南に逃げろ！通路を戻るんだ！
	}
	talk 大佐 標準 -m {
		 [PC_海底ドック危険モード回避のススメ１__g:大佐_000_1]
		//ライデン、君は武器をもっていない。
		//まともにやり合っても勝ち目はないぞ！
		//南に逃げろ！通路を戻るんだ！
	}
}//v
}//d
//一回目のみ t //e
//resource PC_海底ドック危険モード回避のススメ２
proc rp_PC_海底ドック危険モード回避のススメ２:03  {
vox t:vc260571 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_海底ドック危険モード回避のススメ２__g:ローズ_000]
		//ジャック！逃げて！お願い！！
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_海底ドック危険モード回避のススメ２__g:大佐_001]
		//南のエリアに戻れば隠れる場所がある。
		//そっちに逃げ込むんだ。
	}
}//v
}//d


//クリアリングの説明（ＣＡＬＬ）h //e
//resource PC_海底ドッククリアリング中ＣＡＬＬ
proc rp_PC_海底ドッククリアリング中ＣＡＬＬ:03  {
vox t:vc260581 {
	talk 大佐 標準 -m {
		 [PC_海底ドッククリアリング中ＣＡＬＬ__g:大佐_000]
		//ライデン、じっとしているんだ！
		//奴等はクリアリングをしている。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_海底ドッククリアリング中ＣＡＬＬ__g:ローズ_001]
		//クリアリングって？
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_海底ドッククリアリング中ＣＡＬＬ__g:大佐_002]
		//クリアリングとは敵が存在する、または
		//その存在が予想される部屋、家屋などの
		//危険エリアを掃討することだ。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
@rp_うんちく＿是１＿詳しいな系デフォルト 100

	talk 大佐 標準 -m {
		 [PC_海底ドッククリアリング中ＣＡＬＬ__g:大佐_003]
		//種々のＣＱＢテクニックを駆使してな。
		//クリアリングには大きくわけて二種類の
		//突入方法がある。
	}
	talk 大佐 標準 -m {
		 [PC_海底ドッククリアリング中ＣＡＬＬ__g:大佐_004]
		//一つがスピードと奇襲にものを言わせて
		//突入し一気に敵を制圧するダイナミック
		//エントリー。
	}
	talk 大佐 標準 -m {
		 [PC_海底ドッククリアリング中ＣＡＬＬ__g:大佐_004_1]
		//一つがスピードと奇襲にものを言わせて
		//突入し一気に敵を制圧するダイナミック
		//エントリー。
	}
	talk 大佐 標準 -m {
		 [PC_海底ドッククリアリング中ＣＡＬＬ__g:大佐_005]
		//そしてもう一つがその反対に隠密裏に
		//エリアに進入、接敵し、主導権を奪う
		//ステルスエントリーだ。
	}
	talk 大佐 標準 -m {
		 [PC_海底ドッククリアリング中ＣＡＬＬ__g:大佐_005_1]
		//そしてもう一つがその反対に隠密裏に
		//エリアに進入、接敵し、主導権を奪う
		//ステルスエントリーだ。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_海底ドッククリアリング中ＣＡＬＬ__g:ローズ_006]
		//つまり、じっと隠れていないと
		//見つかるってこと？
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_海底ドッククリアリング中ＣＡＬＬ__g:大佐_007]
		//そういうことだな。
		//彼らは訓練されたプロだ。
		//適切な隠れ場所を見つけるんだ。
	}
	talk 大佐 標準 -m {
		 [PC_海底ドッククリアリング中ＣＡＬＬ__g:大佐_007_1]
		//そういうことだな。
		//彼らは訓練されたプロだ。
		//適切な隠れ場所を見つけるんだ。
	}
}//v
}//d


