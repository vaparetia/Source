//ファットマン戦後 d //e
//プリスキンは生きていた h //e
//resource PC_プリスキン生きていた
proc rp_PC_プリスキン生きていた:03  {
vox t:vc265951 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PC_プリスキン生きていた__g:ライデン_000]
		//大佐、プリスキン達は無事だった。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PC_プリスキン生きていた__g:ローズ_001]
		//うれしそうね、ジャック。
	}
	talk ライデン 標準 -m {
		 [PC_プリスキン生きていた__g:ライデン_002]
		//ああ……。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_プリスキン生きていた__g:大佐_003]
		//ライデン、奴を信用するな。
	}
	talk ライデン 標準 -m {
		 [PC_プリスキン生きていた__g:ライデン_004]
		//なんだって？
	}
	talk 大佐 標準 -m {
		 [PC_プリスキン生きていた__g:大佐_005]
		//おかしいとは思わないか？
		//奴一人だけ助かるなんて、
		//あまりにも都合が良すぎる。
	}
	talk ライデン 標準 -m {
		 [PC_プリスキン生きていた__g:ライデン_006]
		//……。
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_プリスキン生きていた__g:大佐_007]
		//ライデン。奴を頼りにするな。
		//君が独りで任務を遂行するんだ。
		//いいな。
	}
}//v
}//d

//忍者について h //e
