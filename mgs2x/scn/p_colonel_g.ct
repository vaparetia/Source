		 [PC_ピーター死＿爆発余波__g:ライデン_002]
		//プリスキンは？
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ピーター死＿爆発余波__g:大佐_003]
		//わからん……。
	}
	talk ライデン 標準 -m {
		 [PC_ピーター死＿爆発余波__g:ライデン_004]
		//大丈夫だろうか……？
	}
	talk 大佐 標準 -m {
		 [PC_ピーター死＿爆発余波__g:大佐_005]
		//ライデン、あの男を気遣うような暇が
		//あるなら爆弾を処理するんだ。いいな。
	}
	talk 大佐 標準 -m {
		 [PC_ピーター死＿爆発余波__g:大佐_005_1]
		//ライデン、あの男を気遣うような暇が
		//あるなら爆弾を処理するんだ。いいな。
	}
}//v
}//d

