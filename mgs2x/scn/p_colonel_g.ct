//プリスキンは信用するな。 h //e
//resource PC_プリスキン信用するな
proc rp_PC_プリスキン信用するな:03  {
vox t:vc265591 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_プリスキン信用するな__g:大佐_000]
		//ライデン、あのプリスキンと言う男を
