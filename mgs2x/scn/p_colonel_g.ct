//エルード h //e
//＊ムービー t //e
//resource PC_エルード１の１
proc rp_PC_エルード１の１:03  {
vox t:vc260341 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_エルード１の１__g:大佐_000]
		//腰くらいの高さの手すりは、近くで
		//△ボタンを押せば、手すりを乗り越えて
		//向こう側にぶらさがることが出来る。
	}
	talk 大佐 標準 -m {
		 [PC_エルード１の１__g:大佐_000_1]
		//腰くらいの高さの手すりは、近くで
		//△ボタンを押せば、手すりを乗り越えて
		//向こう側にぶらさがることが出来る。
	}
}//v
}//d
