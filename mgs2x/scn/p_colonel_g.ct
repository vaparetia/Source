//潜入プール d//e
//XBOXとPSX2で切り替えるべき音声コード
#include "vcvx.h"

//フナムシの捨て方 h //e
//resource PC_フナムシ＿捨て方１
proc rp_PC_フナムシ＿捨て方１:03  {
vox t:vc260011 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_フナムシ＿捨て方１__g:大佐_000]
		//装備品をフナムシから守るには、
		//装備品をゆすってみればいい。
	}
}//v
}//d

//フナムシがレーションを食っている状態での会話 h //e
//resource PC_フナムシ＿捨て方ズバリ
proc rp_PC_フナムシ＿捨て方ズバリ:03  {
vox t:vc260021 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_フナムシ＿捨て方ズバリ__g:大佐_000]
		//ライデン、レーションがフナムシに
		//食われているぞ。装備品ウィンドウを
		//揺すってフナムシを払い落とすんだ。
	}
	talk 大佐 標準 -m {
		 [PC_フナムシ＿捨て方ズバリ__g:大佐_000_1]
		//ライデン、レーションがフナムシに
		//食われているぞ。装備品ウィンドウを
		//揺すってフナムシを払い落とすんだ。
	}
}//v
}//d


//開かない金網ドア h //e
//resource PC_開かない金網ドア
proc rp_PC_開かない金網ドア:03  {
vox t:vc260031 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_開かない金網ドア__g:大佐_000]
		//ライデン、そこの扉は開きそうにない。
		//向こう側に行くには別の経路を探す
		//しかないぞ。
	}
}//v
}//d

//ダクト近く h //e
//resource PC_ダクト
proc rp_PC_ダクト:03  {
vox t:vc260041 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ダクト__g:大佐_000]
		//ライデン、足元を良く見ろ。
		//ダクトがあるぞ。ダクトには
		//ホフクすれば入り込むことが出来る。
	}
}//v
}//d
//イントルード説明へ t //e

//ホフクでくぐれるもの近く h //e
//resource PC_ホフクポイント
proc rp_PC_ホフクポイント:03  {
vox t:vc260051 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ホフクポイント__g:大佐_000]
		//ライデン、その下はホフクすれば
		//潜り込むことができそうだ。
	}
	talk 大佐 標準 -m {
		 [PC_ホフクポイント__g:大佐_001]
		//敵に追われた時にうまく隠れれば、
		//敵から逃げることも出来るかも
		//しれないな。
	}
}//v
//イントルード説明へ t//e
}//d

//イントルード説明 h //e
//resource PC_イントルード１
proc rp_PC_イントルード１:03  {
vox t:vc260061 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_イントルード１__g:大佐_000]
		//狭い所に入り込んだ時は、自動的に
		//イントルードカメラになる。
	}
}//v
}//d

//resource PC_イントルード２
proc rp_PC_イントルード２:03  {
vox d:_vc260071 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_イントルード２__g:大佐_000]
		//左スティックの上で前進、下で後退、
		//左右はそれぞれの方向を向く。
	}
	talk 大佐 標準 -m {
		 [PC_イントルード２__g:大佐_000_1]
		//左スティックの上で前進、下で後退、
		//左右はそれぞれの方向を向く。
	}
}//v
}//d

//resource PC_イントルード３
proc rp_PC_イントルード３:03  {
vox t:vc260081 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_イントルード３__g:大佐_000]
		//敵の様子を伺いつつ、身を隠しながら
		//進むんだ。絶対に見つかるんじゃないぞ。
	}
	talk 大佐 標準 -m {
		 [PC_イントルード３__g:大佐_000_1]
		//敵の様子を伺いつつ、身を隠しながら
		//進むんだ。絶対に見つかるんじゃないぞ。
	}
}//v
}//d
//resource PC_イントルード＿銃撃てる
proc rp_PC_イントルード＿銃撃てる:03  {
vox t:vc260091 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_イントルード＿銃撃てる__g:大佐_000]
		//ＶＲ訓練の時とは違いイントルード
		//カメラの時でも銃を撃つことが出来る。
		//忘れるなよ。
	}
}//v
}//d
//resource PC_イントルード＿危険性
proc rp_PC_イントルード＿危険性:03  {
vox t:vc260101 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_イントルード＿危険性__g:大佐_000]
		//イントルードは決して安全と言うわけ
		//ではない。敵に発見されれば当然
		//攻撃を受ける。
	}
	talk 大佐 標準 -m {
		 [PC_イントルード＿危険性__g:大佐_001]
		//潜り込むところを敵に見られないように
		//気をつけろ。
	}
	talk 大佐 標準 -m {
		 [PC_イントルード＿危険性__g:大佐_002]
		//イントルードで隠れていても敵が
		//覗き込んでくる時もあるだろう。
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_イントルード＿危険性__g:大佐_003]
		//その時はイントルードで移動しながら
		//敵の視線をかわさなければならない。
	}
	talk 大佐 標準 -m {
		 [PC_イントルード＿危険性__g:大佐_004]
		//イントルードでも油断するんじゃないぞ。
		//いいな。
	}
}//v
}//d


//泳ぎ、落ちたらＣＡＬＬ h //e
//resource PC_水中＿操作説明
proc rp_PC_水中＿操作説明:03  {
vox t:vc260111 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_水中＿操作説明__g:大佐_000]
		//水に入ったようだな。
		//泳ぎの基本操作はこうだ。
	}
}//v
}//d
//水面にいる h //e
//移動 t //e
//resource PC_水中＿水面＿移動
proc rp_PC_水中＿水面＿移動:03  {
vox d:_vc260121 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_水中＿水面＿移動__g:大佐_000]
		//水面を泳いでいる時は左スティックの
		//上下左右でそれぞれの方向に泳ぐことが
		//出来る。
	}
	talk 大佐 標準 -m {
		 [PC_水中＿水面＿移動__g:大佐_000_1]
		//水面を泳いでいる時は左スティックの
		//上下左右でそれぞれの方向に泳ぐことが
		//出来る。
	}
}//v
}//d
//潜航 t //e
//resource PC_水中＿水面＿潜航１
proc rp_PC_水中＿水面＿潜航１:03  {
vox t:vc260131 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_水中＿水面＿潜航１__g:大佐_000]
		//水面から水中に潜る時は
		//○ボタンか×ボタンを押せばいい。
	}
}//v
}//d
//resource PC_水中＿水面＿潜航２
proc rp_PC_水中＿水面＿潜航２:03  {
vox t:vc260141 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_水中＿水面＿潜航２__g:大佐_000]
		//水面から水中に潜る時は○ボタンを
		//押せばいい。
	}
}//v
}//d
//水中 h //e
//resource PC_水中＿前進
proc rp_PC_水中＿前進:03  {
vox t:vc260151 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_水中＿前進__g:大佐_000]
		//○ボタンを押すと水をかいて前進する。
		//連打すれば早く泳ぐことが出来るぞ。
	}
	talk 大佐 標準 -m {
		 [PC_水中＿前進__g:大佐_000_1]
		//○ボタンを押すと水をかいて前進する。
		//連打すれば早く泳ぐことが出来るぞ。
	}
}//v
}//d
//resource PC_水中＿左スティック＿正
proc rp_PC_水中＿左スティック＿正:03  {
vox d:_vc260161 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_水中＿左スティック＿正__g:大佐_000]
		//泳ぐ方向は左スティックで変えられる。
		//上で上の方、下で下の方、左右で
		//それぞれの方向を向く。
	}
	talk 大佐 標準 -m {
		 [PC_水中＿左スティック＿正__g:大佐_000_1]
		//泳ぐ方向は左スティックで変えられる。
		//上で上の方、下で下の方、左右で
		//それぞれの方向を向く。
	}
}//v
}//d
//resource PC_水中＿左スティック＿逆
proc rp_PC_水中＿左スティック＿逆:03  {
vox t:vc260171 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_水中＿左スティック＿逆__g:大佐_000]
		//泳ぐ方向は左スティックで変えられる。
		//上で下の方、下で上の方、左右で
		//それぞれの方向を向く。
	}
	talk 大佐 標準 -m {
		 [PC_水中＿左スティック＿逆__g:大佐_000_1]
		//泳ぐ方向は左スティックで変えられる。
		//上で下の方、下で上の方、左右で
		//それぞれの方向を向く。
	}
}//v
}//d
//Ｏ２について h //e
//resource PC_水中＿Ｏ２
proc rp_PC_水中＿Ｏ２:03  {
vox t:vc260181 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_水中＿Ｏ２__g:大佐_000]
		//水中にいる間、ＬＩＦＥゲージの下に
		//Ｏ２ゲージが表示される。
		//Ｏ２ゲージが一回の息継ぎに相当する。
	}
	talk 大佐 標準 -m {
		 [PC_水中＿Ｏ２__g:大佐_000_1]
		//水中にいる間、ＬＩＦＥゲージの下に
		//Ｏ２ゲージが表示される。
		//Ｏ２ゲージが一回の息継ぎに相当する。
	}
	talk 大佐 標準 -m {
		 [PC_水中＿Ｏ２__g:大佐_001]
		//Ｏ２ゲージがゼロになると続いて、
		//ＬＩＦＥが減るぞ。注意するんだ。
	}
}//v
}//d
//一回目のみ t //e
//resource PC_海底ドッグ水中
proc rp_PC_海底ドッグ水中:03  {
vox t:vc260191 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_海底ドッグ水中__g:大佐_000]
		//ＶＲミッションに水中訓練は無かった
		//だろう。いずれ水中でミッションを
		//行う必要が出てくるかも知れん。
	}
	talk 大佐 標準 -m {
		 [PC_海底ドッグ水中__g:大佐_000_1]
		//ＶＲミッションに水中訓練は無かった
		//だろう。いずれ水中でミッションを
		//行う必要が出てくるかも知れん。
	}
	talk 大佐 標準 -m {
		 [PC_海底ドッグ水中__g:大佐_001]
		//今のうちに身につけておくのも
		//いいだろう。
	}
}//v
}//d


//急速回転 h //e
//resource PC_水中＿右スティック
proc rp_PC_水中＿右スティック:03  {
vox d:_vc260201 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_水中＿右スティック__g:大佐_000]
		//右スティックを使えば素早く方向を
		//変えることが出来る。左右でそれぞれの
		//方向に９０度、下で真後ろを向く。
	}
	talk 大佐 標準 -m {
		 [PC_水中＿右スティック__g:大佐_000_1]
		//右スティックを使えば素早く方向を
		//変えることが出来る。左右でそれぞれの
		//方向に９０度、下で真後ろを向く。
	}
}//v
}//d
//急速浮上 h //e
//resource PC_水中＿急速浮上
proc rp_PC_水中＿急速浮上:03  {
vox t:vc260211 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_水中＿急速浮上__g:大佐_000]
		//□ボタンを押せば急速に浮上することが
		//出来る。息が苦しくなった時などに
		//使うといい。
	}
}//v
}//d
//武器なし h //e
//resource PC_水中＿武器ナシ
proc rp_PC_水中＿武器ナシ:03  {
vox t:vc260221 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_水中＿武器ナシ__g:大佐_000]
		//水中で武器は一切使えなくなるから
		//注意しろ。水中に敵が潜んでいるとは
		//思えんがな……。
	}
	talk 大佐 標準 -m {
		 [PC_水中＿武器ナシ__g:大佐_000_1]
		//水中で武器は一切使えなくなるから
		//注意しろ。水中に敵が潜んでいるとは
		//思えんがな……。
	}
}//v
}//d
//息ガマン h //e
//resource PC_水中＿息ガマン
proc rp_PC_水中＿息ガマン:03  {
vox t:vc260231 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_水中＿息ガマン__g:大佐_000]
		//水中で息が苦しくなったら△ボタンを
		//連打するんだ。そうすれば息を詰めて
		//Ｏ２ゲージの減り具合を少なく出来る。
	}
	talk 大佐 標準 -m {
		 [PC_水中＿息ガマン__g:大佐_000_1]
		//水中で息が苦しくなったら△ボタンを
		//連打するんだ。そうすれば息を詰めて
		//Ｏ２ゲージの減り具合を少なく出来る。
	}
}//v
}//d

//スカルスーツの秘密 h //e
//resource PC_水中＿スカルスーツ
/*
proc rp_PC_水中＿スカルスーツ:03  {
vox t:vc260241 {
	@rpb_PC_水中＿スカルスーツ
}//v
}//d
*/
proc rpb_PC_水中＿スカルスーツ:03  {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_水中＿スカルスーツ__g:大佐_000]
		//ライデン、君のそのスカルスーツは
		//水の抵抗を最小減に抑える仕組みに
		//なっている。スーツの表面を撫でてみろ。
	}
	talk 大佐 標準 -m {
		 [PC_水中＿スカルスーツ__g:大佐_000_1]
		//ライデン、君のそのスカルスーツは
		//水の抵抗を最小減に抑える仕組みに
		//なっている。スーツの表面を撫でてみろ。
	}
	talk ライデン 標準 -m {
		 [PC_水中＿スカルスーツ__g:ライデン_001]
		//……ザラザラしている。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk 大佐 標準 -m {
		 [PC_水中＿スカルスーツ__g:大佐_002]
		//目には見えないが、表面に微少の溝が
		//並んでいるんだ。その溌水加工された
		//ウロコ状の凹凸が、水流をうち消す。
	}
	talk 大佐 標準 -m {
		 [PC_水中＿スカルスーツ__g:大佐_002_1]
		//目には見えないが、表面に微少の溝が
		//並んでいるんだ。その溌水加工された
		//ウロコ状の凹凸が、水流をうち消す。
	}
	talk 大佐 標準 -m {
		 [PC_水中＿スカルスーツ__g:大佐_003]
		//通常よりも１０％の抵抗削減に
		//成功している。鮫の肌にヒントを
		//創られた、いわば鮫肌スーツだ。
	}
	talk 大佐 標準 -m {
		 [PC_水中＿スカルスーツ__g:大佐_003_1]
		//通常よりも１０％の抵抗削減に
		//成功している。鮫の肌にヒントを
		//創られた、いわば鮫肌スーツだ。
	}
	talk 大佐 標準 -m {
		 [PC_水中＿スカルスーツ__g:大佐_004]
		//陸上でも空気抵抗を削減するように
		//凹凸を利用している。ゴルフボールで
		//使われている整流効果を改良したものだ。
	}
	talk 大佐 標準 -m {
		 [PC_水中＿スカルスーツ__g:大佐_004_1]
		//陸上でも空気抵抗を削減するように
		//凹凸を利用している。ゴルフボールで
		//使われている整流効果を改良したものだ。
	}
	talk ライデン 標準 -m {
		 [PC_水中＿スカルスーツ__g:ライデン_005]
		//なるほど、オリンピックにも
		//出場できそうだな。
	}
}//d


//ハシゴ近く h //e
//resource PC_ハシゴ
proc rp_PC_ハシゴ:03  {
vox t:vc260251 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ハシゴ__g:大佐_000]
		//ライデン、ハシゴがあるな。ハシゴを
		//使うには、ハシゴに近寄って△ボタンを
		//押せばいい。
	}
}//v
}//d


//ロッカー近く h //e
//resource PC_ロッカー近く１
proc rp_PC_ロッカー近く１:03  {
vox t:vc260261 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ロッカー近く１__g:大佐_000]
		//ライデン、見ろ。ロッカーがあるぞ。
		//うまくその中に隠れれば敵を
		//やりすごすことも出来るだろう。
	}
}//v
}//d
//resource PC_ロッカー近く２外
proc rp_PC_ロッカー近く２外:03  {
vox t:vc260271 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ロッカー近く２外__g:大佐_000]
		//ロッカーに向かって△ボタンを押すと
		//扉を開ける。扉を開けたロッカーの中に
		//入れば、扉を閉めて隠れることが出来る。
	}
	talk 大佐 標準 -m {
		 [PC_ロッカー近く２外__g:大佐_000_1]
		//ロッカーに向かって△ボタンを押すと
		//扉を開ける。扉を開けたロッカーの中に
		//入れば、扉を閉めて隠れることが出来る。
	}
}//v
}//d
//resource PC_ロッカー近く２中
proc rp_PC_ロッカー近く２中:03  {
vox t:vc260281 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ロッカー近く２中__g:大佐_000]
		//ロッカーから出るには、
		//もう一度△ボタンを押せばいい。
	}
	talk 大佐 標準 -m {
		 [PC_ロッカー近く２中__g:大佐_001]
		//中に入ってもスリットから外が見える。
		//外へ出る時は、敵がいないかどうか
		//よく主観で確かめるようにしろ。
	}
	talk 大佐 標準 -m {
		 [PC_ロッカー近く２中__g:大佐_001_1]
		//中に入ってもスリットから外が見える。
		//外へ出る時は、敵がいないかどうか
		//よく主観で確かめるようにしろ。
	}
}//v
}//d
//resource PC_ロッカー近く３
proc rp_PC_ロッカー近く３:03  {
vox t:vc260291 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ロッカー近く３__g:大佐_000]
		//扉を開けたロッカーまで倒した敵を
		//引きずっていけば、ロッカーの中に
		//敵の体を隠すことも出来る。
	}
}//v
}//d
//resource PC_ロッカードア盾
proc rp_PC_ロッカードア盾:03  {
vox t:vc260301 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ロッカードア盾__g:大佐_000]
		//ロッカーを開ければ、その扉を
		//盾にして敵の銃撃を防ぐことも出来る。
	}
	talk 大佐 標準 -m {
		 [PC_ロッカードア盾__g:大佐_001]
		//遮蔽物が全く見当たらない時などに
		//試してみるといい。
	}
}//v
}//d
//resource PC_ロッカー扉破壊
proc rp_PC_ロッカー扉破壊:03  {
vox t:vc260311 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ロッカー扉破壊__g:大佐_000]
		//ロッカーの扉は破壊することも出来る。
		//どうしても鍵のかかったロッカーを
		//開けたいのならば、壊してみろ。
	}
}//v
}//d
//resource PC_ロッカー開かない
proc rp_PC_ロッカー開かない:03  {
vox t:vc260321 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		 [PC_ロッカー開かない__g:大佐_000]
		//ライデン、そのロッカーは鍵が
		//かかっているようだ。ロッカーを
		//使いたいなら別のを探せ。
	}
	talk 大佐 標準 -m {
		 [PC_ロッカー開かない__g:大佐_000_1]
		//ライデン、そのロッカーは鍵が
		//かかっているようだ。ロッカーを
		//使いたいなら別のを探せ。
	}
}//v
}//d

