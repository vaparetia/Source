	// ロッカーカメラ
	proc ロッカー部屋カメラ設定 {
		@ロッカー部屋カメラ中央
		@ロッカー部屋カメラ張り付き
		//@グラビアカメラ
	}

	proc ロッカー部屋カメラ中央 {
		trap ca024 d:PLAYER -mask ＊ -camera \
			-exec {
				if( $3 == 入る)	{
						if( $i:前フレーム位置Ｚ < 6000 ){
							eval( $w:カメラ補完方式 = 0 )
						}else{
							eval( $w:カメラ補完方式 = 1 )
						}
					}
				if( $4 < -2266 ){
					eval( $i:補完ＰＸ = -2266 )
				}else if( $4 > 2266 ){
					eval( $i:補完ＰＸ = 2266 )
				}else{
					eval( $i:補完ＰＸ = $4 )
				}
				chara カメラ設定 通路カメラ１ \
						-c 1 \
						-p $i:補完ＰＸ,6962,5205 \
						-t $i:補完ＰＸ,1154,3722 \
						-r 861,2048,0 -f 5995 \
						-a 200 \
						-i 0 -1 0 0 \
						-o 5 \	// １フレーム遅らせる
						-s $3
				if( $3 == 入る ){
					mesg プットスポットライトオブジェ 照明モデル左 オブジェ不可視
					mesg プットスポットライトオブジェ 照明モデル右 オブジェ不可視
				}
			}
	}

	proc ロッカー部屋カメラ張り付き {
		trap ca025 d:PLAYER -mask ＊ -camera \
			-exec {

					if( $4 < -2266 ){
						eval( $i:補完ＰＸ = -2266 )
					}else if( $4 > 2266 ){
						eval( $i:補完ＰＸ = 2266 )
					}else{
						eval( $i:補完ＰＸ = $4 )
					}
					chara カメラ設定 通路カメラ０ \
							-c 1 \
							-p $i:補完ＰＸ,7288,3834 \
							-t $i:補完ＰＸ,1297,3715 \
							-r 1011,2048,0 -f 5992 \
							-a 200 \
							-i 1 1 0 0 \
							-s $3
			}
	}

