	proc 天井セット {
		chara 天井君 天井 -m w01ar -h 2800 -p 0,0,0  -l w01a
		chara 天井君 ロッカー天井 -m w01alcr -h 2800 -p 0,0,0 -l w01a -v ライトの表示制御
	}

	// 天井に連動してライトモデルをＯＮ／ＯＦＦします
	proc ライトの表示制御 {
		command プットスポットライトオブジェライト管理 \
			-n 照明モデル左 \
			-f $1

		command プットスポットライトオブジェライト管理 \
			-n 照明モデル右 \
			-f $1
	}

	// ロード用モデルセット
	proc プットオブジェセット {
		print 'model プットオブジェセット'

		// ロード用モデル
		chara プットオブジェ ロード用Ｗ０１ｆ１ -m w01a_w01f_1 -r 0,0,0 -p 0,0,0 -l w01a -s 100,100,100
		mesg  プットオブジェ ロード用Ｗ０１ｆ１ off

		chara プットオブジェ ロード用Ｗ０１ｆ２ -m w01a_w01f_2 -r 0,0,0 -p 0,0,0 -l w01a -s 100,100,100
		mesg  プットオブジェ ロード用Ｗ０１ｆ２ off
		// 柱セット
		chara プットオブジェ 左柱 -m w01a_pillar_l -r 0 0 0 -p 0 0 0 -l w01a -s 100 100 100
		mesg  プットオブジェ 左柱 off
		chara プットオブジェ 右柱 -m w01a_pillar_r -r 0 0 0 -p 0 0 0 -l w01a -s 100 100 100
		mesg  プットオブジェ 右柱 off
	}

	// 主観及びビハインド時にモデルを表示する
	proc 主観／ビハインド時の表示 {
		print 'model 主観／ビハインド時の表示'

		chara 天井君 左柱 -m w01a_pillar_l -a 5 -c 0 0 7500 -p 0,0,0 -l w01a
		chara 天井君 右柱 -m w01a_pillar_r -a 5 -c 0 0 7500 -p 0,0,0 -l w01a
	}

