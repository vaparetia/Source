							-b 5500,2000,-10000  5500,4000,10000 \
							-l 5500,1000,-10000  5500,1000,10000 \
							-r 80,2048,0 -f 7000 \
							-a 200 \
							-i 1 -1 0 0 \
							-s $3
					}
			}
	}

	// 一階東側の東西通路と南北通路を接続する角（ca017）
	proc 東側北角カメラ {
		trap ca017 d:PLAYER -mask ＊ -camera \
			-exec {
				if( $3 == 入る)	{ eval( $i:進入位置Ｘ = $i:前フレーム位置Ｘ ) }

				if( $i:進入位置Ｘ > 6750 ){
				// 東から浸入
					chara カメラ設定 通路カメラ１ \
						-c 1 \
						-p 5414,2576,8951 -t 5414,1939,6852 \
						-r 192,2048,0 -f 2194 \
						-a 300 \
						-i 0 -1 0 0 \
						-s $3
					eval( $w:１トラップ前カメラ進入方向 = d:EAST )
					eval( $w:カメラ補完方式 = 1 )
				}else{
				// 南から浸入
					@CS_スムーズカメラ昇順 $4 5250 6750 0 1000
							eval( $w:補完距離 = $i:CS_結果１ )

					chara カメラ設定 通路カメラ１ \
						-c 0 \
						-b 10361,4968,-5758  6269,4968,-5758 \
						-l 10361,1096,-6362  6269,1096,-6362 \
						-r 923,2048,0 -f 3919 \
						-a 200 \
						-i 0 -1 0 0 \
						-slide 0 2 1000 $w:補完距離 60 0 \
						-s $3
					eval( $w:１トラップ前カメラ進入方向 = d:SOUTH )
					eval( $w:カメラ補完方式 = 0 )
				}
			}
	}

	// 一階南端通路（東西方向）（ca020）
	proc 東西方向南端通路カメラ {
		trap ca020 d:PLAYER -mask ＊ -camera \
			-exec {
				chara カメラ設定 通路カメラ１ \
					-c 0 \
					-b -5200,2700,9917  5200,2700,9917 \
					-l -5200,1762,7950  5200,1762,7950 \
					-r 290,2048,0 -f 2179 \
					-a 200 \
					-i 2 -1 0 0 \
					-slide 0 5 1000 1000 50 0 \
					-s $3
			}
	}

	proc 東西方向南端通路張り付きカメラ {
		trap ca023 d:PLAYER \
			-mask ＊ \
			-camera -state 4 \
			-d 2048 512 \
			-exec {
				chara カメラ設定 通路カメラ０ \
					-c 0 \
					-b -5800,4131,6782  5800,4131,6782 \
					-l -5800,1965,6672  5800,1965,6672 \
					-r 290,2048,0 -f 2179 \
					-a 200 \
					-i 2 -1 0 0 \
					-slide 0 5 1000 1000 50 0 \
					-s $3
				if( $3 == 出る ) {
					eval( $f:柱ＯＮフラグ = 0 )
				}else{
					eval( $f:柱ＯＮフラグ = 1 )
				}
				//mesg プットオブジェ 左柱 on
				//mesg プットオブジェ 右柱 on

			}
	}

	proc 南西角カメラ {
		trap ca021 d:PLAYER -mask ＊ -camera \
			-exec {
				chara カメラ設定 通路カメラ１ \
					-c 0 \
					-b -5200,2700,9917  5200,2700,9917 \
					-l -5200,1762,7950  5200,1762,7950 \
					-r 150,2048,0 -f 2198 \
					-a 200 \
					-i 2 -1 0 0 \
					-s $3
			}
	}
	proc 南東角カメラ {
