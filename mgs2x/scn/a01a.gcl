/***************************************************************************************************/
// カメラの初期化とデフォルトカメラの設定
/***************************************************************************************************/

	proc 居住区１Ｆカメラ初期設定 {
		chara カメラ ロードカメラ		-c 0 -l 2 -p 0
		chara カメラ シナリオカメラ		-c 0 -l 2 -p 10
		chara カメラ モーションカメラ	-c 0 -l 2 -p 20
		chara カメラ 通路カメラ０		-c 0 -l 2 -p 30
		chara カメラ 通路カメラ１		-c 0 -l 2 -p 40

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0
		chara カメラ クリアリングカメラ	-c 1 -l 2 -p 0

		chara カメラ設定 ステージカメラ \
			-c 0 \
			-b -32000,-32000,-32000 32000,32000,32000 \
			-l -32000,-32000,-32000 32000,32000,32000 \
			-r 640,2048,0 \
			-f 6000 \
			-a 200 \
			-i 1 -1 0 0 \
			-s 1
	}

// 廻廊部
	proc 一回廻廊部カメラ設定 {
		@西端廊下クランク部左カメラ
		@東端廊下クランク部右カメラ
		@西側東西方向通路カメラ
		@西側南北方向通路カメラ
		@西側北角カメラ
		@東側東西方向通路カメラ
		@東側南北方向通路カメラ
		@東側北角カメラ
		@東西方向南端通路カメラ
		@東西方向南端通路張り付きカメラ
		@南西角カメラ
		@南東角カメラ
	}

	proc 西端廊下クランク部左カメラ {
		trap ca010 d:PLAYER -mask ＊ -camera \
			-exec {
				@全部補完カメラ $6	-8500 -7000  \
									-10630 -10361 \
									2758 4968 \
									-5200 -5758 \
									-10630 -10361 \
									1470 1096 \
									-7425 -6362

				chara カメラ設定 通路カメラ１ \
					-c 1 \
					-p $i:補完ＰＸ $i:補完ＰＹ $i:補完ＰＺ \
					-t $i:補完ＴＸ $i:補完ＴＹ $i:補完ＴＺ \
					-r 342,2048,0 -f 2571 \
					-a 200 \
					-i 1 -1 0 0 \
					-s $3
			}
	}

	proc 東端廊下クランク部右カメラ {
		trap ca011 d:PLAYER -mask ＊ -camera \
			-exec {
				@全部補完カメラ $6	-8500 -7000  \
									10630 10361 \
									2758 4968 \
									-5200 -5758 \
									10630 10361 \
									1470 1096 \
									-7425 -6362

				chara カメラ設定 通路カメラ１ \
					-c 1 \
					-p $i:補完ＰＸ $i:補完ＰＹ $i:補完ＰＺ \
					-t $i:補完ＴＸ $i:補完ＴＹ $i:補完ＴＺ \
					-r 342,2048,0 -f 2571 \
					-a 200 \
					-i 1 -1 0 0 \
					-s $3
			}
	}

	proc 西側東西方向通路カメラ {
		trap ca012 d:PLAYER -mask ＊ -camera \
			-exec {
				if( $3 == 入る ){
					if( $w:１トラップ前カメラ進入方向 == d:WEST ) {
						eval( $w:カメラ補完方式 = 0 )
					}else{
						eval( $w:カメラ補完方式 = 1 )
					}
				}

				chara カメラ設定 通路カメラ１ \
					-c 0 \
					-b -10361,4968,-5758  -6269,4968,-5758 \
					-l -10361,1096,-6362  -6269,1096,-6362 \
					-r 923,2048,0 -f 3919 \
					-a 200 \
					-i $w:カメラ補完方式 -1 0 0 \
					-slide 0 2 1000 1000 60 0 \
					-s $3
			}
	}

	proc 西側南北方向通路カメラ {
		trap ca013 d:PLAYER -mask ＊ -camera \
			-exec {
					if( $3 == 入る ){	// 南から進入時
						if( $6 > 0 ){
							eval( $w:カメラ補完方式 = 1 )
							eval( $f:カメラタイプ = 0 )
						}else{
							// 北から進入時のカメラ補完方式はca014で値が代入済み
							eval( $f:カメラタイプ = 1 )
						}
					}

					if( $f:カメラタイプ ){
						@CS_スムーズカメラ昇順 $6 -5000 5000 300 200
							eval( $w:補完画角 = $i:CS_結果１ )
						@CS_スムーズカメラ昇順 $6 -5000 5000 -5414 -5200
							eval( $i:補完ＰＸ = $i:CS_結果１ )
						@CS_スムーズカメラ昇順 $6 -5000 5000 2576 2700
							eval( $i:補完ＰＹ = $i:CS_結果１ )
						@CS_スムーズカメラ昇順 $6 -5000 5000 8951 9917
							eval( $i:補完ＰＺ = $i:CS_結果１ )
						@CS_スムーズカメラ昇順 $6 -5000 5000 -5414 -5200
							eval( $i:補完ＴＸ = $i:CS_結果１ )
						@CS_スムーズカメラ昇順 $6 -5000 5000 1939 1762
							eval( $i:補完ＴＹ = $i:CS_結果１ )
						@CS_スムーズカメラ昇順 $6 -5000 5000 6852 7950
							eval( $i:補完ＴＺ = $i:CS_結果１ )

						chara カメラ設定 通路カメラ１ \
							-c 1 \
							-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ \
							-t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ \
							-r 69,2048,0 -f 7000 \
							-a $w:補完画角 \
							-i $w:カメラ補完方式 -1 0 0 \
							-s $3
					}else{
						chara カメラ設定 通路カメラ１ \
							-c 0 \
							-b -5500,2000,-10000  -5500,4000,10000 \
							-l -5500,1000,-10000  -5500,1000,10000 \
							-r 80,2048,0 -f 7000 \
							-a 200 \
							-i 1 -1 0 0 \
							-s $3
					}
			}
	}

	// 一階西側の東西通路と南北通路を接続する角（ca014）
	proc 西側北角カメラ {
		trap ca014 d:PLAYER -mask ＊ -camera \
			-exec {
				if( $3 == 入る)	{ eval( $i:進入位置Ｘ = $i:前フレーム位置Ｘ ) }

				if( $i:進入位置Ｘ < -6750 ){
				// 西から浸入
					chara カメラ設定 通路カメラ１ \
						-c 1 \
						-p -5414,2576,8951 -t -5414,1939,6852 \
						-r 192,2048,0 -f 2194 \
						-a 300 \
						-i 0 -1 0 0 \
						-s $3
					eval( $w:１トラップ前カメラ進入方向 = d:WEST )
					eval( $w:カメラ補完方式 = 1 )
				}else{
				// 南から浸入
					@CS_スムーズカメラ昇順 $4 -6750 -5250 1000 0
							eval( $w:補完距離 = $i:CS_結果１ )

					chara カメラ設定 通路カメラ１ \
						-c 0 \
						-b -10361,4968,-5758  -6269,4968,-5758 \
						-l -10361,1096,-6362  -6269,1096,-6362 \
						-r 923,2048,0 -f 3919 \
						-a 200 \
						-i 0 -1 0 0 \
						-slide 0 2 $w:補完距離 1000 60 0 \
						-s $3
					eval( $w:１トラップ前カメラ進入方向 = d:SOUTH )
					eval( $w:カメラ補完方式 = 0 )
				}
			}
	}


	// 一階東通路（東西方向）（ca015）
	proc 東側東西方向通路カメラ {
		trap ca015 d:PLAYER -mask ＊ -camera \
