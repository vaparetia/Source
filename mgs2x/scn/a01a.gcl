/***************************************************************************************************/
// クリアリング設定
/***************************************************************************************************/
	proc クリアリング初期設定１{
	print '======================================================================='
	print '==============================       =================================='
	print '============================== START =================================='
	print '==============================       =================================='
	print '======================================================================='

		switch ( $b:ミッション番号 ) {
			case ( d:MISSION:スネークテイルズ ) {
				@スネークテイルズ用鏡面モデル消す
			}
		}

		// ロッカー１ 開いている ＆ 壊れていない
		command ロッカー状態 -n ロッカー１
		eval( $f:ロッカーステータス１ = ( ($status & d:LOCKER_STATE_OPEN) && !($status & d:LOCKER_STATE_BROKEN) ) )

		// ロッカー２ 閉じている もしくは 壊れている
		command ロッカー状態 -n ロッカー２
		eval( $f:ロッカーステータス２ = ( ($status & d:LOCKER_STATE_CLOSE) || ($status & d:LOCKER_STATE_BROKEN) ) )

		// ロッカー３ 閉じている もしくは 壊れている
		command ロッカー状態 -n ロッカー３
		eval( $f:ロッカーステータス３ = ( ($status & d:LOCKER_STATE_CLOSE) || ($status & d:LOCKER_STATE_BROKEN) ) )

		// ロッカー５ 閉じている もしくは 壊れている
		command ロッカー状態 -n ロッカー５
		eval( $f:ロッカーステータス５ = ( ($status & d:LOCKER_STATE_CLOSE) || ($status & d:LOCKER_STATE_BROKEN) ) )

		// ロッカー６ 開いている ＆ 壊れていない
		command ロッカー状態 -n ロッカー６
		eval( $f:ロッカーステータス６ = ( ($status & d:LOCKER_STATE_OPEN) && !($status & d:LOCKER_STATE_BROKEN) ) )

		// ロッカー１が開いていた時の特別処理
		if( ($f:ロッカーステータス１) && ($f:ロッカーステータス２) && ($f:ロッカーステータス３) ){
			command セットクリアリング \
				-p 	0,(7-1),(1-1) クリアリングカメラ020 \
					0,(7-1),(7-1) クリアリングカメラ021 \
					0,(7-1),(9-1) クリアリングチェック左ポスター \
					0,(8-1),(7-1) クリアリングチェック左ポスター \
					0,(7-1),(12-1) クリアリングカメラ022 \
				-i (7-1) (8-1)

		// ロッカー６が開いていた時の特別処理
		}else if( ($f:ロッカーステータス６) && ($f:ロッカーステータス５) ){
			command セットクリアリング \
				-p 	0,(9-1),(1-1) クリアリングカメラ030 \
					0,(9-1),(8-1) クリアリングカメラ031 \
					0,(10-1),(13-1) クリアリングカメラ032 \
					0,(10-1),(10-1) クリアリングチェック右ポスター \
				-i (9-1) (10-1)

		// スネーク右側にいる
		}else if( $i:プレイヤー位置Ｘ > 0 ){
			print 'スネーク右にいた'
			command セットクリアリング \
				-p 	0,(1-1),(1-1) クリアリングカメラ001 \
					0,(1-1),(4-1) クリアリングカメラ002 \
					0,(1-1),(11-1) クリアリングカメラ003 \
				-i 0,1
		// スネーク左側にいる
		}else{
			print 'スネーク左にいた'
			command セットクリアリング \
				-p 	0,(4-1),(3-1) クリアリングカメラ010 \
					0,(3-1),(6-1) クリアリングカメラ011 \
				-i 2,3
		}
	}

	proc クリアリングチェック右ポスター {
	print 'クリアリングチェック右ポスター'

		// 開いている かつ 壊れていない
		command ロッカー状態 -n ロッカー５
		eval( $f:ロッカーステータス５ = ( $status & d:LOCKER_STATE_OPEN && !($status & d:LOCKER_STATE_BROKEN) ) )

		// 閉じている もしくは 壊れている
		command ロッカー状態 -n ロッカー６
		eval( $f:ロッカーステータス６ = ( $status & d:LOCKER_STATE_CLOSE || $status & d:LOCKER_STATE_BROKEN ) )

	print $f:ロッカーステータス５
	print $f:ロッカーステータス６

		if( $f:ロッカーステータス６ || $f:ロッカーステータス５ ){
			command クリアリングキャンセル
		}

	}


	proc クリアリングチェック左ポスター {
	print 'クリアリングチェック左ポスター'

		// 閉じている もしくは 壊れている
		command ロッカー状態 -n ロッカー１
		eval( $f:ロッカーステータス１ = ( $status & d:LOCKER_STATE_CLOSE || $status & d:LOCKER_STATE_BROKEN ) )

		// 開いている かつ 壊れていない
		command ロッカー状態 -n ロッカー２
		eval( $f:ロッカーステータス２ = ( $status & d:LOCKER_STATE_OPEN && !($status & d:LOCKER_STATE_BROKEN) ) )

		// 開いている かつ 壊れていない
		command ロッカー状態 -n ロッカー３
		eval( $f:ロッカーステータス３ = ( $status & d:LOCKER_STATE_OPEN && !($status & d:LOCKER_STATE_BROKEN) ) )

	print $f:ロッカーステータス１
	print $f:ロッカーステータス２
	print $f:ロッカーステータス３

		if( $f:ロッカーステータス１ || $f:ロッカーステータス２ || $f:ロッカーステータス３ ){
			command クリアリングキャンセル
		}
	}


