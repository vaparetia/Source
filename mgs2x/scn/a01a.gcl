// 一括初期化前に変数をローカルに逃がす
if( `command ミッションズリトライ回数取得` == 0 && \
	`command ミッションズコンティニュー回数取得` == 0 ) {
	$$i:ローカル変数プレイタイム = $i:プレイタイム;
} else {
	$$i:ローカル変数プレイタイム = $i:グローバル変数プレイタイム;
}

// デバッグ関係
#ifdef d:FIX_MODE
	#define MY_DEBUG	0		// デバッグ
	#define ASSERT		0
	#define VAR_SAVE	1
#else
	#define MY_DEBUG	0		// デバッグ
	#define ASSERT		1
	#define VAR_SAVE	1
#endif

// 基本ディファイン

#define STAGE_TANKER		1	// モード共通 プロック切り分け用
#define STAGE_W01A			1	// ステージ名 共通プロック切り分け用
#define STAGE_ALT			1	// オールタナティブステージ切り分け用

#define PLAYER				スネーク

// 薬莢
#define ENE_T_GOL			1	// タンカー編ゴル兵
#define	ENE_SHOT			1	// ショットガン兵
#define	ENE_SHIELD 			1	// 盾兵

// 各種スイッチ用
#define STAGE_END			1	// ステージ終了時処理を使用可にする

// ステージ固有定義
#define CLEARING_CAMERA 	1	// クリアリング子画面設定


#define	LT2_NAME			w01a

// ドア名
#define DR_NAME1		w01a_dr
#define DR_NAME2		w01a_dr
#define DR_NAME3		w01a_dr
#define DR_NAME4		w01a_dr
#define DR_NAME5		w01a_dr

#define DR_NAME_LC_L1	w01alcDoorL
#define DR_NAME_LC_L2	w01alcDoorL
#define DR_NAME_LC_L3	w01alcDoorL
#define DR_NAME_LC_L4	w01alcDoorL
#define DR_NAME_LC_L5	w01alcDoorL

#define DR_NAME_LC_R1	w01alcDoorR
#define DR_NAME_LC_R2	w01alcDoorR
#define DR_NAME_LC_R3	w01alcDoorR
#define DR_NAME_LC_R4	w01alcDoorR
#define DR_NAME_LC_R5	w01alcDoorR

#define DR_NAME_WT_R1	w01asdr_body_r
#define DR_NAME_WT_R2	w01asdr_body_r
#define DR_NAME_WT_R3	w01asdr_body_r
#define DR_NAME_WT_R4	w01asdr_body_r
#define DR_NAME_WT_R5	w01asdr_body_r

#define DR_NAME_WT_L1	w01asdr_body_l
#define DR_NAME_WT_L2	w01asdr_body_l
#define DR_NAME_WT_L3	w01asdr_body_l
#define DR_NAME_WT_L4	w01asdr_body_l
#define DR_NAME_WT_L5	w01asdr_body_l
/*************************************************************************************/
// リソース
/*************************************************************************************/

// 司令官、危険モード時の音声リソース
resource ghq_area_alert_voice {
	w01a:
		$t{
			t:vc04000e,	//「了解。バックアップは船橋一階左舷へ向かえ」
			t:vc04000f, //「応援部隊、左舷に向かえ。奴を逃がすな！」
			-2,
			t:vc04000c,	//「了解。船橋一階居住区に応援部隊を派遣する｡右舷を固めろ」
			t:vc04000d, //「わかった。応援部隊、右舷にむかえ！。奴を追い込むんだ！」
			-1
		}
	}

	resource ghq_caution_voice {
	w01a:
		$t{
			t:vc040037, //「了解。船橋一階左舷を増員する。警備を強化しろ」
			t:vc040038, //「船橋一階居住区を増員。左舷警戒を固めろ」
			t:vc040035, //「了解。一階居住区を増員。右舷警備を固めろ」
			t:vc040036, //「わかった。右舷に増員。警備を強化せよ！」
			-2,
			t:vc040069, //「船橋一階居住区との連絡が途絶えた。」
			-1			// 全ての登録終了
		}
	a01a:
		$t{
			t:vc046601, //「了解、総員警戒を強化せよ」
			t:vc046601, //「了解、総員警戒を強化せよ」
			t:vc046601, //「了解、総員警戒を強化せよ」
			t:vc046601, //「了解、総員警戒を強化せよ」
			-2,
			t:vc040069, //「船橋一階居住区との連絡が途絶えた。」
			-1			// 全ての登録終了
		}
	}

/****************************************************************************************/
// ドア設定用ステージ内ローカル変数(a_mode.hよりも先に定義する)
/****************************************************************************************/

dim $$b:ドアフラグ[ 6 ]
dim $$s:ドアモデル名[ 6 ]

command	配列セット $$b:ドアフラグ[0] {
	0, 0, 0, 0, 0, 0
}
command	配列セット $$s:ドアモデル名[0] {
	0, 0, 0, 0, 0, 0
}

/*************************************************************************************/
//	enum (includeの前に設定)
/*************************************************************************************/

/*************************************************************************************/
//	Include (enumの後に設定)
/*************************************************************************************/
#include "sna_a01a.mh"		// 強制モーションリスト
#include "stdch.h"
#include "enevoice.h"
#include "a_mode.h"			// アナザーミッション設定ファイル
#include "sload.h"
#include "item_info.h"
#include "a_item_info.h"
#include "sound.h"
#include "ene_item.h"

#if d:MY_DEBUG
	#include "usbkbd.h"
#endif


	// アナザー用プロック マップ設定前に設定する
	@アナザー用マップ定義前設定					// a_mode.h

/*************************************************************************************/
//	マップ起動
/*************************************************************************************/
	chara マップ １Ｆ廻廊部 -k w01a 0 0 0 -k w01af 0 0 0 -h a01a,0 -l d:LT2_NAME
	chara マップ ロッカー部屋 -k w01alc 0 0 0 -h a01a,1 -l d:LT2_NAME

	chara マップ接合 １Ｆ廻廊部／ロッカー部屋＿左 １Ｆ廻廊部 ロッカー部屋
	chara マップ接合 １Ｆ廻廊部／ロッカー部屋＿右 １Ｆ廻廊部 ロッカー部屋

/*************************************************************************************/
//	各マップのキャラ設定
/*************************************************************************************/
	command マップ設定 １Ｆ廻廊部 ロッカー部屋 -set {
		@常駐キャラ設定							// stdch.h
		@ローカル変数初期化
		@A_プレイヤー設定 sna_a01a rai_a01a		// a_stdproc.h
	}

	// アナザー用プロック マップ設定後に設定する
	@アナザー用マップ定義後設定					// a_mode.h

	// 居住区１Ｆ廻廊部側全共通
	command マップ設定 １Ｆ廻廊部 ロッカー部屋 -set {

		@居住区１Ｆ跳弾設定
		//@ポーズ時ステージ名表示設定 \
					//d:wn_船橋一階居住区 		// stdproc.h
		@居住区１Ｆカメラ初期設定
		@子画面設定

		// ステージモデル
		@天井セット
		@プットオブジェセット
		@主観／ビハインド時の表示
		// スライドドアのセット
		@ロッカー部屋ドア設置
		// ステージオブジェクトのセット
		@消火器セット
		// エフェクト
		@フォグセット
		//@鏡面モデル制御
		@シナリオデモキャラセット

		//@アイテム初期設定

		// デバッグ
		#if d:MY_DEBUG
			//@写真撮影用スクリーンショット
			@ＵＳＢキーボードセット
		#endif

	}

	command マップ設定 １Ｆ廻廊部 -set{
		@ドアからの隙間風
		// カメラ設定
		@一回廻廊部カメラ設定					// a01a_cam.h
		// ロードトラップ
		@右舷廻廊からリフレッシュルーム右側廊下へロード
		// ドアトラップ
		@右舷廻廊ドア
		@水密ドア設置
		if( $s:選択プレイヤー == スネーク ){
			@水密ドア取れるハンドルセット
		}
		// エフェクト
		//@水溜まりセット		// a01a_bomb.h へ
		@ロードモデルの窓雨
		@ロード時カメラ曇り
		@ロード時水飛沫

		@敵兵だけ通さない壁の設置	// このプロックは各マップに登録すること
	}

	command マップ設定 ロッカー部屋 -set{

		if( $b:ミッション番号 == d:MISSION:写真撮影 ) {
			@写真撮影ミッション用ロッカー設置
		} else {
			@ロッカー設置
		}


		@ロッカー隙間用プロック		// w01a_locker.h
		@ロッカー部屋カメラ設定		// a01a_cam.h
		@壊れライト設定

		@敵兵だけ通さない壁の設置	// このプロックは各マップに登録すること
	}

	command マップ設定 １Ｆ廻廊部 ロッカー部屋 -set {
		// 最終で行う処理
//		@タンカーデジカメ写真判定
		@座標取得
		// 最後にキャラ環境光設定
		@キャラ専用環境光設定
		@アナザー用最終設定
	}

/*************************************************************************************/
// ステージ開始時フェードイン
/*************************************************************************************/
// 全てのセットが終わったところでフェードイン
	if( $s:登場ポイント == 左舷甲板からロード ) {
		// マップ表示
		command マップ表示 -show １Ｆ廻廊部
		// 開始処理
		@ステージ開始時処理（ステージ名表示） \
			d:LOAD_TYPE:WT_DOOR_TYPE \
			西側水密ドア \
			1700 \
			d:DEFAULT_M_TYPE \
			d:wn_船橋一階居住区左舷

	} else if( $s:登場ポイント == 右舷甲板１Ｆからロード ) {
		// マップ表示
		command マップ表示 -show １Ｆ廻廊部
		// ステージ開始時のカメラ
		chara カメラ設定 ロードカメラ \
			-c 0 \
			-p 8736,1589,-5651 -t 8750,1579,-5750 \
			-r 67,1958,0 -f 100 \
			-a 150 \
			-z d:CAMERA_NO_CUSHION \
			-i 0 2 0 0 \
			-s 1
		@タイマー付きカメラＯＦＦ ロードカメラ 70
		// 開始処理
		@ステージ開始時処理（ステージ名表示） \
			d:LOAD_TYPE:WT_DOOR_TYPE \
			東側水密ドア \
			2000 \
			d:DEFAULT_M_TYPE \
			d:wn_船橋一階居住区右舷

	} else if( $s:登場ポイント == リフレッシュルーム左舷からロード ) {
		// マップ表示
		command マップ表示 -show １Ｆ廻廊部
		// 開始時処理
		@ステージ開始時処理（ステージ名表示） \
			d:LOAD_TYPE:WT_DOOR_TYPE \
			西側廻廊部水密ドア \
			2200 \
			d:DEFAULT_M_TYPE \
			d:wn_船橋一階居住区左舷
		// オブジェクトの表示
		mesg プットオブジェ ロード用Ｗ０１ｆ１ on
		chara delay ディレイ -time 120 -exec {
			mesg プットオブジェ ロード用Ｗ０１ｆ１ off
		}
	} else if( $s:登場ポイント == リフレッシュルーム右舷からロード ) {
		// マップの表示
		command マップ表示 -show １Ｆ廻廊部
		// 開始時処理
		@ステージ開始時処理（ステージ名表示） \
			d:LOAD_TYPE:SL_DOOR_TYPE \
			右舷リフレッシュへのドア \
			1700 \
			d:DEFAULT_M_TYPE \
			d:wn_船橋一階居住区右舷
	} else if(	$s:登場ポイント == 写真撮影ライデン || \
				$s:登場ポイント == 写真撮影スネーク１ || \
				$s:登場ポイント == 写真撮影スネーク２ ) {
		command マップ表示 -show ロッカー部屋
		#if d:DEBUG_PRINT
			@デバッグ用オールタナティブミッション表示
		#endif
	} else {
		command マップ表示 -show １Ｆ廻廊部
		#if d:DEBUG_PRINT
			@デバッグ用オールタナティブミッション表示
		#endif
	}

/*************************************************************************************/
//	初期化
/*************************************************************************************/
	proc ローカル変数初期化 {
		eval( $f:a01a_ドア取れフラグ = 0 )
	}
/*************************************************************************************/
//	エフェクト
/*************************************************************************************/
	proc フォグセット {
		print 'effect フォグセット'

		chara フォグ 霧	-c 4 46 30 -n 1000 -f 23000
	}

/*
	proc 鏡面モデル制御 {
		print 'effect 鏡面モデル制御'

		chara 鏡面モデル管理 床面映り込み \
			-pos 0,0,0 \
			-axis 1 // Y軸反転
		mesg 鏡面モデル管理 床面映り込み add d:PLAYER
		mesg 鏡面モデル管理 床面映り込み add 警備兵:01
		mesg 鏡面モデル管理 床面映り込み add 攻撃兵:01
		mesg 鏡面モデル管理 床面映り込み add 攻撃兵:02
	}
*/

	proc ロードモデルの窓雨 {
		print 'effect ロードモデルの窓雨'

		chara 窓雨 左舷廊下窓   -c -10800 1550 -19900  -s 350 450  -r 0 0 0
		chara 窓雨 右舷廊下窓   -c  10800 1550 -19850  -s 350 450  -r 0 0 0
	}

	proc ロード時カメラ曇り {
		print 'effect ロード時カメラ曇り'

		if( $s:登場ポイント == 左舷甲板からロード ) {
			chara カメラ前曇り カメラ曇り -t 250
		}
	}

	proc ロード時水飛沫 {
		print 'effect ロード時水飛沫'

		if( $s:登場ポイント == 左舷甲板からロード ) {
			chara キャラ付随水飛抹 スネーク水飛沫 \
				-nconcname d:PLAYER \
				-addone 32 \
				-time d:CHARA_SPLASH_TIME \
				-rgbadd 0x40404030 \
				-gbsub 0x40404030
		}
	}

	/*
	proc 水溜まりセット {
		print 'effect 水溜まりセット'

		chara 水溜り管理 水溜り管理人 \
			-n_obj	4 \
			-obj	d:PLAYER \
					警備兵:01 \
					攻撃兵:01 \
					攻撃兵:02

		trap puddle ？ \
			-mask ？ \
			-exec {
				if($3 == 入る){
					mesg 水溜り管理 水溜り管理人 入る $2
				}else{
					mesg 水溜り管理 水溜り管理人 出る $2
				}
			}
	}
	*/

	// キャラ用光源(マップの設置が終わってから設定することで、キャラだけに光を当てる)
	proc キャラ専用環境光設定 {
		print 'effect キャラ専用環境光設定'

		chara 環境光 環境光 -c 43 73 53
		chara 平行光 平行光 -c 47 77 97 -d 512 2560 0
	}

/*************************************************************************************/
// トラップドアのproc化
/*************************************************************************************/

	// リフレッシュルームへのドア
	proc 右舷廻廊ドア {

		// ドアフラグを元にモデルを設定
		@ドアモデル名セット 1 d:DR_NAME1 d:DR_NAME2 d:DR_NAME3 d:DR_NAME4 d:DR_NAME5

		chara ドア 右舷リフレッシュへのドア \
			-m $$s:ドアモデル名[1] \
			-d 0 d:NORTH 0 \
			-p 11550 0 -11000 \
			-slide d:SD_SLIDE_TANKER \
			-time d:SD_OPEN_TIME \
			-between １Ｆ廻廊部 １Ｆ廻廊部 \
			-exec{
				if( !($:開閉フラグ) ){
					mesg プットオブジェ ロード用Ｗ０１ｆ２ off
				}else{
					mesg プットオブジェ ロード用Ｗ０１ｆ２ on
				}
			}
		trap dr001 ？ -mask ＊ \
			-exec {
				if ( $3 == 入る ) {
					mesg ドア 右舷リフレッシュへのドア open $2
				} else if( $3 == 出る ){
					mesg ドア 右舷リフレッシュへのドア close $2
				}
			}

		chara 透明壁 覗きこみ禁止壁 \
				-position	9750,0,-11000,2000 \
							11750,0,-11000,2000 \
				-attribute (d:HZX_SEG_ATR_ALL & ~(d:HZX_SEG_NO_PLAYER))

		mesg 透明壁 覗きこみ禁止壁 off

		trap dr001 d:PLAYER -mask ＊ \
			-exec {
				// 主観時の左右覗き込み操作禁止
				if( `command PlayerStatus -f d:TRP_STATE_SUBJECT ` ){
					mesg 透明壁 覗きこみ禁止壁 on
				}else{
					mesg 透明壁 覗きこみ禁止壁 off
				}
			}
		// 敵兵のみを通す透明壁等の設定
		@A_ドア開閉追加設定 右舷リフレッシュへのドア \
				$$b:ドアフラグ[1] 11550 0 -11000 d:NORTH d:SD_SLIDE_TANKER
	}

	// ロッカー部屋ドアの設定
	proc ロッカー部屋ドア設置 {
	// 左側
		// ドアフラグを元にモデルを設定
		@ドアモデル名セット 4	d:DR_NAME_LC_L1 d:DR_NAME_LC_L2 \
								d:DR_NAME_LC_L3 d:DR_NAME_LC_L4 d:DR_NAME_LC_L5

		chara ドア ロッカー部屋の左ドア \
			-m $$s:ドアモデル名[4] \
			-p -4000 0 5900 \
			-d 0 d:SOUTH 0 \
			-slide d:SD_SLIDE_TANKER \
			-time d:SD_OPEN_TIME \
			-between １Ｆ廻廊部 ロッカー部屋 \
			-exec {
				if( $:開閉フラグ == 0 ){
					//mesg マップ接合 １Ｆ廻廊部／ロッカー部屋＿左 off
					command 即時マップ接合変更 １Ｆ廻廊部／ロッカー部屋＿左 off
				} else {
					//mesg マップ接合 １Ｆ廻廊部／ロッカー部屋＿左 on
					command 即時マップ接合変更 １Ｆ廻廊部／ロッカー部屋＿左 on
				}
			}

		trap dr004 ？ -mask ？ \
			-exec {
				if ( $3 == 入る ) {
					mesg ドア ロッカー部屋の左ドア open $2
				} else{
					mesg ドア ロッカー部屋の左ドア close $2
				}
			}

	// 右側
		// ドアフラグを元にモデルを設定
		@ドアモデル名セット 5	d:DR_NAME_LC_R1 d:DR_NAME_LC_R2 \
								d:DR_NAME_LC_R3 d:DR_NAME_LC_R4 d:DR_NAME_LC_R5

		chara ドア ロッカー部屋の右ドア \
			-m $$s:ドアモデル名[5] \
			-d 0 d:SOUTH 0 \
			-p 4000 0 5900 \
			-slide (0-d:SD_SLIDE_TANKER) \
			-time d:SD_OPEN_TIME \
			-between １Ｆ廻廊部 ロッカー部屋 \
			-exec {
				if( $:開閉フラグ == 0 ){
					//mesg マップ接合 １Ｆ廻廊部／ロッカー部屋＿右 off
					command 即時マップ接合変更 １Ｆ廻廊部／ロッカー部屋＿右 off
				} else {
					//mesg マップ接合 １Ｆ廻廊部／ロッカー部屋＿右 on
					command 即時マップ接合変更 １Ｆ廻廊部／ロッカー部屋＿右 on
				}
			}

		trap dr005 ？ -mask ？ \
			-exec {
				if ( $3 == 入る ) {
					mesg ドア ロッカー部屋の右ドア open $2
				} else {
					mesg ドア ロッカー部屋の右ドア close $2
				}
			}
	}

	// このプロックは各マップに登録すること
	proc 敵兵だけ通さない壁の設置 {

		// 敵兵のみを通す透明壁等の設定
		@A_ドア開閉追加設定 ロッカー部屋の左ドア \
				$$b:ドアフラグ[4] -4000 0 5900 d:SOUTH d:SD_SLIDE_TANKER
		// 敵兵のみを通す透明壁等の設定
		@A_ドア開閉追加設定 ロッカー部屋の右ドア \
				$$b:ドアフラグ[5] 4000 0 5900 d:SOUTH ( 0 - d:SD_SLIDE_TANKER )
	}

/*************************************************************************************/
// 水密ドアの設定
/*************************************************************************************/
	proc 水密ドア設置 {
		print 'water door 水密ドア設置'
		if( `@スネーク達` ) {
			chara 水密ドア管理 水密ドア管理人 -n 3 \
				-seno 1 \
				-motions sna_hatch hatch_door_sna hatch_handle_sna
		} else {
			chara 水密ドア管理 水密ドア管理人 -n 3 \
				-seno 1 \
				-motions rai_wt_hatch hatch_door_sna hatch_handle_sna
		}

		@左舷甲板への水密ドア
		@右舷甲板への水密ドア
		@左舷廻廊への水密ドア
	}

	proc 左舷甲板への水密ドア {
		@ドアモデル名セット 2	d:DR_NAME_WT_R1 d:DR_NAME_WT_R2 \
								d:DR_NAME_WT_R3 d:DR_NAME_WT_R4 d:DR_NAME_WT_R5

		if( $$b:ドアフラグ[2] == d:DOOR_FLAG_OPEN ) {
			if( $s:登場ポイント == 左舷甲板からロード ) {
				eval( $$i:水密ドアフラグ変数 = d:WT_DOOR_FLAG_OPEN_START )
			} else {
				eval( $$i:水密ドアフラグ変数 = d:WT_DOOR_FLAG_NORMAL )
			}
		} else {
			eval( $$i:水密ドアフラグ変数 = d:WT_DOOR_FLAG_NOT_OPEN )
		}


		chara 水密ドア 西側水密ドア \
			-kms $$s:ドアモデル名[2] w01asdr_handle \
			-flag $$i:水密ドアフラグ変数 \
			-position (-8175-1150) 0 -5050 \
			-type 0 \	// 左軸
			-rotate 0,0,0 \
			-hazard -9250,0,-5200 -8250,0,-5200 \
			-proc 左舷廻廊から左舷甲板へロード

		trap dr002 d:PLAYER -mask いる \
			-button d:ACTION_BUTTON \
			-state d:TRP_STATE_STAND \
			-exec {
				command 水密ドア状態 -n 西側水密ドア
				mesg プレイヤー d:PLAYER wt_door 西側水密ドア $status 0,1024 (-8175-1150),-5050 1
		}

		trap dr002 d:PLAYER -mask ？ -state 6 \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 1 ) {
					if( $w:アラートモード == 0 ){
						chara カメラ設定 モーションカメラ \
							-c 1 \
							-p -8758,4553,-5545 -t -8758,656,-5911 \
							-r 963,2048,0 -f 3914 \
							-a 371 \
							-i 3 3 0 0 \
							-s $3
					}else{
						chara カメラ設定 モーションカメラ \
							-c 1 \
							-p -8784,4750,-5650 -t -8784,1000,-6150 \
							-r 937,2048,0 -f 3783 \
							-a 200 \
							-i 3 3 0 0 \
							-s $3
					}
				}
			}

		// ステージスタート時のロードカメラ
		trap dr106 d:PLAYER -mask ？ \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 0 ) {
					chara カメラ設定 モーションカメラ \
							-c 1 \
							-p -5306,2648,-6252 -t -8514,1155,-5428 \
							-r 276,3236,0 -f 3633 \
							-a 200 \
							-i 1 0 0 0 \
							-s $3

					mesg ローカル風 隙間風 オン

					chara delay ディレイ -time 1 -exec {
						command ＳＥセットモード -s d:se_code:SD_A_DRCRAIN1 -p -8750 1000 -5250 -m 0
					}
					chara delay ディレイ -time 100 -exec {
						mesg ローカル風 隙間風 オフ
					}
				}
			}
	}

	proc 右舷甲板への水密ドア {
		@ドアモデル名セット 3	d:DR_NAME_WT_L1 d:DR_NAME_WT_L2 \
								d:DR_NAME_WT_L3 d:DR_NAME_WT_L4 d:DR_NAME_WT_L5

		if( $$b:ドアフラグ[3] == d:DOOR_FLAG_OPEN ) {
			if( $s:登場ポイント == 右舷甲板１Ｆからロード ) {
				eval( $$i:水密ドアフラグ変数 = d:WT_DOOR_FLAG_OPEN_START );
			} else {
				eval( $$i:水密ドアフラグ変数 = d:WT_DOOR_FLAG_NORMAL );
			}
		} else {
			eval( $$i:水密ドアフラグ変数 = d:WT_DOOR_FLAG_NOT_OPEN );
		}


		chara 水密ドア 東側水密ドア \
			-kms $$s:ドアモデル名[3] w01asdr_handle \
			-flag $$i:水密ドアフラグ変数 \
			-position (8175+1150) 0 -5050 \
			-type 1 \	// 右軸
			-rotate 0,2048,0 \
			-hazard 8250,0,-5200 9250,0,-5200 \
			-proc 右舷廻廊から右舷甲板へロード

		trap dr003 d:PLAYER \
			-mask いる -button d:ACTION_BUTTON -state 0 \
			-exec {
				command 水密ドア状態 -n 東側水密ドア
				mesg プレイヤー d:PLAYER wt_door 東側水密ドア $status 0,1024 (8175),-5050 1
		}

		trap dr003 d:PLAYER -mask ？ -state 6 \
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 8784,4750,-5650 -t 8784,1000,-6150 \
					-r 937,2048,0 -f 3783 \
					-a 200 \
					-i 3 3 0 0 \
					-s $3
			}

		// ステージスタート時のロードカメラ
		trap dr107 d:PLAYER -mask ？ \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 0 ) {
					/*
					chara カメラ設定 モーションカメラ \
							-c 1 \
							-p -5306,2648,-6252 -t -8514,1155,-5428 \
							-r 276,3236,0 -f 3633 \
							-a 200 \
							-i 1 0 0 0 \
							-s $3
					*/

					mesg ローカル風 隙間風 オン

					chara delay ディレイ -time 1 -exec {
						command ＳＥセットモード -s d:se_code:SD_A_DRCRAIN1 -p 8750 1000 -5250 -m 0
					}
					chara delay ディレイ -time 100 -exec {
						mesg ローカル風 隙間風 オフ
					}
				}
			}
	}

	proc 左舷廻廊への水密ドア {
		@ドアモデル名セット 0	d:DR_NAME_WT_R1 d:DR_NAME_WT_R2 \
								d:DR_NAME_WT_R3 d:DR_NAME_WT_R4 d:DR_NAME_WT_R5

		if( $$b:ドアフラグ[0] == d:DOOR_FLAG_OPEN ) {
			if( $s:選択プレイヤー == スネーク ){
				// スネークの時は一方通行
				if( $s:登場ポイント == リフレッシュルーム左舷からロード ) {
					eval( $i:ローカル変数Ｉ１ = d:WT_DOOR_FLAG_OPEN_START | \
												d:WT_DOOR_FLAG_NOT_OPEN )
					eval( $s:ローカル変数Ｓ１ = w01asdr_handle )	// 両面ハンドル
				} else {
					eval( $i:ローカル変数Ｉ１ = d:WT_DOOR_FLAG_NOT_OPEN )
					eval( $s:ローカル変数Ｓ１ = w01asdr_handle2 )	// 片面ハンドル
				}
			} else {
				if( $s:登場ポイント == リフレッシュルーム左舷からロード ) {
					eval( $i:ローカル変数Ｉ１ = d:WT_DOOR_FLAG_OPEN_START )
				} else {
					eval( $i:ローカル変数Ｉ１ = d:WT_DOOR_FLAG_NORMAL )
				}
				eval( $s:ローカル変数Ｓ１ = w01asdr_handle )	// 両面ハンドル
			}
		} else {
			eval( $i:ローカル変数Ｉ１ = d:WT_DOOR_FLAG_NOT_OPEN );
			eval( $s:ローカル変数Ｓ１ = w01asdr_handle2 )	// 片面ハンドル
		}


		chara 水密ドア 西側廻廊部水密ドア \
			-kms $$s:ドアモデル名[0] $s:ローカル変数Ｓ１ \
			-position -11375 0 -10950 \
			-type 0 \	// 左軸
			-rotate 0,0,0 \
			-flag $i:ローカル変数Ｉ１ \
			-hazard -11300,0,-10900 -10300,0,-10900 \
			-proc 左舷廻廊Ａから左舷廻廊Ｆへロード

		// ハンドル回し中のカメラ
		trap dr000 d:PLAYER -mask ？ \
			-state d:TRP_STATE_FORCE \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 1 ) {
					if( $s:選択プレイヤー == スネーク ){
						chara カメラ設定 モーションカメラ \
							-c 1 \
							-p -11621,1713,-9626 -t -11013,1488,-10239 \
							-r 166,1539,0 -f 892 \
							-a 200 \
							-i 3 3 0 0 \
							-s $3
					} else {
						chara カメラ設定 モーションカメラ \
							-c 1 \
							-p -11189,1901,-8386 -t -10795,1511,-10307 \
							-r 128,1916,0 -f 1999 \
							-a 200 \
							-i 3 3 0 0 \
							-s $3
					}
				}
			}

		trap dr000 d:PLAYER \
			-mask いる -button d:ACTION_BUTTON -state 0 \
			-exec {
				if( $s:選択プレイヤー == スネーク ){
					@ドア取れイベント発動チェック
				} else {
					command 水密ドア状態 -n 西側廻廊部水密ドア
					mesg プレイヤー d:PLAYER wt_door 西側廻廊部水密ドア $status 2048,1024 -11375,-10950 1
				}
		}

	}

/*************************************************************************************/
// 水密ドアハンドル取れるイベント
/*************************************************************************************/
	// スネークハンドル取る関連のプロック
	proc 水密ドア取れるハンドルセット {
		chara プットモーションモデル 取れるハンドル \
			-pos  -10800 0 -10980 \
			-dir 2048 \
			-kms w01asdr_handle3 \
			-mar wtdoor_break \
			-number 0 \
			-status d:PUT_MOT_WAIT

		mesg プットモーションモデル 取れるハンドル 非表示
	}

	proc ドア取れイベント発動チェック {

		if( `@シナリオデモ用安全チェック` && !$f:a01a_ドア取れフラグ) {
			eval( $f:a01a_ドア取れフラグ = 1 )
			#if d:VAR_SAVE
				command varsave $f:a01a_ドア取れフラグ
			#endif

			@シナリオデモ開始処理
			mesg コマンダー 敵兵セット 視界オン		// 視界は見えたまま
			@ドア取れイベント安全確認監視

			// 水密ドアのハンドルを非表示
			mesg 水密ドア 西側廻廊部水密ドア handle 0

			// 取れるモーションの表示
			mesg プットモーションモデル 取れるハンドル 表示

			// プレイヤーのモーション発動
			mesg プレイヤー d:PLAYER motion \
				d:モーションリスト:sna_non_hatch_pop_out \
				2048 \	// 初期方向
				-1 \	// 終了方向
				0 \		// 終了姿勢(立ち)
				( d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT | d:FA_NO_WEAPON ) \
				-10800 -10280 1000	//x,z,yの順

			// ハンドルのモーション発動
			mesg プットモーションモデル 取れるハンドル 終了判定  0

			// 終了プロックの登録
			command	強制モーション終了プロック \
				-motion d:モーションリスト:sna_non_hatch_pop_out \
				-proc 取れるハンドル終了プロック

			chara デモキャンセルチェック Ch_ハンドルイベントキャンセル \
				-p Pr_ハンドルイベントキャンセル

		} else {
			command 水密ドア状態 -n 西側廻廊部水密ドア
			mesg プレイヤー d:PLAYER wt_door 西側廻廊部水密ドア $status 2048,1024 -11375,-10950 1
		}
	}

	proc ドア取れイベント安全確認監視 {
		chara プロック連続実行 ドア取れイベント安全確認連続実行 -time -1 -exec {
			if( `@シナリオデモ安全チェック` ) {
				print 'やばい！作戦は中止だ'
				mesg プロック連続実行 ドア取れイベント安全確認連続実行 kill
				@Pr_ハンドルイベントキャンセル
			}
		}
	}

	proc Pr_ハンドルイベントキャンセル {
		print 'ハンドルイベントキャンセル'

		mesg デモキャンセルチェック Ch_ハンドルイベントキャンセル kill

		command 強制モーションキャンセル
	}

	proc 取れるハンドル終了プロック {
		print 'ハンドルデモ終了プロック start'

		mesg デモキャンセルチェック Ch_ハンドルイベントキャンセル kill

		mesg 水密ドア 西側廻廊部水密ドア handle 1
		mesg プットモーションモデル 取れるハンドル 非表示

		@シナリオデモ終了処理

		print 'ハンドルデモ終了プロック end'
	}

/*************************************************************************************/
// 入出ロードのproc化
/*************************************************************************************/
	proc ロードプロック {
		if ($s:呼び出しプロック == mv_a01a_a00a_0) {
			@mv_a01a_a00a_0
		} else if ($s:呼び出しプロック == mv_a01a_a00a_1) {
			@mv_a01a_a00a_1
		} else if ($s:呼び出しプロック == mv_a01a_a01f_0x) {
			@mv_a01a_a01f_0x
		} else if ($s:呼び出しプロック == mv_a01a_a01f_1x) {
			@mv_a01a_a01f_1x
		}
	}

	proc 左舷廻廊から左舷甲板へロード $:トリガ {
		if ( $:トリガ == 0 ) {	// 扉が完全に開いたら
			chara カメラ設定 ロードカメラ \
				-c 1 \
				-p -8784,4750,-5650 -t -8784,1000,-6150 \
				-r 937,2048,0 -f 3783 \
				-a 200 \
				-i 3 0 0 0 \
				-s 1

			preseek 'a00a'
			@ステージ終了時処理（ステージ名表示） \
				-8750 0 -3000 0 \
				mv_a01a_a00a_0 \
				d:DEFAULT_M_TYPE \
				d:wn_船尾甲板左舷
		}else if ( $:トリガ == 3 ) {
			// 水密ドアが開き始めたら隙間風を吹かす
			chara delay ディレイ -time 45 -exec {
				mesg ローカル風 隙間風 オン
				command ＳＥセットモード -s d:se_code:SD_A_DRORAIN1 -p -8750 1000 -5250 -m 0
			}
		}
	}

	proc 右舷廻廊から右舷甲板へロード $:トリガ {
			if( $:トリガ == 0 ){	// 扉が完全に開いたら
				chara カメラ設定 ロードカメラ \
					-c 1 \
					-p 8784,4750,-5650 -t 8784,1000,-6150 \
					-r 937,2048,0 -f 3783 \
					-a 200 \
					-i 3 0 0 0 \
					-s 1

				preseek 'a00a'
				@ステージ終了時処理（ステージ名表示） \
					8750 0 -3000 \
					d:SOUTH \
					mv_a01a_a00a_1 \
					d:DEFAULT_M_TYPE \
					d:wn_船尾甲板右舷

			}else if ( $:トリガ == 3 ) {
				// 水密ドアが開き始めたら隙間風を吹かす
				chara delay ディレイ -time 45 -exec {
					mesg ローカル風 隙間風 オン
					command ＳＥセットモード -s d:se_code:SD_A_DRORAIN1 -p 8750 1000 -5250 -m 0
				}
			}
	}

	proc 左舷廻廊Ａから左舷廻廊Ｆへロード $:トリガ {

		if( $f:ロードチェックＯＮフラグ == 1 ) {
			if( $:トリガ == 3 ){		// 扉が開き始めたら
				mesg プットオブジェ ロード用Ｗ０１ｆ１ on
			}else if( $:トリガ == 0 ) {	// 扉が完全に開いたら
				chara カメラ設定 ロードカメラ \
					-c 1 \
					-p -10158,2529,-7930 -t -10558,1370,-9549 \
					-r 396,2206,0 -f 2031 \
					-a 200 \
					-i 3 0 0 0 \
					-s 1

				preseek 'a01f'
				@ステージ終了時処理（ステージ名表示） \
					-10750 0 -13000 2048 \
					mv_a01a_a01f_0x \
					d:DEFAULT_M_TYPE \
					d:wn_船橋一階リフレッシュルーム左舷
			}
		}

	}

	proc 右舷廻廊からリフレッシュルーム右側廊下へロード {
		trap ld003 d:PLAYER -mask 入る \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 1 ) {
					chara カメラ設定 ロードカメラ \
						-c 1 \
						-p 11272,1969,-7650 -t 10579,1461,-10067 \
						-r 130,2230,0 -f 2566 \
						-a 200 \
						-i 3 0 0 0 \
						-s $3

					preseek 'a01f'
					@ステージ終了時処理（ステージ名表示） \
						10750 0 -13000 2048 \
						mv_a01a_a01f_1x \
						d:DEFAULT_M_TYPE \
						d:wn_船橋一階リフレッシュルーム右舷
				}
			}

		// ステージスタート時のロードカメラ
		trap dr109 d:PLAYER -mask ？ \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 0 ) {
					chara カメラ設定 ロードカメラ \
						-c 1 \
						-p 11272,1969,-7650 -t 10579,1461,-10067 \
						-r 130,2230,0 -f 2566 \
						-a 200 \
						-i 0 2 0 0 \
						-s $3
				}
			}
	}

