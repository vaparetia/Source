						eval( $w:カメラ補完方式 = 0 )
					}else{
						eval( $w:カメラ補完方式 = 1 )
					}
				}

				chara カメラ設定 通路カメラ１ \
					-c 0 \
					-b 6269,4968,-5758  10361,4968,-5758 \
					-l 6269,1096,-6362  10361,1096,-6362 \
					-r 923,2048,0 -f 3919 \
					-a 200 \
					-i $w:カメラ補完方式 -1 0 0 \
					-slide 0 2 1000 1000 60 0 \
					-s $3
			}
	}

