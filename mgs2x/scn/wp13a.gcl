// ------------------------------------
// マップ設定
// ------------------------------------
chara マップ 武器訓練マシンガン３面 -k d:KMS_NAME -h d:HZX_NAME,0 -l $s:ＶＲライトファイル名

command マップ設定 武器訓練マシンガン３面 -set {
	// ローカルの初期化
	// ------------------------------------
	@ローカル変数初期化		// ローカルで使用する変数で初期化をする場合はここで

	// ＶＲで必要な基本プロックのセット(vr_common.hで定義)
	// サウンドの基本パック、ＶＲの基本システム、プレイヤー、ゴール等を設定します
	// ※このプロックを使用する時は「ＶＲクリア時処理」というプロックが必要です
	// ------------------------------------
	@ＶＲ共通プロックセット sna_wp13a rai_wp13a d:VR_GOAL_TARGET -3000 0 4000

	// ＶＲウィンドウの設定
	// ------------------------------------
	@武器訓練マシンガン３面ＶＲウィンドウ設定

	// クリア時に呼ばれるものの設定
	// ------------------------------------
	@ＶＲクリア設定 p:load_wp14a p:load_wp13a

	// ステージに引かれるライン
	// ------------------------------------
	@ＶＲアウトライン d:KMS_NAME d:TONBO_KMS_NAME d:LINE_KMS_NAME

	// 設定値を変更する場合は以下のプロック内で設定
	// ------------------------------------
	@設定値変更				// 敵兵や的のパラメータをステージ限定で変える時はここで
	@プラグイン設定			// プレイヤーのプラグインがいる時はここで

	// 的関係の設定
	// ------------------------------------
	@ＶＲ標的マシンガン３面設定				// ＶＲシステム起動後に呼ぶ

	// ＢＧＭの設定(プレイヤー→敵兵→BGMの順で呼ぶ。的の場合は関係ないがとりあえずここに)
	// ------------------------------------
	@ＢＧＭ設定

	// アイテムの設定
	// ------------------------------------
	@アイテム設定

	// 光源、オブジェクト、カメラ関連の設定
	// ------------------------------------
	@ＶＲフォグ設定 d:VR_FOG:朝Ｎ 33000 d:VR_FOG:夕Ｎ 30000 d:VR_FOG:夜Ｎ 25000
	@カメラセット						// chara カメラとベースのカメラを設定
	@武器訓練マシンガン３面カメラ設定	// ステージ固有のカメラ設定がいる時はこのプロックで
	@ＶＲキャラ用ライト設置				// vr_common.hに定義。必ず最後に設定
#if d:DEBUG_CHARA
//	@デバッグキャラセット
#endif

}

//初期マップの表示
command マップ表示 -show 武器訓練マシンガン３面


//###################################################################################
//									各proc設定
//###################################################################################



//###################################################################################
//									全マップ共通
//###################################################################################
	// ------------------------------------
	// 全マップ共通
	// ------------------------------------
	//------------------------------------------------------------
	// ＶＲウィンドウの設定と表示
	//------------------------------------------------------------
	proc 武器訓練マシンガン３面ＶＲウィンドウ設定 {
		#if d:DEBUG_PRINT
			print 'vr_window_set'
		#endif

		@ＶＲウィンドウ設定	[VRMSG_J:VRM_WPN_ASR_wp13a] [VRMSG_E:VRM_WPN_ASR_wp13a] [VRMSG_G:VRM_WPN_ASR_wp13a] \	// 日、英、独
							[VRMSG_F:VRM_WPN_ASR_wp13a] [VRMSG_I:VRM_WPN_ASR_wp13a] [VRMSG_S:VRM_WPN_ASR_wp13a] \	// 仏、伊、西
							[VRMSG_K:VRM_WPN_ASR_wp13a] \															// 韓
							p:ＶＲステージ開始時処理								// 終了プロック


		// ＶＲウィンドウを表示する
		mesg ＶＲウィンドウ ＶＲウィンドウ君 開く

		// スタート時とクリア時に使用するカットインカメラ
		chara カメラ カットインカメラ		-c 0 -l 0 -p 0

		// スタート時のカメラ(必要な場合)
		chara カメラ設定 カットインカメラ \
			-c 1 \	
			-p -3000,6600,6350 -t -3000,0,4000 \
			-r 800,2048,0 -f 7000 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1
	}

	//------------------------------------------------------------
	// ステージ開始時処理
	//------------------------------------------------------------
	proc ＶＲステージ開始時処理 {
		#if d:DEBUG_PRINT
			print 'game_start!!!!!'
		#endif

		// プレイヤーやパッドの制御等を行う a_stdproc.hで定義
		@全ミッション共通ステージ開始時処理

		// カメラワークスタート(必要な場合)
		// 全体図
		chara カメラ設定 カットインカメラ \
			-c 1 \	
			-p 0,20000,20000 -t 0,11600,11500 \
			-r 500,2048,0 -f 12000 \
			-a 200 \
			-i 4 4 d:START_CAMERA_CHANGE_TIME d:START_CAMERA_CHANGE_TIME \
			-s 1

		chara delay ディレイ \
			-time d:START_CAMERA_CHANGE_TIME \
			-exec {
				chara カメラ設定 カットインカメラ -s -1
			}
	}

	// ------------------------------------
	// クリア時の処理
	// ------------------------------------
	proc ＶＲクリア時処理 {
		#if d:DEBUG_PRINT
			print 'clear'
		#endif

		// 強制モーションを発動
		@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_1 3773

		// クリア時にカメラアングルを変える
		chara カメラ設定 クリア時カメラ \
			-c 1 \
			-p -5000,1500,7320 -t -3100,1200,3800 \
			-r 50,1725,0 -f 4000 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}

	//------------------------------------------------------------
	// ステージ開始直後処理
	//------------------------------------------------------------
	proc ゲーム開始直後処理 {
		// 初期配置標的の起動（command ＶＲステージスタート の起動直後に行う必要がある）
		@ＶＲ初期配置標的マシンガン３面設定
	}



	// ------------------------------------
	// パラメータ系の変更
	// ------------------------------------
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT
			print 'localvar_init'
		#endif

		//	的管理用各種フラグを初期化する
		$$b:act_1_破壊数カウント = 0;
		$$b:act_2_破壊数カウント = 0;
		$$b:act_3_破壊数カウント = 0;
		$$b:act_4_破壊数カウント = 0;

		$$b:標的セット数 = 0;
		$$i:標的フラグ = 0;

//		$$i:標的フラグＡ = ( d:VR_TRG_CROSS | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST );
//		$$i:標的フラグＢ = ( d:VR_TRG_CROSS | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST );
//		$$i:標的フラグＣ = ( d:VR_TRG_CROSS | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    );
		$$i:標的フラグＤ = ( d:VR_TRG_CROSS | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST                  | d:VR_TRG_WAIT );
		$$i:標的フラグＥ = ( d:VR_TRG_CROSS | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST | d:VR_TRG_WAIT );
		$$i:標的フラグＦ = ( d:VR_TRG_CROSS | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    | d:VR_TRG_WAIT );
//		$$i:標的フラグＧ = ( d:VR_TRG_CROSS | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST                  | d:VR_TRG_WAIT | d:VR_TRG_CIRCLE );
//		$$i:標的フラグＨ = ( d:VR_TRG_CROSS | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST | d:VR_TRG_WAIT | d:VR_TRG_CIRCLE );
//		$$i:標的フラグＩ = ( d:VR_TRG_CROSS | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    | d:VR_TRG_WAIT | d:VR_TRG_CIRCLE );
//		$$i:標的フラグＪ = ( d:VR_TRG_CROSS | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST                  | d:VR_TRG_WAIT | d:VR_TRG_NO_APPEAR_EF );
//		$$i:標的フラグＫ = ( d:VR_TRG_CROSS | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST | d:VR_TRG_WAIT | d:VR_TRG_NO_APPEAR_EF );
//		$$i:標的フラグＬ = ( d:VR_TRG_CROSS | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    | d:VR_TRG_WAIT | d:VR_TRG_NO_APPEAR_EF );
	}

	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT
			print 'status_set'
		#endif

		// 初期装備の設定
		if ( $s:選択プレイヤー == ライデン ) {
			// ライデン系を選択
			$w:武器弾数Ｒ[ d:武器:Ｍ４ ] = 500
			$w:武器 = d:武器:Ｍ４
		} else {
			// スネーク系を選択
			$w:武器弾数Ｒ[ d:武器:ＡＫＳ ] = 500
			$w:武器 = d:武器:ＡＫＳ
//			$w:アイテム = d:アイテム:ＡＫサプレッサ
		}

	}
	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif
	}



//###################################################################################
//									 的兵
//###################################################################################

	// ------------------------------------
	// マシンガン３面
	// ------------------------------------
	// 破壊時処理
	// ------------------------------------
	proc ＶＲ標的破壊マシンガン３面処理 {

		// ライデン or タキシードスネークを選択
		if ( ($s:選択プレイヤー == ライデン) ||  ($s:選択プレイヤー == タキシードスネーク) ) {

			if ( ($1 == 移動的:06) || ($1 == 移動的:07) || ($1 == 移動的:08) ) {
				$$b:act_2_破壊数カウント = $$b:act_2_破壊数カウント + 1
				if ( $$b:act_2_破壊数カウント == 3 ){
					mesg ＶＲ的共通 移動的:09 移動開始
					mesg ＶＲ的共通 移動的:10 移動開始
					mesg ＶＲ的共通 移動的:11 移動開始
					mesg ＶＲ的共通 移動的:12 移動開始
				}
			} else if ( ($1 == 移動的:09) || ($1 == 移動的:10) || ($1 == 移動的:11) || ($1 == 移動的:12) ) {
				$$b:act_3_破壊数カウント = $$b:act_3_破壊数カウント + 1
				if ( $$b:act_3_破壊数カウント == 4 ){
					mesg ＶＲ的共通 移動的:13 移動開始
				}
			} else if ( ($1 == 移動的:13) || ($1 == 移動的:14) || ($1 == 移動的:15) ) {
				$$b:act_4_破壊数カウント = $$b:act_4_破壊数カウント + 1
				if ( $$b:act_4_破壊数カウント == 3 ){
					mesg ＶＲ的共通 移動的:16 移動開始
					mesg ＶＲ的共通 移動的:17 移動開始
					mesg ＶＲ的共通 移動的:18 移動開始
					mesg ＶＲ的共通 移動的:19 移動開始
					mesg ＶＲ的共通 移動的:20 移動開始
				}
			} else if ( ($1 == 移動的:16) || ($1 == 移動的:17) || ($1 == 移動的:18) || \
						($1 == 移動的:19) || ($1 == 移動的:20) || ($1 == 移動的:21) ) {
				$$b:act_4_破壊数カウント = $$b:act_4_破壊数カウント + 1
			}

			if ( ($$b:act_2_破壊数カウント + $$b:act_3_破壊数カウント + $$b:act_4_破壊数カウント) == 10 ) {
				command foreach -argc 1 -repeat 2 \
				-data { \
					// 的名
					{ 移動的:01 }\
					{ 移動的:02 }\
				} \
				-exec { \
					mesg ＶＲ的共通 $1 消滅
				}
			}

		// スネーク or プリスキンを選択
		} else if ( ($s:選択プレイヤー == スネーク) || ($s:選択プレイヤー == プリスキン) ) {

			if ( ($1 == 移動的:06) || ($1 == 移動的:07) || ($1 == 移動的:08) ) {
				$$b:act_2_破壊数カウント = $$b:act_2_破壊数カウント + 1
				if ( $$b:act_2_破壊数カウント == 3 ){
					mesg ＶＲ的共通 移動的:09 移動開始
					mesg ＶＲ的共通 移動的:10 移動開始
					mesg ＶＲ的共通 移動的:11 移動開始
					mesg ＶＲ的共通 移動的:12 移動開始
					mesg ＶＲ的共通 移動的:13 移動開始
					mesg ＶＲ的共通 移動的:14 移動開始
				}
			} else if ( ($1 == 移動的:09) || ($1 == 移動的:10) || ($1 == 移動的:11) || \
						($1 == 移動的:12) || ($1 == 移動的:13) || ($1 == 移動的:14) ) {
				$$b:act_3_破壊数カウント = $$b:act_3_破壊数カウント + 1
				if ( $$b:act_3_破壊数カウント == 6 ){
					mesg ＶＲ的共通 移動的:15 移動開始
					mesg ＶＲ的共通 移動的:16 移動開始
					mesg ＶＲ的共通 移動的:17 移動開始
					mesg ＶＲ的共通 移動的:18 移動開始
					mesg ＶＲ的共通 移動的:19 移動開始
					mesg ＶＲ的共通 移動的:20 移動開始
				}
			} else if ( ($1 == 移動的:15) || ($1 == 移動的:16) || ($1 == 移動的:17) || \
						($1 == 移動的:18) || ($1 == 移動的:19) || ($1 == 移動的:20) ) {
				$$b:act_4_破壊数カウント = $$b:act_4_破壊数カウント + 1
				if ( $$b:act_4_破壊数カウント == 6 ){
					mesg ＶＲ的共通 移動的:21 移動開始
					mesg ＶＲ的共通 移動的:22 移動開始
					mesg ＶＲ的共通 移動的:23 移動開始
					mesg ＶＲ的共通 移動的:24 移動開始
					mesg ＶＲ的共通 移動的:25 移動開始
					mesg ＶＲ的共通 移動的:26 移動開始
				}
			}

			if ( ($$b:act_2_破壊数カウント + $$b:act_3_破壊数カウント + $$b:act_4_破壊数カウント) == 15 ) {
				command foreach -argc 1 -repeat 3 \
				-data { \
					// 的名
					{ 移動的:01 }\
					{ 移動的:02 }\
					{ 移動的:03 }\
				} \
				-exec { \
					mesg ＶＲ的共通 $1 消滅
				}
			}

		// 前作スネークを選択
		} else if ( $s:選択プレイヤー == 前作スネーク ) {

			if ( ($1 == 移動的:06) || ($1 == 移動的:07) || ($1 == 移動的:08) || ($1 == 移動的:09) ) {
				$$b:act_2_破壊数カウント = $$b:act_2_破壊数カウント + 1
				if ( $$b:act_2_破壊数カウント == 4 ){
					mesg ＶＲ的共通 移動的:10 移動開始
					mesg ＶＲ的共通 移動的:11 移動開始
					mesg ＶＲ的共通 移動的:12 移動開始
					mesg ＶＲ的共通 移動的:13 移動開始
					mesg ＶＲ的共通 移動的:14 移動開始
					mesg ＶＲ的共通 移動的:15 移動開始
					mesg ＶＲ的共通 移動的:16 移動開始
					mesg ＶＲ的共通 移動的:17 移動開始
				}
			} else if ( ($1 == 移動的:10) || ($1 == 移動的:11) || ($1 == 移動的:12) || ($1 == 移動的:13) || \
						($1 == 移動的:14) || ($1 == 移動的:15) || ($1 == 移動的:16) || ($1 == 移動的:17) ) {
				$$b:act_3_破壊数カウント = $$b:act_3_破壊数カウント + 1
				if ( $$b:act_3_破壊数カウント == 8 ){
					mesg ＶＲ的共通 移動的:18 移動開始
					mesg ＶＲ的共通 移動的:19 移動開始
					mesg ＶＲ的共通 移動的:20 移動開始
					mesg ＶＲ的共通 移動的:21 移動開始
					mesg ＶＲ的共通 移動的:22 移動開始
					mesg ＶＲ的共通 移動的:23 移動開始
				}
			} else if ( ($1 == 移動的:18) || ($1 == 移動的:19) || ($1 == 移動的:20) || \
						($1 == 移動的:21) || ($1 == 移動的:22) || ($1 == 移動的:23) ) {
				$$b:act_4_破壊数カウント = $$b:act_4_破壊数カウント + 1
				if ( $$b:act_4_破壊数カウント == 6 ){
					mesg ＶＲ的共通 移動的:24 移動開始
					mesg ＶＲ的共通 移動的:25 移動開始
					mesg ＶＲ的共通 移動的:26 移動開始
					mesg ＶＲ的共通 移動的:27 移動開始
					mesg ＶＲ的共通 移動的:28 移動開始
				}

			}

			if ( ($$b:act_2_破壊数カウント + $$b:act_3_破壊数カウント + $$b:act_4_破壊数カウント) == 18 ) {
				command foreach -argc 1 -repeat 3 \
				-data { \
					// 的名
					{ 移動的:01 }\
					{ 移動的:02 }\
					{ 移動的:03 }\
				} \
				-exec { \
					mesg ＶＲ的共通 $1 消滅
				}
			}

		}

	}

	// ルート切り替え処理
	// ------------------------------------
	proc ＶＲルート分岐開始マシンガン３面処理 {

		// ライデン or タキシードスネークを選択
		if ( ($s:選択プレイヤー == ライデン) ||  ($s:選択プレイヤー == タキシードスネーク) ) {

			if ( $1 == 移動的:09 ) {
				mesg ＶＲ移動的 $1 即ルート変更 d:M_R:ライデンルート１１
			} else if ( $1 == 移動的:10 ) {
				mesg ＶＲ移動的 $1 即ルート変更 d:M_R:ライデンルート１２
			} else if ( $1 == 移動的:11 ) {
				mesg ＶＲ移動的 $1 即ルート変更 d:M_R:ライデンルート１５
			} else if ( $1 == 移動的:12 ) {
				mesg ＶＲ移動的 $1 即ルート変更 d:M_R:ライデンルート１６

			} else if ( $1 == 移動的:13 ) {
				mesg ＶＲ移動的 $1 即ルート変更 d:M_R:ライデンルート１８
				mesg ＶＲ的共通 移動的:14 移動開始
			} else if ( $1 == 移動的:14 ) {
				mesg ＶＲ移動的 $1 即ルート変更 d:M_R:ライデンルート１９
				mesg ＶＲ的共通 移動的:15 移動開始
			} else if ( $1 == 移動的:15 ) {
				mesg ＶＲ移動的 $1 即ルート変更 d:M_R:ライデンルート２０
			}

		// スネーク or プリスキンを選択
		} else if ( ($s:選択プレイヤー == スネーク) || ($s:選択プレイヤー == プリスキン) ) {

			if ( $1 == 移動的:15 ) {
				mesg ＶＲ移動的 $1 即ルート変更 d:M_R:スネークルート３８
			} else if ( $1 == 移動的:16 ) {
				mesg ＶＲ移動的 $1 即ルート変更 d:M_R:スネークルート３９
			} else if ( $1 == 移動的:17 ) {
				mesg ＶＲ移動的 $1 即ルート変更 d:M_R:スネークルート４０
			} else if ( $1 == 移動的:18 ) {
				mesg ＶＲ移動的 $1 即ルート変更 d:M_R:スネークルート４１
			} else if ( $1 == 移動的:19 ) {
				mesg ＶＲ移動的 $1 即ルート変更 d:M_R:スネークルート４２
			} else if ( $1 == 移動的:20 ) {
				mesg ＶＲ移動的 $1 即ルート変更 d:M_R:スネークルート４３
			}

		// 前作スネークを選択
		} else if ( $s:選択プレイヤー == 前作スネーク ) {

			if ( $1 == 移動的:10 ) {
				mesg ＶＲ移動的 $1 即ルート変更 d:M_R:前作スネークルート５９
			} else if ( $1 == 移動的:11 ) {
				mesg ＶＲ移動的 $1 即ルート変更 d:M_R:前作スネークルート６０
			} else if ( $1 == 移動的:12 ) {
				mesg ＶＲ移動的 $1 即ルート変更 d:M_R:前作スネークルート６１
			} else if ( $1 == 移動的:13 ) {
				mesg ＶＲ移動的 $1 即ルート変更 d:M_R:前作スネークルート６２
			} else if ( $1 == 移動的:14 ) {
				mesg ＶＲ移動的 $1 即ルート変更 d:M_R:前作スネークルート６７
			} else if ( $1 == 移動的:15 ) {
				mesg ＶＲ移動的 $1 即ルート変更 d:M_R:前作スネークルート６８
			} else if ( $1 == 移動的:16 ) {
				mesg ＶＲ移動的 $1 即ルート変更 d:M_R:前作スネークルート６９
			} else if ( $1 == 移動的:17 ) {
				mesg ＶＲ移動的 $1 即ルート変更 d:M_R:前作スネークルート７０
			}

		}

	}

	// 敵兵や的の処理
	// ------------------------------------
	proc ＶＲ標的マシンガン３面設定 {
		// ライデン or タキシードスネークを選択
		if ( ($s:選択プレイヤー == ライデン) ||  ($s:選択プレイヤー == タキシードスネーク) ) {

			command foreach -argc 2 -repeat 2 \
			-data { \
				// 的名,     ルート
				// act 1 ----------
				{ 移動的:01, d:M_R:共通ルート１ }\
				{ 移動的:02, d:M_R:共通ルート２ }\
			} \
			-exec { \
				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグＦ \
					-route $2 \
					-dir 0 2048 \
					-c ＶＲ標的破壊マシンガン３面処理 \
					-speed 15
			}

			command foreach -argc 4 -repeat 15 \
			-data { \
				// 的名,     ルート,    ルート変更ノード, スピード
				// act 2 ----------
				{ 移動的:06, d:M_R:ライデンルート６,   0,  75 }\
				{ 移動的:07, d:M_R:ライデンルート７,   0,  75 }\
				{ 移動的:08, d:M_R:ライデンルート８,   0,  75 }\
				// act 3 ----------
				{ 移動的:09, d:M_R:ライデンルート９,   5,  50 }\
				{ 移動的:10, d:M_R:ライデンルート１０, 5,  50 }\
				{ 移動的:11, d:M_R:ライデンルート１３, 5,  50 }\
				{ 移動的:12, d:M_R:ライデンルート１４, 5,  50 }\
				// act 4 ----------
				{ 移動的:13, d:M_R:ライデンルート１７, 1,  75 }\
				{ 移動的:14, d:M_R:ライデンルート１７, 1,  75 }\
				{ 移動的:15, d:M_R:ライデンルート１７, 1,  75 }\
				// act 5 ----------
				{ 移動的:16, d:M_R:ライデンルート２１, 0, 100 }\
				{ 移動的:17, d:M_R:ライデンルート２２, 0, 100 }\
				{ 移動的:18, d:M_R:ライデンルート２３, 0, 100 }\
				{ 移動的:19, d:M_R:ライデンルート２４, 0, 100 }\
				{ 移動的:20, d:M_R:ライデンルート２５, 0, 100 }\
			} \
			-exec { \
				if( $s:選択プレイヤー == タキシードスネーク ) {
					$$b:標的セット数 = $$b:標的セット数 + 1;
					if( $$b:標的セット数 % 2 ) {
						$$i:標的フラグ = ( $$i:標的フラグＤ | d:VR_TRG_HIDESTART );
					} else {
						$$i:標的フラグ = ( $$i:標的フラグＤ | d:VR_TRG_VISIBLESTART );
					}
				} else {
					$$i:標的フラグ = $$i:標的フラグＤ;
				}

				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグ \
					-route $2 \
					-c ＶＲ標的破壊マシンガン３面処理 \
					-x ＶＲルート分岐開始マシンガン３面処理 $2 $3 \
					-speed $4
			}

		// スネーク or プリスキンを選択
		} else if ( ($s:選択プレイヤー == スネーク) || ($s:選択プレイヤー == プリスキン) ) {

			command foreach -argc 2 -repeat 3 \
			-data { \
				// 的名,     ルート
				// act 1 ----------
				{ 移動的:01, d:M_R:共通ルート１ }\
				{ 移動的:02, d:M_R:共通ルート２ }\
				{ 移動的:03, d:M_R:共通ルート３ }\
			} \
			-exec { \
				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグＦ \
					-route $2 \
					-dir 0 2048 \
					-c ＶＲ標的破壊マシンガン３面処理 \
					-speed 15
			}

			command foreach -argc 4 -repeat 21 \
			-data { \
				// 的名,     ルート,    ルート変更ノード, スピード
				// act 2 ----------
				{ 移動的:06, d:M_R:スネークルート２７, 0,  75 }\
				{ 移動的:07, d:M_R:スネークルート２８, 0,  75 }\
				{ 移動的:08, d:M_R:スネークルート２９, 0,  75 }\
				// act 3 ----------
				{ 移動的:09, d:M_R:スネークルート３０, 0,  75 }\
				{ 移動的:10, d:M_R:スネークルート３１, 0,  75 }\
				{ 移動的:11, d:M_R:スネークルート３２, 0,  75 }\
				{ 移動的:12, d:M_R:スネークルート３３, 0,  75 }\
				{ 移動的:13, d:M_R:スネークルート３４, 0,  75 }\
				{ 移動的:14, d:M_R:スネークルート３５, 0,  75 }\
				// act 4 ----------
				{ 移動的:15, d:M_R:スネークルート９,   5,  50 }\
				{ 移動的:16, d:M_R:スネークルート１０, 5,  50 }\
				{ 移動的:17, d:M_R:スネークルート３６, 5,  50 }\
				{ 移動的:18, d:M_R:スネークルート１３, 5,  50 }\
				{ 移動的:19, d:M_R:スネークルート１４, 5,  50 }\
				{ 移動的:20, d:M_R:スネークルート３７, 5,  50 }\
				// act 5 ----------
				{ 移動的:21, d:M_R:スネークルート４４, 0, 100 }\
				{ 移動的:22, d:M_R:スネークルート４５, 0, 100 }\
				{ 移動的:23, d:M_R:スネークルート４６, 0, 100 }\
				{ 移動的:24, d:M_R:スネークルート４７, 0, 100 }\
				{ 移動的:25, d:M_R:スネークルート４８, 0, 100 }\
				{ 移動的:26, d:M_R:スネークルート４９, 0, 100 }\
			} \
			-exec { \
				if( $s:選択プレイヤー == プリスキン ) {
					$$b:標的セット数 = $$b:標的セット数 + 1;
					if( $$b:標的セット数 % 2 ) {
						$$i:標的フラグ = ( $$i:標的フラグＤ | d:VR_TRG_HIDESTART );
					} else {
						$$i:標的フラグ = ( $$i:標的フラグＤ | d:VR_TRG_VISIBLESTART );
					}
				} else {
					$$i:標的フラグ = $$i:標的フラグＤ;
				}

				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグ \
					-route $2 \
					-c ＶＲ標的破壊マシンガン３面処理 \
					-x ＶＲルート分岐開始マシンガン３面処理 $2 $3 \
					-speed $4
			}

		//	前作スネークを選択
		} else if ( $s:選択プレイヤー == 前作スネーク ) {

			// 現状ではスネークルートを流用
			command foreach -argc 2 -repeat 3 \
			-data { \
				// 的名,     ルート
				// act 1 ----------
				{ 移動的:01, d:M_R:共通ルート１ }\
				{ 移動的:02, d:M_R:共通ルート２ }\
				{ 移動的:03, d:M_R:共通ルート３ }\
			} \
			-exec { \
				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグＦ \
					-route $2 \
					-dir 0 2048 \
					-c ＶＲ標的破壊マシンガン３面処理 \
					-speed 15
			}

			command foreach -argc 4 -repeat 23 \
			-data { \
				// 的名,     ルート,    ルート変更ノード, スピード
				// act 2 ----------
				{ 移動的:06, d:M_R:前作スネークルート５１, 0,  75 }\
				{ 移動的:07, d:M_R:前作スネークルート５２, 0,  75 }\
				{ 移動的:08, d:M_R:前作スネークルート５３, 0,  75 }\
				{ 移動的:09, d:M_R:前作スネークルート５４, 0,  75 }\
				// act 3 ----------
				{ 移動的:10, d:M_R:前作スネークルート５５, 5,  75 }\
				{ 移動的:11, d:M_R:前作スネークルート５６, 5,  75 }\
				{ 移動的:12, d:M_R:前作スネークルート５７, 5,  75 }\
				{ 移動的:13, d:M_R:前作スネークルート５８, 5,  75 }\
				{ 移動的:14, d:M_R:前作スネークルート６３, 5,  75 }\
				{ 移動的:15, d:M_R:前作スネークルート６４, 5,  75 }\
				{ 移動的:16, d:M_R:前作スネークルート６５, 5,  75 }\
				{ 移動的:17, d:M_R:前作スネークルート６６, 5,  75 }\
				// act 4 ----------
				{ 移動的:18, d:M_R:前作スネークルート７１, 0, 100 }\
				{ 移動的:19, d:M_R:前作スネークルート７２, 0, 100 }\
				{ 移動的:20, d:M_R:前作スネークルート７３, 0, 100 }\
				{ 移動的:21, d:M_R:前作スネークルート７４, 0, 100 }\
				{ 移動的:22, d:M_R:前作スネークルート７５, 0, 100 }\
				{ 移動的:23, d:M_R:前作スネークルート７６, 0, 100 }\
				// act 5 ----------
				{ 移動的:24, d:M_R:前作スネークルート７７, 0, 125 }\
				{ 移動的:25, d:M_R:前作スネークルート７８, 0, 125 }\
				{ 移動的:26, d:M_R:前作スネークルート７９, 0, 125 }\
				{ 移動的:27, d:M_R:前作スネークルート８０, 0, 125 }\
				{ 移動的:28, d:M_R:前作スネークルート８１, 0, 125 }\
			} \
			-exec { \
				// 前作スネークは消え周期を逆にする
				$$b:標的セット数 = $$b:標的セット数 + 1;
				if( $$b:標的セット数 % 2 ) {
					$$i:標的フラグ = ( $$i:標的フラグＤ | d:VR_TRG_VISIBLESTART );
				} else {
					$$i:標的フラグ = ( $$i:標的フラグＤ | d:VR_TRG_HIDESTART );
				}

				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグ \
					-route $2 \
					-c ＶＲ標的破壊マシンガン３面処理 \
					-x ＶＲルート分岐開始マシンガン３面処理 $2 $3 \
					-speed $4
			}

		}

	}

	proc ＶＲ初期配置標的マシンガン３面設定 {
		// 共通標的 （主にライデン）
		mesg ＶＲ的共通 移動的:01 移動開始
		mesg ＶＲ的共通 移動的:02 移動開始

		mesg ＶＲ的共通 移動的:06 移動開始
		mesg ＶＲ的共通 移動的:07 移動開始
		mesg ＶＲ的共通 移動的:08 移動開始

		// 他キャラ選択時の追加標的s
		// スネーク or プリスキン
		if ( ($s:選択プレイヤー == スネーク) || ($s:選択プレイヤー == プリスキン) ) {
			mesg ＶＲ的共通 移動的:03 移動開始
		// 前作スネーク
		} else if ( $s:選択プレイヤー == 前作スネーク ) {
			mesg ＶＲ的共通 移動的:03 移動開始

			mesg ＶＲ的共通 移動的:09 移動開始
		}
	}


//###################################################################################
//									 ＢＧＭ
//###################################################################################

	// ------------------------------------
	// ＢＧＭの設定
	// ------------------------------------
	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT
			print 'bgm_set'
		#endif

		chara ＢＧＭマネージャー ＢＧＭマネ
	}



