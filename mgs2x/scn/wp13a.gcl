// ------------------------------------
// 的ルート番号
// ------------------------------------
enum M_R {
	//	マシンガン３面用
//	共通ルート０ = 0,	// 欠番
	共通ルート１ = 1,
	共通ルート２, 共通ルート３, 共通ルート４, 共通ルート５,

	ライデンルート６, ライデンルート７, ライデンルート８, ライデンルート９, ライデンルート１０,
	ライデンルート１１, ライデンルート１２, ライデンルート１３, ライデンルート１４, ライデンルート１５,
	ライデンルート１６, ライデンルート１７, ライデンルート１８, ライデンルート１９, ライデンルート２０,
	ライデンルート２１, ライデンルート２２, ライデンルート２３, ライデンルート２４, ライデンルート２５,
	ライデンルート２６,

	スネークルート２７, スネークルート２８, スネークルート２９, スネークルート３０, スネークルート３１,
	スネークルート３２, スネークルート３３, スネークルート３４, スネークルート３５, スネークルート３６,
	スネークルート３７, スネークルート３８, スネークルート３９, スネークルート４０, スネークルート４１,
	スネークルート４２, スネークルート４３, スネークルート４４, スネークルート４５, スネークルート４６,
	スネークルート４７, スネークルート４８, スネークルート４９,

	前作スネークルート５０, 前作スネークルート５１, 前作スネークルート５２, 前作スネークルート５３, 前作スネークルート５４,
	前作スネークルート５５, 前作スネークルート５６, 前作スネークルート５７, 前作スネークルート５８, 前作スネークルート５９,
	前作スネークルート６０, 前作スネークルート６１, 前作スネークルート６２, 前作スネークルート６３, 前作スネークルート６４,
	前作スネークルート６５, 前作スネークルート６６, 前作スネークルート６７, 前作スネークルート６８, 前作スネークルート６９,
	前作スネークルート７０, 前作スネークルート７１, 前作スネークルート７２, 前作スネークルート７３, 前作スネークルート７４,
	前作スネークルート７５, 前作スネークルート７６, 前作スネークルート７７, 前作スネークルート７８, 前作スネークルート７９,
	前作スネークルート８０, 前作スネークルート８１, 前作スネークルート８２,

	/* 共用ルート */
	スネークルート９ = 9,
	スネークルート１０ = 10,
	スネークルート１３ = 13,
	スネークルート１４ = 14,
}


