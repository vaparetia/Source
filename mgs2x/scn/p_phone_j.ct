proc rp_phone_消火:07 {
	talk メール 標準 -m {
		[PHONE_消火:000]
		//燃えている炎は
		//冷却スプレーを
		//吹きかければ消す
		//ことが出来る。
	}
}


proc rp_phone_フナムシ:07 {
	talk メール 標準 -m {
		[PHONE_フナムシ:000]
		//フナムシは冷却
		//スプレーを吹き
		//かければ追い払う
		//ことが出来る。
	}
}

proc rp_phone_地雷:07 {
	talk メール 標準 -m {
		[PHONE_地雷:000]
		//気をつけろ！
		//そこにはクレイ
		//モア地雷がセット
		//されている。
	}
}

proc rp_phone_リモコン近道:07 {
	talk メール 標準 -m {
		[PHONE_リモコン近道:000]
		//南西の暗い小部屋
		//からリモコン
		//ミサイルを飛ばし
		//てみろ。
	}
	talk メール 標準 -m {
		[PHONE_リモコン近道:001]
		//配電盤を楽に
		//壊せるはずだ。
	}
}



