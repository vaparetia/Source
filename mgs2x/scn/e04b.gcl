// include
// ------------------------------------
#include "5sec_bfr_demo.h"
#include "demo_vardef.h"
#include "demo_stdch.h"
#include "w04.h"

#define SCREENSHOT 0
#define STAGE_LT2	w04b

// マップ設定
// ------------------------------------
chara マップ 船倉２ -k w04b1 0 0 0 -h d00a3 -l w04b

command マップ設定 船倉２ -set {

#if d:MGS2_DEMO
chara デモアクトデバッグ demodebug  -i t:p036_01_p01 -d 'p036_01_p01' -l   \
			-p	右プロジェクタオフ 左プロジェクタオフ \
				右プロジェクタオン 左プロジェクタオン \
				スネーク影出し

#else

	chara demo デモ再生 \
		-i t:p036_01_p01 \
		-p 右プロジェクタオフ 左プロジェクタオフ \
		   右プロジェクタオン 左プロジェクタオン \
		   スネーク影出し \
		-next null

#endif

			@エフェクト設定

			@ドア設置／通路２−船倉３
			@ハッチセット

			@船倉２箱設置
			@通路他セット

//			@第一第二船倉キャラクタ専用ライトセット		//w04.hにある

			@第二船倉のプロジェクタセット

			@シネマスクリーンセット

			@リアル影セット
}

//初期マップの表示
command マップ表示 	-add 船倉２



//###################################################################################
//									エフェクト設定
//###################################################################################
	
	// エフェクト設定
	// ------------------------------------
	proc エフェクト設定 {
		#if d:SCREENSHOT
			chara スクリーンショット scrshot
		#endif

		chara フォグ fog \
			 -c 0 10 15 \
			 -n -5000 \
			 -f 50000

		chara シネマスクリーン シネマ \
			-top d:CINEMA_BELT_UPPER \
			-bottom d:CINEMA_BELT_LOWER \
			-ftime 30

	}




//###################################################################################
//									プロジェクタ設定
//###################################################################################

	//プロジェクタ光設定
	// ------------------------------------
// 第二船倉のプロジェクタセット
// ------------------------------------
proc 第二船倉のプロジェクタセット {
	chara プロジェクタライト プロジェクタライト右 \
		-p 630,-15600,(-1300+28500) \
		-d 4000,-10000,(-22000+28500)
	chara プロジェクタライト プロジェクタライト左 \
		-p -630,-15600,(-1300+28500) \
		-d -4000,-10000,(-22000+28500)
//	mesg プロジェクタライト プロジェクタライト右 オフ
//	mesg プロジェクタライト プロジェクタライト左 オフ
}
proc 右プロジェクタオフ {
	mesg プロジェクタライト プロジェクタライト右 オフ
}
proc 左プロジェクタオフ {
	mesg プロジェクタライト プロジェクタライト左 オフ
}
proc 右プロジェクタオン {
	mesg プロジェクタライト プロジェクタライト右 オン
}
proc 左プロジェクタオン {
	mesg プロジェクタライト プロジェクタライト左 オン
}



//###################################################################################
//									船倉２箱設置
//###################################################################################

proc 船倉２箱設置{

//左舷中盤
	chara プットオブジェ 鉄箱１ -m w04_box3 -r 0 0 0 \
		-p -8500 -17000 -9750 -l w04b

	chara プットオブジェ 鉄箱１ -m w04_box3 -r 0 (4096-125) 0 \
		-p -8500 -16000 -9750 -l w04b

	chara プットオブジェ スピーカーボックス -m w04_box -r 0 1024 0 \
		-s 100,120,100 \
		-p -9500 -17000 -15500 -l w04b

	chara プットオブジェ スピーカー -m w04_box2 -r 0 2048 0 \
		-p -5000 -17000 -3000 -l w04b

	chara プットオブジェ スピーカー -m w04_box2 -r 0 2048 0 \
		-p 3000 -17000 -3000 -l w04b

//リモコン
	chara プットオブジェ プロジェクタリモコン -m remocon -r 0 100 0 \
		-s 200,300,200 \
		-p -800 -16000 -400 -l w04b

	chara プットオブジェ プロジェクタリモコン -m remocon -r 0 0 0 \
		-s 200,300,200 \
		-p 800 -16000 -500 -l w04b
}

// 通路他セット
proc 通路他セット {
	chara プットオブジェ w04b2_set -m w04b2 -r 0 0 0 \
		-s 100,100,100 \
		-p 0 0 0 -l w04b

	chara プットオブジェ w04b3_set -m w04b3 -r 0 0 0 \
		-s 100,100,100 \
		-p 0 0 0 -l w04b
}

//###################################################################################
//									ドア設定
//###################################################################################

	// ドアオブジェクト
	// ------------------------------------
proc ドア設置／通路２−船倉３ {
// 第三船倉にあるドア
	chara プットオブジェ 右舷ドア２３ \
		-m w04_dr \
		-r 0,2048,0 \
		-p 8750,-17000,50 \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0010

	chara プットオブジェ 右舷ドア２３奥 \
		-m w04_dr \
		-r 0,0,0 \
		-p 7250,-17000,4450 \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0010

	chara プットオブジェ 左舷ドア２３ \
		-m w04_dr \
		-r 0,2048,0 \
		-p -7250,-17000,50 \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0010

	chara プットオブジェ 左舷ドア２３奥 \
		-m w04_dr \
		-r 0,0,0 \
		-p -8750,-17000,4450 \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0010

	chara プットオブジェ 右舷上部ドア２３ \
		-m w04_dr \
		-r 0,2048,0 \
		-p 11750,-9000,50 \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0010

	chara プットオブジェ 右舷上部ドア２３奥 \
		-m w04_dr \
		-r 0,0,0 \
		-p 10250,-9000,4450 \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0010

	chara プットオブジェ 左舷上部ドア２３ \
		-m w04_dr \
		-r 0,2048,0 \
		-p -10250,-9000,50 \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0010

	chara プットオブジェ 左舷上部ドア２３奥 \
		-m w04_dr \
		-r 0,0,0 \
		-p -11750,-9000,4450 \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0010

// 第二船倉右手前（第一船倉側）
	chara プットオブジェ 右舷ドア１２ \
		-m w04_dr \
		-r 0,2048,0 \
		-p 8750,-17000,(50+28500) \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0020

	chara プットオブジェ 右舷上部ドア１２ \
		-m w04_dr \
		-r 0,2048,0 \
		-p 11750,-9000,(50+28500) \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0020
}

// ハッチセット
proc ハッチセット {
	chara プットオブジェ 左側ハッチ \
		-m hatch \
		-r 0,0,0 \
		-p -11500,-17000,-3000 \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0020

	chara プットオブジェ 右側ハッチ \
		-m hatch \
		-r 0,2048,0 \
		-p 11500,-17000,-3000 \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0020
}

// シネマスクリーン
proc シネマスクリーンセット {
	chara シネマスクリーン きねま \
		-top d:CINEMA_BELT_UPPER \
		-bottom d:CINEMA_BELT_LOWER \
		-ftime 60	//デフォルト値（ゼロは駄目）
	mesg シネマスクリーン シネマ フェードアウト 1
}

proc リアル影セット {
	chara 影投影モデル E3忍者ステージ床モデル \
		-model w04b1_k4 \
		-pos 0 0 0

	chara 影管理 E3忍者ステージ床 \
		-type 0 \
		-length 6000

//	chara delay 前 -time 1 -exec {
//		mesg 影管理 E3忍者ステージ床 add sna_def_mh_demo E3忍者ステージ床モデル
//		mesg 影管理 E3忍者ステージ床 add sel_def_02 E3忍者ステージ床モデル
//	}
}

proc スネーク影出し {
		mesg 影管理 E3忍者ステージ床 add sna_def_mh_demo E3忍者ステージ床モデル
}

proc null {}
