proc rp_phone_消火:02  {
	talk メール 標準 -m {
		[PHONE_消火__f:000]
		//燃えている炎は
		//冷却スプレーを
		//吹きかければ消す
		//ことが出来る。
	}
	talk メール 標準 -m {
		[PHONE_消火__f:001]
		//燃えている炎は
		//冷却スプレーを
		//吹きかければ消す
		//ことが出来る。
	}
}


proc rp_phone_フナムシ:02  {
	talk メール 標準 -m {
		[PHONE_フナムシ__f:000]
		//フナムシは冷却
		//スプレーを吹き
		//かければ追い払う
		//ことが出来る。
	}
	talk メール 標準 -m {
		[PHONE_フナムシ__f:001]
		//フナムシは冷却
		//スプレーを吹き
		//かければ追い払う
		//ことが出来る。
	}
}

proc rp_phone_地雷:02  {
	talk メール 標準 -m {
		[PHONE_地雷__f:000]
		//気をつけろ！
		//そこにはクレイ
		//モア地雷がセット
		//されている。
	}
	talk メール 標準 -m {
		[PHONE_地雷__f:001]
		//気をつけろ！
		//そこにはクレイ
		//モア地雷がセット
		//されている。
	}
}

proc rp_phone_リモコン近道:02  {
	talk メール 標準 -m {
		[PHONE_リモコン近道__f:000]
		//南西の暗い小部屋
		//からリモコン
		//ミサイルを飛ばし
		//てみろ。
	}
	talk メール 標準 -m {
		[PHONE_リモコン近道__f:001]
		//配電盤を楽に
		//壊せるはずだ。
	}
	talk メール 標準 -m {
		[PHONE_リモコン近道__f:002]
		//配電盤を楽に
		//壊せるはずだ。
	}
	talk メール 標準 -m {
		[PHONE_リモコン近道__f:003]
		//配電盤を楽に
		//壊せるはずだ。
	}
}



