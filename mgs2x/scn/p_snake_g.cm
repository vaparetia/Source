//dv}//v
}//d
//依頼後 弱いスネーク ＨＡＲＤ等 h //e
resource PS_エマ狙撃＿依頼後＿弱い__g {
//vox t:vc210991 {
プリスキン_000: {
Ich schie&~se zun&~achst von Strebe E aus,
}
//	<<<ENGLISH>>>
//	I'll start sniping
//	from Strut E,
//<ページ数変更>
プリスキン_000_1: {
aber ich treffe nicht jedesmal, und wenn
ich nachlade, entsteht eine Feuerpause.
}
//	<<<ENGLISH>>>
//	but I'm not always going to
//	hit the target, and there'll
//	be a pause during reloads.
//<ページ数変更>
プリスキン_000_2: {
Du mu&~st also auch fortlaufend schie&~sen.
}
//	<<<ENGLISH>>>
//	You're going to have
//	to keep shooting too.

/*俺もこのＥ脚から狙撃する。だが撃ち
