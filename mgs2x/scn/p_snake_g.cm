resource PS_ＤＧ連絡橋＿ＰＳＧ１使え__g {
//vox t:vc210481 {
プリスキン_000: {
Versuch nicht, sehr weit entfernte
Steuerger&~ate mit der Handfeuerwaffe
zu zerst&~oren,
}
//	<<<ENGLISH>>>
//	Don't try to shoot out control
//	units with the handgun when
//	the distance is too great.
//<ページ数変更>
プリスキン_000_1: {
da sie nicht weit genug schie&~st.
Nimm das Scharfsch&~utzengewehr.
}
//	<<<ENGLISH>>>
//	The weapon doesn't have that
//	kind of range. Use the sniper
//	rifle.

/*遠くにある制御装置をハンドガンで
