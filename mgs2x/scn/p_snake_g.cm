//vox t:vc210671 {
プリスキン_000: {
Raiden, wo zielst Du denn hin!?
}
//	<<<ENGLISH>>>
//	Raiden! Where do you
//	think you're aiming!?

/*ライデン！
どこを狙ってるんだ！？*/
//dv}//v
}//d
//ライデンに撃たれた２ h //e
