//ＤＧ連絡橋以外 h //e
resource PS_ＤＧ連絡橋以外__g {
//vox t:vc210511 {
プリスキン_000: {
Um zu Shell 2 zu gelangen, mu&~st Du die
IR-Sensoren auf der Verbindungsbr&~ucke
}
//	<<<ENGLISH>>>
//	In order to get to Shell 2, you'll
//	have to disable the IR sensors
//	on the connecting bridge＃−
//<ページ数変更>
プリスキン_000_1: {
zwischen Shell 1 und 2 deaktivieren.
}
//	<<<ENGLISH>>>
//	between Shells 1 and 2.

/*シェル２に渡るにはシェル１シェル２
