//★P012_02_R01フォーチュン遭遇２無線デモ１終了＜フラグ＜P014_01_P01ピーター遭遇１ポリゴンデモ１開始 d //e
//寝ている間に通信した場合 h //e
resource PS_寝ている間に通信した__g {
//vox t:vc210241 {
ライデン_000: {
Guten Morgen, Leutnant J. G. Pliskin.
Gut geschlafen?
}
//	<<<ENGLISH>>>
//	Good morning, Lieutenant J.G.
//	Pliskin. Did you sleep well?

/*おはよう、プリスキン中尉。
良いお目覚めで。*/
プリスキン_001: {
Ja, danke.
Ich f&~uhle mich gut, viel besser.
}
//	<<<ENGLISH>>>
//	Yeah, thank you. I'm good,
//	feeling much better.

/*ああ……。ありがとう。
体調も戻った。
もう大丈夫だ。*/
//dv}//v
}//d



//フォーチュンの設定 h //e
resource PS_フォーチュン＿死なない__g {
//vox t:vc210251 {
ライデン_000: {
Warum stirbt sie denn nicht?
}
//	<<<ENGLISH>>>
//	Why won't that woman die?

/*あの女、なぜ死なない？*/
プリスキン_001: {
Sie sehnt den Tod herbei. Er k&~ame f&~ur sie
sehr gelegen, wenn er sie endlich erl&~osen
w&~urde.
}
//	<<<ENGLISH(2)>>>
//	She yearns for death. She would
//	welcome it with open arms if it
//	came to set her free.

/*あの女は死を歓迎している。
死が自分を開放しにくる時を
待ち望んでいるんだ。*/
プリスキン_002: {
Wer den Tod nicht f&~urchtet, entgeht ihm.
}
//	<<<ENGLISH>>>
//	People who have no fear of
//	death end up eluding it.
//<ページ数変更>
プリスキン_002_1: {
Je mehr Angst Du vor dem Sterben hast,
desto n&~aher kommst Du dem Tod.
}
//	<<<ENGLISH>>>
//	And the more terrified you are of
//	dying, the closer you find yourself
//	to it.

/*死への恐怖がない人間程、生へ近づく。
死を恐れれば、それだけ死に近づく。
*/
//dv}//v
}//d


//眠りプリスキンを殴っている場合 h //e
resource PS_睡眠中殴られた１__g {
//vox t:vc210261 {
プリスキン_000: {
Als ich gerade geschlafen habe --
hast Du --
}
//	<<<ENGLISH>>>
//	While I was sleeping just
//	now -- Did you --

/*お前……さっき俺が休んでる間……。*/
ライデン_001: {
&~Ah --!?
}
//	<<<ENGLISH>>>
//	Uh -- !?

/*え！？*/
プリスキン_002: {
Hmph. Vergi&~s es.
}
//	<<<ENGLISH>>>
//	Hmph. Forget it.

/*ふん。まあいい。*/
ライデン_003: {
Puh.
}
//	<<<ENGLISH>>>
//	Whew...


/*……。（ほっ）*/
//dv}//v
}//d


//★P014_16_G01ピーター遭遇１６ゲーム１終了＜フラグ＜P015_01_R1爆弾解体最初の一つ１無線デモ１開始 d //e
//爆弾解体ヒント１ h //e
resource PS_爆弾解体中＿敵排除のススメ１＿１__g {
//vox t:vc210271 {
プリスキン_000: {
Raiden, keine Panik. Es ist sicherer,
wenn Du erst den Gegner eliminierst
und dann die Bombe suchst.
}
//	<<<ENGLISH>>>
//	Raiden, don't get yourself worked
//	up. It's safer to take out the enemy
//	first, then look for the bomb.

/*ライデン、焦るんじゃないぞ。
先に敵を倒してそれから爆弾を
探す方が安全だ。*/
//dv}//v
}//d

resource PS_爆弾解体中＿敵排除のススメ１＿２__g {
//vox t:vc210281 {
プリスキン_000: {
Es bringt doch nichts, die Bombe zu
suchen und gleichzeitig &~uber die Schulter
nach dem Feind zu schauen.
}
//	<<<ENGLISH>>>
//	Don't even think about searching
//	for the bomb while looking over
//	your shoulder for the enemy.

/*敵を警戒しながら、爆弾を探す
なんてことは考えない方がいい。*/
プリスキン_001: {
Als erstes solltest Du sie kurzfristig
oder dauerhaft ausschalten.
}
//	<<<ENGLISH>>>
//	Knock them unconscious or
//	take them out altogether first.

/*敵を眠らせるなり、倒すなりして、
排除しておくんだ。*/
//dv}//v
}//d

//爆弾解体ヒント２ h //e
resource PS_爆弾解体中＿敵排除のススメ２__g {
//vox t:vc210291 {
プリスキン_000: {
Es scheint, als seien die
Verteidigungsz&~aune aller Streben
durch Wachposten abgedeckt.
}
//	<<<ENGLISH>>>
//	Looks like enemy sentries have the defensive perimeters of each strut covered.

/*敵の見張りは各脚の守備範囲を
受け持っているようだ。*/
プリスキン_001: {
Du bist sicher, solange sie &~uber Funk keine
Verst&~arkung anfordern, aber wenn sie Dich
entdecken, lauf!
}
//	<<<ENGLISH>>>
//	You'll be safe as long as they
//	don't radio for more men, but
//	if you're spotted, run for it.
//<ページ数変更>
プリスキン_001_1: {
Versteck Dich gut und warte,
bis die Verst&~arkung abzieht.
}
//	<<<ENGLISH>>>
//	Find a good concealment and
//	wait until the backup leaves.

/*無線連絡されない限り安全だが、
発見されたらすぐに逃げろ。どこかに
身を潜めて、増援部隊をやり過ごすんだ。
*/
プリスキン_002: {
Solange Du gejagt wirst, kannst Du keine
Bomben entsch&~arfen, glaube mir.
}
//	<<<ENGLISH>>>
//	You won't be able to defuse the
//	bombs while you're being chased
//	down, believe me.

/*敵に追われながら爆弾を処理するなんて
お前には無理な話だろう。*/
//dv}//v
}//d


//爆弾解体催促 h //e
resource PS_爆弾解体中＿催促１__g {
//vox t:vc210301 {
プリスキン_000: {
Ich hab die erste Bombe eingefroren.
Wie steht es bei Dir?
}
//	<<<ENGLISH>>>
//	Raiden, I've frozen the first
//	bomb. How are you doing?

/*ライデン、１つ目の爆弾を凍結した！
そっちは？*/
ライデン_001: {
Noch nichts.
}
//	<<<ENGLISH>>>
//	Nothing yet...

/*まだだ……。*/
ピーター_002: {
Pliskin, wo genau befand sich der
Sprengstoff?
}
//	<<<ENGLISH>>>
//	Pliskin, what was the exact
//	location of the explosive?

/*プリスキン、爆弾の設置されていた
状況を教えてくれ。*/
プリスキン_003: {
Auf dem Heliport. Er war
hinter Frachtst&~ucken
versteckt.
}
//	<<<ENGLISH(2)>>>
//	The heliport on Strut H.
//	It was behind some cargo.
//<ページ数変更>
プリスキン_003_1: {
Ich hatte Probleme mit den Patrouillen
erwartet, aber es war ganz einfach.
}
//	<<<ENGLISH>>>
/*Thought I was going to have
some trouble with the patrols,
but it was an easy job.
Ｈ脚のヘリポート。荷物の影に
仕掛けられていた。
見張りが厄介だったが、楽勝だった。
*/
ピーター_004: {
Verstehe.
}
//	<<<ENGLISH>>>
//	I see (something is wrong)...

/*そうか……。（なにかおかしい）*/
プリスキン_005: {
Was ist los?
}
//	<<<ENGLISH(2)>>>
//	What's the matter?

/*どうかしたのか？*/
ピーター_006: {
Eigentlich nichts. Pliskin, bleib wachsam,
}
//	<<<ENGLISH>>>
//	Nothing, really. Pliskin, just
//	don't let your guard down.
//<ページ数変更>
ピーター_006_1: {
auch wenn Du glaubst, da&~s die Bombe
entsch&~arft ist.
}
//	<<<ENGLISH>>>
//	Don't relax even after you
//	think you've defused it.

/*
いや。なんでもない。
プリスキン、気を抜くなよ。
解体後の安心感は禁物だ。
*/
プリスキン_007: {
Ich wei&~s. Raiden, Shell 1 geh&~ort ganz Dir.
}
//	<<<ENGLISH>>>
//	I know that. Raiden,
//	Shell 1's all yours.

/*わかってる。
ライデン、シェル１を頼むぞ。*/
ライデン_008: {
Klar.
}
//	<<<ENGLISH>>>
//	Sure...

/*ああ……。*/
//dv}//v
}//d


//爆弾解体の状況報告１ h //e
resource PS_爆弾解体報告１__g {
