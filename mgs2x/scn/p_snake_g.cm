}//d

//爆弾ヒント天井 h //e
resource PS_爆弾ヒント＿天井__g {
//vox t:vc210351 {
プリスキン_000: {
Eine Bombe war ziemlich hoch oben
versteckt, an der Decke.
}
//	<<<ENGLISH>>>
//	There was one planted pretty
//	high up, on the ceiling.
//<ページ数変更>
プリスキン_000_1: {
Das K&~uhlspray spr&~uhte nicht so weit,
also mu&~ste ich erst auf einen St&~ander
klettern.
}
//	<<<ENGLISH>>>
//	The coolant spray couldn't
//	reach that far, so I had to
//	get up on a stand and do it.

/*天井の高いところに仕掛けられていた。
冷却スプレーが届かなくてな。台の上に
乗って冷却した。
*/
//dv}//v
}//d

//爆弾ヒント背中 h //e
resource PS_爆弾ヒント＿敵の背中__g {
//vox t:vc210361 {
プリスキン_000: {
Aus irgendeinem Grund war eine Bombe
auf dem R&~ucken eines Soldaten befestigt.
}
//	<<<ENGLISH>>>
//	For some reason, there was one
//	planted on an enemy soldier's
//	back...

/*なぜかはわからんが、敵の背中に
ついていた……。*/
//dv}//v
}//d
//爆弾ヒントホフク h //e
resource PS_爆弾ヒント＿ホフク__g {
//vox t:vc210371 {
プリスキン_000: {
Die hier war an einer so schmalen Stelle,
da&~s ich nur kriechend hinkam.
}
//	<<<ENGLISH>>>
//	This one was in a spot so narrow
//	I had to crawl in to get at it.

/*ホフクしなければ入れない狭いところに
仕掛けてあった。*/
//dv}//v
}//d
//爆弾ヒント主観 h //e
resource PS_爆弾ヒント＿主観__g {
