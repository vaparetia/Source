//dv}//v
}//d
//二回目以降 t //e
resource PS_サイファー２__g {
//vox t:vc211841 {
プリスキン_000: {
Cypher-Sensoren sind D&~uppeln
sehr &~ahnlich.
}
//	<<<ENGLISH>>>
//	You can confuse the Cypher's
//	sensors with chaff.
//<ページ数変更>
プリスキン_000_1: {
Dies blockiert nicht nur die
Sensorbewegung, sondern verhindert auch
die Daten&~ubertragung an das Steuerger&~at.
}
//	<<<ENGLISH>>>
//	This not only blocks its movement,
//	but also prevents data transmission
//	to its controller.

/*チャフを使えばサイファーのセンサーを
