プリスキン_000_1: {
ein UFO-&~ahnliches unbemanntes
Flugger&~at zur &~Uberwachung und
Kommunikationsunterst&~utzung von
}
//	<<<ENGLISH>>>
//	It's a saucer-type UAV for
//	surveillance and communication
//	support of＃−
//<ページ数変更>
プリスキン_000_2: {
Operationen zu Lande und zur See.
}
//	<<<ENGLISH>>>
//	land and marine operations.

/*そこに飛んでいるのはサイファー。
陸上／海上監視・通信支援用の円盤型
