*/
//dv}//v
}//d
//一回目のみ t //e
resource PS_シェル２中央棟＿水中機雷２__g {
//vox t:vc210121 {
ライデン_000: {
Warum sollte hier eine Mine liegen?
}
//	<<<ENGLISH>>>
//	Why would there be a mine here?

/*なぜこんなところに水中機雷があるんだ？*/
プリスキン_001: {
Weil jemand eine gelegt hat.
}
//	<<<ENGLISH>>>
//	Because someone planted one.

/*誰かが仕掛けたからだろう。*/
オタコン_002: {
Was ist mit dem Typ, der &~uber das Wasser
lief? Er k&~onnte es gewesen sein.
}
//	<<<ENGLISH>>>
//	What about that guy who was
//	running on water? Could have
//	been him.

/*あいつじゃないか？
水面を走っていた男……。*/
プリスキン_003: {
Achte auf Deine R&~uckendeckung.
Vielleicht lauert er Dir auf.
}
//	<<<ENGLISH>>>
//	You'd better watch your back.
//	He may be waiting to ambush.

/*気をつけたほうがいいな。
待ち伏せしているかもしれん。*/
ライデン_004: {
OK.
}
//	<<<ENGLISH(2)>>>
//	OK...

/*……ああ……。*/
//dv}//v
}//d
