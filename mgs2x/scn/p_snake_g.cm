//	Don't worry.

/*親父さんの面倒はちゃんとみる。
心配するな。*/
//dv}//v
}//d
//センサーＢ取りに行け h //e
resource PS_センサーＢ__g {
//vox t:vc210451 {
プリスキン_000: {
Raiden, geh' und hol den Sensor f&~ur
