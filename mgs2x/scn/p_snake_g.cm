*/
//dv}//v
}//d

//防弾装備にグレネード h //e
resource PS_防弾装備にグレネード__g {
//vox t:vc211661 {
プリスキン_000: {
Schu&~ssichere Ausr&~ustung sch&~utzt Deine
Feinde nicht vor einer Granatenexplosion
oder einem Schrapnell.
}
//	<<<ENGLISH>>>
//	Bulletproof equipment will not
//	protect your enemies from a
//	grenade's blast or shrapnel.

/*防弾装備を身につけた相手も
グレネードの爆風と破片までは
防げない。
*/
プリスキン_001: {
Eine gut plazierte Granate k&~onnte das
Gefecht zu Deinen Gunsten entscheiden.
}
//	<<<ENGLISH>>>
//	A well-placed grenade could
//	turn the tide of battle to your
//	advantage.

/*グレネードを使えば戦闘を有利に
進められるはずだ。
*/
//dv}//v
}//d

//ニキータスピードアップ h //e
resource PS_ニキータスピードアップ__g {
//vox t:vc211671 {
プリスキン_000: {
Je weniger Du eine ferngesteuerte Rakete
modifizierst, desto schneller fliegt sie.
}
//	<<<ENGLISH>>>
//	The less you manipulate a
//	remote-controlled missile,
//	the faster it'll travel.

/*リモコンミサイルは操作しなければ
飛行速度が上がる。*/
プリスキン_001: {
Nutz dieses Wissen, um Deine
ferngesteuerte Rakete &~uber eine
gr&~o&~sere Entfernung zu schicken.
}
//	<<<ENGLISH>>>
//	Use this and you'll be able to
//	deliver your remote-controlled
//	missile over a greater distance.

/*これを使えばリモコンミサイルをより
遠くまで飛ばすことが出来るはずだ。
*/
プリスキン_002: {
Denke daran, da&~s die Reichweite der
Rakete durch ihren Treibstoffvorrat
begrenzt ist.
}
//	<<<ENGLISH>>>
//	Remember that the missile's range
//	is limited by its fuel capacity.
//<ページ数変更>
プリスキン_002_1: {
Vergi&~s nie, da&~s Dich unn&~otige Man&~over
Treibstoff kosten k&~onnen.
}
//	<<<ENGLISH>>>
//	Always remember that unnecessary
//	maneuvers can cost you fuel.

/*ミサイルの塔載燃料には限りがある
からな。無駄な操作はさけるんだ。
*/
//dv}//v
}//d

//しゃがめば見つからない場所 h //e
resource PS_しゃがみ遮蔽物__g {
//vox t:vc211681 {
プリスキン_000: {
Kauer Dich nieder, um Dich hinter
bestimmten Objekten zu verstecken.
}
//	<<<ENGLISH>>>
//	You can hide behind certain
//	objects by crouching low.
//<ページ数変更>
プリスキン_000_1: {
So hast Du Deckung vor
feindlichem Feuer.
}
//	<<<ENGLISH>>>
//	It's a move that provides
//	cover from enemy fire＃−
//<ページ数変更>
プリスキン_000_2: {
kannst auch im Schulterblick sehen
oder hervorspringen u. schie&~sen.
}
//	<<<ENGLISH>>>
//	and also allows you to see
//	in Corner View or to do a
//	Jump-out shot.

/*背の低い遮蔽物にはしゃがめば
隠れられるものもある。そこから
ビハインドや飛び出し撃ちも可能だ。
*/
プリスキン_001: {
Nutz die Objekte um Dich herum gut,
dann &~uberlebst Du auch.
}
//	<<<ENGLISH>>>
//	Your survival depends on how
//	you use the objects around you.

/*まわりのものを全て利用しろ。
それが生き残る秘訣だ。
*/

//dv}//v
}//d
//タクティカルリロード h //e
resource PS_タクティカルリロード__g {
//vox t:vc211691 {
プリスキン_000: {
Es k&~onnte peinlich sein,
wenn Dir mitten im Feuergefecht
die Munition ausgeht.
}
//	<<<ENGLISH>>>
//	Running out of ammunition in
//	the middle of a fire fight can
//	be embarrassing.
//<ページ数変更>
プリスキン_000_1: {
Darum solltest Du die taktische
Nachladefunktion benutzen.
}
//	<<<ENGLISH>>>
//	That's why you want to use
//	the Tactical Reload feature.

/*銃撃戦で敵の目の前に飛び出した途端に
弾切れを起こしたら洒落にならんぞ。
タクティカル・リロードを使うんだ。
*/
プリスキン_001: {
Wenn Du eine Waffe aus der
Schu&~sbereitschaft nimmst,
}
//	<<<ENGLISH>>>
//	Once you remove a weapon
//	from its equip status,
//<ページ数変更>
プリスキン_001_1: {
wird sie automatisch vollst&~andig
nachgeladen.
}
//	<<<ENGLISH>>>
//	it will be fully reloaded
//	automatically.
//<ページ数変更>
プリスキン_001_2: {
Mit der R2-Taste kannst Du Ausr&~ustung
schnell und einfach wechseln.
}
//	<<<ENGLISH>>>
//	You can easily do this by using
//	the R2 button to change equipment
//	quickly.

/*銃を一度装備から外すとマガジンの最大
数まで装弾する。Ｒ２ボタンのクイック
チェンジを使えば楽に出来るはずだ。
*/
//dv}//v
}//d



//Ｃ脚 d //e
//女子便所 h //e
resource PS_Ｃ脚女子トイレ__g {
//vox t:vc211701 {
プリスキン_000: {
Raiden, wo bist Du?
}
//	<<<ENGLISH(2)>>>
//	Raiden... where are you?

/*ライデン……お前、どこにいるんだ？*/
ライデン_001: {
Ich, &~ah, ich.
}
//	<<<ENGLISH>>>
//	I... um... I...


/*いや、これは……。*/
プリスキン_002: {
Was ist Dir denn so peinlich?
}
//	<<<ENGLISH>>>
//	What're you embarrassed about?

プリスキン_002_1: {
Du bist im Einsatz, da ist alles m&~oglich!
}
//	<<<ENGLISH>>>
//	You're on a mission...
//	anything goes!

/*なに、恥じることはない。
任務達成にはあらゆる手段を尽くす
必要がある。
*/
ライデン_003: {
Pliskin.
}
//	<<<ENGLISH(2)>>>
//	Pliskin...

/*プリスキン……。*/
プリスキン_004: {
Ich habe mich schon an &~ahnlichen
Pl&~atzen versteckt.
}
//	<<<ENGLISH>>>
//	I've snuck into similar places
//	in the past myself...

/*俺も昔はよく入ったもんだ……。*/
ライデン_005: {
Was?
}
//	<<<ENGLISH>>>
//	Huh...?


/*……え？*/
//dv}//v
}//d



//シェル２中央棟 d //e
resource PS_シェル２中央棟＿濾過装置うんちく１__g {
//vox t:vc211711 {
プリスキン_000: {
Sei vorsichtig, Raiden.
}
//	<<<ENGLISH>>>
//	Be careful, Raiden.

プリスキン_000_1: {
Wenn Du in den Reaktionstank f&~allst,
bist Du ein toter Mann.
}
//	<<<ENGLISH>>>
//	You're a dead man if you fall
//	into the Life Reaction Tank.

/*ライデン、気を付けろ。
生物反応槽に落ちれば命はないぞ。*/
//dv}//v
}//d
resource PS_シェル２中央棟＿濾過装置うんちく２__g {
//vox t:vc211721 {
オタコン_000: {
Genau. Der Reaktionstank reinigt
verschmutztes Wasser mit Hilfe
von Mikroorganismen.
}
//	<<<ENGLISH>>>
//	That's right. The Life Reaction
//	Tank cleanses polluted water
//	with microorganisms.

/*ああ。生物反応槽では微生物を使った
汚水処理を行っているんだ。*/
オタコン_001: {
Diese Organismen werden aktiviert,
indem gro&~se Mengen Sauerstoff hindurch
gepumpt werden.
}
//	<<<ENGLISH>>>
//	These organisms are activated by
//	pumping them with large volumes
//	of oxygen.

/*その微生物の活性を保つために常に
大量の酸素が注入されている。*/
オタコン_002: {
Die spezifische Dichte des Wassers ist
daher sehr gering, man hat also keinen
Auftrieb.
}
//	<<<ENGLISH>>>
//	As a result, the water's specific
//	gravity is extremely light, making
//	it impossible to remain afloat.

/*だから水の比重がとても軽くなって
いるんだ。人間が浮かぶことは出来ない。
沈んでしまうんだ。*/
オタコン_003: {
Wenn Du reinf&~allst,
kommst Du nicht mehr hoch.
}
//	<<<ENGLISH>>>
//	Once you fall in, you'll
//	never come up.

/*落ちたら溺れるしかないだろうだろう。
絶対に落ちるんじゃないよ、いいね。
*/
//dv}//v
}//d


//ストーリー依存 d //e
//ヴァンプの事 h //e
resource PS_ヴァンプ１__g {
//vox t:vc211731 {
プリスキン_000: {
Vamp geh&~ort zu Dead Cell.
}
//	<<<ENGLISH>>>
//	Vamp is a member of Dead Cell.
//<ページ数変更>
プリスキン_000_1: {
Er ist geb&~urtiger Rum&~ane
und ein Messerexperte.
}
//	<<<ENGLISH>>>
//	Born in Romania, his
//	specialty is knives.
//<ページ数変更>
プリスキン_000_2: {
Aber das wei&~st Du bestimmt schon.
}
//	<<<ENGLISH>>>
//	But I guess you
//	know that by now.

/*デッドセルの一人。ヴァンプは
ルーマニア出身のナイフ使いだ。
腕前は……見ての通りだな。
*/
プリスキン_001: {
Als er ein Kind war, fiel seine
Familie einem Bombenanschlag
}
//	<<<ENGLISH>>>
//	When he was just a kid, he lost
//	his family to a terrorist bomb＃−
//<ページ数変更>
プリスキン_001_1: {
in einer Kirche zum Opfer.
}
//	<<<ENGLISH>>>
//	that went off in a church
//	they were attending.

/*幼い頃に一家で教会に行った時に
爆弾テロに巻き込まれて家族を
失っている。
*/
プリスキン_002: {
Er wurde von einem Kreuz durchbohrt.
}
//	<<<ENGLISH>>>
//	His body pierced by a crucifix,
//<ページ数変更>
プリスキン_002_1: {
Es dauerte zwei Tage, bevor man Vamp
unter all dem Schutt entdeckte und rettete.
}
//	<<<ENGLISH>>>
//	Vamp was buried under the rubble
//	for two days before he was finally
//	rescued.

/*奴は胸に教会の十字架が刺さった
ままの状態でまる二日間瓦礫の下に
放置されていたそうだ。
*/
プリスキン_003: {
Er &~uberlebte die beiden Tage,
}
//	<<<ENGLISH>>>
//	During those two days,

プリスキン_003_1: {
indem er seinen Durst mit dem
Blut seiner Familie stillte.
}
//	<<<ENGLISH>>>
//	he survived by feeding on
//	the blood of his family to
//	quench his thirst.

/*その間、奴は流れ出た自分と家族の血を
なめて渇きを癒し、命をつないでいた
らしい。
*/
プリスキン_004: {
Daher seine Vorliebe f&~ur Blut.
}
//	<<<ENGLISH>>>
//	That was how he acquired
//	a taste for blood...

/*血をすするようになったのは
それからだそうだ。*/
ライデン_005: {
Daher auch der Name 'Vamp'.
}
//	<<<ENGLISH>>>
//	So that's why they
//	call him "Vamp"...

/*それで吸血鬼……か。
*/
プリスキン_006: {
Nein, 'Vamp' steht nicht f&~ur Vampir.
Er ist bisexuell.
}
//	<<<ENGLISH(2)>>>
//	No. "Vamp" isn't for vampire.
//	It's because he's bisexual...

/*ああ。ちなみにヴァンパイアではなく
ヴァンプと呼ばれているのは奴が
バイセクシャルだからだ。
*/
//dv}//v
}//d
//ヴァンプとフォーチュンの関係を聞いていない場合 t //e
resource PS_ヴァンプ２__g {
//vox t:vc211741 {
プリスキン_000: {
Vamp war angeblich mit Scott Dolph liiert,
}
//	<<<ENGLISH>>>
//	Rumor has it Vamp was
//	the lover of Scott Dolph,
//<ページ数変更>
プリスキン_000_1: {
dem Kommandanten des Marinekorps, der
vor zwei Jahren tragisch verungl&~uckte.
}
//	<<<ENGLISH>>>
//	the Marine Commandant who
//	accidentally died two years ago.

/*２年前に事故死した海兵隊司令官、
スコット・ドルフの愛人だったという
噂もある。
*/
プリスキン_001: {
Scott Dolph war auch der Vater von
Fortune, der Anf&~uhrerin von Dead Cell.
}
//	<<<ENGLISH>>>
//	Scott Dolph was also the father
//	of Fortune, the Dead Cell leader.

/*スコット・ドルフはデッドセルの
リーダー、フォーチュンの父親でも
あるな。
*/
ライデン_002: {
Fortunes Vater?
Aber Fortune und Vamp.
}
//	<<<ENGLISH>>>
//	Fortune's old man?
//	But Fortune and Vamp...

/*フォーチュンの父親？
だが奴は彼女とも……。
*/
プリスキン_003: {
Gut aufgepa&~st f&~ur
}
//	<<<ENGLISH(2)>>>
//	You noticed, eh?

プリスキン_003_1: {
einen Anf&~anger.
}
//	<<<ENGLISH>>>
//	Not bad for a rookie...

/*ふん。よく観察しているな。
新米にしてはたいした余裕だ。
*/
ライデン_004: {
&~Ah, ja.
}
//	<<<ENGLISH>>>
//	Uh... right.

/*いや……*/
//dv}//v
}//d
resource PS_ヴァンプとフォーチュン__g {
//vox t:vc211751 {
プリスキン_000: {
Wie gesagt, Vamp und Fortune
stehen sich sehr nahe.
}
//	<<<ENGLISH>>>
//	As you say, Vamp and
//	Fortune are very close.
//<ページ数変更>
プリスキン_000_1: {
Nicht als Liebhaber, aber.
}
//	<<<ENGLISH>>>
//	Not lovers, but very
//	close...

/*そう。お前の見立てどおり、ヴァンプと
フォーチュンは肉体関係があるらしい。
まあ恋人とは少し違うようだが。
*/
ライデン_001: {
Freunde?
}
//	<<<ENGLISH>>>
//	Friends?

/*じゃあなんだ？友達？*/
プリスキン_002: {
Nein, ihre Beziehung ist mehr als das.
}
//	<<<ENGLISH>>>
//	No. There's more to their
//	relationship than that.

/*それも違うだろうな。
まあ人の絆なんてよそからは
測れんものさ。
*/
ライデン_003: {
Aber Vamp war der Liebhaber
ihres Vaters!
}
//	<<<ENGLISH>>>
//	But Vamp was her father's lover!

/*しかし……自分の父親と寝ていた男だろ？*/
プリスキン_004: {
W&~are ein Verh&~altnis mit
ihrer Mutter besser?
}
//	<<<ENGLISH>>>
//	Would it have been better
//	if it was with her mother?

/*母親と寝ていたのなら良かったのか？*/
ライデン_005: {
Nun.
}
//	<<<ENGLISH>>>
//	Well...


/*……。*/
プリスキン_006: {
Deine Meinung wird ihnen wohl egal sein.
Konzentrier Dich auf Deinen Einsatz.
}
//	<<<ENGLISH(2)>>>
//	I don't really think they
//	care what you think.
//	Focus on the mission.

/*向こうもお前に理解してもらおうなんて
思ってはいまい。
くだらんことは気にするな。
*/
ライデン_007:
''
//	<<<ENGLISH>>>
//	...

/*……。
*/
//dv}//v
}//d
//ヴァンプ遭遇直後の場合 t //e
resource PS_ヴァンプ遭遇直後__g {
//vox t:vc211761 {
ライデン_000: {
&~Ubrigens, hast Du ihn
schon mal getroffen?
}
//	<<<ENGLISH>>>
//	By the way, have you ever
//	met the guy before?

/*ところであんた、奴と会ったことが
あるのか？
*/
プリスキン_001: {
Nein.
}
//	<<<ENGLISH(2)>>>
//	No.

/*いや。*/
ライデン_002: {
Aber er schien Dich zu kennen.
}
//	<<<ENGLISH>>>
//	But he seemed to know you...

/*だが奴はあんたを知っているよう
だった……。*/
プリスキン_003: {
Ja, nun, &~ah, ich, nein,
}
//	<<<ENGLISH>>>
//	Right. Well, I... no...

プリスキン_003_1: {
es kann nicht.
}
//	<<<ENGLISH>>>
//	...it can't be...

/*確かに……まさか……。
*/
ライデン_004: {
Was?
}
//	<<<ENGLISH(2)>>>
//	What?

/*なんだ？*/
プリスキン_005: {
Nichts.
}
//	<<<ENGLISH(2)>>>
//	Nothing.
//<ページ数変更>
プリスキン_005_1: {
Ich sagte doch, da&~s Dead Cell
ein Haufen Verr&~uckter ist.
}
//	<<<ENGLISH>>>
//	I told you that Dead
//	Cell is a group of madmen...
//<ページ数変更>
プリスキン_005_2: {
ihre Aussagen sollte man
mit Vorsicht genie&~sen.
}
//	<<<ENGLISH>>>
//	I wouldn't take anything
//	they say very seriously.

/*いや。デッドセルは言った通り凶人の
集団だ。奴等の言うことをいちいち真に
受けない方がいい。気にするな。
*/
//dv}//v
}//d


//他のデッドセルの事 h //e
resource PS_デッドセル１__g {
//vox t:vc211771 {
ライデン_000: {
Erz&~ahl mir etwas mehr &~uber Dead Cell.
}
//	<<<ENGLISH>>>
//	Tell me a little more
//	about Dead Cell.

/*デッドセルについて
もう少し教えてくれないか？*/
//dv}//v
}//d
resource PS_デッドセル２__g {
//vox t:vc211781 {
プリスキン_000: {
Dead Cell war eine Schatteneinheit
innerhalb von SEAL.
}
//	<<<ENGLISH>>>
//	Dead Cell was a shadow unit
//	within the SEALS organization.

/*デッドセルはＳＥＡＬＳとは
言っても影の部隊だった。*/
ライデン_001: {
Ja. Sie f&~uhrten &~Uberraschungsangriffe auf
wichtige Regierungseinrichtungen durch,
stimmt's?
}
//	<<<ENGLISH>>>
//	Right. They handled surprise
//	raids on vital government
//	facilities, didn't they?

/*ああ。政府の重要施設を抜き打ちで
奇襲する部隊、だったか？*/
プリスキン_002: {
Genau. Dead Cell sollte urspr&~unglich das
milit&~arische Sicherheitssystem des Landes
&~uberpr&~ufen.
}
//	<<<ENGLISH>>>
//	Yes. They were originally put
//	together to check the nation's
//	military security system.

/*そうだ。
元々は米軍設備の保安システムを
チェックするために設立されたんだ。
*/
プリスキン_003: {
Die Einheit wurde nach einer Idee des
Ex-Pr&~asidenten George Sears gebildet.
}
//	<<<ENGLISH>>>
//	The unit was the brainchild of
//	ex-president George Sears...

/*前の大統領、ジョージ・シアーズの
肝いりでな。
*/
プリスキン_004: {
Dead Cell war eine geheime Einheit
am anderen Ende von
}
//	<<<ENGLISH>>>
//	Dead Cell was a secret unit
//	positioned at the opposite
//	end of＃−
//<ページ数変更>
プリスキン_004_1: {
Antiterror-Einheiten wie
Delta Force und SEALS.
}
//	<<<ENGLISH>>>
//	anti-terrorist outfits such
//	as Delta Force and SEALS.

/*デルタフォースやＳＥＡＬＳといった、
対テロリスト部隊の対極に位置する
闇の組織……。
*/
ライデン_005: {
Waren sie schon immer.
}
//	<<<ENGLISH>>>
//	Were they always a...

/*奴等は初めから……その……*/
プリスキン_006: {
verr&~uckt?
}
//	<<<ENGLISH>>>
//	...group of madmen?


/*凶人の集団。*/
ライデン_007: {
Ja.
}
//	<<<ENGLISH(2)>>>
//	Yeah.

/*ああ。それだったのか？*/
プリスキン_008: {
Nein. Sie verhielten sich erst merkw&~urdig,
als Oberst Jackson - Fortunes Gatte - ins
Gef&~angnis geworfen wurde.
}
//	<<<ENGLISH>>>
//	No. They got weird when Colonel
//	Jackson -- Fortune's husband --
//	was sent to jail.

/*いや。リーダーだったジャクソン大佐……
フォーチュンと言われている女の旦那が
投獄されたあたりからだろうな。
*/
ライデン_009: {
Ins Gef&~angnis? Wof&~ur?
}
//	<<<ENGLISH>>>
//	Sent to jail? For what?

/*投獄？一体何を？*/
プリスキン_010: {
Korruption. Er hat staatliche
Mittel veruntreut.
}
//	<<<ENGLISH>>>
//	Corruption. He misappropriated
//	government funds.

/*汚職。公金の横領。*/
ライデン_011: {
H&~ort sich an, als h&~atte er es verdient.
}
//	<<<ENGLISH>>>
//	Sounds like he deserved it...

/*軍人としては不名誉極まりないな。*/
プリスキン_012: {
Das dachten alle, bis auf
die Mitglieder von Dead Cell.
}
//	<<<ENGLISH>>>
//	That's what everybody else thought.
//	Except for the members of Dead Cell.
//<ページ数変更>
プリスキン_012_1: {
Sie glaubten, da&~s der Oberst
zu Unrecht beschuldigt wurde.
}
//	<<<ENGLISH>>>
//	They felt the Colonel
//	was falsely accused.

/*世間の反応もお前と同じだったよ。
だがデッドセルの連中はそれを冤罪と
信じて疑わなかったようだ。
*/
プリスキン_013: {
So trugen sie ihren Fall den h&~ochsten
Instanzen vor. Dennoch gelang es ihnen
nie, den Fall wieder aufzurollen.
}
//	<<<ENGLISH>>>
//	Fact is, they took the case to the
//	powers that be. But they never
//	managed to reopen the case.

/*何度か上層部に掛け合ったりもしたよう
だが、なぜか再審理は行われなかった。
*/
ライデン_014: {
War denn etwas an ihrer
Behauptung dran?
}
//	<<<ENGLISH>>>
//	Was there any truth
//	to their claim?

/*本当に冤罪だったのか？*/
プリスキン_015: {
Wer wei&~s? Jedenfalls war
der Name Dead Cell befleckt.
}
//	<<<ENGLISH>>>
//	Who knows?  Whatever the
//	situation is, Dead Cell's name
//	was tainted.

/*さあな。真相は闇の中だ。
しかし事実はどうあれ、結果として
デッドセルの名は地に落ちた……。
*/
ライデン_016: {
Und Oberst Jackson?
}
//	<<<ENGLISH>>>
//	And Colonel Jackson...?

/*……で、そのジャクソン大佐は
どうなったんだ？*/
プリスキン_017: {
Er wurde in Leavenworth festgehalten.
}
//	<<<ENGLISH>>>
//	He was being held
//	at Leavenworth...

/*レブンワース刑務所に収監されていた。*/
ライデン_018: {
'Wurde', hei&~st das, er ist jetzt frei?
}
//	<<<ENGLISH>>>
//	"Was"...meaning he's
//	been released?


/*いた？
出所したのか？
*/
プリスキン_019: {
Sozusagen, Der Oberst ist tot.
}
//	<<<ENGLISH>>>
//	Well... in a manner of
//	speaking. The Colonel's
//	dead.


/*ああ。この世からな。*/
ライデン_020: {
Oh.
}
//	<<<ENGLISH(2)>>>
//	Oh.

/*え？*/
プリスキン_021: {
Anscheinend wollte er nicht mehr
leben und starb im Gef&~angnis.
}
//	<<<ENGLISH>>>
//	Apparently he lost the will
//	to live and died in prison.

/*獄死したんだ。衰弱死だったそうだが。*/
プリスキン_022: {
Die Mitglieder von Dead Cell wurden mit
dem Verlust ihres Anf&~uhrers nicht fertig.
}
//	<<<ENGLISH>>>
//	The members of Dead Cell
//	snapped with the loss of their
//	leader.

/*リーダーを失うのと同時に
奴等は歯止めも見境も
なくしたらしい。
*/
プリスキン_023: {
Sie &~anderten sich von Grund auf
und gerieten au&~ser Kontrolle.
}
//	<<<ENGLISH>>>
//	They underwent a radical change
//	and became uncontrollable.

/*それ以来デッドセルは先鋭化を続け
手のつけられない暴走をはじめた……。
*/
ライデン_024: {
Und darum haben sie diesen
terroristischen Angriff gestartet?
}
//	<<<ENGLISH>>>
//	And that's why they undertook
//	this terrorist operation?

/*そのあげくがこのテロか？
*/
プリスキン_025: {
Ein Grund ist so gut wie jeder andere.
}
//	<<<ENGLISH>>>
//	Seems as good a reason as any...

/*そうかもな。*/
//dv}//v
}//d


//フォーチュンについて h //e
resource PS_フォーチュン１__g {
//vox t:vc211791 {
ライデン_000: {
Was wei&~st Du &~uber diese
merkw&~urdige Frau?
}
//	<<<ENGLISH>>>
//	What do you know about
//	that strange woman?

/*あの妙な女については何か知っているか？
*/
プリスキン_001: {
Du meinst Fortune?
Sie ist die Anf&~uhrerin von Dead Cell.
}
//	<<<ENGLISH>>>
//	You mean Fortune? She's
//	the Dead Cell leader.

/*フォーチュンのことか？
デッドセルのリーダーだ。
*/
プリスキン_002: {
Ihr wahrer Name ist Helena Dolph
Jackson, f&~ur ihre Freunde Lady Luck.
}
//	<<<ENGLISH>>>
//	Her real name is Helena Dolph
//	Jackson... known to her friends
//	as Lady Luck.

/*本名、ヘレナ・ドルフ・ジャクソン。
通称、幸運の女神……。
*/
ライデン_003: {
Lady Luck?
}
//	<<<ENGLISH(2)>>>
//	Lady Luck?

/*幸運の女神？*/
プリスキン_004: {
Ja. Dieser Name stammt daher, da&~s
Kugeln ihr im Kampf auszuweichen
scheinen.
}
//	<<<ENGLISH>>>
//	Yeah. She got the name because
//	bullets seem to veer away from
//	her in battle.

/*そうとでも言うしかないだろう。
何しろ弾が当たらないんだ。
*/
ライデン_005:
''
//	<<<ENGLISH(2)>>>
//	...

/*……。
*/
プリスキン_006: {
Man hat sie sagen h&~oren, da&~s ihr Gl&~uck
im Kampf der Ausgleich f&~ur ihr Ungl&~uck
im Leben ist.
}
//	<<<ENGLISH>>>
//	People have heard her say that her
//	fortune in battle was payback for
//	the lousy luck she's had in life...

/*だがその幸運は私生活の不運と
引き換えにしたものだと彼女は
言っているらしい。
*/
ライデン_007: {
Ungl&~uck?
}
//	<<<ENGLISH>>>
//	Lousy luck?

/*不運？*/
プリスキン_008: {
Der Tod ihres Vaters,
des Marinekommandanten.
}
//	<<<ENGLISH>>>
//	The death of her father,
//	the Marine commander...
//<ページ数変更>
プリスキン_008_1: {
Die Verurteilung ihres Gatten,
Dead Cell-Anf&~uhrer Oberst Jackson.
}
//	<<<ENGLISH>>>
//	The conviction of husband and Dead
//	Cell leader, Colonel Jackson...

/*海兵隊司令官だった父親が死に、デッド
セルのリーダーだった旦那のジャクソン
大佐も横領でムショ送りになった。
*/
プリスキン_009: {
Gefolgt vom Freitod ihrer Mutter --
}
//	<<<ENGLISH>>>
//	These events were followed
//	by her mother's suicide --
//<ページ数変更>
プリスキン_009_1: {
der Verlust ihres Ehemannes und die
Vorstellung einen Str&~afling in der Familie
zu haben, waren anscheinend zu viel.
}
//	<<<ENGLISH>>>
//	the loss of a husband and the idea
//	of a convict in the family apparently
//	took her over the edge...

/*まもなく夫の死と義理の息子の服役に
耐えかねたのか、母親が自殺。
*/
プリスキン_010: {
Fortune war damals im dritten Monat
schwanger, und der Schock &~uber den
Tod ihrer Mutter
}
//	<<<ENGLISH>>>
//	Fortune was three months pregnant
//	at the time and the shock of her
//	mother's death＃−
//<ページ数変更>
プリスキン_010_1: {
verursachte eine Fehlgeburt.
}
//	<<<ENGLISH>>>
//	led to the loss of her child.
//<ページ数変更>
プリスキン_010_2: {
Hinzu kam der Tod ihres Ehemannes
ein paar Monate sp&~ater.
}
//	<<<ENGLISH>>>
//	Add to this her husband's death
//	in prison a few months later and...

/*フォーチュン自身もそのショックで当時
三ヶ月だった子供を流産。
とどめに夫もその数ヶ月後に獄死。
*/
プリスキン_011: {
Kurz gesagt, in den sechs Monaten
nach dem Tod ihres Vaters
}
//	<<<ENGLISH>>>
//	To sum it up, in the six
//	months after her father's
//	death,
//<ページ数変更>
プリスキン_011_1: {
verlor sie ihre Familie und alles,
was ihr wichtig war.
}
//	<<<ENGLISH>>>
//	she lost her family and
//	everything that mattered
//	in her life.

/*つまり父親の死からたった半年程の間に
彼女は家族と、それまで頼りにしていた
現実の全てを失ったというわけだ。
*/
ライデン_012: {
Mann, das ist ganz sch&~on hart.
}
//	<<<ENGLISH>>>
//	Geez, she's had it rough...

/*……ひどい話だな。*/
プリスキン_013: {
Ja. Aber sie trauerte nicht lange.
Stattdessen trat sie ins Milit&~ar ein.
}
//	<<<ENGLISH>>>
//	Yeah. The thing is, she didn't
//	grieve long. Instead, she joined
//	the military.

/*だが彼女は悲嘆にくれるかわりに
軍に入った。
*/
ライデン_014: {
Warum?
}
//	<<<ENGLISH>>>
//	Now why's that?

/*どうして？*/
プリスキン_015: {
Bin ich Hellseher? Ich vermute Rache.
}
//	<<<ENGLISH>>>
//	Do I look psychic?
//	My best guess is
//	revenge.
//<ページ数変更>
プリスキン_015_1: {
Ich habe geh&~ort, da&~s sie &~uberzeugt war,
da&~s ihr Mann reingelegt wurde.
}
//	<<<ENGLISH>>>
//	I heard that she firmly believed
//	that her husband was framed...

/*さあな。復讐かもしれん。彼女は夫の
服役を冤罪だと信じていたらしい。
誰かにはめられた、と。
*/
プリスキン_016: {
Wie dem auch sei, als sie
die Grundausbildung abgeschlossen hatte,
}
//	<<<ENGLISH>>>
//	Anyway... by the time she
//	came out of basic training,

//<ページ数変更>
プリスキン_016_1: {
hatte sie bereits viele Male ihre 'Gabe',
ihr unglaubliches Gl&~uck, unter Beweis
gestellt.
}
//	<<<ENGLISH>>>
//	she'd proven many times over
//	that she was "gifted" with an
//	unusual streak of luck.

/*とにかく訓練を終える頃には彼女は
あの恐るべき強運を身につけていた。
*/
プリスキン_017: {
Es hei&~st sogar, sie habe
daf&~ur ihre Seele verkauft.
}
//	<<<ENGLISH>>>
//	In fact, some say she
//	sold her soul for it.

/*そのために悪魔と取り引きしたとも
言われている。
*/
ライデン_018: {
Ihre Seele?
}
//	<<<ENGLISH>>>
//	Her soul?

/*悪魔……？*/
プリスキン_019: {
Ihr unglaubliches Gl&~uck brachte
ihr einen solchen Ruf ein,
}
//	<<<ENGLISH>>>
//	Her uncanny luck earned
//	her a reputation that led
//	to her appointment＃−
//<ページ数変更>
プリスキン_019_1: {
da&~s sie zur Anf&~uhrerin der Einheit ihres
Gatten ernannt wurde, von Dead Cell.
}
//	<<<ENGLISH>>>
//	as the head of her husband's
//	unit, Dead Cell.

/*すぐにその力は知れ渡り、遂には死んだ
夫が率いていたデッドセルのリーダーに
収まったというわけだ。
*/
//dv}//v
}//d
//ヴァンプとフォーチュン聞いていない場合 t //e
resource PS_フォーチュン２__g {
//vox t:vc211801 {
プリスキン_000: {
Sie ist die Witwe des ehemaligen,
beliebten Dead Cell-Anf&~uhrers.
}
//	<<<ENGLISH>>>
//	She's the widow of Dead Cell's
//	former beloved leader.
//<ページ数変更>
プリスキン_000_1: {
Vamp, der die Einheit vor&~ubergehend
leitete, soll sie mit offenen Armen
aufgenommen haben.
}
//	<<<ENGLISH>>>
//	I'd heard that she was welcomed
//	with open arms by Vamp, who was
//	the temporary leader at the time.

/*信望の厚かった元リーダーの未亡人だ。
暫定的にデッドセルをまとめていた
ヴァンプも喜んで彼女を迎えたらしい。
*/
プリスキン_001: {
Vamp begr&~u&~ste auch die Tochter seines
ehemaligen Techtelmechtels.
}
//	<<<ENGLISH>>>
//	For Vamp, it also meant welcoming
//	the daughter of his former lover...

/*ま、奴にとっては元恋人の娘でもあった
わけだが。
*/
ライデン_002: {
Vamp und Fortunes Mutter?
}
//	<<<ENGLISH(2)>>>
//	Vamp and Fortune's mother...?

/*ヴァンプとフォーチュンの母親が？*/
プリスキン_003: {
Nein. Vamp und Fortunes Vater,
Vamp ist bisexuell.
}
//	<<<ENGLISH>>>
//	No. Vamp and Fortune's
//	father... Vamp's bisexual.

/*いや、父親の方だ。
バイセクシャルなんだよ。
*/
ライデン_004: {
Oh, Warte mal.
Ich dachte, Vamp und Fortune.
}
//	<<<ENGLISH>>>
//	Oh... Wait a sec. I thought
//	Vamp and Fortune...

/*ぐ！いや待て。
だがヴァンプとフォーチュンは……
*/
プリスキン_005: {
Du hast es also auch bemerkt!?
}
//	<<<ENGLISH(2)>>>
//	You noticed, eh?

/*ふん。つまらんことに鼻がきくんだな。*/
ライデン_006: {
&~Ah, ja.
}
//	<<<ENGLISH>>>
//	Uh... yeah.

/*いや……。*/
//dv}//v
}//d
