}
//	<<<ENGLISH>>>
//	Even if you're sighted, you won't
//	have to worry about the backup
//	being called. Just hurry over here.

/*たとえ敵に見つかっても増援部隊は
やってこないだろう。急いでこっちに
来い！*/
//dv}//v
}//d

