//大統領警備隊の事 h //e
resource PS_大統領警護隊１__g {
//vox t:vc211811 {
プリスキン_000: {
Die Verst&~arkung, die stets zur Stelle ist,
wenn Du vom Feind entdeckt wirst,
}
//	<<<ENGLISH>>>
//	The reinforcements that rush up
//	whenever you're discovered by
