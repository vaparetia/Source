//<ページ数変更>
プリスキン_000_1: {
such einen anderen Aussichtspunkt,
von dem Du freie Sicht hast.
}
//	<<<ENGLISH>>>
//	There will always be a spot
//	that gives you a clear shot.

/*パイプやタンクの影に入って狙えない
