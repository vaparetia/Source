//走り撃ち h //e
resource PS_走り撃ち１__g {
//vox t:vc211641 {
プリスキン_000: {
Um Dich mit schu&~sbereitem Gewehr zu
bewegen, h&~altst Du entweder die L1-Taste
oder die Kriechtaste gedr&~uckt
}
//	<<<ENGLISH(2)>>>
