*/
オタコン_001: {
Bei einer Feuergeschwindigkeit von 3.800
Schu&~s/Minute
}
//	<<<ENGLISH>>>
//	With a firing speed of 3,800
//	rounds per minute,
//<ページ数変更>
オタコン_001_1: {
starten die Geschosse mit einer
Anfangsgeschwindigkeit von mehr als
1.000m/Sek.
}
//	<<<ENGLISH>>>
//	rounds are launched at an initial
//	velocity of over 1,000 meters per
//	second.
//<ページ数変更>
オタコン_001_2: {
Mit anderen Worten: La&~s Dich nicht
treffen.
}
//	<<<ENGLISH>>>
//	In other words, don't get shot.

/*発射速度は毎分３８００発。
砲口初速は秒速１０００ｍ以上。
まともに食らったら駄目だ。
*/
//dv}//v
}//d
//二回目以降 t //e
resource PS_ハリアー戦＿機銃２__g {
//vox t:vc212031 {
オタコン_000: {
Sobald die Gesch&~utze am Harrier feuern,
geh' in Deckung.
}
//	<<<ENGLISH>>>
//	As soon as the Harrier's guns
//	commence firing, take cover.
//<ページ数変更>
オタコン_000_1: {
Versuch nicht, Dich einer solchen
Feuerkraft zu stellen.
}
//	<<<ENGLISH>>>
//	Don't even think about facing off
//	against that kind of firepower.

/*ハリアーが機銃を撃ってきたらすぐに
遮蔽物に隠れるんだ。いいね。
*/

}//d
