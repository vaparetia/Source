resource オプションの説明スペイン語 {
VIB:
	{ACTIVAR / DESACTIVAR la funci&'on vibratoria.}
// RADはダミーデータ
RAD:
	'Seleccionar el tipo de radar.'
BLD:
	'Jugar CON / SIN Sangre.'
SND:
	{Selecciona sonido EST&'EREO / MONO.}
P5_1CH:
	{Algunas escenas se escuchar&'an en Dolby Digital 5.1.}
CAP:
	'Jugar CON / SIN anotaciones.'
OWN:
	'Selecciona el tipo de control para la Visi&\'on Primera|'
	'Persona.'
ITEM:
	{Selecciona la forma de visualizaci&'on del objeto.}
QUICK:
	{Selecciona el tipo de cambio r&'apido.}
SCRADJ:
	{Ajustar la posici&'on de la pantalla.}
CLRADJ:
	'Muestra la pantalla de ajuste del color.'
EXIT:
	'Volver a la pantalla anterior.'
COLORADJ:
	'Ajusta el brillo de la pantalla. Cuando|'
	'la escala de color gris que aparece|'
	'bajo la l&\'inea roja se deje de ver,|'
	'el brillo ser&\'a el &\'optimo durante el|'
	'juego.'
};

resource レーダーの説明スペイン語 {
RAD_TYPE1:
	{El radar aparece incluso durante la Visi&'on Intrusi&'on.}
RAD_TYPE2:
	{El radar no aparece durante la Visi&'on Intrusi&'on.}
RAD_OFF:
	'El radar no aparece nunca.'
}

resource クイックチェンジの説明スペイン語 {
unequip:
