resource オプションの説明フランス語 {
VIB:
	'Mettre la vibration sur ON / OFF.'
// RADはダミーデータ
RAD:
	'Choisir le type de radar.'
BLD:
	{Mettre l'affichage du sang sur ON / OFF.}
SND:
	'Choisir entre le son STEREO et MONO.'
P5_1CH:
	// {Certaines sc&`enes coup&'ees seront en Dolby Digital 5.1.}
	{Certaines s&'equences vid&'eos seront en Dolby Digital 5.1.}
CAP:
	'Mettre les sous-titres sur ON / OFF.'
OWN:
	{Choisir l'Observation &`a la premi&`ere personne.}
ITEM:
	{Choisir l'affichage des objets.}
QUICK:
	'Choisir les changements rapides.'
SCRADJ:
	{R&'egler la position de l'&'ecran.}
CLRADJ:
	{Afficher l'&'ecran de r&'eglage des couleurs.}
EXIT:
	{Retourner dans l'&'ecran pr&'ec&'edent.}
COLORADJ:
	{Afin d'obtenir la luminosit&'e|
	 optimale pour ce jeu, r&'eglez la|
	 luminosit&'e du moniteur de mani&`ere|
	 &`a rendre invisible l'&'echelle de gris|
	 situ&'ee sous la ligne rouge.}
};

resource レーダーの説明フランス語 {
RAD_TYPE1:
	{Le radar s'affiche m&^eme en Point de vue d'intrusion.}
RAD_TYPE2:
	{Le radar ne s'affiche pas en Point de vue d'intrusion.}
RAD_OFF:
	{Le radar ne s'affiche pas du tout.}
}

resource クイックチェンジの説明フランス語 {
unequip:
	{Equiper/Ne pas &'equiper une arme/un outil.}

previous:
	{Alterner des armes/des outils pr&'ealablement &'equip&'es.}
}


resource オプションの説明ドイツ語 {
VIB:
	'Vibration EIN / AUS.'
// RADはダミーデータ
RAD:
	'Radartyp w&~ahlen.'
BLD:
	'Blutanzeige EIN / AUS.'
SND:
	'W&~ahlen Sie STEREO / MONO.'
P5_1CH:
	'Bestimmte Szenen sind in Dolby Digital 5.1.'
CAP:
	'Untertitel EIN / AUS.'
OWN:
	'Beobachtungsperspektive w&~ahlen.'
ITEM:
	'Displaytyp w&~ahlen.'
QUICK:
	'Schnellwechseltyp w&~ahlen.'
SCRADJ:
	'Bildschirmposition regulieren.'
CLRADJ:
	'Farbregulierungsbildschirm einblenden.'
EXIT:
	'Zur&~uck zum vorigen Bildschirm.'
COLORADJ:
	'F&~ur optimale Helligkeit die|'
	'Monitorhelligkeit so|'
	'einstellen, da&~s die Graustufe|'
	'unter der roten Linie nicht|'
	'mehr sichtbar ist.'
};

resource レーダーの説明ドイツ語 {
RAD_TYPE1:
	'Radar erscheint auch in der Eindringperspektive.'
RAD_TYPE2:
	'Radar erscheint nicht in der Eindringperspektive.'
RAD_OFF:
	'Radar erscheint &~uberhaupt nicht.'
}

resource クイックチェンジの説明ドイツ語 {
unequip:
	'Nenme/Gebe die ausgew&~ahelten Waffen/Gegenst&~ande.'

previous:
	'Wechsle zwischen momentaner und vohergehender|'
	'Ausr&~ustung an Waffen/Gegenst&~ande.'
}


resource オプションの説明イタリア語 {
VIB:
	'Attiva / disattiva la vibrazione.'
// RADはダミーデータ
RAD:
	'Seleziona tipo di radar.'
BLD:
	'Attiva / disattiva la visualizzazione del sangue.'
SND:
	'Seleziona sonoro in STEREO / MONO.'
P5_1CH:
	'Alcune scene saranno nel formato Dolby Digital 5.1.'
CAP:
	'Attiva / disattiva le didascalie.'
OWN:
	'Seleziona tipo di controllo in Visuale Soggettiva.'
ITEM:
	'Seleziona tipo di visualizzazione oggetti.'
QUICK:
	'Seleziona tipo di cambio rapido.'
SCRADJ:
	'Regola posizione schermata.'
CLRADJ:
	'Visualizza schermata di regolazione colore.'
EXIT:
	'Torna alla schermata precedente.'
COLORADJ:
	'Regola luminosit&`a del monitor|'
	'in modo da rendere invisibile la|'
	'scala di grigi sotto la linea rossa|'
	'ed ottenere la luminosit&`a ottimale|'
	'per questo gioco.'
};

resource レーダーの説明イタリア語 {
RAD_TYPE1:
	'Il radar appare anche nella Visuale Incursione.'
RAD_TYPE2:
	'Il radar non appare nella Visuale Incursione.'
RAD_OFF:
	'Il radar non appare mai.'
}

resource クイックチェンジの説明イタリア語 {
