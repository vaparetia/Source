// マップ設定
// ------------------------------------
chara マップ 全船倉 -h d:STAGE_HZX -l d:STAGE_LT2

command マップ設定 全船倉 -set {

//	デモ環境かゲーム環境かで起動を読み分ける。
// ------------------------------------
#if d:MGS2_DEMO

		// t14a1D を再生するとき
		eval($s:d_num = t14a1D)
		// t14a2D を再生するとき
	//	eval($s:d_num = t14a2D)
		// t14a3D を再生するとき
	//	eval($s:d_num = t14a3D)

chara デモアクトデバッグ demodebug  -i t:dust -d 'dust' -l   \
		-p	第三船倉オフ 第三船倉オン \
			第二船倉オフ 第二船倉オン \
			第一船倉オフ 第一船倉オン \
			右プロジェクタオフ 左プロジェクタオフ \
			右プロジェクタオン 左プロジェクタオン

// 下のフラグに対応するelseがMGS2_DEMOの区切りの外にあるため、
// elseがおかしくなるのを回避するためのダミーのif文です。
// 010822 田中(信)追加
if(1) {

#else

// ストリーム最後では描画更新されなく、ゲームオーバーロゴが
// 表示されないので、いったんリスタートするためのフラグ立て。
if(!$f:d14t_gover_played) {

	if($s:直前のエリア == w04a){
		eval($f:global_polygon_demo = 1)
		eval($s:d_num = t14a1D)

		@デモモデル差し替え処理
		proc デモ再生_t14a1D {
			#if d:デモ前五秒間待ち
				chara デモアクトデバッグ demodebug  -i t:t14a1D -d 't14a1D' -l -s't14a1D' \
					-next t14a系終了 \
					-p	第三船倉オフ 第三船倉オン \
						第二船倉オフ 第二船倉オン \
						第一船倉オフ 第一船倉オン \
						右プロジェクタオフ 左プロジェクタオフ \
						右プロジェクタオン 左プロジェクタオン
			#else
				chara demo デモ再生 \
					-i t:t14a1D \
					-p	第三船倉オフ 第三船倉オン \
						第二船倉オフ 第二船倉オン \
						第一船倉オフ 第一船倉オン \
						右プロジェクタオフ 左プロジェクタオフ \
						右プロジェクタオン 左プロジェクタオン \
					-next t14a系終了
			#endif
		}

		#if d:デモ前五秒間待ち
			@global_五秒待ちセット
			if($f:global_デバッグポーズ通過){
				@デモ再生_t14a1D
			}
		#else
			@デモ再生_t14a1D
		#endif

	} else if($s:直前のエリア == w04b){
		eval($f:global_polygon_demo = 1)
		eval($s:d_num = t14a2D)

		@デモモデル差し替え処理
		proc デモ再生_t14a2D {
			#if d:デモ前五秒間待ち
				chara デモアクトデバッグ demodebug  -i t:t14a2D -d 't14a2D' -l -s't14a2D' \
					-next t14a系終了 \
					-p	第三船倉オフ 第三船倉オン \
						第二船倉オフ 第二船倉オン \
						第一船倉オフ 第一船倉オン \
						右プロジェクタオフ 左プロジェクタオフ \
						右プロジェクタオン 左プロジェクタオン
			#else
				chara demo デモ再生 \
					-i t:t14a2D \
					-p	第三船倉オフ 第三船倉オン \
						第二船倉オフ 第二船倉オン \
						第一船倉オフ 第一船倉オン \
						右プロジェクタオフ 左プロジェクタオフ \
						右プロジェクタオン 左プロジェクタオン \
					-next t14a系終了
			#endif
		}

		#if d:デモ前五秒間待ち
			@global_五秒待ちセット
			if($f:global_デバッグポーズ通過){
				@デモ再生_t14a2D
			}
		#else
			@デモ再生_t14a2D
		#endif

	} else {
		eval($f:global_polygon_demo = 1)
		eval($s:d_num = t14a3D)

		// セレクトからデモ再生の場合こっちを通る。
		if($s:デモ直前のエリア == w04a){
			eval($f:global_polygon_demo = 1)
			eval($s:d_num = t14a1D)

			@デモモデル差し替え処理
			proc demo_デモ再生_t14a1D {
				#if d:デモ前五秒間待ち
					chara デモアクトデバッグ demodebug  -i t:t14a1D -d 't14a1D' -l -s't14a1D' \
						-next t14a系終了 \
						-p	第三船倉オフ 第三船倉オン \
							第二船倉オフ 第二船倉オン \
							第一船倉オフ 第一船倉オン \
							右プロジェクタオフ 左プロジェクタオフ \
							右プロジェクタオン 左プロジェクタオン
				#else
					chara demo デモ再生 \
						-i t:t14a1D \
						-p	第三船倉オフ 第三船倉オン \
							第二船倉オフ 第二船倉オン \
							第一船倉オフ 第一船倉オン \
							右プロジェクタオフ 左プロジェクタオフ \
							右プロジェクタオン 左プロジェクタオン \
						-next t14a系終了
				#endif
			}

			#if d:デモ前五秒間待ち
				@global_五秒待ちセット
				if($f:global_デバッグポーズ通過){
					@demo_デモ再生_t14a1D
				}
			#else
				@demo_デモ再生_t14a1D
			#endif

		} else if($s:デモ直前のエリア == w04b){
			eval($f:global_polygon_demo = 1)
			eval($s:d_num = t14a2D)

			@デモモデル差し替え処理
			proc demo_デモ再生_t14a2D {
				#if d:デモ前五秒間待ち
					chara デモアクトデバッグ demodebug  -i t:t14a2D -d 't14a2D' -l -s't14a2D' \
						-next t14a系終了 \
						-p	第三船倉オフ 第三船倉オン \
							第二船倉オフ 第二船倉オン \
							第一船倉オフ 第一船倉オン \
							右プロジェクタオフ 左プロジェクタオフ \
							右プロジェクタオン 左プロジェクタオン
				#else
					chara demo デモ再生 \
						-i t:t14a2D \
						-p	第三船倉オフ 第三船倉オン \
							第二船倉オフ 第二船倉オン \
							第一船倉オフ 第一船倉オン \
							右プロジェクタオフ 左プロジェクタオフ \
							右プロジェクタオン 左プロジェクタオン \
						-next t14a系終了
				#endif
			}

			#if d:デモ前五秒間待ち
				@global_五秒待ちセット
				if($f:global_デバッグポーズ通過){
					@demo_デモ再生_t14a2D
				}
			#else
				@demo_デモ再生_t14a2D
			#endif

		} else if($s:デモ直前のエリア == w04c){
			eval($f:global_polygon_demo = 1)
			eval($s:d_num = t14a3D)

			@デモモデル差し替え処理
			proc demo_デモ再生_t14a3D {
				#if d:デモ前五秒間待ち
					chara デモアクトデバッグ demodebug  -i t:t14a3D -d 't14a3D' -l -s't14a3D' \
						-next t14a系終了 \
						-p	第三船倉オフ 第三船倉オン \
							第二船倉オフ 第二船倉オン \
							第一船倉オフ 第一船倉オン \
							右プロジェクタオフ 左プロジェクタオフ \
							右プロジェクタオン 左プロジェクタオン
				#else
					chara demo デモ再生 \
						-i t:t14a3D \
						-p	第三船倉オフ 第三船倉オン \
							第二船倉オフ 第二船倉オン \
							第一船倉オフ 第一船倉オン \
							右プロジェクタオフ 左プロジェクタオフ \
							右プロジェクタオン 左プロジェクタオン \
						-next t14a系終了
				#endif
			}

				#if d:デモ前五秒間待ち
					@global_五秒待ちセット
					if($f:global_デバッグポーズ通過){
						@demo_デモ再生_t14a3D
					}
				#else
					@demo_デモ再生_t14a3D
				#endif

		// セレクトからのデモ再生をどれも通過しない＝直前のエリアがw04c
		// の場合は以下を通過し、w04cでのゲームオーバーデモ再生。
		} else {

			@デモモデル差し替え処理
			proc デモ再生_t14a3D {
				#if d:デモ前五秒間待ち
					chara デモアクトデバッグ demodebug  -i t:t14a3D -d 't14a3D' -l -s't14a3D' \
						-next t14a系終了 \
						-p	第三船倉オフ 第三船倉オン \
							第二船倉オフ 第二船倉オン \
							第一船倉オフ 第一船倉オン \
							右プロジェクタオフ 左プロジェクタオフ \
							右プロジェクタオン 左プロジェクタオン
				#else
					chara demo デモ再生 \
						-i t:t14a3D \
						-p	第三船倉オフ 第三船倉オン \
							第二船倉オフ 第二船倉オン \
							第一船倉オフ 第一船倉オン \
							右プロジェクタオフ 左プロジェクタオフ \
							右プロジェクタオン 左プロジェクタオン \
						-next t14a系終了
				#endif
			}

			#if d:デモ前五秒間待ち
				@global_五秒待ちセット
				if($f:global_デバッグポーズ通過){
					@デモ再生_t14a3D
				}
			#else
				@デモ再生_t14a3D
			#endif

		}

	}


	// 本番では共通でつかう
	@デモキャンセルチェックプロック

#endif

	@常駐キャラ設定
	@エフェクト設定
	@シネマスクリーンセット
	@ぼかしセット
	@チェーン設定
