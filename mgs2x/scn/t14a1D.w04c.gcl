// ぼかしセット
// ------------------------------------
proc ぼかしセット {
	chara 遠景ぼかし far_deforcus \
		-plane	4 \
		-near	6000 \
		-far	9000

	chara 近景ぼかし near_deforcus \
		-plane	3 \
		-near	0 \
		-far	3000
}

// 第二船倉のプロジェクタセット
// ------------------------------------
proc 第二船倉のプロジェクタセット {
	chara プロジェクタライト プロジェクタライト右 \
		-p 630,-15600,(-1300+28500) \
		-d 4000,-10000,(-22000+28500)
	chara プロジェクタライト プロジェクタライト左 \
		-p -630,-15600,(-1300+28500) \
		-d -4000,-10000,(-22000+28500)
	mesg プロジェクタライト プロジェクタライト右 オフ
	mesg プロジェクタライト プロジェクタライト左 オフ
}
proc 右プロジェクタオフ {
	mesg プロジェクタライト プロジェクタライト右 オフ
}
proc 左プロジェクタオフ {
	mesg プロジェクタライト プロジェクタライト左 オフ
}
proc 右プロジェクタオン {
	mesg プロジェクタライト プロジェクタライト右 オン
}
proc 左プロジェクタオン {
	mesg プロジェクタライト プロジェクタライト左 オン
}


// -------------------------------------
// ！！！重要！！！
// -------------------------------------
/* 以下のライトで、
「＊＊＊のプリシェード平環光セット」はプリシェードモデルを置く直前でセット、
 置き終わったら元のものに戻す。（プットオブジェで検索して、ちゃんと置く。
 t04a1D.w00a.gcl参照）
「＊＊＊のキャラ平環光セット」はマックスの方で、随時呼び出すために用意した
 このステージでは、マップ設定でセットしているのは ?????.lt2 である */

// w04cステージにあたる場所での平行、環境光
proc w04cのキャラ平環光セット {
	chara 環境光 w04cキャラ環境光 \
		 -c 73 89 121
	chara 平行光 w04cキャラ平行光 \
		 -c 61 142 174 \
		 -p -100 -3500 -2000
}
proc w04cのプリシェード平環光セット {
	chara 環境光 w04cプリ環境光 \
		 -c 63 35 17
	chara 平行光 w04cプリ平行光 \
		 -c 255 119 70 \
		 -p 0 -4300 -2500
}

// w04bステージにあたる場所での平行、環境光
proc w04bのキャラ平環光セット {
	chara 環境光 w04bキャラ環境光 \
		 -c 4 35 44
	chara 平行光 w04bキャラ平行光 \
		 -c 54 86 70 \
		 -p 321 1705 0
}
proc w04bのプリシェード平環光セット {
	chara 環境光 w04bプリ環境光 \
		 -c 24 91 94
	chara 平行光 w04bプリ平行光 \
		 -c 80 35 5 \
		 -p 3800 -3200 -100
}

// w04aステージにあたる場所での平行、環境光
proc w04aのキャラ平環光セット {
	chara 環境光 w04aキャラ環境光 \
		 -c 53,73,55
	chara 平行光 w04aキャラ平行光 \
		 -c 70,230,214 \
		 -p 691,721,0
}
proc w04aのプリシェード平環光セット {
	chara 環境光 w04aプリ環境光 \
		 -c 24 91 94
	chara 平行光 w04aプリ平行光 \
		 -c 80 35 5  \
		 -p 2200,-4300,1000
}

// レイコクピットアップでの平行、環境光
proc レイコクピットのキャラ平環光セット {
	chara 環境光 レイキャラ環境光 \
		 -c 53,73,55
