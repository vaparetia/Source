	@第一船倉セット
#if 0
	@第三船倉オン
	@第二船倉オン
	@第一船倉オン
#endif

}else{
	command システムコールバック -gameover ゲームオーバー処理 -continue コンティニュー処理
    command ゲームオーバー呼びわけ -c 0
	@t14a系終了後リスタート後プロック
}

//	@スクリーンショット使用
} // 「command マップ設定 全船倉」の閉じカッコ


// 初期マップの表示
command マップ表示 	-add 全船倉

// 必ずステージのshow(add)の後にセットすること。
//@デフォルトキャラ専用ライトセット


// デモ再生関係用プロック設定
// ------------------------------------
// とりあえずダミープロック
proc null_proc {}

proc デモキャンセル {
	// ポーズオフ
	command メニュー設定 -p off

	// ゲームオーバーキャンセルしてたらその後見せない為のフラグ立て。
	if($s:直前のエリア == w04a){
		print '$f:w04a_ゲームオーバーキャンセルした'

		eval ($f:w04a_ゲームオーバーキャンセルした = 1)
		command varsave $f:w04a_ゲームオーバーキャンセルした

	} else if($s:直前のエリア == w04b){
		print '$f:w04b_ゲームオーバーキャンセルした'

		eval ($f:w04b_ゲームオーバーキャンセルした = 1)
		command varsave $f:w04b_ゲームオーバーキャンセルした

	} else {
		print '$f:w04c_ゲームオーバーキャンセルした'

		eval ($f:w04c_ゲームオーバーキャンセルした = 1)
		command varsave $f:w04c_ゲームオーバーキャンセルした

	}

	// プログラムで起動しているSEがあれば、ここで切る
	command セットサウンドコード -c d:SNG_FOUTS_S
	command セットサウンドコード -c d:SE_JOUCHUU_OFF

	command StreamStopAll
}

proc デモキャンセルチェックプロック {
	chara デモキャンセルチェック デモキャンセル \
		-p デモキャンセル
}

proc t14a系終了 {
	mesg デモキャンセルチェック デモキャンセル kill

	eval($f:global_polygon_demo = 0)

	chara delay ディレイ \
		-time 1 \
		-exec{
				if(!$f:d14t_gover_played) {
					eval($f:d14t_gover_played = 1)
					restart
				}
			}
}

proc t14a系終了後リスタート後プロック {
		@ゲームオーバー開始処理プロック
		eval($f:d14t_gover_played = 0)
}

// ゲームオーバー開始処理
proc ゲームオーバー開始処理プロック {
	command ゲームオーバー処理開始 \
		-exec {

			print 'ゲームオーバー'
//			command プレイヤーモーション振動ＯＦＦ

			command メニュー設定 \
				-gage off \
				-radar off \
				-subwin off \
				-radio off \
				-pause off

			%StreamStop $i:STREAM_ID
			command ゲームオーバー処理終了

		}
}

proc シネマスクリーンセット  {
	chara シネマスクリーン シネマ \
		-top d:CINEMA_BELT_UPPER \
		-bottom d:CINEMA_BELT_LOWER \
		-ftime 60	//デフォルト値（ゼロは駄目）
	mesg シネマスクリーン シネマ フェードアウト 1
}


// エフェクト設定
// ------------------------------------
proc エフェクト設定 {
	chara フォグ fog \
		 -c 24 30 24 \
		 -n 2200 \
		 -f 53600
}

// 設置オブジェクト
// ------------------------------------
proc 第三船倉セット {
	chara プットオブジェ third_hold \
		-m w04c1 \
		-r 0 0 0 \
		-p 0 0 0 \
		-l d:STAGE_LT2 \
		-f 0x0040 \
		-s 100 100 100

	mesg プットオブジェ third_hold off
}

proc 第三船倉オフ {
	mesg プットオブジェ third_hold off
	mesg プットオブジェ MetalGear_Ray off
	mesg プットオブジェ MetalGear_Ray_canopy off
}

proc 第三船倉オン {
	mesg プットオブジェ third_hold on
	mesg プットオブジェ MetalGear_Ray on
	mesg プットオブジェ MetalGear_Ray_canopy on
}

proc メタルギア零設定 {
	chara プットオブジェ MetalGear_Ray \
		-m ray_w04c1 \
		-r 0 0 0 \
		-p 0 0 0 \
		-l d:STAGE_LT2 \
		-s 100 100 100
	chara プットオブジェ MetalGear_Ray_canopy \
		-m ray_canopy_w04c1_mt \
		-r 0 0 0 \
		-p 0 0 0 \
		-l d:STAGE_LT2 \
		-s 100 100 100 \
		-f 1

	mesg プットオブジェ MetalGear_Ray off
	mesg プットオブジェ MetalGear_Ray_canopy off
}

proc 第二船倉セット {
	@w04bのプリシェード平環光セット
	chara プットオブジェ second_hold \
		-m w04b1 \
		-r 0 0 0 \
		-p 0 0 28500 \
		-l d:STAGE_LT2 \
		-s 100 100 100
		mesg プットオブジェ second_hold off
	@w04cのプリシェード平環光セット
}

proc 第二船倉オフ {
	mesg プットオブジェ second_hold off
}

proc 第二船倉オン {
	mesg プットオブジェ second_hold on
}


// 第一船倉
proc 第一船倉セット {
	@w04aのプリシェード平環光セット
	chara プットオブジェ first_hold \
		-m w04a1 \
		-r 0 0 0 \
		-p 0 0 (28500+28500) \
		-l d:STAGE_LT2 \
		-s 100 100 100
	mesg プットオブジェ first_hold off
	@w04cのプリシェード平環光セット
}
proc 第一船倉オフ {
	mesg プットオブジェ first_hold off
}
proc 第一船倉オン {
	mesg プットオブジェ first_hold on
}


// ドアオブジェクト
// ------------------------------------

proc ドア設置／船倉１−通路１ {
	print 'ドア設置！！！！'

	chara プットオブジェ 右舷ドア１１ \
		-m w04_dr \
		-r 0,0,0 \
		-p 7250,-17000,(-24050+28500+28500) \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f (d:PUT_OBJ_NO_PRESHADE | d:PUT_OBJ_CALC_LIGHT)



	chara プットオブジェ 左舷ドア１１ \
		-m w04_dr \
		-r 0,0,0 \
		-p -8750,-17000,(-24050+28500+28500) \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f (d:PUT_OBJ_NO_PRESHADE | d:PUT_OBJ_CALC_LIGHT)



	chara プットオブジェ 右舷上部ドア１１ \
		-m w04_dr \
		-r 0,0,0 \
		-p 10250,-9000,(-24050+28500+28500) \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f (d:PUT_OBJ_NO_PRESHADE | d:PUT_OBJ_CALC_LIGHT)



	chara プットオブジェ 左舷上部ドア１１ \
		-m w04_dr \
		-r 0,0,0 \
		-p -11750,-9000,(-24050+28500+28500) \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f (d:PUT_OBJ_NO_PRESHADE | d:PUT_OBJ_CALC_LIGHT)




}



proc ドア設置／通路２−船倉３ {
// 第三船倉にあるドア
	chara プットオブジェ 右舷ドア２３ \
		-m w04_dr \
		-r 0,2048,0 \
		-p 8750,-17000,50 \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0010


	chara プットオブジェ 左舷ドア２３ \
		-m w04_dr \
		-r 0,2048,0 \
		-p -7250,-17000,50 \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0010


	chara プットオブジェ 右舷上部ドア２３ \
		-m w04_dr \
		-r 0,2048,0 \
		-p 11750,-9000,50 \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0010

	chara プットオブジェ 左舷上部ドア２３ \
		-m w04_dr \
		-r 0,2048,0 \
		-p -10250,-9000,50 \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0010


// 第二船倉右手前（第一船倉側）
	chara プットオブジェ 右舷ドア１２ \
		-m w04_dr \
		-r 0,2048,0 \
		-p 8750,-17000,(50+28500) \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0020

	chara プットオブジェ 右舷上部ドア１２ \
		-m w04_dr \
		-r 0,2048,0 \
		-p 11750,-9000,(50+28500) \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0020
}



