proc 木箱鉄箱水飛沫セット {
	// w00b 相当部分のエフェクト各種
	chara ライン水飛沫 鉄箱木箱水飛沫群 \
		-n 5 \
		-l 5000 \
		-d 1 1025 50 64 -10250 13100 (-19000+500+125)  -9750 13100 (-19000+500+125) \
		   1 1025 50 96 -10000 13100 (-16000+500) -10000 13100 (-16000+500) \
		   1 1025 50 96 -10000 13100 (-14800+500) -10000 13100 (-14800+500) \
		   1 1025 50 96 -11400 13100 -12000       -11400 13100 -12000 \
