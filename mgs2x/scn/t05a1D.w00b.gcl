		   2 20 5 64 -19850 13750 -19950 -19850 13750 -14150 \
		   2 20 5 64 -19850 13750 -14150 -12000 13750 -12100 \
		   1 20 5 64 -11950 13000 -12000 -11950 13000 -9100 \
		   1 20 5 64 11950 13000 -12000 11950 13000 -9100 \
		   2 20 5 64 -11950 13000 -9100 -6950 13000 -9100 \
		   2 20 5 64 11950 13000 -9100 6950 13000 -9100 \
		   1 20 5 64 -6950 13000 -9100 -6950 13000 -7100 \
		   1 20 5 64 6950 13000 -9100 6950 13000 -7100 \
		   3 20 5 64 -6950 13000 -7100 6950 13000 -7100 \
		   1 1050 15 96 -13000 13750 -18150 -13000 13750 -18150 \
		   1 520 15 96 -13750 15000 -14500 -13750 15000 -14000

	chara ライン水飛沫 上の柵水飛沫 \
		-n 4 \
		-d 1 20 5 64 -5925 16000 -19875 -4025 16000 -20850 \
		   1 20 5 64 -5925 16000 -19875 -5925 16000 -15100 \
