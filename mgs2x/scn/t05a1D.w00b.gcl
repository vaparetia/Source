proc ホロセット {

	// 旧d00a5
	if($w:t_story < d:ST_T05a1Dオルガ戦前ポリゴンデモ終了) {
		chara プットホロオブジェ ホロ \
			-c horo1 \
//			-m horo_def horo_bo horo_bod horo_box horo_lo horo_lod horo_lox horo_ro horo_rod horo_rox \
			-m horo_def horo_bod horo_bod horo_bod horo_lod horo_lod horo_lod horo_rod horo_rod horo_rod \
			-p -17000,12750,-17000 \
			-r 0

	// 旧d00a6
	} else {
		if( $i:w00b_ホロステータス != d:holo_flag_t:ORGA_HOL_PLY_GONL && \
			$i:w00b_ホロステータス != d:holo_flag_t:ORGA_HOL_PLY_GONR && \
			$i:w00b_ホロステータス != d:holo_flag_t:ORGA_HOL_ORG_GONE && \
			$i:w00b_ホロステータス != -1 ) {

		chara プットホロオブジェ ホロ \
			-c horo1 \
			-m horo_def horo_bo horo_bod horo_box horo_lo horo_lod horo_lox horo_ro horo_rod horo_rox \
			-p -17000,12750,-17000 \
			-r 0

			if($i:w00b_ホロステータス == d:holo_flag_t:ORGA_HOL_PLY_FRER || \
			   $i:w00b_ホロステータス == d:holo_flag_t:ORGA_HOL_PLY_OPNR ) {
					mesg プットホロオブジェ ホロ 右開いている
			}
			if($i:w00b_ホロステータス == d:holo_flag_t:ORGA_HOL_PLY_FREL || \
			   $i:w00b_ホロステータス == d:holo_flag_t:ORGA_HOL_PLY_OPNL ) {
					mesg プットホロオブジェ ホロ 左開いている
			}
			if($i:w00b_ホロステータス == d:holo_flag_t:ORGA_HOL_ORG_FREE || \
			   $i:w00b_ホロステータス == d:holo_flag_t:ORGA_HOL_ORG_OPEN ) {
					mesg プットホロオブジェ ホロ オルガ開いている
			}
		} else {
			// ホロがなければ、これを
			// ホロ下IRセンサーの水飛沫
			chara ライン水飛沫 IR水飛沫 \
				-n 6 \
				-d 1 300 5 64  -17350 14300 -17650  -17350 14300 -15650 \
				   1 300 5 32  -17350 14200 -17950  -17350 14200 -18400 \

				   1 300 5 64  -16600 13800 -18350  -16600 13800 -16350 \
				   1 300 5 32  -16600 13700 -15600  -16600 13700 -16050 \

				   1 300 5 32  -17000 14000 -17650  -16500 14000 -17650 \
				   1 300 5 32  -17000 14000 -16350  -16500 14000 -16350

		}
	}

	chara プットオブジェ IRセンサー \
		-m obs_irs \
		-r 0 0 0 \
		-p 0 0 0  \
		-l d:STAGE_LT2_2 \
		-s 100 100 100

	chara プットオブジェ オルガ隠れ場所_ロッカー \
		-m obs_box1 \
		-r 0 0 0 \
		-p 0 0 0  \
		-l d:STAGE_LT2_2 \
		-s 100 100 100
	chara プットオブジェ オルガ隠れ場所_小箱 \
		-m obs_box2 \
		-r 0 0 0 \
		-p 0 0 0  \
		-l d:STAGE_LT2_2 \
		-s 100 100 100
}

/* ホロ飛ばし実験（調整用） */
//mesg プットホロオブジェ ホロ 右飛ばす
//eval($i:w00b_ホロステータス = d:holo_flag_t:ORGA_HOL_PLY_FRER)
//eval($i:w00b_ホロステータス = d:holo_flag_t:ORGA_HOL_PLY_OPNR)

//mesg プットホロオブジェ ホロ 左飛ばす
//eval($i:w00b_ホロステータス = d:holo_flag_t:ORGA_HOL_PLY_FREL)
//eval($i:w00b_ホロステータス = d:holo_flag_t:ORGA_HOL_PLY_OPNL)

//mesg プットホロオブジェ ホロ オルガ飛ばす
//eval($i:w00b_ホロステータス = d:holo_flag_t:ORGA_HOL_ORG_FREE)
//eval($i:w00b_ホロステータス = d:holo_flag_t:ORGA_HOL_ORG_OPEN)


// デモの中でホロを飛ばすためのプロック
/*
	箱よりかかり t06a1D
	完全状態からは　1160フレーム目>ＯＫ（ただディレイは -t 0 だと落ちるので 1 をセット）
	片方開いているのは、それプラス25フレーム（早く飛ぶので）。
*/
proc t06a1D_ホロ飛ばし_1160fr {
	command マップ設定 オルガ戦ステージ -s {

		if($i:w00b_ホロステータス == d:holo_flag_t:ORGA_HOL_PLY_FRER || \
		   $i:w00b_ホロステータス == d:holo_flag_t:ORGA_HOL_PLY_OPNR ) {
			eval($i:t06a_tarp_dly_time = 25)
		} else if($i:w00b_ホロステータス == d:holo_flag_t:ORGA_HOL_PLY_FREL || \
		   $i:w00b_ホロステータス == d:holo_flag_t:ORGA_HOL_PLY_OPNL ) {
			eval($i:t06a_tarp_dly_time = 25)
		} else if($i:w00b_ホロステータス == d:holo_flag_t:ORGA_HOL_ORG_FREE || \
		   $i:w00b_ホロステータス == d:holo_flag_t:ORGA_HOL_ORG_OPEN ) {
			eval($i:t06a_tarp_dly_time = 25)
		} else {
			eval($i:t06a_tarp_dly_time = 1)
		}

		chara delay aaa -time (($i:t06a_tarp_dly_time)*2) -exec {
			if($i:w00b_ホロステータス == d:holo_flag_t:ORGA_HOL_PLY_FRER || \
			   $i:w00b_ホロステータス == d:holo_flag_t:ORGA_HOL_PLY_OPNR ) {
					mesg プットホロオブジェ ホロ 右飛ばす
			} else if($i:w00b_ホロステータス == d:holo_flag_t:ORGA_HOL_PLY_FREL || \
			   $i:w00b_ホロステータス == d:holo_flag_t:ORGA_HOL_PLY_OPNL ) {
					mesg プットホロオブジェ ホロ 左飛ばす
			} else if($i:w00b_ホロステータス == d:holo_flag_t:ORGA_HOL_ORG_FREE || \
			   $i:w00b_ホロステータス == d:holo_flag_t:ORGA_HOL_ORG_OPEN ) {
					mesg プットホロオブジェ ホロ オルガ飛ばす
			} else {
					mesg プットホロオブジェ ホロ 飛ばし再生		//飛ばし再生 次のモーションに移る
					mesg プットホロオブジェ ホロ 左開く			// 飛ばしモーションはとりあえず何でもＯＫ。
			}
		}

	} // 「command マップ設定 オルガ戦ステージ」の閉じカッコ

}

/*
	柵よりかかり t06a2D
	完全状態からは　1000フレーム目>ＯＫ
	オルガ飛ばし>柵にめり込むので早めに飛ばす
	左飛ばし　1000フレーム目>ＯＫ
	右飛ばし　1000フレーム目>ＯＫ
*/
proc t06a2D_ホロ飛ばし_1000fr {
	command マップ設定 オルガ戦ステージ -s {

		if($i:w00b_ホロステータス == d:holo_flag_t:ORGA_HOL_PLY_FRER || \
		   $i:w00b_ホロステータス == d:holo_flag_t:ORGA_HOL_PLY_OPNR ) {
				eval($i:t06a_tarp_dly_time = 25)
		} else if($i:w00b_ホロステータス == d:holo_flag_t:ORGA_HOL_PLY_FREL || \
		   $i:w00b_ホロステータス == d:holo_flag_t:ORGA_HOL_PLY_OPNL ) {
				eval($i:t06a_tarp_dly_time = 1)
		} else if($i:w00b_ホロステータス == d:holo_flag_t:ORGA_HOL_ORG_FREE || \
		   $i:w00b_ホロステータス == d:holo_flag_t:ORGA_HOL_ORG_OPEN ) {
				eval($i:t06a_tarp_dly_time = 40)
		} else {
				eval($i:t06a_tarp_dly_time = 1)
		}

		chara delay aaa -time (($i:t06a_tarp_dly_time)*2) -exec {
			if($i:w00b_ホロステータス == d:holo_flag_t:ORGA_HOL_PLY_FRER || \
			   $i:w00b_ホロステータス == d:holo_flag_t:ORGA_HOL_PLY_OPNR ) {
					mesg プットホロオブジェ ホロ 右飛ばす
			} else if($i:w00b_ホロステータス == d:holo_flag_t:ORGA_HOL_PLY_FREL || \
			   $i:w00b_ホロステータス == d:holo_flag_t:ORGA_HOL_PLY_OPNL ) {
					mesg プットホロオブジェ ホロ 左飛ばす
			} else if($i:w00b_ホロステータス == d:holo_flag_t:ORGA_HOL_ORG_FREE || \
			   $i:w00b_ホロステータス == d:holo_flag_t:ORGA_HOL_ORG_OPEN ) {
					mesg プットホロオブジェ ホロ オルガ飛ばす
			} else {
					mesg プットホロオブジェ ホロ 飛ばし再生		//飛ばし再生 次のモーションに移る
					mesg プットホロオブジェ ホロ 左開く			// 飛ばしモーションはとりあえず何でもＯＫ。
			}
		}

	} // 「command マップ設定 オルガ戦ステージ」の閉じカッコ

}


