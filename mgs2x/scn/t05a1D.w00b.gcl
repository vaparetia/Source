		-r 0 -200 \	// Ｘ回転、Ｙ回転 の２つ
		-w 550 50 550	// 回転前のＸ幅、Ｙ幅（厚みに相当）、Ｚ幅 の ３つ
	chara 斜め回転床水飛沫 飛沫鉄箱３ \
		-n 2 \			// ３２枚の何倍？
		-p -10600 14200 -12200 \	// ＸＹＺの ３つ
		-r 0 800 \	// Ｘ回転、Ｙ回転 の２つ
		-w 550 50 550	// 回転前のＸ幅、Ｙ幅（厚みに相当）、Ｚ幅 の ３つ
	chara 斜め回転床水飛沫 飛沫鉄箱６ \
		-n 2 \			// ３２枚の何倍？
		-p -11300 13100 (-15000+500) \	// ＸＹＺの ３つ
		-r 0 (1024/6) \	// Ｘ回転、Ｙ回転 の２つ
		-w 550 50 550	// 回転前のＸ幅、Ｙ幅（厚みに相当）、Ｚ幅 の ３つ

	chara ライン水飛沫 下の柵水飛沫 \
		-n 13 \
		-d \
		   2 20 5 64 -12000 13000 -19900 -6000 13000 -19900 \
