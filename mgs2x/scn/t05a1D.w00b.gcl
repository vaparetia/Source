// キャスティングシアター対応。
#include "lowpoly.h"

@ローポリ設定




// マップ
// ------------------------------------
chara マップ オルガ戦ステージ -h d:STAGE_HZX -l d:STAGE_LT2_2

// マップ設定
// ------------------------------------
command マップ設定 オルガ戦ステージ -s {

print 'main_000'

//	デモ環境かゲーム環境かで起動を読み分ける。
// ------------------------------------
#if d:MGS2_DEMO

// ホロ状態を見るためのフラグ
#include "../source/user/morita/orga/include/orga_flag.h"

	// --------------------------------------------------------
	// デバッグ用
	// 旧d00a5を表示したい場合
	eval($w:t_story = d:ST_T05a1Dオルガ戦前ポリゴンデモ終了-10)

	// --------------------------------------------------------
	// 旧d00a6を表示したい場合
//	eval($w:t_story = d:ST_T05a1Dオルガ戦前ポリゴンデモ終了)

	/* デバッグ用 */
	proc デバッグ用_ホロ左前ひも外れ状態セット {
		mesg プットホロオブジェ ホロ 左開いている
	}
	proc デバッグ用_ホロ右前ひも外れ状態セット {
		mesg プットホロオブジェ ホロ 右開いている
	}
	proc デバッグ用_ホロオルガ側ひも外れ状態セット {
		mesg プットホロオブジェ ホロ オルガ開いている
	}
	proc デバッグ用_ホロ無い状態セット {
		eval($i:w00b_ホロステータス = -1)
	}
	/* 以上、デバッグ用 */


	/* 以下、デバッグ用。一度に一つだけ使うこと。
	何も選択しなければ、ホロは完全な状態で出る */
//	@デバッグ用_ホロ左前ひも外れ状態セット
//	@デバッグ用_ホロ右前ひも外れ状態セット
//	@デバッグ用_ホロオルガ側ひも外れ状態セット
//	@デバッグ用_ホロ無い状態セット
	/* 以上はデバッグ用 */

	// --------------------------------------------------------

chara デモアクトデバッグ demodebug  -i t:t05a1D -d 't05a1D' -l  -s 't05a1D'  \
		-p  ゆっくり止む雨セット ざっと降り出す雨セット \
			カメラ雨オフ カメラ雨オン \
			ウイング底抜け防止モデル表示 ウイング底抜け防止モデル消去 \
			川岸マンハッタンフォグ無効 川岸マンハッタンフォグ有効 \
			蒼い月ゴルルコセット 蒼い月オルガセット \
			ゴルルコ月フォグ有効 ゴルルコ月フォグ無効 \
			オルガ月フォグ有効 オルガ月フォグ無効 \
			オルガ役者テロップＭＡＸ呼び出し \
			空の高さ変化 \
			スポット影のライトオフ \
			t06a1D_ホロ飛ばし_1160fr t06a2D_ホロ飛ばし_1000fr

		//chara デモアクトデバッグ demodebug  -i t:t05a2D -d 't05a2D' -l  -s 't05a2D : pre_orga_2nd_half' -e 120 -v 1


#else

	// プロックのデモキャンセルは共用
	proc デモキャンセル {
		// プログラムで起動しているSEを切る（ホロのバタバタ音）
		command セットサウンドコード -c d:SNG_FOUTS_S
		command セットサウンドコード -c d:SE_JOUCHUU_OFF
		command StreamStopAll
	}

	// ロードネクストはプロック名を共用
	proc ld_next_stage {
		if ($f:ローポリ劇場フラグ == d:TRUE) {
			// ローポリ劇場中
			@mv_lowpoly

		} else {
		// 通常ゲーム中
			mesg デモキャンセルチェック デモキャンセル kill

			if($w:t_story < d:ST_T05a1Dオルガ戦前ポリゴンデモ終了) {
				eval($w:t_story = d:ST_T05a1Dオルガ戦前ポリゴンデモ終了)

				chara delay ディレイ \
					-time 1 \
					-exec{
						@mv_w01e_w00b_0
					}

			} else if((d:ST_T05a1Dオルガ戦前ポリゴンデモ終了 <= $w:t_story) && \
					($w:t_story < d:ST_T06a1Dオルガ戦勝利後ポリゴンデモ終了)) {
				eval($w:t_story = d:ST_T06a1Dオルガ戦勝利後ポリゴンデモ終了)

#if 1
				chara サウンドマネージャー ＳＤマネ -pak 0
				//サウンドマネージャーだけ書くと雨・風ＳＥがなってしまうので、下でそれらのプロックをはずしてやる。

				command セットサウンドコード -c d:SNG_PLAY_06		//ＢＧＭ雨音

				eval($w:t_story = d:ST_T06b1Rオルガ戦勝利後無線機デモ開始)

				@rt_強制ＣＡＬＬ_T_06b1Rオルガ戦勝利後無線機デモ

#else
				restart // オルガ戦終了後強制無線に飛ぶ。

#endif
			}

		}


	}

	// ストーリーフラグを見て、一つのgclで二つのデモを呼び分ける
	if($w:t_story < d:ST_T05a1Dオルガ戦前ポリゴンデモ開始) {
		chara デモキャンセルチェック デモキャンセル \
			-p デモキャンセル

		eval($w:t_story = d:ST_T05a1Dオルガ戦前ポリゴンデモ開始)
		print '$w:t_story = d:ST_T05a1Dオルガ戦前ポリゴンデモ開始'

		@デモモデル差し替え処理
		proc デモ再生_t05a1D {
			chara demo デモ再生 \
				-i t:t05a1D \			// ストリーミング用t:シンボル pre_orga_1st_half (前半)
				-p  ゆっくり止む雨セット ざっと降り出す雨セット \
					カメラ雨オフ カメラ雨オン \
					ウイング底抜け防止モデル表示 ウイング底抜け防止モデル消去 \
					川岸マンハッタンフォグ無効 川岸マンハッタンフォグ有効 \
					蒼い月ゴルルコセット 蒼い月オルガセット \
					ゴルルコ月フォグ有効 ゴルルコ月フォグ無効 \
					オルガ月フォグ有効 オルガ月フォグ無効 \
					オルガ役者テロップＭＡＸ呼び出し \
					スポット影のライトオフ \
				-next ld_next_stage			// 終了時に呼び出されるproc
		}

		@デモ再生_t05a1D

	} else if((d:ST_T05a1Dオルガ戦前ポリゴンデモ終了 <= $w:t_story) && \
				($w:t_story < d:ST_T06a1Dオルガ戦勝利後ポリゴンデモ開始)){

		#if 0
			proc 体験版トゥービーコンティニュード {
				if(!$f:w00b_体験版_to_be_con) {

					command セットサウンドコード -c d:SNG_FOUTS_S
					command セットサウンドコード -c d:SE_JOUCHUU_OFF

					eval($f:w00b_体験版_to_be_con = 1) // < varinit の中で０に初期化する

					//add shibata
					//ポーズだめだめ
					command メニュー設定 -p off

					chara トゥービーコンテニュード to_be_continued \
						-proc クリアコードproc \
						-radio t:vc050501
				}
			}
		#endif

		chara デモキャンセルチェック デモキャンセル \
			-p デモキャンセル

		eval($w:t_story = d:ST_T06a1Dオルガ戦勝利後ポリゴンデモ開始)

		@デモモデル差し替え処理
		proc デモ再生_t06a1D_t06a2D {
			// オルガ死んだ場所によってデモを切り替える
			if($f:w00b_オルガ柵によりかかり) {
				// オルガ柵によりかかりデモ
				chara demo デモ再生 \
					-i t:t06a2D \			// ストリーミング用t:シンボル post_orga_down
					-p 	空の高さ変化 \
						スポット影のライトオフ \
						t06a2D_ホロ飛ばし_1000fr \
					-next ld_next_stage			// 終了時に呼び出されるproc

			} else {
				// オルガ箱に背もたれデモ
				chara demo デモ再生 \
					-i t:t06a1D \			// ストリーミング用t:シンボル post_orga_sleep
					-p 	空の高さ変化 \
						スポット影のライトオフ \
						t06a1D_ホロ飛ばし_1160fr \
					-next ld_next_stage			// 終了時に呼び出されるproc

			}
		}

		@デモ再生_t06a1D_t06a2D

/*
	// ST_T06b1Rオルガ戦勝利後無線機デモ開始
	} else {
		chara サウンドマネージャー ＳＤマネ -pak 0
		//サウンドマネージャーだけ書くと雨・風ＳＥがなってしまうので、下でそれらのプロックをはずしてやる。

		command セットサウンドコード -c d:SNG_PLAY_06		//ＢＧＭ雨音

		eval($w:t_story = d:ST_T06b1Rオルガ戦勝利後無線機デモ開始)

		@rt_強制ＣＡＬＬ_T_06b1Rオルガ戦勝利後無線機デモ
*/

	}


#endif

	//---------------------------------------------------------------
	// さわる必要のないもの。外したい場合は、行の先端に「//」を入れる。
	//---------------------------------------------------------------
	@常駐キャラ設定						// stdch.hで定義
print 'main_000_5'
	@カメラ雨セット
print 'main_001'
	@天球_新空_新雷セット
print 'main_002'
	@霧雨セット
print 'main_002_5'
	@岡嶋ブラーセット
print 'main_003'
	@タンカーセット
print 'main_004'
	@川岸マンハッタン衝突防止灯セット
	@川岸マンハッタンフォグ無効






print 'main_005'
	@シネマスクリーンセット
print 'main_005_2'
	@ウインドラスセット
print 'main_005_3'
	@ホロセット
print 'main_005_4'
	@木箱の上のIRS制御ボックスセット
	@鉄箱_木箱セット
	@床オブジェクトセット

	@ウイング底抜け防止モデルセット
	/* @ウイング底抜け防止モデル表示
	   @ウイング底抜け防止モデル消去 で
	   表示を制御 */

	@スポットライト関連セット
	@投光器水飛沫セット
	@床面映り込みスネーク
	if ($f:ローポリ劇場フラグ != d:TRUE) {
		@床面映り込みオルガ
	}

	//---------------------------------------------------------------
	// パラメータをいじれるもの。command.def参照。
	//---------------------------------------------------------------
print 'main_006'
	@風制御セット
print 'main_007'
	@雨初期セット
print 'main_008'
	@第一フォグセット
print 'main_010'
	@川岸のぼかし
print 'main_011'

	@タンカー上の各種エフェクトセット
	@木箱鉄箱水飛沫セット
	@床の水飛沫セット
// ４月（頃？）にステージのモデル変更。スネーク返し無くなったのでコメントアウト。
//	@スネーク返し水飛沫セット
	@ウイング南のエルード禁止柵水飛沫セット
	@船橋五階のクルー死体セット
	@水密ドアセット
	@窓雨セット
	@ピンライトセット
	@クレーン_旗_ワイヤーセット
	@レーダークルクル

	@波面セット


	//---------------------------------------------------------------
	// 以下はシナリオ班用。
	//---------------------------------------------------------------
print 'main_013'
print 'main_014'
print 'main_015'
print 'main_016'
print 'main_end'

/* デモ中ホロ飛ばしプロックの起動タイミング調整で使用（010501時点未使用）
	chara delay delay -t (1000*2) -p 戦後デモ中ホロ飛ばし
*/

	@スクリーンショット使用

} // <command マップ設定 オルガ戦ステージ>の閉じカッコ

// ====================================
// 初期マップ表示
// ====================================
	command マップ表示 -show オルガ戦ステージ

// マップshowの後でセットすること。
	@キャラクタ専用ライトセット

// 起動時フェードイン
#if d:起動時フェードイン
	@ロード時フェードイン
#endif


// >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>

// エフェクト関係
// ------------------------------------
proc 天球_新空_新雷セット {
	chara 天球 背景

	chara 新空 new_sky_default \
		    -m w00_sky

	chara 新雷フラッシュ thunder
}

proc 空の高さ変化 {
	// 最初の空を消す
	mesg 新空 new_sky_default 殺す

	// 高い空セット
	chara 新空 new_sky_high \
		    -u 1 \
		    -h 880000 \ // ここの値を
		    -m w00_sky
}

proc 蒼い月ゴルルコセット {
	chara ３Ｄスプライト表示 蒼い月1 \
		-tex moon_w00_alp \
		-pos -31000 31700 183000 \		// ポジション
		-size 5000 5000 \	// サイズ（表示時の実寸）
		-mode (d:GSPRT_MODE_ALPHA)
}

proc ゴルルコ月フォグ有効 {
print 'ゴルルコ月フォグ有効'
	mesg ３Ｄスプライト表示 蒼い月1 ＯＮ
}

proc ゴルルコ月フォグ無効 {
	mesg ３Ｄスプライト表示 蒼い月1 ＯＦＦ
}

proc 蒼い月オルガセット {
	chara ３Ｄスプライト表示 蒼い月2 \
		-tex moon_w00_alp \
		-pos -200000 70000 -26000 \		// ポジション
		-size 28000 28000 \	// サイズ（表示時の実寸）
		-mode (d:GSPRT_MODE_ALPHA)
}

proc オルガ月フォグ有効 {
	mesg ３Ｄスプライト表示 蒼い月2 ＯＮ
}

proc オルガ月フォグ無効 {
	mesg ３Ｄスプライト表示 蒼い月2 ＯＦＦ
}


proc 霧雨セット {
	chara 霧雨 霧雨
}

proc 岡嶋ブラーセット {
	chara ブラー okajibura
}

proc タンカーセット {
	chara プットオブジェ タンカー \
		-m w00b \
		-r 0 0 0 \
		-p 0 0 0 \
		-s 100 100 100 \
		-l d:STAGE_LT2_2 \
		-f 0x0010

	chara 煙突煙 smoke \
		-n 4 \
		-p	 4000,25000,-1000 \
			 4000,25000,-3000 \
			-4000,25000,-1000 \
			-4000,25000,-3000

	chara プットオブジェ 船首１ -m w00_f1 -r 0 0 0 -p 0 0 -180000  -l d:STAGE_LT2_1 -s 100 100 100
	chara プットオブジェ 船首２ -m w00_f2 -r 0 0 0 -p 0 0 -120000  -l d:STAGE_LT2_1 -s 100 100 100
	chara プットオブジェ 船首３ -m w00_f3 -r 0 0 0 -p 0 0 -60000  -l d:STAGE_LT2_1 -s 100 100 100
	chara プットオブジェ 船首４ -m w00_f4 -r 0 0 0 -p 0 0 0  -l d:STAGE_LT2_1 -s 100 100 100
}


proc 川岸マンハッタン衝突防止灯セット {
	chara マンハット赤灯1 赤灯1
	chara マンハット赤灯2 赤灯2
	chara ブルックリン赤灯 赤灯
}

proc 川岸マンハッタンフォグ無効 {
	mesg マンハッタンフォグ有効 トランスファー 殺す
	mesg ブルックリンフォグ有効 ブルックリン 殺す

	chara マンハッタン トランスファー \
		-l d:STAGE_LT2_2
	chara ブルックリン ブルックリン \
		-l d:STAGE_LT2_2
	chara マンハット黄灯 黄灯
}

proc 川岸マンハッタンフォグ有効 {
	mesg マンハッタン トランスファー 殺す
	mesg ブルックリン ブルックリン 殺す

	chara マンハッタンフォグ有効 トランスファー \
		-l d:STAGE_LT2_2
	chara ブルックリンフォグ有効 ブルックリン \
		-l d:STAGE_LT2_2
}

proc 風制御セット {
	chara 風制御 wind \
		-i 100 \			// 通常風速のＭＡＸ値
		-j 300 \			// 突風風速のＭＡＸ値
		-r -1024 1024 0 \	// 通常風の方向（0 0 0 で真下に向かって吹く）
		-a 4 \				// 方向のランダム幅（4096で360度を表す）
		-b 300 \			// 突風頻度（何フレームに一回（目安））
		-c 150				// 突風持続時間のＭＡＸ値（フレーム数）
}

proc 雨初期セット {
	chara 雨 rain \
		-n 16 \		// 量
		-c 128 		// 輝度
}

proc 雨止みだした１ {
	mesg 雨 rain パーセンテージ 40
	chara delay delay -t 64 -p 雨止みだした２
}

proc 雨止みだした２ {
	mesg 雨 rain パーセンテージ 20
	@全水飛沫オフ
	chara delay delay -t 64 -p 雨止みだした３
}

proc 雨止みだした３ {
	mesg 雨 rain パーセンテージ 10
	chara delay delay -t 48 -p 雨止みだした４
}

proc 雨止みだした４ {
	mesg 雨 rain パーセンテージ 5
	chara delay delay -t 48 -p 雨止みました
}

proc 雨止みました {
	mesg 雨 rain パーセンテージ 0
}

proc 雨降り出した１ {
	mesg 雨 rain パーセンテージ 20
	chara delay delay -t 24 -p 雨降り出した２
}

proc 雨降り出した２ {
	mesg 雨 rain パーセンテージ 40
	@全水飛沫オン

	chara delay delay -t 16 -p 雨降り出した３
}

proc 雨降り出した３ {
	mesg 雨 rain パーセンテージ 80
	chara delay delay -t 16 -p 雨降り出した４
}

proc 雨降り出した４ {
	mesg 雨 rain パーセンテージ 100
}

// 雨ゆっくり止んでゆく
proc ゆっくり止む雨セット {
	mesg 雨 rain パーセンテージ 80
	chara delay delay -t 64 -p 雨止みだした１
}

// 雨降り出す
proc ざっと降り出す雨セット {
	mesg 雨 rain パーセンテージ 10
	chara delay delay -t 24 -p 雨降り出した１
}

// カメラ雨のオフ
proc カメラ雨オフ {
	mesg カメラ雨 カメラ雨 カメラ前水飛沫出っ放し
	mesg カメラ雨 カメラ雨 カメラ前水飛沫制御オン
}

// カメラ雨のオン
proc カメラ雨オン {
	mesg カメラ雨 カメラ雨 カメラ前水飛沫出っ放し
	mesg カメラ雨 カメラ雨 カメラ前水飛沫制御オフ
}

proc 波面セット {
print 'wave_set'

		//中心位置から10ユニットずつ前後左右に広がります。(デフォルト 0,-2000, 0)
		//うねり周期は、0 厳禁。周期なので大きいほど遅くなります。(デフォルト 256)
		chara 波面 wave \
			-p -0,-6000,-0 \	// 中心位置
			-s 128 \		// うねりの周期

		//ここから波涛
			-n 3 \			// 波濤の数
			-no_sound \   // 音を鳴らしたくない
			-w 5 5 \
			-b 	     0,200,  20500,6,    0,  0 \	// 並び順： posx, posy, posz, size, roty, alpha
				 18000,500,-255000,8, 1251,-50 \
				-18000,500,-245000,8,-1251,-50 \
			-x 0,-135500 20000,132500		// (前2つ)非表示領域位置：中心座標 ／ (後2つ)非表示領域：幅/奥行
			// posx posz 波涛出現位置
			// posy      波涛発生高さの条件
			// size      波涛の高さ
			// roty      波涛の向き（4096 = 360deg）
			// alpha     波涛のα調整（-薄い  +濃い）

		//波面自体
		chara 嵐の川波 高波 \
			-tex wave wave06 wave09_alp_ovl \
			-dir 100,-20,100 \		// ローカル並行光ベクトル
			-color 160,160,160 \	// 平行光ＲＧＢ
			-ambient 10,10,10 \		// 環境光ＲＧＢ
			-pos -50000,-4000,10000

print 'wave_set_end!!!!!!!!!!'

}

proc 第一フォグセット {
	chara フォグ 霧 \
		 -c 16 32 27 \		// ＲＧＢ
		 -n -5000 \			// ニア値
		 -f 1600000			// ファー値
}

// 値は自由にいじってください。
proc 第二フォグセット {
	chara フォグ 霧 \
		 -c 121 183 158 \		// ＲＧＢ
		 -n -10000 \			// ニア値
		 -f 1600000			// ファー値
}

proc 川岸のぼかし {
	chara 遠景ぼかし far_blur \
		-plane	2 \			// 枚数
		-near	50000 \		// ニア値
		-far	100000 \	// ファー値
		-enable
}

proc キャラクタ専用ライトセット {

	// 旧d00a5
	if($w:t_story < d:ST_T05a1Dオルガ戦前ポリゴンデモ終了) {

		chara 環境光 アンビ \
			 -c 33,53,35

		chara 平行光 パラ \
			 -c 70,230,214 \
			 -p 1790 -3573 898

	} else {

		#if 1

			chara 環境光 アンビ \
				 -c 33,53,35

			chara 平行光 パラ \
				 -c 70,230,214 \
				 -p 1790 -3573 898

		#else

			// ホロの状態によって、アニメーションするキャラクタへの平行・環境光
			// を変える。
			// もしやる場合、他のシェードモデル全般に影響するので注意！！

			// ホロ有り
			if( $i:w00b_ホロステータス != d:holo_flag_t:ORGA_HOL_PLY_GONL && \
				$i:w00b_ホロステータス != d:holo_flag_t:ORGA_HOL_PLY_GONR && \
				$i:w00b_ホロステータス != d:holo_flag_t:ORGA_HOL_ORG_GONE && \
				$i:w00b_ホロステータス != -1 ) {

				// ホロ右開いている
				if($i:w00b_ホロステータス == d:holo_flag_t:ORGA_HOL_PLY_FRER || \
				   $i:w00b_ホロステータス == d:holo_flag_t:ORGA_HOL_PLY_OPNR ) {
				   }

				// ホロ左開いている
				if($i:w00b_ホロステータス == d:holo_flag_t:ORGA_HOL_PLY_FREL || \
				   $i:w00b_ホロステータス == d:holo_flag_t:ORGA_HOL_PLY_OPNL ) {
				   }

				// ホロオルガ側開いている
				if($i:w00b_ホロステータス == d:holo_flag_t:ORGA_HOL_ORG_FREE || \
				   $i:w00b_ホロステータス == d:holo_flag_t:ORGA_HOL_ORG_OPEN ) {
				   }

			// ホロ無し
			} else {
			}

		#endif

	}

}

proc カメラ雨セット {
	//「プットテクスチャクロスフェードカメラ」と
	//「プットテクスチャクロスフェードカメラドア」の前にセットする
	chara カメラ雨 カメラ雨 \
		-l 0 \
		-i 1	// 不可視起動
	mesg カメラ雨 カメラ雨 オフ // < 不可視起動がうまく動かないので。
}

