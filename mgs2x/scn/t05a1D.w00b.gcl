// 各gclで必要なdefine
// ------------------------------------
// モード
#define		STAGE_TANKER	1		// 共通プロック切り分け用
#define		DEMO_STAGE		1		// デモステージかどうかで起動するキャラを切り分ける

// defines
// デバグ用各種
// -----------------------------------
#define PLAYER			スネーク
#define STAGE_KMS		d00a			// （未使用）
#define STAGE_HZX		w00b
#define STAGE_LT2_1		d00a			// 橋モデル用ライト（ほぼ未使用）
#define STAGE_LT2_2		w00b			// オルガ戦ステージ（左舷ウイング）用ライト



#define screen_shot				0 // スクリーンショット使用
#define 起動時フェードイン		0 // 起動時フェードイン使用
#define w00a使用				0 // w00aのデータを使用

#define 木箱ずらす				1 // 木箱を南へずらす（スネークのモーションにあわせ）

// includes
// ------------------------------------
#include "5sec_bfr_demo.h"
#include "vardef.h"
#include "story.h"
#include "sload.h"
#include "demo_vardef.h"
