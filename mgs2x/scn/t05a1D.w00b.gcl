proc 床の水飛沫セット {

	if($w:t_story < d:ST_T05a1Dオルガ戦前ポリゴンデモ終了) {
		// モノリス手前の床水飛沫
		chara 波紋 床水飛沫１ \
			-n 4 \
			-b -20000 -15750 -16000 -12000 \
			-h 12750

	} else {

		// 旧d00a6 で、オルガが低い箱にもたれ掛かっているデモではこちらを
		// ホロ手前側の床水飛沫
		chara 波紋 床水飛沫１ \
			-n 4 \
			-b -16000 -18250 -12000 -14500 \
			-h 12750

	}

	// ホロ脇の床水飛沫
	chara 波紋 床水飛沫２ \
		-n 6 \
		-b -20000 -20000 -12000 -18250 \
		-h 12750
}

