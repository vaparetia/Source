}

// オルガテロップ
proc オルガ役者テロップＭＡＸ呼び出し {
	@オルガ役者テロップセット	60 \
								120 \
								60 \
								jpn // jpn もしくは eng を指定
}

proc オルガ役者テロップセット \
	$:d00a5_オル役テロフェードインタイム \
	$:d00a5_オル役テロウェイト \
	$:d00a5_オル役テロフェードアウトタイム \
	$:d00a5_言語は何 \
	{
	// 言語によるテクスチャ変更
	if($:d00a5_言語は何 == jpn) {
		eval($s:d00a5_テクスチャ名 = sr17j_alp_ovl)
	} else {
		eval($s:d00a5_テクスチャ名 = sr17e_alp_ovl)
	}

	// オルガ役者テロップ
	chara ２Ｄスプライト表示 オルガ役者テロップ \
		-tri 	clear_code \
		-x 		$s:d00a5_テクスチャ名 \
		-pos 	90 250 \
//		-size	422 73 \
		-count  $:d00a5_オル役テロフェードインタイム \
				$:d00a5_オル役テロウェイト \
				$:d00a5_オル役テロフェードアウトタイム
}


// --------------------------------------------------------------
// クリアコード
// --------------------------------------------------------------
proc クリアコードproc {


//[0-2]ゲームレベル（3bit) 0(veasy) <-> 4(vhard)
	if($w:ゲーム設定 == d:LEVEL_VERYEASY){
		eval($i:クリアコード[ 0 ] = 0)
	}else if($w:ゲーム設定 == d:LEVEL_EASY){
		eval($i:クリアコード[ 0 ] = 1)
	}else if($w:ゲーム設定 == d:LEVEL_NORMAL){
		eval($i:クリアコード[ 0 ] = 2)
	}else if($w:ゲーム設定 == d:LEVEL_HARD){
		eval($i:クリアコード[ 0 ] = 3)
	}else{
		eval($i:クリアコード[ 0 ] = 4)
	}
print '$w:ゲーム設定'
print $w:ゲーム設定


//[3-4]レーダーON/OFF (2bit)レーダー表示/非表示フラグ
	eval( $i:クリアコード[ 0 ] = $i:クリアコード[ 0 ] | (($w:レーダーモード&0x03)<<3))
print '$w:レーダーモード'
print $w:レーダーモード

//[5-19]総プレイ時間(15bit)
//	精度は時分秒。18時間強程度まで計測。それ以上は計測不能として処理。
//	コンティニューでも時間はリセットしない。（ただしコンティニュー画面中はタイマー停止）

	// ビデオモードで時間変更
	#ifdef d:PAL
		#define TIMEBASE 50
	#else
		#define TIMEBASE 60
	#endif

	if($i:プレイタイム >= (0x8000*d:TIMEBASE)){
		eval($i:クリアコード[ 0 ] = $i:クリアコード[ 0 ] | (0x7fff << 5))
	}else{
		eval($i:クリアコード[ 0 ] = $i:クリアコード[ 0 ] | ((($i:プレイタイム/d:TIMEBASE) & 0x7fff) << 5))
	}
print '$i:プレイタイム'
print $i:プレイタイム



//[20-25]ゲームオーバー回数(6bit)
//	コンティニュー回数でもある。0から62回まで計測。それ以上は計測不能として処理。
	if($w:コンティニュー回数 >= 0x0040){
		eval($i:クリアコード[ 0 ] = $i:クリアコード[ 0 ] | (0x003f << 20))
	}else{
		eval($i:クリアコード[ 0 ] = $i:クリアコード[ 0 ] | (($w:コンティニュー回数 & 0x003f) << 20))
	}
print '$w:コンティニュー回数'
print $w:コンティニュー回数



//[0-7]危険モード回数(8bit)
//	危険モードに突入した回数。0から254回まで計測。それ以上は計測不能として処理。
	if($w:危険モード回数 >= 0x0100){
		eval($i:クリアコード[ 1 ] = 0x00ff)
	}else{
		eval($i:クリアコード[ 1 ] = ($w:危険モード回数 & 0x00ff))
	}
print '$w:危険モード回数'
print $w:危険モード回数



//[8-15]発砲数(8bit)
//USP、M9ともに発砲した総数を合算(区別の必要なし）。ハッピートリガかそうでないかが判る。
	if($w:発砲数 >= 0x0100){
		eval($i:クリアコード[ 1 ] = $i:クリアコード[ 1 ] | (0x00ff << 8))
	}else{
		eval($i:クリアコード[ 1 ] = $i:クリアコード[ 1 ] | (($w:発砲数 & 0x00ff) << 8))
	}
print '$w:発砲数'
print $w:発砲数



//[16-23]敵抹殺回数(8bit)
//気絶、麻酔は数えない。殺した敵兵数のみをカウント。256人まで。
	if($w:殺傷人数 >= 0x0100){
		eval($i:クリアコード[ 1 ] = $i:クリアコード[ 1 ] | (0x00ff << 16))
	}else{
		eval($i:クリアコード[ 1 ] = $i:クリアコード[ 1 ] | (($w:殺傷人数 & 0x00ff) << 16))
	}
print '$w:殺傷人数'
print $w:殺傷人数


//[24-28]累積ダメージ（5bit）
//0<->31
	eval($w:テンプ = $w:累積ダメージ * 30 / $w:体力最大)
	if($w:テンプ >= 0x0020){
		eval($i:クリアコード[ 1 ] = $i:クリアコード[ 1 ] | (0x001f << 24))
	}else{
		eval($i:クリアコード[ 1 ] = $i:クリアコード[ 1 ] | (($w:テンプ & 0x001f) << 24))
	}
//無くなりました
//[24-28]クリアした時間帯（5bit）
//PS2内蔵タイマーより、クリアした時間帯(精度は時間)。何時ぐらいにユーザーが遊んでいるのかを知る手がかりになる。
//	eval( $i:現在時刻 = `command 現在時刻取得` )
//	eval( $i:現在時刻 = ($i:現在時刻/60)&0x1f)
//	eval($i:クリアコード[ 1 ] = $i:クリアコード[ 1 ] | ($i:現在時刻 << 24))
//print '$i:現在時刻'
//print $i:現在時刻



//シード値設定


//	eval($i:クリアコード[ 3 ] = `command rand 63`)
	eval($i:クリアコード[ 3 ] = ( ( $i:プレイタイム + `command 現在時刻取得` ) % 63 ) );

	eval($i:クリアコード[ 2 ] = 1)


	chara クリアコード表示 クリアコード表示君 \
		-proc さよなら \
#ifdef JAPANESE
		-eng 0 \
#endif
#ifdef d:ENGLISH
		-eng 1 \
#endif
		-seed $i:クリアコード[ 3 ] \
		-data $i:クリアコード[ 0 ] 26 $i:クリアコード[ 1 ] 29


}

proc さよなら {
	//ポーズしていい
	command メニュー設定 -p on
	@mv_init_title_0
}


