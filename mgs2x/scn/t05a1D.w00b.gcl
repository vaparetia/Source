proc スポットライト関連セット {
	// 影投影用モデルと、それに影を投影するライトプログラム
	// 旧d00a5
	if($w:t_story < d:ST_T05a1Dオルガ戦前ポリゴンデモ終了) {
		chara スポットライト投影モデル 左舷投光器 \
			-model w00k2 \
			-pos 0,10,0
		chara スポットライト投影モデル 左舷投光器 \
			-model w00k5 \
			-pos 500,10,0
		#if 1
		chara 静止スポットライト設置 左舷投光器 \
			-pos -19765, 14610, -14914 \
			-dir  19700, -12000, -6000 \
			-range 15000 \
			-angle 45 \
			-color 128,128,100 \
			-option 0x0000
		#endif

	// ライトのビーム
	chara 固定ボリュームライト 左舷投光器 \
		-p -19670,13610,-14914 \
		-d 0,19000,-11000 \
		-n 32 \		// 16 (max=32)
		-l 15000 \	// 15000
		-w 1000		// 1000

	//補強用
/*
	chara 固定ボリュームライト 左舷投光器 \
		-p -19670,13610,-14914 \
		-d 0,19000,-11000 \
		-n 16 \		// 16 (max=32)
		-l 15000 \	// 15000
		-w 1000		// 1000
*/


	// 投光器のモデル
	chara プットオブジェ 投光器 \
		-m w00_sl2 \
		-r 0 0 0 \
		-p 0 0 0 \
		-l d:STAGE_LT2_2 \
		-s 100 100 100


	// ライトのビーム中の、光る雨
	chara スポット雨 左舷投光器 \
		-from -19765, 14710, -14914 \
		-to    8600, 17870, -12000 \
		-ratio  50 \
		-sphere 6000


	// 旧d00a6 > 壊れ具合を反映
	} else {
		if($f:w00b_左舷投光器壊れた == 0){
			chara スポットライト投影モデル 左舷投光器 \
				-model w00k2 \
				-pos 0,10,0
			chara スポットライト投影モデル 左舷投光器 \
				-model w00k5 \
				-pos 500,10,0
			#if 1
			chara 静止スポットライト設置 左舷投光器 \
				-pos -19765, 14610, -14914 \
				-dir  19700, -12000, -6000 \
				-range 15000 \
				-angle 45 \
				-color 152,153,151 \
				-option 0x0000
			#endif

		// ライトのビーム
		chara 固定ボリュームライト 左舷投光器 \
			-p -19670,13610,-14914 \
			-d 0,19000,-11000 \
			-n 32 \		// 16 (max=32)
			-l 15000 \	// 15000
			-w 1000		// 1000

		//補強用
	/*
		chara 固定ボリュームライト 左舷投光器 \
			-p -19670,13610,-14914 \
			-d 0,19000,-11000 \
			-n 16 \		// 16 (max=32)
			-l 15000 \	// 15000
			-w 1000		// 1000
	*/
		// 投光器のモデル
		chara プットオブジェ 投光器 \
			-m w00_sl2 \
			-r 0 0 0 \
			-p 0 0 0 \
			-l d:STAGE_LT2_2 \
			-s 100 100 100

		// ライトのビーム中の、光る雨
		chara スポット雨 左舷投光器 \
			-from -19765, 14710, -14914 \
			-to    8600, 17870, -12000 \
			-ratio  50 \
			-sphere 6000

		} else {
			chara プットオブジェ 壊れ投光器 -m w00_sl2x -r 0,0,0 -p 0,0,0 -l d:STAGE_LT2_2
		}
	}
}

