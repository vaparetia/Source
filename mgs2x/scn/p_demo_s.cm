resource P061_01_R01_エマとオタコン１無線機デモ１＿１__s {
//Vc116101.aif
プリスキン_000: {
Raiden, estamos en la sala de
ordenadores. &~?Cu&'al es tu situaci&'on?
}
/*ライデン、電算室に侵入した。
どうだ？*/
/*Raiden, we've infiltrated the
Computer Room. What's your
situation?*/
ライデン_001: {
Emma est&'a a salvo.
Vamos hacia all&'i.
}
/*エマは無事だ。
これからそっちへ向かう。*/
/*Emma's safe.
We're heading your way.*/
オタコン_002: {
&~!Buen trabajo!
}
/*よかった......。*/
/*Good job!*/
プリスキン_003: {
No hay nadie en el Shell 1. Parece que
todos est&'an a bordo del Arsenal.
}
/*シェル１には誰もいない。
皆アーセナルに乗り込んだようだ。*/
/*Shell 1's deserted. Looks like
everybody's aboard Arsenal.*/
オタコン_004: {
D&'i un vistazo al sistema, y no puedo
hacer nada. E.E. es nuestra esperanza.
}
/*いろいろやってみたけどやっぱり
僕じゃ手が出せない。ＥＥでなきゃ......。*/
/*I had a look at the system, but
there's nothing I can do. E.E.'s
our only hope...*/
ライデン_005: {
De acuerdo... Entonces te paso con ella.
}
/*それじゃ、エマに変わる。*/
/*Right... I'll put her on then.*/
オタコン_006: {
&~?Eh? &~?E.E.? &~?C&'omo...?
}
/*えっ、ＥＥに......。*/
/*Huh? E.E.? How...?*/
ライデン_007: {
Utilizar&'e mi Codec.
}
/*俺の体内通信を中継する。*/
/*I'll use my Codec as a relay.*/
オタコン_008: {
Mmm, ummm...
}
/*あ、あ......。*/
/*Ahem, ummm...*/
ライデン_009: {
Te dejo con ella...
}
/*代わるぞ？*/
/*Here she is...*/
エマ_010: {
Uh... &~?Hal...?
}
/*......お兄ちゃん？*/
/*Uh... Hal...?*/
//無線機画面、ライデンの変わりにオタコンが表示される。オタコンを動かすことはできるが、相づちはうてないようにする。
}
//d

resource P061_01_R01_エマとオタコン１無線機デモ１＿２__s {
//vcxxxxxxxxx
オタコン_000: {
&~?E.E.? &~?Eres t&'u?
}
/*ＥＥかい？*/
/*Ah... E.E.? Is that you?*/
エマ_001: {
Hal...
}
/*お兄ちゃん......。*/
/*Hal...*/
オタコン_002: {
E.E....
}
/*ＥＥ......。*/
/*E.E....*/
オタコン_003: {
Umm... &~?Porqu&'e est&'as implicada
en el proyecto de Metal Gear?
}
/*ＥＥ、なぜメタルギアなんかに手を？*/
/*Uh... why're you involved
with Metal Gear?*/
エマ_004: {
&~?&~?Ehh??
}
/*えっ？？*/
/*Huh???*/
オタコン_005: {
Conoces el pasado oscuro de nuestra
familia y te metes en esto.
&~?Qu&'e te pasa?
}
/*僕たちの呪われた家系を知っているだろ？
どうしてなんだ？*/
/*You knew our family's dark history,
and still got involved!? What's
wrong with you!?*/
エマ_006: {
Me lo deber&'ia de haber imaginado...
}
/*......やっぱり。*/
/*I should've known...*/
オタコン_007: {
&~!Cont&'estame!
&~?Porqu&'e est&'as cometiendo
el  mismo error?
}
/*どうしてだ？
どうして同じ過ちを繰り返す？*/
/*Answer me! Why are you
repeating the same mistake?*/
エマ_008: {
...
}
/*......。*/
/*...*/
エマ_009: {
Porque quer&'ia herirte...
quer&'ia verte sufrir...
}
/*あなたに会って、
あなたを苦しめたかったから......。*/
/*I wanted to hurt you...
I wanted to see you suffer...*/
オタコン_010: {
&~?E.E....?
}
/*ＥＥ？*/
/*E.E....?*/
エマ_011: {
Me abandonaste...
}
/*あなたは私を捨てた......。*/
/*You abandoned me --*/
オタコン_012: {
&~!No!
No fue as&'i...
}
/*違う。そうじゃない。*/
/*No!
That's not what happened...*/
プリスキン_013: {
Vale, &~!ya es suficiente!
}
/*二人とも、やめるんだ。*/
/*Alright -- that's enough!*/
オタコン_014: {
...
}
/*......。*/
/*...*/
エマ_015: {
&~?Y t&'u qui&'en eres?
}
/*誰？*/
/*Who are you?*/
プリスキン_016: {
Emma, soy un amigo de Otacon.
}
/*エマ、俺はオタコンの友人だ。*/
/*I'm a friend of Otacon's, Emma.*/
エマ_017: {
Otacon...
}
/*オタコン......。*/
/*Otacon...*/
プリスキン_018: {
Ya basta de peleas entre hermanos.
}
/*兄妹喧嘩なら、後でしろ。*/
/*Enough with the sibling rivalry.*/
エマ_019: {
&~!No son peleas entre hermanos!
}
/*兄妹喧嘩じゃないわ！*/
/*That's not what this is!!*/
プリスキン_020: {
&~!No tenemos tiempo para esto!
&~!Raiden! &~!Tr&'aela aqu&'i, ahora mismo!
}
/*一刻を争うんだ！
ライデンとこっちに来てくれ。*/
/*We haven't got time for this!
Raiden! Get her over here,
right now.*/
エマ_021: {
Yo... Yo...
}
/*う、うん。*/
/*I -- I...*/
ライデン_022: {
Entendido Snake.
Voy hacia all&'i con Emma.
}
/*わかった、スネーク。
エマを連れて行く。
*/
/*Gotcha, Snake. I'll head
over there with Emma.*/
プリスキン_023: {
La mayor&'ia de los enemigos est&'an
en el Arsenal. Ten mucho cuidado.
}
//<ページ数変更>
プリスキン_023_1: {
Aseg&'urate de que Emma llegue
sana y salva.
}
/*奴ら、ほとんどアーセナルに乗り込んで
いると思うが気をつけろ。
エマに怪我をさせるな。*/
/*Most of the enemy's aboard
Arsenal. But I suggest you
be careful.*/
/*Make sure Emma gets
here in one piece.*/
オタコン_024: {
Raiden... cuida de mi hermana.
}
/*ライデン......頼む......。*/
/*Raiden... take care of my sister.*/
ライデン_025: {
No te preocupes.
La llevar&'e hasta all&'i.
}
/*わかった。まかせてくれ。*/
/*Don't worry.
I'll get her there.*/
}
//d



resource P062_03_R01_エマとＡＩ３無線機デモ１＿１__s {
//vc116201
ライデン_000: {
&~?Me escuchas, Emma?
}
/*エマ、いいかい？*/
/*Are you reading me, Emma?*/
エマ_001: {
S&'i, alto y claro
}
/*ええ、大丈夫......。*/
/*Yes -- loud and clear.*/
ライデン_002: {
El Presidente dijo que el Arsenal Gear
era la llave del poder de Los Patriots.
}
/*大統領は『Ｇ．Ｗ』とアーセナルギアが
『愛国者達』の切り札だと言った。*/
/*The President said that Arsenal
Gear was the Patriots' key to
supremacy.*/
エマ_003: {
S&'i, es una buena descripci&'on.
}
/*そうね。
そういえるかも。*/
/*That's as good a description as any.*/
ライデン_004: {
&~?Qu&'e es exactamente?
}
/*一体、どういうものなんだ？*/
/*What exactly is it?*/
エマ_005: {
Es un gran sistema procesador de datos
capaz de controlar informaci&'on a escala
global.
}
/*世界規模の情報統制を行なうための
超大規模情報処理システム。*/
/*It's a massive data processing
system capable of controlling
information on a global scale.*/
ライデン_006: {
&~?Un gran sistema procesador de datos?
}
/*情報処理システム？*/
/*A data processing system...?*/
エマ_007: {
As&'i es. El sistema es un aparato que
permite que Los Patriots mantengan
el control.
}
/*ええ。『愛国者達』が支配を
継続していくための社会装置......。*/
/*That's right. The system's a
social device for maintaining
the Patriots' control.*/
ライデン_008: {
Me has perdido.
}
/*なんだそれは？*/
/*You've lost me.*/
エマ_009: {
Hoy en d&'ia, la informaci&'on surge de todos
los sitios y es distribuida libremente...
}
/*現代ではあらゆるところから情報が
生まれて、流通する......。*/
/*In this day and age, information
emerges from every direction,
and is freely distributed...*/
エマ_010: {
Una gran variedad de informaci&'on, recogida
por servidores que utilizan el m&'as alto
sistema de comunicaci&'on en red
}
//<ページ数変更>
エマ_010_1: {
y la tecnolog&'ia P2P, circula r&'apidamente
entre los individuos. 
}
/*高速通信網の整備とＰ２Ｐ技術の発達で
サーバに集約されていた情報が個人に
分散されるようになって、*/
/*A variety of information - gathered
by servers employing the latest in
high-speed communication networks*/
/*and P2P technology - is rapidly
circulated to individuals.*/
エマ_011: {
La velocidad a la que circula esta
informaci&'on crece pr&'acticamente
todos los d&'ias.
}
/*その流れはますます加速してるの。*/
/*In fact, the speed of this circulation
process is accelerating on an almost
daily basis.*/
エマ_012: {
Y esto no les hace mucha gracia
a Los Patriots.
}
/*彼等はそれに強い危機感を
持ってるみたい。*/
エマ_013: {
Creen que pasar&'an de ser
los dominadores a ser los dominados
}
/*近いうちに支配する側が支配される側に
取り込まれてしまうんじゃないかって、
ね。*/
/*Apparently, they believe that their
role will shift from dominant to
dominated.*/
ライデン_014: {
&~??
}
/*？*/
/*?*/
エマ_015: {
Te pondr&'e un ejemplo. Conoces
las actividades anti Metal Gear
de Solid Snake, &~?no?
}
/*例えばあなたはソリッド・スネークの
反メタルギア活動を知っているでしょう？*/
/*Let me give you an example. You're
aware of Solid Snake's anti-Metal
Gear activities, aren't you?*/
ライデン_016: {
S&'i, algo s&'e.
}
/*ああ......少しは。*/
/*Yeah -- I know a little about it.*/
エマ_017: {
Eso es un buen ejemplo perdido
en el control de la informaci&'on.
}
//<ページ数変更>
エマ_017_1: {
Te garantizo que Los Patriots no quieren
promover el nombre de Solid Snake...
}
/*それが一番の証拠。ソリッド・スネーク
の名は『愛国者達』にとって最も
口外されてはいけないものなの。
*/
/*That's just a small sample of
uncontrolled information.
*/
/*I can guarantee you the Patriots
did not want Solid Snake's name
publicized.
*/
エマ_018: {
Bien, m&'iralo de esta forma...
esc&'andalos pol&'iticos, corrupci&'on interna...
}
/*それは一例に過ぎない。政治家の醜聞、
企業の不正......*/
/*Now, look at it like this...
political scandal, corporate
corruption...*/
エマ_019: {
hasta ahora Los Patriots controlaban
estos y otros asuntos.
}
/*今までなら『愛国者達』の力で隠されていた事実が簡単に暴かれてしまう。*/
/*up until now, the Patriots have
managed to keep a lid on these
and other self-serving events.*/
エマ_020: {
Pero con su actual sistema procesador
de datos, no podr&'an 
}
//<ページ数変更>
エマ_020_1: {
controlar la circulaci&'on de
la informaci&'on generada a nivel particular.
}
/*現行のシステムでは個人から発信される
情報を抑えきることは出来ないの。
*/
/*But with their existing data
processing system, they are
no longer able to effectively＃−
*/
/*control the flow of information
generated at the individual level.
*/
エマ_021: {
Con el nuevo sistema que han creado,
pueden regular digitalmente toda
la informaci&'on.
}
/*だから新しいシステムで、
デジタル化された全ての情報統制を行う。*/
/*With the newly created system,
they can fully regulate digital
information.*/

//	ここから変更対応10/22
エマ_022: {
El sistema es capaz de clasificar la
informaci&'on de alto nivel por niveles,
restringir el acceso a los diferentes niveles
}
//<ページ数変更>
エマ_022_1: {
y borrar la informaci&'on que deseen.
}
/*高度な情報は段階を経て、
クリアランスが付けられ、
一般公開から削除されていく。
*/
/*High-level information can be
categorized in stages, given
clearance levels,
*/
/*
and deleted as necessary --
never to be seen by the public.
*/
エマ_023: {
Borrando esa informaci&'on, Los Patriots
pueden moldear la historia a su gusto.
}
/*これが動き出せば、数年で様々な情報は
歴史からいっせいに削除されることに
なる......。*/
/*By deleting such information, the
Patriots can shape the course of
history as they see fit.*/
ライデン_024: {
Pero alguien les puede descubrir...
}
/*誰かが気づくはずだ。*/
/*Somebody's bound to catch on --*/
エマ_025: {
No. La capacidad de memoria, por no
mencionar la expectativa de vida,
}
//<ページ数変更>
エマ_025_1: {
de una persona normal es extremadamente
limitada.
}
/*いいえ、人の記憶容量は極めて小さい。
人の寿命も短い。
*/
/*No. The memory capacity --
not to mention the life span --*/
/*of the average individual
is extremely limited.*/
エマ_026: {
Y adem&'as, la informaci&'on digital
nunca desaparece...
}
//<ページ数変更>
エマ_026_1: {
y tampoco se deteriora.
}
/*永遠に残るのはデジタル化されたもの
だけ。劣化しないから。
*/
/*On the other hand, digital
information lasts virtually
forever...*/
/*it doesn't deteriorate.*/
ライデン_027: {
&~?Y...?
}
/*ばかな......。*/
/*So...?*/
エマ_028: {
El alfabeto se compone de 28 letras,
Pero podr&'ian ser 30.
}
/*例えばアルファベットは２６文字だと
思われている。でも本来は３０文字
だったかもしれない。
*/
/*The alphabet... twenty-six letters,
right? It could've been thirty letters.
*/
エマ_029: {
&~? Qu&'e pasar&'ia si las otras dos letras
fueran controladas por un programa?
}
/*その削除された４文字をプログラムで
統制しているとしたら......。
*/
/*What if the 4 deleted letters
were controlled by a program?
*/
ライデン_030: {
Eso es imposible.
}
/*ありえない。*/
/*Impossible.*/
エマ_031: {
No, no es imposible. En realidad,
ya est&'a ocurriendo algo as&'i.
}
//<ページ数変更>
エマ_031_1: {
&~?Sabes cu&'antos genes tiene
un ser humano?
}
/*いいえ。それは既に行われつつある。
じゃあ、人の遺伝子数はいくつか
知ってる？
*/
/*It's not. In fact, something
similar is already underway.
*/
/*Do you know how many genes
exist in an individual?
*/
ライデン_032: {
&~?Unos 30 &'o 40 mil?
}
/*３万から４万個？*/
/*About 30 to 40 thousand?*/
エマ_033: {
As&'i es. Eso es lo que se anunci&'o
al principio de este siglo.
}
//<ページ数変更>
エマ_033_1: {
Pero realmente tiene unos 100 mil,
seg&'un la teor&'ia
}
//<ページ数変更>
エマ_033_2: {
original de la comunidad cient&'ifica.
}
/*ええ。今世紀の初めにそう発表された。
でも本当は、それ以前の学説通りの
１０万個なの。
*/
/*Right. That's what was announced
at the turn of the century.
*/
/*But there's actually 100 thousand,
according to the original theory＃−
*/
/*advanced by the scientific
community.
*/
エマ_034: {
La informaci&'on sobre los otros 60 mil
genes fue borrada por Los Patriots.
}
/*残りの６万個が『愛国者達』に
情報統制されている......。*/
/*Information regarding the
remaining 60 thousand was
suppressed by the Patriots.*/
ライデン_035: {
No...
}
/*嘘だ！*/
/*No...*/
エマ_036: {
&~?Por qu&'e no?
&~?Tienes alguna forma de probarlo?
}
/*それが嘘だと、どうしてあなたに
分かるの？*/
/*Why? How would you know?*/
エマ_037: {
&~?Acaso sabes c&'omo es un gen?
&~?Los has contado?
}
/*遺伝子がどんなものか、
あなたは本当に知ってるの？*/
/*Do you know what a gene looks like?
Did you count them yourself?*/
ライデン_038: {
Hay organizaciones de investigaci&'on
cient&'ifica...
}
/*......研究機関なら......。*/
/*There are research organizations...*/
エマ_039: {
Por supuesto... y sus informes han sido
"modificados" sutilmente.
}
//<ページ数変更>
エマ_039_1: {
Incluso ellos empiezan a creer
los informes m&'edicos.
}
/*勿論、研究論文もすべて情報改竄されて
るわ。そしてそのうち自分が間違いで
あったと錯覚する。
*/
エマ_040: {
GW es un sistema que permite a Los
Patriots decidir la historia del ma&~nana.
}
/*『Ｇ．Ｗ』は人の歴史を後世に
どう残すか、それを『愛国者達』が
決めるためのシステム......。*/
ライデン_041: {
O sea que estamos hablando de un enorme
sistema de censura que permite
}
//<ページ数変更>
ライデン_041_1: {
que Los Patriots manipulen la informaci&'on
a su gusto.
}
/*つまり『愛国者達』に都合の悪い情報を
削除する大掛かりな検閲装置という
ことか？
*/
/*So what we're talking about is
one huge censorship system for
deleting information＃−
*/
/*which might be inconvenient
to the Patriots?
*/
エマ_042: {
Exactamente. Y la unidad que controla
ese sistema, el GW, est&'a instalada
en el Arsenal.
}
/*ええ。それを行う中枢システムの物理的
実体がアーセナルの中にあるの。*/
/*Exactly. The actual, physical core
for handling the task -- GW -- is
installed in Arsenal.*/
エマ_043: {
Es el &'unico sistema en el mundo
con una IA neural &'optica
}
/*『Ｇ．Ｗ』。
*/
/*It's the only system in the world
with an optic neural AI＃−
*/
エマ_044: {
que tiene una capacidad de procesamiento
de 980 millones de hammets.
}
/*世界に一つしかない９８０兆ハメットの
複雑さを持つ光ニューロＡＩ......。*/
/*that has a parallel processing
capacity of 980 trillion hammets.
*/
ライデン_045: {
Al ser una especialista en IA neural
y en l&'ogica compleja,
}
//<ページ数変更>
ライデン_045_1: {
este proyecto de Metal Gear te atra&'ia
mucho.
}
/*それが理由か？ニューロＡＩと
複雑性理論の専門家の君が
メタルギア開発に関わっていたのは......。
*/
/*I suppose that being a specialist
in neural AI and complex logic＃−
*/
/*played a significant role
in your association with
the Metal Gear project.
*/
エマ_046: {
Bueno, &'esa no es la &'unica raz&'on...
}
/*それだけじゃないけどね......。*/
/*That's not the only reason...*/
ライデン_047: {
&~?Qu&'e quieres decir?
}
/*え？*/
/*What do you mean?*/
エマ_048: {
...
}
/*......。*/
ライデン_049: {
Bueno, supongo que tienes muchas
m&'as razones.
}
/*......まぁ、きっと事情があるんだろうな。*/
/*I guess there're plenty
of other reasons.*/
エマ_050: {
S&'i, las tengo...
}
/*うん......。*/
/*Yes, there are --*/
ライデン_051: {
Ya entiendo...
}
/*わかるよ。*/
/*I understand...*/
エマ_052: {
&~?De verdad?
}
/*......そう......？*/
/*Do you?*/
ライデン_053: {
As&'i que Arsenal Gear fue dise&~nado
para proteger el sistema GW, &~?no?
}
/*ではアーセナルギアは『Ｇ．Ｗ』を
守るために建造された？*/
/*So Arsenal Gear was actually
designed to protect the GW
system, wasn't it?*/
エマ_054: {
Bueno...s&'i. Tiene muchas armas,
incluyendo armas nucleares
}
//<ページ数変更>
エマ_054_1: {
y medidas contra ciber-terroristas.
}
/*......ええ。核兵器を含めた最高の武装を持ち、サイバーテロ対策も完璧。
物理的にも論理的にも史上最強の要塞。
*/
/*Uh...yes. It's armed with
everything including nuclear
weapons,
*/
/*and is fully equipped with
cyber-terrorist countermeasures.
*/
エマ_056: {
Hoy en d&'ia, es el lugar m&'as seguro
para guardar el GW.
}
/*『Ｇ．Ｗ』の器。*/
/*Physically and logically,
it's the ultimate fortress
for housing GW.*/
ライデン_057: {
&~?Pero la IA es capaz de controlar
absolutamente todo?
}
/*だが、そのＡＩだけで全てを制御出来る
とは思えないが。*/
/*But is the AI actually capable
of controlling everything?*/
エマ_058: {
No. GW es s&'olo el sistema matriz.
S&'olo decide qu&'e informaci&'on debe
ser guardada o borrada.
}
/*ええ。『Ｇ．Ｗ』はあくまでも
システムの中枢。何を残すか、
何を削除するかを判断するためのね。*/
/*No. GW is only the system's core.
It's only for deciding what data
is stored or deleted.*/
エマ_059: {
El verdadero subsistema para realizar
el trabajo est&'a integrado en nuestra
sociedad...
}
/*それを実行するサブシステムは
既に社会に埋め込まれている......。*/
/*The actual sub-system for
executing the task exists
within our social structure...*/
ライデン_060: {
&~?&~!Qu&'e!?
}
/*どういうことだ？*/
/*What!?*/
}
//d


resource P062_05_R02_エマとＡＩ５無線機デモ２＿１__s {
//vc116211
ライデン_000: {
Ya... y el programa del A&~no 2000 conten&'ia
un programa dise&~nado por Los Patriots.
}
/*その中に『愛国者達』のプログラムが
仕込まれていたと？*/
/*Let me guess... the Y2K
countermeasure contained a program
designed by the Patriots?*/
エマ_001: {
As&'i es. Y desde ese d&'ia, todos los
ordenadores vienen ya con ese programa
instalado.
}
/*ええ。
勿論、それ以降に作られたものには
初めからそのシステムが組み込んである。*/
/*Yes. And everything supplied from
that day onward contains the same
program.*/
ライデン_002: {
Eso es imposible.
}
/*そんな馬鹿な......。*/
/*Impossible.*/
エマ_003: {
&~?Sabes c&'omo funciona un ordenador?
}
/*どうしてそう言えるの？コンピュータが
どうやって動作しているのか、あなたは
知ってるの？
*/
/*Do you know how
a computer operates?
*/
エマ_004: {
&~?Conoces realmente los principios b&'asicos
de transmisi&'on de informaci&'on?
}
/*この通信がどういう原理なのかだって
本当は分かってないでしょ？
*/
/*Do you really know the basic
principles on how data is
exchanged?
*/
ライデン_005: {
...
}
/*......。*/
エマ_006: {
Nadie lo sabe, pero hay un subsistema.
Y est&'a a punto de ser activado.
}
/*誰も知らないけど、そのシステムは
実在する。そしてそれらはもうすぐ
一斉に動き出す......。*/
/*Nobody's aware of it, but
there's a sub-system in place.
And it's about to be activated.*/
ライデン_007: {
&~?Y por eso Solidus quiere quemar todos 
los circuitos el&'ectricos de Manhattan por
medio de una explosi&'on nuclear?
}
/*ソリダスが核爆発でマンハッタン全ての
電子回路を焼き切ろうとしているのは
そのため......？*/
/*Is that why Solidus wants to burn
out every electrical circuit in
Manhattan with a nuclear blast?*/
エマ_008: {
Probablemente.
Pero el sistema no est&'a todav&'ia finalizado.
}
/*そうかもね。
でもシステムはまだ完成してるわけ
じゃない。*/
/*Probably.
But the overall system
isn't actually complete.*/
ライデン_009: {
&~?Qu&'e?
}
/*え？*/
/*What?*/
エマ_010: {
Todav&'ia le falta el factor necesario
para juzgar cada situaci&'on.
}
/*状況を判断するための＃｛因子、ファクター｝＃が
不足してるの。*/
/*It still lacks the necessary
factors for judging situations.*/
エマ_011: {
He o&'ido que est&'an planeando llevar a
cabo un experimento complejo
}
//<ページ数変更>
エマ_011_1: {
en un par de d&'ias para proporcionar
informaci&'on al GW.
}
/*その複雑さを『Ｇ．Ｗ』に学習させる
ために大規模な実験を近日中に
行うって話は聞いていたんだけど......。
*/
/*I heard they were planning a major
experiment in the next few days,
*/
/*to provide complex data
for GW to study.
*/
エマ_012: {
Y de repente, todo esto ha ocurrido...
}
/*突然、こんなことが起こって......。*/
/*And suddenly all this happens...*/
ライデン_013: {
Emma... no es tu culpa. 
Si no hubiera sido por los terroristas...
}
/*......エマ、これはテロだ。
君が悪いんじゃない......。*/
/*Emma... it's not your fault.
If it wasn't for the terrorists...*/
エマ_014: {
S&'i... tienes raz&'on...
}
/*......うん......そうね......。*/
/*Yeah... you're right...*/
エマ_015: {
Bueno... creo que eso es todo
lo que necesitas saber.
}
/*うん。
......とりあえず私が知ってるのは
これくらい、かな。*/
/*Well... I think that's
about all I know.*/
ライデン_016: {
Vale... y gracias. Creo que ser&'a mejor que
vayamos hacia la sala de ordenadores.
}
/*そうか......ありがとう。
じゃあ電算室へ急ごうか？*/
/*Right... uh, thanks. I think
we'd better head for the
Computer Room.*/
エマ_017: {
&~!Mi p&'ajaro est&'a en la sala de
ordenadores!  &~?&~!Est&'a a salvo!?
}
/*鳥は無事？
電算室にいた......。*/
/*My bird in the Computer
Room! Is he safe!?*/
}
//d




resource P064_01_R01_エマライデンローズ無線１無線機デモ１＿１__s {
//vc116401
ローズ_000: {
Y bien Jack. Parece que t&'u y la Emma se
est&'an haciendo buenos amigos.
}
/*ジャック、エマさんと仲がいいようね。*/
/*Well, Jack. It sounds like you
and Miss Emma are getting
along just fine.*/
ライデン_001: {
&~?Rose?
}
/*ローズ、何を言っている？*/
/*Rose?*/
ローズ_002: {
He estado escuchando todas
vuestras conversaciones.
Y la verdad, no me hace ninguna gracia...
}
/*私、あなたの行動や会話を全部モニター
してるのよ。あまりいい気はしないわ。*/
/*I've been monitoring your
every move and conversation.
I can't say it's been fun...*/
ライデン_003: {
&~!Dame un respiro!
S&'olo intento animarla.
}
/*誤解するな。
俺はエマを勇気づけてるだけだ。*/
/*Give me a break! I'm only
trying to keep her spirits up.*/
ローズ_004: {
&~?Seguro?
}
/*そうなの、ジャック？*/
/*Is that right?*/
ライデン_005: {
S&'i. Mi misi&'on es llevarla hasta
la sala de ordenadores.
}
/*ああ。
彼女を電算室まで連れて行くのが任務だ。*/
/*Absolutely. My mission is to get
her to the Computer Room.*/
ローズ_006: {
&~?Eso es todo?
}
/*それだけ？*/
/*That's all?*/
ライデン_007: {
S&'i.
}
/*......ああ。*/
/*Yeah.*/
ローズ_008: {
Est&'as mintiendo.
Te gusta, &~?verdad?
}
/*嘘っ、ちょっとはいいと思ってる？*/
/*You're lying.
You're attracted
to her, aren't you.*/
ライデン_009: {
... Tengo que admitir que es guapa.
}
/*ああ、エマはかわいい娘だ。*/
/*...I'll admit she's cute.*/
ローズ_010: {
&~?M&'as mona que yo?
}
/*私より？*/
/*Cuter than me?*/
ライデン_011: {
Rose, t&'u eres linda.
Adem&'as, ya sabes lo que siento por ti.
}
/*ローズ、君は素敵だ。
俺の気持ちに代わりはない。*/
/*Rose, you're beautiful.
You know how I feel about
you.*/
ローズ_012: {
&~?Te has acordado ya?
}
/*じゃあ、思い出した？*/
/*Have you remembered yet?*/
ライデン_013: {
&~?Te refieres al 30 de abril?
}
/*４月３０日のこと？*/
/*You mean April 30th?*/
ローズ_014: {
S&'i.
}
/*そう。*/
/*Yes.*/
ライデン_015: {
Es tu cumplea&~nos, &~?no?
}
/*君の誕生日？*/
/*It's your birthday, isn't it.*/
ローズ_016: {
&~!No!
&~!Nada por el estilo!
}
/*ブブー！
外れ！
大外れ！*/
/*Wrong!
You're not even warm!*/
ライデン_017: {
&~?Entonces qu&'e es?
}
/*意地悪だな。*/
/*What is it then?*/
ローズ_018: {
Olv&'idalo... no es nada.
Igual es que estoy un poco...
celosa...
}
/*......ごめんなさい。ちょっとした冗談、
なんだか、いいムードだったから......
ちょっとやけちゃったかな......。*/
/*Forget it... it's nothing.
Maybe I'm just a little...
a little jealous...*/
ライデン_019: {
&~?Rose?
}
/*ローズ？*/
/*Rose?*/
ローズ_020: {
Es mejor que sigas adelante.
Buena suerte.
}
/*じゃあね、がんばって。*/
/*You'd better get moving.
Good luck.*/
}
//d




resource P065_02_R01_エマＬ脚２無線機デモ１＿１__s {
//vc116501
ライデン_000: {
Quiero hacerte una pregunta.
}
/*......聞いていいか？*/
/*I have a question for you.*/
エマ_001: {
&~?Qu&'e?
}
/*なに？*/
/*What is it?*/
ライデン_002: {
&~?Qu&'e piensas de las alturas?
}
/*高いところは苦手か？*/
/*How do you feel about heights?*/
エマ_003: {
La verdad no me gustan,
me da m&'as miedo el agua. &~?Por qu&'e?
}
/*嫌い。
水の中よりはマシだけど......
どうしてそんなこと聞くの？*/
/*I can't say I like heights...
though water's higher on
my phobia list. Why?*/
ライデン_004: {
Porque... tenemos que bajar
una escalera...
}
/*これからハシゴで下に降りる。*/
/*Well... we have to
go down a ladder.*/
エマ_005: {
&~?Cu&'an alta?
}
/*どれくらい？*/
/*How far down?*/
ライデン_006: {
Un poco...
}
/*ほんの少しだ。*/
/*Just a little bit...*/
エマ_007: {
Siento que ya hemos tenido esta
conversaci&'on antes.
&~?Cu&'an de poco?
}
/*さっきも『ほんの少し』って聞いたけど？*/
/*Why do I feel like we've had
this conversation before?
How little is little?*/
ライデン_008: {
... Unos 40 metros.
}
/*......４０メートル......くらいかな。*/
エマ_009: {
...
}
/*......。*/
ライデン_010: {
&~?Crees que lo puedes hacer?
}
/*いけるか？*/
/*Think you can do it?*/
エマ_011: {
&~?Aceptar&'ias un 'no' por respuesta?
}
/*ダメって言っても連れてくんでしょ。*/
/*Would you take "no"
for an answer?*/
ライデン_012: {
&~?Qu&'e tal tus piernas?
}
/*足の具合は？*/
/*How are your legs?*/
エマ_013: {
Mejor.
Ya no las tengo dormidas.
}
/*大丈夫。だいぶシビレがとれてきた。*/
/*Better.
The numbness is gone.*/
エマ_014: {
Puedo bajar la escalera sola.
}
/*一人で歩けるわ。*/
/*I can climb down on my own.*/
ライデン_015: {
De acuerdo... s&'igueme.
}
/*よし、俺の後についてくるんだ。*/
/*Okay... follow me.*/
}
//d




resource P065_06_R02_Ｌ脚エマ６無線機デモ２＿１__s {
//Vc116511
ライデン_000: {
Aqu&'i Raiden, &~?me escuchas?
}
/*こちらライデン、聞こえるか？*/
/*This is Raiden, do you read me?*/
プリスキン_001: {
S&'i, &~?Qu&'e pasa?
}
/*ああ、どうした？*/
/*Yeah. What's up?*/
ライデン_002: {
Hemos llegado a la parte inferior
del Soporte L. Tendremos que
cruzar desde aqu&'i.
}
/*Ｌ脚下部に到着した。
今から海面を渡るところだ。*/
/*We've made it to the lower part
of Strut L. We'll have to cross
