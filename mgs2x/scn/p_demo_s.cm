// テロ事件対策として、ムービーから無線に変更になった
//例のアレでうひょひょ
resource P049_03_R02_2_大統領３＿元ムービーデモ１__s {
//vcxxxxxx {
大統領_001: {
No me sorprende que nunca
hayas o&'ido hablar de ellos.
}//<ページ数変更>
大統領_001_1: {
Muy poca gente conoce su existencia,
ni siquiera aquellos que tienen acceso
irrestringido.
}
/*知らないのは当然だ。彼等の存在を
知っているのは＃｛最高暗号機密関与資格、コードワード・クリアランス｝＃を
持つ者の中でも極少数に限られる。
*/
ライデン_002: {
&~??
}
/*？
*/
大統領_003: {
La pol&'itica, el ej&'ercito, la econom&'ia,
lo controlan absolutamente todo.
Incluso fueron ellos quienes decidieron
qui&'en deb&'ia ser el Presidente...
}
/*Politics, the military, the economy --
they control it all. They even choose
who becomes President...
政治、軍事、経済......この国の
あらゆる決定は彼等が下している。
......無論大統領の選定も含めて。
*/
大統領_004: {
En pocas palabras,
Los Patriots dirigen este pa&'is.
}
/*Putting it simply, the Patriots
rule this country.
彼等こそ我が国を真に支配する者達だ。
*/
ライデン_005: {
No...
}
/*そんな......。*/
大統領_006: {
Dif&'icil de creer, &~?no?
Pero es la pura verdad.
}
/*Hard to believe, isn't it?
But it's the truth.
ふん。信じられないのも無理はない......
だが事実なのだ。
*/
大統領_007: {
La Defensa Espacial, la reducci&'on
de impuestos, el programa Nacional
de Defensa de Misiles (NDM),
}
/*The Space Defense, income tax
reduction and the National Missile
Defense (NMD) programs --
宇宙防衛の重視、所得税率の引き下げ、
＃｛本土ミサイル防衛、ＮＭＤ｝＃の推進......
*/
大統領_008: {
todo lo que a m&'i se me atribuye lo
he hecho siguiendo sus instrucciones.
}
/*Every policy that's been credited
to me was actually done according
to their instructions.
私が行なったとされている全ての政策は
彼等の指示によるものだった。
*/
ライデン_009: {
La Defensa Espacial fue un programa
iniciado por el Congreso...
}
/*Space Defense was
initiated by Congress...
宇宙防衛は議会から......。*/
大統領_010: {
Eso es lo que Los Patriots quieren
que el pa&'is crea...
}
/*That's what the Patriots want
the country to believe...
それも『愛国者達』の演出だよ。
*/
大統領_011: {
Todo es puro teatro.
&~!'La Democracia' es s&'olo un t&'ermino
que aparece en los libros de texto!
}
/*It's all a show. "Democracy" is
just a filler for textbooks!
議会はただの演芸場だ。
民主主義など教科書のページを埋める
ためのお題目でしかない。
*/
大統領_012: {
&~!Pi&'ensalo bien! &~?Realmente crees
que la opini&'on p&'ublica influye en
las decisiones del gobierno?
}
/*Think about it! Do you actually
believe that public opinion influences
the government?
それとも君は『民意』が社会に
反映されるのを見たことでもあるのか？
*/
ライデン_013: {
...No.
}
/*......いや......。
*/
大統領_014: {
Este pa&'is est&'a controlado
y dirigido por Los Patriots.
}
/*This country is shaped and controlled
as the Patriots see fit.
全ては『愛国者達』の利害と思惑に
基づいている。
*/
大統領_015: {
Y a la gente le muestran s&'olo
lo que quieren que vean.
}//<ページ数変更>
大統領_015_1: {
Lo que t&'u llamas gobierno no es
sino una productora muy bien montada
cuya funci&'on es satisfacer al p&'ublico.
}
/*The people are shown what
they want to believe.
What you call government is actually
a well-staged production aimed at
satisfying the public!
それを見栄えのいい建前で取り繕った
ショーのことを、君達は『政治』と
呼んでいるのだ。
*/
ライデン_016: {
...
}
/*......。
*/
大統領_017: {
No me mires as&'i, yo no estoy loco.
}
/*Don't look at me like that --
I'm legally sane, you know.
そんな目で見るな。
精神鑑定なら受けてるよ。
*/
ライデン_018: {
No es precisamente su locura
lo que me preocupa...
}
/*It's not your sanity
that worries me...
そういう意味では......。
*/
//dv}//v
}



resource P080_20_R01_2_ＡＧ浮上２０元ムービーデモ８__s {
//vcxxxxxx {
大佐_000: {
Durante los &'ultimos doscientos a&~nos...
}//<ページ数変更>
大佐_000_1: {
Se ha ido creando una especie
de conciencia en la Casa Blanca.
}
/*この２００年の間に......
様々な念がホワイトハウスという
重力場で産み落とされた。
*/
/*Over the past two hundred years --
*/
/*A kind of consciousness formed
layer by layer in the crucible of
the White House.
*/
大佐_001: {
Tal y como la vida surgi&'o de los oc&'eanos
hace 4 billones de a&~nos.
}//<ページ数変更>
大佐_001_1: {
La Casa Blanca fue nuestro &'utero,
el inicio de nuestra evoluci&'on...
}
/*４０億年前地球の海中で突然、生命が
生まれたように、ホワイトハウスの中で
芽生え、進化してきた......。
*/
/*It's not unlike the way life started
in the oceans four billion years ago.
*/
/*The White House was our
primordial soup, a base of
evolution --
*/
/* テロ対応でカット。
大佐_002: {
under the protection
of the flag...
suckled on the national religion
of capitalism...
}
*/
/*
星条旗の元に......
市民宗教の中で......。
*/
//dv}//v
}



resource P040_06b_M00_エイムズ発見６ｂ元ムービーデモ０__s {
//
/* テロ事件対応のため、セリフカット */
/*
エイムズ_000: {
And this is what they plan
to do right over Manhattan.
}
*/
/*奴等はそれをマンハッタン上空で
行おうとしているんだ。
*/
/*
ライデン_001: {
The New York Stock Exchange...
}
*/
/*そうなったらウォール街の
電子機器は......。
*/
/*
エイムズ_002: {
-- will suffer the same fate.
}
*/
/*無論、壊滅だな。*/
ライデン_003: {
Si uno de los puntos claves de la econom&'ia
mundial deja funcionar, comenzar&'a
una crisis global.
}//<ページ数変更>
ライデン_003_1: {
El Lunes Negro parecer&'a paseo
en bicicleta.
}//<ページ数変更>
/*
ライデン_003_2: {
Black Monday will look like
a picnic in comparison.
}
*/
/*世界経済の中心が機能を停止すれば、
世界的な大恐慌に陥る......
＃｛暗黒の月曜日、ブラックマンデー｝＃の再来......？。
*/
/*If one of the key movers of world
economy stops functioning,*/
/*it could mean the beginning
of a global depression.*/

}//d


