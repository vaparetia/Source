resource P065_06_R02_Ｌ脚エマ６無線機デモ２＿４__s {
//vc116514
ライデン_000: {
Emma, &~?me escuchas?
}
/*エマ、聞こえるか？*/
/*Emma, are you reading me?*/
エマ_001: {
Alto y claro...
}
/*ええ......。*/
/*Loud and clear...*/
ライデン_002: {
Te voy a cubrir desde aqu&'i.
}
/*俺がここから君の進路を切り開く。*/
/*I'm gonna clear a path
for you from here.*/
エマ_003: {
&~?C&'omo?
}
/*どうやって？*/
/*How?*/
ライデン_004: {
Carg&'andome a los centinelas.
}
/*狙撃だ。*/
/*Sniper fire.*/
エマ_005: {
Est&'as bromeando...
}
/*私に当たるんじゃ？*/
/*You're kidding...*/
ライデン_006: {
Conf&'ia en m&'i.
}
/*俺を信じろ。*/
/*Trust me.*/
エマ_007: {
&~?Y qu&'e pasa si me caigo al mar?
&~!No s&'e nadar!
}
/*私、泳げない。
海に落ちたら？*/
/*What if I fall into the sea?
I... I can't swim!*/
ライデン_008: {
Hace unos minutos lo has hecho muy bien.
}
/*もう泳げる。
いや、さっきは泳げた。*/
/*You were doing pretty good
a few minutes ago.*/
エマ_009: {
Vale.
}
/*わかった。*/
/*Okay.*/
ライデン_010: {
&~?Crees que lo puedes hacer?
}
/*準備はいいか？*/
/*Think you can do it?*/
エマ_011: {
&~?Aceptar&'ias un 'no' por respuesta?
}
/*よくなくても。*/
/*Would you take "no"
for an answer?*/
/* はもりりん
ライデン_000: {
No.
}
//行ってもらう。
*/
エマ_012: {
No.
}
/*行ってもらう。*/
/*No.*/
ライデン_013: {
Bien, pues vamos.
Todo va a salir bien.
}
/*さあ、行くんだ。
君ならきっと出来る。*/
/*Alright, get going.
You'll be fine.*/
}
//d




resource P067_01_R01_エマ狙撃１無線機デモ１＿１__s {
