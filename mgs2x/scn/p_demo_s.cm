}
/*わかった、
こっちが撃ち逃した場合は頼む。*/
/*Right. Do me a favor and
take out whatever I miss.*/
プリスキン_004: {
Ll&'amame cuando quieras que dispare.
}
/*俺に狙撃を任せたくなったら、
無線連絡をくれ。*/
/*Just call me when you
want me to shoot.*/
}
//d



resource P069_02_R01_ヴァンプ狙撃終了２無線機デモ１＿１__s {
//vc116901
プリスキン_000: {
&~!Raiden! 
&~!Han apu&~nalado a Emma!
}
/*ライデン！
エマが刺された！*/
/*Raiden!
Emma's been stabbed!*/
ライデン_001: {
&~!Ese imb&'ecil!
}
/*なんてこった！！*/
/*That bastard!*/
オタコン_002: {
&~?&~!C&'omo est&'a!?
}
/*傷はどうなんだ！*/
/*How bad is it!?*/
プリスキン_003: {
Est&'a consciente... pero est&'a perdiendo
mucha sangre. &~!La llevo hacia all&'i
ahora mismo!
}
/*意識はしっかりしてるが......
出血がひどい。すぐそっちに運ぶ。*/
/*She's conscious... but the
bleeding's bad. I'm bringing
her over there right now!*/
オタコン_004: {
E.E...
}
/*ＥＥ......。*/
/*E.E...*/
プリスキン_005: {
