}//d



resource P026_01_R01_爆弾解体終了１無線デモ１＿１__g {
//vc112601
ライデン_000: {
Oberst, ich habe die Bombe neutralisiert.
}
//	<<<ENGLISH>>>
//	Colonel, I've neutralized the bomb.

/*大佐、爆弾を解体した……。*/
大佐_001: {
Gute Arbeit, Raiden.
}
//	<<<ENGLISH(2)>>>
//	Good work, Raiden.

/*よくやった、ライデン。*/
ライデン_002: {
Es war ein schwerer Verlust f&~ur
alle Beteiligten.
}
//	<<<ENGLISH(2)>>>
//	It was a great loss for everyone.

/*大きな犠牲を払った……。*/
大佐_003: {
Ja, das war es.
}
//	<<<ENGLISH(2)>>>
//	Yes it was.

/*ああ……。*/
ライデン_004: {
Oberst, irgendwelche
Schadensmeldungen?
}
//	<<<ENGLISH>>>
//	Colonel, any damage report
//	on the explosion?

/*大佐、爆発の影響は？*/
大佐_005: {
Das Rohr, das das verunreinigte
Meerwasser umlenkt, scheint zerst&~ort
zu sein;
}
//	<<<ENGLISH>>>
//	Seems that the duct for diverting
//	the contaminated sea water was
//	destroyed.

/*汚染海水を巡らせる経路が
破壊されたらしい。
*/
//<ページ数変更>
大佐_005_1: {
In den Zentralbereich von Shell 2
dringt Wasser ein.
}
//	<<<ENGLISH>>>
//	And the central section
//	of Shell 2 is flooding.

/*シェル２の中央棟が浸水している。*/
大佐_006: {
Au&~serdem entz&~undete die Explosion
das &~Ol auf der Wasseroberfl&~ache.
}
//	<<<ENGLISH>>>
//	The explosion's ignited
//	the oil slick on the surface.

/*それと、油膜に引火して、
海面が炎上している。*/
ライデン_007: {
Was ist mit den Giften?
}
//	<<<ENGLISH(2)>>>
//	What about the toxins?

/*有毒物質の発生は？*/
大佐_008: {
Die Chemikalien sind weiterhin isoliert.
- keine unmittelbare Gefahr.
}
//	<<<ENGLISH>>>
//	The chemicals stayed in
//	containment. There's no
//	immediate danger.

/*今の所は心配ないようだ。*/
ライデン_009: {
Ist die Big Shell stabil?
}
//	<<<ENGLISH>>>
//	Is the Big Shell stable?

/*『ビッグ・シェル』は
姿勢維持できるのか？*/
大佐_010: {
Shell 1 wurde nicht betroffen.
Ein hoher Preis, aber es gibt
keine akute Bombengefahr mehr.
}
//	<<<ENGLISH>>>
//	Shell 1 was unaffected. The
//	price was high, but the threat
//	of the bomb is over for now.

/*大丈夫だ。シェル１には影響はない。
とにかく爆弾の脅威は去った。*/
ライデン_011: {
Wie lautet der n&~achste Auftrag?
}
//	<<<ENGLISH>>>
//	What's the next objective?

/*次の指示は？*/
大佐_012: {
Den Pr&~asidenten retten.
Kehr zur oberen Ebene zur&~uck.
}
//	<<<ENGLISH>>>
//	Rescue the President.
//	Get back to the upper level.

/*大統領の救出に向かってくれ。
とりあえずそこから上に戻るんだ。*/
ライデン_013: {
Alles klar.
}
//	<<<ENGLISH>>>
//	Roger that.

/*了解。*/
}//d




resource P027_01_R01_爆弾解体後昇降機ホール１無線デモ１＿１__g {
//vc112701
大佐_000: {
Raiden, die Terroristen haben sich f&~ur
die Bombenentsch&~arfung ger&~acht.
}
//	<<<ENGLISH>>>
//	Raiden, the terrorists have
//	retaliated for our bomb
//	neutralization.

/*ライデン、
爆弾の強制除去に対する報復があった。*/
ライデン_001: {
Was?
}
//	<<<ENGLISH(2)>>>
//	What?

/*何？*/
大佐_002: {
Eine Geisel wurde get&~otet -
Kopfschu&~s.
}
//	<<<ENGLISH>>>
//	A hostage has been killed --
//	shot in the head.

/*人質が１名殺害された。*/
大佐_003: {
Derschu&~s fiel auf dem Dach,
damit wir es mitkriegen.
}
//	<<<ENGLISH>>>
//	They shot one of them on the roof,
//	just to make sure we caught it.

/*T奴等、屋上でこれみよがしに
頭を撃ち抜いてみせたよ。
*/
//<ページ数変更>
大佐_003_1: {
Einer unserer Satelliten hat es
aufgezeichnet, v&~ollig scharf.
}
//	<<<ENGLISH>>>
//	One of our satellites
//	caught it, clear as day.

/*衛星がはっきり捉えた。*/
ライデン_004: {
Mist!
}
//	<<<ENGLISH(2)>>>
//	Damn!

/*くそっ！*/
大佐_005: {
Sie erkl&~arten, da&~s sie jetzt st&~undlich
eine Geisel t&~oten werden.
}
//	<<<ENGLISH>>>
//	They announced that they would
//	kill one every hour from now on.

/*今後、１時間毎に１名ずつ……だそうだ。*/
ライデン_006: {
Wie lautet mein Befehl?
Was soll ich tun?
}
//	<<<ENGLISH>>>
//	What are my orders?
//	What should I do?

/*どうすればいい？
俺は？*/
大佐_007: {
Halt Dich an Dein Einsatzziel.
Rette den Pr&~asidenten
}
//	<<<ENGLISH>>>
//	Stay with your mission objective.
//	Rescue the President.

/*そのまま任務を続行しろ。
大統領救出が優先だ。*/
ライデン_008: {
Was ist mit den anderen Geiseln?
}
//	<<<ENGLISH>>>
//	What about the other hostages?

/*他の人質は？*/
大佐_009: {
Pr&~asident Johnson ist
Deine erste Priorit&~at.
}
//	<<<ENGLISH>>>
//	President Johnson is
//	your first priority.

/*最優先はジョンソン大統領だ。*/
ライデン_010: {
Priorit&~at, da&~s ich nicht lache.
Sie sind alle in Gefahr.
}
//	<<<ENGLISH>>>
//	Priority my butt.
//	They're all in danger!

/*人質に優先もくそもない。*/
ローズ_011: {
Jack, sei vern&~unftig.
}
//	<<<ENGLISH>>>
//	Jack, be reasonable.

/*ジャック、冷静になって。
*/
ローズ_012: {
Ich wei&~s, wie Du Dich f&~uhlst,
aber Du kannst sie nicht alle retten.
}
//	<<<ENGLISH>>>
//	I know what you're feeling,
//	but you can't save them all.

/*あなたの気持ちはわかるわ。
でも、あなた一人では人質全員を
救出なんてできない。*/
ライデン_013: {
Nein, nicht alleine.
}
//	<<<ENGLISH>>>
//	No, not by myself.

/*俺一人ではな。*/
大佐_014: {
Glaubst Du, da&~s Pliskin durchkommt?
}
//	<<<ENGLISH>>>
//	Are you expecting that
//	Pliskin to come through?

/*あの男に期待しているのか？*/
ライデン_015:
''
//	<<<ENGLISH>>>
//	Well...

/*……。*/
大佐_016: {
Anscheinend hat er sein Funkger&~at
abgeschaltet.
}
//	<<<ENGLISH>>>
//	Looks like he's turned
//	his radio off too.

/*無線は通じないようだが？*/
ライデン_017: {
Allein kann ich den Auftrag nicht
ausf&~uhren.
}
//	<<<ENGLISH>>>
//	I can't complete this
//	mission by myself.

/*俺一人では、任務遂行は無理だ。*/
大佐_018: {
Der Mann geh&~orte nicht zur Simulation.
}
//	<<<ENGLISH>>>
//	That man was not included
//	in the simulation.

/*あの男はシミュレーションには
入っていない。*/
大佐_019: {
Er spielt bei diesem Einsatz keine Rolle.
}
//	<<<ENGLISH>>>
//	He is not a factor in this mission.

/*あの男は＃｛要素、ファクター｝＃には入っていないのだ。*/
ライデン_020: {
Was meinst Du damit, Oberst?
}
//	<<<ENGLISH>>>
//	What do you mean by that, Colonel?

/*大佐、何だって？*/
大佐_021: {
Dein Einsatz mu&~s ein Alleingang bleiben.
}
//	<<<ENGLISH>>>
//	Your mission must
//	remain a solo effort.

/*君の任務はあくまでも単独作戦行動……。*/
ライデン_022: {
Was ist mit den SEALs?
Kein zweiter Versuch?
}
//	<<<ENGLISH>>>
//	What about the SEALs?
//	No second attempt?

/*ＳＥＡＬＳの再突入はないのか？*/
大佐_023: {
Sie sind nicht einmal in der
Planungsphase.
}
//	<<<ENGLISH>>>
//	They haven't even gotten
//	to planning that.

/*まだ目処も立ってない。*/
大佐_024: {
Wir k&~onnen jetzt nur abwarten.
Solange bist Du unsere einzige Hoffnung.
}
//	<<<ENGLISH>>>
//	All we can do is wait.
//	In the meantime, you're
//	our only hope.

/*我々は待つしかできない。
君だけが頼りなんだ。*/
ライデン_025: {
Verstehe.
}
//	<<<ENGLISH>>>
//	...I understand.

/*……わかった。*/
大佐_026: {
Raiden, geh und rette den Pr&~asidenten.
Ein erster Schritt w&~are, zur oberen Ebene
von Strebe A zu gehen.
}
//	<<<ENGLISH>>>
//	Raiden, go and rescue the President.
//	You can start off by getting to the
//	upper level of Strut A.

/*ライデン、大統領の救出に向かってくれ。
まずＡ脚上部に上がるんだ。*/
}//d




resource P030_01_R01_フォーチュン戦中無線無線デモ１＿１__g {
//vc113001
大佐_000: {
Raiden, Fatman hat uns soeben
kontaktiert.
}
//	<<<ENGLISH>>>
//	Raiden, Fatman just
//	contacted us directly.

/*ライデン、ファットマンから
こちらに直接連絡があった。*/
ライデン_001: {
Fatman hat UNS angerufen?
}
//	<<<ENGLISH>>>
//	Fatman called US?

/*ファットマンから？*/
大佐_002: {
Ja. Er hat wohl eine Bombe auf dem
Heliport gelegt. Er hat ausdr&~ucklich
nach Dir gefragt, Raiden.
}
//	<<<ENGLISH>>>
//	Yes. Looks like he placed a bomb
//	on the heliport. He specifically
//	asked for you, Raiden.

/*ああ。ヘリポートにまた仕掛けたらしい。
ライデン、君を指定してきている。*/
ライデン_003: {
Was!?
}
//	<<<ENGLISH(2)>>>
//	What!?

/*なに！？*/
大佐_004: {
Er hat Peter get&~otet.
Jetzt ist er hinter Dir her.
}
//	<<<ENGLISH>>>
//	He's killed off Peter.
//	Now he's after you.

/*スティルマンが亡くなって、
次のターゲットは君らしい。*/
ライデン_005: {
Warum gerade hinter mir?
}
//	<<<ENGLISH>>>
//	Why me?

/*なぜ俺なんだ？*/
大佐_006: {
Woher soll ich das wissen?
}
//	<<<ENGLISH(2)>>>
//	How should I know?

/*わからん。*/
ライデン_007: {
Jetzt ist kein g&~unstiger Zeitpunkt daf&~ur.
}
//	<<<ENGLISH>>>
//	Look. This is really not
//	a good time for this.

/*こっちはそれどころじゃないぞ！*/
大佐_008: {
Der Countdown hat bereits begonnen,
Raiden!
}
//	<<<ENGLISH>>>
//	The countdown's already
//	begun, Raiden!

/*すでにタイマーが起動している。*/
ライデン_009: {
Na toll. Wieviel Zeit habe ich noch?
}
//	<<<ENGLISH>>>
//	Great, how much
//	time do I have left?

/*なんてこった、後いくらだ？*/
大佐_010: {
Ich zeige Dir den Z&~ahler.
}
//	<<<ENGLISH>>>
//	I'll show you the count.

/*カウントを表示する。*/
}//d
resource P030_01_R01_フォーチュン戦中無線無線デモ１＿カウント２００__g {
//vc113002
大佐_000: {
Noch 200 Sekunden.
}
//	<<<ENGLISH>>>
//	200 seconds remaining.

/*後２００カウントだ。
*/
}//d
resource P030_01_R01_フォーチュン戦中無線無線デモ１＿カウント３００__g {
//vc113003
大佐_000: {
Noch 300 Sekunden.
}
//	<<<ENGLISH>>>
//	300 seconds remaining.

/*後３００カウントだ。
*/
}//d
resource P030_01_R01_フォーチュン戦中無線無線デモ１＿カウント４００__g {
//vc113004
大佐_000: {
Noch 400 Sekunden.
}
//	<<<ENGLISH>>>
//	400 seconds remaining.

/*後４００カウントだ。
*/
}//d
resource P030_01_R01_フォーチュン戦中無線無線デモ１＿カウント５００__g {
//vc113005
大佐_000: {
Noch 500 Sekunden.
}
//	<<<ENGLISH>>>
//	500 seconds remaining.

/*後５００カウントだ。
*/
}//d
resource P030_01_R01_フォーチュン戦中無線無線デモ１＿カウント後__g {
//vc113006
ライデン_000: {
Jetzt will er also diese Anlage
hochgehen lassen.
}
//	<<<ENGLISH>>>
//	So he's planning on
//	taking this place out.

/*ここを破壊する気だな。*/
大佐_001: {
Es scheint, als h&~atte er andere
Pl&~ane als Dead Cell.
}
//	<<<ENGLISH>>>
//	It looks like he has a different
//	agenda from that of Dead Cell.

/*デッドセルの目的と奴の目的は
既に違うようだ。*/
ライデン_002: {
Was ist mit Unterst&~utzung?
}
//	<<<ENGLISH>>>
//	What about backup?

/*応援は？*/
大佐_003: {
Daf&~ur haben wir nicht genug Zeit.
}
//	<<<ENGLISH>>>
//	None. There's no time.

/*ダメだ。
今からでは時間がない。*/
ライデン_004: {
Was f&~ur einen Sprengstoff ist es?
}
//	<<<ENGLISH>>>
//	Which type of explosives is it?

/*爆弾はどっちのタイプだ？*/
大佐_005: {
Das hat er nicht gesagt.
}
//	<<<ENGLISH>>>
//	He didn't say.

/*そこまでのヒントはもらえなかった。*/
}//d




resource P035_01_R01_ファットマン爆弾解体終了１無線デモ１＿１__g {
//vc113501
大佐_000: {
Gute Arbeit, Raiden.
Scheint als w&~aren alle Bomben entsch&~arft.
}
//	<<<ENGLISH>>>
//	Good work, Raiden. Looks like
//	all the bombs are neutralized.

/*ライデン、よくやった。爆弾は全て除去
できたようだな。*/
//<ページ数変更>
大佐_000_1: {
und damit auch ihr wichtigstes Druckmittel.
Dann bleibt noch.
}
//	<<<ENGLISH>>>
//	One of their main leverages
//	is now gone. That leaves --

/*これで奴等の脅しは
一つ無効になった。あとは……。*/
ライデン_001: {
Oberst, Fatman schien von dem L&~osegeld
nichts zu wissen.
}
//	<<<ENGLISH>>>
//	Colonel, Fatman didn't seem to
//	know about the ransom demands.

/*大佐、ファットマンは要求のことを
知らなかったようだが……？*/
大佐_002: {
Absichtlich im Dunkeln gelassen,
w&~urde ich sagen.
}
//	<<<ENGLISH>>>
//	Intentionally kept
//	in the dark, I'd say.

/*知らされていなかっただけではないのか？
*/
//<ページ数変更>
大佐_002_1: {
Er schien auf einer ganz anderen Ebene
zu sein als die anderen Terroristen.
}
//	<<<ENGLISH>>>
//	He seemed to be coming from a
//	very different place from the
//	other terrorists.

/*彼は他のテロリスト達とは違う目的で
動いていたようだ。*/
ライデン_003:
''
//	<<<ENGLISH>>>
//	...

// どっかから「しかし」を持ってくる。
/*しかし……。*/
大佐_004: {
Raiden, viele Geiseln, darunter unser
Pr&~asident, sind noch in Gefahr.
}
//	<<<ENGLISH>>>
//	Raiden, a lot of hostages --
//	our President included --
//	are still in danger.

/*ライデン、まだ大統領をはじめ、多くの
人質がいる。*/
//<ページ数変更>
大佐_004_1: {
Konzentrier Dich ganz auf sie.
}
//	<<<ENGLISH>>>
//	Keep your mind focused
//	on protecting them.

/*彼らの命がいまだ危険に
さらされているのを忘れるな。*/
ライデン_005: {
Wie lautet mein Befehl?
}
//	<<<ENGLISH>>>
//	... What are my orders?

/*……次の指示は？*/
大佐_006: {
Befreie den Pr&~asidenten.
}
//	<<<ENGLISH(2)>>>
//	Rescue the President.

/*大統領を救出するんだ。*/
ライデン_007: {
Wir haben keine Ahnung, wo er steckt.
}
//	<<<ENGLISH>>>
//	We have no idea where he is.

/*手がかりがない……。*/
大佐_008: {
Du warst noch nicht im Innersten.
Ich schlage vor, Du f&~angst da an.
}
//	<<<ENGLISH>>>
//	You haven't been in the central
//	core yet. I suggest you start
//	there...

/*中央棟はまだ調べていないだろう？
そちらを……。*/
ライデン_009: {
Einen Moment. - Einen anderer Anruf.
Soll ich ihn annehmen?
}
//	<<<ENGLISH>>>
//	Wait, I have another call.
//	Want me to take it?

/*待ってくれ、＃｛ＣＡＬＬ、コール｝＃が入った。
つないでいいか？*/
大佐_010: {
Nein, ich lege auf. Besser, unsere
Anwesenheit bleibt unbekannt.
}
//	<<<ENGLISH>>>
//	No, I'll go offline. Best to
//	keep our presence unknown.

/*いや、待て！
こちらの存在を知られてはまずい。
切るぞ。*/
}//d
resource P035_01_R01_ファットマン爆弾解体終了１無線デモ１＿２__g {
//vc113502
プリスキン_000: {
Wie geht's, mein Junge?
}
//	<<<ENGLISH>>>
//	How're you doing, kid?

/*若いの、大丈夫か？*/
ライデン_001: {
Pliskin!?
Ist alles in Ordnung?
}
//	<<<ENGLISH>>>
//	Pliskin!?
//	Is everything all right?

/*プリスキン！？
無事だったのか？*/
プリスキン_002: {
Geht so.
Scheint, als w&~are ich eine Weile
bewu&~stlos gewesen.
}
//	<<<ENGLISH>>>
//	Could be better.
//	Looks like I was out
//	cold for a while.

/*なんとかな……
しばらく気を失っていたらしい。*/
ライデン_003: {
Wie hast Du &~uberlebt?
}
//	<<<ENGLISH>>>
//	How did you manage
//	to stay alive?

/*よく生きてたな。*/
プリスキン_004: {
Ein Freund hat mir geholfen.
}
//	<<<ENGLISH>>>
//	Had a little help
//	from a friend.

/*仲間に助けられた。*/
ライデン_005: {
Freund?
}
//	<<<ENGLISH(2)>>>
//	Friend?

/*仲間？*/
プリスキン_006: {
Was ist mit der Bombe?
}
//	<<<ENGLISH>>>
//	What about the bomb?

/*爆弾はどうなった？*/
ライデン_007: {
Entsch&~arft. Und Fatman auch.
}
//	<<<ENGLISH>>>
//	Defused. And Fatman too.

/*ああ、解除した。
ファットマンも含め、全て。*/
プリスキン_008: {
Das sind gute Nachrichten.
}
//	<<<ENGLISH(2)>>>
//	That's good news.

/*そいつはいいニュースだ。*/
ライデン_009: {
Was ist mit Shell 2
}
//	<<<ENGLISH>>>
//	How's Shell 2?

/*シェル２の様子は？*/
プリスキン_010: {
Chaos.
Die Bombe hat Strebe H zerst&~ort.
}
//	<<<ENGLISH>>>
//	It's a mess.
//	The bomb crippled H Strut.

/*こっちはひどい有様だ。
爆発したＨ脚は目茶苦茶だ。*/
ライデン_011: {
Was ist mit den Giften?
}
//	<<<ENGLISH(2)>>>
//	What about the toxins?

/*有毒物質の発生は？*/
プリスキン_012: {
Den was?
}
//	<<<ENGLISH(2)>>>
//	The what?

/*なに？*/
ライデン_013: {
Wenn die Big Shell in die Luft fliegt,
wird die Explosion vermutlich riesige
Mengen von Gift erzeugen.
}
//	<<<ENGLISH>>>
//	If the Big Shell blows up, the
//	explosion is expected to produce
//	massive amounts of toxins...

/*『ビッグ・シェル』が爆発・炎上すると
大量の有毒物質が……。*/
プリスキン_014: {
Nie was davon geh&~ort.
}
//	<<<ENGLISH(2)>>>
//	Never heard anything about that.

/*そんな話は聞いていないが？*/
ライデン_015: {
Was?
}
//	<<<ENGLISH(2)>>>
//	Huh?

/*え？*/
プリスキン_016: {
Scheint, als sei da nicht viel Gefahr.
}
//	<<<ENGLISH>>>
//	Well, looks like there's not
//	much danger of that in any case.

/*まあその心配はない様だ。*/
//<ページ数変更>
プリスキン_016_1: {
Aber der mittlere Teil wird &~uberflutet.
Lange h&~alt er nicht mehr.
}
//	<<<ENGLISH>>>
//	But the central core is
//	starting to flood.
//	It won't last much longer.

/*だが爆発の衝撃で中央棟が浸水している。
長くは持たないだろうな……。*/
ライデン_017: {
Was ist mit dem Pr&~asidenten
und den anderen Geiseln?
}
//	<<<ENGLISH>>>
//	What about the President
//	and the other hostages?

/*……大統領や人質は？*/
プリスキン_018: {
Die waren nicht in Shell 2.
Bleibt nur  Shell 1.
}
//	<<<ENGLISH>>>
//	They weren't in Shell 2.
//	They must be in Shell 1.

/*いや、シェル２にはいなかった。
おそらく、シェル１だろう。*/
ライデン_019: {
Wir m&~ussen jetzt die Geiseln hier
rausbringen.
}
//	<<<ENGLISH>>>
//	We need to get the hostages
//	out of here now.

/*早く人質を待避させなければ。*/
プリスキン_020: {
Es ist zu weit,
um bis Manhattan zu schwimmen.
}
//	<<<ENGLISH>>>
//	It's too far from Manhattan
//	for a swim.

/*ここからマンハッタンまで泳ぎ切れる
距離じゃない。*/
ライデン_021: {
Mit Rettungsbooten?
}
//	<<<ENGLISH>>>
//	What about the lifeboats?

/*救命ボートみたいなものは？*/
プリスキン_022: {
Scheint keine zu geben.
Ergibt keinen Sinn.
}
//	<<<ENGLISH>>>
//	There doesn't seem to be
//	any. Doesn't make sense.

/*いや、装備されていないようだ。
考えられない事だがな。*/
ライデン_023: {
Ein Hubschrauber ist also
unser einziger Ausweg?
}
//	<<<ENGLISH>>>
//	So a chopper is
//	our only extraction?

/*ヘリで脱出しかない？*/
プリスキン_024: {
Genau. Und da pa&~st nur eine begrenzte
Anzahl von Personen rein. Angeblich sind
es rund 30 Geiseln.
}
//	<<<ENGLISH>>>
//	Right. And it comes with a passenger
//	limit. Intel has it that there are
//	about thirty hostages.

/*そうだ。しかも人数制限付き。
情報によれば人質は３０人ほどいる
そうだ。*/
ライデン_025: {
Dann m&~u&~ste er mehrmals fliegen.
}
//	<<<ENGLISH>>>
//	It'd take more than
//	a single trip.

/*１回では無理だな。*/
プリスキン_026: {
Wir m&~ussen zur&~uckkommen.
}
//	<<<ENGLISH>>>
//	We'll have to come back.

/*往復するしかない。*/
ライデン_027: {
Kannst Du einen Hubschrauber fliegen?
}
//	<<<ENGLISH>>>
//	Can you pilot a chopper?

/*ヘリの操縦はできるのか？*/
プリスキン_028: {
Nein, aber ich habe einen Experten dabei.
Er ist in Ordnung. Ich mache Euch sp&~ater
bekannt.
}
//	<<<ENGLISH>>>
//	No, but I brought a gearhead with
//	me. He's a good guy. I'll introduce
//	you later.

/*いや、しかし、メカオタクの仲間を
連れてきている。信用できる奴だ。
後で紹介する。*/
ライデン_029: {
Pliskin, ich bin jetzt am Heliport. Aber ich
sehe ihren Harrier nicht. Er mu&~s irgendwo
da drau&~sen sein.
}
//	<<<ENGLISH>>>
//	Pliskin, I'm on the heliport right
//	now, but I don't see their Harrier.
//	It's out somewhere.

/*プリスキン、今ヘリポートだが、
敵のハリアーが見えない。
出払っているようだ。*/
プリスキン_030: {
La&~s uns loslegen. Wenn ein Harrier
hinter uns her ist, haben wir so gut
wie keine Chance.
}
//	<<<ENGLISH>>>
//	We'd better move now then. Our
//	chances with a Harrier after us
//	are close to nothing.

/*今のうちだな。
ハリアーに狙われたら終わりだ……。*/
ライデン_031: {
Wei&~st Du, wo der Pr&~asident ist?
}
//	<<<ENGLISH>>>
//	Do you know where
//	the President is?

/*大統領は？*/
プリスキン_032: {
Nein, das ist Deine Aufgabe.
}
//	<<<ENGLISH>>>
//	No. That one's all yours.

/*わからない。そっちは任せる。*/
ライデン_033: {
Wir m&~ussen den Pr&~asidenten zuerst retten.
Das ist unser Befehl, Leutnant.
}
//	<<<ENGLISH>>>
//	The President is at the top of our
//	rescue list. These are our orders,
//	Lieutenant J.G..

/*救出は大統領が優先だぞ。
それが俺達の任務だ。*/
プリスキン_034: {
Dein Befehl, nicht meiner.
}
//	<<<ENGLISH>>>
//	Your orders. Not mine.

/*お前の、だろう？
勘違いするな。*/
ライデン_035: {
Was?
}
//	<<<ENGLISH(2)>>>
//	What?

/*なに？*/
プリスキン_036: {
Bis sp&~ater.
}
//	<<<ENGLISH(2)>>>
//	See you later.

/*じゃあな。*/
}//d



resource P036_03_R01_忍者登場３無線デモ１＿１__g {
//vc113601
オルガ_000: {
Ich glaube, hier ist es sicherer.
}
//	<<<ENGLISH>>>
//	This is safer, I think.

/*こちらの方が都合が良い。*/
ライデン_001: {
Sicher wovor?
}
//	<<<ENGLISH>>>
//	Safe from what?

/*……都合？*/
オルガ_002: {
Lauschern nat&~urlich.
}
//	<<<ENGLISH>>>
//	Eavesdropping, of course.

/*人に聞かれる心配がない。*/
ライデン_003: {
Na gut - warum hast Du mich kontaktiert?
}
//	<<<ENGLISH>>>
//	All right -- why did
//	you contact me?

/*ああ……なぜ俺に接触を？*/
オルガ_004: {
Ich habe den Befehl, Dich zu unterst&~utzen.
Das hei&~st auch, da&~s ich Dich bei Bedarf
informiere.
}
//	<<<ENGLISH>>>
//	I've been ordered to give you
//	backup, including the relaying
//	of necessary intel.

/*情報供給も含め、おまえをサポートする
ように言われている。*/
ライデン_005: {
Befehl von wem?
}
//	<<<ENGLISH>>>
//	Ordered by whom?

/*誰に？*/
オルガ_006:
''
//	<<<ENGLISH>>>
//	...

/*……。*/
ライデン_007: {
Warum gibst Du Dich nicht zu erkennen?
}
//	<<<ENGLISH>>>
//	Why won't you identify
//	yourself?

/*何故正体を明かさない？*/
オルガ_008: {
Es besteht kein Grund f&~ur Dich,
es zu wissen
}
//	<<<ENGLISH>>>
//	There is no need
//	for you to know.

/*お前が知る必要はない。*/
ライデン_009: {
Das entscheide ich.
}
//	<<<ENGLISH>>>
//	I'll decide whether
//	I need to know.

/*必要あるかどうかは俺が決める。*/
オルガ_010: {
F&~ur derartige Entscheidungen vertraue
ich Dir noch nicht.
}
//	<<<ENGLISH>>>
//	You are not yet trusted
//	to make such decisions.

/*お前に判断する資格は与えられていない。*/
ライデン_011:
''
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
オルガ_012: {
Stattdessen werde ich Dir etwas sagen,
was Du zu wissen brauchst.
}
//	<<<ENGLISH>>>
//	I'll tell you something you
//	do need to know, instead.

/*かわりに知る必要があることを
教えてやろう。*/
オルガ_013: {
Wo sich der Pr&~asident derzeit befindet.
}
//	<<<ENGLISH(2)>>>
//	The current location
//	of the President.

/*大統領の居場所だ。*/
ライデン_014: {
Was!
}
//	<<<ENGLISH>>>
//	What!

/*なに？*/
オルガ_015: {
Oder vielmehr, wer den derzeitigen
Aufenthaltsort des Pr&~asidenten kennt.
}
//	<<<ENGLISH>>>
//	Or rather, the person who
//	knows the current location
//	of the President.

/*正確には大統領の居場所を知っている
人間……。*/
ライデン_016: {
Wer ist es?
}
//	<<<ENGLISH>>>
//	Who is it?

/*誰だ？*/
オルガ_017: {
Ein Geheimagent namens Ames,
er ist auch eine Geisel.
}
//	<<<ENGLISH>>>
//	A Secret Service agent named Ames,
//	currently being held with the other
//	hostages.

/*エイムズというシークレット・サービス
だ。今は人質と共に捕らえられている。*/
ライデン_018: {
Geheimdienst. Na, sowas.
}
//	<<<ENGLISH>>>
//	Secret Service, huh.

/*シークレット・サービス？*/
オルガ_019: {
Der Chef des Sicherheitsstabes
des Pr&~asidenten.
}
//	<<<ENGLISH>>>
//	The head of the President's
//	security detail.

/*そうだ。エイムズはシークレット・
サービスの中でも特別な地位にある。*/
オルガ_020: {
Ames ist mit der gleichen VIP-Nanoanlage
ausgestattet wie der Pr&~asident.
}
//	<<<ENGLISH>>>
//	Ames has been fitted with the same
//	type of VIP nanomachine system as
//	the President.

/*大統領のものと同じ要人用ナノマシンが
注入されていて、*/
//<ページ数変更>
オルガ_020_1: {
Wenn Du in Reichweite bist,
kannst du kommenizieren.
}
//	<<<ENGLISH>>>
//	If you're within range, you
//	should be able to communicate.

/*近くにいれば相互に
体内通信が可能だ。*/
ライデン_021: {
Warum erz&~ahlst Du mir das?
}
//	<<<ENGLISH>>>
//	Why are you telling me this?

/*……なぜ俺にそんなことを教える？*/
オルガ_022: {
Mu&~s ich das wirklich wiederholen?
}
//	<<<ENGLISH>>>
//	Do I need to repeat myself?

/*同じ言葉を何度言わせる気だ？*/
ライデン_023: {
Ich habe keinen Grund, Dir auch nur
ein Wort zu glauben. Verstehst Du?
}
//	<<<ENGLISH>>>
//	There's no reason for me
//	to believe any of this.
//	You understand that?

/*……俺がお前を信じなければならない
理由もないと思うが？*/
オルガ_024: {
Nat&~urlich.
Aber Du hast keine andere Wahl.
}
//	<<<ENGLISH>>>
//	Of course. But you also have
//	no choice but to believe.

/*無論だ。しかしお前は信じざるを得ない。
そうだろう？*/
ライデン_025:
''
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
オルガ_026: {
Hast Du etwa andere Spuren?
}
//	<<<ENGLISH>>>
//	Do you have any other leads?

/*他に手がかりがあるのか？*/
ライデン_027: {
Wo sind die Geiseln?
}
//	<<<ENGLISH>>>
//	...Where are those hostages?

/*……人質はどこにいる？*/
オルガ_028: {
Ha ha ha ha.
}
/*
ふふん。*/
}//d





resource P036_08_R02_忍者登場８無線デモ２＿１__g {
//vc113611
オルガ_000: {
Du solltest Dich beeilen.
Schlie&~slich haben sie die Atomwaffe.
}
//	<<<ENGLISH>>>
//	I suggest you hurry.
//	They have the nuke
//	on their side.

/*急いだ方が良いぞ。
奴等には核がある。*/
ライデン_001: {
Atomwaffe!?
Sie haben eine Kernwaffe BEI SICH?
}
//	<<<ENGLISH>>>
//	The nuke!? They have a
//	nuclear weapon WITH them?

/*核！？
奴等、核兵器を持ち込んでいるのか！？*/
オルガ_002: {
Hat Dich ihre andauernde Pr&~asenz hier
nicht &~uberrascht?
}
//	<<<ENGLISH>>>
//	You didn't find their continuing
//	presence here unusual?

/*お前はおかしいと思わなかったのか？*/
オルガ_003: {
Selbst mit dem Pr&~asidenten als Geisel.
Dies hier ist eine Insel - und sie haben
keinen offensichtlichen Fluchtweg.
}
//	<<<ENGLISH>>>
//	Even with the President as hostage,
//	this is an island -- and they have
//	no visible means of escape...

/*大統領を人質にとっているとはいえ、
なぜ奴等はここにとどまっているのか？*/
/* 意味包含
//<ページ数変更>
オルガ_004: {
逃げ場のないこの孤島に……
脱出手段も用意せず。
}
*/
ライデン_005: {
Selbst wenn sie eine Atomwaffe besitzen -
ohne Zugangscode n&~utzt ihnen der
Sprengkopf nichts.
}
//	<<<ENGLISH>>>
//	...Even if they do have a nuke,
//	the warhead is no good without
//	an access code.

/*例え奴等が核兵器を持ち込んだとしても、
核弾頭には安全装置が組み込まれている
はずだ。*/
//<ページ数変更>
ライデン_005_1: {
Die Sicherheitssperre kann
man nicht umgehen.
}
//	<<<ENGLISH>>>
//	The security lockout
//	can't be bypassed...

/*起爆コード入力式の……。
}*/
オルガ_006: {
Brauchen sie auch nicht.
Sie haben den Code.
}
//	<<<ENGLISH>>>
//	They don't need to.
//	They have the code.

/*それも奴等は手に入れている。*/
}//d


resource P036_10_R03_忍者登場１０無線デモ３＿１__g {
//vc113621
ライデン_000: {
Warum mu&~sten sie den Aktentasche
mitbringen?
}
//	<<<ENGLISH>>>
//	Why did they have to bring
//	the football along?

/*なぜここにブラックケースを
持ち込んだんだ？
*/
//<ページ数変更>
ライデン_000_1: {
Und dann noch in eine
Dekontaminationsanlage.
}
//	<<<ENGLISH>>>
//	To a decontamination
//	plant, of all places.

/*ただの除染プラントに……。*/
オルガ_001: {
Es war n&~otig.
}
//	<<<ENGLISH>>>
//	But they did have to.

/*答えは簡単だ。*/
//<ページ数変更>
オルガ_001_1: {
Die Big Shell ist schlie&~slich alles
andere als eine Reinigungsanlage.
}
//	<<<ENGLISH>>>
//	Because, after all, the Big Shell
//	is the farthest thing from a cleanup
//	plant there is.

/*『ビッグ・シェル』は
除染プラントなどではないからだよ。*/
ライデン_002: {
Was!?
}
//	<<<ENGLISH(2)>>>
//	What!?

/*なに！？*/
オルガ_003: {
Dead Cell mu&~ste nicht erst eine Atomwaffe
mitbringen. Die war schon da.
}
//	<<<ENGLISH>>>
//	Dead Cell didn't have to bring
//	a nuke along with them.
//	It was right here to begin with.

/*核も奴等が持ち込んだのではない。
初めからここにあるものだ。
*/
//<ページ数変更>
オルガ_003_1: {
Hier ist nichts so, wie es auf
den ersten Blick erscheint.
}
//	<<<ENGLISH>>>
//	Nothing in this affair
//	is what it seems...

/*そう、全ては偽装……。*/
ライデン_004: {
Ein Deckmantel - aber warum? Wof&~ur?
}
//	<<<ENGLISH>>>
//	A cover-up -- but
//	why? For what?

/*偽装！？いったい何の？*/
オルガ_005: {
F&~ur den Metal Gear,
der hier untergebracht ist.
}
//	<<<ENGLISH(2)>>>
//	For Metal Gear,
//	that is housed here.

/*ここには……メタルギアがある……。*/
}//d



resource P036_13_R04_忍者登場１３無線デモ４＿１__g {
//vc113631
ライデン_000: {
Oberst, wer war der Mann gerade?
}
//	<<<ENGLISH>>>
//	Colonel, who was
//	that man just now?

/*大佐、今の男は何者だ？*/
大佐_001: {
Keiner unserer M&~anner.
}
//	<<<ENGLISH>>>
//	He's not one of ours.

/*我々の仲間ではない。*/
大佐_002: {
Nein - so eine Person ist nicht
in unserer Einheit.
}
//	<<<ENGLISH>>>
//	No -- we have no one
//	like that in our unit.

/*違う……うちにあんな隊員はいない。*/
ライデン_003: {
Er sagte, da&~s in der Big Shell ein neues
Metal Gear-Modell aufbewahrt wird.
}
//	<<<ENGLISH>>>
//	He said that the Big Shell
//	was housing a new model
//	of Metal Gear.

/*この『ビッグ・シェル』に
新型メタルギアがあると言っていたが？
*/
大佐_004: {
Das ist mir ganz neu.
}
//	<<<ENGLISH>>>
//	First I've heard of it.

/*初耳だ……。*/
ライデン_005: {
Oberst, was verheimlichst Du mir?
}
//	<<<ENGLISH>>>
//	Colonel, what are
//	you not telling me?

/*大佐、俺に何を隠している？*/
大佐_006: {
Ich war ganz offen zu Dir, Raiden.
Ich habe Dir alles gesagt.
}
//	<<<ENGLISH>>>
//	I've been completely open
//	with you, Raiden. I've told
//	you everything.

/*いや。隠し事などしていない。
全て話している。*/
ライデン_007: {
Alles, was Du wei&~st  -
oder alles, was ich wissen mu&~s?
}
//	<<<ENGLISH>>>
//	Is that everything you know
//	-- or everything I need to
//	know?

/*……それは大佐の知っている全てか？
それとも俺に話していいと許可された
ことの全てか？*/
大佐_008: {
H&~or auf damit, Raiden!
}
//	<<<ENGLISH>>>
//	Snap out of it, Raiden!

/*馬鹿なことを言うな、ライデン！*/
ライデン_009:
''
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
大佐_010: {
Ich werde daf&~ur sorgen, da&~s das Metal
Gear-Ger&~ucht untersucht wird.
Kontaktiere diesen Ames.
}
//	<<<ENGLISH>>>
//	I'll have the Metal Gear rumor
//	looked into. You need to make
//	contact with this Ames.

/*メタルギアについてはこちらでも調べて
みる。君はエイムズに接触してくれ。*/
ライデン_011: {
Du glaubst also diesem Ninja?
}
//	<<<ENGLISH>>>
//	So you believe that Ninja?

/*あの男の言うことを信じろと？*/
大佐_012: {
Da wir nicht wissen, wo sich der Pr&~asident
derzeit aufh&~alt, bleibt uns nichts anderes
&~ubrig.
}
//	<<<ENGLISH>>>
//	Since we have no leads on the
//	President's current location,
//	we have no other alternatives.

/*他に大統領につながる手がかりがない
以上、今は他に方法がない。*/
大佐_013: {
Sammle m&~oglichst viele Informationen.
Alles, was Du &~uber Metal Gear erfahren
kannst.
}
//	<<<ENGLISH>>>
//	Right now, collect as much
//	data as you can, including
//	anything on Metal Gear.

/*メタルギアのことも含めて情報を
得るんだ。*/
ライデン_014: {
Sind das meine Befehle?
}
//	<<<ENGLISH>>>
//	Are those my orders.

/*それが指令か？*/
大佐_015: {
Ja. Verkleide Dich als gegnerischer Soldat
und dringe in den Kern von Shell 1 ein.
}
//	<<<ENGLISH>>>
//	Yes they are. Disguise yourself
//	as an enemy soldier and infiltrate
//	the Shell 1 Core.

/*そうだ。敵兵士に変装して
シェル１中央棟に潜入しろ。*/
ライデン_016: {
Verstanden.
}
//	<<<ENGLISH>>>
//	...Understood.

/*……了解。*/
}




resource P037_01_R01_スネークの遺体１無線デモ１＿１__g {
//vc113701
ローズ_000: {
Hast Du einen Moment Zeit, Jack?
}
//	<<<ENGLISH>>>
//	Got a minute, Jack?

/*ジャック、ちょっといい？*/
ライデン_001: {
Rose?
}
//	<<<ENGLISH(2)>>>
//	Rose?

/*ローズ？*/
ローズ_002: {
Ich habe Informationen &~uber
das Grab von Solid Snake.
}
//	<<<ENGLISH>>>
//	I found some information on
//	where Solid Snake is interred.

/*頼まれていたスネークの
遺体の調査だけど……。*/
ライデン_003: {
Klasse, schie&~s los.
}
//	<<<ENGLISH>>>
//	Great. Shoot.

/*どうだった？*/
ローズ_004: {
Ich habe das Grab gefunden.
}
//	<<<ENGLISH>>>
//	I've located the grave site.

/*スネークの墓を見つけた。*/
ライデン_005: {
Und der K&~orper?
}
//	<<<ENGLISH>>>
//	And the body?

/*それで遺体は？*/
ローズ_006: {
Wurde f&~ur DNA-Tests exhumiert.
}
//	<<<ENGLISH>>>
//	Exhumed for DNA testing.

/*スネークの墓を掘り起こして、
ＤＮＡ鑑定をしたわ。*/
ライデン_007: {
Und? Wie ist das Ergebnis?
}
//	<<<ENGLISH>>>
//	Well? Do you have the results?

/*結果は？*/
ローズ_008: {
Der rechte Arm fehlte, aber es besteht
kein Zweifel: Er war's. Es ist Solid Snakes
K&~orper.
}
//	<<<ENGLISH>>>
//	The right arm was missing, but
//	there was no doubt that it was him.
//	That body belongs to Solid Snake.

/*右腕が欠損していたものの、
ソリッド・スネークに間違いない。
彼はすでに死んでいる。*/
ライデン_009: {
Hrmmm. Der Anf&~uhrer
der Terroristen ist also.
}
//	<<<ENGLISH>>>
//	Hrmmm... So the head of
//	the terrorist group must
//	be --

/*ううん……となると、
今回のテロリストは？*/
ローズ_010: {
Ein Betr&~uger.
}
//	<<<ENGLISH>>>
//	An impostor.

/*スネークを語る偽物。*/
ライデン_011: {
Genau.
}
//	<<<ENGLISH(2)>>>
//	Right...

/*そうか……。*/
ローズ_012: {
Du klingst entt&~auscht.
}
//	<<<ENGLISH>>>
//	You sound disappointed.

/*どうしたの？
がっかりしたようだけど。*/
ライデン_013: {
Ich glaube - ich hoffte wohl, der Legende
in Fleisch und Blut zu begegnen.
}
//	<<<ENGLISH>>>
//	I guess -- I guess I was kind of
//	hoping to meet the legend in the
//	flesh.

/*いや、伝説の男に会えるかもしれないと、
どこかで期待していた。*/
ローズ_014: {
Verstehe. Sieht so aus, als ob ein anderer
hinter diesem Fall steckt.
}
//	<<<ENGLISH>>>
//	I get you. But it looks
//	like he's not behind this
//	incident.

/*そうね。
でも彼は今回の主犯ではない。*/
大佐_015: {
Raiden, ich glaube,
der Pr&~asident braucht Dich.
}
//	<<<ENGLISH>>>
//	Raiden, the President
//	needs you, I think.

/*ライデン、大統領の手がかりを追うんだ。*/
大佐_016: {
Verkleide Dich wie der Feind
und infiltriere den Kernabschnitt.
}
//	<<<ENGLISH>>>
//	Disguise yourself as enemy
//	personnel and infiltrate the
//	core section.

/*テロリストに化けて、中央棟に潜入しろ。
*/
//<ページ数変更>
大佐_016_1: {
In erster Linie mu&~st Du Agent Ames
finden.
}
//	<<<ENGLISH>>>
//	Your priority is to
//	contact Agent Ames.

/*エイムズを探すんだ。*/
}




resource P040_02_R02_エイムズ発見２無線デモ１＿１__g {
//vc114001
エイムズ_000: {
Bist Du dran?
}
//	<<<ENGLISH>>>
//	Are you on?

/*聞こえるか？*/
ライデン_001: {
Ja, hier bin ich.
}
//	<<<ENGLISH(2)>>>
//	Right here.

/*大丈夫だ。*/
ライデン_002: {
Wei&~st Du wirklich, wo der Pr&~asident ist?
}
//	<<<ENGLISH>>>
//	Do you really know where
//	the President is?

/*あんた、本当に大統領の居場所を？*/
エイムズ_003: {
H&~ochstwahrscheinlich. Er wurde in den
ersten Stock im Kern von Shell 2 verlegt.
}
//	<<<ENGLISH>>>
//	Almost certainly. He was moved
//	to the first floor of Shell 2's core
//	section.

/*ああ。
シェル２中央棟の１Ｆに移されたらしい。*/
ライデン_004: {
1. Etage, der Kern von Shell 2.
}
//	<<<ENGLISH(2)>>>
//	The first floor,
//	the core of Shell 2...

/*シェル２中央棟の１Ｆ……。*/
ライデン_005: {
Ist er da noch immer?
}
//	<<<ENGLISH>>>
//	Is he still there?

/*今もそこにいるのか？*/
エイムズ_006: {
Das wei&~s ich nicht.
Ich bekomme keine Antwort.
}
//	<<<ENGLISH>>>
//	I don't know. I can't
//	get a response.

/*いや、今は反応がない。*/
ライデン_007: {
Du glaubst doch nicht, er wurde -
wie die anderen Geiseln?
}
//	<<<ENGLISH>>>
//	You don't think he's been --
//	like the other hostages...?

/*まさか、他の人質のように……？*/
エイムズ_008: {
?
}
//	<<<ENGLISH(2)>>>
//	?

/*？*/
ライデン_009: {
Nachdem die SEAL 10-Operation
mi&~sgl&~uckte, wurde eine Geisel
get&~otet, wei&~st Du nicht mehr?
}
//	<<<ENGLISH>>>
//	A hostage was killed in
//	retaliation after the SEAL
//	10 disaster, remember?

/*ＳＥＡＬ１０が突入した報復に人質が
殺されただろう？*/
エイムズ_010: {
Wovon sprichst Du?
}
//	<<<ENGLISH(2)>>>
//	What are you talking about?

/*何のことだ？*/
ライデン_011: {
?
}
/*……？*/
エイムズ_012: {
Egal, was sie mit den anderen Geiseln
machen, den Pr&~asidenten r&~uhren sie
nicht an.
}
//	<<<ENGLISH>>>
//	Regardless of what they do
//	to other hostages, they won't
//	touch the President.

/*他の人質はともかく、
奴等は大統領を殺さない。*/
ライデン_013: {
Wie kannst Du so sicher sein?
}
//	<<<ENGLISH>>>
//	What makes you so sure?

/*なぜそう言い切れる？*/
エイムズ_014: {
Der Koffer.
}
//	<<<ENGLISH>>>
//	The case.

/*ブラックケースだよ。*/
ライデン_015: {
Du meinst den 'Roten knopf'?
}
//	<<<ENGLISH>>>
//	You mean the nuclear
//	button they took?

/*奴等が奪っていった、
核兵器を解除するケースのことか？*/
エイムズ_016: {
Genau. Aber der Koffer allein
nutzt ihnen nichts.
}
//	<<<ENGLISH>>>
//	Right. And the case won't
//	do a thing by itself.

/*そうだ。
奴等はブラックケースを奪った。
だがそれだけでは意味を成さない。*/
エイムズ_017: {
Der Koffer ist das vielleicht modernste
Muster eines ausfallsicheren
Waffensystems.
}
//	<<<ENGLISH>>>
//	That case may be the single most
//	advanced example of a weapons
//	fail-safe system.

/*あのケースは最新ハイテク技術の粋を
集めたものだ。*/
エイムズ_018: {
Das Pa&~swort sind die physiologischen
Daten des amerikanischen Pr&~asidenten.
}
//	<<<ENGLISH>>>
//	The password is nothing less than
//	the physiological data of the U.S.
//	President.

/*合衆国大統領の生体データを用いる
暗号システムを採用している。*/
ライデン_019: {
Physiologische Daten?
}
//	<<<ENGLISH>>>
//	Physiological data?

/*生体データ？*/
エイムズ_020: {
Die Lebenszeichen des Pr&~asidenten -
Herzschlag, Gehirnstr&~ome, Blutdruck usw.
}
//	<<<ENGLISH(2)>>>
//	The President's own vital signs --
//	heartbeat, brainwave pattern,
//	blood pressure and so on --

//<ページ数変更>
エイムズ_020_1: {
- werden fortlaufend &~uberwacht und &~uber
seine internen Nanomaschinen &~ubertragen.
}
//	<<<ENGLISH>>>
//	are constantly monitored and
//	relayed by his internal nano-
//	machines.

/*大統領体内のナノマシンから
ＤＮＡ情報、鼓動、脳波、血圧等を
送信し、それを鍵とするんだ。*/
エイムズ_021: {
Zusammen mit seinem DNA-Muster dienen
diese Daten als biometrisches Pa&~swort,
}
//	<<<ENGLISH>>>
//	This information along with the
//	DNA pattern serve as a biometric
//	password, unbreakable even by＃−

//<ページ数変更>
エイムズ_021_1: {
das selbst von den neuesten
Superrechnern nicht geknackt
werden kann.
}
//	<<<ENGLISH>>>
//	the latest parallel processor
//	supercomputers.

/*最新の超並列コンピュータを使っても
破ることは出来ない。*/
エイムズ_022: {
Das Pa&~swort kann nur dann eingesetzt
werden, wenn die Gehirnstr&~ome und
Herzschl&~age im normalen Bereich liegen.
}
//	<<<ENGLISH>>>
//	The password entry itself cannot
//	be performed unless brainwave
//	patterns and heartbeats＃−

//<ページ数変更>
エイムズ_022_1: {
Drogen und andere bedrohungen
auszu&~uben, sind damit zwecklos.
}
//	<<<ENGLISH>>>
//	fall within normal parameters,
//	rendering chemical and other
//	forms of coercion impractical.

/*入力は脳波・心拍数等が通常の状態で
なければ無効になる。薬物や脅迫で
入力させることは出来ない。*/
エイムズ_023: {
Mit anderen Worten, der Pr&~asident
mu&~s sich freiwillig anmelden.
}
//	<<<ENGLISH>>>
//	In other words, the login must
//	be made of the President's own
//	free will.

/*つまり大統領本人が、自分自身の意志で
直接入力しなければ入力は認められない
仕組みになっている。*/
エイムズ_024: {
Zur Sicherheit mu&~s die Eingabe nach
dem ersten Anmelden st&~undlich best&~atigt
werden.
}
//	<<<ENGLISH>>>
//	As a fail-safe, the input must also
//	be reconfirmed hourly, even after
//	the initial login.

//<ページ数変更>
エイムズ_024_1: {
Liegt keine g&~ultige Best&~atigung vor,
bricht das System automatisch
die Anmeldung ab.
}
//	<<<ENGLISH>>>
//	If a valid confirmation is not
//	forthcoming, the system will
//	automatically cancel the login.

/*その上、入力後も一定時間毎に
ＩＤ確認が義務づけられ、確認が得られ
ない場合、コード入力は取り消される。*/
ライデン_025: {
Darum k&~onnen sie dem Pr&~asidenten
nichts tun.
}
//	<<<ENGLISH>>>
//	And that's why they can't
//	harm the President...

/*だから奴等は大統領を殺さない……？*/
エイムズ_026: {
-zumindest, bis die Bombe gez&~undet
wurde.
}
//	<<<ENGLISH>>>
//	-- at least until the bird flies.

/*少なくとも核を撃つまでは、な。*/
ライデン_027: {
Gibt es hier wirklich ein neues
Metal Gear-Modell?
}
//	<<<ENGLISH>>>
//	Is there really a new model
//	of Metal Gear here?

/*……ここには本当に核が……
新型メタルギアがあるのか？*/
エイムズ_028: {
Nat&~urlich. Der schwarze Koffer
aktiviert auch Metal Gear.
}
//	<<<ENGLISH>>>
//	Absolutely. The Black Case serves
//	as the launch key to Metal Gear as
//	well.

/*無論だ。ブラックケースのシステムは
核兵器の解除だけではなく、
新型メタルギア起動の鍵も兼ねている。*/
ライデン_029: {
Warum sollten sie ein Metal Gear
hier im Meer verstecken?
}
//	<<<ENGLISH>>>
//	Why would they hide a Metal
//	Gear in an offshore plant?

/*なぜ海上除染施設にメタルギアが？*/
エイムズ_030: {
Haben sie Dir denn nichts erz&~ahlt?
}
//	<<<ENGLISH>>>
//	...Haven't they told
//	you anything?


/*……何も聞かされていないのか？*/
ライデン_031:
''
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
エイムズ_032: {
Es war alles geplant - der Tankerunfall,
der einen &~Olteppich verursachte, alles.
}
//	<<<ENGLISH>>>
//	The entire thing was planned --
//	the oil spill, the tanker accident
//	that caused it, everything.

/*全て偽装だ。原油汚染も、
その原因となったタンカーの沈没も。
何もかもな。*/
エイムズ_033: {
Die Big Shell wurde speziell zur
Entwicklung eines neuen Metal
Gear-Modells gebaut.
}
//	<<<ENGLISH>>>
//	The Big Shell was built specifically
//	for the development of a new Metal
//	Gear model.

/*この『ビッグ・シェル』は
新型メタルギア開発を行うために
建造された。*/
エイムズ_034: {
Die Inspektionstour sollte
die Fortschritte &~uberpr&~ufen.
}
//	<<<ENGLISH>>>
//	The inspection tour was
//	to check its progress...

/*今回の視察も、その進捗を確かめる
ためのものだった……。*/
ライデン_035: {
Was geht hier vor?
}
//	<<<ENGLISH>>>
//	What's going on around here...

/*どういうことなんだ？*/
エイムズ_036: {
Warte!
}
//	<<<ENGLISH(2)>>>
//	Wait!

/*待て！*/
}
//d



resource P040_06_R02_エイムズ発見６無線デモ２＿１__g {
//vc114011
エイムズ_000: {
Und, was hast Du geh&~ort?
}
//	<<<ENGLISH>>>
//	Anyway, what did you
//	manage to catch?

/*それより、奴等は何を？*/
ライデン_001: {
Es hie&~s, das Pa&~swort sei vollst&~andig
eingegeben.
}
//	<<<ENGLISH>>>
//	They said password
//	input was complete...

/*コード入力は終わったと言っていた……。*/
エイムズ_002: {
Das habe ich mir gedacht.
}
//	<<<ENGLISH>>>
//	I thought so...

/*やはり……。*/
ライデン_003: {
Du hast doch gesagt, der Pr&~asident m&~usse
das Pa&~swort freiwillig in den schwarzen
Koffer eingeben.
}
//	<<<ENGLISH>>>
//	You said the password entry into
//	the Black Case had to be made by
//	the President willingly.

/*あんた、ブラックケースは大統領が
自分の意志で入力しなければならない、
と言ったな。*/
エイムズ_004: {
Das stimmt.
}
//	<<<ENGLISH(2)>>>
//	That's right.

/*ああ。*/
ライデン_005: {
Das hei&~st also, der Pr&~asident
arbeitet mit ihnen zusammen?
}
//	<<<ENGLISH>>>
//	So this means the President
//	is cooperating with them?

/*では大統領自身が奴等に手を貸している
と言うことか？*/
エイムズ_006: {
Ja, so mu&~s es sein.
}
//	<<<ENGLISH>>>
//	It would have to be, yes.

/*そうなるな。*/
ライデン_007: {
Warum?
}
//	<<<ENGLISH(2)>>>
//	Why?

/*一体なぜ？*/
エイムズ_008: {
Vielleicht will er keine Marionette mehr
sein. Aber es war nicht klug, uns zu
verraten.
}
//	<<<ENGLISH>>>
//	Probably tired of being a puppet.
//	But it wasn't a smart move to
//	betray us...

/*人形でいることに飽きたんだろうよ。
我々を裏切るとは……愚かな。*/
ライデン_009: {
Eine Marionette?
}
//	<<<ENGLISH>>>
//	...a puppet?

/*……人形？*/
エイムズ_010: {
Wir haben nicht mehr viel Zeit. Sie
WERDEN eine Atomwaffe abfeuern.
Du wei&~st, was Du zu tun hast.
}
//	<<<ENGLISH>>>
//	We're running out of time. They
//	WILL fire a nuke. You know what
//	you need to do before then.

/*もう時間がないぞ。奴等は必ず核を撃つ。
その前に大統領を……。*/
ライデン_011: {
Die Atomwaffe abfeuern? Aber die Frist
f&~ur das L&~osegeld ist noch nicht abgelaufen.
}
//	<<<ENGLISH>>>
//	Fire the nuke?
//	But it's nowhere close
//	to the ransom deadline.

/*核を撃つ？
要求のタイムリミットまでは
まだ時間があるぞ。*/
エイムズ_012: {
L&~osegeld?
}
//	<<<ENGLISH(2)>>>
//	Ransom?

/*要求？*/
ライデン_013: {
Drei&~sig Milliarden Dollar in bar.
}
//	<<<ENGLISH>>>
//	Thirty billion dollars in cash...

/*現金３００億ドル……。*/
エイムズ_014: {
Wovon sprichst Du? Der
Atomwaffeneinsatz ist doch keine Drohung
- das war von Anfang an das Ziel!
}
//	<<<ENGLISH>>>
//	What are you babbling about!
//	The nuclear strike is not a threat --
//	it's been the objective all along!

/*何を言っている？
核攻撃は脅迫の手段などではない。
それこそが奴等の目的だ。*/
ライデン_015: {
Sie wollen Millionen von Menschen t&~oten?
}
//	<<<ENGLISH>>>
//	They plan to slaughter
//	millions of people!?

/*大量虐殺が！？*/
エイムズ_016: {
Nein - eine Detonation in gro&~ser H&~ohe.
Hast Du vom Compton-Effekt geh&~ort?
}
//	<<<ENGLISH>>>
//	No -- a high-altitude detonation.
//	You've heard of the Compton Effect?

/*いや。奴等は高空で核を使うつもりだ。
聞いたことがあるだろう？
コンプトン効果やスカラー電磁波……。*/
ライデン_017: {
St&~orung aller elektronischen Ger&~ate
durch einen EMMA-Impuls.
}
//	<<<ENGLISH(2)>>>
//	The total disruption
//	of electronic equipment
//	caused by EMMA pulse.

/*核爆発による電子機器の破壊か？*/
エイムズ_018: {
Eine Antwort wie aus dem Lehrbuch. Eine
atomare Explosion in der Atmosph&~are
}
//	<<<ENGLISH>>>
//	Textbook answer. Well, when
//	an average nuclear warhead
//	goes off within the atmosphere,

//<ページ数変更>
エイムズ_018_1: {
erzeugt einen elektromagnetischen Impuls
von bis zu 50 Milliarden Megawatt.
}
//	<<<ENGLISH>>>
//	the result is an electromagnetic
//	pulse of up to 50 billion megawatts.

/*そうだ。大気中で核爆発が起こると
５兆メガワットを越える強烈な
電磁パルスが発生する。*/
エイムズ_019: {
Das EMMA-Feld kann Zehntausende von
Volt pro Meter erreichen,
}
//	<<<ENGLISH>>>
//	The EMMA field can reach tens
//	of thousands of volts per meter,

//<ページ数変更>
エイムズ_019_1: {
die meisten Elektroteile werden sofort
verschmoren.
}
//	<<<ENGLISH>>>
//	and most electronic equipment
//	will be toast in an instant.

/*電磁場の強さは数万ボルト／メートル
にもなり、一般の電子機器は全て
破壊される。*/
}
/* 以下の文は？ ムービー？？？
奴等はそれをマンハッタン上空で行おうとしているんだ
And this is what they plan
to do right over Manhattan.
*/
//d




resource P040_06_R02_エイムズ発見６無線デモ２＿２__g {
//vc114012
エイムズ_000: {
Aber das ist nicht ihr Ziel.
}
//	<<<ENGLISH>>>
//	But that isn't their aim.


/*いやそうではない。*/
//<ページ数変更>
エイムズ_000_1: {
Sie wollen Manhattan 'befreien', es offline
bringen und in eine Art von Republik
verwandeln.
}
//	<<<ENGLISH>>>
//	What they plan to do is "liberate"
//	Manhattan, pull it offline, and turn
//	it into some kind of a republic.

/*デジタルのくびきを
断ち切りマンハッタンを解放区とする
こと……それが奴等の狙いだ。
*/
エイムズ_001: {
Daher auch 'Sons of Liberty',
S&~ohne der Freiheit.
}
//	<<<ENGLISH(2)>>>
//	Hence "Sons of Liberty," I suppose.

/*ふん。『＃｛自由の息子達、サンズ・オブ・リバティー｝＃』とは
よく言ったものだな……。*/
ライデン_002: {
'S&~ohne der Freiheit' ?
}
//	<<<ENGLISH>>>
//	"Sons of Liberty"...?

/*『＃｛自由の息子達、サンズ・オブ・リバティー｝＃』……？*/
エイムズ_003: {
Mist, Ocelot kommt.
Ich gehe offline.
}
//	<<<ENGLISH>>>
//	Damn, Ocelot is coming!
//	I'm going offline.

/*くっマズイ。
オセロットが来る！
体内通信を解くぞ。*/
}
//d



resource P041_02_R01_エイムズ死亡後２無線デモ１＿１__g {
//vc114101
ライデン_000: {
Oberst, Ames ist tot.
Sah wie ein Herzinfarkt aus.
}
//	<<<ENGLISH>>>
//	Colonel, Ames is dead.
//	Looked like a heart attack.

/*大佐、エイムズが死んだ。
心臓発作のようだった。*/
大佐_001: {
Hm, Pech. Aber wenigstens wissen wir,
wo sich der Pr&~asident aufh&~alt.
}
//	<<<ENGLISH>>>
//	Hm, that's unfortunate. However,
//	we do at least know where the
//	President is.

/*ああ。残念なことだ。だが大統領の
居場所がわかっただけで良しとしよう。*/
ライデン_002: {
Es gibt in dieser Anlage also wirklich
eine neue Metal Gear-Version?
}
//	<<<ENGLISH>>>
//	So there really is a new type
//	of Metal Gear in this place?

/*……ここに新型メタルギアがあるのは
確かなようだが？
*/
大佐_003: {
Sieht so aus.
Die Untersuchungen laufen noch.
}
//	<<<ENGLISH>>>
//	Apparently.
//	We're still looking into it...


/*そうらしいな。
現在調査を行っている……。*/
ライデン_004: {
Mir wurde auch gesagt, da&~s der Einsatz
von Atomwaffen von Anbeginn da,
}
//	<<<ENGLISH>>>
//	I've also been told that the nuclear
//	strike was what the terrorists were
//	after from the start.

/*奴等の目的は核攻撃らしいぞ。*/
//<ページ数変更>
ライデン_004_1: {
Ziel der Terroristen war NICHT
die 30 Milliarden Dollar!
}
//	<<<ENGLISH>>>
//	NOT the thirty billion dollars!

/*現金３００億ドルではなく！！*/
大佐_005: {
Verflucht, alles nur ein
T&~auschungsman&~over.
}
//	<<<ENGLISH>>>
//	Chri--, it was a cover-up
//	all along...


/*偽装だったとはな……。*/
ライデン_006: {
Oberst, was verheimlichst Du mir!?
}
//	<<<ENGLISH>>>
//	Colonel! What are you
//	keeping from me!

/*大佐！
一体何を隠している！！*/
大佐_007: {
Gar nichts!
Schlie&~slich erfahre ich auch
nicht alle Details!
}
//	<<<ENGLISH>>>
//	I am not keeping back anything!
//	It's not as though I'm told all
//	the facts either!

/*何も隠してはおらん！
私も全てを知らされているわけでは
ないのだ。*/
ライデン_008:
''
/*……。*/
大佐_009: {
Ich lasse schon alle Beziehungen spielen,
um alles abzuchecken. nur Geduld.
}
//	<<<ENGLISH>>>
//	I'm pulling in all the favors
//	I can to look into all this.
//	Just be a little patient.

/*それらの件についてはあらゆる情報網を
使って調査をする。もう少し待ってくれ。*/
大佐_010: {
Wir sollten uns auf den Pr&~asidenten
konzentrieren.
}
//	<<<ENGLISH>>>
//	Our priority should be with
//	the President right now.

/*今問題なのは大統領だ。*/
大佐_011: {
Wir k&~onnen annehmen,
da&~s das Pa&~swort eingegeben wurde
}
//	<<<ENGLISH>>>
//	We can take it that they've
//	completed the password entry＃−

//<ページ数変更>
大佐_011_1: {
und da&~s Metal Gear f&~ur den
Nuklearschlag vorbereitet wird.
}
//	<<<ENGLISH>>>
//	and are preparing Metal Gear
//	for nuclear strike.

/*奴等がコード入力を終了し、
メタルギアによる核発射の準備を
整えていることは事実のようだ。*/
大佐_012: {
Finde den Pr&~asidenten m&~oglichst schnell.
}
//	<<<ENGLISH>>>
//	Get to the President
//	as soon as possible.

/*君は一刻も早く大統領の元へ
向かってほしい。*/
ライデン_013: {
Aber der Pr&~asident arbeitet doch
mit ihnen zusammen.
}
//	<<<ENGLISH>>>
//	But the President is
//	cooperating with them --

/*しかし大統領は奴等と……。*/
大佐_014: {
Ames zufolge, ja. Aber es stimmt auch,
da&~s sie den Pr&~asidenten bald eliminieren
wollen.
}
//	<<<ENGLISH>>>
//	According to Ames, yes. But
//	it's also true that they're about
//	to get rid of the President.

/*エイムズの話によればな。しかし奴等が
大統領を始末しようとしていることも
確かだ。*/
大佐_015: {
Hier l&~auft noch etwas.
}
//	<<<ENGLISH>>>
//	There's something
//	else going on here,

//<ページ数変更>
大佐_015_1: {
Vielleicht kann der Pr&~asident Dich
aufkl&~aren, wenn Du ihn findest.
}
//	<<<ENGLISH>>>
//	and the President may be able
//	to tell you what it is when you
//	see him in person.

/*裏にはまだ何かある。
大統領本人に会って状況を確かめるんだ。*/
ライデン_016:
''
/*……。*/
大佐_017: {
Wenn sie die Best&~atigung f&~ur den
Nuklearschlag haben, starten sie
die Bombe.
}
//	<<<ENGLISH>>>
//	Once they get the confirmation
//	for nuclear launch, they'll do it.

/*それにコードの再確認がなされれば
奴等は核を撃つ。*/
大佐_018: {
Du mu&~st den Pr&~asidenten vorher befreien.
}
//	<<<ENGLISH>>>
//	You need to rescue the
//	President before then.

/*いずれにせよ。その前に大統領の身柄を
確保するしかない。*/
ライデン_019:
''
/*……。*/
ローズ_020: {
Jack, der Oberst hat recht. Im Moment
mu&~st Du den Pr&~asidenten sch&~utzen.
}
//	<<<ENGLISH>>>
//	Jack, I agree with the Colonel.
//	You need to protect the President
//	for now.

/*ジャック……
私も大佐の言う通りだと思う。
今は大統領を……。*/
ライデン_021: {
Also sch&~on.
}
//	<<<ENGLISH(2)>>>
//	All right...

/*わかった……。*/
}
//d




resource P042_01_R01_シェル１シェル２連絡橋１無線デモ１＿１__g {
//vc114201
プリスキン_000: {
Raiden, h&~orst Du mich?
}
//	<<<ENGLISH>>>
//	Raiden, can you hear me?

/*ライデン、聞こえるか！*/
ライデン_001: {
Pliskin?
Wo hast Du denn gesteckt?
}
//	<<<ENGLISH>>>
//	Pliskin?
//	Where have you been?

/*プリスキンか？
今までどこに？*/
プリスキン_002: {
Ich habe verschiedenes &~uberpr&~uft.
Gerade bin ich in Strebe H.
Wie sieht's bei Dir aus?
}
//	<<<ENGLISH>>>
//	Checking around. I'm in
//	Strut H right now. How's
//	the situation over there?

/*ちょっとした調べものだ。
今Ｈ脚にいる。
そっちの状況は？*/
ライデン_003: {
Wir haben eine Spur, wo sich
der Pr&~asident befindet.
}
//	<<<ENGLISH>>>
//	We have a lead on the
//	President's location.

/*大統領の手がかりを得た。*/
プリスキン_004: {
Wo steckt er?
}
//	<<<ENGLISH(2)>>>
//	Where is he?

/*どこだ？*/
ライデン_005: {
Im Kern von Shell 2, erste Etage.
}
//	<<<ENGLISH(2)>>>
//	Shell 2 Core, the first floor.

/*シェル２の中央棟の１Ｆにいるらしい。*/
プリスキン_006: {
Hier bin ich vom Kern abgeschnitten.
Es ist alles chaotisch.
}
//	<<<ENGLISH>>>
//	I'm cut off from the core
//	where I am. It's a mess
//	here.

/*そうか、こっちはひどい有様だ。
ここからでは中央棟へは回れない。*/
ライデン_007: {
Okay. Ich bin schon auf dem Weg zu
Shell 2.
}
//	<<<ENGLISH>>>
//	All right. I'm on my way
//	to Shell 2 right now.

/*わかった。
これからシェル２へ向かう。*/
プリスキン_008: {
Auf der Verbindungsbr&~ucke zwischen
den Shells 1 und 2 sind IR-Sensoren
angebracht.
}
//	<<<ENGLISH>>>
//	There are IR sensors in place on
//	the connecting bridge between
//	Shells 1 and 2.

/*シェル１シェル２連絡橋には
赤外線センサーのトラップが
仕掛けられている。*/
プリスキン_009: {
Bei Unterbrechung des Strahls,
fliegt das Semtex in die Luft.
}
//	<<<ENGLISH>>>
//	If you break the beams,
//	the Semtex will go off.

/*赤外線に触れるとセムテックスが
爆発するぞ。*/
ライデン_010: {
Ja, ich habe sie davon sprechen h&~oren.
}
//	<<<ENGLISH>>>
//	Yeah, I heard them
//	talking about that.

/*ああ、奴らが話しているのを聞いた。*/
プリスキン_011: {
Ziel auf die Steuerger&~ate und vernichte sie.
Pa&~s aber auf, da&~s Du nicht auf
das Semtex schie&~st.
}
//	<<<ENGLISH>>>
//	Target the control units and
//	destroy them. Make sure you
//	don't shoot the Semtex.

/*制御装置を狙撃して破壊するんだ。
くれぐれも、セムテックス本体を
撃つんじゃないぞ。*/
/*　以下は廃止？？？*/
ライデン_012: {
Was ist mit dem K&~uhlspray?.
}
//	<<<ENGLISH>>>
//	What about the coolant spray?

//
/*爆弾解体に使った冷却スプレーは？*/
プリスキン_013: {
Das Semtex ist auf der anderen Seite
der Reling angebracht. Au&~ser Reichweite.
}
//	<<<ENGLISH>>>
//	They're not stupid. The Semtex is
//	on the other side of the railing,
//	out of reach.

//
/*奴らも馬鹿じゃない。
セムテックスは橋の裏に仕掛けてある。*/
ライデン_014: {
Wie sehen die Steuerger&~ate aus?
}
//	<<<ENGLISH>>>
//	What do the control
//	units look like?

/*破壊しなければならない装置は？*/
プリスキン_015: {
Schau mal durch Dein Fernglas.
}
//	<<<ENGLISH>>>
//	Take a look with
//	your binoculars.

/*双眼鏡で見てみるといい。*/
}
//d




resource P044_01_R01_赤外線センサークリア１無線デモ１＿１__g {
//vc114401
プリスキン_000: {
Raiden, ich habe uns eine
Mitfahrgelegenheit besorgt.
}
//	<<<ENGLISH>>>
//	Raiden, I found us a ride.

/*ライデン、いいものを手に入れたぞ。*/
ライデン_001: {
Ich bin ganz Ohr.
}
//	<<<ENGLISH>>>
//	I'm all ears.

/*いいもの？*/
プリスキン_002: {
Einer der feindlichen Kasatkas.
}
//	<<<ENGLISH>>>
//	One of the enemy's Kasatkas.

/*敵のカサッカだ。*/
ライデン_003: {
Ist er denn einsatzf&~ahig?
}
//	<<<ENGLISH>>>
//	Is it in good shape?

/*飛べるのか？*/
プリスキン_004: {
Voller Tank. Ich begebe mich jetzt zu
Shell 1. Was ist mit diesem Harrier?
}
//	<<<ENGLISH>>>
//	Full tank. I'm heading for Shell 1
//	now. What about that Harrier?

/*燃料もＯＫだ。今からシェル１へ向かう。
ハリアーはどうした？*/
ライデン_005: {
Er steht nicht auf dem Heliport.
}
//	<<<ENGLISH>>>
//	It's not on the heliport here.

/*いや、こっちのヘリポートにはいない。*/
プリスキン_006: {
Gut. Ich setze ihn dann hier ab.
}
//	<<<ENGLISH>>>
//	Good. I'll set this one
//	down there then.

/*よし、今のうちだ。そっちへ降りる。*/
ライデン_007: {
Kannst Du Deckung f&~ur die Geiseln
stellen? Sie werden in Etage B1 im
Kern festgehalten.
}
//	<<<ENGLISH(2)>>>
//	Can you cover the hostages?
//	They're being held on level
//	B1 in the core.

/*人質を頼む。
間違い＞＞＞中央棟の１Ｆに軟禁されている。
正解＞＞＞中央棟のＢ１に軟禁されている。*/
ライデン_008: {
Pliskin, Du hast nicht zuf&~allig andere
Stellen entdeckt, wo auch Geiseln
gefangengehalten werden, oder?
}
//	<<<ENGLISH>>>
//	Pliskin, you didn't happen to find
//	any other places where hostages
//	were being held, did you?

/*プリスキン、他に人質が捕らわれている
場所を見つけたか？*/
プリスキン_009: {
Nein - nichts dergleichen.
}
//	<<<ENGLISH>>>
//	No -- nothing like that.

/*いや。そんな気配はなかった。*/
ライデン_010: {
OK.
}
//	<<<ENGLISH(2)>>>
//	OK...

/*そうか……。*/
プリスキン_011: {
Wie viele Geiseln sind es?
}
//	<<<ENGLISH>>>
//	How many hostages are there?

/*人質は何人いた？*/
ライデン_012: {
Nicht ganz drei&~sig. Ein Toter,
mehrere Verletzte.
}
//	<<<ENGLISH>>>
//	There's a few short of thirty.
//	One dead, and several wounded.

/*３０名弱……うち、１名死亡した。
何人か怪我もしている。*/
プリスキン_013: {
Der Kasatkas fa&~st maximal 13 Personen.
}
//	<<<ENGLISH>>>
//	The Kasatka's cargo area
//	will hold thirteen max.

/*カサッカの貨物はどうがんばっても
１３人が限界だ。*/
ライデン_014: {
Was ist mit dem anderen Kasatka?
}
//	<<<ENGLISH>>>
//	What about the other Kasatka?

/*もう一機のカサッカは？*/
プリスキン_015: {
Ich habe ihn au&~ser Gefecht gesetzt.
So kann er uns auch nicht verfolgen
}
//	<<<ENGLISH>>>
//	I sabotaged it. It can't come after
//	us if it can't get off the ground.

/*飛べない様に細工をしておいた。
追跡されては困るからな。*/
ライデン_016: {
Oh.
}
//	<<<ENGLISH(2)>>>
//	Oh.

/*そうか。*/
プリスキン_017: {
Dann m&~ussen wir eben zweimal fliegen.
}
//	<<<ENGLISH>>>
//	We'll have to make two trips.

/*往復するしかない。*/
ライデン_018: {
Kannst Du einen Kasatka fliegen?
}
//	<<<ENGLISH>>>
//	Can you fly a Kasatka?

/*カサッカを操縦できるのか？*/
プリスキン_019: {
Ich habe einen Piloten, der das Zivilmodell,
den KA-62, im VR-Modus geflogen ist.
}
//	<<<ENGLISH>>>
//	I have a pilot who's flown the
//	civilian model, the KA-62, in VR.

/*民間用のＫＡ−６２の経験パイロットが
いる。と言ってもＶＲ訓練だがな。*/
プリスキン_020: {
Es besteht kaum ein Unterschied zum
KA.60, der vom Milit&~ar eingesetzt wird.
}
//	<<<ENGLISH>>>
//	There's not a whole lot of
//	difference between the military
//	KA-60 and the civilian model.

/*機体は軍用型のＫＡ−６０とほとんど
同じだから問題なく操縦できるだろう。*/
//（ＯＦＦ）
オタコン_021: {
Startklar.
}
//	<<<ENGLISH>>>
//	Cleared for takeoff...

/*準備完了だ……。*/
プリスキン_022: {
Raiden, ich m&~ochte meinen Partner
vorstellen - Otacon.
}
//	<<<ENGLISH>>>
//	Raiden, let me introduce you
//	to my partner -- Otacon.

/*ライデン、俺の相棒を紹介する。
オタコンだ。*/
ライデン_023: {
Otacon?
}
//	<<<ENGLISH>>>
//	"Otacon"?

/*オタコン？*/
オタコン_024: {
Hallo, Raiden.
Wie geht's?
}
//	<<<ENGLISH>>>
//	Hey, Raiden.
//	Nice to meet you.

/*やあ、ライデン。
始めまして。
よろしく頼むよ。*/
プリスキン_025: {
Mist!
}
//	<<<ENGLISH(2)>>>
//	Damn!

/*まずいっ！*/
プリスキン_026: {
Raiden, ich spreche sp&~ater mit Dir.
}
//	<<<ENGLISH>>>
//	Raiden, I'll talk to you later.

/*ライデン、後で話す。*/
}//d

resource P044_01_R01_赤外線センサークリア１無線デモ１＿２__g {
//vc114402
ライデン_000: {
Oberst, ich brauche einige Antworten.
Wer genau sind Pliskin und sein Partner?
}
//	<<<ENGLISH>>>
//	Colonel, I need some answers
//	from you. Who exactly is Pliskin
//	and his partner?

/*大佐、答えてくれ！
プリスキン達は何者なんだ？*/
大佐_001: {
Ich wei&~s, was Du denkst.
}
//	<<<ENGLISH>>>
//	I know what you're thinking.

/*君の考えている事ならわかる。*/
ライデン_002: {
Es gibt st&~andig Parallelen zu Shadow
Moses. Und jetzt dieser Otacon.
}
//	<<<ENGLISH>>>
//	It keeps coming back to Shadow
//	Moses. And now this Otacon...

/*シャドーモセスにオタコンと言えば……。*/
ローズ_003: {
Alias Dr. Hal Emmerich,
&~Uberlebender von Shadow Moses.
}
//	<<<ENGLISH>>>
//	A.k.a. Hal Emmerich, Ph.D.
//	A Shadow Moses survivor.


/*ハル・エメリッヒ博士。
シャドーモセス事件での生存者。*/
ライデン_004: {
Rose?
}
//	<<<ENGLISH(2)>>>
//	Rose?

/*ローズ？*/
ローズ_005: {
Nach dem Shadow Moses-Zwischenfall
flohen Snake und Otacon; sie wurden
als Terroristen gesucht.
}
//	<<<ENGLISH>>>
//	Snake and Otacon both became
//	fugitives after Shadow Moses,
//	wanted for acts of terrorism.

/*あの事件の後、スネークとオタコンは
テロリストとして指名手配された。*/
ライデン_006: {
Eine Anti-Metal Gear-Organisation.
}
//	<<<ENGLISH>>>
//	An anti-Metal Gear organization...

/*反メタルギア団体……。*/
大佐_007: {
Sie haben weltweit unz&~ahlige Metal
Gear-Einheiten sabotiert und ausgel&~oscht.
}
//	<<<ENGLISH>>>
//	They sabotaged and destroyed
//	countless Metal Gear units
//	throughout the world...

/*彼らは世界中のメタルギアを
破壊して回った。*/
ローズ_008: {
Und sie waren f&~ur den Zwischenfall
vor zwei Jahren verantwortlich,
}
//	<<<ENGLISH>>>
//	And were responsible for the
//	incident two years ago＃−

//<ページ数変更>
ローズ_008_1: {
der den Bau der Big Shell erforderlich
machte.
}
//	<<<ENGLISH>>>
//	that necessitated the
//	construction of the Big
//	Shell.

/*そして２年前その『ビッグ・シェル』が
建造される理由を作った。*/
ライデン_009: {
Snake und sein Partner sind keine
Terroristen.
}
//	<<<ENGLISH>>>
//	Snake and his partner
//	aren't terrorists.

/*スネーク達はテロリストではない。*/
ローズ_010: {
Jack, warum verteidigst Du sie?
}
//	<<<ENGLISH>>>
//	Jack, why are you
//	defending them?

/*ジャック、どうして彼らをかばうの？*/
ライデン_011: {
Ich &~uberlege nur,
was ich hier bislang geleistet habe.
}
//	<<<ENGLISH>>>
//	I look back on what I've
//	done here so far＃−

//<ページ数変更>
ライデン_011_1: {
Mit Training und Pflichtbewu&~stsein
allein bew&~altigt man keinen derartigen
Schleichauftrag.
}
//	<<<ENGLISH>>>
//	and things like training and sense
//	of duty alone won't get you through
//	a sneaking mission like this.

/*これまで任務を遂行して感じる……
使命感だけでは＃｛潜入任務、スニーキング・ミッション｝＃は達成できない。
単にタフなだけでは。*/
ローズ_012: {
Jack, ist alles in Ordnung?
}
//	<<<ENGLISH>>>
//	Jack, are you okay?

/*ジャック、大丈夫？*/
ライデン_013: {
Du brauchst mehr, etwas - H&~oheres.
Mir f&~allt das richtige Wort nicht ein,
aber,
}
//	<<<ENGLISH>>>
//	You need something -- higher.
//	I can't think of the right word,
//	but...

/*それ以上に崇高な何か？
そう、的確な言葉が見あたらないが。*/
ライデン_014: {
es mu&~s reiner Wille sein, dazu - Mut,
Ideale oder etwas &~ahnliches.
}
//	<<<ENGLISH>>>
//	it has to be pure will, backed
//	up by -- by courage, or ideals,
//	or something like that.

/*たとえば、『勇気』や『理想』に
裏付けされた強い『意志』が必要だ。*/
ライデン_015: {
Ich w&~urde mein Leben darauf wetten.
}
//	<<<ENGLISH>>>
//	I'd stake my life on it.

//<ページ数変更>
ライデン_015_1: {
Der Solid Snake, der Shadow Moses
gerettet hat, k&~onnte kein Terrorist werden.
}
//	<<<ENGLISH>>>
//	The Solid Snake that saved
//	Shadow Moses couldn't turn
//	into a terrorist.

/*俺にも感じるんだ。シャドーモセスを
救ったスネークはテロリストに豹変は
しない。*/
大佐_016: {
Vielleicht. Aber sie vor zwei Jahren
mit dem Tanker untergegangen sind.
Wir haben Snakes Leichnam geborgen.
}
//	<<<ENGLISH>>>
//	Maybe that's true, but they went
//	down with that tanker two years ago.
//	We even recovered Snake's body.

/*それは定かではないが、
彼らは２年前、タンカーと共に沈んだ。
そしてスネークの遺体も回収されている。*/
ライデン_017: {
Und die DNA der Leiche best&~atigte
seine Identit&~at.
}
//	<<<ENGLISH>>>
//	And the DNA test results
//	on the body say it's him.

/*遺体のＤＮＡ検査も一致。*/
ローズ_018: {
Jack, ich verstehe Dich, aber Snake ist tot.
}
//	<<<ENGLISH>>>
//	Jack, I know what you're
//	saying, but Snake is dead.

/*ジャック、あなたの気持ちもわかる。
でもスネークは死んでるの。*/
ローズ_019: {
Er kann nicht hier sein, nicht mal als
dieser Dr. Hal Emmerich.
}
//	<<<ENGLISH>>>
//	He can't be here, not even
//	as this Dr. Hal Emmerich.

/*だから彼がハル・エメリッヒ博士である
はずはないわ。*/
ライデン_020: {
Das hei&~st aber auch, da&~s er nicht
der Anf&~uhrer der Terroristen sein kann.
}
//	<<<ENGLISH>>>
//	But that also means that he
//	can't be the terrorist leader
//	behind this thing.

/*もうひとつ確かな事がある……
テロリストのリーダーもスネークでは
ありえない。*/
}
//d




resource P046_02_R01_ハリアー戦勝利２無線デモ１＿１__g {
//vc114601
プリスキン_000: {
Raiden, alles in Ordnung?
}
//	<<<ENGLISH>>>
//	Raiden, you all right?

/*ライデン、大丈夫か？*/
ライデン_001: {
Ja.
Wie steht's bei Euch?
}
//	<<<ENGLISH>>>
//	Yeah.
//	How about you guys?

/*そっちはどうなんだ？*/
プリスキン_002: {
Es war knapp, aber wir haben es
&~uberstanden.
}
//	<<<ENGLISH>>>
//	Barely managed,
//	but we're all right.

/*どうにか着陸した。*/
ライデン_003: {
Der Hubschrauber?
}
//	<<<ENGLISH>>>
//	The chopper?

/*ヘリは無事か？*/
プリスキン_004: {
Die Reparaturen werden etwas dauern.
}
//	<<<ENGLISH>>>
//	We need some time for repairs.

/*修理の時間が必要だ。*/
ライデン_005: {
Oh.
}
//	<<<ENGLISH(2)>>>
//	Oh...

/*そうか……。*/
プリスキン_006: {
Der Pr&~asident geh&~ort ganz Dir.
}
//	<<<ENGLISH>>>
//	The President's all yours.

/*大統領を頼むぞ。*/
ライデン_007: {
OK. Kann ich Dich etwas fragen?
}
//	<<<ENGLISH>>>
//	OK... Can I ask you something?

/*あっ、ちょっと？*/
プリスキン_008: {
Was?
}
//	<<<ENGLISH(2)>>>
//	What?

/*なんだ？*/
ライデン_009: {
Bist Du DER Snake?
}
//	<<<ENGLISH>>>
//	Are you THE Snake?

/*あんたが、スネークなのか？*/
プリスキン_010:
''
/*……。*/
ライデン_011: {
Es hei&~st, Du w&~arst tot.
}
//	<<<ENGLISH>>>
//	They said you were dead...

/*死んだはずだ……。*/
プリスキン_012: {
Nein, ich doch nicht.
Ich habe noch zu viel zu erledigen.
}
//	<<<ENGLISH>>>
//	No, not me. There are still too
//	many things I need to do.

/*俺は死なんさ。
まだやることがたくさんある。*/
ライデン_013: {
Snake, Du bist eine Legende - darum mu&~s
ich Dich etwas fragen.
}
//	<<<ENGLISH>>>
//	Snake, you're a legend -- and
//	that's why I need to ask you this.

/*スネーク、あんたが伝説の傭兵として、
聞きたいことがある。*/
プリスキン_014: {
Legende?
}
//	<<<ENGLISH>>>
//	Legend?

/*伝説？*/
プリスキン_015: {
Eine Legende ist wie ein M&~archen. Jemand
erz&~ahlt es, ein anderer erinnert sich daran,
alle erz&~ahlen es weiter.
}
//	<<<ENGLISH>>>
//	A legend is nothing but fiction.
//	Someone tells it, someone else
//	remembers, everybody passes it on.

/*伝説は人が作るものだ。
人が記憶し、語り伝えるものだ。*/
ライデン_016: {
Ich bin hier, weil es mir befohlen wurde,
nicht freiwillig.
}
//	<<<ENGLISH>>>
//	I'm here because I was assigned to
//	this mission, not because I want to.

//<ページ数変更>
ライデン_016_1: {
Wenn ich k&~onnte,
w&~urde ich sofort abhauen.
}
//	<<<ENGLISH>>>
//	If I could, I'd be out
//	of here in a second.

/*俺は任務でここにる。自らの意志では
ない。できれば、今すぐにでもここから
逃げたい。*/
プリスキン_017:
''
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
ライデン_018: {
Sag mal. Wie konntest Du zu all dem
hier zur&~uckkehren? Warum k&~ampfst
Du weiter?
}
//	<<<ENGLISH(2)>>>
//	Look. How could you come back to all
//	this? Why keep fighting?

/*なぜ再び戦場に？*/
プリスキン_019: {
Mein bester Freund sagte einst
etwas zu mir.
}
//	<<<ENGLISH>>>
//	There's something my best
//	friend said to me once.

/*ライデン、いいか。
俺の親友の言った言葉がある。*/
ライデン_020: {
Was?
}
/*……。*/
プリスキン_021: {
Wir sind keine Instrumente der Regierung
oder von irgendjemand anderem.
}
//	<<<ENGLISH>>>
//	We're not tools of the
//	government or anyone
//	else.

//<ページ数変更>
プリスキン_021_1: {
K&~ampfen war das einzige, worin ich
wirklich gut war, aber, Immerhin k&~ampfte
ich stets f&~ur meine &~Uberzeugungen.
}
//	<<<ENGLISH>>>
//	Fighting was the only thing I was
//	good at, but... At least I always
//	fought for what I believed in...

/*俺達は政府や誰かの道具じゃない。
戦う事でしか自分を表現できなかったが
……いつも自分の意志で戦ってきた。*/
ライデン_022: {
Und was ist mit, was ist mit dem
DNA-Test der Leiche?
}
//	<<<ENGLISH>>>
//	What about -- what about the
//	DNA results from that body?

/*なぜ……遺体のＤＮＡ検査では。*/
オタコン_023: {
Das war Liquids Leiche.
Snake und er sind genetisch identisch.
}
//	<<<ENGLISH>>>
//	That was Liquid's body.
//	He and Snake are identical
//	on the genetic level.

/*あれはリキッドの遺体だよ。
彼とスネークはＤＮＡレベルでは
全く同じ。*/
ライデン_024: {
Liquid.
}
/*リキッドの遺体。*/
オタコン_025: {
Eine T&~auschung - zu unserem eigenen
Schutz.
}
//	<<<ENGLISH>>>
//	A deception -- for
//	our own protection.

/*そうさ、世間の目を欺くためのトリック。*/
オタコン_0251: {
Wir stahlen seinen gefrorenen K&~orper von
einer Organisation. Etwas umst&~andlich.
}
//	<<<ENGLISH>>>
//	We stole his frozen body from
//	some organization. Kind of a
//	hassle though...

/*ある機関が冷凍保存してたのを
盗み出したんだ。
ちょっと苦労したけどね*/
プリスキン_026: {
Das ist alles.
}
//	<<<ENGLISH>>>
//	That's all there is to it.

/*そういう事だ。*/
ライデン_027:
''
/*……。*/
ライデン_028: {
Seit Ihr zwei wirklich eine nichtstaatliche
Organisation?
}
//	<<<ENGLISH>>>
//	Are you two really an NGO?

/*君らは本当に＃｛非政府組織、ＮＧＯ｝＃なのか？*/
オタコン_029: {
Wenn Du darunter eine gemeinn&~utzige
zivile Organisation, mit einem bestimmten
Ziel verstehst, ja.
}
//	<<<ENGLISH>>>
//	Insofar as we're a nonprofit
//	organization of civilians
//	advocating a cause, yes.

//<ページ数変更>
オタコン_029_1: {
Unser Ziel ist die Vernichtung
von Metal Gear.
}
//	<<<ENGLISH>>>
//	The cause happens to be the
//	eradication of Metal Gear.

/*ああ、僕らは民間の反メタルギア組織さ。*/
プリスキン_030: {
Wir arbeiten allein.
Aber es ist ein lohnendes Ziel.
}
//	<<<ENGLISH>>>
//	We work on our own.
//	But it's a cause worth
//	fighting for.

/*何処にも属さない。
この地球上からメタルギアを
根絶する為に動いている……。*/
ライデン_031: {
Warum riskiert Ihr Kopf und Kragen f&~ur
eine so riskante Sache?
}
//	<<<ENGLISH>>>
//	Why would you stick your neck
//	out for something this risky?

/*なぜそんな危険な事を？*/
プリスキン_032: {
So habe ich vor vier Jahren auch gedacht.
}
//	<<<ENGLISH>>>
//	That's the way I used to
//	look at it, four years ago.

/*４年前の俺もそう思っていた。*/
プリスキン_034: {
Ich sa&~s mitten in Alaska fest
und soff mich um den Verstand.
}
//	<<<ENGLISH>>>
//	I was holed up in the middle
//	of nowhere in Alaska, drinking
//	too much.

/*アラスカの僻地で自分の殻に
閉じこもって……酔っぱらっていた。*/
オタコン_035: {
Wir sind verantwortlich f&~ur kommende
Generationen, ja der ganzen Welt.
}
//	<<<ENGLISH>>>
//	We have a responsibility to the
//	coming generations, to the world.

/*僕らは伝える義務がある。
世間に、子供達に。*/
ライデン_036: {
Was f&~ur eine Verantwortung?
}
//	<<<ENGLISH>>>
//	What responsibility?

/*何を。*/
オタコン_037: {
Die Fehler, die die Menschheit begangen
hat, nicht zu vergessen.
}
//	<<<ENGLISH>>>
//	To keep track of the mistakes
//	we've made as a species.

/*我々人類の間違い。*/
プリスキン_038: {
Wir m&~ussen uns erinnern - davon berichten
f&~ur Ver&~anderungen k&~ampfen. Das h&~alt
mich am Leben.
}
//	<<<ENGLISH>>>
//	We need to remember -- to spread
//	the word -- to fight for change.
//	And that's what keeps me alive.

/*過ちを記憶して、伝える、抗議する……
その為に生きる。*/
ライデン_039: {
Ihr glaubt, Ihr k&~onntet die Zukunft
ver&~andern?
}
//	<<<ENGLISH>>>
//	You think you can
//	change the future?

/*君らが未来を変える？*/
プリスキン_040: {
So arrogant bin ich auch nicht.
}
//	<<<ENGLISH>>>
//	I'm not as arrogant as that.

/*そこまで自惚れてはいない。*/
ライデン_041: {
Ihr seid keine Aktivisten der Basis.
Eher Terroristen.
}
//	<<<ENGLISH>>>
//	What you do isn't grassroots
//	activism. It's more like terrorism.

/*君らのは、草の根運動なんかじゃない。
テロに近い。*/
プリスキン_042: {
Das gebe ich ja zu.
}
//	<<<ENGLISH>>>
//	I admit that...

/*そうかもな。*/
オタコン_043: {
Aber unsere Gruppe, Philantropy,
erhielt Informationen:
}
//	<<<ENGLISH>>>
//	But our group, Philanthropy,
//	received some information:

/*僕らの組織『フィランソロピー』が、
情報を手に入れたんだ。*/
オタコン_044: {
Ein neuer Metal Gear-Prototyp wurde hier
entwickelt, und Terroristen planten,
die Anlage zu st&~urmen.
}
//	<<<ENGLISH>>>
//	a new Metal Gear prototype was
//	being developed here, and terrorists
//	were planning to raid the facility.

/*ここで新型メタルギア開発が行われて
いて、テロリストがそれを襲撃しようと
しているっていうね。*/
オタコン_045: {
Diese Informationen stammten aus einer
sehr zuverl&~assigen Quelle.
}
//	<<<ENGLISH>>>
//	The information came from
//	a very reliable source.

/*タレコミなんかとは違う、
信頼できる情報だった。*/
ライデン_046: {
Ihr wolltet also.
}
//	<<<ENGLISH>>>
//	So you're here to...

/*だからあんた達はここに？*/
オタコン_047: {
Wir wollten dem ein Ende setzen,
aber ich habe auch pers&~onliche Gr&~unde.
}
//	<<<ENGLISH>>>
//	We're here to stop all that, but
//	I also have a personal motive.

/*ああ……。
それと、個人的な理由……。*/
プリスキン_048: {
Anscheinend halten die Terroristen seine
Schwester in der Big Shell gefangen.
}
//	<<<ENGLISH>>>
//	Looks like the terrorists have
//	his sister in the Big Shell.

/*こいつの妹がビッグシェルにいるらしい。*/
プリスキン_049: {
Wir wollen hier sein, uns wird nicht
befohlen. Wir k&~ampfen unsere eigenen
Schlachten.
}
//	<<<ENGLISH>>>
//	We're here on our own, not under
//	anyone's orders. We have our own
//	battles.

//<ページ数変更>
プリスキン_049_1: {
Otacon ist hier, um jemanden zu suchen -
ich nicht.
}
//	<<<ENGLISH>>>
//	Otacon's here for
//	someone -- I'm not.

/*俺達は誰の使いでもない。俺達の意志で、
俺達の闘いをしている。俺は……俺は
誰の為にも戦っていない。*/
ライデン_050: {
Das ist ein milit&~arischer Auftrag.
}
//	<<<ENGLISH>>>
//	This is a military mission.

/*これはミッションだ。*/
}
//d


resource P046_02_R01_ハリアー戦勝利２無線デモ１＿２__g {
//vc114602
ローズ_000: {
Jack, alles in Ordnung?
}
//	<<<ENGLISH>>>
//	Jack? Are you all right?

/*大丈夫、ジャック？*/
ライデン_001: {
Na ja.
}
//	<<<ENGLISH>>>
//	Just barely.

/*かろうじて……。*/
ローズ_002: {
Du hast mir einen Riesenschreck
versetzt.
}
//	<<<ENGLISH>>>
//	You almost gave me
//	a heart attack...

/*もう私、
心臓がどうにかなってしまいそう。*/
ライデン_003: {
Tut mir leid. War keine Absicht.
}
//	<<<ENGLISH>>>
//	Sorry. Wasn't intentional.

/*ああ、悪気はないんだが。*/
ローズ_004: {
Ich wei&~s. Ich wei&~s auch,
da&~s ich st&~arker sein mu&~s.
}
//	<<<ENGLISH>>>
//	I know that. And I know
//	I need to stay stronger.

/*ええ、わかってる。
私も強くならなくっちゃね。*/
ライデン_005: {
Bete f&~ur mich, Rose.
Damit ich zur&~uckkommen kann.
}
//	<<<ENGLISH>>>
//	Say a prayer for me, Rose.
//	So I can come back...

/*祈ってくれ、俺が無事で帰れるように。*/
ローズ_006: {
Du kommst zur&~uck. Denk' dran,
ich bin die ganze Zeit bei Dir.
}
//	<<<ENGLISH>>>
//	You will make it back.
//	I'm with you all the way,
//	 remember...

/*大丈夫、帰れるわ。
私がついてる……。*/
ライデン_007: {
Du wei&~st, da&~s mir das viel bedeutet.
}
//	<<<ENGLISH>>>
//	That means a lot
//	to me, you know.

/*心強いよ、ほんと。
この状況ではね。*/
ローズ_008: {
Ich werde jetzt die Daten speichern.
Okay, Jack?
}
//	<<<ENGLISH>>>
//	I'm going to save
//	the data, okay Jack?

/*ジャック、＃｛記録、セーブ｝＃しておくわね。*/
}



resource P046_02_R01_ハリアー戦勝利２無線デモ１＿３__g {
//vc114603
ライデン_000: {
Oberst, Metal Gear ist bereits
aktiviert.
}
//	<<<ENGLISH(2)>>>
//	Colonel, Metal Gear's
//	already gone active...

/*大佐、メタルギアはもう起動して
しまった……。*/
大佐_001: {
Es ist noch nicht zu sp&~at. Noch kannst
einen Nuklearschlag verhindern. Greife
den Pr&~asidenten
}
//	<<<ENGLISH>>>
//	It's not too late. You can still
//	prevent a nuclear strike by
//	securing the President＃−

//<ページ数変更>
大佐_001_1: {
und verhindere, die Best&~atigung
des Pa&~swortes.
}
//	<<<ENGLISH>>>
//	and preventing password
//	confirmation from taking
//	place.

/*まだ間に合う。大統領を確保して
コードの再確認を防げば、核攻撃は
阻止出来る。*/
大佐_002: {
Hol den Pr&~asidenten.
Er ist im Kernabschnitt von Shell 2.
}
//	<<<ENGLISH>>>
//	Get to the President. He's in
//	the core section of Shell 2.

/*大統領の元へ急げ。シェル２の中央棟だ。*/
ローズ_003: {
Ich &~uberpr&~ufe gerade die Satellitenbilder.
}
//	<<<ENGLISH>>>
//	I'm checking the satellite
//	images...

//<ページ数変更>
ローズ_003_1: {
Sieht aus, als k&~onntest Du von der
anderen Seite der Strebe L zum Kern
gelangen.
}
//	<<<ENGLISH>>>
//	Looks like you can get to
//	the core from the other
//	side of Strut L.

/*衛星からの映像では……
Ｌ脚の向こうまでいけば、
中央棟へいけそうよ。*/
大佐_004: {
Soweit wir sehen k&~onnen, ist der Kern
noch nicht versunken.
}
//	<<<ENGLISH>>>
//	The core hasn't gone under
//	yet from what we can tell.

//<ページ数変更>
大佐_004_1: {
Folge der Reling nach unten und spring
dann auf die Rohre.
}
//	<<<ENGLISH>>>
//	Follow the railings down,
//	then jump onto the pipes.

/*今のところ、中央棟はまだ浮かんでいる
ようだ。その手すりを伝って行くしか
ない。途中でパイプに飛び移れ。*/
ローズ_005: {
Die einzig robuste Strebe im &~au&~seren
Bezirk ist Strebe L.
}
//	<<<ENGLISH>>>
//	The only viable strut in the
//	outer perimeter is the L.

//<ページ数変更>
ローズ_005_1: {
Der Angriff eben ergibt keinen Sinn - sie
k&~onnen die Anlage nicht mehr nutzen.
}
//	<<<ENGLISH>>>
//	That attack just now doesn't make
//	any sense -- it's like they have no
//	more use for this place.

/*外周脚で無事なのはＬ脚だけみたい。
さっきの攻撃……変ね。
彼ら、もうここは必要ないみたい。*/
ライデン_006: {
Oberst, Du hast die Codec-Anrufe
&~uberwacht. Dieser Mann war
die ganze Zeit der echte Snake.
}
//	<<<ENGLISH>>>
//	Colonel, you were monitoring
//	the Codec calls. That man was
//	the real Snake, all along...

/*大佐、聞いていたろう？スネークだった、
あの男は……。*/
大佐_007: {
Vielleicht.
}
//	<<<ENGLISH(2)>>>
//	Maybe.

/*そうかもしれん。*/
ライデン_008: {
Vielleicht?
}
//	<<<ENGLISH>>>
//	Maybe?

/*かもしれん？*/
大佐_009: {
Bleib ihm gegen&~uber auf der Hut.
}
//	<<<ENGLISH>>>
//	Don't let your guard
//	down with him.

/*決して気を許すな。*/
ライデン_010: {
Warum sagst Du das?
}
//	<<<ENGLISH>>>
//	Why do you say that?

/*なぜ？*/
大佐_011: {
Sie geh&~orten nie zur Simulation.
Sie sind ein unbekannter Faktor.
}
//	<<<ENGLISH>>>
//	Because they were never
//	a part of the simulation.
//	They're an unknown factor.

/*彼らとの協力はシミュレーションには
入っておらん。不確定要素だ。*/
ライデン_012: {
Du kannst Dir Deine Simulation in den!
Wir sind hier drau&~sen, wir bluten und
sterben!
}
//	<<<ENGLISH>>>
//	You can take your simulation
//	and...! We're out here, we
//	bleed, we die!

/*なんでもシミュレーションなんだな。
実際に戦って、血を流してるんだぞ！*/
ローズ_013: {
Beruhige Dich!
}
//	<<<ENGLISH>>>
//	Calm down!

/*落ち着いて！*/
大佐_014: {
Das w&~urde ich Dir auch raten, Raiden.
}
//	<<<ENGLISH>>>
//	I suggest that you do, Raiden.

/*そうだ、冷静になれ。*/
大佐_015: {
Selbst wenn er Snake ist, &~andert
das nichts an Deinem Auftrag.
}
//	<<<ENGLISH>>>
//	Even if that is Snake, that has
//	no bearing on your mission.

/*もし彼らがスネークであったとしても、
君の任務にはなんら変更はない。*/
ライデン_016: {
Oberst, Du standest einmal auf der
gleichen Seite wie Snake.
}
//	<<<ENGLISH>>>
//	Colonel, you and Snake used
//	to be on the same side.

/*大佐、あんたは以前、スネークと共に
戦ったはず。*/
大佐_017:
''
/*……。*/
ライデン_018: {
Ich verstehe nicht. Ich habe von Dir und
Snake in 'In the Darkness of Shadow
Moses' gelesen.
}
//	<<<ENGLISH>>>
//	I don't understand. I read about
//	you and Snake in "In the Darkness
//	of Shadow Moses" --

/*わからない。
『シャドーモセスの真実』によると、
大佐とスネークは。*/
大佐_019: {
Es ist mir v&~ollig egal, was in diesem
Schund steht. Verstanden?
}
//	<<<ENGLISH>>>
//	I don't give a damn what
//	that piece of trash said.
//	Do you get me?

/*そんなゴシップ記事は意味がない。
いいな？*/
}




resource P047_05_R01_電撃床前オルガ５無線デモ１＿１__g {
//vc114701
ライデン_000: {
Ich stehe vor dem Raum, in dem der
Pr&~asident gefangengehalten wird.
}
//	<<<ENGLISH>>>
//	I'm in front of the room where
//	they're keeping the President.

/*大統領が軟禁されている部屋に到着した。*/
大佐_001: {
Ist alles in Ordnung?
}
//	<<<ENGLISH>>>
//	Everything all right?

/*そこは大丈夫か？*/
ライデン_002: {
Keine Anzeichen f&~ur eine &~Uberflutung.
Der Boden steht unter Strom, ich komme
nicht an die T&~ur.
}
//	<<<ENGLISH>>>
//	No sign of flooding, but I can't
//	get close to the door. The floor
//	is electrified.

/*浸水はしていないが、扉には近づけない。
高圧電流が流されている。*/
大佐_003: {
Nicht ber&~uhren,
Du wirst sonst gegrillt.
}
//	<<<ENGLISH>>>
//	Don't test it.
//	You'll be bacon.

/*なるほど。
上は歩くな。
黒焦げになるぞ。*/
ライデン_004: {
Irgendwelche Vorschl&~age?
}
//	<<<ENGLISH>>>
//	Any suggestions?

/*どうすればいい？*/
大佐_005: {
Denk an das VR-Training in Shadow
Moses.
}
//	<<<ENGLISH>>>
//	Remember the Shadow
//	Moses VR training.

/*シャドーモセス事件を思い出せ。
あの事件のＶＲ訓練をな。*/
ライデン_006: {
Die Schalttafel herausnehmen?
}
//	<<<ENGLISH>>>
//	Take out the circuit panel?

/*電源パネルを破壊する？*/
大佐_007: {
Genau.
}
//	<<<ENGLISH(2)>>>
//	Right.

/*そうだ。*/
ライデン_008: {
Aber es gibt keinen Zugang zu dem Raum.
}
//	<<<ENGLISH>>>
//	But there's no way
//	into the room.

/*しかし、中には入れそうもない。*/
大佐_009: {
Probier' die Bel&~uftungsrohren.
}
//	<<<ENGLISH>>>
//	Try ventilation ducts.

/*通気ダクトがあるだろう？*/
ライデン_010: {
Ja, ich glaube, ich kann eins sehen.
}
//	<<<ENGLISH>>>
//	Yeah, I think I see one.

/*ああ……ダクトの穴なら……。*/
大佐_011: {
Such' Dir ein ferngesteuertes
Raketenabschu&~ssystem. und leite
es durch das Rohr in den Raum.
}
//	<<<ENGLISH>>>
//	Look for a remote-control missile
//	launcher. You can guide it through
//	the duct into the room.

/*リモコン・ミサイルを探すんだ。
リモコン・ミサイルなら、
ダクトを通過する事ができる。*/
ライデン_012: {
Und dann ziele ich auf die Schalttafel.
Verstanden.
}
//	<<<ENGLISH>>>
//	-- then target the
//	circuit panel. Got it.

/*それで、室内の電源パネルを破壊すれば
いいんだな。*/
}
//d
//スクリーン内に子画面。リモコンミサイルでクリアする映像を出す。一番難しいコース。



resource P047_05_R01_電撃床前オルガ５無線デモ１＿２__g {
//vc114703
大佐_000: {
Genau. Aber nicht den Pr&~asidenten
treffen!
}
//	<<<ENGLISH>>>
//	Right. But make sure you
//	don't hit the President.

/*そうだ。ただし大統領には当てるなよ。*/
ライデン_001: {
Der Pr&~asident ist verkabelt mit
Nanomaschinen.
}
//	<<<ENGLISH>>>
//	The President is wired
//	with nanomachines.

//<ページ数変更>
ライデン_001_1: {
Wenn wir die Frequenz kennen,
kann ich ihn kontaktieren.
}
//	<<<ENGLISH>>>
//	If we know the frequency,
//	I can raise him...

/*大統領にもナノマシンが注入されて
いるんだろう？周波数がわかれば
呼びかけることも出来るが……。*/
大佐_002: {
Wir haben das mehrfach vergeblich
versucht
}
//	<<<ENGLISH>>>
//	We've tried that repeatedly,
//	but there's no response.

//<ページ数変更>
大佐_002_1: {
Die w&~ande sind vermutlich fun kgesch&~utzt.
}
//	<<<ENGLISH>>>
//	It looks like the walls have
//	a built-in radio shield.

/*いや、こちらからも何度かＣＡＬＬして
いるが通じない。そこの壁は通信を
妨害する素材で出来ているようだ。*/
ライデン_003: {
Darum hat Ames also den Kontakt
zu ihm verloren.
}
//	<<<ENGLISH>>>
//	So that's why Ames
//	lost contact with him...

/*なるほど。
エイムズが反応を見失ったのは
そのためか……。*/
大佐_004: {
Wenn Du seine Position best&~atigen mu&~st,
logge Dich im Node eine.
}
//	<<<ENGLISH>>>
//	If you need to confirm his position,
//	you can log into the node.

/*だがノードに接続すれば彼の位置は
確認出来るはずだ。*/
ライデン_005: {
Verstanden.
}
//	<<<ENGLISH(2)>>>
//	Understood.

/*わかった。*/
大佐_006: {
Aber suche zuerst ein ferngesteuertes
Raketenabschu&~sssystem.
}
//	<<<ENGLISH>>>
//	Locate a remote-control
//	missile launcher first.

/*まずはリモコン・ミサイルを探せ。*/
}
//d



resource P049_02_R01_大統領２無線機デモ１＿１__g {
//vc114901
ライデン_000: {
H&~oren Sie mich, Sir?
}
//	<<<ENGLISH>>>
//	Do you read me, sir?

/*聞こえますか？*/
大統領_001: {
&~Ah, ja.
}
//	<<<ENGLISH>>>
//	Uh... yes.

/*ああ。*/
ライデン_002: {
Herr Pr&~asident. Soweit ich wei&~s, haben
die Terroristen den Code eingegeben,
}
//	<<<ENGLISH>>>
//	Mr. President. It's my understanding
//	that the terrorists have managed to＃−

//<ページ数変更>
ライデン_002_1: {
den sie f&~ur einen Nuklearangriff
ben&~otigen.
}
//	<<<ENGLISH>>>
//	input the code sequence necessary
//	for launching a nuclear strike...

/*大統領、テロリスト達は核発射の
コード入力を終了したと……。*/
大統領_003: {
Das stimmt. Ich habe den Code selbst
eingegeben.
}
//	<<<ENGLISH>>>
//	That's correct. I punched
//	the sequence in myself.

/*……そうだ。私が自分で入力した。*/
ライデン_004: {
Sie arbeiten f&~ur die Terroristen!?
}
//	<<<ENGLISH>>>
//	You're working for them!?

/*……やはりあなたは奴等と……？*/
大統領_005: {
Vor zwei Stunden h&~atte ich darauf
noch ja gesagt.
}
//	<<<ENGLISH>>>
//	If you asked me two hours ago,
//	my answer would have been yes.

//<ページ数変更>
大統領_005_1: {
Aber jetzt lassen sie mich nur noch
am Leben, bis meine Lebenszeichen
best&~atigt wurden.
}
//	<<<ENGLISH>>>
//	Right now, they're keeping
//	me alive until my vital signs
//	are reconfirmed.

/*２時間前まではな。
今はヴァイタルＩＤの再確認が
終わるまで生かされているだけの身だ。*/
ライデン_006: {
Sie haben Sie betrogen?
}
//	<<<ENGLISH>>>
//	They betrayed you?

/*裏切られた？*/
/* テロ事件対応で一部セリフカット */
大統領_007: {
So w&~urde ich das nicht gerade nennen.
}
//	<<<ENGLISH>>>
//	I wouldn't quite put it that way.

/*We had a conflict of ideals... and
I lost.
*/
//<ページ数変更>
大統領_007_1: {
Ich habe verloren.
Ich wollte Macht, sie Zerst&~orung.
}
//	<<<ENGLISH>>>
//	I wanted power.
//	They sought destruction.

/*いや。私は継承を望み、彼らは破壊を
欲した。思想の違い、といったところ
かな。*/
/* テロ事件対応でカット */
/*
ライデン_008: {
Ideals? What kind of ideals
can justify terrorism!?
}
*/
/*思想？
テロになんの思想があると？*/
/* テロ事件対応でカット */
/*
大統領_009: {
Any movement is driven
by an ideal --
}
*/
/*どんなものにも思想はある。*/
ライデン_010: {
 Aber warum gleich Terrorismus!?
}
//	<<<ENGLISH>>>
//	But why stoop to terrorism!?

/*……なぜテロを？*/
大統領_011: {
Ich wollte absolute Macht.
}
//	<<<ENGLISH>>>
//	I wanted absolute power.

/*権力に加わるためだ。*/
ライデン_012: {
Aber Sie sind der Pr&~asident --
Sie haben Macht.
}
//	<<<ENGLISH>>>
//	But you're the President --
//	you have power...

/*＃｛大統領、あなた｝＃が権力でしょう？*/
大統領_013: {
Nein, ich bin nur ein eine Marionette.
}
//	<<<ENGLISH>>>
//	No. I'm just a figurehead.

/*いや、私は外様だよ。*/
ライデン_014: {
?
}
/*？*/
大統領_015: {
Ich habe nichts zu sagen.
Die wahre Macht liegt bei den Patriots.
}
//	<<<ENGLISH>>>
//	I don't have any control.
//	The real power is in the
//	Patriots' hands.

/*私に実権はないのだ。
本当の『権力』は『愛国者達』の
元にある……。*/
ライデン_016: {
Den Patriots?
}
//	<<<ENGLISH(2)>>>
//	The Patriots...?

/*『愛国者達』？*/
大統領_017: {
Die Wahrheit hinter diesem Land.
}
//	<<<ENGLISH>>>
//	The truth behind this country...

/*この国の真実だよ。*/
}
//d




resource P049_05_R02_大統領５無線機デモ２＿１__g {
//vc114911
大統領_000: {
Ich wollte zu den Patriots geh&~oren.
}
//	<<<ENGLISH>>>
//	I wished to be a member
//	of the Patriots.

大統領_001: {
Ich wollte ein K&~onig mit Macht sein und
nicht nur eine austauschbare Schachfigur.
}
//	<<<ENGLISH>>>
//	I wanted to wield the power
//	of a king, instead of being an
//	expendable pawn...

/*私の望みは『愛国者達』の一員となる
こと…*/
/*…彼等の支配構造に加わること
だった。使い捨ての＃｛駒、ポーン｝＃としてではなく。*/
ライデン_002: {
Und das rechtfertigt terroristische
Anschl&~age?
}
//	<<<ENGLISH>>>
//	And that justifies
//	acts of terrorism?

/*それがテロを起こした理由？*/
大統領_003: {
Ja. Ich wollte das neue Metal Gear als
Faustpfand in Verhandlungen einsetzen.
}
//	<<<ENGLISH>>>
//	Yes. I'd intended to use
//	the new Metal Gear as a
//	bargaining chip...

/*そうだ。新型メタルギアも、
あくまで取り引き材料として
使うつもりだった……。*/
ライデン_004: {
Faustpfand?
}
//	<<<ENGLISH>>>
//	Bargaining chip?

/*……だった、とは？*/
大統領_005: {
Doch ich untersch&~atzte Solidus,
er will die Patriots herausfordern -
}
//	<<<ENGLISH>>>
//	But I underestimated Solidus...
//	he actually wants to challenge
//	the Patriots --

//<ページ数変更>
大統領_005_1: {
selbst wenn dadurch die Welt zerst&~ort
wird!
}
//	<<<ENGLISH>>>
//	...even if it means the
//	destruction of the world!

/*私は見くびっていた。ソリダスは……
本気で彼等に闘いを挑もうとしている。
奴は世界を壊すつもりだ。*/
ライデン_006: {
Was wollen Sie damit sagen?
}
//	<<<ENGLISH(2)>>>
//	What are you saying?

/*どういうことです？*/
大統領_007: {
Ob Du es glaubst oder nicht, die Macht
liegt in der Hand der Patriots.
}
//	<<<ENGLISH>>>
//	Whether you believe it or not,
//	the balance of power rests in
//	the hands of the Patriots.

/*君が信じようと信じまいと、
世界の均衡を保っているのは
『愛国者達』なのだよ。*/
大統領_008: {
Sie regulieren die verschiedenen
Interessen durch die sogenannte
'kontrollierte Pr&~asentation'
}
//	<<<ENGLISH>>>
//	They regulate the country's
//	various interests through
//	controlled presentation,

//<ページ数変更>
大統領_008_1: {
und f&~uhren ein 'Theaterst&~uck' auf,
das den Massen gef&~allt.
}
//	<<<ENGLISH>>>
//	staging a "drama" that is
//	palatable to the general
//	masses.

/*この国に渦巻く利害を調整し、
結果を分かりやすい『物語』にして
大衆に提供する。*/
大統領_009: {
Kannst Du Dir vorstellen,
was ohne sie geschehen w&~urde?
}
//	<<<ENGLISH>>>
//	Can you imagine what
//	would happen if they
//	ceased to function?

/*その機能が停止すれば、いや、
その存在が公になっただけでどうなる？*/
ライデン_010: {
?
}
/*？*/
大統領_011: {
Stell Dir ein riesiges politisches
Vakuum vor,
}
//	<<<ENGLISH>>>
//	Picture a massive
//	political vacuum,

大統領_012: {
einen Raum, den jeder Machts&~uchtige
f&~ullen will.
}
//	<<<ENGLISH>>>
//	a space that every power-
//	monger will try to fill for
//	their own greedy ends.

/*巨大な政治的真空が生まれる。
その空位を貪欲なブタどもが
見逃すはずがない。*/
大統領_013: {
Ich spreche von einem wilden
Machtkampf - Panik, B&~urgerkrieg,
Chaos.
}
//	<<<ENGLISH>>>
//	I'm talking about an unregulated
//	power struggle -- panic, civil
//	war... chaos.

/*すぐさま共食いが始まるだろう。
世界中であらゆるタガが外れる。
紛争、内戦、恐慌……
誰も制御することはできない……。
*/
大統領_014: {
Ob es Dir gef&~allt oder nicht -
die Patriots m&~ussen fortbestehen.
}
//	<<<ENGLISH>>>
//	Like it or not -- the Patriots
//	is an organization that must
//	continue to exist.

/*彼等は闘ってはいけない相手なのだ。*/
ライデン_015: {
Sie haben Ihre Ansichten ge&~andert,
um ein globales Chaos zu verhindern?
}
//	<<<ENGLISH>>>
//	So you changed your mind because
//	you wanted to avoid global chaos?

/*……世界を混乱させるのはあなたの
本意ではないと？*/
大統領_016: {
Genau.
}
//	<<<ENGLISH(2)>>>
//	Exactly.
//<ページ数変更>
大統領_016_1: {
Ich teilte dies Solidus mit.
Er antwortete,
}
//	<<<ENGLISH>>>
//	When I told Solidus that
//	I wished to prevent disaster,

/*……そうだ。
私には破滅を望むことが出来なかった。
だが奴は言ったよ。
*/
大統領_017: {
aus Schachfiguren k&~onnten niemals
Spieler werden.
}
//	<<<ENGLISH>>>
//	he replied that pawns can
//	never become players...

/*それが私の限界だ、とな。*/
ライデン_018: {
Und wer ist dieser, Solidus?
}
//	<<<ENGLISH>>>
//	And who is this... Solidus?

/*……ソリダスとは、一体何者なんです？*/
}
//d




resource P049_08_R03_大統領８無線機デモ３＿１__g {
//vc114921
ライデン_000: {
Ich dachte, er w&~are zur&~uckgetreten.
}
//	<<<ENGLISH(2)>>>
//	I thought he resigned...

/*辞任ではなかったのですか？*/
大統領_001: {
Das wollte man die &~Offentlichkeit
glauben machen.
}
//	<<<ENGLISH>>>
//	That's the story given
//	to the general public.

//<ページ数変更>
大統領_001_1: {
Nach seinem 'R&~ucktritt' w&~ahlten die
Patriots mich - ihre neue Schachfigur -
als neuen Pr&~asidenten.
}
//	<<<ENGLISH>>>
//	Following his "resignation," the
//	Patriots selected me -- their
//	new pawn, for the Presidency.

/*公にはな。
そしてその後任の＃｛駒、ポーン｝＃に選ばれたのが
私というわけだ。*/
ライデン_002: {
Aber das hie&~se ja, da&~s der Wahlkampf.
}
//	<<<ENGLISH>>>
//	But that would mean that the
//	Presidential race was --

/*あなたの選挙戦は……？*/
大統領_003: {
Eine gekonnte Show, nicht wahr?
}
//	<<<ENGLISH>>>
//	That was quite a show,
//	wasn't it?

//<ページ数変更>
大統領_003_1: {
Ein von den Patriots f&~ur die &~Offentlichkeit
inszeniertes Drama -- sehr gut gemacht.
}
//	<<<ENGLISH>>>
//	It was a well-scripted drama
//	staged by the Patriots for the
//	benefit of the public.

/*おもしろいショーだっただろう？
大衆を満足させるためのイベントも
多く盛り込んであった。*/
大統領_004: {
Selbst die Demokraten und Republikaner
tanzten nach der Pfeife der Patriots.
}
//	<<<ENGLISH>>>
//	Even the Democrats and
//	Republicans were dancing
//	to the Patriots' tune.

//<ページ数変更>
大統領_004_1: {
Es verlief alles nach Plan,
bis auf eine Ausnahme.
}
//	<<<ENGLISH>>>
//	Everything went according to
//	plan, but for one exception...

/*民主党も共和党も『愛国者達』の意図に
沿って踊っただけだ。全て彼等の筋書き
通り……しかし予定外の出来事もあった。*/
ライデン_005: {
?
}
/*？*/
大統領_006: {
Nach seinem R&~ucktritt sollte Solidus'
angeschlagene Gesundheit vollends
versagen.
}
//	<<<ENGLISH>>>
//	Following his resignation, Solidus'
//	health was scheduled to fail him,
//	bringing about his untimely death.

/*ソリダスは辞任後、病死するはずだった。*/
ライデン_007: {
Um die Ecke gebracht?
}
//	<<<ENGLISH>>>
//	Capped...?


/*暗殺か！？*/
大統領_008: {
Genau. Aber bevor die Patriots ihren Plan
durchf&~uhren konnten,
}
//	<<<ENGLISH>>>
//	Correct. But before the Patriots
//	could execute their plot,

//<ページ数変更>
大統領_008_1: {
setzte sich Solidus mit Ocolots Hilfe ab.
}
//	<<<ENGLISH>>>
//	Solidus went underground
//	with the help of Ocelot.

/*そうだ。だが奴はオセロットの
手を借り地下に潜伏した。*/
大統領_009: {
Er entkam seinen Verfolgern, &~ubernahm
die Kontrolle &~uber Dead Cell
}
//	<<<ENGLISH>>>
//	As he avoided pursuit, Solidus
//	gained control of Dead Cell,

//<ページ数変更>
大統領_009_1: {
und gewann Gurlukovichs Einheit f&~ur sich.
}
//	<<<ENGLISH>>>
//	winning over Colonel
//	Gurlukovich's outfit.

//<ページ数変更>
大統領_009_2: {
Danach spielte er auf Zeit. Er wu&~ste, da&~s
seine Chance schon bald kommen w&~urde.
}
//	<<<ENGLISH>>>
//	From there, he bided his time,
//	knowing that his opportunity
//	would soon arrive...

/*そして『愛国者達』の追撃をかわしながら、デッドセルを手なずけ、ゴルルコ
ビッチ大佐の部隊を懐柔し、時を待った。*/
ライデン_010: {
Was f&~ur eine Chance?
}
//	<<<ENGLISH>>>
//	What opportunity?

/*時？*/
大統領_011: {
Der Abschlu&~s des neuen Metal
Gear-Projekts -
}
//	<<<ENGLISH>>>
//	The completion of the new
//	Metal Gear project --

//<ページ数変更>
大統領_011_1: {
damit w&~are er den Patriots ebenb&~urtig.
}
//	<<<ENGLISH>>>
//	an opportunity that would even
//	his odds against the Patriots.

/*『愛国者達』と対等に渡り合う機会……
新型メタルギアの完成だ。*/
大統領_012: {
Wenn er das wertvollste Projekt
der Patriots stehlen w&~urde,
}
//	<<<ENGLISH>>>
//	By stealing the Patriots'
//	most valued project,

//<ページ数変更>
大統領_012_1: {
k&~onnte er sie in eine sehr
ung&~unstige Lage bringen.
}
//	<<<ENGLISH>>>
//	he would be able to place them
//	in a very uncomfortable position.

/*『愛国者達』が全精力を傾けている
最重要プロジェクトを奪えば彼等の
急所を抑えることが出来る。*/
大統領_013: {
Das ist seine einzige &~Uberlebenschance.
}
//	<<<ENGLISH>>>
//	It's the only chance
//	he has for survival.

/*それが彼等に対抗出来る唯一の
手段だった。*/
大統領_014: {
Sobald er das neue Metal Gear in seiner
Gewalt hat, erkl&~art er den Patriots
den Krieg.
}
//	<<<ENGLISH>>>
//	Once he has the new Metal Gear,
//	he'll declare war against the
//	Patriots.

//<ページ数変更>
大統領_014_1: {
Man mu&~s ihn aufhalten.
}
//	<<<ENGLISH>>>
//	Needless to say,
//	he must be stopped.

/*アレが手に入り次第、奴は戦争を始める
だろう。そうなる前に奴を止めねば
ならん。*/
ライデン_015: {
Das Metal Gear ist schon einsatzbereit.
}
//	<<<ENGLISH>>>
//	Metal Gear is already
//	operational...
//

/*メタルギアはもう起動してしまった……。*/
大統領_016: {
Nein. Noch nicht.
}
//	<<<ENGLISH>>>
//	No. Not yet.

/*いや、まだだ。*/
ライデン_017: {
?
}
/*？*/
大統領_018: {
Du hast Metal Gear RAY gesehen -
}
//	<<<ENGLISH>>>
//	What you saw was
//	Metal Gear RAY --

/*君が見たのはメタルギアＲＡＹ。*/
大統領_019: {
Vor zwei Jahren stahl Ocelot es vom
Marinekorps. Das war nicht das neue
Metal Gear.
}
//	<<<ENGLISH>>>
//	-- hijacked two years ago from
//	the Marines by Ocelot. That was
//	not the new Metal Gear.

/*二年前にオセロットが海兵隊から
奪ったものだ。新型メタルギアではない。*/
ライデン_019: {
Wo ist dann das neue Metal Gear?
}
//	<<<ENGLISH>>>
//	Then, where's the
//	new Metal Gear?

/*では新型メタルギアとは？*/
大統領_020: {
Genau hier.
}
//	<<<ENGLISH(2)>>>
//	Right here.

/*ここだ。*/
ライデン_021: {
Was!?
}
//	<<<ENGLISH(2)>>>
//	What?

/*え？*/
大統領_022: {
Du stehst drin. Genauer gesagt,
die gesamte 'Big Shell' ist das neue
Metal Gear.
}
//	<<<ENGLISH>>>
//	You're standing in it. To be more
//	precise, this entire "Big Shell"
//	facility is the new Metal Gear.

/*この『ビッグ・シェル』全体が
新型メタルギアなのだ。*/
ライデン_023: {
Was sagst Du da?
}
//	<<<ENGLISH>>>
//	What'd you say?

/*なんだって！！*/
大統領_024: {
Nein. Ich meine es ernst. Der Oberbau,
den Du gesehen hast, dient nur der
Tarnung -
}
//	<<<ENGLISH(2)>>>
//	No. I'm quite serious. The
//	upper structure that you've
//	seen is camouflage＃−

//<ページ数変更>
大統領_024_1: {
er soll wie eine Offshore-Reinigungsinsel
aussehen.
}
//	<<<ENGLISH>>>
//	designed to represent an
//	offshore cleanup facility.

//<ページ数変更>
大統領_024_2: {
Die Hauptstruktur reicht vom Fundament
bis hinunter zum Meeresgrund.
}
//	<<<ENGLISH>>>
//	The main structure extends from
//	the foundation all the way down
//	to the ocean floor.

/*君が見てきた上部構造は偽装だ。
海洋除染施設の体裁を整えるためのな。
本体は基底部から海底に建造されている。
*/
大統領_025: {
Der Verbindungslift befindet sich auf
Etage B2 im Kern von Shell 1.
}
//	<<<ENGLISH>>>
//	The connecting elevator is located
//	on the B2 floor of the Shell 1 Core.

/*連絡エレベータは
シェル１中央棟のＢ２だ。*/
大統領_026: {
Arsenal Gear, das ist der Codename f&~ur
das neue Metal Gear.
}
//	<<<ENGLISH>>>
//	Arsenal Gear... that's the code
//	name for the new Metal Gear.

/*＃｛火薬庫、アーセナル｝＃ギア。それが
新型メタルギアのコードネーム……。*/
ライデン_027: {
Arsenal?
}
/*アーセナル？*/
}
//d

resource P049_10_R04_大統領１０無線機デモ４＿１__g {
//vc114931
大統領_000: {
Es ist ein Mittel, um den Status quo
der Welt zu erhalten.
}
//	<<<ENGLISH>>>
//	It is a means to preserve the
//	world as it is. It will establish
//	a new form of control.

/*世界を保全するための手段。
新しい支配の確立。*/
大統領_001: {
Das Metal Gear wird eine neue Art der
Kontrolle schaffen. Die Patriots werden
damit ihre Herrschaftsposition sichern,
}
//	<<<ENGLISH>>>
//	The Patriots will use it to keep
//	their place as the country's true
//	rulers.

/*『愛国者達』がこの国の真実で
ありつづけるための要なのだ。*/
大統領_002: {
Zur Zeit f&~uhlen sie sich bedroht.
}
//	<<<ENGLISH>>>
//	...Right now they feel
//	pressured and threatened.

/*……彼等は今、支配を脅かされ、
焦っている。*/
ライデン_003: {
Wovon?
}
//	<<<ENGLISH>>>
//	By what?

/*何からです？*/
大統領_004: {
Sie f&~urchten, von digitalen Informationen
&~uberflutet zu werden --
}
//	<<<ENGLISH>>>
//	They fear an overabundance
//	of digital information --

//<ページ数変更>
大統領_004_1: {
die Welt wird in dieser Flut ertrinken und
sie mitrei&~sen.
}
//	<<<ENGLISH>>>
//	the world will drown in the
//	coming flood of information,
//	and they along with it.

/*……デジタルによる真実の氾濫、
世界の窒息……といったところかな。*/
ライデン_005: {
?
}
//	<<<ENGLISH(2)>>>
//	?

/*？*/
大統領_006: {
Die Arsenal-Pl&~ane sehen ein System vor,
den Informationsflu&~s digital zu steuern.
}
//	<<<ENGLISH>>>
//	The Arsenal plans include a
//	system to digitally manage
//	the flow of information,

/*それを逆にデジタルによってつなぎとめるためのメソッド。
*/
大統領_007: {
So k&~onnen sie die 'Wahrheit' ganz
in ihrem Sinne formen.
}
//	<<<ENGLISH>>>
//	making it possible to shape the
//	"truth" for their own purposes.

//<ページ数変更>
大統領_007_1: {
Das Arsenal-System ist der Schl&~ussel zu
ihrer Vormachtstellung.
}
//	<<<ENGLISH>>>
//	In short, the Arsenal's system
//	is the key to their supremacy.

/*それを具現化するためのシステムが
アーセナルに搭載されている。
それこそがアーセナルの本質なのだ。*/
ライデン_008: {
Der Schl&~ussel?
}
//	<<<ENGLISH(2)>>>
//	The key...?

/*本質？*/
大統領_009: {
Ja, das 'GW'-System ist die Trumpfkarte
der Patriots.
}
//	<<<ENGLISH>>>
//	Yes, the "GW" system is
//	the Patriots' trump card.

/*『Ｇ．Ｗ』。それはそう呼ばれている。『愛国者達』の切り札。*/
大統領_010: {
Sobald 'GW' erfolgreich integriert ist,
kann Arsenal Gear aktiviert werden.
}
//	<<<ENGLISH>>>
//	Arsenal Gear will be fully
//	operational when "GW" is
//	successfully integrated.

//<ページ数変更>
大統領_010_1: {
Und damit ist es dann ein v&~ollig neues
Machtinstrument f&~ur die Patriots.
}
//	<<<ENGLISH>>>
//	Once operational, it will be
//	a completely new form of
//	power for the Patriots to wield.

/*『Ｇ．Ｗ』とアーセナルギアの完成は
すなわち『愛国者達』による新しい
支配の完成を意味する。*/
大統領_011: {
Ich hatte gehofft, ihnen das Projekt
abnehmen zu k&~onnen. Ich h&~atte eine
starke Verhandlungsposition gehabt.
}
//	<<<ENGLISH>>>
//	I had hoped to seize the project
//	from them so that I would be in
//	a strong bargaining position...

/*それを奪えば彼等と対等な立場に立てる
はずだった。対等な取り引きもな……。*/
ライデン_012: {
Verhandeln wor&~uber?
}
//	<<<ENGLISH>>>
//	Bargain for what?

/*取り引き？
だが奴は……。*/
大統領_013: {
Ich hatte gehofft, mich in ihre Reihen
verhandeln zu k&~ommen. Doch Solidus zog
den Aufstand vor.
}
//	<<<ENGLISH>>>
//	I'd hoped to trade my way
//	into their ranks. But Solidus
//	preferred rebellion.

/*そう。
ソリダスは取り引きではなく
闘争を望んだ。*/
大統領_014: {
Outer Heaven -- sein Plan, den Himmel
&~uber Wall Street mit einem Atompilz
}
//	<<<ENGLISH>>>
//	Outer Heaven -- his plan to
//	unleash a nuclear blast over
//	the skies of Wall Street＃−

//<ページ数変更>
大統領_014_1: {
zu schm&~ucken und so die Kontrolle
der Patriots &~uber
}
//	<<<ENGLISH(2)>>>
//	to break the Patriots' control
//	over the business community --

/*奴がやろうとしているウォール街
上空への核攻撃も、彼等の支配を
断ち切り解放区を形成するためだ。
*/
大統領_015: {
die Wirtschaft zu vernichten.
}
//	<<<ENGLISH>>>
//	is also a key factor
//	in his offensive effort.

/*……奴はそれを
ＯＵＴＥＲ　ＨＥＡＶＥＮと呼んでいた……。*/
ライデン_016: {
Outer Heaven?
}
//	<<<ENGLISH>>>
//	Outer Heaven...?

/*ＯＵＴＥＲ　ＨＥＡＶＥＮ……？*/
大統領_017: {
H&~or zu. Wir haben nicht viel Zeit. Der
'Aktentasche' war der Schl&~ussel f&~ur die
Aktivierung von Arsenal Gear.
}
//	<<<ENGLISH>>>
//	Listen. There isn't much time.
//	The "football" served as the key
//	for activating Arsenal Gear.

//<ページ数変更>
大統領_017_1: {
Ich habe bereits den Code eingegeben.
}
//	<<<ENGLISH>>>
//	I've already input the necessary
//	code sequence...

/*もう時間がない。アーセナルギア起動の
鍵はブラックケースが兼ねていたが……
私が入力してしまった。*/
大統領_018: {
Bald wird 'GW' Verbindungen zu anderen
externen Systemen herstellen
}
//	<<<ENGLISH>>>
//	It won't be long before "GW" begins
//	to establish connections with other
//	external systems＃−

//<ページ数変更>
大統領_018_1: {
und Arsenal Gear wird voll einsatzf&~ahig.
}
//	<<<ENGLISH>>>
//	and Arsenal Gear becomes
//	fully operational.

/*じきに『Ｇ．Ｗ』は外部と接続を開始し、
アーセナルギアの機関部も始動する。*/
大統領_019: {
Das darf nicht geschehen. Du mu&~st sie
vorher aufhalten. Das ist Deine Aufgabe.
}
//	<<<ENGLISH>>>
//	Stop them before that
//	happens. That is your
//	role.

/*そうなる前に奴を止めろ。
それが君の役割だ。*/
ライデン_020: {
Aufgabe?
}
//	<<<ENGLISH(2)>>>
//	Role?

/*役割……？*/
大統領_021: {
Du mu&~st Emma Emmerich finden. Nach
der Aktivierung ist sie die einzige,
die es aufhalten kann.
}
//	<<<ENGLISH>>>
//	You've got to find Emma Emmerich.
//	She's the only one who can stop that
//	thing once it's been activated.

/*動き出したあれを止められるのは
エマ・エメリッヒしかいない。
彼女を探せ。*/
ライデン_022: {
Emma, Emmerich?
}
//	<<<ENGLISH>>>
//	Emma -- Emmerich?

/*エマ……エメリッヒ？*/
大統領_023: {
Sie ist die Systemprogrammiererin f&~ur
Arsenal Gear.
}
//	<<<ENGLISH>>>
//	She's the system programmer
//	for Arsenal Gear.

//<ページ数変更>
大統領_023_1: {
Ich glaube, sie befindet sich in Etage B1
im Kern dieses Geb&~audes.
}
//	<<<ENGLISH>>>
//	I believe she's somewhere on level
//	B1 in the core of this building.

/*アーセナルギアのシステム・
プログラマだ。この中央棟のＢ１で
監禁されているはず。*/
ライデン_024: {
Ich dachte, die Ebenen unter uns seien
&~uberflutet?
}
//	<<<ENGLISH>>>
//	I thought the levels
//	below us were flooded?

/*この下は浸水しているのでは？*/
大統領_025: {
Sie werden sie noch nicht sterben
lassen, da sie die einzige verbliebene
Programmiererin f&~ur dieses Projektist.
}
//	<<<ENGLISH>>>
//	I'm sure they won't let her die just
//	yet as she's the only remaining
//	programmer for this project.

/*いや、彼女はまだ生かされている。
残っているプログラマは彼女だけだ。
*/
大統領_026: {
Ocelot zufolge wird sie in einem
Umkleideraum auf der Nordwestseite
von Etage B1 festgehalten.
}
//	<<<ENGLISH>>>
//	According to Ocelot, she was being
//	held in a locker room located in the
//	northwest part of level B1.

/*オセロットが言っていた……
Ｂ１の北西にあるロッカールームだ。*/
大統領_027: {
Unterbrich die Verbindung und leg los!
}
//	<<<ENGLISH>>>
//	Cut transmission, and get moving!

/*急げ！
通信をとくぞ。*/
}
//d




resource P049_12_R05_大統領１２無線機デモ５＿１__g {
//vc114941
ライデン_000: {
Oberst, der Pr&~asident ist tot.
}
//	<<<ENGLISH>>>
//	Colonel, the President is dead.

/*大佐、大統領が死んだ……。*/
大佐_001: {
Verstehe, Tut mir leid.
}
//	<<<ENGLISH>>>
//	I see... I'm sorry to hear that.

/*ああ……残念なことだ……。*/
ライデン_002: {
Und was jetzt?
}
//	<<<ENGLISH>>>
//	Where do we go from here?

/*俺はこれからどうすれば？*/
大佐_003: {
Dein Auftrag lautete, den Pr&~asidenten zu
retten und die terroristische Bedrohung zu
beseitigen.
}
//	<<<ENGLISH>>>
//	Your mission was to rescue
//	the President and eliminate
//	the terrorist threat.

/*君の目的は大統領の救出とテロリストの武装解除だった……*/
大佐_004: {
Angesichts der j&~ungsten Entwicklungen
werden wir allerdings der letzten
Anweisung des Pr&~asidenten folgen,
}
//	<<<ENGLISH>>>
//	However, given the recent
//	turn of events, we will honor
//	the President's last directive.

//<ページ数変更>
大佐_004_1: {
Arsenal Gear zu zerst&~oren.
}
//	<<<ENGLISH>>>
//	You must put a stop to Arsenal
//	Gear once and for all.

/*だが今からは、大統領の最後の命令を
果たすことが君の任務となる。
……ライデン、アーセナルギアを止めろ。*/
ライデン_005: {
Glaubst Du wirklich, an dieser Geschichte,
}
//	<<<ENGLISH>>>
//	Do you actually think there's
//	any truth to his story＃−

//<ページ数変更>
ライデン_005_1: {
die 'Big Shell' sei nur eine Tarnkappe f&~ur
Arsenal Gear, ist etwas Wahres dran?
}
//	<<<ENGLISH>>>
//	about this "Big Shell" facility
//	being a front for Arsenal Gear?

/*この『ビッグ・シェル』全体が
メタルギアだという話を信じろと？*/
大佐_006: {
Ich besitze nicht die erforderlichen
Befugnisse, um das zu best&~atigen.
}
//	<<<ENGLISH>>>
//	I don't have the security clearance
//	necessary to verify the facts.

//<ページ数変更>
大佐_006_1: {
Aber er war der Pr&~asident. Ich bin mir
sicher, da&~s er wu&~ste, wovon er sprach.
}
//	<<<ENGLISH>>>
//	However, he was the President.
//	I'm sure he knew what he was
//	talking about.

/*私のセキュリティ・クリアランスでは
確認することは出来なかったが……
大統領本人の言葉だ。間違いないだろう。*/
ライデン_007: {
Abe rer war Teil dieses terroristischen
Komplotts?
}
//	<<<ENGLISH>>>
//	Aren't you forgetting that he
//	was part of the terrorist plot?

/*彼自身がテロに荷担していたとしても？*/
大佐_008: {
Noch ein Grund, warum ich seinen
Informationen glaube.
}
//	<<<ENGLISH>>>
//	All the more reason why I believe
//	his information is reliable.

/*だからこそ、信憑性が高いとも言える。*/
ライデン_009:
''
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
大佐_010: {
Dieser Mann starb lieber, als einen
nuklearen Holokaust zu riskieren.
}
//	<<<ENGLISH>>>
//	We're talking about a man who
//	chose to die rather than risk a
//	nuclear holocaust.

/*それに大統領は君に自分を殺すよう頼み
すらした。核発射を無効にするために。*/
大佐_011: {
Dank seines Opfers hat jetzt der
Vizepr&~asident die Macht &~uber
die Atomwaffen.
}
//	<<<ENGLISH>>>
//	Thanks to his sacrifice, the nuclear
//	launch authority has shifted to the
//	Vice President,

//<ページ数変更>
大佐_011_1: {
Damit ist die terroristischen Bedrohung
beendet.
}
//	<<<ENGLISH>>>
//	effectively eliminating
//	the terrorist threat.

/*彼が死んだお陰で核兵器の行使権限は
副大統領に移った。
これで奴等の核兵器はただの飾りに……。*/
ライデン_012: {
So formuliert, Oberst,
h&~ort es sich fast so an,
}
//	<<<ENGLISH>>>
//	Colonel, when you
//	put it like that,

//<ページ数変更>
ライデン_012_1: {
als h&~atte ich den Pr&~asidenten t&~oten
sollen, um 'die Bedrohung aus dem
Weg zu r&~aumen'.
}
//	<<<ENGLISH>>>
//	it almost sounds like I should've
//	assassinated the President to
//	"eliminate the threat."

/*大佐、
俺が大統領を殺すべきだったとでも？*/
大佐_013: {
Das wollte ich damit nicht sagen.
}
//	<<<ENGLISH>>>
//	That was not my intention.

//<ページ数変更>
大佐_013_1: {
Ich wollte nur erkl&~aren, da&~s ein Mann,
}
//	<<<ENGLISH>>>
//	I was trying to point out that there
//	is certainly some credibility to the
//	words of a man＃−

//<ページ数変更>
大佐_013_2: {
der durch seinen Tod Unschuldige
sch&~utzen wollte, durchaus glaubhaft ist.
}
//	<<<ENGLISH>>>
//	who chose death to protect
//	the innocent.

/*そうではない。彼の言葉は信用して
いいのではないかと言いたいのだ。*/
ローズ_014: {
Der Oberst hat recht, Jack.
}
//	<<<ENGLISH>>>
//	The Colonel has a point, Jack.

/*ジャック、私もそう思う……。*/
ライデン_015: {
Was ist mit seinen Informationen
&~uber die 'Patriots'?
}
//	<<<ENGLISH>>>
//	What about the information
//	he gave me on the "Patriots"?

/*……『愛国者達』とかいう連中に
ついての話も信じろと？*/
大佐_016: {
Das ist mir neu. Mal sehen,
was ich erfahren kann.
}
//	<<<ENGLISH>>>
//	That's a new one on me.
//	I'll see what I can find out.

/*それについては初耳だ。
調査する。*/
ライデン_017:
''
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
大佐_018: {
Raiden, die Zeit rennt.
}
//	<<<ENGLISH>>>
//	Raiden, we're running out of time.

//<ページ数変更>
大佐_018_1: {
Du mu&~st Emma finden. Sie soll sich im
gleichen Geb&~aude wie Du, im Kern auf
Etage B1, befinden
}
//	<<<ENGLISH>>>
//	Find Emma. She's supposed to be
//	located on level B1, in the core of
//	that building you're in, right?

/*ライデン、時間がないぞ。
エマを探し出すんだ。
彼女はその中央棟のＢ１だろう？*/
ライデン_019:
''
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
大佐_020: {
Du mu&~st sie finden, bevor Arsenal voll
einsatzf&~ahig ist.
}
//	<<<ENGLISH>>>
//	You've got to find her before
//	Arsenal becomes fully operational.

/*アーセナルが動き出す前に彼女を
見つけ出すんだ！*/
ローズ_021: {
Beeil' Dich, Jack!
}
//	<<<ENGLISH>>>
//	Hurry Jack!

/*急いで、ジャック！*/
ライデン_022:
''
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
大佐_023: {
Du mu&~st sicherstellen, da&~s der Pr&~asident
sein Leben nicht umsonst geopfert hat.
}
//	<<<ENGLISH>>>
//	It's up to you to make sure
//	that the President didn't
//	sacrifice his life in vain.

/*大統領の死を無駄にする気か！？*/
ライデン_024: {
Verstanden, Raiden aus.
}
//	<<<ENGLISH>>>
//	Understood....
//	Raiden out.

/*……了解。*/
}
//d



resource P050_01_R01_タンカー編整理１無線機デモ１＿１__g {
//vc115001
プリスキン_000: {
Wie sieht es aus, Raiden?
}
//	<<<ENGLISH>>>
//	What's your status, Raiden?

/*ライデン、そっちはどうだっ！*/
ライデン_001: {
Snake? Der Pr&~asident, er wurde
umgebracht.
}
//	<<<ENGLISH>>>
//	Snake? The President,
//	he's been assassinated.

/*スネーク？
……大統領が殺された！*/
プリスキン_002: {
Was!?
}
//	<<<ENGLISH(2)>>>
//	What!?

/*なんだって？*/
ライデン_003: {
Ich konnte es nicht verhindern --
}
//	<<<ENGLISH>>>
//	There was nothing I could do --

/*すまない。*/
プリスキン_004: {
Was ist mit der Codefolge f&~ur den
atomaren Angriff!?
}
//	<<<ENGLISH>>>
//	What about the nuclear
//	strike code sequence!?

/*核発射コードの再確認はすんでいたのか？*/
ライデン_005: {
Er starb vor der Best&~atigung seiner
biologischen Daten.
}
//	<<<ENGLISH>>>
//	He died before his vital ID
//	could be reconfirmed.

/*いや、最終のヴァイタルＩＤチェックの
前だった。*/
プリスキン_006: {
Dann kann der Feind keine Atomwaffen
mehr einsetzen --
}
//	<<<ENGLISH>>>
//	Then the enemy's lost their
//	nuclear strike capability --

/*ということは、奴らは核を撃てなく
なったわけだな。*/
ライデン_007: {
Aber Ocelot hat den Pr&~asidenten eindeutig
mit Absicht get&~otet.
}
//	<<<ENGLISH>>>
//	But, that Ocelot guy obviously
//	killed the President on purpose.

/*だが、あの男、オセロットは明らかに
わざと大統領を殺した。*/
プリスキン_008: {
Warum?
}
//	<<<ENGLISH(2)>>>
//	Why?

/*どういうことだ？*/
ライデン_009: {
Es ergibt keinen Sinn.
}
//	<<<ENGLISH>>>
//	It doesn't make any sense.

//<ページ数変更>
ライデン_009_1: {
Sie m&~ussen doch gewu&~st haben, da&~s
sie mit einem toten Pr&~asidenten keine
Atomwaffe starten k&~onnen.
}
//	<<<ENGLISH>>>
//	They had to know that they
//	couldn't launch the nuke if
//	they killed the President.

/*わからない。大統領が死ねば核が
撃てなくなることは奴等も知っていた
はずだ。*/
オタコン_010: {
Vielleicht gibt es eine M&~oglichkeit, die
Waffe ohne Datenbest&~atigung zu starten.
}
//	<<<ENGLISH>>>
//	Maybe there's a way to launch
//	without reconfirming the vital ID?

/*ヴァイタルＩＤチェックを回避して
核を撃つ方法がある？*/
プリスキン_011: {
Oder sie haben im Arsenal Gear eine
wirksamere Waffe gefunden.
}
//	<<<ENGLISH>>>
//	Or maybe they've found a more
//	effective weapon within Arsenal
//	Gear.

/*あるいは核以上の何かがあるということ
だろうな……アーセナルギアには。*/
ライデン_012: {
Du hast vom Arsenal Gear gewu&~st?
}
//	<<<ENGLISH>>>
//	You knew about Arsenal Gear!?

/*知っていたのか？アーセナルギアのこと？*/
プリスキン_013: {
Ja.
}
//	<<<ENGLISH>>>
//	Yeah...

/*ああ。*/
ライデン_014: {
Und warum hast Du mir nichts
davon gesagt!?
}
//	<<<ENGLISH(2)>>>
//	Then why didn't you
//	tell me about it!?

/*……なぜ教えてくれなかった？*/
プリスキン_015: {
Du hast nicht gefragt.
}
//	<<<ENGLISH(2)>>>
//	You never asked.

/*聞かれなかったからな。*/
ライデン_016: {
Gehe ich recht in der Annahme,
da&~s Du auch wusstest, da&~s die
Big Shell nur eine Fassade ist!?
}
//	<<<ENGLISH>>>
//	Am I correct in assuming you
//	also know that the Big Shell's
//	a front for the project!?

/*……『ビッグ・シェル』が偽装だという
ことも？*/
プリスキン_017: {
Du meinst, ob ich wu&~ste,
da&~s die Big Shell,
}
//	<<<ENGLISH>>>
//	You mean, did I know
//	that the Big Shell,

//<ページ数変更>
プリスキン_017_1: {
eine voll funktionsf&~ahige
Umwelt-Reinigungsanlage, nur als
Tarnung f&~ur Arsenal Gear gedacht war?
}
//	<<<ENGLISH>>>
//	a fully functional environmental
//	cleanup facility, was designed to
//	camouflage Arsenal Gear?

/*ああ。この『ビッグ・シェル』は一応、
海洋除染施設の体裁を整えてはいる。
*/
プリスキン_018: {
Ja, das wu&~ste ich.
}
//	<<<ENGLISH>>>
//	Yeah, I did.

プリスキン_018_1: {
Genauso, wie der Pr&~asident und Ames es
beschrieben haben.
}
//	<<<ENGLISH>>>
//	It's exactly what the President
//	and Ames described... a massive
//	cover story.

/*だがエイムズや大統領の言った通り、
それは偽装だった。*/
プリスキン_019: {
Die Anlage hat aber noch nicht richtig mit
der S&~auberung der Umwelt begonnen. Falls
wir sie in die Luft jagen m&~ussen,
}
//	<<<ENGLISH>>>
//	The good news is that it hasn't
//	really done much in terms of
//	cleaning up the environment,

//<ページ数変更>
プリスキン_019_1: {
brauchen wir uns wenigstens keine
Gedanken &~uber toxische Gase zu
machen.
}
//	<<<ENGLISH>>>
//	so we won't have to worry about
//	any toxic gas being released if
//	we have to blow the house down.

/*海水除染は申し訳程度にしか行われて
いないし、破壊されても有毒化学物質
など発生しないだろう……。*/
ライデン_020: {
Gut, und seit wann wei&~st Du all dies?
}
//	<<<ENGLISH>>>
//	Right... and when did
//	you find out about all
//	of this?

/*……いつからそれを？*/
プリスキン_021: {
Ungef&~ahr zu der gleichen Zeit, als Du den
verr&~uckten Bomber ausgeschaltet hast.
}
//	<<<ENGLISH>>>
//	It took a while, but we uncovered
//	the info around the time you took
//	out that mad bomber.

/*確かめるには時間がかかった。
調べがついたのはお前があの爆弾魔を
処理した後くらいだな。*/
ライデン_022:
''
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
プリスキン_023: {
Es steht au&~ser Zweifel,
da&~s Arsenal Gear hier gebaut wird.
}
//	<<<ENGLISH>>>
//	There's no doubt that Arsenal
//	Gear is being built here...

/*アーセナルギアがここで建造されて
いるのは確かだ。
*/
プリスキン_024: {
und an jenem Tag vor zwei Jahren stand
alles -- komplett alles.
}
//	<<<ENGLISH>>>
//	then it was all set up two years
//	ago on that day -- all of it.

/*おそらく二年前のあの時から
仕組まれていたんだろう……
全てがな……。*/
ライデン_025: {
Vor zwei Jahren, Was ist hier wirklich
geschehen?
}
//	<<<ENGLISH>>>
//	Two years ago...
//	What really happened here?

/*二年前……
この場所で本当は何があったんだ？*/
}
//d




resource P050_04_R02_タンカー編整理４無線機デモ２＿１__g {
//vc115011
ライデン_000: {
Wie bist Du rausgekommen?
}
//	<<<ENGLISH>>>
//	How did you manage to get out?

/*よく無事だったな？*/
プリスキン_001: {
Otacon konnte ein kleines Boot f&~ur mich
bereithalten.
}
//	<<<ENGLISH>>>
//	Otacon managed to have
//	a small boat ready for me.

/*オタコンが小型艇を用意してくれていた。*/
オタコン_002: {
Das war noch das Einfachste.
}
//	<<<ENGLISH>>>
//	That was the easy part.

//<ページ数変更>
オタコン_002_1: {
Schwerer war dann, nicht vom sinkenden
Tanker heruntergezogen zu werden.
}
//	<<<ENGLISH>>>
//	The tough part was not getting
//	dragged down with the sinking
//	tanker --

//<ページ数変更>
オタコン_002_2: {
Eigentlich ein kleines Wunder.
}
//	<<<ENGLISH>>>
//	small miracle when
//	you think about it.

/*沈没するタンカーに巻き込まれない
ようにするのが大変だった。
我ながら、奇跡に近い。*/
オタコン_003: {
Es stellte sich dann heraus,
da&~s das Ganze nur ein K&~oder war.
}
//	<<<ENGLISH>>>
//	It turned out that the whole
//	thing was a setup to lure us.

/*全ては僕達をおびき寄せるための
罠だったんだ。*/
}
//d





resource P050_06_R03_タンカー編整理６無線機デモ３＿１__g {
//vc115021
プリスキン_000: {
Vergi&~s es. Wir vergeuden Zeit. Dar&~uber
k&~onnen wir sp&~ater nachdenken.
}
//	<<<ENGLISH>>>
//	Forget it. We're wasting time.
//	We can figure this out later.

/*なに、いずれわかるだろうさ……。
だが今はこれ以上考えている時間は
なさそうだ。*/
プリスキン_001: {
Wir haben einen Nuklearschlag verhindert.
}
//	<<<ENGLISH>>>
//	The nuclear strike's
//	been prevented,

//<ページ数変更>
プリスキン_001_1: {
Trotzdem ist Arsenal noch mit ungeheuren
Mengen an Flugk&~orpern beladen.
}
//	<<<ENGLISH>>>
//	but Arsenal still has a massive
//	payload of missiles to deal with.

/*核が使えなくとも、アーセナルには
莫大な量のミサイル兵器がある。*/
オタコン_002: {
Genau. Und wenn die in die H&~ande
des Gegners fallen.
}
//	<<<ENGLISH>>>
//	Right. If the opposition gets
//	control of those missiles...

/*そうだね。
奴等がそれを手に入れたら……。*/
プリスキン_003: {
Raiden -- Du mu&~st Emma finden.
}
//	<<<ENGLISH>>>
//	Raiden -- you've
//	got to find Emma.

/*ライデン、エマのところに急いでくれ。*/
ライデン_004: {
Warte mal. Ist Emma Emmerich nicht --
}
//	<<<ENGLISH>>>
//	Wait a second.
//	Isn't Emma Emmerich --

/*待ってくれ、そのエマ・エメリッヒと
いうのが、あんた達が言っていた……？*/
オタコン_005: {
Meine Schwester.
}
//	<<<ENGLISH(2)>>>
//	My sister.

/*そう。僕の妹だ。*/
ライデン_006: {
Was macht sie hier?
}
//	<<<ENGLISH>>>
//	What's she doing here?

/*彼女はここで何を？*/
オタコン_007: {
Sie ist eine Computerexpertin,
spezialisiert auf die neurale AI -
}
//	<<<ENGLISH>>>
//	You got me. She's a computer whiz
//	who specializes in neural-AI＃−

//<ページ数変更>
オタコン_007_1: {
und Datenanalyse von ultravariablen
Volumina mit Hilfe komplexer Logik.
}
//	<<<ENGLISH>>>
//	and ultra-variable volume data
//	analysis using complex logic.

/*……わからない。
彼女は確かにコンピュータの天才だ。
でも専門はニューロＡＩと複雑性理論を
応用した超多変量情報解析で、*/
オタコン_008: {
Wie sie zur Waffenentwicklung kam,
wei&~s ich nicht.
}
//	<<<ENGLISH>>>
//	How she got involved in
//	weapons development is
//	beyond me.

/*兵器開発
じゃないんだ……。*/
ライデン_009:
''
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
プリスキン_010: {
Was f&~ur Gr&~unde sie auch haben mag,
wir brauchen sie, Arsenal zu stoppen.
}
//	<<<ENGLISH>>>
//	Whatever her reasons, we need
//	her in order to stop Arsenal.

/*とにかくアーセナルを止めるには
彼女の力を借りるしかない。*/
オタコン_011: {
Raiden -- finde sie.
}
//	<<<ENGLISH>>>
//	Raiden -- find her.

/*ライデン、彼女を頼む。*/
ライデン_012: {
Bin schon auf dem Weg.
}
//	<<<ENGLISH>>>
//	I'm on my way.

/*わかった。*/
}
//d



resource P051_01_R01_エマとオタコン１無線機デモ１＿１__g {
//vc115101
ライデン_000: {
Oberst, ich m&~ochte einige
Hintergrundinformationen
zu Emma Emmerich.
}
//	<<<ENGLISH>>>
//	Colonel, I want some background
//	information on Emma Emmerich.

/*大佐、
エマ・エメリッヒの情報を知りたい。*/
大佐_001: {
Ich habe ihre Personalakte der Nationalen
Sicherheitsbeh&~orde vor mir liegen.
}
//	<<<ENGLISH>>>
//	I've got it right here, direct from
//	the National Security Agency's
//	personnel files.

/*ああ。調べさせておいた。
＃｛国家安全保障局、ＮＳＡ｝＃の局員ファイルに
彼女の名前があった。*/
大佐_002: {
Anscheinend arbeitete sie an einem sehr
wichtigen Projekt mit -- es werden aber
keine Details genannt.
}
//	<<<ENGLISH>>>
//	Apparently she was involved in some
//	sort of high-level project, but
//	there's no details on that.

/*何らかの極秘プロジェクトに関わって
いたようだが、それについての記載は
ない。*/
大佐_003: {
Ihre Unterlagen zeigen, da&~s sie vor zwei
Jahren den Dienst quittierte --
}
//	<<<ENGLISH>>>
//	Her record shows that she resigned
//	from the agency two years ago --

/*記録では二年前に職を辞したことに
なっている……。*/
大佐_004: {
Emma Emmerich. Vollst&~andiger Name:
Emma Emmerich-Danziger.
}
//	<<<ENGLISH>>>
//	Emma Emmerich.
//	Full name: Emma
//	Emmerich-Danziger.

大佐_004_1: {
Ihre Familie nennt sie 'E.E.'.
}
//	<<<ENGLISH>>>
//	Members of her
//	family call her "E.E."

/*エマ・エメリッヒ。
本名、エマ・エメリッヒ・ダンジガー。
家族からはＥＥと呼ばれていたらしい。*/
大佐_005: {
Nach ihrer Scheidung von Hal Emmerichs
Vater nahm die Mutter Emma mit nach
England.
}
//	<<<ENGLISH>>>
//	After divorcing Hal Emmerich's
//	father, her mother took Emma to
//	England and raised her there.

/*彼女はハル・エメリッヒの父親と離婚後、
母に連れられてイギリスに戻った。*/
大佐_006: {
Danziger ist der M&~adchenname ihrer
Mutter, sie zieht aber Emmerich vor.
}
//	<<<ENGLISH>>>
//	Danziger is her mother's maiden
//	name, but she prefers Emmerich.

/*まだ６歳の子供だった。ダンジガーは
母親の姓だが、彼女は好んでエメリッヒ
という姓を使っている。*/
大佐_007: {
Nach ihrer R&~uckkehr nach England
heiratete ihre Mutter den Gesch&~aftsmann
Robinson.
}
//	<<<ENGLISH>>>
//	After returning home to England,
//	her mother married Robinson,
//	a businessman.

/*故郷イギリスに帰った後、
彼女の母親は再婚している。
ロビンソンという実業家だ。*/
大佐_008: {
Die folgenden Angaben stammen aus
einem Bericht, den die NSA bei Emmas
Dienstantritt speicherte.
}
//	<<<ENGLISH>>>
//	The following details are from a
//	report filed with the NSA when
//	she joined the agency...

/*以下はＮＳＡに入る際、取られた調書だ。*/
大佐_009: {
Unmittelbar vor ihrem Schulabschlu&~s
verletzte Emma Robinson in Notwehr.
}
//	<<<ENGLISH>>>
//	Just before graduating from high
//	school, Emma injured Robinson in
//	self-defense＃−

//<ページ数変更>
大佐_009_1: {
Angeblich hatte er versucht,
sie zu bel&~astigen.
}
//	<<<ENGLISH>>>
//	during an alleged assault
//	on her person.

/*……エマがハイスクールを卒業しようと
していた頃、義理の父親から暴行を受け
そうになり、父親を傷つけてしまう。*/
大佐_010: {
Nach diesem Zwischenfall folgte sie ihrem
Stiefbruder Hal Emmerich
}
//	<<<ENGLISH>>>
//	As a result of this incident, she
//	followed in the footsteps of her
//	stepbrother, Hal Emmerich,

//<ページ数変更>
大佐_010_1: {
und schrieb sich in Oxford ein.
}
//	<<<ENGLISH>>>
//	and left home to enroll in Oxford.

/*この事が原因でエマは義理の兄、ハル・
エメリッヒが歩んだのと同じように一人
家を出てオックスフォードへ入学する。*/
大佐_011: {
Es hei&~st, zu eben jenem Zeitpunkt sei
sie ganz besonders &~uber die Tatsache
ver&~argert gewesen,
}
//	<<<ENGLISH>>>
//	It is believed that at this
//	particular point in her life,

//<ページ数変更>
大佐_011_1: {
da&~s ihr Bruder sie nicht sch&~utzen konnte
}
//	<<<ENGLISH>>>
//	she was extremely angered by
//	the fact that her brother failed
//	to protect her.

/*この時もエマは自分を守ってくれない兄、
ハルに対して非常な怒りを憶えている。*/
大佐_012: {
Sie brach daher jeden Kontakt zu ihrer
Familie ab, und ist ihrer Familie noch
immer nicht wohl gesonnen.
}
//	<<<ENGLISH>>>
//	Consequently, she lost all family
//	connections and is very resentful.

//<ページ数変更>
大佐_012_1: {
Sie scheint zu glauben, da&~s ihr Bruder an
allem die Schuld tr&~agt.
}
//	<<<ENGLISH>>>
//	She seems to believe that her
//	brother is to blame for everything.

/*エマもハルと同じく、この時に事実上、
家族を失っている。『自分の不幸は全て
兄のせいだ』とも思いこんでいるようだ。*/
大佐_013: {
In Oxford machte
}
//	<<<ENGLISH>>>
//	While attending Oxford,

//<ページ数変更>
大佐_013_1: {
sie wegen einer erfolgreichen
Entschl&~usselung f&~ur den britischen
GCHQ von sich reden.
}
//	<<<ENGLISH>>>
//	she was noted for her success in
//	a deciphering event sponsored by
//	British GCHQ.

/*オックスフォード在学中に、彼女は
英国政府中央情報部が主催する暗号解読
イベントで解読に成功している……。*/
ライデン_014: {
Auch wenn sie nicht blutsverwandt sind,
sie h&~ort sich ganz nach Otacons
Schwester an.
}
//	<<<ENGLISH>>>
//	They may not be blood-related,
//	but she sure sounds like Otacon's
//	sister.

/*なるほど、血は繋がってはいないが、
オタコンの妹だ。*/
大佐_015: {
Das ist noch nicht alles --
}
//	<<<ENGLISH>>>
//	There's more --

/*いやそれで終わりではない。*/
大佐_016: {
Raiden, erinnerst Du Dich an eine gewisse
'Situation', die unter Hackern zur Legende
geworden ist?
}
//	<<<ENGLISH>>>
//	Raiden, do you recall a certain
//	'situation' that's more or less
//	become a legend among hackers?

/*ライデン、ハッキング史上類をみない、
ある出来事を覚えているか？*/
大佐_017: {
La&~s mich Dein Ged&~achtnis auffrischen --
}
//	<<<ENGLISH>>>
//	To refresh your memory --

//<ページ数変更>
大佐_017_1: {
damals befanden sich fast unsere
gesamten nationalen Kommunikations-
und Informationssyteme
}
//	<<<ENGLISH>>>
//	at the time, just about all of
//	our nation's communications
//	and information resources
//<ページ数変更>
大佐_017_2: {
im NSA in Fort Meade.
}
//	<<<ENGLISH>>>
//	were concentrated at NSA,
//	in Fort Meade.

/*当時の、わが国のあらゆる通信情報は
フォート・ミードにあるＮＳＡに
集中していた。*/
大佐_018: {
Im Keller des NSA-Geb&~audes wurden rund
um die Uhr Daten nicht
}
//	<<<ENGLISH>>>
//	In fact, NSA's basement facility
//	operated round-the-clock to
//	amass data obtained＃−

//<ページ数変更>
大佐_018_1: {
nur aus &~offentlichen Kommunikationen
gesammelt, sondern es wurde alles, vom
Satelliten bis zur Wanze abgeh&~ort.
}
//	<<<ENGLISH>>>
//	not only from public communications,
//	but everything from satellite to
//	wiretap operations as well.

/*衛星や盗聴などで得られた一般を含む
あらゆる通信情報が、２４時間体勢で
ＮＳＡの地下に集められていたのだ。*/
大佐_019: {
Ich glaube nicht, da&~s ich &~ubertreibe. Aber
derjenige, der die NSA-Anlage kontrollierte,
konnte die Welt bewegen.
}
//	<<<ENGLISH>>>
//	I don't think I'm exaggerating when
//	I say that whoever controlled the
//	NSA facility could move the world.

/*ここの情報を牛耳るものがそれこそ、
世界を動かす事ができる。*/
大佐_020: {
Am 24. Januar 2000 fielen pl&~otzlich alle
Systeme in der Anlage 73 Stunden lang
aus.
}
//	<<<ENGLISH>>>
//	On January 24th in the year 2000,
//	the facility suffered a total system
//	shutdown for a 73-hour period.

/*ところが、２０００年の１月２４日……
このシステムが７３時間に渡って
ダウンした……。*/
ライデン_021: {
Fand man je heraus, warum?
}
//	<<<ENGLISH>>>
//	Did they ever figure out the cause?

/*原因は？*/
大佐_022: {
Man geht davon aus, da&~s eine kleine
Fraktion innerhalb der Regierung den
Zwischenfall
}
//	<<<ENGLISH>>>
//	It's believed that a small
//	group within the government
//	had arranged the incident＃−

//<ページ数変更>
大佐_022_1: {
mit Hilfe einer ber&~uchtigten Gruppe von
Crackern verursachte.
}
//	<<<ENGLISH>>>
//	with the assistance of a
//	notorious group of crackers.

/*政府の一部が指示したという噂がある。
当時有名だったクラッカー・グループにな。*/
大佐_023: {
Nach diesem St&~orfall wurden alle
NSA-Sicherheitsma&~snahmen &~uberpr&~uft.
}
//	<<<ENGLISH>>>
//	The result was a full review
//	of NSA's safety measures,

//<ページ数変更>
大佐_023_1: {
Man beschlo&~s, die Datensammlung an
einen isolierten Ort zu verlegen,
}
//	<<<ENGLISH>>>
//	which in turn led to the decision
//	to shift the data-gathering
//	operations to an isolated location

/*結果として安全対策は見直され、
ＮＳＡのこの機能を別に移そうという
計画になった……
*/
大佐_024: {
gesch&~utzt vor physischen Angriffen
wie auch vor Cyber-Terrorismus.
}
//	<<<ENGLISH>>>
//	that would be safe from physical
//	attack as well as cyber-terrorism.

/*物理的なテロやサイバーテロから
隔離された場所に。
*/
ライデン_025: {
Wo k&~onnte das sein?
}
//	<<<ENGLISH>>>
//	And where might that be?

/*何処に？*/
大佐_026: {
Mit meiner Sicherheitsstufe erhalte
ich diese Informationen nicht.
}
//	<<<ENGLISH>>>
//	My security clearance couldn't
//	get me that information.

//<ページ数変更>
大佐_026_1: {
Ich konnte aber herausfinden, da&~s ein
zentrales Mitglied der Hacker-Gruppe
Emma Emmerich war.
}
//	<<<ENGLISH>>>
//	But I did find out that one of the
//	key members of the hacker group
//	was none other than Emma Emmerich.

/*それは私のクリアランスでは
近づくことはできない。
そのメンバーの中心人物がエマだった。*/
大佐_027: {
Sie hatte sich zwar anfangs auf k&~unstliche
Intelligenz und komplexe Logik
spezialisiert,
}
//	<<<ENGLISH>>>
//	Although she started off
//	as a specialist in artificial
//	intelligence and complex logic,

//<ページ数変更>
大佐_027_1: {
gilt aber heute als ein Computergenie.
}
//	<<<ENGLISH>>>
//	Emma is now regarded
//	as a computer genius.

/*彼女の専門はあくまで人工知能と複雑性
理論だったが、既にコンピュータの天才
として一目を置かれる存在になっていた。*/
ライデン_028: {
Damit w&~are sie eine Spitzenkandidatin
}
//	<<<ENGLISH>>>
//	That would make her a prime
//	candidate for recruitment＃−

//<ページ数変更>
ライデン_028_1: {
f&~ur jeden Nachrichtendienst,
nicht wahr?
}
//	<<<ENGLISH>>>
//	in the intelligence community,
//	wouldn't it?

//<ページ数変更>
ライデン_028_2: {
Und so wie ich die meisten
Nachrichtendienste kenne,
}
//	<<<ENGLISH>>>
//	And knowing most of the
//	intelligence agencies,

//<ページ数変更>
ライデン_028_3: {
m&~ochte ich bezweifeln, da&~s sie sich bei
ihren Rekrutierungsbem&~uhungen gro&~s um
Fair Play scheren.
}
//	<<<ENGLISH>>>
//	I doubt fair play was a major
//	concern in their recruiting
//	efforts...

/*で、世界中の諜報機関が彼女を
スカウトした。いつもの汚いやり方で？*/
大佐_029: {
Deine Annahme ist richtig. Die Regierung
nutzte ihre Schw&~ache aus --
}
//	<<<ENGLISH>>>
//	Your assumption's correct.
//	The government played on
//	her weakness --

/*あまり違いはない。
政府は彼女の弱みを探した。*/
大佐_030: {
-- ihren Ha&~s auf Hal Emmerich,
}
//	<<<ENGLISH>>>
//	-- her strong hate
//	for Hal Emmerich,

/*彼女の弱みは……６歳の時に別れた兄、
ハル・エメリッヒへの想いだった。*/
大佐_031: {
ihren Bruder, der sie verlie&~s, als sie
gerade mal sechs Jahre alt war.
}
//	<<<ENGLISH>>>
//	the brother who left her when
//	she was six years old.

/*それも強烈な恨みだ。
*/

ライデン_032: {
Sie ha&~st ihn so sehr?
}
//	<<<ENGLISH>>>
//	She hates him that much?

/*恨み？*/
大佐_033: {
Als sie sechs Jahre alt war, hatten
Emma und ihr Vater einen Badeunfall.
Sie &~uberlebte,
}
//	<<<ENGLISH>>>
//	When she was six years old, Emma
//	and her father were involved in a
//	pool accident.

大佐_033_1: {
doch ihr Vater ertrank.
}
//	<<<ENGLISH>>>
//	She survived, but her father drowned.

/*彼女が６歳の時に事故があった。エマと父親がプールで溺れた。父親は助からず、溺死した。
*/
ライデン_034: {
Was hielt die Polizei von der Sache?
}
//	<<<ENGLISH>>>
//	What did the police have
//	to say about that?

/*警察は？
*/
大佐_035: {
Im Polizeibericht hei&~st es Unfall
mit Todesfolge.
}
//	<<<ENGLISH>>>
//	Their report states it
//	was an accidental death.

/*当時の警察は事故として処理している。
*/
ライデン_036: {
Verlie&~s Otacon nicht um diese Zeit Heim
und Familie?
}
//	<<<ENGLISH>>>
//	Isn't that about the time that
//	Otacon left his home and family?

/*オタコンが家を出たのはその直後なのか？
*/
大佐_037: {
Genau. Aber ich wei&~s nicht, warum.
}
//	<<<ENGLISH>>>
//	Exactly. But I don't have any
//	idea why he chose to do so.

/*そうだ。何があったかはわからんが……。
*/
}//d

resource P051_01_R01_エマとオタコン１無線機デモ１＿２__g {
//vcxxxxxxxxx
ライデン_000: {
Gibt Emma ihm die Schuld am Tod ihres
Vaters?
}
//	<<<ENGLISH>>>
//	Does Emma blame Otacon
//	for her father's death?

/*エマは事故の原因を？*/
大佐_001: {
Ich glaube nicht. Ich glaube, sie ha&~st
ihn, weil sie denkt, er habe sie im Stich
gelassen.
}
//	<<<ENGLISH>>>
//	I don't think so. Her hate seems to
//	stem from the fact that she believes
//	Otacon abandoned her.

/*いや、エマは兄に見捨てられたと
思っているようだ。*/
大佐_002: {
Auch wenn die beiden nicht wirklich
verwandt waren, standen sie sich
anscheinend sehr nahe.
}
//	<<<ENGLISH>>>
//	You see, although the two weren't
//	directly related, they were said to
//	be very close.

/*それまでは連れ子同士にもかかわらず、
非常に仲のいい＃｛兄妹、きょうだい｝＃だった
らしい。*/
大佐_003: {
Es hei&~st, da&~s sie ihre Hacker-Karriere
begann, um es ihrem Bruder zu zeigen.
}
//	<<<ENGLISH>>>
//	It's rumored that sibling rivalry
//	was what launched her career
//	as a hacker.

/*彼女がクラッカーまがいの行為を
行なっていたのも、兄への対抗意識
だったのだろう……。*/
大佐_004: {
Vor vier Jahren lie&~s die Regierung ihr
Details zu Shadow Moses zukommen.
}
//	<<<ENGLISH>>>
//	Four years ago, the government
//	leaked her the details of the
//	Shadow Moses incident.

//<ページ数変更>
大佐_004_1: {
Dadurch konnten sie sie f&~ur die NSA
rekrutieren.
}
//	<<<ENGLISH>>>
//	In doing so, they were able
//	to recruit her for the NSA.

/*そして４年前、政府はシャドーモセス
事件の真実を彼女にリークし、ＮＳＡへ
入ることに同意させた。*/
大佐_005: {
Ich bezweifle auch nicht,
}
//	<<<ENGLISH>>>
//	I also have little doubt...

//<ページ数変更>
大佐_005_1: {
da&~s sie die NSA-Hackgeschichte
benutzten, um sie zur Zusammenarbeit
zu '&~uberreden'.
}
//	<<<ENGLISH>>>
//	that they also used the NSA hacking
//	affair as a means to 'convince' her
//	to cooperate.

/*例のハッキングの件も保険として、
脅迫材料に入っていたに違いない。*/
ライデン_006: {
Meinst Du, ihr Ha&~s war so gro&~s,
Snake und Otacon zu verraten?
}
//	<<<ENGLISH>>>
//	You think that her hate drove her
//	to frame Snake and Otacon?

/*オタコン達に濡れ衣をかぶせたのも、
そういう理由か？*/
大佐_007: {
Das -- wei&~s ich nicht.
}
//	<<<ENGLISH>>>
//	That -- I don't know.

/*それはわからん。*/
}
//d



resource P052_01_R01_ローズ無線１無線機デモ１＿１__g {
//vc115201
ローズ_000: {
Jack?
}
//	<<<ENGLISH(2)>>>
//	Jack?

/*ジャック、聞いて？*/
ライデン_001: {
Was gibt's?
}
//	<<<ENGLISH(2)>>>
//	What is it?

/*どうした？*/
ローズ_002: {
Ich bin immer so allein.
}
//	<<<ENGLISH>>>
//	I've always been alone...

/*私いつも独りだった……。*/
ライデン_003: {
Was?
}
//	<<<ENGLISH(2)>>>
//	Huh?

/*？*/
ローズ_004: {
Ich bin so einsam.
}
//	<<<ENGLISH(2)>>>
//	I'm so lonely...

/*私、寂しかった……。*/
ライデン_005: {
Einsam? Rose, wir sind doch immer --
}
//	<<<ENGLISH>>>
//	Lonely? Rose, we've always --

/*ローズ？
俺はいつも君と？*/
ローズ_006: {
Nicht immer.
}
//	<<<ENGLISH>>>
//	Not always.

/*違うわ……。*/
ライデン_007: {
Was meinst Du?
}
//	<<<ENGLISH(2)>>>
//	What do you mean?

/*違うって？*/
ローズ_008: {
Du hast nie neben mir geschlafen.
}
//	<<<ENGLISH>>>
//	You've never slept beside me...

/*あなたは私と眠った事はなかった……。*/
ライデン_009: {
Wovon sprichst Du? Ich --
}
//	<<<ENGLISH>>>
//	What are you talking about?
//	I --

/*何の話だ？*/
ローズ_010: {
Wenn wir in meinem Zimmer zusammen
waren. bist Du die ganze Nacht wach
oder gehst.
}
//	<<<ENGLISH>>>
//	After we've been together in my
//	room... you stay awake all night
//	or you head for the door.

/*私の部屋で愛し合った後……
あなたはいつも朝まで起きているか、
帰っていくかのどちらかだった。*/
ライデン_011: {
Ist jetzt wirklich der richtige Zeitpunkt
daf&~ur?
}
//	<<<ENGLISH>>>
//	Is this really the time
//	to bring this up?

/*こんな時に何を？*/
ローズ_012: {
Warum, Jack? Warum nur?
}
//	<<<ENGLISH>>>
//	Why, Jack? Why?

/*なぜなの？
ジャック？*/
ライデン_013: {
Rose. Ich befinde mich gerade mitten
in einem Einsatz, und ich.
}
//	<<<ENGLISH>>>
//	Listen, Rose. I'm right in the
//	middle of a mission, and I...

/*ローズ？
任務中だ……。*/
ローズ_014: {
Warum!? Warum kannst Du Dich bei mir
nicht entspannen?
}
//	<<<ENGLISH>>>
//	Why!? Why can't you relax
//	when you're with me!?

/*なぜなの？
私といると安らげないの？*/
ライデン_015: {
Schau mal, der Einsatz, Ich.
}
//	<<<ENGLISH>>>
//	Look... the mission... I...

/*任務中……。*/
ローズ_016: {
Warum &~offnest Du Dich mir nicht!?
}
//	<<<ENGLISH>>>
//	Why don't you open up to me!?

/*どうして心を開いてくれないの？*/
ライデン_017: {
Rose, Ich, ich kann es einfach nicht!
}
//	<<<ENGLISH(2)>>>
//	Rose... I... I just can't!

/*違う。*/
ローズ_018: {
Ich will doch nur gemeinsam mit Dir
tr&~aumen -- einen unverge&~slichen Abend
mit Dir verbringen.
}
//	<<<ENGLISH>>>
//	All I ever wanted was to share your
//	dreams -- to spend a meaningful
//	evening with you...

/*夢を共有したい、
あなたと夜を過ごしたい。*/
ローズ_019: {
Ich will doch nur neben Dir aufwachen.
Ist das zuviel verlangt?
}
//	<<<ENGLISH>>>
//	I just wanted to find you by
//	my side when I woke up. Is
//	that asking too much?

/*そして朝を向かえたい。
ダメなの？*/
ライデン_020: {
Es ist die Nacht -- ich habe nachts Angst.
es hat nichts mit Dir zu tun.
}
//	<<<ENGLISH>>>
//	It's the night -- I'm scared of
//	the night... it's got nothing to
//	do with you...

/*夜が……夜が怖いんだ。
君は関係ない。*/
ローズ_021: {
Angst vor der Nacht?
Was willst Du damit sagen?
}
//	<<<ENGLISH>>>
//	Scared of the night?
//	What's that supposed
//	to mean?

/*夜が怖いって……そんなの……。*/
ライデン_022: {
Ich kann mich nicht entspannen,
wenn ich mit jemandem zusammen bin.
}
//	<<<ENGLISH>>>
//	I can't relax when
//	I'm with someone...

/*人前では熟睡できないんだ。*/
ローズ_023: {
Jack? Du hast mich ja nicht einmal in
Dein Zimmer gelassen!
}
//	<<<ENGLISH>>>
//	Jack? You wouldn't even
//	let me in your room!

/*ジャック？
私があなたの部屋に入ることも嫌がった。*/
ライデン_024: {
Ich mu&~s auch mal allein sein,
ohne gest&~ort zu werden.
}
//	<<<ENGLISH(2)>>>
//	I need privacy...
//	I just can't be bothered.

/*自分の生活を、邪魔されたくないんだ。*/
ローズ_025: {
Gest&~ort!?
}
//	<<<ENGLISH>>>
//	Bothered!?

/*邪魔だなんて？*/
ライデン_026: {
Das war das falsche Wort! Ich will nur
sagen: Es gibt gewisse Dinge, die ich
f&~ur mich behalten mu&~s.
}
//	<<<ENGLISH>>>
//	Wrong word! What I wanted to say
//	was that there are certain things
//	that I have to keep to myself...

/*いや、覗かれたくない。*/
ローズ_027: {
Erinnerst Du Dich noch,
als ich ungefragt in Dein Zimmer kam?
}
//	<<<ENGLISH>>>
//	Do you remember that time
//	I forced my way into your room?

/*憶えてる？
無理矢理あなたの部屋に押し入ったの？*/
ローズ_028: {
Wir kannten uns schon fast ein Jahr,
Du bist ausgerastet!
}
//	<<<ENGLISH>>>
//	We'd known each other for almost
//	a year... and you blew up!

//<ページ数変更>
ローズ_028_1: {
Das war das erste Mal, da&~s Du die Hand
gegen mich erhoben hast!
}
//	<<<ENGLISH>>>
//	It was the first time you ever
//	raised your hand against me!

/*つきあい始めてもう１年も経っていた。あなたはもの凄く怒ったわ。
私に初めて手を挙げた。*/
ライデン_029:
''
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
ローズ_030: {
Ich hatte solche Angst um Dich.
}
//	<<<ENGLISH>>>
//	I was so worried about you...

/*あなたが心配だったの。*/
ライデン_031: {
Es tut mir leid.
}
//	<<<ENGLISH>>>
//	Look... I'm sorry...

/*わるかった……。*/
ローズ_032: {
Es war nicht die Brutalit&~at, die mir Angst
machte. Es war Dein Zimmer, Dein Herz.
}
//	<<<ENGLISH>>>
//	It wasn't your violent nature that
//	scared me. It was your room...
//	your heart...

/*いいえ、
私が怯えたのはあなたの暴力じゃない。
あなたの部屋……あなたの心の中……。*/
ライデン_033: {
H&~or auf damit.
}
//	<<<ENGLISH(2)>>>
//	Stop it...

/*やめてくれ……。*/
ローズ_034: {
Da war nichts in Deinem Zimmer -- nur ein
Bett und ein kleiner Schreibtisch. Wie eine
Gef&~angniszelle.
}
//	<<<ENGLISH>>>
//	There wasn't anything in your room
//	-- only a bed and a small desk. It
//	looked like a prison cell...

/*何もない部屋だった。
ベッドと小さな机が一つ。
まるで、刑務所の独房のようだった。*/
ライデン_035: {
Rose?
}
//	<<<ENGLISH>>>
//	Rose?

/*ローズ？*/
ローズ_036: {
Kein Fernseher, keine Familienfotos,
nicht einmal ein Poster.
}
//	<<<ENGLISH>>>
//	No television set...
//	no family pictures...
//	not even a poster...

/*家族の写真もポスターも、
テレビさえもなかった。*/
ライデン_037: {
Rose, ich benutze das Zimmer nur zum
Schlafen.
}
//	<<<ENGLISH>>>
//	Rose, I only use that
//	room for sleeping.

/*ただ寝るだけの部屋だ……。*/
ローズ_038: {
Ein Raum ohne Leben, fast wie Dein
leeres Herz.
}
//	<<<ENGLISH>>>
//	A lifeless room... almost
//	like your empty heart.

/*生活感のない部屋、
実体のないあなた……。*/
ライデン_039: {
Darum wollte ich auch nicht,
da&~s Du reinkommst.
}
//	<<<ENGLISH>>>
//	That's why I tried
//	to keep you out.

/*だから、君には来て欲しくなかったんだ。*/
ローズ_040: {
Ich dachte, allm&~ahlich verstehe ich Dich --
bis ich das Zimmer sah.
}
//	<<<ENGLISH>>>
//	I thought I was beginning to
//	understand you -- until I saw
//	that room.

/*あなたの部屋を見て……
あなたがわからなくなった。*/
ライデン_041: {
W&~arst Du zufriedener gewesen, wenn
ich h&~atte ein Bild von Dir an der Wand
h&~angen!?
}
//	<<<ENGLISH>>>
//	Would you've been happier if
//	I had a picture of you hanging
//	on the wall!?

/*君の写真が飾ってあればよかったのか？*/
ローズ_042: {
Das habe ich nicht gemeint --
}
//	<<<ENGLISH>>>
//	That's not what I was
//	trying to say --

/*いいえ、そんな意味じゃない。*/
ライデン_043: {
Genug, Rose. Wir reden sp&~ater dar&~uber,
nach dem Einsatz.
}
//	<<<ENGLISH>>>
//	Enough, Rose. We'll talk about
//	this later... after the mission.

/*ローズ、後で話し合おう……。
この任務が終わったら。*/
ローズ_044: {
Nach dem Einsatz, Ich verstehe.
}
//	<<<ENGLISH>>>
//	Right... after the mission...
//	I understand.

/*……ええ……そうね。
わかったわ。*/
}
//d



resource P053_01_R01_息継ぎ１無線機デモ１＿１__g {
//vc115301
オタコン_000: {
Raiden, h&~orst Du mich? Hier ist Otacon.
Wie sieht es bei Dir aus?
}
//	<<<ENGLISH>>>
//	Raiden, are you reading me?
//	This is Otacon. What's your
//	situation?

/*ライデン、聞こえる？
僕だよ。そっちの状況はどうだい？*/
ライデン_001: {
Na&~s und ungem&~utlich,
Alles hier ist &~uberschwemmt.
}
//	<<<ENGLISH(2)>>>
//	Wet and miserable...
//	this place is flooded.

//<ページ数変更>
ライデン_001_1: {
Das hochgepumpte Meerwasser str&~omt
ins Geb&~aude.
}
//	<<<ENGLISH>>>
//	The seawater that's been pumped
//	up is pouring into the building.

/*浸水がひどい。
汲み上げた海水が流れ込んで来ている。*/
オタコン_002: {
Verstehe. H&~or mal, ich mu&~s Dir
noch etwas &~uber E.E. sagen.
}
//	<<<ENGLISH>>>
//	I see. Listen, there's something
//	I have to tell you about E.E.

/*そうか、やっぱり……ＥＥの事だけど、
どうしても言っておきたい事がある。*/
ライデン_003: {
Keine Angst. Ich hol sie schon raus --
}
//	<<<ENGLISH>>>
//	Don't worry about her.
//	I'll get her out --

/*心配するな、彼女は助ける。*/
オタコン_004: {
Sie hat Angst vor Wasser.
}
//	<<<ENGLISH>>>
//	She's afraid of water.

/*彼女、水が苦手なんだ。*/
ライデン_005: {
Was!?
}
//	<<<ENGLISH(2)>>>
//	What!?

/*水が？*/
オタコン_006: {
Ja, Als sie sechs war, ertrank sie
daheim fast mit meinem Vater in
unserem Schwimmbecken.
}
//	<<<ENGLISH>>>
//	Yeah... when she was six years old,
//	she almost drowned with my father
//	in our swimming pool.

/*ああ……６歳の時に、家のプールで
溺れたんだ。僕の親父と一緒に。*/
ライデン_007: {
Sie kann nicht schwimmen!?
}
//	<<<ENGLISH>>>
//	She can't swim!?

/*泳げなかったのか？*/
オタコン_008: {
Ja und nein, Fr&~uher schwammen
wir viel zusammen.
}
//	<<<ENGLISH>>>
//	Well yes and no... we used to swim
//	a lot together when we were kids.

//<ページ数変更>
オタコン_008_1: {
Sie war wie ein Fisch im Wasser bis
zu jenem Tag, als sie fast ertrank.
}
//	<<<ENGLISH>>>
//	In fact, she swam like a fish until
//	that day when she almost drowned...

/*そうじゃない。泳ぎは得意だった。
よく二人で泳ぎに行った……。
あの事故が起こるまではね。*/
}
//d

//大佐の説明を聞いている人のみ
resource P053_01_R01_息継ぎ１無線機デモ１＿２__g {
//vc115302
ライデン_000: {
Das entspricht ja weitgehend dem,
was mir der Oberst erz&~ahlte.
}
//	<<<ENGLISH>>>
//	That pretty much coincides with
//	what the Colonel told me...

/*……やはり、大佐の話は本当だったのか。*/
}
/**///d
resource P053_01_R01_息継ぎ１無線機デモ１＿３__g {
//vc115303
オタコン_000: {
Als der Unfall passierte, war ich in meinem
Zimmer. Ich erfuhr erst sp&~ater, da&~s E.E.
mich um Hilfe rief.
}
//	<<<ENGLISH>>>
//	When the accident happened, I was
//	in my room. I learned later that E.E.
//	was calling me for help...

/*僕はあの時、自分の部屋にいた。
……ＥＥはずっと僕に助けを……
呼んでたらしい。*/
オタコン_001: {
Sie zweifelte nicht im geringsten,
da&~s ich kommen w&~urde.
}
//	<<<ENGLISH>>>
//	She didn't doubt for a
//	minute that I'd be there.

/*お兄ちゃんが助けてくれる、
お兄ちゃんなら……。*/
オタコン_002: {
Von meinem Zimmer aus konnte ich den
Pool sehen, doch ich realisierte nicht,
da&~s sie meine Hilfe ben&~otigte.
}
//	<<<ENGLISH>>>
//	You could see the pool from
//	my room... but I didn't realize at
//	the time that she needed my help.

/*僕の部屋からはプールがよく見えたんだ。
……でも僕は気づかなかった。*/
ライデン_003: {
Was hast Du gemacht?
}
//	<<<ENGLISH>>>
//	What were you doing?

/*何してたんだ？*/
オタコン_004: {
Ich, ich war.
}
//	<<<ENGLISH>>>
//	I... I was...

/*その時、僕は……。*/
ライデン_005: {
Emma &~uberlebte also.
}
//	<<<ENGLISH>>>
//	So Emma survived the ordeal.

/*エマは助かったんだろう？*/
オタコン_006: {
Ja, aber mein Vater nicht.
}
//	<<<ENGLISH>>>
//	Yeah. But my father didn't.

/*ああ、幸いね。
親父は助からなかったけど……。*/
ライデン_007: {
Du gabst Dir selbst die Schuld und verlie&~st
Deine Familie?
}
//	<<<ENGLISH>>>
//	So you blamed yourself
//	and left your family?

/*あんたはその事で、自分を責め……
家を出た？*/
オタコン_008: {
Nein. E.E. glaubt das wohl. Tatsache ist
aber, ich habe sie verraten.
}
//	<<<ENGLISH(2)>>>
//	No. E.E. seems to believe that
//	was the case. The fact is...
//	I betrayed her.

/*いや、そうじゃないが、
彼女はそう思っているかもしれない。
僕はＥＥを裏切ったんだ。*/
ライデン_009: {
Und Du glaubst, sie kann wegen dieses
traumatischen Erlebnisses nicht mehr
schwimmen?
}
//	<<<ENGLISH>>>
//	And you think that she can't
//	swim because of the traumatic
//	experience?

/*それがトラウマになって、泳げないと？*/
オタコン_010: {
Ich habe sie seitdem nicht mehr gesehen,
aber ja, das glaube ich.
}
//	<<<ENGLISH>>>
//	I haven't seen her since that
//	day... but yes, I think so.

/*ああ。
……あれから直接は会ってないけど……。*/
オタコン_011: {
Ich erhielt einen Brief von ihrer Mutter
Julie nachdem sie zur&~uck nach England
gezogen waren.
}
//	<<<ENGLISH>>>
//	I got a letter from Julie, her
//	mother, after they moved
//	back to England.

/*彼女たちがイギリスに帰って、
しばらくしてから手紙が来たんだ。
母親のジュリーから。*/
オタコン_012: {
Sie schrieb, da&~s E.E. nicht mehr
schwimmen konnte.
}
//	<<<ENGLISH>>>
//	In her letter, she mentioned that
//	E.E. couldn't swim anymore...

//<ページ数変更>
オタコン_012_1: {
nicht einmal mehr einen Badeanzug
tragen wollte.
}
//	<<<ENGLISH>>>
//	that she refused to even
//	wear a bathing suit.

/*あれ以来、ＥＥが泳ぐ事がなくなった、
水着を着ることもなくなったって。*/
ライデン_013: {
Mist! Wenn sie nicht schwimmen kann,
stecken wir in der Patsche, Etage B1 im
Kern ist weitgehend &~uberflutet.
}
//	<<<ENGLISH>>>
//	Damn! If she still can't swim,
//	we're in trouble... level B1 in
//	the core is pretty much flooded.

/*そのトラウマが生きているとすると、
まずいな。中央棟のＢ１はほとんど
浸水している。*/
オタコン_014: {
K&~onnest Du ihr bitte helfen.
}
//	<<<ENGLISH>>>
//	Look... maybe you can help
//	her overcome the trauma.

/*なんとか彼女を勇気づけてやってくれ。*/
ライデン_015: {
Ich soll ihr dar&~uber hinweghelfen?
}
//	<<<ENGLISH>>>
//	You want me to help
//	her get over it?

/*こっちが勇気づけて欲しい
状況なんだが……。*/
オタコン_016: {
Es wird noch etwas dauern,
bis die Kamov repariert ist.
}
//	<<<ENGLISH>>>
//	It's still going to take some
//	time to repair the Kamov.

/*カモフの修理にまだ時間がかかる。*/
プリスキン_017: {
Tut mir leid, Junge.
Du mu&~st Emma alleine retten.
}
//	<<<ENGLISH>>>
//	Sorry, kid. Emma's
//	rescue is up to you.

/*悪いが手が離せない。エマの事は頼む。*/
ライデン_018: {
Vielen Dank. Ein Unterwasser-Einsatz, Na,
jeder mu&~s ja mal anfangen. Also -- ich
gebe mein Bestes.
}
//	<<<ENGLISH>>>
//	Thanks. An underwater mission...
//	well, this is a first. Look -- I'll
//	see what I can do.

/*水中でのミッションは初めてなんだが。なんとかやってみる。*/
プリスキン_019: {
Pr&~ag Dir den Geb&~audeplan besser gut ein.
}
//	<<<ENGLISH>>>
//	I suggest that you drum
//	the map of the building
//	into your head,

//<ページ数変更>
プリスキン_019_1: {
Denn wenn Du mit Emma unterwegs
bist, wirst Du kaum Zeit haben,
daraufzuschauen.
}
//	<<<ENGLISH>>>
//	'cause you won't have time
//	to look at it when you try to
//	bring Emma out.

/*今のうちにマップを頭にたたき込んで
おくことだ。エマを連れて進む事になる。*/
オタコン_020: {
Ich z&~ahl auf Dich, Raiden.
}
//	<<<ENGLISH>>>
//	I'm counting on you, Raiden.

/*頼むよ。*/
プリスキン_021: {
Ich habe fast den gesamten Kern gesehen,
als ich die C4s vernichtet habe,
}
//	<<<ENGLISH>>>
//	I covered most of the core when
//	I had to take out the C4's...

//<ページ数変更>
プリスキン_021_1: {
wenn Du Fragen hast,
ruf mich &~uber das Codec.
}
//	<<<ENGLISH>>>
//	if there's anything you need to
//	ask me, call me on the Codec.

/*中央棟は俺の方が詳しい。Ｃ４解除で
一通り、回ったからな。何か聞きたい
ことがあれば無線連絡をくれ。*/
ライデン_022: {
Das werde ich.
}
//	<<<ENGLISH>>>
//	I'll do that.

/*わかった。*/
}
//d



resource P057_02_R01_ヴァンプ戦終了２無線機デモ１＿１__g {
//vc115701
ライデン_000: {
Oberst! Es scheint, als h&~atten sie
die letzten Checks f&~ur Arsenal Gear
abgeschlossen!
}
//	<<<ENGLISH>>>
//	Colonel! They've apparently
//	completed the final check
//	procedure for Arsenal Gear!

/*大佐、アーセナルギアの最終チェックが
終わったらしい！*/
大佐_001: {
Such Emma, beeil Dich!
}
//	<<<ENGLISH>>>
//	Find Emma on the double!

//<ページ数変更>
大佐_001_1: {
Sie mu&~s das Virenprogramm installieren,
das der Pr&~asident Dir gegeben hat!
}
//	<<<ENGLISH>>>
//	You've got to get her to
//	install the virus program
//	that the President gave you!

/*早くエマを助け出せ。
彼女に大統領からもらったウィルスを
入力させるんだ。
*/
大佐_002: {
Wenn Du sie gefunden hast, bring sie
zum Computerraum in Etage B2 im
Kern von Shell 1!
}
//	<<<ENGLISH>>>
//	When you find her, take her to
//	the Computer Room on level B2
//	in the core of Shell 1!

/*彼女を救出してシェル１中央棟Ｂ２の
電算室へ連れて行け。*/
}
//d




//スネークに無線機ＳＥＮＤ（周波数変更）
resource P057_02_R01_ヴァンプ戦終了２無線機デモ１＿２__g {
//vc115702
ライデン_000: {
Snake! Hast Du mitgeh&~ort!? Ich war nicht
schnell genug, Arsenal ist aktiviert!
}
//	<<<ENGLISH>>>
//	Snake! Did you catch all that!?
//	I didn't make it on time...
//	Arsenal's going active!

/*スネーク、聞こえたか？
間に合わなかった。
アーセナルが動き出す！*/
プリスキン_001: {
Ja, hab ich. Die Befreiung der Geiseln
wird warten m&~ussen.
}
//	<<<ENGLISH>>>
//	Yeah, I heard. The
//	hostage rescue's
//	gonna have to wait.

/*ああ、聞こえた。
人質の救出は後回しだ。*/
ライデン_002: {
Ich suche Emma.
}
//	<<<ENGLISH>>>
//	I'm going after Emma.

/*俺はエマを助け出す。*/
プリスキン_003: {
Wir werden den Computerraum sichern.
}
//	<<<ENGLISH>>>
//	We'll secure the Computer Room.

/*わかった。
俺達は電算室を確保する。*/
}
//d

//無線機の小画面に大統領がＭＯを渡す映像が映る
resource P057_02_R01_ヴァンプ戦終了２無線機デモ１＿３__g {
//vc115703
プリスキン_000: {
Sieht so aus, als br&~auchten wir Emma,
um das Virenprogramm zu installieren.
}
//	<<<ENGLISH>>>
//	Looks like we can't install the
//	virus program without Emma.

/*やはりエマでなければウィルスを
侵入させることは出来ないらしい。*/
ライデン_001: {
Kann Dein Partner das nicht?
}
//	<<<ENGLISH>>>
//	Can't your partner do it?

/*あんたの相棒でも駄目なのか？*/
オタコン_002: {
ich w&~urde ja gerne. Aber Sicherheitssystem
ist kein Kinderspiel. Ich brauch mehr Zeit.
}
//	<<<ENGLISH>>>
//	I would if I could. But the security
//	for this system is no joke. I need
//	more time...

/*出来ればやってる。
ここのセキュリティはよく出来てるよ。
短時間じゃちょっと手が出せない……。*/
プリスキン_003: {
Darum brauchen wir sie.
}
//	<<<ENGLISH>>>
//	That's why we need her.

/*そういうことだ。
エマを連れてきてくれ。*/
ライデン_004: {
Verstanden. Ich werde f&~ur
das Familientreffen sorgen.
}
//	<<<ENGLISH>>>
//	Understood. I'll make
//	sure you have your
//	family reunion...

/*わかった。安心してくれ。
ちゃんと兄妹を対面させてみせるさ。*/
オタコン_005:
''
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
ライデン_006: {
Was ist?
}
//	<<<ENGLISH(2)>>>
//	What's up?

/*どうした？*/
オタコン_007: {
Es sind viele Jahre vergangen
f&~ur E.E. und mich.
}
//	<<<ENGLISH>>>
//	A lot of years have passed
//	between E.E. and me...

/*……ＥＥとは長い間、会ってないんだ。*/
ライデン_008: {
Dann solltest Du sie doch sehen, oder?
}
//	<<<ENGLISH>>>
//	Then you should see her, right?

/*だからすぐ会えるじゃないか。*/
オタコン_009: {
Ich habe kein Recht, sie zu sehen.
}
//	<<<ENGLISH>>>
//	I don't have the right to see her.

/*いや、僕には彼女に逢う資格はないんだ。*/
プリスキン_010: {
Wir sprechen sp&~ater dar&~uber. Raiden,
ich glaube, Du solltest Dich beeilen
}
//	<<<ENGLISH>>>
//	We can talk about this later.
//	Raiden, I think you'd better
//	get moving,

/*事情があるようだが、時間がない。
エマはその部屋の北にある
ロッカールームだろう？*/
プリスキン_011: {
Emma ist im n&~ordlichen Umkleideraum,
stimmt's?
}
//	<<<ENGLISH>>>
//	Emma's in the Locker Room
//	to the north, right?

/*ライデン、頼むぞ。*/
ライデン_012: {
Ich bin schon da.
}
//	<<<ENGLISH(2)>>>
//	I'm on it.

/*わかった。*/
}
//d


resource P058_02_R01_エマ救出２無線機デモ１＿１__g {
//vc115801
ライデン_000: {
H&~orst Du mich jetzt?
}
//	<<<ENGLISH>>>
//	Can you hear me, now?

/*聞こえるか？*/
エマ_001: {
Nanokommunikation?
}
//	<<<ENGLISH>>>
//	Nanocommunication...?


/*体内通信？*/
ライデン_002: {
Richtig.
Ich habe auch Nanosysteme.
}
//	<<<ENGLISH>>>
//	That's right.
//	I have nanomachines, too.

/*そうだ、俺の体内にもナノマシンが
注入されている。*/
エマ_003: {
Dann bist Du keiner von denen.
}
//	<<<ENGLISH>>>
//	Then you're not one of them...

/*あいつらとは違う……？*/
ライデン_004: {
Das sage ich doch die ganze Zeit.
}
//	<<<ENGLISH>>>
//	That's what I've been
//	trying to tell you.

/*そういう事だ。*/
エマ_005: {
Und Du willst mich retten?
}
//	<<<ENGLISH>>>
//	And you came to rescue me?

/*で、私を助けるのが任務？*/
ライデン_006: {
Um ehrlich zu sein, brauche ich Deine
Hilfe, Arsenal aufzuhalten.
}
//	<<<ENGLISH>>>
//	Actually, I need your help
//	to stop Arsenal...

//<ページ数変更>
ライデン_006_1: {
Du sollst die einzige sein,
die das kann.
}
//	<<<ENGLISH>>>
//	I understand you're the only one
//	who might be able to do it.

/*俺はアーセナルを止めに来たんだ。
協力してほしい。あれを止められるのは
君しかいないと聞いた。*/
エマ_007: {
Wer hat das gesagt?
}
//	<<<ENGLISH>>>
//	And who told you that?

/*……誰からそんなことを？*/
ライデン_008: {
Der Pr&~asident.
}
//	<<<ENGLISH(2)>>>
//	The President.

/*大統領。*/
エマ_009: {
Wirklich?
}
//	<<<ENGLISH>>>
//	...Really?


/*……ホントに？*/
ライデン_010: {
Du mu&~st mit mir zu Shell 1 kommen.
Dein Bruder erwartet Dich dort.
}
//	<<<ENGLISH>>>
//	I need you to come with me to
//	Shell 1. Your brother's waiting
//	for you there.

/*一緒にシェル１に来てくれ。
君のお兄さんが待ってる。*/
エマ_011: {
Mein Bruder?
}
//	<<<ENGLISH>>>
//	My brother?

/*お兄ちゃん？*/
ライデン_012: {
Los! Wir m&~ussen uns beeilen!
}
//	<<<ENGLISH>>>
//	C'mon!
//	We have to get moving!

/*とにかく、ここを出よう！*/
ライデン_013: {
Hier ist bald alles &~uberschwemmt!
}
//	<<<ENGLISH>>>
//	This place'll be flooded soon!

/*いつ浸水するかわからない。*/
}
//d



resource P058_04_R02_エマ救出４無線機デモ２＿１__g {
//vc115811
エマ_000: {
La&~s mich.
}
//	<<<ENGLISH>>>
//	Leave me...

/*だから、ここに……。*/
ライデン_001: {
Du kannst schwimmen.
Du hast es fr&~uher gerne getan!
}
//	<<<ENGLISH>>>
//	You can swim!
//	You used to love it!

/*泳げないんじゃない！
エマ、君は泳げたんだ！*/
エマ_002: {
Woher wei&~st Du?
}
//	<<<ENGLISH(2)>>>
//	How did you know...?

/*どうして、そのことを？*/
ライデン_003: {
Dein Bruder hat es mir gesagt.
}
//	<<<ENGLISH>>>
//	Your brother told me.

/*君のお兄さんに聞いた。*/
エマ_004: {
Ist er wirklich hier?
}
//	<<<ENGLISH>>>
//	He's really here?

/*本当に、ここに？*/
ライデン_005: {
Ja. Er ist hier, um Dich zu befreien.
}
//	<<<ENGLISH(2)>>>
//	That's right... he's
//	here to rescue you.

/*ああ。君を助ける為に。*/
エマ_006: {
Das glaube ich nicht!
Wegen mir w&~urde er nie kommen!
}
//	<<<ENGLISH>>>
//	I don't believe you!
//	He would never come for me!

/*ウソよ。
あの男がそんな事をするはずない！*/
ライデン_007: {
Wenn ich es doch sage -- er ist hier,
er erwartet uns an Shell 1!
}
//	<<<ENGLISH>>>
//	And I'm telling you he's
//	here -- waiting for us
//	at Shell 1!

/*ウソじゃない。
シェル１で君が来るのを待っている。*/
エマ_008: {
Nein! Er hat mich verlassen, meine Mutter
-- als wir ihn am meisten brauchten!
}
//	<<<ENGLISH>>>
//	No! He left me... my mother --
//	when we needed him the most!

/*信じられない！
あの男は私を捨てたの。
私達親子をね。*/
エマ_009: {
Als mein Vater starb,
dachte er nur an sich selbst!
}
//	<<<ENGLISH>>>
//	When my father died, all he
//	could think about was himself!

/*父が死んだ、一番辛い時に。
あいつは自分だけ……。*/
ライデン_010: {
Emma, wir k&~onnen sp&~ater dar&~uber
sprechen. Aber zuerst m&~ussen wir hier
raus!
}
//	<<<ENGLISH>>>
//	Emma, we can go over all that
//	later. But first, we have to get
//	out of here!

/*エマ、恨み言は後でいくらでも聞く。
ここから離れよう！*/
エマ_011: {
Nein! Ich hasse Wasser!
}
//	<<<ENGLISH>>>
//	No! I hate water!

/*嫌っ！
水は嫌い！*/
エマ_012: {
Es nutzt nichts!
Ich kann nicht schwimmen!
}
//	<<<ENGLISH>>>
//	It's hopeless!
//	I can't swim!

/*無理よ！泳げないっ！*/
}
//d



resource P058_07_R03_エマ救出７無線機デモ３＿１__g {
//Vc115821
ライデン_000: {
Leg' Dein Ohr an meine Brust und
lausche meinem Herzschlag.
}
//	<<<ENGLISH>>>
//	Put your ear against my chest
//	and listen to my heartbeat.

/*俺の心臓のに耳を当てておくんだ。*/
エマ_001: {
Deinem Herzschlag?
}
//	<<<ENGLISH>>>
//	Your heartbeat?

/*心臓？*/
ライデン_002: {
Z&~ahl' die Schl&~age -- denk an nichts
anderes. Wenn Du bis 100 gez&~ahlt hast,
&~offne die Augen.
}
//	<<<ENGLISH>>>
//	Count the beats -- don't think about
//	anything else. When you reach 100,
//	open your eyes.

//<ページ数変更>
ライデン_002_1: {
Dann sind wir auf der anderen Seite.
}
//	<<<ENGLISH>>>
//	By that time, we'll be
//	on the other side.

/*鼓動の数を数える、ひとつ、ふたつ……
他の事は考えるな。１００まで数えたら、
目を開けろ。向こう側についてる。*/
ライデン_003: {
Gib mir ein Zeichen,
wenn Du keine Luft mehr hast.
}
//	<<<ENGLISH>>>
//	Give me a signal if you think
//	you're running out of breath.

/*苦しくなったら、合図をくれ。*/
エマ_004: {
Was machst Du dann?
}
//	<<<ENGLISH>>>
//	What will you do then?

/*そしたら？*/
ライデン_005: {
Schneller schwimmen.
}
//	<<<ENGLISH>>>
//	I'll swim faster.

/*できる限り、急いでむこうまで行く。*/
}
//d



resource P059_03_R01_エマ休憩３無線機デモ１＿１__g {
//vc115901
大佐_000: {
Raiden, wie sieht es bei Dir aus?
}
//	<<<ENGLISH>>>
//	Raiden, what's your status?

/*ライデン、どうだ？*/
ライデン_001: {
Oberst? Ich habe Emma Emmerich hier,
wir sind nicht ertrunken.
}
//	<<<ENGLISH>>>
//	Colonel? I've got Emma Emmerich
//	here... we've managed to avoid
//	drowning.

/*大佐、エマ・エメリッヒを救出……
なんとか溺死するのだけは免れた。*/
大佐_002: {
Gut gemacht. Bring sie so schnell Du
kannst zu Shell 1.
}
//	<<<ENGLISH>>>
//	Good job. Get her over to
//	Shell 1 as soon as you can.

/*よし、
彼女をシェル１まで連れて行くんだ。*/
ライデン_003: {
Das wird nicht einfach.
Die Verbindungsbr&~ucke zur
oberen Ebene ist zerst&~ort.
}
//	<<<ENGLISH>>>
//	That's going to be hard with the
//	connecting bridge on the upper
//	level destroyed.

/*シェル１への上部連絡橋は
破壊されている。*/
大佐_004: {
Sagte Olga nicht etwas vom &~Olzaun
ganz unten in Strebe L?
}
//	<<<ENGLISH>>>
//	Didn't Olga say something about
//	taking the oil fence at the bottom
//	of Strut L?

/*確かオルガが言っていたな。
Ｌ脚下部のオイルフェンスを通って、
と……。*/
ライデン_005: {
Ja, jetzt erinnere ich mich.
}
//	<<<ENGLISH>>>
//	Yeah, I remember that.

/*ああ、覚えている。*/
大佐_006: {
Es m&~u&~ste eigentlich m&~oglich sein,
&~uber Strebe L runterzukommen.
Versuche es.
}
//	<<<ENGLISH>>>
//	You should be able to go down
//	by way of Strut L. Try and get
//	over there.

/*Ｌ脚から下へ降りられるはずだ。
Ｌ脚に向かえ。*/
ライデン_007: {
Was ist mit Emma? Sie haben ihr
eine Spritze gegeben, und jetzt kann
sie nicht alleine laufen.
}
//	<<<ENGLISH>>>
//	What about Emma?
//	She's been injected with something
//	and she can't walk without any help.

/*エマはどうする？薬物の影響らしいが、
一人で歩くのは無理のようだ。*/
大佐_008: {
Nimm sie mit, Leg alle Ausr&~ustung
aus der Hand und halt die Aktionstaste
gedr&~uckt. So kannst Du ihr helfen.
}
//	<<<ENGLISH>>>
//	Take her with you... free your hands
//	of any equipment and hold down the
//	Action button to give her a hand.

/*彼女を引っ張っていくしかない。
素手の状態で＃｛△、アクション｝＃ボタンを押している間、
手をつなぐ。*/
}
//d

//……子画面にエマを連れて進む映像（ＶＲ）……
resource P059_03_R01_エマ休憩３無線機デモ１＿２__g {
//vc115902
大佐_000: {
Wenn Du Emma loslassen m&~ochtest,
nimm den Finger von der Aktionstaste.
}
//	<<<ENGLISH>>>
//	To release your grip on her, take
//	your finger off the Action button.

//<ページ数変更>
大佐_000_1: {
Emma kann sich hinsetzen und warten,
bis Du ihr wieder auf die F&~u&~se hilfst.
}
//	<<<ENGLISH>>>
//	Emma can sit and wait until
//	you help her back up.

/*手を離したい時は＃｛△、アクション｝＃ボタンを離すんだ。
手を離すとエマはその場に座り込む。
彼女の手を引っ張ってＬ脚まで行くんだ。*/
大佐_001: {
Und pa&~s auf, Solange Du sie f&~uhrst,
kannst Du keine Waffen benutzen.
}
//	<<<ENGLISH>>>
//	And be careful... you won't be able
//	to use any weapons while you're
//	leading her.

大佐_002: {
Los, zu Strebe L!
}
//	<<<ENGLISH>>>
//	Now, head for Strut L!

//<ページ数変更> 包含
/*だがいいか、彼女の手を引いている間、
武器は使えないぞ。*/
ライデン_004: {
Wir sind schon unterwegs.
}
//	<<<ENGLISH>>>
//	We're on our way.

/*わかった。*/
}
//d




resource P061_01_R01_エマとオタコン１無線機デモ１＿１__g {
//Vc116101.aif
プリスキン_000: {
Raiden, wir sind im Computerraum.
Wie sieht es bei Dir aus?
}
//	<<<ENGLISH>>>
//	Raiden, we've infiltrated the
//	Computer Room. What's your
//	situation?

/*ライデン、電算室に侵入した。
どうだ？*/
ライデン_001: {
Emma ist in Sicherheit.
Wir kommen zu Euch.
}
//	<<<ENGLISH>>>
//	Emma's safe.
//	We're heading your way.

/*エマは無事だ。
これからそっちへ向かう。*/
オタコン_002: {
Gut gemacht!
}
//	<<<ENGLISH>>>
//	Good job!

/*よかった……。*/
プリスキン_003: {
Shell 1 ist verlassen. Scheint,
als w&~aren alle an Bord von Arsenal.
}
//	<<<ENGLISH>>>
//	Shell 1's deserted. Looks like
//	everybody's aboard Arsenal.

/*シェル１には誰もいない。
皆アーセナルに乗り込んだようだ。*/
オタコン_004: {
Ich habe mir das System angesehen,
aber ich kann da nichts machen. E.E.
ist unsere einzige Hoffnung.
}
//	<<<ENGLISH>>>
//	I had a look at the system, but
//	there's nothing I can do. E.E.'s
//	our only hope...

/*いろいろやってみたけどやっぱり
僕じゃ手が出せない。ＥＥでなきゃ……。*/
ライデン_005: {
Okay, Ich gebe an sie weiter.
}
//	<<<ENGLISH>>>
//	Right... I'll put her on then.

/*それじゃ、エマに変わる。*/
オタコン_006: {
Huh? E.E.? Wie?
}
//	<<<ENGLISH(2)>>>
//	Huh? E.E.? How...?

/*えっ、ＥＥに……。*/
ライデン_007: {
Ich benutze mein Codec als Relais.
}
//	<<<ENGLISH>>>
//	I'll use my Codec as a relay.

/*俺の体内通信を中継する。*/
オタコン_008: {
&~Ahm, ummm,
}
//	<<<ENGLISH>>>
//	Ahem, ummm...

/*あ、あ……。*/
ライデン_009: {
Hier ist sie.
}
//	<<<ENGLISH>>>
//	Here she is...

/*代わるぞ？*/
エマ_010: {
&~Ah, Hal?
}
//	<<<ENGLISH>>>
//	Uh... Hal...?

/*……お兄ちゃん？*/
//無線機画面、ライデンの変わりにオタコンが表示される。オタコンを動かすことはできるが、相づちはうてないようにする。
}
//d

resource P061_01_R01_エマとオタコン１無線機デモ１＿２__g {
//vcxxxxxxxxx
オタコン_000: {
&~Ah, E.E.? Bist Du das?
}
//	<<<ENGLISH>>>
//	Ah, E.E.? Is that you?

/*ＥＥかい？*/
エマ_001: {
Hal.
}
//	<<<ENGLISH>>>
//	Hal.

/*お兄ちゃん……。*/
オタコン_002: {
E.E.
}
//	<<<ENGLISH>>>
//	E.E.

/*ＥＥ……。*/
オタコン_003: {
Uh, was hast Du mit Metal Gear
zu tun?
}
//	<<<ENGLISH>>>
//	Uh, why're you involved
//	with Metal Gear?

/*ＥＥ、なぜメタルギアなんかに手を？*/
エマ_004: {
Was???
}
//	<<<ENGLISH>>>
//	Huh???

/*えっ？？*/
オタコン_005: {
Du kanntest die d&~ustere Vergangenheit
unserer Familie. Warum hast Du Dich da
reinziehen lassen?
}
//	<<<ENGLISH>>>
//	You knew our family's dark history,
//	and still got involved!? What's
//	wrong with you!?

/*僕たちの呪われた家系を知っているだろ？
どうしてなんだ？*/
エマ_006: {
Ich h&~atte es besser wissen sollen.
}
//	<<<ENGLISH>>>
//	I should've known.

/*……やっぱり。*/
オタコン_007: {
Antworte! Warum machst Du den gleichen
Fehler nochmal?
}
//	<<<ENGLISH>>>
//	Answer me! Why are you
//	repeating the same mistake?

/*どうしてだ？
どうして同じ過ちを繰り返す？*/
エマ_008:
''
//	<<<ENGLISH>>>
//

/*……。*/
エマ_009: {
Ich wollte Dich verletzen.
Dich leiden sehen.
}
//	<<<ENGLISH>>>
//	I wanted to hurt you.
//	I wanted to see you suffer.

/*あなたに会って、
あなたを苦しめたかったから……。*/
オタコン_010: {
E.E.?
}
//	<<<ENGLISH>>>
//	E.E.?

/*ＥＥ？*/
エマ_011: {
Du hast mich im Stich gelassen --
}
//	<<<ENGLISH>>>
//	You abandoned me --

/*あなたは私を捨てた……。*/
オタコン_012: {
Nein!
Das stimmt nicht.
}
//	<<<ENGLISH>>>
//	No!
//	That's not what happened...

/*違う。そうじゃない。*/
プリスキン_013: {
So -- das gen&~ugt!
}
//	<<<ENGLISH>>>
//	Alright -- that's enough!

/*二人とも、やめるんだ。*/
オタコン_014:
''
//	<<<ENGLISH>>>
//	...

/*……。*/
エマ_015: {
Wer bist Du?
}
//	<<<ENGLISH(2)>>>
//	Who are you?

/*誰？*/
プリスキン_016: {
Ein Freund von Otacon, Emma.
}
//	<<<ENGLISH>>>
//	I'm a friend of Otacon's, Emma.

/*エマ、俺はオタコンの友人だ。*/
エマ_017: {
Otacon.
}
//	<<<ENGLISH(2)>>>
//	Otacon...

/*オタコン……。*/
プリスキン_018: {
Genug mit diesen Geschwisterquerelen.
}
//	<<<ENGLISH>>>
//	Enough with the sibling rivalry.

/*兄妹喧嘩なら、後でしろ。*/
エマ_019: {
Das hier ist etwas anderes!!
}
//	<<<ENGLISH>>>
//	That's not what this is!!

/*兄妹喧嘩じゃないわ！*/
プリスキン_020: {
Daf&~ur haben wir jetzt keine Zeit!
Raiden! Kommt jetzt hierher!
}
//	<<<ENGLISH>>>
//	We haven't got time for this!
//	Raiden! Get her over here,
//	right now.

/*一刻を争うんだ！
ライデンとこっちに来てくれ。*/
エマ_021: {
Ich -- Ich.
}
//	<<<ENGLISH>>>
//	I -- I...

/*う、うん。*/
ライデン_022: {
Verstanden, Snake.
Ich komme mit Emma r&~uber.
}
//	<<<ENGLISH>>>
//	Gotcha, Snake. I'll head
//	over there with Emma.

/*わかった、スネーク。
エマを連れて行く。
*/
プリスキン_023: {
Die meisten Gegner sind auf Arsenal.
Seid aber trotzdem vorsichtig.
}
//	<<<ENGLISH>>>
//	Most of the enemy's aboard
//	Arsenal. But I suggest you
//	be careful.

//<ページ数変更>
プリスキン_023_1: {
Achte darauf, da&~s Emma heil hier
ankommt.
}
//	<<<ENGLISH>>>
//	Make sure Emma gets
//	here in one piece.

/*奴ら、ほとんどアーセナルに乗り込んで
いると思うが気をつけろ。
エマに怪我をさせるな。*/
オタコン_024: {
Raiden, Pa&~s auf meine Schwester auf.
}
//	<<<ENGLISH>>>
//	Raiden... take care of my sister.

/*ライデン……頼む……。*/
ライデン_025: {
Keine Angst,
ich bring sie unversehrt.
}
//	<<<ENGLISH>>>
//	Don't worry.
//	I'll get her there.

/*わかった。まかせてくれ。*/
}
//d



resource P062_03_R01_エマとＡＩ３無線機デモ１＿１__g {
//vc116201
ライデン_000: {
H&~orst Du mich, Emma?
}
//	<<<ENGLISH>>>
//	Are you reading me, Emma?

/*エマ、いいかい？*/
エマ_001: {
Ja -- laut und deutlich.
}
//	<<<ENGLISH>>>
//	Yes -- loud and clear.

/*ええ、大丈夫……。*/
ライデン_002: {
Der Pr&~asident sagte, Arsenal Gear sei
der Schl&~ussel, f&~ur die Vorherrschaft
der Patriots.
}
//	<<<ENGLISH>>>
//	The President said that Arsenal
//	Gear was the Patriots' key to
//	supremacy.

/*大統領は『Ｇ．Ｗ』とアーセナルギアが
『愛国者達』の切り札だと言った。*/
エマ_003: {
Gar keine schlechte Beschreibung.
}
//	<<<ENGLISH>>>
//	That's as good a description as any.

/*そうね。
そういえるかも。*/
ライデン_004: {
Was genau ist es?
}
//	<<<ENGLISH>>>
//	What exactly is it?

/*一体、どういうものなんだ？*/
エマ_005: {
Es ist ein riesiges
Datenverarbeitungssystem, das globale
Informationen steuern kann.
}
//	<<<ENGLISH>>>
//	It's a massive data processing
//	system capable of controlling
//	information on a global scale.

/*世界規模の情報統制を行なうための
超大規模情報処理システム。*/
ライデン_006: {
Ein Datenverarbeitungssystem?
}
//	<<<ENGLISH>>>
//	A data processing system...?

/*情報処理システム？*/
エマ_007: {
Ja. Das System ist ein soziales Ger&~at,
das den Patriots helfen soll, um die
Kontrolle zu behalten.
}
//	<<<ENGLISH>>>
//	That's right. The system's a
//	social device for maintaining
//	the Patriots' control.

/*ええ。『愛国者達』が支配を
継続していくための社会装置……。*/
ライデン_008: {
Ich verstehe das nicht.
}
//	<<<ENGLISH>>>
//	You've lost me.

/*なんだそれは？*/
エマ_009: {
Heutzutage str&~omen Informationen
aus allen Richtungen zusammen
und werden frei verteilt.
}
//	<<<ENGLISH>>>
//	In this day and age, information
//	emerges from every direction,
//	and is freely distributed...

/*現代ではあらゆるところから情報が
生まれて、流通する……。*/
エマ_010: {
Die verschiedensten Informationen werden
von Servern gesammelt und blitzschnell an
Einzelpersonen weitergeleitet.
}
//	<<<ENGLISH>>>
//	A variety of information - gathered
//	by servers employing the latest in
//	high-speed communication networks

//<ページ数変更>
エマ_010_1: {
Die neusten Hochgeschwindigkeits-
Kommunikationsnetzwerke
}
//	<<<ENGLISH>>>
//	and P2P technology - is rapidly
//	circulated to individuals.

/*高速通信網の整備とＰ２Ｐ技術の発達で
サーバに集約されていた情報が個人に
分散されるようになって、*/
エマ_011: {
und P2P-Technologie werden eingesetzt
und die Geschwindigkeit nimmt fast
t&~aglich zu.
}
//	<<<ENGLISH>>>
//	In fact, the speed of this circulation
//	process is accelerating on an almost
//	daily basis.

/*その流れはますます加速してるの。*/
エマ_012: {
Die Patriots scheinen diese Entwicklung
zu f&~urchten,
}
//	<<<ENGLISH>>>
//	The Patriots seem to be
//	afraid of this development.

/*彼等はそれに強い危機感を
持ってるみたい。*/
エマ_013: {
bald nicht mehr die Herrscher sondern
die Beherrschten zu sein.
}
//	<<<ENGLISH>>>
//	Apparently, they believe that their
//	role will shift from dominant to
//	dominated.

/*近いうちに支配する側が支配される側に
取り込まれてしまうんじゃないかって、
ね。*/
ライデン_014: {
?
}
//	<<<ENGLISH(2)>>>
//	?

/*？*/
エマ_015: {
Ich gebe Dir ein Beispiel. Du hast doch
schon von Solid Snakes Aktivit&~aten
gegen Metal Gear geh&~ort, oder?
}
//	<<<ENGLISH>>>
//	Let me give you an example. You're
//	aware of Solid Snake's anti-Metal
//	Gear activities, aren't you?

/*例えばあなたはソリッド・スネークの
反メタルギア活動を知っているでしょう？*/
ライデン_016: {
Ja -- etwas.
}
//	<<<ENGLISH>>>
//	Yeah -- I know a little about it.

/*ああ……少しは。*/
エマ_017: {
Das ist nur ein kleines Beispiel f&~ur
unkontrollierte Information.
}
//	<<<ENGLISH>>>
//	That's just a small sample of
//	uncontrolled information.

//<ページ数変更>
エマ_017_1: {
Ich kann Dir garantieren, da&~s die Patriots
nicht wollten, da&~s Solid Snakes Name
bekannt wird.
}
//	<<<ENGLISH>>>
//	I can guarantee you the Patriots
//	did not want Solid Snake's name
//	publicized.

/*それが一番の証拠。ソリッド・スネーク
の名は『愛国者達』にとって最も
口外されてはいけないものなの。
*/
エマ_018: {
Sieh es mal so. politische Skandale,
korrupte Unternehmen.
}
//	<<<ENGLISH>>>
//	Now, look at it like this...
//	political scandal, corporate
//	corruption...

/*それは一例に過ぎない。政治家の醜聞、
企業の不正……*/
エマ_019: {
bislang konnten die Patriots all dies
und andere, ihnen n&~utzliche Ereignisse,
geheimhalten.
}
//	<<<ENGLISH>>>
//	up until now, the Patriots have
//	managed to keep a lid on these
//	and other self-serving events.

/*今までなら『愛国者達』の力で隠されていた事実が簡単に暴かれてしまう。*/
エマ_020: {
Aber mit ihrem derzeitigen
Datenverarbeitungssystem k&~onnen
sie den von Einzelpersonen
}
//	<<<ENGLISH>>>
//	But with their existing data
//	processing system, they are
//	no longer able to effectively＃−

//<ページ数変更>
エマ_020_1: {
erzeugten Informationsflu&~s nicht mehr
wirksam kontrollieren.
}
//	<<<ENGLISH>>>
//	control the flow of information
//	generated at the individual level.

/*現行のシステムでは個人から発信される
情報を抑えきることは出来ないの。
*/
エマ_021: {
Mit dem neuen System k&~onnen sie alle
digitalen Informationen steuern.
}
//	<<<ENGLISH>>>
//	With the newly created system,
//	they can fully regulate digital
//	information.

/*だから新しいシステムで、
デジタル化された全ての情報統制を行う。*/
エマ_022: {
Wichtige Informationen k&~onnen
in Kategorien eingeordnet, mit
Geheimhaltungsstufen
}
//	<<<ENGLISH>>>
//	High-level information can be
//	categorized in stages, given
//	clearance levels,

//<ページ数変更>
エマ_022_1: {
versehen oder gel&~oscht werden --
und das war's dann.
}
//	<<<ENGLISH>>>
//	and deleted as necessary --
//	never to be seen by the public.

/*高度な情報は段階を経て、
クリアランスが付けられ、
一般公開から削除されていく。
*/
エマ_023: {
So k&~onnen die Patriots den Verlauf
der Geschichte nach ihren W&~unschen
beeinflussen.
}
//	<<<ENGLISH>>>
//	By deleting such information, the
//	Patriots can shape the course of
//	history as they see fit.

/*これが動き出せば、数年で様々な情報は
歴史からいっせいに削除されることに
なる……。*/
ライデン_024: {
Irgendwer findet das bestimmt heraus --
}
//	<<<ENGLISH>>>
//	Somebody's bound to catch on --

/*誰かが気づくはずだ。*/
エマ_025: {
Nein. Sowohl das Ged&~achtnis als auch
die Lebenserwartung
}
//	<<<ENGLISH>>>
//	No. The memory capacity --
//	not to mention the life span --

//<ページ数変更>
エマ_025_1: {
eines durchschnittlichen Menschen ist
ziemlich begrenzt.
}
//	<<<ENGLISH>>>
//	of the average individual
//	is extremely limited.

/*いいえ、人の記憶容量は極めて小さい。
人の寿命も短い。
*/
エマ_026: {
Digitale Informationen halten
aber praktisch ewig.
}
//	<<<ENGLISH>>>
//	On the other hand, digital
//	information lasts virtually
//	forever...

//<ページ数変更>
エマ_026_1: {
in einwandfreiem Zustand.
}
//	<<<ENGLISH>>>
//	it doesn't deteriorate.

/*永遠に残るのはデジタル化されたもの
だけ。劣化しないから。
*/
ライデン_027: {
Und?
}
//	<<<ENGLISH(2)>>>
//	So...?

/*ばかな……。*/
エマ_028: {
Das Alphabet, 26 Buchstaben, stimmt's?
Vielleicht gab es 30 Buchstaben
}
//	<<<ENGLISH>>>
//	The alphabet... twenty-six letters,
//	right? It could've been thirty letters.

/*例えばアルファベットは２６文字だと
思われている。でも本来は３０文字
だったかもしれない。
*/
エマ_029: {
und die 4 gel&~oschten werden von
einem Programm kontrolliert?
}
//	<<<ENGLISH>>>
//	What if the 4 deleted letters
//	were controlled by a program?

/*その削除された４文字をプログラムで
統制しているとしたら……。
*/
ライデン_030: {
Unm&~oglich.
}
//	<<<ENGLISH(2)>>>
//	Impossible.

/*ありえない。*/
エマ_031: {
Ganz und gar nicht.
Etwas &~ahnliches ist bereits im Gange.
}
//	<<<ENGLISH>>>
//	It's not. In fact, something
//	similar is already underway.

//<ページ数変更>
エマ_031_1: {
Wei&~st Du, wie viele Gene
ein Mensch hat?
}
//	<<<ENGLISH>>>
//	Do you know how many genes
//	exist in an individual?

/*いいえ。それは既に行われつつある。
じゃあ、人の遺伝子数はいくつか
知ってる？
*/
ライデン_032: {
30 bis 40 Tausend?
}
//	<<<ENGLISH>>>
//	About 30 to 40 thousand?

/*３万から４万個？*/
エマ_033: {
Genau. So hie&~s es um die
Jahrhundertwende.
}
//	<<<ENGLISH>>>
//	Right. That's what was announced
//	at the turn of the century.

//<ページ数変更>
エマ_033_1: {
Doch die Wissenschaft erkl&~arte
urspr&~unglich, es seien 100.000.
}
//	<<<ENGLISH>>>
//	But there's actually 100 thousand,
//	according to the original theory＃−

//<ページ数変更>
エマ_033_2: {
Die Informationen &~uber die restlichen
}
//	<<<ENGLISH>>>
//	advanced by the scientific
//	community.

/*ええ。今世紀の初めにそう発表された。
でも本当は、それ以前の学説通りの
１０万個なの。
*/
エマ_034: {
60.000 Genen wurden von den Patriots
unterdr&~uckt.
}
//	<<<ENGLISH>>>
//	Information regarding the
//	remaining 60 thousand was
//	suppressed by the Patriots.

/*残りの６万個が『愛国者達』に
情報統制されている……。*/
ライデン_035: {
Nein.
}
//	<<<ENGLISH>>>
//	No...

/*嘘だ！*/
エマ_036: {
Wieso nicht?
Woher willst Du das wissen?
}
//	<<<ENGLISH>>>
//	Why? How would you know?

/*それが嘘だと、どうしてあなたに
分かるの？*/
エマ_037: {
Wei&~st Du, wie ein Gen aussieht?
Hast Du sie selbst gez&~ahlt?
}
//	<<<ENGLISH>>>
//	Do you know what a gene looks like?
//	Did you count them yourself?

/*遺伝子がどんなものか、
あなたは本当に知ってるの？*/
ライデン_038: {
Es gibt Forschungsorganisationen.
}
//	<<<ENGLISH>>>
//	There are research organizations...

/*……研究機関なら……。*/
エマ_039: {
Nat&~urlich, und ihre Berichte wurden
bereits diskret ge&~andert.
}
//	<<<ENGLISH>>>
//	Of course... and their reports have
//	already been subtly altered.

//<ページ数変更>
エマ_039_1: {
Sie beginnen bereits, an die ge&~anderten
Berichte zu glauben.
}
//	<<<ENGLISH>>>
//	They're even beginning to
//	believe the doctored reports.

/*勿論、研究論文もすべて情報改竄されて
るわ。そしてそのうち自分が間違いで
あったと錯覚する。
*/
エマ_040: {
Mit GW k&~onnen die Patriots
entscheiden, was man morgen in
den Geschichtsb&~uchern steht.
}
//	<<<ENGLISH>>>
//	GW is a system that allows the
//	Patriots to decide what will be
//	recorded in tomorrow's history.

/*『Ｇ．Ｗ』は人の歴史を後世に
どう残すか、それを『愛国者達』が
決めるためのシステム……。*/
ライデン_041: {
Es handelt sich also um ein riesiges
Zensursystem, mit dem f&~ur die Patriots
unangenehme informationen,
}
//	<<<ENGLISH>>>
//	So what we're talking about is
//	one huge censorship system for
//	deleting information＃−

//<ページ数変更>
ライデン_041_1: {
ausradiert werden?
}
//	<<<ENGLISH>>>
//	which might be inconvenient
//	to the Patriots?

/*つまり『愛国者達』に都合の悪い情報を
削除する大掛かりな検閲装置という
ことか？
*/
エマ_042: {
Genau. Der physische Kern f&~ur diese
Aufgabe -- GW -- ist in Arsenal installiert.
}
//	<<<ENGLISH>>>
//	Exactly. The actual, physical core
//	for handling the task -- GW -- is
//	installed in Arsenal.

/*ええ。それを行う中枢システムの物理的
実体がアーセナルの中にあるの。*/
エマ_043: {
Es ist das einzige System der Welt mit
einer Optisch - neuralen k&~unstlichen
Intelligenz.
}
//	<<<ENGLISH>>>
//	It's the only system in the world
//	with an optic neural AI＃−

/*『Ｇ．Ｗ』。
*/
エマ_044: {
Die parallele Verarbeitungskapazit&~at
betr&~agt 980 Trillionen Hammets.
}
//	<<<ENGLISH>>>
//	that has a parallel processing
//	capacity of 980 trillion hammets.

/*世界に一つしかない９８０兆ハメットの
複雑さを持つ光ニューロＡＩ……。*/
ライデン_045: {
Ich nehme an, Deine Mitarbeit am Metal
Gear-Projekt beruht
}
//	<<<ENGLISH>>>
//	I suppose that being a specialist
//	in neural AI and complex logic＃−

//<ページ数変更>
ライデン_045_1: {
auf Dein Expertenwissen &~uber neurale
k&~unstliche Intelligenz und komplexe Logik.
}
//	<<<ENGLISH>>>
//	played a significant role
//	in your association with
//	the Metal Gear project.

/*それが理由か？ニューロＡＩと
複雑性理論の専門家の君が
メタルギア開発に関わっていたのは……。
*/
エマ_046: {
Das ist nicht der einzige Grund.
}
//	<<<ENGLISH>>>
//	That's not the only reason...

/*それだけじゃないけどね……。*/
ライデン_047: {
Was meinst Du damit?
}
//	<<<ENGLISH(2)>>>
//	What do you mean?

/*え？*/
エマ_048:
''
//	<<<ENGLISH>>>
//	...

/*……。*/
ライデン_049: {
Vermutlich gibt es unz&~ahlige
weitere Gr&~unde.
}
//	<<<ENGLISH>>>
//	I guess there're plenty
//	of other reasons.

/*……まぁ、きっと事情があるんだろうな。*/
エマ_050: {
Ja --
}
//	<<<ENGLISH>>>
//	Yes, there are --

/*うん……。*/
ライデン_051: {
Verstehe.
}
//	<<<ENGLISH>>>
//	I understand...

/*わかるよ。*/
エマ_052: {
Ach ja?
}
//	<<<ENGLISH(2)>>>
//	Do you?

/*……そう……？*/
ライデン_053: {
Arsenal Gear wurde also als Schutz f&~ur
das GW-System entwickelt, stimmt's?
}
//	<<<ENGLISH>>>
//	So Arsenal Gear was actually
//	designed to protect the GW
//	system, wasn't it?

/*ではアーセナルギアは『Ｇ．Ｗ』を
守るために建造された？*/
エマ_054: {
&~Ah, ja. Arsenal Gear ist mit allen Waffen
ausger&~ustet, einschlie&~slich Atomwaffen.
}
//	<<<ENGLISH>>>
//	Uh...yes. It's armed with
//	everything including nuclear
//	weapons,

//<ページ数変更>
エマ_054_1: {
Und es hat alle erdenklichen
Abwehrmechanismen gegen
Cyber-Terroristen.
}
//	<<<ENGLISH>>>
//	and is fully equipped with
//	cyber-terrorist countermeasures.

/*……ええ。核兵器を含めた最高の武装を持ち、サイバーテロ対策も完璧。
物理的にも論理的にも史上最強の要塞。
*/
エマ_056: {
Physisch wie logisch ist es die ultimative
Festung f&~ur GW.
}
//	<<<ENGLISH>>>
//	Physically and logically,
//	it's the ultimate fortress
//	for housing GW.

/*『Ｇ．Ｗ』の器。*/
ライデン_057: {
Aber kann die k&~unstliche Intelligenz
wirklich alles kontrollieren?
}
//	<<<ENGLISH>>>
//	But is the AI actually capable
//	of controlling everything?

/*だが、そのＡＩだけで全てを制御出来る
とは思えないが。*/
エマ_058: {
Nein. GW ist nur der Kern des Systems.
Es entscheidet nur &~uber die speicherung
oder L&~oschung von Daten.
}
//	<<<ENGLISH>>>
//	No. GW is only the system's core.
//	It's only for deciding what data
//	is stored or deleted.

/*ええ。『Ｇ．Ｗ』はあくまでも
システムの中枢。何を残すか、
何を削除するかを判断するためのね。*/
エマ_059: {
Das eigentliche Subsystem
f&~ur die Aufgabe ist in unserer
Gesellschaftsstruktur enthalten.
}
//	<<<ENGLISH>>>
//	The actual sub-system for
//	executing the task exists
//	within our social structure...

/*それを実行するサブシステムは
既に社会に埋め込まれている……。*/
ライデン_060: {
Was!?
}
//	<<<ENGLISH>>>
//	What!?

/*どういうことだ？*/
}
//d


resource P062_05_R02_エマとＡＩ５無線機デモ２＿１__g {
//vc116211
ライデン_000: {
La&~s mich raten, die L&~osung f&~ur das
Jahr-2000-Problem enthielt ein von
den Patriots entwickeltes Programm?
}
//	<<<ENGLISH>>>
//	Let me guess... the Y2K
//	countermeasure contained a program
//	designed by the Patriots?

/*その中に『愛国者達』のプログラムが
仕込まれていたと？*/
エマ_001: {
Ja. Und alles, was seitdem auf den
Markt gebracht wird, enth&~alt
das gleiche Programm.
}
//	<<<ENGLISH>>>
//	Yes. And everything supplied from
//	that day onward contains the same
//	program.

/*ええ。
勿論、それ以降に作られたものには
初めからそのシステムが組み込んである。*/
ライデン_002: {
Unm&~oglich.
}
//	<<<ENGLISH(2)>>>
//	Impossible.

/*そんな馬鹿な……。*/
エマ_003: {
Wei&~st Du, wie ein Computer funktioniert?
}
//	<<<ENGLISH>>>
//	Do you know how
//	a computer operates?

/*どうしてそう言えるの？コンピュータが
どうやって動作しているのか、あなたは
知ってるの？
*/
エマ_004: {
Bist Du wirklich mit den Grundz&~ugen
des Datenaustauschs vertraut?
}
//	<<<ENGLISH>>>
//	Do you really know the basic
//	principles on how data is
//	exchanged?

/*この通信がどういう原理なのかだって
本当は分かってないでしょ？
*/
ライデン_005:
''
//	<<<ENGLISH>>>
//	...

/*……。*/
エマ_006: {
Niemand wei&~s es, aber es gibt ein
Subsystem. Und es soll in K&~urze
aktiviert werden.
}
//	<<<ENGLISH>>>
//	Nobody's aware of it, but
//	there's a sub-system in place.
//	And it's about to be activated.

/*誰も知らないけど、そのシステムは
実在する。そしてそれらはもうすぐ
一斉に動き出す……。*/
ライデン_007: {
Will Solidus deshalb alle Stromkreise in
Manhatten durch einen atomaren Schlag
zerst&~oren?
}
//	<<<ENGLISH>>>
//	Is that why Solidus wants to burn
//	out every electrical circuit in
//	Manhattan with a nuclear blast?

/*ソリダスが核爆発でマンハッタン全ての
電子回路を焼き切ろうとしているのは
そのため……？*/
エマ_008: {
Wahrscheinlich.
Aber das Gesamtsystem
ist noch nicht vollst&~andig.
}
//	<<<ENGLISH>>>
//	Probably.
//	But the overall system
//	isn't actually complete.

/*そうかもね。
でもシステムはまだ完成してるわけ
じゃない。*/
ライデン_009: {
Was?
}
//	<<<ENGLISH>>>
//	What?

/*え？*/
エマ_010: {
Noch fehlen erforderliche Elemente zur
Beurteilung von Situationen.
}
//	<<<ENGLISH>>>
//	It still lacks the necessary
//	factors for judging situations.

/*状況を判断するための＃｛因子、ファクター｝＃が
不足してるの。*/
エマ_011: {
Ich habe von einem Experiment in den
n&~achsten Tagen geh&~ort,
}
//	<<<ENGLISH>>>
//	I heard they were planning a major
//	experiment in the next few days,

//<ページ数変更>
エマ_011_1: {
da&~s komplexe Daten zur &~Uberpr&~ufung
durch GW liefern sollen.
}
//	<<<ENGLISH>>>
//	to provide complex data
//	for GW to study.

/*その複雑さを『Ｇ．Ｗ』に学習させる
ために大規模な実験を近日中に
行うって話は聞いていたんだけど……。
*/
エマ_012: {
Und dann pl&~otzlich all das hier.
}
//	<<<ENGLISH>>>
//	And suddenly all this happens...

/*突然、こんなことが起こって……。*/
ライデン_013: {
Emma. es ist nicht Deine Schuld.
Terroristen.
}
//	<<<ENGLISH>>>
//	Emma... it's not your fault.
//	If it wasn't for the terrorists...

/*……エマ、これはテロだ。
君が悪いんじゃない……。*/
エマ_014: {
Ja, Du hast recht.
}
//	<<<ENGLISH>>>
//	Yeah... you're right...

/*……うん……そうね……。*/
エマ_015: {
Nun, Ich glaube, das ist alles,
was ich wei&~s.
}
//	<<<ENGLISH>>>
//	Well... I think that's
//	about all I know.

/*うん。
……とりあえず私が知ってるのは
これくらい、かな。*/
ライデン_016: {
Gut, &~ah, danke. La&~s uns besser auf den
Weg zum Computerraum machen.
}
//	<<<ENGLISH>>>
//	Right... uh, thanks. I think
//	we'd better head for the
//	Computer Room.

/*そうか……ありがとう。
じゃあ電算室へ急ごうか？*/
エマ_017: {
Mein Vogel im Computerraum!
Ist er in Sicherheit!?
}
//	<<<ENGLISH>>>
//	My bird in the Computer
//	Room! Is he safe!?

/*鳥は無事？
電算室にいた……。*/
}
//d




resource P064_01_R01_エマライデンローズ無線１無線機デモ１＿１__g {
//vc116401
ローズ_000: {
Nun, Jack. H&~ort sich an, als w&~urdest Du
Dich sehr gut mit Emma verstehen.
}
//	<<<ENGLISH>>>
//	Well, Jack. It sounds like you
//	and Miss Emma are getting
//	along just fine.

/*ジャック、エマさんと仲がいいようね。*/
ライデン_001: {
Rose?
}
//	<<<ENGLISH>>>
//	Rose?

/*ローズ、何を言っている？*/
ローズ_002: {
Ich verfolge all Deine Bewegungen und
Unterhaltungen. Nicht, da&~s es mir Spa&~s
macht.
}
//	<<<ENGLISH>>>
//	I've been monitoring your
//	every move and conversation.
//	I can't say it's been fun...

/*私、あなたの行動や会話を全部モニター
してるのよ。あまりいい気はしないわ。*/
ライデン_003: {
La&~s mich in Ruhe! Ich versuche nur,
sie bei Laune zu halten.
}
//	<<<ENGLISH>>>
//	Give me a break! I'm only
//	trying to keep her spirits up.

/*誤解するな。
俺はエマを勇気づけてるだけだ。*/
ローズ_004: {
Ach ja?
}
//	<<<ENGLISH>>>
//	Is that right?

/*そうなの、ジャック？*/
ライデン_005: {
Nat&~urlich. Mein Auftrag lautet,
sie zum Computerraum zu bringen.
}
//	<<<ENGLISH>>>
//	Absolutely. My mission is to get
//	her to the Computer Room.

/*ああ。
彼女を電算室まで連れて行くのが任務だ。*/
ローズ_006: {
Und das ist alles?
}
//	<<<ENGLISH>>>
//	That's all?

/*それだけ？*/
ライデン_007: {
Ja.
}
//	<<<ENGLISH(2)>>>
//	Yeah.

/*……ああ。*/
ローズ_008: {
Du l&~ugst.
Du findest sie attraktiv, nicht wahr?
}
//	<<<ENGLISH>>>
//	You're lying.
//	You're attracted
//	to her, aren't you.

/*嘘っ、ちょっとはいいと思ってる？*/
ライデン_009: {
Ich geb's ja zu, sie ist h&~ubsch.
}
//	<<<ENGLISH>>>
//	...I'll admit she's cute.

/*ああ、エマはかわいい娘だ。*/
ローズ_010: {
H&~ubscher als ich?
}
//	<<<ENGLISH>>>
//	Cuter than me?

/*私より？*/
ライデン_011: {
Rose, Du bist sch&~on.
Du wei&~st doch, wie ich zu Dir stehe.
}
//	<<<ENGLISH>>>
//	Rose, you're beautiful.
//	You know how I feel about
//	you.

/*ローズ、君は素敵だ。
俺の気持ちに代わりはない。*/
ローズ_012: {
Ist es Dir wieder eingefallen?
}
//	<<<ENGLISH>>>
//	Have you remembered yet?

/*じゃあ、思い出した？*/
ライデン_013: {
Du meinst den 30. April?
}
//	<<<ENGLISH>>>
//	You mean April 30th?

/*４月３０日のこと？*/
ローズ_014: {
Ja.
}
//	<<<ENGLISH(2)>>>
//	Yes.

/*そう。*/
ライデン_015: {
Es ist Dein Geburtstag, nicht wahr?
}
//	<<<ENGLISH>>>
//	It's your birthday, isn't it.

/*君の誕生日？*/
ローズ_016: {
Falsch!
Du bist nicht einmal nahe dran!
}
//	<<<ENGLISH>>>
//	Wrong!
//	You're not even warm!

/*ブブー！
外れ！
大外れ！*/
ライデン_017: {
Was ist es dann?
}
//	<<<ENGLISH>>>
//	What is it then?

/*意地悪だな。*/
ローズ_018: {
Vergi&~s es, es ist nichts. Vielleicht bin
ich nur ein wenig, eifers&~uchtig.
}
//	<<<ENGLISH>>>
//	Forget it... it's nothing.
//	Maybe I'm just a little...
//	a little jealous...

/*……ごめんなさい。ちょっとした冗談、
なんだか、いいムードだったから……
ちょっとやけちゃったかな……。*/
ライデン_019: {
Rose?
}
//	<<<ENGLISH(2)>>>
//	Rose?

/*ローズ？*/
ローズ_020: {
Beeil' Dich lieber.
Viel Gl&~uck.
}
//	<<<ENGLISH>>>
//	You'd better get moving.
//	Good luck.

/*じゃあね、がんばって。*/
}
//d




resource P065_02_R01_エマＬ脚２無線機デモ１＿１__g {
//vc116501
ライデン_000: {
Ich mu&~s Dich etwas fragen.
}
//	<<<ENGLISH>>>
//	I have a question for you.

/*……聞いていいか？*/
エマ_001: {
Was denn?
}
//	<<<ENGLISH(2)>>>
//	What is it?

/*なに？*/
ライデン_002: {
Wie stehst Du zu H&~ohen?
}
//	<<<ENGLISH>>>
//	How do you feel about heights?

/*高いところは苦手か？*/
エマ_003: {
Ich mag sie nicht besonders, aber vor
Wasser habe ich mehr Angst. Warum?
}
//	<<<ENGLISH>>>
//	I can't say I like heights...
//	though water's higher on
//	my phobia list. Why?

/*嫌い。
水の中よりはマシだけど……
どうしてそんなこと聞くの？*/
ライデン_004: {
Na ja, Wir m&~ussen eine Leiter hinabsteigen.
}
//	<<<ENGLISH>>>
//	Well... we have to
//	go down a ladder.

/*これからハシゴで下に降りる。*/
エマ_005: {
Wie tief?
}
//	<<<ENGLISH>>>
//	How far down?

/*どれくらい？*/
ライデン_006: {
Nur ein klein wenig.
}
//	<<<ENGLISH>>>
//	Just a little bit...

/*ほんの少しだ。*/
エマ_007: {
Warum kommt mir das so bekannt vor?
Wie wenig ist 'ein klein wenig'?
}
//	<<<ENGLISH>>>
//	Why do I feel like we've had
//	this conversation before?
//	How little is little?

/*さっきも『ほんの少し』って聞いたけど？*/
ライデン_008: {
Etwa 40 Meter?
}
//	<<<ENGLISH>>>
//	...About 130 feet?

/*……４０メートル……くらいかな。*/
エマ_009:
''
//	<<<ENGLISH>>>
//	...

/*……。*/
ライデン_010: {
Glaubst Du, da&~s Du es schaffen kannst?
}
//	<<<ENGLISH(2)>>>
//	Think you can do it?

/*いけるか？*/
エマ_011: {
Was, wenn ich 'nein' sagen w&~urde?
}
//	<<<ENGLISH(2)>>>
//	Would you take "no"
//	for an answer?

/*ダメって言っても連れてくんでしょ。*/
ライデン_012: {
Was machen Deine Beinen?
}
//	<<<ENGLISH>>>
//	How are your legs?

/*足の具合は？*/
エマ_013: {
Besser.
Sie sind nicht mehr taub.
}
//	<<<ENGLISH>>>
//	Better.
//	The numbness is gone.

/*大丈夫。だいぶシビレがとれてきた。*/
エマ_014: {
Ich kann selbst hinuntersteigen.
}
//	<<<ENGLISH>>>
//	I can climb down on my own.

/*一人で歩けるわ。*/
ライデン_015: {
Okay, folge mir.
}
//	<<<ENGLISH>>>
//	Okay... follow me.

/*よし、俺の後についてくるんだ。*/
}
//d




resource P065_06_R02_Ｌ脚エマ６無線機デモ２＿１__g {
//Vc116511
ライデン_000: {
Hier ist Raiden, h&~orst Du mich?
}
//	<<<ENGLISH>>>
//	This is Raiden, do you read me?

/*こちらライデン、聞こえるか？*/
プリスキン_001: {
Ja, was gibt's?
}
//	<<<ENGLISH>>>
//	Yeah. What's up?

/*ああ、どうした？*/
ライデン_002: {
Wir haben das untere Ende von Strebe L
erreicht. Von hier aus m&~ussen wir &~uber
das Wasser.
}
//	<<<ENGLISH>>>
//	We've made it to the lower part
//	of Strut L. We'll have to cross
//	the water from here.

/*Ｌ脚下部に到着した。
今から海面を渡るところだ。*/
プリスキン_003: {
Kann Emma laufen?
}
//	<<<ENGLISH>>>
//	Can Emma walk?

/*エマは歩けそうか？*/
ライデン_004: {
Es geht ihr ganz gut. Die Pontonbr&~ucke
sieht nicht sehr stabil aus. Emma wird
alleine r&~uber m&~ussen.
}
//	<<<ENGLISH>>>
//	She's okay. The pontoon bridge
//	doesn't look too sturdy. Emma is
//	going to have to cross it alone.

/*彼女なら大丈夫だが。
浮き橋はかなり脆そうだ。
エマひとりしか渡れそうもない。*/
プリスキン_005: {
Okay, der &~Olzaun --
}
//	<<<ENGLISH>>>
//	Right... the oil fence --

/*オイルフェンスだからな。*/
}
//d
//小画面に双眼鏡モードの映像がでる。浮き橋をパンすると、敵兵、サイファーが見える
resource P065_06_R02_Ｌ脚エマ６無線機デモ２＿２__g {
//vc116512
ライデン_000: {
Da sind Cyphers und mehrere Wachen.
}
//	<<<ENGLISH>>>
//	There's Cyphers and
//	several guards.

/*サイファーと見張りが数人いる。*/
プリスキン_001: {
Raiden, Du bist doch mit einem PSG1
bewaffnet, oder?
}
//	<<<ENGLISH>>>
//	Raiden, you're carrying
//	a PSG1, aren't you?

/*ライデン、ＰＳＧ１を持ってるだろう？*/
ライデン_002: {
Ja.
}
//	<<<ENGLISH(2)>>>
//	Yeah.

/*ああ。*/
プリスキン_003: {
Zeit, Dein K&~onnen zu zeigen.
}
//	<<<ENGLISH>>>
//	It's time to play sniper.

/*そこから狙撃するんだ。*/
}
