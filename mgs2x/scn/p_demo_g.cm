/* -------------------------------

プラント強制無線機デモどろどっち。
$Id: p_demo_g.cm,v 1.14 2002/08/02 10:52:48 usr01098 Exp $

---------------------------------*/

resource P001_02_R01_オープニング潜入２無線デモ１＿１__g {
ライデン_000: {
Hier Snake. Ich befinde mich jetzt
in Strebe A von Shell 1.
}
//	<<<ENGLISH>>>
//	This is Snake. I am now inside
//	Strut A of Shell 1.

/*こちらスネーク、
シェル１のＡ脚内に潜入した。*/
大佐_001: {
Wie ist die Lage?
}
//	<<<ENGLISH>>>
//	How are things?

/*状況はどうだ？*/
ライデン_002: {
Wir haben Gl&~uck. Es scheint hier
keine Posten zu geben.
}
//	<<<ENGLISH>>>
//	We're in luck. Looks like there
//	are no sentries posted here.

/*幸い、ここには見張りはいないようだ。*/
大佐_003: {
Wie ist die Sicht?
}
//	<<<ENGLISH>>>
//	What's the visibility?

/*視界はどうだ？*/
ライデン_004: {
Die Scheinwerfer in den Streben
funktionieren. Ich brauche mein
Nachtsichtger&~at nicht.
}
//	<<<ENGLISH>>>
//	The lights on the plant's struts
//	are functioning. I won't have to
//	use the IR goggles.

/*プラント脚部のライトが起動している。
おかげで＃｛赤外線、サーマル｝＃ゴーグルは使わずに済む。*/
大佐_005: {
Irgendwelche Probleme?
}
//	<<<ENGLISH>>>
//	Any problems?

/*何か問題は？*/
ライデン_006: {
Da war ein neues Loch im &~Olzaun.
}
//	<<<ENGLISH>>>
//	There was a brand-new hole
//	cut through the oil fence.

/*オイルフェンスの切断面が真新しかった。*/
//<ページ数変更>
ライデン_006_1: {
Da wollte au&~ser mir noch jemand
unbedingt rein.
}
//	<<<ENGLISH>>>
//	There's someone else besides me
//	that wanted to get in badly.

/*俺の他にも潜入を試みた奴がいる。*/
大佐_007: {
Unm&~oglich.
}
//	<<<ENGLISH>>>
//	That's not possible.

/*それは考えられん。*/
ライデン_008: {
Was ist mit dem SEAL-Trupp 10?
}
//	<<<ENGLISH>>>
//	What about SEAL Team 10?

/*ＳＥＡＬ１０の突入班は？*/
大佐_009: {
Ist wie geplant auf dem Dach
der Big Shell gelandet.
}
//	<<<ENGLISH>>>
//	They landed on the roof of
//	the Big Shell as planned.
//<ページ数変更>
/*既に『ビッグ・シェル』上部に降下した。*/
大佐_009_1: {
&~Ubrigens, Snake, wir &~andern
Deinen Codenamen f&~ur
die weitere Kommunikation.
}
//	<<<ENGLISH>>>
//	And by the way Snake, we're
//	changing your code name for
//	all following communication.

/*それとスネーク、今後の無線はコード
ネームを変更して行う。*/
ライデン_010: {
Was hast Du gegen 'Snake'?
}
//	<<<ENGLISH(2)>>>
//	What's wrong with "Snake"?

/*スネークでは何か問題が？*/
大佐_011: {
Reine Vorsichtsma&~snahme.
Du bist jetzt 'Raiden'.
}
//	<<<ENGLISH>>>
//	Just a precaution. You are
//	now designated "Raiden."

/*まあな……。
君をこれから、ライデンと呼ぶ*/
}//d

//★　タンカー編をクリアしたユーザーの場合
resource P001_02_R01_オープニング潜入２無線デモ１＿タンカーした１__g {
大佐_000: {
Okay, Raiden. Im VR-Training hast Du
bereits das Infiltrieren geprobt.
}
//	<<<ENGLISH>>>
//	All right, Raiden. You've
//	already covered infiltration
//	in VR Training.

/*では、ライデン。
潜入ミッションは既にＶＲ訓練で
訓練済みだな。*/
ライデン_001: {
Im VR-Training habe ich 300 Eins&~atze
abgeschlossen.
}
//	<<<ENGLISH>>>
//	I've completed three hundred
//	missions in VR.

/*ＶＲなら３００ミッションはこなした。*/
ライデン_002: {
Ich komme mir wie ein legend&~arer
S&~oldner vor.
}
//	<<<ENGLISH>>>
//	I feel like some kind of
//	legendary mercenary...

/*伝説の傭兵になった気分だ……。*/
}//d

resource P001_02_R01_オープニング潜入２無線デモ１＿タンカーした２__g {
大佐_000: {
Okay, lassen wir das weg.
}
//	<<<ENGLISH>>>
//	Okay, we'll skip that part.

/*それじゃ、その部分は簡略化するぞ*/
}//d


//★　タンカー編をクリアしていないユーザーの場合

resource P001_02_R01_オープニング潜入２無線デモ１＿タンカーしてない__g {
大佐_000: {
Das wird Dein erster Schleicheinsatz.
}
//	<<<ENGLISH>>>
//	This will be your first
//	sneaking mission.

/*今回、君にとって初めての＃｛潜入任務、スニーキング・ミッション｝＃に
なる。*/
大佐_001: {
Die Waffen m&~ussen nat&~urlich
vor Ort beschafft werden.
}
//	<<<ENGLISH>>>
//	The arms will naturally have
//	to be procured on-site.

/*当然、武器は現地調達だ。*/
}//d

resource P001_02_R01_オープニング潜入２無線デモ１＿２__g {
大佐_000: {
Pa&~s auf, da&~s niemand Dich sieht.
}
//	<<<ENGLISH>>>
//	Make sure nobody sees you.

/*くれぐれも見つからんようにな*/
大佐_001: {
Du kannst mich &~uber Codec erreichen.
Die Frequenz ist 140,85.
}
//	<<<ENGLISH>>>
//	If you need to, contact me by Codec.
//	The frequency is 140.85.

/*何かあれば無線連絡をくれ。
周波数は１４０．８５だ*/
大佐_002: {
Wenn Du Codec verwenden m&~ochtest,
dr&~ucke die SELECT-Taste.
}
//	<<<ENGLISH>>>
//	When you want to use the Codec,
//	push the SELECT button.

/*無線機を使いたい時は
ＳＥＬＥＣＴボタンを押すんだ。*/
大佐_003: {
Wenn wir Sie kontaktieren m&~ussen,
piept das Codec.
}
//	<<<ENGLISH>>>
//	When we need to reach you...
//	contact you, the Codec will
//	beep.

/*こちらから呼び出す場合、
いや連絡する場合はＣＡＬＬする。*/
大佐_004: {
Wenn Sie dieses Ger&~ausch h&~oren,
dr&~ucken Sie die SELECT-Taste.
}
//	<<<ENGLISH>>>
//	When you hear that noise,
//	press the SELECT button.

/*ＣＡＬＬ音がなったら、
ＳＥＬＥＣＴボタンを押してくれ。*/
大佐_005: {
Der Codec-Empf&~anger stimuliert
direkt Ihren Geh&~organg.
}
//	<<<ENGLISH>>>
//	The Codec's receiver directly
//	stimulates the small bones of
//	your ear.

/*耳小骨を直接振動させるものだ。
*/
//<ページ数変更>
大佐_005_1: {
Sie werden der Einzige sein,
der es h&~oren kann.
}
//	<<<ENGLISH>>>
//	No one but you will
//	be able to hear it.

/*敵には聞こえない。*/
ライデン_006: {
Okay. Ich melde mich,
wenn sich etwas &~andert.
}
//	<<<ENGLISH>>>
//	All right. I'll contact you
//	if anything changes.

/*わかった。
なにかあれば＃｛送信、ＳＥＮＤ｝＃する。*/
大佐_007: {
Begib Dich zun&~achst in den oberen
Abschnitt der Big Shell.
}
//	<<<ENGLISH>>>
//	First, make your way to
//	the upper section of the
//	Big Shell.

/*まずは『ビッグ・シェル』の上部に
出るんだ。*/
ライデン_008: {
Wie komme ich auf die n&~achste Ebene?
}
//	<<<ENGLISH>>>
//	How do I get up to
//	the next level?

/*上部へはどうやって？*/
}//d

//無線機スクリーンに昇降機の映像（ゲーム映像）が流れる。先行映像。ライデンが昇降機を見上げている＋主観映像。昇降機の場所と昇降機がわかる映像。

resource P001_02_R01_オープニング潜入２無線デモ１＿３__g {
大佐_000: {
Da ist ein Aufzug am Ende des Bereichs.
Nimm den.
}
//	<<<ENGLISH>>>
//	There's an elevator at the far end
//	of that area. Use that.

/*そのエリアの奥に昇降機がある。
それを使え。*/
ライデン_001: {
Alles klar.
}
//	<<<ENGLISH>>>
//	Sounds good.

/*わかった。*/
}//d

//映像消える。

resource P001_02_R01_オープニング潜入２無線デモ１＿４__g {
大佐_000: {
Dein neuer Sneak-Anzug ist mit
Elektrofasertechnologie aus der
Glasfaserforschung ausger&~ustet.
}
//	<<<ENGLISH>>>
//	Your new Sneaking suit uses
//	electrofiber technology, a by-
//	product of fiber-optics research.
//d
/*今回のスニーキング・スーツは
光ファイバーを使った電気紡績技術を
使っている。*/
}
//オープニング潜入３ポリゴンデモ２へ




resource P001_04_R02_オープニング潜入４無線デモ２__g {
//vc110111
大佐_000: {
Die Luke mit einem runden Griff f&~uhrt zum
Fahrstuhlbereich. Finde zuerst die Luke.
}
//	<<<ENGLISH>>>
//	The hatch with a circular handle
//	will open into the elevator area.
//	Locate the hatch first.

/*丸いハンドルの付いたハッチが
昇降機エリアへの入口だ。
まずはそれを探してくれ。*/
ライデン_001: {
Verstanden. Jetzt zu den
Haupteinsatzzielen.
}
//	<<<ENGLISH>>>
//	Copy that. Moving onto
//	main mission objectives.

/*了解、＃｛作戦、ミッション｝＃に入る。*/
}//d

resource P002_02_R01_Ａ脚底部連結ハッチ２無線デモ１＿１__g {
//vc110201
ライデン_000: {
Oberst, ich habe einen feindlichen
Posten gesichtet.
}
//	<<<ENGLISH>>>
//	Colonel, I've sighted
//	an enemy sentry.

/*大佐、敵兵を１名確認。*/
}//d

resource P002_02_R01_Ａ脚底部連結ハッチ２無線デモ１＿２__g {
//vc110202
ライデン_000: {
AN-94 und eine Makarov.
}
//	<<<ENGLISH>>>
//	AN-94 and a Makarov.

/*ＡＮ９４にマカロフ……。*/
ライデン_001: {
Die Granaten, die gesamte
Ausr&~ustung ist russisch.
}
//	<<<ENGLISH>>>
//	Those grenades... all his
//	equipment is Russian-made.

/*グレネード……ロシア製の装備だ。*/
大佐_002: {
Einer von Gurlukovichs Trupp.
}
//	<<<ENGLISH>>>
//	Must be a Gurlukovich man.

/*ゴルルコビッチ大佐の部隊だろう*/
ライデン_003: {
Gurlukovich?
}
//	<<<ENGLISH(2)>>>
//	Gurlukovich?

/*ゴルルコビッチ？*/
大佐_004: {
Eine russische Privatarmee, die vor
vier Jahren mit dem Shadow Moses
&~Ubernahmetrupp kooperieren sollte.
}
//	<<<ENGLISH>>>
//	A Russian private army that was in
//	line to work with the Shadow Moses
//	takeover group, four years ago.

/*４年前のシャドーモセス事件の際、
テロリストと合流しようとしたロシアの
私兵部隊だ。*/
ライデン_005: {
Was wollen die hier?
}
//	<<<ENGLISH>>>
//	What's their stake in this one?

/*なぜ彼らがこのテロに加わっている？*/
大佐_006: {
Sie haben wohl eine Vereinbarung
mit den Terroristen getroffen.
}
//	<<<ENGLISH>>>
//	They must have made a deal -- an
//	arrangement with the terrorists.

/*テロリスト達とのなんらかの取引が
あったに違いない。*/
大佐_007: {
Sie sind zu S&~oldnern geworden,
eine Armee ohne Land.
}
//	<<<ENGLISH>>>
//	They've become a band of
//	mercenaries, an army without
//	a country.

/*もはや彼らは国亡き傭兵部隊と
化している。*/
/*
大佐_008: {
通常、敵は君を見つけると仲間を呼ぶが、
そのエリアに限って言えば、その心配は
ない。
}
大佐_009: {
壁面に埋め込まれた無線通信補助
アンテナが錆び付いているんだ。
そのエリアで敵は無線を使えない。
}
ライデン_010: {
俺達の通信システムには影響ないのか？
}
大佐_011: {
ナノマシンには問題ない。
通常無線のみだ。
}
大佐_012: {
たとえ仲間を呼べなくても、
敵は武装している。
慎重にな、ライデン。
}
*/
}//d


resource P003_02_R02_スネーク昇降機上昇２無線デモ１＿１__g {
//vc110301
ライデン_000: {
Oberst, hier ist eindeutig noch
ein anderer Eindringling.
}
//	<<<ENGLISH>>>
//	Colonel, there's definitely
//	another intruder in here
//	besides me.

/*大佐、やはり俺の他に誰か侵入者がいる。*/
大佐_001: {
Das ist nicht m&~oglich.
}
//	<<<ENGLISH>>>
//	That's not a possibility.

/*ありえない事だ。*/
ライデン_002: {
Keine Truppe -
sieht nach Einzelg&~anger aus.
}
//	<<<ENGLISH>>>
//	Not a team -- looks like a solo job.

/*チームではない。単独のようだ。*/
大佐_003: {
Das ist nicht m&~oglich.
}
//	<<<ENGLISH(2)>>>
//	One man...?

/*単独だと……？*/
ライデン_004: {
Wir wissen vielleicht nicht, wer er ist,
aber er hat alle Posten in diesem
Bereich kaltgestellt.
}
//	<<<ENGLISH>>>
//	We may not know who he is, but he
//	managed to take care of every sentry
//	in the area; they're all out cold.

/*素性はわからんが、ここの見張りを
全て片づけてくれたようだ。
みんな気を失っている。*/
ライデン_005: {
Wer er auch sein mag,
er versteht sein Handwerk.
}
//	<<<ENGLISH>>>
//	Whoever he is, he's got some skills.

/*かなりのタフガイだ。*/
大佐_006: {
Wir m&~ussen ihn identifizieren.
Im Moment solltest Du die Situation
nutzen und an die Arbeit gehen.
}
//	<<<ENGLISH>>>
//	We need to get an ID... But for
//	now, you can take advantage of
//	the situation and get to work.

/* 意味が包含されている。008と融合。
大佐_007: {
今のうちにことを進めるとしよう。
}
*/
/*調査が必要だな……
しかし敵が無力化されているのは
とりあえず好都合だ。*/
大佐_008: {
Vor dem Aufzug befindet sich
ein Terminal, ein Node.
}
//	<<<ENGLISH>>>
//	There's a terminal in front
//	of the elevator, a node.

/*昇降機の前に端末がある。
『ノード』と呼ばれるものだ。*/
ライデン_009: {
Sagtest Du Not?
}
//	<<<ENGLISH(2)>>>
//	Did you say "nerd"?

/*＃｛まぬけ、ナード｝＃だって？*/
大佐_010: {
Nicht 'Not' - ein Node.
}
//	<<<ENGLISH(2)>>>
//	Not "nerd" -- "node."

/*ノードだ。*/
ライデン_011: {
Oh.
}
//	<<<ENGLISH(2)>>>
//	Oh.

/*なるほど、＃｛端末、ノード｝＃か。*/
大佐_012: {
Sichere Dir damit Zugang zu den
Einrichtungen der Big Shell.
}
//	<<<ENGLISH>>>
//	Use the node to gain access to
//	the Big Shell's facilities network.

/*ノードを使えば『ビッグ・シェル』内の
作業支援コンピュータ・ネットワークに
接続できる。*/
ライデン_013: {
Und dann?
}
//	<<<ENGLISH(2)>>>
//	Then what?

/*何が出来るんだ。*/
大佐_014: {
Rufe die Karte der Anlage auf; dann
kannst du den Soliton-Radar aktivieren.
}
//	<<<ENGLISH>>>
//	Pull up the map of the structure;
//	that'll let you activate the
//	Soliton Radar.

/*『ビッグ・シェル』のマップが参照
出来る。そしてそのデータによって
ソリトン・レーダーが使用可能になる。*/
ライデン_015: {
Den Soliton-Radar?
}
//	<<<ENGLISH>>>
//	The Soliton Radar?

/*ソリトン・レーダー？*/
}//d
resource P003_02_R02_スネーク昇降機上昇２無線デモ１＿２__g {
//vc110302
//（タンカー編をやってる人）
ライデン_000: {
Stimmt, der Radar war
im VR-Training sehr n&~utzlich.
}
//	<<<ENGLISH>>>
//	True, that radar came in
//	useful during VR training.

/*ＶＲ訓練で重宝したレーダーだな。*/
}//d
resource P003_02_R02_スネーク昇降機上昇２無線デモ１＿３__g {
//vc110303
//（タンカー編をやってないひと。全員聞く音声）
大佐_000: {
Eine Radaranlage, die mit biologischen
Magnetfeldern arbeitet.
}
//	<<<ENGLISH>>>
//	A radar system -- uses biological
//	magnetic fields as input.

/*人間の生体反応に起因する電磁場を
活用して判定を行うシステムだ。*/
大佐_001: {
Die vermuteten Stellungen des Gegners
werden auf eine Karte projiziert.
}
//	<<<ENGLISH>>>
//	These estimated enemy positions
//	are projected onto a map＃−

//<ページ数変更>
大佐_001_1: {
Die Bezugspunkte st&~utzen sich
auf Satellitensignale und Berichte
&~ortlicher Einsatztruppen.
}
//	<<<ENGLISH>>>
//	according to reference points
//	collected via GPS signals and
//	field personnel reports.

/*それらをＧＰＳや各隊員から収集される
エリア測定値により、誤差を修正した
マップ上に投影する。*/
大佐_002: {
Wir m&~ussen &~uber den Node in der Big
Shell an die Karte kommen. um diese
Computertechnik nutzen zu k&~onnen.
}
//	<<<ENGLISH>>>
//	We need to get to the map through
//	the Big Shell's node to put this
//	data processing to practical use.

/*この膨大なデジタル処理を
行う為にもノードによるマップ情報の
ダウンロードが必要なのだ。*/
大佐_003: {
Der Node ist rund einen Meter
gro&~s - blau, glaube ich.
}
//	<<<ENGLISH>>>
//	The node unit is about three feet
//	high -- should be colored blue.

/*ノードは１メートルくらいの高さの
青い端末だ。*/
//<ページ数変更>
大佐_003_1: {
Jeder Bereich hat mindestens einen.
}
//	<<<ENGLISH>>>
//	Each area has at least one.

/* このセリフはカットになった。
usually built right into the
wall.
*/
/*各エリアに最低１台はある。
壁に埋め込まれているはずだ。*/
}//d

resource P003_02_R02_スネーク昇降機上昇２無線デモ１＿４__g {
//vc110304
ライデン_000: {
Wie bekomme ich Zugang?
}
//	<<<ENGLISH>>>
//	How do I gain access?

/*接続するにはどうすればいい？*/
大佐_001: {
Dr&~ucke vor dem Node einfach
die Aktionstaste.
}
//	<<<ENGLISH>>>
//	Just push the Action button
//	in front of the node.

/*ノードの前で＃｛△、アクション｝＃ボタンを押すだけだ。*/
大佐_002: {
Die Nanomaschinen in Deinem K&~orper
sorgen daf&~ur, da&~s du zugelassen wirst.
So erh&~altst Du Zugang zum Node.
}
//	<<<ENGLISH>>>
//	The nanomachines in your body will
//	take care of the security clearance,
//	and allow you access to the node.

/*あとは君の体内のナノマシンが自動で
セキュリティを破りノードを使用可能に
してくれる。*/
大佐_003: {
Beende das Verfahren, bevor die Posten
wieder zu sich kommen.
}
//	<<<ENGLISH>>>
//	Complete the procedure before
//	those sentries gain consciousness.

/*敵兵達が目覚める前にアクセスを
完了しろ。*/
大佐_004: {
Wenn sie dich entdecken,
ist der Zugang erst einmal versperrt.
}
//	<<<ENGLISH>>>
//	If they spot you, you won't be able
//	to gain access for a while.

/*敵に発見されるとアクセスは一時的に
できなくなる。*/
大佐_005: {
Sei vorsichtig.
}
//	<<<ENGLISH(2)>>>
//	Stay on guard.

/*注意するんだ。*/
ライデン_006: {
Verstanden.
}
//	<<<ENGLISH(2)>>>
//	Got it.

/*了解。*/
}//d

resource P004_02_R01_ノード初接続２無線デモ１＿１__g {
//vc110401
大佐_000: {
Gut gemacht, Raiden.
}
//	<<<ENGLISH(2)>>>
//	Good work, Raiden.

/*ライデン、ノードにアクセスできた
ようだな。*/
ライデン_001: {
Funktioniert der Radar jetzt?
}
//	<<<ENGLISH>>>
//	The radar should be
//	functioning now?

/*これでレーダーが使える？*/
}//d

resource P004_02_R01_ノード初接続２無線デモ１＿２__g {
//vc110402
//タンカー編をやっている人
大佐_000: {
Denk' an Dein VR-Training.
}
//	<<<ENGLISH>>>
//	Remember your VR training sessions.

/*ＶＲ訓練を思い出せ。*/
大佐_001: {
Es ist genau das gleiche Instrument - es
zeigt das Gel&~ande und die gegnerischen
Stellungen.
}
//	<<<ENGLISH>>>
//	The tool is exactly the same one --
//	it maps the terrain as well as the
//	position of enemy personnel.

/*ものは同じだ。
地形と敵兵の位置が表示される。*/
}//d

resource P004_02_R01_ノード初接続２無線デモ１＿３__g {
//vc110403
//タンカー編をやっていない人
大佐_000: {
Zuerst werde ich Dir Das
Soliton-Radarsystem erkl&~aren.
}
//	<<<ENGLISH>>>
//	Let me explain about your
//	Soliton Radar system.

/*それではソリトン・レーダーの説明を
しよう。*/
大佐_001: {
Der helle Punkt in der Mitte bist Du,
Raiden.
}
//	<<<ENGLISH>>>
//	The bright dot in the
//	middle is you, Raiden.

/*中心の光点が……ライデン、君の位置だ。*/
大佐_002: {
Die roten Punkte sind Deine Feinde
und der blaue Kegel deren Sichtfeld.

}
//	<<<ENGLISH>>>
//	The red dots are your enemies
//	and the blue cone shape represents
//	their field of vision.

/*そして赤い光点が敵の位置。
蒼い円錐が敵の視界……。*/
大佐_003: {
Dein Radar wird nicht vom Wetter
beeintr&~achtigt,
}
//	<<<ENGLISH>>>
//	Your radar isn't
//	affected by the weather,

/*ソリトン・レーダーは気象には
影響されないが、*/
大佐_004: {
aber wenn der Feind Dich entdeckt,
kannst Du ihn nicht benutzen.
}
//	<<<ENGLISH>>>
//	but if you're discovered by
//	an enemy you won't be able
//	to use it.

/*敵に発見されると
使えなくなる。*/
大佐_005: {
Er wird leider schnell blockiert.
}
//	<<<ENGLISH>>>
//	It gets jammed easily I'm afraid.

/*うむ、簡単に妨害されてしまうのだ。*/
大佐_006: {
Er ist aktuelle Technologie.
}
//	<<<ENGLISH>>>
//	It's all made from currently
//	existing technology.

/*ソリトン・レーダーはもはや既存技術だ。*/
大佐_007: {
Du kannst ihn in Bereichen mit starker
harmonischer Resonanz nicht benutzen,
also Vorsicht.
}
//	<<<ENGLISH>>>
//	You won't be able to use it in
//	an area with strong harmonic
//	resonance. So be careful.

/*それと音響共鳴の強い空間でも
使えないから注意しろ。*/
}//d

//ムービー終り
resource P004_02_R01_ノード初接続２無線デモ１＿４__g {
//vc110404
大佐_000: {
Wenn du die START-Taste dr&~uckst,
m&~u&~ste die Layout-Karte der Big Shell
eingeblendet werden.
}
//	<<<ENGLISH>>>
//	The Big Shell's layout map should
//	now be available after touching
//	the START button.

/*『ビッグ・シェル』全体の構造マップは
ＳＴＡＲＴボタンでいつでも閲覧が
可能だ。*/
ライデン_001: {
Wie speichere ich die Einsatzdaten?
}
//	<<<ENGLISH>>>
//	How do I save the mission data?

/*潜入データの記録は？*/
大佐_002: {
Ich habe eine spezielle Frequenz daf&~ur
freigehalten. Eine Analystin wird die Daten
verarbeiten.
}
//	<<<ENGLISH>>>
//	I've set aside a proprietary
//	frequency for saves. And an
//	analyst to work on the data too.

/*セーブには専用回線を設けてある。
専用のアナリストもな。*/
}//d

resource P004_02_R01_ノード初接続２無線デモ１＿５__g {
//vc110405
ローズ_001: {
Jack - ist alles in Ordnung?
}
//	<<<ENGLISH>>>
//	Jack -- is everything
//	all right?

/*ジャック……大丈夫？*/
ライデン_002: {
Was machst Du denn hier!?
}
//	<<<ENGLISH>>>
//	What are you doing here!?

/*まさか！*/
ローズ_003: {
Jack, h&~orst Du mich?
}
//	<<<ENGLISH>>>
//	Jack, can you hear me?

/*ジャック、聞こえる？*/
ライデン_004: {
Rose! Du solltest Dich hier nicht
einmischen!
}
//	<<<ENGLISH>>>
//	Rose!
//	You're not supposed
//	to be involved!

/*ローズ！
どうして君が！！*/
ライデン_005: {
Was geht hier vor!?
}
//	<<<ENGLISH(2)>>>
//	What's going on!?

/*なぜ君がそこにいる！？*/
ローズ_006: {
Jack, ich bin an diesem Einsatz beteiligt.
}
//	<<<ENGLISH>>>
//	Jack, I'm a part
//	of this mission.

/*ああ、
ジャック……私も作戦に参加するの。*/
ライデン_007: {
Oberst, was zum Teufel geht hier vor?
}
//	<<<ENGLISH>>>
//	Colonel, what the hell
//	is going on?

/*どういう事だ？大佐！！*/
大佐_008: {
Darf ich vorstellen, die Analystin.
Sie wird die Daten &~uberwachen
und Dich unterst&~utzen.
}
//	<<<ENGLISH>>>
//	Raiden, meet the mission analyst.
//	She'll be overseeing the data
//	saving and support.

/*ライデン、彼女には今回のデータ記録と
サポートを担当して貰う。*/
ライデン_009: {
Warum sie?
}
//	<<<ENGLISH>>>
//	Why her?

/*なぜ彼女が？*/
大佐_010: {
Eigentlich sollte die FOXHOUND-Analystin
an diesem Einsatz teilnehmen.
}
//	<<<ENGLISH>>>
//	The FOXHOUND analyst that was
//	supposed to take part in this
//	mission was in an accident.

/*本作戦に従事する予定だった
ＦＯＸ　ＨＯＵＮＤ部隊のオペレーターが
事故にあい、参加できなくなった。*/
大佐_011: {
Aber sie hatte einen Unfall.
Rosemary ersetzt sie.
}
//	<<<ENGLISH(2)>>>
//	Rosemary was brought in
//	as a replacement.

/*それで急遽、
ローズマリー君が選ばれた……。*/
ライデン_012: {
Unfall?
}
//	<<<ENGLISH>>>
//	An accident...?

/*事故……？*/
大佐_013: {
Und den Akten zufolge, kennt sie Dich
besser als jeder andere.
}
//	<<<ENGLISH>>>
//	And according to the files, she
//	knows you better than anybody
//	else.

/*それに＃｛報告、レポート｝によると……
彼女は君を誰よりも知っている。*/
ライデン_014: {
Rose ist zwar Soldatin, aber der
Nachrichtenanalyst ist etwas anderes
als ein Stabsoffizier.
}
//	<<<ENGLISH>>>
//	Rose may be in the service,
//	but an intelligence analyst
//	is no field officer.

/*彼女は確かに軍人だが……
内勤のデータ・アナリストに過ぎない。*/
大佐_015: {
Keine Sorge. Unser technisches Personal
steht ihr zur Verf&~ugung.
}
//	<<<ENGLISH>>>
//	Not to worry.
//	She has our technical
//	staff at her disposal.

/*大丈夫だ。うちの専門スタッフが
オペレートする。*/
ライデン_016: {
Sie hat noch nie an einem Einsatz
teilgenommen. Das ist Wahnsinn.
}
//	<<<ENGLISH>>>
//	She's never been a part of a
//	field mission. This is insane.

/*実戦サポートなんて無理だ。
できっこない。*/
大佐_017: {
Ich habe meine Gr&~unde,
warum ich gerade sie gew&~ahlt habe.
}
//	<<<ENGLISH>>>
//	I have my own reasons for selecting
//	her for this mission, soldier.

/*彼女をこの作戦に参加させたのには、
それなりの理由がある。*/
ライデン_018: {
Oberst, ich verstehe nicht -
}
//	<<<ENGLISH>>>
//	Colonel, I fail to see --

/*大佐、俺には理解できない。*/
大佐_019: {
Ich kenne Deine Leistungen beim
VR-Training in- und auswendig. Aber
manchmal reicht das einfach nicht.
}
//	<<<ENGLISH>>>
//	I know your VR training performance
//	in and out. But sometimes that's not
//	enough.

/*私は君のＶＲ訓練の成績なら
よく知っている。
しかし、それ以上の事はわからない。*/
大佐_020: {
Du hast von Shadow Moses geh&~ort?
}
//	<<<ENGLISH(2)>>>
//	You're familiar with the
//	Shadow Moses incident?

/*シャドーモセスの事は知っているな？*/
ライデン_021: {
War Teil meines VR-Trainings.
}
//	<<<ENGLISH>>>
//	You know I covered it in VR.

/*ああ、事件のＶＲも体験した。*/
大佐_022: {
Wenn wir eine Lehre aus diesem Fall
gezogen haben, dann die,
}
//	<<<ENGLISH>>>
//	If there's a crucial tactical
//	detail that case taught us,

/*あの事件で立証された。*/
//<ページ数変更>
大佐_022_1: {
da&~s der &~Uberlebenswille Unm&~ogliches
m&~oglich macht.
}
//	<<<ENGLISH>>>
//	it was the power of the operative's
//	will to survive.

/*兵士の士気を持続させる要素……。*/
ライデン_023: {
Ich wurde zum K&~ampfen ausgebildet.
Meine Gef&~uhle spielen beim Einsatz
keine Rolle.
}
//	<<<ENGLISH>>>
//	I was trained to fight. My personal
//	feelings have no place in a mission.

/*俺は軍人として訓練されて来た。
己の感情には左右されない。*/
大佐_024: {
Die Erfahrung hat uns etwas anderes
gelehrt. Im Feld braucht man jede Hilfe,
die man bekommen kann.
}
//	<<<ENGLISH>>>
//	We've learned that it doesn't work
//	that way. And on the field, you need
//	all the help you can get.

/*そうはいかない。
本作戦に失敗は許されんのだ。*/
ローズ_025: {
Jack? Ich mache mit,
ob es Dir pa&~st oder nicht.
}
//	<<<ENGLISH>>>
//	Jack? You're stuck with me
//	whether you like it or not.

/*ジャック？
いい、私は最後まであなたにつき合う。*/
ライデン_026: {
Rose.
}
//	<<<ENGLISH(2)>>>
//	Rose...

/*ローズ？*/
ローズ_027: {
Du brauchst jemanden,
der Deinen R&~ucken deckt. Aber -
}
//	<<<ENGLISH>>>
//	You need someone to watch
//	your back. But＃−

/*あなたが心配だから……ただし。*/
ローズ_028: {
Ich stelle Bedingungen, Oberst.
}
//	<<<ENGLISH>>>
//	I have conditions that
//	need to be met, Colonel.

/*条件がある、大佐。*/
大佐_029: {
Die w&~aren?
}
//	<<<ENGLISH(2)>>>
//	What is it?

/*なんだ？*/
ローズ_030: {
Ich tue meine Arbeit
und speichere die Einsatzdaten.
}
//	<<<ENGLISH>>>
//	I'll perform my duties and
//	save that mission data.

/*私はこの作戦の＃｛記録、セーブ｝＃を行う。*/
//<ページ数変更>
ローズ_030_1: {
Aber technisch gesehen geh&~ore ich nicht
zum Einsatzkontrolltrupp.
}
//	<<<ENGLISH>>>
//	But I'm aware that technically,
//	I'm not part of the mission control
//	team.

/*でも、私は作戦の一部じゃない。*/
ローズ_031: {
Schlie&~slich bin ich nur ein einfaches
M&~adchen, das sich Sorgen macht.
}
//	<<<ENGLISH>>>
//	After all, I'm just a normal
//	girl who's worried about Jack.

/*ジャックを案じる普通の女……*/

//<ページ数変更>
ローズ_031_1: {
Das hei&~st aber auch, da&~s ich
Ihren Befehlen au&~serhalb meines
Aufgabenbereichs nicht Folge leisten mu&~s.
}
//	<<<ENGLISH>>>
//	But that means, Colonel, that I am
//	not required to follow your orders
//	outside of my immediate duties.

/*だから、
それ以外は大佐達の強制は受けない。*/
ローズ_032: {
F&~ur mich ist Jack nicht irgendein Soldat,
den ich beobachte.
}
//	<<<ENGLISH>>>
//	Jack is not simply a field
//	personnel for me to track.
//<ページ数変更>
/*私にとって、彼は恋人、
ジャックでしかない。*/
ローズ_032_1: {
Seine Sicherheit hat Vorrang,
nicht der Einsatz.
}
//	<<<ENGLISH>>>
//	His safety comes first
//	to me, not the mission.

/*彼の安否が最優先……。*/
ローズ_033: {
Und darum werde ich den gesamten
Funkverkehr
}
//	<<<ENGLISH>>>
//	And because of that,
//	I will be monitoring...
//<ページ数変更>
ローズ_033_1: {
mit Jack &~uberwachen und aufzeichnen,
Oberst.
}
//	<<<ENGLISH>>>
//	and keeping a record of every
//	communication you have with
//	him, Colonel.

/*だから、大佐との交信内容も傍聴する。
いえ、記録する。*/
大佐_034: {
Unter den gegebenen Umst&~anden kannst
Du tun, was Du f&~ur richtig h&~altst.
}
//	<<<ENGLISH>>>
//	... Given the circumstances,
//	you're free to do what you
//	see fit.

/*……わかった。好きにするがいい。*/
ローズ_035: {
Mir ist das lieber als
Ungewi&~sheit und Abwarten.
}
//	<<<ENGLISH>>>
//	Hey, I prefer this to being
//	kept in the dark, waiting.

/*考えようによっては……
この方がいいかも。何も知らされず、
待つだけなんて辛いだけだもの。*/
大佐_036: {
Eine Bitte.
}
//	<<<ENGLISH>>>
//	I'd like to make a request,
//	if I may.

/*一つだけいいか？*/
ローズ_037: {
Nat&~urlich.
}
//	<<<ENGLISH(2)>>>
//	Of course.

/*何？*/
大佐_038: {
Sein Name ist Raiden. K&~onntest Du ihn
f&~ur die Dauer des Einsatzes so nennen?
}
//	<<<ENGLISH>>>
//	His handle is Raiden. For the
//	duration of the mission, could
//	you call him that?

/*彼の名はライデンだ。
作戦遂行中はコードネームで呼んでくれ。*/
ローズ_039: {
Jawohl.
}
//	<<<ENGLISH(2)>>>
//	Yes sir.

/*わかったわ。*/
ローズ_040: {
Okay, Raiden.
}
//	<<<ENGLISH>>>
//	All right -- Raiden.

/*じゃあ、ライデン？*/
ローズ_041: {
Sag Bescheid, wenn Du speichern willst.
}
//	<<<ENGLISH(2)>>>
//	Let me know when you're
//	ready to turn in a save.

/*潜入データを記録したい時は
私に連絡して。*/
ローズ_042: {
Die spezielle Speicherfrequenz
lautet 140,96.
}
//	<<<ENGLISH>>>
//	The proprietary save frequency
//	is 140.96.

/*周波数は１４０．９６……
＃｛記録、セーブ｝＃用の専用回線よ。*/
}//d

resource P004_02_R01_ノード初接続２無線デモ１＿６__g {
//vc110406
ローズ_000: {
Ich habe soeben die Frequenz ge&~andert.
}
//	<<<ENGLISH>>>
//	I just switched frequencies.

/*今、周波数を変えたわ。*/
ローズ_001: {
Jack?
}
//	<<<ENGLISH(2)>>>
//	Jack?

/*ジャック？*/
ライデン_002: {
Ja?
}
//	<<<ENGLISH(2)>>>
//	What?

/*なんだ？*/
ローズ_003: {
Wei&~st Du, was morgen f&~ur ein Tag ist?
}
//	<<<ENGLISH>>>
//	Do you know what day
//	it is tomorrow?

/*明日、何の日か知ってる？*/
ライデン_004: {
Der 30. April - was ist damit?
}
//	<<<ENGLISH>>>
//	April 30th -- is there something
//	special about it?

/*４月３０日……いや、わからない。*/
ローズ_005: {
Wei&~st Du's nicht?
}
//	<<<ENGLISH>>>
//	Isn't there?

/*ほんとに？*/
ライデン_006: {
Tut mir leid,
ich kann mich nicht erinnern.
}
//	<<<ENGLISH>>>
//	I can't remember.
//	I'm sorry.

/*いや、悪いが思い出せない。*/
ローズ_007: {
Na, ich werde es versuchen,
bis ich die Antwort h&~ore.
}
//	<<<ENGLISH>>>
//	Oh well, I'll keep trying
//	'til I hear the answer.

/*その答えを聞くまではがんばるわ。*/
ローズ_008: {
Ich mache jetzt Schlu&~s, Jack.
Pa&~s auf Dich auf.
}
//	<<<ENGLISH>>>
//	I'm going to let you go now, Jack.
//	Take care.

/*それじゃ、ジャック。がんばってね。*/
}//d

resource P005_03_R01ライデン昇降機上昇３無線デモ１＿１__g {
//vc110501
ライデン_000: {
Oberst, ich bin auf dem Dach. Hier sind
keine Posten, aber bei dem Licht hier
w&~urde einer ausreichen.
}
//	<<<ENGLISH>>>
//	Colonel, I'm on the roof. There are
//	no sentries, but it would only take
//	one to spot me in this light.

/*大佐、『ビッグ・シェル』の屋上に出た。
敵兵は見あたらないが見通しが良すぎる。*/
大佐_001: {
Ein VR-Training bei Tageslicht hast Du
auch nie gehabt.
}
//	<<<ENGLISH>>>
//	You never had daylight
//	VR training, after all.

/*夜間潜入の訓練しかしていなかったな。*/
大佐_002: {
Sei besonders vorsichtig, bis Du einen
Node findest, auf dem Du Dich anmelden
kannst.
}
//	<<<ENGLISH>>>
//	Stay extra sharp until you can
//	find a node to log in from.

/*ノードにアクセスするまでは、
警戒していくしかない。*/
ライデン_003: {
Was ist mit den Truppen?
}
//	<<<ENGLISH>>>
//	What about the commandos?

/*突入部隊はどうなった？*/
大佐_004: {
SEAL-Trupp 10 ist auf den Streben B
und C gelandet.
}
//	<<<ENGLISH>>>
//	SEAL Team 10 has landed
//	on Struts B and C.

/*ＳＥＡＬ１０はＢ脚、Ｃ脚に降下した。*/
ライデン_005: {
Und der Pr&~asident?
}
//	<<<ENGLISH>>>
//	And the President?

/*大統領は？*/
大佐_006: {
Wurde anscheinend auf Strebe B
gesehen.
}
//	<<<ENGLISH>>>
//	Seems he was spotted
//	on Strut B.

/*Ｂ脚で発見されたらしい。*/
ライデン_007: {
Strebe B?
}
//	<<<ENGLISH>>>
//	Strut B?

/*Ｂ脚？*/
}//d


resource P005_05_R02_ライデン昇降機上昇５無線デモ２__g {
//vc110511
大佐_000: {
Finde zuerst einen Node und melde Dich
im Netzwerk an.
}
//	<<<ENGLISH>>>
//	First, get to a node.
//	Log into the network.

/*まずはノードを探してみろ。
ノードにアクセスすればわかる。*/
ライデン_001: {
Verstanden.
}
//	<<<ENGLISH(2)>>>
//	Got it.

/*了解。*/
}//d



resource P006_01_R01_Ａ脚金網１無線デモ１__g {
//vc110601
大佐_000: {
Raiden, SEAL-Trupp 10 ist gelandet.
}
//	<<<ENGLISH>>>
//	Raiden, SEAL Team 10 is in.

/*ライデン、ＳＥＡＬ・チーム１０が
突入を開始した。*/
ライデン_001: {
Haben wir wirklich keinen Funkkontakt
zu den SEALS?
}
//	<<<ENGLISH>>>
//	Do we really have no line of
//	communication with the SEALs?

/*ＦＯＸＨＯＵＮＤとＳＥＡＬの
コンセサンスは本当にないのか？*/
大佐_002: {
Sie wissen ja nicht, da&~s wir da sind.
Du wei&~st doch: Wir arbeiten verdeckt,
auch bei diesem Einsatz.
}
//	<<<ENGLISH>>>
//	They don't know a thing about us.
//	You know we work in the dark,
//	and this mission is no exception.

/*先方は我々の事を何も知らない。
我々は隠密組織だ。任務も機密事項。
*/
//<ページ数変更>
大佐_002_1: {
Nur wenige Menschen wissen,
da&~s Du hier bist.
}
//	<<<ENGLISH>>>
//	Only a few people know
//	about your presence here.

/*君の潜入を知る者は極少数だ。*/
ライデン_003:
''
//	<<<ENGLISH(2)>>>
//

/*……。*/
大佐_004: {
Keine Sorge. Dieser Einsatz wird direkt
vom Pentagon befehligt,
}
//	<<<ENGLISH(2)>>>
//	There's no need for concern.
//	This operation is under Pentagon's
//	direct command,

/*今回の作戦は＃｛国防総省、ペンタゴン｝＃が直接指揮を
取っている。*/
//<ページ数変更>
大佐_004_1: {
und die NSDD (Entscheidung zur
nationalen Sicherheit) kam vom
Vizepr&~asidenten
}
//	<<<ENGLISH>>>
//	and the NSDD (National Security
//	Decision Directives) came from
//	the Vice President＃−

大佐_004_2: {
und dem Verteidigungsminister.
}
//	<<<ENGLISH>>>
//	and the Secretary of Defense.

/*＃｛国家安全保障決定命令、ＮＳＤＤ｝＃も
副大統領と国防省長官によって行われた。*/
大佐_005: {
Dein Einsatz mag ja streng geheim sein,
aber trotzdem kam der Befehl auf dem
normalen Weg.
}
//	<<<ENGLISH>>>
//	Your mission may be top-secret,
//	but it's gone through the usual
//	channels.

/*君の任務は極秘だが正規の手続きに
基づいているんだ。心配するな。*/
}//d


resource P007_01_R01_Ａ脚ノード前１無線デモ１＿１__g {
//vc110701
ライデン_000: {
Oberst, ich habe den Node gefunden,
aber er wird streng bewacht. Ich komme
nicht n&~aher ran.
}
//	<<<ENGLISH>>>
//	Colonel, I've located the node,
//	but it's under heavy surveillance.
//	I can't get in any closer.

/*大佐、ノードを発見したが、
敵が陣取っていて近づけない。*/
大佐_001: {
Lenke sie ab. Versuche,
ihre Aufmerksamkeit durch ein Ger&~ausch
auf etwas anderes zu lenken.
}
//	<<<ENGLISH>>>
//	Distract them. Try making some
//	noise to draw their attention away.

/*敵をおびき寄せるんだ。
音を立ててみろ。*/
ライデン_002: {
Wie?
}
//	<<<ENGLISH(2)>>>
//	How?

/*どうやって？*/
大佐_003: {
Dr&~ucke Dich flach gegen eine Wand und
dr&~ucke die Schlagtaste.
}
//	<<<ENGLISH>>>
//	Flatten yourself against a wall
//	and hit the Punch button.

/*壁にはりついて、＃｛○、パンチ｝＃ボタンだ。*/
}

//小画面に映像。同じシーンで物音を立てるライデン。
resource P007_01_R01_Ａ脚ノード前１無線デモ１＿２__g {
//vc110702
ライデン_001: {
Verstanden.
}
//	<<<ENGLISH(2)>>>
//	Got it.

/*わかった。*/
}//d


resource P008_01_R01_ＡＢ連絡橋１無線デモ１＿１__g {
//vc110801
大佐_000: {
Aufgepa&~st, Raiden. An der
Verbindungsbr&~ucke stehen Posten.
}
//	<<<ENGLISH>>>
//	Raiden, watch out. There are
//	sentries posted on the connecting
//	bridge.

/*ライデン、気をつけろ。
連絡橋の中央に見張りがいる。*/
//<ページ数変更>
大佐_000_1: {
Wenn Du so weitergehst,
wirst Du entdeckt.
}
//	<<<ENGLISH>>>
//	They will spot you if you
//	continue on course.

/*そのまま進めば発見されるぞ。*/
ライデン_001: {
Was soll ich tun?
}
//	<<<ENGLISH>>>
//	Any recommendations?

/*どうすれば？*/
大佐_002: {
Hangle.
}
//	<<<ENGLISH>>>
//	Use the Hanging mode.

/*＃｛ぶら下がり、エルード｝＃を使うんだ。*/
ライデン_003: {
Hangeln?
}
//	<<<ENGLISH>>>
//	Hanging?

/*エルード？*/
}//d

resource P008_01_R01_ＡＢ連絡橋１無線デモ１＿２__g {
//vc110802
大佐_000: {
Drehe Dich zu einer h&~ufthohen Reling und
dr&~ucke die Aktionstaste. So springst Du
&~uber die Reling und h&~angst an der Seite
runter.
}
//	<<<ENGLISH>>>
//	Face any waist-high railing and
//	push the Action button to clear
//	the railing and hang over the side.

/*腰くらいの高さの手すりに向かって
＃｛△、アクション｝＃ボタンを押すと、手すりを乗り越えて
向こう側にぶら下がることが出来る。*/
大佐_001: {
Bewege Dich seitw&~arts,
so da&~s der Gegner Dich nicht sieht.
}
//	<<<ENGLISH>>>
//	Once there, you can move sideways
//	while keeping out of enemy sight.

/*そのまま移動すれば敵に見つからずに
進めるはずだ。*/
ライデン_002: {
In Ordnung, ich versuch's.
}
//	<<<ENGLISH>>>
//	All right, I'm giving it a try.

/*わかった、やってみる。*/
大佐_003: {
Beachte die GRIP-Anzeige.
Sie nimmt bei einem Hangelman&~over ab.
}
//	<<<ENGLISH>>>
//	Don't forget the Grip Gauge.
//	It will keep decreasing during
//	a Hanging maneuver,

/*＃｛握力、ＧＲＩＰ｝＃ゲージを忘れるな。
エルードしている間、時間と共に
減っていく。
*/
大佐_004: {
Wenn Du keine Griffkraft mehr hast,
st&~urzt Du ab.
}
//	<<<ENGLISH>>>
//	and once it runs out,
//	you will fall.

/*ゲージがなくなると落下してしまうぞ。*/
}//d

resource P008_01_R01_ＡＢ連絡橋１無線デモ１＿３__g {
//vc110803
ライデン_000: {
Verstanden.
}
//	<<<ENGLISH(2)>>>
//	Copy that.

/*了解。*/
}//d

resource P008_01_R01_ＡＢ連絡橋１無線デモ１＿ＳＥＡＬＳ無線傍受__g {
//vcxxxxxxxx
大佐_000: {
Einen Augenblick, ich habe soeben neue
Nachrichten vom Einsatz des SEAL-Trupps
10 abgeh&~ort.
}
//	<<<ENGLISH>>>
//	Wait a second, I just intercepted
//	new intelligence on the operation
//	being executed by SEAL Team 10.

/*まて、ライデン。
今、ＳＥＡＬ１０突入部隊の無線を
傍受した。*/
ライデン_001: {
Abgeh&~ort?
}
//	<<<ENGLISH>>>
//	Intercepted?

/*傍受？*/
大佐_002: {
Wie gesagt, sie d&~urfen nichts von unserer
Pr&~asenz hier erfahren.
}
//	<<<ENGLISH>>>
//	As I said before, they need to be
//	kept in the dark about our presence.

/*もう一度言うが、彼らは我々の存在を
知らない。*/
ライデン_003: {
Also h&~oren wir einfach zu.
}
//	<<<ENGLISH>>>
//	So we just listen in...

/*盗み聞きってわけか。*/
大佐_004: {
Ich gebe es durch.
}
//	<<<ENGLISH>>>
//	I'm patching it through.

/*そっちへ繋ぐ……。*/
//画面にはＳＥＡＬＳの顔は表示されない。画面はライデンと大佐。

シールズ_005: {
Hier Alpha Zero.
Wir haben den Pr&~asidenten.
}
//	<<<ENGLISH>>>
//	This is Alpha Zero.
//	We have the President.

/*こちらアルファー・ゼロ。
大統領を確保……。*/
シールズ隊長_006: {
Ist er in Sicherheit?
}
//	<<<ENGLISH>>>
//	Is he safe?

/*無事か！*/
シールズ_007: {
Er ist in Sicherheit.
}
//	<<<ENGLISH(2)>>>
//	He is safe.

/*無事です。*/
シールズ隊長_008: {
Was ist mit dem Paket?
}
//	<<<ENGLISH(2)>>>
//	What about the package?

/*パッケージは？*/
シールズ_009: {
Sag den Typen oben, da&~s wir das Paket
gesichert haben. Kinderspiel!
}
//	<<<ENGLISH>>>
//	Tell the guys upstairs that
//	we've secured the package.
//	Easy money.

/*海軍大佐共々、保護しました。
楽勝でしたよ……。*/
シールズ隊長_010: {
Gute Arbeit. Ihr werdet gleich abgeholt.
Kommt zur&~uck.
}
//	<<<ENGLISH>>>
//	Good work. Your retrieval is
//	on the way. Come on home...

/*よし、ヘリを回す。脱出してくれ……。*/
シールズ_011: {
Aus und Ende -
}
//	<<<ENGLISH(2)>>>
//	Roger that...

シールズ_011_1: {
Aaahhh!
}
//	<<<ENGLISH>>>
//	H-holy!

/*了解……な、なんだ！？*/
//銃声！！無線にノイズが！！
シールズ隊長_012: {
Alpha Zero! Erstatte Bericht!!
}
//	<<<ENGLISH>>>
//	Alpha Zero! Report!!

/*どうした！！*/
シールズ_013: {
Verdammt!
Deck den Pr&~asidenten!!
}
//	<<<ENGLISH>>>
//	Dammit!
//	Cover the President!!

/*くっ！大統領を守れ！！*/
シールズ隊長_014: {
Alpha Zero kommen!
}
//	<<<ENGLISH>>>
//	Come in, Alpha Zero!

/*アルファ・ゼロ！*/
シールズ_015: {
Hier Alpha Zero.
Wir werden angegriffen!
}
//	<<<ENGLISH>>>
//	This is Alpha Zero.
//	We are under attack!

/*こちらアルファ・ゼロ。敵と遭遇！！*/
シールズ_016: {
Das ist doch verr&~uckt!
Ist das!?
}
//	<<<ENGLISH>>>
//	This is crazy!
//	Is that...!?

/*馬鹿な！あれが！？*/
シールズ隊長_017: {
Alpha Zero, antworte!
}
//	<<<ENGLISH>>>
//	Alpha Zero, respond!

/*どうしたアルファ・ゼロ！*/
シールズ_018:
''
//	<<<ENGLISH>>>
//	.

/*……。*/
シールズ隊長_019: {
An alle in Alpha, antwortet!
}
//	<<<ENGLISH>>>
//	All Alpha, respond!

/*オール・アルファ、応答せよ！！*/

//無線通じなくなる

大佐_020: {
Raiden, der Pr&~asident ist in Lebensgefahr!
Begib Dich jetzt zu Strebe B!
}
//	<<<ENGLISH>>>
//	Raiden, the President's life is
//	in danger! Head to Strut B now!

/*ライデン、大統領の身が危ない！
Ｂ脚に急いでくれ！*/
}//d



resource P009_01_R01_サイファー遭遇１無線デモ１＿１__g {
//vc110901
大佐_000: {
Raiden, Deine Deckung! Ein Cypher,
eine Art unbemanntes Flugger&~at!
}
//	<<<ENGLISH>>>
//	Raiden, watch your back!
//	That's a Cypher, a type of UAV!

/*ライデン、気をつけろ！
それはサイファー。
＃｛無人偵察機、ＵＡＶ｝＃の一種だ！*/
}//d

resource P009_01_R01_サイファー遭遇１無線デモ１＿２__g {
//vc110902
大佐_000: {
Wenn er Dich entdeckt, alarmiert
er den Feind. Sei &~au&~serst vorsichtig!
}
//	<<<ENGLISH>>>
//	If it spots you, it will alert
//	enemy personnel. Exercise
//	extreme caution.

/*見つかると敵を呼ばれるぞ。
注意しろ。*/
大佐_001: {
Erzeuge mit D&~uppeln ein St&~orfeld.
Damit werden seine Sensoren erst
einmal au&~ser Gefecht gesetzt.
}
//	<<<ENGLISH>>>
//	But you can use chaff to set up
//	an interference field. That'll knock
//	its sensors offline for a while.

/*だがチャフを使って電子妨害を行えば
無力化出来る。*/
//<ページ数変更>
大佐_001_1: {
Versuche, D&~uppel zu finden.
}
//	<<<ENGLISH>>>
//	Try to locate some chaff.

/*チャフを探せ！*/
大佐_002: {
Du kannst auch den Motor oder die
Kamera zerst&~oren. Einige Flugger&~ate
k&~onnten bewaffnet sein.
}
//	<<<ENGLISH>>>
//	You can also destroy the engine or
//	the camera. Some of the UAV's may
//	be armed -- be careful.

/*あるいはエンジンか、カメラ部分を
破壊するんだ。武装したタイプも
あるかもしれん。気を付けろ。*/
}//d


resource P010_04_R01_ヴァンプ遭遇４無線デモ１＿１__g {
//vc111001
大佐_000: {
Was ist mit dem Pr&~asidenten?
}
//	<<<ENGLISH(2)>>>
//	What about the President?

/*大統領は？*/
ライデン_001: {
Sie haben ihn wohl woanders
hingebracht.
}
//	<<<ENGLISH>>>
//	Looks like they took him
//	somewhere else...

/*連れ去られたようだ……。*/
大佐_002: {
Du sagtest, es gab einen &~Uberlebenden
beim SEAL-Trupp 10?
}
//	<<<ENGLISH>>>
//	I see... You said there was a
//	survivor from SEAL Team 10?

/*そうか……ＳＥＡＬ１０に生き残りが
いると言ったな。*/
ライデン_003: {
Ja, Leutnant Pliskin.
}
//	<<<ENGLISH>>>
//	Yeah.
//	Lieutenant J.G. Pliskin.

/*ああ。プリスキン中尉だ。*/
大佐_004: {
Hat er Dein Gesicht gesehen?
}
//	<<<ENGLISH>>>
//	Has he seen your face?

/*……顔を見られたか？*/
ライデン_005: {
Was?
}
//	<<<ENGLISH(2)>>>
//	What?

/*なんだって？*/
大佐_006: {
Dieser Auftrag ist top - secret.
Niemand darf wissen, da&~s wir
beteiligt sind.
}
//	<<<ENGLISH>>>
//	This is a top-secret mission.
//	No one can know that we're
//	involved.

/*隠密行動だ。誰にも悟られてはならん。*/
ライデン_007: {
Daf&~ur ist es etwas zu sp&~at.
}
//	<<<ENGLISH>>>
//	It's a little too late for that.

/*……もう手遅れだ。*/
}//d



resource P011_01_R01_ＢＣ連絡橋ＣＡＬＬ１無線デモ１＿１__g {
//vc111101
ローズ_000: {
Jack, ich bin's.
}
//	<<<ENGLISH>>>
//	Jack, it's me...

/*ジャック、私……。*/
ライデン_001: {
Alles in Ordnung, Rose?
}
//	<<<ENGLISH>>>
//	Everything okay, Rose?

/*どうした？
ローズ？*/
ローズ_002: {
Solltest Du nicht die Einsatzdaten
speichern?
}
//	<<<ENGLISH>>>
//	Don't you need to save
//	the mission data?

/*潜入データの＃｛記録、セーブ｝＃はいいの？*/
ライデン_003: {
Ach ja, danke, da&~s Du mich erinnerst.
}
//	<<<ENGLISH>>>
//	Oh yeah -- thanks for the reminder.

/*ああ、そうだな……頼むよ。*/
}//d

resource P011_01_R01_ＢＣ連絡橋ＣＡＬＬ１無線デモ１＿２__g {
//vc111102
ローズ_000: {
Jack, wei&~st Du inzwischen,
welcher Tag morgen ist?
}
//	<<<ENGLISH>>>
//	Jack, do you remember
//	what day tomorrow is?

/*ジャック、明日、何の日だかわかった？*/
ライデン_001: {
Schon wieder.
}
//	<<<ENGLISH(2)>>>
//	That again...

/*またか……。*/
ライデン_002: {
Tut mir leid, ich habe noch
immer keine Ahnung.
}
//	<<<ENGLISH>>>
//	I'm sorry, but I still
//	don't have a clue.

/*悪いが思い出せない。*/
ローズ_003: {
Schon gut.
}
//	<<<ENGLISH(2)>>>
//	That's okay.

/*そう……。*/
ライデン_004: {
Was ist denn morgen?
Sag's mir doch.
}
//	<<<ENGLISH>>>
//	What is it, Rose?
//	Talk to me.

/*何があるんだ？*/
ローズ_005: {
Mir w&~ar's lieber, Du k&~amst selbst drauf.
Es ist wichtig.
}
//	<<<ENGLISH>>>
//	I'd rather you figure it out.
//	It's important.

/*いいの、あなたが思い出して？
話があるの。*/
ライデン_006: {
Wie wichtig?
}
//	<<<ENGLISH>>>
//	How important?

/*話？*/
ローズ_007: {
Ziemlich wichtig.
Wir sprechen morgen dar&~uber.
}
//	<<<ENGLISH>>>
//	Important enough.
//	And we'll talk about it,
//	tomorrow.

/*そう、重要な話。
それも明日、話したい。*/
ライデン_008: {
Warum nicht jetzt?
}
//	<<<ENGLISH>>>
//	Why not now?

/*今じゃダメなのか？*/
ローズ_009: {
Morgen erscheint mir - passender.
Ich brauche ohnehin jede Hilfe,
damit ich nicht kneife.
}
//	<<<ENGLISH>>>
//	Tomorrow seems more -- appropriate.
//	I need all the help I can get so that
//	I won't chicken out anyway.

/*ええ、明日がいい。
勇気がいるの。*/
ライデン_010: {
Wolltest Du deshalb an diesem Einsatz
teilnehmen?
}
//	<<<ENGLISH>>>
//	Is that the reason you decided
//	to be part of this mission?

/*まさか、その為にこの作戦に？*/
ローズ_011:
''
//	<<<ENGLISH>>>
//	...

/*……。*/
ライデン_012: {
OK, Ich bin bis morgen mit dieser
Sache fertig, komme was wolle.
}
//	<<<ENGLISH>>>
//	OK... I'm going to finish this
//	thing by tomorrow, no matter what.

/*わかった。
明日までにはなんとか任務を完了させる。*/
ローズ_013: {
Du wei&~st, da&~s ich Dir in jeder
Weise helfen werde.
}
//	<<<ENGLISH>>>
//	You know I'll do everything
//	I can to help you.

/*がんばって……。*/
ライデン_014: {
Rose, Du mu&~st etwas f&~ur mich tun,
Du als Analystin.
}
//	<<<ENGLISH>>>
//	Rose, there's something I need
//	you to do as an analyst.

/*ローズ、データ・アナリストとして、
調べてもらいたい事がある。*/
ローズ_015: {
Und das w&~are?
}
//	<<<ENGLISH(2)>>>
//	What is it?

/*なに？*/
ライデン_016: {
Es hat mit Solid Snake zu tun.
}
//	<<<ENGLISH>>>
//	It has to do with Solid Snake.

/*ソリッド・スネークの事だ。*/
//<ページ数変更>
ライデン_016_1: {
Der Anf&~uhrer dieses Coups behauptet,
er sei Snake.
}
//	<<<ENGLISH>>>
//	The leader of this takeover
//	incident is claiming that he's
//	Snake himself.

/*今回のテロリストの＃｛首領、ボス｝＃が
そう名乗ってる。
*/
ローズ_017: {
Der legend&~are S&~oldner?
Hm.
}
//	<<<ENGLISH>>>
//	The legendary mercenary?
//	Hm.

/*伝説の傭兵ね。*/
ライデン_018: {
Ich brauche alle Informationen &~uber ihn,
an die Du rankommst. Alles, was nach
Shadow Moses &~uber ihn bekannt ist.
}
//	<<<ENGLISH>>>
//	I need as much data on him as
//	possible. Everything they have on
//	him after the Shadow Moses incident.

/*彼の詳細データが欲しい。
シャドーモセス事件の後、
どうなったか……。*/
ローズ_019: {
Er ist doch tot, oder?
}
//	<<<ENGLISH>>>
//	He's dead now, isn't he?

/*もう亡くなってるんでしょ？*/
ライデン_020: {
Ja.
Es m&~u&~ste auch Unterlagen &~uber
seine Beerdigung geben.
}
//	<<<ENGLISH>>>
//	Yes.
//	Should be a burial record
//	somewhere too.

/*ああ。遺体がどこかに
埋葬されているはずだ。*/
ライデン_021: {
Der Oberst gibt Dir bestimmt die Erlaubnis,
}
//	<<<ENGLISH>>>
//	You should be able to request
//	top-level security clearance
//	from the Colonel.

/*大佐に頼めば、最高度のセキュリティ・
クリアランスが貰えるはず。*/
//<ページ数変更>
ライデン_021_1: {
streng geheime Dokumente einzusehen.
}
//	<<<ENGLISH>>>
//	That should get us into the
//	most classified material.

/*どんな極秘ファイルにも近づける。
*/
ローズ_022: {
Ich mach mich sofort an die Arbeit.
}
//	<<<ENGLISH(2)>>>
//	I'm on it.

/*わかったわ。
調べてみる……。*/
ローズ_023: {
Ich melde mich, sobald ich etwas
herausfinde.
}
//	<<<ENGLISH>>>
//	I'll contact you as soon
//	as I find out something.

/*何かわかったら、＃｛ＣＡＬＬ、コール｝＃するわ。*/
}//d




resource P012_02_R01_フォーチュン遭遇２無線デモ１＿１__g {
//vc111201
ライデン_000: {
Oberst, der Bravo-Trupp von
SEAL-Trupp 10 wurde ausgel&~oscht.
}
//	<<<ENGLISH>>>
//	Colonel, SEAL Team 10's
//	Bravo team was wiped out.

/*大佐、ＳＥＡＬ１０ブラボー・チームが
全滅した……。*/
大佐_001: {
Verstehe.
}
//	<<<ENGLISH>>>
//	I see.

/*そうか……。*/
ライデン_002: {
Was ist mit den Frachthubschraubern?
}
//	<<<ENGLISH>>>
//	What happened to the cargo
//	choppers?

/*……突入したヘリはどうなった？*/
大佐_003: {
Liegen beide im Hafenbecken. Wie es
scheint, haben Deine neuen Gastgeber
eine Harrier 2.
}
//	<<<ENGLISH>>>
//	Both of them are at the bottom of
//	the harbor. Looks like your new
//	hosts have a Harrier 2.

/*……２機共、マンハッタン湾に沈んだ。
奴等はハリアー２を所持しているようだ。*/
ライデン_004: {
Eine Harrier?
Was ist das?
}
//	<<<ENGLISH>>>
//	A Harrier?
//	What is this?

/*馬鹿な！ハリアーだって？*/
大佐_005: {
Nur, da&~s sie den Angriff
vorausgesehen haben.
}
//	<<<ENGLISH>>>
//	Calm down. It just means
//	they anticipated the attack.

/*うろたえるな。
予想されたことだ。*/
ライデン_006: {
Was?
}
//	<<<ENGLISH>>>
//	What?

/*なに？*/
大佐_007: {
Und da die SEALS das Feuer abbekamen,
konntest Du ungest&~ort eindringen.
}
//	<<<ENGLISH>>>
//	Besides, since the SEALs drew
//	their fire, your infiltration
//	went off without a hitch.

/*彼らがデッドセルを引き付けてくれた
お陰で君の潜入は成功し、*/
//<ページ数変更>
大佐_007_1: {
Au&~serdem kennen wir ihre
Verteidigungsf&~ahigkeit.
}
//	<<<ENGLISH>>>
//	On top of that, we know their
//	defensive capabilities.

/*敵の戦力も
把握できた……。*/
ライデン_008: {
Das Ganze war nur ein
T&~auschungsman&~over?
}
//	<<<ENGLISH>>>
//	Are you saying that
//	this was all a feint?

/*全て＃｛陽動作戦、フェイント・オペレーション｝＃だったって言うのか！？*/
大佐_009: {
Raiden, rei&~s' Dich zusammen.
Der gesamte Einsatz liegt jetzt
in Deinen H&~anden, verstanden?
}
//	<<<ENGLISH>>>
//	Raiden, get a hold of yourself.
//	The entire mission is in your
//	hands now, do you understand?

/*ライデン、落ち着くんだ。
これより任務は全て君独りに
託されるんだぞ。*/
ライデン_010: {
Aber.
}
//	<<<ENGLISH>>>
//	But...

/*しかし……。*/
大佐_011: {
Keine Zeit f&~ur Fragen. Sie k&~onnten
den fehlgeschlagenen Angriff r&~achen.
}
//	<<<ENGLISH>>>
//	There's no time for questions.
//	They could decide to retaliate
//	for that failed assault.

/*迷っている暇はない。
奴等が突入の報復を行うことが
考えられる。*/
ライデン_012: {
Du meinst die Geiseln?
}
//	<<<ENGLISH>>>
//	You mean the hostages?

/*……人質の命が危ないと？*/
大佐_013: {
Sie k&~onnten in Gefahr sein, richtig.
Aber sie k&~onnten auch die gesamte
Shell in die Luft jagen.
}
//	<<<ENGLISH>>>
//	They could be in danger, yes. But
//	we need to consider the possibility
//	that they'll blow the whole Shell.

/*それもある。だが同様に警戒すべき
なのは『ビッグ・シェル』が爆破される
可能性だ。*/
大佐_014: {
Wenn sich das Gift ausbreitet,
verseucht es nicht nur den Hafen,
}
//	<<<ENGLISH>>>
//	If that toxic spill does take place,
//	it'll devastate not only the harbor,

/*爆破によって発生する有毒物質が
周辺海域一帯に拡散すれば、湾内だけで
なく沿岸部への影響も計り知れない。*/
大佐_015: {
sondern auch die gesamte K&~uste
&~uber Jahrzehnte.
}
//	<<<ENGLISH>>>
//	but poison the coastline
//	for generations.

/*環境回復には何世代もかかる。*/
ライデン_016:
''
//	<<<ENGLISH>>>
//	...

/*……。*/
大佐_017: {
Raiden, wir mu&~sten die Einsatzziele
&~andern.
}
//	<<<ENGLISH>>>
//	Raiden, we've had to adjust
//	the mission objectives.

/*ライデン、作戦を変更する。
大統領の救出は後回しだ。*/
大佐_018: {
Die Priorit&~at lautet jetzt, die C4s zu
entfernen, die die Terroristen &~uberall
auf der Big Shell angebracht haben.
}
//	<<<ENGLISH>>>
//	The priority is now on removing
//	those C4's that the terrorists
//	wired over the Big Shell.

//<ページ数変更>
大佐_018_1: {
Der Pr&~asident mu&~s warten.
}
//	<<<ENGLISH>>>
//	The President can wait,
//	but this can't.

/*彼らが『ビッグ・シェル』に仕掛けた
Ｃ４を除去してくれ。一刻も早くな。*/
ライデン_019: {
Oberst, Du wei&~st doch, da&~s ich kein
Bombenexperte bin.
}
//	<<<ENGLISH>>>
//	Colonel, you know I'm no
//	bomb disposal expert.

/*……大佐、俺には爆弾処理の経験はない。*/
大佐_020: {
Das macht nichts. Der Bravo-Trupp hat
einen Sprengstoffexperten mitgebracht.
}
//	<<<ENGLISH>>>
//	That's not a problem -- the Bravo
//	team brought an explosives pro in
//	with them.

/*ブラボー・チームと共に爆弾処理の
教官が降下している。*/
大佐_021: {
Laut ihrem Einsatzplan sollte er an
Strebe C bereitstehen. Da m&~u&~stest
Du ihn eigentlich finden.
}
//	<<<ENGLISH>>>
//	He was supposed to standby on
//	Strut C according to their mission
//	plan. You should find him there.

/*ＳＥＡＬ１０の
作戦ではＣ脚に残ることになっていた。
まだそこにいるだろう。*/
ライデン_022: {
Entspricht dies auch der Simulation?
}
//	<<<ENGLISH>>>
//	Is this according to
//	simulation too...?

/*……これもシミュレーション通りなのか？*/
大佐_023: {
Wovon sprichst Du?
Begib Dich zu Strebe C und finde ihn!
}
//	<<<ENGLISH>>>
//	What are you talking about?
//	Get to Strut C and find him!

/*何を言っている？
Ｃ脚に向かうんだ。
彼を探せ。*/
ライデン_024: {
Verstanden, Aber vorher mu&~s
ich noch etwas fragen.
}
//	<<<ENGLISH>>>
//	Understood... But I need to ask
//	you something before I go.

/*……了解。
だがその前に、ひとついいか？*/
大佐_025: {
Aber schnell.
}
//	<<<ENGLISH>>>
//	Make it quick.

/*なんだ？*/
ライデン_026: {
Wer sind sie - Dead Cell?
}
//	<<<ENGLISH>>>
//	Who are they -- Dead Cell, I mean?

/*奴等は、デッドセルは何者なんだ？*/
ライデン_027: {
Sie konnten sie nicht treffen,
so sehr sie es auch versuchten.
}
//	<<<ENGLISH>>>
//	They couldn't hit her, no matter
//	how hard they tried...

/*あの女、弾が当たらなかった……。*/
ライデン_028: {
Und dieser Vampir.
Es ist wie -
}
//	<<<ENGLISH>>>
//	And that vampire too.
//	It's -- it's like...

/*さっきの吸血鬼といい……。*/
ライデン_029: {
Es ist wie ein Alptraum, ohne Ende.
}
//	<<<ENGLISH>>>
//	It's like being in a nightmare
//	you can't wake up from.

/*そう、悪夢をみているようだ。*/
ローズ_030: {
Jack, wach auf!
}
//	<<<ENGLISH>>>
//	Jack, snap out of it!

/*ジャック、しっかりして！*/
ライデン_031: {
Und Du, Rose - Ich kann nicht glauben,
da&~s Du hieran teilnimmst. Ich glaube
immer noch einfach aufzuwachen.
}
//	<<<ENGLISH>>>
//	And you Rose -- I can't believe
//	you're on this mission. I keep
//	thinking I'll wake up...

/*ああローズ。君がこのミッションに
参加している事も信じられない。
いつ目が醒めるかと……。*/
大佐_032: {
Raiden, das hier ist die Realit&~at.
Du kannst aus ihr nicht erwachen.
}
//	<<<ENGLISH>>>
//	Raiden, this is real.
//	And that's why you won't
//	wake up.

/*ライデン、これは現実だ。
目が覚める事はない。*/
ライデン_033: {
Aber alles erscheint unwirklich.
}
//	<<<ENGLISH>>>
//	But nothing seems real.

/*あまりにも全てが現実離れしている。*/
ローズ_034: {
Ich habe beschlossen, bei Dir zu bleiben.
}
//	<<<ENGLISH>>>
//	I've made up my mind to stay with
//	you. Whether this is real or a bad
//	dream,

/*私は……私は覚悟を決めた。
悪夢でも現実でも、私はあなたを見てる。*/
//<ページ数変更>
ローズ_034_1: {
Ob Realit&~at oder Alptraum, ich werde Dich
beobachten, bis alles vorbei ist.
}
//	<<<ENGLISH>>>
//	I'll keep watching you,
//	till it's over.

/*最後まで。*/
ライデン_035: {
Danke, Rose.
Und ich werde nicht zulassen,
da&~s Du nur ein Traum bist.
}
//	<<<ENGLISH>>>
//	Thank you, Rose.
//	And I won't let you
//	be just a dream...

/*わかったよ。
君だけは、ローズだけは夢であって
欲しくないものだ。*/
大佐_036: {
Seid Ihr zwei fertig?
Raiden, Du wirst an Strebe C ben&~otigt.
}
//	<<<ENGLISH>>>
//	Are you two done?
//	Raiden, you're needed
//	on Strut C.

/*話はすんだか？
ならばＣ脚へ向かってくれ。*/
}//d



resource P013_01_R01_ライデン危機無線１無線デモ１＿１__g {
//vc111301
ローズ_000: {
Jack! Geht es Dir gut!?
}
//	<<<ENGLISH>>>
//	Jack! Are you okay!?

/*ジャック！
無事なの！！！*/
大佐_001: {
Rosemary!
}
//	<<<ENGLISH(2)>>>
//	Rosemary!

/*ローズ君！*/
ローズ_002: {
Jack, geht es Dir wirklich gut?
}
//	<<<ENGLISH>>>
//	Jack, tell me you're okay.

/*ジャック、大丈夫？*/
ライデン_003: {
Es geht mir gut.
Aber es war knapp.
}
//	<<<ENGLISH>>>
//	I'm all right.
//	It was a close one, though.

/*大丈夫だ。
……危なかったが。*/
ローズ_004: {
Oh, gut.
}
//	<<<ENGLISH>>>
//	Oh good...

/*……よかった。*/
ライデン_005:
''
//	<<<ENGLISH>>>
//	.

/*……。*/
ローズ_006: {
Ich h&~atte nicht gedacht,
da&~s es so schwer wird.
}
//	<<<ENGLISH>>>
//	I didn't think it would
//	be this tough.

/*私、甘かったわ。*/
ライデン_007: {
He.
}
//	<<<ENGLISH(2)>>>
//	Hey...

/*大丈夫か？*/
ローズ_008: {
Es ist nur die Hilflosigkeit,
wei&~st Du?
}
//	<<<ENGLISH>>>
//	It's the helplessness of it,
//	you know.

/*辛い……こんなの。*/
ローズ_009: {
Zuzuschauen, ohne
Dir helfen zu k&~onnen.
}
//	<<<ENGLISH>>>
//	Just watching... with
//	no power to help you.

/*ただ傍観しているだけ。何もできない。*/
//<ページ数変更>
ローズ_009_1: {
Es ist wie ein Platz direkt am Boxring.
}
//	<<<ENGLISH>>>
//	It's like having a ringside
//	seat at a boxing match.

/*まるでボクシングの試合を観てるみたい。*/
ローズ_010: {
Nur viel schlimmer.
}
//	<<<ENGLISH>>>
//	But much worse...

/*いいえ、それよりも酷い。*/
ローズ_011: {
Weil es um jemanden geht, den ich liebe.
Und der Einsatz ist -
}
//	<<<ENGLISH>>>
//	Because it's someone I love
//	and the stakes are --

/*自分の大切な人が……。*/
大佐_012: {
Rosemary - vielleicht habe ich mich
dieses Mal verrechnet.
}
//	<<<ENGLISH>>>
//	Rosemary -- maybe this was
//	a miscalculation on my part.

/*ローズ君……
私の間違いだったかもしれん。*/
大佐_013: {
Sie zu nehmen,
war nicht besonders klug.
}
//	<<<ENGLISH>>>
//	Selecting her wasn't
//	the wisest choice.

/*やはり彼女には無理だったようだ。*/
ローズ_014: {
Nein, nein, bitte entschuldigt
den Ausbruch.
}
//	<<<ENGLISH>>>
//	No, no, I apologize
//	for the outburst.

/*いえ、ごめんなさい。*/
ローズ_014_1: {
Mir geht es gut.
Ich will das hier mit Dir durchstehen.
}
//	<<<ENGLISH>>>
//	I'm all right.
//	I will see this through
//	with you.

/*私、大丈夫。最後までつき合う。
*/
ライデン_015: {
Rose?
}
//	<<<ENGLISH(2)>>>
//	Rose?

/*ローズ？*/
ローズ_016: {
Wir k&~ampfen zusammen, ja?
Weder Du noch ich wissen wohin.
}
//	<<<ENGLISH>>>
//	We fight together, ok? You have
//	nowhere to run, neither do I.

/*私も一緒に闘う。
彼も逃げられない。
だから私も逃げない。*/
大佐_017: {
Rosemary, Du mu&~st nicht weitermachen,
das wei&~st Du doch.
}
//	<<<ENGLISH>>>
//	Rosemary, you're not obligated
//	to continue, you know that.

/*ローズ君、無理はせんでもいい。*/
ローズ_018: {
Schon gut.
}
//	<<<ENGLISH>>>
//	I'm all right, sir.

/*私、できるわ。*/
大佐_019: {
Hmm.
}
//	<<<ENGLISH(2)>>>
//	Hmm...

/*うむ……。*/
大佐_020: {
Raiden, wie steht es mit Dir?
}
//	<<<ENGLISH>>>
//	Raiden, how about you?

/*ライデン、君の方はどうだ？*/
ライデン_021: {
Mir geht es gut.
}
//	<<<ENGLISH>>>
//	I'm good.

/*ああ、大丈夫だ。*/
大佐_022: {
Dann geht der Einsatz weiter.
}
//	<<<ENGLISH>>>
//	Then the mission goes on.

/*よし、ではこのまま続けて貰う。*/
大佐_023: {
Aber Rosemary, eins mu&~st Du
in Deinen Kopf bekommen.
}
//	<<<ENGLISH>>>
//	But Rosemary, there's one thing
//	you need to understand.

/*ただし、いいかね。ローズ君？*/
ローズ_024: {
Sir?
}
//	<<<ENGLISH(2)>>>
//	Sir?

/*はい？*/
大佐_025: {
Er hei&~st Raiden.
Verstanden?
}
//	<<<ENGLISH>>>
//	His name is Raiden.
//	Got it?

/*彼はライデンだ。わかったか？*/
ローズ_026: {
Jawohl.
Verstanden.
}
//	<<<ENGLISH>>>
//	Yes sir.
//	I understand.

/*え、ええ。
わかってます……。*/
}//d





resource P014_05_R01_ピーター遭遇５無線デモ１＿１__g {
//vc111401
大佐_000: {
Ich bin froh, da&~s Stillman in Sicherheit ist.
}
//	<<<ENGLISH>>>
//	Glad to hear Stillman is safe.

/*ライデン、スティルマンが
無事だったのは何よりだ。*/
大佐_001: {
Hilf ihm, wo Du nur kannst,
um die C4s vom Bauwerk zu r&~aumen.
}
//	<<<ENGLISH>>>
//	Assist him in any way possible to
//	clear the C4 from the structure.

/*彼と協力して『ビッグ・シェル』内の
Ｃ４を解除してくれ。*/
ライデン_002: {
Oberst, Du wei&~st doch, da&~s ich nicht in
R&~aumen von Sprengstoffen ausgebildet
bin.
}
//	<<<ENGLISH>>>
//	Colonel, you know I've never
//	been trained in bomb disposal.

/*大佐、俺は爆弾解体の訓練なんて、
受けたことがない。*/
大佐_003: {
Schon gut. Du arbeitest da mit dem Besten
seines Fachs zusammen.
}
//	<<<ENGLISH>>>
//	It's all right. The man you're
//	working with is the best in the
//	field.

/*大丈夫だ。そこにいる男は爆弾処理の
専門家だ。超一流のな。*/
//<ページ数変更>
大佐_003_1: {
Folge einfach seinen Anweisungen.
}
//	<<<ENGLISH>>>
//	All you have to do is
//	follow his directions.

/*彼の指示に
従ってくれ。*/
大佐_004: {
Nat&~urlich wirst Du Deine Identit&~at
und Deinen Auftrag f&~ur Dich behalten.
}
//	<<<ENGLISH>>>
//	You will of course keep your
//	identity and mission objectives
//	to yourself.

/*ただし、ライデン。こちら側の素性や
ミッションについてはいっさい話すな。*/
ライデン_005: {
Stimmt es, da&~s ein Ingenieur
bei Stillman war?
}
//	<<<ENGLISH>>>
//	Is it true that an engineer
//	came in with Stillman?

/*スティルマンと一緒に技術者が降下した
という話は本当なのか？*/
大佐_006: {
Davon wei&~s ich nichts. Vermutlich haben
die SEALs das selbst beschlossen.
}
//	<<<ENGLISH>>>
//	I wasn't informed of that. It's
//	probably something the SEALs
//	decided on their own.

/*いや、我々も聞いていない。
ＳＥＡＬ１０の独自行動だろう。*/
ライデン_006:
''
//	<<<ENGLISH>>>
//	...

/*……。*/
大佐_007: {
Es gibt wichtigere Fragen, Raiden. Der
Feind kann wegen des fehlgeschlagenen
Angriffs zur&~uckschlagen.
}
//	<<<ENGLISH>>>
//	There are more important issues
//	at hand, Raiden. The enemy may
//	retaliate for the failed assault.

/*そんなことより、先ほどの突入に対する、
報復が考えられる。*/
//<ページ数変更>
大佐_007_1: {
Neutralisiere die C4s sofort.
}
//	<<<ENGLISH>>>
//	Get those C4's neutralized now.

/*爆弾の除去を急いで
くれ。*/
ライデン_008: {
Oberst, ich bin nicht f&~ur
die Bombenr&~aumung qualifiziert.
}
//	<<<ENGLISH>>>
//	Colonel, I'm not qualified
//	for bomb disposal.

/*……大佐、爆弾解体など、
俺にはできない。*/
ローズ_009: {
Jack, ich bin's.
}
//	<<<ENGLISH(2)>>>
//	Jack, it's me.

/*ジャック、私……。*/
ライデン_010: {
Rose?
}
//	<<<ENGLISH(2)>>>
//	Rose?

/*ローズ？*/
ローズ_011: {
Du schaffst das schon.
Vertrau mir.
}
//	<<<ENGLISH>>>
//	You can do this.
//	Trust me.

/*大丈夫、あなたならできる。
きっとできる。*/
大佐_012: {
Du hast im VR zwar keine
Sprengstoffbeseitigung geprobt,
aber Du bist mehr als geeignet,
mit C4s fertig zu werden.
}
//	<<<ENGLISH>>>
//	You haven't had bomb disposal
//	training per se in VR, but you're
//	more than capable of handling C4.

/*確かに爆弾解体のＶＲ訓練は受けて
いないが、Ｃ４の取扱いは訓練済み
だろう。*/
ライデン_013: {
Das hier ist etwas anderes,
als C4s zu benutzen.
}
//	<<<ENGLISH>>>
//	...This is a little
//	different from using C4.

/*……Ｃ４を仕掛けるのとは訳が違う。*/
ローズ_014: {
Du schaffst das.
Das wei&~st Du auch.
}
//	<<<ENGLISH>>>
//	You're up for this.
//	You know that.

/*大丈夫。
できるわ、あなたなら……。*/
//口ぱくはいりません。
プリスキン_015: {
Wie steht's, Junge?
Hast Du schon die Ergebnisse?
}
//	<<<ENGLISH>>>
//	How about it, kid?
//	Are the results in yet?

/*どうだ、若いの。結論は出たか？*/
}//d



resource P015_01_R1_爆弾解体最初の一つ１無線デモ１＿１__g {
//vc111501
ピーター_000: {
Das sieht ihm gar nicht &~ahnlich.
}
//	<<<ENGLISH>>>
//	That's not like him...

/*そうか、あいつらしくない……。*/
ライデン_001: {
Stimmt was nicht?
}
//	<<<ENGLISH>>>
//	Anything wrong?

/*何かおかしな点でも？*/
ピーター_002: {
Ich bin nicht sicher. Pliskin hat auch
andere Positionen gemeldet - keine davon
ein wirksamer Sprengpunkt.
}
//	<<<ENGLISH>>>
//	Maybe. Pliskin's reported other
//	locations too, and none of them
//	are effective demolition points.

/*ああ、
プリスキンの報告も聞いているが……
どこも効果的な位置ではない。*/
ライデン_003: {
Was soll das hei&~sen?
}
//	<<<ENGLISH(2)>>>
//	What do you mean?

/*どういう事だ？*/
ピーター_004: {
Das hei&~st, es sind nicht die besten
Sprengpositionen, um die Anlage hier
in die Luft zu jagen.
}
//	<<<ENGLISH>>>
//	It means that they wouldn't be
//	the best places to choose if you
//	wanted to destroy this place.

/*ここを沈める為の最適な設置場所では
ない。*/
ライデン_005: {
Soll das hei&~sen, sie wollen die Shell
gar nicht in die Luft jagen?
}
//	<<<ENGLISH>>>
//	Are you saying they don't plan
//	on blowing the Shell up?

/*沈めるつもりはないということか？*/
ピーター_006: {
Sieht so aus. Was ihr bislang gefunden
habt, ist praktisch eine Verschwendung
guter Sprengstoffs.
}
//	<<<ENGLISH>>>
//	It certainly seems that way. So far,
//	we haven't seen anything but a waste
//	of good explosives.

/*うむ、明らかに爆薬の無駄遣いだ。*/
//<ページ数変更>
ピーター_006_1: {
Es sei denn, wir &~ubersehen da etwas.
}
//	<<<ENGLISH>>>
//	Unless of course, we're
//	missing something.

/*あるいは、何か見落としているのか……。*/
ライデン_007: {
Eine Falle?
}
//	<<<ENGLISH(2)>>>
//	A trap?

/*罠？*/
ピーター_008: {
Er mu&~s sich gedacht haben, da&~s man mich
rufen w&~urde. Hier ist etwas faul.
}
//	<<<ENGLISH>>>
//	He couldn't have overlooked the
//	fact that I would be called into
//	this. There's something going on.

/*あいつは私がでてくる事を予期していた
はず。何かありそうだ。*/
}//d




resource P016_01_R1_爆弾解体半分解体１無線デモ１＿１__g {
//vc111601
ピーター_000: {
Das kann nicht stimmen.
So etwas w&~urde nur ein Anf&~anger machen.
}
//	<<<ENGLISH>>>
//	This is all wrong.
//	This is something only
//	an amateur would do.

/*おかしい。これじゃまるで、素人だ。*/
ライデン_001: {
Was meinst Du damit?
}
//	<<<ENGLISH(2)>>>
//	What do you mean?

/*どういうことか、話してくれ？*/
ピーター_002: {
Alle Bomben, die ihr bislang gefunden
habt, waren nicht an den richtigen
Stellen angebracht.
}
//	<<<ENGLISH>>>
//	All the bombs that have been
//	found so far don't appear to be
//	in the right kind of locations.

/*これまでに設置されていたどのＣ４も
適切な場所とは思えない。*/
//<ページ数変更>
ピーター_002_1: {
Und auch die Menge reicht nicht aus.
}
//	<<<ENGLISH>>>
//	And the quantity of explosives
//	isn't sufficient either.

/*爆薬量も
最適ではない。*/
ライデン_003: {
Auch Fatman kann Fehler machen, oder?
}
//	<<<ENGLISH>>>
//	Even Fatman can make
//	mistakes, right?

/*ファットマンにも間違いはある。*/
ピーター_004: {
Nein, irgendetwas stimmt hier ganz
und gar nicht.
}
//	<<<ENGLISH>>>
//	No. there's something
//	else going on here...

/*いや。何かある……。*/
ピーター_005: {
Beeil Dich mit dem Entsch&~arfen, Raiden.
Ich habe ein ungutes Gef&~uhl.
}
//	<<<ENGLISH>>>
//	Get a move on with the disposal,
//	Raiden. I've got a bad feeling
//	about this.

/*急いでくれ、ライデン。気になる。*/
ライデン_006: {
Du h&~altst das f&~ur eine Falle?
}
//	<<<ENGLISH>>>
//	Do you think it's a trap?

/*囮なのか？*/
ピーター_007: {
Ich wei&~s es nicht, aber ich werde auch
Pliskin raten, sehr vorsichtig zu sein.
Beeile Dich.
}
//	<<<ENGLISH>>>
//	I don't know, but I'm going to
//	tell Pliskin to watch his back too.
//	Just hurry.

/*わからない。
プリスキンにも用心するよう伝えておく。
頼むぞ。*/
}//d



resource P017_01_R01_爆弾解体中ローズその１無線デモ１＿１__g {
//vc111701
ローズ_000: {
Jack - es mu&~s nervenaufreibend sein,
eine Bombe zu entsch&~arfen.
}
//	<<<ENGLISH>>>
//	Jack -- it must be so nerve-racking
//	to defuse a bomb...

/*ジャック、爆弾解体って……
すごく神経を使うでしょ？*/
ライデン_001: {
Ja, k&~onnte man sagen.
}
//	<<<ENGLISH>>>
//	Yeah, I'd say so.

/*当たり前だ。*/
ローズ_002: {
OK, dumme Bemerkung.
Tut mir leid.
}
//	<<<ENGLISH>>>
//	OK, that was a stupid thing
//	to say. Sorry.

/*ああ、ごめん。無神経だったわね。*/
ライデン_003: {
Schon gut. Es ist nur, da&~s ich darin
keinerlei Training hatte.
}
//	<<<ENGLISH(2)>>>
//	That's all right. It's just that
//	I've never been trained in this
//	stuff.

/*いや……
ただ訓練ではやらなかったからな。*/
ローズ_004: {
Ist alles in Ordnung?
F&~uhlst Du Dich okay?
}
//	<<<ENGLISH>>>
//	You okay?
//	Are you feeling well?

/*大丈夫？まいってない？*/
ライデン_005: {
Ein paar Mal war mir ganz sch&~on schlecht.
}
//	<<<ENGLISH>>>
//	I almost threw up a few times.

/*何度も吐きそうになった。*/
ローズ_006: {
Oh, Jack.
}
//	<<<ENGLISH(2)>>>
//	Oh Jack...

/*ジャック？*/
ライデン_007: {
Aber ich bin schon okay.
Ich bin ja nicht alleine.
}
//	<<<ENGLISH>>>
//	But I'm okay.
//	It's not like I'm in this alone.

/*でもまだ大丈夫だ。
ひとりでや
ってる訳じゃない。*/
ローズ_008: {
Oh - ja, stimmt.
}
//	<<<ENGLISH>>>
//	Oh -- yeah, that's true.

/*……そ、そうね。*/
ローズ_009: {
Woran denkst Du, wenn Du die Dinger
entsch&~arfst?
}
//	<<<ENGLISH>>>
//	What do you think about when
//	you're defusing those things?

/*解体している時って、
どんな事を考えるの？*/
ライデン_010: {
Ich denke eigentlich nicht, es kommen
mir nur Erinnerungen. Und ich wei&~s,
da&~s ich einfach abschalten mu&~s.
}
//	<<<ENGLISH>>>
//	I don't think so much as remember.
//	And I know that I need to resist
//	that, and keep my mind blank.

/*いろんな事が思い出される……
でも、それらを押し込める事が
大切なんだ。
無心にならないと……*/
ライデン_011: {
Ich darf mich nicht von der Angst
&~uberw&~altigen lassen.
}
//	<<<ENGLISH>>>
//	I can't let myself be overwhelmed
//	by the fear.

/*恐怖に飲まれてはいけないらしい。
*/
ローズ_012: {
Geh&~ore ich auch zu den unangenehmen
Erinnerungen?
}
//	<<<ENGLISH>>>
//	So, am I a part of what you
//	try not to remember?

/*私の事なんかも考えるの？*/
ライデン_013:
''
/*……。*/
ローズ_014: {
Das war nur ein Witz. Aber jetzt
ist wohl der falsche Zeitpunkt.
}
//	<<<ENGLISH>>>
//	I was just kidding. But I guess
//	this isn't a good time for that.

/*ごめんなさい、こんな時にね。*/
ライデン_015: {
Doch. Ich denke an Dich - ich versuche,
mich daran zu erinnern, warum der 30.
April so wichtig ist.
}
//	<<<ENGLISH>>>
//	No, it is. And I do think about you.
//	I'm trying to remember what's so
//	special about April 30th.

/*いいんだ。そうだな、
４月３０日が何の日か？
それを考えている。*/
ローズ_016: {
Und?
}
//	<<<ENGLISH>>>
//	Any success?

/*思い出した？*/
ライデン_017: {
Bislang ohne Erfolg.
}
//	<<<ENGLISH>>>
//	No, not yet.

/*いや、まだだ。*/
ローズ_018: {
Du mu&~st am Leben bleiben,
sonst erf&~ahrst Du es nie.
}
//	<<<ENGLISH>>>
//	You need to stay
//	alive so you can.

/*思い出すまで、死んじゃダメよ。*/
ライデン_020: {
In Ordnung, abgemacht.
}
//	<<<ENGLISH>>>
//	Okay, that's a deal.

/*わかった……。*/
}//d



resource P018_01_R01_爆弾解体中ローズその２無線デモ１__g {
//vc111801
ローズ_000: {
He, Jack? Ist Bombenr&~aumen einem
Beziehungsstart nicht sehr &~ahnlich?
}
//	<<<ENGLISH>>>
//	Hey Jack? I bet bomb disposal's
//	a lot like starting a relationship.

/*ジャック、教えて？
爆弾解体って、女の子を口説くような
もの？*/
ライデン_001: {
Was?
Was soll das hei&~sen?
}
//	<<<ENGLISH>>>
//	Huh?
//	What are you talking about?

/*どういう意味だ？*/
ローズ_002: {
Vorsichtig die emotionale Abwehr abbauen,
st&~andig auf der Hut sein, Verstehst Du?
}
//	<<<ENGLISH>>>
//	Carefully dismantling emotional
//	defenses, being on your toes
//	constantly...you know?

/*壊さないように、慎重に、慎重に……。
心の防御を一枚、一枚、剥がしていく
みたなもんでしょ？*/
ライデン_003: {
Ich glaube. Beides nicht gerade meine
St&~arken.
}
//	<<<ENGLISH>>>
//	I guess. Neither of them
//	are my strong point.

/*そうだな、一理あるかも。
まあ、俺には苦手な分野だ。*/
ローズ_004: {
Stimmt, Du bist nicht gerade
der Geduldigste.
}
//	<<<ENGLISH>>>
//	It's true that you're not the
//	most patient man in the world.

/*そうね、ジャックはせっかちだから。*/
ライデン_005: {
Das ist es nicht.
Ich lasse Dinge lieber so,
wie sie sind.
}
//	<<<ENGLISH>>>
//	It's not that.
//	I like to leave things
//	as they are.

/*いや、外から眺めている方が好きなんだ。*/
ローズ_006: {
Hast Du Angst vor dem, was sich dahinter
verbergen k&~onnte?
}
//	<<<ENGLISH>>>
//	Are you afraid of what
//	might be hidden inside?

/*人の真実に触れるのが怖い？*/
ライデン_007: {
Keine Angst - ich mag nur keine
Komplikationen.
}
//	<<<ENGLISH>>>
//	Not afraid, just -- unwilling...
//	to deal with complications.

/*面倒なんだ。厄介事が。*/
ローズ_008: {
Wie mich?
}
//	<<<ENGLISH>>>
//	Like me?

/*私の事も？*/
ライデン_009: {
Du bist -
}
//	<<<ENGLISH(2)>>>
//	You're --

/*それは……。*/
ローズ_010: {
Jack?
}
//	<<<ENGLISH(2)>>>
//	Hey Jack?

/*ねえ、ジャック？*/
ライデン_011: {
Ja?
}
//	<<<ENGLISH(2)>>>
//	Yeah?

/*ああ？*/
ローズ_012: {
Wei&~st Du, warum ich diesen Job mache?
}
//	<<<ENGLISH>>>
//	Do you know why
//	I took this job?

/*今回の任務を引き受けたの、
なぜだかわかる？*/
ライデン_013: {
?
}
//	<<<ENGLISH(2)>>>
//	?

/*？*/
ローズ_014: {
Ich wollte wissen,
wie Du wirklich bist.
}
//	<<<ENGLISH>>>
//	I wanted to see what
//	you were really like.

/*あなたの心を覗いてみたかったの。
私のしらない、本当のあなた。*/
ライデン_015: {
Aber wir sind schon lange zusammen.
Du kennst mich doch.
}
//	<<<ENGLISH>>>
//	But we've been together a while.
//	You know me already.

/*いつもそばにいたじゃないか？*/
ローズ_016: {
Nein - Du l&~a&~st mich nur begrenzt an
Dich ran. Und ich mu&~s wissen, was
dahinter steckt.
}
//	<<<ENGLISH>>>
//	No -- you never let me in past a
//	certain point. And I need to know
//	what's there.

/*いいえ、あなたいつも心を閉ざしていた。
それが何か、知りたいの。*/
ライデン_017: {
Hahhh.
Willst Du mich jetzt analysieren?
}
//	<<<ENGLISH>>>
//	...Hahhhh.
//	Are you trying to
//	take me apart now?

/*……ふむ……
これじゃ、こっちが解体されそうだ。*/
ローズ_018: {
Ach, spielt keine Rolle.
}
//	<<<ENGLISH>>>
//	Hey, it's not important.

/*ごめん、冗談よ。*/
ローズ_019: {
Viel Gl&~uck, Jack.
}
//	<<<ENGLISH>>>
//	Good luck, Jack.

/*がんばってね、ジャック。*/
}//d



resource P019_01_R01_爆弾解体中ローズその３無線デモ１＿１__g {
//vc111901
ローズ_000: {
Jack, erinnerst Du Dich noch an unser
erster Treffen?
}
//	<<<ENGLISH>>>
//	Jack, do you remember
//	the day we met?

/*ジャック、私たちの出逢い、憶えている？*/
ライデン_001: {
Ich bin gerade ziemlich besch&~aftigt, Rose.
}
//	<<<ENGLISH>>>
//	I'm kinda busy right now, Rose.

/*こんな時に、なんだ？
*/
ローズ_002: {
Du hast ja recht, tut mir leid.
}
//	<<<ENGLISH>>>
//	You're right, sorry.

/*ごめんなさい、そうね……。*/
ライデン_003: {
Ich erinnere mich.
}
//	<<<ENGLISH>>>
//	I do remember.

/*ああ……憶えているよ。*/
ライデン_004: {
Es war unmittelbar nach meiner
Versetzung nach New York.
}
//	<<<ENGLISH>>>
//	It was right after I
//	transferred to New York.

/*俺がＮＹに移ってきた直後だった。*/
//<ページ数変更>
ライデン_004_1: {
All diese Touristen um Dich herum,
vor der Federal Hall.
}
//	<<<ENGLISH>>>
//	There were all these tourists
//	around you, in front of the
//	Federal Hall.

/*そう、フェデラルホールの前……
君は観光客の一団に囲まれていた……。*/
ローズ_005: {
Eine Gruppe Japanerinnen mittleren
Alters fragte mich,
}
//	<<<ENGLISH>>>
//	A group of middle-aged Japanese
//	ladies came up and asked me,
//<ページ数変更>
/*質問をされてたの。日本から来た
おばさん達に。*/
ローズ_005_1: {
welches Geb&~aude King Kong im Film
hochkletterte.
}
//	<<<ENGLISH>>>
//	which building it was that King Kong
//	was climbing in the movie.

/*キングコングの登った
ビルはどれか？って。*/
/* テロ事件対応でカット */
/*
ライデン_006: {
You pointed out the
World Trade Center.
}
*/
/*君は世界貿易センタービルを指して
答えた。*/
/* テロ事件対応でカット */
/*
ローズ_007: {
But the ladies
weren't convinced.
}
*/
/*でもおばさんはそのビルを見て
納得しなかった。*/
/* テロ事件対応でカット */
/*
ライデン_008: {
The tourists were talking about
the black and white King Kong.
}
*/
/*おばさんはモノクロのキングコングの
方を観ていたんだ。*/
ローズ_009: {
Ich sagte, es war vermutlich
das Chrysler-Geb&~aude.
}
//	<<<ENGLISH>>>
//	I said it was probably
//	the Chrysler Building.

/*私はおそらく、クライスラービルだと
言った。*/
/* テロ事件対応でカット */
/*
ライデン_010: {
You hadn't seen the black
and white original.
}
*/
/*そう、君はモノクロ版を観ていなかった。*/
/* テロ事件対応で一部セリフカット */
/*ローズ_011: {
I just vaguely remembered the
pictures. And then you showed up
and started mouthing off.
}
*/
ローズ_011: {
Und dann kamst Du mit Deinem gro&~sen
Mundwerk.
}
//	<<<ENGLISH>>>
//	And then you showed up
//	and started mouthing off.

/*ええ、うろ憶えだった。
そこへあなたが現れて割り込んできた。*/
ローズ_012: {
So etwas wie:
'Nein, es war das Empire State.'
}
//	<<<ENGLISH(2)>>>
//	You were like,
//	"No, it's the Empire State."

/*違う。エンパイアステートビルだ。*/
ライデン_013: {
Ich sagte, das Chrysler-Geb&~aude war
in Godzilla zu sehen.
}
//	I said the Chrysler Building
//	was in Godzilla.

/*クライスラービルが壊れたのはゴジラだ。
といった。*/
ローズ_014: {
Ha ha ha.
}
/*ふふ……。*/
ローズ_015: {
Wir fingen an zu streiten,
und ich verga&~s die Touristen v&~ollig.
}
//	<<<ENGLISH>>>
//	We started arguing, and I forgot
//	all about the tourists.

/*私たちはおばさん達、そっちのけで
討論を始めた。*/
ローズ_016: {
Ich beharrte darauf, da&~s ich Recht h&~atte,
und Du genauso.
}
//	<<<ENGLISH>>>
//	I was insisting that I was right,
//	and you were doing the same...

/*自分こそが正しいと主張して……。*/
ライデン_017: {
Eh wir uns versahen, waren
die Japanerinnen verschwunden.
}
//	<<<ENGLISH>>>
//	The next thing we knew,
//	the Japanese women had
//	gone away.

/*気が付くと、観光客はいなくなっていた。*/
ローズ_018: {
Und wir gingen ins Skyscraper Museum,
um zu sehen, wer das bessere
Ged&~achtnis hatte.
}
//	<<<ENGLISH>>>
//	And we ended up going to the
//	Skyscraper Museum to see who
//	had the better recall.

/*そこで、お互いの言い分を
立証するために、摩天楼博物館に
向かう事になった。*/
ライデン_019: {
Wir stritten uns auf dem ganzen
Weg dorthin.
}
//	<<<ENGLISH>>>
//	We argued all the way
//	to Battery Park.

/*そうだ。バッテリーパークまで口論を
続けながら歩いた。*/
ローズ_020: {
Und v&~ollig umsonst!
}
//	<<<ENGLISH>>>
//	And for nothing!

/*でも、結論はでなかった。*/
ライデン_021: {
Da das Museum geschlossen war.
}
//	<<<ENGLISH>>>
//	Since the museum was closed.

/*博物館は休館だったんだ。*/
ライデン_022: {
Wir gingen getrennter Wege weiter.
}
//	<<<ENGLISH>>>
//	We went our separate ways
//	from the museum.

/*博物館の前で俺達は別れた。*/
ライデン_023: {
Bis ich Dir zuf&~allig im Kellerkorridor
wiederbegegnete.
}
//	<<<ENGLISH>>>
//	And then I found you again by
//	coincidence out in the base
//	corridor.

/*１週間後、偶然君を基地の廊下で
見つけた。*/
ローズ_024: {
Was f&~ur ein Zufall, da&~s wir ausgerechnet
im gleichen Geb&~aude arbeiteten.
}
//	<<<ENGLISH>>>
//	An amazing coincidence -- that we
//	were actually working at the same
//	place.

/*ええ、偶然だった。
同じところで働いたなんてね。*/
ライデン_025: {
An dem Abend fuhren wir auf's
Empire State hoch.
}
//	<<<ENGLISH>>>
//	That night, we went up to
//	the top of the Empire State.

/*俺達はその夜、
エンパイアステートビルの屋上へ行った。*/
ローズ_026: {
Es war wundersch&~on -
}
//	<<<ENGLISH>>>
//	It was so beautiful --

/*綺麗だった。*/
//<ページ数変更>
ローズ_026_1: {
ich konnte aus der 120. Etage auf
das Chrysler-Geb&~aude hinunterblicken.
}
//	<<<ENGLISH>>>
//	I could look down on the Chrysler
//	Building from a hundred and twenty
//	stories above ground.

/*地上１２０階から観る
クライスラービル……。*/
ライデン_027: {
- einfach &~uberw&~altigend.
}
//	<<<ENGLISH>>>
//	I felt -- overwhelmed.

/*圧倒された……。*/
ライデン_028: {
Es war mir pl&~otzlich egal,
wer recht hatte.
}
//	<<<ENGLISH>>>
//	I didn't care anymore
//	who was right.

/*どちらが正しいなんて、もうどうでも
良くなってた。*/
ローズ_029: {
Das war unsere erste Verabredung.
}
//	<<<ENGLISH>>>
//	And that was our first date.
/*あれが私たちの最初のデート。*/
ライデン_030: {
An dem Abend sahen wir uns ein
paar Mal "King Kong" in Deiner
Wohnung an.
}
//	<<<ENGLISH>>>
//	We watched "King Kong" in your
//	apartment a bunch of times that
//	night.

/*その晩、君の部屋でキングコングの
ビデオを何度も見た。*/
ライデン_031: {
Wir schliefen erst gegen Morgen ein.
}
//	<<<ENGLISH>>>
//	Didn't sleep till morning...

/*朝まで……。*/
ローズ_032:
''
/*……。*/
ライデン_033: {
Ohne diesen Zufall, w&~aren wir
heute nicht zusammen.
}
//	<<<ENGLISH>>>
//	If it weren't for that coincidence,
//	we wouldn't be together.

/*あの偶然がなければ俺達は出会って
いなかった。*/
ローズ_034: {
Ich wei&~s.
}
//	<<<ENGLISH(2)>>>
//	I know...

/*そうね……。*/
ローズ_035: {
Tut mir leid, Jack.
Ich halte Dich wieder auf.
}
//	<<<ENGLISH>>>
//	I'm sorry Jack.
//	I'm taking up your time again.

/*ジャック、ごめんなさい。
時間を無駄にしたわね。*/
ライデン_036: {
Was?
}
//	<<<ENGLISH>>>
//	What?

/*え？*/
ローズ_037: {
Pa&~s auf Dich auf.
}
//	<<<ENGLISH>>>
//	Take care.

/*それじゃ、がんばって。*/
}//d



resource P020_01_R01_地雷原１無線デモ１＿１__g {
//vc112001
オルガ_000: {
Vorsicht!
Dieser Ort ist voller Claymore Minen!
}
//	<<<ENGLISH>>>
//	Be careful!
//	There are Claymore mines
//	around there.

/*気をつけろ！！*/
/*
オルガ_001: {
There are Claymore mines
around there.
}
*/
/*そこにはクレイモア地雷が
セットされている。*/
ライデン_002: {
Wer spricht da!?
}
//	<<<ENGLISH>>>
//	Who is this!

/*なんだっ！*/
}//d
//無線機のスクリーンにＥＦ連絡橋の映像が映る
resource P020_01_R01_地雷原１無線デモ１＿２__g {
//vc112002
オルガ_000: {
Claymore Minen mit Stealth-Technologie -
f&~ur das blo&~se Auge unsichtbar.
}
//	<<<ENGLISH>>>
//	Stealth-equipped Claymore mines,
//	invisible to the naked eye.

/*ステルス装備のクレイモアだ。
肉眼では見えない。*/
オルガ_001: {
Benutz' das Minensuchger&~at.
}
//	<<<ENGLISH>>>
//	Use the mine detector.

/*地雷探知機を使え！*/
ライデン_002: {
Identifizier' Dich.
}
//	<<<ENGLISH>>>
//	Identify yourself.

/*誰だ、おまえは？*/
オルガ_003: {
Nennen Sie mich Deepthroat.
}
//	<<<ENGLISH(2)>>>
//	Just call me "Deepthroat."

/*ディープ・スロートとでも
名乗っておこう。*/
ライデン_004: {
Deepthroat?
Wie in Shadow Moses?
}
//	<<<ENGLISH>>>
//	Deepthroat?
//	You mean from Shadow Moses?


/*ディープ・スロート？
シャドー・モセス事件の？*/
オルガ_005: {
Oder Mr. X.
}
//	<<<ENGLISH>>>
//	Mr. X, then.

/*いや、ミスターＸとでも言っておこう。*/
ライデン_006: {
Also jetzt Mr. X? Warum soll ich
Dich nicht Deepthroat nennen?
}
//	<<<ENGLISH>>>
//	Mr. X now, is it? Why would it
//	matter if I called you Deepthroat?

/*ミスターＸ？
どうした？
なぜ言い直す？*/
オルガ_007: {
Vergessen Sie das.
}
//	Never mind about that.

/*そんな事はどうでもいい。*/
ライデン_008: {
Warum hast Du mich kontaktiert?
}
//	<<<ENGLISH(2)>>>
//	Why did you contact me?

/*何者だ、なぜ俺に忠告を？*/
オルガ_009: {
Sagen wir, ich bin einer Deiner Fans.
}
//	<<<ENGLISH>>>
//	Let's just say I'm
//	one of your fans.

/*ファンの一人だよ。*/
}//d
resource P020_01_R01_地雷原１無線デモ１＿３__g {
//vc112003
ライデン_000: {
Oberst, jemand, der sich Mr. X nennt,
hat mich gerade kontaktiert. Hast Du
schon von ihm geh&~ort?
}
//	<<<ENGLISH>>>
//	Colonel, someone calling himself
//	Mr. X just contacted me. Do you
//	know anything about it?

/*大佐、ミスターＸという人物から
無線連絡が入った。何者だ？*/
大佐_001: {
Nein. Wer auch immer das war,
es war keine Burst-&~Ubertragung.
}
//	<<<ENGLISH>>>
//	No -- and whoever it was, it
//	wasn't a burst transmission.

/*わからない。バースト通信では
なかったようだ。*/
//<ページ数変更>
大佐_001_1: {
Die Verbindung wurde aus
der Big Shell hergestellt.
}
//	<<<ENGLISH>>>
//	The transmission was sent
//	from within the Big Shell.

/*『ビッグ・シェル』
内部から発信されている。*/
ライデン_002: {
Er nannte sich zun&~achst 'Deepthroat'.
Glaubst Du?
}
//	<<<ENGLISH>>>
//	He called himself "Deepthroat"
//	at first. Do you think -- ?

/*やつは最初、ディープ・スロートと
名乗った。まさか……？*/
大佐_003: {
Das habe ich auch geh&~ort,
aber es kann gar nicht stimmen.
}
//	<<<ENGLISH(2)>>>
//	I caught that part too, but the
//	possibility of it being true is
//	none.

/*ああ、私も聞いた。
しかし、それはありえん事だ。*/
大佐_004: {
In Shadow Moses benutzte Gray Fox
diesen Spitznamen, und er ist tot.
}
//	<<<ENGLISH>>>
//	Gray Fox was the one who used
//	that alias in Shadow Moses, and
//	he's dead.

/*シャドーモセス事件でその名を語った
グレイ・フォックスは既に死んでいる。*/
ライデン_005: {
Ist das eine Falle?
}
//	<<<ENGLISH>>>
//	Is it an enemy trap?

/*敵だと思うか？*/
大佐_006: {
M&~oglich.
Sei sehr vorsichtig.
}
//	<<<ENGLISH>>>
//	Could be.
//	Exercise extreme caution.

/*わからん……注意しろ。*/
}//d

//ここ

resource P021_02_R01_爆弾解体オルガ登場２無線デモ１＿１__g {
//vc112101
ライデン_000: {
Ich habe eine Soldatin gesehen - Russin.
}
//	<<<ENGLISH>>>
//	I saw a female soldier -- Russian.

/*ロシア人の女兵士を見かけた。*/
プリスキン_001: {
Das mu&~s Olga Gurlukovich gewesen sein.
}
//	<<<ENGLISH>>>
//	Must be Olga Gurlukovich.

/*ああ、
彼女はオルガ・ゴルルコビッチ……。*/
ライデン_002: {
Woher wei&~st Du das?
}
//	<<<ENGLISH>>>
//	How do you know?

/*何故、知ってる？*/
プリスキン_003: {
Im Unterschied zu Dir hatte
ich eine Einsatzbesprechung.
}
//	<<<ENGLISH>>>
//	Unlike you, I've been briefed.

/*お前と違って、ブリーフィングを
受けたからな。*/
ライデン_004: {
Sie geh&~ort nicht zu Dead Cell?
}
//	<<<ENGLISH>>>
//	She's not a Dead Cell?

/*デッドセルではないのか？*/
プリスキン_005: {
Nein, sie befehligt russische Milizen.
}
//	<<<ENGLISH>>>
//	No, she commands
//	a Russian private army.

/*ロシア私兵部隊のリーダーだ。*/
ライデン_006: {
Das mu&~s die Gruppe sein,
die in der Big Shell patrouilliert.
}
//	<<<ENGLISH>>>
//	They must be the ones
//	patrolling the Big Shell.

/*『ビッグ・シェル』内を巡回している
奴等だな。*/
プリスキン_007: {
Ja. Sie f&~uhrt die Gruppe seit dem Tod
ihres Vaters, Oberst Gurlukovich, an.
}
//	<<<ENGLISH>>>
//	That's right. She's led the group
//	ever since her old man, Colonel
//	Gurlukovich, died.

/*ああ。親父のゴルルコビッチ大佐が
死んで以来、彼女が部隊を統率している。*/
プリスキン_008: {
Pa&~s gut auf.
Sie ist z&~ah.
}
//	<<<ENGLISH>>>
//	Watch yourself with her.
//	She's a tough one.

/*あの女には注意するんだ。
かなりできるぞ。*/
}//d



resource P022_01_R01_爆弾解体最後から二つ目１無線デモ１＿１__g {
//vc112201
ピーター_000: {
Gute Arbeit.
Nur noch eine.
}
//	<<<ENGLISH>>>
//	Good work.
//	Only one more left to go...

/*よくやった。残りは後、一つ……。*/
}//d
resource P022_01_R01_爆弾解体最後から二つ目１無線デモ１＿２__g {
//vc112002
プリスキン_001: {
Hier Pliskin.
H&~orst Du mich, Peter?
}
//	<<<ENGLISH>>>
//	This is Pliskin.
//	Do you read me, Pete?

/*こちらプリスキン、親父さん、
聞こえるか？*/
ピーター_002: {
Ich bin hier. Was gibt's?
}
//	<<<ENGLISH>>>
//	I'm here. What's up?

/*こちら、スティルマン。
どうした？*/
プリスキン_003: {
Raiden, Du mu&~st auch zuh&~oren.
}
//	<<<ENGLISH>>>
//	Raiden, you need
//	to hear this too.

/*ライデンも聞いてくれ。*/
ライデン_004: {
Ich h&~ore.
}
//	<<<ENGLISH>>>
//	I'm listening.

/*聞いてる。*/
プリスキン_005: {
Ich habe den Fu&~s von Strebe H
f&~ur Dich &~uberpr&~uft, Pete.
}
//	<<<ENGLISH>>>
//	I checked out the bottom
//	of Strut H for you, Pete.

/*親父さんに言われて、
Ｈ脚の脚底部を調べてみた。*/
ライデン_006: {
Warte - was soll das?
}
//	<<<ENGLISH>>>
//	Wait -- what's this about?

/*何を？*/
ピーター_007: {
Ich bat Pliskin, sich mal umzuschauen.
}
//	<<<ENGLISH>>>
//	I asked Pliskin
//	to look around.

/*私がプリスキンに頼んだのだ。*/
//<ページ数変更>
ピーター_007_1: {
Ich kenne Fatman und bef&~urchte,
die bisherigen Bomben waren
T&~auschungsman&~over.
}
//	<<<ENGLISH>>>
//	Knowing Fatman, I can't shake the
//	feeling that all the bombs so far
//	were just wrong.

/*爆薬をセットする位置の選択が、
ファットマンらしくない……。*/
ライデン_008: {
Und, hast Du etwas gefunden?
}
//	<<<ENGLISH>>>
//	So did you find anything?

/*それで？*/
プリスキン_009: {
Einen ganzen Haufen von C4s im
Strebenfu&~s. Pete hatte recht.
}
//	<<<ENGLISH>>>
//	A hell of a lot of C4's packed
//	into the bottom of the strut.
//	Pete called it right.

/*あんたの言う通り、脚底部にＣ４が
大量にセットされていた。*/
ピーター_010: {
Ich wu&~ste, da&~s er seinen Trumpf
noch im &~Armel hatte.
}
//	<<<ENGLISH>>>
//	I knew he had the real
//	thing up his sleeve...

/*やはりな。
あいつめ……それが本命だ。*/
ライデン_011: {
Alle anderen waren also nur Attrappen?
}
//	<<<ENGLISH>>>
//	So all the other ones
//	were dummies?

/*それじゃ、今までのはダミー？*/
ピーター_012: {
Nein, sie stellten schon
eine Bedrohung dar.
}
//	<<<ENGLISH>>>
//	No, they're a threat all right,
//	but the detonation wouldn't be
//	enough to destroy the entire Shell.

/*いや、どれも脅威である事は
間違いないが、１つの爆発でこの
『ビッグ・シェル』が沈む程ではない。
*/
ピーター_013: {
Aber die C4s, die Pliskin fand, sind
im stande, die Gesamtkonstruktion
zu gef&~ahrden.
}
//	<<<ENGLISH>>>
//	But the C4's Pliskin found would
//	inflict serious structural damage.

/*しかし、その脚底部は違う、
かなりのダメージになる。*/
プリスキン_014: {
Num die schlechte Nachricht:
Diese C4s sind zudem sensorgesch&~utzt.
}
//	<<<ENGLISH>>>
//	That's not the bad news either.
//	These are sensor-proof.

/*それだけじゃない。
その爆弾はセンサーに反応しない。*/
ピーター_015: {
Was!?
}
//	<<<ENGLISH(2)>>>
//	What!

/*なんだと！？*/
プリスキン_016: {
Neues Modell, nehm' ich an. Der
Ionisierungssensor kann sie nicht
aufsp&~uren.
}
//	<<<ENGLISH>>>
//	New model, I guess.
//	The ionization sensor
//	can't detect them.

/*新型だ。
臭いセンサーではつかめない。*/
プリスキン_017: {
Um ein Dampfleck zu verhindern, wurde
alles abgedichtet. Es gibt keine Anzeichen
f&~ur diese Parf&~ummarke.
}
//	<<<ENGLISH>>>
//	The whole thing is sealed tight to
//	prevent vapor leak, and there's no
//	trace of that cologne signature.

/*Ｃ４から発生する気化ガスが外に
漏れない様、厳重にシールドしてある。
サインの香水もない……。*/
プリスキン_018: {
Pete, es scheint, er hat Dich ausgetrickst.
}
//	<<<ENGLISH>>>
//	Pete, looks like
//	he fooled you.

/*親父さん、読みは外れたな？*/
ピーター_019: {
Ja.
}
//	<<<ENGLISH>>>
//	Yes...

/*……うむ……。*/
ライデン_020: {
Aber Du hast das Ding trotzdem
gefunden??
}
//	<<<ENGLISH>>>
//	But you managed to
//	find the thing anyway?

/*よく見つけたな？*/
プリスキン_021: {
Reines Gl&~uck.
}
//	<<<ENGLISH>>>
//	It was sheer luck.

/*全くの偶然だ。
危ないところだった……。*/
ライデン_022: {
Bomben, die f&~ur den Sensor
unsichtbar sind.
}
//	<<<ENGLISH>>>
//	Bombs that are invisible
//	to the sensor...

/*センサーに反応しない爆弾……。*/
プリスキン_023: {
Irgendwelche Ideen, Pete?
}
//	<<<ENGLISH>>>
//	Any ideas, Pete?

/*親父さん、どうしたらいい？*/
ライデン_024: {
Gibt es da noch mehr?
}
//	<<<ENGLISH>>>
//	Are there more out there?

/*他にもあるんだろうか？*/
ピーター_025: {
Ich werde selbst nachsehen.
}
//	<<<ENGLISH>>>
//	I'll go see for myself.

/*……わかった。私が行く。
見てみなければわからん。*/
ライデン_026: {
Du bist nicht schnell genug.
}
//	<<<ENGLISH>>>
//	You can't move fast enough.

/*その足じゃ無理だ。*/
プリスキン_027: {
Er hat recht. Ich kann versuchen,
aus der Entfernung zu spr&~uhen.
}
//	<<<ENGLISH>>>
//	He's right. I can try
//	the spray from a distance.

/*そうだな。
冷却スプレーで試してみよう。*/
ピーター_028: {
Einen Augenblick! Hier stimmt
irgendetwas nicht. Ich sp&~ure das.
}
//	<<<ENGLISH>>>
//	Hold on!
//	There's something not right
//	about this one, I can feel it.

/*待てっ！こいつには何かある！！*/
プリスキン_029: {
Nun, Pete?
Soll ich zur&~uckkommen und Dich holen?
}
//	<<<ENGLISH>>>
//	Well, Pete?
//	Should I come back and get you?

/*どうする？
親父さん、迎えに行ってやろうか？*/
ピーター_030: {
Nicht n&~otig. Raiden, Du mu&~st
noch eine entsch&~arfen, oder?
}
//	<<<ENGLISH>>>
//	No, there's no need.
//	Raiden, you have one
//	left to go, correct?

/*いや、大丈夫だ。
ライデンは後、一つだったな？*/
ライデン_031: {
Stimmt - abgesehen von diesen
geruchlosen.
}
//	<<<ENGLISH>>>
//	Right -- except for
//	those scentless ones.

/*そうだ。ただし、『臭いのあるＣ４』は、
という意味だが。*/
ピーター_032: {
Wie steht es mit Dir, Pliskin?
}
//	<<<ENGLISH>>>
//	How about you, Pliskin?

/*プリスキンは？*/
プリスキン_033: {
Au&~ser dieser mu&~s ich noch zwei
entsch&~arfen.
}
//	<<<ENGLISH>>>
//	I have two left not
//	counting this one.

/*俺はこいつを除いても後、２つ……。*/
ピーター_034: {
Ok. Ich mu&~s es tun. Ich besitze die Karte
f&~ur Stufe 4. Damit komme ich auf jeden
Fall in Shell 2.
}
//	<<<ENGLISH(2)>>>
//	OK... It'll have to be me. I have
//	the level 4 card that'll get me
//	into Shell 2 in any case.

/*うむ……やはり、私が行く。
シェル２へ行けるカード４も持っている。*/
ライデン_035: {
Das schaffst Du nie. Mit Deinem Bein
wirst Du garantiert entdeckt.
}
//	<<<ENGLISH>>>
//	You'll never make it. With that
//	bad leg of yours, they'll spot
//	you for sure.

/*無理だ。
その脚では途中で敵に見つかる……。*/
ピーター_036: {
Dazu wird es nicht kommen.
Ich -
}
//	<<<ENGLISH>>>
//	That won't happen.
//	I...

/*その心配はいらん。
実は……。*/
ピーター_037: {
Ich kann normal gehen.
}
//	<<<ENGLISH>>>
//	I can walk just fine.

/*私は歩けるのだ。*/
ピーター_038: {
Ich kann sogar rennen.
}
//	<<<ENGLISH>>>
//	I can even run...

/*そればかりか、走ることもできる……。*/
プリスキン_039: {
Was soll das hei&~sen?
}
//	<<<ENGLISH(2)>>>
//	What do you mean?

/*どういう事だ……。*/
ピーター_040: {
Diese Bombe vor f&~unf Jahren. Trotz all
meiner Erfahrung hatte ich versagt.
}
//	<<<ENGLISH>>>
//	That bomb, five years ago.
//	I messed up. Even with all
//	my experience, I lost it.

/*５年前の事だ。
年甲斐もなく、びびってしまった。*/
ピーター_041: {
Eine Kirche wurde durch die Explosion
zerst&~ort. Und all die Kinder, die nebenan
spielten.
}
//	<<<ENGLISH>>>
//	And a church was lost in the
//	explosion. All those kids
//	playing nearby too...

/*おかげで教会が爆発した。
近隣の子供たちも巻き添えを食った。*/
//<ページ数変更>
ピーター_041_1: {
Die letzten f&~unf Jahre war
ein Leben in L&~uge.
}
//	<<<ENGLISH>>>
//	These past five years,
//	I've lived a lie.

/*この５年間、私は嘘をついてきた……。*/
ライデン_042: {
L&~uge?
}
//	<<<ENGLISH>>>
//	Lied?

/*嘘？*/
ピーター_043: {
Ja, L&~uge. Ich habe mein Bein nicht
bei der Explosion verloren.
}
//	<<<ENGLISH>>>
//	Yes, lied. I didn't lose
//	my leg in the explosion.

/*そうだ。
私は右足を失ってなどおらん。*/
プリスキン_044:
''
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
ピーター_045: {
So viele Tote - nur weil
ich einen Fehler machte.
}
//	<<<ENGLISH>>>
//	So many dead -- all
//	because of my mistake.

/*私の失敗で……
あまりにも多くの犠牲が出た。*/
ピーター_046: {
Ich wollte meinen Fehler vertuschen,
mich vor dem &~offentlichen Aufschrei
verbergen.
}
//	<<<ENGLISH>>>
//	All I could think about was hiding
//	from the crime, shielding myself
//	from the public outcry.

/*私は……
あろう事か、世間の同情を買おうとした。
*/
ピーター_047: {
Man sollte mit mir Mitleid haben,
wegen meiner Schw&~ache.
}
//	<<<ENGLISH>>>
//	I wanted people to be sorry
//	for me, for my weakness...

/*攻撃の目をそらそうとした。
非難を逃れようとした。*/
ライデン_048:
''
/*……。*/
ピーター_049: {
Ich gab vor, selbst ein Opfer zu sein, weil
ich den Familien der echten Opfer einfach
nicht ins Gesicht sehen konnte.
}
//	<<<ENGLISH>>>
//	I faked being a victim myself
//	because I couldn't bear to face
//	the families of the real victims.

/*周りの視線から逃れるために、
仮病を使ったのだ。*/
ピーター_050: {
Ich trage keine Prothese. Ich kann
&~uber Balken laufen und W&~usten zu
Fu&~s durchqueren.
}
//	<<<ENGLISH>>>
//	This is no prosthetic. I can
//	keep my footing on catwalks
//	and hike over deserts.

/*私の脚は義足ではない。
歩くことも、走ることもできる。*/
ピーター_051: {
Ich habe diese L&~uge gelebt - ohne
mir selbst Rechenschaft abzulegen.
}
//	<<<ENGLISH>>>
//	I lived my lie so well I
//	haven't even answered to
//	myself for my sins...

/*私は嘘をつくことで、
自分の罪から逃れてきた。*/
ピーター_052: {
Es sollte ein Schutzschild sein.
}
//	<<<ENGLISH>>>
//	It was supposed to be a shield.

/*世間への嘘だったはずが……。*/
ピーター_053: {
Und entpuppte sich als Leichentuch.
}
//	<<<ENGLISH>>>
//	And it's become a shroud instead.

/*時を経る毎に己への嘘となっていった。*/
ピーター_054: {
Ich verlor meine Seele,
indem ich das Opfer spielte.
}
//	<<<ENGLISH>>>
//	I've killed my soul by
//	playing the victim.

/*自ら被害者を演じることで、世間を、
いや自分を騙してきた。*/
ピーター_055: {
Statt mich zu sch&~utzen, wurde mein Leben
noch unertr&~aglicher.
}
//	<<<ENGLISH>>>
//	Instead of protecting me,
//	it's made my life even more
//	hellish.

/*身を守るはずの嘘が、やがて自分への
重圧へと変わっていった。*/
プリスキン_056: {
Was nutzt sowas schon den Opfern?
}
//	<<<ENGLISH>>>
//	What good can that
//	do the victims?

/*そんな事で犠牲者が浮かばれるとでも？*/
ピーター_057: {
Ich wei&~s - ich bin ein Feigling.
}
//	<<<ENGLISH>>>
//	I know -- I'm a coward!

/*そうだ、私は卑怯者だ！*/
プリスキン_058: {
He, Pete.
}
//	<<<ENGLISH>>>
//	Hey, Pete...

/*親父さん……。*/
ピーター_059: {
Gott, vergib mir.
}
//	<<<ENGLISH>>>
//	God forgive me...

/*許してくれ！*/
ピーター_060: {
Ich kann mit meinen eigenen F&~u&~sen laufen.
}
//	<<<ENGLISH>>>
//	I can walk with my own two feet.

/*若者たちよ。
いいか、私は歩ける。*/
ピーター_061: {
Und ich brauche sie, um Fatman zu
stoppen. Seine Verbrechen sind auch
meine - Niemand sollte die Fertigkeiten,
}
//	<<<ENGLISH>>>
//	And I need them to stop Fatman.
//	His crimes are also mine -- one
//	of omission, and arrogance.

/*ファットマンは私が止めねばならん。
あいつの暴走も私の責任……私の罪だ。*/
ピーター_062: {
die ich ihm vermittelt habe,
ohne ein reines Gewissen vermitteln.
}
//	<<<ENGLISH>>>
//	No one should teach the skills
//	I taught him without a clear
//	conscience.

/*自分を欺き、大切なものを何も
伝えられなかった、私の……。*/
ピーター_063: {
Das ist der einzige Weg,
f&~ur meine S&~unden zu s&~uhnen.
}
//	<<<ENGLISH>>>
//	This is the only way
//	I can defuse my own sins.

/*これから自分の罪を解体しにいく！*/
プリスキン_064: {
Ich hol' Dich ab.
Das hier &~uberlassen wir Dir.
Verstanden, Raiden?
}
//	<<<ENGLISH>>>
//	I get you, Pete.
//	That one's all yours.
//	You got it, Raiden?

/*わかった、親父さん。任せる。
……ライデンもいいな。*/
ライデン_065: {
Verstanden.
}
//	<<<ENGLISH(2)>>>
//	I understand.

/*ああ……。*/
プリスキン_066: {
Pete, die Wachen in den Streben G und H
von Shell 2 sind erledigt.
}
//	<<<ENGLISH>>>
//	Pete, I've taken care of
//	guards in Struts G and H
//	of Shell 2.

/*親父さん、シェル２のＧ脚とＨ脚の
敵兵は排除した。*/
//<ページ数変更>
プリスキン_066_1: {
Ich empfehle Dir,
keine andere strebe zu betreten.
}
//	<<<ENGLISH>>>
//	I wouldn't recommend you go
//	into any of the other struts.

/*他の脚へは出入り
するなよ。*/
ピーター_067: {
Ich schulde Dir etwas.
}
//	<<<ENGLISH(2)>>>
//	I owe you one.

/*すまんな。*/
プリスキン_068: {
Ich mache mich dann mal wieder an
die Arbeit Bady bomben einfrieren.
}
//	<<<ENGLISH>>>
//	I'll get back to freezing
//	the baby bombs then.

/*それじゃ、俺は爆弾解体を続ける。*/
ピーター_069: {
Das gilt auch f&~ur Dich, Raiden.
}
//	<<<ENGLISH>>>
//	You do that too, Raiden.

/*ライデンも解体に戻ってくれ。*/
ライデン_070: {
Schon dabei.
}
//	<<<ENGLISH(2)>>>
//	I'm on it.

/*わかった。*/
ピーター_071: {
Ich nehme das Funkger&~at mit,
f&~ur alle F&~alle.
}
//	<<<ENGLISH(2)>>>
//	I'll have the radio with me,
//	if you need to get in touch.

/*無線機を持っていく。
何かあれば連絡をくれ。*/
ピーター_072: {
Aber fragt nicht nach dem 'Hinkepeter'.
Den gibt's nicht mehr.
}
//	<<<ENGLISH>>>
//	Just don't ask for "Peg-Legged
//	Peter." He's gone for good.

/*『義足のピーター』のニックネームも
今日で終わりだ。*/
}//d


resource P023_01_R01_爆弾解体最後の一つ１無線デモ１＿１__g {
//vc112301
ライデン_000: {
Ich habe die letzte C4 eingefroren.
Jetzt zeigt der Sensor nichts mehr an.
}
//	<<<ENGLISH>>>
//	I have the last C4 frozen.
//	There's nothing showing
//	up on the sensor now.

/*最後のＣ４を解体した。
センサーに映るものは、もうない。*/
ピーター_001: {
Gut gemacht, Raiden.
}
//	<<<ENGLISH(2)>>>
//	Good work, Raiden.

/*よし。
よくやった、ライデン。*/
プリスキン_002: {
Du bist viel schneller als ich, Junge.
Ich hab' noch eine.
}
//	<<<ENGLISH>>>
//	You're way ahead of me, kid.
//	I still have one to go.

/*先を越されたな。
俺の方はまだ１つ残っている。*/
ライデン_003: {
Wie steht's mit Deiner Bombe, Peter?
}
//	<<<ENGLISH>>>
//	How's your bomb, Peter?

/*スティルマンの方は？*/
ピーター_004: {
Das ist eine richtige Bombe.
Versiegelte C4s, in riesigen Mengen.
}
//	<<<ENGLISH>>>
//	It's a bomb all right.
//	Sealed C4, and in huge
//	quantities...

/*間違いない。無臭のＣ４だ。
しかも、凄い量だ……。*/
ライデン_005: {
Meinst Du, in Shell 1 ist noch
eine versteckt?
}
//	<<<ENGLISH>>>
//	You think there's
//	another one in Shell 1?

/*シェル１にもあると思うか？*/
ピーター_006: {
Garantiert. Irgendwo im Fu&~s von Strebe A.
}
//	<<<ENGLISH>>>
//	For sure. Somewhere at
//	the bottom of Strut A.

/*ある。
おそらく、Ａ脚底部のどこか。*/
ライデン_007: {
Wie kannst Du Dir so sicher sein?
}
//	<<<ENGLISH>>>
//	Why are you so certain?

/*確かか？*/
ピーター_008: {
Wenn der untere Teil dieser Strebe
zerst&~ort wird, geh&~ort Shell 2 so gut
wie der Vergangenheit an.
}
//	<<<ENGLISH>>>
//	If this bottom section of the strut
//	is demolished, Shell 2 will be well
//	on its way to destruction.

/*この脚底部を破壊すると、
シェル２はほぼ壊滅する。*/
プリスキン_009: {
Meinst Du, Shell 2 wird sinken?
}
//	<<<ENGLISH>>>
//	You mean that Shell 2
//	will actually sink?

/*シェル２が沈むという事か？*/
ピーター_010: {
Nicht sofort.
Es gibt noch immer 5 Streben.
}
//	<<<ENGLISH>>>
//	Not immediately. There'll
//	still be five struts left.

/*いや、すぐには沈まん。
この脚が破壊されてもまだ５脚
残っている。*/
/* 以下は無しだったのでは？？？
プリスキン_011: {
どうなる？
}
ピーター_012: {
まず中心部が浸水する……。
}
*/
ピーター_013: {
Aber wenn Shell 1 gleichzeitig auch
eine Strebe verliert, sieht es ziemlich
d&~uster aus.
}
//	<<<ENGLISH>>>
//	But, if Shell 1 loses a strut at
//	the same time, it'll be a very
//	different story.

/*ただし、シェル１も同時に爆発すれば
そうはいかない。*/
ピーター_014: {
Die Gesamtstruktur der Big Shell basiert
auf einem sehr pr&~azisen Gleichgewicht.
}
//	<<<ENGLISH>>>
//	The Big Shell's structural
//	integrity depends on a very
//	exact balance.

/*『ビッグ・シェル』は微妙な均衡で
姿勢を保っている。*/
ピーター_015: {
Wenn beide Shells je eine Strebe verlieren,
bricht die gesamte Konstruktion
auseinander.
}
//	<<<ENGLISH>>>
//	If both Shells lose a strut each,
//	the whole structure will tear
//	itself apart under its own weight.

/*シェル１も爆破されれば自重を
支え切れなくなり……自壊する。*/
ライデン_016: {
Was machen wir jetzt?
}
//	<<<ENGLISH>>>
//	What do we do?

/*どうすればいい？*/
ピーター_017: {
Ich habe einen Sensor,
der die geruchlosen C4s aufsp&~uren kann.
}
//	<<<ENGLISH>>>
//	I have a sensor that can locate
//	even those scentless C4's.

/*無臭のＣ４も探知できるセンサーがある。*/
//<ページ数変更>
ピーター_017_1: {
Er arbeitet mit einem Neutronenszintillator
und einem H-Bomben-Detektor.
}
//	<<<ENGLISH>>>
//	It makes combined use of a neutron
//	scintillator and a hydrogen bomb
//	detector.

/*中性子後方散乱装置と水素爆発物探知機
を併用したものだ。
*/
}//d

resource P023_01_R01_爆弾解体最後の一つ１無線デモ１＿センサーＢなし__g {
ライデン_000: {
Du hast das Zeug mitgebracht?
}
//	<<<ENGLISH>>>
//	You brought that stuff with you?

/*そんなものを持って来てたのか？*/
ピーター_001: {
Nat&~urlich. Ich habe den Sensor
im Vorratsraum kalibriert.
}
//	<<<ENGLISH>>>
//	Of course. I made the
//	calibrations while
//	I was in the pantry.

/*ああ……。
貯蔵庫の中で調整しておいた。*/
}//d

resource P023_01_R01_爆弾解体最後の一つ１無線デモ１＿２__g {
ライデン_000: {
Funktioniert er denn?
}
//	<<<ENGLISH>>>
//	Does it work?

/*使えるのか？*/
ピーター_001: {
Ich habe ihn gerade getestet.
Er reagiert wirklich.
}
//	<<<ENGLISH>>>
//	I just tested it, and
//	it definitely responds.

/*ここで試した。確かに反応する。*/
//<ページ数変更>
ピーター_001_1: {
Aber das Beste, was mir ich habe,
ist aber ein Schallsignal,
nicht der Radar.
}
//	<<<ENGLISH>>>
//	But the best I can do is a
//	sound beacon, not the radar.

/*ただし、レーダー・スクリーンではなく、
音で知らせる仕組みだ。
*/
ライデン_002: {
Schall?
}
//	<<<ENGLISH(2)>>>
//	Sound?

/*音？*/
ピーター_003: {
Je k&~urzer der Abstand zwischen
den Signalen, desto n&~aher das Ziel.
}
//	<<<ENGLISH>>>
//	The shorter the interval between
//	beacons, the closer the target.

/*音の間隔だ。
短くなる程接近していることを意味する。*/
ライデン_004: {
Verstehe.
}
//	<<<ENGLISH(2)>>>
//	I get you.

/*わかった。*/
ピーター_005: {
Im Vorratsraum ist noch einer.
Du kannst zur&~uckgehen und ihn holen.
}
//	<<<ENGLISH>>>
//	There's another one in that
//	pantry I was in. You can go
//	back and get it.

/*私のいた貯蔵庫にもう一式ある。
取りに行ってくれ。*/
プリスキン_006: {
Du kannst ihn haben, Raiden.
}
//	<<<ENGLISH>>>
//	It's all yours, Raiden.

/*ライデン、そっちは頼んだぞ。*/
ピーター_007: {
Ich werde sie genauer untersuchen und
pr&~ufen, ob das Einfrieren funktioniert.
}
//	<<<ENGLISH>>>
//	I'm going to study it some more,
//	and see if the freezing process
//	will work.

/*もう少し、調べて、冷却できるかどうか
試してみる。*/
//<ページ数変更>
ピーター_007_1: {
Ber&~uhrt die andere erst,
wenn ich es sage.
}
//	<<<ENGLISH>>>
//	Don't touch the other
//	one until I say so.

/*それまでは手を出すな。*/
ライデン_008: {
OK. Ich warte auf Deine Anweisung.
}
//	<<<ENGLISH>>>
//	OK. I'll standby
//	until you radio in.

/*わかった。連絡を待つ。*/
}//d



resource P024_01_R01_爆弾解体センサーＢ入手１無線デモ１＿１__g {
//vc112401
ライデン_000: {
Peter, ich habe Sensor B.
}
//	<<<ENGLISH>>>
//	Peter, I have Sensor B.

/*スティルマン、センサーＢを入手した。*/
ピーター_001: {
Gut.
Gehe zu Strebe A.
}
//	<<<ENGLISH>>>
//	Good.
//	Head to the bottom of Strut A.

/*そうか、Ａ脚底部に向かってくれ。*/
}//d

resource P024_01_R01_爆弾解体センサーＢ入手１無線デモ１＿１Ａ__g {
ライデン_002: {
Was ist mit der unsichtbaren Bombe?
}
//	<<<ENGLISH>>>
//	How's your invisible bomb?

/*無臭爆弾はどうなった。*/
ピーター_003: {
Ich sehe sie, aber halte mich noch fern.
Wie kommt Pliskin voran?
}
//	<<<ENGLISH>>>
//	I'm looking at it, but I'm keeping
//	my distance. How's Pliskin doing?

/*目の前にあるが、まだ近づいてはいない。
プリスキンの方はどうだ？*/
プリスキン_004: {
Ein paar Minuten noch.
}
//	<<<ENGLISH>>>
//	A few more minutes...

/*もう少し待ってくれ。*/
//<ページ数変更>
プリスキン_004_1: {
Ich habe gerade die letzte Strebe erreicht,
ich mu&~s aber noch ein paar wachposten
erledigen.
}
//	<<<ENGLISH>>>
//	I just got to the last strut, but
//	there are a few enemy sentries
//	I have to take care of.

/*今最後の脚に到着した。
敵兵が邪魔だ。先に排除する……。*/
ライデン_005: {
Ist es sehr ernst, Peter?
}
//	<<<ENGLISH>>>
//	Does it look bad, Peter?

/*……スティルマン、厄介そうなのか？*/
ピーター_006: {
M&~oglich. Sie ist merkw&~urdig. Der
Sprengz&~under wurde nicht aktiviert.
}
//	<<<ENGLISH>>>
//	Maybe. It's an odd one --
//	the detonator hasn't been
//	activated.

/*ああ。少し妙だ。
起爆装置が作動していない。*/
ライデン_007: {
Was?
}
//	<<<ENGLISH(2)>>>
//	What?

/*なに？*/
ピーター_008: {
Aber die Sensoren sind aktiv.
Das hei&~st.
}
//	<<<ENGLISH>>>
//	But the sensors are live...
//	Which means...

/*だがセンサーは生きている……
これは……。*/
プリスキン_009: {
Hier Pliskin.
Ich habe die letzte C4 gefunden.
}
//	<<<ENGLISH>>>
//	This is Pliskin.
//	I've located the last C4.

/*こちらプリスキン。
最後のＣ４を発見した。*/
ピーター_010: {
Das war's!?
}
//	<<<ENGLISH>>>
//	Is that it!?

/*まさか！？*/
プリスキン_011: {
Ich friere sie eben ein, dann.
}
//	<<<ENGLISH>>>
//	I'm about to freeze it.
//	Then --

/*今から凍結する。これで……。*/
ピーター_012: {
Warte! Pliskin!
}
//	<<<ENGLISH>>>
//	Wait! Pliskin!

/*プリスキン、待て！！*/
}//d

resource P024_01_R01_爆弾解体センサーＢ入手１無線デモ１＿２__g {
//vc112406
ピーター_000: {
Verdammt! DAS war's!
}
//	<<<ENGLISH>>>
//	Damn! That WAS it!

/*くっ！やはり！！*/
プリスキン_001: {
Was ist los?
}
//	<<<ENGLISH(2)>>>
//	What's going on!?

/*どうした！？*/
ピーター_002: {
Der Sprengz&~under wurde soeben aktiviert!
}
//	<<<ENGLISH>>>
//	The detonator just woke up.
//	It's counting down!

/*起爆装置が動き出した！
カウントダウンしている！*/
ライデン_003: {
Was ist passiert!?
}
//	<<<ENGLISH>>>
//	What happened!?

/*どういうことだ！？*/
ピーター_004: {
Die gro&~sen waren programmiert,
aktiviert zu werden, sobald alle
Mini-C4s ausgeschaltet sind.
}
//	<<<ENGLISH>>>
//	The big ones were rigged to be
//	activated when all the baby C4's
//	went offline...

/*通常のＣ４爆弾の信号が全て消えたら、
こちらの爆弾が起動する仕掛けになって
いたんだ……。*/
ピーター_005: {
Raiden, der Countdown in Shell 1
l&~auft sicher auch schon.
Beeil Dich!
}
//	<<<ENGLISH>>>
//	Raiden, the one in Shell 1
//	should be counting down too.
//	Hurry!

/*ライデン、シェル１の爆弾も起動して
いるはずだ！間違いない！急いでくれ！！*/
ライデン_006: {
Wieviel Zeit haben wir noch?
}
//	<<<ENGLISH>>>
//	What's the remaining time!?

/*残りカウントは！？*/
}//d
