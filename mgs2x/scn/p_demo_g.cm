resource P025_01_R01_爆弾解体昇降機下１無線デモ１＿１__g {
//vc112501
ピーター_000: {
Raiden, Pliskin,
h&~ort genau zu.
}
//	<<<ENGLISH>>>
//	Raiden, Pliskin,
//	listen carefully.

/*ライデン、プリスキン……
いいか、よく聞いてくれ！*/
ライデン_001: {
Was ist los?
}
//	<<<ENGLISH(2)>>>
//	What is it?

/*どうした？*/
ピーター_002: {
Ich bin drauf reingefallen.
}
//	<<<ENGLISH>>>
//	I fell for it.

/*まずった……。*/
プリスキン_003: {
Worauf reingefallen?
}
//	<<<ENGLISH>>>
//	Fell for what?

/*何があった？*/
ピーター_004: {
Fatman hat mich drangekriegt.
}
//	<<<ENGLISH>>>
//	Fatman has my number.

/*ファットマンにやられた。*/
ピーター_005: {
Ein N&~aherungsz&~under.
Mikrowelle.
}
//	<<<ENGLISH>>>
//	A proximity trigger.
//	Microwave.

/*距離だ。マイクロ波だ。*/
ライデン_006: {
Mikrowelle?
}
//	<<<ENGLISH>>>
//	Microwave?

/*マイクロ波？*/
ピーター_007: {
Mit einem Bereich von 2,5 m.
}
//	<<<ENGLISH(2)>>>
//	With a 7-foot range.

/*２メートル以内に近づくと感知する。*/
ピーター_008: {
Diese Technik hat er nicht von mir.
}
//	<<<ENGLISH>>>
//	It's not a technique
//	I taught him.

/*私の教えていないトラップだ。*/
ピーター_009: {
Auch nicht die Falle mit mehreren Bomben.
}
//	<<<ENGLISH>>>
//	Neither was that multi-bomb
//	booby trap.

/*さっきの仕掛けといい、このトラップと
いい…*/
//<ページ数変更>
ピーター_009_1: {
Er scheint mich mittlerweile &~uberfl&~ugelt zu
haben. Und was das &~Ubrige anbelangt.
}
//	<<<ENGLISH>>>
//	Looks like he's far surpassed me
//	as far as explosives technique goes.
//	As for the rest --

/*…爆弾の技術に関する限り、
奴は私を越えたな……。だが……。*/
プリスキン_010: {
Pete, mach, da&~s Du da rauskommst!
}
//	<<<ENGLISH>>>
//	Pete, get the hell out of there!

/*親父さん、逃げろっ！*/
ピーター_011: {
Es bleiben weniger als 30 Sekunden.
Zu sp&~at.
}
//	<<<ENGLISH>>>
//	There's less than 30 seconds
//	left. It's too late.

/*いや、後３０秒もない……。*/
ライデン_012: {
Nein!
}
//	<<<ENGLISH>>>
//	No!

/*そんな馬鹿なっ……。*/
ピーター_013: {
Pliskin, weg von Strebe H,
so schnell Du kannst.
}
//	<<<ENGLISH>>>
//	Pliskin, get away from Strut H,
//	as fast as you can.

/*プリスキン、Ｈ脚からなるべく離れろ！*/
プリスキン_014: {
Pete.
}
//	<<<ENGLISH>>>
//	Pete --

/*親父さん……。*/
ピーター_015: {
Raiden, halt Abstand.
}
//	<<<ENGLISH>>>
//	Raiden, keep your distance.

/*ライデン、近づいてはダメだ。*/
ピーター_016: {
Benutz das Spray aus m&~oglichst
gro&~ser Entfernung.
}
//	<<<ENGLISH>>>
//	Use the spray from as
//	far away as possible.

/*冷却スプレーは離れた位置から
噴射するんだ。*/
ライデン_017: {
Ich?
}
//	<<<ENGLISH>>>
//	Me?

/*俺にできるのか？*/
ピーター_018: {
Du kannst es.
Ich wei&~s es.
}
//	<<<ENGLISH>>>
//	You can do it.
//	I know that.

/*おまえならできる、いいな。*/
ライデン_019: {
Ich bin mir da nicht so sicher.
}
//	<<<ENGLISH>>>
//	I'm not so sure...

/*無理だ……。*/
ピーター_020: {
Aber ich. Tu,s ich wei&~s,
da&~s Du es kannst.
}
//	<<<ENGLISH>>>
//	But I am. Do it,
//	I know you can.

/*大丈夫、やるんだ。おまえならできる。*/
}//d

resource P025_01_R01_爆弾解体昇降機下１無線デモ１＿２__g {
