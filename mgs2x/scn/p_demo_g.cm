resource P065_06_R02_Ｌ脚エマ６無線機デモ２＿３__g {
//vc116513
ライデン_000: {
Nicht schlecht. Von hier aus habe
ich gute Sicht auf die Ziele.
}
//	<<<ENGLISH>>>
//	Not bad. This spot gives me
//	a good view of the targets.

/*なるほど、
ここは狙撃ポイントに最適だな。*/
プリスキン_001: {
Du wirst Emma decken m&~ussen,
bis sie Strebe E erreicht.
}
//	<<<ENGLISH>>>
//	You're going to have to
//	cover Emma until she
//	crosses to Strut E.

//<ページ数変更>
プリスキン_001_1: {
Ich komme dorthin und unterst&~utze Dich.
}
//	<<<ENGLISH>>>
//	I'll get there and provide
//	some support of my own.

/*エマがＥ脚まで渡り切るのを
サポートするんだ。俺もＥ脚まで
行って援護する。
*/
ライデン_002: {
Danke.
}
//	<<<ENGLISH>>>
//	Thanks.

/*それはありがたい。*/
プリスキン_003: {
Glaubst Du, Du wirst damit fertig?
}
//	<<<ENGLISH>>>
//	Think you can handle it?

/*狙撃の腕に自信は？*/
ライデン_004: {
Ja, ich kenne das Verfahren.
}
//	<<<ENGLISH>>>
//	Yeah. I know the drill.

/*大丈夫だ、このシチュエーション。*/
ライデン_005: {
Ich habe eine &~ahnliche Situation mit
dem PSG1 im VR-Training Level 4,
fortgeschrittene Modus, ge&~ubt.
}
//	<<<ENGLISH>>>
//	I've faced a similar situation
//	in Advanced Mode Level 4 VR
//	training with the PSG1.

/*ＶＲ訓練で経験済みだ。
アドバンスドモードのＰＳＧ１、
ＬＥＶＥＬ４……。*/
プリスキン_006: {
VR? Na, besser als nichts. Pa&~s auf,
da&~s Du nicht Emma triffst.
}
//	<<<ENGLISH>>>
//	VR...? Guess that's better
//	than nothing. Make sure you
//	don't hit Emma.

/*またＶＲか。
いいか、彼女を傷つけるんじゃないぞ。*/
プリスキン_007: {
Da alles an Bord von Arsenal geht, d&~urften
die momentanen Sicherheitsvorkehrungen
minimal sein,
}
//	<<<ENGLISH>>>
//	Right now, with Arsenal's boarding
//	in progress, security should be at
//	a minimum.

//<ページ数変更>
プリスキン_007_1: {
Was nicht hei&~st, da&~s es einfach wird.
}
//	<<<ENGLISH>>>
//	That doesn't mean it's
//	going to be easy.

/*既にアーセナルへの待避が始まっている。
敵兵は最低限しか残されていない
だろうが、気を抜くな。
*/
プリスキン_008: {
Sie haben vermutlich Claymores
aufgestellt, um die fehlenden
Wachposten wettzumachen.
}
//	<<<ENGLISH>>>
//	Given the situation, they've
//	probably got Claymores in place to
//	make up for the security shortage.

/*地形から考えて、人数をカバーする
ためにクレイモアをしかけている
可能性が高い。
*/
プリスキン_009: {
Vergi&~s Dein Infrarotsichtger&~at nicht.
}
//	<<<ENGLISH>>>
//	Make sure you use
//	your thermal goggles.

/*＃｛赤外線、サーマル｝＃ゴーグルでよく調べてみろ。*/
ライデン_010: {
In Ordnung.
}
//	<<<ENGLISH>>>
//	Right.

/*わかった。*/
プリスキン_011: {
Okay.
Ich gehe jetzt zu Strebe E.
}
//	<<<ENGLISH>>>
//	Okay.
//	I'm heading for Strut E.

/*今から、Ｅ脚へ向かう。*/
}
//d
