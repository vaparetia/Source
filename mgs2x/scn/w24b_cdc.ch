							(`@rp_ÄÌ¾ï£Ã£Á£Ì£Ì¤·¤Æ¤â¤¤¤¤¤è`) && \
							( ( ( $i:¥¹¥Æ¡¼¥¸¥×¥ì¥¤»þ´Ö / d:FRAME_RATE) ) >= 120) && \
							($w:p_story < d:ST:P039_01_P01¿Í¼ÁÉô²°ÀøÆþ£±¥Ý¥ê¥´¥ó¥Ç¥â£±³«»Ï) ){
						eval($f:rfp_w24b_ÌÖËì¥»¥ó¥µ¡¼¡²»à¤ó¤Ç¤ëÅ¨Ê¼¥À¥á£Ã£Á£Ì£Ì¤·¤¿ = 1)
