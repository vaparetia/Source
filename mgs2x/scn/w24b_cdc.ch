				(!$f:rfp_w24b_ÌÖËì¥»¥ó¥µ¡¼¥Ò¥ó¥È£Ã£Á£Ì£Ì¤·¤¿) ){
			eval($f:rfp_w24b_ÌÖËì¥»¥ó¥µ¡¼¡²»à¤ó¤Ç¤ëÅ¨Ê¼¥À¥á£Ã£Á£Ì£Ì¤·¤¿ = 0)
