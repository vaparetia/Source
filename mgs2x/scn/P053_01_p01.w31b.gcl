		-r 0,1024,0 \
		-s 0 \
		-flag 0x0001 \
		-load_state 1

	// 左側上から３
	chara ロッカー ロッカー:03 \
		-kms neo_locker_door \
		-seno 4 \
		-sefloor 4 \
		-p -8375,-16000,(-50500+50) \
		-r 0,1024,0 \
		-s 0 \
		-flag 0x0001 \
		-load_state 1

	// 左側上から４
	chara ロッカー ロッカー:04 \
			-kms neo_locker_door \
			-seno 4 \
			-sefloor 4 \
			-p -8375,-16000,(-49500+50) \
			-r 0,1024,0 \
			-s 0 \
			-flag 0x0001 \
