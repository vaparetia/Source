proc アーセナルランプセット {
	chara 汎用アニメポリゴン 大エレベータ \
		//-tex node_scr_awake_alp \
		-tex w24d_lamp_alp \
		-mode 1 \
		-divi 1, 1\
		-n_ply 2 \
			-color 255 32 16 255 \
			-init 0 \
			-pos \
				-2030,-14180,-65745 \
				-2030,-14150,-65745 \
				-1857,-14180,-65745 \
				-1857,-14150,-65745 \
			-color 255 32 16 255 \
			-init 0 \
			-pos \
				2030,-14180,-65745 \
				2030,-14150,-65745 \
				1857,-14180,-65745 \
				1857,-14150,-65745
	@大エレベータランプＯＮ
}

proc 大エレベータランプＯＮ {
	mesg 汎用アニメポリゴン 大エレベータ ＡＬＰ変更 0 1 255
	mesg 汎用アニメポリゴン 大エレベータ ＡＬＰ変更 1 1 255
	chara delay delay -t 2 -p 大エレベータランプＯＦＦ
}

proc 大エレベータランプＯＦＦ {
	mesg 汎用アニメポリゴン 大エレベータ ＡＬＰ変更 0 120 0
	mesg 汎用アニメポリゴン 大エレベータ ＡＬＰ変更 1 120 0
	chara delay delay -t 124 -p 大エレベータランプＯＮ
}

