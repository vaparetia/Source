	chara ロッカー管理 管理人さん -n 6
	command ロッカーモーション -motion locker

	// 左側上から１
	chara ロッカー ロッカー:01 \
		-kms neo_locker_door \
		-seno 4 \
		-sefloor 4 \
		-p -8375,-16000,(-52500+50) \
		-r 0,1024,0 \
		-s 0 \
		-flag 0x0001 \
		-load_state 1

	// 左側上から２
	chara ロッカー ロッカー:02 \
		-kms neo_locker_door \
