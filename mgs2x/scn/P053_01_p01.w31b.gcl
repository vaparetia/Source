// 水中セット
proc 水中セットデモ {
	command 新プラグイン水中 \
	-z 1
	command 新水中設定 \
		-horizon -6500 \
		-motion rai_swim \
		-flag d:WATER_FLAG_AUTO_ROTATE

	command 水位設定 -lv -6500
/*
	chara 水中カメラ ゆらぎマン \
		-col 128 128 160 \
		-warp 2
*/
 	chara カメラ泡 泡ぶくマン -n 16
	chara カメラダスト ダストマン -n 1

}

