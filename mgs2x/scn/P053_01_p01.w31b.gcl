// 各gclで必要なdefine
// ------------------------------------
// モード
#define		STAGE_PLANT		1		// 共通プロック切り分け用
#define		DEMO_STAGE		1		// デモステージかどうかで起動するキャラを切り分ける

// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME		d00a3
#define		KMS_NAME0		w31b0
#define		KMS_NAME3		w31b3

#define		CEIL_NAME0		w31b0r
#define		CEIL_NAME3		w31b3r

#define		DOOR_NAME2		dr_lv4_00		//	スライドドア

#define		LT2_NAME		w31b
#define		LT2_NAME_24d		w24d

#define		DOOR_NAME_ELV_1	elv_dr1			// エレベータ用１
#define		DOOR_NAME_ELV_2	elv_dr2			// エレベータ用２

// 水中用ディファイン
#define	WATER_MODE			1		// 水中モード基本キャラ設定を使用するのに必要
#define WATER_SURFACE		-6450	// 水面の高さ
#define	WATER_CAMERA_ZONE	1		// 追従カメラが使用するゾーンのあるグループ番号(必要があれば定義する)
#define	CAMERA_BUBBLE_NUM	9		// カメラ泡の個数(いらない場合は定義しない)
#define	CAMERA_DUST_NUM		10		// カメラダストの個数(いらない場合は定義しない)


// includes
// ------------------------------------
#include "5sec_bfr_demo.h"
#include "demo_stdch.h"
#include "demo_stdch2.h"
#include "demo_vardef.h"
#include "story.h"
#include "sload.h"

#include "p_force_cdc.ch"

#if d:PLANT_DEMO_ALL_SKIP
	#define		DEMO_SKIP_ENABLE 1
#else
	#define		DEMO_SKIP_ENABLE 0
#endif

#if d:MGS2_DEMO
	#define     DEMO_STAGE_SET 1	// 実行するステージの選択
									// 0 水中  1 電算室
	#define     DEMO_WATER_EFFECT 0	// 水中ゆらぎのオン・オフ
									// 0 オフ  1 オン
#endif

//###################################################################################
//								ストーリーフラグ & デモ再生
//###################################################################################
// ＜↓↓↓同期↓↓↓＞
if( d:ST:P062_05_R02エマとＡＩ５無線機デモ２終了 <= $w:p_story && \
				$w:p_story < d:ST:P062_06_P02エマとＡＩ６ポリゴンデモ２開始) {
	chara マップ シェル２中央棟Ｂ１ -h d:HZX_NAME,0 -l d:LT2_NAME_24d
} else {
	chara マップ シェル２中央棟Ｂ１ -h d:HZX_NAME,0 -l d:LT2_NAME
}

command マップ設定 シェル２中央棟Ｂ１ -set {

// デモ環境かどうか。
#if d:MGS2_DEMO

// 不要プログラムの起動阻害
#if d:DEMO_STAGE_SET
	eval($s:d_num = P062_06_p02)
#else
	eval($s:d_num = hogehoge)
#endif

chara デモアクトデバッグ demodebug  -i t:p062_06_p02 -d 'p062_06_p02' -l   \
		-p  ドアランプを青に変更 ドアランプを赤に変更

#else


// ゲームＧＣＬと共用で入ってくる部分なので、== で条件を見る。
/*
d:ST:P054_01_P01ピーター死体１ポリゴンデモ１開始 は廃止（010724）
その代わり独自フラグでチェック。
*/
if($f:ピーター浮遊死体デモ見た == 0) {
	print'd:ST:P054_01_P01ピーター死体１ポリゴンデモ１開始'

	/* ピーターの死体が浮遊している */

	// デモ特有の変数代入
	eval($s:d_num = P054_01_p01)

	@デモモデル差し替え処理
	proc デモ再生_P054_01_p01 {
		chara demo デモ再生 \
			-i t:p054_01_p01 \
			-p dummy_proc \
			-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
			-next P054_01_p01終了
	}

	@デモ再生_P054_01_p01


// ゲームＧＣＬと共用で入ってくる部分なので、== で条件を見る。
} else if($w:p_story == d:ST:P062_01_P01エマとＡＩ１ポリゴンデモ１開始) {
	print'd:ST:P062_01_P01エマとＡＩ１ポリゴンデモ１開始'
	eval($w:p_story = d:ST:P062_01_P01エマとＡＩ１ポリゴンデモ１開始)

	/* ライデン、エマにＭＯをわたす */

	// デモ特有の変数代入
	eval($s:d_num = P062_01_p01)

	@デモモデル差し替え処理
	proc デモ再生_P062_01_p01 {
		chara demo デモ再生 \
			-i t:p062_01_p01 \
			-p ドアランプを青に変更 ドアランプを赤に変更 \
			-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
			-next P062_01_p01終了
	}

	@デモ再生_P062_01_p01

} else if( d:ST:P062_01_P01エマとＡＩ１ポリゴンデモ１終了 <= $w:p_story && \
				$w:p_story < d:ST:P062_02_M01エマとＡＩ２ムービーデモ１開始) {
	print'd:ST:P062_02_M01エマとＡＩ２ムービーデモ１開始'
	eval($w:p_story = d:ST:P062_02_M01エマとＡＩ２ムービーデモ１開始)

	/* エマがウイルスプログラムを作ったことを知る */

	// デモ特有の変数代入
	eval($s:d_num = P062_02_m01)

	#if 1
		//chara デバッグポーズ pause 'MOVIE_P062_02_m01' -p P062_02_m01終了
		chara MOVIE再生 MOVIE_P062_02_m01 -file t:p062_02_m01 -top 0, d:MOVIE_TOP_Y -size 512, 320 -proc P062_02_m01終了
	#else
		/* 無線 */
		/* P062_02_m01終了 */
	#endif

} else if( d:ST:P062_02_M01エマとＡＩ２ムービーデモ１終了 <= $w:p_story && \
				$w:p_story < d:ST:P062_03_R01エマとＡＩ３無線機デモ１開始) {
	print'd:ST:P062_03_R01エマとＡＩ３無線機デモ１開始'
	eval($w:p_story = d:ST:P062_03_R01エマとＡＩ３無線機デモ１開始)

	/* エマ体内通信　なぜアーセナル計画へ協力した？ */

	// デモ特有の変数代入
	eval($s:d_num = P062_03_r01)
	@rt_P062_03_R01エマとＡＩ３無線機デモ１
	/* P062_03_r01終了 */
	/*
	eval($w:p_story = d:ST:P062_03_R01エマとＡＩ３無線機デモ１終了)
	restart
	*/

} else if( d:ST:P062_03_R01エマとＡＩ３無線機デモ１終了 <= $w:p_story && \
				$w:p_story < d:ST:P062_04_M02エマとＡＩ４ムービーデモ２開始) {
	print'd:ST:P062_04_M02エマとＡＩ４ムービーデモ２開始'
	eval($w:p_story = d:ST:P062_04_M02エマとＡＩ４ムービーデモ２開始)

	/* Ｙ２Ｋ問題の映像 */

	// デモ特有の変数代入
	eval($s:d_num = P062_04_m02)

	#if 1
		//chara デバッグポーズ pause 'MOVIE_P062_04_m02' -p P062_04_m02終了
		chara MOVIE再生 MOVIE_P062_04_m02 -file t:p062_04_m02 -top 0, 32 -size 512, 320 -proc P062_04_m02終了
	#else
		/* 無線 */
		/* P062_04_m02終了 */
	#endif

} else if( d:ST:P062_04_M02エマとＡＩ４ムービーデモ２終了 <= $w:p_story && \
				$w:p_story < d:ST:P062_05_R02エマとＡＩ５無線機デモ２開始) {
	print'd:ST:P062_05_R02エマとＡＩ５無線機デモ２開始'
	eval($w:p_story = d:ST:P062_05_R02エマとＡＩ５無線機デモ２開始)

	/* エマ体内通信　電算室へ向かおう… */

	// デモ特有の変数代入
	eval($s:d_num = P062_05_r02)
	@rt_P062_05_R02エマとＡＩ５無線機デモ２
	/* P062_05_r02終了 */
	/*
	eval($w:p_story = d:ST:P062_05_R02エマとＡＩ５無線機デモ２終了)
	restart
	*/

// ＜↑↑↑同期↑↑↑＞
} else if( d:ST:P062_05_R02エマとＡＩ５無線機デモ２終了 <= $w:p_story && \
				$w:p_story < d:ST:P062_06_P02エマとＡＩ６ポリゴンデモ２開始) {
	print'd:ST:P062_06_P02エマとＡＩ６ポリゴンデモ２開始'
	eval($w:p_story = d:ST:P062_06_P02エマとＡＩ６ポリゴンデモ２開始)

	/* 電算室のオウム */

	// デモ特有の変数代入
	eval($s:d_num = P062_06_p02)

	@デモモデル差し替え処理
	proc デモ再生_P062_06_p02 {
		chara demo デモ再生 \
			-i t:p062_06_p02 \
			-p dummy_proc \
			-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
			-next P062_06_p02終了
	}

	@デモ再生_P062_06_p02

} else if( d:ST:P062_06_P02エマとＡＩ６ポリゴンデモ２終了 <= $w:p_story && \
				$w:p_story < d:ST:P062_07_P03エマとＡＩ７ポリゴンデモ３開始) {
	print'd:ST:P062_07_P03エマとＡＩ７ポリゴンデモ３開始'
	eval($w:p_story = d:ST:P062_07_P03エマとＡＩ７ポリゴンデモ３開始)

	/* これから進んでゆく水中のコースを見せる */

	// デモ特有の変数代入
	eval($s:d_num = P062_07_p03)

	@デモモデル差し替え処理
	proc デモ再生_P062_07_p03 {
		chara demo デモ再生 \
			-i t:p062_07_p03 \
			-p dummy_proc \
			-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
			-next P062_07_p03終了
	}

	@デモ再生_P062_07_p03

} else if( d:ST:P062_07_P03エマとＡＩ７ポリゴンデモ３終了 <= $w:p_story && \
				$w:p_story < d:ST:P062_08_P04エマとＡＩ８ポリゴンデモ４開始) {
	print'd:ST:P062_08_P04エマとＡＩ８ポリゴンデモ４開始'
	eval($w:p_story = d:ST:P062_08_P04エマとＡＩ８ポリゴンデモ４開始)

	/* エマのヌリバシ（髪飾りにしている）ネタ */

	// デモ特有の変数代入
	eval($s:d_num = P062_08_p04)

	@デモモデル差し替え処理
	proc デモ再生_P062_08_p04 {
		chara demo デモ再生 \
			-i t:p062_08_p04 \
			-p dummy_proc \
			-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
			-next P062_08_p04終了
	}

	@デモ再生_P062_08_p04


// デモの時以外は、以下を通過する。
} else {

	// このフラグが立っていると、親（ゲームの）GCLの方で必要なキャラが起動する。
	@ゲームステージへ戻る

}

#endif

// デモ仕様のセット
	@常駐キャラ設定						// stdch.hで定義
	if($s:d_num != not_demo){
		// 共通して使用するもの
		chara デモキャンセルチェック デモキャンセル \
			-p demo_cancel

		// 無線ではシネマスクリーン起動しない
		if(($s:d_num != P062_03_r01) || ($s:d_num != P062_05_r02)){
				@シネマスクリーンセット
		}

		// 電算機室オウムデモでのみ使用。
		if($s:d_num == P062_06_p02){
			@w24dのフォグセット
			@電算室ステージモデル表示
			@アーセナルランプセット
			@ロッカー設置
//			@鳥篭
		} else {
			// 水中時のフォグコントローラでは、デモからフォグが制御できないので切る。
			// 010818 田中(信)
			if($s:d_num != P062_07_p03){
				@w31bのフォグセット
			}
print 'デモ仕様_000'
			@水密ドアセット
print 'デモ仕様_001'
//			@ドアセット
print 'デモ仕様_002'
			@エレベータセット
print 'デモ仕様_003'
			@シェル２中央棟Ｂ１天井セット
print 'デモ仕様_004'
#if d:MGS2_DEMO
	if(d:DEMO_WATER_EFFECT == 1) {
		@デモ水中モード基本キャラ設定
	}else{		
		@水中モード基本キャラ設定
	}
#else
			//@水中セットデモ
			if($s:d_num == P062_01_p01) {
				@デモ水中モード基本キャラ設定
			}else{
				@水中モード基本キャラ設定
			}
#endif
print 'デモ仕様_005'
			@機雷セット // デモで映らなければコメントアウト。
print 'デモ仕様_006'
			@ステージモデル表示
			@デモドアランプ設定
		}
	}

} // < 「command マップ設定 シェル２中央棟Ｂ１」 の閉じカッコ

// ====================================
// 初期マップ表示
// ====================================
	command マップ表示 -show シェル２中央棟Ｂ１


//###################################################################################
//									デモのみ仕様各種
//###################################################################################
// ダミープロック
proc dummy_proc {}

// デモキャンセル
proc demo_cancel {
	command StreamStopAll
}

// リスタート
proc restart_proc {
	restart
}

// デモ終了時プロック
proc P054_01_p01終了 {
	@デモ終了時シネマスクリーンオフ
	mesg デモキャンセルチェック デモキャンセル kill
	eval($f:ピーター浮遊死体デモ見た = 1)
	print 'P054_01_P01ピーター死体１ポリゴンデモ１終了'

	chara delay ディレイ \
		-time 1 \
		-exec{
			// ゲームへ
			@ゲームステージへ戻る
			load 'w31b' -r 'r_plt0'
		}
}

proc P062_01_p01終了 {
	@デモ終了時シネマスクリーンオフ
	mesg デモキャンセルチェック デモキャンセル kill
	#if d:DEMO_SKIP_ENABLE
		eval($w:p_story = d:ST:P062_02_M01エマとＡＩ２ムービーデモ１終了)
		print '$w:p_story = d:ST:P062_02_M01エマとＡＩ２ムービーデモ１終了'
	#else
		eval($w:p_story = d:ST:P062_01_P01エマとＡＩ１ポリゴンデモ１終了)
		print '$w:p_story = d:ST:P062_01_P01エマとＡＩ１ポリゴンデモ１終了'
	#endif

	chara delay ディレイ \
		-time 1 \
		-exec{
			restart
		}
}

proc P062_02_m01終了 {
	@デモ終了時シネマスクリーンオフ
	eval($w:p_story = d:ST:P062_02_M01エマとＡＩ２ムービーデモ１終了)
	restart
}

proc P062_04_m02終了 {
	@デモ終了時シネマスクリーンオフ
	eval($w:p_story = d:ST:P062_04_M02エマとＡＩ４ムービーデモ２終了)
	restart
}

proc P062_06_p02終了 {
	@デモ終了時シネマスクリーンオフ
	mesg デモキャンセルチェック デモキャンセル kill
	#if d:DEMO_SKIP_ENABLE
		eval($w:p_story = d:ST:P062_08_P04エマとＡＩ８ポリゴンデモ４終了)
		print '$w:p_story = d:ST:P062_08_P04エマとＡＩ８ポリゴンデモ４終了'
	#else
		eval($w:p_story = d:ST:P062_06_P02エマとＡＩ６ポリゴンデモ２終了)
		print '$w:p_story = d:ST:P062_06_P02エマとＡＩ６ポリゴンデモ２終了'
	#endif

	chara delay ディレイ \
		-time 1 \
		-exec{
			restart
		}
}

proc P062_07_p03終了 {
	@デモ終了時シネマスクリーンオフ
	mesg デモキャンセルチェック デモキャンセル kill
	#if d:DEMO_SKIP_ENABLE
		eval($w:p_story = d:ST:P062_08_P04エマとＡＩ８ポリゴンデモ４終了)
		print '$w:p_story = d:ST:P062_08_P04エマとＡＩ８ポリゴンデモ４終了'
	#else
		eval($w:p_story = d:ST:P062_07_P03エマとＡＩ７ポリゴンデモ３終了)
		print '$w:p_story = d:ST:P062_07_P03エマとＡＩ７ポリゴンデモ３終了'
	#endif

	chara delay ディレイ \
		-time 1 \
		-exec{
			restart
		}
}

proc P062_08_p04終了 {
	@デモ終了時シネマスクリーンオフ
	mesg デモキャンセルチェック デモキャンセル kill
	eval($w:p_story = d:ST:P062_08_P04エマとＡＩ８ポリゴンデモ４終了)
	print '$w:p_story = d:ST:P062_08_P04エマとＡＩ８ポリゴンデモ４終了'

	chara delay ディレイ \
		-time 1 \
		-exec{
			// ゲームへ
			@ゲームステージへ戻る
// ↓これだと現ステージ名などがきちんと記録されないため、修正します。2001.10.22 吉池
//			load "w31b" -r 'r_plt0'
			@mv_demo_w31b_0
		}
}



// シネマスクリーン
proc シネマスクリーンセット {
	chara シネマスクリーン シネマ \
		-top d:CINEMA_BELT_UPPER \
		-bottom d:CINEMA_BELT_LOWER \
		-ftime 60	//デフォルト値（ゼロは駄目）
	mesg シネマスクリーン シネマ フェードアウト 1
}

// 水密ドア
proc 水密ドアセット {
	//	右はしの水密ドア
	chara プットオブジェ 右はしの水密ドア \
		-m demo_w00_sdr_r \
		-r 0,3072,0 \
		-p 12125,-10500,-222500 \
		-s 100,100,100 \
		-l d:LT2_NAME

#if 0
	// 右端対面水密ドア
	chara プットオブジェ 右端対面水密ドア \
		-m demo_w00_sdr_r \
		-r 0,1024,0 \
		-p 7375,-10500,(-222500+1000) \
		-s 100,100,100 \
		-l d:LT2_NAME

	// 左端対面水密ドア
	chara プットオブジェ 左端対面水密ドア \
		-m demo_w00_sdr_r \
		-r 0,3072,0 \
		-p -7375,-10500,(-222500+1000) \
