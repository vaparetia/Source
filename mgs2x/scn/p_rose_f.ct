		//そう？じゃ、私が美人じゃなくても
		//つきあってる？
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿美人さん２__f:ライデン_009]
		//……勿論。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿美人さん２__f:ローズ_010]
		//……あなたが好きなのは私自身？
		//それとも私の評判？どっち？
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿美人さん２__f:ライデン_011]
		//そういう聞かれ方して後の方って応える
		//奴いると思うか？
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿美人さん２__f:ローズ_012]
		//……
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿美人さん２__f:ライデン_013]
		//冗談だよ。俺が好きなのは君自身だ。
		//嘘じゃない。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿美人さん２__f:ローズ_014]
		//そう……ありがとう。
	}
}//v
}//d


//仕事も大事 h //e
//resource PR_ＳＡＶＥ後＿仕事も大事
proc rp_PR_ＳＡＶＥ後＿仕事も大事:02  {
vox t:vc250811 {
@rp_セクハラ＿是＿やりたがり系デフォルト 70
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿仕事も大事__f:ローズ_000]
		//ね、ジャック。私、役に立ってる？
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿仕事も大事__f:ライデン_001]
		//ああ。助かってるよ。君が軍のデータ
		//アナリストでよかった。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿仕事も大事__f:ローズ_002]
		//ふーん。でもちょっと前、私に仕事
		//変われとか辞めろとか言ったことあった
		//じゃない？
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿仕事も大事__f:ライデン_003]
		//ああ……君はすごく怒ったな。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿仕事も大事__f:ローズ_004]
		//あれ、どういうことだったの？
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿仕事も大事__f:ライデン_005]
		//いや残業とかで大変そうだったから。
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿仕事も大事__f:ローズ_006]
		//でもそれ、ホントじゃないでしょ。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿仕事も大事__f:ライデン_007]
		//……（図星指されて観念）あの頃、行き違いが多かっただろ。
		//一緒に過ごす時間が多くなればって……。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿仕事も大事__f:ライデン_007_1]
		//……（図星指されて観念）あの頃、行き違いが多かっただろ。
		//一緒に過ごす時間が多くなればって……。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿仕事も大事__f:ローズ_008]
		//あなたなりに危機感持ってたんだ？
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿仕事も大事__f:ライデン_009]
		//ん……まあ……。
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_セクハラ＿否１＿ワガママ系デフォルト 60
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿仕事も大事__f:ローズ_010]
		//でも全てをあなたの都合に合わせろっ
		//てのはあんまりじゃない？
		//私はあなたの所有物じゃないのよ？
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿仕事も大事__f:ローズ_010_1]
		//でも全てをあなたの都合に合わせろっ
		//てのはあんまりじゃない？
		//私はあなたの所有物じゃないのよ？
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿仕事も大事__f:ライデン_011]
		//そんなこと思ってないよ。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿仕事も大事__f:ローズ_012]
		//そう？
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿仕事も大事__f:ライデン_013]
		//ああ。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿仕事も大事__f:ローズ_014]
		//……私はあなたが好き。
		//あなたを好きでいる私も好き。
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_セクハラ＿否１＿ワガママ系デフォルト 60
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿仕事も大事__f:ローズ_015]
		//でも私を形容する一言が「ジャックの彼女」だなんてのは絶対に嫌。考えただけでぞっとする。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿仕事も大事__f:ローズ_016]
		//それ以外の部分も全部含めて私なの。
		//したい仕事をしてるってこともその一つ。
		//それは否定しないで。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿仕事も大事__f:ローズ_016_1]
		//それ以外の部分も全部含めて私なの。
		//したい仕事をしてるってこともその一つ。
		//それは否定しないで。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿仕事も大事__f:ライデン_017]
		//否定なんて……
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿仕事も大事__f:ローズ_018]
		//私はまず私として認識されたいの。
		//他の人から。そして誰よりも……
		//あなたから。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿仕事も大事__f:ローズ_019]
		//……ただあなたの彼女でいることが私の役割だなんて、あなたにだけは思ってほしくない。（本当はその役割を命じられてこなしている。その罪悪感の裏返し）
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿仕事も大事__f:ライデン_020]
		//そんなこと思ってないよ。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿仕事も大事__f:ローズ_021]
		//本当にそう言える？
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿仕事も大事__f:ライデン_022]
		//勿論。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿仕事も大事__f:ローズ_023]
		//そう……。よかった。
	}
}//v
}//d





