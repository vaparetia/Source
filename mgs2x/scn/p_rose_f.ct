//ＳＡＶＥ後会話 d //e
//愛国者達の話 h //e
//resource PR_ＳＡＶＥ後＿愛国
proc rp_PR_ＳＡＶＥ後＿愛国:02  {
vox t:vc250371 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿愛国__f:ローズ_000]
		//ジャック、愛国達のデジタル統制って、
		//何処までなのかしら？
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿愛国__f:ライデン_001]
		//わからないが、おそらく俺達の
		//極日常まで入り込んでいるに違いない。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿愛国__f:ローズ_002]
		//どんな映画や音楽、ファッションが
		//流行ってるっていう、そんな情報まで？
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿愛国__f:ライデン_003]
		//趣味嗜好の統制ほど、簡単なものはない。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿愛国__f:ライデン_004]
		//思い出してみろ、映画でも音楽でも……
		//人気ランキング上位のモノにみんなが
		//群がる。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿愛国__f:ライデン_004_1]
		//思い出してみろ、映画でも音楽でも……
		//人気ランキング上位のモノにみんなが
		//群がる。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿愛国__f:ローズ_005]
		//それが創られたランキングだと？
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿愛国__f:ライデン_006]
		//そうだ。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿愛国__f:ローズ_007]
		//人の趣味は操作できないわ。
		//それが人の個性だもの。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿愛国__f:ライデン_008]
		//いや……
		//元来、流行とはそういうものなんだ。
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_セクハラ＿否１＿ワガママ系デフォルト 100
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿愛国__f:ローズ_009]
		//私はそうは思えない。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿愛国__f:ライデン_010]
		//個人対話の時代は終わった。
		//口コミの時代も。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿愛国__f:ライデン_010_1]
		//個人対話の時代は終わった。
		//口コミの時代も。
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿愛国__f:ローズ_011]
		//え？……ええ、いるわ。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿愛国__f:ライデン_012]
		//何人くらい？
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿愛国__f:ローズ_013]
		//うーんと、頻繁に話をする人は……
		//２０人くらいかな。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿愛国__f:ライデン_014]
		//そのうち、逢った事があるのは？
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_セクハラ＿否１＿ワガママ系デフォルト 60
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿愛国__f:ローズ_015]
		//一人か、二人……。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿愛国__f:ライデン_016]
		//みんなそんなもんだ。たとえ、メール
		//相手が嘘の経歴や嘘の情報を流して
		//いても確かめようがない。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿愛国__f:ライデン_016_1]
		//みんなそんなもんだ。たとえ、メール
		//相手が嘘の経歴や嘘の情報を流して
		//いても確かめようがない。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿愛国__f:ライデン_016_2]
		//みんなそんなもんだ。たとえ、メール
		//相手が嘘の経歴や嘘の情報を流して
		//いても確かめようがない。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿愛国__f:ローズ_017]
		//嘘の経歴……。（自分の事を気に病む）
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿愛国__f:ライデン_018]
		//そうだ。確かめようがない。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿愛国__f:ローズ_019]
		//それじゃ、面識のある私達はどうなの？
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿愛国__f:ライデン_020]
		//俺達？
	}
@rp_キテレツさん＿否１＿なんだこいつ系デフォルト 100
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿愛国__f:ローズ_021]
		//あなたは私に本当の自分を見せた事ある？
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿愛国__f:ライデン_022]
		//……本当の自分がどうなのか、
		//俺にもわからない。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿愛国__f:ローズ_023]
		//今のあなたは正直だと思うけど……。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿愛国__f:ライデン_024]
		//今の俺が正直？
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_キテレツさん＿否２＿意味不明系デフォルト 50
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿愛国__f:ローズ_025]
		//こんなに感情的なあなたを見た事がない。
		//恐れたり、怒ったり、笑ったり……。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿愛国__f:ローズ_026]
		//変な言い方だけど、今のあなたは
		//生きることに正直だわ。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿愛国__f:ライデン_027]
		//俺は任務に集中しているだけだ。
		//ここは戦場なんだ。
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿愛国__f:ローズ_028]
		//ええ、わかる。
		//でも、デートしている時のあなたとは
		//違う。いつも冷静だった。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿愛国__f:ライデン_029]
		//君は？どうなんだ？
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿愛国__f:ローズ_030]
		//私は、あなたの前では素直でいたい。
		//できるだけ……。
	}
}//v
}//d

//大佐発狂後 h //e
//resource PR_ＳＡＶＥ後＿大佐会ったことない
proc rp_PR_ＳＡＶＥ後＿大佐会ったことない:02  {
vox t:vc250381 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿大佐会ったことない__f:ライデン_000]
		//ローズか、大佐の様子が変なんだ？
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿大佐会ったことない__f:ローズ_001]
		//大佐とはしばらく話してないけど。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿大佐会ったことない__f:ライデン_002]
		//話してない？
		//そばにいるんじゃないのか？
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿大佐会ったことない__f:ローズ_003]
		//いいえ、ここには私一人。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿大佐会ったことない__f:ライデン_004]
		//じゃあ、君も大佐に会った事は
		//一度もないんだな？
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿大佐会ったことない__f:ローズ_005]
		//ええ……目隠しされて
		//ここに連れてこられたの。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿大佐会ったことない__f:ライデン_006]
		//俺もあってない？
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿大佐会ったことない__f:ローズ_007]
		//どうしたの？
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿大佐会ったことない__f:ライデン_008]
		//いや、いいんだ。
	}
}//v
}//d

//天狗通路Ａ h //e
//resource PR_ＳＡＶＥ後＿天狗通路Ａ１
proc rp_PR_ＳＡＶＥ後＿天狗通路Ａ１:02  {
vox t:vc250391 {
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿天狗通路Ａ１__f:ライデン_000]
		//ローズ、聞こえるか？
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿天狗通路Ａ１__f:ローズ_001]
		//ええ、ここにいるわ。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿天狗通路Ａ１__f:ライデン_002]
		//……やっぱりやめておく。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿天狗通路Ａ１__f:ローズ_003]
		//ジャック、どうしたの？
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿天狗通路Ａ１__f:ライデン_004]
		//俺にはわからない。
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_セクハラ＿否２＿うっとおしい系デフォルト 100
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿天狗通路Ａ１__f:ローズ_005]
		//私に話してみて。力になる。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿天狗通路Ａ１__f:ライデン_006]
		//いや。君にはやはり理解できない。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿天狗通路Ａ１__f:ローズ_007]
		//ジャック、話してみて？
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿天狗通路Ａ１__f:ライデン_008]
		//だめだ。君には、話せない。
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_セクハラ＿否１＿ワガママ系デフォルト 100
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿天狗通路Ａ１__f:ローズ_009]
		//スネークさんには言えて、
		//私には言えないの？
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿天狗通路Ａ１__f:ライデン_010]
		//彼は特別だ。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿天狗通路Ａ１__f:ローズ_011]
		//どうして？私だって……
		//こうして一緒に戦場にいるわ。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿天狗通路Ａ１__f:ライデン_012]
		//違う。ここは戦場だ……作戦室の中の
		//ライブ映像とは違う。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿天狗通路Ａ１__f:ローズ_013]
		//私にも銃を持って戦えっていうの？
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿天狗通路Ａ１__f:ライデン_014]
		//いや、違う。君にだけはここには
		//来て欲しくない。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿天狗通路Ａ１__f:ローズ_015]
		//どうしたの？
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿天狗通路Ａ１__f:ライデン_016]
		//俺は……人殺しだ。
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿天狗通路Ａ１__f:ローズ_017]
		//でもそれは……。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿天狗通路Ａ１__f:ライデン_018]
		//何も感じない。倒れていく兵士を、
		//もだえながら絶命していく兵士を
		//見ても……。
	}
}//v
}//d
//ローズのビジュアルが大佐になったりする（混線）。 t //e
//resource PR_ＳＡＶＥ後＿天狗通路Ａ２
proc rp_PR_ＳＡＶＥ後＿天狗通路Ａ２:02  {
vox t:vc250401 {
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿天狗通路Ａ２__f:ローズ_000]
		//ダメよ。いまそんな事を考えちゃ。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿天狗通路Ａ２__f:ライデン_001]
		//……俺は昔から、人殺しなんだ。
		//スネークとは違う。彼は信念を持って
		//戦っている。
	}
//ローズに戻る。 t //e
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿天狗通路Ａ２__f:ローズ_002]
		//あなたも、そうよ。これは任務なの。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿天狗通路Ａ２__f:ライデン_003]
		//俺は違う。
		//俺はどこかでこのゲームを楽しんでる。
	}
}//v
}//d




//後回し d //e
