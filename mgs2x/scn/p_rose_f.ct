//resource PR_ＳＡＶＥ後＿変装＿３
proc rp_PR_ＳＡＶＥ後＿変装＿３:02  {
vox t:vc250501 {
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_セクハラ＿否１＿ワガママ系デフォルト 60
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿変装＿３__f:ローズ_000]
		//もっと普段からおしゃれすればいいのに。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿変装＿３__f:ライデン_001]
		//めんどくさいんだ。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿変装＿３__f:ローズ_002]
		//もうちょっと気を使ってみてもいいと
		//思うけどな。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿変装＿３__f:ライデン_003]
		//君は気を使う方だよな。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿変装＿３__f:ローズ_003]
		//ええ。勿論。だってキレイでいたいもの。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿変装＿３__f:ライデン_004]
		//人にほめられたい？
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_キテレツさん＿否１＿なんだこいつ系デフォルト 100
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿変装＿３__f:ローズ_005]
		//ええ。特にあなたに。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿変装＿３__f:ライデン_006]
		//俺？
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿変装＿３__f:ローズ_007]
		//ええ。おかしい？
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿変装＿３__f:ライデン_008]
		//そんなことないよ。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿変装＿３__f:ローズ_009]
		//そう？じゃ、今度ちゃんとほめてね。
	}
}//v
}//d

//たばこ装備時 h //e
//resource PR_ＳＡＶＥ後＿たばこ
proc rp_PR_ＳＡＶＥ後＿たばこ:02  {
vox t:vc250511 {
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿たばこ__f:ローズ_000]
		//ところでジャック、煙草吸ってるの？
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿たばこ__f:ライデン_001]
		//ああ……ぷはー。（うまそうに一服）
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿たばこ__f:ローズ_002]
		//ずっと禁煙してたじゃない？どうして？
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿たばこ__f:ライデン_003]
		//これにはいろいろ事情が……
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_セクハラ＿否２＿うっとおしい系デフォルト 100
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿たばこ__f:ローズ_004]
		//もう、あなたの体のこと思って言ってる
		//のに。やめる時大変だったでしょ。
		//忘れたの？
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿たばこ__f:ライデン_005]
		//ああ。あれはつらかった……。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿たばこ__f:ローズ_006]
		//でしょ。だったら……
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿たばこ__f:ライデン_007]
		//そうだ。ローズ、あの苦しみを
		//味わわずに済む方法を思い付いたぞ。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿たばこ__f:ローズ_008]
		//どうするの？
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿たばこ__f:ライデン_009]
		//禁煙しなきゃいい。
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿たばこ__f:ローズ_010]
		//ジャック！
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿たばこ__f:ライデン_011]
		//冗談だよ。煙草は体に良くないからな。
		//帰ったらちゃんとやめる。ふぅー。（またうまそうに一服）
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿たばこ__f:ローズ_012]
		//……。
	}
}//v
}//d


//エロ本装備時 h //e
//resource PR_ＳＡＶＥ後＿エロ本
proc rp_PR_ＳＡＶＥ後＿エロ本:02  {
vox t:vc250521 {
@rp_つっこまれ＿是１＿なんで知ってるんだ系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿エロ本__f:ローズ_000]
		//ところでジャック……何持ってるの？
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿エロ本__f:ライデン_001]
		//あ、いや……。
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿エロ本__f:ローズ_002]
		//もう、そんなに困ってるなら
		//一言いってくれればいいのに。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿エロ本__f:ライデン_003]
		//え？言ったら？
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿エロ本__f:ローズ_004]
		//ふふふ……
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿エロ本__f:ローズ_005]
		//がまんなさいってアドバイスしてあげる！
	}
}//v
}//d

//何人か殺した後 h //e
//resource PR_ＳＡＶＥ後＿殺した
proc rp_PR_ＳＡＶＥ後＿殺した:02  {
vox t:vc250531 {
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿殺した__f:ライデン_000]
		//ローズ……何か言わないのか？
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿殺した__f:ローズ_001]
		//何を？
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿殺した__f:ライデン_002]
		//俺は人を殺した。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿殺した__f:ローズ_003]
		//ジャック……戦場なんだから……。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿殺した__f:ライデン_004]
		//相手は生身の人間だ。ＶＲ訓練とは違う。
		//実体がある。人生も……あった。
		//俺はそれを奪ったんだ。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿殺した__f:ライデン_004_1]
		//相手は生身の人間だ。ＶＲ訓練とは違う。
		//実体がある。人生も……あった。
		//俺はそれを奪ったんだ。
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿殺した__f:ローズ_005]
		//でも生き残るためには仕方が……
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿殺した__f:ライデン_006]
		//それに、俺はあまりショックを受けて
		//ないんだ。ははは。これもＶＲ訓練の
		//成果なのかな……。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿殺した__f:ライデン_006_1]
		//それに、俺はあまりショックを受けて
		//ないんだ。ははは。これもＶＲ訓練の
		//成果なのかな……。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿殺した__f:ローズ_007]
		//ジャック！
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿殺した__f:ライデン_008]
		//え？
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_セクハラ＿否１＿ワガママ系デフォルト 60
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿殺した__f:ローズ_009]
		//私、あなたが生きて戻ってきてくれる
		//なら何だって構わない。何したっていい
		//から。だからお願い。無事で帰ってきて。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿殺した__f:ローズ_009_1]
		//私、あなたが生きて戻ってきてくれる
		//なら何だって構わない。何したっていい
		//から。だからお願い。無事で帰ってきて。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿殺した__f:ライデン_010]
		//……ああ。
	}
}//v
}//d

//帰還パーティー h //e
//resource PR_ＳＡＶＥ後＿帰還パーティー
proc rp_PR_ＳＡＶＥ後＿帰還パーティー:02  {
vox t:vc250541 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿帰還パーティー__f:ローズ_000]
		//ジャック……
		//帰ったら、帰還パーティー開きましょう。
		//二人だけで。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿帰還パーティー__f:ライデン_001]
		//ああ。いいな、それ。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿帰還パーティー__f:ローズ_002]
		//私、料理つくるから。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿帰還パーティー__f:ライデン_003]
		//え！？（まじかよ、やめてくれ！）
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿帰還パーティー__f:ローズ_004]
		//どうかした？
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿帰還パーティー__f:ライデン_005]
		//あ、いや、それもいいが、そうだ、
		//あの店行かないか？
	}
	talk ライデン 標準 -m {
