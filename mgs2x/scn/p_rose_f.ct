}//v
}//d

//フォーマットしようとしない h //e
//resource PR_ＳＡＶＥ失敗＿フォーマットしようとしない
proc rp_PR_ＳＡＶＥ失敗＿フォーマットしようとしない:02  {
vox t:vc250351 {
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ失敗＿フォーマットしようとしない__f:ローズ_000]
		//ジャック、フォーマットしないと
		//記録出来ないんだけど……。
		//記録したくないの？
	}
}//v
}//d

