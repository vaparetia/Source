	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿変装＿１__f:ローズ_002]
		//ええ。
		//ジャックは基本的に何着ても似合うのよ。
	}
}//v
}//d

//ダンボール会話聞いている場合 t //e
