//ＳＡＶＥ失敗 d //e
//メモリーカードがない h //e
//resource PR_ＳＡＶＥ失敗＿メモリーカードない
proc rp_PR_ＳＡＶＥ失敗＿メモリーカードない:02  {
vox t:vc250331 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ失敗＿メモリーカードない__f:ローズ_000]
		//ジャック、ＭＥＭＯＲＹ ＣＡＲＤ
		//差込口に“PlayStation2”専用メモリー
		//カードが刺さってないわ。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ失敗＿メモリーカードない__f:ローズ_001]
		//記録するには“PlayStation2”専用
		//メモリーカードが必要なんですって。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ失敗＿メモリーカードない__f:ローズ_002]
		//ＭＥＭＯＲＹ ＣＡＲＤ差込口に
		//“PlayStation2”専用メモリーカードを
		//セットして。
	}
}//v
}//d
