	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿つらそう２__f:ライデン_012]
		//ああ。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿つらそう２__f:ローズ_013]
		//……もし……
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿つらそう２__f:ライデン_014]
		//え？
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿つらそう２__f:ローズ_015]
		//……もしもよ……私がその理想を……（演じていただけだとしたら？）
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿つらそう２__f:ライデン_016]
		//なんだ？
	}
@rp_かみあわない＿否１＿話聞けよ系デフォルト 100
	talk ローズ 標準 -m {
