//ＳＡＶＥ後会話 d //e
//ダンボールかぶった状態 h //e
//resource PR_ＳＡＶＥ後＿ダンボール
proc rp_PR_ＳＡＶＥ後＿ダンボール:02  {
vox t:vc250471 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿ダンボール__f:ローズ_000]
		//って、信じられない。何そのカッコ？
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿ダンボール__f:ライデン_001]
		//ええと、偽装だ。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿ダンボール__f:ローズ_002]
		//偽装？なんの？
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿ダンボール__f:ライデン_003]
		//いや、
		//これで敵の目を誤魔化せるかな、と。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿ダンボール__f:ライデン_003_1]
		//いや、
		//これで敵の目を誤魔化せるかな、と。
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿ダンボール__f:ローズ_004]
		//それで誤魔化されるのって相当
		//マヌケじゃない？
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿ダンボール__f:ライデン_005]
		//そうかもしれないが、君が思ってるより
		//マヌケってのは多いらしい。
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿ダンボール__f:ローズ_006]
		//……あなたもそのクチみたいね。
	}
	talk ライデン 標準 -m {
		 [PR_ＳＡＶＥ後＿ダンボール__f:ライデン_007]
		//は？
	}
	talk ローズ 標準 -m {
		 [PR_ＳＡＶＥ後＿ダンボール__f:ローズ_008]
		//なんでもない。じゃせいぜいがんばって。変な箱かぶりながら！
	}
}//v
}//d

//変装時 h //e
//resource PR_ＳＡＶＥ後＿変装＿１
proc rp_PR_ＳＡＶＥ後＿変装＿１:02  {
vox t:vc250481 {
@rp_セクハラ＿是＿やりたがり系デフォルト 100
