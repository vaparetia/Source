proc スネークコート用水飛沫セット {
	chara 身体水飛沫 デブ飛沫 \
		-n d:PLAYER \
		-c sna_skl3 \
		-s 100
	chara 身体水飛沫 デブ飛沫 \
		-n d:PLAYER \
		-c sna_skl3 \
		-s 110
}

proc ＧＷ橋モデル消去セット {
	mesg プットオブジェ 橋本体_左半分 off
	mesg プットオブジェ 橋本体_右半分 off
}

proc 橋上のエフェクト消去セット {
	mesg 波紋 橋の床水飛沫１ 殺す
	mesg ライン水飛沫 橋の手すり水飛沫１ 殺す
}

// スローモーションセット群
proc スローモーションセット１ {
	chara スローパラメータ制御 スローな武器にしてくれ -s 100
	//-s は １００でデフォルトと同等



}
//スローで橋を通り過ぎる



proc スローモーションセット２ {
		// ディレイを使っていたの時の値 3880
		mesg スローパラメータ制御 スローな武器にしてくれ パーセント 10 60
}
proc スローモーションセット３ {
		// ディレイを使っていたの時の値 3880 + 4120
		mesg スローパラメータ制御 スローな武器にしてくれ パーセント 100 60
}
//スネーク降下時アップ
proc スローモーションセット４ {
		// ディレイを使っていたの時の値 3880 + 4120 + 6840
				mesg スローパラメータ制御 スローな武器にしてくれ パーセント 20 1
}
proc スローモーションセット５ {
		// ディレイを使っていたの時の値 3880 + 4120 + 6840 + 7280
					mesg スローパラメータ制御 スローな武器にしてくれ パーセント 100 30
}


proc シネマスクリーンセット  {
	chara シネマスクリーン シネマ \
		-top d:CINEMA_BELT_UPPER \
		-bottom d:CINEMA_BELT_LOWER \
		-ftime 60	//デフォルト値（ゼロは駄目）
	mesg シネマスクリーン シネマ フェードアウト 1
}

proc タイトルテロップＭＡＸ呼び出し {
	@タイトルテロップセット 45 56 \
							60 \
							50 \
							50 \
							45 (56+73) \
							60 \
							50 \
							50
}

proc タイトルテロップセット \
	$:d00a0_メインタイトル座標Ｘ $:d00a0_メインタイトル座標Ｙ\
	$:d00a0_メインタイトルフェードインタイム \
	$:d00a0_メインタイトルウェイト \
	$:d00a0_メインタイトルフェードアウトタイム \

	$:d00a0_サブタイトル座標Ｘ $:d00a0_サブタイトル座標Ｙ\
	$:d00a0_サブタイトルフェードインタイム \
	$:d00a0_サブタイトルウェイト \
	$:d00a0_サブタイトルフェードアウトタイム \
	{
	// メインタイトル "ＭＧＳ２"
	chara ２Ｄスプライト表示 体験版メインタイトルテロップ \
		-tri 	staff \
		-x 		title_mgs2_alp_ovl \
		-pos 	$:d00a0_メインタイトル座標Ｘ $:d00a0_メインタイトル座標Ｙ\
		-size	422 73 \
		-count  $:d00a0_メインタイトルフェードインタイム \
				$:d00a0_メインタイトルウェイト \
				$:d00a0_メインタイトルフェードアウトタイム
//		-flag 	d:FLAG_CENTER

	// サブタイトル "SONS OF LIBERTY"
	chara ２Ｄスプライト表示 体験版サブタイトルテロップ \
		-tri 	staff \
		-x 		title_sol_alp_ovl \
		-pos 	$:d00a0_サブタイトル座標Ｘ $:d00a0_サブタイトル座標Ｙ\
		-size	422 24 \
		-count  $:d00a0_サブタイトルフェードインタイム \
				$:d00a0_サブタイトルウェイト \
				$:d00a0_サブタイトルフェードアウトタイム
//		-flag 	d:FLAG_CENTER
}

// カメラ設定
// ------------------------------------
proc 各種カメラ作成 {
	chara カメラ ステージカメラ	-c 0 -l 3 -p 0
	chara カメラ サブカメラ１	-c 0 -l 2 -p 30
	chara カメラ サブカメラ２	-c 0 -l 2 -p 20
	chara カメラ サブカメラ３	-c 0 -l 2 -p 10
}


// 以下吉池が追加しました。
// ------------------------------------
// このgcl内でよんでいます。
proc 橋水飛沫用床設置 {
	#if d:DEBUG_PRINT
		print 't00a_tr_floor_set'
	#endif

	chara 透明床 橋水飛沫用床 \
		-position 0,66000,18000 \
				-400000,66000,18000 \
				-400000,66000,14000 \
				0,66000,14000 \
		-n_points 4 \
		-attribute ( d:HZX_FLOOR_ATR_ALL & ~(d:HZX_FLOOR_NO_PLAYER) & ~(d:HZX_FLOOR_NO_ENEMY) ) \
		-map ＧＷ橋

}

// 以下はMAXでよんでいます。
// chara デモアクトデバッグ (２箇所)に追加しました。
proc 橋水飛沫用床消去 {
	#if d:DEBUG_PRINT
		print 't00a_tr_floor_off'
	#endif

	mesg 透明床 橋水飛沫用床 off
}

proc monologue_cancel {
	mesg デモキャンセルチェック monologue_cancel kill
	command StreamStopAll	// 全てのストリームを停止
}

// [追加] 2001/09/03 Uehara Masatoshi
proc リアル影セット {

	chara 影投影モデル 甲板の影もでる \
		-m w00k6 \
		-p 0 0 0

	chara 影管理 影かんり \
		-t 0 \
//		-a 64 \		影の濃さ（0〜128）
		-p 1000 -1000 750

	mesg 影管理 影かんり demo_add sna_dive00 甲板の影もでる	// スネーク

}
proc 甲板の影オン {
	mesg 影管理 影かんり demo_add sna_dive00 甲板の影もでる	// スネーク
}
proc 甲板の影オフ {
	mesg 影管理 影かんり del sna_dive00	// スネーク
}

