// 各gclで必要なdefine
// ------------------------------------
// モード
#define		STAGE_TANKER	1		// 共通プロック切り分け用
#define		DEMO_STAGE		1		// デモステージかどうかで起動するキャラを切り分ける

// defines
// デバグ用各種
// -----------------------------------
#define PLAYER			スネーク
#define STAGE_KMS		d00a
#define STAGE_HZX		d00a
#define STAGE_LT2		d00a			// LT2ファイルを変える場合、ここにLT2名を入れる。
#define STAGE_LT2_2		w00a			//
#define LT2_SCALE		d00a_scale10	// 10倍スケール用LT2ファイル
#define screen_shot				0 // スクリーンショット使用
#define 起動時フェードイン		0 // 起動時フェードイン使用

// includes
// ------------------------------------
#include "5sec_bfr_demo.h"
#include "demo_stdch.h"
#include "demo_stdch2.h"
#include "demo_vardef.h"
#include "story.h"
#include "sload.h"
#include "sound.h"
#include "d00a_cdc.ch"

// キャスティングシアター対応。
#include "lowpoly.h"
@ローポリ設定


// マップ
// ------------------------------------
chara マップ ＧＷ橋 -h d:STAGE_HZX -l d:STAGE_LT2

// マップ設定
// ------------------------------------
command マップ設定 ＧＷ橋 -s {

print 'main_000'

//	デモ環境かゲーム環境かで起動を読み分ける。
// ------------------------------------
#if d:MGS2_DEMO
	//chara デモアクトデバッグ demodebug  -i t:t00a1D -d 't00a1D' -l  -s 't00a1D : monologue_opening' -e 120 -v 1
chara デモアクトデバッグ demodebug  -i t:t00a2D -d 't00a2D' -l   \
	-p  スローモーションセット１ スローモーションセット２ \
		スローモーションセット３ スローモーションセット４ \
		スローモーションセット５ \
		タンカー上の各種エフェクトセット \
		波面セット \
		ＧＷ橋モデル消去セット \
		橋上のエフェクト消去セット \
		タイトルテロップＭＡＸ呼び出し \
		甲板の影オン 甲板の影オフ \
		橋水飛沫用床消去


#else
	proc end_monologue {
		print 'モノローグ終了'
		eval($f:モノローグチェック = 1)
		chara delay ディレイ \
			-time 10 \
			-exec{
				command メニュー設定 -pause on
				command メニュー設定 -radio on
				restart
			}
	}
		
	proc ld_next_stage {
		if ($f:ローポリ劇場フラグ == d:TRUE) {
			// ローポリ劇場中
			@mv_lowpoly

		} else {
			// 通常ゲーム中
			print '$w:t_story = d:ST_T00a2Dオープニングポリゴンデモ１終了'
			eval($w:t_story = d:ST_T00a2Dオープニングポリゴンデモ１終了)

			mesg デモキャンセルチェック デモキャンセル kill

			eval($f:t00a1無線 = 1)
			restart
		}
	}

	proc rt_強制ＣＡＬＬ_T_00b1Rオープニング無線機デモ終了 {

		eval($f:t00a1無線 = 0)

		command セットサウンドコード -c d:SNG_FOUTS_S		//ＢＧＭフェードアウト

		chara delay ディレイ \
			-time 1 \
			-exec{
				load "d01t"
			}
	}

	proc demo_cancel {
		command StreamStopAll
	}

	if($f:t00a1無線 == 1){

		chara サウンドマネージャー ＳＤマネ -pak 0
		//サウンドマネージャーだけ書くと雨・風ＳＥがなってしまうので、下でそれらのプロックをはずしてやる。

		command セットサウンドコード -c d:SNG_PLAY_06		//ＢＧＭ雨音

		@rt_強制ＣＡＬＬ_T_00b1Rオープニング無線機デモ


	}else{
		if($f:モノローグチェック == 0) {
			print 'モノローグスタート'
			command メニュー設定 -pause off
			command メニュー設定 -radio off
			chara デモキャンセルチェック monologue_cancel -p monologue_cancel
			command Stream t:vc060501 -p end_monologue
		} else {
			chara デモキャンセルチェック デモキャンセル \
				-p demo_cancel

			print '$w:t_story = d:ST_T00a2Dオープニングポリゴンデモ１開始'
			eval($w:t_story = d:ST_T00a2Dオープニングポリゴンデモ１開始)
			@デモモデル差し替え処理
			proc デモ再生_t00a2D {
				print 'モノローグなし'
				chara demo デモ再生 \
					-i t:t00a2D \			// ストリーミング用t:シンボル normal_opening
					-p  スローモーションセット１ スローモーションセット２ \
						スローモーションセット３ スローモーションセット４ \
						スローモーションセット５ \
						タンカー上の各種エフェクトセット \
						波面セット \
						ＧＷ橋モデル消去セット \
						橋上のエフェクト消去セット \
						タイトルテロップＭＡＸ呼び出し \
						甲板の影オン 甲板の影オフ \
						橋水飛沫用床消去 \
					-next ld_next_stage			// 終了時に呼び出されるproc
			}
			@デモ再生_t00a2D
		}
	}

#endif

	//---------------------------------------------------------------
	// さわる必要のないもの。外したい場合は、行の先端に「//」を入れる。
	//---------------------------------------------------------------
	@常駐キャラ設定						// stdch.hで定義

#if d:MGS2_DEMO
	if(1){
#else
	if(($f:t00a1無線 == 0) && ($f:モノローグチェック != 0)){	//通信のときに雨・風音を鳴らさないように。
#endif

print 'main_000_5'
		@カメラ雨セット
print 'main_001'
		@天球_新空_新雷セット
print 'main_002'
		@霧雨セット
print 'main_002_5'
		@岡嶋ブラーセット
print 'main_003'
		@ＧＷ橋セット
print 'main_004'
		@タンカーセット
		@投光器セット
print 'main_005'
		@橋とセットのマンハッタンぼんぼりセット
print 'main_005_2'
		@橋のワイヤーぼんぼりセット
print 'main_005_3'
//		@スローモーションセット
print 'main_005_4'
#if d:MGS2_DEMO
		@シネマスクリーンセット
#else
		if($f:モノローグチェック != 0) {
			@シネマスクリーンセット
		}
#endif

	//---------------------------------------------------------------
	// パラメータをいじれるもの。command.def参照。
	//---------------------------------------------------------------
print 'main_006'
		@風制御セット
print 'main_007'
		@雨セット
print 'main_008'
		@フォグセット
print 'main_010'
		@川岸のぼかし
print 'main_011'
		@手すりなどの水飛沫セット
print 'main_012'
		@路面の水飛沫セット

		// 吉池追加 2001.05.07
		@橋水飛沫用床設置

		// [追加] 2001/09/03 Uehara Masatoshi
		@リアル影セット

//	@タンカー上の各種エフェクトセット // 7300
//	@波面セット 1 // ←メモリ 足りず、、、8250
//	@ＧＷ橋モデル消去セット // 11680
//	@橋上のエフェクト消去セット // 6400

	//---------------------------------------------------------------
	// 以下はシナリオ班用。
	//---------------------------------------------------------------
	}

	@スクリーンショット使用
} // <command マップ設定 ＧＷ橋>の閉じカッコ

// ====================================
// 初期マップ表示
// ====================================
	command マップ表示 -show ＧＷ橋

// マップshowの後でセットすること。
	@キャラクタ専用ライトセット

// 起動時フェードイン
#if d:起動時フェードイン
if ( $f:t00a1無線 == 0 ){
	@ロード時フェードイン
}
#endif


// ------------------------------------
// エフェクト関係
// ------------------------------------
proc 天球_新空_新雷セット {
	chara 天球 背景
	chara 新空 new_sky \
		    -m w00_sky
	chara 新雷フラッシュ thunder
}

proc 霧雨セット {
	chara 霧雨 霧雨
}

proc 岡嶋ブラーセット {
	chara ブラー okajibura
}

// ＧＷ橋セット（橋はスケール10倍、川岸は100倍）
proc ＧＷ橋セット {
print 'start'
	chara プットオブジェ 橋本体_左半分 \
		-m d00a0 \
		-r 0 0 0 \
		-p 0 0 0 \
		-s 1000 1000 1000 \
		-l d:LT2_SCALE \
		-f 0x0010
print 'd00a0'
	chara プットオブジェ 橋本体_右半分 \
		-m d00a1 \
		-r 0 0 0 \
		-p 0 0 0 \
		-s 1000 1000 1000 \
		-l d:LT2_SCALE \
		-f 0x0010

print 'd00a1'
	chara プットオブジェ 川岸 \
		-m d00a2 \
		-r 0 0 0 \
		-p 0 0 0 \
		-s 10000 10000 10000 \
		-l d:STAGE_LT2 \
		-f 0x0010

	chara プットオブジェ 川岸かき割 \
		-m d00a3 \
		-r 0 0 0 \
		-p 0 0 0 \
		-s 100000 100000 100000 \
		-l d:STAGE_LT2 \
		-f 0x0010

print 'd00a2'
	chara ジョージワシントン橋のライン補強モデル lines
}
/*
d00a2.kms
d00a1.kms
d00a0.kms
*/

proc タンカーセット {
	chara プットオブジェ タンカー \
		-m d00a_tanker \
		-r 0 0 0 \
		-p 0 0 0 \
		-s 100 100 100 \
		-l d:STAGE_LT2_2 \
		-f 0x0010

	chara 煙突煙 smoke \
		-n 4 \
		-p	 4000,25000,-1000 \
			 4000,25000,-3000 \
			-4000,25000,-1000 \
			-4000,25000,-3000

	chara プットオブジェ ウィンドラス -m w00a_winch -r 0 0 0 -p 0 0 0  -l d:STAGE_LT2_2 -s 100 100 100

}

proc 投光器セット {

	// 左舷スポットライト
	// ライトのビーム
	chara 固定ボリュームライト 左舷投光器 \
		-p -19670,13610,-14914 \
		-d 0,19000,-11000 \
		-n 16 \		// 16 (max=32)
		-l 15000 \	// 15000
		-w 1000		// 1000
	// 投光器のモデル
	chara プットオブジェ 左舷の投光器 \
		-m w00_sl2 \
		-r 0 0 0 \
		-p 0 0 0 \
		-l d:STAGE_LT2 \
		-s 100 100 100

	// 右舷スポットライト
	// ライトのビーム
	chara 固定ボリュームライト 右舷投光器 \
		-p 19670,13610,-14914 \
		-d 0,19000,-11000 \
		-n 16 \		// 16 (max=32)
		-l 15000 \	// 15000
		-w 1000		// 1000
	// 投光器のモデル
	chara プットオブジェ 右舷の投光器 \
		-m w00_sl1 \
		-r 0 0 0 \
		-p 0 0 0 \
		-l d:STAGE_LT2 \
		-s 100 100 100

}

proc 風制御セット {
	chara 風制御 wind \
		-i 100 \			// 通常風速のＭＡＸ値
		-j 300 \			// 突風風速のＭＡＸ値
		-r -1024 1024 0 \	// 通常風の方向（0 0 0 で真下に向かって吹く）
		-a 4 \				// 方向のランダム幅（4096で360度を表す）
		-b 300 \			// 突風頻度（何フレームに一回（目安））
		-c 150				// 突風持続時間のＭＡＸ値（フレーム数）
}

proc 雨セット {
	chara 雨速度可変 slow_rain \
		-n 32 \		// 量
		-c 128 \		// 輝度
		-b -20000 0 -20000 20000 3000 -3000 // 表示バウンダリ（二点でボックスを形成）
}

proc 波面セット {
print 'wave_set'

	//中心位置から10ユニットずつ前後左右に広がります。(デフォルト 0,-2000, 0)
	//うねり周期は、0 厳禁。周期なので大きいほど遅くなります。(デフォルト 256)
	chara 波面 wave \
		-p 0,-6000,0 \	// 中心位置
		-s 128 \		// うねりの周期
		-n 3 \			// 波濤の数
		-no_sound \   // 音を鳴らしたくない
		-w 5 5 \
		-b 	     0,200,  20500,6,    0,  0 \	// 並び順： posx, posy, posz, size, roty, alpha
			 18000,500,-255000,8, 1251,-25 \
			-18000,500,-245000,8,-1251,-25 \
		-x 0,-135500 20000,132500		// (前2つ)非表示領域位置：中心座標 ／ (後2つ)非表示領域：幅/奥行
		// posx posz 波涛出現位置
		// posy      波涛発生高さの条件
		// size      波涛の高さ
		// roty      波涛の向き（4096 = 360deg）
		// alpha     波涛のα調整（-薄い  +濃い）

	chara 嵐の川波 高波 \
		-tex wave wave06 wave09_alp_ovl \
		-dir 100,-20,100 \		// ローカル並行光ベクトル
		-color 160,160,160 \	// 平行光ＲＧＢ
		-ambient 10,10,10 \		// 環境光ＲＧＢ
		-pos 0,-4000,0

print 'wave_set_end!!!!!!!!!!'

}

proc フォグセット {
	if($f:モノローグチェック == 0) {
		chara フォグ 霧 \
			 -c 0 0 0 \		// ＲＧＢ
			 -n 0 \			// ニア値
			 -f 1			// ファー値
	} else {
		chara フォグ 霧 \
			 -c 16 32 27 \		// ＲＧＢ
			 -n -5000 \			// ニア値
			 -f 1600000			// ファー値
	}
}

proc 川岸のぼかし {
	chara 遠景ぼかし far_blur \
		-plane	2 \			// 枚数
		-near	50000 \		// ニア値
		-far	100000 \	// ファー値
		-enable
}

proc キャラクタ専用ライトセット {
print 'chara_light_start'
	chara 環境光 アンビ \
		 -c 6 20 30

	chara 平行光 パラ \
		 -c 86 85 48 \
		 -p -1287 -3357 -5545
print 'chara_light_end'
}

proc カメラ雨セット {
print 'camera_rain_set'
	//「プットテクスチャクロスフェードカメラ」と
	//「プットテクスチャクロスフェードカメラドア」の前にセットする
	chara カメラ雨 カメラ雨 \
		-l 0 \
		-i 1	// 不可視起動
	mesg カメラ雨 カメラ雨 オフ

print 'camera_rain_set_end'
}

proc 橋とセットのマンハッタンぼんぼりセット {
	chara プットテクスチャクロスフェードターゲット無し 点滅無しぼんぼり \
		-t xlit04b_alp \
		-u xlit04a_alp \
		-v xlit05b_alp \
		-p 21000,69950,14500 \
		       0,69950,14500 \
		  -20000,69950,14500 \
		  -40000,69950,14500 \
		  -60000,69950,14500 \
		  -80000,69950,14500 \
		 -100000,69950,14500 \
		 -120000,69950,14500 \
		   21000,69950,49500 \
		       0,69950,49500 \
		  -20000,69950,49500 \
		  -40000,69950,49500 \
		  -60000,69950,49500 \
