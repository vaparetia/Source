// 敵兵 
// ------------------------------------
#if d:ENEMY

	proc 攻撃兵０ {
	#if d:SHIELD
		chara アタッカー 敵兵１ -r 0 -s 1 -i 5000 -e 1
		chara アタッカー 敵兵２ -r 0 -s 1 -i 5000 -e 1
	#else
		chara アタッカー 敵兵１ -r 0 -s 1 -i 5000
		chara アタッカー 敵兵２ -r 0 -s 1 -i 5000
	#endif
//		chara アタッカー 敵兵３ -r 2 -s 1
//		chara アタッカー 敵兵４ -r 2 -s 1
	}

	proc 警備兵０ {
		chara 警備兵 警備兵１ -r 0 -n 0 -d 17500,-5000,-92000 -s 3 -f 4
		chara 警備兵 警備兵２ -r 4 -n 0 -d 17000,-5000,-92000 -s 1 -f 4
		chara 警備兵 警備兵３ -r 3 -n 0 -d 13500,-5000,-92000 -s 1 -i 8000 -f 4
		chara 警備兵 警備兵４ -r 5 -n 0 -d -17250,-5000,-92000 -s 1 -f 4
	}

	proc サポート兵 {
//		chara サポート兵 敵兵 -r 2 -s 1 -b 警備兵１
//		chara サポート兵 敵兵 -r 3 -s 1 -b 警備兵２
//		chara サポート兵 敵兵 -r 3 -s 1 -b 警備兵３
	}

	proc 警備兵コマンダー {
		chara 警備コマンダー wccomm -e {警備兵０ サポート兵}
	}

	proc 攻撃兵コマンダー {
		chara 攻撃コマンダー atcomm -e 攻撃兵０
	}
	
	chara コマンダー 敵兵セット \
		-w 警備兵コマンダー \
		-a 攻撃兵コマンダー \
		-r 17250,-5000,-92000 \
		-c 17250,-5000,-92000

#endif

// プレイヤー 
// ------------------------------------
#if d:SNAKE

	chara プレイヤー スネーク \
//		-p $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,$i:プレイヤー初期Ｚ位置 \
		-p -17000, -5000, -2000 \
		-d 0,0,0 \
		-s 0 \
		-m sna_def -a snake

//バンダナ
		chara ロープモデル３ バンダナ１ \
			-n sna_bdn1 \
			-d 1 \
			-y スネーク \
			-z 12 \
			-x 0,60,-90 \
			-m 12 \
			-p 250 \
			-k 350 \
			-o 110 \
			-f 1

		chara ロープモデル３ バンダナ２ \
			-n sna_bdn2 \
			-d 1 \
			-y スネーク \
			-z 12 \
			-x 0,50,-90 \
			-m 22 \
			-p 250 \
			-k 350 \
			-o 110 \
			-f 1

#else

	chara プレイヤー ライデン \
//		-p $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,$i:プレイヤー初期Ｚ位置 \
		-p -17000, -5000, -2000 \
		-d 0,0,0 \
		-s 0 \
		-o raiden

#endif


