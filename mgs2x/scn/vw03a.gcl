#define		TUUROKAGE		0
#define		ENEMY			1
#define		LIGHT			1
#define		SHITAI			1
#define		DEPTH			0
#define		BLUR			1
#define		KIRISAME		0
#define		TEXLIGHT		1
#define		SNAKE			1
#define		BODYSHDOW		1
#define		CHARACAMERA		0
#define		SHIELD			1


#if d:SNAKE
	#define		PLAYER	スネーク
#else
	#define		PLAYER	ライデン
#endif


#include "sload.h"
#include "stdch.h"


// 常駐キャラの設定
// ------------------------------------
	@常駐キャラ設定


// サウンド
// ------------------------------------
command sound -x 0x01000010 -w /* BGM(現在は全ステージ共通) */
command sound -x 0xFE00007F -w /* 常駐波形 */
command sound -x 0x0200007c -w /* ステージSE */
command sound -x 0xFE00007c -w /* ステージ波形 */
command sound -x 0x01000002  /* ＢＧＭ２曲目（アクション曲）再生 */


// マップ
// ------------------------------------
	chara マップ 長廊下 -k null -h vw03a -g 0 -l vw03a

// 光源関係 (最終的には *.lit )に組み入れる
// ------------------------------------
#if d:LIGHT

	chara 環境光 環境光源 \
		 -c 15 15 15
	
	chara 平行光 平行光源 \
		 -c 0 0 0 \
		 -d 512 4000 0

#endif

	chara フォグ 霧\
		-c 0, 0, 0 \
		-n 5000 \
		-f 35000 



// 天井
// ------------------------------------
	chara 天井君 天井1 -m w03cr -h -1500 -p 0,0,-90000 -l vw03a
//	chara 天井君 天井2 -m w02br -h 1 -p 0,0,0 -l w02a

// 入出トラップ
// ------------------------------------
//		trap w02a_w01a_l スネーク -mask 入る -proc mv_w02a_w01a_0
//		trap w02a_w01a_r スネーク -mask 入る -proc mv_w02a_w01a_1

// カメラ設定 
// ------------------------------------
	chara カメラ ステージカメラ	-c 0 -l 3 -p 0 
	chara カメラ 長廊下カメラ１	-c 0 -l 2 -p 5 
	chara カメラ 長廊下カメラ２	-c 0 -l 2 -p 5 

	// デフォルトカメラ
	chara カメラ設定 ステージカメラ \
		-c 0 \	
		-b -17000,-32000,-132000 -17500,-1800,32000 \
		-l -32000,-32000,-132000 32000,32000,32000 \
		-r 240,2048,0 \
		-f 3000 \
		-a 170 \
		-i 2 2 0 0 \
		-s 1

	// その他のカメラ
	trap c001 d:PLAYER \
		-mask ？ \
		-camera \
		-exec {
print 'trap c001'
			chara カメラ設定 長廊下カメラ１ \
			-c 0 \	
				-b -17250,-32000,-132000 -17250,-2200,32000 \
				-l -32000,-32000,-132000 32000,32000,32000 \
				-r 240,2048,0 \
				-f 3000 \
				-a 170 \
				-i 1 1 0 0 \
				-s $3
		}

	trap c002 d:PLAYER \
		-mask ？ \
		-camera \
		-exec {
print 'trap c002'
			chara カメラ設定 長廊下カメラ２ \
				-c 0 \	
				-b -32000,-1500,-121000 32000,-1000,-121000 \
				-l -32000,-32000,-130000 32000,32000,-121000 \
				-r 800,2048,0 \
				-f 2750 \
				-a 170 \
				-i 1 1 0 0 \
				-s $3
		}


