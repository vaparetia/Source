				mesg ＶＲ移動的 $1 即ルート変更 d:M_R:前作スネークルート７５
			} else if ( $1 == 移動的:22 ) {
				mesg ＶＲ移動的 $1 即ルート変更 d:M_R:前作スネークルート７６
			} else if ( $1 == 移動的:23 ) {
				mesg ＶＲ移動的 $1 即ルート変更 d:M_R:前作スネークルート７７
			} else if ( $1 == 移動的:24 ) {
				mesg ＶＲ移動的 $1 即ルート変更 d:M_R:前作スネークルート７８
			} else if ( $1 == 移動的:25 ) {
				mesg ＶＲ移動的 $1 即ルート変更 d:M_R:前作スネークルート７９
			} else if ( $1 == 移動的:26 ) {
				mesg ＶＲ移動的 $1 即ルート変更 d:M_R:前作スネークルート８０
			// act 6 ----------
/*
			} else if ( ($1 == 移動的:43) || ($1 == 移動的:44) || ($1 == 移動的:45) || ($1 == 移動的:46) || \
						($1 == 移動的:47) || ($1 == 移動的:48) || ($1 == 移動的:49) || ($1 == 移動的:50) || \
						($1 == 移動的:51) || ($1 == 移動的:52) || ($1 == 移動的:53) || ($1 == 移動的:54) || \
						($1 == 移動的:55) || ($1 == 移動的:56) ) {
				mesg ＶＲ移動的 $1 即ルート変更 d:M_R:前作スネークルート８３
*/
			}
		}

	}

	// 的起動制御処理
	// ------------------------------------
	proc ＶＲ次的移動開始スティンガー５面処理 {

		// ライデン or タキシードスネークを選択
		if ( ($s:選択プレイヤー == ライデン) ||  ($s:選択プレイヤー == タキシードスネーク) ) {

			// act 3 ----------
			if ( $1 == 移動的:04 ) {
				mesg ＶＲ的共通 移動的:08 移動開始
			} else if ( $1 == 移動的:05 ) {
				mesg ＶＲ的共通 移動的:09 移動開始
			} else if ( $1 == 移動的:06 ) {
				mesg ＶＲ的共通 移動的:10 移動開始
			} else if ( $1 == 移動的:08 ) {
				mesg ＶＲ的共通 移動的:11 移動開始
			// act 4 ----------
			} else if ( ($1 == 移動的:12) || ($1 == 移動的:13) ) {
				mesg ＶＲ的共通 移動的:14 移動開始
				mesg ＶＲ的共通 移動的:15 移動開始
				mesg ＶＲ的共通 移動的:16 移動開始
				mesg ＶＲ的共通 移動的:17 移動開始
			}

		// スネーク or プリスキンを選択
		} else if ( ($s:選択プレイヤー == スネーク) || ($s:選択プレイヤー == プリスキン) ) {

			// act 3 ----------
			if ( $1 == 移動的:05 ) {
				mesg ＶＲ的共通 移動的:11 移動開始
			} else if ( $1 == 移動的:06 ) {
				mesg ＶＲ的共通 移動的:09 移動開始
			} else if ( $1 == 移動的:07 ) {
				mesg ＶＲ的共通 移動的:10 移動開始
			} else if ( $1 == 移動的:08 ) {
				mesg ＶＲ的共通 移動的:12 移動開始
			// act 4 ----------
			} else if ( ($1 == 移動的:13) || ($1 == 移動的:14) ) {
				mesg ＶＲ的共通 移動的:15 移動開始
				mesg ＶＲ的共通 移動的:16 移動開始
				mesg ＶＲ的共通 移動的:17 移動開始
				mesg ＶＲ的共通 移動的:18 移動開始
				mesg ＶＲ的共通 移動的:19 移動開始
			}

		// 前作スネークを選択
		} else if ( $s:選択プレイヤー == 前作スネーク ) {

			// act 3 ----------
			if ( $1 == 移動的:06 ) {
				mesg ＶＲ的共通 移動的:12 移動開始
			} else if ( $1 == 移動的:07 ) {
				mesg ＶＲ的共通 移動的:10 移動開始
			} else if ( $1 == 移動的:08 ) {
				mesg ＶＲ的共通 移動的:11 移動開始
			} else if ( $1 == 移動的:09 ) {
				mesg ＶＲ的共通 移動的:13 移動開始
			// act 4 ----------
			} else if ( ($1 == 移動的:14) || ($1 == 移動的:15) ) {
				mesg ＶＲ的共通 移動的:16 移動開始
				mesg ＶＲ的共通 移動的:17 移動開始
				mesg ＶＲ的共通 移動的:18 移動開始
				mesg ＶＲ的共通 移動的:19 移動開始
				mesg ＶＲ的共通 移動的:20 移動開始
/*
			// act 6 ----------
			} else if ( $1 == 移動的:43 ) {
				mesg ＶＲ的共通 移動的:27 移動開始
				mesg ＶＲ的共通 移動的:28 移動開始
				mesg ＶＲ的共通 移動的:29 移動開始
				mesg ＶＲ的共通 移動的:30 移動開始
				mesg ＶＲ的共通 移動的:31 移動開始
				mesg ＶＲ的共通 移動的:32 移動開始
				mesg ＶＲ的共通 移動的:33 移動開始
				mesg ＶＲ的共通 移動的:34 移動開始
				mesg ＶＲ的共通 移動的:35 移動開始
				mesg ＶＲ的共通 移動的:36 移動開始
				mesg ＶＲ的共通 移動的:37 移動開始
				mesg ＶＲ的共通 移動的:38 移動開始
				mesg ＶＲ的共通 移動的:39 移動開始
				mesg ＶＲ的共通 移動的:40 移動開始
				mesg ＶＲ的共通 移動的:41 移動開始
				mesg ＶＲ的共通 移動的:42 移動開始
*/
			}
		}

	}


	// 敵兵や的の処理
	// ------------------------------------
	proc ＶＲ標的スティンガー５面設定 {

		// ライデン or タキシードスネークを選択
		if ( ($s:選択プレイヤー == ライデン) ||  ($s:選択プレイヤー == タキシードスネーク) ) {

			// 通常及びルート変更の標的
			command foreach -argc 6 -repeat 17 \
			-data { \
				// 的名,     フラグ,         ルート, 次的起動ノード, 変更ノード, スピード
				// act 2 ----------
				{ 移動的:01, $$i:標的フラグＥ, d:M_R:ライデンルート７, 0, 0, 25 }\
				{ 移動的:02, $$i:標的フラグＥ, d:M_R:ライデンルート８, 0, 0, 25 }\
				{ 移動的:03, $$i:標的フラグＥ, d:M_R:ライデンルート９, 0, 0, 25 }\
				// act 3 ----------
				{ 移動的:04, $$i:標的フラグＫ, d:M_R:共通ルート１,     1, 2, 75 }\
				{ 移動的:05, $$i:標的フラグＪ, d:M_R:共通ルート２,     1, 2, 75 }\
				{ 移動的:06, $$i:標的フラグＪ, d:M_R:共通ルート３,     1, 2, 75 }\
				{ 移動的:07, $$i:標的フラグＫ, d:M_R:共通ルート６,     1, 2, 75 }\
				{ 移動的:08, $$i:標的フラグＫ, d:M_R:共通ルート１,     1, 2, 75 }\
				{ 移動的:09, $$i:標的フラグＫ, d:M_R:共通ルート４,     1, 2, 75 }\
				{ 移動的:10, $$i:標的フラグＫ, d:M_R:共通ルート５,     1, 2, 75 }\
				{ 移動的:11, $$i:標的フラグＪ, d:M_R:共通ルート１,     1, 2, 75 }\
				// act 4 （前半）
				{ 移動的:12, $$i:標的フラグＫ, d:M_R:共通ルート２,     1, 2, 75 }\
				{ 移動的:13, $$i:標的フラグＫ, d:M_R:共通ルート３,     1, 2, 75 }\
				// act 5 ----------
				{ 移動的:18, $$i:標的フラグＨ, d:M_R:共通ルート３,     0, 2, 75 }\
				{ 移動的:19, $$i:標的フラグＨ, d:M_R:共通ルート４,     0, 2, 75 }\
				{ 移動的:20, $$i:標的フラグＨ, d:M_R:共通ルート１,     0, 2, 75 }\
				{ 移動的:21, $$i:標的フラグＨ, d:M_R:共通ルート６,     0, 2, 75 }\
			} \
			-exec { \
				if( $s:選択プレイヤー == タキシードスネーク ) {
					$$b:標的セット数 = $$b:標的セット数 + 1;
					if( $$b:標的セット数 % 2 ) {
						$$i:標的フラグ = ( $2 | d:VR_TRG_HIDESTART );
					} else {
						$$i:標的フラグ = ( $2 | d:VR_TRG_VISIBLESTART );
					}
				} else {
					$$i:標的フラグ = $2;
				}

				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグ \
					-route $3 \
					-dir 0 512 \
					-c ＶＲ標的破壊スティンガー５面処理 \
					-x ＶＲ次的移動開始スティンガー５面処理 $3 $4 \
					   ＶＲルート分岐スティンガー５面処理 $3 $5 \
					-speed $6
			}

			// 公転の標的
			command foreach -argc 9 -repeat 20 \
			-data { \
				// 的名,  フラグ,  ルート,  公転速度,  初期公転方向,  公転半径,  自転速度,  Ｙシフト,  スピード
				// act 4 （後半）
				{ 移動的:14, $$i:標的フラグＨ, d:M_R:ライデンルート２０,  768, 2048, 3250,  512,     0,   0 }\
				{ 移動的:15, $$i:標的フラグＨ, d:M_R:ライデンルート２１,  768,    0, 3250,  512,     0,   0 }\
				{ 移動的:16, $$i:標的フラグＨ, d:M_R:ライデンルート２２,  768, 1024, 3250,  512,     0,   0 }\
				{ 移動的:17, $$i:標的フラグＨ, d:M_R:ライデンルート２３, -768, 3072, 3250,  512,     0,   0 }\
				// act 6 ----------
				{ 移動的:22, $$i:標的フラグＨ, d:M_R:ライデンルート２８,    0,    0,    0, 2048,     0, 250 }\
				{ 移動的:23, $$i:標的フラグＧ, d:M_R:ライデンルート２８, 2048,    0, 2500,    0,     0, 250 }\
				{ 移動的:24, $$i:標的フラグＧ, d:M_R:ライデンルート２８, 2048,  683, 2500,    0,     0, 250 }\
				{ 移動的:25, $$i:標的フラグＧ, d:M_R:ライデンルート２８, 2048, 1365, 2500,    0,     0, 250 }\
				{ 移動的:26, $$i:標的フラグＧ, d:M_R:ライデンルート２８, 2048, 2048, 2500,    0,     0, 250 }\
				{ 移動的:27, $$i:標的フラグＧ, d:M_R:ライデンルート２８, 2048, 2731, 2500,    0,     0, 250 }\
				{ 移動的:28, $$i:標的フラグＧ, d:M_R:ライデンルート２８, 2048, 3413, 2500,    0,     0, 250 }\
				{ 移動的:29, $$i:標的フラグＧ, d:M_R:ライデンルート２８, 2048,  512, 1500,    0,  1000, 250 }\
				{ 移動的:30, $$i:標的フラグＧ, d:M_R:ライデンルート２８, 2048, 1536, 1500,    0,  1000, 250 }\
				{ 移動的:31, $$i:標的フラグＧ, d:M_R:ライデンルート２８, 2048, 2560, 1500,    0,  1000, 250 }\
				{ 移動的:32, $$i:標的フラグＧ, d:M_R:ライデンルート２８, 2048, 3584, 1500,    0,  1000, 250 }\
				{ 移動的:33, $$i:標的フラグＧ, d:M_R:ライデンルート２８, 2048,  512, 1500,    0, -1000, 250 }\
				{ 移動的:34, $$i:標的フラグＧ, d:M_R:ライデンルート２８, 2048, 1536, 1500,    0, -1000, 250 }\
				{ 移動的:35, $$i:標的フラグＧ, d:M_R:ライデンルート２８, 2048, 2560, 1500,    0, -1000, 250 }\
				{ 移動的:36, $$i:標的フラグＧ, d:M_R:ライデンルート２８, 2048, 3584, 1500,    0, -1000, 250 }\
				{ 移動的:37, $$i:標的フラグＧ, d:M_R:ライデンルート２８, 2048,    0,    0, 2048, -2000, 250 }\
			} \
			-exec { \
				if( $s:選択プレイヤー == タキシードスネーク ) {
					$$b:標的セット数 = $$b:標的セット数 + 1;
					if( ($$b:標的セット数 % 2) && ($$b:標的セット数 < 22) ) {
						$$i:標的フラグ = ( $2 | d:VR_TRG_HIDESTART );
					} else {
						$$i:標的フラグ = ( $2 | d:VR_TRG_VISIBLESTART );
					}
				} else {
					$$i:標的フラグ = $2;
				}

				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグ \
					-route $3 \
					-kouten $4 $5 $6 \
					-dir 0 $7 \
					-yshift 0 $8 0 \
					-c ＶＲ標的破壊スティンガー５面処理 \
					-speed $9
			}

		// スネーク or プリスキンを選択
		} else if ( ($s:選択プレイヤー == スネーク) || ($s:選択プレイヤー == プリスキン) ) {

			// 通常及びルート変更の標的
			command foreach -argc 6 -repeat 19 \
			-data { \
				// 的名,     フラグ,         ルート, 次的起動ノード, 変更ノード, スピード
				// act 2 ----------(50->35)
				{ 移動的:01, $$i:標的フラグＥ, d:M_R:スネークルート２９, 0, 0,  35 }\
				{ 移動的:02, $$i:標的フラグＥ, d:M_R:スネークルート３０, 0, 0,  35 }\
				{ 移動的:03, $$i:標的フラグＥ, d:M_R:スネークルート３１, 0, 0,  35 }\
				{ 移動的:04, $$i:標的フラグＥ, d:M_R:スネークルート３２, 0, 0,  35 }\
				// act 3 ----------(100->75)
				{ 移動的:05, $$i:標的フラグＫ, d:M_R:共通ルート１,       1, 2,  75 }\
				{ 移動的:06, $$i:標的フラグＫ, d:M_R:共通ルート２,       1, 2,  75 }\
				{ 移動的:07, $$i:標的フラグＫ, d:M_R:共通ルート３,       1, 2,  75 }\
				{ 移動的:08, $$i:標的フラグＫ, d:M_R:共通ルート６,       1, 2,  75 }\
				{ 移動的:09, $$i:標的フラグＪ, d:M_R:共通ルート４,       1, 2,  75 }\
				{ 移動的:10, $$i:標的フラグＪ, d:M_R:共通ルート５,       1, 2,  75 }\
				{ 移動的:11, $$i:標的フラグＪ, d:M_R:共通ルート１,       1, 2,  75 }\
				{ 移動的:12, $$i:標的フラグＪ, d:M_R:共通ルート６,       1, 2,  75 }\
				// act 4 （前半）(150->100)
				{ 移動的:13, $$i:標的フラグＫ, d:M_R:共通ルート２,       1, 2, 100 }\
				{ 移動的:14, $$i:標的フラグＫ, d:M_R:共通ルート５,       1, 2, 100 }\
				// act 5 ----------(150->100)
				{ 移動的:20, $$i:標的フラグＨ, d:M_R:共通ルート２,       0, 2, 100 }\
				{ 移動的:21, $$i:標的フラグＨ, d:M_R:共通ルート３,       0, 2, 100 }\
				{ 移動的:22, $$i:標的フラグＨ, d:M_R:共通ルート４,       0, 2, 100 }\
				{ 移動的:23, $$i:標的フラグＨ, d:M_R:共通ルート５,       0, 2, 100 }\
				{ 移動的:24, $$i:標的フラグＨ, d:M_R:共通ルート６,       0, 2, 100 }\
			} \
			-exec { \
				if( $s:選択プレイヤー == プリスキン ) {
					$$b:標的セット数 = $$b:標的セット数 + 1;
					if( $$b:標的セット数 % 2 ) {
						$$i:標的フラグ = ( $2 | d:VR_TRG_HIDESTART );
					} else {
						$$i:標的フラグ = ( $2 | d:VR_TRG_VISIBLESTART );
					}
				} else {
					$$i:標的フラグ = $2;
				}

				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグ \
					-route $3 \
					-dir 0 1024 \
					-c ＶＲ標的破壊スティンガー５面処理 \
					-x ＶＲ次的移動開始スティンガー５面処理 $3 $4 \
					   ＶＲルート分岐スティンガー５面処理 $3 $5 \
					-speed $6
			}

			// 公転の標的
			command foreach -argc 9 -repeat 5 \
			-data { \
				// 的名,  フラグ,  ルート,  公転速度,  初期公転方向,  公転半径,  自転速度,  Ｙシフト,  スピード
				// act 4 （後半）(1024->768)
				{ 移動的:15, $$i:標的フラグＧ, d:M_R:スネークルート４３,  768, 3584, 3250,  512,     0,   0 }\
				{ 移動的:16, $$i:標的フラグＨ, d:M_R:スネークルート４４, -768, 3584, 3250,  512,     0,   0 }\
				{ 移動的:17, $$i:標的フラグＧ, d:M_R:スネークルート４５,  768, 1536, 3250,  512,     0,   0 }\
				{ 移動的:18, $$i:標的フラグＧ, d:M_R:スネークルート４６,  768, 2048, 3250,  512,     0,   0 }\
				{ 移動的:19, $$i:標的フラグＨ, d:M_R:スネークルート４７, -768, 3584, 3250,  512,     0,   0 }\
			} \
			-exec { \

				if( $s:選択プレイヤー == プリスキン ) {
					$$b:標的セット数 = $$b:標的セット数 + 1;
					if( ($$b:標的セット数 % 2) && ($$b:標的セット数 < 25) ) {
						$$i:標的フラグ = ( $2 | d:VR_TRG_HIDESTART );
					} else {
						$$i:標的フラグ = ( $2 | d:VR_TRG_VISIBLESTART );
					}
				} else {
					$$i:標的フラグ = $2;
				}

				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグ \
					-route $3 \
					-kouten $4 $5 $6 \
					-dir 0 $7 \
					-yshift 0 $8 0 \
					-c ＶＲ標的破壊スティンガー５面処理 \
					-speed $9
			}

			// 的ハリアー
			command foreach -argc 7 -repeat 14 \
			-data { \
				// 的名,  フラグ,              ルート,              Ｘシフト, Ｙシフト, Ｚシフト, スピード
				// act 6 ----------(500->400)
				{ 移動的:25, $$i:標的フラグＨ, d:M_R:スネークルート５４,      0,   500,      0, 400 }\
				{ 移動的:26, $$i:標的フラグＧ, d:M_R:スネークルート５４,      0,     0,   2000, 400 }\
				{ 移動的:27, $$i:標的フラグＧ, d:M_R:スネークルート５４,  -2000,     0,  -1000, 400 }\
				{ 移動的:28, $$i:標的フラグＧ, d:M_R:スネークルート５４,   2000,     0,  -1000, 400 }\
				{ 移動的:29, $$i:標的フラグＧ, d:M_R:スネークルート５４,  -4000,     0,  -2000, 400 }\
				{ 移動的:30, $$i:標的フラグＧ, d:M_R:スネークルート５４,      0,     0,  -2000, 400 }\
				{ 移動的:31, $$i:標的フラグＧ, d:M_R:スネークルート５４,   4000,     0,  -2000, 400 }\
				{ 移動的:32, $$i:標的フラグＧ, d:M_R:スネークルート５４,  -2000,     0,  -3000, 400 }\
				{ 移動的:33, $$i:標的フラグＧ, d:M_R:スネークルート５４,   2000,     0,  -3000, 400 }\
				{ 移動的:34, $$i:標的フラグＧ, d:M_R:スネークルート５４,  -6000,     0,  -3000, 400 }\
				{ 移動的:35, $$i:標的フラグＧ, d:M_R:スネークルート５４,   6000,     0,  -3000, 400 }\
				{ 移動的:36, $$i:標的フラグＧ, d:M_R:スネークルート５４,      0,  1000,  -4000, 400 }\
				{ 移動的:37, $$i:標的フラグＧ, d:M_R:スネークルート５４,  -1000,     0,  -5000, 400 }\
				{ 移動的:38, $$i:標的フラグＧ, d:M_R:スネークルート５４,   1000,     0,  -5000, 400 }\
			} \
			-exec { \

				chara ＶＲ移動的 $1 \
					-flag $2 \
					-route $3 \
					-yshift $4 $5 $6 \
					-c ＶＲ標的破壊スティンガー５面処理 \
//					-x ＶＲルート分岐スティンガー５面処理 $3 2 \
					-speed $7
			}

		// 前作スネークを選択
		} else if ( $s:選択プレイヤー == 前作スネーク ) {

			// 通常及びルート変更の標的
			command foreach -argc 6 -repeat 21 \
			-data { \
				// 的名,     フラグ,         ルート, 次的起動ノード, 変更ノード, スピード
				// act 2 ----------
				{ 移動的:01, $$i:標的フラグＥ, d:M_R:前作スネークルート５５, 0, 0,  50 }\
				{ 移動的:02, $$i:標的フラグＥ, d:M_R:前作スネークルート５６, 0, 0,  75 }\
				{ 移動的:03, $$i:標的フラグＥ, d:M_R:前作スネークルート５７, 0, 0,  60 }\
				{ 移動的:04, $$i:標的フラグＥ, d:M_R:前作スネークルート５８, 0, 0,  55 }\
				{ 移動的:05, $$i:標的フラグＥ, d:M_R:前作スネークルート５９, 0, 0,  65 }\
				// act 3 ----------
				{ 移動的:06, $$i:標的フラグＫ, d:M_R:共通ルート１,       1, 2, 100 }\
				{ 移動的:07, $$i:標的フラグＫ, d:M_R:共通ルート２,       1, 2, 100 }\
				{ 移動的:08, $$i:標的フラグＫ, d:M_R:共通ルート３,       1, 2, 100 }\
				{ 移動的:09, $$i:標的フラグＫ, d:M_R:共通ルート６,       1, 2, 100 }\
				{ 移動的:10, $$i:標的フラグＪ, d:M_R:共通ルート４,       1, 2, 100 }\
				{ 移動的:11, $$i:標的フラグＪ, d:M_R:共通ルート５,       1, 2, 100 }\
				{ 移動的:12, $$i:標的フラグＪ, d:M_R:共通ルート１,       1, 2, 100 }\
				{ 移動的:13, $$i:標的フラグＪ, d:M_R:共通ルート６,       1, 2, 100 }\
				// act 4 （前半）
				{ 移動的:14, $$i:標的フラグＫ, d:M_R:共通ルート２,       1, 2, 125 }\
				{ 移動的:15, $$i:標的フラグＫ, d:M_R:共通ルート５,       1, 2, 125 }\
				// act 5 ----------
				{ 移動的:21, $$i:標的フラグＨ, d:M_R:共通ルート２,       0, 2, 125 }\
				{ 移動的:22, $$i:標的フラグＨ, d:M_R:共通ルート３,       0, 2, 125 }\
				{ 移動的:23, $$i:標的フラグＨ, d:M_R:共通ルート１,       0, 2, 125 }\
				{ 移動的:24, $$i:標的フラグＨ, d:M_R:共通ルート４,       0, 2, 125 }\
				{ 移動的:25, $$i:標的フラグＨ, d:M_R:共通ルート５,       0, 2, 125 }\
				{ 移動的:26, $$i:標的フラグＨ, d:M_R:共通ルート６,       0, 2, 125 }\
			} \
			-exec { \

				// 前作スネークは順番を逆にする
				$$b:標的セット数 = $$b:標的セット数 + 1;
				if( $$b:標的セット数 % 2 ) {
					$$i:標的フラグ = ( $2 | d:VR_TRG_VISIBLESTART );
				} else {
					$$i:標的フラグ = ( $2 | d:VR_TRG_HIDESTART );
				}

				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグ \
					-route $3 \
					-dir 0 1024 \
					-c ＶＲ標的破壊スティンガー５面処理 \
					-x ＶＲ次的移動開始スティンガー５面処理 $3 $4 \
					   ＶＲルート分岐スティンガー５面処理 $3 $5 \
					-speed $6
			}

			// 公転の標的
			command foreach -argc 9 -repeat 21 \
			-data { \
				// 的名,  フラグ,  ルート,  公転速度,  初期公転方向,  公転半径,  自転速度,  Ｙシフト,  スピード
				// act 4 （後半）
				{ 移動的:16, $$i:標的フラグＧ, d:M_R:前作スネークルート７０, -1024,    0, 3250,  768,     0,   0 }\
				{ 移動的:17, $$i:標的フラグＧ, d:M_R:前作スネークルート７１,  1024, 3584, 3250,  768,     0,   0 }\
				{ 移動的:18, $$i:標的フラグＨ, d:M_R:前作スネークルート７２, -1024, 1024, 3250,  768,     0,   0 }\
				{ 移動的:19, $$i:標的フラグＧ, d:M_R:前作スネークルート７３,  1024, 2048, 3250,  768,     0,   0 }\
				{ 移動的:20, $$i:標的フラグＧ, d:M_R:前作スネークルート７４,  1024, 3072, 3250,  768,     0,   0 }\
				// act 6 ----------
				{ 移動的:27, $$i:標的フラグＮ, d:M_R:前作スネークルート８１,     0,    0,    0, 2048,     0, 300 }\
				{ 移動的:28, $$i:標的フラグＭ, d:M_R:前作スネークルート８１,  2048,    0, 2500,    0,     0, 300 }\
				{ 移動的:29, $$i:標的フラグＭ, d:M_R:前作スネークルート８１,  2048,  683, 2500,    0,     0, 300 }\
				{ 移動的:30, $$i:標的フラグＭ, d:M_R:前作スネークルート８１,  2048, 1365, 2500,    0,     0, 300 }\
				{ 移動的:31, $$i:標的フラグＭ, d:M_R:前作スネークルート８１,  2048, 2048, 2500,    0,     0, 300 }\
				{ 移動的:32, $$i:標的フラグＭ, d:M_R:前作スネークルート８１,  2048, 2731, 2500,    0,     0, 300 }\
				{ 移動的:33, $$i:標的フラグＭ, d:M_R:前作スネークルート８１,  2048, 3413, 2500,    0,     0, 300 }\
				{ 移動的:34, $$i:標的フラグＭ, d:M_R:前作スネークルート８１,  2048,  512, 1500,    0,  1000, 300 }\
				{ 移動的:35, $$i:標的フラグＭ, d:M_R:前作スネークルート８１,  2048, 1536, 1500,    0,  1000, 300 }\
				{ 移動的:36, $$i:標的フラグＭ, d:M_R:前作スネークルート８１,  2048, 2560, 1500,    0,  1000, 300 }\
				{ 移動的:37, $$i:標的フラグＭ, d:M_R:前作スネークルート８１,  2048, 3584, 1500,    0,  1000, 300 }\
				{ 移動的:38, $$i:標的フラグＭ, d:M_R:前作スネークルート８１,  2048,  512, 1500,    0, -1000, 300 }\
				{ 移動的:39, $$i:標的フラグＭ, d:M_R:前作スネークルート８１,  2048, 1536, 1500,    0, -1000, 300 }\
				{ 移動的:40, $$i:標的フラグＭ, d:M_R:前作スネークルート８１,  2048, 2560, 1500,    0, -1000, 300 }\
				{ 移動的:41, $$i:標的フラグＭ, d:M_R:前作スネークルート８１,  2048, 3584, 1500,    0, -1000, 300 }\
				{ 移動的:42, $$i:標的フラグＭ, d:M_R:前作スネークルート８１,  2048,    0,    0, 2048, -2000, 300 }\
			} \
			-exec { \

				// 前作スネークは順番を逆にする
				$$b:標的セット数 = $$b:標的セット数 + 1;
				if( ($$b:標的セット数 % 2) && ($$b:標的セット数 < 27) ) {
					$$i:標的フラグ = ( $2 | d:VR_TRG_VISIBLESTART );
				} else {
					$$i:標的フラグ = ( $2 | d:VR_TRG_HIDESTART );
				}

				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグ \
					-route $3 \
					-kouten $4 $5 $6 \
					-dir 0 $7 \
					-yshift 0 $8 0 \
					-c ＶＲ標的破壊スティンガー５面処理 \
					-speed $9
			}

			// 的ハリアー
			command foreach -argc 6 -repeat 14 \
			-data { \
				// 的名,     フラグ,     Ｘシフト, Ｙシフト, Ｚシフト, スピード
				// act 6 ----------
				{ 移動的:43, $$i:標的フラグＫ,     0,   500,      0, 400 }\
				{ 移動的:44, $$i:標的フラグＪ,     0,     0,   2000, 400 }\
				{ 移動的:45, $$i:標的フラグＪ, -2000,     0,  -1000, 400 }\
				{ 移動的:46, $$i:標的フラグＪ,  2000,     0,  -1000, 400 }\
				{ 移動的:47, $$i:標的フラグＪ, -4000,     0,  -2000, 400 }\
				{ 移動的:48, $$i:標的フラグＪ,     0,     0,  -2000, 400 }\
				{ 移動的:49, $$i:標的フラグＪ,  4000,     0,  -2000, 400 }\
				{ 移動的:50, $$i:標的フラグＪ, -2000,     0,  -3000, 400 }\
				{ 移動的:51, $$i:標的フラグＪ,  2000,     0,  -3000, 400 }\
				{ 移動的:52, $$i:標的フラグＪ, -6000,     0,  -3000, 400 }\
				{ 移動的:53, $$i:標的フラグＪ,  6000,     0,  -3000, 400 }\
				{ 移動的:54, $$i:標的フラグＪ,     0,  1000,  -4000, 400 }\
				{ 移動的:55, $$i:標的フラグＪ, -1000,     0,  -5000, 400 }\
				{ 移動的:56, $$i:標的フラグＪ,  1000,     0,  -5000, 400 }\
			} \
			-exec { \

				chara ＶＲ移動的 $1 \
					-flag  $2 \
					-route d:M_R:前作スネークルート８３ \
					-yshift $3 $4 $5 \
					-c ＶＲ標的破壊スティンガー５面処理 \
//					-x ＶＲルート分岐スティンガー５面処理 d:M_R:前作スネークルート８２ 3 \
//					   ＶＲ次的移動開始スティンガー５面処理 d:M_R:前作スネークルート８２ 1 \
					-speed $6
			}

		}

	}

	proc ＶＲ初期配置標的スティンガー５面設定 {
		// 共通標的 （主にライデン）
		mesg ＶＲ的共通 移動的:01 移動開始
		mesg ＶＲ的共通 移動的:02 移動開始
		mesg ＶＲ的共通 移動的:03 移動開始

		// 他キャラ選択時の追加標的s
		// スネーク or プリスキン
		if ( ($s:選択プレイヤー == スネーク) || ($s:選択プレイヤー == プリスキン) ) {
			mesg ＶＲ的共通 移動的:04 移動開始
		// 前作スネーク
		} else if ( $s:選択プレイヤー == 前作スネーク ) {
			mesg ＶＲ的共通 移動的:04 移動開始
			mesg ＶＲ的共通 移動的:05 移動開始
		}
	}


//###################################################################################
//									 ＢＧＭ
//###################################################################################

	// ------------------------------------
	// ＢＧＭの設定
	// ------------------------------------
	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT
			print 'bgm_set'
		#endif

		chara ＢＧＭマネージャー ＢＧＭマネ
	}


//###################################################################################
//									 アイテム
//###################################################################################

	// ------------------------------------
	// アイテムの設定
	// ------------------------------------
	// 再発生が必要な時は以下のプロックの中を記述する
	// ------------------------------------
	proc アイテム取得時番号設定 $:ボックス名 {
		#if d:DEBUG_PRINT
			print 'item_no_set'
		#endif
	}
	// アイテムの設置
	// ------------------------------------
	proc アイテム設定 {
		#if d:DEBUG_PRINT
			print 'item_set'
		#endif
	}



//###################################################################################
//									 エフェクト
//###################################################################################

	// ------------------------------------
	// 光源関係
	// ------------------------------------
	// フォグ
	// ------------------------------------
	// キャラ用光源(マップの設置が終わってから設定することで、キャラだけに光を当てる)
	// ------------------------------------



//###################################################################################
//									 カメラ
//###################################################################################
	// ------------------------------------
	// カメラ関係の設定
	// ------------------------------------
	// ステージカメラ設定
	// ------------------------------------
	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'chara_camera & stage_camera_set'
		#endif

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0
		chara カメラ メインカメラ		-c 0 -l 2 -p 40
		chara カメラ クリア時カメラ		-c 0 -l 0 -p 10

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 250,2048,0 \
			-f 9000 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}
	// ステージ固有のカメラ設定
	// ------------------------------------
	proc 武器訓練スティンガー５面カメラ設定 {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif
	}



//###################################################################################
//									 その他
//###################################################################################


// -----------------------------------------------------------------------------------
// 以下デバッグ専用proc
// -----------------------------------------------------------------------------------
// デバッグキャラ
// ------------------------------------
proc デバッグキャラセット {
	#if d:DEBUG_PRINT
		print 'debug_chara_set'
	#endif

	#if d:CHARA_CAMERA
		chara キャラカメラ 敵兵カメラ \
			-c d:TARGET_CHARA \
			-s -920,610,200 \
			-r -200,1024,0
	#endif

	#if d:SCREENSHOT
		chara スクリーンショット shot
	#endif

	#if d:USB_KEY
		chara USBキーボード実行 test \
			-e d:KBD_ESC {
				mesg プレイヤー d:PLAYER position -5500, -13000, -500
			} \
	#endif
}

