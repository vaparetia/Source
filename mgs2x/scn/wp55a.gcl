// ------------------------------------
// マップ設定
// ------------------------------------
chara マップ 武器訓練スティンガー５面 -k d:KMS_NAME -h d:HZX_NAME,0 -l $s:ＶＲライトファイル名

command マップ設定 武器訓練スティンガー５面 -set {
	// ローカルの初期化
	// ------------------------------------
	@ローカル変数初期化		// ローカルで使用する変数で初期化をする場合はここで

	// ＶＲで必要な基本プロックのセット(vr_common.hで定義)
	// サウンドの基本パック、ＶＲの基本システム、プレイヤー、ゴール等を設定します
	// ※このプロックを使用する時は「ＶＲクリア時処理」というプロックが必要です
	// ------------------------------------
	@ＶＲ共通プロックセット sna_wp55a rai_wp55a d:VR_GOAL_TARGET 0 0 -4000

	// ＶＲウィンドウの設定
	// ------------------------------------
	@武器訓練スティンガー５面ＶＲウィンドウ設定

	// クリア時に呼ばれるものの設定
	// ------------------------------------
	@ＶＲクリア設定 p:load_select p:load_wp55a

	// ステージに引かれるライン
	// ------------------------------------
	@ＶＲアウトライン d:KMS_NAME d:TONBO_KMS_NAME d:LINE_KMS_NAME

	// 設定値を変更する場合は以下のプロック内で設定
	// ------------------------------------
	@設定値変更				// 敵兵や的のパラメータをステージ限定で変える時はここで
	@プラグイン設定			// プレイヤーのプラグインがいる時はここで

	// 的関係の設定
	// ------------------------------------
	@ＶＲ標的スティンガー５面設定				// ＶＲシステム起動後に呼ぶ

	// ＢＧＭの設定(プレイヤー→敵兵→BGMの順で呼ぶ。的の場合は関係ないがとりあえずここに)
	// ------------------------------------
	@ＢＧＭ設定

	// アイテムの設定
	// ------------------------------------
	@アイテム設定

	// 光源、オブジェクト、カメラ関連の設定
	// ------------------------------------
	@ＶＲフォグ設定 d:VR_FOG:朝Ｎ d:VR_FOG:朝Ｆ d:VR_FOG:夕Ｎ 55000 -8000 43000
	@カメラセット						// chara カメラとベースのカメラを設定
	@武器訓練スティンガー５面カメラ設定	// ステージ固有のカメラ設定がいる時はこのプロックで
	@ＶＲキャラ用ライト設置				// vr_common.hに定義。必ず最後に設定
#if d:DEBUG_CHARA
//	@デバッグキャラセット
#endif

}

//初期マップの表示
command マップ表示 -show 武器訓練スティンガー５面


//###################################################################################
//									各proc設定
//###################################################################################



//###################################################################################
//									全マップ共通
//###################################################################################
	// ------------------------------------
	// 全マップ共通
	// ------------------------------------
	//------------------------------------------------------------
	// ＶＲウィンドウの設定と表示
	//------------------------------------------------------------
	proc 武器訓練スティンガー５面ＶＲウィンドウ設定 {
		#if d:DEBUG_PRINT
			print 'vr_window_set'
		#endif

		@ＶＲウィンドウ設定	[VRMSG_J:VRM_WPN_STG_wp55a] [VRMSG_E:VRM_WPN_STG_wp55a] [VRMSG_G:VRM_WPN_STG_wp55a] \	// 日、英、独
							[VRMSG_F:VRM_WPN_STG_wp55a] [VRMSG_I:VRM_WPN_STG_wp55a] [VRMSG_S:VRM_WPN_STG_wp55a] \	// 仏、伊、西
							[VRMSG_K:VRM_WPN_STG_wp55a] \															// 韓
							p:ＶＲステージ開始時処理								// 終了プロック


		// ＶＲウィンドウを表示する
		mesg ＶＲウィンドウ ＶＲウィンドウ君 開く

		// スタート時とクリア時に使用するカットインカメラ
		chara カメラ カットインカメラ		-c 0 -l 0 -p 0

		// スタート時のカメラ(必要な場合)
		chara カメラ設定 カットインカメラ \
			-c 1 \	
			-p 0,6600,-1650 -t 0,0,-4000 \
			-r 800,2048,0 -f 9000 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1
	}

	//------------------------------------------------------------
	// ステージ開始時処理
	//------------------------------------------------------------
	proc ＶＲステージ開始時処理 {
		#if d:DEBUG_PRINT
			print 'game_start!!!!!'
		#endif

		// プレイヤーやパッドの制御等を行う a_stdproc.hで定義
		@全ミッション共通ステージ開始時処理

		// カメラワークスタート(必要な場合)
		// 全体図
		chara カメラ設定 カットインカメラ \
			-c 1 \	
			-p 0,20000,50000 -t 0,15500,38870 \
			-r 250,2048,0 -f 12000 \
			-a 200 \
			-i 4 4 d:START_CAMERA_CHANGE_TIME d:START_CAMERA_CHANGE_TIME \
			-s 1

		chara delay ディレイ \
			-time d:START_CAMERA_CHANGE_TIME \
			-exec {
				chara カメラ設定 カットインカメラ -s -1
			}
	}

	// ------------------------------------
	// クリア時の処理
	// ------------------------------------
	proc ＶＲクリア時処理 {
		#if d:DEBUG_PRINT
			print 'clear'
		#endif

		// 強制モーションを発動
		@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_2 3748

		// クリア時にカメラアングルを変える
		chara カメラ設定 クリア時カメラ \
			-c 1 \
			-p -2200,1100,-600 -t -160,1100,-4050 \
			-r 0,1700,0 -f 4000 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}

	//------------------------------------------------------------
	// ステージ開始直後処理
	//------------------------------------------------------------
	proc ゲーム開始直後処理 {
		// 初期配置標的の起動（command ＶＲステージスタート の起動直後に行う必要がある）
		@ＶＲ初期配置標的スティンガー５面設定
	}


	// ------------------------------------
	// パラメータ系の変更
	// ------------------------------------
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT
			print 'localvar_init'
		#endif

		// 的管理用各種フラグを初期化する
		$$b:act_1_破壊数カウント = 0;
		$$b:act_2_破壊数カウント = 0;
		$$b:act_3_破壊数カウント = 0;
		$$b:act_4_破壊数カウント = 0;
		$$b:act_5_破壊数カウント = 0;

		$$b:標的セット数 = 0;
		$$i:標的フラグ = 0;

//		$$i:標的フラグＡ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST );
//		$$i:標的フラグＢ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST );
//		$$i:標的フラグＣ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    );
		$$i:標的フラグＤ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST                  | d:VR_TRG_WAIT );
		$$i:標的フラグＥ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST | d:VR_TRG_WAIT );
//		$$i:標的フラグＦ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    | d:VR_TRG_WAIT );
		$$i:標的フラグＧ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST                  | d:VR_TRG_WAIT | d:VR_TRG_CIRCLE );
		$$i:標的フラグＨ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST | d:VR_TRG_WAIT | d:VR_TRG_CIRCLE );
//		$$i:標的フラグＩ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    | d:VR_TRG_WAIT | d:VR_TRG_CIRCLE );
		$$i:標的フラグＪ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST                  | d:VR_TRG_WAIT | d:VR_TRG_NO_APPEAR_EF );
		$$i:標的フラグＫ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST | d:VR_TRG_WAIT | d:VR_TRG_NO_APPEAR_EF );
//		$$i:標的フラグＬ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    | d:VR_TRG_WAIT | d:VR_TRG_NO_APPEAR_EF );

		// 以下はＵＦＯ専用フラグ
		$$i:標的フラグＭ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST                  | d:VR_TRG_WAIT | d:VR_TRG_CIRCLE | d:VR_TRG_NO_APPEAR_EF );
		$$i:標的フラグＮ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST | d:VR_TRG_WAIT | d:VR_TRG_CIRCLE | d:VR_TRG_NO_APPEAR_EF );

	}

	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT
			print 'status_set'
		#endif

		// 初期装備の設定
		// ライデンの初期装備
		$w:武器弾数Ｒ[ d:武器:スティンガー ] = 75
//		$w:武器 = d:武器:スティンガー
		command シナリオ前武器変更	-number d:武器:スティンガー
	}
	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif

	}



//###################################################################################
//									 的兵
//###################################################################################

	// ------------------------------------
	// スティンガー５面
	// ------------------------------------

	// 破壊時処理
	// ------------------------------------
	proc ＶＲ標的破壊スティンガー５面処理 {

		// ライデン or タキシードスネークを選択
		if ( ($s:選択プレイヤー == ライデン) ||  ($s:選択プレイヤー == タキシードスネーク) ) {

			if ( ($1 == 移動的:01) || ($1 == 移動的:02) || ($1 == 移動的:03) ) {
				($$b:act_1_破壊数カウント = $$b:act_1_破壊数カウント + 1)
				if ( $$b:act_1_破壊数カウント == 3 ){
					mesg ＶＲ的共通 移動的:04 移動開始
					mesg ＶＲ的共通 移動的:05 移動開始
					mesg ＶＲ的共通 移動的:06 移動開始
					mesg ＶＲ的共通 移動的:07 移動開始
				}

			} else if ( ($1 == 移動的:04) || ($1 == 移動的:05) || ($1 == 移動的:06) || ($1 == 移動的:07) || \
						($1 == 移動的:08) || ($1 == 移動的:09) || ($1 == 移動的:10) || ($1 == 移動的:11) ) {
				($$b:act_2_破壊数カウント = $$b:act_2_破壊数カウント + 1)

				if ( $$b:act_2_破壊数カウント == 8 ){
					mesg ＶＲ的共通 移動的:12 移動開始
					mesg ＶＲ的共通 移動的:13 移動開始
				}
				// 次的制御開始前に破壊された場合は即起動する
				if ( $1 == 移動的:04 ) {
					mesg ＶＲ的共通 移動的:08 移動開始
				} else if ( $1 == 移動的:05 ) {
					mesg ＶＲ的共通 移動的:09 移動開始
				} else if ( $1 == 移動的:06 ) {
					mesg ＶＲ的共通 移動的:10 移動開始
				} else if ( $1 == 移動的:08 ) {
					mesg ＶＲ的共通 移動的:11 移動開始
				}

			} else if ( ($1 == 移動的:12) || ($1 == 移動的:13) || ($1 == 移動的:14) || \
						($1 == 移動的:15) || ($1 == 移動的:16) || ($1 == 移動的:17) ) {
				($$b:act_3_破壊数カウント = $$b:act_3_破壊数カウント + 1)

				if ( $$b:act_3_破壊数カウント == 6 ){
					mesg ＶＲ的共通 移動的:18 移動開始
					mesg ＶＲ的共通 移動的:19 移動開始
					mesg ＶＲ的共通 移動的:20 移動開始
					mesg ＶＲ的共通 移動的:21 移動開始
				}
				// 次的制御開始前に破壊された場合は即起動する
				if ( ($1 == 移動的:12) || ($1 == 移動的:13) ) {
					mesg ＶＲ的共通 移動的:14 移動開始
					mesg ＶＲ的共通 移動的:15 移動開始
					mesg ＶＲ的共通 移動的:16 移動開始
					mesg ＶＲ的共通 移動的:17 移動開始
				}
			} else if ( ($1 == 移動的:18) || ($1 == 移動的:19) || ($1 == 移動的:20) || ($1 == 移動的:21) ) {
				($$b:act_4_破壊数カウント = $$b:act_4_破壊数カウント + 1)
				if ( $$b:act_4_破壊数カウント == 4 ){
					mesg ＶＲ的共通 移動的:22 移動開始
					mesg ＶＲ的共通 移動的:23 移動開始
					mesg ＶＲ的共通 移動的:24 移動開始
					mesg ＶＲ的共通 移動的:25 移動開始
