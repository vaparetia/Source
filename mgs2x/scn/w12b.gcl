proc スタートカメラセット {
#if d:DEBUG_PRINT
	print '*** Start Camera Set ***'
#endif

	if($s:登場ポイント == sp_w12a_w12b0_0) {				// 屋上左から
		chara カメラ設定 モーションカメラ \
			-c 1 \
			-p -6211,9019,-5060 \
			-t -7739,6283,-8166 \
			-a 225 \
			-i 0 2 0 0 \
			-s 1
	} else if($s:登場ポイント == sp_w12a_w12b0_1) {			// 屋上右から
		chara カメラ設定 モーションカメラ \
			-c 1 \
			-p 6211,9019,-5060 \
			-t 7739,6283,-8166 \
			-a 225 \
			-i 0 2 0 0 \
			-s 1
	} else if($s:登場ポイント == sp_w13a_w12b0_0) {			// ＡＢ連絡橋から
		chara カメラ設定 モーションカメラ \
			-c 1 \
			-p -4081,4166,-5678 \
			-t -5422,1698,-9695 \
			-a 200 \
			-i 0 2 0 0 \
			-s 1
	} else if($s:登場ポイント == sp_w23a_w12b0_0) {			// ＦＡ連絡橋から
		chara カメラ設定 モーションカメラ \
			-c 1 \
			-p 4081,4166,-5678 \
			-t 5422,1698,-9695 \
			-a 200 \
			-i 0 2 0 0 \
			-s 1
	}
}

proc スタートカメラオフ {
#if d:DEBUG_PRINT
	print '*** Start Camera Off ***'
#endif

	chara カメラ設定 モーションカメラ -s 0
}

//-----------------------------------------------------------------------------
// ストーリー設定

proc ストーリー設定 {
#if d:DEBUG_PRINT
	print '*** Story Set ***'
#endif

	//---------------------------------------------------------
	// 強制移動・シナリオデモ
	if($w:p_story <= d:ST:P006_01_R01Ａ脚金網１無線デモ１終了) {
		trap ev001 d:PLAYER \
			-mask 入る \
			-exec {
				if($s:登場ポイント != w12b_リスタート１) {
					if(`command ゲームオーバーチェック` == 0 ) {
						mesg ＢＧＭマネージャー ＢＧＭマネ 潜入でもフェードアウトしない
						mesg プレイヤー d:PLAYER run -7724 1190 -2887 1 3072 d:FA_DIRECT_MOVE 強制移動後リスタート処理
					}

				} else {
					mesg ＢＧＭマネージャー ＢＧＭマネ 潜入でもフェードアウトしない
					@w12b_シナリオデモ開始
				}
			}
	}

	//---------------------------------------------------------
	// 強制無線
	if($w:p_story == d:ST:P007_01_R01Ａ脚ノード前１無線デモ１開始) {
		chara カメラ設定 でもデモカメラ \
			-c 1 \
			-p 1528,3419,-5540 \
			-t 1646,2875,-6264 \
			-a 200 \
			-i 0 0 0 0 \
			-s 1
		@rt_P007_01_R01Ａ脚ノード前１無線デモ１
	}
}

//-----------------------------------------------------------------------------
// 強制移動後リスタート処理
proc 強制移動後リスタート処理 {
#if d:DEBUG_PRINT
	print '*** After Direct Move ***'
#endif

	command パッド操作 -release

	chara delay ディレイ \
		-time 30 \
		-exec {
			eval($i:プレイヤー初期Ｘ位置 = -7724)
			eval($i:プレイヤー初期Ｙ位置 =  1190)
			#ifdef d:PAL
				eval($i:プレイヤー初期Ｚ位置 = -2927)
			#else
				eval($i:プレイヤー初期Ｚ位置 = -2887)
			#endif
			eval($i:プレイヤー初期方向   =  3072)
			eval($s:登場ポイント         = w12b_リスタート１)
			restart
		}
}

//-----------------------------------------------------------------------------
// フェードアウト後
proc SS_CB_フェードアウト後 {
#if d:DEBUG_PRINT
	print '*** After Fade Out ***'
#endif

	mesg パッドデモ パッドデモ kill
	@シナリオデモ終了処理

	eval($i:プレイヤー初期Ｘ位置 = -2245)	// -1750 から -2245 へ変更
	eval($i:プレイヤー初期Ｙ位置 =     0)
	eval($i:プレイヤー初期Ｚ位置 = -2026)	// -2250 から -2026 へ変更
	eval($i:プレイヤー初期方向   =     0)
	eval($s:登場ポイント         = w12b_リスタート２)
	eval($w:p_story = d:ST:P007_01_R01Ａ脚ノード前１無線デモ１開始)
	restart
}

//-----------------------------------------------------------------------------
// Ａ脚ノード前１無線デモ１後処理
proc w12b_Ａ脚ノード前１無線デモ１後処理 {
#if d:DEBUG_PRINT
	print '*** After Node Codec Demo ***'
#endif

	chara カメラ設定 でもデモカメラ -s 0
}

//-----------------------------------------------------------------------------
// センサーＢ無線後処理
proc w12b_センサーＢ無線後処理 {
#if d:DEBUG_PRINT
	print '*** After Sensor B Codec ***'
#endif

	if($s:登場ポイント == sp_w12a_w12b0_0) {
		eval($i:プレイヤー初期Ｘ位置 = -8000)
		eval($i:プレイヤー初期Ｙ位置 =  5000)
		eval($i:プレイヤー初期Ｚ位置 = -7750)
		eval($i:プレイヤー初期方向   =     0)
		eval($s:登場ポイント         = センサーＢスタート左)
		restart

	} else if($s:登場ポイント == sp_w12a_w12b0_1) {
		eval($i:プレイヤー初期Ｘ位置 =  8000)
		eval($i:プレイヤー初期Ｙ位置 =  5000)
		eval($i:プレイヤー初期Ｚ位置 = -7750)
		eval($i:プレイヤー初期方向   =     0)
		eval($s:登場ポイント         = センサーＢスタート右)
		restart

	} else {
		@爆弾タイマー開始
	}
}

//-----------------------------------------------------------------------------
// ロード設定
proc ロード設定 {
#if d:DEBUG_PRINT
	print '*** Load Set ***'
#endif

	// @ステージ終了時処理 目標位置  終了時方向  呼び出しプロックに入る  入ってゆく姿勢

	// 屋上左側へ (w12a、w12c)
	trap ld001 d:PLAYER \
		-mask 入る \
		-exec {
			if($f:ロードチェックＯＮフラグ == 1) {
				@爆弾タイマー残り時間保存
				if ($w:p_story < d:ST:P014_15_P07ピーター遭遇１５ポリゴンデモ７終了) {
					preseek 'w12a'
				} else {
					preseek 'w12c'
				}
				@ステージ終了時処理（ステージ名表示） -8000 5000 -11000 2048 mv_w12b0_w12a_0 d:DEFAULT_M_TYPE d:wn_Ａ脚屋上
			}
		}

	// 屋上右側へ (w12a、w12c)
	trap ld002 d:PLAYER \
		-mask 入る \
		-exec {
			if($f:ロードチェックＯＮフラグ == 1) {
				@爆弾タイマー残り時間保存
				if ($w:p_story < d:ST:P014_15_P07ピーター遭遇１５ポリゴンデモ７終了) {
					preseek 'w12a'
				} else {
					preseek 'w12c'
				}
				@ステージ終了時処理（ステージ名表示） 8000 5000 -11000 2048 mv_w12b0_w12a_1 d:DEFAULT_M_TYPE d:wn_Ａ脚屋上
			}
		}

	// ＡＢ連絡橋へ (w13a、w13b)
	trap ld003 d:PLAYER \
		-mask 入る \
		-exec {
			if($f:ロードチェックＯＮフラグ == 1) {
				@爆弾タイマー残り時間保存
				eval($s:登場ポイント = sp_w13a_w12b0_0)
				@スタートカメラセット
				if ($w:p_story < d:ST:P014_15_P07ピーター遭遇１５ポリゴンデモ７終了) {
					preseek 'w13a'
				} else {
					preseek 'w13b'
				}
				@ステージ終了時処理（ステージ名表示） -7375 0 -11500 3072 mv_w12b0_w13a_0 d:DEFAULT_M_TYPE d:wn_ＡＢ連絡橋
			}
		}

	// ＦＡ連絡橋へ (w23a、w23b)
	trap ld004 d:PLAYER \
		-mask 入る \
		-exec {
			if($f:ロードチェックＯＮフラグ == 1) {
				@爆弾タイマー残り時間保存
				eval($s:登場ポイント = sp_w23a_w12b0_0)
				@スタートカメラセット
				if ($w:p_story < d:ST:P014_15_P07ピーター遭遇１５ポリゴンデモ７終了) {
					preseek 'w23a'
				} else {
					preseek 'w23b'
				}
				@ステージ終了時処理（ステージ名表示） 7375 0 -11500 1024 mv_w12b0_w23a_0 d:DEFAULT_M_TYPE d:wn_ＦＡ連絡橋
			}
		}
}

proc ロードプロック {
#if d:DEBUG_PRINT
	print '*** Load Proc ***'
#endif

	if($s:呼び出しプロック == mv_w12b0_w12a_0) {
		// 屋上左側へ
		if((d:ST:P025_01_R01爆弾解体昇降機下１無線デモ１終了 <= $w:p_story) && ($w:p_story < d:ST:P032_01_P01ファットマン登場１ポリゴンデモ１開始)) {
			command セットサウンドコード -c d:SNG_FOUTS_S
		}
		@mv_w12b0_w12a_0

	} else if($s:呼び出しプロック == mv_w12b0_w12a_1) {
		// 屋上右側へ
		if((d:ST:P025_01_R01爆弾解体昇降機下１無線デモ１終了 <= $w:p_story) && ($w:p_story < d:ST:P032_01_P01ファットマン登場１ポリゴンデモ１開始)) {
			command セットサウンドコード -c d:SNG_FOUTS_S
		}
		@mv_w12b0_w12a_1

	} else if($s:呼び出しプロック == mv_w12b0_w13a_0) {
		// ＢＧＭのフェードアウト
		if(    ($f:w23a_サイファー遭遇デモフラグ == d:FALSE) \
			&& ($f:w13a_エルード説明デモフラグ   == d:FALSE) \
			&& ($w:アラートモード != d:ALERT_MODE_SENNYU)) {
			command セットサウンドコード -c d:SNG_FOUTS_S
		}
		// ＡＢ連絡橋へ
		@mv_w12b0_w13a_0

	} else if($s:呼び出しプロック == mv_w12b0_w23a_0) {
		// ＢＧＭのフェードアウト
		if(    ($f:w23a_サイファー遭遇デモフラグ == d:FALSE) \
			&& ($f:w13a_エルード説明デモフラグ   == d:FALSE) \
			&& ($w:アラートモード != d:ALERT_MODE_SENNYU)) {
			command セットサウンドコード -c d:SNG_FOUTS_S
		}
		// ＦＡ連絡橋へ
		@mv_w12b0_w23a_0
	}
}





//=============================================================================
// ステージ進入時処理
//=============================================================================

proc ステージ進入時処理 {
#if d:DEBUG_PRINT
	print '*** Stage Start Proc ***'
#endif

	// @ステージ開始時処理 タイプ(スライドドア、水密ドア、何もなし)   ドアの名前   移動距離   状態(前のステージ状態、走り、歩き)
	if($s:登場ポイント == sp_w12a_w12b0_0) {
		@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:SL_DOOR_TYPE 屋上左側へのドア 2000 d:DEFAULT_M_TYPE d:wn_Ａ脚ポンプ室

	} else if($s:登場ポイント == センサーＢスタート左) {
		@ステージ開始時処理 d:LOAD_TYPE:NO_MOVE_TYPE 0 0 d:DEFAULT_M_TYPE

	} else if($s:登場ポイント == sp_w12a_w12b0_1) {
		@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:SL_DOOR_TYPE 屋上右側へのドア 2000 d:DEFAULT_M_TYPE d:wn_Ａ脚ポンプ室

	} else if($s:登場ポイント == センサーＢスタート右) {
		@ステージ開始時処理 d:LOAD_TYPE:NO_MOVE_TYPE 0 0 d:DEFAULT_M_TYPE

	} else if($s:登場ポイント == sp_w13a_w12b0_0) {
		@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:SL_DOOR_TYPE ＡＢ連絡橋へのドア 2000 d:DEFAULT_M_TYPE d:wn_Ａ脚ポンプ室

	} else if($s:登場ポイント == sp_w23a_w12b0_0) {
		@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:SL_DOOR_TYPE ＦＡ連絡橋へのドア 2000 d:DEFAULT_M_TYPE d:wn_Ａ脚ポンプ室

	} else if($s:登場ポイント == w12b_リスタート１) {

	} else if($s:登場ポイント == w12b_リスタート２) {
		@ステージ開始時処理 d:LOAD_TYPE:NO_MOVE_TYPE 0 0 d:DEFAULT_M_TYPE

	} else if($s:登場ポイント == sp_w20a_w12b0_0) {
		@ステージ開始時処理（ダンボールワープ） d:wn_Ａ脚ポンプ室
	}
}
