}
proc アタッカーセット４ {
#if d:DEBUG_PRINT 
	print '*** Attacker Set 4 ***'
#endif

	if($w:p_story < d:ST:P041_02_R01エイムズ死亡後２無線デモ１終了) {
		@SS_アタッカー設定 敵兵:21 4 ($i:SS_敵兵ステータス) 0
		@SS_アタッカー設定 敵兵:22 4 ($i:SS_敵兵ステータス) 0
	} else {
		@SS_アタッカー設定 敵兵:21 4 ($i:SS_敵兵ステータス) 4
		@SS_アタッカー設定 敵兵:22 4 ($i:SS_敵兵ステータス) 4
	}

	// サポート兵
	if($w:p_story >= d:ST:P041_02_R01エイムズ死亡後２無線デモ１終了) {
