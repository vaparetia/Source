	}
}





//----- コマンダー
proc 警備兵コマンダー {
#if d:DEBUG_PRINT 
	print '*** Watcher Commander ***'
#endif

	if($w:p_story < d:ST:P007_01_R01Ａ脚ノード前１無線デモ１開始) {
		// 初登場時
		chara 警備コマンダー wccomm -e { 警備兵セット１ }

	} else if($w:p_story < d:ST:P014_15_P07ピーター遭遇１５ポリゴンデモ７終了) {
		// 爆弾解体前
		chara 警備コマンダー wccomm -e { 警備兵セット２ }

	} else if($w:p_story < d:ST:P024_01_R01爆弾解体センサーＢ入手１無線デモ１終了) {
		// 爆弾解体
		if ($w:ゲーム設定 < d:LEVEL_NORMAL) {
			chara 警備コマンダー wccomm -e { 警備兵セット２ }
		} else {
			chara 警備コマンダー wccomm -e { 警備兵セット３ }
		}

	} else if($w:p_story < d:ST:P031_01_P01フォーチュン戦終了１ポリゴンデモ１終了) {
		// センサーＢ
		chara 警備コマンダー wccomm -e { 警備兵セット３ }

	} else if($w:p_story < d:ST:P036_13_R04忍者登場１３無線デモ４終了) {
		// フォーチュン戦後
		if(    ($w:ゲーム設定 >= d:LEVEL_NORMAL) \
			&& (   ($s:登場ポイント == sp_w12a_w12b0_0) \
				|| ($s:登場ポイント == sp_w12a_w12b0_1))) {
			chara 警備コマンダー wccomm -e { 警備兵セット４ }
		} else {
			chara 警備コマンダー wccomm -e { 警備兵セット３ }
		}

	} else if($w:p_story < d:ST:P041_02_R01エイムズ死亡後２無線デモ１終了) {
		// ファットマン戦後
		chara 警備コマンダー wccomm -e { 警備兵セット３ }

	} else {
		// エイムズ後
		chara 警備コマンダー wccomm -e { 警備兵セット３ }
	}
}

proc 攻撃兵コマンダー {
#if d:DEBUG_PRINT 
	print '*** Attacker Commander ***'
#endif

	if($s:登場ポイント == sp_w12a_w12b0_0) {				// 屋上左から
		chara 攻撃コマンダー atcomm -e { アタッカーセット３ }
	} else if($s:登場ポイント == センサーＢスタート左) {	// センサーＢスタート左から
		chara 攻撃コマンダー atcomm -e { アタッカーセット３ }
	} else if($s:登場ポイント == sp_w12a_w12b0_1) {			// 屋上右から
		chara 攻撃コマンダー atcomm -e { アタッカーセット４ }
	} else if($s:登場ポイント == センサーＢスタート右) {	// センサーＢスタート右から
		chara 攻撃コマンダー atcomm -e { アタッカーセット４ }
	} else if($s:登場ポイント == sp_w13a_w12b0_0) {			// ＡＢ連絡橋から
		chara 攻撃コマンダー atcomm -e { アタッカーセット３ }
	} else if($s:登場ポイント == sp_w23a_w12b0_0) {			// ＦＡ連絡橋から
		chara 攻撃コマンダー atcomm -e { アタッカーセット４ }
	} else if($s:登場ポイント == w12b_リスタート２) {		// w12b_リスタート２
		chara 攻撃コマンダー atcomm -e { アタッカーセット３ }
	} else {												// ダンボールで
		chara 攻撃コマンダー atcomm -e { アタッカーセット４ }
	}
}





//----- 敵兵設定

proc 敵兵設定 {
#if d:DEBUG_PRINT
	print '*** Enemy Set ***'
#endif

	//---------------------------------------------------------
	// 敵兵ステータス
	eval($i:SS_敵兵ステータス = d:ENE_STATUS_GUNLIGHT)	// 通常は 0

	//---------------------------------------------------------
	// コマンダー
	//   -w 警備コマンダーproc  -a 攻撃コマンダーproc  -r 復活場所 マップＩＤ  -c 待機場所 マップＩＤ  -v 音声  -m 危険モード  -p クリアリングエリア ルート ポイント プロック  -x 司令官危険音声  -y 司令官警戒音声  -g 銃ライト  -z 麻酔持続時間  -b 危険モードでの復活人数 
	if(    ($w:p_story < d:ST:P007_01_R01Ａ脚ノード前１無線デモ１開始) \
		&& ($s:登場ポイント != w12b_リスタート１)) {
		// 潜入モードへ戻す
		// ALERT_MODE_SENNYU
		// ALERT_MODE_KIKEN
		// ALERT_MODE_KAIHI
		// ALERT_MODE_TANSAKU
		eval($w:スタートアラートモード = d:ALERT_MODE_SENNYU)

	} else {
		chara コマンダー 敵兵セット \
			-w 警備兵コマンダー \
			-a 攻撃兵コマンダー \
			-d 制御室 \
			-r -14500 0 -7750 制御室 14500 0 -7750 制御室 \
			-c -14500 0 -7750 制御室 14500 0 -7750 制御室 \
			-v [ene_plant_voice:01] \
			-x [ghq_area_alert_voice:w12b] \
			-y [ghq_caution_voice:w12b] \
			-p  0,-1,-1 クリアリングエリア０_初期設定 \
			    0,-2,-2 クリアリングエリア０_終了 \
			   -2,-2,-2 クリアリングカメラＯＦＦ \
			-z $i:敵標準麻酔持続 \
			-h $i:標準警戒時間 \
			-o $i:敵標準気絶持続 \
			-s d:ENE_STAGE_GPS \
			-b $w:敵標準再発生数 \
			-m $w:スタートアラートモード

		//---------------------------------------------------------
		// ルートチェンジ
		if($w:p_story < d:ST:P007_01_R01Ａ脚ノード前１無線デモ１開始) {
			// 初登場時
			trap ev002 敵兵:02 \
				-mask 入る \
				-exec {
					mesg 警備兵 敵兵:02 ルート変更 7 0 5000 -15000 制御室
				}
		}

		//---------------------------------------------------------
		// クリアリング子画面
		chara サブ画面 子画面

		//---------------------------------------------------------
		// クリアリングエリア０ 子画面制御
		trap clearing_0 d:PLAYER \
			-mask 出る \
			-exec {
				if($f:クリアリングフラグ０ == 1) {
					@クリアリングカメラＯＦＦ
				}
			}
	}
}
proc クリアリングカメラＯＦＦ {
#if d:DEBUG_PRINT
	print '*** Clearing Camera OFF ***'
#endif

	mesg サブ画面 子画面 off
	chara カメラ設定 クリアリングカメラ -s 0
}

//-----------------------------------------------------------------------------
// クリアリングエリア０設定
proc クリアリングエリア０_初期設定 {
#if d:DEBUG_PRINT
	print '*** Clearing Area 0: Init ***'
#endif

	if($w:p_story < d:ST:P041_02_R01エイムズ死亡後２無線デモ１終了) {
		command セットクリアリング \
			-p 0,0,0,クリアリングエリア０_カメラ０ \
			   0,0,4,クリアリングエリア０_カメラ１ \
			   0,0,7,クリアリングエリア０_カメラ２ \
			-i 0,1
	} else {
		command セットクリアリング \
			-p 0,0,0,クリアリングエリア０_カメラ０ \
			   0,0,4,クリアリングエリア０_カメラ１ \
			   0,0,7,クリアリングエリア０_カメラ２ \
			-i 0,1,2
	}

	eval($f:クリアリングフラグ０ = 1)
}
proc クリアリングエリア０内チェック {
#if d:DEBUG_PRINT
	print '*** Clearing Area 0: Bounding Check ***'
#endif

	if(    (-4250 < $i:プレイヤー位置Ｘ) && ($i:プレイヤー位置Ｘ <  4250) \
		&& (-9750 < $i:プレイヤー位置Ｚ) && ($i:プレイヤー位置Ｚ < -2500)) {
		return 1;
	} else {
		return 0;
	}
}
proc クリアリングエリア０_カメラ０ {
#if d:DEBUG_PRINT
	print '*** Clearing Area 0: Camera 0 ***'
#endif

	if(`@クリアリングエリア０内チェック`) {
		chara カメラ設定 クリアリングカメラ \
			-c 1 \
			-p -4453,2318,-282 \
			-t 2623,279,-2334 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1
		command カメラマップ設定 -chanl 1 -map 制御室
		mesg サブ画面 子画面 on
	}
}
proc クリアリングエリア０_カメラ１ {
#if d:DEBUG_PRINT
	print '*** Clearing Area 0: Camera 1 ***'
#endif

	if(`@クリアリングエリア０内チェック`) {
		chara カメラ設定 クリアリングカメラ \
			-c 1 \
			-p -4307,2712,-2944 \
			-t 1181,-511,-7119 \
			-a 180 \
			-i 0 -1 0 0 \
			-s 1
		command カメラマップ設定 -chanl 1 -map 制御室
		mesg サブ画面 子画面 on
	}
}
proc クリアリングエリア０_カメラ２ {
#if d:DEBUG_PRINT
	print '*** Clearing Area 0: Camera 2 ***'
#endif

	if(`@クリアリングエリア０内チェック`) {
		chara カメラ設定 クリアリングカメラ \
			-c 1 \
			-p -4101,2373,-7083 \
			-t 2508,-1159,-8356 \
			-a 180 \
			-i 0 -1 0 0 \
			-s 1
		command カメラマップ設定 -chanl 1 -map 制御室
		mesg サブ画面 子画面 on
	}
}
proc クリアリングエリア０_終了 {
#if d:DEBUG_PRINT
	print '*** Clearing Area 0: End ***'
#endif

	eval($f:クリアリングフラグ０ = 0)
	@クリアリングカメラＯＦＦ
}





//=============================================================================
// ビヨンド、ジャンプ
//=============================================================================

//-----------------------------------------------------------------------------
// ジャンプ設定
proc ジャンプ設定_ポンプ室 {
#if d:DEBUG_PRINT
	print '*** Jump Set: Pump Room ***'
#endif

	command プラグイン自動ジャンプ
	@ジャンプ発動 ky001 1000 50
}





//=============================================================================
// オブジェクト
//=============================================================================

//-----------------------------------------------------------------------------
// ドア設定
proc ドア設定 {
#if d:DEBUG_PRINT
	print '*** Door Set ***'
#endif

	// ドア
	//   -m オブジェクト名  -d 向き  -p 場所  -slide スライド量  -time 時間  -between マップ名１ マップ名２  -exec { $:開閉フラグ }

	// 屋上左側へのドア
	@ドアランプ設定 屋上左側へのドアランプ 0 -8750 5000 -9125 0
//	@主観禁止壁     屋上左側へのドア壁       -8750 5000 -9125 0 d:SD_SLIDE_OUTSIDE
	chara ドア 屋上左側へのドア \
		-m d:DOOR_NAME1 \
		-d 0 0 0 \
		-p -8750 5000 -9125 \
		-s d:SD_SLIDE_OUTSIDE \
		-t d:SD_OPEN_TIME \
		-A 屋上左側へのドアランプ \
		-b 制御室 制御室 \
		-exec {
			if(!($:開閉フラグ)) {
				mesg プットオブジェ 屋上ロード部左 off				// ロード部モデル
				mesg レンズフレア レンズフレア アルファ変更 0 1		// レンズフレア処理
				mesg ローカル風 隙間風 オフ
			} else {
				mesg プットオブジェ 屋上ロード部左 on				// ロード部モデル
				mesg レンズフレア レンズフレア アルファ変更 16 1	// レンズフレア処理
				mesg ローカル風 隙間風 オン
			}
		}
	trap dr001 ？ -mask ？ \
		-exec {
			if($3 == 入る) {
				mesg ドア 屋上左側へのドア open
			} else if($3 == 出る) {
				mesg ドア 屋上左側へのドア close
			}
		}
	trap dr001 d:PLAYER -mask ？ \
		-state d:TRP_STATE_SUBJECT \
		-exec {
			if($3 == 入る) {
				mesg 透明壁 屋上左側へのドア壁 on
			} else if($3 == 出る) {
				mesg 透明壁 屋上左側へのドア壁 off
			}
		}

	// 屋上右側へのドア
	@ドアランプ設定 屋上右側へのドアランプ 2048 8750 5000 -9125 1
//	@主観禁止壁     屋上右側へのドア壁          8750 5000 -9125 2048 d:SD_SLIDE_OUTSIDE
	chara ドア 屋上右側へのドア \
		-m d:DOOR_NAME1 \
		-d 0 2048 0 \
		-p 8750 5000 -9125 \
		-s d:SD_SLIDE_OUTSIDE \
		-t d:SD_OPEN_TIME \
		-A 屋上右側へのドアランプ \
		-b 制御室 制御室 \
		-exec {
			if(!($:開閉フラグ)) {
				mesg プットオブジェ 屋上ロード部右 off				// ロード部モデル
				mesg レンズフレア レンズフレア アルファ変更 0 1		// レンズフレア処理
				mesg ローカル風 隙間風 オフ
			} else {
				mesg プットオブジェ 屋上ロード部右 on				// ロード部モデル
				mesg レンズフレア レンズフレア アルファ変更 16 1	// レンズフレア処理
				mesg ローカル風 隙間風 オン
			}
		}
	trap dr002 ？ -mask ？ \
		-exec {
			if($3 == 入る) {
				mesg ドア 屋上右側へのドア open
			} else if($3 == 出る) {
				mesg ドア 屋上右側へのドア close
			}
		}
	trap dr002 d:PLAYER -mask ？ \
		-state d:TRP_STATE_SUBJECT \
		-exec {
			if($3 == 入る) {
				mesg 透明壁 屋上右側へのドア壁 on
			} else if($3 == 出る) {
				mesg 透明壁 屋上右側へのドア壁 off
			}
		}

	// ＡＢ連絡橋へのドア
	@ドアランプ設定 ＡＢ連絡橋へのドアランプ 722 -6350 0 -10050 0
//	@主観禁止壁     ＡＢ連絡橋へのドア壁         -6350 0 -10050 722 d:SD_SLIDE_OUTSIDE2
	chara ドア ＡＢ連絡橋へのドア \
		-m d:DOOR_NAME2 \
		-d 0 722 0 \
		-p -6350 0 -10050 \
		-s d:SD_SLIDE_OUTSIDE2 \
		-t d:SD_OPEN_TIME \
		-A ＡＢ連絡橋へのドアランプ \
		-b 制御室 制御室 \
		-exec {
			if(!($:開閉フラグ)) {
				mesg プットオブジェ ＡＢ連絡橋ロード部 off	// ロード部モデル
				mesg ローカル風 隙間風 オフ
			} else {
				mesg プットオブジェ ＡＢ連絡橋ロード部 on	// ロード部モデル
				mesg ローカル風 隙間風 オン
			}
		}
	trap dr003 ？ -mask ？ \
		-exec {
			if($3 == 入る) {
				mesg ドア ＡＢ連絡橋へのドア open
			} else if($3 == 出る) {
				mesg ドア ＡＢ連絡橋へのドア close
			}
		}
	trap dr003 d:PLAYER -mask ？ \
		-state d:TRP_STATE_SUBJECT \
		-exec {
			if($3 == 入る) {
				mesg 透明壁 ＡＢ連絡橋へのドア壁 on
			} else if($3 == 出る) {
				mesg 透明壁 ＡＢ連絡橋へのドア壁 off
			}
		}

	// ＦＡ連絡橋へのドア
	@ドアランプ設定 ＦＡ連絡橋へのドアランプ 1326 6350 0 -10050 1
//	@主観禁止壁     ＦＡ連絡橋へのドア壁          6350 0 -10050 1326 d:SD_SLIDE_OUTSIDE2
	chara ドア ＦＡ連絡橋へのドア \
		-m d:DOOR_NAME2 \
		-d 0 1326 0 \
		-p 6350 0 -10050 \
		-s d:SD_SLIDE_OUTSIDE2 \
		-t d:SD_OPEN_TIME \
		-A ＦＡ連絡橋へのドアランプ \
		-b 制御室 制御室 \
		-exec {
			if(!($:開閉フラグ)) {
				mesg プットオブジェ ＦＡ連絡橋ロード部 off	// ロード部モデル
				mesg ローカル風 隙間風 オフ
			} else {
				mesg プットオブジェ ＦＡ連絡橋ロード部 on	// ロード部モデル
				mesg ローカル風 隙間風 オン
			}
		}
	trap dr004 ？ -mask ？ \
		-exec {
			if($3 == 入る) {
				mesg ドア ＦＡ連絡橋へのドア open
			} else if($3 == 出る) {
				mesg ドア ＦＡ連絡橋へのドア close
			}
		}
	trap dr004 d:PLAYER -mask ？ \
		-state d:TRP_STATE_SUBJECT \
		-exec {
			if($3 == 入る) {
				mesg 透明壁 ＦＡ連絡橋へのドア壁 on
			} else if($3 == 出る) {
				mesg 透明壁 ＦＡ連絡橋へのドア壁 off
			}
		}

	// ポンプ室のドア
	@ドアランプ設定 ポンプ室のドアランプ 0 7250 0 125 2
	chara ドア ポンプ室のドア \
		-m d:DOOR_NAME3 \
		-d 0 0 0 \
		-p 7250 0 125 \
		-s d:SD_SLIDE_INSIDE \
		-t d:SD_OPEN_TIME \
		-c 1 \							// カードレベル１
		-A ポンプ室のドアランプ \
		-b ポンプ室 制御室 \
		-exec {
			if(!($:開閉フラグ)) {
				mesg マップ接合 Ａ脚接合 off	// マップ接合
			} else {
				mesg マップ接合 Ａ脚接合 on		// マップ接合
			}
		}
	trap dr005 ？ -mask ？ \
		-exec {
			if($3 == 入る) {
				mesg ドア ポンプ室のドア open $2
			} else if($3 == 出る) {
				mesg ドア ポンプ室のドア close $2
			}
		}
}

//-----------------------------------------------------------------------------
// ロッカー設定
proc ロッカー設定 {
#if d:DEBUG_PRINT
	print '*** Locker Set ***'
#endif

	chara ロッカー管理 管理人さん -n 4
	command ロッカーモーション -motion locker
	command プレイヤーロッカーモーション -motion sna_locker

	// $:ロッカー名 $:トラップ名 $:番号 $:モデル名 $:Ｘ座標 $:Ｙ座標 $:Ｚ座標 $:ステータス $:壁音番号 $:倒れ時床音番号 $:フラグ $:倒れシフトＸ $:倒れシフトＹ $:倒れシフトＺ $:倒れ回転Ｙ $:影ＩＤ {
	@SS_北ロッカー登録 ロッカー:01 lk001 0 (d:DOOR_NAME4) -10000 0 -4000 (0)                          1 4 (0) 0 0 0  -90 (0)
	@SS_北ロッカー登録 ロッカー:02 lk002 1 (d:DOOR_NAME4)  -9000 0 -4000 (d:LOCKER_STATE_NO_OPEN_SEG) 1 4 (0) 0 0 0  -80 (0)
	@SS_北ロッカー登録 ロッカー:03 lk003 2 (d:DOOR_NAME5)   9875 0 -4000 (d:LOCKER_STATE_POSTER)      1 4 (0) 0 0 0 -100 (0)
	@SS_北ロッカー登録 ロッカー:04 lk004 3 (d:DOOR_NAME4)  10875 0 -4000 (d:LOCKER_STATE_NO_OPEN_SEG) 1 4 (0) 0 0 0  -80 (0)
}

//-----------------------------------------------------------------------------
// CB_ロッカーチェック
proc SS_CB_ロッカーチェック $:番号 {
#if d:DEBUG_PRINT
	print '*** SS CB Locker Check ***'
#endif

	@壊れ物再セットチェック $b:w12b_破壊ロード回数[$:番号]
	if($f:再セットフラグ) {
		eval($i:w12b_ロッカー状態[$:番号] = 0)
	}

	return $i:w12b_ロッカー状態[$:番号]
}

//-----------------------------------------------------------------------------
// CB_ロッカー状態保存
proc SS_CB_ロッカー状態保存 $:開始終了 $:実行キャラ $:行動 $:ロッカー名 {
#if d:DEBUG_PRINT
	print '*** SS CB Locker Save ***'
#endif

	// ロッカー名と番号の対応
	if($:ロッカー名 == ロッカー:01) {
		eval($i:SS_ロッカー番号 = 0)
	} else if($:ロッカー名 == ロッカー:02) {
		eval($i:SS_ロッカー番号 = 1)
	} else if($:ロッカー名 == ロッカー:03) {
		eval($i:SS_ロッカー番号 = 2)
	} else if($:ロッカー名 == ロッカー:04) {
		eval($i:SS_ロッカー番号 = 3)
	}

	// 状態保存
	if(($:行動 != 6) && ($:行動 != 8)) {
		// 状態変化時
		eval($b:w12b_破壊ロード回数[$i:SS_ロッカー番号] = $w:グローバルロード回数);

	} else if($:行動 == 8) {
		// ステージ終了時
		command ロッカー状態 -n $:ロッカー名
		eval($i:w12b_ロッカー状態[$i:SS_ロッカー番号] = $status)
	}
}

//-----------------------------------------------------------------------------
// CB_ロッカー実行
proc SS_CB_ロッカー実行 $:トラップ名 $:フラグ $:トリガ $:ＰＸ $:ＰＹ $:ＰＺ {
#if d:DEBUG_PRINT
	print '*** SS CB Locker ***'
#endif

	//---------------------------------------------------------
	// 開閉実行処理
	if($:フラグ == 0) {

		if($:トラップ名 == lk001) {
			command ロッカー状態 -n ロッカー:01
			mesg プレイヤー d:PLAYER locker ロッカー:01 $status 2048,512 (-10000-50),-4000
		} else if($:トラップ名 == lk002) {
			command ロッカー状態 -n ロッカー:02
			mesg プレイヤー d:PLAYER locker ロッカー:02 $status 2048,512 (-9000-50),-4000
		} else if($:トラップ名 == lk003) {
			command ロッカー状態 -n ロッカー:03
			mesg プレイヤー d:PLAYER locker ロッカー:03 $status 2048,512 (9875-50),-4000
		} else if($:トラップ名 == lk004) {
			command ロッカー状態 -n ロッカー:04
			mesg プレイヤー d:PLAYER locker ロッカー:04 $status 2048,512 (10875-50),-4000
		}

	//---------------------------------------------------------
	// 開閉カメラ処理
	} else {
		if($:トラップ名 == lk001) {
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p -9382,4390,-1198 \
				-t -10271,1633,-3308 \
				-a 200 \
				-i 0 2 0 0 \
				-s $3
		} else if($:トラップ名 == lk002) {
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p -8096,4493,-1605 \
				-t -9525,1683,-3313 \
				-a 200 \
				-i 0 2 0 0 \
				-s $3
		} else if($:トラップ名 == lk003) {
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p 8096,4493,-1605 \
				-t 9525,1683,-3313 \
				-a 200 \
				-i 0 2 0 0 \
				-s $3
		} else if($:トラップ名 == lk004) {
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p 9382,4390,-1198 \
				-t 10271,1633,-3308 \
				-a 200 \
				-i 0 2 0 0 \
				-s $3
		}
	}
}

//-----------------------------------------------------------------------------
// アイテム設定
proc アイテム設定 {
#if d:DEBUG_PRINT
	print '*** Item Set ***'
#endif

	// ダンボール
	@ダンボール_初期設置 ダンボール:01 -4750 0 11500 0 25

	// ソコム弾薬
	@アイテム再セットチェック $b:w12b_取得ロード回数[0]
	if($f:再セットフラグ) {
		@弾薬_ソコム_初期設置 ソコム弾薬:01 -9500 200 -4250 0
	}

	// ソコム弾薬
	@アイテム再セットチェック $b:w12b_取得ロード回数[1]
	if($f:再セットフラグ) {
		@弾薬_ソコム_初期設置 ソコム弾薬:02 -8500 0 1000 0
	}

	// Ｍ９弾薬
	@アイテム再セットチェック $b:w12b_取得ロード回数[2]
	if($f:再セットフラグ) {
		@弾薬_Ｍ９_初期設置 Ｍ９弾薬:01 0 -200 -6250 0
	}

	// Ｍ９弾薬
	@アイテム再セットチェック $b:w12b_取得ロード回数[3]
	if($f:再セットフラグ) {
		@弾薬_Ｍ９_初期設置 Ｍ９弾薬:02 6250 5000 -7875 0
	}

	// レーション
	@アイテム再セットチェック（難易度対応） $b:w12b_取得ロード回数[4]
	if($f:再セットフラグ) {
		@レーション_初期設置 レーション:01 10375 200 -4250 0
	}

	// 止血剤
	@アイテム再セットチェック $b:w12b_取得ロード回数[6]
	if($f:再セットフラグ) {
		@止血剤_初期設置 止血剤:01 -4500 0 5500 0
	}

	if($w:ゲーム設定 < d:LEVEL_NORMAL) {
		// レーション
		@アイテム再セットチェック（難易度対応） $b:w12b_取得ロード回数[5]
		if($f:再セットフラグ) {
			@レーション_初期設置 レーション:02 -1500 0 7250 0
		}
	}
}

proc アイテム取得時番号設定 $:ボックス名 {
#if d:DEBUG_PRINT
	print '*** Item No Set ***'
#endif

	if       ($:ボックス名 == ソコム弾薬:01) {
		eval($b:w12b_取得ロード回数[0] = $w:グローバルロード回数);
	} else if($:ボックス名 == ソコム弾薬:02) {
		eval($b:w12b_取得ロード回数[1] = $w:グローバルロード回数);
	} else if($:ボックス名 == Ｍ９弾薬:01) {
		eval($b:w12b_取得ロード回数[2] = $w:グローバルロード回数);
	} else if($:ボックス名 == Ｍ９弾薬:02) {
		eval($b:w12b_取得ロード回数[3] = $w:グローバルロード回数);
	} else if($:ボックス名 == レーション:01) {
		eval($b:w12b_取得ロード回数[4] = $w:グローバルロード回数);
	} else if($:ボックス名 == レーション:02) {
		eval($b:w12b_取得ロード回数[5] = $w:グローバルロード回数);
	} else if($:ボックス名 == 止血剤:01) {
		eval($b:w12b_取得ロード回数[6] = $w:グローバルロード回数);
	}

#if d:DEBUG_PRINT
	print $:ボックス名
	print $w:グローバルロード回数
#endif
}

//-----------------------------------------------------------------------------
// 爆弾解体設定
proc 爆弾解体設定 {
#if d:DEBUG_PRINT
	print '*** Bomb Set ***'
#endif

	// 爆弾解体設定
	//   $:爆弾名 $:処理状態フラグ $:Ｘ座標 $:Ｙ座標 $:Ｚ座標 $:Ｘ回転 $:Ｙ回転 $:Ｚ回転
	@SS_爆弾解体設定_CB使用 w12b匂い爆弾 $f:w12b_爆弾処理完了 250 250 8650 0 0 0
}

proc SS_CB_爆弾解体後処理 {
#if d:DEBUG_PRINT
	print '*** SS CB Bomb Frozen ***'
#endif

	if($2 == 1) {	// 解体時
// バグ修正 2001.12.03
//		if($w:アイテム数Ｒ[d:アイテム:センサーＢ] == 1) {	// 既にセンサーＢをゲットしている
		if($b:Ｃ４爆弾処理数 == $b:Ｃ４爆弾設置数 - 1) {	// 最後の爆弾であるならば昇降機を上げる
			eval($f:w12a_Ａ脚ポンプ室爆弾解体前にセンサーＢゲット = 1)
		}
	}

	@爆弾解体後処理 $1 $2
}





//-----------------------------------------------------------------------------
// ノード端末設定
proc ノード接続時プロック {
#if d:DEBUG_PRINT
	print '*** Node Set ***'
#endif

	eval($f:ノードフラグ = $f:w12b_ノードフラグ);
}

proc ノード接続後プロック {
#if d:DEBUG_PRINT
	print '*** Node Event ***'
#endif

	eval($f:w12b_ノードフラグ = 1);
	command メニュー設定 -node_access on 
}

//-----------------------------------------------------------------------------
// 監視カメラ設定
proc 監視カメラ設定_ポンプ室 {
#if d:DEBUG_PRINT
	print '*** SV Camera Set: Pump Room ***'
#endif

	// 監視カメラ
	//   -p 設置場所  -r 支柱部方向  -d 振り幅  -c 振り中心角 初期方向  -x 縦視野角  -y 横視野角  -i 視力  -s ステータスフラグ  -exec { 破壊時実行ブロック }
	if($w:ゲーム設定 >= d:LEVEL_EASY) {		// レベルイージー以上にて出現
		if(    ($w:p_story >= d:ST:P007_01_R01Ａ脚ノード前１無線デモ１開始) \
			|| ($s:登場ポイント == w12b_リスタート１)) {

			@カメラ再セットチェック $b:w12b_破壊ロード回数[4]
			if($f:再セットフラグ) {
				eval($f:再セットフラグ = d:FALSE)
			} else {
				eval($f:再セットフラグ = d:TRUE)
			}
			chara プラントカメラ 監視カメラ:01 \
				-p -9250 2700 250 \
				-r 500 0 0 \
				-d 400 \
				-c 290 0 \
				-x 256 \
				-y 256 \
				-i 5000 \
				-s $f:再セットフラグ \
				-exec {
					eval($b:w12b_破壊ロード回数[4] = $w:グローバルロード回数);
				}
		}
	}
}

//-----------------------------------------------------------------------------
// 天井君設定
proc 天井君設定_制御室 {
#if d:DEBUG_PRINT
	print '*** Tenjou-kun Set: Control Room ***'
#endif

	//注意！！天井君の高さを変えるときは、ビハインドカメラの位置を全てチェックすること！！
	chara 天井君 天井_制御室   -m d:KMS_NAME1 -h 8000 -p 0,0,0  -l d:LT2_NAME
	chara 天井君 天井_制御室   -m d:KMS_NAME2 -h 4000 -p 0,0,0  -l d:LT2_NAME
}

//-----------------------------------------------------------------------------
// 壊れ物設定
proc 壊れ物設定_制御室 {
#if d:DEBUG_PRINT
	print '*** Koware Set: Control Room ***'
#endif


	//---------------------------------------------------------
	// 制御室モニター
	@壊れ物再セットチェック $b:w12b_破壊ロード回数[5]
	if($f:再セットフラグ) {
		eval($i:w12b_制御モニター壊れ状態 = 0)
	}
	chara プット制御室モニター 制御モニター -flag $i:w12b_制御モニター壊れ状態 -proc 制御モニター破壊時


	//---------------------------------------------------------
	// 壊れコンピュータ
	@壊れ物再セットチェック $b:w12b_破壊ロード回数[6]
	if($f:再セットフラグ) {
		eval($i:w12b_制御コンピュータ壊れ状態 = 0)
	}
	chara 壊れコンピュータW12B 制御コンピュータ -flag $i:w12b_制御コンピュータ壊れ状態 -proc 制御コンピュータ破壊時
}

proc 制御モニター破壊時 {
#if d:DEBUG_PRINT
	print '*** Control Monitor Destroyed ***'
#endif

	eval($i:w12b_制御モニター壊れ状態 = $1)
	eval($b:w12b_破壊ロード回数[5] = $w:グローバルロード回数);
}

proc 制御コンピュータ破壊時 {
#if d:DEBUG_PRINT
	print '*** Control Computer Destroyed ***'
#endif

	eval($i:w12b_制御コンピュータ壊れ状態 = $1)
	eval($b:w12b_破壊ロード回数[6] = $w:グローバルロード回数);
}

//-----------------------------------------------------------------------------
// その他オブジェクト設定
proc その他オブジェクト設定_制御室 {
#if d:DEBUG_PRINT
	print '*** Object Set: Control Room ***'
#endif

	//---------------------------------------------------------
	// 主観禁止壁
	@主観禁止壁 屋上左側へのドア壁   -8750 5000  -9125    0 d:SD_SLIDE_OUTSIDE
	@主観禁止壁 屋上右側へのドア壁    8750 5000  -9125 2048 d:SD_SLIDE_OUTSIDE
	@主観禁止壁 ＡＢ連絡橋へのドア壁 -6350    0 -10050  722 d:SD_SLIDE_OUTSIDE2
	@主観禁止壁 ＦＡ連絡橋へのドア壁  6350    0 -10050 1326 d:SD_SLIDE_OUTSIDE2

	//---------------------------------------------------------
	// ロード部モデル

	// プットオブジェ
	//   -m オブジェクト名  -r 向き  -p 場所  -s スケール  -l 光源  -f フラグ  -t ＬＯＤ閾値
	@SS_プットオブジェ  屋上ロード部左     d:KMS_NAME10
	mesg プットオブジェ 屋上ロード部左     off
	@SS_プットオブジェ  屋上ロード部右     d:KMS_NAME11
	mesg プットオブジェ 屋上ロード部右     off
	@SS_プットオブジェ  ＡＢ連絡橋ロード部 d:KMS_NAME12
	mesg プットオブジェ ＡＢ連絡橋ロード部 off
	@SS_プットオブジェ  ＦＡ連絡橋ロード部 d:KMS_NAME13
	mesg プットオブジェ ＦＡ連絡橋ロード部 off

	//---------------------------------------------------------
	// ドア風
	chara ローカル風 隙間風 \
		-n 6 \
		-d	-8750 5000 -10250 -7250 8000  -8250    0 -512 2048 \
			 7250 5000 -10250  8750 8000  -8250    0 -512 2048 \
			-6625    0 -11750 -5625 3000 -10000  722 -512 2048 \
			-5625    0 -11250 -5125 3000  -9750  722 -512 2048 \
			 5125    0 -11250  5625 3000  -9750 3374 -512 2048 \
			 5625    0 -11750  6625 3000 -10000 3374 -512 2048
	mesg ローカル風 隙間風 オフ

	//---------------------------------------------------------
	// レンズフレア

	// レンズフレア -pos 位置 -size 大きさ -alpha アルファ -g グループ番号
	//##### w12a の太陽にあわせる #####
	if($w:p_story < d:ST:P014_15_P07ピーター遭遇１５ポリゴンデモ７終了) {
		chara レンズフレア  レンズフレア \
			-pos   -19300 15000 -43500 \
			-size  1 \
			-alpha 16 \
			-g     2
	} else {
		chara レンズフレア  レンズフレア \
			-pos   16000 38000 -28000 \
			-size  1 \
			-alpha 16 \
			-g     2
	}
	if(    ($s:登場ポイント != sp_w12a_w12b0_0) \
		&& ($s:登場ポイント != sp_w12a_w12b0_1)) {
		mesg レンズフレア レンズフレア アルファ変更 0 1
	}

	//---------------------------------------------------------
	// 電灯虫

	// chara 電灯虫 -n 匹数 // ４以上は４単位で -p 位置 // プレイヤー誘導時は無視 
	//   -b フラグ // 壁との当たり見るか 1:あり, 0:なし -s バウンド１ // 最小 -l バウンド２ // 最大
	chara 電灯虫 電灯虫 \
		-n 12 \
		-p -8000,7750,-8750 \
		-b 1 \
		-s -8625,5000,-8750 \
		-l -7375,7875,-8000
	chara 電灯虫 電灯虫 \
		-n 12 \
		-p 8000,7750,-8750 \
		-b 1 \
		-s 7375,5000,-8750 \
		-l 8625,7875,-8000
	chara 電灯虫 電灯虫 \
		-n 12 \
		-p -5625,2600,-10500 \
		-b 1 \
		-s -5625,   0,-10750 \
		-l -5000,3250, -9875
	chara 電灯虫 電灯虫 \
		-n 12 \
		-p 5625,2600,-10500 \
		-b 1 \
		-s 5000,   0,-10750 \
		-l 5625,3250, -9875

	//---------------------------------------------------------
	// 張り付き壁
	@東西５０ｃｍ幅透明壁設置 上壁 -6250 5000 -7125 2000
	trap wl001 d:PLAYER \
		-mask ？ \
		-state 4 \
		-exec {
			if($3 == 入る) {
				command パッド操作 -mask d:PAD_B
				mesg 透明壁 上壁 off
			} else {
				command パッド操作 -cancel 0
				mesg 透明壁 上壁 on
			}
		}

	//---------------------------------------------------------
	// 鏡面モデル

	// chara 鏡面モデル管理 -pos 鏡面座標 -axis 反点軸 // 0:X軸反点 1:Y軸反点 2:Z軸反点
	chara 鏡面モデル管理 鏡面モデル \
		-pos  0, 0, 0 \
		-axis 1
	trap ev003 ？ -mask ？ \
		-exec {
			if($3 == 入る) {
				mesg 鏡面モデル管理 鏡面モデル add $2
			} else {
				mesg 鏡面モデル管理 鏡面モデル del $2
			}
		}

	//---------------------------------------------------------
	// ガラス弾痕
	chara ガラス弾痕 ガラス弾痕 \
		-flag   0 \
		-thick  1 \
		-size   60 \
		-number 4 \
		-point  3625,1900,-6950  3625,1000,-6275 \
		-point  3625,1900,-6225  3625,1000,-5550 \
		-point -3625,1900,-6950 -3625,1000,-6275 \
		-point -3625,1900,-6225 -3625,1000,-5550

	//---------------------------------------------------------
	// ダンボールトラップ
	chara ダンボール柄トラップ設定 ダンボール柄トラップ設定 \
		-name d:PLAYER \
		-traps d:アイテム:ダンボールＣ, cbox_area

	//---------------------------------------------------------
	// 影投影モデル

//	// 影投影モデル -m 影投影専用モデル -p 設置位置
//	chara 影投影モデル 影投影モデル西 -m d:KMS_NAME6 -p -2,2,-2
//	chara 影投影モデル 影投影モデル東 -m d:KMS_NAME7 -p -2,2,-2
//
//	// 影管理 -t 光源タイプ -l 光源距離(並行光源時のみ有効) -p 並行光源方向直接指定
//	chara 影管理 影管理 -t 0 -l 6000 -p 975,-3154,5372
//	trap dr001 ？ \
//		-mask ？ \
//		-exec {
//			if($3 == 入る) {
//				mesg 影管理 影管理 add $2 影投影モデル西
//			} else {
//				mesg 影管理 影管理 del $2
//			}
//		}
//	trap dr002 ？ \
//		-mask ？ \
//		-exec {
//			if($3 == 入る) {
//				mesg 影管理 影管理 add $2 影投影モデル東
//			} else {
//				mesg 影管理 影管理 del $2
//			}
//		}
}

proc その他オブジェクト設定_ポンプ室 {
#if d:DEBUG_PRINT
	print '*** Object Set: Pump Room ***'
#endif

	//---------------------------------------------------------
	// スポットライト投影モデル
	chara スポットライト投影モデル スポット投影モデル -m d:KMS_NAME8 -p 0,2,2

	// chara 静止スポットライト設置 -pos 設置位置 -dir $v:光源方向（自動的に正規化される） -range 有効距離 -angle 円錐角度 -color 光源色 -option オプションフラグ
	chara 静止スポットライト設置 スポット投影モデル \
		-pos   3000,2500,15425 \
		-dir   1536,0,0 \
		-range 5000 \
		-angle 25 \
		-color 100,110,123 \
		-option 0x0001
	chara 静止スポットライト設置 スポット投影モデル \
		-pos   -3000,2500,15425 \
		-dir   1536,0,0 \
		-range 5000 \
		-angle 25 \
		-color 100,110,123 \
		-option 0x0001

	//---------------------------------------------------------
	// 電灯虫

	// chara 電灯虫 -n 匹数 // ４以上は４単位で -p 位置 // プレイヤー誘導時は無視 
	//   -b フラグ // 壁との当たり見るか 1:あり, 0:なし -s バウンド１ // 最小 -l バウンド２ // 最大
	chara 電灯虫 電灯虫 \
		-n 12 \
		-p 10500,2125,1500 \
		-b 1 \
		-s 10000,   0,1500 \
		-l 11000,3000,2500
	chara 電灯虫 電灯虫 \
		-n 16 \
		-p 3500,2125,1500 \
		-b 1 \
		-s 3000,   0,1500 \
		-l 4000,3000,2500
	chara 電灯虫 電灯虫 \
		-n 16 \
		-p -3500,2125,1500 \
		-b 1 \
		-s -4000,   0,1500 \
		-l -3000,3000,2500
	chara 電灯虫 電灯虫 \
		-n 12 \
		-p -10500,2125,1500 \
		-b 1 \
		-s -11000,   0,1500 \
		-l -10000,3000,2500

	//---------------------------------------------------------
	// 水滴
	chara パイプ水滴マネージャ パイプ水滴マネージャ \
		-intv    8, 10 \
		-boundry -9000, 3500, 3000, 9000, 3502, 13000
}





//=============================================================================
// カメラ、ロード
//=============================================================================

//-----------------------------------------------------------------------------
// カメラ設定
proc カメラ設定 {
#if d:DEBUG_PRINT
	print '*** Camera Set ***'
#endif

	// カメラ
	//   -c チャンネル番号  -l カメラレベル  -p 優先度
	//
	//   シナリオカメラは最大16個までおける。
	//   チャンネル番号 ：
	//       ０：通常画面 １：小窓
	//   カメラレベル ：
	//       ０：カットインカメラ（主観より強） 強
	//       １：カットインカメラ（主観より弱） ↑
	//       ２：エリアカメラ		   ↓
	//       ３：ステージデフォルトカメラ	   弱
	//   優先度 ：
	//       エリアカメラに有効
	//       数字が小さい程優先度高
	chara カメラ ステージカメラ		-c 0 -l 3 -p  0
	chara カメラ サブカメラ１		-c 0 -l 2 -p 50
	chara カメラ サブカメラ２		-c 0 -l 2 -p 40
	chara カメラ サブカメラ３		-c 0 -l 2 -p 30
	chara カメラ モーションカメラ	-c 0 -l 2 -p 20
	chara カメラ でもデモカメラ		-c 0 -l 0 -p  0

	chara カメラ クリアリングカメラ	-c 1 -l 0 -p  0

	// カメラ設定
	//   -c カメラタイプ  -b バウンド小 バウンド大  -l リミット小 リミット大  -p カメラ位置  -t ターゲット位置  -r カメラ角度  -f カメラトラック  -a カメラ画角  -i カメラ補完方法（ＩＮ） カメラ補完方法（ＯＵＴ） 補完時間（ＩＮ） 補完時間（ＯＵＴ）  -d パッドフラグ  -z 各種フラグ  -k ＫＩＬＬ  -s ０オフ／１オン  -o ＯＮになるまでの待ち時間  -E スライドタイプ スライド待ち時間 スライド距離１ スライド距離２ スライドスピード [スライドフラグ]  -N 内部補完時間
	//
	//   -b -l は必要に応じて設定。-p -t -r はタイプに応じて使用するものが取得される。省略したオプションは、前回設定を引き継ぐ。
	//   フラグ：
	//       CAMERA_CUT_IN (カットインカメラ) CAMERA_NO_CUSHION (遊びなしカメラ) CAMERA_BOUNDCHANGE_QUICK (バウンド変更を即時に反映) CAMERA_INTERP_CAMERA (補完カメラ設定)
	//   カメラタイプ：
	//       ０：上俯瞰追従型（トラックと角度を指定） １：位置・角度固定型（ターゲット位置とカメラ位置を指定） ２：位置固定、追従型（カメラ位置を指定） ３：位置固定、Ｘ角度追従型（カメラ位置を指定） ４：ターゲット固定、プレイヤー追従カメラ（ターゲットとトラックを指定）
	//   補完方法：
	//       −１：指定なし ０：一瞬 １：補完シューン ２：補完ウニョーン ３：補完ウーニャーン ４：一定時間で
	//       補完時間は４番指定のとき有効。補完（ＩＮ）の指定は必須。２つのカメラ間の補完方法は、ＯＵＴ側カメラのＯＵＴ補完関数が指定してある場合にはその関数を使用し、指定がない場合には、ＩＮ側カメラのＩＮ補完関数を使用するようになっている。
	//   パッドフラグ：
	//       このフラグを指定しておくと、パッドの上が画面の上になるように自動調節する。
	//   スライドカメラ設定方法：
	//       スライドタイプ (０／１ − 左右タイプ／前後タイプ) スライド待ち時間 (スライドするまでの待ちフレーム数) スライド距離１・２ (左右タイプの場合 左右スライド距離。前後タイプの場合 接近距離、離れた距離) スライドスピード (そのまんま) スライドフラグ (1にしておくと、入った時スライドしていない状態から始まります。)
	//   補完カメラの設定方法：
	//       補完カメラとは？ − 設定したカメラに指定フレーム数かけて移動するカメラ。例として、オルガ戦のパンカメラ。
	//       設定方法 − -z に d:CAMERA_INTERP_CAMERA を指定。さらに -interp_time に補完フレーム数を指定。

	// デフォルトカメラ
	chara カメラ設定 ステージカメラ \
		-c 0 \
		-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
		-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
		-r 900,2048,0 \
		-f 8000 \
		-a 200 \
		-i 1 -1 0 0 \
		-s 1

	// 屋上入り口西
	trap ca001 d:PLAYER \
		-camera -mask ＊ \
		-exec {
			@CS_スムーズカメラ昇順 $6 -8000 -6500 5260 4500
			eval($i:補完ＬＹ = $i:CS_結果１)

			chara カメラ設定 サブカメラ１ \
				-c 1 \	
				-p -7348,8784,-2585 \
				-t -7350,$i:補完ＬＹ,-8452 \
				-a 225 \
				-i 0 0 0 0 \
				-s $3
		}

	// 屋上入り口東
	trap ca002 d:PLAYER \
		-camera -mask ＊ \
		-exec {
			@CS_スムーズカメラ昇順 $6 -8000 -6500 5260 4500
			eval($i:補完ＬＹ = $i:CS_結果１)

			chara カメラ設定 サブカメラ１ \
				-c 1 \	
				-p 7348,8784,-2585 \
				-t 7350,$i:補完ＬＹ,-8452 \
				-a 225 \
				-i 0 0 0 0 \
				-s $3
		}

	// 階段西
	trap ca003 d:PLAYER \
		-camera -mask ？ \
		-exec {
			if($3 == 入る) {
				if($6 < -5000) {
					eval( $w:カメラ補完方式 = 0 )
				} else {
					eval( $w:カメラ補完方式 = 3 )
				}
			}
		}
	trap ca003 d:PLAYER \
		-camera -mask ＊ \
		-exec {
			@CS_スムーズカメラ昇順 $6 -5750 -4000 3729 2074
			eval($i:補完ＬＹ = $i:CS_結果１)
			@CS_スムーズカメラ昇順 $6 -5750 -4000 230 190
			eval($w:補完画角 = $i:CS_結果１)

			chara カメラ設定 サブカメラ１ \
				-c 1 \	
				-p -8849,2074,-61 \
				-t -7446,$i:補完ＬＹ,-4686 \
				-a $w:補完画角 \
				-i $w:カメラ補完方式 -1 0 0 \
				-s $3
		}

	// 階段東
	trap ca004 d:PLAYER \
		-camera -mask ？ \
		-exec {
			if($3 == 入る) {
				if($6 < -5000) {
					eval( $w:カメラ補完方式 = 0 )
				} else {
