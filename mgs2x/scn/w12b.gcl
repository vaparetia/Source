		}

	// 制御室
	trap ca007 d:PLAYER \
		-camera -mask ＊ \
		-exec {
			@CS_スムーズカメラ昇順 $4 -2750 2750 -2781 2781
			eval($i:補完ＢＸ = $i:CS_結果１)
			@CS_スムーズカメラ昇順 $4 -2750 2750 -2781 2781
			eval($i:補完ＬＸ = $i:CS_結果１)

			@CS_スムーズカメラ昇順 $6 -8500 -2500 7359 9245
			eval($i:補完ＢＹ = $i:CS_結果１)
			@CS_スムーズカメラ昇順 $6 -8500 -2500 -453 -1072
			eval($i:補完ＢＺ = $i:CS_結果１)
			@CS_スムーズカメラ昇順 $6 -8500 -2500 1729 1737
			eval($i:補完ＬＹ = $i:CS_結果１)
			@CS_スムーズカメラ昇順 $6 -8500 -2500 -6184 -2673
			eval($i:補完ＬＺ = $i:CS_結果１)

			// 補正
			if($4 > 0) {
				@CS_スムーズカメラ昇順 $4 0 2750 0 -100
			} else {
				@CS_スムーズカメラ昇順 $4 -2750 0 100 0
			}
			eval($i:補完ＢＸ２ = $i:CS_結果１)
			@CS_スムーズカメラ昇順 $6 -8500 -2500 667 0
			eval($i:補完ＢＸ２ = (($i:CS_結果１ * $i:補完ＢＸ２) / 100))
			eval($i:補完ＢＸ = ($i:補完ＢＸ + $i:補完ＢＸ２))
			eval($i:補完ＬＸ = ($i:補完ＬＸ + $i:補完ＢＸ２))

			chara カメラ設定 サブカメラ１ \
				-c 1 \	
				-p $i:補完ＢＸ,$i:補完ＢＹ,$i:補完ＢＺ \
				-t $i:補完ＬＸ,$i:補完ＬＹ,$i:補完ＬＺ \
				-a 200 \
				-i 0 0 0 0 \
				-s $3
		}

	// ＡＢ連絡橋への扉前
	trap ca008 d:PLAYER \
		-camera -mask ？ \
		-exec {
			chara カメラ設定 サブカメラ２ \
				-c 1 \	
				-p -4426,4016,204 \
				-t -4303,633,-6489 \
				-a 200 \
				-i 3 3 0 0 \
