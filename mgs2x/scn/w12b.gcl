// [登場ポイント]
//   w12b(左)				sp_w12a_w12b0_0			w12b
//   w12b(右)				sp_w12a_w12b0_1			w12b
//   w13a					sp_w13a_w12b0_0			w12b
//   w23a					sp_w23a_w12b0_0			w12b
//   ダンボール				sp_w20a_w12b0_0			w12b
//   w12b_リスタート２		w12b_リスタート２		w12b
//   センサーＢスタート左	センサーＢスタート左	w12b
//   センサーＢスタート右	センサーＢスタート右	w12b

//=============================================================================
// define
//=============================================================================

//-----------------------------------------------------------------------------
// スイッチ

#define STAGE_PLANT 1
#define STAGE_W12B  1

#define ENE_P_GOL     1
#define ENE_HIGH_TECH 1



#define RAIDEN     1
#if d:RAIDEN
#define PLAYER     ライデン
#else
#define PLAYER     スネーク
#endif

#define ENEMY_SET      1		// 敵兵の配置
#define STAGE_END      1		// ロードプロック
#define START_CAMERA   1		// ステージ開始時のカメラ
#define CTDOWN_TIMER_P 1		// 爆弾タイマー開始用
#define BOMB_STAGE     w12b		// 爆弾解体後処理用
#define NODE           1		// ノード

#define SCREENSHOT     0		// スクリーンショット
#define KEYBOARD       0		// ＵＳＢキーボード

//-----------------------------------------------------------------------------
// マップ関係

#define HZX_NAME   w12b
#define LT2_NAME   w12b

#define KMS_NAME0  w12b0			// 制御室
#define KMS_NAME1  w12b0r0			// 制御室天井
#define KMS_NAME2  w12b0r1			// 制御室天井
#define KMS_NAME3  w12b1			// ポンプ室

//#define KMS_NAME6  w12b_k2		// 影用西階段
//#define KMS_NAME7  w12b_k1		// 影用東階段
#define KMS_NAME8  w12b1_k1			// 影用ポンプ室

#define KMS_NAME10  w12b0_12a0		// 屋上ロード部左
#define KMS_NAME11  w12b0_12a1		// 屋上ロード部右
#define KMS_NAME12  w12b0_13a		// ＡＢ連絡橋ロード部
#define KMS_NAME13  w12b0_23a		// ＦＡ連絡橋ロード部

#define DOOR_NAME1 w12b_dr00		// 屋上扉
#define DOOR_NAME2 w12b_dr01		// 連絡橋扉
#define DOOR_NAME3 dr_lv1_00		// レベル扉
#define DOOR_NAME4 w12b0_locker1_dr	// ロッカー扉
#define DOOR_NAME5 w12b0_eyes1_dr	// ロッカー扉（キョロ）





//=============================================================================
// include
//=============================================================================

#include "rai_w12b.mh"	// ステージ固有モーションリスト

#include "stdch.h"
#include "sload.h"
#include "jump.h"
#include "sound.h"
#include "enevoice.h"
#include "item_info.h"
#include "node_res.h"

#if d:KEYBOARD 
#include "usbkbd.h"
#endif

//-----------------------------------------------------------------------------
// ローカル

eval($f:クリアリングフラグ０ = 0)	// クリアリング状態

#include "stageset.h"			// ステージ設定共通ヘッダ
#include "w12b_sdemo.h"			// シナリオデモヘッダ





//=============================================================================
// メイン
//=============================================================================

chara マップ 制御室 \
	-k d:KMS_NAME0 \
	-h d:HZX_NAME, 0 \
	-l d:LT2_NAME

chara マップ ポンプ室 \
	-k d:KMS_NAME3 \
	-h d:HZX_NAME, 1 \
	-l d:LT2_NAME

chara マップ接合 Ａ脚接合 制御室 ポンプ室

command マップ設定 制御室 ポンプ室 -set {

	//----- 基本設定
	@SS_サウンド設定
	@SS_跳弾弾痕設定
	@レーダーオンオフチェック $f:w12b_ノードフラグ
	@常駐キャラ設定

	@プレイヤー設定
#if d:ENEMY_SET
	@敵兵設定
#endif
	@SS_ＢＧＭ設定
	@爆弾タイマー設置
	@プラント編全体マップ設定 d:Ａ脚マップ

	//----- オブジェクト(共通)
	@ドア設定
	@ロッカー設定
	@アイテム設定
	@爆弾解体設定
}

command マップ設定 制御室 -set {

	//----- オブジェクト(マップ別)
	@ノード端末設定 2048
	@天井君設定_制御室
	@壊れ物設定_制御室
	@その他オブジェクト設定_制御室
}

command マップ設定 ポンプ室 -set {

	//----- ビヨンド、ジャンプ
	@ジャンプ設定_ポンプ室

	//----- オブジェクト(マップ別)
	@監視カメラ設定_ポンプ室
	@その他オブジェクト設定_ポンプ室
}

command マップ設定 制御室 ポンプ室 -set {

	//----- フォグ、カメラ、ロード
	@SS_フォグ_キャラ用ライト設定
	@カメラ設定
	@ストーリー設定
	@ロード設定
}

#include "w12b_cdc.ch"			// ※※ 通信機の include は移動させないこと！！ ※※
#include "p_force_cdc.ch"

command マップ表示 -show 制御室

// レーダー当たり
command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 3
command 追加ＨＺＸグループ登録 -hzx_id 1 -add_id 3
if($w:p_story < d:ST:P007_01_R01Ａ脚ノード前１無線デモ１終了) {
	command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 4
} else {
	command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 5
}
if(    (   ($w:p_story <  d:ST:P024_01_R01爆弾解体センサーＢ入手１無線デモ１終了) \
		|| (d:ST:P031_01_P01フォーチュン戦終了１ポリゴンデモ１終了 <= $w:p_story)) \
	&& ($f:w12a_Ａ脚ポンプ室爆弾解体前にセンサーＢゲット == 0)) {
	command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 6
}

// 影投影
command	影投影ハザード -name ポンプ室 -group 7

@ステージ進入時処理





