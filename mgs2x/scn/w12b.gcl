				}
			}
		}
	trap ca004 d:PLAYER \
		-camera -mask ＊ \
		-exec {
			@CS_スムーズカメラ昇順 $6 -5750 -4000 3729 2074
			eval($i:補完ＬＹ = $i:CS_結果１)
			@CS_スムーズカメラ昇順 $6 -5750 -4000 230 190
			eval($w:補完画角 = $i:CS_結果１)

			chara カメラ設定 サブカメラ１ \
				-c 1 \	
				-p 8849,2074,-61 \
				-t 7446,$i:補完ＬＹ,-4686 \
				-a $w:補完画角 \
				-i $w:カメラ補完方式 -1 0 0 \
				-s $3
		}

	// 階段下広場左
	trap ca005 d:PLAYER \
		-camera -mask ？ \
		-exec {
			if($3 == 入る) {
				if($6 < -3000) {
					eval( $w:カメラ補完方式 = 3 )
				} else {
					eval( $w:カメラ補完方式 = 0 )
				}
			}
		}
	trap ca005 d:PLAYER \
		-camera -mask ＊ \
		-exec {
			@CS_スムーズカメラ昇順 $4 -7250 -6250 -9165 -8000
			eval($i:補完ＢＸ = $i:CS_結果１)
			@CS_スムーズカメラ昇順 $4 -7250 -6250 -9165 -8000
			eval($i:補完ＬＸ = $i:CS_結果１)

			@CS_スムーズカメラ昇順 $6 -4000 -2500 5862 6091
			eval($i:補完ＢＹ = $i:CS_結果１)
			@CS_スムーズカメラ昇順 $6 -4000 -2500 -1205 -424
			eval($i:補完ＢＺ = $i:CS_結果１)
			@CS_スムーズカメラ昇順 $6 -4000 -2500 2132 1778
			eval($i:補完ＬＹ = $i:CS_結果１)
			@CS_スムーズカメラ昇順 $6 -4000 -2500 -3616 -1504
			eval($i:補完ＬＺ = $i:CS_結果１)

			chara カメラ設定 サブカメラ１ \
				-c 1 \	
				-p $i:補完ＢＸ,$i:補完ＢＹ,$i:補完ＢＺ \
				-t $i:補完ＬＸ,$i:補完ＬＹ,$i:補完ＬＺ \
				-a 200 \
				-i $w:カメラ補完方式 -1 0 0 \
				-s $3
		}

	// 階段下広場右
	trap ca006 d:PLAYER \
		-camera -mask ？ \
		-exec {
			if($3 == 入る) {
				if($6 < -3000) {
					eval( $w:カメラ補完方式 = 3 )
				} else {
					eval( $w:カメラ補完方式 = 0 )
				}
			}
		}
	trap ca006 d:PLAYER \
		-camera -mask ＊ \
		-exec {
			@CS_スムーズカメラ昇順 $4 6250 7250 8000 9165
			eval($i:補完ＢＸ = $i:CS_結果１)
			@CS_スムーズカメラ昇順 $4 6250 7250 8000 9165
			eval($i:補完ＬＸ = $i:CS_結果１)

			@CS_スムーズカメラ昇順 $6 -4000 -2500 5862 6091
			eval($i:補完ＢＹ = $i:CS_結果１)
			@CS_スムーズカメラ昇順 $6 -4000 -2500 -1205 -424
			eval($i:補完ＢＺ = $i:CS_結果１)
			@CS_スムーズカメラ昇順 $6 -4000 -2500 2132 1778
			eval($i:補完ＬＹ = $i:CS_結果１)
			@CS_スムーズカメラ昇順 $6 -4000 -2500 -3616 -1504
