		}

	// ポンプ室
	trap ca101 d:PLAYER \
		-camera -mask ＊ \
		-exec {
			@CS_スムーズカメラ昇順 $4 -8000 8000 -7410 7410
			eval($i:補完ＢＸ = $i:CS_結果１)
			@CS_スムーズカメラ昇順 $4 -8000 8000 -7410 7410
			eval($i:補完ＬＸ = $i:CS_結果１)

			@CS_スムーズカメラ昇順 $6 4000 12500 8255 6732
			eval($i:補完ＢＹ = $i:CS_結果１)
