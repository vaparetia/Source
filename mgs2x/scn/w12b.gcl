//=============================================================================
// 基本設定
//=============================================================================

//-----------------------------------------------------------------------------
// プレイヤー設定
proc プレイヤー設定 {
#if d:DEBUG_PRINT
	print '*** Player Set ***'
#endif

	// プレイヤー設定
	//   $:強制モーションファイル $:ＬＯＤ距離
	@SS_プレイヤー設定 rai_w12b 6000
}

//-----------------------------------------------------------------------------
// 敵兵設定

// 警備兵
//   �� 5(6, 7)		屋上
//   �� 8(9, 10)	制御室
//   �� 11			ポンプ室
//   �� 12			じっと動かない敵兵(左)
//   �� 13			じっと動かない敵兵(右)(実はちょっと動く)
//
// 守備位置
//    5000 0 -1250 制御室
//   -5000 0 -1250 制御室
//    5000 0  2375 ポンプ室
//    8000 0 12000 ポンプ室
//
// 再発生位置
//   -14500    0  -7750 制御室
//    14500    0  -7750 制御室

//----- 警備兵設定
//        $:名前 $:ルート $:ノード $:ステータス $:守備Ｘ $:守備Ｙ $:守備Ｚ $:守備マップ $:ＩＤ
proc 警備兵セット１ {
#if d:DEBUG_PRINT 
	print '*** Watcher Set 1 ***'
#endif

	@SS_警備兵設定 敵兵:02 5 0 ($i:SS_敵兵ステータス) -7000 0 -1250 制御室 (d:SS_警備兵ＩＤ:Ａ脚屋上兵_ＤＥＭＯ)
	@SS_警備兵設定 敵兵:01 8 0 ($i:SS_敵兵ステータス)  7000 0 -1250 制御室 (d:SS_警備兵ＩＤ:Ａ脚制御室兵_ＤＥＭＯ)
}
proc 警備兵セット２ {
#if d:DEBUG_PRINT 
	print '*** Watcher Set 2 ***'
#endif

	@SS_警備兵設定 敵兵:01 10 0 ($i:SS_敵兵ステータス) 7000 0 -1250 制御室 (d:SS_警備兵ＩＤ:Ａ脚制御室兵)
}
proc 警備兵セット３ {
#if d:DEBUG_PRINT 
	print '*** Watcher Set 3 ***'
#endif

	@SS_警備兵設定 敵兵:01 10 0 ($i:SS_敵兵ステータス) 7000 0 -1250 制御室   (d:SS_警備兵ＩＤ:Ａ脚制御室兵)
	@SS_警備兵設定 敵兵:02 11 0 ($i:SS_敵兵ステータス) 8000 0 12000 ポンプ室 (d:SS_警備兵ＩＤ:Ａ脚ポンプ室兵)
}
proc 警備兵セット４ {
#if d:DEBUG_PRINT 
	print '*** Watcher Set 4 ***'
#endif

	@SS_警備兵設定 敵兵:01 12 0 ($i:SS_敵兵ステータス) -7000 0 -1250 制御室 (d:SS_警備兵ＩＤ:Ａ脚制御室兵)
	@SS_警備兵設定 敵兵:02 13 0 ($i:SS_敵兵ステータス)  7000 0 -1250 制御室 (d:SS_警備兵ＩＤ:Ａ脚ポンプ室兵)
}

//----- サポート兵設定
//        $:名前 $:ルート $:ステータス $:相手 $:守備Ｘ $:守備Ｙ $:守備Ｚ $:守備マップ
proc サポート兵セット１ {
#if d:DEBUG_PRINT
	print '*** Support Set 1 ***'
#endif

	if($s:登場ポイント == sp_w12a_w12b0_0) {				// 屋上左から
		@SS_サポート兵設定 敵兵:31 3 ($i:SS_敵兵ステータス) 敵兵:02

	} else if($s:登場ポイント == sp_w12a_w12b0_1) {			// 屋上右から
		@SS_サポート兵設定 敵兵:31 4 ($i:SS_敵兵ステータス) 敵兵:02

	} else if($s:登場ポイント == sp_w13a_w12b0_0) {			// ＡＢ連絡橋から
		@SS_サポート兵設定 敵兵:31 3 ($i:SS_敵兵ステータス) 敵兵:02

	} else if($s:登場ポイント == sp_w23a_w12b0_0) {			// ＦＡ連絡橋から
		@SS_サポート兵設定 敵兵:31 4 ($i:SS_敵兵ステータス) 敵兵:02

	} else {												// ダンボールで
		@SS_サポート兵設定 敵兵:31 4 ($i:SS_敵兵ステータス) 敵兵:02
	}
}

//----- アタッカー設定
//        $:名前 $:ルート $:ステータス $:装備
proc アタッカーセット１ {
#if d:DEBUG_PRINT 
	print '*** Attacker Set 1 ***'
#endif

	if($w:p_story < d:ST:P041_02_R01エイムズ死亡後２無線デモ１終了) {
		@SS_アタッカー設定 敵兵:21 1 ($i:SS_敵兵ステータス) 0
		@SS_アタッカー設定 敵兵:22 1 ($i:SS_敵兵ステータス) 0
	} else {
		@SS_アタッカー設定 敵兵:21 1 ($i:SS_敵兵ステータス) 4
		@SS_アタッカー設定 敵兵:22 1 ($i:SS_敵兵ステータス) 4
	}

	// サポート兵
	if($w:p_story >= d:ST:P041_02_R01エイムズ死亡後２無線デモ１終了) {
		@サポート兵セット１
	}
}
