	} else {
		@SS_アタッカー設定 敵兵:21 3 ($i:SS_敵兵ステータス) 4
		@SS_アタッカー設定 敵兵:22 3 ($i:SS_敵兵ステータス) 4
	}

	// サポート兵
	if($w:p_story >= d:ST:P041_02_R01エイムズ死亡後２無線デモ１終了) {
