/***************************************************************************************************/
//	define
/***************************************************************************************************/
// 各種スイッチ用定義
#define LD_FADEOUT 			1
#define STAGE_END			1


// 敵兵の設置
#define	ENEMY				0	// 敵兵設定

// エフェクト
#define FOG					1	// フォグの設定
#define	BOKASHI				1	// 遠近ぼかし設定
#define	GET_POINT			1	// スネークの座標を取得


// デバッグ関係
#define	SCREEN_SHOOT		1
#define	USB_KEY				1

// 光源
#define CHARA_AMBIENT		1	// キャラ専用の平行光源

// キャラクター関係
#define		PLAYER			スネーク

#define		東				1
#define		西				2
#define		南				3
#define		北				4

//通信機・デジカメ用ステージ宣言
// #define STAGE_W01A	1

/***************************************************************************************************/
//	Include (enumの後に設定)
/***************************************************************************************************/
#include "sna_w01a.mh"
#include "stdch.h"
#include "sload.h"
#include "item_info.h"
#include "enevoice.h"
#include "sound.h"
#include "dcam_tanker.h"

#if d:USB_KEY
	#include "usbkbd.h"
#endif

/***************************************************************************************************/
//	マップ宣言
/***************************************************************************************************/
chara マップ １Ｆ廻廊部 -k w01a 0 0 0 -k w01af 0 0 0 -h w01a,0 -l w01a

/***************************************************************************************************/
//	各マップのキャラ設定
/***************************************************************************************************/

	command マップ設定 １Ｆ廻廊部 -set{
		@常駐キャラ設定
		@居住区１Ｆカメラ設定
		@プレイヤー設定

	#if d:ENEMY
		@居住区１Ｆ敵兵設定
		//@居住区１ＦＢＧＭマネージャー設定	// コマンダーの後で呼び出す
	#endif

		@天井
		@プットオブジェセット
		@主観／ビハインド時の表示

		@ロッカー部屋左ドア
		@ロッカー部屋右ドア
		@ダミー水密ドア

		@フォグ
		@遠近ぼかしセット

	// デバッグ
		@写真撮影用スクリーンショット
		@ＵＳＢキーボードセット

		@座標取得

		@濁流設置
		@E3撮影用


	// カメラ設定
		@西端廊下クランク部左カメラ
		@東端廊下クランク部右カメラ
		@西側東西方向通路カメラ
		@西側南北方向通路カメラ
		@西側北角カメラ
		@東側東西方向通路カメラ
		@東側南北方向通路カメラ
		@東側北角カメラ
		@東西方向南端通路カメラ
		@東西方向南端通路張り付きカメラ
		@南西角カメラ
		@南東角カメラ
	}

/***************************************************************************************************/
// 無線関係のインクルード 位置変更不可
/***************************************************************************************************/
#include "w01a_cdc.ch"

/***************************************************************************************************/
//	マップ表示
/***************************************************************************************************/
command マップ表示 -show １Ｆ廻廊部


// とりあえず最後にキャラ環境光設定
@キャラ専用環境光設定


/***************************************************************************************************/
// トラップドアのproc化
/***************************************************************************************************/

	// ロッカー部屋ドアの設定
	proc ロッカー部屋左ドア {
		chara ドア ロッカー部屋の左ドア \
			-m w01alcDoorL \
			-p -4000 0 5900 \
			-d 0 0 0 \
			-slide 2000 \
			-time d:SD_OPEN_TIME \
			//-between １Ｆ廻廊部 ロッカー部屋 \
			-between １Ｆ廻廊部 １Ｆ廻廊部 \
			-exec {
				if( $:開閉フラグ == 0 ){
					//mesg マップ接合 １Ｆ廻廊部／ロッカー部屋＿左 off
				} else {
					//mesg マップ接合 １Ｆ廻廊部／ロッカー部屋＿左 on
				}
			}
	}

	proc ロッカー部屋右ドア {
		chara ドア ロッカー部屋の右ドア \
			-m w01alcDoorR -d 0 0 0 -p 4000 0 5900 -slide -2000 -time d:SD_OPEN_TIME \
			//-between １Ｆ廻廊部 ロッカー部屋 \
			-between １Ｆ廻廊部 １Ｆ廻廊部 \
			-exec {
				if( $:開閉フラグ == 0 ){
					//mesg マップ接合 １Ｆ廻廊部／ロッカー部屋＿右 off
				} else {
					//mesg マップ接合 １Ｆ廻廊部／ロッカー部屋＿右 on
				}
			}
	}

/***************************************************************************************************/
// オブジェクトのproc化
/***************************************************************************************************/
	proc 天井 {
		chara 天井君 天井 -m w01ar -h 2800 -p 0,0,0  -l w01a
	}

/***************************************************************************************************/
//	プットオブジェ
/***************************************************************************************************/
	proc プットオブジェセット {
		chara プットオブジェ 左柱 -m w01a_pillar_l -r 0 0 0 -p 0 0 0 -l w01a -s 100 100 100
		mesg プットオブジェ 左柱 off
		chara プットオブジェ 右柱 -m w01a_pillar_r -r 0 0 0 -p 0 0 0 -l w01a -s 100 100 100
		mesg プットオブジェ 右柱 off
	}

/***************************************************************************************************/
// エフェクトのproc化
/***************************************************************************************************/
	proc フォグ {
	#if d:FOG
		chara フォグ 霧	-c 4 46 30 -n 1000 -f 23000
	#endif
	}

	// キャラ用光源(マップの設置が終わってから設定することで、キャラだけに光を当てる)
	proc キャラ専用環境光設定 {
	#if d:CHARA_AMBIENT
		chara 環境光 環境光 \
			-c 43 73 53

		chara 平行光 平行光 \
			-c 47 77 97 \
			-d 512 2560 0
	#endif
	}

	proc 遠近ぼかしセット {
	#if d:BOKASHI
		chara 遠景ぼかし 遠景ぼかし１ \
			-plane 4 -near 1000 -far 5000

		chara 遠景ぼかし 遠景ぼかし２ \
			-plane 4 -near 5000 -far 10000

		chara 遠景ぼかし 遠景ぼかし３ \
			-plane 4 -near 10000 -far 15000

		chara 近景ぼかし 近景ぼかし１ \
			-plane 3 -near 0 -far 1000

		chara 近景ぼかし 近景ぼかし２ \
			-plane 3 -near 0 -far 3000

		chara 近景ぼかし 近景ぼかし３ \
			-plane 3 -near 0 -far 5000
	#endif
	}

/***************************************************************************************************/
// プレイヤーのproc化
/***************************************************************************************************/

	proc プレイヤー設定 {
		chara プレイヤー スネーク \
			-m sna_def \
			-a snake \
			//-p $i:プレイヤー初期Ｘ位置 $i:プレイヤー初期Ｙ位置 $i:プレイヤー初期Ｚ位置 \
			-p -6000 1000 0 \
			-d 0,$i:プレイヤー初期方向,0 \
			-l 2800 \
			-homing 6000 128 \
			-i 0 \
			-o sna_w01a \	// 強制モーション名
			-s 0
		chara ロープモデル３ バンダナ１ \
			-n sna_bdn1 \
			-d 1 \
			-y スネーク \
			-z 12 \
			-x 0,60,-90 \
			-m 12 \
			-p 250 \
			-k 350 \
			-o 110 \
			-f 1
		chara ロープモデル３ バンダナ２ \
			-n sna_bdn2 \
			-d 1 \
			-y スネーク \
			-z 12 \
			-x 0,50,-90 \
			-m 20 \
			-p 250 \
			-k 350 \
			-o 110 \
			-f 1

/*
		// はりつき時のみＬＯＤを使用する
		chara ＬＯＤ制御 プレイヤーＬＯＤ \
				-name d:PLAYER \
				-type 0 \
				-model sna_def_sh \
				-value d:TRP_STATE_BEHINDCAMERA_ENABLE
*/
	}


	proc 写真撮影用スクリーンショット {
	#if d:SCREEN_SHOOT
		chara スクリーンショット スクリーンショット
	#endif
	}

/***************************************************************************************************/
// 攻撃兵の設定
/***************************************************************************************************/
#if d:ENEMY

	// 回避モードでリフレッシュルームとの連絡口を警戒
	proc 攻撃兵Ａ {
		chara アタッカー 攻撃兵:02 \
			-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
			-l $w:敵標準体力 -f $w:敵標準気絶 \
			-d 6750 0 500 １Ｆ廻廊部 \	// 守備位置
			-r 1 \					// 初期ルート
			-c 8 \					// 探索ルート
			-s 0b0011 \					// ２１関節＋銃ライトＯＦＦ
			-e 0 \						// 標準装備
			-q レーション_敵兵 30
	}

	// 回避モードで左舷を警戒
	proc 攻撃兵Ｂ {
		chara アタッカー 攻撃兵:01 \
			-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
			-l $w:敵標準体力 -f $w:敵標準気絶 \
			-d -6750 0 500 １Ｆ廻廊部 \	// 守備位置
			-r 0 \					// 初期ルート
			-c 7 \					// 探索ルート
			-s 0b0011 \					// ２１関節＋銃ライトＯＦＦ
			-e 0 \						// 標準装備
			-q レーション_敵兵 30
	}

	// 回避モードで右舷を警戒
	proc 攻撃兵Ｃ {
		chara アタッカー 攻撃兵:01 \
			-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
			-l $w:敵標準体力 -f $w:敵標準気絶 \
			-d -6750 0 500 １Ｆ廻廊部 \	// 守備位置
			-r 0 \					// 初期ルート
			-c 9 \					// 探索ルート
			-s 0b0011 \					// ２１関節＋銃ライトＯＦＦ
			-e 0 \						// 標準装備
			-q レーション_敵兵 30
	}


	proc 攻撃兵セット {
		/*******************************************************************************************/
		// VERYEASY
		/*******************************************************************************************/
		if($w:ゲーム設定 <= d:LEVEL_VERYEASY) {
			if( ( $s:登場ポイント == リフレッシュルーム右舷からロード ) ) {
				@攻撃兵Ａ
				@攻撃兵Ｃ
			}else{
				@攻撃兵Ａ
				@攻撃兵Ｂ
			}
		/*******************************************************************************************/
		// EASY
		/*******************************************************************************************/
		} else if($w:ゲーム設定 <= d:LEVEL_EASY) {
			if( ( $s:登場ポイント == リフレッシュルーム右舷からロード ) ) {
				@攻撃兵Ａ
				@攻撃兵Ｃ
			}else{
				@攻撃兵Ａ
				@攻撃兵Ｂ
			}
		/*******************************************************************************************/
		// NORMAL
		/*******************************************************************************************/
		} else if($w:ゲーム設定 <= d:LEVEL_NORMAL) {
			if( ( $s:登場ポイント == リフレッシュルーム右舷からロード ) ) {
				@攻撃兵Ａ
				@攻撃兵Ｃ
			}else{
				@攻撃兵Ａ
				@攻撃兵Ｂ
			}
		/*******************************************************************************************/
		// HARD or EXTREME
		/*******************************************************************************************/
		} else {
			if( ( $s:登場ポイント == リフレッシュルーム右舷からロード ) ) {
				@攻撃兵Ａ
				@攻撃兵Ｃ
			}else{
				@攻撃兵Ａ
				@攻撃兵Ｂ
			}
		}

	}

/***************************************************************************************************/
// 警備兵の設定
/***************************************************************************************************/
	proc 警備兵セット {

		chara 警備兵 警備兵:01 \
				-i 1 1 1 \
				-l $w:敵標準体力 -f $w:敵標準気絶 -h $w:敵標準聴力 \
				-d 6000,0,-6000 １Ｆ廻廊部 \	// 守備位置
				-r 4 \						// 初期ルート
				-n 0 \							// 初期ノード
				-s 0b0011 \						// ２１関節＋銃ライトＯＦＦ
				//-e 0 \							// 標準装備
				-q 止血剤_敵兵 30 弾薬_Ｍ９_敵兵 15 \
				-a チャフ_敵兵 40 スタン_敵兵 40

	}

	proc サポート兵セット {
	}

/***************************************************************************************************/
// コマンダーの設定
/***************************************************************************************************/
	proc 警備兵コマンダー {
		chara 警備コマンダー wccomm -e { 警備兵セット サポート兵セット }
	}


	resource ghq_area_alert_voice {
	w01a:
		$t{
			t:vc04000e,	//「了解。バックアップは船橋一階左舷へ向かえ」
			t:vc04000f, //「応援部隊、左舷に向かえ。奴を逃がすな！」
			-2,
			t:vc04000c,	//「了解。船橋一階居住区に応援部隊を派遣する｡右舷を固めろ」
			t:vc04000d, //「わかった。応援部隊、右舷にむかえ！。奴を追い込むんだ！」
			-1
		}
	}

	resource ghq_caution_voice {
	w01a:
		$t{
			t:vc040037, //「了解。船橋一階左舷を増員する。警備を強化しろ」
			t:vc040038, //「船橋一階居住区を増員。左舷警戒を固めろ」
			t:vc040035, //「了解。一階居住区を増員。右舷警備を固めろ」
			t:vc040036, //「わかった。右舷に増員。警備を強化せよ！」
			-2,
			// 連絡が途絶えた時の音声
			t:vc040069, //「船橋一階居住区との連絡が途絶えた。」
			-1	// 全ての登録終了
		}
	}

	proc 居住区１Ｆ敵兵設定 {
		chara コマンダー 敵兵セット \
			-w 警備兵コマンダー \
			-m $w:スタートアラートモード \
			-r 6000,0,-13000 １Ｆ廻廊部 \
			-c 6000,0,-13000 １Ｆ廻廊部 \
			-g 0 \
			-b $w:敵標準再発生数 \ // 生き返る敵兵数
			-z $i:敵標準麻酔持続 \
			-x [ghq_area_alert_voice:w01a] \
			-y [ghq_caution_voice:w01a] \
			-v [ene_tank_voice:01]
	}

#endif


/***************************************************************************************************/
// プレイヤーの１フレーム前の座標を覚える
/***************************************************************************************************/
	proc 座標取得 {
	#if	d:GET_POINT
		trap ev000 d:PLAYER \
			-mask ＊ \
			-exec {
				eval( $i:前フレーム位置Ｘ = $i:プレイヤー位置Ｘ )
				eval( $i:前フレーム位置Ｚ = $i:プレイヤー位置Ｚ )
			}
	#endif
	}

/***************************************************************************************************/
// 主観及びビハインド時にモデルを表示する
/***************************************************************************************************/
	proc 主観／ビハインド時の表示 {
		//chara 天井君 左柱 -m w01a_pillar_l -a 5 -c 0 0 7500 -p 0,0,0 -l w01a
		//chara 天井君 右柱 -m w01a_pillar_r -a 5 -c 0 0 7500 -p 0,0,0 -l w01a
	}


/***************************************************************************************************/
// トラップカメラのproc化
/***************************************************************************************************/

	// カメラ設定とデフォルトカメラ（通常は通路カメラ１を使用）
	proc 居住区１Ｆカメラ設定 {
		chara カメラ ステージカメラ		-c 0 -l 3 -p 0
		chara カメラ ロードカメラ		-c 0 -l 2 -p 0
		chara カメラ クリアリングカメラ	-c 1 -l 2 -p 0
		chara カメラ 通路カメラ０		-c 0 -l 2 -p 1
		chara カメラ 通路カメラ１		-c 0 -l 2 -p 2
		chara カメラ モーションカメラ	-c 0 -l 2 -p 1


	// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \
			-b -32000,-32000,-32000 32000,32000,32000 \
			-l -32000,-32000,-32000 32000,32000,32000 \
			-r 640,2048,0 \
			-f 6000 \
			-a 200 \
			-i 1 -1 0 0 \
			-s 1
	}

proc 西端廊下クランク部左カメラ {
	trap ca010 d:PLAYER -mask ＊ -camera \
		-exec {
			@完全補完カメラ $6	-8500 -7000  \
								-10630 -10361 \
								2758 4968 \
								-5200 -5758 \
								-10630 -10361 \
								1470 1096 \
								-7425 -6362

			chara カメラ設定 通路カメラ１ \
				-c 1 \
				-p $i:補完ＰＸ $i:補完ＰＹ $i:補完ＰＺ \
				-t $i:補完ＴＸ $i:補完ＴＹ $i:補完ＴＺ \
				-r 342,2048,0 -f 2571 \
				-a 200 \
				-i 1 -1 0 0 \
				-s $3
		}
}

proc 東端廊下クランク部右カメラ {
	trap ca011 d:PLAYER -mask ＊ -camera \
		-exec {

			@完全補完カメラ $6	-8500 -7000  \
								10630 10361 \
								2758 4968 \
								-5200 -5758 \
								10630 10361 \
								1470 1096 \
								-7425 -6362

			chara カメラ設定 通路カメラ１ \
				-c 1 \
				-p $i:補完ＰＸ $i:補完ＰＹ $i:補完ＰＺ \
				-t $i:補完ＴＸ $i:補完ＴＹ $i:補完ＴＺ \
				-r 342,2048,0 -f 2571 \
				-a 200 \
				-i 1 -1 0 0 \
				-s $3
		}
}

proc 西側東西方向通路カメラ {
	trap ca012 d:PLAYER -mask ＊ -camera \
		-exec {
			if( $3 == 入る ){
				if( $w:１トラップ前カメラ進入方向 == d:西 ) {
					eval( $w:カメラ補完方式 = 0 )
				}else{
					eval( $w:カメラ補完方式 = 1 )
				}
			}

			chara カメラ設定 通路カメラ１ \
				-c 0 \
				-b -10361,4968,-5758  -6269,4968,-5758 \
				-l -10361,1096,-6362  -6269,1096,-6362 \
				-r 923,2048,0 -f 3919 \
