/***************************************************************************************************/
// USBキーボード
/***************************************************************************************************/
	proc ＵＳＢキーボードセット {
		chara USBキーボード実行 ＵＳＢキーボード \
				-e d:KBD_R	{ 	command メニュー設定 -menu on -gage on -radar on -subwin on	} \
				-e d:KBD_T	{	command メニュー設定 -menu off -gage off -radar off -subwin off	} \
				-e d:KBD_F9 {
					//mesg 警備兵 警備兵Ａ ルート変更 27 -5000,3000,-9000 １Fリフレッシュルーム
				} \
				-e d:KPD_PLUS		{ mesg  プットオブジェ これも天井 on } \
				-e d:KPD_MINUS		{ mesg  プットオブジェ これも天井 off } \
				-e d:KPD_ENTER		{ mesg Ｃ４ Ｃ４ bomb } \
				-e d:KBD_ESC {	mesg 臨時顔アニメキャラ アニメキャラ モーション再生 normal 30
								mesg delay カメラディレイ kill
								mesg 臨時顔アニメキャラ アニメキャラ 視線変更 -1
								mesg 遠景ぼかし 遠景ぼかし１ off
								mesg 遠景ぼかし 遠景ぼかし２ off
								mesg 遠景ぼかし 遠景ぼかし３ off
								mesg 近景ぼかし 近景ぼかし１ off
								mesg 近景ぼかし 近景ぼかし２ off
								mesg 近景ぼかし 近景ぼかし３ off
							} \
				-e d:KBD_F1	{ mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_speech_a 30 } \
				-e d:KBD_F2 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_speech_i 30 } \
				-e d:KBD_F3 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_speech_u 30 } \
				-e d:KBD_F4 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_speech_e 30 } \
				-e d:KBD_F5 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_speech_o 30 } \
				-e d:KBD_F6 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_speech_n 30 } \
				-e d:KBD_F7 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_teeth 30 } \
				-e d:KBD_F8 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_scream 0 } \
				-e d:KBD_F9 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_relax 30 } \
				-e d:KBD_F10{ mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_surprise 30 } \
				-e d:KBD_F11{ mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_sigh 30 } \
				-e d:KBD_F12{ mesg 臨時顔アニメキャラ アニメキャラ 視線変更 2 } \
				-e d:KBD_Q	{ mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_tension 30 } \
				-e d:KBD_W	{
							  chara delay カメラディレイ \
								-time 1 \
								-exec {
									mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_exciting 30
									return 60
								}
							} \
				-e d:KBD_E	{ mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_pain 30 } \
				-e d:KBD_R	{ mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_T12a1D71 30 } \
				/*
				-e d:KBD_T	{
								mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 120 -7707,-3929,-14119
								chara delay カメラディレイ \
									-time 90 \
									-exec {
										mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 60 6710,-3960,-18261
									}
							} \
				*/
				-e d:KBD_Y	{
							mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_sneeze 0
							//mesg プレイヤー d:PLAYER motion d:モーションリスト:sna_m9_behind_squat_r_sneez_e3 \
							//	 -1 -1 -1 0x00000004
							} \
				-e d:KBD_U	{ mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_teeth 30
							  chara delay カメラディレイ \
								-time 20 \
								-exec {
										mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_surprise 20
								}
							  chara delay カメラディレイ \
								-time 40 \
								-exec {
										mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_teeth 20
								}
							} \
				-e d:KBD_I	{ mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_teeth 20
							  chara delay カメラディレイ \
								-time 30 \
								-exec {
										mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_relax 20
								}
							  chara delay カメラディレイ \
								-time 60 \
								-exec {
										mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_surprise 20
								}
							  chara delay カメラディレイ \
								-time 90 \
								-exec {
										mesg 臨時顔アニメキャラ アニメキャラ モーション再生  normal 20
								}
							} \
				-e d:KBD_O	{
								mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 90 \
										($i:プレイヤー位置Ｘ-1000),($i:プレイヤー位置Ｙ-200),($i:プレイヤー位置Ｚ+3000)
								chara delay カメラディレイ \
									-time 90 \
									-exec {
										mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 90 \
										($i:プレイヤー位置Ｘ+1000),($i:プレイヤー位置Ｙ-200),($i:プレイヤー位置Ｚ+3000)
									}
								chara delay カメラディレイ \
									-time 180 \
									-exec {
										mesg 臨時顔アニメキャラ アニメキャラ 視線変更 -1
									}
							} \
				-e d:KBD_1 { mesg 遠景ぼかし 遠景ぼかし１ on } \
				-e d:KBD_2 { mesg 遠景ぼかし 遠景ぼかし２ on } \
				-e d:KBD_3 { mesg 遠景ぼかし 遠景ぼかし３ on } \
				-e d:KBD_4 { mesg 近景ぼかし 近景ぼかし１ on } \
				-e d:KBD_5 { mesg 近景ぼかし 近景ぼかし２ on } \
				-e d:KBD_6 { mesg 近景ぼかし 近景ぼかし３ on } \
				-e d:KBD_RIGHT {
							mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 90 \
									($i:プレイヤー位置Ｘ+1000),($i:プレイヤー位置Ｙ-200),($i:プレイヤー位置Ｚ+3000)
							} \
				-e d:KBD_LEFT {
								mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 90 \
										($i:プレイヤー位置Ｘ-1000),($i:プレイヤー位置Ｙ-200),($i:プレイヤー位置Ｚ+3000)
							} \
				-e d:KBD_UP {
								mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 90 \
										($i:プレイヤー位置Ｘ+3000),($i:プレイヤー位置Ｙ-200),($i:プレイヤー位置Ｚ+1000)
							} \
				-e d:KBD_DOWN {
								mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 90 \
										($i:プレイヤー位置Ｘ+3000),($i:プレイヤー位置Ｙ-200),($i:プレイヤー位置Ｚ-1000)
							} \
				-e d:KPD_MINUS {
								mesg プレイヤー スネーク position \
								2966 2000 -15180
							} \
				-e d:KPD_NUMLOCK {
						mesg プット大ガラスオブジェ でかガラス 割れる
				} \
				-e d:KBD_L {
									mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_teeth 40
									chara delay カメラディレイ \
										-time 20 \
										-exec {
												mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_tension 30
										}
				} \
				-e d:KBD_A {
					mesg プレイヤー d:PLAYER position 1000 1000 5000
					command プレイヤー無敵セット
					mesg コマンダー 敵兵セット 視界オフ
				 } \
				-e d:KBD_0	{ restart } \
				-e d:KPD_0 {
					mesg 濁流 濁流1 殺す
					mesg 濁流 濁流2 殺す
					mesg 濁流 濁流3 殺す
				} \
				-e d:KPD_ENTER {
					@濁流セット
				} \
				-e d:KPD_1 {
					//mesg 警備兵 警備兵:01 ルート変更 5 0,0,0 １Ｆ廻廊部
					mesg パッドデモ 逃げるスネーク start
				} \
				-e d:KPD_2 {
					//mesg 警備兵 警備兵:01 ルート変更 6 0,0,0 １Ｆ廻廊部

				} \
				-e d:KPD_4 {
					mesg ルートデモ人形 濁流呑まれ兵 ルート変更 9
				} \
				-e d:KPD_5 {
					mesg ルートデモ人形 濁流呑まれ兵 ルート変更 10
				} \
				-e d:KPD_6 {
					// 途中まで
					mesg ルートデモ人形 濁流呑まれ兵 ルート変更 11
				} \
				-e d:KPD_7 {
					// 途中から
					mesg ルートデモ人形 濁流呑まれ兵 ルート変更 12
				} \
				-e d:KPD_9 {

				} \
				-e d:KPD_NUMLOCK {
				} \
				-e d:KPD_SLASH {
					print '固定カメラＯＮ'
					command トラップ切り替え -trap ob000 -switch 1
					chara カメラ設定 モーションカメラ -s 1
				} \
				-e d:KPD_ASTA {
					print '固定カメラＯＦＦ'
					command トラップ切り替え -trap ob000 -switch 0
					chara カメラ設定 モーションカメラ -s 0
				} \
				-e d:KPD_MINUS {
				} \
				-e d:KPD_PLUS {
				}
		#endif
	}

/***************************************************************************************************/
// 濁流設置
/***************************************************************************************************/

	proc 濁流設置 {
		chara 水飛沫管理 NewSplushMan
		//@濁流セット
	}

	proc 濁流セット {
		chara delay delay -t 10 -e {
			chara 濁流 濁流1 \
				-n -10750 0 -12000 800 \
				   -10750 0 -6000  800 \
				   -6000  0 -6000  800 \
				   -6000  0  7000  800 \
				    6000  0  7000  800 \
				-h  1200 \
				-p  2 \
				-s  10
		}

		chara delay delay -t 10 -e {
			chara 濁流 濁流2 \
				-n -10750 0 -12000 800 \
				   -10750 0 -6000  800 \
				   -6000  0 -6000  800 \
				   -6000  0  7000  800 \
				   6000  0  7000  800 \
				-h  1000 \
				-p  1 \
				-s  200
			/*
			chara 濁流 濁流2 \
				-n -10750 0 -12000 800 \
				   -10750 0 -6000  800 \
				   -6000  0 -6000  800 \
				   -6000  0  7000  800 \
				   6000  0  7000  800 \
				-h  1000 \
				-p  1 \
				-s  200
			*/
		}

		chara delay delay -t 20 -e {
			chara 濁流 濁流3 \
				-n -10750 0 -12000 800 \
				   -10750 0 -6000  800 \
				   -6000  0 -6000  800 \
				   -6000  0  7000  800 \
				   6000  0  7000  800 \
				-h  1000 \
				-p  0 \
				-s  200
			/*
			chara 濁流 濁流3 \
				-n -10750 0 -12000 800 \
				   -10750 0 -6000  800 \
				   -6000  0 -6000  800 \
				   -6000  0  7000  800 \
				   6000  0  7000  800 \
				-h  1000 \
				-p  0 \
				-s  200
			*/
		}

	}


/***************************************************************************************************/
// E3撮影用
/***************************************************************************************************/

	proc E3撮影用 {
		//command メニュー設定 -menu off -gage off -radar off -subwin off

		#if 1
			// マルチウェイトモデルと顔表情の組み込み
			chara マルチウェイトキャラ マルチ \
				-name d:PLAYER \
				-model sna_def_mh

			chara 臨時顔アニメキャラ アニメキャラ \
				-chara	d:PLAYER
		#endif



		chara パッドデモ 逃げるスネーク \
				-file e01a_paddemo \
				-end_proc 逃げるスネークエンド
		/*
		chara パッドデモ 覗き見スネーク \
				-file e02a_paddemo \
				-end_proc 覗き見スネーク終了
		*/
		#if 1
			chara ルートデモ人形 濁流呑まれ兵 \
				-route 3 0 \
				-kms gbs_def \ /*EVMを表示する場合はダミーKMSが必要*/
				-mar gbs_e01a \
				-number 1 \
				//-number $i:移動モーション番号 \
				//-status $i:ステータス \
				//-proc $p:ポイントプロック $b:ポイント番号 ...2 \
				-item	aks 6 \
				-weapon	1
		#endif

		#if d:ENEMY
			chara プロック連続実行 濁流呑まれ兵連続プロック -time -1 -exec {
				command ゲット敵兵アクション 警備兵:01 $i:ルート番号 $i:ポイント番号 $i:アクション番号

				if( $i:ルート番号 == 5 && $i:ポイント番号 == 3 ) {
					print 'ルート番号 = 5 : ポイント番号 = 3'
					mesg 警備兵 警備兵:01 ルート変更 4 0,0,0 １Ｆ廻廊部
				}

				if( $i:ルート番号 == 6 && $i:ポイント番号 == 3 ) {
					print 'ルート番号 = 5 : ポイント番号 = 3'
					mesg 警備兵 警備兵:01 ルート変更 3 0,0,0 １Ｆ廻廊部
				}
			}
		#endif

/*
			// ルート変更のメッセージ発行
			chara プロック連続実行 濁流呑まれ兵連続プロック -time -1 -exec {
				command パッドチェック -which 0 -press
				if( $status & d:PAD_A){
					mesg ルートデモ人形 濁流呑まれ兵 ルート変更 5
				}
			}
*/
		#endif

		#if 1
			// スネーク追っかけカメラ
			trap ob000 d:PLAYER \
				-mask ＊ \
				-camera \
				-exec {
					chara カメラ設定 モーションカメラ \
						-c 0 \
						-b -5587,1228,d:CAM_MIN -5323,d:CAM_MAX,7885 \
						-l -6062,1577,d:CAM_MIN -6062,d:CAM_MAX,4731 \
						-r 4026,2198,0 -f 3259 \
						-a 200 \
						-i 1 1 0 0 \
						-z d:CAMERA_NO_CUSHION \
						-s 1


					/*
						-p -5323,1228,7885 -t -6062,1577,4731 \
						-r 4026,2198,0 -f 3259 \
						-a 200 \

						-p -5587,1228,-1162 -t -6326,1577,-4317 \
						-r 4026,2198,0 -f 3259 \
						-a 200 \
					*/
				}
		#endif

		#if 0
			chara プロック連続実行 濁流呑まれ兵連続プロック -time -1 -exec {
				command パッドチェック -which 0 -press
				if( $status & d:PAD_A){
					//mesg 警備兵 警備兵:01 ルート変更 2 6000,0,-6000 １Ｆ廻廊部 0
				}
			}
		#endif

	}



	proc ダミー水密ドア {
		chara 水密ドア管理 水密ドア管理人 -n 1 -motions sna_hatch hatch_door_sna hatch_handle_sna

		chara 水密ドア 西側水密ドア \
			-kms w01asdr_body_r w01asdr_handle \
			-position (-8175-1150) 0 -5050 \
			-type 0 \	// 左軸
			-rotate 0,0,0 \
			-hazard -9250,0,-5200 -8250,0,-5200
	}


	proc 逃げるスネークエンド {
		chara パッドデモ 逃げるスネーク \
			-file e01a_paddemo \
			-end_proc 逃げるスネークエンド
	}

	proc 覗き見スネーク終了 {
		chara パッドデモ 覗き見スネーク \
			-file e02a_paddemo \
			-end_proc 覗き見スネーク終了
	}

