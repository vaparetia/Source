				-i $w:カメラ補完方式 -1 0 0 \
				-slide 0 2 1000 1000 60 0 \
				-s $3
		}
}

proc 東側南北方向通路カメラ {
	trap ca016 d:PLAYER -mask ＊ -camera \
		-exec {
				if( $3 == 入る ){	// 南から進入時
					if( $6 > 0 ){
						eval( $w:カメラ補完方式 = 1 )
						eval( $f:カメラタイプ = 0 )
					}else{
						// 北から進入時のカメラ補完方式はca017で値が代入済み
						eval( $f:カメラタイプ = 1 )
					}
				}

				if( $f:カメラタイプ ){
					@CS_スムーズカメラ昇順 $6 -5000 5000 300 200
						eval( $w:補完画角 = $i:CS_結果１ )
					@CS_スムーズカメラ昇順 $6 -5000 5000 5414 5200
						eval( $i:補完ＰＸ = $i:CS_結果１ )
					@CS_スムーズカメラ昇順 $6 -5000 5000 2576 2700
						eval( $i:補完ＰＹ = $i:CS_結果１ )
					@CS_スムーズカメラ昇順 $6 -5000 5000 8951 9917
						eval( $i:補完ＰＺ = $i:CS_結果１ )
					@CS_スムーズカメラ昇順 $6 -5000 5000 5414 5200
						eval( $i:補完ＴＸ = $i:CS_結果１ )
					@CS_スムーズカメラ昇順 $6 -5000 5000 1939 1762
						eval( $i:補完ＴＹ = $i:CS_結果１ )
					@CS_スムーズカメラ昇順 $6 -5000 5000 6852 7950
						eval( $i:補完ＴＺ = $i:CS_結果１ )

					chara カメラ設定 通路カメラ１ \
						-c 1 \
						-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ \
						-t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ \
						-r 69,2048,0 -f 7000 \
						-a $w:補完画角 \
						-i $w:カメラ補完方式 -1 0 0 \
						-s $3
				}else{
					chara カメラ設定 通路カメラ１ \
						-c 0 \
						-b 5500,2000,-10000  5500,4000,10000 \
						-l 5500,1000,-10000  5500,1000,10000 \
						-r 80,2048,0 -f 7000 \
						-a 200 \
						-i 1 -1 0 0 \
						-s $3
				}
		}
}

// 一階東側の東西通路と南北通路を接続する角（ca017）
proc 東側北角カメラ {
	trap ca017 d:PLAYER -mask ＊ -camera \
		-exec {
			if( $3 == 入る)	{ eval( $i:進入位置Ｘ = $i:前フレーム位置Ｘ ) }

			if( $i:進入位置Ｘ > 6750 ){
			// 東から浸入
				chara カメラ設定 通路カメラ１ \
					-c 1 \
					-p 5414,2576,8951 -t 5414,1939,6852 \
					-r 192,2048,0 -f 2194 \
					-a 300 \
					-i 0 -1 0 0 \
					-s $3
				eval( $w:１トラップ前カメラ進入方向 = d:東 )
				eval( $w:カメラ補完方式 = 1 )
			}else{
			// 南から浸入
				@CS_スムーズカメラ昇順 $4 5250 6750 0 1000
						eval( $w:補完距離 = $i:CS_結果１ )

				chara カメラ設定 通路カメラ１ \
					-c 0 \
					-b 10361,4968,-5758  6269,4968,-5758 \
					-l 10361,1096,-6362  6269,1096,-6362 \
					-r 923,2048,0 -f 3919 \
					-a 200 \
					-i 0 -1 0 0 \
					-slide 0 2 1000 $w:補完距離 60 0 \
					-s $3
				eval( $w:１トラップ前カメラ進入方向 = d:南 )
				eval( $w:カメラ補完方式 = 0 )
			}
		}
}

