resource PHONE_消火 {
000: {
燃えている炎は
冷却スプレーを
噴きかければ消す
ことができる。
}
}//d

resource PHONE_フナムシ {
000: {
フナムシは冷却
スプレーを噴き
かければ追い払う
ことができる。
}
}//d


resource PHONE_地雷 {
000: {
気をつけろ！
そこにはクレイ
モア地雷がセット
されている。
}
}//d


resource PHONE_リモコン近道 {
000: {
南西の暗い小部屋
からリモコン
ミサイルを飛ばし
てみろ。
}
001: {
電源パネルを楽に
壊せるはずだ。
}
}//d




