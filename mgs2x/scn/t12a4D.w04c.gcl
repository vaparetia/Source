// ぼかしセット
// ------------------------------------
proc ぼかしセット {
	chara 遠景ぼかし far_deforcus \
		-plane	4 \
		-near	6000 \
		-far	9000 

	chara 近景ぼかし near_deforcus \
		-plane	3 \
		-near	0 \
		-far	3000 
}


//###################################################################################
//									海兵隊設定
//###################################################################################


// キャラ用ライトセット
// ------------------------------------
proc デフォルトキャラ専用ライトセット {
	command マップ設定 船倉３ -set {
		chara 環境光 アンビ \
			 -c 6 20 30

		chara 平行光 パラ \
			 -c 86 85 48 \
			 -p -1287 -3357 -5545
	}
}

#define 水面パターン１ 1

proc 水面発生{
	command マップ設定 船倉３ -set {
		print'水面発生'
		#if d:水面パターン１
			chara キラキラ水面２ 水面 \
			-tex water_sur w04c_envmap_alp_ovl \
			-pos 0,-15300,-15700 \ //デフォルト-pos 0,-15300,-18700 \
			-ctrl // これをつけると水面コントロールキャラによる水面高さの変更が可能に

			chara delay ディレイ \
				-time 1 \ 
				-exec{
					mesg キラキラ水面２ 水面 波発生源追加 ose
			}
		#else
			chara 通路用水面 キラキラ水面 \
				-tex water_sur w04c_envmap_alp_ovl \
				-scale 170 \
				-num 2,1 \
				-pos -5408,-15933,-7094 \
				-wave 15 170 6 \
				-alpha_blend \ // 強制５０％半透明描画
				-ctrl \	// これをつけると水面コントロールキャラによる水面高さの変更が可能に
				-force 10 
			chara delay ディレイ \
				-time 1 \ 
				-exec{
					mesg 通路用水面 キラキラ水面 波発生源追加 ose
			}
		#endif

	}
}
proc 水面移動{
	print'水面移動'
	#if d:水面パターン１
		mesg キラキラ水面２ 水面 表示位置移動 -9880,-15300,54300
	#else
		mesg 通路用水面 キラキラ水面 表示位置移動 -9880,-15300,54300
	#endif
}
proc 水面元の位置に移動{
	#if d:水面パターン１
		mesg キラキラ水面２ 水面 表示位置移動 0,-15300,-15700
	#else
		mesg 通路用水面 キラキラ水面 表示位置移動 0,-15300,-15700
	#endif
}

proc 水しぶき管理セット {
	chara 水飛沫管理 しぶき
}

proc デモ用薬莢用メモリ確保セット {
	chara M4弾 デモ弾グレネード
	chara M4_DEMO_GUN弾 デモ弾Ｍ４
	chara USP弾 USP薬莢 // デモ海兵が使っているM9薬莢用
}


// -------------------------------------
// ！！！重要！！！
// -------------------------------------
/* 以下のライトで、
「＊＊＊のプリシェード平環光セット」はプリシェードモデルを置く直前でセット、
 置き終わったら元のものに戻す。（プットオブジェで検索して、ちゃんと置く。
 t04a1D.w00a.gcl参照）
「＊＊＊のキャラ平環光セット」はマックスの方で、随時呼び出すために用意した
 このステージでは、マップ設定でセットしているのは ?????.lt2 である */

// w04cステージにあたる場所での平行、環境光
proc w04cのプリシェード平環光セット {
	chara 環境光 w04cプリ環境光 \
		 -c 63 35 17 
	chara 平行光 w04cプリ平行光 \
		 -c 255 119 70 \
		 -p 0 -4300 -2500
}

// w04aステージにあたる場所での平行、環境光
proc w04aのプリシェード平環光セット {
	chara 環境光 w04aプリ環境光 \
		 -c 24 91 94 
	chara 平行光 w04aプリ平行光 \
		 -c 80 35 5 \
		 -p 2200,-4300,1000
}

proc スクリーンショット使用 {
#if d:SCREEN_SHOT_DEMO
	chara スクリーンショット screenshot
#endif
}


