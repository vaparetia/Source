// ------------------------------------
#if d:MGS2_DEMO

		// t12a4D を再生するとき
		eval($s:d_num = t12a4D)

chara デモアクトデバッグ demodebug  -i t:t12a4D -d 't12a4D' -l   \
		-p	天井破壊オフ 天井破壊オン \
			天井_演説台破壊オフ 天井_演説台破壊オン \
			天井_演説台_２階渡り廊下キック破壊オフ 天井_演説台_２階渡り廊下キック破壊オン \
			天井_演説台_２階渡り廊下キック_壁切断オフ 天井_演説台_２階渡り廊下キック_壁切断オン \
			第三船倉オフ 第三船倉オン \
			第一船倉オフ 第一船倉オン \
			第三船倉上方へ移動 第三船倉元の位置へ移動 \
			壊れてゆく壁１オフ 壊れてゆく壁１オン \
			壊れてゆく壁２オフ 壊れてゆく壁２オン \
			壊れてゆく壁３オフ 壊れてゆく壁３オン \
			水面発生 水面移動 水面元の位置に移動 \
			キャットウォークオフ \
			水中泡オフ 水中泡オン


#else

if($w:t_story < d:ST_T12a4Dメタルギア強奪ポリゴンデモ後半開始){
	eval($f:global_polygon_demo = 1)
	eval($s:d_num = t12a4D)

	@デモモデル差し替え処理
	proc デモ再生_t12a4D {
		#if d:デモ前五秒間待ち
chara デモアクトデバッグ demodebug  -i t:t12a4D -d 't12a4D' -l   \
					-next t12a4D終了 \
					-p  天井破壊オフ 天井破壊オン \
						天井_演説台破壊オフ 天井_演説台破壊オン \
						天井_演説台_２階渡り廊下キック破壊オフ 天井_演説台_２階渡り廊下キック破壊オン \
						天井_演説台_２階渡り廊下キック_壁切断オフ 天井_演説台_２階渡り廊下キック_壁切断オン \
						第三船倉オフ 第三船倉オン \
						第一船倉オフ 第一船倉オン \
						第三船倉上方へ移動 第三船倉元の位置へ移動 \
						壊れてゆく壁１オフ 壊れてゆく壁１オン \
						壊れてゆく壁２オフ 壊れてゆく壁２オン \
						壊れてゆく壁３オフ 壊れてゆく壁３オン \
						水面発生 水面移動 水面元の位置に移動 \
						キャットウォークオフ \
						水中泡オフ 水中泡オン
		#else
			chara demo デモ再生 \
				-i t:t12a4D \
				-p  天井破壊オフ 天井破壊オン \
					天井_演説台破壊オフ 天井_演説台破壊オン \
					天井_演説台_２階渡り廊下キック破壊オフ 天井_演説台_２階渡り廊下キック破壊オン \
					天井_演説台_２階渡り廊下キック_壁切断オフ 天井_演説台_２階渡り廊下キック_壁切断オン \
					第三船倉オフ 第三船倉オン \
					第一船倉オフ 第一船倉オン \
					第三船倉上方へ移動 第三船倉元の位置へ移動 \
					壊れてゆく壁１オフ 壊れてゆく壁１オン \
					壊れてゆく壁２オフ 壊れてゆく壁２オン \
					壊れてゆく壁３オフ 壊れてゆく壁３オン \
					水面発生 水面移動 水面元の位置に移動 \
					キャットウォークオフ \
					水中泡オフ 水中泡オン \
				-next t12a4D終了
		#endif
	}

	#if d:デモ前五秒間待ち
		eval($w:t_story = d:ST_T12a4Dメタルギア強奪ポリゴンデモ後半開始-1)
		@global_五秒待ちセット
		if($f:global_デバッグポーズ通過){
			@デモ再生_t12a4D
		}
	#else
		@デモ再生_t12a4D
	#endif

} else {
	eval($f:global_polygon_demo = 1)
	eval($s:d_num = t12a5D)

	@デモモデル差し替え処理
	proc デモ再生_t12a5D {
		#if d:デモ前五秒間待ち
chara デモアクトデバッグ demodebug  -i t:t12a4D -d 't12a4D' -l   \
					-next t12a5D終了 \
					-p  天井破壊オフ 天井破壊オン \
						天井_演説台破壊オフ 天井_演説台破壊オン \
						天井_演説台_２階渡り廊下キック破壊オフ 天井_演説台_２階渡り廊下キック破壊オン \
