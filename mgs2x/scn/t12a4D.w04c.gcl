// 初期マップの表示
command マップ表示 	-add 船倉３

// 必ずステージのshow(add)の後にセットすること。
//@デフォルトキャラ専用ライトセット


// デモ再生関係用プロック設定
// ------------------------------------
// とりあえずダミープロック
proc null {}

proc デモキャンセル {

#if 0
	// キャンセルした場合、最後まで飛ばす。
	eval($w:t_story = d:ST_T13a1Dメタルギア逃走ポリゴンデモ終了)
#endif

	// ポーズオフ
	command メニュー設定 -p off

	// プログラムで起動しているSEがあれば、ここで切る
	command セットサウンドコード -c d:SNG_FOUTS_S
	command セットサウンドコード -c d:SE_JOUCHUU_OFF

	command StreamStopAll
}

proc デモキャンセルチェックプロック {
	chara デモキャンセルチェック デモキャンセル \
		-p デモキャンセル
}

proc t12a4D終了 {
	mesg デモキャンセルチェック デモキャンセル kill

	eval($f:global_polygon_demo = 0)

	chara delay ディレイ \
		-time 1 \ 
		-exec{
			#if d:DEMO_SKIP_ENABLE
				// タンカー編終了まで飛ぶ
				eval($w:t_story = d:ST_T13a1Dメタルギア逃走ポリゴンデモ終了)
				// タイトルもしくはプラント最初まで飛ぶ。
				load 'title'
			#else
				eval($w:t_story = d:ST_T12a4Dメタルギア強奪ポリゴンデモ後半終了)
				restart
			#endif
		}

}

proc t12a5D終了 {
	mesg デモキャンセルチェック デモキャンセル kill

	eval($f:global_polygon_demo = 0)

	chara delay ディレイ \
		-time 1 \ 
		-exec{
			#if d:DEMO_SKIP_ENABLE
				// タンカー編終了まで飛ぶ
				eval($w:t_story = d:ST_T13a1Dメタルギア逃走ポリゴンデモ終了)
				// タイトルもしくはプラント最初まで飛ぶ。
				load 'title'
			#else
				eval($w:t_story = d:ST_T12a5Dメタルギア強奪ポリゴンデモ後半２終了)
				load 'd13t'
			#endif
		}

}

proc シネマスクリーンセット  {
	chara シネマスクリーン シネマ \
		-top d:CINEMA_BELT_UPPER \
		-bottom d:CINEMA_BELT_LOWER \
		-ftime 60	//デフォルト値（ゼロは駄目）
	mesg シネマスクリーン シネマ フェードアウト 1
}


// エフェクト設定
// ------------------------------------
proc エフェクト設定 {
	chara フォグ fog \
		 -c 24 30 24 \
		 -n 2200 \
		 -f 53600
}

// 設置オブジェクト
// ------------------------------------
proc 第三船倉セット {
	// 破壊段階０
	chara プットオブジェ third_hold_0 \
		-m w04c1_brk0 \
		-r 0 0 0 \
		-p 0 0 0 \
		-l d:STAGE_LT2 \
		-s 100 100 100 
}

// 第一船倉
proc 第一船倉セット {
	@w04aのプリシェード平環光セット
	chara プットオブジェ first_hold \
		-m w04a1_brk \
		-r 0 0 0 \
		-p 0 0 (28500+28500) \
		-l d:STAGE_LT2 \
		-s 100 100 100
	mesg プットオブジェ first_hold off
	print'aheahe'
	@w04cのプリシェード平環光セット
}

proc キャットウォークセット {
	chara プットオブジェ cat_walk \
		-m w04c1_brk_cat \
		-r 0 0 0 \
		-p -10000 -9000 -11500 \
		-l d:STAGE_LT2 \
		-s 100 100 100
}

proc 第三船倉オフ {
	mesg プットオブジェ third_hold_0 off
}

proc 第三船倉オン {
	mesg プットオブジェ third_hold_0 on
}

proc 第一船倉オフ {
	mesg プットオブジェ first_hold off
}
proc 第一船倉オン {
	mesg プットオブジェ first_hold on
}

proc 第三船倉上方へ移動 {
	mesg プットオブジェ third_hold_0 move 0 17000 (-11250-3000+25800)
}

proc 第三船倉元の位置へ移動 {
	mesg プットオブジェ third_hold_0 move 0 0 0
}

proc キャットウォークオフ {
	mesg プットオブジェ cat_walk off
}


// 壊れる船倉
// ------------------------------------
proc 第三船倉壊れてゆく壁セット {
	// 破壊段階１
	chara プットオブジェ crash_wall_1 \
		-m w04c1_wall_brk1 \
		-r 0 3072 0 \
		-p 13000 -6500 -9000 \
		-l d:STAGE_LT2 \
		-s 100 100 100 

	// 破壊段階２
	chara プットオブジェ crash_wall_2 \
		-m w04c1_wall_brk2 \
		-r 0 3072 0 \
		-p 13000 -6500 -9000 \
		-l d:STAGE_LT2 \
		-s 100 100 100 

	// 破壊段階３
	chara プットオブジェ crash_wall_3 \
		-m w04c1_wall_brk3 \
		-r 0 3072 0 \
		-p 13000 -6500 -9000 \
		-l d:STAGE_LT2 \
		-s 100 100 100 

	mesg プットオブジェ crash_wall_1 off
	mesg プットオブジェ crash_wall_2 off
	mesg プットオブジェ crash_wall_3 off
}

proc 壊れてゆく壁１オフ {
	mesg プットオブジェ crash_wall_1 off
}
proc 壊れてゆく壁１オン {
	mesg プットオブジェ crash_wall_1 on
}

proc 壊れてゆく壁２オフ {
	mesg プットオブジェ crash_wall_2 off
}
proc 壊れてゆく壁２オン {
	mesg プットオブジェ crash_wall_2 on
}

proc 壊れてゆく壁３オン {
	mesg プットオブジェ crash_wall_3 on
}
proc 壊れてゆく壁３オフ {
	mesg プットオブジェ crash_wall_3 off
}


proc 天井破壊セット {
	chara プットオブジェ brk_hold_1 \
		-m w04c1_brk1 \
		-r 0 0 0 \
		-p 0 0 0 \
		-l d:STAGE_LT2 \
		-s 100 100 100 
	mesg プットオブジェ brk_hold_1 off
}
