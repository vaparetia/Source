	#if d:デモ前五秒間待ち
		eval($w:t_story = d:ST_T12a4Dメタルギア強奪ポリゴンデモ後半２開始-1)
		@global_五秒待ちセット
		if($f:global_デバッグポーズ通過){
			@デモ再生_t12a5D
