// ドアオブジェクト
// ------------------------------------
proc ドア設置／通路２−船倉３ {
	chara プットオブジェ 右舷ドア２３ \
		-m w04_dr \
		-r 0,2048,0 \
		-p 8750,-17000,50 \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0010

	chara プットオブジェ 右舷ドア２３奥 \
		-m w04_dr \
		-r 0,0,0 \
		-p 7250,-17000,4450 \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0010

	chara プットオブジェ 左舷ドア２３ \
		-m w04_dr \
		-r 0,2048,0 \
		-p -7250,-17000,50 \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0010

