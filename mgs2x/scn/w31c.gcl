enum お座りエマモーションリスト {
	sitemma_stop= 0,
	non_idle
}

// アイテム番号（アイテムが多いのでenumで）
enum I_NO {
	M9_R01 = 0,
	RGB6_R01,
	SOCOM_R01,
	M4_R01,
	M4_R02,
	AKS_R01,
	PSG1T_R01,
	RATION_01,
	RATION_02,
	RATION_03,
	C4_01,
	C4_02,
	MAG_01,
	DIAZE_01
}



