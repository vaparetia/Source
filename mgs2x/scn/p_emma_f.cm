Donc tu &'ecoutais.
}
//	<<<ENGLISH>>>
//	So you WERE eavesdropping.

/*盗み聞きしてたのね。*/
ライデン_006: {
Bon... Si tu veux.
}
//	<<<ENGLISH>>>
//	Fine... Put it that
//	way if you like.

/*あぁ……まあ……そうとも言えるかな。*/
エマ_007: {
Tu es nul.
}
//	<<<ENGLISH>>>
//	You suck.

/*サイテー。*/
ライデン_008: {
Oui, oui. Vas-tu me dire ce
qui s'est pass&'e ?
}
//	<<<ENGLISH>>>
//	Yeah, yeah. Are you going
//	to tell me what happened?

/*聞きなれたよ、それ。
で、何があったんだ？
*/
エマ_009: {
Non, je ne crois pas !
}
//	<<<ENGLISH>>>
//	Ha! No -- I don't think so!

/*うふふ。……内緒！*/
//dv}//v
}//d


