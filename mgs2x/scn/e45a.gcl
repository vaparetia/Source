	proc 亀甲床設定 {
# if 0
		chara 亀甲床 亀甲床ちゃん \
				-size $i:外接円半径  \		//	200	大きくしたいときは多くする
				-prims $i:プリミティブ数 \	//	128	はでにしたいときは多くする
				-vertex $i:最大頂点数 \		//	10	広くしたいときは多くする
				-time $i:消去までの時間 \	//	150/300	0.5秒
				-alpha $i:最大アルファ値 \	//	32	
				-color $i:R $i:G $i:B \		//	
				-maxpoint $i:最大発生点数	//	はでに線をのばしたいときは多くする

			//	原点		0,0,-149250
			//	半径		7000
# endif
		chara 亀甲床 亀甲床ちゃん \
				-prims 128 \
				-alpha 10 \
				-vertex 10 \
				-user 32 \
				-region 0 -149250 7000
	}

//###################################################################################
//									カメラ
//###################################################################################

	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0 
		chara カメラ 小部屋カメラ		-c 0 -l 2 -p 40
		chara カメラ 通路カメラ		-c 0 -l 2 -p 30
		chara カメラ ロードカメラ		-c 0 -l 2 -p 20
		chara カメラ モーションカメラ		-c 0 -l 2 -p 10

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \	
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 425,2048,0 \
			-f 7500 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}
	proc アーセナルギア小部屋Ｂカメラ設定 {
		#if d:DEBUG_PRINT
			print 'w45a_camera_set'
		#endif

		// 南側通路
		trap ca001 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ降順 $6 -134750 -139750 900 100
				eval( $i:補完ＲＸ = $i:CS_結果１ );

				chara カメラ設定 通路カメラ \
					-c 0 \	
					-b  250,2000,d:CAM_MIN 1750,d:CAM_MAX,-134000 \
					-l  250,d:CAM_MIN,d:CAM_MIN 1750,d:CAM_MAX,-134250 \
					-r $i:補完ＲＸ,2048,0 \
					-f 4500 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3
			}

		// 大部屋
		trap ca002 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ降順 $6 -140750 -150750 900 450
				eval( $i:補完ＲＸ = $i:CS_結果１ );

				chara カメラ設定 小部屋カメラ \
					-c 0 \	
					-b -4000,d:CAM_MIN,d:CAM_MIN 4000,10000,-140750 \
					-l -4000,d:CAM_MIN,d:CAM_MIN 4000,10000,-141000 \
					-r $i:補完ＲＸ,2048,0 \
					-f 9000 \
					-a 200 \
					-i 2 -1 0 0 \
					-s $3
			}
	}



//###################################################################################
//									デモ
//###################################################################################

proc 天狗兵降下デモ {
	chara シナリオトラップ	E3_001 \
					-b -7000,0,-148250 \
						7000,2000,-142250 \
					-map アーセナルギア小部屋Ｂ

	
# if 1
	trap de001 d:PLAYER \
		-mask 入る \
		-e {
/*
			if ($f:w45a_天狗兵降下デモフラグ == d:FALSE) {
				eval ($f:w45a_天狗兵降下デモフラグ = d:TRUE)
				//	強制姿勢制御
				mesg プレイヤー d:PLAYER stance 0  -1  2048 0

				//	本来はポリデモ
				chara デバッグポーズ 天狗兵降下 'tengu_soldier_demo' -p 天狗兵降下デモ終了
			}
*/
				mesg 天狗兵コマンダー tng_com 危険開始
		}
# else
	trap E3_001 d:PLAYER \
		-mask 入る \
		-e {
				mesg 天狗兵コマンダー tng_com 危険開始
		}


# endif

}

proc 天狗兵降下デモ終了 {
	//	登場ポイントを変更
	eval($s:登場ポイント = 天狗兵降下デモ終了後)

	//	登場位置を再代入

	eval( $i:プレイヤー初期Ｘ位置 = 0 ) ;
	eval( $i:プレイヤー初期Ｙ位置 = 0 ) ;
	eval( $i:プレイヤー初期Ｚ位置 = -149250 ) ;
	eval( $i:プレイヤー初期方向 = 2048 ) ;

	restart -s
}
proc フォーチュン登場デモ {
/*
			if ($f:w45a_フォーチュン登場デモフラグ == d:FALSE) {
				eval ($f:w45a_フォーチュン登場デモフラグ = d:TRUE)

				//	本来はポリデモ
				chara デバッグポーズ フォーチュン登場 'FORTUNE_APPEAR_DEMO' -p フォーチュン登場デモ終了
			}
*/
}

proc フォーチュン登場デモ終了 {
# if 0	
	//	ロード

# else

	//	登場ポイントを変更
	eval($s:登場ポイント = フォーチュン登場デモ終了後)

	//	登場位置を再代入

	eval( $i:プレイヤー初期Ｘ位置 = 0 ) ;
	eval( $i:プレイヤー初期Ｙ位置 = 0 ) ;
	eval( $i:プレイヤー初期Ｚ位置 = -149250 ) ;
	eval( $i:プレイヤー初期方向 = 2048 ) ;

	restart -s

# endif

}




