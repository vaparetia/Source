proc コマンダー設定 {
#if d:DEBUG_PRINT
	print '*** Enemy Set'
#endif

//	if ( ($f:w45a_天狗兵降下デモフラグ == d:TRUE) && ($f:w45a_フォーチュン登場デモフラグ == d:FALSE) ) {
		// コマンダー
		chara コマンダー 敵兵セット \
			-a 天狗兵コマンダー \
			-r 34250,0,-95000 アーセナルギア小部屋Ｂ 34250,0,-140000 アーセナルギア小部屋Ｂ \
			-c 34250,0,-95000 アーセナルギア小部屋Ｂ 34250,0,-140000 アーセナルギア小部屋Ｂ \
			-v [ene_tank_voice:01] \
			-m $w:スタートアラートモード \
			-b 40	// $i:危険モードでの復活人数
//	}
}



//###################################################################################
//								ＢＧＭ設定
//###################################################################################

	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT 
			print 'bgm_set'
		#endif

		chara ＢＧＭマネージャー ＢＧＭマネ
	}

//###################################################################################
//									 ドア＆マップ切り替え
//###################################################################################

	proc ドア設置 {
		#if d:DEBUG_PRINT
			print 'slide_door_set'
		#endif

		chara ドア 南側ドア \
			-m d:DOOR_NAME_LOAD \
			-d 0,0,0 \
			-p 1250,0, -133125 \
			-slide -1500 \
			-time d:SD_OPEN_TIME \
			-between アーセナルギア小部屋Ｂ アーセナルギア小部屋Ｂ \
			-exec {
			}
		trap dr001 ？ \
			-mask ？ \	
			-exec {
					if($3==入る){
						mesg ドア 南側ドア open
					}else{
						mesg ドア 南側ドア close
					}
/*
				// 主観時の左右覗き込み操作禁止
				if( `command PlayerStatus -f 3 ` ){
					command パッド操作 -which 0 -mask ( d:PAD_L2 | d:PAD_R2 )
				}else{
					command パッド操作 -which 0 -cancel 2
				}
*/
			}
	}



//###################################################################################
//									開始時処理
//###################################################################################

	proc アーセナルギア小部屋Ｂ開始時処理 {

		// 通路Ｂから
		if ( $s:登場ポイント == sp_w44a_w45a_0 ) {
			@ステージ開始時処理 d:LOAD_TYPE:SL_DOOR_TYPE 南側ドア 2000 d:DEFAULT_M_TYPE

		//	天狗兵降下デモ終了後
		} else if ($s:登場ポイント == 天狗兵降下デモ終了後) {
			@ステージ開始時処理 d:LOAD_TYPE:NO_MOVE_TYPE 0 0 0

		//	フォーチュン登場デモ終了後		本来はその後ロードするので要らない
		} else if ($s:登場ポイント == フォーチュン登場デモ終了後) {
			@ステージ開始時処理 d:LOAD_TYPE:NO_MOVE_TYPE 0 0 0
		}
	}



//###################################################################################
//									ロード設定
//###################################################################################

	proc ロードプロック {
		#if d:DEBUG_PRINT 
			print 'load_proc'
		#endif

		if ($s:呼び出しプロック == mv_w45a_w44a_0) {
			// 通路Ｂへ
			@mv_w45a_w44a_0
		}
	}
	
	proc アーセナルギア小部屋Ｂロード設定 {
		trap ld001 d:PLAYER \
			-mask 入る \
			-exec {
				if($f:ロードチェックＯＮフラグ == 1) {
					@ステージ終了時処理 0 0 -133000 0 mv_w45a_w44a_0 d:DEFAULT_M_TYPE
				}
			}
	}



