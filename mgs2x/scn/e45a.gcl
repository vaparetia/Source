	proc スネーク設定 {
		if($f:w45a_天狗兵降下デモフラグ == d:TRUE ) {

			chara ＮＰＣスネーク ＮＰＣスネちゃま \
				-m sna_def \
				-a npc_snake \
				-c npc_snake_cap \
				-d npc_snake_drag \
				-x 875,0,-148750 \
				-r 0, 2048, 0 \
				-l 3 \
				-t 1 \
				-s 10 \
				   -125,0,-152625 0x00000000 \
				  -2000,0,-152125 0x00000000 \
				  -3500,0,-150375 0x00000000 \
				  -3375,0,-148375 0x00000000 \
				  -2125,0,-146625 0x00000000 \
				   -125,0,-146000 0x00000000 \
				   2000,0,-146750 0x00000000 \
				   3125,0,-148375 0x00000000 \
				   3125,0,-150375 0x00000000 \
				   1875,0,-151875 0x00000000
		} else {
			chara ＮＰＣスネーク ＮＰＣスネちゃま \
				-m sna_def \
				-a npc_snake \
				-c npc_snake_cap \
				-d npc_snake_drag \
				-x $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,$i:プレイヤー初期Ｚ位置 \
				-r 0,$i:プレイヤー初期方向,0 \
				-t 2
		}
	}

	proc フォーチュン設定 {
		#if d:DEBUG_PRINT 
			print 'fortune_set'
		#endif

		chara ルートデモ人形 デモフォーチュン \
			-route 3 0 \ 
			-kms for_def_sh_mt \
			-mar sna_w45a \
			-number d:スネークモーションリスト:sna_run
	}



