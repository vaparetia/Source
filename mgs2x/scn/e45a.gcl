// 各種スイッチ用define
// ------------------------------------
// サウンド
#define		SOUND			1		// サウンドデータは最初に呼ぶ
#define		BGM				1		// BGMは敵兵コマンダーの後に呼ぶ
// キャラクター関係
#define		RAIDEN			0		// SNAKEとは排他
#define		SNAKE			1
#define		ENEMY			1		// コマンダーと警備兵(敵を出すときは必須)
#define		SUPPORT			0		// サポート兵
#define		ATTACKER		0		// 攻撃兵
#define		SHIELD			0		// 盾兵(1) or 通常攻撃兵(0)
#define		DOLL			1
// 監視カメラ関係
#define		CYPHER			0		// サイファー
// ドア
#define		SLIDE_DOOR		1		// スライドドア
// 入出トラップ
#define		LOAD_TRAP		1
#define		STAGE_END		1		// ステージ終了時処理を使用可にする
// フォグ
#define		FOG				1
// エフェクト関係
#define		EFFECT			0		// エフェクト全般
#define		BLUR			0		// ブラー
#define		Z_MANAGER		0		// Ｚフォーカス管理(敵のライト等で仕様)
#define		BODY_SHADOW		0		// 敵のライトによって出る影
#define		BOKASHI			1		// ぼかし系

#define		BREATH			1		// 白い息
// 子画面
#define		SUB_CAMERA		0
// カメラ関係
#define		CLEAR_CAMERA	0		// クリアリング専用カメラ(要子画面)

// 天井
#define		CHARA_CEIL		0		// 天井君
// 透明壁
#define		TR_WALL			0		// シナリオ置きの透明壁
// ライト関係
#define		SPOT_LIGHT		0		// スポットライト
#define		CHARA_LIGHT		1		// キャラ専用ライト

// オブジェ関係
// アイテム
#define		ITEM			0
// 強制モーション
#define		BY_MOTION		0		// ビヨンドモーション

//	デモ
#define		POLY_DEMO		1		//	ポリデモ

// デバッグ関係
#ifdef	d:FIX_MODE
	#define		DEBUG_CHARA		0		// デバッグキャラ全体(FIX時は0)
#else
	#define		DEBUG_CHARA		0		// デバッグキャラ全体
#endif
#define		CHARA_CAMERA	0		// キャラ追従カメラ
#define		TARGET_CHARA	敵兵:01	// キャラ追従カメラのターゲット
#define		SCREENSHOT		1		// スクリーンショット
#define		USB_KEY			1		// USBキーボード


// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME			w45a
#define		KMS_NAME0			w45a
#define		KMS_NAME1			v45a_deco
#define		LT2_NAME			w45a
#define		DOOR_NAME_LOAD		w01f_dr

// キャラクター関係
#if d:RAIDEN
	#define		PLAYER		ライデン	// モーションができるまで名前はスネーク
#else
	#define		PLAYER		スネーク
#endif

// ローカル変数
//	$f:w45a_天狗兵降下デモフラグ	天狗兵降下デモを見たかどうか
//	$f:w45a_フォーチュン登場デモフラグ	フォーチュン登場デモを見たかどうか

// モーション関係
// ------------------------------------
enum スネークモーションリスト {
	sna_idle = 0,
	sna_run,
	sna_fire
}



// include
// ------------------------------------
#include "rai_w45a.mh"		// 強制モーションリスト
#include "stdch.h"
#include "sload.h"
#include "sound.h"
#include "enevoice.h"
#include "item_info.h"

#if d:USB_KEY
	#include "usbkbd.h"
#endif



// マップ設定
// ------------------------------------
chara マップ アーセナルギア小部屋Ｂ \
						-k d:KMS_NAME0 \
//						-k d:KMS_NAME1\
						-h d:HZX_NAME,0 -l d:LT2_NAME

command マップ設定 アーセナルギア小部屋Ｂ -set {
#if d:SOUND	
	@サウンド設定	// データは最初に呼ぶ
#endif
	@常駐キャラ設定
	@ローカル変数初期化
	@設定値変更
	@プラグイン設定
	@プレイヤー設定

	@亀甲床設定
#if d:ENEMY
	@コマンダー設定
#endif
#if d:DOLL
//	@フォーチュン設定
#endif
//	@スネーク設定
#if d:BGM	
	@ＢＧＭ設定	// プレイヤー→敵兵→BGMの順で呼ぶ
#endif
#if d:SLIDE_DOOR
	@ドア設置
#endif
	@オブジェクト設定
#if d:LOAD_TRAP
	@アーセナルギア小部屋Ｂロード設定
#endif
#if d:ITEM
	@アイテム設置
#endif
#if d:FOG
	@フォグ設定
#endif
#if d:EFFECT
	@エフェクト設定
#endif
	@レンズフレア設定

#if d:BREATH
	@息設定
#endif

	@カメラセット
	@アーセナルギア小部屋Ｂカメラ設定
#if d:CHARA_LIGHT
	@キャラ用ライト設定		// マップ設定の最後に呼ぶ
#endif

	@危険スタート
	@刀設定
# if d:POLY_DEMO
	@天狗兵降下デモ
# endif
#if d:DEBUG_CHARA
//	@デバッグキャラセット
#endif


	//	Ｅ３撮影用
		@写真撮影用スクリーンショット
		@ＵＳＢキーボードセット
		@E3撮影用
		@遠近ぼかしセット
	
}

// 無線用include ※位置は動かさないこと
#include "cdc_common.h"


//初期マップの表示
command マップ表示 -show アーセナルギア小部屋Ｂ


// 全てのセットが終わったところでフェードイン
@アーセナルギア小部屋Ｂ開始時処理



//###################################################################################
//									各proc設定
//###################################################################################


//###################################################################################
//									全マップ共通
//###################################################################################

	proc サウンド設定 {
		#if d:DEBUG_PRINT 
			print 'sound_set'
		#endif

		chara サウンドマネージャー ＳＤマネ -pak 0
	}

	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT 
			print 'localvar_init'
		#endif
	}

	proc 設定値変更 {
		#if d:DEBUG_PRINT 
			print 'status_set'
		#endif

	}

	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif

		command プラグインはしご
		command プラグインブレード -m rai_blade
	}


//###################################################################################
//									 プレイヤー
//###################################################################################

	proc プレイヤー設定 {
		#if d:DEBUG_PRINT
			print 'player_set'
		#endif
//		-res	(-11500) (9000) (-152000) \
//			 	(11600) (9000) (-146500) 
/*
eval( $i:プレイヤー初期Ｘ位置 = 11600 );
eval( $i:プレイヤー初期Ｙ位置 = 9000 );
eval( $i:プレイヤー初期Ｚ位置 = -146500 );
eval( $i:プレイヤー初期Ｘ位置 = -11500 );
eval( $i:プレイヤー初期Ｙ位置 = 9000 );
eval( $i:プレイヤー初期Ｚ位置 = -152000 );
*/

		#if d:RAIDEN
			chara プレイヤー d:PLAYER \
				-p $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,$i:プレイヤー初期Ｚ位置 \
				-d 0,$i:プレイヤー初期方向,0 \
				-s 0 \
				-m rai_def -a raiden -o rai_w45a \
				-f d:PLY_NO_FOOT_SHADOW

				//髪の毛
				@ライデン髪の毛設定 d:NORMAL_HAIR

		#else if d:SNAKE
			chara プレイヤー d:PLAYER \
				-p $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,$i:プレイヤー初期Ｚ位置 \
				-d 0,$i:プレイヤー初期方向,0 \
				-s 0 \
				-m sna_def -a snake -o sna_w02a

				//バンダナ
				chara ロープモデル３ バンダナ１ \
					-n sna_bdn1 \
					-d 1 \
					-y スネーク \
					-z 12 \
					-x 0,60,-90 \
					-m 12 \
					-p 250 \
					-k 350 \
					-o 110 \
					-f 1

				chara ロープモデル３ バンダナ２ \
					-n sna_bdn2 \
					-d 1 \
					-y スネーク \
					-z 12 \
					-x 0,50,-90 \
					-m 22 \
					-p 250 \
					-k 350 \
					-o 110 \
					-f 1
		#endif
	}

//###################################################################################
//								敵兵
//###################################################################################

proc 危険スタート{
	# if 0
		chara delay test -time 20 \
			-exec { 
				mesg 天狗兵コマンダー tng_com 危険開始
			}
	# else
		if($f:w45a_天狗兵降下デモフラグ == d:TRUE ) {
				mesg 天狗兵コマンダー tng_com 危険開始
		}
	# endif
}
