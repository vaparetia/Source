//###################################################################################
//									エフェクト
//###################################################################################

proc デモ空設定 {
	chara 新空 cloud \
		-m w00_sky \
		-g 1 // $i:設定するとデモ中でもゲーム環境と同じにする
}



//###################################################################################
//									その他
//###################################################################################

proc スティンガー性能設定 {
	command スティンガー性能 \
		-t 64 \		//$i:回転スピード
		-m 400 \	//$i:最大スピード
		-s  0 , -250 , 0
}


proc デモ再生_P080_01_p01 {
	chara demo デモ再生 \
		-i t:p080_01_p01 \
		-p null \
		-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
		-next P080_01_p01終了
}

proc デモ再生_P080_03_p02 {
	chara demo デモ再生 \
		-i t:p080_03_p02 \
		-p null \
		-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
		-next P080_03_p02終了
}
