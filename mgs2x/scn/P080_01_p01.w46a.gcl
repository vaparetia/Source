// 各gclで必要なdefine
// ------------------------------------
// モード
#define		STAGE_PLANT		1		// 共通プロック切り分け用
#define		DEMO_STAGE		1		// デモステージかどうかで起動するキャラを切り分ける


// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME			w46a
#define		KMS_NAME0			w46a
#define		LT2_NAME			w46a

// include
// ------------------------------------
#include "5sec_bfr_demo.h"
#include "demo_vardef.h"
#include "demo_stdch.h"
#include "demo_stdch2.h"
#include "story.h"
#include "sload.h"
#include "ending.rsc"

#include "p_force_cdc.ch"

#if d:PLANT_DEMO_ALL_SKIP
	#define		DEMO_SKIP_ENABLE 1
#else
	#define		DEMO_SKIP_ENABLE 0
#endif

#include "w46a_d_common.h"

#include "lowpoly.h"
@ローポリ設定

/***************************************************************************************************/
// マップ起動
/***************************************************************************************************/
chara マップ メタル戦ステージ	-k	d:KMS_NAME0 \
								-h 	d:HZX_NAME,0 -l d:LT2_NAME



// マップ設定
// ------------------------------------
command マップ設定 メタル戦ステージ -set {
	// デモ環境かどうか。
	#if d:MGS2_DEMO
		// 不要プログラムの起動阻害
		eval($s:d_num = P036_04_p03)
		chara デモアクトデバッグ demodebug  -i t:p080_01_p01 -d 'p080_01_p01' -l   \
			-p  null
	#else
		if( $f:P080セーブシーケンス == 1 ) {
			print 'SAVE sequense ------------- '
			eval( $f:P080セーブシーケンス = 0 ) ;
			eval( $w:p_story = d:ST:P080_04_I01ＡＧ浮上４インタラクティブ主観デモ１開始 );
			eval($s:d_num = SAVE_SEQUENSE)
			command メニュー設定 -radio off ;
			command varsave ;
			@セーブ確認ダイアログ表示
		} else {
			if($w:p_story == d:ST:P080_01_P01ＡＧ浮上１ポリゴンデモ１開始) {
				#if d:DEBUG_PRINT
					print'd:ST:P080_01_P01ＡＧ浮上１ポリゴンデモ１開始'
				#endif
				/* オルガ死亡 */
				// デモ特有の変数代入
				eval($s:d_num = P080_01_p01)
				// polydemo_**.h の最初のデモの時には必ず呼ぶこと。レーダー明示的にオフさせる。
				@デモではレーダー不要
				//	かつら等対応
				@デモモデル差し替え処理
				@デモ再生_P080_01_p01
			} else if( d:ST:P080_01_P01ＡＧ浮上１ポリゴンデモ１終了 <= $w:p_story && \
						$w:p_story < d:ST:P080_02_M01ＡＧ浮上２ムービーデモ１開始) {
				#if d:DEBUG_PRINT
					print'd:ST:P080_02_M01ＡＧ浮上２ムービーデモ１開始'
				#endif
				eval($w:p_story = d:ST:P080_02_M01ＡＧ浮上２ムービーデモ１開始)
				/* アーセナルに異常発生 */
				// デモ特有の変数代入
				eval($s:d_num = P080_02_m01)
				#if 1
					chara デバッグポーズ pause 'MOVIE_P080_02_m01' -p P080_02_m01終了
				#else
				/* 無線 */
				/* P080_02_m01終了 */
				#endif
			} else if( d:ST:P080_02_M01ＡＧ浮上２ムービーデモ１終了 <= $w:p_story && \
				$w:p_story < d:ST:P080_03_P02ＡＧ浮上３ポリゴンデモ２開始) {
				#if d:DEBUG_PRINT
					print'd:ST:P080_03_P02ＡＧ浮上３ポリゴンデモ２開始'
				#endif
				eval($w:p_story = d:ST:P080_03_P02ＡＧ浮上３ポリゴンデモ２開始)
				/* スネークとライデン捕らえられる */
				// デモ特有の変数代入
				eval($s:d_num = P080_03_p02)
				//	かつら等対応
				@デモモデル差し替え処理
				@デモ再生_P080_03_p02
			} else if( $w:p_story == d:ST:P080_04_I01ＡＧ浮上４インタラクティブ主観デモ１開始 ) {
				@セーブシーケンス終了 1
			} else {
				// デモの時以外は、以下を通過する。
				// このフラグが立っていると、親（ゲームの）GCLの方で必要なキャラが起動する。
				@ゲームステージへ戻る
			}
		}
	#endif
	// デモ仕様のセット
	@常駐キャラ設定						// stdch.hで定義
	if($s:d_num != not_demo){
		// 共通して使用するもの
		chara デモキャンセルチェック デモキャンセル \
			-p demo_cancel

		if($s:d_num != SAVE_SEQUENSE){
			@シネマスクリーンセット
		}

		//	設定しないと落ちる
		@スティンガー性能設定
		@デモ空設定

		//	w46a_d_common.h内で記述
		if($s:d_num != SAVE_SEQUENSE){
			@フォグ設定
		}
		@もやもや設定
		if($w:p_story < d:ST:P080_03_P02ＡＧ浮上３ポリゴンデモ２終了) {
			@雷設定
		}
	}
} // < 「command マップ設定 メタル戦ステージ」の閉じカッコ
//初期マップの表示
command マップ表示 -show メタル戦ステージ

//###################################################################################
//									デモのみ仕様各種
//###################################################################################

// ダミープロック
proc null {}

// デモキャンセル
proc demo_cancel {
	command StreamStopAll
}

// リスタート
proc restart_proc {
	restart
}

// -------------------------------------------------------
// クリア情報のセーブ(確認）
// -------------------------------------------------------
proc セーブ確認ダイアログ表示 {
	chara セーブ確認画面 セーブ確認 \
		-p セーブダイアログ表示 \
		-s セーブ確認文
	// リソース名は、ending.gclでは「セーブ確認文」というのを用意してある。
	// リソースの内容は、ending.rscに記述してある。
}

// -------------------------------------------------------
// クリア情報のセーブ
// -------------------------------------------------------
proc セーブダイアログ表示 $:返り値 {
	if ( $:返り値 == 0 ) {
		chara セーブゲーム画面マネージャー セーブ画面 \
			-d save_load \
			-p セーブシーケンス終了 \
			-i plticon
	} else {
		@セーブシーケンス終了 1
	}
}

// デモ終了時プロック
proc P080_01_p01終了 {
	@デモ終了時シネマスクリーンオフ
	mesg デモキャンセルチェック デモキャンセル kill
	#if d:DEMO_SKIP_ENABLE
		eval($w:p_story = d:ST:P080_03_P02ＡＧ浮上３ポリゴンデモ２終了)
		print '$w:p_story = d:ST:P080_03_P02ＡＧ浮上３ポリゴンデモ２終了'
	#else
		print '$w:p_story = d:ST:P080_01_P01ＡＧ浮上１ポリゴンデモ１終了'
		eval($w:p_story = d:ST:P080_01_P01ＡＧ浮上１ポリゴンデモ１終了)
	#endif
	chara delay ディレイ \
		-time 1 \ 
		-exec{
//			restart
			@mv_init_wmovie_0
		}
}

proc P080_02_m01終了 {
	@デモ終了時シネマスクリーンオフ
	#if d:DEMO_SKIP_ENABLE
		eval($w:p_story = d:ST:P080_03_P02ＡＧ浮上３ポリゴンデモ２終了)
		print '$w:p_story = d:ST:P080_03_P02ＡＧ浮上３ポリゴンデモ２終了'
	#else
		eval($w:p_story = d:ST:P080_02_M01ＡＧ浮上２ムービーデモ１終了)
	#endif
	@mv_w46a_d080p01_0
}

proc P080_03_p02終了 {
	if ($f:ローポリ劇場フラグ == d:TRUE) {
		// ローポリ劇場中
		@mv_lowpoly

	} else {
		// 通常ゲーム中
		@デモ終了時シネマスクリーンオフ
		mesg デモキャンセルチェック デモキャンセル kill
		#if d:DEBUG_PRINT
			print '$w:p_story = d:ST:P080_03_P02ＡＧ浮上３ポリゴンデモ２終了'
		#endif

		// このデモ終了後、武器は取られてしまうので、以降のデモに武器装備品は
		// 反映させない。そのためにＭ９・ソコム・ＡＫ・Ｍ４を完全に無くす。
		eval($w:武器弾数Ｒ[d:武器:Ｍ９] = -1);
		eval($w:武器弾数Ｒ[d:武器:ソコム] = -1);
		eval($w:武器弾数Ｒ[d:武器:ＡＫＳ] = -1);
		eval($w:武器弾数Ｒ[d:武器:Ｍ４] = -1);

		eval($w:p_story = d:ST:P080_03_P02ＡＧ浮上３ポリゴンデモ２終了)
		eval( $f:P080セーブシーケンス = 1 );
		restart ;
	}
}
proc セーブシーケンス終了 $:返り値 {
	if( $:返り値 != 0 ){
		eval( $f:P080セーブシーケンス = 0 ) ;
		chara delay ディレイ \
			-time 1 \ 
			-exec{
				// ＡＧ上デモへ
				@mv_w46a_w51a_0
			}
	} else {
		@セーブ確認ダイアログ表示
	}
}

// シネマスクリーン
proc シネマスクリーンセット {
	chara シネマスクリーン シネマ \
		-top d:CINEMA_BELT_UPPER \
		-bottom d:CINEMA_BELT_LOWER \
		-ftime 60	//デフォルト値（ゼロは駄目）
	mesg シネマスクリーン シネマ フェードアウト 1
}



