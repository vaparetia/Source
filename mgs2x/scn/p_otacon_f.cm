//裸注意 h //e
resource PO_裸注意＿操作制限１__f {
//vox t:vc240111 {
オタコン_000: {
Raiden, tu ferais mieux de retrouver
Snake afin de reprendre ton &'equipement
sans tarder !
}
//	<<<ENGLISH>>>
//	Raiden, you'd better meet up with
//	Snake and get your gear back fast.

/*ライデン、早くスネークと合流して
装備をもらった方がいい。
*/
オタコン_001: {
Dans cet &'etat, tu ne pourras ni &'etrangler,
ni donner des coups de pied, ni te mettre
en suspension, ni ex&'ecuter des lancers !
}
//	<<<ENGLISH>>>
//	You won't be able to choke,
//	kick, hang or throw like that.

/*その格好じゃ首絞めもキックも
エルードも投げも出来ないだろ？
*/
//dv}//v
}//d

//風邪状態 h //e
resource PO_裸注意＿風邪１__f {
//vox t:vc240121 {
オタコン_000: {
Raiden, tu as attrap&'e un rhume ou quoi ?
}
//	<<<ENGLISH>>>
//	Raiden, did you catch
//	a cold or something?

/*ライデン、ひょっとして風邪でも
ひいてるんじゃないか？
*/
ライデン_001: {
Bien s&^ur que non !
Je - ATTTCHOOUUUM !
}
//	<<<ENGLISH(2)>>>
//	Of course not!
//	I'm... AH-CHOO!

/*いや、そんなことは……ハックション！*/
オタコン_002: {
J'en &'etais s&^ur ! C'est ce qui arrive quand
on court partout sans rien sur le dos !
}
//	<<<ENGLISH>>>
//	I knew it. Serves you right
//	for running around like that.

/*やっぱり。そんな格好してるからだよ。
*/
ライデン_003: {
Ce n'est pas comme si j'avais le choix...
CHOUUM !
}
//	<<<ENGLISH>>>
//	I didn't exactly have
//	a choice... CHOO!!

/*俺だって好きでしてるわけじゃ……
ハックション！
*/
オタコン_004: {
A tes souhaits !
}
//	<<<ENGLISH>>>
//	Bless you.

/*お大事に。*/
//dv}//v
}//d
//二回目以降 t //e
resource PO_裸注意＿風邪２__f {
//vox t:vc240131 {
オタコン_000: {
Il faut soigner ce rhume !
}
//	<<<ENGLISH>>>
//	You'll have to do something
//	about that cold.
//<ページ数変更>
オタコン_000_1: {
Si tu ne peux pas t'emp&^echer
d'&'eternuer &`a tout bout de champ,
tu vas te faire rep&'erer !
}
//	<<<ENGLISH>>>
//	If you can't stop sneezing, you're
//	an open invitation to everyone
//	within earshot.

/*風邪は何とかした方がいいね。
そうひっきりなしにクシャミしてたんじゃ
敵に見つかってしまう。
*/
オタコン_001: {
Prends un m&'edicament contre le rhume
et t&^aches de trouver quelque chose
pour te couvrir !
}
//	<<<ENGLISH>>>
//	Take some cold medication.
//	And get something to wrap
//	up in at least.

/*風邪薬を飲めば何とかなるだろう。
とりあえず何か羽織るのもいいかもね。
*/
//dv}//v
}//d

