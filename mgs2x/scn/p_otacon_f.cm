//スネークが死ぬと一緒にゲームオーバー h //e
resource PO_スネーク死んだら終わり__f {
//vox t:vc240221 {
オタコン_000: {
La jauge de LIFE de Snake est juste
au-dessous de la tienne. Ton destin est
li&'e, ce qui fait que la mort de l'un entra&^ine
celle de l'autre. Tu comprends ?
}
//	<<<ENGLISH>>>
//	Snake's Life Gauge is right below
//	yours. You live and die together,
//	do you understand?

/*スネークのＬＩＦＥが君のＬＩＦＥ
ゲージの下に表示されている。
一連托生だ、いいね。
*/
オタコン_001: {
Je suis s&^ur que tout se passera bien, mais
s'il se trouve dans une mauvaise passe,
fais tout ce que tu peux pour l'aider.
}
//	<<<ENGLISH>>>
//	I'm sure everything will be okay,
//	but if he gets in a tight spot, give
//	him all the backup you can.
//<ページ数変更>
オタコン_001_1: {
Je compte sur toi !
}
//	<<<ENGLISH>>>
//	I'm counting on you!

/*大丈夫だとは思うけど、スネークが
危なくなったら援護してやってくれ。
頼むよ！
*/
//dv}//v
}//d


