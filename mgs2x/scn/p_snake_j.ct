proc rp_PS_ハリアー戦＿援護:07 {
vox t:vc210661 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ハリアー戦＿援護:プリスキン_000]
		//ライデン、俺もこのヘリから援護する。
		//アイテムが足りないようなら投げてやる
		//からうまく使え。
	}
}//v
}//d

//ライデンに撃たれた１ h //e
//resource PS_ハリアー戦＿撃たれた１
proc rp_PS_ハリアー戦＿撃たれた１:07 {
vox t:vc210671 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ハリアー戦＿撃たれた１:プリスキン_000]
		//ライデン！
		//どこを狙ってるんだ！？
	}
}//v
}//d
//ライデンに撃たれた２ h //e
//resource PS_ハリアー戦＿撃たれた２
proc rp_PS_ハリアー戦＿撃たれた２:07 {
vox t:vc210681 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ハリアー戦＿撃たれた２:プリスキン_000]
		//ふざけるな！！
	}
}//v
}//d
//ライデンに撃たれた３ h //e
//resource PS_ハリアー戦＿撃たれた３
proc rp_PS_ハリアー戦＿撃たれた３:07 {
vox t:vc210691 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ハリアー戦＿撃たれた３:プリスキン_000]
		//お前、俺達に何か恨みでもあるのか！！
	}
}//v
}//d

//カサッカ死亡寸前１ h //e
//resource PS_ハリアー戦＿カサッカ死亡寸前１
proc rp_PS_ハリアー戦＿カサッカ死亡寸前１:07 {
vox t:vc210701 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ハリアー戦＿カサッカ死亡寸前１:プリスキン_000]
		//ライデン、こっちはかなり危ない状況だ。
		//早くハリアーを落としてくれ。
	}
}//v
}//d
//カサッカ死亡寸前２ h //e
//resource PS_ハリアー戦＿カサッカ死亡寸前２
proc rp_PS_ハリアー戦＿カサッカ死亡寸前２:07 {
vox t:vc210711 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PS_ハリアー戦＿カサッカ死亡寸前２:ライデン_000]
		//大丈夫か！？
	}
	talk プリスキン 標準 -m {
		 [PS_ハリアー戦＿カサッカ死亡寸前２:プリスキン_001]
		//すまん、ライデン。
		//こっちの方はもういくらも持ちそうに
		//ない。早く奴をなんとかしてくれ。
	}
}//v
}//d

//基本戦法 h //e
//resource PS_ハリアー戦＿基本戦法１
proc rp_PS_ハリアー戦＿基本戦法１:07 {
vox t:vc210721 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ハリアー戦＿基本戦法１:プリスキン_000]
		//ハリアーは垂直離着陸機とは言え、
		//戦闘機だ。小回りが効かない。
	}
	talk プリスキン 標準 -m {
		 [PS_ハリアー戦＿基本戦法１:プリスキン_001]
		//攻撃と攻撃の間には必ず隙が出来る。
		//その時がチャンスだ。
	}
}//v
}//d
//スティンガー使え h //e
//resource PS_ハリアー戦＿スティンガー１
proc rp_PS_ハリアー戦＿スティンガー１:07 {
vox t:vc210731 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ハリアー戦＿スティンガー１:プリスキン_000]
		//ライデン、さっきスティンガーを
		//渡しただろう。
	}
	talk ライデン 標準 -m {
		 [PS_ハリアー戦＿スティンガー１:ライデン_001]
		//携行用の対空ミサイルだな。
		//ＶＲ訓練で経験済みだ。
	}
	talk プリスキン 標準 -m {
		 [PS_ハリアー戦＿スティンガー１:プリスキン_002]
		//そいつは心強いことだ（皮肉）。
		//実戦でもうまくやってくれよ。
	}
}//v
}//d
//二回目以降 t //e
//resource PS_ハリアー戦＿スティンガー２
proc rp_PS_ハリアー戦＿スティンガー２:07 {
vox d:_vc210741 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ハリアー戦＿スティンガー２:プリスキン_000]
		//スティンガーでハリアーを撃ち落とせ。
		//だが気をつけろ。スティンガーを構えて
		//いる間は移動が出来ない。
	}
	talk プリスキン 標準 -m {
		 [PS_ハリアー戦＿スティンガー２:プリスキン_001]
		//ハリアーがそっちに向かってきたら
		//すぐに隠れるんだ。
	}
	talk プリスキン 標準 -m {
		 [PS_ハリアー戦＿スティンガー２:プリスキン_002]
		//Ｒ２ボタンを素早く押せば武器の
		//クイックチェンジが出来る。
		//うまく使え。
	}
}//v
}//d


//ＲＧＢ６ h //e
//resource PS_ハリアー戦＿ＲＧＢ６
proc rp_PS_ハリアー戦＿ＲＧＢ６:07 {
vox t:vc210751 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ハリアー戦＿ＲＧＢ６:プリスキン_000]
		//ＲＧＢ６を持ってるな。そいつも有効だ。
		//弾道が放物線を描くことに注意しろ。
		//主観攻撃でよく狙うんだ。
	}
}//v
}//d


//★P046_02_R01ハリアー戦勝利２無線デモ１終了＜フラグ＜P047_01_P01電撃床前オルガ１ポリゴンデモ１開始 d //e
//大統領救出しろ h //e
//resource PS_ハリアー戦後＿大統領救出せよ
proc rp_PS_ハリアー戦後＿大統領救出せよ:07 {
vox t:vc210761 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ハリアー戦後＿大統領救出せよ:プリスキン_000]
		//ライデン、大統領の方は任せた。
		//核発射コードの再確認がされる前に
		//彼に接触するんだ。
	}
	talk プリスキン 標準 -m {
		 [PS_ハリアー戦後＿大統領救出せよ:プリスキン_001]
		//俺達はカモフの修理にとりかかる。
		//しばらくは手が離せんだろう。
	}
	talk プリスキン 標準 -m {
		 [PS_ハリアー戦後＿大統領救出せよ:プリスキン_002]
		//シェル２の方は爆弾処理の時に一通り
		//まわった。何かあったら無線連絡をくれ。
	}
}//v
}//d

//偽名の由来について h //e
//resource PS_イロコイ語源
proc rp_PS_イロコイ語源:07 {
vox t:vc210771 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PS_イロコイ語源:ライデン_000]
		//……イロクォイ・プリスキンって
		//いうのは偽名だったんだな。
	}
@rp_うなづきデフォルト＿是
@rp_邪道外道＿否２＿ひどい系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_イロコイ語源:プリスキン_001]
		//ああ。
	}
	talk ライデン 標準 -m {
		 [PS_イロコイ語源:ライデン_002]
		//中尉っていうのも……。
	}
	talk プリスキン 標準 -m {
		 [PS_イロコイ語源:プリスキン_003]
		//デタラメだ。
	}
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PS_イロコイ語源:ライデン_004]
		//まったく……。だがプリスキンは
		//ともかくイロクォイっていうのは
		//どういう意味なんだ？
	}
	talk プリスキン 標準 -m {
		 [PS_イロコイ語源:プリスキン_005]
		//ああ、イロクォイはアルゴンクイン語で
		//毒蛇という意味だ。
	}
	talk ライデン 標準 -m {
		 [PS_イロコイ語源:ライデン_006]
		//アルゴンクイン語？
	}
	talk プリスキン 標準 -m {
		 [PS_イロコイ語源:プリスキン_007]
		//昔、マンハッタン島に住んでいた
		//先住民族だ。当時、数百の部族が
		//暮らしていた。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_イロコイ語源:プリスキン_008]
		//このニューヨーク州には
		//イロクオィ語族が占めていた。
	}
	talk ライデン 標準 -m {
		 [PS_イロコイ語源:ライデン_009]
		//昔から蛇（スネーク）がこの地を……。
	}
	talk プリスキン 標準 -m {
		 [PS_イロコイ語源:プリスキン_010]
		//ちなみに「マンハッタン」は
		//アルゴンクィン語で「丘の島」という
		//意味だ。
	}
}//v
}//d


//★P047_05_R01電撃床前オルガ５無線デモ１終了＜フラグP048_01_P01電源パネル破壊１ポリゴンデモ１開始 d //e
//リモコンミサイルの場所 h //e
//一回目のみ t //e
//resource PS_リモコンミサイル１
proc rp_PS_リモコンミサイル１:07 {
vox t:vc210781 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PS_リモコンミサイル１:ライデン_000]
		//スネーク、リモコンミサイルのありかを
		//知ってるか？
	}
}//v
}//d
//resource PS_リモコンミサイル２
//トラップ？ＸＸＸＸＸＸＸＸｘ
proc rp_PS_リモコンミサイル２:07 {
vox t:vc210791 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_リモコンミサイル２:プリスキン_000]
		//リモコンミサイルなら、
		//シェル２中央棟のＢ１で見たな。
	}
	talk プリスキン 標準 -m {
		 [PS_リモコンミサイル２:プリスキン_001]
		//だが気をつけろ。例の爆発で汲み上げた
		//汚染海水が溢れ出している。
		//今はＢ１のほとんどが浸水してるはずだ。
	}
}//v
}//d


//★P055_04_P03ヴァンプ戦前４ポリゴンデモ３終了＜フラグ＜P057_01_P01ヴァンプ戦終了１ポリゴンデモ１開始 d //e
//ヴァンプ戦 h //e
//ロックオン使うな h //e
//resource PS_ヴァンプ戦＿ロックオン使うな１
proc rp_PS_ヴァンプ戦＿ロックオン使うな１:07 {
vox t:vc210801 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ヴァンプ戦＿ロックオン使うな１:プリスキン_000]
		//奴はお前の筋肉の動きから弾筋を
		//読んでいるようだ。
	}
	talk プリスキン 標準 -m {
		 [PS_ヴァンプ戦＿ロックオン使うな１:プリスキン_001]
		//だが安心しろ。完全に読みきれるわけ
		//でもないらしい。
	}
}//v
}//d
//一回目のみ t //e
//resource PS_ヴァンプ戦＿ロックオン使うな２
proc rp_PS_ヴァンプ戦＿ロックオン使うな２:07 {
vox t:vc210811 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PS_ヴァンプ戦＿ロックオン使うな２:ライデン_000]
		//どういうことだ？
	}
	talk プリスキン 標準 -m {
		 [PS_ヴァンプ戦＿ロックオン使うな２:プリスキン_001]
		//Ｂ脚でやりあった時、お前の弾が一発
		//当たっただろう。
	}
	talk ライデン 標準 -m {
		 [PS_ヴァンプ戦＿ロックオン使うな２:ライデン_002]
		//そういえば……。だがＳＥＡＬＳの弾は
		//全く当たらなかった……？
	}
	@rpd_オタコン顔表示
	talk オタコン 標準 -m {
		 [PS_ヴァンプ戦＿ロックオン使うな２:オタコン_003]
		//きっと君の着てるスカルスーツの
		//せいだよ。
	}
	talk ライデン 標準 -m {
		 [PS_ヴァンプ戦＿ロックオン使うな２:ライデン_004]
		//こいつの？
	}
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		 [PS_ヴァンプ戦＿ロックオン使うな２:オタコン_005]
		//ああ。スカルスーツが筋肉を圧迫して
		//いるおかげで動きが読みにくくなって
		//いるんだと思う。
	}
	talk オタコン 標準 -m {
		 [PS_ヴァンプ戦＿ロックオン使うな２:オタコン_006]
		//あからさまな動きをしなければ
		//ヴァンプの読みを外せるはずだ。
	}
	talk ライデン 標準 -m {
		 [PS_ヴァンプ戦＿ロックオン使うな２:ライデン_007]
		//あからさまな動き？
	}
	talk オタコン 標準 -m {
		 [PS_ヴァンプ戦＿ロックオン使うな２:オタコン_008]
		//Ｌ１ボタンのロックオンとかかな。
	}
	@rpd_プリスキン顔表示
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ヴァンプ戦＿ロックオン使うな２:プリスキン_009]
		//なるほど。
	}
}//v
}//d
