//ＥＦ連絡橋 d //e
//XBOXとPSX2で切り替えるべき音声コード
#include "vcvx.h"

//地雷探知器のありか h //e
//一回目のみ t //e
//resource PS_地雷探知器のありか１
proc rp_PS_地雷探知器のありか１:07 {
vox t:vc210011 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PS_地雷探知器のありか１:ライデン_000]
		//プリスキン、こっちに地雷が
		//仕掛けられていて……。
	}
}//v
}//d
//resource PS_地雷探知器のありか２＿１
proc rp_PS_地雷探知器のありか２＿１:07 {
vox t:vc210021 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_地雷探知器のありか２＿１:プリスキン_000]
		//地雷探知機ならＥ脚のＢ１にあるはずだ。
	}
}//v
}//d
//resource PS_地雷探知器のありか２＿２
proc rp_PS_地雷探知器のありか２＿２:07 {
vox t:vc210031 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_地雷探知器のありか２＿２:プリスキン_000]
		//地雷探知機ならＥ脚の１Ｆにあるはずだ。
	}
}//v
}//d
//resource PS_地雷探知器のありか２＿３
proc rp_PS_地雷探知器のありか２＿３:07 {
vox t:vc210041 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_地雷探知器のありか２＿３:プリスキン_000]
		//地雷探知機ならＦ脚にあるはずだ。
	}
}//v
}//d

//一回目のみ t //e
//resource PS_地雷探知器のありか３
proc rp_PS_地雷探知器のありか３:07 {
vox t:vc210051 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PS_地雷探知器のありか３:ライデン_000]
		//なぜわかる？
	}
	talk プリスキン 標準 -m {
		 [PS_地雷探知器のありか３:プリスキン_001]
		//考えてみろ。クレイモアを仕掛けた
		//奴らも地雷が見えないんだ。探知機を
		//そばにおいておくに違いない。
	}
	talk ライデン 標準 -m {
		 [PS_地雷探知器のありか３:ライデン_002]
		//凄い読みだな。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_地雷探知器のありか３:プリスキン_003]
		//ＶＲ訓練では教わっていないようだが、
		//戦場では勘が大切なんだ。理屈ではなく、
		//全神経で危険を感じ取れ。いいな。
	}
}//v
}//d

//Ｅ脚 d //e

//シェル１中央棟Ｂ１ d //e
//網膜センサー h //e
//resource PS_網膜センサー＿羽交い絞め１
proc rp_PS_網膜センサー＿羽交い絞め１:07 {
