//Ｅ脚狙撃後 h //e
//エマ血痕近く h //e
//resource PS_Ｅ脚＿エマ血痕
proc rp_PS_Ｅ脚＿エマ血痕:07 {
vox t:vc210191 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PS_Ｅ脚＿エマ血痕:ライデン_000]
		//スネーク……エマの怪我は……。
	}
	talk プリスキン 標準 -m {
		 [PS_Ｅ脚＿エマ血痕:プリスキン_001]
		//見ての通りだ。
	}
	talk ライデン 標準 -m {
		 [PS_Ｅ脚＿エマ血痕:ライデン_002]
		//……。
	}
	talk プリスキン 標準 -m {
		 [PS_Ｅ脚＿エマ血痕:プリスキン_003]
		//急いでくれ。
	}
}//v
}//d


//ストーリー依存 d //e
//★P010_10_P05ヴァンプ遭遇１０ポリゴンデモ５終了＜フラグ＜P012_01_P01フォーチュン遭遇１ポリゴンデモ１開始 d //e
//寝ている h //e
