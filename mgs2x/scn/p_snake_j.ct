		//もっているかどうかわかるはずだ。
	}
}//v
}//d

//敵兵気絶タイマー h //e
//resource PS_敵兵気絶タイマー
proc rp_PS_敵兵気絶タイマー:07 {
vox t:vc211421 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_敵兵気絶タイマー:プリスキン_000]
		//ライデン、気絶した敵の頭の上を見ろ。
		//星が回っているだろう？
	}
	talk プリスキン 標準 -m {
		 [PS_敵兵気絶タイマー:プリスキン_001]
		//星がなくなるとその敵は目を覚ますぞ。
		//敵の頭上に注意しろ。いいな。
	}
}//v
}//d

//落とし穴死体落し h //e
//resource PS_落とし穴死体落し
proc rp_PS_落とし穴死体落し:07 {
vox t:vc211431 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_落とし穴死体落し:プリスキン_000]
		//床が崩れて出来た穴もうまく使えば
		//役に立つだろう。
	}
	talk プリスキン 標準 -m {
		 [PS_落とし穴死体落し:プリスキン_001]
		//倒した敵の体を穴から海面に落とせば
		//敵に発見される恐れはないはずだ。
	}
}//v
