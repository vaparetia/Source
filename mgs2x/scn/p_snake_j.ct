proc rp_PS_ＡＫ入手時ＣＡＬＬ:07 {
vox t:vc212792 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		[PS_ＡＫ入手時ＣＡＬＬ:プリスキン_000]
		//ＡＫを手にいれたようだな。
	}
}//v
