proc rp_PS_寝ている１:07 {
//vox t:vc210201 {
	talk プリスキン 標準 -m {
		 [PS_寝ている１:プリスキン_000]
		//ＺＺｚｚ……。
	}
//}//v
}//d
//resource PS_寝ている２
proc rp_PS_寝ている２:07 {
vox t:vc210211 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PS_寝ている２:ライデン_000]
		//寝てるのか……？
	}
}//v
}//d

//寝ているつっこみ h //e
//resource PS_寝ている３
proc rp_PS_寝ている３:07 {
vox t:vc210221 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PS_寝ている３:ライデン_000]
		//いつまで寝てるつもりだ……？
	}
}//v
}//d
//寝ているつっこみ h //e
//resource PS_寝ている４
proc rp_PS_寝ている４:07 {
vox t:vc210231 {
	talk ライデン 標準 -m {
		 [PS_寝ている４:ライデン_000]
		//呑気なものだ……。
	}
}//v
}//d
//寝ているつっこみ h //e
//resource PS_寝ている５
proc rp_PS_寝ている５:07 {
vox t:vc210232 {
@rp_うなづきデフォルト＿是
@rp_キテレツさん＿否１＿なんだこいつ系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_寝ている５:プリスキン_000]
		//……むにゃむにゃ……
	}
	talk ライデン 標準 -m {
		 [PS_寝ている５:ライデン_001]
		//……まだ寝ている……
	}
	talk プリスキン 標準 -m {
		 [PS_寝ている５:プリスキン_002]
		//むにゃ……リキッドォ！
	}
	talk ライデン 標準 -m {
		 [PS_寝ている５:ライデン_003]
		//え？
	}
	talk プリスキン 標準 -m {
		 [PS_寝ている５:プリスキン_004]
		//むにゃ……Ｚｚｚｚ……。
	}
}//v
}//d

//★P012_02_R01フォーチュン遭遇２無線デモ１終了＜フラグ＜P014_01_P01ピーター遭遇１ポリゴンデモ１開始 d //e
//寝ている間に通信した場合 h //e
//resource PS_寝ている間に通信した
proc rp_PS_寝ている間に通信した:07 {
vox t:vc210241 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PS_寝ている間に通信した:ライデン_000]
		//おはよう、プリスキン中尉。
		//良いお目覚めで。
	}
	talk プリスキン 標準 -m {
		 [PS_寝ている間に通信した:プリスキン_001]
		//ああ……。ありがとう。
		//体調も戻った。
		//もう大丈夫だ。
	}
}//v
}//d



//フォーチュンの設定 h //e
//resource PS_フォーチュン＿死なない
proc rp_PS_フォーチュン＿死なない:07 {
vox t:vc210251 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PS_フォーチュン＿死なない:ライデン_000]
		//あの女、なぜ死なない？
	}
	talk プリスキン 標準 -m {
		 [PS_フォーチュン＿死なない:プリスキン_001]
		//あの女は死を歓迎している。
		//死が自分を開放しにくる時を
		//待ち望んでいるんだ。
	}
	talk プリスキン 標準 -m {
		 [PS_フォーチュン＿死なない:プリスキン_002]
		//死への恐怖がない人間程、生へ近づく。
		//死を恐れれば、それだけ死に近づく。
	}
}//v
}//d


//眠りプリスキンを殴っている場合 h //e
//resource PS_睡眠中殴られた１
proc rp_PS_睡眠中殴られた１:07 {
vox t:vc210261 {
@rp_つっこまれ＿是１＿なんで知ってるんだ系デフォルト 100
@rp_うなづきデフォルト＿否
	talk プリスキン 標準 -m {
		 [PS_睡眠中殴られた１:プリスキン_000]
		//お前……さっき俺が休んでる間……。
	}
	talk ライデン 標準 -m {
		 [PS_睡眠中殴られた１:ライデン_001]
		//え！？
	}
	talk プリスキン 標準 -m {
		 [PS_睡眠中殴られた１:プリスキン_002]
		//ふん。まあいい。
	}
	talk ライデン 標準 -m {
		 [PS_睡眠中殴られた１:ライデン_003]
		//……。（ほっ）
	}
}//v
}//d


//★P014_16_G01ピーター遭遇１６ゲーム１終了＜フラグ＜P015_01_R1爆弾解体最初の一つ１無線デモ１開始 d //e
//爆弾解体ヒント１ h //e
//resource PS_爆弾解体中＿敵排除のススメ１＿１
proc rp_PS_爆弾解体中＿敵排除のススメ１＿１:07 {
vox t:vc210271 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_爆弾解体中＿敵排除のススメ１＿１:プリスキン_000]
		//ライデン、焦るんじゃないぞ。
		//先に敵を倒してそれから爆弾を
		//探す方が安全だ。
	}
}//v
}//d

//resource PS_爆弾解体中＿敵排除のススメ１＿２
proc rp_PS_爆弾解体中＿敵排除のススメ１＿２:07 {
vox t:vc210281 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_爆弾解体中＿敵排除のススメ１＿２:プリスキン_000]
		//敵を警戒しながら、爆弾を探す
		//なんてことは考えない方がいい。
	}
	talk プリスキン 標準 -m {
		 [PS_爆弾解体中＿敵排除のススメ１＿２:プリスキン_001]
		//敵を眠らせるなり、倒すなりして、
		//排除しておくんだ。
	}
}//v
}//d

//爆弾解体ヒント２ h //e
//resource PS_爆弾解体中＿敵排除のススメ２
proc rp_PS_爆弾解体中＿敵排除のススメ２:07 {
vox t:vc210291 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_爆弾解体中＿敵排除のススメ２:プリスキン_000]
		//敵の見張りは各脚の守備範囲を
		//受け持っているようだ。
	}
	talk プリスキン 標準 -m {
		 [PS_爆弾解体中＿敵排除のススメ２:プリスキン_001]
		//無線連絡されない限り安全だが、
		//発見されたらすぐに逃げろ。どこかに
		//身を潜めて、増援部隊をやり過ごすんだ。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_爆弾解体中＿敵排除のススメ２:プリスキン_002]
		//敵に追われながら爆弾を処理するなんて
		//お前には無理な話だろう。
	}
}//v
}//d


//爆弾解体催促 h //e
//resource PS_爆弾解体中＿催促１
proc rp_PS_爆弾解体中＿催促１:07 {
vox t:vc210301 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_爆弾解体中＿催促１:プリスキン_000]
		//ライデン、１つ目の爆弾を凍結した！
		//そっちは？
	}
	talk ライデン 標準 -m {
		 [PS_爆弾解体中＿催促１:ライデン_001]
		//まだだ……。
	}
	@rpd_ピーター顔表示
	talk ピーター 標準 -m {
		 [PS_爆弾解体中＿催促１:ピーター_002]
		//プリスキン、爆弾の設置されていた
		//状況を教えてくれ。
	}
	@rpd_プリスキン顔表示
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_爆弾解体中＿催促１:プリスキン_003]
		//Ｈ脚のヘリポート。荷物の影に
		//仕掛けられていた。
		//見張りが厄介だったが、楽勝だった。
	}
	@rpd_ピーター顔表示
	talk ピーター 標準 -m {
		 [PS_爆弾解体中＿催促１:ピーター_004]
		//そうか……。（なにかおかしい）
	}
	@rpd_プリスキン顔表示
	talk プリスキン 標準 -m {
		 [PS_爆弾解体中＿催促１:プリスキン_005]
		//どうかしたのか？
	}
	@rpd_ピーター顔表示
@rp_うなづきデフォルト＿是
@rp_かみあわない＿否１＿話聞けよ系デフォルト 100
	talk ピーター 標準 -m {
		 [PS_爆弾解体中＿催促１:ピーター_006]
		//いや。なんでもない。
		//プリスキン、気を抜くなよ。
		//解体後の安心感は禁物だ。
	}
	@rpd_プリスキン顔表示
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_爆弾解体中＿催促１:プリスキン_007]
		//わかってる。
		//ライデン、シェル１を頼むぞ。
	}
	talk ライデン 標準 -m {
		 [PS_爆弾解体中＿催促１:ライデン_008]
		//ああ……。
	}
}//v
}//d


