	talk プリスキン 標準 -m {
		 [PS_網膜センサー＿羽交い絞め１:プリスキン_000]
		//網膜センサーに敵を生きたまま連れて
		//行く必要があるのか？
	}
}//v
}//d
//羽交い締めでチェック t //e
//resource PS_網膜センサー＿羽交い絞め２
proc rp_PS_網膜センサー＿羽交い絞め２:07 {
vox t:vc210071 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_網膜センサー＿羽交い絞め２:プリスキン_000]
		//首絞めで捕まえてセンサーまで
		//引きずっていったらどうだ？
	}
}//v
}//d

//シェル２中央棟１Ｆノード位置 h //e
//resource PS_シェル２中央棟１Ｆ＿ノード位置
proc rp_PS_シェル２中央棟１Ｆ＿ノード位置:07 {
vox t:vc210081 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_シェル２中央棟１Ｆ＿ノード位置:プリスキン_000]
		//ライデン、そのエリアのノードは
		//北西にある小部屋の中だ。アクセスして
		//おいた方がいいだろうな。
	}
}//v
}//d

//シェル２中央棟Ｂ１ d //e
//水中 h //e
//Ｂ１の地形 t //e
//resource PS_シェル２中央棟Ｂ１＿水中レーダー使え１
proc rp_PS_シェル２中央棟Ｂ１＿水中レーダー使え１:07 {
vox t:vc210091 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_シェル２中央棟Ｂ１＿水中レーダー使え１:プリスキン_000]
		//水中では地形の把握が難しい。
		//レーダーを使えるようにしておいた方が
		//いいだろうな。
	}
}//v
}//d
//ノード位置 t //e
//resource PS_シェル２中央棟Ｂ１＿水中レーダー使え２
proc rp_PS_シェル２中央棟Ｂ１＿水中レーダー使え２:07 {
vox t:vc210101 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_シェル２中央棟Ｂ１＿水中レーダー使え２:プリスキン_000]
		//そのエリアのノードはエレベータの
		//すぐ近くにある。必ずアクセスして
		//おくんだ。
	}
}//v
}//d
//水中機雷 h //e
//resource PS_シェル２中央棟＿水中機雷１
proc rp_PS_シェル２中央棟＿水中機雷１:07 {
vox t:vc210111 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_シェル２中央棟＿水中機雷１:プリスキン_000]
		//ライデン、水中機雷に気をつけろ。
		//触れると爆発するぞ。機雷をよけて
		//泳ぐんだ。
	}
}//v
}//d
//一回目のみ t //e
//resource PS_シェル２中央棟＿水中機雷２
proc rp_PS_シェル２中央棟＿水中機雷２:07 {
vox t:vc210121 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PS_シェル２中央棟＿水中機雷２:ライデン_000]
		//なぜこんなところに水中機雷があるんだ？
	}
	talk プリスキン 標準 -m {
		 [PS_シェル２中央棟＿水中機雷２:プリスキン_001]
		//誰かが仕掛けたからだろう。
	}
	@rpd_オタコン顔表示
	talk オタコン 標準 -m {
		 [PS_シェル２中央棟＿水中機雷２:オタコン_002]
		//あいつじゃないか？
		//水面を走っていた男……。
	}
	@rpd_プリスキン顔表示
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_シェル２中央棟＿水中機雷２:プリスキン_003]
		//気をつけたほうがいいな。
		//待ち伏せしているかもしれん。
	}
	talk ライデン 標準 -m {
		 [PS_シェル２中央棟＿水中機雷２:ライデン_004]
		//……ああ……。
	}
}//v
}//d
