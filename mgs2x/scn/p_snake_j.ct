//Ｃ脚 d //e
//女子便所 h //e
//resource PS_Ｃ脚女子トイレ
proc rp_PS_Ｃ脚女子トイレ:07 {
vox t:vc211701 {
@rp_うなづきデフォルト
@rp_つっこまれ＿是１＿なんで知ってるんだ系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_Ｃ脚女子トイレ:プリスキン_000]
		//ライデン……お前、どこにいるんだ？
	}
	talk ライデン 標準 -m {
		 [PS_Ｃ脚女子トイレ:ライデン_001]
		//いや、これは……。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_Ｃ脚女子トイレ:プリスキン_002]
		//なに、恥じることはない。
		//任務達成にはあらゆる手段を尽くす
		//必要がある。
	}
	talk ライデン 標準 -m {
		 [PS_Ｃ脚女子トイレ:ライデン_003]
		//プリスキン……。
	}
	talk プリスキン 標準 -m {
		 [PS_Ｃ脚女子トイレ:プリスキン_004]
		//俺も昔はよく入ったもんだ……。
	}
	talk ライデン 標準 -m {
		 [PS_Ｃ脚女子トイレ:ライデン_005]
		//……え？
	}
}//v
}//d



//シェル２中央棟 d //e
//resource PS_シェル２中央棟＿濾過装置うんちく１
proc rp_PS_シェル２中央棟＿濾過装置うんちく１:07 {
vox t:vc211711 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_シェル２中央棟＿濾過装置うんちく１:プリスキン_000]
		//ライデン、気を付けろ。
		//生物反応槽に落ちれば命はないぞ。
	}
}//v
}//d
//resource PS_シェル２中央棟＿濾過装置うんちく２
proc rp_PS_シェル２中央棟＿濾過装置うんちく２:07 {
vox t:vc211721 {
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		 [PS_シェル２中央棟＿濾過装置うんちく２:オタコン_000]
		//ああ。生物反応槽では微生物を使った
		//汚水処理を行っているんだ。
	}
	talk オタコン 標準 -m {
		 [PS_シェル２中央棟＿濾過装置うんちく２:オタコン_001]
		//その微生物の活性を保つために常に
		//大量の酸素が注入されている。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk オタコン 標準 -m {
		 [PS_シェル２中央棟＿濾過装置うんちく２:オタコン_002]
		//だから水の比重がとても軽くなって
		//いるんだ。人間が浮かぶことは出来ない。
		//沈んでしまうんだ。
	}
	talk オタコン 標準 -m {
		 [PS_シェル２中央棟＿濾過装置うんちく２:オタコン_003]
		//落ちたら溺れるしかないだろうだろう。
		//絶対に落ちるんじゃないよ、いいね。
	}
}//v
}//d


//ストーリー依存 d //e
//ヴァンプの事 h //e
//resource PS_ヴァンプ１
proc rp_PS_ヴァンプ１:07 {
vox t:vc211731 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ヴァンプ１:プリスキン_000]
		//デッドセルの一人。ヴァンプは
		//ルーマニア出身のナイフ使いだ。
		//腕前は……見ての通りだな。
	}
	talk プリスキン 標準 -m {
		 [PS_ヴァンプ１:プリスキン_001]
		//幼い頃に一家で教会に行った時に
		//爆弾テロに巻き込まれて家族を
		//失っている。
	}
	talk プリスキン 標準 -m {
		 [PS_ヴァンプ１:プリスキン_002]
		//奴は胸に教会の十字架が刺さった
		//ままの状態でまる二日間瓦礫の下に
		//放置されていたそうだ。
	}
	talk プリスキン 標準 -m {
		 [PS_ヴァンプ１:プリスキン_003]
		//その間、奴は流れ出た自分と家族の血を
		//なめて渇きを癒し、命をつないでいた
		//らしい。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ヴァンプ１:プリスキン_004]
		//血をすするようになったのは
		//それからだそうだ。
	}
	talk ライデン 標準 -m {
		 [PS_ヴァンプ１:ライデン_005]
		//それで吸血鬼……か。
	}
	talk プリスキン 標準 -m {
		 [PS_ヴァンプ１:プリスキン_006]
		//ああ。ちなみにヴァンパイアではなく
		//ヴァンプと呼ばれているのは奴が
		//バイセクシャルだからだ。
	}
}//v
}//d
//ヴァンプとフォーチュンの関係を聞いていない場合 t //e
//resource PS_ヴァンプ２
proc rp_PS_ヴァンプ２:07 {
vox t:vc211741 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ヴァンプ２:プリスキン_000]
		//２年前に事故死した海兵隊司令官、
		//スコット・ドルフの愛人だったという
		//噂もある。
	}
	talk プリスキン 標準 -m {
		 [PS_ヴァンプ２:プリスキン_001]
		//スコット・ドルフはデッドセルの
		//リーダー、フォーチュンの父親でも
		//あるな。
	}
	talk ライデン 標準 -m {
		 [PS_ヴァンプ２:ライデン_002]
		//フォーチュンの父親？
		//だが奴は彼女とも……。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ヴァンプ２:プリスキン_003]
		//ふん。よく観察しているな。
		//新米にしてはたいした余裕だ。
	}
	talk ライデン 標準 -m {
		 [PS_ヴァンプ２:ライデン_004]
		//いや……
	}
}//v
}//d
//resource PS_ヴァンプとフォーチュン
proc rp_PS_ヴァンプとフォーチュン:07 {
vox t:vc211751 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ヴァンプとフォーチュン:プリスキン_000]
		//そう。お前の見立てどおり、ヴァンプと
		//フォーチュンは肉体関係があるらしい。
		//まあ恋人とは少し違うようだが。
	}
	talk ライデン 標準 -m {
		 [PS_ヴァンプとフォーチュン:ライデン_001]
		//じゃあなんだ？友達？
	}
	talk プリスキン 標準 -m {
		 [PS_ヴァンプとフォーチュン:プリスキン_002]
		//それも違うだろうな。
		//まあ人の絆なんてよそからは
		//測れんものさ。
	}
	talk ライデン 標準 -m {
		 [PS_ヴァンプとフォーチュン:ライデン_003]
		//しかし……自分の父親と寝ていた男だろ？
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ヴァンプとフォーチュン:プリスキン_004]
		//母親と寝ていたのなら良かったのか？
	}
	talk ライデン 標準 -m {
		 [PS_ヴァンプとフォーチュン:ライデン_005]
		//……。
	}
	talk プリスキン 標準 -m {
		 [PS_ヴァンプとフォーチュン:プリスキン_006]
		//向こうもお前に理解してもらおうなんて
		//思ってはいまい。
		//くだらんことは気にするな。
	}
	talk ライデン 標準 -m {
		 [PS_ヴァンプとフォーチュン:ライデン_007]
		//……。
	}
}//v
}//d
//ヴァンプ遭遇直後の場合 t //e
//resource PS_ヴァンプ遭遇直後
proc rp_PS_ヴァンプ遭遇直後:07 {
vox t:vc211761 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PS_ヴァンプ遭遇直後:ライデン_000]
		//ところであんた、奴と会ったことが
		//あるのか？
	}
	talk プリスキン 標準 -m {
		 [PS_ヴァンプ遭遇直後:プリスキン_001]
		//いや。
	}
	talk ライデン 標準 -m {
		 [PS_ヴァンプ遭遇直後:ライデン_002]
		//だが奴はあんたを知っているよう
		//だった……。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ヴァンプ遭遇直後:プリスキン_003]
		//確かに……まさか……。
	}
	talk ライデン 標準 -m {
		 [PS_ヴァンプ遭遇直後:ライデン_004]
		//なんだ？
	}
	talk プリスキン 標準 -m {
		 [PS_ヴァンプ遭遇直後:プリスキン_005]
		//いや。デッドセルは言った通り凶人の
		//集団だ。奴等の言うことをいちいち真に
		//受けない方がいい。気にするな。
	}
}//v
}//d


//他のデッドセルの事 h //e
//resource PS_デッドセル１
proc rp_PS_デッドセル１:07 {
vox t:vc211771 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PS_デッドセル１:ライデン_000]
		//デッドセルについて
		//もう少し教えてくれないか？
	}
}//v
}//d
//resource PS_デッドセル２
proc rp_PS_デッドセル２:07 {
vox t:vc211781 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_デッドセル２:プリスキン_000]
		//デッドセルはＳＥＡＬＳとは
		//言っても影の部隊だった。
	}
	talk ライデン 標準 -m {
		 [PS_デッドセル２:ライデン_001]
		//ああ。政府の重要施設を抜き打ちで
		//奇襲する部隊、だったか？
	}
	talk プリスキン 標準 -m {
		 [PS_デッドセル２:プリスキン_002]
		//そうだ。
		//元々は米軍設備の保安システムを
		//チェックするために設立されたんだ。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_デッドセル２:プリスキン_003]
		//前の大統領、ジョージ・シアーズの
		//肝いりでな。
	}
	talk プリスキン 標準 -m {
		 [PS_デッドセル２:プリスキン_004]
		//デルタフォースやＳＥＡＬＳといった、
		//対テロリスト部隊の対極に位置する
		//闇の組織……。
	}
}//v
}//d
proc rp_PS_デッドセル２＿２:07 {
vox t:vc211782 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PS_デッドセル２:ライデン_005]
		//奴等は初めから……その……
	}
	talk プリスキン 標準 -m {
		 [PS_デッドセル２:プリスキン_006]
		//凶人の集団。
	}
	talk ライデン 標準 -m {
		 [PS_デッドセル２:ライデン_007]
		//ああ。それだったのか？
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_デッドセル２:プリスキン_008]
		//いや。リーダーだったジャクソン大佐……
		//フォーチュンと言われている女の旦那が
		//投獄されたあたりからだろうな。
	}
	talk ライデン 標準 -m {
		 [PS_デッドセル２:ライデン_009]
		//投獄？一体何を？
	}
	talk プリスキン 標準 -m {
		 [PS_デッドセル２:プリスキン_010]
		//汚職。公金の横領。
	}
	talk ライデン 標準 -m {
		 [PS_デッドセル２:ライデン_011]
		//軍人としては不名誉極まりないな。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_デッドセル２:プリスキン_012]
		//世間の反応もお前と同じだったよ。
		//だがデッドセルの連中はそれを冤罪と
		//信じて疑わなかったようだ。
	}
	talk プリスキン 標準 -m {
		 [PS_デッドセル２:プリスキン_013]
		//何度か上層部に掛け合ったりもしたよう
		//だが、なぜか再審理は行われなかった。
	}
	talk ライデン 標準 -m {
		 [PS_デッドセル２:ライデン_014]
		//本当に冤罪だったのか？
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_デッドセル２:プリスキン_015]
		//さあな。真相は闇の中だ。
		//しかし事実はどうあれ、結果として
		//デッドセルの名は地に落ちた……。
	}
	talk ライデン 標準 -m {
		 [PS_デッドセル２:ライデン_016]
		//……で、そのジャクソン大佐は
		//どうなったんだ？
	}
	talk プリスキン 標準 -m {
		 [PS_デッドセル２:プリスキン_017]
		//レブンワース刑務所に収監されていた。
	}
	talk ライデン 標準 -m {
		 [PS_デッドセル２:ライデン_018]
		//いた？
		//出所したのか？
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_デッドセル２:プリスキン_019]
		//ああ。この世からな。
	}
	talk ライデン 標準 -m {
		 [PS_デッドセル２:ライデン_020]
		//え？
	}
	talk プリスキン 標準 -m {
		 [PS_デッドセル２:プリスキン_021]
		//獄死したんだ。衰弱死だったそうだが。
	}
	talk プリスキン 標準 -m {
		 [PS_デッドセル２:プリスキン_022]
		//リーダーを失うのと同時に
		//奴等は歯止めも見境も
		//なくしたらしい。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_デッドセル２:プリスキン_023]
		//それ以来デッドセルは先鋭化を続け
		//手のつけられない暴走をはじめた……。
	}
	talk ライデン 標準 -m {
		 [PS_デッドセル２:ライデン_024]
		//そのあげくがこのテロか？
	}
	talk プリスキン 標準 -m {
		 [PS_デッドセル２:プリスキン_025]
		//そうかもな。
	}
}//v
}//d


//フォーチュンについて h //e
//resource PS_フォーチュン１
proc rp_PS_フォーチュン１:07 {
vox t:vc211791 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PS_フォーチュン１:ライデン_000]
		//あの妙な女については何か知っているか？
	}
	talk プリスキン 標準 -m {
		 [PS_フォーチュン１:プリスキン_001]
		//フォーチュンのことか？
		//デッドセルのリーダーだ。
	}
	talk プリスキン 標準 -m {
		 [PS_フォーチュン１:プリスキン_002]
		//本名、ヘレナ・ドルフ・ジャクソン。
	}
	talk プリスキン 標準 -m {
		 [PS_フォーチュン１:プリスキン_003]
		//通称、幸運の女神……。
	}
	talk ライデン 標準 -m {
		 [PS_フォーチュン１:ライデン_003]
		//幸運の女神？
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_フォーチュン１:プリスキン_004]
		//そうとでも言うしかないだろう。
		//何しろ弾が当たらないんだ。
	}
	talk ライデン 標準 -m {
		 [PS_フォーチュン１:ライデン_005]
		//……。
	}
	talk プリスキン 標準 -m {
		 [PS_フォーチュン１:プリスキン_006]
		//だがその幸運は私生活の不運と
		//引き換えにしたものだと彼女は
		//言っているらしい。
	}
	talk ライデン 標準 -m {
		 [PS_フォーチュン１:ライデン_007]
		//不運？
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_フォーチュン１:プリスキン_008]
		//海兵隊司令官だった父親が死に、デッド
		//セルのリーダーだった旦那のジャクソン
		//大佐も横領でムショ送りになった。
	}
}//v
}//d

proc rp_PS_フォーチュン１＿２:07 {
vox t:vc211792 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_フォーチュン１:プリスキン_009]
		//まもなく夫の死と義理の息子の服役に
		//耐えかねたのか、母親が自殺。
	}
	talk プリスキン 標準 -m {
		 [PS_フォーチュン１:プリスキン_010]
		//フォーチュン自身もそのショックで当時
		//三ヶ月だった子供を流産。
		//とどめに夫もその数ヶ月後に獄死。
	}
	talk プリスキン 標準 -m {
		 [PS_フォーチュン１:プリスキン_011]
		//つまり父親の死からたった半年程の間に
		//彼女は家族と、それまで頼りにしていた
		//現実の全てを失ったというわけだ。
	}
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PS_フォーチュン１:ライデン_012]
		//……ひどい話だな。
	}
	talk プリスキン 標準 -m {
		 [PS_フォーチュン１:プリスキン_013]
		//だが彼女は悲嘆にくれるかわりに
		//軍に入った。
	}
	talk ライデン 標準 -m {
		 [PS_フォーチュン１:ライデン_014]
		//どうして？
	}
	talk プリスキン 標準 -m {
		 [PS_フォーチュン１:プリスキン_015]
		//さあな。復讐かもしれん。彼女は夫の
		//服役を冤罪だと信じていたらしい。
		//誰かにはめられた、と。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_フォーチュン１:プリスキン_016]
		//とにかく訓練を終える頃には彼女は
		//あの恐るべき強運を身につけていた。
	}
	talk プリスキン 標準 -m {
		 [PS_フォーチュン１:プリスキン_017]
		//そのために悪魔と取り引きしたとも
		//言われている。
	}
	talk ライデン 標準 -m {
		 [PS_フォーチュン１:ライデン_018]
		//悪魔……？
	}
	talk プリスキン 標準 -m {
		 [PS_フォーチュン１:プリスキン_019]
		//すぐにその力は知れ渡り、遂には死んだ
		//夫が率いていたデッドセルのリーダーに
		//収まったというわけだ。
	}
}//v
}//d
//ヴァンプとフォーチュン聞いていない場合 t //e
//resource PS_フォーチュン２
proc rp_PS_フォーチュン２:07 {
vox t:vc211801 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_フォーチュン２:プリスキン_000]
		//信望の厚かった元リーダーの未亡人だ。
		//暫定的にデッドセルをまとめていた
		//ヴァンプも喜んで彼女を迎えたらしい。
	}
	talk プリスキン 標準 -m {
		 [PS_フォーチュン２:プリスキン_001]
		//ま、奴にとっては元恋人の娘でもあった
		//わけだが。
	}
	talk ライデン 標準 -m {
		 [PS_フォーチュン２:ライデン_002]
		//ヴァンプとフォーチュンの母親が？
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_フォーチュン２:プリスキン_003]
		//いや、父親の方だ。
		//バイセクシャルなんだよ。
	}
	talk ライデン 標準 -m {
		 [PS_フォーチュン２:ライデン_004]
		//ぐ！いや待て。
		//だがヴァンプとフォーチュンは……
	}
	talk プリスキン 標準 -m {
		 [PS_フォーチュン２:プリスキン_005]
		//ふん。つまらんことに鼻がきくんだな。
	}
	talk ライデン 標準 -m {
		 [PS_フォーチュン２:ライデン_006]
		//いや……。
	}
}//v
}//d
//ヴァンプとフォーチュンへ t //e


//大統領警備隊の事 h //e
//resource PS_大統領警護隊１
proc rp_PS_大統領警護隊１:07 {
vox t:vc211811 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_大統領警護隊１:プリスキン_000]
		//敵に見つかると駆けつけてくる
		//増援部隊は元大統領警護隊の連中だ。
	}
	talk プリスキン 標準 -m {
		 [PS_大統領警護隊１:プリスキン_001]
		//奴らはシークレットサービスの中でも
		//精鋭と言われる、大統領警備課のＣＡＴ、
		//対襲撃部隊｛＃カウンター・アサルト・チーム｝＃の経験者達だ。
	}
	talk プリスキン 標準 -m {
		 [PS_大統領警護隊１:プリスキン_002]
		//お前よりも実戦経験は豊富だろうな。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_大統領警護隊１:プリスキン_003]
		//奴等の装備は前世紀末から陸軍で
		//開発されていたランドウォリアー
		//システムを基にしている。
	}
	talk プリスキン 標準 -m {
		 [PS_大統領警護隊１:プリスキン_004]
		//お前もフォース２１にいたなら知って
		//いるだろう。情報処理・通信能力と
		//生存性を向上させた新世代歩兵装備だ。
	}
	talk プリスキン 標準 -m {
		 [PS_大統領警護隊１:プリスキン_005]
		//歩兵をネットワーク端末の一つとして
		//位置づけ、その機能を満たすために
		//設計されている。
	}
	talk プリスキン 標準 -m {
		 [PS_大統領警護隊１:プリスキン_006]
		//ヘルメット・マウント・ディスプレイ
		//には各センサーや地図、指揮所からの
		//指示・指令等様々な情報が表示される。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_大統領警護隊１:プリスキン_007]
		//データリンクを通じて自分や見方の現在位置、再集結地点などをビデオや画像で
		//知ることも可能だ。
	}
	talk プリスキン 標準 -m {
		 [PS_大統領警護隊１:プリスキン_008]
		//その他、各種照準システム、バイオ
		//センサー、ＧＰＳ受信機、各種情報処理
		//機器などを装備している。
	}
	talk ライデン 標準 -m {
		 [PS_大統領警護隊１:ライデン_009]
		//ああ。だが実用化には装備の重量や
		//電子機器を動かすバッテリーの
		//持続時間が問題になっていたはずだ。
	}
	talk プリスキン 標準 -m {
		 [PS_大統領警護隊１:プリスキン_010]
		//そうだったな。だがバッテリーの
		//問題は銃撃にも耐え、液漏れしない
		//膜状バッテリーの開発で解決された。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_大統領警護隊１:プリスキン_011]
		//重量の問題もＤＡＲＰＡで開発されて
		//いた外骨格技術の人力増幅機能を使って
		//補っている。
	}
	talk プリスキン 標準 -m {
		 [PS_大統領警護隊１:プリスキン_012]
		//一見鈍重だが動きは素早いぞ。
	}
}//v
}//d
//resource PS_大統領警護隊２
proc rp_PS_大統領警護隊２:07 {
vox t:vc211821 {
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_大統領警護隊２:プリスキン_000]
		//元大統領警護隊の連中は全身を
		//セラミックプレート入りの防弾装備で
		//覆っている。
	}
	talk プリスキン 標準 -m {
		 [PS_大統領警護隊２:プリスキン_001]
		//頭部以外への攻撃は有効ではないだろう。
		//主観攻撃で頭を狙うんだ。
	}
	talk プリスキン 標準 -m {
		 [PS_大統領警護隊２:プリスキン_002]
		//まあ、敵に見つかりさせしなければ
		//奴等とはやりあわずに済むはずだ。
		//それにこしたことはない。
	}
}//v
}//d

//サイファーうんちく h //e
//resource PS_サイファー１
proc rp_PS_サイファー１:07 {
vox t:vc211831 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_サイファー１:プリスキン_000]
		//そこに飛んでいるのはサイファー。
		//陸上／海上監視・通信支援用の円盤型
		//ＵＡＶだ。
	}
	talk プリスキン 標準 -m {
		 [PS_サイファー１:プリスキン_001]
		//奇妙な形をしているが安定性は高い。
		//３．５ｍほどの隙間しかない場所での
		//垂直離着陸が可能だ。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_サイファー１:プリスキン_002]
		//完全自律動作でマンサイズターゲットの
		//補足・追跡ができる。
	}
}//v
}//d
//二回目以降 t //e
//resource PS_サイファー２
proc rp_PS_サイファー２:07 {
vox t:vc211841 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_サイファー２:プリスキン_000]
		//チャフを使えばサイファーのセンサーを
		//撹乱出来るだろう。行動を妨害し、
		//指揮所へのデータ送信も阻止できる。
	}
}//v
}//d
//resource PS_サイファー３
proc rp_PS_サイファー３:07 {
vox t:vc211851 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_サイファー３:プリスキン_000]
		//サイファーは機の状況とミッション
		//データをデータリンクで指揮所に
		//送信している。
	}
	talk プリスキン 標準 -m {
		 [PS_サイファー３:プリスキン_001]
		//サイファーに見つかることは敵に見つかることと同じだ。視界には入らないように気をつけろ。
	}
}//v
}//d


//ＳＥＡＬＳについて h //e
//resource PS_ＳＥＡＬＳ
proc rp_PS_ＳＥＡＬＳ:07 {
vox t:vc211861 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PS_ＳＥＡＬＳ:ライデン_000]
		//プリスキン、ＳＥＡＬ１０のブラボー
		//チームが全滅した……。
	}
	talk プリスキン 標準 -m {
		 [PS_ＳＥＡＬＳ:プリスキン_001]
		//そうか。
	}
	talk ライデン 標準 -m {
		 [PS_ＳＥＡＬＳ:ライデン_002]
		//そうかって？
		//あんたの仲間だろ？
	}
	talk プリスキン 標準 -m {
		 [PS_ＳＥＡＬＳ:プリスキン_003]
		//ああ、残念なことだ。
	}
	talk ライデン 標準 -m {
		 [PS_ＳＥＡＬＳ:ライデン_004]
		//……全ては俺を潜入させるための
		//陽動作戦だったらしい。知ってたか？
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ＳＥＡＬＳ:プリスキン_005]
		//いや……。
		//だがありそうな話ではあるな。
	}
	talk ライデン 標準 -m {
		 [PS_ＳＥＡＬＳ:ライデン_006]
		//……ずいぶん冷たいんだな。
		//自分の仲間が……。
	}
@rp_うなづきデフォルト＿是
@rp_邪道外道＿否２＿ひどい系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_ＳＥＡＬＳ:プリスキン_007]
		//ではお前は俺の仲間を殺したクソ野郎だ、
		//と言えばいいのか？
	}
	talk プリスキン 標準 -m {
		 [PS_ＳＥＡＬＳ:プリスキン_008]
		//それともお前のせいじゃないと
		//言ってほしいのか？
	}
	talk ライデン 標準 -m {
		 [PS_ＳＥＡＬＳ:ライデン_009]
		//そんな……。
	}
	talk プリスキン 標準 -m {
		 [PS_ＳＥＡＬＳ:プリスキン_010]
		//悪いが俺にはお前の罪悪感だか
		//自己憐憫だかにつきあってる暇は
		//ないんだ。
	}
	talk プリスキン 標準 -m {
		 [PS_ＳＥＡＬＳ:プリスキン_011]
		//そんなものは自分で処理しとけ。
		//甘えるな。
	}
}//v
}//d


//海軍大佐とブラックケースについて h //e
//resource PS_海軍大佐１
proc rp_PS_海軍大佐１:07 {
vox t:vc211871 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PS_海軍大佐１:ライデン_000]
		//プリスキン、あんた海軍大佐に
		//注目してたな。何かあるのか？
	}
}//v
}//d
//海軍大佐の図のムービー t //e
//resource PS_海軍大佐２
proc rp_PS_海軍大佐２:07 {
vox t:vc211881 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_海軍大佐２:プリスキン_000]
		//ああ。手錠が切断されていただろう。
		//その先にあったはずのものがな……。
	}
	talk ライデン 標準 -m {
		 [PS_海軍大佐２:ライデン_001]
		//なんだ？
	}
@rp_かみあわない＿否１＿話聞けよ系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_海軍大佐２:プリスキン_002]
		//おそらく……いや、なんでもない。
		//気にするな。
	}
}//v
}//d
//気にするなの後 t //e
//resource PS_気にするな
proc rp_PS_気にするな:07 {
vox t:vc211891 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PS_気にするな:ライデン_000]
		//あのな、そういう言い方されて
		//どうやれば気にしないですむって
		//言うんだ？
	}
	talk プリスキン 標準 -m {
		 [PS_気にするな:プリスキン_001]
		//そうだな。
		//気にしなければいいんじゃないか？
	}
	talk ライデン 標準 -m {
		 [PS_気にするな:ライデン_002]
		//な……！
	}
	talk プリスキン 標準 -m {
		 [PS_気にするな:プリスキン_003]
		//ふん。じゃあな。
	}
}//v
}//d

//スネークの事 h //e
//resource PS_プリスキン自身
proc rp_PS_プリスキン自身:07 {
vox t:vc211901 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PS_プリスキン自身:ライデン_000]
		//プリスキン……あんたほんとに
		//ＳＥＡＬＳなのか？
	}
	talk プリスキン 標準 -m {
		 [PS_プリスキン自身:プリスキン_001]
		//そう言っただろう。
	}
	talk ライデン 標準 -m {
		 [PS_プリスキン自身:ライデン_002]
		//だが……。
	}
	talk プリスキン 標準 -m {
		 [PS_プリスキン自身:プリスキン_003]
		//なんだ？
	}
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PS_プリスキン自身:ライデン_004]
		//いや……。（気が弱いので言い出せない）
	}
	talk プリスキン 標準 -m {
		 [PS_プリスキン自身:プリスキン_005]
		//ふん。作戦行動中に余計なことを
		//考えていると死ぬぞ。
		//自分の任務に集中しろ。いいな。
	}
}//v
}//d


//オルガデモ後 d //e
//オルガ h //e
//resource PS_オルガ
proc rp_PS_オルガ:07 {
vox t:vc211911 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_オルガ:プリスキン_000]
		//ライデン、あのオルガという女には
		//気をつけろ。
	}
	talk プリスキン 標準 -m {
		 [PS_オルガ:プリスキン_001]
		//オルガ・ゴルルコビッチ。元ＧＲＵで
		//スペツナズの隊長も務めたセルゲイ・
		//ゴルルコビッチ大佐の娘……。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_オルガ:プリスキン_002]
		//彼女が『ビッグ・シェル』の中を
		//うろついてるロシア私兵部隊の
		//リーダーだ。
	}
	talk プリスキン 標準 -m {
		 [PS_オルガ:プリスキン_003]
		//父親の組織した部隊を彼の死後受け継ぎ、
		//完全に掌握している。
	}
	talk プリスキン 標準 -m {
		 [PS_オルガ:プリスキン_004]
		//彼女の父親、ゴルルコビッチ大佐は
		//旧ソ連であらゆる軍人の目標として
		//尊敬を集めていた人物だったらしい。
	}
	talk ライデン 標準 -m {
		 [PS_オルガ:ライデン_005]
		//そんな軍人がなぜ私兵部隊を？
	}
	talk プリスキン 標準 -m {
		 [PS_オルガ:プリスキン_006]
		//連邦の崩壊によって、たくさんの
		//軍人が食い扶持を失った。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_オルガ:プリスキン_007]
		//その中には、いきなり世間に放り出され、
		//行く当てもなく途方にくれる連中も
		//多かったらしい。
	}
	talk プリスキン 標準 -m {
		 [PS_オルガ:プリスキン_008]
		//大佐はそんな奴等の身柄を
		//引き受けたんだ。
	}
	talk プリスキン 標準 -m {
		 [PS_オルガ:プリスキン_009]
		//そして傭兵部隊を組織し、世界各地の
		//紛争地帯を転戦した。ロシアの再興を
		//夢見ながらな。
	}
	talk プリスキン 標準 -m {
		 [PS_オルガ:プリスキン_010]
		//シャドーモセス事件で大佐がリキッド・
		//スネークの蜂起に部隊を合流させようと
		//していたという話もあるが……
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_オルガ:プリスキン_011]
		//それも祖国の再建を目論んでのこと
		//だったらしい。
	}
	talk プリスキン 標準 -m {
		 [PS_オルガ:プリスキン_012]
		//リキッドの腹心だったオセロットとは
		//旧ソ連時代からの仲らしいな。
	}
	talk プリスキン 標準 -m {
		 [PS_オルガ:プリスキン_013]
		//オルガはそんな父親の持っていた軍人と
		//しての優れた資質を受け継ぎ、それを
		//伸ばしてきたようだ。
	}
	talk プリスキン 標準 -m {
		 [PS_オルガ:プリスキン_014]
		//言わば戦場で生まれ育った女。
		//見た目通り気も強い。
		//デートに誘うには覚悟がいるだろうな。
	}
	talk ライデン 標準 -m {
		 [PS_オルガ:ライデン_015]
		//何か、会ったことがあるような
		//口振りだな。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_オルガ:プリスキン_016]
		//いいや。そんなことはない。
		//とにかくあの女には気をつけろ。
		//いいな。
	}
}//v
}//d



//忍者接触後 h //e
//忍者 h //e
//resource PS_ファットマン戦後＿忍者
proc rp_PS_ファットマン戦後＿忍者:07 {
vox t:vc211921 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PS_ファットマン戦後＿忍者:ライデン_000]
		//プリスキン、聞こえるか？
	}
	talk プリスキン 標準 -m {
		 [PS_ファットマン戦後＿忍者:プリスキン_001]
		//どうした、ライデン？
	}
	talk ライデン 標準 -m {
		 [PS_ファットマン戦後＿忍者:ライデン_002]
		//実は……忍者の格好をした男に出会った。
	}
	talk プリスキン 標準 -m {
		 [PS_ファットマン戦後＿忍者:プリスキン_003]
		//忍者？
	}
	talk ライデン 標準 -m {
		 [PS_ファットマン戦後＿忍者:ライデン_004]
		//ああ、心当たりは？
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ファットマン戦後＿忍者:プリスキン_005]
		//いや、ない。
		//お前、そのコスプレ野郎を信じるのか？
	}
	talk ライデン 標準 -m {
		 [PS_ファットマン戦後＿忍者:ライデン_006]
		//他に手がかりもないんだ。
		//大佐も奴のいうことに従えと……。
	}
	talk プリスキン 標準 -m {
		 [PS_ファットマン戦後＿忍者:プリスキン_007]
		//ふん。聞き分けのいいことだな。
	}
	talk プリスキン 標準 -m {
		 [PS_ファットマン戦後＿忍者:プリスキン_008]
		//だがこれだけは言っておく。シャドー
		//モセスで公になった忍者はもう存在
		//しない。お前が会ったのは奴ではない。
	}
	talk ライデン 標準 -m {
		 [PS_ファットマン戦後＿忍者:ライデン_009]
		//なぜそう言い切れる？
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ファットマン戦後＿忍者:プリスキン_010]
		//ありえないからだ。
	}
	talk ライデン 標準 -m {
		 [PS_ファットマン戦後＿忍者:ライデン_011]
		//……。
	}
	talk プリスキン 標準 -m {
		 [PS_ファットマン戦後＿忍者:プリスキン_012]
		//気をつけろよ。いいな。
	}
}//v
}//d

//エイムズについて h //e
//resource PS_ファットマン戦後＿エイムズ
proc rp_PS_ファットマン戦後＿エイムズ:07 {
vox t:vc211931 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PS_ファットマン戦後＿エイムズ:ライデン_000]
		//プリスキン、エイムズという
		//シークレット・サービスについて
		//何か知らないか？
	}
	talk プリスキン 標準 -m {
		 [PS_ファットマン戦後＿エイムズ:プリスキン_001]
		//エイムズ？
	}
	talk ライデン 標準 -m {
		 [PS_ファットマン戦後＿エイムズ:ライデン_002]
		//知っているのか？
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ファットマン戦後＿エイムズ:プリスキン_003]
		//いや……。
	}
	talk ライデン 標準 -m {
		 [PS_ファットマン戦後＿エイムズ:ライデン_004]
		//何か知っているのなら……。
	}
	talk プリスキン 標準 -m {
		 [PS_ファットマン戦後＿エイムズ:プリスキン_005]
		//いや、まさかな。人違いだろう。
		//気にするな。
	}
}//v
}//d

//エイムズ後 d //e
//エイムズについて h //e
//resource PS_エイムズ後＿エイムズ
proc rp_PS_エイムズ後＿エイムズ:07 {
vox t:vc211941 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_エイムズ後＿エイムズ:プリスキン_000]
		//そういえばエイムズと言う名、どこかで
		//聞いたと思ったんだが……ＤＩＡという
		//ことはやはりナスターシャの元旦那だ。
	}
	talk ライデン 標準 -m {
		 [PS_エイムズ後＿エイムズ:ライデン_001]
		//ナスターシャ？
		//ナスターシャ・ロマネンコか？
		//『シャドーモセスの真実』を書いた？
	}
}//v
}
proc rp_PS_エイムズ後＿エイムズ２:07 {
vox t:vc211942 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_エイムズ後＿エイムズ:プリスキン_002]
		//ああ。
		//シャドーモセスの時は色々とサポート
		//してくれた。
	}
	talk プリスキン 標準 -m {
		 [PS_エイムズ後＿エイムズ:プリスキン_003]
		//事件の後、フィランソロピーの組織にも
		//一役買ってくれている。
	}
}//v
}
proc rp_PS_エイムズ後＿エイムズ３:07 {
vox t:vc211943 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PS_エイムズ後＿エイムズ:ライデン_004]
		//彼女は今？
	}
	talk プリスキン 標準 -m {
		 [PS_エイムズ後＿エイムズ:プリスキン_005]
		//さてな。だがヘビースモーカーで
		//あることには変わりない。
	}
}//v
}//d

//ＯＵＴＥＲ　ＨＥＡＶＥＮについて h //e
//resource PS_アウターヘブン
proc rp_PS_アウターヘブン:07 {
vox t:vc211951 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PS_アウターヘブン:ライデン_000]
		//あんた、ＯＵＴＥＲ　ＨＥＡＶＥＮと
		//いうのを聞いたことがあるか？
	}
	talk プリスキン 標準 -m {
		 [PS_アウターヘブン:プリスキン_001]
		//ＯＵＴＥＲ　ＨＥＡＶＥＮ！？
	}
	talk ライデン 標準 -m {
		 [PS_アウターヘブン:ライデン_002]
		//知っているのか？
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_アウターヘブン:プリスキン_003]
		//いや……。
		//それがどうかしたのか？
	}
	talk ライデン 標準 -m {
		 [PS_アウターヘブン:ライデン_004]
		//テロリストのボスが口にしたんだ。
		//ＯＵＴＥＲ　ＨＥＡＶＥＮ再興まで
		//あと少しだ、と……。
	}
	talk プリスキン 標準 -m {
		 [PS_アウターヘブン:プリスキン_005]
		//……そうか……。
	}
	talk ライデン 標準 -m {
		 [PS_アウターヘブン:ライデン_006]
		//何か知っているか？
	}
	talk プリスキン 標準 -m {
		 [PS_アウターヘブン:プリスキン_007]
		//いや。だが奴等が何を望むにせよ、
		//どうせろくでもないものに違いない。
		//……思うようにさせるわけにはいかん。
	}
	talk ライデン 標準 -m {
		 [PS_アウターヘブン:ライデン_008]
		//……ああ……そうだな……。
	}
}//v
}//d

//赤外線センサー d //e
//セムテックスうんちく h //e
//resource PS_セムテックスうんちく
proc rp_PS_セムテックスうんちく:07 {
vox t:vc211961 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_セムテックスうんちく:プリスキン_000]
		//そのトラップに使われてる爆弾は
		//セムテックス。Ｃ４と同じような
		//プラスティック爆薬だ。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_セムテックスうんちく:プリスキン_001]
		//旧チェコスロバキアで開発され、
		//冷戦時代には「テロリストのＣ４」とも
		//呼ばれた。
	}
	talk プリスキン 標準 -m {
		 [PS_セムテックスうんちく:プリスキン_002]
		//ＲＤＸとＰＥＴＮで出来た、扱いやすく
		//強力な爆薬だ。あたり一面木っ端微塵に
		//なるぞ。絶対に爆発させるな。

	}
}//v
}//d

//ハリアー戦中 d //e
//ハリアーうんちく h //e
//resource PS_ハリアー戦＿ハリアー
proc rp_PS_ハリアー戦＿ハリアー:07 {
vox t:vc211971 {
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk オタコン 標準 -m {
		 [PS_ハリアー戦＿ハリアー:オタコン_000]
		//ハリアー２は世界初の実用Ｖ／ＳＴＯＬ
		//攻撃機ハリアーの発展型だ。
	}
	talk オタコン 標準 -m {
		 [PS_ハリアー戦＿ハリアー:オタコン_001]
		//機体側面にあるエンジンノズルの
		//推力線を変えることで垂直短距離
		//離着陸を可能にしている。
	}
	talk オタコン 標準 -m {
		 [PS_ハリアー戦＿ハリアー:オタコン_002]
		//ハリアー２はハリアーに比べてエンジン
		//吹出し口の改良等でペイロードが
		//かなり拡大してるんだ。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk オタコン 標準 -m {
		 [PS_ハリアー戦＿ハリアー:オタコン_003]
		//そのおかげで武装も大幅に増えている。
	}
	talk オタコン 標準 -m {
		 [PS_ハリアー戦＿ハリアー:オタコン_004]
		//胴体パイロンに２５ｍｍ機関砲ポッドを
		//装備。
	}
	talk オタコン 標準 -m {
		 [PS_ハリアー戦＿ハリアー:オタコン_005]
		//両翼に対地攻撃用ロケット弾、
		//空対空ミサイル、クラスター爆弾の
		//各種ポッドを装備している。
	}
	talk オタコン 標準 -m {
		 [PS_ハリアー戦＿ハリアー:オタコン_006]
		//当然小火器なんかで撃ち落とせる
		//相手じゃない。スティンガーを使うんだ。
	}
}//v
}//d
//ハリアークラスター爆弾 h //e
//resource PS_ハリアー戦＿クラスター爆弾１
proc rp_PS_ハリアー戦＿クラスター爆弾１:07 {
vox t:vc211981 {
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		 [PS_ハリアー戦＿クラスター爆弾１:オタコン_000]
		//ライデン、ハリアーのクラスター爆弾に
		//気をつけてくれ。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk オタコン 標準 -m {
		 [PS_ハリアー戦＿クラスター爆弾１:オタコン_001]
		//クラスター爆弾は非誘導爆弾の一種で
		//弾体内部に数十から数百の小型爆弾を
		//内蔵した広域攻撃兵器だ。
	}
	talk オタコン 標準 -m {
		 [PS_ハリアー戦＿クラスター爆弾１:オタコン_002]
		//投下されると時限信管などで起爆。
		//内壁が爆発・分離して子弾を広範囲に
		//ばらまく。
	}
}//v
}//d
//二回目以降 t //e
//resource PS_ハリアー戦＿クラスター爆弾２
proc rp_PS_ハリアー戦＿クラスター爆弾２:07 {
vox t:vc211991 {
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		 [PS_ハリアー戦＿クラスター爆弾２:オタコン_000]
		//クラスター爆弾の攻撃範囲はすごく広い。
		//撃たれたらすぐに連絡橋の下の階に
		//逃げるんだ。いいね。
	}
}//v
}//d
//ハリアーアムラーム h //e
//resource PS_ハリアー戦＿アムラーム１
proc rp_PS_ハリアー戦＿アムラーム１:07 {
vox t:vc212001 {
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		 [PS_ハリアー戦＿アムラーム１:オタコン_000]
		//そのハリアー２は中距離空対空ミサイル、
		//アムラームを装備している。
	}
	talk オタコン 標準 -m {
		 [PS_ハリアー戦＿アムラーム１:オタコン_001]
		//アムラームはスパローの後継として
		//設計されたアクティブ・ホーミング・
		//ミサイルだ。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk オタコン 標準 -m {
		 [PS_ハリアー戦＿アムラーム１:オタコン_002]
		//目標近くへ接近し終端誘導段階になると
		//アクティブシーカーで目標をロックオン
		//して完全自律モードで飛行する。
	}
	talk オタコン 標準 -m {
		 [PS_ハリアー戦＿アムラーム１:オタコン_003]
		//つまり発射後に誘導を必要とないんだ。
		//いわゆる「撃ちっぱなし」。
	}
	talk オタコン 標準 -m {
		 [PS_ハリアー戦＿アムラーム１:オタコン_004]
		//ミサイル発射後の即時離脱が可能に
		//なって母機の生還確率が上がるって
		//いう利点がある。
	}
	talk オタコン 標準 -m {
		 [PS_ハリアー戦＿アムラーム１:オタコン_005]
		//アムラームは機動性もアクティブシーカー
		//の性能も高い。一度撃たれたら回避する
		//のは難しいだろう。
	}
	talk ライデン 標準 -m {
		 [PS_ハリアー戦＿アムラーム１:ライデン_006]
		//どうすれば？
	}
@rp_うなづきデフォルト＿是
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk オタコン 標準 -m {
		 [PS_ハリアー戦＿アムラーム１:オタコン_007]
		//チャフ・グレネードを使えばいい。
	}
	talk オタコン 標準 -m {
		 [PS_ハリアー戦＿アムラーム１:オタコン_008]
		//アムラームはＥＣＭへの耐性も
		//強化されていて電子妨害をかけても
		//その発信源に向かって誘導をかけてくる。
	}
	talk オタコン 標準 -m {
		 [PS_ハリアー戦＿アムラーム１:オタコン_009]
		//でもそれは対航空機の話だ。人間相手に
		//そこまで精密な誘導は出来ないはず。
	}
}//v
}//d

//番号ないよーＸＸＸＸＸＸＸＸＸ
//二回目以降 t //e
//resource PS_ハリアー戦＿アムラーム２
proc rp_PS_ハリアー戦＿アムラーム２:07 {
vox t:vc212011 {
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		 [PS_ハリアー戦＿アムラーム２:オタコン_000]
		//チャフ・グレネードを使えば
		//充分撹乱出来るだろう。アムラームを
		//撃たれたらチャフを使うんだ。
	}
}//v
}//d
//ハリアー機銃 h //e
//resource PS_ハリアー戦＿機銃１
proc rp_PS_ハリアー戦＿機銃１:07 {
vox t:vc212021 {
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		 [PS_ハリアー戦＿機銃１:オタコン_000]
		//ハリアー２は胴体パイロンに
		//２５ｍｍ機銃ポッドを装備している。
	}
	talk オタコン 標準 -m {
		 [PS_ハリアー戦＿機銃１:オタコン_001]
		//発射速度は毎分３８００発。
		//砲口初速は秒速１０００ｍ以上。
		//まともに食らったら駄目だ。
	}
}//v
}//d
//二回目以降 t //e
//resource PS_ハリアー戦＿機銃２
proc rp_PS_ハリアー戦＿機銃２:07 {
vox t:vc212031 {
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		 [PS_ハリアー戦＿機銃２:オタコン_000]
		//ハリアーが機銃を撃ってきたらすぐに
		//遮蔽物に隠れるんだ。いいね。
	}
}//v
}//d
//ロケットランチャー h //e
//resource PS_ハリアー戦＿ロケット１
proc rp_PS_ハリアー戦＿ロケット１:07 {
vox t:vc212041 {
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		 [PS_ハリアー戦＿ロケット１:オタコン_000]
		//ハリアー２は両翼に対地攻撃用の
		//ロケット弾ポッドも装備している。
	}
}//v
}//d
//resource PS_ハリアー戦＿ロケット２
proc rp_PS_ハリアー戦＿ロケット２:07 {
vox t:vc212051 {
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		 [PS_ハリアー戦＿ロケット２:オタコン_000]
		//ロケット弾は無誘導だ。
		//撃たれてもすぐにその場から
		//移動すれば回避出来るはずだ。
	}
}//v
}//d


//カサッカうんちく h //e
//resource PS_ハリアー戦＿カサッカ
proc rp_PS_ハリアー戦＿カサッカ:07 {
vox t:vc212061 {
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		 [PS_ハリアー戦＿カサッカ:オタコン_000]
		//僕らが乗っているヘリはＫａ−６０
		//カサッカ。ロシア・カモフ設計局製の
		//軍用多目的ヘリコプターだ。
	}
	talk オタコン 標準 -m {
		 [PS_ハリアー戦＿カサッカ:オタコン_001]
		//歩兵・武器弾薬の輸送、負傷兵の後送、
		//攻撃ヘリのためのターゲット補足、
		//全天候偵察等、様々な任務に対応可能。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk オタコン 標準 -m {
		 [PS_ハリアー戦＿カサッカ:オタコン_002]
		//先進アビオニクスと電子装備を
		//追加すれば無線・電子妨害作戦や
		//特殊任務もに耐えられるんだ。
	}
	talk オタコン 標準 -m {
		 [PS_ハリアー戦＿カサッカ:オタコン_003]
		//戦闘時の生存性がかなり重視されてて、
		//主要システムは冗長性を持ったつくりに
		//なってる。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk オタコン 標準 -m {
		 [PS_ハリアー戦＿カサッカ:オタコン_004]
		//回転翼は複数の穴が開いても機能するし、
		//燃料タンクにはポリウレタンが充填して
		//あって爆発の危険性を少なくしてある。
	}
	talk オタコン 標準 -m {
		 [PS_ハリアー戦＿カサッカ:オタコン_005]
		//とはいっても、ハリアーに対して
		//まともに対抗出来るわけじゃない。
		//君の援護をするのが精一杯だと思う。
	}
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		 [PS_ハリアー戦＿カサッカ:オタコン_006]
		//あまり期待はしないでくれ。
		//ハリアーは君が撃墜するんだ。
		//頼む。
	}
}//v
}//d



//ハリアー戦後 d //e
//メタルギア拡散について h //e
//resource PS_メタルギア拡散
proc rp_PS_メタルギア拡散:07 {
vox t:vc212071 {
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		 [PS_メタルギア拡散:オタコン_000]
		//大統領の言った通りメタルギアＲＡＹは
		//対メタルギア兵器として作られたものだ。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk オタコン 標準 -m {
		 [PS_メタルギア拡散:オタコン_001]
		//シャドーモセス事件で、オセロットは
		//メタルギアＲＥＸと新型核弾頭の演習
		//データが入ったディスクを持ち帰った。
	}
	talk オタコン 標準 -m {
		 [PS_メタルギア拡散:オタコン_002]
		//でもそれだけじゃない。彼はそれを
		//売ってまわったんだ。
		//核保有国だけじゃなく第三国にまでね。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk オタコン 標準 -m {
		 [PS_メタルギア拡散:オタコン_003]
		//データを手に入れた国はそれをもとに
		//してそれぞれ、メタルギアの開発を
		//始めている。
	}
	talk オタコン 標準 -m {
		 [PS_メタルギア拡散:オタコン_004]
		//どうなると思う？メタルギアの亜種が
		//世界中に溢れたら？また核抑止の時代が
		//訪れかねない。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk オタコン 標準 -m {
		 [PS_メタルギア拡散:オタコン_005]
		//僕らがフィランソロピーを組織した
		//理由もそこにあるんだ。
	}
	talk オタコン 標準 -m {
		 [PS_メタルギア拡散:オタコン_006]
		//フォーチュンの父親でもある
		//海兵隊司令官スコット・ドルフも
		//そのあたりを危惧していたらしい。
	}
	talk オタコン 標準 -m {
		 [PS_メタルギア拡散:オタコン_007]
		//だからメタルギアに対抗する兵器として
		//メタルギアＲＡＹの開発を進めて
		//いたんだ。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk オタコン 標準 -m {
		 [PS_メタルギア拡散:オタコン_008]
		//勿論、単独で海からの接敵・攻撃・
		//離脱を可能にするメタルギアＲＡＹは
		//抜本的な戦術転換すらもたらす兵器だ。
	}
	talk オタコン 標準 -m {
		 [PS_メタルギア拡散:オタコン_009]
		//緊急即応部隊としての重要性が薄れて
		//きたと言われる海兵隊に権益を取り戻すっ
		//ていう目的もあったんだろうけどね。
	}
}//v
}//d


//水中機雷うんちく h //e
//resource PS_水中機雷＿うんちく
proc rp_PS_水中機雷＿うんちく:07 {
vox t:vc212081 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_水中機雷＿うんちく:プリスキン_000]
		//その水中機雷は加速度や水圧の変化・
		//体温などを感知する複合センサーを
		//内臓していると思われる。
	}
	talk プリスキン 標準 -m {
		 [PS_水中機雷＿うんちく:プリスキン_001]
		//少し触れただけでも爆発するぞ。
		//気をつけるんだ。
	}
}//v
}//d

//ピーターの死体近く h //e
//resource PS_ピーター死体
proc rp_PS_ピーター死体:07 {
vox t:vc212091 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PS_ピーター死体:ライデン_000]
		//スネーク、スティルマンだ。
		//スティルマンがここに……
	}
	talk プリスキン 標準 -m {
		 [PS_ピーター死体:プリスキン_001]
		//そうか。
	}
	talk ライデン 標準 -m {
		 [PS_ピーター死体:ライデン_002]
		//俺を待っていた。
	}
	talk プリスキン 標準 -m {
		 [PS_ピーター死体:プリスキン_003]
		//……ああ。
	}
}//v
}//d

//ヴァンプ戦 d //e
//影縫いについて h //e
//resource PS_ヴァンプ戦＿影縫い１
proc rp_PS_ヴァンプ戦＿影縫い１:07 {
vox t:vc212101 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PS_ヴァンプ戦＿影縫い１:ライデン_000]
		//奴のナイフが影に刺さると
		//体が動かなくなるんだ！
	}
	talk プリスキン 標準 -m {
		 [PS_ヴァンプ戦＿影縫い１:プリスキン_001]
		//影縫い？忍術か？
	}
	@rpd_オタコン顔表示
	talk オタコン 標準 -m {
		 [PS_ヴァンプ戦＿影縫い１:オタコン_002]
		//いや、多分一種の催眠術だろうね。
	}
	talk ライデン 標準 -m {
		 [PS_ヴァンプ戦＿影縫い１:ライデン_003]
		//催眠術？
	}
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		 [PS_ヴァンプ戦＿影縫い１:オタコン_004]
		//ああ。ナイフを投げる瞬間の声と動きや
		//刃に当たる光の反射を利用して強烈な
		//暗示をかけているんだと思う。
	}
	talk ライデン 標準 -m {
		 [PS_ヴァンプ戦＿影縫い１:ライデン_005]
		//どうすればいい！？
	}
	talk オタコン 標準 -m {
		 [PS_ヴァンプ戦＿影縫い１:オタコン_006]
		//暗示自体を無効にするのは難しいだろう。
		//影にナイフをさされないように気を
		//つけるしかないね。
	}
}//v
}//d
//resource PS_ヴァンプ戦＿影縫い２
proc rp_PS_ヴァンプ戦＿影縫い２:07 {
vox d:_vc212111 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ヴァンプ戦＿影縫い２:プリスキン_000]
		//ライデン、自分の影にも気をつけろ。
		//奴の投げたナイフが影に刺されば
		//しばらく体が動かなくなる。
	}
	talk プリスキン 標準 -m {
		 [PS_ヴァンプ戦＿影縫い２:プリスキン_001]
		//体が動かなくなったら、とにかく
		//左スティックとボタンを連打して
		//呪縛を断ち切るしかない。
	}
}//v
}//d
//resource PS_ヴァンプ戦＿影縫い３
proc rp_PS_ヴァンプ戦＿影縫い３:07 {
vox t:vc212121 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ヴァンプ戦＿影縫い３:プリスキン_000]
		//ライトを壊せば影自体が出なくなる。
		//奴に影を縫われる恐れもなくなるだろう。
		//ライトを壊せ。
	}
}//v
}//d

//赤外線ゴーグル使え h //e
//resource PS_ヴァンプ戦＿水中赤外線ゴーグル
proc rp_PS_ヴァンプ戦＿水中赤外線ゴーグル:07 {
vox t:vc212131 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ヴァンプ戦＿水中赤外線ゴーグル:プリスキン_000]
		//奴が水中に潜ったら赤外線ゴーグルを
		//装備するんだ。
	}
	talk プリスキン 標準 -m {
		 [PS_ヴァンプ戦＿水中赤外線ゴーグル:プリスキン_001]
		//そうすれば奴がどこにどこにいるか
		//わかる。グレネードを投げ込め。
	}
}//v
}//d

//ヴァンプ戦後 d //e
//純粋水爆 h //e
//resource PS_ヴァンプ戦後＿純粋水爆
proc rp_PS_ヴァンプ戦後＿純粋水爆:07 {
vox t:vc212141 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PS_ヴァンプ戦後＿純粋水爆:ライデン_000]
		//ヴァンプが言っていた
		//純粋水爆というのは？
	}
	talk オタコン 標準 -m {
		 [PS_ヴァンプ戦後＿純粋水爆:オタコン_001]
		//純粋水爆は核融合反応を発生させるのに
		//核爆発を使わない核兵器だ。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk オタコン 標準 -m {
		 [PS_ヴァンプ戦後＿純粋水爆:オタコン_002]
		//純粋水爆の動作原理には二種類あって、
		//そのうち我が国で研究されているのは
		//「レーザー慣性圧縮方式」という方式。
	}
	talk オタコン 標準 -m {
		 [PS_ヴァンプ戦後＿純粋水爆:オタコン_003]
		//原理的にはレーザー核融合と同じだ。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk オタコン 標準 -m {
		 [PS_ヴァンプ戦後＿純粋水爆:オタコン_004]
		//重水素と三重水素を極低温で固化した
		//燃料ペレットに高出力のレーザーを
		//照射する。
	}
	talk オタコン 標準 -m {
		 [PS_ヴァンプ戦後＿純粋水爆:オタコン_005]
		//するとペレットの表面が蒸発、
		//その反作用でペレットは内向きに
		//圧縮される。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk オタコン 標準 -m {
		 [PS_ヴァンプ戦後＿純粋水爆:オタコン_006]
		//それでペレットの中心部が核融合の
		//閉じこめ条件を満たす高温・高圧に
		//到達して、核融合反応が生じるんだ。
	}
	talk オタコン 標準 -m {
		 [PS_ヴァンプ戦後＿純粋水爆:オタコン_007]
		//前世紀末から研究は進んでいたんだけど、
		//超高出力のレーザーが小型化がうまく
		//いかずにいたはず……。
	}
	talk オタコン 標準 -m {
		 [PS_ヴァンプ戦後＿純粋水爆:オタコン_008]
		//それがもう実用段階にあったとはね……。
	}
}//v
}//d


//エマ救出後 d //e
//エマとオタコンの会話１ h //e
//resource PS_エマ救出後＿兄妹喧嘩１＿１
proc rp_PS_エマ救出後＿兄妹喧嘩１＿１:07 {
vox t:vc212151 {
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩１＿１:オタコン_000]
		//いいかい、ライデン。
		//エマと話させてくれ？
	}
	talk ライデン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩１＿１:ライデン_001]
		//喧嘩はよせよ。
	}
	talk オタコン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩１＿１:オタコン_002]
		//ああ、わかってる。
	}
}//v
}//d
//resource PS_エマ救出後＿兄妹喧嘩１＿２
proc rp_PS_エマ救出後＿兄妹喧嘩１＿２:07 {
vox t:vc212161 {
mindds		// うなづき禁止ＸＸＸＸＸＸＸＸＸＸｘ
	talk オタコン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩１＿２:オタコン_000]
		//ＥＥかい？
	}
	talk エマ 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩１＿２:エマ_001]
		//ええ。なに？
	}
	talk オタコン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩１＿２:オタコン_002]
		//どうして、兵器開発なんかに
		//手を貸したんだ？
	}
	talk エマ 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩１＿２:エマ_003]
		//……。
	}
	talk オタコン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩１＿２:オタコン_004]
		//多くの人が傷つくんだ、
		//大勢の人が死ぬんだぞ。
	}
	talk オタコン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩１＿２:オタコン_005]
		//家や街が破壊される……
		//何世紀にも渡って汚染される。
		//核兵器の恐ろしさは知ってるはずだ？
	}
	talk オタコン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩１＿２:オタコン_006]
		//僕たちの呪われた家系も。
		//ＥＥ……どうしてなんだ？
	}
	talk エマ 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩１＿２:エマ_007]
		//あなたは私を捨てた。
		//私を地獄に突き落とした……。
	}
	talk オタコン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩１＿２:オタコン_008]
		//あれは仕方がなかったんだ。
	}
	talk エマ 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩１＿２:エマ_009]
		//違うわ。あのプールでの事故……。
		//あなたはあれ以来、私を見ると心が
		//痛んだ。
	}
	talk エマ 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩１＿２:エマ_010]
		//だから楽な道を選んだのよ。
		//私の顔を見ずにすむ道をね。
	}
	talk エマ 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩１＿２:エマ_011]
		//そうなれば、もう毎朝、責任を感じる
		//こともない。
	}
	talk エマ 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩１＿２:エマ_012]
		//あなたは逃げたのよ。
		//目の前の苦しみから逃れるために。
	}
	talk オタコン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩１＿２:オタコン_013]
		//ＥＥ……そうじゃない。
	}
	talk エマ 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩１＿２:エマ_014]
		//あなたは私を捨てた。
		//自分を楽にするため……。
	}
	talk オタコン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩１＿２:オタコン_015]
		//違う。僕が家を出たのは……。
	}
	talk エマ 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩１＿２:エマ_016]
		//お兄ちゃんも犯罪者よ。
		//そうじゃないの？
	}
	talk オタコン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩１＿２:オタコン_017]
		//僕が犯罪者？
	}
	talk エマ 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩１＿２:エマ_018]
		//私、知ってる。
		//あなたはネットの口座を操作して……。
	}
	talk オタコン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩１＿２:オタコン_019]
		//それは……
	}
	talk エマ 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩１＿２:エマ_020]
		//偉そうなこと言っても、
		//ただのクラッカーじゃない！？
	}
	talk オタコン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩１＿２:オタコン_021]
		//違う。目的の為にちょっと能力を
		//使ってるだけだ。
	}
	talk エマ 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩１＿２:エマ_022]
		//はっ！目的って何？正義のため！？
	}
	talk オタコン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩１＿２:オタコン_023]
		//平和のためさ。僕はスネークとは違う。
		//銃を持って、戦ったりはできない。
		//だから、僕が出来ることをやってる。
	}
	talk エマ 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩１＿２:エマ_024]
		//見事な自己正当化だこと。
		//犯罪者やめて弁護士にでもなったら？
	}
	@rpd_プリスキン顔表示
	talk プリスキン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩１＿２:プリスキン_025]
		//そこまでにしておけ……。
	}
minden		// うなづき許可ＸＸＸＸＸ
}//v
}//d

//エマオタコン兄妹喧嘩２ h //e
//resource PS_エマ救出後＿兄妹喧嘩２＿１
proc rp_PS_エマ救出後＿兄妹喧嘩２＿１:07 {
vox t:vc212171 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩２＿１:プリスキン_000]
		//どうした、ライデン？
	}
	talk ライデン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩２＿１:ライデン_001]
		//ああ。
	}
	@rpd_エマ顔表示プレイヤー側
mindds		// うなづき禁止ＸＸＸＸＸＸＸＸＸＸｘ
	talk エマ 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩２＿１:エマ_002]
		//どいて！
		//ちょっといいかな？
	}
	talk プリスキン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩２＿１:プリスキン_003]
		//オタコンか？
	}
	talk エマ 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩２＿１:エマ_004]
		//うん……。
	}
	talk プリスキン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩２＿１:プリスキン_005]
		//今かわる。
	}
}//v
}//d
//resource PS_エマ救出後＿兄妹喧嘩２＿２
proc rp_PS_エマ救出後＿兄妹喧嘩２＿２:07 {
vox t:vc212181 {
mindds		// うなづき禁止ＸＸＸＸＸＸＸＸＸＸｘ
	talk オタコン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩２＿２:オタコン_000]
		//ああ、なんだい？
	}
	talk エマ 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩２＿２:エマ_001]
		//これまで科学者はずっと戦争に
		//荷担してきた。あなた、そのことに
		//ついてはどう思ってるの？
	}
	talk オタコン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩２＿２:オタコン_002]
		//確かに、戦争は科学の進歩を促進させる
		//絶好の機会ではある。しかし、そこに
		//落とし穴がある。
	}
	talk オタコン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩２＿２:オタコン_003]
		//僕ら科学者は、職業倫理をちゃんと
		//持つことが必要だ。
	}
	talk オタコン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩２＿２:オタコン_004]
		//現代科学の悲劇は、スポンサーが政府、
		//軍にあるということだ。
	}
	talk エマ 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩２＿２:エマ_005]
		//原爆も水爆も大学や民間企業が運営する
		//研究所から生まれたのよ。
	}
	talk エマ 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩２＿２:エマ_006]
		//ロスアラモスもローレンス・リバモア
		//研究所も大学による運営だったでしょ。
		//なにもおかしくはない。
	}
	talk オタコン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩２＿２:オタコン_007]
		//兵器開発と大学……おかしく思える
		//かもしれないが、科学には自由な
		//情報交換が必要なんだ。
	}
	talk エマ 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩２＿２:エマ_008]
		//オッペンハイマー博士の意志ね？
	}
	talk オタコン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩２＿２:オタコン_009]
		//でも、僕は……科学と兵器開発を
		//別次元で考えていた。
	}
	talk オタコン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩２＿２:オタコン_010]
		//そうなんだ。僕は僕の研究成果が
		//不幸を招くなんて考えもしなかった。
		//あのシャドーモセス事件まではね。
	}
	talk エマ 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩２＿２:エマ_011]
		//私は後悔なんてしてない。
	}
	talk オタコン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩２＿２:オタコン_012]
		//そこなんだ。核の脅威は僕達科学者が
		//一番知ってる。僕らが守るしかないんだ。
		//国家や政治に利用されてはいけない。
	}
	talk オタコン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩２＿２:オタコン_013]
		//人間と核は共存できない。原子核反応を
		//扱える者が存在するとすれば、
		//「宇宙（神）」だけだよ。
	}
	talk エマ 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩２＿２:エマ_014]
		//私を理解してくれたのは科学だけだった。
		//私を評価してくれたのは政府だけだった。
		//それの何処が悪いの！！ねぇ！！
	}
	@rpd_プリスキン顔表示
	talk プリスキン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩２＿２:プリスキン_015]
		//そこまでだ。
	}
minden		// うなづき許可(デフォルト)
}//v
}//d

//エマオタコン兄妹喧嘩３ h //e
//resource PS_エマ救出後＿兄妹喧嘩３＿１
proc rp_PS_エマ救出後＿兄妹喧嘩３＿１:07 {
vox t:vc212191 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩３＿１:ライデン_000]
		//スネーク……。
	}
	talk エマ 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩３＿１:エマ_001]
		//ちょっと代わって！
	}
	talk ライデン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩３＿１:ライデン_002]
		//ああ……。
	}
	@rpd_エマ顔表示プレイヤー側
mindds		// うなづき禁止ＸＸＸＸＸＸＸＸＸ
	talk プリスキン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩３＿１:プリスキン_003]
		//オタコンなら、俺が代わりに聞く。
		//あいつは今、手が離せない。
	}
	talk エマ 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩３＿１:エマ_004]
		//え？
		//……ええ……。
	}
}//v
}//d
//resource PS_エマ救出後＿兄妹喧嘩３＿２
proc rp_PS_エマ救出後＿兄妹喧嘩３＿２:07 {
vox t:vc212201 {
mindds		// うなづき禁止ＸＸＸＸＸＸＸＸＸ
	talk プリスキン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩３＿２:プリスキン_000]
		//どういう用件だ？
	}
	talk エマ 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩３＿２:エマ_001]
		//兄は間違っている。
		//科学は世の中の為にあるんじゃない。
	}
	talk プリスキン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩３＿２:プリスキン_002]
		//じゃあ、何のためにあるんだ？
	}
	talk エマ 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩３＿２:エマ_003]
		//科学は個人のためにあるのよ。
		//私にとっては自分の夢を実現させる
		//ためにあるの。
	}
	talk プリスキン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩３＿２:プリスキン_004]
		//自分の欲のためにか？
	}
	talk エマ 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩３＿２:エマ_005]
		//欲がないと、夢は実現できない。
	}
	talk プリスキン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩３＿２:プリスキン_006]
		//その夢はなんだ？
	}
	talk エマ 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩３＿２:エマ_007]
		//兄への復讐、兄を打ち負かすこと。
	}
	talk プリスキン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩３＿２:プリスキン_008]
		//復讐？
	}
	talk エマ 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩３＿２:エマ_009]
		//私を捨てた事を後悔させる。
		//兄が間違っている事を思い知らせてやる。}
	}
	talk プリスキン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩３＿２:プリスキン_010]
		//くだらん理由だ……。
	}
	@rpd_ライデン顔表示デフォルト
	talk ライデン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩３＿２:ライデン_011]
		//……それくらいにしておこう。
	}
	@rpd_エマ顔表示プレイヤー側
	talk エマ 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩３＿２:エマ_012]
		//（無視）くだらないですって？
		//これが私の目標、私の生き甲斐……。
	}
	talk エマ 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩３＿２:エマ_013]
		//兄は間違っている。
		//兄は国に利用されただけ。惨めな男。
		//今もあなた達に利用されているだけ。
	}
	talk エマ 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩３＿２:エマ_014]
		//私は科学を逆に利用する。
		//自分の思いを遂げるために。
	}
	talk プリスキン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩３＿２:プリスキン_015]
		//馬鹿な。それこそが科学者が
		//踏み入ってはいけない領域だ。
	}
	talk エマ 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩３＿２:エマ_016]
		//そう！私は兄への復讐の為に悪魔に
		//身を売ったの。私はあいつを絶対に
		//許さない！！
	}
	talk プリスキン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩３＿２:プリスキン_017]
		//聞かなかったことにする。
	}
	talk エマ 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩３＿２:エマ_018]
		//いいえ！あいつにちゃんと言っといてよ！
		//私は……。
	}
	talk プリスキン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩３＿２:プリスキン_019]
		//エマ！
	}
	talk エマ 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩３＿２:エマ_020]
		//！？（気おされる）
	}
	talk プリスキン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩３＿２:プリスキン_021]
		//心にもないことは口にしない方がいいぞ。
	}
	talk エマ 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩３＿２:エマ_022]
		//……。
	}
	talk プリスキン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩３＿２:プリスキン_023]
		//それくらいにしておけ。
	}
	talk エマ 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩３＿２:エマ_024]
		//うん……。
	}
minden		// うなづき許可(デフォルト)
@rp_うなづきデフォルト＿是
@rp_かみあわない＿否１＿話聞けよ系デフォルト 100
	@rpd_ライデン顔表示デフォルト
	talk ライデン 標準 -m {
		 [PS_エマ救出後＿兄妹喧嘩３＿２:ライデン_025]
		//……。
	}
}//v
}//d

//狙撃イベント d //e
//ライデンから撃たれた２ h //e
//resource PS_エマ狙撃＿撃たれた２
proc rp_PS_エマ狙撃＿撃たれた２:07 {
vox t:vc212211 {
@rp_うなづきデフォルト＿是
@rp_無茶指令＿否１＿お前がやれ系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_エマ狙撃＿撃たれた２:プリスキン_000]
		//ライデン、お前どこを狙っている！？
		//ちゃんとエマを援護しろ！！
	}
}//v
}//d
//ライデンから撃たれた３ h //e
//resource PS_エマ狙撃＿撃たれた３
proc rp_PS_エマ狙撃＿撃たれた３:07 {
vox t:vc212221 {
@rp_うなづきデフォルト＿是
@rp_無茶指令＿否１＿お前がやれ系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_エマ狙撃＿撃たれた３:プリスキン_000]
		//その距離から俺に当てるとはなかなか
		//いい腕じゃないか。えぇ？ライデン！！
		//今度は敵を狙うんだ。いいな！！
	}
}//v
}//d
//ライデンから撃たれた４ h //e
//resource PS_エマ狙撃＿撃たれた４
proc rp_PS_エマ狙撃＿撃たれた４:07 {
vox t:vc212231 {
@rp_うなづきデフォルト＿是
@rp_無茶指令＿否１＿お前がやれ系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_エマ狙撃＿撃たれた４:プリスキン_000]
		//ライデン！
		//ふざけるのもいい加減にしろ！！
	}
}//v
}//d


//狙撃後 d //e
//エマの状態について h //e
//resource PS_狙撃後＿エマ傷１
proc rp_PS_狙撃後＿エマ傷１:07 {
vox t:vc212241 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PS_狙撃後＿エマ傷１:ライデン_000]
		//エマの具合は……？
	}
	talk プリスキン 標準 -m {
		 [PS_狙撃後＿エマ傷１:プリスキン_001]
		//……よくない。ここでは詳しい診察は
		//出来んが、筋膜の損傷が皮膚創と同じ
		//くらい大きい。
	}
	talk ライデン 標準 -m {
		 [PS_狙撃後＿エマ傷１:ライデン_002]
		//つまり？
	}
}//v
}//d
//resource PS_狙撃後＿エマ傷２
proc rp_PS_狙撃後＿エマ傷２:07 {
vox t:vc212251 {
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_狙撃後＿エマ傷２:プリスキン_000]
		//腸管や腸間膜まで損傷している可能性が
		//あるということだ。加えて出血も多い。
		//既に血圧が低下し始めている。
	}
	talk プリスキン 標準 -m {
		 [PS_狙撃後＿エマ傷２:プリスキン_001]
		//本来なら開腹して処置しなければ
		//ならないところだが、ここではな……。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_狙撃後＿エマ傷２:プリスキン_002]
		//応急処置は施したが、それが精一杯だ。
		//もうあまり時間はないだろう。
		//急いでくれ。
	}
}//v
}//d

//ＧＷのセキュリティー h //e
//resource PS_ＧＷの防壁
proc rp_PS_ＧＷの防壁:07 {
vox t:vc212261 {
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		 [PS_ＧＷの防壁:オタコン_000]
		//ちょっとだけ調べてみたんだけど……。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk オタコン 標準 -m {
		 [PS_ＧＷの防壁:オタコン_001]
		//アーセナルギアのセキュリティ・
		//システムは生物の免疫応答を模した
		//異物排除機構を採用しているようだ。
	}
	talk オタコン 標準 -m {
		 [PS_ＧＷの防壁:オタコン_002]
		//システム内部には多数の異物感知
		//エージェントが定期巡回していて、
		//全体が常に監視されている。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk オタコン 標準 -m {
		 [PS_ＧＷの防壁:オタコン_003]
		//異物感知エージェントは異物を
		//発見するとその情報を抗体生産
		//システムに伝達する。
	}
	talk オタコン 標準 -m {
		 [PS_ＧＷの防壁:オタコン_004]
		//そこで抗体エージェントと呼ばれる
		//プログラムが自律的に生産され、その
		//異物を除去・もしくは無力化するんだ。
	}
	talk オタコン 標準 -m {
		 [PS_ＧＷの防壁:オタコン_005]
		//その上『Ｇ．Ｗ』の物理的・論理的本体
		//である光ニューラルネットとそれ以外の
		//一般ネットの間には強固な障壁がある。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk オタコン 標準 -m {
		 [PS_ＧＷの防壁:オタコン_006]
		//ビット・ブレイン・バリアーと
		//呼ばれるフィルタリング・システムが
		//異物の流入を徹底的に防ぐんだ。
	}
	talk オタコン 標準 -m {
		 [PS_ＧＷの防壁:オタコン_007]
		//このシステムのせいで外部からの攻撃は
		//極めて難しくなっている。準備もなし
		//ではちょっと手が出せないね……。
	}
}//v
}//d
//フォックスダイについて h //e
//resource PS_フォックスダイ
proc rp_PS_フォックスダイ:07 {
vox t:vc212271 {
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		 [PS_フォックスダイ:オタコン_000]
		//ライデン。ＥＥに君の持ってる
		//ディスクのことを聞いてみた。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk オタコン 標準 -m {
		 [PS_フォックスダイ:オタコン_001]
		//基本的にはコンピューター・ワーム・
		//プログラムの集合体だ。
	}
	talk オタコン 標準 -m {
		 [PS_フォックスダイ:オタコン_002]
		//それぞれのワームは『Ｇ．Ｗ』を
		//構成するデータ単位を模倣した構造を
		//しているらしい。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk オタコン 標準 -m {
		 [PS_フォックスダイ:オタコン_003]
		//『Ｇ．Ｗ』の異物感知エージェントも
		//それを非自己と認識できず、免疫反応が
		//起こるのを防ぐことが出来るんだそうだ。
	}
	talk オタコン 標準 -m {
		 [PS_フォックスダイ:オタコン_004]
		//だから『Ｇ．Ｗ』本体を囲むＢＢＢも
		//通り抜けることが出来る。
	}
	talk オタコン 標準 -m {
		 [PS_フォックスダイ:オタコン_005]
		//ワームはニューラルネット内に
		//入り込むと周りのニューロンを
		//変成させるらしい。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk オタコン 標準 -m {
		 [PS_フォックスダイ:オタコン_006]
		//変成したニューロンは硬化して
		//ニューラルネットとして機能しなくなる。
	}
	talk オタコン 標準 -m {
		 [PS_フォックスダイ:オタコン_007]
		//時間とともにニューロンは変成し死滅していって、やがて全体が意味消失を
		//起こす。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk オタコン 標準 -m {
		 [PS_フォックスダイ:オタコン_008]
		//それで言語障害、記憶の欠落等の症状を
		//引き起こした後、自己を保てなくなって
		//機能を停止するって仕組みらしい。
	}
}//v
}//d

//拷問後合流後 d //e
//ステルス迷彩スネーク h //e
//resource PS_ＮＰＣスネーク＿ステルス迷彩スネーク
proc rp_PS_ＮＰＣスネーク＿ステルス迷彩スネーク:07 {
vox t:vc212281 {
	talk プリスキン 標準 -m {
		 [PS_ＮＰＣスネーク＿ステルス迷彩スネーク:プリスキン_000]
		//ライデン、どうした？
	}
	talk ライデン 標準 -m {
		 [PS_ＮＰＣスネーク＿ステルス迷彩スネーク:ライデン_001]
		//スネーク、あんたどこにいるんだ？
	}
	talk プリスキン 標準 -m {
		 [PS_ＮＰＣスネーク＿ステルス迷彩スネーク:プリスキン_002]
		//ああ、お前の目には見えないかもな。
		//俺は今ステルス迷彩を使っている。
	}
	talk ライデン 標準 -m {
		 [PS_ＮＰＣスネーク＿ステルス迷彩スネーク:ライデン_003]
		//ステルス迷彩？
	}
	talk プリスキン 標準 -m {
		 [PS_ＮＰＣスネーク＿ステルス迷彩スネーク:プリスキン_004]
		//オタコンが持ってきてくれた。
	}
	talk ライデン 標準 -m {
		 [PS_ＮＰＣスネーク＿ステルス迷彩スネーク:ライデン_005]
		//そんなものを持ってたのか？
		//なぜ言ってくれない？
	}
	talk プリスキン 標準 -m {
		 [PS_ＮＰＣスネーク＿ステルス迷彩スネーク:プリスキン_006]
		//それは……
	}
	talk ライデン 標準 -m {
		 [PS_ＮＰＣスネーク＿ステルス迷彩スネーク:ライデン_007]
		//聞かれなかったからか？
	}
	talk プリスキン 標準 -m {
		 [PS_ＮＰＣスネーク＿ステルス迷彩スネーク:プリスキン_008]
		//よく分かってるじゃないか。
		//お前の目には見えないかも知れんが
		//ちゃんと援護している。心配するな。
	}
}//v
}//d


//武器うんちく d //e
//ＰＳＧ１ h //e
//resource PS_ＰＳＧ１
proc rp_PS_ＰＳＧ１:07 {
vox t:vc212291 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ＰＳＧ１:プリスキン_000]
		//ＰＳＧ１は対テロリスト専用の
		//自動狙撃銃だ。
	}
	talk プリスキン 標準 -m {
		 [PS_ＰＳＧ１:プリスキン_001]
		//ガス作動式ではなくローラーロッキング
		//式の閉鎖機構を採用して、完全なフリー
		//フローティングバレルを実現している。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_ＰＳＧ１:プリスキン_002]
		//これによって自動ライフルにも関わらず
		//ボルトアクションの狙撃銃に匹敵する
		//精度を実現しているというわけだ。
	}
	talk プリスキン 標準 -m {
		 [PS_ＰＳＧ１:プリスキン_003]
		//約２７０ｍの射距離、５発で５０ｍｍ
		//というグルーピングを出すことが出来る。
		//世界最高の狙撃銃の一つといえるだろう。
	}
	talk プリスキン 標準 -m {
		 [PS_ＰＳＧ１:プリスキン_004]
		//ＰＳＧ１はＶＲ訓練でも使っただろうが、
		//その時とは扱いが違う点がいくつかある
		//から覚えておけ。
	}
	talk プリスキン 標準 -m {
		 [PS_ＰＳＧ１:プリスキン_005]
		//まず、そのＰＳＧ１には倍率を
		//変更出来る特製のスコープが
		//装備されている。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_ＰＳＧ１:プリスキン_006]
		//精密に狙う必要がある場合はズームイン、
		//広い視界を確保する必要がある場合は
		//ズームアウトするといいだろう。
	}
	talk プリスキン 標準 -m {
		 [PS_ＰＳＧ１:プリスキン_007]
		//さらに伏せ姿勢以外にも立ちや
		//しゃがみの状態からも構えられる
		//ようになった。
	}
	talk プリスキン 標準 -m {
		 [PS_ＰＳＧ１:プリスキン_008]
		//ただし安定性をかく姿勢では手ぶれが
		//大きくなる。
	}
	talk プリスキン 標準 -m {
		 [PS_ＰＳＧ１:プリスキン_009]
		//精密狙撃を行う場合はホフクして
		//伏せ姿勢をとった方がいいだろう。
	}
}//v
}//d
//ＰＳＧ１Ｔ h //e
//resource PS_ＰＳＧ１Ｔ
proc rp_PS_ＰＳＧ１Ｔ:07 {
vox t:vc212301 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ＰＳＧ１Ｔ:プリスキン_000]
		//お前の持っているＰＳＧ１−Ｔは
		//ＰＳＧ１の銃身を交換して麻酔弾
		//発射用に改造したものだ。
	}
	talk プリスキン 標準 -m {
		 [PS_ＰＳＧ１Ｔ:プリスキン_001]
		//扱いは通常のＰＳＧ１と変わらない。
		//違うのは敵の命を奪わずにすませられる
		//ということだけだ。
	}
	talk プリスキン 標準 -m {
		 [PS_ＰＳＧ１Ｔ:プリスキン_002]
		//使う使わないはお前次第だな。
	}
}//v
}//d

//Ｍ４ h //e
//resource PS_Ｍ４
proc rp_PS_Ｍ４:07 {
vox t:vc212311 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_Ｍ４:プリスキン_000]
		//Ｍ４を手に入れたようだな。
		//米特殊部隊統合軍で正式採用されている
		//アサルトカービン銃だ。
	}
	talk プリスキン 標準 -m {
		 [PS_Ｍ４:プリスキン_001]
		//第二次大戦中に使用された
		//Ｍ１カービンの流れをくんでいる。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_Ｍ４:プリスキン_002]
		//Ｍ４とは米軍に四番目に正式採用された
		//カービンという意味がある。
	}
	talk プリスキン 標準 -m {
		 [PS_Ｍ４:プリスキン_003]
		//基本的にはＭ１６Ａ２をベースに
		//特殊部隊向けの改良を加え発展させた
		//ものだ。
	}
	talk プリスキン 標準 -m {
		 [PS_Ｍ４:プリスキン_004]
		//装弾数は３０発。
		//５．５６ｍｍ×４５のＳＳ１０９弾を
		//使用する。
	}
	talk プリスキン 標準 -m {
		 [PS_Ｍ４:プリスキン_005]
		//ちなみにカービンは騎兵銃つまり
		//短銃身のライフルのことだ。覚えて……
		//おいてもあまり役には立たないかもな。
	}
}//v
}//d

//スプレー h //e
//resource PS_冷却スプレー１
proc rp_PS_冷却スプレー１:07 {
vox t:vc212321 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_冷却スプレー１:プリスキン_000]
		//冷却スプレーを持っているな。
		//それを使えばファットマンの仕掛けた
		//Ｃ４を冷却処理できるはずだ。
	}
	talk プリスキン 標準 -m {
		 [PS_冷却スプレー１:プリスキン_001]
		//装備すると自動的に主観で構え、
		//□ボタンを押している間
		//スプレーを噴霧する。
	}
	talk プリスキン 標準 -m {
		 [PS_冷却スプレー１:プリスキン_002]
		//噴霧された冷却材は空気に触れると
		//ゲル状に変質して爆弾に吸着、低温を
		//保ち続けるようになっている。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_冷却スプレー１:プリスキン_003]
		//充分に吹き付けてＣ４を冷却剤で
		//覆ってしまえば融けてしまうことは
		//ないということだ。
	}
	talk プリスキン 標準 -m {
		 [PS_冷却スプレー１:プリスキン_004]
		//つまり一度冷却に成功すれば、
		//もうそのＣ４が爆発することは
		//ないと考えていい。
	}
	talk プリスキン 標準 -m {
		 [PS_冷却スプレー１:プリスキン_005]
		//中身は充分入っているようだから
		//無くなる心配はないだろう。
		//そこは気にするな。
	}
	talk プリスキン 標準 -m {
		 [PS_冷却スプレー１:プリスキン_006]
		//ただしスプレーを装備している間は
		//移動が出来なくなる。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_冷却スプレー１:プリスキン_007]
		//冷却中に敵が接近して来たらすぐに
		//装備から外して隠れた方がいいだろうな。
	}
	talk プリスキン 標準 -m {
		 [PS_冷却スプレー１:プリスキン_008]
		//Ｃ４の冷却処理以外にもうまく使えば
		//敵をひるませたりすることも出来る
		//はずだ。覚えておけ。
	}
}//v
}//d


//クレイモア h //e
//resource PS_クレイモア１
proc rp_PS_クレイモア１:07 {
vox t:vc212331 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_クレイモア１:プリスキン_000]
		//クレイモア地雷を持っているな。
		//クレイモアは地上に敷設して使う
		//指向性地雷だ。
	}
	talk プリスキン 標準 -m {
		 [PS_クレイモア１:プリスキン_001]
		//主な用途は待ち伏せや陣地防御だが、
		//軽車両等のソフトスキンターゲットに
		//対しても用いられる。
	}
}//v
}//d
//resource PS_クレイモア２
proc rp_PS_クレイモア２:07 {
vox t:vc212341 {
	talk プリスキン 標準 -m {
		 [PS_クレイモア２:プリスキン_000]
		//そのクレイモア地雷は、ステルス
		//迷彩機能を搭載しているタイプだ。
		//敷設するとすぐに姿を消す。
	}
	talk プリスキン 標準 -m {
		 [PS_クレイモア２:プリスキン_001]
		//敷設後は地雷探知器か赤外線ゴーグルを
		//使わなければ位置を特定することは
		//出来ないだろう。
	}
	talk プリスキン 標準 -m {
		 [PS_クレイモア２:プリスキン_002]
		//敷設されるとステルス迷彩と同時に
		//対人センサーが起動する。
	}
}//v
}//d
//resource PS_クレイモア３
proc rp_PS_クレイモア３:07 {
vox t:vc212351 {
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_クレイモア３:プリスキン_000]
		//前方から人間の接近を感知すると、起爆。多数の破片と鉄球を飛散させて扇形の
		//有効加害ゾーンを形成する。
	}
	talk プリスキン 標準 -m {
		 [PS_クレイモア３:プリスキン_001]
		//ただしそのセンサーに敵味方識別機能は
		//ついていない。
	}
	talk プリスキン 標準 -m {
		 [PS_クレイモア３:プリスキン_002]
		//自分で仕掛けたクレイモアに
		//引っかかるような真似はするな。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_クレイモア３:プリスキン_003]
		//敷設されたクレイモア地雷は
		//ホフクで近づけば回収できる。
	}
	talk プリスキン 標準 -m {
		 [PS_クレイモア３:プリスキン_004]
		//自分が仕掛けたものだけでなく、
		//敵が敷設したものも入手出来るはずだ。
		//覚えておけ。
	}
}//v
}//d

//Ｃ４ h //e
//resource PS_Ｃ４
proc rp_PS_Ｃ４:07 {
vox t:vc212361 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_Ｃ４:プリスキン_000]
		//Ｃ４を装備しているな。
		//優秀な軍用プラスティック爆薬だ。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_Ｃ４:プリスキン_001]
		//組成は９１％のＲＤＸと９％の不活性
		//可塑性剤。白色の粘土状をしている。
	}
	talk プリスキン 標準 -m {
		 [PS_Ｃ４:プリスキン_002]
		//ＴＮＴ爆薬の１．３倍以上の性能を
		//持つ爆薬だが化学的には非常に
		//安定している。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_Ｃ４:プリスキン_003]
		//点火装置によって起爆されない限り
		//熱や衝撃を加えても爆発することはない。
	}
	talk プリスキン 標準 -m {
		 [PS_Ｃ４:プリスキン_004]
		//お前の無線式発火装置にはスクランブラ
		//と暗号化機能も備えられている。妨害
		//電波などで誤爆するも恐れもないだろう。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_Ｃ４:プリスキン_005]
		//□ボタンでセットしてから○ボタンで
		//爆破だが、自分で爆発に巻き込まれる
		//ようなヘマはするなよ。
	}
}//v
}//d

//マイク h //e
//resource PS_指向性マイク
proc rp_PS_指向性マイク:07 {
vox t:vc212371 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_指向性マイク:プリスキン_000]
		//指向性マイクを使っているな。
		//通常なら聞こえないような微かな音も
		//拾うことが出来るだろう。
	}
	talk プリスキン 標準 -m {
		 [PS_指向性マイク:プリスキン_001]
		//前面から入射する音のみを拾うよう
		//指向性を鋭くした超指向性マイクだ。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_指向性マイク:プリスキン_002]
		//音を拾えるのはマイクを向けた方向だけ
		//だということを覚えておけ。
	}
	talk プリスキン 標準 -m {
		 [PS_指向性マイク:プリスキン_003]
		//小型アンプも内蔵しているから、
		//音源にきちんと向ければ相手の心音まで
		//聞き取れるはずだ。
	}
}//v
}//d

//ＲＧＢ６ h //e
//resource PS_ＲＧＢ６
proc rp_PS_ＲＧＢ６:07 {
vox t:vc212381 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ＲＧＢ６:プリスキン_000]
		//ＲＧＢ６を装備しているな。
		//クロアチア製の４０ｍｍ６連発
		//グレネードランチャーだ。
	}
	talk プリスキン 標準 -m {
		 [PS_ＲＧＢ６:プリスキン_001]
		//ＶＲ訓練にはなかった武器だろう。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_ＲＧＢ６:プリスキン_002]
		//ＲＧＢ６にはドライビングスプリングの
		//力で回転するリボルバー式シリンダーに
		//６発のグレネードを装填できる。
	}
	talk プリスキン 標準 -m {
		 [PS_ＲＧＢ６:プリスキン_003]
		//投擲用手榴弾よりも狙いがつけやすい
		//はずだ。防弾装備を着た相手や遮蔽物に
		//隠れた相手には有効だろう。
	}
	talk プリスキン 標準 -m {
		 [PS_ＲＧＢ６:プリスキン_004]
		//弾道が放物線を描くことを覚えておけ。
		//発射角度に注意して狙った場所に
		//着弾させられるようにするんだ。
	}
}//v
}//d
//聞いていなければエアバースト説明へ t //e


//スティンガー h //e
//resource PS_スティンガー
proc rp_PS_スティンガー:07 {
vox t:vc212391 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_スティンガー:プリスキン_000]
		//スティンガーは携帯用地対空ミサイルだ。
	}
	talk プリスキン 標準 -m {
		 [PS_スティンガー:プリスキン_001]
		//ロックオンして発射すれば赤外線シーカー
		//ヘッドでその目標を自動的に追尾する。
	}
	talk プリスキン 標準 -m {
		 [PS_スティンガー:プリスキン_002]
		//しかし、そのスティンガーは旧式の
		//対対抗策が不十分なタイプだ。
	}
	talk プリスキン 標準 -m {
		 [PS_スティンガー:プリスキン_003]
		//フレアを撃たれるとミサイルの
		//シーカーが欺瞞されてしまうかもしれん。
	}
}//v
}//d

//リモコンミサイル h //e
//resource PS_リモコンミサイル
proc rp_PS_リモコンミサイル:07 {
vox t:vc212401 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_リモコンミサイル:プリスキン_000]
		//リモコンミサイルを手に入れたな。
		//通称ニキータミサイル。無線誘導の
		//シーカー付き飛翔体だ。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_リモコンミサイル:プリスキン_001]
		//マイクロ飛行体技術を応用した偵察用
		//ミサイルで、弾頭に搭載されたＣＣＤ
		//カメラからの映像を見ながら操作できる。
	}
	talk プリスキン 標準 -m {
		 [PS_リモコンミサイル:プリスキン_002]
		//偵察用といっても弾頭には少量の炸薬が
		//装填されている。遠距離からの攻撃にも
		//使えるだろう。
	}
	talk プリスキン 標準 -m {
		 [PS_リモコンミサイル:プリスキン_003]
		//発射後にリモコンミサイルを装備から
		//外せばその場で爆発させることも出来る。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_リモコンミサイル:プリスキン_004]
		//ミサイルの操作中は移動が出来なくなることを覚えておけ。ミサイルの燃料切れ
		//にも注意するんだ。
	}
	talk プリスキン 標準 -m {
		 [PS_リモコンミサイル:プリスキン_005]
		//ＶＲ訓練とは違い操作は主観のみだ。
		//俯瞰での操作は出来ないから戸惑うなよ。
		//ＶＲと実戦は違うものだ。
	}
}//v
}//d

//手投げグレネード h //e
//resource PS_手投げグレネード
proc rp_PS_手投げグレネード:07 {
vox t:vc212411 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_手投げグレネード:プリスキン_000]
		//グレネードを持っているな。
		//投擲用の対人破片手榴弾だ。
	}
	talk プリスキン 標準 -m {
		 [PS_手投げグレネード:プリスキン_001]
		//爆発すると同時に弾体が破片になって
		//飛び散り、爆風と破片で敵を倒す。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_手投げグレネード:プリスキン_002]
		//炸薬にはコンポジットＢを使用している。ＴＮＴ４０％とＲＤＸ６０％で出来た
		//混合爆薬だ。
	}
	talk プリスキン 標準 -m {
		 [PS_手投げグレネード:プリスキン_003]
		//□ボタンを押すと信管を抜いて構え、
		//□ボタンを離すと投げる。□ボタンを
		//押した時の強さで投擲距離が変わるぞ。
	}
	talk プリスキン 標準 -m {
		 [PS_手投げグレネード:プリスキン_004]
		//爆発するまで約５秒だ。この５秒と
		//投擲距離を使いこなすことが重要だ。
		//いいな
	}
}//v
}//d

//スタン h //e
//resource PS_スタングレネード
proc rp_PS_スタングレネード:07 {
vox t:vc212421 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_スタングレネード:プリスキン_000]
		//スタン・グレネードを持っているな。
		//スタン・グレネードは閃光と轟音で
		//人間の見当識を失わせる非殺傷兵器だ。
	}
	talk プリスキン 標準 -m {
		 [PS_スタングレネード:プリスキン_001]
		//炸裂すると瞬間的に２５０万カンデラ
		//以上の閃光と１６０デシベル以上の
		//轟音を発生させる。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_スタングレネード:プリスキン_002]
		//分かりやすく言えば警察用フラッシュ
		//ライトの１２０倍以上の光とジェット
		//機の離陸ほどの爆音ということになるな。
	}
	talk プリスキン 標準 -m {
		 [PS_スタングレネード:プリスキン_003]
		//同時に２７００℃ほどの高温も発するが
		//ミリセカンド単位の話だ。
		//発火の可能性はないと思っていい。
	}
	talk プリスキン 標準 -m {
		 [PS_スタングレネード:プリスキン_004]
		//同じく爆発音の発生時間もミリセカンド単位の間だから、恒久的な聴覚障害に
		//なる恐れはない。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_スタングレネード:プリスキン_005]
		//使用すれば敵は意識を失うが、
		//それだけだ。殺傷能力はないと
		//いうことを覚えておけよ。
	}
}//v
}//d
//チャフ h //e
//resource PS_チャフグレネード
proc rp_PS_チャフグレネード:07 {
vox t:vc212431 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_チャフグレネード:プリスキン_000]
		//チャフ・グレネードを握っているな。
		//敵の電子機器の妨害及び無線封鎖
		//が可能な携帯用電子戦兵器だ。
	}
	talk プリスキン 標準 -m {
		 [PS_チャフグレネード:プリスキン_001]
		//点火装置が発火すると微量の爆薬で
		//多数のチャフ片と小型妨害電波発信機を
		//散布する。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_チャフグレネード:プリスキン_002]
		//電子機器はしばらくの間使い物に
		//ならなくなるはずだ。
	}
	talk プリスキン 標準 -m {
		 [PS_チャフグレネード:プリスキン_003]
		//だが覚えておかなければいけないのは、
		//レーダー等、お前の装備も影響を受けて
		//しまうことだ。
	}
	talk プリスキン 標準 -m {
		 [PS_チャフグレネード:プリスキン_004]
		//自分も電子機器を使っている時は
		//気をつけろ。
	}
}//v
}//d

//マガジン h //e
//resource PS_マガジン
proc rp_PS_マガジン:07 {
vox t:vc212441 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_マガジン:プリスキン_000]
		//お前が手に持っているマガジンは
		//ハンドガンや自動小銃の空弾倉だ。
		//□ボタンを押すと構え、離すと投げる。
	}
	talk プリスキン 標準 -m {
		 [PS_マガジン:プリスキン_001]
		//投げつけたところで敵を倒せるわけ
		//じゃないが、気を引くぐらいは出来る
		//だろう。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_マガジン:プリスキン_002]
		//□ボタンを押した時の強さで投げる
		//距離が変わる。
	}
	talk プリスキン 標準 -m {
		 [PS_マガジン:プリスキン_003]
		//主観で構えて、狙った所に落とせる
		//ようにしておけば役に立つかも知れんな。
	}
}//v
}//d
//麻酔銃 h //e
//resource PS_麻酔銃１
proc rp_PS_麻酔銃１:07 {
vox t:vc212451 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_麻酔銃１:プリスキン_000]
		//お前が持っているのはサプレッサー
		//付きの麻酔銃だ。命中させれば敵を
		//眠らせることが出来るだろう。
	}
	talk プリスキン 標準 -m {
		 [PS_麻酔銃１:プリスキン_001]
		//麻酔弾は当たった場所によって効果が
		//現われるまでの時間が変わってくる
		//ということを覚えておけ。
	}
	talk プリスキン 標準 -m {
		 [PS_麻酔銃１:プリスキン_002]
		//一発で眠らせたいなら頭や心臓、急所に
		//当てろ。主観攻撃でよく狙うんだ。
	}
}//v
}//d
//タンカー編をやっている場合 t //e
//resource PS_麻酔銃２
proc rp_PS_麻酔銃２:07 {
vox t:vc212461 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PS_麻酔銃２:ライデン_000]
		//この改造銃、どこかで見た気が
		//するんだが……。
	}
	talk プリスキン 標準 -m {
		 [PS_麻酔銃２:プリスキン_001]
		//ああ。二年前にソリッド・スネークが
		//使っていたのと同じものらしいな。
	}
	talk プリスキン 標準 -m {
		 [PS_麻酔銃２:プリスキン_002]
		//例のテロ以来、奴のファンが作ったとか
		//いう改造銃が結構出回ったらしい。
		//それもその一つだろう。
	}
}//v
}//d
//resource PS_麻酔銃３
proc rp_PS_麻酔銃３:07 {
vox t:vc212471 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_麻酔銃３:プリスキン_000]
		//その麻酔銃本体は米軍の制式拳銃Ｍ９を
		//麻酔弾用に改造したものだ。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_麻酔銃３:プリスキン_001]
		//麻酔弾は着弾すると、その衝撃を使って
		//弾体後部で薬品を混合し、ガスを
		//発生させる。
	}
	talk プリスキン 標準 -m {
		 [PS_麻酔銃３:プリスキン_002]
		//そのガスの圧力でピストンを押し、
		//相手に麻酔薬を注入するわけだな。
	}
	talk プリスキン 標準 -m {
		 [PS_麻酔銃３:プリスキン_003]
		//要するに小さな注射器を発射するような
		//ものと考えればいい。
	}
	talk プリスキン 標準 -m {
		 [PS_麻酔銃３:プリスキン_004]
		//Ｍ９は麻酔銃だ。敵を眠らせるだけで
		//倒せるわけじゃないということを
		//覚えておけよ。
	}
}//v
}//d
//ソーコム h //e
//resource PS_ソーコム１
proc rp_PS_ソーコム１:07 {
vox t:vc212481 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ソーコム１:プリスキン_000]
		//ソーコム・ピストルを装備しているな。
		//米特殊作戦コマンド用特殊作戦部隊攻撃
		//拳銃として作られた４５口径自動拳銃だ。
	}
	talk プリスキン 標準 -m {
		 [PS_ソーコム１:プリスキン_001]
		//ストッピングパワーに優れた
		//４５ＡＣＰ弾を使用する。
		//装弾数は１２発だ。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_ソーコム１:プリスキン_002]
		//作動不良間発砲可能弾数は平均６０００
		//発以上、射弾５発の平均集弾半径は
		//１．４インチ。
	}
	talk プリスキン 標準 -m {
		 [PS_ソーコム１:プリスキン_003]
		//少々でかいが信頼できる銃だ。
		//レーザー・エイミング・モジュールも
		//装備している。
	}
}//v
}//d
//サプレッサーない場合 t //e
//resource PS_ソーコム２
proc rp_PS_ソーコム２:07 {
vox t:vc212491 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ソーコム２:プリスキン_000]
		//サプレッサーも装着可能だ。
		//サプレッサーを付ければ銃声を消す
		//ことが出来る。探してみるといい。
	}
}//v
}//d

//サプレッサー装備している場合 t //e
//resource PS_ソーコム＿サプレッサー２
proc rp_PS_ソーコム＿サプレッサー２:07 {
vox t:vc212501 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ソーコム＿サプレッサー２:プリスキン_000]
		//サプレッサーも装備しているようだな。
	}
}//v
}//d
//resource PS_ソーコム＿サプレッサー２＿１
proc rp_PS_ソーコム＿サプレッサー２＿１:07 {
vox t:vc212511 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ソーコム＿サプレッサー２＿１:プリスキン_000]
		//ソーコムにサプレッサーを装備して
		//いるな。
	}
}//v
}//d
//resource PS_ソーコム＿サプレッサー３
proc rp_PS_ソーコム＿サプレッサー３:07 {
vox t:vc212521 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ソーコム＿サプレッサー３:プリスキン_000]
		//サプレッサーは多層隔壁で発射ガスの
		//速度を減速して発射音と発射炎を減少
		//させるものだ。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_ソーコム＿サプレッサー３:プリスキン_001]
		//内部のバッフルを湿らせた状態で
		//約３８デシベルの減音効果がある。
	}
	talk プリスキン 標準 -m {
		 [PS_ソーコム＿サプレッサー３:プリスキン_002]
		//そのサプレッサーには回転させて
		//１０ヶ所のポジションに固定可能だ。
	}
	talk プリスキン 標準 -m {
		 [PS_ソーコム＿サプレッサー３:プリスキン_003]
		//それで着弾点を調整するという機能
		//なんだが……これは別に覚えて
		//おかなくてもいい。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_ソーコム＿サプレッサー３:プリスキン_004]
		//もう調整は済んでいるようだからな。
		//サプレッサー装着前と同じ感覚で
		//扱えるだろう。
	}
	talk プリスキン 標準 -m {
		 [PS_ソーコム＿サプレッサー３:プリスキン_005]
		//銃声で敵に発見されることはなくなる
		//だろうが、倒れた仲間を見つければ
		//敵も警戒を強化するに違いない。
	}
	talk プリスキン 標準 -m {
		 [PS_ソーコム＿サプレッサー３:プリスキン_006]
		//弾薬には限りもある。
		//無闇な戦闘はさけろよ。
	}
}//v
}//d


//装備品 d //e
//エロ本 h //e
//resource PS_エロ本
proc rp_PS_エロ本:07 {
vox t:vc212531 {
@rp_つっこまれ＿是１＿なんで知ってるんだ系デフォルト 100
@rp_うなづきデフォルト＿否
	talk プリスキン 標準 -m {
		 [PS_エロ本:プリスキン_000]
		//ライデン、いいものを持ってる
		//じゃないか。
	}
	talk ライデン 標準 -m {
		 [PS_エロ本:ライデン_001]
		//いやこれは……
	}
@rp_キテレツさん＿否１＿なんだこいつ系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_エロ本:プリスキン_002]
		//なに、否定することはない。
		//戦場でもそれくらいの心意気は
		//あった方がいいだろう。
	}
	talk ライデン 標準 -m {
		 [PS_エロ本:ライデン_003]
		//……。
	}
@rp_つっこまれ＿是１＿なんで知ってるんだ系デフォルト 100
@rp_うなづきデフォルト＿否
	talk プリスキン 標準 -m {
		 [PS_エロ本:プリスキン_004]
		//使い方は……まあ決まってるだろうが、
		//それ以外にもやり方次第では敵の注意を
		//そらしたり出来るかもしれんな……。
	}
}//v
}//d


//たばこ h //e
//resource PS_たばこ
proc rp_PS_たばこ:07 {
vox t:vc212541 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_たばこ:プリスキン_000]
		//俺が渡した煙草、ちゃんと持っている
		//ようだな。
	}
	talk ライデン 標準 -m {
		 [PS_たばこ:ライデン_001]
		//実はずっと禁煙していたんだが……。
	}
	talk プリスキン 標準 -m {
		 [PS_たばこ:プリスキン_002]
		//なるほど。では禁煙をやめる
		//良いきっかけになったんじゃないか？
	}
	talk ライデン 標準 -m {
		 [PS_たばこ:ライデン_003]
		//……。
	}
	talk プリスキン 標準 -m {
		 [PS_たばこ:プリスキン_004]
		//冗談だ。喫煙は体によくないことは
		//事実だからな。吸いたくなければ
		//吸わない方がいいだろう。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_たばこ:プリスキン_005]
		//だが戦場では煙草も喫煙以外にいろいろ
		//使い道があるはずだ。持っているだけ
		//なら損はしない。
	}
	talk プリスキン 標準 -m {
		 [PS_たばこ:プリスキン_006]
		//装備品は最大限に利用しろ。
		//ちょっとした工夫で道は開けるものだ。
	}
}//v
}//d

//敵兵服 h //e
//resource PS_敵兵服
proc rp_PS_敵兵服:07 {
vox t:vc212551 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_敵兵服:プリスキン_000]
		//敵の野戦服を着ているな。
		//なかなか似合ってるじゃないか。
	}
	talk ライデン 標準 -m {
		 [PS_敵兵服:ライデン_001]
		//からかわないでくれ。
		//これでも結構びびってるんだ。
		//いつ見破られるかって……。
	}
	talk プリスキン 標準 -m {
		 [PS_敵兵服:プリスキン_002]
		//大丈夫だ。過敏になるな。
		//お前なら歩き方でばれる心配も
		//なかろうしな。
	}
	talk ライデン 標準 -m {
		 [PS_敵兵服:ライデン_003]
		//歩き方？
		//なんのことだ？
	}
@rp_うなづきデフォルト＿是
@rp_かみあわない＿否１＿話聞けよ系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_敵兵服:プリスキン_004]
		//ふふん。なんでもない。気にするな。
	}
@rp_つっこまれ＿是１＿なんで知ってるんだ系デフォルト 100
@rp_うなづきデフォルト＿否
	talk プリスキン 標準 -m {
		 [PS_敵兵服:プリスキン_005]
		//だが、お前が着てるのはかなりサイズが
		//小さいようだな。
	}
	talk プリスキン 標準 -m {
		 [PS_敵兵服:プリスキン_006]
		//敵と接触したりすると拍子で装備から
		//外れてしまうかもしれん。注意した方が
		//いいだろう。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_敵兵服:プリスキン_007]
		//本来は体にフィットするものが支給され
		//るものだが、今回はそうもいくまい。
		//服に動きをあわせてもらうしかないな。
	}
}//v
}//d

//ダンボール h //e
//resource PS_ダンボール１
proc rp_PS_ダンボール１:07 {
vox t:vc212561 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ダンボール１:プリスキン_000]
		//ダンボール箱を装備しているな。
		//ダンボール箱は敵の目を欺く最高の
		//偽装と言える。潜入任務の必需品だ。
	}
	talk ライデン 標準 -m {
		 [PS_ダンボール１:ライデン_001]
		//そうなのか？
	}
	talk プリスキン 標準 -m {
		 [PS_ダンボール１:プリスキン_002]
		//勿論だ。ダンボール箱に命を救われた
		//という工作員は古来より数知れない。
	}
	talk ライデン 標準 -m {
		 [PS_ダンボール１:ライデン_003]
		//みんな……これを使ってきたのか？
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ダンボール１:プリスキン_004]
		//当たり前だ。ダンボール箱をいかに
		//使いこなすかが任務の成否を決定すると
		//いっても過言ではないだろう。
	}
	talk ライデン 標準 -m {
		 [PS_ダンボール１:ライデン_005]
		//……。
	}
	talk プリスキン 標準 -m {
		 [PS_ダンボール１:プリスキン_006]
		//ただし、いかにダンボール箱といえど
		//素材は紙だ。手荒い扱いをすると
		//すぐ駄目になるぞ。
	}
}//v
}//d
//ダンボールスネークを銃撃してダンボールを剥がしている場合 t //e
//resource PS_ダンボール２
proc rp_PS_ダンボール２:07 {
vox t:vc212571 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ダンボール２:プリスキン_000]
		//俺もお前のせいでいくつか
		//失ってしまった……。
	}
	talk ライデン 標準 -m {
		 [PS_ダンボール２:ライデン_001]
		//なんだって？
	}
@rp_かみあわない＿否１＿話聞けよ系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_ダンボール２:プリスキン_002]
		//いや。気にするな。
	}
}//v
}//d
//resource PS_ダンボール３
proc rp_PS_ダンボール３:07 {
vox t:vc212581 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ダンボール３:プリスキン_000]
		//とにかくダンボール箱は大事に使え。
		//丁寧に扱えばダンボール箱もきっと
		//お前に応えてくれる。
	}
@rp_キテレツさん＿否１＿なんだこいつ系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_ダンボール３:プリスキン_001]
		//真心をこめて使うんだ。必要なのは
		//ダンボール箱に対する愛情。粗略な
		//扱いは許さんぞ。いいな。
	}
	talk ライデン 標準 -m {
		 [PS_ダンボール３:ライデン_002]
		//……。
	}
}//v
}//d

//生体センサー h //e
//resource PS_生体センサー
proc rp_PS_生体センサー:07 {
vox t:vc212591 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_生体センサー:プリスキン_000]
		//生体センサーを使っているな。
		//それを装備すれば、敵の接近を振動で
		//感じ取ることが出来る。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_生体センサー:プリスキン_001]
		//生体電磁波や心臓の鼓動を感知する
		//センサーだ。敵が接近すればするほど
		//振動も大きくなる。
	}
	talk プリスキン 標準 -m {
		 [PS_生体センサー:プリスキン_002]
		//便利な装備品だが、生体センサーを
		//装備している間は他の振動は感じなく
		//なるということは覚えておけ。
	}
@rp_キテレツさん＿否１＿なんだこいつ系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_生体センサー:プリスキン_003]
		//何かを得れば何かを失う。人生とは
		//そんなものだ。状況に応じて使うか
		//使わないかを決めるといい。
	}
}//v
}//d

//地雷探知器 h //e
//resource PS_地雷探知器１
proc rp_PS_地雷探知器１:07 {
vox t:vc212601 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_地雷探知器１:プリスキン_000]
		//地雷探知器を装備しているな。
		//肉眼では見えないクレイモア地雷の
		//位置をレーダー上に表示する探知器だ。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_地雷探知器１:プリスキン_001]
		//そいつは通常の地雷探知器ではない。
		//自律微少スケール化学実験室で開発
		//された技術を採用した最新型だ。
	}
	talk プリスキン 標準 -m {
		 [PS_地雷探知器１:プリスキン_002]
		//金属探知ではなく主に化学探知器を
		//利用したシステムになっている。
	}
	talk プリスキン 標準 -m {
		 [PS_地雷探知器１:プリスキン_003]
		//地雷の金属ケースではなく、爆発物が
		//放出する爆発性分子を検出するという
		//ことだ。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_地雷探知器１:プリスキン_004]
		//親父さんから渡されたＣ４の『匂い』を
		//探知するセンサーと基本原理は同じだな。
	}
	talk プリスキン 標準 -m {
		 [PS_地雷探知器１:プリスキン_005]
		//だから俺達がいるような金属構造物の
		//中でも正確に地雷の位置を検出できる。
		//というわけだ。
	}
}//v
}//d
//レーダー使用不能状態 t //e
//resource PS_地雷探知器２
proc rp_PS_地雷探知器２:07 {
vox t:vc212611 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_地雷探知器２:プリスキン_000]
		//しかしレーダーを使用可能にしなければ
		//使っても意味がないぞ。覚えておけ。
	}
}//v
}//d

//センサーＡ h //e
//resource PS_センサーＡ１
proc rp_PS_センサーＡ１:07 {
vox t:vc212621 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_センサーＡ１:プリスキン_000]
		//親父さんから渡されたセンサーＡを
		//使っているな。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_センサーＡ１:プリスキン_001]
		//Ｃ４に限らず爆発物は特有の
		//爆発性分子を大気中に放出し続けている。
	}
	talk プリスキン 標準 -m {
		 [PS_センサーＡ１:プリスキン_002]
		//そのセンサーＡはイオン易動性分光測定
		//という技術を使ってその分子クラスター
		//を検知する探知器だ。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_センサーＡ１:プリスキン_003]
		//早い話がＣ４が発する『匂い』を
		//嗅ぎ付けるということだな。
	}
	talk プリスキン 標準 -m {
		 [PS_センサーＡ１:プリスキン_004]
		//検知された『匂い』は雲のような形で
		//レーダー状に表示される。Ｃ４は必ず
		//その近くにあるはずだ。
	}
}//v
}//d
//resource PS_センサーＡ２
proc rp_PS_センサーＡ２:07 {
vox t:vc212631 {
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_センサーＡ２:プリスキン_000]
		//このセンサーは特殊なチューニングが
		//施されているようだ。
	}
	talk プリスキン 標準 -m {
		 [PS_センサーＡ２:プリスキン_001]
		//ファットマンがサインとして振り掛ける
		//香水とＣ４の『匂い』を混合した化学
		//シグネチャに特化した調整だな。
	}
	talk プリスキン 標準 -m {
		 [PS_センサーＡ２:プリスキン_002]
		//だから俺達がＣ４を仕掛けても
		//反応はしないだろう。
	}
}//v
}//d
//爆弾解体後 t //e
//resource PS_センサーＡ３
proc rp_PS_センサーＡ３:07 {
vox t:vc212641 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_センサーＡ３:プリスキン_000]
		//充分役に立ってくれたが
		//もう使うことはないかも知れんな。
	}
}//v
}//d

//センサーＢ h //e
//resource PS_センサーＢ１
proc rp_PS_センサーＢ１:07 {
vox t:vc212651 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_センサーＢ１:プリスキン_000]
		//センサーＢを装備しているな。
		//ファットマンが仕掛けた『匂い』の
		//しないＣ４を探知出来るセンサーだ。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_センサーＢ１:プリスキン_001]
		//爆発性分子を化学探知するセンサーＡ
		//とは違い、中性子を放射して閉鎖された物体の中の爆発物を検知する。
	}
	talk プリスキン 標準 -m {
		 [PS_センサーＢ１:プリスキン_002]
		//『匂い』、つまり爆発性分子が
		//拡散しないよう厳重にシールされた
		//Ｃ４も発見することが出来るだろう。
	}
	talk プリスキン 標準 -m {
		 [PS_センサーＢ１:プリスキン_003]
		//中性子は物体を通過する際、その中に
		//含有される水素含有物質との相互作用に
		//よって後方散乱を起こす。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_センサーＢ１:プリスキン_004]
		//この後方散乱を放射線検出器で測定し、
		//値を分析して爆発物の存在を特定する
		//という仕組みだ。
	}
	talk プリスキン 標準 -m {
		 [PS_センサーＢ１:プリスキン_005]
		//装備するだけで自動的に周囲の走査を
		//行ってくれる。同じエリアに爆発物を
		//発見すれば警告音が鳴る。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_センサーＢ１:プリスキン_006]
		//警告音の間隔が短くなればそれだけ
		//爆弾に近づいているということだ。
		//覚えておけ。
	}
}//v
}//d
//resource PS_センサーＢ２
proc rp_PS_センサーＢ２:07 {
vox t:vc212661 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_センサーＢ２:プリスキン_000]
		//このセンサーはファットマンの使う
		//Ｃ４にしか反応しないように調整して
		//あるらしい。
	}
	talk プリスキン 標準 -m {
		 [PS_センサーＢ２:プリスキン_001]
		//ファットマンが使うＣ４と俺達が使う
		//Ｃ４の組成は微妙に異なるようだ。多分
		//ワックスの材質か何かが違うんだろう。
	}
	talk プリスキン 標準 -m {
		 [PS_センサーＢ２:プリスキン_002]
		//親父さんが調整に時間をかけていたのは
		//このあたりだったのかもしれんな。
	}
}//v
}//d
//resource PS_センサーＢ３
proc rp_PS_センサーＢ３:07 {
vox t:vc212671 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_センサーＢ３:プリスキン_000]
		//だがＣ４は全て処理し終わっているし、
		//ファットマンももういない。
		//このセンサーを使う必要はないだろう。
	}
}//v
}//d

//双眼鏡 h //e
//resource PS_双眼鏡１
proc rp_PS_双眼鏡１:07 {
vox t:vc212681 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_双眼鏡１:プリスキン_000]
		//双眼鏡を使っているな。
		//オートフォーカス、ズーム機能装備。
		//軍用のハイエンドモデルだ。
	}
}//v
}//d
//拷問以前のみ t //e
//resource PS_双眼鏡２
proc rp_PS_双眼鏡２:07 {
vox t:vc212691 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_双眼鏡２:プリスキン_000]
		//特に『ビッグ・シェル』外部では
		//役に立つだろう。
	}
}//v
}//d
//resource PS_双眼鏡３
proc rp_PS_双眼鏡３:07 {
vox t:vc212701 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_双眼鏡３:プリスキン_000]
		//遠方から敵を早期発見出来れば先手を
		//打つことが出来る。潜入任務に
		//敵地偵察は不可欠だ。よく覚えておけ。
	}
}//v
}//d

//カメラ h //e
//resource PS_カメラ
proc rp_PS_カメラ:07 {
vox t:vc212711 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_カメラ:プリスキン_000]
		//カメラを使う気か？
		//言うまでもなく、そいつを使えば
		//写真を撮ることが出来る。
	}
	talk プリスキン 標準 -m {
		 [PS_カメラ:プリスキン_001]
		//ズーム機能もついているし、
		//オートフォーカスだからピントを
		//気にする必要もないだろう。
	}
	talk プリスキン 標準 -m {
		 [PS_カメラ:プリスキン_002]
		//使いべりもしないはずだ。
		//いろいろ試してみろ。
	}
}//v
}//d

//暗視ゴーグル h //e
//resource PS_暗視ゴーグル
proc rp_PS_暗視ゴーグル:07 {
vox t:vc212721 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_暗視ゴーグル:プリスキン_000]
		//暗視ゴーグルを使っているな。
		//暗視ゴーグルを装備すれば暗い場所でも
		//視界を確保することが出来るだろう。
	}
	talk プリスキン 標準 -m {
		 [PS_暗視ゴーグル:プリスキン_001]
		//暗視ゴーグルは映像増幅装置で
		//かすかな光を電子的に増幅して
		//映像化する暗視装置だ。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_暗視ゴーグル:プリスキン_002]
		//暗視装置が登場したのは１９４０年代。それ以来、改良が進み感度も解像度も
		//上がっている。
	}
	talk プリスキン 標準 -m {
		 [PS_暗視ゴーグル:プリスキン_003]
		//お前が使っているのは暗視ゴーグルと
		//しては第四世代にあたるものだ。
	}
}//v
}//d
//赤外線ゴーグル h //e
//resource PS_赤外線ゴーグル１
proc rp_PS_赤外線ゴーグル１:07 {
vox t:vc212731 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_赤外線ゴーグル１:プリスキン_000]
		//赤外線ゴーグルを使っているな。
		//熱源の分布を映像化して暗所での
		//視界を確保する暗視装置だ。
	}
	talk プリスキン 標準 -m {
		 [PS_赤外線ゴーグル１:プリスキン_001]
		//その赤外線ゴーグルの解像度は
		//４０万画素以上、雑音等価温度差は
		//０．０５℃以下。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_赤外線ゴーグル１:プリスキン_002]
		//電荷転送能力の高い二次元固体撮像素子
		//方式を採用しているおかげだな。
	}
	talk プリスキン 標準 -m {
		 [PS_赤外線ゴーグル１:プリスキン_003]
		//ステルス迷彩を施されたクレイモア
		//地雷を見ることも出来るだろう。
		//覚えておけ。
	}
}//v
}//d
//ドッグタグ持っている場合 t //e
//resource PS_赤外線ゴーグル２
proc rp_PS_赤外線ゴーグル２:07 {
vox t:vc212741 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_赤外線ゴーグル２:プリスキン_000]
		//敵兵士の首のあたりをよく見れば
		//ドッグタグを持っているかどうかも
		//わかるかもしれんな。
	}
}//v
}//d

//レーション h //e
//resource PS_レーション
proc rp_PS_レーション:07 {
vox t:vc212751 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_レーション:プリスキン_000]
		//レーションを装備しているな。
		//レーションはＬＩＦＥを一定量回復
		//出来る軍用携帯糧食だ。
	}
	talk プリスキン 標準 -m {
		 [PS_レーション:プリスキン_001]
		//ウィンドウで選択して○ボタンを
		//押せばその場で使ってＬＩＦＥを
		//回復する。
	}
	talk プリスキン 標準 -m {
		 [PS_レーション:プリスキン_002]
		//装備しておけば、お前のＬＩＦＥが
		//ゼロになった瞬間、自動的に使用して
		//ＬＩＦＥを回復することも出来る。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_レーション:プリスキン_003]
		//レーションは単なる携帯食品ではない。
		//兵士は戦場でもっとも高価で重要な
		//戦闘単位の一つと言える。
	}
	talk プリスキン 標準 -m {
		 [PS_レーション:プリスキン_004]
		//その機能維持を維持するために
		//米軍調理開発研究所が総力を
		//上げて研究開発した代物だ。
	}
	talk プリスキン 標準 -m {
		 [PS_レーション:プリスキン_005]
		//カロリーを重視しつつ栄養バランスは
		//周到に考えられているし、フリーズ
		//ドライ方式で小型軽量、日持ちもする。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_レーション:プリスキン_006]
		//要するによく出来た食い物だと
		//いうことだ。まあ彼女の手料理には
		//負けるだろうがな。
	}
	talk ライデン 標準 -m {
		 [PS_レーション:ライデン_007]
		//うーむ……。
	}
	talk プリスキン 標準 -m {
		 [PS_レーション:プリスキン_008]
		//どうした？
	}
	talk ライデン 標準 -m {
		 [PS_レーション:ライデン_009]
		//……ここだけの話にしてくれるか？
	}
	talk プリスキン 標準 -m {
		 [PS_レーション:プリスキン_010]
		//なんだ？
	}
	talk ライデン 標準 -m {
		 [PS_レーション:ライデン_011]
		//俺は出来ることならローズの
		//手料理よりもずっとこのレーションで
		//過ごしたい。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_レーション:プリスキン_012]
		//……お前、意外と苦労してるんだな。
	}
}//v
}//d

//止血剤 h //e
//resource PS_止血剤
proc rp_PS_止血剤:07 {
vox t:vc212761 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_止血剤:プリスキン_000]
		//止血材を装備しているな。出血している
		//時にウィンドウで選んで○ボタンを
		//押せば出血を止めることが出来る。
	}
	talk プリスキン 標準 -m {
		 [PS_止血剤:プリスキン_001]
		//その止血材はアルギン酸塩繊維で
		//出来たシート状の吸収パッド。
		//いわゆるアルギネート材だ。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_止血剤:プリスキン_002]
		//アルギン酸塩繊維は血液や体液と接触
		//すると親水コロイドがゲル化して湿潤
		//環境を作り出し、創の治癒を促進する。
	}
	talk プリスキン 標準 -m {
		 [PS_止血剤:プリスキン_003]
		//吸収量も吸収速度も速いのが特徴だ。
		//止血効果は高いぞ。
	}
}//v
}//d

//ジアゼパム h //e
//resource PS_ジアゼパム
proc rp_PS_ジアゼパム:07 {
vox t:vc212771 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ジアゼパム:プリスキン_000]
		//ジアゼパムを持っているな。ウィンドウ
		//で選んで○ボタンで使えば狙撃銃を扱う
		//時の手ぶれを止めることが出来る。
	}
	talk プリスキン 標準 -m {
		 [PS_ジアゼパム:プリスキン_001]
		//ジアゼパムはうつ病や自律神経失調症の
		//治療に使われるベンゾジアゼピン系の
		//抗不安薬だ。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_ジアゼパム:プリスキン_002]
		//鎮静作用に加えて筋弛緩作用、
		//抗けいれん作用もある。
		//それで手ぶれが止まるというわけだ。
	}
	talk プリスキン 標準 -m {
		 [PS_ジアゼパム:プリスキン_003]
		//別にジアゼパム自体に船酔いを止める
		//効能があるわけじゃない。覚えておけよ。
	}
	talk ライデン 標準 -m {
		 [PS_ジアゼパム:ライデン_004]
		//船酔い？なにをいってるんだ？
	}
@rp_キテレツさん＿否２＿意味不明系デフォルト 50
	talk プリスキン 標準 -m {
		 [PS_ジアゼパム:プリスキン_005]
		//信念が科学的効能を凌駕する場合も
		//あるということだ。
	}
	talk ライデン 標準 -m {
		 [PS_ジアゼパム:ライデン_006]
		//一体……？
	}
@rp_かみあわない＿否１＿話聞けよ系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_ジアゼパム:プリスキン_007]
		//気にするな。
	}
}//v
}//d


//ボディアーマー h //e
//resource PS_ボディアーマー
proc rp_PS_ボディアーマー:07 {
vox t:vc212781 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ボディアーマー:プリスキン_000]
		//ボディ・アーマーを着ているな。
		//それを装備していればダメージを
		//かなり抑えられるはずだ。
	}
	talk プリスキン 標準 -m {
		 [PS_ボディアーマー:プリスキン_001]
		//ボディアーマーには高機能高分子素材を
		//応用した特殊繊維が織り込まれている。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_ボディアーマー:プリスキン_002]
		//特殊繊維が着弾した弾丸にまとわりつき、
		//運動エネルギーを吸収・伝播して
		//ダメージを抑えるというような仕組みだ。
	}
	talk プリスキン 標準 -m {
		 [PS_ボディアーマー:プリスキン_003]
		//だがあくまでダメージを抑えるだけで
		//ゼロに出来るわけじゃない。
		//過信はするなよ。
	}
}//v
}//d

//resource PS_ＡＫ１
proc rp_PS_ＡＫ１:07 {
vox t:vc212791 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ＡＫ１:プリスキン_000]
		//ＡＫ７４Ｕを装備しているな。
	}
}//v
}//d
//resource PS_ＡＫ２
proc rp_PS_ＡＫ２:07 {
vox t:vc212801 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ＡＫ２:プリスキン_000]
		//敵の野戦服を着てＡＫを装備すれば
		//敵兵士に変装出来るだろう。
	}
}//v
}//d
//resource PS_ＡＫ３
proc rp_PS_ＡＫ３:07 {
vox t:vc212811 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ＡＫ３:プリスキン_000]
		//ＡＫは操作が簡単で精度・信頼性ともに
		//極めて高いライフルだ。
	}
	talk プリスキン 標準 -m {
		 [PS_ＡＫ３:プリスキン_001]
		//それはＡＫが世界各国でライセンス生産、
		//コピーされている事実からも明らか
		//だろう。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_ＡＫ３:プリスキン_002]
		//新型ライフル設計の参考とされることも
		//しばしばだ。
	}
	talk プリスキン 標準 -m {
		 [PS_ＡＫ３:プリスキン_003]
		//イスラエルのガリルやフィンランドの
		//ヴァルメなどもＡＫの基本構造を
		//踏襲して設計されている。
	}
	talk プリスキン 標準 -m {
		 [PS_ＡＫ３:プリスキン_004]
		//お前が持っているのはＡＫＳ７４を
		//特殊部隊向けに小型化したタイプだ。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100

	talk プリスキン 標準 -m {
		 [PS_ＡＫ３:プリスキン_005]
		//ストックを伸ばしても全長は７２６ｍｍしかない。
	}
	talk プリスキン 標準 -m {
		 [PS_ＡＫ３:プリスキン_006]
		//狭い場所でも戦闘の妨げにはならない
		//ということだな。
	}
}//v
}//d
//サプレッサー装備していない場合 t //e
//resource PS_ＡＫ＿サプレッサーない
proc rp_PS_ＡＫ＿サプレッサーない:07 {
vox t:vc212812 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ＡＫ＿サプレッサーない:プリスキン_000]
		//ＡＫにはサプレッサーを装備することも
		//出来る。サプレッサーがあれば銃声を
		//気にする必要はなくなるだろう。
	}
}//v
}//d
//サプレッサー装備している場合 t //e
//resource PS_ＡＫ＿サプレッサーある
proc rp_PS_ＡＫ＿サプレッサーある:07 {
vox t:vc212813 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ＡＫ＿サプレッサーある:プリスキン_000]
		//サプレッサーも装備しているな。
		//発砲しても銃声で敵に気づかれる
		//心配はないだろう。
	}
}//v
}//d

//resource PS_ＡＫ４
proc rp_PS_ＡＫ４:07 {
vox t:vc212821 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ＡＫ４:プリスキン_000]
		//覚えておくべきなのは、ＡＫを装備して
		//いるのはシェル１中央棟の連中だけだ
		//ということだ。
	}
	talk プリスキン 標準 -m {
		 [PS_ＡＫ４:プリスキン_001]
		//他の奴等はロシア陸軍の正式ライフル
		//ＡＮ９４を装備している。
	}
	talk プリスキン 標準 -m {
		 [PS_ＡＫ４:プリスキン_002]
		//つまりシェル１中央棟以外では
		//ＡＫを使った変装は通用しないという
		//ことだ。忘れるなよ。
	}
}//v
}//d


//ソーコムの一言うんちく h //e
//resource PS_ソーコム＿コックアンドロック
proc rp_PS_ソーコム＿コックアンドロック:07 {
vox t:vc212831 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ソーコム＿コックアンドロック:プリスキン_000]
		//お前に渡したソーコムの
		//トリガーメカニズムは基本的に
		//ダブルアクションになっている。
	}
	talk プリスキン 標準 -m {
		 [PS_ソーコム＿コックアンドロック:プリスキン_001]
		//だが用兵側からは撃鉄を上げたまま
		//安全装置をかけるコックアンドロックも
		//可能なことが要求されたんだ。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_ソーコム＿コックアンドロック:プリスキン_002]
		//人質救出作戦などではコンマ一秒を争い、かつ非常な射撃精度が必要になる。
	}
	talk プリスキン 標準 -m {
		 [PS_ソーコム＿コックアンドロック:プリスキン_003]
		//初弾ダブルアクションから次弾以降
		//シングルアクションへの移行が
		//伴うことを、彼らは嫌ったんだ。
	}
	talk プリスキン 標準 -m {
		 [PS_ソーコム＿コックアンドロック:プリスキン_004]
		//コックアンドロック。つまり撃鉄を
		//起こした状態で、セイフティをかける
		//ことで、初弾発射をより速やかに行う。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_ソーコム＿コックアンドロック:プリスキン_005]
		//それには「時間を稼ぐ」という意味も
		//あるが、コンバットシューティングを
		//念頭に置いた場合より重要なことがある。
	}
	talk プリスキン 標準 -m {
		 [PS_ソーコム＿コックアンドロック:プリスキン_006]
		//初弾もシングルアクションにすることに
		//よって初弾とそれ以降のトリガープルが
		//同じになるんだ。
	}
	talk プリスキン 標準 -m {
		 [PS_ソーコム＿コックアンドロック:プリスキン_007]
		//それによって、よりスムーズな連射を
		//行うことが出来るようになるという
		//わけだな。
	}
}//v
}//d

//再追加 d //e
//resource PS_プラント偽装
proc rp_PS_プラント偽装:07 {
vox t:vc212841 {
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		 [PS_プラント偽装:オタコン_000]
		//『ビッグ・シェル』全体が偽装だって
		//いう話は本当だ。
	}
	talk ライデン 標準 -m {
		 [PS_プラント偽装:ライデン_001]
		//オタコン？
	}
	talk オタコン 標準 -m {
		 [PS_プラント偽装:オタコン_002]
		//スネークにもあちこち調べてもらった。確かに海洋除染施設としての設備を備え
		//てはいるけど、フル稼動はしていない。
	}
	talk オタコン 標準 -m {
		 [PS_プラント偽装:オタコン_003]
		//そもそもあの事件から２年も経つのに
		//原油が回収しきれていないというのが
		//おかしいだろ？
	}
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		 [PS_プラント偽装:オタコン_004]
		//勿論、どこの報道機関もそんなこと
		//伝えないけどね。多分、どこかから
		//原油を運んできて補充してるんだと思う。
	}
	talk オタコン 標準 -m {
		 [PS_プラント偽装:オタコン_005]
		//君の聞かされてたプラントが爆発したら
		//有毒化学物質が発生するっていう話も
		//かなり変だ。多分本当じゃないだろう。
	}
	talk オタコン 標準 -m {
		 [PS_プラント偽装:オタコン_006]
		//情報は高度に隠蔽されてる。奴等に
		//とって、新型メタルギアはそれくらいの
		//手間とカネをかける価値があるんだろう。
	}
	talk ライデン 標準 -m {
		 [PS_プラント偽装:ライデン_007]
		//……すっかり騙されていたってわけか……。
	}
	talk オタコン 標準 -m {
		 [PS_プラント偽装:オタコン_008]
		//いや、君の上官だって知らなかった
		//んだと思うよ。そう言ってるんだろ。
	}
	talk ライデン 標準 -m {
		 [PS_プラント偽装:ライデン_009]
		//大佐にじゃない、あんた達にだ。
	}
@rp_うなづきデフォルト＿是
@rp_邪道外道＿否２＿ひどい系デフォルト 100
	talk オタコン 標準 -m {
		 [PS_プラント偽装:オタコン_010]
		//え？騙してなんかいないよ。
		//言わなかっただけじゃないか。
	}
	talk ライデン 標準 -m {
		 [PS_プラント偽装:ライデン_011]
		//……。
	}
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		 [PS_プラント偽装:オタコン_012]
		//はは。面白い人だな、君って。
		//スネークの言ってた通りだ。
	}
	talk ライデン 標準 -m {
		 [PS_プラント偽装:ライデン_013]
		//……奴はなんて？
	}
@rp_うなづきデフォルト＿是
@rp_邪道外道＿否２＿ひどい系デフォルト 100
	talk オタコン 標準 -m {
		 [PS_プラント偽装:オタコン_014]
		//単純軟弱石頭。
	}
	talk ライデン 標準 -m {
		 [PS_プラント偽装:ライデン_015]
		//……たんじゅんなんじゃく……。
	}
	talk オタコン 標準 -m {
		 [PS_プラント偽装:オタコン_016]
		//あ、いや悪い意味じゃないと思うよ。
		//……多分。
	}
	talk ライデン 標準 -m {
		 [PS_プラント偽装:ライデン_017]
		//どこが！悪意の塊じゃないか！
		//あいつの方こそ嘘つきの役立たずの
		//ひねくれ者のカッコつけのスカした……
	}
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		 [PS_プラント偽装:オタコン_018]
		//ライデン、僕は彼の友達だ。
		//スネークのことはよく知ってる。
		//彼は断じてそんな男じゃない。
	}
	talk ライデン 標準 -m {
		 [PS_プラント偽装:ライデン_019]
		//はっ、どうだか？
	}
	talk オタコン 標準 -m {
		 [PS_プラント偽装:オタコン_020]
		//それに……スネークについて君も知って
		//おいた方がいいと思うことが一つある。
	}
	talk ライデン 標準 -m {
		 [PS_プラント偽装:ライデン_021]
		//なんだ？
	}
	talk オタコン 標準 -m {
		 [PS_プラント偽装:オタコン_022]
		//今、となりにいる。
	}
	talk ライデン 標準 -m {
		 [PS_プラント偽装:ライデン_023]
		//……あんたの？
	}
	talk オタコン 標準 -m {
		 [PS_プラント偽装:オタコン_024]
		//ああ。
	}
	talk ライデン 標準 -m {
		 [PS_プラント偽装:ライデン_025]
		//話も？
	}
	talk オタコン 標準 -m {
		 [PS_プラント偽装:オタコン_026]
		//聞いてる。
	}
	@rpd_プリスキン顔表示
@rp_うなづきデフォルト＿是
@rp_邪道外道＿否１＿サイテー系デフォルト 100
	talk プリスキン 標準 -m {
		 [PS_プラント偽装:プリスキン_027]
		//……。
	}
	talk ライデン 標準 -m {
		 [PS_プラント偽装:ライデン_028]
		//に、任務に戻る……。
	}
}//v
}//d


