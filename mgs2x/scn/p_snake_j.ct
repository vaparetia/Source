	}
}//v
}//d


//デフォルト会話 d //e
//消火器 h //e
//resource PS_標準＿消火器
proc rp_PS_標準＿消火器:07 {
vox t:vc211381 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_標準＿消火器:プリスキン_000]
		//消火器を撃つと中身の消火剤が
		//勢いよく吹き出す。
		//敵を撹乱することが出来るだろう。
	}
	talk プリスキン 標準 -m {
		 [PS_標準＿消火器:プリスキン_001]
		//敵に追われている時にやってみるといい。
		//ものは使いようということだ。
	}
}//v
}//d
//パイプ h //e
//resource PS_標準＿蒸気パイプ
proc rp_PS_標準＿蒸気パイプ:07 {
vox t:vc211391 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_標準＿蒸気パイプ:プリスキン_000]
		//天井や床のパイプには撃つと熱い
		//水蒸気が吹き出すものがある。
	}
	talk プリスキン 標準 -m {
		 [PS_標準＿蒸気パイプ:プリスキン_001]
		//蒸気をうまく使えば敵を撹乱したり
		//傷を負わせたりすることが出来るはずだ。
		//まわりの状況全てを利用しろ。
	}
}//v
}//d

//投擲距離 h //e
//resource PS_投擲距離
proc rp_PS_投擲距離:07 {
vox t:vc211401 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_投擲距離:プリスキン_000]
		//各種グレネードやマガジンなど
		//手で投げるものは□ボタンを押すと
		//構え、□ボタンを離すと投げる。
	}
	talk プリスキン 標準 -m {
		 [PS_投擲距離:プリスキン_001]
		//この時□ボタンを押し込む強さを
		//変えれば投擲距離を変えられるという
		//ことを覚えておけ。
	}
	talk プリスキン 標準 -m {
		 [PS_投擲距離:プリスキン_002]
		//必要な時にもっとも効果的な場所へ
		//投げ込めるようにしておくんだ。
	}
}//v
}//d
