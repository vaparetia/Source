//resource PS_ＤＧ連絡橋＿海鳥ズバリ
proc rp_PS_ＤＧ連絡橋＿海鳥ズバリ:07 {
vox t:vc210571 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ＤＧ連絡橋＿海鳥ズバリ:プリスキン_000]
		//海鳥の影に制御装置が隠れているんじゃ
		//ないか？海鳥をどかすんだ。まわりに
		//何発か撃ち込んでみろ。
	}
}//v
}//d

//旗の後ろ h //e
//resource PS_ＤＧ連絡橋＿旗ヒント
proc rp_PS_ＤＧ連絡橋＿旗ヒント:07 {
vox t:vc210581 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ＤＧ連絡橋＿旗ヒント:プリスキン_000]
		//そういえば、旗が立ってたのを
		//憶えている。風向きによってなびく
		//方向が変わったな……。
	}
}//v
}//d
//resource PS_ＤＧ連絡橋＿旗ズパリ１
proc rp_PS_ＤＧ連絡橋＿旗ズパリ１:07 {
vox t:vc210591 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ＤＧ連絡橋＿旗ズパリ１:プリスキン_000]
		//旗の後ろをよく見るんだ。
		//制御装置が隠れているぞ。
	}
}//v
}//d
//resource PS_ＤＧ連絡橋＿旗ズパリ２
proc rp_PS_ＤＧ連絡橋＿旗ズパリ２:07 {
vox t:vc210601 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ＤＧ連絡橋＿旗ズパリ２:プリスキン_000]
		//旗越しに制御装置を撃つことも出来るが、
		//気をつけた方がいい。制御装置の隣に
		//セムテックスも仕掛けられているようだ。
	}
	talk プリスキン 標準 -m {
		 [PS_ＤＧ連絡橋＿旗ズパリ２:プリスキン_001]
		//間違ってセムテックスを撃ってしまった
		//ら終わりだぞ。風向きが変わって旗の
		//向こう側が見えた時に狙うんだ。
	}
}//v
}//d

//サイファー h //e
//resource PS_ＤＧ連絡橋＿サイファーヒント
proc rp_PS_ＤＧ連絡橋＿サイファーヒント:07 {
vox t:vc210611 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ＤＧ連絡橋＿サイファーヒント:プリスキン_000]
		//そういえば、サイファーが飛んでいて
		//苦労した覚えがある……。
	}
}//v
}//d
//resource PS_ＤＧ連絡橋＿サイファーズバリ１
proc rp_PS_ＤＧ連絡橋＿サイファーズバリ１:07 {
vox t:vc210621 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ＤＧ連絡橋＿サイファーズバリ１:プリスキン_000]
		//飛んでいるサイファーを良く見るんだ。
		//赤外線センサーの制御装置がつけられて
		//いるぞ。
	}
}//v
}//d
//resource PS_ＤＧ連絡橋＿サイファーズバリ２
proc rp_PS_ＤＧ連絡橋＿サイファーズバリ２:07 {
vox t:vc210631 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ＤＧ連絡橋＿サイファーズバリ２:プリスキン_000]
		//制御装置はサイファーのカメラ部分の
		//真上だ。だがサイファーのカメラは
		//絶対に撃つな。
	}
	talk プリスキン 標準 -m {
		 [PS_ＤＧ連絡橋＿サイファーズバリ２:プリスキン_001]
		//サイファーを撃墜してしまうと
		//信号が送られて連絡橋全体が爆発する
		//仕掛けになっているようだ。
	}
	talk プリスキン 標準 -m {
		 [PS_ＤＧ連絡橋＿サイファーズバリ２:プリスキン_002]
		//サイファー上部についた制御装置だけを
		//撃ちぬくんだ。点滅するランプを狙え。
	}
}//v
}//d
//後ろ側 h //e
//resource PS_ＤＧ連絡橋＿後ろ側ヒント１
proc rp_PS_ＤＧ連絡橋＿後ろ側ヒント１:07 {
vox t:vc210641 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ＤＧ連絡橋＿後ろ側ヒント１:プリスキン_000]
		//制御装置がシェル２の方にばかり
		//あるとは限るまい。よくまわりを
		//見てみるんだ。
	}
}//v
}//d
//resource PS_ＤＧ連絡橋＿後ろ側ズバリ１
proc rp_PS_ＤＧ連絡橋＿後ろ側ズバリ１:07 {
vox t:vc210651 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ＤＧ連絡橋＿後ろ側ズバリ１:プリスキン_000]
		//シェル１側、Ｄ脚の方を主観で
		//よく見てみろ。扉の上に制御装置が
		//ついているぞ。それも壊すんだ。
	}
}//v
}//d


//★P045_01_P01ハリアー登場１ポリゴンデモ１終了＜フラグ＜P046_01_P01ハリアー戦勝利１ポリゴンデモ１開始 d //e
