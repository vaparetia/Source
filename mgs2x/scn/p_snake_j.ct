		//仕掛けてあった。お前もよく見てみる
		//んだ。
	}
}//v
}//d



//ピーターのこと h //e
//resource PS_ピーター
proc rp_PS_ピーター:07 {
vox t:vc210391 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PS_ピーター:ライデン_000]
		//プリスキン、あんたスティルマンのこと、
		//なんか知ってるか？
	}
	talk プリスキン 標準 -m {
		 [PS_ピーター:プリスキン_001]
		//爆弾処理の専門家だ。
		//おそらく世界一の、な。
	}
	talk ライデン 標準 -m {
		 [PS_ピーター:ライデン_002]
		//他には？
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ピーター:プリスキン_003]
		//他？
	}
	talk ライデン 標準 -m {
		 [PS_ピーター:ライデン_004]
		//教会の事故とか……。
	}
	talk プリスキン 標準 -m {
		 [PS_ピーター:プリスキン_005]
		//……お前の趣味はゴシップ集めか？
	}
	talk ライデン 標準 -m {
		 [PS_ピーター:ライデン_006]
		//……いや……。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ピーター:プリスキン_007]
		//知りたければ本人に聞けばいい。
		//くだらんことを気にしている暇が
		//あったらさっさとＣ４を処理しろ。
	}
}//v
}//d



//ファットマンについて h //e
//resource PS_ファットマン１
proc rp_PS_ファットマン１:07 {
vox t:vc210401 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ファットマン１:プリスキン_000]
		//ファットマンか……。
		//名前の由来は原爆らしいが、
		//俺に言わせれば、ａ ｆａｔｍａｎ。
	}
	talk プリスキン 標準 -m {
		 [PS_ファットマン１:プリスキン_001]
		//見せ物小屋にいる太った男だ。
	}
	talk プリスキン 標準 -m {
		 [PS_ファットマン１:プリスキン_002]
		//暇さえあれば、グロックを組立て、
		//また解体する。手先を常に動かして
		//いないと落ちつかないらしい。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_ファットマン１:プリスキン_003]
		//指先が女性のように細く綺麗で、
		//それを何よりの自慢にしている。
	}
	talk プリスキン 標準 -m {
		 [PS_ファットマン１:プリスキン_004]
		//いつも手をかざして、マニキュアを
		//塗ったり指の手入れに余念がないそうだ。
	}
}//v
}//d

//段ボールを被ったスネークを目撃した後 h //e
//resource PS_怪奇箱男
proc rp_PS_怪奇箱男:07 {
vox t:vc210411 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PS_怪奇箱男:ライデン_000]
		//プリスキン、さっきダンボールを
		//かぶった人間を見たんだが、
		//あれは一体……？
	}
	talk プリスキン 標準 -m {
		 [PS_怪奇箱男:プリスキン_001]
		//箱？知らんな。（すっとぼけ）
		//夢でも見たんじゃないか？
	}
	talk ライデン 標準 -m {
		 [PS_怪奇箱男:ライデン_002]
		//そんなことはない。
		//……デッドセルの一人だろうか？
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_怪奇箱男:プリスキン_003]
		//さあな。
	}
	talk ライデン 標準 -m {
		 [PS_怪奇箱男:ライデン_004]
		//あんな奴とは戦いたくないな……。
	}
	talk プリスキン 標準 -m {
		 [PS_怪奇箱男:プリスキン_005]
		//どうして？
	}
	talk ライデン 標準 -m {
		 [PS_怪奇箱男:ライデン_006]
		//あからさまにカッコ悪いじゃないか。
		//正気とは思えない。きっと相当頭の
		//イカれた奴なんだ……。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_怪奇箱男:プリスキン_007]
		//……そうかもな。
	}
}//v
}//d


//★＜P022_01_R01爆弾解体最後から二つ目１無線デモ１終了＜フラグ＜P023_01_R01爆弾解体最後の一つ１無線デモ１開始 d //e
