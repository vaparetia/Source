//resource PS_刀練習しろ
proc rp_PS_刀練習しろ:07 {
vox t:vc211071 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_刀練習しろ:プリスキン_000]
		//刀の扱い方に馴れておけ。
		//必ず必要になる。
	}
}//v
}//d

//刀の説明 h //e
//resource PS_刀説明１
proc rp_PS_刀説明１:07 {
vox d:_vc211081 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_刀説明１:プリスキン_000]
		//刀の操作は右スティックを使う。
		//右スティックを上下に振れば上下に斬り、
		//左右に動かせば水平になぎ払う。
	}
}//v
}//d
//resource PS_刀説明２
proc rp_PS_刀説明２:07 {
vox d:_vc211091 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_刀説明２:プリスキン_000]
		//右スティックを一回転させるように
		//まわせば回転斬りだ。
	}
}//v
}//d
//resource PS_刀説明３
proc rp_PS_刀説明３:07 {
vox d:_vc211101 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_刀説明３:プリスキン_000]
		//右スティックを押し込めば突きが出せる。
		//通常の攻撃よりもリーチが長く強力だが、
		//隙も大きい。そこは注意しろ。
	}
}//v
}//d
//resource PS_刀説明＿防御１
proc rp_PS_刀説明＿防御１:07 {
vox t:vc211111 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_刀説明＿防御１:プリスキン_000]
		//刀の装備中に□ボタンを押せば防御だ。
		//□ボタンを押している間、敵の銃弾を
		//弾き返すことが出来る。
	}
}//v
}//d
//resource PS_刀説明＿防御２
proc rp_PS_刀説明＿防御２:07 {
vox d:_vc211121 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_刀説明＿防御２:プリスキン_000]
		//刀の装備中にＬ１ボタンを押せば防御だ。
		//Ｌ１ボタンを押している間、敵の銃弾を
		//弾き返すことが出来る。
	}
}//v
}//d

//resource PS_刀説明＿防御３
proc rp_PS_刀説明＿防御３:07 {
vox t:vc211131 {
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PS_刀説明＿防御３:プリスキン_000]
		//だが気をつけろ。
		//防御が有効なのは前方からの攻撃に
		//対してだけだ。
	}
}//v
}//d

