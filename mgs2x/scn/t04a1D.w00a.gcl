// プレイヤー
// ------------------------------------



// エフェクト関係
// ------------------------------------
proc 天球_新空_新雷セット {
	chara 天球 背景

	chara 新空 new_sky \
		    -m w00_sky

	chara 新雷フラッシュ thunder
}

proc 霧雨セット {
print '霧雨開始'
	chara 霧雨 霧雨
print '霧雨終了'
}

proc 岡嶋ブラーセット {
print 'blur!!!!!!!!'
	chara ブラー okajibura
print 'blur!!!!!!!!????????????'
}

proc tanker_upper_on {
	mesg プットオブジェ タンカー on
}

proc tanker_upper_off {
print 'タンカー上構部消去'
print 'superstrucure_off'
	mesg プットオブジェ タンカー off
print 'superstrucure_off'
print 'タンカー上構部消去'
}

proc タンカーセット {
	chara プットオブジェ タンカー \
		-m w00a \
		-r 0 0 0 \
		-p 0 0 0 \
		-s 100 100 100 \
		-l d:STAGE_LT2_0 \
		-f 0x0010

	chara 煙突煙 smoke \
		-n 4 \
		-p	 4000,25000,-1000 \
			 4000,25000,-3000 \
			-4000,25000,-1000 \
			-4000,25000,-3000

	chara プットオブジェ ウィンドラス -m w00a_winch -r 0 0 0 -p 0 0 0  -l d:STAGE_LT2_0 -s 100 100 100

	chara プットオブジェ 船首１ -m w00_f1 -r 0 0 0 \
		-p 0 0 -180000 \
		-l w01e \
		-s 100 100 100
	chara プットオブジェ 船首２ -m w00_f2 -r 0 0 0 \
		-p 0 0 -120000 \
		-l w01e \
		-s 100 100 100
	chara プットオブジェ 船首３ -m w00_f3 -r 0 0 0 \
		-p 0 0 -60000 \
		-l w01e \
		-s 100 100 100
	chara プットオブジェ 船首４ -m w00_f4 -r 0 0 0 \
		-p 0 0 0  \
		-l w01e \
		-s 100 100 100

}

proc 艦橋五階消去 {
	mesg プットオブジェ 五階 off
	mesg プットオブジェ 五階天井 off
	mesg プットオブジェ 死体たち off
	mesg プットオブジェ 死体映り込み off
	mesg プットオブジェ 水密ドア／右舷５Ｆ off
	mesg プットオブジェ 水密ドア／左舷５Ｆ off

	mesg 位置指定雨 rain_左 オフ
	mesg 位置指定雨 rain_中央 オフ
}

proc 艦橋五階セット {
	@w01eのプリシェード平環光セット < w01eの平行光環境光セット

	chara プットオブジェ 五階 -m w01e -r 0 0 0 -p 0 0 -15000  -l d:STAGE_LT2_0 -s 100 100 100
	chara プットオブジェ 五階天井 -m w01er -r 0 0 0 -p 0 0 -15000  -l d:STAGE_LT2_0 -s 100 100 100

	@w00aのプリシェード平環光セット < w00aの平行光環境光に復帰
}

proc ゴル兵降下右舷ウイングセット {
	@w00cのプリシェード平環光セット < w00cの平行光環境光セット

	chara プットオブジェ ゴル兵用右舷ウイング -m w00c -r 0 0 0 -p 0 0 0  -l d:STAGE_LT2_0 -s 100 100 100
	mesg プットオブジェ ゴル兵用右舷ウイング off
	@w00aのプリシェード平環光セット < w00aの平行光環境光に復帰
}

proc right_wing_on {
	mesg プットオブジェ ゴル兵用右舷ウイング on
	mesg プットオブジェ w00c水密ドア／右舷５Ｆ on
}

proc right_wing_off {
	mesg プットオブジェ ゴル兵用右舷ウイング off
	mesg プットオブジェ w00c水密ドア／右舷５Ｆ off
}

proc 風制御セット {
	chara 風制御 wind \
		-i 100 \			// 通常風速のＭＡＸ値
		-j 300 \			// 突風風速のＭＡＸ値
		-r -1024 1024 0 \	// 通常風の方向（0 0 0 で真下に向かって吹く）
		-a 4 \				// 方向のランダム幅（4096で360度を表す）
		-b 300 \			// 突風頻度（何フレームに一回（目安））
		-c 150				// 突風持続時間のＭＡＸ値（フレーム数）
}

proc 雨セット {
	chara 位置指定雨 rain_左 \
		-n 10 \
		-c (128+64) \
		-b -10000 18000 (-26000-15000) -7000 10000 (-15000-15000)
	chara 位置指定雨 rain_中央 \
		-n 24 \
		-c (128+64) \
		-b -7000 18000 (-26000-15000) 7500 10000 (-23000-15000)
/*
	chara 位置指定雨 rain_右 \
		-n 6 \
		-c 90 \
		-b 7500 18000 (-26000-15000) 11000 10000 (-15000-15000)
*/
}

proc 波面セット {

print 'wave_set'

		//中心位置から10ユニットずつ前後左右に広がります。(デフォルト 0,-2000, 0)
		//うねり周期は、0 厳禁。周期なので大きいほど遅くなります。(デフォルト 256)
		chara 波面 wave \
			-p 0,-6000,0 \	// 中心位置
			-s 128 \		// うねりの周期














			-n 3 \			// 波濤の数














			-w 5 5 \
			-b 	     0,200,  20500,6,    0,  0 \	// 並び順： posx, posy, posz, size, roty, alpha
				 18000,500,-255000,8, 1251,-25 \
				-18000,500,-245000,8,-1251,-25 \
			-x 0,-135500 20000,132500		// (前2つ)非表示領域位置：中心座標 ／ (後2つ)非表示領域：幅/奥行
			// posx posz 波涛出現位置
			// posy      波涛発生高さの条件














			// size      波涛の高さ
			// roty      波涛の向き（4096 = 360deg）
			// alpha     波涛のα調整（-薄い  +濃い）

		chara 嵐の川波 高波 \
			-tex wave wave06 wave09_alp_ovl \
			-dir 100,-20,100 \		// ローカル並行光ベクトル














			-color 160,160,160 \	// 平行光ＲＧＢ
			-ambient 10,10,10 \		// 環境光ＲＧＢ
			-pos 0,-4000,0

print 'wave_set_end!!!!!!!!!!'
}

proc フォグセット {
	chara フォグ 霧 \
		 -c 16 32 27 \		// ＲＧＢ
		 -n -5000 \			// ニア値
		 -f 1600000			// ファー値
}

proc 川岸のぼかし {
	chara 遠景ぼかし far_blur \
		-plane	2 \			// 枚数














		-near	50000 \		// ニア値
		-far	100000 \	// ファー値
		-enable
}

proc da_キャラクタ専用ライトセット $:環境光Ｒ $:環境光Ｇ $:環境光Ｂ $:平行光Ｒ $:平行光Ｇ $:平行光Ｂ $:平行光光源Ｘ $:平行光光源Ｙ $:平行光光源Ｚ {
print 'chara_light_start'
	chara 環境光 アンビ \
		 -c $:環境光Ｒ $:環境光Ｇ $:環境光Ｂ
//		 -c 6 20 30

	chara 平行光 パラ \
		 -c $:平行光Ｒ $:平行光Ｇ $:平行光Ｂ \
		 -d $:平行光光源Ｘ $:平行光光源Ｙ $:平行光光源Ｚ
//		 -c 86 85 48 \
//		 -d -1287 -3357 -5545
print 'chara_light_end'
}

proc カメラ雨セット {
print 'camera_rain_set'
	//「プットテクスチャクロスフェードカメラ」と
	//「プットテクスチャクロスフェードカメラドア」の前にセットする












print 'カメラ雨'

	chara カメラ雨 カメラ雨 \
		-l 1 \
		-i 1	// 不可視起動
print 'カメラ雨終了'
}

proc カメラ雨オン {
	print 'カメラ雨オン'
	mesg カメラ雨 カメラ雨 カメラ前水飛沫出っ放し
	mesg カメラ雨 カメラ雨 カメラ前水飛沫制御オフ
}

proc カメラ雨オフ {
	print 'カメラ雨オン'
	mesg カメラ雨 カメラ雨 カメラ前水飛沫出っ放し
	mesg カメラ雨 カメラ雨 カメラ前水飛沫制御オン




}


