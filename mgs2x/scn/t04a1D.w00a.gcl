proc 投光器セット {

	// d00a0 d00a1 d00a2 d00a3

	// 左舷スポットライト
	// ライトのビーム

	chara 固定ボリュームライト 左舷投光器 \
		-p -19670,13610,-14914 \
		-d 0,19000,-11000 \
		-n 32 \		// 16 (max=32)
		-l 15000 \	// 15000
		-w 1000		// 1000
	// 投光器のモデル

	chara プットオブジェ 左舷の投光器 \
		-m w00_sl2 \
		-r 0 0 0 \
		-p 0 0 0 \
		-l d:STAGE_LT2_0 \
		-s 100 100 100
	// ライトのビーム中の、光る雨
	chara スポット雨 光る雨左舷投光器 \
		-from -19765, 14710, -14914 \
		-to    8600, 17870, -12000 \
		-ratio  50 \
		-sphere 6000

	// 右舷スポットライト
	// ライトのビーム

	chara 固定ボリュームライト 右舷投光器 \
		-p 19670,13610,-14914 \
		-d 0,19000,-11000 \
		-n 32 \		// 16 (max=32)
		-l 15000 \	// 15000
		-w 1000		// 1000
	// 投光器のモデル

	chara プットオブジェ 右舷の投光器 \
		-m w00_sl1 \
		-r 0 0 0 \
		-p 0 0 0 \
		-l d:STAGE_LT2_0 \
		-s 100 100 100
	// ライトのビーム中の、光る雨
	chara スポット雨 光る雨左舷投光器 \
		-from 19765, 14710, -14914 \
		-to   -8600, 17870, -12000 \
		-ratio  50 \
		-sphere 6000

}

proc クレーン_旗_ワイヤーセット {
	chara ロープモデル２ クレーンワイヤー \
		-n w00a_ch1 \
		-x -10950 7970 6610 \
		-d 0 

	chara プット頂点アニメオブジェ 旗         -m w00_vfg -b 5 -w 1 -p 0,0,0
	chara プット頂点アニメオブジェ ワイヤー１ -m w00_vw1 -b 5 -w 1 -p 0,0,0
	chara プット頂点アニメオブジェ ワイヤー２ -m w00_vw2 -b 5 -w 1 -p 0,0,0
	chara プット頂点アニメオブジェ ワイヤー３ -m w00_vw3 -b 5 -w 1 -p 0,0,0
	chara プット頂点アニメオブジェ ワイヤー４ -m w00_vw4 -b 5 -w 1 -p 0,0,0
	chara プット頂点アニメオブジェ ワイヤー５ -m w00_vw5 -b 5 -w 1 -p 0,0,0
	chara プット頂点アニメオブジェ ワイヤー６ -m w00_vw6 -b 5 -w 1 -p 0,0,0
}

proc レーダークルクル {
	chara くるくる物体 radar \
		-k w00_radar \
		-p -1500 25600 -15400 \
		-r 32 \
		-s 1 \
		-d 2 200 200 48
}

proc 死体の映り込みセット {
	@w01eのプリシェード平環光セット < w01eの平行光環境光セット
	chara プットオブジェ 死体映り込み \
		-m tnc_died_obj_mirror -r 0 0 0 -p 0 0 -15000 -l w01e -s 100 100 100
	@w00aのプリシェード平環光セット < w00aの平行光環境光に復帰
}

proc 床面映り込みスネーク {
	// スネーク用
	chara 鏡面モデル管理 映り込みスネーク \
		-pos 0,12000,0 \
		-axis 1 // Y軸反転
}

/* 以下のライトで、
「＊＊＊のプリシェード平環光セット」はプリシェードモデルを置く直前でセット、
置き終わったら元のものに戻す。
「＊＊＊のキャラ平環光セット」はマックスの方で、随時呼び出すために用意した */
/* このステージでは、マップ設定でセットしているのは w00a.lt2 である */

// w01eステージにあたる場所での平行、環境光

proc w01eのキャラ平環光セット {

	chara 環境光 w01e環境光 \
		 -c 73 89 121 
	chara 平行光 w01e平行光 \
		 -c 61 142 174 \
		 -p -100 -3500 -2000
}
proc w01eのプリシェード平環光セット {

	chara 環境光 w01e環境光 \
		 -c 73 89 121 
	chara 平行光 w01e平行光 \
		 -c 61 142 174 \
		 -p 0 -4300 -2500
}

// w00aステージにあたる場所での平行、環境光

proc w00aのキャラ平環光セット {

	chara 環境光 w00a環境光 \
		 -c 4 35 44
	chara 平行光 w00a平行光 \
		 -c 54 86 70 \
		 -d 321 1705 0 // これはrot
}
proc w00aのプリシェード平環光セット {

	chara 環境光 w00a環境光 \
		 -c 28 31 33
	chara 平行光 w00a平行光 \
		 -c 63 80 70 \
		 -p 3800 -3200 -100
}

// w00cステージにあたる場所での平行、環境光

proc w00cのキャラ平環光セット {
	// w00bのものを流用
	chara 環境光 w00c環境光 \
		 -c 53,73,55
	chara 平行光 w00c平行光 \
		 -c 70,230,214 \
		 -d 691,721,0 // これはrot
}
proc w00cのプリシェード平環光セット {

	chara 環境光 w00c環境光 \
		 -c 15,31,33
	chara 平行光 w00c平行光 \
		 -c 64,64,64 \
		 -p 2200,-4300,1000
}
