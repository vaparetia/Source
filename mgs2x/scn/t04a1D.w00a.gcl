	chara プットオブジェ 水密ドア／右舷５Ｆ \
		-m demo_w00_sdr_r \
		-r 0 3072 0 \
		-p 5950,12000,(-16525-15000) \
		-l d:STAGE_LT2_0 \
		-s 100 100 100
	chara プットオブジェ 水密ドア／左舷５Ｆ \
		-m demo_w00_sdr_l \
		-r 0 3072 0 \
		-p -5950,12000,(-16525-15000) \
		-l d:STAGE_LT2_0 \
		-s 100 100 100

	@w00aのプリシェード平環光セット < w00aの平行光環境光に復帰
}

