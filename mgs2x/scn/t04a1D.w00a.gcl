// ------------------------------------
command マップ設定 ゴル兵急襲 -s {

print 'main_000'

//	デモ環境かゲーム環境かで起動を読み分ける。
// ------------------------------------
#if d:MGS2_DEMO
chara デモアクトデバッグ demodebug  -i t:test -d 'test' -l   \
	-p  霧雨セット カメラ雨オン カメラ雨オフ \
		艦橋五階消去 \
		right_wing_on right_wing_off \
		tanker_upper_on tanker_upper_off \
		w01eのキャラ平環光セット w00aのキャラ平環光セット w00cのキャラ平環光セット \
		床面映り込みスネーク
#else

	proc ld_next_stage {
		if ($f:ローポリ劇場フラグ == d:TRUE) {
			// ローポリ劇場中
				@mv_lowpoly

		} else {
			// 通常ゲーム中
			mesg デモキャンセルチェック デモキャンセル kill

			eval($w:t_story = d:ST_T04a1D艦橋カモフ発見ポリゴンデモ終了)

			chara delay ディレイ \
				-time 1 \
				-exec{
					@mv_w01d_w01e_demo
				}
		}
	}

	chara デモキャンセルチェック デモキャンセル \
		-p デモキャンセル


	proc デモキャンセル {
		command StreamStopAll
	}


	eval($w:t_story = d:ST_T04a1D艦橋カモフ発見ポリゴンデモ開始)

	proc デモ再生_t04a1D {
#if d:デモ前五秒間待ち
		chara デモアクトデバッグ demodebug  -i t:t04a1D -d 't04a1D' -l -s 't04a1D'  \
			-next ld_next_stage \			// 終了時に呼び出されるproc
			-p  霧雨セット カメラ雨オン カメラ雨オフ \
				艦橋五階消去 \
				right_wing_on right_wing_off \
				tanker_upper_on tanker_upper_off \
				w01eのキャラ平環光セット w00aのキャラ平環光セット w00cのキャラ平環光セット \
				床面映り込みスネーク
#else
		chara demo デモ再生 \
#if d:体験版
			-i t:t04a1D \
#else
			-i t:t04a1D \
#endif
			-p  霧雨セット カメラ雨オン カメラ雨オフ \
				艦橋五階消去 \
				right_wing_on right_wing_off \
				tanker_upper_on tanker_upper_off \
				w01eのキャラ平環光セット w00aのキャラ平環光セット w00cのキャラ平環光セット \
				床面映り込みスネーク \
			-next ld_next_stage			// 終了時に呼び出されるproc
#endif
	}

#if d:デモ前五秒間待ち
		@global_五秒待ちセット
		if($f:global_デバッグポーズ通過){
			@デモ再生_t04a1D
		}
#else
		@デモモデル差し替え処理
		@デモ再生_t04a1D
#endif

#endif

/*
#ifndef MGS2_DEMO
	proc ld_next_stage {}

	chara demo デモ再生 \
		-i t:t04a1D \			// ストリーミング用t:シンボル find_out_kamof
		-p  霧雨セット カメラ雨オン カメラ雨オフ \
			艦橋五階消去 \
			right_wing_on right_wing_off \
			tanker_upper_on tanker_upper_off \
			w01eのキャラ平環光セット w00aのキャラ平環光セット w00cのキャラ平環光セット \
			床面映り込みスネーク \
		-next ld_next_stage			// 終了時に呼び出されるproc
#else
chara デモアクトデバッグ demodebug  -i t:test -d 'test' -l   
#endif
*/

	//---------------------------------------------------------------
	// 外したい場合は、行の先端に「//」を入れる。
	//---------------------------------------------------------------
	@常駐キャラ設定						// stdch.hで定義
print 'main_000'
	@カメラ雨セット
print 'main_001'
	@天球_新空_新雷セット
print 'main_002'
	@岡嶋ブラーセット
print 'main_003'
	@タンカーセット
print 'main_004'
	@艦橋五階セット
print 'main_005'
	@ゴル兵降下右舷ウイングセット
print 'main_006'
	@クルー死体セット
print 'main_007'
	@窓雨セット
print 'main_008'
	@スネーク返し水飛沫セット
print 'main_009'
	@室内水密ドアセット
print 'main_010'
	@w00c水密ドアセット
print 'main_011'
	@マンハッタンセット
print 'main_012'
	@シネマスクリーンセット
print 'main_013'
	@風制御セット
print 'main_014'
	@雨セット
print 'main_015'
//	@フォグセット
print 'main_016'
	@川岸のぼかし
print 'main_017'

	@波面セット
print 'main_018'
	@タンカー上の各種エフェクトセット

	//---------------------------------------------------------------
	// 以下はシナリオ班用。
	//---------------------------------------------------------------


print 'main_019'
	@投光器セット
print 'main_020'
	@クレーン_旗_ワイヤーセット
print 'main_021'
	@レーダークルクル

	@死体の映り込みセット
print 'main_022'

	@スクリーンショット使用

} // <command マップ設定 ゴル兵急襲>の閉じカッコ

