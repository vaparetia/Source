//時間早い h //e
resource PP_爆弾評価＿時間早い__f {
//vox t:vc200311 {
ピーター_000: {
Tu es plut&^ot rapide. Tu ne t'en
sors pas mal pour un d&'ebutant.
}
//	<<<ENGLISH>>>
//	You're pretty fast. Well, not
//	bad for a beginner, anyway.

/*なかなか早いな。
まあ、まずまずだ。最初としてはな。
*/
スネーク_001: {
Hum... on dirait que l'entra&^inement
virtuel n'a pas &'et&'e vain.
}
//	<<<ENGLISH>>>
//	Hum... on dirait que l'entra&^inement virtuel
//	n'a pas &'et&'e vain.

//	Hmm... it looks like VR Training
//	does come in handy.

/*ふん、ＶＲ訓練も役に立つということか。
*/
//dv}//v
}//d

