//爆弾評価 時間、ゲームオーバー回数から判定 h //e
//時間掛かり過ぎ h //e
resource PP_爆弾評価＿時間超過__f {
//vox t:vc200291 {
ピーター_000: {
Tu n'es pas assez rapide. Essaie de
travailler un peu plus vite.
}
//	<<<ENGLISH>>>
//	You're taking too much time.
//	You should work a little faster.

/*時間が掛かりすぎだな。
もう少し、急いだ方がいい。
*/
スネーク_001: {
Je n'ai pas le temps, Raiden.
J'ai beaucoup &`a faire ici, alors
ne compte pas trop sur moi.
}
//	<<<ENGLISH>>>
//	There's no time, Raiden. I've got
//	my hands full here, so it doesn't
//	look like I can help you.
//<ページ数変更>
スネーク_001_1: {
D&'ebrouille-toi
}
//	<<<ENGLISH>>>
//	D&'ebrouille-toi

//	It's in your hands.

/*ライデン、時間がない。
こっちも手いっぱいだ。
お前の手伝いは出来そうにない。頼むぞ。
*/
//dv}//v
}//d

//時間普通 h //e
resource PP_爆弾評価＿時間普通__f {
//vox t:vc200301 {
ピーター_000: {
Tu es plus rapide que pr&'evu...
et plus capable que tu en as l'air.
}
//	<<<ENGLISH>>>
//	You're faster than I expected...
//	and more capable than you look.

/*意外と早かったな。
見かけよりはやるようだ。
*/
