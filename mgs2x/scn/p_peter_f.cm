//dv}//v
}//d


//-------------------------------//e
//後回し会話 d //e
//-------------------------------//e
//えらそうな爆弾警句１ h //e
resource PP_爆弾警句１__f {
//vox t:vc200721 {
ピーター_000: {
En r&'esum&'e, d&'esamorcer des bombes,
c'est se trouver face &`a face avec la peur.
}
//	<<<ENGLISH>>>
//	Put simply, bomb disposal is
//	a one-on-one with fear itself.
//<ページ数変更>
ピーター_000_1: {
N'essaies pas de fuir ta peur. Essaies
plut&^ot de l'accepter et de l'affronter.
}
//	<<<ENGLISH>>>
//	Don't try to run away from it.
//	Instead, acknowledge the fear,
//	and take it straight on. 

/*爆弾処理はすなわち恐怖との戦いだ。
恐怖から目をそらすな。
恐怖を認めてそれに立ち向かうんだ。
*/
//dv}//v
}//d
//えらそうな爆弾警句２ h //e
resource PP_爆弾警句２__f {
//vox t:vc200731 {
ピーター_000: {
Quand on d&'esarmorce une bombe,
le mot clef est "prudence".
}
//	<<<ENGLISH>>>
//	Discretion is the key
//	when taking on a bomb.

/*爆弾に向き合う時忘れてはならないのは
慎重さだ。
*/
ピーター_001: {
Un degr&'e de prudence qui met ta
m&'eticulosit&'e &`a l'&'epreuve.
}
//	<<<ENGLISH>>>
//	A degree of caution that taxes
//	your sense of meticulousness.
//<ページ数変更>
ピーター_001_1: {
A ne pas confondre avec la l&^achet&'e,
qui est tout l'inverse.
}
//	<<<ENGLISH>>>
//	Don't confuse this with cowardice,
//	as it is the extreme opposite.
//<ページ数変更>
ピーター_001_2: {
Agis avec toute la prudence et le courage
n&`ecessaires &`a l'accomplissement
de ton devoir.
}
//	<<<ENGLISH>>>
//	Carefully conduct yourself with
//	a courage that ensures you get
//	the job done right.

/*細心に細心を重ねた慎重さ。
それは臆病とは違う。むしろその対極だ。
慎重にことを運ぶ勇気を持て。
*/
//dv}//v
}//d

//えらそうな爆弾警句３ h //e
resource PP_爆弾警句３__f {
//vox t:vc200741 {
ピーター_000: {
Ecoutes, Raiden. Quoi qu'il arrive,
restes calme.
}
//	<<<ENGLISH>>>
//	Listen up, Raiden. No matter
//	what, don't be impatient.
//<ページ数変更>
ピーター_000_1: {
Le calme est probablement la seule chose
dont d&'epend enti&`erement
}
//	<<<ENGLISH>>>
//	Impatience is questionably the
//	one state of mind absolutely
//	guaranteed＃−
//<ページ数変更>
ピーター_000_2: {
ton sort lorsque tu d&'esamorces
une bombe.
}
//	<<<ENGLISH>>>
//	to seal your fate when
//	defusing a bomb.

/*いいか、ライデン。絶対に焦るな。
焦りは爆弾処理の過程において最も
死に近い精神状態と言える。
*/
ピーター_001: {
Quelle que soit la fa&~qon dont la situation
se pr&'esente, ne perds jamais ton
sang-froid. Compris ?
}
//	<<<ENGLISH>>>
//	No matter how the situation
//	presents itself, you must never
//	lose your composure. Understood?

/*いかなる状況下でも心の平静を失っては
いけない。いいな。
*/
//dv}//v
}//d


//えらそうな爆弾警句４ h //e
resource PP_爆弾警句４__f {
//vox t:vc200751 {
ピーター_000: {
Le d&'esamor&~qage, c'est aussi
une course contre la montre.
}
//	<<<ENGLISH>>>
//	Bomb disposal is also
//	a race against time.
//<ページ数変更>
ピーター_000_1: {
Le moindre doute peut faire perdre du
temps et, in&'evitablement, des vies.
}
//	<<<ENGLISH>>>
//	The slightest hesitation can lead
//	to a loss of time, and inevitably,
//	lives.

/*爆弾解体は時間との勝負でもある。
わずかな迷いが時間を奪い、
人の命をも失わせる。
*/
ピーター_001: {
Ne fais rien de pr&'ecipit&'e. Essaies
toujours d'&^etre rapide et efficace.
}
//	<<<ENGLISH>>>
//	Don't do anything rash.
//	Focus yourself on being
//	fast and efficient.

/*無駄な行動はするな。
最速・最適の行動を心がけるんだ。
*/
//dv}//v
}//d

//えらそうな爆弾警句５ h //e
resource PP_爆弾警句５__f {
//vox t:vc200761 {
ピーター_000: {
Lorsque tu te trouves face &`a une bombe,
la seule personne sur laquelle tu peux
compter, c'est toi.
}
//	<<<ENGLISH>>>
//	When dealing with a bomb directly,
//	the only one you can depend on is
//	yourself.
//<ページ数変更>
ピーター_000_1: {
Ne comptes sur personne d'autre.
Ce serait la mort assur&'ee.
}
//	<<<ENGLISH>>>
//	Don't count on anyone else.
//	Foolishly doing so will bring
//	death upon you.
//<ページ数変更>
ピーター_000_2: {
Aies confiance en toi
et tout ira bien.
}
//	<<<ENGLISH>>>
//	Believe in yourself and
//	you'll be all right.

/*爆弾と対峙した時頼れるのは自分だけだ。
他人を頼むな。その甘えは死神を
呼び込む。自分を信じるんだ。いいな。
*/
//dv}//v
}//d

//オタコンのこと h //e
resource PP_オタコン__f {
//vox t:vc200771 {
ピーター_000: {
Au fait, Raiden, est-ce que tu as vu
le technicien qui est descendu avec moi ?
}
//	<<<ENGLISH>>>
//	By the way, Raiden, did you happen
//	to see the technician that came
//	down along with me?

/*ところで、ライデン、私と一緒に
下りてきた技術者を見たか？
*/
ライデン_001: {
Non.
}
//	<<<ENGLISH>>>
//	No, I didn't.

/*いや、見ていない。*/
ピーター_002: {
... Je vois.
}
//	<<<ENGLISH>>>
//	...I see.

/*そうか……。*/
ライデン_003: {
Attends, Stillman.
Est-ce que c'est vraiment...
}
//	<<<ENGLISH>>>
//	Wait, Stillman.
//	Is that guy really...

/*なあ、スティルマン、
そいつは本当に……。
*/
スネーク_004: {
Raiden !
}
//	<<<ENGLISH(2)>>>
//	Raiden!

/*ライデン！*/
ライデン_005: {
... ?
}
//	<<<ENGLISH>>>
//	What?

/*？*/
スネーク_006: {
D&'esamorcer les C4 est notre priorit&'e
absolue. Il n'y a pas une minute &`a
perdre. Retournes au boulot.
}
//	<<<ENGLISH>>>
//	Disposing of the C4 is our
//	first priority. There's no time.
//	Get back to the task at hand.

/*今はＣ４を処理することが先決だ。
任務に戻れ。時間がないぞ。
*/
ライデン_007: {
Message re&~qu
}
//	<<<ENGLISH>>>
//	Right, I gotcha.

/*ああ、わかった……。*/
//dv}//v
}//d


//プリスキンについて h //e
resource PP_プリスキン__f {
//vox t:vc200781 {
ピーター_000: {
&~Qa doit aller pour Pliskin.
Restes vigilant toi aussi.
}
//	<<<ENGLISH>>>
//	Looks like Pliskin shouldn't be
//	having any problems. You'd 
//	better look sharp as well.

/*プリスキンの方は特に問題ないようだ。
あんたも抜かるなよ。
*/
ライデン_001: {
Stillman, tu crois que Pliskin n'est
pas membre SEAL 10... ?
}
//	<<<ENGLISH>>>
//	Stillman, do you really believe
//	that Pliskin is not a member of
//	SEAL Team 10...?

/*……スティルマン、あんた、
プリスキンは本当にＳＥＡＬ１０の
隊員ではないと？
*/
ピーター_002: {
C'est ce que je pense.
}
//	<<<ENGLISH>>>
//	He is probably not.

/*ああ。おそらくな……。*/
ライデン_003: {
Mais qu'est il, alors...?
}
//	<<<ENGLISH>>>
//	Then exactly what is he...?

/*では一体、あいつは……？*/
ピーター_004: {
Je l'ignore.
}
//	<<<ENGLISH(2)>>>
//	I'm not sure.

/*わからん。*/
ライデン_005: {
...
}
//	<<<ENGLISH>>>
//	...

/*……。*/
ピーター_006: {
Mais il y a certaines choses dont
je suis s&^ur.
}
//	<<<ENGLISH>>>
//	But there are other things
//	that I am sure of.

/*だがわかることもある。
*/
ライデン_007: {
Comme quoi ?
}
//	<<<ENGLISH(2)>>>
//	Like what?

/*なんだ？*/
ピーター_008: {
Que je peux avoir confiance en lui, par
exemple. Quelque chose en lui me le fait
croire.
}
//	<<<ENGLISH>>>
//	Like that I can believe in him,
//	that's what. There's something
//	about him.

/*あの男は信用できる、ということだ。
あいつは何かを持っている。
*/
ピーター_009: {
Quelque chose qu'on ne trouve que dans
les hommes forts, de confiance et s&'erieux.
}
//	<<<ENGLISH>>>
//	A certain something that's found
//	only in men of strength, trust-
//	worthiness, and reliability.

/*強い男、信じるに足る男、
他人の期待に応えることが
出来る男だけが持つ何かを、な。
*/
ライデン_010: {
Je vois... bon, eh bien,
je retourne &`a la mission.
}
//	<<<ENGLISH(2)>>>
//	I see... anyway, I'm getting
//	back to the mission.

/*ああ……ああ、そうだな。
任務に戻る。
*/
//dv}//v
}//d

//ピーターの過去 大佐から何も聞いていない場合 h //e
resource PP_ピーター過去＿大佐話聞いていない__f {
//vox t:vc200791 {
ライデン_000: {
Stillman, j'ai entendu parler de
ta r&'eputation en mati&`ere de
d&'esamor&~qage de bombes.
}
//	<<<ENGLISH>>>
//	Stillman, I heard you made quite
//	a name for yourself in the bomb
//	disposal field.

/*スティルマン、あんた、爆弾処理に
かけては有名なんだってな？
*/
ピーター_001: {
Balivernes. C'est simplement qu'on ne
critique jamais les retrait&'es.
}
//	<<<ENGLISH>>>
//	Nothing of the sort. It's only
//	that you never hear people
//	badmouth retirees.

/*引退した人間のことを悪くいう奴は
いない。それだけだ。
*/
ライデン_002: {
Pourquoi as-tu pris ta retraite ?
}
//	<<<ENGLISH>>>
//	Why did you retire?

/*なぜ引退を？*/
ピーター_003: {
J'ai oubli&'e. Quoi qu'il en soit, au lieu
de nous appesantir sur le pass&'e,
}
//	<<<ENGLISH>>>
//	I forgot. At any rate, rather than
//	dwelling on past occurrences,
//<ページ数変更>
ピーター_003_1: {
nous ferions mieux de nous occuper de
ce qui nous attend aujourd'hui, non ?
}
//	<<<ENGLISH>>>
//	shouldn't we focus on taking care
//	of the pressing issue currently at
//	hand?

/*……忘れたな。それに今は昔のことを
振り返るより、もっとさしせまった
問題を解決すべき時なんじゃないか？
*/
ライデン_004: {
C'est vrai. Je retourne au boulot.
}
//	<<<ENGLISH>>>
//	True enough.
//	I'll get back to work.

/*……そうだったな。任務に戻る。*/
//dv}//v
}//d



//ファットマンの話 h //e
resource PP_ファットマン１__f {
//vox t:vc200801 {
ライデン_000: {
Stillman, parles-moi de Fatman.
}
//	<<<ENGLISH>>>
//	Stillman, tell me something
//	about Fatman.

/*スティルマン、ファットマンのことを
教えてくれないか？
*/
ピーター_001: {
Hum... eh bien, pour commencer,
il est fils d'horloger.
}
//	<<<ENGLISH(2)>>>
//	Hmm... well, to start, he was
//	born the son of a clockmaker. 

/*ああ……。ファットマンは時計職人の
息子として生まれた。
*/
ピーター_002: {
N&'eglig&'e par ses parents et sans ami,
}
//	<<<ENGLISH>>>
//	Neglected by his parents
//	and without friends,
//<ページ数変更>
ピーター_002_1: {
il a pass&'e beaucoup de temps tout seul,
dans l'atelier de son p&`ere.
}
//	<<<ENGLISH>>>
//	it seems that he spent a lot of
//	time by himself in his father's
//	workshop.

/*両親には構ってもらえず、友達もおらず、
よく父親の仕事場で独りで遊んでいた
らしい。
*/
ピーター_003: {
Qui sait, c'est peut-&^etre de l&`a que lui
vient cette v&'eritable fascination pour
}
//	<<<ENGLISH>>>
//	Maybe that was the reason, I'm not
//	sure, but apparently he has had a
//	tremendous fascination with＃−
//<ページ数変更>
ピーター_003_1: {
les m&'ecanismes d'horlogerie,
et ce depuis qu'il est tout petit.
}
//	<<<ENGLISH>>>
//	clock mechanics since
//	he was a child.

/*そのせいかどうかは知らんが
子供の頃から時計などの機械類に
過剰な思い入れを持っていたそうだ。
*/
ピーター_004: {
&`A l'&^age de dix ans, il a trouv&'e un manuel
sur Internet qui a chang&'e sa vie &`a jamais.
}
//	<<<ENGLISH>>>
//	It was at the age of ten that a
//	guidebook that he found on the
//	Internet changed his life forever.

/*そして奴の人生を決定付けたのは
１０歳の時にインターネットで
手に入れたあるマニュアルだ。
*/
ピーター_005: {
C'est &`a l'aide de ce manuel qu'il a pu
fabriquer une bombe atomique.
}
//	<<<ENGLISH>>>
//	That guidebook served as the
//	basis of his eventually piecing
//	together an atomic bomb.

/*奴はそれをもとに原爆を組み立てて
しまった。
*/
ピーター_006: {
Depuis ce jour on l'appelle Fatman,
}
//	<<<ENGLISH>>>
//	It was from there that he came
//	to be known as Fatman,
//<ページ数変更>
ピーター_006_1: {
et tous ceux associ&'es aux bombes n'ont
pas tard&'e &`a conna&^itre son nom.
}
//	<<<ENGLISH>>>
//	and soon enough there was no one
//	associated with bombs that didn't
//	know his name.

/*そのことから奴はファットマンと呼ばれ
るようになり、爆弾に携わる者の間では、
知らぬ者のない有名人になった。
*/
ピーター_007: {
D'une certaine fa&~qon,
Fatman &'etait un h&'eros.
}
//	<<<ENGLISH>>>
//	In a sense, Fatman was a hero.
//<ページ数変更>
ピーター_007_1: {
Bien que son travail n'ait &'et&'e reconnu
que par les professionnels,
}
//	<<<ENGLISH>>>
//	Although what he did was recognized
//	only by those in the trade,
//<ページ数変更>
ピーター_007_2: {
cela n'a pu que flatter son &'ego
d'adolescent.
}
//	<<<ENGLISH>>>
//	I'm sure that it served to greatly
//	stir the ego of the teenage boy at
//	the center of it all.

/*言わばヒーローだ。狭い世界のことでは
あるが１０代の少年にとっては強烈に
自尊心をくすぐられる経験だっただろう。
*/
//dv}//v
}//d
resource PP_ファットマン２__f {
//vox t:vc200811 {
ピーター_000: {
Mais il ne laisse sa marque nulle part
ailleurs. Apparemment, tout le monde le
d&'etestait et l'&'evitait &`a l'&'ecole.
}
//	<<<ENGLISH>>>
//	But he leaves his mark nowhere
//	else. Apparently, he was hated
//	and shunned by everyone in school.

/*だが他に何の特技もない奴だ。学校では
男子からは軽んじられ、女子からは
避けられていたらしい。
*/
ピーター_001: {
Il a donc consacr&'e toute son &'energie
aux explosifs.
}
//	<<<ENGLISH>>>
//	So, he went on to focus all
//	his energy on explosives.

/*だから奴はますます爆弾に
のめりこんでいった。
*/
ピーター_002: {
Il n'avait que du m&'epris pour la r&'ealit&'e
qui l'entourait et a choisi de faire
}
//	<<<ENGLISH>>>
//	He scorned the reality that
//	surrounded him and instead
//	chose to embrace a world＃−
//<ページ数変更>
ピーター_002_1: {
sa vie dans un monde o&`u
la reconnaissance viendrait facilement.
}
//	<<<ENGLISH>>>
//	that would easily grant
//	him recognition.

/*自分の近くの現実に背を向け、
簡単に自分を認めてもらえる
世界へ向かった……。
*/
ピーター_003: {
De toute &'evidence, ce m&'epris n'a
jamais conduit &`a rien,
}
//	<<<ENGLISH>>>
//	Well, to be sure, it never
//	amounted to anything more
//	than, say,
//<ページ数変更>
ピーター_003_1: {
si ce n'est d'apporter de temps &`a
autre un revolver &`a l'&'ecole.
}
//	<<<ENGLISH>>>
//	occasionally bringing
//	a gun into school.

/*まあ学校に銃を持ち込んだりするよりは
害がなかったと言えるだろうがな。
*/
//dv}//v
}//d
resource PP_ファットマン３__f {
//vox t:vc200821 {
ピーター_000: {
Finalement, Fatman est arriv&'e
&`a Indian Head,
}
//	<<<ENGLISH>>>
//	Eventually, Fatman came
//	to Indian Head,
//<ページ数変更>
ピーター_000_1: {
le centre d'entra&^inement de l'&'ecole de
d&'esamor&~qage de bombes de la Marine
o&`u j'enseignais.
}
//	<<<ENGLISH>>>
//	the exercise training facilities of
//	the Naval School Explosive Ordnance
//	Disposal at which I was a lecturer.

/*そして、奴はインディアンヘッドに
やってきた。私が教官を務めていた
海軍爆発物処理学校の実習施設だ。
*/
ピーター_001: {
Il apprenait tout avec avidit&'e,
comme s'il avait faim de bombes.
}
//	<<<ENGLISH>>>
//	He absorbed all kinds of knowledge,
//	as if he hungered for bombs. 

/*奴はあらゆるものを吸収した。
まるで爆弾に飢えているようだった。
*/
ピーター_002: {
Pr&`es de 20 % des &'etudiants d'Indian Head
se font virer. Il faut dire que le programme
est horrible.
}
//	<<<ENGLISH>>>
//	Close to 20% of the students at
//	Indian Head flunk out of what is
//	truly a hellish curriculum.
//<ページ数変更>
ピーター_002_1: {
&~Qa ne l'a pas emp&^ech&'e d'avoir
les meilleures notes jamais obtenues.
}
//	<<<ENGLISH>>>
//	Despite this environment, he achieved
//	extraordinarily high marks that were
//	without precedent.

/*インディアンヘッドは２０％近くが
落第する難関だ。その中で奴は
史上最優秀の成績を残した。
*/
ピーター_003: {
Apr&`es &^etre sorti d'Indian Head, il a int&'egr&'e
le NEST, un centre de recherche en
urgence nucl&'eaire qui est
}
//	<<<ENGLISH>>>
//	After leaving Indian Head, he joined
//	up with NEST (Nuclear Emergency
//	Search Team),
//<ページ数変更>
ピーター_003_1: {
para&^it-il le plus grand centre de
d&'esamor&~qage de bombes.
}
//	<<<ENGLISH>>>
//	said to be the most accomplished
//	bomb disposal unit.

/*インディアンヘッドを出た後、奴は
最も優れた爆弾処理チームと言われる
核緊急捜索チームに参加したのだが……
*/
ピーター_004: {
Ce serait l&`a o&`u il a commenc&'e
&`a avoir des ennuis.
}
//	<<<ENGLISH>>>
//	It was there that he apparently
//	got into some trouble.

/*そこで何かもめたらしい。
*/
ライデン_005: {
Quoi, exactement ?
}
//	<<<ENGLISH>>>
//	What, exactly?

/*一体何を？*/
ピーター_006: {
Tu m'as compris. Fatman n'&'etait de toute
&'evidence pas fait pour les activit&'es
de groupe.
}
//	<<<ENGLISH>>>
//	You got me. But Fatman was
//	definitely not cut out for group
//	operations from the very start.

/*さあな。だが元々団体行動には向かない
奴ではあった。
*/
ピーター_007: {
Eject&'e du NEST,
il a &'et&'e admis &`a la Dead Cell,
}
//	<<<ENGLISH>>>
//	Having been ousted from NEST,
//	he was picked up by Dead Cell,
//<ページ数変更>
ピーター_007_1: {
qui &`a l'&'epoque commen&~qait d&'ej&`a &`a passer
pour une bande curieusement assortie
}
//	<<<ENGLISH>>>
//	which was already becoming
//	notorious for being a motley
//	crew of sorts. 

/*ＮＥＳＴを追い出された奴は、既に
はみ出し者の集団という風評を
確立しつつあったデッドセルに拾われた。
*/
ピーター_008: {
Il semblerait que ce soit par des attaques
surprises men&'ees plus tard par
la Dead Cell
}
//	<<<ENGLISH>>>
//	It seems that it was through surprise
//	attack maneuvers later conducted by
//	Dead Cell＃−
//<ページ数変更>
ピーター_008_1: {
que Fatman a compl&`etement subjugu&'e ses
anciens compagnons du NEST.
}
//	<<<ENGLISH>>>
//	that Fatman completely subdued
//	his former companions from NEST.

/*その後デッドセルが行う抜打ち襲撃
演習でＮＥＳＴの元同僚達を徹底的に
叩きのめしたりもしたらしい。
*/
//dv}//v
}//d
resource PP_ファットマン４__f {
//vox t:vc200831 {
ピーター_000: {
C'&'etait le plus &'etrange de tous mes
&'etudiants, mais aussi le plus dou&'e.
}
//	<<<ENGLISH>>>
//	While being the most peculiar
//	individual among my students,
//	he was also the most talented.
//<ページ数変更>
ピーター_000_1: {
Ce serait une erreur de le sous-estimer.
Tu me comprends ?
}
//	<<<ENGLISH>>>
//	Be sure not to underestimate
//	him. Are we clear?

/*ファットマンは私が教えた中で最も
変わった男だったが、同時に最も優れた
男でもある。あなどるなよ、いいな。
*/
//dv}//v
}//d


//無臭Ｃ４ h //e
resource PP_移動後無臭Ｃ４__f {
//vox t:vc200841 {
ピーター_000: {
C'est toi, Raiden ? Je ne suis pas encore
arriv&'e &`a l'Etai H.
}
//	<<<ENGLISH>>>
//	Is that you, Raiden?
//	I haven't reached Strut H yet. 

/*ライデンか？
こっちはまだＨ脚には着いていない。
*/
ライデン_001: {
Stillman... tu penses vraiment qu'il
y a des bombes que le d&'etecteur
ne d&'etecte pas ?
}
//	<<<ENGLISH(2)>>>
//	Stillman... do you really think there
//	are bombs that the sensor's not
//	picking up?

/*スティルマン……本当にセンサーに
反応しない爆弾があると思うか？
*/
ピーター_002: {
Eh bien... en scellant toute l'enveloppe de
la bombe, l'odeur ne peut pas s'&'echapper.
}
//	<<<ENGLISH(2)>>>
//	Right... sealing the entire casing
//	of the bomb prevents the odor
//	from leaking outside.
//<ページ数変更>
ピーター_002_1: {
C'est une technique que je n'ai pas
enseign&'ee.
}
//	<<<ENGLISH>>>
//	It's a technique that I,
//	for one, didn't teach. 

/*確かに爆弾全体をシールすれば
『匂い』が外に漏れるのを防ぐことが
出来る。……私が教えなかった技術だ。
*/
ライデン_003: {
Je croyais que Fatman laissait toujours
une signature ?
}
//	<<<ENGLISH>>>
//	But wasn't leaving a signature of
//	sorts Fatman's aesthetic touch?

/*だがサインを残すのは奴の美学じゃ
なかったのか。
*/
ピーター_004: {
Ce Fatman n'est peut-&^etre pas celui
que j'ai connu...
}
//	<<<ENGLISH>>>
//	Perhaps this Fatman is
//	not the one I knew...

/*……今のあいつは私の知っている
あいつではないのかもしれんな……。
*/
ライデン_005: {
Comment ?
}
//	<<<ENGLISH>>>
//	What?

/*なに？*/
ピーター_006: {
Fatman est faible et fragile en ce
moment... qui plus est, il est dangereux.
Alors fais attention &`a toi, d'accord ?
}
//	<<<ENGLISH>>>
//	Fatman right now is fragile and
//	weak... what's more, he's dangerous.
//	Watch yourself, okay?

/*今のあいつは弱く脆く……
そして何より危険だ。
気をつけろ。いいな。
*/
//dv}//v
}//d

//実は歩けたことの言い訳 h //e
resource PP_歩ける言い訳１__f {
//vox t:vc2008501 {
ライデン_000: {
Comment te sens-tu, Stillman ?
}
//	<<<ENGLISH(2)>>>
//	Stillman, how ya feelin'?

/*スティルマン、調子はどうだ？*/
ピーター_001: {
Tr&`es bien. Mais &~qa fait longtemps
que je n'ai pas couru...
}
//	<<<ENGLISH>>>
//	All right. It's been a while
//	since I've run, though...

/*ああ、大丈夫だ。
だが走ったのは久しぶりで……。
*/
ライデン_002: {
Autrement dit &~qa fait longtemps que
tu n'as pas &'et&'e essouffl&'e, hein ?
}
//	<<<ENGLISH>>>
//	Guess that means it's also been
//	a while since you've run out of
//	breath, huh?

/*（皮肉）息が切れるのも久しぶりってわけか？
*/
ピーター_003: {
C'est une accusation ou quoi, Raiden ?
}
//	<<<ENGLISH>>>
//	Are you accusing me of
//	something, Raiden?

/*……ライデン……私を責めているのか？
*/
ライデン_004: {
Je ne voulais rien sous-entendre...
}
//	<<<ENGLISH>>>
//	No, I didn't mean
//	anything by it...

/*いや、そんなつもりは。*/
ピーター_005: {
Non, non. Je suis condamnable.
}
//	<<<ENGLISH>>>
//	No, no.
//	I should be condemned.

/*いいや、責められるべきなのだ。*/
ライデン_006: {
Ecoutes, tout le monde fait
des erreurs...
}
//	<<<ENGLISH>>>
//	Wait, everybody makes mistakes...

/*失敗は誰にでもある……。*/
ピーター_007: {
Mais ce sont les raisons derri&`ere ces
erreurs qui deviennent le vrai probl&`eme.
}
//	<<<ENGLISH>>>
//	But it's the reasons behind those
//	mistakes that become the real issue.

/*失敗の原因にもよる。
*/
ライデン_008: {
Que veux-tu dire ?
}
//	<<<ENGLISH(2)>>>
//	What do you mean?

/*え？*/
//dv}//v
}//d
resource PP_歩ける言い訳２__f {
//vox t:vc200861 {
ピーター_000: {
Si cette bombe a explos&'e...
et si j'ai &'et&'e sauv&'e...
}
//	<<<ENGLISH>>>
//	The reason that bomb exploded...
//	and the reason that I was saved...
//<ページ数変更>
ピーター_000_1: {
c'est en raison de ma peur qui m'a
emp&^ech&'e de g&'erer cette situation.
}
//	<<<ENGLISH>>>
//	is because I was confronted by
//	fear, and I couldn't handle it.

/*あの爆弾が爆発したのは……そして私が
助かったのは、私が恐怖に駆られ
逃げ出したからなのだ。
*/
ピーター_001: {
En plein d&'esamor&~qage,
j'ai c&'ed&'e &`a cette peur...
}
//	<<<ENGLISH>>>
//	Halfway through disposing of the
//	bomb, I succumbed to that fear...
//<ページ数変更>
ピーター_001_1: {
et quand j'ai r&'ealis&'e ce qui se passait,
je partais d&'ej&`a en courant.
}
//	<<<ENGLISH>>>
//	and when I realized what was going
//	on, I had turned around and was
//	running away from the bomb.

/*そう……爆弾処理の途中で私は恐怖に
屈し……気がつくと爆弾に背を向けて
逃げ出していた……。
*/
ピーター_002: {
Mais ce n'est pas moi qui aie
pay&'e le prix.
}
//	<<<ENGLISH>>>
//	The one who paid the price,
//	however, wasn't me.

/*しかもそのツケを払うことになったのは
私ではない。
*/
ピーター_003: {
Quand j'ai repris conscience apr&`es
le choc de l'explosion,
}
//	<<<ENGLISH>>>
//	After I regained consciousness
//	from the shock of the blast,
//<ページ数変更>
ピーター_003_1: {
la premi&`ere chose que j'ai vue, ce sont
des cadavres d'enfants &'ecras&'es sous
les d&'ecombres.
}
//	<<<ENGLISH>>>
//	the first thing that my eyes met
//	were the corpses of children
//	crushed under a pile of rubble.

/*爆発の衝撃から意識を取り戻した
私が最初に目にしたのは、瓦礫の
下敷きになった子供達の屍だった……。
*/
ライデン_004: {
Stillman..
}
//	<<<ENGLISH>>>
//	Stillman...

/*スティルマン……。*/
ピーター_005: {
Et, tu sais ce que j'ai ressenti
&`a ce moment-l&`a ?
}
//	<<<ENGLISH>>>
//	Yet, what do you think
//	I felt at that time?

/*だが、その時私が感じたのは
一体何だったと思う？
*/
ピーター_006: {
Du soulagement.
J'&'etais soulag&'e que ce ne soit pas moi.
}
//	<<<ENGLISH>>>
//	A sense of relief.
//	Relieved that it wasn't me.

/*安堵だ。
自分でなくてよかったと。
*/
ライデン_007: {
...
}
//	<<<ENGLISH>>>
//	...

/*……。*/
//dv}//v
}//d
resource PP_歩ける言い訳３__f {
//vox t:vc200871 {
ピーター_000: {
Ce n'est pas tout.
}
//	<<<ENGLISH>>>
//	And that's not all.

/*それだけではない。*/
ピーター_001: {
A l'&'epoque, Je passais pour le plus grand
d&'esamorceur de bombes des Etats-Unis.
}
//	<<<ENGLISH>>>
//	At the time, I was known as the
//	top bomb disposal technician in
//	the United States.

/*当時私は合衆国最高の爆弾処理技術者と
呼ばれていた。
*/
ピーター_002: {
Pour quelqu'un comme moi, sans femme ni
enfants, ma r&'eputation, c'&'etait tout.
}
//	<<<ENGLISH>>>
//	And to someone like me, who
//	had neither a wife nor children,
//	that reputation was everything.
//<ページ数変更>
ピーター_002_1: {
Je ne voulais pas la perdre.
}
//	<<<ENGLISH>>>
//	I didn't want to lose it.

/*妻も子もいない私にとってその名声は
全てだった。失いたくはなかった。
*/
ピーター_003: {
C'est pour cela que j'ai racont&'e que
j'avais perdu une jambe... pour fuir
mes responsabilit&'es...
}
//	<<<ENGLISH>>>
//	That's why I lied about losing
//	my leg... ran away from the
//	responsibility that was mine...
//<ページ数変更>
ピーター_003_1: {
fermer les yeux sur les victimes...
m'attirer la sympathie du public.
}
//	<<<ENGLISH>>>
//	closed my eyes to the victims...
//	stirred up the sympathy of the
//	public.

/*だから私は……足を失ったと嘘をつき……
負うべき責任を逃れ……被害者から目を
そらし……世間の同情を買い……。
*/
ライデン_004: {
Stillman. &~Qa suffit.
}
//	<<<ENGLISH>>>
//	All right, Stillman.
//	That's enough. 

ライデン_004_1: {
Pour le moment, concentrons-nous
sur les bombes de Fatman.
}
//	<<<ENGLISH>>>
//	For now, let's just worry about
//	what we're going to do about
//	Fatman's bombs.

/*スティルマン。もういい。
今はファットマンの爆弾をどうするか、
それだけを考えよう。
*/
ピーター_005: {
Oui...
}
//	<<<ENGLISH>>>
//	Yeah...

/*……ああ……。*/
//dv}//v
}//d



