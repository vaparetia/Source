	chara プットオブジェ ＤＧ連絡橋1Fモデル_5 -m d:KMS_NAME5 -p 0,0,0  -l d:LT2_NAME -r 0,0,0 
	chara プットオブジェ ＤＧ連絡橋1Fモデル_6 -m d:KMS_NAME6 -p 0,0,0  -l d:LT2_NAME -r 0,0,0 
	chara プットオブジェ ＤＧ連絡橋1Fモデル_7 -m d:KMS_NAME7 -p 0,0,0  -l d:LT2_NAME -r 0,0,0 
