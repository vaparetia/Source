	chara プットオブジェ ＤＧ連絡橋1Fモデル_I -m d:KMS_NAMEI -p 0,0,0  -l d:LT2_NAME -r 0,0,0 
	chara プットオブジェ ＤＧ連絡橋1Fモデル_J -m d:KMS_NAMEJ -p 0,0,0  -l d:LT2_NAME -r 0,0,0 
	chara プットオブジェ ＤＧ連絡橋1Fモデル_K -m d:KMS_NAMEK -p 0,0,0  -l d:LT2_NAME -r 0,0,0 
