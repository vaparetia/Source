// 以下デバッグ専用proc
// -----------------------------------------------------------------------------------
// デバッグキャラ
// ------------------------------------
proc デバッグキャラセット {
	#if d:SCREENSHOT
		chara スクリーンショット shot
	#endif

	#if d:USB_KEY
		chara USBキーボード実行 test \
			-e d:KBD_ESC {	
				mesg プレイヤー d:PLAYER position -5500, -13000, -500
			} \
	#endif

	#if d:HARRIER
	// 大きさ比較用ハリア（2000.12.14）
	#if d:DEBUG_PRINT
	print 'harrier_test'
	#endif
	chara プットオブジェ harrier_test \
			-m d:KMS_NAME_HARRIER -p 0,0,0  -l d:LT2_NAME -r 0,0,0 
	chara プロック連続実行 harrier_test_fly \
		-time -1 \
		-exec {
			eval( $w:実験ハリア角度   = (($w:実験ハリア角度   +  3) & 4095) );
			eval( $w:実験ハリア角度２ = (($w:実験ハリア角度２ +  5) & 4095) );
			eval( $i:実験ハリアＸ軸方向 = 0 );
			eval( $i:実験ハリアＹ軸方向 = 0 );
			eval( $i:実験ハリアＺ軸方向 = 0 );
			eval( $i:実験ハリア位置Ｘ   = (`command cos $w:実験ハリア角度`) * 3 );
			eval( $i:実験ハリア位置Ｙ   = (`command sin $w:実験ハリア角度`) * 3 -1000 );
			eval( $i:実験ハリア位置Ｚ   = (`command sin $w:実験ハリア角度２`) * 3 -150250 );
			mesg プットオブジェ harrier_test turn $i:実験ハリアＸ軸方向 $i:実験ハリアＹ軸方向 $i:実験ハリアＺ軸方向
			mesg プットオブジェ harrier_test move $i:実験ハリア位置Ｘ $i:実験ハリア位置Ｙ $i:実験ハリア位置Ｚ
		}
	#endif
	#if d:KAMOFU
	// 大きさ比較用カモフ（2000.12.14）
	#if d:DEBUG_PRINT
	print 'kamofu_test'
	#endif
	chara プットオブジェ kamofu_test \
			-m d:KMS_NAME_KAMOFU -p 0,0,0  -r 0,0,0 -f 0x20
	chara プロック連続実行 kamofu_test_fly \
		-time -1 \
		-exec {
			eval( $w:実験カモフ角度   = (($w:実験カモフ角度   +  5) & 4095) );
			eval( $w:実験カモフ角度２ = (($w:実験カモフ角度２ +  7) & 4095) );
			eval( $i:実験カモフＸ軸方向 = 0 );
			eval( $i:実験カモフＹ軸方向 = 0 );
			eval( $i:実験カモフＺ軸方向 = 0 );
			eval( $i:実験カモフ位置Ｘ   = (`command cos $w:実験カモフ角度`) * 4 );
			eval( $i:実験カモフ位置Ｙ   = (`command sin $w:実験カモフ角度`) * 4 -1000 );
			eval( $i:実験カモフ位置Ｚ   = (`command sin $w:実験カモフ角度２`) * 3 -150250 );
			mesg プットオブジェ kamofu_test turn $i:実験カモフＸ軸方向 $i:実験カモフＹ軸方向 $i:実験カモフＺ軸方向
			mesg プットオブジェ kamofu_test move $i:実験カモフ位置Ｘ $i:実験カモフ位置Ｙ $i:実験カモフ位置Ｚ
		}
	#endif
}

