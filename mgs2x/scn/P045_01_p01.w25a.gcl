	chara プットオブジェ ＤＧ連絡橋1Fモデル_9 -m d:KMS_NAME9 -p 0,0,0  -l d:LT2_NAME -r 0,0,0 
	chara プットオブジェ ＤＧ連絡橋1Fモデル_A -m d:KMS_NAMEA -p 0,0,0  -l d:LT2_NAME -r 0,0,0 
	chara プットオブジェ ＤＧ連絡橋1Fモデル_B -m d:KMS_NAMEB -p 0,0,0  -l d:LT2_NAME -r 0,0,0 
	chara プットオブジェ ＤＧ連絡橋1Fモデル_C -m d:KMS_NAMEC -p 0,0,0  -l d:LT2_NAME -r 0,0,0 
	chara プットオブジェ ＤＧ連絡橋1Fモデル_D -m d:KMS_NAMED -p 0,0,0  -l d:LT2_NAME -r 0,0,0 
