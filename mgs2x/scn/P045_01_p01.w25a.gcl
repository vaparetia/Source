	chara プットオブジェ ＤＧ連絡橋1F破壊前０ \
			-m d:KMS_NAME0_BEFORE -p 0,0,0  -l d:LT2_NAME -r 0,0,0 
	chara プットオブジェ ＤＧ連絡橋1F破壊前１ \
			-m d:KMS_NAME1_BEFORE -p 0,0,0  -l d:LT2_NAME -r 0,0,0 
}

