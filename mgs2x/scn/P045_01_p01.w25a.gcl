	chara M4_DEMO_GUN弾 デモ弾Ｍ４
	
}

// [追加] 2001/08/30 Uehara Masatoshi
proc リアル影セット {
	chara 影投影モデル 影もでる \
		-m w25demo_sdw00 \
		-p -1 1 -1

	chara 影管理 影かんり \
		-t 0 \
		-p -30 -85 -30

	mesg 影管理 影かんり demo_add rai_def_mh_demo  影もでる	// ライデン
	// デバッグ用
//	mesg 影管理 影かんり demo_add sol_def_mant_body_mh_mt 影もでる	// ソリダス（マント状態）
//	mesg 影管理 影かんり demo_add sol_def_mh_mt 影もでる	// ソリダス（通常）
}

proc マントソリダス影オン {
	mesg 影管理 影かんり demo_add sol_def_mant_body_mh_mt 影もでる	// ソリダス（マント状態）
}
proc マントソリダス影オフ {
	mesg 影管理 影かんり del sol_def_mant_body_mh_mt
}
proc ソリダス影オン {
	mesg 影管理 影かんり demo_add sol_def_mh_mt 影もでる	// ソリダス（通常）
}
proc ソリダス影オフ {
	mesg 影管理 影かんり del sol_def_mh_mt
}

proc リアル影セットパイプ用 {
	chara 影投影モデル 影もでるパイプ用 \
		-m w25demo_sdw02 \
		-p 0 0 0

	chara 影管理 影かんりパイプ用 \
		-t 0 \
		-p -30 -85 -30
}

proc ソリダスパイプ影投影オン {
	mesg 影管理 影かんりパイプ用 demo_add sol_def_mh_mt  影もでるパイプ用	// ライデン
}	

proc ソリダスパイプ影投影オフ {
	mesg 影管理 影かんりパイプ用 del sol_def_mh_mt
}	

proc リアル影セット２ハリアー用 {
	chara 影投影モデル２ 影もでる２ハリアー用 \
		-ctrl hri_def

	chara 影管理 影かんり２ハリアー用 \
		-t 0 \
		-p -30 -85 -30
}

proc ソリダスハリアー影投影オン {
	mesg 影管理 影かんり２ハリアー用 demo_add sol_def_mh_mt  影もでる２ハリアー用	// ライデン
}

proc ソリダスハリアー影投影オフ {
	mesg 影管理 影かんり２ハリアー用 del sol_def_mh_mt
}
