// マップ設定
// ------------------------------------
chara マップ ＤＧ連絡橋1F -h d:HZX_NAME -l d:LT2_NAME

#include "w25a_cdc.ch"

command マップ設定 ＤＧ連絡橋1F -set {
//	デモ環境かゲーム環境かで起動を読み分ける。
// ------------------------------------
#if d:MGS2_DEMO

chara デモアクトデバッグ demodebug  -i t:p045_01_p01 -d 'p045_01_p01' -l  -s 'p045_01_p01'  \
		-p Ｄ脚破壊 Ｇ脚破壊 パイプ凹み ドア部セムテックス消去 \
		   マントソリダス影オン マントソリダス影オフ ソリダス影オン ソリダス影オフ \
		   ソリダスパイプ影投影オン ソリダスパイプ影投影オフ \
		   ソリダスハリアー影投影オン ソリダスハリアー影投影オフ

		// ハリアー戦前 を再生するとき
		eval($s:d_num = P045_01_p01)
		// ハリアー戦後 を再生するとき
		//eval($s:d_num = P046_01_p01)

#else

// 実際の再生
//-----------------------------------------------------------
	// 実際のデモ再生の方も、ストーリーフラグで変える
	if($w:p_story == d:ST:P045_01_P01ハリアー登場１ポリゴンデモ１開始) {
		print '$w:p_story = ST:P045_01_P01ハリアー登場１ポリゴンデモ１開始'

		/* ソリダス出現　ハリアー戦手前 */

		// デモ特有の変数代入
		eval($s:d_num = P045_01_p01)

		proc デモ再生_P045_01_p01 {
			@デモモデル差し替え処理
			chara demo デモ再生 \
				-i t:p045_01_p01 \
				-p Ｄ脚破壊 Ｇ脚破壊 パイプ凹み ドア部セムテックス消去 \
				   マントソリダス影オン マントソリダス影オフ ソリダス影オン ソリダス影オフ \
				   ソリダスパイプ影投影オン ソリダスパイプ影投影オフ \
				   ソリダスハリアー影投影オン ソリダスハリアー影投影オフ \
				-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
				-next P045_01_p01終了
		}
		@デモ再生_P045_01_p01
	}
#endif


// 以下、諸々セット
//-----------------------------------------------------------
	@常駐キャラ設定						// stdch.hで定義

	chara デモキャンセルチェック デモキャンセル \
		-p demo_cancel

	@ＤＧ連絡橋B1モデルセット
	@ＤＧ連絡橋1Fモデルセット
	@天井セット
	@ドア設置
	@海面設置
	@空設置
	@w25a専用赤外線設定
	@フォグ設定
	@エフェクト設定
//	@デバッグキャラセット
	@シネマスクリーンセット

	@リアル影セット
	@リアル影セットパイプ用
	@リアル影セット２ハリアー用

/*
	// デバッグ用
	chara delay ディレイ \
		-time 9100 \ 
		-exec{
			@ソリダスパイプ影投影オン
		}

	chara delay ディレイ \
		-time 11000 \ 
		-exec{
			@ソリダスハリアー影投影オン
		}
*/
	if($s:d_num == P045_01_p01) {
		@ＤＧ連絡橋1F破壊前セット
	} else if($s:d_num == P046_01_p01){
		@ＤＧ連絡橋1F破壊後セット
	}

	@デモ用薬莢用メモリ確保セット


} // 「command マップ設定 タイトロープ」の閉じカッコ


// ====================================
// 初期マップ表示
// ====================================
// デモ専用ステージなので、ここでshow
command マップ表示 -show ＤＧ連絡橋1F	


// 各proc設定
//-------------------------------------------------------------------------------------
// デモデモ再生関連のプロック
//-----------------------------------------------------------
proc null {}

proc demo_cancel {
	command StreamStopAll
}

proc P045_01_p01終了 {
	@デモ終了時シネマスクリーンオフ
	mesg デモキャンセルチェック デモキャンセル kill

	print '$w:p_story = d:ST:P045_01_P01ハリアー登場１ポリゴンデモ１終了'
	eval($w:p_story = d:ST:P045_01_P01ハリアー登場１ポリゴンデモ１終了)

	chara delay ディレイ \
		-time 1 \ 
		-exec{
			// ゲームへ
			@ゲームステージへ戻る
			load "" -r 'r_plt0'
			@mv_w18a_w25a_1
		}
}



proc シネマスクリーンセット  {
	chara シネマスクリーン シネマ \
		-top d:CINEMA_BELT_UPPER \
		-bottom d:CINEMA_BELT_LOWER \
		-ftime 60	//デフォルト値（ゼロは駄目）
	mesg シネマスクリーン シネマ フェードアウト 1
}


// 全マップ共通
	// ポリデモ
	// ------------------------------------
	// ノード端末
	// ------------------------------------

	// ドア＆マップ切り替え関係
	// ------------------------------------
#if 0
	proc ドア設置 {
		chara プットオブジェ １Ｆ右ドア \
			-m d:DOOR_NAME_LOAD \
			-r 0,1024,0 \
			-p 17125,0,-234250 \
			-s 100,100,100 \
			-l d:LT2_NAME

		chara プットオブジェ 倉庫ドア \
			-m d:DOOR_NAME_LOAD \
			-r 0,3072,0 \
			-p -8875,0,-231500 \
			-s 100,100,100 \
			-l d:LT2_NAME
	}
#endif

	// 海面設置
	// ------------------------------------
	proc 海面設置 {
		#if 1
			@プラント海面セット 昼 w25a 1
		#else
			chara プラント海面 plant_sea \
				-tex oil oil_alp_ovl_mod0222 sky_day_add_alp_ovl_mod1120 \
				-pos 0,-40000,-180000
		#endif
	}

	// 空設置
	// ------------------------------------
	proc 空設置 {
		@プラントステージでの汎用空セット ハリアー昼 w25a

		chara 太陽 ソル \
			-p 0 -40000 -150000 \    //中心の位置
			-f -2700 -3100 -2700     //平行光源の-pと同じ値
	}


	proc Ｄ脚破壊 {
		print 'Destory D-prop'
		mesg  プットオブジェ Ｄ脚入口破壊前  kill ;
		chara プットオブジェ Ｄ脚入口破壊後   -m d:KMS_ENT_D_1 -p 0,0,0 -r 0,0,0 -l d:LT2_NAME
	}

	proc Ｇ脚破壊 {
		print 'Destory G-prop'
		mesg  プットオブジェ Ｇ脚入口破壊前  kill ;
		chara プットオブジェ Ｇ脚入口破壊後   -m d:KMS_ENT_G_1 -p 0,0,0 -r 0,0,0 -l d:LT2_NAME
		mesg ドアランプ Ｇ脚方面ドアランプ 破壊
	}

	proc パイプ凹み {
		print 'Destory Pipe'
		mesg  プットオブジェ 凹んでないパイプ kill ;
		chara プットオブジェ 凹んだパイプ     -m d:KMS_ENT_P_1 -p 0,0,0 -r 0,0,0 -l d:LT2_NAME
	}

	// フォグ
	// ------------------------------------
	proc フォグ設定 {
		#if 1
			@プラントステージでのフォグセット 昼 0
		#else
			chara フォグ 霧\
				-c 160, 180, 160 \
				-n 5000 \
				-f 130000
		#endif
	}

	// エフェクト関係
	// -----------------------------------
	proc エフェクト設定 {
			//chara ブラー ブラー

			chara Ｚフォーカス管理 Z_manager

			chara ＯＦＦ制御 off_man
			mesg ＯＦＦ制御 off_man ボディシャドウＯＦＦ
	}


