					-r 795,1988,0 \
					-f 4000 \
					-a 200 \
					-i 2 2 0 0 \
					-s $3
			}

		// 匍匐カメラ
		trap ca009 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_SQUAT d:TRP_STATE_GROUND \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ１ \
