// Ｂ１梯子部屋
	// ふなむしの設定
	// ------------------------------------
	proc Ｂ１梯子部屋ふなむし設定 {
		#if d:DEBUG_PRINT
			print 'w20a4_funamsi_set'
		#endif

		chara エマ虫 かさかさ \
			-group 5 \
			-atrap all_funa03 \
			-trap fu003
	}

	// 各種カメラの設定
	// ------------------------------------
	proc Ｂ１梯子部屋カメラ設定 {
		#if d:DEBUG_PRINT
			print 'w20a4_camera_set'
		#endif

		// 階段
		// Ｂ１梯子部屋上
		trap ca401 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ昇順 $4 49250 50875 49521 53232
				eval( $i:補完ＲＸ = $i:CS_結果１ );
				eval( $i:補完ＬＸ = $i:CS_結果１ );

				if ( $6 > -88000 ) {
					@CS_スムーズカメラ昇順 $6 -87750 -86500 -87779 -86443
					eval( $i:補完ＲＺ = $i:CS_結果１ );
					@CS_スムーズカメラ昇順 $6 -87750 -86500 -88868 -87337
					eval( $i:補完ＬＺ = $i:CS_結果１ );
				} else {
					eval( $i:補完ＲＺ = -87779 );
					eval( $i:補完ＬＺ = -88868 );
				}

				chara カメラ設定 メインカメラ \
					-c 0 \
					-b $i:補完ＲＸ,1257,-87779 52131,1257,$i:補完ＲＺ \
					-l $i:補完ＬＸ,-3000,-91000 52131,d:CAM_MAX,$i:補完ＬＺ \
					-r 795,2048,0 \
					-f 6500 \
					-a 200 \
					-i 3 -1 0 0 \
					-s $3
			}

		// Ｂ１梯子部屋下
		trap ca402 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 メインカメラ \
					-c 1 \
					-p 52225,1775,-83851 -t 52225,-2941,-85156 \
					-r 848,2048,0 -f 4893 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3
			}
	}


