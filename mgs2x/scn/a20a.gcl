	}



// ２Ｆ
	// 各種カメラの設定
	// ------------------------------------
	proc ２Ｆカメラ設定 {
		#if d:DEBUG_PRINT
			print 'w20a1_camera_set'
		#endif

		// ２Ｆ上
		trap ca101 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ１ \
					-c 0 \
					-b 61293,8904,-89248 61438,10186,-89259 \
					-l 61293,5487,-94043 61438,5836,-90492 \
					-r 798,2048,0 \
					-f 4518 \
					-a 200 \
					-i 3 3 0 0 \
					-s $3
			}
	}


// Ｂ１
	// 透明壁の設定
	// ------------------------------------
	proc Ｂ１透明壁設置 {
		#if d:DEBUG_PRINT
			print 'w20a2_tr_wall_set'
		#endif

		@南北５０ｃｍ幅透明壁設置 Ｂ１左壁 46000 -4500 -85750 2000

		trap wl201 d:PLAYER \
			-mask ？ \
			-state 4 \
			-exec {
					if ($3 == 入る) {
						command パッド操作 -mask d:PAD_B
						mesg 透明壁 Ｂ１左壁 off
					} else {
						command パッド操作 -cancel 0
						mesg 透明壁 Ｂ１左壁 on
					}
				}
	}

	// イントルード金網設定
	// ------------------------------------
	proc イントルード金網設定 {
		#if d:DEBUG_PRINT
			print 'w20a_intrude_fence_set'
		#endif

		trap fence_w d:PLAYER \
			-mask ＊ \
			-dir 3072 256 \	//方向指定
			-exec {
				command イントルード主観カメラ補正 \
					-se d:se_code:SD_P_HEADNET1 \
					-len 1000 \
					-inout $3
			}
	}


	// 各種カメラの設定
	// ------------------------------------
	proc Ｂ１カメラ設定 {
		#if d:DEBUG_PRINT
			print 'w20a2_camera_set'
		#endif

		// 階段
		// Ｂ１階段
		trap ca004 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ降順 $6 -81000 -89000 886 364
				eval( $i:補完ＲＸ = $i:CS_結果１ );

				@CS_スムーズカメラ降順 $6 -81000 -89000 200 325
				eval( $w:補完画角 = $i:CS_結果１ );

				chara カメラ設定 メインカメラ \
					-c 0 \
					-b 43182,2673,-79166 43182,6976,-79281 \
					-l 43182,-3060,d:CAM_MIN 43182,1652,-80842 \
					-r $i:補完ＲＸ,2048,0 \
					-f 5548 \
					-a $w:補完画角 \
					-i 0 0 0 0 \
					-s $3
			}

		// 通路
		trap ca201 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ降順 $6 -87000 -88000 600 500
				eval( $i:補完ＲＸ = $i:CS_結果１ );

				chara カメラ設定 メインカメラ \
					-c 0 \
					-b 46000,471,-84238 46000,1750,-85532 \
					-l 46000,-3000,-89036 46000,d:CAM_MAX,-86750 \
					-r $i:補完ＲＸ,2048,0 \
					-f 5350 \
					-a 190 \
					-i 0 0 0 0 \
					-s $3
			}
	}


