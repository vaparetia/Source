					-l 46750,2021,-89868 56276,2021,-79400 \
					-r 889,2048,0 \
					-f 6567 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3
			}

		// 手すり部分の張り付きカメラ
		trap ca008 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_CAUTION \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ１ \
					-c 0 \
