	#include "usbkbd.h"
#endif

// アナザー用でマップ設定前に設定する
// ------------------------------------
@アナザー用マップ定義前設定

// マップ設定
// ------------------------------------
chara マップ Ｅ脚１Ｆ -k d:KMS_NAME0 -k d:KMS_NAME0_19 -h d:HZX_NAME,0 -l d:LT2_NAME
chara マップ Ｅ脚２Ｆ -k d:KMS_NAME1 -k d:KMS_NAME1_20 -h d:HZX_NAME,1 -l d:LT2_NAME
chara マップ Ｅ脚Ｂ１ -k d:KMS_NAME2 -h d:HZX_NAME,2 -l d:LT2_NAME
chara マップ Ｅ脚Ｂ１倉庫 -k d:KMS_NAME3 -h d:HZX_NAME,3 -l d:LT2_NAME
chara マップ Ｅ脚Ｂ１梯子部屋 -k d:KMS_NAME4 -h d:HZX_NAME,4 -l d:LT2_NAME

chara マップ接合 １Ｆ／２Ｆ Ｅ脚１Ｆ Ｅ脚２Ｆ -type 1
chara マップ接合 １Ｆ／Ｂ１ Ｅ脚１Ｆ Ｅ脚Ｂ１ -type 1
chara マップ接合 Ｂ１／倉庫 Ｅ脚Ｂ１ Ｅ脚Ｂ１倉庫
chara マップ接合 Ｂ１／梯子部屋 Ｅ脚Ｂ１ Ｅ脚Ｂ１梯子部屋
chara マップ接合 １Ｆ／倉庫 Ｅ脚１Ｆ Ｅ脚Ｂ１倉庫

command マップ設定 Ｅ脚１Ｆ Ｅ脚２Ｆ Ｅ脚Ｂ１ Ｅ脚Ｂ１倉庫 Ｅ脚Ｂ１梯子部屋 -set {
	// サウンド、キャラクターのセット
	// ------------------------------------
	@常駐キャラ設定
	@ローカル変数初期化
	@設定値変更
	@シナリオデモキャラセット	// stdproc.hで定義
	@プラグイン設定
	@A_プレイヤー設定 sna_a20a rai_a20a
	@ダンボール柄設定
}

// アナザー用でマップ設定後に設定する
// ------------------------------------
@アナザー用マップ定義後設定

command マップ設定 Ｅ脚１Ｆ Ｅ脚２Ｆ Ｅ脚Ｂ１ Ｅ脚Ｂ１倉庫 Ｅ脚Ｂ１梯子部屋 -set {
	@弾痕跳弾設定
	// マップ切り替え、ロード、ドア
	// ------------------------------------
	@ドア設置
	@ロード設定
	// ステージ、オブジェクト関連
	// ------------------------------------
	@ベルトコンベア管理設定
	@ベルトコンベア移動時フェードイン設定
	@アイテム収得範囲変更
	@フォグ設定
	@カメラセット
	@子画面設定
#if d:DEBUG_CHARA
//	@デバッグキャラセット
#endif
}

command マップ設定 Ｅ脚１Ｆ Ｅ脚Ｂ１倉庫 -set {
	@ベルトコンベア移動時マップ切り替え
}

command マップ設定 Ｅ脚Ｂ１ Ｅ脚Ｂ１倉庫 Ｅ脚Ｂ１梯子部屋 -set {
	@１Ｆマップ切り替え
}

command マップ設定 Ｅ脚１Ｆ -set {
	@２Ｆマップ切り替え
	@Ｂ１マップ切り替え
	@ＥＦ連絡橋マップ切り替え
	@主観禁止壁設定１Ｆ
	@A_ドア開閉設定１Ｆ
	@Ｅ脚１Ｆ壊れライト設定
	@Ｅ脚１Ｆ天井設置
	@Ｅ脚１Ｆ南壁設置
	@１Ｆベルトコンベア設定
	@１Ｆビヨンド設定
	@１Ｆジャンプ設定
	@１Ｆカメラ設定
}

command マップ設定 Ｅ脚２Ｆ -set {
	@主観禁止壁設定２Ｆ
	@A_ドア開閉設定２Ｆ
	@２Ｆカメラ設定
}

command マップ設定 Ｅ脚Ｂ１ -set {
	@Ｅ脚Ｂ１壊れライト設定
	@Ｂ１透明壁設置
	@イントルード金網設定
	@A_ドア開閉設定Ｂ１
	@Ｂ１カメラ設定
}

command マップ設定 Ｅ脚Ｂ１倉庫 -set {
	@Ｅ脚Ｂ１倉庫壊れライト設定
	@Ｂ１倉庫ベルトコンベア設定
	@Ｂ１倉庫ジャンプ設定
	@Ｂ１倉庫カメラ設定
}

command マップ設定 Ｅ脚Ｂ１梯子部屋 -set {
	@水密ドア設置
	@ハッチ設置
	@Ｂ１梯子部屋カメラ設定
}

command マップ設定 Ｅ脚１Ｆ Ｅ脚２Ｆ Ｅ脚Ｂ１ Ｅ脚Ｂ１倉庫 Ｅ脚Ｂ１梯子部屋 -set {
	@キャラ用ライト設置
}


switch ( $s:登場ポイント ) {
	case ( ＤＥ連絡橋から ) {
		// ＤＥ連絡橋から
		//初期マップの表示
		command マップ表示 -show Ｅ脚１Ｆ
		command マップ表示 -show Ｅ脚Ｂ１

		mesg マップ接合 １Ｆ／Ｂ１ on

		$f:w20a_Ｂ１いるフラグ = 0;

		// 全てのセットが終わったところでフェードイン
		@ステージ開始時処理（ステージ名表示） \
			d:LOAD_TYPE:SL_DOOR_TYPE １Ｆ上ドア 2250 d:DEFAULT_M_TYPE \
			d:wn_Ｅ脚集配場１Ｆ
	}
	case ( ＥＦ連絡橋から ) {
		// ＥＦ連絡橋から
		//初期マップの表示
		command マップ表示 -show Ｅ脚１Ｆ
		command マップ表示 -show Ｅ脚Ｂ１

		mesg マップ接合 １Ｆ／Ｂ１ on

		$f:w20a_Ｂ１いるフラグ = 0;

		// 全てのセットが終わったところでフェードイン
		@ステージ開始時処理（ステージ名表示） \
			d:LOAD_TYPE:SL_DOOR_TYPE １Ｆ下ドア 1600 d:DEFAULT_M_TYPE \
			d:wn_Ｅ脚集配場１Ｆ
	}
	case ( ヘリポートから ) {
		// ヘリポートから
		//初期マップの表示
		command マップ表示 -show Ｅ脚１Ｆ
		command マップ表示 -show Ｅ脚２Ｆ

		mesg マップ接合 １Ｆ／２Ｆ on

		$f:w20a_Ｂ１いるフラグ = 0;

		// 全てのセットが終わったところでフェードイン
		@ステージ開始時処理（ステージ名表示） \
			d:LOAD_TYPE:SL_DOOR_TYPE ２Ｆドア 2000 d:DEFAULT_M_TYPE \
			d:wn_Ｅ脚集配場２Ｆ
	}
	case ( テイルズＢエマノードアクセス後から ) {
		// ＥＦ連絡橋から
		//初期マップの表示
		command マップ表示 -show Ｅ脚１Ｆ
		command マップ表示 -show Ｅ脚Ｂ１

		mesg マップ接合 １Ｆ／Ｂ１ on

		$f:w20a_Ｂ１いるフラグ = 0;

		// 全てのセットが終わったところでフェードイン
		@ステージ開始時処理（ステージ名表示） \
			d:LOAD_TYPE:NO_MOVE_TYPE 紙芝居 0 d:DEFAULT_M_TYPE \
			d:wn_Ｅ脚集配場１Ｆ
	}
	default {
		//初期マップの表示
		command マップ表示 -show Ｅ脚１Ｆ
		command マップ表示 -show Ｅ脚Ｂ１
		mesg マップ接合 １Ｆ／Ｂ１ on
	}
}


//	スネークテイルズＢのＥ脚脱出前以後はベルトコンベア止まる
if ( ($b:ミッション番号 == d:MISSION:スネークテイルズ) && \
	 ($b:tales_story_no == d:TALES_NO:B) && \
	 ($b:tales_story_b >= d:TALES_B:Ｅ脚脱出前) ) {
	//	ベルトコンベアは停止する
	command ベルトコンベア動作 -stop
	command トラップ切り替え -trap onbl001 -switch 0
	command トラップ切り替え -trap onbl101 -switch 0
}else if($b:ミッション番号 == d:MISSION:敵兵排除){
	// 敵兵排除のＶＲウィンドウ表示中はベルトコンベアとまる。
	#if d:DEBUG_PRINT
		print '------------------------------- Elim belt stop'
	#endif
	command ベルトコンベア動作 -stop
}


// 各proc設定
//-------------------------------------------------------------------------------------
// 全マップ共通
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT
			print 'localvar_init'
		#endif
		eval( $i:w20a_コンベア待ち時間 = 0 );
		eval( $f:w20a_合流ＮＧフラグ = 0 );
		// ゲームステータスを格納するための変数
		eval( $i:ローカル変数Ｉ１ = 0 );
		// ベルトコンベアstopの二重呼び防止用
		eval( $f:ローカルフラグ１ = 0 );
		// ベルトコンベアにのったかどうかのフラグ
		eval( $f:ローカルフラグ２ = 0 );

		// クリアリング用子画面を初期化
		eval( $f:クリアリング子画面フラグ = 0 );

		// ＺＯＥダンボール再セット用
		eval( $f:w20a_アイテム再セット１ = 0 );
	}

	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT
			print 'status_set'
		#endif

		// 集配場はうるさいので従来の聴力の半分に設定
		eval( $w:敵標準聴力 = ($w:敵標準聴力/2) );
	}


	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif

		command プラグイン自動ジャンプ
	}

	proc ダンボール柄設定 {
		#if d:DEBUG_PRINT
			print 'cb_box_area_set'
		#endif

		// ＺＯＥダンボールエリア
		chara ダンボール柄トラップ設定 ダンボールエリア \
			-name d:PLAYER \
			-traps d:アイテム:ダンボールＥ bx001
	}


	// Ｂ１のクリアリング
	//---------------------------------------
	proc クリアリングエリア０初期設定 {
		#if d:DEBUG_PRINT
			print '$b:w20a_クリアリング回避回数='$b:w20a_クリアリング回避回数
		#endif

		command セットクリアリング \
			-i	d:C_R0:先頭兵ルート, \
				d:C_R0:２番兵ルート, \
				d:C_R0:３番兵ルート, \
			-p	0, d:C_R0:先頭兵ルート, 1 スタンチェック０ \
				0, d:C_R0:先頭兵ルート, 17 ダクトチェック０ \
				0, d:C_R0:先頭兵ルート, 20 隙間チェック０ \
				0, d:C_R0:先頭兵ルート, 25 ノードスキップ０−２７ \
				0, d:C_R0:先頭兵ルート, 1 子画面オンオフチェック０ \
				0, d:C_R0:先頭兵ルート, 1 クリアリングカメラ０−１ \
				0, d:C_R0:先頭兵ルート, 5 クリアリングカメラ０−２ \
				0, d:C_R0:先頭兵ルート, 10 クリアリングカメラ０−３ \
				0, d:C_R0:先頭兵ルート, 16 クリアリングカメラ０−４ \
				0, d:C_R0:先頭兵ルート, 27 クリアリングカメラ０−５
	}

	proc スタンチェック０ {
		// 規定回数に行くまではスタン投げを飛ばす
		if ( $b:w20a_クリアリング回避回数 < $w:クリアリングレベルアップ回数 || \
			 `command プレイヤーマップ名` != Ｅ脚Ｂ１ ) {
			command チェンジクリアリングルート 敵兵:61 -r d:C_R0:先頭兵ルート -p 3
		}
	}

	proc ダクトチェック０ {
		// normal以下で規定数以内またはダンボールをかぶっているときはダクトの中を見ない
		if ( $b:w20a_クリアリング回避回数 <= $w:クリアリングレベルアップ回数 || $w:ゲーム設定 <= d:LEVEL_NORMAL || \
			 $w:アイテム == d:アイテム:ダンボール || $w:アイテム == d:アイテム:ダンボールＢ || \
			 $w:アイテム == d:アイテム:ダンボールＣ || $w:アイテム == d:アイテム:ダンボールＤ || \
			 $w:アイテム == d:アイテム:ダンボールＥ || $w:アイテム == d:アイテム:濡れダンボール ) {

			if ( $i:プレイヤー位置Ｘ < 45250 ) {
				command チェンジクリアリングルート 敵兵:61 -r d:C_R0:先頭兵ルート -p 19
			}
		}
	}

	proc 隙間チェック０ {
		// normal以下で規定数以内のときは隙間の中を見ない
		if ( $b:w20a_クリアリング回避回数 <= $w:クリアリングレベルアップ回数 || $w:ゲーム設定 <= d:LEVEL_NORMAL ) {
			if ( $i:プレイヤー位置Ｘ > 46000 && $i:プレイヤー位置Ｚ > -85750 ) {
				command チェンジクリアリングルート 敵兵:61 -r d:C_R0:先頭兵ルート -p 26
			}
		}
	}

	proc ノードスキップ０−２７ {
		// 隙間をのぞいたときは26の静止はスキップする
		command チェンジクリアリングルート 敵兵:61 -r d:C_R0:先頭兵ルート -p 27
	}

	// クリアリング子画面チェック
	//---------------------------------------
	proc クリアリング子画面チェック {
		#if d:DEBUG_PRINT
			print 'clearing_sub_camera_check'
		#endif

		chara プロック連続実行 子画面チェック \
			-time -1 \
			-exec { \
				if ( $f:クリアリング子画面フラグ == 1 ) {
					if ( (`command プレイヤー状態取得` & d:PFLAG_INTRUDE) ) {
						command ゲットゲームステータス $i:ローカル変数Ｉ１
						if ( $i:ローカル変数Ｉ１ & d:STATE_CLEARING ) {
							mesg サブ画面 子画面 on
						}
					} else {
						mesg サブ画面 子画面 off
					}
				}
			}
	}

	proc 子画面オンオフチェック０ {
		eval( $f:クリアリング子画面フラグ = 1 );
	}

