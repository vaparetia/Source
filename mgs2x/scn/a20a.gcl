// 各gclで必要なdefine
// ------------------------------------
// モード
#define		STAGE_PLANT		1		// 共通プロック切り分け用
#define		STAGE_ALT		1		// オルタナティブミッション切り分け用
// ステージ名
#define		STAGE_W20A		1		// 共通プロック切り分け用
// 敵兵、ＮＰＣ状況（薬莢を呼び分けるのに必要）
#define		ENE_P_GOL		1		// 都市迷彩ゴル兵
#define		ENE_SHOT		1		// ショットガン兵
#define		ENE_HIGH_TECH	1		// ハイテク兵
#define		ENE_SHIELD		1		// 盾兵

// エマ関係(テイルズＢで使用するため)
#define		WITH_EMMA		1		// エマと一緒のロード処理をするのに必要
#define		EMMA_STAGE		a20e	// エマと一緒のロード処理をするのに必要
#define		EMMA_GEOVER_CAMERA	1	// エマのゲームオーバー時のカメラ


// 各種スイッチ用define
// ------------------------------------
// 入出トラップ
#define		STAGE_END		1		// ステージ終了時処理を使用可にする
// カメラ関係
#define		START_CAMERA	1		// ステージ開始時のカメラ
// ベルトコンベア
#define		BELT			1		// ベルトコンベアを組み込むかどうかのスイッチ(BELT=0なら以下は無意味)
#define		BELT_SPEED		25		// ベルトコンベアのスピード
#define		BELT_STOP_TIME	4		// ベルトコンベアが止まりきるまでの時間
#define		BELT_MOVE_TIME	4		// ベルトコンベアが加速しきるまでの時間
#define		BELT_ON_START	0		// ベルトコンベア登り始め
#define		BELT_ON_END		1		// ベルトコンベア登り終了
#define		BELT_OFF_START	2		// ベルトコンベア降り始め
#define		BELT_OFF_END	3		// ベルトコンベア降り終了
#define		BELT_ARRIVED	4		// ベルトコンベアにのって降りポイントに到着
#define		BELT_RESTART	5		// 降りポイントで降りなかったので再稼動
#define		1F_BELT			0		// 上のポイントから乗った
#define		B1_BELT			1		// 下のポイントから乗った
#define		NO_OTHER_OBJECT	0		// チェック内に他の荷物がない
#define		STL_BOX_L		w20a_bltobj_abx01		// 鉄箱
#define		STL_BOX_L_BRK	w20a_bltobj_abx01_bk	// 鉄箱壊れ
#define		CB_BOX_L		w20a_bltobj_dbbx01		// ダンボール
#define		CB_BOX_S		w20a_bltobj_dbbx02		// ダンボール小


// デバッグ関係
#ifdef	d:FIX_MODE
	#define		DEBUG_CHARA		0		// デバッグキャラ全体(FIX時は0)
#else
	#define		DEBUG_CHARA		0		// デバッグキャラ全体
#endif
#define		CHARA_CAMERA	0		// キャラ追従カメラ
#define		TARGET_CHARA	敵兵:01	// キャラ追従カメラのターゲット
#define		SCREENSHOT		0		// スクリーンショット
#define		USB_KEY			0		// USBキーボード


// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME			a20a
#define		KMS_NAME0			w20a0
#define		KMS_NAME1			w20a1
