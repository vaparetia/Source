#define		DOOR_NAME_W21A		w20a_dr01		// 外周用(EF連絡橋)
#define		DOOR_NAME_W20B		w20a_dr02		// 外周用(ヘリポート)

#define		DOOR_NAME_LV0		dr_free			// カードレベルなし室内共通ドア
#define		DOOR_NAME_EF_LV1	w20a_dr01x		// カードレベル１外周用ドア(EF連絡橋)
#define		DOOR_NAME_LV0_R		w20a_dr03x		// カードレベルなし梯子部屋ドア

#define		LT2_NAME			w20a

#define		PLAYER		ライデン	// モーションができるまで名前はスネーク

// ------------------------------------
// 敵兵音声
// ------------------------------------
// 司令官、危険モード時の音声リソース
resource ghq_area_alert_voice {
	w20a:
		$t{
			// PLAREA0 ＤＥ連絡橋側
			t:vc040176,	// 指揮官「了解。増援部隊、Ｅ脚に向かえ！ＤＥ連絡橋への扉を固めろ！」
			t:vc040177,	// 指揮官「了解。増援部隊、Ｅ脚・ＤＥ連絡橋への扉付近に向かえ！敵を逃がすな！」
			-2, // PLAREA0の登録終了
			// PLAREA1 ＥＦ連絡橋側
			t:vc040178,	// 指揮官「了解。応援部隊、Ｅ脚に向かえ！ＥＦ連絡橋への扉を守れ！」
			t:vc040179,	// 指揮官「了解。増援部隊、Ｅ脚・ＥＦ連絡橋への扉付近に向かえ！敵を逃がすな！」
			-2, // PLAREA1の登録終了
			// PLAREA2 ヘリポート扉
			t:vc040180,	// 指揮官「了解。応援部隊をＥ脚・ヘリポートへの扉付近に送る！敵の前進を阻止せよ！」
			t:vc040181,	// 指揮官「了解。増援部隊、Ｅ脚に向かえ！ヘリポートへの扉を固めろ！」
			-2, // PLAREA2の登録終了
			// PLAREA3 ヘリポートへの階段
			t:vc040182,	// 指揮官「了解。バックアップをＥ脚・ヘリポートへの階段に派遣する！敵を食い止めろ！」
			t:vc040183,	// 指揮官「了解。増援部隊、Ｅ脚に急行せよ！ヘリポートへの階段を守れ！」
			-2, // PLAREA3の登録終了
			// PLAREA4 Ｂ１への階段
			t:vc040184,	// 指揮官「了解。増援部隊、Ｅ脚１Ｆ・に向かえ！Ｂ１への階段を守れ」
			t:vc040185,	// 指揮官「了解。応援部隊をＥ脚１Ｆ・Ｂ１への階段に送る。敵を逃がすな！」
			-2, // PLAREA4の登録終了
			// PLAREA5 １Ｆ全体
			t:vc040186,	// 指揮官「了解。増援部隊、Ｅ脚に急行せよ！侵入者を仕留めろ！」
			t:vc040187,	// 指揮官「了解。増援部隊をＥ脚に派遣する！敵を包囲せよ！」
			-1 // 全ての登録終了
		}
}

// 司令官、警戒モード時の音声リソース
resource ghq_caution_voice {
	w20a:
		$t{
			t:vc040348,		// 指揮官「了解。Ｅ脚に増員を派遣する。警戒を強化しろ」
			t:vc040349,		// 指揮官「了解。Ｅ脚に増員を送る。警戒を強化しろ」
			-2
			t:vc040427,		// 指揮官「Ｅ脚との連絡が途絶えた」
			-3
			t:vc040609		// 指揮官「Ｅ脚で異常発生、至急確認に向かえ」
			-1
		}
}

// 敵兵ルート番号
enum E_R {
	攻撃兵待機ルート下 = 4,
	攻撃兵待機ルート上,
	定時連絡ルート,
	中央巡回ルート,
	階段巡回ルート,
	定時連絡ルートＥＸ,
	中央巡回ルートＥＸ,
	階段巡回ルートＥＸ,
	定時連絡ルート補助,
	警戒追加ルート,
	のりのりルートＶＥ,
	のりのりルートＥ,
	のりのりルートＮ,
	のりのりルートＨ,
	のりのりルートＥＸ
}

// クリアリングルート
enum C_R0 {
	先頭兵ルート = 0,
	２番兵ルート,
	３番兵ルート
}


// アイテム番号（アイテムが多いのでenumで）
enum I_NO {
	M9_R01 = 0,
	SOCOM_R01,
	SOCOM_R02,
	SOCOM_R03,
	M4_R01,
	STUN_01,
	RATION_01,
	PSG1T_R01,
	STINGER_R01
}


// モーションリスト
enum ハッチモーションリスト {
	non_ladder_open2hatch_radio_hatch= 0
}



// ドア設定用ステージ内ローカル変数(a_mode.hよりも先に定義する)
dim $$b:ドアフラグ[ 5 ]
dim $$s:ドアモデル名[ 5 ]

command	配列セット $$b:ドアフラグ[0] {
	0,	0,	0,	0,	0
}
command	配列セット $$s:ドアモデル名[0] {
	0,	0,	0,	0,	0
}

// ステージ内ローカル変数
$$s:ヘリポートロードプロック = a20b;


// include
// ------------------------------------
#include "rai_a20a.mh"		// 強制モーションリスト
#include "stdch.h"
#include "enevoice.h"
