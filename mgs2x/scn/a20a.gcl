#define		KMS_NAME0_21		w20a_21a
#define		KMS_NAME1_20		w20a_20b
#define		CEIL_NAME0			w20a0r
#define		DOOR_NAME_LV5_R		w20a_dr03		// カード５向かって右開きドア
#define		DOOR_NAME_LV5_L		dr_lv5_02		// カード５向かって左開きドア
