					-c 0 \
					-b 60832,4496,-89184 62601,4496,-89184 \
					-l 60832,1610,-89868 62601,1610,-89868 \
					-r 871,2048,0 \
					-f 2962 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3
			}

		// １Ｆ部分の張り付きカメラ
		trap ca007 d:PLAYER \
			-mask ？ \
			-dir 2048 512 \
			-state d:TRP_STATE_CAUTION \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ１ \
					-c 0 \
