//###################################################################################
//									カメラ
//###################################################################################

	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0 
		chara カメラ 小部屋カメラ		-c 0 -l 2 -p 40
		chara カメラ 通路カメラ		-c 0 -l 2 -p 30
		chara カメラ ロードカメラ		-c 0 -l 2 -p 20
		chara カメラ モーションカメラ		-c 0 -l 2 -p 10
		chara カメラ ゲームオーバーカメラ		-c 0 -l 0 -p 5

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \	
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 425,2048,0 \
			-f 7500 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}
	proc アーセナルギア小部屋Ｂカメラ設定 {
		#if d:DEBUG_PRINT
			print 'w45a_camera_set'
		#endif

		// 南側通路
		trap ca001 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ降順 $6 -133750 -139750 900 100
				eval( $i:補完ＲＸ = $i:CS_結果１ );

				chara カメラ設定 通路カメラ \
					-c 0 \
/*
					-b  250,d:CAM_MIN,d:CAM_MIN 1750,d:CAM_MAX,-134000 \
					-l  250,d:CAM_MIN,d:CAM_MIN 1750,d:CAM_MAX,-134250 \
*/
					-b  70,d:CAM_MIN,d:CAM_MIN 1935,d:CAM_MAX,-134124 \
					-l  70,d:CAM_MIN,d:CAM_MIN 1935,d:CAM_MAX,-134303 \
					-r $i:補完ＲＸ,2048,0 \
					-f 4500 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3
			}

		// 大部屋
		trap ca002 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ降順 $6 -140750 -150750 900 450
				eval( $i:補完ＲＸ = $i:CS_結果１ );

				chara カメラ設定 小部屋カメラ \
					-c 0 \	
					-b -4000,d:CAM_MIN,d:CAM_MIN 4000,10000,-140750 \
					-l -4000,d:CAM_MIN,d:CAM_MIN 4000,10000,-141000 \
					-r $i:補完ＲＸ,2048,0 \
					-f 9000 \
					-a 200 \
					-i 2 -1 0 0 \
					-s $3
			}
	}

	proc 亀甲床設定 {
# if 0
		chara 亀甲床 亀甲床ちゃん \
				-size $i:外接円半径  \		//	200	大きくしたいときは多くする
				-prims $i:プリミティブ数 \	//	128	はでにしたいときは多くする
				-vertex $i:最大頂点数 \		//	10	広くしたいときは多くする
				-time $i:消去までの時間 \	//	150/300	0.5秒
				-alpha $i:最大アルファ値 \	//	32	
				-color $i:R $i:G $i:B \		//	
				-maxpoint $i:最大発生点数	//	はでに線をのばしたいときは多くする

			//	原点		0,0,-149250
			//	半径		7000
# endif
		chara 亀甲床 亀甲床ちゃん \
				-prims 128 \
				-alpha 10 \
				-vertex 10 \
				-user 32 \
				-region 0 -149250 7000
	}



//###################################################################################
//									デモ
//###################################################################################

proc 天狗兵降下デモ {
	trap de001 d:PLAYER \
		-mask 入る \
		-e {
			if ($f:w45a_天狗兵登場フラグ == d:FALSE) {
				eval ($f:w45a_天狗兵登場フラグ = d:TRUE)
				//	ＢＧＭフェードアウト
				command セットサウンドコード -c d:SNG_FOUTS_S

				//	強制姿勢制御
				mesg プレイヤー d:PLAYER stance 0  -1  2048 0
				//	登場ポイントを変更
				eval($s:登場ポイント = 天狗兵降下デモ終了後)

				//	登場位置を再代入
				eval( $i:プレイヤー初期Ｘ位置 = 0 ) ;
				eval( $i:プレイヤー初期Ｙ位置 = 0 ) ;
				eval( $i:プレイヤー初期Ｚ位置 = -149250 ) ;
				eval( $i:プレイヤー初期方向 = 2048 ) ;

				//	ストーリーフラグを立ててリスタートでデモへ
				if($w:アイテム == d:アイテム:ゴル兵制服){
					@ポリゴンデモロード d:ST:P077_02_P01天狗兵降下ラッシュポリゴンデモ１開始
				} else {
					@ポリゴンデモスタート d:ST:P077_02_P01天狗兵降下ラッシュポリゴンデモ１開始
				}
			}
		}

}

	proc ポリデモロードスタート {
		//	レジデント５へ読み替える
		load "w45a" -r 'r_plt5'
	}

	proc フォーチュン登場デモ {
		chara delay 登場デモディレイ \
			-t 120 \
			-e {
				//	ストーリーフラグを立ててリスタートでデモへ
				//@ポリゴンデモスタート d:ST:P078_01_P01ＡＧフォーチュン登場１ポリゴンデモ１開始
				eval($w:p_story = d:ST:P078_01_P01ＡＧフォーチュン登場１ポリゴンデモ１開始)
				@天狗兵終了ロード設定
			}

}



//###################################################################################
//									ストーリーフラグ
//###################################################################################



//###################################################################################
//									特殊ゲームオーバー
//###################################################################################

	proc 偽ゲームオーバー終了 {
		//	ゲームオーバーが終了したらフラグを戻す
		eval($f:w45a_偽ゲームオーバーフラグ =d:FALSE )
		//	ラジオオン
		command メニュー設定 \
			-radio on
		print 'BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB'
		print '$f:w45a_偽ゲームオーバーフラグ'$f:w45a_偽ゲームオーバーフラグ
	}
	
	proc 偽ゲームオーバー設定 {

		if ($f:w45a_天狗兵登場フラグ == d:TRUE) {
			chara プロック連続実行 天狗兵死亡数管理人 \
				-t -1 \
				-e {
					if (`command ゲット倒した天狗兵` == 20 ) {
						if ($f:w45a_偽ゲームオーバーフラグ == d:FALSE) {
							eval($f:w45a_偽ゲームオーバーフラグ = d:TRUE )
							print 'AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'
							print '$f:w45a_偽ゲームオーバーフラグ'$f:w45a_偽ゲームオーバーフラグ
							command メニュー設定 \
								-radio off

							chara 偽ゲームオーバー画面 偽ゲームオーバー \
								-time 6000 \		//	1/300秒単位
								-x	fake_gameover fake_failed_alp_ovl fake_exit_alp_ovl fake_cont_alp_ovl \
								-proc 偽ゲームオーバー終了 \
								-vox t:vc130000
						}
					} else if (`command ゲット倒した天狗兵` == 40) {
						if ($f:w45a_偽ゲームオーバーフラグ == d:FALSE) {
							eval($f:w45a_偽ゲームオーバーフラグ = d:TRUE )
							print 'CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC'
							print '$f:w45a_偽ゲームオーバーフラグ'$f:w45a_偽ゲームオーバーフラグ

							chara 偽ゲームオーバー画面 偽ゲームオーバー \
								-time 3000 \		//	1/300秒単位
								-x	fake_gameover fake_failed_alp_ovl fake_exit_alp_ovl fake_cont_alp_ovl \
								-proc 偽ゲームオーバー終了 \
								-vox t:vc130000
						}
					}

				}
		}
	}










//###################################################################################
//								ＮＰＣ設定
//###################################################################################

	//	スネーク死亡
	proc スネーク死亡 {
		if(`command ゲームオーバーチェック` == 1) {
			return
		}

		print 'AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'
		eval($f:pgo_ＮＰＣスネーク死亡 = 1)

		//	特殊装備解除
		@特殊装備解除

		//	ニキータ、サーマル、ナイトビジョンも外す
		if ($w:武器 == d:武器:ニキータ) {
			eval($w:武器 = d:武器:素手)
		}
		if ( ($w:アイテム == d:アイテム:暗視ゴーグル) || \
			($w:アイテム == d:アイテム:サーマルゴーグル) ){
			eval($w:アイテム = d:アイテム:素手)
		}

		//	ゲームオーバーカメラ設定

		//	念のためサイトを消す
		command サイト表示制御 \
			-switch off

		command コントロール座標取得 \
			スネーク $i:スネークＸ座標変数 $i:スネークＹ座標変数 $i:スネークＺ座標変数

		//	シネマスクリーン起動
//		mesg シネマスクリーン シネマ フェードアウト 1

		if ($i:スネークＺ座標変数 < -142250) {
			chara カメラ設定 ゲームオーバーカメラ \
				-c 1\	
				-p $i:スネークＸ座標変数,($i:スネークＹ座標変数+4000),($i:スネークＺ座標変数+500) \
				-t $i:スネークＸ座標変数,$i:スネークＹ座標変数,$i:スネークＺ座標変数 \
				-a 200 \
				-i 0 -1 0 0 \
				-d 1 \
				-s 1
		} else if ($i:スネークＺ座標変数 < -139750) {
			chara カメラ設定 ゲームオーバーカメラ \
				-c 1\	
				-p 54,6470,-139980 \
				-t 54,-2483,-140820 \
				-a 180 \
				-i 0 -1 0 0 \
				-d 1 \
				-s 1
		} else {
			chara カメラ設定 ゲームオーバーカメラ \
				-c 1\	
				-p $i:スネークＸ座標変数,($i:スネークＹ座標変数+2000),-134124 \
				-t $i:スネークＸ座標変数,$i:スネークＹ座標変数,$i:スネークＺ座標変数 \
				-a 200 \
				-i 0 -1 0 0 \
				-d 1 \
				-s 1
		}
	}
	
	proc スネーク設定 {

		//	髭剃りスネーク対応
		@髭剃りスネークテクスチャ入れ替え処理

		if ($f:w45a_天狗兵登場フラグ == d:TRUE) {
			chara ＮＰＣスネーク スネーク \
				-m sna_def \
				-a npc_snake \
				-c npc_snake_cap \
				-d npc_snake_drag \
				-y sna_npc \
				-x 875,0,-148750 \
				-r 0, 2048, 0 \
//				-l 2 \
				-l $i:w45a_スネークレベル \
				-t 1 \
				-s 10 \
				   -125,0,-152625 0x00000000 \
				  -2000,0,-152125 0x00000000 \
				  -3500,0,-150375 0x00000000 \
				  -3375,0,-148375 0x00000000 \
				  -2125,0,-146625 0x00000000 \
				   -125,0,-146000 0x00000000 \
				   2000,0,-146750 0x00000000 \
				   3125,0,-148375 0x00000000 \
				   3125,0,-150375 0x00000000 \
				   1875,0,-151875 0x00000000 \
				-h 1 \
				-n sna_def_mh \
				-u ドッグタグ_敵兵 \
				[dogtag:plt_w43a_snake_ve] [dogtag:plt_w43a_snake_ea] [dogtag:plt_w43a_snake_no] \
				[dogtag:plt_w43a_snake_ha] [dogtag:plt_w43a_snake_vh] \
				-g スネーク死亡 \
				-v $i:w45a_スネークライフ \
				-w 1			//	$f:足影を有効にするかどうかのフラグ

		} else {
			chara ＮＰＣスネーク スネーク \
				-m sna_def \
				-a npc_snake \
				-c npc_snake_cap \
				-d npc_snake_drag \
				-y sna_npc \
				-x $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,($i:プレイヤー初期Ｚ位置+1000) \
				-r 0,$i:プレイヤー初期方向,0 \
				-t 2 \
				-h 1 \
				-n sna_def_mh \
				-u ドッグタグ_敵兵 \
				[dogtag:plt_w43a_snake_ve] [dogtag:plt_w43a_snake_ea] [dogtag:plt_w43a_snake_no] \
				[dogtag:plt_w43a_snake_ha] [dogtag:plt_w43a_snake_vh] \
				-g スネーク死亡 \
				-v $i:w45a_スネークライフ \
				-w 1			//	$f:足影を有効にするかどうかのフラグ
		}
		//バンダナ
		chara ロープモデル３ バンダナ１ \
			-n sna_bdn1 \
			-d 1 \
			-y スネーク \
			-z 12 \
			-x 0,60,-90 \
			-m 12 \
			-p 250 \
			-k 350 \
			-o 110 \
			-v \
			-f 1

		chara ロープモデル３ バンダナ２ \
			-n sna_bdn2 \
			-d 1 \
			-y スネーク \
			-z 12 \
			-x 0,50,-90 \
			-m 22 \
			-p 250 \
			-k 350 \
			-o 110 \
			-v \
			-f 1

		//	息設定
		mesg ＮＰＣスネーク スネーク 白い息 136

		//スネークアイテム制限
		mesg ＮＰＣスネーク スネーク アイテムを出す数の制限 \
			$i:w45a_スネークレーション数 \
			$i:w45a_スネークソコム数 \
			$i:w45a_スネークＭ４数

	}

	proc フォーチュン設定 {
		#if d:DEBUG_PRINT 
			print 'fortune_set'
		#endif

		chara ルートデモ人形 デモフォーチュン \
			-route 3 0 \ 
			-kms for_def_sh_mt \
			-mar sna_w45a \
			-number d:スネークモーションリスト:sna_run
	}



//###################################################################################
//								武器設定
//###################################################################################

	proc 刀設定 {
		eval ( $w:武器最大数Ｒ[ d:武器:ブレード ] = 1 )
		eval ( $w:武器弾数Ｒ[ d:武器:ブレード ] = 1 )
		eval ( $w:武器最大数[ d:武器:ブレード ] = 1 )
		eval ( $w:武器弾数[ d:武器:ブレード ] = 1 )
	}

