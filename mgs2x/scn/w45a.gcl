proc 水面セット {
	#if d:DEBUG_PRINT
		print 'water_set'
	#endif

	chara 頂点アニメブラー 仮水面 \
		-model w11a_sea \
		-base 10 \
		-width 1 \
		-flag 5 \
		-pos 0,0,0
}

	proc ゲームオーバー設定 {
		command システムコールバック \
			-gameover コンティニュー設定 \
			-continue コンティニュー設定
	}

	proc コンティニュー設定 {
		print '####################################################CONTINYU'
		command ゲット倒した天狗兵
		print '####################################################TENGUHEISCORE' $status
	}


// 以下デバッグ専用proc
// -----------------------------------------------------------------------------------
// デバッグキャラ
// ------------------------------------
proc デバッグキャラセット {
	#if d:DEBUG_PRINT
		print 'debug_chara_set'
	#endif

	#if d:CHARA_CAMERA
		chara キャラカメラ 敵兵カメラ \
			-c d:TARGET_CHARA \
			-s -920,610,200 \
			-r -200,1024,0 
	#endif

	#if d:SCREENSHOT
		chara スクリーンショット shot
	#endif

	#if d:USB_KEY
		chara USBキーボード実行 test \
			-e d:KBD_ESC {	
				mesg プレイヤー d:PLAYER position -5500, -13000, -500
			} \
	#endif
}

