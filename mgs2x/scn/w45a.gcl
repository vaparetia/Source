	proc 天狗兵コマンダー {
#if d:DEBUG_PRINT
	print '*** Tengu Commander'
#endif

		chara 天狗兵コマンダー tng_com -e { 天狗兵０ } \
			-warp ch001 \
			-sub スネーク \
			-type 1 \
			-defense \

			4  0 0 \
			5  1 0 \
			6  0 0 \
			7  1 0 \
			8  0 0 \
			9  1 0 \
			10  0 0 \
			11  1 0 \

			4  0 0 \
			5  1 0 \
			6  0 0 \
			7  1 0 \
			8  0 0 \
			9  1 0 \
			10  0 0 \
			11  1 0 \
			4  0 0 \
			5  1 0 \
			6  0 0 \
			7  1 0 \
			8  0 0 \
			9  1 0 \
			10  0 0 \
			11  1 0 \
			4  0 0 \
			5  1 0 \
			6  0 0 \
			7  1 0 \
			8  0 0 \
			9  1 0 \
			10  0 0 \
			11  1 0 \
		-final	(0 ),(0),(0) \
		-res	(-11750) (8000) (-152000) \
			 	(11750) (8000) (-146500) \

		-proc フォーチュン登場デモ \
		-guard $i:w45a_天狗兵刀ガード回数 \
//		-mode d:TNG_COM_DEBUG \		//	デバッグ用
		-c 0
	}

	proc コマンダー設定 {
#if d:DEBUG_PRINT
	print '*** Enemy Set'
#endif
		if ($f:w45a_天狗兵登場フラグ == d:TRUE) {
			// コマンダー
			chara コマンダー 敵兵セット \
				-a 天狗兵コマンダー \
				-r -11750,8000,-152000 アーセナルギア小部屋Ｂ 11750,8000,-146500 アーセナルギア小部屋Ｂ \
				-c -11750,8000,-152000 アーセナルギア小部屋Ｂ 11750,8000,-146500 アーセナルギア小部屋Ｂ \
				-v [ene_plant_voice:01] \
				-b $i:w45a_天狗兵復活人数 \	// $i:危険モードでの復活人数 
				-k $i:w45a_天狗兵復活人数 \
				-s (d:ENE_STAGE_NPC_SNAKE | d:ENE_STAGE_NO_STRM | d:ENE_STAGE_ALERT2SNEAK | d:ENE_STAGE_NO_WC_GOVER) \
				-m $w:スタートアラートモード \
				-h $i:標準警戒時間		// 警戒時間
		}
	}



