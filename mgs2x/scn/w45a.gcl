// 各種スイッチ用define
// ------------------------------------
// サウンド
#define		SOUND			1		// サウンドデータは最初に呼ぶ
#define		BGM				1		// BGMは敵兵コマンダーの後に呼ぶ
// キャラクター関係
#define		RAIDEN			1		// SNAKEとは排他
#define		SNAKE			0
#define		ENEMY			1		// コマンダーと警備兵(敵を出すときは必須)
#define		SUPPORT			0		// サポート兵
#define		ATTACKER		0		// 攻撃兵
#define		SHIELD			0		// 盾兵(1) or 通常攻撃兵(0)
#define		DOLL			1
// 監視カメラ関係
#define		CYPHER			0		// サイファー
// ドア
#define		SLIDE_DOOR		1		// スライドドア
// 入出トラップ
#define		LOAD_TRAP		1
#define		STAGE_END		1		// ステージ終了時処理を使用可にする
// フォグ
#define		FOG				1
// エフェクト関係
#define		EFFECT			0		// エフェクト全般
#define		BLUR			0		// ブラー
#define		Z_MANAGER		0		// Ｚフォーカス管理(敵のライト等で仕様)
#define		BODY_SHADOW		0		// 敵のライトによって出る影

#define		BREATH			1		// 白い息
// 子画面
#define		SUB_CAMERA		0
// カメラ関係
#define		CLEAR_CAMERA	0		// クリアリング専用カメラ(要子画面)

// 天井
#define		CHARA_CEIL		0		// 天井君
// 透明壁
#define		TR_WALL			0		// シナリオ置きの透明壁
// ライト関係
#define		SPOT_LIGHT		0		// スポットライト
#define		CHARA_LIGHT		1		// キャラ専用ライト

// オブジェ関係
// アイテム
#define		ITEM			1
// 強制モーション
#define		BY_MOTION		0		// ビヨンドモーション

//	デモ
#define		POLY_DEMO		1		//	ポリデモ

// デバッグ関係
#ifdef	d:FIX_MODE
	#define		DEBUG_CHARA		0		// デバッグキャラ全体(FIX時は0)
#else
	#define		DEBUG_CHARA		0		// デバッグキャラ全体
#endif
#define		CHARA_CAMERA	0		// キャラ追従カメラ
#define		TARGET_CHARA	敵兵:01	// キャラ追従カメラのターゲット
#define		SCREENSHOT		0		// スクリーンショット
#define		USB_KEY			0		// USBキーボード


// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME			w45a
#define		KMS_NAME			w45a
#define		KMS_NAME0			w44a_dummy
#define		LT2_NAME			w45a
//#define		DOOR_NAME_LOAD		w41a_dr_left
#define		DOOR_NAME_LOAD1A	w45a_dr_left_temae
#define		DOOR_NAME_LOAD1B	w45a_dr_right_temae
#define		DOOR_NAME_1A		w45a_dr_left_oku
#define		DOOR_NAME_1B		w45a_dr_right_oku



// キャラクター関係
#if d:RAIDEN
	#define		PLAYER		ライデン	// モーションができるまで名前はスネーク
#else
	#define		PLAYER		スネーク
#endif

//	薬莢系
#define		ENE_TNG					1	//	天狗兵
#define		NPC_SNAKE				1	//	ＮＰＣスネーク

//	ステージ系
#define		STAGE_W45A				1
	
#define		STAGE_PLANT				1	//	プラント編

#define		POLYDEMO_LOAD		1

// ローカル変数
//	$f:w45a_天狗兵登場フラグ			天狗兵が登場したかどうか

//	$i:w45a_天狗兵刀ガード回数			天狗兵の連続刀ガードの回数
//	$i:w45a_天狗兵復活人数				天狗兵の復活人数（総数は＋８人）
//	$f:w45a_偽ゲームオーバーフラグ		偽ゲームオーバー中かどうか

//	$i:スネークＸ座標変数				スネークの座標
//	$i:スネークＹ座標変数				スネークの座標
//	$i:スネークＺ座標変数				スネークの座標
//	$i:スネークＺ座標変数				スネークの座標

//	$i:w45a_スネークレベル				スネークのレベル
//	$i:w45a_スネークレーション数		スネークのレーション供給数
//	$i:w45a_スネークソコム数			スネークのソコム弾供給数
//	$i:w45a_スネークＭ４数				スネークのＭ４弾供給数
//	$i:w45a_スネークライフ				スネークのライフ

//	$w:w45a_天狗兵体力					天狗兵ライフ
//	$w:w45a_天狗兵気絶					天狗兵気絶値

// モーション関係
// ------------------------------------
enum スネークモーションリスト {
	sna_idle = 0,
	sna_run,
	sna_fire
}



