#if 0
	//	w45a_d_common.h内に記述
	proc ドア設置 {
		#if d:DEBUG_PRINT
			print 'slide_door_set'
		#endif

		chara ドア 南側ドア \
			-m d:DOOR_NAME_LOAD1A \
			-d 0,0,0 \
//			-p -750,0, -134125 \
			-p 1250,0, -133125 \
			-slide d:SD_SLIDE_ARSENAL_LEFT \
			-time (d:SD_OPEN_TIME + 10)\
			-between アーセナルギア小部屋Ｂ アーセナルギア小部屋Ｂ \
			-w_door d:DOOR_NAME_LOAD1B d:SD_SLIDE_ARSENAL_RIGHT \
			-h 1500 \
//			-card_level 7 \			//	無理矢理開かなくする
			-exec {
				if ( !($:開閉フラグ) ) {
					mesg プットオブジェ ロードエリア off
				} else {
					mesg プットオブジェ ロードエリア on
				}

			}

		//	ドアは開かない
		trap dr001 ？ \
			-mask ？ \	
			-exec {
					if ($3 == 入る) {
						mesg ドア 南側ドア open $2
					} else {
						mesg ドア 南側ドア close $2
					}
			}

	}
#endif


//###################################################################################
//									開始時処理
//###################################################################################

	proc アーセナルギア小部屋Ｂ開始時処理 {

		// 通路Ｂから
		if ( $s:登場ポイント == sp_w44a_w45a_0 ) {
			@ステージ開始時処理（ステージ名表示）\
			d:LOAD_TYPE:SL_DOOR_TYPE 南側ドア 4500 d:DEFAULT_M_TYPE \
			d:wn_アーセナルギアＳ状結腸
//			@ロード時カメラ設定
			@無線設定
			//	ＢＧＭを鳴らす
			command セットサウンドコード -c d:SNG_PLAY_06

		//	天狗兵降下デモ終了後
		} else if ($s:登場ポイント == 天狗兵降下デモ終了後) {
			@ステージ開始時処理 d:LOAD_TYPE:NO_MOVE_TYPE 0 0 0
			//	ＢＧＭを鳴らす
			command セットサウンドコード -c d:SNG_PLAY_02

		}
	}



//###################################################################################
//									ロード設定
//###################################################################################

	proc ロードプロック {
		#if d:DEBUG_PRINT 
			print 'load_proc'
		#endif

		if ($s:呼び出しプロック == mv_w45a_w44a_0) {
			// 通路Ｂへ
//			@mv_w45a_w44a_0
		} else if ($s:呼び出しプロック == mv_w45a_d078p01_0) {
			@mv_w45a_d078p01_0
		}
	}
	
	proc アーセナルギア小部屋Ｂロード設定 {
	/*
		trap ld001 d:PLAYER \
			-mask 入る \
			-exec {
				if($f:ロードチェックＯＮフラグ == 1) {
					@ステージ終了時処理 0 0 -133000 0 mv_w45a_w44a_0 d:DEFAULT_M_TYPE
				}
			}
	*/
	}

	proc 天狗兵終了ロード設定 {
		command セットサウンドコード -c d:SNG_FOUTS_S
//		@ステージ終了時処理 0 0 -159000 2048 mv_w45a_d078p01_0 d:DEFAULT_M_TYPE
		@ステージ終了時処理 0 0 0 0 mv_w45a_d078p01_0 d:NO_MOVE_M_TYPE
		//	先読み
		preseek 'd078p01'
	}

	proc ロード時カメラ設定 {
		chara カメラ設定 ロードカメラ \
						-c 1 \	
						-p -216,3345,-135845 \
						-t 1469,1904,-133903 \
						-a 200 \
						-i 0 1 0 0 \
						-s 1

		chara プロック連続実行 カメラ戻し管理人 \
			-proc カメラ戻し管理
	}

	proc カメラ戻し管理 {
		command パッドチェック \
			-no_use
		if ($status != 1) {
			chara カメラ設定 ロードカメラ \
				-s -1
			mesg プロック連続実行 カメラ戻し管理人 kill
		}
	}

	proc 無線設定 {
		//	ここのドアは開いた状態でスタート
		mesg ドア 南側ドア openstart

		chara プロック連続実行 無線管理人 \
			-t -1 \
			-e {
				print'AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'
				if (`command パッドチェック -no_use` != 1) {
					//	２度と開かない
					mesg ドア 南側ドア locked
					//	ＢＧＭフェードアウト
					command セットサウンドコード -c d:SNG_FOUTS_S
					eval( $w:p_story = d:ST:P077_01_R01ローズ拉致１無線機デモ１開始 )
					@rt_P077_01_R01ローズ拉致１無線機デモ１
					mesg プロック連続実行 無線管理人 kill
				}
			}
	}

//###################################################################################
//									オブジェクト
//###################################################################################

	proc オブジェクト設定 {
		chara プットオブジェ 開きっぱ左ドア \
			-m d:DOOR_NAME_1A \
			-r 0,0,0 \
			-p -1225,0,-139625 -l d:LT2_NAME \
			-s 100,100,100
		chara プットオブジェ 開きっぱ右ドア \
			-m d:DOOR_NAME_1B \
			-r 0,0,0 \
			-p 750,0,-139625  -l d:LT2_NAME \
			-s 100,100,100

		chara プットオブジェ ロードエリア \
			-m d:KMS_NAME0 \
			-r 0,0,0 \
			-p 0,0,0 -l d:LT2_NAME \
			-s 100,100,100

	}



//###################################################################################
//									アイテム
//###################################################################################

	proc アイテム設定 {
		#if d:DEBUG_PRINT
			print 'item_set'
		#endif

		@アイテム再セットチェック（難易度対応） $b:w45a_取得ロード回数[0]
		if ($f:再セットフラグ) {
			@レーション_初期設置 レーション:01 2500 0 -138750 0
		}
	}

	proc アイテム取得時番号設定 $:ボックス名 {
		#if d:DEBUG_PRINT
		print '*** Item No Set ***'
		#endif

		if($:ボックス名 == レーション:01) {
			eval($b:w45a_取得ロード回数[0] = $w:グローバルロード回数);
		}

	}


