			mesg Ｚフォーカス管理 Z_manager パラメータ 5000 30
		#endif

		#if d:BODY_SHADOW
			chara ＯＦＦ制御 off_man
			mesg ＯＦＦ制御 off_man ボディシャドウＯＦＦ
		#endif
	}

	proc キャラ用ライト設定 {
		#if d:DEBUG_PRINT
			print 'chara_light_set'
		#endif
	# if 1
		chara 環境光 環境光源 \
			 -c 40 90 75

		chara 平行光 平行光源 \
			 -c 68 113 94 \
			 -p 1069 -2860 -3958
	# endif
	}

	proc 息設定 {
		#if d:DEBUG_PRINT
		print 'PLAYER_BREARH'
		#endif
		chara 白息 プレイヤー息 \
			-name d:PLAYER \
			-object 12 \
			-shift 0,-30,130 \
			-interval 136
		mesg 白息 プレイヤー息 on
	}

