// マップ設定
// ------------------------------------
chara マップ アーセナルギア小部屋Ｂ	-k d:KMS_NAME \
									-h d:HZX_NAME,0 \
									-l d:LT2_NAME


command マップ設定 アーセナルギア小部屋Ｂ -set {
	@サウンド設定		//	サウンド設定はゲーム、デモ共通
}

// 平野追加。デモ再生用ヘッダ。この位置を変えないこと。
#include "polydemo_w45a.h"

command マップ設定 アーセナルギア小部屋Ｂ -set {

#if 0
	eval ($f:w45a_天狗兵登場フラグ = d:TRUE)

	eval($s:登場ポイント = 天狗兵降下デモ終了後)

	//	登場位置を再代入
	eval( $i:プレイヤー初期Ｘ位置 = 0 ) ;
	eval( $i:プレイヤー初期Ｙ位置 = 0 ) ;
	eval( $i:プレイヤー初期Ｚ位置 = -149250 ) ;
	eval( $i:プレイヤー初期方向 = 2048 ) ;
#endif

	// 平野追加。デモ呼び分け用。
	if ($s:d_num == not_demo) {
		#if d:SOUND	
//		@サウンド設定	// データは最初に呼ぶ。
		#endif
	}
	@常駐キャラ設定

	// 平野追加。デモ呼び分け用。
	if ($s:d_num == not_demo) {
		@ローカル変数初期化
		@設定値変更
		@プラグイン設定
		@プレイヤー設定
		@亀甲床設定
		@スネーク設定
		#if d:ENEMY
		@コマンダー設定
		#endif
		#if d:DOLL
//		@フォーチュン設定
		#endif
		#if d:BGM
		@ＢＧＭ設定	// プレイヤー→敵兵→BGMの順で呼ぶ
		#endif
		#if d:SLIDE_DOOR
		@ドア設置
		#endif
		#if d:LOAD_TRAP
		@アーセナルギア小部屋Ｂロード設定
		#endif
		@オブジェクト設定
		#if d:ITEM
		@アイテム設定
		#endif
		#if d:FOG
		@フォグ設定
		#endif
		#if d:EFFECT
		@エフェクト設定
		#endif
		@レンズフレア設定
		#if d:BREATH
		@息設定
		#endif
		@空中文字設定

		@カメラセット
		@アーセナルギア小部屋Ｂカメラ設定
		#if d:CHARA_LIGHT
		@キャラ用ライト設定		// マップ設定の最後に呼ぶ
		#endif

		@危険スタート
		@刀設定
		# if d:POLY_DEMO
		@天狗兵降下デモ
		# endif
		if ($f:w41a_ノードフラグ == 1) {
			@プラント編全体マップ設定 d:アーセナルギアＳ状結腸	//	全体マップ表示
		} else {
			@ポーズ時ステージ名表示設定 d:wn_アーセナルギアＳ状結腸	//	ポーズ時ステージ名表示
		}

		@偽ゲームオーバー設定
		@シナリオデモキャラセット
//		@ゲームオーバー設定

		#if d:DEBUG_CHARA
//		@デバッグキャラセット
		#endif

		#if d:USB_KEY
//		@ＵＳＢキーボードセット
		#endif
	}
}

// 無線用include ※位置は動かさないこと
#include "w45a_cdc.ch"
#include "p_force_cdc.ch"

//初期マップの表示
command マップ表示 -show アーセナルギア小部屋Ｂ


// 全てのセットが終わったところでフェードイン
	// 平野追加。デモ呼び分け用。
	if($s:d_num == not_demo){
		@アーセナルギア小部屋Ｂ開始時処理
	} else {
/*
		chara フェードインアウト フェードイン \
			-i 0,0,0 128 \
			-c 0,0,0 0 \
			-t d:FADEIN_TIME
*/
	}



//###################################################################################
//									各proc設定
//###################################################################################


//###################################################################################
//									全マップ共通
//###################################################################################

	proc サウンド設定 {
		#if d:DEBUG_PRINT 
			print 'sound_set'
		#endif

		chara サウンドマネージャー ＳＤマネ -pak 0

		@サウンド効果音設定
		command 弾痕ノーマル -n 0
		command 弾痕ノーマル -n 1
		command 弾痕ノーマル -n 3

		command 跳弾ノーマル -n 0
		command 跳弾ノーマル -n 1
		command 跳弾ノーマル -n 3
	}

	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT 
			print 'localvar_init'
		#endif

//		eval( $i:w45a_天狗兵刀ガード回数 = 20 )
		eval( $i:w45a_天狗兵刀ガード回数 = 10 )
		eval ($f:w45a_偽ゲームオーバーフラグ = d:FALSE)

		//	デモ後特殊装備外す
		@デモ後武器アイテム制御 d:デモ後前を継続 d:デモ後特殊装備なし

		//	武器をソーコムかＭ９に変える
		if($f:w45a_天狗兵登場フラグ == d:TRUE ) {
			//	Ｍ９だったら
			if ($w:武器 == d:武器:Ｍ９) {
				eval ($w:武器 = d:武器:Ｍ９)
				eval ( $w:プレイヤーフラグ = $w:プレイヤーフラグ & ~d:PL_START_STATE_BLADE_OUT )
			//	Ｍ９以外だったら
			} else {
				//	武器をソーコムに変える
				if ($w:武器 != d:武器:ソコム) {
					eval ($w:武器 = d:武器:ソコム)
					eval ( $w:プレイヤーフラグ = $w:プレイヤーフラグ & ~d:PL_START_STATE_BLADE_OUT )
				}
			}
		}

	}

	proc 設定値変更 {
		#if d:DEBUG_PRINT 
			print 'status_set'
		#endif

	//	刀ダメージ値	体のどの部位に当たっても１５００減る
	//	刀の一降りで理論上最高３回当たるので（間合いがシビア）、計１５００＊３＝４５００となる

	//	刀気絶値		体のどの部位に当たっても６減る

		if ($w:ゲーム設定 == d:LEVEL_VERYEASY) {

			eval ($i:w45a_スネークレベル = 7)
			eval ($i:w45a_スネークソコム数 = -1)
			eval ($i:w45a_スネークＭ４数 = -1)
			eval ($i:w45a_スネークレーション数 = -1)
			eval ($i:w45a_スネークライフ = 600)

			eval ($i:w45a_天狗兵復活人数 = 42)
			eval ($w:w45a_天狗兵体力 = 1500)		//	最低１振りで死ぬ
			eval ($w:w45a_天狗兵気絶 = 3)			//	１振りで気絶

		} else if ($w:ゲーム設定 == d:LEVEL_EASY) {

			eval ($i:w45a_スネークレベル = 5)
			eval ($i:w45a_スネークソコム数 = 10)
			eval ($i:w45a_スネークＭ４数 = 10)
			eval ($i:w45a_スネークレーション数 = -1)
			eval ($i:w45a_スネークライフ = 600)

			eval ($i:w45a_天狗兵復活人数 = 42)
			eval ($w:w45a_天狗兵体力 = 1500)		//	最低１振りで死ぬ
			eval ($w:w45a_天狗兵気絶 = 7)			//	２振りで気絶

		} else if ($w:ゲーム設定 == d:LEVEL_NORMAL) {

			eval ($i:w45a_スネークレベル = 3)
			eval ($i:w45a_スネークソコム数 = 5)
			eval ($i:w45a_スネークＭ４数 = 5)
			eval ($i:w45a_スネークレーション数 = 5)
			eval ($i:w45a_スネークライフ = 600)

			eval ($i:w45a_天狗兵復活人数 = 58)
			eval ($w:w45a_天狗兵体力 = 3000)		//	最低２振り（最高１振り）で死ぬ
			eval ($w:w45a_天狗兵気絶 = 9)			//	２振りで気絶

		} else if ($w:ゲーム設定 == d:LEVEL_HARD) {

			eval ($i:w45a_スネークレベル = 3)
			eval ($i:w45a_スネークソコム数 = 3)
			eval ($i:w45a_スネークＭ４数 = 3)
			eval ($i:w45a_スネークレーション数 = 3)
			eval ($i:w45a_スネークライフ = 500)

			eval ($i:w45a_天狗兵復活人数 = 90)
			eval ($w:w45a_天狗兵体力 = 3000)		//	最低２振り（最高１振り）で死ぬ
			eval ($w:w45a_天狗兵気絶 = 13)			//	３振りで気絶

		} else if ($w:ゲーム設定 >= d:LEVEL_EXTREME) {

			eval ($i:w45a_スネークレベル = 3)
			eval ($i:w45a_スネークソコム数 = 0)
			eval ($i:w45a_スネークＭ４数 = 0)
			//	エクストリームの場合
			if ($w:ゲーム設定 == d:LEVEL_EXTREME) {
				//	ステージ開始時のレーション数に依存(最大２個まで)
				if ($f:w45a_天狗兵登場フラグ == d:FALSE) {
					if ($w:アイテム数Ｒ[ d:アイテム:レーション ] >= 2) {
						eval ($i:w45a_スネークレーション数 = 0)
					} else if ($w:アイテム数Ｒ[ d:アイテム:レーション ] == 1) {
						eval ($i:w45a_スネークレーション数 = 1)
					} else if ($w:アイテム数Ｒ[ d:アイテム:レーション ] == 0) {
						eval ($i:w45a_スネークレーション数 = 2)
					}
				}
			//	ヨーロピアンエクストリームの場合
			} else {
				//	レーションは出さない
				eval ($i:w45a_スネークレーション数 = 0)
			}
			eval ($i:w45a_スネークライフ = 500)

			eval ($i:w45a_天狗兵復活人数 = 122)
			eval ($w:w45a_天狗兵体力 = 4500)		//	最低３振り（最高１振り）で死ぬ
			eval ($w:w45a_天狗兵気絶 = 17)			//	３振りで気絶

		}
	}

	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif

		command プラグインはしご
		command プラグインブレード -m rai_blade
	}


//###################################################################################
//									 プレイヤー
//###################################################################################

	proc プレイヤー設定 {
		#if d:DEBUG_PRINT
			print 'player_set'
		#endif
//		-res	(-11500) (9000) (-152000) \
//			 	(11600) (9000) (-146500) 
/*
eval( $i:プレイヤー初期Ｘ位置 = 11600 );
eval( $i:プレイヤー初期Ｙ位置 = 9000 );
eval( $i:プレイヤー初期Ｚ位置 = -146500 );
eval( $i:プレイヤー初期Ｘ位置 = -11500 );
eval( $i:プレイヤー初期Ｙ位置 = 9000 );
eval( $i:プレイヤー初期Ｚ位置 = -152000 );
*/

		#if d:RAIDEN
			chara プレイヤー d:PLAYER \
				-p $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,$i:プレイヤー初期Ｚ位置 \
				-d 0,$i:プレイヤー初期方向,0 \
				-s 0 \
				-m rai_def \
				-a raiden \
				-o rai_w45a \
				-f 0

				//髪の毛
				@ライデン髪の毛設定 d:NORMAL_HAIR

				//	ＬＯＤ機能
				@プレイヤーＬＯＤ設定 d:C_DISTANCE_TYPE 4000


		#else if d:SNAKE
			chara プレイヤー d:PLAYER \
				-p $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,$i:プレイヤー初期Ｚ位置 \
				-d 0,$i:プレイヤー初期方向,0 \
				-s 0 \
				-m sna_def -a snake -o rai_w32a

				//バンダナ
				chara ロープモデル３ バンダナ１ \
					-n sna_bdn1 \
					-d 1 \
					-y スネーク \
					-z 12 \
					-x 0,60,-90 \
					-m 12 \
					-p 250 \
					-k 350 \
					-o 110 \
					-f 1

				chara ロープモデル３ バンダナ２ \
					-n sna_bdn2 \
					-d 1 \
					-y スネーク \
					-z 12 \
					-x 0,50,-90 \
					-m 22 \
					-p 250 \
					-k 350 \
					-o 110 \
					-f 1
		#endif
	}

//###################################################################################
//								敵兵
//###################################################################################

	proc 危険スタート{
		if($f:w45a_天狗兵登場フラグ == d:TRUE ) {
				mesg 天狗兵コマンダー tng_com 危険開始
		}
	}

	// 敵兵設定
	proc 天狗兵０ {
#if d:DEBUG_PRINT
	print '*** Tengu 0'
#endif

	// 天狗兵Ｂ
		chara 天狗兵Ｂ 敵兵:01 \
			-r 8  \
			-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
