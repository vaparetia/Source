command ローカルリソース設定 \
	-string オプションの説明日本語 		[オプションの説明日本語:*] \
			オプションの説明英語 		[オプションの説明英語:*] \
			オプションの説明フランス語 	[オプションの説明フランス語:*] \
			オプションの説明ドイツ語	[オプションの説明ドイツ語:*] \
			オプションの説明スペイン語 	[オプションの説明スペイン語:*] \
			オプションの説明イタリア語 	[オプションの説明イタリア語:*] \
			レーダーの説明日本語	[レーダーの説明日本語:*] \
			レーダーの説明英語		[レーダーの説明英語:*] \
			レーダーの説明フランス語[レーダーの説明フランス語:*] \
			レーダーの説明ドイツ語	[レーダーの説明ドイツ語:*] \
			レーダーの説明スペイン語[レーダーの説明スペイン語:*] \
			レーダーの説明イタリア語[レーダーの説明イタリア語:*] \
			クイックチェンジの説明日本語	[クイックチェンジの説明日本語:*] \
			クイックチェンジの説明英語		[クイックチェンジの説明英語:*] \
			クイックチェンジの説明フランス語[クイックチェンジの説明フランス語:*] \
			クイックチェンジの説明ドイツ語	[クイックチェンジの説明ドイツ語:*] \
			クイックチェンジの説明スペイン語[クイックチェンジの説明スペイン語:*] \
			クイックチェンジの説明イタリア語[クイックチェンジの説明イタリア語:*] 
/******************************************************************/
/******************************************************************/



proc サウンド設定 {
	chara サウンドマネージャー ＳＤマネ -pak 0
}

if( $b:タイトルステップ == 0 ){
		chara 2Dレイアウトドライバ ２Ｄドライバ
		@タイトル画面表示
	} else if( $b:タイトルステップ == 2 ){
		// タイトル
		chara 2Dレイアウトドライバ ２Ｄドライバ

		print 'タイトル画面表示'
		@タイトル画面表示;
	}

	@サウンド設定

	#ifdef JAPANESE
		command 字幕制御 -y 348
	#else
		command 字幕制御 -y 400
	#endif

/***************************************************************************************************/
// タイトル画面表示
/***************************************************************************************************/
	proc タイトル画面表示 {
		if ( !($w:タイトルメニュー設定 & d:TITLE_MENU_DISPED_WARNING_VIOLENCE ) ){
			print 'デモループ一回終了'
			eval( $w:タイトルメニュー設定 = $w:タイトルメニュー設定 | d:TITLE_MENU_DISPED_WARNING_VIOLENCE )
		}
		chara ノード画面バックグラウンド バックグラウンド
		@タイトル画面起動
		print 'ソングスタート'
		mesg サウンドマネージャー ＳＤマネ SD_CODE d:SNG_PLAY_01
	}

	proc タイトル画面起動 {
		chara タイトル画面マネージャー タイトル画面 \
			-d title_logo title_face \
			-p タイトル画面終了 \
			-b バックグラウンド \
			-f $w:顔フラグ
	}

	proc タイトル画面終了 $:返り値 {
		if( $:返り値 == 0 ){
			print 'セレクト' 
			@game_select
		} else {
			command セットサウンドコード -c d:SNG_FOUTS_S
			@mgs2_title
		}
	}

	// MGS2 TITLE
	proc mgs2_title {
		mesg ノード画面バックグラウンド バックグラウンド kill

		eval ($w:顔フラグ = $w:顔フラグ ^ 1);

		eval( $b:タイトルステップ = 0 );
		restart
	}


/***************************************************************************************************/
// オプション
/***************************************************************************************************/

	proc sel_option {
		chara オプション画面マネージャー オプション画面 \
			-d node_menu \
			-p オプション終了プロシージャー \
			-b バックグラウンド \
			-n 	2 \
			-l 	7 1 \ 
			-r 	オプションの説明英語 		レーダーの説明英語 			クイックチェンジの説明英語 		 \
				オプションの説明フランス語 	レーダーの説明フランス語	クイックチェンジの説明フランス語 \
				オプションの説明ドイツ語 	レーダーの説明ドイツ語 		クイックチェンジの説明ドイツ語 	 \
				オプションの説明スペイン語 	レーダーの説明スペイン語 	クイックチェンジの説明スペイン語 \
				オプションの説明イタリア語 	レーダーの説明イタリア語 	クイックチェンジの説明イタリア語 \
				0 0 0 \ //韓国語
				オプションの説明日本語 		レーダーの説明日本語 		クイックチェンジの説明日本語 	 		
	}

	proc オプション終了プロシージャー {
		// オプションの終了
		mesg ゲームセレクト画面マネージャー ゲームセレクト画面 ret_by_cancel

#ifdef d:EU
		command 字幕言語設定
#endif

	}

/***************************************************************************************************/
// ゲームセレクト
/***************************************************************************************************/
	proc game_select {
		chara ノード画面フレームアニメーション ノードフレーム \
			-d node_frame \
			-b バックグラウンド

		chara ゲームセレクト画面マネージャー ゲームセレクト画面 \
			-d title_menu \
			-p ゲームセレクト画面プロシージャー \
			-b バックグラウンド
	}

	proc ゲームセレクト画面プロシージャー $:モード \
												$:引数１ \ // 1ST_PLAY TANKER PLANT T&P
												$:引数２ \ // 難易度
												$:引数３ \ // 見つかりモード
												$:引数４ \ // アンケート結果
												$:引数５ \
	{
		if( $:モード == -1 ){
			// 終了
			mesg ノード画面フレームアニメーション ノードフレーム kill

			@タイトル画面起動
		} else if( $:モード == 0 ){
			// ゲームセレクト
#if 0
			if( $:引数１ == 1 ){
				// ロードゲームの起動
				//@load_game
			} else 
#endif
			if( $:引数１ == 1 ){
				// オプションの起動
				print 'selselselselselselsel'
				@sel_option
			} 
#if 0
			else if( $:引数１ == 3 ){
				// スペシャルモードの起動
				eval($b:スペシャルモードのスタートカーソル位置 = 0);
				//@special_scr
			} else if( $:引数１ == 4 ){
				// ハードディスクインストーラーの起動
			}
#endif
		} else if( $:モード == 1 ){
#if 0
			// ニューゲーム

			// このプレイでタンカーをクリアしたこと表すフラグを消去
			eval( $w:コンフィグ設定 = $w:コンフィグ設定 & ~d:CONFIG_TANKER_CLEARED );

			// ゲームモードの設定
			if( $:引数１ == 0 ){
				print '１ＳＴプレイ'

				if( $:引数４ <= 2 ) {
					print '１ＳＴプレイ タンカープラント'
					eval( $s:global_ゲームモード = タンカープラント )
				} else {
					print '１ＳＴプレイ プラント編'
					eval( $s:global_ゲームモード = プラント編 )
				}
			} else if( $:引数１ == 1 ){
				print 'タンカー編'
				eval( $s:global_ゲームモード = タンカー編 )
			} else if( $:引数１ == 2 ){
				print 'プラント編'
				eval( $s:global_ゲームモード = プラント編 )
			} else if( $:引数１ == 3 ){
				print 'タンカープラント'
				eval( $s:global_ゲームモード = タンカープラント )
			}

			// ゲーム難易度の設定
			eval( $b:n_title_ゲーム難易度 = ( $:引数２ + 1 ) * 10 )

			// 見つかりモード
			if( $:引数３ == 0 ){
				eval( $f:title_discover = d:TRUE )
			} else {
				eval( $f:title_discover = d:FALSE )
			}

			if( $5 < 0 ) {
				command セットサウンドコード -c d:SNG_FOUTS_S
				@１周目フィクション表記
			} else {
				command セットサウンドコード -c d:SNG_FOUTS_S
				chara delay アクションレベル決定ディレイ -time 60 -exec {
					command Stream t:vc126102 -p １周目フィクション表記 //-w
				}
			}
#else
			command セットサウンドコード -c d:SNG_FOUTS_S
			@load_select	//VR TRIAL select
#endif
		} else if( $:モード == 2 ){
			// ロードゲーム
		} else if( $:モード == 3 ){
			// オプション
		} else if( $:モード == 4 ){
			// スペシャル
		} else if( $:モード == 5 ){
			// ハードディスクインストール
		}
	}	


/***************************************************************************************************/
// ゲームスタート
/***************************************************************************************************/

proc resident_clear {
	/* 常駐ディレクトリ情報クリア（2001．9.4 園山追加） */
	dim $i:常駐ディレクトリ[ 4 ]
	eval ( $i:常駐ディレクトリ[ 0 ] = 0 )
	eval ( $i:常駐ディレクトリ[ 1 ] = 0 )
	eval ( $i:常駐ディレクトリ[ 2 ] = 0 )
	eval ( $i:常駐ディレクトリ[ 3 ] = 0 )
	command varsave $i:常駐ディレクトリ[ 0 ]
	command varsave $i:常駐ディレクトリ[ 1 ]
	command varsave $i:常駐ディレクトリ[ 2 ]
	command varsave $i:常駐ディレクトリ[ 3 ]
}
