				-camera \
				-exec {
					chara カメラ設定 モーションカメラ \
						-c 0 \
						-b -6058,-13394,-41324  6058,-13394,-41324 \
						-l -6058,-15173,-48425  6058,-15173,-48425 \
						-r 160,2048,0 -f 7320 \
