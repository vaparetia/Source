/***************************************************************************************************/
// マップ起動
/***************************************************************************************************/
	chara マップ 電算室 \
//					-k w24d0 \
//					-k w24d1 \
					-k w24d1_a \
//					-k w24d1_b \
					-k w24d2 \
					-k w24d2_tes_sita_v01 \		// 南側床だけ
					-h d:HZX_NAME,0 \
					-l d:LT2_NAME

/***************************************************************************************************/
// マップ設定
/***************************************************************************************************/

	command マップ設定 電算室 -set {
	#if d:SOUND
		@サウンド設定	// データは最初に呼ぶ
	#endif
		@レーダーオンオフチェック $f:w24d_ノードフラグ		// 常駐より前に
		@常駐キャラ設定
		@ローカル変数初期化
		@設定値変更
		@プラグイン設定
		@プレイヤー設定
		@プラント編全体マップ設定 d:シェル１中央棟マップ	// stdproc.hで定義
	#if d:ENEMY
		@コマンダー設定
		@ルートチェンジ
	#endif
	#if d:BGM
		@ＢＧＭ設定	// プレイヤー→敵兵→BGMの順で呼ぶ
	#endif
	#if d:SLIDE_DOOR
		@ドア設置
	#endif
	#if d:ITEM
		@アイテム設置
	#endif
	#if d:FOG
		@フォグ設定
	#endif
	#if d:EFFECT
		@エフェクト設定
	#endif
	#if d:CHARA_CEIL
		@電算室天井設置
	#endif
	#if d:ELEVATOR
		@エレベーター設置 電算室
	#endif
		@アーセナルランプセット
		@ロッカー設置

		@ノード端末設定 2048

		@鳥篭
		@エイムズマイク

		@カメラセット
		@電算室カメラ設定
		@張り付きカメラ設定
		@ダンボール設定

		//壊れ物はキャラ用ライトの後 T.Morita 2001.07.04
		@ヒビガラス
		@壊れ物設置


		@マップ切り替え

	#if d:MY_DEBUG
		@デバッグキャラセット
	#endif

		@エロ中止チェック
		@シナリオデモキャラセット
	#if d:ERO_TALK_CAM
		@エロ話カメラ
		@エロ話兵は何かあったらすぐ帰る
	#endif
		@毎フレーム処理			// できるだけ最後に呼び出す

	}

/***************************************************************************************************/
// 無線用include ※位置は動かさないこと
/***************************************************************************************************/
#include "w24d_cdc.ch"
#include "p_force_cdc.ch"

/***************************************************************************************************/
// ステージ開始時処理
/***************************************************************************************************/

	command マップ表示 -show 電算室

	@キャラ用ライト設置					// マップ設定の最後に呼ぶ

	// 全てのセットが終わったところでフェードイン
	if( ($s:登場ポイント == sp_w24b_w24d_0) || ( $s:登場ポイント == sp_w24a_w24d_0 ) ) {

		@ステージ開始時処理（エレベーター） d:wn_シェル１中央棟Ｂ２電算室

	} else {
		#if d:ASSERT
			command assert ( d:FALSE ) 'unexpected load point'
		#endif
	}




// 各proc設定
//-------------------------------------------------------------------------------------
// 全マップ共通
	// サウンド
	// ------------------------------------
	proc サウンド設定 {
		#if d:DEBUG_PRINT
			print 'sound_set'
		#endif

		chara サウンドマネージャー ＳＤマネ -pak 0
		@サウンド効果音設定

		command 弾痕ノーマル -n 0
		command 弾痕ノーマル -n 1
		command 弾痕ノーマル -n 2
		command 弾痕ノーマル -n 3
		command 弾痕ノーマル -n 4

		command 跳弾ノーマル -n 0
		command 跳弾ノーマル -n 1
		command 跳弾ノーマル -n 2
		command 跳弾ノーマル -n 3
		command 跳弾ノーマル -n 4

		command 弾痕ノーマル -n 5
		command 跳弾ＳＥのみ -n 5

		command 弾痕ノーマル -n 6
		command 弾痕ノーマル -n 7
		command 跳弾水蒸気小 -n 6
		command 跳弾水蒸気中 -n 7

	}

	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT
			print 'localvar_init'
		#endif
		eval( $f:w24d_運動不足解消兵ダッシュスタート = 0 )
		eval( $f:w24d_エロ話始め = 0 )
		eval( $f:w24d_エロ話兵１準備ＯＫ = 0 )
		eval( $f:w24d_エロ話兵２準備ＯＫ = 0 )
		eval( $f:w24d_エロ開始フラグ = 0 )
	}

	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT
			print 'status_set'
		#endif
	}

/***************************************************************************************************/
// ノード処理
/***************************************************************************************************/
	proc ノード接続時プロック {
		#if d:DEBUG_PRINT
			print 'node_set'
		#endif
		eval($f:ノードフラグ = $f:w24d_ノードフラグ);
	}

	proc ノード接続後プロック {
		#if d:DEBUG_PRINT
			print 'node_event_go'
		#endif
		eval($f:w24d_ノードフラグ = 1);
		command メニュー設定 -node_access on
	}

/***************************************************************************************************/
// プラグインプログラム
/***************************************************************************************************/
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif
	}

/***************************************************************************************************/
// プレイヤー
/***************************************************************************************************/

	proc プレイヤー設定 {
		#if d:DEBUG_PRINT
			print 'player_set'
		#endif

		#if d:RAIDEN
			chara プレイヤー d:PLAYER \
				//-p 0, -15000, -56000 \	// 奥田君デバッグ用
				-p $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,$i:プレイヤー初期Ｚ位置 \
				-d 0,$i:プレイヤー初期方向,0 \
				-s 0 \
				-m rai_def -a raiden -o rai_w24d
				//-f d:PLY_NO_FOOT_SHADOW

			// 髪の毛
			@ライデン髪の毛設定 d:NORMAL_HAIR

			@プレイヤーＬＯＤ設定 d:C_DISTANCE_TYPE 6000

		#endif
	}

/***************************************************************************************************/
// 警備兵
/***************************************************************************************************/
#define ENE1_DP_X	10250
#define ENE1_DP_Y	-14000
#define ENE1_DP_Z	-70250

#define ENE2_DP_X	-2750
#define ENE2_DP_Y	-16000
#define ENE2_DP_Z	-52000

#define ENE3_DP_X	1750
#define ENE3_DP_Y	-16000
#define ENE3_DP_Z	-57000

#define ENE4_DP_X	0
#define ENE4_DP_Y	-16000
#define ENE4_DP_Z	-63000

	proc エロ話兵右 $:名前 {
		chara 警備兵 $:名前 \
			//-r 6 \	// エロ話
			-r 12 \		// 通常配置
			-n 0 \
			-d d:ENE1_DP_X d:ENE1_DP_Y d:ENE1_DP_Z 電算室 \
			-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
			-l $w:敵標準体力 -h $w:敵標準聴力 -f $w:敵標準気絶 \
			-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
			-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
			-w エロ話中何かに気づいた \
			-j ドッグタグ_敵兵	[ dogtag:plt_w24d_guard_ve_01 ] \
								[ dogtag:plt_w24d_guard_ea_01 ] \
								[ dogtag:plt_w24d_guard_no_01 ] \
								[ dogtag:plt_w24d_guard_ha_01 ] \
								[ dogtag:plt_w24d_guard_vh_01 ]
	}

	proc エロ話兵左 $:名前 {
		chara 警備兵 $:名前 \
			//-r 7 \	// エロ話
			-r 13 \		// 通常配置
			-n 0 \
			-d d:ENE2_DP_X d:ENE2_DP_Y d:ENE2_DP_Z 電算室 \
			-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
			-l $w:敵標準体力 -h $w:敵標準聴力 -f $w:敵標準気絶 \
			-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
			-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
			-w エロ話中何かに気づいた \
			-j ドッグタグ_敵兵	[ dogtag:plt_w24d_guard_ve_02 ] \
								[ dogtag:plt_w24d_guard_ea_02 ] \
								[ dogtag:plt_w24d_guard_no_02 ] \
								[ dogtag:plt_w24d_guard_ha_02 ] \
								[ dogtag:plt_w24d_guard_vh_02 ]
	}

	proc エロ話中何かに気づいた {
		mesg 警備兵 敵兵:01 ルート変更 12 d:ENE1_DP_X d:ENE1_DP_Y d:ENE1_DP_Z 電算室 0
		mesg 警備兵 敵兵:02 ルート変更 13 d:ENE2_DP_X d:ENE2_DP_Y d:ENE2_DP_Z 電算室 0
	}

	proc エロ画像兵 $:名前 {
		chara 警備兵 $:名前 \
			-r 5 -n 0 \
			-d d:ENE3_DP_X d:ENE3_DP_Y d:ENE3_DP_Z 電算室 \
			-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
			-l $w:敵標準体力 -h $w:敵標準聴力 -f $w:敵標準気絶 \
			-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
			-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
			-j ドッグタグ_敵兵	[ dogtag:plt_w24d_guard_ve_03 ] \
								[ dogtag:plt_w24d_guard_ea_03 ] \
								[ dogtag:plt_w24d_guard_no_03 ] \
								[ dogtag:plt_w24d_guard_ha_03 ] \
								[ dogtag:plt_w24d_guard_vh_03 ]
	}

	proc マラソン兵Ａ $:名前 {
		chara 警備兵 $:名前 \
			-r 14 -n 0 \
			-d d:ENE4_DP_X d:ENE4_DP_Y d:ENE4_DP_Z 電算室 \
			-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
			-l $w:敵標準体力 -h $w:敵標準聴力 -f $w:敵標準気絶 \
			-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
			-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
			-j ドッグタグ_敵兵	[ dogtag:plt_w24d_guard_ve_04 ] \
								[ dogtag:plt_w24d_guard_ea_04 ] \
								[ dogtag:plt_w24d_guard_no_04 ] \
								[ dogtag:plt_w24d_guard_ha_04 ] \
								[ dogtag:plt_w24d_guard_vh_04 ]
	}

	proc マラソン兵Ｂ $:名前 {
		chara 警備兵 $:名前 \
			-r 17 \
			-n 2 \
			-d d:ENE4_DP_X d:ENE4_DP_Y d:ENE4_DP_Z 電算室 \
			-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
			-l $w:敵標準体力 -h $w:敵標準聴力 -f $w:敵標準気絶 \
			-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
			-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
			-j ドッグタグ_敵兵	[ dogtag:plt_w24d_guard_ve_04 ] \
								[ dogtag:plt_w24d_guard_ea_04 ] \
								[ dogtag:plt_w24d_guard_no_04 ] \
								[ dogtag:plt_w24d_guard_ha_04 ] \
								[ dogtag:plt_w24d_guard_vh_04 ]
	}

	proc 警備兵０ {
		#if d:DEBUG_PRINT
			print 'watcher_set'
		#endif
		/*******************************************************************************************/
		// VERYEASY
		/*******************************************************************************************/
		if($w:ゲーム設定 <= d:LEVEL_VERYEASY) {
			@エロ話兵右 敵兵:01
			@エロ話兵左 敵兵:02
			@エロ画像兵 敵兵:03

			// 運動不足解消兵
			#if d:MARATHON_TEST
				eval( $f:w24d_運動不足解消兵見た = 1 )
			#endif
			if( $f:w24d_運動不足解消兵見た == 0 ) {
				@マラソン兵Ａ 敵兵:04
			} else {
				eval( $f:w24d_運動不足解消兵見た = 0 )
				@マラソン兵Ｂ 敵兵:04
			}
		/*******************************************************************************************/
		// EASY
		/*******************************************************************************************/
		} else if($w:ゲーム設定 <= d:LEVEL_EASY) {
			@エロ話兵右 敵兵:01
			@エロ話兵左 敵兵:02
			@エロ画像兵 敵兵:03

			// 運動不足解消兵
			#if d:MARATHON_TEST
				eval( $f:w24d_運動不足解消兵見た = 1 )
			#endif
			if( $f:w24d_運動不足解消兵見た == 0 ) {
				@マラソン兵Ａ 敵兵:04
			} else {
				eval( $f:w24d_運動不足解消兵見た = 0 )
				@マラソン兵Ｂ 敵兵:04
			}
		/*******************************************************************************************/
		// NORMAL
		/*******************************************************************************************/
		} else if($w:ゲーム設定 <= d:LEVEL_NORMAL) {
			@エロ話兵右 敵兵:01
			@エロ話兵左 敵兵:02
			@エロ画像兵 敵兵:03

			// 運動不足解消兵
			#if d:MARATHON_TEST
				eval( $f:w24d_運動不足解消兵見た = 1 )
			#endif
			if( $f:w24d_運動不足解消兵見た == 0 ) {
				@マラソン兵Ａ 敵兵:04
			} else {
				eval( $f:w24d_運動不足解消兵見た = 0 )
				@マラソン兵Ｂ 敵兵:04
			}
		/*******************************************************************************************/
		// HARD
		/*******************************************************************************************/
		} else if($w:ゲーム設定 <= d:LEVEL_HARD) {
			@エロ話兵右 敵兵:01
			@エロ話兵左 敵兵:02
			@エロ画像兵 敵兵:03

			// 運動不足解消兵
			#if d:MARATHON_TEST
				eval( $f:w24d_運動不足解消兵見た = 1 )
			#endif
			if( $f:w24d_運動不足解消兵見た == 0 ) {
				@マラソン兵Ａ 敵兵:04
			} else {
				eval( $f:w24d_運動不足解消兵見た = 0 )
				@マラソン兵Ｂ 敵兵:04
			}
		/*******************************************************************************************/
		// EXTREME or EUROPEAN_EXTREME
		/*******************************************************************************************/
		} else {
			@エロ話兵右 敵兵:01
			@エロ話兵左 敵兵:02
			@エロ画像兵 敵兵:03

			// 運動不足解消兵
			#if d:MARATHON_TEST
				eval( $f:w24d_運動不足解消兵見た = 1 )
			#endif
			if( $f:w24d_運動不足解消兵見た == 0 ) {
				@マラソン兵Ａ 敵兵:04
			} else {
				eval( $f:w24d_運動不足解消兵見た = 0 )
				@マラソン兵Ｂ 敵兵:04
			}
		}

	}

/***************************************************************************************************/
// 攻撃兵
/***************************************************************************************************/
	proc 攻撃兵シールド {
		chara アタッカー 敵兵:61 \
			-r 18 \
			-c 23 \
			-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
			-l $w:敵標準体力 \
			-h $w:敵標準聴力 \
			-f $w:敵標準気絶 \
			-e d:ENE_EQUIP_TYPE_SHIELD \
			-q レーション_敵兵 30
	}

	proc 攻撃兵ショットガン {
		chara アタッカー 敵兵:62 \
			-r 19 \
			-c 24 \
			-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
			-l $w:敵標準体力 \
			-h $w:敵標準聴力 \
			-f $w:敵標準気絶 \
			-e d:ENE_EQUIP_TYPE_SHOTGUN \
			-q レーション_敵兵 30
	}

	proc 攻撃兵ノーマル {
		chara アタッカー 敵兵:63 \
			-r 20 \
			-c 25 \
			-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
			-l $w:敵標準体力 \
			-h $w:敵標準聴力 \
			-f $w:敵標準気絶 \
			-e 0 \
			-q レーション_敵兵 30
	}

	proc 攻撃兵０ {
		#if d:DEBUG_PRINT
			print 'attacker_set'
		#endif
		@攻撃兵シールド
		@攻撃兵ショットガン
		@攻撃兵ノーマル
	}


	proc 警備兵コマンダー {
		#if d:DEBUG_PRINT
			print 'wccomm_set'
		#endif

		if( $w:p_story < ( d:ST:P041_02_R01エイムズ死亡後２無線デモ１終了 ) ) {
		// 人質イベント前
			chara 警備コマンダー wccomm -e 警備兵０
		} else {
		// イベント後
			chara 警備コマンダー wccomm -e 警備兵０
		}
	}

	proc 攻撃兵コマンダー {
		#if d:DEBUG_PRINT
			print 'atcomm_set'
		#endif

		chara 攻撃コマンダー atcomm -avoidwait 300 -e 攻撃兵０
	}



	resource ghq_area_alert_voice {
	w24d:
		$t{
			t:vc040250,	// 了解。増援部隊、シェル１中央棟Ｂ２へ急行せよ！エレベータ前を守れ！
			t:vc040251,	// 了解。応援部隊、シェル１中央棟Ｂ２・エレベータ前へ向かえ！侵入者を逃がすな！
			-2,
			t:vc040252,	// 了解。増援部隊、シェル１中央棟Ｂ２に急行！電算室を守れ！
			t:vc040253,	// 了解。応援部隊をシェル１中央棟Ｂ２・電算室に派遣する！奴を逃がすな！
			-2,
			t:vc040254,	// 了解。増援部隊、シェル１中央棟Ｂ２へ向かえ！中央扉を守れ！
			t:vc040255,	// 了解。バックアップをシェル１中央棟Ｂ２・中央扉にまわす！奴を仕留めろ！
			t:vc040256,	// 了解。増援部隊、シェル１中央棟Ｂ２へ向かえ！敵を逃がすな！
			t:vc040257,	// 了解。応援部隊をシェル１中央棟Ｂ２に派遣する！侵入者を止めろ！
			-1
		}
	}

	resource ghq_caution_voice {
	w24d:
		$t{
			t:vc040405, // 了解。シェル１中央棟Ｂ２・エレベータ前を増員。警備を強化しろ
			t:vc040406, // 了解。シェル１中央棟Ｂ２に増員を派遣する。エレベータ前の警戒を強化しろ
			t:vc040407, // 了解。シェル１中央棟Ｂ２・電算室を増員。警備を強化しろ
			t:vc040408, // 了解。シェル１中央棟Ｂ２を増員する。電算室の警戒を強化しろ
			t:vc040409, // 了解。シェル１中央棟Ｂ２・中央扉付近を増員。警備を強化しろ
			t:vc040410, // 了解。シェル１中央棟Ｂ２に増員を送る。中央扉付近の警戒を強化しろ
			t:vc040411, // 了解。シェル１中央棟Ｂ２を増員する。警戒を強化しろ
			-2,
			// 連絡が途絶えた時の音声
			t:vc040434, // シェル１中央棟Ｂ２との連絡が途絶えた
			-1	// 全ての登録終了
		}
	}

	proc コマンダー設定 {
		#if d:DEBUG_PRINT
			print 'commander_set'
		#endif

		chara コマンダー 敵兵セット \
			-w 警備兵コマンダー \
			-a 攻撃兵コマンダー \
			-m $w:スタートアラートモード \
			-r 0,-12000,-71000 電算室  0,-16000,-46000 電算室 \
			-c 0,-12000,-71000 電算室  0,-16000,-46000 電算室 \
			-v [ene_plant_voice:01] \
			-z $i:敵標準麻酔持続 \
			-b $w:敵標準再発生数 \
			-h $i:標準警戒時間 \
			-o $i:敵標準気絶持続 \
			-e 6 0 エロ話兵１準備ＯＫ \
			   7 0 エロ話兵２準備ＯＫ \
			   5 3 コンピューターいじりＡ_1 \
			   5 5 コンピューターいじりＡ_2 \
			   5 10 コンピューターいじりＢ_1 \
			   5 12 コンピューターいじりＢ_2 \
			#if d:MARATHON_CAM
			   15 0 マラソン兵定位置につく \
			   16 0 マラソン兵スタート \
			#endif
			-x [ghq_area_alert_voice:w24d] \
			-y [ghq_caution_voice:w24d] \
			-v [ene_tank_voice:01]
	}

#if d:MARATHON_CAM

	#define TIME_MARATHON_POSITION		180
	/////////////////
	// マラソン兵 定位置
	proc マラソン兵定位置につく {
		print 'マラソン兵定位置につきました'
		if( `@シナリオデモ用安全チェック` && \
						!$f:w24d_マラソン兵定位置フラグ && \
						`command 無線状態` == 0 ) {
			eval( $f:w24d_マラソン兵定位置フラグ = 1 )
			#if d:VAR_SAVE
				command varsave $f:w24d_マラソン兵定位置フラグ
			#endif

			chara カメラ設定 シナリオカメラ \
				-c 1 \
				-p -20,-12331,-47863 -t -20,-14360,-54036 \
				-r 207,2048,0 -f 6498 \
				-a 200 \
				-i 0 0 0 0 \
				-s 1

			chara カメラ設定 シナリオカメラ \
				-c 1 \
				-p -226,-14050,-58570 -t -226,-14969,-64337 \
				-r 103,2048,0 -f 5840 \
				-a 330 \
				-i 0 0 0 0 \
				-z d:CAMERA_INTERP_CAMERA \
				-interp_time ( d:TIME_MARATHON_POSITION -120 ) \
				-s 1

			@シナリオデモ開始処理
			mesg コマンダー 敵兵セット 視界オン
			@マラソン兵位置についた安全確認監視

			chara delay マラソン兵位置についたカメラ終了 -time d:TIME_MARATHON_POSITION -exec {
				@マラソン兵位置についたキャンセル
			}

			chara デモキャンセルチェック Ch_マラソン兵位置についたキャンセルチェック \
				-p シナリオデモキャンセル
		}
	}

	proc マラソン兵位置についた安全確認監視 {
		chara プロック連続実行 マラソン兵位置についた安全確認連続実行 -time d:TIME_MARATHON_POSITION -exec {
			if( `@安全確認監視` ) {
				print 'やばい！作戦は中止だ'
				mesg プロック連続実行 マラソン兵位置についた安全確認連続実行 kill
				@マラソン兵位置についたキャンセル
			}
		}
	}

	proc マラソン兵位置についたキャンセル {
		mesg デモキャンセルチェック Ch_マラソン兵位置についたキャンセルチェック kill
		@シナリオデモキャンセル
	}


	////////////////////
	// マラソン兵スタート
	#define TIME_MARATHON_START		120

	proc マラソン兵スタート {
		print'マラソン兵スタートしました'
		if( `@シナリオデモ用安全チェック` && !$f:w24d_マラソン兵スタートフラグ) {
			#if d:VAR_SAVE
				command varsave $f:w24d_マラソン兵スタートフラグ
			#endif

			chara カメラ設定 シナリオカメラ \
				-c 1 \
				-p -823,-13742,-57020 -t 433,-14098,-60080 \
				-r 70,1794,0 -f 3327 \
				-a 352 \
				-i 0 0 0 0 \
				-s 1

			@シナリオデモ開始処理
			mesg コマンダー 敵兵セット 視界オン
			@マラソン兵スタート安全確認監視

			chara delay マラソン兵スタートカメラ終了 -time d:TIME_MARATHON_START -exec {
				@マラソン兵スタートキャンセル
			}

			chara デモキャンセルチェック Ch_マラソン兵スタートキャンセルチェック \
				-p シナリオデモキャンセル
		}
	}

	proc マラソン兵スタート安全確認監視 {
		chara プロック連続実行 マラソン兵スタート安全確認連続実行 -time d:TIME_MARATHON_START -exec {
			if( `@安全確認監視` ) {
				print 'やばい！作戦は中止だ'
				mesg プロック連続実行 マラソン兵スタート安全確認連続実行 kill
				@マラソン兵スタートキャンセル
			}
		}
	}

	proc マラソン兵スタートキャンセル {
		mesg デモキャンセルチェック Ch_マラソン兵スタートキャンセルチェック kill
		@シナリオデモキャンセル
	}

#endif

	/////////////////
	// エロ話関係
	proc エロ話兵１準備ＯＫ {
		print 'エロ話兵１準備ＯＫ'
		eval( $f:w24d_エロ話兵１準備ＯＫ = 1 )
	}

	proc エロ話兵２準備ＯＫ {
		print 'エロ話兵２準備ＯＫ'
		eval( $f:w24d_エロ話兵２準備ＯＫ = 1 )
	}


	chara プロック連続実行 エロ話ＯＫチェック -time -1 -exec {
		if( $f:w24d_エロ開始フラグ == 0 && $f:w24d_エロ話兵１準備ＯＫ == 1 && $f:w24d_エロ話兵２準備ＯＫ == 1 ) {
			print 'エロ話開始'
			eval( $f:w24d_エロ開始フラグ = 1 )
			eval( $f:w24d_エロ話兵２準備ＯＫ = 0 )
			eval( $f:w24d_エロ話兵２準備ＯＫ = 0 )

			mesg 警備兵 敵兵:01 アクション終了
			mesg 警備兵 敵兵:02 アクション終了

			mesg 警備兵 敵兵:01 ルート変更 26 d:ENE1_DP_X d:ENE1_DP_Y d:ENE1_DP_Z 電算室 1
			mesg 警備兵 敵兵:02 ルート変更 27 d:ENE2_DP_X d:ENE2_DP_Y d:ENE2_DP_Z 電算室 1

		}
	}

	proc エロ中止チェック {
		trap parrot d:PLAYER \
			-mask ＊ \
			-exec {
				command ゲット敵兵アクション 敵兵:01 $i:ローカル変数Ｉ１ $i:ポイント番号 $i:アクション番号
				command ゲット敵兵アクション 敵兵:02 $i:ローカル変数Ｉ２ $i:ポイント番号 $i:アクション番号
				if( ($i:ローカル変数Ｉ１ != 12) || ($i:ローカル変数Ｉ２ != 13) ) {
					print '急いでもどりなさい！'
					mesg 警備兵 敵兵:01 ルート変更 12 d:ENE1_DP_X d:ENE1_DP_Y d:ENE1_DP_Z 電算室 1
					mesg 警備兵 敵兵:02 ルート変更 13 d:ENE2_DP_X d:ENE2_DP_Y d:ENE2_DP_Z 電算室 1
				}
			}
	}

#if d:ERO_TALK_CAM

	#define TIME_ERO_TALK 				180

	proc エロ話カメラ {
		trap en001_ca d:PLAYER \
			-mask 入る \
			-exec {
				print 'エロ話カメラ発動チェック'
				if( `@シナリオデモ用安全チェック` && `@エロ話兵ポジションチェック` && !$f:w24d_エロ話カメラフラグ) {
					eval( $f:w24d_エロ話カメラフラグ = 1 )
					#if d:VAR_SAVE
						command varsave $f:w24d_エロ話カメラフラグ
					#endif

					chara カメラ設定 シナリオカメラ \
						-c 1 \
						-p 3211,-13505,-64715 -t -3273,-14356,-62110 \
						-r 79,3321,0 -f 7039 \
						-a 200 \
						-i 0 0 0 0 \
						-s 1

					chara カメラ設定 シナリオカメラ \
						-c 1 \
						-p 77,-14107,-61360 -t -4375,-14957,-55986 \
						-r 79,3645,0 -f 7030 \
						-a 200 \
						-i 0 0 0 0 \
						-z d:CAMERA_INTERP_CAMERA \
						-interp_time ( d:TIME_ERO_TALK - 120 ) \
						-s 1


					@シナリオデモ開始処理
					mesg コマンダー 敵兵セット 視界オン
					@エロ話安全確認監視

					chara デモキャンセルチェック Ch_エロ話カメラキャンセルチェック \
						-p シナリオデモキャンセル

					chara delay エロ話カメラ終了 -time d:TIME_ERO_TALK -exec {
						@エロ話カメラキャンセル
					}
				}
		}
	}

	proc エロ話兵ポジションチェック {
		command ゲット敵兵アクション 敵兵:01 $i:ローカル変数Ｉ１ $i:ポイント番号 $i:アクション番号
		command ゲット敵兵アクション 敵兵:02 $i:ローカル変数Ｉ２ $i:ポイント番号 $i:アクション番号
		// 正しいルートにいるか
		if( ($i:ローカル変数Ｉ１ == 26) && ($i:ローカル変数Ｉ２ == 27) ) {
			command ゲット敵兵思考ステータス 敵兵:01 $i:ローカル変数Ｉ１
			command ゲット敵兵思考ステータス 敵兵:01 $i:ローカル変数Ｉ２
			// ルートアクションを行っているか
			if( ($i:ローカル変数Ｉ１ & d:THK_STATUS_ROOT_ACTION) && ($i:ローカル変数Ｉ２ & d:THK_STATUS_ROOT_ACTION) ) {
				print '二人とも正しいポジションにいます'
				return 1;
			}
		}
		print '!!!!!!!!!!!!!!!!!!!!!!!!!!このポジションは駄目!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!'
		return 0;
	}

	proc エロ話安全確認監視 {
		chara プロック連続実行 エロ話安全確認連続実行 -time d:TIME_ERO_TALK -exec {
			if( `@安全確認監視` ) {
				print 'やばい！作戦は中止だ'
				mesg プロック連続実行 エロ話安全確認連続実行 kill
				@エロ話カメラキャンセル
			}
		}
	}

	proc 安全確認監視 {
		command ゲットゲームステータス $i:ゲームステータス
		if( ( $i:ゲームステータス & d:STATE_DETECT ) \
							|| ( $w:アラートモード == d:ALERT_MODE_KIKEN ) \
							|| ( $w:アラートモード == d:ALERT_MODE_KAIHI ) \
							|| ( $i:ゲームステータス & d:STATE_CHAFF ) ) {
			return 1;
		} else {
			return 0;
		}
	}

	proc エロ話カメラキャンセル {
		mesg デモキャンセルチェック Ch_エロ話カメラキャンセルチェック kill
		@シナリオデモキャンセル
	}

	proc シナリオデモキャンセル {
		@シナリオデモ終了処理
		@カメラＯＦＦ シナリオカメラ
	}

	proc エロ話兵は何かあったらすぐ帰る {
		chara プロック連続実行 エロ話兵異常あったら帰る連続実行 -time -1 -exec {
			command ゲット敵兵思考ステータス 敵兵:01 $i:ローカル変数Ｉ１
			command ゲット敵兵思考ステータス 敵兵:02 $i:ローカル変数Ｉ２
			if( !($i:ローカル変数Ｉ１ & (d:THK_STATUS_ROOT_MOVE | d:THK_STATUS_ROOT_TRACE | d:THK_STATUS_ROOT_ACTION)) || \
				!($i:ローカル変数Ｉ２ & (d:THK_STATUS_ROOT_MOVE | d:THK_STATUS_ROOT_TRACE | d:THK_STATUS_ROOT_ACTION)) ) {
					//print '************異常発生***************'
					if( $f:w24d_エロ開始フラグ == 1 ) {
						print '元に戻ってなさい'
						eval( $f:w24d_エロ開始フラグ = 0 )
						mesg 警備兵 敵兵:01 ルート変更 12 d:ENE1_DP_X d:ENE1_DP_Y d:ENE1_DP_Z 電算室 1
						mesg 警備兵 敵兵:02 ルート変更 13 d:ENE2_DP_X d:ENE2_DP_Y d:ENE2_DP_Z 電算室 1
					}
			}
		}
	}
#endif

	//////////////////////////
	// エロコンピューター関係
	proc コンピューターいじりＡ_1 {
		print 'エロ画面 Ａ ＯＮ'
		if( !( $i:ゲームステータス & d:STATE_DETECT ) && ( $w:アラートモード == d:ALERT_MODE_SENNYU ) ) {
			mesg 壊れコンピュータW24D エロコンピュータ画面２ 画面切替え 3
		}
	}
	proc コンピューターいじりＡ_2 {
		print 'エロ画面 Ａ ＯＦＦ'
		mesg 壊れコンピュータW24D エロコンピュータ画面２ 画面切替え 1
	}
	proc コンピューターいじりＢ_1 {
		print 'エロ画面 Ｂ ＯＮ'
		if( !( $i:ゲームステータス & d:STATE_DETECT ) && ( $w:アラートモード == d:ALERT_MODE_SENNYU ) ) {
			mesg 壊れコンピュータW24D エロコンピュータ画面１ 画面切替え 2
		}
	}
	proc コンピューターいじりＢ_2 {
		print 'エロ画面 Ｂ ＯＦＦ'
		mesg 壊れコンピュータW24D エロコンピュータ画面１ 画面切替え 0
	}

/***************************************************************************************************/
// 敵兵ルートチェンジ
/***************************************************************************************************/
	proc ルートチェンジ {
		trap en004 d:PLAYER \
			-mask ？ \
			-exec {
				if( $3 == 入る ) {
					mesg アタッカー 敵兵:61 ルート変更 18
					mesg アタッカー 敵兵:62 ルート変更 19
					mesg アタッカー 敵兵:63 ルート変更 20
					mesg コマンダー 敵兵セット 待機所替え 1
				} else {
					mesg アタッカー 敵兵:61 ルート変更 8
					mesg アタッカー 敵兵:62 ルート変更 9
					mesg アタッカー 敵兵:63 ルート変更 10
					mesg コマンダー 敵兵セット 待機所替え 0
				}
			}

	// 猥談兵
		trap en001 d:PLAYER \
			-mask 出る \
			-exec {
				if( $6 > -48000 ) {
					print '*******************エロやめ*******************'
					eval( $f:w24d_エロ話始め = 1 )
					mesg 警備兵 敵兵:01 ルート変更 12 d:ENE1_DP_X d:ENE1_DP_Y d:ENE1_DP_Z 電算室 0
					mesg 警備兵 敵兵:02 ルート変更 13 d:ENE2_DP_X d:ENE2_DP_Y d:ENE2_DP_Z 電算室 0
				} else {
					print '*******************エロ開始*******************'
					mesg 警備兵 敵兵:01 ルート変更 6 d:ENE1_DP_X d:ENE1_DP_Y d:ENE1_DP_Z 電算室 0
					mesg 警備兵 敵兵:02 ルート変更 7 d:ENE2_DP_X d:ENE2_DP_Y d:ENE2_DP_Z 電算室 0
					eval( $f:w24d_エロ話兵１準備ＯＫ = 0 )
					eval( $f:w24d_エロ話兵２準備ＯＫ = 0 )
					eval( $f:w24d_エロ開始フラグ = 0 )
				}
			}

	// 運動不足解消兵
		if( $f:w24d_運動不足解消兵見た == 0 ) {
			trap en002 d:PLAYER \
				-mask 入る \
				-exec {
					if( $f:w24d_運動不足解消兵ダッシュスタート == 0 ) {
						print '最近運動不足だなー'
						mesg 警備兵 敵兵:04 ルート変更 15 d:ENE4_DP_X d:ENE4_DP_Y d:ENE4_DP_Z 電算室 0
					}
				}

			trap en003 d:PLAYER \
				-mask 出る \
				-exec {
					if( $f:w24d_運動不足解消兵ダッシュスタート == 0 ) {
						print 'よし、ちょっと走るか'
						mesg 警備兵 敵兵:04 ルート変更 16 d:ENE4_DP_X d:ENE4_DP_Y d:ENE4_DP_Z 電算室 0
						eval( $f:w24d_運動不足解消兵ダッシュスタート = 1 )
						eval( $f:w24d_運動不足解消兵見た = 1 )
					}
				}
		}
	}

/***************************************************************************************************/
// ＢＧＭ
