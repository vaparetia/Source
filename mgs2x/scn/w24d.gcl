/***************************************************************************************************/
// ドア＆マップ切り替え関係
/***************************************************************************************************/
	proc ドア設置 {
		#if d:DEBUG_PRINT
			print 'slide_door_set'
		#endif
		@ドアランプ設定 エレベーター前右ドアランプ d:EAST 4125 -12000 -69500 2
		chara ドア エレベーター前右 \
			-m d:DOOR_NAME1 \
			-d 0,1024,0 \
			-p 4125, -12000, -69500 \
			-slide d:SD_SLIDE_INSIDE \
			-time d:SD_OPEN_TIME \
			-lamp エレベーター前右ドアランプ \
			-between 電算室 電算室 \
			-exec {
			}
		trap dr004 ？ \
			-mask ？ \
			-exec {
					if($3==入る){
						mesg ドア エレベーター前右 open
					}else{
						mesg ドア エレベーター前右 close
					}
			}

		@ドアランプ設定 エレベーター前左ドアランプ d:EAST -4125 -12000 -69500 2
		chara ドア エレベーター前左 \
			-m d:DOOR_NAME1 \
			-d 0,d:EAST,0 \
			-p -4125 -12000 -69500 \
			-slide d:SD_SLIDE_INSIDE \
			-time d:SD_OPEN_TIME \
			-lamp エレベーター前左ドアランプ \
			-between 電算室 電算室 \
			-exec {
			}
		trap dr005 ？ \
			-mask ？ \
			-exec {
					if($3==入る){
						mesg ドア エレベーター前左 open
					}else{
						mesg ドア エレベーター前左 close
					}
			}
	}

/***************************************************************************************************/
// フォグ
