/**************************************************************************************************/
//	define
/**************************************************************************************************/
// デバッグ関係
#ifdef d:FIX_MODE
	#define MY_DEBUG	0		// デバッグ
	#define ASSERT		0		// Assert関数使用
#else
	#define MY_DEBUG	0		// デバッグ
	#define ASSERT		0		// Assert関数使用
#endif

#define ERO_TALK_CAM	1		// エロ話カメラ
#define MARATHON_CAM	1		// マラソン兵カメラ
#define VAR_SAVE		0

#define MARATHON_TEST	0		// マラソン兵テスト



// レーダー用
#define STAGE_PLANT		1		// プラントレーダー
// 薬莢
#define ENE_T_GOL		1		// タンカー編ゴル兵
#define ENE_SHOT 		1		// ショットガン兵
#define ENE_SHIELD 		1		// 盾兵

// 各種スイッチ用define
#define NODE			1		// ノード端末

// サウンド
#define SOUND			1		// サウンドデータは最初に呼ぶ
#define STAGE_W24D		1		// サウンド用ディファイン
#define BGM				1		// BGMは敵兵コマンダーの後に呼ぶ

// キャラクター関係
#define RAIDEN			1		// SNAKEとは排他
#define SNAKE			0
#define ENEMY			1		// コマンダーと警備兵(敵を出すときは必須)

// エレベーター
#define ELEVATOR_SET	1
#define ELEVATOR_Y		-12000
#define ELEVATOR_Z		0
#define ELV_B2			1
#define SHELL			0		// エレベーター用 シェル1

// ドア
#define WT_DOOR			0		// 水密ドア
#define SLIDE_DOOR		1		// スライドドア 現在使用していない
// 入出トラップ
#define STAGE_END		1		// ステージ終了時処理を使用可にする
// フォグ
#define FOG				1
// エフェクト関係
#define EFFECT			1		// エフェクト全般
#define BLUR			0		// ブラー
#define Z_MANAGER		0		// Ｚフォーカス管理(敵のライト等で仕様)
#define BODY_SHADOW		0		// 敵のライトによって出る影
#define MIRROR			1		// 鏡面モデル
// 子画面
#define SUB_CAMERA		0
// カメラ関係
#define CLEAR_CAMERA	0		// クリアリング専用カメラ(要子画面)

#define CHARA_CEIL		1		// 天井君

#define ELEVATOR		1		// エレベーター

// 透明壁
#define TR_WALL			0		// シナリオ置きの透明壁
// ライト関係
#define SPOT_LIGHT		0		// スポットライト
// アイテム
#define ITEM			1		// アイテム
// 強制モーション



// 各種設定用define
// ------------------------------------
// マップ関係
#define HZX_NAME			w24d
#define KMS_NAME2			w24d2
#define CEIL_NAME0			w24d0r
#define CEIL_NAME1			w24d1r
#define CEIL_NAME2			w24d2r
#define DOOR_NAME1			dr_free
#define LT2_NAME			w24d

// キャラクター関係
#if d:RAIDEN
	#define PLAYER		ライデン
#else
	#define PLAYER		スネーク
#endif

// ローカル変数


// include
