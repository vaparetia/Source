/***************************************************************************************************/
// 張り付きカメラ設定
/***************************************************************************************************/
	proc 張り付きカメラ設定 {
		// 左
		trap ch001 d:PLAYER \
			-mask ？ \
			-camera \
			-dir 3072 256 \
			//-state d:TRP_STATE_CAUTION \
			-state d:TRP_STATE_BEHINDCAMERA_ENABLE \
			-exec {
				print '張り付いた'
				chara カメラ設定 通路張り付きカメラ \
					-c 0 \
					-b d:CAM_MIN d:CAM_MIN d:CAM_MIN  d:CAM_MAX d:CAM_MAX d:CAM_MAX \
					-l d:CAM_MIN d:CAM_MIN d:CAM_MIN  d:CAM_MAX d:CAM_MAX d:CAM_MAX \
					-r 271,1531,0 -f 2773 \
					-a 200 \
					-i 3 3 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
				/*
				-p -8275,-13461,-48039 -t -6468,-14580,-49819 \
				-r 271,1531,0 -f 2773 \
				-a 200 \
				*/
			}

		// 右
		trap ch002 d:PLAYER \
			-mask ？ \
			-camera \
			-dir 1024 256 \
			//-state d:TRP_STATE_CAUTION \
			-state d:TRP_STATE_BEHINDCAMERA_ENABLE \
			-exec {
				print '張り付いた'
				chara カメラ設定 通路張り付きカメラ \
					-c 0 \
					-b d:CAM_MIN d:CAM_MIN d:CAM_MIN  d:CAM_MAX d:CAM_MAX d:CAM_MAX \
					-l d:CAM_MIN d:CAM_MIN d:CAM_MIN  d:CAM_MAX d:CAM_MAX d:CAM_MAX \
					-r 318,2522,0 -f 2975 \
					-a 200 \
					-i 3 3 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}
		/*
			-p 7996,-12981,-48414 -t 6249,-14376,-50377 \
			-r 318,2522,0 -f 2975 \
			-a 202 \
		*/
	}



	proc 完全補完カメラ $:比較対象 $:距離小 $:距離大 $:ＰＸ１  $:ＰＹ１  $:ＰＺ１  $:ＴＸ１  $:ＴＹ１  $:ＴＺ１ $:ＰＸ２ $:ＰＹ２ $:ＰＺ２ $:ＴＸ２ $:ＴＹ２ $:ＴＺ２ {
		@CS_スムーズカメラ昇順 $:比較対象 $:距離小 $:距離大 $:ＰＸ１ $:ＰＸ２
			eval( $i:補完ＰＸ= $i:CS_結果１ )
		@CS_スムーズカメラ昇順 $:比較対象 $:距離小 $:距離大 $:ＰＹ１ $:ＰＹ２
			eval( $i:補完ＰＹ= $i:CS_結果１ )
		@CS_スムーズカメラ昇順 $:比較対象 $:距離小 $:距離大 $:ＰＺ１ $:ＰＺ２
			eval( $i:補完ＰＺ= $i:CS_結果１ )
		@CS_スムーズカメラ昇順 $:比較対象 $:距離小 $:距離大 $:ＴＸ１ $:ＴＸ２
			eval( $i:補完ＴＸ= $i:CS_結果１ )
		@CS_スムーズカメラ昇順 $:比較対象 $:距離小 $:距離大 $:ＴＹ１ $:ＴＹ２
			eval( $i:補完ＴＹ= $i:CS_結果１ )
		@CS_スムーズカメラ昇順 $:比較対象 $:距離小 $:距離大 $:ＴＺ１ $:ＴＺ２
			eval( $i:補完ＴＺ= $i:CS_結果１ )
	}

/***************************************************************************************************/
// 毎フレーム処理
/***************************************************************************************************/

	proc 毎フレーム処理 {
		chara プロック連続実行 毎フレーム処理 \
			-time -1 \
			-exec {
				eval( $i:前フレーム位置Ｘ = $i:プレイヤー位置Ｘ )
				eval( $i:前フレーム位置Ｚ = $i:プレイヤー位置Ｚ )
			}
	}

/***************************************************************************************************/
// アイテム設置
/***************************************************************************************************/

#define item_レーション		0
#define item_弾薬_Ｍ９		1
#define item_弾薬_ＡＫＳ１	2
#define item_弾薬_ＡＫＳ２	3
#define item_止血剤			4
#define item_弾薬_ソコム	5
#define item_弾薬_Ｍ４		6
#define item_ダンボールＤ	7



	proc アイテム取得時番号設定 $:ボックス名 {
		#if d:DEBUG_PRINT
			print 'item_no_set'
		#endif
		// レーション
		if( $:ボックス名 == レーション ) {
			eval( $b:w24d_取得ロード回数[ d:item_レーション ] = $w:グローバルロード回数 );
		// 弾薬_Ｍ９
		} else if( $:ボックス名 == 弾薬_Ｍ９ ) {
			eval( $b:w24d_取得ロード回数[ d:item_弾薬_Ｍ９ ] = $w:グローバルロード回数 );
		// 弾薬_ＡＫＳ１
		} else if( $:ボックス名 == 弾薬_ＡＫＳ１ ) {
			eval( $b:w24d_取得ロード回数[ d:item_弾薬_ＡＫＳ１ ] = $w:グローバルロード回数 );
		// 弾薬_ＡＫＳ２
		} else if( $:ボックス名 == 弾薬_ＡＫＳ２ ) {
			eval( $b:w24d_取得ロード回数[ d:item_弾薬_ＡＫＳ２ ] = $w:グローバルロード回数 );
		// 止血剤
		} else if( $:ボックス名 == 止血剤 ) {
			eval( $b:w24d_取得ロード回数[ d:item_止血剤 ] = $w:グローバルロード回数 );
		// 弾薬_ソコム
		} else if( $:ボックス名 == 弾薬_ソコム ) {
			eval( $b:w24d_取得ロード回数[ d:item_弾薬_ソコム ] = $w:グローバルロード回数 );
		// 弾薬_Ｍ４
		} else if( $:ボックス名 == 弾薬_Ｍ４ ) {
			eval( $b:w24d_取得ロード回数[ d:item_弾薬_Ｍ４ ] = $w:グローバルロード回数 );
		// ダンボールＤ
		} else if( $:ボックス名 == ダンボールＤ ) {
			eval( $b:w24d_取得ロード回数[ d:item_ダンボールＤ ] = $w:グローバルロード回数 );
		}
	}

	proc アイテム設置 {
//		command アイテム収得可能範囲設定 300 1000 300

		// イベント用エロ本
		@アイテム用エロ本設置

		// マイク
		if( $w:武器弾数Ｒ[ d:武器:マイク ] == -1 ) {
			@マイク_初期設置 マイク -3500 -16000 -57500 d:アイテム水飛沫無
		}

	////////////////////
	// 通常アイテム
		// レーション
		if( `@アイテム再セットチェック $b:w24d_取得ロード回数[ d:item_レーション ]` ) {
			@レーション_初期設置 レーション 7250 -16000 -65500 d:アイテム水飛沫無
		}
		// 弾薬_Ｍ９
		if( `@アイテム再セットチェック $b:w24d_取得ロード回数[ d:item_弾薬_Ｍ９ ]` ) {
			@弾薬_Ｍ９_初期設置 弾薬_Ｍ９ 8625 -16000 -53000 d:アイテム水飛沫無
		}
		// 弾薬_ＡＫＳ１
		if( `@アイテム再セットチェック $b:w24d_取得ロード回数[ d:item_弾薬_ＡＫＳ１ ]` ) {
			//@弾薬_ＡＫＳ_初期設置 弾薬_ＡＫ１ 8625 -16000 -52000 d:アイテム水飛沫無
		}
		// 弾薬_ＡＫＳ２
		if( `@アイテム再セットチェック $b:w24d_取得ロード回数[ d:item_弾薬_ＡＫＳ２ ]` ) {
			@弾薬_ＡＫＳ_初期設置 弾薬_ＡＫ２ 4500 -16000 -55000 d:アイテム水飛沫無
		}
		// 止血剤
		if( `@アイテム再セットチェック $b:w24d_取得ロード回数[ d:item_止血剤 ]` ) {
			@止血剤_初期設置 止血剤 0 -16000 -51250 d:アイテム水飛沫無
		}
		// 弾薬_ソコム
		if( `@アイテム再セットチェック $b:w24d_取得ロード回数[ d:item_弾薬_ソコム ]` ) {
			@弾薬_ソコム_初期設置 弾薬_ソコム -8625 -16000 -50000 d:アイテム水飛沫無
		}
		// 弾薬_Ｍ４
		if( `@アイテム再セットチェック $b:w24d_取得ロード回数[ d:item_止血剤 ]` ) {
			@弾薬_Ｍ４_初期設置 弾薬_Ｍ４ -8625 -16000 -52000 d:アイテム水飛沫無
		}
		// ダンボールＤ
		@ダンボールＤ_初期設置 ダンボールＤ 3750 -16000 -55000 d:アイテム水飛沫無 25

	}


/***************************************************************************************************/
// エロ本設置
/***************************************************************************************************/

	proc アイテム用エロ本設置 {

		chara アイテム 偽エロ本 \
			-b 0 \
			-p -8600,(-13750+100),-48750 \
			-k magazine_ibox \
			-s magazine_sh \
			-l magazine_label \
			-f d:アイテム種別:武器本体 \
			-i d:武器:雑誌 \
			-n 1 \
			-h 300 \
			-r 0 \
			-x {
				mesg ターゲットトラップ エロ本ロッカーキック kill
			}

		mesg アイテム 偽エロ本 影だけオフ

		chara ターゲットトラップ エロ本ロッカーキック \
			-map 電算室 \
			-trap kick \
			-proc エロ本落しキック

	}

#define P_ATTACK_KICK	0

	proc エロ本落しキック {

		if( $1 == d:P_ATTACK_KICK ) {
			print 'エロ本落しキック'
			// エロ本落とす
			@落とされエロ本 ( d:シナリオの高さ - 50 )
			@落とされエロ本 ( d:シナリオの高さ - 100 )
			@落とされエロ本 ( d:シナリオの高さ )
			@落とされエロ本 ( d:シナリオの高さ + 50 )
			@落とされエロ本 ( d:シナリオの高さ + 100 )

			// ロッカー上のエロ本を消す
			mesg アイテム 偽エロ本 kill

			mesg ターゲットトラップ エロ本ロッカーキック kill
		}

	}

	proc 落とされエロ本 $:高さ {
		chara アイテム アイテムボックス \
			-b 2 \
			-p -8250,-13750,-48750 \
			-k magazine_ibox \
			-s magazine_sh \
			-l magazine_label \
			-f d:アイテム種別:武器本体 \
			-i d:武器:雑誌 \
			-n 1 \
			//-h d:シナリオの高さ \
			-h $:高さ \
			-r 0 \
			-m 電算室 \
			-x { }
	}

/***************************************************************************************************/
// ダンボール設定
/***************************************************************************************************/

proc ダンボール設定 {
	chara ダンボール柄トラップ設定  ＺＯＥダンボール \
		-name d:PLAYER \
		-traps d:アイテム:ダンボールＤ,box001

	trap box001 d:PLAYER \
		-mask ？ \
		-exec {
			if($3 == 入る) {
				print 'box001入る'
			} else {
				print 'box001出る'
			}
		}
}


	proc ヒビガラス {
		/*
		chara ガラス弾痕 ガラス弾痕 \
			-flag   0 \
			-thick  10 \ 	// ガラスの厚み(mm)
			-number 15 \		// 窓の個数
			-point  -4500 -13350 -47125		-2350 -14650 -47125 \	// 南
			-point	-2200 -13350 -47125		-1400 -14650 -47125 \
			-point	1400 -13350 -47125		2200 -14650 -47125 \
			-point  2350 -13350 -47125		4500 -14650 -47125 \
			-point  -5875 -13350 -59000		-5875 -14650 -57125 \	// 西
			-point  -5875 -13350 -57125		-5875 -14650 -55250 \
			-point  -5875 -13350 -52900		-5875 -14650 -51025 \
			-point  -5875 -13350 -51025		-5875 -14650 -49150 \
			-point  5875 -13350 -59000		5875 -14650 -57125 \	// 東
			-point  5875 -13350 -57125		5875 -14650 -55250 \
			-point  5875 -13350 -52900		5875 -14650 -51025 \
			-point  5875 -13350 -51025		5875 -14650 -49150 \
			-point  -5250 -13350 -54000		-3200 -14650 -54000 \	// 内側左
			-point  3075 -13350 -55350		3075 -15925 -54125 \	// 内側右１
			-point  3150 -13350 -54050		5250 -14650 -54050 		// 内側右２
		*/
		chara ガラス弾痕 ガラス弾痕 \
			-flag   0 \
			-thick  10 \ 	// ガラスの厚み(mm)
			-number 11 \		// 窓の個数
			/*
			// 何故かこのパラメーターだとバグッチング
			-point  -4500 -13350 -47125		-1400 -14650 -47125 \	// 南
			-point	1400 -13350 -47125		4500 -14650 -47125 \
			*/
			-point  -4500 -13350 -47125		-2350 -14650 -47125 \	// 南
			-point	-2200 -13350 -47125		-1400 -14650 -47125 \
			-point	1400 -13350 -47125		2200 -14650 -47125 \
			-point  2350 -13350 -47125		4500 -14650 -47125 \
			-point  -5875 -13350 -59000		-5875 -14650 -55250 \	// 西
			-point  -5875 -13350 -52900		-5875 -14650 -49150 \
			-point  5875 -13350 -59000		5875 -14650 -55250 \	// 東
			-point  5875 -13350 -52900		5875 -14650 -49150 \
			-point  -5250 -13350 -54000		-3200 -14650 -54000 \	// 内側左
			-point  3075 -13350 -55350		3075 -15925 -54125 \	// 内側右１
			-point  3150 -13350 -54050		5250 -14650 -54050 		// 内側右２
	}

	proc マップ切り替え {
		chara プットオブジェ ポスター -m w24d2_pos -r 0 0 0 -p 0 0 0 -s 100 100 100 -l w24d

		//chara 天井君 北部エリア   -m w24d1_b -a 5 -c 0 0 -56500 -p 0,0,0 -l w24d
		//chara 天井君 小部屋       -m w24d0   -a 5 -c 0 0 -56500 -p 0,0,0 -l w24d
		chara プットオブジェ 北部エリア -m w24d1_b -r 0 0 0 -p 0 0 0 -s 100 100 100 -l w24d
		chara プットオブジェ 小部屋 	-m w24d0 -r 0 0 0 -p 0 0 0 -s 100 100 100 -l w24d

		trap mp002 d:PLAYER \
			-mask 出る \
			-exec {
				if( $6 < -57000 ) {
					mesg プットオブジェ 北部エリア on
					mesg プットオブジェ 小部屋 on
				} else {
					mesg プットオブジェ 北部エリア off
					mesg プットオブジェ 小部屋 off
				}
			}

		trap mp001 d:PLAYER \
			-mask 出る \
			-exec {
				if( $6 < -67000 ) {
					mesg プットオブジェ エレベーター on
					mesg 天井君 エレベーター天井 常に表示ＯＦＦ
				} else {
					mesg プットオブジェ エレベーター off
					mesg 天井君 エレベーター天井 常に表示
				}
			}
	}


