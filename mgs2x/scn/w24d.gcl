// 以下デバッグ専用proc
// -----------------------------------------------------------------------------------
// デバッグキャラ
// ------------------------------------
proc デバッグキャラセット {
#if d:MY_DEBUG
	chara スクリーンショット shot

	chara USBキーボード実行 test \
		-e d:KPD_0 {	// フラグ初期化
						print 'えろ 1'
						mesg 壊れコンピュータW24D エロコンピュータ画面１ 画面切替え 0
						mesg 壊れコンピュータW24D エロコンピュータ画面２ 画面切替え 1
				   } \
		-e d:KPD_1 {
						print 'えろ 2'
						mesg 壊れコンピュータW24D エロコンピュータ画面１ 画面切替え 2
						mesg 壊れコンピュータW24D エロコンピュータ画面２ 画面切替え 3
				   } \
		-e d:KPD_2 {
						//mesg プレイヤー d:PLAYER position 9000, -10000, -22200
						@大エレベータランプＯＮ
				   } \
		-e d:KPD_3 {
					//mesg プレイヤー d:PLAYER position 9000, -10000, -22200
						@大エレベータランプＯＦＦ
				   } \
		-e d:KPD_MINUS {
						command プレイヤー無敵セット
						mesg コマンダー 敵兵セット 視界オフ
				   } \
		-e d:KPD_PLUS {
						command プレイヤー無敵解除
						mesg コマンダー 敵兵セット 視界オン
				   } \
		-e d:KBD_1 {
						@おうむアイドリング
						print 'おうむアイドリング'
				   } \
		-e d:KBD_2 {
						@おうむえいむず
						print 'おうむえいむず'
				   } \
		-e d:KBD_3 {
						@おうむえいむず許可
						print 'おうむえいむず許可'
				   } \
		-e d:KBD_4 {	@おうむえろぼん
						print 'おうむえろぼん'
				   } \
		-e d:KBD_5 {
						@おうむえろぼん許可
						print 'おうむえろぼん許可'
				   } \
		-e d:KBD_0 {
						restart
				   }
#endif
}

