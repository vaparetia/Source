		/////////////////////////
		// 南側

			// 南側通路
			trap cS001C d:PLAYER \
				-mask ＊ \
				-camera \
				-exec {
					if( $4 > 6000 ) {
						@CS_スムーズカメラ昇順 $4 6000 7500 5000 6816
						eval( $i:補完ＰＸ = $i:CS_結果１ )

						chara カメラ設定 通路カメラ１ \
							-c 0 \
							-b $i:補完ＰＸ,-13061,-42636  6816,-13061,-42636 \
							-l $i:補完ＰＸ,-14258,-45998  6816,-14258,-45998 \
							-r 223,2048,0 -f 3334 \
							-a 200 \
							-i 2 2 0 0 \
							-slide 0 1 1000 1000 50 1 \
							-s $3
					} else if( $4 < -6000 ) {
						@CS_スムーズカメラ昇順 $4 -7500 -6000 -6816 -5000
						eval( $i:補完ＰＸ = $i:CS_結果１ )

						chara カメラ設定 通路カメラ１ \
							-c 0 \
							-b -6816,-13061,-42636  $i:補完ＰＸ,-13061,-42636 \
							-l -6816,-14258,-45998  $i:補完ＰＸ,-14258,-45998 \
							-r 223,2048,0 -f 3334 \
							-a 200 \
							-i 2 2 0 0 \
							-slide 0 1 1000 1000 50 1 \
							-s $3
					} else {
						chara カメラ設定 通路カメラ１ \
							-c 0 \
							-b -6816,-13061,-42636  6816,-13061,-42636 \
							-l -6816,-14258,-45998  6816,-14258,-45998 \
							-r 223,2048,0 -f 3334 \
