				}

			// 電算室内
			trap cS002C d:PLAYER \
				-mask ＊ \
				-camera \
				-exec {
				#if 1
					chara カメラ設定 通路カメラ１ \
						-c 0 \
						-b -2582,-11210,-49929  2582,-11210,-41708 \
						-l -2582,-14361,-55613  2582,-14361,-47393 \
						-r 330,2048,0 -f 6500 \
						-a 200 \
						-i 3 3 0 0 \
						-z d:CAMERA_NO_CUSHION \
						-s $3
				#else
					if( $4 > 0 ) {
						@CS_スムーズカメラ昇順 $4 500 3500 2048 (1888 + 100 )
					} else {
						@CS_スムーズカメラ降順 $4 -500 -3500 2048 (2208 - 100 )
					}
					eval( $i:補完ＲＹ = $i:CS_結果１ )

