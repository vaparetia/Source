			-mask * \
			-camera \
			-exec {
				chara カメラ設定 通路カメラ１ \
					-c 0 \
					-b -10000 -7812 -62942  10000 -7812 -62942 \
					-l -10000 -14661 -63405  10000 -14661 -63405 \
					-r 995,2048,0 -f 8040 \
					-a 200 \
					-i 3 -1 0 0 \
					-slide 0 1 0 2000 80 1 \
					-s $3
			}

	/////////////////////////////
	// 中央広場
		trap cN001C d:PLAYER \
			-mask * \
			-camera \
			-exec {
				/*
				if( $3 == 入る ) {
					eval( $i:進入位置Ｚ = $i:前フレーム位置Ｚ )
				}
				if( $i:進入位置Ｚ > -61000 ) {
					eval( $w:補完方式 = 0 )
				} else {
					eval( $w:補完方式 = 3 )
				}
				*/
				if( $3 == 入る ) {
					if( $6 > -62250 ) {
						eval( $w:補完方式 = 0 )
					} else {
						eval( $w:補完方式 = 3 )
					}
				}

				if( $4 > 0 ) {
					@CS_スムーズカメラ昇順 $4 4000 6000 -65000 -63405
				} else {
					@CS_スムーズカメラ昇順 $4 -6000 -4000 -63405 -65000
				}
				eval( $i:補完ＬＺ = $i:CS_結果１ )

				chara カメラ設定 通路カメラ１ \
					-c 0 \
					-b -8198 -7812 -62942  8198 -7812 -62942 \
					-l -8198 -14661 $i:補完ＬＺ  8198 -14661 -63405 \
					-r 980,2048,0 -f 6865 \
					-a 200 \
					-i $w:補完方式 -1 0 0 \
					-slide 0 1 2000 2000 80 \
					-s $3
			}

		// イベント時用カメラのはずが一般的に使用
		trap cN002C d:PLAYER \
			-mask * \
			-camera \
			//-state d:TRP_STATE_GROUND \
			-exec {
				// オウムにエロ話を許可する
				if( $3 == 入る ) {
					if( $f:w24d_エロ話始め == 1 ) {
						mesg オウム エロオウム エロ本喋り許可
						mesg オウム エロオウム エロ本聞き耳 -2250 -15000 -58750 300
						if( $f:オウムがエイムズ覚えた == 1 ) {
							print 'エロ話のみ'
							mesg オウム エロオウム 喋り内容の割合 10 50 40
						} else {
							print 'エロ話とエイムズ'
							mesg オウム エロオウム 喋り内容の割合 20 80 0
						}
					}
				}

				if( `command PlayerStatus -f d:TRP_STATE_GROUND` && ($6 > -62500) ) {
					chara カメラ設定 通路カメラ０ \
						-c 0 \
						-b d:CAM_MIN -9343 -58437  1091 -9343 -58437 \
						-l d:CAM_MIN -15624 -60695  1091 -15624 -60695 \
						-r 274,2048,0 -f 6864 \
						-a 200 \
						-i 0 0 0 0 \
						-s $3
				} else if( `command PlayerStatus -f d:TRP_STATE_SQUAT` && ($6 > -62500) ) {
					chara カメラ設定 通路カメラ０ \
						-c 0 \
						-b d:CAM_MIN -10170 -56635  1091 -10170 -56635 \
						-l d:CAM_MIN -15039 -61474  1091 -15039 -61474 \
						-r 274,2048,0 -f 6864 \
						-a 200 \
						-i 0 0 0 0 \
						-s $3
				} else {
					chara カメラ設定 通路カメラ０ \
						-c 0 \
						-b d:CAM_MIN -11618 -55402  1091 -11618 -55402 \
						-l d:CAM_MIN -14419 -61669  1091 -14419 -61669 \
						-r 274,2048,0 -f 6864 \
						-a 200 \
						-i 0 0 0 0 \
						-s $3
				}
			}

		// 張り付き時
		trap cN002C d:PLAYER \
			-mask ? \
			-camera \
			-dir 2048 256 \
			//-state d:TRP_STATE_CAUTION \
			-state d:TRP_STATE_BEHINDCAMERA_ENABLE \
			-exec {
				chara カメラ設定 通路張り付きカメラ \
					-c 0 \
					-b -2301,-13573,-63609  2155,-13572,-63609 \
					-l -2294,-14377,-61249  2162,-14375,-61249 \
					-r 214,2,0 -f 2493 \
					-a 200 \
					-i 0 0 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
				/*
					-p -2301,-13573,-63609 -t -2294,-14377,-61249 \
					-r 214,2,0 -f 2493 \
					-a 200 \

					-p 2155,-13572,-63609 -t 2162,-14375,-61249 \
					-r 214,2,0 -f 2493 \
					-a 200 \
				*/
			}

	///////////////////////////////
	// 南エリア
		///////////////////////////
		// 右舷側
			// 右通路
			trap cS001R d:PLAYER \
				-mask ＊ \
				-camera \
				-exec {
					@CS_スムーズカメラ昇順 $6 -61000 -49000 350 200
					eval( $w:補完画角 = $i:CS_結果１ )

					@完全補完カメラ $6	-61000 -49000 \
										6826,-12260,-44998 7362,-14130,-52747 \
										6816,-13061,-42636 6816,-14258,-45998

					chara カメラ設定 通路カメラ１ \
							-c 1 \
