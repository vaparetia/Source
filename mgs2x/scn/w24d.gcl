					eval( $i:補完ＴＹ = $i:CS_結果１ )
					@CS_スムーズカメラ昇順 $6 -67000 -64750 -67802 -63405
					eval( $i:補完ＴＺ = $i:CS_結果１ )

					chara カメラ設定 通路カメラ１ \
						-c 0 \
						-b 10000 $i:補完ＢＹ $i:補完ＢＺ  10000 $i:補完ＢＹ $i:補完ＢＺ \
						-l 10000 $i:補完ＴＹ $i:補完ＴＺ  10000 $i:補完ＴＹ $i:補完ＴＺ \
						-r 980,2048,0 -f 6865 \
