//-----------------------------------------------------------------------------
// スイッチ
#define RAIDEN     0
#if d:RAIDEN
#define PLAYER     ライデン
#else
#define PLAYER     スネーク
#endif

#define ENEMY_SET  1			// 敵兵の配置
#define STAGE_END  1			// ロードプロック

#define SCREENSHOT 0			// スクリーンショット
#define KEYBOARD   1			// ＵＳＢキーボード

//-----------------------------------------------------------------------------
// マップ関係
#define HZX_NAME   w43a
#define KMS_NAME0  w43a
#define LT2_NAME   w43a
#define DOOR_NAME1 w02a_l_dr

//-----------------------------------------------------------------------------
// ローカル

eval($f:フラグ01 = 0)	// ドア開閉フラグ





