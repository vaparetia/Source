//=============================================================================
// メイン
//=============================================================================

chara マップ 丸通路 -k d:KMS_NAME0 -h d:HZX_NAME, 0 -l d:LT2_NAME

command マップ設定 丸通路 -set {

	//----- 基本設定
	@サウンド設定
	@常駐キャラ設定				// ヘッダーに定義
	@プレイヤー設定
	@E3撮影用
	@ＵＳＢキーボードセット
#if d:ENEMY_SET
	@敵兵設定
#endif
	@ＢＧＭ設定

	//----- ビヨンド、ジャンプ
	@ビヨンド設定
	@ジャンプ設定

	//----- オブジェクト
	@ノード端末設定
	@ドア設定
	@アイテム設定
	@その他オブジェクト設定

	//----- フォグ、カメラ、ロード
	@キャラ用ライト設置
	@フォグ設定
	@カメラ設定
	@ロード設定
}

#include "cdc_common.h"			// ※※ 通信機の include は移動させないこと！！ ※※

command マップ表示 -show 丸通路

@ステージ進入時処理





//=============================================================================
// プロシージャ
