//=============================================================================
// 基本設定
//=============================================================================

//-----------------------------------------------------------------------------
// サウンド設定
proc サウンド設定 {
#if d:DEBUG_PRINT
	print '*** Sound Set'
#endif

	chara サウンドマネージャー ＳＤマネ \
		-pak 0	// パック番号

	// 壁叩き音 -data オプションは必ず 8 セット書くこと
	command 壁床効果音設定 \
		-id 0 \
		-type 1 \
		-se d:SD_P_WALL02 \
		-data	d:se_code:SD_A_WALLM01,d:NOISE_S \	// 通常
				d:se_code:SD_A_WALLM02,d:NOISE_S \	// 鉄筋
				d:se_code:SD_A_WALLM03,d:NOISE_S \	// 鉄板
				d:se_code:SD_A_WALLM04,d:NOISE_S \	// 木
				d:se_code:SD_A_WALLM01,d:NOISE_S \
				d:se_code:SD_A_WALLM01,d:NOISE_S \
				d:se_code:SD_A_WALLM01,d:NOISE_S \
				d:se_code:SD_A_WALLM01,d:NOISE_S	// 必ず８セット書くこと

	// 左足音 -data オプションは必ず 8 セット書くこと
	command 壁床効果音設定 \
		-id		0 \
		-type	0 \
		-se		d:SD_P_FOOTL01 \
		-data	d:se_code:SD_P_FOOT_01L,d:NOISE_ZERO \
				d:se_code:SD_P_FOOT_02L,d:NOISE_S \
				d:se_code:SD_P_FOOT_03L,d:NOISE_ZERO \
				d:se_code:SD_P_FOOT_04L,d:NOISE_S \
				d:se_code:SD_P_FOOT_01L,d:NOISE_ZERO \
				d:se_code:SD_P_FOOT_01L,d:NOISE_ZERO \
				d:se_code:SD_P_FOOT_01L,d:NOISE_ZERO \
				d:se_code:SD_P_FOOT_01L,d:NOISE_ZERO

	// 右足音 -data オプションは必ず 8 セット書くこと
	command 壁床効果音設定 \
		-id 	0 \
		-type 	0 \
		-se 	d:SD_P_FOOTR01 \
		-data	d:se_code:SD_P_FOOT_01R,d:NOISE_ZERO \
				d:se_code:SD_P_FOOT_02R,d:NOISE_S \
				d:se_code:SD_P_FOOT_03R,d:NOISE_ZERO \
				d:se_code:SD_P_FOOT_04R,d:NOISE_S \
				d:se_code:SD_P_FOOT_01R,d:NOISE_ZERO \
				d:se_code:SD_P_FOOT_01R,d:NOISE_ZERO \
				d:se_code:SD_P_FOOT_01R,d:NOISE_ZERO \
				d:se_code:SD_P_FOOT_01R,d:NOISE_ZERO
}

//-----------------------------------------------------------------------------
// プレイヤー設定
proc プレイヤー設定 {
#if d:DEBUG_PRINT
	print '*** Player Set'
#endif

// 仮設定
eval ($i:プレイヤー初期Ｘ位置 =  33000)
eval ($i:プレイヤー初期Ｙ位置 =   4000)
eval ($i:プレイヤー初期Ｚ位置 = -62500)
eval ($i:プレイヤー初期方向   =   1024)

#if d:RAIDEN
	// プレイヤー
	//   -m モデル名  -a モーション名  -p 出現位置  -d 出現方向  -s 出現時姿勢  -o 強制モーションファイル名  -i SE 変換テーブル ID
	chara プレイヤー d:PLAYER \
		-m rai_def \
		-a raiden \
		-p $i:プレイヤー初期Ｘ位置 $i:プレイヤー初期Ｙ位置 $i:プレイヤー初期Ｚ位置 \
		-d 0,$i:プレイヤー初期方向,0 \
		-s 0 \
		-o rai_w14a \
		-i 0

	// 髪の毛
	@ライデン髪の毛設定 d:NORMAL_HAIR

#else
	// プレイヤー
	chara プレイヤー d:PLAYER \
		-m sna_def \
		-a snake \
		-p $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,$i:プレイヤー初期Ｚ位置 \
		-d 0,$i:プレイヤー初期方向,0 \
		-s 0 \
		-o sna_w02a

	// ロープモデル３
	//   -n モデル名  -d サンプルデータ番号  -y 着ける相手の名前  -z 着ける場所の OBJ 番号  -x オフセット座標  -m 各 OBJ の重さ  -p 風の影響の割合  -k 速度に対する抵抗の割合  -o 楕円球当たり判定用パラメータ  -f 当たり判定を行うかどうかのフラグ

	// バンダナ
	chara ロープモデル３ バンダナ１ \
		-n sna_bdn1 \
		-d 1 \
		-y スネーク \
		-z 12 \
		-x 0,60,-90 \
		-m 12 \
		-p 250 \
		-k 350 \
		-o 110 \
		-f 1

	chara ロープモデル３ バンダナ２ \
		-n sna_bdn2 \
		-d 1 \
		-y スネーク \
		-z 12 \
		-x 0,50,-90 \
		-m 22 \
		-p 250 \
		-k 350 \
		-o 110 \
		-f 1
#endif

	// ブレード
	eval ($w:武器最大数Ｒ[d:武器:ブレード] = 1)
	eval ($w:武器弾数Ｒ[d:武器:ブレード]   = 1)
	eval ($w:武器最大数[d:武器:ブレード]   = 1)
	eval ($w:武器弾数[d:武器:ブレード]     = 1)
	command プラグインブレード -m rai_blade

	chara 白息 プレイヤー息 \
		-name d:PLAYER \
		-object 12 \
		-shift 0,-30,130 \
		-interval 136
	mesg 白息 プレイヤー息 on

	chara 亀甲床 亀甲床 \
		-prims 128 \
		-alpha 7 \
		-vertex 5 \
		-user 64 \
		-time 150
}

