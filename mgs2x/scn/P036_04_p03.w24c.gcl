// 各gclで必要なdefine
// ------------------------------------
// モード
#define		STAGE_PLANT		1		// 共通プロック切り分け用
#define		DEMO_STAGE		1		// デモステージかどうかで起動するキャラを切り分ける

// 各種スイッチ用define
// ------------------------------------
// デバッグ関係
#define		SCREENSHOT		0		// スクリーンショット
#define		USB_KEY			0		// USBキーボード


// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME			d00a3
#define		KMS_NAME0			w24c0
#define		KMS_NAME1			w24c1
#define		KMS_NAME2			w24c_w24b
#define		CEIL_NAME			w24c0r
#define		WALL_NAME			w24c0_wall
#define		DOOR_NAME			w24c_stdr		//スタジオ入口ドア
#define		DOOR_NAME_LOAD		w24b_dr02
#define		LT2_NAME			w24c

// include
// ------------------------------------
#include "5sec_bfr_demo.h"
#include "demo_vardef.h"
#include "demo_stdch.h"
#include "demo_stdch2.h"
#include "story.h"
#include "sload.h"

#include "p_force_cdc.ch"

#if d:USB_KEY
	#include "usbkbd.h"
#endif

#if d:PLANT_DEMO_ALL_SKIP
	#define		DEMO_SKIP_ENABLE 1
#else
	#define		DEMO_SKIP_ENABLE 0
#endif
#include	"w24c_common.h"

// マップ設定
// ------------------------------------

//モニタ画面モデルを呼び出してます		野尻
chara マップ 人質部屋 -k w24c1_disp_on -h d:HZX_NAME -l d:LT2_NAME

command マップ設定 人質部屋 -set {

//	デモ環境かゲーム環境かで起動を読み分ける。
// ------------------------------------
#if d:MGS2_DEMO

#if 1
	chara スクリーンショット screen
#endif

chara デモアクトデバッグ demodebug  -i t:p040_07_p04 -d 'p040_07_p04' -l  -s 'p040_07_p04'  \
		-p null

		// オセロット窓透明
		#if 1
			eval($s:d_num = P036_04_p03)
			eval($s:d_num = P039_01_p01)
			eval($s:d_num = P040_01_p01)
			eval($s:d_num = P040_03_p02)
		#else
			eval($s:d_num = P040_09_p05)
		#endif

#else

// 実際の再生
//-----------------------------------------------------------
	// 実際のデモ再生の方も、ストーリーフラグで変える

	//人質部屋に最初に入ったとき部屋を見渡す
	if($w:p_story == d:ST:P036_04_P03忍者登場４ポリゴンデモ３開始) {
		print '$w:p_story = ST:P036_04_P03忍者登場４ポリゴンデモ３開始'
		// デモ特有の変数代入
		eval($s:d_num = P036_04_p03)
		@デモ再生_P036_04_p03
		// ゲームから戻ってくる
		//エイムズに最初に会った
	} else if($w:p_story == d:ST:P039_01_P01人質部屋潜入１ポリゴンデモ１開始) {
		print '$w:p_story = ST:P039_01_P01人質部屋潜入１ポリゴンデモ１開始'
		/* 人質部屋へ忍び込むライデン（変装済み）*/
		// デモ特有の変数代入
		eval($s:d_num = P039_01_p01)
		@デモ再生_P039_01_p01
		// ゲームから戻ってくる
		//エイムズに最初に会った
	} else if($w:p_story == d:ST:P040_01_P01エイムズ発見１ポリゴンデモ１開始) {
		print '$w:p_story = ST:P040_01_P01エイムズ発見１ポリゴンデモ１開始'
		/* 指向性マイクでエイムズを発見 */
		// デモ特有の変数代入
		eval($s:d_num = P040_01_p01)
		@デモ再生_P040_01_p01
	} else if(d:ST:P040_01_P01エイムズ発見１ポリゴンデモ１終了 <= $w:p_story && \
		$w:p_story < d:ST:P040_02_R02エイムズ発見２無線デモ１開始) {
		eval($w:p_story = d:ST:P040_02_R02エイムズ発見２無線デモ１開始)
		print '$w:p_story = ST:P040_02_R02エイムズ発見２無線デモ１開始'
		/* エイムズ体内通信　大統領のブラックケースの説明 */
		// デモ特有の変数代入
		eval($s:d_num = P040_02_r02)
		@rt_P040_02_R02エイムズ発見２無線デモ１
		/* P040_02_r02終了 */
	} else if(d:ST:P040_02_R02エイムズ発見２無線デモ１終了 <= $w:p_story && \
		$w:p_story < d:ST:P040_03_P02エイムズ発見３ポリゴンデモ２開始) {
		eval($w:p_story = d:ST:P040_03_P02エイムズ発見３ポリゴンデモ２開始)
		print '$w:p_story = ST:P040_03_P02エイムズ発見３ポリゴンデモ２開始'
		//ソリダスがスタジオに入ってくる
		/* スタジオ内にニセスネーク出現 */
		// デモ特有の変数代入
		eval($s:d_num = P040_03_p02)
		#if d:デモ前五秒間待ち
			// コレがないと一個後のデモを再生してしまう。
			eval($w:p_story = d:ST:P040_03_P02エイムズ発見３ポリゴンデモ２開始-1)
			@global_五秒待ちセット
			if($f:global_デバッグポーズ通過){
				@デモ再生_P040_03_p02
			}
		#else
			@デモ再生_P040_03_p02
		#endif
		//あいつは本当にソリッドスネークなのか？
	} else if($w:p_story == d:ST:P040_05_P03エイムズ発見５ポリゴンデモ３開始) {
		print '$w:p_story = ST:P040_05_P03エイムズ発見５ポリゴンデモ３開始'
		/* 本当にスネークなのかと、信じられないライデン */
		// デモ特有の変数代入
		eval($s:d_num = P040_05_p03)
		@デモ再生_P040_05_p03
	} else if(d:ST:P040_05_P03エイムズ発見５ポリゴンデモ３終了 <= $w:p_story && \
		$w:p_story < d:ST:P040_06a_R02aエイムズ発見６a無線デモ２a開始) {
		eval($w:p_story = d:ST:P040_06a_R02aエイムズ発見６a無線デモ２a開始)
		print '$w:p_story = ST:P040_06a_R02aエイムズ発見６a無線デモ２a開始'
		/* エイムズ体内通信　敵の要求についてエイムズが語る */
		// デモ特有の変数代入
		eval($s:d_num = P040_06a_r02a)
		#if 0
			chara デバッグポーズ pause 'CODEC_P040_06a_r02a' -p P040_06a_r02a終了
		#else
			@rt_P040_06a_R02aエイムズ発見６a無線デモ２a
			/* P040_06a_r02a終了 */
			/*
			eval($w:p_story = d:ST:P040_06a_R02aエイムズ発見６a無線デモ２a終了)
			restart
			*/
		#endif
	} else if(d:ST:P040_06a_R02aエイムズ発見６a無線デモ２a終了 <= $w:p_story && \
					$w:p_story < d:ST:P040_06b_M00エイムズ発見６bムービーデモ０開始) {
		eval($w:p_story = d:ST:P040_06b_M00エイムズ発見６bムービーデモ０開始)
		print '$w:p_story = ST:P040_06b_M00エイムズ発見６bムービーデモ０開始'
		/* ウォール街　ＮＹＳＥ */
		// デモ特有の変数代入
		eval($s:d_num = P040_06b_m00)
		#if 0
//			chara デバッグポーズ pause 'MOVIE_P040_06_R02' -p P040_06b_m00終了
			eval( $w:p_story = d:ST:P040_06b_M00エイムズ発見６bムービーデモ０開始 );
			print '$w:p_story = d:ST:P040_06b_M00エイムズ発見６bムービーデモ０開始'
			chara MOVIE再生 P040_06b_m00 -file t:p040_06_r02 -top 0, d:MOVIE_TOP_Y -size 512, 320 \
				-proc P040_06b_m00終了
		#else
			chara MOVIE再生 p040_06_r02 \
				-file t:p040_06_r02 \
				-top 0, d:MOVIE_TOP_Y -size 512, 320 \
				-proc P040_06b_m00終了
			/* P040_06b_m00終了 */
		#endif
	} else if(d:ST:P040_06b_M00エイムズ発見６bムービーデモ０終了 <= $w:p_story && \
					$w:p_story < d:ST:P040_06c_R02bエイムズ発見６c無線デモ２b開始) {
		eval($w:p_story = d:ST:P040_06c_R02bエイムズ発見６c無線デモ２b開始)
		print '$w:p_story = ST:P040_06c_R02bエイムズ発見６c無線デモ２b開始'
		/* エイムズ体内通信　マンハッタンを解放区に… */
		// デモ特有の変数代入
		eval($s:d_num = P040_06c_r02b)

		@rt_P040_06c_R02bエイムズ発見６c無線デモ２b
		/* P040_06c_r02b終了 */
		/*
		eval($w:p_story = d:ST:P040_06c_R02bエイムズ発見６c無線デモ２b終了)
		restart
		*/
	//オセロットスタジオから出てくる
	} else if(d:ST:P040_06c_R02bエイムズ発見６c無線デモ２b終了 <= $w:p_story && \
		$w:p_story < d:ST:P040_07_P04エイムズ発見７ポリゴンデモ４開始) {
		eval($w:p_story = d:ST:P040_07_P04エイムズ発見７ポリゴンデモ４開始)
		print '$w:p_story = ST:P040_07_P04エイムズ発見７ポリゴンデモ４開始'
		/* エイムズからカード３を受け取る */
		// デモ特有の変数代入
		eval($s:d_num = P040_07_p04)
		@デモ再生_P040_07_p04
	// ゲームから戻ってくる
	} else if($w:p_story == d:ST:P040_09_P05エイムズ発見９ポリゴンデモ５開始) {
		print '$w:p_story = ST:P040_09_P05エイムズ発見９ポリゴンデモ５開始'
		/* エイムズ死亡　忍者が出てきてライデンを救う */
		// デモ特有の変数代入
		eval($s:d_num = P040_09_p05)
		@デモ再生_P040_09_p05
	}
#endif

// 以下、諸々セット
//-----------------------------------------------------------
	@常駐キャラ設定						// stdch.hで定義

	chara デモキャンセルチェック デモキャンセル \
		-p demo_cancel
	@ドア設置
	@フォグ設定
	@エフェクト設定
	@ステージモデル本体セット
	@人質部屋天井設置
	@人質部屋南壁設置
	@米国旗設定			//w24c_common.hの中
	@壊れ物設置			//w24c_common.hの中
	@照明きらめき設定		//w24c_common.hの中
	@影設定				//w24c_common.hの中


	// 人質は、虐殺デモではデモの方で置くので外す。
	if( ($s:d_num != P040_01_p01) && ($s:d_num != P040_03_p02) && \
		($s:d_num != P040_05_p03) && ($s:d_num != P040_07_p04) && \
		($s:d_num != P040_09_p05)){
		@人質コマンダー設定
		@人質設定				//w24c_common.h	の中です。
	}

	// 無線ではシネマスクリーン起動しない
	if(($s:d_num != P040_02_r02) || \
		($s:d_num != P040_06a_r02a) || \
		($s:d_num != P040_06c_r02b)){
		@シネマスクリーンセット
	}

	// 透明窓と曇り窓
	if(($s:d_num == P036_04_p03) || ($s:d_num == P039_01_p01) || \
		($s:d_num == P040_01_p01) || ($s:d_num == P040_03_p02)){
		@オセロット会話部屋窓_透明セット
	} else {
		@オセロット会話部屋窓_曇りセット
	}
}


// ====================================
// 初期マップ表示
// ====================================
	command マップ表示 -show 人質部屋

// 各proc設定
//-------------------------------------------------------------------------------------
// デモデモ再生関連のプロック
//-----------------------------------------------------------
// これはデバッグ用
proc restart_proc {
	restart
}

proc dummy_proc {}

proc null {}

proc demo_cancel {
	command StreamStopAll
}

proc シネマスクリーンセット  {
	chara シネマスクリーン シネマ \
		-top d:CINEMA_BELT_UPPER \
		-bottom d:CINEMA_BELT_LOWER \
		-ftime 60	//デフォルト値（ゼロは駄目）
	mesg シネマスクリーン シネマ フェードアウト 1
}






//###################################################################################
//								人質コマンダー設定
//###################################################################################


	proc 人質コマンダー設定 {
		#if d:DEBUG_PRINT
			print 'hos_commander'
			print '人質コマンダー設定'
		#endif
		chara 人質コマンダー 人質コマンダー
	}





//###################################################################################
//										ドア設置
//###################################################################################
	proc ドア設置 {
		chara プットオブジェ 人質部屋ドア \
			-m d:DOOR_NAME_LOAD \
			-r 0,3072,0 \
			-p -1325,-4500,-67000 \
			-s 100,100,100 \
			-l d:LT2_NAME

		chara プットオブジェ スタジオドア \
			-m d:DOOR_NAME \
			-r 0,2048,0 \
			-p -9500,-8500,-63125 \
			-s 100,100,100 \
			-l d:LT2_NAME

		chara プットオブジェ スタジオ奥ドア \
			-m d:DOOR_NAME \
			-r 0,3072,0 \
			-p -1625,-8500,-66500 \
			-s 100,100,100 \
			-l d:LT2_NAME
	}

//###################################################################################
//									エフェクト設定
//###################################################################################
	// フォグ
	// ------------------------------------
	proc フォグ設定 {
		chara フォグ 霧\
			-c 40, 35, 20 \
			-n -5000 \
			-f 30000
	}

	// キャラ用光源(マップの設置が終わってから設定することで、キャラだけに光を当てる)
	// ------------------------------------
	proc キャラ用ライト設置 {
		chara 環境光 環境光源 \
			 -c 64 64 64

		chara 平行光 平行光源 \
			 -c 128 128 128 \
			 -p -2500 -3500 -2500
	}

	// エフェクト関係
	// -----------------------------------
	proc エフェクト設定 {
		//	chara ブラー ブラー

			chara Ｚフォーカス管理 Z_manager

			chara ＯＦＦ制御 off_man
			mesg ＯＦＦ制御 off_man ボディシャドウＯＦＦ

	}







//###################################################################################
//									ステージモデルセット
//###################################################################################
	// ステージモデル本体
	// ------------------------------------
	proc ステージモデル本体セット {
		chara プットオブジェ ステージ本体１ \
			-m d:KMS_NAME0 \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME

		chara プットオブジェ ステージ本体２ \
			-m d:KMS_NAME1 \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME

		chara プットオブジェ ステージ本体３ \
			-m d:KMS_NAME2 \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME
	}

	// 天井設置
	// ------------------------------------
	proc 人質部屋天井設置 {
		chara プットオブジェ 人質部屋天井 \
			-m d:CEIL_NAME \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME
	}
	proc 人質部屋南壁設置 {
		chara プットオブジェ 人質部屋南壁 \
			-m d:WALL_NAME \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME
	}

	proc オセロット会話部屋窓_透明セット {
		chara プットオブジェ 透明窓 \
			-m win_01 \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME
	}

	proc オセロット会話部屋窓_曇りセット {
		chara プットオブジェ 曇り窓 \
			-m win_02 \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME
	}


// --------------------------------------------------------------------------
// --------------------------------------------------------------------------
// --------------------------------------------------------------------------
// --------------------------------------------------------------------------
// --------------------------------------------------------------------------

proc デモ再生_P036_04_p03 {
	#if d:デモ前五秒間待ち
chara デモアクトデバッグ demodebug  -i t:p040_07_p04 -d 'p040_07_p04' -l  -s 'p040_07_p04'  \
			-next P036_04_p03終了 \
			-p null
	#else
		@デモモデル差し替え処理
		if ( $w:アイテム == d:アイテム:ゴル兵制服 ) {
			chara demo デモ再生 \
				-i t:p036_04_p03 \
				-p null \
				-next P036_04_p03終了 \
				-rename_evm rai_def_mh_mt rai_gbs_gbshead_mh_mt
		}else{
			chara demo デモ再生 \
				-i t:p036_04_p03 \
				-p null \
				-next P036_04_p03終了
		}
	#endif
}
proc P036_04_p03終了 {
	@デモ終了時シネマスクリーンオフ
	mesg デモキャンセルチェック デモキャンセル kill
	#if d:DEMO_SKIP_ENABLE
		print '$w:p_story = d:ST:P036_07_P06忍者登場７ポリゴンデモ６終了'
		eval($w:p_story = d:ST:P036_07_P06忍者登場７ポリゴンデモ６終了)
	#else
		print '$w:p_story = d:ST:P036_04_P03忍者登場４ポリゴンデモ３終了'
		eval($w:p_story = d:ST:P036_04_P03忍者登場４ポリゴンデモ３終了)
	#endif
	chara delay ディレイ -time 1 -exec{ load 'd021p01' }
}


// --------------------------------------------------------------------------
proc デモ再生_P039_01_p01 {
	#if d:デモ前五秒間待ち
chara デモアクトデバッグ demodebug  -i t:p040_07_p04 -d 'p040_07_p04' -l  -s 'p040_07_p04'  \
			-next P039_01_p01終了 \
			-p null
	#else
		@デモモデル差し替え処理
		if ( $w:アイテム == d:アイテム:ゴル兵制服 ) {
			chara demo デモ再生 \
				-i t:p039_01_p01 \
				-p null \
