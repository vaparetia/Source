proc 網膜センサー付近_w24bステージモデルセット {
	chara プットオブジェ 網膜センサー付近モデル \
			-m w24b0 -p 0,0,0  -l d:LT2_NAME_W24B -r 0,0,0
	chara プットオブジェ 網膜センサーモデル \
			-m w24b0_ms00 -p 0,0,0  -l d:LT2_NAME_W24B -r 0,0,0

	// 人質部屋付近のドア
	chara プットオブジェ 網膜センサーモデル \
			-m w24b_dr02 -p -1325,-4500,-67000 \
			-l d:LT2_NAME_W24B -r 0,3072,0
}

proc ファットマン滲み血セット {
	if(($w:コンフィグ設定 & d:CONFIG_BLOOD_OFF) == 0) {
print 'アニメテクスチャ_000'
	chara アニメテクスチャセット ファットマン滲み血 \
		-tex zzz_fat_ooze_blood_mh fat_ooze_blood00_alp_ovl \
		-anmtex fat_ooze_blood \
		-interval 4 \
		-flag 0x0002 // 停止状態で起動
print 'アニメテクスチャ_001'
	}
}
proc 滲み血アニメ開始 {
print 'アニメテクスチャ滲み開始_000'
	mesg アニメテクスチャセット ファットマン滲み血 start
}
proc 滲み血アニメ停止 {
print 'アニメテクスチャ滲み停止_000'

	mesg アニメテクスチャセット ファットマン滲み血 stop
}


//=============================================================================
// フォグ、カメラ、ロード
//=============================================================================
//-----------------------------------------------------------------------------
// 海面・空
	proc 海面設置 {
		@プラント海面セット 昼 w20b 1
	}

	proc 空設置 {
		@プラントステージでの汎用空セット 昼 w20b

		chara 太陽 ソル \
			-p 56500,-40000,-96250 \		//中心の位置
			-f -800 -4400 2100	//平行光源の -p と同じ値
	}

//-----------------------------------------------------------------------------
// フォグ設定
proc フォグ設定 {
	@プラントステージでのフォグセット 昼 0
}

proc 網膜センサー付近フォグ設定 {
	// フォグ
	//   -c ＲＧＢカラー  -n ＮＥＡＲ値  -f ＦＡＲ値
	chara フォグ 霧\
		-c 100, 35, 30 \
		-n 3000 \
		-f 33000
}

//-----------------------------------------------------------------------------
// サウンド
proc サウンドマネージャーセット {
	chara サウンドマネージャー ＳＤマネ -pak -1		// パックをロードしない
}

proc サウンドマネージャー_mesg_1 {
	command セットサウンドコード -c d:SNG_PLAY_07
}

proc サウンドマネージャー_mesg_2 {
	command セットサウンドコード -c d:SNG_FOUTS_S
}
proc サウンドマネージャーセット２ {
	chara サウンドマネージャー ＳＤマネ -pak 0
}

//-----------------------------------------------------------------------------
// 爆弾
proc キムさん爆弾セット {
print 'ばくだんばくだんばくだんばくだんばくだんばくだんばくだんばくだんばくだん'
	chara プットオブジェ ボム \
			-m c4_kaitai_a1 \
			-p 66252,12365,-101710 \
			-r 0 -1024 0 \
			-l d:LT2_NAME
}

//-----------------------------------------------------------------------------
// ほろ
proc ホロセット {
	// プット頂点アニメオブジェ  -m $s:モデル名  -b $i:ベースフレーム数  -w $i:ランダムビット幅  -r $v:向き  -p $v:場所  -l $s:光源
	chara プット頂点アニメオブジェ ホロ \
		-m w20b_horo \
		-r 0,0,0 \
		-p 51250,11500,-82750 \
		-b 10 \
		-w 2
}

//-----------------------------------------------------------------------------
// リアル影
// [追加] 2001/08/30 Uehara Masatoshi
proc リアル影セット {
	chara 影投影モデル 影もでる \
		-m w20ck1 \
		-p 0 0 0

		chara 影管理 影かんり \
			-t 0 \
			-p -800 -4400 2100

	if($s:d_num == P032_01_p01){	// ファットマン登場
		mesg 影管理 影かんり demo_add rai_def_mh_demo 影もでる	// ライデン
		mesg 影管理 影かんり demo_add newファットマン 影もでる	// ファットマン
	} else if ($s:d_num == P034_01_p01){	// ファットマン死亡
		mesg 影管理 影かんり demo_add ライデン       影もでる	// ライデン
		mesg 影管理 影かんり demo_add 新ファットマン 影もでる	// ファットマン
	} else if ($s:d_num == P036_01_p01){	// 忍者登場
		mesg 影管理 影かんり demo_add rai_def_mh_demo 影もでる	// ライデン
		mesg 影管理 影かんり demo_add org_tng_mh_demo 影もでる	// 忍じゃ。
	}
}


// デモ再生Proc 本体
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
proc デモ再生_P021_01_p01 {
	chara demo デモ再生 \
		-i t:p021_01_p01 \
		-p w20b_12aオフ w20b_12aオン \
		   w20b_14aオフ w20b_14aオン \
		   w20b_15aオフ w20b_15aオン \
		   w20b_17aオフ w20b_17aオン \
		   w20b_19aオフ w20b_19aオン \
		   w20b_21aオフ w20b_21aオン \
		   w20b_23aオフ w20b_23aオン \
		   w20b_24aオフ w20b_24aオン \
		   w20b_25aオフ w20b_25aオン \
		   w20b_31aオフ w20b_31aオン \
		   w20b_craneオフ w20b_craneオン \
		   w20b_glオフ w20b_glオン \
		   w20b_hオフ w20b_hオン \
		   w20b_hiオフ w20b_hiオン \
		   w20b_iオフ w20b_iオン \
		   w20b_jkオフ w20b_jkオン \
		   w20b_kオフ w20b_kオン \
		   滲み血アニメ開始 滲み血アニメ停止 \
		-rename_evm rai_def_mh_mt rai_gbs_raihead_mh_mt \
		-next P021_01_p01終了
}
proc P021_01_p01終了 {
