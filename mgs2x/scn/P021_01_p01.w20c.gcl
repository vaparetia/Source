//=============================================================================
// P021_01_p01.w20c.gcl // 010604 名称変更(P021_01_p01.w20b.gclより)。
// Ｅ脚・ヘリポートデモステージ
// 爆弾解体オルガ登場１_pd１/ファットマン登場１/ファットマン死亡１/忍者登場１
// 忍者登場２・５・６・７・１１・１２
// 2001/02/26 S.Yamashita
// $Id: P021_01_p01.w20c.gcl,v 1.54 2001/09/26 09:03:18 usr03635 Exp $
//

//=============================================================================
// define
//=============================================================================
// 各gclで必要なdefine
// ------------------------------------
// モード
#define		STAGE_PLANT		1		// 共通プロック切り分け用
#define		DEMO_STAGE		1		// デモステージかどうかで起動するキャラを切り分ける

//-----------------------------------------------------------------------------
// スイッチ
#define SCREENSHOT 0			// スクリーンショット
#define KEYBOARD   0			// ＵＳＢキーボード

//-----------------------------------------------------------------------------
// マップ関係
#define HZX_NAME			d00a3
#define KMS_NAME0			w20c
#define DOOR_NAME1			w02a_dr
#define KMS_NAME_HARRIER	hri_def
#define KMS_NAME_SEA		sea
#define LT2_NAME			w20b
#define LT2_NAME_W24B		w24b

#if d:MGS2_DEMO
	// デモデバッグ用、切り替えスイッチ（リアル影チェック用）
	// 0 : p032_01_P01
	// 1 : p034_01_P01
	// 2 : p036_01_P01
	// 3 : その他
	#define DEMO_KAGE_STATUS 2
#endif

//=============================================================================
// include
//=============================================================================
#include "5sec_bfr_demo.h"
#include "demo_vardef.h"
#include "demo_stdch.h"
#include "demo_stdch2.h"
#include "story.h"
#include "sload.h"
#include "sea_surface.h"
#include "p_force_cdc.ch"

#if d:KEYBOARD 
#include "usbkbd.h"
#endif

#if d:PLANT_DEMO_ALL_SKIP
	#define		DEMO_SKIP_ENABLE 1
#else
	#define		DEMO_SKIP_ENABLE 0
#endif

//=============================================================================
// メイン
//=============================================================================
// ＜↓↓↓同期↓↓↓＞
if(d:ST:P036_06_P05忍者登場６ポリゴンデモ５終了 <= $w:p_story && \
	$w:p_story < d:ST:P036_07_P06忍者登場７ポリゴンデモ６開始) {
	chara マップ ヘリポート -h d:HZX_NAME -l d:LT2_NAME_W24B
} else {
	chara マップ ヘリポート -h d:HZX_NAME -l d:LT2_NAME
}

command マップ設定 ヘリポート -set {

//	デモ環境かゲーム環境かで起動を読み分ける。
// ------------------------------------
#if d:MGS2_DEMO

chara デモアクトデバッグ demodebug  -i t:p036_01_p01 -d 'p036_01_p01' -l   \
		-p w20b_12aオフ w20b_12aオン \
		   w20b_14aオフ w20b_14aオン \
		   w20b_15aオフ w20b_15aオン \
		   w20b_17aオフ w20b_17aオン \
		   w20b_19aオフ w20b_19aオン \
		   w20b_21aオフ w20b_21aオン \
		   w20b_23aオフ w20b_23aオン \
		   w20b_24aオフ w20b_24aオン \
		   w20b_25aオフ w20b_25aオン \
		   w20b_31aオフ w20b_31aオン \
		   w20b_craneオフ w20b_craneオン \
		   w20b_glオフ w20b_glオン \
		   w20b_hオフ w20b_hオン \
		   w20b_hiオフ w20b_hiオン \
		   w20b_iオフ w20b_iオン \
		   w20b_jkオフ w20b_jkオン \
		   w20b_kオフ w20b_kオン \
		   滲み血アニメ開始 滲み血アニメ停止

		@キムさん爆弾セット
		@ファットマン滲み血セット

		// 網膜チェックデモ時
//		eval($s:d_num = P036_07_p06)

	if(d:DEMO_KAGE_STATUS == 0) {
		eval($s:d_num = P032_01_p01)
	} else if(d:DEMO_KAGE_STATUS == 1) {
		eval($s:d_num = P034_01_p01)
	} else if(d:DEMO_KAGE_STATUS == 2) {
		eval($s:d_num = P036_01_p01)
	}

#else


// 実際の再生
//-----------------------------------------------------------
	// 実際のデモ再生の方も、ストーリーフラグで変える

/*！！！！！！！！！！！！！！！注意！！！！！！！！！！！！！！！
ただし、ストーリーフラグとして廃止しただけ。ポリデモ自体はここで
再生する。独自フラグで管理する。山下君からフラグもらう。
(010502)
セレクトから入ったときにオルガフラグのみでは、無条件にオルガデモに
入って邪魔なので、一応ストーリーフラグもみるように変更。
(010610)
！！！！！！！！！！！！！！！注意！！！！！！！！！！！！！！！*/

	if(($w:p_story < d:ST:P031_01_P01フォーチュン戦終了１ポリゴンデモ１終了) && \
		($f:w20b_オルガデモフラグ == 0)) { // 左のフラグは、w20bで代入。
		print '爆弾解体オルガ登場１ポリゴンデモ１開始'

		/* ソリダスとオルガの会話シーン */

		// デモ特有の変数代入
		eval($s:d_num = P021_01_p01)
		@デモモデル差し替え処理
		@デモ再生_P021_01_p01

	} else if(($w:p_story < d:ST:P031_01_P01フォーチュン戦終了１ポリゴンデモ１終了) && \
		($f:d021p01_爆弾解体オルガ登場２無線デモ１開始 == 0)) {
		print '爆弾解体オルガ登場２無線デモ１開始'

		/* プリスキン強制センド　オルガのことを教えてもらう */
		// デモ特有の変数代入
		eval($s:d_num = P021_02_r01)
		@サウンドマネージャーセット２
		@rt_P021_02_R01_爆弾解体オルガ登場２無線デモ１
		/* P021_02_r01終了 */
		/* この間に別のステージでストーリーフラグは進み、d:ST:P031_01_P01フォーチュン戦終了１ポリゴンデモ１終了
		より先になってからまたこのステージに戻ってくるので、次は以下の条件分岐に入ることになる */
		// ゲームから戻ってくる
	} else if($w:p_story == d:ST:P032_01_P01ファットマン登場１ポリゴンデモ１開始) {
		print '$w:p_story = ST:P032_01_P01ファットマン登場１ポリゴンデモ１開始'
		/* ファットマン登場　ぱんくちゃる */
		// デモ特有の変数代入
		eval($s:d_num = P032_01_p01)
		@デモモデル差し替え処理
		@デモ再生_P032_01_p01
	// ゲームから戻ってくる
	} else if($w:p_story == d:ST:P034_01_P01ファットマン死亡１ポリゴンデモ１開始) {
		print '$w:p_story = ST:P034_01_P01ファットマン死亡１ポリゴンデモ１開始'
		/* ファットマン戦終了 */
		// デモ特有の変数代入
		eval($s:d_num = P034_01_p01)
		@デモモデル差し替え処理
		@デモ再生_P034_01_p01
	// ゲームから戻ってくる
	} else if($w:p_story == d:ST:P036_01_P01忍者登場１ポリゴンデモ１開始) {
		print '$w:p_story = ST:P036_01_P01忍者登場１ポリゴンデモ１開始'
		/* 忍者登場　ここはまだヘリポートの上 */
		// デモ特有の変数代入
		eval($s:d_num = P036_01_p01)
		@デモモデル差し替え処理
		@デモ再生_P036_01_p01
	} else if(d:ST:P036_01_P01忍者登場１ポリゴンデモ１終了 <= $w:p_story && \
				$w:p_story < d:ST:P036_02_P02忍者登場２ポリゴンデモ２開始) {
		eval($w:p_story = d:ST:P036_02_P02忍者登場２ポリゴンデモ２開始)
		print '$w:p_story = ST:P036_02_P02忍者登場２ポリゴンデモ２開始'

		/* ヘリパッド下の通路での会話 */
		// デモ特有の変数代入
		eval($s:d_num = P036_02_p02)
		@デモモデル差し替え処理
		@デモ再生_P036_02_p02
	} else if($w:p_story < d:ST:P036_03_R01忍者登場３無線デモ１開始) {
		eval($w:p_story = d:ST:P036_03_R01忍者登場３無線デモ１開始)
		print '$w:p_story = ST:P036_03_R01忍者登場３無線デモ１開始'
		// ここで特別使う。
		@サウンドマネージャーセット
		/* 忍者との体内通信　協力者であることを告げられる */
		// デモ特有の変数代入
		eval($s:d_num = P036_03_r01)
		@rt_P036_03_R01忍者登場３無線デモ１
		/* P036_03_r01終了 */
	} else if(d:ST:P036_03_R01忍者登場３無線デモ１終了 <= $w:p_story && \
			$w:p_story < d:ST:P036_04_P03忍者登場４ポリゴンデモ３開始) {
		/* ！！！ 注意 ！！！ */
		/* 下は、名前はポリデモだが実際はムービーに変更された */
		/* その後、さらにポリデモに戻す事になりました。(脚注：松花） */
		eval($w:p_story = d:ST:P036_04_P03忍者登場４ポリゴンデモ３開始)
		print '$w:p_story = ST:P036_04_P03忍者登場４ポリゴンデモ３開始'
		/* エイムズはペースメーカーを使っていると忍者が語る　指向性マイクを使え */
		// デモ特有の変数代入
		eval($s:d_num = P036_04_p03) // 名前はポリデモだが実際はムービー
		/* ポリデモ再生 */
		eval($w:p_story = d:ST:P036_04_P03忍者登場４ポリゴンデモ３開始)
		load 'd036p03'
	} else if(d:ST:P036_04_P03忍者登場４ポリゴンデモ３終了 <= $w:p_story && \
					$w:p_story <= d:ST:P036_05_P04忍者登場５ポリゴンデモ４開始) {
		eval($w:p_story = d:ST:P036_05_P04忍者登場５ポリゴンデモ４開始)
		print '$w:p_story = ST:P036_05_P04忍者登場５ポリゴンデモ４開始'
		/* カード２とロシア兵の迷彩服を受け取る */
		// ここで特別使う。
		@サウンドマネージャーセット
		@サウンドマネージャー_mesg_1
		// デモ特有の変数代入
		eval($s:d_num = P036_05_p04)
		@デモモデル差し替え処理
		@デモ再生_P036_05_p04
//	} else if(d:ST:P036_05_P04忍者登場５ポリゴンデモ４終了 <= $w:p_story && \
//					$w:p_story <= d:ST:P036_06_P05忍者登場６ポリゴンデモ５開始) {
//		// 以下もロードの都合でムービーになった。
//		// ・・・が、その後再びポリデモとなった（脚注：松花）
//		eval($w:p_story = d:ST:P036_06_P05忍者登場６ポリゴンデモ５開始)
//		print '$w:p_story = ST:P036_06_P05忍者登場６ポリゴンデモ５開始'
//		/* 中央棟中心と外周部の、兵士の服装・武器の違いを見せる */
//		// デモ特有の変数代入
//		eval($s:d_num = P036_06_p05)
//		/* ポリデモ再生 */
//		/* P036_06_p05終了 */
//		eval($w:p_story = d:ST:P036_06_P05忍者登場６ポリゴンデモ５開始)
//		print '$w:p_story = ST:P036_06_P05忍者登場６ポリゴンデモ５開始'
//		eval($s:d_num = P036_06_p05)
//		@デモ再生_P036_06_p05
	} else if(d:ST:P036_06_P05忍者登場６ポリゴンデモ５終了 <= $w:p_story && \
					$w:p_story <= d:ST:P036_07_P06忍者登場７ポリゴンデモ６開始) {
		eval($w:p_story = d:ST:P036_07_P06忍者登場７ポリゴンデモ６開始)
		print '$w:p_story = ST:P036_07_P06忍者登場７ポリゴンデモ６開始'
		/* 網膜チェックのシークエンス */
		// デモ特有の変数代入
		eval($s:d_num = P036_07_p06)
		@デモモデル差し替え処理
		@デモ再生_P036_07_p06
	} else if(d:ST:P036_07_P06忍者登場７ポリゴンデモ６終了 <= $w:p_story && \
					$w:p_story < d:ST:P036_08_R02忍者登場８無線デモ２開始) {
		eval($w:p_story = d:ST:P036_08_R02忍者登場８無線デモ２開始)
		print '$w:p_story = ST:P036_08_R02忍者登場８無線デモ２開始'
		/* 忍者との体内通信　敵が核兵器を持っていることを知る */
		// デモ特有の変数代入
		eval($s:d_num = P036_08_r02)
		@サウンドマネージャーセット
		@サウンドマネージャー_mesg_1
		@rt_P036_08_R02忍者登場８無線デモ２
	} else if(d:ST:P036_09_M01忍者登場９ムービーデモ１終了 <= $w:p_story && \
					$w:p_story < d:ST:P036_10_R03忍者登場１０無線デモ３開始) {
		eval($w:p_story = d:ST:P036_10_R03忍者登場１０無線デモ３開始)
		print '$w:p_story = ST:P036_10_R03忍者登場１０無線デモ３開始'
		/* 忍者との体内通信　メタル開発がここで行われていることを知る */
		// デモ特有の変数代入
		eval($s:d_num = P036_10_r03)
		@rt_P036_10_R03忍者登場１０無線デモ３
	} else if(d:ST:P036_10_R03忍者登場１０無線デモ３終了 <= $w:p_story && \
					$w:p_story <= d:ST:P036_11_P07忍者登場１１ポリゴンデモ７開始) {
		/* ！！！注意！！！ */
		// 以下は名前はポリデモだが、ムービーに変更された（取り込み使用ステージはタンカー船倉）
		// その後、ポリデモへ再度変更されました。(脚注：松花)
		eval($w:t_story = 9999 )
		eval($w:p_story = d:ST:P036_11_P07忍者登場１１ポリゴンデモ７開始)
		print '$w:p_story = ST:P036_11_P07忍者登場１１ポリゴンデモ７開始'

		/* レイがぐるぐる回っている映像 */
		// デモ特有の変数代入
		eval($s:d_num = P036_11_p07)
		#if 0
			chara デバッグポーズ pause 'MOVIE_P036_11_p07' -p P036_11_p07終了
		#else
			/* ムービー再生 */
			/* P036_11_p07終了 */
			load 'd11t'
		#endif
	} else if(d:ST:P036_11_P07忍者登場１１ポリゴンデモ７終了 <= $w:p_story && \
					$w:p_story < d:ST:P036_12_P08忍者登場１２ポリゴンデモ８開始) {
		eval($w:p_story = d:ST:P036_12_P08忍者登場１２ポリゴンデモ８開始)
		print '$w:p_story = ST:P036_12_P08忍者登場１２ポリゴンデモ８開始'
		/* 携帯電話を手渡される */
		eval($w:アイテム数Ｒ[d:アイテム:携帯電話] = 1)
		// デモ特有の変数代入
		eval($s:d_num = P036_12_p08)
		@サウンドマネージャーセット
		@サウンドマネージャー_mesg_1
		@デモモデル差し替え処理
		@デモ再生_P036_12_p08
	} else if(d:ST:P036_12_P08忍者登場１２ポリゴンデモ８終了 <= $w:p_story && \
					$w:p_story < d:ST:P036_13_R04忍者登場１３無線デモ４開始) {
		eval($w:p_story = d:ST:P036_13_R04忍者登場１３無線デモ４開始)
		print '$w:p_story = ST:P036_13_R04忍者登場１３無線デモ４開始'
		/* 大佐強制センド　忍者のことを知っているか問いただす */
		// デモ特有の変数代入
		eval($s:d_num = P036_13_r04)
		@rt_P036_13_R04忍者登場１３無線デモ４
	}

#endif


// 以下、諸々セット
//-----------------------------------------------------------
	@常駐キャラ設定						// stdch.hで定義

	chara デモキャンセルチェック デモキャンセル \
		-p demo_cancel

	//----- 基本設定
	// 無線ではシネマスクリーン起動しない
	if(($s:d_num != P021_02_r01) || \
		($s:d_num != P036_03_r01) || \
		($s:d_num != P036_08_r02) || \
		($s:d_num != P036_10_r03) || \
		($s:d_num != P036_13_r04)){
		@シネマスクリーンセット
	}

	//----- ステージ
	if($s:d_num == P036_07_p06){
		// 網膜チェック時のw24bステージモデル
		@網膜センサー付近_w24bステージモデルセット
		@網膜センサー付近フォグ設定
	} else {
		@ヘリポートステージセット
		@ヘリポート以外のステージモデルセット
		@ハリアーセット
		@ノード端末設定
		@ドア設定
		@その他オブジェクト設定
		@ホロセット

		//----- フォグ、カメラ、ロード
		@海面設置
		@空設置
		@フォグ設定
	}

	// キムさん指定の爆弾セット
	if($s:d_num == P032_01_p01){
		@キムさん爆弾セット
	}

	// ファットマン死亡デモで使う。
	if($s:d_num == P034_01_p01) {
		@ファットマン滲み血セット
	}

	// リアル影を出すデモ
	if(($s:d_num == P032_01_p01) || \
		($s:d_num == P034_01_p01) || \
		($s:d_num == P036_01_p01)){
		@リアル影セット
	}
}

command マップ表示 -show ヘリポート




//=============================================================================
// プロシージャ
//=============================================================================

//=============================================================================
// 基本設定
//=============================================================================
// デモ再生関連のプロック
//-----------------------------------------------------------
// これはデバッグ用
proc restart_proc {
	restart
}

proc null {}

proc demo_cancel {
	command StreamStopAll
}

proc P021_02_r01終了 {
	eval($f:d021p01_爆弾解体オルガ登場２無線デモ１開始 = 1)
	// ゲームへ
	@ゲームステージへ戻る
	@mv_demo1_w20b_0
}


proc P036_03_r01終了 {
	eval($w:p_story = d:ST:P036_03_R01忍者登場３無線デモ１終了)
	#if 0
		restart
	#else
		load 'd036p03'
	#endif
}


