proc rto_タンカーカメラうんちく１:01  {
vox t:vc091601 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_タンカーカメラうんちく１__e:オタコン_000]
		//カメラの説明をしておこうか。
	}

	talk オタコン 標準 -m {
		[TO_タンカーカメラうんちく１__e:オタコン_001]
		//君が持ってるのは新型メタルギアの
		//写真を撮るために作った特別製の
		//デジタルカメラだ。
	}

@rt_うんちく＿否＿わからん系デフォルト 100
@rt_うんちく＿是＿詳しいな系デフォルト 50
	talk オタコン 標準 -m {
		[TO_タンカーカメラうんちく１__e:オタコン_002]
		//写真を撮るとその画像データはまず
		//カメラ本体に内蔵されたメモリーの中に
		//格納される。
	}

	talk オタコン 標準 -m {
		[TO_タンカーカメラうんちく１__e:オタコン_003]
		//そこで電子的改竄を防ぐための
		//色々な処理が自動的に行われるように
		//なってるんだ。
	}

@rt_うんちく＿否＿わからん系デフォルト 100
@rt_うんちく＿是＿詳しいな系デフォルト 50
	talk オタコン 標準 -m {
		[TO_タンカーカメラうんちく１__e:オタコン_004]
		//電子透かしを埋め込んだり特製の暗号を
		//かけたりね。だから万一転送途中で誰か
		//にデータをいじられてもすぐにわかる。
	}
	talk オタコン 標準 -m {
		[TO_タンカーカメラうんちく１__e:オタコン_004_1]
		//電子透かしを埋め込んだり特製の暗号を
		//かけたりね。だから万一転送途中で誰か
		//にデータをいじられてもすぐにわかる。
	}

	talk オタコン 標準 -m {
		[TO_タンカーカメラうんちく１__e:オタコン_005]
		//ただ、カメラの内蔵メモリーの容量には
		//限界があるんだ。
	}

	talk オタコン 標準 -m {
		[TO_タンカーカメラうんちく１__e:オタコン_006]
		//メモリーがいっぱいになったら、
		//いらない写真に上書きするといい。
	}
//dv
}//v
}//d

