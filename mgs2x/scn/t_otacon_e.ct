//続・追加ファイル達
proc rto_オルガ戦前:01  {
vox t:vc090101 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_オルガ戦前__e:オタコン_000]
		//船橋の外にいた兵士……何か気になるな。
		//調べておいた方がいい。船橋左舷の
		//水密扉から航海甲板に出られるはずだ。
	}
	talk オタコン 標準 -m {
		[TO_オルガ戦前__e:オタコン_000_1]
		//船橋の外にいた兵士……何か気になるな。
		//調べておいた方がいい。船橋左舷の
		//水密扉から航海甲板に出られるはずだ。
	}
	talk オタコン 標準 -m {
		[TO_オルガ戦前__e:オタコン_000_2]
		//船橋の外にいた兵士……何か気になるな。
		//調べておいた方がいい。船橋左舷の
		//水密扉から航海甲板に出られるはずだ。
	}
	talk オタコン 標準 -m {
		[TO_オルガ戦前__e:オタコン_001]
		//航海甲板に向かってくれ。
	}
//dv
}//v
}//d



proc rto_銃撃戦飛び出し撃ち１:01  {
vox t:vc090201 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_銃撃戦飛び出し撃ち１__e:オタコン_000]
		//敵も黙って君を船倉に入れる気は
		//ないみたいだ。
	}
	talk スネーク 標準 -m {
		[TO_銃撃戦飛び出し撃ち１__e:スネーク_001]
		//ああ。ここは戦うしかないようだ。
		//ビハインドからの飛び出し撃ちを
		//使ってみるか……。
	}
	talk オタコン 標準 -m {
		[TO_銃撃戦飛び出し撃ち１__e:オタコン_002]
		//そうだね。
	}
//dv
}//v
}//d

//二回目以降 t //e
proc rto_銃撃戦飛び出し撃ち２:01  {
vox t:vc090211 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_銃撃戦飛び出し撃ち２__e:オタコン_000]
		//飛び出し撃ちを活用すれば、遮蔽物に
		//隠れながら相手の隙をみて銃撃を加える
		//ことが出来るだろう。
	}
	talk オタコン 標準 -m {
		[TO_銃撃戦飛び出し撃ち２__e:オタコン_001]
		//やり方は、まず銃を装備してから
		//遮蔽物に張り付いてビハインドカメラに
		//する。
	}
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_銃撃戦飛び出し撃ち２__e:オタコン_002]
		//その状態から□ボタンを押せば
		//飛び出し撃ちができる。□ボタンを
		//離せば素早く遮蔽物の陰に戻る。
	}
	talk オタコン 標準 -m {
		[TO_銃撃戦飛び出し撃ち２__e:オタコン_002_1]
		//その状態から□ボタンを押せば
		//飛び出し撃ちができる。□ボタンを
		//離せば素早く遮蔽物の陰に戻る。
	}
	talk オタコン 標準 -m {
		[TO_銃撃戦飛び出し撃ち２__e:オタコン_003]
		//敵の弾幕が途切れる瞬間を
		//見極めて攻撃に転じるんだ。
	}
//dv
}//v
}//d

proc rto_タクティカルリロード１:01  {
vox t:vc090301 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_タクティカルリロード１__e:オタコン_000]
		//スネーク、撃ち合っている最中に弾が
		//切れたら大きな隙を相手に見せることに
		//なるんじゃないか？
	}
	talk オタコン 標準 -m {
		[TO_タクティカルリロード１__e:オタコン_000_1]
		//スネーク、撃ち合っている最中に弾が
		//切れたら大きな隙を相手に見せることに
		//なるんじゃないか？
	}
	talk スネーク 標準 -m {
		[TO_タクティカルリロード１__e:スネーク_001]
		//ああ。だがタクティカル・リロードを
		//使えばそんなことにはならん。
	}
@rt_つっこまれ＿是＿なんで知ってるんだ系デフォルト 100
	talk オタコン 標準 -m {
		[TO_タクティカルリロード１__e:オタコン_002]
		//敵の目の前で弾切れを起こす危険を
		//回避するため、弾倉が空になる前に
		//あらかじめ弾倉を交換しておく戦術だね。
	}
	talk オタコン 標準 -m {
		[TO_タクティカルリロード１__e:オタコン_002_1]
		//敵の目の前で弾切れを起こす危険を
		//回避するため、弾倉が空になる前に
		//あらかじめ弾倉を交換しておく戦術だね。
	}
	talk スネーク 標準 -m {
		[TO_タクティカルリロード１__e:スネーク_003]
		//そうだ。
	}
//dv
}//v
}//d

//二回目以降 t //e
proc rto_タクティカルリロード２:01  {
vox d:_vc090311 {
@rt_うなづきデフォルト
