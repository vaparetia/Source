//信管ヤバイよ！ＸＸＸＸＸＸＸｘｘ
proc rto_グレネード:01  {
vox t:vc091101 {
@rt_うなづきデフォルト
	talk オタコン 標準 -m {
		[TO_グレネード__e:オタコン_000]
		//グレネードを装備してるね。
		//投擲用の対人破片手榴弾だ。
		//爆風と破片で敵を倒すことが出来る。
	}
	talk オタコン 標準 -m {
		[TO_グレネード__e:オタコン_000_1]
		//グレネードを装備してるね。
		//投擲用の対人破片手榴弾だ。
		//爆風と破片で敵を倒すことが出来る。
	}
	talk オタコン 標準 -m {
		[TO_グレネード__e:オタコン_000_2]
		//グレネードを装備してるね。
		//投擲用の対人破片手榴弾だ。
		//爆風と破片で敵を倒すことが出来る。
	}
	talk オタコン 標準 -m {
		[TO_グレネード__e:オタコン_001]
		//□ボタンを押すと信管を抜いて構え、
		//□ボタンを離すと投げる。□ボタンを
		//押した時の強さで投擲距離が変わるよ。
	}
	talk オタコン 標準 -m {
		[TO_グレネード__e:オタコン_001_1]
		//□ボタンを押すと信管を抜いて構え、
		//□ボタンを離すと投げる。□ボタンを
		//押した時の強さで投擲距離が変わるよ。
	}
	talk オタコン 標準 -m {
		[TO_グレネード__e:オタコン_001_2]
		//□ボタンを押すと信管を抜いて構え、
		//□ボタンを離すと投げる。□ボタンを
		//押した時の強さで投擲距離が変わるよ。
	}
	talk オタコン 標準 -m {
		[TO_グレネード__e:オタコン_002]
		//構えてから爆発するまで約５秒ある。
		//爆発するまでの時間と投げる距離が
		//変えられる点をうまく使いこなすんだ。
	}
	talk オタコン 標準 -m {
		[TO_グレネード__e:オタコン_002_1]
		//構えてから爆発するまで約５秒ある。
		//爆発するまでの時間と投げる距離が
		//変えられる点をうまく使いこなすんだ。
	}
//dv
}//v
}//d


