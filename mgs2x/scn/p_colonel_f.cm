//	Action button.
//<ページ数変更>
大佐_000_1: {
&~Qa peut &^etre utile.
}
//	<<<ENGLISH>>>
//	It should come in useful.

/*ライデン、腰くらいの高さのものは
△ボタンを押せば上に登ることが
出来る。うまく使うんだ。
*/
//dv}//v
}//d

//エルード h //e
//＊ムービー t //e
resource PC_エルード１の１__f {
//vox t:vc260341 {
大佐_000: {
Si tu vois un garde-fou qui t'arrive
&`a peu pr&`es &`a la taille, appuie sur
la touche Action.
}
//	<<<ENGLISH>>>
//	If you see an approximately
