*/
//dv}//v
}//d
resource PC_網膜センサー＿羽交絞めヒント１__f {
//vox t:vc261711 {
ライデン_000: {
Et comment ?
}
//	<<<ENGLISH>>>
//	How do I do that?

/*どうすればいい？*/
//dv}//v
}//d
resource PC_網膜センサー＿羽交絞めヒント２__f {
//vox t:vc261721 {
大佐_000: {
Coince une sentinelle ennemie en
l'&'etranglant et am&`ene-la jusqu'au scanner.
}
//	<<<ENGLISH>>>
//	Put an enemy sentry in a chokehold,
//	then drag him over to the retinal
//	scanner.

/*敵兵士を首絞めで捕まえて、そのまま
網膜センサーのところまで引きずって
いくんだ。
*/
大佐_001: {
Sans avoir s&'electionn&'e d'arme,
}
//	<<<ENGLISH>>>
//	Come up behind an enemy
//	without any weapons selected,
//<ページ数変更>
大佐_001_1: {
place-toi derri&`ere un ennemi et appuie
sur la touche Arme pour l'&'etrangler.
}
//	<<<ENGLISH>>>
//	then press the Weapon button
//	to put him in a chokehold.

/*首絞めをかけるには、敵の後ろから
近づいて武器を装備せずに□ボタンを
押せばいい。
*/
//dv}//v
}//d
resource PC_網膜センサー＿羽交絞めヒント３__f {
//vox t:vc261731 {
大佐_000: {
Et d&'etruis la radio de l'ennemi,
avant de l'amener jusqu'au scanner,
}
//	<<<ENGLISH>>>
//	If you preemptively destroy
//	the enemy's radio before you
//	take him to the scanner＃−
//<ページ数変更>
大佐_000_1: {
afin de l'emp&^echer de demander de l'aide
au cas o&`u il r&'eussirait &`a s'&'echapper.
}
//	<<<ENGLISH>>>
//	you can prevent him from calling
//	for help in case he manages to
//	get away.

/*予め敵の無線機を壊しておけばセンサー
まで連れて行く途中で逃げられても増援
