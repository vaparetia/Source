//ソリダス戦中 愛国説教 h //e
resource PC_ソリダス戦中＿愛国説教__f {
//vox t:vc266861 {
大佐_000: {
Raiden, il faut que tu battes Solidus !
C'est ton ultime devoir.
}
//	<<<ENGLISH>>>
//	Raiden, you have to beat Solidus!
//	This is your last duty!

/*ライデン、ソリダスと戦え！
それが君の最後の役割だ！
*/
ライデン_001: {
Nous ne sommes pas les simples pions
d'un jeu de simulation !
}
//	<<<ENGLISH>>>
//	We're not just pawns in some
//	simulation game, you know!

/*俺達はシミレーション・ゲームの
駒じゃない！
*/
ローズ_002: {
Si ! Vous n'&^etes que des armes. Comme
des avions de chasse ou des tanks !
}
//	<<<ENGLISH>>>
//	Yes, you are. You're nothing but
//	mere weapons. No different from
//	fighter jets or tanks.

/*いいえ。あなた達はただの兵器。
戦闘機や戦車とかわりないのよ。
*/
ライデン_003: {
Qu'est-ce que...
}
//	<<<ENGLISH(2)>>>
//	What the --

/*なんだと？*/
大佐_004: {
Le vieux mod&`ele d&'etruit
il y a quatre ans &'etait le 'REX'...
}
//	<<<ENGLISH>>>
//	The old model destroyed
//	four years ago was "REX"...

/*４年前に破壊された旧型は『ＲＥＸ』……
*/
ローズ_005: {
Le nouveau mod&`ele
amphibie s'appelle 'RAY'...
}
//	<<<ENGLISH>>>
//	The new amphibious
//	model is "RAY"...

/*新型の水陸両用は『ＲＡＹ』……
*/
大佐_006: {
Ces deux noms sont les noms de
code utilis&'es par les forces
}
//	<<<ENGLISH>>>
//	Both of these are the same as
//	the code names used by the U.S.
//	Armed Forces＃−
//<ページ数変更>
大佐_006_1: {
arm&'ees am&'ericaines pour d&'esigner
les avions japonais, pendant la Seconde
guerre mondiale.
}
//	<<<ENGLISH>>>
//	to refer to Japanese war
//	planes during World War 2.

/*どちらも第二次大戦中、米軍が日本軍の
軍用機につけたコードネーム。
*/
ローズ_007: {
Et ton nom de code, 'Raiden', est lui aussi
celui qu'avait donn&'e la Marine japonaise &`a
un de ses intercepteurs. 
}
//	<<<ENGLISH>>>
//	Your code name "Raiden" too, comes
//	from the Japanese navy's name for
//	one of its interceptors...

/*あなたのコードネーム『ライデン』も
日本海軍の局地戦闘機『雷電』から
来ている……。
*/
ライデン_008: {
La ferme !
Je ne suis pas une arme !
}
//	<<<ENGLISH>>>
//	Stop it!
//	I'm not a weapon!!

/*ふざけるな！俺は兵器じゃない！！*/
ローズ_009: {
Vraiment ? Tu sais quel nom de code
a &'et&'e attribu&'e au chasseur japonais
'Raiden' par l'arm&'ee am&'ericaine ?
}
//	<<<ENGLISH(2)>>>
//	Oh really? Do you know the code
//	name the U.S. Armed Forces used
//	for the Japanese fighter "Raiden"?

/*そうかしら？
『雷電』に米軍がつけたコードネームが
なんだか知ってる？
*/
大佐_010: {
'Jack'
}
//	<<<ENGLISH(2)>>>
//	It was "Jack."

/*ジャックだよ。*/
大佐_011: {
Vous &^etes tous les deux des armes
qu'on utilise et qu'on jette !
}
//	<<<ENGLISH>>>
//	Both of you are just weapons
//	to be used and thrown away.

/*貴様らは利用されて捨てられる
兵器なのだ。
*/
ローズ_012: {
De simples armes, des pions sur un
&'echiquier... C'est exactement ce
que tu as dit tout &`a l'heure.
}
//	<<<ENGLISH>>>
//	Just weapons to be used on the
//	battlefield. Just pawns in a game
//	-- exactly as you said.

/*兵器として戦場で利用される。
まさにゲームの駒。
*/
大佐_013: {
Et les armes n'ont pas le droit de penser !
}
