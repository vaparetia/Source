//銃は撃つと音がする注意 h //e
resource PC_銃入手注意__f {
//vox t:vc262651 {
大佐_000: {
Je vois que tu as acquis un pistolet !
}
//	<<<ENGLISH>>>
//	I see you've acquired a gun.

/*銃を手に入れたな。*/
ライデン_001: {
Pliskin me l'a donn&'e.
}
//	<<<ENGLISH>>>
//	Pliskin gave it to me.

/*ああ。プリスキンがくれた。*/
