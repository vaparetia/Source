*/
大佐_004: {
Or, l'infiltration est l'art
de se rendre invisible.
}
//	<<<ENGLISH>>>
//	Infiltration is the art of making
//	your presence invisible.
//<ページ数変更>
大佐_004_1: {
Essaies d'&'eviter d'avoir &`a utiliser
ton flingue. Il faut &'eviter le combat,
}
