//Ｏ２について h //e
resource PC_水中＿Ｏ２__f {
//vox t:vc260181 {
大佐_000: {
Sous l'eau, tu verras une jauge d'O2
sous ta jauge de LIFE.
}
//	<<<ENGLISH>>>
//	The O2 Gauge will appear under your
//	Life Gauge while you're underwater.
//<ページ数変更>
大佐_000_1: {
Elle correspond &`a la quantit&'e d'air qui
te donne chaque inspiration profonde
}
//	<<<ENGLISH>>>
//	The gauge corresponds to the
//	amount of air you can hold
