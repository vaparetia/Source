//	If someone does get suspicious,
//	switch the directional microphone
//	for the AK immediately.
//<ページ数変更>
大佐_002_1: {
Si tu te fais prendre la main dans le sac,
tu es cuit !
}
//	<<<ENGLISH>>>
//	It's all over if you're caught
//	in the act.

/*万一、怪しまれたらすぐに武器を
ＡＫに持ち変えろ。見つかったら
終わりだぞ。いいな。
*/
//dv}//v
}//d

//見つかると即ゲームオーバー h //e
resource PC_人質＿見つかるな１__f {
//vox t:vc261901 {
大佐_000: {
Raiden, Surtout, reste cach&'e
dans la salle de conf&'erences.
}
//	<<<ENGLISH>>>
//	Raiden, retain your cover at all
//	costs inside that conference hall.
//<ページ数変更>
大佐_000_1: {
Il n'y a qu'une seule voie pour entrer
et sortir de cette salle.
}
//	<<<ENGLISH>>>
//	There's only one way in
//	and out of the area.

/*ライデン、その集会場では絶対に
見つかるなよ。そのエリアには
出入口が一つしかない。
*/
//dv}//v
}//d
resource PC_人質＿見つかるな２__f {
//vox t:vc261911 {
