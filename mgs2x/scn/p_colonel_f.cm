*/
大佐_002: {
On &'etudie les cons&'equences &`a long
terme. Pour l'instant, on est dans le flou.
}
//	<<<ENGLISH>>>
//	What sort of outcome this will
//	lead to is still currently under
//	review and is yet unclear.

/*それがどのような結果を生むのかは
いまだ調査中で結果は出ていない。
*/
大佐_003: {
Cela prouve que m&^eme si l'on n'est plus
oblig&'e de nettoyer les mar&'ees noires,
}
//	<<<ENGLISH>>>
//	It just goes to show that finishing
//	the cleanup of ocean oil spills does
//	not mean that＃−
//<ページ数変更>
大佐_003_1: {
les probl&`emes environnementaux n'ont
pas disparu...
}
//	<<<ENGLISH>>>
//	environmental restoration
//	efforts end there as well.

/*海上の原油を処理し終わったとしても
それで環境回復が終了するわけでは
ないということだ。
*/
//dv}//v
}//d


//Ｆ脚倉庫 d //e
//武器取得後 h //e
resource PC_Ｆ脚武器入手後__f {
//vox t:vc265241 {
大佐_000: {
Raiden, tu as trouv&'e une arme, on dirait.
}
//	<<<ENGLISH>>>
