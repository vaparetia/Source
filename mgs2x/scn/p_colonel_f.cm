*/
//dv}//v
}//d
//しゃがんで流血回復ムービー t //e
resource PC_流血説明４__f {
//vox t:vc264711 {
大佐_000: {
Tu peux &'egalement t'accroupir ou ramper
et rester immobile pendant un petit
moment.
}
//	<<<ENGLISH>>>
//	You can also go into a crouch
//	or crawl and stay completely
//	still for a while.

/*しゃがむかホフクして
しばらくじっとしている事だ。
