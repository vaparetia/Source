//	<<<ENGLISH>>>
//	...

/*……。*/
大佐_003: {
Raiden, concentre-toi sur ta mission.
Pour l'instant, fais tout pour lib&'erer
le Pr&'esident.
}
//	<<<ENGLISH>>>
//	Raiden, focus on your duties.
//	For right now concentrate on
//	rescuing the President.
//<ページ数変更>
大佐_003_1: {
Va au premier &'etage du noyau de
la Cell 2.
}
//	<<<ENGLISH>>>
//	Head for the first floor
//	of Shell 2's core.

/*ライデン、任務に集中しろ。
今は大統領救出に集中するんだ。
シェル２中央棟の１Ｆに向かえ。
*/
//dv}//v
}//d

//ブラックケースについて h //e
resource PC_エイムズ死後＿ブラックケース１__f {
//vox t:vc266041 {
ライデン_000: {
Tu crois qu'Ames a dit la v&'erit&'e
au sujet de la mallette noire ?
}
//	<<<ENGLISH>>>
//	Do you think Ames was telling
//	the truth about the football?

/*エイムズの言っていたブラックケースの
話……本当なんだろうか。
*/
大佐_001: {
Rosemary !
}
//	<<<ENGLISH(2)>>>
//	Rosemary.

/*ローズ君。*/
ローズ_002: {
Entendu. Jack, je vais
me renseigner !
}
//	<<<ENGLISH>>>
//	Roger that. Jack, I'll
//	look into it for you.

/*わかりました。
ジャック、調べてみるから。
*/
//dv}//v
}//d
//ブラックケース しばらくしてから h //e
resource PC_エイムズ死後＿ブラックケース２__f {
//vox t:vc266051 {
大佐_000: {
Raiden, Rosemary a fini
ses recherches.
}
//	<<<ENGLISH>>>
//	Raiden, Rosemary has
//	completed her search.

/*ライデン、ローズ君の調べがついた
そうだ。
*/
//dv}//v
}//d
resource PC_エイムズ死後＿ブラックケース３__f {
//vox t:vc266061 {
ローズ_000: {
Jack, j'ai du nouveau sur la mallette
utilis&'ee pour d&'everrouiller le code
nucl&'eaire...
}
//	<<<ENGLISH>>>
//	Jack, I found data on the
//	briefcase used to unlock
//	the nuclear launch codes.

/*ジャック、核起爆暗号を解除する
ブラックケースのデータを見つけたわ。
*/
ローズ_001: {
C'est un syst&`eme int&'egr&'e dont
la cl&'e est constitu&'ee par l'ADN
}
//	<<<ENGLISH>>>
//	It appears to be a fail-safe
//	system using the President's
//	DNA base order＃−
//<ページ数変更>
ローズ_001_1: {
et les donn&'ees physiologiques
du Pr&'esident.
}
//	<<<ENGLISH>>>
//	and input of his physiological
//	data as its key.

/*大統領のＤＮＡを取り出して、その特定
部分の塩基配列と入力時の生体データ
から鍵を生成する認証システムらしいわ。
*/
ローズ_002: {
Le verrouillage semble
impossible &`a casser.
}
//	<<<ENGLISH>>>
//	The lock is said to
//	be impenetrable. 

/*そのプロテクトを破ることは不可能って
評価されてる。
*/
ライデン_003: {
Par cons&'equent, le Pr&'esident est le
seul &`a pouvoir saisir le mot de passe
nucl&'eaire ?
}
//	<<<ENGLISH>>>
//	In other words, the President
//	himself is the only one who
//	can enter the password?

/*つまり大統領本人でなければコードを
入力できない？
*/
ローズ_004: {
Exact. Et comme l'a dit Ames,
}
//	<<<ENGLISH>>>
//	Right. On top of that,
//	as Ames mentioned before,
//<ページ数変更>
ローズ_004_1: {
le mot de passe est invalid&'e d&`es que
les ondes c&'er&'ebrales, les battements
de coeur du Pr&'esident, etc.,
}
//	<<<ENGLISH>>>
//	the password becomes invalid
//	when the President's brain
//	waves, heartbeat, etc. are
//<ページ数変更>
ローズ_004_2: {
sortent des limites normales.
}
//	<<<ENGLISH>>>
//	not within normal limits.

/*ええ。その上、エイムズさんの言う通り、
大統領の脳波・心拍数等が異常な状態
での入力は無効と判定されるようね。
*/
ライデン_005: {
Cela veut donc dire qu'il a saisi
le code de son plein gr&'e.
}
//	<<<ENGLISH>>>
//	So the President entered that
//	code by his own free will after
//	all.
//<ページ数変更>
ライデン_005_1: {
Mais pourquoi le Pr&'esident des
Etats-Unis aiderait-il des terroristes ?
}
//	<<<ENGLISH>>>
//	But why would the U.S. President
//	lend a hand to terrorists?

/*やはり大統領が自分の意志でコードを
入力したということか。だがなぜ合衆国
大統領がテロリストに手を貸す？
*/
ローズ_006: {
Comment veux-tu que je le sache !?
}
//	<<<ENGLISH>>>
//	How should I...I don't have
//	information like that.

/*そんなの……
記録にあるわけないじゃない。
*/
ライデン_007: {
Bien s&^ur...
}
//	<<<ENGLISH>>>
//	...Yeah, I guess you wouldn't...


/*……それはそうだな……。*/
ローズ_008: {
Il semble &'egalement vrai que le code
doive &^etre confirm&'e apr&`es un
certain laps de temps.
}
//	<<<ENGLISH>>>
//	Also, it seems that the need to
//	reconfirm the code after a set
//	amount of time is true.

/*あと、一定時間ごとにコードの再確認が
されるってのも本当みたい。
*/
ライデン_009: {
Ce qui signifie que le Pr&'esident est
en s&^uret&'e ?
}
//	<<<ENGLISH>>>
//	Meaning that the President
//	is safe...right?
//<ページ数変更>
ライデン_009_1: {
Et que penses-tu de cette mallette
noire servant &`a activer le nouveau
mod&`ele de Metal Gear ?
}
//	<<<ENGLISH>>>
//	How about the story of the black
//	case also serving as the launch
//	key to a new model of Metal Gear?

/*つまりそれまで大統領は無事……か。
ブラックケースが新型メタルギア起動の
鍵も兼ねているって言う話は？
*/
ローズ_010: {
Ce n'&'etait pas dans les dossiers...
}
//	<<<ENGLISH>>>
//	That wasn't in the records.

/*それは記録になかった。*/
ライデン_011: {
Zut !
}
//	<<<ENGLISH(2)>>>
//	Hmph.

/*うぅむ。*/
//dv}//v
}//d
resource PC_エイムズ死後＿ブラックケース４__f {
//vox t:vc266071 {
大佐_000: {
Cette histoire de nouveau Metal Gear
mise &`a part,
}
//	<<<ENGLISH>>>
//	Stories of a new Metal
//	Gear model aside,
//<ページ数変更>
大佐_000_1: {
il est certain qu'ils ont fini de
saisir le code
}
//	<<<ENGLISH>>>
//	it is certain that they have
//	finished inputting the code...
//<ページ数変更>
大佐_000_2: {
et qu'ils essaient de tirer un
ogive nucl&'eaire...
}
//	<<<ENGLISH>>>
//	and are trying to launch
//	the nuclear warhead.

/*ライデン、新型メタルギアの話は
ともかく、奴等がコード入力を終了し、
核を撃とうとしていることは確かだ。
*/
大佐_001: {
Trouve le Pr&'esident et d&'ecouvre
la v&'erit&'e. D&'ep&^eche-toi.
}
//	<<<ENGLISH>>>
//	Meet with the President and
//	ascertain the truth. Hurry.
//<ページ数変更>
大佐_001_1: {
Il faut le rencontrer tant qu'il
est en vie...
}
//	<<<ENGLISH>>>
//	You must meet with him
//	while he is still alive.

/*大統領に会って事態を確かめろ。急げ。
彼が生かされているうちに接触するんだ。
*/
//dv}//v
}//d

//テロボススネーク h //e
resource PC_エイムズ死後＿テロボススネーク__f {
//vox t:vc266081 {
ライデン_000: {
Colonel, j'ai vu le chef des
terroristes. Est-ce Solid Snake ?
}
//	<<<ENGLISH>>>
//	Colonel, I saw the terrorist
//	leader. Is that Solid Snake?

/*大佐、テロリストのリーダーの姿を見た。
あれがソリッド・スネークなのか？
*/
大佐_001: {
Oui, c'est bien le terroriste qui a
coul&'e ce tanker, il y a deux ans !
}
//	<<<ENGLISH>>>
//	Yes. He's the terrorist who
//	sunk the tanker two years ago.

/*そうだ。
２年前にこの地でタンカーを沈めた
テロリストだ。
*/
ライデン_002: {
...
}
//	<<<ENGLISH>>>
//	...

/*……。*/
大佐_003: {
Raiden, tu le prends vraiment pour
un h&'eros ? Tu l'as entendu, non ?
}
//	<<<ENGLISH>>>
//	Raiden, do you think he's
//	some kind of hero? You
//	heard him, right?

/*ライデン、奴のことを英雄だと
思っているのか？奴が話しているのを
聞いただろう？
*/
大佐_004: {
Solid Snake est un terroriste. 
Il faut que tu le combattes.
Tu comprends ?
}
//	<<<ENGLISH>>>
//	Solid Snake is a terrorist.
//	You must fight him. Do you
//	understand?

/*ソリッド・スネークはテロリストだ。
君は奴と戦わねばならん。いいな。
*/
//dv}//v
}//d

//大統領について h //e
resource PC_エイムズ死後＿大統領__f {
//vox t:vc266091 {
大佐_000: {
Raiden, lib&`ere le Pr&'esident. Va au
premier &'etage du noyau de la Shell 2.
}
//	<<<ENGLISH>>>
//	Raiden, rescue the President.
//	Head for the first floor of the
//	Shell 2 Core.

/*ライデン、大統領を救出するんだ。
シェル２中央棟の１Ｆに向かえ。
*/
ライデン_001: {
Colonel, le Pr&'esident travaille-t-il
avec eux ?
}
//	<<<ENGLISH>>>
//	Colonel, is the President
//	one of them?
//<ページ数変更>
ライデン_001_1: {
Ames a dit qu'il avait saisi le code
nucl&'eaire de son plein gr&'e.
}
//	<<<ENGLISH>>>
//	Ames said that the President
//	entered the code with his own
//	free will...

/*大佐、大統領は奴等の仲間なんじゃ
ないか？エイムズは大統領が自分で
核発射のコード入力をしたと……。
*/
大佐_002: {
Mais tu sais aussi qu'ils veulent se
d&'ebarrasser du Pr&'esident, non ?
}
//	<<<ENGLISH>>>
//	But you heard how they are planning
//	to get rid of the President, right?

/*だが奴等が大統領を始末しようと
している話も聞いただろう？
*/
ライデン_003: {
Oui...
}
//	<<<ENGLISH>>>
//	Yeah...

/*ああ……。*/
ローズ_004: {
Ils vont chacun de leur
c&^ot&'e, alors ?
}
//	<<<ENGLISH>>>
//	They are going their
//	separate ways?

/*仲間割れ？
*/
大佐_005: {
Non. Le Pr&'esident n'est pas
n&'ecessairement un fardeau,
du point de vue des terroristes.
}
//	<<<ENGLISH>>>
//	No. First off, the President is
//	not necessarily extra baggage
//	for the terrorists.

/*いや、そもそも大統領がテロリストに
荷担していたと決まったわけではない。
*/
ライデン_006: {
...
}
//	<<<ENGLISH>>>
//	...

/*……。*/
大佐_007: {
Si tu n'en es pas s&^ur, tu devrais leur
parler lors de ta rencontre avec le
Pr&'esident.
}
//	<<<ENGLISH>>>
//	If you have your doubts you should
//	address them when you meet him.

/*疑問なら彼に直接接触して話を聞け。
*/
ライデン_008: {
Compris....
}
//	<<<ENGLISH(2)>>>
//	Roger that...

/*了解……。*/
//dv}//v
}//d

//ＯＵＴＥＲ　ＨＥＡＶＥＮについて h //e
resource PC_エイムズ死後＿アウターヘブン__f {
//vox t:vc266101 {
ライデン_000: {
Colonel, le 'Outer Heaven' dont
parlait Snake...
}
//	<<<ENGLISH>>>
//	Colonel, the "Outer Heaven"
//	that Snake mentioned...

/*大佐、スネークが言っていた
