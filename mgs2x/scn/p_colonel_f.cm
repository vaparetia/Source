//★P034_01_P01ファットマン死亡１ポリゴンデモ１終了＜フラグ＜P035_01_R01ファットマン爆弾解体終了１無線デモ１開始 d //e
//ファットマン最後の爆弾 h //e
//一回目のみ t //e
resource PC_ファットマン戦後＿最終爆弾１__f {
//vox t:vc263161 {
ライデン_000: {
Colonel, o&`u est cette bombe ?
}
//	<<<ENGLISH>>>
//	Colonel, where's that bomb?

/*大佐、爆弾はどこにある？*/
大佐_001: {
Nous n'en savons rien. Fouille la zone !
}
//	<<<ENGLISH>>>
//	We have no information on that.
//	Sweep the area.

/*わからん、とにかく探すしかない。
*/
ローズ_002: {
D&'ep&^eche-toi, Jack !
}
//	<<<ENGLISH(2)>>>
//	Hurry, Jack!

/*急いで、ジャック！*/
//dv}//v
}//d
resource PC_ファットマン戦後＿最終爆弾２__f {
//vox t:vc263171 {
大佐_000: {
La bombe doit se trouver quelque part sur
l'h&'eliport. Fais tout ce qui est en ton
pouvoir pour la trouver !
}
//	<<<ENGLISH>>>
//	The bomb has to be somewhere
//	on the heliport. Use whatever
//	means necessary to locate it.

/*爆弾は必ずヘリポートのどこかに
あるはずだ。なんとかして探し出すんだ。
*/
//dv}//v
}//d
//最終爆弾ヒント h //e
resource PC_ファットマン戦後＿最終爆弾ヒント１__f {
//vox t:vc263181 {
大佐_000: {
Raiden, tu as trouv&'e la bombe ?
}
//	<<<ENGLISH>>>
//	Raiden, have you located
//	the bomb yet?

/*ライデン、爆弾は見つかったか？
*/
ライデン_001: {
Non, pas encore...
}
//	<<<ENGLISH>>>
//	No, not yet...

/*いや、まだだ……。*/
ローズ_002: {
Grouille-toi, Jack !
Il nous reste peu de temps !
}
//	<<<ENGLISH>>>
//	Hurry, Jack! We don't
//	have a lot of time left!

/*急いで、ジャック！時間がないわ！
*/
//dv}//v
}//d
//最終爆弾ヒント h //e
resource PC_ファットマン戦後＿最終爆弾ヒント２__f {
//vox t:vc263191 {
大佐_000: {
Il n'a s&^urement pas eu le temps
de trouver une bonne cachette.
}
//	<<<ENGLISH>>>
//	He wouldn't have had the time to
//	find a good hiding place; it must
//	be somewhere near him.
//<ページ数変更>
大佐_000_1: {
Elle doit &^etre pr&`es de lui. Cherche !
}
//	<<<ENGLISH>>>
//	Take a closer look.

/*凝った場所にしかける時間があったとは
思えん。おそらく奴の近くだ。
よく探してみるんだ。
*/
//dv}//v
}//d

//最終爆弾ズバリ h //e
resource PC_ファットマン戦後＿最終爆弾ズバリ__f {
//vox t:vc263201 {
大佐_000: {
Raiden, la bombe ?
}
//	<<<ENGLISH>>>
//	Raiden, the bomb?

/*ライデン、爆弾は？*/
ライデン_001: {
Toujours rien...
}
//	<<<ENGLISH>>>
//	Nothing yet...

/*まだだ……。*/
大佐_002: {
O&`u est cette fichue bombe ?
Le temps presse...
}
//	<<<ENGLISH>>>
//	Where is that damned thing...
//	we're running out of time.

/*一体どこに……もう時間がないぞ。
*/
ローズ_003: {
Tu as regard&'e sous le cadavre
de Fatman ?
}
//	<<<ENGLISH>>>
//	Have you checked under
//	Fatman's body?

/*ファットマンの体の下は？
*/
ライデン_004: {
Quoi ? Bien s&^ur que non !
Elle n'y est pas !
}
//	<<<ENGLISH>>>
//	What? Of course not.
//	It can't be there.

/*なんだって？
そんなわけないだろ。
*/
ローズ_005: {
Qu'est-ce que tu en sais ?
}
//	<<<ENGLISH>>>
//	You don't know that.

/*わからないじゃない。*/
ライデン_006: {
Tr&`es bien ! Qu'est-ce qui prouve
qu'elle est l&`a-bas ?
}
//	<<<ENGLISH>>>
//	OK, what evidence do you
//	have that it's there?

/*根拠は？
*/
ローズ_007: {
C'&'etait juste une supposition !
}
//	<<<ENGLISH>>>
//	Just a hunch, all right?

/*ないけど。*/
ライデン_008: {
Ecoute, Rose... Je sais ce que
je fais et ma vie est en jeu.
}
//	<<<ENGLISH>>>
//	Look Rose -- I know what
//	I'm doing, and this is my
//	life on the line.
//<ページ数変更>
ライデン_008_1: {
Toi, tu n'as aucune exp&'erience
de ce genre de travail, alors...
}
//	<<<ENGLISH>>>
//	You don't have any experience
//	in this type of work, so ju...

/*……ふぅ……ローズ……。
素人は黙っててくれ。
こっちは命がかかってるんだ。
*/
ローズ_009: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
大佐_010: {
Tu devrais &'ecouter les bons conseils qu'on
te donne, Raiden. Si Rose avait raison ?
}
//	<<<ENGLISH>>>
//	Raiden, don't turn down a good
//	suggestion when you hear one.
//	Check it out.

/*ライデン、そう言わずに
とりあえず調べてみたらどうだ。
*/
//dv}//v
}//d


//★P035_01_R01ファットマン爆弾解体終了１無線デモ１終了＜フラグ＜P036_01_P01忍者登場１ポリゴンデモ１開始 d //e
//ヘリポートから下りろ h //e
resource PC_忍者登場前＿ヘリポート__f {
//vox t:vc263211 {
大佐_000: {
Raiden, revenons-en au sauvetage
du Pr&'esident.
}
//	<<<ENGLISH>>>
//	Raiden, let's get back to the
//	task of rescuing the President.
//<ページ数変更>
大佐_000_1: {
Va dans le noyau de la Shell 1
et inspecte la zone.
}
//	<<<ENGLISH>>>
//	Head to the core of Shell 1
//	and investigate the area.

/*ライデン、大統領救出任務に戻れ。
まだ調べていないシェル１中央棟に
向かうんだ。
*/
//dv}//v
}//d

//ローズに爆弾位置を教えてもらった場合 h //e
resource PC_忍者登場前＿ローズ助けられ__f {
//vox t:vc263221 {
ローズ_000: {
Jack ?
}
//	<<<ENGLISH(2)>>>
//	Jack?

/*ジャック？*/
ライデン_001: {
... Quoi ?
}
//	<<<ENGLISH>>>
//	-- what?

/*……なんだ？*/
ローズ_002: {
Ah !! Tu sais tr&`es bien &`a quoi je pense !
}
//	<<<ENGLISH>>>
//	You know what I'm talking about.

/*またとぼけて。*/
ライデン_003: {
D'accord, d'accord ! La bombe &'etait bien
o&`u tu croyais. Tu avais raison et tu m'as
sauv&'e la vie !
}
//	<<<ENGLISH>>>
//	All right, all right. The bomb was
//	where you guessed it would be. You
//	were right, and you saved my butt!

/*……わかったよ。確かに爆弾は君の
言った場所に仕掛けてあった。君が
正しかった。君のおかげで助かった！
*/
ローズ_004: {
Si tu le reconnais, c'est l'essentiel...
}
//	<<<ENGLISH>>>
//	As long as you realize that.

/*わかればよろしい。*/
ライデン_005: {
J'ai &'et&'e dr&^olement surpris...
Je ne m'attendais pas &`a la
trouver &`a cet endroit...
}
//	<<<ENGLISH>>>
//	I was pretty surprised though.
//	I never expected to find it
//	where I did...

/*しかし意外だったよ。
本当に君の言った通りだったとは……。
*/
ローズ_006: {
Hum, tu penses que je n'ai rien
dans la t&^ete, hein ?
}
//	<<<ENGLISH>>>
//	Hm, you must think I'm
//	pretty clueless, huh?

/*ふーん。
それ、私は役に立たないって思って
たってこと？
*/
ライデン_007: {
Bien s&^ur que non ! Et &`a partir de
maintenant, je ne mettrai plus jamais
en doute l'instinct f&'eminin !
}
//	<<<ENGLISH>>>
//	Of course not! And I have
//	a pretty healthy respect for
//	the woman's intuition thing now.

/*いや、そういうわけじゃないが。
女の勘って奴はあなどれないな、と。
*/
ローズ_008: {
C'est dr&^olement sexiste ce que tu dis,
tu sais...
}
//	<<<ENGLISH>>>
//	That is such a sexist thing
//	to say, you know that?

/*その言い方、何か女性差別的。
*/
ライデン_009: {
Ne t'&'enerve pas...
Je me suis d&'ej&`a excus&'e...
}
//	<<<ENGLISH>>>
//	Come on, don't be mad.
//	I apologized already.

/*いちいち突っかからないでくれ。
あやまったじゃないか……。
*/
ローズ_010: {
Arr&^ete de tout dramatiser !
Je te fais marcher !
}
//	<<<ENGLISH>>>
//	Don't sweat it -- I'm
//	just messing with ya.

/*ふふ。うそ。冗談よ。
気にしないで。
*/
ローズ_011: {
Je veux seulement que tu saches que je
suis l&`a pour t'aider et que j'ai beaucoup
d'affection pour toi...
}
//	<<<ENGLISH>>>
//	I want you to recognize that I can
//	help you through this thing -- and
//	that I care about you.

/*……私もあなたの役に立つって……
あなたのこと本当に心配してるって
認めてもらいたかっただけ……。
*/
ライデン_012: {
Rose...
