}//d

resource PC_人質部屋＿敵兵定時連絡２__f {
//vox t:vcxxx0625 {
大佐_000: {
Les gardes s'occupant des
otages restent en contact avec
les autres terroristes.
}
//	<<<ENGLISH>>>
//	The guards in charge of
//	the hostages are in regular
//	contact with other terrorists.

/*人質の見張りをしている敵兵士は
定期的に仲間と連絡をとりあっている。
*/
大佐_001: {
Si ces contacts r&'eguliers sont
interrompus, ils d&'ecouvriront ta
pr&'esence.
}
//	<<<ENGLISH>>>
//	If regular contact is cut off, that
//	means they would discover your
//	presence.
//<ページ数変更>
大佐_001_1: {
Tu ne pourras pas survivre en
&'etant encercl&'e d'ennemis, dans
cette zone.
}
//	<<<ENGLISH>>>
//	There's no way you can survive
//	if you are surrounded by the
//	enemy in that area.

/*定期連絡が途絶えることは君の潜入が
発覚することを意味する。そのエリアで
敵に囲まれれば到底助からないぞ。
*/
大佐_002: {
Ne d&'etruis pas de radios ennemies et
n'utilise pas de grenades Chaff pour
perturber ces contacts. OK ?
}
//	<<<ENGLISH>>>
//	Do not destroy enemy radios or
//	use your Chaff to interfere with
//	their regular contact. Got it?

/*そのエリアでは敵の無線機を壊したり
チャフを使って定期連絡を妨害しては
ならない。いいな。
*/
//dv}//v
}//d

resource PC_ハリアー戦＿レーダー__f {
//vox t:vcxxx0625 {
大佐_000: {
Ne t'inqui&`etes pas ! Si tu perds
de vue le Harrier, consultes ton
radar !
}
//	<<<ENGLISH>>>
//	Don't panic, even if you lose
//	sight of the Harrier. Look at
//	your radar.

/*ライデン、ハリアーを見失っても
慌てるな。レーダーを見るんだ。
*/
大佐_001: {
On a modifi&'e le radar pour
montrer o&`u est le Harrier.
}
//	<<<ENGLISH>>>
//	The radar has been modified
//	to show where the Harrier is.
//<ページ数変更>
大佐_001_1: {
Utilises ton radar pour
rep&'erer le Harrier.
}
//	<<<ENGLISH>>>
//	Use the radar and locate
//	the Harrier's position.

/*ハリアーのいる方向が表示されるように
調整しておいた。レーダーを使って
ハリアーの位置をつかめ。
*/
//dv}//v
}//d


resource PC_ヴァンプ戦＿ナイフ弾ける__f {
//vox t:vcxxx0625 {
大佐_000: {
Pour d&'egommer les couteaux lanc&'es par 
Vamp, vises en Observation &`a la premi&`ere
personne.
}
//	<<<ENGLISH>>>
//	You can shoot down the knives
//	Vamp throws. Aim at them in
//	First Person View.

/*ヴァンプの投げるナイフは銃で撃てば
撃ち落とすことが出来る。主観攻撃で
狙え。
*/
//dv}//v
}//d



