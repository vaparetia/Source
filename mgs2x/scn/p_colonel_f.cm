*/
//dv}//v
}//d

//エマのＬＩＦＥ説明 h //e
resource PC_エマ手つなぎ＿エマＬＩＦＥ__f {
//vox t:vc264271 {
大佐_000: {
Tu vois la jauge de LIFE d'Emma,
sous la tienne ?
}
//	<<<ENGLISH>>>
//	Do you see Emma's Life Gauge
