*/
ライデン_001: {
Tu parles, je ne sais m&^eme pas
&`a quoi il ressemble, Ames !
}
//	<<<ENGLISH>>>
//	Sure -- but I don't even
//	know what Ames looks like.

/*ああ。だが俺はエイムズの顔を知らない。
*/
//dv}//v
}//d

resource PC_人質＿指向性マイク２__f {
//vox t:vc263251 {
大佐_000: {
Sers-toi du microphone directionnel pour
