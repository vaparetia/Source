//イントルード説明 h //e
resource PC_イントルード１__f {
//vox t:vc260061{
大佐_000: {
Chaque fois que tu te faufiles dans
un espace r&'eduit, la cam&'era passe
en Point de vue d'intrusion.
}
//	<<<ENGLISH>>>
//	Whenever you crawl into a narrow
//	space, the camera will automati-
//	cally switch to Intrusion View.

/*狭い所に入り込んだ時は、自動的に
イントルードカメラになる。
*/
//dv}//v
}//d

resource PC_イントルード２__f {
//vox t:vc260071 {
大佐_000: {
Actionne le joystick analogique gauche
vers le haut pour avancer,
}
//	<<<ENGLISH>>>
//	Push the left analog stick
//	up to move forward, down
//	to move back.
//<ページ数変更>
大佐_000_1: {
vers le bas pour reculer et &`a gauche
ou &`a droite pour tourner.
}
//	<<<ENGLISH>>>
//	Push left and right to turn
//	in those directions.

/*左スティックの上で前進、下で後退、
左右はそれぞれの方向を向く。
*/
//dv}//v
}//d

resource PC_イントルード３__f {
//vox t:vc260081 {
大佐_000: {
Surveille l'ennemi et ne te mets
jamais &`a d&'ecouvert.
}
//	<<<ENGLISH>>>
//	Keep an eye on the enemy
//	and proceed under cover
//	at all times.
//<ページ数変更>
大佐_000_1: {
Tu ne peux absolument pas te permettre
de te faire rep&'erer.
}
//	<<<ENGLISH>>>
//	You absolutely cannot afford
//	to be spotted.

/*敵の様子を伺いつつ、身を隠しながら
進むんだ。絶対に見つかるんじゃないぞ。
*/
//dv}//v
}//d

resource PC_イントルード＿銃撃てる__f {
//vox t:vc260091 {
大佐_000: {
Contrairement &`a ta formation RV,
tu peux utiliser le pistolet du Point
de vue d'intrusion sur le terrain.
}
//	<<<ENGLISH>>>
//	Unlike in VR training, you can use
//	your gun from Intrusion View in
//	the field. Keep that in mind.

/*ＶＲ訓練の時とは違いイントルード
カメラの時でも銃を撃つことが出来る。
忘れるなよ。
*/
//dv}//v
}//d
resource PC_イントルード＿危険性__f {
//vox t:vc260101 {
大佐_000: {
Le Point de vue d'intrusion n'est
pas un gage de s&'ecurit&'e. L'ennemi
attaquera s'il te voit.
}
//	<<<ENGLISH>>>
//	Intrusion View does not guarantee
//	your safety. If you're spotted, you
//	will be attacked.

/*イントルードは決して安全と言うわけ
ではない。敵に発見されれば当然
攻撃を受ける。
*/
大佐_001: {
Ne te fais pas rep&'erer quand tu passes
en position d'intrusion.
}
//	<<<ENGLISH>>>
//	Make sure you're not spotted
//	sliding into Intrusion position.

/*潜り込むところを敵に見られないように
気をつけろ。
*/
大佐_002: {
Une patrouille pourrait fouiller
les endroits o&`u tu te caches en
Point de vue d'intrusion.
}
//	<<<ENGLISH>>>
//	A patrol could also start checking
//	the spot where you're likely to be
//	hiding in Intrusion View.

/*イントルードで隠れていても敵が
覗き込んでくる時もあるだろう。
*/
大佐_003: {
Dans ce cas, reste en mode d'intrusion et
bouge sans cesse pour ne pas &^etre vu.
}
//	<<<ENGLISH>>>
//	In that case, remain in Intrusion
//	and keep moving to stay out of
//	the enemy's sight.

/*その時はイントルードで移動しながら
敵の視線をかわさなければならない。
*/
大佐_004: {
Le Point de vue d'intrusion n'est
pas de tout repos.
}
//	<<<ENGLISH>>>
//	The Intrusion View is
//	no free lunch. Got that?

/*イントルードでも油断するんじゃないぞ。
いいな。
*/
//dv}//v
}//d


