}
//	<<<ENGLISH>>>
//	Hurry to the Computer Room
//	on B2 in the Shell 1 Core.
//	Understood?

/*Ｅ脚下部に戻っている暇はないぞ。
一刻も早くシェル１中央棟Ｂ２の
電算室に向かうんだ。いいな。
*/
//dv}//v
}//d


//またまた追加
resource PC_その脚部のＣ４解除した__f {
//vox t:vcxxx0625 {
大佐_000: {
Raiden, il ne semble plus
y avoir de C4 dans cette
zone. Changes d'endroit.
}
//	<<<ENGLISH>>>
//	Raiden, there seem to be
//	no more C4's in that area.
