//ＭＧＳのメイリンの格言１ h //e
resource PC_発狂＿格言１__f {
//vox t:vc266641 {
大佐_000: {
Snake, n'oublie pas ce qu'a dit de Gaulle :
}
//	<<<ENGLISH>>>
//	Snake, remember
//	what De Gaulle said:
//<ページ数変更>
大佐_000_1: {
"Les cimeti&`eres sont plein d'hommes
indispensables.
}
//	<<<ENGLISH>>>
//	"The graveyards are full
//	of indispensable men."

/*中国にはね、『匹夫の勇、一人に敵する
