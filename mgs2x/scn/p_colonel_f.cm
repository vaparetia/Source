//dv}//v
}//d

//足跡エリア h //e
resource PC_足跡__f {
//vox t:vc265091 {
大佐_000: {
Raiden, si tu marches avec
des pieds mouill&'es,
}
//	<<<ENGLISH>>>
//	Raiden, if you walk around
