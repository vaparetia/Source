//	Fatman is wearing a blast
//	suit.

/*ライデン、見ての通りファットマンは
ボムブラストスーツを着込んでいる。
*/
//dv}//v
}//d
//一回目のみ t //e
resource PC_ファットマン戦＿頭狙え２__f {
//vox t:vc263071 {
ローズ_000: {
Anti-explosion ?
}
//	<<<ENGLISH>>>
//	A blast suit?

/*ボムブラストスーツ？*/
ライデン_001: {
Cette combinaison se porte lors du
d&'esamor&~qage des bombes
}
//	<<<ENGLISH>>>
//	It's protective clothing worn
//	for bomb disposal work.
//<ページ数変更>
ライデン_001_1: {
et r&'esiste &`a la p&'en&'etration des balles.
}
//	<<<ENGLISH>>>
//	Gunfire can't really penetrate
//	that thing either.

/*爆弾処理用の破片防護服のことだ。
銃弾は簡単には通らない。
*/
//dv}//v
}//d
resource PC_ファットマン戦＿頭狙え３__f {
//vox t:vc263081 {
大佐_000: {
En visant la combinaison, tu n'iras
pas loin. Vise la t&^ete en Observation
&`a la premi&`ere personne.
}
//	<<<ENGLISH>>>
//	You can do very little damage
//	through the suit. Use the First
//	Person View to go for the head.

/*スーツ部分は撃っても効果が薄いぞ。
主観攻撃で頭を狙うんだ。
*/
//dv}//v
}//d
resource PC_ファットマン戦＿頭狙え４__f {
//vox t:vc263091 {
大佐_000: {
Cette combinaison le prot&'ege
enti&`erement des tirs.
}
//	<<<ENGLISH>>>
//	The suit will protect him
//	completely from your shots.
//<ページ数変更>
大佐_000_1: {
Vise la t&^ete en Observation
&`a la premi&`ere personne.
}
//	<<<ENGLISH>>>
//	Use the First Person View
//	to go for the head.

/*スーツ部分に銃弾は効果が無いぞ。
主観攻撃で頭を狙うんだ。
*/
//dv}//v
}//d
//転んだ後は頭狙いやすい t //e
resource PC_ファットマン戦＿転び__f {
//vox t:vc263101 {
大佐_000: {
Il s'&'ecoulera un certain temps entre
le moment o&`u il tombera et celui o&`u
il se rel&`evera.
}
//	<<<ENGLISH>>>
//	There's a long lag between the
//	time he falls down to the point
//	where he manages to get up.
//<ページ数変更>
大佐_000_1: {
Il sera alors vuln&'erable. Profites-en pour
lui envoyer une balle entre les deux yeux.
}
//	<<<ENGLISH>>>
//	His guard will be completely
//	down. Push the advantage and
//	go for a head shot.

/*奴が転んでから起き上がるまでの間に
大きな隙がある。その隙をついて奴の
頭部に弾を撃ち込むんだ。
*/
//dv}//v
}//d


//連続攻撃で転ぶ h //e
resource PC_ファットマン戦＿転ぶ__f {
//vox t:vc263111 {
大佐_000: {
La combinaison anti-explosion ne le
prot&'ege pas de l'impact des tirs.
}
