//dv}//v
}//d


//水密扉。近くでＣＡＬＬ h //e
resource PC_水密扉１__f {
//vox t:vc260431 {
大佐_000: {
Raiden, cette porte est &'etanche.
}
//	<<<ENGLISH>>>
//	Raiden, that door is watertight.

/*ライデン、その扉は水密扉だ。*/
//dv}//v
}//d
//タンカー編をプレイしているユーザーの場合 t //e
resource PC_水密扉２__f {
//vox t:vc260441 {
ライデン_000: {
Ouais, mais je sais comment l'ouvrir.
J'ai appris en formation RV.
}
//	<<<ENGLISH>>>
//	Yeah, I know how to open it.
//	We covered it in VR training.

/*ああ。開け方はわかっている。
ＶＲ訓練で経験済みだ。
*/
大佐_001: {
C'est exact ! Fais bien attention !
}
//	<<<ENGLISH>>>
//	True. Proceed with caution.

/*そうだったな。
慎重に行けよ。*/
//dv}//v
}//d
//タンカー編をプレイしていないユーザーの場合 t //e
resource PC_水密扉３__f {
//vox t:vc260451 {
大佐_000: {
Pour ouvrir la porte, tourne la poign&'ee.
}
//	<<<ENGLISH>>>
//	Turn the handle to open the door.

/*その扉を開けるには、
ハンドルを回さなければならない。*/
大佐_001: {
Place-toi devant la porte et appuie
sur la touche Action pour faire pivoter
la poign&'ee.
}
//	<<<ENGLISH>>>
//	Face the door and press down on
//	the Action button and the handle
//	will turn.

/*ハンドルを回すには扉に向かって
△ボタンを押したままにすればいい。
*/
大佐_002: {
Pour tourner la poign&'ee plus vite, appuie
plusieurs fois sur la touche Action.
}
//	<<<ENGLISH>>>
//	Punch the Action button repeatedly
//	if you need to turn it faster.

/*早く回したければ△ボタンを連打する
ことだ。
*/
//dv}//v
}//d

//昇降機ホール h //e
//放置武器使用不可の説明 h //e
//敵兵を倒した際、敵兵の近くにいるとＣＡＬＬ。 t//e
resource PC_敵武器使用不可１__f {
//vox t:vc260461 {
大佐_000: {
Raiden, tu ne vas pas pouvoir utiliser
les &'equipements de l'ennemi !
}
//	<<<ENGLISH>>>
//	Raiden, you won't be able to use
//	any of the enemy's equipment.

/*ライデン、敵の装備品は使用できないぞ。
*/
ライデン_001: {
Et pourquoi pas ?
}
//	<<<ENGLISH(2)>>>
//	Why not?

/*なぜだ？*/
大佐_002: {
Toutes les armes actives sont &'equip&'ees
d'un syst&`eme d'identification personnel.
}
//	<<<ENGLISH>>>
//	You should know that all active
//	weapons are equipped with a
//	personal identification system.

/*わかっているだろうが、装備済みの
銃火器には全て個人認識装置が
埋め込まれている。
*/
大佐_003: {
Le propri&'etaire de l'arme saisit
ses donn&'ees personnelles lors
de l'immatriculation de l'arme
}
//	<<<ENGLISH>>>
//	The owner enters the required user
//	ID information during the weapon
//	registration＃−
//<ページ数変更>
大佐_003_1: {
ou au d&'ebut de la mission.
}
//	<<<ENGLISH>>>
//	or at the start of a mission.

/*銃火器登録時、あるいは作戦開始時に
認識データを入力する仕組みになって
いるのだ。
*/
大佐_004: {
Hormis l'utilisateur immatricul&'e, toute
personne essayant d'utiliser l'arme
}
//	<<<ENGLISH>>>
//	If anyone other than the registered
//	user tries to fire the weapon,
//<ページ数変更>
大佐_004_1: {
en est emp&^ech&'ee par le syst&`eme
d'identification.
}
//	<<<ENGLISH>>>
//	the ID system will not authorize
//	the action.

/*その登録者以外がトリガーを引いても、
反応しないシステムが導入されている。
*/
ライデン_005: {
Mais ces armes proviennent du march&'e
noir russe. Comment pourraient-elles
avoir un syst&`eme d'identification ?
}
//	<<<ENGLISH>>>
//	But these are black-market Russian
//	weapons. How can they be equipped
//	with identification functionality?

/*ロシアなどから密輸される闇銃火器には
これらの登録システムは採用されて
いないはずだが？
*/
大佐_006: {
Les terroristes les ont s&^urement
modifi&'ees eux-m&^emes.
}
//	<<<ENGLISH>>>
//	They must have been customized by
//	the terrorists themselves.
//<ページ数変更>
大佐_006_1: {
Ce sont des professionnels !
}
//	<<<ENGLISH>>>
//	These are professionals
//	we're dealing with,
//<ページ数変更>
大佐_006_2: {
lls ne laisseront personne utiliser
leurs &'equipements contre eux !
}
//	<<<ENGLISH>>>
//	and they certainly won't let their
//	own equipment be used against them.

/*自前で組み込んだのだろう。
彼らはプロだ。自分たちの装備が
我々の手に落ちないようにしている。
*/
ライデン_007: {
Ce qui vaut aussi pour les &'equipements
du SEAL de la Marine.
}
//	<<<ENGLISH>>>
//	I'm guessing it's the same for
//	the Navy SEALs' gear.

/*ＳＥＡＬＳの装備も同じか？
*/
大佐_008: {
Exact !
}
/*そうだ。*/
ライデン_009: {
Comment vais-je pouvoir me procurer
des armes ?
}
//	<<<ENGLISH>>>
//	How am I supposed to procure
//	weapons then?

/*では武器はどうやって
調達すればいいんだ？
*/
大佐_010: {
Cherche celles qui n'ont pas encore
&'et&'e individualis&'ees !
}
//	<<<ENGLISH>>>
//	Find the ones that haven't
//	yet been individualized.

/*まだＩＤ登録されていないものを
探すんだ。
*/
大佐_011: {
Comme tu l'as vu en formation RV, tous
les objets de ta bo&^ite d'objets sont pr&^ets
&`a l'emploi.
}
//	<<<ENGLISH>>>
//	Everything you find in the Item Box
//	is clean. You should know this from
//	your VR training.

/*登録前のものはアイテムボックスに
入っている。既にＶＲ訓練で学習済み
だろう。
*/
//dv}//v
}//d
//無線機画面のスクリーン内にアイテムＢＯＸの映像。 t //e
resource PC_敵武器使用不可２__f {
//vox t:vc260471 {
ライデン_000: {
Je connais ces &'equipements !
}
//	<<<ENGLISH>>>
//	OK, I know those.

/*ああ、あれならわかる。*/
//dv}//v
}//d
resource PC_敵武器使用不可３__f {
//vox t:vc260481 {
大佐_000: {
Utilise les objets de ta bo&^ite d'objets
&`a volont&'e !
}
//	<<<ENGLISH>>>
//	Items in the Item Box are
//	yours to use at will.

/*アイテムボックスの中に入っている
アイテムは自由に使用できる。
*/
大佐_001: {
Ils constituent ton stock d'armes
et d'&'equipements.
}
//	<<<ENGLISH>>>
//	They will be your supply source
//	with regards to weaponry and gear.

/*武器と装備品はアイテムボックスから
調達するんだ。
*/
//dv}//v
}//d

//倒れた敵兵について h //e
//・死体引きずり方法 h //e
resource PC_死体隠せ__f {
//vox t:vc260491 {
大佐_000: {
Il est trop risqu&'e de laisser tra&^iner
les corps de tes ennemis.
}
//	<<<ENGLISH>>>
//	The risk of leaving an enemy's
//	body lying around is too great.
//<ページ数変更>
大佐_000_1: {
S'ils sont trouv&'es par un camarade,
ce dernier partira &`a ta recherche.
}
//	<<<ENGLISH>>>
//	If his comrades discover it,
//	they'll be on the lookout for you.

/*倒した敵をそのままにしておくのは
危険だ。仲間が倒されたのを知れば
敵は当然警戒を強化してくるだろう。
*/
大佐_001: {
Chaque fois que tu descendras un ennemi,
fais en sorte de cacher son cadavre.
}
//	<<<ENGLISH>>>
//	Whenever you take an enemy out,
//	conceal the body to the best of
//	your abilities.

/*敵を倒したら、すぐにその体を
人目につかない場所に隠すんだ。
*/
//dv}//v
}//d
resource PC_死体引きずり方法１__f {
//vox t:vc260501 {
大佐_000: {
Tu peux tra&^iner le cadavre de tes ennemis.
}
//	<<<ENGLISH>>>
//	You can drag an enemy personnel's
//	body.

/*倒れた敵の体は引きずって移動させる
ことが出来る。
*/
//dv}//v
}//d
//＊ムービー t //e
resource PC_死体引きずり方法２__f {
//vox t:vc260511 {
大佐_000: {
Voici comment :
}
//	<<<ENGLISH>>>
//	This is how to do it:
//<ページ数変更>
大佐_000_1: {
approche-toi du cadavre et
d&'es&'electionne toutes les armes.
Ensuite, appuie sur la touche Arme
pour le saisir.
}
//	<<<ENGLISH>>>
//	first, walk up to the body, and
//	with all weapons deselected, press
//	the Weapon button to pick it up.

/*やり方は、こうだ。まず倒れた敵の近く
で、武器を装備せずに□ボタンを押して、
敵の体を抱える。
*/
大佐_001: {
Pour te d&'eplacer en tenant le cadavre,
maintiens la touche Arme enfonc&'ee.
}
//	<<<ENGLISH>>>
//	As long as you have the Weapon
//	button held down, you can move
//	around with the body in your grasp.
//<ページ数変更>
大佐_001_1: {
Pour l&^acher le cadavre,
rel&^ache la touche Arme.
}
//	<<<ENGLISH>>>
//	Release the Weapon button
//	to let go of the body.

/*
□ボタンを押している間、敵を引きずり
ながら移動することが出来る。
体を下ろすには□ボタンを離せばいい。
*/
//dv}//v
}//d


//・死体硬直 h //e
resource PC_死体硬直１__f {
//vox t:vc260521 {
大佐_000: {
Raiden, si tu as l'intention de cacher un
cadavre, il faut que tu agisses rapidement.
}
//	<<<ENGLISH>>>
//	Raiden, if you do plan to hide
//	someone's body, you'll need to
//	be quick about it.

/*ライデン、倒した敵の体を
隠すつもりなら、すぐに移動させる
必要があるぞ。
*/
//dv}//v
}//d
resource PC_死体硬直２__f {
//vox t:vc260531 {
大佐_000: {
Concernant les ennemis que tu as
assomm&'es, tu devras partir avant
qu'ils reprennent connaissance.
}
//	<<<ENGLISH>>>
//	For enemies you've knocked out,
//	you need to move before they regain
//	consciousness.
//<ページ数変更>
大佐_000_1: {
Ceux que tu as tu&'es prendront rapidement
une rigidit&'e cadav&'erique
}
//	<<<ENGLISH>>>
//	The ones you've had to terminate
//	will start to undergo rigor mortis
//	fairly quickly as well.
//<ページ数変更>
大佐_000_2: {
et ne pourront plus &^etre d&'eplac&'es.
}
//	<<<ENGLISH>>>
//	They'll be too stiff to move.

/*意識を失った敵はしばらくすれば目を
覚ます。そうでない敵も時間が経つと
硬直して動かせなくなる。注意しろ。
*/
//dv}//v
}//d




//ＶＲ１面のマップ（伏線） h //e
//入り口付近。前作をプレイしている人のみ。 t //e
resource PC_海底ドックＶＲ１__f {
//vox t:vc260541 {
ライデン_000: {
Colonel, je me souviens de cet endroit...
}
//	<<<ENGLISH>>>
//	Colonel, I remember this place...

/*大佐、ここに来た記憶がある……。*/
大佐_001: {
Evidemment ! Il s'agit du
Niveau Un des missions RV !
}
//	<<<ENGLISH>>>
//	Of course you do. This is Level One
//	from the VR missions.

/*そうだろう、ＶＲミッションの１面だ。
*/
//dv}//v
}//d
//小画面にＶＲ画面が出る。t //e
resource PC_海底ドックＶＲ２__f {
//vox t:vc260551 {
ライデン_000: {
Tu as raison ! Tout me revient...
}
//	<<<ENGLISH>>>
//	You're right -- I see it now.

/*なるほど、そういえばそうだ。*/
大佐_001: {
Tu n'as certes aucune exp&'erience de
terrain, mais tu es rompu &`a l'hyper-r&'ealit&'e
des combats simul&'es...
}
//	<<<ENGLISH>>>
//	You may not have field experience,
//	but you've been trained in the
//	hyperreality of simulated combat.

/*君には実戦経験こそないが、
それ以上にリアルなシミュレーション
での疑似体験がある。*/
大佐_002: {
Ne c&`ede pas &`a la peur. Proc&`ede
comme on t'a appris et tout ira bien.
}
//	<<<ENGLISH>>>
//	Don't give into fear. Just do as
//	you were trained, and everything
//	will be all right.

/*恐れるな。
訓練通りに進めれば問題はない。*/
//dv}//v
}//d

//危険モードになったら逃げろＣＡＬＬ h //e
resource PC_海底ドック危険モード回避のススメ１__f {
//vox t:vc260561 {
大佐_000: {
Raiden, tu es sans arme et si tu devais
les affronter, tu n'aurais aucune chance !
}
//	<<<ENGLISH>>>
//	Raiden, you have no weapons and not
//	a chance in hell against them in a
//	confrontation.
//<ページ数変更>
大佐_000_1: {
D&'ecampe vers le sud. Rebrousse chemin
en empruntant le couloir !
}
//	<<<ENGLISH>>>
//	Get out of there and head south!
//	Retreat down the corridor!

/*ライデン、君は武器をもっていない。
まともにやり合っても勝ち目はないぞ！
南に逃げろ！通路を戻るんだ！
*/
//dv}//v
}//d
//一回目のみ t //e
resource PC_海底ドック危険モード回避のススメ２__f {
//vox t:vc260571 {
ローズ_000: {
Jack, pars vite ! Je t'en supplie !!
}
//	<<<ENGLISH>>>
//	Jack, get out of there!
//	Please!!

/*ジャック！逃げて！お願い！！
*/
大佐_001: {
Tu seras plus &`a l'abri dans la zone sud.
Retournes-y vite !
}
//	<<<ENGLISH>>>
//	There's some cover back in the
//	south area. Get yourself over
//	there right now.

/*南のエリアに戻れば隠れる場所がある。
そっちに逃げ込むんだ。
*/
//dv}//v
}//d


//クリアリングの説明（ＣＡＬＬ）h //e
resource PC_海底ドッククリアリング中ＣＡＬＬ__f {
//vox t:vc260581 {
大佐_000: {
Raiden, ne bouge pas. L'ennemi
proc&'ede &`a une &'evacuation.
}
//	<<<ENGLISH>>>
//	Raiden, stay still. The enemy
//	is engaged in Clearing.

/*ライデン、じっとしているんだ！
奴等はクリアリングをしている。
*/
ローズ_001: {
Tu peux &^etre plus pr&'ecis ?
}
//	<<<ENGLISH(2)>>>
//	What's Clearing?

/*クリアリングって？*/
大佐_002: {
Ils &'evacuent et passent au peigne fin
les zones au risque qu'ils pensent ou
savent abriter des intrus.
}
//	<<<ENGLISH>>>
//	A systematic sweep of high-risk
//	zones where intruder presence is
//	either suspected or confirmed.

/*クリアリングとは敵が存在する、または
その存在が予想される部屋、家屋などの
危険エリアを掃討することだ。
*/
大佐_003: {
Ces &'evacuations utilisent CQB deux
grandes cat&'egories de techniques de
combat rapproch&'e.
}
//	<<<ENGLISH>>>
//	It makes use of a variety of CQB
//	techniques, but can be divided
//	roughly into two types.

/*種々のＣＱＢテクニックを駆使してな。
クリアリングには大きくわけて二種類の
突入方法がある。
*/
大佐_004: {
L'un est "l'entr&'ee dynamique",
}
//	<<<ENGLISH>>>
//	One is the so-called "dynamic
//	entry" method,
//<ページ数変更>
大佐_004_1: {
qui consiste &`a allier la rapidit&'e d'ex&'ecution
et le effet du surprise pour investir une
zone et prendre l'ennemi d'assaut.
}
//	<<<ENGLISH>>>
//	which relies on speed and the
//	element of surprise to storm the
//	area and take control of the enemy.

/*一つがスピードと奇襲にものを言わせて
突入し一気に敵を制圧するダイナミック
エントリー。
*/
大佐_005: {
Et l'autre est "l'entr&'ee furtive",
qui consiste &`a infiltrer une zone
}
//	<<<ENGLISH>>>
//	The other is "stealth entry," which
//	involves infiltrating the area,
//<ページ数変更>
大佐_005_1: {
et &`a avancer discr&`etement pour prendre
le contr&^ole des lieux.
}
//	<<<ENGLISH>>>
//	covertly acquiring the targets
//	and seizing control.

/*そしてもう一つがその反対に隠密裏に
エリアに進入、接敵し、主導権を奪う
ステルスエントリーだ。
*/
ローズ_006: {
Dans les deux cas, il ne faut surtout pas
se faire rep&'erer, n'est-ce pas ?
}
//	<<<ENGLISH>>>
//	In either case, he'll be discovered
//	unless he stays out of sight. Am I
//	correct?

/*つまり、じっと隠れていないと
見つかるってこと？*/
大佐_007: {
Exact ! Ils sont des professionnels
bien entra&^in&'es ! 
}
//	<<<ENGLISH>>>
//	Absolutely. They're
//	trained professionals.
//<ページ数変更>
大佐_007_1: {
Souviens-t'en quand tu cherches
une cachette, Raiden !
}
//	<<<ENGLISH>>>
//	Keep that in mind when you look
//	for a good hiding place, Raiden.

/*そういうことだな。
彼らは訓練されたプロだ。
適切な隠れ場所を見つけるんだ。
*/
//dv}//v
}//d


//ＬＩＦＥゼロ寸前（ＣＡＬＬ／ＥＡＳＹのみ） h //e
resource PC_ＬＩＦＥゼロ寸前ＣＡＬＬ１__f  {
//vox t:vc260591 {
大佐_000: {
Raiden, ta Jauge de LIFE
va tomber &`a z&'ero !
}
//	<<<ENGLISH>>>
//	Raiden, your Life Gauge is
//	about to run out!

/*ライデン、ＬＩＦＥがゼロになるぞ！
*/
//dv}//v
}//d
