//	You're, like, really strange!

/*っていうか、あなたが異常！！*/
大佐_006: {
Rosemary, calme-toi !
}
//	<<<ENGLISH>>>
//	Rosemary, settle down.

/*ローズ君、落ち着いてくれ。*/
ローズ_007: {
Mais...
}
//	<<<ENGLISH>>>
//	But...


/*ですが……。*/
大佐_008: {
Ne t'inqui&`ete pas. Raiden, Rosemary a
raison. Tu devrais chercher ailleurs...
}
//	<<<ENGLISH>>>
//	It's all right. Raiden, Rosemary
//	is right. You should probably
//	look someplace else.

/*まあまあ。
ライデン、ローズ君の言う通りだぞ。
別のところを探した方がいいだろう。
*/
大佐_009: {
Cela &'etant, je suis de tout c&@eur avec toi...
}
//	<<<ENGLISH>>>
//	...I can really sympathize
//	with you there, though...

/*……君の気持ちもよくわかるがな……。
*/
ローズ_010: {
Pla&^it-il ?
}
//	<<<ENGLISH>>>
//	What, sir?

/*はい！？*/
大佐_011: {
Heu, rien ! Raiden, l'incident est clos.
Retourne &`a ta mission !
}
//	<<<ENGLISH>>>
//	Err, nothing. Raiden, that's
//	that. Return to your duties.

/*あ、いや。ライデン、
とにかくそういうことだ。任務に戻れ。
*/
ライデン_012: {
...
}
//	<<<ENGLISH>>>
//	...

/*……。*/
