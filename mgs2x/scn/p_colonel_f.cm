*/
大佐_002: {
Mais derri&`ere cette fa&~qade de normalit&'e,
}
//	<<<ENGLISH>>>
//	But behind the scenes
//	of business as usual,
//<ページ数変更>
大佐_002_1: {
la vile "J.E. Corporation (Camelote &`a prix
d'or)" remplit ses coffres
}
//	<<<ENGLISH>>>
//	the nefarious J.E. (Junker Expensive)
//	Corporation lines its already bloated
//	coffers＃−
//<ページ数変更>
大佐_002_2: {
d&'ej&`a pleins des profits g&'en&'er&'es
par sa camelote.
}
//	<<<ENGLISH>>>
//	with profits from
//	worthless products.

/*だが、そんな平和の裏側で、粗悪な
