//	...

/*……。*/
ライデン_013: {
Alors ?
}
//	<<<ENGLISH>>>
//	...are you?


/*じゃないみたいだな……。*/
大佐_014: {
Poursuis ta mission.
C'est clair ?
}
//	<<<ENGLISH>>>
//	Continue your duties.
//	Understood?

/*任務を続行しろ。いいな。
*/
ライデン_015: {
Limpide !
}
//	<<<ENGLISH>>>
//	Yes, sir.

/*了解。*/
