*/
大佐_001: {
Les sentinelles n'inspectent pas les
garde-fous. La suspension te permettra
de rester hors de leur vue.
}
//	<<<ENGLISH>>>
//	The sentries aren't checking over
//	the railings. Hanging will let you
//	travel right in their blind spot.
//<ページ数変更>
大佐_001_1: {
Essaie !
}
//	<<<ENGLISH>>>
//	Try Hanging.

/*敵も手すりの向こう側は警戒していない
ようだ。エルードを使えば敵の死角から
進むことが出来る。エルードを使え。
*/
//dv}//v
}//d

