//エレベータパネル前 h //e
resource PC_シェル１中央棟１Ｆ＿エレベータ説明__f {
//vox t:vc261621 {
大佐_000: {
Je vois un ascenseur, l&`a-bas. Tu vas
pouvoir changer d'&'etage, &`a pr&'esent.
}
//	<<<ENGLISH>>>
//	I see an elevator over there.
//	You'll be able to travel from
//	floor to floor now.

/*エレベータがあるな。エレベータに
乗ればフロアからフロアへ移動が出来る。
*/
大佐_001: {
Appuie sur la touche Action devant le
panneau qui se trouve &`a c&^ot&'e de
l'ascenseur.
}
//	<<<ENGLISH(2)>>>
//	Push the Action button in front
//	of the panel you see next to the
//	elevator.

/*エレベータを呼ぶには、近くにある
