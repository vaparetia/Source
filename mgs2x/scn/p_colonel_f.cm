*/
大佐_001: {
D'apr&`es nos renseignements, Ames est
d&'etenu au niveau B1 du noyau de la
Shell 1.
}
//	<<<ENGLISH>>>
//	Our information indicates that
//	Ames is being held in the B1
//	level of Shell 1's core.
//<ページ数変更>
大佐_001_1: {
Va au noyau de la Shell 1.
}
//	<<<ENGLISH>>>
//	Head for the core of Shell 1.

/*エイムズはシェル１中央棟のＢ１に
人質として捕えられているらしい。
シェル１中央棟に向かえ。
*/
//dv}//v
}//d

//指向性マイク h //e
//一回目のみ t //e
resource PC_人質＿指向性マイク１__f {
//vox t:vc263241 {
大佐_000: {
Ames est tr&`es certainement d&'etenu
avec les autres otages.
}
//	<<<ENGLISH>>>
//	Ames is most likely being
//	held with other hostages.

/*エイムズは他の人質と一緒に
