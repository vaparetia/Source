*/
//dv}//v
}//d

//エマＬＩＦＥ回復法 h //e
resource PC_エマ手つなぎ＿エマＬＩＦＥ回復__f {
//vox t:vc264281 {
大佐_000: {
En s'asseyant et en se reposant,
Emma fera lentement remonter
sa jauge de LIFE.
}
//	<<<ENGLISH>>>
//	Emma's Life Gauge will recover
//	slowly while she's sitting down
