大佐_000_1: {
V&'erifie la distance te s&'eparant du sol en
Observation &`a la premi&`ere personne.
}
//	<<<ENGLISH>>>
//	Check the ground below in First
//	Person View before jumping down.

/*だが高過ぎる所から落ちるとＬＩＦＥが
減るぞ。飛び降りる時は主観で真下を
確認してからにするんだ。
*/
//dv}//v
}//d

//プレイヤーの催促 h //e
//長時間いると催促される t //e
resource PC_海底ドック催促__f {
//vox t:vc260421 {
大佐_000: {
Raiden, tu devrais &^etre familiaris&'e
avec les commandes, &`a pr&'esent !
}
//	<<<ENGLISH>>>
//	Raiden, you should be used to
