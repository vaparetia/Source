//vox t:vc260601 {
大佐_000: {
Trouve des rations ! Cela te permettra
de r&'ecup&'erer un peu de LIFE. 
}
//	<<<ENGLISH>>>
//	Locate some ration. You'll be able
//	to recover some LIFE with it,
//<ページ数変更>
大佐_000_1: {
Tu devrais en trouver dans la partie
de la zone sud.
}
//	<<<ENGLISH>>>
//	and there should be some in the
//	eastern section of the South area.

/*レーションを探すんだ。レーションを
使えばＬＩＦＥを回復出来る。
南のエリアの東にあったはずだ。
*/
//dv}//v
}//d

//レーション持っている場合 t //e
resource PC_ＬＩＦＥゼロ寸前ＣＡＬＬ＿レーション使え__f  {
//vox t:vc260611 {
大佐_000: {
Mange tes rations !
}
//	<<<ENGLISH>>>
//	Use your ration!

/*レーションを使うんだ！*/
//dv}//v
}//d

//レーションの説明 h //e
//レーション入手時にＣＡＬＬ t //e
resource PC_レーションＣＡＬＬ１__f {
//vox t:vc260621 {
大佐_000: {
Tu as acquis des rations.
}
//	<<<ENGLISH>>>
//	You've acquired some ration.
//<ページ数変更>
大佐_000_1: {
Bien ! Tu peux les emporter sur le terrain
pour r&'ecup&'erer un peu de LIFE au besoin.
}
//	<<<ENGLISH>>>
//	Good -- this is a portable field
//	food source that can be consumed
//	to recover LIFE.

/*レーションを手に入れたな。
ＬＩＦＥを回復出来る軍用携帯糧食だ。
*/
//dv}//v
}//d

//操作説明 t //e
resource PC_レーション操作説明__f {
//vox t:vc260631 {
大佐_000: {
S&'electionne une ration dans ta fen&^etre
et appuie sur la touche Entr&'ee.
}
//	<<<ENGLISH>>>
//	Select the ration in your window
//	and push the Enter button.
//<ページ数変更>
大佐_000_1: {
Mange-la imm&'ediatement s'il le faut
}
//	<<<ENGLISH>>>
//	You can use it on the spot
//	and regain some LIFE.

/*レーションをウィンドウで選択して
○ボタンを押せば、その場で使用して
ＬＩＦＥを一定量回復する。
*/
大佐_001: {
Une fois s&'electionn&'ee, tu peux la
consommer automatiquement quand
}
//	<<<ENGLISH>>>
//	If you have it selected, you can
//	automatically consume the ration＃−
//<ページ数変更>
大佐_001_1: {
ta jauge de LIFE tombe &`a z&'ero
pour &'eviter la mort.
}
//	<<<ENGLISH>>>
//	the moment your LIFE
//	runs out and avoid death.

/*装備していればＬＩＦＥがなくなった
瞬間、自動的に使用してＬＩＦＥを
回復することが出来る。
*/
大佐_002: {
Les rations nourrissent et stimulent
}
//	<<<ENGLISH>>>
//	Rations not only provide
//	nutrition,
//<ページ数変更>
大佐_002_1: {
le syst&`eme immunitaire tout en r&'eduisant
le stress psychologique.
}
//	<<<ENGLISH>>>
//	they also stimulate the immune
//	system and lessen psychological
//	stress.

/*栄養補給だけではなく免疫システムを
活性化させ、ストレスを緩和させる
効果も合わせ持っている。
*/
ライデン_003: {
Peut-&^etre, mais question go&^ut,
il y a mieux !
}
//	<<<ENGLISH(2)>>>
//	Not exactly gourmet, though,
//	is it...

/*結構、味気無さそうに見えるんだが。
*/
大佐_004: {
Arr&^ete tes j&'er&'emiades, Raiden...
}
//	<<<ENGLISH>>>
//	Stop complaining, Raiden...

/*文句を言うな、ライデン……。
戦場なんだぞ……。*/
//dv}//v
}//d
//ローズがいる場合 t //e
resource PC_レーション操作説明＿ローズ__f {
//vox t:vc260641 {
ローズ_000: {
Tiens bon, Jack ! Quand la mission sera
finie, je te concocterai ma sp&'ecialit&'e !
}
//	<<<ENGLISH>>>
//	Hang in there, Jack. When the
//	mission is over, I'll make you
//	my specialty.

/*がまんして、ジャック。
任務が終わったら、私の得意料理を
ごちそうするから。
*/
ライデン_001: {
Ouais, super...
}
//	<<<ENGLISH>>>
//	Ouais, super...

/*え！？*/
ローズ_002: {
Pla&^it-il ?
}
//	<<<ENGLISH>>>
//	Pla&^it-il ?

/*ん？*/
ライデン_003: {
Rien ! J'en ai d&'ej&`a l'eau &`a la bouche !
}
//	<<<ENGLISH>>>
//	Oh, nothing. I can't wait!

/*あ、いや、何でもない。
楽しみだよ。ははは……。*/
//dv}//v
}//d

//ノード前 h //e
//接続前 t //e
resource PC_ノード前接続前１__f {
//vox t:vc260651 {
大佐_000: {
Raiden, le terminal que tu vois l&`a-bas est
ce qu'on appelle un n&@eud.
}
//	<<<ENGLISH>>>
//	Raiden, the computer terminal you
//	see over there is what's called a
//	node.

/*ライデン、そこにあるコンピュータ
端末がノードだ。
*/
ライデン_001: {
Ce truc ?
}
//	<<<ENGLISH>>>
//	This...?

/*これが……。*/
大佐_002: {
Oui. Connecte-toi &`a ce n&@eud.
Pour ce faire, place-toi devant
lui et actionne la touche Action.
}
//	<<<ENGLISH>>>
//	Right. Log into it right now.
//	Stand in front of the node and
//	push the Action button.

/*そうだ。早くノードにアクセスしろ。
やり方は、ノードの前に立って
△ボタンを押すだけだ。
*/
//dv}//v
}//d
resource PC_ノード前接続前２__f {
//vox t:vc260661 {
大佐_000: {
Tu ne peux pas te relier &`a un n&@eud
en Mode Alerte.
}
//	<<<ENGLISH>>>
//	You won't be permitted to log into
//	a node during the Alert Mode.
//<ページ数変更>
大佐_000_1: {
Avant de connecter, v&'erifie qu'il n'y a
personne &`a tes trousses.
}
//	<<<ENGLISH>>>
//	Make sure you're not under pursuit
//	when you need to log in.

/*危険モードの状態ではノードにアクセス
することは出来ない。アクセスする前に
必ず敵を振り切るんだ。
*/
//dv}//v
}//d
resource PC_ノード前接続前３__f {
//vox t:vc260662 {
大佐_000: {
Pour se relier &`a un n&@eud,
il faut &^etre en Mode Normal.
}
//	<<<ENGLISH>>>
//	You can only access the node
//	in Normal Mode.

/*ノードには潜入モードの状態でしか
アクセス出来ない。
*/
大佐_001: {
Pour te relier &`a un n&@eud, tu dois t'en
approcher sans te faire rep&'erer.
}
//	<<<ENGLISH>>>
//	To access the node, you must
//	approach it without being
//	seen by the enemy.

/*アクセスを試みる時は、敵の目を
かいくぐってノードに接近する必要が
ある。
*/
//dv}//v
}//d


//ノードについて h //e
resource PC_ノード機能説明１__f {
//vox t:vc260671 {
大佐_000: {
En te reliant &`a un n&@eud, tu pourras utiliser
le radar et la carte g&'en&'erale de la zone.
}
//	<<<ENGLISH>>>
//	Logging into a node will permit you
//	to use the radar and the overview
//	map of the area.

/*ノードに接続すれば、そのエリアの
レーダーと全体マップが利用できる
ようになる。
*/
大佐_001: {
Tu pourras aussi acc&'eder &`a d'autres
fonctions, par exemple change des
options,
}
//	<<<ENGLISH(2)>>>
//	You will also be able to access
//	other functions such as Option
//	changes.
//<ページ数変更>
大佐_001_1: {
pour personnaliser les param&`etres
selon tes besoins.
}
//	<<<ENGLISH>>>
//	Customize the settings
//	according to your needs.

/*だがそれ以外にもオプションの変更等、
様々な機能が利用できる。君の好みに
あわせて設定を変えるといい。
*/
//dv}//v
