//	Ames has a pacemaker.
//<ページ数変更>
大佐_001_1: {
Il a donc s&^urement un rythme
cardiaque diff&'erent.
}
//	<<<ENGLISH>>>
//	This should make his cardiac
//	pattern fairly distinct.
//<ページ数変更>
大佐_001_2: {
Utilise le microphone directionnel
pour le rep&'erer.
}
//	<<<ENGLISH>>>
//	Use the directional microphone
//	to locate it.

/*エイムズは心臓にペースメイカーを埋め
