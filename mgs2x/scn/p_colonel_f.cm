//	the fall. Keep that in mind.

/*ライデン、エルード中は完全に無防備だ。そこから叩き落とされたら、とても
助からないぞ。気をつけろ。
*/
//dv}//v
}//d


//銃で攻撃 h //e
resource PC_ファットマン戦＿銃撃戦__f {
