//	Try not to end up in a situation
//	where you need to rely on firepower.
//<ページ数変更>
大佐_004_2: {
sauf en cas d'absolue n&'ecessit&'e.
}
//	<<<ENGLISH>>>
//	Combat must be avoided
//	unless absolutely necessary.

/*潜入任務の基本は隠密行動だ。まず銃を
使うような局面に陥らないことをこころ
がけろ。戦闘は可能な限り避けるんだ。
*/
//dv}//v
}//d



