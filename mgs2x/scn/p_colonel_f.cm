resource PC_ファットマン戦＿エルード中__f {
//vox t:vc263131 {
大佐_000: {
Raiden, la Suspension te rend
compl&`etement vuln&'erable.
}
//	<<<ENGLISH>>>
//	Raiden, you're completely
//	defenseless while Hanging.
//<ページ数変更>
大佐_000_1: {
S'il r&'eussit &`a te faire l&^acher ce rebord,
