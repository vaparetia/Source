//dv}//v
}//d
resource PC_変装＿ＡＫ装備__f {
//vox t:vc263291 {
大佐_000: {
Tu attireras les soup&~qons si tu n'es pas
dot&'e de l'&'equipement standard...
}
//	<<<ENGLISH>>>
//	It will look suspicious
