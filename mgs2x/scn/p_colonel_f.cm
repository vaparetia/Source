*/
//dv}//v
}//d
//敵兵をつれてこい h //e
resource PC_網膜センサー＿羽交絞め１__f {
//vox t:vc261701 {
大佐_000: {
Raiden, pour franchir ce syst&`eme
de s&'ecurit&'e biom&'etrique,
}
//	<<<ENGLISH>>>
//	Raiden, if you need to get past
//	the biometric security system,
//<ページ数変更>
大佐_000_1: {
il faut que tu fasses venir un des ennemis
jusqu'au scanner r&'etinien.
}
//	<<<ENGLISH>>>
//	you need to bring one of the
//	enemies to the retinal scanner.

/*ライデン、バイオメトリックスを
