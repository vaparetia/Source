}//d
//＊ムービー t //e
resource PC_エルード＿飛び降り２__f {
//vox t:vc260411 {
大佐_000: {
Si tu sautes de trop haut, ta jauge
de LIFE en prendra un sacr&'e coup.
}
//	<<<ENGLISH>>>
//	But a jump from too high a location
//	will take a toll on your Life Gauge.
