Quoi... ?
}
//	<<<ENGLISH>>>
//	Wha...?

/*え？*/
ローズ_008: {
Heu... je veux dire...
}
//	<<<ENGLISH(2)>>>
//	I mean...

/*あ……。*/
大佐_009: {
... Je suis tout &`a fait outr&'e...
}
//	<<<ENGLISH>>>
//	...I completely disapprove...

/*……全く度し難い……。*/
//dv}//v
}//d


