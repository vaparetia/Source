//<ページ数変更>
大佐_001_1: {
Son rythme cardiaque doit
donc &^etre assez distinctif.
}
//	<<<ENGLISH>>>
//	This should make his cardiac
//	pattern fairly distinct.
//<ページ数変更>
大佐_001_2: {
Utilises le microphone directionnel
pour le rep&'erer.
}
//	<<<ENGLISH>>>
//	Use the directional microphone
//	to locate it.

/*エイムズは心臓にペースメイカーを埋め
込んでいるらしい。心音が違うはずだ。
それを指向性マイクで聞き分けるんだ。
*/
//dv}//v
}//d


