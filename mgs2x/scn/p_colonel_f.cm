*/
//dv}//v
}//d



//ＡＢ連絡橋 d //e
//狭いから見つかると死ぬ注意 h //e
resource PC_ＡＢ連絡橋見つかるな注意__f  {
//vox t:vc260971 {
大佐_000: {
Raiden, surtout, reste discret.
La passerelle est trop &'etroite
pour offrir une porte de sortie.
}
//	<<<ENGLISH>>>
//	Raiden, stay out of sight at all
//	costs. The bridge is too narrow
//	to offer any way out.
//<ページ数変更>
大佐_000_1: {
Si tu te fais rep&'erer, tu es mort.
}
//	<<<ENGLISH>>>
//	If you're spotted, you won't
//	last too long.

/*ライデン、そこでは絶対に見つかるなよ。
狭い橋の上では逃げ場がない。
