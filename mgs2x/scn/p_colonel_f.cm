//デフォルト操作説明系 d //e

//プラント外部でリモコン装備時 h //e
resource PC_リモコンミサイル使えない１__f {
//vox t:vc266261 {
大佐_000: {
Raiden, les missiles t&'el&'eguid&'es ne
s'utilisent pas hors de la Big Shell.
}
//	<<<ENGLISH>>>
//	Raiden, remote-controlled missiles
//	cannot be used outside the Big Shell.

/*ライデン、リモコンミサイルは
『ビッグ・シェル』内部でしか
使えないぞ。
*/
//dv}//v
}//d
//一回目のみ t //e
resource PC_リモコンミサイル使えない２__f {
//vox t:vc266271 {
ライデン_000: {
Pourquoi ?
}
//	<<<ENGLISH>>>
//	Why?

/*なぜだ？*/
大佐_001: {
A cause du brouillage. Il y a des
interf&'erences &'electroniques
autour de la Big Shell.
}
//	<<<ENGLISH>>>
//	The signal will be scrambled.
//	There's electronic interference
//	surrounding the Big Shell.

/*妨害電波だ。『ビッグ・シェル』
周辺一帯に電子妨害がかけられている。
*/
ライデン_002: {
A cause des terroristes ?
}
//	<<<ENGLISH>>>
//	Done by the terrorists?

/*テロリスト達が？*/
大佐_003: {
Peut-&^etre. C'est s&^urement pour
emp&^echer les inspections.
}
//	<<<ENGLISH>>>
//	Perhaps. Probably to prevent
//	any UAV or other searches by us.

/*おそらくな。我々がＵＡＶ等で偵察を
行うのを阻止するつもりなのだろう。
*/
ライデン_004: {
Mais ils utilisent des radios
et des Cyphers aussi, non ?
}
//	<<<ENGLISH>>>
//	But they use radios and
//	Cyphers too, right?

/*しかし奴等も無線やサイファーを
使っている？
*/
大佐_005: {
Bien s&^ur. Leur brouillage n'affectent
pas les canaux qu'ils utilisent.
}
//	<<<ENGLISH>>>
//	Of course. They wouldn't set it
//	up to interfere with the several
//	channels that they are using.
//<ページ数変更>
大佐_005_1: {
Il n'y a que nos missiles t&'el&'eguid&'es
qui soient touch&'es, en fait.
}
//	<<<ENGLISH>>>
//	The only thing affected is your
//	remote-controlled missile.

/*当然だ。自分達で使用する周波数帯に
まで妨害をかけるわけがない。影響を
受けるのは君のリモコンミサイルだけだ。
*/
大佐_006: {
Heureusement, les interf&'erences
sont faibles.
}
//	<<<ENGLISH>>>
//	Fortunately the interference
//	isn't too strong.

/*だが幸いなことに妨害電波はそれほど
強くない。
*/
大佐_007: {
A l'int&'erieur de la Big Shell, tu devrais
pouvoir utiliser ton missile t&'el&'eguid&'e
sans probl&`eme.
}
//	<<<ENGLISH>>>
//	While inside the Big Shell you
//	should have no problem using
//	a remote-controlled missile.

/*『ビッグ・シェル』内部なら問題なく
リモコンミサイルも使えるはずだ。
*/
//dv}//v
}//d

