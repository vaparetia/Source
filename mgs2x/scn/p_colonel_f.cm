//<ページ数変更>
大佐_001_1: {
Vise-la en Observation &`a la premi&`ere
personne.
}
//	<<<ENGLISH>>>
//	Use the First Person View
//	to take it out.

/*無線機は敵の腰の右後ろだ。
主観攻撃で破壊できる。
*/
//dv}//v
}//d
//死んだ敵兵をつれてきた h //e
resource PC_網膜センサー＿生きた敵兵__f {
