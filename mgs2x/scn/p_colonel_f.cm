//各部の機能説明 d //e
//一般的説明 h //e
resource PC_一般機能説明__f {
//vox t:vc266401 {
ローズ_000: {
Jack, j'ai des infos sur la Big Shell.
}
//	<<<ENGLISH>>>
//	Jack, I did a search
//	on the Big Shell.

/*ジャック、『ビッグ・シェル』について
調べてみたの。
*/
ローズ_001: {
L'accident du tanker d'il y a deux ans a
d&'evers&'e d'&'enormes quantit&'es de
brut dans la Baie.
}
//	<<<ENGLISH>>>
//	The tanker accident two years ago
//	spilled a catastrophic amount of
//	crude oil into the bay.

/*大規模な原油流出が引き起こされた。
*/
ローズ_002: {
La Big Shell est une usine de
d&'econtamination qui sert &`a nettoyer
la Baie de Manhattan en retenant
}
//	<<<ENGLISH>>>
//	The Big Shell is an offshore decontami-
//	nation facility built to restore the
//	Manhattan Bay environment＃−
//<ページ数変更>
ローズ_002_1: {
et en jetant le p&'etrole.
}
//	<<<ENGLISH>>>
//	by trapping and disposing
//	the spilt oil.

/*『ビッグ・シェル』はその原油を回収・
処理し、ＮＹ湾の環境回復を図るために
建設された海上除染施設なの。
*/
ローズ_003: {
Les barri&`eres flottantes pos&'ees autour
de la Big Shell servent &`a emp&^echer le
}
//	<<<ENGLISH>>>
//	Around the perimeter of
//	the Big Shell oil fences
//	were erected＃−
//<ページ数変更>
ローズ_003_1: {
p&'etrole de continuer &`a se r&'epandre.
}
//	<<<ENGLISH>>>
//	in order to protect against any
//	further dispersal of the oil.

/*『ビッグ・シェル』の周囲の海域には
オイルフェンスが張り巡らされて原油の
拡散を防いでいる。
*/
ローズ_004: {
Tu aper&~qois les dispositifs qui
sont plant&'es &`a plusieurs endroits
de la barri&`ere flottante ?
}
//	<<<ENGLISH>>>
//	You see those steeples erected
//	here and there in the fence?
//<ページ数変更>
ローズ_004_1: {
Ils servent &`a attirer l'eau pollu&'ee.
}
//	<<<ENGLISH>>>
//	Those are piles to draw up
//	the polluted seawater.

/*フェンスのあちこちに尖塔が立ってる
でしょ。それが汚染海水をくみ上げる
ためのパイル。
*/
ローズ_005: {
L'eau recueillie est achemin&'ee &`a
la salle des pompes de l'Etai A
}
//	<<<ENGLISH>>>
//	Gathered seawater is carried to
//	the pump room in Strut A first,
//<ページ数変更>
ローズ_005_1: {
et les d&'echets sont amass&'es dans le
Bassin de s&'edimentation n°1 de l'Etai D.
}
//	<<<ENGLISH>>>
//	all of the larger garbage is collected
//	in Sediment Pool No. 1 of Strut D.

/*くみ上げられた海水はＡ脚のポンプ室を
通って、一度Ｄ脚にある第一沈殿槽に
溜められて大きなゴミを取り除かれる。
*/
ローズ_006: {
Les d&'echets sont ensuite purifi&'es
dans la r&'eserve d'eau du noyau
de la Shell 2,
}
//	<<<ENGLISH>>>
//	This is followed by a two-step
//	purification process in the Shell 2
//	core water reserve＃−
//<ページ数変更>
ローズ_006_1: {
o&`u le p&'etrole est absorb&'e
par des microbes.
}
//	<<<ENGLISH>>>
//	in which oil is removed by microbes. 

/*その後シェル２中央棟にある貯水槽で
微生物を使った二段階の浄化をされて
原油が取り除かれる。
*/
ローズ_007: {
Les d&'echets sont ensuite exp&'edi&'es
&`a l'Etai L et st&'erilis&'es
}
//	<<<ENGLISH>>>
//	Then it is sent to
//	Strut L and sterilized,
//<ページ数変更>
ローズ_007_1: {
avant d'&^etre rel&^ach&'es dans la Baie.
}
//	<<<ENGLISH>>>
//	and finally once again carried
//	to the surface piles and flushed
//	back into the bay.

/*そしてＬ脚に送られて殺菌された後、
もう一度海上のパイルに送られて
放流されるって流れ。
*/
ライデン_008: {
Est-ce que la base de donn&'ees de l'arm&'ee
parle &'egalement du dispositif de filtration
de l'&'ecosyst&`eme marin ?
}
//	<<<ENGLISH>>>
//	Did the military database include
//	information on the marine filtration
//	facility's structure as well?

/*軍のデータベースには海上除染施設の
構造まで入力されてるのか。
*/
ローズ_009: {
Non. Je ne l'ai pas consult&'ee.
}
//	<<<ENGLISH>>>
//	No. I didn't use the database.

/*いいえ。データベースは使ってないわ。*/
ライデン_010: {
Ah bon ?
}
//	<<<ENGLISH(2)>>>
//	Huh?

/*え？*/
ローズ_011: {
J'ai utilis&'e une brochure...
}
//	<<<ENGLISH>>>
//	I used a brochure.

/*パンフレットに載ってたの。*/
//dv}//v
}//d


//Ａ脚の役割について h //e
resource PC_Ａ脚機能説明__f {
//vox t:vc266411 {
ローズ_000: {
L'Etai A fonctionne comme une pompe
et fournit l'&'energie n&'ecessaire pour faire
circuler
}
//	<<<ENGLISH>>>
//	Strut A is a pump facility that supplies
//	the energy to circulate the polluted
//	water drawn from the sea＃−
//<ページ数変更>
ローズ_000_1: {
l'eau pollu&'ee pr&'elev&'ee dans la mer
vers chaque section de la Big Shell.
}
//	<<<ENGLISH>>>
//	throughout each of the
//	Big Shell's sections.

/*Ａ脚は汚染海水を海上からくみ上げ、
『ビッグ・シェル』各部を巡回させる
ための動力を供給するポンプ施設ね。
*/
ローズ_001: {
Le c&^ot&'e sud constitue la pompe
proprement dite tandis que le c&^ot&'e
nord est une salle de commande.
}
//	<<<ENGLISH>>>
//	The south side is the actual pump
//	facility itself, while the north side
//	is the control room.

/*南側がポンプ施設本体、
北側がその制御施設になってる。
*/
//dv}//v
}//d

//Ｂ脚の役割について h //e
resource PC_Ｂ脚機能説明__f {
//vox t:vc266421 {
ローズ_000: {
L'Etai B est une g&'en&'eratrice qui fait
tourner la Big Shell. Le premier &'etage
est sa sous-station.
}
//	<<<ENGLISH>>>
//	Strut B is a generator facility that
//	generates electricity for the Big
//	Shell. The first floor is its substation.

/*Ｂ脚は『ビッグ・シェル』の
電力をまかなう発電施設なの。
１Ｆはそのための変電設備ね。
*/
//dv}//v
}//d


//Ｃ脚の役割について h //e
resource PC_Ｃ脚機能説明__f {
//vox t:vc266431 {
ローズ_000: {
L'Etai C est une zone r&'esidentielle.
C'est l&`a que vivent les employ&'es
de la Big Shell.
}
//	<<<ENGLISH>>>
//	Strut C is the Residential Area.
//	It supports life at sea for all of
//	the workers on the Big Shell. 

/*Ｃ脚は居住区。『ビッグ・シェル』
職員の洋上生活を支えるための施設。
*/
ローズ_001: {
Cela dit, presque tous les syst&`emes sont
enti&`erement automatiques, ce qui fait qu'il
y a peu d'employ&'es.
}
//	<<<ENGLISH>>>
//	That being said, almost all systems are
//	completely automated, so there aren't
//	many workers to be found.

/*といっても、『ビッグ・シェル』は
全システムがほぼ自動化されているから
職員の数は少ないんだけど。
*/
//dv}//v
}//d


//Ｄ脚の役割について h //e
resource PC_Ｄ脚機能説明__f {
//vox t:vc266441 {
ローズ_000: {
L'Etai D est le Bassin
de s&'edimentation n°1.
}
//	<<<ENGLISH>>>
//	Strut D is Sediment Pool No. 1.
//<ページ数変更>
ローズ_000_1: {
C'est l&`a que l'eau pollu&'ee est stock&'ee.
Une fois que les substances polluantes
}
//	<<<ENGLISH>>>
//	It's a facility where extracted
//	polluted water is stored without
//	being disturbed＃−
//<ページ数変更>
ローズ_000_2: {
se sont d&'epos&'ees,
elles sont retir&'ees.
}
//	<<<ENGLISH>>>
//	so that its large pollutants settle
//	and are purged from it.

/*Ｄ脚は第一沈殿池。くみ上げた
汚染海水を静かに溜めて大きなゴミを
沈殿させ、除去するための施設ね。
*/
//dv}//v
}//d


//Ｅ脚の役割について h //e
resource PC_Ｅ脚機能説明１__f {
//vox t:vc266451 {
ローズ_000: {
Le toit de l'Etai E comprend un h&'eliport.
}
//	<<<ENGLISH>>>
//	The Strut E roof
//	functions as a heliport,
//<ページ数変更>
ローズ_000_1: {
L'int&'erieur est utilis&'e pour le transport
a&'erien des mat&'eriaux aux autres &'etais.
}
//	<<<ENGLISH>>>
//	while inside it serves as an aerial
//	transport hub for materials to each
//	of the other struts.

/*Ｅ脚は屋上がヘリポート、
内部が空輸された資材を各脚に
送り出す施設。
*/
//dv}//v
}//d
//屋上の場合 t //e
resource PC_Ｅ脚機能説明＿屋上__f {
//vox t:vc266461 {
ローズ_000: {
Ses entr&'ees maritimes &'etant
bloqu&'ees par des barri&`eres flottantes,
}
//	<<<ENGLISH>>>
//	Because its sea entrances
//	are cut off by oil fences＃−
//<ページ数変更>
ローズ_000_1: {
tr&`es peu de marchandises sont
achemin&'ees &`a la Big Shell par mer.
}
//	<<<ENGLISH>>>
//	there is hardly any transportation
//	of goods into the Big Shell by
//	seafaring vessels.

/*海上がオイルフェンスで閉鎖されている
から、船による『ビッグ・シェル』への
物資輸送はほとんど行われていないの。
*/
ローズ_001: {
Presque tous les mat&'eriaux arrivent
&`a la Big Shell par avion.
}
//	<<<ENGLISH>>>
//	Almost all of the materials brought
//	in are via the roof heliport.

/*ほぼ全ての物資が屋上のヘリポートから
持ち込まれるというわけね。
*/
//dv}//v
}//d

//屋内の場合 t //e
resource PC_Ｅ脚機能説明＿集配場__f {
//vox t:vc266471 {
ローズ_000: {
L'int&'erieur de l'Etai E comprend
un syst&`eme de tri automatis&'e.
}
//	<<<ENGLISH>>>
//	Inside Strut E is an automated
//	system to sort materials.

/*Ｅ脚内部には物資を自動でよりわける
システムが完備されているわ。
*/
ローズ_001: {
Il reconna&^it les bo&^ites en carton et les trie.
}
//	<<<ENGLISH>>>
//	It recognizes cardboard boxes
//	and separates them appropriately.
//<ページ数変更>
ローズ_001_1: {
Gr&^ace &`a l'acheminement automatique
des paquets, on a r&'eussi &`a faire de
grosses &'economies de personnel.
}
//	<<<ENGLISH>>>
//	By automatically delivering packages
//	to each strut efforts have been made
//	to streamline manpower.

/*ダンボール箱を認識して判別している
みたい。自動で荷物を各脚に配送する
ことで省人力化を図っているってことね。
*/
//dv}//v
}//d

//Ｆ脚の役割について h //e
resource PC_Ｆ脚機能説明__f {
//vox t:vc266481 {
ローズ_000: {
L'Etai F est un centre de stockage.
}
//	<<<ENGLISH>>>
//	Strut F is the storage center.
//<ページ数変更>
ローズ_000_1: {
De nombreux mat&'eriaux de maintenance
y sont entrepos&'es.
}
//	<<<ENGLISH>>>
//	I think a variety of materials for
//	maintenance of the Big Shell are
//	stored there.

/*Ｆ脚は倉庫。『ビッグ・シェル』の
メンテナンス用に様々な資材が
備蓄されていると思う。
*/
ローズ_001: {
Tu trouveras peut-&^etre des choses
utiles. Pourquoi ne vas-tu pas jeter
un coup d'&@eil ?
}
//	<<<ENGLISH>>>
//	There might be something that
//	would come in handy. Why don't
//	you look around?

/*あなたの役に立つものもあるかも
しれない。探してみたら？
*/
//dv}//v
}//d


//シェル１中央棟の役割について h //e
resource PC_シェル１中央棟機能説明__f {
//vox t:vc266491 {
ローズ_000: {
Le noyau de la Shell 1 est
le centre de la Big Shell.
}
//	<<<ENGLISH>>>
//	The Shell 1 Core is what its name
//	implies: the center of the Big Shell.

/*シェル１中央棟は文字どおり
『ビッグ・シェル』の中心ね。
*/
ローズ_001: {
Le premier &'etage de la cave est
une salle de r&'eunion spacieuse.
}
//	<<<ENGLISH>>>
//	The first basement floor is
//	a capacious meeting hall.
//<ページ数変更>
ローズ_001_1: {
Je suis s&^ure qu'ils l'ont utilis&'e pour
la r&'eception de bienvenue du Pr&'esident
}
//	<<<ENGLISH>>>
//	I'm sure that's where they
//	held the welcome reception
//	for the President＃−
//<ページ数変更>
ローズ_001_2: {
et de l'&'equipe d'inspection de
l'environnement.
}
//	<<<ENGLISH>>>
//	and the environmental
//	protection inspection
//	team. 

/*Ｂ１には大規模な＃｛集会場、ホール｝＃がある。
そこで大統領と環境保護視察団の歓迎
レセプションが行われたはずよ。
*/
ローズ_002: {
Mais sa fonction de base est au
deuxi&`eme &'etage de la cave, dans
la salle des ordinateurs.
}
//	<<<ENGLISH>>>
//	But its core function is concentrated
//	in the second basement floor Computer
//	Room.

/*でもその機能の中枢はＢ２にある
電算室に集約されてるの。
*/
ローズ_003: {
C'est dans la salle des ordinateurs que
le flux de l'eau pollu&'ee et l'&'etat de filtration
sont surveill&'es.
}
//	<<<ENGLISH>>>
//	This computer room is where the
//	flow of polluted water and the
//	status of filtration is observed,
//<ページ数変更>
ローズ_003_1: {
C'est &'egalement &`a cet endroit qu'on
effectue toutes les t&^aches importantes.
}
//	<<<ENGLISH>>>
//	in addition to being where all tasks
//	for other facilities are carried out. 

/*この電算室で汚染海水の循環や除染
状態の監視等、各施設の管理を全て
行うようになってる。
*/
ローズ_004: {
Je comprends pourquoi la s&'ecurit&'e
est serr&'ee !
}
//	<<<ENGLISH>>>
//	I can understand why
//	security is so tight.

/*警備が厳重なのもうなずけるわね。
*/
//dv}//v
}//d

//シェル２中央棟の役割について h //e
resource PC_シェル２中央棟機能説明__f {
//vox t:vc266501 {
ローズ_000: {
Le noyau de la Shell 2 abrite
le syst&`eme de filtration.
}
//	<<<ENGLISH>>>
//	The Shell 2 Core is where the
//	actual filtration system resides,
//	or at least it used to.
//<ページ数変更>
ローズ_000_1: {
Mais il faut en parler au pass&'e.
Cet endroit n'est que l'ombre de
ce qu'il &'etait.
}
//	<<<ENGLISH>>>
//	Now it's just a shadow
//	of its former self.

/*シェル２中央棟は汚染海水を除染する
システムの本体……だった。
今は見る影もないけど……。
*/
ローズ_001: {
A cet endroit, l'eau m&'elang&'ee au p&'etrole
brut &'etait filtr&'ee
}
//	<<<ENGLISH>>>
//	Here water mixed with
//	crude oil was filtered＃−
//<ページ数変更>
ローズ_001_1: {
par des bact&'eries de d&'ecomposition
microbienne des hydrocarbures. 
}
//	<<<ENGLISH>>>
//	using antagonist bacteria in
//	the microbial decomposition
//	of hydrocarbons.

/*炭化水素分解細菌等の微生物を使って、
くみ上げた原油混じりの海水を
除染する施設。
*/
ローズ_002: {
Sous la cave du premier &'etage,
il y a un bac gigantesque &`a cet effet.
}
//	<<<ENGLISH>>>
//	Below the first floor basement is
//	a gigantic vat for this purpose.
//<ページ数変更>
ローズ_002_1: {
Mais il s'est cass&'e et a inond&'e tout l'&'etage.
}
//	<<<ENGLISH>>>
//	What happened was that this
//	vat broke and flooded the floor.

/*Ｂ１以下はそのための巨大な水槽に
なっていたの。それが壊れて浸水
してるってわけね。
*/
ローズ_003: {
Le premier &'etage, qui n'est pas inond&'e,
}
//	<<<ENGLISH>>>
//	The first floor, which is not flooded,
//	houses the air purification facility＃−
//<ページ数変更>
ローズ_003_1: {
abrite le dispositif de purification qui
&'elimine les odeurs provenant de l'eau
pollu&'ee.
}
//	<<<ENGLISH>>>
//	that eliminates the stench
//	from the polluted water.

/*浸水していない１Ｆは汚染海水の悪臭を
除去するための空気清浄施設。
*/
ローズ_004: {
Manhattan est tout pr&`es d'ici, tu sais.
Il est normal de prendre toutes ces
pr&'ecautions.
}
//	<<<ENGLISH>>>
//	Manhattan is right in our backyard
//	here, you know. There's plenty of
//	reason to be cautious.

/*マンハッタンのすぐ近くだもの。
気を使うことが多いみたいね。
*/
//dv}//v
}//d

//Ｌ脚の役割について h //e
resource PS_Ｌ脚機能説明__f {
//vox t:vc266511 {
ローズ_000: {
Auparavant, l'&'etai L servait &`a
traiter les effluents.
}
//	<<<ENGLISH>>>
//	Strut L used to be the effluent
//	processing facility.

/*Ｌ脚は汚水処理施設……だった。
*/
ローズ_001: {
C'est l&`a, je crois, que l'on a trait&'e l'eau
d&'econtamin&'ee avec du chlore et d'autres
produits chimiques
}
//	<<<ENGLISH>>>
//	It appears to be where sea water
//	expunged of oil was treated with
//	chlorine and other chemicals＃−
//<ページ数変更>
ローズ_001_1: {
afin de la st&'eriliser, de la d&'esinfecter
et de la rejeter dans la mer.
}
//	<<<ENGLISH>>>
//	to sterilize and disinfect the water
//	so that it could be made suitable
//	for flushing back into the ocean.

/*原油を取り除いた海水を塩素等の化学
薬品を使って殺菌・消毒して放流可能な
状態にするための施設だったみたいね。
*/
//dv}//v
}//d



//大佐発狂中会話 d //e
//ゲームオーバーが多い場合 h //e
resource PC_発狂＿ゲームオーバー回数__f {
//vox t:vc266671 {
大佐_000: {
Il y a quelque temps, j'ai remarqu&'e que
tu accumulais les d&'efaites.
}
