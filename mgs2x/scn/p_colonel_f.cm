//	option, unfortunately for us.

/*それ以外に方法がないのが事実だ。
残念ながらな。
*/
ライデン_003: {
Je me ferai mon id&'ee sur place,
n'est-ce pas ?
}
//	<<<ENGLISH>>>
//	I'll understand once I go
//	to see him then, right?

/*行ってみればわかるということか……。
*/
//dv}//v
}//d



//エイムズについて h //e
resource PC_エイムズ１__f {
//vox t:vc265971 {
ライデン_000: {
Colonel, qui est cet Ames, au juste ?
}
//	<<<ENGLISH(2)>>>
//	Colonel, who's that person Ames?

/*大佐、エイムズというのは何者なんだ？*/
//dv}//v
}//d
resource PC_エイムズ２__f {
//vox t:vc265981 {
ローズ_000: {
J'ai consult&'e le dossier des membres
du Service secret travaillant aupr&`es du
Pr&'esident...
}
//	<<<ENGLISH>>>
//	I checked the roster of Secret
//	Service members serving the
//	President.
//<ページ数変更>
ローズ_000_1: {
Il y avait bien un d&'enomm&'e Ames
sur la liste.
}
//	<<<ENGLISH>>>
//	There was definitely a person
//	on the list named Ames.

/*大統領に随伴したシークレットサービス
の名簿を調べてみた。確かにエイムズっ
ていういう名前があるわ。
*/
大佐_001: {
Alors le Ninja n'a pas menti, apr&`es tout !
}
//	<<<ENGLISH>>>
//	So what that Ninja said, then,
//	was not a lie after all.

/*あの忍者の言ったことは嘘ではなかった
ということだな。
*/
ライデン_002: {
Pour ce qui concerne cette liste, tu
as raison. Tu as d'autres informations,
Rose?
}
//	<<<ENGLISH>>>
//	As far as the roster goes, no.
//	Rose, do you have any other
//	information?

/*リストの上ではな。
ローズ、他に情報は？
*/
ローズ_003: {
Ah ! Je vais me
renseigner !
}
//	<<<ENGLISH>>>
//	All right. I'll look
//	into it for you.

/*わかった。調べてみる。
*/
ライデン_004: {
Je compte sur toi !
}
//	<<<ENGLISH(2)>>>
//	I'm counting on you.

/*頼む。*/
//dv}//v
}//d
//エイムズしばらくしてから h //e
resource PC_エイムズ２＿２__f {
//vox t:vc265991 {
大佐_000: {
Raiden, Rosemary t'a pr&'epar&'e
un rapport sur Ames.
}
//	<<<ENGLISH>>>
//	Raiden, Rosemary has
//	a report for you, on Ames.

/*ライデン、ローズ君から報告がある。
エイムズについてだ。
*/
//dv}//v
}//d
resource PC_エイムズ３__f {
//vox t:vc266001 {
ローズ_000: {
Jack ? C'est &`a propos d'Ames !
}
//	<<<ENGLISH>>>
//	Jack? It's about Ames.

/*ジャック？
エイムズのことだけど……。*/
ライデン_001: {
Tu as trouv&'e quelque chose ?
}
//	<<<ENGLISH(2)>>>
//	Did you find anything?

/*何かわかったか？*/
ローズ_002: {
Oui ! En fait, il n'y avait rien &`a trouver !
}
//	<<<ENGLISH>>>
//	Yeah. Only that there
//	is nothing to find.

/*ええ。
何もわからないってことがわかった。
*/
ライデン_003: {
Quoi ?
}
//	<<<ENGLISH(2)>>>
//	What?

/*なんだって？*/
ローズ_004: {
Aucune trace de cet homme. Pas de
num&'ero de s&'ecu, pas d'adresse,
pas de pass&'e ! Pas de sexe,
}
//	<<<ENGLISH>>>
//	There is not a single record.
//	Let alone his social security
//	number, address, or background,
//<ページ数変更>
ローズ_004_1: {
pas d'&^age. Pas m&^eme un nom entier !
}
//	<<<ENGLISH>>>
//	I couldn't even find Ames'
//	gender, age, or full name...

/*記録が何もないの。社会保障番号や
住所、経歴はおろか、性別も年齢も
フルネームさえ……。
*/
ライデン_005: {
Qu'est-ce que cela signifie ?
}
//	<<<ENGLISH>>>
//	What does that mean?

/*どういうことだ？*/
ローズ_006: {
Je n'ai trouv&'e que le mot 'Ames'.
Rien d'autre !
}
//	<<<ENGLISH>>>
//	All I found out was "Ames,"
//	just that one word.

/*わからない。わかったのはエイムズ。
その一語だけ。
*/
ライデン_007: {
...
}
//	<<<ENGLISH>>>
//	...

/*……。*/
//dv}//v
}//d
resource PC_エイムズ４__f {
//vox t:vc266011 {
大佐_000: {
Mais Ames nous m&`enera au
Pr&'esident. Il faut le contacter.
}
//	<<<ENGLISH>>>
//	Even still, Ames is our way
//	to the President. We'll have
//	to make contact.
//<ページ数変更>
大佐_000_1: {
Rends-toi au niveau B1 du noyau
de la Shell 1.
}
//	<<<ENGLISH>>>
//	Head for Floor B1 in
//	the core of Shell 1.

/*それでも大統領への手がかりはエイムズ
だけだ。接触してみるしかない。
シェル１中央棟のＢ１に向かうんだ。
*/
//dv}//v
}//d

//核について h //e
resource PC_核について__f {
//vox t:vc266021 {
ライデン_000: {
Colonel... La rumeur sur le Metal Gear
de la Big Shell...
}
//	<<<ENGLISH>>>
//	Colonel -- the stories about
//	a Metal Gear within the Big
//	Shell...

/*大佐、この『ビッグ・シェル』に
メタルギアがあるって話は……。
*/
大佐_001: {
Nous &'etudions la question...
}
//	<<<ENGLISH>>>
//	That is still being looked into.

/*まだ調査中だ。*/
ローズ_002: {
Je suis d&'esol&'ee, Jack !
}
//	<<<ENGLISH>>>
//	Sorry, Jack.

/*ごめんなさい、ジャック。*/
ライデン_003: {
Et le fait que la Big Shell ne serait
qu'une couverture ?
}
//	<<<ENGLISH>>>
//	And stories that the Big
//	Shell is just a cover?

/*『ビッグ・シェル』が偽装だという
話も？
*/
ローズ_004: {
D'apr&`es tous les papiers que j'ai vus,
c'est vraiment une installation de
d&'econtamination...
}
//	<<<ENGLISH>>>
//	Well, every record I've looked
//	through only ever has it as＃−
//<ページ数変更>
ローズ_004_1: {
Rien ne m'a l'air trafiqu&'e !
}
//	<<<ENGLISH>>>
//	a legitimate offshore
//	decontamination facility.
//	On paper, it's clean.

/*ええ。どの記録を見てもれっきとした
海上除染施設ということになってる。
記録上、疑う余地はないんだけど……。
*/
ライデン_005: {
Tu es en train de me dire que nous
sommes oblig&'es de faire confiance
&`a Ames ?
}
//	<<<ENGLISH>>>
//	So you're saying that we have
//	no choice but to talk to Ames
//	or whoever else?

/*エイムズとやらに直接聞くしかない、
ということか……。
*/
//dv}//v
}//d

