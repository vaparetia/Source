//	Use the remote-controlled missile
//	to destroy the power source.
//<ページ数変更>
大佐_001_1: {
pour couper le courant &`a haute tension
qui passe dans le sol.
}
//	<<<ENGLISH>>>
//	That will cut off the high-voltage
//	current to the floor.

/*リモコンミサイルで部屋の中の
電源パネルを破壊すれば、高圧電流も
消えるはずだ。
*/
//dv}//v
}//d

