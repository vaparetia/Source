	d:KMM_MOT_IDLE02, d:KMM_MOT_IDLE02, d:KMM_MOT_IDLE02, d:KMM_MOT_IDLE02, d:KMM_MOT_IDLE02, \  
	d:KMM_MOT_IDLE02, d:KMM_MOT_IDLE02, d:KMM_MOT_IDLE02, d:KMM_MOT_IDLE02, d:KMM_MOT_IDLE02, \  
	d:KMM_MOT_IDLE02, d:KMM_MOT_FLYING, d:KMM_MOT_FLYING, d:KMM_MOT_FLYING, d:KMM_MOT_FLYING, \  
	d:KMM_MOT_FLYING, d:KMM_MOT_FLYING, d:KMM_MOT_FLYING, d:KMM_MOT_FLYING, d:KMM_MOT_FLYING, \  
	d:KMM_MOT_FLYING, d:KMM_MOT_FLYING, d:KMM_MOT_FLYING, d:KMM_MOT_FLYING, d:KMM_MOT_FLYING, \  
	d:KMM_MOT_FLYING, d:KMM_MOT_FLYING, d:KMM_MOT_FLYING, d:KMM_MOT_FLYING, d:KMM_MOT_FLYING, \  
	d:KMM_MOT_FLYING, d:KMM_MOT_FLYING, d:KMM_MOT_FLYING, d:KMM_MOT_FLYING, d:KMM_MOT_FLYING, \  
	d:KMM_MOT_FLYING, d:KMM_MOT_FLYING, d:KMM_MOT_FLYING, d:KMM_MOT_FLYING, d:KMM_MOT_FLYING  \  

	d:KMM_MOT_IDLE02, d:KMM_MOT_IDLE02, d:KMM_MOT_IDLE02, d:KMM_MOT_IDLE02, d:KMM_MOT_IDLE02, \  
