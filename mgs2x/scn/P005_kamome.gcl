// 002 北低   004 低エリア検索用   008 非難エリア   013 非難エリア検索用
// 011 南高
// 003 北高


proc w12a_かもめ_40
{
#if d:DEBUG_PRINT
	print '*** Seagull 40 ***'
#endif

// ↓水谷さん。1にして下さい。
#if 1

	// 穴向こうのかもめの飛び立つ方向は、ランダムで決める
	#if 1
	// デモで穴向こうに置いたかもめは、東＞北＞西、方向のいずれかへ飛び立つ。
	eval($i:k40_y = 1024 + `%rand 2048`)
	eval($i:k41_y = 1024 + `%rand 2048`)
	eval($i:k42_y = 1024 + `%rand 2048`)
	eval($i:k43_y = 1024 + `%rand 2048`)
	eval($i:k44_y = 1024 + `%rand 2048`)
	eval($i:k45_y = 1024 + `%rand 2048`)
	eval($i:k46_y = 1024 + `%rand 2048`)
	eval($i:k47_y = 1024 + `%rand 2048`)
	eval($i:k48_y = 1024 + `%rand 2048`)
	eval($i:k49_y = 1024 + `%rand 2048`)
	eval($i:k50_y = 1024 + `%rand 2048`)
	eval($i:k51_y = 1024 + `%rand 2048`)
	eval($i:k52_y = 1024 + `%rand 2048`)
	eval($i:k53_y = 1024 + `%rand 2048`)
	eval($i:k54_y = 1024 + `%rand 2048`)

	#else
		command foreach -argc 1 -repeat 15 \
			-data { \
				$i:k40_y $i:k41_y $i:k42_y $i:k43_y $i:k44_y \
				$i:k45_y $i:k46_y $i:k47_y $i:k48_y $i:k49_y \
				$i:k50_y $i:k51_y $i:k52_y $i:k53_y $i:k54_y \
			} \
			-exec {
				// デモで穴向こうに置いたかもめは、東＞北＞西、方向のいずれかへ飛び立つ。
				eval($1 = 1024 + `%rand 2048`)
				}
			}
	#endif

    chara かもめマネージャ かもめ管理 \
	// モデルデータ名
	-datamdl kmo_noalp, kmo_low, kmo_low, kmo_low \ 

	// 平均速度
	-zspeed 55 \

	// 基本ルーチン
	-base d:KMNG_BASE_ESCAPE \	// 基本状態:敏感

	-yrot /* 初期Y方向 */ \
	4096 - 100, 500, 644, 711, 804, \
	4096 - 256, 400, 544, 811, 904, \
	 512, 1500, 3500, 1460, 2222, \
	 512, 2222, 2222,  720, 1500, \
	3500,  512,  720, 2222,  512, \
	2222, 2222, 2222, 2222,   55, \
	2222, 2222, 2222,   55, 2222, \
	3500,  512,  720, 2222,  720, \

	$i:k40_y, $i:k41_y, $i:k42_y, $i:k43_y, $i:k44_y, \	// 穴向こう
	$i:k45_y, $i:k46_y, $i:k47_y, $i:k48_y, $i:k49_y, \	// 穴向こう
	$i:k50_y, $i:k51_y, $i:k52_y, $i:k53_y, $i:k54_y, \	// 穴向こう

	// かもめの名前
	-name \ 
	Kamome00, Kamome01, Kamome02, Kamome03, Kamome04, \		// 穴前
	Kamome05, Kamome06, Kamome07, Kamome08, Kamome09, \		// 穴前
	Kamome10, Kamome11, Kamome12, Kamome13, Kamome14, \		// 北西
	Kamome15, Kamome16, Kamome17, Kamome18, Kamome19, \		// 北西
	Kamome20, Kamome21, Kamome22, Kamome23, Kamome24, \		// 北東
	Kamome25, Kamome26, Kamome27, Kamome28, Kamome29, \		// 北東
	Kamome30, Kamome31, Kamome32, Kamome33, Kamome34, \		// 南西
	Kamome35, Kamome36, Kamome37, Kamome38, Kamome39, \		// 南東

	Kamome40, Kamome41, Kamome42, Kamome43, Kamome44, \		// 穴向こう
	Kamome45, Kamome46, Kamome47, Kamome48, Kamome49, \		// 穴向こう
	Kamome50, Kamome51, Kamome52, Kamome53, Kamome54, \		// 穴向こう

	// エリア指定型初期位置
	-farea \   /* 初期位置エリア指定 */
	-5500, 5000, -11000, -5000, 5000, -10500, \		// 穴前
	-5000, 5000, -11000, -4500, 5000, -10500, \

	-4000, 5000, -16000, 4000, 5000, -14500, \		// 穴向こう

	// 線指定型初期位置
	-linepos \ /* 初期位置線指定 */
	-3800, 6000, -15850,  3800, 6000, -15850, \		// 北フェンス

	 9000, 7500,  -3000,  9000, 7500,  -1500, \		// 南東
	 9000, 7500,  -1500,  7500, 7500,      0, \
	 7500, 7500,      0, -1500, 7500,      0, \

	-9000, 7500,  -3000, -9000, 7500,  -1500, \		// 南西
	-9000, 7500,  -1500, -7500, 7500,      0, \
	-7500, 7500,      0, -4875, 7500,      0, \

	 9000, 7500,  -9750,  9000, 7500, -12500, \		// 北東
	 9000, 7500, -12500,  7500, 7500, -14000, \
	 7500, 7500, -14000,  4000, 7500, -14000, \

	 5750, 7500,  -9750,  5750, 7500, -11500, \		// 北東
	 5750, 7500, -11500,  3875, 7500, -11500, \
	 3875, 7500, -11500,  3875, 7500, -16000, \

	-5750, 7500,  -9750, -5750, 7500, -11500, \		// 北西
	-5750, 7500, -11500, -3875, 7500, -11500, \
	-3875, 7500, -11500, -3875, 7500, -16000, \

	// 初期位置指定フラグ
	-unitpos \	/* 位置指定用番号 0〜32*/
	(d:KMM_IPOS_AREA | 0x00), (d:KMM_IPOS_AREA | 0x00), (d:KMM_IPOS_AREA | 0x00), (d:KMM_IPOS_AREA | 0x00), (d:KMM_IPOS_AREA | 0x00), \
	(d:KMM_IPOS_AREA | 0x01), (d:KMM_IPOS_AREA | 0x01), (d:KMM_IPOS_AREA | 0x01), (d:KMM_IPOS_AREA | 0x01), (d:KMM_IPOS_AREA | 0x01), \
	(d:KMM_IPOS_AREA | 0x01), (d:KMM_IPOS_LINE | 0x00), (d:KMM_IPOS_LINE | 0x00), (d:KMM_IPOS_LINE | 0x00), (d:KMM_IPOS_LINE | 0x00), \
	(d:KMM_IPOS_LINE | 0x0d), (d:KMM_IPOS_LINE | 0x0d), (d:KMM_IPOS_LINE | 0x0e), (d:KMM_IPOS_LINE | 0x0e), (d:KMM_IPOS_LINE | 0x0f), \
	(d:KMM_IPOS_LINE | 0x07), (d:KMM_IPOS_LINE | 0x08), (d:KMM_IPOS_LINE | 0x08), (d:KMM_IPOS_LINE | 0x09), (d:KMM_IPOS_LINE | 0x0a), \
