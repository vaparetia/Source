	(d:KMM_FLYA_TRAP | 0x02), (d:KMM_FLYA_TRAP | 0x00), (d:KMM_FLYA_TRAP | 0x02), (d:KMM_FLYA_TRAP | 0x00), (d:KMM_FLYA_TRAP | 0x02), \
	(d:KMM_FLYA_TRAP | 0x00), (d:KMM_FLYA_TRAP | 0x02), (d:KMM_FLYA_TRAP | 0x00), (d:KMM_FLYA_TRAP | 0x02), (d:KMM_FLYA_TRAP | 0x00), \
