	(d:KMM_IPOS_AREA | 0x02), (d:KMM_IPOS_AREA | 0x02), (d:KMM_IPOS_AREA | 0x02), (d:KMM_IPOS_AREA | 0x02), (d:KMM_IPOS_AREA | 0x02), \
	(d:KMM_IPOS_AREA | 0x02), (d:KMM_IPOS_AREA | 0x02), (d:KMM_IPOS_AREA | 0x02), (d:KMM_IPOS_AREA | 0x02), (d:KMM_IPOS_AREA | 0x02), \
	(d:KMM_IPOS_AREA | 0x02), (d:KMM_IPOS_AREA | 0x02), (d:KMM_IPOS_AREA | 0x02), (d:KMM_IPOS_AREA | 0x02), (d:KMM_IPOS_AREA | 0x02), \

	// 飛行エリアトラップ列
	-traparea \
	        ev002 ev011 ev003 \		// 002 北低、011 南高、003 北高
	// 飛行エリアインデックス
	-indexarea \
