// 定義 
// ====================================

// 特殊アイテム入手条件
//---------------------
// タンカー編でのドッグタグ収集率
#define	TNKER_TAG_PER_BANDANA		30	// バンダナ入手条件（％）
#define	TNKER_TAG_PER_STELTH		50	// タンカーステルス入手条件（％）

// プラント編でのドッグタグ収集率
#define	PLANT_TAG_PER_WIG_BROWN		30	// 無限弾薬カツラ入手条件（％）
#define	PLANT_TAG_PER_STELTH		50	// プラントステルス入手条件（％）
#define	PLANT_TAG_PER_WIG_ORANGE	70	// 無限握力カツラ入手条件（％）
#define	PLANT_TAG_PER_WIG_BLUE		90	// 無限Ｏ２カツラ入手条件（％）


// インクルード 
// ====================================
#include "stdch.h"
#include "sload.h"
#include "sound.h"
#include "commdef.h"
#include "dogtag_view.h"
#include "ending.rsc"

command メニュー設定 -radio off -gage off -radar off

// 本体 
// ====================================
command ローカルリソース設定 \
	-binary ドッグタグデータ[dogtag_view:*]


eval( $w:コンフィグ設定 = $w:コンフィグ設定 | d:CONFIG_PLAYTIME_STOP ) // 時間よとまれ

// by koba4
if(($w:タイトルメニュー設定 & d:TITLE_MENU_STORY_SEL_MASK) == d:TITLE_MENU_STORY_SEL_TANKER ) {
	// タンカー編 -------------------------------------
	if ( $w:t_story < d:ST_PASSクリアコード表示開始 ) {
		@結果画面表示;
	} else {
		@タイトルへ戻す
	}
} else {
	// プラント編 -------------------------------------
	if ( $w:p_story < d:ST:P082_08_M03エンディング８ムービーデモ３開始 ) {
		eval( $w:p_story = d:ST:P082_11_PASSエンディング１１パスワード表示１開始 )
		@結果画面表示;
	} else if ( $w:p_story == d:ST:P082_08_M03エンディング８ムービーデモ３開始 ) {
		@タイトルへ戻す
//		@カレン北条レポート
	}
}

// -------------------------------------------------------
// -------------------------------------------------------
// -------------------------------------------------------
// -------------------------------------------------------
// -------------------------------------------------------
// -------------------------------------------------------
// -------------------------------------------------------
// -------------------------------------------------------
proc クリアコード表示シーケンス {
	// クリア回数をインクリメント

	eval( $w:クリア回数 = $w:クリア回数 + 1 );
	@クリア時状況変数設定
	@クリアコード表示シーケンス開始処理
	@デジカメ取得条件判定
	@クリアコードの生成
	@クリアコード表示
	// クリアコード、取得アイテム表示終了後
	// セーブダイアログ表示してリスタートする

	command varsave
}

// -------------------------------------------------------
// クリア時状況変数設定
// -------------------------------------------------------
proc クリア時状況変数設定 {
	// バージョン情報
	// ----------------------------------------------
	#ifndef d:PAL
		#ifdef d:KOREA
			eval( $b:バージョン情報 = 3 ) ;	// 韓国版
		#elseifdef d:ENGLISH
			eval( $b:バージョン情報 = 0 ) ;	// 英語版
		#else
			eval( $b:バージョン情報 = 1 ) ;	// 日本語版
		#endif
	#else
		eval( $b:バージョン情報 = 2 ) ;		// 欧州版
	#endif

	// 特殊アイテム使用したかどうか？
	// ----------------------------------------------
	if ( $w:クリアーコードフラグ & d:CLEAR_SPECIAL_ITEM_USED ) {
		eval($f:特殊アイテム使用した = 1 ) ;
	} else {
		eval($f:特殊アイテム使用した = 0 ) ;
	}

	// ポスター見た回数
	// ----------------------------------------------
	eval( $b:ポスター観察回数 = 0 ) ; 	// 未使用とする

	// レーダー
	// ----------------------------------------------
	if ( $w:クリアーコードフラグ & d:CLEAR_RADAR_USED ) {
		eval($f:レーダーフラグ = 1 ) ;
	} else {
		eval($f:レーダーフラグ = 0 ) ;
	}
}

// -------------------------------------------------------
// クリアコードシーケンス開始/終了処理
// -------------------------------------------------------
proc クリアコード表示シーケンス開始処理 {
	if(($w:タイトルメニュー設定 & d:TITLE_MENU_STORY_SEL_MASK) == d:TITLE_MENU_STORY_SEL_TANKER ) {
		eval( $w:t_story = d:ST_PASSクリアコード表示開始 )
	} else {
		eval( $w:p_story = d:ST:P082_11_PASSエンディング１１パスワード表示１開始 )
	}
}

proc クリアコード表示シーケンス終了処理 {
	if(($w:タイトルメニュー設定 & d:TITLE_MENU_STORY_SEL_MASK) == d:TITLE_MENU_STORY_SEL_TANKER ) {
		eval( $w:t_story = d:ST_PASSクリアコード表示終了 )
	} else {
		eval( $w:p_story = d:ST:P082_11_PASSエンディング１１パスワード表示１終了 )
		eval( $w:p_story = d:ST:P082_08_M03エンディング８ムービーデモ３開始 ) ;
	}
	eval( $w:コンフィグ設定 = $w:コンフィグ設定 & ~d:CONFIG_PLAYTIME_STOP ) // 時間は動き出す
	@リスタート
}

// -------------------------------------------------------
// クリアコードの表示
// -------------------------------------------------------
proc クリアコード表示 {
	if(($w:タイトルメニュー設定 & d:TITLE_MENU_STORY_SEL_MASK) == d:TITLE_MENU_STORY_SEL_TANDP ) {
		eval( $b:ストーリーモード = 2 ) ;
	} else if (($w:タイトルメニュー設定 & d:TITLE_MENU_STORY_SEL_MASK) == d:TITLE_MENU_STORY_SEL_TANKER ) {
		eval( $b:ストーリーモード = 0 ) ;
	} else {
		eval( $b:ストーリーモード = 1 );
	}
	chara 新クリアコード表示 新クリアコード表示 \
		-p クリアコード表示終了 \
		-m $b:ストーリーモード \			// モード(0=tanker,1=plant,2=Tanker&Plant)
		-c $i:クリアコード１ $i:クリアコード２ \
		   $i:クリアコード３ $i:クリアコード４	\ // クリアコード
		-s 28	\ // クリアコード表示文字数
		-b 110 	// 入力ビット長さ
}
proc クリアコード表示終了 {
	@取得アイテム表示初期化
}

// -------------------------------------------------------
// 取得アイテム表示
// -------------------------------------------------------
proc 取得アイテム表示初期化 {
	eval( $f:取得アイテム表示最初 = 1 ) ;
	@取得ダイアログ表示０
}
proc 取得ダイアログ表示０ {
	if ($f:タンカー無限バンダナ取得 == 1) { 
		chara 取得アイテム表示 取得アイテム表示 \
			-p 取得ダイアログ表示１ \
			-i 0 \				 	// バンダナ
			-s $f:取得アイテム表示最初
		eval( $f:取得アイテム表示最初 = 0 ) ;
	} else {
		@取得ダイアログ表示１ ;
	}
}
proc 取得ダイアログ表示１ {
	if ($f:タンカーデジカメ取得 == 1) { 
		chara 取得アイテム表示 取得アイテム表示 \
			-p 取得ダイアログ表示２ \
			-i 1 \				 	// タンカーデジカメ
			-s $f:取得アイテム表示最初
		eval( $f:取得アイテム表示最初 = 0 ) ;
	} else {
		@取得ダイアログ表示２ ;
	}
}
proc 取得ダイアログ表示２ {
	if ($f:プラントデジカメ取得 == 1) { 
		chara 取得アイテム表示 取得アイテム表示 \
			-p 取得ダイアログ表示４ \
			-i 2 \				 	// プラントデジカメ
			-s $f:取得アイテム表示最初
		eval( $f:取得アイテム表示最初 = 0 ) ;
	} else {
		@取得ダイアログ表示４
	}
}
proc 取得ダイアログ表示４ {
	if ($f:タンカーステルス迷彩取得 == 1) { 
		chara 取得アイテム表示 取得アイテム表示 \
			-p 取得ダイアログ表示５ \
			-i 4 \					// タンカーステルス
			-s $f:取得アイテム表示最初
		eval( $f:取得アイテム表示最初 = 0 ) ;
	} else {
		@取得ダイアログ表示５;
	}
}
proc 取得ダイアログ表示５ {
	if ($f:プラントステルス迷彩取得 == 1) { 
		chara 取得アイテム表示 取得アイテム表示 \
			-p 取得ダイアログ表示６ \
			-i 5 \					// プラントステルス
			-s $f:取得アイテム表示最初
		eval( $f:取得アイテム表示最初 = 0 ) ;
	} else {
		@取得ダイアログ表示６ ;
	}
}
proc 取得ダイアログ表示６ {
	if ($f:プラント無限カツラ取得 == 1) { 
		chara 取得アイテム表示 取得アイテム表示 \
			-p 取得ダイアログ表示７ \
			-i 6 \					// 無限弾薬カツラ(茶色)
			-s $f:取得アイテム表示最初
		eval( $f:取得アイテム表示最初 = 0 ) ;
	} else {
		@取得ダイアログ表示７ ;
	}
}
proc 取得ダイアログ表示７ {
	if ($f:プラント腕力カツラ取得 == 1) { 
		chara 取得アイテム表示 取得アイテム表示 \
			-p 取得ダイアログ表示８ \
			-i 7 \					// 無限エルードカツラ（オレンジ）
			-s $f:取得アイテム表示最初
		eval( $f:取得アイテム表示最初 = 0 ) ;
	} else {
		@取得ダイアログ表示８ ;
	}
}
proc 取得ダイアログ表示８ {
	if ($f:プラントＯ２カツラ取得 == 1) { 
		chara 取得アイテム表示 取得アイテム表示 \
			-p 取得ダイアログ表示終了 \
			-i 8 \						// 無限Ｏ２カツラ(青)
			-s $f:取得アイテム表示最初
		eval( $f:取得アイテム表示最初 = 0 ) ;
	} else {
		@取得ダイアログ表示終了 ;
	}
}
proc 取得ダイアログ表示終了 {
	@セーブ確認ダイアログ表示
}
// -------------------------------------------------------
// クリア情報のセーブ(確認）
// -------------------------------------------------------
proc セーブ確認ダイアログ表示 {
	chara セーブ確認画面 セーブ確認 \
		-p セーブダイアログ表示 \
		-s セーブ確認文
	// リソース名は、ending.gclでは「セーブ確認文」というのを用意してある。
	// リソースの内容は、ending.rscに記述してある。
}

// -------------------------------------------------------
// クリア情報のセーブ
// -------------------------------------------------------
proc セーブダイアログ表示 $:返り値 {
	if ( $:返り値 == 0 ) {
	@クリア情報設定 ;
	@変数セーブ準備 ;
	if($w:コンフィグ設定 & d:CONFIG_STORY_TANKER){
		// タンカー編後の情報をセーブする
		chara セーブゲーム画面マネージャー セーブ画面 \
			-d save_load \
			-p セーブダイアログ表示終了 \
			-i tnkicon
	}else{
		// プラント編（含タンカー＆プラント編）後のクリア情報をセーブする
		chara セーブゲーム画面マネージャー セーブ画面 \
			-d save_load \
			-p セーブダイアログ表示終了 \
			-i plticon
	}
	} else {
		@セーブダイアログ表示終了 1
	}
}

proc セーブダイアログ表示終了 $:返り値 {
	if( $:返り値 != 0 ){
		@クリアコード表示シーケンス終了処理
	} else {
		@セーブ確認ダイアログ表示
	}
}

proc クリア情報設定 {
	if (($w:タイトルメニュー設定 & d:TITLE_MENU_STORY_SEL_MASK) == d:TITLE_MENU_STORY_SEL_TANDP ) {
		//タンカー&プラント編 --------------------
		if ( $w:コンフィグ設定 & d:CONFIG_STORY_TANKER ) {
			//タンカー編 -----------------------------
			eval( $w:現ステージ番号 = d:ステージ名:プラント編スタート );
		} else {
			//プラント編 -----------------------------
			eval( $w:現ステージ番号 = d:ステージ名:プラント編クリア );
		}
	}else if(($w:タイトルメニュー設定 & d:TITLE_MENU_STORY_SEL_MASK) == d:TITLE_MENU_STORY_SEL_TANKER ) {
		//タンカー編 -----------------------------
		eval( $w:現ステージ番号 = d:ステージ名:タンカー編クリア );
	}else{
		//プラント編 -----------------------------
		eval( $w:現ステージ番号 = d:ステージ名:プラント編クリア );
	}
	// -----------------------------------------------
	if ( $w:コンフィグ設定 & d:CONFIG_STORY_TANKER ) {
		//タンカー編 -----------------------------
		eval( $w:タイトルメニュー設定 = ($w:タイトルメニュー設定 | d:TITLE_MENU_TANKER_CLEARD )) ;
	} else {
		//プラント編 -----------------------------
		eval( $w:タイトルメニュー設定 = ($w:タイトルメニュー設定 | d:TITLE_MENU_PLANT_CLEARD  )) ;
	}
}

// -------------------------------------------------------
// -------------------------------------------------------
// -------------------------------------------------------
// -------------------------------------------------------
// -------------------------------------------------------
// -------------------------------------------------------
// -------------------------------------------------------
// -------------------------------------------------------
proc デジカメ取得条件判定 {
	if (($w:タイトルメニュー設定 & d:TITLE_MENU_STORY_SEL_MASK) == d:TITLE_MENU_STORY_SEL_TANDP ) {
		//タンカー&プラント編 --------------------
		if( !$f:タンカーデジカメ取得済み ){ 
			eval($f:タンカーデジカメ取得済み = 1); /* ゲームクリア後も初期化しない */
			eval($f:タンカーデジカメ取得 = 1);
		}
		if( !$f:プラントデジカメ取得済み ){ 
			eval($f:プラントデジカメ取得済み = 1); /* ゲームクリア後も初期化しない */
			eval($f:プラントデジカメ取得 = 1);
		}
	}else if(($w:タイトルメニュー設定 & d:TITLE_MENU_STORY_SEL_MASK) == d:TITLE_MENU_STORY_SEL_TANKER ) {
		//タンカー編 -----------------------------
		if(!$f:タンカーデジカメ取得済み){ 
			eval($f:タンカーデジカメ取得済み = 1); /* ゲームクリア後も初期化しない */
			eval($f:タンカーデジカメ取得 = 1);
		}
	}else{
		//プラント編 -----------------------------
		if(!$f:プラントデジカメ取得済み){ 
			eval($f:プラントデジカメ取得済み = 1); /* ゲームクリア後も初期化しない */
			eval($f:プラントデジカメ取得 = 1);
		}
	}
}
// -------------------------------------------------------
proc ドッグタグ収集状況判定 {
	eval($w:タンカー編取得済みドッグタグ数 = `%タンカー編取得済みドッグタグ数`)
	eval($w:プラント編取得済みドッグタグ数 = `%プラント編取得済みドッグタグ数`)
	eval($w:タンカー編総ドッグタグ数 = `%タンカー編総ドッグタグ数`)
	eval($w:プラント編総ドッグタグ数 = `%プラント編総ドッグタグ数`)

	eval($b:タンカードッグタグ取得率 = $w:タンカー編取得済みドッグタグ数 * 100 / $w:タンカー編総ドッグタグ数 )
	eval($b:プラントドッグタグ取得率 = $w:プラント編取得済みドッグタグ数 * 100 / $w:プラント編総ドッグタグ数 )
	eval($b:ドッグタグ回収率 = ($w:タンカー編取得済みドッグタグ数 + $w:プラント編取得済みドッグタグ数 ) * 100 / ( $w:タンカー編総ドッグタグ数 + $w:プラント編総ドッグタグ数 ))

	// eval($b:ドッグタグ回収率 = 100)

	if(!$f:タンカー無限バンダナ取得済み && $b:タンカードッグタグ取得率 >=  d:TNKER_TAG_PER_BANDANA){
		eval($f:タンカー無限バンダナ取得済み = 1);	/* ゲームクリア後も初期化しない */
		eval($f:タンカー無限バンダナ取得 = 1);
	}
	if(!$f:タンカーステルス迷彩取得済み && $b:タンカードッグタグ取得率 >=  d:TNKER_TAG_PER_STELTH){
		eval($f:タンカーステルス迷彩取得済み = 1);	/* ゲームクリア後も初期化しない */
		eval($f:タンカーステルス迷彩取得 = 1);
	}
	if(!$f:プラント無限カツラ取得済み   && $b:プラントドッグタグ取得率 >=  d:PLANT_TAG_PER_WIG_BROWN){
		eval($f:プラント無限カツラ取得済み = 1);	/* ゲームクリア後も初期化しない */
		eval($f:プラント無限カツラ取得 = 1);
	}
	if(!$f:プラントステルス迷彩取得済み && $b:プラントドッグタグ取得率 >=  d:PLANT_TAG_PER_STELTH){
		eval($f:プラントステルス迷彩取得済み = 1);	/* ゲームクリア後も初期化しない */
		eval($f:プラントステルス迷彩取得 = 1);
	}
	if(!$f:プラント腕力カツラ取得済み   && $b:プラントドッグタグ取得率 >=  d:PLANT_TAG_PER_WIG_ORANGE){
		eval($f:プラント腕力カツラ取得済み = 1);	/* ゲームクリア後も初期化しない */
		eval($f:プラント腕力カツラ取得 = 1);
	}
	if(!$f:プラントＯ２カツラ取得済み   && $b:プラントドッグタグ取得率 >= d:PLANT_TAG_PER_WIG_BLUE){
		eval($f:プラントＯ２カツラ取得済み = 1);	/* ゲームクリア後も初期化しない */
		eval($f:プラントＯ２カツラ取得 = 1);
	}
}
// -------------------------------------------------------

proc 変数セーブ準備 {
	command varsave $f:タンカーデジカメ取得済み     
	command varsave $f:プラントデジカメ取得済み     
	command varsave $f:タンカー無限バンダナ取得済み 
	command varsave $f:タンカーステルス迷彩取得済み 
	command varsave $f:プラント無限カツラ取得済み   
	command varsave $f:プラントステルス迷彩取得済み 
	command varsave $f:プラント腕力カツラ取得済み   
	command varsave $f:プラントＯ２カツラ取得済み   
	command varsave $f:タンカーデジカメ取得     
	command varsave $f:プラントデジカメ取得     
	command varsave $f:タンカー無限バンダナ取得 
	command varsave $f:タンカーステルス迷彩取得 
	command varsave $f:プラント無限カツラ取得   
	command varsave $f:プラントステルス迷彩取得 
	command varsave $f:プラント腕力カツラ取得   
	command varsave $f:プラントＯ２カツラ取得   
	command varsave $w:現ステージ番号;
	command varsave $w:タイトルメニュー設定;
}

// -------------------------------------------------------
// -------------------------------------------------------
// -------------------------------------------------------
// -------------------------------------------------------
// -------------------------------------------------------
// -------------------------------------------------------
// クリアコードの生成
// 2001/8/18 K.Kano
// -------------------------------------------------------
proc クリアコードの生成 {

	eval( $i:クリアコード１ = 0 );
	eval( $i:クリアコード２ = 0 );
	eval( $i:クリアコード３ = 0 );
	eval( $i:クリアコード４ = 0 );

	// レーダータイプ
	// クリアコード１[1-0] 2bit
	eval( $i:クリアコード１ = $i:クリアコード１ & ~( 3 << 0 ) );
#if 0
	if( ( $w:コンフィグ設定 & d:CONFIG_RADAR_OFF )==0 ){
		if( $w:コンフィグ設定 & d:CONFIG_RADAR_OFF_INTRUDE ){
			// Type 1
			eval( $i:クリアコード１ = $i:クリアコード１ | ( 1 << 0 ) );
		} else {
			// Type 2
			eval( $i:クリアコード１ = $i:クリアコード１ | ( 2 << 0 ) );
		}
	}
#else	// クリアコードフラグを使うよう修正 2002/08/21 M.Kobayashi
	if( ( $w:クリアーコードフラグ & d:CLEAR_RADAR_USED ) ){
		if( $w:コンフィグ設定 & d:CONFIG_RADAR_OFF_INTRUDE ){
			// Type 1
			eval( $i:クリアコード１ = $i:クリアコード１ | ( 1 << 0 ) );
		} else {
			// Type 2
			eval( $i:クリアコード１ = $i:クリアコード１ | ( 2 << 0 ) );
		}
	}
#endif

	// プレイ時間
	// クリアコード１[16-2] 15bit
	// 15秒単位にして、約136時間までカウントできるようにした
	eval( $i:クリアコード１ = $i:クリアコード１ & ~( 0x7fff << 2 ) );

#ifdef d:NTSC
	if ( ( ($i:プレイタイム + 14 * 60 ) / ( 15 * 60 ) ) > 0x7fff ){
		eval( $i:クリアコード１\
			 = $i:クリアコード１ | (  0x7fff << 2 ) );
	} else {
		eval( $i:クリアコード１\
			 = $i:クリアコード１ | ( ( ( $i:プレイタイム + 14 * 60 ) / ( 15 * 60 ) )<< 2 ) );
	}
#endif

#ifdef d:PAL
	if ( ( ( $i:プレイタイム + 14 * 50 - 1) / ( 15 * 50 ) ) > 0x7fff ){
		eval( $i:クリアコード１\
			 = $i:クリアコード１ | (  0x7fff << 2 ) );
	} else {
		eval( $i:クリアコード１\
			 = $i:クリアコード１ | ( ( ( $i:プレイタイム + 14 * 50 ) / ( 15 * 50 ) )<< 2 ) );
	}
#endif

	// 使用した弾薬数
	// クリアコード１[26-17] 10bit
	eval( $i:クリアコード１ = $i:クリアコード１ & ~( 0x3ff << 17 ) );
	if ( $w:発砲数 >= 0x3ff ) {
		eval( $i:クリアコード１ = $i:クリアコード１ | ( 0x3ff << 17 ) );
	} else {
		eval( $i:クリアコード１ = $i:クリアコード１ | ( $w:発砲数 << 17 ) );
	}

	// 危険モード回数
	// クリアコード２[7-0] 8bit
	eval( $i:クリアコード２ = $i:クリアコード２ & ~( 0xff << 0 ) );
	if ( $w:危険モード回数 >= 0xff ) {
		eval( $i:クリアコード２ = $i:クリアコード２ | ( 0xff << 0 ) );
	} else {
		eval( $i:クリアコード２ = $i:クリアコード２ | ( $w:危険モード回数 << 0 ) );
	}

	// ダメージ率 ( 体力ゲージ半分を単位に計算 )
	// クリアコード１[31-27] 5bit
	eval( $i:クリアコード１ = $i:クリアコード１ & ~( 0x1f << 27 ) );
	eval( $i:ダメージ率 = $w:累積ダメージ * 2 / $w:体力最大 );
	if ( $i:ダメージ率 >= 0x1f ) {
		eval( $i:クリアコード１ = $i:クリアコード１ | ( 0x1f << 27 ) );
	} else {
		eval( $i:クリアコード１ = $i:クリアコード１ | ( $i:ダメージ率 << 27 ) );
	}

	// 敵兵を殺した数
	// クリアコード２[15-8] 8bit
	eval( $i:クリアコード２ = $i:クリアコード２ & ~( 0xff << 8 ) );
	if ( $w:殺傷人数 >= 0xff ) {
		eval( $i:クリアコード２ = $i:クリアコード２ | ( 0xff << 8 ) );
	} else {
		eval( $i:クリアコード２ = $i:クリアコード２ | ( $w:殺傷人数 << 8 ) );
	}

	// コンティニュー回数
	// クリアコード３[5-0] 6bit
	eval( $i:クリアコード３ = $i:クリアコード３ & ~( 0x3f << 0 ) );
	if ( $w:コンティニュー回数 >= 0x3f ) {
		eval( $i:クリアコード３ = $i:クリアコード３ | ( 0x3f << 0 ) );
	} else {
		eval( $i:クリアコード３ = $i:クリアコード３ | ( $w:コンティニュー回数 << 0 ) );
	}

	// レーション使用回数
	// クリアコード３[10-6] 5bit
	eval( $i:クリアコード３ = $i:クリアコード３ & ~( 0x1f << 6 ) );
	eval ( $b:EX_レーション使用回数 = $w:レーション使用回数 );
	if ( $b:EX_レーション使用回数 >= 0x1f ) {
		eval( $i:クリアコード３ = $i:クリアコード３ | ( 0x1f << 6 ) );
	} else {
		eval( $i:クリアコード３ = $i:クリアコード３ | ( $b:EX_レーション使用回数 << 6 ) );
	}

#if 0
	// 米版

	// 特殊アイテム使用
	// クリアコード３[31] 1bit
	eval( $i:クリアコード３ = $i:クリアコード３ & ~( 0x1 << 31 ) );
	if ( $f:特殊アイテム使用した != 0 ) {
		eval( $i:クリアコード３ = $i:クリアコード３ | ( 0x1 << 31 ) );
	}
#else
	// 日本版／欧州版

	// 特殊アイテム使用
	// クリアコード２[31] 1bit
	eval( $i:クリアコード２ = $i:クリアコード２ & ~( 0x1 << 31 ) );
	if ( $f:特殊アイテム使用した != 0 ) {
		eval( $i:クリアコード２ = $i:クリアコード２ | ( 0x1 << 31 ) );
	}

	// 舟虫がくっついたフラグ
	// クリアコード２[30] 1bit
	eval( $i:クリアコード２ = $i:クリアコード２ & ~( 0x1 << 30 ) );
	if ( `%メニューフナムシ取り付き状態取得` != 0 ) {
		eval( $i:クリアコード２ = $i:クリアコード２ | ( 0x1 << 30 ) );
	}

	// タンカー編クリア回数
	// クリアコード２[29-24] 6bit
	eval( $i:クリアコード２ = $i:クリアコード２ & ~( 0x3f << 24 ) );
	if ( $w:タンカー編クリア回数 >= 0x3f ){
		eval( $i:クリアコード２ = $i:クリアコード２ | ( 0x3f << 24 ) );
	} else {
		eval( $i:クリアコード２ = $i:クリアコード２ | ( $w:タンカー編クリア回数 << 24 ) );
	}

	// プラント編クリア回数
	// クリアコード３[31-26] 6bit
	eval( $i:クリアコード３ = $i:クリアコード３ & ~( 0x3f << 26 ) );
	if ( $w:プラント編クリア回数 >= 0x3f ){
		eval( $i:クリアコード３ = $i:クリアコード３ | ( 0x3f << 26 ) );
	} else {
		eval( $i:クリアコード３ = $i:クリアコード３ | ( $w:プラント編クリア回数 << 26 ) );
	}

#endif

	// クリアリング回避回数
	// クリアコード２[23-16] 8bit
	if( $w:クリアリング回避回数 < 255 ){
		eval( $b:EX_クリアリング回避回数 = $w:クリアリング回避回数 ) ;
	} else {
		eval( $b:EX_クリアリング回避回数 = 255 ) ;
	}
	eval( $i:クリアコード２ = $i:クリアコード２ & ~( 0xff << 16 ) );
	eval( $i:クリアコード２ = $i:クリアコード２ | ( $b:EX_クリアリング回避回数 << 16 ) );

	// ドッグタグ回収率
	// クリアコード４[13-7] 7bit
	eval( $i:クリアコード４ = $i:クリアコード４ & ~( 0x7f << 7 ) );
	if ( $b:ドッグタグ回収率 >= 0x7f ) {
		eval( $i:クリアコード４ = $i:クリアコード４ | ( 0x7f << 7 ) );
	} else {
		eval( $i:クリアコード４ = $i:クリアコード４ | ( $b:ドッグタグ回収率 << 7 ) );
	}


	// セーブ回数
	// クリアコード３[17-11] 7bit
	eval( $i:クリアコード３ = $i:クリアコード３ & ~( 0x7f << 11 ) );
	if ( $w:セーブ回数 >= 0x7f ) {
		eval( $i:クリアコード３ = $i:クリアコード３ | ( 0x7f << 11 ) );
	} else {
		eval( $i:クリアコード３ = $i:クリアコード３ | ( $w:セーブ回数 << 11 ) );
	}

	// バージョン
	// クリアコード４[1-0] 2bit
#ifdef PSX2
	// ドッグタグモード
	print $i:コンフィグ設定２
	if( $i:コンフィグ設定２ & 0x8000 ) {
		eval( $i:クリアコード４ = $i:クリアコード４ | ( 0x1 << 0 ) );
	}
#else
	eval( $i:クリアコード４ = $i:クリアコード４ & ~( 0x3 << 0 ) );
	if ( $b:バージョン情報 >= 0x3 ) {
		eval( $i:クリアコード４ = $i:クリアコード４ | ( 0x3 << 0 ) );
	} else {
		eval( $i:クリアコード４ = $i:クリアコード４ | ( $b:バージョン情報 << 0 ) );
	}
#endif

#if 0
	// 米版

	// 赤びっくり回数
	// クリアコード２[31-24] 8bit
	eval( $i:クリアコード２ = $i:クリアコード２ & ~( 0xff << 24 ) );
	if( $w:赤びっくり回数 < 255 ){
		eval( $i:クリアコード２ = $i:クリアコード２ | ( $w:赤びっくり回数 << 24 ) );
	} else {
		eval( $i:クリアコード２ = $i:クリアコード２ | ( 0xFF << 24 ) );
	}
#endif

	// ゲームレベル
	// クリアコード４[4-2] 3bit
	eval( $i:クリアコード４ = $i:クリアコード４ & ~( 0x7 << 2 ) );
	if ( $w:ゲーム設定 == d:LEVEL_VERYEASY ) {
		eval( $i:クリアコード４ = $i:クリアコード４ | ( 0x0 << 2 ) );
	} else if ( $w:ゲーム設定 == d:LEVEL_EASY ) {
		eval( $i:クリアコード４ = $i:クリアコード４ | ( 0x1 << 2 ) );
	} else if ( $w:ゲーム設定 == d:LEVEL_NORMAL ) {
		eval( $i:クリアコード４ = $i:クリアコード４ | ( 0x2 << 2 ) );
	} else if ( $w:ゲーム設定 == d:LEVEL_HARD ) {
		eval( $i:クリアコード４ = $i:クリアコード４ | ( 0x3 << 2 ) );
	} else if ( $w:ゲーム設定 == d:LEVEL_EXTREME ) {
		eval( $i:クリアコード４ = $i:クリアコード４ | ( 0x4 << 2 ) );
	} else if ( $w:ゲーム設定 == d:LEVEL_E_EXTREME ) {
		eval( $i:クリアコード４ = $i:クリアコード４ | ( 0x5 << 2 ) );
	} else {
		eval( $i:クリアコード４ = $i:クリアコード４ | ( 0x7 << 2 ) );
	}


#if 0
	// 米版

	// ポスター見た回数
	// クリアコード３[30-26] 5bit
	eval( $i:クリアコード３ = $i:クリアコード３ & ~( 0x1f << 26 ) );
	if ( $b:ポスター観察回数 >= 0x1f ) {
		eval( $i:クリアコード３ = $i:クリアコード３ | ( 0x1f << 26 ) );
	} else {
		eval( $i:クリアコード３ = $i:クリアコード３ | ( $b:ポスター観察回数 << 26 ) );
	}
#endif

	// タンカー編orプラント編
	// クリアコード４[6-5] 2bit
	eval( $i:クリアコード４ = $i:クリアコード４ & ~( 0x3 << 5 ) );
	if (($w:タイトルメニュー設定 & d:TITLE_MENU_STORY_SEL_MASK) == d:TITLE_MENU_STORY_SEL_TANDP ) {
		//タンカー&プラント編 --------------------
		//プラント編 -----------------------------
		eval( $b:クリアコード用ゲームモード = 0 );
	}else if(($w:タイトルメニュー設定 & d:TITLE_MENU_STORY_SEL_MASK) == d:TITLE_MENU_STORY_SEL_TANKER ) {
		//タンカー編 -----------------------------
		eval( $b:クリアコード用ゲームモード = 1 );
	}else{
		//プラント編 -----------------------------
		eval( $b:クリアコード用ゲームモード = 2 );
	}
	eval( $i:クリアコード４ = $i:クリアコード４ | ( ( $b:クリアコード用ゲームモード & 0x3 ) << 5 ) );

	// カメラ・ガンカメラ・サイファー破壊数
	// クリアコード３[25-18] 8bit

	eval( $i:クリアコード３ = $i:クリアコード３ & ~( 0xff << 18 ) );
	if( $w:メカ破壊個数 < 255 ){
		eval( $i:クリアコード３ = $i:クリアコード３ | ( $w:メカ破壊個数 << 18 ) );
	} else {
		eval( $i:クリアコード３ = $i:クリアコード３ | ( 0xFF << 18 ) );
	}
}

// -------------------------------------------------------
// カレン北条レポート
// -------------------------------------------------------

proc カレン北条レポート {
	/* カレン北条レポート */
	eval( $w:p_story = d:ST:P082_08_M03エンディング８ムービーデモ３開始 );
	chara delay 遅延 -time (4*60) -exec {
		command 無線設定 -reset
		command メニュー設定 -menu off -gage off -radar off -subwin off
		command パッド操作 -release
		chara デモキャンセルチェック vc108201キャンセル -p vc108201キャンセル処理
		command Stream t:vc108201 -p P082_08_M03ムービー再生開始
	}
}

proc P082_08_M03ムービー再生開始 $:終了フラグ {
	eval( $w:p_story = d:ST:P082_08_M03エンディング８ムービーデモ３終了 );
	eval( $w:p_story = d:ST:P082_09_M04エンディング９ムービーデモ４開始 );

	if( $:終了フラグ != 0 ){
		// キャンセル
		@P082_08_M03ムービー再生終了
		return;
	}
	// そのままきた
	// MOVIE再生はデモキャンセルチェックはいらない
	mesg デモキャンセルチェック vc108201キャンセル kill
	chara MOVIE再生 p082_08_m03 -file t:p082_08_m03 -top 0, d:MOVIE_TOP_Y -size 512, 320 \
		-proc P082_08_M03ムービー再生終了
}
proc P082_08_M03ムービー再生終了 {
	eval( $w:p_story = d:ST:P082_09_M04エンディング９ムービーデモ４終了 ) ;
	@タイトルへ戻す
}
proc vc108201キャンセル処理 {
	%StreamStopAll
}

proc タイトルへ戻す {
	@mv_init_n_title_0
}

/// koba4
/// result 画面
proc 結果画面終了 { 
	chara delay Wait -time (2*60) -exec {
		@クリアコード表示シーケンス
	}
}

proc 結果画面表示 {
	@ドッグタグ収集状況判定

	chara 結果画面 Result_Menu \
		-n 結果画面終了 \
		-d $b:ドッグタグ回収率
}
