		eval( $w:p_story = d:ST:P049_09_M05大統領９ムービーデモ５終了 );
		chara MOVIE再生 p049_09_m05 -file t:p049_09_m05 -top 0, d:MOVIE_TOP_Y -size 512, 320 \
