//---------------------------------------------------------------------------
//	ムービー再生
//---------------------------------------------------------------------------
	@シナリオデモキャラセット	// stdproc.hで定義
	mesg シネマスクリーン シネマ フェードアウト 1

	if(d:ST:P014_01_P01ピーター遭遇１ポリゴンデモ１終了 <= $w:p_story && \
				$w:p_story < d:ST:P014_02_M01ピーター遭遇２ムービーデモ１開始) {
		eval($w:p_story = d:ST:P014_02_M01ピーター遭遇２ムービーデモ１開始)
		print '$w:p_story = ST:P014_02_M01ピーター遭遇２ムービーデモ１開始'

		/* ファットマンの紹介映像 */

		chara サウンドマネージャー ＳＤマネ -pak -1		// パックをロードしない
		command セットサウンドコード -c d:SNG_PLAY_06

		chara MOVIE再生 p014_02_m01 -file t:p014_02_m01 -top 0, d:MOVIE_TOP_Y -size 512, 320 -proc P014_02_m01終了

	} else if(d:ST:P014_03_P02ピーター遭遇３ポリゴンデモ２終了 <= $w:p_story && \
				$w:p_story < d:ST:P014_04_M02ピーター遭遇４ムービーデモ２開始) {
		eval($w:p_story = d:ST:P014_04_M02ピーター遭遇４ムービーデモ２開始)
		print '$w:p_story = ST:P014_04_M02ピーター遭遇４ムービーデモ２開始'

		/* オタコンがビッグシェルに来たことを示すムービー */

		chara MOVIE再生 p014_04_m02 -file t:p014_04_m02 -top 0, d:MOVIE_TOP_Y -size 512, 320 -proc P014_04_m02終了


	} else if(d:ST:P014_06_I01ピーター遭遇６インタラクティブ主観デモ１終了 <= $w:p_story && \
					$w:p_story < d:ST:P014_07_M03ピーター遭遇７ムービーデモ３開始) {
		eval($w:p_story = d:ST:P014_07_M03ピーター遭遇７ムービーデモ３開始)
		print '$w:p_story = ST:P014_07_M03ピーター遭遇７ムービーデモ３開始'

		chara MOVIE再生 p014_07_m03 -file t:p014_07_m03 -top 0, d:MOVIE_TOP_Y -size 512, 320 -proc P014_07_m03終了

	} else if(d:ST:P014_13_P06ピーター遭遇１３ポリゴンデモ６終了 <= $w:p_story && \
					$w:p_story <= d:ST:P014_14_M04ピーター遭遇１４ムービーデモ４開始) {
		eval($w:p_story = d:ST:P014_14_M04ピーター遭遇１４ムービーデモ４開始)
		print '$w:p_story = ST:P014_14_M04ピーター遭遇１４ムービーデモ４開始'

		chara MOVIE再生 p014_14_m04 -file t:p014_14_m04 -top 0, d:MOVIE_TOP_Y -size 512, 320 -proc P014_14_m04終了

	} else if(d:ST:P036_08_R02忍者登場８無線デモ２終了 <= $w:p_story && \
					$w:p_story < d:ST:P036_09_M01忍者登場９ムービーデモ１開始) {
		eval($w:p_story = d:ST:P036_09_M01忍者登場９ムービーデモ１開始)
		print '$w:p_story = ST:P036_09_M01忍者登場９ムービーデモ１開始'

		/* ヴァンプに奪われたブラックケースの映像 */

		chara MOVIE再生 p036_09_m01 -file t:p036_09_m01 -top 0, 36 -size 512, 320 -proc P036_09_m01終了		// 01.07.18 山下修正

//野尻追加
	} else if(d:ST:P040_06a_R02aエイムズ発見６a無線デモ２a終了 <= $w:p_story && \
					$w:p_story < d:ST:P040_06b_M00エイムズ発見６bムービーデモ０開始) {

		eval($w:p_story = d:ST:P040_06b_M00エイムズ発見６bムービーデモ０開始)
		print '$w:p_story = ST:P040_06b_M00エイムズ発見６bムービーデモ０開始'

		/* ウォール街　ＮＹＳＥ */

		// デモ特有の変数代入
		eval($s:d_num = P040_06b_m00)

		eval( $w:p_story = d:ST:P040_06b_M00エイムズ発見６bムービーデモ０開始 );
		print '$w:p_story = d:ST:P040_06b_M00エイムズ発見６bムービーデモ０開始'

		chara MOVIE再生 P040_06b_m00 -file t:p040_06_r02 -top 0, d:MOVIE_TOP_Y -size 512, 320 \
			-proc P040_06b_m00終了

//野尻追加


//---------------------------------------------------------------------------
// w31a.gclで呼ばれているムービー
//---------------------------------------------------------------------------
	} else if ( $w:p_story == d:ST:P049_03_M01大統領３ムービーデモ１開始 ) {
	/* 実写映像……ホワイトハウス／ペンタゴンの空撮等 */
		#if d:DEBUG_PRINT
			print 'd:ST:P049_03_M01大統領３ムービーデモ１開始'
		#endif
		eval( $w:p_story = d:ST:P049_03_M01大統領３ムービーデモ１終了 );
		chara MOVIE再生 p049_03_m01 -file t:p049_03_m01 -top 0, d:MOVIE_TOP_Y -size 512, 320 \
			-proc リスタート
		eval( $w:p_story = d:ST:P049_04_M02大統領４ムービーデモ２開始 );

	} else if ( $w:p_story == d:ST:P049_04_M02大統領４ムービーデモ２開始 ) {
	/* １２人の老人達のシルエット／賢人会議… */
