		chara MOVIE再生 p049_06_m03 -file t:p049_06_m03 -top 0, d:MOVIE_TOP_Y -size 512, 320 \
			-proc リスタート
		eval( $w:p_story = d:ST:P049_07_M04大統領７ムービーデモ４開始 );

	} else if ( $w:p_story == d:ST:P049_07_M04大統領７ムービーデモ４開始 ) {
	/* 前作ゲーム画面（ポリデモ）映像デモ */
		#if d:DEBUG_PRINT
			print 'd:ST:P049_07_M04大統領７ムービーデモ４開始'
		#endif
		eval( $w:p_story = d:ST:P049_07_M04大統領７ムービーデモ４終了 );
		chara MOVIE再生 p049_07_m04 -file t:p049_07_m04 -top 0, d:MOVIE_TOP_Y -size 512, 320 \
			-proc rt_P049_08_R03大統領８無線機デモ３

	} else if ( $w:p_story == d:ST:P049_09_M05大統領９ムービーデモ５開始 ) {
	/* アーセナルギアの設計図・ラフスケッチ・シルエット・ＲＡＹのイラスト */
