	proc vc108201キャンセル処理 {
		mesg デモキャンセルチェック vc108201キャンセル kill
		@リスタート
	}
	proc P082_10_V01終了 {
		chara フェードインアウト フェードアウト \
			-c 0,0,0 128 \
			-t d:FADEOUT_TIME \
			-p P082_10_V01終了フェードアウト待ち
	}
	proc P082_10_V01終了フェードアウト待ち {
		@リスタート
	}
	proc vc108211キャンセル処理 {
		%StreamStopAll
	}
