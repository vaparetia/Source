// P082_01_p01.w61aで呼ばれているムービー
//---------------------------------------------------------------------------
	} else if ( $w:p_story == d:ST:P082_03_M01エンディング３ムービーデモ１開始 ) {
	/* マンハッタン雑踏映像 */
		#if d:DEBUG_PRINT
			print 'd:ST:P082_03_M01エンディング３ムービーデモ１開始'
		#endif
		eval( $w:p_story = d:ST:P082_03_M01エンディング３ムービーデモ１終了 );
		eval( $w:p_story = d:ST:P082_04_P03エンディング４ポリゴンデモ３開始 );
		chara MOVIE再生 p082_03_m01 -file t:p082_03_m01 -top 0, d:MOVIE_TOP_Y -size 512, 320 \
			-proc mv_P082_01_P01_0

	} else if ( $w:p_story == d:ST:P082_05_M02エンディング５ムービーデモ２開始 ) {
	/* 雑踏実写映像　ライデンプロポーズ スタッフクレジットまで一気に行く */
		#if d:DEBUG_PRINT
			print 'd:ST:P082_05_M02エンディング５ムービーデモ２開始'
		#endif
		eval( $w:p_story = d:ST:P082_05_M02エンディング５ムービーデモ２終了 );
		eval( $w:p_story = d:ST:P082_09_M04エンディング９ムービーデモ４開始 );
#ifdef d:ENGLISH
//#ifdef d:PAL
//		chara エンディング name -file t:ending -telop ending_pal -proc リスタート
//#else
		chara エンディング name -file t:ending -telop ending_eng -proc リスタート
//#endif
#else
		chara エンディング name -file t:ending -telop ending_jp -proc リスタート
#endif
	} else if ( $w:p_story == d:ST:P082_09_M04エンディング９ムービーデモ４開始 ) {
	/* ニューヨーク雑踏映像　スネーク最後の語り */
		#if d:DEBUG_PRINT
			print 'd:ST:P082_09_M04エンディング９ムービーデモ４開始'
		#endif
		eval( $w:p_story = d:ST:P082_09_M04エンディング９ムービーデモ４終了 );
		eval( $w:p_story = d:ST:P082_10_V01エンディング１０音声デモ１開始 );
		command 無線設定 -reset
		command メニュー設定 -menu off -gage off -radar off -subwin off
		command パッド操作 -release
		chara delay 遅延 -t (4*60) -exec {
			chara delay 遅延 -t 4664 -exec {
				print '2D Sprite!'
				chara ２Ｄスプライト表示 マップネーム表示 \
					-tri mgs2logo \
					-x title_logo_mono_alp_ovl \
					-pos 256 150 \
					-b 9000 9000 \
					-count 30,1800,0 \
					-flag d:FLAG_CENTER
			}
			chara MOVIE再生 p082_09_m04 -file t:p082_09_m04 -top 0, d:MOVIE_TOP_Y -size 512, 320 \
				-prio 128 -proc リスタート
		}
	} else if ( $w:p_story == d:ST:P082_10_V01エンディング１０音声デモ１開始 ) {
		/* 愛国者は１２名とも１００年前に死亡していたことが判明する */
		#if d:DEBUG_PRINT
			print 'd:ST:P082_10_V01エンディング１０音声デモ１開始'
		#endif
		eval( $w:p_story = d:ST:P082_10_V01エンディング１０音声デモ１終了 );
		eval( $w:p_story = d:ST:P082_11_PASSエンディング１１パスワード表示１開始 );
		eval($w:音声デモ長さ = t:vc108211_len ) ;		// T-Symbolは演算できない
		eval($w:音声デモ長さ = $w:音声デモ長さ - 600 ) ;	// らしいのでこの記述とする
		command 無線設定 -reset
		command メニュー設定 -menu off -gage off -radar off -subwin off
		command パッド操作 -release
		chara ２Ｄスプライト表示 マップネーム表示 \
			-tri mgs2logo \
			-x title_logo_mono_alp_ovl \
			-pos 256 150 \
			-b 9000 9000 \
			-count 0,$w:音声デモ長さ,30 \
			-flag d:FLAG_CENTER
		chara delay 遅延 -time (2*60) -exec {
			/* 2001.10.5 村岡Ｍ依頼により2秒の「間（ま）」を作った */
			/* ただし事情により「間（ま）」の2秒間はキャンセル不可です */
			chara デモキャンセルチェック vc108211キャンセル -p vc108211キャンセル処理
			command Stream t:vc108211 -p P082_10_V01終了
		}
	} else if ( $w:p_story == d:ST:P082_11_PASSエンディング１１パスワード表示１開始 ) {
		/* パスワード表示 */
		#if d:DEBUG_PRINT
			print 'd:ST:P082_11_PASSエンディング１１パスワード表示１開始'
		#endif
		eval( $w:p_story = d:ST:P082_11_PASSエンディング１１パスワード表示１終了 );
		// クリアしたらクリア回数を一回増やしてタイトルへ飛ばす
		eval( $w:プラント編クリア回数 = $w:プラント編クリア回数 + 1 );
		command varsave
		load "ending"		// クリアコード表示
	}






