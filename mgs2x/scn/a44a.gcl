//-----------------------------------------------------------------------------
// ローカル

eval($f:Ｓローカルフラグ１ = 0)		// 量産メタル裏の制御
eval($f:Ｓローカルフラグ３ = 0)		// デモ処理フラグ
eval($w:Ｓローカル変数Ｗ１ = 0)		// 初期値０   全滅１   ドア開く２   退場デモ３

//eval($w:プレイヤーフラグ = $w:プレイヤーフラグ | d:PL_GAVE_SHAVER_TO_SNAKE)

#include "stageset.h"		// ステージ設定共通ヘッダ

// アナザー用でマップ設定前に設定する
// ------------------------------------
@アナザー用マップ定義前設定

//=============================================================================
// メイン
//=============================================================================

chara マップ 第二メタルハンガー \
	-k d:KMS_NAME0 \
	-h d:HZX_NAME, 0 \
	-l d:LT2_NAME

command マップ設定 第二メタルハンガー -set {
	// サウンド、キャラクターのセット
	@常駐キャラ設定
	@難易度調整
	@A_プレイヤー設定 sna_a44a rai_a44a
	@亀甲床設定
	@息設定
}

// アナザー用でマップ設定後に設定する
// ------------------------------------
@アナザー用マップ定義後設定

command マップ設定 第二メタルハンガー -set {
	@SS_跳弾弾痕設定

#if d:ENEMY_SET
//	インテグラル
//	@敵兵設定
#endif
// マップ切り替え、ロード、ドア
// ------------------------------------
	@ドア設定
	@ロード設定

// ステージ、オブジェクト関連
// ------------------------------------
	@その他オブジェクト設定
	@カメラ設定

	@SS_フォグ_キャラ用ライト設定
/*
	if($f:w41a_ノードフラグ == 1){
		@プラント編全体マップ設定 d:アーセナルギア回腸
	} else {
		@ポーズ時ステージ名表示設定 d:wn_アーセナルギア回腸
	}
*/
}

command マップ表示 -show 第二メタルハンガー

@ステージ進入時処理





