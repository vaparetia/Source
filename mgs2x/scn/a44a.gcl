//----- 敵兵設定

proc 敵兵設定 {
#if d:DEBUG_PRINT
	print '*** Enemy Set ***'
#endif

	//---------------------------------------------------------
	// コマンダー
	if($s:登場ポイント == sp_w43a_w44a_0) {
		// シナリオデモ

		// コマンダー
		//   -w 警備コマンダーproc  -a 攻撃コマンダーproc  -r 復活場所 マップＩＤ  -c 待機場所 マップＩＤ  -v 音声  -m 危険モード  -p クリアリングエリア ルート ポイント プロック  -x 司令官危険音声  -y 司令官警戒音声  -g 銃ライト  -z 麻酔持続時間  -b 危険モードでの復活人数 
		chara コマンダー 敵兵セット \
			-s (d:ENE_STAGE_NO_WC_GOVER)

	} else {
		// 天狗イベント
		if($w:ゲーム設定 == d:LEVEL_VERYEASY) {
			chara コマンダー 敵兵セット \
				-a 天狗兵コマンダー４ \
				-v [ene_plant_voice:01] \
				-m $w:スタートアラートモード \
				-s (d:ENE_STAGE_NPC_SNAKE | d:ENE_STAGE_NO_STRM | d:ENE_STAGE_ALERT2SNEAK | d:ENE_STAGE_NO_WC_GOVER) \
				-d 第二メタルハンガー \
				-h $i:標準警戒時間 \
				-b 20 \								// ４ ＊ ５
				-k 20

		} else if($w:ゲーム設定 == d:LEVEL_EASY) {
			chara コマンダー 敵兵セット \
				-a 天狗兵コマンダー５ \
				-v [ene_plant_voice:01] \
				-m $w:スタートアラートモード \
				-s (d:ENE_STAGE_NPC_SNAKE | d:ENE_STAGE_NO_STRM | d:ENE_STAGE_ALERT2SNEAK | d:ENE_STAGE_NO_WC_GOVER) \
				-d 第二メタルハンガー \
				-h $i:標準警戒時間 \
				-b 25 \								// ５ ＊ ５
				-k 25

		} else if($w:ゲーム設定 == d:LEVEL_NORMAL) {
			chara コマンダー 敵兵セット \
				-a 天狗兵コマンダー６ \
				-v [ene_plant_voice:01] \
				-m $w:スタートアラートモード \
				-s (d:ENE_STAGE_NPC_SNAKE | d:ENE_STAGE_NO_STRM | d:ENE_STAGE_ALERT2SNEAK | d:ENE_STAGE_NO_WC_GOVER) \
				-d 第二メタルハンガー \
				-h $i:標準警戒時間 \
				-b 36 \								// ６ ＊ ６
				-k 36

		} else if($w:ゲーム設定 == d:LEVEL_HARD) {
			chara コマンダー 敵兵セット \
				-a 天狗兵コマンダー７ \
				-v [ene_plant_voice:01] \
				-m $w:スタートアラートモード \
				-s (d:ENE_STAGE_NPC_SNAKE | d:ENE_STAGE_NO_STRM | d:ENE_STAGE_ALERT2SNEAK | d:ENE_STAGE_NO_WC_GOVER) \
				-d 第二メタルハンガー \
				-h $i:標準警戒時間 \
				-b 42 \								// ７ ＊ ６
				-k 42

		} else {
			chara コマンダー 敵兵セット \
				-a 天狗兵コマンダー７ \
				-v [ene_plant_voice:01] \
				-m $w:スタートアラートモード \
				-s (d:ENE_STAGE_NPC_SNAKE | d:ENE_STAGE_NO_STRM | d:ENE_STAGE_ALERT2SNEAK | d:ENE_STAGE_NO_WC_GOVER) \
				-d 第二メタルハンガー \
				-h $i:標準警戒時間 \
				-b 42 \								// ７ ＊ ６
				-k 42
		}

		//---------------------------------------------------------
		// 天狗コマンダーのレベルアップ
		trap tng02 d:PLAYER \
			-mask 入る \
			-exec {
				#if d:DEBUG_PRINT
					print '*** tng02 ***'
				#endif

				mesg 天狗兵コマンダー tng_com レベルＵＰ 2
			}
		trap tng02 ＮＰＣスネーク \
			-mask 入る \
			-exec {
				#if d:DEBUG_PRINT
					print '*** tng02 ***'
				#endif

				mesg 天狗兵コマンダー tng_com レベルＵＰ 2
			}
		trap tng03 d:PLAYER \
			-mask 入る \
			-exec {
				#if d:DEBUG_PRINT
					print '*** tng03 ***'
				#endif

				mesg 天狗兵コマンダー tng_com レベルＵＰ 3
			}
		trap tng03 ＮＰＣスネーク \
			-mask 入る \
			-exec {
				#if d:DEBUG_PRINT
					print '*** tng03 ***'
				#endif

				mesg 天狗兵コマンダー tng_com レベルＵＰ 3
			}
		trap tng04 d:PLAYER \
			-mask 入る \
			-exec {
				#if d:DEBUG_PRINT
					print '*** tng04 ***'
				#endif

				mesg 天狗兵コマンダー tng_com レベルＵＰ 4
				mesg 透明壁 最後のラッシュ壁 on
				mesg ＮＰＣスネーク ＮＰＣスネーク Ｗ４４Ａ最後の山場
			}
	//	trap tng04 ＮＰＣスネーク \
	//		-mask 入る \
	//		-exec {
	//			#if d:DEBUG_PRINT
	//				print '*** tng04 ***'
	//			#endif
	//
	//			mesg 天狗兵コマンダー tng_com レベルＵＰ 4
	//		}

		chara 透明壁 最後のラッシュ壁 \
			-p 31250 4000 -135250 4000 \
			   37250 4000 -135250 4000 \
			-a (d:HZX_SEG_ATR_ALL & ~(d:HZX_SEG_NO_PLAYER)) \
			-map 第二メタルハンガー
		mesg 透明壁 最後のラッシュ壁 off
	}
}

//-----------------------------------------------------------------------------
// 天狗全滅プロック
proc 天狗全滅プロック {
#if d:DEBUG_PRINT
	print '*** Tengu Eliminated ***'
#endif

	eval($w:Ｓローカル変数Ｗ１ = 1)
}





//=============================================================================
// オブジェクト
//=============================================================================

//-----------------------------------------------------------------------------
// ドア設定
proc ドア設定 {
#if d:DEBUG_PRINT
	print '*** Door Set ***'
#endif
/*
	@ドアモデル名セット $:配列番号 \
		$:ドア名１				$:ドア名２				$:ドア名３ \
		$:ドア名４				$:ドア名５
		d:DOOR_FLAG_CLOSE 		d:DOOR_FLAG_OPEN		d:DOOR_FLAG_ENEMY_ONLY
		d:DOOR_FLAG_CLOSE_LEVEL	d:DOOR_FLAG_OPEN_LEVEL

	@A_ドア開閉追加設定 $:ドア名 $:フラグ $:ドア位置Ｘ $:ドア位置Ｙ $:ドア位置Ｚ $:ドア回転 $:ドアスライド幅
*/
	//	円形エレベーターへのドア
	//	アーセナルドアは両開きのためフラグ１つでモデル２つを管理する
	@ドアモデル名セット 0 d:DOOR_NAME1 d:DOOR_NAME1 d:DOOR_NAME1 d:DOOR_NAME1 d:DOOR_NAME1
	switch ( $$b:ドアフラグ[0] ) {
		case ( d:DOOR_FLAG_CLOSE ) {
			$$s:ドアモデル名[2] = d:DOOR_NAME2;
		}
		case ( d:DOOR_FLAG_OPEN ) {
			$$s:ドアモデル名[2] = d:DOOR_NAME2;
		}
		case ( d:DOOR_FLAG_ENEMY_ONLY ) {
			$$s:ドアモデル名[2] = d:DOOR_NAME2;
		}
		case ( d:DOOR_FLAG_CLOSE_LEVEL ) {
			$$s:ドアモデル名[2] = d:DOOR_NAME2;
		}
		case ( d:DOOR_FLAG_OPEN_LEVEL ) {
			$$s:ドアモデル名[2] = d:DOOR_NAME2;
		}
	}

	@A_ドア開閉追加設定 円形エレベーターへのドア $$b:ドアフラグ[0] 33500 4000 -150375 0 d:SD_SLIDE_INSIDE

	//	丸通路へのドア
	//	アーセナルドアは両開きのためフラグ１つでモデル２つを管理する
	@ドアモデル名セット 1 d:DOOR_NAME1 d:DOOR_NAME1 d:DOOR_NAME1 d:DOOR_NAME1 d:DOOR_NAME1
	switch ( $$b:ドアフラグ[1] ) {
		case ( d:DOOR_FLAG_CLOSE ) {
			$$s:ドアモデル名[3] = d:DOOR_NAME2;
		}
		case ( d:DOOR_FLAG_OPEN ) {
			$$s:ドアモデル名[3] = d:DOOR_NAME2;
		}
		case ( d:DOOR_FLAG_ENEMY_ONLY ) {
			$$s:ドアモデル名[3] = d:DOOR_NAME2;
		}
		case ( d:DOOR_FLAG_CLOSE_LEVEL ) {
			$$s:ドアモデル名[3] = d:DOOR_NAME2;
		}
		case ( d:DOOR_FLAG_OPEN_LEVEL ) {
			$$s:ドアモデル名[3] = d:DOOR_NAME2;
		}
	}

	@A_ドア開閉追加設定 丸通路へのドア $$b:ドアフラグ[1] 35000 4000 -91125 2048 d:SD_SLIDE_INSIDE

	// ドア
	//   -m オブジェクト名  -d 向き  -p 場所  -slide スライド量  -time 時間  -between マップ名１ マップ名２  -exec { $:開閉フラグ }


	//	円形エレベーターへのドア
	chara ドア 円形エレベーターへのドア \
		-m $$s:ドアモデル名[0] \
		-d 0 0 0 \
		-p 33500 4000 -150375 \
		-s d:SD_SLIDE_ARSENAL_LEFT \
		-t d:SD_OPEN_TIME \
		-b 第二メタルハンガー 第二メタルハンガー \
		-w $$s:ドアモデル名[2] d:SD_SLIDE_ARSENAL_RIGHT \
		-hazard_width 1500 \
		-exec {
			if(!($:開閉フラグ)) {
				mesg プットオブジェ 円形エレベーターロード部 off		// ロード部モデル
			} else {
				mesg プットオブジェ 円形エレベーターロード部 on			// ロード部モデル
			}
		}
	@主観禁止壁 円形エレベーターへのドア壁 33500 4000 -150375 0 d:SD_SLIDE_INSIDE

	trap dr001 d:PLAYER -mask ？ \
		-exec {
			if ($3 == 入る) {
				mesg ドア 円形エレベーターへのドア open $2
			} else if ($3 == 出る) {
				mesg ドア 円形エレベーターへのドア close $2
			}
		}

	trap dr001 d:PLAYER -mask ？ \
		-state d:TRP_STATE_SUBJECT \
		-exec {
			if($3 == 入る) {
				mesg 透明壁 円形エレベーターへのドア壁 on
			} else if($3 == 出る) {
				mesg 透明壁 円形エレベーターへのドア壁 off
			}
		}

	//	丸通路へのドア
	chara ドア 丸通路へのドア \
		-m $$s:ドアモデル名[1] \
		-d 0 2048 0 \
		-p 35000 4000 -91125 \
		-s d:SD_SLIDE_ARSENAL_LEFT \
		-t d:SD_OPEN_TIME \
		-b 第二メタルハンガー 第二メタルハンガー \
		-w $$s:ドアモデル名[3] d:SD_SLIDE_ARSENAL_RIGHT \
		-hazard_width 1500 \
		-exec {
			if(!($:開閉フラグ)) {
				mesg プットオブジェ 丸通路ロード部 off		// ロード部モデル
			} else {
				mesg プットオブジェ 丸通路ロード部 on		// ロード部モデル
			}
		}
	@主観禁止壁 丸通路へのドア壁 35000 4000 -91125 2048 d:SD_SLIDE_INSIDE

	trap dr002 d:PLAYER -mask ？ \
		-exec {
			if ($3 == 入る) {
				mesg ドア 丸通路へのドア open $2
			} else if ($3 == 出る) {
				mesg ドア 丸通路へのドア close $2
			}
		}

	trap dr002 d:PLAYER -mask ？ \
		-state d:TRP_STATE_SUBJECT \
		-exec {
			if($3 == 入る) {
				mesg 透明壁 丸通路へのドア壁 on
			} else if($3 == 出る) {
				mesg 透明壁 丸通路へのドア壁 off
			}
		}

}

//-----------------------------------------------------------------------------
// その他オブジェクト設定
proc その他オブジェクト設定 {
#if d:DEBUG_PRINT
	print '*** Object Set ***'
#endif

	//---------------------------------------------------------
	// 円形エレベータ
	@SS_プットオブジェ  円形エレベーターロード部 d:KMS_NAME1
	mesg プットオブジェ 円形エレベーターロード部 off

	// 丸通路
	@SS_プットオブジェ  丸通路ロード部 d:KMS_NAME4
	mesg プットオブジェ 丸通路ロード部 off
	//---------------------------------------------------------
	// ニキータ対処
	command ミサイル移動範囲設定 \
		29250 4000 -150250 \
		39250 8000  -91250

	//---------------------------------------------------------
	// 量産メタル
	@SS_プットオブジェ 量産メタル表 d:OBJ_NAME1
	@SS_プットオブジェ 量産メタル裏 d:OBJ_NAME2
	chara プロック連続実行 連続実行 \
		-time -1 \
		-exec {
			command プレイヤー状態取得 -d

			if(($f:Ｓローカルフラグ１ == 1) && (($status & d:PFLAG_SUBJECT) || ($status & d:PFLAG_CAUTION) || ($status & d:PFLAG_NIKITA_ALIVE))) {
				#if d:DEBUG_PRINT
					print '*** Metal Ura ON  ***'
				#endif

				eval($f:Ｓローカルフラグ１ = 0)
				mesg プットオブジェ 量産メタル裏 on

			} else if(($f:Ｓローカルフラグ１ == 0) && ((($status & d:PFLAG_SUBJECT) == 0) && (($status & d:PFLAG_CAUTION) == 0) && (($status & d:PFLAG_NIKITA_ALIVE) == 0))) {
				#if d:DEBUG_PRINT
					print '*** Metal Ura OFF ***'
				#endif

				eval($f:Ｓローカルフラグ１ = 1)
				mesg プットオブジェ 量産メタル裏 off
			}
		}

	//---------------------------------------------------------
	// リボン
	@SS_プットオブジェ リボン d:KMS_NAME2

	//---------------------------------------------------------
	// 回転リボン
	chara 回転モデル 回転モデル \
		-O        34250 10000 -108625 \	// 起点
		-posz     0 \
		-spin     0 (-300 * 60 * 4) \	// 軸回転
		-model    d:KMS_NAME3			// 使用モデル名

	chara 回転モデル 回転モデル \
		-O        34250 10000 -108625 \	// 起点
		-posz     -12000 \
		-spin     0 (300 * 60 * 4) \	// 軸回転
		-model    d:KMS_NAME3			// 使用モデル名

	chara 回転モデル 回転モデル \
		-O        34250 10000 -108625 \	// 起点
		-posz     -24000 \
		-spin     0 (-300 * 60 * 4) \	// 軸回転
		-model    d:KMS_NAME3			// 使用モデル名

	//---------------------------------------------------------
	// 天狗兵ステージモニターW44a
	chara 天狗兵ステージモニターW44a モニター

}





//=============================================================================
// フォグ、カメラ、ロード
//=============================================================================

//-----------------------------------------------------------------------------
// カメラ設定
proc カメラ設定 {
#if d:DEBUG_PRINT
	print '*** Camera Set ***'
#endif

	// カメラ
	//   -c チャンネル番号  -l カメラレベル  -p 優先度
	//
	//   シナリオカメラは最大16個までおける。
	//   チャンネル番号 ：
	//       ０：通常画面 １：小窓
	//   カメラレベル ：
	//       ０：カットインカメラ（主観より強） 強
	//       １：カットインカメラ（主観より弱） ↑
	//       ２：エリアカメラ		   ↓
	//       ３：ステージデフォルトカメラ	   弱
	//   優先度 ：
	//       エリアカメラに有効
	//       数字が小さい程優先度高
	chara カメラ ステージカメラ		-c 0 -l 3 -p  0
	chara カメラ サブカメラ１		-c 0 -l 2 -p 50
	chara カメラ サブカメラ２		-c 0 -l 2 -p 40
	chara カメラ サブカメラ３		-c 0 -l 2 -p 30
	chara カメラ モーションカメラ	-c 0 -l 2 -p 20
	chara カメラ でもデモカメラ		-c 0 -l 0 -p  0
	//	8/21向手追加
	chara カメラ ゲームオーバーカメラ	-c 0 -l 0 -p 5


	// カメラ設定
	//   -c カメラタイプ  -b バウンド小 バウンド大  -l リミット小 リミット大  -p カメラ位置  -t ターゲット位置  -r カメラ角度  -f カメラトラック  -a カメラ画角  -i カメラ補完方法（ＩＮ） カメラ補完方法（ＯＵＴ） 補完時間（ＩＮ） 補完時間（ＯＵＴ）  -d パッドフラグ  -z 各種フラグ  -k ＫＩＬＬ  -s ０オフ／１オン  -o ＯＮになるまでの待ち時間  -E スライドタイプ スライド待ち時間 スライド距離１ スライド距離２ スライドスピード [スライドフラグ]  -N 内部補完時間
	//
	//   -b -l は必要に応じて設定。-p -t -r はタイプに応じて使用するものが取得される。省略したオプションは、前回設定を引き継ぐ。
	//   フラグ：
	//       CAMERA_CUT_IN (カットインカメラ) CAMERA_NO_CUSHION (遊びなしカメラ) CAMERA_BOUNDCHANGE_QUICK (バウンド変更を即時に反映) CAMERA_INTERP_CAMERA (補完カメラ設定)
	//   カメラタイプ：
	//       ０：上俯瞰追従型（トラックと角度を指定） １：位置・角度固定型（ターゲット位置とカメラ位置を指定） ２：位置固定、追従型（カメラ位置を指定） ３：位置固定、Ｘ角度追従型（カメラ位置を指定） ４：ターゲット固定、プレイヤー追従カメラ（ターゲットとトラックを指定）
	//   補完方法：
	//       −１：指定なし ０：一瞬 １：補完シューン ２：補完ウニョーン ３：補完ウーニャーン ４：一定時間で
	//       補完時間は４番指定のとき有効。補完（ＩＮ）の指定は必須。２つのカメラ間の補完方法は、ＯＵＴ側カメラのＯＵＴ補完関数が指定してある場合にはその関数を使用し、指定がない場合には、ＩＮ側カメラのＩＮ補完関数を使用するようになっている。
	//   パッドフラグ：
	//       このフラグを指定しておくと、パッドの上が画面の上になるように自動調節する。
	//   スライドカメラ設定方法：
	//       スライドタイプ (０／１ − 左右タイプ／前後タイプ) スライド待ち時間 (スライドするまでの待ちフレーム数) スライド距離１・２ (左右タイプの場合 左右スライド距離。前後タイプの場合 接近距離、離れた距離) スライドスピード (そのまんま) スライドフラグ (1にしておくと、入った時スライドしていない状態から始まります。)
	//   補完カメラの設定方法：
	//       補完カメラとは？ − 設定したカメラに指定フレーム数かけて移動するカメラ。例として、オルガ戦のパンカメラ。
	//       設定方法 − -z に d:CAMERA_INTERP_CAMERA を指定。さらに -interp_time に補完フレーム数を指定。

	// デフォルトカメラ
	chara カメラ設定 ステージカメラ \
		-c 0 \
		-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
		-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
		-r 200,2048,0 \
		-f 5000 \
		-a 200 \
		-i 1 -1 0 0 \
		-s 1

	trap ca001 d:PLAYER \
		-camera -mask ＊ \
		-exec {
			@CS_スムーズカメラ昇順 $4 32500 36000 32500 36000
			eval($i:補完ＢＸ = $i:CS_結果１)
			@CS_スムーズカメラ昇順 $4 32500 36000 32500 36000
			eval($i:補完ＬＸ = $i:CS_結果１)

			@CS_スムーズカメラ昇順 $6 -99000 -93500 7500 12000
			eval($i:補完ＢＹ = $i:CS_結果１)
			@CS_スムーズカメラ昇順 $6 -99000 -93500 5000 5000
			eval($i:補完ＬＹ = $i:CS_結果１)

			@CS_スムーズカメラ昇順 $6 -145500 -99000 -140000 -92500
			eval($i:補完ＢＺ = $i:CS_結果１)
			@CS_スムーズカメラ昇順 $6 -145500 -99000 -145500 -99000
			eval($i:補完ＬＺ = $i:CS_結果１)

			if($6 > -99000) {
				@CS_スムーズカメラ昇順 $6 -99000 -93500 -92500 -92500
				eval($i:補完ＢＺ = $i:CS_結果１)
				@CS_スムーズカメラ昇順 $6 -99000 -93500 -99000 -93500
				eval($i:補完ＬＺ = $i:CS_結果１)
			}

			chara カメラ設定 サブカメラ１ \
				-c 1 \	
				-p $i:補完ＢＸ,$i:補完ＢＹ,$i:補完ＢＺ \
				-t $i:補完ＬＸ,$i:補完ＬＹ,$i:補完ＬＺ \
				-a 200 \
				-i 0 0 0 0 \
				-s $3
		}
}

proc スタートカメラセット {
#if d:DEBUG_PRINT
	print '*** Start Camera Set ***'
#endif
	if ($s:登場ポイント == 丸通路から) {
		@ロードカメラ１
	} else if ($s:登場ポイント == 円形エレベータから) {
		@ロードカメラ２
	}
}
proc スタートカメラオフ {
#if d:DEBUG_PRINT
	print '*** Start Camera Off ***'
#endif

	chara カメラ設定 モーションカメラ -s 0
}

proc ロードカメラ１ {
	chara カメラ設定 モーションカメラ \
		-c 1 \
		-p 34234,11232,-92950 -t 34234,5589,-92976 \
		-r 1021,2048,0 -f 5643 \
		-a 200 \
		-i 0 2 0 0 \
		-s 1
}

proc ロードカメラ２ {
	chara カメラ設定 モーションカメラ \
		-c 1 \
		-p 35606,6456,-143918 \
		-t 34981,6055,-147882 \
		-a 200 \
		-i 0 2 0 0 \
		-s 1
}

//-----------------------------------------------------------------------------
// ロード設定
proc ロード設定 {
#if d:DEBUG_PRINT
	print '*** Load Set ***'
#endif
	// 円形エレベータへ (a45a)
	trap ld001 d:PLAYER \
		-mask 入る \
		-exec {
			if($f:ロードチェックＯＮフラグ == 1) {
				@ロードカメラ２
				preseek 'a45a'
				@ステージ終了時処理（ステージ名表示） 34250 4000 -152250 2048 mv_a44a_a45a_0 \
				d:DEFAULT_M_TYPE d:wn_アーセナルギアＳ状結腸
			}
		}

	// 丸通路へ (a43a)
	trap ld002 d:PLAYER \
		-mask 入る \
		-exec {
			if($f:ロードチェックＯＮフラグ == 1) {
				@ロードカメラ１
				preseek 'a43a'
				@ステージ終了時処理（ステージ名表示） 34250 4000 -89250 0 mv_a44a_a43a_0 \
				d:DEFAULT_M_TYPE d:wn_アーセナルギア上行結腸
			}
		}

}

proc ロードプロック {
#if d:DEBUG_PRINT
	print '*** Load Proc ***'
#endif

	if($s:呼び出しプロック == mv_a44a_a45a_0) {
		// 円形エレベータへ
		@mv_a44a_a45a_0
	} else {
		// 丸通路へ
		@mv_a44a_a43a_0
	}
}





//=============================================================================
// ステージ進入時処理
//=============================================================================

proc ステージ進入時処理 {
#if d:DEBUG_PRINT
	print '*** Stage Start Proc ***'
#endif

	if($s:登場ポイント == 丸通路から) {
		@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:SL_DOOR_TYPE 丸通路へのドア 2000 \
		d:DEFAULT_M_TYPE d:wn_アーセナルギア回腸
	} else if ($s:登場ポイント == 円形エレベータから) {
		@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:SL_DOOR_TYPE 円形エレベーターへのドア 2000 \
		d:DEFAULT_M_TYPE d:wn_アーセナルギア回腸
	}
}
