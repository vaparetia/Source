//----- 天狗兵コマンダー
proc 天狗兵コマンダー４ {
#if d:DEBUG_PRINT
	print '*** Tengu Commander 4'
#endif

	chara 天狗兵コマンダー tng_com \
		-e     { 天狗兵４ } \					// 天狗兵プロック
		#include "w44a_tngcom.h"

		-defense \								// 敵兵セット
			// レベル１(4)
			    1  0 1 \	// 橋左 4 立ち＆しゃがみ
			    2  0 1 \	// 橋右 4 立ち＆しゃがみ
			    3  0 1 \	// 奥左 2
			    4  0 1 \	// 奥右 0
		//	    5  0 1 \	// 中左 3
		//	    6  0 1 \	// 中右 1
		//	    7  0 1 \	// 前左 4 立ち＆しゃがみ
		//	    8  0 1 \	// 前右 4 立ち＆しゃがみ

			// レベル２(4)
		//	    9  4 2 \	// 橋左     4 立ち＆しゃがみ
		//	   10  5 2 \	// 橋右     4 立ち＆しゃがみ
			   11  3 2 \	// 正面左   7 刀
			   12  2 2 \	// 正面右   7 刀
			   13  0 2 \	// 正面奥左 5 立ち
			   14  1 2 \	// 正面奥右 5 立ち
		//	   15  2 2 \	// 正面中左 7 刀
		//	   16  3 2 \	// 正面中右 7 刀

			// レベル３(4)
			   17  8 3 \	// 橋左 4 立ち＆しゃがみ
			   18  9 3 \	// 橋右 4 立ち＆しゃがみ
		//	   19  6 3 \	// 奥左 2
		//	   20  7 3 \	// 奥右 0
			   21  4 3 \	// 左上 9 羽交い絞め
		//	   22  7 3 \	// 中左 3
		//	   23  6 3 \	// 中右 1
			   24  7 3 \	// 奥中 5 立ち

			// レベル４(8)
			   25 13 4 \	// 右コンテナ左 5 立ち
			   26 13 4 \	// 右コンテナ右 5 立ち
