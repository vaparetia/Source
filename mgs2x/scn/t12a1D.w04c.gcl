// キャラ用ライトセット
// ------------------------------------
proc デフォルトキャラ専用ライトセット {
	command マップ設定 船倉３ 通路２ -set {
		chara 環境光 アンビ \
			 -c 6 20 30

		chara 平行光 パラ \
			 -c 86 85 48 \
			 -p -1287 -3357 -5545
	}
}
/*
デフォルトキャラ専用ライトセット
w04cのキャラ平環光セット
w04bのキャラ平環光セット
w04aのキャラ平環光セット
レイコクピットのキャラ平環光セット
*/
// -------------------------------------
// ！！！重要！！！
// -------------------------------------
/* 以下のライトで、
「＊＊＊のプリシェード平環光セット」はプリシェードモデルを置く直前でセット、
 置き終わったら元のものに戻す。（プットオブジェで検索して、ちゃんと置く。
 t04a1D.w00a.gcl参照）
「＊＊＊のキャラ平環光セット」はマックスの方で、随時呼び出すために用意した
 このステージでは、マップ設定でセットしているのは ?????.lt2 である */

// w04cステージにあたる場所での平行、環境光
proc w04cのキャラ平環光セット {
	chara 環境光 w04cキャラ環境光 \
		 -c 73 89 121 
	chara 平行光 w04cキャラ平行光 \
		 -c 61 142 174 \
		 -p -100 -3500 -2000
}
proc w04cのプリシェード平環光セット {
	chara 環境光 w04cプリ環境光 \
		 -c 63 35 17
	chara 平行光 w04cプリ平行光 \
		 -c 255 119 70 \
		 -p 0 -4300 -2500
}

// w04bステージにあたる場所での平行、環境光
proc w04bのキャラ平環光セット {
	chara 環境光 w04bキャラ環境光 \
		 -c 4 35 44
	chara 平行光 w04bキャラ平行光 \
		 -c 54 86 70 \
		 -p 321 1705 0
}
proc w04bのプリシェード平環光セット {
	chara 環境光 w04bプリ環境光 \
		 -c 24 91 94
	chara 平行光 w04bプリ平行光 \
		 -c 80 35 5 \
		 -p 3800 -3200 -100
}

// w04aステージにあたる場所での平行、環境光
proc w04aのキャラ平環光セット {
	chara 環境光 w04aキャラ環境光 \
		 -c 53,73,55
	chara 平行光 w04aキャラ平行光 \
		 -c 70,230,214 \
		 -p 691,721,0
}
proc w04aのプリシェード平環光セット {
	chara 環境光 w04aプリ環境光 \
		 -c 24 91 94
	chara 平行光 w04aプリ平行光 \
		 -c 80 35 5  \
		 -p 2200,-4300,1000
}

// レイコクピットアップでの平行、環境光
proc レイコクピットのキャラ平環光セット {
	chara 環境光 レイキャラ環境光 \
		 -c 53,73,55
	chara 平行光 レイキャラ平行光 \
		 -c 70,230,214 \
		 -p 691,721,0
}
proc レイコクピットのプリシェード平環光セット {
	chara 環境光 レイプリ環境光 \
		 -c 63 35 17
//		 -c 15,31,33
	chara 平行光 レイプリ平行光 \
		 -c 255 119 70 \
//		 -c 64,64,64 \
		 -p 2200,-4300,1000
}

proc 水面発生{
	print'水面発生'
	chara キラキラ水面２ 水面 \
	-tex water_sur water_add_bld080_ovl \
	-pos 0,-15300,-12000 \
	-ctrl // これをつけると水面コントロールキャラによる水面高さの変更が可能に

	chara delay ディレイ \
		-time 1 \ 
		-exec{
			mesg キラキラ水面２ 水面 波発生源追加 rev_def
	}

		chara 水中カメラ ゆらぎマン \
			-col 128 128 160 \
			-warp 2
// 室内用水面オブジェクト
// テクスチャはこの波プログラム専用のテクスチャ単体でPACK_ALLしたTRIファイルが必要なので注意
// メッセージを送るとそのキャラの動きによって水面に波が立つ。

}
proc 水面移動_原点にもどる{
	print'水面移動'
	mesg キラキラ水面２ 水面 表示位置移動 0,-15300,-13000
}

proc 水面移動_第二船倉に移動{
	print'水面移動'
	mesg キラキラ水面２ 水面 表示位置移動 0,-15300,(-13000+28500)
}

proc 水面移動_第一船倉に移動{
	print'水面移動'
	mesg キラキラ水面２ 水面 表示位置移動 0,-15300,(-13000+28500+28500)
}

//@ライトのフレアオフ

proc リアル影セット {
#if 1
print 'リアル影000'
	chara 影投影モデル 演説台モデル \
		-model w04c1_drk \
		-pos 0 0 0

	chara 影管理 演説台 \
		-type 0 \
		-length 6000

chara delay 前 -time 60 -exec {

/*	mesg 影管理 演説台 add sco_def 演説台モデル
	mesg 影管理 演説台 add rev_coat 演説台モデル
	mesg 影管理 演説台 add crg_def_mh_mt 演説台モデル

	mesg 影管理 演説台 add us_def1_A1 演説台モデル
	mesg 影管理 演説台 add us_def1_A2 演説台モデル
	mesg 影管理 演説台 add us_def1_A3 演説台モデル
	mesg 影管理 演説台 add us_def1_A4 演説台モデル

	mesg 影管理 演説台 add us_def1_B1 演説台モデル
	mesg 影管理 演説台 add us_def1_B2 演説台モデル
	mesg 影管理 演説台 add us_def1_B3 演説台モデル
	mesg 影管理 演説台 add us_def1_B4 演説台モデル

	mesg 影管理 演説台 add us_def1_C1 演説台モデル
	mesg 影管理 演説台 add us_def1_C2 演説台モデル
	mesg 影管理 演説台 add us_def1_C3 演説台モデル
	mesg 影管理 演説台 add us_def1_C4 演説台モデル
*/
}
//	mesg 影管理 $s:名前 del[1] $s:削除キャラ
	// 光源タイプ
	//   0:無限遠並行光源（ステージの平行光に対して）
	//   1:点光源エミュレーション（影フラグのついた点光源に対して）
	// メッセージにより追加、削除ができるので部屋の入口のトラップなどに
	// 引っかけて使用すると良い
	// 投影モデル名指定を指定することで特定の投影モデルのみに投影することが可能
	// また、すでに影を表示しているキャラに対してさらにaddでメッセージを
	// 送ると投影モデル名のみの変更が可能です。

#else
print 'リアル影001'
	chara スポットライト投影モデル 演説台 \
		-model w04c1_drk \
//		-pos 0 0 (-28500-39500)
		-pos 0 0 0
print 'リアル影002'
	chara 静止スポットライト設置 演説台 \
		-pos -1000, -8750, -14500 \
		-dir 490, 0, 0 \
		-range 20000 \
		-angle 53 \
		-color 128,128,100 \
		-option 0x8000
//		-option 0x0000
print 'リアル影003'
#endif
}

proc us_def1_A1thruC4一気消し {
	mesg 影管理 演説台 del us_def1_A1
	mesg 影管理 演説台 del us_def1_A2
	mesg 影管理 演説台 del us_def1_A3
	mesg 影管理 演説台 del us_def1_A4

	mesg 影管理 演説台 del us_def1_B1
	mesg 影管理 演説台 del us_def1_B2
	mesg 影管理 演説台 del us_def1_B3
	mesg 影管理 演説台 del us_def1_B4

	mesg 影管理 演説台 del us_def1_C1
	mesg 影管理 演説台 del us_def1_C2
	mesg 影管理 演説台 del us_def1_C3
	mesg 影管理 演説台 del us_def1_C4
}

proc us_def1_A1thruC4一気出し {
	mesg 影管理 演説台 demo_add us_def1_A1 演説台モデル
	mesg 影管理 演説台 demo_add us_def1_A2 演説台モデル
	mesg 影管理 演説台 demo_add us_def1_A3 演説台モデル
	mesg 影管理 演説台 demo_add us_def1_A4 演説台モデル

	mesg 影管理 演説台 demo_add us_def1_B1 演説台モデル
	mesg 影管理 演説台 demo_add us_def1_B2 演説台モデル
	mesg 影管理 演説台 demo_add us_def1_B3 演説台モデル
	mesg 影管理 演説台 demo_add us_def1_B4 演説台モデル

	mesg 影管理 演説台 demo_add us_def1_C1 演説台モデル
	mesg 影管理 演説台 demo_add us_def1_C2 演説台モデル
	mesg 影管理 演説台 demo_add us_def1_C3 演説台モデル
	mesg 影管理 演説台 demo_add us_def1_C4 演説台モデル
}

proc 影だし実験用平行光セット {
	chara 平行光 exp \
		 -c 128 128 128 \
		 -p 500 -2000 1000		// 原点からこの位置に向かって光が射す
}

proc スクリーンショット使用 {
	#if d:SCREEN_SHOT_DEMO
		chara スクリーンショット screenshot
	#endif
}

// プロジェクタへのムービー再生用に必要
proc デモ中のムービー再生セット {
	chara スポットライト背景イメージ指定 ムービー

	chara ＩＰＵ表示パネル ムービーパネル \
		-tex screen_dummy dummy \
		-uv  500 540 3596 3556 \
		-num 2 \
		-pos -9293,-5734, (-19906 + 28500 + 10) \
			 -365, -5734, (-23155 + 28500 + 10) \
			 -9293,-12766,(-19906 + 28500 + 10) \
			 -365, -12766,(-23155 + 28500 + 10) \
			  365, -5734, (-23155 + 28500 + 10) \
			 9293, -5734, (-19906 + 28500 + 10) \
			  365, -12766,(-23155 + 28500 + 10) \
			 9293, -12766,(-19906 + 28500 + 10)
}

