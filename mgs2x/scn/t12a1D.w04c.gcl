chara マップ 船倉３ -h d:STAGE_HZX -l d:STAGE_LT2

command マップ設定 船倉３ -set {

//	デモ環境かゲーム環境かで起動を読み分ける。
// ------------------------------------
#if d:MGS2_DEMO

		// t11 を再生するとき
		eval($s:d_num = t11a1D)
		// t12 を再生するとき
	//	eval($s:d_num = t12a1D)
		// t13 を再生するとき
	//	eval($s:d_num = t13a1D)

chara デモアクトデバッグ demodebug  -i t:t12a2D -d 't12a2D' -l   \
		-p	第三船倉オフ 第三船倉オン \
			第二船倉オフ 第二船倉オン \
			レイキャノピーオフ \
			右プロジェクタオフ 左プロジェクタオフ \
			右プロジェクタオン 左プロジェクタオン \
			右舷ドア２３_オフ 右舷ドア２３_オン \
			右舷ドア２３奥_オフ 右舷ドア２３奥_オン \
			左舷ドア２３_オフ 左舷ドア２３_オン \
			左舷ドア２３奥_オフ 左舷ドア２３奥_オン \
			右舷上部ドア２３_オフ 右舷上部ドア２３_オン \
			右舷上部ドア２３奥_オフ 右舷上部ドア２３奥_オン \
			左舷上部ドア２３_オフ 左舷上部ドア２３_オン \
			左舷上部ドア２３奥_オフ 左舷上部ドア２３奥_オン \
			第三船倉上方へ移動 第三船倉元の位置へ移動 \
			水面発生 水面移動_第二船倉に移動 水面移動_第一船倉に移動 \
			水面移動_原点にもどる \
			ライトのフレアオフ \
			us_def1_A1thruC4一気消し us_def1_A1thruC4一気出し



//	@船倉３海兵隊セット

#else


if($w:t_story < d:ST_T12a1Dメタルギア強奪ポリゴンデモ開始){
	eval($f:global_polygon_demo = 1)
	eval($s:d_num = t12a1D)

	@デモモデル差し替え処理
	proc デモ再生_t12a1D {
		chara demo デモ再生 \
			-i t:t12a1D \
			-p	第三船倉オフ 第三船倉オン \
				第二船倉オフ 第二船倉オン \
				レイキャノピーオフ \
				右プロジェクタオフ 左プロジェクタオフ \
				右プロジェクタオン 左プロジェクタオン \
				右舷ドア２３_オフ 右舷ドア２３_オン \
				右舷ドア２３奥_オフ 右舷ドア２３奥_オン \
				左舷ドア２３_オフ 左舷ドア２３_オン \
				左舷ドア２３奥_オフ 左舷ドア２３奥_オン \
				右舷上部ドア２３_オフ 右舷上部ドア２３_オン \
				右舷上部ドア２３奥_オフ 右舷上部ドア２３奥_オン \
				左舷上部ドア２３_オフ 左舷上部ドア２３_オン \
				左舷上部ドア２３奥_オフ 左舷上部ドア２３奥_オン \
				第三船倉上方へ移動 第三船倉元の位置へ移動 \
				水面発生 水面移動_第二船倉に移動 水面移動_第一船倉に移動 \
				水面移動_原点にもどる \
				ライトのフレアオフ \
				us_def1_A1thruC4一気消し us_def1_A1thruC4一気出し \
			-next t12a1D終了
	}

	@デモ再生_t12a1D

} else if($w:t_story < d:ST_T12a2Dメタルギア強奪ポリゴンデモ２開始){
	eval($f:global_polygon_demo = 1)
	eval($s:d_num = t12a2D)

	@デモモデル差し替え処理
	proc デモ再生_t12a2D {
		chara demo デモ再生 \
			-i t:t12a2D \
			-p	第三船倉オフ 第三船倉オン \
				第二船倉オフ 第二船倉オン \
				レイキャノピーオフ \
				右プロジェクタオフ 左プロジェクタオフ \
				右プロジェクタオン 左プロジェクタオン \
				右舷ドア２３_オフ 右舷ドア２３_オン \
				右舷ドア２３奥_オフ 右舷ドア２３奥_オン \
				左舷ドア２３_オフ 左舷ドア２３_オン \
				左舷ドア２３奥_オフ 左舷ドア２３奥_オン \
				右舷上部ドア２３_オフ 右舷上部ドア２３_オン \
				右舷上部ドア２３奥_オフ 右舷上部ドア２３奥_オン \
				左舷上部ドア２３_オフ 左舷上部ドア２３_オン \
				左舷上部ドア２３奥_オフ 左舷上部ドア２３奥_オン \
				第三船倉上方へ移動 第三船倉元の位置へ移動 \
				水面発生 水面移動_第二船倉に移動 水面移動_第一船倉に移動 \
				水面移動_原点にもどる \
				ライトのフレアオフ \
				us_def1_A1thruC4一気消し us_def1_A1thruC4一気出し \
			-next t12a2D終了
	}

	@デモ再生_t12a2D

}

	// 本番では共通でつかう
	@デモキャンセルチェックプロック

#endif
