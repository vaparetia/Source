// 初期マップの表示
command マップ表示 	-add 船倉３

// 必ずステージのshow(add)の後にセットすること。
//@デフォルトキャラ専用ライトセット
@影だし実験用平行光セット

// デモ再生関係用プロック設定
// ------------------------------------
// とりあえずダミープロック
proc null_proc {}

proc デモキャンセル {

	// ポーズオフ
	command メニュー設定 -p off

	// プログラムで起動しているSEがあれば、ここで切る
	command セットサウンドコード -c d:SNG_FOUTS_S
	command セットサウンドコード -c d:SE_JOUCHUU_OFF

	command StreamStopAll
}

proc デモキャンセルチェックプロック {

	chara デモキャンセルチェック デモキャンセル \
		-p デモキャンセル
}

proc t12a1D終了 {
	if ($f:ローポリ劇場フラグ == d:TRUE) {
		// ローポリ劇場中
		@mv_lowpoly

	} else {
		// 通常ゲーム中
		mesg デモキャンセルチェック デモキャンセル kill

		eval($f:global_polygon_demo = 0)

		chara delay ディレイ \
			-time 1 \ 
			-exec{
				#if d:DEMO_SKIP_ENABLE
					// タンカー編終了まで飛ぶ
					eval($w:t_story = d:ST_T13a1Dメタルギア逃走ポリゴンデモ終了)
					// タイトルもしくはプラント最初まで飛ぶ。
					load 'title'
				#else
					eval($w:t_story = d:ST_T12a1Dメタルギア強奪ポリゴンデモ終了)
					restart
				#endif
			}
	}
}

proc t12a2D終了 {
	mesg デモキャンセルチェック デモキャンセル kill

	eval($f:global_polygon_demo = 0)

	chara delay ディレイ \
		-time 1 \ 
		-exec{
			#if d:DEMO_SKIP_ENABLE
				// タンカー編終了まで飛ぶ
				eval($w:t_story = d:ST_T13a1Dメタルギア逃走ポリゴンデモ終了)
				// タイトルもしくはプラント最初まで飛ぶ。
				load 'title'
			#else
//				eval($w:t_story = d:ST_T12a3Dメタルギア強奪ポリゴンデモ３終了)
				eval($w:t_story = d:ST_T12a2Dメタルギア強奪ポリゴンデモ２終了)
				load 'd12t3'
			#endif
		}

}


proc シネマスクリーンセット  {
	chara シネマスクリーン シネマ \
		-top d:CINEMA_BELT_UPPER \
		-bottom d:CINEMA_BELT_LOWER \
		-ftime 60	//デフォルト値（ゼロは駄目）
	mesg シネマスクリーン シネマ フェードアウト 1
}


// エフェクト設定
// ------------------------------------
proc エフェクト設定 {
	chara フォグ fog \
		 -c 24 30 24 \
		 -n 2200 \
		 -f 53600
}

// 設置オブジェクト
// ------------------------------------
proc 第三船倉セット {
	// 船倉本体（レイ下明かり無し）
	chara プットオブジェ third_hold \
		-m w04c1_drk \
		-r 0 0 0 \
		-p 0 0 0 \
		-l d:STAGE_LT2 \
		-f 0x0040 \
		-s 100 100 100 
	// レイ下明かり
	chara プットオブジェ third_hold_lit \
		-m w04c1_lit \
		-r 0 0 0 \
		-p 0 0 0 \
		-l d:STAGE_LT2 \
		-s 100 100 100 

	chara プットスポットライトオブジェ フレア光源右上 \
		-m null null \
		-n null \
		-t (6000-3000),-15000,(-14750+3000) 100 4000 \
		-l d:STAGE_LT2 \
		-p 0,0,0
	chara プットスポットライトオブジェ フレア光源右下 \
		-m null null \
		-n null \
		-t (6000-3000),-15000,(250-3000) 100 4000 \
		-l d:STAGE_LT2 \
		-p 0,0,0
	chara プットスポットライトオブジェ フレア光源左上 \
		-m null null \
		-n null \
		-t (-6000+3000),-15000,(-14750+3000) 100 4000 \
		-l d:STAGE_LT2 \
		-p 0,0,0
	chara プットスポットライトオブジェ フレア光源左下 \
		-m null null \
		-n null \
		-t (-6000+3000),-15000,(250-3000) 100 4000 \
		-l d:STAGE_LT2 \
		-p 0,0,0
}

proc 第三船倉オフ {
	mesg プットオブジェ third_hold off
}

proc 第三船倉オン {
	mesg プットオブジェ third_hold on
}

proc 第三船倉上方へ移動 {
	mesg プットオブジェ third_hold move 0 17000 (-11250-3000+25800)
}

proc 第三船倉元の位置へ移動 {
	mesg プットオブジェ third_hold move 0 0 0
}

proc ライトのフレアオフ {
print 'ライトのフレアオフ_000'
	mesg プットオブジェ third_hold_lit off

print '光源消す_000'
	mesg プットスポットライトオブジェ フレア光源右上 ライト消す
	mesg プットスポットライトオブジェ フレア光源右下 ライト消す
	mesg プットスポットライトオブジェ フレア光源左上 ライト消す
	mesg プットスポットライトオブジェ フレア光源左下 ライト消す
print '光源消す_001'
print 'ライトのフレアオフ_001'
}

proc メタルギア零設定 {
	chara プットオブジェ MetalGear_Ray \
		-m ray_w04c1 \
		-r 0 0 0 \
		-p 0 0 0 \
		-l d:STAGE_LT2 \
		-s 100 100 100 
	chara プットオブジェ MetalGear_Ray_canopy_外版 \
		-m ray_canopy_w04c1_mt \
		-r 0 0 0 \
		-p 0 0 0 \
		-l d:STAGE_LT2 \
		-f 0x0020 \
		-s 100 100 100
}

proc レイキャノピーオフ {
	mesg プットオブジェ MetalGear_Ray_canopy_外版 off
}

proc 第二船倉セット {
print '第二船倉セット'
	@w04bのプリシェード平環光セット
	chara プットオブジェ second_hold \
		-m w04b1_brk \
		-r 0 0 0 \
		-p 0 0 28500 \
		-l d:STAGE_LT2 \
		-s 100 100 100 
		mesg プットオブジェ second_hold off
	@w04cのプリシェード平環光セット
print '第二船倉セットE'
}

proc 第二船倉オフ {
	mesg プットオブジェ second_hold off
}

proc 第二船倉オン {
print '第二船倉オン'
	mesg プットオブジェ second_hold on
print '第二船倉オンE'
}


// ドアオブジェクト
// ------------------------------------
proc ドア設置／通路２−船倉３ {
// 第三船倉にあるドア
	chara プットオブジェ 右舷ドア２３ \
		-m w04_dr \
		-r 0,2048,0 \
		-p 8750,-17000,50 \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0010

	chara プットオブジェ 右舷ドア２３奥 \
		-m w04_dr \
		-r 0,0,0 \
		-p 7250,-17000,4450 \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0010

	chara プットオブジェ 左舷ドア２３ \
		-m w04_dr \
		-r 0,2048,0 \
		-p -7250,-17000,50 \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0010

	chara プットオブジェ 左舷ドア２３奥 \
		-m w04_dr \
		-r 0,0,0 \
		-p -8750,-17000,4450 \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0010

	chara プットオブジェ 右舷上部ドア２３ \
		-m w04_dr \
		-r 0,2048,0 \
		-p 11750,-9000,50 \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0010

	chara プットオブジェ 右舷上部ドア２３奥 \
		-m w04_dr \
		-r 0,0,0 \
		-p 10250,-9000,4450 \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0010

	chara プットオブジェ 左舷上部ドア２３ \
		-m w04_dr \
		-r 0,2048,0 \
		-p -10250,-9000,50 \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0010

	chara プットオブジェ 左舷上部ドア２３奥 \
		-m w04_dr \
		-r 0,0,0 \
		-p -11750,-9000,4450 \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0010

// 第二船倉右手前（第一船倉側）
	chara プットオブジェ 右舷ドア１２ \
		-m w04_dr \
		-r 0,2048,0 \
		-p 8750,-17000,(50+28500) \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0020

	chara プットオブジェ 右舷上部ドア１２ \
		-m w04_dr \
		-r 0,2048,0 \
		-p 11750,-9000,(50+28500) \
		-s 100 100 100 \
		-l d:STAGE_LT2 \
		-f 0x0020
}

