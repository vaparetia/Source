#define		VR_SNEAKING		1		// 共通プロック切り分け用

// ステージ名
#define		STAGE_VS07A		1		// 共通プロック切り分け用

// 敵兵、ＮＰＣ状況（薬莢を呼び分けるのに必要）
#define		ENE_P_GOL		1		// 都市迷彩ゴル兵
#define		ENE_SHOT		1		// ショットガン兵
#define		ENE_HIGH_TECH	1		// ハイテク兵
#define		ENE_SHIELD		1		// 盾兵

// オブジェクト
#define		SD_LOCKER_HZD 	1
#define		SD_LOCKER_FLR 	1

// ------------------------------------
// 各種スイッチ用define
// ------------------------------------
// デバッグ関係
#ifdef	d:FIX_MODE
	#define		DEBUG_CHARA		0		// デバッグキャラ全体(FIX時は0)
#else
	#define		DEBUG_CHARA		0		// デバッグキャラ全体
#endif
#define		CHARA_CAMERA	0		// キャラ追従カメラ
#define		TARGET_CHARA	敵兵:01	// キャラ追従カメラのターゲット
#define		SCREENSHOT		0		// スクリーンショット
#define		USB_KEY			0		// USBキーボード


// ------------------------------------
// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME			vs07a
#define		KMS_NAME			vs07a
#define		TONBO_KMS_NAME		vs07a_tonbo
#define		LINE_KMS_NAME		vs07a_line

// キャラクター関係
#define		PLAYER		ライデン

// ------------------------------------
// 敵兵音声
// ------------------------------------

// ------------------------------------
// 敵兵ルート番号
// ------------------------------------
enum E_R {
	敵増援出現ポイント = 0,
	雷電道１死体発見,
	雷電道２ロータリー,
	雷電道３ゴール前,
	雷電道４寝てる奴,
	蛇道１死体発見１,
	蛇道２死体発見２,
	蛇道３ロータリー後,
	蛇道４寝てる奴,
	蛇道５増援ロータリー,
	昔蛇１,
	昔蛇２,
	昔蛇３,
	昔蛇４,
	昔蛇５,
	昔蛇６,
	昔蛇７,
	昔蛇８,
};

// ＶＲウィンドウ スニーキング
#define WINDOW_SNEAKING_VS07A		[VRMSG_J:VRM_SNK_SNK_vs07a] [VRMSG_E:VRM_SNK_SNK_vs07a] [VRMSG_G:VRM_SNK_SNK_vs07a] \	// 日、英、独
									[VRMSG_F:VRM_SNK_SNK_vs07a] [VRMSG_I:VRM_SNK_SNK_vs07a] [VRMSG_S:VRM_SNK_SNK_vs07a] \	// 仏、伊、西
									[VRMSG_K:VRM_SNK_SNK_vs07a] \															// 韓
									p:ＶＲステージ開始時処理								// 終了プロック
// ＶＲウィンドウ 全殺し
#define WINDOW_ELIM_ALL_VS07A		[VRMSG_J:VRM_SNK_ELM_vs07a] [VRMSG_E:VRM_SNK_ELM_vs07a] [VRMSG_G:VRM_SNK_ELM_vs07a] \	// 日、英、独
									[VRMSG_F:VRM_SNK_ELM_vs07a] [VRMSG_I:VRM_SNK_ELM_vs07a] [VRMSG_S:VRM_SNK_ELM_vs07a] \	// 仏、伊、西
									[VRMSG_K:VRM_SNK_ELM_vs07a] \															// 韓
									p:ＶＲステージ開始時処理								// 終了プロック

#define	WATCHER_STATUS				d:ENE_STATUS_NORMAL スニーキング７面
#define ATTACKER_STATUS				d:E_R:敵増援出現ポイント d:ENE_STATUS_NORMAL d:ENE_EQUIP_TYPE_NORMAL

// 敵兵メモリ用define
/*				command セット敵兵メモリー \
					vs07a スニーキング７面 敵兵:04 \			// stage mapID name
					1000 0 4000 1250 \							// x y z dir
					d:ENEMEM_ST_FAINT d:ENEMEM_PS_FRONT 2000 \	// status pose down_time
					$w:敵標準気絶  $w:敵標準体力 0 0			// faint_st life pos_damage Item
*/
#define メモリ設定前部 vs07a スニーキング７面
#define メモリ設定中部 d:ENEMEM_ST_FAINT d:ENEMEM_PS_FRONT
#define メモリ設定後部 $w:敵標準気絶  $w:敵標準体力 0 0

// ------------------------------------
// アイテム位置
// ------------------------------------
#define 最初左ロカ 		-4280 0 4500
#define ヘアピンロカ	6500 0 -9280
#define 廻廊北ロカ		13500 0 1280
#define ゴール前ロカ	23500 0 -1280
// ------------------------------------
// 弾数設定
// ------------------------------------
#define ライデン弾数 12
#define スネーク弾数 8
#define ぷりすき弾数 6
#define たきへび弾数 4
