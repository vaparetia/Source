		}

		trap lk006 d:PLAYER \
			-and \
			-mask いる \
			-state 0,4 \
			-dir 2048,512 0,512 \
			-key d:PAD_ACTION,-1 \				//アクションボタン
			-exec {
				mesg プレイヤー d:PLAYER locker ロッカー06 $status 2048,512 7000,-9000
			}
		trap lk006 d:PLAYER \
			-mask ？ \
			-state 6 \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 5551,5712,-5556 -t 6156,1579,-8120 \
					-r 654,1897,0 -f 4902 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3
			}

		// ロータリー北側
		if ( $s:選択プレイヤー == スネーク ) {
			chara ロッカー ロッカー07 \
				-kms vr2_locker_door \
				-p 13050,0,1000 \
				-r 0,2048,0 \
				-down_rot 0,1900,0 \
				-down_shift 125,0,0 \
				-s d:LOCKER_STATE_OPEN \
				-seno d:SD_LOCKER_HZD \
				-sefloor d:SD_LOCKER_FLR \
				-exec {
				}
		} else {// スネークのときは開いてる。
			chara ロッカー ロッカー07 \
				-kms vr2_locker_door \
				-p 13050,0,1000 \
				-r 0,2048,0 \
				-down_rot 0,1900,0 \
				-down_shift 125,0,0 \
				-s d:LOCKER_STATE_CLOSE \
				-seno d:SD_LOCKER_HZD \
				-sefloor d:SD_LOCKER_FLR \
				-exec {
