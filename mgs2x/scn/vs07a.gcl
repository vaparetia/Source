// ------------------------------------
// マップ設定
// ------------------------------------
chara マップ スニーキング７面 -k d:KMS_NAME -h d:HZX_NAME,0 -l $s:ＶＲライトファイル名

command マップ設定 スニーキング７面 -set {
	// ローカルの初期化
	// ------------------------------------
	@ローカル変数初期化		// ローカルで使用する変数で初期化をする場合はここで

	// 設定値を変更する場合は以下のプロック内で設定
	// ------------------------------------
	@設定値変更				// 敵兵や的のパラメータをステージ限定で変える時はここで

	// ＶＲで必要な基本プロックのセット(vr_common.hで定義)
	// サウンドの基本パック、ＶＲの基本システム、プレイヤー、ゴール等を設定します
	// ※このプロックを使用する時は「ＶＲクリア時処理」というプロックが必要です
	// ＶＲ共通プロックセット	$:スネークファイル $:雷電ファイル $:クリア条件フラグ
	//							$:ゴールＸ $:ゴールＹ $:ゴールＺ $:タイマー初期値
	//	VR_GOAL_TARGET	/*的全滅でゴールが開く*/
	//	VR_GOAL_FREE	/*ゴールが最初から開いてる*/
	//	VR_GOAL_ENEMY	/*敵全滅でゴールが開く*/
	//	VR_GOAL_SNEAK	/*潜入モード中はゴールが開く*/
	//	VR_GOAL_TIME	/*タイマーがゼロになるとゴールが開く*/
	// ------------------------------------
	@ＶＲスニーキング共通プロックセット sna_vs07a rai_vs07a 29500 0 -7000	// vr_common.h

	// ＶＲウィンドウの設定
	// ------------------------------------
	@スニーキング７面ＶＲウィンドウ設定

	// クリア時に呼ばれるものの設定
	// ------------------------------------
	@ＶＲクリア設定 p:load_vs08a p:A_ＲＥＴＲＹプロック

	// ステージに引かれるライン
	// ------------------------------------
	@ＶＲアウトライン d:KMS_NAME d:TONBO_KMS_NAME d:LINE_KMS_NAME				// vr_common.h

	@プラグイン設定			// プレイヤーのプラグインがいる時はここで

	// 敵兵・的関係の設定
	// ------------------------------------
	@コマンダー設定

	// ＢＧＭの設定(プレイヤー→敵兵→BGMの順で呼ぶ)
	// ------------------------------------
	@ＢＧＭ設定

	// アイテムの設定
	// ------------------------------------
	@アイテム設定

	// 光源、オブジェクト、カメラ関連の設定
	// ------------------------------------
	@ロッカー管理人設置
	@ロッカー設置
	@水溜りエフェクト設置
	@ＶＲフォグ設定 d:VR_FOG:朝Ｎ 45000 -5000 55000 d:VR_FOG:夜Ｎ d:VR_FOG:夜Ｆ
	@カメラセット					// chara カメラとベースのカメラを設定
	@スニーキング７面カメラ設定		// ステージ固有のカメラ設定がいる時はこのプロックで
	@ＶＲキャラ用ライト設置			// 必ず最後に設定 vr_common.h
#if d:DEBUG_CHARA
//	@デバッグキャラセット
#endif
}

//初期マップの表示
command マップ表示 -show スニーキング７面


// 各proc設定
//-------------------------------------------------------------------------------------
// 全マップ共通
proc スニーキング７面ＶＲウィンドウ設定 {
		#if d:DEBUG_PRINT
			print 'vr_window_set'
		#endif
		if( $b:モード番号 == d:SNEAKING:SNEAKING ){
			@ＶＲウィンドウ設定 d:WINDOW_SNEAKING_VS07A
		}else{
			@ＶＲウィンドウ設定 d:WINDOW_ELIM_ALL_VS07A
		}

		// ＶＲウィンドウを表示する
		mesg ＶＲウィンドウ ＶＲウィンドウ君 開く

		// スタート時とクリア時に使用するカットインカメラ
		chara カメラ カットインカメラ		-c 0 -l 0 -p  0

		// スタート時のカメラ(必要な場合)
		chara カメラ設定 カットインカメラ \
			-c 1 \
			-p 29500,5406,-4279 -t 29500,0,-7000 \
			-r 720,2048,0 -f 6052 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1
	}

	//------------------------------------------------------------
	// ステージ開始時処理
	//------------------------------------------------------------
	proc ＶＲステージ開始時処理 {
		#if d:DEBUG_PRINT
			print 'game_start!!!!!'
		#endif

		// プレイヤーやパッドの制御等を行う a_stdproc.hで定義
		@全ミッション共通ステージ開始時処理

		// カメラワークスタート(必要な場合)
		// 全体図
		chara カメラ設定 カットインカメラ \
			-c 1 \
			-p 13100,50930,4824 -t 13100,44910,4221 \
			-r 959,2048,0 -f 6050 \
			-a 200 \
			-i 4 4 d:START_CAMERA_CHANGE_TIME d:START_CAMERA_CHANGE_TIME \
			-s 1

		chara delay ディレイ \
			-time d:START_CAMERA_CHANGE_TIME \
			-exec {
				chara カメラ設定 カットインカメラ -s -1
			}
	}

	// ------------------------------------
	// クリア時の処理
	// ------------------------------------
	proc ＶＲクリア時処理 {
		#if d:DEBUG_PRINT
			print 'clear'
		#endif
		// 強制モーションを発動
		@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_1 0

		// クリア時にカメラアングルを変える
		chara カメラ設定 クリア時カメラ \
			-c 1 \
			-p 29413,1112,-2622 -t 29413,1018,-7684 \
			-r 12,2048,0 -f 5063 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1


	}

	// ------------------------------------
	// パラメータ系の変更
	// ------------------------------------
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT
			print 'localvar_init'
		#endif

	}
	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT
			print 'status_set'
		#endif
		// 初期装備の設定
		@スニーキング用キャラ別標準装備設定 d:ライデン弾数 d:スネーク弾数 d:ぷりすき弾数 d:たきへび弾数

		if ($s:選択プレイヤー == ライデン 			|| \
			$s:選択プレイヤー == スネーク 			|| \
			$s:選択プレイヤー == プリスキン 		|| \
			$s:選択プレイヤー == タキシードスネーク ){
			eval ( $w:アイテム数Ｒ[ d:アイテム:振動センサー ] = 1 );
			eval ( $w:アイテム = d:アイテム:振動センサー );

		}else if( $s:選択プレイヤー == 刀ライデン	|| \
				  $s:選択プレイヤー == 前作スネーク ){
			// 無し
		}else{
			eval ( $w:アイテム数Ｒ[ d:アイテム:振動センサー ] = 1 );
			eval ( $w:アイテム = d:アイテム:振動センサー );
		}
	}

	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif
	}

	// ------------------------------------
	// 敵兵や的の処理
	// ------------------------------------
	// 敵兵に関する設定
	//-------------------------------------
// 気絶兵設定(前作スネーク)
#define 敵兵その１設定 d:メモリ設定前部 \
			敵兵:01 -1500 0 4500 1250 \
			d:メモリ設定中部 \
			(400) \ //約7。
			d:メモリ設定後部

#define 敵兵その２設定 d:メモリ設定前部 \
			敵兵:02 6500 0 -7500 23 \
			d:メモリ設定中部 \
			(60*17) \
			d:メモリ設定後部

#define 敵兵その３設定 d:メモリ設定前部 \
			敵兵:03 9500 0 -3500 3000 \
			d:メモリ設定中部 \
			(1420) \ // 約24。 23.66
			d:メモリ設定後部

#define 敵兵その４設定 d:メモリ設定前部 \
			敵兵:04 16500 0 3500 323 \
			d:メモリ設定中部 \
			(60*27) \
			d:メモリ設定後部

	proc 警備兵セット {
		#if d:DEBUG_PRINT
			print 'watcher_set'
		#endif
		if(	($s:選択プレイヤー == ライデン)		|| \
			($s:選択プレイヤー == プリスキン)	|| \
			($s:選択プレイヤー == 刀ライデン)	){

			if(`@スニーキング判定`){// スニーキングのときのみ
				// 04 番の敵は気絶してたり。
				command セット敵兵メモリー \
					vs07a スニーキング７面 敵兵:04 \			// stage mapID name
					1000 0 4000 1250 \							// x y z dir
					d:ENEMEM_ST_FAINT d:ENEMEM_PS_FRONT 2000 \	// status pose down_time
					$w:敵標準気絶  $w:敵標準体力 0 0			// faint_st life pos_damage Item
			}

			//  ノード番号注意。0から始まってないのもあるですYO!
			@VR_スニーキング警備兵 敵兵:01 d:E_R:雷電道１死体発見	1 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:02 d:E_R:雷電道２ロータリー	0 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:03 d:E_R:雷電道３ゴール前	2 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:04 d:E_R:雷電道４寝てる奴	0 d:WATCHER_STATUS

		}else if(($s:選択プレイヤー == スネーク)			|| \
				 ($s:選択プレイヤー == タキシードスネーク)	){
			if(`@スニーキング判定`){
				// 04 番の敵は気絶してたり。
				command セット敵兵メモリー \
					vs07a スニーキング７面 敵兵:04 \
					2500 0 4000 1250 \
					d:ENEMEM_ST_FAINT d:ENEMEM_PS_FRONT 1500 \
					$w:敵標準気絶  $w:敵標準体力 0 0
			}
			//  ノード番号注意。0から始まってないのもあるですYO!
			@VR_スニーキング警備兵 敵兵:01 d:E_R:蛇道１死体発見１		2 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:02 d:E_R:蛇道２死体発見２		2 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:03 d:E_R:蛇道３ロータリー後		0 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:04 d:E_R:蛇道４寝てる奴			1 d:WATCHER_STATUS

		}else if( $s:選択プレイヤー == 前作スネーク ){
			if(`@スニーキング判定`){
				command セット敵兵メモリー d:敵兵その１設定
				command セット敵兵メモリー d:敵兵その２設定
				command セット敵兵メモリー d:敵兵その３設定
				command セット敵兵メモリー d:敵兵その４設定
			}
			@VR_スニーキング警備兵 敵兵:01 d:E_R:昔蛇１		0 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:02 d:E_R:昔蛇２		0 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:03 d:E_R:昔蛇３		0 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:04 d:E_R:昔蛇４		0 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:05 d:E_R:昔蛇５		0 d:WATCHER_STATUS // ゴール眠り

		}else{
			if(`@スニーキング判定`){
				// 雷電時の敵配置
				command セット敵兵メモリー d:メモリ設定前部 \
					敵兵:04 \
					1000 0 4000 1250 \
					d:メモリ設定中部 \
					2000 \
					d:メモリ設定後部
			}
			// ノード番号注意。0から始まってないのもあるですYO!
			@VR_スニーキング警備兵 敵兵:01 d:E_R:雷電道１死体発見	1 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:02 d:E_R:雷電道２ロータリー	0 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:03 d:E_R:雷電道３ゴール前	2 d:WATCHER_STATUS
			@VR_スニーキング警備兵 敵兵:04 d:E_R:雷電道４寝てる奴	0 d:WATCHER_STATUS
		}
	}

	proc 攻撃兵セット {
		#if d:DEBUG_PRINT
			print 'attacker_set'
		#endif
		if(	($s:選択プレイヤー == ライデン)		|| \
			($s:選択プレイヤー == プリスキン)	|| \
			($s:選択プレイヤー == 刀ライデン)	){
			@VR_サポート攻撃兵 攻撃兵:01 d:ATTACKER_STATUS 敵兵:01
			@VR_サポート攻撃兵 攻撃兵:02 d:ATTACKER_STATUS 敵兵:02
			@VR_サポート攻撃兵 攻撃兵:03 d:ATTACKER_STATUS 敵兵:04

		}else if(($s:選択プレイヤー == スネーク)			|| \
				 ($s:選択プレイヤー == タキシードスネーク)	){
			@VR_探索攻撃兵 		攻撃兵:01 d:ATTACKER_STATUS d:E_R:蛇道５増援ロータリー

			@VR_サポート攻撃兵	攻撃兵:02 d:ATTACKER_STATUS 敵兵:03
			@VR_サポート攻撃兵	攻撃兵:03 d:ATTACKER_STATUS 敵兵:04

		}else if( $s:選択プレイヤー == 前作スネーク ){
			@VR_探索攻撃兵 		敵兵:61 d:ATTACKER_STATUS d:E_R:昔蛇６
			@VR_探索攻撃兵 		敵兵:62 d:ATTACKER_STATUS d:E_R:昔蛇７
			@VR_探索攻撃兵 		敵兵:63 d:ATTACKER_STATUS d:E_R:昔蛇８
		}else{
			@VR_サポート攻撃兵 攻撃兵:01 d:ATTACKER_STATUS 敵兵:01
			@VR_サポート攻撃兵 攻撃兵:02 d:ATTACKER_STATUS 敵兵:02
			@VR_サポート攻撃兵 攻撃兵:03 d:ATTACKER_STATUS 敵兵:04
		}
	}

	proc 警備兵コマンダー {
		#if d:DEBUG_PRINT
			print 'wccomm_set'
		#endif

		chara 警備コマンダー wccomm -e {警備兵セット}
	}

	proc 攻撃兵コマンダー {
		#if d:DEBUG_PRINT
			print 'atcomm_set'
		#endif
		chara 攻撃コマンダー atcomm -e {攻撃兵セット}
	}

	proc コマンダー設定 {
		#if d:DEBUG_PRINT
			print 'commander_set'
		#endif

		chara コマンダー 敵兵セット \
			-w 警備兵コマンダー \
			-a 攻撃兵コマンダー \
			-d スニーキング７面 \
			-r 29500,0,-7000 スニーキング７面 \
			-c 29500,0,-7000 スニーキング７面 \
			-v [ene_vr_voice:01] \
			-z $i:敵標準麻酔持続 \
			-h $i:標準警戒時間 \
			-o $i:敵標準気絶持続 \
			-s (d:ENE_STAGE_GPS | d:ENE_STAGE_VR_ANOTHER) \
			-b 0 \
			-m d:ALERT_MODE_SENNYU
	}



	// ------------------------------------
	// ＢＧＭの設定
	// ------------------------------------
	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT
			print 'bgm_set'
		#endif

		chara ＢＧＭマネージャー ＢＧＭマネ
	}


	// ------------------------------------
	// アイテムの設定
	// ------------------------------------
	// 再発生が必要な時は以下のプロックの中を記述する
	// ------------------------------------
	proc アイテム取得時番号設定 $:ボックス名 {
		#if d:DEBUG_PRINT
			print 'item_no_set'
		#endif
	}
	// アイテムの設置
	// ------------------------------------
	proc アイテム設定 {
		#if d:DEBUG_PRINT
			print 'item_set'
		#endif
		if(`@スニーキング判定`){
			// 特に無し
		}else{
			switch( $s:選択プレイヤー ){
				case( ライデン ){
					@A_Ｍ９_初期設置 えむきゅう d:最初左ロカ 0 なし 15
				}
				case( プリスキン ){
					@A_Ｍ９_初期設置 えむきゅう d:廻廊北ロカ 0 なし 8
				}
				case( 刀ライデン ){
					// なし
				}
				case( スネーク ){
					@A_Ｍ９_初期設置 えむきゅう d:ヘアピンロカ 0 なし 8
				}
				case( タキシードスネーク ){
					// なし
				}
				case( 前作スネーク ){
					@A_Ｍ９_初期設置 Ｍ９ d:ゴール前ロカ 0 なし 5
					@A_ＵＳＰ_初期設置 ＵＳＰ d:廻廊北ロカ 0 なし 5
					@ＵＳＰサプレッサ_初期設置 さぷれ d:ヘアピンロカ 0
				}
				default{
				}
			}
		}
	}
	// ------------------------------------
	// その他オブジェクト関連
	// ------------------------------------
	// ------------------------------------
	// ロッカー
	// ------------------------------------
	proc ロッカー管理人設置 {
		#if d:DEBUG_PRINT
			print 'locker_general_set'
		#endif
		// -n 個数
		chara ロッカー管理 管理人さん -n 9
		command ロッカーモーション -motion locker
		command プレイヤーロッカーモーション -motion sna_locker
	}
	proc ロッカー設置 {
		#if d:DEBUG_PRINT
			print 'locker_set'
		#endif

		// スタート地点左
		switch( $s:選択プレイヤー ){
			case( 前作スネーク ){
				// 開いてる
				chara ロッカー ロッカー01 \
					-kms vr2_locker_door \
					-p -4000,0,4050 \
					-r 0,1024,0 \
					-down_rot 0,800,0 \
					-down_shift 125,0,0 \
					-s d:LOCKER_STATE_OPEN \
					-seno d:SD_LOCKER_HZD \
					-sefloor d:SD_LOCKER_FLR \
					-exec {
					}
			}
			default{
				// 閉まってる
				chara ロッカー ロッカー01 \
					-kms vr2_locker_door \
					-p -4000,0,4050 \
					-r 0,1024,0 \
					-down_rot 0,800,0 \
					-down_shift 125,0,0 \
					-s d:LOCKER_STATE_CLOSE \
					-seno d:SD_LOCKER_HZD \
					-sefloor d:SD_LOCKER_FLR \
					-exec {
					}
			}

		}
		trap lk001 d:PLAYER \
			-and \
			-mask いる \
			-state 0,4 \
			-dir 3072,512 1024,512 \
			-key d:PAD_ACTION,-1 \				//アクションボタン
			-exec {
				mesg プレイヤー d:PLAYER locker ロッカー01 $status 3072,512 -4000,4000
			}
		trap lk001 d:PLAYER \
			-mask ？ \
			-state 6 \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p -1229,4692,6871 -t -3051,1574,4551 \
					-r 530,2482,0 -f 4292 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3
			}
		// スタート地点下
		switch( $s:選択プレイヤー ){
			case ( ライデン ) {
				// 閉まってる
				chara ロッカー ロッカー02 \
					-kms vr2_locker_door \
					-p -950,0,6000 \
					-r 0,2048,0 \
					-down_rot 0,2100,0 \
					-down_shift 125,0,0 \
					-s d:LOCKER_STATE_CLOSE \
					-seno d:SD_LOCKER_HZD \
					-sefloor d:SD_LOCKER_FLR \
					-exec {
					}
			}
			case( スネーク ) {
				// 壊れてる
				chara ロッカー ロッカー02 \
					-kms vr2_locker_door \
					-p -950,0,6000 \
					-r 0,2048,0 \
					-down_rot 0,2048,0 \
					-down_shift 0,0,0 \
					-s d:LOCKER_STATE_DESTROY \
					-seno d:SD_LOCKER_HZD \
					-sefloor d:SD_LOCKER_FLR \
					-exec {
					}
			}
			case( 前作スネーク ) {
				// 開いてる
				chara ロッカー ロッカー02 \
					-kms vr2_locker_door \
					-p -950,0,6000 \
					-r 0,2048,0 \
					-down_rot 0,2100,0 \
					-down_shift 125,0,0 \
					-s d:LOCKER_STATE_OPEN \
					-seno d:SD_LOCKER_HZD \
					-sefloor d:SD_LOCKER_FLR \
					-exec {
					}
			}
			default{
				chara ロッカー ロッカー02 \
					-kms vr2_locker_door \
					-p -950,0,6000 \
					-r 0,2048,0 \
					-down_rot 0,2100,0 \
					-down_shift 125,0,0 \
					-s d:LOCKER_STATE_CLOSE \
					-seno d:SD_LOCKER_HZD \
					-sefloor d:SD_LOCKER_FLR \
					-exec {
					}

			}
		}
		trap lk002 d:PLAYER \
			-and \
			-mask いる \
			-state 0,4 \
			-dir 0,512 2048,512 \
			-key d:PAD_ACTION,-1 \				//アクションボタン
			-exec {
				mesg プレイヤー d:PLAYER locker ロッカー02 $status 0,512 -1000,6000
			}
		trap lk002 d:PLAYER \
			-mask ？ \
			-state 6 \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 1591,4648,2339 -t -275,1520,5180 \
					-r 485,3717,0 -f 4619 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3
			}

		// 迂回後突き当り
		chara ロッカー ロッカー03 \
			-kms vr2_locker_door \
			-p 9050,0,8000 \
			-r 0,2048,0 \
			-down_rot 0,2100,0 \
			-down_shift 125,0,0 \
			-s d:LOCKER_STATE_CLOSE \
			-seno d:SD_LOCKER_HZD \
			-sefloor d:SD_LOCKER_FLR \
			-exec {
