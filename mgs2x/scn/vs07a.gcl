		trap lk004 d:PLAYER \
			-and \
			-mask いる \
			-state 0,4 \
			-dir 2048,512 0,512 \
			-key d:PAD_ACTION,-1 \				//アクションボタン
			-exec {
				mesg プレイヤー d:PLAYER locker ロッカー04 $status 2048,512 24000,-1000
			}
		trap lk004 d:PLAYER \
