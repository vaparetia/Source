	// ------------------------------------
	// 水溜りエフェクト
	// ------------------------------------
	proc 水溜りエフェクト設置 {
		#if d:DEBUG_PRINT
			print 'ripple_set'
		#endif
		command foreach -argc 2 -repeat 6 \
			-data { \
					{ 2500, -2500 } \
					{ 3500, -2500 } \
					{ 4500, -2500 } \
					{ 2500, -1500 } \
					{ 3500, -1500 } \
					{ 4500, -1500 } \
				} \
				-exec { \
					chara ＶＲ床パネル ＶＲ床パネル -pos $1 0 $2
				}
	}
	// ------------------------------------
	// カメラ関係の設定
	// ------------------------------------
	// ステージカメラ設定
	// ------------------------------------
	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'chara_camera & stage_camera_set'
		#endif

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0
		chara カメラ メインカメラ		-c 0 -l 2 -p 40
		chara カメラ モーションカメラ	-c 0 -l 2 -p 30
		chara カメラ クリア時カメラ		-c 0 -l 0 -p 10

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l -1700,d:CAM_MIN,-6187 28800,d:CAM_MAX,6954 \
			-r 712,2048,0 \
			-f 10000 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}

	// ステージ固有のカメラ設定
	// ------------------------------------
	proc スニーキング７面カメラ設定 {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif
		// -------------------------
		// 2m壁裏カメラ
		// -------------------------
		// スタート地点
		trap ca001 d:PLAYER \
			-mask ？ \
			-camera \
			-state d:TRP_STATE_SQUAT d:TRP_STATE_GROUND d:TRP_STATE_CAUTION\
			-exec {
				chara カメラ設定 メインカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l -1700,d:CAM_MIN,-6187 28800,d:CAM_MAX,6954 \
					-r 870,2048,0 \
					-f 9000 \
					-a 200 \
					-i 3 3 0 0 \
					-s $3
			}
		// スタート南
		trap ca002 d:PLAYER \
			-mask ？ \
			-camera \
			-state d:TRP_STATE_SQUAT d:TRP_STATE_GROUND d:TRP_STATE_CAUTION\
			-exec {
				chara カメラ設定 メインカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l -1700,d:CAM_MIN,-6187 28800,d:CAM_MAX,6954 \
					-r 870,2048,0 \
					-f 9000 \
					-a 200 \
					-i 3 3 0 0 \
					-s $3
			}
		// 最北ロッカー前
		trap ca003 d:PLAYER \
			-mask ？ \
			-camera \
			-state d:TRP_STATE_SQUAT d:TRP_STATE_GROUND d:TRP_STATE_CAUTION\
			-exec {
				chara カメラ設定 メインカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l -1700,d:CAM_MIN,-6187 28800,d:CAM_MAX,6954 \
					-r 950,2048,0 \
					-f 9000 \
					-a 200 \
					-i 3 3 0 0 \
					-s $3
			}
		// ロータリー北
		trap ca004 d:PLAYER \
			-mask ？ \
			-camera \
			-state d:TRP_STATE_SQUAT d:TRP_STATE_GROUND d:TRP_STATE_CAUTION\
			-exec {
				chara カメラ設定 メインカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l -1700,d:CAM_MIN,-6187 28800,d:CAM_MAX,6954 \
					-r 900,2048,0 \
					-f 9000 \
					-a 200 \
					-i 3 3 0 0 \
					-s $3
			}
		// ロータリー南側
		trap ca005 d:PLAYER \
			-mask ？ \
			-camera \
			-state d:TRP_STATE_SQUAT d:TRP_STATE_GROUND d:TRP_STATE_CAUTION\
			-exec {
				chara カメラ設定 メインカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l -1700,d:CAM_MIN,-6187 28800,d:CAM_MAX,6954 \
					-r 870,2048,0 \
					-f 9000 \
					-a 200 \
					-i 3 3 0 0 \
					-s $3
			}
		// ゴール北側
		trap ca006 d:PLAYER \
			-mask ？ \
			-camera \
			-state d:TRP_STATE_SQUAT d:TRP_STATE_GROUND d:TRP_STATE_CAUTION\
			-exec {
				chara カメラ設定 メインカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l -1700,d:CAM_MIN,-6187 28800,d:CAM_MAX,6954 \
					-r 920,2048,0 \
					-f 9000 \
					-a 200 \
					-i 3 3 0 0 \
					-s $3
			}
	}


// -----------------------------------------------------------------------------------
// 以下デバッグ専用proc
// -----------------------------------------------------------------------------------
// デバッグキャラ
// ------------------------------------
proc デバッグキャラセット {
	#if d:DEBUG_PRINT
		print 'debug_chara_set'
	#endif

	#if d:CHARA_CAMERA
		chara キャラカメラ 敵兵カメラ \
			-c d:TARGET_CHARA \
			-s -920,610,200 \
			-r -200,1024,0
	#endif

	#if d:SCREENSHOT
		chara スクリーンショット shot
	#endif

	#if d:USB_KEY
		chara USBキーボード実行 test \
			-e d:KBD_ESC {
				mesg プレイヤー d:PLAYER position -5500, -13000, -500
			} \
	#endif
}
