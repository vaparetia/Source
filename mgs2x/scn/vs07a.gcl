			-dir 1024,512 3072,512 \
			-key d:PAD_ACTION,-1 \				//アクションボタン
			-exec {
				mesg プレイヤー d:PLAYER locker ロッカー05 $status 1024,512 11000,-3000
			}
		trap lk005 d:PLAYER \
			-mask ？ \
			-state 6 \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 7250,5551,-5342 -t 10051,1511,-3550 \
					-r 575,653,0 -f 5232 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3
			}

		// 迂回通路 北
		switch($s:選択プレイヤー){
			case( 前作スネーク ){
				chara ロッカー ロッカー06 \
					-kms vr2_locker_door \
					-p 6950,0,-9000 \
					-r 0,0,0 \
					-down_rot 0,120,0 \
					-down_shift 125,0,0 \
					-s d:LOCKER_STATE_OPEN \
