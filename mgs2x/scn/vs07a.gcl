		trap lk003 d:PLAYER \
			-and \
			-mask いる \
			-state 0,4 \
			-dir 0,512 2048,512 \
			-key d:PAD_ACTION,-1 \				//アクションボタン
			-exec {
				mesg プレイヤー d:PLAYER locker ロッカー03 $status 0,512 9000,8000
			}
		trap lk003 d:PLAYER \
			-mask ？ \
			-state 6 \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 11507,4906,4609 -t 9955,1551,7301 \
					-r 537,3755,0 -f 4573 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3
			}

		// ゴール前角
		chara ロッカー ロッカー04 \
			-kms vr2_locker_door \
			-p 23950,0,-1000 \
			-r 0,0,0 \
			-down_rot 0,100,0 \
			-down_shift 125,0,0 \
			-s d:LOCKER_STATE_CLOSE \
			-seno d:SD_LOCKER_HZD \
			-sefloor d:SD_LOCKER_FLR \
			-exec {
