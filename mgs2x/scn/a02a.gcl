/***************************************************************************************************/
// ビヨンド設定
/***************************************************************************************************/
	proc エンジンルーム右舷Ｂ１ビヨンド設定 {
		#if d:BY_MOTION
			// B1右奥
			trap by000 d:PLAYER \
				-mask いる \
				-button d:ACTION_BUTTON \
				-state 0,4 \	//立ち状態or張り付き
				-exec {
				// 写真撮影でエルード棒があると困るので封鎖する
					//@北向きビヨンド発動 $1 -19950 $4 -8000 8000 ( d:BY_NOFOOTSHADOW )
					@北向きビヨンド発動 $1 -19950 $4 6250 8000 ( d:BY_NOFOOTSHADOW )
				}
			trap by000 d:PLAYER \
				-mask いる \
				-state 6 \
				-dir 2048 256 \	//方向指定
				-exec {
					chara カメラ設定 ビヨンドカメラ \
						-c 0 \
						-b -32000,-32000,-32000 32000,32000,32000 \
						-l -32000,-32000,-32000 32000,32000,32000 \
						-r 714,512,0 \
						-f 4616 \
						-a 200 \
						-i 0 -1 0 0 \
						-s 1
				}
		//////////////
			trap by000_ca1 d:PLAYER \
				-mask ？ \
				-state 5 \
				-dir 0 256 \	//方向指定
				-exec {
					chara カメラ設定 ビヨンドカメラ \
						-c 0 \
						-b -32000,-32000,-32000 32000,32000,32000 \
						-l -32000,-32000,-32000 32000,32000,32000 \
						//-r 795,396,0 -f 5057 \
						-r 225,36,0 -f 2754 \
						-a 200 \
						-i 3 2 0 0 \
						-s $3 \
						-z d:CAMERA_NO_CUSHION
				}
			trap by000_ca2 d:PLAYER \
				-mask ？ \
				-state 5 \
				-dir 0 256 \	//方向指定
				-exec {
					chara カメラ設定 弱ビヨンドカメラ \
						-c 0 \
						-b -32000,-32000,-32000 32000,32000,32000 \
						-l -32000,-32000,-32000 32000,32000,32000 \
						-r 750,36,0 -f 2754 \
						-a 200 \
						-i 3 2 0 0 \
						-s $3 \
						-z d:CAMERA_NO_CUSHION
				}

		///////////////

			// B1右サイド
			trap by001 d:PLAYER \
				-mask いる \
				-button d:ACTION_BUTTON \
				-state 0,4 \	//立ち状態or張り付き
				-exec {
					@西向きビヨンド発動 $1 6000 $6 -21000 -9000 0x00000002
				}

			trap by001 d:PLAYER \
				-mask いる \
				-dir 3072 256 \
				-state 6 \
				-exec {
					chara カメラ設定 ビヨンドカメラ \
						-c 0 \
						-b -32000,-32000,-32000 32000,32000,32000 \
						-l -32000,-32000,-32000 32000,32000,32000 \
						//-r 587,1856,0 -f 4656 \
						-r 782,1376,0 -f 4092 \
						-a 200 \
						-i 0 -1 0 0 \
						-z d:CAMERA_NO_CUSHION \
						-s 1
				}
