							-c 0 \
							-b -32000,-32000,-32000 32000,-4000,32000 \
							-l -32000,-32000,6200 32000,32000,32000 \
							-r 768,2252,0 \
							-f 3544 \
							-a 200 \
							-i 0 -1 0 0 \
							-s 1
					}
				}
			trap by037 d:PLAYER \
				-mask ？ \
				-state 5 \
				-dir 2048 256 \	//方向指定
				-exec {
					if ($s:ビヨンドトラップ == by037) {
						chara カメラ設定 ビヨンドカメラ \
							-c 0 \
							-b -1500,-32000,-32000 -500,-4000,32000 \
							-l -32000,-32000,-32000 32000,32000,32000 \
							-r 603,2048,0 \
							-f 6000 \
							-a 200 \
							-i 3 2 0 0 \
							-s $3 \
							-z d:CAMERA_NO_CUSHION
					}
				}

			// 橋上
			trap by038 d:PLAYER \
				-mask いる \
				-button d:ACTION_BUTTON \
				-state 0,4 \	//立ち状態or張り付き
				-exec {
					@南向きビヨンド発動 $1 -15000 $4 -3750 -2500 0x00000002
					if ($? != 0) {
						eval($s:ビヨンドトラップ = $?);
					}
				}

			// 渡り橋 南壁
			#if d:TURN_ELUDE
				trap by033 d:PLAYER \
					-mask いる \
				#if d:CATCH_ACTION
					-key d:PAD_X \
				#endif
					-dir d:NORTH 1 \
					-state d:TRP_STATE_ELUDE_FALL \
					-exec {
						if( `@エルード落下キャッチ by038 $1 -13000 -2600 $5 $6 1024 0x00000002` ) {
							print '渡り橋 南壁  by038 by033'
							chara カメラ設定 エルードキャッチカメラ \
								-c 0 \
								-b -32000,-32000,-32000 32000,32000,32000 \
								-l -32000,-32000,-32000 32000,32000,32000 \
								-r 420,1967,0 -f 2845 \
								-a 200 \
								-i 1 2 0 0 \
								-z d:CAMERA_NO_CUSHION \
								-s 1

							chara delay エルードキャッチカメラディレイ -time 60 -exec {
								@カメラＯＦＦ エルードキャッチカメラ
							}

						}
					}
			#endif

			trap by038 d:PLAYER \
				-mask いる \
				-state 6 \
				-dir 0 256 \	//方向指定
				-exec {
					if ($s:ビヨンドトラップ  == by038) {
						chara カメラ設定 ビヨンドカメラ \
							-c 0 \
							-b -32000,-32000,-32000 32000,32000,32000 \
							-l -32000,-32000,-32000 32000,32000,32000 \
							-r 774,2264,0 \
							-f 6680 \
							-a 200 \
							-i 0 -1 0 0 \
							-s 1
					}
				}
			trap by038 d:PLAYER \
				-mask ？ \
				-state 5 \
				-dir 2048 256 \	//方向指定
				-exec {
					chara カメラ設定 ビヨンドカメラ \
						-c 0 \
						-b -3400,-32000,-32000 -2800,32000,32000 \
						-l -32000,-32000,-32000 32000,32000,32000 \
						-r 591,2048,0 \
						-f 6128 \
						-a 200 \
						-i 3 2 0 0 \
						-s $3 \
						-z d:CAMERA_NO_CUSHION
				}

			// 橋下
			trap by039 d:PLAYER \
				-mask いる \
				-button d:ACTION_BUTTON \
				-state 0,4 \	//立ち状態or張り付き
				-exec {
					@南向きビヨンド発動 $1 -18000 $4 -4000 -2500 0x00000002
					if ($? != 0) {
						eval($s:ビヨンドトラップ = $?);
					}
				}
			trap by039 d:PLAYER \
				-mask いる \
				-state 6 \
				-dir 0 256 \	//方向指定
				-exec {
					if ($s:ビヨンドトラップ == by039) {
						chara カメラ設定 ビヨンドカメラ \
							-c 0 \
							-b -32000,-32000,-32000 -4807,-9000,32000 \
							-l -32000,-32000,-17600 32000,32000,32000 \
							-r 714,1580,0 \
							-f 3992 \
							-a 200 \
							-i 0 -1 0 0 \
							-s 1
					}
				}
			trap by039 d:PLAYER \
				-mask ？ \
				-state 5 \
				-dir 2048 256 \	//方向指定
				-exec {
					chara カメラ設定 ビヨンドカメラ \
						-c 0 \
						-b -3200,-32000,-32000 32000,-9200,32000 \
						-l -32000,-32000,-32000 32000,32000,32000 \
						-r 447,2048,0 \
						-f 5584 \
