#define ENE_DEF_X_1		11000
#define ENE_DEF_Y_1		-5000
#define ENE_DEF_Z_1		-23250

#define ENE_DEF_X_2		12000
#define ENE_DEF_Y_2		-9000
#define ENE_DEF_Z_2		-2000

#define ENE_DEF_X_3		-500
#define ENE_DEF_Y_3		-9000
#define ENE_DEF_Z_3		5500

#define ENE_DEF_X_4		-11500
#define ENE_DEF_Y_4		-7000
#define ENE_DEF_Z_4		-7500

#define ENE_DEF_X_5		-9300
#define ENE_DEF_Y_5		-5000
#define ENE_DEF_Z_5		-18648

#define ENE_DEF_X_6		13000
#define ENE_DEF_Y_6		-5000
#define ENE_DEF_Z_6		-12000

#define ENE_DEF_X_7		-12500
#define ENE_DEF_Y_7		0
#define ENE_DEF_Z_7		-18750


	proc 警備兵Ａ $:名前 {
		chara 警備兵 $:名前 \
			-r 5 -n 0 \
			//-r 19 \ // ドアを開けたままにしておくデバッグ
			//-r 25 \
			-d d:ENE_DEF_X_1 d:ENE_DEF_Y_1 d:ENE_DEF_Z_1 右舷小部屋 \
			-s d:ENE_STATUS_GUNLIGHT \
			-i ($w:敵潜入視力-$w:敵兵調整値) ($w:敵危険視力-$w:敵兵調整値) ($w:敵回避視力-$w:敵兵調整値) \
			-l $w:敵標準体力 -f $w:敵標準気絶 -h ($w:敵標準聴力-$w:敵兵調整値) \
			-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
			-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
			-j ドッグタグ_敵兵	[ dogtag:tnk_w02a_guard_ve_01 ] \
								[ dogtag:tnk_w02a_guard_ea_01 ] \
								[ dogtag:tnk_w02a_guard_no_01 ] \
								[ dogtag:tnk_w02a_guard_ha_01 ] \
								[ dogtag:tnk_w02a_guard_vh_01 ]
	}

	proc 警備兵Ｂ $:名前 {
		chara 警備兵 $:名前 \
			-r 6 -n 0 \	// 初期ルートは落っこち兵の下
			-d d:ENE_DEF_X_2 d:ENE_DEF_Y_2 d:ENE_DEF_Z_2 エンジンルーム \
			-s d:ENE_STATUS_GUNLIGHT \
			-i	($w:敵潜入視力-$w:敵兵調整値) ($w:敵危険視力-$w:敵兵調整値) ($w:敵回避視力-$w:敵兵調整値) \
			-l $w:敵標準体力 -f $w:敵標準気絶 -h ($w:敵標準聴力-$w:敵兵調整値) \
			-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
			-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
			-j ドッグタグ_敵兵	[ dogtag:tnk_w02a_guard_ve_02 ] \
								[ dogtag:tnk_w02a_guard_ea_02 ] \
								[ dogtag:tnk_w02a_guard_no_02 ] \
								[ dogtag:tnk_w02a_guard_ha_02 ] \
								[ dogtag:tnk_w02a_guard_vh_02 ]
	}

	proc 落っこちぶつかり兵 $:名前 {	// 警備兵Ｂと同じ
		chara 警備兵 $:名前 \
			-r 21 -n 0 \	// 初期ルートは落っこち兵の下
			-d d:ENE_DEF_X_2 d:ENE_DEF_Y_2 d:ENE_DEF_Z_2 エンジンルーム \
			-s d:ENE_STATUS_GUNLIGHT \
			-i	($w:敵潜入視力-$w:敵兵調整値) ($w:敵危険視力-$w:敵兵調整値) ($w:敵回避視力-$w:敵兵調整値) \
			-l $w:敵標準体力 -f $w:敵標準気絶 -h ($w:敵標準聴力-$w:敵兵調整値) \
			-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
			-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
			-j ドッグタグ_敵兵	[ dogtag:tnk_w02a_guard_ve_02 ] \
								[ dogtag:tnk_w02a_guard_ea_02 ] \
								[ dogtag:tnk_w02a_guard_no_02 ] \
								[ dogtag:tnk_w02a_guard_ha_02 ] \
								[ dogtag:tnk_w02a_guard_vh_02 ]
	}

	proc 警備兵Ｃ $:名前 $:ルート {
		// 中央左B2 双眼鏡でポスター見る兵
		chara 警備兵 $:名前 \
			-r $:ルート -n 0 \
			-d d:ENE_DEF_X_3 d:ENE_DEF_Y_3 d:ENE_DEF_Z_3 エンジンルーム \
			-s d:ENE_STATUS_GUNLIGHT \
			-i ($w:敵潜入視力-$w:敵兵調整値) ($w:敵危険視力-$w:敵兵調整値) ($w:敵回避視力-$w:敵兵調整値) \
			-l $w:敵標準体力 -f $w:敵標準気絶 -h ($w:敵標準聴力-$w:敵兵調整値) \
			-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
			-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
			-j ドッグタグ_敵兵	[ dogtag:tnk_w02a_guard_ve_03 ] \
								[ dogtag:tnk_w02a_guard_ea_03 ] \
								[ dogtag:tnk_w02a_guard_no_03 ] \
								[ dogtag:tnk_w02a_guard_ha_03 ] \
								[ dogtag:tnk_w02a_guard_vh_03 ]
	}

	proc 警備兵Ｄ $:名前 {
		// 左舷Ｂ１ 上で見張ってる兵
		chara 警備兵 $:名前 \
			-r 22 -n 0 \
			-d d:ENE_DEF_X_4 d:ENE_DEF_Y_4 d:ENE_DEF_Z_4 エンジンルーム \
			-s d:ENE_STATUS_GUNLIGHT \
			-i	($w:敵潜入視力-$w:敵兵調整値) ($w:敵危険視力-$w:敵兵調整値) ($w:敵回避視力-$w:敵兵調整値) \
