	// ステージカメラ設定
	// ------------------------------------
	proc カメラセット {
		#if d:STAGE_CAMERA
			chara カメラ ステージカメラ			-c 0 -l 3 -p 0

			chara カメラ シナリオカメラ			-c 0 -l 1 -p 10

			chara カメラ 通路カメラ１			-c 0 -l 2 -p 50
			chara カメラ 通路カメラ０			-c 0 -l 2 -p 45
			chara カメラ 小部屋カメラ			-c 0 -l 2 -p 40
			chara カメラ 階段カメラ				-c 0 -l 2 -p 30
			chara カメラ 階段カメラ２			-c 0 -l 2 -p 31
			chara カメラ ビハインド用カメラ		-c 0 -l 2 -p 25
			chara カメラ モーションカメラ		-c 0 -l 2 -p 20
			chara カメラ 強ビヨンドカメラ		-c 0 -l 2 -p 14
			chara カメラ ビヨンドカメラ			-c 0 -l 2 -p 15
			chara カメラ 弱ビヨンドカメラ		-c 0 -l 2 -p 16
			chara カメラ エルードキャッチカメラ	-c 0 -l 0 -p 50
			chara カメラ ロードカメラ１			-c 0 -l 2 -p 5
			chara カメラ ロードカメラ０			-c 0 -l 2 -p 0
			chara カメラ クリアリングカメラ		-c 1 -l 2 -p 0

			// デフォルトカメラ
			chara カメラ設定 ステージカメラ \
				-c 0 \
				-b -15000,-32000,-13000 15000,32000,11500 \
				-l -32000,-32000,-32000 32000,32000,32000 \
				-r 375,2048,0 \
				-f 6000 \
				-a 200 \
				-i 2 2 0 0 \
				-s 1
		#endif
	}

	// スポットライト管理
	// ------------------------------------
	proc スポットライト管理 {
		#if d:SPOT_LIGHT
			trap ev010_2 d:PLAYER \
				-mask 入る \
				-exec {
					mesg 静止スポットライト設置 右舷B1ライト off
					mesg 静止スポットライト設置 右舷B2ライト off
					mesg 静止スポットライト設置 右舷B3ライト off
					mesg 静止スポットライト設置 左舷B2階段ライト on
					mesg 静止スポットライト設置 左舷B2ライト on
					mesg 静止スポットライト設置 左舷B1ライト on
				}

			trap ev010 d:PLAYER \
				-mask 入る \
				-exec {
					mesg 静止スポットライト設置 右舷B1ライト on
					mesg 静止スポットライト設置 右舷B2ライト on
					mesg 静止スポットライト設置 右舷B3ライト off
					mesg 静止スポットライト設置 左舷B2階段ライト on
					mesg 静止スポットライト設置 左舷B2ライト on
					mesg 静止スポットライト設置 左舷B1ライト on
				}

			trap ev011 d:PLAYER \
				-mask 入る \
				-exec {
					mesg 静止スポットライト設置 右舷B1ライト on
					mesg 静止スポットライト設置 右舷B2ライト on
					mesg 静止スポットライト設置 右舷B3ライト on
					mesg 静止スポットライト設置 左舷B2階段ライト off
					mesg 静止スポットライト設置 左舷B2ライト off
					mesg 静止スポットライト設置 左舷B1ライト on
				}

			trap ev012 d:PLAYER \
				-mask 入る \
				-exec {
					mesg 静止スポットライト設置 右舷B1ライト on
					mesg 静止スポットライト設置 右舷B2ライト on
					mesg 静止スポットライト設置 右舷B3ライト on
					mesg 静止スポットライト設置 左舷B2階段ライト off
					mesg 静止スポットライト設置 左舷B2ライト off
					mesg 静止スポットライト設置 左舷B1ライト on
				}

			trap ev013 d:PLAYER \
				-mask 入る \
				-exec {
					mesg 静止スポットライト設置 右舷B1ライト off
					mesg 静止スポットライト設置 右舷B2ライト off
					mesg 静止スポットライト設置 右舷B3ライト on
					mesg 静止スポットライト設置 左舷B2階段ライト off
					mesg 静止スポットライト設置 左舷B2ライト off
					mesg 静止スポットライト設置 左舷B1ライト on
				}

			trap ev014 d:PLAYER \
				-mask 入る \
				-exec {
					mesg 静止スポットライト設置 右舷B1ライト on
					mesg 静止スポットライト設置 右舷B2ライト on
					mesg 静止スポットライト設置 右舷B3ライト on
					mesg 静止スポットライト設置 左舷B2階段ライト off
					mesg 静止スポットライト設置 左舷B2ライト off
					mesg 静止スポットライト設置 左舷B1ライト on
				}

			trap ev015 d:PLAYER \
				-mask 入る \
				-exec {
					mesg 静止スポットライト設置 右舷B1ライト on
					mesg 静止スポットライト設置 右舷B2ライト on
					mesg 静止スポットライト設置 右舷B3ライト on
					mesg 静止スポットライト設置 左舷B2階段ライト off
					mesg 静止スポットライト設置 左舷B2ライト off
					mesg 静止スポットライト設置 左舷B1ライト on
				}

			trap ev016 d:PLAYER \
				-mask 入る \
				-exec {
					mesg 静止スポットライト設置 右舷B1ライト on
					mesg 静止スポットライト設置 右舷B2ライト off
					mesg 静止スポットライト設置 右舷B3ライト off
					mesg 静止スポットライト設置 左舷B2階段ライト on
					mesg 静止スポットライト設置 左舷B2ライト on
					mesg 静止スポットライト設置 左舷B1ライト off
				}

			trap ev017 d:PLAYER \
				-mask 入る \
				-exec {
					mesg 静止スポットライト設置 右舷B1ライト on
					mesg 静止スポットライト設置 右舷B2ライト off
					mesg 静止スポットライト設置 右舷B3ライト off
					mesg 静止スポットライト設置 左舷B2階段ライト on
					mesg 静止スポットライト設置 左舷B2ライト on
					mesg 静止スポットライト設置 左舷B1ライト on
				}

			trap ev018 d:PLAYER \
				-mask 入る \
				-exec {
					mesg 静止スポットライト設置 右舷B1ライト on
					mesg 静止スポットライト設置 右舷B2ライト on
					mesg 静止スポットライト設置 右舷B3ライト off
					mesg 静止スポットライト設置 左舷B2階段ライト on
					mesg 静止スポットライト設置 左舷B2ライト on
					mesg 静止スポットライト設置 左舷B1ライト on
				}
		#endif
	}


