	proc エルード落下死亡カメラ {
		trap drop_dead d:PLAYER \
			-mask 入る \
			-camera \
			-exec {
			print '***********************死んだんだよ*******************************'
			print 'X'$i:プレイヤー位置Ｘ
			print 'Y'$i:プレイヤー位置Ｙ
			print 'Z'$i:プレイヤー位置Ｚ
				chara カメラ設定 エルードキャッチカメラ \
					-c 1 \
					-p $i:カメラＸ位置 $i:カメラＹ位置 $i:カメラＺ位置 \
					-t $i:注視点Ｘ位置 $i:注視点Ｙ位置 $i:注視点Ｚ位置 \
					-a 200 \
					-i 1 1 0 0 \
					-s 1 \
			}
	}

	proc 落下死亡プロック {
		trap dead_voice d:PLAYER \
			-mask 入る \
			-exec {
				print '***********************「うぎゃー」*******************************'
				command ＳＥセットモード -s d:SD_V_PFALL01 \
					-p $i:プレイヤー位置Ｘ,$i:プレイヤー位置Ｙ,$i:プレイヤー位置Ｚ \
					-m 1
			}

		trap dead d:PLAYER \
			-mask 入る \
			-exec {
				print '***********************落下で死亡しました*******************************'
				@ミッション共通ゲームオーバー処理
			}
	}





#if d:RAVEN
/***************************************************************************************************/
// レイブンイベント
/***************************************************************************************************/
	proc レイブンイベント {
		// イベント発動用トラップ
		trap raven d:PLAYER \
			-mask 入る \
			-exec {
				if( $6 > -16000 ) {
					if( $f:w02a_レイブンイベントフラグ == 0 ){
						if( `@シナリオデモ用安全チェック` && !`@レイブン用位置チェック全員` ) {
							@レイブンイベントスタート
						} else {
							// 一回駄目だった場合、レイブンイベントはもう起らない
							print '******************************************************'
							print '************** レイブンイベント失敗 ******************'
							print '******************************************************'
							eval( $f:w02a_レイブンイベントフラグ = 1 )
							#if d:VAR_SAVE
								command varsave $f:w02a_レイブンイベントフラグ
							#endif
						}
					}
				}
			}
	}

	proc レイブンイベント敵兵座標チェック $:名前 {
		eval( $i:ローカル変数Ｉ１ = `command ゲット敵兵座標 $:名前 $i:Ｘ座標変数 $i:Ｙ座標変数 $i:Ｚ座標変数` )
		if( $i:ローカル変数Ｉ１ == 1 ) {
			if( ($i:Ｘ座標変数 > 8000) && ($i:Ｚ座標変数 < -10000) ) {
				print '俺アウト'$:名前
				print '$i:Ｘ座標変数'$i:Ｘ座標変数
				print '$i:Ｙ座標変数'$i:Ｙ座標変数
				print '$i:Ｚ座標変数'$i:Ｚ座標変数
				return 1;
			} else {
				print '俺セーフ'$:名前
				return 0;
			}
		} else {
			print 'そんな兵士はいません'
			return 0;
		}
	}

	proc レイブン用位置チェック全員 {
		if( `@レイブンイベント敵兵座標チェック 敵兵:01` | \
			`@レイブンイベント敵兵座標チェック 敵兵:02` | \
			`@レイブンイベント敵兵座標チェック 敵兵:03` | \
			`@レイブンイベント敵兵座標チェック 敵兵:04` | \
			`@レイブンイベント敵兵座標チェック 敵兵:05` | \
			`@レイブンイベント敵兵座標チェック 敵兵:06` | \
			`@レイブンイベント敵兵座標チェック 敵兵:61` | \
			`@レイブンイベント敵兵座標チェック 敵兵:62` | \
			`@レイブンイベント敵兵座標チェック 敵兵:63` | \
			`@レイブンイベント敵兵座標チェック 敵兵:64` ) {
			print '!!!!! 小部屋内に敵兵がいます!!!!!'
			return 1;
		} else {
			print '小部屋内に敵兵はいません'
			return 0;
		}
	}

	// スタートプロック
	proc レイブンイベントスタート {

		@シナリオデモ開始処理

		// カメラの設定
		chara カメラ設定 シナリオカメラ \
			-c 1 \
			-p 8549,-4381,-16883 -t 9467,-4155,-18646 \
			-r -74,1735,0 -f 2000 \
			-a 200 \
			-i 0 2 0 0 \
			-s 1

		chara delay レイブンディレイ -time 40 -exec {
			chara カメラ設定 シナリオカメラ \
				-c 1 \
				-p 9345,-3150,-16101 -t 9805,-3511,-19105 \
				-r 77,1949,0 -f 3061 \
				-a 200 \
				-i 0 2 0 0 \
				-z d:CAMERA_INTERP_CAMERA \
				-interp_time 350 \
				-s 1

			chara delay レイブンディレイ -time 150 -exec {
				eval( $i:STREAM_ID = `command Stream t:vc060301 ` );
			}
		}

		// 装備品によって呼び出すモーションを変える
		if( $w:武器 == d:武器:素手 ) {
			eval( $w:モーション番号 = d:モーションリスト:t07a1sna001a_sgl )
		}else if( ($w:武器 == d:武器:ＵＳＰ) || ($w:武器 == d:武器:Ｍ９) ) {
			eval( $w:モーション番号 = d:モーションリスト:t07a1sna002a_sgl )
		}else{
			eval( $w:モーション番号 = d:モーションリスト:t07a1sna001a_sgl )
		}

		// イベント発動
		mesg プレイヤー d:PLAYER motion $w:モーション番号 \
			2048 -1 0 ( 0x00000004 | 0x00000400 ) \
			9800 -17000

		// 終了プロック登録
		command	強制モーション終了プロック \
			-motion $w:モーション番号 \
			-proc レイブンイベント終了プロック

		// キャンセルプロック登録
		chara デモキャンセルチェック デモキャンセル \
			-p レイブンデモキャンセル
	}

	// 終了プロック
	proc レイブンイベント終了プロック {
	print 'レイブンイベント終了'

		eval( $f:w02a_レイブンイベントフラグ = 1 )
		#if d:VAR_SAVE
			command varsave $f:w02a_レイブンイベントフラグ
		#endif

		mesg デモキャンセルチェック デモキャンセル kill
		mesg delay レイブンディレイ kill
		@カメラＯＦＦ シナリオカメラ
		//@カメラＯＦＦ パンカメラ

		@シナリオデモ終了処理
	}

	// キャンセルプロック
	proc レイブンデモキャンセル {
	print 'レイブンイベントキャンセル'
		command 強制モーションキャンセル
		command StreamStop $i:STREAM_ID
	}
#endif

/***************************************************************************************************/
// ドア修理イベント
/***************************************************************************************************/
#if d:REPAIR
	proc ドア修理イベント設定 {
		// パッドデモを用意する
		chara パッドデモ 修理デモ \
			-file w02a_paddemo

		// ドアを開かないようにしておく
		if( $f:w02a_ドア修理イベント == 0 ){
			command トラップ切り替え -trap dr004 -switch 0
		}

		trap repair:01 d:PLAYER \
			-mask 入る \
			-exec {
				if( $f:w02a_ドア修理イベント == 0 ){
					if( `@シナリオデモ用安全チェック` && !`@修理兵用位置チェック全員`) {
						@ドア修理イベントスタート
					}
				}
			}
	}

	proc ドア修理イベントスタート {
		print '**********ドア修理イベントスタート**********'

		eval( $f:w02a_ドア修理イベント中 = 1 )

		@シナリオデモ開始処理

		eval( $f:w02a_ドア修理イベント = 1 )
		#if d:VAR_SAVE
			command varsave $f:w02a_ドア修理イベント
		#endif

		chara delay イベントディレイ -time 60 -exec {
			chara カメラ設定 シナリオカメラ \
				-c 1 \
				-p $i:カメラＸ位置,$i:カメラＹ位置,$i:カメラＺ位置 \
				-t $i:注視点Ｘ位置,$i:注視点Ｙ位置,$i:注視点Ｚ位置 \
				-r 160,2224,0 -f 1000 \
				-a 200 \
				-i 0 0 0 0 \
				-s 1

			chara カメラ設定 シナリオカメラ \
				-c 1 \
				-p -9290,-3176,-9978 -t -9548,-3419,-10913 \
				-r 160,2224,0 -f 1000 \
				-a 200 \
				-i 0 0 0 0 \
				-z d:CAMERA_INTERP_CAMERA \
				-interp_time 30 \
				-s 1

			// ドアが開くようにする
			command トラップ切り替え -trap dr004 -switch 1

			// ドア修理兵スタート
			mesg 敵兵共通 ドア修理兵 永久アンリアルＯＦＦ
			mesg 警備兵 ドア修理兵 ルート変更 /*37*/43 -12500,0,-18750 左舷居住区Ｂ１

			// 強制移動
			chara delay イベントディレイ -time 60 -exec {
				mesg プレイヤー d:PLAYER run -11000 -5000 -20750 \
					1 \ // 走り移動
					3072 \
					0 \ // フラグ(FA_NO_WEAPON)
					修理中スネーク移動完了
			}

			// キャンセル時の処理
			chara デモキャンセルチェック デモキャンセル \
				-p 修理デモキャンセル


				// ディレイのキャンセルもセットしておく
				chara delay 修理デモ終了ディレイ -time 800 -exec {
					print '修理デモ終了ディレイで終了しました'
					@修理デモキャンセル
				}

			// コールバック登録
			command システムコールバック -start_alert_mode 修理イベント中発見されました

			// 異常なルートに行ってないか監視
			chara プロック連続実行 ドア修理兵異常ルート検査 -time -1 -exec {
				if( `command ゲット敵兵思考ステータス ドア修理兵 $i:ローカル変数Ｉ１` != -1 ) {
					command ゲットゲームステータス $i:ゲームステータス
					if( !($i:ローカル変数Ｉ１ & (d:THK_STATUS_ROOT_MOVE | d:THK_STATUS_ROOT_TRACE | d:THK_STATUS_ROOT_ACTION)) || \
						( $i:ゲームステータス & d:STATE_DETECT ) || \
						( $w:アラートモード != d:ALERT_MODE_SENNYU ) ) {
						print '************異常発生***************'
						@修理デモキャンセル
						eval( $f:w02a_ドア修理イベント中 = 0 )
						mesg 警備兵 ドア修理兵 ルート変更 38 -12500,0,-18750 左舷居住区Ｂ１
						mesg プロック連続実行 ドア修理兵異常ルート検査 kill
					}
				}
			}
		}
	}

	proc 修理イベント中発見されました {
		if( $f:w02a_ドア修理イベント中 == 1 ) {
			print '**********修理イベント中発見されました**********'
			@修理デモキャンセル
			eval( $f:w02a_ドア修理イベント中 = 0 )
			mesg 警備兵 ドア修理兵 ルート変更 38 -12500,0,-18750 左舷居住区Ｂ１
		}
	}

	proc 修理デモキャンセル {
		print '**********修理デモキャンセル**********'
		mesg delay 修理デモ終了ディレイ kill
		mesg delay イベントディレイ kill
		mesg パッドデモ 修理デモ kill
		//mesg プロック連続実行 修理危険チェック kill
		//mesg プロック連続実行 ドア修理兵無線終了チェック kill
		@修理デモ終了
	}

	proc 修理デモ終了 {
		print '**********修理デモ終了**********'
		@カメラＯＦＦ シナリオカメラ
		@カメラＯＦＦ パンカメラ
		@シナリオデモ終了処理
	}

	proc 修理中スネーク移動完了 {
		print '**********修理中スネーク移動完了**********'
		mesg パッドデモ 修理デモ start
	}

	proc 修理イベント敵兵座標チェック $:名前 {
		eval( $i:ローカル変数Ｉ１ = `command ゲット敵兵座標 $:名前 $i:Ｘ座標変数 $i:Ｙ座標変数 $i:Ｚ座標変数` )
		if( $i:ローカル変数Ｉ１ == 1 ) {
			if( ($i:Ｘ座標変数 < -8000) && ($i:Ｚ座標変数 < -10000) ) {
				print '俺アウト'$:名前
				print '$i:Ｘ座標変数'$i:Ｘ座標変数
				print '$i:Ｙ座標変数'$i:Ｙ座標変数
				print '$i:Ｚ座標変数'$i:Ｚ座標変数
				return 1;
			} else {
				print '俺セーフ'$:名前
				return 0;
			}
		} else {
			print 'そんな兵士はいません'
			return 0;
		}
	}

	proc 修理兵用位置チェック全員 {
		if( `@修理イベント敵兵座標チェック 敵兵:01` | \
			`@修理イベント敵兵座標チェック 敵兵:02` | \
			`@修理イベント敵兵座標チェック 敵兵:03` | \
			`@修理イベント敵兵座標チェック 敵兵:04` | \
			`@修理イベント敵兵座標チェック 敵兵:05` | \
			`@修理イベント敵兵座標チェック 敵兵:06` | \
			`@修理イベント敵兵座標チェック 敵兵:61` | \
			`@修理イベント敵兵座標チェック 敵兵:62` | \
			`@修理イベント敵兵座標チェック 敵兵:63` | \
			`@修理イベント敵兵座標チェック 敵兵:64` ) {
			print '!!!!! 小部屋内に敵兵がいます!!!!!'
			return 1;
		} else {
			print '小部屋内に敵兵はいません'
			return 0;
		}
	}


#endif


/***************************************************************************************************/
// 左舷のポイントでセーブする
/***************************************************************************************************/
	proc 左舷セーブ {
		trap left_save d:PLAYER \
			-mask 入る \
			-exec {

				if( $f:w02a_左舷セーブフラグ == 0 ) {
					print '左舷小部屋セーブ'
					eval( $i:プレイヤー初期Ｘ位置 = -9368 ) ;
					eval( $i:プレイヤー初期Ｙ位置 = -4000 ) ;
					eval( $i:プレイヤー初期Ｚ位置 = -14500 ) ;
					eval( $i:プレイヤー初期方向 = 2048 ) ;
					eval( $s:登場ポイント = 左舷小部屋ロードポイント )
					eval( $f:w02a_左舷セーブフラグ = 1 )
					command varsave
				}
			}
	}

/***************************************************************************************************/
// 棒テスト
/***************************************************************************************************/

	proc 棒テスト {
		chara プットオブジェ 空中鉄棒Ａ \
			-m w04_test_bou \
			-l w02a \
			-r 1024 1024 0 \
			-s 1200 15 15 \
			-f ( d:PUT_OBJ_THERMAL | d:PUT_OBJ_CALC_LIGHT ) \
			-p -6000 (-5000-60) (-20000-80)

		chara プットオブジェ 空中鉄棒Ｂ \
			-m w04_test_bou \
			-l w02a \
			-r 1024 0 0 \
			-s 15 15 400 \
			-f ( d:PUT_OBJ_THERMAL | d:PUT_OBJ_CALC_LIGHT ) \
			-p 2500 -10000 -23000

		// エルードキャッチ
		trap by_Engine_L d:PLAYER \
			-mask いる \
		#if d:CATCH_ACTION
			-key d:PAD_X \
		#endif
			-dir d:SOUTH 1 \
			-state d:TRP_STATE_ELUDE_FALL \
			-exec {
				@エルード落下キャッチ by000 $1 /*-10000*/-9900 2500 $5 $6 d:EAST 0x00000002
			}

		trap by_Engine_R d:PLAYER \
			-mask いる \
		#if d:CATCH_ACTION
			-key d:PAD_X \
		#endif
			-dir d:SOUTH 1 \
			-state d:TRP_STATE_ELUDE_FALL \
			-exec {
				@エルード落下キャッチ by000 $1 /*-10000*/-9900 2500 $5 $6 d:WEST 0x00000002
			}

		trap by028 d:PLAYER \
			-mask いる \
		#if d:CATCH_ACTION
			-key d:PAD_X \
		#endif
			-state d:TRP_STATE_ELUDE_FALL \
			-exec {
				print $s:エルード落下トラップ
				if( $s:エルード落下トラップ == by_Engine_R ) {
					@エルード落下キャッチ by_Engine_R $1 -14000 $4 $5 -19050 d:SOUTH 0x00000002
				} else {
					@エルード落下キャッチ by_Engine_L $1 -14000 $4 $5 -19050 d:SOUTH 0x00000002
				}
			}

		// エルード中カメラ
		trap by_Engine_L d:PLAYER \
			-mask ? \
			-state d:TRP_STATE_ELUDE \
			-exec {
				chara カメラ設定 ビヨンドカメラ \
					-c 0 \
					-b -1753,-7542,-20683 -1753,-7529,-22216 \
					-l -32000,-32000,-32000 32000,32000,32000 \
					-r 420,1057,0 -f 5013 \
					-a 200 \
					-i 3 2 0 0 \
					-s $3 \
					-z d:CAMERA_NO_CUSHION
			}

		trap by_Engine_R d:PLAYER \
			-mask ? \
			-state d:TRP_STATE_ELUDE \
			-exec {
				chara カメラ設定 ビヨンドカメラ \
					-c 0 \
					-b 6428,-8714,-22109 6428,-8593,-20449 \
					-l -32000,-32000,-32000 32000,32000,32000 \
					-r 300,3128,0 -f 4120 \
					-a 200 \
					-i 3 2 0 0 \
					-s $3 \
					-z d:CAMERA_NO_CUSHION
			}
	}

	proc 右舷透明壁設置 {
		chara 透明壁 覗きこみ禁止壁１ \
			-position	10600,-5000,-12000,2000 \
						10600,-5000,-10500,2000 \
			-attribute	( d:HZX_SEG_ATR_ALL & ~(d:HZX_SEG_NO_PLAYER ))

		mesg 透明壁 覗きこみ禁止壁１ off

		trap dr001 d:PLAYER -mask ？ \
			-state d:TRP_STATE_SUBJECT \
			-exec {
				if($3 == 入る) {
					mesg 透明壁 覗きこみ禁止壁１ on
				} else if($3 == 出る) {
					mesg 透明壁 覗きこみ禁止壁１ off
				}
			}
	}

	proc 左舷透明壁設置 {
		chara 透明壁 覗きこみ禁止壁４ \
			-position	-10600,-5000,-12000,2000 \
						-10600,-5000,-10500,2000 \
			-attribute	( d:HZX_SEG_ATR_ALL & ~(d:HZX_SEG_NO_PLAYER ))

		mesg 透明壁 覗きこみ禁止壁４ off

		trap dr004 d:PLAYER -mask ？ \
			-state d:TRP_STATE_SUBJECT \
			-exec {
				if($3 == 入る) {
					mesg 透明壁 覗きこみ禁止壁４ on
				} else if($3 == 出る) {
					mesg 透明壁 覗きこみ禁止壁４ off
				}
			}
	}



