// デバッグ関係

#ifdef d:FIX_MODE
	#define MY_DEBUG		0		// デバッグ
	#define ASSERT			0		// Assert関数使用
#else
	#define MY_DEBUG		0		// デバッグ
	#define ASSERT			1		// Assert関数使用
#endif

#define CATCH_ACTION		1	// アクションボタンを押した場合のみキャッチ

#define VAR_SAVE			1	// 変数セーブ
#define TURN_ELUDE			1	// 反対側エルード
#define LEFT_SAVE			0	// 左舷セーブポイントでセーブ

#define STAGE_TANKER		1	// モード共通 プロック切り分け用
#define STAGE_W02A			1	// ステージ名 共通プロック切り分け用
#define STAGE_ALT			1	// オールタナティブステージ切り分け用

#define PLAYER				スネーク

// 薬莢
#define ENE_T_GOL			1	// タンカー編ゴル兵
#define	ENE_SHOT			1	// ショットガン兵
#define	ENE_SHIELD 			1	// 盾兵


// プラグイン
#define STAGE_END			1	// ステージ終了プロック
#define PAN_CAMERA			1	// パンカメラ使用
#define IN_RAIL_HZD 		1	// エルード位置補正


// エフェクト関係
#define		BLUR			0
#define		FOCUS			0
#define		BODY_SHADOW		0
// 子画面
#define		SUB_CAMERA		1
// カメラ関係
