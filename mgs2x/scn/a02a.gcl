/***************************************************************************************************/
// ドア
/***************************************************************************************************/
	proc ドア設置 {

#define DOOR_MODEL_R_00		d:DOOR_NAME1
#define DOOR_MODEL_R_99		d:DOOR_NAME1
#define DOOR_MODEL_L_00		d:DOOR_NAME2
#define DOOR_MODEL_L_99		d:DOOR_NAME2


		// ドア １

			@ドアモデル名セット 0	d:DR_NAME_R1 d:DR_NAME_R2 \
									d:DR_NAME_R3 d:DR_NAME_R4 d:DR_NAME_R5

			chara ドア 右舷ドア外側 \
				-m $$s:ドアモデル名[0] \
				-d 0,d:WEST,0 \
				-p 10600,-5000,-12000 \
				-slide -2000 \
				-between 右舷居住区Ｂ１ 右舷小部屋 \
				-time d:SD_OPEN_TIME \
				-exec {
					if( $:開閉フラグ == 0 ){
						mesg マップ接合 右居住区／右小部屋 off
					} else {
						mesg マップ接合 右居住区／右小部屋 on
					}
				}
			trap dr001 ？ \
				-mask ？ \
				-exec {
					if($3==入る){
						mesg ドア 右舷ドア外側 open $2
					}else{
						mesg ドア 右舷ドア外側 close $2
					}
				}

			/*
			// 敵兵のみを通す透明壁等の設定
			@A_ドア開閉追加設定 右舷ドア外側 $$b:ドアフラグ[0] \
							10600 -5000 -12000 d:WEST -2000
			*/
/*
			chara 透明壁 覗きこみ禁止壁１ \
				-position	10600,-5000,-12000,2000 \
							10600,-5000,-10500,2000 \
				-attribute	( d:HZX_SEG_ATR_ALL & ~(d:HZX_SEG_NO_PLAYER ))

			mesg 透明壁 覗きこみ禁止壁１ off

			trap dr001 d:PLAYER -mask ？ \
				-state d:TRP_STATE_SUBJECT \
				-exec {
					if($3 == 入る) {
						mesg 透明壁 覗きこみ禁止壁１ on
					} else if($3 == 出る) {
						mesg 透明壁 覗きこみ禁止壁１ off
					}
				}
*/
		// ドア ２
			chara ドア 右舷ドア内側 \
				-m d:DOOR_NAME1 \
				-d 0,3072,0 \
				-p 8250,-5000,-19750 \
				-slide -2000 \
				-between エンジンルーム 右舷小部屋 \
				-time d:SD_OPEN_TIME \
				-exec {
					if( $:開閉フラグ == 0 ){
						mesg マップ接合 エンジン／右小部屋 off
					} else {
						mesg マップ接合 エンジン／右小部屋 on
					}
				}
			trap dr002 ？ \
				-mask ？ \
				-exec {
					if($3==入る){
						mesg ドア 右舷ドア内側 open $2
					}else{
						mesg ドア 右舷ドア内側 close $2
					}
				}

		// ドア ３
			chara ドア 左舷ドア内側 \
				-m d:DOOR_NAME2 \
				-d 0,3072,0 \
				-p -8250,-5000,-15750 \
				-slide -2000 \
				-between 左舷小部屋 エンジンルーム \
				-time d:SD_OPEN_TIME \
				-exec {
					if( $:開閉フラグ == 0 ){
						mesg マップ接合 エンジン／左小部屋 off
					} else {
						mesg マップ接合 エンジン／左小部屋 on
					}
				}

			trap dr003 ？ \
				-mask ？ \
				-exec {
					if($3==入る){
						mesg ドア 左舷ドア内側 open $2
					}else{
						mesg ドア 左舷ドア内側 close $2
					}
				}

		// ドア ４

			@ドアモデル名セット 1	d:DR_NAME_L1 d:DR_NAME_L2 \
									d:DR_NAME_L3 d:DR_NAME_L4 d:DR_NAME_L5

			chara ドア 左舷ドア外側 \
				-m $$s:ドアモデル名[1] \
				-d 0,3072,0 \
				-p -10600,-5000,-12000 \
				-slide -2000 \
				-between 左舷小部屋 左舷居住区Ｂ１ \
				-time d:SD_OPEN_TIME \
				-exec {
					if( $:開閉フラグ == 0 ){
						mesg マップ接合 左居住区／左小部屋 off
					} else {
						mesg マップ接合 左居住区／左小部屋 on
					}
				}

			trap dr004 ？ \
				-mask ？ \
				-exec {
					if($3==入る){
						mesg ドア 左舷ドア外側 open $2
					}else{
						mesg ドア 左舷ドア外側 close $2
					}
				}

			/*
			// 敵兵のみを通す透明壁等の設定
			@A_ドア開閉追加設定 左舷ドア外側 $$b:ドアフラグ[1] \
								-10600 -5000 -12000 3072 -2000
			*/
/*
			chara 透明壁 覗きこみ禁止壁４ \
				-position	-10600,-5000,-12000,2000 \
							-10600,-5000,-10500,2000 \
				-attribute	( d:HZX_SEG_ATR_ALL & ~(d:HZX_SEG_NO_PLAYER ))

			mesg 透明壁 覗きこみ禁止壁４ off

			trap dr004 d:PLAYER -mask ？ \
				-state d:TRP_STATE_SUBJECT \
				-exec {
					if($3 == 入る) {
						mesg 透明壁 覗きこみ禁止壁４ on
					} else if($3 == 出る) {
						mesg 透明壁 覗きこみ禁止壁４ off
					}
				}
*/

/*
			chara ドア 左舷ドア北側 \
				-m d:DOOR_NAME1 \
				-d 0,0,0 \
				-p -17500,-5000,-32250 \
				-slide -2000 \
				-time d:SD_OPEN_TIME \
			trap dr005 d:PLAYER \
				-mask ？ \
				-exec {
						if($3==入る){
							mesg ドア 左舷ドア北側 open $2
						}else{
							mesg ドア 左舷ドア北側 close $2
						}
				}
*/

	}

	proc 敵兵のみを通す壁＿右舷 {
		// 敵兵のみを通す透明壁等の設定
		@A_ドア開閉追加設定 右舷ドア外側 $$b:ドアフラグ[0] \
						10600 -5000 -12000 d:EAST -2000		// なぜかドアと180度違う
	}
	proc 敵兵のみを通す壁＿右舷内側ドア {
			// 敵兵排除では内側のドアも封鎖してしまう
			@A_ドア開閉追加設定 右舷ドア内側 2/*d:DOOR_FLAG_ENEMY_ONLY*/ \
							8250 -5000 -19750 d:EAST -2000		// なぜかドアと180度違う
	}
	proc 敵兵のみを通す壁＿左舷 {
		// 敵兵のみを通す透明壁等の設定
		@A_ドア開閉追加設定 左舷ドア外側 $$b:ドアフラグ[1] \
						-10600 -5000 -12000 d:EAST -2000
	}
	proc 敵兵のみを通す壁＿左舷内側ドア {
			// 敵兵排除では内側のドアも封鎖してしまう
		@A_ドア開閉追加設定 左舷ドア内側 2/*d:DOOR_FLAG_ENEMY_ONLY*/ \
						-8250 -5000 -15750 d:EAST -2000
	}

#define DOOR_MODEL_WD_00	w02a3sdr_body
#define DOOR_MODEL_WD_99	w02a3sdr_body



	proc 水密ドア設置 {
			if( `@スネーク達` ) {
				eval( $s:ローカル変数Ｓ１ = sna_hatch )
			} else {
				eval( $s:ローカル変数Ｓ１ = rai_wt_hatch )
			}
			chara 水密ドア管理 ドア管理人 -n 1 \
					-seno 3 \
					-motions $s:ローカル変数Ｓ１ hatch_door_sna hatch_handle_sna
					//-adjusts 	0 0 \		// 左軸ドア引き時
					//			-10 25 \	// 左軸ドア押し時
					//			0 0 \		// 右軸ドア引き時
					//			0 0 		// 右軸ドア押し時


			if( $$b:ドアフラグ[2] == d:DOOR_FLAG_OPEN ) {
				// ゲーム開始時に開いているかチェック
				if( $s:登場ポイント == エンジンルーム左舷から ) {
					eval( $i:ローカル変数Ｉ１ = d:WT_DOOR_FLAG_OPEN_START )
				} else {
					eval( $i:ローカル変数Ｉ１ = d:WT_DOOR_FLAG_NORMAL )
				}
			} else {
				eval( $i:ローカル変数Ｉ１ = d:WT_DOOR_FLAG_NOT_OPEN )
			}

			@ドアモデル名セット 2	d:DR_NAME_WT1 d:DR_NAME_WT2 \
									d:DR_NAME_WT3 d:DR_NAME_WT4 d:DR_NAME_WT5

			chara 水密ドア 水密君 \
				-kms $$s:ドアモデル名[2] w02a3sdr_handle \
				-position -17325,-5000,-32350 \		/* 座標がずれている可能性あり 要注意 */
				-rotate 0,0,0 \
				-type 1 \
				-flag $i:ローカル変数Ｉ１ \
				-proc 長廊下へロード

			trap wdr005 d:PLAYER \
				-mask いる \
				-button d:ACTION_BUTTON \
				-state 0 \
				-exec {
					command 水密ドア状態 -n 水密君
					mesg プレイヤー d:PLAYER wt_door 水密君 $status 2048,512 -17325,-32335
				}

			// ハンドル回し中のカメラ
			trap wdr005 d:PLAYER \
				-mask ？ \
				-state 6 \
				-exec {
					chara カメラ設定 モーションカメラ \
						-c 1 \
						-p -16261,-1339,-30543 -t -16969,-3728,-31980 \
						-r 639,2346,0 \
						-f 2877 \
						-a 200 \
						-i 0 3 0 0 \
						-s $3
				}

			// ステージ開始時・終了時のカメラ
			trap wdr005 d:PLAYER \
				-mask ？ \
				-exec {
					if( $f:ロードチェックＯＮフラグ == 0 ) {
						chara カメラ設定 モーションカメラ \
							-c 1 \
							-p -16261,-1339,-30543 -t -16969,-3728,-31980 \
							-r 639,2346,0 \
							-f 2877 \
							-a 200 \
							-i 0 3 0 0 \
							-s $3
					}
				}
	}


	// 入出トラップ
	// ------------------------------------
	proc ロードプロック {
		if ($s:呼び出しプロック == mv_a02a0_a01f_0) {
			@mv_a02a0_a01f_0
		} else if ($s:呼び出しプロック == mv_a02a3_a01f_1) {
			@mv_a02a3_a01f_1
		} else if ($s:呼び出しプロック == mv_a02a3_a03a_0) {
			if($w:アラートモード != d:ALERT_MODE_SENNYU ) {
				command セットサウンドコード -c d:SNG_FOUTS_S
			}
			@mv_a02a3_a03a_0
		}
	}

	proc 右舷小部屋入出トラップ設定 {
		#if d:LOAD_TRAP
			trap ld001 d:PLAYER \
				-mask 入る \
				-exec {
					if( $f:ロードチェックＯＮフラグ == 1 ) {
						// ドアを挟んでグループが変わる場合はロードカメラの優先を強くする
						chara カメラ設定 ロードカメラ０ \
							-c 1 \
							-p 9750,-374,-10250 -t 9750,-3295,-11000 \
							-r 242,2048,0 -f 8048 \
							-a 200 \
							-i 3 0 0 0 \
							-s 1

						preseek 'w01f'
						@ステージ終了時処理（ステージ名表示） 11750 -5000 -11250 1024 mv_a02a0_a01f_0 d:DEFAULT_M_TYPE d:wn_機関室右舷入口
						//eval( $w:スタートアラートモード = $w:アラートモード )
					}
				}

			// ステージ開始時のカメラ
			trap ld001 d:PLAYER \
				-mask ？ \
				-exec {
					if( $f:ロードチェックＯＮフラグ == 0 ) {
						chara カメラ設定 ロードカメラ１ \
							-c 1 \
							-p 9750,-374,-10250 -t 9750,-3295,-11000 \
							-r 242,2048,0 -f 8048 \
							-a 200 \
							-i 0 2 0 0 \
							-s $3
					}
				}
		#endif
	}

	proc 左舷小部屋入出トラップ設定 {
		#if d:LOAD_TRAP
			trap ld002 d:PLAYER \
				-mask 入る \
				-exec {
					if( $f:ロードチェックＯＮフラグ == 1 ) {
						// ドアを挟んでグループが変わる場合はロードカメラの優先を強くする
						chara カメラ設定 ロードカメラ０ \
							-c 1 \
							-p -9750,-230,-10250 -t -9750,-3295,-11000 \
							-r 252,2048,0 -f 8102 \
							-a 200 \
							-i 3 0 0 0 \
							-s 1

						preseek 'w01f'
						@ステージ終了時処理（ステージ名表示） /*-12350*/-11750 -5000 -11250 3072 mv_a02a3_a01f_1 d:DEFAULT_M_TYPE d:wn_機関室左舷入口
					}
				}

			// ステージ開始時のカメラ
			trap ld002 d:PLAYER \
				-mask ？ \
				-exec {
					if( $f:ロードチェックＯＮフラグ == 0 ) {
						chara カメラ設定 ロードカメラ１ \
							-c 1 \
							-p -9750,-230,-10250 -t -9750,-3295,-11000 \
							-r 252,2048,0 -f 8102 \
							-a 200 \
							-i 0 2 0 0 \
							-s $3
					}
				}
		#endif
	}

	proc 長廊下へロード $:トリガ $:実行キャラ {
		#if d:LOAD_TRAP
			if ($:トリガ == 0) {		// 開いたとき
				#if d:STAGE_CAMERA
					chara カメラ設定 ロードカメラ１ \
						-c 1 \
						-p -16261,-1339,-30543 -t -16969,-3728,-31980 \
						-r 639,2346,0 \
						-f 2877 \
						-a 200 \
						-i 0 0 0 0 \
						-s 1
				#endif

				#ifdef d:TGS2001F
					@ＴＧＳ版クリアしました
				#elseifdef d:EU_TRIAL
					@ＴＧＳ版クリアしました
				#else

					if( ( $b:ミッション番号 == d:MISSION:スネークテイルズ ) && \
						( $b:tales_story_no == d:TALES_NO:C ) ) {
						$w:スタートアラートモード = d:ALERT_MODE_SENNYU;
					}

					preseek 'w03a'
					@ステージ終了時処理（ステージ名表示） -16732 -5000 -35000 2048 mv_a02a3_a03a_0 d:DEFAULT_M_TYPE d:wn_第二甲板左舷
				#endif
			}
		#endif
	}




/***************************************************************************************************/
// ロッカー死体関係プロック
/***************************************************************************************************/

	proc ロッカー死体倒れ開始 {
		print 'ロッカー死体倒れ開始'
		@ストリームカメラ開始処理
	}

	proc ロッカー死体倒れ終了 {
		if ( `command ゲームオーバーチェック` == 0 ) {
			print 'ロッカー死体倒れ終了'
			//mesg デモキャンセルチェック Ch変装チェックキャンセル kill
			@シナリオデモ終了処理
			command パッド操作 -cancel
			eval( $f:w02a_ロッカー死体倒れたフラグ = 1 )
			#if d:VAR_SAVE
				command varsave $f:w02a_ロッカー死体倒れたフラグ
			#endif
		}
	}

/***************************************************************************************************/
// ロッカー関係
/***************************************************************************************************/
	proc 死体切り替え {
		chara delay 死体切り替えディレイ -time 2 -exec {
			print '死体切り替え'
			mesg プットモーションモデル 死体のプットモーションモデル 非表示
			mesg プットモーションモデル 死体のプットモーションモデル kill

			mesg ロッカー死体 ロッカー１死体 倒れ

			mesg ロッカー死体 ロッカー１死体 表示
		}
	}

	proc ロッカーチェック $:番号 {
		@壊れ物再セットチェック $b:w02a_破壊ロード回数[$:番号]
		if($f:再セットフラグ) {
			eval($i:w02a_ロッカーロード回数[$:番号] = 0)
		}
	}

	proc ロッカー状態保存 $:番号 $:行動 $:ロッカー名 {
		if(($:行動 != 6) && ($:行動 != 8)) {
			// 状態変化時
			eval($b:w02a_破壊ロード回数[$:番号] = $w:グローバルロード回数);
		} else if($:行動 == 8) {
			// ステージ終了時
			command ロッカー状態 -n $:ロッカー名
			eval($i:w02a_ロッカーロード回数[$:番号] = $status)
		}
	}

	proc ロッカー設置 {

		// オールタナティブではロッカー死体は出ない
		$f:w02a_ロッカー死体倒れたフラグ = 1;

		// ローカル変数定義
		local $$:ファイル名

		#if d:LOCKER
			chara ロッカー管理 管理人さん -n 7
			command ロッカーモーション -motion locker
			command プレイヤーロッカーモーション -motion sna_locker

			if( $b:ミッション番号 == d:MISSION:敵兵排除 ) {
				// 敵兵排除ではロッカーを全面的に閉鎖する。
				// ロッカーステータス用変数
				eval( $i:ローカル変数Ｉ１ = d:LOCKER_STATE_DESTROY )
			} else {
				if( $f:w02a_ロッカー死体倒れたフラグ == 0 ) {
					chara ロッカー死体 ロッカー１死体 \
							-pos 12250,-5000,-24750 \
							-dir 0 \
							-kms tnc_def_blood \
							-mar locker_cp \
							//-s 0x40 \
							-number 0

					chara プットモーションモデル 死体のプットモーションモデル \
							-pos 12250,-5000,-24750 \
							-dir 0 \
							-kms tnc_def_blood \
							-mar locker_cp \
							-number 0 \
							-status ( 0x04 | 0x08 | 0x02 | 0x10 )

					mesg ロッカー死体 ロッカー１死体 非表示
					mesg プットモーションモデル 死体のプットモーションモデル 非表示

					// ロッカーステータス用変数
					eval( $i:ローカル変数Ｉ１ = d:LOCKER_STATE_CORPSE_IN )
				} else {
					// ロッカーステータス用変数
					eval( $i:ローカル変数Ｉ１ = 0 )
				}
			}


	///////////////////////////////
	// 右舷ロッカー

		// 右舷ロッカー左から１番目
			if( $b:ミッション番号 == d:MISSION:写真撮影 ) {
				$$:ファイル名 = new_locker2_door_gmen1
			} else {
				$$:ファイル名 = neo_locker_door;
			}
			@ロッカーチェック 0
			chara ロッカー ロッカー１ \
				-kms $$:ファイル名 \
				-seno 4 \
				-sefloor 4 \
				-p 12700,-5000,-24500 \
				-r 0,0,0 \
				-s $i:ローカル変数Ｉ１ \
				-flag ( d:LOCKER_FLAG_SHADOWDROP | d:LOCKER_FLAG_SHADOWWRITE ) \
				-l レイブンライト \
				-load_state $i:w02a_ロッカーロード回数[0] \
				-exec {
					@ロッカー状態保存 0 $3 $4

					if( $f:w02a_ロッカー死体倒れたフラグ == 0 ) {
						// 開始 && スネーク && 外から開ける
						if ( ($:トリガ == 1 && $:実行キャラ == d:PLAYER && $:行動 == 0) ) {

							if( `command StreamIsPlay` < 2 ) {
								@シナリオストリームデモ開始処理

								// ＢＧＭフェードアウト
								command セットサウンドコード -c d:SNG_FOUTP_S

								// ジングル
								chara delay ロッカー死体ジングルディレイ -time 60 -exec {
									command ＳＥセットモード -s d:se_code:SD_S_JINGLE02 \
										-p $i:プレイヤー位置Ｘ,$i:プレイヤー位置Ｙ,$i:プレイヤー位置Ｚ -m 3
								}
								// 曲を元に戻す
								chara delay ＢＧＭ復帰ディレイ -time 360 -exec {
									command セットサウンドコード -c d:SNG_FIN_S
								}

								chara delay ロッカー死体振動ディレイ -time 26 -exec {
									chara パッド振動 ロッカー死体振動 -vibfile tnc_down
								}

								chara demo ロッカー死体倒れ \
									-p ストリームカメラ開始処理 \
									   死体切り替え \
									-i t:scndemo_w02a \
									-begin ロッカー死体倒れ開始 \
									-next  ロッカー死体倒れ終了 \
									-undraw 0 \
									-no_state_demo

								mesg プットモーションモデル 死体のプットモーションモデル 表示

								chara delay カメラディレイ -time 40 -exec {
									mesg プットモーションモデル 死体のプットモーションモデル 終了判定 1
								}
							} else {
								eval( $f:w02a_ロッカー死体倒れたフラグ = 1 )
								mesg ロッカー死体 ロッカー１死体 倒れ
								mesg ロッカー死体 ロッカー１死体 表示
							}
						// 壊れて開いた
						} else if( $:行動 == 4 ) {
							eval( $f:w02a_ロッカー死体倒れたフラグ = 1 )
							mesg ロッカー死体 ロッカー１死体 倒れ
							mesg ロッカー死体 ロッカー１死体 表示
						// スネーク以外の人が開けた
						} else if( $:行動 == 0 ) {
							eval( $f:w02a_ロッカー死体倒れたフラグ = 1 )
						}
					}
				}

			trap lk001 d:PLAYER \
				-and \
				-mask いる \
				-state 0,4 \
				-dir 2048,512 0,512 \
				-button d:ACTION_BUTTON,-1 \
				-exec {
					command ロッカー状態 -n ロッカー１
					mesg プレイヤー d:PLAYER locker ロッカー１ $status 2048,512 12700,-24500
				}

			trap lk001 d:PLAYER \
				-mask ？ \
				-state 6 \
				-exec {
					if( $3 == 入る ) {
						if( $f:w02a_ロッカー死体倒れたフラグ == 0 ) {
							chara カメラ設定 モーションカメラ \
								-c 1 \
								-p 12047 -4711 -22527 \
								-t 12121 -3976 -23731 \
								-r -212,1703,0 -f 2035 \
								-a 200 \
								-i 0 -1 0 0 \
								-s $3
						} else {
							chara カメラ設定 モーションカメラ \
								-c 1 \
								-p 11665,-2729,-21811 -t 12201,-3415,-23550 \
								-r 235,1853,0 -f 1945 \
								-a 200 \
								-i 0 -1 0 0 \
								-s $3
						}
					} else {
						chara カメラ設定 モーションカメラ -s -1
					}
				}

		// 右舷ロッカー左から２番目
			if( $b:ミッション番号 == d:MISSION:写真撮影 ) {
				$$:ファイル名 = new_locker2_door_gmen1
			} else {
				$$:ファイル名 = neo_locker_door;
			}

			if( $b:ミッション番号 == d:MISSION:敵兵排除 ) {
				// 敵兵排除ではロッカーを全面的に閉鎖する。
				// ロッカーステータス用変数
				eval( $i:ローカル変数Ｉ１ = d:LOCKER_STATE_DESTROY )
			} else {
				eval( $i:ローカル変数Ｉ１ = 0 )
			}

			@ロッカーチェック 1
			chara ロッカー ロッカー２ \
				-kms $$:ファイル名 \
				-seno 4 \
				-sefloor 4 \
				-p 13700,-5000,-24500 \
				-r 0,0,0 \
				-s $i:ローカル変数Ｉ１ \
				//-down_rot 0 2870 0 \
				//-down_shift 0 0 200 \
				-flag ( 0x0001 | 0x0004 ) \
				-l レイブンライト \
				-load_state $i:w02a_ロッカーロード回数[1] \
				-exec {
					//mesg 静止スポットライト設置 レイブンライト off
					@ロッカー状態保存 1 $3 $4
					if( $3 == 3 ) {
						print '閉じたので影を消す'
					}

					if( $3 == 4 ) {
						print '開けたので影を出す'
					}
				}

			trap lk002 d:PLAYER \
				-and \
				-mask いる \
				-state 0,4 \
				-dir 2048,512 0,512 \
				-button d:ACTION_BUTTON,-1 \
				-exec {
					command ロッカー状態 -n ロッカー２
					mesg プレイヤー d:PLAYER locker ロッカー２ $status 2048,512 13700,-24500
				}

			trap lk002 d:PLAYER \
				-mask ？ \
				-state 6 \
				-exec {
					chara カメラ設定 モーションカメラ \
						-c 1 \
						-p 12205,-1412,-21355 -t 13221,-3532,-23527 \
						-r 472,1763,0 -f 3201 \
						-a 200 \
						-i 0 2 0 0 \
						-s $3
				}

		// 右舷ロッカー左から３番目
			if( $b:ミッション番号 == d:MISSION:敵兵排除 ) {
				// 敵兵排除ではロッカーを全面的に閉鎖する。
				// ロッカーステータス用変数
				eval( $i:ローカル変数Ｉ１ = d:LOCKER_STATE_BROKEN )
			} else {
				eval( $i:ローカル変数Ｉ１ = d:LOCKER_STATE_OPEN )
			}

			@ロッカーチェック 2
			chara ロッカー ロッカー３ \
				-kms new_locker2_door_gmen1 \	// マッチョ
				-seno 4 \
				-sefloor 4 \
				-p 14700,-5000,-24500 \
				-r 0,0,0 \
				-s $i:ローカル変数Ｉ１ \
				//-down_rot 0 2870 0 \
				//-down_shift 0 0 200 \
				-flag 0x0001 \
				-load_state $i:w02a_ロッカーロード回数[2] \
				-exec {
					@ロッカー状態保存 2 $3 $4
				}

			trap lk003 d:PLAYER \
				-and \
				-mask いる \
				-state 0,4 \
				-dir 2048,512 0,512 \
				-button d:ACTION_BUTTON,-1 \
				-exec {
					command ロッカー状態 -n ロッカー３
					mesg プレイヤー d:PLAYER locker ロッカー３ $status 2048,512 14700,-24500
				}

			trap lk003 d:PLAYER \
				-mask ？ \
				-state 6 \
				-exec {
					chara カメラ設定 モーションカメラ \
						-c 1 \
						-p 13424,-1324,-21892 -t 14283,-3290,-23729 \
						-r 502,1763,0 -f 2824 \
						-a 200 \
						-i 0 2 0 0 \
						-s $3
				}

		// 右舷ロッカー左から４番目
			if( $b:ミッション番号 == d:MISSION:写真撮影 ) {
				$$:ファイル名 = new_locker2_door_gmen1
			} else {
				$$:ファイル名 = neo_locker_door;
			}
			@ロッカーチェック 3
			chara ロッカー ロッカー４ \
				-seno 4 \
				-sefloor 4 \
				-kms $$:ファイル名 \
				-p 15700,-5000,-24500 \
				-r 0,0,0 \
				-s d:LOCKER_STATE_DESTROY \
				//-down_rot 0 2870 0 \
				//-down_shift 0 0 200 \
				-flag 0x0001 \
				-load_state $i:w02a_ロッカーロード回数[3] \
				-exec {
					@ロッカー状態保存 3 $3 $4
				}
			trap lk004 d:PLAYER \
				-and \
				-mask いる \
				-state 0,4 \
				-dir 2048,512 0,512 \
				-button d:ACTION_BUTTON,-1 \
				-exec {
					command ロッカー状態 -n ロッカー４
					mesg プレイヤー d:PLAYER locker ロッカー４ $status 2048,512 15700,-24500
					eval($f:rft_w02a_開かないロッカーlk004 = 1 )	//fukushima
				}
			trap lk004 d:PLAYER \
				-mask ？ \
				-state 6 \
				-dir d:NORTH 256 \
				-exec {
					if( $3 == 入る ) {
						// 空中にいる時はカメラを変えない
						if( $5 < -3800 ) {
							chara カメラ設定 モーションカメラ \
							-c 1 \
							-p 14768,-2187,-21926 -t 15251,-3294,-23683 \
							-r 356,1873,0 -f 2132 \
							-a 200 \
							-i 0 0 0 0 \
							-s $3
						}
					} else {
						chara カメラ設定 モーションカメラ \
							-c 1 \
							-p 14768,-2187,-21926 -t 15251,-3294,-23683 \
							-r 356,1873,0 -f 2132 \
							-a 200 \
							-i 0 0 0 0 \
							-s $3
					}
			}

	///////////////////////////////////
	// 左舷ロッカー

		// 左舷北
			if( $b:ミッション番号 == d:MISSION:写真撮影 ) {
				$$:ファイル名 = new_locker2_door_gmen1
			} else {
				//$$:ファイル名 = new_locker2_door_men1;
				$$:ファイル名 = neo_locker_door;
			}
			@ロッカーチェック 4
			chara ロッカー ロッカー５ \
				-kms $$:ファイル名 \		// 触り男ポスター
				-seno 4 \
				-sefloor 4 \
				-p -18250,-5000,-24950 \
				-r 0,1024,0 \
				//-s d:LOCKER_STATE_OPEN \
				//-down_rot 0 2870 0 \
				//-down_shift 0 0 200 \
				//-s d:LOCKER_STATE_CORPSE_IN \
				-load_state $i:w02a_ロッカーロード回数[4] \
				-exec {
					@ロッカー状態保存 4 $3 $4
				}
			trap lk011 d:PLAYER \
				-and \
				-mask いる \
				-state 0,4 \
				-dir 3072,512 1024,512 \
				-button d:ACTION_BUTTON,-1 \
				-exec {
					command ロッカー状態 -n ロッカー５
					mesg プレイヤー d:PLAYER locker ロッカー５ $status 3072,512 -18250,-24950
				}
			trap lk011 d:PLAYER \
				-mask ？ \
				-state 6 \
				-exec {
					chara カメラ設定 モーションカメラ \
						-c 1 \
						-p -10270,-2339,-21029 -t -17143,-3317,-23926 \
						-r 85,2812,0 -f 7523 \
						-a 569 \
						-i 1 1 0 0 \
						-s $3
				}

		// 左舷真ん中
			if( $b:ミッション番号 == d:MISSION:写真撮影 ) {
				$$:ファイル名 = new_locker2_door_gmen1
			} else {
				//$$:ファイル名 = new_locker2_door_gir1;
				$$:ファイル名 = neo_locker_door;
			}

			@ロッカーチェック 5
			chara ロッカー ロッカー６ \
				-kms $$:ファイル名 \		// 四次元ポスター
				//-kms neo_locker_door \
				-seno 4 \
				-sefloor 4 \
				-p -18250,-5000,-23950 \
				-r 0,1024,0 \
				//-down_rot 0 2870 0 \
				//-down_shift 0 0 200 \
				-s d:LOCKER_STATE_OPEN \
				-load_state $i:w02a_ロッカーロード回数[5] \
				-exec {
					@ロッカー状態保存 5 $3 $4
				}
			trap lk012 d:PLAYER \
				-and \
				-mask いる \
				-state 0,4 \
				-dir 3072,512 1024,512 \
				-button d:ACTION_BUTTON,-1 \
				-exec {
					command ロッカー状態 -n ロッカー６
					mesg プレイヤー d:PLAYER locker ロッカー６ $status 3072,512 -18250,-23950
				}
			trap lk012 d:PLAYER \
				-mask ？ \
				-state 6 \
				-exec {
					chara カメラ設定 モーションカメラ \
						-c 1 \
						-p -16208,-596,-20778 -t -16864,-2366,-22188 \
						-r 554,2332,0 -f 2357 \
						-a 200 \
						-i 1 1 0 0 \
						-s $3
				}

			// 左舷南
			if( $b:ミッション番号 == d:MISSION:写真撮影 ) {
				$$:ファイル名 = new_locker2_door_gmen1
			} else {
				$$:ファイル名 = neo_locker_door;
			}
			@ロッカーチェック 6
			chara ロッカー ロッカー７ \
				-kms $$:ファイル名 \
				-seno 4 \
				-sefloor 4 \
				-p -18250,-5000,-22950 \
				-r 0,1024,0 \
				//-down_rot 0 -256 0 \
				//-down_shift 500 0 0 \
				//-flag d:LOCKER_FLAG_DOWNOUTSIDE \
				-state d:LOCKER_STATE_DESTROY \
				-load_state $i:w02a_ロッカーロード回数[6] \
				-exec {
					@ロッカー状態保存 6 $3 $4
				}
			trap lk013 d:PLAYER \
				-and \
				-mask いる \
				-state 0,4 \
				-dir 3072,512 1024,512 \
				-button d:ACTION_BUTTON,-1 \
				-exec {
					command ロッカー状態 -n ロッカー７
					mesg プレイヤー d:PLAYER locker ロッカー７ $status 3072,512 -18250,-22950
				}

			trap lk013 d:PLAYER \
				-mask ？ \
				-state 6 \
				-dir d:WEST 256 \
				-exec {
					if( $3 == 入る ) {
						if( $5 < -3800 ) {
							chara カメラ設定 モーションカメラ \
								-c 1 \
								-p -16302,-749,-19695 -t -16746,-2528,-21183 \
								-r 556,2237,0 -f 2361 \
								-a 200 \
								-i 1 1 0 0 \
								-s $3
						}
					} else {
						chara カメラ設定 モーションカメラ \
								-c 1 \
								-p -16302,-749,-19695 -t -16746,-2528,-21183 \
								-r 556,2237,0 -f 2361 \
								-a 200 \
								-i 1 1 0 0 \
								-s $3
					}
				}

		#endif
	}

