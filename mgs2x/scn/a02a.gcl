/***************************************************************************************************/
// 各種カメラの設定
/***************************************************************************************************/
	proc 完全補完カメラ $:比較対象 $:距離小 $:距離大 $:ＰＸ１  $:ＰＹ１  $:ＰＺ１  $:ＴＸ１  $:ＴＹ１  $:ＴＺ１ $:ＰＸ２ $:ＰＹ２ $:ＰＺ２ $:ＴＸ２ $:ＴＹ２ $:ＴＺ２ {
		@CS_スムーズカメラ昇順 $:比較対象 $:距離小 $:距離大 $:ＰＸ１ $:ＰＸ２
			eval( $i:補完ＰＸ= $i:CS_結果１ )
		@CS_スムーズカメラ昇順 $:比較対象 $:距離小 $:距離大 $:ＰＹ１ $:ＰＹ２
			eval( $i:補完ＰＹ= $i:CS_結果１ )
		@CS_スムーズカメラ昇順 $:比較対象 $:距離小 $:距離大 $:ＰＺ１ $:ＰＺ２
			eval( $i:補完ＰＺ= $i:CS_結果１ )
		@CS_スムーズカメラ昇順 $:比較対象 $:距離小 $:距離大 $:ＴＸ１ $:ＴＸ２
			eval( $i:補完ＴＸ= $i:CS_結果１ )
		@CS_スムーズカメラ昇順 $:比較対象 $:距離小 $:距離大 $:ＴＹ１ $:ＴＹ２
			eval( $i:補完ＴＹ= $i:CS_結果１ )
		@CS_スムーズカメラ昇順 $:比較対象 $:距離小 $:距離大 $:ＴＺ１ $:ＴＺ２
			eval( $i:補完ＴＺ= $i:CS_結果１ )
	}
	proc エンジンルーム右舷Ｂ１カメラ設定 {
		#if d:STAGE_CAMERA
			// エンジンルーム右B1通路
			trap c004 d:PLAYER \
				-mask ＊ \
				-camera \
				-exec {
					@完全補完カメラ $6	-16000 -10000 \
										5577,-3508,-9947 7702,-3933,-18323  \
										//6206,-765,-4401 6493,-5911,-11334
										5639,-1098,-2900 6586,-3722,-8900

					chara カメラ設定 通路カメラ１ \
						-c 1 \
						-p $i:補完ＰＸ $i:補完ＰＹ $i:補完ＰＺ \
						-t $i:補完ＴＸ $i:補完ＴＹ $i:補完ＴＺ \
						-r 184,2003,0 -f 5981 \
						-a 200 \
						-i 0 -1 0 0 \
						-s $3
				}

		// エンジンルーム右B1→B2階段
		trap c005 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {

				@CS_スムーズカメラ昇順 $6 -9000 -6500 283 598
					eval( $i:補完ＲＸ = $i:CS_結果１ )
				@CS_スムーズカメラ昇順 $6 -9000 -6500 1926 2106
					eval( $i:補完ＲＹ = $i:CS_結果１ )
				@CS_スムーズカメラ昇順 $6 -9000 -6500 6206 8856
					eval( $i:補完ＰＸ = $i:CS_結果１ )
				@CS_スムーズカメラ昇順 $6 -9000 -6500 6493 8829
					eval( $i:補完ＴＸ = $i:CS_結果１ )


				chara カメラ設定 階段カメラ \
						-c 0 \
						-b -32000,-32000,-32000 $i:補完ＰＸ,32000,32000 \
						-l -32000,-32000,-32000 $i:補完ＴＸ,32000,32000 \
						-r $i:補完ＲＸ,$i:補完ＲＹ,0 -f 6000 \
						-a 200 \
						-i 3 3 0 0 \
						-slide 1 1 6000 6000 50 \
						-s $3
			}
		#endif
	}

	proc エンジンルーム右舷Ｂ２カメラ設定 {
		// エンジンルーム右B1→B2階段下
		trap c006 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {

				//-p 7131,-5233,1318 -t 6990,-7649,-6307 \
				//-r 200,2060,0 -f 8000 \
				//-a 200 \

				//@CS_スムーズカメラ昇順 $4 7000 11000 7131 11614
				//eval( $i:補完ＲＹ = $i:CS_結果１ );

				if( $4 > 7000 ){
					@CS_スムーズカメラ昇順 $4 6500 10000 2000 2060
					eval( $i:補完ＲＹ = $i:CS_結果１ );
				}else{
					@CS_スムーズカメラ昇順 $6 -14000 -7000 1865 2000
					eval( $i:補完ＲＹ = $i:CS_結果１ );
				}

				chara カメラ設定 通路カメラ１ \
					-c 0 \
					-b -32000,-32000,-32000 11614,32000,5387 \
					-l -32000,-32000,-32000 11474,32000,-2238 \
					-r 200,$i:補完ＲＹ,0 \
					-f 8000 \
					-a 200 \
					-i 3 -1 0 0 \
					//-slide 1 1 8000 5000 50 \
					-s $3
					/*
					-p 11614,-4995,5387 -t 11474,-7411,-2238 \
					-r 200,2060,0 -f 8000 \
					-a 200 \
					*/
			}

		// エンジンルーム右B2→B3階段
		trap c009 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
/*
				chara カメラ設定 階段カメラ \
					-c 1 \
					-p 6458,-10970,-2364 -t 6215,-11329,-10280 \
					-r 171,2068,0 -f 8200 \
					-a 200 \
					-i 0 -1 0 0 \
					//-slide 1 1 8040 8040 50 \
					-s $3
*/
						@CS_スムーズカメラ昇順 $6 -20000 -10500 170 172
							eval( $i:補完ＲＸ = $i:CS_結果１);

						@CS_スムーズカメラ昇順 $6 -20000 -10500 /*1823*/1700 2076
							eval( $i:補完ＲＹ = $i:CS_結果１);

						@CS_スムーズカメラ昇順 $6 -20000 -10500 -10000 -11000
							eval( $i:補完ＢＹ = $i:CS_結果１);

						chara カメラ設定 階段カメラ２ \
							-c 0 \
							-b 4000,-40000,-40000 40000,$i:補完ＢＹ,40000 \
							-l -40000,-40000,-40000 40000,40000,40000 \
							-r $i:補完ＲＸ,$i:補完ＲＹ,0 -f 8200 \
							-a 200 \
//							-slide 1 5 6000 3000 50 0 \
							-i 3 3 0 0 \
							-s $3
			}
	}

