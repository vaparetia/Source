		print '死んだー'
		print '死んだー'
		print '死んだー'
		print '死んだー'
		print '死んだー'
		print '死んだー'
		chara カメラ設定 シナリオカメラ \
			-c 1 \
			-p $i:カメラＸ位置 $i:カメラＹ位置 $i:カメラＺ位置 \
			-t $i:注視点Ｘ位置 $i:注視点Ｙ位置 $i:注視点Ｚ位置 \
