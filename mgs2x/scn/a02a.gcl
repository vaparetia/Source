/***************************************************************************************************/
// クリアリング設定
/***************************************************************************************************/

///////////////////
// 右舷クリアリング

	proc 右舷Ｂ３クリアリング初期設定 {
		print '**************************************************************************'
		print '**************************************************************************'
		print '**************************************************************************'
		command ゲット敵兵座標 敵兵:61 $i:敵兵Ｘ $i:敵兵Ｙ $i:敵兵Ｚ

		if ($i:敵兵Ｘ > 3000) {
			print '**************** 右舷Ｂ３クリアリング初期設定 1 ******************'
			command セットクリアリング \
				-p	0,0,2,クリアリングカメラ_0_0_1 \
					0,0,9,クリアリングカメラ_0_0_2 \
					0,2,7,クリアリングカメラ_0_0_3 \
					0,2,11,クリアリングカメラ_0_0_4 \
					0,0,14,クリアリングカメラ_0_0_5 \
					0,3,7,クリアリングカメラ_0_0_6 \
				-i	0,1,2,3
		} else {
			print '**************** 右舷Ｂ３クリアリング初期設定 2 ******************'
			command セットクリアリング \
				-p	0,4,1,クリアリングカメラ_0_1_1 \
					0,5,3,クリアリングカメラ_0_1_2 \
					0,5,7,クリアリングカメラ_0_1_3 \
				-i	4,5,6,7
		}
	}

	// クリアリング子画面設定
	proc クリアリングカメラ_0_0_1 {
		#if d:CLEAR_CAMERA
			chara カメラ設定 クリアリングカメラ \
				-c 1 \
				-p 6487,-5818,-9978 -t 5455,-8977,-15979 \
				-r 312,2159,0 -f 6860 \
				-a 331 \
				-i 0 0 0 0 \
				-s 1

			command カメラマップ設定 -chanl 1 -map エンジンルーム
			mesg サブ画面 子画面 on

			chara delay ディレイカメラ -time 120 -exec {
				mesg サブ画面 子画面 off
			}
		#endif
	}

