#define		CLEAR_CAMERA	1

// フォグ
#define		FOG				1

// 入出トラップ
#define		LOAD_TRAP		1
// 天井
#define		CHARA_CEIL		1
// ライト関係
#define		SPOT_LIGHT		1
// オブジェ関係
#define		VALCAN			1
#define		CHAIN			1
#define		SENSOR			1
#define		LOCKER			1
// 強制モーション
#define		BY_MOTION		1
#define		JP_MOTION		0		// オートジャンプ

// イベント
#define		RAVEN			0
#define		REPAIR			0

// ビデオ撮影用
#define		VIDEO_SHADOW	0
#define		MULTI_MODEL		0
#define		BOKASHI			1

// 敵兵守備ポイント
#define DEF_POINT_X1 7500
#define DEF_POINT_Y1 -7000
#define DEF_POINT_Z1 -6500

#define DEF_POINT_X2 -4500
#define DEF_POINT_Y2 -13000
#define DEF_POINT_Z2 -16250

#define DEF_POINT_X3 -6500
#define DEF_POINT_Y3 -9000
#define DEF_POINT_Z3 -6500

#define DEF_POINT_X4 -7000
#define DEF_POINT_Y4 -5000
#define DEF_POINT_Z4 -15000


// 各種define
// マップ関係
#define		HZX_NAME		a02a
#define		KMS_NAME0		w02a0
#define		KMS_NAME1		w02a1
#define		KMS_NAME2		w02a2
#define		KMS_NAME3		w02a3
#define		KMS_NAME4		w01f3
#define		CEIL_NAME0		w02a0r
#define		CEIL_NAME1		w02a1r
#define		CEIL_NAME3		w02a3r
#define		CEIL_NAME4		w01fr4
#define		DOOR_NAME1		w02a_r_dr
#define		DOOR_NAME2		w02a_l_dr
#define		LT2_NAME0		w02a0
#define		LT2_NAME		w02a
#define		LT2_NAME3		w02a0

// 子画面サイズ
#define		SUB_WIDTH		160
#define		SUB_HEIGHT		64
#define		SUB_MARGIN		16

// ドアのディファイン
#define DR_NAME_R1			w02a_r_dr
#define DR_NAME_R2			w02a_r_dr
#define DR_NAME_R3			w02a_r_dr
#define DR_NAME_R4			w02a_r_dr
#define DR_NAME_R5			w02a_r_dr

#define DR_NAME_L1			w02a_l_dr
#define DR_NAME_L2			w02a_l_dr
#define DR_NAME_L3			w02a_l_dr
#define DR_NAME_L4			w02a_l_dr
#define DR_NAME_L5			w02a_l_dr

#define DR_NAME_WT1			w02a3sdr_body
#define DR_NAME_WT2			w02a3sdr_body
#define DR_NAME_WT3			w02a3sdr_body
#define DR_NAME_WT4			w02a3sdr_body
#define DR_NAME_WT5			w02a3sdr_body
/****************************************************************************************/
// 音声リソースのセット
/****************************************************************************************/

	resource ghq_area_alert_voice {
	w02a:
		$t{
			t:vc040029,	//「了解。増援部隊は機関室右舷に向かえ。敵を逃がすな！」
//			t:vc04002a, //「了解。バックアップ、機関室に回れ。右舷入口を固めろ」
//			t:vc04002f, //「わかった。増援部隊、機関室に向かえ。右舷階段を防衛せよ」
//			t:vc040030, //「わかった。増援部隊、機関室右舷階段に向かえ。敵を食い止めろ！」
			//t:vc040031, //「わかった。増援部隊、機関室にへ向かえ。エンジン付近を固めろ！」
			//t:vc040032, //「わかった。増援部隊、機関室、エンジン付近に向かえ。進入者を阻止せよ！」
			-2,
//			t:vc04002b,	//「了解。増援部隊、機関室左舷入口を固めろ。敵を逃がすな！」
			t:vc04002c, //「了解。バックアップ、機関室に急行。右舷入口を守れ！」
//			t:vc04002d, //「了解。応援を左舷階段に派遣する。敵の前進を阻止せよ！」
//			t:vc04002e, //「了解。応援部隊、機関室に向かえ。左舷階段を固めろ！」
			-1
		}
	}

	resource ghq_caution_voice {
	w02a:
		$t{
			t:vc040053, //「了解。機関室右舷入口を増員。警戒を強化せよ」
			t:vc040054, //「了解。機関室に増員を送る。右舷入口の警備を固めろ」
			t:vc040055, //「了解。機関室左舷入口に増員。警戒を強化しろ」
			t:vc040056, //「了解。機関室警備を増員する。右舷入口を固めろ」
			//t:vc040057, //「了解。左舷階段に増員を派遣する。警備を強化せよ」
			//t:vc040058, //「了解。機関室を増員する。左舷階段を警戒せよ」
			//t:vc040059, //「わかった。機関室に増員。右舷階段の警備を固めろ」
			//t:vc04005a, //「わかった。機関室右舷階段の警備を増員する。パトロールを強化せよ」
			//t:vc04005b, //「わかった。機関室に増員を回す。エンジン付近を固めろ」
			//t:vc04005c, //「わかった。機関室、エンジン付近を増員。警戒を強化せよ」
			-2,
			// 連絡が途絶えた時の音声
			t:vc040070,   //「機関室との連絡が途絶えた」
			-1	// 全ての登録終了
		}
	a02a:
		$t{
			t:vc046601, //「了解、総員警戒を強化せよ」
			t:vc046601, //「了解、総員警戒を強化せよ」
			t:vc046601, //「了解、総員警戒を強化せよ」
			t:vc046601, //「了解、総員警戒を強化せよ」
			-2,
			// 連絡が途絶えた時の音声
			t:vc040070,   //「機関室との連絡が途絶えた」
			-1	// 全ての登録終了
		}
	}
/****************************************************************************************/
// ドア設定用ステージ内ローカル変数(a_mode.hよりも先に定義する)
/****************************************************************************************/

dim $$b:ドアフラグ[ 3 ]
dim $$s:ドアモデル名[ 3 ]

command	配列セット $$b:ドアフラグ[0] {
	0, 0, 0
}
command	配列セット $$s:ドアモデル名[0] {
	0, 0, 0
}

/****************************************************************************************/
//	Include (enumの後に設定)
/****************************************************************************************/
#include "sna_a02a.mh"
#include "stdch.h"
#include "enevoice.h"
#include "a_mode.h"
#include "sload.h"
#include "item_info.h"
#include "a_item_info.h"
#include "ene_item.h"
#include "beyond.h"
#include "jump.h"

#if d:MY_DEBUG
	#include "usbkbd.h"
#endif

/***************************************************************************************/
// マップ宣言
/***************************************************************************************/
	// アナザー用プロック マップ設定前に設定する
	@アナザー用マップ定義前設定					// a_mode.h

/****************************************************************************************/
// マップ設定
/****************************************************************************************/

	chara マップ 右舷小部屋 -k d:KMS_NAME0 -h d:HZX_NAME,0 -l d:LT2_NAME
	chara マップ エンジンルーム -k d:KMS_NAME1 -h d:HZX_NAME,1 -l d:LT2_NAME
	chara マップ エンジンルーム底 -k d:KMS_NAME2 -h d:HZX_NAME,2 -l d:LT2_NAME
	chara マップ 左舷小部屋 -k d:KMS_NAME3 -h d:HZX_NAME,3 -l d:LT2_NAME
	chara マップ 右舷居住区Ｂ１ -k d:KMS_NAME4 -k d:CEIL_NAME4 -h d:HZX_NAME,6 -l d:LT2_NAME
	chara マップ 左舷居住区Ｂ１ -k d:KMS_NAME4 -k d:CEIL_NAME4 -h d:HZX_NAME,7 -l d:LT2_NAME

	chara マップ接合 エンジン／右小部屋 エンジンルーム 右舷小部屋
	chara マップ接合 エンジン／左小部屋 エンジンルーム 左舷小部屋
	chara マップ接合 エンジン／底 エンジンルーム エンジンルーム底
	chara マップ接合 右居住区／右小部屋 右舷居住区Ｂ１ 右舷小部屋
	chara マップ接合 左居住区／左小部屋 左舷居住区Ｂ１ 左舷小部屋

	#if	d:シナリオデモカメラアングル作成
		#include "scn_demo_prvw.h"
	#endif

	command マップ設定	右舷小部屋 \
						エンジンルーム \
						左舷小部屋 \
						右舷居住区Ｂ１ \
						左舷居住区Ｂ１ \
	-set {
		@ローカル変数初期化
		@常駐キャラ設定							// stdch.h
		@A_プレイヤー設定 sna_a02a rai_a02a		// a_stdproc.h
	}

	// アナザー用プロック マップ設定後に設定する
	@アナザー用マップ定義後設定					// a_mode.h

	command マップ設定	右舷小部屋 \
						エンジンルーム \
						左舷小部屋 \
						右舷居住区Ｂ１ \
						左舷居住区Ｂ１ -set {
		@跳弾設定
		//@ポーズ時ステージ名表示設定 d:wn_機関室
		//@コマンダー設定
		//@敵兵ルートチェンジ
		//@エンジンルームＢＧＭマネージャー設定
		@シナリオデモキャラセット
		@ドア設置
		@エフェクト設定
		@子画面設定
		@カメラセット
		@スポットライト管理
		@遠近ぼかしセット

		@自動ジャンプ設定

		//@落っこち兵のフラグセーブ
		//@落下兵の欠伸コントロール

	// デバッグ用
	#if d:MY_DEBUG
		@デバッグキャラセット
	#endif

//		@死亡時カメラ固定

		#if d:LEFT_SAVE
			@左舷セーブ
		#endif
	}

	command マップ設定 右舷小部屋 左舷小部屋 -set {
		@小部屋フォグ設定
		@小部屋エフェクト設定
		@ロッカー設置
		//@自動ジャンプ設定
	}

	command マップ設定 エンジンルーム エンジンルーム底 -set {
		@エンジン／底マップ切り替え
		@エンジンルームエフェクト設定
		@ビキニポスター
		@ポスター爆発セットA
		@ポスター爆発セットB
		@敵兵視界遮り壁追加
		@エルード落下死亡カメラ
		@落下死亡プロック

		//@棒テスト		// 写真撮影で困るので無し
	}

	command マップ設定 右舷小部屋 -set {
		@右舷小部屋天井設置
		if( $b:ミッション番号 != d:MISSION:敵兵排除 ) {
			@右舷小部屋スポットライト設定
			@右舷小部屋影用ハザード
			@レイブン設置
		}
		//@右舷小部屋アイテム設置
		@右舷小部屋カメラ設定
		@右舷透明壁設置

		@敵兵のみを通す壁＿右舷

		#if d:RAVEN
			@レイブンイベント
		#endif
	}

	command マップ設定 左舷小部屋 -set {
		@左舷小部屋天井設置
		@水密ドア設置

		if ( $b:ミッション番号 == d:MISSION:スネークテイルズ ) {
			@赤外線センサー設置
			@敵兵もセンサーに引っかかる処理暫定
		} else {
			chara プットオブジェ 赤外線センサーＬ１ -m irs -r 0 0 0 -p -15900,-5000,-26250 -l w02a -s 100 100 100 -f ( d:PUT_OBJ_CALC_LIGHT )
			chara プットオブジェ 赤外線センサーＲ１ -m irs -r 0 0 0 -p -17600,-5000,-26250 -l w02a -s 100 100 100 -f ( d:PUT_OBJ_CALC_LIGHT )
			chara プットオブジェ 赤外線センサーＬ２ -m irs -r 0 0 0 -p -15900,-5000,-28250 -l w02a -s 100 100 100 -f ( d:PUT_OBJ_CALC_LIGHT )
			chara プットオブジェ 赤外線センサーＲ２ -m irs -r 0 0 0 -p -17600,-5000,-28250 -l w02a -s 100 100 100 -f ( d:PUT_OBJ_CALC_LIGHT )
			chara プットオブジェ 赤外線センサーＬ３ -m irs -r 0 0 0 -p -15900,-5000,-30250 -l w02a -s 100 100 100 -f ( d:PUT_OBJ_CALC_LIGHT )
			chara プットオブジェ 赤外線センサーＲ３ -m irs -r 0 0 0 -p -17600,-5000,-30250 -l w02a -s 100 100 100 -f ( d:PUT_OBJ_CALC_LIGHT )
		}

		//@左舷小部屋アイテム設置
		@左舷小部屋カメラ設定
		@左舷透明壁設置

		@敵兵のみを通す壁＿左舷
		#if d:REPAIR
			@ドア修理イベント設定
		#endif
	}

	command マップ設定 右舷小部屋 右舷居住区Ｂ１ -set {
		@右舷小部屋入出トラップ設定
	}
	command マップ設定 左舷小部屋 左舷居住区Ｂ１ -set {
		@左舷小部屋入出トラップ設定
	}

	command マップ設定 エンジンルーム -set {
		//@クリアリングトラップ
		@エンジンルーム天井設置
	#if d:VIDEO_SHADOW
		@エンジンルーム右舷Ｂ１スポットライト設定（ビデオ用）
	#else
		@エンジンルーム右舷Ｂ１スポットライト設定
	#endif
	//	@エンジンルーム右舷Ｂ２スポットライト設定
		@エンジンルーム右舷Ｂ３スポットライト設定
		@エンジンルーム左舷Ｂ２スポットライト設定
	#if d:VIDEO_SHADOW
		@エンジンルーム左舷Ｂ２スポットライト設定（ビデオ用）
		@エンジンルーム左舷Ｂ１スポットライト設定（ビデオ用）
	#else
		@エンジンルーム左舷Ｂ１スポットライト設定
	#endif
		@エンジンルーム影用ハザード
		@エンジンルーム右舷Ｂ１ビヨンド設定
		@エンジンルーム右舷Ｂ２ビヨンド設定
		@エンジンルーム右舷Ｂ３ビヨンド設定
		@エンジンルーム左舷Ｂ３ビヨンド設定
		@エンジンルーム左舷Ｂ２ビヨンド設定
		@エンジンルーム左舷Ｂ１ビヨンド設定
		@エンジンルーム中央ビヨンド設定
		//@エンジンルーム右舷強制モーション設定
		//@エンジンルーム左舷強制モーション設定
		@エンジンルーム右舷Ｂ１カメラ設定
		@エンジンルーム右舷Ｂ２カメラ設定
		@エンジンルーム右舷Ｂ３カメラ設定
		@エンジンルーム中央カメラ設定
		@エンジンルーム左舷Ｂ３カメラ設定
		@エンジンルーム左舷Ｂ２カメラ設定
		@エンジンルーム左舷Ｂ１カメラ設定
		@エンジンルームＢ１ビハインド用カメラ
		@エンジンルームＢ２ビハインド用カメラ
		@エンジンルームＢ３ビハインド用カメラ

		if( $b:ミッション番号 == d:MISSION:敵兵排除 ) {
//			@敵兵のみを通す壁＿右舷内側ドア
			@敵兵のみを通す壁＿左舷内側ドア
		}
	}

	command マップ設定 右舷小部屋 エンジンルーム 左舷小部屋 右舷居住区Ｂ１ 左舷居住区Ｂ１ -set {
		//@タンカーデジカメ写真判定
		@エンジンルームフォグ設定
		@座標チェック
	}

	// 初期マップの表示
	if( $b:ミッション番号 == d:MISSION:敵兵排除 ) {
		command マップ表示 -show 右舷小部屋
		command マップ表示 -show エンジンルーム
	} else {
		if ($i:プレイヤー初期Ｘ位置 > 0) {
			command マップ表示 -show 右舷小部屋
		} else {
			command マップ表示 -show 左舷小部屋
		}
	}
	// 全てのセットが終わったところでフェードイン
	if( $s:登場ポイント == リフレッシュルーム右舷地下からロード ) {

		@ステージ開始時処理（ステージ名表示） \
								d:LOAD_TYPE:SL_DOOR_TYPE \
								ドア名不要 \
								1500 \
								d:DEFAULT_M_TYPE \
								d:wn_機関室右舷

		#if d:LEFT_SAVE
			// 右舷から入った時のみ左舷セーブポイントを設定する
			eval( $f:w02a_左舷セーブフラグ = 0 )
		#endif

	} else if( $s:登場ポイント == リフレッシュルーム左舷地下からロード ){

		@ステージ開始時処理（ステージ名表示） \
								d:LOAD_TYPE:SL_DOOR_TYPE \
								ドア名不要 \
								1500 \
								d:DEFAULT_M_TYPE \
								d:wn_機関室左舷

	} else if( $s:登場ポイント == エンジンルーム左舷から ) {

		@ステージ開始時処理（ステージ名表示） \
								d:LOAD_TYPE:WT_DOOR_TYPE \
								水密君 \
								2000 \
								d:DEFAULT_M_TYPE \
								d:wn_機関室左舷

	} else if( $s:登場ポイント == 左舷小部屋ロードポイント ) {

		#if d:LEFT_SAVE

			@ステージ開始時処理（ステージ名表示） \
									d:LOAD_TYPE:NO_MOVE_TYPE \
									ドア名不要 \
									0 \
									d:DEFAULT_M_TYPE \
									d:wn_機関室左舷
		#else
			#if d:ASSERT
				command assert ( d:FALSE ) 'unexpected load point'
			#endif
		#endif
	} else if( $s:登場ポイント == 大佐デモから ) {
		//$f:ロードチェックＯＮフラグ = 1
		@ステージ開始時処理（ステージ名表示） \
									d:LOAD_TYPE:NO_DOOR_TYPE \
									ドア名不要 \
									0 \
									d:DEFAULT_M_TYPE \
									d:wn_機関室左舷
	} else {
		#if d:DEBUG_PRINT
			@デバッグ用オールタナティブミッション表示
		#endif
	}



// 全マップ共通

	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		eval( $f:アイテム再セット１ = 0 )
		eval( $f:警備兵Ｅルートチェンジ_B3 = 0 )
		eval( $f:警備兵Ｅルートチェンジ_B2 = 0 )
		eval( $b:殺された兵士数 = 0 )

		#ifdef d:GERMAN_TRIAL
			eval( $f:a02a_赤外線１スイッチ破壊フラグ = 1 )
			eval( $f:a02a_赤外線２スイッチ破壊フラグ = 1 )
			eval( $f:a02a_赤外線３スイッチ破壊フラグ = 1 )
		#endif
	}

	proc 跳弾設定 {

			command 弾痕ノーマル -n 0
			command 弾痕ノーマル -n 1
			command 弾痕ノーマル -n 2
			command 弾痕ノーマル -n 3
			command 弾痕ノーマル -n 4

			command 跳弾ノーマル -n 0
			command 跳弾ノーマル -n 1
			command 跳弾ノーマル -n 2
			command 跳弾ノーマル -n 3
			command 跳弾ノーマル -n 4

			// 水蒸気パイプ
			command 弾痕ノーマル -n 5
			command 弾痕ノーマル -n 6
			command 弾痕ノーマル -n 7
			command 跳弾水蒸気小 -n 5
			command 跳弾水蒸気中 -n 6
			command 跳弾水蒸気大 -n 7

	}

	proc エンジンルームＢＧＭマネージャー設定 {
		chara ＢＧＭマネージャー ＢＧＭ -s 0x00000001

		chara ＢＧＭフェーダー エンジン音低 \
			-t /*0x07*/23 \
			-a -500,-12000,-7000 3000,5000,30000 w02a

		chara ＢＧＭフェーダー エンジン音高 \
			-t /*0x08*/24 \
			-a -500,-8000,-7000 3000,5000,30000 w02a


		command システムコールバック -active_map_change マップ変更コールバック
	}

	proc マップ変更コールバック {
		command マップ表示チェック -map エンジンルーム
		print 'map change' $1 $status
		if( $status ) {
			print 'エンジンルーム表示中'
			mesg ＢＧＭマネージャー ＢＧＭ SD_SNEAK_AUTO d:SD_AUTO_FADER2
		} else {
			print '小部屋のみ表示中'
			mesg ＢＧＭマネージャー ＢＧＭ SD_SNEAK_AUTO d:SD_AUTO_FADER1
		}
	}

/***************************************************************************************************/
// 攻撃兵
/***************************************************************************************************/
	proc 攻撃兵Ａ {
		chara アタッカー 敵兵:61 \
			-r 13 \
			-c 9 \		// 探索ルート
			-s d:ENE_STATUS_GUNLIGHT \
			-e d:ENE_EQUIP_TYPE_LIGHT_SHIELD \
			-i	($w:敵潜入視力-$w:敵兵調整値) ($w:敵危険視力-$w:敵兵調整値) ($w:敵回避視力-$w:敵兵調整値) \
			//-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
			-l $w:敵標準体力 \
			-h $w:敵標準聴力 \
			-f $w:敵標準気絶
	}

	proc 攻撃兵Ｂ {
		chara アタッカー 敵兵:62 \
			-r 14 \
			-c 10 \		// 探索ルート
			-s d:ENE_STATUS_GUNLIGHT \
			-e d:ENE_EQUIP_TYPE_LIGHT_SHIELD \
			-i	($w:敵潜入視力-$w:敵兵調整値) ($w:敵危険視力-$w:敵兵調整値) ($w:敵回避視力-$w:敵兵調整値) \
			//-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
			-l $w:敵標準体力 \
			-h $w:敵標準聴力 \
			-f $w:敵標準気絶
	}

	proc 攻撃兵Ｃ {
		chara アタッカー 敵兵:63 \
			-r 15 \
			-c 11 \		// 探索ルート
			-s d:ENE_STATUS_GUNLIGHT \
			-e d:ENE_EQUIP_TYPE_LIGHT_SHIELD \
			-i	($w:敵潜入視力-$w:敵兵調整値) ($w:敵危険視力-$w:敵兵調整値) ($w:敵回避視力-$w:敵兵調整値) \
			//-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
			-l $w:敵標準体力 \
			-h $w:敵標準聴力 \
			-f $w:敵標準気絶
	}

	proc 攻撃兵Ｄ {
		chara アタッカー 敵兵:64 \
			-r 16 \
			-c 12 \		// 探索ルート
			-s d:ENE_STATUS_GUNLIGHT \
			-e d:ENE_EQUIP_TYPE_LIGHT_SHIELD \
			-i	($w:敵潜入視力-$w:敵兵調整値) ($w:敵危険視力-$w:敵兵調整値) ($w:敵回避視力-$w:敵兵調整値) \
			//-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
			-l $w:敵標準体力 \
			-h $w:敵標準聴力 \
			-f $w:敵標準気絶
	}

	proc 攻撃兵セット {
		/*******************************************************************************************/
		// VERYEASY
		/*******************************************************************************************/
		if($w:ゲーム設定 <= d:LEVEL_VERYEASY) {
			@攻撃兵Ａ
			@攻撃兵Ｂ
			@攻撃兵Ｃ
			@攻撃兵Ｄ
		/*******************************************************************************************/
		// EASY
		/*******************************************************************************************/
		} else if($w:ゲーム設定 <= d:LEVEL_EASY) {
			@攻撃兵Ａ
			@攻撃兵Ｂ
			@攻撃兵Ｃ
			@攻撃兵Ｄ
		/*******************************************************************************************/
		// NORMAL
		/*******************************************************************************************/
		} else if($w:ゲーム設定 <= d:LEVEL_NORMAL) {
			@攻撃兵Ａ
			@攻撃兵Ｂ
			@攻撃兵Ｃ
			@攻撃兵Ｄ
		/*******************************************************************************************/
		// HARD or EXTREME  or EUROPEAN_EXTREME
		/*******************************************************************************************/
		} else {
			@攻撃兵Ａ
			@攻撃兵Ｂ
			@攻撃兵Ｃ
			@攻撃兵Ｄ
		}
	}

