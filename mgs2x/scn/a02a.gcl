	proc エンジンルーム左舷Ｂ２ビヨンド設定 {
		#if d:BY_MOTION
			// B2左奥
			trap by011 d:PLAYER \
				-mask いる \
				-button d:ACTION_BUTTON \
				-state 0,4 \	//立ち状態or張り付き
				-exec {
					@北向きビヨンド発動 $1 -16000 $4 -6000 -2500 0x00000002
					if ($? != 0) {
						eval($s:ビヨンドトラップ = $?);
					}
				}

			// 渡り橋 北壁
			#if d:TURN_ELUDE
				trap by033 d:PLAYER \
					-mask いる \
				#if d:CATCH_ACTION
					-key d:PAD_X \
				#endif
					-dir d:SOUTH 1 \
					-state d:TRP_STATE_ELUDE_FALL \
					-exec {
						if( `@エルード落下キャッチ by011 $1 -13000 -2600 $5 $6 1024 0x00000002` ) {
							print '渡り橋 北壁  by011  by033'
							chara カメラ設定 エルードキャッチカメラ \
								-c 0 \
								-b -32000,-32000,-32000 32000,32000,32000 \
								-l -32000,-32000,-32000 32000,32000,32000 \
								-r 420,1967,0 -f 2845 \
								-a 200 \
								-i 1 2 0 0 \
								-z d:CAMERA_NO_CUSHION \
								-s 1

							chara delay エルードキャッチカメラディレイ -time 60 -exec {
								@カメラＯＦＦ エルードキャッチカメラ
							}

						}
					}
			#endif

			trap by011 d:PLAYER \
				-mask いる \
				-state 6 \
				-dir 2048 256 \	//方向指定
				-exec {
					if ($s:ビヨンドトラップ  == by011) {
						chara カメラ設定 ビヨンドカメラ \
							-c 0 \
							-b -32000,-32000,-32000 32000,-4086,32000 \
							-l -32000,-32000,-32000 32000,-8000,-16250 \
							-r 638,3878,0 \
							-f 5779 \
							-a 200 \
							-i 1 -1 0 0 \
							-s 1
					}
				}
			trap by011 d:PLAYER \
				-mask ？ \
				-state 5 \
				-dir 0 256 \	//方向指定
				-exec {
					chara カメラ設定 ビヨンドカメラ \
						-c 0 \
						-b -4400,-32000,-32000 -4000,32000,32000 \
						-l -32000,-32000,-32000 32000,32000,32000 \
						-r 686,0,0 \
						-f 5907 \
						-a 200 \
						-i 3 1 0 0 \
						-s $3 \
						-z d:CAMERA_NO_CUSHION
				}

			// 落下の時に使用される
			trap by011_cam d:PLAYER \
				-mask ？ \
				-state 5 \
				-dir 0 256 \	//方向指定
				-exec {
					chara カメラ設定 強ビヨンドカメラ \
						-c 0 \
						-b -4400,-32000,-32000 -4000,32000,32000 \
						-l -32000,-32000,-32000 32000,32000,32000 \
						-r 686,0,0 \
						-f 5907 \
						-a 200 \
						-i 1 0 0 0 \
						-s $3 \
						-z d:CAMERA_NO_CUSHION
				}

		//////////////
		// B2左サイド1
			trap by012 d:PLAYER \
				-mask いる \
				-button d:ACTION_BUTTON \
				-state 0,4 \	//立ち状態or張り付き
				-exec {
					@東向きビヨンド発動 $1 -3750 $6 -10750 -9250 0x00000002
					if ($? != 0) {
						eval($s:ビヨンドトラップ = $?);
					}
				}

			// すきま部分 南
			#if d:TURN_ELUDE
				trap by033 d:PLAYER \
					-mask いる \
				#if d:CATCH_ACTION
					-key d:PAD_X \
				#endif
					-dir d:WEST 1 \
					-state d:TRP_STATE_ELUDE_FALL \
					-exec {
						if( `@エルード落下キャッチ by012 $1 -13000 -2600 $5 $6 1024 0x00000002` ) {
							print 'すきま部分 南  by012 by033'
							chara カメラ設定 エルードキャッチカメラ \
