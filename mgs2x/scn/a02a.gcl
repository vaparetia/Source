///////////////////
// 左舷クリアリング
	proc 左舷Ｂ３クリアリング初期設定 {
		print '**************************************************************************'
		print '**************************************************************************'
		print '**************************************************************************'

		command rand 6

		if( $status == 0 ){
			print '左舷Ｂ３クリアリング初期設定 1'
			command セットクリアリング \
				-p	1,0,2,クリアリングカメラ_1_0_1 \
					1,0,7,クリアリングカメラ_1_0_2 \
					1,0,9,クリアリングカメラ_1_0_3 \
				-i	0,1,2,3
		} else if( $status == 1 ) {
			print '左舷Ｂ３クリアリング初期設定 2'
			command セットクリアリング \
				-p	1,4,2,クリアリングカメラ_1_0_1 \
					1,4,7,クリアリングカメラ_1_0_2 \
					1,4,9,クリアリングカメラ_1_0_3 \
				-i	4,1,2,3
		} else if( $status == 2 ) {
			print '左舷Ｂ３クリアリング初期設定 3'
			command セットクリアリング \
				-p	1,5,2,クリアリングカメラ_1_0_1 \
					1,5,9,クリアリングカメラ_1_2_2 \
					1,6,5,クリアリングカメラ_1_2_3 \
					1,6,9,クリアリングカメラ_1_2_4 \
				-i	5,6,2,3
		} else if( $status == 3 ) {
			print '左舷Ｂ３クリアリング初期設定 4'
			command セットクリアリング \
				-p	1,7,2,クリアリングカメラ_1_0_1 \
					1,7,7,クリアリングカメラ_1_3_1 \
					1,7,8,クリアリングカメラ_1_3_2 \
					1,6,5,クリアリングカメラ_1_2_3 \
					1,6,9,クリアリングカメラ_1_2_4 \
				-i	7,6,2,3
		} else if( $status == 4 ) {
			print '左舷Ｂ３クリアリング初期設定 5'
			command セットクリアリング \
				-p	1,7,2,クリアリングカメラ_1_0_1 \
					1,7,7,クリアリングカメラ_1_3_1 \
					1,7,8,クリアリングカメラ_1_3_2 \
					1,8,5,クリアリングカメラ_1_2_3 \
					1,8,9,クリアリングカメラ_1_3_4 \
				-i	7,8,2,3
		} else if( $status == 5 ) {
			print '左舷Ｂ３クリアリング初期設定 6'
			command セットクリアリング \
				-p	1,9,2,クリアリングカメラ_1_0_1 \
					1,9,7,クリアリングカメラ_1_5_1 \
					1,9,12,クリアリングカメラ_1_5_3 \
					1,9,16,クリアリングカメラ_1_5_4 \
				-i	9,10,2,3
		}
	}

