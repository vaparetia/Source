/*******************************************************************************************************/
// デバッグキャラ
/*******************************************************************************************************/
proc デバッグキャラセット {
#if d:MY_DEBUG
	//chara スクリーンショット shot

	chara USBキーボード実行 test \
		-e d:KPD_0 {
				   } \
		-e d:KPD_MINUS {
						//mesg あたり付き人形 メリル人形 ルートノードワープ 5 0
						mesg ルートデモ人形 メリル人形 ルート変更 3
				   } \
		-e d:KPD_PLUS {
						//mesg あたり付き人形 メリル人形 ルートノードワープ 4 0
						mesg ルートデモ人形 メリル人形 ルート変更 4
				   } \
		-e d:KPD_1 {	mesg プレイヤー d:PLAYER position -2000 -12000 6000 } \
		-e d:KPD_2 {	mesg プレイヤー d:PLAYER position -10000 -3972 -10932 } \
		-e d:KPD_3 {	mesg プレイヤー d:PLAYER position -5750 -12000 1250 } \
		-e d:KPD_4 {	mesg プレイヤー d:PLAYER position -11000 -4000 -20750 } \
		-e d:KPD_5 {	mesg プレイヤー d:PLAYER position 6500 -11000 -2500 } \
		-e d:KPD_6 {
						#if d:REPAIR
							print '*************************************************'
							@修理兵用位置チェック全員
						#endif
				   } \
		//-e d:KPD_7	{	eval( $b:カメラ変更テストフラグ = 7 ) } \
		//-e d:KPD_8	{	eval( $b:カメラ変更テストフラグ = 8 ) } \
		-e d:KPD_9	{
						print 'イベントフラグ = ０'
						eval( $f:w02a_ドア修理イベント = 0 )
						command varsave $f:w02a_ドア修理イベント

						eval( $f:w02a_レイブンイベントフラグ = 0 )
						command varsave $f:w02a_レイブンイベントフラグ

						eval( $f:w02a_シナリオ警戒体制変更フラグ = 0 )
						command varsave $f:w02a_シナリオ警戒体制変更フラグ

						eval( $f:落っこち兵見たフラグ = 0 )
						command varsave $f:落っこち兵見たフラグ
					} \
		-e d:KBD_ESC{	mesg 臨時顔アニメキャラ アニメキャラ モーション再生 normal 30
						mesg delay カメラディレイ kill
						mesg 臨時顔アニメキャラ アニメキャラ 視線変更 -1
						mesg 遠景ぼかし 遠景ぼかし１ off
						mesg 遠景ぼかし 遠景ぼかし２ off
						mesg 遠景ぼかし 遠景ぼかし３ off
						mesg 近景ぼかし 近景ぼかし１ off
						mesg 近景ぼかし 近景ぼかし２ off
						mesg 近景ぼかし 近景ぼかし３ off
					} \
		-e d:KBD_RIGHT {
						mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 90 \
								($i:プレイヤー位置Ｘ+1000),($i:プレイヤー位置Ｙ-200),($i:プレイヤー位置Ｚ+3000)
					} \
		-e d:KBD_LEFT {
						mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 90 \
								($i:プレイヤー位置Ｘ-1000),($i:プレイヤー位置Ｙ-200),($i:プレイヤー位置Ｚ+3000)
					} \
		-e d:KBD_UP {
						mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 90 \
								($i:プレイヤー位置Ｘ+3000),($i:プレイヤー位置Ｙ-200),($i:プレイヤー位置Ｚ+1000)
					} \
		-e d:KBD_DOWN {
						mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 90 \
								($i:プレイヤー位置Ｘ+3000),($i:プレイヤー位置Ｙ-200),($i:プレイヤー位置Ｚ-1000)
					} \
		-e d:KBD_F1 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_speech_a 30 } \
		-e d:KBD_F2 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_speech_i 30 } \
		-e d:KBD_F3 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_speech_u 30 } \
		-e d:KBD_F4 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_speech_e 30 } \
		-e d:KBD_F5 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_speech_o 30 } \
		-e d:KBD_F6 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_speech_n 30 } \
		-e d:KBD_F7 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_teeth 30 } \
		-e d:KBD_F8 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_scream 0 } \
		-e d:KBD_F9 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_relax 30 } \
		-e d:KBD_F10 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_surprise 30 } \
		-e d:KBD_F11 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_sigh 30 } \
		-e d:KBD_F12 { mesg 臨時顔アニメキャラ アニメキャラ 視線変更 2 } \
		-e d:KBD_Q { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_tension 30 } \
		-e d:KBD_W {
					  chara delay カメラディレイ \
						-time 1 \
						-exec {
							mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_exciting 30
							return 60
						}
					} \
		-e d:KBD_E { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_pain 30 } \
		-e d:KBD_R { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_T12a1D71 30 } \
		-e d:KBD_T {
						mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 120 -7707,-3929,-14119
						chara delay カメラディレイ \
							-time 90 \
							-exec {
								mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 60 6710,-3960,-18261
							}
					} \
		-e d:KBD_Y {
					mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_sneeze 0
					//mesg プレイヤー d:PLAYER motion d:モーションリスト:sna_m9_behind_squat_r_sneez_e3 \
					//	 -1 -1 -1 0x00000004
				 } \
		-e d:KBD_U { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_teeth 40
					  chara delay カメラディレイ \
						-time 20 \
						-exec {
								mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_speech_e 40
						}
					  chara delay カメラディレイ \
						-time 40 \
						-exec {
								mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_teeth 40
						}
					} \
		-e d:KBD_I { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_teeth 50
					  chara delay カメラディレイ \
						-time 40 \
						-exec {
								mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_relax 35
						}
					  chara delay カメラディレイ \
						-time 50 \
						-exec {
								mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_speech_e 35
						}
					  chara delay カメラディレイ \
						-time 60 \
						-exec {
								mesg 臨時顔アニメキャラ アニメキャラ モーション再生  normal 35
						}
					} \
		-e d:KBD_O {
						mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 90 \
								($i:プレイヤー位置Ｘ-1000),($i:プレイヤー位置Ｙ-200),($i:プレイヤー位置Ｚ+3000)
						chara delay カメラディレイ \
							-time 90 \
							-exec {
								mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 90 \
								($i:プレイヤー位置Ｘ+1000),($i:プレイヤー位置Ｙ-200),($i:プレイヤー位置Ｚ+3000)
							}
						chara delay カメラディレイ \
							-time 180 \
							-exec {
								mesg 臨時顔アニメキャラ アニメキャラ 視線変更 -1
							}
					} \
		-e d:KBD_P {
					  chara delay カメラディレイ \
						-time 1 \
						-exec {
							command ゲット敵兵座標 敵兵:01 $i:敵兵Ｘ $i:敵兵Ｙ $i:敵兵Ｚ
							mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 5 $i:敵兵Ｘ $i:敵兵Ｙ $i:敵兵Ｚ
							return 5
						}
					} \
		-e d:KBD_L {
						mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_teeth 40
						chara delay カメラディレイ \
							-time 20 \
							-exec {
									mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_tension 30
							}
					} \
		-e d:KBD_Z{
				mesg 静止スポットライト設置 右舷B1ライト off
				mesg 静止スポットライト設置 右舷B2ライト off
				mesg 静止スポットライト設置 右舷B3ライト off
				mesg 静止スポットライト設置 左舷B2階段ライト off
				mesg 静止スポットライト設置 左舷B2ライト off
				mesg 静止スポットライト設置 左舷B1ライト off
			} \
		-e d:KBD_N{
				mesg 静止スポットライト設置 右舷B1ライト on
				mesg 静止スポットライト設置 右舷B2ライト on
//					mesg 静止スポットライト設置 右舷B3ライト on
				mesg 静止スポットライト設置 左舷B2階段ライト on
				mesg 静止スポットライト設置 左舷B2ライト on
				mesg 静止スポットライト設置 左舷B1ライト on
			} \
		-e d:KBD_X { mesg 静止スポットライト設置 右舷B1ライト on } \
		-e d:KBD_C { mesg 静止スポットライト設置 左舷B2ライト on } \
		-e d:KBD_V { mesg 静止スポットライト設置 左舷B1ライト on } \
		-e d:KBD_B { mesg 静止スポットライト設置 右舷B2ライト on } \
		-e d:KBD_A { mesg 警備兵 敵兵:03 ルート変更 17 -2000,-13000,4000 エンジンルーム } \
		-e d:KBD_S { mesg 警備兵 敵兵:04 ルート変更 18 -5000,-9000,-7000 エンジンルーム } \
		-e d:KBD_D { mesg 警備兵 敵兵:01 ルート変更 11 11450,-9000,-8000 エンジンルーム } \
		-e d:KBD_F { mesg 警備兵 敵兵:02 ルート変更 8 5450,-9000,-5480 エンジンルーム } \
		-e d:KBD_G { mesg 警備兵 敵兵:04 ルート変更 19 -5000,-9000,-7000 エンジンルーム } \
		-e d:KBD_1 { mesg 遠景ぼかし 遠景ぼかし１ on } \
		-e d:KBD_2 { mesg 遠景ぼかし 遠景ぼかし２ on } \
		-e d:KBD_3 { mesg 遠景ぼかし 遠景ぼかし３ on } \
		-e d:KBD_4 { mesg 近景ぼかし 近景ぼかし１ on } \
		-e d:KBD_5 { mesg 近景ぼかし 近景ぼかし２ on } \
		-e d:KBD_6 { mesg 近景ぼかし 近景ぼかし３ on } \
		-e d:KBD_0 { restart } \
		-e d:KBD_END { mesg Ｃ４ Ｃ４ bomb }
#endif
}


/*******************************************************************************************************/
// ＴＧＳ２０００Ｆ用
/*******************************************************************************************************/
#ifdef d:TGS2001F || d:EU_TRIAL
	proc ＴＧＳ版クリアしました {
		command 無線設定 -reset
		command メニュー設定 -menu off -gage off -radar off -subwin off
		//command パッド操作 -release
		command プレイヤー無敵セット
		mesg コマンダー 敵兵セット 視界オフ
		mesg コマンダー 敵兵セット 聴力オフ

		command セットサウンドコード -c d:SNG_FOUTS_S

		mesg プレイヤー d:PLAYER run -16750 -5000 -35000 \
			1 \ // 走り移動
			2048 \
			0 \ // フラグ(FA_NO_WEAPON)
			ＴＧＳ版クリア移動終了

	}

	proc ＴＧＳ版クリア移動終了 {
		eval( $f:TGS2001F_コンティニューフラグ = 1 )
		command varsave $f:TGS2001F_コンティニューフラグ
		restart
	}

	proc ＴＧＳ２００１Ｆコンティニュー {
		chara トゥービーコンテニュード to_be_continued \
			-proc タイトルへ戻る
	}

	proc タイトルへ戻る {
		print 'タイトルへ戻る'
		@mv_init_n_title_0
	}
#endif


