	proc Ｃ４誘爆 {

		command StreamStopAll

		command セットサウンドコード -c d:SNG_FOUTS_S		//ＢＧＭフェードアウト

		mesg コマンダー 敵兵セット 視界オフ

		eval($w:Ｃ４爆発用ディレイ = 0)

		mesg トラップ専用C4 誘爆用Ｃ４_１ on
		chara delay ディレイ -time 10 -exec {

			if($w:Ｃ４爆発用ディレイ == 0){
				mesg トラップ専用C4 誘爆用Ｃ４_２ on
				eval($w:Ｃ４爆発用ディレイ = 1)
				return 15

			}else if($w:Ｃ４爆発用ディレイ == 1){
				mesg トラップ専用C4 誘爆用Ｃ４_３ on
				eval($w:Ｃ４爆発用ディレイ = 2)
				return 16

			}else if($w:Ｃ４爆発用ディレイ == 2){
				mesg トラップ専用C4 誘爆用Ｃ４_４ on
				eval($w:Ｃ４爆発用ディレイ = 3)
				return 10

			}else if($w:Ｃ４爆発用ディレイ == 3){
				mesg トラップ専用C4 誘爆用Ｃ４_５ on
				eval($w:Ｃ４爆発用ディレイ = 4)
				return 22

			}else if($w:Ｃ４爆発用ディレイ == 4){
				mesg トラップ専用C4 誘爆用Ｃ４_６ on
				eval($w:Ｃ４爆発用ディレイ = 5)
				return 31
			}else if($w:Ｃ４爆発用ディレイ == 5){
				mesg トラップ専用C4 誘爆用Ｃ４_７ on
				eval($w:Ｃ４爆発用ディレイ = 6)
				return 25

			}else if($w:Ｃ４爆発用ディレイ == 6){
				mesg トラップ専用C4 誘爆用Ｃ４_８ on
				eval($w:Ｃ４爆発用ディレイ = 7)
				return 22

			}else if($w:Ｃ４爆発用ディレイ == 7){
				mesg トラップ専用C4 誘爆用Ｃ４_９ on
				eval($w:Ｃ４爆発用ディレイ = 8)
				return 16

			}else if($w:Ｃ４爆発用ディレイ == 8){
				mesg トラップ専用C4 誘爆用Ｃ４_１０ on
				eval($w:Ｃ４爆発用ディレイ = 9)
				return 20

			}else if($w:Ｃ４爆発用ディレイ == 9){
				mesg トラップ専用C4 誘爆用Ｃ４_１１ on
				eval($w:Ｃ４爆発用ディレイ = 10)
				return 10

			}else if($w:Ｃ４爆発用ディレイ == 10){
				mesg トラップ専用C4 誘爆用Ｃ４_１２ on
				eval($w:Ｃ４爆発用ディレイ = 11)
				return 25

			}else if($w:Ｃ４爆発用ディレイ == 11){
				mesg トラップ専用C4 誘爆用Ｃ４_１３ on
				eval($w:Ｃ４爆発用ディレイ = 12)
				return 32

			}else if($w:Ｃ４爆発用ディレイ == 12){
				mesg トラップ専用C4 誘爆用Ｃ４_１４ on
				eval($w:Ｃ４爆発用ディレイ = 13)
				return 121

			}else if($w:Ｃ４爆発用ディレイ == 13){
				print '最後のｃ４爆発'
				mesg トラップ専用C4 誘爆用Ｃ４_１５ on
				eval($w:Ｃ４爆発用ディレイ = 14)
				return 0
			}
		}
	}


	proc 敵兵もセンサーに引っかかる処理暫定 {
		trap en403 ？ \
			-mask 入る \
			-exec {
				if( ($2 != d:PLAYER) && ( $f:a02a_赤外線１スイッチ破壊フラグ == 0 ) ){
					print '敵兵が赤外線を横切った'
					@C4誤射即死
				}
			}
		trap en404 ？ \
			-mask 入る \
			-exec {
				if( ($2 != d:PLAYER) && ( $f:a02a_赤外線２スイッチ破壊フラグ == 0 ) ){
					@C4誤射即死
				}
			}
		trap en405 ？ \
			-mask 入る \
			-exec {
				if( ($2 != d:PLAYER) && ( $f:a02a_赤外線３スイッチ破壊フラグ == 0 ) ){
					@C4誤射即死
				}
			}
	}

	#endif


	// 各種カメラの設定
	// ------------------------------------
	proc 左舷小部屋カメラ設定 {
		#if d:STAGE_CAMERA
			// 左舷通路
			trap c024 d:PLAYER \
				-mask ＊ \
				-camera \
				-exec {
					if ($w:アラートモード == 0) {
						eval( $i:スライド距離 = 4000 );
					} else {
						eval( $i:スライド距離 = 7500 );
					}

					if ($6 > -14000) {
						@CS_スムーズカメラ降順 $6 -10000 -14000 937 400
					} else {
						@CS_スムーズカメラ降順 $6 -14000 -19500 400 200
					}
					eval( $i:補完ＲＸ = $i:CS_結果１ );

					@CS_スムーズカメラ降順 $6 -16000 -19000 2048 2180
	 				eval( $i:補完ＲＹ = $i:CS_結果１ );

					@CS_スムーズカメラ降順 $6 -10000 -14000 3000 4000
					eval( $w:補完距離 = $i:CS_結果１ );

					chara カメラ設定 通路カメラ１ \
						-c 0 \
						-b -10000,/*-32000*/-3000,-32000 -9300,0,-10250 \
						-l -9750,-4000,-32000 -9300,32000,-11000 \
						-r $i:補完ＲＸ,$i:補完ＲＹ,0 \
						-f $w:補完距離 \
						-a 200 \
						-i 0 -1 0 0 \
						-slide 1 10 7500 $i:スライド距離 100 \
						-s $3
				}

			// 左舷小部屋
			trap c025 d:PLAYER \
				-mask ＊ \
				-camera \
				-exec {

					@CS_スムーズカメラ昇順 $6 -24500 -21000 236 836
						eval( $i:補完ＲＸ = $i:CS_結果１ );

					@CS_スムーズカメラ昇順 $6 -24500 -21000 6000 6457
						eval( $w:補完距離 = $i:CS_結果１ );

					chara カメラ設定 小部屋カメラ \
						-c 0 \
						-b -16205,-1526,-20376 -11202,32000,-20376 \
						-l -16205,-3651,-32000 -11202,32000,-22212 \
						-r $i:補完ＲＸ,2048,0 -f $w:補完距離 \
						-a 200 \
						-i 0 -1 0 0 \
						-s $3
					/*
					-p -16205,-1526,-20376 -t -16205,-3651,-24385 \
					-r 236,2048,0 -f 6000 \
					-a 200 \
					*/
				}

			trap c025_2 d:PLAYER \
				-mask ＊ \
				-camera \
				-exec {
					chara カメラ設定 小部屋カメラ \
						-c 0 \
						-b -16746,-1926,-32000 -16746,32000,32000 \
						-l -16746,-3651,-32000 -16746,32000,32000 \
						-r 236,2048,0 -f 4872 \
						-a 200 \
						-i 2 2 0 0 \
						//-z d:CAMERA_NO_CUSHION \
						-s $3
				}
		#endif
	}



// エンジンルーム部分
	// マップ切り替えトラップ
	// ------------------------------------
	proc エンジン／底マップ切り替え {
		trap dr005 d:PLAYER \
			-mask ？ \
			-exec {
					if($3==入る){
						mesg マップ接合 エンジン／底 on
					}else{
						mesg マップ接合 エンジン／底 off
					}
			}
	}

