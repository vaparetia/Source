								[ dogtag:tnk_w02a_guard_ha_06 ] \
								[ dogtag:tnk_w02a_guard_vh_06 ]
	}

	proc ドア修理兵 $:名前{
		#if d:REPAIR
			chara 警備兵 $:名前 \
				-r 36 \
				-n 0 \
				-d d:ENE_DEF_X_7 d:ENE_DEF_Y_7 d:ENE_DEF_Z_7 左舷居住区Ｂ１ \
				//-s d:ENE_STATUS_GUNLIGHT \	// ドア修理兵はライトがめり込むのでＯＦＦ
				-i	($w:敵潜入視力-$w:敵兵調整値) ($w:敵危険視力-$w:敵兵調整値) ($w:敵回避視力-$w:敵兵調整値) \
				-l $w:敵標準体力 -f $w:敵標準気絶 -h ($w:敵標準聴力-$w:敵兵調整値) \
				-w ドア修理兵何かに気づいた \
				-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
				-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
				-j ドッグタグ_敵兵	[ dogtag:tnk_w02a_guard_ve_07 ] \
									[ dogtag:tnk_w02a_guard_ea_07 ] \
									[ dogtag:tnk_w02a_guard_no_07 ] \
									[ dogtag:tnk_w02a_guard_ha_07 ] \
									[ dogtag:tnk_w02a_guard_vh_07 ]
		#endif
	}

	proc ドア修理兵何かに気づいた {
		print '私、気づきました'

		chara delay 修理兵何かに気づいたディレイ -time 60 -exec {
			@修理デモキャンセル
			mesg 警備兵 ドア修理兵 ルート変更 38 -12500,0,-18750 左舷居住区Ｂ１
		}

	}

	proc 警備兵セット {
		/*******************************************************************************************/
		// VERYEASY
		/*******************************************************************************************/
		if($w:ゲーム設定 <= d:LEVEL_VERYEASY) {
			@警備兵Ａ 敵兵:01
			@警備兵Ｃ 敵兵:03 17
			//@警備兵Ｄ 敵兵:04

			// 落っこち兵 初めてステージに来た時だけ設定する
			//if( $f:w02a_レイブンイベントフラグ == 0 ) {
			if( $f:落っこち兵見たフラグ == 0 ) {
				@落っこちぶつかり兵 敵兵:02
				@落下兵 敵兵:06
			}else{
				@警備兵Ｂ 敵兵:02
			}

			// ドア修理イベントがまだなら
			if( $f:w02a_ドア修理イベント == 0 ) {
				@ドア修理兵 ドア修理兵
			}
		/*******************************************************************************************/
		// EASY
		/*******************************************************************************************/
		} else if($w:ゲーム設定 <= d:LEVEL_EASY) {
			@警備兵Ａ 敵兵:01
			@警備兵Ｃ 敵兵:03 17
			@警備兵Ｄ 敵兵:04

			// 落っこち兵 初めてステージに来た時だけ設定する
			//if( $f:w02a_レイブンイベントフラグ == 0 ) {
			if( $f:落っこち兵見たフラグ == 0 ) {
				@落っこちぶつかり兵 敵兵:02
				@落下兵 敵兵:06
			}else{
				@警備兵Ｂ 敵兵:02
			}

			// ドア修理イベントがまだなら
			if( $f:w02a_ドア修理イベント == 0 ) {
				@ドア修理兵 ドア修理兵
			}
		/*******************************************************************************************/
		// NORMAL
		/*******************************************************************************************/
		} else if($w:ゲーム設定 <= d:LEVEL_NORMAL) {



			// ドア修理イベントがまだなら
			if( $f:w02a_ドア修理イベント == 0 ) {
				@ドア修理兵 ドア修理兵
			}

			// 落っこち兵 初めてステージに来た時だけ設定する
			//if( $f:w02a_レイブンイベントフラグ == 0 ) {
			if( $f:落っこち兵見たフラグ == 0 ) {
				@落っこちぶつかり兵 敵兵:02
				@落下兵 敵兵:06
			}else{
				@警備兵Ｂ 敵兵:02
			}

			@警備兵Ａ 敵兵:01
			@警備兵Ｃ 敵兵:03 17
			@警備兵Ｄ 敵兵:04
			@警備兵Ｅ 敵兵:05

		/*******************************************************************************************/
		// HARD
		/*******************************************************************************************/
		} else if($w:ゲーム設定 <= d:LEVEL_HARD) {
			@警備兵Ａ 敵兵:01
			@警備兵Ｃ 敵兵:03 40
			@警備兵Ｄ 敵兵:04
			@警備兵Ｅ 敵兵:05

			// 落っこち兵 初めてステージに来た時だけ設定する
			//if( $f:w02a_レイブンイベントフラグ == 0 ) {
			if( $f:落っこち兵見たフラグ == 0 ) {
				@落っこちぶつかり兵 敵兵:02
				@落下兵 敵兵:06
			}else{
				@警備兵Ｂ 敵兵:02
			}

			// ドア修理イベントがまだなら
			if( $f:w02a_ドア修理イベント == 0 ) {
				@ドア修理兵 ドア修理兵
			}
		/*******************************************************************************************/
		// EXTREME or EUROPEAN_EXTREME
		/*******************************************************************************************/
		} else {
			@警備兵Ａ 敵兵:01
			@警備兵Ｃ 敵兵:03 41
			@警備兵Ｄ 敵兵:04
			@警備兵Ｅ 敵兵:05

			// 落っこち兵 初めてステージに来た時だけ設定する
			//if( $f:w02a_レイブンイベントフラグ == 0 ) {
			if( $f:落っこち兵見たフラグ == 0 ) {
				@落っこちぶつかり兵 敵兵:02
				@落下兵 敵兵:06
			}else{
				@警備兵Ｂ 敵兵:02
			}

			// ドア修理イベントがまだなら
			if( $f:w02a_ドア修理イベント == 0 ) {
				@ドア修理兵 ドア修理兵
			}
		}
	}

/***************************************************************************************************/
// 各コマンダー設定
/***************************************************************************************************/
	proc 警備兵コマンダー {
		chara 警備コマンダー wccomm -e 警備兵セット
	}

	proc 攻撃兵コマンダー {
		chara 攻撃コマンダー atcomm -e 攻撃兵セット
	}

//	#endif

	proc コマンダー設定 {

		// 敵兵の視界、聴覚を調整する
		if ($w:ゲーム設定 >= d:LEVEL_HARD) {
			eval( $w:敵兵調整値 = 2500 )
		} else {
			eval( $w:敵兵調整値 = 1500 )
		}

		// レイブンイベントを見る前は必ず潜入モードにしておく
		if ( $f:w02a_レイブンイベントフラグ == 0 ){
			eval($w:スタートアラートモード = d:ALERT_MODE_SENNYU)
		}

		chara コマンダー 敵兵セット \
			-w 警備兵コマンダー \
			-a 攻撃兵コマンダー \
			-m $w:スタートアラートモード \
			-r	12500,0,-15500 右舷居住区Ｂ１ \
			-c 12500,0,-15500 右舷居住区Ｂ１ \
			-p	0,-1,-1,右舷Ｂ３クリアリング初期設定 \
				1,-1,-1,左舷Ｂ３クリアリング初期設定 \
				2,-1,-1,左舷小部屋クリアリング初期設定 \
				3,-1,-1,右舷小部屋クリアリング初期設定 \
				-2,-2,-2,クリアリングカメラＯＦＦ \
			-b $w:敵標準再発生数 \ // 生き返る敵兵数
			-z $i:敵標準麻酔持続 \
			-h $i:標準警戒時間 \
			-o $i:敵標準気絶持続 \
			-x [ghq_area_alert_voice:w02a] \
			-y [ghq_caution_voice:w02a] \
			-v [ene_tank_voice:01] \
			-e  43 0  ポイント１ \
				43 1  ポイント２ \
				43 2  無線終了 \
				37 10 ドア修理兵小部屋巡回終了 \
				38 0  ドア修理兵消滅ポイント到着 \
				42 0  落下兵消えなさい \
			-f 43 0 t:vc045082 t:vc045082_len \
			   43 1 t:vc045012 t:vc045012_len

		if( $f:w02a_ドア修理イベント == 0 ) {
			mesg 敵兵共通 ドア修理兵 永久アンリアルＯＮ
		}
	}

	proc ポイント１ {
		print '**********ポイント１**********'
	}

	proc ポイント２ {
		print '**********ポイント２**********'
	}

	proc 無線終了 {
		print '**********無線終了しました**********'
		mesg 警備兵 ドア修理兵 アクション終了
		mesg 警備兵 ドア修理兵 ルート変更 37 -12500,0,-18750 左舷居住区Ｂ１ 0
	}
	proc ドア修理兵小部屋巡回終了 {
		print '**********ドア修理兵小部屋巡回終了**********'
		eval( $f:w02a_ドア修理イベント中 = 0 )
		mesg 警備兵 ドア修理兵 アクション終了
		mesg 警備兵 ドア修理兵 ルート変更 38 -12500,0,-18750 左舷居住区Ｂ１
		mesg プロック連続実行 ドア修理兵異常ルート検査 kill
	}

	proc ドア修理兵消滅ポイント到着 {
		print '**********ドア修理兵消えなさい**********'
		mesg 敵兵共通 ドア修理兵 永久アンリアルＯＮ
	}

/***************************************************************************************************/
// 敵兵ルートチェンジ
/***************************************************************************************************/
	proc 敵兵ルートチェンジ {

		trap en205 d:PLAYER \
			-mask 入る \
			-exec {
				if($w:ゲーム設定 >= /*d:LEVEL_HARD*/d:LEVEL_NORMAL) {
					if( $f:警備兵Ｅルートチェンジ_B3 == 0 ) {
						eval( $f:警備兵Ｅルートチェンジ_B3 = 1 )
						eval( $f:警備兵Ｅルートチェンジ_B2 = 0 )
						mesg 警備兵 敵兵:05 ルート変更 30 -9300,-5000,-18648 左舷小部屋 0
					}
				}
			}

		trap en201 d:PLAYER \
			-mask 入る \
			-exec {
				if($w:ゲーム設定 >= /*d:LEVEL_HARD*/d:LEVEL_NORMAL) {
					if( $f:警備兵Ｅルートチェンジ_B2 == 0 ) {
						eval( $f:警備兵Ｅルートチェンジ_B2 = 1 )
						eval( $f:警備兵Ｅルートチェンジ_B3 = 0 )
						mesg 警備兵 敵兵:05 ルート変更 31 -9300,-5000,-18648 左舷小部屋 0
					}
				}
			}



	///////////////////////////////////////////////////////////
	// スネークが左舷小部屋に入った時のアタッカーの初期位置変更
		trap en402 d:PLAYER \
				-mask 入る \
				-exec {
					mesg アタッカー 敵兵:61 ルート変更 (1-1)
					mesg アタッカー 敵兵:62 ルート変更 (1-1)
					mesg アタッカー 敵兵:63 ルート変更 (1-1)
					mesg アタッカー 敵兵:64 ルート変更 (1-1)
				}

	/////////////////////
	// 双眼鏡兵ルート変更
	/*
		trap en201 d:PLAYER \
			-mask 入る \
			-exec {
				mesg 警備兵 敵兵:03 ルート変更 18 -500,-9000,5500 エンジンルーム 0
		}
	*/

	/////////////////////
	// コンボ兵関連の設定

		// コンボ下敷き兵ルートチェンジ
		trap en202 d:PLAYER \
			-mask 入る \
			-exec {
				mesg 警備兵 敵兵:02 ルート変更 (7-1) 12000,-9000,-2000 エンジンルーム 0
		}

		// コンボ兵
		trap en203 敵兵:06 \
			-mask 入る \
			-exec {
				eval( $f:落っこち兵カメラ中 = 1 )

				chara delay カメラディレイ -time 15 -exec {
					eval( $i:Ｙ座標変数 = -3500 )
					chara プロック連続実行 落っこち連続処理 -time 60 -exec {
						if( $f:落っこち兵カメラ中 == 1 ) {
							eval( $i:Ｙ座標変数  = ($i:Ｙ座標変数 - ( 8000 / 60 )) )

							chara カメラ設定 シナリオカメラ \
								-c 1 \
								-p 4734,$i:Ｙ座標変数,-13733 -t 6691,($i:Ｙ座標変数-579),-19689 \
								-r 60,1841,0 -f 6296 \
								-a 200 \
								-i 0 0 0 0 \
								-s 1
						}
					}

					chara プロック連続実行 落っこち連続処理チェック -time 150 -exec {
						// スネークが範囲外に行ったらＯＦＦ
						if( ($i:プレイヤー位置Ｘ > 8000) || \
							($i:プレイヤー位置Ｘ < 6000) || \
							($i:プレイヤー位置Ｚ < -20000) || \
							($i:プレイヤー位置Ｚ > -17000) ) {
							mesg プロック連続実行 落っこち連続処理 kill
							mesg プロック連続実行 落っこち連続処理チェック kill
							@カメラＯＦＦ シナリオカメラ
							eval( $f:落っこち兵カメラ中 = 0 )
						}
					} -end_exec {
						@カメラＯＦＦ シナリオカメラ
					}
				}
		}
/*
		// スネークがエリア外に出たらシナリオカメラをＯＦＦする
		trap en204 d:PLAYER \
			-mask 出る \
			-exec {
				print 'Out'
				eval( $f:落っこち兵カメラ中 = 0 )
				mesg delay カメラディレイ kill
				@カメラＯＦＦ シナリオカメラ
			}
*/
		// 落下兵帰りなさい
		trap en206 d:PLAYER \
			-mask 入る \
			-exec {
				mesg 警備兵 敵兵:06 ルート変更 42 d:ENE_DEF_X_6 d:ENE_DEF_Y_6 d:ENE_DEF_Z_6 右舷居住区Ｂ１ 0
			}
	}

	proc 落下兵消えなさい {
		print '落下兵 さようなら'
		mesg 敵兵共通 敵兵:06 永久アンリアルＯＮ
	}

	/*
	proc 落下兵の欠伸コントロール {
		trap dr002 d:PLAYER \
			-mask ？ \
			-exec {
				if($3==入る){
					if( ($4 > 8250) && ($f:落っこち兵見たフラグ == 0)) {
						print '欠伸始める'
						// 欠伸始める
						mesg 警備兵 敵兵:06 ルート変更 20 d:ENE_DEF_X_6 d:ENE_DEF_Y_6 d:ENE_DEF_Z_6 右舷居住区Ｂ１ 0
					}
				}else{
					if( ($4 > 8250) && ($f:落っこち兵見たフラグ == 0)) {
						print '欠伸止める'
						// 欠伸止める
						mesg 警備兵 敵兵:06 ルート変更 44 d:ENE_DEF_X_6 d:ENE_DEF_Y_6 d:ENE_DEF_Z_6 右舷居住区Ｂ１ 0
					}
				}
			}
	}
