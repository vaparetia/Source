	//command メニュー設定 -radar off



	proc 落っこち兵のフラグセーブ {
		if( $f:落っこち兵見たフラグ == 0 ) {

			//command システムコールバック -dead 落っこち兵フラグをセーブしました
			command システムコールバック -continue 落っこち兵フラグをセーブしました
		}

		command システムコールバック -load 落っこち兵フラグセーブチェック
	}

	proc 落っこち兵フラグをセーブしました {
		print '落っこち兵見たフラグをセーブしました'
		@コンティニュー処理
		eval( $f:落っこち兵見たフラグ = 1 )
		command varsave $f:落っこち兵見たフラグ
	}

	proc 落っこち兵フラグセーブチェック {
		eval( $f:落っこち兵見たフラグ = 1 )
		//command varsave $f:落っこち兵見たフラグ
