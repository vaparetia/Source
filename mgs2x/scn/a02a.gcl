	// レイブン用スポットライト
	// ------------------------------------
	proc 右舷小部屋スポットライト設定 {
		#if d:SPOT_LIGHT
		#if d:VALCAN
			chara スポットライト投影モデル レイブンライト \
				-m w02a0_s_rave \
				-p 0,0,0

			chara 静止スポットライト設置 レイブンライト \
				-pos 13875,-4946,-20404 \
				-dir -160,-1670,0 \
				-range 10000 \
				-angle 36 \
				-color 55,110,123 \
				-option 0x0031

		#endif
		#endif
	}

	proc 右舷小部屋影用ハザード {
		#if d:SPOT_LIGHT
			//スポットライト投影ハザード
			command スポットライト投影ハザード \
				-name 右舷小部屋 \
				-group 4
		#endif
	}

	// オブジェ
	// ------------------------------------
	proc レイブン設置 {
		#if d:VALCAN
			@壊れ物再セットチェック $b:w02a_懐中電灯破壊チェック

			if($f:再セットフラグ) {
				eval( $f:w02a_懐中電灯破壊フラグ = 0 )
			}

			if( $f:w02a_懐中電灯破壊フラグ ) {
				mesg 静止スポットライト設置 レイブンライト off
			}

			chara レイブン人形 レイブン像 \
					-m dbg_val -p 13600,-4748,-20950 -r 0,3400,0

			chara 懐中電灯 懐中電灯 -m flashlight2 \
									-p 13975,-4980,-20304 \
									-r 0,378,-5 \
									-e ライトオフ \
									-f $f:w02a_懐中電灯破壊フラグ
		#endif
	}

	proc ライトオフ {
		#if d:SPOT_LIGHT
		#if d:VALCAN
			mesg 静止スポットライト設置 レイブンライト off
			eval( $f:w02a_懐中電灯破壊フラグ = 1 )
			eval( $b:w02a_懐中電灯破壊チェック = $w:グローバルロード回数);

			// レイブンイベントフラグを立てる
			eval( $f:w02a_レイブンイベントフラグ = 1 )
			#if d:VAR_SAVE
				command varsave $f:w02a_レイブンイベントフラグ
			#endif
		#endif
		#endif
	}

	// 各種カメラの設定
	// ------------------------------------
	proc 右舷小部屋カメラ設定 {
		#if d:STAGE_CAMERA
			// 右舷通路
			trap c001 d:PLAYER \
				-mask ＊ \
				-camera \
				-exec {
					if ($w:アラートモード == 0) {
						eval( $i:スライド距離 = 3500 );
					} else {
						eval( $i:スライド距離 = 7500 );
					}

	 				@CS_スムーズカメラ降順 $6 -10000 -14000 10000 8000
					eval( $i:補完ＬＸ = $i:CS_結果１ );

					if ($w:アラートモード == 0) {
						if ($6 > -15000) {
							@CS_スムーズカメラ降順 $6 -10000 -15000 937 0
						} else {
							@CS_スムーズカメラ降順 $6 -15000 -19500 0 -100
						}
					} else {
						@CS_スムーズカメラ降順 $6 -10000 -15000 937 100
					}
					eval( $i:補完ＲＸ = $i:CS_結果１ );

					@CS_スムーズカメラ降順 $6 -16000 -18000 2048 1960
	 				eval( $i:補完ＲＹ = $i:CS_結果１ );

					@CS_スムーズカメラ降順 $6 -10000 -15000 3000 4000
					eval( $w:補完距離 = $i:CS_結果１ );

					chara カメラ設定 通路カメラ１ \
						-c 0 \
						-b 9300,-3000,-32000 10000,0,-10250 \
						-l $i:補完ＬＸ,-4000,-32000 9750,32000,-11000 \
						-r $i:補完ＲＸ,$i:補完ＲＹ,0 \
						-f $w:補完距離 \
						-a 200 \
						-i 0 -1 0 0 \
						-slide 1 10 7500 $i:スライド距離 100 \
						-s $3
				}

			// 右舷小部屋
			trap c002 d:PLAYER \
				-mask ＊ \
				-camera \
				-exec {
					chara カメラ設定 小部屋カメラ \
						-c 0 \
						-b 10819,3123,-20908  15492,3123,-20908 \
						-l 10819,-32000,-22877  15492,32000,-22072 \
						-r 910,2048,0 -f 6645 \
						-a 200 \
						-i 0 -1 0 0 \
						-s $3
				}
		#endif
	}



// 左舷小部屋
	// 天井
	// ------------------------------------
	proc 左舷小部屋天井設置 {
		#if d:CHARA_CEIL
			chara 天井君 左舷天井 -m d:CEIL_NAME3 -h -1000 -p 0,0,0 -l d:LT2_NAME
		#endif
	}

/***************************************************************************************************/
// ビキニポスター
/***************************************************************************************************/
	proc ビキニポスター {

		local $$:ファイル名

		// 双眼鏡兵
		if( $b:ミッション番号 == d:MISSION:写真撮影 ) {
			$$:ファイル名 = a02a_pos01;
		} else {
			$$:ファイル名 = w02a_pos01;
		}
		chara プットオブジェ ビキニポスターＡ -m $$:ファイル名 \
			-r 0 0 0 \
			-p -2000,-6000,(12000-1) \
			-l w02a \
			-s 100 100 100
		// エルード中
		if( $b:ミッション番号 == d:MISSION:写真撮影 ) {
			$$:ファイル名 = a02a_pos01;
		} else {
			$$:ファイル名 = w02a_pos02;
		}
		chara プットオブジェ ビキニポスターＣ -m $$:ファイル名 \
			-r 0 3072 0 \
			-p (-6000+15),-14500,-20500 \
			-l w02a \
			-s 100 100 100
	}

	proc ポスター爆発セットA {
		// ポスター爆発
		chara トラップ専用C4 ポスターＣ４A -o 1 -m 1 -p -2000,(-6000-125),11800 -r 0,0,0 -e ポスター爆発スイッチA
		chara トラップ専用C4 ポスターＣ４A -o 1 -m 1 -p (-2000+100),(-6000-125+100),11800 -r 0,0,0 -e ポスター爆発スイッチA
		chara トラップ専用C4 ポスターＣ４A -o 1 -m 1 -p (-2000+100),(-6000-125-100),11800 -r 0,0,0 -e ポスター爆発スイッチA
		chara トラップ専用C4 ポスターＣ４A -o 1 -m 1 -p (-2000-100),(-6000-125+100),11800 -r 0,0,0 -e ポスター爆発スイッチA
		chara トラップ専用C4 ポスターＣ４A -o 1 -m 1 -p (-2000-100),(-6000-125-100),11800 -r 0,0,0 -e ポスター爆発スイッチA
	}

	proc ポスター爆発セットB {
		// ポスター爆発
		chara トラップ専用C4 ポスターＣ４B:01 -o 1 -m 1 -e ポスター爆発スイッチB \
								-p -5950,-14250,-20400 -r 0,3072,0
		chara トラップ専用C4 ポスターＣ４B:02 -o 1 -m 1 -e ポスター爆発スイッチB \
								-p -5950,-14250,(-20400-250) -r 0,3072,0
		chara トラップ専用C4 ポスターＣ４B:03 -o 1 -m 1 -e ポスター爆発スイッチB \
								-p -5950,(-14250-300),-20400 -r 0,3072,0
		chara トラップ専用C4 ポスターＣ４B:04 -o 1 -m 1 -e ポスター爆発スイッチB \
								-p -5950,(-14250-300),(-20400-250) -r 0,3072,0
		chara トラップ専用C4 ポスターＣ４B:05 -o 1 -m 1 -e ポスター爆発スイッチB \
								-p -5950,(-14250-700),-20400 -r 0,3072,0
		chara トラップ専用C4 ポスターＣ４B:06 -o 1 -m 1 -e ポスター爆発スイッチB \
								-p -5950,(-14250-700),(-20400-250) -r 0,3072,0
	}

	proc ポスター爆発スイッチB {
		mesg トラップ専用C4 ポスターＣ４B on
	}
	proc ポスター爆発スイッチA {
		mesg トラップ専用C4 ポスターＣ４A on
	}

/***************************************************************************************************/
// 敵兵視界遮り壁
/***************************************************************************************************/

	proc 敵兵視界遮り壁追加 {

		#if 1
		#else
		// 手すりのハザード Ｂ３
		command 追加ＨＺＸグループ登録 -hzx_id (2-1) -add_id (10-1)

		// 地下3階の左舷
		trap ene_eye:01 d:PLAYER \
			-mask ？ \
			-exec {
				if( $3 == 入る ) {
					command 追加ＨＺＸグループ登録 -hzx_id (2-1) -add_id (9-1)
				} else {
					command 追加ＨＺＸグループ削除 -hzx_id (2-1) -add_id (9-1)
				}
			}
		// 地下2階の左舷手前
		trap ene_eye:02 d:PLAYER \
			-mask ？ \
			-exec {
				if( $3 == 入る ) {
					command 追加ＨＺＸグループ登録 -hzx_id (2-1) -add_id (11-1)
				} else {
					command 追加ＨＺＸグループ削除 -hzx_id (2-1) -add_id (11-1)
				}
			}

		// 地下2階の左舷真ん中
		trap ene_eye:03 d:PLAYER \
			-mask ？ \
			-exec {
				if( $3 == 入る ) {
					command 追加ＨＺＸグループ登録 -hzx_id (2-1) -add_id (12-1)
				} else {
					command 追加ＨＺＸグループ削除 -hzx_id (2-1) -add_id (12-1)
				}
			}
		// 地下2階の左舷奥
		trap ene_eye:04 d:PLAYER \
			-mask ？ \
			-exec {
				if( $3 == 入る ) {
					command 追加ＨＺＸグループ登録 -hzx_id (2-1) -add_id (13-1)
				} else {
					command 追加ＨＺＸグループ削除 -hzx_id (2-1) -add_id (13-1)
				}
			}
		#endif

		// 固定型
		chara 透明壁 敵視界遮り壁固定型１ \
				-position -7000 -9000 -4000 2000 \
		  				  -4000 -9000 -4000 2000 \
		  		-attribute ( d:HZX_SEG_ATR_ALL & ~( d:HZX_SEG_NO_ENEMY_EYES ) ) \
				//-attribute ( d:HZX_SEG_ATR_ALL & ~( d:HZX_SEG_NO_ENEMY_EYES | d:HZX_SEG_NO_BULLET )) \
				-map エンジンルーム

		chara 透明壁 敵視界遮り壁固定型２ \
				-position -7000 -9000 -4000 2000 \
		  				  -4000 -9000 -4000 2000 \
		  		-attribute ( d:HZX_SEG_ATR_ALL & ~( d:HZX_SEG_NO_ENEMY_EYES ) ) \
				//-attribute ( d:HZX_SEG_ATR_ALL & ~( d:HZX_SEG_NO_ENEMY_EYES | d:HZX_SEG_NO_BULLET )) \
				-map エンジンルーム

		// 移動型
		chara 透明壁 敵視界遮り壁移動型 \
				-position -3750 -9000 ($i:プレイヤー位置Ｚ + 1000) 2000 \
		  				  -3750 -9000 ($i:プレイヤー位置Ｚ + 5000) 2000 \
		  		-attribute ( d:HZX_SEG_ATR_ALL & ~( d:HZX_SEG_NO_ENEMY_EYES ) ) \
				//-attribute ( d:HZX_SEG_ATR_ALL & ~( d:HZX_SEG_NO_ENEMY_EYES | d:HZX_SEG_NO_BULLET )) \
				-map エンジンルーム

		mesg 透明壁 敵視界遮り壁固定型１ off
		mesg 透明壁 敵視界遮り壁固定型２ off
		mesg 透明壁 敵視界遮り壁移動型 off

		// Ｂ２
		trap ene_eye:01 d:PLAYER \
			-mask ＊ \
			-exec {
				if( $3 == 入る ) {
					print '透明壁ＯＮ'
					mesg 透明壁 敵視界遮り壁移動型１ move  -7000 -9000 -4000 2000 \
														 -4000 -9000 -4000 2000

					mesg 透明壁 敵視界遮り壁固定型１ on
					mesg 透明壁 敵視界遮り壁移動型 on
				} else if( $3 == 出る ) {
					mesg 透明壁 敵視界遮り壁固定型１ off
					mesg 透明壁 敵視界遮り壁移動型 off
				} else {
					mesg 透明壁 敵視界遮り壁移動型 move \
							-3750 -9000 ($i:プレイヤー位置Ｚ + 1000) 2000 \
							-3750 -9000 ($i:プレイヤー位置Ｚ + 5000) 2000
				}
			}

		// Ｂ３左
		trap ene_eye:02 d:PLAYER \
			-mask ＊ \
			-exec {
				if( $3 == 入る ) {
					print '透明壁ＯＮ'
					mesg 透明壁 敵視界遮り壁固定型１ move  -13000 -13000 2000 4000 \
														    -4000 -13000 2000 4000

					mesg 透明壁 敵視界遮り壁固定型２ move  -4000 -13000 2000 4000 \
														    -4000 -13000 -6000 4000

					mesg 透明壁 敵視界遮り壁固定型１ on
					mesg 透明壁 敵視界遮り壁固定型２ on
					mesg 透明壁 敵視界遮り壁移動型 on
				} else if( $3 == 出る ) {
					mesg 透明壁 敵視界遮り壁固定型１ off
					mesg 透明壁 敵視界遮り壁固定型２ off
					mesg 透明壁 敵視界遮り壁移動型 off
				} else {
					mesg 透明壁 敵視界遮り壁移動型 move \
							-3750 -13000 ($i:プレイヤー位置Ｚ + 1000) 2000 \
							-3750 -13000 ($i:プレイヤー位置Ｚ + 5000) 2000
				}
			}

		// Ｂ３右
		trap ene_eye:03 d:PLAYER \
			-mask ＊ \
			-exec {
				if( $3 == 入る ) {
					print '透明壁ＯＮ'
					mesg 透明壁 敵視界遮り壁固定型１ move  -2500 -13000 2750 3000 \
														    -2500 -13000 -8000 3000

					mesg 透明壁 敵視界遮り壁固定型１ on
					mesg 透明壁 敵視界遮り壁移動型 on
				} else if( $3 == 出る ) {
					mesg 透明壁 敵視界遮り壁固定型１ off
					mesg 透明壁 敵視界遮り壁移動型 off
				} else {
					mesg 透明壁 敵視界遮り壁移動型 move \
							-2500 -13000 ($i:プレイヤー位置Ｚ + 1000) 2000 \
							-2500 -13000 ($i:プレイヤー位置Ｚ + 5000) 2000
				}
			}

	}


/***************************************************************************************************/
// 赤外線
/***************************************************************************************************/
	proc 赤外線センサーＡ {

		chara トラップ専用C4 ＢＩＧＣ４:01 -p -16000,-2350,-26425 -r 0,2048,0 -n 1 -e C4誤射即死
		chara トラップ専用C4 ＢＩＧＣ４:01 -p -15825,-2350,-26200 -r 0,3072,0 -n 1 -e C4誤射即死
		chara トラップ専用C4 ＢＩＧＣ４:01 -p -16175,-1875,-27500 -r 0,1024,1024 -n 1 -e C4誤射即死

		if( $w:ゲーム設定 >= d:LEVEL_NORMAL ) {
		// ノーマル以上
			if( $f:a02a_赤外線１スイッチ破壊フラグ  == 0 ) {
				chara 複数赤外線 赤外線センサー１ \
				    -p -13750,-2500,-24850  0 0 0  センサースイッチ１ \
					-n 1 \	// スイッチの数
					-a -15900,-5000,-26250 0 0 0 \
					   -17600,-5000,-26250 0 0 0 \
					-b 1 \	// センサーのセット数
				    -e Ｃ４爆発 \
				    -s スイッチ破壊１ \
					-m irs_box irs_box2 irs \
					-d 0
			} else {
				chara プットオブジェ 赤外線スイッチ１ -m irs_box2 -r 0 0 0 -p -13750,-2500,-24850 -l w02a -s 100 100 100 -f ( d:PUT_OBJ_CALC_LIGHT )
				chara プットオブジェ 赤外線センサーＬ１ -m irs -r 0 0 0 -p -15900,-5000,-26250 -l w02a -s 100 100 100 -f ( d:PUT_OBJ_CALC_LIGHT )
				chara プットオブジェ 赤外線センサーＲ１ -m irs -r 0 0 0 -p -17600,-5000,-26250 -l w02a -s 100 100 100 -f ( d:PUT_OBJ_CALC_LIGHT )
			}
		} else {
		// ノーマル以下
			eval( $f:a02a_赤外線１スイッチ破壊フラグ = 1 )
			chara プットオブジェ 赤外線センサーＬ１ -m irs -r 0 0 0 -p -15900,-5000,-26250 -l w02a -s 100 100 100 -f ( d:PUT_OBJ_CALC_LIGHT )
			chara プットオブジェ 赤外線センサーＲ１ -m irs -r 0 0 0 -p -17600,-5000,-26250 -l w02a -s 100 100 100 -f ( d:PUT_OBJ_CALC_LIGHT )
		}

		// もしスイッチが破壊されていたらＣ４のランプも消しておく
		if( $f:a02a_赤外線１スイッチ破壊フラグ  == 1 ) {
			mesg トラップ専用C4 ＢＩＧＣ４:01 lamp_off
		}
	}
	proc 赤外線センサーＢ {
		chara トラップ専用C4 ＢＩＧＣ４:02 -p -15825,-5000,-29150 -r 0,3072,0 -n 1 -e C4誤射即死
		chara トラップ専用C4 ＢＩＧＣ４:02 -p -15900,-5000,-29825 -r 0,2048,0 -n 1 -e C4誤射即死
		chara トラップ専用C4 ＢＩＧＣ４:02 -p -15900,-5000,-29450 -r 0,1024,0 -n 1 -e C4誤射即死

		if( $f:a02a_赤外線２スイッチ破壊フラグ  == 0 ) {
			chara 複数赤外線 赤外線センサー２ \
			    -p -15875,-4000,-28600 0 3072 0  センサースイッチ２ \
				-n 1 \	// スイッチの数
				-a -15900,-5000,-28250 0 0 0 \
				   -17600,-5000,-28250 0 0 0 \
				-b 1 \	// センサーのセット数
			    -e Ｃ４爆発 \
			    -s スイッチ破壊２ \
				-m irs_box irs_box2 irs \
				-d 0
		} else {
			chara プットオブジェ 赤外線スイッチ２ -m irs_box2 -r 0 3072 0 -p -15875,-4000,-28600 -l w02a -s 100 100 100 -f ( d:PUT_OBJ_CALC_LIGHT )
			chara プットオブジェ 赤外線センサーＬ２ -m irs -r 0 0 0 -p -15900,-5000,-28250 -l w02a -s 100 100 100 -f ( d:PUT_OBJ_CALC_LIGHT )
			chara プットオブジェ 赤外線センサーＲ２ -m irs -r 0 0 0 -p -17600,-5000,-28250 -l w02a -s 100 100 100 -f ( d:PUT_OBJ_CALC_LIGHT )
		}

		// もしスイッチが破壊されていたらＣ４のランプも消しておく
		if( $f:a02a_赤外線２スイッチ破壊フラグ  == 1 ) {
			mesg トラップ専用C4 ＢＩＧＣ４:02 lamp_off
		}
	}
	proc 赤外線センサーＣ {
		chara トラップ専用C4 ＢＩＧＣ４:03 -p (-17370-200),(-5000+75+150),(-31330-100) -r 1024,0,0 -n 1 -e C4誤射即死
		chara トラップ専用C4 ＢＩＧＣ４:03 -p (-17370-200),(-5000+75),(-31330-100) -r 1024,0,0 -n 1 -e C4誤射即死
		chara トラップ専用C4 ＢＩＧＣ４:03 -p -17625,(-4000+250),-30900 -r 0,0,0 -n 1 -e C4誤射即死

		if( $w:ゲーム設定 >= d:LEVEL_EASY ) {
			if( $f:a02a_赤外線３スイッチ破壊フラグ  == 0 ) {
				chara 複数赤外線 赤外線センサー３ \
					-p -17630,(-5000+1380),(-31300+325) 0 1024 3072  センサースイッチ３ \
					-n 1 \	// スイッチの数
					-a -15900,-5000,-30250 0 0 0 \
					   -17600,-5000,-30250 0 0 0 \
					-b 1 \	// センサーのセット数
					-e Ｃ４爆発 \
					-s スイッチ破壊３ \
					-m irs_box irs_box2 irs \
					-d 0
			} else {
				chara プットオブジェ 赤外線スイッチ３ -m irs_box2 -r 0 1024 3072 -p -17630,(-5000+1380),(-31300+325) -l w02a -s 100 100 100 -f ( d:PUT_OBJ_CALC_LIGHT )
				chara プットオブジェ 赤外線センサーＬ３ -m irs -r 0 0 0 -p -15900,-5000,-30250 -l w02a -s 100 100 100 -f ( d:PUT_OBJ_CALC_LIGHT )
				chara プットオブジェ 赤外線センサーＲ３ -m irs -r 0 0 0 -p -17600,-5000,-30250 -l w02a -s 100 100 100 -f ( d:PUT_OBJ_CALC_LIGHT )
			}
		} else {
			eval( $f:a02a_赤外線３スイッチ破壊フラグ = 1 )
			chara プットオブジェ 赤外線センサーＬ３ -m irs -r 0 0 0 -p -15900,-5000,-30250 -l w02a -s 100 100 100 -f ( d:PUT_OBJ_CALC_LIGHT )
			chara プットオブジェ 赤外線センサーＲ３ -m irs -r 0 0 0 -p -17600,-5000,-30250 -l w02a -s 100 100 100 -f ( d:PUT_OBJ_CALC_LIGHT )
		}

		// もしスイッチが破壊されていたらＣ４のランプも消しておく
		if( $f:a02a_赤外線３スイッチ破壊フラグ  == 1 ) {
			mesg トラップ専用C4 ＢＩＧＣ４:03 lamp_off
		}
	}

	proc 赤外線センサー設置 {
	#if d:SENSOR
		@赤外線センサーＡ
		@赤外線センサーＢ
		@赤外線センサーＣ

		chara メリケン粉 メリケン \
			-m w01d_flour_B \
			-p -16150,-5000,-31500 \
			-r 0,0,0 \
			-e 赤外線可視

		// 誘爆用（音だけちょうだい）Ｃ４
		chara トラップ専用C4 誘爆用Ｃ４_１ -p -15900,-6000,-29825 -r 0,0,0 -n 1	//noiseはなし
		chara トラップ専用C4 誘爆用Ｃ４_２ -p -15900,-6000,-29825 -r 0,0,0 -n 1	//noiseはなし
		chara トラップ専用C4 誘爆用Ｃ４_３ -p -15900,-6000,-29825 -r 0,0,0 -n 1	//noiseはなし
		chara トラップ専用C4 誘爆用Ｃ４_４ -p -15900,-6000,-29825 -r 0,0,0 -n 1	//noiseはなし
		chara トラップ専用C4 誘爆用Ｃ４_５ -p -15900,-6000,-29825 -r 0,0,0 -n 1	//noiseはなし
		chara トラップ専用C4 誘爆用Ｃ４_６ -p -15900,-6000,-29825 -r 0,0,0 -n 1	//noiseはなし

		chara トラップ専用C4 誘爆用Ｃ４_７ -p -15900,-6000,-29825 -r 0,0,0 -n 1	//noiseはなし
		chara トラップ専用C4 誘爆用Ｃ４_８ -p -15900,-6000,-29825 -r 0,0,0 -n 1	//noiseはなし
		chara トラップ専用C4 誘爆用Ｃ４_９ -p -15900,-6000,-29825 -r 0,0,0 -n 1	//noiseはなし
		chara トラップ専用C4 誘爆用Ｃ４_１０ -p -15900,-6000,-29825 -r 0,0,0 -n 1	//noiseはなし
		chara トラップ専用C4 誘爆用Ｃ４_１１ -p -15900,-6000,-29825 -r 0,0,0 -n 1	//noiseはなし
		chara トラップ専用C4 誘爆用Ｃ４_１２ -p -15900,-6000,-29825 -r 0,0,0 -n 1	//noiseはなし
		chara トラップ専用C4 誘爆用Ｃ４_１３ -p -15900,-6000,-29825 -r 0,0,0 -n 1	//noiseはなし
		chara トラップ専用C4 誘爆用Ｃ４_１４ -p -15900,-6000,-29825 -r 0,0,0 -n 1	//noiseはなし
		chara トラップ専用C4 誘爆用Ｃ４_１５ -p -15900,-6000,-29825 -r 0,0,0 -n 1	//noiseはなし

	#endif
	}

	#if d:SENSOR
		proc スイッチ破壊１ {
			eval( $f:a02a_赤外線１スイッチ破壊フラグ = 1 )
			mesg トラップ専用C4 ＢＩＧＣ４:01 lamp_off
			@センサーチェック
		}

		proc スイッチ破壊２ {
			eval( $f:a02a_赤外線２スイッチ破壊フラグ = 1 )
			mesg トラップ専用C4 ＢＩＧＣ４:02 lamp_off
			@センサーチェック
		}

		proc スイッチ破壊３ {
			eval( $f:a02a_赤外線３スイッチ破壊フラグ = 1 )
			mesg トラップ専用C4 ＢＩＧＣ４:03 lamp_off
			@センサーチェック
		}

		proc センサーチェック {
			if( $f:a02a_赤外線１スイッチ破壊フラグ & $f:a02a_赤外線２スイッチ破壊フラグ & $f:a02a_赤外線３スイッチ破壊フラグ ) {
				print 'センサークリアー'
				eval($w:t_story = d:ST_機関室赤外線センサークリア)
			}
		}

		proc Ｃ４爆発 {
			print 'C4爆発'
			/*
			print 'Ｃ４爆発'
			command 無線設定 -reset
			mesg トラップ専用C4 ＢＩＧＣ４ on
			command プレイヤー瞬殺 -name スネーク
			chara フェードインアウト フェードイン \
				-c 255,255,255 128 \
				-t 60
			*/
			if ( $f:ゲームオーバー処理フラグ == 0 ) {
				eval( $f:ゲームオーバー処理フラグ = 1 );
				mesg 複数赤外線 赤外線センサー１ on
				mesg 複数赤外線 赤外線センサー２ on
				mesg 複数赤外線 赤外線センサー３ on

				command 無線設定 -reset
				mesg トラップ専用C4 ＢＩＧＣ４ on
				@爆発ゲームオーバー処理 d:BOMB_EFFECT_ON
				command プレイヤー瞬殺 -name スネーク
			}
		}
		proc 赤外線可視 {
			mesg 複数赤外線 赤外線センサー１ on
			mesg 複数赤外線 赤外線センサー２ on
			mesg 複数赤外線 赤外線センサー３ on
		}

		proc C4誤射即死{
			command 無線設定 -reset

			if(!$f:w02a_Ｃ４誤爆でゲームオーバー) {

				@Ｃ４誘爆
				@爆発ゲームオーバー処理 d:BOMB_EFFECT_ON

				print 'C4誤射即死'
				command プレイヤー瞬殺 -name スネーク
				print 'プレイヤー瞬殺'
				chara フェードインアウト フェードイン \
					-c 255,255,255 128 \
					-t 60
				print 'フェードイン'
				eval($f:w02a_Ｃ４誤爆でゲームオーバー = 1)
			}
		}

/*
		proc Ｃ４誘爆 {
print 'Ｃ４誘爆もよばれている'

			command StreamStopAll
			command セットサウンドコード -c d:SNG_FOUTS_S		//ＢＧＭフェードアウト
			mesg コマンダー 敵兵セット 視界オフ
			eval($w:Ｃ４爆発用ディレイ = 0)
