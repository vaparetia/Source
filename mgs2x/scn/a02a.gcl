								[ dogtag:tnk_w02a_guard_ha_04 ] \
								[ dogtag:tnk_w02a_guard_vh_04 ]
	}

	proc 警備兵Ｅ $:名前 {
		// 左舷Ｂ３ 階段奥で見えない兵
		chara 警備兵 $:名前 \
			-r 29 \
			-n 0 \
			-d d:ENE_DEF_X_5 d:ENE_DEF_Y_5 d:ENE_DEF_Z_5 左舷小部屋 \
			-s d:ENE_STATUS_GUNLIGHT \
			-i	($w:敵潜入視力-$w:敵兵調整値) ($w:敵危険視力-$w:敵兵調整値) ($w:敵回避視力-$w:敵兵調整値) \
