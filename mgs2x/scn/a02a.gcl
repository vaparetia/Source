			trap c015 d:PLAYER \
				-mask ＊ \
				-camera \
				-exec {

					@完全補完カメラ $6 -15000 6000 \
								2010,-10746,-6659 3781,-13695,-14168 \
								2354,-9627,10571 2362,-12929,4945

					chara カメラ設定 通路カメラ１ \
						-c 1 \
						-p $i:補完ＰＸ $i:補完ＰＹ $i:補完ＰＺ \
						-t $i:補完ＴＸ $i:補完ＴＹ $i:補完ＴＺ \
						-r 238,1897,0 -f 8260 \
						-a 200 \
						-i 2 -1 0 0 \
						-s $3
				}

			// エンジン階段
			trap c016 d:PLAYER \
				-mask ？ \
				-camera \
				-exec {

					chara カメラ設定 通路カメラ１ \
						-c 0 \
						-b d:CAM_MIN d:CAM_MIN d:CAM_MIN  d:CAM_MAX d:CAM_MAX d:CAM_MAX \
						-l d:CAM_MIN d:CAM_MIN d:CAM_MIN  d:CAM_MAX d:CAM_MAX d:CAM_MAX \
						-r 285,2109,0 -f 7167 \
						-a 200 \
						-i 2 -1 0 0 \
						-z d:CAMERA_NO_CUSHION \
						-s $3
				}

			// エンジン左下
			trap c017 d:PLAYER \
				-mask ＊ \
				-camera \
				-exec {
					if ($w:アラートモード == 0) {
						eval( $i:スライド距離 = 3500 );
					} else {
						eval( $i:スライド距離 = 7500 );
					}

					@CS_スムーズカメラ降順 $6 5000 2500 350 150
					eval( $i:補完ＲＸ = $i:CS_結果１ );

					chara カメラ設定 通路カメラ１ \
						-c 0 \
						-b -2250,-32000,-32000 -1750,-9500,11500 \
						-l -32000,-32000,-32000 32000,32000,32000 \
						-r $i:補完ＲＸ,2048,0 \
						-f 7000 \
						-a 200 \
						-i 2 -1 0 0 \
						-slide 1 10 7500 $i:スライド距離 100 \
						-s $3
				}

			// エンジン左上
			trap c018 d:PLAYER \
				-mask ＊ \
				-camera \
				-exec {

					@完全補完カメラ $6 -15000 4000 \
								-1142,-4574,-6822 -2251,-7351,-11763 \
								-905,-4636,10244 -2014,-7413,5303

					chara カメラ設定 通路カメラ１ \
						-c 1 \
						-p $i:補完ＰＸ $i:補完ＰＹ $i:補完ＰＺ \
						-t $i:補完ＴＸ $i:補完ＴＹ $i:補完ＴＺ \
						-r 357,2068,0 -f 5591 \
						-a 200 \
						-i 2 -1 0 0 \
						-s $3
				}

			trap c018_2 d:PLAYER \
				-mask ＊ \
				-camera \
				-exec {

					chara カメラ設定 通路カメラ１ \
						-c 0 \
						-b -5399 d:CAM_MIN d:CAM_MIN  d:CAM_MAX d:CAM_MAX d:CAM_MAX \
						-l -5525 d:CAM_MIN d:CAM_MIN  d:CAM_MAX d:CAM_MAX d:CAM_MAX \
						-r 176,2058,0 -f /*9723*/8500 \
						-a 200 \
						-i 3 3 0 0 \
						-s $3
				}
		#endif
	}

	proc エンジンルーム左舷Ｂ３カメラ設定 {
			// エンジンルーム左B3通路奥
			trap c019 d:PLAYER \
				-mask ＊ \
				-camera \
				-exec {
					if ($4 < -4000) {
						eval( $i:スライド距離 = 7500 );
						if ($w:アラートモード == 0) {
							eval( $i:スライド距離２ = 4000 );
						} else {
							eval( $i:スライド距離２ = 7500 );
						}
						eval( $i:補完ＢＸ = -4500 );
					} else {
						eval( $i:スライド距離 = 7500 );
						eval( $i:スライド距離２ = 7500 );
						eval( $i:補完ＢＸ = -3000 );
					}

//					@CS_スムーズカメラ降順 $4 -2500 -4000 -2000 -4500

					@CS_スムーズカメラ昇順 $6 -5000 -4000 -9500 -6000
					eval( $i:補完ＢＹ = $i:CS_結果１ );

					@CS_スムーズカメラ昇順 $6 -6000 -4500 150 800
					eval( $i:補完ＲＸ = $i:CS_結果１ );

					chara カメラ設定 通路カメラ１ \
						-c 0 \
						-b $i:補完ＢＸ,-32000,-32000 $i:補完ＢＸ,-9500,1000 \
						-l -32000,-32000,-32000 32000,32000,32000 \
						-r $i:補完ＲＸ,2048,0 \
						-f 7500 \
						-a 200 \
						-i 2 -1 0 0 \
						-slide 1 10 $i:スライド距離 $i:スライド距離２ 100 \
						-s $3
				}

			// エンジンルーム左B3通路手前
			trap c020 d:PLAYER \
				-mask ＊ \
				-camera \
				-exec {
					if( $6 > -4500 ){
						@CS_スムーズカメラ昇順 $6 -4500 -3500 -2042 -510
							eval( $i:補完ＢＺ = $i:CS_結果１ );
						@CS_スムーズカメラ昇順 $6 -4500 -3500 -5776 -2819
							eval( $i:補完ＬＺ = $i:CS_結果１ );
					}else{
						@CS_スムーズカメラ昇順 $6 -8000 -6500 -3300 -2042
							eval( $i:補完ＢＺ = $i:CS_結果１ );

						@CS_スムーズカメラ昇順 $6 -8000 -6500 -7035 -5776
								eval( $i:補完ＬＺ = $i:CS_結果１ );
					}
						@CS_スムーズカメラ昇順 $6 -1500 0 -9200 -10386
							eval( $i:補完ＢＸ = $i:CS_結果１ );

						@CS_スムーズカメラ昇順 $6 -1500 0 -9200 -10386
							eval( $i:補完ＬＸ = $i:CS_結果１ );

					chara カメラ設定 通路カメラ０ \
						-c 0 \
						-b $i:補完ＢＸ,-32000,$i:補完ＢＺ -5000,32000,32000 \
						-l $i:補完ＬＸ,-32000,$i:補完ＬＺ -5000,32000,32000 \
						-r 800,2048,0 -f 6800 \
						-a 200 \
						-i 2 2 0 0 \
						-slide 0 10 0 0 50 \
						-s $3
				}

				trap c026 d:PLAYER \
				-mask ＊ \
				-camera \
				-exec {
					if( $4 > -8500 ){
						if( $4 < -6500 && $6 < -1500 ){

							@CS_スムーズカメラ昇順 $4 -7000 -6500 850 350
								eval( $i:補完ＲＸ = $i:CS_結果１ );
							@CS_スムーズカメラ昇順 $4 -7000 -6500 -476 6309
								eval( $i:補完ＢＺ = $i:CS_結果１ )
							@CS_スムーズカメラ昇順 $4 -7000 -6500 -1761 467
								eval( $i:補完ＬＺ = $i:CS_結果１ )

						}else{
							eval( $i:補完ＲＸ = 350 );
							eval( $i:補完ＢＺ = 6309 )
							eval( $i:補完ＬＺ = 467 )
						}
					}else{
						@CS_スムーズカメラ昇順 $6 -1750 0 850 350
							eval( $i:補完ＲＸ = $i:CS_結果１ );
						@CS_スムーズカメラ昇順 $4 -1750 0 -476 6309
							eval( $i:補完ＢＺ = $i:CS_結果１ )
						@CS_スムーズカメラ昇順 $4 -1750 0 -1761 467
							eval( $i:補完ＬＺ = $i:CS_結果１ )
					}

					chara カメラ設定 通路カメラ１ \
						-c 0 \
						-b -9859,-32000,$i:補完ＢＺ   -6000,32000,32000 \
						-l -9859,-32000,$i:補完ＬＺ  -6000,32000,32000 \
						-r $i:補完ＲＸ,2048,0 -f 6799 \
						-a 200 \
						-i 2 2 0 0 \
						-slide 0 10 0 0 50 \
						-s $3
				}
	}

	proc エンジンルーム左舷Ｂ２カメラ設定 {
		#if d:STAGE_CAMERA
			// エンジンルーム左B2通路
			trap c021 d:PLAYER \
				-mask ＊ \
				-camera \
				-exec {

					@CS_スムーズカメラ昇順 $6 -15000 -7000 230 200
						eval( $w:補完画角 = $i:CS_結果１ );

					@完全補完カメラ $6 -15000 -7000 \
								-5011,-4472,-907 -2418,-9626,-15075 \
								//-4671,-5176,2738 -4511,-7831,-5297
								-4938,-5649,200 -4792,-8044,-7124

					chara カメラ設定 通路カメラ１ \
						-c 1 \
						-p $i:補完ＰＸ $i:補完ＰＹ $i:補完ＰＺ \
						-t $i:補完ＴＸ $i:補完ＴＹ $i:補完ＴＺ \
						-r 224,1930,0 -f 15298 \
						-a $w:補完画角 \
						-i 2 -1 0 0 \
						-s $3
				}
			// エンジンルーム左B2渡り通路
			trap c022 d:PLAYER \
				-mask ＊ \
				-camera \
				-exec {
					/*
						2500 4000
					*/
					@CS_スムーズカメラ昇順 $4 -4000 -2500 230 350
						eval( $w:補完画角 = $i:CS_結果１ );

					@完全補完カメラ $4 -4000 -2500 \
								-5011,-4472,-907 -2418,-9626,-15075 \
								-1599,-5301,1623 -2544,-7417,-6450

					chara カメラ設定 通路カメラ１ \
						-c 1 \
						-p $i:補完ＰＸ $i:補完ＰＹ $i:補完ＰＺ \
						-t $i:補完ＴＸ $i:補完ＴＹ $i:補完ＴＺ \
						-r 224,1930,0 -f 15298 \
						-a $w:補完画角 \
						-i 2 -1 0 0 \
						-s $3
				}
			// つなぎのカメラ
			trap c020_c021 d:PLAYER \
				-mask ＊ \
				-camera \
				-exec {
					if( $3 == 入る)	{
						eval( $i:進入位置Ｘ = $i:前フレーム位置Ｘ )
					}

					if( $i:進入位置Ｘ > -6000 ) {
						if( $6 > -4500 ){
							@CS_スムーズカメラ昇順 $6 -4500 -3500 -2042 -510
								eval( $i:補完ＢＺ = $i:CS_結果１ );
							@CS_スムーズカメラ昇順 $6 -4500 -3500 -5776 -2819
								eval( $i:補完ＬＺ = $i:CS_結果１ );
						}else{
							@CS_スムーズカメラ昇順 $6 -8000 -6500 -3300 -2042
								eval( $i:補完ＢＺ = $i:CS_結果１ );

							@CS_スムーズカメラ昇順 $6 -8000 -6500 -7035 -5776
									eval( $i:補完ＬＺ = $i:CS_結果１ );
						}
							@CS_スムーズカメラ昇順 $6 -1500 0 -9200 -10386
								eval( $i:補完ＢＸ = $i:CS_結果１ );

							@CS_スムーズカメラ昇順 $6 -1500 0 -9200 -10386
								eval( $i:補完ＬＸ = $i:CS_結果１ );

						chara カメラ設定 通路カメラ０ \
							-c 0 \
							-b $i:補完ＢＸ,-32000,$i:補完ＢＺ -5000,32000,32000 \
							-l $i:補完ＬＸ,-32000,$i:補完ＬＺ -5000,32000,32000 \
							-r 800,2048,0 -f 6800 \
							-a 200 \
							-i 2 2 0 0 \
							-slide 0 10 0 0 50 \
							-s $3
					}else{
						chara カメラ設定 通路カメラ１ \
							-c 0 \
							-b -5399 d:CAM_MIN d:CAM_MIN  d:CAM_MAX d:CAM_MAX d:CAM_MAX \
							-l -5525 d:CAM_MIN d:CAM_MIN  d:CAM_MAX d:CAM_MAX d:CAM_MAX \
							-r 176,2058,0 -f /*9723*/8500 \
							-a 200 \
							-i 2 -1 0 0 \
							-s $3
					}

				}
			// 左舷B2窪み 奥
			trap c021_1 d:PLAYER \
				-mask ＊ \
				-camera \
				-exec {
					chara カメラ設定 通路カメラ１ \
						-c 1 \
						-p -2440,-5878,-7658 -t -5525,-7908,-12384 \
						-r 225,2425,0 -f 5998 \
						-a 200 \
						-i 2 -1 0 0 \
						-s $3
				}
			// 左舷B2窪み 手前
			trap c021_2 d:PLAYER \
				-mask ＊ \
				-camera \
				-exec {
					chara カメラ設定 通路カメラ１ \
						-c 1 \
						-p -2189,-6588,-3721 -t -6526,-7422,-9495 \
						-r 75,2468,0 -f 7269 \
						-a 200 \
						-i 2 -1 0 0 \
						-s $3
				}
		#endif
	}

	proc エンジンルーム左舷Ｂ１カメラ設定 {
		#if d:STAGE_CAMERA
			// エンジンルーム左B1通路
			trap c023 d:PLAYER \
				-mask ＊ \
				-camera \
				-exec {
					if ($w:アラートモード == 0) {
						eval( $i:スライド距離 = 4000 );
					} else {
						eval( $i:スライド距離 = 8000 );
					}

					chara カメラ設定 通路カメラ１ \
						-c 0 \
						-b -6500,-32000,-32000 32000,32000,-1000 \
						-l -32000,-32000,-32000 32000,32000,32000 \
						-r 150,2048,0 \
						-f 5000 \
						-a 200 \
						-i 0 -1 0 0 \
						-slide 1 10 8000 $i:スライド距離 100 \
						-s $3
				}
		#endif
	}

/***************************************************************************************************/
// プレイヤーの１フレーム前の座標を覚える
/***************************************************************************************************/
proc 座標チェック {
	chara プロック連続実行 毎フレーム処理 \
		-time -1 \
		-exec {
			eval( $i:前フレーム位置Ｘ = $i:プレイヤー位置Ｘ )
			eval( $i:前フレーム位置Ｚ = $i:プレイヤー位置Ｚ )
		}
}

proc ストリーム終了 {
//	print $i:タイムカウント
}

/***************************************************************************************************/
// 手すりビハインド用特殊カメラ
/***************************************************************************************************/
	proc エンジンルームＢ１ビハインド用カメラ {
		#if d:STAGE_CAMERA
			// B1右舷サイド
			trap bc111 d:PLAYER \
				-mask ＊ \
				-camera \
				-state 8 \
				-dir 1024 256 \
				-exec {
					chara カメラ設定 ビハインド用カメラ \
						-c 1 \
						-p ($4-86),1151,($6+2154) -t ($4-589),-3515,($6+698) \
						-r 806,2254,0 \
						-f 4939 \
						-a 200 \
						-i 2 2 0 0 \
						-s $3
				}

			// B1右舷北
			trap bc112 d:PLAYER \
				-mask ＊ \
				-camera \
				-state 8 \
				-dir 0 256 \
				-exec {
					chara カメラ設定 ビハインド用カメラ \
						-c 1 \
						-p $4,341,-20115 -t $4,-4338,-20324 \
						-r 995,2019,0 -f 4684 \
						-a 200 \
						-i 2 2 0 0 \
