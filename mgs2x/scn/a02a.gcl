						-c 1 \
						-p ($4+86),1151,($6+2154) -t ($4+589),-3515,($6+698) \
						-r 806,2254,0 \
						-f 4939 \
						-a 200 \
						-i 2 2 0 0 \
						-s $3
				}

			// B1左舷サイド
			trap bc114 d:PLAYER \
				-mask ＊ \
				-camera \
				-state 8 \
				-dir 0 256 \
				-exec {
					chara カメラ設定 ビハインド用カメラ \
						-c 1 \
						-p -6053,1289,-15743 -t -6083,-2071,-16030 \
						-r 968,2115,0 -f 3372 \
						-a 200 \
						-i 2 2 0 0 \
						-s $3
				}

			// B1左舷南
			trap bc115 d:PLAYER \
				-mask ＊ \
				-camera \
				-state 8 \
				-dir 2048 256 \
				-exec {
					chara カメラ設定 ビハインド用カメラ \
						-c 1 \
						-p $4,1906,-4589 -t $4,-4707,-6159 \
						-r 872,2048,0 -f 6797 \
						-a 200 \
						-i 2 2 0 0 \
						-s $3
				}


		#endif
	}

	proc エンジンルームＢ２ビハインド用カメラ {
		#if d:STAGE_CAMERA
			// 右舷B2サイド
			trap ca121 d:PLAYER \
				-mask ＊ \
				-dir 1024 256 \
				-camera \
				-state 8 \
				-exec {
						chara カメラ設定 ビハインド用カメラ \
							-c 0 \
							-b -32000 -32000 -32000 32000 32000 32000 \
							-l -32000 -32000 -32000 32000 32000 32000 \
							-r 740,2195,0 -f 2407 \
							-a 200 \
							-z d:CAMERA_NO_CUSHION \
							-i 2 2 0 0 \
							-s $3
					}

			// 右舷サイド北奥
			trap ca129 d:PLAYER \
				-mask ＊ \
				-dir 0 256 \
				-camera \
				-state 8 \
				-exec {
						chara カメラ設定 ビハインド用カメラ \
							-c 1 \
							-p $4,-5295,-16808 -t $4,-7359,-17042 \
							-r 950,1985,0 -f 2077 \
							-a 200 \
							-i 2 2 0 0 \
							-s $3
					}

			// エンジン上サイド
			trap ca122 d:PLAYER \
				-mask ＊ \
				-dir 1024 256 \
				-camera \
				-state 8 \
				-exec {
						chara カメラ設定 ビハインド用カメラ \
							-c 0 \
							-b -32000 -32000 -32000 32000 32000 32000 \
							-l -32000 -32000 -32000 32000 32000 32000 \
							//-r 806,2268,0 -f 3707 \
							-r 806,2268,0 -f 3500 \
							-a 200 \
							-z d:CAMERA_NO_CUSHION \
							-i 2 2 0 0 \
							-s $3
					}
			// エンジン上手前
			trap ca123 d:PLAYER \
				-mask ＊ \
				-dir 2048 256 \
				-camera \
				-state 8 \
				-exec {
						chara カメラ設定 ビハインド用カメラ \
							-c 1 \
							-p $4,-4434,6990 -t $4,-7887,6057 \
							-r 852,2048,0 -f 3577 \
							-a 200 \
							-i 2 2 0 0 \
							-s $3
					}
			//-----------------
			// 右舷B2手前
			trap ca125 d:PLAYER \
				-mask ＊ \
				-dir 2048 256 \
				-camera \
				-state 8 \
				-exec {
						chara カメラ設定 ビハインド用カメラ \
							-c 1 \
							-p $4,-3757,-1525 -t $4,-8955,-4459 \
							-r 689,2048,0 -f 5969 \
							-a 200 \
							-i 2 2 0 0 \
							-s $3
					}

			// 右舷B2右サイド
			trap ca127 d:PLAYER \
				-mask ＊ \
				-dir 1024 256 \
				-camera \
				-state 8 \
				-exec {
						chara カメラ設定 ビハインド用カメラ \
							-c 0 \
							-b -32000,-32000,-32000 32000,32000,32000 \
							-l -32000,-32000,-32000 32000,32000,32000 \
							-r 755,1670,0 -f 4005 \
							-a 200 \
							-i 2 2 0 0 \
							-z d:CAMERA_NO_CUSHION \
							-s $3
					}

			trap ca128 d:PLAYER \
				-mask ＊ \
				-dir 2048 256 \
				-camera \
				-state 8 \
				-exec {
						chara カメラ設定 ビハインド用カメラ \
							-c 0 \
							-b -32000,-32000,-32000 32000,32000,32000 \
							-l -32000,-32000,-32000 32000,32000,32000 \
							-r 847,2062,0 -f 3779 \
							-a 200 \
							-i 2 2 0 0 \
							-z d:CAMERA_NO_CUSHION \
							-s $3
					}

			//-----------------
			// 左舷B2右サイド
			trap ca124 d:PLAYER \
				-mask ＊ \
				-dir 3072 256 \
				-camera \
				-state 8 \
				-exec {
						chara カメラ設定 ビハインド用カメラ \
							-c 1 \
							-p ($4-219),-3954,($6+1691) -t $4,-7421,$6 \
							-a 200 \
							-i 2 2 0 0 \
							-s $3
					}

/*
			// トラップ数がどうしても足りないでのビハインドに変更
			// 左舷B2南
			trap ca126 d:PLAYER \
				-mask ＊ \
				-camera \
				-dir 2048 256 \
				-state 8 \
				-exec {
						if( $4 > -4887 ){
							eval( $i:補完ＰＸ = -4887 )
						}else if( $4 < -10000 ){
							eval( $i:補完ＰＸ = -10000 )
						}else{
							eval( $i:補完ＰＸ = $4 )
						}

						chara カメラ設定 ビハインド用カメラ \
							-c 1 \
							-p $i:補完ＰＸ,-1247,-1779 -t $i:補完ＰＸ,-7853,-3369 \
							-r 870,2048,0 -f 6795 \
							-a 200 \
							-i 2 2 0 0 \
							-s $3
					}
*/
			// 左舷奥
			trap ca130 d:PLAYER \
				-mask ＊ \
				-dir 0 256 \
				-camera \
				-state 8 \
				-exec {
						chara カメラ設定 ビハインド用カメラ \
							-c 1 \
							-p $4,-3205,-15129 -t $4,-7319,-16363 \
							-r 834,2036,0 -f 4295 \
							-a 200 \
							-i 2 2 0 0 \
							-s $3
					}
		#endif
	}

