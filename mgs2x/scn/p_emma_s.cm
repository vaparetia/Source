//	So you WERE eavesdropping.

/*盗み聞きしてたのね。*/
ライデン_006: {
Bien... Ll&'amalo as&'i si quieres.
}
//	<<<ENGLISH>>>
//	Fine... Put it that
//	way if you like.

/*あぁ……まあ……そうとも言えるかな。*/
エマ_007: {
&~!Eres despreciable!
}
//	<<<ENGLISH>>>
//	You suck.

/*サイテー。*/
ライデン_008: {
S&'i, s&'i. &~?Pero me vas a decir qu&'e
es lo que ha ocurrido?
}
//	<<<ENGLISH>>>
//	Yeah, yeah. Are you going
//	to tell me what happened?

/*聞きなれたよ、それ。
で、何があったんだ？
*/
エマ_009: {
No, &~!no te lo voy a decir!
}
//	<<<ENGLISH>>>
//	Ha! No -- I don't think so!

/*うふふ。……内緒！*/
//dv}//v
}//d


