//カメラ動作トラップ
// Traps
//---------------------------------------------------------------
//カメラ切り替えトラップ／agl_11:二階中央階段（一階との連絡）
//---------------------------------------------------------------
trap agl_11 スネーク \
	-mask ？ \	
	-camera \
	-exec {
			if($3==入る){
				@cam_agl_11_on
			}else{
				@cam_通常画面エリアカメラ一号オフ_共通
			}
		}

//---------------------------------------------------------------
//カメラ切り替えトラップ／agl_12:二階階段西脇通路（南北方向）
//---------------------------------------------------------------
//補完モード1が、1/4ずつの補完になったので、全部1で大丈夫そう。
//OKなら、ここのスクリプトをもっと単純に直すこと。
trap agl_12 スネーク \
	-mask ? \
	-exec {
		if($3 == 入る){
//			if(($4 > -3500) && ($6 < -9000)){
//				eval($w:cam_hokan = 0)
//			} else {
				eval($w:cam_hokan = 1)
//			}
		} else {
			@cam_通常画面エリアカメラ一号オフ_共通
		}
	}
trap agl_12 スネーク \
	-mask いる \
	-camera \
	-exec {
		if(($w:プレイヤー方向 > 1024) && ($w:プレイヤー方向 < 3072)){ //向こう向き。
			@cam_agl_12_on_come $6 $w:cam_hokan
		} else {
			@cam_agl_12_on_come $6 $w:cam_hokan
		}
	}

//---------------------------------------------------------------
//カメラ切り替えトラップ／agl_13:二階階段東脇通路（南北方向）
//---------------------------------------------------------------
//補完モード1が、1/4ずつの補完になったので、全部1で大丈夫そう。
//OKなら、ここのスクリプトをもっと単純に直すこと。
trap agl_13 スネーク \
	-mask ? \
	-exec {
		if($3 == 入る){
//			if(($4 < 3500) && ($6 < -9000)){
//				eval($w:cam_hokan = 0)
//			} else {
				eval($w:cam_hokan = 1)
//			}
		} else {
			@cam_通常画面エリアカメラ一号オフ_共通
		}
	}
trap agl_13 スネーク \
	-mask いる \
	-camera \
	-exec {
		if(($w:プレイヤー方向 > 1024) && ($w:プレイヤー方向 < 3072)){ //向こう向き。
			@cam_agl_13_on_come $6 $w:cam_hokan
		} else {
			@cam_agl_13_on_come $6 $w:cam_hokan
		}
	}

//---------------------------------------------------------------
//カメラ切り替えトラップ／agl_14:二階西側長通路（小階段へ通じる・東西方向）
//---------------------------------------------------------------
trap agl_14 スネーク \
	-mask ? \
	-exec {
		if($3 == 入る){
			if($4 > -7000){
				eval($w:cam_hokan = 0)
			} else {
				eval($w:cam_hokan = 2)
			}
		} else {
			@CS_左右スライドカメラ後処理
			@cam_通常画面エリアカメラ一号オフ_共通
		}
	}
trap agl_14 スネーク \
	-mask いる \
	-exec {
		@CS_左右スライドカメラ $4 800 60 $i:カメラ位置Ｘ 
		eval( $i:カメラ位置Ｘ = $i:CS_結果１ )
		if( $i:カメラ位置Ｘ < -10840 ) { eval( $i:カメラ位置Ｘ = -10840 ) }
		if( $i:カメラ位置Ｘ >  -4000 ) { eval( $i:カメラ位置Ｘ =  -4000 ) }
		chara カメラ設定 通常画面エリアカメラ一号 \
			-c 1 \
			-p $i:カメラ位置Ｘ 7200 -14438 \
			-t $i:カメラ位置Ｘ $5 -14950 \
			-a 175 \
			-i $w:cam_hokan -1 0 0 \
			-s 1
	}

//---------------------------------------------------------------
//カメラ切り替えトラップ／agl_15:二階東側長通路（小階段へ通じる・東西方向）
//---------------------------------------------------------------
trap agl_15 スネーク \
	-mask ? \
	-exec {
		if($3 == 入る){
		if($4 < 7000){
				eval($w:cam_hokan = 0)
			} else {
				eval($w:cam_hokan = 2)
			}
		} else {
			@CS_左右スライドカメラ後処理
			@cam_通常画面エリアカメラ一号オフ_共通
		}
	}
trap agl_15 スネーク \
	-mask いる \
	-exec {
		@CS_左右スライドカメラ $4 800 60 $i:カメラ位置Ｘ 
		eval( $i:カメラ位置Ｘ = $i:CS_結果１ )
		if( $i:カメラ位置Ｘ > 10840 ) { eval( $i:カメラ位置Ｘ = 10840 ) }
		if( $i:カメラ位置Ｘ <  4000 ) { eval( $i:カメラ位置Ｘ =  4000 ) }
		chara カメラ設定 通常画面エリアカメラ一号 \
			-c 1 \
			-p $i:カメラ位置Ｘ 7200 -14438 \
			-t $i:カメラ位置Ｘ $5 -14950 \
			-a 175 \
			-i $w:cam_hokan -1 0 0 \
			-s 1
	}

//---------------------------------------------------------------
//カメラ切り替えトラップ／agl_16:二階西小階段脇
//---------------------------------------------------------------
trap agl_16 スネーク \
	-mask ? \
	-camera \
	-exec {
		if($3 == 入る){
			@cam_agl_16_on
		} else {
			@cam_通常画面エリアカメラ一号オフ_共通
		}
	}


//---------------------------------------------------------------
//カメラ切り替えトラップ／agl_16_2:二階西小階段直下
//---------------------------------------------------------------

//---------------------------------------------------------------
//カメラ切り替えトラップ／agl_17:二階東小階段脇
//---------------------------------------------------------------
trap agl_17 スネーク \
	-mask ？ \
	-camera \
	-exec {
			if($3==入る){
				@cam_agl_17_on
			}else{
				@cam_通常画面エリアカメラ一号オフ_共通
			}
		}

//---------------------------------------------------------------
//カメラ切り替えトラップ／agl_17_2:二階東小階段直下
//---------------------------------------------------------------

//---------------------------------------------------------------
//カメラ切り替えトラップ／agl_18:二階南端西側通路（南北方向）
//---------------------------------------------------------------
trap agl_18 スネーク \
	-mask いる \
	-camera \
	-exec {
		@CS_スムーズカメラ $6 3000 250 1200 0 //「1200」はagl_20とagl_18_1(or 2)のＹ最大値の差異。
		eval($i:Ｙ加算値 = $i:CS_結果１) 
		if($i:Ｙ加算値 > 1200) { eval($i:Ｙ加算値 = 1200) } //必要以上にカメラが上昇しないように。
		@CS_スムーズカメラ $6 3000 250 780 2500
		eval($w:Ｚ加算値 = $i:CS_結果１)
		if(($6 + $w:Ｚ加算値) > 3615) { //カメラが手前の壁を越えないように。
			eval($i:cam_z = 3615)
		} else {
			eval($i:cam_z = ($6 + $w:Ｚ加算値))
		}
		if($6 > 2835){  //注視点がagl_20のリミットより下に来ないように（暗黒見せないように）。
			eval($i:trg_z = 2835)
		} else {
			eval($i:trg_z = $6)
		}
		@cam_agl_18_on $i:Ｙ加算値 $i:cam_z $5 $6 $i:trg_z
		}
trap agl_18 スネーク \
	-mask 出る \
	-camera \
	-exec {
		@cam_通常画面エリアカメラ一号オフ_共通
		}
trap agl_18_1 スネーク \
	-mask ? \
	-camera \
	-exec {
		if($3 == 入る){
			@cam_agl_18_on_1
		} else {
			@cam_通常画面エリアカメラ一号オフ_共通
		}
	}
trap agl_18_2 スネーク \
	-mask いる \
	-camera \
	-exec {
//		if(($w:プレイヤー方向 > 1024) && ($w:プレイヤー方向 < 3072)) {
			@CS_スムーズカメラ $6 -3250 -5000 0 -350
			eval($w:Ｘ加算値 = $i:CS_結果１)
			@CS_スムーズカメラ $6 -3250 -5000 0 -400
			eval($i:Ｙ加算値 = $i:CS_結果１)
			@CS_スムーズカメラ $6 -3250 -5000 0 ((-5000) - (-2900))
			eval($w:Ｚ加算値 = $i:CS_結果１)

			@CS_スムーズカメラ $6 -3250 -5000 0 300
			eval($w:Ｘ加算値２ = $i:CS_結果１)
			@cam_agl_18_on_2 $w:Ｘ加算値 $i:Ｙ加算値 $w:Ｚ加算値 $w:Ｘ加算値２ $4 $5 $6
//		} else {
//			agl_18と同じタイプのカメラをセット。
//		}
	}

//---------------------------------------------------------------
//カメラ切り替えトラップ／agl_19:二階南端東側通路（南北方向）
//---------------------------------------------------------------
trap agl_19 スネーク \
	-mask いる \
	-camera \
	-exec {
		@CS_スムーズカメラ $6 3000 250 1200 0 //「1200」はagl_20とagl_18_1(or 2)のＹ最大値の差異。
		eval($i:Ｙ加算値 = $i:CS_結果１) 
		if($i:Ｙ加算値 > 1200) { eval($i:Ｙ加算値 = 1200) } //必要以上にカメラが上昇しないように。
		@CS_スムーズカメラ $6 3000 250 780 2500
		eval($w:Ｚ加算値 = $i:CS_結果１)
		if(($6 + $w:Ｚ加算値) > 3615) { //カメラが手前の壁を越えないように。
			eval($i:cam_z = 3615)
		} else {
			eval($i:cam_z = ($6 + $w:Ｚ加算値))
		}
		if($6 > 2835){  //注視点がagl_20のリミットより下に来ないように（暗黒見せないように）。
			eval($i:trg_z = 2835)
		} else {
			eval($i:trg_z = $6)
		}
		@cam_agl_19_on_0_x $i:Ｙ加算値 $i:cam_z $5 $6 $i:trg_z
		}
trap agl_19 スネーク \
	-mask 出る \
	-camera \
	-exec {
		@cam_通常画面エリアカメラ一号オフ_共通
		}
trap agl_19_1 スネーク \
	-mask ? \
	-camera \
	-exec {
		if($3 == 入る){
			@cam_agl_19_on_1
		} else {
			@cam_通常画面エリアカメラ一号オフ_共通
		}
	}
trap agl_19_2 スネーク \
