#include "sload.h"
#include "stdch.h"

#define BLURR 1
#define SUPPORT 1
#define DANKON 1
//#define WATCHER 1
//#define SHIELD_ATTACKER 1

@常駐キャラ設定

print 'AAA'

//小部屋システム出来るまで。
proc マップ設定 {
	if($w:vw01stage == 2){
		chara マップ テスト -k w01b -h vw01b -g 0 -l w01b
		chara 影投影モデル 二階影モデル \
			-model w01bk \
			-pos 0 0 0 
		eval($w:ビハインドモード = 0)
	}
}
@マップ設定

print 'BBB'

//chara レーダー レーダー

// ステージカメラは、ここでは使用していない。
// カメラ設定 
chara カメラ ステージカメラ \
	-c 0 -l 3 -p 0 

chara カメラ設定 ステージカメラ \
	-c 0 \	
	-b -32000,-32000,-32000 32000,32000,32000 \
	-l -32000,-32000,-32000 32000,32000,32000 \
	-r 640,2048,0 \
	-f 2345 \
	-a 150 \
	-i 1 -1 0 0 \
	-s 1


//カメラ用意
chara カメラ 通常画面エリアカメラ一号 \
	-c 0 -l 2 -p 1 

chara カメラ 通常画面エリアカメラ二号 \
	-c 0 -l 2 -p 0 

chara カメラ 通常画面エリアカメラ三号 \
	-c 0 -l 2 -p 0 

//カメラ動作proc設定：共通
//-----------------------------------------
//通常画面エリアカメラ一号用、共通オフproc
//-----------------------------------------
proc cam_通常画面エリアカメラ一号オフ_共通 {
	chara カメラ設定 通常画面エリアカメラ一号 -s 0
}

//-----------------------------------------
//通常画面エリアカメラ二号用、共通オフproc
//-----------------------------------------
proc cam_通常画面エリアカメラ二号オフ_共通 {
	chara カメラ設定 通常画面エリアカメラ二号 -s 0
}

//----------------------------------------
//map about w01b（二階）
//----------------------------------------
//agl_11:二階中央階段（一階との連絡）
proc cam_agl_11_on {
chara カメラ設定 通常画面エリアカメラ一号 \
	-c 0 \	
	-b -1200,0000,-13000 1200,6550,-9350 \
	-l -1190,-32000,-20000 1190,32000,-9200 \
	-r 400,2048,0 \
	-f 3700 \
	-a 130 \
	-i 0 -1 0 0 \
	-s 1
}

//agl_12:二階階段西脇通路（南北方向）

proc cam_agl_12_on_go $:Z $:cam_hokan {
chara カメラ設定 通常画面エリアカメラ一号 \
	-c 1 \	
//	-p -3934,5400,($:Z + 3080) \
	-p -3934,5400,($:Z + 2080) \
	-t -3934,4360,$:Z \
	-a 130 \
	-i $:cam_hokan -1 0 0 \
	-s 1
}
proc cam_agl_12_on_come $:Z $:cam_hokan {
if(($:Z + 2580) > -5000){ //カメラの位置が壁を越えたら、壁の位置で止める。
	eval($i:cam_z = -5050)
} else {
	eval($i:cam_z = ($:Z + 2580))
}

chara カメラ設定 通常画面エリアカメラ一号 \
	-c 1 \	
	-p -3934,5400,$i:cam_z \
	-t -3934,4360,$:Z \
	-a 130 \
	-i $:cam_hokan -1 0 0 \
	-s 1
}

//agl_13:二階階段東脇通路（南北方向）
proc cam_agl_13_on_go $:Z $:cam_hokan {
chara カメラ設定 通常画面エリアカメラ一号 \
	-c 1 \	
	-p 3934,5400,($:Z + 3080) \
	-t 3934,4360,$:Z \
	-a 130 \
	-i $:cam_hokan -1 0 0 \
	-s 1
}
proc cam_agl_13_on_come $:Z $:cam_hokan {
if(($:Z + 2580) > -5000){ //カメラの位置が壁を越えたら、壁の位置で止める。
	eval($i:cam_z = -5050)
} else {
	eval($i:cam_z = ($:Z + 2580))
}
chara カメラ設定 通常画面エリアカメラ一号 \
	-c 1 \	
	-p 3934,5400,$i:cam_z \
	-t 3934,4360,$:Z \
	-a 130 \
	-i $:cam_hokan -1 0 0 \
	-s 1

}

