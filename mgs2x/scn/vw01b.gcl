//agl_18:二階南端西側通路（南北方向）
proc cam_agl_18_on $:Ｙ加算値 $:cam_z $:Y $:Z $:trg_z{
chara カメラ設定 通常画面エリアカメラ一号 \
	-c 1 \	
//	-p -7300,(5350 + $:Ｙ加算値),$:cam_z \ //5350 + $:Ｙ加算値の「5350」は、agl_18_1(or 2)のＹの最大値。滑らかにつなぐ。
//	-t -7300,$:Y,$:trg_z \
	-p -7000,(5350 + $:Ｙ加算値),$:cam_z \ //5350 + $:Ｙ加算値の「5350」は、agl_18_1(or 2)のＹの最大値。滑らかにつなぐ。
	-t -7000,$:Y,$:trg_z \
	-a 150 \ //130
	-i 2 -1 0 0 \
	-s 1
}
proc cam_agl_18_on_1 {
chara カメラ設定 通常画面エリアカメラ一号 \
	-c 0 \	
//	-b -7300,2800,-7000 -7300,5350,2900 \
//	-l -7300,-32000,-14000 -7300,32000,2800 \
	-b -7000,2800,-7000 -7000,5350,2900 \
	-l -7000,-32000,-14000 -7000,32000,2800 \
	-r 240,2048,0 \
	-f 3800 \
	-a 150 \ //130
	-i 1 -1 0 0 \
	-s 1
}
proc cam_agl_18_on_2 $:Ｘ加算値 $:Ｙ加算値 $:Ｚ加算値 $:Ｘ加算値２ $:X $:Y $:Z {
chara カメラ設定 通常画面エリアカメラ一号 \
	-c 1 \	
//	-p (-7300 + $:Ｘ加算値),(5350 + $:Ｙ加算値),((-3250 + 3800) + $:Ｚ加算値) \
//	-t (-7300 + $:Ｘ加算値２),$:Y,$:Z \
	-p (-7000 + $:Ｘ加算値),(5350 + $:Ｙ加算値),((-3250 + 3800) + $:Ｚ加算値) \
	-t (-7000 + $:Ｘ加算値２),$:Y,$:Z \
	-a 150 \ //130
	-i 2 -1 0 0 \
	-s 1
}

//agl_19:二階南端東側通路（南北方向）
