	}
//---------------------------------------------------------------
//カメラ切り替えトラップ／agl_20:二階南端通路（東西方向）
//---------------------------------------------------------------
trap agl_20 スネーク \
	-mask いる \
	-exec {
		@CS_左右スライドカメラ $4 1000 80 $i:カメラ位置Ｘ 
		eval( $i:カメラ位置Ｘ = $i:CS_結果１ )
		if( $i:カメラ位置Ｘ < -7000 ) { eval( $i:カメラ位置Ｘ = -7000 ) }
		if( $i:カメラ位置Ｘ >  7000 ) { eval( $i:カメラ位置Ｘ =  7000 ) }
		chara カメラ設定 通常画面エリアカメラ一号 \
			-c 1 \
			-p $i:カメラ位置Ｘ 6550 3615 \
			-t $i:カメラ位置Ｘ $5 2835 \
			-a 150 \
			-i 2 -1 0 0 \
			-s 1
	}
trap agl_20 スネーク \
	-mask 出る \
	-exec {
		@CS_左右スライドカメラ後処理
		@cam_通常画面エリアカメラ一号オフ_共通
	}

//---------------------------------------------------------------
//カメラ切り替えトラップ／agl_21:二階南端通路へのクランク部（西）
//---------------------------------------------------------------
trap agl_21 スネーク \
	-mask ？ \
	-camera \
	-exec {
			if($3==入る){
//				if($4 < -5500){
//					@cam_agl_21_on_0
//				} else {
					@cam_agl_21_on_1
//				}
			}else{
				@cam_通常画面エリアカメラ二号オフ_共通
			}
		}

//---------------------------------------------------------------
//カメラ切り替えトラップ／agl_22:二階南端通路へのクランク部（東）
//---------------------------------------------------------------
trap agl_22 スネーク \
	-mask ？ \
	-camera \
	-exec {
			if($3==入る){
				if($4 > 5500){
					@cam_agl_22_on_0
				} else {
					@cam_agl_22_on_1
				}
			}else{
				@cam_通常画面エリアカメラ二号オフ_共通
			}
		}

//---------------------------------------------------------------
//agl_22_2::二階北端東西方向通路
//---------------------------------------------------------------
trap agl_22_2 スネーク \
	-mask いる \
	-exec {
		@CS_左右スライドカメラ $4 800 60 $i:カメラ位置Ｘ 
		eval( $i:カメラ位置Ｘ = $i:CS_結果１ )
		if( $i:カメラ位置Ｘ < -4000 ) { eval( $i:カメラ位置Ｘ = -4000 ) }
		if( $i:カメラ位置Ｘ >  4000 ) { eval( $i:カメラ位置Ｘ =  4000 ) }
		chara カメラ設定 通常画面エリアカメラ一号 \
			-c 1 \
			-p $i:カメラ位置Ｘ 6550 -18000 \
			-t $i:カメラ位置Ｘ $5 -18500 \
			-a 150 \
			-i 0 -1 0 0 \
			-s 1
	}

