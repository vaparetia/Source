chara カメラ設定 通常画面エリアカメラ一号 \
	-c 1 \	
//	-p 7300,(5350 + $:Ｙ加算値),$:cam_z \ //5350 + $:Ｙ加算値の「5350」は、agl_19_1(or 2)のＹの最大値。滑らかにつなぐ。
//	-t 7300,$:Y,$:trg_z \
	-p 7000,(5350 + $:Ｙ加算値),$:cam_z \ //5350 + $:Ｙ加算値の「5350」は、agl_19_1(or 2)のＹの最大値。滑らかにつなぐ。
	-t 7000,$:Y,$:trg_z \
	-a 150 \ //130
