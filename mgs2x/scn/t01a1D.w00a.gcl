	// 以下の順で数値を記述。
	@キャラクタ専用ライトセット $:環境光Ｒ $:環境光Ｇ $:環境光Ｂ \
								   $:平行光Ｒ $:平行光Ｇ $:平行光Ｂ \
								   $:平行光光源Ｘ $:平行光光源Ｙ $:平行光光源Ｚ
*/

// 起動時フェードイン


















#if d:起動時フェードイン
	@ロード時フェードイン
#endif


