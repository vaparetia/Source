// 各gclで必要なdefine
// ------------------------------------
// モード
#define		STAGE_TANKER	1		// 共通プロック切り分け用
#define		DEMO_STAGE		1		// デモステージかどうかで起動するキャラを切り分ける

// includes
// ------------------------------------
#include "5sec_bfr_demo.h"
#include "vardef.h"
#include "story.h"
#include "sload.h"
#include "demo_vardef.h"
#include "demo_stdch.h"
#include "demo_stdch2.h"
#include "d00a_cdc.ch"
#include "w00_common.h"

// defines
// デバグ用各種
// -----------------------------------
#define PLAYER			スネーク
#define STAGE_KMS		d00a
#define STAGE_HZX		d00a
#define STAGE_LT2_1		w00a			// LT2ファイルを変える場合、ここにLT2名を入れる。
//#define STAGE_LT2_2		w00a			// 未使用
#define screen_shot				0 // スクリーンショット使用
#define 起動時フェードイン		0 // 起動時フェードイン使用
#define 製品版デモまだ無し		1
#define 波濤出す				1 // 波濤を出す
// 連続したデモを一気に飛ばすかどうか
#if d:TANKER_DEMO_ALL_SKIP
	#define		DEMO_SKIP_ENABLE 1
#else
	#define		DEMO_SKIP_ENABLE 0
#endif


// マップ
// ------------------------------------
chara マップ タンカー -h d:STAGE_HZX -l d:STAGE_LT2_1

// マップ設定
// ------------------------------------
command マップ設定 タンカー -s {

print 'main_000'

//	デモ環境かゲーム環境かで起動を読み分ける。
// ------------------------------------
#if d:MGS2_DEMO
chara デモアクトデバッグ demodebug  -i t:t02a1D -d 't02a1D' -l  -v 0  \
	-p カメラ雨しぶきＯＮ カメラ雨しぶきＯＦＦ

	// t01 を再生するとき
	eval($s:d_num = t01a1D)

	// t02 を再生するとき
//	eval($s:d_num = t02a1D)

	// t03 を再生するとき
//	eval($s:d_num = t03a1D)


#else

	#if 1
	// d00a1で全部デモ再生してしまう方
/*
	d:ST_T01a1D目的説明ポリゴンデモ開始
	d:ST_T01a1D目的説明ポリゴンデモ終了
	d:ST_T01b1G装備品説明シナリオデモ開始
	d:ST_T01b1G装備品説明シナリオデモ終了
	d:ST_T02a1Dカメラの使い方ポリゴンデモ開始
	d:ST_T02a1Dカメラの使い方ポリゴンデモ終了
	d:ST_T03a1Dカモフ登場ポリゴンデモ開始
	d:ST_T03a1Dカモフ登場ポリゴンデモ終了
	d:ST_T03b1Rカモフ登場後無線機デモ開始
	d:ST_T03b1Rカモフ登場後無線機デモ終了
*/

// プロックの準備
//-----------------------------------------------------------
		proc demo_cancel {
			command StreamStopAll
		}

		// デモキャンセルは共通して使う
		chara デモキャンセルチェック デモキャンセル \
			-p demo_cancel

		proc t01a1D終了 {
			mesg デモキャンセルチェック デモキャンセル kill
			eval($w:t_story = d:ST_T01a1D目的説明ポリゴンデモ終了)
			print '統合_$w:t_story = d:ST_T01a1D目的説明ポリゴンデモ終了'

			chara delay ディレイ \
				-time 1 \
				-exec{
					@mv_init_w00a_0
				}
		}

		proc t02a1D終了 {
			#if d:DEMO_SKIP_ENABLE
				if ($1 == 1){
					eval($w:t_story = d:ST_T03a1Dカモフ登場ポリゴンデモ終了)
					print '統合_$w:t_story = d:ST_T03a1Dカモフ登場ポリゴンデモ終了'
				}
			#endif
			restart
		}

		proc t02a2D終了 {
			mesg デモキャンセルチェック デモキャンセル kill
			#if d:DEMO_SKIP_ENABLE
				if ($1 == 1){
					eval($w:t_story = d:ST_T03a1Dカモフ登場ポリゴンデモ終了)
					print '統合_$w:t_story = d:ST_T03a1Dカモフ登場ポリゴンデモ終了'
				}
			#else
				eval($w:t_story = d:ST_T02a1Dカメラの使い方ポリゴンデモ終了)
				print '統合_$w:t_story = d:ST_T02a1Dカメラの使い方ポリゴンデモ終了'
			#endif

			chara delay ディレイ \
				-time 1 \
				-exec{
					restart
				}
		}

		proc t03a1D終了 {
			mesg デモキャンセルチェック デモキャンセル kill
			eval($w:t_story = d:ST_T03a1Dカモフ登場ポリゴンデモ終了)
			print '統合_$w:t_story = d:ST_T03a1Dカモフ登場ポリゴンデモ終了'

			chara delay ディレイ \
				-time 1 \
				-exec{
					restart
				}
		}

		proc rt_強制ＣＡＬＬ_T_03b1Rカモフ登場後無線機デモ体験版終了{
			command セットサウンドコード -c d:SNG_FOUTS_S		//ＢＧＭフェードアウト

			chara delay ディレイ \
				-time 1 \
				-exec{
					@mv_init_w00a_1
				}
		}

		proc rt_強制ＣＡＬＬ_T_03b1Rカモフ登場後無線機デモ製品版終了{
			command セットサウンドコード -c d:SNG_FOUTS_S		//ＢＧＭフェードアウト

			chara delay ディレイ \
				-time 1 \
				-exec{
					@mv_init_w00a_1
				}
		}


// 実際の再生
//-----------------------------------------------------------
		// 実際のでも再生の方も、ストーリーフラグで変える
		if($w:t_story < d:ST_T01a1D目的説明ポリゴンデモ開始) {
			eval($w:t_story = d:ST_T01a1D目的説明ポリゴンデモ開始)
			print '統合_$w:t_story = d:ST_T01a1D目的説明ポリゴンデモ開始'

			// デモ特有の変数代入
			eval($s:d_num = t01a1D)

			@デモモデル差し替え処理
			proc デモ再生_t01a2D {
				#if d:デモ前五秒間待ち
					chara デモアクトデバッグ demodebug  -i t:t02a1D -d 't02a1D' -l  -v 0  \
						-next t01a1D終了 \			// 終了時に呼び出されるproc
						-p カメラ雨しぶきＯＮ カメラ雨しぶきＯＦＦ
				#else
					chara demo デモ再生 \
					#if d:体験版
						-i t:t01a2D \			// ストリーミング用t:シンボル 目的説明デモ（体験版）
					#else
						-i t:t01a1D \			// ストリーミング用t:シンボル 目的説明デモ
					#endif
						-p カメラ雨しぶきＯＮ カメラ雨しぶきＯＦＦ \
						-next t01a1D終了			// 終了時に呼び出されるproc
				#endif
			}

				#if d:デモ前五秒間待ち
					// コレがないと一個後のデモを再生してしまう。
					eval($w:t_story = d:ST_T01a1D目的説明ポリゴンデモ開始-1)
					@global_五秒待ちセット
					if($f:global_デバッグポーズ通過){
						@デモ再生_t01a2D
					}
				#else
					@デモ再生_t01a2D
				#endif

		} else if($w:t_story < d:ST_T02a1Dカメラの使い方ポリゴンデモ開始) {

			// デモ固有の変数代入
			eval($s:d_num = t02a1D)

			if($f:t02カメラデモ後半 == 0){
				eval($f:t02カメラデモ後半 = 1)
				print '$f:t02カメラデモ後半 = 1'

				@デモモデル差し替え処理
				proc デモ再生_t02a1D {
					#if d:デモ前五秒間待ち
					chara デモアクトデバッグ demodebug  -i t:t02a1D -d 't02a1D' -l  -v 0  \
						-next t02a1D終了 \			// 終了時に呼び出されるproc
						-p カメラ雨しぶきＯＮ カメラ雨しぶきＯＦＦ
					#else
						chara demo デモ再生 \
							-i t:t02a1D \			// ストリーミング用t:シンボル camera_1st_half (前半)
							-p カメラ雨しぶきＯＮ カメラ雨しぶきＯＦＦ \
							-next t02a1D終了			// 終了時に呼び出されるproc
					#endif
				}

				#if d:デモ前五秒間待ち
					eval($w:t_story = d:ST_T02a1Dカメラの使い方ポリゴンデモ開始-1)
					eval($f:t02カメラデモ後半 = 0)
					@global_五秒待ちセット
					if($f:global_デバッグポーズ通過){
						@デモ再生_t02a1D
					}
				#else
					@デモ再生_t02a1D
				#endif

			}else{
				// こちらでストーリーフラグを立てること。
				#if d:DEMO_SKIP_ENABLE
					eval($w:t_story = d:ST_T03a1Dカモフ登場ポリゴンデモ終了)
					print '統合_$w:t_story = d:ST_T03a1Dカモフ登場ポリゴンデモ終了'
				#else
					eval($w:t_story = d:ST_T02a1Dカメラの使い方ポリゴンデモ開始)
					print '統合_$w:t_story = d:ST_T02a1Dカメラの使い方ポリゴンデモ開始'
				#endif

				eval($f:t02カメラデモ後半 = 0)
				print '$f:t02カメラデモ後半 = 0'

				@デモモデル差し替え処理
				proc デモ再生_t02a2D {
				#if d:デモ前五秒間待ち
					chara デモアクトデバッグ demodebug  -i t:t02a1D -d 't02a1D' -l  -v 0  \
						-next t02a2D終了 \			// 終了時に呼び出されるproc
						-p カメラ雨しぶきＯＮ カメラ雨しぶきＯＦＦ
				#else
					chara demo デモ再生 \
						-i t:t02a2D \			// ストリーミング用t:シンボル camera_2nd_half (後半)
						-p カメラ雨しぶきＯＮ カメラ雨しぶきＯＦＦ \
						-next t02a2D終了			// 終了時に呼び出されるproc
				#endif
				}

				#if d:デモ前五秒間待ち
					eval($w:t_story = d:ST_T02a1Dカメラの使い方ポリゴンデモ開始-1)
					eval($f:t02カメラデモ後半 = 1)
					@global_五秒待ちセット
					if($f:global_デバッグポーズ通過){
						@デモ再生_t02a2D
					}
				#else
					@デモ再生_t02a2D
				#endif

			}

		} else if($w:t_story < d:ST_T03a1Dカモフ登場ポリゴンデモ開始) {
			eval($w:t_story = d:ST_T03a1Dカモフ登場ポリゴンデモ開始)
			print '統合_$w:t_story = d:ST_T03a1Dカモフ登場ポリゴンデモ開始'

			// デモ固有の変数代入
			eval($s:d_num = t03a1D)

				@デモモデル差し替え処理
				proc デモ再生_t03a1D {
					#if d:デモ前五秒間待ち
						chara デモアクトデバッグ demodebug  -i t:t02a1D -d 't02a1D' -l  -v 0  \
							-next t03a1D終了 \			// 終了時に呼び出されるproc
							-p カメラ雨しぶきＯＮ カメラ雨しぶきＯＦＦ
					#else
						chara demo デモ再生 \
							-i t:t03a1D \			// ストリーミング用t:シンボル entry_kamof
							-p カメラ雨しぶきＯＮ カメラ雨しぶきＯＦＦ \
							-next t03a1D終了			// 終了時に呼び出されるproc
					#endif
				}

				#if d:デモ前五秒間待ち
					eval($w:t_story = d:ST_T03a1Dカモフ登場ポリゴンデモ開始-1)
					@global_五秒待ちセット
					if($f:global_デバッグポーズ通過){
						@デモ再生_t03a1D
					}
				#else
					@デモ再生_t03a1D
				#endif

		} else if($w:t_story < d:ST_T03b1Rカモフ登場後無線機デモ開始) {

			eval($f:t03a1無線 = 1)
			chara サウンドマネージャー ＳＤマネ -pak 0
			//サウンドマネージャーだけ書くと雨・風ＳＥがなってしまうので、下でそれらのプロックをはずしてやる。

			command セットサウンドコード -c d:SNG_PLAY_06		//ＢＧＭ雨音

			#if d:体験版
				@rt_強制ＣＡＬＬ_T_03b1Rカモフ登場後無線機デモ体験版
			#else
				@rt_強制ＣＡＬＬ_T_03b1Rカモフ登場後無線機デモ製品版
			#endif

		}

	#else

		proc ld_next_stage {
			mesg デモキャンセルチェック デモキャンセル kill

			print '$w:t_story = d:ST_T01a1D目的説明ポリゴンデモ終了'
			eval($w:t_story = d:ST_T01a1D目的説明ポリゴンデモ終了)

			chara delay ディレイ \
				-time 1 \
				-exec{
					@mv_init_w00a_0
				}
		}

		proc demo_cancel {
			command StreamStopAll
		}

		chara デモキャンセルチェック デモキャンセル \
			-p demo_cancel

		print '$w:t_story = d:ST_T01a1D目的説明ポリゴンデモ開始'
		eval($w:t_story = d:ST_T01a1D目的説明ポリゴンデモ開始)


		chara demo デモ再生 \
		#if d:体験版
			-i t:t01a2D \			// ストリーミング用t:シンボル 目的説明デモ（体験版）
		#else
			-i t:t01a1D \			// ストリーミング用t:シンボル 目的説明デモ
		#endif
			-next ld_next_stage			// 終了時に呼び出されるproc
	#endif

#endif

	@常駐キャラ設定						// stdch.hで定義

	if(!$f:t03a1無線){
	//---------------------------------------------------------------
	// さわる必要のないもの。外したい場合は、行の先端に「//」を入れる。
	//---------------------------------------------------------------
print 'main_001'
		@カメラ雨セット
print 'main_002'
		@天球_新空_新雷セット
print 'main_003'
		@霧雨セット
print 'main_004'
		@岡嶋ブラーセット
print 'main_005'
		@旗_ワイヤーセット
		@レーダークルクル

		@投光器セット
		@タンカーセット
		@水密ドアセット
print 'main_006'
//	@スローモーションセット < これは速度可変雨専用？
print 'main_007'
		@シネマスクリーンセット
print 'main_008'
		@波面セット
print 'main_009'
		@w00a_マンハッタンセット

print 'main_010'
		@風制御セット
print 'main_011'
		@雨セット
print 'main_012'
// 	フォグ値は事故防止のため、以後全面的にデモツール側で付ける(00.11.06）
//	@フォグセット
print 'main_013'
		@川岸のぼかし
print 'main_014'

		@タンカー上の各種エフェクトセット
print 'main_015'

	}

} // <command マップ設定 タンカー>の閉じカッコ

// ====================================
// 初期マップ表示
// ====================================
	command マップ表示 -show タンカー

// マップshowの後でセットすること。各数値に関しては、下の説明参照。

#if 1
	// t01
	if($s:d_num == t01a1D) {
		@キャラクタ専用ライトセット     6 20 30 \
									   86 85 48 \
									-1287 -3357 -5545

	// t02
	} else if($s:d_num == t02a1D) {
		chara 環境光 環境光 \
			 -c 6 20 30
		chara 平行光 平行光 \
			 -c 86 85 48 \
			 -p -1287 -3357 -5545 // これはpos。

	// t03（w00bと同じ値）
	} else if($s:d_num == t03a1D) {
		chara 環境光 環境光 \
			 -c 53,73,55
		chara 平行光 平行光 \
			 -c 70,230,214 \
			 -d 691,721,0 // これはrot。
	}
#else
	// t01
	if($w:t_story < d:ST_T01a1D目的説明ポリゴンデモ開始) {
		@キャラクタ専用ライトセット     6 20 30 \
									   86 85 48 \
									-1287 -3357 -5545

	// t02
	} else if(($w:t_story >= d:ST_T01b1G装備品説明シナリオデモ終了) && \
				($w:t_story < d:ST_T02a1Dカメラの使い方ポリゴンデモ終了)) {
		chara 環境光 環境光 \
			 -c 6 20 30
		chara 平行光 平行光 \
			 -c 86 85 48 \
			 -p -1287 -3357 -5545 // これはpos。

	// t03（w00bと同じ値）
	} else if($w:t_story >= d:ST_T02a1Dカメラの使い方ポリゴンデモ終了) {
		chara 環境光 環境光 \
			 -c 53,73,55
		chara 平行光 平行光 \
			 -c 70,230,214 \
			 -d 691,721,0 // これはrot。
	}
#endif

