proc 風制御セット {
	chara 風制御 wind \
		-i 100 \			// 通常風速のＭＡＸ値
		-j 300 \			// 突風風速のＭＡＸ値
		-r -1024 1024 0 \	// 通常風の方向（0 0 0 で真下に向かって吹く）
		-a 4 \				// 方向のランダム幅（4096で360度を表す）
		-b 300 \			// 突風頻度（何フレームに一回（目安））
		-c 150				// 突風持続時間のＭＡＸ値（フレーム数）
}

proc 雨セット {
	chara 雨 rain \
		-n 16 \		// 量
		-c 128
}


proc 波面セット {
print 'wave_set'

	// 左舷中心に見せる



	if($s:d_num == t01a1D) {
		// 現在の波面は波濤専用プログラム


		#if d:波濤出す
			chara 波面 wave1 \
				-p 0,-4000,0 \	// 中心位置
				-s 8 \		// 波濤の出現周期
				-n 5 \			// 波濤の数
				-no_sound \   // 音を鳴らしたくない
				-w 5 5 \
				-b 	          0,5200, 20500,3,    0,-40 \	// 船尾の波濤
						  14000,5700, 11000,4, 1251,-60 \	// 右舷船尾脇の波濤
						 -12500,5600, 15000,4, 1251,-60 \	//  船尾から二番目
						 -16500,5700,  4500,4,-1251,-60 \	// 左舷波濤真ん中あたり
						 -19500,5600,-10000,4,-1251,-60 \	// 左舷波濤船尾より
/*				-b 	          0,5200, 20500,3,    0,  0 \	// 船尾の波濤
						  14000,5700, 11000,4, 1251,-35 \	// 右舷船尾脇の波濤
						 -12500,5600, 15000,4, 1251,-35 \	//  船尾から二番目
						 -16500,5700,  4500,4,-1251,-35 \	// 左舷波濤真ん中あたり
						 -19500,5600,-10000,4,-1251,-35 \	// 左舷波濤船尾より
*/
				-x 0,-135500 20000,132500

			// 波濤の数は最大５個であるので、chara 波面 自体を複数配置。
			chara 波面 wave2 \
				-p 0,-4000,0 \	// 中心位置
				-s 14 \		// 波濤の出現周期
				-n 5 \			// 波濤の数
				-no_sound \   // 音を鳴らしたくない
				-w 5 5 \
				-b		 -12500,5700,  19500,4, 1251,-60 \	//  船尾から一番目
						  15000,5600, 15000,4,  1251,-60 \	//
						 -16000,5600,   9500,4,-1251,-60 \	//
						 -17500,5700,  -2500,4,-1251,-60 \	//
						 -22000,5600, -17500,4,-1251,-60 \	//
/*				-b		 -12500,5700,  19500,4, 1251,-35 \	//  船尾から一番目
						  15000,5600, 15000,4,  1251,-35 \	//
						 -16000,5600,   9500,4,-1251,-35 \	//
						 -17500,5700,  -2500,4,-1251,-35 \	//
						 -22000,5600, -17500,4,-1251,-35 \	//
*/
				-x 0,-135500 20000,132500
		#endif

	// 両舷とも見せる



	} else if($s:d_num == t02a1D) {
		#if d:波濤出す
			// 左舷
			chara 波面 wave_l1 \
				-p 0,-4000,0 \	// 中心位置
				-s 8 \		// 波濤の出現周期
				-n 5 \			// 波濤の数
				-no_sound \   // 音を鳴らしたくない
				-w 5 5 \
				-b 	          0,200, 20500,3,    0,  0 \	// 船尾の波濤
						  12500,700, 11000,4, 1251,-35 \	// 右舷船尾脇の波濤
						 -12000,600, 15000,2,-1251,-35 \	// 船尾から二番目
						 -16500,700,  4500,2, 1251,-35 \	// 左舷波濤真ん中あたり
						 -19500,600,-10000,2,-1251,-35 \	// 左舷波濤船尾より
				-x 0,-135500 20000,132500
			chara 波面 wave_l2 \
				-p 0,-4000,0 \	// 中心位置
				-s 12 \		// 波濤の出現周期
				-n 5 \			// 波濤の数
				-no_sound \   // 音を鳴らしたくない
				-w 5 5 \
				-b		 -11500,700,  19500,2, 1251,-35 \	// 船尾から一番目
						  12000,600,  14500,2, 1251,-35 \	//
						 -14500,600,   9500,2,-1251,-35 \	//
						 -17500,700,  -2500,2,-1251,-35 \	//
						 -22000,600, -17500,2,-1251,-35 \	//
				-x 0,-135500 20000,132500
			chara 波面 wave_l3 \
				-p 0,-4000,0 \	// 中心位置
				-s 10 \		// 波濤の出現周期
				-n 5 \			// 波濤の数
				-no_sound \   // 音を鳴らしたくない
				-w 5 5 \
				-b		 -22500,600, -17500,3,-1251,-35 \	//
						 -22500,600, -25500,3,-1251,-35 \	//
			 			 -22500,600, -31500,3,-1251,-35 \	//
			 			 -22500,600, -37500,3,-1251,-35 \	//
			 			 -22500,600, -48500,3,-1251,-35 \	//
			 			-x 0,-135500 20000,132500

			// 右舷
			chara 波面 wave_r1 \
				-p 0,-4000,0 \	// 中心位置
				-s 8 \		// 波濤の出現周期
				-n 5 \			// 波濤の数
				-no_sound \   // 音を鳴らしたくない
				-w 5 5 \
				-b 	          0,200, 20500,3,    0,  0 \	// 船尾の波濤
						  12500,700, 11000,4, 1251,-35 \	// 右舷船尾脇の波濤
						  12000,600, 15000,2,-1251,-35 \	// 左舷波濤船首より
						  16500,700,  4500,2, 1251,-35 \	// 左舷波濤真ん中あたり
						  19500,600,-10000,2,-1251,-35 \	// 左舷波濤船尾より
				-x 0,-135500 20000,132500
			chara 波面 wave_r2 \
				-p 0,-4000,0 \	// 中心位置
				-s 12 \		// 波濤の出現周期
				-n 5 \			// 波濤の数
				-no_sound \   // 音を鳴らしたくない
				-w 5 5 \
				-b		   7500,700,  19500,2,-1251,-35 \	//
						  12000,600,  14500,2, 1251,-35 \	//
						  14500,600,   9500,2,-1251,-35 \	//
						  17500,700,  -2500,2,-1251,-35 \	//
						  22000,600, -17500,2,-1251,-35 \	//
				-x 0,-135500 20000,132500
			chara 波面 wave_r3 \
				-p 0,-4000,0 \	// 中心位置
				-s 10 \		// 波濤の出現周期
				-n 5 \			// 波濤の数
				-no_sound \   // 音を鳴らしたくない
				-w 5 5 \
				-b		  23000,600, -17500,3,-1251,-35 \	//
						  23000,600, -25500,3,-1251,-35 \	//
			 			  23000,600, -31500,3,-1251,-35 \	//
			 			  23000,600, -37500,3,-1251,-35 \	//
			 			  22500,600, -48500,3,-1251,-35 \	//
			 			-x 0,-135500 20000,132500
		#endif

	} else {
		#if d:波濤出す
		// 船尾とその右側だけでＯＫ
			chara 波面 wave_r1 \
				-p 0,-4000,0 \	// 中心位置
				-s 8 \		// 波濤の出現周期
				-n 3 \			// 波濤の数
				-no_sound \   // 音を鳴らしたくない
				-w 5 5 \
				-b 	          0,200, 20500,3,    0,  0 \	// 船尾の波濤
						  7500,700,  19500,3,-1251,-35 \	// 右舷船尾脇の波濤
						  12500,700, 11000,4, 1251,-35 \	// 右舷船尾脇奥の波濤
				-x 0,-135500 20000,132500
		#endif
	}


	chara 嵐の川波 高波 \
		-tex wave wave06 wave09_alp_ovl \
		-dir 100,-20,100 \		// ローカル並行光ベクトル
		-color 160,160,160 \	// 平行光ＲＧＢ
		-ambient 10,10,10 \		// 環境光ＲＧＢ
		-pos 0,-4000,0

print 'wave_set_end!!!!!!!!!!'

}

proc w00a_マンハッタンセット {
print 'マンハッタンセット000'
	// 01,02,03 全部でマンハッタンの高さは共通。
	chara マンハッタン manhattern \
		-l w00a \
	    -h -8500

print 'マンハッタンセット001'
	chara ブルックリン blucking \
		-l w00a
print 'マンハッタンセット002'
	chara マンハット黄灯 黄灯
















print 'マンハッタンセット003'
	chara マンハット赤灯1 赤灯1
print 'マンハッタンセット004'
	chara マンハット赤灯2 赤灯2
print 'マンハッタンセット005'
	chara ブルックリン赤灯 赤灯















print 'マンハッタンセット006'
}


proc フォグセット {
	chara フォグ 霧 \
		 -c 16 32 27 \		// ＲＧＢ
		 -n -5000 \			// ニア値
		 -f 36000			// ファー値
}

proc 川岸のぼかし {
	chara 遠景ぼかし far_blur \
		-plane	2 \			// 枚数


















		-near	50000 \		// ニア値
		-far	100000 \	// ファー値
		-enable
}

proc キャラクタ専用ライトセット $:環境光Ｒ $:環境光Ｇ $:環境光Ｂ $:平行光Ｒ $:平行光Ｇ $:平行光Ｂ $:平行光光源Ｘ $:平行光光源Ｙ $:平行光光源Ｚ {
print 'chara_light_start'
	chara 環境光 アンビ \
		 -c $:環境光Ｒ $:環境光Ｇ $:環境光Ｂ
//		 -c 6 20 30

	chara 平行光 パラ \
		 -c $:平行光Ｒ $:平行光Ｇ $:平行光Ｂ \
		 -d $:平行光光源Ｘ $:平行光光源Ｙ $:平行光光源Ｚ
//		 -c 86 85 48 \
//		 -d -1287 -3357 -5545
print 'chara_light_end'
}

proc カメラ雨セット {
print 'camera_rain_set'
	//「プットテクスチャクロスフェードカメラ」と
	//「プットテクスチャクロスフェードカメラドア」の前にセットする









	chara カメラ雨 カメラ雨 \
		-l 0 \
		-i 1	// 不可視起動
print 'camera_rain_set_end'
}

