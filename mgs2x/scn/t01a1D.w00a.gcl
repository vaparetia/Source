proc 天球_新空_新雷セット {
	chara 天球 背景

	// 空は 02 のみ低くする。
	if($w:t_story < d:ST_T02a1Dカメラの使い方ポリゴンデモ開始) {
		chara 新空 NEW_SKY \
			-u 1 \ // 注：このパラメータは触ってはいけない。
			-h 220000 \ // $i:設定すると雲を任意の高さにセットする








			-m w00_sky //(必ず設定)
	} else {
		chara 新空 new_sky -m w00_sky
	}

	chara 新雷フラッシュ thunder
}

