//chara サウンドマネージャー ＳＤマネ -pak 0

/******************************************************************/
/* リソース */
/******************************************************************/
proc resident_clear {
	/* 常駐ディレクトリ情報クリア（2001．9.4 園山追加） */
	dim $i:常駐ディレクトリ[ 4 ]
	eval ( $i:常駐ディレクトリ[ 0 ] = 0 )
	eval ( $i:常駐ディレクトリ[ 1 ] = 0 )
	eval ( $i:常駐ディレクトリ[ 2 ] = 0 )
	eval ( $i:常駐ディレクトリ[ 3 ] = 0 )
	command varsave $i:常駐ディレクトリ[ 0 ]
	command varsave $i:常駐ディレクトリ[ 1 ]
	command varsave $i:常駐ディレクトリ[ 2 ]
	command varsave $i:常駐ディレクトリ[ 3 ]
}

