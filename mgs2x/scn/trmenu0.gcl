command ローカルリソース設定 \
	-string オプションの説明日本語 		[オプションの説明日本語:*] \
			オプションの説明英語 		[オプションの説明英語:*] \
			オプションの説明フランス語 	[オプションの説明フランス語:*] \
			オプションの説明ドイツ語	[オプションの説明ドイツ語:*] \
			オプションの説明スペイン語 	[オプションの説明スペイン語:*] \
			オプションの説明イタリア語 	[オプションの説明イタリア語:*] \
			レーダーの説明日本語	[レーダーの説明日本語:*] \
			レーダーの説明英語		[レーダーの説明英語:*] \
			レーダーの説明フランス語[レーダーの説明フランス語:*] \
			レーダーの説明ドイツ語	[レーダーの説明ドイツ語:*] \
			レーダーの説明スペイン語[レーダーの説明スペイン語:*] \
			レーダーの説明イタリア語[レーダーの説明イタリア語:*] \
			クイックチェンジの説明日本語	[クイックチェンジの説明日本語:*] \
			クイックチェンジの説明英語		[クイックチェンジの説明英語:*] \
			クイックチェンジの説明フランス語[クイックチェンジの説明フランス語:*] \
			クイックチェンジの説明ドイツ語	[クイックチェンジの説明ドイツ語:*] \
			クイックチェンジの説明スペイン語[クイックチェンジの説明スペイン語:*] \
			クイックチェンジの説明イタリア語[クイックチェンジの説明イタリア語:*] 

/******************************************************************/
//	初期セットキャラ
/******************************************************************/
chara 2Dレイアウトドライバ ２ＤＬＤ

chara ＶＲ体験版タイトル ＶＲ体験版タイトル \
	-new_game  ＮＥＷ \
	-load_game ＬＯＡＤ \
	-save_game ＳＡＶＥ \
	-options   ＯＰＴＩＯＮＳ \
	-exit      ＥＸＩＴ

mesg ＶＲ体験版タイトル ＶＲ体験版タイトル 表示 0

chara ノード画面フレームアニメーション体験版 ノードフレーム \
	-d frame 

proc ＮＥＷ {
#if d:DEBUG_PRINT 
	print 'new'
#endif
	command 変数初期化
	eval( $b:ＶＲ体験版ステージ番号 = 0 ) ;
	@resident_clear ;
	command ミッションズデータ初期化
	@mv_trmenu_1 ;
}

proc ＬＯＡＤ {
#if d:DEBUG_PRINT 
	print 'load'
#endif
	chara ロードゲーム画面マネージャー ロード画面 \
		-d save_load \
		-p ロードゲーム終了 \
		-b tnkicon \
		-m d:SAVE_LOAD_MODE_VR
}

proc ＳＡＶＥ {
#if d:DEBUG_PRINT 
	print 'save'
#endif
}

proc ＯＰＴＩＯＮＳ {
	@sel_option ;
#if d:DEBUG_PRINT 
	print 'options'
#endif
}

proc ＥＸＩＴ {
#if d:DEBUG_PRINT 
	print 'exit'
#endif
    command reboot;
}

/***************************************************************************************************/
// オプション
/***************************************************************************************************/

proc sel_option {
	chara オプション画面マネージャー オプション画面 \
		-d node_menu \
		-p オプション終了プロシージャー \
		-b バックグラウンド \
		-n 	2 \
		-l 	7 1 \ //先頭がデフォルトの言語に設定されています。(字幕OFF時の言語)
		-r 	オプションの説明英語 		レーダーの説明英語 			クイックチェンジの説明英語 		 \
			オプションの説明フランス語 	レーダーの説明フランス語	クイックチェンジの説明フランス語 \
			オプションの説明ドイツ語 	レーダーの説明ドイツ語 		クイックチェンジの説明ドイツ語 	 \
			オプションの説明スペイン語 	レーダーの説明スペイン語 	クイックチェンジの説明スペイン語 \
			オプションの説明イタリア語 	レーダーの説明イタリア語 	クイックチェンジの説明イタリア語 \
			0 0 0 \ //韓国語
			オプションの説明日本語 		レーダーの説明日本語 		クイックチェンジの説明日本語 	 		
}

proc オプション終了プロシージャー {
	mesg ＶＲ体験版タイトル ＶＲ体験版タイトル 表示 3
#ifdef d:EU
//	command 字幕言語設定
#endif

}

proc ロードゲーム終了 $:返り値 {
	if( $:返り値 == 1 ) {
print '1korekorkeorkoekroekrokrkoe' $w:言語 
		command store_loadedvar
print '2korekorkeorkoekroekrokrkoe' $w:言語 
		eval( $b:ＶＲ体験版ステージ番号 = 0 ) ;
		@resident_clear;
print '3korekorkeorkoekroekrokrkoe' $w:言語 
		@mv_trmenu_1 ;
	} else {
		mesg ＶＲ体験版タイトル ＶＲ体験版タイトル 表示 2
	}
}

#include "loadgame.rsc"
#include "mcwarning.rsc"
