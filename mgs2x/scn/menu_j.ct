proc rt_ＳＡＶＥデフォルトセット:07 {
print 'ほげほほほ'
	selectmenu  2 -m  { 
		[ＳＡＶＥ联买昏:セ〖ブする] 
		[ＳＡＶＥ联买昏:セ〖ブしない] 
	}
	eval($w:rft_ＳＡＶＥ联买昏手り猛 = $status)
print 'ぷにょあよあああ'
