resource P070_18_R02_ＡＧ起動１８無線機デモ２＿１__f {
//vc117011
ライデン_000: {
Mr. X ? Le ninja ?
}
//	<<<ENGLISH>>>
//	Mister X...?
//	Ninja...?

/*ミスターＸも忍者も……。*/
オルガ_001: {
Exact. C'est bien moi !
}
//	<<<ENGLISH>>>
//	Correct... it's me.

/*そう、私。*/
ライデン_002: {
Je croyais que tu commandais
les troupes russes...
}
//	<<<ENGLISH>>>
//	I thought you were the leader
//	of the Russian troops...

/*君はロシア兵のリーダー
じゃなかったのか？*/
オルガ_003: {
Non. Ce n'&'etait qu'un &'ecran de fum&'ee.
}
//	<<<ENGLISH>>>
//	No. That was just
//	a smoke screen.

/*……いいえ。
それは表向きの役割……。*/
ライデン_004: {
Un &'ecran de fum&'ee ?
}
//	<<<ENGLISH>>>
//	A smoke screen?

/*表向き？*/
オルガ_005: {
Je suis ici pour t'aider.
}
//	<<<ENGLISH>>>
//	I was sent to provide
//	you support.

/*ええ……
本当の役割はあなたのサポート……。*/
ライデン_006: {
Pour m'aider ? Qui t'envoie ?
Le Colonel ?
}
//	<<<ENGLISH>>>
//	Support? Who sent you?
//	The Colonel?

/*俺のサポート？
誰の命令で？
大佐か？*/
オルガ_007: {
Non... Les Patriotes...
}
//	<<<ENGLISH>>>
//	No... the Patriots.

/*いいえ……『愛国者達』。*/
ライデン_008: {
Quoi !?
}
//	<<<ENGLISH(2)>>>
//	What!?

/*なんだって！？*/
オルガ_009: {
J'ai tromp&'e mes troupes...
Je les ai trahies...
}
//	<<<ENGLISH>>>
//	I... I deceived my troops...
//	betrayed them...

/*私は……部隊の皆を騙し、裏切っている。*/
ライデン_010: {
Pourquoi ?
}
//	<<<ENGLISH(2)>>>
//	But why?

/*どういうことなんだ……？*/
オルガ_011: {
Mon enfant... a &'et&'e pris en otage par
les Patriotes.
}
//	<<<ENGLISH>>>
//	My child is... being held
//	hostage by the Patriots.

/*……子供が……
『愛国者達』に捕らわれているの……。*/
オルガ_012: {
Tout a commenc&'e il y a deux ans, lorsque
j'ai perdu mon p&`ere, au cours de l'incident
du tanker...
}
//	<<<ENGLISH>>>
//	It all started two years ago when
//	I lost my father during the tanker
//	incident...

/*二年前、あのタンカーと一緒に父を
失った後……。*/
オルガ_013: {
Mes hommes et moi-m&^eme ne savions pas
o&`u aller... Nous nous sommes alors alli&'es &`a
une organisation russe ill&'egale...
}
//	<<<ENGLISH(2)>>>
//	My men and I had nowhere to go...
//	so we joined forces with an illegal
//	Russian organization.

/*行くところのない私達はロシアと
つながりのある非合法組織に拾われた。*/
ライデン_014: {
La mafia russe ?
}
//	<<<ENGLISH>>>
//	The Russian Mafia?

/*マフィア？*/
オルガ_015: {
Quelque chose dans ce go&^ut-l&`a...
}
//	<<<ENGLISH(2)>>>
//	Something like that.

//<ページ数変更>
オルガ_015_1: {
J'ai appris bien plus tard que cet
organisme &'etait en fait un sous-groupe
des Patriotes.
}
//	<<<ENGLISH>>>
//	Actually, I learned much later that
//	it was a subordinate organization
//	of the Patriots.

/*そう呼んでも良い。
だけどそこが『愛国者達』の下部組織
だと知ったのはずっと後のことだった。
*/
オルガ_016: {
J'&'etais enceinte.
}
//	<<<ENGLISH>>>
//	I was expecting at the time.

//<ページ数変更>
オルガ_016_1: {
Quand j'ai accouch&'e, j'ai compris que
l'h&^opital o&`u je me trouvais &'etait g&'er&'e
par les Patriotes.
}
//	<<<ENGLISH>>>
//	When I gave birth to my child,
//	it turned out I was in a hospital
//	run by the Patriots.

/*身重だった私は、何も知らずに奴等の
病院で子供を生んだ。
*/
オルガ_017: {
Le matin suivant, mon enfant avait disparu.
Il est d&'etenu quelque part dans ce pays.
}
//	<<<ENGLISH>>>
//	In the morning... my child was gone.
//	My baby is being kept somewhere in
//	this country.

/*目が覚めた時はもう……あの子は奴等に
奪われていた。今もこの国の何処かで
暮らしている。*/
ライデン_018: {
As-tu d&'ej&`a vu ton enfant ?
}
//	<<<ENGLISH>>>
//	Have you ever met your child?

/*会った事は？*/
オルガ_019: {
Non ! Tous les mois, ils m'envoient
une photo de lvi par le r&'eseau.
}
//	<<<ENGLISH>>>
//	No. Once a month, they send me
//	a photo of my child via network.

//<ページ数変更>
オルガ_019_1: {
Je ne l'ai jamais tenu dans mes bras...
}
//	<<<ENGLISH(2)>>>
//	I've never even held the
//	child in my own arms...

/*ないわ。月に一度、ネッワーク経由で
映像が送られてくる。私はまだあの子を
この手に抱いたことはない。
*/
ライデン_020: {
Je vois...
}
//	<<<ENGLISH(2)>>>
//	I see...

/*……そうか……。*/
ライデン_021: {
Vu la situation, tes actes sont tout
&`a fait justifi&'es...
}
//	<<<ENGLISH>>>
//	Given your situation, nobody can
//	blame you for what you did.

/*そういう事情なら……仕方ないさ。
誰も君を責められない……。*/
オルガ_022: {
C'est ton opinion, pas la mienne...
}
//	<<<ENGLISH>>>
//	That's your opinion...

/*……そうかしら……。*/
ライデン_023: {
Et Snake ? Je croyais que vous &'etiez
ennemis...
}
//	<<<ENGLISH>>>
//	What about Snake?
//	I thought you were
//	enemies...

/*……スネークとは？
彼とは敵対していたんじゃ？*/
オルガ_024: {
Il n'est absolument pas responsable
de la mort de mon p&`ere... En fait, si nous
vivons toujours, c'est gr&^ace &`a lui...
}
//	<<<ENGLISH>>>
//	He wasn't responsible for
//	my father's death. Actually,
//	we owe him our lives.

/*彼等は父の仇じゃなかった……
命の恩人だったのよ。*/
}
//d



resource P070_20_R03_ＡＧ起動２０無線機デモ３＿１__f {
//Vc117021
ライデン_000: {
Tu lui as uniquement pr&^et&'e main
forte pour payer ta dette ?
}
//	<<<ENGLISH>>>
//	So you joined hands with him
//	to pay back a debt?

/*手を組んだのは恩返しってわけか？*/
オルガ_001: {
Non. Nous avions tous les deux int&'er&^et
&`a collaborer...
}
//	<<<ENGLISH>>>
//	No. Mutual gain...

/*いいえ。
相互利益のための協力ってところね。*/
ライデン_002: {
Int&'er&^et ?
}
//	<<<ENGLISH>>>
//	Mutual gain?

/*利益？*/
オルガ_003: {
Mon travail &'etait de t'aider.
}
//	<<<ENGLISH>>>
//	My job was to assist you.

/*あなたをサポートすること。
それが私に課せられた役割。*/
オルガ_004: {
Si Solidus se fait la malle avec l'Arsenal,
ta mission aura &'et&'e un &'echec.
}
//	<<<ENGLISH>>>
//	If Solidus gets away with Arsenal,
//	your mission is a failure.

/*ソリダスがアーセナルを手に入れれば
あなたの任務も失敗。私も役割を果たせ
なかったと見なされる。
*/
オルガ_005: {
Or, si tu &'echoues, les Patriotes
m'accuseront et tueront mon enfant.
}
//	<<<ENGLISH>>>
//	The Patriots would judge that as
//	failure on my part and terminate
//	my child.

//<ページ数変更>
オルガ_005_1: {
Sa survie d&'epend de ta r&'eussite.
}
//	<<<ENGLISH>>>
//	Putting it simply, my child's
//	life depends on your success.

/*……『愛国者達』はあの子を殺すわ。
だからあなた達を助けることがあの子を
助けることになる……。*/
ライデン_006: {
Ton enfant est ta seule motivation...
}
//	<<<ENGLISH>>>
//	So you did it all for your child.

//<ページ数変更>
ライデン_006_1: {
Mais que gagnent les Patriotes &`a
m'aider ? Attendent-ils que je
les d&'ebarrasse de Solidus ?
}
//	<<<ENGLISH>>>
//	But why would the Patriots want to
//	help me? Are they hoping I'll take
//	Solidus out?

/*全ては子供のため、か……
だがなぜ『愛国者達』が俺を助けようと
する？ソリダスを倒すためか？
*/
オルガ_007: {
Non ! Nous sommes log&'es &`a la m&^eme
enseigne... Nous ne sommes que
des pions...
}
//	<<<ENGLISH>>>
//	No. You're just like me...
//	we're just pawns...

/*いいえ……あなたも私と同じ。
骨の髄まで利用されている……。*/
ライデン_008: {
Je veux bien, mais dans quel but ?
}
//	<<<ENGLISH>>>
//	Pawns for what purpose?

/*何を言ってる？*/
オルガ_009: {
Nous participons au Plan S3...
}
//	<<<ENGLISH>>>
//	The S3 Plan...

/*Ｓ３計画……。*/
ライデン_010: {
Hein?
}
//	<<<ENGLISH>>>
//	Huh?

/*？*/
オルガ_011: {
Tu comprendras assez t&^ot...
Mais je me demande comment
tu accepteras les r&'ealit&'es...
}
//	<<<ENGLISH>>>
//	You'll figure it out sooner or
//	later -- but I wonder if you'll
//	handle the truth?

/*いずれわかる……
その辛さを克服できるかどうか……。*/
ライデン_012: {
Que veux-tu dire ?
}
//	<<<ENGLISH(2)>>>
//	What do you mean?

/*どういうことだ？*/
オルガ_013: {
Ecoute... Nous n'avons pas
le temps d'entrer dans les d&'etails.
}
//	<<<ENGLISH>>>
//	Listen... we haven't
//	got time for this.

//<ページ数変更>
オルガ_013_1: {
L'attaque de Solidus est imminente.
Il faut l'arr&^eter !
}
//	<<<ENGLISH>>>
//	Solidus will commence his
//	attack any minute. He's got
//	to be stopped.

/*時間がない。
ソリダスは今にも攻撃を開始する。
奴を止めなければ……。
*/
ライデン_014: {
Et le virus ?
}
//	<<<ENGLISH>>>
//	What about the virus?

/*ウィルスは？*/
オルガ_015: {
Encore aucun r&'esultat.
Les Patriotes ont trafique le programme.
}
//	<<<ENGLISH>>>
//	No results so far. I think the
//	Patriots have tampered with
//	the program.

/*まだ効果は現れてない。
やはり『愛国者達』が手を加えていた
ようね。*/
ライデン_016: {
Finira-t-il ?
}
//	<<<ENGLISH>>>
//	Will it work?

/*効くのか？*/
オルガ_017: {
Je ne sais pas...
}
//	<<<ENGLISH(2)>>>
//	I don't know...

/*わからない……。*/
ライデン_018: {
D&'egage-moi...
}
//	<<<ENGLISH>>>
//	Get me out of this thing.

/*これをはずしてくれ。*/
オルガ_019: {
Pas encore. Je te d&'etacherai apr&`es mon
d&'epart de cette pi&`ece.
}
//	<<<ENGLISH>>>
//	Not yet. I'll release your
//	restraints after I leave
//	this room.

/*今はできない。
私がここを出てから拘束を解除する。*/
ライデン_020: {
O&`u est mon &'equipement ?
}
//	<<<ENGLISH(2)>>>
//	Where's my gear?

/*俺の装備は？*/
オルガ_021: {
C'est Snake qui l'a.
Je n'ai pas pu l'apporter...
}
//	<<<ENGLISH>>>
//	Snake's got everything.
//	I couldn't bring it here.

/*スネークに預けた。
ここでは渡せない。*/
ライデン_022: {
Et o&`u est, Snake ?
}
//	<<<ENGLISH>>>
//	And where do I find Snake?

/*彼は何処に？*/
}
//d



resource P070_23_R04_ＡＧ起動２３無線機デモ４＿１__f {
//Vc117031
ローズ_000: {
Jack, tu vas bien ?
}
//	<<<ENGLISH(2)>>>
//	Jack, are you all right?

/*ジャック、大丈夫？*/
ライデン_001: {
Ah... Oui...
}
//	<<<ENGLISH>>>
//	Oh, y-yeah.

/*あ、ああ……。*/
ローズ_002: {
Jack ?
C'est vrai, ce qu'a racont&'e Solidus ?
}
//	<<<ENGLISH>>>
//	Jack, is it true?
//	What Solidus said?

/*ジャック、ソリダスの話。
本当なの？*/
ライデン_003: {
... Oui.
}
//	<<<ENGLISH(2)>>>
//	...Yes.

/*……本当だ。*/
ローズ_004: {
C'est incroyable...
}
//	<<<ENGLISH>>>
//	It's unbelievable...

//<ページ数変更>
ローズ_004_1: {
Enr&^oler de jeunes enfants et les envoyer
au front. C'est en dehors des conventions
internationales !
}
//	<<<ENGLISH>>>
//	Drafting small children, sending
//	them to war -- it's not allowed
//	under international conventions.

/*信じられない。そんな事が……
子供を徴兵したり、戦闘グループに
参加させたりする事は禁られているはず。
*/
ライデン_005: {
En pleine guerre, les r&`egles du Tribunal
p&'enal international ne servent &`a rien !
}
//	<<<ENGLISH>>>
//	ICC rules don't mean
//	a lot in war.

/*法律なんて、戦場での歯止めには
ならない。*/
ライデン_006: {
Plus de trois cent mille mineurs
participeraient actuellement &`a
des combats. 
}
//	<<<ENGLISH>>>
//	Someone told me that there are
//	over three hundred thousand
//	children in combat right now.

//<ページ数変更>
ライデン_006_1: {
Je n'&'etais qu'un d'entre eux...
}
//	<<<ENGLISH>>>
//	I was just one of them...

/*今現在も、戦闘に参加している子供は
３０万人以上もいる。
俺もそのうちの一人だった……。
*/
ローズ_007: {
Tu t'en souviens ? Je croyais que ta
m&'emoire avait &'et&'e manipul&'ee par eux !
}
//	<<<ENGLISH>>>
//	So you remember? I thought your
//	memory had been... manipulated
//	by them.

/*憶えてたの？
記憶を操作されていたんじゃ？*/
ライデン_008: {
Elle l'a &'et&'e, mais je fais toujours des
cauchemars... Je revois des bouts de
pass&'e sans parvenir &`a les reconstituer...
}
//	<<<ENGLISH>>>
//	It was -- but I have nightmares
//	every day, pieces of the past
//	I can't put together...

/*……いや。
毎晩、うなされていた……
過去の断片に……。*/
ローズ_009: {
Pourquoi ne m'en as-tu pas parl&'e ?
}
//	<<<ENGLISH>>>
//	Why didn't you tell me?

/*なぜ、今まで言ってくれなかったの？*/
ライデン_010: {
Tu ne comprendrais pas...
}
//	<<<ENGLISH>>>
//	You couldn't begin
//	to understand.

/*君に理解できるはずがない。*/
ローズ_011: {
Tu ne le sauras pas sans m'en parlant !
}
//	<<<ENGLISH>>>
//	You wouldn't know
//	that until you try me.

/*そんなの、言ってくれなきゃ、
分からないじゃない？*/
ライデン_012: {
Je ne voulais pas te faire souffrir !
}
//	<<<ENGLISH>>>
//	I didn't want you to get hurt.

/*君を苦しめたくなかったんだ。*/
ローズ_013: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
ライデン_014: {
Je n'ai jamais eu de vraie raison
de combattre. 
}
//	<<<ENGLISH>>>
//	There was never a real
//	reason for me to fight,

//<ページ数変更>
ライデン_014_1: {
J'ai fait ce que j'ai fait, parce qu'on
quelqu'un m'a mis un flingue entre les
mains. Et ce "on", c'&'etait lui...
}
//	<<<ENGLISH>>>
//	except that someone put
//	a gun in my hand. And
//	that someone was him...

/*俺には戦う理由などなかった。
物心ついた頃から、銃を握らされていた。
あいつだ、あの男に……。
*/
ローズ_015: {
C'est pas ta faute...
}
//	<<<ENGLISH>>>
//	It wasn't your fault.

/*でも、それは罪じゃない。*/
ライデン_016: {
Si je revenais vivant du combat, on me
louait, on me donnait &`a manger et un lit. 
}
//	<<<ENGLISH>>>
//	If I survived the day's fight, I was
//	praised, fed, and had a bed to sleep
//	in.

/*１日を戦えば、ほめられた。
食事にありつけた。
屋根のある寝床で安眠する事ができた。*/
ライデン_017: {
Je crois que j'ai tenu mon premier AK &`a
l'&^age de six ans, mais je n'en suis pas
s&^ur...
}
//	<<<ENGLISH>>>
//	I think I was only six when I held
//	my first AK, but I'm not even sure
//	of that.

/*最初に＃｛銃、ＡＫ｝＃を握らされた時は
まだ６歳だった。
いや、年齢も定かではない。*/
ローズ_018: {
Jack ?
}
//	<<<ENGLISH(2)>>>
//	Jack?

/*ジャック？*/
ライデン_019: {
Je ne suis pas comme Snake. Je ne
me suis jamais demand&'e pourquoi je
combattais. Il n'y a jamais eu ni objectif,
ni &'echappatoire.
}
//	<<<ENGLISH>>>
//	I'm not like Snake, I never
//	questioned why we fought.
//	There was no purpose, no way out.

/*俺はスネークとは違う。
戦いに疑問など感じた事などなかった。
目的があったわけでもない。*/
ライデン_020: {
On te donne un fusil, tu demandes
combien de gens il faut tuer.
}
//	<<<ENGLISH>>>
//	They give you a gun, you
//	ask how many to kill.

/*出口のないトンネルをただ、
銃を突きつけられて歩く事を
強いられていただけだ。*/
ライデン_021: {
Si tu ne fais pas l'affaire,
c'est toi qu'on tue.
}
//	<<<ENGLISH>>>
//	If you didn't, you were
//	the one they shot instead.

/*銃を取らない奴は、みんな殺された。*/
ローズ_022: {
Ne t'inqui&`ete pas.
Personne ne te reproche rien.
}
//	<<<ENGLISH>>>
//	It's OK.
//	No one is blaming you.

/*あなたを責めるつもりはない……。*/
ライデン_023: {
Tous les jours, on nous montrait des films
d'action hollywoodiens, ceux qui regorgent
de machos et de gros flingues.
}
//	<<<ENGLISH>>>
//	We were shown Hollywood action
//	films every day. The kind with
//	macho guys and big guns.

/*毎日、ハリウッドのアクション映画を
見せられた。マッチョな男が銃を持って
戦う映画だ。*/
ライデン_024: {
Ils l'appellent le de formation visuelle.
}
//	<<<ENGLISH>>>
//	They call it image training.

/*イメージトレーニングと言ってな。*/
/* 以下はカット。
ゲームもやらされた。
勿論、遊びじゃない。
*/
ローズ_025: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
ライデン_026: {
Ils - Ils se sont empar&'es de tout notre
&^etre pour nous transformer en machines
&`a tuer...
}
//	<<<ENGLISH(2)>>>
//	They -- they built us from
//	the ground up, into killing
//	machines...

/*俺達は……造られた。
＃｛殺人、キリング｝＃マシーンとして。*/
ライデン_027: {
Nous mangions une fois par jour. Je me
souviens encore du go&^ut de la poudre &`a
canon qu'ils mettaient dans la nourriture.
}
//	<<<ENGLISH>>>
//	We were fed once a day. I can
//	still taste the gunpowder they
//	mixed into the food.

/*日に一度の食事にはガンパウダーが
混入されていた。*/
ローズ_028: {
De la poudre &`a canon ?
Dans la nourriture ?
}
//	<<<ENGLISH>>>
//	Gunpowder? In the food?

/*ガンパウダー？
火薬の事？*/
ライデン_029: {
La poudre &`a canon contient du tolu&`ene,
qui est hallucinog&`ene.
}
//	<<<ENGLISH>>>
//	The gunpowder had toluene
//	in it, giving it hallucinogenic
//	properties.

//<ページ数変更>
ライデン_029_1: {
Nous &'etions ainsi drogu&'es et mall&'eables...
}
//	<<<ENGLISH>>>
//	It kept us drugged,
//	controllable.

/*そうだ、ガンパウダーには幻覚作用を
もたらすトルエン成分が含まれている。
麻薬漬けにされたんだ。
*/
ローズ_030: {
Oh ! Mon Dieu...
}
//	<<<ENGLISH>>>
//	Oh, my God...

/*そんな……。*/
ライデン_031: {
Apr&`es la guerre civile, les survivants ont
&'et&'e pris en charge par les ONG.
}
//	<<<ENGLISH>>>
//	When the civil war ended, those
//	of us who survived were taken
//	in by NGO's.

//<ページ数変更>
ライデン_031_1: {
On m'a offert une nouvelle vie aux
Etats-Unis... Je ne me plains pas.
}
//	<<<ENGLISH>>>
//	They gave me a new life in
//	the States. I can't complain.

/*内戦が終わって、生き残った俺達は、
保護された。それからはこの国で……
さすがに衣食住に困ることはなかった。
*/
ライデン_032: {
Mais rien n'a chang&'e.
}
//	<<<ENGLISH>>>
//	But nothing's changed.

//<ページ数変更>
ライデン_032_1: {
Les rares personnes qui se moquent
de mon pass&'e ont leurs propres secrets,
leurs buts inavou&'es...
}
//	<<<ENGLISH>>>
//	The only people who have no problem
//	with my past have secrets and
//	agendas of their own...

/*しかし、今も、何も変わっていない。
俺達の過去を黙認してくれるのは、
やはり闇の世界しかなかった。*/
ライデン_033: {
Je fais des cauchemars terribles, la nuit.
Jamais je n'oublierai...
}
//	<<<ENGLISH>>>
//	Terrible nightmares --
//	every night. I can never
//	forget...

/*毎晩、うなされる。
忘れることはできない。
*/
ローズ_034: {
Jack...
}
//	<<<ENGLISH(2)>>>
//	Jack...

/*ジャック……。*/
ライデン_035: {
J'ai peur de la nuit... C'est pour &~qa que
je ne peux pas dormir &`a tes c&^ot&'es.
}
//	<<<ENGLISH>>>
//	I'm afraid of the night. That's
//	why I don't sleep next to you.

/*夜が怖い。
だから、君の隣りでは眠れない。*/
ローズ_036: {
Tu aurais d&^u me le dire...
}
//	<<<ENGLISH>>>
//	You should have told me...

/*言って欲しかった……。*/
ライデン_037: {
Que j'ai &'et&'e un tueur et que
je le resterai toute ma vie ?
}
//	<<<ENGLISH>>>
//	Told you what? That I'm a
//	killer and always have been?

/*何を？
俺が根っからの殺し屋だったって事か？*/
ローズ_038: {
Mais non !
}
//	<<<ENGLISH(2)>>>
//	No, no.

/*そうじゃないわ。*/
ライデン_039: {
Il n'y a rien au monde que je d&'eteste
plus que mon pass&'e.
}
//	<<<ENGLISH>>>
//	What I hate more than anything
//	else in the world is my own past.

//<ページ数変更>
ライデン_039_1: {
Je voulais qu'il reste secret,
y compris de toi.
}
//	<<<ENGLISH>>>
//	I didn't want you
//	-- or anyone --
//	to know about it.

/*この世で一番憎むべきもの、
それは自分の過去だ。
誰にも知られたくはなかった。君にも。
*/
ローズ_040: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
ライデン_041: {
A pr&'esent, je comprends pourquoi ils m'ont
choisi pour cette mission.
}
//	<<<ENGLISH>>>
//	Now I know why I was
//	chosen for this mission.

/*だが、俺がこのミッションに選ばれた
理由がようやくわかったよ。*/
ライデン_042: {
Il n'y a que moi qui puisse l'affronter --
et l'&'eliminer.
}
//	<<<ENGLISH>>>
//	No one can take him on --
//	take him down -- except me.

/*あの男を倒すために……あの男を
倒すにはこの俺でなければならない。*/
ライデン_043: {
C'est pour &~qa qu'on m'a laiss&'e la vie
sauve si longtemps. D&`es que j'ai vu
Solidus, j'ai compris.
}
//	<<<ENGLISH>>>
//	I've been kept alive this long
//	for this. I knew, as soon as
//	I saw Solidus.

/*この日のために俺は奴らに生かされて
いたんだ。ソリダスに会って分かった。*/
ローズ_044: {
Jack, je t'aime comme tu es, crois-moi...
}
//	<<<ENGLISH>>>
//	Jack, I love you the way you are
//	now. You have to believe me.

/*ジャック、信じて。
私、今のあなたが好き。*/
ライデン_045: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
ローズ_046: {
Je ne connaissais rien de toi.
}
//	<<<ENGLISH>>>
//	I didn't know anything
//	about you, I admit that.

/*私、確かに……
あなたの事、何も知らなかった。
*/
ローズ_047: {
J'ignorais o&`u tu &'etais n&'e, o&`u tu avais
grandi... A pr&'esent, je sais.
}
//	<<<ENGLISH>>>
//	Where you were born, how you
//	grew up -- but I know that now.

/*どこで生まれて、どう育ったか？
今日までね。
*/
ローズ_048: {
Et je suis s&^ure que mes sentiments
pour toi ne feront que s'intensifier.
Je suis pr&^ete &`a partager ton pass&'e...
}
//	<<<ENGLISH>>>
//	And I know that what I feel for you
//	can only get better, and I'll share
//	in your past if that's the price.

/*でも、これから……もっとあなたを
好きになる。あなたの過去も受け止める。*/
ライデン_049: {
Ce ne serait trop facile... Personne ne
peut partager la charge qui me p&`ese.
}
//	<<<ENGLISH>>>
//	It doesn't work that way. No one can
//	share the burden of what I've done.

//<ページ数変更>
ライデン_049_1: {
Ces sentiments n'ont rien &`a voir
avec les petits souvenirs douillets
que partagent les couples...
}
//	<<<ENGLISH>>>
//	It's not one of those warm and
//	fuzzy things couples share.

/*無理だ。他人が俺の過去を背負うこと
なんかできっこない。俺には恋人達が
語り合うような、楽しい過去はない。
*/
ローズ_050: {
J'accepte tes bons et mauvais c&^ot&'es, Jack.
C'est normal quand on aime !
}
//	<<<ENGLISH>>>
//	I accept the good and the bad, Jack.
//	That's what you do for someone you
//	love.

/*みんなそうなのよ。楽しい事ばかりじゃ
ない。辛いことや悲しい事を共有する
から……ジャック、信じて。*/
ライデン_051: {
Je ne veux partager mon pass&'e avec
personne ! Je veux juste, oublier !
}
//	<<<ENGLISH>>>
//	I don't want to share my past with
//	anyone. I just want to forget about
//	it.

/*俺は、俺の過去を誰とも共有したくは
ない。ただ忘れたいんだ。*/
ローズ_052: {
Jack ? Je ne t'ai pas racont&'e ce
que j'ai fait, moi...
}
//	<<<ENGLISH>>>
//	Jack? I haven't told you -- you
//	know, about what I've done...

/*ジャック？
私もあなたに、自分の過去を……。*/
ローズ_053: {
...
}
//	<<<ENGLISH>>>
//	...

/*……。*/
ライデン_054: {
Les deux derni&`eres ann&'ees pass&'ees
avec toi ont... d&'epass&'e toutes mes 
esp&'erances !
}
//	<<<ENGLISH>>>
//	The last two years with you --
//	it's been more than I've ever
//	hoped for.

/*ローズ、君と過ごした２年間は……
本当に楽しかった。*/
ローズ_055: {
Jack...
}
//	<<<ENGLISH(2)>>>
//	Jack...

/*ジャック？*/
ライデン_056: {
Mais je ne peux pas aller plus loin...
}
//	<<<ENGLISH>>>
//	But I can't go any farther.

/*でも、そこまでだ。
それ以上は踏み込めない。*/
ライデン_057: {
Je sais que tu veux te marier...
}
//	<<<ENGLISH>>>
//	I know you want to get married.

/*君が俺のプロポーズを心待ちにしていた
ことは知っている。*/
ローズ_058: {
Je --
}
//	<<<ENGLISH(2)>>>
//	I --

/*それは。*/
ライデン_059: {
Mais...
}
//	<<<ENGLISH(2)>>>
//	But --

/*でも……。*/
ライデン_060: {
C'est impossible.
}
//	<<<ENGLISH(2)>>>
//	I can't.

/*俺には……できない。*/
ライデン_061: {
Je ne peux pas risquer de construire
une famille...
}
//	<<<ENGLISH>>>
//	I can't risk starting a family.

/*俺には家族を創ることはできない。*/
ライデン_062: {
Je ne parviendrai jamais &`a effacer
mon enfance.
}
//	<<<ENGLISH>>>
//	There's no way to erase
//	my childhood.

/*あの体験を白紙に戻すことはできない。*/
ローズ_063: {
Ne t'inqui&`ete pas, Jack.
J'ai compris le message...
}
//	<<<ENGLISH>>>
//	It's all right, Jack.
//	Please, don't say any more...

/*ジャック、わかった。
それ以上、言わないで……。*/
}
//d



resource P071_01_R01_拷問部屋脱出１無線機デモ１＿１__f {
//Vc117101
大佐_000: {
Raiden, tu me re&~qois ?
}
//	<<<ENGLISH>>>
//	Raiden, do you copy.

/*ライデン、いいか。*/
大佐_001: {
Il faut que tu poursuives ta m-mission !
}
//	<<<ENGLISH(2)>>>
//	You must continue
//	your m-mission.

/*に、任務、任務を続行しろ。*/
ライデン_002: {
J'ai perdu toutes mes affaires !
Il faut que je retrouve Snake.
}
//	<<<ENGLISH>>>
//	I've lost all my gear.
//	I need to locate Snake.

/*装備がない。
スネークを探さなければ……。*/
大佐_003: {
Il n'a jamais &'et&'e inclus dans la simulation.
Laisse-le en dehors de cela...
}
//	<<<ENGLISH>>>
//	He was never factored into the
//	simulation. Leave him out of this.

/*あの男はシミュレーション要素には
入っていない。あの男にかまうな。*/
ライデン_004: {
Je ne peux rien faire tout nu,
surtout avec cette temp&'erature...
}
//	<<<ENGLISH>>>
//	I can't do much naked, especially
//	in this temperature.

/*裸ではどうしようもない。
ここはかなり室温が低い。*/
大佐_005: {
C'est exact ! Tu ne peux pas attaquer,
ni entrer en mode de Suspension...
}
//	<<<ENGLISH>>>
//	That's true -- you won't be able to
//	attack or enter the Hanging mode,
//	either.

/*そうだな。
その格好では攻撃もエルードもできない。*/
ライデン_006: {
Je crois que Snake a mon &'equipement.
}
//	<<<ENGLISH>>>
//	I think Snake has my gear.

/*装備はスネークが持っているらしい。*/
大佐_007: {
Raiden, &'elimine Solidus et ses hommes.
Tu dois r&'ecup&`erer l'Arsenal sans
dommage.
}
//	<<<ENGLISH>>>
//	Raiden, take out Solidus and his
//	men. You must recover Arsenal
//	intact.

/*ライデン、ソリダス達を倒せ。
アーセナルを無傷で奪い返すんだ。*/
ライデン_008: {
Colonel, tu es &`a la solde des Patriotes ?
}
//	<<<ENGLISH>>>
//	Colonel, are you under orders
//	from the Patriots?

/*大佐、あんたは『愛国者達』の命令で？*/
大佐_009: {
Ton r&^ole -- ta mission -- est de p&'en&'etrer
dans la structure et de d&'esarmer
les terroristes...
}
//	<<<ENGLISH(2)>>>
//	Your role -- that is, mission --
//	is to infiltrate the structure and
//	disarm the terrorists --

/*君の今回の役割……
いや、任務は単独潜入して、
テロリストを武装解除し……。*/
ライデン_010: {
Mon r&^ole ?
Pourquoi parles-tu toujours de 'r&^ole' ?
}
//	<<<ENGLISH>>>
//	My role? Why do you
//	keep saying that.

/*また役割か？*/
大佐_011: {
Pourquoi pas ? C'est un jeu de r&^oles,
apr&`es tout !
}
//	<<<ENGLISH>>>
//	Why not? This is a type
//	of role-playing game.

//<ページ数変更>
大佐_011_1: {
Ce qui compte, c'est que tu joues ton
r&^ole... Et je n'attends rien de moins
qu'une performance parfaite !
}
//	<<<ENGLISH>>>
//	The point is that you play out your
//	part -- and I expect you to turn in
//	a perfect performance!

/*これは一種のロール・プレイングなのだ。
役割を果たせ！役割を演じきるのだ。
*/
ライデン_012: {
Colonel, je viens de me souvenir
de quelque chose...
}
//	<<<ENGLISH>>>
//	Colonel, I just remembered
//	something.

/*大佐、思い出したんだ。*/
大佐_013: {
De quoi s'agit-il ?
}
//	<<<ENGLISH(2)>>>
//	What?

/*なんだ？*/
ライデン_014: {
Je ne t'ai jamais rencontr&'e en personne.
Pas une seule fois !
}
//	<<<ENGLISH>>>
//	That I've never met you
//	in person. Not once.

/*俺はあんたに直接あったことがない。
一度もな。*/
大佐_015: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
大佐_016: {
Remplis ta mission en te conformant
aux simulations !
}
//	<<<ENGLISH>>>
//	Complete your mission according
//	to the simulation!

/*任務をシミュレーション通りに
完遂するんだ！*/
ライデン_017: {
Colonel, qui es-tu ?
}
//	<<<ENGLISH>>>
//	Colonel, who are you?

/*大佐、あんたは誰なんだ！？*/
大佐_018: {
Assez de questions.
Nous avons Rosemary.
}
//	<<<ENGLISH>>>
//	No more questions.
//	We have Rosemary.

/*それ以上の詮索は無用だ。
ローズマリーはこちらが預かっている。*/
ライデン_019: {
Que veux-tu dire ?
}
//	<<<ENGLISH>>>
//	What do you mean by that!

/*それはどういう意味だ？*/
大佐_020: {
Termin&'e !
}
//	<<<ENGLISH(2)>>>
//	Over and out.

/*いいな、ライデン。*/
}
//d



resource P072_01_R01_大佐混乱１無線機デモ１＿１__f {
//Vc117201
大佐_000: {
Raiden, mets imm&'ediatement ta console
hors tension !
}
//	<<<ENGLISH>>>
//	Raiden, turn the game
//	console off right now!

/*ライデン、今すぐにゲーム機の電源を
切るんだ！*/
//大佐エフェクトをかける。（ウイルスが効き始めている）
ライデン_001: {
Qu'est-ce que tu as dit ?
}
//	<<<ENGLISH(2)>>>
//	What did you say?

/*何て言った？*/
大佐_002: {
La mission a &'echou&'e !
Coupe le courant !
}
//	<<<ENGLISH>>>
//	The mission is a failure!
//	Cut the power right now!

/*任務は失敗に終わった！
今すぐ電源を切れっ！*/
ライデン_003: {
C'est quoi, ton probl&`eme ?
}
//	<<<ENGLISH(2)>>>
//	What's wrong with you?

/*一体、どうしたんだ？*/
大佐_004: {
Ne t'inqui&`ete pas, ce n'est qu'un jeu !
Comme d'habitude...
}
//	<<<ENGLISH>>>
//	Don't worry, it's a game!
//	It's a game just like usual.

/*うろたえるな、これはゲームだ！
いつものゲームなんだ。*/
ローズ_005: {
Tu vas t'ab&^imer les yeux si tu continues
&`a jouer si pr&`es de la t&'el&'e !
}
//	<<<ENGLISH>>>
//	You'll ruin your eyes playing 
//	so close to the TV.

/*長時間プレイすると目が悪くなるわよ。*/
ライデン_006: {
De quoi parles-tu ?
}
//	<<<ENGLISH(2)>>>
//	What are you talking about!?

/*何を言ってるんだ！？*/
大佐_007: {
Raiden, il m'est arriv&'e quelque chose jeudi
dernier, alors que je rentrais chez moi.
}
//	<<<ENGLISH>>>
//	Raiden, something happened to me
//	last Thursday when I was driving
//	home.

/*ライデン、聞いてくれ。先週の木曜の
ことだ。私は車で家に帰る途中だった。*/
大佐_008: {
Il me restait quelques kilom&`etres &`a
parcourir... J'ai lev&'e la t&^ete et trour&'e
un objet orange scintillait dans le ciel,
vers l'est !
}
//	<<<ENGLISH>>>
//	I had a couple of miles to go -- I
//	looked up and saw a glowing orange
//	object in the sky, to the east!

/*家まであと２マイルほどの所……
ふと目を上げると東の空にオレンジ色の
光る物体が見えたんだ！*/
大佐_009: {
Il se d&'epla&~qait irr&'eguli&`ermente.
Tout &`a coup, j'ai &'et&'e entour&'e
d'une intense lumi&`ere
}
//	<<<ENGLISH>>>
//	It was moving very irregularly...
//	Suddenly, there was intense light
//	all around me --

/*とても不規則に動いていた……
そして次の瞬間、あたり一面が
強烈な光に包まれ……*/
大佐_010: {
et &`a mon r&'eveil, j'&'etais chez moi.
}
//	<<<ENGLISH>>>
//	-- and when I came to, I was home.
//	

/*気がつくと私は家に着いていた……。*/
大佐_011: {
C'&'etait quoi, &`a ton avis ?
}
//	<<<ENGLISH>>>
//	What do you think happened
//	to me...?

/*どう思う？*/
ライデン_012: {
Pla&^it-il ?
}
//	<<<ENGLISH(2)>>>
//	Huh?

/*どうって……。*/
大佐_013: {
Laisse tomber...
}
//	<<<ENGLISH>>>
//	Fine, forget it...

/*わかった……もういい……。*/
}
//d


resource P073_01_R01_通路Ａ１無線機デモ１＿１__f {
//vc117301
ローズ_000: {
Jack, c'est moi !
}
//	<<<ENGLISH(2)>>>
//	Jack, it's me.

/*ジャック、私よ。*/
ライデン_001: {
Salut, Rose !
}
//	<<<ENGLISH>>>
//	Hi Rose.

/*ああ、ローズか。*/
ローズ_002: {
Jack... Je te dois mes excuses.
}
//	<<<ENGLISH>>>
//	Jack -- I owe you an apology.

/*ジャック……
私、謝らなきゃいけないことがある……。*/
ライデン_003: {
Si c'est au sujet de notre conversation,
c'est &`a moi de m'excuser...
}
//	<<<ENGLISH>>>
//	If it's about that conversation
//	just now, I'm the one who's sorry.

/*さっきの事なら……すまなかった。*/
ローズ_004: {
Non... Il s'agit d'autre chose.
}
//	<<<ENGLISH>>>
//	No, it's something else.

/*違うの。*/
ライデン_005: {
Je t'&'ecoute...
}
//	<<<ENGLISH(2)>>>
//	What is it?

/*なんだ？*/
ローズ_006: {
Ce qui s'est pass&'e il y a deux ans,
au Federal Hall... N'&'etait pas
une co&~incidence.
}
//	<<<ENGLISH>>>
//	That day at Federal Hall two years
//	ago -- it wasn't a coincidence.

/*２年前……あなたに初めて
会ったフェデラルホール……
あれは偶然ではないの。*/
ローズ_007: {
J'avais re&~qu l'ordre de te surveiller...
}
//	<<<ENGLISH>>>
//	I was ordered to keep an eye
//	on you...

/*私、あなたを監視するように……。*/
ライデン_008: {
De me surveiller ?
}
//	<<<ENGLISH>>>
//	Keep an eye on me?

/*俺を監視？*/
ローズ_009: {
Oui. L'ordre venait des Patriotes.
}
//	<<<ENGLISH>>>
//	Yes -- by the Patriots.

/*そう、『愛国者達』に雇われて……。*/
ライデン_010: {
Tu es une espionne !
}
//	<<<ENGLISH>>>
//	You're a spy.

/*スパイ？*/
ローズ_011: {
Probablement, mais ce mot n'est pas joli.
}
//	<<<ENGLISH>>>
//	I suppose. Yes.
//	It's an ugly word.

/*そういう事になる。
その言葉は嫌いだけど。*/
ライデン_012: {
...
}
//	<<<ENGLISH>>>
//	...

/*……。*/
ローズ_013: {
Tu es toujours l&`a ?
}
//	<<<ENGLISH>>>
//	Are you still there?

/*……聞こえてる？*/
ライデン_014: {
Et tu as couch&'e avec moi pour
ta mission ?
}
//	<<<ENGLISH>>>
//	Was sleeping with me
//	a part of the job?

/*俺と身体を重ねたのも、
任務だというのか？*/
ローズ_015: {
Je suis tomb&'ee amoureuse de toi...
}
//	<<<ENGLISH>>>
//	I fell in love with you...

/*あなたと恋に落ちたのは……。*/
ライデン_016: {
Comment peut-on...
}
//	<<<ENGLISH>>>
//	How could anyone --

/*卑劣な……。*/
ローズ_017: {
Je suis inexcusable.
}
//	<<<ENGLISH>>>
//	I can't excuse what I did.

//<ページ数変更>
ローズ_017_1: {
Pendant ces deux ans, je leur ai
tout dit de ta vie personnelle.
}
//	<<<ENGLISH>>>
//	I've reported every detail of
//	your personal life to them these
//	two years.

//<ページ数変更>
ローズ_017_2: {
J'ai racont&'e ce que tu avais fait et dit,
sans exception...
}
//	<<<ENGLISH>>>
//	What you did, said, everything...

/*言い訳はできない。この２年間、
あなたの私生活を＃｛報告、レポート｝＃していた……
あなたの行動、言動……細かな事まで。
*/
ライデン_018: {
Tu as d&^u dr&^olement t'amuser !
}
//	<<<ENGLISH>>>
//	Must've been fun.

/*さぞ楽しかったろうな。*/
ローズ_019: {
Il y a des choses que j'ai gard&'ees
pour moi !
}
//	<<<ENGLISH>>>
//	But some things
//	I didn't tell anyone!

/*でも、報告してない事もあるわ！*/
ライデン_020: {
...
}
//	<<<ENGLISH>>>
//	...

/*……。*/
ローズ_021: {
Je n'ai pas parl&'e de mes
sentiments pour toi.
}
//	<<<ENGLISH>>>
//	Like what I felt for you.

/*私の気持ち……。*/
ライデン_022: {
C'est pour &~qa que tu as particip&'e &`a cette
mission. J'aurais d&^u m'en douter !
}
//	<<<ENGLISH>>>
//	So that's why you were involved in
//	this mission. I should have known.

/*今回も最初からそういう事だったんだ。
俺が迂闊だった。*/
ライデン_023: {
Comment expliquer le recrutement
d'une analyste, en derni&`ere minute ?
}
//	<<<ENGLISH>>>
//	Why else would they toss an analyst
//	into the mix at the last minute?

/*君のようなアナリストを
極秘ミッションに参加させるわけはない。*/
ローズ_024: {
Je suis navr&'ee.
Je sais que j'ai mal agi...
}
//	<<<ENGLISH>>>
//	I'm sorry, I know what
//	I did was wrong...

/*悪いのは私……。*/
ライデン_025: {
De toute fa&~qon, o&`u que j'aille,
les gens se servent de moi !
}
//	<<<ENGLISH>>>
//	No matter where I go - I get used.

/*俺はどこまでも利用された訳だ。*/
ローズ_026: {
Je me suis r&'einvent&'ee
pour &^etre &`a ton go&^ut.
}
//	<<<ENGLISH>>>
//	I reinvented myself to
//	suit your tastes.

//<ページ数変更>
ローズ_026_1: {
J'ai chang&'e de coiffure, de v&^etements,
de d&'emarche, de centres d'int&'eret...
}
//	<<<ENGLISH>>>
//	Hairstyle, clothes, the way I move,
//	things I talked about...

/*私はあなたに気に入られようと
必死だった……あなたの好きな髪型、
服装、仕草、話題……。
*/
ローズ_027: {
Tu aimes la couleur de mes cheveux
et de mes yeux... Mais tout est faux...
}
//	<<<ENGLISH>>>
//	You say you love the color of my
//	hair, my eyes. They're not even
//	real.

/*あなたが好きと言ってくれた私の髪も
目の色も……嘘なの。*/
ライデン_028: {
Tu as d&^u examiner mon profil
psychologique &`a la loupe...
}
//	<<<ENGLISH>>>
//	You must have gone over my psych
//	profile with a fine-tooth comb.

/*俺のデータを調べ尽くしたんだろう？*/
ローズ_029: {
C'&'etait mon travail !
}
//	<<<ENGLISH>>>
//	It was my job.

/*それが任務だった。*/
ライデン_030: {
Je te f&'elicite !
Je n'avais rien vu venir !
}
//	<<<ENGLISH>>>
//	Great performance --
//	had me completely fooled.

/*まんまと引っかかったわけだ。*/
ローズ_031: {
Je voulais que tu d&'ecouvres
ma vraie nature.
}
//	<<<ENGLISH>>>
//	What I really wanted was
//	for you to see the real me.

/*でも……本当の自分を、本当の私を
あなたに愛してもらいたかった。*/
ローズ_032: {
J'ai &'et&'e bless&'ee de devoir jouer cette --
romance artificielle !
}
//	<<<ENGLISH>>>
//	It hurt to play out this --
//	this artificial romance.

/*私には、それが辛かった。
それが悲しかった。
私は疑似恋愛を強いられたの。*/
ローズ_033: {
Il a &'et&'e plus &'eprouvant de me mentir &`a
moi-m&^eme que de te mentir &`a toi...
}
//	<<<ENGLISH>>>
//	It was worse to lie to
//	myself than to you.

/*あなたを騙し続ける事よりも……
自分を騙し続ける事の方が辛かった。*/
ローズ_034: {
Plus tu m'aimais plus je souffrais,
je savais que la personne que tu
aimais n'&'etait pas r&'eelle...
}
//	<<<ENGLISH>>>
//	The more love you gave me, the more
//	it hurt -- because I knew the person
//	you loved was just a character.

/*あなたが私を強く愛してくれれば、
くれるほど。あなたが愛しているのは
マニュアルに従った私。*/
ライデン_035: {
C'&'etait donc artificiel pour moi aussi...
Ce n'&'etait qu'un jeu...
}
//	<<<ENGLISH>>>
//	So it was artificial on my end too.
//	It was just a game, not the real
//	thing.

/*つまり俺の方も疑似恋愛だったって事か。
ゲームだったんだ。*/
ローズ_036: {
Oh ! Jack !
}
//	<<<ENGLISH(2)>>>
//	Oh Jack...

/*ジャック……。*/
ライデン_037: {
Je suis content de conna&^itre la v&'erit&'e.
}
//	<<<ENGLISH>>>
//	I feel better knowing that.

/*それを聞いて、少しは気がおさまった。*/
ローズ_038: {
Quoi ?
}
//	<<<ENGLISH(2)>>>
//	What?

/*えっ？*/
ライデン_039: {
J'&'etais amoureux -- ou croyais l'&^etre --
d'une personne qui n'existe pas.
}
//	<<<ENGLISH>>>
//	I was in love -- or thought I was --
//	with someone who didn't exist.

/*嘘の人格を愛していたんだ。
いや、愛していたつもりになっていた。
*/
ライデン_040: {
J'essayais d'&^etre ce que je n'&'etais pas
en aimant ce qui n'&'etait pas r&'eel.
}
//	<<<ENGLISH>>>
//	I was trying to be someone I wasn't
//	by loving what wasn't real.

/*嘘の相手を愛することで
嘘の自分を演じていた。*/
ライデン_041: {
Je ne sais pas qui tu es.
}
//	<<<ENGLISH>>>
//	I don't know who you really are.

//<ページ数変更>
ライデン_041_1: {
La personne que je connaissais
&'etait irr&'eelle, elle n'a rien &`a voir avec
la femme avec qui je parle maintenant.
}
//	<<<ENGLISH>>>
//	The person I knew isn't real;
//	she's not the woman I'm talking
//	to right now.

/*俺は本当の君を知らない。
俺が知ってるのは嘘の君だ。
今、話している君じゃない。
*/
ローズ_042: {
Dans un sens, la tromperie vient de moi,
pas d'eux !
}
//	<<<ENGLISH>>>
//	In a sense, the deception
//	was my own, not theirs.

/*それだけはわかった。
だから俺は奴等に騙されたわけじゃない。*/
ローズ_043: {
Jack, je croyais jouer un r&^ole,
parce que mon m&'etier l'exigeait.
}
//	<<<ENGLISH>>>
//	Jack, I thought I was acting,
//	because that was my job.

/*ジャック、私、演じていたつもり。
それが任務だったから。*/
ローズ_044: {
Mais je suis tomb&'ee amoureuse de toi
et &~qa, ce n'est pas du cin&'ema.
}
//	<<<ENGLISH>>>
//	But I did fall in love with
//	you, that wasn't an act.

/*でも、あなたを愛したのは……
全てが演技じゃない。*/
ライデン_045: {
Tu n'esp&`eres quand m&^eme pas que
je vais te croire ?
}
//	<<<ENGLISH>>>
//	You expect me to believe that?

/*それを信じろというのか。*/
ローズ_046: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
ライデン_047: {
Ne t'inqui&`ete pas. Je suppose que tu n'as
pas agi sans raison... Je comprends...
Mais nous n'avons plus rien &`a nous...
}
//	<<<ENGLISH>>>
//	It's okay. You had your reasons,
//	right? Hey, I understand. But I
//	have nothing left to...

/*いいさ。
君にもいろいろ事情があったんだろう？
それは分かるよ。でもこれで……。*/
ローズ_048: {
Jack !!
}
//	<<<ENGLISH>>>
//	Jack!!

/*ジャック！！*/
ライデン_049: {
Quoi ?
}
//	<<<ENGLISH(2)>>>
//	What?

/*え？*/
ローズ_050: {
Je...
}
//	<<<ENGLISH>>>
//	I'm...


ローズ_050_1: {
Je porte...
}
//	<<<ENGLISH>>>
//	...I'm carrying...

/*私……お腹に……お腹に……。*/
ローズ_051: {
Je suis enceinte, Jack !
}
//	<<<ENGLISH>>>
//	I'm pregnant, Jack.

/*私、妊娠しているの。*/
//ローズの声がバグってゆく。回転スピードが落ちてゆく。ＨＡＬ９０００の最後に近い。
ローズ_052: {
Je porte ton enfant...
}
//	<<<ENGLISH(2)>>>
//	Your baby.

/*あなたの赤ちゃんが。*/
ライデン_053: {
Rose ? Que se passe-t-il ?
}
//	<<<ENGLISH>>>
//	Rose? What's going on?

/*どうした、ローズ？*/
}
//d



resource P073_03_R02_通路Ａ３無線機デモ２＿１__f {
//Vc117311
スネーク_000: {
D&'esol&'e pour tout &`a l'heure. J'ai d&^u te
prendre comme app&^at pour acc&'eder &`a
l'Arsenal... Et &~qa a fonctionn&'e !
}
//	<<<ENGLISH>>>
//	Sorry about earlier. I had to
//	use you as bait to gain access
//	to Arsenal. It worked.

/*悪かったな。アーセナルに潜入する
ためにお前をだしに使わせてもらった。
お陰でうまくいった。*/
ライデン_001: {
Pourquoi ne m'as-tu rien dit pour d'Olga ?
}
//	<<<ENGLISH>>>
//	Why didn't you tell
//	me about Olga?

/*オルガのこと、なぜ黙っていた？*/
スネーク_002: {
Tu ne me l'as pas demand&'e !
}
//	<<<ENGLISH(2)>>>
//	You never asked.

/*聞かなかっただろう？*/
ライデン_003: {
Peuh !
}
//	<<<ENGLISH(2)>>>
//	Uh!

/*くっ！*/
スネーク_004: {
Si tu n'es pas content, tant pis !
}
//	<<<ENGLISH>>>
//	Not happy about that?
//	Get over it.

/*気にいらんか？
ま、過ぎたことだ。
気にするな。*/
ライデン_005: {
... Le virus a commenc&'e
&`a faire de l'effet ?
}
//	<<<ENGLISH>>>
//	...any effects of the virus yet?

/*……ウイルスの効果は？*/
スネーク_006: {
On attend toujours...
}
//	<<<ENGLISH>>>
//	Still waiting on that.

/*まだ出ていない。*/
ライデン_007: {
C'&'etait un coup mont&'e des Patriotes ?
}
//	<<<ENGLISH>>>
//	So it was rigged
//	by the Patriots?

/*やはり『愛国者達』の仕掛けが？*/
スネーク_008: {
Apparemment ! Il semble que l'Arsenal se
dirige vers Manhattan.
}
//	<<<ENGLISH>>>
//	Looks like it. From what I can tell,
//	Arsenal is headed for Manhattan.

/*らしいな。アーセナルはマンハッタンに
向かっているようだ。*/
スネーク_009: {
Je ne sais pas ce que fomente Solidus,
mais il va falloir r&'egler ce probl&`eme
d'une mani&`ere ou d'une autre...
}
//	<<<ENGLISH>>>
//	I don't know what Solidus is
//	planning, but we'll have to deal
//	with it one way or another.

/*ソリダスが何をする気かは分からんが…
俺達でなんとかするしかない。*/
スネーク_010: {
De plus, il y a une troupe de Metal Gear
RAY &`a l'avant...
}
//	<<<ENGLISH>>>
//	There's also a troop of
//	production-model RAYs
//	ahead.

/*この先に量産型ＲＡＹが待ち構えている。*/
ライデン_011: {
Combien d'unit&'es ?
}
//	<<<ENGLISH>>>
//	How many units?

/*何機？*/
スネーク_012: {
Vingt-cinq, d'apr&`es Olga !
}
//	<<<ENGLISH>>>
//	Twenty-five, according to Olga.

/*オルガが言うには２５機。*/
ライデン_013: {
Vingt-cinq !?
}
//	<<<ENGLISH>>>
//	Twenty-five!?

/*２５機！？*/
スネーク_014: {
Ouais ! Je n'ai jamais affront&'e un aussi
grand nombre de Metal Gear, mais enfin...
On devrait y arriver !
}
//	<<<ENGLISH>>>
//	Yeah. Can't say I've faced that
//	many Metal Gears before, but --
//	I think we can deal.

/*ああ。俺もそれだけのメタルギアを
相手にしたことはないが……
いけるだろう？*/
ライデン_015: {
C'est impossible !
}
//	<<<ENGLISH>>>
//	No way we can...

/*とても相手に出来ない……。*/
スネーク_016: {
Si, parce qu'on n'a pas le choix, 
figure-toi !
}
//	<<<ENGLISH>>>
//	We can because we
//	have no other choice.

/*だがやるしかない。*/
ライデン_017: {
Comment ?
}
//	<<<ENGLISH(2)>>>
//	How?

/*どうやって？*/
スネーク_018: {
J'ai constitu&'e un stock de missiles Stinger.
}
//	<<<ENGLISH>>>
//	I've stocked up on
//	Stinger missiles.

/*スティンガー・ミサイルを
補給しておいた。*/
スネーク_019: {
Ah ! Et Olga a laiss&'e &~qa pour toi !
}
//	<<<ENGLISH>>>
//	Oh yeah, Olga left this for you.

/*そうだ、オルガからこれを預かった。*/
}
//d



resource P074_02_R01_通路Ａ刀後２無線機デモ１＿１__f {
//Vc117401
ライデン_000: {
Snake, as-tu d&'ej&`a pris plaisir &`a tuer
quelqu'un ?
}
//	<<<ENGLISH>>>
//	Snake, have you ever --
//	enjoyed killing someone?

/*スネーク、
人を殺す度に喜びを感じたことは？*/
スネーク_001: {
De quoi parles-tu ?
}
//	<<<ENGLISH(2)>>>
//	What are you talking about?

/*どういう意味だ。*/
ライデン_002: {
Je ne sais pas bien, mais il est parfois
difficile de diff&'erencier la r&'ealit&'e des jeux...
}
//	<<<ENGLISH>>>
//	I'm not sure. Sometimes it's hard
//	to tell the difference between
//	reality and a game...

/*わからない。
これが現実なのか？
ゲームなのか？*/
スネーク_003: {
Impression de r&'ealit&'e att&'enu&'ee ?
C'est la formation en RV qui fait &~qa...
}
//	<<<ENGLISH>>>
//	Diminished sense of reality, huh?
//	VR training will do that.

/*現実感の欠如。
ＶＲ訓練の影響だ。*/
ライデン_004: {
Non, j'ai &'eprouv&'e &~qa sur le terrain,
quand j'&'etais enfant...
}
//	<<<ENGLISH>>>
//	No, it was field training,
//	when I was a kid.

/*いや、現実に訓練されたんだ。
子供の頃に。*/
ライデン_005: {
J'ai menti, Snake... L'exp&'erience du
terrain, &~qa me conna&^it ! Ce n'est pas
la formation RV qui me perturbe,
crois-moi...
}
//	<<<ENGLISH>>>
//	I lied, Snake. I have more field
//	experience than I can remember.
//	It's not VR that's doing this to me.

/*スネーク、俺は嘘をついた。
実戦の経験をしている。
ＶＲの影響じゃない。*/
スネーク_006: {
Raiden, nos flingues, ne sont pas l&`a pour
tuer. Notre r&^ole ne consiste pas non plus &`a
aider des hommes politiques, quels qu'ils
soient !
}
//	<<<ENGLISH>>>
//	Raiden, we don't carry guns to take
//	people down. We're not here to help
//	some politician either.

/*ライデン、俺達は人を傷つけるために
銃を握っているわけじゃない。
ましてや、どこかの政治家の為でもない。*/
ライデン_007: {
C'est facile &`a dire quand on est
une l&'egende, un h&'eros.
}
//	<<<ENGLISH>>>
//	You can say that because
//	you're a legend, a hero.

//<ページ数変更>
ライデン_007_1: {
Moi, je suis Jack l'Eventreur
et j'incarne le pire !
}
//	<<<ENGLISH>>>
//	I'm Jack the Ripper, a dirty
//	reminder -- of a terrible mistake.

/*あんたは伝説の＃｛戦士、ヒーロー｝＃だ。
俺は＃｛切り裂きジャック、ジャック・ザ・リッパー｝＃。
封印された歴史の＃｛汚穢、おわい｝＃。
*/
スネーク_008: {
Les l&'egendes n'ont aucun sens.
Je suis juste un nom qu'on exploite !
}
//	<<<ENGLISH>>>
//	Legends don't mean a whole lot.
//	I was just a name to exploit.

/*伝説でもなんでもない、
俺も利用されただけだ。*/
スネーク_009: {
Tout comme toi !
}
//	<<<ENGLISH(2)>>>
//	Just like you.

/*俺もお前と同じだ。*/
ライデン_010: {
Mais les gens ne se souviendront que de
tes bonnes actions...
}
//	<<<ENGLISH>>>
//	People will remember only
//	the good part, the right part
//	of what you did.

/*あんたの行動は語り継がれる。
正当化される。*/
スネーク_011: {
En mati&`ere de meurtre, il n'y a
jamais de bonnes actions !
}
//	<<<ENGLISH>>>
//	There's no right part
//	in murder, not ever.

/*人殺しが正当化される事などない。
正当化される時代もない。*/
スネーク_012: {
Nous ne sommes pas ici pour nous faire
un nom !
}
//	<<<ENGLISH>>>
//	And we're not in this to make
//	a name for ourselves.

/*俺達は自分の功績を残そうとして
いるんじゃない。*/
ライデン_013: {
Alors vous vous battez pour quoi,
Otacon et toi ?
}
//	<<<ENGLISH>>>
//	Then what are you and
//	Otacon fighting for?

/*なら、あんたやオタコンは何のために
戦ってる？*/
スネーク_014: {
Pour l'avenir...
}
//	<<<ENGLISH>>>
//	A future.

/*俺は未来のために銃を握っている。*/
スネーク_015: {
D&`es maintenant, tu peux d&'ecider de ne
plus incarner le pire...
}
//	<<<ENGLISH>>>
//	You can stop being part of
//	a mistake, starting now.

/*いいか、つまらん殺戮に手を貸すのは、
これで終わりにしろ。*/
ライデン_016: {
Que suis-je ? Que suis-je cens&'e faire ?
}
//	<<<ENGLISH>>>
//	What am I -- what am I
//	supposed to do?

/*俺は……どうすればいいんだ？*/
}
//d


resource P075_01_R01_オタコン無事１無線機デモ１＿１__f {
//Vc117501
オタコン_000: {
Snake, Raiden !!
}
//	<<<ENGLISH>>>
//	Snake, Raiden!

/*スネーク、ライデン！*/
スネーク_001: {
Otacon ! Tu vas bien ?
}
//	<<<ENGLISH>>>
//	Otacon! You all right?

/*オタコン！
無事だったか？*/
オタコン_002: {
Oui ! Et les otages sont sains et saufs.
}
//	<<<ENGLISH>>>
//	Yeah. So are all the hostages.

/*うん。人質もみんなね。*/
ライデン_003: {
Tant mieux !
}
//	<<<ENGLISH(2)>>>
//	That's good news.

/*それはよかった。*/
オタコン_004: {
Et vous deux ? Comment &~qa va ?
}
//	<<<ENGLISH>>>
//	How's everything on your end?

/*君達の方は大丈夫かい？*/
ライデン_005: {
Pour l'instant, &~qa va.
Mais il y a un truc qui cloche...
}
//	<<<ENGLISH>>>
//	All right for now. But
//	there is something --

/*今のところは……ただ……。*/
オタコン_006: {
Quoi ?
}
//	<<<ENGLISH(2)>>>
//	What?

/*ただ？*/
ライデン_007: {
La derni&`ere transmission du Colonel
&'etait bizarre !
}
//	<<<ENGLISH>>>
//	The Colonel's last transmission
//	was strange.

/*大佐の様子がおかしいんだ。*/
オタコン_008: {
Bizarre ? Comment ?
}
//	<<<ENGLISH>>>
//	Strange? How?

/*おかしい？*/
ライデン_009: {
Ben... bizarre ! Je ne sais pas, moi...
}
//	<<<ENGLISH>>>
//	Just -- strange. No idea --

/*ああ……一体どうしたのか……？*/
オタコン_010: {
Il y avait des interf&'erences ?
}
//	<<<ENGLISH>>>
//	Interference?

/*妨害電波？*/
ライデン_011: {
Je ne sais pas.
}
//	<<<ENGLISH(2)>>>
//	I don't know.

/*わからない。*/
オタコン_012: {
Il est post&'e o&`u, ce Colonel ?
}
//	<<<ENGLISH>>>
//	Where is this Colonel?

/*……大佐はどこから指令を？*/
ライデン_013: {
Je n'en sais rien. Je ne l'ai jamais
rencontr&'e, ce type...
}
//	<<<ENGLISH>>>
//	I don't know. I've never
//	met the man, actually...

/*……わからないんだ。
俺は大佐に会ったことがない……。*/
オタコン_014: {
... Je vais creuser la question...
}
//	<<<ENGLISH>>>
//	...I'll dig around.

/*……調べてみるよ。*/
ライデン_015: {
Merci. Je te dois une fi&`ere chandelle !
}
//	<<<ENGLISH>>>
//	Thanks. I owe you one.

/*頼む。*/
オタコン_016: {
Si tu as autre chose, appelle-moi sur
le Codec. Je pourrai peut-&^etre t'aider,
qui sait.
}
//	<<<ENGLISH>>>
//	If there's anything else, call me
//	on the Codec, I might be able to
//	help.

//<ページ数変更>
オタコン_016_1: {
La fr&'equence est 141.12.
}
//	<<<ENGLISH(2)>>>
//	The frequency is 141.12.

/*他にも何かあったら無線連絡をくれ。
サポートできると思う。
周波数は１４１．１２だ。
*/
}
//d



resource P076_01_R01_大佐ＡＩ１無線機デモ１＿１__f {
//Vc117601
オタコン_000: {
Raiden ? 
Ton Colonel... Je sais o&`u il est !
}
//	<<<ENGLISH>>>
//	Raiden? About this Colonel of
//	yours -- I found out where he is.

/*ライデン？
『大佐』のことだけど……わかったんだ。
君の『大佐』がどこにいるのか。*/
ライデン_001: {
O&`u &~qa ?
}
//	<<<ENGLISH(2)>>>
//	Where?

/*どこだ？*/
オタコン_002: {
A bord de l'Arsenal !
}
//	<<<ENGLISH>>>
//	Inside Arsenal.

/*そのアーセナルの中。*/
ライデン_003: {
Quoi !?
}
//	<<<ENGLISH(2)>>>
//	What!?

/*なに！？*/
オタコン_004: {
J'ai tout v&'erifi&'e et j'en reviens
toujours &`a l'Arsenal.
}
//	<<<ENGLISH>>>
//	I've checked out all the possibilities,
//	but I keep coming back to Arsenal.

//<ページ数変更>
オタコン_004_1: {
Ce n'est pas un point de relais,
c'est l'origine du signal...
}
//	<<<ENGLISH>>>
//	It isn't a relay point, it's
//	the origin of the signal.

/*いろいろな要素を検討したんだけど……
中継ではなく、アーセナル内部から
発信されているとしか考えられない。
*/
ライデン_005: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
オタコン_006: {
Le protocole de codage utilis&'e est
identique &`a celui du GW, qui est
le syst&`eme d'intelligence artificielle
de l'Arsenal.
}
//	<<<ENGLISH>>>
//	And, the encryption protocol it
//	uses is exactly the same as that of
//	Arsenal's AI -- the so-called GW.

/*それに……暗号化コードが同じなんだ。
『Ｇ．Ｗ』……アーセナルのＡＩと。*/
ライデン_007: {
Qu'est-ce que cela veut dire, alors ?
}
//	<<<ENGLISH>>>
//	...What the hell does this mean?

/*……どういうことなんだ？*/
オタコン_008: {
Ton Colonel n'est qu'un syst&`eme
d'intelligence artificielle !
}
//	<<<ENGLISH>>>
//	I think it means -- you've
//	been talking to an AI.

/*つまり……君が喋っていた相手は、
ＡＩなんだよ。*/
ライデン_009: {
C'est impossible !
}
//	<<<ENGLISH>>>
//	That's impossible!

/*嘘だ！！*/
オタコン_010: {
Le Colonel n'est pas le GW
}
//	<<<ENGLISH>>>
//	The Colonel probably
//	isn't GW per se.

//<ページ数変更>
オタコン_010_1: {
mais il stimule l'activit&'e corticale
de la zone inactive de ton cerveau
}
//	<<<ENGLISH>>>
//	GW was most likely stimulating
//	cortical activity in the dormant
//	part of your brain＃−

/*本当だ。正確には『Ｇ．Ｗ』そのもの
じゃない。おそらく『Ｇ．Ｗ』からの
信号が君の脳内ナノマシンを動かし、
*/
オタコン_011: {
en manipulant les signaux de
tes nano-machines...
}
//	<<<ENGLISH>>>
//	through signal manipulation
//	of your own nanomachines.

/*脳の使用されていない冗長部分の
神経配置を器質操作して『大佐』を
発生させるっていう仕組みだ……
*/
オタコン_012: {
Le Colonel est le fruit de ton imagination
et il correspond &`a tes attentes et &`a
ton v&'ecu...
}
//	<<<ENGLISH>>>
//	The Colonel is in part your own
//	creation, cobbled together from
//	expectations and experience...

/*つまり『大佐』は君の脳の中に
存在する……。*/
ライデン_013: {
C'est d&'ement...
}
//	<<<ENGLISH(2)>>>
//	That's crazy...

/*馬鹿な……。*/
オタコン_014: {
Pourtant, je crois que c'est vrai !
}
//	<<<ENGLISH>>>
//	But it's probably the truth.

/*でも、事実なんだ。*/
オタコン_015: {
Le virus commence peut-&^etre &`a affecter
le GW, ce qui explique le comportement
bizarre du Colonel...
}
//	<<<ENGLISH>>>
//	The virus may be starting to
//	affect GW, which would explain
//	the Colonel's behavior.

/*『大佐』の様子がおかしくなってるのは、
多分あのウィルスが『Ｇ．Ｗ』に効き
始めたせいだと思う。*/
ライデン_016: {
Tout ce que j'ai fait... 
n'&'etait qu'une illusion ?
}
//	<<<ENGLISH>>>
//	It was all -- an illusion?
//	Everything I've done so far...?

/*全て……幻……？
では……俺が今までしてきたことは……？*/
スネーク_017: {
Raiden !
}
//	<<<ENGLISH(2)>>>
//	Raiden!

/*ライデン！*/
ライデン_018: {
Snake ! Que se passe-t-il ici ?
}
//	<<<ENGLISH>>>
//	Snake -- what's happening
//	around here?

/*スネーク……
どういうことなんだろう？*/
スネーク_019: {
Je ne sais pas. Mais je suis s&^ur
que tu es devant moi.
}
//	<<<ENGLISH>>>
//	I don't know. What I do know is
//	that you're standing right here
//	in front of me.

/*わからん。
……俺に言えるのは、俺の目の前にいる
お前は幻じゃないということだけだ。*/
スネーク_020: {
Ce n'est pas une illusion. 
En chair et en os !
}
//	<<<ENGLISH>>>
//	Not an illusion --
//	flesh and blood.

/*お前は確かにここにいる。*/
ライデン_021: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
スネーク_022: {
A toi de choisir !
Si tu veux d&'eclarer forfait...
}
//	<<<ENGLISH>>>
//	It's your call. You can
//	drop this if you want.

/*どうする？
やめたければやめてもいい。*/
ライデン_023: {
Non, je ne peux pas faire &~qa.
En route...
}
//	<<<ENGLISH>>>
//	No, I can't do that.
//	Let's go...

/*いや。辞めるわけにはいかない。
行こう……。*/
}
//d





resource P077_01_R01_ローズ拉致１無線機デモ１＿１__f {
