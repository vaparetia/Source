resource P069_02_R01_ヴァンプ狙撃終了２無線機デモ１＿１__f {
//vc116901
プリスキン_000: {
Raiden !
Emma s'est fait poignarder !
}
//	<<<ENGLISH>>>
//	Raiden!
//	Emma's been stabbed!

/*ライデン！
エマが刺された！*/
ライデン_001: {
Quel salaud a fait &~qa !
}
//	<<<ENGLISH>>>
//	That bastard!

/*なんてこった！！*/
オタコン_002: {
Comment a-t-elle !?
}
//	<<<ENGLISH>>>
//	How bad is it!?

/*傷はどうなんだ！*/
プリスキン_003: {
Elle est consciente, mais elle perd
beaucoup de sang. Je la ram&`ene
tout de suite !
}
//	<<<ENGLISH>>>
//	She's conscious... but the
//	bleeding's bad. I'm bringing
