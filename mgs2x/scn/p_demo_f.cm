/* -------------------------------

プラント強制無線機デモどろどっち。
$Id: p_demo_f.cm,v 1.15 2002/08/02 10:52:48 usr01098 Exp $

---------------------------------*/

resource P001_02_R01_オープニング潜入２無線デモ１＿１__f {
ライデン_000: {
Ici Snake. Je me trouve
dans l'Etai A de la Shell 1.
}
//	<<<ENGLISH>>>
//	This is Snake. I am now inside
//	Strut A of Shell 1.

/*こちらスネーク、
シェル１のＡ脚内に潜入した。*/
大佐_001: {
Et alors ?
}
//	<<<ENGLISH>>>
//	How are things?

/*状況はどうだ？*/
ライデン_002: {
On a de la chance. Apparemment
pas de sentinelle dans les parages.
}
//	<<<ENGLISH>>>
//	We're in luck. Looks like there
//	are no sentries posted here.

/*幸い、ここには見張りはいないようだ。*/
大佐_003: {
Quelle est ta visibilit&'e ?
}
//	<<<ENGLISH>>>
//	What's the visibility?

/*視界はどうだ？*/
ライデン_004: {
L'&'eclairage des &'etais fonctionne.
Je n'aurai pas besoin de mettre
mes lunettes infrarouges.
}
//	<<<ENGLISH>>>
//	The lights on the plant's struts
//	are functioning. I won't have to
//	use the IR goggles.

/*プラント脚部のライトが起動している。
おかげで＃｛赤外線、サーマル｝＃ゴーグルは使わずに済む。*/
大佐_005: {
Des probl&`emes &`a signaler ?
}
//	<<<ENGLISH>>>
//	Any problems?

/*何か問題は？*/
ライデン_006: {
Un trou r&'ecent a &'et&'e pratiqu&'e
dans la barri&`ere flottante.
}
//	<<<ENGLISH>>>
//	There was a brand-new hole
//	cut through the oil fence.

/*オイルフェンスの切断面が真新しかった。*/
//<ページ数変更>
ライデン_006_1: {
Je ne suis pas le seul &`a vouloir entrer ici.
}
//	<<<ENGLISH>>>
//	There's someone else besides me
//	that wanted to get in badly.

/*俺の他にも潜入を試みた奴がいる。*/
大佐_007: {
C'est impossible !
}
//	<<<ENGLISH>>>
//	That's not possible.

/*それは考えられん。*/
ライデン_008: {
Et l'&'equipe SEAL 10 ?
}
//	<<<ENGLISH>>>
//	What about SEAL Team 10?

/*ＳＥＡＬ１０の突入班は？*/
大佐_009: {
Ses membres ont atterri sur le toit
de la Big Shell, comme pr&'evu.
}
//	<<<ENGLISH>>>
//	They landed on the roof of
//	the Big Shell as planned.
//<ページ数変更>
/*既に『ビッグ・シェル』上部に降下した。*/
大佐_009_1: {
Au fait, Snake, tu devras utiliser
un nouveau nom de code pour
tes futures communications.
}
//	<<<ENGLISH>>>
//	And by the way Snake, we're
//	changing your code name for
//	all following communication.

/*それとスネーク、今後の無線はコード
ネームを変更して行う。*/
ライデン_010: {
Pourquoi ne pas continuer
avec 'Snake' ?
}
//	<<<ENGLISH(2)>>>
//	What's wrong with "Snake"?

/*スネークでは何か問題が？*/
大佐_011: {
Simple pr&'ecaution. Tu seras
dor&'enavant appel&'e 'Raiden'.
}
//	<<<ENGLISH>>>
//	Just a precaution. You are
//	now designated "Raiden."

/*まあな……。
君をこれから、ライデンと呼ぶ*/
}//d

//★　タンカー編をクリアしたユーザーの場合
resource P001_02_R01_オープニング潜入２無線デモ１＿タンカーした１__f {
大佐_000: {
Bien, Raiden ! Tu as d&'ej&`a
fait des infiltrations lors de
ta formation RV.
}
//	<<<ENGLISH>>>
//	All right, Raiden. You've
//	already covered infiltration
//	in VR Training.

/*では、ライデン。
潜入ミッションは既にＶＲ訓練で
訓練済みだな。*/
ライデン_001: {
J'ai effectu&'e
trois cent missions en RV !
}
//	<<<ENGLISH>>>
//	I've completed three hundred
//	missions in VR.

/*ＶＲなら３００ミッションはこなした。*/
ライデン_002: {
Je me fais l'effet d'un mercenaire
de l&'egende...
}
//	<<<ENGLISH>>>
//	I feel like some kind of
//	legendary mercenary...

/*伝説の傭兵になった気分だ……。*/
}//d

resource P001_02_R01_オープニング潜入２無線デモ１＿タンカーした２__f {
大佐_000: {
Bon, on va faire l'impasse, alors...
}
//	<<<ENGLISH>>>
//	Okay, we'll skip that part.

/*それじゃ、その部分は簡略化するぞ*/
}//d


//★　タンカー編をクリアしていないユーザーの場合

resource P001_02_R01_オープニング潜入２無線デモ１＿タンカーしてない__f {
大佐_000: {
Tu vas effectuer ta premi&`ere
mission furtive.
}
//	<<<ENGLISH>>>
//	This will be your first
//	sneaking mission.

/*今回、君にとって初めての＃｛潜入任務、スニーキング・ミッション｝＃に
なる。*/
大佐_001: {
Tu devras naturellement
te procurer des armes sur place.
}
//	<<<ENGLISH>>>
//	The arms will naturally have
//	to be procured on-site.

/*当然、武器は現地調達だ。*/
}//d

resource P001_02_R01_オープニング潜入２無線デモ１＿２__f {
大佐_000: {
Mais sois s&^ur de ne
pas te faire rep&'erer.
}
//	<<<ENGLISH>>>
//	Make sure nobody sees you.

/*くれぐれも見つからんようにな*/
大佐_001: {
En cas de besoin, contactes-moi
par Codec. Fr&'equence 140.85.
}
//	<<<ENGLISH>>>
//	If you need to, contact me by Codec.
//	The frequency is 140.85.

/*何かあれば無線連絡をくれ。
周波数は１４０．８５だ*/
大佐_002: {
Quand tu veux te servir du Codec,
appuies sur la touche SELECT.
}
//	<<<ENGLISH>>>
//	When you want to use the Codec,
//	push the SELECT button.

/*無線機を使いたい時は
ＳＥＬＥＣＴボタンを押すんだ。*/
大佐_003: {
Si nous cherchons &`a te contacter,
le Codec sonnera.
}
//	<<<ENGLISH>>>
//	When we need to reach you...
//	contact you, the Codec will
//	beep.

/*こちらから呼び出す場合、
いや連絡する場合はＣＡＬＬする。*/
大佐_004: {
Si tu entends ce bruit, appuies
sur la touche SELECT.
}
//	<<<ENGLISH>>>
//	When you hear that noise,
//	press the SELECT button.

/*ＣＡＬＬ音がなったら、
ＳＥＬＥＣＴボタンを押してくれ。*/
大佐_005: {
Les petits os de ton oreille interne
sont directement stimul&'es par
le combin&'e du Codec.
}
//	<<<ENGLISH>>>
//	The Codec's receiver directly
//	stimulates the small bones of
//	your ear.

/*耳小骨を直接振動させるものだ。
*/
//<ページ数変更>
大佐_005_1: {
Toi seul l'entendras.
}
//	<<<ENGLISH>>>
//	No one but you will
//	be able to hear it.

/*敵には聞こえない。*/
ライデン_006: {
Tr&`es bien. Si la situation change,
je te contacterai.
}
//	<<<ENGLISH>>>
//	All right. I'll contact you
//	if anything changes.

/*わかった。
なにかあれば＃｛送信、ＳＥＮＤ｝＃する。*/
大佐_007: {
Rends-toi d'abord sur la partie
sup&'erieure de la Big Shell.
}
//	<<<ENGLISH>>>
//	First, make your way to
//	the upper section of the
//	Big Shell.

/*まずは『ビッグ・シェル』の上部に
出るんだ。*/
ライデン_008: {
Comment monter au niveau suivant ?
}
//	<<<ENGLISH>>>
//	How do I get up to
//	the next level?

/*上部へはどうやって？*/
}//d

//無線機スクリーンに昇降機の映像（ゲーム映像）が流れる。先行映像。ライデンが昇降機を見上げている＋主観映像。昇降機の場所と昇降機がわかる映像。

resource P001_02_R01_オープニング潜入２無線デモ１＿３__f {
大佐_000: {
Il y a un ascenseur &`a l'extr&'emit&'e
de cette zone. Empruntes-le.
}
//	<<<ENGLISH>>>
//	There's an elevator at the far end
//	of that area. Use that.

/*そのエリアの奥に昇降機がある。
それを使え。*/
ライデン_001: {
Bien vu !
}
//	<<<ENGLISH>>>
//	Sounds good.

/*わかった。*/
}//d

//映像消える。

resource P001_02_R01_オープニング潜入２無線デモ１＿４__f {
大佐_000: {
Ta nouvelle Combinaison furtive fait appel
&`a la technologie des fibres optiques. C'est
un sous-produit des recherches men&'ees
dans ce domaine.
}
//	<<<ENGLISH>>>
//	Your new Sneaking suit uses
//	electrofiber technology, a by-
//	product of fiber-optics research.
//d
/*今回のスニーキング・スーツは
光ファイバーを使った電気紡績技術を
使っている。*/
}
//オープニング潜入３ポリゴンデモ２へ




resource P001_04_R02_オープニング潜入４無線デモ２__f {
//vc110111
大佐_000: {
L'&'ecoutille pourvue d'une poign&'ee circulaire
m&`ene &`a la zone o&`u se trouve l'ascenseur.
Trouves d'abord cette &'ecoutille.
}
//	<<<ENGLISH>>>
//	The hatch with a circular handle
//	will open into the elevator area.
//	Locate the hatch first.

/*丸いハンドルの付いたハッチが
昇降機エリアへの入口だ。
まずはそれを探してくれ。*/
ライデン_001: {
Dupliques &~qa. Passons aux principaux
objectifs de la mission.
}
//	<<<ENGLISH>>>
//	Copy that. Moving onto
//	main mission objectives.

/*了解、＃｛作戦、ミッション｝＃に入る。*/
}//d

resource P002_02_R01_Ａ脚底部連結ハッチ２無線デモ１＿１__f {
//vc110201
ライデン_000: {
Colonel, j'ai rep&'er&'e
une sentinelle ennemie.
}
//	<<<ENGLISH>>>
//	Colonel, I've sighted
//	an enemy sentry.

/*大佐、敵兵を１名確認。*/
}//d

resource P002_02_R01_Ａ脚底部連結ハッチ２無線デモ１＿２__f {
//vc110202
ライデン_000: {
AN-94 et Makarov...
}
//	<<<ENGLISH>>>
//	AN-94 and a Makarov...

/*ＡＮ９４にマカロフ……。*/
ライデン_001: {
Ces grenades... Tout cet &'equipement
est de fabrication russe.
}
//	<<<ENGLISH>>>
//	Those grenades... all his
//	equipment is Russian-made.

/*グレネード……ロシア製の装備だ。*/
大佐_002: {
Ce doit &^etre un homme de Gurlukovich.
}
//	<<<ENGLISH>>>
//	Must be a Gurlukovich man.

/*ゴルルコビッチ大佐の部隊だろう*/
ライデン_003: {
Gurlukovich ?
}
//	<<<ENGLISH>>>
//	Gurlukovich?

/*ゴルルコビッチ？*/
大佐_004: {
Il s'agit d'une arm&'ee priv&'ee russe qui
s'&'etait entendue avec la troupe d'assaut
de Shadow Moses, il y a quatre ans.
}
//	<<<ENGLISH>>>
//	A Russian private army that was in
//	line to work with the Shadow Moses
//	takeover group, four years ago.

/*４年前のシャドーモセス事件の際、
テロリストと合流しようとしたロシアの
私兵部隊だ。*/
ライデン_005: {
Que fabriquent-ils ici ?
}
//	<<<ENGLISH>>>
//	What's their stake in this one?

/*なぜ彼らがこのテロに加わっている？*/
大佐_006: {
Ils doivent avoir pass&'e un accord --
et &^etre de maille avec les terroristes.
}
//	<<<ENGLISH>>>
//	They must have made a deal -- an
//	arrangement with the terrorists.

/*テロリスト達とのなんらかの取引が
あったに違いない。*/
大佐_007: {
Ils forment &`a pr&'esent un groupe
de mercenaires. Une arm&'ee apatride
en quelque sorte.
}
//	<<<ENGLISH>>>
//	They've become a band of
//	mercenaries, an army without
//	a country.

/*もはや彼らは国亡き傭兵部隊と
化している。*/
/*
大佐_008: {
通常、敵は君を見つけると仲間を呼ぶが、
そのエリアに限って言えば、その心配は
ない。
}
大佐_009: {
壁面に埋め込まれた無線通信補助
アンテナが錆び付いているんだ。
そのエリアで敵は無線を使えない。
}
ライデン_010: {
俺達の通信システムには影響ないのか？
}
大佐_011: {
ナノマシンには問題ない。
通常無線のみだ。
}
大佐_012: {
たとえ仲間を呼べなくても、
敵は武装している。
慎重にな、ライデン。
}
*/
}//d


resource P003_02_R02_スネーク昇降機上昇２無線デモ１＿１__f {
//vc110301
ライデン_000: {
Colonel, je sais avec certitude
qu'il y a un autre intrus ici.
}
//	<<<ENGLISH>>>
//	Colonel, there's definitely
//	another intruder in here
//	besides me.

/*大佐、やはり俺の他に誰か侵入者がいる。*/
大佐_001: {
C'est inconcevable.
}
//	<<<ENGLISH>>>
//	That's not a possibility.

/*ありえない事だ。*/
ライデン_002: {
Pas un groupe. On dirait plut&^ot
un travail en solo.
}
//	<<<ENGLISH>>>
//	Not a team -- looks like a solo job.

/*チームではない。単独のようだ。*/
大佐_003: {
Un seul homme... ?
}
//	<<<ENGLISH(2)>>>
//	One man...?

/*単独だと……？*/
ライデン_004: {
Je ne sais pas qui c'est, mais en tout cas,
il s'est charg&'e des sentinelles de la zone.
Elles sont toutes raides.
}
//	<<<ENGLISH>>>
//	We may not know who he is, but he
//	managed to take care of every sentry
//	in the area; they're all out cold.

/*素性はわからんが、ここの見張りを
全て片づけてくれたようだ。
みんな気を失っている。*/
ライデン_005: {
Ce type, on peut dire que c'est un pro.
}
//	<<<ENGLISH>>>
//	Whoever he is, he's got some skills.

/*かなりのタフガイだ。*/
大佐_006: {
Il faut qu'on l'identifie... Dans l'imm&'ediat,
profites de la situation et mets-toi au
travail.
}
//	<<<ENGLISH>>>
//	We need to get an ID... But for
//	now, you can take advantage of
//	the situation and get to work.

/* 意味が包含されている。008と融合。
大佐_007: {
今のうちにことを進めるとしよう。
}
*/
/*調査が必要だな……
しかし敵が無力化されているのは
とりあえず好都合だ。*/
大佐_008: {
Il y a un terminal devant l'ascenseur,
un n&@eud.
}
//	<<<ENGLISH>>>
//	There's a terminal in front
//	of the elevator, a node.

/*昇降機の前に端末がある。
『ノード』と呼ばれるものだ。*/
ライデン_009: {
Un 'n&@eud' ?
}
//	<<<ENGLISH(2)>>>
//	Did you say "nerd"?

/*＃｛まぬけ、ナード｝＃だって？*/
大佐_010: {
Oui, un dispositif nodal.
}
//	<<<ENGLISH(2)>>>
//	Not "nerd" -- "node."

/*ノードだ。*/
ライデン_011: {
Ah !
}
//	<<<ENGLISH(2)>>>
//	Oh.

/*なるほど、＃｛端末、ノード｝＃か。*/
大佐_012: {
Utilises le n&@eud pour acc&'eder
au r&'eseau de la Big Shell.
}
//	<<<ENGLISH>>>
//	Use the node to gain access to
//	the Big Shell's facilities network.

/*ノードを使えば『ビッグ・シェル』内の
作業支援コンピュータ・ネットワークに
接続できる。*/
ライデン_013: {
Et apr&`es ?
}
//	<<<ENGLISH>>>
//	Then what?

/*何が出来るんだ。*/
大佐_014: {
D&'eroules la carte de la structure
et actives le Radar Soliton.
}
//	<<<ENGLISH>>>
//	Pull up the map of the structure;
//	that'll let you activate the
//	Soliton Radar.

/*『ビッグ・シェル』のマップが参照
出来る。そしてそのデータによって
ソリトン・レーダーが使用可能になる。*/
ライデン_015: {
Le Radar Soliton ?
}
//	<<<ENGLISH>>>
//	The Soliton Radar?

/*ソリトン・レーダー？*/
}//d
resource P003_02_R02_スネーク昇降機上昇２無線デモ１＿２__f {
//vc110302
//（タンカー編をやってる人）
ライデン_000: {
Ce radar m'a &'et&'e tr&'es utile pendant
ma formation RV !
}
//	<<<ENGLISH>>>
//	True, that radar came in
//	useful during VR training.

/*ＶＲ訓練で重宝したレーダーだな。*/
}//d
resource P003_02_R02_スネーク昇降機上昇２無線デモ１＿３__f {
//vc110303
//（タンカー編をやってないひと。全員聞く音声）
大佐_000: {
Ce syst&`eme radar se fonde sur les champs
magn&'etiques biologiques.
}
//	<<<ENGLISH>>>
//	A radar system -- uses biological
//	magnetic fields as input.

/*人間の生体反応に起因する電磁場を
活用して判定を行うシステムだ。*/
大佐_001: {
Les positions ennemies probables sont
projet&'ees sur une carte
}
//	<<<ENGLISH>>>
//	These estimated enemy positions
//	are projected onto a map＃−

//<ページ数変更>
大佐_001_1: {
selon des points de r&'ef&'erence obtenus
par les signaux GPS et les indications
du personnel sur le terrain.
}
//	<<<ENGLISH>>>
//	according to reference points
//	collected via GPS signals and
//	field personnel reports.

/*それらをＧＰＳや各隊員から収集される
エリア測定値により、誤差を修正した
マップ上に投影する。*/
大佐_002: {
Pour pouvoir utiliser ce traitement des
donn&'ees, il faut acc&'eder &`a la carte par
l'interm&'ediaire du n&@eud de la Big Shell.
}
//	<<<ENGLISH>>>
//	We need to get to the map through
//	the Big Shell's node to put this
//	data processing to practical use.

/*この膨大なデジタル処理を
行う為にもノードによるマップ情報の
ダウンロードが必要なのだ。*/
大佐_003: {
L'unit&'e nodale fait environ un m&`etre
de haut et est &`a priori bleue.
}
//	<<<ENGLISH>>>
//	The node unit is about three feet
//	high -- should be colored blue.

/*ノードは１メートルくらいの高さの
青い端末だ。*/
//<ページ数変更>
大佐_003_1: {
Chaque zone en poss&`ede au moins une.
}
//	<<<ENGLISH>>>
//	Each area has at least one.

/* このセリフはカットになった。
usually built right into the
wall.
*/
/*各エリアに最低１台はある。
壁に埋め込まれているはずだ。*/
}//d

resource P003_02_R02_スネーク昇降機上昇２無線デモ１＿４__f {
//vc110304
ライデン_000: {
Comment avoir acc&`es &`a tout &~qa ?
}
//	<<<ENGLISH>>>
//	How do I gain access?

/*接続するにはどうすればいい？*/
大佐_001: {
Il suffit d'appuyer sur la touche Action
situ&'ee devant le n&@eud.
}
//	<<<ENGLISH>>>
//	Just push the Action button
//	in front of the node.

/*ノードの前で＃｛△、アクション｝＃ボタンを押すだけだ。*/
大佐_002: {
Les nanomachines de ton organisme se
chargeront de t'obtenir l'autorisation de
passer et te permettront l'acc&`es au n&@eud.
}
//	<<<ENGLISH>>>
//	The nanomachines in your body will
//	take care of the security clearance,
//	and allow you access to the node.

/*あとは君の体内のナノマシンが自動で
セキュリティを破りノードを使用可能に
してくれる。*/
大佐_003: {
Occupes t'en avant que ces sentinelles
ne reprennent connaissance.
}
//	<<<ENGLISH(2)>>>
//	Complete the procedure before
//	those sentries gain consciousness.

/*敵兵達が目覚める前にアクセスを
完了しろ。*/
大佐_004: {
Si elles te rep&`erent, l'acc&`es te sera
refus&'e pendant un certain temps.
}
//	<<<ENGLISH>>>
//	If they spot you, you won't be able
//	to gain access for a while.

/*敵に発見されるとアクセスは一時的に
できなくなる。*/
大佐_005: {
Restes sur tes gardes !
}
//	<<<ENGLISH>>>
//	Stay on guard.

/*注意するんだ。*/
ライデン_006: {
Compris !
}
//	<<<ENGLISH(2)>>>
//	Got it.

/*了解。*/
}//d

resource P004_02_R01_ノード初接続２無線デモ１＿１__f {
//vc110401
大佐_000: {
Tu as bien travaill&'e, Raiden !
}
//	<<<ENGLISH(2)>>>
//	Good work, Raiden.

/*ライデン、ノードにアクセスできた
ようだな。*/
ライデン_001: {
Le radar devrait d&'ej&`a fonctionner, non ?
}
//	<<<ENGLISH>>>
//	The radar should be
//	functioning now?

/*これでレーダーが使える？*/
}//d

resource P004_02_R01_ノード初接続２無線デモ１＿２__f {
//vc110402
//タンカー編をやっている人
大佐_000: {
Rem&'emores-toi ta formation RV !
}
//	<<<ENGLISH>>>
//	Remember your VR training sessions.

/*ＶＲ訓練を思い出せ。*/
大佐_001: {
L'outil utilis&'e est identique. Il reproduit le
terrain ainsi que la position du personnel
ennemi.
}
//	<<<ENGLISH>>>
//	The tool is exactly the same one --
//	it maps the terrain as well as the
//	position of enemy personnel.

/*ものは同じだ。
地形と敵兵の位置が表示される。*/
}//d

resource P004_02_R01_ノード初接続２無線デモ１＿３__f {
//vc110403
//タンカー編をやっていない人
大佐_000: {
Il faut que je vous parle de votre
radar Soliton.
}
//	<<<ENGLISH>>>
//	Let me explain about your
//	Soliton Radar system.

/*それではソリトン・レーダーの説明を
しよう。*/
大佐_001: {
Raiden, vous &^etes le petit point
brillant au centre ;
}
//	<<<ENGLISH>>>
//	The bright dot in the
//	middle is you, Raiden.

/*中心の光点が……ライデン、君の位置だ。*/
大佐_002: {
vos ennemis, les petits points rouges,
et le c&^one bleu repr&'esentent leur champ
de vision.
}
//	<<<ENGLISH>>>
//	The red dots are your enemies
//	and the blue cone shape represents
//	their field of vision.

/*そして赤い光点が敵の位置。
蒼い円錐が敵の視界……。*/
大佐_003: {
Les conditions m&'et&'eo n'affecteront
pas votre radar,
}
//	<<<ENGLISH(2)>>>
//	Your radar isn't
//	affected by the weather,

/*ソリトン・レーダーは気象には
影響されないが、*/
大佐_004: {
mais une fois d&'ecouvert par l'ennemi,
vous ne pourrez plus vous en servir.
}
//	<<<ENGLISH>>>
//	but if you're discovered by
//	an enemy you won't be able
//	to use it.

/*敵に発見されると
使えなくなる。*/
大佐_005: {
Il a tendance &`a flancher facilement.
}
//	<<<ENGLISH>>>
//	It gets jammed easily I'm afraid.

/*うむ、簡単に妨害されてしまうのだ。*/
大佐_006: {
Il est fabriqu&'e &`a partir
de la technologie actuelle.
}
//	<<<ENGLISH>>>
//	It's all made from currently
//	existing technology.

/*ソリトン・レーダーはもはや既存技術だ。*/
大佐_007: {
Vous ne pourrez pas l'utiliser en zone de
forte r&'esonance harmonique, m&'efiez-rous.
}
//	<<<ENGLISH>>>
//	You won't be able to use it in
//	an area with strong harmonic
//	resonance. So be careful.

/*それと音響共鳴の強い空間でも
使えないから注意しろ。*/
}//d

//ムービー終り
resource P004_02_R01_ノード初接続２無線デモ１＿４__f {
//vc110404
大佐_000: {
Appuyer sur la touche START devrait te 
donner acc&`es &`a la carte de configuration
de la Big Shell.
}
//	<<<ENGLISH>>>
//	The Big Shell's layout map should
//	now be available after touching
//	the START button.

/*『ビッグ・シェル』全体の構造マップは
ＳＴＡＲＴボタンでいつでも閲覧が
可能だ。*/
ライデン_001: {
Que dois-je faire pour sauvegarder
les donn&'ees de la mission ?
}
//	<<<ENGLISH>>>
//	How do I save the mission data?

/*潜入データの記録は？*/
大佐_002: {
J'ai allou&'e une fr&'equence sp&'eciale aux
sauvegardes. De plus, une analyste
travaillera sur les donn&'ees.
}
//	<<<ENGLISH>>>
//	I've set aside a proprietary
//	frequency for saves. And an
//	analyst to work on the data too.

/*セーブには専用回線を設けてある。
専用のアナリストもな。*/
}//d

resource P004_02_R01_ノード初接続２無線デモ１＿５__f {
//vc110405
ローズ_001: {
Jack -- tout va bien ?
}
//	<<<ENGLISH>>>
//	Jack -- is everything
//	all right?

/*ジャック……大丈夫？*/
ライデン_002: {
Qu'est-ce que tu fabriques ici !?
}
//	<<<ENGLISH>>>
//	What are you doing here!?

/*まさか！*/
ローズ_003: {
Jack, tu m'entends ?
}
//	<<<ENGLISH>>>
//	Jack, can you hear me?

/*ジャック、聞こえる？*/
ライデン_004: {
Rose ! Tu n'es pas cens&'ee &^etre
m&^el&'ee &`a tout &~qa !
}
//	<<<ENGLISH>>>
//	Rose!
//	You're not supposed
//	to be involved!

/*ローズ！
どうして君が！！*/
ライデン_005: {
Que se passe-t-il ?
}
//	<<<ENGLISH(2)>>>
//	What's going on!?

/*なぜ君がそこにいる！？*/
ローズ_006: {
Jack, je participe &`a la mission.
}
//	<<<ENGLISH>>>
//	Jack, I'm a part
//	of this mission.

/*ああ、
ジャック……私も作戦に参加するの。*/
ライデン_007: {
Qu'est-ce qui se passe, Colonel ?
}
//	<<<ENGLISH>>>
//	Colonel, what the hell
//	is going on?

/*どういう事だ？大佐！！*/
大佐_008: {
Raiden, je te pr&'esente l'analyste
de la mission. Elle t'aidera &`a
sauvegarder les donn&'ees.
}
//	<<<ENGLISH>>>
//	Raiden, meet the mission analyst.
//	She'll be overseeing the data
//	saving and support.

/*ライデン、彼女には今回のデータ記録と
サポートを担当して貰う。*/
ライデン_009: {
Pourquoi elle ?
}
//	<<<ENGLISH>>>
//	Why her?

/*なぜ彼女が？*/
大佐_010: {
L'analyste de FOXHOUND devant
participer &`a la mission a &'et&'e victime
d'un accident.
}
//	<<<ENGLISH>>>
//	The FOXHOUND analyst that was
//	supposed to take part in this
//	mission was in an accident.

/*本作戦に従事する予定だった
ＦＯＸ　ＨＯＵＮＤ部隊のオペレーターが
事故にあい、参加できなくなった。*/
大佐_011: {
Nous avons choisi Rosemary
pour la remplacer.
}
//	<<<ENGLISH(2)>>>
//	Rosemary was brought in
//	as a replacement.

/*それで急遽、
ローズマリー君が選ばれた……。*/
ライデン_012: {
Un accident...?
}
//	<<<ENGLISH>>>
//	An accident...?

/*事故……？*/
大佐_013: {
Et d'apr&`es nos fichiers, elle te conna&^it
mieux que personne !
}
//	<<<ENGLISH>>>
//	And according to the files, she
//	knows you better than anybody
//	else.

/*それに＃｛報告、レポート｝によると……
彼女は君を誰よりも知っている。*/
ライデン_014: {
Je sais que Rose fait partie du service,
mais l'analyse des donn&'ees n'a rien &`a
voir avec le travail de terrain !
}
//	<<<ENGLISH>>>
//	Rose may be in the service,
//	but an intelligence analyst
//	is no field officer.

/*彼女は確かに軍人だが……
内勤のデータ・アナリストに過ぎない。*/
大佐_015: {
Ne t'inqui&`etes pas ! Notre bureau
technique est l&`a pour l'aider !
}
//	<<<ENGLISH>>>
//	Not to worry.
//	She has our technical
//	staff at her disposal.

/*大丈夫だ。うちの専門スタッフが
オペレートする。*/
ライデン_016: {
Elle n'a jamais particip&'e &`a
une mission de terrain. C'est insens&'e !
}
//	<<<ENGLISH>>>
//	She's never been a part of a
//	field mission. This is insane.

/*実戦サポートなんて無理だ。
できっこない。*/
大佐_017: {
Si je l'ai choisie pour cette mission, c'est
que j'avais de bonnes raisons, soldat !
}
//	<<<ENGLISH>>>
//	I have my own reasons for selecting
//	her for this mission, soldier.

/*彼女をこの作戦に参加させたのには、
それなりの理由がある。*/
ライデン_018: {
Colonel, j'ai du mal &`a comprendre --
}
//	<<<ENGLISH>>>
//	Colonel, I fail to see --

/*大佐、俺には理解できない。*/
大佐_019: {
Je sais exactement ce dont tu es capable
en formation RV, mais &~qa ne suffit pas
toujours.
}
//	<<<ENGLISH>>>
//	I know your VR training performance
//	in and out. But sometimes that's not
//	enough.

/*私は君のＶＲ訓練の成績なら
よく知っている。
しかし、それ以上の事はわからない。*/
大佐_020: {
Tu as entendu parler de l'incident
de Shadow Moses ?
}
//	<<<ENGLISH>>>
//	You're familiar with the
//	Shadow Moses incident?

/*シャドーモセスの事は知っているな？*/
ライデン_021: {
Oui, je l'ai couvert en RV.
}
//	<<<ENGLISH>>>
//	You know I covered it in VR.

/*ああ、事件のＶＲも体験した。*/
大佐_022: {
Ce cas nous a enseign&'e un d&'etail
tactique crucial,
}
//	<<<ENGLISH>>>
//	If there's a crucial tactical
//	detail that case taught us,

/*あの事件で立証された。*/
//<ページ数変更>
大佐_022_1: {
&`a savoir que la volont&'e de l'agent &`a
survivre est pr&'edominante.
}
//	<<<ENGLISH>>>
//	it was the power of the operative's
//	will to survive.

/*兵士の士気を持続させる要素……。*/
ライデン_023: {
J'ai &'et&'e form&'e pour me battre ! Mes
sentiments personnels ne participent pas
&`a l'accomplissement de mes missions !
}
//	<<<ENGLISH>>>
//	I was trained to fight. My personal
//	feelings have no place in a mission.

/*俺は軍人として訓練されて来た。
己の感情には左右されない。*/
大佐_024: {
Nous avons appris que les choses ne se
passaient pas ainsi. Et sur le terrain,
toute aide est pr&'ecieuse.
}
//	<<<ENGLISH>>>
//	We've learned that it doesn't work
//	that way. And on the field, you need
//	all the help you can get.

/*そうはいかない。
本作戦に失敗は許されんのだ。*/
ローズ_025: {
Jack ? Tu vas devoir me supporter,
que tu le veuilles ou non !
}
//	<<<ENGLISH>>>
//	Jack? You're stuck with me
//	whether you like it or not.

/*ジャック？
いい、私は最後まであなたにつき合う。*/
ライデン_026: {
Rose...
}
//	<<<ENGLISH(2)>>>
//	Rose...

/*ローズ？*/
ローズ_027: {
Il faut que quelqu'un prenne
bien soin de toi. Mais --
}
//	<<<ENGLISH>>>
//	You need someone to watch
//	your back. But＃−

/*あなたが心配だから……ただし。*/
ローズ_028: {
J'ai mes conditions, Colonel !
}
//	<<<ENGLISH>>>
//	I have conditions that
//	need to be met, Colonel.

/*条件がある、大佐。*/
大佐_029: {
Quelles sont-elles ?
}
//	<<<ENGLISH(2)>>>
//	What is it?

/*なんだ？*/
ローズ_030: {
Je remplirai mes devoirs et prot&'egerai
les donn&'ees de cette mission.
}
//	<<<ENGLISH>>>
//	I'll perform my duties and
//	save that mission data.

/*私はこの作戦の＃｛記録、セーブ｝＃を行う。*/
//<ページ数変更>
ローズ_030_1: {
Toutefois, je sais que techniquement,
je ne fais pas partie de l'&'equipe de
contr&^ole de la mission.
}
//	<<<ENGLISH>>>
//	But I'm aware that technically,
//	I'm not part of the mission control
//	team.

/*でも、私は作戦の一部じゃない。*/
ローズ_031: {
Apr&`es tout, je ne suis qu'une fille
ordinaire soucieuse de la vie de Jack.
}
//	<<<ENGLISH>>>
//	After all, I'm just a normal
//	girl who's worried about Jack.

/*ジャックを案じる普通の女……*/

//<ページ数変更>
ローズ_031_1: {
Mais en dehors de mon travail sp&'ecifique,
cela signifie que je ne suis pas tenue &`a
ob&'eir &`a tes ordres, Colonel.
}
//	<<<ENGLISH>>>
//	But that means, Colonel, that I am
//	not required to follow your orders
//	outside of my immediate duties.

/*だから、
それ以外は大佐達の強制は受けない。*/
ローズ_032: {
Jack n'est pas qu'une simple personne
de terrain &`a superviser.
}
//	<<<ENGLISH>>>
//	Jack is not simply a field
//	personnel for me to track.
//<ページ数変更>
/*私にとって、彼は恋人、
ジャックでしかない。*/
ローズ_032_1: {
Selon moi, sa s&'ecurit&'e est
plus importante que la mission.
}
//	<<<ENGLISH>>>
//	His safety comes first
//	to me, not the mission.

/*彼の安否が最優先……。*/
ローズ_033: {
Par cons&'equent, je superviserai
}
//	<<<ENGLISH>>>
//	And because of that,
//	I will be monitoring...
//<ページ数変更>
ローズ_033_1: {
toutes vos communications
et en garderai note, Colonel !
}
//	<<<ENGLISH>>>
//	and keeping a record of every
//	communication you have with
//	him, Colonel.

/*だから、大佐との交信内容も傍聴する。
いえ、記録する。*/
大佐_034: {
... Vues les circonstrances, tu es libre
de prendre les mesures qui te semblent
appropri&'ees.
}
//	<<<ENGLISH>>>
//	... Given the circumstances,
//	you're free to do what you
//	see fit.

/*……わかった。好きにするがいい。*/
ローズ_035: {
Tu sais, je pr&'ef&`ere &~qa plut&^ot
que de rester &`a me ronger les sangs !
}
//	<<<ENGLISH>>>
//	Hey, I prefer this to being
//	kept in the dark, waiting.

/*考えようによっては……
この方がいいかも。何も知らされず、
待つだけなんて辛いだけだもの。*/
大佐_036: {
J'ai une demande &`a formuler,
si tu permets.
}
//	<<<ENGLISH>>>
//	I'd like to make a request,
//	if I may.

/*一つだけいいか？*/
ローズ_037: {
Bien s&^ur !
}
//	<<<ENGLISH(2)>>>
//	Of course.

/*何？*/
大佐_038: {
Son nom de code est Raiden.
Pourrais-tu l'appeler ainsi
le temps de dur&'ee de la mission ?
}
//	<<<ENGLISH>>>
//	His handle is Raiden. For the
//	duration of the mission, could
//	you call him that?

/*彼の名はライデンだ。
作戦遂行中はコードネームで呼んでくれ。*/
ローズ_039: {
Bien, Colonel !
}
//	<<<ENGLISH(2)>>>
//	Yes sir.

/*わかったわ。*/
ローズ_040: {
Tr&`es bien -- Raiden.
}
//	<<<ENGLISH>>>
//	All right -- Raiden.

/*じゃあ、ライデン？*/
ローズ_041: {
Dis-moi quand tu seras pr&^et &`a sauvegarder
tes donn&'ees.
}
//	<<<ENGLISH(2)>>>
//	Let me know when you're
//	ready to turn in a save.

/*潜入データを記録したい時は
私に連絡して。*/
ローズ_042: {
La fr&'equence sp&'eciale
allou&'ee aux sauvegardes est 140.96.
}
//	<<<ENGLISH>>>
//	The proprietary save frequency
//	is 140.96.

/*周波数は１４０．９６……
＃｛記録、セーブ｝＃用の専用回線よ。*/
}//d

resource P004_02_R01_ノード初接続２無線デモ１＿６__f {
//vc110406
ローズ_000: {
Je viens de changer de fr&'equence.
}
//	<<<ENGLISH>>>
//	I just switched frequencies.

/*今、周波数を変えたわ。*/
ローズ_001: {
Jack ?
}
//	<<<ENGLISH(2)>>>
//	Jack?

/*ジャック？*/
ライデン_002: {
Quoi ?
}
//	<<<ENGLISH(2)>>>
//	What?

/*なんだ？*/
ローズ_003: {
Tu sais quel jour on sera, demain ?
}
//	<<<ENGLISH>>>
//	Do you know what day
//	it is tomorrow?

/*明日、何の日か知ってる？*/
ライデン_004: {
Le 30 avril -- Y a-t-il quelque chose
de sp&'ecial, ce jour-l&`a ?
}
//	<<<ENGLISH>>>
//	April 30th -- is there something
//	special about it?

/*４月３０日……いや、わからない。*/
ローズ_005: {
Tu ne vois pas ?
}
//	<<<ENGLISH>>>
//	Isn't there?

/*ほんとに？*/
ライデン_006: {
Je ne me souviens plus, d&'esol&'e.
}
//	<<<ENGLISH>>>
//	I can't remember.
//	I'm sorry.

/*いや、悪いが思い出せない。*/
ローズ_007: {
Bah ! Je pers&'ev&'ererai jusqu'&`a
ce que tu trouves !
}
//	<<<ENGLISH>>>
//	Oh well, I'll keep trying
//	'til I hear the answer.

/*その答えを聞くまではがんばるわ。*/
ローズ_008: {
Je te laisse &`a pr&'esent, Jack.
Prends bien soin de toi.
}
//	<<<ENGLISH>>>
//	I'm going to let you go now, Jack.
//	Take care.

/*それじゃ、ジャック。がんばってね。*/
}//d

resource P005_03_R01ライデン昇降機上昇３無線デモ１＿１__f {
//vc110501
ライデン_000: {
Colonel, je suis sur le toit. Il n'y a pas
de sentinelle, mais avec cet &'eclairage,
une seule me rep&'ererait.
}
//	<<<ENGLISH>>>
//	Colonel, I'm on the roof. There are
//	no sentries, but it would only take
//	one to spot me in this light.

/*大佐、『ビッグ・シェル』の屋上に出た。
敵兵は見あたらないが見通しが良すぎる。*/
大佐_001: {
Finalement, tu n'as jamais fait de formation
RV en plein jour !
}
//	<<<ENGLISH>>>
//	You never had daylight
//	VR training, after all.

/*夜間潜入の訓練しかしていなかったな。*/
大佐_002: {
Sois tr&`es prudent jusqu'&`a ce que tu trouves
un n&@eud o&`u te connecter.
}
//	<<<ENGLISH>>>
//	Stay extra sharp until you can
//	find a node to log in from.

/*ノードにアクセスするまでは、
警戒していくしかない。*/
ライデン_003: {
Et les commandos ?
}
//	<<<ENGLISH>>>
//	What about the commandos?

/*突入部隊はどうなった？*/
大佐_004: {
L'&'equipe SEAL 10 a atterri
sur les Etais B et C.
}
//	<<<ENGLISH>>>
//	SEAL Team 10 has landed
//	on Struts B and C.

/*ＳＥＡＬ１０はＢ脚、Ｃ脚に降下した。*/
ライデン_005: {
Et le Pr&'esident ?
}
//	<<<ENGLISH>>>
//	And the President?

/*大統領は？*/
大佐_006: {
Il semble avoir &'et&'e aper&~qu sur l'Etai B.
}
//	<<<ENGLISH>>>
//	Seems he was spotted
//	on Strut B.

/*Ｂ脚で発見されたらしい。*/
ライデン_007: {
Sur l'Etai B ?
}
//	<<<ENGLISH>>>
//	Strut B?

/*Ｂ脚？*/
}//d


resource P005_05_R02_ライデン昇降機上昇５無線デモ２__f {
//vc110511
大佐_000: {
Trouves d'abord un n&@eud et connectes-toi
au r&'eseau.
}
//	<<<ENGLISH>>>
//	First, get to a node.
//	Log into the network.

/*まずはノードを探してみろ。
ノードにアクセスすればわかる。*/
ライデン_001: {
Compris !
}
//	<<<ENGLISH(2)>>>
//	Got it.

/*了解。*/
}//d



resource P006_01_R01_Ａ脚金網１無線デモ１__f {
//vc110601
大佐_000: {
Raiden, l'&'equipe SEAL 10
est &`a l'int&'erieur.
}
//	<<<ENGLISH>>>
//	Raiden, SEAL Team 10 is in.

/*ライデン、ＳＥＡＬ・チーム１０が
突入を開始した。*/
ライデン_001: {
Est-ce que nous n'avons vraiment aucun
rapport avec SEAL ?
}
//	<<<ENGLISH>>>
//	Do we really have no line of
//	communication with the SEALs?

/*ＦＯＸＨＯＵＮＤとＳＥＡＬの
コンセサンスは本当にないのか？*/
大佐_002: {
Ils ignorent tout de nous. Nous travaillons
dans la clandestinit&'e et cette mission ne
d&'eroge pas &`a la r&`egle.
}
//	<<<ENGLISH>>>
//	They don't know a thing about us.
//	You know we work in the dark,
//	and this mission is no exception.

/*先方は我々の事を何も知らない。
我々は隠密組織だ。任務も機密事項。
*/
//<ページ数変更>
大佐_002_1: {
Peu de personnes sont au courant
de ta pr&'esence ici.
}
//	<<<ENGLISH>>>
//	Only a few people know
//	about your presence here.

/*君の潜入を知る者は極少数だ。*/
ライデン_003: {
... 
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
大佐_004: {
Ne te fais aucun souci. Cette op&'eration
est t&'el&'ecommand&'ee par le Pentagone.
}
//	<<<ENGLISH(2)>>>
//	There's no need for concern.
//	This operation is under Pentagon's
//	direct command,

/*今回の作戦は＃｛国防総省、ペンタゴン｝＃が直接指揮を
取っている。*/
//<ページ数変更>
大佐_004_1: {
Quant aux NSDD, les d&'ecisions relatives
&`a la S&'ecurit&'e nationale, &'emanent du
Vice-Pr&'esident
}
//	<<<ENGLISH>>>
//	and the NSDD (National Security
//	Decision Directives) came from
//	the Vice President＃−

大佐_004_2: {
et du Secr&'etaire d'Etat.
}
//	<<<ENGLISH(2)>>>
//	and the Secretary of Defense.

/*＃｛国家安全保障決定命令、ＮＳＤＤ｝＃も
副大統領と国防省長官によって行われた。*/
大佐_005: {
Ta mission est certes top secr&`ete,
mais elle a suivi les canaux habituels.
}
//	<<<ENGLISH(2)>>>
//	Your mission may be top-secret,
//	but it's gone through the usual
//	channels.

/*君の任務は極秘だが正規の手続きに
基づいているんだ。心配するな。*/
}//d


resource P007_01_R01_Ａ脚ノード前１無線デモ１＿１__f {
//vc110701
ライデン_000: {
Colonel, j'ai rep&'er&'e le n&@eud, mais il est
sous haute surveillance. Impossible de
m'en approcher davantage.
}
//	<<<ENGLISH>>>
//	Colonel, I've located the node,
//	but it's under heavy surveillance.
//	I can't get in any closer.

/*大佐、ノードを発見したが、
敵が陣取っていて近づけない。*/
大佐_001: {
Fais diversion. Essaie de faire du bruit
pour d&'etourner leur attention.
}
//	<<<ENGLISH>>>
//	Distract them. Try making some
//	noise to draw their attention away.

/*敵をおびき寄せるんだ。
音を立ててみろ。*/
ライデン_002: {
Comment ?
}
//	<<<ENGLISH(2)>>>
//	How?

/*どうやって？*/
大佐_003: {
Colle-toi contre un mur et appuie
sur la touche Coup de poing.
}
//	<<<ENGLISH>>>
//	Flatten yourself against a wall
//	and hit the Punch button.

/*壁にはりついて、＃｛○、パンチ｝＃ボタンだ。*/
}

//小画面に映像。同じシーンで物音を立てるライデン。
resource P007_01_R01_Ａ脚ノード前１無線デモ１＿２__f {
//vc110702
ライデン_001: {
Compris.
}
//	<<<ENGLISH(2)>>>
//	Got it.

/*わかった。*/
}//d


resource P008_01_R01_ＡＢ連絡橋１無線デモ１＿１__f {
//vc110801
大佐_000: {
Attention, Raiden. Il y a des sentinelles
en faction sur la passerelle de connexion.
}
//	<<<ENGLISH>>>
//	Raiden, watch out. There are
//	sentries posted on the connecting
//	bridge.

/*ライデン、気をつけろ。
連絡橋の中央に見張りがいる。*/
//<ページ数変更>
大佐_000_1: {
Modifies ta trajectoire sinon
elles te rep&'ereront.
}
//	<<<ENGLISH>>>
//	They will spot you if you
//	continue on course.

/*そのまま進めば発見されるぞ。*/
ライデン_001: {
Qu'est-ce que tu me conseilles ?
}
//	<<<ENGLISH>>>
//	Any recommendations?

/*どうすれば？*/
大佐_002: {
Sers-toi du mode de suspension.
}
//	<<<ENGLISH>>>
//	Use the Hanging mode.

/*＃｛ぶら下がり、エルード｝＃を使うんだ。*/
ライデン_003: {
Du mode de suspension ?
}
//	<<<ENGLISH>>>
//	Hanging?

/*エルード？*/
}//d

resource P008_01_R01_ＡＢ連絡橋１無線デモ１＿２__f {
//vc110802
大佐_000: {
Places-toi devant un garde-fou qui t'arrive
&`a la taille et appuies sur la touche Action
pour lui sauter par-dessus et t' accrocher.
}
//	<<<ENGLISH>>>
//	Face any waist-high railing and
//	push the Action button to clear
//	the railing and hang over the side.

/*腰くらいの高さの手すりに向かって
＃｛△、アクション｝＃ボタンを押すと、手すりを乗り越えて
向こう側にぶら下がることが出来る。*/
大佐_001: {
&`A lui ainsi, tu peux te d&'eplacer
lat&'eralement sans te faire rep&'erer
par l'ennemi.
}
//	<<<ENGLISH>>>
//	Once there, you can move sideways
//	while keeping out of enemy sight.

/*そのまま移動すれば敵に見つからずに
進めるはずだ。*/
ライデン_002: {
Tr&`es bien, je vais essayer.
}
//	<<<ENGLISH>>>
//	All right, I'm giving it a try.

/*わかった、やってみる。*/
大佐_003: {
N'oublies pas la Jauge de GRIP.
Elle diminue tout au long de ta
man&@euvre de suspension.
}
//	<<<ENGLISH>>>
//	Don't forget the Grip Gauge.
//	It will keep decreasing during
//	a Hanging maneuver,

/*＃｛握力、ＧＲＩＰ｝＃ゲージを忘れるな。
エルードしている間、時間と共に
減っていく。
*/
大佐_004: {
Si elle tombe &`a z&'ero,
tu fais la culbute !
}
//	<<<ENGLISH(2)>>>
//	and once it runs out,
//	you will fall.

/*ゲージがなくなると落下してしまうぞ。*/
}//d

resource P008_01_R01_ＡＢ連絡橋１無線デモ１＿３__f {
//vc110803
ライデン_000: {
Dupliques &~qa.
}
//	<<<ENGLISH(2)>>>
//	Copy that.

/*了解。*/
}//d

resource P008_01_R01_ＡＢ連絡橋１無線デモ１＿ＳＥＡＬＳ無線傍受__f {
//vcxxxxxxxx
大佐_000: {
Une seconde ! Je viens d'intercepter de
nouveaux renseignements sur l'op&'eration
men&'ee par l'&'equipe SEAL 10.
}
//	<<<ENGLISH>>>
//	Wait a second, I just intercepted
//	new intelligence on the operation
//	being executed by SEAL Team 10.

/*まて、ライデン。
今、ＳＥＡＬ１０突入部隊の無線を
傍受した。*/
ライデン_001: {
Tu as 'intercept&'e' des renseignements ?
}
//	<<<ENGLISH>>>
//	Intercepted?

/*傍受？*/
大佐_002: {
Comme je te l'ai d&'ej&`a dit,
ils ne doivent pas savoir
que nous sommes ici.
}
//	<<<ENGLISH>>>
//	As I said before, they need to be
//	kept in the dark about our presence.

/*もう一度言うが、彼らは我々の存在を
知らない。*/
ライデン_003: {
On se contente de les &'ecouter,
alors...
}
//	<<<ENGLISH>>>
//	So we just listen in...

/*盗み聞きってわけか。*/
大佐_004: {
Je per&~qois des bribes.
}
//	<<<ENGLISH>>>
//	I'm patching it through.

/*そっちへ繋ぐ……。*/
//画面にはＳＥＡＬＳの顔は表示されない。画面はライデンと大佐。

シールズ_005: {
Ici Alpha Z&'ero.
Nous avons le Pr&'esident.
}
//	<<<ENGLISH>>>
//	This is Alpha Zero.
//	We have the President.

/*こちらアルファー・ゼロ。
大統領を確保……。*/
シールズ隊長_006: {
Il est en s&^uret&'e ?
}
//	<<<ENGLISH>>>
//	Is he safe?

/*無事か！*/
シールズ_007: {
Affirmatif.
}
//	<<<ENGLISH>>>
//	He is safe.

/*無事です。*/
シールズ隊長_008: {
Et le paquet ?
}
//	<<<ENGLISH(2)>>>
//	What about the package?

/*パッケージは？*/
シールズ_009: {
Dis aux types en haut que nous avons
le paquet. C'est de l'argent vite gagn&'e.
}
//	<<<ENGLISH>>>
//	Tell the guys upstairs that
//	we've secured the package.
//	Easy money.

/*海軍大佐共々、保護しました。
楽勝でしたよ……。*/
シールズ隊長_010: {
Bravo ! On vient vous chercher.
Rentrez au bercail...
}
//	<<<ENGLISH>>>
//	Good work. Your retrieval is
//	on the way. Come on home...

/*よし、ヘリを回す。脱出してくれ……。*/
シールズ_011: {
Compris...
}
//	<<<ENGLISH(2)>>>
//	Roger that...

シールズ_011_1: {
Zut !
}
//	<<<ENGLISH>>>
//	H-holy!

/*了解……な、なんだ！？*/
//銃声！！無線にノイズが！！
シールズ隊長_012: {
Alpha Z&'ero ! Au rapport !
}
//	<<<ENGLISH>>>
//	Alpha Zero! Report!!

/*どうした！！*/
シールズ_013: {
Mince ! Couvrez le Pr&'esident !
}
//	<<<ENGLISH>>>
//	Dammit!
//	Cover the President!!

/*くっ！大統領を守れ！！*/
シールズ隊長_014: {
R&'epondez, Alpha Z&'ero !
}
//	<<<ENGLISH>>>
//	Come in, Alpha Zero!

/*アルファ・ゼロ！*/
シールズ_015: {
Ici Alpha Z&'ero.
On s'est fait attaquer !
}
//	<<<ENGLISH>>>
//	This is Alpha Zero.
//	We are under attack!

/*こちらアルファ・ゼロ。敵と遭遇！！*/
シールズ_016: {
C'est insens&'e !
Est-ce l'&@euvre de...!?
}
//	<<<ENGLISH>>>
//	This is crazy!
//	Is that...!?

/*馬鹿な！あれが！？*/
シールズ隊長_017: {
Alpha Z&'ero, r&'epondez !
}
//	<<<ENGLISH>>>
//	Alpha Zero, respond!

/*どうしたアルファ・ゼロ！*/
シールズ_018: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
シールズ隊長_019: {
Membres de l'&'equipe Alpha, r&'epondez !
}
//	<<<ENGLISH>>>
//	All Alpha, respond!

/*オール・アルファ、応答せよ！！*/

//無線通じなくなる

大佐_020: {
Raiden, la vie du Pr&'esident est
en danger ! Rends-toi tout de
suite sur l'Etai B !
}
//	<<<ENGLISH>>>
//	Raiden, the President's life is
//	in danger! Head to Strut B now!

/*ライデン、大統領の身が危ない！
Ｂ脚に急いでくれ！*/
}//d



resource P009_01_R01_サイファー遭遇１無線デモ１＿１__f {
//vc110901
大佐_000: {
Raiden, fais gaffe ! C'est un Cypher,
une sorte de v&'ehicule a&'erien inhabit&'e
(VAI) !
}
//	<<<ENGLISH>>>
//	Raiden, watch your back!
//	That's a Cypher, a type of UAV!

/*ライデン、気をつけろ！
それはサイファー。
＃｛無人偵察機、ＵＡＶ｝＃の一種だ！*/
}//d

resource P009_01_R01_サイファー遭遇１無線デモ１＿２__f {
//vc110902
大佐_000: {
S'il te rep&`ere, il alertera le personnel
ennemi. Sois tr&`es prudent !
}
//	<<<ENGLISH>>>
//	If it spots you, it will alert
//	enemy personnel. Exercise
//	extreme caution.

/*見つかると敵を呼ばれるぞ。
注意しろ。*/
大佐_001: {
Mais tu peux utiliser un dispositif
de brouillage pour cr&'eer un champ
d'interf&'erences et mettre ses capteurs
hors course pour un moment.
}
//	<<<ENGLISH>>>
//	But you can use chaff to set up
//	an interference field. That'll knock
//	its sensors offline for a while.

/*だがチャフを使って電子妨害を行えば
無力化出来る。*/
//<ページ数変更>
大佐_001_1: {
Essaies de trouver des particules
m&'etalliques.
}
//	<<<ENGLISH>>>
//	Try to locate some chaff.

/*チャフを探せ！*/
大佐_002: {
Tu peux &'egalement d&'etruire le moteur ou
la cam&'era. Mais m&'efies-toi -- certains VAI
sont arm&'es.
}
//	<<<ENGLISH>>>
//	You can also destroy the engine or
//	the camera. Some of the UAV's may
//	be armed -- be careful.

/*あるいはエンジンか、カメラ部分を
破壊するんだ。武装したタイプも
あるかもしれん。気を付けろ。*/
}//d


resource P010_04_R01_ヴァンプ遭遇４無線デモ１＿１__f {
//vc111001
大佐_000: {
Et le Pr&'esident ?
}
//	<<<ENGLISH(2)>>>
//	What about the President?

/*大統領は？*/
ライデン_001: {
Il semble avoir &'et&'e transport&'e ailleurs...
}
//	<<<ENGLISH>>>
//	Looks like they took him
//	somewhere else...

/*連れ去られたようだ……。*/
大佐_002: {
Je vois... Tu dis qu'un membre
de l'&'equipe SEAL 10 a surv&'ecu ?
}
//	<<<ENGLISH>>>
//	I see... You said there was a
//	survivor from SEAL Team 10?

/*そうか……ＳＥＡＬ１０に生き残りが
いると言ったな。*/
ライデン_003: {
Ouais, le lieutenant Pliskin.
}
//	<<<ENGLISH>>>
//	Yeah.
//	Lieutenant J.G. Pliskin.

/*ああ。プリスキン中尉だ。*/
大佐_004: {
Il a vu ton visage ?
}
//	<<<ENGLISH>>>
//	Has he seen your face?

/*……顔を見られたか？*/
ライデン_005: {
Quoi ?
}
//	<<<ENGLISH(2)>>>
//	What?

/*なんだって？*/
大佐_006: {
Cette mission est top secr&`ete. Personne
ne doit savoir que nous sommes impliqu&'es.
}
//	<<<ENGLISH>>>
//	This is a top-secret mission.
//	No one can know that we're
//	involved.

/*隠密行動だ。誰にも悟られてはならん。*/
ライデン_007: {
C'est un peu tard pour &~qa !
}
//	<<<ENGLISH>>>
//	It's a little too late for that.

/*……もう手遅れだ。*/
}//d



resource P011_01_R01_ＢＣ連絡橋ＣＡＬＬ１無線デモ１＿１__f {
//vc111101
ローズ_000: {
Jack, c'est moi...
}
//	<<<ENGLISH>>>
//	Jack, it's me...

/*ジャック、私……。*/
ライデン_001: {
Tout va bien, Rose ?
}
//	<<<ENGLISH>>>
//	Everything okay, Rose?

/*どうした？
ローズ？*/
ローズ_002: {
Tu ne dois pas sauvegarder
les donn&'ees de la mission ?
}
//	<<<ENGLISH>>>
//	Don't you need to save
//	the mission data?

/*潜入データの＃｛記録、セーブ｝＃はいいの？*/
ライデン_003: {
Ah oui ! Merci de me le rappeler !
}
//	<<<ENGLISH>>>
//	Oh yeah -- thanks for the reminder.

/*ああ、そうだな……頼むよ。*/
}//d

resource P011_01_R01_ＢＣ連絡橋ＣＡＬＬ１無線デモ１＿２__f {
//vc111102
ローズ_000: {
Jack, tu sais quel jour on est, demain ?
}
//	<<<ENGLISH>>>
//	Jack, do you remember
//	what day tomorrow is?

/*ジャック、明日、何の日だかわかった？*/
ライデン_001: {
Il faut qu'elle remette &~qa...
}
//	<<<ENGLISH>>>
//	That again...

/*またか……。*/
ライデン_002: {
D&'esol&'e, mais je ne le sais
pas plus qu'avant !
}
//	<<<ENGLISH>>>
//	I'm sorry, but I still
//	don't have a clue.

/*悪いが思い出せない。*/
ローズ_003: {
Tant pis.
}
//	<<<ENGLISH>>>
//	That's okay.

/*そう……。*/
ライデン_004: {
Qu'y a-t-il, Rose ?
Dis-moi !
}
//	<<<ENGLISH>>>
//	What is it, Rose?
//	Talk to me.

/*何があるんだ？*/
ローズ_005: {
Je pr&'ef&'ererais que tu devines.
C'est important.
}
//	<<<ENGLISH>>>
//	I'd rather you figure it out.
//	It's important.

/*いいの、あなたが思い出して？
話があるの。*/
ライデン_006: {
C'est vraiment important ?
}
//	<<<ENGLISH>>>
//	How important?

/*話？*/
ローズ_007: {
Assez, oui.
Nous en parlerons demain.
}
//	<<<ENGLISH>>>
//	Important enough.
//	And we'll talk about it,
//	tomorrow.

/*そう、重要な話。
それも明日、話したい。*/
ライデン_008: {
Pourquoi pas maintenant ?
}
//	<<<ENGLISH>>>
//	Why not now?

/*今じゃダメなのか？*/
ローズ_009: {
Demain me semble -- plus appropri&'e.
Il me faudra tout mon courage pour
ne pas me d&'egonfler.
}
//	<<<ENGLISH>>>
//	Tomorrow seems more -- appropriate.
//	I need all the help I can get so that
//	I won't chicken out anyway.

/*ええ、明日がいい。
勇気がいるの。*/
ライデン_010: {
C'est pour &~qa que tu as d&'ecid&'e
de participer &`a cette mission ?
}
//	<<<ENGLISH>>>
//	Is that the reason you decided
//	to be part of this mission?

/*まさか、その為にこの作戦に？*/
ローズ_011: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
ライデン_012: {
Bon... Je vais t&^acher de finir ce truc
demain, co&^ute que co&^ute.
}
//	<<<ENGLISH>>>
//	OK... I'm going to finish this
//	thing by tomorrow, no matter what.

/*わかった。
明日までにはなんとか任務を完了させる。*/
ローズ_013: {
Tu sais que je ferai tout ce que
je peux pour t'aider.
}
//	<<<ENGLISH>>>
//	You know I'll do everything
//	I can to help you.

/*がんばって……。*/
ライデン_014: {
Rose, j'ai un travail &`a te 
confier, en tant qu'analyste.
}
//	<<<ENGLISH>>>
//	Rose, there's something I need
//	you to do as an analyst.

/*ローズ、データ・アナリストとして、
調べてもらいたい事がある。*/
ローズ_015: {
De quoi s'agit-il ?
}
//	<<<ENGLISH(2)>>>
//	What is it?

/*なに？*/
ライデン_016: {
Cela concerne Solid Snake.
}
//	<<<ENGLISH>>>
//	It has to do with Solid Snake.

/*ソリッド・スネークの事だ。*/
//<ページ数変更>
ライデン_016_1: {
Le chef de cette prise d'assaut pr&'etend
&^etre Snake en personne.
}
//	<<<ENGLISH>>>
//	The leader of this takeover
//	incident is claiming that he's
//	Snake himself.

/*今回のテロリストの＃｛首領、ボス｝＃が
そう名乗ってる。
*/
ローズ_017: {
Le mercenaire l&'egendaire ? Hum...
}
//	<<<ENGLISH>>>
//	The legendary mercenary?
//	Hm.

/*伝説の傭兵ね。*/
ライデン_018: {
J'ai besoin d'un maximum d'informations
sur lui. Transmets-moi toutes les donn&'ees
le concernant dat&'ees d'apr&`es l'incident de
Shadow Moses.
}
//	<<<ENGLISH>>>
//	I need as much data on him as
//	possible. Everything they have on
//	him after the Shadow Moses incident.

/*彼の詳細データが欲しい。
シャドーモセス事件の後、
どうなったか……。*/
ローズ_019: {
Il est mort &`a pr&'esent, pas vrai ?
}
//	<<<ENGLISH>>>
//	He's dead now, isn't he?

/*もう亡くなってるんでしょ？*/
ライデン_020: {
Il doit y avoir un rapport d'inhumation
quelque part.
}
//	<<<ENGLISH>>>
//	Yes.
//	Should be a burial record
//	somewhere too.

/*ああ。遺体がどこかに
埋葬されているはずだ。*/
ライデン_021: {
Tu devrais pouvoir demander au Colonel
l'autorisation de compulser les informations
confidentielles.
}
//	<<<ENGLISH>>>
//	You should be able to request
//	top-level security clearance
//	from the Colonel.

/*大佐に頼めば、最高度のセキュリティ・
クリアランスが貰えるはず。*/
//<ページ数変更>
ライデン_021_1: {
On aurait ainsi acc&`es aux documents
les plus sensibles.
}
//	<<<ENGLISH>>>
//	That should get us into the
//	most classified material.

/*どんな極秘ファイルにも近づける。
*/
ローズ_022: {
Je m'en charge !
}
//	<<<ENGLISH(2)>>>
//	I'm on it.

/*わかったわ。
調べてみる……。*/
ローズ_023: {
Je t'appelle d&`es que quelque chose !
}
//	<<<ENGLISH>>>
//	I'll contact you as soon
//	as I find out something.

/*何かわかったら、＃｛ＣＡＬＬ、コール｝＃するわ。*/
}//d




resource P012_02_R01_フォーチュン遭遇２無線デモ１＿１__f {
//vc111201
ライデン_000: {
Colonel, le groupe Bravo de l'&'equipe
SEAL 10 a &'et&'e d&'ecim&'e.
}
//	<<<ENGLISH>>>
//	Colonel, SEAL Team 10's
//	Bravo team was wiped out.

/*大佐、ＳＥＡＬ１０ブラボー・チームが
全滅した……。*/
大佐_001: {
Je vois.
}
//	<<<ENGLISH(2)>>>
//	I see.

/*そうか……。*/
ライデン_002: {
Qu'est-il arriv&'e aux h&'elicos
de transport ?
}
//	<<<ENGLISH>>>
//	What happened to the cargo
//	choppers?

/*……突入したヘリはどうなった？*/
大佐_003: {
Ils sont tous les deux au fond du port.
Il semblerait que tes nouveaux h&^otes
poss&`edent un Harrier-2.
}
//	<<<ENGLISH>>>
//	Both of them are at the bottom of
//	the harbor. Looks like your new
//	hosts have a Harrier 2.

/*……２機共、マンハッタン湾に沈んだ。
奴等はハリアー２を所持しているようだ。*/
ライデン_004: {
Un Harrier ?
Qu'est-ce que c'est ?
}
//	<<<ENGLISH>>>
//	A Harrier?
//	What is this?

/*馬鹿な！ハリアーだって？*/
大佐_005: {
Calmes-toi. C'est seulement parce qu'ils
ont anticip&'e l'attaque !
}
//	<<<ENGLISH>>>
//	Calm down. It just means
//	they anticipated the attack.

/*うろたえるな。
予想されたことだ。*/
ライデン_006: {
Quoi ?
}
//	<<<ENGLISH(2)>>>
//	What?

/*なに？*/
大佐_007: {
De plus, depuis que les SEAL ont fait
feu, ton infiltration est pass&'ee comme
une lettre &`a la poste. 
}
//	<<<ENGLISH>>>
//	Besides, since the SEALs drew
//	their fire, your infiltration
//	went off without a hitch.

/*彼らがデッドセルを引き付けてくれた
お陰で君の潜入は成功し、*/
//<ページ数変更>
大佐_007_1: {
Et on conna&^it leur potentiel d&'efensif.
}
//	<<<ENGLISH>>>
//	On top of that, we know their
//	defensive capabilities.

/*敵の戦力も
把握できた……。*/
ライデン_008: {
Tu veux dire que tout &~qa
n'&'etait qu'une feinte ?
}
//	<<<ENGLISH>>>
//	Are you saying that
//	this was all a feint?

/*全て＃｛陽動作戦、フェイント・オペレーション｝＃だったって言うのか！？*/
大佐_009: {
Raiden, reprends-toi ! La mission repose
enti&`erement sur tes &'epaules, &`a pr&'esent.
Tu comprends ?
}
//	<<<ENGLISH>>>
//	Raiden, get a hold of yourself.
//	The entire mission is in your
//	hands now, do you understand?

/*ライデン、落ち着くんだ。
これより任務は全て君独りに
託されるんだぞ。*/
ライデン_010: {
Mais...
}
//	<<<ENGLISH>>>
//	But...

/*しかし……。*/
大佐_011: {
On n'a plus le temps de tergiverser.
Ils risquent d'exercer des repr&'esailles
pour se venger de cet assaut rat&'e !
}
//	<<<ENGLISH>>>
//	There's no time for questions.
//	They could decide to retaliate
//	for that failed assault.

/*迷っている暇はない。
奴等が突入の報復を行うことが
考えられる。*/
ライデン_012: {
Contre les otages, tu veux dire ?
}
//	<<<ENGLISH>>>
//	You mean the hostages?

/*……人質の命が危ないと？*/
大佐_013: {
Leur vie est peut-&^etre en danger.
Et il est possible qu'ils veuillent
faire sauter la Big Shell !
}
//	<<<ENGLISH>>>
//	They could be in danger, yes. But
//	we need to consider the possibility
//	that they'll blow the whole Shell.

/*それもある。だが同様に警戒すべき
なのは『ビッグ・シェル』が爆破される
可能性だ。*/
大佐_014: {
Si cette mar&'ee toxique a lieu,
le port serait d&'etruit
}
//	<<<ENGLISH>>>
//	If that toxic spill does take place,
//	it'll devastate not only the harbor,

/*爆破によって発生する有毒物質が
周辺海域一帯に拡散すれば、湾内だけで
なく沿岸部への影響も計り知れない。*/
大佐_015: {
et la c&^ote empoisonn&'ee pour des
g&'en&'erations et des g&'en&'erations.
}
//	<<<ENGLISH>>>
//	but poison the coastline
//	for generations.

/*環境回復には何世代もかかる。*/
ライデン_016: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
大佐_017: {
Raiden, nous avons &'et&'e contraints
de revoir nos objectifs.
}
//	<<<ENGLISH>>>
//	Raiden, we've had to adjust
//	the mission objectives.

/*ライデン、作戦を変更する。
大統領の救出は後回しだ。*/
大佐_018: {
Notre priorit&'e est dor&'enavant de retirer
les C4 que les terroristes ont fix&'es sur
la Big Shell.
}
//	<<<ENGLISH>>>
//	The priority is now on removing
//	those C4's that the terrorists
//	wired over the Big Shell.

//<ページ数変更>
大佐_018_1: {
Le Pr&'esident attendra,
ce d&'esamor&~qage est urgent.
}
//	<<<ENGLISH(2)>>>
//	The President can wait,
//	but this can't.

/*彼らが『ビッグ・シェル』に仕掛けた
Ｃ４を除去してくれ。一刻も早くな。*/
ライデン_019: {
Colonel, tu sais bien que je ne suis
pas un expert du d&'eminage !
}
//	<<<ENGLISH>>>
//	Colonel, you know I'm no
//	bomb disposal expert.

/*……大佐、俺には爆弾処理の経験はない。*/
大佐_020: {
Pas de probl&`eme -- l'&'equipe Bravo est
venue avec un professionnel des explosifs.
}
//	<<<ENGLISH>>>
//	That's not a problem -- the Bravo
//	team brought an explosives pro in
//	with them.

/*ブラボー・チームと共に爆弾処理の
教官が降下している。*/
大佐_021: {
Le plan de mission de cette unit&'e
pr&'evoit de laisser le d&'emineur en
alerte sur l'Etai C. Il doit y &^etre.
}
//	<<<ENGLISH(2)>>>
//	He was supposed to standby on
//	Strut C according to their mission
//	plan. You should find him there.

/*ＳＥＡＬ１０の
作戦ではＣ脚に残ることになっていた。
まだそこにいるだろう。*/
ライデン_022: {
Tu te fondes encore sur des simulations,
l&`a...?
}
//	<<<ENGLISH>>>
//	Is this according to
//	simulation too...?

/*……これもシミュレーション通りなのか？*/
大佐_023: {
Qu'est-ce que tu dis ?
Cours &`a l'Etai C et trouves-moi ce type !
}
//	<<<ENGLISH>>>
//	What are you talking about?
//	Get to Strut C and find him!

/*何を言っている？
Ｃ脚に向かうんだ。
彼を探せ。*/
ライデン_024: {
D'accord, mais j'ai une derni&`ere question
&`a te poser avant de partir.
}
//	<<<ENGLISH>>>
//	Understood... But I need to ask
//	you something before I go.

/*……了解。
だがその前に、ひとついいか？*/
大佐_025: {
Grouilles-toi, alors !
}
//	<<<ENGLISH>>>
//	Make it quick.

/*なんだ？*/
ライデン_026: {
Qui sont... C'est quoi, la Dead Cell,
je veux dire ?
}
//	<<<ENGLISH>>>
//	Who are they -- Dead Cell, I mean?

/*奴等は、デッドセルは何者なんだ？*/
ライデン_027: {
Ils n'arrivaient pas &`a l'atteindre,
quoi qu'ils fassent...
}
//	<<<ENGLISH>>>
//	They couldn't hit her, no matter
//	how hard they tried...

/*あの女、弾が当たらなかった……。*/
ライデン_028: {
Et ce vampire, hein.
C'est une esp&`ece de --
}
//	<<<ENGLISH>>>
//	And that vampire too.
//	It's -- it's like...

/*さっきの吸血鬼といい……。*/
ライデン_029: {
C'est comme un cauchemar dont
on ne se r&'eveille pas !
}
//	<<<ENGLISH>>>
//	It's like being in a nightmare
//	you can't wake up from.

/*そう、悪夢をみているようだ。*/
ローズ_030: {
Jack, arr&^etes &~qa, tu veux !
}
//	<<<ENGLISH>>>
//	Jack, snap out of it!

/*ジャック、しっかりして！*/
ライデン_031: {
Et toi, Rose -- Je n'arrive pas &`a croire que
tu participes &`a la mission. Je suis entrain
de r&^ever...
}
//	<<<ENGLISH>>>
//	And you Rose -- I can't believe
//	you're on this mission. I keep
//	thinking I'll wake up...

/*ああローズ。君がこのミッションに
参加している事も信じられない。
いつ目が醒めるかと……。*/
大佐_032: {
Raiden, tout &~qa est bien r&'eel.
Crois-moi, tu ne r&^eves pas !
}
//	<<<ENGLISH>>>
//	Raiden, this is real.
//	And that's why you won't
//	wake up.

/*ライデン、これは現実だ。
目が覚める事はない。*/
ライデン_033: {
Mais rien ne semble r&'eel !
}
//	<<<ENGLISH>>>
//	But nothing seems real.

/*あまりにも全てが現実離れしている。*/
ローズ_034: {
J'ai d&'ecid&'e de rester &`a tes c&^ot&'es.
Que ce soit r&'eel ou cauchemardesque,
}
//	<<<ENGLISH>>>
//	I've made up my mind to stay with
//	you. Whether this is real or a bad
//	dream,

/*私は……私は覚悟を決めた。
悪夢でも現実でも、私はあなたを見てる。*/
//<ページ数変更>
ローズ_034_1: {
je veillerai sur toi jusqu'&`a la fin.
}
//	<<<ENGLISH>>>
//	I'll keep watching you,
//	till it's over.

/*最後まで。*/
ライデン_035: {
Merci, Rose. Je ferai en sorte que
tu sois bien plus qu'un r&^eve !
}
//	<<<ENGLISH>>>
//	Thank you, Rose.
//	And I won't let you
//	be just a dream...

/*わかったよ。
君だけは、ローズだけは夢であって
欲しくないものだ。*/
大佐_036: {
Vous avez fini, tous les deux ?
Raiden, il faut que tu ailles sur l'Etai C !
}
//	<<<ENGLISH>>>
//	Are you two done?
//	Raiden, you're needed
//	on Strut C.

/*話はすんだか？
ならばＣ脚へ向かってくれ。*/
}//d



resource P013_01_R01_ライデン危機無線１無線デモ１＿１__f {
//vc111301
ローズ_000: {
Jack ! Tu vas bien !?
}
//	<<<ENGLISH>>>
//	Jack! Are you okay!?

/*ジャック！
無事なの！！！*/
大佐_001: {
Rosemary !
}
//	<<<ENGLISH>>>
//	Rosemary!

/*ローズ君！*/
ローズ_002: {
Jack, promets-moi que tu vas bien !
}
//	<<<ENGLISH>>>
//	Jack, tell me you're okay.

/*ジャック、大丈夫？*/
ライデン_003: {
&~Qa roule !
Mais j'ai eu chaud !
}
//	<<<ENGLISH>>>
//	I'm all right.
//	It was a close one, though.

/*大丈夫だ。
……危なかったが。*/
ローズ_004: {
Ouf...
}
//	<<<ENGLISH>>>
//	Oh good...

/*……よかった。*/
ライデン_005: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
ローズ_006: {
Je n'aurais jamais pens&'e que ce serait
aussi dur !
}
//	<<<ENGLISH>>>
//	I didn't think it would
//	be this tough.

/*私、甘かったわ。*/
ライデン_007: {
Oh, mais...
}
//	<<<ENGLISH(2)>>>
//	Hey...

/*大丈夫か？*/
ローズ_008: {
Le plus dur, c'est d'&^etre totalement
impuissant...
}
//	<<<ENGLISH>>>
//	It's the helplessness of it,
//	you know.

/*辛い……こんなの。*/
ローズ_009: {
De regarder... et de ne rien pouvoir
faire pour t'aider !
}
//	<<<ENGLISH>>>
//	Just watching... with
//	no power to help you.

/*ただ傍観しているだけ。何もできない。*/
//<ページ数変更>
ローズ_009_1: {
C'est comme d'assister &`a un match
de boxe, au premier rang...
}
//	<<<ENGLISH>>>
//	It's like having a ringside
//	seat at a boxing match.

/*まるでボクシングの試合を観てるみたい。*/
ローズ_010: {
Mais en pire...
}
//	<<<ENGLISH>>>
//	But much worse...

/*いいえ、それよりも酷い。*/
ローズ_011: {
Parce qu'il s'agit d'une personne que
j'aime et l'enjeu est --
}
//	<<<ENGLISH>>>
//	Because it's someone I love
//	and the stakes are --

/*自分の大切な人が……。*/
大佐_012: {
Rosemary -- j'ai peut-&^etre fait fausse
route en t'impliquant...
}
//	<<<ENGLISH>>>
//	Rosemary -- maybe this was
//	a miscalculation on my part.

/*ローズ君……
私の間違いだったかもしれん。*/
大佐_013: {
Nous n'aurions peut-&^etre pas d&^u
la s&'electionner.
}
//	<<<ENGLISH>>>
//	Selecting her wasn't
//	the wisest choice.

/*やはり彼女には無理だったようだ。*/
ローズ_014: {
Ce n'est pas vrai !
Pardon de m'&^etre &'enerv&'ee !
}
//	<<<ENGLISH>>>
//	No, no, I apologize
//	for the outburst.

/*いえ、ごめんなさい。*/
ローズ_014_1: {
Tout va bien !
Je te suivrai jusqu'au bout !
}
//	<<<ENGLISH>>>
//	I'm all right.
//	I will see this through
//	with you.

/*私、大丈夫。最後までつき合う。
*/
ライデン_015: {
Rose ?
}
//	<<<ENGLISH(2)>>>
//	Rose?

/*ローズ？*/
ローズ_016: {
On se bat ensemble, hein ?
Tu n'as pas le choix, moi non plus !
}
//	<<<ENGLISH>>>
//	We fight together, ok? You have
//	nowhere to run, neither do I.

/*私も一緒に闘う。
彼も逃げられない。
だから私も逃げない。*/
大佐_017: {
Rosemary, tu n'es pas oblig&'ee
de continuer, tu sais !
}
//	<<<ENGLISH>>>
//	Rosemary, you're not obligated
//	to continue, you know that.

/*ローズ君、無理はせんでもいい。*/
ローズ_018: {
Tout est pour le mieux, Colonel !
}
//	<<<ENGLISH>>>
//	I'm all right, sir.

/*私、できるわ。*/
大佐_019: {
Hum...
}
//	<<<ENGLISH(2)>>>
//	Hmm...

/*うむ……。*/
大佐_020: {
Et toi, Raiden ?
}
//	<<<ENGLISH>>>
//	Raiden, how about you?

/*ライデン、君の方はどうだ？*/
ライデン_021: {
Pas de probl&`eme !
}
//	<<<ENGLISH>>>
//	I'm good.

/*ああ、大丈夫だ。*/
大佐_022: {
Poursuivons la mission, alors !
}
//	<<<ENGLISH>>>
//	Then the mission goes on.

/*よし、ではこのまま続けて貰う。*/
大佐_023: {
Une chose seulement, Rosemary...
}
//	<<<ENGLISH>>>
//	But Rosemary, there's one thing
//	you need to understand.

/*ただし、いいかね。ローズ君？*/
ローズ_024: {
Colonel ?
}
//	<<<ENGLISH>>>
//	Sir?

/*はい？*/
大佐_025: {
Il s'appelle Raiden. C'est clair ?
}
//	<<<ENGLISH>>>
//	His name is Raiden.
//	Got it?

/*彼はライデンだ。わかったか？*/
ローズ_026: {
Oui, Colonel.
C'est compris.
}
//	<<<ENGLISH>>>
//	Yes sir.
//	I understand.

/*え、ええ。
わかってます……。*/
}//d





resource P014_05_R01_ピーター遭遇５無線デモ１＿１__f {
//vc111401
大佐_000: {
Ravi de savoir que
Stillman est sain et sauf.
}
//	<<<ENGLISH>>>
//	Glad to hear Stillman is safe.

/*ライデン、スティルマンが
無事だったのは何よりだ。*/
大佐_001: {
Fais tout ce qu'il faut pour l'aider
&`a retirer les C4 de la structure !
}
//	<<<ENGLISH>>>
//	Assist him in any way possible to
//	clear the C4 from the structure.

/*彼と協力して『ビッグ・シェル』内の
Ｃ４を解除してくれ。*/
ライデン_002: {
Colonel, tu sais bien que je n'ai jamais
&'et&'e form&'e au d&'eminage !
}
//	<<<ENGLISH>>>
//	Colonel, you know I've never
//	been trained in bomb disposal.

/*大佐、俺は爆弾解体の訓練なんて、
受けたことがない。*/
大佐_003: {
Ce n'est pas grave. L'homme avec qui tu
travailles est le meilleur en la mati&`ere.
}
//	<<<ENGLISH>>>
//	It's all right. The man you're
//	working with is the best in the
//	field.

/*大丈夫だ。そこにいる男は爆弾処理の
専門家だ。超一流のな。*/
//<ページ数変更>
大佐_003_1: {
Il te suffit de suivre ses instructions !
}
//	<<<ENGLISH>>>
//	All you have to do is
//	follow his directions.

/*彼の指示に
従ってくれ。*/
大佐_004: {
Evidemment, je te demande de ne
r&'ev&'eler ni ton identit&'e ni les objectifs
de ta mission.
}
//	<<<ENGLISH>>>
//	You will of course keep your
//	identity and mission objectives
//	to yourself.

/*ただし、ライデン。こちら側の素性や
ミッションについてはいっさい話すな。*/
ライデン_005: {
Est-il vrai qu'un ingenieur
accompagenait Stillman ?
}
//	<<<ENGLISH>>>
//	Is it true that an engineer
//	came in with Stillman?

/*スティルマンと一緒に技術者が降下した
という話は本当なのか？*/
大佐_006: {
On ne m'en a rien dit. C'est s&^urement
une d&'ecision de SEAL...
}
//	<<<ENGLISH>>>
//	I wasn't informed of that. It's
//	probably something the SEALs
//	decided on their own.

/*いや、我々も聞いていない。
ＳＥＡＬ１０の独自行動だろう。*/
ライデン_006: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
大佐_007: {
Il y a des probl&`emes plus importants &`a
r&'egler, Raiden. L'ennemi risque de se
venger de son attaque rat&'ee !
}
//	<<<ENGLISH>>>
//	There are more important issues
//	at hand, Raiden. The enemy may
//	retaliate for the failed assault.

/*そんなことより、先ほどの突入に対する、
報復が考えられる。*/
//<ページ数変更>
大佐_007_1: {
Il faut vite neutraliser ces C4 !
}
//	<<<ENGLISH>>>
//	Get those C4's neutralized now.

/*爆弾の除去を急いで
くれ。*/
ライデン_008: {
Colonel, je ne suis pas qualifi&'e
le d&'eminage !
}
//	<<<ENGLISH>>>
//	Colonel, I'm not qualified
//	for bomb disposal.

/*……大佐、爆弾解体など、
俺にはできない。*/
ローズ_009: {
Jack, c'est moi !
}
//	<<<ENGLISH(2)>>>
//	Jack, it's me.

/*ジャック、私……。*/
ライデン_010: {
Rose ?
}
//	<<<ENGLISH(2)>>>
//	Rose?

/*ローズ？*/
ローズ_011: {
Tu r&'eussiras. Fais-moi confiance !
}
//	<<<ENGLISH>>>
//	You can do this.
//	Trust me.

/*大丈夫、あなたならできる。
きっとできる。*/
大佐_012: {
Tu n'as pas re&~qu la formation RV
ad&'equate, mais tu es tout &`a fait
capable de manier les C4.
}
//	<<<ENGLISH>>>
//	You haven't had bomb disposal
//	training per se in VR, but you're
//	more than capable of handling C4.

/*確かに爆弾解体のＶＲ訓練は受けて
いないが、Ｃ４の取扱いは訓練済み
だろう。*/
ライデン_013: {
Oui, mais entre manier et utiliser des C4,
il y a une diff&'erence...
}
//	<<<ENGLISH>>>
//	...This is a little
//	different from using C4.

/*……Ｃ４を仕掛けるのとは訳が違う。*/
ローズ_014: {
Tu en es parfaitement capable !
Et tu le sais !
}
//	<<<ENGLISH>>>
//	You're up for this.
//	You know that.

/*大丈夫。
できるわ、あなたなら……。*/
//口ぱくはいりません。
プリスキン_015: {
Alors, petit ?
Tu les as, tes r&'esultats ?
}
//	<<<ENGLISH>>>
//	How about it, kid?
//	Are the results in yet?

/*どうだ、若いの。結論は出たか？*/
}//d



resource P015_01_R1_爆弾解体最初の一つ１無線デモ１＿１__f {
//vc111501
ピーター_000: {
Ca ne lui ressemble gu&`ere...
}
//	<<<ENGLISH>>>
//	That's not like him...

/*そうか、あいつらしくない……。*/
ライデン_001: {
Il y a un probl&`eme ?
}
//	<<<ENGLISH>>>
//	Anything wrong?

/*何かおかしな点でも？*/
ピーター_002: {
Peut-&^etre. Pliskin m'a indiqu&'e d'autres
sites de bombes, mais aucun n'est situ&'e
&`a un point de d&'emolition strat&'egique.
}
//	<<<ENGLISH>>>
//	Maybe. Pliskin's reported other
//	locations too, and none of them
//	are effective demolition points.

/*ああ、
プリスキンの報告も聞いているが……
どこも効果的な位置ではない。*/
ライデン_003: {
Que veux-tu dire ?
}
//	<<<ENGLISH(2)>>>
//	What do you mean?

/*どういう事だ？*/
ピーター_004: {
Ces sites ne sont pas les emplacements
les plus &`a m&^eme d'assurer la destruction
de cette structure !
}
//	<<<ENGLISH>>>
//	It means that they wouldn't be
//	the best places to choose if you
//	wanted to destroy this place.

/*ここを沈める為の最適な設置場所では
ない。*/
ライデン_005: {
Ils ne proj&`eteraient pas de faire
sauter la Big Shell ?
}
//	<<<ENGLISH>>>
//	Are you saying they don't plan
//	on blowing the Shell up?

/*沈めるつもりはないということか？*/
ピーター_006: {
C'est mon impression ! Jusqu'&`a pr&'esent,
on n'a juste vu un g&^achis de bons
explosifs.
}
//	<<<ENGLISH>>>
//	It certainly seems that way. So far,
//	we haven't seen anything but a waste
//	of good explosives.

/*うむ、明らかに爆薬の無駄遣いだ。*/
//<ページ数変更>
ピーター_006_1: {
A moins qu'on ait manqu&'e quelque chose...
}
//	<<<ENGLISH>>>
//	Unless of course, we're
//	missing something...

/*あるいは、何か見落としているのか……。*/
ライデン_007: {
C'est un pi&`ege ?
}
//	<<<ENGLISH>>>
//	A trap?

/*罠？*/
ピーター_008: {
Il devait bien savoir qu'on allait faire
appel &`a moi pour d&'em&^eler cet &'echeveau.
Ce n'est pas net, tout &~qa !
}
//	<<<ENGLISH>>>
//	He couldn't have overlooked the
//	fact that I would be called into
//	this. There's something going on.

/*あいつは私がでてくる事を予期していた
はず。何かありそうだ。*/
}//d




resource P016_01_R1_爆弾解体半分解体１無線デモ１＿１__f {
//vc111601
ピーター_000: {
Tout est de travers ! Seul un amateur
se comporterait de la sorte.
}
//	<<<ENGLISH>>>
//	This is all wrong.
//	This is something only
//	an amateur would do.

/*おかしい。これじゃまるで、素人だ。*/
ライデン_001: {
Qu'est-ce que tu veux dire par l&`a ?
}
//	<<<ENGLISH(2)>>>
//	What do you mean?

/*どういうことか、話してくれ？*/
ピーター_002: {
Toutes les bombes trouv&'ees jusqu'&`a
pr&'esent ne se trouvent pas aux endroits
ad&'equats.
}
//	<<<ENGLISH>>>
//	All the bombs that have been
//	found so far don't appear to be
//	in the right kind of locations.

/*これまでに設置されていたどのＣ４も
適切な場所とは思えない。*/
//<ページ数変更>
ピーター_002_1: {
Et la quantit&'e d'explosifs
est insuffisante...
}
//	<<<ENGLISH>>>
//	And the quantity of explosives
//	isn't sufficient either.

/*爆薬量も
最適ではない。*/
ライデン_003: {
Fatman n'est pas &`a l'abri
d'une erreur, hein ?
}
//	<<<ENGLISH>>>
//	Even Fatman can make
//	mistakes, right?

/*ファットマンにも間違いはある。*/
ピーター_004: {
No. Il a quelque chose d'autre
l&`a-dessous...
}
//	<<<ENGLISH>>>
//	No. there's something
//	else going on here...

/*いや。何かある……。*/
ピーター_005: {
D&'ep&^eches-toi de d&'esamorcer tes bombes,
Raiden. Je le sens mal, ce coup-l&`a !
}
//	<<<ENGLISH>>>
//	Get a move on with the disposal,
//	Raiden. I've got a bad feeling
//	about this.

/*急いでくれ、ライデン。気になる。*/
ライデン_006: {
Tu crois que c'est un pi&`ege ?
}
//	<<<ENGLISH>>>
//	Do you think it's a trap?

/*囮なのか？*/
ピーター_007: {
Je ne sais pas, mais je vais dire &`a Pliskin
de se m&'efier. D&'ep&^eches-toi, tu veux !
}
//	<<<ENGLISH>>>
//	I don't know, but I'm going to
//	tell Pliskin to watch his back too.
//	Just hurry.

/*わからない。
プリスキンにも用心するよう伝えておく。
頼むぞ。*/
}//d



resource P017_01_R01_爆弾解体中ローズその１無線デモ１＿１__f {
//vc111701
ローズ_000: {
Jack, ce doit &^etre stressant
de d&'esamorcer une bombe...
}
//	<<<ENGLISH>>>
//	Jack -- it must be so nerve-racking
//	to defuse a bomb...

/*ジャック、爆弾解体って……
すごく神経を使うでしょ？*/
ライデン_001: {
Tu l'as dit, oui !
}
//	<<<ENGLISH>>>
//	Yeah, I'd say so.

/*当たり前だ。*/
ローズ_002: {
Bon, je sais, c'est une question stupide.
Je suis d&'esol&'ee !
}
//	<<<ENGLISH>>>
//	OK, that was a stupid thing
//	to say. Sorry.

/*ああ、ごめん。無神経だったわね。*/
ライデン_003: {
T'inqui&`etes pas ! C'est juste
que je n'ai re&~qu aucune 
formation pour &~qa !
}
//	<<<ENGLISH(2)>>>
//	That's all right. It's just that
//	I've never been trained in this
//	stuff.

/*いや……
ただ訓練ではやらなかったからな。*/
ローズ_004: {
Tu vas bien ?
Tu te sens bien ?
}
//	<<<ENGLISH>>>
//	You okay?
//	Are you feeling well?

/*大丈夫？まいってない？*/
ライデン_005: {
J'ai failli vomir plusieurs fois...
}
//	<<<ENGLISH>>>
//	I almost threw up a few times.

/*何度も吐きそうになった。*/
ローズ_006: {
Oh ! Jack...
}
//	<<<ENGLISH(2)>>>
//	Oh Jack...

/*ジャック？*/
ライデン_007: {
Mais je vais bien.
Apr&`es tout, je ne suis pas tout seul.
}
//	<<<ENGLISH>>>
//	But I'm okay.
//	It's not like I'm in this alone.

/*でもまだ大丈夫だ。
ひとりでや
ってる訳じゃない。*/
ローズ_008: {
Ah ! Ben oui, tu as raison !
}
//	<<<ENGLISH>>>
//	Oh -- yeah, that's true.

/*……そ、そうね。*/
ローズ_009: {
A quoi tu penses quand tu
d&'esamorces ces engins ?
}
//	<<<ENGLISH>>>
//	What do you think about when
//	you're defusing those things?

/*解体している時って、
どんな事を考えるの？*/
ライデン_010: {
Ce sont plut&^ot des souvenirs que des
pens&'ees qui me viennent. Je dois r&'esister
&`a la tentation et essayer de ne pas penser.
}
//	<<<ENGLISH>>>
//	I don't think so much as remember.
//	And I know that I need to resist
//	that, and keep my mind blank.

/*いろんな事が思い出される……
でも、それらを押し込める事が
大切なんだ。
無心にならないと……*/
ライデン_011: {
Il ne faut pas c&`eder &`a la peur.
}
//	<<<ENGLISH>>>
//	I can't let myself be overwhelmed
//	by the fear.

/*恐怖に飲まれてはいけないらしい。
*/
ローズ_012: {
Et est-ce que je figure dans
tes souvenirs, moi ?
}
//	<<<ENGLISH>>>
//	So, am I a part of what you
//	try not to remember?

/*私の事なんかも考えるの？*/
ライデン_013: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
ローズ_014: {
Je plaisantais. Mais le moment est
peut-&^etre mal choisi !
}
//	<<<ENGLISH>>>
//	I was just kidding. But I guess
//	this isn't a good time for that.

/*ごめんなさい、こんな時にね。*/
ライデン_015: {
Pas du tout ! Je pense vraiment &`a toi.
J'essaie de me rappeler ce que le 30 avril
a de si sp&'ecial !
}
//	<<<ENGLISH>>>
//	No, it is. And I do think about you.
//	I'm trying to remember what's so
//	special about April 30th.

/*いいんだ。そうだな、
４月３０日が何の日か？
それを考えている。*/
ローズ_016: {
Tu as trouv&'e la r&'eponse ?
}
//	<<<ENGLISH>>>
//	Any success?

/*思い出した？*/
ライデン_017: {
Pas encore !
}
//	<<<ENGLISH>>>
//	No, not yet.

/*いや、まだだ。*/
ローズ_018: {
Restes en vie et tu auras
une chance de le savoir !
}
//	<<<ENGLISH>>>
//	You need to stay
//	alive so you can.

/*思い出すまで、死んじゃダメよ。*/
ライデン_020: {
March&'e conclu !
}
//	<<<ENGLISH>>>
//	Okay, that's a deal.

/*わかった……。*/
}//d



resource P018_01_R01_爆弾解体中ローズその２無線デモ１__f {
//vc111801
ローズ_000: {
H&'e, Jack ? Le d&'esamor&~qage des bombes
ressemble au commencement d'une
histoire d'amour...
}
//	<<<ENGLISH>>>
//	Hey Jack? I bet bomb disposal's
//	a lot like starting a relationship.

/*ジャック、教えて？
爆弾解体って、女の子を口説くような
もの？*/
ライデン_001: {
Hein ?
De quoi parles-tu ?
}
//	<<<ENGLISH>>>
//	Huh?
//	What are you talking about?

/*どういう意味だ？*/
ローズ_002: {
Il faut faire lentement tomber les d&'efenses
&'emotionnelles, rester sur ses gardes...
Tu saisis ?
}
//	<<<ENGLISH>>>
//	Carefully dismantling emotional
//	defenses, being on your toes
//	constantly...you know?

/*壊さないように、慎重に、慎重に……。
心の防御を一枚、一枚、剥がしていく
みたなもんでしょ？*/
ライデン_003: {
Je suppose. Aucune de ces activit&'es
ne me met &`a l'aise...
}
//	<<<ENGLISH>>>
//	I guess. Neither of them
//	are my strong point.

/*そうだな、一理あるかも。
まあ、俺には苦手な分野だ。*/
ローズ_004: {
Il faut dire qu'il y a plus patient
que toi, comme homme !
}
//	<<<ENGLISH>>>
//	It's true that you're not the
//	most patient man in the world.

/*そうね、ジャックはせっかちだから。*/
ライデン_005: {
Ce n'est pas &~qa ! J'aime que
les choses restent en l'&'etat !
}
//	<<<ENGLISH>>>
//	It's not that.
//	I like to leave things
//	as they are.

/*いや、外から眺めている方が好きなんだ。*/
ローズ_006: {
Tu as peur de d&'ecouvrir
leur face cach&'ee ?
}
//	<<<ENGLISH>>>
//	Are you afraid of what
//	might be hidden inside?

/*人の真実に触れるのが怖い？*/
ライデン_007: {
Ce n'est pas de la peur.
Je n'aime pas les complications !
}
//	<<<ENGLISH>>>
//	Not afraid, just -- unwilling...
//	to deal with complications.

/*面倒なんだ。厄介事が。*/
ローズ_008: {
Comme moi, tu veux dire ?
}
//	<<<ENGLISH>>>
//	Like me?

/*私の事も？*/
ライデン_009: {
Tu es -- 
}
//	<<<ENGLISH>>>
//	You're --

/*それは……。*/
ローズ_010: {
H&'e, Jack ?
}
//	<<<ENGLISH(2)>>>
//	Hey Jack?

/*ねえ、ジャック？*/
ライデン_011: {
Ouais ?
}
//	<<<ENGLISH(2)>>>
//	Yeah?

/*ああ？*/
ローズ_012: {
Tu sais pourquoi j'ai accept&'e ce poste ?
}
//	<<<ENGLISH>>>
//	Do you know why
//	I took this job?

/*今回の任務を引き受けたの、
なぜだかわかる？*/
ライデン_013: {
?
}
//	<<<ENGLISH(2)>>>
//	?

/*？*/
ローズ_014: {
Je voulais d&'ecouvrir ta v&'eritable
personnalit&'e !
}
//	<<<ENGLISH>>>
//	I wanted to see what
//	you were really like.

/*あなたの心を覗いてみたかったの。
私のしらない、本当のあなた。*/
ライデン_015: {
On est ensemble depuis longtemps.
Tu me connais d&'ej&`a !
}
//	<<<ENGLISH>>>
//	But we've been together a while.
//	You know me already.

/*いつもそばにいたじゃないか？*/
ローズ_016: {
C'est faux ! Je ne te connais qu'en
surface, je voulais conna&^itre les autres
facettes de ta personnalit&'e.
}
//	<<<ENGLISH>>>
//	No -- you never let me in past a
//	certain point. And I need to know
//	what's there.

/*いいえ、あなたいつも心を閉ざしていた。
それが何か、知りたいの。*/
ライデン_017: {
...Aahh ! Tu m'auscultes &`a 
la loupe, si je comprends
bien !
}
//	<<<ENGLISH>>>
//	...Hahhhh.
//	Are you trying to
//	take me apart now?

/*……ふむ……
これじゃ、こっちが解体されそうだ。*/
ローズ_018: {
T'inqui&`etes !
Ce n'est pas bien important !
}
//	<<<ENGLISH>>>
//	Hey, it's not important.

/*ごめん、冗談よ。*/
ローズ_019: {
Bonne chance, Jack !
}
//	<<<ENGLISH>>>
//	Good luck, Jack.

/*がんばってね、ジャック。*/
}//d



resource P019_01_R01_爆弾解体中ローズその３無線デモ１＿１__f {
//vc111901
ローズ_000: {
Jack, te souviens-tu du jour o&`u nous
nous sommes rencontr&'es ?
}
//	<<<ENGLISH>>>
//	Jack, do you remember
//	the day we met?

/*ジャック、私たちの出逢い、憶えている？*/
ライデン_001: {
Je suis assez occup&'e,
en ce moment, Rose !
}
//	<<<ENGLISH>>>
//	I'm kinda busy right now, Rose.

/*こんな時に、なんだ？
*/
ローズ_002: {
Tu as raison. D&'esol&'ee !
}
//	<<<ENGLISH>>>
//	You're right, sorry.

/*ごめんなさい、そうね……。*/
ライデン_003: {
Je m'en souviens !
}
//	<<<ENGLISH>>>
//	I do remember.

/*ああ……憶えているよ。*/
ライデン_004: {
C'&'etait juste apr&`es
mon transfert &`a New York.
}
//	<<<ENGLISH>>>
//	It was right after I
//	transferred to New York.

/*俺がＮＹに移ってきた直後だった。*/
//<ページ数変更>
ライデン_004_1: {
Tu &'etais assaillie par les touristes,
devant le Federal Hall.
}
//	<<<ENGLISH>>>
//	There were all these tourists
//	around you, in front of the
//	Federal Hall.

/*そう、フェデラルホールの前……
君は観光客の一団に囲まれていた……。*/
ローズ_005: {
Un groupe de japonaises d'&^age
m&^ur m'a demand&'e
}
//	<<<ENGLISH>>>
//	A group of middle-aged Japanese
//	ladies came up and asked me,
//<ページ数変更>
/*質問をされてたの。日本から来た
おばさん達に。*/
ローズ_005_1: {
quel &'etait le b&^atiment qu'avait escalad&'e
King Kong, dans le film o&`u il apparaissait.
}
//	<<<ENGLISH>>>
//	which building it was that King Kong
//	was climbing in the movie.

/*キングコングの登った
ビルはどれか？って。*/
/* テロ事件対応でカット */
/*
ライデン_006: {
You pointed out the
World Trade Center.
}
*/
/*君は世界貿易センタービルを指して
答えた。*/
/* テロ事件対応でカット */
/*
ローズ_007: {
But the ladies
weren't convinced.
}
*/
/*でもおばさんはそのビルを見て
納得しなかった。*/
/* テロ事件対応でカット */
/*
ライデン_008: {
The tourists were talking about
the black and white King Kong.
}
*/
/*おばさんはモノクロのキングコングの
方を観ていたんだ。*/
ローズ_009: {
Je leur ai dit qu'il davait s'agir
du Chrysler Building.
}
//	<<<ENGLISH>>>
//	I said it was probably
//	the Chrysler Building.

/*私はおそらく、クライスラービルだと
言った。*/
/* テロ事件対応でカット */
/*
ライデン_010: {
You hadn't seen the black
and white original.
}
*/
/*そう、君はモノクロ版を観ていなかった。*/
/* テロ事件対応で一部セリフカット */
/*ローズ_011: {
I just vaguely remembered the
pictures. And then you showed up
and started mouthing off.
}
*/
ローズ_011: {
C'est l&`a que tu es entr&'e en sc&`ene
et que tu t'es mis &`a faire l'int&'eressant !
}
//	<<<ENGLISH>>>
//	And then you showed up
//	and started mouthing off.

/*ええ、うろ憶えだった。
そこへあなたが現れて割り込んできた。*/
ローズ_012: {
Tu leur assurait que j'avais tort et qu'il
s'agissait de l'Empire State Building !
}
//	<<<ENGLISH(2)>>>
//	You were like,
//	"No, it's the Empire State."

/*違う。エンパイアステートビルだ。*/
ライデン_013: {
J'ai dit qu'on voyait le Chrysler Building
dans 'Godzilla'.
}
//	<<<ENGLISH>>>
//	I said the Chrysler Building
//	was in Godzilla.

/*クライスラービルが壊れたのはゴジラだ。
といった。*/
ローズ_014: {
Ha ha ha...
}
/*ふふ……。*/
ローズ_015: {
Nous nous sommes disput&'e et j'ai
compl&`etement oubli&'e les touristes !
}
//	<<<ENGLISH>>>
//	We started arguing, and I forgot
//	all about the tourists.

/*私たちはおばさん達、そっちのけで
討論を始めた。*/
ローズ_016: {
Je n'arr&^etais pas de dire que
j'avais raison et toi aussi...
}
//	<<<ENGLISH>>>
//	I was insisting that I was right,
//	and you were doing the same...

/*自分こそが正しいと主張して……。*/
ライデン_017: {
Pour finir par remarquer que les
Japonaises n'&'etaient plus l&`a.
}
//	<<<ENGLISH>>>
//	The next thing we knew,
//	the Japanese women had
//	gone away.

/*気が付くと、観光客はいなくなっていた。*/
ローズ_018: {
Nous avons d&'ecid&'e de nous rendre au
Skyscraper Museum pour voir qui des 
deux avait le plus de m&'emoire.
}
//	<<<ENGLISH>>>
//	And we ended up going to the
//	Skyscraper Museum to see who
//	had the better recall.

/*そこで、お互いの言い分を
立証するために、摩天楼博物館に
向かう事になった。*/
ライデン_019: {
Nous nous sommes disput&'es jusqu'au
Battery Park.
}
//	<<<ENGLISH>>>
//	We argued all the way
//	to Battery Park.

/*そうだ。バッテリーパークまで口論を
続けながら歩いた。*/
ローズ_020: {
En vain !
}
//	<<<ENGLISH>>>
//	And for nothing!

/*でも、結論はでなかった。*/
ライデン_021: {
Puisque le mus&'ee &'etait ferm&'e !
}
//	<<<ENGLISH>>>
//	Since the museum was closed.

/*博物館は休館だったんだ。*/
ライデン_022: {
Apr&`es le mus&'ee nous sommes repartis
chacun de notre c&^ot&'e.
}
//	<<<ENGLISH(2)>>>
//	We went our separate ways
//	from the museum.

/*博物館の前で俺達は別れた。*/
ライデン_023: {
Et puis, je t'ai retrouv&'ee par hasard
dans les couloirs de la base.
}
//	<<<ENGLISH>>>
//	And then I found you again by
//	coincidence out in the base
//	corridor.

/*１週間後、偶然君を基地の廊下で
見つけた。*/
ローズ_024: {
Quelle co&~incidence que nous
travaillions au m&^eme endroit !
}
//	<<<ENGLISH>>>
//	An amazing coincidence -- that we
//	were actually working at the same
//	place.

/*ええ、偶然だった。
同じところで働いたなんてね。*/
ライデン_025: {
Ce soir-l&`a, nous sommes mont&'es jusqu'au
sommet de l'Empire State Building.
}
//	<<<ENGLISH>>>
//	That night, we went up to
//	the top of the Empire State.

/*俺達はその夜、
エンパイアステートビルの屋上へ行った。*/
ローズ_026: {
La vue &'etait magnifique !
}
//	<<<ENGLISH>>>
//	It was so beautiful --

/*綺麗だった。*/
//<ページ数変更>
ローズ_026_1: {
A cent vingt &'etages au-dessus du sol,
on pouvait voir le Chrysler Building.
}
//	<<<ENGLISH>>>
//	I could look down on the Chrysler
//	Building from a hundred and twenty
//	stories above ground.

/*地上１２０階から観る
クライスラービル……。*/
ライデン_027: {
J'&'etais subjugu&'e !
}
//	<<<ENGLISH>>>
//	I felt -- overwhelmed.

/*圧倒された……。*/
ライデン_028: {
Je me moquais de savoir qui de
nous deux avait raison !
}
//	<<<ENGLISH>>>
//	I didn't care anymore
//	who was right.

/*どちらが正しいなんて、もうどうでも
良くなってた。*/
ローズ_029: {
C'&'etait notre premier rendez-vous !
}
//	<<<ENGLISH>>>
//	And that was our first date.

/*あれが私たちの最初のデート。*/
ライデン_030: {
Ce soir-l&`a, nous avons regard&'e 'King Kong'
plusieurs fois, chez toi.
}
//	<<<ENGLISH>>>
//	We watched "King Kong" in your
//	apartment a bunch of times that
//	night.

/*その晩、君の部屋でキングコングの
ビデオを何度も見た。*/
ライデン_031: {
Nous n'avons pas ferm&'e l'&@eil
de la nuit...
}
//	<<<ENGLISH>>>
//	Didn't sleep till morning...

/*朝まで……。*/
ローズ_032: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
ライデン_033: {
Sans cette co&~incidence,
nous ne serions pas ensemble.
}
//	<<<ENGLISH>>>
//	If it weren't for that coincidence,
//	we wouldn't be together.

/*あの偶然がなければ俺達は出会って
いなかった。*/
ローズ_034: {
A qui le dis-tu...
}
//	<<<ENGLISH(2)>>>
//	I know...

/*そうね……。*/
ローズ_035: {
D&'esol&'ee, Jack ! Je t'ai
encore fait perdre ton temps.
}
//	<<<ENGLISH>>>
//	I'm sorry Jack.
//	I'm taking up your time again.

/*ジャック、ごめんなさい。
時間を無駄にしたわね。*/
ライデン_036: {
Quoi ?
}
//	<<<ENGLISH(2)>>>
//	What?

/*え？*/
ローズ_037: {
A la prochaine !
}
//	<<<ENGLISH(2)>>>
//	Take care.

/*それじゃ、がんばって。*/
}//d



resource P020_01_R01_地雷原１無線デモ１＿１__f {
//vc112001
オルガ_000: {
Fais attention !!
Cet endroit est bourr&'e de Claymores !
}
//	<<<ENGLISH(2)>>>
//	Be careful!
//	There are Claymore mines
//	around there.

/*気をつけろ！！*/
/*
オルガ_001: {
There are Claymore mines
around there.
}
*/
/*そこにはクレイモア地雷が
セットされている。*/
ライデン_002: {
Qui est-ce ?
}
//	<<<ENGLISH>>>
//	Who is this!

/*なんだっ！*/
}//d
//無線機のスクリーンにＥＦ連絡橋の映像が映る
resource P020_01_R01_地雷原１無線デモ１＿２__f {
//vc112002
オルガ_000: {
Ces mines Claymore &`a &'equipement furtif
sont invisibles &`a l'&@eil nu.
}
//	<<<ENGLISH>>>
//	Stealth-equipped Claymore mines,
//	invisible to the naked eye.

/*ステルス装備のクレイモアだ。
肉眼では見えない。*/
オルガ_001: {
Sers-toi du d&'etecteur de mines.
}
//	<<<ENGLISH>>>
//	Use the mine detector.

/*地雷探知機を使え！*/
ライデン_002: {
Identifie-toi !
}
//	<<<ENGLISH>>>
//	Identify yourself.

/*誰だ、おまえは？*/
オルガ_003: {
Appelle-moi "Deepthroat"
}
//	<<<ENGLISH(2)>>>
//	Just call me "Deepthroat."

/*ディープ・スロートとでも
名乗っておこう。*/
ライデン_004: {
Deepthroat ? 
Le type de Shadow Moses ?
}
//	<<<ENGLISH>>>
//	Deep Throat?
//	You mean from Shadow Moses?


/*ディープ・スロート？
シャドー・モセス事件の？*/
オルガ_005: {
Dans ce cas, je suis Mr. X.
}
//	<<<ENGLISH>>>
//	Mr. X, then.

/*いや、ミスターＸとでも言っておこう。*/
ライデン_006: {
Mr. X, &`a pr&'esent ?
Et si je t'appelais Deepthroat ?
}
//	<<<ENGLISH>>>
//	Mr. X now, is it? Why would it
//	matter if I called you Deepthroat?

/*ミスターＸ？
どうした？
なぜ言い直す？*/
オルガ_007: {
Ne t'inqui&`ete pas pour mon nom.
}
//	<<<ENGLISH>>>
//	Never mind about that.

/*そんな事はどうでもいい。*/
ライデン_008: {
Pourquoi m'as-tu contact&'e ?
}
//	<<<ENGLISH>>>
//	Why did you contact me?

/*何者だ、なぜ俺に忠告を？*/
オルガ_009: {
Disons que je fais partie
de tes admirateurs !
}
//	<<<ENGLISH>>>
//	Let's just say I'm
//	one of your fans.

/*ファンの一人だよ。*/
}//d
resource P020_01_R01_地雷原１無線デモ１＿３__f {
//vc112003
ライデン_000: {
Colonel, une personne disant s'appeler
Mr. X vient de me contacter. Tu as des
pr&'ecisions &`a ce sujet ?
}
//	<<<ENGLISH>>>
//	Colonel, someone calling himself
//	Mr. X just contacted me. Do you
//	know anything about it?

/*大佐、ミスターＸという人物から
無線連絡が入った。何者だ？*/
大佐_001: {
Non -- et qui que ce soit, sa transmission
n'a pas &'et&'e faite en mode rafale.
}
//	<<<ENGLISH>>>
//	No -- and whoever it was, it
//	wasn't a burst transmission.

/*わからない。バースト通信では
なかったようだ。*/
//<ページ数変更>
大佐_001_1: {
La communication &'emanait
de la Big Shell.
}
//	<<<ENGLISH>>>
//	The transmission was sent
//	from within the Big Shell.

/*『ビッグ・シェル』
内部から発信されている。*/
ライデン_002: {
Au d&'epart, il a pr&'etendu s'appeler
'Deep Throat'. Tu crois que -- ?
}
//	<<<ENGLISH>>>
//	He called himself "Deepthroat"
//	at first. Do you think -- ?

/*やつは最初、ディープ・スロートと
名乗った。まさか……？*/
大佐_003: {
C'est ce que j'ai capt&'e, moi aussi,
mais la probabilit&'e de cette affirmation
est &'egale &`a z&'ero.
}
//	<<<ENGLISH(2)>>>
//	I caught that part too, but the
//	possibility of it being true is
//	none.

/*ああ、私も聞いた。
しかし、それはありえん事だ。*/
大佐_004: {
C'&'etait le pseudonyme de Gray Fox
&`a Shadow Moses, il est mort.
}
//	<<<ENGLISH>>>
//	Gray Fox was the one who used
//	that alias in Shadow Moses, and
//	he's dead.

/*シャドーモセス事件でその名を語った
グレイ・フォックスは既に死んでいる。*/
ライデン_005: {
C'est un pi&`ege de l'ennemi ?
}
//	<<<ENGLISH>>>
//	Is it an enemy trap?

/*敵だと思うか？*/
大佐_006: {
Peut-&^etre. Sais tr&`es prudent !
}
//	<<<ENGLISH>>>
//	Could be.
//	Exercise extreme caution.

/*わからん……注意しろ。*/
}//d

//ここ

resource P021_02_R01_爆弾解体オルガ登場２無線デモ１＿１__f {
//vc112101
ライデン_000: {
J'ai vu une femme-soldat -- russe.
}
//	<<<ENGLISH>>>
//	I saw a female soldier -- Russian.

/*ロシア人の女兵士を見かけた。*/
プリスキン_001: {
Ce doit &^etre Olga Gurlukovich.
}
//	<<<ENGLISH>>>
//	Must be Olga Gurlukovich.

/*ああ、
彼女はオルガ・ゴルルコビッチ……。*/
ライデン_002: {
Comment le sais-tu ?
}
//	<<<ENGLISH>>>
//	How do you know?

/*何故、知ってる？*/
プリスキン_003: {
J'ai &'et&'e brief&'e, moi !
}
//	<<<ENGLISH>>>
//	Unlike you, I've been briefed.

/*お前と違って、ブリーフィングを
受けたからな。*/
ライデン_004: {
Elle ne fait pas partie
de la Dead Cell ?
}
//	<<<ENGLISH>>>
//	She's not a Dead Cell?

/*デッドセルではないのか？*/
プリスキン_005: {
Non, elle dirige
une arm&'ee priv&'ee russe.
}
//	<<<ENGLISH>>>
//	No, she commands
//	a Russian private army.

/*ロシア私兵部隊のリーダーだ。*/
ライデン_006: {
Ce doivent &^etre les membres de cette
arm&'ee qui patrouillent sur la Big Shell !
}
//	<<<ENGLISH>>>
//	They must be the ones
//	patrolling the Big Shell.

/*『ビッグ・シェル』内を巡回している
奴等だな。*/
プリスキン_007: {
Exact ! Elle dirige ce groupe
depuis la mort de son p&`ere,
le Colonel Gurlukovich.
}
//	<<<ENGLISH>>>
//	That's right. She's led the group
//	ever since her old man, Colonel
//	Gurlukovich, died.

/*ああ。親父のゴルルコビッチ大佐が
死んで以来、彼女が部隊を統率している。*/
プリスキン_008: {
M&'efie-toi d'elle. Elle ne fait pas
dans la dentelle !
}
//	<<<ENGLISH>>>
//	Watch yourself with her.
//	She's a tough one.

/*あの女には注意するんだ。
かなりできるぞ。*/
}//d



resource P022_01_R01_爆弾解体最後から二つ目１無線デモ１＿１__f {
//vc112201
ピーター_000: {
Bravo ! Plus qu'une bombe &`a
d&'esamorcer...
}
//	<<<ENGLISH>>>
//	Good work.
//	Only one more left to go...

/*よくやった。残りは後、一つ……。*/
}//d
resource P022_01_R01_爆弾解体最後から二つ目１無線デモ１＿２__f {
//vc112002
プリスキン_001: {
Ici Pliskin.
Tu me re&~qois, Pete ?
}
//	<<<ENGLISH>>>
//	This is Pliskin.
//	Do you read me, Pete?

/*こちらプリスキン、親父さん、
聞こえるか？*/
ピーター_002: {
Oui. Que se passe-t-il ?
}
//	<<<ENGLISH>>>
//	I'm here. What's up?

/*こちら、スティルマン。
どうした？*/
プリスキン_003: {
Raiden, ce message te concerne aussi !
}
//	<<<ENGLISH>>>
//	Raiden, you need
//	to hear this too.

/*ライデンも聞いてくれ。*/
ライデン_004: {
Je t'&'ecoute !
}
//	<<<ENGLISH>>>
//	I'm listening.

/*聞いてる。*/
プリスキン_005: {
J'ai inspect&'e le bas de l'Etai H,
comme tu le souhaitais, Pete.
}
//	<<<ENGLISH>>>
//	I checked out the bottom
//	of Strut H for you, Pete.

/*親父さんに言われて、
Ｈ脚の脚底部を調べてみた。*/
ライデン_006: {
Une minute -- de quoi parles-tu ?
}
//	<<<ENGLISH>>>
//	Wait -- what's this about?

/*何を？*/
ピーター_007: {
J'ai demand&'e &`a Pliskin d'inspecter
les lieux.
}
//	<<<ENGLISH>>>
//	I asked Pliskin
//	to look around.

/*私がプリスキンに頼んだのだ。*/
//<ページ数変更>
ピーター_007_1: {
Connaissant Fatman, je ne pouvais
m'emp&^echer de penser que toutes les
bombes trouv&'ees jusqu'&`a pr&'esent &'etaient
des canulars.
}
//	<<<ENGLISH>>>
//	Knowing Fatman, I can't shake the
//	feeling that all the bombs so far
//	were just wrong.

/*爆薬をセットする位置の選択が、
ファットマンらしくない……。*/
ライデン_008: {
Tu as trouv&'e quelque chose ?
}
//	<<<ENGLISH>>>
//	So did you find anything?

/*それで？*/
プリスキン_009: {
Oui, il y a un tas de C4 dans
le bas de l'Etai. Pete avait raison.
}
//	<<<ENGLISH>>>
//	A hell of a lot of C4's packed
//	into the bottom of the strut.
//	Pete called it right.

/*あんたの言う通り、脚底部にＣ４が
大量にセットされていた。*/
ピーター_010: {
Je savais qu'il avait plus
d'un tour dans son sac...
}
//	<<<ENGLISH>>>
//	I knew he had the real
//	thing up his sleeve...

/*やはりな。
あいつめ……それが本命だ。*/
ライデン_011: {
Toutes les autres bombes &'etaient
des leurres ?
}
//	<<<ENGLISH>>>
//	So all the other ones
//	were dummies?

/*それじゃ、今までのはダミー？*/
ピーター_012: {
Non, elles posent un risque r&'eel,
mais leur d&'etonation ne suffirait
pas &`a d&'etruire toute la Big Shell.
}
//	<<<ENGLISH>>>
//	No, they're a threat all right,
//	but the detonation wouldn't be
//	enough to destroy the entire Shell.

/*いや、どれも脅威である事は
間違いないが、１つの爆発でこの
『ビッグ・シェル』が沈む程ではない。
*/
ピーター_013: {
En revanche, les C4 trouv&'ees par Pliskin
pourraient causer d'importants dommages
structurels.
}
//	<<<ENGLISH>>>
//	But the C4's Pliskin found would
//	inflict serious structural damage.

/*しかし、その脚底部は違う、
かなりのダメージになる。*/
プリスキン_014: {
Il y a plus grave. Ces bombes sont
insensibles au capteur.
}
//	<<<ENGLISH>>>
//	That's not the bad news either.
//	These are sensor-proof.

/*それだけじゃない。
その爆弾はセンサーに反応しない。*/
ピーター_015: {
Quoi ?
}
//	<<<ENGLISH(2)>>>
//	What!

/*なんだと！？*/
プリスキン_016: {
Un mod&`ele r&'ecent, je suppose. Le capteur
&`a ionisation ne les d&'etecte pas.
}
//	<<<ENGLISH>>>
//	New model, I guess.
//	The ionization sensor
//	can't detect them.

/*新型だ。
臭いセンサーではつかめない。*/
プリスキン_017: {
Ces engins sont enti&`erement herm&'etiques,
aucune vapeur ne s'en &'echappe. Aucune
trace d'eau de cologne non plus.
}
//	<<<ENGLISH>>>
//	The whole thing is sealed tight to
//	prevent vapor leak, and there's no
//	trace of that cologne signature.

/*Ｃ４から発生する気化ガスが外に
漏れない様、厳重にシールドしてある。
サインの香水もない……。*/
プリスキン_018: {
Pete, on dirait que ce type t'a bien eu !
}
//	<<<ENGLISH>>>
//	Pete, looks like
//	he fooled you.

/*親父さん、読みは外れたな？*/
ピーター_019: {
Assur&'ement...
}
//	<<<ENGLISH(2)>>>
//	Yes...

/*……うむ……。*/
ライデン_020: {
Et tu as quand m&^eme trouv&'e
ces bombes ?
}
//	<<<ENGLISH>>>
//	But you managed to
//	find the thing anyway?

/*よく見つけたな？*/
プリスキン_021: {
J'ai eu de la chance, c'est tout !
}
//	<<<ENGLISH>>>
//	It was sheer luck.

/*全くの偶然だ。
危ないところだった……。*/
ライデン_022: {
Des bomb invisibles au capteur...
}
//	<<<ENGLISH>>>
//	Bombs that are invisible
//	to the sensor...

/*センサーに反応しない爆弾……。*/
プリスキン_023: {
Des suggestions, Pete ?
}
//	<<<ENGLISH>>>
//	Any ideas, Pete?

/*親父さん、どうしたらいい？*/
ライデン_024: {
Y a-t-il d'autres bombes ?
}
//	<<<ENGLISH>>>
//	Are there more out there?

/*他にもあるんだろうか？*/
ピーター_025: {
Je vais aller voir &~qa par moi-m&^eme.
}
//	<<<ENGLISH>>>
//	I'll go see for myself.

/*……わかった。私が行く。
見てみなければわからん。*/
ライデン_026: {
Tu ne te d&'eplaces pas assez vite.
}
//	<<<ENGLISH>>>
//	You can't move fast enough.

/*その足じゃ無理だ。*/
プリスキン_027: {
Il a raison. Je peux toujours vaporiser
les bombes &`a distance.
}
//	<<<ENGLISH>>>
//	He's right. I can try
//	the spray from a distance.

/*そうだな。
冷却スプレーで試してみよう。*/
ピーター_028: {
Attendez ! Il y a un truc qui cloche
l&`a-dedans, je le sens !
}
//	<<<ENGLISH>>>
//	Hold on!
//	There's something not right
//	about this one, I can feel it.

/*待てっ！こいつには何かある！！*/
プリスキン_029: {
Alors, Pete ?
Tu veux que je vienne te chercher ?
}
//	<<<ENGLISH>>>
//	Well, Pete?
//	Should I come back and get you?

/*どうする？
親父さん、迎えに行ってやろうか？*/
ピーター_030: {
Inutile. Raiden, il te reste une bombe
&`a d&'esamorcer, pas vrai ?
}
//	<<<ENGLISH>>>
//	No, there's no need.
//	Raiden, you have one
//	left to go, correct?

/*いや、大丈夫だ。
ライデンは後、一つだったな？*/
ライデン_031: {
Exact -- sans compter les bombes
inodores !
}
//	<<<ENGLISH>>>
//	Right -- except for
//	those scentless ones.

/*そうだ。ただし、『臭いのあるＣ４』は、
という意味だが。*/
ピーター_032: {
Et toi, Pliskin ?
}
//	<<<ENGLISH>>>
//	How about you, Pliskin?

/*プリスキンは？*/
プリスキン_033: {
Il m'en reste deux, en plus de celle-ci.
}
//	<<<ENGLISH>>>
//	I have two left not
//	counting this one.

/*俺はこいつを除いても後、２つ……。*/
ピーター_034: {
Bien... Il va falloir que j'intervienne. 
Gr&^ace &`a ma carte de niveau 4, je peux 
entrer dans la Shell 2.
}
//	<<<ENGLISH(2)>>>
//	OK... It'll have to be me. I have
//	the level 4 card that'll get me
//	into Shell 2 in any case.

/*うむ……やはり、私が行く。
シェル２へ行けるカード４も持っている。*/
ライデン_035: {
Tu ne r&'eussiras jamais ! Vu l'&'etat
de ta jambe, tu vas te faire rep&'erer !
}
//	<<<ENGLISH>>>
//	You'll never make it. With that
//	bad leg of yours, they'll spot
//	you for sure.

/*無理だ。
その脚では途中で敵に見つかる……。*/
ピーター_036: {
Non ! Je --
}
//	<<<ENGLISH>>>
//	That won't happen.
//	I...

/*その心配はいらん。
実は……。*/
ピーター_037: {
Je peux marcher normalement.
}
//	<<<ENGLISH>>>
//	I can walk just fine.

/*私は歩けるのだ。*/
ピーター_038: {
Je peux m&^eme courir...
}
//	<<<ENGLISH>>>
//	I can even run...

/*そればかりか、走ることもできる……。*/
プリスキン_039: {
Que veux-tu dire ?
}
//	<<<ENGLISH(2)>>>
//	What do you mean?

/*どういう事だ……。*/
ピーター_040: {
Cette bombe d'il y a cinq ans... J'ai foir&'e !
Malgr&'e toute mon exp&'erience, j'ai fait
fausse route.
}
//	<<<ENGLISH>>>
//	That bomb, five years ago.
//	I messed up. Even with all
//	my experience, I lost it.

/*５年前の事だ。
年甲斐もなく、びびってしまった。*/
ピーター_041: {
Et l'explosion a d&'etruit une &'eglise...
Et tous les gosses qui jouaient &`a c&^ot&'e...
}
//	<<<ENGLISH>>>
//	And a church was lost in the
//	explosion. All those kids
//	playing nearby too...

/*おかげで教会が爆発した。
近隣の子供たちも巻き添えを食った。*/
//<ページ数変更>
ピーター_041_1: {
Ces cinq derni&`eres ann&'ees,
j'ai v&'ecu dans le mensonge.
}
//	<<<ENGLISH>>>
//	These past five years,
//	I've lived a lie.

/*この５年間、私は嘘をついてきた……。*/
ライデン_042: {
Dans le mensonge ?
}
//	<<<ENGLISH>>>
//	Lied?

/*嘘？*/
ピーター_043: {
Je n'ai pas perdu ma jambe
dans l'explosion !
}
//	<<<ENGLISH>>>
//	Yes, lied. I didn't lose
//	my leg in the explosion.

/*そうだ。
私は右足を失ってなどおらん。*/
プリスキン_044: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
ピーター_045: {
Tant de personnes sont mortes,
&`a cause de moi !
}
//	<<<ENGLISH>>>
//	So many dead -- all
//	because of my mistake.

/*私の失敗で……
あまりにも多くの犠牲が出た。*/
ピーター_046: {
Je n'ai pens&'e qu'&`a me cacher de ce crime,
pour &'echapper &`a la vindicte populaire.
}
//	<<<ENGLISH>>>
//	All I could think about was hiding
//	from the crime, shielding myself
//	from the public outcry.

/*私は……
あろう事か、世間の同情を買おうとした。
*/
ピーター_047: {
Je voulais que les gens me plaignent et
aient piti&'e de mes faiblesses...
}
//	<<<ENGLISH>>>
//	I wanted people to be sorry
//	for me, for my weakness...

/*攻撃の目をそらそうとした。
非難を逃れようとした。*/
ライデン_048: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
ピーター_049: {
J'ai fait semblant d'&^etre une victime car
je &'etais incapable d'affronter les familles
des vraies victimes !
}
//	<<<ENGLISH>>>
//	I faked being a victim myself
//	because I couldn't bear to face
//	the families of the real victims.

/*周りの視線から逃れるために、
仮病を使ったのだ。*/
ピーター_050: {
Je ne porte pas de proth&`ese. Je suis
parfaitement capable de franchir les
passerelles et de faire des randonn&'ees
dans le d&'esert.
}
//	<<<ENGLISH>>>
//	This is no prosthetic. I can
//	keep my footing on catwalks
//	and hike over deserts.

/*私の脚は義足ではない。
歩くことも、走ることもできる。*/
ピーター_051: {
J'ai tellement cru &`a mon mensonge que
je n'ai pas pu me purger de mes p&'ech&'es...
}
//	<<<ENGLISH>>>
//	I lived my lie so well I
//	haven't even answered to
//	myself for my sins...

/*私は嘘をつくことで、
自分の罪から逃れてきた。*/
ピーター_052: {
Ce mensonge &'etait cens&'e me
servir de bouclier...
}
//	<<<ENGLISH>>>
//	It was supposed to be a shield.

/*世間への嘘だったはずが……。*/
ピーター_053: {
Mais il s'est transform&'e en linceul !
}
//	<<<ENGLISH>>>
//	And it's become a shroud instead.

/*時を経る毎に己への嘘となっていった。*/
ピーター_054: {
En jouant les victimes,
j'ai tu&'e mon &^ame...
}
//	<<<ENGLISH>>>
//	I've killed my soul by
//	playing the victim.

/*自ら被害者を演じることで、世間を、
いや自分を騙してきた。*/
ピーター_055: {
Au lieu de me prot&'eger, ce mensonge a
fait de ma vie un enfer.
}
//	<<<ENGLISH>>>
//	Instead of protecting me,
//	it's made my life even more
//	hellish.

/*身を守るはずの嘘が、やがて自分への
重圧へと変わっていった。*/
プリスキン_056: {
Qu'est-ce que &~qa peut bien apporter
aux victimes, hein ?
}
//	<<<ENGLISH>>>
//	What good can that
//	do the victims?

/*そんな事で犠牲者が浮かばれるとでも？*/
ピーター_057: {
Je sais -- je suis un l&^ache !
}
//	<<<ENGLISH>>>
//	I know -- I'm a coward!

/*そうだ、私は卑怯者だ！*/
プリスキン_058: {
H&'e, Pete...
}
//	<<<ENGLISH>>>
//	Hey, Pete...

/*親父さん……。*/
ピーター_059: {
Que Dieu me pardonne...
}
//	<<<ENGLISH>>>
//	God forgive me...

/*許してくれ！*/
ピーター_060: {
Je peux parfaitement me servir
de mes deux pieds !
}
//	<<<ENGLISH>>>
//	I can walk with my own two feet.

/*若者たちよ。
いいか、私は歩ける。*/
ピーター_061: {
Et je vais en avoir besoin pour arr&^eter
Fatman. Ses crimes sont les miens et
puent l'omission et l'arrogance.
}
//	<<<ENGLISH>>>
//	And I need them to stop Fatman.
//	His crimes are also mine -- one
//	of omission, and arrogance.

/*ファットマンは私が止めねばならん。
あいつの暴走も私の責任……私の罪だ。*/
ピーター_062: {
Pour enseigner ce genre de technique,
il faut avoir une conscience parfaitement
pure.
}
//	<<<ENGLISH>>>
//	No one should teach the skills
//	I taught him without a clear
//	conscience.

/*自分を欺き、大切なものを何も
伝えられなかった、私の……。*/
ピーター_063: {
Il n'y a que comme &~qa que je pourrai
me purger de mes fautes.
}
//	<<<ENGLISH>>>
//	This is the only way
//	I can defuse my own sins.

/*これから自分の罪を解体しにいく！*/
プリスキン_064: {
C'est compris, Pete.
Cette bombe est &`a toi.
Pig&'e, Raiden ?
}
//	<<<ENGLISH>>>
//	I get you, Pete.
//	That one's all yours.
//	You got it, Raiden?

/*わかった、親父さん。任せる。
……ライデンもいいな。*/
ライデン_065: {
Oui, je comprends.
}
//	<<<ENGLISH(2)>>>
//	I understand.

/*ああ……。*/
プリスキン_066: {
Pete, j'ai r&'egl&'e leur compte aux gardes
des Etais G et H de la Shell 2.
}
//	<<<ENGLISH>>>
//	Pete, I've taken care of
//	guards in Struts G and H
//	of Shell 2.

/*親父さん、シェル２のＧ脚とＨ脚の
敵兵は排除した。*/
//<ページ数変更>
プリスキン_066_1: {
Je te d&'econseiller de te rendre
dans les autres &'etais.
}
//	<<<ENGLISH>>>
//	I wouldn't recommend you go
//	into any of the other struts.

/*他の脚へは出入り
するなよ。*/
ピーター_067: {
Je te dois une fi&`ere chandelle !
}
//	<<<ENGLISH(2)>>>
//	I owe you one.

/*すまんな。*/
プリスキン_068: {
Bon, je vais continuer &`a bloquer
les petites bombes...
}
//	<<<ENGLISH>>>
//	I'll get back to freezing
//	the baby bombs then.

/*それじゃ、俺は爆弾解体を続ける。*/
ピーター_069: {
Fais la m&^eme chose, Raiden !
}
//	<<<ENGLISH>>>
//	You do that too, Raiden.

/*ライデンも解体に戻ってくれ。*/
ライデン_070: {
Je m'en charge !
}
//	<<<ENGLISH(2)>>>
//	I'm on it.

/*わかった。*/
ピーター_071: {
Je prends ma radio avec moi, au cas
o&`u vous souhaitiez me contacter.
}
//	<<<ENGLISH(2)>>>
//	I'll have the radio with me,
//	if you need to get in touch.

/*無線機を持っていく。
何かあれば連絡をくれ。*/
ピーター_072: {
Plus la peine d'appeler 'Peter jambe
de bois', il n'existe plus !
}
//	<<<ENGLISH(2)>>>
//	Just don't ask for "Peg-Legged
//	Peter." He's gone for good.

/*『義足のピーター』のニックネームも
今日で終わりだ。*/
}//d


resource P023_01_R01_爆弾解体最後の一つ１無線デモ１＿１__f {
//vc112301
ライデン_000: {
J'ai neutialis&'e la derni&`ere bombe.
Je ne vois plus rien sur le capteur,
&`a pr&'esent !
}
//	<<<ENGLISH>>>
//	I have the last C4 frozen.
//	There's nothing showing
//	up on the sensor now.

/*最後のＣ４を解体した。
センサーに映るものは、もうない。*/
ピーター_001: {
Bien jou&'e, Raiden !
}
//	<<<ENGLISH(2)>>>
//	Good work, Raiden.

/*よし。
よくやった、ライデン。*/
プリスキン_002: {
Tu es en avance sur moi, mon petit !
Il m'en reste encore une.
}
//	<<<ENGLISH>>>
//	You're way ahead of me, kid.
//	I still have one to go.

/*先を越されたな。
俺の方はまだ１つ残っている。*/
ライデン_003: {
Comment est ta bombe, Peter ?
}
//	<<<ENGLISH>>>
//	How's your bomb, Peter?

/*スティルマンの方は？*/
ピーター_004: {
Elle est costaud ! Il y a un gros
paquet de C4 herm&'etiques...
}
//	<<<ENGLISH>>>
//	It's a bomb all right.
//	Sealed C4, and in huge
//	quantities...

/*間違いない。無臭のＣ４だ。
しかも、凄い量だ……。*/
ライデン_005: {
Tu crois qu'il y en a une autre
sur la Shell 1 ?
}
//	<<<ENGLISH>>>
//	You think there's
//	another one in Shell 1?

/*シェル１にもあると思うか？*/
ピーター_006: {
A tous les coups !
Dans le bas de l'Etai A.
}
//	<<<ENGLISH>>>
//	For sure. Somewhere at
//	the bottom of Strut A.

/*ある。
おそらく、Ａ脚底部のどこか。*/
ライデン_007: {
Comment peux-tu en &^etre aussi s&^ur ?
}
//	<<<ENGLISH>>>
//	Why are you so certain?

/*確かか？*/
ピーター_008: {
Si la partie basse de l'&'etai est d&'etruite,
la Shell 2 a de fortes chances d'&^etre
d&'etruite.
}
//	<<<ENGLISH>>>
//	If this bottom section of the strut
//	is demolished, Shell 2 will be well
//	on its way to destruction.

/*この脚底部を破壊すると、
シェル２はほぼ壊滅する。*/
プリスキン_009: {
Tu veux dire que la Shell 2 va couler ?
}
//	<<<ENGLISH>>>
//	You mean that Shell 2
//	will actually sink?

/*シェル２が沈むという事か？*/
ピーター_010: {
Pas imm&'ediatement.
Il reste encore cinq &'etais.
}
//	<<<ENGLISH>>>
//	Not immediately. There'll
//	still be five struts left.

/*いや、すぐには沈まん。
この脚が破壊されてもまだ５脚
残っている。*/
/* 以下は無しだったのでは？？？
プリスキン_011: {
どうなる？
}
ピーター_012: {
まず中心部が浸水する……。
}
*/
ピーター_013: {
Mais si la Shell 1 perd simultan&'ement
un &'etai, l'effet sera tout &`a fait diff&'erent.
}
//	<<<ENGLISH>>>
//	But, if Shell 1 loses a strut at
//	the same time, it'll be a very
//	different story.

/*ただし、シェル１も同時に爆発すれば
そうはいかない。*/
ピーター_014: {
L'int&'egrit&'e structurelle de la Big Shell
repose sur un &'equilibre tr&`es pr&'ecis.
}
//	<<<ENGLISH>>>
//	The Big Shell's structural
//	integrity depends on a very
//	exact balance.

/*『ビッグ・シェル』は微妙な均衡で
姿勢を保っている。*/
ピーター_015: {
Si les deux Shells perdent un &'etai
chacune, l'ensemble de la structure
s'effondrera sous son propre poids.
}
//	<<<ENGLISH>>>
//	If both Shells lose a strut each,
//	the whole structure will tear
//	itself apart under its own weight.

/*シェル１も爆破されれば自重を
支え切れなくなり……自壊する。*/
ライデン_016: {
Qu, allons-nous faire ?
}
//	<<<ENGLISH>>>
//	What do we do?

/*どうすればいい？*/
ピーター_017: {
J'ai un capteur &`a m&^eme
de localiser les C4 inodores.
}
//	<<<ENGLISH>>>
//	I have a sensor that can locate
//	even those scentless C4's.

/*無臭のＣ４も探知できるセンサーがある。*/
//<ページ数変更>
ピーター_017_1: {
Il est dot&'e d'un scintillateur &`a neutrons
et d'un d&'etecteur de bombes &`a hydrog&`ene.
}
//	<<<ENGLISH>>>
//	It makes combined use of a neutron
//	scintillator and a hydrogen bomb
//	detector.

/*中性子後方散乱装置と水素爆発物探知機
を併用したものだ。
*/
}//d

resource P023_01_R01_爆弾解体最後の一つ１無線デモ１＿センサーＢなし__f {
ライデン_000: {
Tu as apport&'e &~qa avec toi ?
}
//	<<<ENGLISH>>>
//	You brought that stuff with you?

/*そんなものを持って来てたのか？*/
ピーター_001: {
Evidemment ! J'ai effectu&'e les calibrations
quand j'&'etais, dans le garde-manger.
}
//	<<<ENGLISH>>>
//	Of course. I made the
//	calibrations while
//	I was in the pantry.

/*ああ……。
貯蔵庫の中で調整しておいた。*/
}//d

resource P023_01_R01_爆弾解体最後の一つ１無線デモ１＿２__f {
ライデン_000: {
&~Qa marche ?
}
//	<<<ENGLISH>>>
//	Does it work?

/*使えるのか？*/
ピーター_001: {
Je viens de tester l'engin et
il &'emet des r&'eactions.
}
//	<<<ENGLISH>>>
//	I just tested it, and
//	it definitely responds.

/*ここで試した。確かに反応する。*/
//<ページ数変更>
ピーター_001_1: {
J'obtiens au mieux une balise sonore
et aucun signal radar.
}
//	<<<ENGLISH>>>
//	But the best I can do is a
//	sound beacon, not the radar.

/*ただし、レーダー・スクリーンではなく、
音で知らせる仕組みだ。
*/
ライデン_002: {
Une balise sonore ?
}
//	<<<ENGLISH>>>
//	Sound?

/*音？*/
ピーター_003: {
Plus l'intervalle entre les balises est court,
plus la cible est proche.
}
//	<<<ENGLISH>>>
//	The shorter the interval between
//	beacons, the closer the target.

/*音の間隔だ。
短くなる程接近していることを意味する。*/
ライデン_004: {
Je vois !
}
//	<<<ENGLISH(2)>>>
//	I get you.

/*わかった。*/
ピーター_005: {
Il y en a un autre dans le garde-manger
o&`u j'&'etais auparavant. Tu peux aller
le chercher.
}
//	<<<ENGLISH>>>
//	There's another one in that
//	pantry I was in. You can go
//	back and get it.

/*私のいた貯蔵庫にもう一式ある。
取りに行ってくれ。*/
プリスキン_006: {
Je te le laisse, Raiden.
}
//	<<<ENGLISH>>>
//	It's all yours, Raiden.

/*ライデン、そっちは頼んだぞ。*/
ピーター_007: {
Je vais l'&'etudier encore un peu pour voir si
le processus d'immobilisation fonctionne.
}
//	<<<ENGLISH>>>
//	I'm going to study it some more,
//	and see if the freezing process
//	will work.

/*もう少し、調べて、冷却できるかどうか
試してみる。*/
//<ページ数変更>
ピーター_007_1: {
Ne touche pas &`a l'autre engin
avant mon signal.
}
//	<<<ENGLISH>>>
//	Don't touch the other
//	one until I say so.

/*それまでは手を出すな。*/
ライデン_008: {
D'accord. J'attends ton appel.
}
//	<<<ENGLISH>>>
//	OK. I'll standby
//	until you radio in.

/*わかった。連絡を待つ。*/
}//d



resource P024_01_R01_爆弾解体センサーＢ入手１無線デモ１＿１__f {
//vc112401
ライデン_000: {
Peter, j'ai le Capteur B.
}
//	<<<ENGLISH>>>
//	Peter, I have Sensor B.

/*スティルマン、センサーＢを入手した。*/
ピーター_001: {
Bien. Va sur l'Etai A.
}
//	<<<ENGLISH>>>
//	Good.
//	Head to the bottom of Strut A.

/*そうか、Ａ脚底部に向かってくれ。*/
}//d

resource P024_01_R01_爆弾解体センサーＢ入手１無線デモ１＿１Ａ__f {
ライデン_002: {
Comment va ta bombe invisible ?
}
//	<<<ENGLISH>>>
//	How's your invisible bomb?

/*無臭爆弾はどうなった。*/
ピーター_003: {
Je l'examine en gardant mes distances.
Comment va Pliskin ?
}
//	<<<ENGLISH>>>
//	I'm looking at it, but I'm keeping
//	my distance. How's Pliskin doing?

/*目の前にあるが、まだ近づいてはいない。
プリスキンの方はどうだ？*/
プリスキン_004: {
Encore quelques minutes...
}
//	<<<ENGLISH>>>
//	A few more minutes...

/*もう少し待ってくれ。*/
//<ページ数変更>
プリスキン_004_1: {
Je viens d'arriver sur le dernier &'etai,
mais il faut que je m'occupe de
plusieurs sentinelles ennemies.
}
//	<<<ENGLISH>>>
//	I just got to the last strut, but
//	there are a few enemy sentries
//	I have to take care of.

/*今最後の脚に到着した。
敵兵が邪魔だ。先に排除する……。*/
ライデン_005: {
Tu as des probl&`emes, Peter ?
}
//	<<<ENGLISH>>>
//	Does it look bad, Peter?

/*……スティルマン、厄介そうなのか？*/
ピーター_006: {
Peut-&^etre. C'est une bombe bizarre.
Son d&'etonateur n'a pas &'et&'e activ&'e.
}
//	<<<ENGLISH>>>
//	Maybe. It's an odd one --
//	the detonator hasn't been
//	activated.

/*ああ。少し妙だ。
起爆装置が作動していない。*/
ライデン_007: {
Quoi ?
}
//	<<<ENGLISH(2)>>>
//	What?

/*なに？*/
ピーター_008: {
Mais les capteurs fonctionnent... 
Ce qui signifie...
}
//	<<<ENGLISH>>>
//	But the sensors are live...
//	Which means...

/*だがセンサーは生きている……
これは……。*/
プリスキン_009: {
Ici Pliskin.
J'ai rep&'er&'e la derni&`ere C4.
}
//	<<<ENGLISH>>>
//	This is Pliskin.
//	I've located the last C4.

/*こちらプリスキン。
最後のＣ４を発見した。*/
ピーター_010: {
C'est donc &~qa !?
}
//	<<<ENGLISH>>>
//	Is that it!?

/*まさか！？*/
プリスキン_011: {
Je vais la neutraliser.
Et ensuite --
}
//	<<<ENGLISH>>>
//	I'm about to freeze it.
//	Then --

/*今から凍結する。これで……。*/
ピーター_012: {
Attends ! Pliskin !
}
//	<<<ENGLISH>>>
//	Wait! Pliskin!

/*プリスキン、待て！！*/
}//d

resource P024_01_R01_爆弾解体センサーＢ入手１無線デモ１＿２__f {
//vc112406
ピーター_000: {
Mince ! C'&'etait donc &~qa !
}
//	<<<ENGLISH>>>
//	Damn! That WAS it!

/*くっ！やはり！！*/
プリスキン_001: {
Que se passe-t-il !?
}
//	<<<ENGLISH(2)>>>
//	What's going on!?

/*どうした！？*/
ピーター_002: {
Le d&'etonateur s'est activ&'e.
Le compte &`a rebours a commenc&'e !
}
//	<<<ENGLISH>>>
//	The detonator just woke up.
//	It's counting down!

/*起爆装置が動き出した！
カウントダウンしている！*/
ライデン_003: {
Que s'est-il pass&'e !?
}
//	<<<ENGLISH>>>
//	What happened!?

/*どういうことだ！？*/
ピーター_004: {
Les grosses bombes ont &'et&'e manipul&'ees
de mani&`ere &`a exploser juste apr&`es la
d&'esactivation des petites C4...
}
//	<<<ENGLISH>>>
//	The big ones were rigged to be
//	activated when all the baby C4's
//	went offline...

/*通常のＣ４爆弾の信号が全て消えたら、
こちらの爆弾が起動する仕掛けになって
いたんだ……。*/
ピーター_005: {
Raiden, la bombe de la Shell 1 doit aussi
avoir commenc&'e son compte &`a rebours.
Faisvite !
}
//	<<<ENGLISH>>>
//	Raiden, the one in Shell 1
//	should be counting down too.
//	Hurry!

/*ライデン、シェル１の爆弾も起動して
いるはずだ！間違いない！急いでくれ！！*/
ライデン_006: {
Combien de temps reste-t-il ?
}
//	<<<ENGLISH>>>
//	What's the remaining time!?

/*残りカウントは！？*/
}//d
