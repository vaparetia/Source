resource P030_01_R01_フォーチュン戦中無線無線デモ１＿カウント後__f {
//vc113006
ライデン_000: {
Il a vraiment l'intention de bousiller
cette structure, alors !
}
//	<<<ENGLISH>>>
//	So he's planning on
//	taking this place out.

/*ここを破壊する気だな。*/
大佐_001: {
On dirait qu'il ne poursuit pas les m&^emes
objectifs que la Dead Cell.
}
//	<<<ENGLISH>>>
//	It looks like he has a different
//	agenda from that of Dead Cell.

/*デッドセルの目的と奴の目的は
既に違うようだ。*/
ライデン_002: {
Et qu'en est-il des renforts ?
}
//	<<<ENGLISH>>>
//	What about backup?

/*応援は？*/
大佐_003: {
Il n'y en a pas. On n'a pas le temps.
}
//	<<<ENGLISH>>>
//	None. There's no time.

/*ダメだ。
今からでは時間がない。*/
ライデン_004: {
Quels types d'explosifs utilise-t-il ?
}
//	<<<ENGLISH>>>
//	Which type of explosives is it?

/*爆弾はどっちのタイプだ？*/
大佐_005: {
Il n'en a pas parl&'e.
}
//	<<<ENGLISH>>>
//	He didn't say.

/*そこまでのヒントはもらえなかった。*/
}//d




resource P035_01_R01_ファットマン爆弾解体終了１無線デモ１＿１__f {
//vc113501
大佐_000: {
Bien jou&'e, Raiden ! Toutes les bombes
semblent &^etre neutralis&'ees.
}
//	<<<ENGLISH>>>
//	Good work, Raiden. Looks like
//	all the bombs are neutralized.

/*ライデン、よくやった。爆弾は全て除去
できたようだな。*/
//<ページ数変更>
大佐_000_1: {
Ils ont perdu un de leurs meilleurs atouts.
Il ne reste plus --
}
//	<<<ENGLISH>>>
//	One of their main leverages
//	is now gone. That leaves --

/*これで奴等の脅しは
一つ無効になった。あとは……。*/
ライデン_001: {
Colonel, Fatman n'avait pas
l'air d'&^etre au courant de
la demande de ran&~qon !
}
//	<<<ENGLISH>>>
//	Colonel, Fatman didn't seem to
//	know about the ransom demands.

/*大佐、ファットマンは要求のことを
知らなかったようだが……？*/
大佐_002: {
On l'a intentionnellement laiss&'e
&`a l'&'ecart de tout &~qa.
}
//	<<<ENGLISH>>>
//	Intentionally kept
//	in the dark, I'd say.

/*知らされていなかっただけではないのか？
*/
//<ページ数変更>
大佐_002_1: {
Il semblait tr&`es diff&'erent
des autres terroristes.
}
//	<<<ENGLISH>>>
//	He seemed to be coming from a
//	very different place from the
//	other terrorists.

/*彼は他のテロリスト達とは違う目的で
動いていたようだ。*/
ライデン_003: {
...
}
//	<<<ENGLISH(2)>>>
//	...

// どっかから「しかし」を持ってくる。
/*しかし……。*/
大佐_004: {
Raiden, nombre d'otages, dont notre
Pr&'esident, sont toujours en danger.
}
//	<<<ENGLISH>>>
//	Raiden, a lot of hostages --
//	our President included --
//	are still in danger.

/*ライデン、まだ大統領をはじめ、多くの
人質がいる。*/
//<ページ数変更>
大佐_004_1: {
Veille &`a les prot&'eger.
}
//	<<<ENGLISH>>>
//	Keep your mind focused
//	on protecting them.

/*彼らの命がいまだ危険に
さらされているのを忘れるな。*/
ライデン_005: {
... Quels sont mes ordres ?
}
//	<<<ENGLISH(2)>>>
//	What are my orders?

/*……次の指示は？*/
大佐_006: {
Tu dois sauver le Pr&'esident.
}
//	<<<ENGLISH(2)>>>
//	Rescue the President.

/*大統領を救出するんだ。*/
ライデン_007: {
Je ne sais pas du tout o&`u il se trouve.
}
//	<<<ENGLISH>>>
//	We have no idea where he is.

/*手がかりがない……。*/
大佐_008: {
Commente par aller faire
un tour au noyau central...
}
//	<<<ENGLISH>>>
//	You haven't been in the central
//	core yet. I suggest you start
//	there...

/*中央棟はまだ調べていないだろう？
そちらを……。*/
ライデン_009: {
Attends, j'ai un autre appel.
Tu veux que je le prenne ?
}
//	<<<ENGLISH>>>
//	Wait, I have another call.
//	Want me to take it?

/*待ってくれ、＃｛ＣＡＬＬ、コール｝＃が入った。
つないでいいか？*/
大佐_010: {
Non, me d&'econnecte.
Il vaut mieux qu'on reste incognito.
}
//	<<<ENGLISH>>>
//	No, I'll go offline. Best to
//	keep our presence unknown.

/*いや、待て！
こちらの存在を知られてはまずい。
切るぞ。*/
}//d
resource P035_01_R01_ファットマン爆弾解体終了１無線デモ１＿２__f {
//vc113502
プリスキン_000: {
Comment tu vas, petit ?
}
//	<<<ENGLISH>>>
//	How're you doing, kid?

/*若いの、大丈夫か？*/
ライデン_001: {
Pliskin ? Tu vas bien ?
}
//	<<<ENGLISH>>>
//	Pliskin!? Is everything all right?





/*プリスキン！？
無事だったのか？*/
プリスキン_002: {
Je pourrais aller mieux.
J'ai pass&'e un sale quart d'heure.
}
//	<<<ENGLISH>>>
//	Could be better.
//	Looks like I was out
//	cold for a while.

/*なんとかな……
しばらく気を失っていたらしい。*/
ライデン_003: {
Comment as-tu fait pour rester en vie ?
}
//	<<<ENGLISH>>>
//	How did you manage
//	to stay alive?

/*よく生きてたな。*/
プリスキン_004: {
Je me suis fait aider par un ami !
}
//	<<<ENGLISH>>>
//	Had a little help
//	from a friend.

/*仲間に助けられた。*/
ライデン_005: {
Un ami ?
}
//	<<<ENGLISH>>>
//	Friend?

/*仲間？*/
プリスキン_006: {
Et la bombe ?
}
//	<<<ENGLISH>>>
//	What about the bomb?

/*爆弾はどうなった？*/
ライデン_007: {
Elle est d&'esamorc&'ee.
Et Fatman aussi !
}
//	<<<ENGLISH>>>
//	Defused. And Fatman too.

/*ああ、解除した。
ファットマンも含め、全て。*/
プリスキン_008: {
Je suis heureux de l'entendre !
}
//	<<<ENGLISH(2)>>>
//	That's good news.

/*そいつはいいニュースだ。*/
ライデン_009: {
Et la Shell 2 ?
}
//	<<<ENGLISH>>>
//	How's Shell 2?

/*シェル２の様子は？*/
プリスキン_010: {
Elle n'est pas belle &`a voir.
La bombe a endommag&'e l'Etai H.
}
//	<<<ENGLISH>>>
//	It's a mess.
//	The bomb crippled H Strut.

/*こっちはひどい有様だ。
爆発したＨ脚は目茶苦茶だ。*/
ライデン_011: {
Et les toxines ?
}
//	<<<ENGLISH(2)>>>
//	What about the toxins?

/*有毒物質の発生は？*/
プリスキン_012: {
Les quoi ?
}
//	<<<ENGLISH>>>
//	The what?

/*なに？*/
ライデン_013: {
Si la Big Shell saute, l'explosion
est cens&'ee produire une quantit&'e
massive de toxines...
}
//	<<<ENGLISH>>>
//	If the Big Shell blows up, the
//	explosion is expected to produce
//	massive amounts of toxins...

/*『ビッグ・シェル』が爆発・炎上すると
大量の有毒物質が……。*/
プリスキン_014: {
C'est nouveau, &~qa !
}
//	<<<ENGLISH>>>
//	Never heard anything about that.

/*そんな話は聞いていないが？*/
ライデン_015: {
Hein ?
}
//	<<<ENGLISH(2)>>>
//	Huh?

/*え？*/
プリスキン_016: {
En tout cas, ce sc&'enario est peu probable.
}
//	<<<ENGLISH>>>
//	Well, looks like there's not
//	much danger of that in any case.

/*まあその心配はない様だ。*/
//<ページ数変更>
プリスキン_016_1: {
Mais le noyau central commence
&`a prendre l'eau. Il ne fera pas long feu.
}
//	<<<ENGLISH>>>
//	But the central core is
//	starting to flood.
//	It won't last much longer.

/*だが爆発の衝撃で中央棟が浸水している。
長くは持たないだろうな……。*/
ライデン_017: {
... Et le Pr&'esident et les autres
otages, alors ?
}
//	<<<ENGLISH>>>
//	What about the President
//	and the other hostages?

/*……大統領や人質は？*/
プリスキン_018: {
Ils n'&'etaient pas dans la Shell 2. 
Ils doivent &^etre dans la Shell 1.
}
//	<<<ENGLISH>>>
//	They weren't in Shell 2.
//	They must be in Shell 1.

/*いや、シェル２にはいなかった。
おそらく、シェル１だろう。*/
ライデン_019: {
Il faut qu'on &'evacue les otages
sur-le-champ !
}
//	<<<ENGLISH>>>
//	We need to get the hostages
//	out of here now.

/*早く人質を待避させなければ。*/
プリスキン_020: {
Manhattan est un peu trop loin,
&`a la nage !
}
//	<<<ENGLISH>>>
//	It's too far from Manhattan
//	for a swim.

/*ここからマンハッタンまで泳ぎ切れる
距離じゃない。*/
ライデン_021: {
Et les canots de sauvetage ?
}
//	<<<ENGLISH>>>
//	What about life boats?

/*救命ボートみたいなものは？*/
プリスキン_022: {
Il ne semble pas y en avoir.
C'est r&^ap&'e !
}
//	<<<ENGLISH>>>
//	There doesn't seem to be
//	any. Doesn't make sense.

/*いや、装備されていないようだ。
考えられない事だがな。*/
ライデン_023: {
L'h&'elico est notre seul moyen
de partir d'ici, alors ?
}
//	<<<ENGLISH>>>
//	So a chopper is
//	our only extraction?

/*ヘリで脱出しかない？*/
プリスキン_024: {
Exact. Il ne peut transporter qu'un nombre
limit&'e de passagers. D'apr&`es les services
secrets, il y aurait environ trente otages.
}
//	<<<ENGLISH>>>
//	Right. And it comes with a passenger
//	limit. Intel has it that there are
//	about thirty hostages.

/*そうだ。しかも人数制限付き。
情報によれば人質は３０人ほどいる
そうだ。*/
ライデン_025: {
Un seul voyage ne suffira pas.
}
//	<<<ENGLISH>>>
//	It'd take more than
//	a single trip.

/*１回では無理だな。*/
プリスキン_026: {
On va devoir faire plusieurs allers-retours.
}
//	<<<ENGLISH>>>
//	We'll have to come back.

/*往復するしかない。*/
ライデン_027: {
Tu sais piloter les h&'elicos ?
}
//	<<<ENGLISH>>>
//	Can you pilot a chopper?

/*ヘリの操縦はできるのか？*/
プリスキン_028: {
Non, mais je suis venu avec un pilote.
C'est un type bien. Je te le pr&'esenterai
plus tard.
}
//	<<<ENGLISH>>>
//	No, but I brought a gearhead with
//	me. He's a good guy. I'll introduce
//	you later.

/*いや、しかし、メカオタクの仲間を
連れてきている。信用できる奴だ。
後で紹介する。*/
ライデン_029: {
Pliskin, je suis sur l'h&'eliport,
mais je ne vois pas leur Harrier.
Il doit &^etre parti quelque part.
}
//	<<<ENGLISH>>>
//	Pliskin, I'm on the heliport right
//	now, but I don't see their Harrier.
//	It's out somewhere.

/*プリスキン、今ヘリポートだが、
敵のハリアーが見えない。
出払っているようだ。*/
プリスキン_030: {
On ferait mieux de partir tout de suite.
Si l'Harrier nous tombe dessus, c'est
la fin des haricots !
}
//	<<<ENGLISH>>>
//	We'd better move now then. Our
//	chances with a Harrier after us
//	are close to nothing.

/*今のうちだな。
ハリアーに狙われたら終わりだ……。*/
ライデン_031: {
Tu sais o&`u se trouve le Pr&'esident ?
}
//	<<<ENGLISH>>>
//	Do you know where
//	the President is?

/*大統領は？*/
プリスキン_032: {
Non, &~qa te regarde !
}
//	<<<ENGLISH>>>
//	No. That one's all yours.

/*わからない。そっちは任せる。*/
ライデン_033: {
Le Pr&'esident fait partie
des gens &`a sauver en priorit&'e.
Ce sont nos ordres, Lieutenant !
}
//	<<<ENGLISH>>>
//	The President is at the top of our
//	rescue list. These are our orders,
//	Lieutenant J.G..

/*救出は大統領が優先だぞ。
それが俺達の任務だ。*/
プリスキン_034: {
Tes ordres, peut-&^etre...
Mais pas les miens !
}
//	<<<ENGLISH>>>
//	Your orders. Not mine.

/*お前の、だろう？
勘違いするな。*/
ライデン_035: {
Quoi ?
}
//	<<<ENGLISH(2)>>>
//	What?
/*なに？*/
プリスキン_036: {
A plus !
}
//	<<<ENGLISH>>>
//	See you later.

/*じゃあな。*/
}//d



resource P036_03_R01_忍者登場３無線デモ１＿１__f {
//vc113601
オルガ_000: {
On est plus &`a l'abri comme &~qa, je crois.
}
//	<<<ENGLISH>>>
//	This is safer, I think.

/*こちらの方が都合が良い。*/
ライデン_001: {
A l'abri de quoi ?
}
//	<<<ENGLISH>>>
//	Safe from what?

/*……都合？*/
オルガ_002: {
Des oreilles indiscr&`etes, parbleu !
}
//	<<<ENGLISH>>>
//	Eavesdropping, of course.

/*人に聞かれる心配がない。*/
ライデン_003: {
Ah ! Mais pourquoi m'as-tu contact&'e ?
}
//	<<<ENGLISH>>>
//	All right -- why did
//	you contact me?

/*ああ……なぜ俺に接触を？*/
オルガ_004: {
J'ai re&~qu l'ordre de t'aider et de te
transmettre certaines informations.
}
//	<<<ENGLISH>>>
//	I've been ordered to give you
//	backup, including the relaying
//	of necessary intel.

/*情報供給も含め、おまえをサポートする
ように言われている。*/
ライデン_005: {
Qui t'a donn&'e cet ordre ?
}
//	<<<ENGLISH>>>
//	Ordered by whom?

/*誰に？*/
オルガ_006: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
ライデン_007: {
Pourquoi ne veux-tu pas d&'ecliner
ton identit&'e ?
}
//	<<<ENGLISH>>>
//	Why won't you identify
//	yourself?

/*何故正体を明かさない？*/
オルガ_008: {
Tu n'as aucun besoin de savoir qui je suis.
}
//	<<<ENGLISH>>>
//	There is no need
//	for you to know.

/*お前が知る必要はない。*/
ライデン_009: {
C'est &`a moi de d&'ecider ce que j'ai
besoin de savoir !
}
//	<<<ENGLISH>>>
//	I'll decide whether
//	I need to know.

/*必要あるかどうかは俺が決める。*/
オルガ_010: {
On ne te fait pas encore assez
confiance pour &~qa !
}
//	<<<ENGLISH>>>
//	You are not yet trusted
//	to make such decisions.

/*お前に判断する資格は与えられていない。*/
ライデン_011: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
オルガ_012: {
Permets-moi de te donner les informations
dont tu as vraiment besoin...
}
//	<<<ENGLISH>>>
//	I'll tell you something you
//	do need to know, instead.

/*かわりに知る必要があることを
教えてやろう。*/
オルガ_013: {
Comme le lieu exact o&`u se trouve
le Pr&'esident, par exemple !
}
//	<<<ENGLISH>>>
//	The current location
//	of the President.

/*大統領の居場所だ。*/
ライデン_014: {
Quoi !
}
//	<<<ENGLISH(2)>>>
//	What!

/*なに？*/
オルガ_015: {
Disons plut&^ot que je peux te dire
qui sait o&`u se trouve le Pr&'esident.
}
//	<<<ENGLISH>>>
//	Or rather, the person who
//	knows the current location
//	of the President.

/*正確には大統領の居場所を知っている
人間……。*/
ライデン_016: {
De qui s'agit-il ?
}
//	<<<ENGLISH>>>
//	Who is it?

/*誰だ？*/
オルガ_017: {
D'un agent des services secrets appel&'e
Ames. Il est actuellement d&'etenu avec
les autres otages.
}
//	<<<ENGLISH>>>
//	A Secret Service agent named Ames,
//	currently being held with the other
//	hostages.

/*エイムズというシークレット・サービス
だ。今は人質と共に捕らえられている。*/
ライデン_018: {
Un agent des services secrets, hein !
}
//	<<<ENGLISH>>>
//	Secret Service, huh.

/*シークレット・サービス？*/
オルガ_019: {
Oui, il dirige l'&'equipe de protection
du Pr&'esident.
}
//	<<<ENGLISH>>>
//	The head of the President's
//	security detail.

/*そうだ。エイムズはシークレット・
サービスの中でも特別な地位にある。*/
オルガ_020: {
Ames est pourvu du m&^eme syst&`eme
de nanomachine pour VIP que
le Pr&'esident.
}
//	<<<ENGLISH>>>
//	Ames has been fitted with the same
//	type of VIP nanomachine system as
//	the President.

/*大統領のものと同じ要人用ナノマシンが
注入されていて、*/
//<ページ数変更>
オルガ_020_1: {
En te pla&~qant &`a sa port&'ee,
tu devrais pouvoir lui parler.
}
//	<<<ENGLISH>>>
//	If you're within range, you
//	should be able to communicate.

/*近くにいれば相互に
体内通信が可能だ。*/
ライデン_021: {
Pourquoi me racontes-tu tout &~qa ?
}
//	<<<ENGLISH>>>
//	Why are you telling me this?

/*……なぜ俺にそんなことを教える？*/
オルガ_022: {
Tu n'as pas entendu ce
que je t'ai dit tout &`a l'heure ?
}
//	<<<ENGLISH>>>
//	Do I need to repeat myself?

/*同じ言葉を何度言わせる気だ？*/
ライデン_023: {
Je n'ai aucune raison de te croire !
C'est compris ?
}
//	<<<ENGLISH>>>
//	There's no reason for me
//	to believe any of this.
//	You understand that?

/*……俺がお前を信じなければならない
理由もないと思うが？*/
オルガ_024: {
Evidemment, mais tu n'as pas d'autre
choix que de me croire !
}
//	<<<ENGLISH>>>
//	Of course. But you also have
//	no choice but to believe.

/*無論だ。しかしお前は信じざるを得ない。
そうだろう？*/
ライデン_025: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
オルガ_026: {
Tu as d'autres pistes ?
}
//	<<<ENGLISH>>>
//	Do you have any other leads?

/*他に手がかりがあるのか？*/
ライデン_027: {
...O&`u sont les otages ?
}
//	<<<ENGLISH>>>
//	...where are those hostages?


/*……人質はどこにいる？*/
オルガ_028: {
Ha ha ha ha.
}
/*
ふふん。*/
}//d





resource P036_08_R02_忍者登場８無線デモ２＿１__f {
//vc113611
オルガ_000: {
Je te conseille de te grouiller.
Ils ont le nucl&'eaire pour eux.
}
//	<<<ENGLISH>>>
//	I suggest you hurry.
//	They have the nuke
//	on their side.

/*急いだ方が良いぞ。
奴等には核がある。*/
ライデン_001: {
Le nucl&'eaire !?
Ils ont une arme nucl&'eaire SUR eux ?
}
//	<<<ENGLISH>>>
//	The nuke!? They have a
//	nuclear weapon WITH them?

/*核！？
奴等、核兵器を持ち込んでいるのか！？*/
オルガ_002: {
Tu ne trouves pas bizarre qu'ils
s'&'eternisent ici ?
}
//	<<<ENGLISH>>>
//	You didn't find their continuing
//	presence here unusual?

/*お前はおかしいと思わなかったのか？*/
オルガ_003: {
Ils ont certes pris le Pr&'esident en otage,
mais on est sur une &^ile -- ils n'ont &`a
premi&`ere vue aucune chance de
s'&'echapper...
}
//	<<<ENGLISH>>>
//	Even with the President as hostage,
//	this is an island -- and they have
//	no visible means of escape...

/*大統領を人質にとっているとはいえ、
なぜ奴等はここにとどまっているのか？*/
/* 意味包含
//<ページ数変更>
オルガ_004: {
逃げ場のないこの孤島に……
脱出手段も用意せず。
}
*/
ライデン_005: {
Admettons qu'ils aient une arme
nucl&'eaire... Aucune ogive ne peut
&^etre lanc&'ee sans code d'acc&`es.
}
//	<<<ENGLISH>>>
//	...Even if they do have a nuke,
//	the warhead is no good without
//	an access code.

/*例え奴等が核兵器を持ち込んだとしても、
核弾頭には安全装置が組み込まれている
はずだ。*/
//<ページ数変更>
ライデン_005_1: {
Le verrouillage de s&'ecurit&'e
est impossible &`a contourner...
}
//	<<<ENGLISH>>>
//	The security lockout
//	can't be bypassed...

/*起爆コード入力式の……。
}*/
オルガ_006: {
Ils n'ont pas besoin de le contourner !
Ils ont le code !
}
//	<<<ENGLISH>>>
//	They don't need to.
//	They have the code.

/*それも奴等は手に入れている。*/
}//d


resource P036_10_R03_忍者登場１０無線デモ３＿１__f {
//vc113621
ライデン_000: {
Pourquoi sont-ils venus
avec la mallette noire ?
}
//	<<<ENGLISH>>>
//	Why did they have to bring
//	the football along?

/*なぜここにブラックケースを
持ち込んだんだ？
*/
//<ページ数変更>
ライデン_000_1: {
Dans une usine de d&'econtamination,
par-dessus le march&'e !?
}
//	<<<ENGLISH>>>
//	To a decontamination
//	plant, of all places.

/*ただの除染プラントに……。*/
オルガ_001: {
Il le fallait bien...
}
//	<<<ENGLISH>>>
//	But they did have to.

/*答えは簡単だ。*/
//<ページ数変更>
オルガ_001_1: {
Apr&`es tout, la Big Shell est tout
sauf une usine de d&'econtamination !
}
//	<<<ENGLISH>>>
//	Because, after all, the Big Shell
//	is the farthest thing from a cleanup
//	plant there is.

/*『ビッグ・シェル』は
除染プラントなどではないからだよ。*/
ライデン_002: {
Quoi !?
}
//	<<<ENGLISH(2)>>>
//	What!?

/*なに！？*/
オルガ_003: {
La Dead Cell n'avait nullement besoin
d'apporter une arme nucl&'eaire puisqu'il
y en avait d&'ej&`a une sur place, depuis
le d&'ebut !
}
//	<<<ENGLISH>>>
//	Dead Cell didn't have to bring
//	a nuke along with them.
//	It was right here to begin with.

/*核も奴等が持ち込んだのではない。
初めからここにあるものだ。
*/
//<ページ数変更>
オルガ_003_1: {
Tout est en trompe-l'&@eil,
dans cette affaire...
}
//	<<<ENGLISH>>>
//	Nothing in this affair
//	is what it seems...

/*そう、全ては偽装……。*/
ライデン_004: {
C'est une mascarade...
Mais dans quel but ?
}
//	<<<ENGLISH>>>
//	A cover-up -- but
//	why? For what?

/*偽装！？いったい何の？*/
オルガ_005: {
Il s'agissait de cacher la pr&'esence
du Metal Gear.
}
//	<<<ENGLISH>>>
//	For Metal Gear,
//	that is housed here.

/*ここには……メタルギアがある……。*/
}//d



resource P036_13_R04_忍者登場１３無線デモ４＿１__f {
//vc113631
ライデン_000: {
Colonel, qui &'etait cet homme ?
}
//	<<<ENGLISH>>>
//	Colonel, who was
//	that man just now?

/*大佐、今の男は何者だ？*/
大佐_001: {
Il est inconnu au bataillon.
}
//	<<<ENGLISH>>>
//	He's not one of ours.

/*我々の仲間ではない。*/
大佐_002: {
Nous n'avons jamais vu ce type
dans notre unit&'e.
}
//	<<<ENGLISH(2)>>>
//	No -- we have no one
//	like that in our unit.

/*違う……うちにあんな隊員はいない。*/
ライデン_003: {
D'apr&`es lui, la Big Shell abrite 
un nouveau mod&`ele de Metal Gear.
}
//	<<<ENGLISH>>>
//	He said that the Big Shell
//	was housing a new model
//	of Metal Gear.

/*この『ビッグ・シェル』に
新型メタルギアがあると言っていたが？
*/
大佐_004: {
C'est nouveau, &~qa !
}
//	<<<ENGLISH>>>
//	First I've heard of it.

/*初耳だ……。*/
ライデン_005: {
Tu me caches des choses,
hein, Colonel ?
}
//	<<<ENGLISH>>>
//	Colonel, what are
//	you not telling me?

/*大佐、俺に何を隠している？*/
大佐_006: {
J'ai &'et&'e tout &`a fait franc avec toi, Raiden.
Je t'ai tout dit !
}
//	<<<ENGLISH>>>
//	I've been completely open
//	with you, Raiden. I've told
//	you everything.

/*いや。隠し事などしていない。
全て話している。*/
ライデン_007: {
Tout dit de ce que tu sais ou tout dit
de ce que je suis cens&'e savoir ?
}
//	<<<ENGLISH>>>
//	Is that everything you know
//	-- or everything I need to
//	know?

/*……それは大佐の知っている全てか？
それとも俺に話していいと許可された
ことの全てか？*/
大佐_008: {
Arr&^ete ton char, Raiden !
}
//	<<<ENGLISH>>>
//	Snap out of it, Raiden!

/*馬鹿なことを言うな、ライデン！*/
ライデン_009: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
大佐_010: {
Je vais v&'erifier cette rumeur concernant
le Metal Gear. Quant &`a toi, prends contact
avec Ames !
}
//	<<<ENGLISH>>>
//	I'll have the Metal Gear rumor
//	looked into. You need to make
//	contact with this Ames.

/*メタルギアについてはこちらでも調べて
みる。君はエイムズに接触してくれ。*/
ライデン_011: {
Alors tu crois que qu'a dit ce ninja ?
}
//	<<<ENGLISH>>>
//	So you believe that Ninja?

/*あの男の言うことを信じろと？*/
大佐_012: {
Nous n'avons pas le choix ! C'est la seule
piste que nous ayons sur le Pr&'esident !
}
//	<<<ENGLISH>>>
//	Since we have no leads on the
//	President's current location,
//	we have no other alternatives.

/*他に大統領につながる手がかりがない
以上、今は他に方法がない。*/
大佐_013: {
Pour l'heure, recueille un maximum
d'informations sans n&'egliger ce qui
concerne le Metal Gear.
}
//	<<<ENGLISH>>>
//	Right now, collect as much
//	data as you can, including
//	anything on Metal Gear.

/*メタルギアのことも含めて情報を
得るんだ。*/
ライデン_014: {
Ce sont mes ordres ?
}
//	<<<ENGLISH>>>
//	Are those my orders.

/*それが指令か？*/
大佐_015: {
Affirmatif. D&'eguise-toi en soldat ennemi
et introduis-toi dans le noyau de la Shell 1.
}
//	<<<ENGLISH>>>
//	Yes they are. Disguise yourself
//	as an enemy soldier and infiltrate
//	the Shell 1 Core.

/*そうだ。敵兵士に変装して
シェル１中央棟に潜入しろ。*/
ライデン_016: {
... Compris !
}
//	<<<ENGLISH>>>
//	...Understood.

/*……了解。*/
}




resource P037_01_R01_スネークの遺体１無線デモ１＿１__f {
//vc113701
ローズ_000: {
Tu as une minute, Jack ?
}
//	<<<ENGLISH>>>
//	Got a minute, Jack?

/*ジャック、ちょっといい？*/
ライデン_001: {
Rose ?
}
//	<<<ENGLISH(2)>>>
//	Rose?

/*ローズ？*/
ローズ_002: {
J'ai du nouveau sur l'endroit o&`u
est enterr&'e Solid Snake !
}
//	<<<ENGLISH>>>
//	I found some information on
//	where Solid Snake is interred.

/*頼まれていたスネークの
遺体の調査だけど……。*/
ライデン_003: {
Super ! Je t'&'ecoute !
}
//	<<<ENGLISH>>>
//	Great. Shoot.

/*どうだった？*/
ローズ_004: {
Je sais o&`u est sa tombe.
}
//	<<<ENGLISH>>>
//	I've located the grave site.

/*スネークの墓を見つけた。*/
ライデン_005: {
Et le corps ?
}
//	<<<ENGLISH>>>
//	And the body?

/*それで遺体は？*/
ローズ_006: {
On l'a exhum&'e pour pratiquer
des tests ADN.
}
//	<<<ENGLISH>>>
//	Exhumed for DNA testing.

/*スネークの墓を掘り起こして、
ＤＮＡ鑑定をしたわ。*/
ライデン_007: {
Et alors ? Tu as les r&'esultats ?
}
//	<<<ENGLISH>>>
//	Well? Do you have the results?

/*結果は？*/
ローズ_008: {
Il n'avait plus de bras droit mais c'est
incontestablement lui. Ce corps est bien
celui de Solid Snake.
}
//	<<<ENGLISH>>>
//	The right arm was missing, but
//	there was no doubt that it was him.
//	That body belongs to Solid Snake.

/*右腕が欠損していたものの、
ソリッド・スネークに間違いない。
彼はすでに死んでいる。*/
ライデン_009: {
Ahhhh ! Le chef du groupe de terroristes
est donc s&^urement --
}
//	<<<ENGLISH>>>
//	Hrmmm... So the head of
//	the terrorist group must
//	be --

/*ううん……となると、
今回のテロリストは？*/
ローズ_010: {
Un imposteur.
}
//	<<<ENGLISH>>>
//	An impostor.

/*スネークを語る偽物。*/
ライデン_011: {
C'est &~qa...
}
//	<<<ENGLISH(2)>>>
//	Right...

/*そうか……。*/
ローズ_012: {
Tu as l'air d&'e&~qu !
}
//	<<<ENGLISH>>>
//	You sound disappointed.

/*どうしたの？
がっかりしたようだけど。*/
ライデン_013: {
Eh bien... Disons que j'aurais bien aim&'e
rencontrer cette l&'egende en chair et en os.
}
//	<<<ENGLISH>>>
//	I guess -- I guess I was kind of
//	hoping to meet the legend in the
//	flesh.

/*いや、伝説の男に会えるかもしれないと、
どこかで期待していた。*/
ローズ_014: {
Je comprends, mais il ne semble pas &^etre
responsable des &'ev&'enements actuels.
}
//	<<<ENGLISH>>>
//	I get you. But it looks
//	like he's not behind this
//	incident.

/*そうね。
でも彼は今回の主犯ではない。*/
大佐_015: {
Raiden, je crois que le Pr&'esident
a besoin de toi.
}
//	<<<ENGLISH>>>
//	Raiden, the President
//	needs you, I think.

/*ライデン、大統領の手がかりを追うんだ。*/
大佐_016: {
D&'eguise-toi en employ&'e ennemi
et infiltre dans la section du noyau.
}
//	<<<ENGLISH>>>
//	Disguise yourself as enemy
//	personnel and infiltrate the
//	core section.

/*テロリストに化けて、中央棟に潜入しろ。
*/
//<ページ数変更>
大佐_016_1: {
Essaie avant tout de contacter
l'agent Ames.
}
//	<<<ENGLISH>>>
//	Your priority is to
//	contact Agent Ames.

/*エイムズを探すんだ。*/
}




resource P040_02_R02_エイムズ発見２無線デモ１＿１__f {
//vc114001
エイムズ_000: {
Tu m'entends ?
}
//	<<<ENGLISH>>>
//	Are you on?

/*聞こえるか？*/
ライデン_001: {
Cinq sur cinq !
}
//	<<<ENGLISH(2)>>>
//	Right here.

/*大丈夫だ。*/
ライデン_002: {
Tu sais vraiment o&`u se trouve
le Pr&'esident ?
}
//	<<<ENGLISH>>>
//	Do you really know where
//	the President is?

/*あんた、本当に大統領の居場所を？*/
エイムズ_003: {
Oui, je suis presque s&^ur que les terroristes
l'ont amen&'e au premier &'etage de la section
du noyau de la Shell 2.
}
//	<<<ENGLISH>>>
//	Almost certainly. He was moved
//	to the first floor of Shell 2's core
//	section.

/*ああ。
シェル２中央棟の１Ｆに移されたらしい。*/
ライデン_004: {
Premier &'etage, noyau de la Shell 2...
}
//	<<<ENGLISH>>>
//	The first floor,
//	the core of Shell 2...

/*シェル２中央棟の１Ｆ……。*/
ライデン_005: {
Il y est toujours ?
}
//	<<<ENGLISH>>>
//	Is he still there?

/*今もそこにいるのか？*/
エイムズ_006: {
Je ne sais pas.
Je n'arrive pas &`a obtenir de signal.
}
//	<<<ENGLISH>>>
//	I don't know. I can't
//	get a response.

/*いや、今は反応がない。*/
ライデン_007: {
Tu ne crois pas qu'il a subi --
le sort des autres otages... ?
}
//	<<<ENGLISH>>>
//	You don't think he's been --
//	like the other hostages...?

/*まさか、他の人質のように……？*/
エイムズ_008: {
?
}
//	<<<ENGLISH(2)>>>
//	?

/*？*/
ライデン_009: {
Tu sais bien qu'ils ont &'elimin&'e un otage
pour se venger du d&'esastre de l'&'equipe
SEAL 10, hein ?
}
//	<<<ENGLISH>>>
//	A hostage was killed in
//	retaliation after the SEAL
//	10 disaster, remember?

/*ＳＥＡＬ１０が突入した報復に人質が
殺されただろう？*/
エイムズ_010: {
De quoi parles-tu ?
}
//	<<<ENGLISH(2)>>>
//	What are you talking about?

/*何のことだ？*/
ライデン_011: {
... ?
}
//	<<<ENGLISH(2)>>>
//	...?

/*……？*/
エイムズ_012: {
J'ignore quel sort ils r&'eservent aux otages,
mais je sais qu'ils ne toucheront pas au
Pr&'esident.
}
//	<<<ENGLISH>>>
//	Regardless of what they do
//	to other hostages, they won't
//	touch the President.

/*他の人質はともかく、
奴等は大統領を殺さない。*/
ライデン_013: {
Qu'est-ce qui te fait dire &~qa ?
}
//	<<<ENGLISH>>>
//	What makes you so sure?

/*なぜそう言い切れる？*/
エイムズ_014: {
La mallette...
}
//	<<<ENGLISH>>>
//	The case.

/*ブラックケースだよ。*/
ライデン_015: {
Tu parles du bouton nucl&'eaire
qu'ils ont pris ?
}
//	<<<ENGLISH>>>
//	You mean the nuclear
//	button they took?

/*奴等が奪っていった、
核兵器を解除するケースのことか？*/
エイムズ_016: {
Exact. La mallette ne fonctionne
pas toute seule.
}
//	<<<ENGLISH>>>
//	Right. And the case won't
//	do a thing by itself.

/*そうだ。
奴等はブラックケースを奪った。
だがそれだけでは意味を成さない。*/
エイムズ_017: {
Cette mallette incarne &`a elle seule ce qui
se fait de plus moderne niveau syst&`eme
&`a s&^uret&'e int&'egr&'ee.
}
//	<<<ENGLISH>>>
//	That case may be the single most
//	advanced example of a weapons
//	fail-safe system.

/*あのケースは最新ハイテク技術の粋を
集めたものだ。*/
エイムズ_018: {
Son mot de passe n'est rien de moins
que le profil physiologique du Pr&'esident
des Etats-Unis !
}
//	<<<ENGLISH>>>
//	The password is nothing less than
//	the physiological data of the U.S.
//	President.

/*合衆国大統領の生体データを用いる
暗号システムを採用している。*/
ライデン_019: {
Le profil physiologique ?
}
//	<<<ENGLISH>>>
//	Physiological data?

/*生体データ？*/
エイムズ_020: {
Il repr&'esente les signes vitaux du Pr&'esident
-- ses battements cardiaques, son trac&'e
&'electroenc&'ephalographique, sa pression
sanguine etc.
}
//	<<<ENGLISH(2)>>>
//	The President's own vital signs --
//	heartbeat, brainwave pattern,
//	blood pressure and so on --

//<ページ数変更>
エイムズ_020_1: {
sont constamment surveill&'es et retransmis
par ses nanomachines internes.
}
//	<<<ENGLISH(2)>>>
//	are constantly monitored and
//	relayed by his internal nano-
//	machines.

/*大統領体内のナノマシンから
ＤＮＡ情報、鼓動、脳波、血圧等を
送信し、それを鍵とするんだ。*/
エイムズ_021: {
Ces param&`etres, ajout&'es &`a sonempreinte
ADN, forment un mot de passe biom&'etrique
impossible &`a violer,
}
//	<<<ENGLISH(2)>>>
//	This information along with the
//	DNA pattern serve as a biometric
//	password, unbreakable even by＃−

//<ページ数変更>
エイムズ_021_1: {
m&^eme &`a l'aide des tout-derniers
super-ordinateurs &`a processeur parall&`ele.
}
//	<<<ENGLISH>>>
//	the latest parallel processor
//	supercomputers.

/*最新の超並列コンピュータを使っても
破ることは出来ない。*/
エイムズ_022: {
Et pour que la saisie du mot
de passe fonctionne,
}
//	<<<ENGLISH>>>
//	The password entry itself cannot
//	be performed unless brainwave
//	patterns and heartbeats＃−

//<ページ数変更>
エイムズ_022_1: {
il faut que les trac&'es enc&'ephalographiques
et cardiaques soient normaux, ce qui
exclut toute forme de coercition chimique
ou autre.
}
//	<<<ENGLISH>>>
//	fall within normal parameters,
//	rendering chemical and other
//	forms of coercion impractical.

/*入力は脳波・心拍数等が通常の状態で
なければ無効になる。薬物や脅迫で
入力させることは出来ない。*/
エイムズ_023: {
Autrement dit, le Pr&'esident doit se
connecter de son plein gr&'e.
}
//	<<<ENGLISH>>>
//	In other words, the login must
//	be made of the President's own
//	free will.

/*つまり大統領本人が、自分自身の意志で
直接入力しなければ入力は認められない
仕組みになっている。*/
エイムズ_024: {
Par mesure de s&^uret&'e, la saisie doit &^etre
&`a nouveau confirm&'ee, heure apr&`es heure,
apr&`es la connexion initiale.
}
//	<<<ENGLISH>>>
//	As a fail-safe, the input must also
//	be reconfirmed hourly, even after
//	the initial login.

//<ページ数変更>
エイムズ_024_1: {
En l'absence de confirmation, le syst&`eme
annule automatiquement la connexion.
}
//	<<<ENGLISH(2)>>>
//	If a valid confirmation is not
//	forthcoming, the system will
//	automatically cancel the login.

/*その上、入力後も一定時間毎に
ＩＤ確認が義務づけられ、確認が得られ
ない場合、コード入力は取り消される。*/
ライデン_025: {
Ils n'ont effectivement
pas int&'er&^et &`a nuire au Pr&'esident...
}
//	<<<ENGLISH>>>
//	And that's why they can't
//	harm the President...

/*だから奴等は大統領を殺さない……？*/
エイムズ_026: {
Pas avant le lancement de l'engin,
en tout cas !
}
//	<<<ENGLISH>>>
//	-- at least until the bird flies.

/*少なくとも核を撃つまでは、な。*/
ライデン_027: {
Est-il vrai qu'un nouveau mod&`ele
de Metal Gear est entrepos&'e ici ?
}
//	<<<ENGLISH>>>
//	Is there really a new model
//	of Metal Gear here?

/*……ここには本当に核が……
新型メタルギアがあるのか？*/
エイムズ_028: {
Oui ! La Mallette noire sert &'egalement
&`a actionner le Metal Gear.
}
//	<<<ENGLISH>>>
//	Absolutely. The Black Case serves
//	as the launch key to Metal Gear as
//	well.

/*無論だ。ブラックケースのシステムは
核兵器の解除だけではなく、
新型メタルギア起動の鍵も兼ねている。*/
ライデン_029: {
Pourquoi cacher un Metal Gear
dans un site offshore ?
}
//	<<<ENGLISH>>>
//	Why would they hide a Metal
//	Gear in an offshore plant?

/*なぜ海上除染施設にメタルギアが？*/
エイムズ_030: {
...Tu ne le sais donc pas ?
}
//	<<<ENGLISH>>>
//	Haven't they told
//	you anything?


/*……何も聞かされていないのか？*/
ライデン_031: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
エイムズ_032: {
Tout a &'et&'e orchestr&'e -- la mar&'ee noire,
l'accident du tanker et tout le reste.
}
//	<<<ENGLISH>>>
//	The entire thing was planned --
//	the oil spill, the tanker accident
//	that caused it, everything.

/*全て偽装だ。原油汚染も、
その原因となったタンカーの沈没も。
何もかもな。*/
エイムズ_033: {
La Big Shell a &'et&'e construite dans
le seul but d'abriter la fabrication
du nouveau Metal Gear.
}
//	<<<ENGLISH(2)>>>
//	The Big Shell was built specifically
//	for the development of a new Metal
//	Gear model.

/*この『ビッグ・シェル』は
新型メタルギア開発を行うために
建造された。*/
エイムズ_034: {
La visite d'inspection a &'et&'e organis&'ee pour
suivre les progr&`es de cette entreprise...
}
//	<<<ENGLISH>>>
//	The inspection tour was
//	to check its progress...

/*今回の視察も、その進捗を確かめる
ためのものだった……。*/
ライデン_035: {
Mais qu'est-ce qui se passe ici,
c'est pas vrai !
}
//	<<<ENGLISH>>>
// What's going on around here...

/*どういうことなんだ？*/
エイムズ_036: {
Attends !
}
//	<<<ENGLISH(2)>>>
//	Wait!

/*待て！*/
}
//d



resource P040_06_R02_エイムズ発見６無線デモ２＿１__f {
//vc114011
エイムズ_000: {
Qu'est-ce que tu as capt&'e
de la conversation ?
}
//	<<<ENGLISH>>>
//	Anyway, what did you
//	manage to catch?

/*それより、奴等は何を？*/
ライデン_001: {
Ils ont dit que le mot de passe
a &'et&'e d&'ej&`a transmis ...
}
//	<<<ENGLISH>>>
//	They said password
//	input was complete...

/*コード入力は終わったと言っていた……。*/
エイムズ_002: {
C'est bien ce que je pensais...
}
//	<<<ENGLISH>>>
//	I thought so...

/*やはり……。*/
ライデン_003: {
Tu as dit que la transmission du mot
de passe &`a la Mallette noire devait
s'accomplir avec l'accord du Pr&'esident...
}
//	<<<ENGLISH>>>
//	You said the password entry into
//	the Black Case had to be made by
//	the President willingly.

/*あんた、ブラックケースは大統領が
自分の意志で入力しなければならない、
と言ったな。*/
エイムズ_004: {
C'est exact.
}
//	<<<ENGLISH(2)>>>
//	That's right.

/*ああ。*/
ライデン_005: {
Cela veut dire que le Pr&'esident coop&`ere
avec eux, pas vrai ?
}
//	<<<ENGLISH>>>
//	So this means the President
//	is cooperating with them?

/*では大統領自身が奴等に手を貸している
と言うことか？*/
エイムズ_006: {
Je suis oblig&'e de te r&'epondre
par l'affirmative !
}
//	<<<ENGLISH>>>
//	It would have to be, yes.

/*そうなるな。*/
ライデン_007: {
Mais pourquoi ?
}
//	<<<ENGLISH(2)>>>
//	Why?

/*一体なぜ？*/
エイムズ_008: {
Il en a s&^urement assez d'&^etre un pantin.
Mais il a eu tort de nous trahir...
}
//	<<<ENGLISH>>>
//	Probably tired of being a puppet.
//	But it wasn't a smart move to
//	betray us...

/*人形でいることに飽きたんだろうよ。
我々を裏切るとは……愚かな。*/
ライデン_009: {
Un pantin ?
}
//	<<<ENGLISH>>>
//	...a puppet?

/*……人形？*/
エイムズ_010: {
Ce n'est pas le tout, mais ils VONT tirer
une ogive nucl&'eaire. Tu sais ce qu'il te
reste &`a faire pour emp&^echer &~qa !
}
//	<<<ENGLISH>>>
//	We're running out of time. They
//	WILL fire a nuke. You know what
//	you need to do before then.

/*もう時間がないぞ。奴等は必ず核を撃つ。
その前に大統領を……。*/
ライデン_011: {
Tu parles ! S'ils vont tirer ! On est
encore loin du d&'elai fix&'e pour la remise
de la ran&~qon !
}
//	<<<ENGLISH>>>
//	Fire the nuke?
//	But it's nowhere close
//	to the ransom deadline.

/*核を撃つ？
要求のタイムリミットまでは
まだ時間があるぞ。*/
エイムズ_012: {
La ran&~qon ?
}
//	<<<ENGLISH(2)>>>
//	Ransom?

/*要求？*/
ライデン_013: {
Trente milliards de dollars en liquide...
}
//	<<<ENGLISH>>>
//	Thirty billion dollars in cash...

/*現金３００億ドル……。*/
エイムズ_014: {
Qu'est-ce que tu me racontes ? La frappe
nucl&'eaire n'est pas une menace... Les
terroristes le pr&'evoient de faire depuis
le d&'ebut, enfin !
}
//	<<<ENGLISH>>>
//	What are you babbling about!
//	The nuclear strike is not a threat --
//	it's been the objective all along!

/*何を言っている？
核攻撃は脅迫の手段などではない。
それこそが奴等の目的だ。*/
ライデン_015: {
Ils ont l'intention de massacrer
des millions de personnes ?
}
//	<<<ENGLISH>>>
//	They plan to slaughter
//	millions of people!?

/*大量虐殺が！？*/
エイムズ_016: {
Non -- l'explosion se produirait &`a haute
altitude. Tu as entendu parler de l'Effet
Compton ?
}
//	<<<ENGLISH>>>
//	No -- a high-altitude detonation.
//	You've heard of the Compton Effect?

/*いや。奴等は高空で核を使うつもりだ。
聞いたことがあるだろう？
コンプトン効果やスカラー電磁波……。*/
ライデン_017: {
Il s'agit de la perturbation totale
des &'equipements &'electroniques
par les vibrations EMMA.
}
//	<<<ENGLISH(2)>>>
//	The total disruption
//	of electronic equipment
//	caused by EMMA pulse.

/*核爆発による電子機器の破壊か？*/
エイムズ_018: {
Tu as bien appris ta le&~qon ! Chaque fois
qu'une ogive nucl&'eaire moyenne explose
dans l'atmosph&`ere,
}
//	<<<ENGLISH(2)>>>
//	Textbook answer. Well, when
//	an average nuclear warhead
//	goes off within the atmosphere,

//<ページ数変更>
エイムズ_018_1: {
elle provoque des vibrations
&'electromagn&'etiques de plus
de 50 milliards de m&'egawatts.
}
//	<<<ENGLISH(2)>>>
//	the result is an electromagnetic
//	pulse of up to 50 billion megawatts.

/*そうだ。大気中で核爆発が起こると
５兆メガワットを越える強烈な
電磁パルスが発生する。*/
エイムズ_019: {
Les vibrations EMMA peuvent atteindre
des dizaines de milliers de volts par m&`etre 
}
//	<<<ENGLISH>>>
//	The EMMA field can reach tens
//	of thousands of volts per meter,

//<ページ数変更>
エイムズ_019_1: {
et la plupart des &'equipements
&'electroniques sont instantan&'ement
grill&'es.
}
//	<<<ENGLISH(2)>>>
//	and most electronic equipment
//	will be toast in an instant.

/*電磁場の強さは数万ボルト／メートル
にもなり、一般の電子機器は全て
破壊される。*/
}
/* 以下の文は？ ムービー？？？
奴等はそれをマンハッタン上空で行おうとしているんだ
And this is what they plan
to do right over Manhattan.
*/
//d




resource P040_06_R02_エイムズ発見６無線デモ２＿２__f {
//vc114012
エイムズ_000: {
Ce n'est pas le but qu'ils recherchent !
}
//	<<<ENGLISH>>>
//	But that isn't their aim.


/*いやそうではない。*/
//<ページ数変更>
エイムズ_000_1: {
Ce qu'ils veulent, c'est 'lib&'erer' Manhattan
et le d&'econnecter pour en faire une sorte
de r&'epublique.
}
//	<<<ENGLISH>>>
//	What they plan to do is "liberate"
//	Manhattan, pull it offline, and turn
//	it into some kind of a republic.

/*デジタルのくびきを
断ち切りマンハッタンを解放区とする
こと……それが奴等の狙いだ。
*/
エイムズ_001: {
D'o&`u leur id&'ee de se proclamer
les 'Fils de la Libert&'e', je suppose !
}
//	<<<ENGLISH(2)>>>
//	Hence "Sons of Liberty," I suppose.

/*ふん。『＃｛自由の息子達、サンズ・オブ・リバティー｝＃』とは
よく言ったものだな……。*/
ライデン_002: {
'Les Fils de la Libert&'e' ?
}
//	<<<ENGLISH(2)>>>
//	"Sons of Liberty"...?

/*『＃｛自由の息子達、サンズ・オブ・リバティー｝＃』……？*/
エイムズ_003: {
Mince, Ocelot arrive !
Je vais me d&'econnecter.
}
//	<<<ENGLISH>>>
//	Damn, Ocelot is coming!
//	I'm going offline.

/*くっマズイ。
オセロットが来る！
体内通信を解くぞ。*/
}
//d



resource P041_02_R01_エイムズ死亡後２無線デモ１＿１__f {
//vc114101
ライデン_000: {
Colonel, Ames est mort.
Une crise cardiaque, apparemment.
}
//	<<<ENGLISH>>>
//	Colonel, Ames is dead.
//	Looked like a heart attack.

/*大佐、エイムズが死んだ。
心臓発作のようだった。*/
大佐_001: {
Hum, c'est bien dommage. Enfin,
nous savons tout de m&^eme o&`u se
trouve le Pr&'esident !
}
//	<<<ENGLISH>>>
//	Hm, that's unfortunate. However,
//	we do at least know where the
//	President is.

/*ああ。残念なことだ。だが大統領の
居場所がわかっただけで良しとしよう。*/
ライデン_002: {
... Cet endroit abrite donc bien
un nouveau type de Metal Gear ?
}
//	<<<ENGLISH>>>
//	So there really is a new type
//	of Metal Gear in this place?

/*……ここに新型メタルギアがあるのは
確かなようだが？
*/
大佐_003: {
Apparemment.
Nous n'avons pas encore &'elucid&'e
ce myst&`ere...
}
//	<<<ENGLISH>>>
//	Apparently.
//	We're still looking into it...

/*そうらしいな。
現在調査を行っている……。*/
ライデン_004: {
On m'a aussi dit que les terroristes avaient
pour seul but intention de lancer une ogive
}
//	<<<ENGLISH>>>
//	I've also been told that the nuclear
//	strike was what the terrorists were
//	after from the start.

/*奴等の目的は核攻撃らしいぞ。*/
//<ページ数変更>
ライデン_004_1: {
et qu'ils SE MOQUAIENT des trente
milliards de dollars !
}
//	<<<ENGLISH>>>
//	NOT the thirty billion dollars!

/*現金３００億ドルではなく！！*/
大佐_005: {
Pur&'ee ! On nous a men&'e en bateau,
depuis le d&'ebut...
}
//	<<<ENGLISH>>>
//	Chri-, it was a cover-up
//	all along...


/*偽装だったとはな……。*/
ライデン_006: {
Colonel ! Tu n'as pas l'impression
de m'avoir cach&'e la v&'erit&'e !?
}
//	<<<ENGLISH>>>
//	Colonel! What are you
//	keeping from me!

/*大佐！
一体何を隠している！！*/
大佐_007: {
Je ne t'ai rien cach&'e du tout !
Comme si on m'avait dit la v&'erit&'e,
&`a moi !
}
//	<<<ENGLISH>>>
//	I am not keeping back anything!
//	It's not as though I'm told all
//	the facts either!

/*何も隠してはおらん！
私も全てを知らされているわけでは
ないのだ。*/
ライデン_008: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
大佐_009: {
Je fais l'impossible pour d&'em&^eler cette
histoire ! Je te demande justement un
peu de patience !
}
//	<<<ENGLISH>>>
//	I'm pulling in all the favors
//	I can to look into all this.
//	Just be a little patient.

/*それらの件についてはあらゆる情報網を
使って調査をする。もう少し待ってくれ。*/
大佐_010: {
Pour l'heure, le Pr&'esident constitue
notre priorit&'e absolue !
}
//	<<<ENGLISH>>>
//	Our priority should be with
//	the President right now.

/*今問題なのは大統領だ。*/
大佐_011: {
Il faut partir du principe qu'ils ont fini
de saisir le mot de passe
}
//	<<<ENGLISH>>>
//	We can take it that they've
//	completed the password entry＃−

//<ページ数変更>
大佐_011_1: {
et qu'ils pr&'eparent le Metal Gear en vue
du lancement de la charge nucl&'eaire.
}
//	<<<ENGLISH>>>
//	and are preparing Metal Gear
//	for nuclear strike.

/*奴等がコード入力を終了し、
メタルギアによる核発射の準備を
整えていることは事実のようだ。*/
大佐_012: {
Va rejoindre Pr&'esident !
}
//	<<<ENGLISH>>>
//	Get to the President
//	as soon as possible.

/*君は一刻も早く大統領の元へ
向かってほしい。*/
ライデン_013: {
Mais le Pr&'esident coop&`ere avec eux !
}
//	<<<ENGLISH>>>
//	But the President is
//	cooperating with them --

/*しかし大統領は奴等と……。*/
大佐_014: {
C'est ce que pensait Ames ! Mais il n'en
reste pas moins vrai qu'ils s'appr&^etent &`a
se d&'ebarrasser de lui.
}
//	<<<ENGLISH>>>
//	According to Ames, yes. But
//	it's also true that they're about
//	to get rid of the President.

/*エイムズの話によればな。しかし奴等が
大統領を始末しようとしていることも
確かだ。*/
大佐_015: {
Il y a quelque chose de louche l&`a-dessous
}
//	<<<ENGLISH>>>
//	There's something
//	else going on here,

//<ページ数変更>
大佐_015_1: {
et le Pr&'esident sera peut-&^etre
en mesure de te renseigner,
si tu parviens  &`a lui parler !
}
//	<<<ENGLISH>>>
//	and the President may be able
//	to tell you what it is when you
//	see him in person.

/*裏にはまだ何かある。
大統領本人に会って状況を確かめるんだ。*/
ライデン_016: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
大佐_017: {
Une fois obtenue leur confirmation,
ils lanceront la charge nucl&'eaire.
}
//	<<<ENGLISH>>>
//	Once they get the confirmation
//	for nuclear launch, they'll do it.

/*それにコードの再確認がなされれば
奴等は核を撃つ。*/
大佐_018: {
Il faut que tu lib&`eres le Pr&'esident avant
qu'ils aient eu le temps de le faire !
}
//	<<<ENGLISH>>>
//	You need to rescue the
//	President before then.

/*いずれにせよ。その前に大統領の身柄を
確保するしかない。*/
ライデン_019: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
ローズ_020: {
Jack, je suis du m&^eme avis que le Colonel.
Contente-toi de prot&'eger le Pr&'esident !
}
//	<<<ENGLISH>>>
//	Jack, I agree with the Colonel.
//	You need to protect the President
//	for now.

/*ジャック……
私も大佐の言う通りだと思う。
今は大統領を……。*/
ライデン_021: {
Tr&`es bien...
}
//	<<<ENGLISH(2)>>>
//	All right...

/*わかった……。*/
}
//d




resource P042_01_R01_シェル１シェル２連絡橋１無線デモ１＿１__f {
//vc114201
プリスキン_000: {
Raiden, tu m'entends ?
}
//	<<<ENGLISH>>>
//	Raiden, can you hear me?

/*ライデン、聞こえるか！*/
ライデン_001: {
Pliskin ?
O&`u &'etais-tu pass&'e ?
}
//	<<<ENGLISH>>>
//	Pliskin?
//	Where have you been?

/*プリスキンか？
今までどこに？*/
プリスキン_002: {
J'inspectais les environs. Je me trouve
dans l'Etai H, &`a pr&'esent. Comment se
pr&'esentent les choses ?
}
//	<<<ENGLISH>>>
//	Checking around. I'm in
//	Strut H right now. How's
//	the situation over there?

/*ちょっとした調べものだ。
今Ｈ脚にいる。
そっちの状況は？*/
ライデン_003: {
J'ai une piste sur l'endroit
o&`u se trouve le Pr&'esident.
}
//	<<<ENGLISH>>>
//	We have a lead on the
//	President's location.

/*大統領の手がかりを得た。*/
プリスキン_004: {
O&`u est-il ?
}
//	<<<ENGLISH(2)>>>
//	Where is he?

/*どこだ？*/
ライデン_005: {
Dans le noyau de la Shell 2,
au premier &'etage.
}
//	<<<ENGLISH(2)>>>
//	Shell 2 Core, the first floor.

/*シェル２の中央棟の１Ｆにいるらしい。*/
プリスキン_006: {
Je n'ai pas acc&`es au noyau, de l'endroit
o&`u je me trouve. C'est la pagaille, ici !
}
//	<<<ENGLISH>>>
//	I'm cut off from the core
//	where I am. It's a mess
//	here.

/*そうか、こっちはひどい有様だ。
ここからでは中央棟へは回れない。*/
ライデン_007: {
Tr&`es bien. Je me dirige vers la Shell 2.
}
//	<<<ENGLISH>>>
//	All right. I'm on my way
//	to Shell 2 right now.

/*わかった。
これからシェル２へ向かう。*/
プリスキン_008: {
Il y a des capteurs &`a infrarouge sur
la passerelle de connexion reliant
les Shells 1 et 2.
}
//	<<<ENGLISH>>>
//	There are IR sensors in place on
//	the connecting bridge between
//	Shells 1 and 2.

/*シェル１シェル２連絡橋には
赤外線センサーのトラップが
仕掛けられている。*/
プリスキン_009: {
Si tu entres dans le champ des rayons,
le Semtex explosera !
}
//	<<<ENGLISH>>>
//	If you break the beams,
//	the Semtex will go off.

/*赤外線に触れるとセムテックスが
爆発するぞ。*/
ライデン_010: {
C'est ce qu'ils ont dit, eux aussi.
}
//	<<<ENGLISH>>>
//	Yeah, I heard them
//	talking about that.

/*ああ、奴らが話しているのを聞いた。*/
プリスキン_011: {
Vise les unit&'es de commande
et d&'etruis-les en prenant garde
de ne pas tirer sur le Semtex.
}
//	<<<ENGLISH>>>
//	Target the control units and
//	destroy them. Make sure you
//	don't shoot the Semtex.

/*制御装置を狙撃して破壊するんだ。
くれぐれも、セムテックス本体を
撃つんじゃないぞ。*/
/*　以下は廃止？？？*/
ライデン_012: {
Et le vaporisateur de r&'efrig&'erant ?
}
//	<<<ENGLISH>>>
//	What about the coolant spray?

// 
/*爆弾解体に使った冷却スプレーは？*/
プリスキン_013: {
Ils ne sont pas idiots ! Le Semtex
est hors de port&'ee, de l'autre c&^ot&'e
du garde-fou.
}
//	<<<ENGLISH>>>
//	They're not stupid. The Semtex is
//	on the other side of the railing,
//	out of reach.

// 
/*奴らも馬鹿じゃない。
セムテックスは橋の裏に仕掛けてある。*/
ライデン_014: {
A quoi ressemblent les unit&'es
de commande ?
}
//	<<<ENGLISH>>>
//	What do the control
//	units look like?

/*破壊しなければならない装置は？*/
プリスキン_015: {
Examine-les avec tes jumelles.
}
//	<<<ENGLISH>>>
//	Take a look with
//	your binoculars.

/*双眼鏡で見てみるといい。*/
}
//d




resource P044_01_R01_赤外線センサークリア１無線デモ１＿１__f {
//vc114401
プリスキン_000: {
Raiden, j'ai d&'egot&'e un moyen de transport.
}
//	<<<ENGLISH>>>
//	Raiden, I found us a ride.

/*ライデン、いいものを手に入れたぞ。*/
ライデン_001: {
Je t'&'ecoute !
}
//	<<<ENGLISH>>>
//	I'm all ears.

/*いいもの？*/
プリスキン_002: {
C'est un Kasatka ennemi.
}
//	<<<ENGLISH>>>
//	One of the enemy's Kasatkas.

/*敵のカサッカだ。*/
ライデン_003: {
Il est en bon ordre de marche ?
}
//	<<<ENGLISH>>>
//	Is it in good shape?

/*飛べるのか？*/
プリスキン_004: {
Le r&'eservoir est plein. Je me dirige vers
la Shell 1. Des nouvelles de l'Harrier ?
}
//	<<<ENGLISH>>>
//	Full tank. I'm heading for Shell 1
//	now. What about that Harrier?

/*燃料もＯＫだ。今からシェル１へ向かう。
ハリアーはどうした？*/
ライデン_005: {
Il n'est pas sur l'h&'eliport.
}
//	<<<ENGLISH>>>
//	It's not on the heliport here.

/*いや、こっちのヘリポートにはいない。*/
プリスキン_006: {
Bien. Je vais y mettre notre appareil.
}
//	<<<ENGLISH>>>
//	Good. I'll set this one
//	down there then.

/*よし、今のうちだ。そっちへ降りる。*/
ライデン_007: {
Tu peux t'occuper des otages ?
Ils sont d&'etenus au niveau B1 du noyau.
}
//	<<<ENGLISH(2)>>>
//	Can you cover the hostages?
//	They're being held on level
//	B1 in the core.

/*人質を頼む。
間違い＞＞＞中央棟の１Ｆに軟禁されている。
正解＞＞＞中央棟のＢ１に軟禁されている。*/
ライデン_008: {
Pliskin, tu n'as pas vu d'autres otages
ailleurs, hein ?
}
//	<<<ENGLISH>>>
//	Pliskin, you didn't happen to find
//	any other places where hostages
//	were being held, did you?

/*プリスキン、他に人質が捕らわれている
場所を見つけたか？*/
プリスキン_009: {
Non, pas l'ombre d'un otage.
}
//	<<<ENGLISH>>>
//	No -- nothing like that.

/*いや。そんな気配はなかった。*/
ライデン_010: {
Bon...
}
//	<<<ENGLISH(2)>>>
//	OK...

/*そうか……。*/
プリスキン_011: {
Combien y a-t-il d'otages ?
}
//	<<<ENGLISH>>>
//	How many hostages are there?

/*人質は何人いた？*/
ライデン_012: {
Un peu moins de trente.
Un mort et plusieurs bless&'es.
}
//	<<<ENGLISH(2)>>>
//	There's a few short of thirty.
//	One dead, and several wounded.

/*３０名弱……うち、１名死亡した。
何人か怪我もしている。*/
プリスキン_013: {
Le Kasatka ne peut pas contenir
plus de 13 personnes.
}
//	<<<ENGLISH>>>
//	The Kasatka's cargo area
//	will hold thirteen max.

/*カサッカの貨物はどうがんばっても
１３人が限界だ。*/
ライデン_014: {
Et l'autre Kasatka ?
}
//	<<<ENGLISH>>>
//	What about the other Kasatka?

/*もう一機のカサッカは？*/
プリスキン_015: {
Je l'ai sabot&'e. S'il ne peut pas voler,
on est s&^ur qu'il ne nous prendra pas
en chasse.
}
//	<<<ENGLISH>>>
//	I sabotaged it. It can't come after
//	us if it can't get off the ground.

/*飛べない様に細工をしておいた。
追跡されては困るからな。*/
ライデン_016: {
Ah !
}
//	<<<ENGLISH(2)>>>
//	Oh.

/*そうか。*/
プリスキン_017: {
On va devoir faire deux voyages.
}
//	<<<ENGLISH>>>
//	We'll have to make two trips.

/*往復するしかない。*/
ライデン_018: {
Tu sais piloter les Kasatka ?
}
//	<<<ENGLISH>>>
//	Can you fly a Kasatka?

/*カサッカを操縦できるのか？*/
プリスキン_019: {
J'ai un type avec moi qui a d&'ej&`a pilot&'e
un KA-62 en r&'ealit&'e virtuelle.
}
//	<<<ENGLISH>>>
//	I have a pilot who's flown the
//	civilian model, the KA-62, in VR.

/*民間用のＫＡ−６２の経験パイロットが
いる。と言ってもＶＲ訓練だがな。*/
プリスキン_020: {
C'est un mod&`ele civil, mais il n'y a pas de
grande diff&'erence entre un KA-60 militaire
et un mod&`ele civil.
}
//	<<<ENGLISH>>>
//	There's not a whole lot of
//	difference between the military
//	KA-60 and the civilian model.

/*機体は軍用型のＫＡ−６０とほとんど
同じだから問題なく操縦できるだろう。*/
//（ＯＦＦ）
オタコン_021: {
On a l'autorisation de d&'ecoller...
}
//	<<<ENGLISH>>>
//	Cleared for takeoff...

/*準備完了だ……。*/
プリスキン_022: {
Raiden, je te pr&'esente mon partenaire --
Otacon.
}
//	<<<ENGLISH>>>
//	Raiden, let me introduce you
//	to my partner -- Otacon.

/*ライデン、俺の相棒を紹介する。
オタコンだ。*/
ライデン_023: {
Otacon ?
}
//	<<<ENGLISH>>>
//	'Otacon'?

/*オタコン？*/
オタコン_024: {
Salut, Raiden !
Ravi de faire ta connaissance !
}
/*やあ、ライデン。
始めまして。
よろしく頼むよ。*/
プリスキン_025: {
Mince !
}
//	<<<ENGLISH(2)>>>
//	Damn!

/*まずいっ！*/
プリスキン_026: {
Raiden, je te rappellerai plus tard !
}
//	<<<ENGLISH>>>
//	Raiden, I'll talk to you later.

/*ライデン、後で話す。*/
}//d

resource P044_01_R01_赤外線センサークリア１無線デモ１＿２__f {
//vc114402
ライデン_000: {
Colonel, j'ai des renseignements
&`a te demander. Qui sont Pliskin
et son partenaire, au juste ?
}
//	<<<ENGLISH>>>
//	Colonel, I need some answers
//	from you. Who exactly is Pliskin
//	and his partner?

/*大佐、答えてくれ！
プリスキン達は何者なんだ？*/
大佐_001: {
Je vois o&`u tu veux en venir...
}
//	<<<ENGLISH>>>
//	I know what you're thinking.

/*君の考えている事ならわかる。*/
ライデン_002: {
Shadow Moses n'arr&^ete pas de revenir
sur le tapis. Et voici qu'on me parle de
ce Otacon...
}
//	<<<ENGLISH>>>
//	It keeps coming back to Shadow
//	Moses. And now this Otacon...

/*シャドーモセスにオタコンと言えば……。*/
ローズ_003: {
Hal Emmerich, docteur de son &'etat,
un survivants de Shadow Moses.
}
//	<<<ENGLISH>>>
//	AKA Hal Emmerich, Ph.D.
//	A Shadow Moses survivor.



/*ハル・エメリッヒ博士。
シャドーモセス事件での生存者。*/
ライデン_004: {
Rose ?
}
//	<<<ENGLISH(2)>>>
//	Rose?

/*ローズ？*/
ローズ_005: {
Apr&`es Shadow Moses, Snake et Otacon,
qui &'etaient recherch&'es pour actes
terroristes, ont pris la fuite...
}
//	<<<ENGLISH>>>
//	Snake and Otacon both became
//	fugitives after Shadow Moses,
//	wanted for acts of terrorism.

/*あの事件の後、スネークとオタコンは
テロリストとして指名手配された。*/
ライデン_006: {
Ils appartenaient &`a une organisation
anti-Metal Gear...
}
//	<<<ENGLISH>>>
//	An anti-Metal Gear organization...

/*反メタルギア団体……。*/
大佐_007: {
Ils ont sabot&'e et d&'etruit un nombre
incalculable d'unit&'es de Metal Gear,
dans le monde entier...
}
//	<<<ENGLISH>>>
//	They sabotaged and destroyed
//	countless Metal Gear units
//	throughout the world...

/*彼らは世界中のメタルギアを
破壊して回った。*/
ローズ_008: {
Et ce sont eux qui ont orchestr&'e
l'incident ayant
}
//	<<<ENGLISH>>>
//	And were responsible for the
//	incident two years ago＃−

//<ページ数変更>
ローズ_008_1: {
n&'ecessit&'e la construction
de la Big Shell, il y a deux ans.
}
//	<<<ENGLISH>>>
//	that necessitated the
//	construction of the Big
//	Shell.

/*そして２年前その『ビッグ・シェル』が
建造される理由を作った。*/
ライデン_009: {
Snake et son partenaire ne sont
pas des terroristes !
}
//	<<<ENGLISH>>>
//	Snake and his partner
//	aren't terrorists.

/*スネーク達はテロリストではない。*/
ローズ_010: {
Jack, pourquoi les d&'efends-tu ?
}
//	<<<ENGLISH>>>
//	Jack, why are you
//	defending them?

/*ジャック、どうして彼らをかばうの？*/
ライデン_011: {
Plus je pense &`a ce que j'ai accompli
plus je me dis que ce n'est pas
avec l'entra&^inement
}
//	<<<ENGLISH>>>
//	I look back on what I've
//	done here so far＃−

//<ページ数変更>
ライデン_011_1: {
et le sens du devoir qu'on arrive
&`a mener une mission furtive !
}
//	<<<ENGLISH>>>
//	things like training and sense
//	of duty alone won't get you through
//	a sneaking mission like this.

/*これまで任務を遂行して感じる……
使命感だけでは＃｛潜入任務、スニーキング・ミッション｝＃は達成できない。
単にタフなだけでは。*/
ローズ_012: {
Jack, tu vas bien ?
}
//	<<<ENGLISH>>>
//	Jack, are you okay?

/*ジャック、大丈夫？*/
ライデン_013: {
Il faut autre chose -- de plus &'elev&'e.
Les mots me manquent, mais...
}
//	<<<ENGLISH>>>
//	You need something -- higher.
//	I can't think of the right word,
//	but...

/*それ以上に崇高な何か？
そう、的確な言葉が見あたらないが。*/
ライデン_014: {
Il faut une volont&'e brute et -- du courage
ou des id&'eaux ou d'autres &'el&'ements
du m&^eme ordre.
}
//	<<<ENGLISH>>>
//	it has to be pure will, backed
//	up by -- by courage, or ideals,
//	or something like that.

/*たとえば、『勇気』や『理想』に
裏付けされた強い『意志』が必要だ。*/
ライデン_015: {
J'en mettrais ma main au feu.
}
//	<<<ENGLISH>>>
//	I'd stake my life on it.

//<ページ数変更>
ライデン_015_1: {
Si le Solid Snake a sauv&'e Shadow Moses
impossible qu'il devienne terroriste !
}
//	<<<ENGLISH>>>
//	The Solid Snake that saved
//	Shadow Moses couldn't turn
//	into a terrorist.

/*俺にも感じるんだ。シャドーモセスを
救ったスネークはテロリストに豹変は
しない。*/
大佐_016: {
Tu as peut-&^etre raison, mais, ils ont
coul&'e avec le tanker, il y a deux ans.
On a m&^eme retrouv&'e le corps de Snake...
}
//	<<<ENGLISH>>>
//	Maybe that's true, but they went
//	down with that tanker two years ago.
//	We even recovered Snake's body.

/*それは定かではないが、
彼らは２年前、タンカーと共に沈んだ。
そしてスネークの遺体も回収されている。*/
ライデン_017: {
Et les tests ADN pratiqu&'es
sur ce corps l'ont formellement identifi&'e.
}
//	<<<ENGLISH>>>
//	And the DNA test results
//	on the body say it's him.

/*遺体のＤＮＡ検査も一致。*/
ローズ_018: {
Jack, je suis bien ton raisonnement,
mais Snake est mort.
}
//	<<<ENGLISH>>>
//	Jack, I know what you're
//	saying, but Snake is dead.

/*ジャック、あなたの気持ちもわかる。
でもスネークは死んでるの。*/
ローズ_019: {
Il est impossible qu'il soit ici et cela
vaut pour le Dr. Hal Emmerich.
}
//	<<<ENGLISH>>>
//	He can't be here, not even
//	as this Dr. Hal Emmerich.

/*だから彼がハル・エメリッヒ博士である
はずはないわ。*/
ライデン_020: {
Mais cela prouve &'egalement qu'il ne peut
pas &^etre &`a la t&^ete du groupe de terroristes
ayant foment&'e tout &~qa !
}
//	<<<ENGLISH>>>
//	But that also means that he
//	can't be the terrorist leader
//	behind this thing.

/*もうひとつ確かな事がある……
テロリストのリーダーもスネークでは
ありえない。*/
}
//d




resource P046_02_R01_ハリアー戦勝利２無線デモ１＿１__f {
//vc114601
プリスキン_000: {
Raiden, tu vas bien ?
}
//	<<<ENGLISH>>>
//	Raiden, you all right?

/*ライデン、大丈夫か？*/
ライデン_001: {
Ouais ! Et vous, les gars ?
}
//	<<<ENGLISH>>>
//	Yeah.
//	How about you guys?

/*そっちはどうなんだ？*/
プリスキン_002: {
On a eu chaud, mais tout va bien !
}
//	<<<ENGLISH>>>
//	Barely managed,
//	but we're all right.

/*どうにか着陸した。*/
ライデン_003: {
Et l'h&'elico ?
}
//	<<<ENGLISH>>>
//	The chopper?

/*ヘリは無事か？*/
プリスキン_004: {
Il va nous falloir un peu de temps
pour le r&'eparer.
}
//	<<<ENGLISH>>>
//	We need some time for repairs.

/*修理の時間が必要だ。*/
ライデン_005: {
Ah... !
}
//	<<<ENGLISH(2)>>>
//	Oh...

/*そうか……。*/
プリスキン_006: {
Je te confie le Pr&'esident !
}
//	<<<ENGLISH>>>
//	The President's all yours.

/*大統領を頼むぞ。*/
ライデン_007: {
OK... Je peux te poser une question ?
}
//	<<<ENGLISH>>>
//	OK... Can I ask you something?

/*あっ、ちょっと？*/
プリスキン_008: {
De quoi s'agit-il ?
}
//	<<<ENGLISH(2)>>>
//	What?

/*なんだ？*/
ライデン_009: {
Tu es LE Snake de la l&'egende ?
}
//	<<<ENGLISH>>>
//	Are you THE Snake?

/*あんたが、スネークなのか？*/
プリスキン_010: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
ライデン_011: {
D'apr&`es les rumeurs, tu serais mort...
}
//	<<<ENGLISH>>>
//	They said you were dead...

/*死んだはずだ……。*/
プリスキン_012: {
Mort ? Non ! J'ai encore trop
de choses &`a faire !
}
//	<<<ENGLISH>>>
//	No, nt me. There are still too
//	many things I need to do.

/*俺は死なんさ。
まだやることがたくさんある。*/
ライデン_013: {
Snake, tu es une l&'egende --
c'est ce qui explique ma question !
}
//	<<<ENGLISH>>>
//	Snake, you're a legend -- and
//	that's why I need to ask you this.

/*スネーク、あんたが伝説の傭兵として、
聞きたいことがある。*/
プリスキン_014: {
Une l&'egende ?
}
//	<<<ENGLISH>>>
//	Legend?

/*伝説？*/
プリスキン_015: {
Les l&'egendes ne sont jamais vraies.
Ce sont des histoires que les gens
colportent...
}
//	<<<ENGLISH>>>
//	A legend is nothing but fiction.
//	Someone tells it, someone else
//	remembers, everybody passes it on.

/*伝説は人が作るものだ。
人が記憶し、語り伝えるものだ。*/
ライデン_016: {
Je suis ici, parce qu'on m'a confi&'e une
mission, ce n'est pas de gaiet&'e de c&@eur...
}
//	<<<ENGLISH>>>
//	I'm here because I was assigned to
//	this mission, not because I want to.

//<ページ数変更>
ライデン_016_1: {
Si je pouvais, je m'enfuierai...
}
//	<<<ENGLISH>>>
//	If I could, I'd be out
//	of here in a second.

/*俺は任務でここにる。自らの意志では
ない。できれば、今すぐにでもここから
逃げたい。*/
プリスキン_017: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
ライデン_018: {
Enfin... Qu'est-ce qui t'a pouss&'e 
&`a revenir ? Pourquoi te bats-tu ?
}
//	<<<ENGLISH(2)>>>
//	How could you come back to
//	all this? Why keep fighting?

/*なぜ再び戦場に？*/
プリスキン_019: {
Mon meilleur ami m'a un jour dit ceci...
}
//	<<<ENGLISH>>>
//	There's something my best
//	friend said to me once.

/*ライデン、いいか。
俺の親友の言った言葉がある。*/
ライデン_020: {
Quoi ?
}
//	<<<ENGLISH(2)>>>
//	wha...?


/*……。*/
プリスキン_021: {
Nous ne sommes pas &`a la solde
du gouvernement, ni de personne
d'autre, d'ailleurs.
}
//	<<<ENGLISH>>>
//	We're not tools of the
//	government or anyone
//	else.

//<ページ数変更>
プリスキン_021_1: {
Le combat est ma meilleure arme,
certes, mais je l'ai toujours mis au
service de mes convictions...
}
//	<<<ENGLISH>>>
//	Fighting was the only thing I was
//	good at, but... At least I always
//	fought for what I believed in...

/*俺達は政府や誰かの道具じゃない。
戦う事でしか自分を表現できなかったが
……いつも自分の意志で戦ってきた。*/
ライデン_022: {
Et -- les r&'esultats ADN du corps
qu'on a retrouv&'e ?
}
//	<<<ENGLISH>>>
//	What about -- what about the
//	DNA results from that body?

/*なぜ……遺体のＤＮＡ検査では。*/
オタコン_023: {
Il s'agit du corps de Liquid. Snake
et lui ont le m&^eme patrimoine g&'en&'etique.
}
//	<<<ENGLISH>>>
//	That was Liquid's body.
//	He and Snake are identical
//	on the genetic level.

/*あれはリキッドの遺体だよ。
彼とスネークはＤＮＡレベルでは
全く同じ。*/
ライデン_024: {
Liquid...
}
//	<<<ENGLISH(2)>>>
//	Liquid.

/*リキッドの遺体。*/
オタコン_025: {
Ce subterfuge -- &'etait n&'ecessaire
&`a notre protection.
}
//	<<<ENGLISH>>>
//	A deception -- for
//	our own protection.

/*そうさ、世間の目を欺くためのトリック。*/
オタコン_0251: {
Nous avons d&'erob&'e son corps congel&'e &`a
une organisation... Il y a mieux, comme
proc&'ed&'e, mais enfin...
}
//	<<<ENGLISH>>>
//	We stole his frozen body from
//	some organization. Kind of a
//	hassle though...

/*ある機関が冷凍保存してたのを
盗み出したんだ。
ちょっと苦労したけどね*/
プリスキン_026: {
Ce n'est pas plus compliqu&'e que &~qa !
}
//	<<<ENGLISH>>>
//	That's all there is to it.

/*そういう事だ。*/
ライデン_027: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
ライデン_028: {
Vous appartenez vraiment &`a une ONG ?
}
//	<<<ENGLISH>>>
//	Are you two really an NGO?

/*君らは本当に＃｛非政府組織、ＮＧＯ｝＃なのか？*/
オタコン_029: {
Notre organisation &`a but non lucratif
regroupe des citoyens luttant pour une
cause...
}
//	<<<ENGLISH>>>
//	Insofar as we're a nonprofit
//	organization of civilians
//	advocating a cause, yes.

//<ページ数変更>
オタコン_029_1: {
Et cette cause, c'est la disparition
du Metal Gear...
}
//	<<<ENGLISH>>>
//	The cause happens to be the
//	eradication of Metal Gear.

/*ああ、僕らは民間の反メタルギア組織さ。*/
プリスキン_030: {
Nous travaillons en ind&'ependants,
mais notre cause vaut la peine
d'&^etre d&'efendue !
}
//	<<<ENGLISH>>>
//	We work on our own.
//	But it's a cause worth
//	fighting for.

/*何処にも属さない。
この地球上からメタルギアを
根絶する為に動いている……。*/
ライデン_031: {
Pourquoi mettre votre vie en danger
pour une cause aussi risqu&'ee ?
}
//	<<<ENGLISH>>>
//	Why would you stick your neck
//	out for something this risky?

/*なぜそんな危険な事を？*/
プリスキン_032: {
C'est l'opinion que j'&'emettais moi aussi,
il y a quatre ans...
}
//	<<<ENGLISH>>>
//	That's the way I used to
//	look at it, four years ago.

/*４年前の俺もそう思っていた。*/
プリスキン_034: {
J'&'etais enterr&'e dans un trou, quelque part
en Alaska... Et je for&~qais un peu trop sur
la bouteille !
}
//	<<<ENGLISH>>>
//	I was holed up in the middle
//	of nowhere in Alaska, drinking
//	too much.

/*アラスカの僻地で自分の殻に
閉じこもって……酔っぱらっていた。*/
オタコン_035: {
Nous avons des responsabilit&'es vis-&`a-vis
des g&'en&'erations futures et du monde.
}
//	<<<ENGLISH>>>
//	We have a responsibility to the
//	coming generations, to the world.

/*僕らは伝える義務がある。
世間に、子供達に。*/
ライデン_036: {
Quelles responsabilit&'es ?
}
//	<<<ENGLISH>>>
//	What responsibility?

/*何を。*/
オタコン_037: {
Nous devons rendre compte de nos fautes
au nom de l'esp&`ece humaine...
}
//	<<<ENGLISH>>>
//	To keep track of the mistakes
//	we've made as a species.

/*我々人類の間違い。*/
プリスキン_038: {
Il faut se souvenir -- pr&^echer la bonne
parole -- et lutter pour changer les choses.
C'est cette lutte qui me fait vivre !
}
//	<<<ENGLISH>>>
//	We need to remember -- to spread
//	the word -- to fight for change.
//	And that's what keeps me alive.

/*過ちを記憶して、伝える、抗議する……
その為に生きる。*/
ライデン_039: {
Vous pensez vraiment pouvoir changer
l'avenir ?
}
//	<<<ENGLISH>>>
//	You think you can
//	change the future?

/*君らが未来を変える？*/
プリスキン_040: {
Non, je n'ai pas cette pr&'etention !
}
//	<<<ENGLISH>>>
//	I'm not as arrogant as that.

/*そこまで自惚れてはいない。*/
ライデン_041: {
Vos actions diff&`erent de celles
des activistes de base. Elles
ressemblent plus &`a du terrorisme...
}
//	<<<ENGLISH>>>
//	What you do isn't grassroots
//	activism. It's more like terrorism.

/*君らのは、草の根運動なんかじゃない。
テロに近い。*/
プリスキン_042: {
Ce n'est pas faux...
}
//	<<<ENGLISH>>>
//	I admit that...

/*そうかもな。*/
オタコン_043: {
Mais notre groupe, Philanthropy,
a eu vent de certaines informations.
}
//	<<<ENGLISH>>>
//	But our group, Philanthropy,
//	received some information:

/*僕らの組織『フィランソロピー』が、
情報を手に入れたんだ。*/
オタコン_044: {
Un nouveau prototype de Metal Gear
aurait &'et&'e en cours de d&'eveloppement
et des terroristes avaient l'intention
de prendre le site d'assaut.
}
//	<<<ENGLISH>>>
//	A new Metal Gear prototype was
//	being developed here, and terrorists
//	were planning to raid the facility.

/*ここで新型メタルギア開発が行われて
いて、テロリストがそれを襲撃しようと
しているっていうね。*/
オタコン_045: {
Ces informations &'emanaient d'une source
tr&`es fiable !
}
//	<<<ENGLISH>>>
//	The information came from
//	a very reliable source.

/*タレコミなんかとは違う、
信頼できる情報だった。*/
ライデン_046: {
Vous &^etes donc venus ici...
}
//	<<<ENGLISH>>>
//	So you're here to...

/*だからあんた達はここに？*/
オタコン_047: {
Pour arr&^eter tout &~qa. Mais j'ai un
motif personnel, &'egalement !
}
//	<<<ENGLISH>>>
//	We're here to stop all that, but
//	I also have a personal motive.

/*ああ……。
それと、個人的な理由……。*/
プリスキン_048: {
Les terroristes d&'etiendraient sa s&@eur
dans la Big Shell.
}
//	<<<ENGLISH>>>
//	Looks like the terrorists have
//	his sister in the Big Shell.

/*こいつの妹がビッグシェルにいるらしい。*/
プリスキン_049: {
Nous sommes venus ici de notre plein gr&'e
et nous ne suivons les ordres de personne.
Nous avons notre combat &`a mener.
}
//	<<<ENGLISH>>>
//	We're here on our own, not under
//	anyone's orders. We have our own
//	battles.

//<ページ数変更>
プリスキン_049_1: {
Otacon est l&`a pour quelqu'un -- pas moi !
}
//	<<<ENGLISH>>>
//	Otacon's here for
//	someone -- I'm not.

/*俺達は誰の使いでもない。俺達の意志で、
俺達の闘いをしている。俺は……俺は
誰の為にも戦っていない。*/
ライデン_050: {
C'est une mission militaire.
}
//	<<<ENGLISH>>>
//	This is a military mission.

/*これはミッションだ。*/
}
//d


resource P046_02_R01_ハリアー戦勝利２無線デモ１＿２__f {
//vc114602
ローズ_000: {
Jack ? Tu vas bien ?
}
//	<<<ENGLISH>>>
//	Jack? Are you all right?

/*大丈夫、ジャック？*/
ライデン_001: {
Il faut le dire vite !
}
//	<<<ENGLISH>>>
//	Just barely.

/*かろうじて……。*/
ローズ_002: {
Tu as failli me faire avoir
une crise cardiaque...
}
//	<<<ENGLISH>>>
//	You almost gave me
//	a heart attack...

/*もう私、
心臓がどうにかなってしまいそう。*/
ライデン_003: {
D&'esol&'e !
Ce n'&'etait pas mon intention !
}
//	<<<ENGLISH>>>
//	Sorry. Wasn't intentional.

/*ああ、悪気はないんだが。*/
ローズ_004: {
Je sais ! Il faut que j'essaie d'&^etre
un peu plus forte !
}
//	<<<ENGLISH>>>
//	I know that. And I know
//	I need to stay stronger.

/*ええ、わかってる。
私も強くならなくっちゃね。*/
ライデン_005: {
Prie pour moi, Rose ! Demande
au ciel de me laisser la vie sauve...
}
//	<<<ENGLISH>>>
//	Say a prayer for me, Rose.
//	So I can come back...

/*祈ってくれ、俺が無事で帰れるように。*/
ローズ_006: {
Tu reviendras de cette mission !
Et je suis &`a tes c&^ot&'es, n'oublie pas !
}
//	<<<ENGLISH>>>
//	You will make it back.
//	I'm with you all the way,
//	 remember...

/*大丈夫、帰れるわ。
私がついてる……。*/
ライデン_007: {
Ce que tu me dis me touche beaucoup,
tu sais !
}
//	<<<ENGLISH>>>
//	That means a lot
//	to me, you know.

/*心強いよ、ほんと。
この状況ではね。*/
ローズ_008: {
Je vais sauvegarder les donn&'ees.
D'accord, Jack ?
}
//	<<<ENGLISH>>>
//	I'm going to save
//	the data, okay Jack?

/*ジャック、＃｛記録、セーブ｝＃しておくわね。*/
}



resource P046_02_R01_ハリアー戦勝利２無線デモ１＿３__f {
//vc114603
ライデン_000: {
Colonel, le Metal Gear est d&'ej&`a
op&'erationnel...
}
//	<<<ENGLISH>>>
//	Colonel, the Metal Gear's
//	already gone active...

/*大佐、メタルギアはもう起動して
しまった……。*/
大佐_001: {
Tu peux encore arr&^eter la frappe
nucl&'eaire ! Il faut que tu mettes
la main sur le Pr&'esident
}
//	<<<ENGLISH>>>
//	It's not too late. You can still
//	prevent a nuclear strike by
//	securing the President＃−

//<ページ数変更>
大佐_001_1: {
et que tu emp&^eches la confirmation
du mot de passe !
}
//	<<<ENGLISH>>>
//	and preventing password
//	confirmation from taking
//	place.

/*まだ間に合う。大統領を確保して
コードの再確認を防げば、核攻撃は
阻止出来る。*/
大佐_002: {
Va aupr&`es du Pr&'esident. Il se trouve
dans la section du noyau de la Shell 2 !
}
//	<<<ENGLISH>>>
//	Get to the President. He's in
//	the core section of Shell 2.

/*大統領の元へ急げ。シェル２の中央棟だ。*/
ローズ_003: {
J'examine &`a pr&'esent
les images par satellite...
}
//	<<<ENGLISH(2)>>>
//	I'm checking the satellite
//	images...

//<ページ数変更>
ローズ_003_1: {
Il semble possible d'acc&'eder au noyau
par l'autre c&^ot&'e de l'Etai L.
}
//	<<<ENGLISH(2)>>>
//	Looks like you can get to
//	the core from the other
//	side of Strut L.

/*衛星からの映像では……
Ｌ脚の向こうまでいけば、
中央棟へいけそうよ。*/
大佐_004: {
A premi&`ere vue, le noyau n'est
pas encore submerg&'e...
}
//	<<<ENGLISH>>>
//	The core hasn't gone under
//	yet from what we can tell.

//<ページ数変更>
大佐_004_1: {
Suis les garde-fous vers le bas
et saute sur les tuyaux.
}
//	<<<ENGLISH>>>
//	Follow the railings down,
//	then jump onto the pipes.

/*今のところ、中央棟はまだ浮かんでいる
ようだ。その手すりを伝って行くしか
ない。途中でパイプに飛び移れ。*/
ローズ_005: {
L'Etai L est le seul encore viable,
dans le p&'erim&`etre externe.
}
//	<<<ENGLISH>>>
//	The only viable strut in the
//	outer perimeter is the L.

//<ページ数変更>
ローズ_005_1: {
Cette attaque n'a plus lieu d'&^etre --
cet endroit ne semble plus leur &^etre
utile, &`a pr&'esent.
}
//	<<<ENGLISH>>>
//	That attack just now doesn't make
//	any sense -- it's like they have no
//	more use for this place.

/*外周脚で無事なのはＬ脚だけみたい。
さっきの攻撃……変ね。
彼ら、もうここは必要ないみたい。*/
ライデン_006: {
Colonel, tu as &'ecout&'e les appels par
Codec... Cet homme &'etait le vrai Snake,
depuis le d&'ebut...
}
//	<<<ENGLISH>>>
//	Colonel, you were monitoring
//	the Codec calls. That man was
//	the real Snake, all along...

/*大佐、聞いていたろう？スネークだった、
あの男は……。*/
大佐_007: {
C'est peut-&^etre lui, en effet !
}
//	<<<ENGLISH(2)>>>
//	Maybe.

/*そうかもしれん。*/
ライデン_008: {
Peut-&^etre ?
}
//	<<<ENGLISH>>>
//	Maybe?

/*かもしれん？*/
大佐_009: {
Reste tout de m&^eme sur tes gardes...
}
//	<<<ENGLISH>>>
//	Don't let your guard
//	down with him.

/*決して気を許すな。*/
ライデン_010: {
Pourquoi dis-tu &~qa ?
}
//	<<<ENGLISH>>>
//	Why do you say that?

/*なぜ？*/
大佐_011: {
Ces gens-l&`a n'ont jamais fait partie
de notre simulation ! Ils constituent
un facteur inconnu !
}
//	<<<ENGLISH>>>
//	Because they were never
//	a part of the simulation.
//	They're an unknown factor.

/*彼らとの協力はシミュレーションには
入っておらん。不確定要素だ。*/
ライデン_012: {
Toi et ta simulation, tu sais... ! Nous
sommes sur le terrain, nous ! Il y a des
gens qui souffrent et qui meurent, aussi !
}
//	<<<ENGLISH>>>
//	You can take your simulation
//	and...! We're out here, we
//	bleed, we die!

/*なんでもシミュレーションなんだな。
実際に戦って、血を流してるんだぞ！*/
ローズ_013: {
Du calme, tu veux !
}
//	<<<ENGLISH>>>
//	Calm down!

/*落ち着いて！*/
大佐_014: {
Je te conseille d'&'ecouter
ce que te dit Rose, Raiden !
}
//	<<<ENGLISH>>>
//	I suggest that you do, Raiden.

/*そうだ、冷静になれ。*/
大佐_015: {
M&^eme si cet homme est Snake,
cela ne change rien &`a notre mission !
}
//	<<<ENGLISH>>>
//	Even if that is Snake, that has
//	no bearing on your mission.

/*もし彼らがスネークであったとしても、
君の任務にはなんら変更はない。*/
ライデン_016: {
Colonel, Snake et toi &'etiez jadis
dans le m&^eme camp...
}
//	<<<ENGLISH>>>
//	Colonel, you and Snake used
//	to be on the same side.

/*大佐、あんたは以前、スネークと共に
戦ったはず。*/
大佐_017: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
ライデン_018: {
Un truc m'&'echappe. J'ai lu quelque chose
sur Snake et toi dans l'ouvrage 'Les
dessous de Shadow Moses' --
}
//	<<<ENGLISH>>>
//	I don't understand. I read about
//	you and Snake in "In the Darkness
//	of Shadow Moses" --

/*わからない。
『シャドーモセスの真実』によると、
大佐とスネークは。*/
大佐_019: {
Je me moque des inepties racont&'ees
dans ces foutaises. Tu piges ?
}
//	<<<ENGLISH>>>
//	I don't give a damn what
//	that piece of trash said.
//	Do you get me?

/*そんなゴシップ記事は意味がない。
いいな？*/
}




resource P047_05_R01_電撃床前オルガ５無線デモ１＿１__f {
//vc114701
ライデン_000: {
Je me trouve devant la pi&`ece o&`u
est d&'etenu le Pr&'esident.
}
//	<<<ENGLISH>>>
//	I'm in front of the room where
//	they're keeping the President.

/*大統領が軟禁されている部屋に到着した。*/
大佐_001: {
Tout va bien ?
}
//	<<<ENGLISH>>>
//	Everything all right?

/*そこは大丈夫か？*/
ライデン_002: {
L'endroit ne semble pas &^etre inond&'e,
mais impossible d'approcher la porte.
Le sol est &'electrifi&'e.
}
//	<<<ENGLISH>>>
//	No sign of flooding, but I can't
//	get close to the door. The floor
//	is electrified.

/*浸水はしていないが、扉には近づけない。
高圧電流が流されている。*/
大佐_003: {
Ne joue pas avec le feu !
Tu risques de griller sur place !
}
//	<<<ENGLISH>>>
//	Don't test it.
//	You'll be bacon.

/*なるほど。
上は歩くな。
黒焦げになるぞ。*/
ライデン_004: {
Tu as des suggestions &`a me faire ?
}
//	<<<ENGLISH>>>
//	Any suggestions?

/*どうすればいい？*/
大佐_005: {
Proc&`ede comme lors de la formation RV
sur Shadow Moses.
}
//	<<<ENGLISH>>>
//	Remember the Shadow
//	Moses VR training.

/*シャドーモセス事件を思い出せ。
あの事件のＶＲ訓練をな。*/
ライデン_006: {
Je retire la plaquette de circuits
imprim&'es ?
}
//	<<<ENGLISH>>>
//	Take out the circuit panel?

/*電源パネルを破壊する？*/
大佐_007: {
Exact !
}
//	<<<ENGLISH(2)>>>
//	Right.

/*そうだ。*/
ライデン_008: {
Il n'y a aucun moyen d'acc&'eder
&`a la pi&`ece.
}
//	<<<ENGLISH>>>
//	But there's no way
//	into the room.

/*しかし、中には入れそうもない。*/
大佐_009: {
Rep&'ere les bouches d'a&'eration.
}
//	<<<ENGLISH>>>
//	Try ventilation ducts.

/*通気ダクトがあるだろう？*/
ライデン_010: {
Ouais, je crois que j'en vois une !
}
//	<<<ENGLISH>>>
//	Yeah, I think I see one.

/*ああ……ダクトの穴なら……。*/
大佐_011: {
Essaie de trouver un lance-missiles
t&'el&'ecommand&'e et introduis-le dans
la pi&`ece par la bouche d'a&'eration.
}
//	<<<ENGLISH>>>
//	Look for a remote-control missile
//	launcher. You can guide it through
//	the duct into the room.

/*リモコン・ミサイルを探すんだ。
リモコン・ミサイルなら、
ダクトを通過する事ができる。*/
ライデン_012: {
-- Apr&`es, il me suffira de viser la plaquette
de circuits imprim&'es. Je pige !
}
//	<<<ENGLISH>>>
//	-- then target the
//	circuit panel. Got it.

/*それで、室内の電源パネルを破壊すれば
いいんだな。*/
}
//d
//スクリーン内に子画面。リモコンミサイルでクリアする映像を出す。一番難しいコース。



resource P047_05_R01_電撃床前オルガ５無線デモ１＿２__f {
//vc114703
大佐_000: {
Oui, mais t&^ache de ne pas blesser
le Pr&'esident !
}
//	<<<ENGLISH>>>
//	Right. But make sure you
//	don't hit the President.

/*そうだ。ただし大統領には当てるなよ。*/
ライデン_001: {
Le Pr&'esident est truff&'e de nanomachines.
}
//	<<<ENGLISH>>>
//	The President is wired
//	with nanomachines.

//<ページ数変更>
ライデン_001_1: {
Si j'avais sa fr&'equence, je pourrais
le contacter par radio...
}
//	<<<ENGLISH>>>
//	If we know the frequency,
//	I can raise him...

/*大統領にもナノマシンが注入されて
いるんだろう？周波数がわかれば
呼びかけることも出来るが……。*/
大佐_002: {
Nous avons d&'ej&`a essay&'e de le faire
&`a maintes reprises, en vain.
}
//	<<<ENGLISH>>>
//	We've tried that repeatedly,
//	but there's no response.

//<ページ数変更>
大佐_002_1: {
Les murs semblent &^etre pourvus d'un
bouclier int&'egr&'e bloquant les ondes radio...
}
//	<<<ENGLISH>>>
//	It looks like the walls have
//	a built-in radio shield.

/*いや、こちらからも何度かＣＡＬＬして
いるが通じない。そこの壁は通信を
妨害する素材で出来ているようだ。*/
ライデン_003: {
Cela explique pourquoi Ames avait perdu
le contact avec lui...
}
//	<<<ENGLISH>>>
//	So that's why Ames
//	lost contact with him...

/*なるほど。
エイムズが反応を見失ったのは
そのためか……。*/
大佐_004: {
Si tu veux v&'erifier o&`u il se trouve,
tu peux toujours te connecter au n&@eud !
}
//	<<<ENGLISH>>>
//	If you need to confirm his position,
//	you can log into the node.

/*だがノードに接続すれば彼の位置は
確認出来るはずだ。*/
ライデン_005: {
Compris !
}
//	<<<ENGLISH(2)>>>
//	Understood.

/*わかった。*/
大佐_006: {
Trouves d'abord un lance-missiles
t&'el&'ecommand&'e.
}
//	<<<ENGLISH>>>
//	Locate a remote-control
//	missile launcher first.

/*まずはリモコン・ミサイルを探せ。*/
}
//d



resource P049_02_R01_大統領２無線機デモ１＿１__f {
//vc114901
ライデン_000: {
Vous me recevez, Monsieur ?
}
//	<<<ENGLISH>>>
//	Do you read me, sir?

/*聞こえますか？*/
大統領_001: {
Heu... oui.
}
//	<<<ENGLISH(2)>>>
//	Uh... yes.



/*ああ。*/
ライデン_002: {
Mr. Pr&'esident... D'apr&`es ce que j'ai
compris, les terroristes sont parvenus
}
//	<<<ENGLISH>>>
//	Mr. President. It's my understanding
//	that the terrorists have managed to＃−

//<ページ数変更>
ライデン_002_1: {
&`a saisir la s&'equence cod&'ee permettant
de faire une frappe nucl&'eaire...
}
//	<<<ENGLISH>>>
//	input the code sequence necessary
//	for launching a nuclear strike...

/*大統領、テロリスト達は核発射の
コード入力を終了したと……。*/
大統領_003: {
C'est exact ! 
J'ai m&^eme tap&'e cette s&'equence 
moi-m&^eme...
}
//	<<<ENGLISH>>>
//	That's correct. I punched
//	the sequence in myself.

/*……そうだ。私が自分で入力した。*/
ライデン_004: {
Vous travaillez pour eux !?
}
//	<<<ENGLISH>>>
//	You're working for them!?

/*……やはりあなたは奴等と……？*/
大統領_005: {
Il y a deux heures, j'aurais
incontestablement r&'epondu par
l'affirmative.
}
//	<<<ENGLISH>>>
//	If you asked me two hours ago,
//	my answer would have been yes.

//<ページ数変更>
大統領_005_1: {
Pour l'heure, ils me gardent en vie
jusqu'&`a ce que mes signes vitaux
soient reconfirm&'es.
}
//	<<<ENGLISH>>>
//	Right now, they're keeping
//	me alive until my vital signs
//	are reconfirmed.

/*２時間前まではな。
今はヴァイタルＩＤの再確認が
終わるまで生かされているだけの身だ。*/
ライデン_006: {
Ils vous ont trahi ?
}
//	<<<ENGLISH>>>
//	They betrayed you?

/*裏切られた？*/
/* テロ事件対応で一部セリフカット */
大統領_007: {
Ce n'est pas tout &`a fait cela.
}
//	<<<ENGLISH>>>
//	I wouldn't quite put it that way.

/*We had a conflict of ideals... and
I lost.
*/
//<ページ数変更>
大統領_007_1: {
Ce que je voulais, c'&'etait le pouvoir.
Eux, la destruction !
}
//	<<<ENGLISH>>>
//	I wanted power.
//	They sought destruction.

/*いや。私は継承を望み、彼らは破壊を
欲した。思想の違い、といったところ
かな。*/
/* テロ事件対応でカット */
/*
ライデン_008: {
Ideals? What kind of ideals
can justify terrorism!?
}
*/
/*思想？
テロになんの思想があると？*/
/* テロ事件対応でカット */
/*
大統領_009: {
Any movement is driven
by an ideal --
}
*/
/*どんなものにも思想はある。*/
ライデン_010: {
Mais pourquoi vous &^etes-vous abaiss&'e
&`a faire du terrorisme !?
}
//	<<<ENGLISH>>>
//	But why stoop to terrorism!?

/*……なぜテロを？*/
大統領_011: {
Je voulais jouir d'un pouvoir absolu.
}
//	<<<ENGLISH>>>
//	I wanted absolute power.

/*権力に加わるためだ。*/
ライデン_012: {
Mais vous &^etes Pr&'esident...
Vous l'avez, le pouvoir...
}
//	<<<ENGLISH>>>
//	But you're the President --
//	you have power...

/*＃｛大統領、あなた｝＃が権力でしょう？*/
大統領_013: {
Non, je ne suis qu'une figure de proue.
}
//	<<<ENGLISH>>>
//	No. I'm just a figurehead.

/*いや、私は外様だよ。*/
ライデン_014: {
?
}
//	<<<ENGLISH(2)>>>
//	?

/*？*/
大統領_015: {
Je n'ai aucun contr&^ole sur rien.
Le vrai pouvoir, ce sont les Patriotes
qui l'ont...
}
//	<<<ENGLISH>>>
//	I don't have any control.
//	The real power is in the
//	Patriots' hands.

/*私に実権はないのだ。
本当の『権力』は『愛国者達』の
元にある……。*/
ライデン_016: {
Les Patriotes...?
}
//	<<<ENGLISH>>>
//	The Patriots...?

/*『愛国者達』？*/
大統領_017: {
Si vous connaissiez la situation
de ce pays...
}
//	<<<ENGLISH>>>
/*The truth behind this country...
この国の真実だよ。*/
}
//d




resource P049_05_R02_大統領５無線機デモ２＿１__f {
//vc114911
大統領_000: {
Je voulais faire partie des Patriotes et
r&'egner en ma&^itre...
}
//	<<<ENGLISH>>>
//	I wished to be a member
//	of the Patriots.

大統領_001: {
En r&'ealit&'e, je suis la cinqui&`eme
roue du carrosse...
}
//	<<<ENGLISH>>>
//	I wanted to wield the power
//	of a king, instead of being an
//	expendable pawn...

/*私の望みは『愛国者達』の一員となる
こと…*/
/*…彼等の支配構造に加わること
だった。使い捨ての＃｛駒、ポーン｝＃としてではなく。*/
ライデン_002: {
Et c'est cela qui vous permet de justifier
le terrorisme ?
}
//	<<<ENGLISH>>>
//	And that justifies
//	acts of terrorism?

/*それがテロを起こした理由？*/
大統領_003: {
Oui ! Je voulais jouer la carte
du nouveau Metal Gear pour peser
dans la n&'egociation...
}
//	<<<ENGLISH>>>
//	Yes. I'd intended to use
//	the new Metal Gear as a
//	bargaining chip...

/*そうだ。新型メタルギアも、
あくまで取り引き材料として
使うつもりだった……。*/
ライデン_004: {
Jouer la carte du Metal Gear ?
}
//	<<<ENGLISH>>>
//	Bargaining chip?

/*……だった、とは？*/
大統領_005: {
Mais j'ai sous-estim&'e Solidus...
Il est pr&^et &`a tenir t&^ete aux Patriotes,
}
//	<<<ENGLISH>>>
//	But I underestimated Solidus...
//	he actually wants to challenge
//	the Patriots --

//<ページ数変更>
大統領_005_1: {
au risque de faire sauter la plan&`ete 
enti&`ere !
}
//	<<<ENGLISH>>>
//	...even if it means the
//	destruction of the world!

/*私は見くびっていた。ソリダスは……
本気で彼等に闘いを挑もうとしている。
奴は世界を壊すつもりだ。*/
ライデン_006: {
De quoi parlez-vous ?
}
//	<<<ENGLISH(2)>>>
//	What are you saying?

/*どういうことです？*/
大統領_007: {
Qu'on le veuille ou non, l'&'equilibre
des pouvoirs d&'epend du bon vouloir
des Patriotes.
}
//	<<<ENGLISH>>>
//	Whether you believe it or not,
//	the balance of power rests in
//	the hands of the Patriots.

/*君が信じようと信じまいと、
世界の均衡を保っているのは
『愛国者達』なのだよ。*/
大統領_008: {
Ils modulent les int&'er&^ets nationaux
en contr&^olant les apparences
}
//	<<<ENGLISH>>>
//	They regulate the country's
//	various interests through
//	controlled presentation,

//<ページ数変更>
大統領_008_1: {
et en mettant en sc&`ene ce qui est
susceptible de plaire aux masses.
}
//	<<<ENGLISH>>>
//	staging a "drama" that is
//	palatable to the general
//	masses.

/*この国に渦巻く利害を調整し、
結果を分かりやすい『物語』にして
大衆に提供する。*/
大統領_009: {
Mesurez-vous les d&'eg&^ats que provoquerait
leur disparition ?
}
//	<<<ENGLISH>>>
//	Can you imagine what
//	would happen if they
//	ceased to function?

/*その機能が停止すれば、いや、
その存在が公になっただけでどうなる？*/
ライデン_010: {
?
}
//	<<<ENGLISH(2)>>>
//	?

/*？*/
大統領_011: {
Ils laisseraient une b&'eance politique
}
//	<<<ENGLISH>>>
//	Picture a massive
//	political vacuum,

大統領_012: {
dans laquelle ne s'engouffrer aient un tas
de gens avides de pouvoir.
}
//	<<<ENGLISH>>>
//	a space that every power-
//	monger will try to fill for
//	their own greedy ends.

/*巨大な政治的真空が生まれる。
その空位を貪欲なブタどもが
見逃すはずがない。*/
大統領_013: {
On assisterait &`a une lutte anarchique...
Ce serait la panique, la guerre civile,
le chaos...
}
//	<<<ENGLISH>>>
//	I'm talking about an unregulated
//	power struggle -- panic, civil
//	war... chaos.

/*すぐさま共食いが始まるだろう。
世界中であらゆるタガが外れる。
紛争、内戦、恐慌……
誰も制御することはできない……。
*/
大統領_014: {
Qu'on le veuille ou non, il faut tout faire
pour p&'erenniser l'existence des Patriotes.
}
//	<<<ENGLISH>>>
//	Like it or not -- the Patriots
//	is an organization that must
//	continue to exist.

/*彼等は闘ってはいけない相手なのだ。*/
ライデン_015: {
Si je comprends bien, vous avez chang&'e
d'avis pour &'eviter au monde entier
de sombrer dans le chaos !
}
//	<<<ENGLISH>>>
//	So you changed your mind because
//	you wanted to avoid global chaos?

/*……世界を混乱させるのはあなたの
本意ではないと？*/
大統領_016: {
Exactement !
}
//	<<<ENGLISH(2)>>>
//	Exactly.
//<ページ数変更>
大統領_016_1: {
Quand j'ai dit &`a Solidus que je ferais
tout pour &'eviter le pire,
}
//	<<<ENGLISH>>>
//	When I told Solidus that
//	I wished to prevent disaster,

/*……そうだ。
私には破滅を望むことが出来なかった。
だが奴は言ったよ。
*/
大統領_017: {
il m'a r&'epondu que les pions restaient
des pions &`a vie...
}
//	<<<ENGLISH>>>
//	he replied that pawns can
//	never become players...

/*それが私の限界だ、とな。*/
ライデン_018: {
Et qui est donc ce... Solidus ?
}
//	<<<ENGLISH>>>
//	And who is this... Solidus?

/*……ソリダスとは、一体何者なんです？*/
}
//d




resource P049_08_R03_大統領８無線機デモ３＿１__f {
//vc114921
ライデン_000: {
Je croyais qu'il avait d&'emissionn&'e...
}
//	<<<ENGLISH(2)>>>
//	I thought he resigned...

/*辞任ではなかったのですか？*/
大統領_001: {
C'est la version officielle.
}
//	<<<ENGLISH>>>
//	That's the story given
//	to the general public.

//<ページ数変更>
大統領_001_1: {
Apr&`es sa 'd&'emission', les Patriotes m'ont
appel&'e pour la pr&'esidence. Je devins ainsi
leur nouveau pion...
}
//	<<<ENGLISH(2)>>>
//	Following his "resignation," the
//	Patriots selected me -- their
//	new pawn, for the Presidency.

/*公にはな。
そしてその後任の＃｛駒、ポーン｝＃に選ばれたのが
私というわけだ。*/
ライデン_002: {
Alors la course pr&'esidentielle &'etait...
}
//	<<<ENGLISH>>>
//	But that would mean that the
//	Presidential race was --

/*あなたの選挙戦は……？*/
大統領_003: {
C'&'etait bien orchestr&'e, n'est-ce pas ?
}
//	<<<ENGLISH>>>
//	That was quite a show,
//	wasn't it?

//<ページ数変更>
大統領_003_1: {
Le sc&'enario parfaitement huil&'e des
Patriotes avait tout pour plaire au public.
}
//	<<<ENGLISH>>>
//	It was a well-scripted drama
//	staged by the Patriots for the
//	benefit of the public.

/*おもしろいショーだっただろう？
大衆を満足させるためのイベントも
多く盛り込んであった。*/
大統領_004: {
D&'emocrates et R&'epublicains eux-m&^emes
n'ont pas jou&'e une seule fausse note.
}
//	<<<ENGLISH>>>
//	Even the Democrats and
//	Republicans were dancing
//	to the Patriots' tune.

//<ページ数変更>
大統領_004_1: {
Tout a march&'e comme sur des roulettes,
&`a une exception pr&`es...
}
//	<<<ENGLISH>>>
//	Everything went according to
//	plan, but for one exception...

/*民主党も共和党も『愛国者達』の意図に
沿って踊っただけだ。全て彼等の筋書き
通り……しかし予定外の出来事もあった。*/
ライデン_005: {
?
}
//	<<<ENGLISH(2)>>>
//	?

/*？*/
大統領_006: {
Apr&`es sa d&'emission, il &'etait pr&'evu que
Solidus conna&^itrait des ennuis de sant&'e
avant de mourir pr&'ematur&'ement...
}
//	<<<ENGLISH>>>
//	Following his resignation, Solidus'
//	health was scheduled to fail him,
//	bringing about his untimely death.

/*ソリダスは辞任後、病死するはずだった。*/
ライデン_007: {
Ils voulaient le supprimer ?
}
//	<<<ENGLISH>>>
//	Capped...?


/*暗殺か！？*/
大統領_008: {
Exact ! Mais avant que les Patriotes
aient le temps d'ex&'ecute leur plan,
}
//	<<<ENGLISH>>>
//	Correct. But before the Patriots
//	could execute their plot,

//<ページ数変更>
大統領_008_1: {
Solidus s'et enfui gr&^ace &`a l'aide d'Ocelot.
}
//	<<<ENGLISH>>>
//	Solidus went underground
//	with the help of Ocelot.

/*そうだ。だが奴はオセロットの
手を借り地下に潜伏した。*/
大統領_009: {
Pendant sa cavale,
il a pris le contr&^ole de la Dead Cell
}
//	<<<ENGLISH>>>
//	As he avoided pursuit, Solidus
//	gained control of Dead Cell,

//<ページ数変更>
大統領_009_1: {
et gagn&'e &`a cause de gang du
Colonel Gurlukovich.
}
//	<<<ENGLISH>>>
//	winning over Colonel
//	Gurlukovich's outfit.

//<ページ数変更>
大統領_009_2: {
L&`a, il a temporis&'e en sachant que sa
chance de reprendre le dessus reviendrait
vite...
}
//	<<<ENGLISH>>>
//	From there, he bided his time,
//	knowing that his opportunity
//	would soon arrive...

/*そして『愛国者達』の追撃をかわしながら、デッドセルを手なずけ、ゴルルコ
ビッチ大佐の部隊を懐柔し、時を待った。*/
ライデン_010: {
Sa chance ?
}
//	<<<ENGLISH>>>
//	What opportunity?

/*時？*/
大統領_011: {
Sa chance de boucler le projet
du nouveau Metal Gear.
}
//	<<<ENGLISH>>>
//	The completion of the new
//	Metal Gear project --

//<ページ数変更>
大統領_011_1: {
Cette entreprise lui permettrait
de damer le pion aux Patriotes.
}
//	<<<ENGLISH>>>
//	an opportunity that would even
//	his odds against the Patriots.

/*『愛国者達』と対等に渡り合う機会……
新型メタルギアの完成だ。*/
大統領_012: {
En volant le projet le plus pris&'e
des Patriotes,
}
//	<<<ENGLISH>>>
//	By stealing the Patriots'
//	most valued project,

//<ページ数変更>
大統領_012_1: {
il les placerait dans une position
fort inconfortable...
}
//	<<<ENGLISH>>>
//	he would be able to place them
//	in a very uncomfortable position.

/*『愛国者達』が全精力を傾けている
最重要プロジェクトを奪えば彼等の
急所を抑えることが出来る。*/
大統領_013: {
C'est sa seule porte de sortie...
}
//	<<<ENGLISH>>>
//	It's the only chance
//	he has for survival.

/*それが彼等に対抗出来る唯一の
手段だった。*/
大統領_014: {
D&`es qu'il aura mis la main sur le nouveau
Metal Gear, il d&'eclarera la guerre aux
Patriotes.
}
//	<<<ENGLISH>>>
//	Once he has the new Metal Gear,
//	he'll declare war against the
//	Patriots.

//<ページ数変更>
大統領_014_1: {
Il faut l'en emp&^echer...
}
//	<<<ENGLISH>>>
//	Needless to say,
//	he must be stopped.

/*アレが手に入り次第、奴は戦争を始める
だろう。そうなる前に奴を止めねば
ならん。*/
ライデン_015: {
Le Metal Gear est d&'ej&`a op&'erationnel...
}
//	<<<ENGLISH>>>
//	Metal Gear is already
//	operational...
//	

/*メタルギアはもう起動してしまった……。*/
大統領_016: {
Pas encore.
}
//	<<<ENGLISH>>>
//	No. Not yet.

/*いや、まだだ。*/
ライデン_017: {
?
}
//	<<<ENGLISH(2)>>>
//	?

/*？*/
大統領_018: {
L'engin que vous avez vu est
le Metal Gear RAY --
}
//	<<<ENGLISH>>>
//	What you saw was
//	Metal Gear RAY --

/*君が見たのはメタルギアＲＡＹ。*/
大統領_019: {
vol&'e aux marines par Ocelot,
il y a deux ans. Ce n' &'etait
pas le nouveau Metal Gear.
}
//	<<<ENGLISH>>>
//	-- hijacked two years ago from
//	the Marines by Ocelot. That was
//	not the new Metal Gear.

/*二年前にオセロットが海兵隊から
奪ったものだ。新型メタルギアではない。*/
ライデン_019: {
Dans ce cas, o&`u se trouve le nouveau ?
}
//	<<<ENGLISH>>>
//	Then, where's the
//	new Metal Gear?

/*では新型メタルギアとは？*/
大統領_020: {
Juste ici.
}
//	<<<ENGLISH(2)>>>
//	Right here.

/*ここだ。*/
ライデン_021: {
Quoi ?
}
//	<<<ENGLISH(2)>>>
//	What?

/*え？*/
大統領_022: {
Vous marchez dessus ! Pour &^etre
plus pr&'ecis, la Big Shell constitue
le nouveau Metal Gear.
}
//	<<<ENGLISH>>>
//	You're standing in it. To be more
//	precise, this entire "Big Shell"
//	facility is the new Metal Gear.

/*この『ビッグ・シェル』全体が
新型メタルギアなのだ。*/
ライデン_023: {
Tu d&'econnes ou quoi ?
}
//	<<<ENGLISH>>>
//	What'd you say?

/*なんだって！！*/
大統領_024: {
Je suis tout &`a fait s&'erieux. La structure
sup&'erieure que vous avez aper&~que est
en fait un camouflage
}
//	<<<ENGLISH(2)>>>
//	No. I'm quite serious. The
//	upper structure that you've
//	seen is camouflage＃−

//<ページ数変更>
大統領_024_1: {
pour repr&'esenter un site de nettoyage
offshore.
}
//	<<<ENGLISH(2)>>>
//	designed to represent an
//	offshore cleanup facility.

//<ページ数変更>
大統領_024_2: {
La structure principale s'&'etend
des fondations jusqu'au fond marin. 
}
//	<<<ENGLISH(2)>>>
//	The main structure extends from
//	the foundation all the way down
//	to the ocean floor.

/*君が見てきた上部構造は偽装だ。
海洋除染施設の体裁を整えるためのな。
本体は基底部から海底に建造されている。
*/
大統領_025: {
L'ascenseur de connexion se trouve
&`a l'&'etage B2 du noyau de la Shell 1.
}
//	<<<ENGLISH>>>
//	The connecting elevator is located
//	on the B2 floor of the Shell 1 Core.

/*連絡エレベータは
シェル１中央棟のＢ２だ。*/
大統領_026: {
Le nom de code du nouveau Metal Gear
est Arsenal Gear...
}
//	<<<ENGLISH(2)>>>
//	Arsenal Gear... that's the code
//	name for the new Metal Gear.

/*＃｛火薬庫、アーセナル｝＃ギア。それが
新型メタルギアのコードネーム……。*/
ライデン_027: {
Arsenal ?
}
//	<<<ENGLISH>>>
//	Arsenal?

/*アーセナル？*/
}
//d



resource P049_10_R04_大統領１０無線機デモ４＿１__f {
//vc114931
大統領_000: {
Cet appareil pr&'eserve le monde en l'&'etat
et &'etablit une nouvelle forme de contr&^ole.
}
//	<<<ENGLISH>>>
//	It is a means to preserve the
//	world as it is. It will establish
//	a new form of control.

/*世界を保全するための手段。
新しい支配の確立。*/
大統領_001: {
Les Patriotes l'utiliseront pour conserver
leur vrai r&^ole : celui de dirigeants.
}
//	<<<ENGLISH>>>
//	The Patriots will use it to keep
//	their place as the country's true
//	rulers.

/*『愛国者達』がこの国の真実で
ありつづけるための要なのだ。*/
大統領_002: {
Mais &`a pr&'esent, ils subissent un certain
nombre de pressions et de menaces..
}
//	<<<ENGLISH>>>
//	...Right now they feel
//	pressured and threatened.


/*……彼等は今、支配を脅かされ、
焦っている。*/
ライデン_003: {
Pourquoi 
}
//	<<<ENGLISH>>>
//	By what?

/*何からです？*/
大統領_004: {
Ils redoutent la surabondance
des donn&'ees num&'eriques.
}
//	<<<ENGLISH>>>
//	They fear an overabundance
//	of digital information --

//<ページ数変更>
大統領_004_1: {
D'apr&`es eux, le monde va couler sous
le flot d'informations et ils craignent d'&^etre
entra&^in&'es avec.
}
//	<<<ENGLISH>>>
//	the world will drown in the
//	coming flood of information,
//	and they along with it.

/*……デジタルによる真実の氾濫、
世界の窒息……といったところかな。*/
ライデン_005: {
?
}
//	<<<ENGLISH>>>
//	?

/*？*/
大統領_006: {
Dans les plans de l'Arsenal, il est pr&'evu
de cr&'eer un syst&`eme num&'erique de gestion
des informations.
}
//	<<<ENGLISH>>>
//	The Arsenal plans include a
//	system to digitally manage
//	the flow of information,

/*それを逆にデジタルによってつなぎとめるためのメソッド。
*/
大統領_007: {
Cette m&'ethode permettrait aux Patriotes
de modeler la 'v&'erit&'e' &`a leur guise.
}
//	<<<ENGLISH>>>
//	making it possible to shape the
//	"truth" for their own purposes.

//<ページ数変更>
大統領_007_1: {
En d'autres termes, le syst&`eme de
l'Arsenal est la clef de leur supr&'ematie.
}
//	<<<ENGLISH>>>
//	In short, the Arsenal's system
//	is the key to their supremacy.

/*それを具現化するためのシステムが
アーセナルに搭載されている。
それこそがアーセナルの本質なのだ。*/
ライデン_008: {
La clef de leur supr&'ematie ?
}
//	<<<ENGLISH(2)>>>
//	The key...?

/*本質？*/
大統領_009: {
Tout &`a fait... Le syst&`eme 'GW'
est la carte ma&^itresse des Patriotes.
}
//	<<<ENGLISH(2)>>>
//	Yes, the "GW" system is
//	the Patriots' trump card.

/*『Ｇ．Ｗ』。それはそう呼ばれている。『愛国者達』の切り札。*/
大統領_010: {
D&`es qu'il aura &'et&'e int&'egr&'e avec succ&`es,
}
//	<<<ENGLISH>>>
//	Arsenal Gear will be fully
//	operational when "GW" is
//	successfully integrated.

//<ページ数変更>
大統領_010_1: {
l'Arsenal Gear sera enti&`erement
op&'erationnel et fournira une nouvelle
forme de pouvoir aux Patriotes.
}
//	<<<ENGLISH>>>
//	Once operational, it will be
//	a completely new form of
//	power for the Patriots to wield.

/*『Ｇ．Ｗ』とアーセナルギアの完成は
すなわち『愛国者達』による新しい
支配の完成を意味する。*/
大統領_011: {
J'esp&'erais leur voler leur projet afin d'&^etre
en position de force pour n&'egocier...
}
//	<<<ENGLISH>>>
//	I had hoped to seize the project
//	from them so that I would be in
//	a strong bargaining position...

/*それを奪えば彼等と対等な立場に立てる
はずだった。対等な取り引きもな……。*/
ライデン_012: {
Pour n&'egocier quoi ?
}
//	<<<ENGLISH>>>
//	Bargain for what?

/*取り引き？
だが奴は……。*/
大統領_013: {
J'esp&'erais me glisser dans leurs rangs,
mais Solidus s'est rebell&'e.
}
//	<<<ENGLISH>>>
//	I'd hoped to trade my way
//	into their ranks. But Solidus
//	preferred rebellion.

/*そう。
ソリダスは取り引きではなく
闘争を望んだ。*/
大統領_014: {
Outer Heaven -- son plan visant &`a
une explosion nucl&'eaire sur Wall Street
}
//	<<<ENGLISH>>>
//	Outer Heaven -- his plan to
//	unleash a nuclear blast over
//	the skies of Wall Street＃−

//<ページ数変更>
大統領_014_1: {
pour casser l'emprise des Patriotes
le monde des affaires --
}
//	<<<ENGLISH(2)>>>
//	to break the Patriots' control
//	over the business community --

/*奴がやろうとしているウォール街
上空への核攻撃も、彼等の支配を
断ち切り解放区を形成するためだ。
*/
大統領_015: {
constituent &'egalement la base
de son attaque.
}
//	<<<ENGLISH>>>
//	is also a key factor
//	in his offensive effort.

/*……奴はそれを
ＯＵＴＥＲ　ＨＥＡＶＥＮと呼んでいた……。*/
ライデン_016: {
Outer Heaven...?
}
//	<<<ENGLISH>>>
//	Outer Heaven...?

/*ＯＵＴＥＲ　ＨＥＡＶＥＮ……？*/
大統領_017: {
Ecoutez... Nous n'avons pas beaucoup
de temps. La mallette noire a permis
d'activer l'Arsenal Gear
}
//	<<<ENGLISH>>>
//	Listen. There isn't much time.
//	The "football" served as the key
//	for activating Arsenal Gear.

//<ページ数変更>
大統領_017_1: {
et j'ai d&'ej&`a saisi la s&'equence
cod&'ee requise...
}
//	<<<ENGLISH>>>
//	I've already input the necessary
//	code sequence...

/*もう時間がない。アーセナルギア起動の
鍵はブラックケースが兼ねていたが……
私が入力してしまった。*/
大統領_018: {
Dans peu de temps, le syst&`eme 'GW'
commencera &`a se connecter &`a d'autres
syst&`emes externes
}
//	<<<ENGLISH>>>
//	It won't be long before "GW" begins
//	to establish connections with other
//	external systems＃−

//<ページ数変更>
大統領_018_1: {
et l'Arsenal Gear sera op&'erationnel.
}
//	<<<ENGLISH>>>
//	and Arsenal Gear becomes
//	fully operational.

/*じきに『Ｇ．Ｗ』は外部と接続を開始し、
アーセナルギアの機関部も始動する。*/
大統領_019: {
Votre r&^ole est d'arr&^eter tout cela &`a temps...
}
//	<<<ENGLISH>>>
//	Stop them before that
//	happens. That is your
//	role.

/*そうなる前に奴を止めろ。
それが君の役割だ。*/
ライデン_020: {
Mon r&^ole ?
}
//	<<<ENGLISH(2)>>>
//	Role?

/*役割……？*/
大統領_021: {
Vous devez trouver Emma Emmerich.
Il n'y a qu'elle qui sache arr&^eter ce truc
apr&`es son activation !
}
//	<<<ENGLISH>>>
//	You've got to find Emma Emmerich.
//	She's the only one who can stop that
//	thing once it's been activated.

/*動き出したあれを止められるのは
エマ・エメリッヒしかいない。
彼女を探せ。*/
ライデン_022: {
Emma... Emmerich ?
}
//	<<<ENGLISH>>>
//	Emma -- Emmerich?

/*エマ……エメリッヒ？*/
大統領_023: {
Elle a programm&'e le syst&`eme
de l'Arsenal Gear.
}
//	<<<ENGLISH>>>
//	She's the system programmer
//	for Arsenal Gear.

//<ページ数変更>
大統領_023_1: {
Je crois qu'elle se trouve au niveau B1,
dans le noyau de ce b&^atiment.
}
//	<<<ENGLISH>>>
//	I believe she's somewhere on level
//	B1 in the core of this building.

/*アーセナルギアのシステム・
プログラマだ。この中央棟のＢ１で
監禁されているはず。*/
ライデン_024: {
Mais je croyais que les niveaux situ&'es
au-dessous de nous &'etaient inond&'es !
}
//	<<<ENGLISH>>>
//	I thought the levels
//	below us were flooded?

/*この下は浸水しているのでは？*/
大統領_025: {
C'est la seule programmeuse du projet
qui leur reste, je suis s&^ur qu'ils vont
s'arranger pour la garder en vie, du moins
pour l'instant.
}
//	<<<ENGLISH>>>
//	I'm sure they won't let her die just
//	yet as she's the only remaining
//	programmer for this project.

/*いや、彼女はまだ生かされている。
残っているプログラマは彼女だけだ。
*/
大統領_026: {
D'apr&`es Ocelot, elle est d&'etenue
dans un vestiaire de la partie
nord-ouest du niveau B1.
}
//	<<<ENGLISH>>>
//	According to Ocelot, she was being
//	held in a locker room located in the
//	northwest part of level B1.

/*オセロットが言っていた……
Ｂ１の北西にあるロッカールームだ。*/
大統領_027: {
Mettez fin &`a la transmission
et bougez-vous !
}
//	<<<ENGLISH>>>
//	Cut transmission, and get moving!

/*急げ！
通信をとくぞ。*/
}
//d




resource P049_12_R05_大統領１２無線機デモ５＿１__f {
//vc114941
ライデン_000: {
Colonel, le Pr&'esident est mort.
}
//	<<<ENGLISH>>>
//	Colonel, the President is dead.

/*大佐、大統領が死んだ……。*/
大佐_001: {
Je vois... Je suis d&'esol&'e de l'apprendre.
}
//	<<<ENGLISH>>>
//	I see... I'm sorry to hear that.

/*ああ……残念なことだ……。*/
ライデン_002: {
Qu'allons-nous faire, &`a pr&'esent ?
}
//	<<<ENGLISH>>>
//	Where do we go from here?

/*俺はこれからどうすれば？*/
大佐_003: {
Ta mission &'etait de sauver le Pr&'esident
et de contrer la menace terroriste. 
}
//	<<<ENGLISH>>>
//	Your mission was to rescue
//	the President and eliminate
//	the terrorist threat.

/*君の目的は大統領の救出とテロリストの武装解除だった……*/
大佐_004: {
En raison des r&'ecents d&'eveloppements,
nous allons nous conformer aux derni&`eres
directives du Pr&'esident.
}
//	<<<ENGLISH>>>
//	However, given the recent
//	turn of events, we will honor
//	the President's last directive.

//<ページ数変更>
大佐_004_1: {
Tu dois en finir de l'Arsenal Gear.
}
//	<<<ENGLISH>>>
//	You must put a stop to Arsenal
//	Gear once and for all.

/*だが今からは、大統領の最後の命令を
果たすことが君の任務となる。
……ライデン、アーセナルギアを止めろ。*/
ライデン_005: {
Est-ce que tu crois &`a l'histoire du
Pr&'esident, &`a savoir
}
//	<<<ENGLISH>>>
//	Do you actually think there's
//	any truth to his story＃−

//<ページ数変更>
ライデン_005_1: {
que la "Big Shell" servirait &`a camoufler
l'avant de l'Arsenal Gear ?
}
//	<<<ENGLISH>>>
//	about this "Big Shell" facility
//	being a front for Arsenal Gear?

/*この『ビッグ・シェル』全体が
メタルギアだという話を信じろと？*/
大佐_006: {
Je n'ai pas le niveau de s&'ecurit&'e suffisant
pour v&'erifier ces dires.
}
//	<<<ENGLISH>>>
//	I don't have the security clearance
//	necessary to verify the facts.

//<ページ数変更>
大佐_006_1: {
N'oublions pas qu'il &'etait Pr&'esident.
Je suis s&^ur qu'il connaissait parfaitement
ses dossiers.
}
//	<<<ENGLISH>>>
//	However, he was the President.
//	I'm sure he knew what he was
//	talking about.

/*私のセキュリティ・クリアランスでは
確認することは出来なかったが……
大統領本人の言葉だ。間違いないだろう。*/
ライデン_007: {
Tu oublies son implication dans le complot
des terroristes !
}
//	<<<ENGLISH>>>
//	Aren't you forgetting that he
//	was part of the terrorist plot?

/*彼自身がテロに荷担していたとしても？*/
大佐_008: {
Raison de plus pour croire ce qu'il dit !
}
//	<<<ENGLISH>>>
//	All the more reason why I believe
//	his information is reliable.

/*だからこそ、信憑性が高いとも言える。*/
ライデン_009: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
大佐_010: {
Cet homme a tout de m&^eme pr&'ef&'er&'e mourir
plut&^ot que de risquer une catastrophe
nucl&'eaire !
}
//	<<<ENGLISH>>>
//	We're talking about a man who
//	chose to die rather than risk a
//	nuclear holocaust.

/*それに大統領は君に自分を殺すよう頼み
すらした。核発射を無効にするために。*/
大佐_011: {
Gr&^ace &`a son sacrifice, le bouton nucl&'eaire
a &'et&'e confi&'e au Vice-Pr&'esident
}
//	<<<ENGLISH>>>
//	Thanks to his sacrifice, the nuclear
//	launch authority has shifted to the
//	Vice President,

//<ページ数変更>
大佐_011_1: {
et la menace terroriste a &'et&'e balay&'ee.
}
//	<<<ENGLISH>>>
//	effectively eliminating
//	the terrorist threat.

/*彼が死んだお陰で核兵器の行使権限は
副大統領に移った。
これで奴等の核兵器はただの飾りに……。*/
ライデン_012: {
Colonel, vu sous cet angle,
}
//	<<<ENGLISH>>>
//	Colonel, when you
//	put it like that,

//<ページ数変更>
ライデン_012_1: {
j'ai l'impression que j'aurais d&^u assassiner
le Pr&'esident, pour balayer, cette 'menace
terroriste' !
}
//	<<<ENGLISH>>>
//	it almost sounds like I should've
//	assassinated the President to
//	"eliminate the threat."

/*大佐、
俺が大統領を殺すべきだったとでも？*/
大佐_013: {
Je me suis mal exprim&'e !
}
//	<<<ENGLISH>>>
//	That was not my intention.

//<ページ数変更>
大佐_013_1: {
Ce que je voulais dire, c'est que
le comportement de cet homme --
}
//	<<<ENGLISH>>>
//	I was trying to point out that there
//	is certainly some credibility to the
//	words of a man＃−

//<ページ数変更>
大佐_013_2: {
qui a choisi de mourir pour prot&'eger
les innocents -- donne du cr&'edit &`a ses 
paroles !
}
//	<<<ENGLISH>>>
//	who chose death to protect
//	the innocent.

/*そうではない。彼の言葉は信用して
いいのではないかと言いたいのだ。*/
ローズ_014: {
Le Colonel n'a pas tort, Jack !
}
//	<<<ENGLISH>>>
//	The Colonel has a point, Jack.

/*ジャック、私もそう思う……。*/
ライデン_015: {
Et que penses-tu des r&'ev&'elations
sur les 'Patriotes' ?
}
//	<<<ENGLISH>>>
//	What about the information
//	he gave me on the "Patriots"?

/*……『愛国者達』とかいう連中に
ついての話も信じろと？*/
大佐_016: {
Je n'&'etais au courant de rien !
Je vais essayer de tirer &~qa au clair.
}
//	<<<ENGLISH>>>
//	That's a new one on me.
//	I'll see what I can find out.

/*それについては初耳だ。
調査する。*/
ライデン_017: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
大佐_018: {
Raiden, tu n'as plus beaucoup de temps.
}
//	<<<ENGLISH>>>
//	Raiden, we're running out of time.

//<ページ数変更>
大佐_018_1: {
Pars &`a la recherche d'Emma. Elle est
cens&'ee &^etre au niveau B1, au c&@eur du
b&^atiment o&`u tu te trouves ?
}
//	<<<ENGLISH>>>
//	Find Emma. She's supposed to be
//	located on level B1, in the core of
//	that building you're in, right?

/*ライデン、時間がないぞ。
エマを探し出すんだ。
彼女はその中央棟のＢ１だろう？*/
ライデン_019: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
大佐_020: {
T&^ache de la trouver avant que l'Arsenal
soit op&'erationnel !
}
//	<<<ENGLISH>>>
//	You've got to find her before
//	Arsenal becomes fully operational.

/*アーセナルが動き出す前に彼女を
見つけ出すんだ！*/
ローズ_021: {
D&'ep&^eche-toi, Jack !
}
//	<<<ENGLISH>>>
//	Hurry Jack!

/*急いで、ジャック！*/
ライデン_022: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
大佐_023: {
Fais en sorte que le sacrifice du Pr&'esident
n'ait pas &'et&'e enti&`erement vain !
}
//	<<<ENGLISH>>>
//	It's up to you to make sure
//	that the President didn't
//	sacrifice his life in vain.

/*大統領の死を無駄にする気か！？*/
ライデン_024: {
Compris... Termin&'e !
}
//	<<<ENGLISH>>>
//	Understood....
//	Raiden out.

/*……了解。*/
}
//d



resource P050_01_R01_タンカー編整理１無線機デモ１＿１__f {
//vc115001
プリスキン_000: {
Quelle est ta situation, Raiden ?
}
//	<<<ENGLISH>>>
//	What's your status, Raiden?

/*ライデン、そっちはどうだっ！*/
ライデン_001: {
Snake ? Le Pr&'esident...
Il a &'et&'e assassin&'e !
}
//	<<<ENGLISH>>>
//	Snake? The President...
//	he's been assassinated.

/*スネーク？
……大統領が殺された！*/
プリスキン_002: {
Quoi !?
}
//	<<<ENGLISH(2)>>>
//	What!?

/*なんだって？*/
ライデン_003: {
Je n'ai rien pu faire...
}
//	<<<ENGLISH>>>
//	There was nothing I could do --

/*すまない。*/
プリスキン_004: {
Et le code permettant de faire
une frappe nucl&'eaire ?
}
//	<<<ENGLISH>>>
//	What about the nuclear
//	strike code sequence!?

/*核発射コードの再確認はすんでいたのか？*/
ライデン_005: {
Il est mort avant que son identit&'e
corporelle ait pu &^etre reconfirm&'ee...
}
//	<<<ENGLISH>>>
//	He died before his vital ID
//	could be reconfirmed.

/*いや、最終のヴァイタルＩＤチェックの
前だった。*/
プリスキン_006: {
L'ennemi a donc perdu sa capacit&'e
de faire des frappes nucl&'eaires...
}
//	<<<ENGLISH>>>
//	Then the enemy's lost their
//	nuclear strike capability --

/*ということは、奴らは核を撃てなく
なったわけだな。*/
ライデン_007: {
Mais il est &'evident que cet Ocelot
a tu&'e le Pr&'esident sciemment...
}
//	<<<ENGLISH>>>
//	But, that Ocelot guy obviously
//	killed the President on purpose.

/*だが、あの男、オセロットは明らかに
わざと大統領を殺した。*/
プリスキン_008: {
Mais pourquoi ?
}
//	<<<ENGLISH(2)>>>
//	Why?

/*どういうことだ？*/
ライデン_009: {
C'est ce qui ne colle pas, justement.
}
//	<<<ENGLISH>>>
//	It doesn't make any sense.

//<ページ数変更>
ライデン_009_1: {
Ils savaient certainement qu'en tuant
le Pr&'esident, ils ne pourraient plus lancer
d'ogives nucl&'eaires...
}
//	<<<ENGLISH>>>
//	They had to know that they
//	couldn't launch the nuke if
//	they killed the President.

/*わからない。大統領が死ねば核が
撃てなくなることは奴等も知っていた
はずだ。*/
オタコン_010: {
Il existe peut-&^etre un moyen de faire
un lancement sans avoir &`a reconfirmer
les signes vitaux ?
}
//	<<<ENGLISH>>>
//	Maybe there's a way to launch
//	without reconfirming the vital ID?

/*ヴァイタルＩＤチェックを回避して
核を撃つ方法がある？*/
プリスキン_011: {
Il se peut aussi qu'ils aient trouv&'e
une arme plus efficace au sein
de l'Arsenal Gear...
}
//	<<<ENGLISH>>>
//	Or maybe they've found a more
//	effective weapon within Arsenal
//	Gear.

/*あるいは核以上の何かがあるということ
だろうな……アーセナルギアには。*/
ライデン_012: {
Tu &'etais au courant de l'existence
de l'Arsenal Gear !?
}
//	<<<ENGLISH>>>
//	You knew about Arsenal Gear!?

/*知っていたのか？アーセナルギアのこと？*/
プリスキン_013: {
Ben, ouais...
}
//	<<<ENGLISH>>>
//	Yeah...

/*ああ。*/
ライデン_014: {
Pourquoi ne m'en as-tu pas parl&'e, alors !?
}
//	<<<ENGLISH>>>
//	Why didn't you
//	tell me about it!?

/*……なぜ教えてくれなかった？*/
プリスキン_015: {
Tu ne me l'as jamais demand&'e !
}
//	<<<ENGLISH(2)>>>
//	You never asked.

/*聞かれなかったからな。*/
ライデン_016: {
Dans ce cas, tu dois &'egalement savoir que
la Big Shell sert &`a camoufler le projet, 
non !?
}
//	<<<ENGLISH>>>
//	Am I correct in assuming you
//	also know that the Big Shell's
//	a front for the project!?

/*……『ビッグ・シェル』が偽装だという
ことも？*/
プリスキン_017: {
Tu te demandes si je sais que la Big Shell,
}
//	<<<ENGLISH>>>
//	You mean, did I know
//	that the Big Shell,

//<ページ数変更>
プリスキン_017_1: {
qui est un dispositif de nettoyage de
l'environnement enti&`erement op&'erationnel,
sert uniquement &`a camoufler l'Arsenal
Gear ?
}
//	<<<ENGLISH>>>
//	a fully functional environmental
//	cleanup facility, was designed to
//	camouflage Arsenal Gear?

/*ああ。この『ビッグ・シェル』は一応、
海洋除染施設の体裁を整えてはいる。
*/
プリスキン_018: {
Oui, je le sais !
}
//	<<<ENGLISH>>>
//	Yeah, I did.

プリスキン_018_1: {
C'est exactement ce que m'ont dit
le Pr&'esident et Ames... C'est une
longue histoire de leurre...
}
//	<<<ENGLISH>>>
//	It's exactly what the President
//	and Ames described... a massive
//	cover story.

/*だがエイムズや大統領の言った通り、
それは偽装だった。*/
プリスキン_019: {
La bonne nouvelle, c'est que cette
structure n'a pas beaucoup nettoy&'e
l'environnement,
}
//	<<<ENGLISH>>>
//	The good news is that it hasn't
//	really done much in terms of
//	cleaning up the environment,

//<ページ数変更>
プリスキン_019_1: {
nous n'aurons donc pas &`a nous pr&'eoccuper
des gaz toxiques au cas o&`u nous devrions
tout faire sauter !
}
//	<<<ENGLISH>>>
//	so we won't have to worry about
//	any toxic gas being released if
//	we have to blow the house down.

/*海水除染は申し訳程度にしか行われて
いないし、破壊されても有毒化学物質
など発生しないだろう……。*/
ライデン_020: {
Bien... Dans ce cas, je te la passe.
}
//	<<<ENGLISH(2)>>>
//	Right... and when did
//	you find out about all
//	of this?

/*……いつからそれを？*/
プリスキン_021: {
&~Qa a pris du temps, on a d&'ecouvert le pot
aux roses au moment o&`u tu as r&'egl&'e son
compte au poseur de bombes fou...
}
//	<<<ENGLISH>>>
//	It took a while, but we uncovered
//	the info around the time you took
//	out that mad bomber.

/*確かめるには時間がかかった。
調べがついたのはお前があの爆弾魔を
処理した後くらいだな。*/
ライデン_022: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
プリスキン_023: {
L'Arsenal Gear est forc&'ement fabriqu&'e ici...
}
//	<<<ENGLISH>>>
//	There's no doubt that Arsenal
//	Gear is being built here...

/*アーセナルギアがここで建造されて
いるのは確かだ。
*/
プリスキン_024: {
Et l'ensemble de ce projet a &'et&'e mis
en place il y a deux ans -- c'est &`a ce
moment-l&`a que tout a &'et&'e orchestr&'e...
}
//	<<<ENGLISH>>>
//	then it was all set up two years
//	ago on that day -- all of it.

/*おそらく二年前のあの時から
仕組まれていたんだろう……
全てがな……。*/
ライデン_025: {
Il y a deux ans ?
Que s'est-il vraiment pass&'e ici ?
}
//	<<<ENGLISH>>>
//	Two years ago...
//	What really happened here?

/*二年前……
この場所で本当は何があったんだ？*/
}
//d




resource P050_04_R02_タンカー編整理４無線機デモ２＿１__f {
//vc115011
ライデン_000: {
Comment es-tu parvenu &`a quitter
le bateau ?
}
//	<<<ENGLISH>>>
//	How did you manage to get out?

/*よく無事だったな？*/
プリスキン_001: {
Otacon s'&'etait arrang&'e
pour me pr&'eparer un petit bateau.
}
//	<<<ENGLISH>>>
//	Otacon managed to have
//	a small boat ready for me.

/*オタコンが小型艇を用意してくれていた。*/
オタコン_002: {
L'embarquement n'a pos&'e aucun probl&`eme,
}
//	<<<ENGLISH>>>
//	That was the easy part.

//<ページ数変更>
オタコン_002_1: {
mais il fallait l'emp&^echer d'&^etre
entra&^in&'e au fond avec le tanker !
}
//	<<<ENGLISH>>>
//	The tough part was not getting
//	dragged down with the sinking
//	tanker --

//<ページ数変更>
オタコン_002_2: {
Notre r&'eussite est miraculeuse !
}
//	<<<ENGLISH>>>
//	small miracle when
//	you think about it.

/*沈没するタンカーに巻き込まれない
ようにするのが大変だった。
我ながら、奇跡に近い。*/
オタコン_003: {
En fait, toute cette histoire avait &'et&'e mise
au point pour nous tromper !
}
//	<<<ENGLISH>>>
//	It turned out that the whole
//	thing was a setup to lure us.

/*全ては僕達をおびき寄せるための
罠だったんだ。*/
}
//d





resource P050_06_R03_タンカー編整理６無線機デモ３＿１__f {
//vc115021
プリスキン_000: {
Laisses tomber ! Nous perdons notre
temps. Nous verrons &~qa plus tard.
}
//	<<<ENGLISH>>>
//	Forget it. We're wasting time.
//	We can figure this out later.

/*なに、いずれわかるだろうさ……。
だが今はこれ以上考えている時間は
なさそうだ。*/
プリスキン_001: {
La frappe nucl&'eaire a certes &'et&'e &'evit&'ee,
}
//	<<<ENGLISH>>>
//	The nuclear strike's
//	been prevented,

//<ページ数変更>
プリスキン_001_1: {
mais l'Arsenal doit encore s'occuper
d'un tas de missiles puissants.
}
//	<<<ENGLISH>>>
//	but Arsenal still has a massive
//	payload of missiles to deal with.

/*核が使えなくとも、アーセナルには
莫大な量のミサイル兵器がある。*/
オタコン_002: {
C'est vrai.
Si l'ennemi s'emparait de ces missiles...
}
//	<<<ENGLISH>>>
//	Right. If the opposition gets
//	control of those missiles...

/*そうだね。
奴等がそれを手に入れたら……。*/
プリスキン_003: {
Raiden -- il faut que tu trouves Emma.
}
//	<<<ENGLISH>>>
//	Raiden -- you've
//	got to find Emma.

/*ライデン、エマのところに急いでくれ。*/
ライデン_004: {
Une seconde. Emma Emmerich ne
serait-elle pas --
}
//	<<<ENGLISH>>>
//	Wait a second.
//	Isn't Emma Emmerich --

/*待ってくれ、そのエマ・エメリッヒと
いうのが、あんた達が言っていた……？*/
オタコン_005: {
Si, c'est ma s&@eur !
}
//	<<<ENGLISH(2)>>>
//	My sister.

/*そう。僕の妹だ。*/
ライデン_006: {
Qu'est-ce qu'elle fabrique ici ?
}
//	<<<ENGLISH>>>
//	What's she doing here?

/*彼女はここで何を？*/
オタコン_007: {
Aucune id&'ee ! C'est une as
de l'informatique sp&'ecialis&'ee
dans l'intelligence artificielle neuronale
}
//	<<<ENGLISH>>>
//	You got me. She's a computer whiz
//	who specializes in neural-AI＃−

//<ページ数変更>
オタコン_007_1: {
et l'analyse des donn&'ees de volume
ultra-variables par logique complexe.
}
//	<<<ENGLISH>>>
//	and ultra-variable volume data
//	analysis using complex logic.

/*……わからない。
彼女は確かにコンピュータの天才だ。
でも専門はニューロＡＩと複雑性理論を
応用した超多変量情報解析で、*/
オタコン_008: {
Je ne sais pas comment elle en est venue
au d&'eveloppement des armes !
}
//	<<<ENGLISH>>>
//	How she got involved in
//	weapons development is
//	beyond me.

/*兵器開発
じゃないんだ……。*/
ライデン_009: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
プリスキン_010: {
Quelles que soient ses motivations,
son aide sera pr&'ecieuse pour arr&^eter
l'Arsenal.
}
//	<<<ENGLISH>>>
//	Whatever her reasons, we need
//	her in order to stop Arsenal.

/*とにかくアーセナルを止めるには
彼女の力を借りるしかない。*/
オタコン_011: {
Raiden -- trouves-la !
}
//	<<<ENGLISH>>>
//	Raiden -- find her.

/*ライデン、彼女を頼む。*/
ライデン_012: {
C'est parti !
}
//	<<<ENGLISH>>>
//	I'm on my way.

/*わかった。*/
}
//d



resource P051_01_R01_エマとオタコン１無線機デモ１＿１__f {
//vc115101
ライデン_000: {
Colonel, j'aimerais avoir des informations
de base sur Emma Emmerich.
}
//	<<<ENGLISH>>>
//	Colonel, I want some background
//	information on Emma Emmerich.

/*大佐、
エマ・エメリッヒの情報を知りたい。*/
大佐_001: {
J'ai tout un dossier sur elle. Il provient
directement des archives des employ&'es
de l'Agence sur la s&'ecurit&'e nationale.
}
//	<<<ENGLISH>>>
//	I've got it right here, direct from
//	the National Security Agency's
//	personnel files.

/*ああ。調べさせておいた。
＃｛国家安全保障局、ＮＳＡ｝＃の局員ファイルに
彼女の名前があった。*/
大佐_002: {
Elle aurait particip&'e &`a un projet important,
mais je n'ai aucun d&'etail &`a ce sujet.
}
//	<<<ENGLISH>>>
//	Apparently she was involved in some
//	sort of high-level project, but
//	there's no details on that.

/*何らかの極秘プロジェクトに関わって
いたようだが、それについての記載は
ない。*/
大佐_003: {
D'apr&`es son dossier, elle a d&'emissionn&'e
de l'Agence il y a deux ans.
}
//	<<<ENGLISH>>>
//	Her record shows that she resigned
//	from the agency two years ago --

/*記録では二年前に職を辞したことに
なっている……。*/
大佐_004: {
Emma Emmerich.
Nom complet : Emma Emmerich-Danziger.
}
//	<<<ENGLISH>>>
//	Emma Emmerich.
//	Full name: Emma
//	Emmerich-Danziger.

大佐_004_1: {
 Sa famille l'appelle 'E.E'.
}
//	<<<ENGLISH>>>
//	Members of her
//	family call her "E.E."

/*エマ・エメリッヒ。
本名、エマ・エメリッヒ・ダンジガー。
家族からはＥＥと呼ばれていたらしい。*/
大佐_005: {
Apr&`es avoir divorc&'e du p&`ere de Hal
Emmerich, sa m&`ere l'a emmen&'ee
en Angleterre, o&`u elle l'a &'elev&'ee.
}
//	<<<ENGLISH>>>
//	After divorcing Hal Emmerich's
//	father, her mother took Emma to
//	England and raised her there.

/*彼女はハル・エメリッヒの父親と離婚後、
母に連れられてイギリスに戻った。*/
大佐_006: {
Danziger est le nom de jeune fille de sa
m&`ere, mais elle pr&'ef&`ere Emmerich.
}
//	<<<ENGLISH>>>
//	Danziger is her mother's maiden
//	name, but she prefers Emmerich.

/*まだ６歳の子供だった。ダンジガーは
母親の姓だが、彼女は好んでエメリッヒ
という姓を使っている。*/
大佐_007: {
Apr&`es &^etre rentr&'ee en Angleterre, son
pays natal, sa m&`ere a &'epous&'e un homme
d'affaires appel&'e Robinson.
}
//	<<<ENGLISH>>>
//	After returning home to England,
//	her mother married Robinson,
//	a businessman.

/*故郷イギリスに帰った後、
彼女の母親は再婚している。
ロビンソンという実業家だ。*/
大佐_008: {
Les informations suivantes sont tir&'ees d'un
rapport r&'edig&'e par l'ASN, &`a l'arriv&'ee
d'Emma...
}
//	<<<ENGLISH>>>
//	The following details are from a
//	report filed with the NSA when
//	she joined the agency...

/*以下はＮＳＡに入る際、取られた調書だ。*/
大佐_009: {
Juste avant de terminer ses &'etudes
secondaires, Emma, qui pr&'etend avoir
&'et&'e agress&'ee par Robinson,
}
//	<<<ENGLISH>>>
//	Just before graduating from high
//	school, Emma injured Robinson in
//	self-defense＃−

//<ページ数変更>
大佐_009_1: {
l'a bless&'e en tentant de se d&'efendre.
}
//	<<<ENGLISH>>>
//	during an alleged assault
//	on her person.

/*……エマがハイスクールを卒業しようと
していた頃、義理の父親から暴行を受け
そうになり、父親を傷つけてしまう。*/
大佐_010: {
Apr&`es cet incident, elle a suivi l'exemple
de son demi-fr&`ere, Hal Emmerich,
}
//	<<<ENGLISH>>>
//	As a result of this incident, she
//	followed in the footsteps of her
//	stepbrother, Hal Emmerich,

//<ページ数変更>
大佐_010_1: {
et a quitt&'e le domicile familial pour
s'inscrire &`a l'universit&'e d'Oxford.
}
//	<<<ENGLISH>>>
//	and left home to enroll in Oxford.

/*この事が原因でエマは義理の兄、ハル・
エメリッヒが歩んだのと同じように一人
家を出てオックスフォードへ入学する。*/
大佐_011: {
A cette &'epoque,
}
//	<<<ENGLISH>>>
//	It is believed that at this
//	particular point in her life,

//<ページ数変更>
大佐_011_1: {
il semble qu'elle ait ressenti une vive
col&`ere contre son fr&`ere, qui n'avait pas
&'et&'e capable de la prot&'eger.
}
//	<<<ENGLISH>>>
//	she was extremely angered by
//	the fact that her brother failed
//	to protect her.

/*この時もエマは自分を守ってくれない兄、
ハルに対して非常な怒りを憶えている。*/
大佐_012: {
Pour finir, elle a rompu les ponts avec sa
famille et &'eprouve de la rancune envers
elle.
}
//	<<<ENGLISH>>>
//	Consequently, she lost all family
//	connections and is very resentful.

//<ページ数変更>
大佐_012_1: {
A ses dires, son fr&`ere est responsable
de tous ses maux.
}
//	<<<ENGLISH>>>
//	She seems to believe that her
//	brother is to blame for everything.

/*エマもハルと同じく、この時に事実上、
家族を失っている。『自分の不幸は全て
兄のせいだ』とも思いこんでいるようだ。*/
大佐_013: {
Pendant ses &'etudes &`a Oxford,
}
//	<<<ENGLISH>>>
//	While attending Oxford,

//<ページ数変更>
大佐_013_1: {
elle a &'et&'e remarqu&'ee en remportant un
concours de d&'ecodage parrain&'e par GCHQ,
l'Agence britannique de surveillance du
territoire.
}
//	<<<ENGLISH>>>
//	she was noted for her success in
//	a deciphering event sponsored by
//	British GCHQ.

/*オックスフォード在学中に、彼女は
英国政府中央情報部が主催する暗号解読
イベントで解読に成功している……。*/
ライデン_014: {
M&^eme si elle n'a pas de lien de parent&'e
direct avec Otacon, elle a un tas de points
communs avec lui...
}
//	<<<ENGLISH>>>
//	They may not be blood-related,
//	but she sure sounds like Otacon's
//	sister.

/*なるほど、血は繋がってはいないが、
オタコンの妹だ。*/
大佐_015: {
Et ce n'est pas tout...
}
//	<<<ENGLISH>>>
//	There's more --

/*いやそれで終わりではない。*/
大佐_016: {
Raiden, tu ne te souviens pas
de l'&'ev&'enement qui est devenu plus
ou moins l&'egendaire parmi les pirates
informatiques ?
}
//	<<<ENGLISH>>>
//	Raiden, do you recall a certain
//	'situation' that's more or less
//	become a legend among hackers?

/*ライデン、ハッキング史上類をみない、
ある出来事を覚えているか？*/
大佐_017: {
Je vais te rafra&^ichir la m&'emoire.
}
//	<<<ENGLISH>>>
//	To refresh your memory --

//<ページ数変更>
大佐_017_1: {
A l'&'epoque, presque toutes les ressources
en communications et en informations
}
//	<<<ENGLISH>>>
//	at the time, just about all of
//	our nation's communications
//	and information resources
//<ページ数変更>
大佐_017_2: {
de notre pays &'etaient concentr&'ees
&`a l'ASN, au Fort Meade.
}
//	<<<ENGLISH>>>
//	were concentrated at NSA,
//	in Fort Meade.

/*当時の、わが国のあらゆる通信情報は
フォート・ミードにあるＮＳＡに
集中していた。*/
大佐_018: {
En fait, les services du sous-sol
de l'ASN travaillaient jour et nuit
pour recueillir les donn&'ees issues
}
//	<<<ENGLISH>>>
//	In fact, NSA's basement facility
//	operated round-the-clock to
//	amass data obtained＃−

//<ページ数変更>
大佐_018_1: {
des communications publiques, d'une part,
et des &'ecoutes t&'el&'ephoniques, d'autre part.
}
//	<<<ENGLISH>>>
//	not only from public communications,
//	but everything from satellite to
//	wiretap operations as well.

/*衛星や盗聴などで得られた一般を含む
あらゆる通信情報が、２４時間体勢で
ＮＳＡの地下に集められていたのだ。*/
大佐_019: {
Je ne pense pas exag&'erer en disant que
toute personne &`a m&^eme de contr&^oler
l'ASN avait le monde &`a ses pieds.
}
//	<<<ENGLISH>>>
//	I don't think I'm exaggerating when
//	I say that whoever controlled the
//	NSA facility could move the world.

/*ここの情報を牛耳るものがそれこそ、
世界を動かす事ができる。*/
大佐_020: {
Or, le 24 janvier 2000, ces services sont
tomb&'es en panne pendant 73 heures.
}
//	<<<ENGLISH>>>
//	On January 24th in the year 2000,
//	the facility suffered a total system
//	shutdown for a 73-hour period.

/*ところが、２０００年の１月２４日……
このシステムが７３時間に渡って
ダウンした……。*/
ライデン_021: {
La cause de cette panne a-t-elle &'et&'e
&'etablie ?
}
//	<<<ENGLISH>>>
//	Did they ever figure out the cause?

/*原因は？*/
大佐_022: {
Certaines personnes pensent qu'un
groupuscule du gouvernement avait
orchestr&'e cet incident
}
//	<<<ENGLISH>>>
//	It's believed that a small
//	group within the government
//	had arranged the incident＃−

//<ページ数変更>
大佐_022_1: {
aid&'e d'un gang de pirates informatiques
notoires.
}
//	<<<ENGLISH>>>
//	with the assistance of a
//	notorious group of crackers.

/*政府の一部が指示したという噂がある。
当時有名だったクラッカー・グループにな。*/
大佐_023: {
Suite &`a cet &'episode, les mesures
de s&'ecurit&'e de l'ASN ont &'et&'e enti&`erement
r&'evis&'ees
}
//	<<<ENGLISH>>>
//	The result was a full review
//	of NSA's safety measures,

//<ページ数変更>
大佐_023_1: {
et les op&'erations de recueil des donn&'ees
ont &'et&'e relog&'ees dans un endroit isol&'e,
}
//	<<<ENGLISH>>>
//	which in turn led to the decision
//	to shift the data-gathering
//	operations to an isolated location

/*結果として安全対策は見直され、
ＮＳＡのこの機能を別に移そうという
計画になった……
*/
大佐_024: {
r&'esistant aux attaques physiques
et au cyber-terrorisme.
}
//	<<<ENGLISH>>>
//	that would be safe from physical
//	attack as well as cyber-terrorism.

/*物理的なテロやサイバーテロから
隔離された場所に。
*/
ライデン_025: {
Et o&`u se trouve cet endroit, alors ?
}
//	<<<ENGLISH>>>
//	And where might that be?

/*何処に？*/
大佐_026: {
Mon niveau de s&'ecurit&'e ne permet
pas d'acc&'eder &`a des informations
aussi sensibles.
}
//	<<<ENGLISH>>>
//	My security clearance couldn't
//	get me that information.

//<ページ数変更>
大佐_026_1: {
Mais j'ai d&'ecouvert que notre Emma
Emmerich se trouvait parmi ce groupe de
pirates informatiques et qu'elle y exer&~qait
un r&^ole pr&'epond&'erant.
}
//	<<<ENGLISH>>>
//	But I did find out that one of the
//	key members of the hacker group
//	was none other than Emma Emmerich.

/*それは私のクリアランスでは
近づくことはできない。
そのメンバーの中心人物がエマだった。*/
大佐_027: {
Si elle a d&'ebut&'e sa carri&`ere comme
sp&'ecialiste de l'intelligence artificielle
et de la logique complexe,
}
//	<<<ENGLISH>>>
//	Although she started off
//	as a specialist in artificial
//	intelligence and complex logic,

//<ページ数変更>
大佐_027_1: {
Emma fait &`a pr&'esent figure de g&'enie
de l'informatique.
}
//	<<<ENGLISH>>>
//	Emma is now regarded
//	as a computer genius.

/*彼女の専門はあくまで人工知能と複雑性
理論だったが、既にコンピュータの天才
として一目を置かれる存在になっていた。*/
ライデン_028: {
Ce statut en fait une recrue de choix pour
}
//	<<<ENGLISH>>>
//	That would make her a prime
//	candidate for recruitment＃−

//<ページ数変更>
ライデン_028_1: {
les services de renseignements,
n'est-ce pas ?
}
//	<<<ENGLISH>>>
//	in the intelligence community,
//	wouldn't it?

//<ページ数変更>
ライデン_028_2: {
Et dans cet univers,
}
//	<<<ENGLISH>>>
//	And knowing most of the
//	intelligence agencies,

//<ページ数変更>
ライデン_028_3: {
la loyaut&'e n'est pas une vertu courante...
}
//	<<<ENGLISH>>>
//	I doubt fair play was a major
//	concern in their recruiting
//	efforts...

/*で、世界中の諜報機関が彼女を
スカウトした。いつもの汚いやり方で？*/
大佐_029: {
Tes suppositions sont correctes.
Le gouvernement s'est servi de son
point faible,
}
//	<<<ENGLISH>>>
//	Your assumption's correct.
//	The government played on
//	her weakness --

/*あまり違いはない。
政府は彼女の弱みを探した。*/
大佐_030: {
&`a savoir sa haine pour Hal Emmerich --
}
//	<<<ENGLISH>>>
//	-- her strong hate
//	for Hal Emmerich,

/*彼女の弱みは……６歳の時に別れた兄、
ハル・エメリッヒへの想いだった。*/
大佐_031: {
ce fr&`ere qui l'avait quitt&'ee quand
elle n'avait que six ans.
}
//	<<<ENGLISH>>>
//	the brother who left her when
//	she was six years old.

/*それも強烈な恨みだ。
*/

ライデン_032: {
Elle le d&'eteste &`a ce point ?
}
//	<<<ENGLISH>>>
//	She hates him that much?

/*恨み？*/
大佐_033: {
Elle n'avait que six ans, quand elle et
son p&`ere ont &'et&'e victimes d'un accident,
dans leur piscine.
}
//	<<<ENGLISH>>>
//	When she was six years old, Emma
//	and her father were involved in a
//	pool accident.

大佐_033_1: {
Elle a surv&'ecu mais son p&`ere,
lui, s'est noy&'e.
}
//	<<<ENGLISH>>>
//	She survived, but her father drowned.

/*彼女が６歳の時に事故があった。エマと父親がプールで溺れた。父親は助からず、溺死した。
*/
ライデン_034: {
Quelles ont &'et&'e les conclusions
de la police ?
}
//	<<<ENGLISH>>>
//	What did the police have
//	to say about that?

/*警察は？
*/
大佐_035: {
Selon le rapport de police,
il s'agit d'une mort accidentelle.
}
//	<<<ENGLISH>>>
//	Their report states it
//	was an accidental death.

/*当時の警察は事故として処理している。
*/
ライデン_036: {
Cet accident ne s'est-il pas produit quand
Otacon a quitt&'e sa famille ?
}
//	<<<ENGLISH>>>
//	Isn't that about the time that
//	Otacon left his home and family?

/*オタコンが家を出たのはその直後なのか？
*/
大佐_037: {
Exactement ! Mais je ne connais
pas le motif de son d&'epart.
}
//	<<<ENGLISH>>>
//	Exactly. But I don't have any
//	idea why he chose to do so.

/*そうだ。何があったかはわからんが……。
*/
}//d

resource P051_01_R01_エマとオタコン１無線機デモ１＿２__f {
//vcxxxxxxxxx
ライデン_000: {
Emma accuse-t-elle qu'Otacon de la mort
de son p&`ere ?
}
//	<<<ENGLISH>>>
//	Does Emma blame Otacon
//	for her father's death?

/*エマは事故の原因を？*/
大佐_001: {
Je ne pense pas. Sa haine semble venir
de son sentiment d'avoir &'et&'e abandonn&'ee
par Otacon.
}
//	<<<ENGLISH>>>
//	I don't think so. Her hate seems to
//	stem from the fact that she believes
//	Otacon abandoned her.

/*いや、エマは兄に見捨てられたと
思っているようだ。*/
大佐_002: {
Malgr&'e leur absence de lien de parent&'e
direct, ils &'etaient tr&`es proches.
}
//	<<<ENGLISH>>>
//	You see, although the two weren't
//	directly related, they were said to
//	be very close.

/*それまでは連れ子同士にもかかわらず、
非常に仲のいい＃｛兄妹、きょうだい｝＃だった
らしい。*/
大佐_003: {
D'apr&`es certaines rumeurs, sa rivalit&'e avec
son fr&`ere l'a pouss&'ee &`a faire du piratage
informatique.
}
//	<<<ENGLISH>>>
//	It's rumored that sibling rivalry
//	was what launched her career
//	as a hacker.

/*彼女がクラッカーまがいの行為を
行なっていたのも、兄への対抗意識
だったのだろう……。*/
大佐_004: {
Il y a quatre ans, le gouvernement lui
a transmis les d&'etails de l'incident
de Shadow Moses
}
//	<<<ENGLISH>>>
//	Four years ago, the government
//	leaked her the details of the
//	Shadow Moses incident.

//<ページ数変更>
大佐_004_1: {
et l'a recrut&'ee &`a l'ASN.
}
//	<<<ENGLISH>>>
//	In doing so, they were able
//	to recruit her for the NSA.

/*そして４年前、政府はシャドーモセス
事件の真実を彼女にリークし、ＮＳＡへ
入ることに同意させた。*/
大佐_005: {
En outre, il a sans doute exploit&'e
}
//	<<<ENGLISH>>>
//	I also have little doubt...

//<ページ数変更>
大佐_005_1: {
l'affaire du piratage de l'ASN pour
la 'convaincre' de travailler avec lui.
}
//	<<<ENGLISH>>>
//	that they also used the NSA hacking
//	affair as a means to 'convince' her
//	to cooperate.

/*例のハッキングの件も保険として、
脅迫材料に入っていたに違いない。*/
ライデン_006: {
Sa haine l'aurait pouss&'ee &`a vouloir
&'epingler Snake et Otacon ?
}
//	<<<ENGLISH>>>
//	You think that her hate drove her
//	to frame Snake and Otacon?

/*オタコン達に濡れ衣をかぶせたのも、
そういう理由か？*/
大佐_007: {
Je ne le sais pas.
}
//	<<<ENGLISH>>>
//	That -- I don't know.

/*それはわからん。*/
}
//d



resource P052_01_R01_ローズ無線１無線機デモ１＿１__f {
//vc115201
ローズ_000: {
Jack ?
}
//	<<<ENGLISH(2)>>>
//	Jack?

/*ジャック、聞いて？*/
ライデン_001: {
Qu'y a-t-il ?
}
//	<<<ENGLISH(2)>>>
//	What is it?

/*どうした？*/
ローズ_002: {
Je me suis toujours sentie seule...
}
//	<<<ENGLISH>>>
//	I've always been alone...

/*私いつも独りだった……。*/
ライデン_003: {
Pla&^it-il ?
}
//	<<<ENGLISH(2)>>>
//	Huh?

/*？*/
ローズ_004: {
Je suis si seule...
}
//	<<<ENGLISH(2)>>>
//	I'm so lonely...

/*私、寂しかった……。*/
ライデン_005: {
Seule ? Rose, nous sommes toujours --
}
//	<<<ENGLISH>>>
//	Lonely? Rose, we've always --

/*ローズ？
俺はいつも君と？*/
ローズ_006: {
Non, pas toujours !
}
//	<<<ENGLISH>>>
//	Not always.

/*違うわ……。*/
ライデン_007: {
Que veux-tu dire, au juste ?
}
//	<<<ENGLISH(2)>>>
//	What do you mean?

/*違うって？*/
ローズ_008: {
Tu n'as jamais dormi &`a mes c&^ot&'es...
}
//	<<<ENGLISH>>>
//	You've never slept beside me...

/*あなたは私と眠った事はなかった……。*/
ライデン_009: {
De quoi parles-tu, enfin !?
}
//	<<<ENGLISH>>>
//	What are you talking about?
//	I --

/*何の話だ？*/
ローズ_010: {
Apr&`es chaque moment intime que nous
passons dans ma chambre, tu ne fermes
pas l'&@eil de la nuit ou tu pars...
}
//	<<<ENGLISH>>>
//	After we've been together in my
//	room... you stay awake all night
//	or you head for the door.

/*私の部屋で愛し合った後……
あなたはいつも朝まで起きているか、
帰っていくかのどちらかだった。*/
ライデン_011: {
Tu crois vraiment que c'est le moment
de parler de &~qa ?
}
//	<<<ENGLISH>>>
//	Is this really the time
//	to bring this up?

/*こんな時に何を？*/
ローズ_012: {
Pourquoi fais-tu cela, Jack ?
Dis-moi !
}
//	<<<ENGLISH>>>
//	Why, Jack? Why?

/*なぜなの？
ジャック？*/
ライデン_013: {
Ecoute, Rose, je suis en pleine
mission et je...
}
//	<<<ENGLISH>>>
//	Listen, Rose. I'm right in the
//	middle of a mission, and I...

/*ローズ？
任務中だ……。*/
ローズ_014: {
Pourquoi ? Pourquoi n'es-tu jamais
d&'etendu quand tu es avec moi, hein ?
}
//	<<<ENGLISH>>>
//	Why!? Why can't you relax
//	when you're with me!?

/*なぜなの？
私といると安らげないの？*/
ライデン_015: {
Ecoutes...
J'ai ma mission &`a remplir et...
}
//	<<<ENGLISH>>>
//	Look... the mission... I...

/*任務中……。*/
ローズ_016: {
Pourquoi ne t'ouvres tu pas &`a moi, hein ?
}
//	<<<ENGLISH>>>
//	Why don't you open up to me!?

/*どうして心を開いてくれないの？*/
ライデン_017: {
Rose ! Je n'y arrive pas ! C'est tout !
}
//	<<<ENGLISH>>>
//	Rose... I... I just can't!

/*違う。*/
ローズ_018: {
Tout ce que je veux, c'est partager mes
r&^eves avec toi et passer une soir&'ee
d'intense &'emotion...
}
//	<<<ENGLISH>>>
//	All I ever wanted was to share your
//	dreams -- to spend a meaningful
//	evening with you...

/*夢を共有したい、
あなたと夜を過ごしたい。*/
ローズ_019: {
Je veux, te voir &`a mes c&^ot&'es, &`a mon r&'eveil.
Est-ce vraiment trop te demander ?
}
//	<<<ENGLISH>>>
//	I just wanted to find you by
//	my side when I woke up. Is
//	that asking too much?

/*そして朝を向かえたい。
ダメなの？*/
ライデン_020: {
C'est la nuit... J'ai peur de la nuit !
Cela n'a rien &`a voir avec toi...
}
//	<<<ENGLISH>>>
//	It's the night -- I'm scared of
//	the night... it's got nothing to
//	do with you...

/*夜が……夜が怖いんだ。
君は関係ない。*/
ローズ_021: {
Tu as peur de la nuit ?
Qu'est-ce que tu me chantes ?
}
//	<<<ENGLISH>>>
//	Scared of the night?
//	What's that supposed
//	to mean?

/*夜が怖いって……そんなの……。*/
ライデン_022: {
Je n'arrive pas &`a me d&'etendre quand
je suis avec quelqu'un...
}
//	<<<ENGLISH>>>
//	I can't relax when
//	I'm with someone...

/*人前では熟睡できないんだ。*/
ローズ_023: {
Jack ! Tu ne m'autorises m&^eme pas &`a
entrer dans ta chambre !
}
//	<<<ENGLISH>>>
//	Jack? You wouldn't even
//	let me in your room!

/*ジャック？
私があなたの部屋に入ることも嫌がった。*/
ライデン_024: {
J'ai besoin d'intimit&'e.
Je n'aime pas &^etre emb&^et&'e...
}
//	<<<ENGLISH(2)>>>
//	I need privacy...
//	I just can't be bothered.

/*自分の生活を、邪魔されたくないんだ。*/
ローズ_025: {
Emb&^et&'e !?
}
//	<<<ENGLISH>>>
//	Bothered!?

/*邪魔だなんて？*/
ライデン_026: {
Je me suis mal exprim&'e ! Je veux
dire que j'ai besoin de garder certaines
choses pour moi...
}
//	<<<ENGLISH>>>
//	Wrong word! What I wanted to say
//	was that there are certain things
//	that I have to keep to myself...

/*いや、覗かれたくない。*/
ローズ_027: {
Tu te rappelles le jour o&`u je suis entr&'ee
de force dans ta chambre ?
}
//	<<<ENGLISH>>>
//	Do you remember that time
//	I forced my way into your room?

/*憶えてる？
無理矢理あなたの部屋に押し入ったの？*/
ローズ_028: {
On se connaissait depuis presque un an...
Tu as p&'et&'e les plombs !
}
//	<<<ENGLISH>>>
//	We'd known each other for almost
//	a year... and you blew up!

//<ページ数変更>
ローズ_028_1: {
C'&'etait la premi&`ere fois
que tu me frappais !
}
//	<<<ENGLISH>>>
//	It was the first time you ever
//	raised your hand against me!

/*つきあい始めてもう１年も経っていた。あなたはもの凄く怒ったわ。
私に初めて手を挙げた。*/
ライデン_029: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
ローズ_030: {
Je m'inqui&'etais tellement pour toi...
}
//	<<<ENGLISH>>>
//	I was so worried about you...

/*あなたが心配だったの。*/
ライデン_031: {
Ecoutes...
Je suis vraiment d&'esol&'e...
}
//	<<<ENGLISH>>>
//	Look... I'm sorry...

/*わるかった……。*/
ローズ_032: {
Ce n'est pas ta violence qui m'a fait peur,
mais ta chambre et l'&'etat de ton c&@eur...
}
//	<<<ENGLISH>>>
//	It wasn't your violent nature that
//	scared me. It was your room...
//	your heart...

/*いいえ、
私が怯えたのはあなたの暴力じゃない。
あなたの部屋……あなたの心の中……。*/
ライデン_033: {
Arr&^etes...
}
//	<<<ENGLISH(2)>>>
//	Stop it...

/*やめてくれ……。*/
ローズ_034: {
Il n'y avait rien dans ta chambre -- sauf
un lit et un petit bureau. On aurait dit
une cellule de prisonnier...
}
//	<<<ENGLISH>>>
//	There wasn't anything in your room
//	-- only a bed and a small desk. It
//	looked like a prison cell...

/*何もない部屋だった。
ベッドと小さな机が一つ。
まるで、刑務所の独房のようだった。*/
ライデン_035: {
Rose ?
}
//	<<<ENGLISH(2)>>>
//	Rose?

/*ローズ？*/
ローズ_036: {
Pas de t&'el&'evision, pas de photo
de famille... pas m&^eme un poster...
}
//	<<<ENGLISH>>>
//	No television set...
//	no family pictures...
//	not even a poster...

/*家族の写真もポスターも、
テレビさえもなかった。*/
ライデン_037: {
Rose, ma chambre ne me sert
qu'&`a dormir !
}
//	<<<ENGLISH>>>
//	Rose, I only use that
//	room for sleeping.

/*ただ寝るだけの部屋だ……。*/
ローズ_038: {
Une pi&`ece sans vie...
presque aussi aride que ton c&@eur...
}
//	<<<ENGLISH>>>
//	A lifeless room... almost
//	like your empty heart.

/*生活感のない部屋、
実体のないあなた……。*/
ライデン_039: {
C'est bien pour &~qa que je ne voulais
pas que tu y entres !
}
//	<<<ENGLISH>>>
//	That's why I tried
//	to keep you out.

/*だから、君には来て欲しくなかったんだ。*/
ローズ_040: {
Avant de voir ta chambre, j'avais
l'impression de commencer &`a te
comprendre...
}
//	<<<ENGLISH>>>
//	I thought I was beginning to
//	understand you -- until I saw
//	that room.

/*あなたの部屋を見て……
あなたがわからなくなった。*/
ライデン_041: {
Tu aurais s&^urement voulu que j'affiche
une photo de toi sur le mur, c'est &~qa ?
}
//	<<<ENGLISH>>>
//	Would you've been happier if
//	I had a picture of you hanging
//	on the wall!?

/*君の写真が飾ってあればよかったのか？*/
ローズ_042: {
Ce n'est pas ce que je voulais dire !
}
//	<<<ENGLISH>>>
//	That's not what I was
//	trying to say --

/*いいえ、そんな意味じゃない。*/
ライデン_043: {
Bon, Rose... Nous en reparlerons
plus tard, apr&`es la mission.
}
//	<<<ENGLISH>>>
//	Enough, Rose. We'll talk about
//	this later... after the mission.

/*ローズ、後で話し合おう……。
この任務が終わったら。*/
ローズ_044: {
D'accord... Je comprends.
}
//	<<<ENGLISH>>>
//	Right... after the mission...
//	I understand.

/*……ええ……そうね。
わかったわ。*/
}
//d



resource P053_01_R01_息継ぎ１無線機デモ１＿１__f {
//vc115301
オタコン_000: {
Raiden, tu me re&~qois ? Ici Otacon.
Quelle est ta situation ?
}
//	<<<ENGLISH>>>
//	Raiden, are you reading me?
//	This is Otacon. What's your
//	situation?

/*ライデン、聞こえる？
僕だよ。そっちの状況はどうだい？*/
ライデン_001: {
Je suis tremp&'e et mis&'erable !
Tout est inond&'e...
}
//	<<<ENGLISH(2)>>>
//	Wet and miserable...
//	this place is flooded.

//<ページ数変更>
ライデン_001_1: {
L'eau de mer que l'on pompe est en train
de s'&'ecouler dans le b&^atiment.
}
//	<<<ENGLISH>>>
//	The seawater that's been pumped
//	up is pouring into the building.

/*浸水がひどい。
汲み上げた海水が流れ込んで来ている。*/
オタコン_002: {
Je vois... Ecoutes, j'ai quelque chose
&`a te dire au sujet de E.E.
}
//	<<<ENGLISH>>>
//	I see. Listen, there's something
//	I have to tell you about E.E.

/*そうか、やっぱり……ＥＥの事だけど、
どうしても言っておきたい事がある。*/
ライデン_003: {
Ne t'inqui&`etes pas pour elle.
Je vais la sortir d'ici...
}
//	<<<ENGLISH>>>
//	Don't worry about her.
//	I'll get her out --

/*心配するな、彼女は助ける。*/
オタコン_004: {
Elle a peur de l'eau.
}
//	<<<ENGLISH>>>
//	She's afraid of water.

/*彼女、水が苦手なんだ。*/
ライデン_005: {
Quoi !?
}
//	<<<ENGLISH(2)>>>
//	What!?

/*水が？*/
オタコン_006: {
Ben, ouais... Quand elle n'avait que six
ans, elle a failli se noyer avec mon p&`ere,
dans notre piscine.
}
//	<<<ENGLISH>>>
//	Yeah... when she was six years old,
//	she almost drowned with my father
//	in our swimming pool.

/*ああ……６歳の時に、家のプールで
溺れたんだ。僕の親父と一緒に。*/
ライデン_007: {
Elle ne sait pas nager !?
}
//	<<<ENGLISH>>>
//	She can't swim!?

/*泳げなかったのか？*/
オタコン_008: {
Oui et non... Nous nagions beaucoup tous
les deux, quand nous &'etions petits.
}
//	<<<ENGLISH>>>
//	Well yes and no... we used to swim
//	a lot together when we were kids.

//<ページ数変更>
オタコン_008_1: {
Avant de manquer de se noyer,
elle nageait comme un poisson...
}
//	<<<ENGLISH>>>
//	In fact, she swam like a fish until
//	that day when she almost drowned...

/*そうじゃない。泳ぎは得意だった。
よく二人で泳ぎに行った……。
あの事故が起こるまではね。*/
}
//d

//大佐の説明を聞いている人のみ
resource P053_01_R01_息継ぎ１無線機デモ１＿２__f {
//vc115302
ライデン_000: {
Cela co&~incide assez bien avec ce que m'a
dit le Colonel...
}
//	<<<ENGLISH>>>
//	That pretty much coincides with
//	what the Colonel told me...

/*……やはり、大佐の話は本当だったのか。*/
}
/**///d
resource P053_01_R01_息継ぎ１無線機デモ１＿３__f {
//vc115303
オタコン_000: {
Au moment de l'accident, j'&'etais dans
ma chambre. J'ai appris plus tard que
E.E m'avait lanc&'e un appel &`a l'aide...
}
//	<<<ENGLISH>>>
//	When the accident happened, I was
//	in my room. I learned later that E.E.
//	was calling me for help...

/*僕はあの時、自分の部屋にいた。
……ＥＥはずっと僕に助けを……
呼んでたらしい。*/
オタコン_001: {
Elle n'a pas mis ma pr&'esence
en doute un seul instant.
}
//	<<<ENGLISH>>>
//	She didn't doubt for a
//	minute that I'd be there.

/*お兄ちゃんが助けてくれる、
お兄ちゃんなら……。*/
オタコン_002: {
Ma chambre donnait sur la piscine, mais
ce jour-l&`a, je ne me suis pas rendu compte
qu'elle avait besoin d'aide.
}
//	<<<ENGLISH>>>
//	You could see the pool from
//	my room... but I didn't realize at
//	the time that she needed my help.

/*僕の部屋からはプールがよく見えたんだ。
……でも僕は気づかなかった。*/
ライデン_003: {
Qu'est-ce que tu faisais ?
}
//	<<<ENGLISH>>>
//	What were you doing?

/*何してたんだ？*/
オタコン_004: {
Je... J'&'etais en train de...
}
//	<<<ENGLISH>>>
//	I... I was...

/*その時、僕は……。*/
ライデン_005: {
Emma a surv&'ecu &`a cette p&'enible &'epreuve...
}
//	<<<ENGLISH>>>
//	So Emma survived the ordeal...

/*エマは助かったんだろう？*/
オタコン_006: {
Oui. Mais pas mon p&`ere...
}
//	<<<ENGLISH>>>
//	Yeah. But my father didn't...

/*ああ、幸いね。
親父は助からなかったけど……。*/
ライデン_007: {
Tu t'es senti coupable de cette mort
et tu as quitt&'e ta famille ?
}
//	<<<ENGLISH>>>
//	So you blamed yourself
//	and left your family?

/*あんたはその事で、自分を責め……
家を出た？*/
オタコン_008: {
C'est ce que croyait E.E. En v&'erit&'e...
je l'ai trahie.
}
//	<<<ENGLISH(2)>>>
//	No. E.E. seems to believe that
//	was the case. The fact is...
//	I betrayed her.

/*いや、そうじゃないが、
彼女はそう思っているかもしれない。
僕はＥＥを裏切ったんだ。*/
ライデン_009: {
Et tu crois que cette exp&'erience a &'et&'e si
traumatisante qu'elle n'est plus capable
de nager ?
}
//	<<<ENGLISH>>>
//	And you think that she can't
//	swim because of the traumatic
//	experience?

/*それがトラウマになって、泳げないと？*/
オタコン_010: {
Je ne l'ai pas revue, depuis ce jour-l&`a,
mais c'est mon sentiment, oui.
}
//	<<<ENGLISH>>>
//	I haven't seen her since that
//	day... but yes, I think so.

/*ああ。
……あれから直接は会ってないけど……。*/
オタコン_011: {
J'ai re&~qu une lettre de sa m&`ere, Julie,
apr&`es leur retour en Angleterre.
}
//	<<<ENGLISH>>>
//	I got a letter from Julie, her
//	mother, after they moved
//	back to England.

/*彼女たちがイギリスに帰って、
しばらくしてから手紙が来たんだ。
母親のジュリーから。*/
オタコン_012: {
Elle m'y disait que E.E ne savait plus nager
}
//	<<<ENGLISH>>>
//	In her letter, she mentioned that
//	E.E. couldn't swim anymore...

//<ページ数変更>
オタコン_012_1: {
et qu'elle refusait m&^eme de porter
un maillot de bain.
}
//	<<<ENGLISH>>>
//	that she refused to even
//	wear a bathing suit.

/*あれ以来、ＥＥが泳ぐ事がなくなった、
水着を着ることもなくなったって。*/
ライデン_013: {
Mince ! Si c'est toujours le cas, on est
dans le p&'etrin ! Le noyau du niveau B1
est passablement inond&'e.
}
//	<<<ENGLISH>>>
//	Damn! If she still can't swim,
//	we're in trouble... level B1 in
//	the core is pretty much flooded.

/*そのトラウマが生きているとすると、
まずいな。中央棟のＢ１はほとんど
浸水している。*/
オタコン_014: {
Tu r&'eussiras peut-&^etre &`a lui faire d&'epasser
son traumatisme.
}
//	<<<ENGLISH>>>
//	Look... maybe you can help
//	her overcome the trauma.

/*なんとか彼女を勇気づけてやってくれ。*/
ライデン_015: {
Tu veux que je l'aide &`a d&'epasser sa peur,
c'est &~qa ?
}
//	<<<ENGLISH>>>
//	You want me to help
//	her get over it?

/*こっちが勇気づけて欲しい
状況なんだが……。*/
オタコン_016: {
Les r&'eparations du Kamov vont prendre
un certain temps...
}
//	<<<ENGLISH>>>
//	It's still going to take some
//	time to repair the Kamov.

/*カモフの修理にまだ時間がかかる。*/
プリスキン_017: {
D&'esol&'e, mon petit, mais c'est toi
qui vas devoir secourir Emma !
}
//	<<<ENGLISH>>>
//	Sorry, kid. Emma's
//	rescue is up to you.

/*悪いが手が離せない。エマの事は頼む。*/
ライデン_018: {
Merci, les gars ! Les missions
sous-marines, c'est pas le genre
de la maison ! Mais enfin --
je verrai ce que je peux faire.
}
//	<<<ENGLISH>>>
//	Thanks. An underwater mission...
//	well, this is a first. Look -- I'll
//	see what I can do.

/*水中でのミッションは初めてなんだが。なんとかやってみる。*/
プリスキン_019: {
T&^aches de m&'emoriser le plan
du b&^atiment
}
//	<<<ENGLISH>>>
//	I suggest that you drum
//	the map of the building
//	into your head,

//<ページ数変更>
プリスキン_019_1: {
parce que tu n'auras pas le temps de
le consulter quand tu t'occuperas d'Emma.
}
//	<<<ENGLISH>>>
//	'cause you won't have time
//	to look at it when you try to
//	bring Emma out.

/*今のうちにマップを頭にたたき込んで
おくことだ。エマを連れて進む事になる。*/
オタコン_020: {
Je compte sur toi, Raiden !
}
//	<<<ENGLISH>>>
//	I'm counting on you, Raiden.

/*頼むよ。*/
プリスキン_021: {
J'ai &'ecum&'e la plus grande partie du noyau
lors du d&'esamor&~qage des bombes C4...
}
//	<<<ENGLISH>>>
//	I covered most of the core when
//	I had to take out the C4's...

//<ページ数変更>
プリスキン_021_1: {
Si tu as des questions, contactes-moi
sur le Codec !
}
//	<<<ENGLISH>>>
//	if there's anything you need to
//	ask me, call me on the Codec.

/*中央棟は俺の方が詳しい。Ｃ４解除で
一通り、回ったからな。何か聞きたい
ことがあれば無線連絡をくれ。*/
ライデン_022: {
Entendu !
}
//	<<<ENGLISH>>>
//	I'll do that.

/*わかった。*/
}
//d



resource P057_02_R01_ヴァンプ戦終了２無線機デモ１＿１__f {
//vc115701
ライデン_000: {
Colonel ! Ils semblent avoir termin&'e
l'ultime proc&'edure de v&'erification
de l'Arsenal Gear !
}
//	<<<ENGLISH>>>
//	Colonel! They've apparently
//	completed the final check
//	procedure for Arsenal Gear!

/*大佐、アーセナルギアの最終チェックが
終わったらしい！*/
大佐_001: {
Trouves vite Emma !
}
//	<<<ENGLISH>>>
//	Find Emma on the double!

//<ページ数変更>
大佐_001_1: {
Il faut qu'elle installe le virus
que t'a confi&'e le Pr&'esident !
}
//	<<<ENGLISH>>>
//	You've got to get her to
//	install the virus program
//	that the President gave you!

/*早くエマを助け出せ。
彼女に大統領からもらったウィルスを
入力させるんだ。
*/
大佐_002: {
D&`es que tu la trouves, conduis-la dans
la Salle des ordinateurs du niveau B2,
noyau de la Shell 1 !
}
//	<<<ENGLISH>>>
//	When you find her, take her to
//	the Computer Room on level B2
//	in the core of Shell 1!

/*彼女を救出してシェル１中央棟Ｂ２の
電算室へ連れて行け。*/
}
//d




//スネークに無線機ＳＥＮＤ（周波数変更）
resource P057_02_R01_ヴァンプ戦終了２無線機デモ１＿２__f {
//vc115702
ライデン_000: {
Snake ! Tu as entendu ? Je suis arriv&'e
trop tard... L'Arsenal est en train de
s'activer !
}
//	<<<ENGLISH>>>
//	Snake! Did you catch all that!?
//	I didn't make it on time...
//	Arsenal's going active!

/*スネーク、聞こえたか？
間に合わなかった。
アーセナルが動き出す！*/
プリスキン_001: {
Ouais, j'ai entendu !
La sauvegarde des otages attendra.
}
//	<<<ENGLISH>>>
//	Yeah, I heard. The
//	hostage rescue's
//	gonna have to wait.

/*ああ、聞こえた。
人質の救出は後回しだ。*/
ライデン_002: {
Je suis &`a la recherche d'Emma...
}
//	<<<ENGLISH>>>
//	I'm going after Emma.

/*俺はエマを助け出す。*/
プリスキン_003: {
Nous allons prendre la Salle
des ordinateurs !
}
//	<<<ENGLISH>>>
//	We'll secure the Computer Room.

/*わかった。
俺達は電算室を確保する。*/
}
//d

//無線機の小画面に大統領がＭＯを渡す映像が映る
resource P057_02_R01_ヴァンプ戦終了２無線機デモ１＿３__f {
//vc115703
プリスキン_000: {
Il semble impossible d'installer ce virus
sans l'aide d'Emma.
}
//	<<<ENGLISH>>>
//	Looks like we can't install the
//	virus program without Emma.

/*やはりエマでなければウィルスを
侵入させることは出来ないらしい。*/
ライデン_001: {
Ton partenaire ne peut pas le faire ?
}
//	<<<ENGLISH>>>
//	Can't your partner do it?

/*あんたの相棒でも駄目なのか？*/
オタコン_002: {
Si je le pouvais, je le ferais, mais
le syst&`eme de s&'ecurit&'e de ce truc
est costaud... J'ai besoin de temps...
}
//	<<<ENGLISH>>>
//	I would if I could. But the security
//	for this system is no joke. I need
//	more time...

/*出来ればやってる。
ここのセキュリティはよく出来てるよ。
短時間じゃちょっと手が出せない……。*/
プリスキン_003: {
C'est bien pour cela qu'on a besoin
d'elle !
}
//	<<<ENGLISH>>>
//	That's why we need her.

/*そういうことだ。
エマを連れてきてくれ。*/
ライデン_004: {
Bon ! Je vais vous l'organiser,
votre petite r&'eunion de famille...
}
//	<<<ENGLISH>>>
//	Understood. I'll make
//	sure you have your
//	family reunion...

/*わかった。安心してくれ。
ちゃんと兄妹を対面させてみせるさ。*/
オタコン_005: {
...
}
//	<<<ENGLISH>>>
//	...

/*……。*/
ライデン_006: {
Qu'est-ce que tu as ?
}
//	<<<ENGLISH(2)>>>
//	What's up?

/*どうした？*/
オタコン_007: {
Tant d'ann&'ees sont pass&'ees
entre E.E et moi...
}
//	<<<ENGLISH>>>
//	A lot of years have passed
//	between E.E. and me...

/*……ＥＥとは長い間、会ってないんだ。*/
ライデン_008: {
Alors, tu devrais la voir, non ?
}
//	<<<ENGLISH>>>
//	Then you should see her, right?

/*だからすぐ会えるじゃないか。*/
オタコン_009: {
Je n'ai pas le droit de la voir.
}
//	<<<ENGLISH>>>
//	I don't have the right to see her.

/*いや、僕には彼女に逢う資格はないんだ。*/
プリスキン_010: {
Nous reparlerons de cela plus tard.
Raiden, mets-toi en route...
}
//	<<<ENGLISH>>>
//	We can talk about this later.
//	Raiden, I think you'd better
//	get moving,

/*事情があるようだが、時間がない。
エマはその部屋の北にある
ロッカールームだろう？*/
プリスキン_011: {
Emma est dans le vestiaire ver le nord
de la structure, n'est-ce pas ?
}
//	<<<ENGLISH>>>
//	Emma's in the Locker Room
//	to the north, right?

/*ライデン、頼むぞ。*/
ライデン_012: {
J'y vais !
}
//	<<<ENGLISH(2)>>>
//	I'm on it.

/*わかった。*/
}
//d


resource P058_02_R01_エマ救出２無線機デモ１＿１__f {
//vc115801
ライデン_000: {
Tu m'entends, l&`a ?
}
//	<<<ENGLISH>>>
//	Can you hear me, now?

/*聞こえるか？*/
エマ_001: {
En mode de nano-communication ?
}
//	<<<ENGLISH>>>
//	Nanocommunication...?

/*体内通信？*/
ライデン_002: {
Exact. J'ai des nano-machines,
moi aussi !
}
//	<<<ENGLISH>>>
//	That's right.
//	I have nanomachines, too.

/*そうだ、俺の体内にもナノマシンが
注入されている。*/
エマ_003: {
Alors tu n'es pas dans leur camp...
}
//	<<<ENGLISH>>>
//	Then you're not one of them...

/*あいつらとは違う……？*/
ライデン_004: {
C'est ce que j'essaie de te dire
depuis tout &`a l'heure...
}
//	<<<ENGLISH>>>
//	That's what I've been
//	trying to tell you.

/*そういう事だ。*/
エマ_005: {
Et tu es venu pour me sauver ?
}
//	<<<ENGLISH>>>
//	And you came to rescue me?

/*で、私を助けるのが任務？*/
ライデン_006: {
En fait, j'ai besoin de toi
pour arr&^eter l'Arsenal...
}
//	<<<ENGLISH>>>
//	Actually, I need your help
//	to stop Arsenal...

//<ページ数変更>
ライデン_006_1: {
J'ai cru comprendre que tu &'etais
la seule &`a pouvoir faire &~qa.
}
//	<<<ENGLISH>>>
//	I understand you're the only one
//	who might be able to do it.

/*俺はアーセナルを止めに来たんだ。
協力してほしい。あれを止められるのは
君しかいないと聞いた。*/
エマ_007: {
Qui t'a dit cela ?
}
//	<<<ENGLISH>>>
//	And who told you that?

/*……誰からそんなことを？*/
ライデン_008: {
Le Pr&'esident.
}
//	<<<ENGLISH(2)>>>
//	The President.

/*大統領。*/
エマ_009: {
Vraiment ?
}
//	<<<ENGLISH>>>
//	...Really?


/*……ホントに？*/
ライデン_010: {
Il faut que tu m'accompagnes jusqu'&`a
la Shell 1. Ton fr&`ere t'attend l&`a-bas...
}
//	<<<ENGLISH>>>
//	I need you to come with me to
//	Shell 1. Your brother's waiting
//	for you there.

/*一緒にシェル１に来てくれ。
君のお兄さんが待ってる。*/
エマ_011: {
Mon fr&`ere ?
}
//	<<<ENGLISH>>>
//	My brother?

/*お兄ちゃん？*/
ライデン_012: {
Allez !
Il faut qu'on y aille, &`a pr&'esent !
}
//	<<<ENGLISH>>>
//	C'mon!
//	We have to get moving!

/*とにかく、ここを出よう！*/
ライデン_013: {
Tout sera bient&^ot recouvert par les eaux !
}
//	<<<ENGLISH>>>
//	This place'll be flooded soon!

/*いつ浸水するかわからない。*/
}
//d



resource P058_04_R02_エマ救出４無線機デモ２＿１__f {
//vc115811
エマ_000: {
Laisse-moi...
}
//	<<<ENGLISH>>>
//	Leave me...

/*だから、ここに……。*/
ライデン_001: {
Tu sais nager ! Je sais m&^eme que tu
adorais &~qa, avant...
}
//	<<<ENGLISH>>>
//	You can swim!
//	You used to love it!

/*泳げないんじゃない！
エマ、君は泳げたんだ！*/
エマ_002: {
Comment le sais-tu ?
}
//	<<<ENGLISH>>>
//	How did you know...?

/*どうして、そのことを？*/
ライデン_003: {
C'est ton fr&`ere qui me l'a dit.
}
//	<<<ENGLISH>>>
//	Your brother told me.

/*君のお兄さんに聞いた。*/
エマ_004: {
Il est vraiment ici ?
}
//	<<<ENGLISH>>>
//	He's really here?

/*本当に、ここに？*/
ライデン_005: {
Oui... Il est venu pour te sauver.
}
//	<<<ENGLISH>>>
//	That's right... he's
//	here to rescue you.

/*ああ。君を助ける為に。*/
エマ_006: {
C'est faux !
Il ne l&`everait pas le petit doigt pour moi !
}
//	<<<ENGLISH>>>
//	I don't believe you!
//	He would never come for me!

/*ウソよ。
あの男がそんな事をするはずない！*/
ライデン_007: {
Puisque je te dis qu'il est ici --
dans la Shell 1 !
}
//	<<<ENGLISH>>>
//	And I'm telling you he's
//	here -- waiting for us
//	at Shell 1!

/*ウソじゃない。
シェル１で君が来るのを待っている。*/
エマ_008: {
Non ! Il nous a abandonn&'ees, ma m&`ere
et moi, quand nous avions le plus besoin
de lui !
}
//	<<<ENGLISH>>>
//	No! He left me... my mother --
//	when we needed him the most!

/*信じられない！
あの男は私を捨てたの。
私達親子をね。*/
エマ_009: {
A la mort de mon p&`ere,
il ne pensait qu'&`a lui !
}
//	<<<ENGLISH>>>
//	When my father died, all he
//	could think about was himself!

/*父が死んだ、一番辛い時に。
あいつは自分だけ……。*/
ライデン_010: {
Emma, nous en reparlerons plus tard.
Pour l'instant, il faut qu'on parte d'ici !
}
//	<<<ENGLISH>>>
//	Emma, we can go over all that
//	later. But first, we have to get
//	out of here!

/*エマ、恨み言は後でいくらでも聞く。
ここから離れよう！*/
エマ_011: {
Non ! Je d&'eteste l'eau !
}
//	<<<ENGLISH>>>
//	No! I hate water!

/*嫌っ！
水は嫌い！*/
エマ_012: {
C'est inutile ! Je ne sais pas nager...
}
//	<<<ENGLISH>>>
//	It's hopeless!
//	I can't swim!

/*無理よ！泳げないっ！*/
}
//d



resource P058_07_R03_エマ救出７無線機デモ３＿１__f {
//Vc115821
ライデン_000: {
Places ton oreille contre ma poitrine et
&'ecoutes les battements de mon c&@eur,
d'accord ?
}
//	<<<ENGLISH>>>
//	Put your ear against my chest
//	and listen to my heartbeat.

/*俺の心臓のに耳を当てておくんだ。*/
エマ_001: {
Les battements de ton c&@eur ?
}
//	<<<ENGLISH>>>
//	Your heartbeat?

/*心臓？*/
ライデン_002: {
Compte mes battements cardiaques et ne
pense &`a rien d'autre. Quand tu auras
atteint 100, ouvre les yeux.
}
//	<<<ENGLISH>>>
//	Count the beats -- don't think about
//	anything else. When you reach 100,
//	open your eyes.

//<ページ数変更>
ライデン_002_1: {
A ce moment-l&`a, nous serons de l'autre
c&^ot&'e !
}
//	<<<ENGLISH>>>
//	By that time, we'll be
//	on the other side.

/*鼓動の数を数える、ひとつ、ふたつ……
他の事は考えるな。１００まで数えたら、
目を開けろ。向こう側についてる。*/
ライデン_003: {
Si le souffle te manque,
fais-moi signe pour me le dire...
}
//	<<<ENGLISH>>>
//	Give me a signal if you think
//	you're running out of breath.

/*苦しくなったら、合図をくれ。*/
エマ_004: {
Qu'est-ce que &~qa changera ?
}
//	<<<ENGLISH>>>
//	What will you do then?

/*そしたら？*/
ライデン_005: {
Je nagerai plus vite !
}
//	<<<ENGLISH>>>
//	I'll swim faster.

/*できる限り、急いでむこうまで行く。*/
}
//d



resource P059_03_R01_エマ休憩３無線機デモ１＿１__f {
//vc115901
大佐_000: {
Raiden, quelle est ta situation ?
}
//	<<<ENGLISH>>>
//	Raiden, what's your status?

/*ライデン、どうだ？*/
ライデン_001: {
Colonel ? Je suis avec Emma Emmerich.
Nous avons &'echapp&'e &`a la noyade.
}
//	<<<ENGLISH>>>
//	Colonel? I've got Emma Emmerich
//	here... we've managed to avoid
//	drowning.

/*大佐、エマ・エメリッヒを救出……
なんとか溺死するのだけは免れた。*/
大佐_002: {
Bien jou&'e ! Allez le plus vite possible
dans la Shell 1 !
}
//	<<<ENGLISH>>>
//	Good job. Get her over to
//	Shell 1 as soon as you can.

/*よし、
彼女をシェル１まで連れて行くんだ。*/
ライデン_003: {
Vu que la passerelle de connexion du
niveau sup&'erieur est d&'etruite, &~qa ne va
pas &^etre de la tarte !
}
//	<<<ENGLISH>>>
//	That's going to be hard with the
//	connecting bridge on the upper
//	level destroyed.

/*シェル１への上部連絡橋は
破壊されている。*/
大佐_004: {
Olga n'avait pas dit qu'il fallait franchir
la barri&`ere flottante au bas de l'Etai L ?
}
//	<<<ENGLISH>>>
//	Didn't Olga say something about
//	taking the oil fence at the bottom
//	of Strut L?

/*確かオルガが言っていたな。
Ｌ脚下部のオイルフェンスを通って、
と……。*/
ライデン_005: {
Si, je m'en souviens.
}
//	<<<ENGLISH>>>
//	Yeah, I remember that.

/*ああ、覚えている。*/
大佐_006: {
Tu devrais pouvoir descendre au niveau
de l'Etai L. Essaie d'aller l&`a-bas.
}
//	<<<ENGLISH>>>
//	You should be able to go down
//	by way of Strut L. Try and get
//	over there.

/*Ｌ脚から下へ降りられるはずだ。
Ｌ脚に向かえ。*/
ライデン_007: {
Et Emma ? On lui a inject&'e un produit,
qui fait qu'elle est incapable de se
d&'eplacer toute seule.
}
//	<<<ENGLISH>>>
//	What about Emma?
//	She's been injected with something
//	and she can't walk without any help.

/*エマはどうする？薬物の影響らしいが、
一人で歩くのは無理のようだ。*/
大佐_008: {
Prends-la avec toi... Lib&`ere-toi les mains
de tout &'equipement et maintiens la touche
Action enfonc&'ee pour l'aider.
}
//	<<<ENGLISH>>>
//	Take her with you... free your hands
//	of any equipment and hold down the
//	Action button to give her a hand.

/*彼女を引っ張っていくしかない。
素手の状態で＃｛△、アクション｝＃ボタンを押している間、
手をつなぐ。*/
}
//d

//……子画面にエマを連れて進む映像（ＶＲ）……
resource P059_03_R01_エマ休憩３無線機デモ１＿２__f {
//vc115902
大佐_000: {
Pour rel&^acher ton emprise,
retire ton doigt de la touche Action...
}
//	<<<ENGLISH>>>
//	To release your grip on her, take
//	your finger off the Action button.

//<ページ数変更>
大佐_000_1: {
Le cas &'ech&'eant, Emma pourra rester
assise jusqu'&`a ce que tu l'aides de
nouveau.
}
//	<<<ENGLISH>>>
//	Emma can sit and wait until
//	you help her back up.

/*手を離したい時は＃｛△、アクション｝＃ボタンを離すんだ。
手を離すとエマはその場に座り込む。
彼女の手を引っ張ってＬ脚まで行くんだ。*/
大佐_001: {
Attention... Tant que tu la guideras,
tu ne pourras pas utiliser d'arme.
}
//	<<<ENGLISH>>>
//	And be careful... you won't be able
//	to use any weapons while you're
//	leading her.

大佐_002: {
Rends-toi sur l'Etai L, &`a pr&'esent !
}
//	<<<ENGLISH>>>
//	Now, head for Strut L!

//<ページ数変更> 包含
/*だがいいか、彼女の手を引いている間、
武器は使えないぞ。*/
ライデン_004: {
Nous y allons !
}
//	<<<ENGLISH>>>
//	We're on our way.

/*わかった。*/
}
//d




resource P061_01_R01_エマとオタコン１無線機デモ１＿１__f {
//Vc116101.aif
プリスキン_000: {
Raiden, nous nous sommes infiltr&'es
dans la Salle des ordinateurs. Quelle
est ta situation ?
}
//	<<<ENGLISH>>>
//	Raiden, we've infiltrated the
//	Computer Room. What's your
//	situation?

/*ライデン、電算室に侵入した。
どうだ？*/
ライデン_001: {
Emma est en s&'ecurit&'e.
Nous venons vers vous.
}
//	<<<ENGLISH>>>
//	Emma's safe.
//	We're heading your way.

/*エマは無事だ。
これからそっちへ向かう。*/
オタコン_002: {
Bravo !
}
//	<<<ENGLISH>>>
//	Good job!

/*よかった……。*/
プリスキン_003: {
Il n'y a pas un chat sur la Shell 1.
On dirait que tout le monde est
sur l'Arsenal.
}
//	<<<ENGLISH>>>
//	Shell 1's deserted. Looks like
//	everybody's aboard Arsenal.

/*シェル１には誰もいない。
皆アーセナルに乗り込んだようだ。*/
オタコン_004: {
J'ai examin&'e le syst&`eme, mais en vain.
E.E est notre seul espoir...
}
//	<<<ENGLISH>>>
//	I had a look at the system, but
//	there's nothing I can do. E.E.'s
//	our only hope...

/*いろいろやってみたけどやっぱり
僕じゃ手が出せない。ＥＥでなきゃ……。*/
ライデン_005: {
Bien... Dans ce cas, je te la passe.
}
//	<<<ENGLISH>>>
//	Right... I'll put her on then.

/*それじゃ、エマに変わる。*/
オタコン_006: {
Hein ? E.E ? Comment... ?
}
//	<<<ENGLISH(2)>>>
//	Huh? E.E.? How...?

/*えっ、ＥＥに……。*/
ライデン_007: {
Mon Codec me servira de relais.
}
//	<<<ENGLISH>>>
//	I'll use my Codec as a relay.

/*俺の体内通信を中継する。*/
オタコン_008: {
Heu... Hum...
}
//	<<<ENGLISH>>>
//	Ahem, ummm...

/*あ、あ……。*/
ライデン_009: {
La voici...
}
//	<<<ENGLISH>>>
//	Here she is...

/*代わるぞ？*/
エマ_010: {
Heu... Hal ?
}
//	<<<ENGLISH>>>
//	Uh... Hal...?

/*……お兄ちゃん？*/
//無線機画面、ライデンの変わりにオタコンが表示される。オタコンを動かすことはできるが、相づちはうてないようにする。
}
//d

resource P061_01_R01_エマとオタコン１無線機デモ１＿２__f {
//vcxxxxxxxxx
オタコン_000: {
E.E ? C'est bien toi ?
}
//	<<<ENGLISH(2)>>>
//	Ah... E.E.? Is that you?

/*ＥＥかい？*/
エマ_001: {
Hal...
}
//	<<<ENGLISH(2)>>>
//	Hal...

/*お兄ちゃん……。*/
オタコン_002: {
E.E...
}
//	<<<ENGLISH>>>
//	E.E....


/*ＥＥ……。*/
オタコン_003: {
Heu... Pourquoi as-tu collabor&'e
au projet du Metal Gear ?
}
//	<<<ENGLISH>>>
//	Uh... why're you involved
//	with Metal Gear?

/*ＥＥ、なぜメタルギアなんかに手を？*/
エマ_004: {
Hein ???
}
//	<<<ENGLISH>>>
//	Huh???

/*えっ？？*/
オタコン_005: {
Tu connais le lourd pass&'e de notre famille
et, tu t'es quand m&^eme associ&'ee &`a ce
projet ? Qu'as-tu dans la t&^ete ?
}
//	<<<ENGLISH>>>
//	You knew our family's dark history,
//	and still got involved!? What's
//	wrong with you!?

/*僕たちの呪われた家系を知っているだろ？
どうしてなんだ？*/
エマ_006: {
Cela m'aurait &'etonn&'ee...
}
//	<<<ENGLISH>>>
//	I should've known...

/*……やっぱり。*/
オタコン_007: {
R&'eponds-moi !
Pourquoi refais-tu la m&^eme erreur ?
}
//	<<<ENGLISH>>>
//	Answer me! Why are you
//	repeating the same mistake?

/*どうしてだ？
どうして同じ過ちを繰り返す？*/
エマ_008: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
エマ_009: {
Je voulais te faire du mal...
Je voulais te voir souffrir...
}
//	<<<ENGLISH>>>
//	I wanted to hurt you...
//	I wanted to see you suffer...

/*あなたに会って、
あなたを苦しめたかったから……。*/
オタコン_010: {
E.E...?
}
//	<<<ENGLISH>>>
//	E.E....?


/*ＥＥ？*/
エマ_011: {
Tu m'as abandonn&'ee...
}
//	<<<ENGLISH>>>
//	You abandoned me --

/*あなたは私を捨てた……。*/
オタコン_012: {
Non ! Tu te trompes...
}
//	<<<ENGLISH>>>
//	No!
//	That's not what happened...

/*違う。そうじゃない。*/
プリスキン_013: {
Bon ! Calmez-vous, maintenant !
}
//	<<<ENGLISH>>>
//	Alright -- that's enough!

/*二人とも、やめるんだ。*/
オタコン_014: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
エマ_015: {
Qui es-tu ?
}
//	<<<ENGLISH(2)>>>
//	Who are you?

/*誰？*/
プリスキン_016: {
Je suis un ami d'Otacon, Emma.
}
//	<<<ENGLISH>>>
//	I'm a friend of Otacon's, Emma.

/*エマ、俺はオタコンの友人だ。*/
エマ_017: {
Otacon...
}
//	<<<ENGLISH(2)>>>
//	Otacon...

/*オタコン……。*/
プリスキン_018: {
J'en ai assez de votre rivalit&'e
entre fr&`ere et s&@eur !
}
//	<<<ENGLISH>>>
//	Enough with the sibling rivalry.

/*兄妹喧嘩なら、後でしろ。*/
エマ_019: {
Mais ce n'est pas ce dont il s'agit !
}
//	<<<ENGLISH>>>
//	That's not what this is!!

/*兄妹喧嘩じゃないわ！*/
プリスキン_020: {
Nous avons autre chose &`a faire,
pour l'instant ! Raiden ! Fais-la
venir imm&'ediatement !
}
//	<<<ENGLISH>>>
//	We haven't got time for this!
//	Raiden! Get her over here,
//	right now.

/*一刻を争うんだ！
ライデンとこっちに来てくれ。*/
エマ_021: {
Je...
}
//	<<<ENGLISH>>>
//	I -- I...

/*う、うん。*/
ライデン_022: {
C'est compris, Snake.
Nous arrivons !
}
//	<<<ENGLISH>>>
//	Gotcha, Snake. I'll head
//	over there with Emma.

/*わかった、スネーク。
エマを連れて行く。
*/
プリスキン_023: {
Presque tous nos adversaires sont sur
l'Arsenal, mais je sois tout de m&^eme
prudent. 
}
//	<<<ENGLISH>>>
//	Most of the enemy's aboard
//	Arsenal. But I suggest you
//	be careful.

//<ページ数変更>
プリスキン_023_1: {
Emma doit arriver ici en entier !
}
//	<<<ENGLISH>>>
//	Make sure Emma gets
//	here in one piece.

/*奴ら、ほとんどアーセナルに乗り込んで
いると思うが気をつけろ。
エマに怪我をさせるな。*/
オタコン_024: {
Raiden... Prends bien soin de ma s&@eur !
}
//	<<<ENGLISH>>>
//	Raiden... take care of my sister.

/*ライデン……頼む……。*/
ライデン_025: {
Ne t'inqui&`ete pas !
Je te l'am&`ene tout de suite !
}
//	<<<ENGLISH>>>
//	Don't worry.
//	I'll get her there.

/*わかった。まかせてくれ。*/
}
//d



resource P062_03_R01_エマとＡＩ３無線機デモ１＿１__f {
//vc116201
ライデン_000: {
Tu me re&~qois, Emma ?
}
//	<<<ENGLISH>>>
//	Are you reading me, Emma?

/*エマ、いいかい？*/
エマ_001: {
Oui -- cinq sur cinq !
}
//	<<<ENGLISH>>>
//	Yes -- loud and clear.

/*ええ、大丈夫……。*/
ライデン_002: {
Le Pr&'esident a dit que l'Arsenal Gear &'etait
vital pour la supr&'ematie des Patriotes...
}
//	<<<ENGLISH>>>
//	The President said that Arsenal
//	Gear was the Patriots' key to
//	supremacy.

/*大統領は『Ｇ．Ｗ』とアーセナルギアが
『愛国者達』の切り札だと言った。*/
エマ_003: {
C'est un point de vue qui tient la route !
}
//	<<<ENGLISH>>>
//	That's as good a description as any.

/*そうね。
そういえるかも。*/
ライデン_004: {
En quoi consiste l'Arsenal Gear, 
au juste ?
}
//	<<<ENGLISH>>>
//	What exactly is it?

/*一体、どういうものなんだ？*/
エマ_005: {
C'est un system eg&'eant de traitement
des donn&'ees capable de contr&^oler les
informations &'echang&'ees &`a l'&'echelon
mondial.
}
//	<<<ENGLISH>>>
//	It's a massive data processing
//	system capable of controlling
//	information on a global scale.

/*世界規模の情報統制を行なうための
超大規模情報処理システム。*/
ライデン_006: {
Un syst&`eme de traitement des donn&'ees ?
}
//	<<<ENGLISH>>>
//	A data processing system...?

/*情報処理システム？*/
エマ_007: {
Exactement ! Ce syst&`eme est en fait
un m&'ecanisme social qui permet aux
Patriotes de garder le contr&^ole...
}
//	<<<ENGLISH>>>
//	That's right. The system's a
//	social device for maintaining
//	the Patriots' control.

/*ええ。『愛国者達』が支配を
継続していくための社会装置……。*/
ライデン_008: {
Je ne te suis plus !
}
//	<<<ENGLISH>>>
//	You've lost me.

/*なんだそれは？*/
エマ_009: {
A notre &'epoque, les informations
fusent des quatre coins du monde
et sont librement &'echang&'ees...
}
//	<<<ENGLISH>>>
//	In this day and age, information
//	emerges from every direction,
//	and is freely distributed...

/*現代ではあらゆるところから情報が
生まれて、流通する……。*/
エマ_010: {
Des informations vari&'ees -- rassembl&'ees
par des serveurs utilisant des r&'eseaux de
communication tr&`es rapides
}
//	<<<ENGLISH>>>
//	A variety of information - gathered
//	by servers employing the latest in
//	high-speed communication networks

//<ページ数変更>
エマ_010_1: {
et recourant &`a la technologie P2P --
circulent rapidement entre les gens.
}
//	<<<ENGLISH>>>
//	and P2P technology - is rapidly
//	circulated to individuals.

/*高速通信網の整備とＰ２Ｐ技術の発達で
サーバに集約されていた情報が個人に
分散されるようになって、*/
エマ_011: {
On peut dire que ce type de circulation
est chaque jour plus rapide que la veille...
}
//	<<<ENGLISH>>>
//	In fact, the speed of this circulation
//	process is accelerating on an almost
//	daily basis.

/*その流れはますます加速してるの。*/
エマ_012: {
Les Patriotes semblent craindre
cette situation
}
//	<<<ENGLISH>>>
//	The Patriots seem to be
//	afraid of this development.

/*彼等はそれに強い危機感を
持ってるみたい。*/
エマ_013: {
et pensent qu'ils vont passer du statut
de 'dominant' &`a celui de 'domin&'e'.
}
//	<<<ENGLISH>>>
//	Apparently, they believe that their
//	role will shift from dominant to
//	dominated.

/*近いうちに支配する側が支配される側に
取り込まれてしまうんじゃないかって、
ね。*/
ライデン_014: {
?
}
//	<<<ENGLISH(2)>>>
//	?

/*？*/
エマ_015: {
Je te donn un exemple... Tu sais que
Solid Snake &@euvre contre le Metal Gear,
n'est-ce pas ?
}
//	<<<ENGLISH>>>
//	Let me give you an example. You're
//	aware of Solid Snake's anti-Metal
//	Gear activities, aren't you?

/*例えばあなたはソリッド・スネークの
反メタルギア活動を知っているでしょう？*/
ライデン_016: {
Oui -- c'est ce que j'ai entendu dire.
}
//	<<<ENGLISH>>>
//	Yeah -- I know a little about it.

/*ああ……少しは。*/
エマ_017: {
Ce fait constitue un petit &'echantillon
d'informations non contr&^ol&'ees.
}
//	<<<ENGLISH>>>
//	That's just a small sample of
//	uncontrolled information.

//<ページ数変更>
エマ_017_1: {
Je te garantis que les Patriotes n'avaient
pas envie de faire de la pub &`a Solid 
Snake !
}
//	<<<ENGLISH>>>
//	I can guarantee you the Patriots
//	did not want Solid Snake's name
//	publicized.

/*それが一番の証拠。ソリッド・スネーク
の名は『愛国者達』にとって最も
口外されてはいけないものなの。
*/
エマ_018: {
A pr&'esent, pense aux scandales politiques,
&`a la corruption commerciale, etc.
}
//	<<<ENGLISH>>>
//	Now, look at it like this...
//	political scandal, corporate
//	corruption...

/*それは一例に過ぎない。政治家の醜聞、
企業の不正……*/
エマ_019: {
Jusqu'&`a pr&'esent, les Patriotes &'etaient en
mesure d'&'etouffer ces affaires et autres
actes int&'eress&'es.
}
//	<<<ENGLISH>>>
//	up until now, the Patriots have
//	managed to keep a lid on these
//	and other self-serving events.

/*今までなら『愛国者達』の力で隠されていた事実が簡単に暴かれてしまう。*/
エマ_020: {
Mais le syst&`eme qu'ils poss&`edent pour
traiter les donn&'ees ne leur permet plus
}
//	<<<ENGLISH>>>
//	But with their existing data
//	processing system, they are
//	no longer able to effectively＃−

//<ページ数変更>
エマ_020_1: {
de contr&^oler efficacement le flux
des informations g&'en&'er&'ees au
niveau individuel.
}
//	<<<ENGLISH>>>
//	control the flow of information
//	generated at the individual level.

/*現行のシステムでは個人から発信される
情報を抑えきることは出来ないの。
*/
エマ_021: {
Gr&^ace au nouveau syst&`eme, ils peuvent
enti&`erement r&'eguler les informations
num&'eriques.
}
//	<<<ENGLISH>>>
//	With the newly created system,
//	they can fully regulate digital
//	information.

/*だから新しいシステムで、
デジタル化された全ての情報統制を行う。*/
エマ_022: {
Les donn&'ees de haut niveau sont class&'ees
par ordre d'importance, ob&'eissent &`a un
niveau d'autorisation d&'etermin&'e
}
//	<<<ENGLISH>>>
//	High-level information can be
//	categorized in stages, given
//	clearance levels,

//<ページ数変更>
エマ_022_1: {
et sont effac&'ees selon les besoins --
sans jamais &^etre connues du public !
}
//	<<<ENGLISH>>>
//	and deleted as necessary --
//	never to be seen by the public.

/*高度な情報は段階を経て、
クリアランスが付けられ、
一般公開から削除されていく。
*/
エマ_023: {
En effa&~qant ce genre d'informations,
les Patriotes sont en mesure de
fa&~qonner l'Histoire &`a leur guise...
}
//	<<<ENGLISH>>>
//	By deleting such information, the
//	Patriots can shape the course of
//	history as they see fit.

/*これが動き出せば、数年で様々な情報は
歴史からいっせいに削除されることに
なる……。*/
ライデン_024: {
Quelqu'un s'enapercevra forc&'ement
un jour...
}
//	<<<ENGLISH>>>
//	Somebody's bound to catch on --

/*誰かが気づくはずだ。*/
エマ_025: {
Non ! La m&'emoire et la dur&'ee
de vie moyennes
}
//	<<<ENGLISH>>>
//	No. The memory capacity --
//	not to mention the life span --

//<ページ数変更>
エマ_025_1: {
des gens sont extr&^emement limit&'ees. 
}
//	<<<ENGLISH>>>
//	of the average individual
//	is extremely limited.

/*いいえ、人の記憶容量は極めて小さい。
人の寿命も短い。
*/
エマ_026: {
A l'inverse, les informations num&'eriques
sont pratiquement &'eternelles
}
//	<<<ENGLISH>>>
//	On the other hand, digital
//	information lasts virtually
//	forever...

//<ページ数変更>
エマ_026_1: {
et ne se d&'et&'eriorent pas...
}
//	<<<ENGLISH>>>
//	it doesn't deteriorate.

/*永遠に残るのはデジタル化されたもの
だけ。劣化しないから。
*/
ライデン_027: {
Et alors ?
}
//	<<<ENGLISH(2)>>>
//	So...?

/*ばかな……。*/
エマ_028: {
L'alphabet contient 26 lettres, n'est-ce
pas ? Il aurait pu en avoir 30 !
}
//	<<<ENGLISH>>>
//	The alphabet... twenty-six letters,
//	right? It could've been thirty letters.

/*例えばアルファベットは２６文字だと
思われている。でも本来は３０文字
だったかもしれない。
*/
エマ_029: {
Et si un programme contr&^olait
les 4 lettres effac&'ees ?
}
//	<<<ENGLISH>>>
//	What if the 4 deleted letters
//	were controlled by a program?

/*その削除された４文字をプログラムで
統制しているとしたら……。
*/
ライデン_030: {
C'est impossible !
}
//	<<<ENGLISH(2)>>>
//	Impossible.

/*ありえない。*/
エマ_031: {
Faux ! D'ailleurs, un processus similaire
est d&'ej&`a en place...
}
//	<<<ENGLISH>>>
//	It's not. In fact, something
//	similar is already underway.

//<ページ数変更>
エマ_031_1: {
Sais-tu combien nous avons de g&`enes ?
}
//	<<<ENGLISH>>>
//	Do you know how many genes
//	exist in an individual?

/*いいえ。それは既に行われつつある。
じゃあ、人の遺伝子数はいくつか
知ってる？
*/
ライデン_032: {
Entre 30 et 40 mille ?
}
//	<<<ENGLISH>>>
//	About 30 to 40 thousand?

/*３万から４万個？*/
エマ_033: {
Exact ! C'est ce qui a &'et&'e annonc&'e
&`a la fin du si&`ecle dernier.
}
//	<<<ENGLISH>>>
//	Right. That's what was announced
//	at the turn of the century.

//<ページ数変更>
エマ_033_1: {
En r&'ealit&'e, il y en aurait 100 mille,
d'apr&`es la th&'eorie 
}
//	<<<ENGLISH>>>
//	But there's actually 100 thousand,
//	according to the original theory＃−

//<ページ数変更>
エマ_033_2: {
&'enonc&'ee &`a l'&'epoque par la communaut&'e
scientifique.
}
//	<<<ENGLISH>>>
//	advanced by the scientific
//	community.

/*ええ。今世紀の初めにそう発表された。
でも本当は、それ以前の学説通りの
１０万個なの。
*/
エマ_034: {
Les informations concernant les 60 mille
autres g&`enes ont &'et&'e supprim&'ees par
les Patriotes.
}
//	<<<ENGLISH>>>
//	Information regarding the
//	remaining 60 thousand was
//	suppressed by the Patriots.

/*残りの６万個が『愛国者達』に
情報統制されている……。*/
ライデン_035: {
Non...
}
//	<<<ENGLISH(2)>>>
//	No...

/*嘘だ！*/
エマ_036: {
Pourquoi pas ?
Comment peux-tu le savoir ?
}
//	<<<ENGLISH>>>
//	Why? How would you know?

/*それが嘘だと、どうしてあなたに
分かるの？*/
エマ_037: {
Tu sais &`a quoi ressemble un g&`ene, toi ?
Tu les as compt&'es ?
}
//	<<<ENGLISH>>>
//	Do you know what a gene looks like?
//	Did you count them yourself?

/*遺伝子がどんなものか、
あなたは本当に知ってるの？*/
ライデン_038: {
Il y a quand m&^eme des organismes
de recherche...
}
//	<<<ENGLISH>>>
//	There are research organizations...

/*……研究機関なら……。*/
エマ_039: {
Bien s&^ur ! Mais leurs rapports ont
d&'ej&`a subi quelques modifications
}
//	<<<ENGLISH>>>
//	Of course... and their reports have
//	already been subtly altered.

//<ページ数変更>
エマ_039_1: {
et, ils commencent &`a croire ce que
racontent les rapports trafiqu&'es.
}
//	<<<ENGLISH>>>
//	They're even beginning to
//	believe the doctored reports.

/*勿論、研究論文もすべて情報改竄されて
るわ。そしてそのうち自分が間違いで
あったと錯覚する。
*/
エマ_040: {
Gr&^ace au syst&`eme GW, les Patriotes
choisissent ce qui sera retenu dans les
livres d'histoire.
}
//	<<<ENGLISH>>>
//	GW is a system that allows the
//	Patriots to decide what will be
//	recorded in tomorrow's history.

/*『Ｇ．Ｗ』は人の歴史を後世に
どう残すか、それを『愛国者達』が
決めるためのシステム……。*/
ライデン_041: {
Tu veux dire qu'il y a un &'enorme
syst&`eme de censure
}
//	<<<ENGLISH>>>
//	So what we're talking about is
//	one huge censorship system for
//	deleting information＃−

//<ページ数変更>
ライデン_041_1: {
qui efface les informations qui sont
n&'efastes aux Patriotes ?
}
//	<<<ENGLISH>>>
//	which might be inconvenient
//	to the Patriots?

/*つまり『愛国者達』に都合の悪い情報を
削除する大掛かりな検閲装置という
ことか？
*/
エマ_042: {
Exactement ! Le noyau physique assurant
ces fonctions-- le GW -- est install&'e dans
l'Arsenal.
}
//	<<<ENGLISH>>>
//	Exactly. The actual, physical core
//	for handling the task -- GW -- is
//	installed in Arsenal.

/*ええ。それを行う中枢システムの物理的
実体がアーセナルの中にあるの。*/
エマ_043: {
Ce syst&`eme est le seul au monde &`a
&^etre dot&'e d'une intelligence artificielle
neuronale optique
}
//	<<<ENGLISH>>>
//	It's the only system in the world
//	with an optic neural AI＃−

/*『Ｇ．Ｗ』。
*/
エマ_044: {
dont la capacit&'e de traitement parall&`ele
atteint 980 trillions de hammets.
}
//	<<<ENGLISH>>>
//	that has a parallel processing
//	capacity of 980 trillion hammets.

/*世界に一つしかない９８０兆ハメットの
複雑さを持つ光ニューロＡＩ……。*/
ライデン_045: {
C'est en ta sp&'ecialisation en intelligence
artificielle neuronale et logique complexe
}
//	<<<ENGLISH>>>
//	I suppose that being a specialist
//	in neural AI and complex logic＃−

//<ページ数変更>
ライデン_045_1: {
qui t'a fait participer au projet
du Metal Gear ?
}
//	<<<ENGLISH>>>
//	played a significant role
//	in your association with
//	the Metal Gear project.

/*それが理由か？ニューロＡＩと
複雑性理論の専門家の君が
メタルギア開発に関わっていたのは……。
*/
エマ_046: {
C'&'etait une des raisons...
}
//	<<<ENGLISH>>>
//	That's not the only reason...

/*それだけじゃないけどね……。*/
ライデン_047: {
C'est-&`a-dire ?
}
//	<<<ENGLISH(2)>>>
//	What do you mean?

/*え？*/
エマ_048: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
ライデン_049: {
Il y a s&^urement un tas d'autres raisons...
}
//	<<<ENGLISH>>>
//	I guess there're plenty
//	of other reasons.

/*……まぁ、きっと事情があるんだろうな。*/
エマ_050: {
Effectivement...
}
//	<<<ENGLISH>>>
//	Yes, there are --

/*うん……。*/
ライデン_051: {
Je comprends...
}
//	<<<ENGLISH>>>
//	I understand...

/*わかるよ。*/
エマ_052: {
Vraiment ?
}
//	<<<ENGLISH(2)>>>
//	Do you?

/*……そう……？*/
ライデン_053: {
L'Arsenal Gear a donc &'et&'e con&~qu pour
prot&'eger le syst&`eme GW ?
}
//	<<<ENGLISH>>>
//	So Arsenal Gear was actually
//	designed to protect the GW
//	system, wasn't it?

/*ではアーセナルギアは『Ｇ．Ｗ』を
守るために建造された？*/
エマ_054: {
Heu... oui. Il poss&`ede un armement
complet, dont des armes nucl&'eaires.
}
//	<<<ENGLISH>>>
//	Uh...yes. It's armed with
//	everything including nuclear
//	weapons,

//<ページ数変更>
エマ_054_1: {
En outre, il est parfaitement &'equip&'e
pour faire face au cyber-terrorisme.
}
//	<<<ENGLISH>>>
//	and is fully equipped with
//	cyber-terrorist countermeasures.

/*……ええ。核兵器を含めた最高の武装を持ち、サイバーテロ対策も完璧。
物理的にも論理的にも史上最強の要塞。
*/
エマ_056: {
Aux niveaux physique et logique, aucune
forteresse ne prot&'egera mieux le syst&`eme
GW que l'Arsenal Gear !
}
//	<<<ENGLISH>>>
//	Physically and logically,
//	it's the ultimate fortress
//	for housing GW.

/*『Ｇ．Ｗ』の器。*/
ライデン_057: {
Mais est-ce que l'intelligence artificielle
est capable de tout contr&^oler ?
}
//	<<<ENGLISH>>>
//	But is the AI actually capable
//	of controlling everything?

/*だが、そのＡＩだけで全てを制御出来る
とは思えないが。*/
エマ_058: {
Non. Le GW constitue uniquement
le noyau du syst&`eme. Il se contente
de s&'electionner les donn&'ees &`a stocker
et &`a effacer.
}
//	<<<ENGLISH>>>
//	No. GW is only the system's core.
//	It's only for deciding what data
//	is stored or deleted.

/*ええ。『Ｇ．Ｗ』はあくまでも
システムの中枢。何を残すか、
何を削除するかを判断するためのね。*/
エマ_059: {
Le sous-syst&`eme qui ex&'ecute les t&^aches
proprement dites se trouve dans notre
structure sociale...
}
//	<<<ENGLISH>>>
//	The actual sub-system for
//	executing the task exists
//	within our social structure...

/*それを実行するサブシステムは
既に社会に埋め込まれている……。*/
ライデン_060: {
Quoi !?
}
//	<<<ENGLISH(2)>>>
//	What!?

/*どういうことだ？*/
}
//d


resource P062_05_R02_エマとＡＩ５無線機デモ２＿１__f {
//vc116211
ライデン_000: {
Laisse-moi deviner... Le rem&`ede contre
le bogue de l'an 2000 contenait un
programme con&~qu par les Patriotes ?
}
//	<<<ENGLISH>>>
//	Let me guess... the Y2K
//	countermeasure contained a program
//	designed by the Patriots?

/*その中に『愛国者達』のプログラムが
仕込まれていたと？*/
エマ_001: {
Evidemment ! Et depuis ce jour-l&`a, tout ce
qui est livr&'e contient le m&^eme programme.
}
//	<<<ENGLISH>>>
//	Yes. And everything supplied from
//	that day onward contains the same
//	program.

/*ええ。
勿論、それ以降に作られたものには
初めからそのシステムが組み込んである。*/
ライデン_002: {
C'est impossible !
}
//	<<<ENGLISH(2)>>>
//	Impossible.

/*そんな馬鹿な……。*/
エマ_003: {
Sais-tu comment fonctionne
un ordinateur ?
}
//	<<<ENGLISH>>>
//	Do you know how
//	a computer operates?

/*どうしてそう言えるの？コンピュータが
どうやって動作しているのか、あなたは
知ってるの？
*/
エマ_004: {
Connais-tu les principes de base r&'egissant
l'&'echange des donn&'ees ?
}
//	<<<ENGLISH>>>
//	Do you really know the basic
//	principles on how data is
//	exchanged?

/*この通信がどういう原理なのかだって
本当は分かってないでしょ？
*/
ライデン_005: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
エマ_006: {
Personne ne le sait, mais il existe
un sous-syst&`eme... Et il est sur le point
d'&^etre activ&'e !
}
//	<<<ENGLISH>>>
//	Nobody's aware of it, but
//	there's a sub-system in place.
//	And it's about to be activated.

/*誰も知らないけど、そのシステムは
実在する。そしてそれらはもうすぐ
一斉に動き出す……。*/
ライデン_007: {
C'est pour &~qa que Solidus projette une
frappe nucl&'eaire sur Manhattan et an&'eantit
tous les circuits &'electriques de la ville ?
}
//	<<<ENGLISH>>>
//	Is that why Solidus wants to burn
//	out every electrical circuit in
//	Manhattan with a nuclear blast?

/*ソリダスが核爆発でマンハッタン全ての
電子回路を焼き切ろうとしているのは
そのため……？*/
エマ_008: {
S&^urement... Mais le syst&`eme n'est
pas encore op&'erationnel.
}
//	<<<ENGLISH>>>
//	Probably.
//	But the overall system
//	isn't actually complete.

/*そうかもね。
でもシステムはまだ完成してるわけ
じゃない。*/
ライデン_009: {
Quoi ?
}
//	<<<ENGLISH(2)>>>
//	What?

/*え？*/
エマ_010: {
Il ne dispose toujours pas des facteurs qui
lui permettraient de porter des jugements.
}
//	<<<ENGLISH>>>
//	It still lacks the necessary
//	factors for judging situations.

/*状況を判断するための＃｛因子、ファクター｝＃が
不足してるの。*/
エマ_011: {
Il para&^it qu'ils vont faire une exp&'erience
importante, au cours des prochains jours,
}
//	<<<ENGLISH>>>
//	I heard they were planning a major
//	experiment in the next few days,

//<ページ数変更>
エマ_011_1: {
pour donner au GW des donn&'ees
complexes &`a &'etudier.
}
//	<<<ENGLISH>>>
//	to provide complex data
//	for GW to study.

/*その複雑さを『Ｇ．Ｗ』に学習させる
ために大規模な実験を近日中に
行うって話は聞いていたんだけど……。
*/
エマ_012: {
Et nous voici tout &`a coup confront&'es
&`a cette trag&'edie...
}
//	<<<ENGLISH>>>
//	And suddenly all this happens...

/*突然、こんなことが起こって……。*/
ライデン_013: {
Emma... Ce n'est pas ta faute.
Sons ces terroristes...
}
//	<<<ENGLISH>>>
//	Emma... it's not your fault.
//	If it wasn't for the terrorists...

/*……エマ、これはテロだ。
君が悪いんじゃない……。*/
エマ_014: {
Tu as s&^urement raison...
}
//	<<<ENGLISH>>>
//	Yeah... you're right...

/*……うん……そうね……。*/
エマ_015: {
Bon... Je crois t'avoir dit tout
ce que je sais !
}
//	<<<ENGLISH>>>
//	Well... I think that's
//	about all I know.

/*うん。
……とりあえず私が知ってるのは
これくらい、かな。*/
ライデン_016: {
D'accord... Heu, merci ! On ferait mieux
de se diriger vers la Salle des ordinateurs,
alors...
}
//	<<<ENGLISH>>>
//	Right... uh, thanks. I think
//	we'd better head for the
//	Computer Room.

/*そうか……ありがとう。
じゃあ電算室へ急ごうか？*/
エマ_017: {
Mon oiseau dans la Salle
des ordinateurs ! Il va bien !?
}
//	<<<ENGLISH>>>
//	My bird in the Computer
//	Room! Is he safe!?

/*鳥は無事？
電算室にいた……。*/
}
//d




resource P064_01_R01_エマライデンローズ無線１無線機デモ１＿１__f {
//vc116401
ローズ_000: {
Alors, Jack ! On dirait que tu t'entends
&`a merveille avec ton Emma !
}
//	<<<ENGLISH>>>
//	Well, Jack. It sounds like you
//	and Miss Emma are getting
//	along just fine.

/*ジャック、エマさんと仲がいいようね。*/
ライデン_001: {
Rose ?
}
//	<<<ENGLISH(2)>>>
//	Rose?

/*ローズ、何を言っている？*/
ローズ_002: {
J'ai suivi tous vos d&'eplacements et vos
conversations et je dois dire que je ne me
suis pas franchement amus&'ee...
}
//	<<<ENGLISH>>>
//	I've been monitoring your
//	every move and conversation.
//	I can't say it's been fun...

/*私、あなたの行動や会話を全部モニター
してるのよ。あまりいい気はしないわ。*/
ライデン_003: {
Fiche-moi la paix ! J'essaie seulement
de la mettre &`a l'aise !
}
//	<<<ENGLISH>>>
//	Give me a break! I'm only
//	trying to keep her spirits up.

/*誤解するな。
俺はエマを勇気づけてるだけだ。*/
ローズ_004: {
Vraiment ?
}
//	<<<ENGLISH>>>
//	Is that right?

/*そうなの、ジャック？*/
ライデン_005: {
Evidemment ! J'ai pour mission de
l'amener &`a la Salle des ordinateurs.
}
//	<<<ENGLISH>>>
//	Absolutely. My mission is to get
//	her to the Computer Room.

/*ああ。
彼女を電算室まで連れて行くのが任務だ。*/
ローズ_006: {
Et c'est tout ?
}
//	<<<ENGLISH>>>
//	That's all?

/*それだけ？*/
ライデン_007: {
Oui !
}
//	<<<ENGLISH(2)>>>
//	Yeah.

/*……ああ。*/
ローズ_008: {
Tu mens... Elle te pla&^it, pas vrai ?
}
//	<<<ENGLISH>>>
//	You're lying.
//	You're attracted
//	to her, aren't you.

/*嘘っ、ちょっとはいいと思ってる？*/
ライデン_009: {
C'est vrai qu'elle est jolie...
}
//	<<<ENGLISH>>>
//	...I'll admit she's cute.

/*ああ、エマはかわいい娘だ。*/
ローズ_010: {
Plus que moi ?
}
//	<<<ENGLISH>>>
//	Cuter than me?

/*私より？*/
ライデン_011: {
Mais Rose, enfin ! Toi, tu es belle
et je t'aime, c'est diff&'erent !
}
//	<<<ENGLISH>>>
//	Rose, you're beautiful.
//	You know how I feel about
//	you.

/*ローズ、君は素敵だ。
俺の気持ちに代わりはない。*/
ローズ_012: {
Tes souvenirs sont revenus, &`a pr&'esent ?
}
//	<<<ENGLISH>>>
//	Have you remembered yet?

/*じゃあ、思い出した？*/
ライデン_013: {
Tu parles du 30 avril ?
}
//	<<<ENGLISH>>>
//	You mean April 30th?

/*４月３０日のこと？*/
ローズ_014: {
Oui !
}
//	<<<ENGLISH(2)>>>
//	Yes.

/*そう。*/
ライデン_015: {
C'est le jour de ton anniversaire,
n'est-ce pas ?
}
//	<<<ENGLISH>>>
//	It's your birthday, isn't it.

/*君の誕生日？*/
ローズ_016: {
Faux ! Tu as tout faux !
}
//	<<<ENGLISH>>>
//	Wrong!
//	You're not even warm!

/*ブブー！
外れ！
大外れ！*/
ライデン_017: {
Qu'est-ce que c'est, alors ?
}
//	<<<ENGLISH>>>
//	What is it then?

/*意地悪だな。*/
ローズ_018: {
Laisse tomber... Ce n'est rien.
Je suis juste un peu jalouse...
}
//	<<<ENGLISH>>>
//	Forget it... it's nothing.
//	Maybe I'm just a little...
//	a little jealous...

/*……ごめんなさい。ちょっとした冗談、
なんだか、いいムードだったから……
ちょっとやけちゃったかな……。*/
ライデン_019: {
Rose ?
}
//	<<<ENGLISH(2)>>>
//	Rose?

/*ローズ？*/
ローズ_020: {
Tu ferais mieux de te remettre en route.
Bonne chance !
}
//	<<<ENGLISH>>>
//	You'd better get moving.
//	Good luck.

/*じゃあね、がんばって。*/
}
//d




resource P065_02_R01_エマＬ脚２無線機デモ１＿１__f {
//vc116501
ライデン_000: {
J'ai une question &`a te poser.
}
//	<<<ENGLISH>>>
//	I have a question for you.

/*……聞いていいか？*/
エマ_001: {
De quoi s'agit-il ?
}
//	<<<ENGLISH(2)>>>
//	What is it?

/*なに？*/
ライデン_002: {
Les hauteurs, &~qa t'&'evoque quoi ?
}
//	<<<ENGLISH>>>
//	How do you feel about heights?

/*高いところは苦手か？*/
エマ_003: {
Je n'aime pas trop les hauteurs, mais
ma phobie num&'ero reste pas moins l'eau.
Pourquoi ?
}
//	<<<ENGLISH>>>
//	I can't say I like heights...
//	though water's higher on
//	my phobia list. Why?

/*嫌い。
水の中よりはマシだけど……
どうしてそんなこと聞くの？*/
ライデン_004: {
Eh bien... Il va falloir qu'on descende
une &'echelle...
}
//	<<<ENGLISH>>>
//	Well... we have to
//	go down a ladder.

/*これからハシゴで下に降りる。*/
エマ_005: {
On va devoir descendre tr&`es bas ?
}
//	<<<ENGLISH>>>
//	How far down?

/*どれくらい？*/
ライデン_006: {
Non, pas tr&`es bas...
}
//	<<<ENGLISH>>>
//	Just a little bit...

/*ほんの少しだ。*/
エマ_007: {
J'ai comme l'impression qu'on a d&'ej&`a eu
cette conversation. Tu n'arr&^etes pas de
minimiser. &~Qa veut dire quoi, tr&`es bas ?
}
//	<<<ENGLISH>>>
//	Why do I feel like we've had
//	this conversation before?
//	How little is little?

/*さっきも『ほんの少し』って聞いたけど？*/
ライデン_008: {
... Environ 40 m&`etres !
}
//	<<<ENGLISH>>>
//	...About 130 feet?

/*……４０メートル……くらいかな。*/
エマ_009: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
ライデン_010: {
Tu tiendras le coup ?
}
//	<<<ENGLISH(2)>>>
//	Think you can do it?

/*いけるか？*/
エマ_011: {
Si je te r&'eponds 'non',
qu'est-ce que &~qa change ?
}
//	<<<ENGLISH(2)>>>
//	Would you take "no"
//	for an answer?

/*ダメって言っても連れてくんでしょ。*/
ライデン_012: {
Comment vont tes jambes ?
}
//	<<<ENGLISH>>>
//	How are your legs?

/*足の具合は？*/
エマ_013: {
Mieux.
Elles ne sont plus engourdies.
}
//	<<<ENGLISH>>>
//	Better.
//	The numbness is gone.

/*大丈夫。だいぶシビレがとれてきた。*/
エマ_014: {
Je vais pouvoir descendre toute seule.
}
//	<<<ENGLISH>>>
//	I can climb down on my own.

/*一人で歩けるわ。*/
ライデン_015: {
Bien ! Alors, suis-moi !
}
//	<<<ENGLISH>>>
//	Okay... follow me.

/*よし、俺の後についてくるんだ。*/
}
//d




resource P065_06_R02_Ｌ脚エマ６無線機デモ２＿１__f {
//Vc116511
ライデン_000: {
Ici Raiden. Tu me re&~qois ?
}
//	<<<ENGLISH>>>
//	This is Raiden, do you read me?

/*こちらライデン、聞こえるか？*/
プリスキン_001: {
Affirmatif. Que se passe-t-il ?
}
//	<<<ENGLISH>>>
//	Yeah. What's up?

/*ああ、どうした？*/
ライデン_002: {
Nous avons atteint la partie inf&'erieure de
l'Etai L. Nous devons continuer &`a la nage...
}
//	<<<ENGLISH>>>
//	We've made it to the lower part
//	of Strut L. We'll have to cross
//	the water from here.

/*Ｌ脚下部に到着した。
今から海面を渡るところだ。*/
プリスキン_003: {
Emma peut-elle marcher ?
}
//	<<<ENGLISH>>>
//	Can Emma walk?

/*エマは歩けそうか？*/
ライデン_004: {
Elle va bien. Le pont flottant n'a pas l'air
bien solide. Emma doit l'emprunter seule...
}
//	<<<ENGLISH>>>
//	She's okay. The pontoon bridge
//	doesn't look too sturdy. Emma is
//	going to have to cross it alone.

/*彼女なら大丈夫だが。
浮き橋はかなり脆そうだ。
エマひとりしか渡れそうもない。*/
プリスキン_005: {
Bien ! La barri&`ere flottante...
}
//	<<<ENGLISH>>>
//	Right... the oil fence --

/*オイルフェンスだからな。*/
}
//d
//小画面に双眼鏡モードの映像がでる。浮き橋をパンすると、敵兵、サイファーが見える
resource P065_06_R02_Ｌ脚エマ６無線機デモ２＿２__f {
//vc116512
ライデン_000: {
Il y a des Cyphers et plusieurs gardes.
}
//	<<<ENGLISH>>>
//	There's Cyphers and
//	several guards.

/*サイファーと見張りが数人いる。*/
プリスキン_001: {
Raiden, tu as un PSG1, n'est-ce pas ?
}
//	<<<ENGLISH>>>
//	Raiden, you're carrying
//	a PSG1, aren't you?

/*ライデン、ＰＳＧ１を持ってるだろう？*/
ライデン_002: {
Oui !
}
//	<<<ENGLISH(2)>>>
//	Yeah.

/*ああ。*/
プリスキン_003: {
Tu vas devoir jouer les snipers !
}
//	<<<ENGLISH>>>
//	It's time to play sniper.

/*そこから狙撃するんだ。*/
}
//d
resource P065_06_R02_Ｌ脚エマ６無線機デモ２＿３__f {
//vc116513
ライデン_000: {
Pas mal ! Cet endroit me permet de bien
voir les cibles !
}
//	<<<ENGLISH>>>
//	Not bad. This spot gives me
//	a good view of the targets.

/*なるほど、
ここは狙撃ポイントに最適だな。*/
プリスキン_001: {
Couvre Emma jusqu'&`a son arriv&'ee
&`a l'Etai E.
}
//	<<<ENGLISH>>>
//	You're going to have to
//	cover Emma until she
//	crosses to Strut E.

//<ページ数変更>
プリスキン_001_1: {
Je vais y aller aussi pour te pr&^eter
main forte !
}
//	<<<ENGLISH>>>
//	I'll get there and provide
//	some support of my own.

/*エマがＥ脚まで渡り切るのを
サポートするんだ。俺もＥ脚まで
行って援護する。
*/
ライデン_002: {
Merci !
}
//	<<<ENGLISH(2)>>>
//	Thanks.

/*それはありがたい。*/
プリスキン_003: {
Tu te crois d'attaque ?
}
//	<<<ENGLISH>>>
//	Think you can handle it?

/*狙撃の腕に自信は？*/
ライデン_004: {
Ouais ! Je connais la musique !
}
//	<<<ENGLISH>>>
//	Yeah. I know the drill.

/*大丈夫だ、このシチュエーション。*/
ライデン_005: {
J'ai connu une situation similaire en RV.
Il s'agissait d'un exercice en mode avanc&'e
de niveau 4, avec un PSG1...
}
//	<<<ENGLISH>>>
//	I've faced a similar situation
//	in Advanced Mode Level 4 VR
//	training with the PSG1.

/*ＶＲ訓練で経験済みだ。
アドバンスドモードのＰＳＧ１、
ＬＥＶＥＬ４……。*/
プリスキン_006: {
En RV ? Je suppose que c'est mieux
que rien ! Arrange-toi pour ne pas tirer
sur Emma !
}
//	<<<ENGLISH>>>
//	VR...? Guess that's better
//	than nothing. Make sure you
//	don't hit Emma.

/*またＶＲか。
いいか、彼女を傷つけるんじゃないぞ。*/
プリスキン_007: {
Pour l'instant, ils embarquent sur l'Arsenal,
donc le niveau de s&'ecurit&'e est minimal.
}
//	<<<ENGLISH>>>
//	Right now, with Arsenal's boarding
//	in progress, security should be at
//	a minimum.

//<ページ数変更>
プリスキン_007_1: {
Ce n'est pas facile pour autant.
}
//	<<<ENGLISH>>>
//	That doesn't mean it's
//	going to be easy.

/*既にアーセナルへの待避が始まっている。
敵兵は最低限しか残されていない
だろうが、気を抜くな。
*/
プリスキン_008: {
Face &`a cette situation, ils vont
s&^urement placer des mines Claymore
pour compenser le manque de s&'ecurit&'e.
}
//	<<<ENGLISH>>>
//	Given the situation, they've
//	probably got Claymores in place to
//	make up for the security shortage.

/*地形から考えて、人数をカバーする
ためにクレイモアをしかけている
可能性が高い。
*/
プリスキン_009: {
N'oublie pas tes lunettes thermiques !
}
//	<<<ENGLISH>>>
//	Make sure you use
//	your thermal goggles.

/*＃｛赤外線、サーマル｝＃ゴーグルでよく調べてみろ。*/
ライデン_010: {
Entendu !
}
//	<<<ENGLISH(2)>>>
//	Right.

/*わかった。*/
プリスキン_011: {
Bien. Je pars vers l'Etai E...
}
//	<<<ENGLISH>>>
//	Okay.
//	I'm heading for Strut E.

/*今から、Ｅ脚へ向かう。*/
}
//d
//←
resource P065_06_R02_Ｌ脚エマ６無線機デモ２＿４__f {
//vc116514
ライデン_000: {
Emma, tu me re&~qois ?
}
//	<<<ENGLISH>>>
//	Emma, are you reading me?

/*エマ、聞こえるか？*/
エマ_001: {
Cinq sur cinq...
}
//	<<<ENGLISH>>>
//	Loud and clear...

/*ええ……。*/
ライデン_002: {
Je vais te faire une voie royale,
tu vas voir...
}
//	<<<ENGLISH>>>
//	I'm gonna clear a path
//	for you from here.

/*俺がここから君の進路を切り開く。*/
エマ_003: {
Comment &~qa ?
}
//	<<<ENGLISH(2)>>>
//	How?

/*どうやって？*/
ライデン_004: {
Je te couvrir ai en tirant tous azimuts...
}
//	<<<ENGLISH>>>
//	Sniper fire.

/*狙撃だ。*/
エマ_005: {
Tu plaisantes, j'esp&`ere...
}
//	<<<ENGLISH>>>
//	You're kidding...

/*私に当たるんじゃ？*/
ライデン_006: {
Fais-moi confiance !
}
//	<<<ENGLISH(2)>>>
//	Trust me.

/*俺を信じろ。*/
エマ_007: {
Et si je tombe &`a l'eau ?
Je ne sais pas nager !
}
//	<<<ENGLISH>>>
//	What if I fall into the sea?
//	I... I can't swim!

/*私、泳げない。
海に落ちたら？*/
ライデン_008: {
Tu ne te d&'ebrouillais pas si mal,
tout &`a l'heure...
}
//	<<<ENGLISH>>>
//	You were doing pretty good
//	a few minutes ago.

/*もう泳げる。
いや、さっきは泳げた。*/
エマ_009: {
Je marche !
}
//	<<<ENGLISH(2)>>>
//	Okay.

/*わかった。*/
ライデン_010: {
Tu vas tenir le coup ?
}
//	<<<ENGLISH(2)>>>
//	Think you can do it?

/*準備はいいか？*/
エマ_011: {
Est-ce que je peux r&'epondre 'non' ?
}
//	<<<ENGLISH(2)>>>
//	Would you take "no"
//	for an answer?

/*よくなくても。*/
/* はもりりん
ライデン_000: {
No.
}
//行ってもらう。
*/
エマ_012: {
Non !
}
//	<<<ENGLISH(2)>>>
//	No.

/*行ってもらう。*/
ライデン_013: {
Tr&`es bien ! En route !
Tout ira bien !
}
//	<<<ENGLISH>>>
//	Alright, get going.
//	You'll be fine.

/*さあ、行くんだ。
君ならきっと出来る。*/
}
//d




resource P067_01_R01_エマ狙撃１無線機デモ１＿１__f {
