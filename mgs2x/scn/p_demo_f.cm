resource P025_01_R01_爆弾解体昇降機下１無線デモ１＿１__f {
//vc112501
ピーター_000: {
Raiden et Pliskin, &'ecoutez-moi bien !
}
//	<<<ENGLISH>>>
//	Raiden, Pliskin,
//	listen carefully.

/*ライデン、プリスキン……
いいか、よく聞いてくれ！*/
ライデン_001: {
Qu'est-ce qu'il y a ?
}
//	<<<ENGLISH(2)>>>
//	What is it?

/*どうした？*/
ピーター_002: {
Je suis tomb&'e dans le panneau.
}
//	<<<ENGLISH>>>
//	I fell for it.

/*まずった……。*/
プリスキン_003: {
Quel panneau ?
}
//	<<<ENGLISH>>>
//	Fell for what?

/*何があった？*/
ピーター_004: {
Fatman m'a bien eu.
}
//	<<<ENGLISH>>>
//	Fatman has my number.

/*ファットマンにやられた。*/
ピーター_005: {
Il a utilis&'e une g&^achette de proximit&'e.
A micro-ondes.
}
//	<<<ENGLISH>>>
//	A proximity trigger.
//	Microwave.

/*距離だ。マイクロ波だ。*/
ライデン_006: {
A micro-ondes ?
}
//	<<<ENGLISH>>>
//	Microwave?

/*マイクロ波？*/
ピーター_007: {
Avec une port&'ee de 2,15 m&`etres.
}
//	<<<ENGLISH(2)>>>
//	With a 7-foot range.

/*２メートル以内に近づくと感知する。*/
ピーター_008: {
Je ne lui ai pas enseign&'e cette technique.
}
//	<<<ENGLISH>>>
//	It's not a technique
//	I taught him.

/*私の教えていないトラップだ。*/
ピーター_009: {
Le traquenard des bombes multiples ne
vient pas de moi non plus.
}
//	<<<ENGLISH>>>
//	Neither was that multi-bomb
//	booby trap.

/*さっきの仕掛けといい、このトラップと
いい…*/
//<ページ数変更>
ピーター_009_1: {
En termes d'explosifs, il semble m'avoir
largement surpass&'e ! Quant au reste...
}
//	<<<ENGLISH>>>
//	Looks like he's far surpassed me
//	as far as explosives technique goes.
//	As for the rest --

/*…爆弾の技術に関する限り、
奴は私を越えたな……。だが……。*/
プリスキン_010: {
Pete, d&'ecampe et vite !
}
//	<<<ENGLISH>>>
//	Pete, get the hell out of there!

/*親父さん、逃げろっ！*/
ピーター_011: {
Il reste moins de 30 secondes.
C'est trop tard.
}
//	<<<ENGLISH>>>
//	There's less than 30 seconds
//	left. It's too late.

/*いや、後３０秒もない……。*/
ライデン_012: {
Non !
}
//	<<<ENGLISH(2)>>>
//	No!

/*そんな馬鹿なっ……。*/
ピーター_013: {
Pliskin, &'eloigne-toi de l'Etai H
le plus rapidement possible !
}
//	<<<ENGLISH>>>
//	Pliskin, get away from Strut H,
//	as fast as you can.

/*プリスキン、Ｈ脚からなるべく離れろ！*/
プリスキン_014: {
Pete -- 
}
//	<<<ENGLISH(2)>>>
//	Pete --

/*親父さん……。*/
ピーター_015: {
Raiden, reste &`a distance
de la bombe !
}
//	<<<ENGLISH>>>
//	Raiden, keep your distance.

/*ライデン、近づいてはダメだ。*/
ピーター_016: {
Utilise le vaporisateur du
plus loin possible !
}
//	<<<ENGLISH>>>
//	Use the spray from as
//	far away as possible.

/*冷却スプレーは離れた位置から
噴射するんだ。*/
ライデン_017: {
Moi ?
}
//	<<<ENGLISH(2)>>>
//	Me?

/*俺にできるのか？*/
ピーター_018: {
Tu vas r&'eussir !
Je le sais !
}
//	<<<ENGLISH>>>
//	You can do it.
//	I know that.

/*おまえならできる、いいな。*/
ライデン_019: {
Je n'en suis pas si s&^ur...
}
//	<<<ENGLISH>>>
//	I'm not so sure...

/*無理だ……。*/
ピーター_020: {
Moi, si ! Allez, je sais que
c'est dans tes cordes !
}
//	<<<ENGLISH>>>
//	But I am. Do it,
//	I know you can.

/*大丈夫、やるんだ。おまえならできる。*/
}//d

resource P025_01_R01_爆弾解体昇降機下１無線デモ１＿２__f {
