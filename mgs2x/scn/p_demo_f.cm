/*わかった。*/
}
//d



resource P069_04_R02_ヴァンプ狙撃終了４無線機デモ２＿１__f {
//Vc116911
ライデン_000: {
Snake, quelle est ta situation ?
}
//	<<<ENGLISH>>>
//	Snake, what's your
//	situation over there?

/*スネーク、そっちの状況は？*/
プリスキン_001: {
Emma semble tripatouiller... les capacit&'es
d&'efensives du syst&`eme GW...
}
//	<<<ENGLISH(2)>>>
//	Emma seems to be uh... doing
//	something to GW's defensive
//	capabilities.

//<ページ数変更>
プリスキン_001_1: {
Nous n'avons plus besoin que de ta
disquette.
}
//	<<<ENGLISH>>>
//	All we need now is your disc.

/*エマが『Ｇ．Ｗ』の自己防衛機能を
一時無効化してくれたらしい。
あとはお前のディスク待ちだ。
*/
プリスキン_002: {
Tu ferais mieux de te d&'ep&^echer...
Elle ne va plus tenir longtemps...
}
//	<<<ENGLISH>>>
//	You'd better hurry --
//	I don't think she's gonna make it.

/*急いでくれ。
エマの体力が……持ちそうもない。*/
ライデン_003: {
Elle saigne beaucoup ?
}
//	<<<ENGLISH>>>
//	How's the bleeding?

/*出血がひどいのか？*/
プリスキン_004: {
Elle est en train de...
}
//	<<<ENGLISH>>>
//	She's...

/*ああ……。*/
プリスキン_005: {
Viens-vite ! La voie est libre,
ils sont tous dans l'Arsenal !
}
//	<<<ENGLISH>>>
//	Just get over here. You'll find the
//	coast is clear with everybody
//	aboard Arsenal right now.

/*早く来るんだ。敵の心配はいらない。
奴ら、アーセナルに乗り込んだようだ。
もう誰も残っていないはず。*/
ライデン_006: {
C'est compris !
}
//	<<<ENGLISH(2)>>>
//	Understood.

/*わかった。*/
}
//d



resource P070_10_R01_ＡＧ起動１０無線機デモ１＿１__f {
