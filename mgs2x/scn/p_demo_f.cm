resource P026_01_R01_爆弾解体終了１無線デモ１＿１__f {
//vc112601
ライデン_000: {
Colonel, j'ai neutralis&'e la bombe.
}
//	<<<ENGLISH>>>
//	Colonel, I've neutralized the bomb.

/*大佐、爆弾を解体した……。*/
大佐_001: {
Bon boulot, Raiden !
}
//	<<<ENGLISH(2)>>>
//	Good work, Raiden.

/*よくやった、ライデン。*/
ライデン_002: {
La perte a &'et&'e durement
ressentie par tous !
}
//	<<<ENGLISH(2)>>>
//	It was a great loss for everyone.

/*大きな犠牲を払った……。*/
大佐_003: {
Oui, en effet.
}
//	<<<ENGLISH(2)>>>
//	Yes it was.

/*ああ……。*/
ライデン_004: {
Colonel, tu as un rapport
sur les dommages caus&'es
par l'explosion ?
}
//	<<<ENGLISH>>>
//	Colonel, any damage report
//	on the explosion?

/*大佐、爆発の影響は？*/
大佐_005: {
Il semblerait que le conduit de
diversion de l'eau de mer contamin&'ee
ait &'et&'e d&'etruit.
}
//	<<<ENGLISH>>>
//	Seems that the duct for diverting
//	the contaminated sea water was
//	destroyed.

/*汚染海水を巡らせる経路が
破壊されたらしい。
*/
//<ページ数変更>
大佐_005_1: {
Et la partie centrale de la Shell 2
est inond&'ee.
}
//	<<<ENGLISH>>>
//	And the central section
//	of Shell 2 is flooding.

/*シェル２の中央棟が浸水している。*/
大佐_006: {
L'explosion a &'egalement embras&'e
en la nappe de p&'etrole surface.
}
//	<<<ENGLISH(2)>>>
//	The explosion's ignited
//	the oil slick on the surface.

/*それと、油膜に引火して、
海面が炎上している。*/
ライデン_007: {
Et les toxines ?
}
//	<<<ENGLISH(2)>>>
//	What about the toxins?

/*有毒物質の発生は？*/
大佐_008: {
Les produits chimiques ont pu &^etre
contenus. Il n'y a pas de danger imm&'ediat.
}
//	<<<ENGLISH>>>
//	The chemicals stayed in
//	containment. There's no
//	immediate danger.

/*今の所は心配ないようだ。*/
ライデン_009: {
La Big Shell est stable ?
}
//	<<<ENGLISH>>>
//	Is the Big Shell stable?

/*『ビッグ・シェル』は
姿勢維持できるのか？*/
大佐_010: {
La Shell 1 n'a pas &'et&'e touch&'ee. On l'a
pay&'e cher, mais la menace des bombes
est &'ecart&'ee, pour l'instant.
}
//	<<<ENGLISH>>>
//	Shell 1 was unaffected. The
//	price was high, but the threat
//	of the bomb is over for now.

/*大丈夫だ。シェル１には影響はない。
とにかく爆弾の脅威は去った。*/
ライデン_011: {
Quel est l'objectif actuel ?
}
//	<<<ENGLISH>>>
//	What's the next objective?

/*次の指示は？*/
大佐_012: {
Il faut sauver le Pr&'esident.
Remonte au niveau sup&'erieur.
}
//	<<<ENGLISH>>>
//	Rescue the President.
//	Get back to the upper level.

/*大統領の救出に向かってくれ。
とりあえずそこから上に戻るんだ。*/
ライデン_013: {
Entendu !
}
//	<<<ENGLISH>>>
//	Roger that.

/*了解。*/
}//d




resource P027_01_R01_爆弾解体後昇降機ホール１無線デモ１＿１__f {
//vc112701
大佐_000: {
Raiden, les terroristes ont ripost&'e
&`a notre neutralisation des bombes.
}
//	<<<ENGLISH>>>
//	Raiden, the terrorists have
//	retaliated for our bomb
//	neutralization.

/*ライデン、
爆弾の強制除去に対する報復があった。*/
ライデン_001: {
Quoi ?
}
//	<<<ENGLISH(2)>>>
//	What?

/*何？*/
大佐_002: {
Ils ont tu&'e un otage --
d'une balle dans la t&^ete.
}
//	<<<ENGLISH>>>
//	A hostage has been killed --
//	shot in the head.

/*人質が１名殺害された。*/
大佐_003: {
Ils ont descendu l'otage sur le toit
pour que nous le voyions bien.
}
//	<<<ENGLISH>>>
//	They shot one of them on the roof,
//	just to make sure we caught it.

/*T奴等、屋上でこれみよがしに
頭を撃ち抜いてみせたよ。
*/
//<ページ数変更>
大佐_003_1: {
Un de nos satellites a clairement
capt&'e l'&'ev&'enement.
}
//	<<<ENGLISH>>>
//	One of our satellites
//	caught it, clear as day.

/*衛星がはっきり捉えた。*/
ライデン_004: {
Mince !
}
//	<<<ENGLISH(2)>>>
//	Damn!

/*くそっ！*/
大佐_005: {
Ils ont annonc&'e qu'ils allaient dor&'enavant
tuer un otage par heure.
}
//	<<<ENGLISH>>>
//	They announced that they would
//	kill one every hour from now on.

/*今後、１時間毎に１名ずつ……だそうだ。*/
ライデン_006: {
Quels sont mes ordres ?
Que dois-je faire ?
}
//	<<<ENGLISH>>>
//	What are my orders?
//	What should I do?

/*どうすればいい？
俺は？*/
大佐_007: {
Conforme-toi &`a l'objectif de ta mission
et sauve le Pr&'esident.
}
//	<<<ENGLISH>>>
//	Stay with your mission objective.
//	Rescue the President.

/*そのまま任務を続行しろ。
大統領救出が優先だ。*/
ライデン_008: {
Et les autres otages ?
}
//	<<<ENGLISH>>>
//	What about the other hostages?

/*他の人質は？*/
大佐_009: {
Le Pr&'esident Johnson est prioritaire.
}
//	<<<ENGLISH>>>
//	President Johnson is
//	your first priority.

/*最優先はジョンソン大統領だ。*/
ライデン_010: {
Prioritaire, tu parles !
Ils sont tous en danger !
}
//	<<<ENGLISH>>>
//	Priority my butt.
//	They're all in danger!

/*人質に優先もくそもない。*/
ローズ_011: {
Jack, sois raisonnable !
}
//	<<<ENGLISH>>>
//	Jack, be reasonable.

/*ジャック、冷静になって。
*/
ローズ_012: {
Je comprends tes sentiments,
mais on ne peut pas tous les sauver !
}
//	<<<ENGLISH>>>
//	I know what you're feeling,
//	but you can't save them all.

/*あなたの気持ちはわかるわ。
でも、あなた一人では人質全員を
救出なんてできない。*/
ライデン_013: {
Evidemment, pas &`a moi tout seul !
}
//	<<<ENGLISH>>>
//	No, not by myself.

/*俺一人ではな。*/
大佐_014: {
Tu penses que Pliskin va reprendre
contact avec toi ?
}
//	<<<ENGLISH>>>
//	Are you expecting that
//	Pliskin to come through?

/*あの男に期待しているのか？*/
ライデン_015: {
Euh...
}
//	<<<ENGLISH(2)>>>
//	Well...

/*……。*/
大佐_016: {
Il semble avoir &'eteint sa radio,
lui aussi.
}
//	<<<ENGLISH>>>
//	Looks like he's turned
//	his radio off too.

/*無線は通じないようだが？*/
ライデン_017: {
Je n'arriverai pas &`a remplir
cette mission tout seul.
}
//	<<<ENGLISH>>>
//	I can't complete this
//	mission by myself.

/*俺一人では、任務遂行は無理だ。*/
大佐_018: {
Cet homme n'a pas &'et&'e pr&'evu
par la simulation.
}
//	<<<ENGLISH>>>
//	That man was not included
//	in the simulation.

/*あの男はシミュレーションには
入っていない。*/
大佐_019: {
Il n'a rien &`a voir avec cette mission !
}
//	<<<ENGLISH>>>
//	He is not a factor in this mission.

/*あの男は＃｛要素、ファクター｝＃には入っていないのだ。*/
ライデン_020: {
Que veux-tu dire par l&`a, Colonel ?
}
//	<<<ENGLISH>>>
//	What do you mean by that, Colonel?

/*大佐、何だって？*/
大佐_021: {
Tu dois remplir ta mission tout seul.
}
//	<<<ENGLISH>>>
//	Your mission must
//	remain a solo effort.

/*君の任務はあくまでも単独作戦行動……。*/
ライデン_022: {
Et les SEAL ? Ont-ils fait
une seconde tentative ?
}
//	<<<ENGLISH>>>
//	What about the SEALs?
//	No second attempt?

/*ＳＥＡＬＳの再突入はないのか？*/
大佐_023: {
Ils n'ont m&^eme pas fini leurs pr&'eparatifs.
}
//	<<<ENGLISH>>>
//	They haven't even gotten
//	to planning that.

/*まだ目処も立ってない。*/
大佐_024: {
Nous n'avons pas d'autre choix que
d'attendre. Tu ne peux plus compter
que sur toi-m&^eme.
}
//	<<<ENGLISH>>>
//	All we can do is wait.
//	In the meantime, you're
//	our only hope.

/*我々は待つしかできない。
君だけが頼りなんだ。*/
ライデン_025: {
... Je comprends.
}
//	<<<ENGLISH>>>
//	...I understand.

/*……わかった。*/
大佐_026: {
Raiden, va d&'elivrer le Pr&'esident.
Commence par te rendre sur
le niveau sup&'erieur de l'Etai A.
}
//	<<<ENGLISH>>>
//	Raiden, go and rescue the President.
//	You can start off by getting to the
//	upper level of Strut A.

/*ライデン、大統領の救出に向かってくれ。
まずＡ脚上部に上がるんだ。*/
}//d




resource P030_01_R01_フォーチュン戦中無線無線デモ１＿１__f {
//vc113001
大佐_000: {
Raiden, Fatman vient d'entrer
en contact direct avec nous.
}
//	<<<ENGLISH>>>
//	Raiden, Fatman just
//	contacted us directly.

/*ライデン、ファットマンから
こちらに直接連絡があった。*/
ライデン_001: {
Avec NOUS ?
}
//	<<<ENGLISH>>>
//	Fatman called US?

/*ファットマンから？*/
大佐_002: {
Oui. Il semble avoir plac&'e une bombe
sur l'h&'eliport. Il a demand&'e &`a te parler,
Raiden.
}
//	<<<ENGLISH>>>
//	Yes. Looks like he placed a bomb
//	on the heliport. He specifically
//	asked for you, Raiden.

/*ああ。ヘリポートにまた仕掛けたらしい。
ライデン、君を指定してきている。*/
ライデン_003: {
Quoi !?
}
//	<<<ENGLISH(2)>>>
//	What!?

/*なに！？*/
大佐_004: {
Il a tu&'e Peter et maintenant,
il est apr&`es toi.
}
//	<<<ENGLISH>>>
//	He's killed off Peter.
//	Now he's after you.

/*スティルマンが亡くなって、
次のターゲットは君らしい。*/
ライデン_005: {
Pourquoi moi ?
}
//	<<<ENGLISH>>>
//	Why me?

/*なぜ俺なんだ？*/
大佐_006: {
Comment veux-tu que je le sache ?
}
//	<<<ENGLISH(2)>>>
//	How should I know?

/*わからん。*/
ライデン_007: {
Ecoute, ce n'est vraiment pas le moment !
}
//	<<<ENGLISH(2)>>>
//	Look. This is really not
//	a good time for this.

/*こっちはそれどころじゃないぞ！*/
大佐_008: {
Le compte &`a rebours a d&'ej&`a
commenc&'e, Raiden !
}
//	<<<ENGLISH>>>
//	The countdown's already
//	begun, Raiden!

/*すでにタイマーが起動している。*/
ライデン_009: {
Super !
Combien de temps me reste-t-il ?
}
//	<<<ENGLISH>>>
//	Great, how much
//	time do I have left?

/*なんてこった、後いくらだ？*/
大佐_010: {
Je vais te montrer le compte &`a rebours.
}
//	<<<ENGLISH>>>
//	I'll show you the count.

/*カウントを表示する。*/
}//d
resource P030_01_R01_フォーチュン戦中無線無線デモ１＿カウント２００__f {
//vc113002
大佐_000: {
200 secondes restantes.
}
