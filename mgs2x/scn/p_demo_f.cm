// テロ事件対策として、ムービーから無線に変更になった
//例のアレでうひょひょ
resource P049_03_R02_2_大統領３＿元ムービーデモ１__f {
//vcxxxxxx {
大統領_001: {
Je ne suis pas surpris que vous ne
les connaissiez pas.
}
//	<<<ENGLISH>>>
//	I'm not surprised you've
//	never heard of them.
//<ページ数変更>
大統領_001_1: {
Peu de gens savent qu'ils existent,
m&^eme dans les milieux autoris&'es...
}
//	<<<ENGLISH>>>
//	Very few are aware of their
//	existence, even among those
//	with codeword clearance.

/*知らないのは当然だ。彼等の存在を
知っているのは＃｛最高暗号機密関与資格、コードワード・クリアランス｝＃を
持つ者の中でも極少数に限られる。
*/
ライデン_002: {
?
}
//	<<<ENGLISH(2)>>>
//	?

/*？
*/
大統領_003: {
Ils ont la main mise sur tout -- la politique,
les affaires militaires, l'&'economie...
Ils se paient m&^eme le luxe de choisir
le Pr&'esident...
}
//	<<<ENGLISH>>>
//	Politics, the military, the economy --
//	they control it all. They even choose
//	who becomes President...

/*政治、軍事、経済……この国の
あらゆる決定は彼等が下している。
……無論大統領の選定も含めて。
*/
大統領_004: {
En bref, les Patriotes gouvernent le pays.
}
//	<<<ENGLISH>>>
//	Putting it simply, the Patriots
//	rule this country.

/*彼等こそ我が国を真に支配する者達だ。
*/
ライデン_005: {
Non...
}
//	<<<ENGLISH(2)>>>
//	No...

/*そんな……。*/
大統領_006: {
Vous avez du mal &`a me croire,
n'est-ce pas ? Et pourtant, c'est
la v&'erit&'e !
}
//	<<<ENGLISH(2)>>>
//	Hard to believe, isn't it?
//	But it's the truth.

/*ふん。信じられないのも無理はない……
だが事実なのだ。
*/
大統領_007: {
De la d&'efense spatiale &`a la r&'eduction
des imp&^ots sur le revenu, en passant
par les missiles de d&'efense nationale...
}
//	<<<ENGLISH>>>
//	The Space Defense, income tax
//	reduction and the National Missile
//	Defense (NMD) programs --

/*宇宙防衛の重視、所得税率の引き下げ、
＃｛本土ミサイル防衛、ＮＭＤ｝＃の推進……
*/
大統領_008: {
Tous les programmes qui ont &'et&'e port&'es &`a
mon actif ont en fait &'et&'e dict&'es par eux...
}
//	<<<ENGLISH>>>
//	Every policy that's been credited
//	to me was actually done according
//	to their instructions.

/*私が行なったとされている全ての政策は
彼等の指示によるものだった。
*/
ライデン_009: {
Le programme de d&'efense spatiale
a &'et&'e lanc&'e par le Congr&`es...
}
//	<<<ENGLISH>>>
//	Space Defense was
//	initiated by Congress...

/*宇宙防衛は議会から……。*/
大統領_010: {
C'est en tout cas ce que les Patriotes
veulent faire croire aux citoyens
de ce pays...
}
//	<<<ENGLISH>>>
//	That's what the Patriots want
//	the country to believe...

/*それも『愛国者達』の演出だよ。
*/
大統領_011: {
Tout est artificiel.... La 'd&'emocratie'
n'existe que dans les livres d'&'ecole...
}
//	<<<ENGLISH>>>
//	It's all a show. "Democracy" is
//	just a filler for textbooks!

/*議会はただの演芸場だ。
民主主義など教科書のページを埋める
ためのお題目でしかない。
*/
大統領_012: {
R&'efl&'echissez une seconde... Pensez-vous
vraiment que l'opinion publique ait une
prise quelconque sur le gouvernement ?
}
//	<<<ENGLISH>>>
//	Think about it! Do you actually
//	believe that public opinion influences
//	the government?

/*それとも君は『民意』が社会に
反映されるのを見たことでもあるのか？
*/
ライデン_013: {
... Non.
}
//	<<<ENGLISH>>>
//	...No.


/*……いや……。
*/
大統領_014: {
Le pays est enti&`erement model&'e
et contr&^ol&'e par les Patriotes.
}
//	<<<ENGLISH>>>
//	This country is shaped and controlled
//	as the Patriots see fit.

/*全ては『愛国者達』の利害と思惑に
基づいている。
*/
大統領_015: {
Ils montrent aux gens
ce qu'ils ont envie de voir.
}
//	<<<ENGLISH>>>
//	The people are shown what
//	they want to believe.
//<ページ数変更>
大統領_015_1: {
Le pr&'etendu gouvernement n'est qu'une
fa&~qade et une vaste duperie destin&'ee
&`a satisfaire le peuple !
}
//	<<<ENGLISH>>>
//	What you call government is actually
//	a well-staged production aimed at
//	satisfying the public!

/*それを見栄えのいい建前で取り繕った
ショーのことを、君達は『政治』と
呼んでいるのだ。
*/
ライデン_016: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。
*/
大統領_017: {
Ne me regardez pas comme &~qa !
J'ai toute ma t&^ete, vous savez !
}
//	<<<ENGLISH>>>
//	Don't look at me like that --
//	I'm legally sane, you know.

/*そんな目で見るな。
精神鑑定なら受けてるよ。
*/
ライデン_018: {
Ce n'est pas votre sant&'e mentale
qui m'inqui&`ete...
}
//	<<<ENGLISH>>>
//	It's not your sanity
//	that worries me...

/*そういう意味では……。
*/
//dv}//v
}



resource P080_20_R01_2_ＡＧ浮上２０元ムービーデモ８__f {
//vcxxxxxx {
大佐_000: {
Au cours des deux cents
derni&`eres ann&'ees...
}
//	<<<ENGLISH>>>
//	Over the past two hundred years --
//<ページ数変更>
大佐_000_1: {
Une sorte de conscience s'est forg&'ee
par couches successives dans le creuset
de la Maison-Blanche.
}
//	<<<ENGLISH>>>
//	A kind of consciousness formed
//	layer by layer in the crucible of
//	the White House.

/*この２００年の間に……
様々な念がホワイトハウスという
重力場で産み落とされた。
*/
大佐_001: {
Ce ph&'enom&`ene s'apparente &`a celui
des oc&'eans, qui ont vu na&^itre la vie
il y a quatre milliards d'ann&'ees...
}
//	<<<ENGLISH>>>
//	It's not unlike the way life started
//	in the oceans four billion years ago.
//<ページ数変更>
大佐_001_1: {
La Maison-Blanche a constitu&'e notre milieu
primaire, la base de notre &'evolution...
}
//	<<<ENGLISH>>>
//	The White House was our
//	primordial soup, a base of
//	evolution --

/*４０億年前地球の海中で突然、生命が
生まれたように、ホワイトハウスの中で
芽生え、進化してきた……。
*/
/* テロ対応でカット。
大佐_002: {
under the protection
of the flag...
suckled on the national religion
of capitalism...
}
*/
/*
星条旗の元に……
市民宗教の中で……。
*/
//dv}//v
}



resource P040_06b_M00_エイムズ発見６ｂ元ムービーデモ０__f {
//
/* テロ事件対応のため、セリフカット */
/*
エイムズ_000: {
And this is what they plan
to do right over Manhattan.
}
*/
/*奴等はそれをマンハッタン上空で
行おうとしているんだ。
*/
/*
ライデン_001: {
The New York Stock Exchange...
}
*/
/*そうなったらウォール街の
電子機器は……。
*/
/*
エイムズ_002: {
-- will suffer the same fate.
}
*/
/*無論、壊滅だな。*/
ライデン_003: {
Si l'un des principaux indicateurs
de l'&'economie mondiale cesse
de fonctionner,
}
//	<<<ENGLISH>>>
//	If one of the key movers of world
//	economy stops functioning,
//<ページ数変更>
ライデン_003_1: {
nous risquons de sombrer
dans une d&'epression plan&'etaire.
}
//	<<<ENGLISH>>>
//	it could mean the beginning
//	of a global depression.
//<ページ数変更>
/*
ライデン_003_2: {
Black Monday will look like
a picnic in comparison.
}
*/
/*世界経済の中心が機能を停止すれば、
世界的な大恐慌に陥る……
＃｛暗黒の月曜日、ブラックマンデー｝＃の再来……？。
*/
}