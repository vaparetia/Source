/*ああ、聞こえる。*/
プリスキン_002: {
J'ai atteint mon poste, sur l'Etai E.
Je vais tirer &`a partir d'ici...
}
//	<<<ENGLISH>>>
//	I've reached my sniping position
//	on Strut E. I'll provide support
