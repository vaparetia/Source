				-z d:CAMERA_INTERP_CAMERA \ // 補完カメラフラグを指定。
				-interp_time (60*10) \ // 補完時間を指定
				-s 1
		#endif
	}

	proc クリアリングカメラ０−５ {
		#if d:CLEAR_CAMERA
			chara カメラ設定 クリアリングカメラ \
				-c 1 \	
				-p -19358,-43550,27582 -t -17681,-44901,22144 \
				-r 152,1853,0 -f 5848 \
				-a 248 \
				-i 2 -1 0 0 \
				-s 1

			chara カメラ設定 クリアリングカメラ \
				-c 1 \	
				-p -19449,-43359,28233 -t -17656,-45962,23318 \
				-r 301,1820,0 -f 5843 \
				-a 198 \
				-i 0 -1 0 0 \
				-z d:CAMERA_INTERP_CAMERA \ // 補完カメラフラグを指定。
				-interp_time (60*10) \ // 補完時間を指定
				-s 1
		#endif
	}

	proc クリアリングカメラ０−６ {
		#if d:CLEAR_CAMERA
			chara カメラ設定 クリアリングカメラ \
				-c 1 \	
				-p -14274,-42865,26165 -t -15890,-44691,21374 \
				-r 226,2260,0 -f 5376 \
				-a 200 \
				-i 2 -1 0 0 \
				-s 1

			chara カメラ設定 クリアリングカメラ \
				-c 1 \	
				-p -14502,-42367,26108 -t -13279,-43058,20922 \
				-r 84,1897,0 -f 5373 \
				-a 650 \
				-i 0 -1 0 0 \
				-z d:CAMERA_INTERP_CAMERA \ // 補完カメラフラグを指定。
				-interp_time (60*9) \ // 補完時間を指定
				-s 1
		#endif
