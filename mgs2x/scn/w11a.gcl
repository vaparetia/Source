				-r 187,1624,0 -f 4495 \
				-a 318 \
				-i 2 -1 0 0 \
				-s 1

			chara カメラ設定 クリアリングカメラ \
				-c 1 \	
				-p -19341,-42423,25748 -t -18274,-44232,21774 \
				-r 270,1877,0 -f 4495 \
				-a 249 \
