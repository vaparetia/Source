					-r 84,1321,0 -f 7987 \
					-a 609 \
					-i 2 -1 0 0 \
					-s 1

				chara カメラ設定 クリアリングカメラ \
					-c 1 \	
					-p -19966,-42695,18984 -t -13087,-44469,15334 \
					-r 146,1342,0 -f 7987 \
					-a 202 \
					-i 0 -1 0 0 \
					-z d:CAMERA_INTERP_CAMERA \ // 補完カメラフラグを指定。
					-interp_time (60*8) \ // 補完時間を指定
					-s 1
			#endif
