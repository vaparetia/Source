		#if d:CLEAR_CAMERA
			chara カメラ設定 クリアリングカメラ \
				-c 1 \	
				-p -11128,-42932,16794 -t -11765,-43990,14573 \
				-r 280,2230,0 -f 2541 \
				-a 200 \
				-i 2 -1 0 0 \
				-s 1
		#endif
	}

