		if ( $i:プレイヤー位置Ｘ < -11750 ) {
			#if d:CLEAR_CAMERA
				chara カメラ設定 クリアリングカメラ \
					-c 1 \	
					-p -14087,-42445,19446 -t -13180,-43260,16784 \
					-r 184,1834,0 -f 2928 \
					-a 283 \
					-i 2 -1 0 0 \
					-s 1

				chara カメラ設定 クリアリングカメラ \
					-c 1 \	
					-p -17251,-41995,21051 -t -16171,-43183,18645 \
					-r 276,1773,0 -f 2892 \
					-a 216 \
					-i 0 -1 0 0 \
					-z d:CAMERA_INTERP_CAMERA \ // 補完カメラフラグを指定。
					-interp_time (60*8) \ // 補完時間を指定
					-s 1

			#endif
		} else {
			#if d:CLEAR_CAMERA
				chara カメラ設定 クリアリングカメラ \
					-c 1 \	
