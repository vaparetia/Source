	// 子画面設定 
	// ------------------------------------
	proc 子画面設定 {
		#if d:DEBUG_PRINT
			print 'sub_camera_set'
		#endif

		chara サブ画面 子画面 \
			-w (512-d:SUB_MARGIN-d:SUB_WIDTH),d:SUB_MARGIN (512-d:SUB_MARGIN),(d:SUB_HEIGHT+d:SUB_MARGIN)
	}


// 各マップ別設定
// ------------------------------------
// 昇降機ホール
	// 各種カメラの設定
	// ------------------------------------
	proc 昇降機ホールカメラ設定 {
		#if d:DEBUG_PRINT
			print 'w11a2_camera_set'
		#endif

		trap ca021 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				if ( $w:p_story < d:ST:P003_01_P01スネーク昇降機上昇１ポリゴンデモ１終了 ) {
					// 最初はポリデモへ飛ぶので、カメラを変化させない
					chara カメラ設定 メインカメラ \
						-c 0 \	
						-b -11316,-39467,4286 -8474,-39467,4286 \
						-l -11316,-43497,2993 -8474,-43497,2993 \
						-r 821,2048,0 \
						-f 4239 \
						-a 200 \
						-i 0 0 0 0 \
						-z d:CAMERA_NO_CUSHION \
						-s $3
				} else {
					if ( $6 < 2400 ) {
						@CS_スムーズカメラ降順 $6 -2000 -4000 -2500 -2300
						eval( $i:補完ＢＸ = $i:CS_結果１ );

						@CS_スムーズカメラ降順 $6 -2000 -4000 2500 2300
						eval( $i:補完ＢＸ２ = $i:CS_結果１ );
					} else {
						@CS_スムーズカメラ降順 $4 -4000 -5500 -2500 -4250
						eval( $i:補完ＢＸ = $i:CS_結果１ );

						@CS_スムーズカメラ降順 $4 5500 4000 4250 2500
						eval( $i:補完ＢＸ２ = $i:CS_結果１ );
					}

					@CS_スムーズカメラ降順 $6 6000 4000 876 500
					eval( $i:補完ＲＸ = $i:CS_結果１ );

					chara カメラ設定 メインカメラ \
						-c 0 \	
						-b $i:補完ＢＸ,-38000,1000 $i:補完ＢＸ２,-38000,5776 \
						-l $i:補完ＢＸ,-43653,-5000 $i:補完ＢＸ２,-43653,4249 \
						-r $i:補完ＲＸ,2048,0 \
						-f 7500 \
						-a 200 \
						-i 2 -1 0 0 \
						-s $3
				}
			}

		trap ca022 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ降順 $6 -4000 -5000 -2300 -850
				eval( $i:補完ＢＸ = $i:CS_結果１ );

				@CS_スムーズカメラ降順 $6 -4000 -5000 2300 850
				eval( $i:補完ＢＸ２ = $i:CS_結果１ );

				@CS_スムーズカメラ降順 $6 -4000 -5000 -38000 -38500
				eval( $i:補完ＢＹ = $i:CS_結果１ );

				chara カメラ設定 メインカメラ \
					-c 0 \	
					-b $i:補完ＢＸ,$i:補完ＢＹ,-434 $i:補完ＢＸ２,$i:補完ＢＹ,5776 \
					-l $i:補完ＢＸ,-43653,-5834 $i:補完ＢＸ２,-43653,4249 \
					-r 500,2048,0 \
					-f 7500 \
					-a 200 \
					-i 3 3 0 0 \
					-s $3
			}

		// エレベーター
		trap ca023 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ \
					-c 1 \	
					-p 0,-42999,-3037 -t 0,-43401,-6872 \
					-r 68,2048,0 -f 3856 \
					-a 200 \
					-i 0 1 0 0 \
					-s $3
			}

		trap ca024 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ \
					-c 1 \	
					-p -3482,-37782,3207 -t -3482,-43426,474 \
					-r 730,2048,0 -f 6271 \
					-a 200 \
					-i 3 3 0 0 \
					-s $3
			}

		trap ca025 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ \
					-c 1 \	
					-p -1488,-38000,1129 -t -1488,-43403,-1505 \
					-r 725,2048,0 -f 5949 \
					-a 200 \
					-i 3 3 0 0 \
					-s $3
			}

		trap ca026 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ \
					-c 1 \	
					-p -2749,-37753,2227 -t -2749,-43675,-2366 \
					-r 594,2048,0 -f 7494 \
					-a 200 \
					-i 3 3 0 0 \
					-s $3
			}

		trap ca027 d:PLAYER \
			-mask ？ \
			-state 1,2 \	//しゃがみor匍匐
			-camera \
			-exec {
				chara カメラ設定 サブカメラ \
					-c 0 \	
					-b d:CAM_MIN,-38000,d:CAM_MIN d:CAM_MAX,-38000,d:CAM_MAX \
					-l d:CAM_MIN,-43653,d:CAM_MIN d:CAM_MAX,-43653,d:CAM_MAX \
					-r 840,2048,0 \
					-f 7250 \
					-a 200 \
					-i 3 3 0 0 \
					-s $3
			}

	}



