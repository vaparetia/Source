//------------------------------
resource TO_オルガ戦前__s {
オタコン_000: {
El soldado afuera de la infraestructura me
da muy mala espina.
}
//	<<<ENGLISH>>>
//	There's something about that
//	soldier who was standing
//	outside the infrastructure.
//<ページ数変更>
オタコン_000_1: {
&'Echate un vistazo, ve por la trampilla
que hay en el lado del puerto de la
infraestructura
}
//	<<<ENGLISH>>>
//	I think you should check it out --
//	use the hatch on the port side of
//	the infrastructure
//<ページ数変更>
オタコン_000_2: {
para llegar hasta la cubierta de
navegaci&'on.
}
//	<<<ENGLISH>>>
//	to get out onto the
//	navigational deck.

/*船橋の外にいた兵士……何か気になるな。
調べておいた方がいい。船橋左舷の
水密扉から航海甲板に出られるはずだ。
*/
オタコン_001: {
Es all&'i donde tienes que ir.
}
//	<<<ENGLISH>>>
//	That's where you need to go.

/*航海甲板に向かってくれ。*/
}//d



resource TO_銃撃戦飛び出し撃ち１__s {
オタコン_000: {
No creo que te dejen entrar en la bodega
tan f&'acilmente.
}
//	<<<ENGLISH>>>
//	I don't think they're going to
//	let you into the hold so easily.

/*敵も黙って君を船倉に入れる気は
ないみたいだ。
*/
スネーク_001: {
Tendr&'e que luchar. Puedo intentar disparar
mientras salto desde la visi&'on Esquina.
}
//	<<<ENGLISH>>>
//	I'll have to stand my ground and
//	fight. I can try a Jump-out shot
//	from Corner View.

/*ああ。ここは戦うしかないようだ。
ビハインドからの飛び出し撃ちを
使ってみるか……。
*/
オタコン_002: {
Buena idea.
}
//	<<<ENGLISH(2)>>>
//	Good idea.

/*そうだね。*/
}//d

//二回目以降 t //e
resource TO_銃撃戦飛び出し撃ち２__s {
オタコン_000: {
Para disparar mientras saltas, esc&'ondete
y espera el momento adecuado.
}
//	<<<ENGLISH>>>
//	If you go with Jump-out shots,
//	you can wait behind cover for
//	the right time to get in a shot.

/*飛び出し撃ちを活用すれば、遮蔽物に
隠れながら相手の隙をみて銃撃を加える
ことが出来るだろう。
*/
オタコン_001: {
Selecciona tu pistola y p&'egate a alg&'un
objeto, luego pasa a la visi&'on Esquina.
}
//	<<<ENGLISH>>>
//	Select your gun and flatten
//	yourself against an object,
//	then switch to Corner View.

/*やり方は、まず銃を装備してから
遮蔽物に張り付いてビハインドカメラに
する。
*/
オタコン_002: {
Pulsa el bot&'on Atacar para salir de tu
escondite y tomar al enemigo por
sorpresa.
}
//	<<<ENGLISH>>>
//	Hit the Attack button to pop out
//	and catch the enemy off guard.
//<ページ数変更>
オタコン_002_1: {
Suelta el bot&'on Atacar para volver a tu
escondite.
}
//	<<<ENGLISH>>>
//	Let go of the Attack button
//	to get back behind cover.

/*その状態から＃｛□、武器｝＃ボタンを押せば
飛び出し撃ちができる。＃｛□、武器｝＃ボタンを
離せば素早く遮蔽物の陰に戻る。
*/
オタコン_003: {
Ataca cuando el enemigo est&'e m&'as
relajado.
}
//	<<<ENGLISH>>>
//	Wait for a lull in the
//	enemy fire to strike.

/*敵の弾幕が途切れる瞬間を
見極めて攻撃に転じるんだ。*/
}//d

resource TO_タクティカルリロード１__s {
オタコン_000: {
Snake, &~?qu&'e pasar&'ia si te quedaras sin
munici&'on en mitad de un tiroteo?
}
//	<<<ENGLISH>>>
//	Snake, what if you run out of
//	ammunition during an exchange
//	of fire?
//<ページ数変更>
オタコン_000_1: {
&~?Ser&'ias un blanco f&'acil, verdad?
}
//	<<<ENGLISH>>>
//	Leaves you suddenly
//	vulnerable, doesn't it?

/*スネーク、撃ち合っている最中に弾が
切れたら大きな隙を相手に見せることに
なるんじゃないか？
*/
スネーク_001: {
Eso no ocurrir&'ia si utilizo la opci&'on de
"recarga t&'actica".
}
//	<<<ENGLISH>>>
//	That wouldn't happen
//	with Tactical Reload.

/*ああ。だがタクティカル・リロードを
使えばそんなことにはならん。
*/
オタコン_002: {
Cambia el cargador antes de que se
acabe.
}
//	<<<ENGLISH>>>
//	So change the magazine
//	before it becomes empty.
//<ページ数変更>
オタコン_002_1: {
De esa forma, nunca te quedar&'as sin
munici&'on, enfrentando al enemigo.
}
//	<<<ENGLISH>>>
//	That way, you would never run
//	out when you're actually facing
//	the enemy.

/*敵の目の前で弾切れを起こす危険を
回避するため、弾倉が空になる前に
あらかじめ弾倉を交換しておく戦術だね。
*/
スネーク_003: {
Exactamente.
}
//	<<<ENGLISH(2)>>>
//	Exactly.

/*そうだ。*/
}//d

//二回目以降 t //e
resource TO_タクティカルリロード２__s {
オタコン_000: {
Para hacer una "recarga t&'actica" deja el
arma seleccionada y luego selecci&'onala de
nuevo.
}
//	<<<ENGLISH>>>
//	To perform a Tactical Reload,
//	unequip the gun, then equip it
//	again.

/*タクティカル・リロードをするには
銃を装備から外してからもう一度
装備し直せばいい。
*/
オタコン_001: {
Cuando la vuelvas a seleccionar, el arma
tendr&'a con un nuevo cargador. 
}
//	<<<ENGLISH>>>
//	The gun should now be loaded
//	with a fresh magazine.
//<ページ数変更>
オタコン_001_1: {
Usa el bot&'on R2 para hacerlo.
}
//	<<<ENGLISH>>>
//	Use the quick change button --
//	the R2 button -- for this one.

/*それで新しい弾倉を装填した状態になる。Ｒ２ボタンを素早く押してクイック
チェンジを使うといいだろう。
*/
}//d

resource TO_グレネード注意__s {
オタコン_000: {
Snake, tienen granadas. Si ves que lanzan
una, sal de ah&'i tan pronto como puedas.
}
//	<<<ENGLISH>>>
//	Snake, they've got grenades.
//	If you see an incoming one,
//	just get the hell out of there.

/*スネーク、敵はグレネードも装備して
