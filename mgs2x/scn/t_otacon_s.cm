}//d

resource TO_プロジェクタ切替__s {
オタコン_000: {
Hay dos proyectores en la sala de
mercanc&'ias.
}
//	<<<ENGLISH>>>
//	There are two projectors
//	in that cargo hold.
//<ページ数変更>
オタコン_000_1: {
Cuando uno se enciende, el otro se apaga.
}
//	<<<ENGLISH>>>
//	It looks like the feed is
//	being switched back and
//	forth between them.

/*その船倉にはプロジェクタが二つある。映像は交互に切り替えられている
みたいだ。
*/
オタコン_001: {
Los Marines mirar&'an siempre hacia el
proyector que est&'e funcionando en ese
momento.
}
//	<<<ENGLISH>>>
//	The Marines would naturally be
//	looking towards the projector
//	that's currently in use.

/*海兵隊員達は当然映像の映っているプロジェクタの方に注目している。
*/
オタコン_002: {
Lo que quiere decir, que ellos se fijar&'an
s&'olo en el que est&'e encendido.
}
//	<<<ENGLISH>>>
//	Which means that when the switch
//	takes place, they'll change the
//	direction of their focus too.

/*つまりプロジェクタが切り替わったら
海兵隊員達の見ている方向もかわるって
ことだ。
*/
オタコン_003: {
Ten cuidado. Si te descubren, ser&'a el final.
}
//	<<<ENGLISH>>>
//	Be on the lookout.
//	If they see you, it's all over.

/*気をつけてくれ。
見つかったら終わりだよ。
*/
}//d

resource TO_かねきゃっち__s {
オタコン_000: {
Presiona el bot&'on Gatear en el modo
Colgando y tras saltar,
}
//	<<<ENGLISH>>>
//	After pushing the Crawl button
//	in Hanging mode and falling,
//<ページ数変更>
オタコン_000_1: {
pulsa el bot&'on Acci&'on si ves alg&'un sitio al
que agarrarte.
}
//	<<<ENGLISH>>>
//	If you see a good handhold,
//	try pushing the Action button.

/*エルードから×ボタンで落下している
途中につかめそうな場所があったら
△ボタンを押してみるといい。
*/
オタコン_001: {
Si pulsas el bot&'on en el momento justo,
podr&'as agarrarte.
}
//	<<<ENGLISH>>>
//	If you hit it just right, you
//	should be able to grab on.
//<ページ数変更>
オタコン_001_1: {
No importa si la direcci&'on del salto no es
exactamente la correcta. Int&'entalo.
}
//	<<<ENGLISH>>>
//	It won't matter if your direction
//	if off a little bit. Experiment with
//	it.

/*うまくすればつかまることが出来る
はずだ。多少方向がずれても大丈夫。
いろいろ試してみてくれ。
*/
}//d

resource TO_かねきっく__s {
オタコン_000: {
Cuando est&'es saltando en el modo
Colgando y tengas pulsado el bot&'on
Acci&'on,
}
//	<<<ENGLISH>>>
//	When you're springing up from
//	Hanging mode with the Action
//	button,
//<ページ数変更>
オタコン_000_1: {
aprovecha el impulso para derribar a alg&'un
enemigo.
}
//	<<<ENGLISH>>>
//	you can use the momentum
//	to knee someone.

/*エルードから△ボタンで這い上がる時、
反動で近くにいる敵にひざを打ち込む
ことが出来る。
*/
オタコン_001: {
Pru&'ebalo si ves al enemigo andando cerca
de la barandilla.
}
//	<<<ENGLISH>>>
//	If you see an enemy walking
//	near the railings, give it a try.

/*手すりのあたりを歩いている敵が
いたら狙ってみるといい。
*/
}//d

resource TO_インケン投げ__s {
オタコン_000: {
Cuando salgas a echar un vistazo,
selecciona la granada.
}
//	<<<ENGLISH>>>
//	Select the grenade
//	when you take a peek.
//<ページ数変更>
オタコン_000_1: {
Puedes pulsar el bot&'on Arma para lanzarla
y esc&'ondete detr&'as de un objeto.
}
//	<<<ENGLISH>>>
//	You can then use the Weapon
//	button to throw the grenade
//	while taking cover behind objects.

/*覗き込みをしている時にグレネードを
装備していれば＃｛□、武器｝＃ボタンで遮蔽物に隠れ
ながらグレネードを投げることが出来る。
*/
}//d

resource TO_ホールドアップアイテム搾取１__s {
オタコン_000: {
Si tienes suerte, despu&'es de atrapar a un
enemigo, podr&'as conseguir alg&'un objeto.
}
//	<<<ENGLISH>>>
//	If you get lucky, you could seize
//	an item from someone after you
//	hold them up.

/*敵をホールドアップさせた後、
うまくやればアイテムを奪うことが
出来るだろう。
*/
}//d

//ドッグタグホールドアップのみの場合 t //e

resource TO_ホールドアップアイテム搾取２__s {
オタコン_000: {
Algunos objetos s&'olo los podr&'as conseguir
si sujetas al enemigo. Si tienes tiempo,
deber&'ias probarlo.
}
//	<<<ENGLISH>>>
//	There are some items you can only
//	acquire from holdups. If you've got
//	the time, try it out.

/*ホールドアップからしか手に入らない
アイテムもあるみたいだ。余裕があれば
試してみるといい。
*/
}//d

resource TO_ドッグタグ取得後__s {
オタコン_000: {
Ponte las gafas infrarrojas y mira al
cuello del enemigo.
}
//	<<<ENGLISH(2)>>>
//	Put your Thermal Goggles on and
//	look at the enemy's neck area.

/*＃｛赤外線、サーマル｝＃ゴーグルで敵兵士の
首のあたりをよく見てみるといい。
*/
オタコン_001: {
Podr&'as ver si lleva una placa de
identificaci&'on.
}
//	<<<ENGLISH>>>
//	You should be able to see
//	if he has dog tags on.

/*ドッグタグを持っているかどうかが
わかるはずだ。
*/
}//d




//信管ヤバイよ！ＸＸＸＸＸＸＸｘｘ
resource TO_グレネード__s {
//vox t:vcXXXXXXX {
オタコン_000: {
Veo que tienes seleccionada la granada. 
}
//	<<<ENGLISH>>>
//	I see you have the
//	grenade equipped.
//<ページ数変更>
オタコン_000_1: {
Es una granada antipersonal.
Cuando se la lances al enemigo,
}
//	<<<ENGLISH>>>
//	It's an anti-personnel frag
//	grenade -- throw it at the
//	enemy
//<ページ数変更>
オタコン_000_2: {
la granada se fragmentar&'a, y acabar&'a con
&'el.
}
//	<<<ENGLISH>>>
//	and the blast and fragments
//	will take the enemy out.

/*グレネードを装備してるね。
投擲用の対人破片手榴弾だ。
爆風と破片で敵を倒すことが出来る。
*/
オタコン_001: {
Ten cuidado, si pulsas el bot&'on Arma
tirar&'as de la anilla.
}
//	<<<ENGLISH(2)>>>
//	Watch out -- pushing the Weapon
//	button will pull out the pin.
//<ページ数変更>
オタコン_001_1: {
Suelta el bot&'on Arma para lanzarla.
}
//	<<<ENGLISH>>>
//	Release the Weapon
//	button to toss it.
//<ページ数変更>
オタコン_001_2: {
La distancia a la que lances la granada,
depender&'a de lo fuerte que pulses el
bot&'on Arma.
}
//	<<<ENGLISH>>>
//	The throwing distance depends
//	on how hard you push the Weapon
//	button.

/*□ボタンを押すと信管を抜いて構え、
□ボタンを離すと投げる。□ボタンを
押した時の強さで投擲距離が変わるよ。
*/
オタコン_002: {
La granada explotar&'a cinco segundos
despu&'es de que tires de la anilla.
}
//	<<<ENGLISH>>>
//	After pulling the pin, you'll
//	have five seconds until the
//	grenade explodes.
//<ページ数変更>
オタコン_002_1: {
As&'i que ten cuidado y no tardes mucho
tiempo en decidir la distancia a la que vas
a lanzar la granada, o puede que explote
en tus manos.
}
//	<<<ENGLISH>>>
//	Get familiar with changing the
//	timing and throwing distance of
//	the grenade before it goes off.

/*構えてから爆発するまで約５秒ある。
爆発するまでの時間と投げる距離が
変えられる点をうまく使いこなすんだ。
*/
//dv}//v
}//d


resource TO_赤外線ゴーグル１__s {
//vox t:vcxxxxxxxxxx {
オタコン_000: {
Veo que tienes seleccionadas las Gafas
T&'ermicas, &~?no?
}
//	<<<ENGLISH>>>
//	You have the Thermal
//	Goggles equipped huh?
//<ページ数変更>
オタコン_000_1: {
Con ellas podr&'as ver en la oscuridad,
gracias al sistema de distribuci&'on del calor
que utilizan para crear una imagen.
}
//	<<<ENGLISH>>>
//	They provide night vision by using
//	variances in heat distribution to
//	create an image.

/*サーマル赤外線ゴーグルを使ってるね。
赤外線ゴーグルは物体の熱分布を
映像化する暗視装置だ。
*/

オタコン_001: {
Tienen dos sistemas de proyecci&'on
dimensional para crear im&'agenes 
}
//	<<<ENGLISH>>>
//	It uses a two dimensional solid
//	state projection system to create
//	high-res images
//<ページ数変更>
オタコン_001_1: {
a 60 fotogramas por segundo
en tiempo real.
}
//	<<<ENGLISH>>>
//	at sixty fps in real-time.


/*二次元固体撮像素子方式を採用して
高解像度、高感度で６０フレームの
リアルタイム映像を実現している。
*/
//dv}//v
}//d

//ドッグタグもっている場合
resource TO_赤外線ゴーグル２__s {
//vox t:vcxxxxxxxxxx {
オタコン_000: {
Con las Gafas T&'ermicas, podr&'as mirar el
cuello del enemigo para ver si lleva o no
placas de identificaci&'on.
}
//	<<<ENGLISH>>>
//	By using the Thermal Goggles, you
//	can take a look at the enemy's neck
//	to see if they have dog tags or not.

/*サーマル赤外線ゴーグルで敵兵士の
首もとを見てみればドッグタグを
もってるかどうかわかるかもしれないな。
*/
//dv}//v
}//d

resource TO_Ｍ４__s {
//vox t:vcxxxxxxxxxx {
オタコン_000: {
Veo que has seleccionado la M4. Es una
carabina de asalto est&'andar que utilizan
las tropas SOCOM.
}
//	<<<ENGLISH>>>
//	I see you have the M4 equipped.
//	It's a standard issue assault
//	carbine for SOCOM troops.

/*Ｍ４を持ってるね。
＃｛米特殊作戦、ＵＳ．ＳＯＯＭ｝＃コマンドで正式採用されてる
アサルトカービン銃だ。
*/

オタコン_001: {
Como la M16A2, tiene cartuchos de 5.56
mm, y puede llevar hasta 30 cargadores.
}
//	<<<ENGLISH>>>
//	Like the M16A2, it uses 5.56mm
//	cartridges, and can hold thirty
//	per magazine.

/*Ｍ１６Ａ２と同じ５．５６ｍｍ弾を使う。
装弾数は３０発だ
*/
オタコン_002: {
Est&'a equipada con un recibidor superior
plano y un asa desmontable, 
}
//	<<<ENGLISH>>>
//	It features a flat top upper
//	receiver and a detachable
//	carrying handle,
//<ページ数変更>
オタコン_002_1: {
y puede ser configurada de acuerdo con
las especificaciones de las Fuerzas
Especiales.
}
//	<<<ENGLISH>>>
//	and it can be configured
//	to the specifications of
//	the Special Forces.

/*フラットトップレシーバーと着脱式
キャリングハンドルなど特殊部隊の
要求に合わせた仕様になっている。
*/
//dv}//v
}//d

resource TO_生体センサー__s {
//vox t:vcxxxxxxxxxx {
オタコン_000: {
Veo que est&'as utilizando el Sensor
antipersonal. 
}
//	<<<ENGLISH>>>
//	You're using the Anti-personnel
//	Sensor, I see.
//<ページ数変更>
オタコン_000_1: {
Mide los campos electromagn&'eticos y los
latidos del coraz&'on de los seres vivos
}
//	<<<ENGLISH>>>
//	It measures the electromagnetic
//	fields and heartbeat of life forms＃−
//<ページ数変更>
オタコン_000_2: {
y convierte los datos en vibraciones.
}
//	<<<ENGLISH>>>
//	and converts the data
//	into vibrations.

/*生体センサーを使っているね。
人間の鼓動や微弱な生体電磁波を
検知して振動に変換するデバイスだ。
*/
オタコン_001: {
Si un enemigo pasa cerca, vibrar&'a.
}
//	<<<ENGLISH>>>
//	If an enemy draws near,
//	it will vibrate.
//<ページ数変更>
オタコン_001_1: {
Cuanto m&'as fuerte sea la vibraci&'on,
m&'as cerca estar&'a el enemigo.
}
//	<<<ENGLISH>>>
//	The stronger the vibration,
//	the closer the enemy is.

/*敵が接近すると振動して知らせてくれる。
振動が強いほど敵が近くにいるって
ことだ。
*/
オタコン_002: {
Pero recuerda, cuando est&'es utilizando
el sensor antipersonal,
}
//	<<<ENGLISH>>>
//	But, remember, when using
//	the Anti-personnel Sensor,
//<ページ数変更>
オタコン_002_1: {
s&'olo podr&'as sentir las vibraciones que
provienen del sensor.
}
//	<<<ENGLISH>>>
//	you'll only be able to feel
//	the vibrations coming from
//	the sensor.

/*ただ、生体センサーを使ってる間は
センサーが発生させる振動しか感じ取れ
なくなるってことは覚えておいてくれ。
*/
//dv}//v
}//d

resource TO_機関室エルード__s {
//vox t:vcXXXXXXXX {
オタコン_000: {
Snake, en la sala de motores hay muchas
estructuras s&'olidas, 
}
//	<<<ENGLISH>>>
//	Snake, the engine room is
//	full of solid structures --
//<ページ数変更>
オタコン_000_1: {
as&'i que si el enemigo te est&'a persiguiendo,
te podr&'as escapar.
}
//	<<<ENGLISH>>>
//	you could probably use them
//	to get away when the enemy
//	is chasing you.

/*スネーク、機関室は立体的な構造に
なっている。それを利用すれば敵に
追われても逃げられるかもしれない。
*/

オタコン_001: {
Utiliza el modo Colgando razonablemente.
}
//	<<<ENGLISH>>>
//	Use the Hanging mode wisely.

/*エルードをうまく使うんだ。*/
//dv}//v
}//d

resource TO_タンカーカメラうんちく１__s {
//vox t:vcXXXXXXXX {
オタコン_000: {
Te explicar&'e c&'omo utilizar la c&'amara.
}
//	<<<ENGLISH>>>
//	I'll explain how
//	to use the camera.

/*カメラの説明をしておこうか。*/

オタコン_001: {
Esa c&'amara digital que tienes ha sido
especialmente fabricada para sacar fotos
del prototipo de Metal Gear.
}
//	<<<ENGLISH>>>
//	That digital camera you have was
//	specially made to take pictures of
//	the prototype Metal Gear.

/*君が持ってるのは新型メタルギアの
写真を撮るために作った特別製の
デジタルカメラだ。
*/

オタコン_002: {
Cuando saques una foto, ser&'a guardada en
la memoria interna de la c&'amara.
}
//	<<<ENGLISH>>>
//	When a picture is taken, the screen
//	data is first stored in the camera's
//	internal memory.

/*写真を撮るとその画像データはまず
カメラ本体に内蔵されたメモリーの中に
格納される。
*/

オタコン_003: {
Y luego se procesa autom&'aticamente
mediante diferentes algoritmos para
proteger la foto de cualquier manipulaci&'on.
}
//	<<<ENGLISH>>>
//	Then it's automatically processed
//	through various algorithms to
//	protect against tampering.

/*そこで電子的改竄を防ぐための
色々な処理が自動的に行われるように
なってるんだ。
*/

オタコン_004: {
Cada foto se encripta y se sella
electr&'onicamente.
}
//	<<<ENGLISH>>>
//	Each picture is electronically
//	stamped and distinctively
//	encrypted.
//<ページ数変更>
オタコン_004_1: {
O sea, que si alguien altera la informaci&'on
durante el proceso de transmisi&'on de la
foto, lo sabremos inmediatamente.
}
//	<<<ENGLISH>>>
//	So, in the off chance that someone
//	alters the data during transmission,
//	we'll know immediately.

/*電子透かしを埋め込んだり特製の暗号を
かけたりね。だから万一転送途中で誰か
にデータをいじられてもすぐにわかる。
*/

オタコン_005: {
Ah, pero la capacidad de la memoria
interna de la c&'amara tiene un espacio
limitado.
}
//	<<<ENGLISH>>>
//	Oh -- there's a limit to the
//	internal memory's capacity.

/*ただ、カメラの内蔵メモリーの容量には
限界があるんだ。
*/

オタコン_006: {
Si la memoria se llena, sobrescribe las
nuevas fotos sobre las que ya no
necesites.
}
//	<<<ENGLISH>>>
//	If the memory becomes full,
//	overwrite the pictures you
//	don't need anymore.

/*メモリーがいっぱいになったら、
いらない写真に上書きするといい。
*/
//dv}//v
}//d

//場合１ t //e
resource TO_タンカーカメラうんちく２__s {
//vox t:vcxxxxxxxx {
オタコン_000: {
Cuando ya est&'es listo para sacar una foto, 
}
//	<<<ENGLISH(2)>>>
//	When you're ready to take a shot,
//<ページ数変更>
オタコン_000_1: {
pulsa los botones L1 y R1 para mover el
cursor que aparece en la parte inferior de
la pantalla, hacia la izquierda o la derecha.
}
//	<<<ENGLISH>>>
//	use the L1 and R1 buttons to move
//	the cursor at the bottom of the screen
//	to the left or right.

/*カメラを構えた状態でＬ１ボタン、
Ｒ１ボタンを押すと画面下のカーソルを
それぞれ左右に動かせる。
*/
//dv}//v
}//d

//場合２ t //e
resource TO_タンカーカメラうんちく３__s {
//vox t:vcxxxxxxxx {
オタコン_000: {
Cuando ya est&'es listo para sacar una foto,
pulsa los botones L1 y R1 para ver las
previsualizaciones
}
//	<<<ENGLISH>>>
//	When you're ready to take a shot,
//	use the L1 and R1 buttons to scroll
//	left or right＃−
//<ページ数変更>
オタコン_000_1: {
de las fotos que aparecen en la parte
inferior de la pantalla.
}
//	<<<ENGLISH>>>
//	among the picture previews
//	at the bottom of the screen.

/*カメラを構えた状態でＬ１ボタン、
Ｒ１ボタンを押すと画面下の写真の
プレビューをそれぞれ左右に動かせる。
*/
//dv}//v
}//d

resource TO_タンカーカメラうんちく４__s {
//vox t:vcxxxxxxxx {
オタコン_000: {
Selecciona la foto que ya no quieras y la
nueva foto se sobrescribir&'a sobre la foto
seleccionada.
}
//	<<<ENGLISH>>>
//	Select an unwanted picture and
//	the new shot will overwrite the
//	selected picture.

/*いらない写真を選んでそのまま写真を
撮れば、新しい写真をそこに上書き
出来るっていう仕組みだ。
*/
//dv}//v
}//d

//第三船倉にいる場合 t //e
resource TO_タンカーカメラうんちく５__s {
