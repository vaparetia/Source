//	a gun, okay? Please?

/*絶対に銃を撃ったりしちゃダメだ。
いいね。
*/

}//d


//・ＴＶ兵近く：ＴＶ兵について h //e
resource TO_船倉ＴＶ兵__s {
//
オタコン_000: {
As&'i que &'el estaba retransmitiendo todo
esto.
}
//	<<<ENGLISH>>>
//	Oh, so he was broadcasting
//	all this stuff.

/*映像はその兵隊が中継してたんだね。
*/
//ＴＶ会話聞いていない場合、ＴＶ会話へ t //e

}//d

//・消防ポール上側近く：下り方。一度下りたら上れない h //e
resource TO_ポール上__s {
オタコン_000: {
Snake, puedes usar ese m&'astil para bajar
al nivel inferior.
}
//	<<<ENGLISH>>>
//	Snake, you can use that pole to
//	get down to the level below.

/*スネーク、そこにあるポールをつたえば
下の階に下りられるはずだ。
*/

オタコン_001: {
Cuando est&'es enfrente del m&'astil pulsa el
bot&'on Acci&'on para sujetarte al m&'astil.
}
//	<<<ENGLISH>>>
//	Face the pole and push the Action
//	button to grab a hold of the pole.

/*ポールにつかまるにはポールの方を向いて＃｛△、アクション｝＃ボタンを押せばいい。*/

オタコン_002: {
Pero una vez que hayas bajado, ya no
podr&'as volver a subir. 
}
//	<<<ENGLISH>>>
//	But once you slide down, you
//	won't be able to go back up.
//<ページ数変更>
オタコン_002_1: {
Aseg&'urate que has terminado con esta
planta antes de bajar.
}
//	<<<ENGLISH>>>
//	Make sure you're finished with
//	this floor before going down.

/*でも一度下りたら、もう上には上がれ
ないだろう。下りるのはその階でしたい
ことを全部終えてからの方がいいね。
*/

}//d

//・消防ポール下側近く：下からは上れません h //e
resource TO_ポール下__s {
オタコン_000: {
Snake, no vas a poder volver a subir por
ah&'i. 
}
//	<<<ENGLISH>>>
//	Snake, you're not going to be
//	able to climb back up that thing.
//<ページ数変更>
オタコン_000_1: {
Deber&'ias olvidarte de subir a ese nivel.
}
//	<<<ENGLISH>>>
//	You should forget about
//	going up to that level.

/*スネーク、そのポール、下からは
上れないそうにない。上の階に行くのは
諦めたほうがいいね。
*/

}//d


//・電送機近く：電送機について h //e
resource TO_電送機__s {
オタコン_000: {
Snake, esa terminal es la conexi&'on entre la
intranet del buque y el mundo exterior. 
}
//	<<<ENGLISH>>>
//	Snake, that workstation is the
//	transfer point between the tanker's
//	intranet and the outside world.
//<ページ数変更>
オタコン_000_1: {
Usalo para mandar las fotos al exterior.
}
//	<<<ENGLISH>>>
//	Use it to send those pictures over.

/*スネーク、そこにあるコンピュータが
外に繋がってるＷＳだ。
それを使って写真をこっちに送ってくれ。
*/

オタコン_001: {
Lo &'unico que tienes que hacer es ponerte
enfrente del ordenador
}
//	<<<ENGLISH>>>
//	All you have to do is face the
//	computer and push the Action
//	button,
//<ページ数変更>
オタコン_001_1: {
y pulsar el bot&'on Acci&'on." 
}
//	<<<ENGLISH>>>
//	and the photos will be sent. 

/*写真を送信する時は、そのＷＳの前に
立って＃｛△、アクション｝＃ボタンを押すだけでいい。
*/

オタコン_002: {
&~!Espero que hayas tomado una buena
Foto!
}
//	<<<ENGLISH>>>
//	Hope you took a good one!

/*いい写真を頼むよ！*/

}//d

//・二回目のみ h //e
resource TO_電送機説明__s {
オタコン_000: {
Esta terminal est&'a conectada a la mayor
red militar;
}
//	<<<ENGLISH>>>
//	That workstation is hooked up
//	to the greater military network;
//<ページ数変更>
オタコン_000_1: {
el discurso de la bodega se retransmitir&'a a
trav&'es de esa m&'aquina.
}
//	<<<ENGLISH>>>
//	the speech in the holds is being
//	relayed out through that machine.
//<ページ数変更>
オタコン_000_2: {
Nosotros tambi&'en la utilizaremos.
}
//	<<<ENGLISH>>>
//	We'll be making use of it too.

/*そのＷＳは軍事ネットワークに
繋がってる。演説の映像もそこから送信
されているんだ。それを僕らは利用する。
*/

オタコン_001: {
He logrado ponerme en contacto con un
router del Ej&'ercito (Army IC) en Ohio.
}
//	<<<ENGLISH>>>
//	I managed to get in through
//	an Army IC router in Ohio.

/*僕はオハイオにある陸軍のインター
ネット・コントローラ・ルーターから
軍事ネットワークに侵入した。
*/

オタコン_002: {
He tenido que usar el Link-16 para instalar,
remotamente, unos drivers
}
//	<<<ENGLISH>>>
//	All I had to do from there was
//	use the Link-16 to remotely
//	install a few drivers＃−
//<ページ数変更>
オタコン_002_1: {
y aplicarlo a esa terminal.
}
//	<<<ENGLISH>>>
//	and an application onto
//	that workstation.
//<ページ数変更>
オタコン_002_2: {
De este modo, tu c&'amara podr&'a
comunicarse con su ordenador.
}
//	<<<ENGLISH>>>
//	So your camera can talk
//	to their computer now.

/*そこからリンク１６経由でそのＷＳに
写真を送信するためのアプリケーション
をリモート・インストールしたのさ。
*/

オタコン_003: {
Eh, incluso las redes militares emplean
productos basados en tecnolog&'ia
comercial.
}
//	<<<ENGLISH>>>
//	Hey, even military networks use
//	products based on commercial
//	technology.
//<ページ数変更>
オタコン_003_1: {
&~!Qu&'e novedad!
}
//	<<<ENGLISH>>>
//	Nothing too unfamiliar there.

/*なに、軍事ネットワークは基本的に
民生品ベースの技術を応用してるからね。
軽いもんだよ。
*/

オタコン_004: {
Adem&'as, me cort&'e el paso a la puerta de
atr&'as cuando todav&'ia ten&'ia acceso. 
}
//	<<<ENGLISH>>>
//	Besides, I cut myself a back
//	door when I still had access.
//<ページ数変更>
オタコン_004_1: {
Tuve muchos accesos privilegiados
mientras desarroll&'abamos REX.
}
//	<<<ENGLISH>>>
//	I had a lot of access privileges
//	while we were developing REX.

/*それにあらかじめバックドアも仕掛けて
あったんだ。ＲＥＸを作ってた時に
陸軍のネットにはアクセス出来たから。
*/

オタコン_005: {
Oye, &~?est&'as escuchando?
}
//	<<<ENGLISH>>>
//	Hey, are you listening?

/*ねぇ話聞いてる？*/

スネーク_000: {
Oh, s&'i por supuesto...
}
//	<<<ENGLISH(2)>>>
//	Oh, ah, yeah...

/*あ、ああ……。*/

オタコン_006: {
&~?De verdad? El programa comprimir&'a, los
datos de la fotograf&'ia.
}
//	<<<ENGLISH>>>
//	Really? Anyway, the program will
//	compress, encrypt and packetize
//	the photo's image data.
//<ページ数変更>
オタコン_006_1: {
Por cierto, he usado BATON para la
encriptaci&'on.
}
//	<<<ENGLISH>>>
//	I used BATON for encryption,
//	by the way.

/*本当に？で、そのアプリは写真のデータ
を圧縮・暗号化・分割して送信する。
暗号化にはＢＡＴＯＮを使ったよ。
*/

オタコン_007: {
Y lo mejor es que los paquetes apareceran
con un formato TADIL-J. 
}
//	<<<ENGLISH>>>
//	And the beauty of it is -- the packets
//	are disguised to look like the TADIL-J
//	message format.
//<ページ数変更>
オタコン_007_1: {
&~?Lo entiendes? Es un formato de Enlace
de Informaci&'on Digital T&'actica est&'andar
}
//	<<<ENGLISH>>>
//	Get it? It's the standard Tactical
//	Digital Information Link message
//	format,
//<ページ数変更>
オタコン_007_2: {
y los paquetes se enviar&'an encubiertos.
}
//	<<<ENGLISH>>>
//	and the packets will be sent out
//	cloaked by their own speech
//	broadcast.

/*パケットは＃｛戦術デジタル情報リンク、ＴＡＤＩＬ｝＃
Ｊメッセージフォーマットに偽装され、
演説の画像に紛れて送信されるんだ。
*/


オタコン_008: {
&~!No me digas que no es una pasada!
}
//	<<<ENGLISH>>>
//	Tell me that isn't brilliant!

/*どう？わかった？*/

スネーク_001: {
...
}
//	<<<ENGLISH(2)>>>
//	...

/*……。*/

オタコン_009: {
&~?Quieres que vuelva a revisarlo?
}
//	<<<ENGLISH>>>
//	Want me to go over it again?

/*もう一回説明しようか？*/

スネーク_002: {
No, con una vez es suficiente.
}
//	<<<ENGLISH>>>
//	No, once was enough.

/*いや、もう充分だ。*/

}//d


//・カメラ使い方 h //e
resource TO_カメラ使い方１__s {
オタコン_000: {
Snake, usa la c&'amara para tomar fotos del
nuevo prototipo Metal Gear.
}
//	<<<ENGLISH>>>
//	Snake, use the camera to take
//	photos of the new Metal Gear
//	prototype.

/*スネーク、カメラで新型メタルギアの
写真を撮ってくれ。
*/
}


//＠カメラの仕様ボタンは固定？ //e
