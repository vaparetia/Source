*/
}


resource TO_エルード４の２__s {
//＊ムービー t //e
オタコン_000: {
Si el salto es muy grande, perder&'as algo
de LIFE. 
}
//	<<<ENGLISH>>>
//	If the ground is too far
//	below, you'll lose some
//	LIFE.
//<ページ数変更>
オタコン_000_1: {
En algunas partes, no lo lograr&'as. Ten
cuidado con eso.
}
//	<<<ENGLISH>>>
//	In some places, you won't
//	make it at all. Be careful
//	of that.

