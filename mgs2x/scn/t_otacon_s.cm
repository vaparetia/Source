*/
オタコン_001: {
En alg&'un momento, bajar&'a la guardia. &'Esa
ser&'a tu oportunidad.
}
//	<<<ENGLISH>>>
//	She'll lower her guard at some
//	point. That's your opportunity.

/*必ず隙が出来る。そこを狙うんだ。
*/

}//d

resource TO_オルガ戦幌は通らない__s {
オタコン_000: {
Snake, te est&'a disparando desde la lona. 
}
//	<<<ENGLISH>>>
