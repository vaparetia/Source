//・レイブン影近く h //e
resource TO_レイブン影正体前__s {
オタコン_000: {
Snake, esa sombra... es... 
}
//	<<<ENGLISH>>>
//	Snake, that shadow -- it's --

/*スネーク、あの影は……？*/

