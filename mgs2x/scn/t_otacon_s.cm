//★デフォルト。ランダム（操作等ゲームの説明）基本的に序盤のみ、ある確率で発生 d //e

//○仕様 d //e
//・ルードの仕方。h //e
resource TO_エルード１の１__s {
//＊ムービー t //e
オタコン_000: {
Pulsa el bot&'on Acci&'on que hay cerca de la
barandilla para saltar al otro lado .
}
//	<<<ENGLISH>>>
//	Push the Action button near
//	a scalable railing to hang off
//	the other side.

/*乗り越えられる手すりの近くで
＃｛△、アクション｝＃ボタンを押すと、その手すりの
向こう側にぶらさがることが出来る。
*/
}


resource TO_エルード１の２__s {
//＊ムービー t //e
オタコン_000: {
Esto se llama Colgando.
}
//	<<<ENGLISH(2)>>>
//	This is called Hanging.
//<ページ数変更>
オタコン_000_1: {
Podr&'as usarlo para moverte de un lado a
otro, esconderte e incluso maniobrar a
espaldas de un enemigo.
}
//	<<<ENGLISH>>>
//	You can use it to move around,
//	hide, and even maneuver around
//	an enemy's back.

/*これをエルードっていうんだ。
移動だけじゃなく、隠れたり敵の背後を
とったりするのにも使えるはずだ。
*/
}


resource TO_エルード２の１__s {
//＊ムービー t //e
オタコン_000: {
Pulsa el joystick anal&'ogico izquierdo o
los botones L2 y R2 para moverte hacia
la izquierda o derecha cuando est&'es
Colgado.
}
//	<<<ENGLISH>>>
//	You can move left and right while
//	Hanging by moving the left analog
//	stick or using the L2 and R2 buttons.

/*
You can move the left analog stick
or use the L2 and R2 buttons to
move left and right while hanging.
エルード中は左スティックの左右か
Ｌ２ボタン、Ｒ２ボタンで左右に
移動出来る。
*/
}


resource TO_エルード２の２__s {
//＊ムービー t //e
オタコン_000: {
Cuando est&'es listo para saltar hacia arriba,
vuelve a pulsar el bot&'on Acci&'on.
}
//	<<<ENGLISH>>>
//	When you're ready to pull yourself
//	up, just push the Action button again.

/*這い上がりたくなったら、
もう一度＃｛△、アクション｝＃ボタンを押せばいい。
*/
}



resource TO_エルード３の１__s {
//＊ムービー t //e
オタコン_000: {
El indicador de GRIP estar&'a bajo LIFE
cuando est&'es colgando.
}
//	<<<ENGLISH>>>
//	A Grip Gauge appears below
//	the Life Gauge during Hanging.

/*あと、エルード中は＃｛ＬＩＦＥ、ライフ｝＃ゲージの
下に＃｛握力、グリップ｝＃ゲージが表示されるんだ。
*/

オタコン_001: {
El indicador de GRIP muestra la fuerza
con la que est&'as agarrado 
}
//	<<<ENGLISH>>>
//	The Grip Gauge indicates how
//	tightly you are holding on,
//<ページ数変更>
オタコン_001_1: {
mientras est&'es colgando, que ir&'a
disminuyendo progresivamente.
}
//	<<<ENGLISH>>>
//	and steadily decreases as long
//	as you are in Hanging mode.

/*＃｛握力、グリップ｝＃ゲージは君の握力を表していて、
エルードしている間、少しずつ減って
いく。
*/
}


resource TO_エルード３の２__s {
//＊ムービー t //e
オタコン_000: {
Cuando el indicador de GRIP llegue a
cero, no podr&'as sostenerte m&'as.
}
//	<<<ENGLISH>>>
//	When the Grip Gauge goes to
//	zero, you won't be able to hold
//	on anymore.
//<ページ数変更>
オタコン_000_1: {
Necesitas levantarte antes de caer.
}
//	<<<ENGLISH>>>
//	You need to hoist yourself
//	up before you fall off.

/*＃｛握力、グリップ｝＃ゲージが無くなったら、つかまっていられなくなって下に落ちてしまう。
そうなる前に這い上がった方がいいね。
*/
}


resource TO_エルード４の１__s {
//＠×か、ホフクか //e
//＊ムービー t //e
オタコン_000: {
Pulsa el bot&'on Cancelar cuando est&'es
Colgando para saltar justo abajo.
}
//	<<<ENGLISH>>>
//	Push the Crawl button
