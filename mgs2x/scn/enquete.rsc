resource アメリカアンケート {
	１番:{
I've cleared the previous game multiple times,
so bring on the action!
	 },
	２番:{
I managed to clear the previous game,
but action isn't my strong point!
	},
	３番:{
I didn't clear the previous game myself,
but I watched everything!
	},
	４番:{
I didn't clear the previous game
and action isn't my strong point!
	},
	５番:{
I didn't clear the previous game,
but bring on the action!
	},
};

resource フランスアンケート {
	１番:{
J'ai remport&'e le jeu pr&'ec&'edent &`a maintes
reprises, allez-y !
	 },
	２番:{
J'ai r&'eussi &`a remporter le jeu pr&'ec&'edent, mais
l'action n'est pas mon fort !
	},
	３番:{
Je n'ai pas remport&'e le jeu pr&'ec&'edent moi-m&^eme,
mais je l'ai vu faire !
	},
	４番:{
Je n'ai pas remport&'e le jeu pr&'ec&'edent et l'action
n'est pas mon fort !
	},
	５番:{
Je n'ai pas remport&'e le jeu pr&'ec&'edent, mais
allez-y !
	},
};

resource ドイツアンケート {
	１番:{
Ich habe das letzte Spiel mehrmals beendet - her
mit der Action!
	 },
	２番:{
Ich habe das letzte Spiel beendet, aber Action ist
nicht mein Forte!
	},
	３番:{
Ich habe das letzte Spiel nicht selbst beendet,
aber zugeschaut!
	},
	４番:{
Ich habe das letzte Spiel nicht beendet, und Action
ist nicht mein Forte!
	},
	５番:{
Ich habe das letzte Spiel nicht beendet, aber her
mit der Action!
	},
};

resource イタリアアンケート {
	１番:{
Ho superato parecchie volte l'ultimo gioco, ora
voglio un po' di azione!
	 },
	２番:{
Sono riuscito a superare l'ultimo gioco ma l'azione
non &`e il mio forte!
	},
	３番:{
Non ho superato io l'ultimo gioco, ma ho visto
tutto!
	},
	４番:{
Non ho superato l'ultimo gioco e l'azione non &`e
neanche il mio forte!
	},
	５番:{
Non ho superato l'ultimo gioco, ma ora voglio un
po' di azione!
	},
};

resource スペインアンケート {
	１番:{
He conseguido superar varias veces el &'ultimo juego,
&~!as&'i que m&'as acci&'on!
	 },
	２番:{
He conseguido superar el &'ultimo juego, pero la acci&'on
no es mi punto fuerte!
	},
	３番:{
No he conseguido superar el &'ultimo juego, &~!pero
lo he visto todo!
	},
	４番:{
No he conseguido superar el &'ultimo juego y &~!la acci&'on
no es precisamente mi punto fuerte!
	},
	５番:{
No he conseguido superar el &'ultimo juego, &~!pero estoy
preparado para m&'as acci&'on!
	},
};

resource 日本アンケート {
	１番:{
前作を何度もクリアしたのでアクションは得意！
	 },
	２番:{
前作をなんとかクリアしたがアクションは苦手！
	},
	３番:{
前作は自力ではクリアしてないが最後まで観た！
	},
	４番:{
前作はクリアしてないが、アクションは苦手！
	},
	５番:{
前作はクリアしてないが、アクションは得意！
	},
};
