	proc ダメージモーション発動 {
		#if d:DEBUG_PRINT 
			print 'player_dam_motion_go'
		#endif

		// ダンボールつき
		mesg プレイヤー d:PLAYER motion \
			d:モーションリスト:rai_non_dam_sps_f \
			3072 3072 d:FA_END_DOWN_BACK d:FA_BOX_EXIST

		// ダンボール壊す
		command 装備ダンボール破壊
		command ＳＥセットモード -s d:SD_A_DAMBRA01 \
			-p $i:プレイヤー位置Ｘ,$i:プレイヤー位置Ｙ,$i:プレイヤー位置Ｚ -m 0

		command	強制モーション終了プロック \
			-motion d:モーションリスト:rai_non_dam_sps_f \
			-proc ビリビリモーション終了
	}

	proc ビリビリモーション終了 {
		#if d:DEBUG_PRINT 
			print 'player_lightning_motion_end'
		#endif

		eval( $f:w31a_電撃床デモ発動中フラグ = 0 );
		mesg マルチウェイト髪の毛モデル ライデン髪の毛 髪の毛逆立ちモード 0 0 270
		command プレイヤーライフ値操作 -type 0 -mode 1 -value -20

		chara カメラ設定 モーションカメラ -s -1
		mesg ブラー 電撃ブラー キャラ削除
	}


	// 大統領張り付きシナリオデモ
	proc 大統領張り付きシナリオデモ設定 {
		#if d:DEBUG_PRINT 
			print 'prez_behinddemo_set'
		#endif

		// 北側廊下部分の張り付きカメラ(電源パネルが破壊されるとトラップがオフされます)
		trap ca015 d:PLAYER \
			-mask 入る \
			-dir 2048 512 \
			-state d:TRP_STATE_CAUTION \
			-camera \
			-exec {
				if ( $f:w31a_大統領シナリオデモフラグ == 0 && (`command ゲームオーバーチェック` == 0 ) && \
					 $f:w31a_大統領シナリオデモ中フラグ == 0 ) {
					command コントロール座標取得 \
						健康な大統領 $i:ローカル変数Ｉ１ $i:ローカル変数Ｉ２ $i:ローカル変数Ｉ３

					if ( $i:ローカル変数Ｉ３ < -243500 ) {
						eval( $f:w31a_大統領シナリオデモ中フラグ = 1 );
						eval( $f:w31a_大統領シナリオデモフラグ = 1 );
						@シナリオデモ開始処理

						mesg サウンドマネージャー ＳＤマネ SD_CODE d:SNG_FOUTP_S
						command ＳＥセットモード -s d:se_code:SD_S_JINGLE01 \
							-p $i:プレイヤー位置Ｘ,$i:プレイヤー位置Ｙ,$i:プレイヤー位置Ｚ -m 3

						chara カメラ設定 シナリオデモカメラ \
							-c 1 \	
							-b 0,8725,-247509 5600,8725,-247509 \
							-l 0,1588,-247772 5600,1588,-247772 \
							-p $i:カメラＸ位置,8002,$i:カメラＺ位置 -t $i:注視点Ｘ位置,1623,$i:注視点Ｚ位置 \
							-r 749,2048,0 -f 6992 \
							-a 200 \
							-z d:CAMERA_LIMITBOUND_EXIST \
							-i 0 0 0 0 \
							-s 1

						chara カメラ設定 シナリオデモカメラ \
							-c 1 \
							-b 0,8725,-247509 5600,8725,-247509 \
							-l 0,1588,-247772 5600,1588,-247772 \
							-p $i:ローカル変数Ｉ１,8002,$i:ローカル変数Ｉ３ \
							-t $i:ローカル変数Ｉ１,1623,($i:ローカル変数Ｉ３-263) \
							-a 200 \
							-z ( d:CAMERA_INTERP_CAMERA | d:CAMERA_LIMITBOUND_EXIST ) \ // 補完カメラフラグを指定。
							-interp_time (60*4) \ // 補完時間を指定
							-s 1

						chara delay カメラディレイ \
							-time (60*4) \
							-exec {
								eval( $f:w31a_大統領シナリオデモ中フラグ = 0 );
								mesg サウンドマネージャー ＳＤマネ SD_CODE d:SNG_FIN_S
								chara カメラ設定 シナリオデモカメラ -s -1
								@シナリオデモ終了処理
							}
					}
				}
			}

		// 休憩室部分の張り付きカメラ(電源パネルが破壊されるとトラップがオフされます)
		trap ca016 d:PLAYER \
			-mask 入る \
			-dir 3072 512 \
			-state d:TRP_STATE_CAUTION \
			-camera \
			-exec {
				if ( $f:w31a_大統領シナリオデモフラグ == 0 && (`command ゲームオーバーチェック` == 0 ) && \
					 $f:w31a_大統領シナリオデモ中フラグ == 0 ) {
					command コントロール座標取得 \
						健康な大統領 $i:ローカル変数Ｉ１ $i:ローカル変数Ｉ２ $i:ローカル変数Ｉ３

					if ( $i:ローカル変数Ｉ３ < -243500 ) {
						eval( $f:w31a_大統領シナリオデモ中フラグ = 1 );
						eval( $f:w31a_大統領シナリオデモフラグ = 1 );
						@シナリオデモ開始処理
						mesg サウンドマネージャー ＳＤマネ SD_CODE d:SNG_FOUTP_S
						command ＳＥセットモード -s d:se_code:SD_S_JINGLE01 \
							-p $i:プレイヤー位置Ｘ,$i:プレイヤー位置Ｙ,$i:プレイヤー位置Ｚ -m 3

						command コントロール座標取得 \
							健康な大統領 $i:ローカル変数Ｉ１ $i:ローカル変数Ｉ２ $i:ローカル変数Ｉ３

						chara カメラ設定 シナリオデモカメラ \
							-c 1 \	
							-p -2891,8002,-242183 -t -2891,1623,-245046 \
							-r 749,2048,0 -f 6992 \
							-a 200 \
							-i 0 0 0 0 \
							-s 1

						if ( $i:ローカル変数Ｉ１ > 5600 ) {
							eval( $i:ローカル変数Ｉ１ = 5600 );
						}

						chara カメラ設定 シナリオデモカメラ \
							-c 1 \
							-p $i:ローカル変数Ｉ１,8002,-242183 \
							-t $i:ローカル変数Ｉ１,1623,-245046 \
							-a 200 \
							-z d:CAMERA_INTERP_CAMERA \ // 補完カメラフラグを指定。
							-interp_time 300 \ // 補完時間を指定
							-s 1

						chara delay カメラディレイ \
							-time 300 \
							-exec {
								eval( $f:w31a_大統領シナリオデモ中フラグ = 0 );
								mesg サウンドマネージャー ＳＤマネ SD_CODE d:SNG_FIN_S
								chara カメラ設定 シナリオデモカメラ -s -1
								@シナリオデモ終了処理
							}
					}
				}
			}
	}



	proc 電源パネル破壊ポリデモへ {
		#if d:DEBUG_PRINT 
			print 'panel_broken_polydemo_go'
		#endif

		if ( $w:p_story < d:ST:P048_01_P01電源パネル破壊１ポリゴンデモ１開始 ) {
			eval( $i:プレイヤー初期Ｘ位置 = $i:プレイヤー位置Ｘ ) ;
			eval( $i:プレイヤー初期Ｙ位置 = $i:プレイヤー位置Ｙ ) ;
			eval( $i:プレイヤー初期Ｚ位置 = $i:プレイヤー位置Ｚ ) ;
			eval( $i:プレイヤー初期方向 = $w:プレイヤー方向 )
			eval( $b:プレイヤー初期姿勢 = $w:プレイヤー姿勢 ) ;
			eval( $s:登場ポイント = 電源パネルポリゴンデモへ );
			// 大統領の現在地を取得
			command ニキータイベント大統領耐久値取得 $i:大統領ライフ現在値
			@ポリデモアイテムチェック後スタート d:ST:P048_01_P01電源パネル破壊１ポリゴンデモ１開始
		}
	}


	// 無線デモムービーデモ設定
	// ------------------------------------
	proc タンカー編整理１無線機デモ設定 {
		#if d:DEBUG_PRINT 
			print 'tanker_demo1_set'
		#endif

		trap ev002 d:PLAYER \
			-mask 入る \
			-exec {
				// P050_01_R01タンカー編整理１無線機デモ１開始へ
/*
				if ( $w:p_story < d:ST:P050_01_R01タンカー編整理１無線機デモ１開始 && \
					 (`command ゲームオーバーチェック` == 0 )) {
					eval( $i:プレイヤー初期Ｘ位置 = $i:プレイヤー位置Ｘ );
					eval( $i:プレイヤー初期Ｙ位置 = $i:プレイヤー位置Ｙ );
					eval( $i:プレイヤー初期Ｚ位置 = $i:プレイヤー位置Ｚ );
					eval( $i:プレイヤー初期方向 = $w:プレイヤー方向 );
					eval( $b:プレイヤー初期姿勢 = $w:プレイヤー姿勢 ) ;
					eval( $s:登場ポイント = タンカー編回想デモ開始 );
					// 大統領の位置も覚える
					if ( $w:p_story >= d:ST:P049_11_P02大統領１１ポリゴンデモ２終了 ) {
						command コントロール座標取得 大統領死体 $i:w31a_大統領Ｘ位置,$i:w31a_大統領Ｙ位置,$i:w31a_大統領Ｚ位置
					}
					@rt_P049_12_R05大統領１２無線機デモ５
				}
*/
			}
	}

	proc 無線開始位置へ移動 {
		mesg プレイヤー d:PLAYER run 5125 0 -240750 0 1024 \
			(d:FA_DIRECT_MOVE) 大佐へ無線

		chara delay カメラディレイ \
			-time 1 \
			-exec {
				chara カメラ設定 シナリオデモカメラ \
					-c 1 \	
					-p 9547,149,-240066 -t 4712,1191,-240768 \
					-r 3959,2978,0 -f 4996 \
					-a 200 \
					-i 0 0 0 0 \
					-s 1
			}
	}

	proc 大佐へ無線 {
		eval( $i:プレイヤー初期Ｘ位置 = $i:プレイヤー位置Ｘ );
		eval( $i:プレイヤー初期Ｙ位置 = $i:プレイヤー位置Ｙ );
		eval( $i:プレイヤー初期Ｚ位置 = $i:プレイヤー位置Ｚ );
		eval( $i:プレイヤー初期方向 = $w:プレイヤー方向 );
		eval( $b:プレイヤー初期姿勢 = d:FA_END_STAND ) ;
		eval( $s:登場ポイント = タンカー編回想デモ開始 );
		// 大統領の位置も覚える
		if ( $w:p_story >= d:ST:P049_11_P02大統領１１ポリゴンデモ２終了 ) {
			command コントロール座標取得 大統領死体 $i:w31a_大統領Ｘ位置,$i:w31a_大統領Ｙ位置,$i:w31a_大統領Ｚ位置
			command コントロール方向取得 大統領死体 $i:w31a_大統領方向
			command 倒れ状態取得 大統領死体 $w:w31a_大統領状態
		}
		@rt_P049_12_R05大統領１２無線機デモ５
	}

	// 大統領死体設定
	// ------------------------------------
	proc 大統領死体設定 {
		#if d:DEBUG_PRINT 
			print 'prez_set'
		#endif

		chara 死体君 大統領死体 \
			-m jam_def_sh_mt \
			-e jam_def_deadface \
			-d $w:w31a_大統領状態 \	// あお向け
			-p $i:w31a_大統領Ｘ位置,0,$i:w31a_大統領Ｚ位置 \
			-r 0,$i:w31a_大統領方向,0 \
			-s ( d:CORPS_ST_EVM | d:CORP_STATUS_NOHIT )	// マルチテクスチャ

		// 大統領ネクタイ
		chara ロープモデル３ ネクタイ \
			-n jam_tie \
			-d 6 \
			-b jam_bounding2 \
			-y 大統領死体 \
			-z 2 \
			-x 0,0,0 \
			-m 22 \
			-p 250 \
			-k 350 \
			-o 100 \
			-f 1 \
			-h 1

	}

	proc 大統領用アタリ追加 {
		#if d:DEBUG_PRINT
			print 'w31a_hzd_add'
		#endif

		command 追加ＨＺＸグループ登録 -h 0 -a 1
	}

	// オルガ設定
	// ------------------------------------
	proc オルガ設定 {
		#if d:DEBUG_PRINT 
			print 'olg_set'
		#endif

		if ( $w:p_story == d:ST:P047_02_I01電撃床前オルガ２インタラクティブ主観デモ１開始 ) {
			chara ルートデモ人形 オルガ \
				-route 3 0 \ 
				-kms org_plant_sh_mt \		//	影／映り込み用
				-evm org_plant_mh_mt \
				-mar org_w31a \
				-number d:オルガモーションリスト:org_walk

			chara マルチウェイト髪の毛モデル プラントオルガの髪 \
				-n org_plant_hair_mh\
				-d 20 \
				-y オルガ \
				-b org_plant_dummy \
				-z 11 12 \
				-o 100 \
				-f 1 \
				-c 2 { 11 12 }

			chara 装備品Ｃ オルガ無線機 \
				-n org_radio_forhand \
				-y オルガ \
				-z 10 \
				-x 0,-169,-68 \
				-r 3595,0,2048 \
				-f 1

		} else if ( $w:p_story == d:ST:P047_04_I02電撃床前オルガ４インタラクティブ主観デモ２開始 ) {
			chara ルートデモ人形 オルガ \
				-route 4 0 \ 
				-kms org_plant_sh_mt \		//	影／映り込み用
				-evm org_plant_mh_mt \
				-mar org_w31a \
				-number d:オルガモーションリスト:org_walk

			chara マルチウェイト髪の毛モデル プラントオルガの髪 \
				-n org_plant_hair_mh\
				-d 20 \
				-y オルガ \
				-b org_plant_dummy \
				-z 11 12 \
				-o 100 \
				-f 1 \
				-c 2 { 11 12 }

			chara 装備品Ｃ オルガ無線機 \
				-n org_radio_forhand \
				-y オルガ \
				-z 10 \
				-x 0,-169,-68 \
				-r 3595,0,2048 \
				-f 1
		}

	}


	// コマンダー
	// ------------------------------------
	proc コマンダー設定 {
		#if d:DEBUG_PRINT
			print 'commander_set'
		#endif
		eval ($w:スタートアラートモード = d:ALERT_MODE_SENNYU);

		chara コマンダー 敵兵セット \
			-m $w:スタートアラートモード
	}





