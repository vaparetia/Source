#include "varinit.h"
#include "mksload.h"

//chara サウンドマネージャー ＳＤマネ -pak 0

/******************************************************************/
/******************************************************************/

chara 2Dレイアウトドライバ ２ＤＬＤ

//mesg サウンドマネージャー ＳＤマネ SD_CODE d:SNG_PLAY_01

chara ＶＲ体験版セレクト ＶＲ体験版セレクト \
	-save ＳＡＶＥ \
	-exit ＥＸＩＴ \
	-proc load_vs03a load_wp01a load_vs08a load_wp73a load_sp06a

print '前のステージは' $b:ＶＲ体験版ステージ番号

mesg ＶＲ体験版セレクト ＶＲ体験版セレクト 表示 $b:ＶＲ体験版ステージ番号

proc ＳＡＶＥ {
	chara セーブゲーム画面マネージャー セーブ画面 \
		-d save_load \
		-p セーブＥＸＩＴ \
		-i vrticon \
		-m d:SAVE_LOAD_MODE_VR
}

proc セーブＥＸＩＴ $:返り値 {

	if( $:返り値 != 0 ){
		$b:ＶＲ体験版ステージ番号 = 0 ;
	}
	mesg ＶＲ体験版セレクト ＶＲ体験版セレクト 表示 6
}

/******************************************************************/
//EXIT 処理
/******************************************************************/

resource アイテム取得時の文書 {
バンダナ:
	'DUMMY'
};

resource 結果画面用アイテム名 {
バンダナ:
	'DUMMY' , 
};

resource セーブ確認文日本語 {
確認:
	'セーブしますか？'

はい:
	'Yes'
いいえ:
	'No'
};

resource セーブ確認文英語 {
確認:
	'Save ?'

はい:
	'Yes'
いいえ:
	'No'
};

if ( $w:言語 == d:LANG_ENGLISH ){
	command ローカルリソース設定 \
		-string アイテム取得時メッセージ[アイテム取得時の文書:*] \
				セーブ確認文[セーブ確認文英語:*] \
				アイテム名[結果画面用アイテム名:*]
} else {
	command ローカルリソース設定 \
		-string アイテム取得時メッセージ[アイテム取得時の文書:*] \
				セーブ確認文[セーブ確認文日本語:*] \
				アイテム名[結果画面用アイテム名:*]
}

proc ＥＸＩＴ {
	if ( $b:ＶＲ体験版ステージ番号 != 0 ) {
		chara セーブ確認画面 セーブ確認 \
			-p セーブダイアログ表示 \
			-s セーブ確認文
	} else {
		@mv_trmenu_0 ;
	}
}

proc セーブダイアログ表示 $:返り値 {
	if ( $:返り値 == 0 ) {
		chara セーブゲーム画面マネージャー セーブ画面 \
			-d save_load \
			-p セーブダイアログ表示終了 \
			-i vrticon \
			-m d:SAVE_LOAD_MODE_VR
	} else {
		@mv_trmenu_0 ;
	}
}

proc セーブダイアログ表示終了 $:返り値 {
	if( $:返り値 != 0 ){
		@mv_trmenu_0 ;
	} else {
		mesg ＶＲ体験版セレクト ＶＲ体験版セレクト 表示 7
	}
}

