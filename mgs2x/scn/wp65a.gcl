// ------------------------------------
// マップ設定
// ------------------------------------
chara マップ 武器訓練ニキータ５面 -k d:KMS_NAME -h d:HZX_NAME,0 -l $s:ＶＲライトファイル名

command マップ設定 武器訓練ニキータ５面 -set {
	// ローカルの初期化
	// ------------------------------------
	@ローカル変数初期化		// ローカルで使用する変数で初期化をする場合はここで

	// ＶＲで必要な基本プロックのセット(vr_common.hで定義)
	// サウンドの基本パック、ＶＲの基本システム、プレイヤー、ゴール等を設定します
	// ※このプロックを使用する時は「ＶＲクリア時処理」というプロックが必要です
	// ------------------------------------
	@ＶＲ共通プロックセット sna_wp65a rai_wp65a d:VR_GOAL_TARGET 3750 0 21000

	// ＶＲウィンドウの設定
	// ------------------------------------
	@武器訓練ニキータ５面ＶＲウィンドウ設定

	// クリア時に呼ばれるものの設定
	// ------------------------------------
	@ＶＲクリア設定 p:load_select p:load_wp65a

	// ステージに引かれるライン
	// ------------------------------------
	@ＶＲアウトライン d:KMS_NAME d:TONBO_KMS_NAME d:LINE_KMS_NAME

	// 設定値を変更する場合は以下のプロック内で設定
	// ------------------------------------
	@設定値変更				// 敵兵や的のパラメータをステージ限定で変える時はここで
	@プラグイン設定			// プレイヤーのプラグインがいる時はここで
	@ジャンプ設定

	// 的関係の設定
	// ------------------------------------
	@ＶＲ標的ニキータ５面設定				// ＶＲシステム起動後に呼ぶ


	// ＢＧＭの設定(プレイヤー→敵兵→BGMの順で呼ぶ。的の場合は関係ないがとりあえずここに)
	// ------------------------------------
	@ＢＧＭ設定

	// アイテムの設定
	// ------------------------------------
	@アイテム設定

	// 光源、オブジェクト、カメラ関連の設定
	// ------------------------------------
	@ＶＲフォグ設定 d:VR_FOG:朝Ｎ 60000 -7500 70000 -7000 55000
	@カメラセット						// chara カメラとベースのカメラを設定
	@武器訓練ニキータ５面カメラ設定		// ステージ固有のカメラ設定がいる時はこのプロックで
	@ＶＲキャラ用ライト設置				// vr_common.hに定義。必ず最後に設定
#if d:DEBUG_CHARA
	@デバッグキャラセット
#endif

}

//初期マップの表示
command マップ表示 -show 武器訓練ニキータ５面


//###################################################################################
//									各proc設定
//###################################################################################



//###################################################################################
//									全マップ共通
//###################################################################################
	// ------------------------------------
	// 全マップ共通
	// ------------------------------------
	//------------------------------------------------------------
	// ＶＲウィンドウの設定と表示
	//------------------------------------------------------------
	proc 武器訓練ニキータ５面ＶＲウィンドウ設定 {
		#if d:DEBUG_PRINT
			print 'vr_window_set'
		#endif

		@ＶＲウィンドウ設定	[VRMSG_J:VRM_WPN_NKT_wp65a] [VRMSG_E:VRM_WPN_NKT_wp65a] [VRMSG_G:VRM_WPN_NKT_wp65a] \	// 日、英、独
							[VRMSG_F:VRM_WPN_NKT_wp65a] [VRMSG_I:VRM_WPN_NKT_wp65a] [VRMSG_S:VRM_WPN_NKT_wp65a] \	// 仏、伊、西
							[VRMSG_K:VRM_WPN_NKT_wp65a] \															// 韓
							p:ＶＲステージ開始時処理								// 終了プロック


		// ＶＲウィンドウを表示する
		mesg ＶＲウィンドウ ＶＲウィンドウ君 開く

		// スタート時とクリア時に使用するカットインカメラ
		chara カメラ カットインカメラ		-c 0 -l 0 -p 0

		// スタート時のカメラ(必要な場合)
		chara カメラ設定 カットインカメラ \
			-c 1 \	
			-p 0,20000,5000 -t 0,15750,-2900 \
			-r 320,2048,0 -f 9000 \
//			-p 0,65000,0 -t 0,56000,-100 \
//			-r 1015,2048,0 -f 9000 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1
	}

	//------------------------------------------------------------
	// ステージ開始時処理
	//------------------------------------------------------------
	proc ＶＲステージ開始時処理 {
		#if d:DEBUG_PRINT
			print 'game_start!!!!!'
		#endif

		// プレイヤーやパッドの制御等を行う a_stdproc.hで定義
		@全ミッション共通ステージ開始時処理

		// カメラワークスタート(必要な場合)
		// 全体図
		chara カメラ設定 カットインカメラ \
			-c 1 \	
			-p 0,40000,50000 -t 0,34250,43150 \
			-r 460,2048,0 -f 9000 \
//			-p -40,26000,24315 -t -40,19678,19029 \
//			-r 570,2048,0 -f 8241 \
			-a 200 \
			-i 4 4 d:START_CAMERA_CHANGE_TIME d:START_CAMERA_CHANGE_TIME \
			-s 1

		chara delay ディレイ \
			-time d:START_CAMERA_CHANGE_TIME \
			-exec {
				chara カメラ設定 カットインカメラ -s -1
			}
	}

	// ------------------------------------
	// クリア時の処理
	// ------------------------------------
	proc ＶＲクリア時処理 {
		#if d:DEBUG_PRINT
			print 'clear'
		#endif

//		@ニキータ５面破壊数カウント変数初期化

		// 強制モーションを発動
		@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_2 4358

		// クリア時にカメラアングルを変える
		chara カメラ設定 クリア時カメラ \
			-c 1 \
			-p 4600,1500,24850 -t 3000,1250,21100 \
			-r 50,2310,0 -f 9000 \
//			-p 0,62500,-1260 -t 0,58500,-1265 \
//			-r 1024,2048,0 -f 4000 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}

	//------------------------------------------------------------
	// ステージ開始直後処理
	//------------------------------------------------------------
	proc ゲーム開始直後処理 {
		// 初期配置標的の起動（command ＶＲステージスタート の起動直後に行う必要がある）
		@ＶＲ初期配置標的ニキータ５面設定
	}


	// ------------------------------------
	// パラメータ系の変更
	// ------------------------------------
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT
			print 'localvar_init'
		#endif

		//	的管理用各種フラグを初期化する
		$$b:標的セット数 = 0;
		$$i:標的フラグ = 0;

//		$$i:標的フラグＡ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NO_GHOST );
//		$$i:標的フラグＢ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST );
//		$$i:標的フラグＣ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    );
		$$i:標的フラグＤ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST                  | d:VR_TRG_WAIT );
//		$$i:標的フラグＥ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST | d:VR_TRG_WAIT );
		$$i:標的フラグＦ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    | d:VR_TRG_WAIT );
//		$$i:標的フラグＧ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST                  | d:VR_TRG_WAIT | d:VR_TRG_CIRCLE );
//		$$i:標的フラグＨ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST | d:VR_TRG_WAIT | d:VR_TRG_CIRCLE );
//		$$i:標的フラグＩ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    | d:VR_TRG_WAIT | d:VR_TRG_CIRCLE );
//		$$i:標的フラグＪ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST                  | d:VR_TRG_WAIT | d:VR_TRG_NO_APPEAR_EF );
//		$$i:標的フラグＫ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST | d:VR_TRG_WAIT | d:VR_TRG_NO_APPEAR_EF );
		$$i:標的フラグＬ = ( d:VR_TRG_ONE | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    | d:VR_TRG_WAIT | d:VR_TRG_NO_APPEAR_EF );
	}

	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT
			print 'status_set'
		#endif

		// 初期装備の設定
		$w:武器弾数Ｒ[ d:武器:ニキータ ] = 24
		$w:武器 = d:武器:ニキータ

		command ニキータタイマー設定 -time (60*45)

		// ニキータ防止
		command ミサイル移動範囲設定 -110000 -110000 -110000 110000 110000 110000
	}

	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif

		command プラグイン自動ジャンプ

	}

	// 台登り
	// ------------------------------------
	proc ジャンプ設定 {
		#if d:DEBUG_PRINT
			print 'jump_set'
		#endif

		trap ky001 d:PLAYER \
			-mask 入る \
			-exec {
				@ジャンプ発動 ky001 1000 10
			}
	}


//###################################################################################
//									 的兵
//###################################################################################

	// ------------------------------------
	// ニキータ５面
	// ------------------------------------

	// 破壊時処理
	// ------------------------------------
	proc ＶＲ標的破壊ニキータ５面処理 {

		// ライデンを選択
		if ( $s:選択プレイヤー == ライデン ) {

			if ( $1 == 移動的:01 ){
				command foreach -argc 1 -repeat 10 \
				-data { \
					// 的名
					{ 移動的:02 }{ 移動的:03 }{ 移動的:04 }{ 移動的:05 }{ 移動的:06 }\
					{ 移動的:07 }{ 移動的:08 }{ 移動的:09 }{ 移動的:10 }{ 移動的:11 }\
				} \
				-exec { \
					mesg ＶＲ的共通 $1 消滅
				}
			}

		// スネークを選択
		} else if ( $s:選択プレイヤー == スネーク ) {

			if ( $1 == 移動的:01 ){
				command foreach -argc 1 -repeat 14 \
				-data { \
					// 的名
					{ 移動的:02 }{ 移動的:03 }{ 移動的:04 }{ 移動的:05 }{ 移動的:06 }\
					{ 移動的:07 }{ 移動的:08 }{ 移動的:09 }{ 移動的:10 }{ 移動的:11 }\
					{ 移動的:12 }{ 移動的:13 }{ 移動的:14 }{ 移動的:15 }\
				} \
				-exec { \
					mesg ＶＲ的共通 $1 消滅
				}
			}

		// プリスキンを選択
		} else if ( $s:選択プレイヤー == プリスキン ) {

			if ( $1 == 移動的:01 ){
				command foreach -argc 1 -repeat 18 \
				-data { \
					// 的名
					{ 移動的:02 }{ 移動的:03 }{ 移動的:04 }{ 移動的:05 }{ 移動的:06 }\
					{ 移動的:07 }{ 移動的:08 }{ 移動的:09 }{ 移動的:10 }{ 移動的:11 }\
					{ 移動的:12 }{ 移動的:13 }{ 移動的:14 }{ 移動的:15 }{ 移動的:16 }\
					{ 移動的:17 }{ 移動的:18 }{ 移動的:19 }\
				} \
				-exec { \
					mesg ＶＲ的共通 $1 消滅
				}
			}

		// タキシードスネークを選択
		} else if ( $s:選択プレイヤー == タキシードスネーク ) {

			if ( $1 == 移動的:01 ){
				command foreach -argc 1 -repeat 16 \
				-data { \
					// 的名
					{ 移動的:02 }{ 移動的:03 }{ 移動的:04 }{ 移動的:05 }{ 移動的:06 }\
					{ 移動的:07 }{ 移動的:08 }{ 移動的:09 }{ 移動的:10 }{ 移動的:11 }\
					{ 移動的:12 }{ 移動的:13 }{ 移動的:14 }{ 移動的:15 }{ 移動的:16 }\
					{ 移動的:17 }\
				} \
				-exec { \
					mesg ＶＲ的共通 $1 消滅
				}
			}

		// 前作スネークを選択
		} else if ( $s:選択プレイヤー == 前作スネーク ) {

			if ( $1 == 移動的:01 ){
				command foreach -argc 1 -repeat 20 \
				-data { \
					// 的名
					{ 移動的:02 }{ 移動的:03 }{ 移動的:04 }{ 移動的:05 }{ 移動的:06 }\
					{ 移動的:07 }{ 移動的:08 }{ 移動的:09 }{ 移動的:10 }{ 移動的:11 }\
					{ 移動的:12 }{ 移動的:13 }{ 移動的:14 }{ 移動的:15 }{ 移動的:16 }\
					{ 移動的:17 }{ 移動的:18 }{ 移動的:19 }{ 移動的:20 }{ 移動的:21 }\
				} \
				-exec { \
					mesg ＶＲ的共通 $1 消滅
				}
			}

		}

	}

	// 敵兵や的の処理
	// ------------------------------------
	proc ＶＲ標的ニキータ５面設定 {

		// ライデンを選択
		if ( $s:選択プレイヤー == ライデン ) {

			// act 1 ----------
			chara ＶＲ移動的 移動的:01 \
				-flag $$i:標的フラグＤ \
				-route d:M_R:ライデンルート１ \
				-c ＶＲ標的破壊ニキータ５面処理

			command foreach -argc 2 -repeat 10 \
			-data { \
				// 的名,     ルート
				// act 2 ----------
				{ 移動的:02, d:M_R:ライデンルート２ }\
				{ 移動的:03, d:M_R:ライデンルート３ }\
				{ 移動的:04, d:M_R:ライデンルート４ }\
				{ 移動的:05, d:M_R:ライデンルート５ }\
				{ 移動的:06, d:M_R:ライデンルート６ }\
				{ 移動的:07, d:M_R:ライデンルート７ }\
				{ 移動的:08, d:M_R:ライデンルート８ }\
				{ 移動的:09, d:M_R:ライデンルート９ }\
				{ 移動的:10, d:M_R:ライデンルート１０ }\
				{ 移動的:11, d:M_R:ライデンルート１１ }\
			} \
			-exec { \
				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグＬ \
					-route $2 \
					-speed 100
			}

		// スネークを選択
		} else if ( $s:選択プレイヤー == スネーク ) {

			// act 1 ----------
			chara ＶＲ移動的 移動的:01 \
				-flag $$i:標的フラグＤ \
				-route d:M_R:スネークルート１２ \
				-c ＶＲ標的破壊ニキータ５面処理

			command foreach -argc 2 -repeat 14 \
			-data { \
				// 的名,     ルート
				// act 2 ----------
				{ 移動的:02, d:M_R:スネークルート１３ }\
				{ 移動的:03, d:M_R:スネークルート１４ }\
				{ 移動的:04, d:M_R:スネークルート１５ }\
				{ 移動的:05, d:M_R:スネークルート１６ }\
				{ 移動的:06, d:M_R:スネークルート１７ }\
				{ 移動的:07, d:M_R:スネークルート１８ }\
				{ 移動的:08, d:M_R:スネークルート１９ }\
				{ 移動的:09, d:M_R:スネークルート２０ }\
				{ 移動的:10, d:M_R:スネークルート２１ }\
				{ 移動的:11, d:M_R:スネークルート２２ }\
				{ 移動的:12, d:M_R:スネークルート２３ }\
				{ 移動的:13, d:M_R:スネークルート２４ }\
				{ 移動的:14, d:M_R:スネークルート２５ }\
				{ 移動的:15, d:M_R:スネークルート２６ }\
			} \
			-exec { \
				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグＬ \
					-route $2 \
					-speed 100
			}

		// プリスキンを選択
		} else if ( $s:選択プレイヤー == プリスキン ) {

			// act 1 ----------
			chara ＶＲ移動的 移動的:01 \
				-flag $$i:標的フラグＤ \
				-route d:M_R:プリスキンルート２７ \
				-c ＶＲ標的破壊ニキータ５面処理

			command foreach -argc 2 -repeat 18 \
			-data { \
				// 的名,     ルート
				// act 2 ----------
				{ 移動的:02, d:M_R:プリスキンルート２８ }\
				{ 移動的:03, d:M_R:プリスキンルート２９ }\
				{ 移動的:04, d:M_R:プリスキンルート３０ }\
				{ 移動的:05, d:M_R:プリスキンルート３１ }\
				{ 移動的:06, d:M_R:プリスキンルート３２ }\
				{ 移動的:07, d:M_R:プリスキンルート３３ }\
				{ 移動的:08, d:M_R:プリスキンルート３４ }\
				{ 移動的:09, d:M_R:プリスキンルート３５ }\
				{ 移動的:10, d:M_R:プリスキンルート３６ }\
				{ 移動的:11, d:M_R:プリスキンルート３７ }\
				{ 移動的:12, d:M_R:プリスキンルート３８ }\
				{ 移動的:13, d:M_R:プリスキンルート３９ }\
				{ 移動的:14, d:M_R:プリスキンルート４０ }\
				{ 移動的:15, d:M_R:プリスキンルート４１ }\
				{ 移動的:16, d:M_R:プリスキンルート４２ }\
				{ 移動的:17, d:M_R:プリスキンルート４３ }\
				{ 移動的:18, d:M_R:プリスキンルート４４ }\
				{ 移動的:19, d:M_R:プリスキンルート４５ }\
			} \
			-exec { \
				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグＬ \
					-route $2 \
					-speed 100
			}

		// タキシードスネークを選択
		} else if ( $s:選択プレイヤー == タキシードスネーク ) {

			// act 1 ----------
			chara ＶＲ移動的 移動的:01 \
				-flag $$i:標的フラグＤ \
				-route d:M_R:タキシードルート４６ \
				-c ＶＲ標的破壊ニキータ５面処理

			command foreach -argc 2 -repeat 16 \
			-data { \
				// 的名,     ルート
				// act 2 ----------
				{ 移動的:02, d:M_R:タキシードルート４７ }\
				{ 移動的:03, d:M_R:タキシードルート４８ }\
				{ 移動的:04, d:M_R:タキシードルート４９ }\
				{ 移動的:05, d:M_R:タキシードルート５０ }\
				{ 移動的:06, d:M_R:タキシードルート５１ }\
				{ 移動的:07, d:M_R:タキシードルート５２ }\
				{ 移動的:08, d:M_R:タキシードルート５３ }\
				{ 移動的:09, d:M_R:タキシードルート５４ }\
				{ 移動的:10, d:M_R:タキシードルート５５ }\
				{ 移動的:11, d:M_R:タキシードルート５６ }\
				{ 移動的:12, d:M_R:タキシードルート５７ }\
				{ 移動的:13, d:M_R:タキシードルート５８ }\
				{ 移動的:14, d:M_R:タキシードルート５９ }\
				{ 移動的:15, d:M_R:タキシードルート６０ }\
				{ 移動的:16, d:M_R:タキシードルート６１ }\
				{ 移動的:17, d:M_R:タキシードルート６２ }\
			} \
			-exec { \
				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグＬ \
					-route $2 \
					-speed 100
			}

		//	前作スネークを選択
		} else if ( $s:選択プレイヤー == 前作スネーク ) {

			// act 1 ----------
			chara ＶＲ移動的 移動的:01 \
				-flag $$i:標的フラグＤ \
				-route d:M_R:前作スネークルート６３ \
				-c ＶＲ標的破壊ニキータ５面処理

			command foreach -argc 2 -repeat 20 \
			-data { \
				// 的名,     ルート
				// act 2 ----------
				{ 移動的:02, d:M_R:前作スネークルート６４ }\
				{ 移動的:03, d:M_R:前作スネークルート６５ }\
				{ 移動的:04, d:M_R:前作スネークルート６６ }\
				{ 移動的:05, d:M_R:前作スネークルート６７ }\
				{ 移動的:06, d:M_R:前作スネークルート６８ }\
				{ 移動的:07, d:M_R:前作スネークルート６９ }\
				{ 移動的:08, d:M_R:前作スネークルート７０ }\
				{ 移動的:09, d:M_R:前作スネークルート７１ }\
				{ 移動的:10, d:M_R:前作スネークルート７２ }\
				{ 移動的:11, d:M_R:前作スネークルート７３ }\
				{ 移動的:12, d:M_R:前作スネークルート７４ }\
				{ 移動的:13, d:M_R:前作スネークルート７５ }\
				{ 移動的:14, d:M_R:前作スネークルート７６ }\
				{ 移動的:15, d:M_R:前作スネークルート７７ }\
				{ 移動的:16, d:M_R:前作スネークルート７８ }\
				{ 移動的:17, d:M_R:前作スネークルート７９ }\
				{ 移動的:18, d:M_R:前作スネークルート８０ }\
				{ 移動的:19, d:M_R:前作スネークルート８１ }\
				{ 移動的:20, d:M_R:前作スネークルート８２ }\
				{ 移動的:21, d:M_R:前作スネークルート８３ }\
			} \
			-exec { \
				chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグＬ \
					-route $2 \
					-speed 40
			}

		}

	}

	proc ＶＲ初期配置標的ニキータ５面設定 {
		// 共通標的 （主にライデン）
		mesg ＶＲ的共通 移動的:01 移動開始
		mesg ＶＲ的共通 移動的:02 移動開始
		mesg ＶＲ的共通 移動的:03 移動開始
		mesg ＶＲ的共通 移動的:04 移動開始
		mesg ＶＲ的共通 移動的:05 移動開始
		mesg ＶＲ的共通 移動的:06 移動開始
		mesg ＶＲ的共通 移動的:07 移動開始
		mesg ＶＲ的共通 移動的:08 移動開始
		mesg ＶＲ的共通 移動的:09 移動開始
		mesg ＶＲ的共通 移動的:10 移動開始
		mesg ＶＲ的共通 移動的:11 移動開始

		// 他キャラ選択時の追加標的s
		// スネーク
		if ( $s:選択プレイヤー == スネーク ) {
			mesg ＶＲ的共通 移動的:12 移動開始
			mesg ＶＲ的共通 移動的:13 移動開始
			mesg ＶＲ的共通 移動的:14 移動開始
			mesg ＶＲ的共通 移動的:15 移動開始
		// プリスキン
		} else if ( $s:選択プレイヤー == プリスキン ) {
			mesg ＶＲ的共通 移動的:12 移動開始
			mesg ＶＲ的共通 移動的:13 移動開始
			mesg ＶＲ的共通 移動的:14 移動開始
			mesg ＶＲ的共通 移動的:15 移動開始
			mesg ＶＲ的共通 移動的:16 移動開始
			mesg ＶＲ的共通 移動的:17 移動開始
			mesg ＶＲ的共通 移動的:18 移動開始
			mesg ＶＲ的共通 移動的:19 移動開始
		// タキシードスネーク
		} else if ( $s:選択プレイヤー == タキシードスネーク ) {
			mesg ＶＲ的共通 移動的:12 移動開始
			mesg ＶＲ的共通 移動的:13 移動開始
			mesg ＶＲ的共通 移動的:14 移動開始
			mesg ＶＲ的共通 移動的:15 移動開始
			mesg ＶＲ的共通 移動的:16 移動開始
			mesg ＶＲ的共通 移動的:17 移動開始
		// 前作スネーク
		} else if ( $s:選択プレイヤー == 前作スネーク ) {
			mesg ＶＲ的共通 移動的:12 移動開始
			mesg ＶＲ的共通 移動的:13 移動開始
			mesg ＶＲ的共通 移動的:14 移動開始
			mesg ＶＲ的共通 移動的:15 移動開始
			mesg ＶＲ的共通 移動的:16 移動開始
			mesg ＶＲ的共通 移動的:17 移動開始
			mesg ＶＲ的共通 移動的:18 移動開始
			mesg ＶＲ的共通 移動的:19 移動開始
			mesg ＶＲ的共通 移動的:20 移動開始
			mesg ＶＲ的共通 移動的:21 移動開始
		}
	}


