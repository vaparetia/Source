// ------------------------------------
// 各gclで必要なdefine
// ------------------------------------
// 共通プロック切り分け用
#define		STAGE_VR		1		// モード
#define		STAGE_WP65A		1		// ステージ名
#define		VR_WEAPON		1		// VRステージの呼び分け

#define		STAGE_START		1		// ステージ開始直後処理
#define		CUSTOM_TRG_SPEED	1	// 前作スネークのスピードカスタム機能を停止


// ------------------------------------
// 各種スイッチ用define
// ------------------------------------
// デバッグ関係
#ifdef	d:FIX_MODE
	#define		DEBUG_CHARA		1		// デバッグキャラ全体(FIX時は0)
#else
	#define		DEBUG_CHARA		1		// デバッグキャラ全体
#endif
#define		CHARA_CAMERA	0		// キャラ追従カメラ
#define		TARGET_CHARA	敵兵:01	// キャラ追従カメラのターゲット
#define		SCREENSHOT		1		// スクリーンショット
#define		USB_KEY			0		// USBキーボード


// ------------------------------------
// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME			ws65a
#define		KMS_NAME			ws65a
#define		TONBO_KMS_NAME		ws65a_tonbo
#define		LINE_KMS_NAME		ws65a_line

// キャラクター関係
#define		PLAYER		ライデン


// ------------------------------------
// ローカル変数
// ------------------------------------


// ------------------------------------
// 的ルート番号
// ------------------------------------
enum M_R {
	//	ニキータ５面用
//	共通ルート０ = 0,	// 欠番
	ライデンルート１ = 1,
	ライデンルート２, ライデンルート３, ライデンルート４, ライデンルート５, ライデンルート６,
	ライデンルート７, ライデンルート８, ライデンルート９, ライデンルート１０, ライデンルート１１,

	スネークルート１２, スネークルート１３, スネークルート１４, スネークルート１５, スネークルート１６,
	スネークルート１７, スネークルート１８, スネークルート１９, スネークルート２０, スネークルート２１,
	スネークルート２２, スネークルート２３, スネークルート２４, スネークルート２５, スネークルート２６,

	プリスキンルート２７, プリスキンルート２８, プリスキンルート２９, プリスキンルート３０, プリスキンルート３１,
	プリスキンルート３２, プリスキンルート３３, プリスキンルート３４, プリスキンルート３５, プリスキンルート３６,
	プリスキンルート３７, プリスキンルート３８, プリスキンルート３９, プリスキンルート４０, プリスキンルート４１,
	プリスキンルート４２, プリスキンルート４３, プリスキンルート４４, プリスキンルート４５,

	タキシードルート４６, タキシードルート４７, タキシードルート４８, タキシードルート４９, タキシードルート５０,
	タキシードルート５１, タキシードルート５２, タキシードルート５３, タキシードルート５４, タキシードルート５５,
	タキシードルート５６, タキシードルート５７, タキシードルート５８, タキシードルート５９, タキシードルート６０,
	タキシードルート６１, タキシードルート６２,

	前作スネークルート６３, 前作スネークルート６４, 前作スネークルート６５, 前作スネークルート６６, 前作スネークルート６７,
	前作スネークルート６８, 前作スネークルート６９, 前作スネークルート７０, 前作スネークルート７１, 前作スネークルート７２,
	前作スネークルート７３, 前作スネークルート７４, 前作スネークルート７５, 前作スネークルート７６, 前作スネークルート７７,
	前作スネークルート７８, 前作スネークルート７９, 前作スネークルート８０, 前作スネークルート８１, 前作スネークルート８２,
	前作スネークルート８３,
}


