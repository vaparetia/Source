		//これでも、昔は警官だった。敵も
		//プリスキンがあらかじめ始末して
		//くれている。
	}
	talk ピーター 標準 -m {
		 [PP_移動後Ｈ脚到着前３__f:ピーター_002]
		//ただし、走れると言っても、５年ぶりだ。
		//足がうまく運ばない。
	}
	talk ピーター 標準 -m {
		 [PP_移動後Ｈ脚到着前３__f:ピーター_002_1]
		//ただし、走れると言っても、５年ぶりだ。
		//足がうまく運ばない。
	}
}//v
}//d
