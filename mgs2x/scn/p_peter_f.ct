//爆弾設置場所が不審 h //e
//resource PP_爆弾設置場所不審
proc rp_PP_爆弾設置場所不審:02  {
vox t:vc200401 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PP_爆弾設置場所不審__f:ライデン_000]
		//爆弾の設置場所がおかしいという
		//話だが……。
	}
	talk ピーター 標準 -m {
		 [PP_爆弾設置場所不審__f:ピーター_001]
		//ああ。合理的でないんだ。
		//奴らしくない。
	}
	talk ライデン 標準 -m {
		 [PP_爆弾設置場所不審__f:ライデン_002]
		//なんでもわかっているような口振りだな。
	}
	talk ピーター 標準 -m {
		 [PP_爆弾設置場所不審__f:ピーター_003]
		//わかっているよ。
		//奴の考えていることはすべて、な……。
	}
}//v
}//d

//ピーターは何をしているのか？ h //e
//resource PP_ピーターは何をしてる
proc rp_PP_ピーターは何をしてる:02  {
vox t:vc200411 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PP_ピーターは何をしてる__f:ライデン_000]
		//スティルマン、あんたの方は大丈夫か？
	}
	talk ピーター 標準 -m {
		 [PP_ピーターは何をしてる__f:ピーター_001]
		//ああ、問題ない。
	}
	talk ライデン 標準 -m {
		 [PP_ピーターは何をしてる__f:ライデン_002]
		//退屈してるんじゃないか？
	}
	talk ピーター 標準 -m {
		 [PP_ピーターは何をしてる__f:ピーター_003]
		//そうでもない。あんたらの相手を
		//するのに忙しいし、こいつの調整が
		//やはり大変でな……。
	}
	talk ライデン 標準 -m {
		 [PP_ピーターは何をしてる__f:ライデン_004]
		//なんだって？
	}
@rp_かみあわない＿否１＿話聞けよ系デフォルト 100
@rp_うなづきデフォルト＿是
	talk ピーター 標準 -m {
		 [PP_ピーターは何をしてる__f:ピーター_005]
		//いや。なんでもない。
		//使わんにこしたことはないのだ……。
		//爆弾の方は頼むぞ。
	}
	talk ピーター 標準 -m {
		 [PP_ピーターは何をしてる__f:ピーター_005_1]
		//いや。なんでもない。
		//使わんにこしたことはないのだ……。
		//爆弾の方は頼むぞ。
	}
}//v
}//d







