//Ｃ脚 d //e
//厨房扉前 h //e
//resource PP_Ｃ脚厨房扉前１
proc rp_PP_Ｃ脚厨房扉前１:02  {
vox t:vc200011 {
@rp_うなづきデフォルト
	talk ピーター 標準 -m {
		 [PP_Ｃ脚厨房扉前１__f:ピーター_000]
		//私なら大丈夫だ。
		//爆弾の解体に向かってくれ。
	}
}//v
}//d

//しつこく扉を叩いた後 h //e
//resource PP_Ｃ脚厨房扉前扉叩いた後
proc rp_PP_Ｃ脚厨房扉前扉叩いた後:02  {
vox t:vc200021 {
@rp_うなづきデフォルト＿是
@rp_無茶指令＿否１＿お前がやれ系デフォルト 100
	talk ピーター 標準 -m {
		 [PP_Ｃ脚厨房扉前扉叩いた後__f:ピーター_000]
		//そこで何をしてるんだ？
		//さっさと爆弾を処理しに行ってくれ。
	}
}//v
}//d

//扉の外で危険モードである h //e
//resource PP_Ｃ脚厨房扉前危険モード１
