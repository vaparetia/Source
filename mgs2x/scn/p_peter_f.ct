//厨房で破壊の限りを尽くした後 h //e
//resource PP_Ｃ脚厨房扉前破壊
proc rp_PP_Ｃ脚厨房扉前破壊:02  {
vox t:vc200051 {
@rp_うなづきデフォルト
	talk ピーター 標準 -m {
		 [PP_Ｃ脚厨房扉前破壊__f:ピーター_000]
		//何をやってるんだ？
		//破壊衝動が強すぎる人間は爆弾処理には
		//向かないのだが……。大丈夫か？
	}
	talk ピーター 標準 -m {
		 [PP_Ｃ脚厨房扉前破壊__f:ピーター_000_1]
		//何をやってるんだ？
		//破壊衝動が強すぎる人間は爆弾処理には
		//向かないのだが……。大丈夫か？
	}
	talk ピーター 標準 -m {
		 [PP_Ｃ脚厨房扉前破壊__f:ピーター_000_2]
		//何をやってるんだ？
		//破壊衝動が強すぎる人間は爆弾処理には
		//向かないのだが……。大丈夫か？
	}
}//v
}//d


//★P014_16_G01ピーター遭遇１６ゲーム１終了＜フラク＜P015_01_R1爆弾解体最初の一つ１無線デモ１開始 d //e
//ノードにアクセスせよ h //e
//resource PP_ノードにアクセスしろ
proc rp_PP_ノードにアクセスしろ:02  {
vox t:vc200061 {
@rp_うなづきデフォルト
	talk ピーター 標準 -m {
		 [PP_ノードにアクセスしろ__f:ピーター_000]
		//あんたに渡したセンサーＡはレーダーに
		//爆弾の位置を表示するようにセットして
		//ある。
	}
	talk ピーター 標準 -m {
		 [PP_ノードにアクセスしろ__f:ピーター_001]
		//だからまずレーダーを使えるように
		//しなければ話にならない。
		//ノードを探すんだ。
	}
	talk ピーター 標準 -m {
		 [PP_ノードにアクセスしろ__f:ピーター_002]
		//ノードがどこにあるかはあんたの上官に
		//聞けばわかるだろう。
	}
}//v
}//d

//センサー説明１ h //e
//resource PP_センサー説明１
proc rp_PP_センサー説明１:02  {
vox t:vc200071 {
@rp_うなづきデフォルト
	talk ピーター 標準 -m {
		 [PP_センサー説明１__f:ピーター_000]
		//センサーＡを装備すれば、Ｃ４の匂いを
		//レーダー上に視覚化させることが出来る。
		//雲のように映るのがそれだ。
	}
	talk ピーター 標準 -m {
		 [PP_センサー説明１__f:ピーター_000_1]
		//センサーＡを装備すれば、Ｃ４の匂いを
		//レーダー上に視覚化させることが出来る。
		//雲のように映るのがそれだ。
	}
	talk ピーター 標準 -m {
		 [PP_センサー説明１__f:ピーター_001]
		//反応があるあたりに必ずＣ４が
		//仕掛けられている。よく探すんだ。
	}
}//v
}//d

//センサー説明２ h //e
//resource PP_センサー説明２
proc rp_PP_センサー説明２:02  {
vox t:vc200081 {
@rp_うなづきデフォルト
	talk ピーター 標準 -m {
		 [PP_センサー説明２__f:ピーター_000]
		//センサーＡは爆弾の位置を
		//特定できるものではない。
	}
	talk ピーター 標準 -m {
		 [PP_センサー説明２__f:ピーター_001]
		//残念ながら、エリアを特定できるのみだ。
		//エリアがわかれば、後は目で探す
		//しかない。
	}
	talk ピーター 標準 -m {
		 [PP_センサー説明２__f:ピーター_001_1]
		//残念ながら、エリアを特定できるのみだ。
		//エリアがわかれば、後は目で探す
		//しかない。
	}
}//v
}//d
//センサー説明３ h //e
//resource PP_センサー説明３
proc rp_PP_センサー説明３:02  {
vox t:vc200091 {
@rp_うなづきデフォルト
	talk ピーター 標準 -m {
		 [PP_センサー説明３__f:ピーター_000]
		//センサーの信憑性は高い。
		//誤作動はないと考えてくれていい。
	}
	talk ピーター 標準 -m {
		 [PP_センサー説明３__f:ピーター_001]
		//センサーに反応があったら、
		//必ずそのどこかにＣ４がある。
		//一見見当たらなくてもな。
	}
	talk ピーター 標準 -m {
		 [PP_センサー説明３__f:ピーター_002]
		//ファットマンの気持ちになって
		//考えてみれば、必ず見つかる。
		//よく探すんだ。
	}
}//v
}//d


//冷凍スプレー h //e
//使い方 t //e
//resource PP_冷凍スプレー使い方
proc rp_PP_冷凍スプレー使い方:02  {
vox t:vc200101 {
@rp_うなづきデフォルト
	talk ピーター 標準 -m {
		 [PP_冷凍スプレー使い方__f:ピーター_000]
		//冷却スプレーはいくら使っても内容物が
		//なくなることはない。そこは気にせず
		//使ってくれ。
	}
	talk ピーター 標準 -m {
		 [PP_冷凍スプレー使い方__f:ピーター_001]
		//ただしスプレーが届くは数メートルだ。
		//爆弾との距離を考えて使用するんだ。
	}
	talk ピーター 標準 -m {
		 [PP_冷凍スプレー使い方__f:ピーター_001_1]
		//ただしスプレーが届くは数メートルだ。
		//爆弾との距離を考えて使用するんだ。
	}
}//v
}//d

//注意。主観画面になる。 h //e
//resource PP_冷凍スプレー主観
proc rp_PP_冷凍スプレー主観:02  {
vox t:vc200111 {
@rp_うなづきデフォルト
	talk ピーター 標準 -m {
		 [PP_冷凍スプレー主観__f:ピーター_000]
		//冷却スプレーを装備すると主観画面に
		//なる。つまりスプレー噴射中は移動
		//出来ないということだ。気をつけてくれ。
	}
	talk ピーター 標準 -m {
		 [PP_冷凍スプレー主観__f:ピーター_000_1]
		//冷却スプレーを装備すると主観画面に
		//なる。つまりスプレー噴射中は移動
		//出来ないということだ。気をつけてくれ。
	}
}//v
}//d

//その他注意 h //e
//resource PP_冷凍スプレー注意
proc rp_PP_冷凍スプレー注意:02  {
vox t:vc200121 {
@rp_うなづきデフォルト
	talk ピーター 標準 -m {
		 [PP_冷凍スプレー注意__f:ピーター_000]
		//背の届かない場所、入り込めないような
		//狭い場所でも、手を伸ばせばスプレーの
		//噴射が届くはずだ。
	}
	talk ピーター 標準 -m {
		 [PP_冷凍スプレー注意__f:ピーター_000_1]
		//背の届かない場所、入り込めないような
		//狭い場所でも、手を伸ばせばスプレーの
		//噴射が届くはずだ。
	}
}//v
}//d


//爆弾 h //e
//resource PP_爆弾１
proc rp_PP_爆弾１:02  {
vox t:vc200131 {
@rp_うなづきデフォルト
	talk ピーター 標準 -m {
		 [PP_爆弾１__f:ピーター_000]
		//起爆装置についているランプの点滅が
		//止まれば、凍結完了、つまり爆弾処理が
		//終わったということだ。
	}
	talk ピーター 標準 -m {
		 [PP_爆弾１__f:ピーター_000_1]
		//起爆装置についているランプの点滅が
		//止まれば、凍結完了、つまり爆弾処理が
		//終わったということだ。
	}
	talk ピーター 標準 -m {
		 [PP_爆弾１__f:ピーター_001]
		//ランプの点滅が止まるまで
		//スプレーを吹き付けろ。
	}
}//v
}//d

