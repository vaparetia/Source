//爆弾評価 時間、ゲームオーバー回数から判定 h //e
//時間掛かり過ぎ h //e
//resource PP_爆弾評価＿時間超過
proc rp_PP_爆弾評価＿時間超過:02  {
vox t:vc200291 {
@rp_つっこまれ＿是１＿なんで知ってるんだ系デフォルト 100
@rp_無茶指令＿否１＿お前がやれ系デフォルト 100
	talk ピーター 標準 -m {
		 [PP_爆弾評価＿時間超過__f:ピーター_000]
		//時間が掛かりすぎだな。
		//もう少し、急いだ方がいい。
	}
@rp_うなづきデフォルト
	@rpd_プリスキン顔表示
	talk プリスキン 標準 -m {
		 [PP_爆弾評価＿時間超過__f:スネーク_001]
		//ライデン、時間がない。
		//こっちも手いっぱいだ。
		//お前の手伝いは出来そうにない。頼むぞ。
	}
	talk プリスキン 標準 -m {
		 [PP_爆弾評価＿時間超過__f:スネーク_001_1]
		//ライデン、時間がない。
		//こっちも手いっぱいだ。
		//お前の手伝いは出来そうにない。頼むぞ。
	}
}//v
}//d

