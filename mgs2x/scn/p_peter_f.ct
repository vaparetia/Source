		 [PP_無臭Ｃ４＿Ａ脚に行け２__f:ピーター_001]
		//いや、まだわからん。
		//こっちがまず試してみる。
		//とにかくＡ脚底部に急ぐんだ。
	}
	talk ピーター 標準 -m {
		 [PP_無臭Ｃ４＿Ａ脚に行け２__f:ピーター_001_1]
		//いや、まだわからん。
