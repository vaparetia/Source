//-------------------------------//e
//後回し会話 d //e
//-------------------------------//e
//えらそうな爆弾警句１ h //e
//resource PP_爆弾警句１
proc rp_PP_爆弾警句１:02  {
vox t:vc200721 {
@rp_うなづきデフォルト
	talk ピーター 標準 -m {
		 [PP_爆弾警句１__f:ピーター_000]
		//爆弾処理はすなわち恐怖との戦いだ。
		//恐怖から目をそらすな。
		//恐怖を認めてそれに立ち向かうんだ。
	}
	talk ピーター 標準 -m {
		 [PP_爆弾警句１__f:ピーター_000_1]
		//爆弾処理はすなわち恐怖との戦いだ。
		//恐怖から目をそらすな。
		//恐怖を認めてそれに立ち向かうんだ。
	}
}//v
}//d
//えらそうな爆弾警句２ h //e
//resource PP_爆弾警句２
proc rp_PP_爆弾警句２:02  {
vox t:vc200731 {
@rp_うなづきデフォルト
	talk ピーター 標準 -m {
		 [PP_爆弾警句２__f:ピーター_000]
		//爆弾に向き合う時忘れてはならないのは
		//慎重さだ。
	}
	talk ピーター 標準 -m {
		 [PP_爆弾警句２__f:ピーター_001]
		//細心に細心を重ねた慎重さ。
		//それは臆病とは違う。むしろその対極だ。
		//慎重にことを運ぶ勇気を持て。
	}
	talk ピーター 標準 -m {
		 [PP_爆弾警句２__f:ピーター_001_1]
		//細心に細心を重ねた慎重さ。
		//それは臆病とは違う。むしろその対極だ。
		//慎重にことを運ぶ勇気を持て。
	}
	talk ピーター 標準 -m {
		 [PP_爆弾警句２__f:ピーター_001_2]
		//細心に細心を重ねた慎重さ。
		//それは臆病とは違う。むしろその対極だ。
		//慎重にことを運ぶ勇気を持て。
	}
}//v
}//d

//えらそうな爆弾警句３ h //e
//resource PP_爆弾警句３
proc rp_PP_爆弾警句３:02  {
vox t:vc200741 {
@rp_うなづきデフォルト
	talk ピーター 標準 -m {
		 [PP_爆弾警句３__f:ピーター_000]
		//いいか、ライデン。絶対に焦るな。
		//焦りは爆弾処理の過程において最も
		//死に近い精神状態と言える。
	}
	talk ピーター 標準 -m {
		 [PP_爆弾警句３__f:ピーター_000_1]
		//いいか、ライデン。絶対に焦るな。
		//焦りは爆弾処理の過程において最も
		//死に近い精神状態と言える。
	}
	talk ピーター 標準 -m {
		 [PP_爆弾警句３__f:ピーター_000_2]
		//いいか、ライデン。絶対に焦るな。
		//焦りは爆弾処理の過程において最も
		//死に近い精神状態と言える。
	}
	talk ピーター 標準 -m {
		 [PP_爆弾警句３__f:ピーター_001]
		//いかなる状況下でも心の平静を失っては
		//いけない。いいな。
	}
}//v
}//d

//えらそうな爆弾警句４ h //e
//resource PP_爆弾警句４
proc rp_PP_爆弾警句４:02  {
vox t:vc200751 {
@rp_うなづきデフォルト
	talk ピーター 標準 -m {
		 [PP_爆弾警句４__f:ピーター_000]
		//爆弾解体は時間との勝負でもある。
		//わずかな迷いが時間を奪い、
		//人の命をも失わせる。
	}
	talk ピーター 標準 -m {
		 [PP_爆弾警句４__f:ピーター_000_1]
		//爆弾解体は時間との勝負でもある。
		//わずかな迷いが時間を奪い、
		//人の命をも失わせる。
	}
	talk ピーター 標準 -m {
		 [PP_爆弾警句４__f:ピーター_001]
		//無駄な行動はするな。
		//最速・最適の行動を心がけるんだ。
	}
}//v
}//d

//えらそうな爆弾警句５ h //e
//resource PP_爆弾警句５
proc rp_PP_爆弾警句５:02  {
vox t:vc200761 {
@rp_うなづきデフォルト
	talk ピーター 標準 -m {
		 [PP_爆弾警句５__f:ピーター_000]
		//爆弾と対峙した時頼れるのは自分だけだ。
		//他人を頼むな。その甘えは死神を
		//呼び込む。自分を信じるんだ。いいな。
	}
	talk ピーター 標準 -m {
		 [PP_爆弾警句５__f:ピーター_000_1]
		//爆弾と対峙した時頼れるのは自分だけだ。
		//他人を頼むな。その甘えは死神を
		//呼び込む。自分を信じるんだ。いいな。
	}
	talk ピーター 標準 -m {
		 [PP_爆弾警句５__f:ピーター_000_2]
		//爆弾と対峙した時頼れるのは自分だけだ。
		//他人を頼むな。その甘えは死神を
		//呼び込む。自分を信じるんだ。いいな。
	}
}//v
}//d

//オタコンのこと h //e
//resource PP_オタコン
proc rp_PP_オタコン:02  {
vox t:vc200771 {
@rp_うなづきデフォルト
	talk ピーター 標準 -m {
		 [PP_オタコン__f:ピーター_000]
		//ところで、ライデン、私と一緒に
		//下りてきた技術者を見たか？
	}
	talk ライデン 標準 -m {
		 [PP_オタコン__f:ライデン_001]
		//いや、見ていない。
	}
	talk ピーター 標準 -m {
		 [PP_オタコン__f:ピーター_002]
		//そうか……。
	}
	talk ライデン 標準 -m {
		 [PP_オタコン__f:ライデン_003]
		//なあ、スティルマン、
		//そいつは本当に……。
	}
	@rpd_プリスキン顔表示
	talk プリスキン 標準 -m {
		 [PP_オタコン__f:スネーク_004]
		//ライデン！
	}
	talk ライデン 標準 -m {
		 [PP_オタコン__f:ライデン_005]
		//？
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		 [PP_オタコン__f:スネーク_006]
		//今はＣ４を処理することが先決だ。
		//任務に戻れ。時間がないぞ。
	}
	talk ライデン 標準 -m {
		 [PP_オタコン__f:ライデン_007]
		//ああ、わかった……。
	}
}//v
}//d


//プリスキンについて h //e
//resource PP_プリスキン
proc rp_PP_プリスキン:02  {
vox t:vc200781 {
@rp_うなづきデフォルト
	talk ピーター 標準 -m {
		 [PP_プリスキン__f:ピーター_000]
		//プリスキンの方は特に問題ないようだ。
		//あんたも抜かるなよ。
	}
	talk ライデン 標準 -m {
		 [PP_プリスキン__f:ライデン_001]
		//……スティルマン、あんた、
		//プリスキンは本当にＳＥＡＬ１０の
		//隊員ではないと？
	}
	talk ピーター 標準 -m {
		 [PP_プリスキン__f:ピーター_002]
		//ああ。おそらくな……。
	}
	talk ライデン 標準 -m {
		 [PP_プリスキン__f:ライデン_003]
		//では一体、あいつは……？
	}
@rp_うなづきデフォルト
	talk ピーター 標準 -m {
		 [PP_プリスキン__f:ピーター_004]
		//わからん。
	}
	talk ライデン 標準 -m {
		 [PP_プリスキン__f:ライデン_005]
		//……。
	}
	talk ピーター 標準 -m {
		 [PP_プリスキン__f:ピーター_006]
		//だがわかることもある。
	}
	talk ライデン 標準 -m {
		 [PP_プリスキン__f:ライデン_007]
		//なんだ？
	}
	talk ピーター 標準 -m {
		 [PP_プリスキン__f:ピーター_008]
		//あの男は信用できる、ということだ。
		//あいつは何かを持っている。
	}
@rp_うなづきデフォルト
	talk ピーター 標準 -m {
		 [PP_プリスキン__f:ピーター_009]
		//強い男、信じるに足る男、
		//他人の期待に応えることが
		//出来る男だけが持つ何かを、な。
	}
	talk ライデン 標準 -m {
		 [PP_プリスキン__f:ライデン_010]
		//ああ……ああ、そうだな。
		//任務に戻る。
	}
}//v
}//d

//ピーターの過去 大佐から何も聞いていない場合 h //e
//resource PP_ピーター過去＿大佐話聞いていない
proc rp_PP_ピーター過去＿大佐話聞いていない:02  {
vox t:vc200791 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PP_ピーター過去＿大佐話聞いていない__f:ライデン_000]
		//スティルマン、あんた、爆弾処理に
		//かけては有名なんだってな？
	}
	talk ピーター 標準 -m {
		 [PP_ピーター過去＿大佐話聞いていない__f:ピーター_001]
		//引退した人間のことを悪くいう奴は
		//いない。それだけだ。
	}
	talk ライデン 標準 -m {
		 [PP_ピーター過去＿大佐話聞いていない__f:ライデン_002]
		//なぜ引退を？
	}
@rp_うなづきデフォルト
	talk ピーター 標準 -m {
		 [PP_ピーター過去＿大佐話聞いていない__f:ピーター_003]
		//……忘れたな。それに今は昔のことを
		//振り返るより、もっとさしせまった
		//問題を解決すべき時なんじゃないか？
	}
	talk ピーター 標準 -m {
		 [PP_ピーター過去＿大佐話聞いていない__f:ピーター_003_1]
		//……忘れたな。それに今は昔のことを
		//振り返るより、もっとさしせまった
		//問題を解決すべき時なんじゃないか？
	}
	talk ライデン 標準 -m {
		 [PP_ピーター過去＿大佐話聞いていない__f:ライデン_004]
		//……そうだったな。任務に戻る。
	}
}//v
}//d



//ファットマンの話 h //e
//resource PP_ファットマン１
proc rp_PP_ファットマン１:02  {
vox t:vc200801 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PP_ファットマン１__f:ライデン_000]
		//スティルマン、ファットマンのことを
		//教えてくれないか？
	}
	talk ピーター 標準 -m {
		 [PP_ファットマン１__f:ピーター_001]
		//ああ……。ファットマンは時計職人の
		//息子として生まれた。
	}
	talk ピーター 標準 -m {
		 [PP_ファットマン１__f:ピーター_002]
		//両親には構ってもらえず、友達もおらず、
		//よく父親の仕事場で独りで遊んでいた
		//らしい。
	}
	talk ピーター 標準 -m {
		 [PP_ファットマン１__f:ピーター_002_1]
		//両親には構ってもらえず、友達もおらず、
		//よく父親の仕事場で独りで遊んでいた
		//らしい。
	}
@rp_うなづきデフォルト
	talk ピーター 標準 -m {
		 [PP_ファットマン１__f:ピーター_003]
		//そのせいかどうかは知らんが
		//子供の頃から時計などの機械類に
		//過剰な思い入れを持っていたそうだ。
	}
	talk ピーター 標準 -m {
		 [PP_ファットマン１__f:ピーター_003_1]
		//そのせいかどうかは知らんが
		//子供の頃から時計などの機械類に
		//過剰な思い入れを持っていたそうだ。
	}
	talk ピーター 標準 -m {
		 [PP_ファットマン１__f:ピーター_004]
		//そして奴の人生を決定付けたのは
		//１０歳の時にインターネットで
		//手に入れたあるマニュアルだ。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk ピーター 標準 -m {
		 [PP_ファットマン１__f:ピーター_005]
		//奴はそれをもとに原爆を組み立てて
		//しまった。
	}
	talk ピーター 標準 -m {
		 [PP_ファットマン１__f:ピーター_006]
		//そのことから奴はファットマンと呼ばれ
		//るようになり、爆弾に携わる者の間では、
		//知らぬ者のない有名人になった。
	}
	talk ピーター 標準 -m {
		 [PP_ファットマン１__f:ピーター_006_1]
		//そのことから奴はファットマンと呼ばれ
		//るようになり、爆弾に携わる者の間では、
		//知らぬ者のない有名人になった。
	}
	talk ピーター 標準 -m {
		 [PP_ファットマン１__f:ピーター_007]
		//言わばヒーローだ。狭い世界のことでは
		//あるが１０代の少年にとっては強烈に
		//自尊心をくすぐられる経験だっただろう。
	}
	talk ピーター 標準 -m {
		 [PP_ファットマン１__f:ピーター_007_1]
		//言わばヒーローだ。狭い世界のことでは
		//あるが１０代の少年にとっては強烈に
		//自尊心をくすぐられる経験だっただろう。
	}
	talk ピーター 標準 -m {
		 [PP_ファットマン１__f:ピーター_007_2]
		//言わばヒーローだ。狭い世界のことでは
		//あるが１０代の少年にとっては強烈に
		//自尊心をくすぐられる経験だっただろう。
	}
}//v
}//d
//resource PP_ファットマン２
proc rp_PP_ファットマン２:02  {
vox t:vc200811 {
@rp_うなづきデフォルト＿是
@rp_邪道外道＿否２＿ひどい系デフォルト 100
	talk ピーター 標準 -m {
		 [PP_ファットマン２__f:ピーター_000]
		//だが他に何の特技もない奴だ。学校では
		//男子からは軽んじられ、女子からは
		//避けられていたらしい。
	}
@rp_うなづきデフォルト
	talk ピーター 標準 -m {
		 [PP_ファットマン２__f:ピーター_001]
		//だから奴はますます爆弾に
		//のめりこんでいった。
	}
	talk ピーター 標準 -m {
		 [PP_ファットマン２__f:ピーター_002]
		//自分の近くの現実に背を向け、
		//簡単に自分を認めてもらえる
		//世界へ向かった……。
	}
	talk ピーター 標準 -m {
		 [PP_ファットマン２__f:ピーター_002_1]
		//自分の近くの現実に背を向け、
		//簡単に自分を認めてもらえる
		//世界へ向かった……。
	}
	talk ピーター 標準 -m {
		 [PP_ファットマン２__f:ピーター_003]
		//まあ学校に銃を持ち込んだりするよりは
		//害がなかったと言えるだろうがな。
	}
	talk ピーター 標準 -m {
		 [PP_ファットマン２__f:ピーター_003_1]
		//まあ学校に銃を持ち込んだりするよりは
		//害がなかったと言えるだろうがな。
	}
}//v
}//d
//resource PP_ファットマン３
proc rp_PP_ファットマン３:02  {
vox t:vc200821 {
@rp_うなづきデフォルト
	talk ピーター 標準 -m {
		 [PP_ファットマン３__f:ピーター_000]
		//そして、奴はインディアンヘッドに
		//やってきた。私が教官を務めていた
		//海軍爆発物処理学校の実習施設だ。
	}
	talk ピーター 標準 -m {
		 [PP_ファットマン３__f:ピーター_000_1]
		//そして、奴はインディアンヘッドに
		//やってきた。私が教官を務めていた
		//海軍爆発物処理学校の実習施設だ。
	}
	talk ピーター 標準 -m {
		 [PP_ファットマン３__f:ピーター_001]
		//奴はあらゆるものを吸収した。
		//まるで爆弾に飢えているようだった。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk ピーター 標準 -m {
		 [PP_ファットマン３__f:ピーター_002]
		//インディアンヘッドは２０％近くが
		//落第する難関だ。その中で奴は
		//史上最優秀の成績を残した。
	}
	talk ピーター 標準 -m {
		 [PP_ファットマン３__f:ピーター_002_1]
		//インディアンヘッドは２０％近くが
		//落第する難関だ。その中で奴は
		//史上最優秀の成績を残した。
	}
	talk ピーター 標準 -m {
		 [PP_ファットマン３__f:ピーター_003]
		//インディアンヘッドを出た後、奴は
		//最も優れた爆弾処理チームと言われる
		//核緊急捜索チームに参加したのだが……
	}
	talk ピーター 標準 -m {
		 [PP_ファットマン３__f:ピーター_003_1]
		//インディアンヘッドを出た後、奴は
		//最も優れた爆弾処理チームと言われる
		//核緊急捜索チームに参加したのだが……
	}
	talk ピーター 標準 -m {
		 [PP_ファットマン３__f:ピーター_004]
		//そこで何かもめたらしい。
	}
	talk ライデン 標準 -m {
		 [PP_ファットマン３__f:ライデン_005]
		//一体何を？
	}
	talk ピーター 標準 -m {
		 [PP_ファットマン３__f:ピーター_006]
		//さあな。だが元々団体行動には向かない
		//奴ではあった。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk ピーター 標準 -m {
		 [PP_ファットマン３__f:ピーター_007]
		//ＮＥＳＴを追い出された奴は、既に
		//はみ出し者の集団という風評を
		//確立しつつあったデッドセルに拾われた。
	}
	talk ピーター 標準 -m {
		 [PP_ファットマン３__f:ピーター_007_1]
		//ＮＥＳＴを追い出された奴は、既に
		//はみ出し者の集団という風評を
		//確立しつつあったデッドセルに拾われた。
	}
	talk ピーター 標準 -m {
		 [PP_ファットマン３__f:ピーター_008]
		//その後デッドセルが行う抜打ち襲撃
		//演習でＮＥＳＴの元同僚達を徹底的に
		//叩きのめしたりもしたらしい。
	}
	talk ピーター 標準 -m {
		 [PP_ファットマン３__f:ピーター_008_1]
		//その後デッドセルが行う抜打ち襲撃
		//演習でＮＥＳＴの元同僚達を徹底的に
		//叩きのめしたりもしたらしい。
	}
}//v
}//d
//resource PP_ファットマン４
proc rp_PP_ファットマン４:02  {
vox t:vc200831 {
@rp_うなづきデフォルト
	talk ピーター 標準 -m {
		 [PP_ファットマン４__f:ピーター_000]
		//ファットマンは私が教えた中で最も
		//変わった男だったが、同時に最も優れた
		//男でもある。あなどるなよ、いいな。
	}
	talk ピーター 標準 -m {
		 [PP_ファットマン４__f:ピーター_000_1]
		//ファットマンは私が教えた中で最も
		//変わった男だったが、同時に最も優れた
		//男でもある。あなどるなよ、いいな。
	}
}//v
}//d


//無臭Ｃ４ h //e
//resource PP_移動後無臭Ｃ４
proc rp_PP_移動後無臭Ｃ４:02  {
vox t:vc200841 {
@rp_うなづきデフォルト
	talk ピーター 標準 -m {
		 [PP_移動後無臭Ｃ４__f:ピーター_000]
		//ライデンか？
		//こっちはまだＨ脚には着いていない。
	}
	talk ライデン 標準 -m {
		 [PP_移動後無臭Ｃ４__f:ライデン_001]
		//スティルマン……本当にセンサーに
		//反応しない爆弾があると思うか？
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk ピーター 標準 -m {
		 [PP_移動後無臭Ｃ４__f:ピーター_002]
		//確かに爆弾全体をシールすれば
		//『匂い』が外に漏れるのを防ぐことが
		//出来る。……私が教えなかった技術だ。
	}
	talk ピーター 標準 -m {
		 [PP_移動後無臭Ｃ４__f:ピーター_002_1]
		//確かに爆弾全体をシールすれば
		//『匂い』が外に漏れるのを防ぐことが
		//出来る。……私が教えなかった技術だ。
	}
	talk ライデン 標準 -m {
		 [PP_移動後無臭Ｃ４__f:ライデン_003]
		//だがサインを残すのは奴の美学じゃ
		//なかったのか。
	}
@rp_うなづきデフォルト＿是
@rp_キテレツさん＿否２＿意味不明系デフォルト 50
	talk ピーター 標準 -m {
		 [PP_移動後無臭Ｃ４__f:ピーター_004]
		//……今のあいつは私の知っている
		//あいつではないのかもしれんな……。
	}
	talk ライデン 標準 -m {
		 [PP_移動後無臭Ｃ４__f:ライデン_005]
		//なに？
	}
	talk ピーター 標準 -m {
		 [PP_移動後無臭Ｃ４__f:ピーター_006]
		//今のあいつは弱く脆く……
		//そして何より危険だ。
		//気をつけろ。いいな。
	}
}//v
}//d

//実は歩けたことの言い訳 h //e
//resource PP_歩ける言い訳１
proc rp_PP_歩ける言い訳１:02  {
vox t:vc200851 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PP_歩ける言い訳１__f:ライデン_000]
		//スティルマン、調子はどうだ？
	}
	talk ピーター 標準 -m {
		 [PP_歩ける言い訳１__f:ピーター_001]
		//ああ、大丈夫だ。
		//だが走ったのは久しぶりで……。
	}
	talk ライデン 標準 -m {
		 [PP_歩ける言い訳１__f:ライデン_002]
		//（皮肉）息が切れるのも久しぶりってわけか？
	}
@rp_キテレツさん＿否１＿なんだこいつ系デフォルト 100
	talk ピーター 標準 -m {
		 [PP_歩ける言い訳１__f:ピーター_003]
		//……ライデン……私を責めているのか？
	}
	talk ライデン 標準 -m {
		 [PP_歩ける言い訳１__f:ライデン_004]
		//いや、そんなつもりは。
	}
	talk ピーター 標準 -m {
		 [PP_歩ける言い訳１__f:ピーター_005]
		//いいや、責められるべきなのだ。
	}
	talk ライデン 標準 -m {
		 [PP_歩ける言い訳１__f:ライデン_006]
		//失敗は誰にでもある……。
	}
@rp_キテレツさん＿否２＿意味不明系デフォルト 50
	talk ピーター 標準 -m {
		 [PP_歩ける言い訳１__f:ピーター_007]
		//失敗の原因にもよる。
	}
	talk ライデン 標準 -m {
		 [PP_歩ける言い訳１__f:ライデン_008]
		//え？
	}
}//v
}//d
//resource PP_歩ける言い訳２
proc rp_PP_歩ける言い訳２:02  {
vox t:vc200861 {
	talk ピーター 標準 -m {
		 [PP_歩ける言い訳２__f:ピーター_000]
		//あの爆弾が爆発したのは……そして私が
		//助かったのは、私が恐怖に駆られ
		//逃げ出したからなのだ。
	}
	talk ピーター 標準 -m {
		 [PP_歩ける言い訳２__f:ピーター_000_1]
		//あの爆弾が爆発したのは……そして私が
		//助かったのは、私が恐怖に駆られ
		//逃げ出したからなのだ。
	}
@rp_うなづきデフォルト＿是
@rp_邪道外道＿否２＿ひどい系デフォルト 100
	talk ピーター 標準 -m {
		 [PP_歩ける言い訳２__f:ピーター_001]
		//そう……爆弾処理の途中で私は恐怖に
		//屈し……気がつくと爆弾に背を向けて
		//逃げ出していた……。
	}
	talk ピーター 標準 -m {
		 [PP_歩ける言い訳２__f:ピーター_001_1]
		//そう……爆弾処理の途中で私は恐怖に
		//屈し……気がつくと爆弾に背を向けて
		//逃げ出していた……。
	}
	talk ピーター 標準 -m {
		 [PP_歩ける言い訳２__f:ピーター_002]
		//しかもそのツケを払うことになったのは
		//私ではない。
	}
	talk ピーター 標準 -m {
		 [PP_歩ける言い訳２__f:ピーター_003]
		//爆発の衝撃から意識を取り戻した
		//私が最初に目にしたのは、瓦礫の
		//下敷きになった子供達の屍だった……。
	}
	talk ピーター 標準 -m {
		 [PP_歩ける言い訳２__f:ピーター_003_1]
		//爆発の衝撃から意識を取り戻した
		//私が最初に目にしたのは、瓦礫の
		//下敷きになった子供達の屍だった……。
	}
	talk ライデン 標準 -m {
		 [PP_歩ける言い訳２__f:ライデン_004]
		//スティルマン……。
	}
	talk ピーター 標準 -m {
		 [PP_歩ける言い訳２__f:ピーター_005]
		//だが、その時私が感じたのは
		//一体何だったと思う？
	}
@rp_うなづきデフォルト＿是
@rp_邪道外道＿否１＿サイテー系デフォルト 100
	talk ピーター 標準 -m {
		 [PP_歩ける言い訳２__f:ピーター_006]
		//安堵だ。
		//自分でなくてよかったと。
	}
	talk ライデン 標準 -m {
		 [PP_歩ける言い訳２__f:ライデン_007]
		//……。
	}
}//v
}//d
//resource PP_歩ける言い訳３
proc rp_PP_歩ける言い訳３:02  {
vox t:vc200871 {
@rp_うなづきデフォルト＿是
@rp_邪道外道＿否１＿サイテー系デフォルト 100
	talk ピーター 標準 -m {
		 [PP_歩ける言い訳３__f:ピーター_000]
		//それだけではない。
	}
	talk ピーター 標準 -m {
		 [PP_歩ける言い訳３__f:ピーター_001]
		//当時私は合衆国最高の爆弾処理技術者と
		//呼ばれていた。
	}
	talk ピーター 標準 -m {
		 [PP_歩ける言い訳３__f:ピーター_002]
		//妻も子もいない私にとってその名声は
		//全てだった。失いたくはなかった。
	}
	talk ピーター 標準 -m {
		 [PP_歩ける言い訳３__f:ピーター_002_1]
		//妻も子もいない私にとってその名声は
		//全てだった。失いたくはなかった。
	}
@rp_うなづきデフォルト＿是
	talk ピーター 標準 -m {
		 [PP_歩ける言い訳３__f:ピーター_003]
		//だから私は……足を失ったと嘘をつき……
		//負うべき責任を逃れ……被害者から目を
		//そらし……世間の同情を買い……。
	}
	talk ピーター 標準 -m {
		 [PP_歩ける言い訳３__f:ピーター_003_1]
		//だから私は……足を失ったと嘘をつき……
		//負うべき責任を逃れ……被害者から目を
		//そらし……世間の同情を買い……。
	}
	talk ライデン 標準 -m {
		 [PP_歩ける言い訳３__f:ライデン_004]
		//スティルマン。もういい。
		//今はファットマンの爆弾をどうするか、
		//それだけを考えよう。
	}
	talk ライデン 標準 -m {
		 [PP_歩ける言い訳３__f:ライデン_004_1]
		//スティルマン。もういい。
		//今はファットマンの爆弾をどうするか、
		//それだけを考えよう。
	}
	talk ピーター 標準 -m {
		 [PP_歩ける言い訳３__f:ピーター_005]
		//……ああ……。
	}
}//v
}//d




proc rp_PP_ばぐっち:02  {
	talk ピーター 標準 -m {
		 [PP_ばぐっち__f:ピーター_000]
	}
