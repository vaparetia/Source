//無臭Ｃ４について h //e
//resource PP_無臭Ｃ４調査中
proc rp_PP_無臭Ｃ４調査中:02  {
vox t:vc200691 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		 [PP_無臭Ｃ４調査中__f:ライデン_000]
		//スティルマン、そっちの方はどうだ？
	}
	talk ピーター 標準 -m {
		 [PP_無臭Ｃ４調査中__f:ピーター_001]
		//今調べている。単なる匂いに反応しない
		//爆弾とも思えんのだ。それ以外にも
		//何かが仕掛けられているはず……。
	}
	talk ピーター 標準 -m {
		 [PP_無臭Ｃ４調査中__f:ピーター_001_1]
		//今調べている。単なる匂いに反応しない
		//爆弾とも思えんのだ。それ以外にも
		//何かが仕掛けられているはず……。
	}
	talk ライデン 標準 -m {
		 [PP_無臭Ｃ４調査中__f:ライデン_002]
		//一体何か？
	}
	talk ピーター 標準 -m {
		 [PP_無臭Ｃ４調査中__f:ピーター_003]
		//まだわからん。
		//もう少し時間をくれ……。
	}
}//v
}//d



//★P024_01_R01爆弾解体センサーＢ入手１無線デモ１終了＜フラグ＜P025_01_R01爆弾解体昇降機下１無線デモ１開始 d //e
