	proc 左からハッチを開ける $:ハッチ名 $:向き $:Ｘ座標 $:Ｚ座標 {
		@rp_ハッチを開けた無線系処理
		mesg プレイヤー d:PLAYER motion \
			d:モーションリスト:non_ladder_hatch_open_l \
			$:向き \
			-1 \
			0 \
			(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_WEAPON) \
			$:Ｘ座標 $:Ｚ座標	//x,zの順（y省略）
		mesg プットモーションモデル $:ハッチ名 終了判定 d:モーションリスト:non_ladder_hatch_open_l_hatch	// 終了判定つき再生
	}
	proc 正面からハッチを開ける $:ハッチ名 $:向き $:Ｘ座標 $:Ｚ座標 {
		@rp_ハッチを開けた無線系処理
		mesg プレイヤー d:PLAYER motion \
			d:モーションリスト:non_ladder_hatch_open_c2r \
			$:向き \
			(($:向き+1024) & 4095) \
			0 \
			(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_WEAPON) \
			$:Ｘ座標 $:Ｚ座標	//x,zの順（y省略）
		mesg プットモーションモデル $:ハッチ名 終了判定 d:モーションリスト:non_ladder_hatch_open_c_hatch	// 終了判定つき再生
	}
	proc 右からハッチを開ける $:ハッチ名 $:向き $:Ｘ座標 $:Ｚ座標 {
		@rp_ハッチを開けた無線系処理
		mesg プレイヤー d:PLAYER motion \
			d:モーションリスト:non_ladder_hatch_open_r \
			$:向き \
			-1 \
			0 \
			(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_WEAPON) \
			$:Ｘ座標 $:Ｚ座標	//x,zの順（y省略）
		mesg プットモーションモデル $:ハッチ名 終了判定 d:モーションリスト:non_ladder_hatch_open_r_hatch	// 終了判定つき再生
	}

	//-----------------------------------------------------------------------------
	// ドア風設定 check
	proc ドア風設定 {
		#if d:DEBUG_PRINT
			print '*** Door Wind Set ***'
		#endif
		// ドア風
		chara ローカル風 隙間風 \
			-n 3 \
			-d	 -3500 -4000 -134750  -1000 3000 -132625     0 -512 2048 \	// シェル１シェル２連絡橋
				-11500 -4000 -112125  -8750 3000 -109125  1365 -512 2048 \	// ＣＤ連絡橋
				  8625 -4000 -112375  11375 3000 -109125  2731 -512 2048 	// ＤＥ連絡橋上下
		mesg ローカル風 隙間風 オフ
		// ドアの開け閉めに応じてON/OFFされる
	}

	// イベント設定
	// ------------------------------------
	proc 爆弾セット {
		#if d:DEBUG_PRINT
			print 'w18a_bomb_set'
		#endif
		// ----------------------------------------------
		if ( $f:w18a_爆弾処理完了1 == 0 ) {
			// 爆弾処理まだ
			// 爆弾(仮) 凍結したらフラグを立てる
			chara 解体Ｃ４ w18a匂い爆弾１ \
				-position -10000,-4250,-113100 \
				-rotate 3072 0 0 \
				-type 0 \
				-state 0 \
				-proc 爆弾解体後処理
			chara 爆弾検知領域 Bomb_Type_A1 \
				-trap bm000
		} else {
			// 爆弾処理済
			chara 解体Ｃ４ w18a匂い爆弾１ \
				-position -10000,-4250,-113100 \
				-rotate 3072 0 0 \
				-type 0 \
				-state 1 
		}
		// ハードレベル以上 ------------------------------
		if ($w:ゲーム設定 >= d:LEVEL_HARD) {
			if ( $f:w18a_爆弾処理完了2 == 0 ) {
				chara 解体Ｃ４ w18a匂い爆弾２ \
					-position 1625 -4250 -133050 \
					-rotate 3072 512 0 \
					-type 0 \
					-state 0 \
					-proc 爆弾解体後処理
				chara 爆弾検知領域 Bomb_Type_A2 \
					-trap bm001
			} else {
				chara 解体Ｃ４ w18a匂い爆弾２ \
					-position 1625 -4250 -133050 \
					-rotate 3072 512 0 \
					-type 0 \
					-state 1 
			}
		} else {
			// 全体マップの爆弾処理マークを消すために必要
			eval ( $f:w18a_爆弾処理完了2 = 1 ) ;
		}
		// エクストリームレベル以上 ------------------------
		if ($w:ゲーム設定 >= d:LEVEL_EXTREME) {
			if ( $f:w18a_爆弾処理完了3 == 0 ) {
				if (($w:プラント編クリア回数 % 2)==0) {
					chara 解体Ｃ４ w18a匂い爆弾３ \
						-position 9910 -50 -112300\
						-rotate 1024 0 0 \
						-type 0 \
						-state 0 \
						-proc 爆弾解体後処理
					chara 爆弾検知領域 Bomb_Type_A3 \
						-trap bm002
				} else {
					chara 解体Ｃ４ w18a匂い爆弾３ \
						-position 1016 450 -133750\
						-rotate 1024 2048 0 \
						-type 0 \
						-state 0 \
						-proc 爆弾解体後処理
					chara 爆弾検知領域 Bomb_Type_A3 \
						-trap bm003
				}
			} else {
				if (($w:プラント編クリア回数 % 2)==0) {
					chara 解体Ｃ４ w18a匂い爆弾３ \
						-position 9910 -100 -112300\
						-rotate 1024 0 0 \
						-type 0 \
						-state 1 
				} else {
					chara 解体Ｃ４ w18a匂い爆弾３ \
						-position 1016 450 -133750\
						-rotate 1024 2048 0 \
						-type 0 \
						-state 1 
				}
			}
		} else {
			// 全体マップの爆弾処理マークを消すために必要
			eval ( $f:w18a_爆弾処理完了3 = 1 ) ;
		}
	}


	proc w18a死体遺棄設定 {
		#if d:DEBUG_PRINT
			print 'w18a死体遺棄設定'
		#endif
				chara プットモーションモデル w18a1F東 \
					-pos 10325,-4000,-119000 \		//$v:配置座標
					-dir 0 \				//$i:方向
					-kms w18a_crps_saku \			//$s:KMSモデル名
					-mar corpse_w18a \			//$s:モーションファイル名
					-number 3 \
					-status	0x28 				//$w:ステータス

				chara プットモーションモデル w18a1F西 \
					-pos -10325,-4000,-119000 \		//$v:配置座標
					-dir 0 \				//$i:方向
					-kms w18a_crps_saku \			//$s:KMSモデル名
					-mar corpse_w18a \			//$s:モーションファイル名
					-number 5 \
					-status	0x28 				//$w:ステータス

				chara プットモーションモデル w18a2F中央 \
					-pos 5500,-1000,-131075 \		//$v:配置座標
					-dir 1024 \				//$i:方向
					-kms w18a_crps_saku \			//$s:KMSモデル名
					-mar corpse_w18a \			//$s:モーションファイル名
					-number 3 \
					-status	0x28 				//$w:ステータス

				/*ステータスフラグ設定は以下のとおり
					(0x01) モーションの水平移動量を無視
					(0x02) 重力処理無し
					(0x04) 壁アタリ判定無し
					(0x08) メッセージ受信までモーション停止
					(0x20) モーション切り替え時に補完なし
				*/

		//1F東死体遺棄
		trap ev009 d:PLAYER \
			-mask 入る \
			-state d:TRP_STATE_ENEMY_PULL \
			-exec {
				if (`@死体捨てチェック`) {
					command 無線設定 -reset
					@1F東死体遺棄カメラＯＮ
					command	強制モーション終了プロック -proc 1F東死体遺棄カメラＯＦＦ
					mesg プレイヤー d:PLAYER motion \
						d:モーションリスト:non_carry_body_throw1 \
						1024 \
						-1 \
						0 \
						(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_WEAPON) \
						11000 -120000 //x,z,yの順

					mesg コマンダー 敵兵セット 引き釣られ兵消す
					command ゲット捕まえられ兵の名前 $i:敵兵モデル名

					//捨てられ敵兵
					/*指定された順にモーション再生後プロック呼んで消滅*/
					chara デモ人形 死体 \
						-pos (11000 + 430 ),-4000,( -120000 - 69 ) \
						-dir 1024 \
						-code $i:敵兵モデル名 \
						-mar corpse_w18a \
						-list 0 \			//$i:再生順番 ... \ /*最大8個*/
						-end 死体消し	//$p:終了時プロック
					command パッド操作 -release
					mesg レーダー レーダー off
					mesg シネマスクリーン シネマ フェードアウト 0		//ゼロでデフォルト値
					mesg プットモーションモデル w18a1F東 終了判定  3	// 柵の終了判定付き再生
				}
			}
		//1F西死体遺棄
		trap ev008 d:PLAYER \
			-mask 入る \
			-state d:TRP_STATE_ENEMY_PULL \
			-exec {
				if (`@死体捨てチェック`) {
					command 無線設定 -reset
					@1F西死体遺棄カメラＯＮ
					command	強制モーション終了プロック -proc 1F西死体遺棄カメラＯＦＦ
					mesg プレイヤー d:PLAYER motion \
						d:モーションリスト:non_carry_body_throw1 \
						3072 \
						-1 \
						0 \
						(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_WEAPON) \
						-11000 -120000 //x,z,yの順
					mesg コマンダー 敵兵セット 引き釣られ兵消す
					command ゲット捕まえられ兵の名前 $i:敵兵モデル名

					//捨てられ敵兵
					/*指定された順にモーション再生後プロック呼んで消滅*/
					chara デモ人形 死体 \
						-pos (-11000 - 430 ),-4000,( -120000 + 69 ) \
						-dir 3072 \
						-code $i:敵兵モデル名 \
						-mar corpse_w18a \
						-list 0 \			//$i:再生順番 ... \ /*最大8個*/
						-end 死体消し	//$p:終了時プロック
					command パッド操作 -release
					mesg レーダー レーダー off
					mesg シネマスクリーン シネマ フェードアウト 0		//ゼロでデフォルト値
					mesg プットモーションモデル w18a1F西 終了判定  5	// 柵の終了判定付き再生
				}
			}
		//2F中央死体遺棄
		trap ev010 d:PLAYER \
			-mask 入る \
			-state d:TRP_STATE_ENEMY_PULL \
			-exec {
				if (`@死体捨てチェック`) {
					command 無線設定 -reset
					@2F中央死体遺棄カメラＯＮ
					command	強制モーション終了プロック -proc 2F中央死体遺棄カメラＯＦＦ
					mesg プレイヤー d:PLAYER motion \
						d:モーションリスト:non_carry_body_throw1 \
						2048 \
						-1 \
						0 \
						(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_WEAPON) \
						4750 -132000 //x,z,yの順
					mesg コマンダー 敵兵セット 引き釣られ兵消す
					command ゲット捕まえられ兵の名前 $i:敵兵モデル名

					//捨てられ敵兵
					/*指定された順にモーション再生後プロック呼んで消滅*/
					chara デモ人形 死体 \
						-pos ( 4750 + 69 ),-1000,( -132000 - 430 ) \
						-dir 2048 \
						-code $i:敵兵モデル名 \
						-mar corpse_w18a \
						-list 0 \			//$i:再生順番 ... \ /*最大8個*/
						-end 死体消し	//$p:終了時プロック

					command パッド操作 -release
					mesg レーダー レーダー off
					mesg シネマスクリーン シネマ フェードアウト 0		//ゼロでデフォルト値
					mesg プットモーションモデル w18a2F中央 終了判定  3	// 柵の終了判定付き再生
				}
			}
	}

	proc 1F東死体遺棄カメラＯＮ   {
		chara カメラ設定 ビヨンドカメラ \
			-c 1 \
			-p 7371,580,-118204 -t 12125,-7962,-121531 \
			-r 635,1422,0 -f 10327 \
			-a 180 \
			-i 0 0 0 0 \
			-s 1
	}

	proc 1F西死体遺棄カメラＯＮ   {
		chara カメラ設定 ビヨンドカメラ \
			-c 1 \
			-p -8592,446,-117833 -t -9373,-2072,-119273 \
			-r 648,2372,0 -f 3004 \
			-a 152 \
			-i 0 0 0 0 \
			-s 1
	}

	proc 2F中央死体遺棄カメラＯＮ {
		chara カメラ設定 ビヨンドカメラ \
			-c 1 \
			-p 5940,3911,-129419 -t 4688,671,-129871 \
			-r 770,2846,0 -f 3503 \
			-a 180 \
			-i 0 0 0 0 \
			-s 1
	}

	proc 死体消し{
		chara カメラ設定 ビヨンドカメラ -s -1
	}

	proc 1F東死体遺棄カメラＯＦＦ{
		chara カメラ設定 ビヨンドカメラ -s -1
		mesg プットモーションモデル w18a1F東 終了判定  2	// 柵の終了判定付き再生
		chara delay ディレイ -time 1 -exec {
			mesg レーダー レーダー on
			mesg シネマスクリーン シネマ フェードイン 0		//ゼロでデフォルト値
			command パッド操作 -cancel
		}
	}
	proc 1F西死体遺棄カメラＯＦＦ{
		chara カメラ設定 ビヨンドカメラ -s -1
		mesg プットモーションモデル w18a1F西 終了判定  4	// 柵の終了判定付き再生
		chara delay ディレイ -time 1 -exec {
			mesg レーダー レーダー on
			mesg シネマスクリーン シネマ フェードイン 0		//ゼロでデフォルト値
			command パッド操作 -cancel
		}
	}
	proc 2F中央死体遺棄カメラＯＦＦ{
		chara カメラ設定 ビヨンドカメラ -s -1
		mesg プットモーションモデル w18a2F中央 終了判定  2	// 柵の終了判定付き再生
		chara delay ディレイ -time 1 -exec {
			mesg レーダー レーダー on
			mesg シネマスクリーン シネマ フェードイン 0		//ゼロでデフォルト値
			command パッド操作 -cancel
		}
	}

