// マップ設定
// ------------------------------------
chara マップ Ｄ脚 \
	-k d:KMS_NAME0 \
	-k d:LOADMAP_NAME \
	-h d:HZX_NAME,0 -l d:LT2_NAME_W18A

command マップ設定 Ｄ脚 -set {
	@サウンド設定	// データは最初に呼ぶ
	@メニュー設定
	@常駐キャラ設定
	@陸上フォグ設定
	@ローカル変数初期化
	@プラグイン設定
	@プレイヤー設定
	@コマンダー設定
	@ＢＧＭ設定		// プレイヤー→敵兵→BGMの順で呼ぶ
	@w18a天井設置
	@ドア設置
	@ロード設定
	@ノード端末設定 1024
	@アイテム設置
	@エフェクト設定
	@ドア風設定
	@水面設定
	@電灯虫設定
	@壊れライト設定
	@カメラセット
	@Ｄ脚カメラ設定
	@Ｄ脚ハッチ設定
	@Ｄ脚ビヨンド設定
	//@Ｄ脚覗き込みカメラ設定		// 監督指示で削除
	@主観禁止壁設定
	@キャラ用ライト設置		// マップ設定の最後に呼ぶ
	@爆弾セット
	@プラント編全体マップ設定 d:Ｄ脚マップ	// stdproc.hで定義
	@爆弾タイマー設置
	@w18a死体遺棄設定
	@エルード状態監視 ;
	@デバッグキャラセット
}

// 無線用include ※位置は動かさないこと
#include "w18a_cdc.ch"
#include "p_force_cdc.ch"
// 全てのセットが終わったところでフェードイン
//初期マップの表示
if( $s:登場ポイント == sp_w17a_w18a_0 ) {
	// ＣＤ連絡橋から
	// 全てのセットが終わったところでフェードイン
	@ＣＤ連絡橋ロード時カメラ設定 ;
	@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:SL_DOOR_TYPE Ｃ脚方面ドア 2000 d:DEFAULT_M_TYPE d:wn_Ｄ脚第一沈殿池
} else if( $s:登場ポイント == sp_w19a_w18a_0 ) {
	// ＤＥ連絡橋から
	// 全てのセットが終わったところでフェードイン
 	@ＤＥ連絡橋上ロード時カメラ設定 ;
 	@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:SL_DOOR_TYPE Ｅ脚方面ドア上 2250 d:DEFAULT_M_TYPE d:wn_Ｄ脚第一沈殿池
} else if( $s:登場ポイント == sp_w19a_w18a_1 ) {
	// ＤＥ連絡橋から
	// 全てのセットが終わったところでフェードイン
	@ＤＥ連絡橋下ロード時カメラ設定 ;
	@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:SL_DOOR_TYPE Ｅ脚方面ドア下 2500 d:DEFAULT_M_TYPE d:wn_Ｄ脚第一沈殿池
} else if( $s:登場ポイント == sp_w25a_w18a_0 ) {
	// ＤＥ連絡橋から
	// 全てのセットが終わったところでフェードイン
	@ＤＧ連絡橋ロード時カメラ設定 ;
	@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:SL_DOOR_TYPE Ｇ脚方面ドア 2500 d:DEFAULT_M_TYPE d:wn_Ｄ脚第一沈殿池
}
command マップ表示 -show Ｄ脚

// 各proc設定
//-------------------------------------------------------------------------------------
// 全マップ共通
	// サウンド
	// ------------------------------------
	proc サウンド設定 {
		#if d:DEBUG_PRINT 
			print 'sound_set'
		#endif
#ifndef d:ENGLISH
	// 日本語環境
		if(    (   ($w:p_story >= d:ST:P024_01_R01爆弾解体センサーＢ入手１無線デモ１終了) \
				&& ($w:p_story <  d:ST:P026_01_R01爆弾解体終了１無線デモ１開始)) \
			|| (   ($w:p_story >= d:ST:P031_01_P01フォーチュン戦終了１ポリゴンデモ１終了) \
				&& ($w:p_story <  d:ST:P032_01_P01ファットマン登場１ポリゴンデモ１開始)) ) {
			chara サウンドマネージャー ＳＤマネ -pak 1
		} else {
			chara サウンドマネージャー ＳＤマネ -pak 0
		}
#else
	// 英語環境
		if(    (   ($w:p_story >= d:ST:P024_01_R01爆弾解体センサーＢ入手１無線デモ１終了) \
				&& ($w:p_story <  d:ST:P026_01_R01爆弾解体終了１無線デモ１開始)) \
			|| (   ($w:p_story >= d:ST:P031_01_P01フォーチュン戦終了１ポリゴンデモ１終了) \
				&& ($w:p_story <  d:ST:P032_01_P01ファットマン登場１ポリゴンデモ１開始)) ) {
			chara サウンドマネージャー ＳＤマネ -pak 1
		} else {
			if ( $w:p_story < d:ST:P041_02_R01エイムズ死亡後２無線デモ１終了 ) {
				chara サウンドマネージャー ＳＤマネ -pak 0
			} else {
				// ハイテク兵以降はこちら
				chara サウンドマネージャー ＳＤマネ -pak 2
			}
		}
#endif
		@サウンド効果音設定
		@弾痕跳弾設定
	}

	// 弾痕跳弾関係の設定
	// ------------------------------------
	proc 弾痕跳弾設定 {
		#if d:DEBUG_PRINT 
			print 'recoil_set'
		#endif

		command 弾痕ノーマル -n 0	// 通常
		command 弾痕ノーマル -n 1	// 階段、通常
		command 弾痕ノーマル -n 2	// 鉄板
		command 弾痕ノーマル -n 3	// 鉄筋
		command 弾痕ノーマル -n 4	// ダンボール
		command 弾痕ノーマル -n 5	// 木箱
		command 弾痕ノーマル -n 6	// パイプ中
		command 弾痕ノーマル -n 7	// パイプ大

		command 跳弾ノーマル -n 0
		command 跳弾ノーマル -n 1
		command 跳弾ノーマル -n 2
		command 跳弾ノーマル -n 3
		command 跳弾ノーマル -n 5
		command 跳弾水蒸気中 -n 6
		command 跳弾水蒸気大 -n 7
	}

	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT 
			print 'localvar_init'
		#endif
		eval( $f:w18a落下死しました = 0 );
	}

	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif

		#if d:JP_MOTION
			command プラグイン自動ジャンプ
		#endif
		command プラグイン落下
	}

	// プレイヤー 
	// ------------------------------------
	proc プレイヤー設定 {
		#if d:DEBUG_PRINT
			print 'player_set'
		#endif

		#if d:RAIDEN
			chara プレイヤー d:PLAYER \
				-p $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,$i:プレイヤー初期Ｚ位置 \
				-d 0,$i:プレイヤー初期方向,0 \
				-s 0 \
				-m rai_def -a raiden -o rai_w18a 
			// 髪の毛
			@ライデン髪の毛設定 d:NORMAL_HAIR
			@プレイヤーＬＯＤ設定 d:C_DISTANCE_TYPE 4000

		#else if d:SNAKE
			chara プレイヤー d:PLAYER \
				-p $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,$i:プレイヤー初期Ｚ位置 \
				-d 0,$i:プレイヤー初期方向,0 \
				-s 0 \
				-m sna_def -a snake -o rai_common

				//バンダナ
				chara ロープモデル３ バンダナ１ \
					-n sna_bdn1 \
					-d 1 \
					-y スネーク \
					-z 12 \
					-x 0,60,-90 \
					-m 12 \
					-p 250 \
					-k 350 \
					-o 110 \
					-f 1

				chara ロープモデル３ バンダナ２ \
					-n sna_bdn2 \
					-d 1 \
					-y スネーク \
					-z 12 \
					-x 0,50,-90 \
					-m 22 \
					-p 250 \
					-k 350 \
					-o 110 \
					-f 1
		#endif
	}

	// 敵兵 
	// ------------------------------------
	proc 警備兵０ {
		#if d:DEBUG_PRINT
			print 'watcher_set'
		#endif

		// Ｄ脚からの配置
		if ($w:ゲーム設定  >= d:LEVEL_NORMAL ) {
			chara 警備兵 敵兵:01 \
				-r 0 -n 0 -d -9500,0,-127000 Ｄ脚 \
				-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
				-l $w:敵標準体力 -h $w:敵標準聴力 -f $w:敵標準気絶 \
				-j ドッグタグ_敵兵 [dogtag:dummy] \
					[dogtag:dummy] [dogtag:plt_w18a_guard_no_01] \
					[dogtag:plt_w18a_guard_ha_01] [dogtag:plt_w18a_guard_vh_01] \
				-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
				-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
				-s ( d:ENE_STATUS_GUNLIGHT )
		}
		chara 警備兵 敵兵:02 \
			-r 1 -n 0 -d 0,0,-123250 Ｄ脚 \
			-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
			-l $w:敵標準体力 -h $w:敵標準聴力 -f $w:敵標準気絶 \
			-j ドッグタグ_敵兵 [dogtag:plt_w18a_guard_ve_02] \
				[dogtag:plt_w18a_guard_ea_02] [dogtag:plt_w18a_guard_no_02] \
				[dogtag:plt_w18a_guard_ha_02] [dogtag:plt_w18a_guard_vh_02] \
			-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
			-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
			-s ( d:ENE_STATUS_GUNLIGHT )
		chara 警備兵 敵兵:03 \		// 下層部の巡回兵
			-r 4 -n 5 -d 9500,0,-127000 Ｄ脚 \
			-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
			-l $w:敵標準体力 -h $w:敵標準聴力 -f $w:敵標準気絶 \
			-j ドッグタグ_敵兵 [dogtag:plt_w18a_guard_ve_03] \
				[dogtag:plt_w18a_guard_ea_03] [dogtag:plt_w18a_guard_no_03] \
				[dogtag:plt_w18a_guard_ha_03] [dogtag:plt_w18a_guard_vh_03] \
			-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
			-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
			-s ( d:ENE_STATUS_GUNLIGHT | d:ENE_STATUS_REPORT )	// 定時連絡兵
		if ($w:ゲーム設定  >= d:LEVEL_HARD ) {
			chara 警備兵 敵兵:04 \
				-r 2 -n 0 -d 12250,-4000,-118625 Ｄ脚 \
				-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
				-l $w:敵標準体力 -h $w:敵標準聴力 -f $w:敵標準気絶 \
				-j ドッグタグ_敵兵 [dogtag:dummy] \
					[dogtag:dummy] [dogtag:dummy] \
					[dogtag:plt_w18a_guard_ha_04] [dogtag:plt_w18a_guard_vh_04] \
				-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
				-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
				-s ( d:ENE_STATUS_GUNLIGHT )
		}
	}


	proc 攻撃兵０ {
		#if d:DEBUG_PRINT
			print 'attacker_set'
		#endif

		if ( $s:登場ポイント == sp_w17a_w18a_0  ) {
			eval( $b:攻撃兵待機ルート = 5 ) ;
		} else if ( $s:登場ポイント == sp_w19a_w18a_0  ) {
			eval( $b:攻撃兵待機ルート = 3 ) ;
		} else if ( $s:登場ポイント == sp_w19a_w18a_1  ) {
			eval( $b:攻撃兵待機ルート = 6 ) ;
		} else {
			eval( $b:攻撃兵待機ルート = 3 ) ;
		}
		
		if ( $w:p_story < d:ST:P041_02_R01エイムズ死亡後２無線デモ１終了 ) {
			chara アタッカー 敵兵:61 -r $b:攻撃兵待機ルート \
					-h $w:敵標準聴力 \
					-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
					-l $w:敵標準体力 \
					-f $w:敵標準気絶 \
					-q レーション_敵兵 30 \
					-s ( d:ENE_STATUS_GUNLIGHT ) \
					-e d:ENE_EQUIP_TYPE_LIGHT_SHIELD
			if ($w:ゲーム設定  < d:LEVEL_HARD ) {
				chara アタッカー 敵兵:62 -r $b:攻撃兵待機ルート \
						-h $w:敵標準聴力 \
						-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
						-l $w:敵標準体力 \
						-f $w:敵標準気絶 \
						-q レーション_敵兵 30 \
						-s ( d:ENE_STATUS_GUNLIGHT ) \
						-e d:ENE_EQUIP_TYPE_NORMAL
			}
			chara アタッカー 敵兵:63 -r $b:攻撃兵待機ルート \
					-h $w:敵標準聴力 \
					-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
					-l $w:敵標準体力 \
					-f $w:敵標準気絶 \
					-q レーション_敵兵 30 \
					-s ( d:ENE_STATUS_GUNLIGHT ) \
					-e d:ENE_EQUIP_TYPE_LIGHT_SHIELD
			if ( $w:ゲーム設定 >= d:LEVEL_EXTREME ) {
				// エクストリームのみサポート兵化攻撃兵登場
				chara アタッカー 敵兵:31 \
					-r $b:攻撃兵待機ルート \				//	$b:初期ルート \
					-h $w:敵標準聴力 \
					-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
					-l $w:敵標準体力 \
					-f $w:敵標準気絶 \
					-q レーション_敵兵 30 \
					-s (d:ENE_STATUS_GUNLIGHT | 0x40000000) \			//	サポート兵化
					-b 敵兵:01 \
					-e d:ENE_EQUIP_TYPE_NORMAL	//	$w:装備タイプ
			} else {
				chara アタッカー 敵兵:64 -r $b:攻撃兵待機ルート \
						-h $w:敵標準聴力 \
						-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
						-l $w:敵標準体力 \
						-f $w:敵標準気絶 \
						-q レーション_敵兵 30 \
						-s ( d:ENE_STATUS_GUNLIGHT ) \
						-e d:ENE_EQUIP_TYPE_NORMAL
			}
		} else {
			// エイムズ死亡後はハイテク兵
			chara アタッカー 敵兵:61 -r $b:攻撃兵待機ルート \
					-h $w:敵標準聴力 \
					-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
					-l $w:敵標準体力 \
					-f $w:敵標準気絶 \
					-q レーション_敵兵 30 \
					-s ( d:ENE_STATUS_GUNLIGHT ) \
					-e d:ENE_EQUIP_TYPE_HITECH_1
			if ($w:ゲーム設定  < d:LEVEL_HARD ) {
				chara アタッカー 敵兵:62 -r $b:攻撃兵待機ルート \
						-h $w:敵標準聴力 \
						-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
						-l $w:敵標準体力 \
						-f $w:敵標準気絶 \
						-q ジアゼパム_敵兵 30 \
						-s ( d:ENE_STATUS_GUNLIGHT ) \
						-e d:ENE_EQUIP_TYPE_HITECH_1
			}
			chara アタッカー 敵兵:63 -r $b:攻撃兵待機ルート \
					-h $w:敵標準聴力 \
					-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
					-l $w:敵標準体力 \
					-f $w:敵標準気絶 \
					-q レーション_敵兵 30 \
					-s ( d:ENE_STATUS_GUNLIGHT ) \
					-e d:ENE_EQUIP_TYPE_HITECH_1
			if ( $w:ゲーム設定 >= d:LEVEL_EXTREME ) {
				// エクストリームのみサポート兵化攻撃兵登場
				chara アタッカー 敵兵:31 \
					-r $b:攻撃兵待機ルート \				//	$b:初期ルート \
					-h $w:敵標準聴力 \
					-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
					-l $w:敵標準体力 \
					-f $w:敵標準気絶 \
					-q レーション_敵兵 30 \
					-s 0x40000000 \			//	サポート兵化
					-b 敵兵:01 \
					-s ( d:ENE_STATUS_GUNLIGHT ) \
					-e d:ENE_EQUIP_TYPE_HITECH_1	//	$w:装備タイプ
			} else {
				chara アタッカー 敵兵:64 -r $b:攻撃兵待機ルート \
						-h $w:敵標準聴力 \
						-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
						-l $w:敵標準体力 \
						-f $w:敵標準気絶 \
						-q レーション_敵兵 30 \
						-s ( d:ENE_STATUS_GUNLIGHT ) \
						-e d:ENE_EQUIP_TYPE_HITECH_1
			}
		}
	}

	proc 警備兵コマンダー {
		#if d:DEBUG_PRINT
			print 'wccomm_set'
		#endif
		chara 警備コマンダー wccomm -e { 警備兵０ }
	}

	proc 攻撃兵コマンダー {
		#if d:DEBUG_PRINT
			print 'atcomm_set'
		#endif
		chara 攻撃コマンダー atcomm -e 攻撃兵０ \
			-wait	(60*3) \
			-avoidwait (60*5)  /*回避モードで始まる場合のみ有効*/
	}

	resource ghq_area_alert_voice {
	w18a:
		$t{
			// PLAREA0
			t:vc040156,	// 指揮官　　「了解。増援部隊、Ｄ脚へ急行せよ！ＣＤ連絡橋への扉を守れ！」
			t:vc040157,	// 指揮官　　「了解。バックアップをＤ脚・ＣＤ連絡橋への扉付近に送る！敵を逃がすな！」
			-2,
			// PLAREA1
			t:vc040158,	// 指揮官　　「了解。増援部隊、Ｄ脚へ向かえ！ＤＥ連絡橋への扉を固めろ！」
			t:vc040159,	// 指揮官　　「了解。応援部隊をＤ脚・ＤＥ連絡橋への扉付近に送る！敵を逃がすな！」
			-2,
			// PLAREA2
			t:vc040160,	// 指揮官　　「了解。増援部隊、Ｄ脚へ向かえ！シェル１シェル２連絡橋への扉を固めろ！」
			t:vc040161,	// 指揮官　　「了解。増援部隊をＤ脚・シェル１シェル２連絡橋への扉付近に送る！敵をシェル２に行かせるな」
			-2,
			// PLAREA3
			t:vc040166,	// 指揮官　　「了解。増援部隊をＤ脚・階段へ派遣する！敵を逃がすな！」
			t:vc040167,	// 指揮官　　「了解。増援部隊、Ｄ脚へ急行せよ！階段を守れ」
			-2,
			// PLAREA4
			t:vc040164,	// 指揮官　　「了解。増援部隊をＤ脚・下層部へ送る！敵を包囲しろ」
			t:vc040165,	// 指揮官　　「了解。増援部隊、Ｄ脚へ急行せよ！下層部を固めろ！」
			-2,
			// PLAREA5
			t:vc040162,	// 指揮官　　「了解。増援部隊をＤ脚・上層部へ送る！敵を逃がすな！」
			t:vc040163,	// 指揮官　　「了解。増援部隊、Ｄ脚へ急行せよ！上層部を守れ！」
			-2,
			// PLAREA6
			t:vc040168,	// 指揮官　　「了解。増援部隊をＤ脚へ送る！敵を逃がすな！」
			t:vc040169,	// 指揮官　　「了解。増援部隊、Ｄ脚へ向かえ！敵を包囲しろ！」
			-1
		}
	}

	resource ghq_caution_voice {
	w18a:
		$t{
			// PLAREA0
			t:vc040331,	// 指揮官　　00「了解。Ｄ脚を増員。警備を強化せよ」
			t:vc040332,	// 指揮官　　01「了解。Ｄ脚に増員を派遣する。警戒を強化せよ」
			t:vc040319,	// 指揮官　　02「了解。Ｄ脚を増員する。ＣＤ連絡橋への扉を守れ」
			t:vc040320,	// 指揮官　　03「了解。Ｄ脚・ＣＤ連絡橋への扉付近を増員する。警戒を強化しろ」
			t:vc040321,	// 指揮官　　04「了解。Ｄ脚を増員する。ＤＥ連絡橋への扉を固めろ」
			t:vc040322,	// 指揮官　　05「了解。Ｄ脚・ＤＥ連絡橋への扉付近を増員。警備を強化しろ」
			t:vc040323,	// 指揮官　　06「了解。Ｄ脚に増員を派遣する。シェル１シェル２連絡橋への扉を守れ」
			t:vc040324,	// 指揮官　　07「了解。Ｄ脚・シェル１シェル２連絡橋への扉付近を増員する。警備を強化しろ」
			t:vc040329,	// 指揮官　　08「了解。Ｄ脚・階段付近へ増員を送る。警戒を強化せよ」
			t:vc040330,	// 指揮官　　09「了解。Ｄ脚を増員。階段付近の警備を強化せよ」
			t:vc040327,	// 指揮官　　10「了解。Ｄ脚・下層部へ増員を送る。警備を強化しろ」
			t:vc040328,	// 指揮官　　11「了解。Ｄ脚を増員する。下層部の警戒を強化せよ」
			t:vc040325,	// 指揮官　　12「了解。Ｄ脚・上層部を増員する。警戒を強化しろ」
			t:vc040326,	// 指揮官　　13「了解。Ｄ脚に増員を送る。上層部の警備を強化しろ」
			-2,
			t:vc040425,	// 指揮官　　「Ｄ脚との連絡が途絶えた」
			-1
		}
	}


	proc コマンダー設定 {
		#if d:DEBUG_PRINT
			print 'commander_set'
		#endif

		if ( $s:登場ポイント == sp_w17a_w18a_0  ) {
			eval( $i:再発生ポイントＸ = -16000 ) ;
			eval( $i:再発生ポイントＹ = 0 ) ;
			eval( $i:再発生ポイントＺ = -110875 ) ;
		} else if ( $s:登場ポイント == sp_w19a_w18a_0  ) {
			eval( $i:再発生ポイントＸ = 16125 ) ;
			eval( $i:再発生ポイントＹ = 0 ) ;
			eval( $i:再発生ポイントＺ = -110625 ) ;
		} else if ( $s:登場ポイント == sp_w19a_w18a_1  ) {
			eval( $i:再発生ポイントＸ = 16125 ) ;
			eval( $i:再発生ポイントＹ = 0 ) ;
			eval( $i:再発生ポイントＺ = -110625 ) ;
		} else {
			eval( $i:再発生ポイントＸ = -16000 ) ;
			eval( $i:再発生ポイントＹ = 0 ) ;
			eval( $i:再発生ポイントＺ = -110875 ) ;
		}

		chara コマンダー 敵兵セット \
			-w 警備兵コマンダー \
			-a 攻撃兵コマンダー \
			-m $w:スタートアラートモード \
			-r $i:再発生ポイントＸ,$i:再発生ポイントＹ,$i:再発生ポイントＺ Ｄ脚 \
			-c $i:再発生ポイントＸ,$i:再発生ポイントＹ,$i:再発生ポイントＺ Ｄ脚 \
			-v [ene_plant_voice:01] \
			-x [ghq_area_alert_voice:w18a] \
			-y [ghq_caution_voice:w18a] \
			-f 4 0 t:vc044023 t:vc044023_len 4 4 t:vc044023 t:vc044023_len 4 9 t:vc044023 t:vc044023_len \
			-s d:ENE_STAGE_GPS \
			-z $i:敵標準麻酔持続 \
			-b $w:敵標準再発生数 \
			-h $i:標準警戒時間 // 警戒時間←ここの行を追加する。
	}

	// ＢＧＭ
	// ------------------------------------
	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT 
			print 'bgm_set'
		#endif
		chara ＢＧＭマネージャー ＢＧＭマネ
	}

	// メニュー
	// ------------------------------------
	proc メニュー設定 {
		#if d:DEBUG_PRINT 
			print 'menu set'
		#endif
		@レーダーオンオフチェック $f:w18a_ノードフラグ
	}

	// ノード関係
	// ------------------------------------
	// フラグとカメラとモーションの設定
	proc ノード接続時プロック {
		#if d:DEBUG_PRINT
			print 'node_set'
		#endif
		// 必ず必要。フラグの初期化はvarinit.hですでに行っています。
		eval($f:ノードフラグ = $f:w18a_ノードフラグ);
	}

	// 接続したフラグをたてたりする
	proc ノード接続後プロック {
		#if d:DEBUG_PRINT
			print 'node_event_go'
		#endif
		eval( $f:w18a_ノードフラグ = 1 );// w18aノードに接続しました
		command メニュー設定 -node_access on 
		// 接続後に何かイベントを起こしたい場合は以下に記入
	}

	// 天井関係
	// ------------------------------------
	proc w18a天井設置 {
		chara 天井君 天井 -m d:KMS_NAME1 -h 4000 -p 0,0,0 -l d:LT2_NAME_W18A -v w18a天井ライト制御
	}
	proc w18a天井ライト制御 {
		mesg プットスポットライトオブジェ 天井ライト ライト管理 $1
	}

	// ドア＆マップ切り替え関係
	// ------------------------------------
	proc ドア設置 {
		#if d:DEBUG_PRINT
			print 'slide_door_set'
		#endif

		chara ドア Ｃ脚方面ドア \
			-m d:DOOR_NAME00 \
			-p -9700,0,-110150 \
			-d 0 1326 0 \
			-slide d:SD_SLIDE_OUTSIDE2 \
			-A Ｃ脚方面ドアランプ \
			-time d:SD_OPEN_TIME \
			-exec {
				if( $:開閉フラグ ) {
					/* 開き始めたので隙間風を吹かせる */
					chara delay ディレイ -time 10 -exec {
						mesg ローカル風 隙間風 オン
					}
				} else {
					/* 閉まりきった */
					mesg ローカル風 隙間風 オフ
				}
			}

		trap dr001 ？ -mask ？ \
			-exec {
				if ( $3 == 入る ) {
					mesg ドア Ｃ脚方面ドア open
				} else{
					mesg ドア Ｃ脚方面ドア close
				}
			}
		@ドアランプ設定 Ｃ脚方面ドアランプ 1326 -9700,0,-110150 0

		chara ドア Ｅ脚方面ドア上 \
			-m d:DOOR_NAME00 \
			-p 9700,0,-110150 \
			-d 0  722 0 \
			-slide d:SD_SLIDE_OUTSIDE2 \
			-A Ｅ脚方面ドア上ランプ \
			-time d:SD_OPEN_TIME \
			-exec {
				if( $:開閉フラグ ) {
					/* 開き始めたので隙間風を吹かせる */
					chara delay ディレイ -time 10 -exec {
						mesg ローカル風 隙間風 オン
					}
				} else {
					/* 閉まりきった */
					mesg ローカル風 隙間風 オフ
				}
			}

		trap dr002 ？ -mask ？ \
			-exec {
				if ( $3 == 入る ) {
					mesg ドア Ｅ脚方面ドア上 open
				} else{
					mesg ドア Ｅ脚方面ドア上 close
				}
			}
		@ドアランプ設定 Ｅ脚方面ドア上ランプ 722 9700,0,-110150 1

		chara ドア Ｅ脚方面ドア下 \
			-m d:DOOR_NAME00 \
			-p 9700,-4000,-110150 \
			-d 0  722 0 \
			-slide d:SD_SLIDE_OUTSIDE2 \
			-A Ｅ脚方面ドア下ランプ \
			-time d:SD_OPEN_TIME \
			-exec {
				if( $:開閉フラグ ) {
					/* 開き始めたので隙間風を吹かせる */
					chara delay ディレイ -time 10 -exec {
						mesg ローカル風 隙間風 オン
					}
				} else {
					/* 閉まりきった */
					mesg ローカル風 隙間風 オフ
				}
			}

		trap dr003 ？ -mask ？ \
			-exec {
				if ( $3 == 入る ) {
					mesg ドア Ｅ脚方面ドア下 open
				} else{
					mesg ドア Ｅ脚方面ドア下 close
				}
			}
		@ドアランプ設定 Ｅ脚方面ドア下ランプ 722 9700,-4000,-110150 1

		chara ドア Ｇ脚方面ドア \
			-m d:DOOR_NAME02 \
			-p -3000,500,-134125 \
			-d 0 0 0 \
			-card_level 3 \			// カードレベルは３です！
			-slide d:SD_SLIDE_OUTSIDE \
			-A Ｇ脚方面ドアランプ \
			-time d:SD_OPEN_TIME \
			-exec {
				if( $:開閉フラグ ) {
					/* 開き始めたので隙間風を吹かせる */
					chara delay ディレイ -time 10 -exec {
						mesg ローカル風 隙間風 オン
					}
				} else {
					/* 閉まりきった */
					mesg ローカル風 隙間風 オフ
				}
			}
			
		trap dr004 ？ -mask ？ \
			-exec {
				if ( $3 == 入る ) {
					mesg ドア Ｇ脚方面ドア open $2
				} else{
					mesg ドア Ｇ脚方面ドア close
				}
			}
		@ドアランプ設定 Ｇ脚方面ドアランプ 0 -3000,500,-134125 0
	}
	proc 主観禁止壁設定 {
		@主観禁止壁 ＣＤ連絡橋へのドア壁 -9700,0,-110150 1326 d:SD_SLIDE_OUTSIDE2
		trap dr001 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_SUBJECT \
			-exec {
				if( $3 == 入る ) {
					mesg 透明壁 ＣＤ連絡橋へのドア壁 on
				} else {
					mesg 透明壁 ＣＤ連絡橋へのドア壁 off
				}
			}
		@主観禁止壁 ＤＥ連絡橋上へのドア壁 9700,0,-110150 722 d:SD_SLIDE_OUTSIDE2
		trap dr002 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_SUBJECT \
			-exec {
				if( $3 == 入る ) {
					mesg 透明壁 ＤＥ連絡橋上へのドア壁 on
				} else {
					mesg 透明壁 ＤＥ連絡橋上へのドア壁 off
				}
			}
		@主観禁止壁 ＤＥ連絡橋下へのドア壁 9700,-4000,-110150 722 d:SD_SLIDE_OUTSIDE2
		trap dr003 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_SUBJECT \
			-exec {
				if( $3 == 入る ) {
					mesg 透明壁 ＤＥ連絡橋下へのドア壁 on
				} else {
					mesg 透明壁 ＤＥ連絡橋下へのドア壁 off
				}
			}
		@主観禁止壁 シェル１シェル２連絡橋へのドア壁 -3000,500,-134125 0 d:SD_SLIDE_OUTSIDE
		trap dr004 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_SUBJECT \
			-exec {
				if( $3 == 入る ) {
					mesg 透明壁 シェル１シェル２連絡橋へのドア壁 on
				} else {
					mesg 透明壁 シェル１シェル２連絡橋へのドア壁 off
				}
			}
	}

	// 入出トラップ
	// ------------------------------------
	proc ロードプロック {
		#if d:DEBUG_PRINT 
			print 'load_proc'
		#endif

		if ($s:呼び出しプロック == mv_w18a_w17a_0) {
			// ＣＤ連絡橋へ
			@mv_w18a_w17a_0
		} else if ($s:呼び出しプロック == mv_w18a_w19a_0) {
			// ＤＥ連絡橋上へ
			@mv_w18a_w19a_0
		} else if ($s:呼び出しプロック == mv_w18a_w19a_1) {
			// ＤＥ連絡橋下へ
			@mv_w18a_w19a_1
		} else if ($s:呼び出しプロック == mv_w18a_w25a_0) {
			// ＤＧ連絡橋へ
			@mv_w18a_w25a_0
		}
	}

	proc ロード設定 {
		#if d:DEBUG_PRINT 
			print 'load_set'
		#endif
		// ＣＤ連絡橋へ
		trap ld001 d:PLAYER \
			-mask いる \
			-exec {
				eval( $i:検査結果 = `command 内包チェック $4 $6 -11000,-113000,-9375,-109750,-12375,-108250,-14000,-111500`) ;
				if(( $i:検査結果 > 0 ) && ( $f:ロードチェックＯＮフラグ == 1 )){
					@爆弾タイマー残り時間保存
					preseek 'w17a'
					@ステージ終了時処理（ステージ名表示） -11000 0 -110000 0 mv_w18a_w17a_0 d:DEFAULT_M_TYPE d:wn_ＣＤ連絡橋
					@ＣＤ連絡橋ロード時カメラ設定
				}
			}
		// ＤＥ連絡橋(上)へ
		trap ld002 d:PLAYER \
			-mask いる \
			-exec {
				eval( $i:検査結果 = `command 内包チェック $4 $6 9375,-109750,11500,-114000,14500,-112500,12375,-108250`) ;
				if(( $i:検査結果 > 0 ) && ( $f:ロードチェックＯＮフラグ == 1 )){
					@爆弾タイマー残り時間保存
					preseek 'w19a'
					@ステージ終了時処理（ステージ名表示） 11000 0 -110000 0 mv_w18a_w19a_0 d:DEFAULT_M_TYPE d:wn_ＤＥ連絡橋
					@ＤＥ連絡橋上ロード時カメラ設定
				}
			}
		// ＤＥ連絡橋(下)へ
		trap ld003 d:PLAYER \
			-mask いる \
			-exec {
				eval( $i:検査結果 = `command 内包チェック $4 $6 9375,-109750,11500,-114000,14500,-112500,12375,-108250`) ;
				if(( $i:検査結果 > 0 ) && ( $f:ロードチェックＯＮフラグ == 1 )){
					@爆弾タイマー残り時間保存
					preseek 'w19a'
					@ステージ終了時処理（ステージ名表示） 11000 -4000 -110000 0 mv_w18a_w19a_1 d:DEFAULT_M_TYPE d:wn_ＤＥ連絡橋
					@ＤＥ連絡橋下ロード時カメラ設定
				}
			}
		// ＤＧ連絡橋へ
		trap ld004 d:PLAYER \
			-mask 入る \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 1 ) {
					@爆弾タイマー残り時間保存		// いらんかな？
					preseek 'w25a'
					@ステージ終了時処理（ステージ名表示） -2250 500 -136000 0 mv_w18a_w25a_0 d:DEFAULT_M_TYPE d:wn_ＤＧ連絡橋
					@ＤＧ連絡橋ロード時カメラ設定
					command セットサウンドコード -c d:SNG_FOUTS_S
				}
			}
	}

	// アイテム
	// ------------------------------------
	// アイテム
	// ------------------------------------
	proc アイテム設置 {
		#if d:DEBUG_PRINT
			print 'item_set'
		#endif
//		@ダンボールＥ_初期設置	ダンボールＥ	-8500   -4000 -109500 0 25
//		監督指示により別ステージへ移行 2001.6.9
		@アイテム再セットチェック $b:w18a_取得ロード回数[0]
		if ($f:再セットフラグ) { @弾薬_Ｍ９_初期設置		Ｍ９弾		-6500   -4000 -133500 0 }
		@アイテム再セットチェック（難易度対応） $b:w18a_取得ロード回数[1]
		if ($f:再セットフラグ) { @レーション_初期設置		レーション	 1250   -1000 -119250 0 }
		@アイテム再セットチェック $b:w18a_取得ロード回数[2]
		if ($f:再セットフラグ) { @弾薬_ソコム_初期設置		ソコム弾	-8500   -1000 -109500 0 }
		@アイテム再セットチェック $b:w18a_取得ロード回数[3]
		if ($f:再セットフラグ) { @弾薬_ＰＳＧ１_初期設置	ＰＳＧ１弾	 8500   -1000 -109500 0 }
	}
	proc アイテム取得時番号設定 $:ボックス名 {
		if ( $:ボックス名 == Ｍ９弾 ) {
			eval($b:w18a_取得ロード回数[0] = $w:グローバルロード回数);	
		} else if ( $:ボックス名 == レーション ) {
			eval($b:w18a_取得ロード回数[1] = $w:グローバルロード回数);	
		} else if ( $:ボックス名 == ソコム弾 ) {
			eval($b:w18a_取得ロード回数[2] = $w:グローバルロード回数);	
		} else if ( $:ボックス名 == ＰＳＧ１弾 ) {
			eval($b:w18a_取得ロード回数[3] = $w:グローバルロード回数);	
		}
		#ifdef d:DEBUG_PRINT
			print $:ボックス名
			print $w:グローバルロード回数
		#endif
	}


	// ビヨンド設定
	// ------------------------------------
	proc Ｄ脚ビヨンド設定 {
		#if d:DEBUG_PRINT
			print 'w18a_beyond_set'
		#endif
			// --------------------------------------------------
			trap by001 d:PLAYER \
				-mask いる \
				-and \
				-button d:ACTION_BUTTON d:ACTION_BUTTON \		//ビヨンドボタン
				-state 0,4 \	//立ち状態or張り付き
				-exec {
					eval( $b:ビヨンド判定01 = 1 );
					if ( `@東向きビヨンド発動 $1 1000 $6 -131000 -124000 0x00002 ` == 0 ) {
						eval( $b:ビヨンド判定01 = 2 );
						if ( `@西向きビヨンド発動 $1 -1000 $6 -131000 -124000 0x00002 ` == 0 ) {
							eval( $b:ビヨンド判定01 = 0 );
						}
					}
					// 脚注：
					// ビヨンド発動Procは、返値として
					// 失敗すると”０”が、
					// 成功すると”トラップ名”が、返される。
				}
			// エルード移行カメラ
			trap by001 d:PLAYER -camera -mask ＊ -state d:TRP_STATE_FORCE \
				-exec {
					if ( $b:ビヨンド判定01 == 1 ) {
						chara カメラ設定 モーションカメラ \
							-c 1 \
							-p 5048,2380,-119721 \
							-t 3438,1513,-122325 \
							-a 200 \
							-i 0 -1 0 0 -s $3
					} else if ( $b:ビヨンド判定01 == 2 ) {
						chara カメラ設定 モーションカメラ \
							-c 1 \
							-p -6692,5204,-119984 -t -3580,1084,-125052 \
							-r 395,1689,0 -f 7235 \
							-a 244 \
							-i 0 -1 0 0 -s $3
					}
				}
			// エルード中カメラ(１２時方向渡り廊下東側)
			trap by001 d:PLAYER -camera -mask ？ -state d:TRP_STATE_ELUDE \
				-exec {
					if ( $b:ビヨンド判定01 == 1 ) {
						chara カメラ設定 ビヨンドカメラ \
							-c 0 \
							-b -320000 -320000 -320000 320000 320000 320000 \
							-l -320000 -320000 -320000 320000 320000 320000 \
							-r 478,2954,0 -f 4900 \
							-a 244 \
							-i 1 -1 0 0 -s $3
					} else if ( $b:ビヨンド判定01 == 2 ) {
						chara カメラ設定 ビヨンドカメラ \
							-c 0 \
							-b -320000 -320000 -320000 320000 320000 320000 \
							-l -320000 -320000 -320000 320000 320000 320000 \
							-r 478,1166,0 -f 4900 \
							-a 244 \
							-i 1 -1 0 0 -s $3
					}
				}
			// --------------------------------------------------
			trap by002 d:PLAYER \
				-mask いる \
				-and \
				-button d:ACTION_BUTTON d:ACTION_BUTTON \		//ビヨンドボタン
				-state 0,4 \	//立ち状態or張り付き
				-exec {
					eval( $b:ビヨンド判定02 = 1 );
					if ( `@斜めビヨンド発動 $1 $4 $6 -8500 -114250 -2750 -117125 1500 0x000002 ` == 0 ) {
						eval( $b:ビヨンド判定02 = 2 );
