		#endif
		trap by001 d:PLAYER -camera -mask ＊ -state d:TRP_STATE_BEHINDCAMERA_ENABLE -exec { if($3==いる){ @覗込みＯＮ }else{ @覗込みＯＦＦ) } }
		trap by002 d:PLAYER -camera -mask ＊ -state d:TRP_STATE_BEHINDCAMERA_ENABLE -exec { if($3==いる){ @覗込みＯＮ }else{ @覗込みＯＦＦ) } }
		trap by003 d:PLAYER -camera -mask ＊ -state d:TRP_STATE_BEHINDCAMERA_ENABLE -exec { if($3==いる){ @覗込みＯＮ }else{ @覗込みＯＦＦ) } }
		trap by004 d:PLAYER -camera -dir 1365,512 -mask ＊ -state d:TRP_STATE_BEHINDCAMERA_ENABLE -exec { if($3==いる){ @覗込みＯＮ }else{ @覗込みＯＦＦ) } }
		trap by005 d:PLAYER -camera -dir 2731,512 -mask ＊ -state d:TRP_STATE_BEHINDCAMERA_ENABLE -exec { if($3==いる){ @覗込みＯＮ }else{ @覗込みＯＦＦ) } }
		trap by006 d:PLAYER -camera -dir  683,512 -mask ＊ -state d:TRP_STATE_BEHINDCAMERA_ENABLE -exec { if($3==いる){ @覗込みＯＮ }else{ @覗込みＯＦＦ) } }
		trap by007 d:PLAYER -camera -dir 3413,512 -mask ＊ -state d:TRP_STATE_BEHINDCAMERA_ENABLE -exec { if($3==いる){ @覗込みＯＮ }else{ @覗込みＯＦＦ) } }
		trap by008 d:PLAYER -camera -dir 3072,512 -mask ＊ -state d:TRP_STATE_BEHINDCAMERA_ENABLE -exec { if($3==いる){ @覗込みＯＮ }else{ @覗込みＯＦＦ) } }
		trap by009 d:PLAYER -camera -dir 1024,512 -mask ＊ -state d:TRP_STATE_BEHINDCAMERA_ENABLE -exec { if($3==いる){ @覗込みＯＮ }else{ @覗込みＯＦＦ) } }
		trap by010 d:PLAYER -camera -dir 2048,512 -mask ＊ -state d:TRP_STATE_BEHINDCAMERA_ENABLE -exec { if($3==いる){ @覗込みＯＮ }else{ @覗込みＯＦＦ) } }
		trap by011 d:PLAYER -camera -dir 2048,512 -mask ＊ -state d:TRP_STATE_BEHINDCAMERA_ENABLE -exec { if($3==いる){ @覗込みＯＮ }else{ @覗込みＯＦＦ) } }
		trap by012 d:PLAYER -camera -dir  682,512 -mask ＊ -state d:TRP_STATE_BEHINDCAMERA_ENABLE -exec { if($3==いる){ @覗込みＯＮ }else{ @覗込みＯＦＦ) } }
		trap by013 d:PLAYER -camera -dir 3413,512 -mask ＊ -state d:TRP_STATE_BEHINDCAMERA_ENABLE -exec { if($3==いる){ @覗込みＯＮ }else{ @覗込みＯＦＦ) } }
		trap by014 d:PLAYER -camera -dir 2048,512 -mask ＊ -state d:TRP_STATE_BEHINDCAMERA_ENABLE -exec { if($3==いる){ @覗込みＯＮ }else{ @覗込みＯＦＦ) } }
		trap by020 d:PLAYER -camera -dir 1365,512 -mask ＊ -state d:TRP_STATE_BEHINDCAMERA_ENABLE -exec { if($3==いる){ @覗込みＯＮ }else{ @覗込みＯＦＦ) } }
		trap by021 d:PLAYER -camera -dir 2731,512 -mask ＊ -state d:TRP_STATE_BEHINDCAMERA_ENABLE -exec { if($3==いる){ @覗込みＯＮ }else{ @覗込みＯＦＦ) } }
		trap by022 d:PLAYER -camera -dir  682,512 -mask ＊ -state d:TRP_STATE_BEHINDCAMERA_ENABLE -exec { if($3==いる){ @覗込みＯＮ }else{ @覗込みＯＦＦ) } }
		trap by023 d:PLAYER -camera -dir 3413,512 -mask ＊ -state d:TRP_STATE_BEHINDCAMERA_ENABLE -exec { if($3==いる){ @覗込みＯＮ }else{ @覗込みＯＦＦ) } }
		trap by024 d:PLAYER -camera -dir 3072,512 -mask ＊ -state d:TRP_STATE_BEHINDCAMERA_ENABLE -exec { if($3==いる){ @覗込みＯＮ }else{ @覗込みＯＦＦ) } }
		trap by025 d:PLAYER -camera -dir 1024,512 -mask ＊ -state d:TRP_STATE_BEHINDCAMERA_ENABLE -exec { if($3==いる){ @覗込みＯＮ }else{ @覗込みＯＦＦ) } }
		trap by026 d:PLAYER -camera -dir 2048,512 -mask ＊ -state d:TRP_STATE_BEHINDCAMERA_ENABLE -exec { if($3==いる){ @覗込みＯＮ }else{ @覗込みＯＦＦ) } }
		trap by027 d:PLAYER -camera -dir 2048,512 -mask ＊ -state d:TRP_STATE_BEHINDCAMERA_ENABLE -exec { if($3==いる){ @覗込みＯＮ }else{ @覗込みＯＦＦ) } }
	}
	proc 覗込みＯＮ {
		#if 0
			eval( $i:cpx = $i:プレイヤー位置Ｘ - (`%sin $w:プレイヤー方向` * 3000) / 4096 ) ;
			eval( $i:cpy = $i:プレイヤー位置Ｙ + 3700 ) ;
			eval( $i:cpz = $i:プレイヤー位置Ｚ - (`%cos $w:プレイヤー方向` * 3000) / 4096 ) ;
			eval( $i:ctx = $i:プレイヤー位置Ｘ - (`%sin $w:プレイヤー方向` * 1000) / 4096 ) ;
			eval( $i:cty = $i:プレイヤー位置Ｙ + 0 ) ;
			eval( $i:ctz = $i:プレイヤー位置Ｚ - (`%cos $w:プレイヤー方向` * 1000) / 4096 ) ;
			eval( $w:agl = 200 ) ;
			if (`%オンラインチェック -from_to $i:cpx $i:cpy $i:cpz  $i:ctx $i:cty $i:ctz` != 0 ) {
				// 間に壁を発見したので極近カメラで誤魔化す
				eval( $i:cpx = $i:プレイヤー位置Ｘ - (`%sin $w:プレイヤー方向` * 1200) / 4096 ) ;
				eval( $i:cpy = $i:プレイヤー位置Ｙ + 1500 ) ;
				eval( $i:cpz = $i:プレイヤー位置Ｚ - (`%cos $w:プレイヤー方向` * 1200) / 4096 ) ;
				eval( $i:ctx = $i:プレイヤー位置Ｘ - (`%sin $w:プレイヤー方向` * 300) / 4096 ) ;
				eval( $i:cty = $i:プレイヤー位置Ｙ + 0 ) ;
				eval( $i:ctz = $i:プレイヤー位置Ｚ - (`%cos $w:プレイヤー方向` * 300) / 4096 ) ;
				eval( $w:agl = 154 ) ;
			}
		#else
			eval( $i:cpx = $i:プレイヤー位置Ｘ - (`%sin $w:プレイヤー方向` * 1000) / 4096 ) ;
			eval( $i:cpy = $i:プレイヤー位置Ｙ + 3700 ) ;
			eval( $i:cpz = $i:プレイヤー位置Ｚ - (`%cos $w:プレイヤー方向` * 1000) / 4096 + 1000 ) ;
			eval( $i:ctx = $i:プレイヤー位置Ｘ - (`%sin $w:プレイヤー方向` * 1000) / 4096 ) ;
			eval( $i:cty = $i:プレイヤー位置Ｙ + 0 ) ;
			eval( $i:ctz = $i:プレイヤー位置Ｚ - (`%cos $w:プレイヤー方向` * 1000) / 4096 ) ;
			eval( $w:agl = 200 ) ;
			if (`%オンラインチェック -from_to $i:cpx $i:cpy $i:cpz  $i:ctx $i:cty $i:ctz` != 0 ) {
				// 間に壁を発見したので極近カメラで誤魔化す
				eval( $i:cpx = $i:プレイヤー位置Ｘ - (`%sin $w:プレイヤー方向` * 300) / 4096 ) ;
				eval( $i:cpy = $i:プレイヤー位置Ｙ + 1500 ) ;
				eval( $i:cpz = $i:プレイヤー位置Ｚ - (`%cos $w:プレイヤー方向` * 300) / 4096 + 500 ) ;
				eval( $i:ctx = $i:プレイヤー位置Ｘ - (`%sin $w:プレイヤー方向` * 300) / 4096 ) ;
				eval( $i:cty = $i:プレイヤー位置Ｙ + 0 ) ;
				eval( $i:ctz = $i:プレイヤー位置Ｚ - (`%cos $w:プレイヤー方向` * 300) / 4096 ) ;
				eval( $w:agl = 154 ) ;
			}
		#endif
		chara カメラ設定 ビヨンドカメラ \
			-c 1 \
			-p $i:cpx,$i:cpy,$i:cpz \
			-t $i:ctx,$i:cty,$i:ctz \
			-a $w:agl \
			-i 0 0 0 0 \
			-s 1
	}
	proc 覗込みＯＦＦ {
		chara カメラ設定 ビヨンドカメラ -s 0
	}

	// キャラ用光源(マップの設置が終わってから設定することで、キャラだけに光を当てる)
	// ------------------------------------
	proc キャラ用ライト設置 {
		#if d:DEBUG_PRINT
			print 'chara_light_set'
		#endif

		chara 環境光 環境光源 \
			 -c 69 54 12

		chara 平行光 平行光源 \
			 -c 74 112 97 \
			 -p -3400 -1000 -34000
	}
	// フォグ
	// ------------------------------------
	proc 陸上フォグ設定 {
		#if d:DEBUG_PRINT
			print 'land_fog_set'
		#endif

		chara フォグ 霧\
			-c 20 36 20 \
			-n 15000 \
			-f 40000 
	}


	// エフェクト関係
	// -----------------------------------
	proc エフェクト設定 {
		#if d:DEBUG_PRINT
			print 'effect_set'
		#endif

		#if d:BLUR
			chara ブラー ブラー
		#endif

		#if d:Z_MANAGER
			chara Ｚフォーカス管理 Z_manager
			mesg Ｚフォーカス管理 Z_manager パラメータ 5000 30
		#endif

		#if d:BODY_SHADOW
			chara ＯＦＦ制御 off_man
			mesg ＯＦＦ制御 off_man ボディシャドウＯＦＦ
		#endif
	}

	proc 水面設定 {
		#if d:DEBUG_PRINT
			print 'water set'
		#endif

		chara 通路用水面 キラキラ水面 \
			-tex water w18a_water_alp_ovl \
			-scale 192 \
			-num 3,3 \
			-pos 0, -9000, -120000 \
			-wave 30 170 12 \
			-alpha_blend \
			-force 1
		chara 水面監視水飛沫 落下水飛沫 \
			-n d:PLAYER \
			-n 敵兵
		command 水位設定 -lv -9000 -s d:se_code:SD_A_RICOCH08
		command 弾水飛沫処理

		trap ev011 d:PLAYER -mask 入る -exec {
			chara パッド振動 落下振動 -vibfile drop_sea
		}

		// 水面写りこみ&テクスチャアニメ
		chara プットオブジェ 写りこみモデル -m w18a_water_ref -r 0,0,0 -p 0,0,0 -s 100,100,100 -l d:LT2_NAME_W18A
		chara アニメテクスチャセット 水面写りこみ \
			-tex w18a w18a_water_ref_add_alp_ovl \
			-anmtex w18ahakei \
			-interval 2 \
			-flag 0x0001
	}

	// 子画面設定 
	// ------------------------------------
	proc 子画面設定 {
		#if d:DEBUG_PRINT
			print 'sub_camera_set'
		#endif

		chara サブ画面 子画面 \
			-w (512-d:SUB_MARGIN-d:SUB_WIDTH),d:SUB_MARGIN (512-d:SUB_MARGIN),(d:SUB_HEIGHT+d:SUB_MARGIN)
	}

	// ステージカメラ設定 
	// ------------------------------------
	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0 
		chara カメラ 標準カメラ			-c 0 -l 2 -p 50
		chara カメラ 小部屋カメラ		-c 0 -l 2 -p 40
		chara カメラ ビヨンドカメラ		-c 0 -l 2 -p 30
		chara カメラ モーションカメラ		-c 0 -l 2 -p 20
		chara カメラ 落下中カメラ		-c 0 -l 2 -p 10
		chara カメラ ロードカメラ		-c 0 -l 2 -p 5

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \	
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 640,2048,0 \
			-f 6000 \
			-a 200 \
			-i 1 1 0 0 \
			-s 1
	}


// 各マップ別設定
// ------------------------------------
// Ｄ脚
	// 各種カメラの設定
	// ------------------------------------
	proc Ｄ脚カメラ設定 {
		#if d:DEBUG_PRINT
			print 'w18a_camera_set'
		#endif
		// 上部タラップ
		/* 回転固定方式 */
		trap ca001 d:PLAYER -mask ＊ -camera -exec {
				#if 0
				eval( $i:中央からの距離 = `%VecLen $4 0 $6 d:Ｄ脚中心Ｘ 0 d:Ｄ脚中心Ｚ`)
				if ( $i:中央からの距離 > 11000 ) { eval( $i:中央からの距離 = 11000 ) }
				eval( $i:w18a_py = (((9000 - ( $i:中央からの距離 - 2000 )) / 4) + 2000 ));
				#endif
				if( $6 > -117625 ) { 				// 手前
					eval( $i:cam_edge_x = (9127-($6+117625)/3));
				} else if( $6 > -122500 ) { 			// 中央
					eval( $i:cam_edge_x = 9127 );
				} else if( $6 > -134000 ) {			// 奥
					eval( $i:cam_edge_x = (9127-(-122500-$6)/2));
				}
				if( $4 < -$i:cam_edge_x ) { eval( $i:w18a_px = -$i:cam_edge_x ) ;
				} else if( $4 > $i:cam_edge_x ) { eval( $i:w18a_px = $i:cam_edge_x ) ;
				} else { eval( $i:w18a_px = $4 ) ; }

				if( $6 > -110919 ) { eval( $i:w18a_tz = -110919 ) ;
				} else if( $6 < -131288 ) { eval( $i:w18a_tz = -131288 ) ;
				} else { eval( $i:w18a_tz = $6 ) ; }

				eval( $i:w18a_pz = $i:w18a_tz+4000-(($6+108625)/5) ) ;
				eval( $i:w18a_py = 5491 ) ;
				if( $5 > 50 ) { eval( $i:w18a_ty = 50 ) ;
				} else { eval( $i:w18a_ty = $5 ) ; }
				
				chara カメラ設定 標準カメラ \
					-c 1 \
					-p $i:w18a_px,$i:w18a_py,$i:w18a_pz \
					-t $i:w18a_px,$i:w18a_ty,$i:w18a_tz \
					-a 180 \
					-i 0 0 0 0 \
					-s $3
		}
		// 下部タラップ
		trap ca002 d:PLAYER -mask ＊ -camera -exec {
				if( $6 > -117625 ) { 				// 手前
					eval( $i:cam_edge_x = (9250-($6+117625)*10/28));
					eval( $i:trg_edge_x = (9250-($6+117625)*10/34));
				} else if( $6 > -122500 ) { 			// 中央
					eval( $i:cam_edge_x = 9250 );
					eval( $i:trg_edge_x = $i:cam_edge_x );
				} else if( $6 > -134000 ) {			// 奥
					eval( $i:cam_edge_x = (9250-(-122500-$6)*10/28));
					eval( $i:trg_edge_x = $i:cam_edge_x );
				}
				if( $4 < -$i:cam_edge_x ) { eval( $i:w18a_px = -$i:cam_edge_x ) ;
				} else if( $4 > $i:cam_edge_x ) { eval( $i:w18a_px = $i:cam_edge_x ) ;
				} else { eval( $i:w18a_px = $4 ) ; }
				if( $4 < -$i:trg_edge_x ) { eval( $i:w18a_tx = -$i:trg_edge_x ) ;
				} else if( $4 > $i:trg_edge_x ) { eval( $i:w18a_tx = $i:trg_edge_x ) ;
				} else { eval( $i:w18a_tx = $4 ) ; }

//				if( $6 > -110919 ) { eval( $i:w18a_tz = -110919 ) ;
				if( $6 > -110428 ) { eval( $i:w18a_tz = -110428 ) ;
				} else { eval( $i:w18a_tz = $6 ) ; }

				eval( $i:w18a_pz = $i:w18a_tz+4000-(($6+108625)/5) ) ;
				eval( $i:w18a_py = -2000 ) ;
				eval( $i:w18a_ty = -2953 ) ;
				chara カメラ設定 標準カメラ \
					-c 1 \
					-p $i:w18a_px,$i:w18a_py,$i:w18a_pz \
					-t $i:w18a_tx,$i:w18a_ty,$i:w18a_tz \
					-a 152 \
					-i 0 0 0 0 \
					-s $3
		}
#if 0
		trap ca002 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				eval( $i:w18a_cam_xpos = ( $4 * 3 / 4 ));
				eval( $i:w18a_cam_ypos = ( $5 + 1000 ));
				eval( $i:w18a_cam_zpos = ( $6 + 6000 ));
				if ( $i:w18a_cam_zpos >= -106005 ) { eval( $i:w18a_cam_zpos = -106005 ) } ;
				chara カメラ設定 標準カメラ \
					-c 1 \
					-p $i:w18a_cam_xpos,$i:w18a_cam_ypos,$i:w18a_cam_zpos \
					-t $4,$5,$6 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3
			}
#endif
		// ステージスタート時のロードカメラ
		trap dr001 d:PLAYER -mask 入る \
			-exec { if( $f:ロードチェックＯＮフラグ == 0 ) { @ＣＤ連絡橋ロード時カメラ設定 ; }}
		trap dr002 d:PLAYER -mask 入る \
			-exec { if( $f:ロードチェックＯＮフラグ == 0 ) { @ＤＥ連絡橋上ロード時カメラ設定 ; }}
		trap dr003 d:PLAYER -mask 入る \
			-exec { if( $f:ロードチェックＯＮフラグ == 0 ) { @ＤＥ連絡橋下ロード時カメラ設定 ; }}
		trap dr004 d:PLAYER -mask 入る \
			-exec { if( $f:ロードチェックＯＮフラグ == 0 ) { @ＤＧ連絡橋ロード時カメラ設定 ; }}
	}

	proc ＣＤ連絡橋ロード時カメラ設定 {
		chara カメラ設定 ロードカメラ \
						-c 1 \
						-p -8020,4291,-111044 -t -11457,-1081,-111799 \
						-r 646,2931,0 -f 6422 \
						-a 200 \
						-i 1 0 0 0 \
						-s 1
		chara プロック連続実行 カメラ戻し管理人 \
			-proc カメラ戻し管理
	}
	proc ＤＥ連絡橋上ロード時カメラ設定 {
		chara カメラ設定 ロードカメラ \
						-c 1 \
						-p 7447,4554,-110660 -t 9441,2077,-111551 \
						-r 553,1298,0 -f 3303 \
						-a 200 \
						-i 1 0 0 0 \
						-s 1
		chara プロック連続実行 カメラ戻し管理人 \
			-proc カメラ戻し管理
	}
	proc ＤＥ連絡橋下ロード時カメラ設定 {
		chara カメラ設定 ロードカメラ \
						-c 1 \
						-p 5715,-2524,-109442 -t 8730,-2676,-110790 \
						-r 30,1298,0 -f 3306 \
						-a 200 \
						-i 1 0 0 0 \
						-s 1
		chara プロック連続実行 カメラ戻し管理人 \
			-proc カメラ戻し管理
	}
	proc ＤＧ連絡橋ロード時カメラ設定 {
		chara カメラ設定 ロードカメラ \
						-c 1 \
						-p -3798,3829,-129305 -t -1649,1138,-134382 \
						-r 296,1787,0 -f 6135 \
						-a 180 \
						-i 1 0 0 0 \
						-s 1
		chara プロック連続実行 カメラ戻し管理人 \
			-proc カメラ戻し管理
	}
	proc カメラ戻し管理 {
		command パッドチェック \
			-no_use
		if ($status != 1) {
			chara カメラ設定 ロードカメラ \
				-s -1
			mesg プロック連続実行 カメラ戻し管理人 kill
		}
	}


	proc Ｄ脚ハッチ設定 {
		// ハッチ設置
		eval( $w:フラグ = 0 ) ;
		eval( $f:w18aハッチ1F北西_開閉 = `@ハッチ閉めチェック $w:w18aハッチ1F北西_状態` ) ;
		if( !$f:w18aハッチ1F北西_開閉 ) {
			chara プットオブジェ w18aハッチ1F北西 -m d:W18A_HATCH_MDL \
				-p -10170 -4000 -128125 -r 0 3794 1024 \
				-l d:LT2_NAME_W18A -f $w:フラグ
		} else {
			chara プットモーションモデル w18aハッチ1F北西 \
				-pos -10170 -4000 -128125 \		//$v:配置座標
				-dir 3794 \				//$i:方向
				-kms d:W18A_HATCH_MDL \			//$s:KMSモデル名
				-mar d:W18A_HATCH_MTN \			//$s:モーションファイル名
				-number 0 \				//$i:基本モーション番号 ... 
				-status	0x0e 				//$w:ステータス 
			@ハッチ当たり浮かせ -9500 -127231 -9052 -128126 -9947 -128573 -10393 -127678 -4000 w18aハッチ1F北西床当たり;
		}
		eval( $f:w18aハッチ1F西_開閉 = `@ハッチ閉めチェック $w:w18aハッチ1F西_状態` ) ;
		if( !$f:w18aハッチ1F西_開閉 ) {
			chara プットオブジェ w18aハッチ1F西 -m d:W18A_HATCH_MDL \
				-p -10525 -4000 -112579 -r 0 302 1024 \
				-l d:LT2_NAME_W18A -f $w:フラグ
			mesg 解体Ｃ４ w18a匂い爆弾１ spray_check 1	// ハッチが開いているので有効
		} else {
			chara プットモーションモデル w18aハッチ1F西 \
				-pos -10525 -4000 -112579 \		//$v:配置座標
