	// エルードが終了したかどうかの確認
	// ------------------------------------
	proc エルード状態監視 {
		@エルード監視フラグ初期化 ;
		command プレイヤー状態取得 ;
		eval( $i:直前のプレイヤー状態 = $status ) ;
		chara プロック連続実行 エルード状態監視キャラ -time -1 \
			-exec {
				command プレイヤー状態取得 ;
				eval( $i:w18aプレイヤー状態 = $status );

				if (( ($i:w18aプレイヤー状態 & d:PFLAG_ELUDE_FALL) != 0 ) || \
					( $f:w18a落下死しました != 0 ) ) {
					// エルード落下中か既に落下死状態か
					if(( $i:直前のプレイヤー状態 & d:PFLAG_ELUDE_FALL ) == 0) {
						eval( $i:EX_カメラＸ位置 = $i:カメラＸ位置 ) ;
						eval( $i:EX_カメラＹ位置 = $i:カメラＹ位置 ) ;
						eval( $i:EX_カメラＺ位置 = $i:カメラＺ位置 ) ;
					}
					chara カメラ設定 落下中カメラ \
						-c 1 \
						-p $i:EX_カメラＸ位置,$i:EX_カメラＹ位置,$i:EX_カメラＺ位置 \
						-t $i:プレイヤー位置Ｘ,$i:プレイヤー位置Ｙ,$i:プレイヤー位置Ｚ \
						-a 200 \
						-i 0 -1 0 0 -s 1
/*
					command オンラインチェック -from_to \
							$i:EX_カメラＸ位置,$i:EX_カメラＹ位置,$i:EX_カメラＺ位置 \
							$i:プレイヤー位置Ｘ,$i:プレイヤー位置Ｙ,$i:プレイヤー位置Ｚ 
					if ( $status ) {
						eval( $i:EX_カメラＺ位置 = $i:EX_カメラＺ位置 + 50 ) ;
						if ( $i:EX_カメラＺ位置 >= $i:プレイヤー位置Ｚ ) {
							eval( $i:EX_カメラＺ位置 = $i:EX_カメラＺ位置 - 50 ) ;
						}
					}
*/
				} else {
					chara カメラ設定 落下中カメラ -s 0
				}
				if ( ( ($i:w18aプレイヤー状態 & d:PFLAG_ELUDE) == 0 ) && (($i:直前のプレイヤー状態 & d:PFLAG_ELUDE) != 0 ) ) {
					@エルード監視フラグ初期化 ;
				}
				eval( $i:直前のプレイヤー状態 = $status ) ;
			}
	}
	proc エルード監視フラグ初期化 {
		chara カメラ設定 モーションカメラ -s 0 ;
		chara カメラ設定 ビヨンドカメラ -s 0 ;
		eval ( $b:ビヨンド判定01 = 0 ) ;
		eval ( $b:ビヨンド判定02 = 0 ) ;
		eval ( $b:ビヨンド判定03 = 0 ) ;
		eval ( $b:ビヨンド判定04 = 0 ) ;
		eval ( $b:ビヨンド判定05 = 0 ) ;
		eval ( $b:ビヨンド判定06 = 0 ) ;
		eval ( $b:ビヨンド判定07 = 0 ) ;
		eval ( $b:ビヨンド判定08 = 0 ) ;
		eval ( $b:ビヨンド判定09 = 0 ) ;
		eval ( $b:ビヨンド判定10 = 0 ) ;
		eval ( $b:ビヨンド判定11 = 0 ) ;
		eval ( $b:ビヨンド判定12 = 0 ) ;
		eval ( $b:ビヨンド判定13 = 0 ) ;
		eval ( $b:ビヨンド判定14 = 0 ) ;
		eval ( $b:ビヨンド判定20 = 0 ) ;
		eval ( $b:ビヨンド判定21 = 0 ) ;
		eval ( $b:ビヨンド判定22 = 0 ) ;
		eval ( $b:ビヨンド判定23 = 0 ) ;
		eval ( $b:ビヨンド判定24 = 0 ) ;
		eval ( $b:ビヨンド判定25 = 0 ) ;
		eval ( $b:ビヨンド判定26 = 0 ) ;
		eval ( $b:ビヨンド判定27 = 0 ) ;
	}

	// 覗き込み設定
