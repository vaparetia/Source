	proc ハッチ当たり浮かせ {
		chara 透明床 $10 \
			-position  $1 ($9+102) $2 \
				   $3 ($9+102) $4 \
				   $5 ($9+102) $6 \
				   $7 ($9+102) $8 \
			-n_points 4 \
			-attribute (d:HZX_FLOOR_NO_C4 | d:HZX_FLOOR_NO_CLAYMORE | d:HZX_FLOOR_NO_BLOOD | d:HZX_FLOOR_NO_BULLETHOLE | d:HZX_FLOOR_NO_SPRAY | d:HZX_FLOOR_IK ) \
			-seno 3 \
			-map Ｄ脚
		chara 透明床 $10 \
			-position  $1 ($9+1) $2 \
				   $3 ($9+1) $4 \
				   $5 ($9+1) $6 \
				   $7 ($9+1) $8 \
			-n_points 4 \
			-attribute (d:HZX_FLOOR_NO_C4 | d:HZX_FLOOR_NO_CLAYMORE | d:HZX_FLOOR_NO_BLOOD | d:HZX_FLOOR_NO_BULLETHOLE | d:HZX_FLOOR_NO_SPRAY ) \
			-seno 3 \
			-map Ｄ脚
	}

	proc ハッチ閉めチェック $:番号 {
		if ( $:番号 < 128 ) {
			// 初期値(0)の時は再セット
			eval( $f:再セットフラグ = d:TRUE );
		} else if ((( $w:グローバルロード回数 - $:番号 + 128 ) & 0x7f ) >= 3 ) {
			// ３ステージ分ロードがかかるとハッチを閉める
			eval( $f:再セットフラグ = d:TRUE );
		} else {
			eval( $f:再セットフラグ = d:FALSE );
		}
		return $f:再セットフラグ
	}
	proc １Ｆ西ハッチオープンカメラ $:スイッチ {
			chara カメラ設定 ビヨンドカメラ \
				-c 1 \
				-p -4825,-619,-109901 -t -10952,-4645,-113092 \
				-r 344,2759,0 -f 7996 \
				-a 222 \
				-i 0 0 0 0 \
				-s $:スイッチ
	}
	proc １Ｆ中央ハッチオープンカメラ $:スイッチ {
