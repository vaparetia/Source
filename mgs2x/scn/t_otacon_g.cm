*/

オタコン_003: {
Hol' Dir Deine noch heute!
}
//	<<<ENGLISH>>>
//	Better get yours today!

/*これはもう絶対に買い！だね！！*/

オタコン_004: {
Weitere Informationen unter
www.mcfarlane.com!
}
//	<<<ENGLISH(2)>>>
//	詳しくは 
//	Go to Mcfarlane Toys' web site
//	for more information!


/*
Go to www.mcfarlane.com for more information!
Go to www.spawn.com for more information!
*/
/*http://＃｛ＷＷＷ、ダブルダブルダブル｝＃＃｛．、ドット｝＃＃｛ＭＣＦＡＲＬＡＮＥ、マクファーレン｝＃＃｛．、ドット｝＃＃｛ＣＯＭ、コム｝＃
を見てくれ！
*/

スネーク_005: {
H,he, Hal! Mit wem zum
Teufel sprichst Du?
}
//	<<<ENGLISH>>>
//	H...hey, Hal! Who the hell are
//	you talking to!!?

/*オタコン。
……誰に言ってるんだ？
*/
//ne

}//d


