	// ------------------------------------
	// 敵兵や的の処理
	// ------------------------------------
	// 敵兵に関する設定
	//-------------------------------------
	proc 警備兵セット {
		#if d:DEBUG_PRINT 
			print 'watcher_set'
		#endif

		local $$:拡張ステータス;

		if ( $b:モード番号 == d:SNEAKING:SNEAKING ) {
			$$:拡張ステータス = 0;
		} else {
			$$:拡張ステータス = d:ENE_STST_FAINT_EXIT;
		}
		

		if ( $s:選択プレイヤー == ライデン || $s:選択プレイヤー == プリスキン || $s:選択プレイヤー == 刀ライデン ) {

			@VR_拡張警備兵 敵兵:01 d:E_R:雷電ゴール前Ｒ	 0 d:ENE_STATUS_NORMAL $$:拡張ステータス d:COMMON_STATUS
			@VR_拡張警備兵 敵兵:02 d:E_R:雷電北東Ｒ		 0 d:ENE_STATUS_NORMAL $$:拡張ステータス d:COMMON_STATUS
			@VR_拡張警備兵 敵兵:03 d:E_R:雷電中央２ＦＲ	 0 d:ENE_STATUS_NORMAL $$:拡張ステータス d:COMMON_STATUS
			@VR_拡張警備兵 敵兵:04 d:E_R:雷電中央１ＦＲ	 0 d:ENE_STATUS_NORMAL $$:拡張ステータス d:COMMON_STATUS
			@VR_拡張警備兵 敵兵:05 d:E_R:雷電南東Ｒ		 0 d:ENE_STATUS_NORMAL $$:拡張ステータス d:COMMON_STATUS

		} else if ( $s:選択プレイヤー == スネーク || $s:選択プレイヤー == タキシードスネーク ) {
			@VR_拡張警備兵 敵兵:01 d:E_R:スネークゴール前Ｒ	 0 d:ENE_STATUS_NORMAL $$:拡張ステータス d:COMMON_STATUS
			@VR_拡張警備兵 敵兵:02 d:E_R:スネーク北東Ｒ	 0 d:ENE_STATUS_NORMAL $$:拡張ステータス d:COMMON_STATUS
			@VR_拡張警備兵 敵兵:03 d:E_R:スネーク中央２ＦＲ	 0 d:ENE_STATUS_NORMAL $$:拡張ステータス d:COMMON_STATUS
			@VR_拡張警備兵 敵兵:04 d:E_R:スネーク中央１ＦＲ	 0 d:ENE_STATUS_NORMAL $$:拡張ステータス d:COMMON_STATUS
			@VR_拡張警備兵 敵兵:05 d:E_R:スネーク南東Ｒ		 0 d:ENE_STATUS_NORMAL $$:拡張ステータス d:COMMON_STATUS
			@VR_拡張警備兵 敵兵:06 d:E_R:スネーク西Ｒ		 0 d:ENE_STATUS_NORMAL $$:拡張ステータス d:COMMON_STATUS

		} else {
			// 前作スネーク
			@VR_拡張警備兵 敵兵:01 d:E_R:前作スネークゴール前Ｒ	 0 d:ENE_STATUS_NORMAL $$:拡張ステータス d:COMMON_STATUS
			@VR_拡張警備兵 敵兵:02 d:E_R:前作スネーク北東Ｒ		 0 d:ENE_STATUS_NORMAL $$:拡張ステータス d:COMMON_STATUS
			@VR_拡張警備兵 敵兵:03 d:E_R:前作スネーク中央２Ｆ定時連絡Ｒ	 0 d:ENE_STATUS_REPORT $$:拡張ステータス d:COMMON_STATUS
			@VR_拡張警備兵 敵兵:04 d:E_R:前作スネーク中央１ＦＲ	 0 d:ENE_STATUS_NORMAL $$:拡張ステータス d:COMMON_STATUS
			@VR_拡張警備兵 敵兵:05 d:E_R:前作スネーク南東Ｒ		 0 d:ENE_STATUS_NORMAL $$:拡張ステータス d:COMMON_STATUS
			@VR_拡張警備兵 敵兵:06 d:E_R:前作スネーク西Ｒ	 0 d:ENE_STATUS_NORMAL $$:拡張ステータス d:COMMON_STATUS
			@VR_拡張警備兵 敵兵:07 d:E_R:前作スネーク東Ｒ	 0 d:ENE_STATUS_NORMAL ( $$:拡張ステータス | d:ENE_STST_OPTCAMOUFLAGE ) d:COMMON_STATUS

		}
	}

	proc 攻撃兵セット {
		#if d:DEBUG_PRINT 
			print 'attacker_set'
		#endif

		if ( $s:選択プレイヤー == ライデン || $s:選択プレイヤー == プリスキン || $s:選択プレイヤー == 刀ライデン ) {

			@VR_探索攻撃兵 敵兵:21		 d:ATTACKER_COMMON_STATUS d:E_R:雷電西追加Ｒ
			@VR_サポート攻撃兵 敵兵:22	 d:ATTACKER_COMMON_STATUS 敵兵:03
			@VR_探索攻撃兵 敵兵:23		 d:ATTACKER_COMMON_STATUS d:E_R:雷電北東追加Ｒ

		} else if ( $s:選択プレイヤー == スネーク || $s:選択プレイヤー == タキシードスネーク ) {
			@VR_サポート攻撃兵 敵兵:21	 d:ATTACKER_COMMON_STATUS 敵兵:03
			@VR_サポート攻撃兵 敵兵:22	 d:ATTACKER_COMMON_STATUS 敵兵:01
			@VR_探索攻撃兵 敵兵:23		 d:ATTACKER_COMMON_STATUS d:E_R:スネークゴール前追加Ｒ

		} else {
			// 前作スネーク
			@VR_サポート攻撃兵 敵兵:21	 d:ATTACKER_COMMON_STATUS 敵兵:06
			@VR_探索攻撃兵 敵兵:22		 d:ATTACKER_COMMON_STATUS d:E_R:前作スネークゴール前追加Ｒ
			@VR_サポート攻撃兵 敵兵:23	 d:ATTACKER_COMMON_STATUS 敵兵:03
		}
	}

	proc 警備兵コマンダー {
		#if d:DEBUG_PRINT
			print 'wccomm_set'
		#endif

		chara 警備コマンダー wccomm -e { 警備兵セット }
	}

	proc 攻撃兵コマンダー {
		#if d:DEBUG_PRINT
			print 'atcomm_set'
		#endif

		chara 攻撃コマンダー atcomm -e { 攻撃兵セット }
	}

	proc コマンダー設定 {
		#if d:DEBUG_PRINT
			print 'commander_set'
		#endif

		chara コマンダー 敵兵セット \
			-w 警備兵コマンダー \
			-a 攻撃兵コマンダー \
			-d スニーキング１０面 \
			-r d:GOAL_POS_VS10A スニーキング１０面 \
			-c d:GOAL_POS_VS10A スニーキング１０面 \
			-v [ene_vr_voice:01] \
			-z $i:敵標準麻酔持続 \
			-h $i:標準警戒時間 \
			-o $i:敵標準気絶持続 \
			-f	d:E_R:前作スネーク中央２Ｆ定時連絡Ｒ 1 t:vc044023 t:vc044023_len \
			-s (d:ENE_STAGE_GPS | d:ENE_STAGE_VR_ANOTHER) \
			-b 0 \
			-m d:ALERT_MODE_SENNYU
	}

	// ------------------------------------
	// 監視カメラ
	// ------------------------------------
	proc 監視カメラ破壊時処理 $:名前 $:フラグ {
	}
	proc 監視カメラ設置 {
		#if d:DEBUG_PRINT
			print 'svc_camera'
		#endif

		// 標準のカメラ
		@A_監視カメラ 中央カメラ 0 2700 6125 500 3072 3072 512 0
		@A_監視カメラ 落とし穴カメラ01 -9000 5700 -10000 500 1024 512 512 0

		// 雷電以外で追加するカメラ
		if ( $s:選択プレイヤー == スネーク || \
			 $s:選択プレイヤー == プリスキン || \
			 $s:選択プレイヤー == タキシードスネーク || \
			 $s:選択プレイヤー == 刀ライデン || \
			 $s:選択プレイヤー == 前作スネーク ) {
			
			@A_監視カメラ 南カメラ 0 2700 9500 500 3072 3584 512 0
			@A_監視カメラ 落とし穴カメラ02 -7000 5700 -6000 500 3072 2560 512 0
		}
		
		// プリスキン以降出てくるカメラ
		if ( $s:選択プレイヤー == プリスキン || \
			 $s:選択プレイヤー == タキシードスネーク || \
			 $s:選択プレイヤー == 刀ライデン || \
			 $s:選択プレイヤー == 前作スネーク ) {
			
			@A_監視カメラ 北カメラ 2500 3500 -14000 500 0 0 800 0
			@A_監視カメラ 北側中央カメラ 1000 2700 -6500 500 3072 3072 512 0
		}

		// 前作スネークで追加されるカメラ
		if ( $s:選択プレイヤー == 前作スネーク ) {
			
			@A_監視カメラ 東カメラ 7000 2700 3500 500 3072 3072 512 0
			@A_監視カメラ 北西カメラ -6000 3700 -12500 600 1024 1280 768 0
		}
	}


	// ------------------------------------
	// ＢＧＭの設定
	// ------------------------------------
	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT 
			print 'bgm_set'
		#endif

		chara ＢＧＭマネージャー ＢＧＭマネ
	}


	// ------------------------------------
	// アイテムの設定
	// ------------------------------------
	// 再発生が必要な時は以下のプロックの中を記述する
	// ------------------------------------
	proc アイテム取得時番号設定 $:ボックス名 {
		#if d:DEBUG_PRINT
			print 'item_no_set'
		#endif
	}
	// アイテムの設置
	// ------------------------------------
	proc アイテム設定 {
		#if d:DEBUG_PRINT 
			print 'item_set'
		#endif

		if ( $b:モード番号 == d:SNEAKING:SNEAKING ) {
			switch ( $s:選択プレイヤー ) {
				case ( ライデン ) {
					@A_Ｍ９_初期設置 Ｍ９本体 d:ITEM_POS_01 0 なし 16
					@A_ソコム_初期設置 ソコム本体 d:ITEM_POS_04 0 なし 25
					@A_ＰＳＧ１_初期設置 ＰＳＧ１本体 d:ITEM_POS_14 0 なし 11
					@A_ＰＳＧ１−Ｔ_初期設置 ＰＳＧ１−Ｔ本体 d:ITEM_POS_15 0 なし 11
					@A_チャフ_初期設置 チャフ d:ITEM_POS_02 0 5
					@A_雑誌_初期設置 雑誌 d:ITEM_POS_11 0 1
					@ジアゼパム_初期設置 ジアゼパム d:ITEM_POS_13 0
					@ダンボール_初期設置 ダンボールＡ d:ITEM_POS_16 0 25
					@ソコムサプレッサ_初期設置 ソコムサプレッサ d:ITEM_POS_09 0
				}
				case ( スネーク ) {
					@A_Ｍ９_初期設置 Ｍ９本体 d:ITEM_POS_09 0 なし 6
					@A_ＵＳＰ_初期設置 ＵＳＰ本体 d:ITEM_POS_03 0 なし 16
					@A_ＰＳＧ１_初期設置 ＰＳＧ１本体 d:ITEM_POS_14 0 なし 11
					@A_ＰＳＧ１−Ｔ_初期設置 ＰＳＧ１−Ｔ本体 d:ITEM_POS_15 0 なし 6
					@A_チャフ_初期設置 チャフ d:ITEM_POS_01 0 5
					@A_雑誌_初期設置 雑誌 d:ITEM_POS_06 0 1
					@ジアゼパム_初期設置 ジアゼパム d:ITEM_POS_16 0
					@ダンボールＢ_初期設置 ダンボールＢ d:ITEM_POS_05 0 25
					@ＵＳＰサプレッサ_初期設置 ＵＳＰサプレッサ d:ITEM_POS_02 0
				}
				case ( プリスキン ) {
					@A_Ｍ９_初期設置 Ｍ９本体 d:ITEM_POS_17 0 なし 6
					@A_ＰＳＧ１−Ｔ_初期設置 ＰＳＧ１−Ｔ本体 d:ITEM_POS_14 0 なし 6
					@A_雑誌_初期設置 雑誌 d:ITEM_POS_10 0 1
					@ジアゼパム_初期設置 ジアゼパム d:ITEM_POS_13 0
					@ダンボールＣ_初期設置 ダンボールＣ d:ITEM_POS_16 0 25
				}
				case ( タキシードスネーク ) {
					@A_ＵＳＰ_初期設置 ＵＳＰ本体 d:ITEM_POS_15 0 なし 16
					@A_チャフ_初期設置 チャフ d:ITEM_POS_07 0 2
					@A_雑誌_初期設置 雑誌 d:ITEM_POS_02 0 1
					@ダンボールＤ_初期設置 ダンボールＤ d:ITEM_POS_16 0 25
					@ＵＳＰサプレッサ_初期設置 ＵＳＰサプレッサ d:ITEM_POS_01 0
				}
				case ( 刀ライデン ) {
				}
				default {
					// 前作スネーク
					@A_Ｍ９_初期設置 Ｍ９本体 d:ITEM_POS_08 0 なし 6
					@弾薬_Ｍ９_初期設置 Ｍ９弾 d:ITEM_POS_01 0
					@A_ＵＳＰ_初期設置 ＵＳＰ本体 d:ITEM_POS_03 0 なし 0
					@弾薬_ＵＳＰ_初期設置 ＵＳＰ弾 d:ITEM_POS_05 0
					@A_ＰＳＧ１−Ｔ_初期設置 ＰＳＧ１−Ｔ本体 d:ITEM_POS_15 0 なし 6
					@A_チャフ_初期設置 チャフ d:ITEM_POS_02 0 2
					@A_雑誌_初期設置 雑誌 d:ITEM_POS_11 0 1
					@ダンボールＥ_初期設置 ダンボールＥ d:ITEM_POS_17 0 25
					@ＵＳＰサプレッサ_初期設置 ＵＳＰサプレッサ d:ITEM_POS_13 0
				}
			}
		} else {
			switch ( $s:選択プレイヤー ) {
				case ( ライデン ) {
					@A_Ｍ９_初期設置 Ｍ９本体 d:ITEM_POS_05 0 なし 16
					@弾薬_Ｍ９_初期設置 Ｍ９弾 d:ITEM_POS_03 0
					@弾薬_ソコム_初期設置 ソコム弾 d:ITEM_POS_18 0
					@A_ＰＳＧ１_初期設置 ＰＳＧ１本体 d:ITEM_POS_19 0 なし 11
					@A_ＰＳＧ１−Ｔ_初期設置 ＰＳＧ１−Ｔ本体 d:ITEM_POS_14 0 なし 11
					@A_チャフ_初期設置 チャフ d:ITEM_POS_04 0 5
					@A_雑誌_初期設置 雑誌 d:ITEM_POS_08 0 1
					@ジアゼパム_初期設置 ジアゼパム d:ITEM_POS_01 0
					@ダンボール_初期設置 ダンボールＡ d:ITEM_POS_06 0 25
				}
				case ( スネーク ) {
					@A_Ｍ９_初期設置 Ｍ９本体 d:ITEM_POS_01 0 なし 6
					@弾薬_Ｍ９_初期設置 Ｍ９弾 d:ITEM_POS_13 0
					@弾薬_ＵＳＰ_初期設置 ＵＳＰ弾 d:ITEM_POS_02 0
					@A_ＰＳＧ１_初期設置 ＰＳＧ１本体 d:ITEM_POS_15 0 なし 11
					@A_ＰＳＧ１−Ｔ_初期設置 ＰＳＧ１−Ｔ本体 d:ITEM_POS_14 0 なし 6
					@A_チャフ_初期設置 チャフ d:ITEM_POS_12 0 5
					@A_雑誌_初期設置 雑誌 d:ITEM_POS_08 0 1
					@ジアゼパム_初期設置 ジアゼパム d:ITEM_POS_16 0
					@ダンボールＢ_初期設置 ダンボールＢ d:ITEM_POS_09 0 25
				}
				case ( プリスキン ) {
					@A_Ｍ９_初期設置 Ｍ９本体 d:ITEM_POS_07 0 なし 6
					@弾薬_ＵＳＰ_初期設置 ＵＳＰ弾 d:ITEM_POS_08 0
					@A_ＰＳＧ１−Ｔ_初期設置 ＰＳＧ１−Ｔ本体 d:ITEM_POS_15 0 なし 6
					@A_雑誌_初期設置 雑誌 d:ITEM_POS_01 0 1
					@ジアゼパム_初期設置 ジアゼパム d:ITEM_POS_09 0
					@ダンボールＣ_初期設置 ダンボールＣ d:ITEM_POS_16 0 25
				}
				case ( タキシードスネーク ) {
					@A_ＵＳＰ_初期設置 ＵＳＰ本体 d:ITEM_POS_12 0 なし 16
					@A_チャフ_初期設置 チャフ d:ITEM_POS_01 0 5
					@A_雑誌_初期設置 雑誌 d:ITEM_POS_09 0 1
					@ダンボールＤ_初期設置 ダンボールＤ d:ITEM_POS_17 0 25
					@ＵＳＰサプレッサ_初期設置 ＵＳＰサプレッサ d:ITEM_POS_08 0
				}
				case ( 刀ライデン ) {
				}
				default {
					// 前作スネーク
					@A_Ｍ９_初期設置 Ｍ９本体 d:ITEM_POS_01 0 なし 6
					@弾薬_Ｍ９_初期設置 Ｍ９弾 d:ITEM_POS_17 0
					@A_ＵＳＰ_初期設置 ＵＳＰ本体 d:ITEM_POS_12 0 なし 0
					@弾薬_ＵＳＰ_初期設置 ＵＳＰ弾 d:ITEM_POS_07 0
					@A_チャフ_初期設置 チャフ d:ITEM_POS_02 0 2
					@A_雑誌_初期設置 雑誌 d:ITEM_POS_11 0 1
					@ダンボールＥ_初期設置 ダンボールＥ d:ITEM_POS_08 0 25
					@ＵＳＰサプレッサ_初期設置 ＵＳＰサプレッサ d:ITEM_POS_15 0
				}
			}
		}
	}



	// ------------------------------------
	// その他オブジェクト関係
	// ------------------------------------
	// ------------------------------------
	// ロッカー
	// ------------------------------------
	proc ロッカー管理人設置 {
		#if d:DEBUG_PRINT
			print 'locker_set'
		#endif

		chara ロッカー管理 管理人さん -n 4
		command ロッカーモーション -motion locker
		command プレイヤーロッカーモーション -motion sna_locker
	}
	proc ロッカー設置 {
		#if d:DEBUG_PRINT
			print 'locker_set'
		#endif

		// 西側上
		chara ロッカー ロッカー01 \
			-kms vr2_locker_door \
			-p -7000,0,5950 \
			-r 0,3072,0 \
			-down_rot 0,3000,0 \
			-down_shift 125,0,0 \
			-s d:LOCKER_STATE_CLOSE \
			-seno d:SD_LOCKER_HZD \
			-sefloor d:SD_LOCKER_FLR \
			-exec {
			}
		trap lk001 d:PLAYER \
			-and \
			-mask いる \
			-state 0,4 \
			-dir 1024,512 3072,512 \
			-key d:PAD_ACTION,-1 \				//アクションボタン
			-exec {
				mesg プレイヤー d:PLAYER locker ロッカー01 $status 1024,512 -7000,5950
			}
		trap lk001 d:PLAYER \
			-mask ？ \
			-state 6 \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p -11271,4852,8876 -t -8446,1603,5944 \
					-r 439,1548,0 -f 5209 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3
			}

		// 西側下
		chara ロッカー ロッカー02 \
			-kms vr2_locker_door \
			-p -7000,0,6950 \
			-r 0,3072,0 \
			-down_rot 0,3000,0 \
			-down_shift 125,0,0 \
			-s d:LOCKER_STATE_CLOSE \
			-seno d:SD_LOCKER_HZD \
			-sefloor d:SD_LOCKER_FLR \
			-exec {
			}
		trap lk002 d:PLAYER \
			-and \
			-mask いる \
			-state 0,4 \
			-dir 1024,512 3072,512 \
			-key d:PAD_ACTION,-1 \				//アクションボタン
			-exec {
