// ------------------------------------
// マップ設定
// ------------------------------------
chara マップ スニーキング１０面 -k d:KMS_NAME -h d:HZX_NAME,0 -l $s:ＶＲライトファイル名

command マップ設定 スニーキング１０面 -set {
	// ローカルの初期化
	// ------------------------------------
	@ローカル変数初期化		// ローカルで使用する変数で初期化をする場合はここで

	// 設定値を変更する場合は以下のプロック内で設定
	// ------------------------------------
	@設定値変更				// 敵兵や的のパラメータをステージ限定で変える時はここで

	// ＶＲで必要な基本プロックのセット(vr_common.hで定義)
	// サウンドの基本パック、ＶＲの基本システム、プレイヤー、ゴール等を設定します
	// ※このプロックを使用する時は「ＶＲクリア時処理」というプロックが必要です
	// ＶＲ共通プロックセット	$:スネークファイル $:雷電ファイル $:クリア条件フラグ
	//							$:ゴールＸ $:ゴールＹ $:ゴールＺ $:タイマー初期値
	//	VR_GOAL_TARGET	/*的全滅でゴールが開く*/
	//	VR_GOAL_FREE	/*ゴールが最初から開いてる*/
	//	VR_GOAL_ENEMY	/*敵全滅でゴールが開く*/
	//	VR_GOAL_SNEAK	/*潜入モード中はゴールが開く*/
	//	VR_GOAL_TIME	/*タイマーがゼロになるとゴールが開く*/
	// ------------------------------------
	if ( $b:モード番号 == d:SNEAKING:SNEAKING ) {
		@ＶＲ共通プロックセット sna_vs10a rai_vs10a d:VR_GOAL_FREE d:GOAL_POS_VS10A
	} else {
		@ＶＲ共通プロックセット sna_vs10a rai_vs10a d:VR_GOAL_SCN d:GOAL_POS_VS10A
	}

	// ＶＲウィンドウの設定
	// ------------------------------------
	@スニーキング１０面ＶＲウィンドウ設定

	// クリア時に呼ばれるものの設定
	// ------------------------------------
	@ＶＲクリア設定 p:A_ミッションエンド p:A_ＲＥＴＲＹプロック

	// ステージに引かれるライン
	// ------------------------------------
	@ＶＲアウトライン d:KMS_NAME d:TONBO_KMS_NAME d:LINE_KMS_NAME

	// プレイヤーの設定
	// ------------------------------------
	@プラグイン設定			// プレイヤーのプラグインがいる時はここで
	@ジャンプ設定
	@エルード設定

	// 敵兵・的関係の設定
	// ------------------------------------
	@コマンダー設定
	@監視カメラ設置

	// ＢＧＭの設定(プレイヤー→敵兵→BGMの順で呼ぶ)
	// ------------------------------------
	@ＢＧＭ設定

	// アイテムの設定
	// ------------------------------------
	@アイテム設定

	// 光源、オブジェクト、カメラ関連の設定
	// ------------------------------------
	@ロッカー管理人設置
	@ロッカー設置
	@落とし穴設置
	@水溜りエフェクト設置
	@ＶＲフォグ設定 d:VR_FOG:朝Ｎ d:VR_FOG:朝Ｆ -5000 55000 -10000 40000
	@カメラセット					// chara カメラとベースのカメラを設定
	@スニーキング１０面カメラ設定		// ステージ固有のカメラ設定がいる時はこのプロックで
	@ＶＲキャラ用ライト設置				// 必ず最後に設定
#if d:DEBUG_CHARA
	@デバッグキャラセット
#endif
}

//初期マップの表示
command マップ表示 -show スニーキング１０面


// 各proc設定
//-------------------------------------------------------------------------------------
// 全マップ共通
	//------------------------------------------------------------
	// ＶＲウィンドウの設定と表示
	//------------------------------------------------------------
	proc スニーキング１０面ＶＲウィンドウ設定 {
		#if d:DEBUG_PRINT
			print 'vr_window_set'
		#endif

		if ( $b:モード番号 == d:SNEAKING:SNEAKING ) {
			@ＶＲウィンドウ設定	d:VS10A_SNK_WINDOW_RES
		} else {
			@ＶＲウィンドウ設定	d:VS10A_ELM_WINDOW_RES
		}

		// ＶＲウィンドウを表示する
		mesg ＶＲウィンドウ ＶＲウィンドウ君 開く

		// スタート時とクリア時に使用するカットインカメラ
		chara カメラ カットインカメラ		-c 0 -l 0 -p  0

		// スタート時のカメラ(必要な場合)
		chara カメラ設定 カットインカメラ \
			-c 1 \	
			-p -40,9352,-7898 -t -40,2666,-12730 \
			-r 616,2048,0 -f 8249 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1
	}

	//------------------------------------------------------------
	// ステージ開始時処理
	//------------------------------------------------------------
	proc ＶＲステージ開始時処理 {
		#if d:DEBUG_PRINT
			print 'game_start!!!!!'
		#endif

		// プレイヤーやパッドの制御等を行う a_stdproc.hで定義
		@全ミッション共通ステージ開始時処理

		// カメラワークスタート(必要な場合)
		// 全体図
		chara カメラ設定 カットインカメラ \
			-c 1 \	
			-p -40,26000,24315 -t -40,19678,19029 \
			-r 570,2048,0 -f 8241 \
			-a 200 \
			-i 4 4 d:START_CAMERA_CHANGE_TIME d:START_CAMERA_CHANGE_TIME \
			-s 1

		chara delay ディレイ \
			-time d:START_CAMERA_CHANGE_TIME \
			-exec {
				chara カメラ設定 カットインカメラ -s -1
			}
	}

	// ------------------------------------
	// クリア時の処理
	// ------------------------------------
	proc ＶＲクリア時処理 {
		#if d:DEBUG_PRINT 
			print 'clear'
		#endif

		// 強制モーションを発動
		@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_2 0

		// クリア時にカメラアングルを変える
		chara カメラ設定 クリア時カメラ \
			-c 1 \	
			-p -120,2026,-8222 -t -120,2367,-13635 \
			-r -41,2048,0 -f 5423 \
			-a 200 \
			-i 1 0 0 0 \
			-s 1
	}



	// ------------------------------------
	// パラメータ系の変更
	// ------------------------------------
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT 
			print 'localvar_init'
		#endif
	}
	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT 
			print 'status_set'
		#endif

		@スニーキング用キャラ別標準装備設定 25 6 16 6

		// 初期装備の追加設定
		if ( $b:モード番号 == d:SNEAKING:SNEAKING ) {
			switch ( $s:選択プレイヤー ) {
				case ( ライデン ) {
					$w:武器弾数Ｒ[ d:武器:マガジン ] = 10;
					$w:武器 = d:武器:マガジン;
				}
				case ( スネーク ) {
					$w:武器弾数Ｒ[ d:武器:マガジン ] = 10;
					$w:武器 = d:武器:マガジン;
				}
				case ( プリスキン ) {
					$w:武器弾数Ｒ[ d:武器:マガジン ] = 5;
				}
				case ( タキシードスネーク ) {
					$w:武器弾数Ｒ[ d:武器:マガジン ] = 5;
				}
				case ( 刀ライデン ) {
				}
				default {
					// 前作スネーク
					$w:武器弾数Ｒ[ d:武器:マガジン ] = 3;
					$w:武器 = d:武器:マガジン;
				}
			}

		} else {
			// ELM_ALLの時
			switch ( $s:選択プレイヤー ) {
				case ( ライデン ) {
					$w:武器弾数Ｒ[ d:武器:マガジン ] = 10;
				}
				case ( スネーク ) {
					$w:武器弾数Ｒ[ d:武器:マガジン ] = 10;
				}
				case ( プリスキン ) {
					$w:武器弾数Ｒ[ d:武器:マガジン ] = 5;
				}
				case ( タキシードスネーク ) {
					$w:武器弾数Ｒ[ d:武器:マガジン ] = 5;
				}
				case ( 刀ライデン ) {
				}
				default {
					// 前作スネーク
					$w:武器弾数Ｒ[ d:武器:マガジン ] = 3;
				}
			}
		}
	}



	// ------------------------------------
	// プレイヤーに関する設定
	//-------------------------------------
	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif

		command プラグイン自動ジャンプ
		command プラグイン落下
	}
	//-------------------------------------
	// 台登り
	// ------------------------------------
	proc ジャンプ設定 {
		#if d:DEBUG_PRINT
			print 'jump_set'
		#endif

		trap ky001 d:PLAYER \
			-mask 入る \
			-exec {
				@ジャンプ発動 ky001 1000 10
			}
	}
	//-------------------------------------
	// エルード
	// ------------------------------------
	proc エルード設定 {
		#if d:DEBUG_PRINT
			print 'beyond_set'
		#endif

		// 南向きのエルード
		//---------------------------------
		// 一番南
		trap by001 d:PLAYER \
			-mask いる \
			-key d:PAD_ACTION \	//アクションボタン
			-state 0,4 \		//立ち状態or張り付き
			-exec {
				@南向きビヨンド発動 by001 13000 $4 -6750 -3250 0x00000002
			}
		trap by001 d:PLAYER \
			-mask いる \
			-state 6 \
			-dir 0 256 \	//方向指定
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 582,1941,0 -f 6520 \
					-a 200 \
					-i 0 -1 0 0 \
					-s 1
			}
		trap by001 d:PLAYER \
			-mask ？ \
			-state 5 \
			-dir 2048 256 \	//方向指定
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 92,1984,0 -f 7108 \
					-a 250 \
					-i 3 2 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// 橋左側の南側
		trap by002 d:PLAYER \
			-mask いる \
			-key d:PAD_ACTION \	//アクションボタン
			-state 0,4 \		//立ち状態or張り付き
			-exec {
				@南向きビヨンド発動 by002 3000 $4 -2750 3750 0x00000002
			}
		trap by002 d:PLAYER \
			-mask いる \
			-state 6 \
			-dir 0 256 \	//方向指定
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,5000 \
					-l d:CAM_MIN,d:CAM_MIN,3000 d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 669,2277,0 -f 6147 \
					-a 200 \
					-i 0 -1 0 0 \
					-s 1
			}
		trap by002 d:PLAYER \
			-mask ？ \
			-state 5 \
			-dir 2048 256 \	//方向指定
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 423,2237,0 -f 3668 \
					-a 200 \
					-i 3 2 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// 橋の南側
		trap by003 d:PLAYER \
