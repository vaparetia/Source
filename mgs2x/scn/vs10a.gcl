#define	ITEM_POS_05		 -500,	 0,		 14500	// 南の荷物の影
#define	ITEM_POS_06		 5500,	 3000,	 10500	// 南東くぼみ左
#define	ITEM_POS_07		 8500,	 3000,	 9500	// 南東くぼみ右
