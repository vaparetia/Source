	// ------------------------------------
	// 落とし穴
	// ------------------------------------
	proc 落とし穴設置 {
		#if d:DEBUG_PRINT
			print 'pitfall_set'
		#endif

		command foreach -argc 3 -repeat 4 \
			-data { \
					{ 落とし穴:01, -8000, -10000 } \
					{ 落とし穴:02, -8000, -8000 } \
					{ 落とし穴:03, -8000, -6000 } \
					{ 落とし穴:04, -8000, -4000 } \
				} \
				-exec { \
					chara ＶＲ落とし穴 $1 \
						-position $2, 3000, $3 \
						-rotate 0,0,0 \
						-map スニーキング１０面 \
						-model vr2_pitfall_a0 vr2_pitfall_a0 \
						-hazard	($2-1000), 3000, ($3-1000) \	/*min maz の2点指定 */
								($2+1000), 3000, ($3+1000) \
						-fall_time 40 \
						-fall_pattern 7 \
						-status 0 \
						-proc 落し穴落下時処理
				}
	}

	proc 落し穴落下時処理 {
		#if d:DEBUG_PRINT
			print 'pitfall_gameover'
		#endif

		if ( $1 == 落とし穴:01 ) {
			mesg プレイヤー d:PLAYER position -8000,$i:プレイヤー位置Ｙ,-10000
			@ジャンプ落下死発動 0x0004 -100
			mesg ＶＲ落とし穴 落とし穴:01 fall
		} else if ( $1 == 落とし穴:02 ) {
			mesg プレイヤー d:PLAYER position -8000,$i:プレイヤー位置Ｙ,-8000
			@ジャンプ落下死発動 0x0004 -100
			mesg ＶＲ落とし穴 落とし穴:02 fall
		} else if ( $1 == 落とし穴:03 ) {
			mesg プレイヤー d:PLAYER position -8000,$i:プレイヤー位置Ｙ,-6000
			@ジャンプ落下死発動 0x0004 -100
			mesg ＶＲ落とし穴 落とし穴:03 fall
		} else if ( $1 == 落とし穴:04 ) {
			mesg プレイヤー d:PLAYER position -8000,$i:プレイヤー位置Ｙ,-4000
			@ジャンプ落下死発動 0x0004 -100
			mesg ＶＲ落とし穴 落とし穴:04 fall
		}
	}

	// ジャンプ落下死発動から呼ばれるプロック
	proc ジャンプ落下死開始処理 {
		#if d:DEBUG_PRINT
			print 'jump_gameover_start'
		#endif

		chara カメラ設定 クリア時カメラ \
			-c 0 \
			-b -7755,7115,d:CAM_MIN -7755,7115,-3000 \
			-l -7898,4301,d:CAM_MIN -7898,4301,-4000 \
			-r 793,2138,0 -f 3000 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1

		@ゲームオーバー開始処理
	}

	// 最終的に落ちたときに呼ばれるプロック（サウンドや振動を呼ぶ）
	proc ゲームオーバー終了処理 {
	}


	// ------------------------------------
	// 水溜りエフェクト
	// ------------------------------------
	proc 水溜りエフェクト設置 {
		#if d:DEBUG_PRINT
			print 'ripple_set'
		#endif

		command foreach -argc 2 -repeat 12 \
			-data { \
					{ -5500, -7500 } \
					{ -4500, -7500 } \
					{ -1500, -6500 } \
					{ -500, -6500 } \
					{ 3500, -10500 } \
					{ 4500, -10500 } \
					{ 4500, -4500 } \
					{ 4500, -5500 } \
					{ 8500, -10500 } \
					{ 9500, -10500 } \
					{ 8500, -9500 } \
					{ 9500, -9500 } \
				} \
				-exec { \
					chara ＶＲ床パネル ＶＲ床パネル -pos $1 0 $2
				}
	}


	// ------------------------------------
	// カメラ関係の設定 
	// ------------------------------------
	// ステージカメラ設定 
	// ------------------------------------
	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'chara_camera & stage_camera_set'
		#endif

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0 
		chara カメラ メインカメラ		-c 0 -l 2 -p 40
		chara カメラ サブカメラ			-c 0 -l 2 -p 30
		chara カメラ サブカメラ２		-c 0 -l 2 -p 20
		chara カメラ モーションカメラ	-c 0 -l 2 -p 10 
		chara カメラ クリア時カメラ		-c 0 -l 0 -p 1

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \	
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 740,2048,0 \
			-f 9000 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}
	// ステージ固有のカメラ設定 
	// ------------------------------------
	proc スニーキング１０面カメラ設定 {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif

		//---------------------
		// 通常のステージカメラ
		//---------------------
		// １Ｆ南側のベースとなるカメラ
		trap ca001 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ降順 $6 11000 4000 600 475
				eval( $i:補完ＲＸ = $i:CS_結果１ );

				chara カメラ設定 メインカメラ \
					-c 0 \	
					-b -8500,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,17818 \
					-l -8500,1500,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,12822 \
					-r $i:補完ＲＸ,2048,0 \
					-f 8250 \
					-a 200 \
					-i 2 2 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// １Ｆ中央部の東西通路のカメラ
		trap ca002 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ昇順 $4 1000 3000 8573 7506
				eval( $i:補完ＢＺ = $i:CS_結果１ );
				@CS_スムーズカメラ昇順 $4 1000 3000 4870 4683
				eval( $i:補完ＬＺ = $i:CS_結果１ );
				@CS_スムーズカメラ昇順 $4 1000 3000 740 816
				eval( $i:補完ＲＸ = $i:CS_結果１ );

				chara カメラ設定 サブカメラ \
					-c 0 \	
					-b -8500,d:CAM_MIN,$i:補完ＢＺ 6500,d:CAM_MAX,$i:補完ＢＺ \
					-l -8500,1500,$i:補完ＬＺ 6500,d:CAM_MAX,$i:補完ＬＺ \
					-r $i:補完ＲＸ,2048,0 \
					-f 9000 \
					-a 200 \
					-i 2 2 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// １Ｆ中央部の東のエルード落下したところのカメラ
		trap ca003 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ昇順 $4 1000 3000 8573 7506
				eval( $i:補完ＢＺ = $i:CS_結果１ );
				@CS_スムーズカメラ昇順 $4 1000 3000 4870 4683
				eval( $i:補完ＬＺ = $i:CS_結果１ );
				@CS_スムーズカメラ昇順 $4 1000 3000 740 816
				eval( $i:補完ＲＸ = $i:CS_結果１ );

				chara カメラ設定 メインカメラ \
					-c 0 \	
					-b -8500,d:CAM_MIN,$i:補完ＢＺ 6500,d:CAM_MAX,$i:補完ＢＺ \
					-l -8500,1500,$i:補完ＬＺ 6500,d:CAM_MAX,$i:補完ＬＺ \
					-r $i:補完ＲＸ,2048,0 \
					-f 9000 \
					-a 200 \
					-i 2 2 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// １Ｆ北側のベースとなるカメラ
		trap ca011 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ降順 $6 -3000 -5000 850 650
				eval( $i:補完ＲＸ = $i:CS_結果１ );

				chara カメラ設定 メインカメラ \
					-c 0 \	
					-b -7000,8700,-8009 8000,d:CAM_MAX,-3293 \
					-l -7000,1500,-12682 8000,d:CAM_MAX,-5546 \
					-r $i:補完ＲＸ,2048,0 \
					-f 8500 \
					-a 200 \
					-z d:CAMERA_NO_CUSHION \
					-i 2 -1 0 0 \
					-s $3
			}

		// １Ｆ北側南西部のカメラ
		trap ca012 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ降順 $6 -5000 -10000 850 715
				eval( $i:補完ＲＸ = $i:CS_結果１ );

				chara カメラ設定 メインカメラ \
					-c 0 \	
					-b -4500,d:CAM_MIN,-8009 8000,d:CAM_MAX,-4747 \
					-l -4500,1500,-12682 8000,d:CAM_MAX,-7002 \
					-r $i:補完ＲＸ,2048,0 \
					-f 8500 \
					-a 200 \
					-i 2 2 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// １Ｆ北側北西部のカメラ
		trap ca013 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ降順 $4 -1000 -2000 650 715
				eval( $i:補完ＲＸ = $i:CS_結果１ );

				chara カメラ設定 メインカメラ \
					-c 0 \	
					-b -4500,d:CAM_MIN,-9051 8000,d:CAM_MAX,-4570 \
					-l -4500,1500,-12709 8000,d:CAM_MAX,-6982 \
					-r $i:補完ＲＸ,2048,0 \
					-f 8500 \
					-a 200 \
					-i 2 2 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}
		
		// １Ｆ北側北東部のカメラ
		trap ca014 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ降順 $4 8000 6000 650 850
				eval( $i:補完ＲＸ = $i:CS_結果１ );

				chara カメラ設定 メインカメラ \
					-c 0 \	
					-b -7000,8700,-11257 8000,d:CAM_MAX,-3293 \
					-l -7000,1500,-13474 8000,d:CAM_MAX,-5546 \
					-r $i:補完ＲＸ,2048,0 \
					-f 8500 \
					-a 200 \
					-i 3 3 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// ２Ｆ南側西側から橋前までのカメラ
		trap ca101 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ昇順 $6 10000 11000 525 625
				eval( $i:補完ＲＸ = $i:CS_結果１ );

				chara カメラ設定 メインカメラ \
					-c 0 \	
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,4500,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r $i:補完ＲＸ,2048,0 \
					-f 8500 \
					-a 200 \
					-i 2 2 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// ２Ｆ橋から西側のカメラ
		trap ca102 d:PLAYER \
