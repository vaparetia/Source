				@西向きビヨンド発動 by033 -7000 $6 -750 750 0x00000002
			}
		trap by034 d:PLAYER \
			-mask いる \
			-state 6 \
			-dir 3072 256 \	//方向指定
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 677,1736,0 -f 6175 \
					-a 200 \
					-i 0 -1 0 0 \
					-s 1
			}
		trap by034 d:PLAYER \
			-mask ？ \
			-state 5 \
			-dir 1024 256 \	//方向指定
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 520,1578,0 -f 7090 \
					-a 225 \
					-i 3 2 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// 西側階段上の踊り場
		trap by035 d:PLAYER \
			-mask いる \
			-key d:PAD_ACTION \	//アクションボタン
			-state 0,4 \		//立ち状態or張り付き
			-exec {
				@西向きビヨンド発動 by035 -8000 $6 2250 3750 ( d:BY_FALL_IMMEDIATELY | d:BY_NOFOOTSHADOW | d:BY_NO_STAMP )
			}
		trap by035 d:PLAYER \
			-mask いる \
			-state 6 \
			-dir 3072 256 \	//方向指定
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,4443,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,2714,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 187,1367,0 -f 6175 \
					-a 200 \
					-i 0 -1 0 0 \
					-s 1
			}
		trap by035 d:PLAYER \
			-mask ？ \
			-state 5 \
			-dir 1024 256 \	//方向指定
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 422,1558,0 -f 6175 \
					-a 230 \
					-i 3 2 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3
			}

		// 西側階段下の踊り場
		trap by036 d:PLAYER \
			-mask いる \
			-key d:PAD_ACTION \	//アクションボタン
			-state 0,4 \		//立ち状態or張り付き
			-exec {
				@西向きビヨンド発動 by036 -8000 $6 8250 9750 ( d:BY_FALL_IMMEDIATELY | d:BY_NOFOOTSHADOW | d:BY_NO_STAMP )
			}
		trap by036 d:PLAYER \
			-mask いる \
			-state 6 \
			-dir 3072 256 \	//方向指定
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 0 \
					-b d:CAM_MIN,3788,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,2659,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-r 120,1373,0 -f 6173 \
					-a 200 \
					-i 0 -1 0 0 \
					-s 1
			}
		trap by036 d:PLAYER \
			-mask ？ \
			-state 5 \
			-dir 1024 256 \	//方向指定
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
