							 [VRMSG_F:VRM_SNK_ELM_vs10a] [VRMSG_I:VRM_SNK_ELM_vs10a] [VRMSG_S:VRM_SNK_ELM_vs10a] \	// 仏、伊、西
							 [VRMSG_K:VRM_SNK_ELM_vs10a] \															// 韓
							 p:ＶＲステージ開始時処理		// 終了プロック


