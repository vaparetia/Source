			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p -11280,4685,9646 -t -8464,1416,6723 \
					-r 442,1548,0 -f 5211 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3
			}

		// 東側上
		chara ロッカー ロッカー03 \
			-kms vr2_locker_door \
			-p 3000,0,10950 \
			-r 0,3072,0 \
			-down_rot 0,3000,0 \
			-down_shift 125,0,0 \
			-s d:LOCKER_STATE_CLOSE \
			-seno d:SD_LOCKER_HZD \
			-sefloor d:SD_LOCKER_FLR \
			-exec {
			}
		trap lk003 d:PLAYER \
			-and \
			-mask いる \
			-state 0,4 \
			-dir 1024,512 3072,512 \
			-key d:PAD_ACTION,-1 \				//アクションボタン
			-exec {
				mesg プレイヤー d:PLAYER locker ロッカー03 $status 1024,512 3000,10950
			}
		trap lk003 d:PLAYER \
			-mask ？ \
			-state 6 \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p -2286,5121,13378 -t 1809,1788,10855 \
					-r 395,1384,0 -f 5852 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3
			}

		// 東側下
		chara ロッカー ロッカー04 \
