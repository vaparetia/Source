resource 見つかったらゲームオーバーの説明日本語 {
not_gameover:
	'敵兵に発見されてもゲームオーバーになりません'
gameover:
	'敵兵に発見されるとゲームオーバーになります'
};

resource 見つかったらゲームオーバーの説明英語 {
not_gameover:
	// '敵兵に発見されてもゲームオーバーになりません'
	'The game will not end when discovered by the enemy.'
gameover:
	// '敵兵に発見されるとゲームオーバーになります'
	'The game will end when discovered by the enemy.'
};

resource 見つかったらゲームオーバーの説明フランス語 {
not_gameover:
	// '敵兵に発見されてもゲームオーバーになりません'
	'Le jeu ne finira pas quand tu seras d&\'ecouvert par|l\'ennemi.'
gameover:
	// '敵兵に発見されるとゲームオーバーになります'
	'Le jeu finira quand tu seras d&\'ecouvert par l\'ennemi.'
};

resource 見つかったらゲームオーバーの説明ドイツ語 {
not_gameover:
	// '敵兵に発見されてもゲームオーバーになりません'
	'Das Spiel endet nicht bei Entdecken durch den Feind.'
gameover:
	// '敵兵に発見されるとゲームオーバーになります'
	'Das Spiel endet bei Entdecken durch den Feind.'
};

resource 見つかったらゲームオーバーの説明イタリア語 {
not_gameover:
	// '敵兵に発見されてもゲームオーバーになりません'
	'Il gioco non termina se il nemico ti scopre.'
gameover:
	// '敵兵に発見されるとゲームオーバーになります'
	'Il gioco termina se il nemico ti scopre.'
};

resource 見つかったらゲームオーバーの説明スペイン語 {
not_gameover:
	// '敵兵に発見されてもゲームオーバーになりません'
	'Cuando el enemigo te descubra, el juego no se|terminar&\'a.'
gameover:
	// '敵兵に発見されるとゲームオーバーになります'
	'Cuando el enemigo te descubra, el juego se|terminar&\'a.'
