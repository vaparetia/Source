//-----------------------------------------------------------------------------
// ＢＧＭ設定
proc ＢＧＭオートメーション設定 {
#if d:DEBUG_PRINT
	print '*** BGM Set ***'
#endif

	trap ca101 d:PLAYER \
		-mask 入る \
		-exec {
		#if d:DEBUG_PRINT
			print '*** SD_AUTO_FADER2 ***'
		#endif

			mesg ＢＧＭマネージャー ＢＧＭマネ SD_SNEAK_AUTO d:SD_AUTO_FADER2
		}
	trap ca002 d:PLAYER \
		-mask 入る \
		-exec {
		#if d:DEBUG_PRINT
			print '*** SD_AUTO_FADER1 ***'
		#endif

			mesg ＢＧＭマネージャー ＢＧＭマネ SD_SNEAK_AUTO d:SD_AUTO_FADER1
		}
	trap ca003 d:PLAYER \
		-mask 入る \
		-exec {
		#if d:DEBUG_PRINT
			print '*** SD_AUTO_FADER1 ***'
		#endif

			mesg ＢＧＭマネージャー ＢＧＭマネ SD_SNEAK_AUTO d:SD_AUTO_FADER1
		}

	if ($s:登場ポイント == テイルズＢＢ脚ノードアクセス後から || \
		$s:登場ポイント == テイルズＤシールズ全滅紙芝居後から ) {
		// 部屋内から始まるときはこっちから
		mesg ＢＧＭマネージャー ＢＧＭマネ SD_SNEAK_AUTO d:SD_AUTO_FADER2
	} else {
		// 廊下から始まるときはこっちから
		mesg ＢＧＭマネージャー ＢＧＭマネ SD_SNEAK_AUTO d:SD_AUTO_FADER1
	}
}



//=============================================================================
// ビヨンド、ジャンプ
//=============================================================================

//-----------------------------------------------------------------------------
// ビヨンド設定
proc ビヨンド設定_変電室 {
#if d:DEBUG_PRINT
	print '*** Beyond Set: Substation ***'
#endif

	@SS_東ビヨンド登録 by001
}

//-----------------------------------------------------------------------------
// CB_ビヨンド
proc SS_CB_ビヨンド $:トラップ名 $:フラグ $:トリガ $:ＰＸ $:ＰＹ $:ＰＺ {
#if d:DEBUG_PRINT
	print '*** SS CB Beyond ***'
#endif

	//---------------------------------------------------------
	// ビヨンド発動処理
	if($:フラグ == 0) {

		if($i:プレイヤー位置Ｙ > 0) {	// 下での誤発動防止

			// トラップ名  柵の位置  Ｘ座標／Ｚ座標  トラップ幅１  トラップ幅２  フラグ
			@東向きビヨンド発動 $1 -45950 $6 -35250 -26250 d:BY_NOFOOTSHADOW
		}

	//---------------------------------------------------------
	// ビヨンドカメラ処理
	} else {
		if($:フラグ == 1) {
			//=====================================
			// ビヨンド発動カメラ
			//=====================================
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p -44501,-470,-22638 \
				-t -45911, 799,-27794 \
				-r -152,2222,0 \
				-f 5494 \
				-a 200 \
				-i 0 -1 0 0 \
				-s 1
		} else if($:フラグ == 2) {
			//=====================================
			// ビヨンド中カメラ
			//=====================================
			chara カメラ設定 モーションカメラ \
//				-c 0 \
//				-b d:CAM_MIN d:CAM_MIN d:CAM_MIN d:CAM_MAX d:CAM_MAX d:CAM_MAX \
//				-l d:CAM_MIN d:CAM_MIN d:CAM_MIN d:CAM_MAX d:CAM_MAX d:CAM_MAX \
//				-r 840,2214,0 \
//				-f 3000 \
//				-a 244 \
//				-i 2 2 0 0 \
//				-z d:CAMERA_NO_CUSHION \
//				-s $3
				-c 1 \
				-p -44979,2870,-23966 \
				-t -46321,615,-27384 \
				-a 170 \
				-i 2 2 0 0 \
				-s $3
		}
	}
}





//=============================================================================
// オブジェクト
//=============================================================================

//-----------------------------------------------------------------------------
// ドア設定
proc ドア設定 {
#if d:DEBUG_PRINT
	print '*** Door Set ***'
#endif

	// ドアフラグを元にモデルを設定(※全てのパターンのモデルを用意するのはもったいないので使うところのみ変更していく)
	// ドアモデル名セット $:配列番号 $:ドア名１(close) $:ドア名２(open) $:ドア名３(enemy) $:ドア名４(lv_close) $:ドア名５(lv_open)
	// ＡＢ連絡橋へのドア
	@ドアモデル名セット 0 d:DOOR_NAME1 d:DOOR_NAME1 d:DOOR_NAME1 d:DOOR_NAME1 d:DOOR_NAME1
	// ＢＣ連絡橋へのドア
	@ドアモデル名セット 1 d:DOOR_NAME2 d:DOOR_NAME2 d:DOOR_NAME2 d:DOOR_NAME2 d:DOOR_NAME2
	// 部屋西側のドア
	@ドアモデル名セット 2 d:DOOR_NAME3 d:DOOR_NAME3 d:DOOR_NAME3 d:DOOR_NAME3 d:DOOR_NAME3
	// 部屋北側のドア
	@ドアモデル名セット 3 d:DOOR_NAME3 d:DOOR_NAME3 d:DOOR_NAME3 d:DOOR_NAME3 d:DOOR_NAME3

	// ドア
	//   -m オブジェクト名  -d 向き  -p 場所  -slide スライド量  -time 時間  -between マップ名１ マップ名２  -exec { $:開閉フラグ }

	// ＡＢ連絡橋へのドア
	@ドアランプ設定 ＡＢ連絡橋へのドアランプ 3072 -44125 0 -20000 0
//	@主観禁止壁     ＡＢ連絡橋へのドア壁          -44125 0 -20000 3072 d:SD_SLIDE_OUTSIDE
	chara ドア ＡＢ連絡橋へのドア \
		-m $$s:ドアモデル名[0] \
		-d 0 3072 0 \
		-p -44125 0 -20000 \
		-s d:SD_SLIDE_OUTSIDE \
		-t d:SD_OPEN_TIME \
		-A ＡＢ連絡橋へのドアランプ \
		-b 廊下 廊下 \
		-exec {
			if(!($:開閉フラグ)) {
				mesg プットオブジェ ＡＢ連絡橋ロード部 off	// ロード部モデル
				mesg ローカル風 隙間風 オフ
			} else {
				mesg プットオブジェ ＡＢ連絡橋ロード部 on	// ロード部モデル
				mesg ローカル風 隙間風 オン
			}
		}
	trap dr001 ？ -mask ？ \
		-exec {
			if($3 == 入る) {
				mesg ドア ＡＢ連絡橋へのドア open $2
			} else if($3 == 出る) {
				mesg ドア ＡＢ連絡橋へのドア close $2
			}
		}
	trap dr001 d:PLAYER -mask ？ \
		-state d:TRP_STATE_SUBJECT \
		-exec {
			if($3 == 入る) {
				mesg 透明壁 ＡＢ連絡橋へのドア壁 on
			} else if($3 == 出る) {
				mesg 透明壁 ＡＢ連絡橋へのドア壁 off
			}
		}

	// ＢＣ連絡橋へのドア
	@ドアランプ設定 ＢＣ連絡橋へのドアランプ 0 -55500 0 -43625 0
//	@主観禁止壁     ＢＣ連絡橋へのドア壁       -55500 0 -43625 0 d:SD_SLIDE_OUTSIDE
	chara ドア ＢＣ連絡橋へのドア \
		-m $$s:ドアモデル名[1] \
		-d 0 0 0 \
		-p -55500 0 -43625 \
		-s d:SD_SLIDE_OUTSIDE \
		-t d:SD_OPEN_TIME \
		-A ＢＣ連絡橋へのドアランプ \
		-b 廊下 廊下 \
		-exec {
			if(!($:開閉フラグ)) {
				mesg プットオブジェ ＢＣ連絡橋ロード部 off	// ロード部モデル
				mesg ローカル風 隙間風 オフ
			} else {
				mesg プットオブジェ ＢＣ連絡橋ロード部 on	// ロード部モデル
				mesg ローカル風 隙間風 オン
			}
		}
	trap dr002 ？ -mask ？ \
		-exec {
			if($3 == 入る) {
				mesg ドア ＢＣ連絡橋へのドア open $2
			} else if($3 == 出る) {
				mesg ドア ＢＣ連絡橋へのドア close $2
			}
		}
	trap dr002 d:PLAYER -mask ？ \
		-state d:TRP_STATE_SUBJECT \
		-exec {
			if($3 == 入る) {
				mesg 透明壁 ＢＣ連絡橋へのドア壁 on
			} else if($3 == 出る) {
				mesg 透明壁 ＢＣ連絡橋へのドア壁 off
			}
		}

	// 部屋西側のドア
	@ドアランプ設定 部屋西側のドアランプ 1024 -53375 0 -24500 1
	chara ドア 部屋西側のドア \
		-m $$s:ドアモデル名[2] \
		-d 0 1024 0 \
		-p -53375 0 -24500 \
		-s d:SD_SLIDE_INSIDE \
		-t d:SD_OPEN_TIME \
		-l 影投影モデル \			// 影投影モデル
		-A 部屋西側のドアランプ \
		-b 廊下 変電室 \
		-exec {
			if(!($:開閉フラグ)) {
				mesg マップ接合 Ｂ脚接合１ off
				if($i:プレイヤー位置Ｘ < -53375) {
					mesg レンズフレア レンズフレア アルファ変更 0 1		// レンズフレア処理
				}
			} else {
				mesg マップ接合 Ｂ脚接合１ on
				mesg レンズフレア レンズフレア アルファ変更 8 1	// レンズフレア処理
			}
		}
	trap dr003 ？ -mask ？ \
		-exec {
			if($3 == 入る) {
				mesg ドア 部屋西側のドア open $2
			} else if($3 == 出る) {
				mesg ドア 部屋西側のドア close $2
			}
		}

	// 部屋北側のドア
	@ドアランプ設定 部屋北側のドアランプ 2048 -49750 0 -39125 0
	chara ドア 部屋北側のドア \
		-m $$s:ドアモデル名[3] \
		-d 0 2048 0 \
		-p -49750 0 -39125 \
		-s d:SD_SLIDE_INSIDE \
		-t d:SD_OPEN_TIME \
		-A 部屋北側のドアランプ \
		-b 廊下 変電室 \
		-exec {
			if(!($:開閉フラグ)) {
				mesg マップ接合 Ｂ脚接合２ off
				if($i:プレイヤー位置Ｚ < -39125) {
					mesg レンズフレア レンズフレア アルファ変更 0 1		// レンズフレア処理
				}
			} else {
				mesg マップ接合 Ｂ脚接合２ on
				mesg レンズフレア レンズフレア アルファ変更 8 1	// レンズフレア処理
			}
		}
	trap dr004 ？ -mask ？ \
		-exec {
			if($3 == 入る) {
				mesg ドア 部屋北側のドア open $2
			} else if($3 == 出る) {
				mesg ドア 部屋北側のドア close $2
			}
		}
}

proc A_廊下ドア開閉設定 {
	@A_ドア開閉追加設定 ＡＢ連絡橋へのドア $$b:ドアフラグ[0] -44125 0 -20000 3072 d:SD_SLIDE_OUTSIDE
	@A_ドア開閉追加設定 ＢＣ連絡橋へのドア $$b:ドアフラグ[1] -55500 0 -43625 0 d:SD_SLIDE_OUTSIDE
	@A_ドア開閉追加設定 部屋西側のドア $$b:ドアフラグ[2] -53375 0 -24500 1024 d:SD_SLIDE_INSIDE
	@A_ドア開閉追加設定 部屋北側のドア $$b:ドアフラグ[3] -49750 0 -39125 2048 d:SD_SLIDE_INSIDE
}

//-----------------------------------------------------------------------------
// ロッカー設定
proc ロッカー設定 {
#if d:DEBUG_PRINT
	print '*** Locker Set ***'
#endif

	chara ロッカー管理 管理人さん -n 7
	command ロッカーモーション -motion locker
	command プレイヤーロッカーモーション -motion sna_locker

	// $:ロッカー名 $:トラップ名 $:番号 $:モデル名 $:Ｘ座標 $:Ｙ座標 $:Ｚ座標 $:ステータス $:壁音番号 $:倒れ時床音番号 $:フラグ $:倒れシフトＸ $:倒れシフトＹ $:倒れシフトＺ $:倒れ回転Ｙ $:影ＩＤ {
	@SS_北ロッカー登録 ロッカー:01 lk001 0 (d:DOOR_NAME9)  -50000 0 -42875 (d:LOCKER_STATE_POSTER)      2 2 (0)                           0 0   0 -200 (0)
	@SS_北ロッカー登録 ロッカー:02 lk002 1 (d:DOOR_NAME8)  -49000 0 -42875 (0)                          2 2 (0)                           0 0   0  100 (0)
	@SS_北ロッカー登録 ロッカー:03 lk003 2 (d:DOOR_NAME8)  -48000 0 -42875 (d:LOCKER_STATE_DESTROY)     2 2 (0)                           0 0   0    0 (0)
	@SS_西ロッカー登録 ロッカー:04 lk004 3 (d:DOOR_NAME7)  -57000 0 -34750 (d:LOCKER_STATE_NO_OPEN_SEG) 2 2 (0)                           0 0   0 1032 (0)
	@SS_西ロッカー登録 ロッカー:05 lk005 4 (d:DOOR_NAME6)  -57000 0 -28750 (d:LOCKER_STATE_NO_OPEN_SEG) 2 2 (0)                           0 0   0  910 (0)
	@SS_西ロッカー登録 ロッカー:06 lk006 5 (d:DOOR_NAME5)  -52880 0 -38750 (d:LOCKER_STATE_OPEN)        2 2 (d:LOCKER_FLAG_SHADOWWRITE)   0 0 150  890 (影投影モデル)
	@SS_西ロッカー登録 ロッカー:07 lk007 6 (d:DOOR_NAME4)  -52880 0 -37750 (0)                          2 2 (d:LOCKER_FLAG_SHADOWWRITE) 300 0   0  700 (影投影モデル)
}

//-----------------------------------------------------------------------------
// CB_ロッカーチェック
proc SS_CB_ロッカーチェック $:番号 {
#if d:DEBUG_PRINT
	print '*** SS CB Locker Check ***'
#endif

	@壊れ物再セットチェック $b:w14a_破壊ロード回数[$:番号]
	if($f:再セットフラグ) {
		eval($i:w14a_ロッカー状態[$:番号] = 0)
	}

	return $i:w14a_ロッカー状態[$:番号]
}

//-----------------------------------------------------------------------------
// CB_ロッカー状態保存
proc SS_CB_ロッカー状態保存 $:開始終了 $:実行キャラ $:行動 $:ロッカー名 {
#if d:DEBUG_PRINT
	print '*** SS CB Locker Save ***'
#endif

	// ロッカー名と番号の対応
	if($:ロッカー名 == ロッカー:01) {
		eval($i:SS_ロッカー番号 = 0)
	} else if($:ロッカー名 == ロッカー:02) {
		eval($i:SS_ロッカー番号 = 1)
	} else if($:ロッカー名 == ロッカー:03) {
		eval($i:SS_ロッカー番号 = 2)
	} else if($:ロッカー名 == ロッカー:04) {
		eval($i:SS_ロッカー番号 = 3)
	} else if($:ロッカー名 == ロッカー:05) {
		eval($i:SS_ロッカー番号 = 4)
	} else if($:ロッカー名 == ロッカー:06) {
		eval($i:SS_ロッカー番号 = 5)
	} else if($:ロッカー名 == ロッカー:07) {
		eval($i:SS_ロッカー番号 = 6)
	}

	// 状態保存
	if(($:行動 != 6) && ($:行動 != 8)) {
		// 状態変化時
		eval($b:w14a_破壊ロード回数[$i:SS_ロッカー番号] = $w:グローバルロード回数);

	} else if($:行動 == 8) {
		// ステージ終了時
		command ロッカー状態 -n $:ロッカー名
		eval($i:w14a_ロッカー状態[$i:SS_ロッカー番号] = $status)
	}
}

//-----------------------------------------------------------------------------
// CB_ロッカー実行
proc SS_CB_ロッカー実行 $:トラップ名 $:フラグ $:トリガ $:ＰＸ $:ＰＹ $:ＰＺ {
#if d:DEBUG_PRINT
	print '*** SS CB Locker ***'
#endif

	//---------------------------------------------------------
	// 開閉実行処理
	if($:フラグ == 0) {

		command プレイヤー状態取得
		eval($f:Ｓローカルフラグ１ = (($status & d:PFLAG_CAUTION) != 0))	// 張付き時 1

		if($:トラップ名 == lk001) {
			command ロッカー状態 -n ロッカー:01
			mesg プレイヤー d:PLAYER locker ロッカー:01 $status 2048,512 (-50000-50),-42875
		} else if($:トラップ名 == lk002) {
			command ロッカー状態 -n ロッカー:02
			mesg プレイヤー d:PLAYER locker ロッカー:02 $status 2048,512 (-49000-50),-42875
		} else if($:トラップ名 == lk003) {
			command ロッカー状態 -n ロッカー:03
			mesg プレイヤー d:PLAYER locker ロッカー:03 $status 2048,512 (-48000-50),-42875
		} else if($:トラップ名 == lk004) {
			command ロッカー状態 -n ロッカー:04
			if(!(($status & 0x0002) && ($f:Ｓローカルフラグ１))) {	// 開いている時に張付きで起動しない
				mesg プレイヤー d:PLAYER locker ロッカー:04 $status 3072,512 -57000,(-34750+50)
			}
		} else if($:トラップ名 == lk005) {
			command ロッカー状態 -n ロッカー:05
			if(!(($status & 0x0002) && ($f:Ｓローカルフラグ１))) {	// 開いている時に張付きで起動しない
				mesg プレイヤー d:PLAYER locker ロッカー:05 $status 3072,512 -57000,(-28750+50)
			}
		} else if($:トラップ名 == lk006) {
			command ロッカー状態 -n ロッカー:06
			if(!(($status & 0x0002) && ($f:Ｓローカルフラグ１))) {	// 開いている時に張付きで起動しない
				mesg プレイヤー d:PLAYER locker ロッカー:06 $status 3072,512 -52880,(-38750+50)
			}
		} else if($:トラップ名 == lk007) {
			command ロッカー状態 -n ロッカー:07
			if(!(($status & 0x0002) && ($f:Ｓローカルフラグ１))) {	// 開いている時に張付きで起動しない
				mesg プレイヤー d:PLAYER locker ロッカー:07 $status 3072,512 -52880,(-37750+50)
			}
		}

	//---------------------------------------------------------
	// 開閉カメラ処理
	} else {
		if($:トラップ名 == lk001) {
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p -52920,3949,-40974 \
				-t -50276,793,-43024 \
				-a 200 \
				-i 0 2 0 0 \
				-s $3
		} else if($:トラップ名 == lk002) {
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p -52363,4292,-40782 \
				-t -49722,1130,-42830 \
				-a 200 \
				-i 0 2 0 0 \
				-s $3
		} else if($:トラップ名 == lk003) {
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p -50953,4266,-40702 \
				-t -48319,1083,-42744 \
				-a 200 \
				-i 0 2 0 0 \
				-s $3
		} else if($:トラップ名 == lk004) {
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p -55690,5303,-32955 \
				-t -56446,1071,-34638 \
				-a 200 \
				-i 0 2 0 0 \
				-s $3
		} else if($:トラップ名 == lk005) {
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p -55670,5144,-26998 \
				-t -56410,906,-28683 \
				-a 200 \
				-i 0 2 0 0 \
				-s $3
		} else if($:トラップ名 == lk006) {
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p -51443,4454,-36506 \
				-t -53047,-216,-38907 \
				-a 200 \
				-i 0 2 0 0 \
				-s $3

/*
			// 爆弾発見カメラデモ
			if($f:w14a爆弾を発見した == 0) {
 				eval($f:w14a爆弾を発見した = 1);
				command varsave $f:w14a爆弾を発見した

				if(    ($w:アラートモード == d:ALERT_MODE_SENNYU) \
					&& (`command ゲームオーバーチェック` == 0)) {
					chara delay カメラ遅延 \
						-time 60 -exec {
							@シナリオカメラデモ（シネマ） 45 -52001,3213,-37600 -52340,1398,-38532 200 -52498,1270,-38471 -52846,-537,-39406 200
						}
				}
			}
*/
		} else if($:トラップ名 == lk007) {
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p -51419,4099,-35826 \
				-t -53008,-582,-38221 \
				-a 200 \
				-i 0 2 0 0 \
				-s $3
		}
	}
}

//-----------------------------------------------------------------------------
// 爆弾解体設定
proc 爆弾解体設定 {
#if d:DEBUG_PRINT
	print '*** Bomb Set ***'
#endif

	// 爆弾解体設定
	//   $:爆弾名 $:処理状態フラグ $:Ｘ座標 $:Ｙ座標 $:Ｚ座標 $:Ｘ回転 $:Ｙ回転 $:Ｚ回転
	@SS_爆弾解体設定 w14a匂い爆弾 $f:w14a_爆弾処理完了 -52625 375 -39000 0 0 1024
}





//-----------------------------------------------------------------------------
// ノード端末設定
proc ノード接続時プロック {
	#if d:DEBUG_PRINT
		print '*** Node Set ***'
	#endif

	eval($f:ノードフラグ = $f:w14a_ノードフラグ);
}

proc ノード接続後プロック {
	#if d:DEBUG_PRINT
		print '*** Node Event ***'
	#endif

	eval($f:w14a_ノードフラグ = 1);
	command メニュー設定 -node_access on 
}


//-----------------------------------------------------------------------------
