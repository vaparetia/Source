#include "beyond.h"
#include "sound.h"
#include "item_info.h"
#include "node_res.h"

#if d:KEYBOARD 
#include "usbkbd.h"
#endif

#include "sdemo.h"


//-----------------------------------------------------------------------------
// ローカル

eval($f:Ｓローカルフラグ１ = 0)

eval($f:クリアリングフラグ０ = 0)	// クリアリング状態

#include "stageset.h"		// ステージ設定共通ヘッダ





//=============================================================================
// メイン
//=============================================================================
// アナザー用でマップ設定前に設定する
// ------------------------------------
@アナザー用マップ定義前設定

chara マップ 廊下 \
	-k d:KMS_NAME0 \
	-h d:HZX_NAME, 0 \
	-l d:LT2_NAME

chara マップ 変電室 \
	-k d:KMS_NAME2 \
	-h d:HZX_NAME, 1 \
	-l d:LT2_NAME

chara マップ接合 Ｂ脚接合１ 廊下 変電室
chara マップ接合 Ｂ脚接合２ 廊下 変電室

command マップ設定 廊下 変電室 -set {

	//----- 基本設定
	@SS_跳弾弾痕設定
	@常駐キャラ設定

	@A_プレイヤー設定 sna_a14a rai_a14a
}

// アナザー用でマップ設定後に設定する
// ------------------------------------
@アナザー用マップ定義後設定

command マップ設定 廊下 変電室 -set {
	// 共通ＢＧＭ処理
	@ＢＧＭオートメーション設定
	//----- オブジェクト(共通)
	@ドア設定
	@ロッカー設定
}

command マップ設定 廊下 -set {

	//----- オブジェクト(マップ別)
	@A_廊下ドア開閉設定
	@天井君設定_廊下
	@その他オブジェクト設定_廊下
}

command マップ設定 変電室 -set {

	//----- ビヨンド、ジャンプ
	@ビヨンド設定_変電室

	//----- オブジェクト(マップ別)
//	@ノード端末設定 3072
	@天井君設定_変電室
	@その他オブジェクト設定_変電室
}

command マップ設定 廊下 変電室 -set {

	//----- フォグ、カメラ、ロード
	@SS_フォグ_キャラ用ライト設定
	@カメラ設定
	@ロード設定
}

//	テイルズＢノードアクセス紙芝居後は変電室からスタート
if ($s:登場ポイント == テイルズＢＢ脚ノードアクセス後から) {
	command マップ表示 -show 変電室

// テイルズＤシールズ全滅紙芝居後から
} else if ($s:登場ポイント == テイルズＤシールズ全滅紙芝居後から) {
	command マップ表示 -show 変電室

} else {
	command マップ表示 -show 廊下
}

// レーダー当たり
command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 3
command 追加ＨＺＸグループ登録 -hzx_id 1 -add_id 3

// 影投影
command	影投影ハザード -name 変電室 -group 4

@ステージ進入時処理





//=============================================================================
// プロシージャ
//=============================================================================

//=============================================================================
// 基本設定
//=============================================================================
proc クリアリングカメラＯＦＦ {
#if d:DEBUG_PRINT
	print '*** Clearing Camera OFF ***'
#endif

	mesg サブ画面 子画面 off
	chara カメラ設定 クリアリングカメラ -s 0
}

//-----------------------------------------------------------------------------
// クリアリングエリア０設定
proc クリアリングエリア０_初期設定 {
#if d:DEBUG_PRINT
	print '*** Clearing Area 0: Init ***'
#endif

	if($s:登場ポイント == ＡＢ連絡橋から) {
		command セットクリアリング \
		//	-p 0,0,0,クリアリングエリア０_カメラ０ \
		//	   0,0,6,クリアリングエリア０_カメラ１ \
		//	   0,0,14,クリアリングエリア０_カメラ２ \
		//	   0,0,19,クリアリングエリア０_カメラ３ \
			-i 0,1,4
	} else {
		command セットクリアリング \
		//	-p 0,2,0,クリアリングエリア０_カメラ１０ \
		//	   0,2,6,クリアリングエリア０_カメラ１１ \
		//	   0,2,11,クリアリングエリア０_カメラ１２ \
		//	   0,2,18,クリアリングエリア０_カメラ１３ \
		//	   0,3,12,クリアリングエリア０_カメラ１４ \
			-i 2,3,5
	}

	eval($f:クリアリングフラグ０ = 1)
}
proc クリアリングエリア０内チェック {
#if d:DEBUG_PRINT
	print '*** Clearing Area 0: Bounding Check ***'
#endif

	if(    (-53375 < $i:プレイヤー位置Ｘ) && ($i:プレイヤー位置Ｘ < -43500) \
		&& (-39125 < $i:プレイヤー位置Ｚ) && ($i:プレイヤー位置Ｚ < -22500)) {
	//	return 1;
		return 0;
	} else {
		return 0;
	}
}
proc クリアリングエリア０_カメラ０ {
#if d:DEBUG_PRINT
	print '*** Clearing Area 0: Camera 0 ***'
#endif

	if(`@クリアリングエリア０内チェック`) {
		chara カメラ設定 クリアリングカメラ \
			-c 1 \
			-p -54572,3619,-19068 \
			-t -54731,2590,-21717 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1
		command カメラマップ設定 -chanl 1 -map 廊下
		mesg サブ画面 子画面 on
	}
}
