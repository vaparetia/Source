//-----------------------------------------------------------------------------
// その他オブジェクト設定
proc その他オブジェクト設定_廊下 {
#if d:DEBUG_PRINT
	print '*** Object Set: Hall ***'
#endif

	//---------------------------------------------------------
	// 主観禁止壁
	@主観禁止壁 ＡＢ連絡橋へのドア壁 -44125 0 -20000 3072 d:SD_SLIDE_OUTSIDE
	@主観禁止壁 ＢＣ連絡橋へのドア壁 -55500 0 -43625    0 d:SD_SLIDE_OUTSIDE

	//---------------------------------------------------------
	// ロード部モデル
	@SS_プットオブジェ  ＡＢ連絡橋ロード部 d:KMS_NAME7
	mesg プットオブジェ ＡＢ連絡橋ロード部 off
	@SS_プットオブジェ  ＢＣ連絡橋ロード部 d:KMS_NAME8
	mesg プットオブジェ ＢＣ連絡橋ロード部 off

	//---------------------------------------------------------
	// ドア風
	chara ローカル風 隙間風 \
		-n 2 \
		-d	-55500 0 -44750 -54000 3000 -42500     0 -512 2048 \
			-45250 0 -20000 -43000 3000 -18500  3072 -512 2048
	mesg ローカル風 隙間風 オフ

	//---------------------------------------------------------
	// 匍匐禁止を解除
	if ( ($b:ミッション番号 == d:MISSION:スネークテイルズ) && \
		 ($b:tales_story_no == d:TALES_NO:D) ) {
		/*	テイルズＤの時はＳＥＡＬＳ死体ありなので	*/
	} else {
		command トラップ切り替え \
			-trap no_crouch  \
			-switch 0
	}

	//---------------------------------------------------------
	// 電灯虫

	// chara 電灯虫 -n 匹数 // ４以上は４単位で -p 位置 // プレイヤー誘導時は無視 
	//   -b フラグ // 壁との当たり見るか 1:あり, 0:なし -s バウンド１ // 最小 -l バウンド２ // 最大
	chara 電灯虫 電灯虫 \
		-n 12 \
		-p -54750 2875 -43125 \
		-b 1 \
		-s -56000    0 -43250 \
		-l -53500 3750 -42250
	chara 電灯虫 電灯虫 \
		-n 12 \
		-p -44625 2875 -19250 \
		-b 1 \
		-s -45500    0 -20375 \
		-l -44500 3750 -18125

	//---------------------------------------------------------
	// ダンボールトラップ
	chara ダンボール柄トラップ設定 ダンボール柄トラップ設定 \
		-name d:PLAYER \
		-traps d:アイテム:ダンボールＢ, cbox_area
}

proc その他オブジェクト設定_変電室 {
#if d:DEBUG_PRINT
	print '*** Object Set: Substation ***'
#endif

	// 海軍大佐死体無し影
	chara プットオブジェ 海軍大佐死体無し影 \
		-m d:SHADOW_NAME4 \
		-r 0,0,0 \
		-p -50000,0,-30000 \
		-s 100,100,100 \
		-l d:LT2_NAME

	// 匍匐禁止を解除
	if ( ($b:ミッション番号 == d:MISSION:スネークテイルズ) && \
		 ($b:tales_story_no == d:TALES_NO:D) ) {
		/*	テイルズＤの時はＳＥＡＬＳ死体ありなので	*/
	} else {
		// 匍匐禁止を解除
		command トラップ切り替え \
			-trap no_crouch  \
			-switch 0
	}
	//---------------------------------------------------------
	// 各ステージオブジェクトモデル

	// 破壊壁
	chara プットオブジェ 破壊壁階段下 \
		-m d:KMS_NAME5 \
		-r 0,0,0 \
		-p -45000 -2000 -39000 \
		-s 100,100,100 \
		-l d:LT2_NAME 

	chara プットオブジェ 破壊壁配電盤横 \
		-m d:KMS_NAME6 \
		-r 0,0,0 \
		-p -53250 0 -30750 \
		-s 100,100,100 \
		-l d:LT2_NAME 

	// 天井オブジェクト
	chara プットオブジェ 天井オブジェクト \
		-m d:OBJECT_NAME1 \
		-r 0,0,0 \
		-p -50000,0,-30000 \
		-s 100,100,100 \
		-l d:LT2_NAME

	// フェンス
	chara プットオブジェ フェンスａ０１ \
		-m d:OBJECT_NAME2 \
		-r 0,0,0 \
		-p -50000,0,-30000 \
		-s 100,100,100 \
		-l d:LT2_NAME
	chara プットオブジェ フェンスａ０２ \
		-m d:OBJECT_NAME3 \
		-r 0,0,0 \
		-p -50000,0,-30000 \
		-s 100,100,100 \
		-l d:LT2_NAME
	chara プットオブジェ フェンスａ０３ \
		-m d:OBJECT_NAME4 \
		-r 0,0,0 \
		-p -50000,0,-30000 \
		-s 100,100,100 \
		-l d:LT2_NAME
	chara プットオブジェ フェンスａ０４ \
		-m d:OBJECT_NAME5 \
		-r 0,0,0 \
		-p -50000,0,-30000 \
		-s 100,100,100 \
		-l d:LT2_NAME
	chara プットオブジェ フェンスａ０５ \
		-m d:OBJECT_NAME6 \
		-r 0,0,0 \
		-p -50000,0,-30000 \
		-s 100,100,100 \
		-l d:LT2_NAME
	chara プットオブジェ フェンスａ０６ \
		-m d:OBJECT_NAME7 \
		-r 0,0,0 \
		-p -50000,0,-30000 \
		-s 100,100,100 \
		-l d:LT2_NAME
	chara プットオブジェ フェンスａ０７ \
		-m d:OBJECT_NAME8 \
		-r 0,0,0 \
		-p -50000,0,-30000 \
		-s 100,100,100 \
		-l d:LT2_NAME
	chara プットオブジェ フェンスａ０８ \
		-m d:OBJECT_NAME9 \
		-r 0,0,0 \
		-p -50000,0,-30000 \
		-s 100,100,100 \
		-l d:LT2_NAME

	chara プットオブジェ フェンスｂ０１ \
		-m d:OBJECT_NAME10 \
		-r 0,0,0 \
		-p -50000,0,-30000 \
		-s 100,100,100 \
		-l d:LT2_NAME
	chara プットオブジェ フェンスｂ０２ \
		-m d:OBJECT_NAME11 \
		-r 0,0,0 \
		-p -50000,0,-30000 \
		-s 100,100,100 \
		-l d:LT2_NAME
	chara プットオブジェ フェンスｂ０３ \
		-m d:OBJECT_NAME12 \
		-r 0,0,0 \
		-p -50000,0,-30000 \
		-s 100,100,100 \
		-l d:LT2_NAME

	//---------------------------------------------------------
	// 各エフェクト

	// スリット光
	//   -p 中心座標  -n 法線  -d 光線の絶対方向  -l 光線の到達距離
	chara スリット光２ スリット光 \
		-p -45500 4687 -34750 \
		-n 1 0 0 \
		-d -1000 -750 0 \
		-l 3000
	chara スリット光２ スリット光 \
		-p -45500 4687 -32750 \
		-n 1 0 0 \
		-d -1000 -750 0 \
		-l 3000
	chara スリット光２ スリット光 \
		-p -45500 4687 -30750 \
		-n 1 0 0 \
		-d -1000 -750 0 \
		-l 3000
	chara スリット光２ スリット光 \
		-p -45500 4687 -28750 \
		-n 1 0 0 \
		-d -1000 -750 0 \
		-l 3000
	chara スリット光２ スリット光 \
		-p -45500 4687 -26750 \
		-n 1 0 0 \
		-d -1000 -750 0 \
		-l 3000

	// 漏電火花
	//   -p 中心座標
	chara 漏電火花 漏電火花 -p -50659 2439 -28877

	// レンズフレア
	//   -pos 位置  -size 大きさ  -alpha アルファ
	chara レンズフレア  レンズフレア \
		-pos   -45400,5000,-34750 \
		-size  1 \
		-alpha 8 \
		-g     2

	mesg レンズフレア レンズフレア アルファ変更 0 1

	// 影投影モデル -m 影投影専用モデル -p 設置位置
	chara 影投影モデル 影投影モデル -m d:KMS_NAME4 -p 2,2,-2

	// 影管理 -t 光源タイプ -l 光源距離(並行光源時のみ有効) -p 並行光源方向直接指定
	chara 影管理 影管理 -t 0 -l 6000 -p -1563,-1998,758
	trap ev004 ？ \
		-mask ？ \
		-exec {
			if($3 == 入る) {
				mesg 影管理 影管理 add $2 影投影モデル
			} else {
				mesg 影管理 影管理 del $2
			}
		}

	// 消火器 -r 向き -p 場所 -l 光源 -b バンダリ(XYZ のセット２つ) -i 赤外線センサーに有効(１で有効) -e 破壊時実行プロック -d デバグ(１でデバグターゲットが見える)
	chara 消火器 消火器１ \
		-p -53100 0 -26650 \
		-r 0 0 0 \
		-l d:LT2_NAME \
		-b -53300 -100 -29250 -49250 3000 -22500 \	// XYZ のセット２つ
		-d 0
}





//=============================================================================
// フォグ、カメラ、ロード
//=============================================================================

//-----------------------------------------------------------------------------
// カメラ設定
proc カメラ設定 {
#if d:DEBUG_PRINT
	print '*** Camera Set ***'
#endif

	// カメラ
	//   -c チャンネル番号  -l カメラレベル  -p 優先度
	//
	//   シナリオカメラは最大16個までおける。
	//   チャンネル番号 ：
	//       ０：通常画面 １：小窓
	//   カメラレベル ：
	//       ０：カットインカメラ（主観より強） 強
	//       １：カットインカメラ（主観より弱） ↑
	//       ２：エリアカメラ		   ↓
	//       ３：ステージデフォルトカメラ	   弱
	//   優先度 ：
	//       エリアカメラに有効
	//       数字が小さい程優先度高
	chara カメラ ステージカメラ		-c 0 -l 3 -p  0
	chara カメラ サブカメラ１		-c 0 -l 2 -p 50
	chara カメラ サブカメラ２		-c 0 -l 2 -p 40
	chara カメラ サブカメラ３		-c 0 -l 2 -p 30
	chara カメラ サブカメラ４		-c 0 -l 2 -p 20
	chara カメラ モーションカメラ	-c 0 -l 2 -p 10
	chara カメラ でもデモカメラ		-c 0 -l 0 -p  0

	chara カメラ クリアリングカメラ	-c 1 -l 2 -p  0

	// デフォルトカメラ
	chara カメラ設定 ステージカメラ \
		-c 0 \
		-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
		-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
		-r 850,2048,0 \
		-f 5500 \
		-a 200 \
		-i 1 -1 0 0 \
		-s 1

	// 部屋の中
	trap ca101 d:PLAYER \
		-camera -mask ？ \
		-exec {
			chara カメラ設定 サブカメラ３ \
				-c 0 \
				-b -51000, 4200,-36000 -45000,d:CAM_MAX,-23000 \
				-l -51000,-1000,-39000 -45000,d:CAM_MAX,-24000 \
				-r 700,2048,0 \
				-f 5500 \
				-a 200 \
				-i 0 0 0 0 \
				-s $3
		}

	// 金網張付き
	trap ca102 d:PLAYER \
		-camera -mask ？ \
		-state d:TRP_STATE_CAUTION \
		-exec {
			chara カメラ設定 サブカメラ４ \
//				-c 1 \
//				-p ( $i:プレイヤー位置Ｘ-  67 ),(  2750 ),( $i:プレイヤー位置Ｚ+1932 ) \
//				-t ( $i:プレイヤー位置Ｘ-1401 ),( -1631 ),( $i:プレイヤー位置Ｚ- 854 )  \
//				-a 180 \
				-c 0 \
				-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,-23868 \
				-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,-28001 \
				-r 263,2220,0 \
				-f 4655 \
				-a 180 \
				-i 1 1 0 0 \
				-z d:CAMERA_NO_CUSHION \
				-s $3
		}

	// 北側廊下
	trap ca003 d:PLAYER \
		-camera -mask ？ \
		-exec {
			chara カメラ設定 サブカメラ２ \
				-c 0 \
				-b -55043,     6000,-40132 -49675,d:CAM_MAX,-39500 \
				-l -55043,d:CAM_MIN,-42855 -49675,d:CAM_MAX,-40912 \
				-r 660,2048,0 \
				-f 5171 \
				-a 200 \
				-i 0 0 0 0 \
				-s $3
		}

	// 西側廊下
	trap ca002 d:PLAYER \
		-camera -mask ＊ \
		-exec {
			// 北側   -p -54033,2584,-32578 -t -54466,1736,-37117
			// 南側   -p -53877,2189,-15752 -t -54865,1059,-20124
//			if ( $3 == いる ) {

				@CS_スムーズカメラ昇順 $6 -37957 -20375 -54033 -53877
				eval( $i:w14aカメラ位置Ｘ = $i:CS_結果１ ) ;
				@CS_スムーズカメラ昇順 $6 -37957 -20375 2584 2189
				eval( $i:w14aカメラ位置Ｙ = $i:CS_結果１ ) ;
				@CS_スムーズカメラ昇順 $6 -37957 -20375 -32578 -15752
				eval( $i:w14aカメラ位置Ｚ = $i:CS_結果１ ) ;
				@CS_スムーズカメラ昇順 $6 -37957 -20375 -54466 -54865
				eval( $i:w14a注視点Ｘ = $i:CS_結果１ ) ;
				@CS_スムーズカメラ昇順 $6 -37957 -20375 1736 1059
				eval( $i:w14a注視点Ｙ = $i:CS_結果１ ) ;
				@CS_スムーズカメラ昇順 $6 -37957 -20375 -37117 -20124
				eval( $i:w14a注視点Ｚ = $i:CS_結果１ ) ;

				if(($6 < -24000) || ($3 != 出る)) {		// よく分からんがこれでうまく行く
					chara カメラ設定 サブカメラ１ \
						-c 1 \
						-p $i:w14aカメラ位置Ｘ,$i:w14aカメラ位置Ｙ,$i:w14aカメラ位置Ｚ \
						-t $i:w14a注視点Ｘ,$i:w14a注視点Ｙ,$i:w14a注視点Ｚ \
						-a 200 \
						-i 2 2 0 0 \
						-s $3
				}

//			} else {
				// chara カメラ設定 サブカメラ１ -s 0
//			}
		}

	// 南側廊下
	trap ca001 d:PLAYER \
		-camera -mask ＊ \
		-exec {
			if ( $3 == いる ) {
				if ( $4 <= -53500 ) {		// -53500 はコーナーの角のX座標
					// コーナーを回るところの接続
					// 南北通路側(旧) -p -53877,2189,-15752 -t -54865,1059,-20124
					// 南北通路側(新) -p -53483,2799,-15241 -t -53587,982,-19479
					eval( $w:Ｘ差分 = $4 - ( -53500 )) ;
					eval( $w:Ｚ差分 = $6 - ( -20500 )) ;
					eval( $i:コーナー角度 = `command atan $w:Ｘ差分 $w:Ｚ差分`)
					@CS_スムーズカメラ昇順 $i:コーナー角度 1024 2048 -53483 -53877
					eval( $i:w14aカメラ位置Ｘ = $i:CS_結果１ ) ;
					@CS_スムーズカメラ昇順 $i:コーナー角度 1024 2048 2799 2189
					eval( $i:w14aカメラ位置Ｙ = $i:CS_結果１ ) ;
					@CS_スムーズカメラ昇順 $i:コーナー角度 1024 2048 -15241 -15752
					eval( $i:w14aカメラ位置Ｚ = $i:CS_結果１ ) ;
					@CS_スムーズカメラ昇順 $i:コーナー角度 1024 2048 -53587 -54865
					eval( $i:w14a注視点Ｘ = $i:CS_結果１ ) ;
					@CS_スムーズカメラ昇順 $i:コーナー角度 1024 2048 982 1059
					eval( $i:w14a注視点Ｙ = $i:CS_結果１ ) ;
					@CS_スムーズカメラ昇順 $i:コーナー角度 1024 2048 -19479 -20124
					eval( $i:w14a注視点Ｚ = $i:CS_結果１ ) ;
				} else {
					// 東西通路
					// ＡＢ連絡橋側   -p -46673,3167,-15788 -t -45839,982,-19639
					// 南北通路側(新) -p -53483,2799,-15241 -t -53587,982,-19479
					@CS_スムーズカメラ昇順 $4 -53500 -46436 -53483 -46673
					eval( $i:w14aカメラ位置Ｘ = $i:CS_結果１ ) ;
					@CS_スムーズカメラ昇順 $4 -53500 -46436 2799 3167
					eval( $i:w14aカメラ位置Ｙ = $i:CS_結果１ ) ;
					@CS_スムーズカメラ昇順 $4 -53500 -46436 -15241 -15788
					eval( $i:w14aカメラ位置Ｚ = $i:CS_結果１ ) ;
					@CS_スムーズカメラ昇順 $4 -53500 -46436 -53587 -45839
					eval( $i:w14a注視点Ｘ = $i:CS_結果１ ) ;
					@CS_スムーズカメラ昇順 $4 -53500 -46436 982 1000
					eval( $i:w14a注視点Ｙ = $i:CS_結果１ ) ;
					@CS_スムーズカメラ昇順 $4 -53500 -46436 -19479 -19639
					eval( $i:w14a注視点Ｚ = $i:CS_結果１ ) ;
				}
				chara カメラ設定 サブカメラ１ \
					-c 1 \
					-p $i:w14aカメラ位置Ｘ,$i:w14aカメラ位置Ｙ,$i:w14aカメラ位置Ｚ \
					-t $i:w14a注視点Ｘ,$i:w14a注視点Ｙ,$i:w14a注視点Ｚ \
					-a 200 \
					-i 1 1 0 0 \
					-s 1
			} else {
				// chara カメラ設定 サブカメラ１ -s 0
			}
		}

	trap ca001a d:PLAYER \
		-camera -mask ？ \
		-state d:TRP_STATE_CAUTION \
		-exec {
			chara カメラ設定 サブカメラ３ \
				-c 0 \
				-b -54871 3968 -18235 -45557 3968 -18235 \
				-l -54871 1625 -18249 -45557 1625 -18249 \
				-r 1020 2029 0 -f 2343 \
				-a 200 \
				-i 0 0 0 0 \
				-s $3
		}
}

proc スタートカメラセット {
#if d:DEBUG_PRINT
	print '*** Start Camera Set ***'
#endif

	if($s:登場ポイント == ＡＢ連絡橋から) {				// ＡＢ連絡橋から
		chara カメラ設定 モーションカメラ \
			-c 1 \
			-p -47975,3443,-18567 \
			-t -44403,1120,-19852 \
			-a 200 \
			-i 0 2 0 0 \
			-s 1
	} else if($s:登場ポイント == ＢＣ連絡橋から) {		// ＢＣ連絡橋から
		chara カメラ設定 モーションカメラ \
			-c 1 \
			-p -53559,4296,-42429 \
			-t -55902,-190,-43366 \
			-a 200 \
			-i 0 2 0 0 \
			-s 1
	}
}

proc スタートカメラオフ {
#if d:DEBUG_PRINT
	print '*** Start Camera Off ***'
#endif

	chara カメラ設定 モーションカメラ -s 0
}



//-----------------------------------------------------------------------------
// ロード設定
proc ロード設定 {
#if d:DEBUG_PRINT
	print '*** Load Set ***'
#endif


	// ＡＢ連絡橋へ (w13a、w13b)
	trap ld001 d:PLAYER \
		-mask 入る \
		-exec {
			if($f:ロードチェックＯＮフラグ == 1) {
				//	テイルズＥのＡＢ連絡橋到着前はこちらを通る
				if (($b:ミッション番号 == d:MISSION:スネークテイルズ) && \
					($b:tales_story_no == d:TALES_NO:E) && \
					($b:tales_story_e == d:TALES_E:ＡＢ連絡橋到着前)) {
					eval( $s:登場ポイント = ＡＢ連絡橋から );
					@スタートカメラセット
					@ステージ終了時処理 -42250 0 -19250 1024 load_tales_book d:DEFAULT_M_TYPE
				//	それ以外は
				} else {
					eval( $s:登場ポイント = ＡＢ連絡橋から );
					@スタートカメラセット
					@A_爆弾タイマー停止
					preseek 'a13b'
					@ステージ終了時処理（ステージ名表示） -42250 0 -19250 1024 mv_a14a_a13a_0 d:DEFAULT_M_TYPE d:wn_ＡＢ連絡橋
				}
			}
		}

	// ＢＣ連絡橋へ (w15a、w15b)
	trap ld002 d:PLAYER \
		-mask 入る \
		-exec {
			if($f:ロードチェックＯＮフラグ == 1) {
				eval( $s:登場ポイント = ＢＣ連絡橋から );
				@スタートカメラセット
				@A_爆弾タイマー停止
				preseek 'a15b'
				@ステージ終了時処理（ステージ名表示） -54750 0 -45500 2048 mv_a14a_a15a_0 d:DEFAULT_M_TYPE d:wn_ＢＣ連絡橋
			}
		}
}

proc ロードプロック {
#if d:DEBUG_PRINT
	print '*** Load Proc ***'
#endif

	if($s:呼び出しプロック == mv_a14a_a13a_0) {
		// ＡＢ連絡橋へ
		@mv_a14a_a13a_0

	} else if($s:呼び出しプロック == mv_a14a_a15a_0) {
		// ＢＣ連絡橋へ
		@mv_a14a_a15a_0

	} else if ($s:呼び出しプロック == load_tales_book) {
		// 紙芝居へ
		@load_tales_book
	}
}



//=============================================================================
// ステージ進入時処理
//=============================================================================

proc ステージ進入時処理 {
#if d:DEBUG_PRINT
	print '*** Stage Start Proc ***'
#endif

	// @ステージ開始時処理 タイプ(スライドドア、水密ドア、何もなし)   ドアの名前   移動距離   状態(前のステージ状態、走り、歩き)
	if($s:登場ポイント == ＡＢ連絡橋から) {
		@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:SL_DOOR_TYPE ＡＢ連絡橋へのドア 2000 d:DEFAULT_M_TYPE d:wn_Ｂ脚変電室

	} else if($s:登場ポイント == ＢＣ連絡橋から) {
		@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:SL_DOOR_TYPE ＢＣ連絡橋へのドア 2000 d:DEFAULT_M_TYPE d:wn_Ｂ脚変電室

	} else if($s:登場ポイント == Ｅ脚からダンボール) {
		@ステージ開始時処理（ダンボールワープ） d:wn_Ｂ脚変電室

	// テイルズＢＢ脚ノードアクセス後から
	} else if ($s:登場ポイント == テイルズＢＢ脚ノードアクセス後から) {
		@ステージ開始時処理 \
		d:LOAD_TYPE:NO_MOVE_TYPE 紙芝居 0 d:DEFAULT_M_TYPE

	// テイルズＤシールズ全滅後から
	} else if ($s:登場ポイント == テイルズＤシールズ全滅紙芝居後から) {
		@ステージ開始時処理（ステージ名表示） \
		d:LOAD_TYPE:NO_MOVE_TYPE 紙芝居 0 d:DEFAULT_M_TYPE \
		d:wn_Ｂ脚変電室
		chara プロック連続実行 姿勢制御管理人 \
			-exec {
				command パッドチェック \
					-no_use
				if ($status != 1) {
					mesg プロック連続実行 姿勢制御管理人 kill
					command パッド操作 \
						-release
					mesg プレイヤー d:PLAYER stance \
					d:FA_END_STAND -1 -1 0
					command パッド操作 \
						-cancel
				}
			}
	}

}
