	// ドア
	// ------------------------------------
	proc ドア設置 {
		#if d:CHARA_DOOR
			chara ドア ホールドア \
				-m d:DOOR_NAME1 \
				-d 0,1024,0 \
				-p 1250,-14000,-13250 \
				-slide -1500 \
				-time 10 \
				-exec {
					if( $:開閉フラグ == 0 ){
						mesg マップ接合 潜入プール／ホール off
					} else {
						mesg マップ接合 潜入プール／ホール on
					}
				}
			trap dr001 ？ \
				-mask ？ \	
				-exec {
						if($3==入る){
							mesg ドア ホールドア open
						}else{
							mesg ドア ホールドア close
						}
				}
		#endif
	}

	// 入出トラップ
	// ------------------------------------
	proc ロードプロック {
		if ($s:呼び出しプロック == mv_w12a_w11a2_0) {
			@mv_w12a_w11a2_0
		} else if ($s:呼び出しプロック == mv_w12a_w12b_0) {
			@mv_w12a_w12b_0
		} else if ($s:呼び出しプロック == mv_w12a_w12b_1) {
			@mv_w12a_w12b_1
		}
	}

	proc 亀の頭上入出トラップ設定 {
		#if d:LOAD_TRAP
			trap ld001 d:PLAYER \
				-mask 入る \
				-button 0 \
				-exec {
					@新ロード時フェードアウト 0 -5000 -12000 0 mv_w12a_w11a2_0
				}

			trap ld002 d:PLAYER \
				-mask 入る \
				-exec {
					@新ロード時フェードアウト -8000 -2000 -4500 0 mv_w12a_w12b_0
				}

			trap ld003 d:PLAYER \
				-mask 入る \
				-exec {
					@新ロード時フェードアウト 8000 -2000 -4500 0 mv_w12a_w12b_1
				}
		#endif
	}




	// エフェクト関係
	// -----------------------------------
	proc エフェクト設定 {
		#if d:BLUR
			chara ブラー ブラー
		#endif

		#if d:DEPTH
			chara Ｚフォーカス管理 Z_manager
			mesg Ｚフォーカス管理 Z_manager パラメータ 5000 30
		#endif

		#if d:BODY_SHADOW
			chara ＯＦＦ制御 off_man
			mesg ＯＦＦ制御 off_man ボディシャドウＯＦＦ
		#endif
	}


	// 子画面設定 
	// ------------------------------------
	proc 子画面設定 {
		#if d:SUB_CAMERA
			chara サブ画面 子画面 \
				-w (512-d:SUB_MARGIN-d:SUB_WIDTH),d:SUB_MARGIN (512-d:SUB_MARGIN),(d:SUB_HEIGHT+d:SUB_MARGIN)
		#endif
	}

	// ステージカメラ設定 
	// ------------------------------------
	proc カメラセット {
		#if d:STAGE_CAMERA
			chara カメラ ステージカメラ		-c 0 -l 3 -p 0 
			chara カメラ 小部屋カメラ		-c 0 -l 2 -p 50
			chara カメラ 匍匐カメラ			-c 0 -l 2 -p 30
			chara カメラ モーションカメラ	-c 0 -l 2 -p 20 
			chara カメラ ビヨンドカメラ	-c 0 -l 2 -p 20 

			// デフォルトカメラ
			chara カメラ設定 ステージカメラ \
				-c 0 \	
				-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
				-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
				-r 500,2048,0 \
				-f 5000 \
				-a 200 \
				-i 0 0 0 0 \
				-s 1
		#endif
	}



// 各マップ別
// Ａ脚屋上
	// フォグ
	// ------------------------------------
	proc フォグ設定 {
		#if d:FOG
			chara フォグ 霧\
				-c 152, 170, 140 \
				-n -10000 \
				-f 86000 
		#endif
	}

	// 強制モーション用トラップ
	// ------------------------------------
	proc 強制モーション設定 {
		#if d:STAGE_CAMERA
		#if d:JP_MOTION
			// 右舷B1右の箱の下
			trap ky000 d:PLAYER \
				-mask いる \
				-button 3 \
				-state 0,1 \	//立ち状態orしゃがみ
				-dir 0 512 \
				-exec {
//					mesg プレイヤー d:PLAYER position2 0,16298 2,-21410
/*
					chara カメラ設定 モーションカメラ \
						-c 1 \
						-p 14169,688,-19905 -t 15606,-2680,-21677 \
						-r 636,1604,0 \
						-f 4068 \
						-a 200 \
						-i 0 2 0 0 \
						-s 1
*/
					mesg プレイヤー d:PLAYER motion d:モーションリスト:non_jump_up 0 0 0 0x00000004
				}
			trap ky000 d:PLAYER \
				-mask 出る \
				-exec {
					chara カメラ設定 モーションカメラ \
						-s 0
				}
		#endif
		#endif
	}

	// ビヨンド設定
	// ------------------------------------
	proc 潜入プールビヨンド設定 {
		#if d:BY_MOTION
			// B1右奥
			trap by000 d:PLAYER \
				-mask いる \
				-button 3 \		//ビヨンドボタン
				-state 0,4 \	//立ち状態or張り付き
				-exec {
					@南向きビヨンド発動 by000 -1000 $4 -3000 2500
				}
			trap by000 d:PLAYER \
				-mask いる \
				-state 6 \
				-dir 0 256 \	//方向指定
				-exec {
					chara カメラ設定 ビヨンドカメラ \
						-c 0 \
						-b -32000,-32000,-32000 32000,32000,32000 \
						-l -32000,-32000,-32000 32000,32000,32000 \
						-r 670,1718,0 \
						-f 5981 \
						-a 200 \
						-i 0 -1 0 0 \
						-s 1
				}
			trap by000 d:PLAYER \
				-mask ？ \
				-state 5 \
				-dir 2048 256 \	//方向指定
				-exec {
					chara カメラ設定 ビヨンドカメラ \
						-c 0 \
						-b -32000,-32000,-32000 32000,32000,32000 \
						-l -32000,-32000,-32000 32000,32000,32000 \
						-r 550,2048,0 \
						-f 4195 \
						-a 350 \
						-i 3 2 0 0 \
						-s $3 \
						-z d:CAMERA_NO_CUSHION
				}
		#endif
	}

	// 各種カメラの設定
	// ------------------------------------
	proc Ａ脚屋上カメラ設定 {
		#if d:STAGE_CAMERA
			trap ca001 d:PLAYER \
				-mask ？ \
				-camera \
				-exec {
					chara カメラ設定 小部屋カメラ \
						-c 0 \	
						-b -32000,-32000,-32000 32000,3200,6500 \
						-l -7000,-32000,-32000 7000,32000,32000 \
						-r 250,2048,0 \
						-f 6500 \
						-a 200 \
						-i 2 2 0 0 \
						-s $3
				}

			trap ca002 d:PLAYER \
				-mask ？ \
				-camera \
				-exec {
					chara カメラ設定 小部屋カメラ \
						-c 0 \	
						-b 0,-32000,-8000 0,-12000,32000 \
						-l 0,-32000,-32000 0,32000,32000 \
						-r 250,2048,0 \
						-f 4500 \
						-a 200 \
						-i 2 2 0 0 \
						-s $3
				}
		#endif
	}


	proc 影モデル設定 {
		chara 影投影モデル 影投影モデル \
			-model d:KMS_NAME0 \
			-pos 0,0,0
	}


// デバッグキャラ
// ------------------------------------
proc デバッグキャラセット {
	#if d:DEBUG_MODE
		#if d:CHARA_CAMERA
			chara キャラカメラ 敵兵カメラ \
				-c d:TARGET_CHARA \
				-s -920,610,200 \
				-r -200,1024,0 
		#endif

		#if d:SCREENSHOT
			chara スクリーンショット shot
		#endif

		#if d:USB_KEY
			chara USBキーボード実行 test \
				-e d:KBD_ESC {	
					mesg プレイヤー d:PLAYER position -5500, -13000, -500
				} \
		#endif
	#endif
}
