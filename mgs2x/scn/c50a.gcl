// 各種スイッチ用define
// ------------------------------------
// サウンド
#define		SOUND			0
// レーダー
#define		RADAR			1
// キャラクター関係
#define		SNAKE			0
#define		RAIDEN			1
#define		ENEMY			0
#define		SHIELD			0
// ドア
#define		CHARA_DOOR		0
// エフェクト関係
#define		BLUR			0
#define		DEPTH			0
#define		BODY_SHADOW		0
// 子画面
#define		SUB_CAMERA		0
// カメラ関係
#define		STAGE_CAMERA	1
#define		CLEAR_CAMERA	0

// フォグ
#define		FOG				1

// 入出トラップ
#define		LD_FADEOUT		1
#define		LOAD_TRAP		1
// 天井
#define		CHARA_CEIL		0
// ライト関係
#define		SPOT_LIGHT		0
// オブジェ関係
// アイテム
#define		ITEM			0
// 強制モーション
#define		BY_MOTION		0
#define		JP_MOTION		0

// デバッグ関係
#define		DEBUG_MODE		0
#define		CHARA_CAMERA	0
#define		TARGET_CHARA	敵兵１
#define		SCREENSHOT		0
#define		USB_KEY			0

// 各種define
// ------------------------------------
// マップ関係
#define		HZX_NAME		c50a
#define		KMS_NAME0		c50a
//#define		KMS_NAME1		w12b
#define		DOOR_NAME1		w02a_dr
#define		LT2_NAME		debug

// 子画面サイズ
#define		SUB_WIDTH		160
#define		SUB_HEIGHT		64
#define		SUB_MARGIN		16

// キャラクター関係
#if d:SNAKE
	#define		PLAYER		スネーク
#else
	#define		PLAYER		ライデン
#endif



// モーション関係
// ------------------------------------

// include
// ------------------------------------
#include "sna_w02a.mh"
#include "stdch.h"
#include "sload.h"
#include "beyond.h"
#include "sound.h"

#if d:USB_KEY
	#include "usbkbd.h"
#endif


// マップ設定
// ------------------------------------
chara マップ 亀の頭上 -k d:KMS_NAME0 -k kame -h d:HZX_NAME,0 -l d:LT2_NAME

command マップ設定	亀の頭上 -set {
	@常駐キャラ設定
	@サウンド設定
//	@レーダー設定
	@プレイヤー設定
//	@コマンダー設定
//	@ドア設置
//	@亀の頭上入出トラップ設定
//	@エフェクト設定
	@カメラセット
	@フォグ設定
	@デバッグキャラセット
}

//初期マップの表示
command マップ表示 -show 亀の頭上

// 全マップ共通
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
	}

	// サウンド
	// ------------------------------------
	proc サウンド設定 {
		#if d:SOUND
			chara サウンドマネージャー ＳＤマネ -b 0x01000011 -e 0x0200007c -w 0xFE00007c,0xFE000080 -a 0xFE00007F
		#endif
	}

	// レーダー
	// ------------------------------------
	proc レーダー設定 {
		#if d:RADAR
			chara レーダー レーダー
		#endif
	}

	// プレイヤー 
	// ------------------------------------
	proc プレイヤー設定 {
		#if d:SNAKE
			chara プレイヤー d:PLAYER \
				-p $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,$i:プレイヤー初期Ｚ位置 \
//				-p 0, 5000, -12000 \
				-d 0,$i:プレイヤー初期方向,0 \
//				-d 0,0,0 \
				-s 0 \
				-m sna_def -a snake -o sna_w02a

				//バンダナ
				chara ロープモデル３ バンダナ１ \
					-n sna_bdn1 \
					-d 1 \
					-y スネーク \
					-z 12 \
					-x 0,60,-90 \
					-m 12 \
					-p 250 \
					-k 350 \
					-o 110 \
					-f 1

				chara ロープモデル３ バンダナ２ \
					-n sna_bdn2 \
					-d 1 \
					-y スネーク \
					-z 12 \
					-x 0,50,-90 \
					-m 22 \
					-p 250 \
					-k 350 \
					-o 110 \
					-f 1

		#else if d:RAIDEN
			chara プレイヤー d:PLAYER \
				-p $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,$i:プレイヤー初期Ｚ位置 \
//				-p 0, 5000, -12000 \
				-d 0,$i:プレイヤー初期方向,0 \
//				-s 0 \
				-m rai_def -a snake -o sna_w02a

		#endif
	}

	// 敵兵 
	// ------------------------------------
	#if d:ENEMY
		proc 攻撃兵０ {
			#if d:SHIELD
				chara アタッカー 敵兵:61 -r 0 -s 1 -e 1
				chara アタッカー 敵兵:62 -r 0 -s 1 -e 1
				chara アタッカー 敵兵:63 -r 0 -s 1 -e 1
			#else
				chara アタッカー 敵兵:61 -r 0 -s 1
				chara アタッカー 敵兵:62 -r 0 -s 1
				chara アタッカー 敵兵:63 -r 0 -s 1
			#endif
		}

		proc 警備兵０ {
			chara 警備兵 敵兵:01 -r 0 -n 0 -d -3000,-14000,-17500 ホール -s 1 -f 1
			chara 警備兵 敵兵:02 -r 1 -n 0 -d 0,-14000,-28000 ホール -s 1 -f 1
		}

		proc サポート兵 {
//			chara サポート兵 敵兵:31 -r 0 -s 1 -b 敵兵:02
		}

		proc 警備兵コマンダー {
			chara 警備コマンダー wccomm -e {警備兵０}
		}

		proc 攻撃兵コマンダー {
			chara 攻撃コマンダー atcomm -e 攻撃兵０
		}
		
	#endif

	proc コマンダー設定 {
		#if d:ENEMY
			chara コマンダー 敵兵セット \
				-w 警備兵コマンダー \
				-r 0,-14000,-32000 ホール \
				-c 0,-14000,-32000 ホール

		// 敵兵ルートチェンジ
			trap dr001 d:PLAYER \
				-mask 入る \	
				-exec {
					mesg 警備兵 敵兵:01 ルート変更 2 -3000,-14000,-17500 ホール
				}
		#endif
	}

