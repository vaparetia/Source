#define OBJECT_NAME17 sel_dead_acm4		// SEAL AC 死体
#define OBJECT_NAME18 sel_dead_bm4		// SEAL B 死体
#define OBJECT_NAME19 sel_dead_indoorm4	// SEAL 変電室死体

#define SHADOW_NAME1  vw14a0_obj00		// SEAL AC 死体影
#define SHADOW_NAME2  vw14a0_obj01		// SEAL B 死体影
#define SHADOW_NAME3  vw14a1_obj00		// 海軍大佐死体有り影
#define SHADOW_NAME4  vw14a1_obj01		// 海軍大佐死体無し影

#define DOOR_NAME1    w14a_dr00			// ＡＢ連絡橋への扉
#define DOOR_NAME2    w14a_dr01			// ＢＣ連絡橋への扉
#define DOOR_NAME3    dr_free			// 自由通過扉
#define DOOR_NAME4    w14a_hdr01		// 変電盤扉１(室内南)
