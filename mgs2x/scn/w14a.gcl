#if d:DEBUG_PRINT
	print '*** Clearing Area 0: Camera 0 ***'
#endif

	if(`@クリアリングエリア０内チェック`) {
		chara カメラ設定 クリアリングカメラ \
			-c 1 \
			-p -54572,3619,-19068 \
			-t -54731,2590,-21717 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1
