//-----------------------------------------------------------------------------
// ローカル

eval($f:Ｓローカルフラグ１ = 0)

eval($f:クリアリングフラグ０ = 0)	// クリアリング状態

#include "stageset.h"		// ステージ設定共通ヘッダ
#include "w14a_sdemo.h"		// シナリオデモヘッダ





//=============================================================================
// メイン
//=============================================================================

chara マップ 廊下 \
	-k d:KMS_NAME0 \
	-h d:HZX_NAME, 0 \
	-l d:LT2_NAME

chara マップ 変電室 \
	-k d:KMS_NAME2 \
	-h d:HZX_NAME, 1 \
	-l d:LT2_NAME

chara マップ接合 Ｂ脚接合１ 廊下 変電室
chara マップ接合 Ｂ脚接合２ 廊下 変電室

command マップ設定 廊下 変電室 -set {

	//----- 基本設定
	@SS_サウンド設定
	@SS_跳弾弾痕設定
	@レーダーオンオフチェック $f:w14a_ノードフラグ
	@常駐キャラ設定

	@プレイヤー設定
#if d:ENEMY_SET
	@敵兵設定
#endif
	@ＢＧＭ設定
	@爆弾タイマー設置
	@プラント編全体マップ設定 d:Ｂ脚マップ

	//----- オブジェクト(共通)
	@ドア設定
	@ロッカー設定
	@アイテム設定
	@爆弾解体設定
}

command マップ設定 廊下 -set {

	//----- オブジェクト(マップ別)
	@監視カメラ設定_廊下
	@天井君設定_廊下
	@その他オブジェクト設定_廊下
}

command マップ設定 変電室 -set {

	//----- ビヨンド、ジャンプ
	@ビヨンド設定_変電室

	//----- オブジェクト(マップ別)
	@ノード端末設定 3072
	@天井君設定_変電室
	@その他オブジェクト設定_変電室
}

command マップ設定 廊下 変電室 -set {

	//----- フォグ、カメラ、ロード
	@SS_フォグ_キャラ用ライト設定
	@カメラ設定
	@ストーリー設定
	@ロード設定
}

#include "w14a_cdc.ch"			// ※※ 通信機の include は移動させないこと！！ ※※
#include "p_force_cdc.ch"

if($s:登場ポイント == sp_demo_w14a_0) {
	command マップ表示 -show 変電室
} else {
	command マップ表示 -show 廊下
}

// レーダー当たり
command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 3
command 追加ＨＺＸグループ登録 -hzx_id 1 -add_id 3

// 影投影
command	影投影ハザード -name 変電室 -group 4

@ステージ進入時処理





