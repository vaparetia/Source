//-----------------------------------------------------------------------------
// スイッチ

#define STAGE_PLANT 1
#define STAGE_W14A  1

#define ENE_P_GOL     1
#define ENE_HIGH_TECH 1



#define RAIDEN     1
#if d:RAIDEN
#define PLAYER     ライデン
#else
#define PLAYER     スネーク
#endif

#define ENEMY_SET      1		// 敵兵の配置
#define STAGE_END      1		// ロードプロック
#define START_CAMERA   1		// ステージ開始時のカメラ
#define CTDOWN_TIMER_P 1		// 爆弾タイマー開始用
#define BOMB_STAGE     w14a		// 爆弾解体後処理用
#define NODE           1		// ノード
#define POLYDEMO_LOAD  1		// ポリデモへロード

#define SCREENSHOT     0		// スクリーンショット
#define KEYBOARD       0		// ＵＳＢキーボード

#define EX_TEX         1		// 説明テクスチャ
#define TEX_FADE_TIME  30		// 説明テクスチャのフェードインアウトタイム

//-----------------------------------------------------------------------------
// マップ関係

#define HZX_NAME      w14a
#define LT2_NAME      w14a

#define KMS_NAME0     w14a0				// 廊下
#define KMS_NAME1     w14a0r			// 廊下天井
#define KMS_NAME2     w14a1				// 変電室
#define KMS_NAME3     w14a1r			// 変電室天井
#define KMS_NAME4     w14a1_sdw			// 変電室影投影モデル
#define KMS_NAME5     w14a1_wall1_1		// 破壊壁 階段下
#define KMS_NAME6     w14a1_wall2_1		// 破壊壁 配電盤横
#define KMS_NAME7     w14a_13a			// ロード部モデル ＡＢ連絡橋
#define KMS_NAME8     w14a_15a			// ロード部モデル ＢＣ連絡橋

#define OBJECT_NAME1  w14a_roofobj_01	// 天井
#define OBJECT_NAME2  w14a_fence_a01	// フェンスＡ１
#define OBJECT_NAME3  w14a_fence_a02	// フェンスＡ２
#define OBJECT_NAME4  w14a_fence_a03	// フェンスＡ３
#define OBJECT_NAME5  w14a_fence_a04	// フェンスＡ４
#define OBJECT_NAME6  w14a_fence_a05	// フェンスＡ５
#define OBJECT_NAME7  w14a_fence_a06	// フェンスＡ６
#define OBJECT_NAME8  w14a_fence_a07	// フェンスＡ７
#define OBJECT_NAME9  w14a_fence_a08	// フェンスＡ８
#define OBJECT_NAME10 w14a_fence_b01	// フェンスＢ１
#define OBJECT_NAME11 w14a_fence_b02	// フェンスＢ２
#define OBJECT_NAME12 w14a_fence_b03	// フェンスＢ３

#define OBJECT_NAME13 sel_dead_ac		// SEAL AC 死体
#define OBJECT_NAME14 sel_dead_b		// SEAL B 死体
#define OBJECT_NAME15 sel_dead_indoor	// SEAL 変電室死体
