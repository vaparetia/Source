//=============================================================================
// 基本設定
//=============================================================================

//-----------------------------------------------------------------------------
// プレイヤー設定
proc プレイヤー設定 {
#if d:DEBUG_PRINT
	print '*** Player Set ***'
#endif

	// プレイヤー設定
	//   $:強制モーションファイル $:ＬＯＤ距離
	@SS_プレイヤー設定 rai_w14a 5000
}

//-----------------------------------------------------------------------------
// 敵兵設定

// 警備兵
//   �� 3		変電室ぐるぐる
//   �� 4		変電室下監視
//   �� 5		廊下上下 0:南スタート 2:北スタート
//
// 守備位置
//   -55000     0 -22000 廊下
//   -55000     0 -41000 廊下
//   -52250     0 -31500 変電室
//   -46625     0 -26750 変電室
//   -44250 -2000 -38250 変電室
//
// 再発生位置
//   -52125 0 -50250 廊下
//   -34500 0 -20500 廊下

//----- 警備兵設定
//        $:名前 $:ルート $:ノード $:ステータス $:守備Ｘ $:守備Ｙ $:守備Ｚ $:守備マップ $:ＩＤ
proc 警備兵セット１ {
#if d:DEBUG_PRINT 
	print '*** Watcher Set 1 ***'
#endif

	if($s:登場ポイント == sp_w13a_w14a_0) {				// ＡＢ連絡橋から
		@SS_警備兵設定 敵兵:01 3 0 ($i:SS_敵兵ステータス) -55000 0 -41000 廊下 (d:SS_警備兵ＩＤ:Ｂ脚変電室兵)
	} else {
		@SS_警備兵設定 敵兵:01 3 0 ($i:SS_敵兵ステータス) -48000 0 -19250 廊下 (d:SS_警備兵ＩＤ:Ｂ脚変電室兵)
	}

	if($s:登場ポイント == sp_w13a_w14a_0) {				// ＡＢ連絡橋から
		@SS_警備兵設定 敵兵:02 5 0 ($i:SS_敵兵ステータス) -55000 0 -28250 廊下 (d:SS_警備兵ＩＤ:Ｂ脚廊下兵)
	} else if($s:登場ポイント == sp_w15a_w14a_0) {		// ＢＣ連絡橋から
		@SS_警備兵設定 敵兵:02 5 2 ($i:SS_敵兵ステータス) -55000 0 -28250 廊下 (d:SS_警備兵ＩＤ:Ｂ脚廊下兵)
	} else {											// ダンボールで
		@SS_警備兵設定 敵兵:02 5 2 ($i:SS_敵兵ステータス) -55000 0 -28250 廊下 (d:SS_警備兵ＩＤ:Ｂ脚廊下兵)
	}
}

proc 警備兵セット２ {
#if d:DEBUG_PRINT 
	print '*** Watcher Set 2 ***'
#endif

	if($s:登場ポイント == sp_w13a_w14a_0) {				// ＡＢ連絡橋から
		@SS_警備兵設定 敵兵:01 3 0 ($i:SS_敵兵ステータス) -55000 0 -41000 廊下 (d:SS_警備兵ＩＤ:Ｂ脚変電室兵)
	} else {
		@SS_警備兵設定 敵兵:01 3 0 ($i:SS_敵兵ステータス) -48000 0 -19250 廊下 (d:SS_警備兵ＩＤ:Ｂ脚変電室兵)
	}
	@SS_警備兵設定 敵兵:02 4 0 ($i:SS_敵兵ステータス) -55000 0 -28250 廊下 (d:SS_警備兵ＩＤ:Ｂ脚廊下兵)
}

//----- サポート兵設定
//        $:名前 $:ルート $:ステータス $:相手 $:守備Ｘ $:守備Ｙ $:守備Ｚ $:守備マップ
proc サポート兵セット１ {
#if d:DEBUG_PRINT
	print '*** Support Set 1 ***'
#endif

	if($s:登場ポイント == sp_w13a_w14a_0) {				// ＡＢ連絡橋から
		@SS_サポート兵設定 敵兵:31 2 ($i:SS_敵兵ステータス) 敵兵:01

	} else if($s:登場ポイント == sp_w15a_w14a_0) {		// ＢＣ連絡橋から
		@SS_サポート兵設定 敵兵:31 1 ($i:SS_敵兵ステータス) 敵兵:01

	} else {											// ダンボールで
		@SS_サポート兵設定 敵兵:31 1 ($i:SS_敵兵ステータス) 敵兵:01
	}
}

//----- アタッカー設定
//        $:名前 $:ルート $:ステータス $:装備
proc アタッカーセット１ {
#if d:DEBUG_PRINT 
	print '*** Attacker Set 1 ***'
#endif

	if($w:p_story < d:ST:P041_02_R01エイムズ死亡後２無線デモ１終了) {
		@SS_アタッカー設定 敵兵:21 1 ($i:SS_敵兵ステータス) 0
		@SS_アタッカー設定 敵兵:22 1 ($i:SS_敵兵ステータス) 0
	} else {
		@SS_アタッカー設定 敵兵:21 1 ($i:SS_敵兵ステータス) 4
		@SS_アタッカー設定 敵兵:22 1 ($i:SS_敵兵ステータス) 4
	}

	// サポート兵
	if($w:p_story >= d:ST:P041_02_R01エイムズ死亡後２無線デモ１終了) {
		@サポート兵セット１
	}
}
proc アタッカーセット２ {
#if d:DEBUG_PRINT 
	print '*** Attacker Set 2 ***'
#endif

	if($w:p_story < d:ST:P041_02_R01エイムズ死亡後２無線デモ１終了) {
		@SS_アタッカー設定 敵兵:21 2 ($i:SS_敵兵ステータス) 0
		@SS_アタッカー設定 敵兵:22 2 ($i:SS_敵兵ステータス) 0
	} else {
		@SS_アタッカー設定 敵兵:21 2 ($i:SS_敵兵ステータス) 4
		@SS_アタッカー設定 敵兵:22 2 ($i:SS_敵兵ステータス) 4
	}

	// サポート兵
	if($w:p_story >= d:ST:P041_02_R01エイムズ死亡後２無線デモ１終了) {
		@サポート兵セット１
	}
}





//----- コマンダー
proc 警備兵コマンダー {
#if d:DEBUG_PRINT 
	print '*** Watcher Commander ***'
#endif

	if($w:p_story < d:ST:P010_10_P05ヴァンプ遭遇１０ポリゴンデモ５終了) {
		// 初登場時


	} else if($w:p_story < d:ST:P014_15_P07ピーター遭遇１５ポリゴンデモ７終了) {
		// 爆弾解体前


	} else if($w:p_story < d:ST:P024_01_R01爆弾解体センサーＢ入手１無線デモ１終了) {
		// 爆弾解体
		if ($w:ゲーム設定 < d:LEVEL_HARD) {
			chara 警備コマンダー wccomm -e { 警備兵セット１ }
		} else {
			chara 警備コマンダー wccomm -e { 警備兵セット２ }
		}

	} else if($w:p_story < d:ST:P031_01_P01フォーチュン戦終了１ポリゴンデモ１終了) {
		// センサーＢ
		if ($w:ゲーム設定 < d:LEVEL_HARD) {
			chara 警備コマンダー wccomm -e { 警備兵セット１ }
		} else {
			chara 警備コマンダー wccomm -e { 警備兵セット２ }
		}

	} else if($w:p_story < d:ST:P036_13_R04忍者登場１３無線デモ４終了) {
		// フォーチュン戦後
		if ($w:ゲーム設定 < d:LEVEL_HARD) {
			chara 警備コマンダー wccomm -e { 警備兵セット１ }
		} else {
			chara 警備コマンダー wccomm -e { 警備兵セット２ }
		}

	} else if($w:p_story < d:ST:P041_02_R01エイムズ死亡後２無線デモ１終了) {
		// ファットマン戦後
		if ($w:ゲーム設定 < d:LEVEL_HARD) {
			chara 警備コマンダー wccomm -e { 警備兵セット１ }
		} else {
			chara 警備コマンダー wccomm -e { 警備兵セット２ }
		}

	} else {
		// エイムズ後
		if ($w:ゲーム設定 < d:LEVEL_HARD) {
			chara 警備コマンダー wccomm -e { 警備兵セット１ }
		} else {
			chara 警備コマンダー wccomm -e { 警備兵セット２ }
		}
	}
}

proc 攻撃兵コマンダー {
#if d:DEBUG_PRINT 
	print '*** Attacker Commander ***'
#endif

	if($s:登場ポイント == sp_w13a_w14a_0) {				// ＡＢ連絡橋から
		chara 攻撃コマンダー atcomm -e { アタッカーセット２ }
	} else if($s:登場ポイント == sp_w15a_w14a_0) {		// ＢＣ連絡橋から
		chara 攻撃コマンダー atcomm -e { アタッカーセット１ }
	} else {											// ダンボールで
		chara 攻撃コマンダー atcomm -e { アタッカーセット１ }
	}
}





//----- 敵兵設定

proc 敵兵設定 {
#if d:DEBUG_PRINT
	print '*** Enemy Set ***'
#endif

	//---------------------------------------------------------
	// 敵兵ステータス
	eval($i:SS_敵兵ステータス = d:ENE_STATUS_GUNLIGHT)	// 通常は 0

	//---------------------------------------------------------
	// コマンダー
	//   -w 警備コマンダーproc  -a 攻撃コマンダーproc  -r 復活場所 マップＩＤ  -c 待機場所 マップＩＤ  -v 音声  -m 危険モード  -p クリアリングエリア ルート ポイント プロック  -x 司令官危険音声  -y 司令官警戒音声  -g 銃ライト  -z 麻酔持続時間  -b 危険モードでの復活人数 
	if($w:p_story < d:ST:P014_15_P07ピーター遭遇１５ポリゴンデモ７終了) {
		// 潜入モードへ戻す
		// ALERT_MODE_SENNYU
		// ALERT_MODE_KIKEN
		// ALERT_MODE_KAIHI
		// ALERT_MODE_TANSAKU
		eval($w:スタートアラートモード = d:ALERT_MODE_SENNYU)

	} else {
		chara コマンダー 敵兵セット \
			-w 警備兵コマンダー \
			-a 攻撃兵コマンダー \
			-d 廊下 \
			-r -52125 0 -50250 廊下 -34500 0 -20500 廊下 \
			-c -52125 0 -50250 廊下 -34500 0 -20500 廊下 \
			-v [ene_plant_voice:01] \
			-x [ghq_area_alert_voice:w14a] \
			-y [ghq_caution_voice:w14a] \
			-p  0,-1,-1 クリアリングエリア０_初期設定 \
			    0,-2,-2 クリアリングエリア０_終了 \
			   -2,-2,-2 クリアリングカメラＯＦＦ \
			-z $i:敵標準麻酔持続 \
			-h $i:標準警戒時間 \
			-o $i:敵標準気絶持続 \
			-s d:ENE_STAGE_GPS \
			-b $w:敵標準再発生数 \
			-m $w:スタートアラートモード

		//---------------------------------------------------------
		// クリアリング子画面
	//	chara サブ画面 子画面

		//---------------------------------------------------------
		// クリアリングエリア０ 子画面制御
		trap clearing_0 d:PLAYER \
			-mask 出る \
			-exec {
				if($f:クリアリングフラグ０ == 1) {
					@クリアリングカメラＯＦＦ
				}
			}
	}
}
proc クリアリングカメラＯＦＦ {
#if d:DEBUG_PRINT
	print '*** Clearing Camera OFF ***'
#endif

	mesg サブ画面 子画面 off
	chara カメラ設定 クリアリングカメラ -s 0
}

//-----------------------------------------------------------------------------
// クリアリングエリア０設定
proc クリアリングエリア０_初期設定 {
#if d:DEBUG_PRINT
	print '*** Clearing Area 0: Init ***'
#endif

	if($w:p_story < d:ST:P041_02_R01エイムズ死亡後２無線デモ１終了) {
		if($s:登場ポイント == sp_w13a_w14a_0) {
			command セットクリアリング \
			//	-p 0,0,0,クリアリングエリア０_カメラ０ \
			//	   0,0,6,クリアリングエリア０_カメラ１ \
			//	   0,0,14,クリアリングエリア０_カメラ２ \
			//	   0,0,19,クリアリングエリア０_カメラ３ \
				-i 0,1
		} else {
			command セットクリアリング \
			//	-p 0,2,0,クリアリングエリア０_カメラ１０ \
			//	   0,2,6,クリアリングエリア０_カメラ１１ \
			//	   0,2,11,クリアリングエリア０_カメラ１２ \
			//	   0,2,18,クリアリングエリア０_カメラ１３ \
			//	   0,3,12,クリアリングエリア０_カメラ１４ \
				-i 2,3
		}
	} else {
		if($s:登場ポイント == sp_w13a_w14a_0) {
			command セットクリアリング \
			//	-p 0,0,0,クリアリングエリア０_カメラ０ \
			//	   0,0,6,クリアリングエリア０_カメラ１ \
			//	   0,0,14,クリアリングエリア０_カメラ２ \
			//	   0,0,19,クリアリングエリア０_カメラ３ \
				-i 0,1,4
		} else {
			command セットクリアリング \
			//	-p 0,2,0,クリアリングエリア０_カメラ１０ \
			//	   0,2,6,クリアリングエリア０_カメラ１１ \
			//	   0,2,11,クリアリングエリア０_カメラ１２ \
			//	   0,2,18,クリアリングエリア０_カメラ１３ \
			//	   0,3,12,クリアリングエリア０_カメラ１４ \
				-i 2,3,5
		}
	}

	eval($f:クリアリングフラグ０ = 1)
}
proc クリアリングエリア０内チェック {
#if d:DEBUG_PRINT
	print '*** Clearing Area 0: Bounding Check ***'
#endif

	if(    (-53375 < $i:プレイヤー位置Ｘ) && ($i:プレイヤー位置Ｘ < -43500) \
		&& (-39125 < $i:プレイヤー位置Ｚ) && ($i:プレイヤー位置Ｚ < -22500)) {
	//	return 1;
		return 0;
	} else {
		return 0;
	}
}
