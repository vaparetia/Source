//-----------------------------------------------------------------------------
// ＢＧＭ設定
proc ＢＧＭ設定 {
#if d:DEBUG_PRINT
	print '*** BGM Set ***'
#endif

	@SS_ＢＧＭ設定

	trap ca101 d:PLAYER \
		-mask 入る \
		-exec {
		#if d:DEBUG_PRINT
			print '*** SD_AUTO_FADER2 ***'
		#endif

			mesg ＢＧＭマネージャー ＢＧＭマネ SD_SNEAK_AUTO d:SD_AUTO_FADER2
		}
	trap ca002 d:PLAYER \
		-mask 入る \
		-exec {
		#if d:DEBUG_PRINT
			print '*** SD_AUTO_FADER1 ***'
		#endif

			mesg ＢＧＭマネージャー ＢＧＭマネ SD_SNEAK_AUTO d:SD_AUTO_FADER1
		}
	trap ca003 d:PLAYER \
		-mask 入る \
		-exec {
		#if d:DEBUG_PRINT
			print '*** SD_AUTO_FADER1 ***'
		#endif

			mesg ＢＧＭマネージャー ＢＧＭマネ SD_SNEAK_AUTO d:SD_AUTO_FADER1
		}

	if($s:登場ポイント == sp_demo_w14a_0) {
		mesg ＢＧＭマネージャー ＢＧＭマネ SD_SNEAK_AUTO d:SD_AUTO_FADER2
	} else {
		mesg ＢＧＭマネージャー ＢＧＭマネ SD_SNEAK_AUTO d:SD_AUTO_FADER1
	}
}





//=============================================================================
// ビヨンド、ジャンプ
//=============================================================================

//-----------------------------------------------------------------------------
// ビヨンド設定
proc ビヨンド設定_変電室 {
#if d:DEBUG_PRINT
	print '*** Beyond Set: Substation ***'
#endif

	@SS_東ビヨンド登録 by001
}

//-----------------------------------------------------------------------------
// CB_ビヨンド
proc SS_CB_ビヨンド $:トラップ名 $:フラグ $:トリガ $:ＰＸ $:ＰＹ $:ＰＺ {
#if d:DEBUG_PRINT
	print '*** SS CB Beyond ***'
#endif

	//---------------------------------------------------------
	// ビヨンド発動処理
	if($:フラグ == 0) {

		if($i:プレイヤー位置Ｙ > 0) {	// 下での誤発動防止

			// トラップ名  柵の位置  Ｘ座標／Ｚ座標  トラップ幅１  トラップ幅２  フラグ
			@東向きビヨンド発動 $1 -45950 $6 -35250 -26250 d:BY_NOFOOTSHADOW
		}

	//---------------------------------------------------------
	// ビヨンドカメラ処理
	} else {
		if($:フラグ == 1) {
			//=====================================
			// ビヨンド発動カメラ
			//=====================================
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p -44501,-470,-22638 \
				-t -45911, 799,-27794 \
				-r -152,2222,0 \
				-f 5494 \
				-a 200 \
				-i 0 -1 0 0 \
				-s 1
		} else if($:フラグ == 2) {
			//=====================================
			// ビヨンド中カメラ
			//=====================================
			chara カメラ設定 モーションカメラ \
//				-c 0 \
//				-b d:CAM_MIN d:CAM_MIN d:CAM_MIN d:CAM_MAX d:CAM_MAX d:CAM_MAX \
//				-l d:CAM_MIN d:CAM_MIN d:CAM_MIN d:CAM_MAX d:CAM_MAX d:CAM_MAX \
//				-r 840,2214,0 \
//				-f 3000 \
//				-a 244 \
//				-i 2 2 0 0 \
//				-z d:CAMERA_NO_CUSHION \
//				-s $3
				-c 1 \
				-p -44979,2870,-23966 \
				-t -46321,615,-27384 \
				-a 170 \
				-i 2 2 0 0 \
				-s $3
		}
	}
}





//=============================================================================
// オブジェクト
//=============================================================================

//-----------------------------------------------------------------------------
// ドア設定
proc ドア設定 {
#if d:DEBUG_PRINT
	print '*** Door Set ***'
#endif

	// ドア
	//   -m オブジェクト名  -d 向き  -p 場所  -slide スライド量  -time 時間  -between マップ名１ マップ名２  -exec { $:開閉フラグ }

	// ＡＢ連絡橋へのドア
	@ドアランプ設定 ＡＢ連絡橋へのドアランプ 3072 -44125 0 -20000 0
//	@主観禁止壁     ＡＢ連絡橋へのドア壁          -44125 0 -20000 3072 d:SD_SLIDE_OUTSIDE
	chara ドア ＡＢ連絡橋へのドア \
		-m d:DOOR_NAME1 \
		-d 0 3072 0 \
		-p -44125 0 -20000 \
		-s d:SD_SLIDE_OUTSIDE \
		-t d:SD_OPEN_TIME \
		-A ＡＢ連絡橋へのドアランプ \
		-b 廊下 廊下 \
		-exec {
			if(!($:開閉フラグ)) {
				mesg プットオブジェ ＡＢ連絡橋ロード部 off	// ロード部モデル
				mesg ローカル風 隙間風 オフ
			} else {
				mesg プットオブジェ ＡＢ連絡橋ロード部 on	// ロード部モデル
				mesg ローカル風 隙間風 オン
			}
		}
	trap dr001 ？ -mask ？ \
		-exec {
			if($3 == 入る) {
				mesg ドア ＡＢ連絡橋へのドア open
			} else if($3 == 出る) {
				mesg ドア ＡＢ連絡橋へのドア close
			}
		}
	trap dr001 d:PLAYER -mask ？ \
		-state d:TRP_STATE_SUBJECT \
		-exec {
			if($3 == 入る) {
				mesg 透明壁 ＡＢ連絡橋へのドア壁 on
			} else if($3 == 出る) {
				mesg 透明壁 ＡＢ連絡橋へのドア壁 off
			}
		}

	// ＢＣ連絡橋へのドア
	@ドアランプ設定 ＢＣ連絡橋へのドアランプ 0 -55500 0 -43625 0
//	@主観禁止壁     ＢＣ連絡橋へのドア壁       -55500 0 -43625 0 d:SD_SLIDE_OUTSIDE
	chara ドア ＢＣ連絡橋へのドア \
		-m d:DOOR_NAME2 \
		-d 0 0 0 \
		-p -55500 0 -43625 \
		-s d:SD_SLIDE_OUTSIDE \
		-t d:SD_OPEN_TIME \
		-A ＢＣ連絡橋へのドアランプ \
		-b 廊下 廊下 \
		-exec {
			if(!($:開閉フラグ)) {
				mesg プットオブジェ ＢＣ連絡橋ロード部 off	// ロード部モデル
				mesg ローカル風 隙間風 オフ
			} else {
				mesg プットオブジェ ＢＣ連絡橋ロード部 on	// ロード部モデル
				mesg ローカル風 隙間風 オン
			}
		}
	trap dr002 ？ -mask ？ \
		-exec {
			if($3 == 入る) {
				mesg ドア ＢＣ連絡橋へのドア open
			} else if($3 == 出る) {
				mesg ドア ＢＣ連絡橋へのドア close
			}
		}
	trap dr002 d:PLAYER -mask ？ \
		-state d:TRP_STATE_SUBJECT \
		-exec {
			if($3 == 入る) {
				mesg 透明壁 ＢＣ連絡橋へのドア壁 on
			} else if($3 == 出る) {
				mesg 透明壁 ＢＣ連絡橋へのドア壁 off
			}
		}

	// 部屋西側のドア
	@ドアランプ設定 部屋西側のドアランプ 1024 -53375 0 -24500 1
	chara ドア 部屋西側のドア \
		-m d:DOOR_NAME3 \
		-d 0 1024 0 \
		-p -53375 0 -24500 \
		-s d:SD_SLIDE_INSIDE \
		-t d:SD_OPEN_TIME \
		-l 影投影モデル \			// 影投影モデル
		-A 部屋西側のドアランプ \
		-b 廊下 変電室 \
		-exec {
			if(!($:開閉フラグ)) {
				mesg マップ接合 Ｂ脚接合１ off
				if($i:プレイヤー位置Ｘ < -53375) {
					mesg レンズフレア レンズフレア アルファ変更 0 1		// レンズフレア処理
				}
			} else {
				mesg マップ接合 Ｂ脚接合１ on
				mesg レンズフレア レンズフレア アルファ変更 8 1	// レンズフレア処理
			}
		}
	trap dr003 ？ -mask ？ \
		-exec {
			if($3 == 入る) {
				mesg ドア 部屋西側のドア open
			} else if($3 == 出る) {
				mesg ドア 部屋西側のドア close
			}
		}

	// 部屋北側のドア
	@ドアランプ設定 部屋北側のドアランプ 2048 -49750 0 -39125 0
	chara ドア 部屋北側のドア \
		-m d:DOOR_NAME3 \
		-d 0 2048 0 \
		-p -49750 0 -39125 \
		-s d:SD_SLIDE_INSIDE \
		-t d:SD_OPEN_TIME \
		-A 部屋北側のドアランプ \
		-b 廊下 変電室 \
		-exec {
			if(!($:開閉フラグ)) {
				mesg マップ接合 Ｂ脚接合２ off
				if($i:プレイヤー位置Ｚ < -39125) {
					mesg レンズフレア レンズフレア アルファ変更 0 1		// レンズフレア処理
				}
			} else {
				mesg マップ接合 Ｂ脚接合２ on
				mesg レンズフレア レンズフレア アルファ変更 8 1	// レンズフレア処理
			}
		}
	trap dr004 ？ -mask ？ \
		-exec {
			if($3 == 入る) {
				mesg ドア 部屋北側のドア open
			} else if($3 == 出る) {
				mesg ドア 部屋北側のドア close
			}
		}
}

//-----------------------------------------------------------------------------
// ロッカー設定
proc ロッカー設定 {
#if d:DEBUG_PRINT
	print '*** Locker Set ***'
#endif

	chara ロッカー管理 管理人さん -n 7
	command ロッカーモーション -motion locker
	command プレイヤーロッカーモーション -motion sna_locker

	// $:ロッカー名 $:トラップ名 $:番号 $:モデル名 $:Ｘ座標 $:Ｙ座標 $:Ｚ座標 $:ステータス $:壁音番号 $:倒れ時床音番号 $:フラグ $:倒れシフトＸ $:倒れシフトＹ $:倒れシフトＺ $:倒れ回転Ｙ $:影ＩＤ {
	@SS_北ロッカー登録 ロッカー:01 lk001 0 (d:DOOR_NAME9)  -50000 0 -42875 (d:LOCKER_STATE_POSTER)      2 2 (0)                           0 0   0 -200 (0)
	@SS_北ロッカー登録 ロッカー:02 lk002 1 (d:DOOR_NAME8)  -49000 0 -42875 (0)                          2 2 (0)                           0 0   0  100 (0)
	@SS_北ロッカー登録 ロッカー:03 lk003 2 (d:DOOR_NAME8)  -48000 0 -42875 (d:LOCKER_STATE_DESTROY)     2 2 (0)                           0 0   0    0 (0)
	@SS_西ロッカー登録 ロッカー:04 lk004 3 (d:DOOR_NAME7)  -57000 0 -34750 (d:LOCKER_STATE_NO_OPEN_SEG) 2 2 (0)                           0 0   0 1032 (0)
	@SS_西ロッカー登録 ロッカー:05 lk005 4 (d:DOOR_NAME6)  -57000 0 -28750 (d:LOCKER_STATE_NO_OPEN_SEG) 2 2 (0)                           0 0   0  910 (0)
	@SS_西ロッカー登録 ロッカー:06 lk006 5 (d:DOOR_NAME5)  -52880 0 -38750 (d:LOCKER_STATE_OPEN)        2 2 (d:LOCKER_FLAG_SHADOWWRITE)   0 0 150  890 (影投影モデル)
	@SS_西ロッカー登録 ロッカー:07 lk007 6 (d:DOOR_NAME4)  -52880 0 -37750 (0)                          2 2 (d:LOCKER_FLAG_SHADOWWRITE) 300 0   0  700 (影投影モデル)
}

//-----------------------------------------------------------------------------
// CB_ロッカーチェック
proc SS_CB_ロッカーチェック $:番号 {
#if d:DEBUG_PRINT
	print '*** SS CB Locker Check ***'
#endif

	@壊れ物再セットチェック $b:w14a_破壊ロード回数[$:番号]
	if($f:再セットフラグ) {
		eval($i:w14a_ロッカー状態[$:番号] = 0)
	}

	return $i:w14a_ロッカー状態[$:番号]
}

//-----------------------------------------------------------------------------
// CB_ロッカー状態保存
proc SS_CB_ロッカー状態保存 $:開始終了 $:実行キャラ $:行動 $:ロッカー名 {
#if d:DEBUG_PRINT
	print '*** SS CB Locker Save ***'
#endif

	// ロッカー名と番号の対応
	if($:ロッカー名 == ロッカー:01) {
		eval($i:SS_ロッカー番号 = 0)
	} else if($:ロッカー名 == ロッカー:02) {
		eval($i:SS_ロッカー番号 = 1)
	} else if($:ロッカー名 == ロッカー:03) {
		eval($i:SS_ロッカー番号 = 2)
	} else if($:ロッカー名 == ロッカー:04) {
		eval($i:SS_ロッカー番号 = 3)
	} else if($:ロッカー名 == ロッカー:05) {
		eval($i:SS_ロッカー番号 = 4)
	} else if($:ロッカー名 == ロッカー:06) {
		eval($i:SS_ロッカー番号 = 5)
	} else if($:ロッカー名 == ロッカー:07) {
		eval($i:SS_ロッカー番号 = 6)
	}

	// 状態保存
	if(($:行動 != 6) && ($:行動 != 8)) {
		// 状態変化時
		eval($b:w14a_破壊ロード回数[$i:SS_ロッカー番号] = $w:グローバルロード回数);

	} else if($:行動 == 8) {
		// ステージ終了時
		command ロッカー状態 -n $:ロッカー名
		eval($i:w14a_ロッカー状態[$i:SS_ロッカー番号] = $status)
	}
}

//-----------------------------------------------------------------------------
// CB_ロッカー実行
proc SS_CB_ロッカー実行 $:トラップ名 $:フラグ $:トリガ $:ＰＸ $:ＰＹ $:ＰＺ {
#if d:DEBUG_PRINT
	print '*** SS CB Locker ***'
#endif

	//---------------------------------------------------------
	// 開閉実行処理
	if($:フラグ == 0) {

		command プレイヤー状態取得
		eval($f:Ｓローカルフラグ１ = (($status & d:PFLAG_CAUTION) != 0))	// 張付き時 1

		if($:トラップ名 == lk001) {
			command ロッカー状態 -n ロッカー:01
			mesg プレイヤー d:PLAYER locker ロッカー:01 $status 2048,512 (-50000-50),-42875
		} else if($:トラップ名 == lk002) {
			command ロッカー状態 -n ロッカー:02
			mesg プレイヤー d:PLAYER locker ロッカー:02 $status 2048,512 (-49000-50),-42875
		} else if($:トラップ名 == lk003) {
			command ロッカー状態 -n ロッカー:03
			mesg プレイヤー d:PLAYER locker ロッカー:03 $status 2048,512 (-48000-50),-42875
		} else if($:トラップ名 == lk004) {
			command ロッカー状態 -n ロッカー:04
			if(!(($status & 0x0002) && ($f:Ｓローカルフラグ１))) {	// 開いている時に張付きで起動しない
				mesg プレイヤー d:PLAYER locker ロッカー:04 $status 3072,512 -57000,(-34750+50)
			}
		} else if($:トラップ名 == lk005) {
			command ロッカー状態 -n ロッカー:05
			if(!(($status & 0x0002) && ($f:Ｓローカルフラグ１))) {	// 開いている時に張付きで起動しない
				mesg プレイヤー d:PLAYER locker ロッカー:05 $status 3072,512 -57000,(-28750+50)
			}
		} else if($:トラップ名 == lk006) {
			command ロッカー状態 -n ロッカー:06
			if(!(($status & 0x0002) && ($f:Ｓローカルフラグ１))) {	// 開いている時に張付きで起動しない
				mesg プレイヤー d:PLAYER locker ロッカー:06 $status 3072,512 -52880,(-38750+50)
			}
		} else if($:トラップ名 == lk007) {
			command ロッカー状態 -n ロッカー:07
			if(!(($status & 0x0002) && ($f:Ｓローカルフラグ１))) {	// 開いている時に張付きで起動しない
				mesg プレイヤー d:PLAYER locker ロッカー:07 $status 3072,512 -52880,(-37750+50)
			}
		}

	//---------------------------------------------------------
	// 開閉カメラ処理
	} else {
		if($:トラップ名 == lk001) {
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p -52920,3949,-40974 \
				-t -50276,793,-43024 \
				-a 200 \
				-i 0 2 0 0 \
				-s $3
		} else if($:トラップ名 == lk002) {
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p -52363,4292,-40782 \
				-t -49722,1130,-42830 \
				-a 200 \
				-i 0 2 0 0 \
				-s $3
		} else if($:トラップ名 == lk003) {
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p -50953,4266,-40702 \
				-t -48319,1083,-42744 \
				-a 200 \
				-i 0 2 0 0 \
				-s $3
		} else if($:トラップ名 == lk004) {
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p -55690,5303,-32955 \
				-t -56446,1071,-34638 \
				-a 200 \
				-i 0 2 0 0 \
				-s $3
		} else if($:トラップ名 == lk005) {
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p -55670,5144,-26998 \
				-t -56410,906,-28683 \
				-a 200 \
				-i 0 2 0 0 \
				-s $3
		} else if($:トラップ名 == lk006) {
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p -51443,4454,-36506 \
				-t -53047,-216,-38907 \
				-a 200 \
				-i 0 2 0 0 \
				-s $3

			// 爆弾発見カメラデモ
			if($f:w14a爆弾を発見した == 0) {
 				eval($f:w14a爆弾を発見した = 1);
				command varsave $f:w14a爆弾を発見した

				if(    ($w:アラートモード == d:ALERT_MODE_SENNYU) \
					&& (`command ゲームオーバーチェック` == 0)) {
					chara delay カメラ遅延 \
						-time 60 -exec {
							@シナリオカメラデモ（シネマ） 45 -52001,3213,-37600 -52340,1398,-38532 200 -52498,1270,-38471 -52846,-537,-39406 200
						}
				}
			}
		} else if($:トラップ名 == lk007) {
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p -51419,4099,-35826 \
				-t -53008,-582,-38221 \
				-a 200 \
				-i 0 2 0 0 \
				-s $3
		}
	}
}

//-----------------------------------------------------------------------------
// アイテム設定
proc アイテム設定 {
#if d:DEBUG_PRINT
	print '*** Item Set ***'
#endif

	// ソコムサプレッサー
	if($w:ゲーム設定 == d:LEVEL_VERYEASY) {
		if(     ($w:アイテム数Ｒ[ d:アイテム:ソコムサプレッサ ] == 0) \
			&& !($w:プレイヤーフラグ & d:PL_SOCOM_SPPRSR_ATTACHED)) {
			@ソコムサプレッサ_初期設置 ソコムサプレッサ_初期設置 -52000 0 -23750 0
		}
	}

	// ソコム弾薬
	@アイテム再セットチェック $b:w14a_取得ロード回数[0]
	if($f:再セットフラグ) {
		@弾薬_ソコム_初期設置 ソコム弾薬:01 -48750 -2000 -24500 0
	}

	// ソコム弾薬
	@アイテム再セットチェック $b:w14a_取得ロード回数[1]
	if($f:再セットフラグ) {
		@弾薬_ソコム_初期設置 ソコム弾薬:02 -50500 200 -43125 0
	}

	// Ｍ９弾薬
	@アイテム再セットチェック $b:w14a_取得ロード回数[2]
	if($f:再セットフラグ) {
		@弾薬_Ｍ９_初期設置 Ｍ９弾薬:01 -46625 0 -34875 0
	}

	// レーション
	@アイテム再セットチェック（難易度対応） $b:w14a_取得ロード回数[3]
	if($f:再セットフラグ) {
		@レーション_初期設置 レーション:01 -49500 200 -43125 0
	}
}

proc アイテム取得時番号設定 $:ボックス名 {
#if d:DEBUG_PRINT
	print '*** Item No Set ***'
#endif

	if($:ボックス名 == ソコム弾薬:01) {
		eval($b:w14a_取得ロード回数[0] = $w:グローバルロード回数);
	} else if($:ボックス名 == ソコム弾薬:02) {
		eval($b:w14a_取得ロード回数[1] = $w:グローバルロード回数);
	} else if($:ボックス名 == Ｍ９弾薬:01) {
		eval($b:w14a_取得ロード回数[2] = $w:グローバルロード回数);
	} else if($:ボックス名 == レーション:01) {
		eval($b:w14a_取得ロード回数[3] = $w:グローバルロード回数);
	}

#if d:DEBUG_PRINT
	print $:ボックス名
	print $w:グローバルロード回数
#endif
}

//-----------------------------------------------------------------------------
// 爆弾解体設定
proc 爆弾解体設定 {
#if d:DEBUG_PRINT
	print '*** Bomb Set ***'
#endif

	// 爆弾解体設定
	//   $:爆弾名 $:処理状態フラグ $:Ｘ座標 $:Ｙ座標 $:Ｚ座標 $:Ｘ回転 $:Ｙ回転 $:Ｚ回転
	@SS_爆弾解体設定 w14a匂い爆弾 $f:w14a_爆弾処理完了 -52625 375 -39000 0 0 1024
}





//-----------------------------------------------------------------------------
// ノード端末設定
proc ノード接続時プロック {
	#if d:DEBUG_PRINT
		print '*** Node Set ***'
	#endif

	eval($f:ノードフラグ = $f:w14a_ノードフラグ);
}

proc ノード接続後プロック {
	#if d:DEBUG_PRINT
		print '*** Node Event ***'
	#endif

	eval($f:w14a_ノードフラグ = 1);
	command メニュー設定 -node_access on 
}

//-----------------------------------------------------------------------------
// 監視カメラ設定
proc 監視カメラ設定_廊下 {
#if d:DEBUG_PRINT
	print '*** SV Camera Set: Hall ***'
#endif

	// 監視カメラ
	//   -p 設置場所  -r 支柱部方向  -d 振り幅  -c 振り中心角 初期方向  -x 縦視野角  -y 横視野角  -i 視力  -s ステータスフラグ  -exec { 破壊時実行ブロック }
	if($w:ゲーム設定 >= d:LEVEL_HARD) {		// レベルハード以上にて出現
		if($w:p_story >= d:ST:P014_15_P07ピーター遭遇１５ポリゴンデモ７終了) {

			@カメラ再セットチェック $b:w14a_破壊ロード回数[7]
			if($f:再セットフラグ) {
				eval($f:w14a_監視カメラ１破壊状態 = d:FALSE)	// 正常状態
			} else {
				eval($f:w14a_監視カメラ１破壊状態 = d:TRUE)		// 破壊状態
			}
			chara プラントカメラ 監視カメラ:01 \
				-p -56000 3000 -39000 \
				-r 340 0 0 \
				-d 275 \
				-c 290 0 \
				-x 256 \
				-y 256 \
				-i 6000 \
				-s $f:w14a_監視カメラ１破壊状態 \
				-exec {
					eval($b:w14a_破壊ロード回数[7] = $w:グローバルロード回数);
					eval($f:w14a_監視カメラ１破壊状態 = d:TRUE)
				}

			@カメラ再セットチェック $b:w14a_破壊ロード回数[8]
			if($f:再セットフラグ) {
				eval($f:w14a_監視カメラ２破壊状態 = d:FALSE)	// 正常状態
			} else {
				eval($f:w14a_監視カメラ２破壊状態 = d:TRUE)		// 破壊状態
			}
			chara プラントカメラ 監視カメラ:02 \
				-p -53500 3000 -33500 \
				-r 340 3072 0 \
				-d 275 \
				-c -275 0 \
				-x 256 \
				-y 170 \
				-i 6000 \
				-s $f:w14a_監視カメラ２破壊状態 \
				-exec {
					eval($b:w14a_破壊ロード回数[8] = $w:グローバルロード回数);
					eval($f:w14a_監視カメラ２破壊状態 = d:TRUE)
				}

			// 監視カメラ設置確認デモ
			if($f:監視カメラ設置確認デモ再生済み == 0) {
				trap ev007 d:PLAYER \
					-mask 入る \
					-exec {
						if($f:監視カメラ設置確認デモ再生済み == 0) {
							eval($f:監視カメラ設置確認デモ再生済み = 1);
							command varsave $f:監視カメラ設置確認デモ再生済み

							if(    ($w:アラートモード == d:ALERT_MODE_SENNYU) \
								&& (`command ゲームオーバーチェック` == 0) \
								&& (   ($f:w14a_監視カメラ１破壊状態 == d:FALSE) \
									|| ($f:w14a_監視カメラ２破壊状態 == d:FALSE))) {
								if($6 < -25475) {	// 廊下中央付近のZ座標との大小により侵入方向を判定
									// 北から
//									@シナリオカメラデモ（シネマ） 45 -53764,3079,-32420 -54354,1991,-36403 429 -53771,3079,-32418 -54643,2271,-36417 200
									@シナリオカメラデモ（シネマ） 45 -53764,3079,-32420 -54354,1991,-36403 429 -53711,3104,-32403 -54354,2614,-36478 200
								} else {
									// 南から
									@シナリオカメラデモ（シネマ） 45 -54797,2826,-16908 -54768,1110,-20701 200 -53711,3104,-32403 -54354,2614,-36478 200
								}
							}

						}
					}
			}
		}
	}
}

//-----------------------------------------------------------------------------
// 天井君設定
proc 天井君設定_廊下 {
#if d:DEBUG_PRINT
	print '*** Tenjou-kun Set: Hall ***'
#endif

	//注意！！天井君の高さを変えるときは、ビハインドカメラの位置を全てチェックすること！！
	chara 天井君 天井_廊下 -m d:KMS_NAME1 -h 3500 -p 0,0,0  -l d:LT2_NAME
}

proc 天井君設定_変電室 {
#if d:DEBUG_PRINT
	print '*** Tenjou-kun Set: Substation ***'
#endif

	//注意！！天井君の高さを変えるときは、ビハインドカメラの位置を全てチェックすること！！
	chara 天井君 天井_変電室 -m d:KMS_NAME3 -h 3450 -p 0,0,0  -l d:LT2_NAME
}

//-----------------------------------------------------------------------------
// その他オブジェクト設定
proc その他オブジェクト設定_廊下 {
#if d:DEBUG_PRINT
	print '*** Object Set: Hall ***'
#endif

	//---------------------------------------------------------
	// 主観禁止壁
	@主観禁止壁 ＡＢ連絡橋へのドア壁 -44125 0 -20000 3072 d:SD_SLIDE_OUTSIDE
	@主観禁止壁 ＢＣ連絡橋へのドア壁 -55500 0 -43625    0 d:SD_SLIDE_OUTSIDE

	//---------------------------------------------------------
	// ロード部モデル
	@SS_プットオブジェ  ＡＢ連絡橋ロード部 d:KMS_NAME7
	mesg プットオブジェ ＡＢ連絡橋ロード部 off
	@SS_プットオブジェ  ＢＣ連絡橋ロード部 d:KMS_NAME8
	mesg プットオブジェ ＢＣ連絡橋ロード部 off

	//---------------------------------------------------------
	// ドア風
	chara ローカル風 隙間風 \
		-n 2 \
		-d	-55500 0 -44750 -54000 3000 -42500     0 -512 2048 \
			-45250 0 -20000 -43000 3000 -18500  3072 -512 2048
	mesg ローカル風 隙間風 オフ

	//---------------------------------------------------------
	// ＳＥＡＬ死体
	if($w:p_story < d:ST:P014_15_P07ピーター遭遇１５ポリゴンデモ７終了) {
		// プットオブジェ
		//   -m オブジェクト名  -r 向き  -p 場所  -s スケール  -l 光源  -f フラグ  -t ＬＯＤ閾値

		// ＳＥＡＬ死体影
		chara プットオブジェ ＳＥＡＬ死体影ＡＣ \
			-m d:SHADOW_NAME1 \
			-r 0,0,0 \
			-p -50000,0,-30000 \
			-s 100,100,100 \
			-l d:LT2_NAME 

		chara プットオブジェ ＳＥＡＬ死体影Ｂ \
			-m d:SHADOW_NAME2 \
			-r 0,0,0 \
			-p -50000,0,-30000 \
			-s 100,100,100 \
			-l d:LT2_NAME

		// ＳＥＡＬ死体
		chara プットオブジェ ＳＥＡＬ死体ＡＣ \
			-m d:OBJECT_NAME13 \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME \
			-f (d:PUT_OBJ_THERMAL | d:PUT_OBJ_CALC_LIGHT)
		chara プットオブジェ ＳＥＡＬ死体ＡＣ銃 \
			-m d:OBJECT_NAME17 \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME

		chara プットオブジェ ＳＥＡＬ死体Ｂ \
			-m d:OBJECT_NAME14 \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME \
			-f (d:PUT_OBJ_THERMAL | d:PUT_OBJ_CALC_LIGHT)
//		chara プットオブジェ ＳＥＡＬ死体Ｂ銃 \
//			-m d:OBJECT_NAME18 \
//			-r 0,0,0 \
//			-p 0,0,0 \
//			-s 100,100,100 \
//			-l d:LT2_NAME

		// ＳＥＡＬＡＢＣ死体歩き
		trap ev003 d:PLAYER \
			-mask いる \
			-exec {
				command プレイヤー死体歩き
			}

		// 進入禁止エリア
		@SS_進入禁止エリア設定 廊下進入禁止壁 0 250 -54375 -22500 -53500 -21250 廊下
		@SS_進入禁止エリア設定 廊下進入禁止壁 0 250 -56000 -25000 -55375 -24125 廊下
		@SS_進入禁止エリア設定 廊下進入禁止壁 0 250 -54250 -26750 -53500 -26000 廊下

		trap ev003 d:PLAYER \
			-mask ？ \
			-exec {
				if($3 == 入る) {
					mesg 透明壁 廊下進入禁止壁 off
				} else {
					mesg 透明壁 廊下進入禁止壁 on
				}
			}

	} else {
		// 匍匐禁止を解除
		command トラップ切り替え \
			-trap no_crouch  \
			-switch 0
	}

	//---------------------------------------------------------
	// 電灯虫

	// chara 電灯虫 -n 匹数 // ４以上は４単位で -p 位置 // プレイヤー誘導時は無視 
	//   -b フラグ // 壁との当たり見るか 1:あり, 0:なし -s バウンド１ // 最小 -l バウンド２ // 最大
	chara 電灯虫 電灯虫 \
		-n 12 \
		-p -54750 2875 -43125 \
		-b 1 \
		-s -56000    0 -43250 \
		-l -53500 3750 -42250
	chara 電灯虫 電灯虫 \
		-n 12 \
		-p -44625 2875 -19250 \
		-b 1 \
		-s -45500    0 -20375 \
		-l -44500 3750 -18125

	//---------------------------------------------------------
	// ダンボールトラップ
	chara ダンボール柄トラップ設定 ダンボール柄トラップ設定 \
		-name d:PLAYER \
		-traps d:アイテム:ダンボールＢ, cbox_area
}

proc その他オブジェクト設定_変電室 {
#if d:DEBUG_PRINT
	print '*** Object Set: Substation ***'
#endif

	//---------------------------------------------------------
	// ＳＥＡＬ死体
	if($w:p_story < d:ST:P014_15_P07ピーター遭遇１５ポリゴンデモ７終了) {
		// プットオブジェ
		//   -m オブジェクト名  -r 向き  -p 場所  -s スケール  -l 光源  -f フラグ  -t ＬＯＤ閾値

		// 海軍大佐死体有り影
		chara プットオブジェ 海軍大佐死体有り影 \
			-m d:SHADOW_NAME3 \
			-r 0,0,0 \
			-p -50000,0,-30000 \
			-s 100,100,100 \
			-l d:LT2_NAME

		// 海軍大佐
		chara プットオブジェ 海軍大佐死体 \
			-m d:OBJECT_NAME16 \
			-r 0,0,0 \
			-p -46250,-2000,-25900 \
			-s 100,100,100 \
			-l d:LT2_NAME \
			-f (d:PUT_OBJ_THERMAL | d:PUT_OBJ_CALC_LIGHT)

		// ＳＥＡＬ変電室死体
		chara プットオブジェ ＳＥＡＬ変電室死体 \
			-m d:OBJECT_NAME15 \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME \
			-f (d:PUT_OBJ_THERMAL | d:PUT_OBJ_CALC_LIGHT)
		chara プットオブジェ ＳＥＡＬ変電室死体銃 \
			-m d:OBJECT_NAME19 \
			-r 0,0,0 \
			-p 0,0,0 \
			-s 100,100,100 \
			-l d:LT2_NAME

		if($w:p_story >= d:ST:P010_10_P05ヴァンプ遭遇１０ポリゴンデモ５終了) {

			// ＮＰＣスネーク
			chara ＮＰＣスネーク 居眠りプリスキン \
				-m iro_def_mt \				// 通常モデル
				-n iro_bandage_mh_mt \		// ハイポリモデル
				-a npc_snake \				// モーション
				-c npc_snake_cap \			// キャプチャーモーション
				-d npc_snake_drag \			// ドラッグモーション
				-y sna_npc \				// FAR ファイル
				-x -47250,-2000,-22725 \	// 初期位置
				-r 0,2048,0 \				// 初期方向
				-t 3						// ステージ番号  3:w14a

			// chara 透明壁 -p 頂点１Ｘ 頂点１Ｙ 頂点１Ｚ 頂点１高さ 頂点２Ｘ 頂点２Ｙ 頂点２Ｚ 頂点２高さ -a アトリビュート -m マップ名
			chara 透明壁 プリスキン壁 \
				-p -47500 -2000 -22500 5000 \
				   -47500 -2000 -23000 5000 \
				-a (d:HZX_SEG_ATR_ALL & ~(d:HZX_SEG_NO_PLAYER | d:HZX_SEG_NO_ENEMY))
			chara 透明壁 プリスキン壁 \
				-p -47500 -2000 -23000 5000 \
				   -47000 -2000 -23000 5000 \
				-a (d:HZX_SEG_ATR_ALL & ~(d:HZX_SEG_NO_PLAYER | d:HZX_SEG_NO_ENEMY))
			chara 透明壁 プリスキン壁 \
				-p -47000 -2000 -23000 5000 \
				   -47000 -2000 -22500 5000 \
				-a (d:HZX_SEG_ATR_ALL & ~(d:HZX_SEG_NO_PLAYER | d:HZX_SEG_NO_ENEMY))
		}

		// 海軍大佐・ＳＥＡＬ変電室死体・ＮＰＣプリスキン死体歩き
		trap ev005 d:PLAYER \
			-mask いる \
			-exec {
				command プレイヤー死体歩き
			}

		// 進入禁止エリア
		@SS_進入禁止エリア設定 変電室進入禁止壁 -2000 2000 -46500 -26000 -46000 -25500 変電室	// 海軍大佐
		@SS_進入禁止エリア設定 変電室進入禁止壁 -2000  250 -44750 -26125 -43500 -25500 変電室
		@SS_進入禁止エリア設定 変電室進入禁止壁 -2000  250 -45000 -30000 -43500 -29375 変電室
		@SS_進入禁止エリア設定 変電室進入禁止壁 -2000  250 -46000 -33250 -44750 -32250 変電室
		@SS_進入禁止エリア設定 変電室進入禁止壁 -2000  250 -46250 -39000 -45500 -38500 変電室

		trap ev005 d:PLAYER \
			-mask ？ \
			-exec {
				if($3 == 入る) {
					mesg 透明壁 変電室進入禁止壁 off
				} else {
					mesg 透明壁 変電室進入禁止壁 on
				}
			}

	} else {
		// 海軍大佐死体無し影
		chara プットオブジェ 海軍大佐死体無し影 \
			-m d:SHADOW_NAME4 \
			-r 0,0,0 \
			-p -50000,0,-30000 \
			-s 100,100,100 \
			-l d:LT2_NAME

		// 匍匐禁止を解除
		command トラップ切り替え \
			-trap no_crouch  \
			-switch 0
	}

	//---------------------------------------------------------
	// 各ステージオブジェクトモデル

	// 破壊壁
	chara プットオブジェ 破壊壁階段下 \
		-m d:KMS_NAME5 \
		-r 0,0,0 \
		-p -45000 -2000 -39000 \
		-s 100,100,100 \
		-l d:LT2_NAME 

	chara プットオブジェ 破壊壁配電盤横 \
		-m d:KMS_NAME6 \
		-r 0,0,0 \
		-p -53250 0 -30750 \
		-s 100,100,100 \
		-l d:LT2_NAME 

	// 天井オブジェクト
	chara プットオブジェ 天井オブジェクト \
		-m d:OBJECT_NAME1 \
		-r 0,0,0 \
		-p -50000,0,-30000 \
		-s 100,100,100 \
		-l d:LT2_NAME

	// フェンス
	chara プットオブジェ フェンスａ０１ \
		-m d:OBJECT_NAME2 \
		-r 0,0,0 \
		-p -50000,0,-30000 \
		-s 100,100,100 \
		-l d:LT2_NAME
	chara プットオブジェ フェンスａ０２ \
		-m d:OBJECT_NAME3 \
		-r 0,0,0 \
		-p -50000,0,-30000 \
		-s 100,100,100 \
		-l d:LT2_NAME
	chara プットオブジェ フェンスａ０３ \
		-m d:OBJECT_NAME4 \
		-r 0,0,0 \
		-p -50000,0,-30000 \
		-s 100,100,100 \
		-l d:LT2_NAME
	chara プットオブジェ フェンスａ０４ \
		-m d:OBJECT_NAME5 \
		-r 0,0,0 \
		-p -50000,0,-30000 \
		-s 100,100,100 \
		-l d:LT2_NAME
	chara プットオブジェ フェンスａ０５ \
		-m d:OBJECT_NAME6 \
		-r 0,0,0 \
		-p -50000,0,-30000 \
		-s 100,100,100 \
		-l d:LT2_NAME
	chara プットオブジェ フェンスａ０６ \
		-m d:OBJECT_NAME7 \
		-r 0,0,0 \
		-p -50000,0,-30000 \
		-s 100,100,100 \
		-l d:LT2_NAME
	chara プットオブジェ フェンスａ０７ \
		-m d:OBJECT_NAME8 \
		-r 0,0,0 \
		-p -50000,0,-30000 \
		-s 100,100,100 \
		-l d:LT2_NAME
	chara プットオブジェ フェンスａ０８ \
		-m d:OBJECT_NAME9 \
		-r 0,0,0 \
		-p -50000,0,-30000 \
		-s 100,100,100 \
		-l d:LT2_NAME

	chara プットオブジェ フェンスｂ０１ \
		-m d:OBJECT_NAME10 \
		-r 0,0,0 \
		-p -50000,0,-30000 \
		-s 100,100,100 \
		-l d:LT2_NAME
	chara プットオブジェ フェンスｂ０２ \
		-m d:OBJECT_NAME11 \
		-r 0,0,0 \
		-p -50000,0,-30000 \
		-s 100,100,100 \
		-l d:LT2_NAME
	chara プットオブジェ フェンスｂ０３ \
		-m d:OBJECT_NAME12 \
		-r 0,0,0 \
		-p -50000,0,-30000 \
		-s 100,100,100 \
		-l d:LT2_NAME

	//---------------------------------------------------------
	// 各エフェクト

	// スリット光
	//   -p 中心座標  -n 法線  -d 光線の絶対方向  -l 光線の到達距離
	chara スリット光２ スリット光 \
		-p -45500 4687 -34750 \
		-n 1 0 0 \
		-d -1000 -750 0 \
		-l 3000
	chara スリット光２ スリット光 \
		-p -45500 4687 -32750 \
		-n 1 0 0 \
		-d -1000 -750 0 \
		-l 3000
	chara スリット光２ スリット光 \
		-p -45500 4687 -30750 \
		-n 1 0 0 \
		-d -1000 -750 0 \
		-l 3000
	chara スリット光２ スリット光 \
		-p -45500 4687 -28750 \
		-n 1 0 0 \
		-d -1000 -750 0 \
		-l 3000
	chara スリット光２ スリット光 \
		-p -45500 4687 -26750 \
		-n 1 0 0 \
		-d -1000 -750 0 \
		-l 3000

	// 漏電火花
	//   -p 中心座標
	chara 漏電火花 漏電火花 -p -50659 2439 -28877

	// レンズフレア
	//   -pos 位置  -size 大きさ  -alpha アルファ
	chara レンズフレア  レンズフレア \
		-pos   -45400,5000,-34750 \
		-size  1 \
		-alpha 8 \
		-g     2
	if($s:登場ポイント != sp_demo_w14a_0) {
		mesg レンズフレア レンズフレア アルファ変更 0 1
	}

	// 影投影モデル -m 影投影専用モデル -p 設置位置
	chara 影投影モデル 影投影モデル -m d:KMS_NAME4 -p 2,2,-2

	// 影管理 -t 光源タイプ -l 光源距離(並行光源時のみ有効) -p 並行光源方向直接指定
	chara 影管理 影管理 -t 0 -l 6000 -p -1563,-1998,758
	trap ev004 ？ \
		-mask ？ \
		-exec {
			if($3 == 入る) {
				mesg 影管理 影管理 add $2 影投影モデル
			} else {
				mesg 影管理 影管理 del $2
			}
		}

	// 消火器 -r 向き -p 場所 -l 光源 -b バンダリ(XYZ のセット２つ) -i 赤外線センサーに有効(１で有効) -e 破壊時実行プロック -d デバグ(１でデバグターゲットが見える)
	chara 消火器 消火器１ \
		-p -53100 0 -26650 \
		-r 0 0 0 \
		-l d:LT2_NAME \
		-b -53300 -100 -29250 -49250 3000 -22500 \	// XYZ のセット２つ
		-d 0
}





//=============================================================================
// フォグ、カメラ、ロード
//=============================================================================

//-----------------------------------------------------------------------------
// カメラ設定
proc カメラ設定 {
#if d:DEBUG_PRINT
	print '*** Camera Set ***'
#endif

	// カメラ
	//   -c チャンネル番号  -l カメラレベル  -p 優先度
	//
	//   シナリオカメラは最大16個までおける。
	//   チャンネル番号 ：
	//       ０：通常画面 １：小窓
	//   カメラレベル ：
	//       ０：カットインカメラ（主観より強） 強
	//       １：カットインカメラ（主観より弱） ↑
	//       ２：エリアカメラ		   ↓
	//       ３：ステージデフォルトカメラ	   弱
	//   優先度 ：
	//       エリアカメラに有効
	//       数字が小さい程優先度高
	chara カメラ ステージカメラ		-c 0 -l 3 -p  0
	chara カメラ サブカメラ１		-c 0 -l 2 -p 50
	chara カメラ サブカメラ２		-c 0 -l 2 -p 40
	chara カメラ サブカメラ３		-c 0 -l 2 -p 30
	chara カメラ サブカメラ４		-c 0 -l 2 -p 20
	chara カメラ モーションカメラ	-c 0 -l 2 -p 10
	chara カメラ でもデモカメラ		-c 0 -l 0 -p  0

	chara カメラ クリアリングカメラ	-c 1 -l 2 -p  0

	// デフォルトカメラ
	chara カメラ設定 ステージカメラ \
		-c 0 \
		-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
		-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
		-r 850,2048,0 \
		-f 5500 \
		-a 200 \
		-i 1 -1 0 0 \
		-s 1

	// 部屋の中
	trap ca101 d:PLAYER \
		-camera -mask ？ \
		-exec {
			chara カメラ設定 サブカメラ３ \
				-c 0 \
				-b -51000, 4200,-36000 -45000,d:CAM_MAX,-23000 \
				-l -51000,-1000,-39000 -45000,d:CAM_MAX,-24000 \
				-r 700,2048,0 \
				-f 5500 \
				-a 200 \
				-i 0 0 0 0 \
				-s $3
		}

	// 金網張付き
	trap ca102 d:PLAYER \
		-camera -mask ？ \
		-state d:TRP_STATE_CAUTION \
		-exec {
			chara カメラ設定 サブカメラ４ \
//				-c 1 \
//				-p ( $i:プレイヤー位置Ｘ-  67 ),(  2750 ),( $i:プレイヤー位置Ｚ+1932 ) \
//				-t ( $i:プレイヤー位置Ｘ-1401 ),( -1631 ),( $i:プレイヤー位置Ｚ- 854 )  \
//				-a 180 \
				-c 0 \
				-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,-23868 \
				-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,-28001 \
				-r 263,2220,0 \
				-f 4655 \
				-a 180 \
				-i 1 1 0 0 \
				-z d:CAMERA_NO_CUSHION \
				-s $3
		}

	// 北側廊下
	trap ca003 d:PLAYER \
		-camera -mask ？ \
		-exec {
			chara カメラ設定 サブカメラ２ \
				-c 0 \
				-b -55043,     6000,-40132 -49675,d:CAM_MAX,-39500 \
				-l -55043,d:CAM_MIN,-42855 -49675,d:CAM_MAX,-40912 \
				-r 660,2048,0 \
				-f 5171 \
				-a 200 \
				-i 0 0 0 0 \
				-s $3
		}

	// 西側廊下
	trap ca002 d:PLAYER \
		-camera -mask ＊ \
		-exec {
			// 北側   -p -54033,2584,-32578 -t -54466,1736,-37117
			// 南側   -p -53877,2189,-15752 -t -54865,1059,-20124
//			if ( $3 == いる ) {

				@CS_スムーズカメラ昇順 $6 -37957 -20375 -54033 -53877
				eval( $i:w14aカメラ位置Ｘ = $i:CS_結果１ ) ;
				@CS_スムーズカメラ昇順 $6 -37957 -20375 2584 2189
				eval( $i:w14aカメラ位置Ｙ = $i:CS_結果１ ) ;
				@CS_スムーズカメラ昇順 $6 -37957 -20375 -32578 -15752
				eval( $i:w14aカメラ位置Ｚ = $i:CS_結果１ ) ;
				@CS_スムーズカメラ昇順 $6 -37957 -20375 -54466 -54865
				eval( $i:w14a注視点Ｘ = $i:CS_結果１ ) ;
				@CS_スムーズカメラ昇順 $6 -37957 -20375 1736 1059
				eval( $i:w14a注視点Ｙ = $i:CS_結果１ ) ;
				@CS_スムーズカメラ昇順 $6 -37957 -20375 -37117 -20124
				eval( $i:w14a注視点Ｚ = $i:CS_結果１ ) ;

				if(($6 < -24000) || ($3 != 出る)) {		// よく分からんがこれでうまく行く
					chara カメラ設定 サブカメラ１ \
						-c 1 \
						-p $i:w14aカメラ位置Ｘ,$i:w14aカメラ位置Ｙ,$i:w14aカメラ位置Ｚ \
						-t $i:w14a注視点Ｘ,$i:w14a注視点Ｙ,$i:w14a注視点Ｚ \
						-a 200 \
						-i 2 2 0 0 \
						-s $3
				}

//			} else {
				// chara カメラ設定 サブカメラ１ -s 0
//			}
		}

	// 南側廊下
	trap ca001 d:PLAYER \
		-camera -mask ＊ \
		-exec {
			if ( $3 == いる ) {
				if ( $4 <= -53500 ) {		// -53500 はコーナーの角のX座標
					// コーナーを回るところの接続
					// 南北通路側(旧) -p -53877,2189,-15752 -t -54865,1059,-20124
					// 南北通路側(新) -p -53483,2799,-15241 -t -53587,982,-19479
					eval( $w:Ｘ差分 = $4 - ( -53500 )) ;
					eval( $w:Ｚ差分 = $6 - ( -20500 )) ;
					eval( $i:コーナー角度 = `command atan $w:Ｘ差分 $w:Ｚ差分`)
					@CS_スムーズカメラ昇順 $i:コーナー角度 1024 2048 -53483 -53877
					eval( $i:w14aカメラ位置Ｘ = $i:CS_結果１ ) ;
					@CS_スムーズカメラ昇順 $i:コーナー角度 1024 2048 2799 2189
					eval( $i:w14aカメラ位置Ｙ = $i:CS_結果１ ) ;
					@CS_スムーズカメラ昇順 $i:コーナー角度 1024 2048 -15241 -15752
					eval( $i:w14aカメラ位置Ｚ = $i:CS_結果１ ) ;
					@CS_スムーズカメラ昇順 $i:コーナー角度 1024 2048 -53587 -54865
					eval( $i:w14a注視点Ｘ = $i:CS_結果１ ) ;
					@CS_スムーズカメラ昇順 $i:コーナー角度 1024 2048 982 1059
					eval( $i:w14a注視点Ｙ = $i:CS_結果１ ) ;
					@CS_スムーズカメラ昇順 $i:コーナー角度 1024 2048 -19479 -20124
					eval( $i:w14a注視点Ｚ = $i:CS_結果１ ) ;
				} else {
					// 東西通路
					// ＡＢ連絡橋側   -p -46673,3167,-15788 -t -45839,982,-19639
					// 南北通路側(新) -p -53483,2799,-15241 -t -53587,982,-19479
					@CS_スムーズカメラ昇順 $4 -53500 -46436 -53483 -46673
					eval( $i:w14aカメラ位置Ｘ = $i:CS_結果１ ) ;
					@CS_スムーズカメラ昇順 $4 -53500 -46436 2799 3167
					eval( $i:w14aカメラ位置Ｙ = $i:CS_結果１ ) ;
					@CS_スムーズカメラ昇順 $4 -53500 -46436 -15241 -15788
					eval( $i:w14aカメラ位置Ｚ = $i:CS_結果１ ) ;
					@CS_スムーズカメラ昇順 $4 -53500 -46436 -53587 -45839
					eval( $i:w14a注視点Ｘ = $i:CS_結果１ ) ;
					@CS_スムーズカメラ昇順 $4 -53500 -46436 982 1000
					eval( $i:w14a注視点Ｙ = $i:CS_結果１ ) ;
					@CS_スムーズカメラ昇順 $4 -53500 -46436 -19479 -19639
					eval( $i:w14a注視点Ｚ = $i:CS_結果１ ) ;
				}
				chara カメラ設定 サブカメラ１ \
					-c 1 \
					-p $i:w14aカメラ位置Ｘ,$i:w14aカメラ位置Ｙ,$i:w14aカメラ位置Ｚ \
					-t $i:w14a注視点Ｘ,$i:w14a注視点Ｙ,$i:w14a注視点Ｚ \
					-a 200 \
					-i 1 1 0 0 \
					-s 1
			} else {
				// chara カメラ設定 サブカメラ１ -s 0
			}
		}

	trap ca001a d:PLAYER \
		-camera -mask ？ \
		-state d:TRP_STATE_CAUTION \
		-exec {
			chara カメラ設定 サブカメラ３ \
				-c 0 \
				-b -54871 3968 -18235 -45557 3968 -18235 \
				-l -54871 1625 -18249 -45557 1625 -18249 \
				-r 1020 2029 0 -f 2343 \
				-a 200 \
				-i 0 0 0 0 \
				-s $3
		}
}

proc スタートカメラセット {
#if d:DEBUG_PRINT
	print '*** Start Camera Set ***'
#endif

	if($s:登場ポイント == sp_w13a_w14a_0) {				// ＡＢ連絡橋から
		chara カメラ設定 モーションカメラ \
			-c 1 \
			-p -47975,3443,-18567 \
			-t -44403,1120,-19852 \
			-a 200 \
			-i 0 2 0 0 \
			-s 1
	} else if($s:登場ポイント == sp_w15a_w14a_0) {		// ＢＣ連絡橋から
		chara カメラ設定 モーションカメラ \
			-c 1 \
			-p -53559,4296,-42429 \
			-t -55902,-190,-43366 \
			-a 200 \
			-i 0 2 0 0 \
			-s 1
	}
}

proc スタートカメラオフ {
#if d:DEBUG_PRINT
	print '*** Start Camera Off ***'
#endif

	chara カメラ設定 モーションカメラ -s 0
}

//-----------------------------------------------------------------------------
// ストーリー設定
proc ストーリー設定 {
#if d:DEBUG_PRINT
	print '*** Story Set ***'
#endif

	// シネマスクリーン
	@シナリオデモキャラセット

	//---------------------------------------------------------
	// ヴァンプ遭遇デモ
	if($w:p_story < d:ST:P010_10_P05ヴァンプ遭遇１０ポリゴンデモ５終了) {
		// ポリゴンデモ
		trap ev001 d:PLAYER \
			-mask 入る \
			-exec {
				if($w:p_story < d:ST:P010_10_P05ヴァンプ遭遇１０ポリゴンデモ５終了) {
					if(`command ゲームオーバーチェック` == 0 ) {
						chara カメラ設定 でもデモカメラ \
							-c 1 \
							-p -53167,1979,-18238 \
							-t -49042,1609,-19939 \
							-a 188 \
							-i 0 0 0 0 \
							-s 1
						command パッド操作 -release
						chara delay ディレイ \
							-time 25 \ 
							-exec{
								preseek 'd010p01'
								@ポリゴンデモロード d:ST:P010_01_P01ヴァンプ遭遇１ポリゴンデモ１開始
							}
					}
				}
			}
	}

	//---------------------------------------------------------
	// ソーコムパッドデモ
	if(($s:登場ポイント == sp_demo_w14a_0) && ($f:w14a_ソーコムパッドデモ終了 == 0)) {
		eval($f:w14a_ソーコムパッドデモ終了 = 1)
		command varsave $f:w14a_ソーコムパッドデモ終了

		if(($w:タイトルメニュー設定 & d:TITLE_MENU_STORY_SEL_MASK) != d:TITLE_MENU_STORY_SEL_TANDP) {
			eval($w:武器弾数Ｒ[d:武器:ソコム]           = 13)
			eval($w:アイテム最大数Ｒ[d:アイテム:髭剃り] =  0)
			eval($w:アイテム数Ｒ[d:アイテム:煙草]       =  1)

			// ステージ開始時処理で行われているパッドcancelとぶつかるため、その直後からデモを始めるように変更 2002.09.24 吉池
			chara delay ディレイ -time 1 \ 
				-exec {
					if ( $f:ロードチェックＯＮフラグ == 1 ) {
						@ソーコムパッドデモ開始
					} else {
						return 1;
					}
				}

		} else {
			eval($w:武器弾数Ｒ[d:武器:ソコム]           = 13)
			eval($w:アイテム最大数Ｒ[d:アイテム:髭剃り] =  0)
			eval($w:アイテム数Ｒ[d:アイテム:煙草]       =  1)
			command varsave $w:武器弾数Ｒ[d:武器:ソコム]
			command varsave $w:アイテム最大数Ｒ[d:アイテム:髭剃り]
			command varsave $w:アイテム数Ｒ[d:アイテム:煙草]
		}
	}

	//---------------------------------------------------------
	// 強制無線
	if($s:登場ポイント == sp_demo_w14a_0) {
		trap ev006 d:PLAYER \
			-mask 入る \
			-exec {
				if($f:w14aローズからの無線を受信済み == 0) {
					eval($f:w14aローズからの無線を受信済み = 1)
					command varsave $f:w14aローズからの無線を受信済み
					@rt_P011_01_R01ＢＣ連絡橋ＣＡＬＬ１無線デモ１
				}
			}
	}

	//---------------------------------------------------------
	// フォーチュン遭遇デモの入り
	if($w:p_story <= d:ST:P010_10_P05ヴァンプ遭遇１０ポリゴンデモ５終了) {
		trap dr002 d:PLAYER -mask 入る \
			-exec {
				if($w:p_story <= d:ST:P010_10_P05ヴァンプ遭遇１０ポリゴンデモ５終了) {
					// チェック
					if(`command ゲームオーバーチェック` == 0 ) {
						// 開始
						@シナリオデモ開始処理
						mesg プレイヤー d:PLAYER stance 0 $w:プレイヤー方向 2048 d:FA_NO_INTERP
						// カメラ
						chara delay ディレイ \
							-time 2 -exec {
								chara カメラ設定 でもデモカメラ \
									-c 1 \
									-p -52861,4760,-39208 \
									-t -53268,4078,-39883 \
									-a 180 \
									-i 0 0 0 0 \
									-s 1
							}
						// 音
						command ＳＥセットモード -s d:se_code:SD_A_SEALSGNB -p $i:プレイヤー位置Ｘ $i:プレイヤー位置Ｙ $i:プレイヤー位置Ｚ -m 0

						// 武器
						chara delay ディレイ \
							-time 90 -exec {
								if(($w:武器 != d:武器:Ｍ９) && ($w:武器 != d:武器:ソコム)) {
									eval($w:武器 = d:武器:ソコム);
									command ＳＥセットＶＰ -s d:SD_S_EQUIP01 -v 0x3f -p 0x20
								}
							}

						// 移動
						chara delay ディレイ \
							-time 120 -exec {
								mesg プレイヤー d:PLAYER run -54750 0 -43625 0 2048 d:FA_DIRECT_MOVE
							}
					}
				}
			}
	}
}

//-----------------------------------------------------------------------------
// ロード設定
proc ロード設定 {
#if d:DEBUG_PRINT
	print '*** Load Set ***'
#endif


	// ＡＢ連絡橋へ (w13a、w13b)
	trap ld001 d:PLAYER \
		-mask 入る \
		-exec {
			if($f:ロードチェックＯＮフラグ == 1) {
				@爆弾タイマー残り時間保存
				eval($s:登場ポイント = sp_w13a_w14a_0)
				@スタートカメラセット
				if ($w:p_story < d:ST:P014_15_P07ピーター遭遇１５ポリゴンデモ７終了) {
					preseek 'w13a'
				} else {
					preseek 'w13b'
				}
				@ステージ終了時処理（ステージ名表示） -42250 0 -19250 1024 mv_w14a_w13a_0 d:DEFAULT_M_TYPE d:wn_ＡＢ連絡橋
			}
		}

	// ＢＣ連絡橋へ (w15a、w15b)
	trap ld002 d:PLAYER \
		-mask 入る \
		-exec {
			if($f:ロードチェックＯＮフラグ == 1) {
				if($w:p_story <= d:ST:P010_10_P05ヴァンプ遭遇１０ポリゴンデモ５終了) {
					// フォーチュン登場デモへ
					preseek 'd012p01'
					@ステージ終了時処理 -54750 0 -45500 2048 mv_w14a_d012p01_0 d:DEFAULT_M_TYPE
				} else {
					@爆弾タイマー残り時間保存
					eval($s:登場ポイント = sp_w15a_w14a_0)
					@スタートカメラセット
					if ($w:p_story < d:ST:P014_15_P07ピーター遭遇１５ポリゴンデモ７終了) {
						preseek 'w15a'
					} else {
						preseek 'w15b'
					}
					@ステージ終了時処理（ステージ名表示） -54750 0 -45500 2048 mv_w14a_w15a_0 d:DEFAULT_M_TYPE d:wn_ＢＣ連絡橋
				}
			}
		}
}

proc ロードプロック {
#if d:DEBUG_PRINT
	print '*** Load Proc ***'
#endif

	if($s:呼び出しプロック == mv_w14a_w13a_0) {
		// ＡＢ連絡橋へ
		@mv_w14a_w13a_0

	} else if($s:呼び出しプロック == mv_w14a_w15a_0) {
		// ＢＣ連絡橋へ
		@mv_w14a_w15a_0

	} else if($s:呼び出しプロック == mv_w14a_d012p01_0) {
		// フォーチュン遭遇デモへ
		eval($w:p_story = d:ST:P012_01_P01フォーチュン遭遇１ポリゴンデモ１開始)
		load 'd012p01'
	}
}

proc ポリデモロードスタート {
#if d:DEBUG_PRINT
	print '*** Poly-Demo Load Start ***'
#endif

	// 武器の装備、状況をデモに反映させるための処理
	if( ($w:武器弾数Ｒ[d:武器:Ｍ９] >= 0) || \
		($w:武器弾数Ｒ[d:武器:ソコム] >= 0)){
		// 武器を持っている

		// 武器は持っているが装備していない場合があるので、その対処。
		if(($w:武器 != d:武器:Ｍ９) && ($w:武器 != d:武器:ソコム)) {
			// 武器は持っているがそれを装備していない。
			if($w:武器弾数Ｒ[d:武器:ソコム] >= 0) {
				// ソコムを持っているのでソコムを持たせる
				eval ($w:武器 = d:武器:ソコム)
			}else{
				// Ｍ９しか持っていないのでＭ９を持たせる
				eval ($w:武器 = d:武器:Ｍ９)
			}
		}
	}

	// ヴァンプ遭遇デモへ
	load "d010p01"
}





//=============================================================================
// ステージ進入時処理
//=============================================================================

proc ステージ進入時処理 {
#if d:DEBUG_PRINT
	print '*** Stage Start Proc ***'
#endif

	// @ステージ開始時処理 タイプ(スライドドア、水密ドア、何もなし)   ドアの名前   移動距離   状態(前のステージ状態、走り、歩き)
	if($s:登場ポイント == sp_w13a_w14a_0) {
		@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:SL_DOOR_TYPE ＡＢ連絡橋へのドア 2000 d:DEFAULT_M_TYPE d:wn_Ｂ脚変電室

	} else if($s:登場ポイント == sp_demo_w14a_0) {
		if(($f:w14a_ソーコムパッドデモ終了 == 0) && (($w:タイトルメニュー設定 & d:TITLE_MENU_STORY_SEL_MASK) != d:TITLE_MENU_STORY_SEL_TANDP)) {
			eval($f:デモ再生フラグ = 1)
		}
		@ステージ開始時処理 d:LOAD_TYPE:NO_MOVE_TYPE 0 0 d:DEFAULT_M_TYPE

	} else if($s:登場ポイント == sp_w15a_w14a_0) {
		@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:SL_DOOR_TYPE ＢＣ連絡橋へのドア 2000 d:DEFAULT_M_TYPE d:wn_Ｂ脚変電室

	} else if($s:登場ポイント == sp_w20a_w14a_0) {
		@ステージ開始時処理（ダンボールワープ） d:wn_Ｂ脚変電室
	}
}
