// ------------------------------------
// マップ設定
// ------------------------------------
chara マップ 武器訓練スティンガー３面 -k d:KMS_NAME -h d:HZX_NAME,0 -l $s:ＶＲライトファイル名

command マップ設定 武器訓練スティンガー３面 -set {
	// ローカルの初期化
	// ------------------------------------
	@ローカル変数初期化		// ローカルで使用する変数で初期化をする場合はここで

	// ＶＲで必要な基本プロックのセット(vr_common.hで定義)
	// サウンドの基本パック、ＶＲの基本システム、プレイヤー、ゴール等を設定します
	// ※このプロックを使用する時は「ＶＲクリア時処理」というプロックが必要です
	// ------------------------------------
	@ＶＲ共通プロックセット sna_wp53a rai_wp53a d:VR_GOAL_TARGET 0 0 6000

	// ＶＲウィンドウの設定
	// ------------------------------------
	@武器訓練スティンガー３面ＶＲウィンドウ設定

	// クリア時に呼ばれるものの設定
	// ------------------------------------
	@ＶＲクリア設定 p:load_wp54a p:load_wp53a

	// ステージに引かれるライン
	// ------------------------------------
	@ＶＲアウトライン d:KMS_NAME d:TONBO_KMS_NAME d:LINE_KMS_NAME

	// 設定値を変更する場合は以下のプロック内で設定
	// ------------------------------------
	@設定値変更				// 敵兵や的のパラメータをステージ限定で変える時はここで
	@プラグイン設定			// プレイヤーのプラグインがいる時はここで

	// 的関係の設定
	// ------------------------------------
	@ＶＲ標的スティンガー３面設定				// ＶＲシステム起動後に呼ぶ

	// ＢＧＭの設定(プレイヤー→敵兵→BGMの順で呼ぶ。的の場合は関係ないがとりあえずここに)
	// ------------------------------------
	@ＢＧＭ設定

	// アイテムの設定
	// ------------------------------------
	@アイテム設定

	// 光源、オブジェクト、カメラ関連の設定
	// ------------------------------------
	@ＶＲフォグ設定 d:VR_FOG:朝Ｎ d:VR_FOG:朝Ｆ d:VR_FOG:夕Ｎ 50000 -5000 40000
	@カメラセット						// chara カメラとベースのカメラを設定
	@武器訓練スティンガー３面カメラ設定	// ステージ固有のカメラ設定がいる時はこのプロックで
	@ＶＲキャラ用ライト設置				// vr_common.hに定義。必ず最後に設定
#if d:DEBUG_CHARA
//	@デバッグキャラセット
#endif

}

//初期マップの表示
command マップ表示 -show 武器訓練スティンガー３面


//###################################################################################
//									各proc設定
//###################################################################################



//###################################################################################
//									全マップ共通
//###################################################################################
	// ------------------------------------
	// 全マップ共通
	// ------------------------------------
	//------------------------------------------------------------
	// ＶＲウィンドウの設定と表示
	//------------------------------------------------------------
	proc 武器訓練スティンガー３面ＶＲウィンドウ設定 {
		#if d:DEBUG_PRINT
			print 'vr_window_set'
		#endif

		@ＶＲウィンドウ設定	[VRMSG_J:VRM_WPN_STG_wp53a] [VRMSG_E:VRM_WPN_STG_wp53a] [VRMSG_G:VRM_WPN_STG_wp53a] \	// 日、英、独
							[VRMSG_F:VRM_WPN_STG_wp53a] [VRMSG_I:VRM_WPN_STG_wp53a] [VRMSG_S:VRM_WPN_STG_wp53a] \	// 仏、伊、西
							[VRMSG_K:VRM_WPN_STG_wp53a] \															// 韓
							p:ＶＲステージ開始時処理								// 終了プロック


		// ＶＲウィンドウを表示する
		mesg ＶＲウィンドウ ＶＲウィンドウ君 開く

		// スタート時とクリア時に使用するカットインカメラ
		chara カメラ カットインカメラ		-c 0 -l 0 -p 0

		// スタート時のカメラ(必要な場合)
		chara カメラ設定 カットインカメラ \
			-c 1 \	
			-p 0,6600,8360 -t 0,0,6000 \
			-r 800,2048,0 -f 7000 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1
	}

	//------------------------------------------------------------
	// ステージ開始時処理
	//------------------------------------------------------------
	proc ＶＲステージ開始時処理 {
		#if d:DEBUG_PRINT
			print 'game_start!!!!!'
		#endif

		// プレイヤーやパッドの制御等を行う a_stdproc.hで定義
		@全ミッション共通ステージ開始時処理

		// カメラワークスタート(必要な場合)
		// 全体図
		chara カメラ設定 カットインカメラ \
			-c 1 \	
			-p 0,25000,55000 -t 0,20170,44000 \
			-r 270,2048,0 -f 12000 \
			-a 200 \
			-i 4 4 d:START_CAMERA_CHANGE_TIME d:START_CAMERA_CHANGE_TIME \
			-s 1

		chara delay ディレイ \
			-time d:START_CAMERA_CHANGE_TIME \
			-exec {
				chara カメラ設定 カットインカメラ -s -1
			}
	}

	// ------------------------------------
	// クリア時の処理
	// ------------------------------------
	proc ＶＲクリア時処理 {
		#if d:DEBUG_PRINT
			print 'clear'
		#endif

		// 強制モーションを発動
		@全ミッション共通クリアモーション発動 d:モーションリスト:non_mclr_1 0

		// クリア時にカメラアングルを変える
		chara カメラ設定 クリア時カメラ \
			-c 1 \
			-p -250,200,9620 -t -250,1270,5760 \
			-r -175,2048,0 -f 4000 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}

	//------------------------------------------------------------
	// ステージ開始直後処理
	//------------------------------------------------------------
	proc ゲーム開始直後処理 {
		// 初期配置標的の起動（command ＶＲステージスタート の起動直後に行う必要がある）
		@ＶＲ初期配置標的スティンガー３面設定
	}

	// ------------------------------------
	// パラメータ系の変更
	// ------------------------------------
	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT
			print 'localvar_init'
		#endif

		// 的管理用各種フラグを初期化する
		$$b:act_1_破壊数カウント = 0;
		$$b:act_2_破壊数カウント = 0;

		$$b:標的セット数 = 0;
		$$i:標的フラグ = 0;

//		$$i:標的フラグＡ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST );
//		$$i:標的フラグＢ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST );
//		$$i:標的フラグＣ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    );
		$$i:標的フラグＤ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST                  | d:VR_TRG_WAIT );
		$$i:標的フラグＥ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST | d:VR_TRG_WAIT );
//		$$i:標的フラグＦ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    | d:VR_TRG_WAIT );
		$$i:標的フラグＧ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST                  | d:VR_TRG_WAIT | d:VR_TRG_CIRCLE );
		$$i:標的フラグＨ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST | d:VR_TRG_WAIT | d:VR_TRG_CIRCLE );
//		$$i:標的フラグＩ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    | d:VR_TRG_WAIT | d:VR_TRG_CIRCLE );
//		$$i:標的フラグＪ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST                  | d:VR_TRG_WAIT | d:VR_TRG_NO_APPEAR_EF );
//		$$i:標的フラグＫ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_BLAST | d:VR_TRG_WAIT | d:VR_TRG_NO_APPEAR_EF );
//		$$i:標的フラグＬ = ( d:VR_TRG_HEX | d:VR_TRG_FL_MARK | d:VR_TRG_NO_GHOST | d:VR_TRG_NG    | d:VR_TRG_WAIT | d:VR_TRG_NO_APPEAR_EF );
	}

	proc スティンガー３面破壊数カウント変数初期化 {
		$b:act_1_破壊数カウント = 0
		$b:act_2_破壊数カウント = 0
	}

	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT
			print 'status_set'
		#endif

		// 初期装備の設定
		$w:武器弾数Ｒ[ d:武器:スティンガー ] = 40
//		$w:武器 = d:武器:スティンガー
		command シナリオ前武器変更	-number d:武器:スティンガー
	}

	// プラグインプログラム
	// ------------------------------------
	proc プラグイン設定 {
		#if d:DEBUG_PRINT
			print 'plugin_set'
		#endif
	}



//###################################################################################
//									 的兵
//###################################################################################

	// ------------------------------------
	// スティンガー３面
	// ------------------------------------

	// 破壊時処理
	// ------------------------------------
	proc ＶＲ標的破壊スティンガー３面処理 {

		// ライデン or タキシードスネークを選択
		if ( ($s:選択プレイヤー == ライデン) || ($s:選択プレイヤー == タキシードスネーク) ) {

			if ( ($1 == 移動的:01) || ($1 == 移動的:02) || ($1 == 移動的:03) || ($1 == 移動的:04) ) {
				$$b:act_1_破壊数カウント = $$b:act_1_破壊数カウント + 1
				if( $$b:act_1_破壊数カウント == 4 ){
					mesg ＶＲ的共通 移動的:05 移動開始
					mesg ＶＲ的共通 移動的:06 移動開始
					mesg ＶＲ的共通 移動的:07 移動開始
					mesg ＶＲ的共通 移動的:08 移動開始
				}
			} else if ( ($1 == 移動的:05) || ($1 == 移動的:06) || ($1 == 移動的:07) || ($1 == 移動的:08) ) {
				$$b:act_2_破壊数カウント = $$b:act_2_破壊数カウント + 1
				if( $$b:act_2_破壊数カウント == 4 ){
					mesg ＶＲ的共通 移動的:09 移動開始
					mesg ＶＲ的共通 移動的:10 移動開始
					mesg ＶＲ的共通 移動的:11 移動開始
					mesg ＶＲ的共通 移動的:12 移動開始
				}
			}

		// スネーク or プリスキンを選択
		} else if ( ($s:選択プレイヤー == スネーク) || ($s:選択プレイヤー == プリスキン) ) {

			if ( ($1 == 移動的:01) || ($1 == 移動的:02) || ($1 == 移動的:03) || \
				 ($1 == 移動的:04) || ($1 == 移動的:05) ) {
				$$b:act_1_破壊数カウント = $$b:act_1_破壊数カウント + 1
				if( $$b:act_1_破壊数カウント == 5 ){
					mesg ＶＲ的共通 移動的:06 移動開始
					mesg ＶＲ的共通 移動的:07 移動開始
					mesg ＶＲ的共通 移動的:08 移動開始
					mesg ＶＲ的共通 移動的:09 移動開始
					mesg ＶＲ的共通 移動的:10 移動開始
				}
			} else if ( ($1 == 移動的:06) || ($1 == 移動的:07) || ($1 == 移動的:08) || \
						($1 == 移動的:09) || ($1 == 移動的:10) ) {
				$$b:act_2_破壊数カウント = $$b:act_2_破壊数カウント + 1
				if( $$b:act_2_破壊数カウント == 5 ){
					mesg ＶＲ的共通 移動的:11 移動開始
					mesg ＶＲ的共通 移動的:12 移動開始
					mesg ＶＲ的共通 移動的:13 移動開始
					mesg ＶＲ的共通 移動的:14 移動開始
					mesg ＶＲ的共通 移動的:15 移動開始
				}
			}

		// 前作スネークを選択
		} else if ( $s:選択プレイヤー == 前作スネーク ) {

			if ( ($1 == 移動的:01) || ($1 == 移動的:02) || ($1 == 移動的:03) || \
				 ($1 == 移動的:04) || ($1 == 移動的:05) || ($1 == 移動的:06) ) {
				$$b:act_1_破壊数カウント = $$b:act_1_破壊数カウント + 1
				if( $$b:act_1_破壊数カウント == 6 ){
					mesg ＶＲ的共通 移動的:07 移動開始
					mesg ＶＲ的共通 移動的:08 移動開始
					mesg ＶＲ的共通 移動的:09 移動開始
					mesg ＶＲ的共通 移動的:10 移動開始
					mesg ＶＲ的共通 移動的:11 移動開始
					mesg ＶＲ的共通 移動的:12 移動開始
				}
			} else if ( ($1 == 移動的:07) || ($1 == 移動的:08) || ($1 == 移動的:09) || \
						($1 == 移動的:10) || ($1 == 移動的:11) || ($1 == 移動的:12) ) {
				$$b:act_2_破壊数カウント = $$b:act_2_破壊数カウント + 1
				if( $$b:act_2_破壊数カウント == 6 ){
					mesg ＶＲ的共通 移動的:13 移動開始
					mesg ＶＲ的共通 移動的:14 移動開始
					mesg ＶＲ的共通 移動的:15 移動開始
					mesg ＶＲ的共通 移動的:16 移動開始
					mesg ＶＲ的共通 移動的:17 移動開始
					mesg ＶＲ的共通 移動的:18 移動開始
				}
			}

		}

	}

	// 敵兵や的の処理
	// ------------------------------------
	proc ＶＲ標的スティンガー３面設定 {

		// ライデン or タキシードスネークを選択
		if ( ($s:選択プレイヤー == ライデン) || ($s:選択プレイヤー == タキシードスネーク) ) {

			command foreach -argc 8 -repeat 12 \
			-data { \
				// 的名,     フラグ,          ルート, 公転速度, 初期公転方向, 公転半径, 自転速度, スピード
				// act 1 ----------
				{ 移動的:01, $$i:標的フラグＨ, d:M_R:ライデンルート１,   -512, 3072, 2750,  768,  0 }\
				{ 移動的:02, $$i:標的フラグＨ, d:M_R:ライデンルート２,    512, 2048, 2750,  768,  0 }\
				{ 移動的:03, $$i:標的フラグＨ, d:M_R:ライデンルート３,    512,    0, 2750,  768,  0 }\
				{ 移動的:04, $$i:標的フラグＥ, d:M_R:ライデンルート４,      0,    0,    0, 1024, 50 }\
				// act 2 ----------
				{ 移動的:05, $$i:標的フラグＨ, d:M_R:ライデンルート５,   -512, 3072, 2750,  768,  0 }\
				{ 移動的:06, $$i:標的フラグＨ, d:M_R:ライデンルート６,   1024, 3072, 2750, 1536,  0 }\
				{ 移動的:07, $$i:標的フラグＥ, d:M_R:ライデンルート７,      0,    0,    0,  512, 25 }\
				{ 移動的:08, $$i:標的フラグＥ, d:M_R:ライデンルート８,      0,    0,    0, 1024, 50 }\
				// act 3 ----------
				{ 移動的:09, $$i:標的フラグＨ, d:M_R:ライデンルート９,    512, 2048, 2750, 1536,  0 }\
				{ 移動的:10, $$i:標的フラグＥ, d:M_R:ライデンルート１０,    0,    0,    0, 1024, 50 }\
				{ 移動的:11, $$i:標的フラグＥ, d:M_R:ライデンルート１１,    0,    0,    0,  512, 25 }\
				{ 移動的:12, $$i:標的フラグＥ, d:M_R:ライデンルート１２,    0,    0,    0,  512, 25 }\
			} \
			-exec { \
				if( $s:選択プレイヤー == タキシードスネーク ) {
					$$b:標的セット数 = $$b:標的セット数 + 1;
					if( $$b:標的セット数 % 2 ) {
						$$i:標的フラグ = ( $2 | d:VR_TRG_HIDESTART );
					} else {
						$$i:標的フラグ = ( $2 | d:VR_TRG_VISIBLESTART );
					}
				} else {
					$$i:標的フラグ = $2;
				}

			 	chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグ \
					-route $3 \
					-kouten $4 $5 $6 \
					-dir 0 $7 \
					-c ＶＲ標的破壊スティンガー３面処理 \
					-speed $8
			}

		// スネーク or プリスキンを選択
		} else if ( ($s:選択プレイヤー == スネーク) || ($s:選択プレイヤー == プリスキン) ) {

			command foreach -argc 8 -repeat 15 \
			-data { \
				// 的名,     フラグ,          ルート, 公転速度, 初期公転方向, 公転半径, 自転速度, スピード
				// act 1 ----------
				{ 移動的:01, $$i:標的フラグＨ, d:M_R:スネークルート１３, -512,  512, 2750,  768,  0 }\
				{ 移動的:02, $$i:標的フラグＨ, d:M_R:スネークルート１４,  512,    0, 2750,  768,  0 }\
				{ 移動的:03, $$i:標的フラグＨ, d:M_R:スネークルート１５,  512, 2048, 2750,  768,  0 }\
				{ 移動的:04, $$i:標的フラグＥ, d:M_R:スネークルート１６,    0,    0,    0, 1024, 50 }\
				{ 移動的:05, $$i:標的フラグＥ, d:M_R:スネークルート１７,    0,    0,    0, 1024, 50 }\
				// act 2 ----------
				{ 移動的:06, $$i:標的フラグＨ, d:M_R:スネークルート１８, -512, 2560, 2750,  768,  0 }\
				{ 移動的:07, $$i:標的フラグＨ, d:M_R:スネークルート１５, 1024, 3584, 2750, 1536,  0 }\
				{ 移動的:08, $$i:標的フラグＥ, d:M_R:スネークルート１９,    0,    0,    0,  512, 25 }\
				{ 移動的:09, $$i:標的フラグＥ, d:M_R:スネークルート２０,    0,    0,    0, 1024, 50 }\
				{ 移動的:10, $$i:標的フラグＥ, d:M_R:スネークルート２１,    0,    0,    0, 1024, 50 }\
				// act 3 ----------
				{ 移動的:11, $$i:標的フラグＨ, d:M_R:スネークルート２２,  512, 2048, 2750, 1536,  0 }\
				{ 移動的:12, $$i:標的フラグＥ, d:M_R:スネークルート２３,    0,    0,    0, 1024, 50 }\
				{ 移動的:13, $$i:標的フラグＥ, d:M_R:スネークルート２４,    0,    0,    0,  512, 25 }\
				{ 移動的:14, $$i:標的フラグＥ, d:M_R:スネークルート２５,    0,    0,    0, 1024, 25 }\
				{ 移動的:15, $$i:標的フラグＥ, d:M_R:スネークルート２６,    0,    0,    0,  512, 50 }\
			} \
			-exec { \
				if( $s:選択プレイヤー == プリスキン ) {
					$$b:標的セット数 = $$b:標的セット数 + 1;
					if( $$b:標的セット数 % 2 ) {
						$$i:標的フラグ = ( $2 | d:VR_TRG_HIDESTART );
					} else {
						$$i:標的フラグ = ( $2 | d:VR_TRG_VISIBLESTART );
					}
				} else {
					$$i:標的フラグ = $2;
				}

			 	chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグ \
					-route $3 \
					-kouten $4 $5 $6 \
					-dir 0 $7 \
					-c ＶＲ標的破壊スティンガー３面処理 \
					-speed $8
			}

		//	前作スネークを選択
		} else if ( $s:選択プレイヤー == 前作スネーク ) {

			command foreach -argc 9 -repeat 18 \
			-data { \
				// 的名, フラグ, ルート, スタートノード,  公転速度, 初期公転方向, 公転半径, 自転速度, スピード
				// act 1 ----------
				{ 移動的:01, $$i:標的フラグＧ, d:M_R:前作スネークルート２７, 0, -1024,  512, 2750, 1536,   0 }\
				{ 移動的:02, $$i:標的フラグＨ, d:M_R:前作スネークルート２８, 0,   768, 2560, 2750, 1024,   0 }\
				{ 移動的:03, $$i:標的フラグＧ, d:M_R:前作スネークルート２９, 0,  -768, 1536, 2750, 1024,   0 }\
				{ 移動的:04, $$i:標的フラグＨ, d:M_R:前作スネークルート３０, 0,  1024, 1024, 2750, 1536,   0 }\
				{ 移動的:05, $$i:標的フラグＥ, d:M_R:前作スネークルート３１, 0,     0,    0,    0, 1024,  50 }\
				{ 移動的:06, $$i:標的フラグＥ, d:M_R:前作スネークルート３２, 0,     0,    0,    0, 1024,  50 }\
				// act 2 ----------
				{ 移動的:07, $$i:標的フラグＨ, d:M_R:前作スネークルート３３, 0,  1024, 1536, 2750, 1536,   0 }\
				{ 移動的:08, $$i:標的フラグＨ, d:M_R:前作スネークルート３４, 0,  1280, 2048, 2750, 1664,   0 }\
				{ 移動的:09, $$i:標的フラグＧ, d:M_R:前作スネークルート３５, 0, -1024, 2560, 2750, 1536,   0 }\
				{ 移動的:10, $$i:標的フラグＤ, d:M_R:前作スネークルート３６, 0,     0,    0,    0, 1024,  80 }\
				{ 移動的:11, $$i:標的フラグＥ, d:M_R:前作スネークルート３７, 1,     0,    0,    0, 1024,  50 }\
				{ 移動的:12, $$i:標的フラグＥ, d:M_R:前作スネークルート３８, 1,     0,    0,    0, 1024,  80 }\
				// act 3 ----------
				{ 移動的:13, $$i:標的フラグＨ, d:M_R:前作スネークルート３９, 0,  1024,  768, 3500, 1536,   0 }\
				{ 移動的:14, $$i:標的フラグＨ, d:M_R:前作スネークルート４０, 0,  1024, 2816, 3500, 1536,   0 }\
				{ 移動的:15, $$i:標的フラグＤ, d:M_R:前作スネークルート４１, 0,     0,    0,    0, 1536,  75 }\
				{ 移動的:16, $$i:標的フラグＥ, d:M_R:前作スネークルート４２, 0,     0,    0,    0, 1536,  75 }\
				{ 移動的:17, $$i:標的フラグＥ, d:M_R:前作スネークルート４３, 1,     0,    0,    0, 2048, 100 }\
				{ 移動的:18, $$i:標的フラグＤ, d:M_R:前作スネークルート４４, 1,     0,    0,    0, 2048, 100 }\
			} \
			-exec { \
				// 前作スネークは順番を逆にする
				$$b:標的セット数 = $$b:標的セット数 + 1;
				if( $$b:標的セット数 % 2 ) {
					$$i:標的フラグ = ( $2 | d:VR_TRG_VISIBLESTART );
				} else {
					$$i:標的フラグ = ( $2 | d:VR_TRG_HIDESTART );
				}

			 	chara ＶＲ移動的 $1 \
					-flag $$i:標的フラグ \
					-route $3 $4 \
					-kouten $5 $6 $7 \
					-dir 0 $8 \
					-c ＶＲ標的破壊スティンガー３面処理 \
					-speed $9
			}

		}

	}

	proc ＶＲ初期配置標的スティンガー３面設定 {
		// 共通標的 （主にライデン）
		mesg ＶＲ的共通 移動的:01 移動開始
		mesg ＶＲ的共通 移動的:02 移動開始
		mesg ＶＲ的共通 移動的:03 移動開始
		mesg ＶＲ的共通 移動的:04 移動開始

		// 他キャラ選択時の追加標的s
		// スネーク or プリスキン
		if ( ($s:選択プレイヤー == スネーク) || ($s:選択プレイヤー == プリスキン) ) {
			mesg ＶＲ的共通 移動的:05 移動開始
		// 前作スネーク
		} else if ( $s:選択プレイヤー == 前作スネーク ) {
			mesg ＶＲ的共通 移動的:05 移動開始
			mesg ＶＲ的共通 移動的:06 移動開始
		}
	}

//###################################################################################
//									 ＢＧＭ
//###################################################################################

	// ------------------------------------
	// ＢＧＭの設定
	// ------------------------------------
	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT
			print 'bgm_set'
		#endif

		chara ＢＧＭマネージャー ＢＧＭマネ
	}


//###################################################################################
//									 アイテム
//###################################################################################

	// ------------------------------------
	// アイテムの設定
	// ------------------------------------
	// 再発生が必要な時は以下のプロックの中を記述する
	// ------------------------------------
	proc アイテム取得時番号設定 $:ボックス名 {
		#if d:DEBUG_PRINT
			print 'item_no_set'
		#endif
	}
	// アイテムの設置
	// ------------------------------------
	proc アイテム設定 {
		#if d:DEBUG_PRINT
			print 'item_set'
		#endif
	}



//###################################################################################
//									 エフェクト
//###################################################################################

	// ------------------------------------
	// 光源関係
	// ------------------------------------
	// フォグ
	// ------------------------------------
	// キャラ用光源(マップの設置が終わってから設定することで、キャラだけに光を当てる)
	// ------------------------------------



//###################################################################################
//									 カメラ
//###################################################################################
	// ------------------------------------
	// カメラ関係の設定
	// ------------------------------------
	// ステージカメラ設定
	// ------------------------------------
	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'chara_camera & stage_camera_set'
		#endif

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0
		chara カメラ メインカメラ		-c 0 -l 2 -p 40
		chara カメラ クリア時カメラ		-c 0 -l 0 -p 10

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 150,2048,0 \
			-f 9000 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}
	// ステージ固有のカメラ設定
	// ------------------------------------
	proc 武器訓練スティンガー３面カメラ設定 {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif
	}



//###################################################################################
//									 その他
//###################################################################################


// -----------------------------------------------------------------------------------
// 以下デバッグ専用proc
// -----------------------------------------------------------------------------------
// デバッグキャラ
// ------------------------------------
proc デバッグキャラセット {
	#if d:DEBUG_PRINT
		print 'debug_chara_set'
	#endif

	#if d:CHARA_CAMERA
		chara キャラカメラ 敵兵カメラ \
			-c d:TARGET_CHARA \
			-s -920,610,200 \
			-r -200,1024,0
	#endif

	#if d:SCREENSHOT
		chara スクリーンショット shot
	#endif

	#if d:USB_KEY
		chara USBキーボード実行 test \
			-e d:KBD_ESC {
				mesg プレイヤー d:PLAYER position -5500, -13000, -500
			} \
	#endif
}

