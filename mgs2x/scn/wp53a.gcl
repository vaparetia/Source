// ------------------------------------
// 各gclで必要なdefine
// ------------------------------------
// 共通プロック切り分け用
#define		STAGE_VR		1		// モード
#define		STAGE_WP53A		1		// ステージ名
#define		VR_WEAPON		1		// VRステージの呼び分け

#define		STAGE_START		1		// ステージ開始直後処理
#define		CUSTOM_TRG_SPEED	1	// 前作スネークのスピードカスタム機能を停止

// ------------------------------------
// 各種スイッチ用define
// ------------------------------------
// デバッグ関係
#ifdef	d:FIX_MODE
	#define		DEBUG_CHARA		0		// デバッグキャラ全体(FIX時は0)
#else
	#define		DEBUG_CHARA		0		// デバッグキャラ全体
#endif
#define		CHARA_CAMERA	0		// キャラ追従カメラ
#define		TARGET_CHARA	敵兵:01	// キャラ追従カメラのターゲット
#define		SCREENSHOT		0		// スクリーンショット
#define		USB_KEY			0		// USBキーボード


// ------------------------------------
// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME			ws53a
#define		KMS_NAME			ws53a
#define		TONBO_KMS_NAME		ws53a_tonbo
#define		LINE_KMS_NAME		ws53a_line

// キャラクター関係
#define		PLAYER		ライデン


// ------------------------------------
// ローカル変数
// ------------------------------------


// ------------------------------------
// 的ルート番号
// ------------------------------------
enum M_R {
	//	スティンガー３面用
//	共通ルート０ = 0,	// 欠番
	ライデンルート１ = 1,
	ライデンルート２,   ライデンルート３,   ライデンルート４,   ライデンルート５,   ライデンルート６,
	ライデンルート７,   ライデンルート８,   ライデンルート９,   ライデンルート１０, ライデンルート１１,
	ライデンルート１２,

	スネークルート１３, スネークルート１４, スネークルート１５, スネークルート１６, スネークルート１７,
	スネークルート１８, スネークルート１９, スネークルート２０, スネークルート２１, スネークルート２２,
	スネークルート２３, スネークルート２４, スネークルート２５, スネークルート２６,

	前作スネークルート２７, 前作スネークルート２８, 前作スネークルート２９, 前作スネークルート３０, 前作スネークルート３１,
	前作スネークルート３２, 前作スネークルート３３, 前作スネークルート３４, 前作スネークルート３５, 前作スネークルート３６,
	前作スネークルート３７, 前作スネークルート３８, 前作スネークルート３９, 前作スネークルート４０, 前作スネークルート４１,
	前作スネークルート４２, 前作スネークルート４３, 前作スネークルート４４,
}


