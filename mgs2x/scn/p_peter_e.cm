Hmm... it looks like VR Training
does come in handy.
}
/*ふん、ＶＲ訓練も役に立つということか。
*/
//dv}//v
}//d

//時間超早い h //e
resource PP_爆弾評価＿時間超早い__e {
//vox t:vc200321 {
