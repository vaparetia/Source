//---------------------------------------------------------------------------
//	紙芝居スタート(tales_storyの初期化は各ストーリーがはじまるロード関数で行う)
//---------------------------------------------------------------------------
#if d:DEBUG_PRINT 
	print '$b:tales_story_no='$b:tales_story_no
	print '$b:tales_story_a='$b:tales_story_a
	print '$b:tales_story_b='$b:tales_story_b
	print '$b:tales_story_c='$b:tales_story_c
	print '$b:tales_story_d='$b:tales_story_d
	print '$b:tales_story_e='$b:tales_story_e
#endif


command セーブ用参照変数登録 $b:tales_story_no \
		$f:テイルズＡクリアしたフラグ \
		$f:テイルズＢクリアしたフラグ \
		$f:テイルズＣクリアしたフラグ \
		$f:テイルズＤクリアしたフラグ \
		$f:テイルズＥクリアしたフラグ


// 紙芝居ではポーズを禁止する
command メニュー設定 -pause off

// 紙芝居に入るときは敵兵情報を全てリセットする
command 敵兵メモリーオールリセット

// スネークテイルズの時には必ずこのフラグを立てる
command テイルズステージセット

if ( $f:テイルズタイトル表示終了フラグ == 0 ) {
	switch ( $b:tales_story_no ) {
		case ( d:TALES_NO:A ) {
			chara サウンドマネージャー ＳＤマネ -pak 1
			@タイトルテロップ表示 snake_tales_ltitlea_alp_ovl
		}
		case ( d:TALES_NO:B ) {
			chara サウンドマネージャー ＳＤマネ -pak 0
			@タイトルテロップ表示 snake_tales_ltitleb_alp_ovl
		}
		case ( d:TALES_NO:C ) {
			chara サウンドマネージャー ＳＤマネ -pak 0
			@タイトルテロップ表示 snake_tales_ltitlec_alp_ovl
		}
		case ( d:TALES_NO:D ) {
			chara サウンドマネージャー ＳＤマネ -pak 1
			@タイトルテロップ表示 snake_tales_ltitled_alp_ovl
		}
		case ( d:TALES_NO:E ) {
			chara サウンドマネージャー ＳＤマネ -pak 1
			@タイトルテロップ表示 snake_tales_ltitlee_alp_ovl
		}
	}
} else {
	switch ( $b:tales_story_no ) {
		// テイルズＡ
		case ( d:TALES_NO:A ) {
			switch ( $b:tales_story_a ) {
				//-------------------------------------
				// ゲームスタート時の紙芝居
				case ( d:TALES_A:スタート ) {
					$b:tales_story_a = d:TALES_A:エイムズ遭遇前;
					
					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定１

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ａ:A1_スタート] \
						-e テイルズ入れ替え＿A1_スタート \
						-i 背景テクスチャプロック \
						-p mv_tales_a12a_0
				}

				//-------------------------------------
				// エイムズに会う前に起きうるイベント
				case ( d:TALES_A:エイムズ遭遇前 ) {
					// ゲームスタート時にすぐにエレベーター乗っちゃった
					$b:tales_story_a = d:TALES_A:エンド;
					$w:現ステージ番号 = d:ステージ名:スネークテイルズＡクリア;

					//ＢＧＭ指定ＸＸＸ
					@テイルズ紙芝居内ＢＧＭ設定０

					command ＶＲコンティニュー禁止

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ａ:A_昇降機乗ってゲームオーバー] \
						-e テイルズ入れ替え＿A_昇降機乗ってゲームオーバー \
						-i 背景テクスチャプロック \
						-l 1 \
	//					-p load_tales_select //ほんとはスタッフロール→リザルト→ＳＡＶＥ→テイルズセレクトだけど
						-p 紙芝居ゲームオーバー //ほんとはゲームオーバーだけど
	//					-p load_select
				}

				//-------------------------------------
				// エイムズに会った時の紙芝居
				case ( d:TALES_A:エイムズ遭遇中 ) {
					$b:tales_story_a = d:TALES_A:ジェニファー遭遇前;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定０

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ａ:A2_エイムズ遭遇] \
						-e テイルズ入れ替え＿A2_エイムズ遭遇 \
						-i 背景テクスチャプロック \
						-p mv_tales_a22a_0
				}

				//-------------------------------------
				// エイムズに会った後ジェニファーに会うまでに起こりうるイベント
				case ( d:TALES_A:ジェニファー遭遇前 ) {
					if ( $f:テイルズＡファットマンに会ったフラグ == 0 ) {
						// 人質部屋にきた
						
						if ( $f:テイルズＡ人質部屋１回来たフラグ == 0 ) {
						// 人質部屋に始めてきた
							eval( $w:現ステージ番号 = d:ステージ名:シェル１中央棟Ｂ１集会場 );
							command varsave $w:現ステージ番号;

							$f:テイルズＡ人質部屋１回来たフラグ = 1;
							if ( $w:武器弾数Ｒ[ d:武器:マイク ] == -1 ) {

								//ＢＧＭ指定
								@テイルズ紙芝居内ＢＧＭ設定０

								chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
									-r [テイルズ＿Ａ:AM_人質部屋イベント説明] \
									-e テイルズ入れ替え＿AM_人質部屋イベント説明＿初回マイク持ってない \
									-i 背景テクスチャプロック \
									-p mv_tales_a24c_0
							} else {
								// このフラグを立てると以降、人質部屋紙芝居はロードされない
								$f:テイルズＡ人質部屋紙芝居終了フラグ = 1;

								//ＢＧＭ指定
								@テイルズ紙芝居内ＢＧＭ設定０

								chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
									-r [テイルズ＿Ａ:AM_人質部屋イベント説明] \
									-e テイルズ入れ替え＿AM_人質部屋イベント説明＿初回マイク持ってる \
									-i 背景テクスチャプロック \
									-p mv_tales_a24c_0
							}

						} else {
						// 人質部屋にマイクを持って再びきた
							if ( $w:武器弾数Ｒ[ d:武器:マイク ] == 1 ) {
								// このフラグを立てると以降、人質部屋紙芝居はロードされない
								$f:テイルズＡ人質部屋紙芝居終了フラグ = 1;

								//ＢＧＭ指定
								@テイルズ紙芝居内ＢＧＭ設定０

								chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
									-r [テイルズ＿Ａ:AM_人質部屋イベント説明] \
									-e テイルズ入れ替え＿AM_人質部屋イベント説明＿マイクと共に再来 \
									-i 背景テクスチャプロック \
									-p mv_tales_a24c_0
							}
						}

					} else {
					// ヘリポートにきた
						if ( $f:テイルズＡファットマン倒したフラグ == 0 ) {
							// ジェニファーに会わずにファットマンのところに来た時の紙芝居

							//ＢＧＭ指定
							@テイルズ紙芝居内ＢＧＭ設定１

							chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
								-r [テイルズ＿Ａ:AF1_ジェニファー無視してファットマンと対決] \
								-e テイルズ入れ替え＿AF1_ジェニファー無視してファットマンと対決 \
								-i 背景テクスチャプロック \
								-p mv_tales_a20c_0

						} else {
							// ジェニファーに会わずにファットマンを倒した時の紙芝居
							$b:tales_story_a = d:TALES_A:エンド;
							$w:現ステージ番号 = d:ステージ名:スネークテイルズＡクリア;
							$f:テイルズＡクリアしたフラグ = 1;

							if ( $f:テイルズＡファットマン気絶フラグ == 0 ) {
								// ファットマン殺した

								//ＢＧＭ指定
								@テイルズ紙芝居内ＢＧＭ設定０

								chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
									-r [テイルズ＿Ａ:AF2_ジェニファー会わずにファットマン倒した] \
									-e テイルズ入れ替え＿AF2_ジェニファー無視してファットマン殺した \
									-i 背景テクスチャプロック \
									-l 1 \
									-p load_tales_select //ほんとはスタッフロール→リザルト→ＳＡＶＥ→テイルズセレクトだけど
	//								-p load_selects
							} else {
								// ファットマン気絶させた

								//ＢＧＭ指定
								@テイルズ紙芝居内ＢＧＭ設定０

								chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
									-r [テイルズ＿Ａ:AF2_ジェニファー会わずにファットマン倒した] \
									-e テイルズ入れ替え＿AF2_ジェニファー無視してファットマン気絶させた \
									-i 背景テクスチャプロック \
									-l 1 \
									-p load_tales_select //ほんとはスタッフロール→リザルト→ＳＡＶＥ→テイルズセレクトだけど
	//								-p load_select
							}
						}
					}
				}

				//-------------------------------------
				// ジェニファーに会った時の紙芝居
				case ( d:TALES_A:ジェニファー遭遇中 ) {
					$b:tales_story_a = d:TALES_A:爆弾解体前;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定２

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ａ:AJ1_ジェニファー救出] \
						-e テイルズ入れ替え＿AJ1_ジェニファー救出 \
						-i 背景テクスチャプロック \
						-p mv_tales_a24b_0
				}

				//-------------------------------------
				// ジェニファーに会った後爆弾解体するまでに起こるイベント
				case ( d:TALES_A:爆弾解体前 ) {
					// ヘリポートにきた
					if ( $f:テイルズＡファットマン倒したフラグ == 0 ) {
						// 爆弾解体せずにファットマンのところに来た時の紙芝居

						//ＢＧＭ指定
						@テイルズ紙芝居内ＢＧＭ設定１

						chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
							-r [テイルズ＿Ａ:AJF1_爆弾解体せずにファットマンに会った] \
							-e テイルズ入れ替え＿AJF1_爆弾解体せずにファットマンに会った \
							-i 背景テクスチャプロック \
							-p mv_tales_a20c_0

					} else {
						// 爆弾解体せずにファットマンを倒した時の紙芝居
						$b:tales_story_a = d:TALES_A:エンド;
						$w:現ステージ番号 = d:ステージ名:スネークテイルズＡクリア;
						$f:テイルズＡクリアしたフラグ = 1;

						if ( $f:テイルズＡファットマン気絶フラグ == 0 ) {
							// ファットマン殺した

							//ＢＧＭ指定
							@テイルズ紙芝居内ＢＧＭ設定０

							chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
								-r [テイルズ＿Ａ:AJF2_爆弾解体せずにファットマン倒した] \
								-e テイルズ入れ替え＿AJF2A_爆弾解体せずにファットマン殺した \
								-i 背景テクスチャプロック \
									-l 1 \
								-p load_tales_select //ほんとはスタッフロール→リザルト→ＳＡＶＥ→テイルズセレクトだけど
	//							-p load_select
						} else {
							// ファットマン気絶させた

							//ＢＧＭ指定
							@テイルズ紙芝居内ＢＧＭ設定０

							chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
								-r [テイルズ＿Ａ:AJF2_爆弾解体せずにファットマン倒した] \
								-e テイルズ入れ替え＿AJF2B_爆弾解体せずにファットマン気絶させた \
								-i 背景テクスチャプロック \
									-l 1 \
								-p load_tales_select //ほんとはスタッフロール→リザルト→ＳＡＶＥ→テイルズセレクトだけど
	//							-p load_select
						}
					}
				}

				//-------------------------------------
				// 爆弾解体してエレベータ前にきたときの紙芝居
				case ( d:TALES_A:爆弾解体中 ) {
					$b:tales_story_a = d:TALES_A:爆弾解体後;

					if ( $s:テイルズＡエレベータの行き先ステージ名 == a24a ) {
							eval( $w:現ステージ番号 = d:ステージ名:シェル１中央棟１Ｆ );
							command varsave $w:現ステージ番号;

						//ＢＧＭ指定
						@テイルズ紙芝居内ＢＧＭ設定０

						chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
							-r [テイルズ＿Ａ:AJB1_爆弾解体成功後] \
							-e テイルズ入れ替え＿AJB1_爆弾解体成功後 \
							-i 背景テクスチャプロック \
							-p mv_tales_a24a_0
					} else {
							eval( $w:現ステージ番号 = d:ステージ名:シェル１中央棟Ｂ１ );
							command varsave $w:現ステージ番号;

						//ＢＧＭ指定
						@テイルズ紙芝居内ＢＧＭ設定０

						chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
							-r [テイルズ＿Ａ:AJB1_爆弾解体成功後] \
							-e テイルズ入れ替え＿AJB1_爆弾解体成功後 \
							-i 背景テクスチャプロック \
							-p mv_tales_a24b_1
					}
				}

				//-------------------------------------
				// 爆弾解体後に起こるイベント
				case ( d:TALES_A:爆弾解体後 ) {
					if ( $f:テイルズＡファットマン倒したフラグ == 0 ) {
						// 爆弾解体後にファットマンのところに来た時の紙芝居
						
						//ＢＧＭ指定
						@テイルズ紙芝居内ＢＧＭ設定１

						chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
							-r [テイルズ＿Ａ:AJBF1_爆弾解体してファットマンと対決] \
							-e テイルズ入れ替え＿AJBF1_爆弾解体してファットマンと対決 \
							-i 背景テクスチャプロック \
							-p mv_tales_a20c_0

					} else {
						// 爆弾解体後にファットマンを倒した時の紙芝居
						$b:tales_story_a = d:TALES_A:エンド;
						$w:現ステージ番号 = d:ステージ名:スネークテイルズＡクリア;
						$f:テイルズＡクリアしたフラグ = 1;

						if ( $f:テイルズＡファットマン気絶フラグ == 0 ) {
							// ファットマン殺した

							//ＢＧＭ指定
							@テイルズ紙芝居内ＢＧＭ設定０

							chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
								-r [テイルズ＿Ａ:AJBF2_A_爆弾解体後にファットマン殺した] \
								-e テイルズ入れ替え＿AJBF2_A \
								-i 背景テクスチャプロック \
								-l 1 \
								-p load_tales_select //ほんとはスタッフロール→リザルト→ＳＡＶＥ→テイルズセレクトだけど
	//							-p load_select
						} else {
							// ファットマン気絶させた

							//ＢＧＭ指定
							@テイルズ紙芝居内ＢＧＭ設定０

							chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
								-r [テイルズ＿Ａ:AJBF2_B_爆弾解体後にファットマン気絶させた] \
								-e テイルズ入れ替え＿AJBF2_B \
								-i 背景テクスチャプロック \
								-l 1 \
								-p load_tales_select //ほんとはスタッフロール→リザルト→ＳＡＶＥ→テイルズセレクトだけど
	//							-p load_select
						}
					}
				}

			}
		}

		// テイルズＢ
		case ( d:TALES_NO:B ) {
			switch ( $b:tales_story_b ) {
				//-------------------------------------
				// ゲームスタート時の紙芝居
				case ( d:TALES_B:スタート ) {
					$b:tales_story_b = d:TALES_B:立ち話盗み聞き前;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定０

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｂ:B1＿スタート] \
						-e テイルズ入れ替え＿B1＿スタート \
						-i 背景テクスチャプロック \
						-p mv_init_a20b_b0
				}

				//-------------------------------------
				// 敵兵立ち話盗み聞きの紙芝居
				case ( d:TALES_B:立ち話盗み聞き前 ) {
					eval( $w:現ステージ番号 = d:ステージ名:ＤＥ連絡橋 );
					command varsave $w:現ステージ番号;

					$b:tales_story_b = d:TALES_B:エマ遭遇前;

					//敵にみつかってるぽい
					if($f:テイルズＢ見つかったりしたフラグ){

						//ＢＧＭ指定
						@テイルズ紙芝居内ＢＧＭ設定１

						chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
							-r [テイルズ＿Ｂ:B2_ＤＥ連絡橋に出た] \
							-e テイルズ入れ替え＿B2_ＤＥ連絡橋に出た＿みつかってる \
							-i 背景テクスチャプロック \
							-p mv_tales_a19a_b0
					}else {
						//ＢＧＭ指定
						@テイルズ紙芝居内ＢＧＭ設定１

						chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
							-r [テイルズ＿Ｂ:B2_ＤＥ連絡橋に出た] \
							-e テイルズ入れ替え＿B2_ＤＥ連絡橋に出た＿みつかってない \
							-i 背景テクスチャプロック \
							-p mv_tales_a19a_b0
					}
				}

				//-------------------------------------
				// エマ遭遇の紙芝居
				case ( d:TALES_B:エマ遭遇中 ) {
					$b:tales_story_b = d:TALES_B:敵兵倒す前;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定２

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｂ:B3_Ｃ脚エマ遭遇] \
						-e テイルズ入れ替え＿B3_Ｃ脚エマ遭遇 \
						-i 背景テクスチャプロック \
						-p mv_tales_a16a_b0
				}
				//-------------------------------------
				// 敵兵倒した後の紙芝居
				case ( d:TALES_B:敵兵倒し中 ) {
					$b:tales_story_b = d:TALES_B:Ｂ脚ノードアクセス前;

					//	カードくれる
					$w:アイテム数Ｒ[d:アイテム:カード] = 1;

	#if 0
					//怪我してるとレーションくれる
					if ($f:テイルズＢスネーク怪我したフラグ) {
						//	レーションくれる
						$w:アイテム数Ｒ[d:アイテム:レーション] = $w:アイテム数Ｒ[d:アイテム:レーション] + 1;
					}
	#endif

					//	怪我した場合
					if ($f:テイルズＢスネーク怪我したフラグ == 1) {
						//	レーションくれる
						$w:アイテム数Ｒ[d:アイテム:レーション] = $w:アイテム数Ｒ[d:アイテム:レーション] + 1;

						//ＢＧＭ指定
						@テイルズ紙芝居内ＢＧＭ設定２

						chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
							-r [テイルズ＿Ｂ:B4_Ｃ脚敵兵倒した後] \
							-e テイルズ入れ替え＿B4_Ｃ脚敵兵倒した後Ａ＿怪我した \
							-i 背景テクスチャプロック \
							-p mv_tales_a16a_b1
					//	怪我してない場合
					} else {
						//ＢＧＭ指定
						@テイルズ紙芝居内ＢＧＭ設定２

						chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
							-r [テイルズ＿Ｂ:B4_Ｃ脚敵兵倒した後] \
							-e テイルズ入れ替え＿B4_Ｃ脚敵兵倒した後Ｂ＿怪我してない \
							-i 背景テクスチャプロック \
							-p mv_tales_a16a_b1
					}
				}

				//-------------------------------------
				// ノードアクセスの紙芝居
				case ( d:TALES_B:Ｂ脚ノードアクセス中 ) {
					$b:tales_story_b = d:TALES_B:Ｆ脚入る前;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定１

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｂ:B5_ノードにアクセス後] \
						-e テイルズ入れ替え＿B5_ノードにアクセス後 \
						-i 背景テクスチャプロック \
						-p mv_tales_a14a_b0
				}

				//-------------------------------------
				//	シェル１シェル２連絡橋行くな紙芝居Ａ
				case ( d:TALES_B:Ｆ脚入る前) {
					/*	ストーリーフラグには影響しない	*/

					eval( $w:現ステージ番号 = d:ステージ名:ＤＧ連絡橋);
					command varsave $w:現ステージ番号;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定１

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｂ:Ｂ＿シェル１シェル２連絡橋に出た＿エマ救出前] \
						-e テイルズ入れ替え＿Ｂ＿シェル１シェル２連絡橋に出た＿エマ救出前 \
						-i 背景テクスチャプロック \
						-p mv_tales_a18a_b0
				}

				//-------------------------------------
				//	オタコン念押し紙芝居
				case ( d:TALES_B:Ｆ脚入り中) {
					eval( $w:現ステージ番号 = d:ステージ名:Ｆ脚倉庫);
					command varsave $w:現ステージ番号;

					$b:tales_story_b = d:TALES_B:エマ再会前;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定０

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｂ:B6_Ｆ脚侵入] \
						-e テイルズ入れ替え＿B6_Ｆ脚侵入 \
						-i 背景テクスチャプロック \
						-p mv_tales_a22a_b0
				}

				//-------------------------------------
				//	シェル１シェル２連絡橋行くな紙芝居Ａ		//	Ｆ脚に入って後、エマに会わずにＤ脚に戻る
				case ( d:TALES_B:エマ再会前) {
					/*	ストーリーフラグには影響しない	*/
					eval( $w:現ステージ番号 = d:ステージ名:ＤＧ連絡橋);
					command varsave $w:現ステージ番号;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定１

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｂ:Ｂ＿シェル１シェル２連絡橋に出た＿エマ救出前] \
						-e テイルズ入れ替え＿Ｂ＿シェル１シェル２連絡橋に出た＿エマ救出前 \
						-i 背景テクスチャプロック \
						-p mv_tales_a18a_b0
				}

				//-------------------------------------
				//	エマ再会紙芝居
				case ( d:TALES_B:エマ再会中) {
					$b:tales_story_b = d:TALES_B:Ｅ脚戻る前;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定２

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｂ:B7_エマ再会] \
						-e テイルズ入れ替え＿B7_エマ再会 \
						-i 背景テクスチャプロック \
						-p mv_tales_a22a_b1
				}

				//-------------------------------------
				//	シェル１シェル２連絡橋行くな紙芝居Ｂ		//	エマを置いてＤ脚に戻る
				case ( d:TALES_B:Ｅ脚戻る前) {
					/*	ストーリーフラグには影響しない	*/

					eval( $w:現ステージ番号 = d:ステージ名:ＤＧ連絡橋);
					command varsave $w:現ステージ番号;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定１

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｂ:Ｂ＿シェル１シェル２連絡橋に出た＿エマ救出後] \
						-e テイルズ入れ替え＿Ｂ＿シェル１シェル２連絡橋に出た＿エマ救出後 \
						-i 背景テクスチャプロック \
						-p mv_tales_a18a_b0
				}

				//-------------------------------------
				//	エマノードアクセス紙芝居
				case ( d:TALES_B:Ｅ脚戻り中) {
					eval( $w:現ステージ番号 = d:ステージ名:Ｅ脚集配場);
					command varsave $w:現ステージ番号;

					$b:tales_story_b = d:TALES_B:Ｅ脚脱出前;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定１

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｂ:B8_エマとＥ脚到着] \
						-e テイルズ入れ替え＿B8_エマとＥ脚到着 \
						-i 背景テクスチャプロック \
						-p mv_tales_a20a_b0
				}

				//-------------------------------------
				//	エマ置きっぱなし紙芝居
				case ( d:TALES_B:Ｅ脚脱出前) {
					//ＢＧＭ指定ＸＸＸＸＸＸＸＸ
					@テイルズ紙芝居内ＢＧＭ設定０

					/*		ゲームオーバー		*/
					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｂ:Ｂ＿エマをおいて一人ＤＥ連絡橋に脱出] \
						-e テイルズ入れ替え＿Ｂ＿エマをおいて一人ＤＥ連絡橋に脱出 \
						-i 背景テクスチャプロック \
						-l 1 \
						-p 紙芝居ゲームオーバー
				}

				//-------------------------------------
				//	敵兵閉じ込め紙芝居
				case ( d:TALES_B:Ｅ脚脱出中) {
					eval( $w:現ステージ番号 = d:ステージ名:ＤＧ連絡橋);
					command varsave $w:現ステージ番号;

					$b:tales_story_b = d:TALES_B:ハリアー戦前;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定２

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｂ:B9_ハリアー戦前] \
						-e テイルズ入れ替え＿B9_ハリアー戦前 \
						-i 背景テクスチャプロック \
						-p mv_tales_a25a_b0
				}

				//-------------------------------------
				//	エンディング紙芝居
				case ( d:TALES_B:ハリアー戦後) {
					$b:tales_story_b = d:TALES_B:エンド;
					$w:現ステージ番号 = d:ステージ名:スネークテイルズＢクリア;
					$f:テイルズＢクリアしたフラグ = 1;

					if ($f:テイルズＢエマ怪我したフラグ == 1) {

						//ＢＧＭ指定
						@テイルズ紙芝居内ＢＧＭ設定２

						chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
							-r [テイルズ＿Ｂ:B10_エンディング] \
							-e テイルズ入れ替え＿B10_エンディングＡ＿エマ怪我した \
							-i 背景テクスチャプロック \
							-l 1 \
							-p load_tales_select //ほんとはスタッフロール→リザルト→ＳＡＶＥ→テイルズセレクトだけど
	//						-p load_select \
					//	エマが怪我してない場合
					} else {

						//ＢＧＭ指定
						@テイルズ紙芝居内ＢＧＭ設定２

						chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
							-r [テイルズ＿Ｂ:B10_エンディング] \
							-e テイルズ入れ替え＿B10_エンディングＢ＿エマ怪我してない \
							-i 背景テクスチャプロック \
							-l 1 \
							-p load_tales_select //ほんとはスタッフロール→リザルト→ＳＡＶＥ→テイルズセレクトだけど
	//						-p load_select \
					}
				}

			}

		}	//	<-テイルズＢ終わり

	/*************************************************************************************/
	// テイルズＣ
	/*************************************************************************************/
		case ( d:TALES_NO:C ) {
			switch ( $b:tales_story_c ) {
				//-------------------------------------
				// ゲームスタート時の紙芝居
				case ( d:TALES_C:スタート ) {
					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定０

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｃ:C1_スタート] \
						-e テイルズ入れ替え＿C1_スタート \
						-i 背景テクスチャプロック \
						-p load_tal_a00a
				}
				//-------------------------------------
				// メリル遭遇時の紙芝居
				case ( d:TALES_C:メリル遭遇終了 ) {

					//ＢＧＭ指定？？
					@テイルズ紙芝居内ＢＧＭ設定１

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｃ:C2_船橋到着] \
						-e テイルズ入れ替え＿C2_船橋到着 \
						-i 背景テクスチャプロック \
						-p load_tal_a01e
				}
				//-------------------------------------
				// 長廊下で攻撃を受けた時の紙芝居
				case ( d:TALES_C:長廊下で攻撃された終了 ) {

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定１

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｃ:C3_長廊下戦前] \
						-e テイルズ入れ替え＿C3_長廊下戦前 \
						-i 背景テクスチャプロック \
						-p load_tal_a03b_attack
				}
				//-------------------------------------
				// 長廊下戦闘終了時の紙芝居
				case ( d:TALES_C:長廊下戦終了 ) {
					eval( $w:現ステージ番号 = d:ステージ名:第一船倉);
					command varsave $w:現ステージ番号;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定０

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｃ:C4_長廊下戦後] \
						-e テイルズ入れ替え＿C4_長廊下戦後 \
						-i 背景テクスチャプロック \
						//-p mv_a03b_a03a_0
						-p load_tal_a03a_after_nagarouka_attack
				}
				//-------------------------------------
				// 大佐デモ開始
				case ( d:TALES_C:大佐デモ開始 ) {
					eval( $w:現ステージ番号 = d:ステージ名:機関室);
					command varsave $w:現ステージ番号;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定０

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｃ:C5_機関室脱出] \
						-e テイルズ入れ替え＿C5_機関室脱出 \
						-i 背景テクスチャプロック \
						-p load_after_colonel_demo
				} 
				//-------------------------------------
				// メリル戦前デモ開始
				case ( d:TALES_C:メリル戦前デモ開始 ) {
					eval( $w:現ステージ番号 = d:ステージ名:航海甲板ウィング);
					command varsave $w:現ステージ番号;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定１

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｃ:C6_メリル再会] \
						-e テイルズ入れ替え＿C6_メリル再会 \
						-i 背景テクスチャプロック \
						-p load_tal_vs_mrl
				}
				//-------------------------------------
				// メリルＵＳＰで倒した
				case ( d:TALES_C:メリルＵＳＰで倒した ) {
					$f:テイルズＣクリアしたフラグ = 1;
					$w:現ステージ番号 = d:ステージ名:スネークテイルズＣクリア;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定０

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
							-r [テイルズ＿Ｃ:C7_メリル戦後] \
							-e テイルズ入れ替え＿C7_メリル戦後Ａ＿殺した \
							-i 背景テクスチャプロック \
							-l 1 \
							-p load_tales_select //ほんとはスタッフロール→リザルト→ＳＡＶＥ→テイルズセレクトだけど
	//						-p mv_init_n_title_0
					}
				//-------------------------------------
				// メリルＭ９で倒した
				case ( d:TALES_C:メリルＭ９で倒した ) {
					$f:テイルズＣクリアしたフラグ = 1;
					$w:現ステージ番号 = d:ステージ名:スネークテイルズＣクリア;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定０

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｃ:C7_メリル戦後] \
						-e テイルズ入れ替え＿C7_メリル戦後Ｂ＿気絶させた \
						-i 背景テクスチャプロック \
						-l 1 \
						-p load_tales_select //ほんとはスタッフロール→リザルト→ＳＡＶＥ→テイルズセレクトだけど
	//					-p mv_init_n_title_0
				}
				
				default {
					command assert ( d:FALSE ) 'そのような番号のテイルズフラグはありません'
				}
			}
		} // <-テイルズＣ終わり


		// テイルズ＿Ｄ
		case ( d:TALES_NO:D) {
			switch ( $b:tales_story_d ) {
				//-------------------------------------
				// ゲームスタート時の紙芝居
				case ( d:TALES_D:スタート ) {
					$b:tales_story_d = d:TALES_D:シールズ全滅前;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定１

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｄ:D1_スタート] \
						-i 背景テクスチャプロック \
						-e テイルズ入れ替え＿D1_スタート \
						-p mv_init_a22a_d0
				}
				
				//-------------------------------------
				// シールズ全滅の紙芝居
				case ( d:TALES_D:シールズ全滅前 ) {
					eval( $w:現ステージ番号 = d:ステージ名:Ｂ脚変電室);
					command varsave $w:現ステージ番号;

					$b:tales_story_d = d:TALES_D:Ｄ脚到着前;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定１

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｄ:D2_シールズ全滅] \
						-e テイルズ入れ替え＿D2_シールズ全滅 \
						-i 背景テクスチャプロック \
						-p mv_tales_a14a_d0
				}
				
				//-------------------------------------
				// Ｄ脚到着の紙芝居
				case ( d:TALES_D:Ｄ脚到着前 ) {
					eval( $w:現ステージ番号 = d:ステージ名:Ｄ脚第一沈殿池);
					command varsave $w:現ステージ番号;

					$b:tales_story_d = d:TALES_D:Ｅ脚梯子部屋到着前;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定０

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｄ:D3_Ｄ脚到着] \
						-e テイルズ入れ替え＿D3_Ｄ脚到着 \
						-i 背景テクスチャプロック \
						-p mv_tales_a18a_d0
				}

				//-------------------------------------
				// Ｅ脚梯子部屋到着の紙芝居
				case ( d:TALES_D:Ｅ脚梯子部屋到着中 ) {
					eval( $w:現ステージ番号 = d:ステージ名:Ｌ脚下部オイルフェンス);
					command varsave $w:現ステージ番号;

					$b:tales_story_d = d:TALES_D:シェル２中央棟到着前;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定１

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｄ:D4_Ｅ脚梯子部屋到着] \
						-e テイルズ入れ替え＿D4_Ｅ脚梯子部屋到着 \
						-i 背景テクスチャプロック \
						-p mv_tales_a28a_d0
				}

				//-------------------------------------
				// シェル２中央棟到着の紙芝居
				case ( d:TALES_D:シェル２中央棟到着前 ) {
					eval( $w:現ステージ番号 = d:ステージ名:シェル２中央棟１Ｆ空気清浄室);
					command varsave $w:現ステージ番号;

					$b:tales_story_d = d:TALES_D:電撃床破壊前;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定０

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｄ:D5_シェル２中央棟到着] \
						-e テイルズ入れ替え＿D5_シェル２中央棟到着 \
						-i 背景テクスチャプロック \
						-p mv_tales_a31a_d0
				}

				//-------------------------------------
				// 海軍大佐語りの紙芝居
				case ( d:TALES_D:海軍大佐語り中 ) {
					$b:tales_story_d = d:TALES_D:エレベータ搭乗前;
					//	時間がかかった場合
					if ($f:テイルズＤ大佐救助時間消費フラグ == 1) {

						//ＢＧＭ指定
						@テイルズ紙芝居内ＢＧＭ設定０

						chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
							-r [テイルズ＿Ｄ:D6_海軍大佐語り] \
							-e テイルズ入れ替え＿D6_海軍大佐語りＡ＿時間かかった \
							-i 背景テクスチャプロック \
							-p mv_tales_a31a_d1
					//	時間がかからなかった場合
					} else {

						//ＢＧＭ指定
						@テイルズ紙芝居内ＢＧＭ設定０

						chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
							-r [テイルズ＿Ｄ:D6_海軍大佐語り] \
							-e テイルズ入れ替え＿D6_海軍大佐語りＢ＿時間かかった \
							-i 背景テクスチャプロック \
							-p mv_tales_a31a_d1
					}
				}

				//-------------------------------------
				// エレベータ搭乗の紙芝居
				case ( d:TALES_D:エレベータ搭乗中 ) {
					eval( $w:現ステージ番号 = d:ステージ名:シェル２中央棟Ｂ１第二濾過室);
					command varsave $w:現ステージ番号;

					$b:tales_story_d = d:TALES_D:ヴァンプ戦前;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定１

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｄ:D7_エレベータ搭乗] \
						-e テイルズ入れ替え＿D7_エレベータ搭乗 \
						-i 背景テクスチャプロック \
						-p mv_tales_a31c_d0
				}

				//-------------------------------------
				//	エンディング紙芝居
				case ( d:TALES_D:ヴァンプ戦後 ) {
					$b:tales_story_d = d:TALES_D:エンド;
					$w:現ステージ番号 = d:ステージ名:スネークテイルズＤクリア;
					$f:テイルズＤクリアしたフラグ = 1;

					//	海軍大佐を助けたとき時間がかかった場合
					if ($f:テイルズＤ大佐救助時間消費フラグ == 1) {
						//	ヴァンプを殺した場合
						if ($f:テイルズＤヴァンプ気絶フラグ == 0) {

							//ＢＧＭ指定
							@テイルズ紙芝居内ＢＧＭ設定０

							chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
								-r [テイルズ＿Ｄ:D8_エンディング] \
								-e テイルズ入れ替え＿D8_エンディングＡＡ \
								-i 背景テクスチャプロック \
								-l 1 \
								-p load_tales_select //ほんとはスタッフロール→リザルト→ＳＡＶＥ→テイルズセレクトだけど
	//							-p load_select

						//	ヴァンプを気絶させた場合
						} else {

							//ＢＧＭ指定
							@テイルズ紙芝居内ＢＧＭ設定０

							chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
								-r [テイルズ＿Ｄ:D8_エンディング] \
								-e テイルズ入れ替え＿D8_エンディングＡＢ \
								-i 背景テクスチャプロック \
								-l 1 \
								-p load_tales_select //ほんとはスタッフロール→リザルト→ＳＡＶＥ→テイルズセレクトだけど
	//							-p load_select
						}

					//	海軍大佐を助けたとき時間がかからなかった場合
					} else {
						//	ヴァンプを殺した場合
						if ($f:テイルズＤヴァンプ気絶フラグ == 0) {

							//ＢＧＭ指定
							@テイルズ紙芝居内ＢＧＭ設定０

							chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
								-r [テイルズ＿Ｄ:D8_エンディング] \
								-e テイルズ入れ替え＿D8_エンディングＢＡ \
								-i 背景テクスチャプロック \
								-l 1 \
								-p load_tales_select //ほんとはスタッフロール→リザルト→ＳＡＶＥ→テイルズセレクトだけど
	//							-p load_select

						//	ヴァンプを気絶させた場合
						} else {

							//ＢＧＭ指定
							@テイルズ紙芝居内ＢＧＭ設定０

							chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
								-r [テイルズ＿Ｄ:D8_エンディング] \
								-e テイルズ入れ替え＿D8_エンディングＢＢ \
								-i 背景テクスチャプロック \
								-l 1 \
								-p load_tales_select //ほんとはスタッフロール→リザルト→ＳＡＶＥ→テイルズセレクトだけど
	//							-p load_select
						}
					}
					
				}

			}
		}	//	<-テイルズ＿Ｄ終わり


		//----------------------------------------------------------
		// テイルズＥ
		//----------------------------------------------------------
		case ( d:TALES_NO:E) {
			switch ( $b:tales_story_e ) {
				//-------------------------------------
				// ゲームスタート時の紙芝居
				case ( d:TALES_E:スタート ) {
					$b:tales_story_e = d:TALES_E:スネーク回想前;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定１

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｅ:E1_スタート] \
						-e テイルズ入れ替え＿E1_スタート \
						-i 背景テクスチャプロック \
						-p mv_init_a13a_e0
				}

				//-------------------------------------
				// スネーク回想紙芝居
				case ( d:TALES_E:スネーク回想中 ) {
					$b:tales_story_e = d:TALES_E:爆弾解体１面クリア前;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定１

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｅ:E2_スネーク回想] \
						-e テイルズ入れ替え＿E2_スネーク回想 \
						-i 背景テクスチャプロック \
						-p mv_tales_ta02a_e0		//	（爆弾解体本当は２面に相当）
				}

				//-------------------------------------
				// ＶＲシステム説明紙芝居
				case ( d:TALES_E:爆弾解体１面クリア中 ) {
					eval( $w:現ステージ番号 = d:ステージ名:フィランソロピーのアジト );
					command varsave $w:現ステージ番号;

					$b:tales_story_e = d:TALES_E:敵兵排除６面クリア前;
					//	イマイチ
					if ($b:テイルズＥ爆弾解体１面クリア成績フラグ == 0) {

						//ＢＧＭ指定
						@テイルズ紙芝居内ＢＧＭ設定２

						chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
							-r [テイルズ＿Ｅ:E3_回想ＶＲ後] \
							-e テイルズ入れ替え＿E3_回想ＶＲ後＿Ａイマイチ \
							-i 背景テクスチャプロック \
							-p mv_tales_ta24a_e0		//	（敵兵排除６面）
					//	ちゅーくらい
					} else if ($b:テイルズＥ爆弾解体１面クリア成績フラグ == 1) {

						//ＢＧＭ指定
						@テイルズ紙芝居内ＢＧＭ設定２

						chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
							-r [テイルズ＿Ｅ:E3_回想ＶＲ後] \
							-e テイルズ入れ替え＿E3_回想ＶＲ後＿Ｂちゅーくらい \
							-i 背景テクスチャプロック \
							-p mv_tales_ta24a_e0		//	（敵兵排除６面）
					} else if ($b:テイルズＥ爆弾解体１面クリア成績フラグ == 2) {

						//ＢＧＭ指定
						@テイルズ紙芝居内ＢＧＭ設定２

						chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
							-r [テイルズ＿Ｅ:E3_回想ＶＲ後] \
							-e テイルズ入れ替え＿E3_回想ＶＲ後＿Ｃウマー \
							-i 背景テクスチャプロック \
							-p mv_tales_ta24a_e0		//	（敵兵排除６面）
					}
				}

				//-------------------------------------
				// メイ・リン登場紙芝居
				case ( d:TALES_E:敵兵排除６面クリア中 ) {
					eval( $w:現ステージ番号 = d:ステージ名:フィランソロピーのアジト );
					command varsave $w:現ステージ番号;

					$b:tales_story_e = d:TALES_E:Ｃ脚到着前;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定２

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｅ:E4_メイ・リン登場] \
						-e テイルズ入れ替え＿E4 \
						-i 背景テクスチャプロック \
						-p mv_tales_a17a_e0
				}
	//					-r [テイルズ＿Ｅ:E4_0_メイ・リン登場][テイルズ＿Ｅ:E4_1_インチキ新聞後] \

				//-------------------------------------
				// Ｃ脚到着紙芝居
				case ( d:TALES_E:Ｃ脚到着前 ) {
					eval( $w:現ステージ番号 = d:ステージ名:Ｃ脚食堂 );
					command varsave $w:現ステージ番号;
					$b:tales_story_e = d:TALES_E:ＡＢ連絡橋到着前;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定１

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｅ:E5_Ｃ脚到着] \
						-e テイルズ入れ替え＿E5_Ｃ脚到着 \
						-i 背景テクスチャプロック \
						-p mv_tales_a16a_e0
				}

				//-------------------------------------
				// ＡＢ連絡橋到着紙芝居
				case ( d:TALES_E:ＡＢ連絡橋到着前 ) {
					eval( $w:現ステージ番号 = d:ステージ名:ＡＢ連絡橋 );
					command varsave $w:現ステージ番号;
					$b:tales_story_e = d:TALES_E:ゴルルゴン登場デモ前;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定１

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｅ:E6_ＡＢ連絡橋到着] \
						-e テイルズ入れ替え＿E6_ＡＢ連絡橋到着 \
						-i 背景テクスチャプロック \
						-p mv_tales_a13a_e0
				}

				//-------------------------------------
				// オルガ語り紙芝居
				case ( d:TALES_E:オルガ語り中 ) {
					$b:tales_story_e = d:TALES_E:ゴルルゴン写真表示中;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定１

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｅ:E7_0_オルガ語り] \
						-e テイルズ入れ替え＿E7_0 \
						-i 背景テクスチャプロック \
						-p テイルズリスタート
				}

				case ( d:TALES_E:ゴルルゴン写真表示中 ) {
					eval( $w:現ステージ番号 = d:ステージ名:フィランソロピーのアジト );
					command varsave $w:現ステージ番号;

					$b:tales_story_e = d:TALES_E:ゴルルゴン写真表示後;

					//ＢＧＭ指定
					//なし

					chara タンカーカメラ写真表示 自分の写真もげら \
						-p テイルズリスタート
				}

				case ( d:TALES_E:ゴルルゴン写真表示後 ) {
					eval( $w:現ステージ番号 = d:ステージ名:フィランソロピーのアジト );
					command varsave $w:現ステージ番号;

					$b:tales_story_e = d:TALES_E:対ゴルルゴンクリア前;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定２

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｅ:E7_1_ゴルルゴン戦前] \
						-e テイルズ入れ替え＿E7_1 \
						-i 背景テクスチャプロック \
						-p mv_tales_tsp03a_e0		//	（ザコサバ　対ゴルルゴン）//	これ以降はr_vr_sを使用する
				}

	/*
					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
	//					-r [テイルズ＿Ｅ:E7_0_オルガ語り] [テイルズ＿Ｅ:E7_1_ゴルルゴン戦前] \
						-r [テイルズ＿Ｅ:E7_登場] \
						-e テイルズ入れ替え＿E7 \
	//					-p mv_tales_sp03a_e0		//	ステージ切り出しかも？（ザコサバ　対ゴルルゴン）//	これ以降はr_vr_sを使用する
						-p load_tales_e_test
	*/

				//-------------------------------------
				// 対ゴルルゴン止めた紙芝居
				case (d:TALES_E:対ゴルルゴンクリア前) {
					eval( $w:現ステージ番号 = d:ステージ名:フィランソロピーのアジト );
					command varsave $w:現ステージ番号;
					//	ストーリーは進みません

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定１

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｅ:ＶＲ止めた] \
						-e テイルズ入れ替え＿ＶＲ止めた \
						-i 背景テクスチャプロック \
						-p mv_tales_tsp03a_e0		//	（ザコサバ　対ゴルルゴン）//	これ以降はr_vr_sを使用する
				}

				//-------------------------------------
				// ゴルルゴン倒した紙芝居
				case (d:TALES_E:対ゴルルゴンクリア中) {
					eval( $w:現ステージ番号 = d:ステージ名:フィランソロピーのアジト );
					command varsave $w:現ステージ番号;

					$b:tales_story_e = d:TALES_E:スニーキング３面クリア前;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定２

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｅ:E8_ゴルルゴンクリア] \
						-e テイルズ入れ替え＿E8_ゴルルゴンクリア \
						-i 背景テクスチャプロック \
						-p mv_tales_tvs03a_e0		//	（スニーキング３面）
				}

				//-------------------------------------
				// スニーキング３面止めた紙芝居
				case (d:TALES_E:スニーキング３面クリア前) {
					eval( $w:現ステージ番号 = d:ステージ名:フィランソロピーのアジト );
					command varsave $w:現ステージ番号;

					//	ストーリーは進みません

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定１

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｅ:ＶＲ止めた] \
						-e テイルズ入れ替え＿ＶＲ止めた \
						-i 背景テクスチャプロック \
						-p mv_tales_tvs03a_e0		//	（スニーキング３面）
				}

				//-------------------------------------
				// スニーキング３面クリア紙芝居
				case (d:TALES_E:スニーキング３面クリア中) {
					eval( $w:現ステージ番号 = d:ステージ名:フィランソロピーのアジト );
					command varsave $w:現ステージ番号;

					$b:tales_story_e = d:TALES_E:ハンドガン３面クリア前;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定２

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｅ:E9_スニーキング３面クリア] \
						-e テイルズ入れ替え＿E9_スニーキング３面クリア \
						-i 背景テクスチャプロック \
						-p mv_tales_twp03a_e0		//	（ハンドガン３面）
				}

				//-------------------------------------
				// ハンドガン３面止めた紙芝居
				case (d:TALES_E:ハンドガン３面クリア前) {
					eval( $w:現ステージ番号 = d:ステージ名:フィランソロピーのアジト );
					command varsave $w:現ステージ番号;
					//	ストーリーは進みません

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定１

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｅ:ＶＲ止めた] \
						-e テイルズ入れ替え＿ＶＲ止めた \
						-i 背景テクスチャプロック \
						-p mv_tales_twp03a_e0		//	（ハンドガン３面）
				}

				//-------------------------------------
				// ハンドガン３面クリア紙芝居
				case (d:TALES_E:ハンドガン３面クリア中) {
					eval( $w:現ステージ番号 = d:ステージ名:フィランソロピーのアジト );
					command varsave $w:現ステージ番号;

					//	イマイチ
					if ($f:テイルズＥハンドガン３面クリア成績フラグ == 0) {
						//	ストーリーフラグを戻す
						$b:tales_story_e = d:TALES_E:ハンドガン３面クリア前;

						//ＢＧＭ指定
						@テイルズ紙芝居内ＢＧＭ設定２

						chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
							-r [テイルズ＿Ｅ:E10_ハンドガン３面Ａ＿成績悪かった] \
							-e テイルズ入れ替え＿E10_ハンドガン３面Ａ＿成績悪かった \
							-i 背景テクスチャプロック \
							-p mv_tales_twp03a_e0		//	（ハンドガン３面）

					//	ウマい！
					} else {
						$b:tales_story_e = d:TALES_E:スニーキング敵全滅５面クリア前;

						//ＢＧＭ指定
						@テイルズ紙芝居内ＢＧＭ設定２

						chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
							-r [テイルズ＿Ｅ:E10_ハンドガン３面Ｂ＿成績よかった] \
							-e テイルズ入れ替え＿E10_ハンドガン３面Ｂ＿成績よかった \
							-i 背景テクスチャプロック \
							-p mv_tales_tvs05a_e0		//	（スニーキング敵全滅５面）
					}
				}

				//-------------------------------------
				// スニーキング敵全滅５面止めた紙芝居
				case (d:TALES_E:スニーキング敵全滅５面クリア前) {
					eval( $w:現ステージ番号 = d:ステージ名:フィランソロピーのアジト );
					command varsave $w:現ステージ番号;
					//	ストーリーは進みません

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定１

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｅ:ＶＲ止めた] \
						-e テイルズ入れ替え＿ＶＲ止めた \
						-i 背景テクスチャプロック \
						-p mv_tales_tvs05a_e0		//	（スニーキング敵全滅５面）
				}

				//-------------------------------------
				// スニーキング敵全滅５面クリア紙芝居
				case (d:TALES_E:スニーキング敵全滅５面クリア中) {
					eval( $w:現ステージ番号 = d:ステージ名:フィランソロピーのアジト );
					command varsave $w:現ステージ番号;

						$b:tales_story_e = d:TALES_E:スニーキング８面クリア前;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定１

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｅ:E11_スニーキング敵全滅５面クリア] \
						-e テイルズ入れ替え＿E11_スニーキング敵全滅５面クリア \
						-i 背景テクスチャプロック \
						-p mv_tales_tvs08a_e0		//	（スニーキング８面）
				}

				//-------------------------------------
				// スニーキング８面止めた紙芝居
				case (d:TALES_E:スニーキング８面クリア前) {
					eval( $w:現ステージ番号 = d:ステージ名:フィランソロピーのアジト );
					command varsave $w:現ステージ番号;

					//	ストーリーは進みません

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定１

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｅ:ＶＲ止めた] \
						-e テイルズ入れ替え＿ＶＲ止めた \
						-i 背景テクスチャプロック \
						-p mv_tales_tvs08a_e0		//	（スニーキング８面）
				}

				//-------------------------------------
				// スニーキング８面クリア紙芝居
				case (d:TALES_E:スニーキング８面クリア中) {
					eval( $w:現ステージ番号 = d:ステージ名:並行宇宙の狭間 );
					command varsave $w:現ステージ番号;

					$b:tales_story_e = d:TALES_E:雷電テイルズ開始;
	//				$b:tales_story_e = d:TALES_E:雷_爆弾解体２面クリア前;
					//	コンティニューしている場合
					if ($f:テイルズＥコンティニューフラグ == 1) {
	//				if ($i:ＶＲ設定 >= 1) {
	print '#############DO_CONTINUE'


						//ＢＧＭ指定
						@テイルズ紙芝居内ＢＧＭ設定１

						chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
							-r [テイルズ＿Ｅ:E12_スニーキング８面クリアＡ] \		//	ここで「Ｅ１３−１」紙芝居もやってしまう
							-e テイルズ入れ替え＿E12_スニーキング８面クリアＡ \		//	ここで「Ｅ１３−１」紙芝居もやってしまう
							-i 背景テクスチャプロック \
							-p テイルズリスタート
					} else {
	print '#############DO_NOT_CONTINUE'

						//ＢＧＭ指定
						@テイルズ紙芝居内ＢＧＭ設定１

						chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
							-r [テイルズ＿Ｅ:E12_スニーキング８面クリアＢ] \		//	ここで「Ｅ１３−１」紙芝居もやってしまう
							-e テイルズ入れ替え＿E12_スニーキング８面クリアＢ \
							-i 背景テクスチャプロック \
							-p テイルズリスタート
					}
				}

				//-------------------------------------
				//雷電テイルズ開始 E12紙芝居で一度紙芝居を終了し、restart -sでここにくるるん
				//背景の絵もＢＧＭも変わる予定
				case (d:TALES_E:雷電テイルズ開始) {
					eval( $w:現ステージ番号 = d:ステージ名:雷電テイルズ );
					command varsave $w:現ステージ番号;

					$b:tales_story_e = d:TALES_E:雷_爆弾解体２面クリア前;

						//ＢＧＭ指定
						@テイルズ紙芝居内ＢＧＭ設定６

						chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
							-r [テイルズ＿Ｅ:E13_1_雷電テイルズ開始] \		//	ここで「Ｅ１３−１」紙芝居をする
							-e テイルズ入れ替え＿E13_1_雷電テイルズ開始 \
							-i 背景テクスチャプロック \
							-p mv_tales_ta31a_e0		//	（爆弾解体本当は１面に相当）	//	これ以降はr_vr_rを使用する
				}


				//-------------------------------------			//	ここから雷電テイルズ
				// 爆弾解体２面クリア紙芝居
				case (d:TALES_E:雷_爆弾解体２面クリア中) {
					eval( $w:現ステージ番号 = d:ステージ名:雷電テイルズ );
					command varsave $w:現ステージ番号;
					$b:tales_story_e = d:TALES_E:雷_武装解除２面クリア前;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定６

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｅ:E13_2_雷_爆弾解体２面クリア] \
						-e テイルズＥ入れ替え＿E13_2_雷_爆弾解体２面クリア \
						-i 背景テクスチャプロック \
						-p mv_tales_ta12a_e0			//	（武装解除２面）
				}

				//-------------------------------------
				// 武装解除２面クリア紙芝居
				case (d:TALES_E:雷_武装解除２面クリア中) {
					eval( $w:現ステージ番号 = d:ステージ名:雷電テイルズ );
					command varsave $w:現ステージ番号;
					$b:tales_story_e = d:TALES_E:雷_ＰＳＧ１３面クリア前;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定６

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｅ:E13_3_雷_武装解除２面クリア] \
						-e テイルズ入れ替え＿E13_3_雷_武装解除２面クリア \
						-i 背景テクスチャプロック \
						-p mv_tales_twp43a_e0			//	（ＰＳＧ１３面）
				}

				//-------------------------------------
				// ＰＳＧ１３面クリア紙芝居
				case (d:TALES_E:雷_ＰＳＧ１３面クリア中) {
					eval( $w:現ステージ番号 = d:ステージ名:雷電テイルズ );
					command varsave $w:現ステージ番号;

					$b:tales_story_e = d:TALES_E:雷_敵兵排除４面クリア前;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定６

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｅ:E13_4_雷_ＰＳＧ１３面クリア] \
						-e テイルズ入れ替え＿E13_4_雷_ＰＳＧ１３面クリア \
						-i 背景テクスチャプロック \
						-p mv_tales_ta20a_e0				//	（敵兵排除４面）
				}

				//-------------------------------------
				// 敵兵排除４面クリア紙芝居
				case (d:TALES_E:雷_敵兵排除４面クリア中) {
					eval( $w:現ステージ番号 = d:ステージ名:雷電テイルズ );
					command varsave $w:現ステージ番号;

					$b:tales_story_e = d:TALES_E:雷_スニーキング３面クリア前;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定６

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｅ:E13_5_雷_敵兵排除４面クリア] \
						-e テイルズ入れ替え＿E13_5_雷_敵兵排除４面クリア \
						-i 背景テクスチャプロック \
						-p mv_tales_tvs06a_e0			//（かぶるのでスニーキング６面に変更になりました）
				}

				//-------------------------------------//	ここからループ
				// スニーキング３面クリア紙芝居
				case (d:TALES_E:雷_スニーキング３面クリア中) {
					eval( $w:現ステージ番号 = d:ステージ名:雷電テイルズ );
					command varsave $w:現ステージ番号;

					$b:tales_story_e = d:TALES_E:雷_爆弾解体３面クリア前;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定６

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｅ:E13_6_雷_スニーキング３面クリア] \
						-e テイルズ入れ替え＿E13_6_雷_スニーキング３面クリア \
						-i 背景テクスチャプロック \
						-p mv_tales_ta01f_e0				//	（爆弾解体３面か４面）
				}

				//-------------------------------------
				// 爆弾解体３面クリア紙芝居
				case (d:TALES_E:雷_爆弾解体３面クリア中) {
					eval( $w:現ステージ番号 = d:ステージ名:雷電テイルズ );
					command varsave $w:現ステージ番号;

					$b:tales_story_e = d:TALES_E:雷_武装解除６面クリア前;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定６

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｅ:E13_7_雷_爆弾解体３面クリア] \
						-e テイルズ入れ替え＿E13_7_雷_爆弾解体３面クリア \
						-i 背景テクスチャプロック \
						-p mv_tales_ta22a_e0				//	（武装解除６面）
				}

				//-------------------------------------
				// 武装解除６面クリア紙芝居
				case (d:TALES_E:雷_武装解除６面クリア中) {
					eval( $w:現ステージ番号 = d:ステージ名:雷電テイルズ );
					command varsave $w:現ステージ番号;

					$b:tales_story_e = d:TALES_E:雷_グレネード４面クリア前;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定６

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｅ:E13_8_雷_武装解除６面クリア] \
						-e テイルズ入れ替え＿E13_8_雷_武装解除６面クリア \
						-i 背景テクスチャプロック \
						-p mv_tales_twp34a_e0				//	（グレネード４面）
				}

				//-------------------------------------
				// グレネード４面クリア紙芝居
				case (d:TALES_E:雷_グレネード４面クリア中) {
					eval( $w:現ステージ番号 = d:ステージ名:雷電テイルズ );
					command varsave $w:現ステージ番号;

					$b:tales_story_e = d:TALES_E:雷_敵兵排除９面クリア前;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定６

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｅ:E13_9_雷_グレネード４面クリア] \
						-e テイルズ入れ替え＿E13_9_雷_グレネード４面クリア \
						-i 背景テクスチャプロック \
						-p mv_tales_ta42a_e0				//	（敵兵排除９面）
				}

				//-------------------------------------
				// 敵兵排除９面クリア紙芝居
				case (d:TALES_E:雷_敵兵排除９面クリア中) {
					eval( $w:現ステージ番号 = d:ステージ名:雷電テイルズ );
					command varsave $w:現ステージ番号;

					$b:tales_story_e = d:TALES_E:ＶＲ制御奪い返し中;
					$b:テイルズＥ雷電テイルズループ回数 = $b:テイルズＥ雷電テイルズループ回数 + 1;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定６

					//紙芝居背景とＢＧＭを変えるのでリスタートで次に進みます
					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｅ:E13_10_雷_敵兵排除９面クリア] \		//	ここでＶＲ制御奪い返し紙芝居もやってしまう
						-e テイルズ入れ替え＿E13_10_雷_敵兵排除９面クリア \		//	ここでＶＲ制御奪い返し紙芝居もやってしまう
						-i 背景テクスチャプロック \
						-p 雷電テイルズ終点
				}

				//-------------------------------------
				// ＶＲ制御奪い返し紙芝居							//	ＶＲをＥＸＩＴした場合は直接ここにくる
				case (d:TALES_E:ＶＲ制御奪い返し中) {
					eval( $w:現ステージ番号 = d:ステージ名:特異点 );
					command varsave $w:現ステージ番号;

					$b:tales_story_e = d:TALES_E:対ＲＡＹクリア前;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定１

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｅ:E14_ＶＲ制御奪い返し] \
						-e テイルズ入れ替え＿E14_ＶＲ制御奪い返し \
						-i 背景テクスチャプロック \
						-p mv_tales_a46a_e0				//	対ＲＡＹ戦		//	これ以降はr_vr_sを使用する
				}

				//-------------------------------------
				// 対ＲＡＹクリア紙芝居
				case (d:TALES_E:対ＲＡＹクリア中) {
					eval( $w:現ステージ番号 = d:ステージ名:フェデラルホール );
					command varsave $w:現ステージ番号;

					$b:tales_story_e = d:TALES_E:対ソリダスクリア前;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定１

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｅ:E15_対ＲＡＹクリア] \
						-e テイルズ入れ替え＿E15_対ＲＡＹクリア \
						-i 背景テクスチャプロック \
						-p mv_tales_a61a_e0				//	対ソリダス戦
				}

				//-------------------------------------
				// エンディング紙芝居
				case (d:TALES_E:対ソリダスクリア中) {
	print 'ぶらぶらばっちゃ！'
	//				$b:tales_story_e = d:TALES_E:エンド;
					$b:tales_story_e = d:TALES_E:メカゲノラ新聞;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定２

					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｅ:E16_エンディング１] \
						-e テイルズ入れ替え＿E16_エンディング１ \
						-i 背景テクスチャプロック \
						-l 1 \
						-p テイルズリスタート //ほんとはスタッフロール→リザルト→ＳＡＶＥ→テイルズセレクトだけど
				}

				case (d:TALES_E:メカゲノラ新聞) {
					$b:tales_story_e = d:TALES_E:エンド;
					$w:現ステージ番号 = d:ステージ名:スネークテイルズＥクリア;
					$f:テイルズＥクリアしたフラグ = 1;

					//ＢＧＭ指定
					@テイルズ紙芝居内ＢＧＭ設定０
					chara 一枚絵単独表示 メカゲノラいんちき新聞 \
						-b jpnw_news_genora \
						-t 60 60 \
						-p load_tales_select //ほんとはスタッフロール→リザルト→ＳＡＶＥ→テイルズセレクトだけど

	/*
					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｅ:E16_エンディング２] \
						-i 背景テクスチャプロック \
						-l 1 \
						-p load_tales_select //ほんとはスタッフロール→リザルト→ＳＡＶＥ→テイルズセレクトだけど
	*/
				}

	/*
					chara 紙芝居 テイルズ紙芝居 -s vr_book -n 1 \
						-r [テイルズ＿Ｅ:E16_エンディング] \
						-e テイルズ入れ替え＿E16_エンディング \
						-l 1 \
						-p load_tales_select //ほんとはスタッフロール→リザルト→ＳＡＶＥ→テイルズセレクトだけど
	//					-p load_select
	*/

			}

		}	//	<-テイルズＥ終わり



		// ロード ADD M.Kobayashi 2002/06/25
		// ほんとはタイトルに入るけど仮
		case ( d:TALES_NO:LOAD ) {
	#include "loadgame.rsc"
	#include "stagename_e.h"
		command ローカルリソース設定 \
			-string \
		        ロードゲームリソース日本語 		[ロードゲームリソース日本語:*] \
	            ロードゲームリソース英語 		[ロードゲームリソース英語:*] \
	            ロードゲームリソースフランス語 	[ロードゲームリソースフランス語:*] \
	            ロードゲームリソースドイツ語 	[ロードゲームリソースドイツ語:*] \
	            ロードゲームリソーススペイン語 	[ロードゲームリソーススペイン語:*] \
	            ロードゲームリソースイタリア語 	[ロードゲームリソースイタリア語:*] \
				ステージ名 [ステージ名:*] 
		
			chara ロードゲーム画面マネージャー ロードゲーム画面起動 \
				-d save_load \
				-p ロードゲーム終了プロシージャー \
				-m d:SAVE_LOAD_MODE_SNAKE_TALES
		}
	}
}












//---------------------------------------------------------------------------
//	使用されているプロック
//---------------------------------------------------------------------------
// サウンドを読み込み
proc テイルズ紙芝居内ＢＧＭ設定０{
	chara サウンドマネージャー ＳＤマネ -pak 0
	mesg サウンドマネージャー ＳＤマネ SD_CODE d:SNG_PLAY_01
}
proc テイルズ紙芝居内ＢＧＭ設定１{
	chara サウンドマネージャー ＳＤマネ -pak 1
	mesg サウンドマネージャー ＳＤマネ SD_CODE d:SNG_PLAY_01
}
proc テイルズ紙芝居内ＢＧＭ設定２{
	chara サウンドマネージャー ＳＤマネ -pak 2
	mesg サウンドマネージャー ＳＤマネ SD_CODE d:SNG_PLAY_01
}
proc テイルズ紙芝居内ＢＧＭ設定６{
	chara サウンドマネージャー ＳＤマネ -pak 6
	mesg サウンドマネージャー ＳＤマネ SD_CODE d:SNG_PLAY_01
}


// タイトルテロップ表示
proc タイトルテロップ表示 $:p_ファイル名 {
	chara ２Ｄスプライト表示 タイトルテロップ \
		-tri tales_title -x $:p_ファイル名 \
		-pos (512/2) (384/2) \
		-count 120,163,120 \
		-alp 128 \
		-flag ( d:SPRT2D_FLAG_CENTER | d:SPRT2D_FLAG_ADD )

	command ＳＥセットＶＰ -s d:se_code:SD_S_JINGLE01 -v 0x3f -p 0x20

	$f:テイルズタイトル表示終了フラグ = 1;
	chara delay 終了ディレイ -time 228 -exec {
		restart -save
	}
}

// ロード ADD M.Kobayashi 2002/06/25
// ほんとはタイトルに入るけど仮
proc ロードゲーム終了プロシージャー $:返り値 {
	if( $:返り値 == 1 ) {
		chara delay 終了ディレイ -time 1 -exec {	// サウンドマネージャーが死ぬ前にメッセージを送るため
			command load_restart
		}
	} else {
		@load_select
	}
}





//-------------------------------------------------
//テイルズ用おまけのぷろっく
//--------------------------------------------------
proc テイルズリスタート {
	//ウェイトかけたいなー
	restart -s
}

proc 雷電テイルズ終点 {
		if($b:テイルズＥ雷電テイルズループ回数 < d:RAIDEN_TALES_LOOP){
				$b:tales_story_e = d:TALES_E:雷_スニーキング３面クリア前;
				command ミッションズデータ初期化
				@mv_tales_tvs06a_e0
//				$b:tales_story_e = d:TALES_E:雷_敵兵排除９面クリア前;
//				@mv_tales_ta42a_e0

		}else{
			restart -s;
	}
}

proc 背景テクスチャプロック  $:no $:res_num{
print 'ぶりぶりょむっちょ'
	if( $b:tales_story_no == d:TALES_NO:A ){
print 'ごんぬずばー'
		return a_bg;
	} else if( $b:tales_story_no == d:TALES_NO:B ){
		return b_bg
	} else if( $b:tales_story_no == d:TALES_NO:C ){
		return c_bg
	} else if( $b:tales_story_no == d:TALES_NO:D ){
		return d_bg
	} else if( $b:tales_story_no == d:TALES_NO:E ){
		if( (d:TALES_E:雷_爆弾解体２面クリア前 <= $b:tales_story_e) && \
				($b:tales_story_e < d:TALES_E:対ＲＡＹクリア前) ){
				return r_bg;
		}else{
			return e_bg
		}
	}
}



