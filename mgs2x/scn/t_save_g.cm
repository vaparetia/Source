//●ＳＡＶＥメニューが出る前 d//e
//・普通 h//e
resource TO_ＳＡＶＥ前普通１__g{
オタコン_000: {
Willst Du speichern, Snake?
}
//	<<<ENGLISH>>>
//	Do you want to save, Snake?

/*＃｛記録、セーブ｝＃するかい、スネーク？*/
}//d

resource TO_ＳＡＶＥ前普通２__g{
オタコン_000: {
Zeit zum Speichern?
}
//	<<<ENGLISH>>>
//	Time to save?

/*＃｛記録、セーブ｝＃だね？*/
}//d

resource TO_ＳＡＶＥ前普通３__g {
オタコン_000: {
Du mu&~st speichern? Einen Moment!
}
//	<<<ENGLISH>>>
//	Oh, you need to save. Just a second.

/*ああ、＃｛記録、セーブ｝＃だね？すぐ準備する。*/
}//d

resource TO_ＳＡＶＥ前普通４__g {
オタコン_000: {
Willst Du speichern, Snake?
}
//	<<<ENGLISH>>>
//	Oh, Snake, you want to save?

/*スネーク、＃｛記録、セーブ｝＃したいのかい？*/
}//d


//・緊迫状態 h//e
resource TO_ＳＡＶＥ前緊迫１__g {
オタコン_000: {
Mu&~st Du nicht speichern, Snake?
}
//	<<<ENGLISH(2)>>>
//	Need to save, right, Snake?

/*＃｛記録、セーブ｝＃だね、スネーク？*/
}//d

resource TO_ＳＡＶＥ前緊迫２__g {
オタコン_000: {
Alles klar, Snake? Ich bin zum Speichern
bereit, sag nur wann.
}
//	<<<ENGLISH>>>
//	You all right, Snake?
//	I'm ready to save whenever you are.

/*大丈夫かい、スネーク？
＃｛記録、セーブ｝＃の準備なら出来てるよ？
*/
}//d

resource TO_ＳＡＶＥ前緊迫３__g {
オタコン_000: {
Snake! Sei froh, ich kann schnell
speichern, wenn's sein mu&~s!
}
//	<<<ENGLISH>>>
//	Snake! Thank God!
//	I can do a quick save if you need.

/*スネーク！無事かい？
＃｛記録、セーブ｝＃ならすぐ出来るよ
*/
}//d

resource TO_ＳＡＶＥ前緊迫４__g {
オタコン_000: {
Snake! Mu&~st Du speichern?
}
//	<<<ENGLISH>>>
//	Snake! Do you need to save?

/*スネーク！＃｛記録、セーブ｝＃かい？*/
}//d




//記録するメニューを選ばなかった場合  h//e
//普通 //e
resource TO_未セーブ終了普通１__g {
//ns
オタコン_000: {
Ok, bis bald, Snake.
}
//	<<<ENGLISH>>>
//	OK, see you, Snake.

/*じゃあね、スネーク。*/
}//d

resource TO_未セーブ終了普通２__g {
//ns
オタコン_000: {
Bleib' dran!
}
//	<<<ENGLISH(2)>>>
//	Hang in there.

/*がんばってくれよ*/
}//d

resource TO_未セーブ終了普通３__g {
//ns
オタコン_000: {
So, Du willst nicht speichern? Na gut, sag
Bescheid, wenn Du es mu&~st.
}
//	<<<ENGLISH>>>
//	Oh, you're not going to save?
//	Well, okay, just let me know
//	when you need to.

/*なんだ、＃｛記録、セーブ｝＃しないのかい？
ま、いいや。＃｛記録、セーブ｝＃したくなったら、
また連絡してくれ。
*/
}//d

resource TO_未セーブ終了普通４__g {
//ns
オタコン_000: {
Ok, Snake. Bleib' sauber.
}
//	<<<ENGLISH>>>
//	OK, Snake. Stay out of trouble.

/*ＯＫ。スネーク、気をつけて。*/
}//d

resource TO_未セーブ終了普通５__g {
//ns
オタコン_000: {
Snake, Du wei&~st doch,
diese Frequenz ist nur
zum Speichern.
}
//	<<<ENGLISH(2)>>>
//	Look, Snake, this frequency is
//	for saving only. Remember?

/*スネーク、これは＃｛記録、セーブ｝＃専用の
回線なんだけど……。
*/
}//d


//・緊迫 //e
resource TO_未セーブ終了緊迫１__g {
//ns
オタコン_000: {
Bleib' dran, Snake!
}
//	<<<ENGLISH>>>
//	Hang in there, Snake!

/*頑張ってくれよ、スネーク！*/
}//d

resource TO_未セーブ終了緊迫２__g {
//ns
オタコン_000: {
Sag's mir sofort, wenn Du speichern mu&~st,
ok? La&~s' Dich nicht erwischen!
}
//	<<<ENGLISH>>>
//	Let me know as soon as you
//	need to save, okay? Don't let
//	them get you!

/*＃｛記録、セーブ｝＃が必要になったらすぐ
連絡してくれ。負けるなよ！
*/
}//d

resource TO_未セーブ終了緊迫３__g {
//ns
オタコン_000: {
Gib' niemals auf!
}
//	<<<ENGLISH(2)>>>
//	Don't give up!

/*あきらめないでくれよ！*/
}//d

resource TO_未セーブ終了緊迫４__g {
//ns
オタコン_000: {
Snake, Du mu&~st einfach &~uberleben!
}
//	<<<ENGLISH>>>
//	Snake!
//	You've got to stay alive!

/*勝つんだ、スネーク！*/
}//d


//・汎用無言 //e
resource TO_無言__g {
//ns
オタコン_000: 
''
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
}//d


//●ＳＡＶＥ失敗  h//e
//・メモリーカードがない h //e
resource TO_ＳＡＶＥ失敗メモリーカードない__g {
//ns
オタコン_000: {
He, da ist keine MEMORY CARD
(PS2) im MEMORY CARD-Steckplatz.
}
//	<<<ENGLISH>>>
//	Hey, there's no MEMORY CARD
//	(PlayStation&@R2) in the MEMORY
//	CARD slot.

/*あ、＃｛ＭＥＭＯＲＹ、メモリー｝＃ ＃｛ＣＡＲＤ、カード｝＃差込口に
＃｛"PlaySation2"、ピーエスツー｝＃専用メモリーカードが
ささってないよ。
*/

オタコン_001: {
Man kann nur mit einer eigenen
MEMORY CARD (PS2) speichern.
}
//	<<<ENGLISH>>>
//	Saving can't be done unless you have
//	a MEMORY CARD (PlayStation&@R2)
//	ready.

/*＃｛記録、セーブ｝＃するには＃｛"PlaySation2"、ピーエスツー｝＃専用
メモリーカードが必要なんだ。
*/

オタコン_002: {
Du mu&~st die MEMORY CARD (PS2)
in den MEMORY CARD-Steckplatz
einsetzen.
}
//	<<<ENGLISH>>>
//	You need to set the MEMORY CARD
//	(PlayStation&@R2) in the MEMORY CARD
//	slot.

/*＃｛ＭＥＭＯＲＹ、メモリー｝＃ ＃｛ＣＡＲＤ、カード｝＃差込口に
＃｛"PlaySation2"、ピーエスツー｝＃専用メモリーカードを
セットしてくれ。
*/
}//d


//・空き領域がない h //e
resource TO_ＳＡＶＥ失敗空領域ない__g {
//ns
オタコン_000: {
Oh nein, Snake, es war nicht genug
Speicherplatz auf Deiner MEMORY CARD
(PS2), um den Spielstand zu
speichern.
}
//	<<<ENGLISH>>>
//	Oh no. Snake, there wasn't enough
//	space left on the MEMORY CARD
//	(PlayStation&@R2) to save the game.

/*うーん。スネーク、＃｛"PlaySation2"、ピーエスツー｝＃専用
メモリーカードに空き領域がなくて
＃｛記録、セーブ｝＃出来なかったよ。
*/

}//d


//・フォーマットしようとしない  h //e
resource TO_ＳＡＶＥ失敗フォーマットしようとしない__g {
//ns
オタコン_000: {
Tschuldige, Du mu&~st erst formatieren,
wenn Du speichern willst?
}
//	<<<ENGLISH>>>
//	'Scuse me but -- you can't save
//	unless you format, you know.

/*あのー、フォーマットしないと＃｛記録、セーブ｝＃は
出来ないんだけど、わかってる？
*/

}//d


//・その他エラー  h //e
resource TO_ＳＡＶＥ失敗その他エラー__g {
//ns
オタコン_000: {
Tut mir leid, Snake. Es gab 'nen Fehler,
ich konnte nicht speichern.
}
//	<<<ENGLISH>>>
//	I'm really sorry, Snake.
//	There was an error and
//	I couldn't save.

/*スネーク、ごめん。エラーが起きて
＃｛記録、セーブ｝＃できなかった。
*/

}//d


//●ＳＡＶＥ失敗緊迫  h//e
//・メモリーカードがない緊迫 h //e
resource TO_ＳＡＶＥ失敗メモリーカードない緊迫__g {
//ns
オタコン_000: {
Es ist keine MEMORY CARD (PS2)
im MEMORY CARD-Steckplatz!
}
//	<<<ENGLISH(2)>>>
//	There's no MEMORY CARD
//	(PlayStation&@R2) in the MEMORY
//	CARD slot!

/*あ、＃｛ＭＥＭＯＲＹ、メモリー｝＃ ＃｛ＣＡＲＤ、カード｝＃差込口に
＃｛"PlaySation2"、ピーエスツー｝＃専用メモリーカードが
ささってない！
*/

オタコン_001: {
Ich kann erst speichern, wenn Du
eine MEMORY CARD (PS2) hast!
}
//	<<<ENGLISH>>>
//	I can't save unless you have a
//	MEMORY CARD (PlayStation&@R2)
//	ready!

/*＃｛記録、セーブ｝＃するには＃｛"PlaySation2"、ピーエスツー｝＃専用
メモリーカードが必要なんだ！
*/

オタコン_002: {
Setze die MEMORY CARD (PS2) jetzt
in den MEMORY CARD-Steckplatz ein!
}
//	<<<ENGLISH(2)>>>
//	Set the MEMORY CARD
//	(PlayStation&@R2) in the
//	MEMORY CARD slot now!

/*＃｛ＭＥＭＯＲＹ、メモリー｝＃ ＃｛ＣＡＲＤ、カード｝＃差込口に
＃｛"PlaySation2"、ピーエスツー｝＃専用メモリーカードを
セットしてくれ！
*/
}//d


//・空き領域がない緊迫 h //e
resource TO_ＳＡＶＥ失敗空領域ない緊迫__g {
//ns
オタコン_000: {
Snake, da war nicht genug Speicherplatz
auf der MEMORY CARD (PS2)!
}
//	<<<ENGLISH>>>
//	Snake, there wasn't enough
//	space left on the MEMORY CARD
//	(PlayStation&@R2)!
//<ページ数変更>
オタコン_000_1: {
Konnte Spielstand nicht speichern!
}
//	<<<ENGLISH>>>
//	I couldn't save the game!

/*うーん。スネーク、＃｛"PlaySation2"、ピーエスツー｝＃専用
メモリーカードに空き領域がなくて
＃｛記録、セーブ｝＃出来なかった！
*/

}//d


//・フォーマットしようとしない緊迫  h //e
resource TO_ＳＡＶＥ失敗フォーマットしようとしない緊迫__g {
//ns
オタコン_000: {
Ich kann erst speichern, wenn Du die
MEMORY CARD (PS2) formatiert
hast!
}
//	<<<ENGLISH>>>
//	Look, there's no way to save
//	unless you format the MEMORY
//	CARD (PlayStation&@R2)!

/*フォーマットしないと＃｛記録、セーブ｝＃は
出来ないんだ！
*/

}//d


//・その他エラー  h //e
resource TO_ＳＡＶＥ失敗その他エラー緊迫__g {
//ns
オタコン_000: {
Snake, es gab `nen Fehler und ich konnte
nicht speichern!
}
//	<<<ENGLISH>>>
//	Snake, there was an error
//	and I couldn't save!

/*スネーク、エラーが起きて＃｛記録、セーブ｝＃
できなかった。
*/

}//d


//ＳＡＶＥ後会話 偽コトワザ  h//e
//・初めてのＳＡＶＥ後 h //e
resource TO_ＳＡＶＥ後初めて__g {
//ns
オタコン_000: {
Snake, Du kennst doch den Spruch 'Einer
f&~ur alle, alle f&~ur einen'.
}
//	<<<ENGLISH>>>
//	Snake, you of course know the
//	saying "One for all, all for one."

/*スネーク、『＃｛匹夫、ヒキオの＃｛勇、ゆう｝＃、一人に
敵するものなり』ってコトワザが
あるんだけど……。
*/

スネーク_001: {
Was soll das schon wieder?
}
//	<<<ENGLISH>>>
//	What is this, all of a sudden?

/*どうしたんだ、突然？*/

オタコン_002: {
Ich wei&~s, da&~s Du Motivation brauchst;
darum hab' ich mich ger&~ustet.
}
//	<<<ENGLISH>>>
//	Oh, I figured you'd need a lot of
//	motivation, so I came prepared.

/*いや、なんとなく寂しいだろうと
思って、準備してきたんだよ。
*/

オタコン_003: {
Das ist aus 'Die drei Musketiere' - dem
Roman von Dumas.
}
//	<<<ENGLISH>>>
//	It's from 'The Three Musketeers'
//	-- the book, not the candy bar.

/*ヒキオってのは中国の英雄だ。多分。
*/

オタコン_004: {
Jedenfalls bedeutet es, wenn Du alleine
alle angreifst, werden sie zusammen gegen
Dich vorgehen. Glaube ich.
}
//	<<<ENGLISH>>>
//	Anyway, it means that if you go
//	up against everyone by yourself,
//	they'll gang up on you too. I think. 

/*ま、どんなに強くっても一度に
相手出来るのは一人がせいぜいって
ことだね。
*/
/*要するに大勢を一度に敵に回しちゃ
勝ち目がないって意味だ
*/

オタコン_005: {
Da Du auf dem Schiff auf Dich allein
gestellt bist, nimm' Dir dies zu Herzen
und vermeide unn&~otigen &~Arger.
}
//	<<<ENGLISH>>>
//	Since you're on your own on that
//	ship, you need to take this to heart
//	and avoid confrontations.

/*スネークは一人で潜入してるんだから、
多数の敵をまともに相手しちゃダメだ。
見つからないようにね。
*/

//<ページ数変更>
/* 包含
オタコン_006: {
スネークは一人で潜入してるんだから、
多数の敵をまともに相手しちゃダメだ。
見つからないようにね。
}
*/

オタコン_007: {
Na, wie war das?
Fast wie fr&~uher, oder?
}
//	<<<ENGLISH>>>
//	How was that? Just
//	like the old days, huh?

/*っと、こんな感じ。
どうだい、懐かしいだろう？
*/

スネーク_008: {
Erinnert mich an Mei Ling, aber
glaubst Du wirklich, da&~s das
so stimmt?
}
//	<<<ENGLISH>>>
//	Almost reminds me of Mei Ling,
//	but... You sure you got it right?

/*懐かしいことは懐かしいが……。
何か違わないか？
*/

オタコン_009: {
Na klar! Und ich werde Dir noch viele
andere Weisheiten nahebringen, verla&~s'
Dich drauf!
}
//	<<<ENGLISH>>>
//	Of course! And I'll teach you
//	a lot more of these, you can
//	count on it.

/*そんなことはないよ！これからも色々な
コトワザを教えてあげるからね。
*/

スネーク_010: {
Na toll.
}
//	<<<ENGLISH>>>
//	Great...

/*うぅむ……。*/

}//d


//・ＳＡＶＥ後会話 h //e
resource TO_ＳＡＶＥ後序盤１__g {
//ns
オタコン_000: {
Also. Es gibt ein Sprichwort:
}
//	<<<ENGLISH>>>
//	Okay...
//	There's a saying that goes＃−
//<ページ数変更>
オタコン_000_1: {
'Selbst der Vogel in den H&~onen stirbt an
Uners&~attlichkeit, genau wie der Fisch in der
Tiefe'.
}
//	<<<ENGLISH>>>
//	"Even a bird on high dies
//	a glutton's death, as do
//	the fish of The Deeps."

/*ええと『＃｛高飛、こうひ｝＃の＃｛鳥、とり｝＃も＃｛美食、びしょく｝＃に死す。
＃｛深泉、しんせん｝＃の＃｛魚、うお｝＃も＃｛芳餌、ほうじ｝＃に死す』って
コトワザ知ってるかい？。
*/

オタコン_001: {
Soll hei&~sen - &~ah, sei nicht gierig.
}
//	<<<ENGLISH>>>
//	The lesson is -- er,
//	don't be greedy.

/*意味は……欲をかき過ぎるなって
ことだ。
*/

オタコン_002: {
Der Fisch, der der Familie Tief geh&~orte,
starb an &~Uberf&~utterung,
}
//	<<<ENGLISH>>>
//	The fish that belonged to a
//	family called the Deeps died
//	from overfeeding,
//<ページ数変更>
オタコン_002_1: {
wie der Vogel, der von etwas high wurde -
vermutlich gegorenes Obst.
}
//	<<<ENGLISH>>>
//	and so did a bird that got high on
//	something -- probably fermented
//	fruit.

/*高飛という所に住んでいた鳥は
食べ過ぎて死んじゃったし、深泉地方の
魚も食べ過ぎて死んだ、と。
*/

スネーク_003: {
nun gut, wenn Du's sagst.
}
//	<<<ENGLISH>>>
//	...okay. If you say so.

/*……そうなのか？*/

オタコン_004: {
Ja, Snake. Geh' keine unn&~otigen Risiken
ein, nur weil Du scharf auf mehr Objekte
bist.
}
//	<<<ENGLISH>>>
//	I do, Snake. Don't take unnecessary
//	risks just because you're greedy
//	for more Items.
//<ページ数変更>
オタコン_004_1: {
Denke an den Fisch der Tiefs.
}
//	<<<ENGLISH>>>
//	Remember the Deep family's fish.

/*そうさ。スネークもアイテムを取ろうと
欲張ってケガしちゃダメだよ。
*/

スネーク_005: 
''
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
}//d


resource TO_ＳＡＶＥ後序盤２__g {
//ns
オタコン_000: {
Noch ein chinesisches Sprichwort: 
}
//	<<<ENGLISH>>>
//	Another Chinese proverb:
//<ページ数変更>
オタコン_000_1: {
'Die, die den Himmel respektieren,
gedeihen; die, die ihm trotzen,
sind nicht mehr.' Kennst Du das?
}
//	<<<ENGLISH>>>
//	"Those who look to the Heavens
//	prosper, those who defy it are no
//	more." Do you know this one?

/*中国には『天に＃｛順、したが｝＃う者は＃「存、そん｝＃し、天に
逆らう者は亡ぶ』っていうコトワザが
あるんだ。知ってる？
*/

オタコン_001: {
Das bedeutet,
}
//	<<<ENGLISH>>>
//	The meaning here is
//	-- hold on a sec --
//<ページ数変更>
オタコン_001_1: {
da&~s Du nur &~uberleben kannst, solange Du
Dich in die nat&~urliche Ordnung einf&~ugst.
}
//	<<<ENGLISH>>>
//	that you can only survive as
//	long as you're a part of the
//	natural order of things.

/*意味は、うーんと……自然の道理に
従っている者は存在出来るけど、逆らう
者は滅亡してしまう、ってことだ。
*/

オタコン_002: {
Erinnerst Du dich an stonewashed jeans?
}
//	<<<ENGLISH>>>
//	You remember pre-ripped jeans?


/*テンっていうのはイタチ科の動物だ。
イタチによく似てるけど少し大型で、
足が短い。
*/

オタコン_003: {
Die Hersteller dachten, weil die Leute alte,
abgetragene Jeans liebten,
}
//	<<<ENGLISH>>>
//	Manufacturers thought that
//	just because people loved
//	old, broken-in jeans,

/*とても素早くて木登りもうまいんだ。
主に小型の哺乳類や小鳥なんかを
食べる。
*/

オタコン_004: {
w&~urden sie neue Jeans kaufen, die alt
aussahen. So hat man absichtlich -
}
//	<<<ENGLISH>>>
//	they would want to buy new
//	jeans that looked old. So they
//	purposefully --

/*毛皮はとても珍重されていて……。
*/

スネーク_005: {
Was haben Jeans mit Natur und Ordnung
zu tun?
}
//	<<<ENGLISH>>>
//	What do jeans have to do
//	with nature and order?

/*テンと自然の道理に関係があるのか？
*/

オタコン_006: {
Denim sollte auf nat&~urliche Weise
ausfransen und rei&~sen. Oder?
}
//	<<<ENGLISH>>>
//	Denim should fray and rip on
//	its own, naturally. Right?
//<ページ数変更>
オタコン_006_1: {
Einige Designer glaubten es besser zu
wissen, und - keiner kaufte!
}
//	<<<ENGLISH>>>
//	Some designers tried to go against
//	that, and  -- no one bought them!
//<ページ数変更>
オタコン_006_2: {
Der Umsatzbericht des Gesch&~aftsjahrs ist
Beweis daf&~ur.
}
//	<<<ENGLISH>>>
//	The earnings report from that
//	fiscal year is enough of a proof!

/*うーん。それだけテンは恐れ
敬われてたってことだ。
*/

スネーク_007: {
Umsatz?
}
//	<<<ENGLISH>>>
//	Earnings...?

/*テンが、か……？*/

/* 英語はここまで
オタコン_008: {
そうだよ。多分。
}
スネーク_009: {
……。
}
*/

}//d


resource TO_ＳＡＶＥ後序盤３__g {
//ns
オタコン_000: {
He, Snake, was bedeutet 'M&~uhsam
gewonnen, im Nu zeronnen?'
}
//	<<<ENGLISH>>>
//	Hey, Snake, what's "Hardest
//	won, most easily lost"?

/*いいかい、スネーク。中国では
『得難くして失い＃｛易、やす｝＃き者は、時なり』
って言うことがあるんだ。
*/

オタコン_001: {
Es ist die Zeit - he, verstanden? Toll, wie
aktuell diese chinesischen Sprichw&~orter
noch sind!
}
//	<<<ENGLISH>>>
//	It's time, get it? Amazing
//	how relevant these Chinese
//	proverbs still are!
//<ページ数変更>
オタコン_001_1: {
Vorbei ist vorbei.
}
//	<<<ENGLISH>>>
//	Once the moment's
//	gone, it's gone.

/*意味は……時間は大切にってことだ。
*/

オタコン_002: {
Mit Ausnahme der Sommerzeit nat&~urlich.
}
//	<<<ENGLISH>>>
//	Except for daylight savings
//	time, of course.
//<ページ数変更>
オタコン_002_1: {
Mit der zus&~atzlichen Stunde kann man in
jedem Herbst machen, was man will. Toll.
}
//	<<<ENGLISH>>>
//	That extra hour to do anything
//	you like with every autumn...
//	gotta love it.

/*トキは学名ニッポニア・ニッポン。
絶滅の危機に瀕してる日本の
天然記念物だよ。
*/

オタコン_003: {
Aber man verliert die Stunde im Fr&~uhling
wieder; ich denke, die Sprichw&~orter treffen
zu.
}
//	<<<ENGLISH>>>
//	Then again, you lose an hour every
//	spring, so I guess the proverbs are
//	right.
//<ページ数変更>
オタコン_003_1: {
Die haben an alles gedacht.
}
//	<<<ENGLISH>>>
//	Wow, they thought of everything.

/*全長は約７５センチ。トキ色を帯びた
白色の羽をしてて、顔も脚も赤い。
でも繁殖期には羽の色が濃い灰色に……。
*/

スネーク_004: {
Hatten die damals auch schon
Sommerzeit?
}
//	<<<ENGLISH>>>
//	Did they even have daylight
//	savings back then? 

/*なぜ日本のトキが中国のコトワザに
出てくるんだ？
*/

オタコン_005: {
Nat&~urlich nicht! Die wussten, wie man Zeit
spart. Wir sind diejenigen, die damit
get&~auscht werden.
}
//	<<<ENGLISH>>>
//	Of course not! They knew how
//	to save time. We're the ones
//	that need to be tricked into it.

/*自然の貴さに国境はないよ！
*/

スネーク_006: {
Aber Du sagtest --
}
//	<<<ENGLISH>>>
//	But you said --

/*いや、それはそうかもしれないが……。*/

オタコン_007: {
Der Moment kehrt nie zur&~uck, Snake.
Verschwenden wir ihn nicht!
}
//	<<<ENGLISH>>>
//	The moment never returns,
//	Snake. Let's not waste it on
//	idle questions.

/*失われた自然は決して戻らないから
大切にしようってことだよ。多分。
*/

スネーク_008: {
Klar?
}
//	<<<ENGLISH(2)>>>
//	Okay...?

/*……？*/
}//d


resource TO_ＳＡＶＥ後序盤４__g {
//ns
オタコン_000: {
Die Chinesen sagen:
}
//	<<<ENGLISH>>>
//	The Chinese have a saying:
//<ページ数変更>
オタコン_000_1: {
Die, die verschollen sind, fragen nie nach
dem Weg, und ein Ertrinkender zweifelt
nicht an einer Untiefe.
}
//	<<<ENGLISH>>>
//	"Those who are lost never question
//	a path, and a drowning man doubts
//	not the shallows."

/*中国では『迷う者は＃｛路、みち｝＃を問わず、
溺るる者は＃｛遂、あさせ｝＃を問わず』って言うんだ。
*/

オタコン_001: {
Das hei&~st - bedeutet, da&~s Du die Hilfe
anderer annehmen mu&~st. Sonst k&~onntest
Du in Schwierigkeiten geraten.
}
//	<<<ENGLISH>>>
//	And it means -- means that you need
//	to make use of other people's help.
//	Otherwise, you could be in trouble.

/*意味は……ええと、他人に意見を
求めないと失敗するってことだ。
*/

オタコン_002: {
Wenn Du Dich verirrt hast, wei&~st Du nicht,
ob der Weg, auf den Du triffst, der richtige
ist.
}
//	<<<ENGLISH>>>
//	If you're lost, you don't even know
//	whether a road you come across is
//	a right one, and, uh,
//<ページ数変更>
オタコン_002_1: {
Und, &~ah, wo ist der Unterschied zwischen
flach und tief, wenn Du bereits ertrunken
bist, klar?
}
//	<<<ENGLISH>>>
//	what's the difference between
//	shallow and deep if you've already
//	drowned... right?

/*道に迷っちゃう人はどんな道でも
迷うし、溺れちゃう人はどんな浅瀬でも
溺れちゃうから……。
*/

オタコン_003: {
Jedenfalls - Fakt ist, es ist immer gut, Hilfe
anzunehmen. Deshalb nutze immer das
Codec.
}
//	<<<ENGLISH>>>
//	Anyway, the point is that help is
//	always a good thing to accept.
//	So make good use of the Codec.

/*まあ人の助けを借りるべきだってこと
じゃないかな、多分。無線は有効に
使ってくれよ。
*/

スネーク_004: {
Hm - bei Mei Ling h&~orte sich das fr&~uher
immer ganz anders an.
}
//	<<<ENGLISH>>>
//	Look -- this stuff seems nothing
//	like what Mei Ling used to talk
//	about.

/*なあ、メイ・リンから聞いたこととは
違うような気がするんだが……。
*/

オタコン_005: {
He, sie k&~onnte es selbst nicht besser!
}
//	<<<ENGLISH>>>
//	Hey, she couldn't do
//	better herself!

/*そんなことないよ！
*/

スネーク_006: 
''
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
}//d


resource TO_ＳＡＶＥ後序盤５__g {
//ns
オタコン_000: {
'Bekannte stimmen zu. Freunde streiten.'
}
//	<<<ENGLISH>>>
//	"Acquaintances agree.
//	Friends argue."


/*『泣いて馬食を切る』
*/

オタコン_001: {
Das ist sehr einfach.
}
//	<<<ENGLISH>>>
//	That's a straightforward one.
//<ページ数変更>
オタコン_001_1: {
Je tiefer die Freundschaft, desto ehrlicher
kann man streiten.
}
//	<<<ENGLISH>>>
//	The better friends you are,
//	the more openly you can
//	disagree with each other.

/*意味はええと、仲の良い相手でも
規律のためには処分しなきゃいけない
ってことだ。
*/

オタコン_002: {
Also, gib' mir Kontra, wenn Du nicht
meiner Meinung bist. Fang' an zu
diskutieren!
}
//	<<<ENGLISH>>>
//	So feel free to present a
//	counterpoint if you don't agree
//	with what I'm saying. Argue away!

/*だから……まあ、きっと馬の肉を食べる
のは禁止になってたんだろうね。
*/

スネーク_003: {
Sicher. Alles klar.
}
//	<<<ENGLISH>>>
//	Sure. All right.

/*馬の肉が？*/

オタコン_004: {
Kein sehr guter Start. Ok, vergi&~s', was ich
sagte - befolge einfach meinen Rat.
}
//	<<<ENGLISH>>>
//	...Not a promising start. OK,
//	forget what I said -- just go
//	along with my advice.

/*そうさ。いくら友達でも作戦は作戦だ。
スネークも僕の指示は守ってくれよ。
*/
}//d


resource TO_ＳＡＶＥ後序盤６__g {
//ns
オタコン_000: {
Kennst Du die Redensart: 'Man vergi&~st den
Schmerz, sobald die Wunde verheilt ist'?
}
//	<<<ENGLISH(2)>>>
//	Do you know the saying
//	"One forgets the hurt once
//	the wound has healed"?

/*『傷口が癒えると痛みを忘れる』
ってコトワザ知ってるかい？
*/

オタコン_001: {
Und das bedeutet nat&~urlich - &~ah -
}
//	<<<ENGLISH>>>
//	And that of course means
//	-- uh --
//<ページ数変更>
オタコン_001_1: {
wo hab' ich denn meine Unterlagen - ?
}
//	<<<ENGLISH>>>
//	where'd I put that
//	piece of paper --

/*意味は……ええと……あれ？
メモがどっかに……。
*/

スネーク_002: {
Hast Du was gesagt?
}
//	<<<ENGLISH>>>
//	Did you say something?

/*何か言ったか？*/

オタコン_003: {
N&~o, nichts. So, &~ah, den Schmerz
vergessen, wenn die Wunde verheilt
ist, bedeutet. &~Ah - 
}
//	<<<ENGLISH>>>
//	No, nothing. So, uh, forgetting
//	the pain when the wound's healed
//	means... Um --

/*いや、なんでもない。傷は治れば
もう痛くない、と、いうことは……。
うーん。
*/

オタコン_004: {
Da&~s Du schnell gesund werden mu&~st!
Deck' Dich mit Proviant und Verb&~anden
ein.
}
//	<<<ENGLISH>>>
//	That you have to get better fast!
//	Yeah, that's it. So stock up on
//	those rations and bandages.

/*ケガは早く治そうって意味だろうね。
レーションや止血剤は大切に
してくれよ。
*/

スネーク_005: {
Ist das wirklich alles, was es bedeutet?
}
//	<<<ENGLISH>>>
//	Is that really all it means?

/*本当にそんな意味なのか？*/

オタコン_006: {
He, ich bin hier der Experte!
}
//	<<<ENGLISH>>>
//	Hey, I'm the expert here.

/*もちろんさ！*/
}//d


resource TO_ＳＡＶＥ後序盤７__g {
//ns
オタコン_000: {
Snake, kennst Du das? 'Das B&~ose liegt in
der Natur des Menschen, denn er besteht
nur aus Falschheit.'
}
//	<<<ENGLISH>>>
//	Snake, have you heard this one?
//	"Evil is human nature, and his
//	entire being, falseness."

/*スネーク、聞いたことあるかい？
『人の＃｛性、せい｝＃は悪、その全なるものは偽なり』
*/

オタコン_001: {
Die sogenannte Erbs&~unde.
}
//	<<<ENGLISH>>>
//	The concept of so-called
//	Original Sin.
//<ページ数変更>
オタコン_001_1: {
Die Idee, d&~ose geboren zu werden und
nicht anders zu k&~onnen, all schlimme
Dinge zu tun.
}
//	<<<ENGLISH>>>
//	The idea that you're born bad, so
//	you can't help doing bad things...

/*いわゆる性悪説だね。人間の本性は
悪だから悪いことしても仕方ないって
言う……。
*/

スネーク_002: {
Mal halblang. Ich dachte, die Dogmatik der
Erbs&~unde ist, da&~s man sehr hart arbeiten
mu&~s,
}
//	<<<ENGLISH>>>
//	Hold on. I thought the idea of
//	Original Sin was that you had
//	to work even harder
//<ページ数変更>
スネーク_002_1: {
um ein guter Mensch zu werden, weil man
b&~ose geboren wurde!
}
//	<<<ENGLISH>>>
//	at being good because
//	you were born evil!

/*待て。性悪説というのは、人間の本性は
悪だからこそ学問や礼儀を修めなければ
いけないという考え方じゃなかったか？
*/

オタコン_003: {
&~Ah - oh, ja, das auch. Sehr gut, Snake.
}
//	<<<ENGLISH>>>
//	Er -- oh yeah, that too.
//	Very good, Snake.

/*え？ま、まあ、そうとも言うね。
*/

スネーク_004: 
''
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
}//d


resource TO_ＳＡＶＥ後序盤８__g {
//ns
オタコン_000: {
Du kennst die Geschichte von Achilles und
Paris?
}
//	<<<ENGLISH>>>
//	You know the story about
//	Achilles and Paris?

/*『＃｛好死、こうし｝＃は＃｛悪活、あっかつ｝＃に＃｛如、し｝＃かず』ってコトワザ聞いたことあるかい？
*/

オタコン_001: {
Die Moral ist hier - &~ah - hat was mit seiner
Ferse zu tun?
}
//	<<<ENGLISH>>>
//	The moral here is -- er --
//	something about his heel?

/*意味は……うーん……。
*/

オタコン_002: {
Jedenfalls, sogar der gro&~se und nahezu
unsterbliche Held Achilles wurde am Ende
von Paris get&~otet.
}
//	<<<ENGLISH>>>
//	Anyway, even the great and
//	virtually immortal hero Achilles
//	was finally done in by Paris.
//<ページ数変更>
オタコン_002_1: {
Was f&~ur eine gef&~ahrliche Stadt!
}
//	<<<ENGLISH>>>
//	Talk about a dangerous city.

/*あの偉大な孔子もアッカツには
及ばない。つまり上には上がいる
ってことだ。
*/

オタコン_003: {
Sei nicht so selbstgerecht. Das Blatt kann
sich noch gegen Dich wenden.
}
//	<<<ENGLISH>>>
//	So don't get complacent.
//	The mission can turn around
//	and get you.

/*ゲームに馴れても過信しちゃ
いけないよ。いいね。
*/

スネーク_004: {
War Paris nicht eine Person?
}
//	<<<ENGLISH>>>
//	Wasn't Paris a person?

/*……アッカツとは誰だ？*/

オタコン_005: {
Was?
}
//	<<<ENGLISH(2)>>>
//	What?

/*なんだって！？*/

スネーク_006: {
Paris. Ich dachte, er war ein - 
}
//	<<<ENGLISH>>>
//	Paris. I thought he was a --

/*アッカツとは……？*/

オタコン_007: {
Snake, wir haben sp&~ater Zeit f&~ur
Verschw&~orungstheorien.
}
//	<<<ENGLISH>>>
//	Snake, there's a time and place
//	for conspiracy theories.
//<ページ数変更>
オタコン_007_1: {
Bitte, ich mu&~s mich konzentrieren.
}
//	<<<ENGLISH>>>
//	Please, I'm trying to
//	concentrate here.

/*スネーク……。つまんないこと
聞かないでくれよ。興ざめだ。全く！
*/

スネーク_008: {
He? Aha, 'tschuldigung?
}
//	<<<ENGLISH>>>
//	Huh? Ah, sorry...?

/*え？ああ……？……すまない……？？*/
}//d


resource TO_ＳＡＶＥ後中盤１__g {
//ns
オタコン_000: {
Kennst Du den Spruch 'Die, die 100 Meilen
laufen, denken erst bei der 90. Meile,
}
//	<<<ENGLISH(2)>>>
//	Do you know the saying
//	"Those who walk a hundred
//	leagues think not that＃−
//<ページ数変更>
オタコン_000_1: {
da&~s die Reise zur H&~alfte vor&~uber ist'?
}
//	<<<ENGLISH>>>
//	their journey is half ended
//	until the ninetieth league"?

/*『百里を行く者は＃｛九十、きゅうじゅう｝＃を＃｛半、なか｝＃ばとす』
っていうコトワザ知ってるかい？
*/

オタコン_001: {
Das bedeutet - was bedeutet dies - 
}
//	<<<ENGLISH(2)>>>
//	That means...
//	-- what does it mean --

/*意味は……なんだろうな……。*/

オタコン_002: {
Klar, es bedeutet, wenn man so weit gehen
m&~ochte, 
}
//	<<<ENGLISH>>>
//	OK. It means that if you're
//	planning to walk that far,
//<ページ数変更>
オタコン_002_1: {
sollte man verdammt gut in Mathe sein.
Lerne! Bleibe in der Schule!
}
//	<<<ENGLISH>>>
//	you'd better damn well know
//	how to do simple arithmetic.
//	Study! Stay in school!

/*うん。百里も行こうというのに数が
勘定出来ないだと困るからちゃんと勉強
しといた方がいいってことだ。多分。
*/

スネーク_003: {
Dies scheint mir immer wirrer zu werden.
}
//	<<<ENGLISH>>>
//	This seems to be getting
//	more and more random.

/*だんだんいい加減になっていく気が
するんだが。
*/

オタコン_004: {
Falsch - es wird komplexer. Vertrau' mir.
}
//	<<<ENGLISH>>>
//	Correction -- it's becoming
//	more deep. Trust me.

/*何言ってんだい。そんなこと
あるわけないじゃないか。
*/
}//d


resource TO_ＳＡＶＥ後中盤２__g {
//ns
オタコン_000: {
Ok, - 'Ein Frosch im Brunnen wei&~s nichts
vom gro&~sen Ozean'.
}
//	<<<ENGLISH(2)>>>
//	OK -- "A frog in a well knows
//	not of the great ocean."

/*えーと……『＃｛好漢、こうかん｝＃は＃｛当年、とうねん｝＃の＃｛勇、ゆう｝＃を語らず』
*/

オタコン_001: {
Das gef&~allt mir nicht.
}
//	<<<ENGLISH>>>
//	Hey, I don't like this one at all.
//<ページ数変更>
オタコン_001_1: {
Einen kleinen Frosch im Brunnen gefangen
halten? Das ist wirklich grausam.
}
//	<<<ENGLISH>>>
//	Trapping a little frog in a well?
//	That sucks, that's really cruel.

/*これはいけないね。人として絶対に
しちゃいけない最悪の犯罪だ。
*/

オタコン_002: {
Er wird das gro&~se blaue Meer nie sehen -
}
//	<<<ENGLISH>>>
//	Of course it's not going to
//	see the big blue sea＃−
//<ページ数変更>
オタコン_002_1: {
schon das fehlende Sonnenlicht wird ihn
bald t&~oten.
}
//	<<<ENGLISH>>>
//	the lack of sunlight alone
//	will kill it pretty quick.

/*刑罰も当然、殺人や放火と同じくらい
重くなってる。
*/

オタコン_003: {
Gut, jemanden einzusperren ist der beste
Weg, um sicherzugehen, da&~s keiner sieht,
was man vorhat.
}
//	<<<ENGLISH>>>
//	Sure, locking someone up is a good
//	way to make sure they don't see
//	what you don't want them to.
//<ページ数変更>
オタコン_003_1: {
Aber es ist ein gr&~a&~sliches Sprichwort;
ich hasse es. Armes kleines Fr&~oschli!
}
//	<<<ENGLISH>>>
//	But this is a terrible saying,
//	and I don't like it at all. Poor
//	little froggy...!

/*それを誇る奴なんて最低のクズだって
ことさ、全く！でも、なんでこんな
コトワザがあるんだろう……？
*/

スネーク_004: {
Ich denke, Du hast es falsch verstanden.
}
//	<<<ENGLISH>>>
//	...I really think you've
//	got this one wrong.

/*……お前、勘違いしてないか？
*/
}//d


resource TO_ＳＡＶＥ後中盤３__g {
//ns
オタコン_000: {
Die Chinesen haben ein Sprichwort:
'Gelehrte sch&~atzen das Wissen,
nicht die Taten.'
}
//	<<<ENGLISH>>>
//	The Chinese have a proverb
//	that goes "Scholars hold in
//	esteem knowledge, not acts."

/*中国では『学者はこれ之を知るをとうと貴び、
これ之を行うをとうと貴ばず』って言うことも
あるんだ。
*/

オタコン_001: {
So, die sitzen da rum und denken, anstatt
etwas zu tun. Deshalb sind sie nicht allzu
n&~utzlich.
}
//	<<<ENGLISH>>>
//	See, they just sit around thinking,
//	instead of actually doing something.
//	Which doesn't make them too useful.
//<ページ数変更>
オタコン_001_1: {
Taten z&~ahlen! Denke ich jedenfalls.
}
//	<<<ENGLISH>>>
//	Action is what matters! I think.

/*学者は知識ばかりを求めて行動しない
からダメだってことで……
……まあ、事をなすには行動が大事ってことだよ。多分。
*/

スネーク_002: {
Pa&~s' auf, was ich von Mei Ling h&~orte,
war, da&~s - 
}
//	<<<ENGLISH>>>
//	Look, what I heard from
//	Mei Ling was that --

/*やはりメイ・リンから聞いた時とは
違うと思うんだが……。
*/

オタコン_003: {
Snake, hast Du bemerkt, da&~s Du sie oft
erw&~ahnst?
}
//	<<<ENGLISH>>>
//	Snake, have you noticed that
//	you bring her up a lot?

/*なんだい、スネーク、そんなに
メイ・リンのことが気になるのかい？
*/

スネーク_004: {
He? Das ist nicht die - 
}
//	<<<ENGLISH>>>
//	Huh? That isn't the --

/*いや、そういうことではなくて……。*/

オタコン_005: {
Schon wieder. Was soll ich blo&~s mit Dir
anfangen?
}
//	<<<ENGLISH>>>
//	Here we go again.
//	What am I going to
//	do with you?

/*また、また。
ホント、困ったもんだよ、君には。
*/

スネーク_006: {
Wie ich schon sagte - 
}
//	<<<ENGLISH>>>
//	Like I was saying --

/*だから……。*/

オタコン_007: {
Du und Deine hyperaktive Libido. Nur gut,
da&~s einer von uns einen k&~uhlen Kopf
bewahrt.
}
//	<<<ENGLISH>>>
//	You and your hyperactive libido.
//	It's a good thing one of us can
//	keep all the details straight.

/*やれやれ。オイタもいい加減に
しとかないと、また大変なことに
なるよ？
*/

スネーク_008: 
''
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
}//d


resource TO_ＳＡＶＥ後中盤４__g {
//ns
オタコン_000: {
Mein liebstes chinesisches Sprichwort:
'Besser der Erste unter den H&~ahnen, als
der Letzte bei den Bullen.'
}
//	<<<ENGLISH>>>
//	This is my favorite Chinese saying:
//	"Better to be first among roosters
//	than last among bulls."

/*『＃｛鶏口、けいこう｝＃となるも＃｛牛後、ぎゅうご｝＃となるなかれ』って
中国のコトワザ、知ってるかい？
*/

オタコン_001: {
Die Bedeutung ist klar:
}
//	<<<ENGLISH>>>
//	Of course, the meaning's clear:
//<ページ数変更>
オタコン_001_1: {
Wenn Du w&~ahlen mu&~st, ob Du ein Huhn
oder eine Kuh sein willst, nimm' das Huhn.
}
//	<<<ENGLISH>>>
//	If you have to choose between
//	being a chicken or a cow, pick
//	the chicken.
//<ページ数変更>
オタコン_001_2: {
K&~uhe werden immer von Aliens mi&~shandelt
- die Vorf&~alle h&~aufen sich.
}
//	<<<ENGLISH>>>
//	Cows are always being messed with
//	by aliens -- cattle mutilations are
//	up, you know.

/*牛よりも＃｛鶏、にわとり｝＃になる方がいい。牛は
宇宙人に血を抜かれたりするからね。
*/

オタコン_002: {
Warum sollte man sich freiwillig &~Arger
einhandeln?
}
//	<<<ENGLISH>>>
//	Why go looking for trouble, right?

/*余計な厄介事はしょい込むなってことだ。*/

オタコン_003: {
Wenn ein Feind Dich sieht, hast Du mehr
&~Arger als eine Kuh im UFO. Also bleib
in Deckung!
}
//	<<<ENGLISH>>>
//	If an enemy spots you, you'll be in
//	more trouble than a cow on a UFO.
//	You stay out of their sight!

/*敵に発見されたら厄介なことになる。
絶対、見つからないようにしてくれよ。
*/

スネーク_004: {
Warum kommen Aliens in einem alten
chinesischen Sprichwort vor?
}
//	<<<ENGLISH>>>
//	Why would aliens be in
//	an old Chinese proverb?

/*宇宙人が昔の中国に行ったとは
思えないんだが……？
*/

オタコン_005: {
Jeder wei&~s, da&~s sie uns schon seit
Jahrtausenden besuchen.
}
//	<<<ENGLISH>>>
//	Everyone knows they've been
//	visiting us for thousands of
//	years.

/*宇宙人は国になんかこだわらないよ！
*/

スネーク_006: {
das ist mir neu.
}
//	<<<ENGLISH>>>
//	...news to me.

/*……？*/
}//d


//・メイ・リン登場 h //e
resource TO_ＳＡＶＥ後メイ・リン登場__g {
//ns
オタコン_000: {
Snake, kennst Du das chinesische
Sprichwort 'Sorgfalt vermeidet Weh'?
}
//	<<<ENGLISH>>>
//	Snake, do you know
//	the Chinese proverb
//	"Care avoids err"?

/*スネーク、『＃｛小心、しょうしん｝＃に＃｛大過、たいか｝＃なし』って
中国のコトワザ知ってるかい？
*/

オタコン_001: {
'Weh', so glaubt man, ist ein !Kung-Wort,
das 'was' bedeutet.
}
//	<<<ENGLISH>>>
//	"Err" is thought to be a
//	！Kung word meaning "what."


/*『タイカ』はイヌイットの言葉で
『あれ』って意味だ。
*/

オタコン_002: {
Einige Linguisten sind der Auffassung, da&~s
das fast weltweit als F&~ullsilbe gebrauchte
'&~ah',
}
//	<<<ENGLISH>>>
//	There are some linguists who
//	think that this accounts for an
//	almost universal utterance＃−
//<ページ数変更>
オタコン_002_1: {
wenn die Worte fehlen darauf
zur&~uckzuf&~uhren ist.
Eine Art von rudiment&~arer -
}
//	<<<ENGLISH>>>
//	of the syllable "er" when people
//	are at a loss for words. A kind
//	of vestigial --

/*『あれはなんだ？』って聞く時は
『キスーリ タイカ？』って言うよね。
つまり……。
*/

メイ・リン_003: {
Hallo!
}
//	<<<ENGLISH(2)>>>
//	Hey!

/*ちょっと！*/

オタコン_004: {
Ach!
}
//	<<<ENGLISH(2)>>>
//	Ack!

/*わぁ！*/

メイ・リン_005: {
Du Penner! Was ist mit dem kleinen
Spickzettel, den ich Dir erstellt habe?
}
//	<<<ENGLISH>>>
//	What a crock! What did you
//	do with that little cheat sheet
//	I made you!

/*デタラメばっかり言って！
私が作ってあげたメモはどうしたの？
*/

オタコン_006: {
&~Ah -
}
//	<<<ENGLISH>>>
//	Er --

/*いや……。*/

メイ・リン_007: {
Oh, da ist er ja - Hallo!
}
//	<<<ENGLISH(2)>>>
//	Oh, there it is -- Hey!

/*あ、そんなとこに……ええっ！？*/

オタコン_008: {
&~Ah, das ist wirklich ein.
}
//	<<<ENGLISH>>>
//	Er, that's really a...

/*あの、それは……。*/

メイ・リン_009: {
Wie konntest Du!? Du wei&~st, wie
besch&~aftigt ich bin, und Du - !!
}
//	<<<ENGLISH>>>
//	How could you do that!
//	You know how busy I am
//	and you -- !!

/*ヒドイ！！どうしてそんなこと
出来るのよ！？もう、サイテー！！！
*/

オタコン_010: {
Es ist nicht, was Du denkst.
}
//	<<<ENGLISH>>>
//	It's not what you think...

/*いや違うんだ……。*/

メイ・リン_011: {
Aha, was denke ich denn?
}
//	<<<ENGLISH>>>
//	Oh, so what am I thinking?

/*何がどう違うってのよ！！*/

スネーク_012: {
Was ist bei Euch los?
}
//	<<<ENGLISH>>>
//	What's going on over there?

/*どうしたんだ？*/

メイ・リン_013: {
Oh, hallo, Snake. Wu&~stest Du, da&~s
Octacon -
}
//	<<<ENGLISH>>>
//	Oh, hi, Snake.
//	Do you know that
//	Otacon's been --

/*聞いてよ、スネーク！
オタコンったら……。
*/

オタコン_014: {
&~Ah, Mei Ling, wir sind gerade mitten in
einer Mission und so k&~onnten wir also,
Du wei&~st.
}
//	<<<ENGLISH>>>
//	Er, Mei Ling, we're in the middle
//	of a mission and everything!
//	So can we, you know...

/*メイ・リン！
ほら、あの、今作戦中だしさ、ね。
*/

メイ・リン_015: 
''
//	<<<ENGLISH(2)>>>
//	...

/*……。*/

オタコン_016: 
''
//	<<<ENGLISH(2)>>>
//	...

/*……。*/

メイ・リン_017: {
Fein. Sicher.
}
//	<<<ENGLISH>>>
//	Fine. Sure.

/*……わかった。*/

メイ・リン_018: {
Und Snake, die wahre Bedeutung von
'Sorgfalt vermeidet Weh'
}
//	<<<ENGLISH>>>
//	And Snake, the real meaning
//	of "Care avoids err"
//<ページ数変更>
メイ・リン_018_1: {
ist, durch vorsicht vermeidet man
schwerwiegende Fehler.
}
//	<<<ENGLISH>>>
//	is that if you're cautious,
//	you can avoid making
//	serious mistakes.

/*いい、スネーク、『小心に大過なし』の
本当の意味は、慎重にやれば大きな
間違いをすることはないって意味よ。
*/

メイ・リン_019: {
Selbst wenn Du den Einsatz im Schlaf
beherrschst, sei vorsichtig. Viel Gl&~uck!
}
//	<<<ENGLISH>>>
//	Even if you've gotten used
//	to the mission, watch what
//	you do. Good luck!

/*ゲームに馴れてきても、慎重さは
忘れないでってこと。がんばってね！
*/

オタコン_020: {
Ja, Snake! Viel Gl&~uck!
}
//	<<<ENGLISH(2)>>>
//	Yeah, Snake! Good luck!

/*うん、がんばって！*/

メイ・リン_021: {
Wir sind noch nicht fertig.
}
//	<<<ENGLISH>>>
//	You, I'm not done with.

/*さ、オタコン……。*/

オタコン_022: {
Ach.
}
//	<<<ENGLISH(2)>>>
//	Ack...

/*う！*/

メイ・リン_023: {
La&~s' uns dr&~uber reden, okay?
}
//	<<<ENGLISH>>>
//	Let's discuss this, shall we?

/*話し合いましょうか。みっちりと。*/

オタコン_024: 
''
//	<<<ENGLISH>>>



/*……。*/

}//d

resource TO_ＳＡＶＥ後メイ・リン登場後__g {
//ns
スネーク_000: {
Was ist mit Mei Ling passiert?
}
//	<<<ENGLISH>>>
//	What happened to Mei Ling?

/*メイ・リンはどうした？*/

オタコン_001: {
He, he! Sie rastete aus und ging offline.
}
//	<<<ENGLISH>>>
//	Hee. She got mad
//	and went offline.

/*あはは。怒って回線切られちゃった。*/

スネーク_002: {
Was hast Du getan?
}
//	<<<ENGLISH>>>
//	What did you do?

/*お前、一体何をしたんだ？*/

オタコン_003: {
Nichts! M&~ussen wir nicht wieder zur&~uck
zur Mission? So viel zu tun, so wenig
Zeit.
}
//	<<<ENGLISH(2)>>>
//	Nothing! Now don't we need
//	to get back to the mission?
//	So much to do, so little time...

/*いや、何もしてないよ！
そんなことより作戦だ。ね？
*/

スネーク_004: 
''
//	<<<ENGLISH(2)>>>
//	...

/*……。*/
}//d

