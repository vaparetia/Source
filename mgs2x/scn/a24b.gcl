// 仮キャラ
// ------------------------------------




















// 以下デバッグ専用proc
// -----------------------------------------------------------------------------------
// デバッグキャラ
// ------------------------------------
proc デバッグキャラセット {
	#if d:DEBUG_PRINT
		print 'debug_chara_set'
	#endif

	#if d:CHARA_CAMERA
		chara キャラカメラ 敵兵カメラ \
			-c d:TARGET_CHARA \
			-s -920,610,200 \
			-r -200,1024,0
	#endif

	#if d:SCREENSHOT
		chara スクリーンショット shot
	#endif

	#if d:USB_KEY
		chara USBキーボード実行 test \
			-e d:KBD_ESC {
				mesg プレイヤー d:PLAYER position -5500, -13000, -500
			} \
	#endif

	#if d:MOTION_RECORDER
	chara モーションレコーダー モショレコ敵兵 \
		-t センサー敵兵 \
		-o w24b_gbs_sensordemo.mtn \
		-f 3600 \
		-e 0

	chara モーションレコーダー モショレコライデン \
		-t d:PLAYER \
		-o w24b_rai_sensordemo.mtn \
		-f 3600 \
		-e 0


	#endif


}
