#define		HZX_NAME			a24b
#define		KMS_NAME0			w24b0	//廊下
#define		KMS_NAME1			w24b1	//倉庫
#define		KMS_NAME2			w24b2	//リフレッシュルーム
#define		CEIL_NAME0			w24b0r	//廊下天井
#define		CEIL_NAME1			w24b1r	//倉庫天井
#define		CEIL_NAME2			w24b2r	//リフレッシュルーム天井
//#define		DOOR_NAME			w24b_dr01
