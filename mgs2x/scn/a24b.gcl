//###################################################################################
//									ドア設定
//###################################################################################

	proc ドア設置 {
		#if d:DEBUG_PRINT
			print 'slide_door_set'
		#endif

/*
		@ドアモデル名セット $:配列番号 \
			$:ドア名１				$:ドア名２				$:ドア名３ \
			$:ドア名４				$:ドア名５
			d:DOOR_FLAG_CLOSE 		d:DOOR_FLAG_OPEN		d:DOOR_FLAG_ENEMY_ONLY
			d:DOOR_FLAG_CLOSE_LEVEL	d:DOOR_FLAG_OPEN_LEVEL

		@A_ドア開閉追加設定 $:ドア名 $:フラグ $:ドア位置Ｘ $:ドア位置Ｙ $:ドア位置Ｚ $:ドア回転 $:ドアスライド幅
*/
		//	ノード部屋ドア
		@ドアモデル名セット 0 d:DOOR_NAME d:DOOR_NAME d:DOOR_NAME d:DOOR_NAME d:DOOR_NAME
		@A_ドア開閉追加設定 ノード部屋ドア $$b:ドアフラグ[0] 4125 -4500 -72500 3072 d:SD_SLIDE_INSIDE

		//	人質部屋ドア
		@ドアモデル名セット 1 d:DOOR_NAME_LOAD d:DOOR_NAME_LOAD d:DOOR_NAME_LOAD d:DOOR_NAME_LOAD d:DOOR_NAME_LOAD
		@A_ドア開閉追加設定 人質部屋ドア $$b:ドアフラグ[1] -1325 -4500 -67000 3072 d:SD_SLIDE_INSIDE


		//	ノード部屋ドア
		chara ドア ノード部屋ドア \
			-m $$s:ドアモデル名[0] \
			-d 0,3072,0 \
			-p 4125,-4500,-72500 \
			-slide d:SD_SLIDE_INSIDE \
			-time d:SD_OPEN_TIME \
			-A ノード部屋ドアランプ \
			-between シェル１中央棟Ｂ１ ノード部屋 \
			-exec {
				if ($:開閉フラグ == 0) {
					mesg マップ接合 東側マップ接合 off
				} else {
					mesg マップ接合 東側マップ接合 on
				}
			}
		@ドアランプ設定 ノード部屋ドアランプ 3072 4125 -4500 -72500 0

		trap dr001 ？ \
			-mask ？ \
			-exec {
				if ($3 == 入る) {
					mesg ドア ノード部屋ドア open $2
				} else {
					mesg ドア ノード部屋ドア close $2
				}
			}

		trap dr001_behind d:PLAYER \
			-mask ？ \
			-dir 1024,256 \
			-state d:TRP_STATE_BEHINDCAMERA_ENABLE \
			-exec {
				if ($3 == 入る) {
					mesg ドア ノード部屋ドア open $2
				} else {
					mesg ドア ノード部屋ドア close $2
				}
			}


		//	人質部屋ドア
		chara ドア 人質部屋ドア \
			-m $$s:ドアモデル名[1] \
			-d 0,3072,0 \
			-p -1325,-4500,-67000 \
			-slide d:SD_SLIDE_INSIDE \
			-time d:SD_OPEN_TIME \
			-between シェル１中央棟Ｂ１ シェル１中央棟Ｂ１ \
			-exec {
				if ($:開閉フラグ == 0) {
					mesg プットオブジェ ロード部屋 off
					mesg プットオブジェ 網膜センサーランプ赤 on
					mesg プットオブジェ 網膜センサーランプ青 off
				} else {
					mesg プットオブジェ ロード部屋 on
					mesg プットオブジェ 網膜センサーランプ赤 off
					mesg プットオブジェ 網膜センサーランプ青 on
				}
			}

#ifndef d:EYE_SENSOR	//	網膜センサーチェックではない場合
print '######################################NO_EYE_SENSOR'
		trap dr002 ？ \
			-mask ？ \
			-exec {
				if ($3 == 入る) {
					mesg ドア 人質部屋ドア open $2
				} else {
					mesg ドア 人質部屋ドア close $2
				}
			}
#endif
		trap dr002 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_SUBJECT \
			-exec {
				if ($3 == 入る) {
					mesg 透明壁 人質部屋ドア壁 on
				} else {
					mesg 透明壁 人質部屋ドア壁 off
				}
			}

		chara プットオブジェ 網膜センサーランプ青 -m w24b0_lamp_on -r 0 0 0 \
			-s 100,100,100 \
			-p 0 0 0 -l w24b
		mesg プットオブジェ 網膜センサーランプ青 off

		chara プットオブジェ 網膜センサーランプ赤 -m w24b0_lamp_off -r 0 0 0 \
			-s 100,100,100 \
			-p 0 0 0 -l w24b
	}




//###################################################################################
//									イントルード金網設定
//###################################################################################

	proc イントルード金網設定 {
		#if d:DEBUG_PRINT
			print 'イントルード金網設定'
			print 'INTRUDE_KANAAMI'
		#endif

		trap fence_000 d:PLAYER \
			-mask ＊ \
			-dir 1024,256 \	//方向指定
			-exec {
				command イントルード主観カメラ補正 \
					-se d:se_code:SD_P_HEADNET1 \
					-len 1000 \
					-inout $3
			}
	}

//###################################################################################
//									ロード退場
//###################################################################################

	proc ロードプロック {
		#if d:DEBUG_PRINT
			print 'load_proc'
		#endif

		if ($s:呼び出しプロック == mv_a24b_a24a_0) {
			// １Ｆへ
			@mv_a24b_a24a_0

		} else if ($s:呼び出しプロック == mv_a24b_a24c_0) {
			// 人質部屋へ
			@mv_a24b_a24c_0

		} else if ($s:呼び出しプロック == mv_a24b_a24d_0) {
			// Ｂ３へ
			@mv_a24b_a24d_0
		} else if ($s:呼び出しプロック == load_tales_book) {
			// スネークテイルズ用紙芝居へ
			@load_tales_book
		}
	}

	proc ロード設定 {
		#if d:DEBUG_PRINT
			print 'load_set'
		#endif

		trap ld002 d:PLAYER \
			-mask 入る \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 1 ) {
					if ( $b:tales_story_no == d:TALES_NO:A && $f:テイルズＡ人質部屋紙芝居終了フラグ == 0 ) {
						if ( $f:テイルズＡ人質部屋１回来たフラグ == 0 ) {
							// 初めての訪問の時は紙芝居用ステージへ
							@ステージ終了時処理（ステージ名表示） 0 -4500 -66250 1024 \
								load_tales_book d:DEFAULT_M_TYPE d:wn_シェル１中央棟Ｂ１集会場
						} else {
							// 二回目以降はマイクを持っていたときのみ一回だけ紙芝居用ステージへ
							if ( $w:武器弾数Ｒ[ d:武器:マイク ] == 1 ) {
								@ステージ終了時処理（ステージ名表示） 0 -4500 -66250 1024 \
									load_tales_book d:DEFAULT_M_TYPE d:wn_シェル１中央棟Ｂ１集会場
							} else {
								//人質部屋へ
								@ステージ終了時処理（ステージ名表示） 0 -4500 -66250 1024 \
									mv_a24b_a24c_0 d:DEFAULT_M_TYPE d:wn_シェル１中央棟Ｂ１集会場
							}
						}

						//	アナザー
						@スタートカメラセット

					} else {
						//人質部屋へ
						@ステージ終了時処理（ステージ名表示） 0 -4500 -66250 1024 \
							mv_a24b_a24c_0 d:DEFAULT_M_TYPE d:wn_シェル１中央棟Ｂ１集会場

						//	アナザー
						@スタートカメラセット
					}
				}
			}

	}

//###################################################################################
//								エフェクト設定
//###################################################################################

	//	弾痕跳弾設定
	// ------------------------------------
	proc 弾痕跳弾設定 {
		command 跳弾ノーマル -n 0
		command 跳弾ノーマル -n 1
		command 跳弾ノーマル -n 2
		command 跳弾ノーマル -n 3
		command 跳弾ノーマル -n 4
		command 跳弾ＳＥのみ -n 6
		command 跳弾ＳＥのみ -n 7

		command 弾痕ノーマル -n 0
		command 弾痕ノーマル -n 1
		command 弾痕ノーマル -n 2
		command 弾痕ノーマル -n 3
		command 弾痕ノーマル -n 4
		command 弾痕ノーマル -n 6
		command 弾痕ノーマル -n 7
	}

	// フォグ
	// ------------------------------------
	proc フォグ設定 {
		#if d:DEBUG_PRINT
			print 'フォグ設定'
		#endif

		chara フォグ 霧\
			-c 50,69,50 \
			-n 0 \
			-f 33000
	}

	// キャラ用光源(マップの設置が終わってから設定することで、キャラだけに光を当てる)
	// ------------------------------------
	proc キャラ用ライト設置 {
		#if d:DEBUG_PRINT
			print 'chara_light_set'
		#endif

		chara 環境光 環境光源 \
			 -c 40 67 62

		chara 平行光 平行光源 \
			 -c 80 85 90 \
			 -p 2400 -3000 -3200
	}

	// エフェクト関係
	// -----------------------------------
	proc エフェクト設定 {
		#if d:DEBUG_PRINT
			print 'effect_set'
		#endif

		#if d:BLUR
			chara ブラー ブラー
		#endif

		#if d:Z_MANAGER
			chara Ｚフォーカス管理 Z_manager
			mesg Ｚフォーカス管理 Z_manager パラメータ 5000 30
		#endif

		#if d:BODY_SHADOW
			chara ＯＦＦ制御 off_man
			mesg ＯＦＦ制御 off_man ボディシャドウＯＦＦ
		#endif

		chara シネマスクリーン シネマ -top d:CINEMA_BELT_UPPER -bottom d:CINEMA_BELT_LOWER -ftime 30

//レーダーアタリ処理
/*
		command foreach -argc 1 -repeat 3 \
			-data { \
				{0},{1},{2} \
			} \
			-exec {
				command 追加ＨＺＸグループ登録 \
					-hzx_id $1 \
					-add_id 3
			}
*/
	}

//###################################################################################
//									天井君設定
//###################################################################################

	proc シェル１中央棟Ｂ１天井設置 {
		#if d:DEBUG_PRINT
			print 'w24b_ceil_set'
		#endif

		//	インテグラル
		eval($i:天井君Ｙリミット = -1000)

		chara 天井君 シェル１中央棟Ｂ１廊下天井 -m d:CEIL_NAME0 -h $i:天井君Ｙリミット -p 0,0,0 -l d:LT2_NAME

		chara 天井君 シェル１中央棟Ｂ１倉庫天井 -m d:CEIL_NAME1 -h -1000 -p 0,0,0 -l d:LT2_NAME
		chara 天井君 シェル１中央棟Ｂ１リフレッシュ天井 -m d:CEIL_NAME2 -h -1000 -p 0,0,0 -l d:LT2_NAME

		chara 天井君 北側壁 \
			-m w24b0_wall1 -p 0 0 0  -l d:LT2_NAME \
			-c 0 0 -70500 -a 5

		chara 天井君 南側壁 \
			-m w24b0_wall2 -p 0 0 0  -l d:LT2_NAME \
			-c 0 0 -63300 -a 5

	}

//###################################################################################
