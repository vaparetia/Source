	proc ロード部屋設置 {
		#if d:DEBUG_PRINT
			print 'ロード部屋設置'
		#endif

//		chara プットオブジェ ロード部屋 -m w24b_w24c -r 0,0,0 -p 0,0,0 -l d:LT2_NAME
	/*	//	天井がないのでＰＳ２Ｊ以降修正	2002/09/11	*/
