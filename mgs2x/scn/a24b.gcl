// ローカル変数


//	司令官音声
resource ghq_area_alert_voice {
	w24b:
		$t{
			//PLAREA0 リフレッシュルーム
			t:vc040244,	//指揮官「了解。バックアップをシェル１中央棟Ｂ１、網膜センサー付近に派遣する。敵を逃がすな！」
			t:vc040245,	//指揮官「了解。増援部隊、シェル１中央棟Ｂ１に急行せよ！網膜センサーを守れ！」
			t:vc040246,	//指揮官「了解。増援部隊、シェル１中央棟Ｂ１に向かえ！侵入者をホール集会場に入れるな」
			t:vc040247,	//指揮官「了解。増援部隊をシェル１中央棟Ｂ１、ホール集会場への入口付近に派遣する！敵を逃がすな！」
			-2,
			// PLAREA1 網膜センサー
			t:vc040244,	//指揮官「了解。バックアップをシェル１中央棟Ｂ１、網膜センサー付近に派遣する。敵を逃がすな！」
			t:vc040245,	//指揮官「了解。増援部隊、シェル１中央棟Ｂ１に急行せよ！網膜センサーを守れ！」
			t:vc040246,	//指揮官「了解。増援部隊、シェル１中央棟Ｂ１に向かえ！侵入者をホール集会場に入れるな」
			t:vc040247,	//指揮官「了解。増援部隊をシェル１中央棟Ｂ１、ホール集会場への入口付近に派遣する！敵を逃がすな！」
			-2,
			t:vc040248,	//指揮官「了解。増援部隊をシェル１中央棟Ｂ１に派遣する！侵入者を逃がすな！」
			t:vc040249,	//指揮官「了解。応援部隊、シェル１中央棟Ｂ１に向かえ！敵を逃がすな！」
			-1 // PLAREA0の登録終了
		}
}

resource ghq_caution_voice {
	w24b:
		$t{
			// PLAREA0 リフレッシュルーム
			t:vc040397,	//指揮官「了解。シェル１中央棟Ｂ１に増員を送る。リフレッシュルームの警戒を強化しろ」
			t:vc040398,	//指揮官「了解。シェル１中央棟Ｂ１、リフレッシュルームを増員する。警備を強化せよ」
			// PLAREA1 網膜センサー
			t:vc040399,	//指揮官「了解。シェル１中央棟Ｂ１、網膜センサー付近に増員を送る。警戒を強化せよ」
			t:vc040400,	//指揮官「了解。シェル１中央棟Ｂ１を増員する。網膜センサー付近を警戒強化せよ」
			t:vc040401,	//指揮官「了解。シェル１中央棟Ｂ１を増員する。ホール集会場への入口を固めろ」
			t:vc040402,	//指揮官「了解。シェル１中央棟Ｂ１、ホール集会場への入口付近に増員を送る。警戒を強化せよ」
			t:vc040403,	//指揮官「了解。シェル１中央棟Ｂ１を増員する。警戒を強化せよ」
			t:vc040404,	//指揮官「了解。シェル１中央棟Ｂ１に増員を送る。警備を強化せよ」
			-2,
			t:vc040433,	// 指揮官　　「シェル１中央棟Ｂ１との連絡が途絶えた」
			-1 // PLAREA0の登録終了
		}
	}


// モーションリスト関係

enum センサーモーションリスト {
	gbs_walk = 0,
	gbs_sensor_ok,
	gbs_idle,
	gbs_forced
}



//	ドア設定用ステージ内ローカル変数(a_mode.hよりも先に定義する)
dim $$b:ドアフラグ[ 3 ]
dim $$s:ドアモデル名[ 2 ]

command	配列セット $$b:ドアフラグ[0] {
	0,	0,	0
}
command	配列セット $$s:ドアモデル名[0] {
	0,	0
}


// include
// ------------------------------------
#include "rai_a24b.mh"		// 強制モーションリスト

#include "stdch.h"
#include "enevoice.h"
#include "a_mode.h"	// アナザー各モード別変数設定用ファイル

#include "sload.h"
#include "jump.h"
#include "sound.h"
#include "item_info.h"
#include "node_res.h"
#include "ene_item.h"

#if d:USB_KEY
	#include "usbkbd.h"
#endif

// アナザー用でマップ設定前に設定する
// ------------------------------------
@アナザー用マップ定義前設定

// マップ設定
// ------------------------------------

//人質イベント後は網膜センサーが壊れモデルになる
if($w:p_story >= d:ST:P040_09_P05エイムズ発見９ポリゴンデモ５終了){
	eval($s:w24b_網膜センサーモデル名 = w24b0_ms01)
}else{
	eval($s:w24b_網膜センサーモデル名 = w24b0_ms00)
}

chara マップ シェル１中央棟Ｂ１ -k d:KMS_NAME0 -k $s:w24b_網膜センサーモデル名 -h d:HZX_NAME,0 -l d:LT2_NAME
chara マップ ノード部屋 -k d:KMS_NAME1 -h d:HZX_NAME,1 -l d:LT2_NAME
chara マップ リフレッシュルーム -k d:KMS_NAME2 -h d:HZX_NAME,2 -l d:LT2_NAME

chara マップ接合 西側マップ接合 シェル１中央棟Ｂ１ リフレッシュルーム
chara マップ接合 東側マップ接合 シェル１中央棟Ｂ１ ノード部屋




command マップ設定 シェル１中央棟Ｂ１ ノード部屋 リフレッシュルーム -set {

#if d:NODE
//	@ノード端末設定 1024
#endif
	@常駐キャラ設定
	@ローカル変数初期化
	@設定値変更
	@A_プレイヤー設定 sna_a24b rai_a24b
}

// アナザー用でマップ設定後に設定する
// ------------------------------------
@アナザー用マップ定義後設定

command マップ設定 シェル１中央棟Ｂ１ ノード部屋 リフレッシュルーム -set {
	@弾痕跳弾設定
// マップ切り替え、ロード、ドア
// ------------------------------------
#if d:LOAD_TRAP
	@ロード設定
#endif

// ステージ、オブジェクト関連
// ------------------------------------
#if d:FOG
	@フォグ設定
#endif
#if d:EFFECT
	@エフェクト設定
#endif
	@カメラセット
	@子画面設定
#if d:CHARA_CEIL
	@シェル１中央棟Ｂ１天井設置
#endif
#if d:LOCKER
	@ロッカー設置
#endif
}

command マップ設定 シェル１中央棟Ｂ１ -set {
// マップ切り替え、ロード、ドア
// ------------------------------------
#if d:ELEVATOR_SET
	@エレベーター設置 シェル１中央棟Ｂ１	// stdproc.hで定義
#endif
	@ロード部屋設置
	@廊下カメラ設定
// ステージ、オブジェクト関連
// ------------------------------------
	@主観禁止壁 人質部屋ドア壁 -1325 -4500 -67000 3072 d:SD_SLIDE_INSIDE		//stdproc.h

#ifdef d:EYE_SENSOR
print '######################################EYE_SENSOR'
	@網膜センサーロード設定		// 網膜センサーチェックの場合
#endif

}

command マップ設定 シェル１中央棟Ｂ１ ノード部屋 -set {
// マップ切り替え、ロード、ドア
// ------------------------------------
#if d:SLIDE_DOOR
	@ドア設置
#endif
// ステージ、オブジェクト関連
// ------------------------------------
#if d:INTRUDE_KANAAMI
	@イントルード金網設定
#endif
}

command マップ設定 ノード部屋 -set {
// ステージ、オブジェクト関連
// ------------------------------------
	@ノード部屋カメラ設定
}

command マップ設定 リフレッシュルーム -set {
// ステージ、オブジェクト関連
// ------------------------------------
#if d:GRASS
	@リフレッシュ草設置
#endif
	@リフレッシュルームカメラ設定
#if d:FRAGILE
	@壊れ雑誌
#endif
}

command マップ設定 シェル１中央棟Ｂ１ ノード部屋 リフレッシュルーム -set {
// ステージ、オブジェクト関連
// ------------------------------------
	@西側マップ接合管理
#if d:CHARA_LIGHT
	@キャラ用ライト設置		// マップ設定の最後に呼ぶ
#endif
#if d:DEBUG_CHARA
	@デバッグキャラセット
#endif
#if d:MIRROR
	@鏡面モデル設定
#endif

//	@プラント編全体マップ設定 d:シェル１中央棟マップ	// stdproc.hで定義

}



//初期マップの表示
command マップ表示 -show シェル１中央棟Ｂ１

// 全てのセットが終わったところでフェードイン
if ($s:登場ポイント == シェル１中央棟１Ｆから) {
	// １Ｆから
	// 全てのセットが終わったところでフェードイン

	@ステージ開始時処理（エレベーター） d:wn_シェル１中央棟Ｂ１

} else if ($s:登場ポイント == 人質部屋から) {
	// 人質部屋から
	// 全てのセットが終わったところでフェードイン

	@ステージ開始時処理（ステージ名表示）\
		 d:LOAD_TYPE:SL_DOOR_TYPE 人質部屋ドア 2500 d:DEFAULT_M_TYPE \
		 d:wn_シェル１中央棟Ｂ１

} else if ($s:登場ポイント == シェル１中央棟Ｂ３から) {
	// Ｂ３から
	// 全てのセットが終わったところでフェードイン

	@ステージ開始時処理（エレベーター） d:wn_シェル１中央棟Ｂ１

} else if($s:登場ポイント == テイルズＡジェニファー遭遇紙芝居後から) {
	@ステージ開始時処理（ステージ名表示）\
		 d:LOAD_TYPE:NO_MOVE_TYPE 紙芝居後 0 d:DEFAULT_M_TYPE \
		 d:wn_シェル１中央棟Ｂ１


}



// 各proc設定
//-------------------------------------------------------------------------------------
// 全マップ共通

	// エレベーターのボタンを押したときの処理
	// ------------------------------------
	proc エレベータボタン押した終了 {
		#if d:DEBUG_PRINT
			print 'elevator_door_push'
		#endif

		//	開かない場合
		if ($$b:ドアフラグ[2] == d:DOOR_FLAG_CLOSE) {
			command パッド操作 -cancel
			chara カメラ設定 モーションカメラ \
				-s -1
			command ＳＥセットモード -s d:SD_S_BUZZER01 -p 0,0,0  -m 1
		//	開く場合
		} else {
			command パッド操作 -cancel
			chara カメラ設定 モーションカメラ \
				-s -1
			mesg エレベータ 中央棟エレベーター open -1 \
				エレベータードアオープン開始 エレベータードアオープン終了
		}
	}

	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT
			print 'localvar_init'
		#endif


		eval( $f:w24b_西側マップ接合禁止 = 0 );
		eval($f:w24bリフレッシュクリアリング中 = 0)

		if($w:p_story >= d:ST:P040_09_P05エイムズ発見９ポリゴンデモ５終了 && $w:p_story < d:ST:P041_02_R01エイムズ死亡後２無線デモ１開始){
			eval($w:アイテム数Ｒ[d:アイテム:カード] = 3);
			eval( $w:アイテム = d:アイテム:ゴル兵制服 )
		}

	}

	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT
			print 'status_set'
		#endif
	}

	// ポリデモ
	// ------------------------------------
	// ノード端末
	// ------------------------------------

	// スタート
	proc スタートカメラセット {
		#if d:DEBUG_PRINT
		print 'start_camera_set'
		#endif
	//	インテグラル
		if ( $s:登場ポイント != テイルズＡジェニファー遭遇紙芝居後から ) {
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p -3415,-1198,-64052 \
				-t -1013,-3594,-67408 \
				-a 162 \
				-i 0 -1 0 0 \
				-s 1
		}
	}

	proc スタートカメラオフ {
		#if d:DEBUG_PRINT
		print 'start_camera_off'
		#endif

	//	インテグラル
		chara カメラ設定 モーションカメラ \
			-s -1
	}

//###################################################################################
//								クリアリング設定
//###################################################################################

	proc 子画面設定 {
	#if d:SUB_CAMERA
		chara サブ画面 子画面 \
			-w (512-d:SUB_MARGIN-d:SUB_WIDTH),d:SUB_MARGIN (512-d:SUB_MARGIN),(d:SUB_HEIGHT+d:SUB_MARGIN)
	#endif
	}

	proc クリアリングカメラＯＦＦ {

	#if d:CLEAR_CAMERA
		#if d:SUB_CAMERA
			mesg サブ画面 子画面 off
		#endif
			chara カメラ設定 クリアリングカメラ \
				-s -1

	#endif

		mesg delay クリアリング自販機そばディレイ kill

		eval( $f:w24b_西側マップ接合禁止 = 0 );

		if($w:アラートモード != d:ALERT_MODE_KIKEN){
			eval($f:w24bリフレッシュクリアリング中 = 0)
		}

	}

	//クリアリングの前にみんな元気かを調べる
	proc みんな元気かチェック $:人数 {
		print 'health_check!!!!!!!!!!!!'
		print 'みんなー元気かー！！！？？？？？'
		print '今日のチェックは'$1'人！！！！！！'

		eval( $i:ローカル変数Ｉ１ = 0 );

		command foreach -argc 3 -repeat 6 \
			-data { \
				{1,$1,攻撃兵:01}
				{2,$1,攻撃兵:02}
				{3,$1,攻撃兵:03}
				{4,$1,いけす攻撃兵:04}
				{5,$1,いけす攻撃兵:05}
				{6,$1,いけす攻撃兵:06}
			} \
			-exec{ \
				command ゲット敵兵状態 $3 $i:敵兵状態
				if($1 <= $2){
					eval($i:ローカル変数Ｉ１ = ($i:ローカル変数Ｉ１ | $i:敵兵状態))
				}
			}

/*
		($i:敵兵状態 & 0x80106004) == 0

		0x00000004	//倒れ状態
		0x00002000	//捕まえられている
		0x00004000	//気絶中
		0x00100000	//起き上がり中
		0x80000000	//死亡

		のどれでもない。
*/
		if(($i:ローカル変数Ｉ１ & 0x00106004) != 0){
			print 'clear cancel!!!!!'
			print 'あらまほしけれ！！！だれか元気じゃないなーー！！！！！'
			command クリアリングキャンセル
		}else{
			print 'you all are healthy!!!!!!!!!!!!'
			print 'みいんなええ子や！！！！'
		}

	}

//###################################################################################
//							クリアリング（リフレッシュ）
//###################################################################################

	proc リフレッシュルームクリアリング初期設定 {

		print 'リフレッシュルームクリアリングスタート！！！'

		@みんな元気かチェック 3

		if(!$f:w24bリフレッシュクリアリング中){
			eval($f:w24bリフレッシュクリアリング中 = 1)

			command セットクリアリング \
				-p	0,0,0	クリアリングカメラ１リフレッシュ入口１ \
					0,0,1	クリアリングカメラ１リフレッシュ入口２ \
					0,1,2	クリアリングカメラ１ロッカー前 \
					0,0,8	クリアリングカメラ１横歩き \
					0,0,11	クリアリングカメラ１通路 \
					0,1,12	クリアリングカメラ１自販機そば \
				-i	0,1,11,2,12,13,14,15

		}else{	//強襲クリアリング

			//奥側
			if($i:プレイヤー位置Ｚ < -69500){
				command セットクリアリング \
					-p	0,0,0	クリアリングカメラ１通路 \
						0,9,3	クリアリングカメラ１自販機そば \
					-i	9,10,11,2,12,13,14,15

			//入口側
			}else{
				command セットクリアリング \
					-p	0,0,0	クリアリングカメラ１リフレッシュ入口１ \
						0,5,1	クリアリングカメラ１リフレッシュ入口２ \
						0,5,7	クリアリングカメラ１突入通路 \
						0,6,8	クリアリングカメラ１突入自販機そば \
					-i	5,6,11,2,12,13,14,15
			}

		}

	}

	proc クリアリングカメラ１リフレッシュ入口１ {

	#if d:CLEAR_CAMERA
print 'リフレッシュ入口１'

		eval( $f:w24b_西側マップ接合禁止 = 1 );
		mesg マップ接合 西側マップ接合 on

		command カメラマップ設定 \
			-chanl 1 \                // １が子画面
			-map シェル１中央棟Ｂ１

		chara カメラ設定 クリアリングカメラ \
			-c 1 \
			-p -10309,-501,-61656 \
			-t -8202,-3871,-66965 \
			-a 162 \
			-i 0 -1 0 0 \
			-s 1

