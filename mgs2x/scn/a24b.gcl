//###################################################################################
//									ロッカー設定
//###################################################################################


	proc ロッカー設置 {
		#if d:DEBUG_PRINT
			print 'w24b_locker_set'
		#endif

		chara ロッカー管理 管理人さん -n 6

		command ロッカーモーション -motion locker
		command プレイヤーロッカーモーション -motion sna_locker

		// 休憩室一番左
		command foreach -argc 1 -repeat 6 \
			-data { \
				{0},{1},{2},{3},{4},{5} \
			} \
			-exec{
				@壊れ物再セットチェック $b:w24b_破壊ロード回数[$1]
				if($f:再セットフラグ) {
					eval($i:w24b_ロッカー状態[$1] = 0)
				}
			}

		// 休憩室一番左
		chara ロッカー ロッカー:01 \
			-kms w24b1_locker_dr1 \
			-p -10050,-4500,-68750 \
			-r 0,0,0 \
			-s 0 \
			-seno    1 \	// 壁音番号
			-sefloor 4 \	// 倒れ時床音番号
			-flag d:LOCKER_STATE_CLOSE \
			-load_state $i:w24b_ロッカー状態[0] \
			-exec {
				@ロッカー再セットチェック処理 0 $4 $3
			}

		trap lk001 d:PLAYER \
			-and \
			-mask いる \
			-state d:TRP_STATE_STAND,d:TRP_STATE_CAUTION \
			-dir 2048,512 0,512 \
			-button d:ACTION_BUTTON,-1 \
			-exec {
				command ロッカー状態 -n ロッカー:01
				mesg プレイヤー d:PLAYER locker ロッカー:01 $status 2048,512 -10050,-68750
			}

		trap lk001 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_FORCE \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p -9523,419,-66466 \
					-t -10342,-2986,-68320 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3
			}

		// 休憩室左から２番目
		chara ロッカー ロッカー:02 \
			-kms w24b1_locker_dr1 \
			-p -9050,-4500,-68750 \
			-r 0,0,0 \
			-s 0 \
			-seno    1 \	// 壁音番号
			-sefloor 4 \	// 倒れ時床音番号
			-flag d:LOCKER_STATE_OPEN \
			-load_state $i:w24b_ロッカー状態[1] \
			-exec {
				@ロッカー再セットチェック処理 1 $4 $3
			}

		trap lk002 d:PLAYER \
			-and \
			-mask いる \
			-state d:TRP_STATE_STAND,d:TRP_STATE_CAUTION \
			-dir 2048,512 0,512 \
			-button d:ACTION_BUTTON,-1 \
			-exec {
				command ロッカー状態 -n ロッカー:02
				mesg プレイヤー d:PLAYER locker ロッカー:02 $status 2048,512 -9050,-68750
			}

		trap lk002 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_FORCE \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p -8814,237,-66449 \
					-t -9637,-3164,-68305 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3
			}

		// 休憩室右から２番目
		chara ロッカー ロッカー:03 \
			-kms w24b1_locker_dr1 \
			-p -8050,-4500,-68750 \
			-r 0,0,0 \
			-s 0 \
			-seno    1 \	// 壁音番号
			-sefloor 4 \	// 倒れ時床音番号
			-flag d:LOCKER_STATE_CLOSE \
			-load_state $i:w24b_ロッカー状態[2] \
			-exec {
				@ロッカー再セットチェック処理 2 $4 $3
			}

		trap lk003 d:PLAYER \
			-and \
			-mask いる \
			-state d:TRP_STATE_STAND,d:TRP_STATE_CAUTION \
			-dir 2048,512 0,512 \
			-button d:ACTION_BUTTON,-1 \
			-exec {
				command ロッカー状態 -n ロッカー:03
				mesg プレイヤー d:PLAYER locker ロッカー:03 $status 2048,512 -8050,-68750
			}

		trap lk003 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_FORCE \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p -7864,60,-66533 \
					-t -8662,-3380,-68326 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3
			}

		// 休憩室一番右
		chara ロッカー ロッカー:04 \
			-kms w24b1_locker_dr1 \
			-p -7050,-4500,-68750 \
			-r 0,0,0 \
			-s d:LOCKER_STATE_DESTROY \	//ここだけ開けたとき壁に接するかららしい。
			-seno    1 \	// 壁音番号
			-sefloor 4 \	// 倒れ時床音番号
			-flag d:LOCKER_STATE_CLOSE \
			-load_state $i:w24b_ロッカー状態[3] \
			-exec {
				@ロッカー再セットチェック処理 3 $4 $3
			}
		trap lk004 d:PLAYER \
			-and \
			-mask いる \
			-state d:TRP_STATE_STAND,d:TRP_STATE_CAUTION \
			-dir 2048,512 0,512 \
			-button d:ACTION_BUTTON,-1 \
			-exec {
				command ロッカー状態 -n ロッカー:04
				mesg プレイヤー d:PLAYER locker ロッカー:04 $status 2048,512 -7050,-68750
			}
		trap lk004 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_FORCE \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p -7152,-44,-66652 \
					-t -7955,-3480,-68449 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3
			}

		// ノード部屋左
		chara ロッカー ロッカー:05 \
			-kms w24b1_locker_dr2 \
			-p 5200,-4500,-73500 \
			-r 0,0,0 \
			-s 0 \
			-seno    1 \	// 壁音番号
			-sefloor 4 \	// 倒れ時床音番号
			-flag d:LOCKER_STATE_CLOSE \
			-load_state $i:w24b_ロッカー状態[4] \
			-exec {
				@ロッカー再セットチェック処理 4 $4 $3
			}
		trap lk005 d:PLAYER \
			-and \
			-mask いる \
			-state d:TRP_STATE_STAND,d:TRP_STATE_CAUTION \
			-dir 2048,512 0,512 \
			-button d:ACTION_BUTTON,-1 \
			-exec {
				command ロッカー状態 -n ロッカー:05
				mesg プレイヤー d:PLAYER locker ロッカー:05 $status 2048,512 5200,-73500
			}
		trap lk005 d:PLAYER \
			-mask ？ \
			-state 6 \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 5685,-364,-71250 \
					-t 4947,-2977,-73130 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3
			}

		// ノード部屋右
		chara ロッカー ロッカー:06 \
			-kms w24b1_locker_dr2 \
			-p 6200,-4500,-73500 \
			-r 0,0,0 \
			-s 0 \
			-down_rot 0,4000,0 \	//$v:倒れたときの角度 \
			-W 200,0,-200 \	//$v:倒れたときのシフト量
			-seno		1 \	// 壁音番号
			-sefloor	4 \	// 倒れ時床音番号
			-flag d:LOCKER_STATE_CLOSE \
			-load_state $i:w24b_ロッカー状態[5] \
			-exec {
				@ロッカー再セットチェック処理 5 ロッカー:06 $3
			}

		trap lk006 d:PLAYER \
			-and \
			-mask いる \
			-state d:TRP_STATE_STAND,d:TRP_STATE_CAUTION \
			-dir 2048,512 0,512 \
			-button d:ACTION_BUTTON,-1 \
			-exec {
				command ロッカー状態 -n ロッカー:06
				mesg プレイヤー d:PLAYER locker ロッカー:06 $status 2048,512 6200,-73500
			}

		trap lk006 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_FORCE \
			-camera \			//カメラトラップであることを明示
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 6820,-277,-71067 \
					-t 5947,-2885,-72892 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3
			}

	}

	proc ロッカー再セットチェック処理 $:ロッカー番号 $:ロッカー名 $:もひ {
		if(($3 != 6) && ($3 != 8)) {
			// 状態変化時
			eval($b:w24b_破壊ロード回数[$1] = $w:グローバルロード回数);
		} else if($3 == 8) {
			// ステージ終了時
			command ロッカー状態 -n $2
			eval($i:w24b_ロッカー状態[$1] = $status)
		}
	}

//###################################################################################
//									リフレッシュ草設置
//###################################################################################

	proc リフレッシュ草設置 {
		#if d:DEBUG_PRINT
			print 'リフレッシュ草設置'
			print 'grass_set'
		#endif

	/*
	w24b2
	樹木の座標

	ソファー側
	回転Y位置XYV
	1 Y-40 X-11375 Y-4405 Z-73137
	2 Y-65 X-11450 Y-4430 Z-72687
	3 Y-25 X-11375 Y-4455 Z-72250
	4 Y 65 X-11350 Y-4430 Z-71862
	5 Y  0 X-11375 Y-4480 Z-71262
	6 Y-45 X-11400 Y-4480 Z-70737
	自販機側
	*/

		chara プット植物オブジェ 揺れポプラ \
			-m tree_00 \
			-b tree_01 \
			-r 0 (4096*40/360) 0 \
			-p -11375,-4405,-73137 \
			-l d:LT2_NAME \
			-s 100 100 100 \
			-broken $f:w24b＿壊れフラグ＿ポプラ＿１ \
			-proc セット壊れフラグ＿ポプラ＿１

		chara プット植物オブジェ 揺れポプラ \
			-m tree_00 \
			-b tree_01 \
			-r 0 (4096*(-65)/360) 0 \
			-p -11450,-4430,-72678 \
			-l d:LT2_NAME \
			-s 100 100 100 \
			-broken $f:w24b＿壊れフラグ＿ポプラ＿２ \
			-proc セット壊れフラグ＿ポプラ＿２

		chara プット植物オブジェ 揺れポプラ \
			-m tree_00 \
			-b tree_01 \
			-r 0 (4096*(-25)/360) 0 \
			-p -11375,-4455,-72250 \
			-l d:LT2_NAME \
			-s 100 100 100 \
			-broken $f:w24b＿壊れフラグ＿ポプラ＿３ \
			-proc セット壊れフラグ＿ポプラ＿３

		chara プット植物オブジェ 揺れポプラ \
			-m tree_00 \
			-b tree_01 \
			-r 0 (4096*65/360) 0 \
			-p -11350,-4430,-71862 \
			-l d:LT2_NAME \
			-s 100 100 100 \
			-broken $f:w24b＿壊れフラグ＿ポプラ＿４ \
			-proc セット壊れフラグ＿ポプラ＿４

		chara プット植物オブジェ 揺れポプラ \
			-m tree_00 \
			-b tree_01 \
			-r 0 0 0 \
			-p -11375,-4480,-71262 \
			-l d:LT2_NAME \
			-s 100 100 100 \
			-broken $f:w24b＿壊れフラグ＿ポプラ＿５ \
			-proc セット壊れフラグ＿ポプラ＿５

		chara プット植物オブジェ 揺れポプラ \
			-m tree_00 \
			-b tree_01 \
			-r 0 (4096*(-45)/360) 0 \
			-p -11400,-4480,-70737 \
			-l d:LT2_NAME \
			-s 100 100 100 \
			-broken $f:w24b＿壊れフラグ＿ポプラ＿６ \
			-proc セット壊れフラグ＿ポプラ＿６

	}

	proc セット壊れフラグ＿ポプラ＿１ {
		eval( $f:w24b＿壊れフラグ＿ポプラ＿１ = 1 )
	}

	proc セット壊れフラグ＿ポプラ＿２ {
		eval( $f:w24b＿壊れフラグ＿ポプラ＿２ = 1 )
	}

	proc セット壊れフラグ＿ポプラ＿３ {
		eval( $f:w24b＿壊れフラグ＿ポプラ＿３ = 1 )
	}

	proc セット壊れフラグ＿ポプラ＿４ {
		eval( $f:w24b＿壊れフラグ＿ポプラ＿４ = 1 )
	}

	proc セット壊れフラグ＿ポプラ＿５ {
		eval( $f:w24b＿壊れフラグ＿ポプラ＿５ = 1 )
	}

	proc セット壊れフラグ＿ポプラ＿６ {
		eval( $f:w24b＿壊れフラグ＿ポプラ＿６ = 1 )
	}

//###################################################################################
//									ノード端末設定
//###################################################################################

	proc ノード接続時プロック {

	#if d:DEBUG_PRINT
		print 'node_set'
	#endif

	// 必ず必要。フラグの初期化はvarinit.hですでに行っています。
		eval($f:ノードフラグ = $f:w24b_ノードフラグ);
		eval($f:ノードフラグ = $f:w24c_ノードフラグ);
	}

	// 接続したフラグをたてたりする
	proc ノード接続後プロック {
	#if d:DEBUG_PRINT
		print 'node_event_go'
	#endif

		eval($f:w24b_ノードフラグ = 1);
		eval($f:w24c_ノードフラグ = 1);

		command メニュー設定 -node_access on

	// 接続後に何かイベントを起こしたい場合は以下に記入

	}

//###################################################################################
//									鏡面モデル設定
//###################################################################################

	proc 鏡面モデル設定 {

		print '鏡面モデル設定'

		chara 鏡面モデル管理 床面映り込み \
			-pos 0,-4500,0 \
			-axis 1 // Y軸反転

/*
		mesg 鏡面モデル管理 床面映り込み add d:PLAYER

		mesg 鏡面モデル管理 床面映り込み add 攻撃兵:01
		mesg 鏡面モデル管理 床面映り込み add 攻撃兵:02
		mesg 鏡面モデル管理 床面映り込み add 攻撃兵:03

		mesg 鏡面モデル管理 床面映り込み add いけす攻撃兵:04
		mesg 鏡面モデル管理 床面映り込み add いけす攻撃兵:05
		mesg 鏡面モデル管理 床面映り込み add いけす攻撃兵:06

		mesg 鏡面モデル管理 床面映り込み add センサー敵兵
*/

		//リフレッシュルーム鏡面モデル管理
		trap ev_mirror ？ \
			-mask ？ \
			-exec {
				if($2 != センサー敵兵 && $2 != おしつけられ警備兵 && $2 != おしつけられ攻撃兵){
					if($3 == 入る){
						mesg 鏡面モデル管理 床面映り込み add $2
					}else{
						mesg 鏡面モデル管理 床面映り込み del $2
					}
				}
			}

	}

//###################################################################################
//									カメラ設定
//###################################################################################

	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0
		chara カメラ サブカメラ１		-c 0 -l 2 -p 50
		chara カメラ サブカメラ２		-c 0 -l 2 -p 40
		chara カメラ サブカメラ３		-c 0 -l 2 -p 30
		chara カメラ モーションカメラ	-c 0 -l 2 -p 20
		chara カメラ ノードカメラ		-c 0 -l 1 -p 20
		chara カメラ クリアリングカメラ	-c 1 -l 2 -p 0

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 750,2048,0 \
			-f 6500 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}

	proc 廊下カメラ設定 {
		#if d:DEBUG_PRINT
			print 'w24b_camera_set'
		#endif

		// エレベーター内
		trap ca001 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ２ \
					-c 1 \
					-p -64,1156,-73855 \
					-t -64,-3504,-74954 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3
			}

		// エレベーター前
		trap ca002 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ１ \
					-c 0 \
					-b -2000,d:CAM_MIN,d:CAM_MIN 2500,5500,-70850 \
					-l -2000,d:CAM_MIN,-72150 2500,-3400,-72150 \
					-r 850,2048,0 \
					-f 5000 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3 \
					-slide 0 30 1000 1000 60 1
			}

		// 南北通路
		trap ca003 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {

				@CS_スムーズカメラ昇順 $6 -70500 -68000 -3000 -9400
				eval( $i:補完ＢＸ１ = $i:CS_結果１ );

				@CS_スムーズカメラ昇順 $6 -70500 -66000 -2600 -4292
				eval( $i:補完ＢＸ２ = $i:CS_結果１ );

				@CS_スムーズカメラ昇順 $6 -69000 -66000 150 357
				eval( $i:補完ＲＸ = $i:CS_結果１ );

				@CS_スムーズカメラ昇順 $6 -70500 -68000 7500 4775
				eval( $w:補完距離 = $i:CS_結果１ );

				@CS_スムーズカメラ昇順 $6 -70500 -66000 200 160
				eval( $w:補完画角 = $i:CS_結果１ );

				chara カメラ設定 サブカメラ１ \
					-c 0 \
					-b $i:補完ＢＸ１,-2500,d:CAM_MIN $i:補完ＢＸ２,-500,-61000 \
					-l $i:補完ＢＸ１,d:CAM_MIN,d:CAM_MIN $i:補完ＢＸ２,-3000,-65092 \
					-r $i:補完ＲＸ,2048,0 \
					-f $w:補完距離 \
					-a $w:補完画角 \
					-i 2 -1 0 0 \
					-s $3
			}

		// 休憩室前
		trap ca004 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {

				chara カメラ設定 サブカメラ１ \
					-c 0 \
					-b -9400,-300,d:CAM_MIN -4292,-300,-61000 \
					-l -9400,-2900,d:CAM_MIN -4292,-300,-65092 \
					-r 357,2048,0 \
					-f 4775 \
					-a 160 \
					-i 2 -1 0 0 \
					-s $3
					//-slide 0 10 500 500 60 0
			}

		// 休憩室前南側はりつき
		trap ca004 d:PLAYER \
			-mask ＊ \
			-camera \
			-dir 2048,256 \
			-state d:TRP_STATE_BEHINDCAMERA_ENABLE \
			-exec {

				if($4 < -10000){
					eval($i:補完ＰＸ = -10000)
				}else if($4 > -2800){
					eval($i:補完ＰＸ = -2800)
				}else{
					eval($i:補完ＰＸ = $4)
				}

				chara カメラ設定 サブカメラ２ \
					-c 1 \
					-p $i:補完ＰＸ,1208,-63569 \
					-t $i:補完ＰＸ,-1263,-64225 \
					-a 200 \
					-i 2 -1 0 0 \
					-s $3
			}

	}

	proc リフレッシュルームカメラ設定 {

		// 休憩室
		trap ca005 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {

				chara カメラ設定 サブカメラ１ \
					-c 0 \
					-b -8500,d:CAM_MIN,-70000 -7000,d:CAM_MAX,-66500 \
					-l -8500,d:CAM_MIN,d:CAM_MIN -7000,d:CAM_MAX,-67800 \
					-r 640,2048,0 \
					-f 6500 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3
			}

		// 休憩室ロッカーそば
		trap ca007 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				if($3 == いる && $w:アラートモード == d:ALERT_MODE_SENNYU){
					chara カメラ設定 サブカメラ２ \
						-c 1 \
						-p -8187,1222,-65972 \
						-t -8297,-3710,-70198 \
						-a 173 \
						-i 2 2 0 0 \
						-s $3
				}else{
					chara カメラ設定 サブカメラ２ \
						-s -1
				}
			}

	}

	proc ノード部屋カメラ設定 {
		// ノード部屋
		trap ca006 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ１ \
					-c 1 \
					-p 6166,2149,-70862 \
					-t 6169,-4005,-72688 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3
			}

		// イントルードそば
		trap ca008 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ２ \
					-c 1 \
					-p 7524,-1968,-70657 \
					-t 7526,-4000,-70956 \
					-a 200 \
					-i 2 2 0 0 \
					-s $3
			}

	}

//###################################################################################
//								西側マップ接合管理
//###################################################################################

	proc 西側マップ接合管理 {

		trap ev2000 d:PLAYER \
			-mask ？ \
			-A \		//マップ接合
			-exec {

				if($3 == 入る){
					mesg マップ接合 西側マップ接合 on
				}else{
					if(!$f:w24b_西側マップ接合禁止){
						mesg マップ接合 西側マップ接合 off
					}
				}
			}

	}

//###################################################################################
//								壊れ物設定
//###################################################################################
//壊れ物   added by T.Morita 2001.07.29
//中に「proc 壊れ物設定」存在しています。
//壊れ物は、雑誌 と 瓶 です。
#include "w24b_break.h"


// FIXデータはここまで
// -----------------------------------------------------------------------------------



//###################################################################################
//								網膜センサーロード設定
//###################################################################################

	//	強制終了
	proc 網膜センサー覗き込みデモ強制終了 {
		command 強制モーションキャンセル
	}


	//	終了処理
	proc 網膜センサー覗き込みデモ終了 {

		eval($f:網膜センサーロード中 = 0)

		mesg デモキャンセルチェック デモキャンセル kill

		mesg delay 網膜センサーデモディレイ kill
//		command 強制モーションキャンセル

		@シナリオデモ終了処理

	}

	//	デモ設定
	proc 網膜センサーロード設定 {

		#if d:DEBUG_PRINT
			print '網膜センサーロード設定'
			print 'eye_sensor'
		#endif

		eval($f:網膜センサーロード中 = 0)

		//ライデン覗き込み
		trap ev000 d:PLAYER \
			-mask 入る \
			-state d:TRP_STATE_STAND \
			-dir 1024,256 \
			-button d:ACTION_BUTTON \
			-exec {
				if ($w:アラートモード == d:ALERT_MODE_SENNYU && !$f:網膜センサーロード中) {

					@シナリオデモ開始処理
					mesg コマンダー 敵兵セット 視界オン

					chara デモキャンセルチェック デモキャンセル \
						-p 網膜センサー覗き込みデモ強制終了

					command 強制モーション終了プロック \
						-motion d:モーションリスト:rai_non_eye_sensor_self_w24b \
						-proc 網膜センサー覗き込みデモ終了

					mesg プレイヤー d:PLAYER motion \
						d:モーションリスト:rai_non_eye_sensor_self_w24b \
						1024 \
						-1 \
						0 \
						(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_WEAPON) \
						(-1400 - 600) -67500 (-4500 + 950)//x,z,yの順

					chara delay 網膜センサーデモディレイ \
						-time 300 \
						-exec {
							@網膜センサーＳＥ処理 0
						}

					chara delay 網膜センサーデモディレイ \
						-time 420 \
						-exec {
							print 'アナウンス「網膜パターンが一致しません」'
							eval( $i:STREAM_ID = `%Stream t:vc103802` );
						}

					chara delay 網膜センサーデモディレイ \
						-time 390 \
						-exec {
							mesg プットオブジェ 網膜センサーランプ赤 off
							chara delay 網膜センサーデモディレイ \
								-time 30 \
								-exec {
									mesg プットオブジェ 網膜センサーランプ赤 on
									chara delay 網膜センサーデモディレイ \
										-time 30 \
										-exec {
										mesg プットオブジェ 網膜センサーランプ赤 off
										chara delay 網膜センサーデモディレイ \
											-time 30 \
											-exec {
											mesg プットオブジェ 網膜センサーランプ赤 on
										}
									}
							}
						}

				}
			}



		//ライデン覗き込み発見されたら強制終了
		trap ev000 d:PLAYER \
			-mask いる \
			-state d:TRP_STATE_FORCE \
			-dir 1024,256 \
			-exec {

				if(!$f:網膜センサーロード中){
					command ゲットゲームステータス \
						$i:ゲームステータス

					if($i:ゲームステータス & 0x00000001){
					// 発見〜危険モードの間

						print 'キャンセル発動'

						@網膜センサー覗き込みデモ強制終了
					}
				}

			}

		trap ev000 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_FORCE \
			-dir 1024,256 \
			-exec {

				chara カメラ設定 サブカメラ３ \
					-c 1 \
					-p -2986,-347,-65770 \
					-t -1511,-3284,-67004 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3

			}

#ifdef JAPANESE
		eval( $w:ローカル変数Ｗ２ = 2048 );
#else
		if($w:ゲーム設定 <= d:LEVEL_EASY){
			eval( $w:ローカル変数Ｗ２ = 2048 );
		}else{
			eval( $w:ローカル変数Ｗ２ = 700 );
		}
#endif

		//押し付けられ処理
		trap ev000 d:PLAYER \
			-mask いる \
			-state d:TRP_STATE_STAND \
			-dir 1024,$w:ローカル変数Ｗ２ \
			-exec {

				if(!$f:網膜センサーロード中){
					command ゲット捕まえられ兵の本当の名前 $s:敵兵名

					if($s:敵兵名 == 攻撃兵:01 \
					|| $s:敵兵名 == 攻撃兵:02 \
					|| $s:敵兵名 == 攻撃兵:03 \
					|| $s:敵兵名 == いけす攻撃兵:04 \
					|| $s:敵兵名 == いけす攻撃兵:05 \
					|| $s:敵兵名 == いけす攻撃兵:06 \
					|| $s:敵兵名 == いけす攻撃兵:07 \
					|| $s:敵兵名 == いけす攻撃兵:08 \
					){
						if($s:敵兵名 != 0){
							command ゲット敵兵状態拡張版 \
								$s:敵兵名 $i:敵兵状態
/*
							状態
							0x00000004	// 首締められている
							0x00000008	// ひきづられている
*/
							if(($w:アラートモード == d:ALERT_MODE_SENNYU || $w:アラートモード == d:ALERT_MODE_TANSAKU) && ($i:敵兵状態 & 0x00000004)){
								print '敵兵つかまってドアオープン！！！！！！！！'
								@網膜センサーロード開始
							}
						}
					}
				}

			}

		//死体、眠り、気絶を持ってきたとき
		trap ev000 d:PLAYER \
			-mask 入る \
			-state d:TRP_STATE_ENEMY_PULL \
			-dir 1024,$w:ローカル変数Ｗ２ \
			-exec {
				command ＳＥセットモード -s d:SD_S_BUZZER01 -p -1500,-3000,-67500 -m 0	 //カードキーＮＧブザー1
			}

		chara プットモーションモデル おしつけられ警備兵 \
			-pos (-1400 - 1319),(-4500),(-67500 + 94) \
			-dir 1024 \
			-kms gbs_def \
			-mar gbs_sensor \
			-number  d:センサーモーションリスト:gbs_idle \ /*省略時０*/
//			-item	$s:装備モデル名 $i:関節番号 \ /*オブジェを付随*/
			-C 網膜センサーおしつけられ終了 \	//$p:終了時プロック
			-status	(d:PUT_MOT_WAIT | d:PUT_MOT_NO_INTERP | d:PUT_MOT_INVISIBLE | d:PUT_MOT_THERMAL)

		chara プットモーションモデル おしつけられ攻撃兵 \
			-pos (-1400 - 1319),(-4500),(-67500 + 94) \
			-dir 1024 \
			-kms gba_def_mt \
			-mar gbs_sensor \
			-number  d:センサーモーションリスト:gbs_idle \ /*省略時０*/
			//-item	$s:装備モデル名 $i:関節番号 \ /*オブジェを付随*/
			-C 網膜センサーおしつけられ終了 \	//$p:終了時プロック
			-status	(d:PUT_MOT_WAIT | d:PUT_MOT_NO_INTERP | d:PUT_MOT_INVISIBLE | d:PUT_MOT_THERMAL)

	}



	//	デモ本体
	proc 網膜センサーロード開始 {

		eval($f:網膜センサーロード中 = 1)

		@シナリオデモ開始処理

		chara delay 網膜センサーデモディレイ \
			-time 2 \
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p -2634,-1311,-67767 \
					-t -112,-5242,-66812 \
					-a 173 \
					-i 0 0 0 0 \
					-s 1
			}

		chara delay 網膜センサーデモディレイ \
			-time 53 \
			-exec {
				chara パッド振動 振動君 \
					-vibfile biometrix
			}

		//おしつけライデン
		mesg プレイヤー d:PLAYER motion \
			d:モーションリスト:rai_non_eye_sensor_gbs_w24b \
			1024 \
			-1 \
			0 \
			(d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_NO_WEAPON | d:FA_NO_INTERP) \
			(-1400 - 1065) (-67500 + 489) (-4500 + 950)//x,z,yの順

		chara delay 網膜センサーデモディレイ \
			-time 120 \
			-exec {
				chara カメラ設定 ノードカメラ \
					-c 1 \
					-p -3169,-1129,-68380 \
					-t -265,-4766,-67355 \
					-a 160 \
					-i 0 0 0 0 \
					-s 1

				chara カメラ設定 ノードカメラ \
					-c 1 \
					-p -3180,-1129,-66362 \
					-t -265,-4766,-67355 \
					-a 160 \
					-z d:CAMERA_INTERP_CAMERA \ //補完カメラフラグを指定。
					-interp_time 600 \ 			//補完時間を指定
					-s 1

				@網膜センサーＳＥ処理 1
			}

			chara delay 網膜センサーデモディレイ \
				-time 210 \
				-exec {
					print 'アナウンス「網膜パターンを照合しました。どうぞ、お入りください」'
					eval( $i:STREAM_ID = `%Stream t:vc103801` );
				}

/*
			//	アナザー用
			//	chara ドアの-exec内で処理
			chara delay 網膜センサーロードディレイ \
				-time 210 \
				-exec {
					mesg プットオブジェ 網膜センサーランプ赤 off
					mesg プットオブジェ 網膜センサーランプ青 on
				}
*/

			mesg 敵兵共通 攻撃兵 永久アンリアルＯＮ
			mesg 敵兵共通 いけす攻撃兵 永久アンリアルＯＮ

			//おしつけられ敵兵
			if($s:敵兵名 == 攻撃兵:01 || $s:敵兵名 == 攻撃兵:02 || $s:敵兵名 == 攻撃兵:03 ) {
				mesg プットモーションモデル おしつけられ警備兵 終了判定 \
					d:センサーモーションリスト:gbs_forced
			} else {
				mesg プットモーションモデル おしつけられ攻撃兵 終了判定 \
					d:センサーモーションリスト:gbs_forced
			}

	}



	//	終了処理
	proc 網膜センサーおしつけられ終了 {

		mesg ドア 人質部屋ドア open

		chara delay 網膜センサーロードディレイ \
			-time 240 \
			-exec {
				chara カメラ設定 ノードカメラ \
					-s -1

				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p -3267,-1076,-67573 \
					-t -2375,-2563,-67304 \
					-a 138 \
					-i 0 0 0 0 \
					-s 1

				mesg プレイヤー d:PLAYER position \
					-2000 -4000 -66250

				preseek 'a24c'
				@ステージ終了時処理（ステージ名表示） 0 -4500 -66250 1024 \
					mv_a24b_a24c_0 d:DEFAULT_M_TYPE d:wn_シェル１中央棟Ｂ１集会場
				//	アナザー
				@スタートカメラセット

		}

	}



	//	ＳＥ処理
	proc 網膜センサーＳＥ処理 $:可否 {

		eval($w:w24b_網膜センサーカウンタ = 0)

		command ＳＥセットモード -s d:se_code:SD_S_EYECHK01 -p -1500,-3000,-67500 -m 0	//網膜チェックスタート

		chara delay 網膜センサーデモディレイ \
			-time 20 \
			-arg $:可否 \
			-exec {
				if ($1 == 3) {
					eval( $w:ローカル変数Ｗ１ = 30 );
				} else {
					eval( $w:ローカル変数Ｗ１ = 50 );
				}

				if ($w:w24b_網膜センサーカウンタ <= $w:ローカル変数Ｗ１) {
					command ＳＥセットモード -s d:se_code:SD_S_EYESCN01 -p -1500,-3000,-67500 -m 0	//網膜チェックスタート
					eval($w:w24b_網膜センサーカウンタ = $w:w24b_網膜センサーカウンタ + 8)

					return 8

				} else {
					if ($1 == 1 || $1 == 3) {
					print '成功音'
						command ＳＥセットモード -s d:se_code:SD_S_EYEOK01 -p -1500,-3000,-67500 -m 0	//網膜チェック成功
					} else {
					print '失敗音'
						command ＳＥセットモード -s d:se_code:SD_S_EYENOT01 -p -1500,-3000,-67500 -m 0	//網膜チェック失敗
					}

					return 0

				}

			}

	}











// 以下仮キャラ用proc
