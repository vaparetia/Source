#define		DOOR_NAME			dr_free				//	共通
#define		DOOR_NAME_LOAD		dr_free				//	共通

#define		LT2_NAME			w24b



// キャラクター関係
#if d:RAIDEN
	#define		PLAYER		ライデン	// モーションができるまで名前はスネーク
#else
	#define		PLAYER		スネーク
#endif

// アナザー用
