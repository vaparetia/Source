	proc クリアリングカメラ１横歩き {

	#if d:CLEAR_CAMERA
print '横歩き'

		eval( $f:w24b_西側マップ接合禁止 = 0 );

		command カメラマップ設定 \
			-chanl 1 \                // １が子画面
			-map リフレッシュルーム


		chara delay クリアリング横歩きディレイ -time 1 -exec{

			command ゲット敵兵座標 攻撃兵:01 $i:敵兵Ｘ $i:敵兵Ｙ $i:敵兵Ｚ

			chara カメラ設定 クリアリングカメラ \
				-c 1 \
				-p $i:敵兵Ｘ,-2434,-65999 \
				-t $i:敵兵Ｘ,-4725,-72000 \
				-a 141 \
				-i 0 -1 0 0 \
				-s 1

			if($w:アラートモード == d:ALERT_MODE_KAIHI){
				return 1
			}else{
				return 0
			}

		}

		#if d:SUB_CAMERA
			mesg サブ画面 子画面 on
		#endif

	#endif
	}

	proc クリアリングカメラ１通路 {

	#if d:CLEAR_CAMERA
print '通路'

		mesg delay クリアリング横歩きディレイ kill


		command カメラマップ設定 \
			-chanl 1 \                // １が子画面
			-map リフレッシュルーム


		eval($w:補完画角 = 75)

		chara delay クリアリング通路ディレイ -time 1 -exec{

			if($w:補完画角 < 377 && $w:アラートモード == d:ALERT_MODE_KAIHI){
				eval($w:補完画角 = $w:補完画角 + 1)

				chara カメラ設定 クリアリングカメラ \
					-c 1 \
					-p -5160,-1557,-74262 \
					-t -5417,-4054,-68059 \
					-a $w:補完画角 \
					-i 0 -1 0 0 \
					-s 1

				return 1

			}else{
				return 0
			}

		}

		#if d:SUB_CAMERA
			mesg サブ画面 子画面 on
		#endif

	#endif
	}

