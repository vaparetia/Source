	proc 強制ドアクローズ終了_1Fへ {
		#if d:DEBUG_PRINT
			print 'w24b_load_go'
		#endif

		if( $f:ロードチェックＯＮフラグ == 1 ) {
		// シェル１中央棟１Ｆへ
			preseek 'a24a'
			@ステージ終了時処理（ステージ名表示） 0 0 0 0 mv_a24b_a24a_0 d:NO_MOVE_M_TYPE d:wn_シェル１中央棟１Ｆ
		}
	}

	proc 強制ドアクローズ終了_B2へ {
		#if d:DEBUG_PRINT
			print 'w24b_load_go'
		#endif

		if( $f:ロードチェックＯＮフラグ == 1 ) {
