//###################################################################################
//								ロッカー調査ドッキリ
//###################################################################################


#define	右ロッカー調査	4
#define	左ロッカー調査	5
#define	ボケ兵待機		6
#define	ボケ兵突入		7

	proc クリアリング分岐ロッカー調査 {

		command ロッカー状態 -n ロッカー:05
		if( ($status & d:LOCKER_STATE_CLOSE) && !($status & d:LOCKER_STATE_BROKEN) ) {
			command ロッカー状態 -n ロッカー:06
			if( ($status & d:LOCKER_STATE_CLOSE) && !($status & d:LOCKER_STATE_BROKEN) ) {

				if(`%プレイヤー状態取得` & d:PFLAG_LOCKER){

					if($i:プレイヤー位置Ｘ < 5250){

						print 'ロッカー右調査！！'

						@みんな元気かチェック 3

						command チェンジクリアリングルート \
							攻撃兵:02 -r d:右ロッカー調査 -p 0

						command チェンジクリアリングルート \
							攻撃兵:03 -r d:ボケ兵突入 -p 0
					}

				}

			}

		}

	}

