//爆弾評価 時間、ゲームオーバー回数から判定 h //e
//時間掛かり過ぎ h //e
resource PP_爆弾評価＿時間超過__s {
//vox t:vc200291 {
ピーター_000: {
Est&'as tardando mucho.
Tienes que hacerlo m&'as r&'apido.
}
//	<<<ENGLISH>>>
//	You're taking too much time.
//	You should work a little faster.

/*時間が掛かりすぎだな。
もう少し、急いだ方がいい。
*/
スネーク_001: {
No tenemos tiempo Raiden. A m&'i todav&'ia
me queda trabajo aqu&'i, as&'i que no voy a
poder ayudarte.
}
//	<<<ENGLISH>>>
//	There's no time, Raiden. I've got
//	my hands full here, so it doesn't
//	look like I can help you.
//<ページ数変更>
スネーク_001_1: {
Lo dejo en tus manos.
}
//	<<<ENGLISH>>>
//	It's in your hands.

/*ライデン、時間がない。
こっちも手いっぱいだ。
お前の手伝いは出来そうにない。頼むぞ。
*/
//dv}//v
}//d

