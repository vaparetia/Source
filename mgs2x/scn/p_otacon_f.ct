//スネークが死ぬと一緒にゲームオーバー h //e
//resource PO_スネーク死んだら終わり
proc rp_PO_スネーク死んだら終わり:02  {
vox t:vc240221 {
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		 [PO_スネーク死んだら終わり__f:オタコン_000]
		//スネークのＬＩＦＥが君のＬＩＦＥ
		//ゲージの下に表示されている。
		//一連托生だ、いいね。
	}
	talk オタコン 標準 -m {
		 [PO_スネーク死んだら終わり__f:オタコン_001]
		//大丈夫だとは思うけど、スネークが
		//危なくなったら援護してやってくれ。
		//頼むよ！
	}
	talk オタコン 標準 -m {
		 [PO_スネーク死んだら終わり__f:オタコン_001_1]
		//大丈夫だとは思うけど、スネークが
		//危なくなったら援護してやってくれ。
		//頼むよ！
	}
}//v
}//d


