	talk オタコン 標準 -m {
		 [PO_ソリダス戦＿マッスルスーツうんちく１__f:オタコン_001_1]
		//ＲＡＹの駆動系や天狗兵の装備と
		//同種のテクノロジーだ。君のスカル
		//スーツにも一部流用されている。
	}
	talk オタコン 標準 -m {
		 [PO_ソリダス戦＿マッスルスーツうんちく１__f:オタコン_002]
		//強化服の表面と内部にはいくつもの
		//センサーが神経のように張り巡らされて
		//いるんだ。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk オタコン 標準 -m {
		 [PO_ソリダス戦＿マッスルスーツうんちく１__f:オタコン_003]
		//センサーが衝撃を検知すると瞬時に
		//人工筋肉が収縮し、ダメージを
		//拡散させる反射運動をとる。
	}
	talk オタコン 標準 -m {
		 [PO_ソリダス戦＿マッスルスーツうんちく１__f:オタコン_003_1]
		//センサーが衝撃を検知すると瞬時に
		//人工筋肉が収縮し、ダメージを
		//拡散させる反射運動をとる。
	}
	talk オタコン 標準 -m {
		 [PO_ソリダス戦＿マッスルスーツうんちく１__f:オタコン_004]
		//だから刀でも簡単に真っ二つってわけ
		//にはいかない。この技術も君のスカル
		//スーツに流用されてる。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk オタコン 標準 -m {
		 [PO_ソリダス戦＿マッスルスーツうんちく１__f:オタコン_005]
		//つまりソリダスの強化服、君のスカル
		//スーツ、メタルギアＲＡＹは兄弟みたい
		//なものだってことだ……。
	}
}//v
