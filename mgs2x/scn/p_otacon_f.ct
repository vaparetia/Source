//天狗兵装備 Ｐ９０ h //e
//resource PO_天狗兵＿Ｐ９０１
proc rp_PO_天狗兵＿Ｐ９０１:02  {
vox t:vc240571 {
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		 [PO_天狗兵＿Ｐ９０１__f:オタコン_000]
		//奴等が持ってる銃はＰ９０。パーソナル
		//・ディフェンス・ウェポンと呼ばれる、
		//ライフルと拳銃の中間に位置する兵器だ。
	}
	talk オタコン 標準 -m {
		 [PO_天狗兵＿Ｐ９０１__f:オタコン_000_1]
		//奴等が持ってる銃はＰ９０。パーソナル
		//・ディフェンス・ウェポンと呼ばれる、
		//ライフルと拳銃の中間に位置する兵器だ。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk オタコン 標準 -m {
		 [PO_天狗兵＿Ｐ９０１__f:オタコン_001]
		//Ｐ９０は拳弾の扱いやすさとライフルの
		//貫通力を持った兵器と弾薬のセットと
		//して開発されたものだ。
	}
	talk オタコン 標準 -m {
		 [PO_天狗兵＿Ｐ９０１__f:オタコン_001_1]
		//Ｐ９０は拳弾の扱いやすさとライフルの
		//貫通力を持った兵器と弾薬のセットと
		//して開発されたものだ。
	}
	talk オタコン 標準 -m {
		 [PO_天狗兵＿Ｐ９０１__f:オタコン_002]
		//弾薬は新設計の５．７ｍｍＸ２８弾を
		//使用している。
	}
	talk オタコン 標準 -m {
		 [PO_天狗兵＿Ｐ９０１__f:オタコン_003]
		//毎秒７１５ｍという高い銃口初速を
		//持ちながら弾体重量は２．０２ｇと軽い
		//から反動は拳銃並みに小さいんだ。
	}
	talk オタコン 標準 -m {
		 [PO_天狗兵＿Ｐ９０１__f:オタコン_003_1]
		//毎秒７１５ｍという高い銃口初速を
		//持ちながら弾体重量は２．０２ｇと軽い
		//から反動は拳銃並みに小さいんだ。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk オタコン 標準 -m {
		 [PO_天狗兵＿Ｐ９０１__f:オタコン_004]
		//貫通力も高い。１００ｍ離れていても
		//普通の防弾衣なら簡単に射抜くよ。
	}
	talk オタコン 標準 -m {
		 [PO_天狗兵＿Ｐ９０１__f:オタコン_004_1]
		//貫通力も高い。１００ｍ離れていても
		//普通の防弾衣なら簡単に射抜くよ。
	}
	talk オタコン 標準 -m {
		 [PO_天狗兵＿Ｐ９０１__f:オタコン_005]
		//本体は全体がプラスティックで出来て
		//いて、左利きの人でも問題なく使える
		//ように左右対称の作りになっている。
	}
	talk オタコン 標準 -m {
		 [PO_天狗兵＿Ｐ９０１__f:オタコン_005_1]
		//本体は全体がプラスティックで出来て
		//いて、左利きの人でも問題なく使える
		//ように左右対称の作りになっている。
	}
	talk オタコン 標準 -m {
		 [PO_天狗兵＿Ｐ９０１__f:オタコン_006]
		//装弾数は５０発。マガジンは銃の上部に
		//セットされるから伏せ射撃の時も邪魔に
		//ならない。
	}
	talk オタコン 標準 -m {
		 [PO_天狗兵＿Ｐ９０１__f:オタコン_006_1]
		//装弾数は５０発。マガジンは銃の上部に
		//セットされるから伏せ射撃の時も邪魔に
		//ならない。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk オタコン 標準 -m {
		 [PO_天狗兵＿Ｐ９０１__f:オタコン_007]
		//とにかくその連射性能と精度は脅威だ。
		//まともに撃ち合ったりしない方が
		//いいだろうね。
	}
	talk オタコン 標準 -m {
		 [PO_天狗兵＿Ｐ９０１__f:オタコン_007_1]
		//とにかくその連射性能と精度は脅威だ。
		//まともに撃ち合ったりしない方が
		//いいだろうね。
	}
}//v
}//d
