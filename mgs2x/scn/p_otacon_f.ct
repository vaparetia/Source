//裸注意 h //e
//resource PO_裸注意＿操作制限１
proc rp_PO_裸注意＿操作制限１:02  {
vox t:vc240111 {
	talk オタコン 標準 -m {
		 [PO_裸注意＿操作制限１__f:オタコン_000]
		//ライデン、早くスネークと合流して
		//装備をもらった方がいい。
	}
	talk オタコン 標準 -m {
		 [PO_裸注意＿操作制限１__f:オタコン_001]
		//その格好じゃ首絞めもキックも
		//エルードも投げも出来ないだろ？
	}
}//v
}//d

//風邪状態 h //e
//resource PO_裸注意＿風邪１
proc rp_PO_裸注意＿風邪１:02  {
vox t:vc240121 {
	talk オタコン 標準 -m {
		 [PO_裸注意＿風邪１__f:オタコン_000]
		//ライデン、ひょっとして風邪でも
		//ひいてるんじゃないか？
	}
	talk ライデン 標準 -m {
		 [PO_裸注意＿風邪１__f:ライデン_001]
		//いや、そんなことは……ハックション！
	}
	talk オタコン 標準 -m {
		 [PO_裸注意＿風邪１__f:オタコン_002]
		//やっぱり。そんな格好してるからだよ。
	}
	talk ライデン 標準 -m {
		 [PO_裸注意＿風邪１__f:ライデン_003]
		//俺だって好きでしてるわけじゃ……
		//ハックション！
	}
	talk オタコン 標準 -m {
		 [PO_裸注意＿風邪１__f:オタコン_004]
		//お大事に。
	}
}//v
}//d
//二回目以降 t //e
//resource PO_裸注意＿風邪２
proc rp_PO_裸注意＿風邪２:02  {
vox t:vc240131 {
	talk オタコン 標準 -m {
		 [PO_裸注意＿風邪２__f:オタコン_000]
		//風邪は何とかした方がいいね。
		//そうひっきりなしにクシャミしてたんじゃ
		//敵に見つかってしまう。
	}
	talk オタコン 標準 -m {
		 [PO_裸注意＿風邪２__f:オタコン_000_1]
		//風邪は何とかした方がいいね。
		//そうひっきりなしにクシャミしてたんじゃ
		//敵に見つかってしまう。
	}
	talk オタコン 標準 -m {
		 [PO_裸注意＿風邪２__f:オタコン_001]
		//風邪薬を飲めば何とかなるだろう。
		//とりあえず何か羽織るのもいいかもね。
	}
}//v
}//d

