//resource PO_量産型ＲＡＹうんちく１
proc rp_PO_量産型ＲＡＹうんちく１:02  {
vox t:vc240551 {
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		 [PO_量産型ＲＡＹうんちく１__f:オタコン_000]
		//メタルギアＲＡＹは元々、海兵隊主導で
		//対メタルギア用兵器として設計された
		//ものだった。
	}
	talk オタコン 標準 -m {
		 [PO_量産型ＲＡＹうんちく１__f:オタコン_000_1]
		//メタルギアＲＡＹは元々、海兵隊主導で
		//対メタルギア用兵器として設計された
		//ものだった。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk オタコン 標準 -m {
		 [PO_量産型ＲＡＹうんちく１__f:オタコン_001]
		//でも量産型はその基本設計だけを
		//流用してアーセナルギア護衛用に
		//再設計されたものなんだそうだ。
	}
	talk オタコン 標準 -m {
		 [PO_量産型ＲＡＹうんちく１__f:オタコン_001_1]
		//でも量産型はその基本設計だけを
		//流用してアーセナルギア護衛用に
		//再設計されたものなんだそうだ。
	}
	talk オタコン 標準 -m {
		 [PO_量産型ＲＡＹうんちく１__f:オタコン_002]
		//メタルギアを守るためのメタルギア……。
		//エマが教えてくれた。
	}
	talk オタコン 標準 -m {
		 [PO_量産型ＲＡＹうんちく１__f:オタコン_003]
		//量産型メタルギアＲＡＹは基幹制御
		//システムに『Ｇ．Ｗ』をおいた高度な
		//共同交戦能力を持っているらしい。
	}
	talk オタコン 標準 -m {
		 [PO_量産型ＲＡＹうんちく１__f:オタコン_003_1]
		//量産型メタルギアＲＡＹは基幹制御
		//システムに『Ｇ．Ｗ』をおいた高度な
		//共同交戦能力を持っているらしい。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk オタコン 標準 -m {
		 [PO_量産型ＲＡＹうんちく１__f:オタコン_004]
		//複数のＲＡＹとアーセナルギアが、
		//相互に通信しあってデータを完全に
		//共有するんだ。
	}
	talk オタコン 標準 -m {
		 [PO_量産型ＲＡＹうんちく１__f:オタコン_005]
		//全てのＲＡＹが統一された思考の下に
		//脅威目標に対する探知、追尾、迎撃を
		//有機的に連携して行う。
	}
	talk オタコン 標準 -m {
		 [PO_量産型ＲＡＹうんちく１__f:オタコン_005_1]
		//全てのＲＡＹが統一された思考の下に
		//脅威目標に対する探知、追尾、迎撃を
		//有機的に連携して行う。
	}
	talk オタコン 標準 -m {
		 [PO_量産型ＲＡＹうんちく１__f:オタコン_006]
		//個にして全、全にして個、ってわけだ。
		//死角はない。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk オタコン 標準 -m {
		 [PO_量産型ＲＡＹうんちく１__f:オタコン_007]
		//ＲＡＹの群れに守られることで
		//アーセナルギアは巡洋艦や駆逐艦の護衛
		//なしで単独行動出来るようになるんだ。
	}
}//v
}//d

