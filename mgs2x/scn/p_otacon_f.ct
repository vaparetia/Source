//場所依存会話 d //e
//XBOXとPSX2で切り替えるべき音声コード
#include "vcvx.h"

//拷問部屋 d //e
//開かない扉 h //e
//resource PO_拷問部屋＿開かない扉
proc rp_PO_拷問部屋＿開かない扉:02  {
vox t:vc240011 {
	talk オタコン 標準 -m {
		 [PO_拷問部屋＿開かない扉__f:オタコン_000]
		//ライデン、そこの扉は開きそうもない。
		//早くスネークと合流するんだ。
	}
}//v
}//d

//回避モード状態 h //e
//resource PO_拷問部屋＿回避モード状態
proc rp_PO_拷問部屋＿回避モード状態:02  {
vox t:vc240021 {
	talk オタコン 標準 -m {
		 [PO_拷問部屋＿回避モード状態__f:オタコン_000]
		//ライデン、まずい。
		//早くどこかに隠れないと。
	}
	talk オタコン 標準 -m {
		 [PO_拷問部屋＿回避モード状態__f:オタコン_001]
		//と言っても隠れる場所が……
		//そうだ、まだ捕まってる振りをするって
		//いうのはどうだい？
	}
}//v
}//d

//前作やってる人 h //e
//resource PO_拷問部屋＿前作
proc rp_PO_拷問部屋＿前作:02  {
vox t:vc240031 {
	talk オタコン 標準 -m {
		 [PO_拷問部屋＿前作__f:オタコン_000]
		//ずいぶん懐かしい感じだな……。
		//ステルス迷彩があれば助けに行きたい
		//ところだよ。
	}
}//v
}//d



//天狗通路Ａ d //e

//天狗兵の説明 h //e
//resource PO_天狗通路＿天狗兵１
proc rp_PO_天狗通路＿天狗兵１:02  {
vox t:vc240041 {
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		 [PO_天狗通路＿天狗兵１__f:オタコン_000]
		//ライデン、気をつけるんだ。
		//そこの兵士は特殊兵装を身につけている。
	}
	talk ライデン 標準 -m {
		 [PO_天狗通路＿天狗兵１__f:ライデン_001]
		//ああ。これが例の天狗部隊とかいう
		//奴等か。
	}
}//v
}//d
//resource PC_天狗通路＿天狗兵＿刀１
proc rp_PC_天狗通路＿天狗兵＿刀１:02  {
vox t:vc240051 {
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		 [PC_天狗通路＿天狗兵＿刀１__f:オタコン_000]
		//刀を装備している天狗は銃弾を弾く。
		//こっちも刀で対抗するんだ。
		//練習は充分だろう？
	}
	talk オタコン 標準 -m {
		 [PC_天狗通路＿天狗兵＿刀１__f:オタコン_000_1]
		//刀を装備している天狗は銃弾を弾く。
		//こっちも刀で対抗するんだ。
		//練習は充分だろう？
	}
}//v
}//d
//resource PC_天狗通路＿天狗兵＿刀２
proc rp_PC_天狗通路＿天狗兵＿刀２:02  {
vox t:vc240061 {
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		 [PC_天狗通路＿天狗兵＿刀２__f:オタコン_000]
		//刀で銃弾を弾くと言っても、さすがに
		//足元は防御出来ないはずだ。銃を使う
		//なら主観攻撃で足元を狙うといい。
	}
	talk オタコン 標準 -m {
		 [PC_天狗通路＿天狗兵＿刀２__f:オタコン_000_1]
		//刀で銃弾を弾くと言っても、さすがに
		//足元は防御出来ないはずだ。銃を使う
		//なら主観攻撃で足元を狙うといい。
	}
	talk オタコン 標準 -m {
		 [PC_天狗通路＿天狗兵＿刀２__f:オタコン_000_2]
		//刀で銃弾を弾くと言っても、さすがに
		//足元は防御出来ないはずだ。銃を使う
		//なら主観攻撃で足元を狙うといい。
	}
}//v
}//d

