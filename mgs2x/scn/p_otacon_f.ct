//ＲＡＹの駆動系について h //e
//resource PO_メタル戦＿人工筋肉
proc rp_PO_メタル戦＿人工筋肉:02  {
vox t:vc240651 {
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		 [PO_メタル戦＿人工筋肉__f:オタコン_000]
		//メタルギアＲＡＹは駆動系に人工筋肉を
		//導入しているみたいだね。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk オタコン 標準 -m {
		 [PO_メタル戦＿人工筋肉__f:オタコン_001]
		//人工筋肉は電気活性のある
		//高分子繊維を使って生物の筋肉を
		//模したアクチュエーターだ。
	}
	talk オタコン 標準 -m {
		 [PO_メタル戦＿人工筋肉__f:オタコン_001_1]
		//人工筋肉は電気活性のある
		//高分子繊維を使って生物の筋肉を
		//模したアクチュエーターだ。
	}
	talk オタコン 標準 -m {
		 [PO_メタル戦＿人工筋肉__f:オタコン_002]
		//機械式アクチュエーターや
		//油圧式駆動機構と違って一種類の
		//駆動系でいくつもの動きが可能になる。
	}
	talk オタコン 標準 -m {
		 [PO_メタル戦＿人工筋肉__f:オタコン_002_1]
		//機械式アクチュエーターや
		//油圧式駆動機構と違って一種類の
		//駆動系でいくつもの動きが可能になる。
	}
	talk オタコン 標準 -m {
		 [PO_メタル戦＿人工筋肉__f:オタコン_002_2]
		//機械式アクチュエーターや
		//油圧式駆動機構と違って一種類の
		//駆動系でいくつもの動きが可能になる。
	}
	talk オタコン 標準 -m {
		 [PO_メタル戦＿人工筋肉__f:オタコン_003]
		//つまり迅速で複雑な動きを、
		//単純な機構でなめらかに実現出来るって
		//ことだ。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk オタコン 標準 -m {
		 [PO_メタル戦＿人工筋肉__f:オタコン_004]
		//ＲＡＹの動きは素早くて的確だよ。
		//気をつけるんだ。
	}
}//v
}//d

//ＲＡＹの装甲について h //e
//resource PO_メタル戦＿装甲
proc rp_PO_メタル戦＿装甲:02  {
vox t:vc240661 {
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk オタコン 標準 -m {
		 [PO_メタル戦＿装甲__f:オタコン_000]
		//ＲＡＹの装甲は最新式のセラミック・
		//チタン系複合装甲だ。
	}
	talk オタコン 標準 -m {
		 [PO_メタル戦＿装甲__f:オタコン_001]
		//装甲表面と内部に伝導性ナノチューブ
		//などの単純なセンサー群が張り巡らされ
		//ている。
	}
	talk オタコン 標準 -m {
		 [PO_メタル戦＿装甲__f:オタコン_001_1]
		//装甲表面と内部に伝導性ナノチューブ
		//などの単純なセンサー群が張り巡らされ
		//ている。
	}
	talk オタコン 標準 -m {
		 [PO_メタル戦＿装甲__f:オタコン_002]
		//装甲の状態に変化があると各部の
		//自己診断システムがそれを検知して
		//自律神経系的に対処を行うシステムだ。
	}
	talk オタコン 標準 -m {
		 [PO_メタル戦＿装甲__f:オタコン_002_1]
		//装甲の状態に変化があると各部の
		//自己診断システムがそれを検知して
		//自律神経系的に対処を行うシステムだ。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk オタコン 標準 -m {
		 [PO_メタル戦＿装甲__f:オタコン_003]
		//区画閉鎖や予備回路への切り替え等の
		//ダメージ・コントロールも反射的に
		//行われる。
	}
	talk オタコン 標準 -m {
		 [PO_メタル戦＿装甲__f:オタコン_003_1]
		//区画閉鎖や予備回路への切り替え等の
		//ダメージ・コントロールも反射的に
		//行われる。
	}
	talk オタコン 標準 -m {
		 [PO_メタル戦＿装甲__f:オタコン_004]
		//同時に「傷口」近くの「分泌孔」から
		//ナノペースト素材が自律的に分泌されて、
		//ある程度の自己補修も行われるらしい。
	}
	talk オタコン 標準 -m {
		 [PO_メタル戦＿装甲__f:オタコン_004_1]
		//同時に「傷口」近くの「分泌孔」から
		//ナノペースト素材が自律的に分泌されて、
		//ある程度の自己補修も行われるらしい。
	}
	talk オタコン 標準 -m {
		 [PO_メタル戦＿装甲__f:オタコン_005]
		//ＲＡＹが血を流すように見えるのは
		//そのナノペーストだ。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk オタコン 標準 -m {
		 [PO_メタル戦＿装甲__f:オタコン_006]
		//君の持ってる火器でまともに装甲を
		//貫くことは出来ないだろう。装甲の
		//手薄な頭部を狙うしかない。
	}
	talk オタコン 標準 -m {
		 [PO_メタル戦＿装甲__f:オタコン_006_1]
		//君の持ってる火器でまともに装甲を
		//貫くことは出来ないだろう。装甲の
		//手薄な頭部を狙うしかない。
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk オタコン 標準 -m {
		 [PO_メタル戦＿装甲__f:オタコン_007]
		//スティンガーで頭を狙うんだ。
	}
}//v
}//d

