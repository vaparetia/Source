// 各gclで必要なdefine
// ------------------------------------
// モード
#define		STAGE_PLANT		1		// 共通プロック切り分け用
// ステージ名
#define		STAGE_W31D		1		// 共通プロック切り分け用
// 敵兵、ＮＰＣ状況（薬莢を呼び分けるのに必要）
#define		ENE_P_GOL		1		// 都市迷彩ゴル兵
#define		GUN_MECA		1 		// ガンカメ ガンサイファー 
//#define		ENE_SHOT		1		// ショットガン兵
//#define		ENE_HIGT_TECH	1		// ハイテク兵
#define		ENE_SHIELD		1		// 盾兵


// 各種スイッチ用define
// ------------------------------------
// サウンド
#define		SOUND			1		// サウンドデータは最初に呼ぶ
#define		BGM				1		// BGMは敵兵コマンダーの後に呼ぶ
// デモ
// ノード端末
#define		NODE			1		// ノードcharaを使用するのに必要
// キャラクター関係
#define		RAIDEN			1		// SNAKEとは排他
#define		SNAKE			0
#define		ENEMY			1		// コマンダーと警備兵(敵を出すときは必須)
#define		SUPPORT			0		// サポート兵
#define		ATTACKER		1		// 攻撃兵
#define		SHIELD			0		// 盾兵(1) or 通常攻撃兵(0)
// エマ関係
#define		WITH_EMMA		1		// エマと一緒のロード処理をするのに必要
#define		EMMA_STAGE		w31d	// エマと一緒のロード処理をするのに必要
#define		EMMA_GEOVER_CAMERA	1	// エマのゲームオーバー時のカメラ
// 監視カメラ関係
#define		GUN_CAMERA		1		// ガンカメラ
// ドア
#define		SLIDE_DOOR		1		// スライドドア
// エレベーター
#define		ELEVATOR_SET	1		// エレベーター設置を有効にする
#define		ELEVATOR_Y		0		// エレベーターをＹ軸にいくつずらすか
#define		ELEVATOR_Z		-180250	// エレベーターをＺ軸にいくつずらすか
#define		ELV_1F			1		// ステージの階数を定義
#define		SHELL			1		// シェル２は１で定義
// 入出トラップ
#define		LOAD_TRAP		1
#define		STAGE_END		1		// ステージ終了時処理を使用可にする
// フォグ
#define		FOG				1
// 子画面
#define		SUB_CAMERA		1
// カメラ関係
#define		START_CAMERA	1		// ステージ開始時のカメラ
#define		CLEAR_CAMERA	1		// クリアリング専用カメラ(要子画面)

// 天井
#define		CHARA_CEIL		1		// 天井君
// 透明壁
#define		TR_WALL			0		// シナリオ置きの透明壁
// ライト関係
#define		CHARA_LIGHT		1		// キャラ専用ライト
// アイテム
#define		ITEM			1
// 強制モーション
#define		JP_MOTION		1		// ジャンプモーション

// デバッグ関係
#ifdef	d:FIX_MODE
	#define		DEBUG_CHARA		0		// デバッグキャラ全体(FIX時は0)
#else
	#define		DEBUG_CHARA		0		// デバッグキャラ全体
#endif
#define		CHARA_CAMERA	0		// キャラ追従カメラ
#define		TARGET_CHARA	敵兵:01	// キャラ追従カメラのターゲット
#define		SCREENSHOT		0		// スクリーンショット
#define		USB_KEY			0		// USBキーボード


// 各種設定用define
// ------------------------------------
// マップ関係
#define		HZX_NAME			w31a
#define		KMS_NAME0			w31a0
#define		KMS_NAME1			elv_2
#define		KMS_NAME2			w31a_pipe
#define		KMS_NAME3			w31a_25d
#define		KMS_NAME4			w31a1
#define		PANEL_KMS_NAME0		aw31a_panel0
#define		PANEL_KMS_NAME1		aw31a_panel1
#define		CEIL_NAME0			w31ar
#define		CEIL_NAME1			elv_2r
#define		WALL_NAME0			w31a_wall01
#define		DOOR_NAME			dr_free
#define		DOOR_NAME_LOAD		w31a_dr00		// ロード用
#define		LT2_NAME			w31a


// キャラクター関係
#if d:RAIDEN
	#define		PLAYER		ライデン	// モーションができるまで名前はスネーク
#else
	#define		PLAYER		スネーク
#endif

// 敵兵ルート番号
#define		攻撃兵待機ルート			5
#define		休憩室ルート				6
#define		ＨＩ連絡橋ルート			7
#define		南通路ルート１				8
#define		南通路ルート２				9
#define		休憩室ルートＨＤ			10
#define		南通路ルート２ＨＤ			11
#define		イベント１ルート待機		12
#define		イベント１ルート巡回		13
#define		イベント２ルート待機		14
#define		イベント２ルート巡回		15
#define		ＨＩ側通路ルートＥＸ		16
#define		ＨＩ側通路ルート２ＥＸ		17
#define		南通路ルートＥＸ			18
#define		南通路ルート２ＥＸ			19
#define		イベント１ルート待機ＥＸ	20
#define		イベント１ルート巡回ＥＸ	21
#define		イベント２ルート待機ＥＸ	22
#define		イベント２ルート巡回ＥＸ	23
#define		追加警備ルート				24

// クリアリングルート
// ------------------------------------
// クリアリングエリア０
enum C_R0 {
	先頭兵ルート = 0,
	先頭兵左チェックルート,
	先頭兵右チェックルート,
	２番兵ルート
}

// ローカル変数


// include
