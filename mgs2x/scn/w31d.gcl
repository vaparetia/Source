			if ( $f:w31a_エマイベントフラグ１ == 0 ) {
				mesg 敵兵共通 敵兵:06 永久アンリアルＯＮ
			}
			if ( $f:w31a_エマイベントフラグ３ == 0 ) {
				mesg 敵兵共通 敵兵:04 永久アンリアルＯＮ
			}
			
		}
	}

	proc 攻撃兵０ {
		#if d:DEBUG_PRINT
			print 'attacker_set'
		#endif

		chara アタッカー 敵兵:61 -r d:攻撃兵待機ルート -c d:追加警備ルート \
			-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 -l $w:敵標準体力 -h $w:敵標準聴力 -f $w:敵標準気絶
		chara アタッカー 敵兵:62 -r d:攻撃兵待機ルート -e 1 \
			-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 -l $w:敵標準体力 -h $w:敵標準聴力 -f $w:敵標準気絶
	}


	proc 警備兵コマンダー {
		#if d:DEBUG_PRINT
			print 'wccomm_set'
		#endif

		chara 警備コマンダー wccomm -e {警備兵０}
	}

	proc 攻撃兵コマンダー {
		#if d:DEBUG_PRINT
			print 'atcomm_set'
		#endif

		chara 攻撃コマンダー atcomm -e 攻撃兵０ -wait (60*3) -avoidwait (60*5)

	}

	// 司令官、危険モード時の音声リソース
	resource ghq_area_alert_voice {
		w31d:
			$t{
				// PLAREA0 ＫＬ連絡橋側
				t:vc040258,		// 指揮官「了解。バックアップ、シェル２中央棟１Ｆに向かえ！ＫＬ連絡橋への扉を守れ！」
				t:vc040259,		// 指揮官「了解。増援部隊をシェル２中央棟１Ｆ・ＫＬ連絡橋への扉付近に送る。敵を逃がすな！」
				-2, // PLAREA0の登録終了
				// PLAREA1 通路
				t:vc040260,		// 指揮官「了解。増援部隊、シェル２中央棟１Ｆ・通路に向かえ。敵を包囲せよ！」
				t:vc040261,		// 指揮官「了解。応援部隊をシェル２中央棟１Ｆに送る。通路を守れ！」
				t:vc040262,		// 指揮官「了解。増援部隊、シェル２中央棟１Ｆに向かえ！侵入者を包囲せよ」
				t:vc040263,		// 指揮官「了解。増援部隊をシェル２中央棟１Ｆに派遣する！敵を逃がすな！」
				-1 // 全ての登録終了
			}
	}

	// 司令官、警戒モード時の音声リソース
	resource ghq_caution_voice {
		w31d:
			$t{
				t:vc040416,		// 指揮官「了解。シェル２中央棟１Ｆに増員を送る。警戒を強化しろ」
				t:vc040415,		// 指揮官「了解。シェル２中央棟１Ｆに増員を派遣する。通路の戒を強化しろ」
				t:vc040414,		// 指揮官「了解。シェル２中央棟１Ｆ通路を増員。警備を強化しろ」
				-2
				t:vc040435,		// 指揮官「シェル２中央棟１Ｆとの連絡が途絶えた」
				-1
			}
	}

	proc コマンダー設定 {
		#if d:DEBUG_PRINT
			print 'commander_set'
		#endif

		if ( $s:エマ存在ステージ == w31d ) {
			chara コマンダー 敵兵セット \
				-w 警備兵コマンダー \
				-a 攻撃兵コマンダー \
				-m $w:スタートアラートモード \
				-r 25500,0,-240000 シェル２中央棟１Ｆ \
				-c 25500,0,-240000 シェル２中央棟１Ｆ \
				-x [ghq_area_alert_voice:w31d] \
				-y [ghq_caution_voice:w31d] \
				-v [ene_plant_voice:01] \
				-z $i:敵標準麻酔持続 \
				-o $i:敵標準気絶持続 \
				-b $w:敵標準再発生数 \
				-s ( d:ENE_STAGE_GPS | d:ENE_STAGE_NPC_EMMA ) \
				-d シェル２中央棟１Ｆ \
				-p 	0, -1, -1 クリアリングエリア０初期設定 \
					1, -1, -1 クリアリングエリア１初期設定 \
					0, -3, -3 クリアリング回避回数処理 \
					1, -3, -3 クリアリング回避回数処理 \
					-2, -2, -2 クリアリングカメラオフ

		} else {
			chara コマンダー 敵兵セット \
				-w 警備兵コマンダー \
				-a 攻撃兵コマンダー \
				-m $w:スタートアラートモード \
				-r 25500,0,-240000 シェル２中央棟１Ｆ \
				-c 25500,0,-240000 シェル２中央棟１Ｆ \
				-x [ghq_area_alert_voice:w31d] \
				-y [ghq_caution_voice:w31d] \
				-v [ene_plant_voice:01] \
				-z $i:敵標準麻酔持続 \
				-o $i:敵標準気絶持続 \
				-b $w:敵標準再発生数 \
				-s d:ENE_STAGE_GPS \
				-d シェル２中央棟１Ｆ \
				-p 	0, -1, -1 クリアリングエリア０初期設定 \
					1, -1, -1 クリアリングエリア１初期設定 \
					0, -3, -3 クリアリング回避回数処理 \
					1, -3, -3 クリアリング回避回数処理 \
					-2, -2, -2 クリアリングカメラオフ

		}

		// クリアリング子画面チェック
		@クリアリング子画面チェック

		// クリアリングエリアにプレイヤーやエマがいるかどうかのチェック
		@クリアリングエリアチェック設定
	}


	proc イベント兵ルートチェンジ設定 {
		#if d:DEBUG_PRINT
			print 'event_enemy_set'
		#endif

		// エマがイベントエリアにいるかいないかのチェック
		trap ev101 手繋ぎエマ \
			-mask ？ \
			-exec {
				if ( $3 == 入る ) {
					eval( $f:w31a_エマイベント１エリアにいるフラグ = 1 );
				} else {
					eval( $f:w31a_エマイベント１エリアにいるフラグ = 0 );
				}
			}

		trap ev102 手繋ぎエマ \
			-mask ？ \
			-exec {
				if ( $3 == 入る ) {
					eval( $f:w31a_エマイベント２エリアにいるフラグ = 1 );
				} else {
					eval( $f:w31a_エマイベント２エリアにいるフラグ = 0 );
				}
			}

		trap ev103 手繋ぎエマ \
			-mask ？ \
			-exec {
				if ( $3 == 入る ) {
					eval( $f:w31a_エマイベント３エリアにいるフラグ = 1 );
				} else {
					eval( $f:w31a_エマイベント３エリアにいるフラグ = 0 );
				}
			}

		// ＨＩ連絡橋にいる兵士
		trap ev103 d:PLAYER \
			-mask いる \
			-exec {
				if ( $f:w31a_エマイベント３エリアにいるフラグ == 1 && $f:w31a_エマイベントフラグ３ == 0 ) {
					mesg 敵兵共通 敵兵:04 永久アンリアルＯＦＦ
					eval( $f:w31a_エマイベントフラグ３ = 1 );
					command トラップ切り替え -trap ev103 -switch 0
				}
			}

		// エレベータからくる敵兵&通路を見張る敵兵
		trap ev101 d:PLAYER \
			-mask ＊ \
			-exec {
				if ( $4 > -8500 && $6 > -232000 && $f:w31a_エマイベントフラグ１ == 0 && $w:ゲーム設定 >= d:LEVEL_NORMAL ) {
					// シナリオデモに関係ないほうの兵士はモードに関係なく出す
					if ( $f:w31a_エマイベント１エリアにいるフラグ == 1 && $f:w31a_敵兵05登場フラグ == 0 ) {
						mesg 敵兵共通 敵兵:05 永久アンリアルＯＦＦ
						eval( $f:w31a_敵兵05登場フラグ = 1 );
					}
					
					if ( $f:w31a_エマイベント１エリアにいるフラグ == 1 && `@シナリオデモ用安全チェック`  && \
						 `command エレベータ状態取得` == 0 ) {
						mesg 敵兵共通 敵兵:06 永久アンリアルＯＦＦ
						eval( $f:w31a_エマイベントフラグ１ = 1 );

						@シナリオデモ開始処理
//				command パッド操作 -cancel
						chara カメラ設定 シナリオデモカメラ \
							-c 1 \	
							-p -2195,2632,-248151 -t -763,1753,-251007 \
							-r 175,1745,0 -f 3313 \
							-a 200 \
							-i 0 0 0 0 \
							-s 1

						chara カメラ設定 シナリオデモカメラ \
							-c 1 \
							-p -2259,2115,-248024 -t -828,1231,-250879 \
							-r 176,1745,0 -f 3314 \
							-a 200 \
							-z d:CAMERA_INTERP_CAMERA  \ // 補完カメラフラグを指定。
							-interp_time 120 \ // 補完時間を指定
							-s 1

						chara delay ディレイ \
							-time (60*4) \
							-exec {  
								chara カメラ設定 シナリオデモカメラ -s -1
								@シナリオデモ終了処理
								command トラップ切り替え -trap ev101 -switch 0
							}

						chara delay ディレイ \
							-time 1 \
							-exec {
								mesg エレベータ 中央棟エレベーター open 0 \
									エレベータードアオープン開始 イベント１開始
							}
					}
				}
			}

		// 突然飛び出してくる敵兵
		trap ev102 d:PLAYER \
			-mask ＊ \
			-exec {
				// トラップ内にエマと一緒にいたら登場
				if ( $f:w31a_敵兵03登場フラグ == 0 && $f:w31a_エマイベント２エリアにいるフラグ == 1 && \
					 $4 < 1500 ) {
					mesg 敵兵共通 敵兵:03 永久アンリアルＯＦＦ
					eval( $f:w31a_敵兵03登場フラグ = 1 );
				}

				// トラップ内にエマと一緒にいたら登場
				if ( $f:w31a_エマイベントフラグ２ == 0 && $f:w31a_エマイベント２エリアにいるフラグ == 1 && \
					 $3 == 出る && $4 > 8500 && $f:w31a_敵兵03登場フラグ == 1 ) {

					mesg 警備兵 敵兵:03 アクション終了

					if ( $w:ゲーム設定 <= d:LEVEL_HARD ) {
						mesg 警備兵 敵兵:03 ルート変更 d:イベント２ルート巡回 9500 0 -236500 シェル２中央棟１Ｆ 4
					} else {
						mesg 警備兵 敵兵:03 ルート変更 d:イベント２ルート巡回ＥＸ 9500 0 -236500 シェル２中央棟１Ｆ 4
					}

					command トラップ切り替え -trap ev102 -switch 0
					eval( $f:w31a_エマイベントフラグ２ = 1 );
				}
			}
	}

	proc イベント１開始 {
		if ( $w:ゲーム設定 >= d:LEVEL_NORMAL && $w:ゲーム設定 <= d:LEVEL_HARD ) {
			mesg 警備兵 敵兵:06 ルート変更 d:イベント１ルート巡回 -12000 0 -231000 シェル２中央棟１Ｆ
		} else {
			mesg 警備兵 敵兵:06 ルート変更 d:イベント１ルート巡回ＥＸ -12000 0 -231000 シェル２中央棟１Ｆ
		}
	}


	// クリアリング設定
	//--------------------------------------------------------
	proc クリアリングエリア０初期設定 {
		#if d:DEBUG_PRINT 
			print '$b:w31a_クリアリング回避回数='$b:w31a_クリアリング回避回数
		#endif

		command セットクリアリング \
			-i	d:C_R0:先頭兵ルート, \
				d:C_R0:２番兵ルート, \
			-p	0, d:C_R0:先頭兵ルート, 1, スタンチェック０ \
				0, d:C_R0:先頭兵ルート, 7, クリアリングコース選択 \
				0, d:C_R0:先頭兵ルート, 0,子画面オンオフチェック０ \
				0, d:C_R0:先頭兵ルート, 0,クリアリングカメラ１ \
				0, d:C_R0:先頭兵ルート, 4,クリアリングカメラ２ \
				0, d:C_R0:先頭兵左チェックルート, 0, クリアリングカメラ３ \
				0, d:C_R0:先頭兵右チェックルート, 0, クリアリングカメラ３ \
				0, d:C_R0:先頭兵左チェックルート, 9, クリアリングカメラ４ \
				0, d:C_R0:先頭兵右チェックルート, 6, クリアリングカメラ４

		if ( $f:エマ存在フラグ == 1 ) {
			mesg エマ・エメリッヒ 手繋ぎエマ 徘徊不可能
		}
	}

	proc クリアリングエリア１初期設定 {
		#if d:DEBUG_PRINT 
			print '$b:w31a_クリアリング回避回数='$b:w31a_クリアリング回避回数
		#endif

		// ０も１も中身は一緒
		command セットクリアリング \
			-i	d:C_R0:先頭兵ルート, \
				d:C_R0:２番兵ルート, \
			-p	1, d:C_R0:先頭兵ルート, 1, スタンチェック０ \
				1, d:C_R0:先頭兵ルート, 7, クリアリングコース選択 \
				1, d:C_R0:先頭兵ルート, 0,子画面オンオフチェック０ \
				1, d:C_R0:先頭兵ルート, 0,クリアリングカメラ１ \
				1, d:C_R0:先頭兵ルート, 4,クリアリングカメラ２ \
				1, d:C_R0:先頭兵左チェックルート, 0, クリアリングカメラ３ \
				1, d:C_R0:先頭兵右チェックルート, 0, クリアリングカメラ３ \
				1, d:C_R0:先頭兵左チェックルート, 9, クリアリングカメラ４ \
				1, d:C_R0:先頭兵右チェックルート, 6, クリアリングカメラ４

		if ( $f:エマ存在フラグ == 1 ) {
			mesg エマ・エメリッヒ 手繋ぎエマ 徘徊不可能
		}
	}

	proc スタンチェック０ {
		// 規定回数に行くまでおよび、プレイヤーが中にいない、エマが中にいるときはスタン投げを飛ばす
		if ( $b:w31a_クリアリング回避回数 < $w:クリアリングレベルアップ回数 || \
			 $f:w31a_プレイヤークリアリングエリア内にいるフラグ == 0 || \
			 $f:w31a_エマクリアリングエリア内にいるフラグ == 1 ) {
			command チェンジクリアリングルート 敵兵:61 -r d:C_R0:先頭兵ルート -p 3
		}
	}

	proc クリアリングコース選択 {
		// ノーマル以下はプレイヤーがいるほうの重点チェックをしない
		if ( $i:プレイヤー位置Ｘ > 2000 ) {
			if ( $b:w31a_クリアリング回避回数 <= $w:クリアリングレベルアップ回数 || \
				 $w:ゲーム設定 <= d:LEVEL_NORMAL ) {
				command チェンジクリアリングルート 敵兵:61 -r d:C_R0:先頭兵左チェックルート -p 0
			} else {
				command チェンジクリアリングルート 敵兵:61 -r d:C_R0:先頭兵右チェックルート -p 0
			}
		} else {
			if ( $b:w31a_クリアリング回避回数 <= $w:クリアリングレベルアップ回数 || \
				 $w:ゲーム設定 <= d:LEVEL_NORMAL ) {
				command チェンジクリアリングルート 敵兵:61 -r d:C_R0:先頭兵右チェックルート -p 0
			} else {
				command チェンジクリアリングルート 敵兵:61 -r d:C_R0:先頭兵左チェックルート -p 0
			}
		}
	}

	proc クリアリングカメラ１ {
		eval( $f:クリアリング中フラグ = 1 );
		#if d:CLEAR_CAMERA
			command カメラマップ設定 -chanl 1 -map シェル２中央棟１Ｆ
			chara カメラ設定 クリアリングカメラ \
				-c 1 \	
				-p 8591,3657,-239960 -t 5703,1561,-241261 \
				-r 381,2796,0 -f 3798 \
				-a 200 \
				-i 0 -1 0 0 \
				-s 1

			chara カメラ設定 クリアリングカメラ \
				-c 1 \	
				-p 9226,2199,-239753 -t 5927,1054,-241234 \
				-r 200,2797,0 -f 3793 \
				-a 200 \
				-i 0 -1 0 0 \
				-z d:CAMERA_INTERP_CAMERA \ // 補完カメラフラグを指定。
				-interp_time (60*7) \ // 補完時間を指定
				-s 1
		#endif
	}

	proc クリアリングカメラ２ {
		#if d:CLEAR_CAMERA
			chara カメラ設定 クリアリングカメラ \
				-c 1 \	
				-p -1660,4856,-243396 -t 2128,1914,-241540 \
				-r 397,727,0 -f 5143 \
				-a 276 \
				-i 0 -1 0 0 \
				-s 1

			chara カメラ設定 クリアリングカメラ \
				-c 1 \	
				-p -2463,3373,-242858 -t 2038,1548,-241193 \
				-r 237,793,0 -f 5134 \
				-a 276 \
				-i 0 -1 0 0 \
				-z d:CAMERA_INTERP_CAMERA \ // 補完カメラフラグを指定。
				-interp_time (60*2) \ // 補完時間を指定
				-s 1
		#endif
	}

	proc クリアリングカメラ３ {
		if ( $f:w31a_エマクリアリングエリア内にいるフラグ == 1 ) {
			#if d:CLEAR_CAMERA
				chara カメラ設定 クリアリングカメラ \
					-c 1 \	
					-p -2021,2343,-244085 -t -1488,2202,-243844 \
					-r 154,747,0 -f 602 \
					-a 200 \
					-i 2 -1 0 0 \
					-s 1

				chara カメラ設定 クリアリングカメラ \
					-c 1 \	
					-p -1527,2269,-245658 -t -955,2116,-245580 \
					-r 168,936,0 -f 597 \
					-a 342 \
					-i 0 -1 0 0 \
					-z d:CAMERA_INTERP_CAMERA \ // 補完カメラフラグを指定。
					-interp_time (60*8) \ // 補完時間を指定
					-s 1
			#endif
		} else {
			if ( $i:プレイヤー位置Ｚ > -239500 ) {
			#if d:CLEAR_CAMERA
				chara カメラ設定 クリアリングカメラ \
					-c 1 \	
					-p -2446,2903,-244701 -t 993,1460,-241335 \
					-r 190,519,0 -f 5024 \
					-a 287 \
					-i 2 -1 0 0 \
					-s 1

				chara カメラ設定 クリアリングカメラ \
					-c 1 \	
					-p -1885,3320,-244861 -t -849,890,-240587 \
					-r 329,155,0 -f 5025 \
					-a 200 \
					-i 0 -1 0 0 \
					-z d:CAMERA_INTERP_CAMERA \ // 補完カメラフラグを指定。
					-interp_time (60*8) \ // 補完時間を指定
					-s 1
			#endif
			} else {
			#if d:CLEAR_CAMERA
				chara カメラ設定 クリアリングカメラ \
					-c 1 \	
					-p -2021,2343,-244085 -t -1488,2202,-243844 \
					-r 154,747,0 -f 602 \
					-a 200 \
					-i 2 -1 0 0 \
					-s 1

				chara カメラ設定 クリアリングカメラ \
					-c 1 \	
					-p -1527,2269,-245658 -t -955,2116,-245580 \
					-r 168,936,0 -f 597 \
					-a 342 \
					-i 0 -1 0 0 \
					-z d:CAMERA_INTERP_CAMERA \ // 補完カメラフラグを指定。
					-interp_time (60*8) \ // 補完時間を指定
					-s 1
			#endif
			}
		}
	}

	proc クリアリングカメラ４ {
		#if d:CLEAR_CAMERA
			chara カメラ設定 クリアリングカメラ \
				-c 1 \	
				-p -2499,2039,-239664 -t -1960,1897,-239917 \
				-r 152,1310,0 -f 612 \
				-a 200 \
				-i 2 0 0 0 \
				-s 1
		#endif
	}


	proc 子画面オンオフチェック０ {
		eval( $f:クリアリング子画面フラグ = 1 );
	}

	// クリアリングが終了したら呼ぶプロック
	//---------------------------------------
	proc クリアリング回避回数処理 {
		if ( $b:w31a_クリアリング回避回数 < 255 ) {
			eval( $b:w31a_クリアリング回避回数 = $b:w31a_クリアリング回避回数 + 1 );
		}
	}

	// すべてのクリアリングのキャンセル＆終了プロック
	//---------------------------------------
	proc クリアリングカメラオフ {
		eval( $f:クリアリング中フラグ = 0 );
		chara カメラ設定 クリアリングカメラ -s -1
		eval( $f:クリアリング子画面フラグ = 0 );
		if ( $f:エマ存在フラグ == 1 ) {
			mesg エマ・エメリッヒ 手繋ぎエマ 徘徊可能
		}

		#if d:SUB_CAMERA
			mesg サブ画面 子画面 off
		#endif

	}

	// クリアリング子画面チェック
	//---------------------------------------
	proc クリアリング子画面チェック {
		#if d:DEBUG_PRINT 
			print 'clearing_sub_camera_check'
		#endif

		chara プロック連続実行 子画面チェック \
			-time -1 \
			-exec { \
				if ( $f:クリアリング子画面フラグ == 1 ) {
					if ( `command プレイヤー状態取得` & d:PFLAG_INTRUDE ) {

						command ゲットゲームステータス $i:ローカル変数Ｉ２
						if ( $i:ローカル変数Ｉ２ & d:STATE_CLEARING ) {
							#if d:SUB_CAMERA
								mesg サブ画面 子画面 on
							#endif
						}
					} else {
						#if d:SUB_CAMERA
							mesg サブ画面 子画面 off
						#endif
					}
				}
			}
	}


	// クリアリングチェック設定
	//---------------------------------------
	proc クリアリングエリアチェック設定 {
		#if d:DEBUG_PRINT 
			print 'clearing_area_check_set'
		#endif

		trap cl001 d:PLAYER \
			-mask ？ \
			-exec {
				if ($3 == 入る) {
					eval( $f:w31a_プレイヤークリアリングエリア内にいるフラグ = 1 );
				} else if ($3 == 出る) {
					eval( $f:w31a_プレイヤークリアリングエリア内にいるフラグ = 0 );
				}
			}

		trap cl001 手繋ぎエマ \
			-mask ？ \
			-exec {
				if ($3 == 入る) {
					eval( $f:w31a_エマクリアリングエリア内にいるフラグ = 1 );
				} else if ($3 == 出る) {
					eval( $f:w31a_エマクリアリングエリア内にいるフラグ = 0 );
				}
			}
	}

	// エマ設定
	// ------------------------------------
	proc エマ設定 {
		#if d:DEBUG_PRINT 
			print 'emma_set'
		#endif
		if ( $f:エマ存在フラグ == 1 && $s:登場ポイント == sp_w31b_w31a_0 ) {
			@手繋ぎエマ設置 750,0,-255500 d:SOUTH

		} else if ( $f:エマ存在フラグ == 1 && $s:登場ポイント == sp_w25c_w31a_0 ) {
			// ライデンと一緒にＫＬ連絡橋からきた
			@手繋ぎエマ設置 ($i:プレイヤー初期Ｘ位置+500),$i:プレイヤー初期Ｙ位置,$i:プレイヤー初期Ｚ位置 d:WEST

		} else if ( $f:エマ存在フラグ == 0 && $s:エマ存在ステージ == w31d ) {
			// シェル２中央棟１Ｆに置き去りにされていた
			@手繋ぎエマ設置 $i:エマ初期位置Ｘ,$i:エマ初期位置Ｙ,$i:エマ初期位置Ｚ d:SOUTH

			// エマを一番近い安全地帯へワープさせる
			mesg エマ・エメリッヒ 手繋ぎエマ 強制隠れ位置移動
		}

		trap ld001 手繋ぎエマ \
			-mask ？ \
			-exec {
				if ( $3 == 入る ) {
					eval( $s:エマ存在ステージ = w25d );
				} else {
					eval( $s:エマ存在ステージ = w31d );
				}
			}
	}

	proc 手繋ぎエマ設置 $:エマＸ $:エマＹ $:エマＺ $:エマ方向 {
		#if d:DEBUG_PRINT
			print 'chara_emma_set'
		#endif

		chara エマ・エメリッヒ 手繋ぎエマ \
			-pos	$:エマＸ $:エマＹ $:エマＺ \
			-dir	$:エマ方向 \
			-hide	6500, 2000, -252000 \
					12500, 2000, -231500 \
					-2000, 2000, -244500 \
					-2000, 2000, -252500 \
					6750, 2000, -243500 \
			-voice [emma_voice:vox_list] \
			-vitality $i:エマライフ最大値 $i:エマライフ現在値 \
			-stage d:EMA_STG_W31D \
			-idcard $f:IDcard \
			-proc 手繋ぎエマゲームオーバー


		// コマンドは エマとプレーヤーの後
		command プラグインエマ手繋ぎ -motion rai_ee
	}

	proc エマゲームオーバー時カメラ {
		command ゲットエマ足元座標 $i:epx , $i:epy , $i:epz
		eval( $f:エマゲームオーバーフラグ = 1 );

		if ( $i:epx < 18625 ) {
			chara カメラ設定 シナリオデモカメラ \
				-c 1 \
				-p ($i:epx + 30) , ($i:epy + 2450) , ($i:epz + 30)  \
				-t $i:epx , $i:epy , $i:epz \
				-a 200 \
				-i 0 -1 0 0 \
				-s 1
			chara delay カメラディレイ \
				-time 60 \
				-exec {
					command ゲットエマ足元座標 $i:epx , $i:epy , $i:epz
					chara カメラ設定 シナリオデモカメラ \
						-c 1 \
						-p ($i:epx + 30) , ($i:epy + 2450) , ($i:epz + 30)  \
						-t $i:epx , $i:epy , $i:epz \
						-a 200 \
						-z d:CAMERA_INTERP_CAMERA \ // 補完カメラフラグを指定。
						-interp_time 10 \ // 補完時間を指定
						-s 1
				}
		} else {
			chara カメラ設定 シナリオデモカメラ \
				-c 1 \
				-p 15809,4414,-234051 -t 18905,1263,-234862 \
				-r 507,1191,0 -f 4491 \
				-a 200 \
				-i 0 -1 0 0 \
				-s 1
		}
	}







