#include "w31ad_common.h" 
#include "node_res.h"
#include "ene_item.h"

#if d:USB_KEY
	#include "usbkbd.h"
#endif


// マップ設定
// ------------------------------------
chara マップ シェル２中央棟１Ｆ -k d:KMS_NAME0 -k d:KMS_NAME3 -k d:KMS_NAME4 -k d:PANEL_KMS_NAME1 -h d:HZX_NAME,0 -l d:LT2_NAME

command マップ設定 シェル２中央棟１Ｆ -set {
	// サウンド、キャラクターのセット
	// ------------------------------------
	#if d:SOUND	
		@サウンド設定			// データは最初に呼ぶ。w31ad_common.hで定義
	#endif
		@レーダーオンオフチェック $f:w31a_ノードフラグ	// stdch.hで定義
		@常駐キャラ設定			// stdch.hで定義
		@ローカル変数初期化		// w31ad_common.hで定義
		@設定値変更				// w31ad_common.hで定義
		@シェル２中央棟１Ｆトラップ制御
		@シナリオデモキャラセット	// stdproc.hで定義
		@プラグイン設定			// w31ad_common.hで定義
		@プレイヤー設定			// w31ad_common.hで定義
		@エマ設定
	#if d:ENEMY
		@コマンダー設定
		@イベント兵ルートチェンジ設定
	#endif
		@鏡面モデル設定			// w31ad_common.hで定義
	#if d:GUN_CAMERA
		@ガンカメラ設置			// w31ad_common.hで定義
	#endif
	#if d:BGM	
		@ＢＧＭ設定	// プレイヤー→敵兵→BGMの順で呼ぶ。w31ad_common.hで定義
	#endif
		@弾痕跳弾設定			// w31ad_common.hで定義

	// ステージ、オブジェクト関連
	// ------------------------------------
	#if d:NODE
		@ノード端末設定 2048	// w31ad_common.hで定義
	#endif
		@エレベーター設置 シェル２中央棟１Ｆ	// stdproc.hで定義
		@パイプ部屋パイプ設置	// w31ad_common.hで定義
	#if d:SLIDE_DOOR
		@ドア設置				// w31ad_common.hで定義
	#endif
		@主観禁止壁設定					// w31ad_common.hで定義
		@ダクト金網設定				// w31ad_common.hで定義
		@イントルード金網設定	// w31ad_common.hで定義
		@プラント編全体マップ設定 d:シェル２中央棟マップ	// stdproc.hで定義
	#if d:LOAD_TRAP
		@ロード設定				// w31ad_common.hで定義
	#endif
	#if d:ITEM
		@エマイベントアイテム設置		// w31ad_common.hで定義
	#endif
	#if d:FOG
		@フォグ設定				// w31ad_common.hで定義
	#endif
		@カメラセット			// w31ad_common.hで定義
		@子画面設定
	#if d:CHARA_CEIL
		@シェル２中央棟１Ｆ天井設置	// w31ad_common.hで定義
		@シェル２中央棟１Ｆ南壁設置	// w31ad_common.hで定義
	#endif
	#if d:JP_MOTION
		@シェル２中央棟１Ｆジャンプ設定	// w31ad_common.hで定義
	#endif
		@シェル２中央棟１Ｆカメラ設定	// w31ad_common.hで定義
	#if d:CHARA_LIGHT
		@キャラ用ライト設置				// マップ設定の最後に呼ぶ。w31ad_common.hで定義
	#endif

	// デバッグ関係
	// ------------------------------------
	#if d:DEBUG_CHARA
	//	@デバッグキャラセット
	#endif
}


// 無線用include ※位置は動かさないこと
#include "w31d_cdc.ch"

// 全てのセットが終わったところでフェードイン
if( $s:登場ポイント == sp_w25c_w31a_0 ) {
	// ＫＬ連絡橋から
	//初期マップの表示
	command マップ表示 -show シェル２中央棟１Ｆ
	// 全てのセットが終わったところでフェードイン
	@ステージ開始時処理（ステージ名表示） \
		d:LOAD_TYPE:SL_DOOR_TYPE １Ｆ右ドア 2000 d:DEFAULT_M_TYPE \
		d:wn_シェル２中央棟１Ｆ空気清浄室
} else if( $s:登場ポイント == sp_w31b_w31a_0 ) {
	// Ｂ１から
	//初期マップの表示
	command マップ表示 -show シェル２中央棟１Ｆ
	// 全てのセットが終わったところでフェードイン
	@ステージ開始時処理（エレベーター） d:wn_シェル２中央棟１Ｆ空気清浄室
}




// 各proc設定
//-------------------------------------------------------------------------------------
// 全マップ共通
	// トラップの制御
	// ------------------------------------
	proc シェル２中央棟１Ｆトラップ制御 {
		#if d:DEBUG_PRINT
			print 'w31a_trap_control'
		#endif
		
		if ( $f:w31a_エマイベントフラグ１ == 0 ) {
			command トラップ切り替え -trap ev101 -switch 1
		} else {
			command トラップ切り替え -trap ev101 -switch 0
		}

		if ( $f:w31a_エマイベントフラグ２ == 0 ) {
			command トラップ切り替え -trap ev102 -switch 1
		} else {
			command トラップ切り替え -trap ev102 -switch 0
		}

		if ( $f:w31a_エマイベントフラグ３ == 0 ) {
			command トラップ切り替え -trap ev103 -switch 1
		} else {
			command トラップ切り替え -trap ev103 -switch 0
		}

	}

	// 敵兵 
	// ------------------------------------
	proc 警備兵０ {
		#if d:DEBUG_PRINT
			print 'watcher_set'
		#endif

		if ( $s:エマ存在ステージ == w31d ) {
			// エマがいるときはエマ警備兵を登場させる
			eval( $i:w31a_敵兵ステータス = d:ENE_STATUS_NPC );
		} else {
			eval( $i:w31a_敵兵ステータス = 0 );
		}

		if ( $f:w31a_エマイベントフラグ１ == 1 ) {
			if ( $w:ゲーム設定 == d:LEVEL_EXTREME ) {
				eval( $b:w31a_敵兵06ルート番号 = d:イベント１ルート巡回ＥＸ );
				eval( $b:w31a_敵兵06ノード番号 = 16 );
			} else {
				eval( $b:w31a_敵兵06ルート番号 = d:イベント１ルート巡回 );
				eval( $b:w31a_敵兵06ノード番号 = 3 );
			}
		} else {
			if ( $w:ゲーム設定 == d:LEVEL_EXTREME ) {
				eval( $b:w31a_敵兵06ルート番号 = d:イベント１ルート待機ＥＸ );
				eval( $b:w31a_敵兵06ノード番号 = 0 );
			} else {
				eval( $b:w31a_敵兵06ルート番号 = d:イベント１ルート待機 );
				eval( $b:w31a_敵兵06ノード番号 = 0 );
			}
		}

		if ( $f:w31a_エマイベントフラグ２ == 1 ) {
			if ( $w:ゲーム設定 == d:LEVEL_EXTREME ) {
				eval( $b:w31a_敵兵03ルート番号 = d:イベント２ルート巡回ＥＸ );
				eval( $b:w31a_敵兵03ノード番号 = 5 );
			} else {
				eval( $b:w31a_敵兵03ルート番号 = d:イベント２ルート巡回 );
				eval( $b:w31a_敵兵03ノード番号 = 5 );
			}
		} else {
			eval( $b:w31a_敵兵03ルート番号 = d:イベント２ルート待機 );
			eval( $b:w31a_敵兵03ノード番号 = 0 );
		}

		if ( $w:ゲーム設定 == d:LEVEL_VERYEASY ) {
		// VERY EASYの設定
			chara 警備兵 敵兵:01 \
				-r d:休憩室ルート -n 0 -d -6500,0,-249500 シェル２中央棟１Ｆ \
				-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
				-l $w:敵標準体力 -h $w:敵標準聴力 -f $w:敵標準気絶 \
				-s $i:w31a_敵兵ステータス \
				-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
				-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
				-j ドッグタグ_敵兵 [dogtag:plt_w31a_guard_ve_01] \
					[dogtag:plt_w31a_guard_ea_01] [dogtag:plt_w31a_guard_no_01] \
					[dogtag:plt_w31a_guard_ha_01] [dogtag:plt_w31a_guard_vh_01]

			chara 警備兵 敵兵:02 \
				-r d:南通路ルート１ -n 0 -d 5000,-2000,-227500 シェル２中央棟１Ｆ \
				-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
				-l $w:敵標準体力 -h $w:敵標準聴力 -f $w:敵標準気絶 \
				-s $i:w31a_敵兵ステータス \
				-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
				-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
				-j ドッグタグ_敵兵 [dogtag:plt_w31a_guard_ve_02] \
					[dogtag:plt_w31a_guard_ea_02] [dogtag:plt_w31a_guard_no_02] \
					[dogtag:plt_w31a_guard_ha_02] [dogtag:plt_w31a_guard_vh_02]

			chara 警備兵 敵兵:03 \
				-r $b:w31a_敵兵03ルート番号 -n $b:w31a_敵兵03ノード番号 -d 9500 0 -236500 シェル２中央棟１Ｆ \
				-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
				-l $w:敵標準体力 -h $w:敵標準聴力 -f $w:敵標準気絶 \
				-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
				-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
				-j ドッグタグ_敵兵 [dogtag:plt_w31a_guard_ve_03] \
					[dogtag:plt_w31a_guard_ea_03] [dogtag:plt_w31a_guard_no_03] \
					[dogtag:plt_w31a_guard_ha_03] [dogtag:plt_w31a_guard_vh_03]

		} else if ( $w:ゲーム設定 == d:LEVEL_EASY ) {
		// EASYの設定
			chara 警備兵 敵兵:01 \
				-r d:休憩室ルート -n 0 -d -6500,0,-249500 シェル２中央棟１Ｆ \
				-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
				-l $w:敵標準体力 -h $w:敵標準聴力 -f $w:敵標準気絶 \
				-s $i:w31a_敵兵ステータス \
				-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
				-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
				-j ドッグタグ_敵兵 [dogtag:plt_w31a_guard_ve_01] \
					[dogtag:plt_w31a_guard_ea_01] [dogtag:plt_w31a_guard_no_01] \
					[dogtag:plt_w31a_guard_ha_01] [dogtag:plt_w31a_guard_vh_01]

			chara 警備兵 敵兵:02 \
				-r d:南通路ルート１ -n 0 -d 5000,-2000,-227500 シェル２中央棟１Ｆ \
				-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
				-l $w:敵標準体力 -h $w:敵標準聴力 -f $w:敵標準気絶 \
				-s $i:w31a_敵兵ステータス \
				-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
				-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
				-j ドッグタグ_敵兵 [dogtag:plt_w31a_guard_ve_02] \
					[dogtag:plt_w31a_guard_ea_02] [dogtag:plt_w31a_guard_no_02] \
