/***************************************************************************************************/
// アイテム関係
/***************************************************************************************************/
	proc アイテム取得時番号設定 $:ボックス名 {
		#if d:DEBUG_PRINT
			print 'item_no_set'
		#endif

		if($:ボックス名 == ＵＳＰ本体) {
			eval($b:w01a_取得ロード回数[0] = $w:グローバルロード回数);
		} else if ($:ボックス名 == ＵＳＰ弾) {
			eval($b:w01a_取得ロード回数[1] = $w:グローバルロード回数);
		} else if ($:ボックス名 == Ｍ９弾) {
			eval($b:w01a_取得ロード回数[2] = $w:グローバルロード回数);
		}

	#if d:DEBUG_PRINT
		print $:ボックス名
		print $w:グローバルロード回数
	#endif
	}

	proc アイテム初期設定 {
	#if d:ITEM
		@アイテム再セットチェック $b:w01a_取得ロード回数[1]
		if ($f:再セットフラグ) {
			@レーション_初期設置 レーション -4520 0 3550 0 			// ロッカールーム左下
		}

		@アイテム再セットチェック $b:w01a_取得ロード回数[2]
		if ($f:再セットフラグ) {
			@弾薬_Ｍ９_初期設置 Ｍ９弾 4500 0 3550 0 				// Ｍ９弾 ロッカールーム右下
		}
	#endif
	}

/***************************************************************************************************/
// ハンドル壊し
/***************************************************************************************************/
proc 水密ドア取れるハンドル {
#if d:BREAK_HATCH
	chara プットモーションモデル 取れるハンドル \
		-pos  -10800 /*1200*/0 -10980 \
		-dir 2048 \
		-kms w01asdr_handle3 \
		-mar wtdoor_break \
		-number 0 \
		-status	( 0x04 | 0x08 )
	mesg プットモーションモデル 取れるハンドル 非表示
#endif
}

/***************************************************************************************************/
// エンジン前コンテナ塞ぎ
/***************************************************************************************************/
	proc エンジン前コンテナ塞ぎ {
		if( `@コンテナチェック` ) {
			// コンテナ設置
			chara プットオブジェ コンテナ -m w01f_box -r 0 0 0 -p 0 0 0 -l w01a -s 100 100 100

			// 跳弾当たり追加
			command 追加ＨＺＸグループ登録 -hzx_id 0 -add_id 2
		}
	}

	proc コンテナチェック {
		#ifdef d:EU_TRIAL
			#ifdef d:GERMAN_TRIAL
				if( ($w:t_story < d:ST_T06b1Rオルガ戦勝利後無線機デモ終了) ) {
					return 1;
				} else {
					return 0;
				}
			#else
				if( ($w:t_story < d:ST_T06b1Rオルガ戦勝利後無線機デモ終了) && ($w:ゲーム設定 <= d:LEVEL_EASY) ) {
					return 1;
				} else {
					return 0;
				}
			#endif
		#else
			if( ($w:t_story < d:ST_T06b1Rオルガ戦勝利後無線機デモ終了) && ($w:ゲーム設定 <= d:LEVEL_EASY) ) {
				return 1;
			} else {
				return 0;
			}
		#endif
	}

/***************************************************************************************************/
// プレイヤーの１フレーム前の座標を覚える
/***************************************************************************************************/
proc 座標取得 {
#if	d:GET_POINT
	trap ev000 d:PLAYER \
		-mask ＊ \
		-exec {
			eval( $i:前フレーム位置Ｘ = $i:プレイヤー位置Ｘ )
			eval( $i:前フレーム位置Ｚ = $i:プレイヤー位置Ｚ )
		}
#endif
}

/***************************************************************************************************/
// 主観及びビハインド時にモデルを表示する
/***************************************************************************************************/
proc 主観／ビハインド時の表示 {
	chara 天井君 左柱 -m w01a_pillar_l -a 5 -c 0 0 7500 -p 0,0,0 -l w01a
	chara 天井君 右柱 -m w01a_pillar_r -a 5 -c 0 0 7500 -p 0,0,0 -l w01a
}

/***************************************************************************************************/
// トラップカメラのproc化
/***************************************************************************************************/

// カメラ設定とデフォルトカメラ（通常は通路カメラ１を使用）
proc 居住区１Ｆカメラ設定 {
	chara カメラ ステージカメラ		-c 0 -l 3 -p 0
	chara カメラ ロードカメラ		-c 0 -l 2 -p 0
	chara カメラ クリアリングカメラ	-c 1 -l 2 -p 0
	chara カメラ 通路カメラ０		-c 0 -l 2 -p 1
	chara カメラ 通路カメラ１		-c 0 -l 2 -p 2
	chara カメラ モーションカメラ	-c 0 -l 2 -p 1


// デフォルトカメラ
	chara カメラ設定 ステージカメラ \
		-c 0 \
		-b -32000,-32000,-32000 32000,32000,32000 \
		-l -32000,-32000,-32000 32000,32000,32000 \
		-r 640,2048,0 \
		-f 6000 \
		-a 200 \
		-i 1 -1 0 0 \
		-s 1
}

proc 完全補完カメラ $:比較対象 $:距離小 $:距離大 $:ＰＸ１ $:ＰＸ２ $:ＰＹ１ $:ＰＹ２ $:ＰＺ１ $:ＰＺ２ $:ＴＸ１ $:ＴＸ２ $:ＴＹ１ $:ＴＹ２ $:ＴＺ１ $:ＴＺ２{
	@CS_スムーズカメラ昇順 $:比較対象 $:距離小 $:距離大 $:ＰＸ１ $:ＰＸ２
		eval( $i:補完ＰＸ= $i:CS_結果１ )
	@CS_スムーズカメラ昇順 $:比較対象 $:距離小 $:距離大 $:ＰＹ１ $:ＰＹ２
		eval( $i:補完ＰＹ= $i:CS_結果１ )
	@CS_スムーズカメラ昇順 $:比較対象 $:距離小 $:距離大 $:ＰＺ１ $:ＰＺ２
		eval( $i:補完ＰＺ= $i:CS_結果１ )
	@CS_スムーズカメラ昇順 $:比較対象 $:距離小 $:距離大 $:ＴＸ１ $:ＴＸ２
		eval( $i:補完ＴＸ= $i:CS_結果１ )
	@CS_スムーズカメラ昇順 $:比較対象 $:距離小 $:距離大 $:ＴＹ１ $:ＴＹ２
		eval( $i:補完ＴＹ= $i:CS_結果１ )
	@CS_スムーズカメラ昇順 $:比較対象 $:距離小 $:距離大 $:ＴＺ１ $:ＴＺ２
		eval( $i:補完ＴＺ= $i:CS_結果１ )
}

proc 西端廊下クランク部左カメラ {
	trap ca010 d:PLAYER -mask ＊ -camera \
		-exec {
			@完全補完カメラ $6	-8500 -7000  \
								-10630 -10361 \
								2758 4968 \
								-5200 -5758 \
								-10630 -10361 \
								1470 1096 \
								-7425 -6362

			chara カメラ設定 通路カメラ１ \
				-c 1 \
				-p $i:補完ＰＸ $i:補完ＰＹ $i:補完ＰＺ \
				-t $i:補完ＴＸ $i:補完ＴＹ $i:補完ＴＺ \
				-r 342,2048,0 -f 2571 \
				-a 200 \
				-i 1 -1 0 0 \
				-s $3
		}
}

proc 東端廊下クランク部右カメラ {
	trap ca011 d:PLAYER -mask ＊ -camera \
		-exec {
/*
			@CS_スムーズカメラ３ $6 -7000 -9000 4750 1500 -5650 -5175 -6150 -11000
			eval( $i:補完ＰＹ = $i:CS_結果１ )
			eval( $i:補完ＰＺ = $i:CS_結果２ )
			eval( $i:補完ＴＺ = $i:CS_結果３ )
			if( $6 < -9000 ) {
				eval( $i:補完ＰＹ = 1500 )
				eval( $i:補完ＰＺ = -5175 )
				eval( $i:補完ＴＺ = -11000 )
			}
			chara カメラ設定 通路カメラ１ \
				-c 1 \
				-p 10750,$i:補完ＰＹ,$i:補完ＰＺ \
				-t 10750,$5,$i:補完ＴＺ \
				-a 200 \
				-i 2 -1 0 0 \
				-s $3
*/
			@完全補完カメラ $6	-8500 -7000  \
								10630 10361 \
								2758 4968 \
								-5200 -5758 \
								10630 10361 \
								1470 1096 \
								-7425 -6362

			chara カメラ設定 通路カメラ１ \
				-c 1 \
				-p $i:補完ＰＸ $i:補完ＰＹ $i:補完ＰＺ \
				-t $i:補完ＴＸ $i:補完ＴＹ $i:補完ＴＺ \
				-r 342,2048,0 -f 2571 \
				-a 200 \
				-i 1 -1 0 0 \
				-s $3
		}
}

proc 西側東西方向通路カメラ {
	trap ca012 d:PLAYER -mask ＊ -camera \
		-exec {
			if( $3 == 入る ){
				if( $w:１トラップ前カメラ進入方向 == d:西 ) {
					eval( $w:カメラ補完方式 = 0 )
				}else{
					eval( $w:カメラ補完方式 = 1 )
				}
			}

			chara カメラ設定 通路カメラ１ \
				-c 0 \
				-b -10361,4968,-5758  -6269,4968,-5758 \
				-l -10361,1096,-6362  -6269,1096,-6362 \
				-r 923,2048,0 -f 3919 \
				-a 200 \
				-i $w:カメラ補完方式 -1 0 0 \
				-slide 0 2 1000 1000 60 0 \
				-s $3
		}
}

proc 西側南北方向通路カメラ {
	trap ca013 d:PLAYER -mask ＊ -camera \
		-exec {
				if( $3 == 入る ){	// 南から進入時
					if( $6 > 0 ){
						eval( $w:カメラ補完方式 = 1 )
						eval( $f:カメラタイプ = 0 )
					}else{
						// 北から進入時のカメラ補完方式はca014で値が代入済み
						eval( $f:カメラタイプ = 1 )
					}
				}

				if( $f:カメラタイプ ){
					@CS_スムーズカメラ昇順 $6 -5000 5000 300 200
						eval( $w:補完画角 = $i:CS_結果１ )
					@CS_スムーズカメラ昇順 $6 -5000 5000 -5414 -5200
						eval( $i:補完ＰＸ = $i:CS_結果１ )
					@CS_スムーズカメラ昇順 $6 -5000 5000 2576 2700
						eval( $i:補完ＰＹ = $i:CS_結果１ )
					@CS_スムーズカメラ昇順 $6 -5000 5000 8951 9917
						eval( $i:補完ＰＺ = $i:CS_結果１ )
					@CS_スムーズカメラ昇順 $6 -5000 5000 -5414 -5200
						eval( $i:補完ＴＸ = $i:CS_結果１ )
					@CS_スムーズカメラ昇順 $6 -5000 5000 1939 1762
						eval( $i:補完ＴＹ = $i:CS_結果１ )
					@CS_スムーズカメラ昇順 $6 -5000 5000 6852 7950
						eval( $i:補完ＴＺ = $i:CS_結果１ )

					chara カメラ設定 通路カメラ１ \
						-c 1 \
						-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ \
						-t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ \
						-r 69,2048,0 -f 7000 \
						-a $w:補完画角 \
						-i $w:カメラ補完方式 -1 0 0 \
						-s $3
				}else{
					chara カメラ設定 通路カメラ１ \
						-c 0 \
						-b -5500,2000,-10000  -5500,4000,10000 \
						-l -5500,1000,-10000  -5500,1000,10000 \
						-r 80,2048,0 -f 7000 \
						-a 200 \
						-i 1 -1 0 0 \
						-s $3
				}
		}
}

// 一階西側の東西通路と南北通路を接続する角（ca014）
proc 西側北角カメラ {
	trap ca014 d:PLAYER -mask ＊ -camera \
		-exec {
			if( $3 == 入る)	{ eval( $i:進入位置Ｘ = $i:前フレーム位置Ｘ ) }

			if( $i:進入位置Ｘ < -6750 ){
			// 西から浸入
				chara カメラ設定 通路カメラ１ \
					-c 1 \
					-p -5414,2576,8951 -t -5414,1939,6852 \
					-r 192,2048,0 -f 2194 \
					-a 300 \
					-i 0 -1 0 0 \
					-s $3
				eval( $w:１トラップ前カメラ進入方向 = d:西 )
				eval( $w:カメラ補完方式 = 1 )
			}else{
			// 南から浸入
				@CS_スムーズカメラ昇順 $4 -6750 -5250 1000 0
						eval( $w:補完距離 = $i:CS_結果１ )

				chara カメラ設定 通路カメラ１ \
					-c 0 \
					-b -10361,4968,-5758  -6269,4968,-5758 \
					-l -10361,1096,-6362  -6269,1096,-6362 \
					-r 923,2048,0 -f 3919 \
					-a 200 \
					-i 0 -1 0 0 \
					-slide 0 2 $w:補完距離 1000 60 0 \
					-s $3
				eval( $w:１トラップ前カメラ進入方向 = d:南 )
				eval( $w:カメラ補完方式 = 0 )
			}
		}
}


// 一階東通路（東西方向）（ca015）
proc 東側東西方向通路カメラ {
	trap ca015 d:PLAYER -mask ＊ -camera \
		-exec {
			if( $3 == 入る ){
				if( $w:１トラップ前カメラ進入方向 == d:東 ) {
					eval( $w:カメラ補完方式 = 0 )
				}else{
					eval( $w:カメラ補完方式 = 1 )
				}
			}

			chara カメラ設定 通路カメラ１ \
				-c 0 \
				-b 6269,4968,-5758  10361,4968,-5758 \
				-l 6269,1096,-6362  10361,1096,-6362 \
				-r 923,2048,0 -f 3919 \
				-a 200 \
				-i $w:カメラ補完方式 -1 0 0 \
				-slide 0 2 1000 1000 60 0 \
				-s $3
		}
}

proc 東側南北方向通路カメラ {
	trap ca016 d:PLAYER -mask ＊ -camera \
		-exec {
				if( $3 == 入る ){	// 南から進入時
					if( $6 > 0 ){
						eval( $w:カメラ補完方式 = 1 )
						eval( $f:カメラタイプ = 0 )
					}else{
						// 北から進入時のカメラ補完方式はca017で値が代入済み
						eval( $f:カメラタイプ = 1 )
					}
				}

				if( $f:カメラタイプ ){
					@CS_スムーズカメラ昇順 $6 -5000 5000 300 200
						eval( $w:補完画角 = $i:CS_結果１ )
					@CS_スムーズカメラ昇順 $6 -5000 5000 5414 5200
						eval( $i:補完ＰＸ = $i:CS_結果１ )
					@CS_スムーズカメラ昇順 $6 -5000 5000 2576 2700
						eval( $i:補完ＰＹ = $i:CS_結果１ )
					@CS_スムーズカメラ昇順 $6 -5000 5000 8951 9917
						eval( $i:補完ＰＺ = $i:CS_結果１ )
					@CS_スムーズカメラ昇順 $6 -5000 5000 5414 5200
						eval( $i:補完ＴＸ = $i:CS_結果１ )
					@CS_スムーズカメラ昇順 $6 -5000 5000 1939 1762
						eval( $i:補完ＴＹ = $i:CS_結果１ )
					@CS_スムーズカメラ昇順 $6 -5000 5000 6852 7950
						eval( $i:補完ＴＺ = $i:CS_結果１ )

					chara カメラ設定 通路カメラ１ \
						-c 1 \
						-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ \
						-t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ \
						-r 69,2048,0 -f 7000 \
						-a $w:補完画角 \
						-i $w:カメラ補完方式 -1 0 0 \
						-s $3
				}else{
					chara カメラ設定 通路カメラ１ \
						-c 0 \
						-b 5500,2000,-10000  5500,4000,10000 \
						-l 5500,1000,-10000  5500,1000,10000 \
						-r 80,2048,0 -f 7000 \
						-a 200 \
						-i 1 -1 0 0 \
						-s $3
				}
		}
}

// 一階東側の東西通路と南北通路を接続する角（ca017）
proc 東側北角カメラ {
	trap ca017 d:PLAYER -mask ＊ -camera \
		-exec {
			if( $3 == 入る)	{ eval( $i:進入位置Ｘ = $i:前フレーム位置Ｘ ) }

			if( $i:進入位置Ｘ > 6750 ){
			// 東から浸入
				chara カメラ設定 通路カメラ１ \
					-c 1 \
					-p 5414,2576,8951 -t 5414,1939,6852 \
					-r 192,2048,0 -f 2194 \
					-a 300 \
					-i 0 -1 0 0 \
					-s $3
				eval( $w:１トラップ前カメラ進入方向 = d:東 )
				eval( $w:カメラ補完方式 = 1 )
			}else{
			// 南から浸入
				@CS_スムーズカメラ昇順 $4 5250 6750 0 1000
						eval( $w:補完距離 = $i:CS_結果１ )

				chara カメラ設定 通路カメラ１ \
					-c 0 \
					-b 10361,4968,-5758  6269,4968,-5758 \
					-l 10361,1096,-6362  6269,1096,-6362 \
					-r 923,2048,0 -f 3919 \
					-a 200 \
					-i 0 -1 0 0 \
					-slide 0 2 1000 $w:補完距離 60 0 \
					-s $3
				eval( $w:１トラップ前カメラ進入方向 = d:南 )
				eval( $w:カメラ補完方式 = 0 )
			}
		}
}

// 一階南端通路（東西方向）（ca020）
proc 東西方向南端通路カメラ {
	trap ca020 d:PLAYER -mask ＊ -camera \
		-exec {
			chara カメラ設定 通路カメラ１ \
				-c 0 \
				-b -5200,2700,9917  5200,2700,9917 \
				-l -5200,1762,7950  5200,1762,7950 \
				-r 290,2048,0 -f 2179 \
				-a 200 \
				-i 2 -1 0 0 \
				-slide 0 5 1000 1000 50 0 \
				-s $3
		}
}

proc 東西方向南端通路張り付きカメラ {
	trap ca023 d:PLAYER \
		-mask ＊ \
		-camera -state 4 \
		-d 2048 512 \
		-exec {
			chara カメラ設定 通路カメラ０ \
				-c 0 \
				-b -5800,4131,6782  5800,4131,6782 \
				-l -5800,1965,6672  5800,1965,6672 \
				-r 290,2048,0 -f 2179 \
				-a 200 \
				-i 2 -1 0 0 \
				-slide 0 5 1000 1000 50 0 \
				-s $3
			if( $3 == 出る ) {
				eval( $f:柱ＯＮフラグ = 0 )
			}else{
				eval( $f:柱ＯＮフラグ = 1 )
			}
			//mesg プットオブジェ 左柱 on
			//mesg プットオブジェ 右柱 on

		}
}

proc 南西角カメラ {
	trap ca021 d:PLAYER -mask ＊ -camera \
		-exec {
			chara カメラ設定 通路カメラ１ \
				-c 0 \
				-b -5200,2700,9917  5200,2700,9917 \
				-l -5200,1762,7950  5200,1762,7950 \
				-r 150,2048,0 -f 2198 \
