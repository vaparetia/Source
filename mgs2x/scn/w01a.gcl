/***************************************************************************************************/
//	マップ宣言
/***************************************************************************************************/
chara マップ １Ｆ廻廊部 -k w01a 0 0 0 -k w01af 0 0 0 -h w01a,0 -l w01a
chara マップ ロッカー部屋 -k w01alc 0 0 0 -h w01a,1 -l w01a

chara マップ接合 １Ｆ廻廊部／ロッカー部屋＿左 １Ｆ廻廊部 ロッカー部屋
chara マップ接合 １Ｆ廻廊部／ロッカー部屋＿右 １Ｆ廻廊部 ロッカー部屋

/***************************************************************************************************/
//	各マップのキャラ設定
/***************************************************************************************************/

// 居住区１Ｆ廻廊部側全共通
command マップ設定 １Ｆ廻廊部 ロッカー部屋 \
-set{
	@居住区１Ｆサウンド設定				// ステージの最初で呼び出す
	@常駐キャラ設定
	@居住区１Ｆカメラ設定
	@プレイヤー設定
	@ポーズ時ステージ名表示設定 d:wn_船橋一階居住区

#if d:ENEMY
	@居住区１Ｆ敵兵設定
	//@敵兵ルート変更１	// ロッカールームに入ったときのルートチェンジ
	@居住区１ＦＢＧＭマネージャー設定	// コマンダーの後で呼び出す
#endif

	@子画面設定
	@シナリオデモキャラセット

	@天井
	@プットオブジェセット
	@主観／ビハインド時の表示
	@消火器セット

// ドア
	@ロッカー部屋左ドア
	@ロッカー部屋右ドア

// エフェクト
	@フォグ
	@遠近ぼかしセット
	@鏡面モデル制御
	@ロードモデルの窓雨
	@水溜まり
	@羽虫チェック

//	@レーダー当たり追加登録

	@アイテム初期設定

	// デバッグ
	#if d:MY_DEBUG
		@写真撮影用スクリーンショット
		@ＵＳＢキーボードセット
	#endif

// 最終で行う処理
	@タンカーデジカメ写真判定
	@座標取得

}

command マップ設定 １Ｆ廻廊部  \
-set{

	@ドアからの隙間風

// カメラ設定
	@西端廊下クランク部左カメラ
	@東端廊下クランク部右カメラ
	@西側東西方向通路カメラ
	@西側南北方向通路カメラ
	@西側北角カメラ
	@東側東西方向通路カメラ
	@東側南北方向通路カメラ
	@東側北角カメラ
	@東西方向南端通路カメラ
	@東西方向南端通路張り付きカメラ
	@南西角カメラ
	@南東角カメラ
// ロードトラップ
	//@左舷廻廊から左舷甲板へロード		// 水密ドアから呼び出す
	//@右舷廻廊から右舷甲板へロード		// 水密ドアから呼び出す
	//@左舷廻廊Ａから左舷廻廊Ｆへロード // 水密ドアから呼び出す
	@右舷廻廊からリフレッシュルーム右側廊下へロード

// ドアトラップ
	//@左舷廻廊ドア
	@右舷廻廊ドア
	@水密ドア三つ
	@水密ドア取れるハンドル
#ifndef d:TGS2001F
	@エンジン前コンテナ塞ぎ
#endif
}

command マップ設定 ロッカー部屋 \
-set{

	@ロッカー設置
	@ロッカー隙間用プロック
	@ロッカー部屋カメラ中央
	//@ロッカー部屋カメラ右
	//@ロッカー部屋カメラ左
	@ロッカー部屋カメラ張り付き
	@壊れライト設定
	@グラビアカメラ
}


/***************************************************************************************************/
// 無線関係のインクルード 位置変更不可
/***************************************************************************************************/
#include "w01a_cdc.ch"

/***************************************************************************************************/
//	マップ表示
/***************************************************************************************************/
command マップ表示 -show １Ｆ廻廊部


// とりあえず最後にキャラ環境光設定
@キャラ専用環境光設定

/***************************************************************************************************/
// ステージ開始時フェードイン
/***************************************************************************************************/
// 全てのセットが終わったところでフェードイン
if( $s:登場ポイント == 左舷甲板からロード ) {
	@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:WT_DOOR_TYPE 西側水密ドア 1700 d:DEFAULT_M_TYPE d:wn_船橋一階居住区左舷
	@カメラ曇り
	@水飛沫
} else if( $s:登場ポイント == リフレッシュルーム左舷からロード ) {
	@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:WT_DOOR_TYPE 西側廻廊部水密ドア 2200 d:DEFAULT_M_TYPE d:wn_船橋一階居住区左舷
	mesg プットオブジェ ロード用Ｗ０１ｆ１ on
	chara delay ディレイ -time 120 -exec {
		mesg プットオブジェ ロード用Ｗ０１ｆ１ off
	}
} else if( $s:登場ポイント == リフレッシュルーム右舷からロード ) {
	@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:SL_DOOR_TYPE 右舷リフレッシュへのドア 1700 d:DEFAULT_M_TYPE d:wn_船橋一階居住区右舷
}


/***************************************************************************************************/
//	エフェクト
/***************************************************************************************************/
	proc 羽虫チェック {

		if( $b:w01f_羽虫レーションゲッ虫回数 ) {
			eval( $b:w01f_羽虫レーションゲッ虫回数 = 0 )

			chara 電灯虫 たかり虫 \
				-n	1 \
				-p	4989 4027 -8451 \	// ライト位置 ->> プレイヤー誘導時は無視
				-b	0 \	// 下のバウンディングボックスで壁との当たり見るか  1 : 判定あり, 0 : 判定なし
				-s	200 200 200 \	// 最小ボックス座標
				-l	500 500 500	// 最大ボックス座標

			mesg 電灯虫 たかり虫 人誘導 d:PLAYER
		}
	}

	proc カメラ曇り {
		chara カメラ前曇り カメラ曇り -t 250
	}

	proc 水溜まり {
		chara 水溜り管理 水溜り管理人 \
			-n_obj	4 \
			-obj	d:PLAYER \
				警備兵:01 \
				攻撃兵:01 \
				攻撃兵:02

		// 完全版から切り替えるように変更
		command トラップ切り替え \
			-trap puddle:01 \
			-switch 1

		trap puddle ？ \
		-mask ？ \
		-exec {
			if($3 == 入る){
				mesg 水溜り管理 水溜り管理人 入る $2
			}else{
				mesg 水溜り管理 水溜り管理人 出る $2
			}
		}
	}


	proc グラビアカメラ {
		// 左上
		trap ev002 d:PLAYER \
			-mask ＊ \
			-dir 0 512 \
			-state d:TRP_STATE_CAUTION \
			-exec {
				command ロッカー状態 -n ロッカー１
				if( ($status & 0x0002) && !($status & 0x2000) ){
					chara カメラ設定 通路カメラ０ \
						-c 1 \
						-p -3795,1690,3648 -t -3610,1371,2318 \
						-r 152,1958,0 -f 1380 \
						-a 200 \
						-i 1 1 0 0 \
						-s 1
				}else{
					chara delay カメラＯＦＦ -time 2 -exec {
						chara カメラ設定 通路カメラ０ -s -1
					}
				}
				if( $3 == 出る ){
					chara delay カメラＯＦＦ -time 2 -exec {
						chara カメラ設定 通路カメラ０ -s -1
					}
				}
			}

		// 右下
		trap ev003 d:PLAYER \
			-mask ＊ \
			-dir 2048 512 \
			-state d:TRP_STATE_CAUTION \
			-exec {
				command ロッカー状態 -n ロッカー６
				if( ($status & 0x0002) && !($status & 0x2000) ){
					chara カメラ設定 通路カメラ０ \
						-c 1 \
						-p 2926,1898,2077 -t 3749,1265,3888 \
						-r 201,278,0 -f 2087 \
						-a 200 \
						-i 1 1 0 0 \
						-s $3
				}else{
					chara delay カメラＯＦＦ -time 2 -exec {
						chara カメラ設定 通路カメラ０ -s -1
					}
				}
				if( $3 == 出る ){
					chara delay カメラＯＦＦ -time 2 -exec {
						chara カメラ設定 通路カメラ０ -s -1
					}
				}
			}

		// 匍匐用左
		trap ev004 d:PLAYER \
			-mask ＊ \
			-state d:TRP_STATE_GROUND \
			-exec {
				command ロッカー状態 -n ロッカー１
				if( $status & 0x2000 ){
					chara カメラ設定 通路カメラ０ \
						-c 0 \
						-b -10000,0,-10000  10000,3000,10000 \
						-l -10000,0,-10000  10000,3000,10000 \
						-r 936,2048,0 -f 2516 \
						-a 200 \
						-i 1 1 0 0 \
						-s $3
				}

				// 念のためトラップから出た時、確実にカメラをＯＦＦしておく
				if( $3 == 出る ){
					chara delay カメラＯＦＦ -time 2 -exec {
						chara カメラ設定 通路カメラ０ -s -1
					}
				}
			}
		// 匍匐用右
		trap ev005 d:PLAYER \
			-mask ＊ \
			-state d:TRP_STATE_GROUND \
			-exec {
				command ロッカー状態 -n ロッカー６
				if( $status & 0x2000 ){
					chara カメラ設定 通路カメラ０ \
						-c 0 \
						-b -10000,0,-10000  10000,3000,10000 \
						-l -10000,0,-10000  10000,3000,10000 \
						-r 951,2048,0 -f 3597 \
						-a 200 \
						-i 1 1 0 0 \
						-s $3
				}

				// 念のためトラップから出た時、確実にカメラをＯＦＦしておく
				if( $3 == 出る ){
					chara delay カメラＯＦＦ -time 2 -exec {
						chara カメラ設定 通路カメラ０ -s -1
					}
				}
			}
	}

/***************************************************************************************************/
// トラップドアのproc化
/***************************************************************************************************/

	// リフレッシュルームへのドア
	proc 左舷廻廊ドア {
		chara ドア 左舷リフレッシュへのドア \
			-m w01a_dr -d 0 0 0 -p -11550 0 -11000 -slide 2000 -time d:SD_OPEN_TIME \
			-between １Ｆ廻廊部 １Ｆ廻廊部 \
			-exec{
	/*
		// 開かない扉
				if( !($:開閉フラグ) ){
					mesg プットオブジェ ロード用Ｗ０１ｆ１ off
				}else{
					mesg プットオブジェ ロード用Ｗ０１ｆ１ on
				}
	*/
			}
	/*
		trap dr000 ？ -mask ＊  \
			-exec {
				if ( $3 == 入る ) {
					mesg ドア 左舷リフレッシュへのドア open
				}else if( $3 == 出る ){
					mesg ドア 左舷リフレッシュへのドア close
				}

				// 主観時の左右覗き込み操作禁止
				if( `command PlayerStatus -f d:TRP_STATE_SUBJECT ` ){
					command パッド操作 -which 0 -mask ( d:PAD_L2 | d:PAD_R2 )
				}else{
					command パッド操作 -which 0 -cancel 2
				}
			}
	*/
	}

	proc 右舷廻廊ドア {
		chara ドア 右舷リフレッシュへのドア \
			-m w01a_dr -d 0 2048 0 -p 11550 0 -11000 -slide 2000 -time d:SD_OPEN_TIME \
			-between １Ｆ廻廊部 １Ｆ廻廊部 \
			-exec{
				if( !($:開閉フラグ) ){
					mesg プットオブジェ ロード用Ｗ０１ｆ２ off
				}else{
					mesg プットオブジェ ロード用Ｗ０１ｆ２ on
				}
			}
		trap dr001 ？ -mask ＊ \
			-exec {
				if ( $3 == 入る ) {
					mesg ドア 右舷リフレッシュへのドア open
				} else if( $3 == 出る ){
					mesg ドア 右舷リフレッシュへのドア close
				}
			}

		chara 透明壁 覗きこみ禁止壁 \
				-position	9750,0,-11000,2000 \
							11750,0,-11000,2000 \
				-attribute		( d:HZX_SEG_NO_BULLET | d:HZX_SEG_NO_MISSILE | d:HZX_SEG_NO_C4 | \
								  d:HZX_SEG_NO_RECOIL | d:HZX_SEG_NO_HARITSUKI | d:HZX_SEG_NO_DISP_RADAR | \
								  d:HZX_SEG_NO_BULLETHOLE | d:HZX_SEG_NO_SPRAY | d:HZX_SEG_NO_ENEMY_EYES | d:HZX_SEG_NO_ENEMY )

		mesg 透明壁 覗きこみ禁止壁 off

		trap dr001 d:PLAYER -mask ＊ \
			-exec {
				// 主観時の左右覗き込み操作禁止
				if( `command PlayerStatus -f d:TRP_STATE_SUBJECT ` ){
					//command パッド操作 -which 0 -mask ( d:PAD_L2 | d:PAD_R2 )
					mesg 透明壁 覗きこみ禁止壁 on
				}else{
					//command パッド操作 -which 0 -cancel 2
					mesg 透明壁 覗きこみ禁止壁 off
				}
			}
	}

	// ロッカー部屋ドアの設定
	proc ロッカー部屋左ドア {
		chara ドア ロッカー部屋の左ドア \
			-m w01alcDoorL \
			-p -4000 0 5900 \
			-d 0 0 0 \
			-slide 2000 \
			-time d:SD_OPEN_TIME \
			-between １Ｆ廻廊部 ロッカー部屋 \
			-exec {
				if( $:開閉フラグ == 0 ){
					//mesg マップ接合 １Ｆ廻廊部／ロッカー部屋＿左 off
					command 即時マップ接合変更 １Ｆ廻廊部／ロッカー部屋＿左 off
				} else {
					//mesg マップ接合 １Ｆ廻廊部／ロッカー部屋＿左 on
					command 即時マップ接合変更 １Ｆ廻廊部／ロッカー部屋＿左 on
				}
			}

		trap dr004 ？ -mask ？ /*-d 2048 256*/ \
			-exec {
				if ( $3 == 入る ) {
					mesg ドア ロッカー部屋の左ドア open
				} else{
					mesg ドア ロッカー部屋の左ドア close
				}
			}
	}

	proc ロッカー部屋右ドア {
		chara ドア ロッカー部屋の右ドア \
			-m w01alcDoorR -d 0 0 0 -p 4000 0 5900 -slide -2000 -time d:SD_OPEN_TIME \
			-between １Ｆ廻廊部 ロッカー部屋 \
			-exec {
				if( $:開閉フラグ == 0 ){
					//mesg マップ接合 １Ｆ廻廊部／ロッカー部屋＿右 off
					command 即時マップ接合変更 １Ｆ廻廊部／ロッカー部屋＿右 off
				} else {
					//mesg マップ接合 １Ｆ廻廊部／ロッカー部屋＿右 on
					command 即時マップ接合変更 １Ｆ廻廊部／ロッカー部屋＿右 on
				}
			}

		trap dr005 ？ -mask ？ \
			-exec {
				if ( $3 == 入る ) {
					mesg ドア ロッカー部屋の右ドア open
				} else {
					mesg ドア ロッカー部屋の右ドア close
				}
			}
	}

/***************************************************************************************************/
// 水密ドアの設定
/***************************************************************************************************/
	proc 水密ドア三つ{
		chara 水密ドア管理 水密ドア管理人 -n 3 \
			-seno 1 \
			-motions sna_hatch hatch_door_sna hatch_handle_sna

		@左舷甲板への水密ドア
		@右舷甲板への水密ドア
		@左舷廻廊への水密ドア
	}

	proc 左舷甲板への水密ドア {
		if( $s:登場ポイント == 左舷甲板からロード ) {
			chara 水密ドア 西側水密ドア \
				-kms w01asdr_body_r w01asdr_handle \
				-position (-8175-1150) 0 -5050 \
				-type 0 \	// 左軸
				-rotate 0,0,0 \
				-flag d:WT_DOOR_FLAG_OPEN_START \
				-hazard -9250,0,-5200 -8250,0,-5200 \
				-proc 左舷廻廊から左舷甲板へロード
		}else{
			chara 水密ドア 西側水密ドア \
				-kms w01asdr_body_r w01asdr_handle \
				-position (-8175-1150) 0 -5050 \
				-type 0 \	// 左軸
				-rotate 0,0,0 \
				-hazard -9250,0,-5200 -8250,0,-5200 \
				-proc 左舷廻廊から左舷甲板へロード
		}

		trap dr002 d:PLAYER -mask いる -button d:ACTION_BUTTON -state 0 \
			-exec {
				command 水密ドア状態 -n 西側水密ドア
				mesg プレイヤー d:PLAYER wt_door 西側水密ドア $status 0,1024 (-8175-1150),-5050 1
		}

		trap dr002 d:PLAYER -mask ？ -state 6 \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 1 ) {
					if( $w:アラートモード == 0 ){
						chara カメラ設定 モーションカメラ \
							-c 1 \
							-p -8758,4553,-5545 -t -8758,656,-5911 \
							-r 963,2048,0 -f 3914 \
							-a 371 \
							-i 3 3 0 0 \
							-s $3
					}else{
						chara カメラ設定 モーションカメラ \
							-c 1 \
							-p -8784,4750,-5650 -t -8784,1000,-6150 \
							-r 937,2048,0 -f 3783 \
							-a 200 \
							-i 3 3 0 0 \
							-s $3
					}
				}
			}

		// ステージスタート時のロードカメラ
		trap dr106 d:PLAYER -mask ？ \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 0 ) {
					chara カメラ設定 モーションカメラ \
							-c 1 \
							-p -5306,2648,-6252 -t -8514,1155,-5428 \
							-r 276,3236,0 -f 3633 \
							-a 200 \
							-i 1 0 0 0 \
							-s $3

					mesg ローカル風 隙間風 オン

					chara delay ディレイ -time 1 -exec {
						command ＳＥセットモード -s d:se_code:SD_A_DRCRAIN1 -p -8750 1000 -5250 -m 0
					}
					chara delay ディレイ -time 100 -exec {
						mesg ローカル風 隙間風 オフ
					}
				}
			}
	}

	proc 右舷甲板への水密ドア {
		chara 水密ドア 東側水密ドア \
			-flag d:WT_DOOR_FLAG_NOT_OPEN \
			-kms w01asdr_body_l w01asdr_handle \
			-position (8175+1150) 0 -5050 \
			-type 1 \	// 右軸
			-rotate 0,2048,0 \
			-hazard 8250,0,-5200 9250,0,-5200 \
			-proc 右舷廻廊から右舷甲板へロード

		trap dr003 d:PLAYER \
			-mask いる -button d:ACTION_BUTTON -state 0 \
			-exec {
				eval($f:rft_w01a取れる水密扉取れた = 1)		//fukushima
				command 水密ドア状態 -n 東側水密ドア
				mesg プレイヤー d:PLAYER wt_door 東側水密ドア $status 0,1024 (8175),-5050 1
		}
		trap dr003 d:PLAYER -mask ？ -state 6 \
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 8784,4750,-5650 -t 8784,1000,-6150 \
					-r 937,2048,0 -f 3783 \
					-a 200 \
					-i 3 3 0 0 \
					-s $3
			}

		// ステージスタート時のロードカメラ
		trap dr107 d:PLAYER -mask ？ \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 0 ) {
					chara カメラ設定 モーションカメラ \
							-c 1 \
							-p 5306,2648,-6252 -t 8514,1155,-5428 \
							-r 276,3236,0 -f 3633 \
							-a 200 \
							-i 1 2 0 0 \
							-s $3
				}
			}
	}


	proc 左舷廻廊への水密ドア {
		if( $s:登場ポイント == リフレッシュルーム左舷からロード ) {
			chara 水密ドア 西側廻廊部水密ドア \
				-kms w01asdr_body_r w01asdr_handle \
				-position -11375 0 -10950 \
				-type 0 \	// 左軸
				-rotate 0,0,0 \
				-flag ( d:WT_DOOR_FLAG_OPEN_START | d:WT_DOOR_FLAG_NOT_OPEN ) \
				-hazard -11300,0,-10900 -10300,0,-10900 \
				-proc 左舷廻廊Ａから左舷廻廊Ｆへロード
		}else{
			chara 水密ドア 西側廻廊部水密ドア \
				-kms w01asdr_body_r w01asdr_handle2 \
				-position -11375 0 -10950 \
				-type 0 \	// 左軸
				-rotate 0,0,0 \
				-flag d:WT_DOOR_FLAG_NOT_OPEN \
				-hazard -11300,0,-10900 -10300,0,-10900 \
				-proc 左舷廻廊Ａから左舷廻廊Ｆへロード
		}

		// ハンドル回し中のカメラ
		trap dr000 d:PLAYER -mask ？ -state 6 \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 1 ) {
					chara カメラ設定 モーションカメラ \
						-c 1 \
						-p -11621,1713,-9626 -t -11013,1488,-10239 \
						-r 166,1539,0 -f 892 \
						-a 200 \
						-i 3 3 0 0 \
						-s $3
				}
			}

		// ステージスタート時のロードカメラ
		trap dr108 d:PLAYER -mask ？ \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 0 ) {
					chara カメラ設定 モーションカメラ \
						-c 1 \
						-p -9972,2505,-8428 -t -10757,941,-10299 \
						-r 428,2307,0 -f 2562 \
						-a 200 \
						-i 0 2 0 0 \
						-s $3
				}
			}

	// ドア取れるイベント用の設定
		chara 透明壁 敵兵通過不可壁 \
				-position	-7500,0,-5250,2000 \
							-7500,0,-7000,2000

		mesg 透明壁 敵兵通過不可壁 off

		trap dr000 d:PLAYER \
			-mask いる -button d:ACTION_BUTTON -state 0 \
			-exec {
				command ゲット敵兵座標 警備兵:01 $i:敵兵Ｘ $i:敵兵Ｙ $i:敵兵Ｚ

				if(  ( $w:アラートモード == 0 ) && ( $i:敵兵Ｘ > -7000 ) ){
					if( $f:w01a_ドア取れフラグ == 0 ) {

						//////////////////////////////////////////////////////////////////
						// ドア壊しモーションの発動
						//////////////////////////////////////////////////////////////////
						@シナリオデモ開始処理

						mesg 透明壁 敵兵通過不可壁 on

						// 水密ドアのハンドルを非表示
						mesg 水密ドア 西側廻廊部水密ドア handle 0

						eval($f:rft_w01a取れる水密扉取れた = 1)	//fukushima

						// 取れるモーションの表示
						print '表示'
						mesg プットモーションモデル 取れるハンドル 表示

						// プレイヤーのモーション発動
						mesg プレイヤー d:PLAYER motion \
							d:モーションリスト:sna_non_hatch_pop_out \
							2048 \	// 初期方向
							-1 \	// 終了方向
							0 \		// 終了姿勢(立ち)
							( d:FA_NO_CHECK_SEG | d:FA_NO_CHECK_FLR | d:FA_USE_NOW_HEIGHT | d:FA_NO_WEAPON ) \
							-10800 -10280 1000	//x,z,yの順

						// ハンドルのモーション発動
						mesg プットモーションモデル 取れるハンドル 終了判定  0

						// 終了プロックの登録
						command	強制モーション終了プロック \
							-motion d:モーションリスト:sna_non_hatch_pop_out \
							-proc 取れるハンドル終了プロック
						#if d:DEMO_CANCEL
							chara デモキャンセルチェック Ch_ハンドルイベントキャンセル \
								-p Pr_ハンドルイベントキャンセル
						#endif

						//////////////////////////////////////////////////////////////////
						// ここまで
						//////////////////////////////////////////////////////////////////
					}else{
						command 水密ドア状態 -n 西側廻廊部水密ドア
						mesg プレイヤー d:PLAYER wt_door 西側廻廊部水密ドア $status 2048,1024 -11375,-10950 1
					}
				}else{
					command 水密ドア状態 -n 西側廻廊部水密ドア
					mesg プレイヤー d:PLAYER wt_door 西側廻廊部水密ドア $status 2048,1024 -11375,-10950 1
				}
		}
	}

	#if d:DEMO_CANCEL
		proc Pr_ハンドルイベントキャンセル {
		print 'ハンドルイベントキャンセル'

			mesg デモキャンセルチェック Ch_ハンドルイベントキャンセル kill

			command 強制モーションキャンセル
		}
	#endif

	proc 取れるハンドル終了プロック {
		print 'ハンドルデモ終了プロック start'

		#if d:DEMO_CANCEL
			mesg デモキャンセルチェック Ch_ハンドルイベントキャンセル kill
		#endif

		mesg 水密ドア 西側廻廊部水密ドア handle 1
		mesg プットモーションモデル 取れるハンドル 非表示
		mesg 透明壁 敵兵通過不可壁 off

		@シナリオデモ終了処理

		eval( $f:w01a_ドア取れフラグ = 1 )
		#if d:VAR_SAVE
			command varsave $f:w01a_ドア取れフラグ
		#endif
		print 'ハンドルデモ終了プロック end'
	}

/***************************************************************************************************/
// 入出ロードのproc化
/***************************************************************************************************/
	proc ロードプロック {
		if ($s:呼び出しプロック == mv_w01a_w00a_0) {
			@mv_w01a_w00a_0
		} else if ($s:呼び出しプロック == mv_w01a_w00a_1) {
			@mv_w01a_w00a_1
		} else if ($s:呼び出しプロック == mv_w01a_w01f_0x) {
			@mv_w01a_w01f_0x
		} else if ($s:呼び出しプロック == mv_w01a_w01f_1x) {
			@mv_w01a_w01f_1x
		}
	}

	proc 左舷廻廊から左舷甲板へロード $:トリガ {
	#if d:LOAD_00A_L
			if ( $:トリガ == 0 ) {	// 扉が完全に開いたら
				chara カメラ設定 ロードカメラ \
					-c 1 \
					-p -8784,4750,-5650 -t -8784,1000,-6150 \
					-r 937,2048,0 -f 3783 \
					-a 200 \
					-i 3 0 0 0 \
					-s 1

				preseek 'w00a'
				@ステージ終了時処理（ステージ名表示） -8750 0 -3000 0 mv_w01a_w00a_0 d:DEFAULT_M_TYPE d:wn_船尾甲板左舷
			}else if ( $:トリガ == 3 ) {
				// 水密ドアが開き始めたら隙間風を吹かす
				chara delay ディレイ -time 45 -exec {
					mesg ローカル風 隙間風 オン
					command ＳＥセットモード -s d:se_code:SD_A_DRORAIN1 -p -8750 1000 -5250 -m 0
				}
			}
	#endif
	}

	proc 右舷廻廊から右舷甲板へロード $:トリガ {
	#if d:LOAD_00A_R
			if( $:トリガ == 0 ){	// 扉が完全に開いたら
				chara カメラ設定 ロードカメラ \
					-c 1 \
					-p 8784,4750,-5650 -t 8784,1000,-6150 \
					-r 937,2048,0 -f 3783 \
					-a 200 \
					-i 3 0 0 0 \
					-s 1

				preseek 'w00a'
				@ステージ終了時処理（ステージ名表示） 8750 0 -3000 0 mv_w01a_w00a_1 d:DEFAULT_M_TYPE

			}else if ( $:トリガ == 3 ) {
				// 水密ドアが開き始めたら隙間風を吹かす
				chara delay ディレイ -time 45 -exec {
					mesg ローカル風 隙間風 オン
				}
			}
	#endif
	}

	proc 左舷廻廊Ａから左舷廻廊Ｆへロード $:トリガ {
	#if d:LOAD_01F_L
		if( $f:ロードチェックＯＮフラグ == 1 ) {
			if( $:トリガ == 3 ){		// 扉が開き始めたら
				mesg プットオブジェ ロード用Ｗ０１ｆ１ on
			}else if( $:トリガ == 0 ) {	// 扉が完全に開いたら
				chara カメラ設定 ロードカメラ \
					-c 1 \
					-p -10158,2529,-7930 -t -10558,1370,-9549 \
					-r 396,2206,0 -f 2031 \
					-a 200 \
					-i 3 0 0 0 \
					-s 1

				preseek 'w01f'
				@ステージ終了時処理（ステージ名表示） -10750 0 -13000 2048 mv_w01a_w01f_0x d:DEFAULT_M_TYPE
			}
		}
	#endif
	}

	proc 右舷廻廊からリフレッシュルーム右側廊下へロード {
	#if d:LOAD_01F_R
		trap ld003 d:PLAYER -mask 入る \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 1 ) {
					chara カメラ設定 ロードカメラ \
						-c 1 \
						//-p 10750,1500,-5175 -t 10750,1025,-11000 \
						//-r 53,2048,0 -f 5844 \
						//-a 200 \
						-p 11272,1969,-7650 -t 10579,1461,-10067 \
						-r 130,2230,0 -f 2566 \
						-a 200 \
						-i 3 0 0 0 \
						-s $3

					preseek 'w01f'
					@ステージ終了時処理（ステージ名表示） 10750 0 -13000 2048 mv_w01a_w01f_1x d:DEFAULT_M_TYPE d:wn_船橋一階リフレッシュルーム右舷
					//eval( $w:スタートアラートモード = $w:アラートモード )
				}
			}

		// ステージスタート時のロードカメラ
		trap dr109 d:PLAYER -mask ？ \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 0 ) {
					chara カメラ設定 ロードカメラ \
						-c 1 \
						//-p 11462,2651,-7436 -t 10687,1062,-9666 \
						//-r 386,2266,0 -f 2846 \
						//-a 200 \
						-p 11272,1969,-7650 -t 10579,1461,-10067 \
						-r 130,2230,0 -f 2566 \
						-a 200 \
						-i 0 2 0 0 \
						-s $3
				}
			}
	#endif
	}

/***************************************************************************************************/
// オブジェクトのproc化
/***************************************************************************************************/
	proc 天井 {
		chara 天井君 天井 -m w01ar -h 2800 -p 0,0,0  -l w01a
		chara 天井君 ロッカー天井 -m w01alcr -h 2800 -p 0,0,0 -l w01a -v ライトの表示制御
	}

	proc ライトの表示制御 {
		//mesg プットスポットライトオブジェ 照明モデル左 ライト管理 $1
		//mesg プットスポットライトオブジェ 照明モデル右 ライト管理 $1
		command プットスポットライトオブジェライト管理 \
			-n 照明モデル左 \
			-f $1

		command プットスポットライトオブジェライト管理 \
			-n 照明モデル右 \
			-f $1
	}
/***************************************************************************************************/
//	プットオブジェ
/***************************************************************************************************/
// ロード用モデルセット
	proc プットオブジェセット {
	// ロード用モデル
		chara プットオブジェ ロード用Ｗ０１ｆ１ -m w01a_w01f_1 -r 0,0,0 -p 0,0,0 -l w01a -s 100,100,100
		mesg プットオブジェ ロード用Ｗ０１ｆ１ off

		chara プットオブジェ ロード用Ｗ０１ｆ２ -m w01a_w01f_2 -r 0,0,0 -p 0,0,0 -l w01a -s 100,100,100
		mesg プットオブジェ ロード用Ｗ０１ｆ２ off
	// 柱セット
		chara プットオブジェ 左柱 -m w01a_pillar_l -r 0 0 0 -p 0 0 0 -l w01a -s 100 100 100
		mesg プットオブジェ 左柱 off
		chara プットオブジェ 右柱 -m w01a_pillar_r -r 0 0 0 -p 0 0 0 -l w01a -s 100 100 100
		mesg プットオブジェ 右柱 off
	}

/***************************************************************************************************/
// エフェクトのproc化
/***************************************************************************************************/
	proc フォグ {
	#if d:FOG
		chara フォグ 霧	-c 4 46 30 -n 1000 -f 23000
	#endif
	}

	// キャラ用光源(マップの設置が終わってから設定することで、キャラだけに光を当てる)
	proc キャラ専用環境光設定 {
	#if d:CHARA_AMBIENT
		chara 環境光 環境光 \
			-c 43 73 53

		chara 平行光 平行光 \
			-c 47 77 97 \
			-d 512 2560 0
	#endif
	}

	proc 遠近ぼかしセット {
	#if d:BOKASHI
		chara 遠景ぼかし 遠景ぼかし１ \
			-plane 4 -near 1000 -far 5000

		chara 遠景ぼかし 遠景ぼかし２ \
			-plane 4 -near 5000 -far 10000

		chara 遠景ぼかし 遠景ぼかし３ \
			-plane 4 -near 10000 -far 15000

		chara 近景ぼかし 近景ぼかし１ \
			-plane 3 -near 0 -far 1000

		chara 近景ぼかし 近景ぼかし２ \
			-plane 3 -near 0 -far 3000

		chara 近景ぼかし 近景ぼかし３ \
			-plane 3 -near 0 -far 5000
	#endif
	}

	proc ロードモデルの窓雨 {
		chara 窓雨 左舷廊下窓   -c -10800 1550 -19900  -s 350 450  -r 0 0 0
		chara 窓雨 右舷廊下窓   -c 10800 1550 /*-19900*/-19850   -s 350 450  -r 0 0 0
	}

	proc 消火器セット {
	#if	d:FIRE_HOSE
		chara 消火器 消火器１ \
			-r 0 0 0 \
			-p -7400 0 -2000 \
			-l w01a \
			-b -8000 0 -4000 \
			   -5000 2000 2000

		chara 消火器 消火器２ \
			-r 0 2048 0 \
			-p 7400 0 -2000 \
			-l w01a \
			-b 5000 0 -4000 \
			   8000 2000 2000

		chara 消火器 消火器３ \		// ロッカールーム消火器
			-r 0 2048 0 \
			-p 4700 0 4700 \
			-l w01a \
			-b 1000 0 3000 \
			   (4750-0) 1500 5750
	#endif
	}

/***************************************************************************************************/
// サウンドのproc化
/***************************************************************************************************/
	proc 居住区１Ｆサウンド設定 {

		chara サウンドマネージャー ＳＤマネ -pak 0

		@サウンド効果音設定

		command 弾痕ノーマル -n 0
		command 弾痕ノーマル -n 1
		command 弾痕ノーマル -n 2
		command 弾痕ノーマル -n 3
		command 弾痕ノーマル -n 4

		command 跳弾ノーマル -n 0
		command 跳弾ノーマル -n 1
		command 跳弾ノーマル -n 2
		command 跳弾ノーマル -n 3
		command 跳弾ノーマル -n 4

		// 水蒸気の番号設定
		command 弾痕ノーマル -n 5
		command 弾痕ノーマル -n 6
		command 弾痕ノーマル -n 7
		command 跳弾水蒸気小 -n 5
		command 跳弾水蒸気中 -n 6
		command 跳弾水蒸気大 -n 7
	}

	proc 居住区１ＦＢＧＭマネージャー設定 {
		chara ＢＧＭマネージャー ＢＧＭ
	}

/***************************************************************************************************/
// プレイヤーのproc化
/***************************************************************************************************/

	proc プレイヤー設定 {
	#if d:SNAKE
		chara プレイヤー スネーク \
			-m sna_def \
			-a snake \
			-p $i:プレイヤー初期Ｘ位置 $i:プレイヤー初期Ｙ位置 $i:プレイヤー初期Ｚ位置 \
	//		-p 11250 $i:プレイヤー初期Ｙ位置 $i:プレイヤー初期Ｚ位置 \
			-d 0,$i:プレイヤー初期方向,0 \
			-l 2800 \
			//-homing 6000 128 \
	//		-f d:PLY_NO_FOOT_SHADOW \
			-i 0 \
			-o sna_w01a \	// 強制モーション名
			-s 0
		chara ロープモデル３ バンダナ１ \
			-n sna_bdn1 \
			-d 1 \
			-y スネーク \
			-z 12 \
			-x 0,60,-90 \
			-m 12 \
			-p 250 \
			-k 350 \
			-o 110 \
			-f 1
		chara ロープモデル３ バンダナ２ \
			-n sna_bdn2 \
			-d 1 \
			-y スネーク \
			-z 12 \
			-x 0,50,-90 \
			-m 20 \
			-p 250 \
			-k 350 \
			-o 110 \
			-f 1

		@プレイヤーＬＯＤ設定 d:C_DISTANCE_TYPE 6000
	#else
	#endif
	}

	proc 水飛沫 {
		chara キャラ付随水飛抹 スネーク水飛沫 \
				-nconcname d:PLAYER \
				-addone 32 \
				-time d:CHARA_SPLASH_TIME \
				-rgbadd 0x40404030 \
				-gbsub 0x40404030
	}

	proc 鏡面モデル制御 {
	#if d:MIRROR
		chara 鏡面モデル管理 床面映り込み \
			-pos 0,0,0 \
			-axis 1 // Y軸反転
		mesg 鏡面モデル管理 床面映り込み add d:PLAYER
		mesg 鏡面モデル管理 床面映り込み add 警備兵:01
		mesg 鏡面モデル管理 床面映り込み add 攻撃兵:01
		mesg 鏡面モデル管理 床面映り込み add 攻撃兵:02

	#endif
	}

	proc 写真撮影用スクリーンショット {
		chara スクリーンショット スクリーンショット
	}

/***************************************************************************************************/
// ロッカー関連
/***************************************************************************************************/
	proc ロッカー隙間用プロック {
	#if d:LOCKER_SET

		@南北５０ｃｍ幅透明壁設置 西５０ｃｍ壁 -501 0 2000 2000
		@南北５０ｃｍ幅透明壁設置 東５０ｃｍ壁 501 0 2000 2000

		trap wl001 d:PLAYER \
		-mask ？ \
		-state d:TRP_STATE_CAUTION \
		-exec {
				if( $3 == 入る ) {
					mesg 透明壁 西５０ｃｍ壁 off
					mesg 透明壁 東５０ｃｍ壁 off
				}else{
					mesg 透明壁 西５０ｃｍ壁 on
					mesg 透明壁 東５０ｃｍ壁 on
				}
			}
	#endif
	}

	proc ロッカーチェック $:番号 {
		@壊れ物再セットチェック $b:w01a_破壊ロード回数[$:番号]
		if($f:再セットフラグ) {
			eval($i:w01a_ロッカーロード回数[$:番号] = 0)
		}
	}

	proc ロッカー状態保存 $:番号 $:行動 $:ロッカー名 {
		if(($:行動 != 6) && ($:行動 != 8)) {
			// 状態変化時
			eval($b:w01a_破壊ロード回数[$:番号] = $w:グローバルロード回数);
		} else if($:行動 == 8) {
			// ステージ終了時
			command ロッカー状態 -n $:ロッカー名
			eval($i:w01a_ロッカーロード回数[$:番号] = $status)
		}
	}

	proc ロッカー設置 {
	#if d:LOCKER_SET
		chara ロッカー管理 管理人さん -n 8
		command ロッカーモーション -motion locker
		command プレイヤーロッカーモーション -motion sna_locker

	/* ロッカー左上 */
		@ロッカーチェック 0
		chara ロッカー ロッカー１ \
			-kms w01alc_tobira_nu \		// ビキニポスター１
			-seno 2 \					// SE
			-sefloor 2 \
			-p -4250,0,(2050+50) \
			-r 0,1024,0 \
			-down_rot 0 870 0 \
			-down_shift 0 0 100 \
			//-flag 0x0001 \			// 影が投影される
			-s ( d:LOCKER_STATE_POSTER | d:LOCKER_STATE_NO_OPEN_SEG ) \	//ポスターが張ってあるフラグを指定
			-g 	-250,700,0 -750,1700,0 \
				-300,1250,0 -600,1550,0 \
				-350,850,0 -550,1100,0 \
			-load_state $i:w01a_ロッカーロード回数[0] \
			-exec {
				@ロッカー状態保存 0 $3 $4
			}

		// 開け閉め用トラップ
		trap lk000 d:PLAYER \
			-and \
			-mask いる \
			-state 0,4 \
			-dir 3072,512 1024,512 \
			-button d:ACTION_BUTTON,-1 \
			-exec {
				command ロッカー状態 -n ロッカー１
				mesg プレイヤー d:PLAYER locker ロッカー１ $status 3072,512 -4250,(2000+50)
			}
		// 扉を開け閉めする時のカメラ
		trap lk000 d:PLAYER \
			-mask ？ \
			-state 6 \
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p -2547,2304,3610 -t -3541,1770,2701 \
					-r 246,2589,0 -f 1449 \
					-a 200 \
					-i 2 2 0 0 \
					-s $3
			}

	/* ロッカー左下 */
		@ロッカーチェック 1
		chara ロッカー ロッカー２ \
			-kms d:LOCKER_DOOR_MODELE \
			-seno 2 \
			-sefloor 2 \
			-p -4250,0,(3050+50) \
			-r 0,1024,0 \
			-down_rot 0 512 0 \
			-down_shift 500 0 500 \
			-load_state $i:w01a_ロッカーロード回数[1] \
			-exec {
				@ロッカー状態保存 1 $3 $4
			}
		trap lk001 d:PLAYER \
			-and \
			-mask いる \
			-state 0,4 \
			-dir 3072,512 1024,512 \
			-button d:ACTION_BUTTON,-1 \
			-exec {
				command ロッカー状態 -n ロッカー２
				mesg プレイヤー d:PLAYER locker ロッカー２ $status 3072,512 -4250,(3000+50)
				// 扉の開閉によるアイテムのON_OFF
				if( $f:ロッカーアイテム == 0 ) {
					chara delay ディレイ -time 10 -exec {
						mesg アイテム 左ロッカー オン
						eval( $f:ロッカーアイテム = 1 )
					}
				}else{
					chara delay ディレイ -time 30 -exec {
						mesg アイテム 左ロッカー オフ
						eval( $f:ロッカーアイテム = 0 )
					}
				}
			}
		trap lk001 d:PLAYER \
			-mask ？ \
			-state 6 \
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					/*
					-p -2165,1979,4304 -t -3458,1571,3807 \
					-r 187,2833,0 -f 1444 \
					-a 200 \
					*/
					-p -2618,2724,4155 -t -3483,1631,3779 \
					-r 560,2805,0 -f 1443 \
					-a 200 \
					-i 2 2 0 0 \
					-s $3
			}
	/* 真中左下 */
		@ロッカーチェック 2
		chara ロッカー ロッカー３ \
			-kms d:LOCKER_DOOR_MODELE \
			-seno 2 \
			-sefloor 2 \
			-p -550,0,(4500-50) \
			-r 0,3072,0 \
			-down_rot 0 2750 0 \
			//-down_shift -100 0 300 \
			-down_shift -150 0 350 \
			-load_state $i:w01a_ロッカーロード回数[2] \
			-exec {
				@ロッカー状態保存 2 $3 $4
			}
		trap lk002 d:PLAYER \
			-and \
			-mask いる \
			-state 0,4 \
			-dir 1024,512 3072,512 \
			-button d:ACTION_BUTTON,-1 \
			-exec {
				command ロッカー状態 -n ロッカー３
				mesg プレイヤー d:PLAYER locker ロッカー３ $status 1024,512 -500,(4500-50)
			}
		trap lk002 d:PLAYER \
			-mask ？ \
			-state 6 \
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p -3366,2175,4754 -t -2156,1870,4417 \
					-r 155,1201,0 -f 1292 \
					-a 200 \
					-i 2 2 0 0 \
					-s $3
			}
	/* 真中右下 */
		@ロッカーチェック 3
		chara ロッカー ロッカー４ \
			-kms d:LOCKER_DOOR_MODELE \
			-seno 2 \
			-sefloor 2 \
			-p 550,0,(3500+50) \
			-r 0,1024,0 \
			-down_rot 0 1000 0 \
			-down_shift 0 0 -150 \
			-load_state $i:w01a_ロッカーロード回数[3] \
			-exec {
				@ロッカー状態保存 3 $3 $4
			}
		trap lk003 d:PLAYER \
			-and \
			-mask いる \
			-state 0,4 \
			-dir 3072,512 1024,512 \
			-button d:ACTION_BUTTON,-1 \
			-exec {
				command ロッカー状態 -n ロッカー４
				mesg プレイヤー d:PLAYER locker ロッカー４ $status 3072,512 500,(3500+50)
			}
		trap lk003 d:PLAYER \
			-mask ？ \
			-state 6 \
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 3031,2080,5055 -t 672,1469,3738 \
					-r 145,2740,0 -f 2770 \
					-a 200 \
					-i 2 2 0 0 \
					-s $3
			}
	/* 右側上 */
		@ロッカーチェック 4
		chara ロッカー ロッカー５ \
			-kms d:LOCKER_DOOR_MODELE \
			-seno 2 \
			-sefloor 2 \
			-p 4250,0,(3050-50) \
			-r 0,3072,0 \
			-down_rot 0 2870 0 \
			-down_shift 0 0 200 \
			-load_state $i:w01a_ロッカーロード回数[4] \
			-exec {
				@ロッカー状態保存 4 $3 $4
			}
		trap lk004 d:PLAYER \
			-and \
			-mask いる \
			-state 0,4 \
			-dir 1024,512 3072,512 \
			-button d:ACTION_BUTTON,-1 \
			-exec {
				command ロッカー状態 -n ロッカー５
				mesg プレイヤー d:PLAYER locker ロッカー５ $status 1024,512 4250,(3000-50)
			}
		trap lk004 d:PLAYER \
			-mask ？ \
			-state 6 \
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 1517,2097,3224 -t 3375,1622,2831 \
					-r 160,1160,0 -f 1957 \
					-a 200 \
					-i 2 2 0 0 \
					-s $3
			}
	/* 右下 */
		@ロッカーチェック 5
		chara ロッカー ロッカー６ \
			-kms w01alc_tobira_nu2 \	// ビキニポスター２
			-seno 2 \
			-sefloor 2 \
			-p 4250,0,(4050-50) \
			-r 0,3072,0 \
			-down_rot 0 3400 0 \
			-down_shift 0 0 150 \
			-s d:LOCKER_STATE_POSTER \	//ポスターが張ってあるフラグを指定
			-g 	-250,700,0 -750,1700,0 \
				-300,1250,0 -600,1550,0 \
				-350,850,0 -550,1100,0 \
			-load_state $i:w01a_ロッカーロード回数[5] \
			-exec {
				@ロッカー状態保存 5 $3 $4
			}
		trap lk005 d:PLAYER \
			-and \
			-mask いる \
			-state 0,4 \
			-dir 1024,512 3072,512 \
			-button d:ACTION_BUTTON,-1 \
			-exec {
				command ロッカー状態 -n ロッカー６
				mesg プレイヤー d:PLAYER locker ロッカー６ $status 1024,512 4250,(4000-50)
			}
		trap lk005 d:PLAYER \
			-mask ？ \
			-state 6 \
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 1927,2255,4212 -t 3102,1701,3621 \
					-r 260,1328,0 -f 1427 \
					-a 200 \
					-i 2 2 0 0 \
					-s $3
			}
	/* 真中左上 壊れている */
		@ロッカーチェック 6
		chara ロッカー ロッカー７ \
			-kms d:LOCKER_DOOR_MODELE \
			-seno 2 \
			-sefloor 2 \
			-s d:LOCKER_STATE_DESTROY \
			-p -550,0,(3500-50) \
			-r 0,3072,0 \
			-load_state $i:w01a_ロッカーロード回数[6] \
			-exec {
				@ロッカー状態保存 6 $3 $4
			}

		trap lk006 d:PLAYER \
			-and \
			-mask いる \
			-state 0,4 \
			-dir 1024,512 3072,512 \
			-button d:ACTION_BUTTON,-1 \
			-exec {
				eval($f:rft_開かないロッカー開けた_lk006 = 1)	//fukushima
				command ロッカー状態 -n ロッカー７
				mesg プレイヤー d:PLAYER locker ロッカー７ $status 1024,512 -500,(3500-50)
			}
		trap lk006 d:PLAYER \
			-mask ？ \
			-state 6 \
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p -1945,2841,4839 -t -1031,960,2996 \
					-r 483,1748,0 -f 2788 \
					-a 200 \
					-i 2 2 0 0 \
					-s $3
			}
	/* 真中右上 壊れている */
		@ロッカーチェック 7
		chara ロッカー ロッカー８ \
			-kms d:LOCKER_DOOR_MODELE \
			-seno 2 \
			-sefloor 2 \
			-s d:LOCKER_STATE_DESTROY \
			-p 550,0,(2500+50) \
			-r 0,1024,0 \
			-load_state $i:w01a_ロッカーロード回数[7] \
			-exec {
				@ロッカー状態保存 7 $3 $4
			}
		trap lk007 d:PLAYER \
			-and \
			-mask いる \
			-state 0,4 \
			-dir 3072,512 1024,512 \
			-button d:ACTION_BUTTON,-1 \
			-exec {
				eval($f:rft_開かないロッカー開けた_lk007 = 1)	//fukushima
				command ロッカー状態 -n ロッカー８
				mesg プレイヤー d:PLAYER locker ロッカー８ $status 3072,512 500,(2500+50)
			}
		trap lk007 d:PLAYER \
			-mask ？ \
			-state 6 \
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 3371,2152,5028 -t 1579,1191,3394 \
					-r 246,2590,0 -f 2608 \
					-a 200 \
					-i 2 2 0 0 \
					-s $3
			}
	#endif
	}

	proc 壊れライト設定 {
	#if d:BREAK_LIGHT
		chara プットスポットライトオブジェ 照明モデル左 \
			-m w01alc_lig_L w01alc_lig_L_bro \
			-t -2400,2850,3900 100 4000 \
			-l w01a \
			-p 0,0,0 \
			-b 壊れプロック１

		chara プットスポットライトオブジェ 照明モデル右 \
			-m w01alc_lig_R w01alc_lig_R_bro \
			-t 2400,2850,3900 100 4000 \
			-l w01a \
			-p 0,0,0 \
			-b 壊れプロック２

	#endif
	}

	proc 壊れプロック１ {
	#if d:BREAK_LIGHT
		print ' break 1'
		command トラップ切り替え -trap dark:01 -switch 1
	#endif
	}

	proc 壊れプロック２ {
	#if d:BREAK_LIGHT
		print ' break 2'
		command トラップ切り替え -trap dark:02 -switch 1
	#endif
	}

	proc ドアからの隙間風 {
	#if d:DRAFT
		chara ローカル風 隙間風 \
			-n 2 \
			-d	-10000 0 -5000   -7500 3000 -7000   2500 -512 2048 \
				 7500 0 -5000   10000 3000 -7000   2300 -512 2048

		mesg ローカル風 隙間風 オフ
	#endif
	}

/***************************************************************************************************/
// 攻撃兵の設定
/***************************************************************************************************/
#if d:ENEMY

	// 回避モードでリフレッシュルームとの連絡口を警戒
	proc 攻撃兵Ａ {
		chara アタッカー 攻撃兵:02 \
			-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
			-l $w:敵標準体力 \
			-h $w:敵標準聴力 \
			-f $w:敵標準気絶 \
			-d 6750 0 500 １Ｆ廻廊部 \	// 守備位置
			-r 1 \						// 初期ルート
			-c 8 \						// 探索ルート
			-e 0 \						// 標準装備
			-q レーション_敵兵 30
	}

	// 回避モードで左舷を警戒
	proc 攻撃兵Ｂ {
		chara アタッカー 攻撃兵:01 \
			-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
			-l $w:敵標準体力 \
			-h $w:敵標準聴力 \
			-f $w:敵標準気絶 \
			-d -6750 0 500 １Ｆ廻廊部 \	// 守備位置
			-r 0 \						// 初期ルート
			-c 7 \						// 探索ルート
			-e 0 \						// 標準装備
			-q レーション_敵兵 30
	}

	// 回避モードで右舷を警戒
	proc 攻撃兵Ｃ {
		chara アタッカー 攻撃兵:01 \
			-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
			-l $w:敵標準体力 \
			-h $w:敵標準聴力 \
			-f $w:敵標準気絶 \
			-d -6750 0 500 １Ｆ廻廊部 \	// 守備位置
			-r 0 \						// 初期ルート
			-c 9 \						// 探索ルート
			-e 0 \						// 標準装備
			-q レーション_敵兵 30
	}


	proc 攻撃兵セット {
		/*******************************************************************************************/
		// VERYEASY
		/*******************************************************************************************/
		if($w:ゲーム設定 <= d:LEVEL_VERYEASY) {
			if( ( $s:登場ポイント == リフレッシュルーム右舷からロード ) ) {
				@攻撃兵Ａ
				@攻撃兵Ｃ
			}else{
				@攻撃兵Ａ
				@攻撃兵Ｂ
			}
		/*******************************************************************************************/
		// EASY
		/*******************************************************************************************/
		} else if($w:ゲーム設定 <= d:LEVEL_EASY) {
			if( ( $s:登場ポイント == リフレッシュルーム右舷からロード ) ) {
				@攻撃兵Ａ
				@攻撃兵Ｃ
			}else{
				@攻撃兵Ａ
				@攻撃兵Ｂ
			}
		/*******************************************************************************************/
		// NORMAL
		/*******************************************************************************************/
		} else if($w:ゲーム設定 <= d:LEVEL_NORMAL) {
			if( ( $s:登場ポイント == リフレッシュルーム右舷からロード ) ) {
				@攻撃兵Ａ
				@攻撃兵Ｃ
			}else{
				@攻撃兵Ａ
				@攻撃兵Ｂ
			}
		/*******************************************************************************************/
		// HARD or EXTREME or EUROPEAN_EXTREME
		/*******************************************************************************************/
		} else {
			if( ( $s:登場ポイント == リフレッシュルーム右舷からロード ) ) {
				@攻撃兵Ａ
				@攻撃兵Ｃ
			}else{
				@攻撃兵Ａ
				@攻撃兵Ｂ
			}
		}

	}

/***************************************************************************************************/
// 警備兵の設定
/***************************************************************************************************/

#define ENE_DEF_X_1		6000
#define ENE_DEF_Y_1		0
#define ENE_DEF_Z_1		-6000

#define ENE_DEF_X_2		6000
#define ENE_DEF_Y_2		0
#define ENE_DEF_Z_2		-6000

	// 右舷巡回兵
	proc 警備兵Ａ $:名前 $:ルート {
		chara 警備兵 $:名前 \
				-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
				-l $w:敵標準体力 -f $w:敵標準気絶 -h $w:敵標準聴力 \
				-d d:ENE_DEF_X_1 d:ENE_DEF_Y_1 d:ENE_DEF_Z_1 １Ｆ廻廊部 \
				-r $:ルート -n 0 \
				-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
				-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
				-j ドッグタグ_敵兵	[ dogtag:tnk_w01a_guard_ve_01 ] \
									[ dogtag:tnk_w01a_guard_ea_01 ] \
									[ dogtag:tnk_w01a_guard_no_01 ] \
									[ dogtag:tnk_w01a_guard_ha_01 ] \
									[ dogtag:tnk_w01a_guard_vh_01 ]
	}

/*
	// 左舷巡回兵
	proc 警備兵Ｂ $:名前 {
		chara 警備兵 $:名前 \
				-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
				-l $w:敵標準体力 -f $w:敵標準気絶 -h $w:敵標準聴力 \
				-d  d:ENE_DEF_X_2 d:ENE_DEF_Y_2 d:ENE_DEF_Z_2 １Ｆ廻廊部 \
				-r 4 -n 0 \
				-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
				-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
				-j ドッグタグ_敵兵	[ dogtag:tnk_w01a_guard_ve_01 ] \
									[ dogtag:tnk_w01a_guard_ea_01 ] \
									[ dogtag:tnk_w01a_guard_no_01 ] \
									[ dogtag:tnk_w01a_guard_ha_01 ] \
									[ dogtag:tnk_w01a_guard_vh_01 ]
	}
*/
	proc 警備兵セット {
		/*******************************************************************************************/
		// VERYEASY
		/*******************************************************************************************/
		if($w:ゲーム設定 <= d:LEVEL_VERYEASY) {
			if( ( $s:登場ポイント == リフレッシュルーム右舷からロード ) ) {
				@警備兵Ａ 警備兵:01 4
			}else {
				@警備兵Ａ 警備兵:01 3
			}
		/*******************************************************************************************/
		// EASY
		/*******************************************************************************************/
		} else if($w:ゲーム設定 <= d:LEVEL_EASY) {
			if( ( $s:登場ポイント == リフレッシュルーム右舷からロード ) ) {
				@警備兵Ａ 警備兵:01 4
			}else {
				@警備兵Ａ 警備兵:01 3
			}
		/*******************************************************************************************/
		// NORMAL
		/*******************************************************************************************/
		} else if($w:ゲーム設定 <= d:LEVEL_NORMAL) {
			if( ( $s:登場ポイント == リフレッシュルーム右舷からロード ) ) {
				@警備兵Ａ 警備兵:01 4
			}else {
				@警備兵Ａ 警備兵:01 3
			}
		/*******************************************************************************************/
		// HARD
		/*******************************************************************************************/
		} else if($w:ゲーム設定 <= d:LEVEL_HARD) {
			if( ( $s:登場ポイント == リフレッシュルーム右舷からロード ) ) {
				@警備兵Ａ 警備兵:01 4
			}else {
				@警備兵Ａ 警備兵:01 3
			}
		/*******************************************************************************************/
		// EXTREME or EUROPEAN_EXTREME
		/*******************************************************************************************/
		} else {
			@警備兵Ａ 警備兵:01 10
		}
	}

/***************************************************************************************************/
// コマンダーの設定
/***************************************************************************************************/
	proc 警備兵コマンダー {
		chara 警備コマンダー wccomm -e 警備兵セット
	}
	proc 攻撃兵コマンダー {
		chara 攻撃コマンダー atcomm \
			-status 	0x01 \		// 危険モード時にワープ
			-wait		180 \
			-avoidwait	300 \
			-e { 攻撃兵セット }
	}

	resource ghq_area_alert_voice {
	w01a:
		$t{
			t:vc04000e,	//「了解。バックアップは船橋一階左舷へ向かえ」
			t:vc04000f, //「応援部隊、左舷に向かえ。奴を逃がすな！」
			-2,
			t:vc04000c,	//「了解。船橋一階居住区に応援部隊を派遣する｡右舷を固めろ」
			t:vc04000d, //「わかった。応援部隊、右舷にむかえ！。奴を追い込むんだ！」
			-1
		}
	}

	resource ghq_caution_voice {
	w01a:
		$t{
			t:vc040037, //「了解。船橋一階左舷を増員する。警備を強化しろ」
			t:vc040038, //「船橋一階居住区を増員。左舷警戒を固めろ」
			t:vc040035, //「了解。一階居住区を増員。右舷警備を固めろ」
			t:vc040036, //「わかった。右舷に増員。警備を強化せよ！」
			-2,
			// 連絡が途絶えた時の音声
			t:vc040069, //「船橋一階居住区との連絡が途絶えた。」
			-1	// 全ての登録終了
		}
	}

	proc 居住区１Ｆ敵兵設定 {
		chara コマンダー 敵兵セット \
			-w 警備兵コマンダー \
			-a 攻撃兵コマンダー \
			-m $w:スタートアラートモード \
			-r 6000,0,-13000 １Ｆ廻廊部 \
			-c 6000,0,-13000 １Ｆ廻廊部 \
			-g 0 \
			-p	 0,-1,-1 クリアリング初期設定１ \
				-2,-2,-2 クリアリングカメラＯＦＦ \
			-b $w:敵標準再発生数 \ // 生き返る敵兵数
			-z $i:敵標準麻酔持続 \
			-h $i:標準警戒時間 \
			-o $i:敵標準気絶持続 \
			-x [ghq_area_alert_voice:w01a] \
			-y [ghq_caution_voice:w01a] \
			-v [ene_tank_voice:01]
	}

	proc 敵兵ルート変更１{

		trap ev001 d:PLAYER \
			-mask 入る \
			-state 7 \
			-exec {
				if( $f:Ｗ０１Ａ＿敵兵ロッカー部屋で欠伸 == 0 ){
					command ゲット敵兵座標 警備兵:01 $i:敵兵Ｘ $i:敵兵Ｙ $i:敵兵Ｚ
					//command ゲット敵兵座標 敵兵:61 $i:敵兵Ｘ $i:敵兵Ｙ $i:敵兵Ｚ

					if( $i:敵兵Ｚ > 6000 ){
						mesg 警備兵 警備兵:01 ルート変更 (7-1) 6000,0,-6000 １Ｆ廻廊部 0
						eval( $f:Ｗ０１Ａ＿敵兵ロッカー部屋で欠伸 = 1 )
					}
				}
			}

		trap en003 警備兵:01 \
			-mask 入る \
			-exec {
				if( $f:Ｗ０１Ａ＿敵兵ロッカー部屋で欠伸終了 == 0 ){
					eval( $f:Ｗ０１Ａ＿敵兵ロッカー部屋で欠伸終了 = 1 )
				}else{
					mesg 警備兵 警備兵:01 ルート変更 (6-1) 6000,0,-6000 １Ｆ廻廊部 0
				}
			}
	}
#endif

/***************************************************************************************************/
// クリアリング設定
/***************************************************************************************************/
	proc クリアリング初期設定１{
	print '======================================================================='
	print '==============================       =================================='
	print '============================== START =================================='
	print '==============================       =================================='
	print '======================================================================='
		mesg 鏡面モデル管理 床面映り込み del 警備兵:01
		mesg 鏡面モデル管理 床面映り込み del 攻撃兵:01
		mesg 鏡面モデル管理 床面映り込み del 攻撃兵:02

	// $status & 0x0001	: 閉じている
	// $status & 0x0002	: 開いている
	// $status & 0x2000 : 扉が外れている

		// ロッカー１ 開いている ＆ 壊れていない
		command ロッカー状態 -n ロッカー１
		eval( $f:ロッカーステータス１ = ( ($status & 0x0002) && !($status & 0x2000) ) )
	print $f:ロッカーステータス１

		// ロッカー２ 閉じている もしくは 壊れている
		command ロッカー状態 -n ロッカー２
		eval( $f:ロッカーステータス２ = ( ($status & 0x0001) || ($status & 0x2000) ) )
	print $f:ロッカーステータス２

		// ロッカー３ 閉じている もしくは 壊れている
		command ロッカー状態 -n ロッカー３
		eval( $f:ロッカーステータス３ = ( ($status & 0x0001) || ($status & 0x2000) ) )
	print $f:ロッカーステータス３



		// ロッカー５ 閉じている もしくは 壊れている
		command ロッカー状態 -n ロッカー５
		eval( $f:ロッカーステータス５ = ( ($status & 0x0001) || ($status & 0x2000) ) )
	print $f:ロッカーステータス５

		// ロッカー６ 開いている ＆ 壊れていない
		command ロッカー状態 -n ロッカー６
		eval( $f:ロッカーステータス６ = ( ($status & 0x0002) && !($status & 0x2000) ) )
	print $f:ロッカーステータス６


		// ロッカー１が開いていた時の特別処理
		if( ($f:ロッカーステータス１) && ($f:ロッカーステータス２) && ($f:ロッカーステータス３) ){
			command セットクリアリング \
				-p 	0,(7-1),(1-1) クリアリングカメラ020 \
					0,(7-1),(7-1) クリアリングカメラ021 \
					0,(7-1),(9-1) クリアリングチェック左ポスター \
					0,(8-1),(7-1) クリアリングチェック左ポスター \
					0,(7-1),(12-1) クリアリングカメラ022 \
				-i (7-1) (8-1)

		// ロッカー６が開いていた時の特別処理
		}else if( ($f:ロッカーステータス６) && ($f:ロッカーステータス５) ){
			command セットクリアリング \
				-p 	0,(9-1),(1-1) クリアリングカメラ030 \
					0,(9-1),(8-1) クリアリングカメラ031 \
					0,(10-1),(13-1) クリアリングカメラ032 \
					0,(10-1),(10-1) クリアリングチェック右ポスター \
				-i (9-1) (10-1)

		// スネーク右側にいる
		}else if( /*$i:プレイヤー位置Ｘ > 0*/1 ){
	print 'スネーク右にいた'
			command セットクリアリング \
				-p 	0,(1-1),(1-1) クリアリングカメラ001 \
					0,(1-1),(4-1) クリアリングカメラ002 \
					0,(1-1),(11-1) クリアリングカメラ003 \
				-i 0,1
		// スネーク左側にいる
		}else{
	print 'スネーク左にいた'
			command セットクリアリング \
				-p 	0,(4-1),(3-1) クリアリングカメラ010 \
					0,(3-1),(6-1) クリアリングカメラ011 \
				-i 2,3
		}
	}

	// $status & 0x0001	: 閉じている
	// $status & 0x0002	: 開いている
	// $status & 0x2000 : 扉が外れている
	proc クリアリングチェック右ポスター {
	print 'クリアリングチェック右ポスター'

		// 開いている かつ 壊れていない
		command ロッカー状態 -n ロッカー５
		eval( $f:ロッカーステータス５ = ( $status & 0x0002 && !($status & 0x2000) ) )

		// 閉じている もしくは 壊れている
		command ロッカー状態 -n ロッカー６
		eval( $f:ロッカーステータス６ = ( $status & 0x0001 || $status & 0x2000 ) )

	print $f:ロッカーステータス５
	print $f:ロッカーステータス６

		if( $f:ロッカーステータス６ || $f:ロッカーステータス５ ){
			command クリアリングキャンセル
		}

	}


	proc クリアリングチェック左ポスター {
	print 'クリアリングチェック左ポスター'

		// 閉じている もしくは 壊れている
		command ロッカー状態 -n ロッカー１
		eval( $f:ロッカーステータス１ = ( $status & 0x0001 || $status & 0x2000 ) )

		// 開いている かつ 壊れていない
		command ロッカー状態 -n ロッカー２
		eval( $f:ロッカーステータス２ = ( $status & 0x0002 && !($status & 0x2000) ) )

		// 開いている かつ 壊れていない
		command ロッカー状態 -n ロッカー３
		eval( $f:ロッカーステータス３ = ( $status & 0x0002 && !($status & 0x2000) ) )

	print $f:ロッカーステータス１
	print $f:ロッカーステータス２
	print $f:ロッカーステータス３

		if( $f:ロッカーステータス１ || $f:ロッカーステータス２ || $f:ロッカーステータス３ ){
			command クリアリングキャンセル
		}
	}


	proc クリアリングカメラ020{
	#if d:CLEARING_CAMERA
		chara カメラ設定 クリアリングカメラ \
			-c 1 \
			-p -6319,2161,7146 -t -4367,1515,6379 \
			-r 195,1268,0 -f 2194 \
			-a 200 \
			-i 0 -1 0 0 \
			-s 1

		command カメラマップ設定 \
			-chanl 1 \		// １が子画面
			-map １Ｆ廻廊部

		mesg サブ画面 子画面 on
		eval($f:rft_w01a_クリアリングしまくってやがる = 1)
	#endif
	}

