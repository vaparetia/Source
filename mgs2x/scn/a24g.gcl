// 写真撮影用にテクスチャが異なるため別ステージに

// 一括初期化前に変数をローカルに逃がす
if( `command ミッションズリトライ回数取得` == 0 && \
	`command ミッションズコンティニュー回数取得` == 0 ) {
	$$i:ローカル変数プレイタイム = $i:プレイタイム;
} else {
	$$i:ローカル変数プレイタイム = $i:グローバル変数プレイタイム;
}

#include "a24d.gcl"



