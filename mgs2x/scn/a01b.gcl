/***************************************************************************************************/
// 水密ドアを開けた時の隙間風
/***************************************************************************************************/
	proc 暴風エフェクト {
		chara ローカル風 室内風 \
			-n 3 \
			-d	-9000  3000 -20000   9000 6000 8000   0 0 0  \
				-12000 3000 -11000  -9000 6000 -9000   1280 768 2048 \
				 9000  3000 -11000  12000 6000 -9000   2304 768 2048

		mesg ローカル風 室内風 オフ
	}

/***************************************************************************************************/
// プレイヤーの１フレーム前の座標を覚える
/***************************************************************************************************/
	proc 座標チェック {
		chara プロック連続実行 毎フレーム処理 \
			-time -1 \
			-exec {
				eval( $i:前フレーム位置Ｘ = $i:プレイヤー位置Ｘ )
				eval( $i:前フレーム位置Ｚ = $i:プレイヤー位置Ｚ )
				command ゲットゲームステータス $i:ゲームステータス
			}
	}

/***************************************************************************************************/
// エフェクト
/***************************************************************************************************/

	proc 船首と雨のＯＮ／ＯＦＦ {
		trap ev004 d:PLAYER -mask 出る \
			-exec {
				if( $6 < -7000 ){
					mesg  プットオブジェ 船首１ on
					mesg  プットオブジェ 船首２ on
					mesg  プットオブジェ 船首３ on
					mesg  プットオブジェ 船尾 off
				}else{
					mesg  プットオブジェ 船首１ off
					mesg  プットオブジェ 船首２ off
					mesg  プットオブジェ 船首３ off
					mesg  プットオブジェ 船尾 on
			}
		}
	}


	proc 消火器セット {
		chara 消火器 消火器１ \
				-r 0 0 0 \
				-p -11650 3000 -13545 \
				-l w01b \
				-b -11750 3000 -16000 \
				   -9000 6000 -9000

		chara 消火器 消火器２ \
				-r 0 2048 0 \
				-p 11650 3000 -13545 \
				-l w01b \
				-b 9000 3000 -16000 \
				   11750 6000 -9000


		chara 消火器 消火器３ \
				-r 0 3072 0 \
				-p -7175 3000 -6850 \
				-l w01b \
				-b -7750 3000 -7000 \
				   -4000 6000 -2000

		chara 消火器 消火器４ \
