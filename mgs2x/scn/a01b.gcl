/***************************************************************************************************/
// トラップドアのproc化
/***************************************************************************************************/

	proc 右舷廻廊１Ｆから２Ｆへのドア {

		// ドアの配列番号、変数をセット
		local $$:配列番号;
		local $$:ＰＸ
		local $$:ＰＹ
		local $$:ＰＺ
		local $$:ＲＹ
		local $$:ドア名

		$$:配列番号 = 0;
		$$:ＰＸ = 3900;
		$$:ＰＹ = 3000;
		$$:ＰＺ = -9650;
		$$:ＲＹ = d:WEST
		$$:ドア名 = 右舷回廊１Ｆから２Ｆへのドア

		// ドアフラグを元にモデルを設定
		@ドアモデル名セット $$:配列番号	d:DR_NAME1 d:DR_NAME2 d:DR_NAME3 d:DR_NAME4 d:DR_NAME5

		chara ドア 右舷回廊１Ｆから２Ｆへのドア \
			-m $$s:ドアモデル名[$$:配列番号] \
			-d 0 $$:ＲＹ 0 \
			-p $$:ＰＸ $$:ＰＹ $$:ＰＺ \
			-slide d:SD_SLIDE_TANKER \
			-time d:SD_OPEN_TIME \
			-between ２Ｆ廻廊部 ２Ｆ廻廊部 \
			-exec{
				if( !($:開閉フラグ) ){
					eval( $f:右扉フラグ = 0 )
					if( $f:左扉フラグ == 0 ){
						mesg プットオブジェ ロード用Ｗ０１ｆ off
					}
				}else{
					eval( $f:右扉フラグ = 1 )
					mesg プットオブジェ ロード用Ｗ０１ｆ on
				}
			}
		trap dr001 ？ \
			-mask ？ \
			-exec {
				if ( $3 == 入る ) {
					mesg ドア 右舷回廊１Ｆから２Ｆへのドア open $2
				} else {
					mesg ドア 右舷回廊１Ｆから２Ｆへのドア close $2
				}
			}

		// 敵兵のみを通す透明壁等の設定
		@A_ドア開閉追加設定 $$:ドア名 $$b:ドアフラグ[$$:配列番号] \
							$$:ＰＸ $$:ＰＹ $$:ＰＺ $$:ＲＹ d:SD_SLIDE_TANKER
	}

	proc 左舷廻廊１Ｆから２Ｆへのドア {

		// ドアの配列番号、変数をセット
		local $$:配列番号;
		local $$:ＰＸ
		local $$:ＰＹ
		local $$:ＰＺ
		local $$:ＲＹ
		local $$:ドア名

		$$:配列番号 = 1;
		$$:ＰＸ = -3900;
		$$:ＰＹ = 3000;
		$$:ＰＺ = -9650;
		$$:ＲＹ = d:WEST
		$$:ドア名 = 左舷回廊１Ｆから２Ｆへのドア


		// ドアフラグを元にモデルを設定
		@ドアモデル名セット $$:配列番号	d:DR_NAME1 d:DR_NAME2 d:DR_NAME3 d:DR_NAME4 d:DR_NAME5

		// ドアのセット
		chara ドア 左舷回廊１Ｆから２Ｆへのドア \
			-m $$s:ドアモデル名[$$:配列番号] \
			-d 0 $$:ＲＹ 0 \
			-p $$:ＰＸ $$:ＰＹ $$:ＰＺ \
			-slide d:SD_SLIDE_TANKER \
			-time d:SD_OPEN_TIME \
			-between ２Ｆ廻廊部 ２Ｆ廻廊部 \
			-exec{
				if( !($:開閉フラグ) ){
					eval( $f:左扉フラグ = 0 )
					if( $f:右扉フラグ == 0 ){
						mesg プットオブジェ ロード用Ｗ０１ｆ off
					}
				}else{
					eval( $f:左扉フラグ = 1 )
					mesg プットオブジェ ロード用Ｗ０１ｆ on
				}
			}
		// 開閉トラップのセット
		trap dr000 ？ \
			-mask ？ \
			-exec {
				if ( $3 == 入る ) {
					mesg ドア 左舷回廊１Ｆから２Ｆへのドア open $2
				} else{
					mesg ドア 左舷回廊１Ｆから２Ｆへのドア close $2
				}
			}
		// 敵兵のみを通す透明壁等の設定
		@A_ドア開閉追加設定 $$:ドア名 $$b:ドアフラグ[$$:配列番号] \
							$$:ＰＸ $$:ＰＹ $$:ＰＺ $$:ＲＹ d:SD_SLIDE_TANKER
	}


/***************************************************************************************************/
// 水密ドアの設定
/***************************************************************************************************/

	proc 甲板への水密ドア二つ{
		if( `@スネーク達` ) {
			eval( $s:ローカル変数Ｓ１ = sna_hatch )
		} else {
			eval( $s:ローカル変数Ｓ１ = rai_wt_hatch )
		}

		chara 水密ドア管理 水密ドア管理人 -n 2 \
			-seno 1 \
			-motions $s:ローカル変数Ｓ１ hatch_door_sna hatch_handle_sna

		@左舷甲板への水密ドア
		@右舷甲板への水密ドア
	}

	proc 右舷甲板への水密ドア {

		// ドアの配列番号、変数をセット
		local $$:配列番号;
		$$:配列番号 = 2;

		if( $$b:ドアフラグ[$$:配列番号] == d:DOOR_FLAG_OPEN ) {
			if( $s:登場ポイント == 右舷甲板からロード ) {
				eval( $i:ローカル変数Ｉ１ = d:WT_DOOR_FLAG_OPEN_START )
			}else{
				eval( $i:ローカル変数Ｉ１ = d:WT_DOOR_FLAG_NORMAL )
			}
		} else {
			eval( $i:ローカル変数Ｉ１ = d:WT_DOOR_FLAG_NOT_OPEN )
		}

		// ドアフラグを元にモデルを設定
		@ドアモデル名セット $$:配列番号	d:DR_NAME_WL1 d:DR_NAME_WL2 \
										d:DR_NAME_WL3 d:DR_NAME_WL4 d:DR_NAME_WL5

		chara 水密ドア 右舷水密ドア \
				-kms $$s:ドアモデル名[$$:配列番号] w01asdr_handle \
				-flag $i:ローカル変数Ｉ１ \
				-position 11950,3000,-10325 \
				-rotate 0,3072,0 \
				-type 1 \
				-hazard	11750,3000,-10225 11750,3000,-9225 \
				-proc 右舷甲板２Ｆへロード

		trap dr003 d:PLAYER \
			-mask いる \
			-button d:ACTION_BUTTON \
			-state 0 \
			-exec {
				command 水密ドア状態 -n 右舷水密ドア
				mesg プレイヤー d:PLAYER wt_door 右舷水密ドア $status 1024,1024 11950,-10325
		}

		// モーション中のカメラ
		trap dr003 d:PLAYER -mask ？ -state 6 \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 1 ) {
					chara カメラ設定 モーションカメラ \
						-c 1 \
						-p 10959,6313,-9216 -t 11064,4860,-9594 \
						-r 852,1872,0 -f 1505 \
						-a 200 \
						-i 3 2 0 0 \
						-s $3
				}
		}

		// ステージスタート時のロードカメラ
		trap dr003 d:PLAYER -mask ？ \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 0 ) {
					chara カメラ設定 モーションカメラ \
						-c 1 \
						-p 10959,6313,-9216 -t 11064,4860,-9594 \
						-r 852,1872,0 -f 1505 \
						-a 200 \
						-i 0 2 0 0 \
						-s $3

					mesg ローカル風 室内風 オン

					chara delay ディレイ -time 1 -exec {
						command ＳＥセットモード -s d:se_code:SD_A_DRCRAIN1 -p 11750 4000 -10000 -m 0
					}

					chara delay ディレイ -time 100 -exec {
						mesg ローカル風 室内風 オフ
					}
				}
		}
	}

	proc 左舷甲板への水密ドア {
		// ドアの配列番号、変数をセット
		local $$:配列番号;
		$$:配列番号 = 3;

		if( $$b:ドアフラグ[$$:配列番号] == d:DOOR_FLAG_OPEN ) {
			if( $s:登場ポイント == 左舷甲板からロード ) {
				eval( $i:ローカル変数Ｉ１ = d:WT_DOOR_FLAG_OPEN_START )
			}else{
				eval( $i:ローカル変数Ｉ１ = d:WT_DOOR_FLAG_NORMAL )
			}
		} else {
			eval( $i:ローカル変数Ｉ１ = d:WT_DOOR_FLAG_NOT_OPEN )
		}

		// ドアフラグを元にモデルを設定
		@ドアモデル名セット $$:配列番号	d:DR_NAME_WR1 d:DR_NAME_WR2 \
										d:DR_NAME_WR3 d:DR_NAME_WR4 d:DR_NAME_WR5

		chara 水密ドア 左舷水密ドア \
			-kms $$s:ドアモデル名[$$:配列番号] w01asdr_handle \
			-flag $i:ローカル変数Ｉ１ \
			-position -11950,3000,-10325 \
			-rotate 0,3072,0 \
			-hazard -11750,3000,-10225 -11750,3000,-9225 \
			-proc 左舷甲板２Ｆへロード

		trap dr002 d:PLAYER \
			-mask いる \
			-button d:ACTION_BUTTON \
			-state 0 \
			-exec {
				command 水密ドア状態 -n 左舷水密ドア
				mesg プレイヤー d:PLAYER wt_door 左舷水密ドア $status 3072,1024 -11950,-10325
		}
		// モーション中のカメラ
		trap dr002 d:PLAYER -mask ？ -state 6 \
		-exec {
			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p -10959,6313,-9216 -t -11064,4860,-9594 \
				-r 852,1872,0 -f 1505 \
				-a 200 \
				-i 3 2 0 0 \
				-s $3
		}
		// ステージスタート時のロードカメラ
		trap dr002 d:PLAYER -mask ？ \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 0 ) {
					chara カメラ設定 モーションカメラ \
						-c 1 \
						-p -10959,6313,-9216 -t -11064,4860,-9594 \
						-r 852,1872,0 -f 1505 \
						-a 200 \
						-i 0 2 0 0 \
						-s $3

					mesg ローカル風 室内風 オン

					chara delay ディレイ -time 1 -exec {
						command ＳＥセットモード -s d:se_code:SD_A_DRCRAIN1 -p -11750 4000 -10000 -m 0
					}

					chara delay ディレイ -time 100 -exec {
						mesg ローカル風 室内風 オフ
					}
				}
		}
	}


/***************************************************************************************/
// 入出ロードのproc化
/***************************************************************************************/
	proc ロードプロック {
		if ($s:呼び出しプロック == mv_a01b_a01f_0x) {
			@mv_a01b_a01f_0x
		} else if ($s:呼び出しプロック == mv_a01b_a01f_1) {
			@mv_a01b_a01f_1
		} else if ($s:呼び出しプロック == mv_a01b_a00a_0) {
			@mv_a01b_a00a_0
		} else if ($s:呼び出しプロック == mv_a01b_a00a_1) {
			@mv_a01b_a00a_1
		} else if ($s:呼び出しプロック == mv_a01b_a01c_0) {
			@mv_a01b_a01c_0
		} else if ($s:呼び出しプロック == mv_a01b_a01c_1) {
			@mv_a01b_a01c_1
		}
	}

	proc １Ｆリフレッシュルーム中央階段左側へロード {
		trap ld000 d:PLAYER \
			-mask 入る \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 1 ) {
					chara カメラ設定 ロードカメラ \
						-c 1 \
						-p -5000,5372,-5200 -t -5000,4328,-8694 \
						-r 115,2048,0 -f 5942 \
						-a 200 \
						-i 3 0 0 0 \
						-s 1
					preseek 'a01f'
					@ステージ終了時処理（ステージ名表示） \
						-2800 3000 -9000 \
						1024 \
						mv_a01b_a01f_0x \
						d:DEFAULT_M_TYPE \
						d:wn_船橋一階リフレッシュルーム
				}
			}
	}

	proc １Ｆリフレッシュルーム中央階段右側へロード {
		trap ld001 d:PLAYER \
			-mask 入る \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 1 ) {
					chara カメラ設定 ロードカメラ \
						-c 1 \
						-p 5000,5372,-5200 -t 5000,4328,-8694 \
						-r 115,2048,0 -f 5942 \
						-a 200 \
						-i 3 0 0 0 \
						-s 1

					preseek 'a01f'
					@ステージ終了時処理（ステージ名表示） \
						2800 3000 -9000 \
						1024 \
						mv_a01b_a01f_1 \
						d:DEFAULT_M_TYPE \
						d:wn_船橋一階リフレッシュルーム
				}
			}
	}

	proc 左舷甲板２Ｆへロード $:トリガ {
		if ( $:トリガ == 0 ) {
			chara カメラ設定 ロードカメラ \
				-c 1 \
				-p -10400,8350,-9600 -t -10400,4000,-10250 \
				-r 927,2048,0 -f 4398 \
				-a 200 \
				-i 3 0 0 0 \
				-s 1

			preseek 'a00a'
			@ステージ終了時処理（ステージ名表示） \
				-14000 3000 -9750 \
				3072 \
				mv_a01b_a00a_0 \
				d:DEFAULT_M_TYPE \
				d:wn_船尾甲板左舷
		}else if ( $:トリガ == 3 ) {
			// 水密ドアが開き始めたら隙間風を吹かしＳＥをコールする
			chara delay ディレイ -time 45 -exec {
				command ＳＥセットモード -s d:se_code:SD_A_DRORAIN1 -p -11750 4000 -10000 -m 0
				mesg ローカル風 室内風 オン
			}
		}
	}

	proc 右舷甲板２Ｆへロード $:トリガ {
		if ($:トリガ == 0) {
			chara カメラ設定 ロードカメラ \
				-c 1 \
				-p 10959,6313,-9216 -t 11064,4860,-9594 \
				-r 852,1872,0 -f 1505 \
				-a 200 \
				-i 3 0 0 0 \
				-s 1

			preseek 'a00a'
			@ステージ終了時処理（ステージ名表示） \
				14000 3000 -9750 \
				d:EAST \
				mv_a01b_a00a_1 \
				d:DEFAULT_M_TYPE \
				d:wn_船尾甲板右舷
		}else if ( $:トリガ == 3 ) {
			// 水密ドアが開き始めたら隙間風を吹かす
			chara delay ディレイ -time 45 -exec {
				command ＳＥセットモード -s d:se_code:SD_A_DRORAIN1 -p 11750 4000 -10000 -m 0
				mesg ローカル風 室内風 オン
			}
		}
	}

	proc 居住区３Ｆ左側へロード {
		trap ld004 d:PLAYER -mask 入る \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 1 ) {
				// 階段カメラ
					chara カメラ設定 ロードカメラ \
						-c 1 \
						-p -10649,4963,-7498 \
						-t -10936,4665,-10281 \
						-r 69,2115,0 -f 2814 \
						-a 200 \
						-i 1 -1 0 0 \
						-s $3

					preseek 'a01c'
					@ステージ終了時処理（ステージ名表示） -11250 6000 -15000 2048 mv_a01b_a01c_0 d:DEFAULT_M_TYPE d:wn_船橋三階居住区左舷
				}
			}
	}

	proc 居住区３Ｆ右側へロード {
	#if d:LOAD_W01C_R
		trap ld005 d:PLAYER -mask 入る \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 1 ) {
				// 階段カメラ
					@CS_スムーズカメラ３ $6 -11000 -12500 11250 9250 6500 3750 4250 5500
					eval( $i:補完ＰＸ = $i:CS_結果１ )
					eval( $i:補完ＰＹ = $i:CS_結果２ )
					eval( $i:補完ＴＹ = $i:CS_結果３ )
					eval( $i:補完ＴＺ = $6 )

					eval( $i:補完ＴＸ = 11250 )
					chara カメラ設定 ロードカメラ \
						-c 1 \
						-p $i:補完ＰＸ,$i:補完ＰＹ,-9600 \
						-t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ \
						-a 200 \
						-i 1 -1 0 0 \
						-s $3

					eval($i:w01c_直前のマップ = 2)

					preseek 'w01c'
					@ステージ終了時処理（ステージ名表示） 11250 6000 -15000 2048 mv_a01b_a01c_1 d:DEFAULT_M_TYPE
				}
			}
	#endif
	}

/***************************************************************************************************/
// オブジェクトのproc化
/***************************************************************************************************/
	proc 天井設定 {
		chara 天井君 天井 -m w01b0r -h 5900 -p 0,0,0  -l w01b
		chara 天井君 天井 -m w01b1r -h 5800 -p 0,0,0  -l w01b
	}

	proc 船首オブジェクト {
		// 船尾
		chara プットオブジェ 船尾 -m w01b2a -r 0 0 0 -p 0 0 0 -l w01b -s 100 100 100
	}

/***************************************************************************************************/
// エフェクトのproc化
/***************************************************************************************************/
	proc フォグ {
		chara フォグ fog -c 17 33 33 -n 0 -f 18000
	}

	proc 窓の雨粒 {
		//正面窓５個（左からＡＢＣＤＥ）
		chara 窓雨 正面窓Ａ -c -5000 4550 -19900 -s 700 900 -r 0 0 0
		chara 窓雨 正面窓Ｂ -c -2500 4550 -19900 -s 700 900 -r 0 0 0
		chara 窓雨 正面窓Ｃ -c 0 4550 -19900 -s 700 900 -r 0 0 0
		chara 窓雨 正面窓Ｄ -c 2500 4550 -19900 -s 700 900 -r 0 0 0
		chara 窓雨 正面窓Ｅ -c 5000 4550 -19900 -s 700 900 -r 0 0 0
		//西窓４個（上からＦＧＨＩ）
		chara 窓雨 西窓Ｆ -c (-7950) 4450 -530 -s 250 350 -r 0 1024 0 -m 1
		chara 窓雨 西窓Ｇ -c (-7950) 4450 270 -s 250 350 -r 0 1024 0 -m 1
		chara 窓雨 西窓Ｈ -c (-7950) 4450 1720 -s 250 350 -r 0 1024 0 -m 1
		chara 窓雨 西窓Ｉ -c (-7950) 4450 2520 -s 250 350 -r 0 1024 0 -m 1

		//東窓４個（上からＪＫＬＭ）
		chara 窓雨 東窓Ｊ -c (7950) 4450 -530 -s 250 350 -r 0 3072 0 -m 1
		chara 窓雨 東窓Ｋ -c (7950) 4450 270 -s 250 350 -r 0 3072 0 -m 1
		chara 窓雨 東窓Ｌ -c (7950) 4450 1720 -s 250 350 -r 0 3072 0 -m 1
		chara 窓雨 東窓Ｍ -c (7950) 4450 2520 -s 250 350 -r 0 3072 0 -m 1
		// 南窓８個（左から ＮＯＰＱ　ＲＳＴＵ）
		chara 窓雨 南窓Ｎ -c -4550 4450 7950 -s 250 350 -r 0 2048 0 -m 1
		chara 窓雨 南窓Ｏ -c -3750 4450 7950 -s 250 350 -r 0 2048 0 -m 1
		chara 窓雨 南窓Ｐ -c -2250 4450 7950 -s 250 350 -r 0 2048 0 -m 1
		chara 窓雨 南窓Ｑ -c -1450 4450 7950 -s 250 350 -r 0 2048 0 -m 1
		chara 窓雨 南窓Ｒ -c 1450 4450 7950 -s 250 350 -r 0 2048 0 -m 1
		chara 窓雨 南窓Ｓ -c 2250 4450 7950 -s 250 350 -r 0 2048 0 -m 1
		chara 窓雨 南窓Ｔ -c 3750 4450 7950 -s 250 350 -r 0 2048 0 -m 1
		chara 窓雨 南窓Ｕ -c 4550 4450 7950 -s 250 350 -r 0 2048 0 -m 1
	}

	proc 鏡面モデルセット {
		chara 鏡面モデル管理 床面映り込み \
			-pos 0,3000,0 \
			-axis 1 // Y軸反転

		trap sh ？ -mask ？ \
			-exec {
				if( $3 == 入る ){
					mesg 鏡面モデル管理 床面映り込み add $2
				}else{
					mesg 鏡面モデル管理 床面映り込み del $2
				}
			}
	}

	proc 遠近ぼかしセット {
	#if d:BOKASHI
		chara 遠景ぼかし 遠景ぼかし１ \
			-plane	4 \
			-near	1000 \
			-far	5000

		chara 遠景ぼかし 遠景ぼかし２ \
			-plane	4 \
			-near	5000 \
			-far	10000

		chara 遠景ぼかし 遠景ぼかし３ \
			-plane	4 \
			-near	10000 \
			-far	15000

		chara 近景ぼかし 近景ぼかし１ \
			-plane	3 \
			-near	0 \
			-far	1000

		chara 近景ぼかし 近景ぼかし２ \
			-plane	3 \
			-near	0 \
			-far	3000

		chara 近景ぼかし 近景ぼかし３ \
			-plane	3 \
			-near	0 \
			-far	5000
	#endif
	}

/***************************************************************************************************/
// 光源設定のproc化
/***************************************************************************************************/
	// キャラ用光源(マップの設置が終わってから設定することで、キャラだけに光を当てる)
	proc キャラ専用環境光設定 {
		chara 環境光 環境光 \
			 -c 43 80 53

		chara 平行光 平行光 \
			-c 80 80 128 \
			-d 512 2560 0
	}


/***************************************************************************************************/
// サウンドのproc化
/***************************************************************************************************/
	proc 跳弾設定 {
		command 弾痕ノーマル -n 0
		command 弾痕ノーマル -n 1
		command 弾痕ノーマル -n 2
		command 弾痕ノーマル -n 3
		command 弾痕ノーマル -n 4

		command 跳弾ノーマル -n 0
		command 跳弾ノーマル -n 1
		command 跳弾ノーマル -n 2
		command 跳弾ノーマル -n 3
		command 跳弾ノーマル -n 4

		// 水蒸気の番号設定
		command 弾痕ノーマル -n 5
		command 弾痕ノーマル -n 6
		command 弾痕ノーマル -n 7
		command 跳弾水蒸気小 -n 5
		command 跳弾水蒸気中 -n 6
		command 跳弾水蒸気大 -n 7
	}

/***************************************************************************************************/
// プレイヤーのproc化
/***************************************************************************************************/
	proc 水飛沫 {
		chara キャラ付随水飛抹 スネーク水飛沫 \
				-nconcname d:PLAYER \
				-addone 32 \
				-time d:CHARA_SPLASH_TIME \
				-rgbadd 0x40404030 \
				-gbsub 0x40404030
	}

	proc 影表示 {
		chara 影投影モデル 二階影モデル中央 -model w01bk_center -pos 0 0 0
		chara 影投影モデル 二階影モデル左   -model w01bk_left 	-pos 0 0 0
		chara 影投影モデル 二階影モデル右   -model w01bk_right 	-pos 0 0 0

		command 影投影ハザード \
			-name ２Ｆ廻廊部 \
			-group 1

		chara 影管理 影管理 \
			-type 1 \
			-length 8000

		// 影のＯＮ／ＯＦＦを行う
		trap ev005 ？ -mask ？ \
		-exec {
			if( $3 == 入る ){
				mesg 影管理 影管理 add $2 二階影モデル中央
			}else{
				mesg 影管理 影管理 del $2
			}
		}
		trap ev006 ？ -mask ？ \
		-exec {
			if( $3 == 入る ){
				mesg 影管理 影管理 add $2 二階影モデル左
			}else{
				mesg 影管理 影管理 del $2
			}
		}
		trap ev007 ？ -mask ？ \
		-exec {
			if( $3 == 入る ){
				mesg 影管理 影管理 add $2 二階影モデル右
			}else{
				mesg 影管理 影管理 del $2
			}
		}
	}

/***************************************************************************************************/
// 壊れライトの設定
/***************************************************************************************************/
	proc 壊れライトセット {
		chara プットスポットライトオブジェ 照明モデル１ \
			-m w01c_lit1a w01c_lit1b \
			-t -11060,5650,-15900 100 1500 \
			-l w01b \
			-p -11060,5650,-15900 \
			-f /*0x00000001*/0x00000000
		chara プットスポットライトオブジェ 照明モデル２ \
			-m w01c_lit1a w01c_lit1b \
			-t -6750,5650,-6900 100 1500 \
			-l w01b \
			-p -6750,5650,-6900 \
			-f /*0x00000001*/0x00000000
