	proc 右舷３Ｆへの階段と脇通路カメラ {

		// 階段の最上階のカメラ
		trap ca031 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				if( $6 < -13276 ){
					if( `command PlayerStatus -f d:CAUTION ` ){
						if( `command PlayerStatus -f d:TRP_STATE_SQUAT ` ){
							chara カメラ設定 通路カメラ０ \
								-c 1 \
								-p 11235,6948,-11377 -t 10865,6936,-13332 \
								-r 4,2170,0 -f 1990 \
								-a 200 \

								-i 0 0 0 0 \
								-s $3
						}else{
							chara カメラ設定 通路カメラ０ \
								-c 1 \
								-p 11437,7078,-11841 -t 11056,7127,-13791 \
								-r -16,2174,0 -f 1987 \
								-a 200 \
								-i 0 0 0 0 \
								-s $3
						}
					}
				}else{
					if( `command PlayerStatus -f d:GROUND ` ){
						@全部補完カメラ $6	-13276 -12250 \
											11451 11447 \
											7727 7742 \
											-11023 -11043 \
											11438 11438 \
											7664 7664 \
											-11087 -11087

						chara カメラ設定 通路カメラ０ \
							-c 1 \
							-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ \
							-t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ \
							-a 200 \
							-i 0 0 0 0 \
							-s $3
					}else{
						@全部補完カメラ $6	-13276 -12250 \
											11296 11340 \
											8367 7803 \
											-12127 -11845 \
											11061 11180 \
											6794 6006 \
											-13317 -12687

						chara カメラ設定 通路カメラ０ \
							-c 1 \
							-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ \
							-t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ \
							-a 200 \
							-i 0 0 0 0 \
							-s $3
					}
				}
			}

		trap ca014 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				if( $3 == 入る ) {
					if( $6 > -14000 ) {
						eval( $w:カメラ補完方式 = 2 )
					} else {
						eval( $w:カメラ補完方式 = 0 )
					}
				}
				// 階段カメラ
				if( $4 > 10750 && $6 > -12250 ) {
					if( `command PlayerStatus -f d:GROUND ` ){

						@全部補完カメラ $6	-12250 -11000 \
										11123 11117 \
										5563 5615 \
										-9017 -9045 \
										11105 11105 \
										5543 5543 \
										-9110 -9110

						chara カメラ設定 通路カメラ１ \
							-c 1 \
							-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ \
							-t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ \
							-a 200 \
							-i 1 -1 0 0 \
							-s $3
					}else{
						@全部補完カメラ $6	-12250 -11000 \
										11462 11450 \
										5467 4308 \
										-9342 -9503 \
										11110 11106 \
										5877 4586 \
										-11262 -11451

						chara カメラ設定 通路カメラ１ \
							-c 1 \
							-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ \
							-t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ \
							-a 200 \
							-i $w:カメラ補完方式 -1 0 0 \
							-s $3
					}
				// 通路カメラ
				} else {
					// ３Ｆ階段下吹き抜けまで仮設定
					eval( $i:補完ＰＸ = 10375 )
					eval( $i:補完ＰＹ = 5501 )
					eval( $i:補完ＰＺ = -7163 )
					eval( $i:補完ＴＸ = 10375 )
					eval( $i:補完ＴＹ = 3958 )
					eval( $i:補完ＴＺ = -10779 )

					chara カメラ設定 通路カメラ１ \
					-c 1 \
					-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ \
					-t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ \
					-a 200 \
