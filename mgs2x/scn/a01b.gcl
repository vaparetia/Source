	proc 左舷３Ｆへの階段と脇通路カメラ {
		trap ca006 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				if( $3 == 入る ) {
					if( $6 > -14000 ) {
						eval( $w:カメラ補完方式 = 2 )
					} else {
						eval( $w:カメラ補完方式 = 0 )
					}
				}
				// 階段カメラ
				if( $4 < -10750 && $6 > -14000 ) {
					if( $6 > -12500 ) {
						eval( $i:補完ＰＸ = -10649 )
						eval( $i:補完ＰＹ = 4963 )
						eval( $i:補完ＰＺ = -7498 )
						eval( $i:補完ＴＸ = -10936 )
						eval( $i:補完ＴＹ = 4665 )
						eval( $i:補完ＴＺ = -10281 )
					} else {
						eval( $i:補完ＰＸ = -9250 )
						eval( $i:補完ＰＹ = 3750 )
						eval( $i:補完ＴＹ = 5500 )
						eval( $i:補完ＴＺ = -12500 )
						eval( $i:補完ＴＸ = -11250 )
						eval( $i:補完ＰＺ = -9600 )
					}

				// 通路カメラ
				} else {
					// ３Ｆ階段下吹き抜けまで仮設定
					eval( $i:補完ＰＸ = -10375 )
					eval( $i:補完ＰＹ = 5501 )
					eval( $i:補完ＰＺ = -7163 )
					eval( $i:補完ＴＸ = -10375 )
					eval( $i:補完ＴＹ = 3958 )
					eval( $i:補完ＴＺ = -10779 )
				}
				chara カメラ設定 通路カメラ１ \
					-c 1 \
					-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ \
					-t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ \
					-a 200 \
					-i $w:カメラ補完方式 -1 0 0 \
					-s $3
			}
	}

	proc 左舷甲板扉前カメラ {
