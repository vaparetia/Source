/***************************************************************************************/
// マップ宣言
/***************************************************************************************/
	// アナザー用プロック マップ設定前に設定する
	@アナザー用マップ定義前設定					// a_mode.h

	chara マップ ２Ｆ廻廊部 -k w01b0 0 0 0 -k w01b1 0 0 0 -h a01b,0 -l w01b

/****************************************************************************************/
// ロード用オブジェクト
/****************************************************************************************/
	chara プットオブジェ ロード用Ｗ０１ｆ -m w01b_w01f -r 0 0 0 -p 0 0 0 -l w01b -s 100 100 100
	chara プットオブジェ ロード用Ｗ０１ｃ -m w01b_w01c -r 0 0 0 -p 0 0 0 -l w01b -s 100 100 100

/****************************************************************************************/
// 各マップのキャラ設定
/****************************************************************************************/
	command マップ設定 ２Ｆ廻廊部 -set {
		@ローカル変数初期化
		@常駐キャラ設定							// stdch.h
		@A_プレイヤー設定 sna_a01b rai_a01b		// a_stdproc.h
	}

	// アナザー用プロック マップ設定後に設定する
	@アナザー用マップ定義後設定					// a_mode.h

	command マップ設定 ２Ｆ廻廊部 \
	-set{
		@跳弾設定
		//@ポーズ時ステージ名表示設定 d:wn_船橋二階居住区

		@天井設定
		@フォグ
		@影表示
		@壊れライトセット
		@消火器セット

		@鏡面モデルセット
		@遠近ぼかしセット

		@船首オブジェクト

		@船首と雨のＯＮ／ＯＦＦ

		// 雨関連
		@窓際の雨音
		@窓の雨粒
		@暴風エフェクト
		//@水溜まり			// a01b_bomb.h へ

		// ロードトラップ
		@１Ｆリフレッシュルーム中央階段左側へロード
		@１Ｆリフレッシュルーム中央階段右側へロード
		//@左舷甲板２Ｆへロード	// 水密ドアで呼び出し
		//@右舷甲板２Ｆへロード	// 水密ドアで呼び出し
		@居住区３Ｆ左側へロード
		@居住区３Ｆ右側へロード

		// ドアトラップ
		@左舷廻廊１Ｆから２Ｆへのドア
		@右舷廻廊１Ｆから２Ｆへのドア
		@甲板への水密ドア二つ

		// ロッカー
		@ロッカー設置

		// カメラ設定
		@子画面設定
		@居住区２Ｆカメラ設定
		@左舷３Ｆへの階段と脇通路カメラ
		@左舷甲板扉前カメラ
		@左舷への通路カメラ

		@右舷３Ｆへの階段と脇通路カメラ
		@右舷甲板扉前カメラ
		@右舷への通路カメラ

		@北部北東角カメラ
		@北部北西角カメラ
		@北部東西通路カメラ
		@北部南北通路左側カメラ
		@北部南北通路右側カメラ

		// クランク部カメラ
		@クランク部北西カメラ右カメラ
		@クランク部北西カメラ左カメラ
		@南部南北通路左側カメラ
		@クランク部南西左側カメラ
		@クランク部南西右側カメラ
		@クランク部南西右下カメラ

		@南側東西通路カメラ
		@南側東西通路張り付きカメラ
//		@南側東西通路西カメラ
//		@南側東西通路東カメラ

		@クランク部北東左側カメラ
		@クランク部北東右側カメラ
		@南側南北通路右側カメラ
		@クランク部南東右側カメラ
		@クランク部南東左側カメラ
		@クランク部南東左下カメラ

		@ロッカー置き場カメラ

		@左舷窪みカメラ
		@右舷窪みカメラ

		// デバッグ設定
	#if d:MY_DEBUG
		//@写真撮影用スクリーンショット
		@ＵＳＢキーボードセット
	#endif
	}

	// 最後で行う処理
	command マップ設定 ２Ｆ廻廊部 \
	-set {
		//@タンカーデジカメ写真判定
		@船尾ＯＦＦ
		@座標チェック
		@キャラ専用環境光設定
	}

/***************************************************************************************/
// マップの起動
/***************************************************************************************/
	command マップ表示 -show ２Ｆ廻廊部

	// 全てのセットが終わったところでフェードイン
	if( $s:登場ポイント == 居住区三階左舷からロード ) {
		@ステージ開始時処理（ステージ名表示） \
			d:LOAD_TYPE:NO_DOOR_TYPE \
			階段ダミー \
			1700 \
			d:DEFAULT_M_TYPE \
			d:wn_船橋二階居住区左舷

	} else if( $s:登場ポイント == 右舷甲板からロード ) {
		@ステージ開始時処理（ステージ名表示） \
			d:LOAD_TYPE:WT_DOOR_TYPE \
			右舷水密ドア \
			1700 \
			d:DEFAULT_M_TYPE \
			d:wn_船橋二階居住区右舷
		@カメラ曇り
		@水飛沫
	} else if( $s:登場ポイント == 居住区一階中央階段右からロード ) {
		@ステージ開始時処理（ステージ名表示） \
			d:LOAD_TYPE:SL_DOOR_TYPE \
			右舷回廊１Ｆから２Ｆへのドア \
			1500 \
			d:DEFAULT_M_TYPE \
			d:wn_船橋二階居住区右舷
	} else if( $s:登場ポイント == 居住区一階中央階段左からロード ) {
			@ステージ開始時処理（ステージ名表示） \
			d:LOAD_TYPE:SL_DOOR_TYPE \
			左舷回廊１Ｆから２Ｆへのドア \
			1500 \
			d:DEFAULT_M_TYPE \
			d:wn_船橋二階居住区左舷
	} else if( $s:登場ポイント == 左舷甲板からロード ) {
		@ステージ開始時処理（ステージ名表示） \
			d:LOAD_TYPE:WT_DOOR_TYPE \
			左舷水密ドア \
			2000 \
			d:DEFAULT_M_TYPE \
			d:wn_船橋二階居住区左舷
		@カメラ曇り
		@水飛沫
	} else {
		//@ロード時フェードイン
	}

/***************************************************************************************************/
// 初期化
/***************************************************************************************************/
	proc ローカル変数初期化 {
		eval( $f:警備兵なにかに気づいたフラグ = 0 )
	}

	proc 船尾ＯＦＦ {
		mesg プットオブジェ 船尾 off
	}

/***************************************************************************************************/
// エフェクト
/***************************************************************************************************/

	proc カメラ曇り {
		chara カメラ前曇り カメラ曇り -t 250
	}

	proc 窓際の雨音 {
		trap sd d:PLAYER -mask ？ \
			-exec {
				if( $3 == 入る ){
					command ＳＥセットモード -s d:se_code:SD_A_W_RAIN01 -p 0 0 0 -m 1
				}else{
					command セットサウンドコード -c d:SE_JOUCHUU_OFF
				}
			}
	}

