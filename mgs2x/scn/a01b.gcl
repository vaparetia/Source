// デバッグ設定
#ifdef d:FIX_MODE
	#define MY_DEBUG		0		// デバッグ
	#define ASSERT			0
#else
	#define MY_DEBUG		0		// デバッグ
	#define ASSERT			1
#endif

#define	VAR_SAVE			1	// フラグのセーブ

#define STAGE_TANKER		1	// モード共通 プロック切り分け用
#define STAGE_W01B			1	// ステージ名 共通プロック切り分け用
#define STAGE_ALT			1	// オールタナティブステージ切り分け用
#define PLAYER				スネーク

// 各種スイッチ用
#define STAGE_END			1	// ステージ終了時処理を使用可にする
#define PAN_CAMERA			1

// エフェクト
#define	BOKASHI				0	// 近景ぼかし 遠景ぼかし
#define SHADOW_DEMO			1

// 薬莢
#define ENE_T_GOL			1	// タンカー編ゴル兵
#define	ENE_SHOT			1	// ショットガン兵
#define	ENE_SHIELD 			1	// 盾兵

// ステージ間ロード
#define LOAD_W01C_R		0	// 居住区３Ｆ右側（w01c）へ

// プレイヤー状態
#define		STAND		0		// 立ち
#define		SQUAT		1		// しゃがみ
#define		GROUND		2		// 匍匐
#define		SUBJECT		3		// 主観
#define		CAUTION		4		// 張り付き
#define		ELUDE		5		// エルード
#define		FORCE		6		// 強制モーション
#define		LOCKER		7		// ロッカーモード
#define		BEHIND		8		// ビハインド
#define		LADDER		9		// はしご

// ドアモデル名のディファイン
#define DR_NAME1		w01f_dr
#define DR_NAME2		w01f_dr
#define DR_NAME3		w01f_dr
#define DR_NAME4		w01f_dr
#define DR_NAME5		w01f_dr

#define DR_NAME_WR1		w01asdr_body_r
#define DR_NAME_WR2		w01asdr_body_r
#define DR_NAME_WR3		w01asdr_body_r
#define DR_NAME_WR4		w01asdr_body_r
#define DR_NAME_WR5		w01asdr_body_r

#define DR_NAME_WL1		w01asdr_body_l
#define DR_NAME_WL2		w01asdr_body_l
