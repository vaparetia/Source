		trap ca008 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				chara カメラ設定 通路カメラ１ \
					-c 0 \
					-b -7900 -10000 -14383   -6000 10000 -14383 \
					-l -7900 -10000 -15100   -6000 10000 -15100 \
					-r 872,2048,0 -f 3105 \
					-a 200 \
					-i 0 -1 0 0 \
					-slide 0 5 1000 0 50 0 \
