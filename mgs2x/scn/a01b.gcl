				}else{							// 東から進入
					chara カメラ設定 通路カメラ１ \
						-c 0 \
						-b 5000 -10000 -17750   5000 5372 -5200 \
						-l 5000 -20000 -20000   5000 4328 20000 \
						-r 114,2048,0 -f 6000 \
						-a 200 \
						-i 0 -1 0 0 \
						-slide 1 5 6000 3000 50 0 \
						-s $3

					// ca023で使用
					eval( $w:補完方式 = 1 )
				}
			}
	}

	proc 北部北西角カメラ {
		trap ca026 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				if( $3 == 入る)	{	eval( $i:進入位置Ｘ = $i:前フレーム位置Ｘ )	}

				if( $i:進入位置Ｘ < -4000 ){	// 南から進入
					chara カメラ設定 通路カメラ１ \
						-c 0 \
						-b -4800 -10000 -18238   4800 7600 -18238 \
						-l -4800 4584 -18815   4800 4584 -18815 \
						-r 901,2048,0 -f 3073 \
						-a 200 \
						-i 0 -1 0 0 \
						-slide 0 5 1000 1000 50 0 \
						-s $3

					// ca001で使用
					eval( $w:補完方式 = 0 )
				}else{							// 東から進入
					chara カメラ設定 通路カメラ１ \
						-c 0 \
						-b -5000 -10000 -17750   -5000 5372 -5200 \
						-l -5000 -20000 -20000   -5000 4328 20000 \
						-r 114,2048,0 -f 6000 \
						-a 200 \
						-i 0 -1 0 0 \
						-slide 1 5 6000 3000 50 0 \
						-s $3

					// ca001で使用
					eval( $w:補完方式 = 1 )
				}
			}
	}

	proc 北部東西通路カメラ {
		trap ca025 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				if( $3 == 入る ){
					if( $w:補完方式 == 1 ){
						eval($w:補完方式 = 0)
					}else{
						eval($w:補完方式 = 1)
					}
				}
				chara カメラ設定 通路カメラ１ \
					-c 0 \
					-b -4800 7603 -18238   4800 7603 -18238 \
					-l -4800 4584 -18815   4800 4584 -18815 \
					-r 901,2048,0 -f 3073 \
					-a 200 \
					-i $w:補完方式 -1 0 0 \		// 補完方式は代入済み
					-slide 0 5 1000 1000 50 0 \
					-s $3
			}
	}

	proc ロッカー置き場カメラ {
		trap ca027 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				chara カメラ設定 通路カメラ１ \
					-c 1 \
					-p 2086,7100,7506 -t 2086,4408,6046 \
					-r 700,2048,0 -f 3062 \
					-a 200 \
					-i 1 -1 0 0 \
					-s $3
			}
	}

