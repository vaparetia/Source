	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_018_1]
		//衛星や盗聴などで得られた一般を含む
		//あらゆる通信情報が、２４時間体勢で
		//ＮＳＡの地下に集められていたのだ。
	}
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_019]
		//ここの情報を牛耳るものがそれこそ、
		//世界を動かす事ができる。	
	}
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_020]
		//ところが、２０００年の１月２４日……
		//このシステムが７３時間に渡って
		//ダウンした……。
	}
	talk ライデン 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:ライデン_021]
		//原因は？
	}
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_022]
		//政府の一部が指示したという噂がある。
		//当時有名だったクラッカー・グループにな。
	}
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_022_1]
		//政府の一部が指示したという噂がある。
		//当時有名だったクラッカー・グループにな。
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_023]
		//結果として安全対策は見直され、
