	talk ライデン 標準 -m {
		[P073_01_R01_通路Ａ１無線機デモ１＿１__e:ライデン_025]
		//俺はどこまでも利用された訳だ。
	}
	talk ローズ 標準 -m {
		[P073_01_R01_通路Ａ１無線機デモ１＿１__e:ローズ_026]
		//私はあなたに気に入られようと
		//必死だった……あなたの好きな髪型、
		//服装、仕草、話題……。
	}
	talk ローズ 標準 -m {
		[P073_01_R01_通路Ａ１無線機デモ１＿１__e:ローズ_026_1]
		//私はあなたに気に入られようと
		//必死だった……あなたの好きな髪型、
		//服装、仕草、話題……。
	}
	talk ローズ 標準 -m {
		[P073_01_R01_通路Ａ１無線機デモ１＿１__e:ローズ_027]
		//あなたが好きと言ってくれた私の髪も
		//目の色も……嘘なの。
