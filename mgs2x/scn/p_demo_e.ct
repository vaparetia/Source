	talk ライデン 標準 -m {
		[P073_01_R01_通路Ａ１無線機デモ１＿１__e:ライデン_040]
		//嘘の相手を愛することで
		//嘘の自分を演じていた。
	}
	talk ライデン 標準 -m {
		[P073_01_R01_通路Ａ１無線機デモ１＿１__e:ライデン_041]
		//俺は本当の君を知らない。
		//俺が知ってるのは嘘の君だ。
		//今、話している君じゃない。
	}
	talk ライデン 標準 -m {
		[P073_01_R01_通路Ａ１無線機デモ１＿１__e:ライデン_041_1]
		//俺は本当の君を知らない。
		//俺が知ってるのは嘘の君だ。
		//今、話している君じゃない。
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 40
	talk ローズ 標準 -m {
		[P073_01_R01_通路Ａ１無線機デモ１＿１__e:ローズ_042]
