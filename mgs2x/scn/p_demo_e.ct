//resource P024_01_R01_爆弾解体センサーＢ入手１無線デモ１＿１Ａ
proc vc112407:01  {
vox t:vc112407 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		[P024_01_R01_爆弾解体センサーＢ入手１無線デモ１＿１Ａ__e:ライデン_002]
		//無臭爆弾はどうなった。
	}
	talk ピーター 標準 -m {
		[P024_01_R01_爆弾解体センサーＢ入手１無線デモ１＿１Ａ__e:ピーター_003]
		//目の前にあるが、まだ近づいてはいない。
		//プリスキンの方はどうだ？。
	}
	@rpd_プリスキン顔表示
	talk プリスキン 標準 -m {
		[P024_01_R01_爆弾解体センサーＢ入手１無線デモ１＿１Ａ__e:プリスキン_004]
		//もう少し待ってくれ。
		//今最後の脚に到着した。敵兵が邪魔だ。
		//先に排除する……。
	}
	talk プリスキン 標準 -m {
		[P024_01_R01_爆弾解体センサーＢ入手１無線デモ１＿１Ａ__e:プリスキン_004_1]
		//もう少し待ってくれ。
		//今最後の脚に到着した。敵兵が邪魔だ。
		//先に排除する……。
	}
	talk ライデン 標準 -m {
		[P024_01_R01_爆弾解体センサーＢ入手１無線デモ１＿１Ａ__e:ライデン_005]
		//……スティルマン、厄介そうなのか？
	}
	@rpd_ピーター顔表示
@rp_うなづきデフォルト
	talk ピーター 標準 -m {
		[P024_01_R01_爆弾解体センサーＢ入手１無線デモ１＿１Ａ__e:ピーター_006]
		//ああ。少し妙だ。
		//起爆装置が作動していない。
	}
	talk ライデン 標準 -m {
		[P024_01_R01_爆弾解体センサーＢ入手１無線デモ１＿１Ａ__e:ライデン_007]
		//なに？
	}
	talk ピーター 標準 -m {
		[P024_01_R01_爆弾解体センサーＢ入手１無線デモ１＿１Ａ__e:ピーター_008]
		//だがセンサーは生きている……
		//これは……。
	}
@rp_うなづきデフォルト
	@rpd_プリスキン顔表示
	talk プリスキン 標準 -m {
		[P024_01_R01_爆弾解体センサーＢ入手１無線デモ１＿１Ａ__e:プリスキン_009]
		//こちらプリスキン。
		//最後のＣ４を発見した。
	}
	@rpd_ピーター顔表示
	talk ピーター 標準 -m {
		[P024_01_R01_爆弾解体センサーＢ入手１無線デモ１＿１Ａ__e:ピーター_010]
		//まさか！？
	}
	@rpd_プリスキン顔表示
	talk プリスキン 標準 -m {
		[P024_01_R01_爆弾解体センサーＢ入手１無線デモ１＿１Ａ__e:プリスキン_011]
		//今から凍結する。これで……。
	}
	@rpd_ピーター顔表示
	talk ピーター 標準 -m {
		[P024_01_R01_爆弾解体センサーＢ入手１無線デモ１＿１Ａ__e:ピーター_012]
		//プリスキン、待て！！
	}
}//v
}//d


//resource P024_01_R01_爆弾解体センサーＢ入手１無線デモ１＿２ 
proc vc112406:01  {
vox t:vc112406 {
	talk ピーター 標準 -m {
		[P024_01_R01_爆弾解体センサーＢ入手１無線デモ１＿２__e:ピーター_000]
		//くっ！やはり！！
	}
@rp_かみあわない＿否１＿話聞けよ系デフォルト 100
	@rpd_プリスキン顔表示
	talk プリスキン 標準 -m {
		[P024_01_R01_爆弾解体センサーＢ入手１無線デモ１＿２__e:プリスキン_001]
