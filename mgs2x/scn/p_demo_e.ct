	}
	talk ライデン 標準 -m {
		[P059_03_R01_エマ休憩３無線機デモ１＿１__e:ライデン_001]
		//大佐、エマ・エメリッヒを救出……
		//なんとか溺死するのだけは免れた。	
	}
@rp_うなづきデフォルト＿是
@rp_無茶指令＿否１＿お前がやれ系デフォルト 100
	talk 大佐 標準 -m {
		[P059_03_R01_エマ休憩３無線機デモ１＿１__e:大佐_002]
		//よし、
		//彼女をシェル１まで連れて行くんだ。
	}
	talk ライデン 標準 -m {
		[P059_03_R01_エマ休憩３無線機デモ１＿１__e:ライデン_003]
		//シェル１への上部連絡橋は
		//破壊されている。
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P059_03_R01_エマ休憩３無線機デモ１＿１__e:大佐_004]
		//確かオルガが言っていたな。
		//Ｌ脚下部のオイルフェンスを通って、
		//と……。
	}
	talk ライデン 標準 -m {
		[P059_03_R01_エマ休憩３無線機デモ１＿１__e:ライデン_005]
		//ああ、覚えている。
	}
@rp_うなづきデフォルト＿是
@rp_無茶指令＿否１＿お前がやれ系デフォルト 100
	talk 大佐 標準 -m {
		[P059_03_R01_エマ休憩３無線機デモ１＿１__e:大佐_006]
		//Ｌ脚から下へ降りられるはずだ。
		//Ｌ脚に向かえ。
	}
	talk ライデン 標準 -m {
		[P059_03_R01_エマ休憩３無線機デモ１＿１__e:ライデン_007]
		//エマはどうする？薬物の影響らしいが、
		//一人で歩くのは無理のようだ。
	}
}//v
}//d

