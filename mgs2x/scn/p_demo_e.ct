// テロ事件対策として、ムービーから無線に変更になったもの
//例のアレでぽよーん
//resource P049_03_R02_2_大統領３＿元ムービーデモ１ 
proc vc114902:01  {
vox t:vc114902 {
@rp_うなづきデフォルト
	talk 大統領 標準 -m {
		[P049_03_R02_2_大統領３＿元ムービーデモ１__e:大統領_001]
		//知らないのは当然だ。彼等の存在を
		//知っているのは＃｛最高暗号機密関与資格、コードワード・クリアランス｝＃を
		//持つ者の中でも極少数に限られる。
	}
	talk 大統領 標準 -m {
		[P049_03_R02_2_大統領３＿元ムービーデモ１__e:大統領_001_1]
		//知らないのは当然だ。彼等の存在を
		//知っているのは＃｛最高暗号機密関与資格、コードワード・クリアランス｝＃を
		//持つ者の中でも極少数に限られる。
	}
	talk ライデン 標準 -m {
		[P049_03_R02_2_大統領３＿元ムービーデモ１__e:ライデン_002]
		//？
	}
@rp_うなづきデフォルト
	talk 大統領 標準 -m {
		[P049_03_R02_2_大統領３＿元ムービーデモ１__e:大統領_003]
		//政治、軍事、経済……この国の
		//あらゆる決定は彼等が下している。
		//……無論大統領の選定も含めて。
	}
	talk 大統領 標準 -m {
		[P049_03_R02_2_大統領３＿元ムービーデモ１__e:大統領_004]
		//彼等こそ我が国を真に支配する者達だ。
	}
	talk ライデン 標準 -m {
		[P049_03_R02_2_大統領３＿元ムービーデモ１__e:ライデン_005]
		//そんな……。
	}
@rp_うなづきデフォルト
	talk 大統領 標準 -m {
		[P049_03_R02_2_大統領３＿元ムービーデモ１__e:大統領_006]
		//ふん。信じられないのも無理はない……
		//だが事実なのだ。
	}
	talk 大統領 標準 -m {
		[P049_03_R02_2_大統領３＿元ムービーデモ１__e:大統領_007]
		//宇宙防衛の重視、所得税率の引き下げ、
		//＃｛本土ミサイル防衛、ＮＭＤ｝＃の推進……
	}
@rp_うなづきデフォルト
	talk 大統領 標準 -m {
		[P049_03_R02_2_大統領３＿元ムービーデモ１__e:大統領_008]
		//私が行なったとされている全ての政策は
		//彼等の指示によるものだった。
	}
	talk ライデン 標準 -m {
		[P049_03_R02_2_大統領３＿元ムービーデモ１__e:ライデン_009]
		//宇宙防衛は議会から……。
	}
	talk 大統領 標準 -m {
		[P049_03_R02_2_大統領３＿元ムービーデモ１__e:大統領_010]
		//それも『愛国者達』の演出だよ。
	}
@rp_邪道外道＿否２＿ひどい系デフォルト 60
@rp_うなづきデフォルト＿是
	talk 大統領 標準 -m {
		[P049_03_R02_2_大統領３＿元ムービーデモ１__e:大統領_011]
		//議会はただの演芸場だ。
		//民主主義など教科書のページを埋める
		//ためのお題目でしかない。
	}
	talk 大統領 標準 -m {
		[P049_03_R02_2_大統領３＿元ムービーデモ１__e:大統領_012]
		//それとも君は『民意』が社会に
		//反映されるのを見たことでもあるのか？
	}
	talk ライデン 標準 -m {
		[P049_03_R02_2_大統領３＿元ムービーデモ１__e:ライデン_013]
		//……いや……。
	}
@rp_うなづきデフォルト
	talk 大統領 標準 -m {
		[P049_03_R02_2_大統領３＿元ムービーデモ１__e:大統領_014]
		//全ては『愛国者達』の利害と思惑に
		//基づいている。
	}
@rp_邪道外道＿否２＿ひどい系デフォルト 60
@rp_うなづきデフォルト＿是
	talk 大統領 標準 -m {
		[P049_03_R02_2_大統領３＿元ムービーデモ１__e:大統領_015]
		//それを見栄えのいい建前で取り繕った
		//ショーのことを、君達は『政治』と
		//呼んでいるのだ。
	}
	talk 大統領 標準 -m {
		[P049_03_R02_2_大統領３＿元ムービーデモ１__e:大統領_015_1]
		//それを見栄えのいい建前で取り繕った
		//ショーのことを、君達は『政治』と
		//呼んでいるのだ。
	}
	talk ライデン 標準 -m {
		[P049_03_R02_2_大統領３＿元ムービーデモ１__e:ライデン_016]
		//……。
	}
@rp_うなづきデフォルト
	talk 大統領 標準 -m {
		[P049_03_R02_2_大統領３＿元ムービーデモ１__e:大統領_017]
		//そんな目で見るな。
		//精神鑑定なら受けてるよ。
	}
	talk ライデン 標準 -m {
		[P049_03_R02_2_大統領３＿元ムービーデモ１__e:ライデン_018]
		//そういう意味では……。
	}
}//v
}

//resource P080_20_R01_2_ＡＧ浮上２０元ムービーデモ８ 
proc vc118002:01  {
vox t:vc118002 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P080_19_R01_ＡＧ浮上１９無線機デモ１＿１__e:大佐_000]
		//ライデン、聞こえるか？
		//我々だ。
	}
	talk ライデン 標準 -m {
		[P080_19_R01_ＡＧ浮上１９無線機デモ１＿１__e:ライデン_001]
		//なぜだ！？
		//ＡＩは崩壊したはず！？
	}
	talk 大佐 標準 -m {
		[P080_19_R01_ＡＧ浮上１９無線機デモ１＿１__e:大佐_002]
		//『Ｇ．Ｗ』は、な……。
	}
	talk ライデン 標準 -m {
		[P080_19_R01_ＡＧ浮上１９無線機デモ１＿１__e:ライデン_003]
		//お前達は一体！？
	}
@rp_うなづきデフォルト＿是
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	@rpd_バグ大佐顔表示
	talk 大佐 標準 -m {
		[P080_19_R01_ＡＧ浮上１９無線機デモ１＿１__e:大佐_004]
		//そもそも我々は正確には……
		//	人ではない。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P080_20_R01_2_ＡＧ浮上２０元ムービーデモ８__e:大佐_000]
		//この２００年の間に……
		//様々な念がホワイトハウスという
		//重力場で産み落とされた。
	}
	talk 大佐 標準 -m {
		[P080_20_R01_2_ＡＧ浮上２０元ムービーデモ８__e:大佐_000_1]
		//この２００年の間に……
		//様々な念がホワイトハウスという
		//重力場で産み落とされた。
	}
	talk 大佐 標準 -m {
		[P080_20_R01_2_ＡＧ浮上２０元ムービーデモ８__e:大佐_001]
		//４０億年前地球の海中で突然、生命が
		//生まれたように、ホワイトハウスの中で
		//芽生え、進化してきた……。
	}
	talk 大佐 標準 -m {
		[P080_20_R01_2_ＡＧ浮上２０元ムービーデモ８__e:大佐_001_1]
		//４０億年前地球の海中で突然、生命が
		//生まれたように、ホワイトハウスの中で
		//芽生え、進化してきた……。
	}
/* テロ対応でカット
	talk 大佐 標準 -m {
		[P080_20_R01_2_ＡＧ浮上２０元ムービーデモ８__e:大佐_002]
		//星条旗の元に……
		//市民宗教の中で……。
	}
*/
}//v
}


//resource P040_06b_M00_エイムズ発見６ｂ元ムービーデモ０
//vc114013
proc vc114013:01  {
vox t:vc114013 {
/*
	talk エイムズ 標準 -m {
		[P040_06b_M00_エイムズ発見６ｂ元ムービーデモ０__e:エイムズ_000]
		//奴等はそれをマンハッタン上空で
		//行おうとしているんだ。
	}
	talk ライデン 標準 -m {
		[P040_06b_M00_エイムズ発見６ｂ元ムービーデモ０__e:ライデン_001]
		//そうなったらウォール街の
		//電子機器は……。
	}
	talk エイムズ 標準 -m {
		[P040_06b_M00_エイムズ発見６ｂ元ムービーデモ０__e:エイムズ_002]
		//無論、壊滅だな。
	}
*/
	talk ライデン 標準 -m {
		[P040_06b_M00_エイムズ発見６ｂ元ムービーデモ０__e:ライデン_003]
		//世界経済の中心が機能を停止すれば、
		//世界的な大恐慌に陥る……
		//＃｛暗黒の月曜日、ブラックマンデー｝＃の再来……？。
	}
	talk ライデン 標準 -m {
		[P040_06b_M00_エイムズ発見６ｂ元ムービーデモ０__e:ライデン_003_1]
		//世界経済の中心が機能を停止すれば、
		//世界的な大恐慌に陥る……
		//＃｛暗黒の月曜日、ブラックマンデー｝＃の再来……？。
	}
/*
	talk ライデン 標準 -m {
		[P040_06b_M00_エイムズ発見６ｂ元ムービーデモ０__e:ライデン_003_2]
		//世界経済の中心が機能を停止すれば、
		//世界的な大恐慌に陥る……
		//＃｛暗黒の月曜日、ブラックマンデー｝＃の再来……？。
	}
*/
}//v
}//d

