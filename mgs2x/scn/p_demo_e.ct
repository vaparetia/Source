//resource P017_01_R01_爆弾解体中ローズその１無線デモ１＿１ 
proc vc111701:01  {
vox t:vc111701 {

@rp_キテレツさん＿否１＿なんだこいつ系デフォルト 100
@rp_セクハラ＿是１＿かわいい系デフォルト 100

	talk ローズ 標準 -m {
		[P017_01_R01_爆弾解体中ローズその１無線デモ１＿１__e:ローズ_000]
		//ジャック、爆弾解体って……
		//すごく神経を使うでしょ？
	}
	talk ライデン 標準 -m {
		[P017_01_R01_爆弾解体中ローズその１無線デモ１＿１__e:ライデン_001]
		//当たり前だ。
	}
	talk ローズ 標準 -m {
		[P017_01_R01_爆弾解体中ローズその１無線デモ１＿１__e:ローズ_002]
		//ああ、ごめん。無神経だったわね。
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
	talk ライデン 標準 -m {
		[P017_01_R01_爆弾解体中ローズその１無線デモ１＿１__e:ライデン_003]
		//いや……
		//ただ訓練ではやらなかったからな。
	}
	talk ローズ 標準 -m {
		[P017_01_R01_爆弾解体中ローズその１無線デモ１＿１__e:ローズ_004]
		//大丈夫？まいってない？
	}

@rp_セクハラ＿否２＿うっとおしい系デフォルト 100
@rp_セクハラ＿是１＿かわいい系デフォルト 80

	talk ライデン 標準 -m {
		[P017_01_R01_爆弾解体中ローズその１無線デモ１＿１__e:ライデン_005]
		//何度も吐きそうになった。
	}
	talk ローズ 標準 -m {
		[P017_01_R01_爆弾解体中ローズその１無線デモ１＿１__e:ローズ_006]
		//ジャック？
	}
	talk ライデン 標準 -m {
		[P017_01_R01_爆弾解体中ローズその１無線デモ１＿１__e:ライデン_007]
		//でもまだ大丈夫だ。
		//ひとりでやってる訳じゃない。
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		[P017_01_R01_爆弾解体中ローズその１無線デモ１＿１__e:ローズ_008]
		//……そ、そうね。
	}
	talk ローズ 標準 -m {
		[P017_01_R01_爆弾解体中ローズその１無線デモ１＿１__e:ローズ_009]
		//解体している時って、
		//どんな事を考えるの？
	}
	talk ライデン 標準 -m {
		[P017_01_R01_爆弾解体中ローズその１無線デモ１＿１__e:ライデン_010]
		//いろんな事が思い出される……
		//でも、それらを押し込める事が
		//大切なんだ。
	}
	talk ライデン 標準 -m {
		[P017_01_R01_爆弾解体中ローズその１無線デモ１＿１__e:ライデン_011]
		//無心にならないと……
		//恐怖に飲まれてはいけないらしい。
	}

@rp_キテレツさん＿否１＿なんだこいつ系デフォルト 100
@rp_セクハラ＿是１＿かわいい系デフォルト 100

	talk ローズ 標準 -m {
		[P017_01_R01_爆弾解体中ローズその１無線デモ１＿１__e:ローズ_012]
		//私の事なんかも考えるの？
	}
	talk ライデン 標準 -m {
		[P017_01_R01_爆弾解体中ローズその１無線デモ１＿１__e:ライデン_013]
		//……。
	}
	talk ローズ 標準 -m {
		[P017_01_R01_爆弾解体中ローズその１無線デモ１＿１__e:ローズ_014]
		//ごめんなさい、こんな時にね。
	}

@rp_セクハラ＿是＿やりたがり系デフォルト 100
	talk ライデン 標準 -m {
		[P017_01_R01_爆弾解体中ローズその１無線デモ１＿１__e:ライデン_015]
		//いいんだ。そうだな、
		//４月３０日が何の日か？
		//それを考えている。
	}
	talk ローズ 標準 -m {
		[P017_01_R01_爆弾解体中ローズその１無線デモ１＿１__e:ローズ_016]
		//思い出した？
	}
	talk ライデン 標準 -m {
		[P017_01_R01_爆弾解体中ローズその１無線デモ１＿１__e:ライデン_017]
		//いや、まだだ。
	}
	talk ローズ 標準 -m {
		[P017_01_R01_爆弾解体中ローズその１無線デモ１＿１__e:ローズ_018]
		//思い出すまで、死んじゃダメよ。
	}
	talk ライデン 標準 -m {
		[P017_01_R01_爆弾解体中ローズその１無線デモ１＿１__e:ライデン_020]
		//わかった……。
	}
}//v
}//d



//resource P018_01_R01_爆弾解体中ローズその２無線デモ１ 
proc vc111801:01  {
vox t:vc111801 {

@rp_セクハラ＿是＿やりたがり系デフォルト 100

	talk ローズ 標準 -m {
		[P018_01_R01_爆弾解体中ローズその２無線デモ１__e:ローズ_000]
		//ジャック、教えて？
		//爆弾解体って、女の子を口説くような
		//もの？
	}
	talk ライデン 標準 -m {
		[P018_01_R01_爆弾解体中ローズその２無線デモ１__e:ライデン_001]
		//なに？
		//どういう意味だ？
	}

@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_キテレツさん＿否１＿なんだこいつ系デフォルト 100

	talk ローズ 標準 -m {
		[P018_01_R01_爆弾解体中ローズその２無線デモ１__e:ローズ_002]
		//壊さないように、慎重に、慎重に……。
		//心の防御を一枚、一枚、剥がしていく
		//みたなもんでしょ？
	}
	talk ライデン 標準 -m {
		[P018_01_R01_爆弾解体中ローズその２無線デモ１__e:ライデン_003]
		//そうだな、一理あるかも。
		//まあ、俺には苦手な分野だ。
	}
	talk ローズ 標準 -m {
		[P018_01_R01_爆弾解体中ローズその２無線デモ１__e:ローズ_004]
		//そうね、ジャックはせっかちだから。
	}
	talk ライデン 標準 -m {
		[P018_01_R01_爆弾解体中ローズその２無線デモ１__e:ライデン_005]
		//いや、外から眺めている方が好きなんだ。
	}

@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否

	talk ローズ 標準 -m {
		[P018_01_R01_爆弾解体中ローズその２無線デモ１__e:ローズ_006]
		//人の真実に触れるのが怖い？
	}
	talk ライデン 標準 -m {
		[P018_01_R01_爆弾解体中ローズその２無線デモ１__e:ライデン_007]
		//面倒なんだ。厄介事が。
	}
@rp_つっこまれ＿是１＿なんで知ってるんだ系デフォルト 100
	talk ローズ 標準 -m {
		[P018_01_R01_爆弾解体中ローズその２無線デモ１__e:ローズ_008]
		//私の事も？
	}
	talk ライデン 標準 -m {
		[P018_01_R01_爆弾解体中ローズその２無線デモ１__e:ライデン_009]
		//それは……。
	}
	talk ローズ 標準 -m {
		[P018_01_R01_爆弾解体中ローズその２無線デモ１__e:ローズ_010]
		//ねえ、ジャック？
	}

@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否

	talk ライデン 標準 -m {
		[P018_01_R01_爆弾解体中ローズその２無線デモ１__e:ライデン_011]
		//ああ？
	}
	talk ローズ 標準 -m {
		[P018_01_R01_爆弾解体中ローズその２無線デモ１__e:ローズ_012]
		//今回の任務を引き受けたの、
		//なぜだかわかる？
	}
	talk ライデン 標準 -m {
		[P018_01_R01_爆弾解体中ローズその２無線デモ１__e:ライデン_013]
		//？
	}

@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_キテレツさん＿否１＿なんだこいつ系デフォルト 80

	talk ローズ 標準 -m {
		[P018_01_R01_爆弾解体中ローズその２無線デモ１__e:ローズ_014]
		//あなたの心を覗いてみたかったの。
		//私のしらない、本当のあなた。
	}
	talk ライデン 標準 -m {
		[P018_01_R01_爆弾解体中ローズその２無線デモ１__e:ライデン_015]
		//いつもそばにいたじゃないか？
	}

@rp_つっこまれ＿是１＿なんで知ってるんだ系デフォルト 100
@rp_うなづきデフォルト＿否

	talk ローズ 標準 -m {
		[P018_01_R01_爆弾解体中ローズその２無線デモ１__e:ローズ_016]
		//いいえ、あなたいつも心を閉ざしていた。
		//それが何か、知りたいの。
	}
	talk ライデン 標準 -m {
		[P018_01_R01_爆弾解体中ローズその２無線デモ１__e:ライデン_017]
		//……ふむ……		//
		//これじゃ、こっちが解体されそうだ。
	}

@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否

	talk ローズ 標準 -m {
		[P018_01_R01_爆弾解体中ローズその２無線デモ１__e:ローズ_018]
		//ごめん、冗談よ。	
	}
	talk ローズ 標準 -m {
		[P018_01_R01_爆弾解体中ローズその２無線デモ１__e:ローズ_019]
		//がんばってね、ジャック。
	}
}//v
}//d



//resource P019_01_R01_爆弾解体中ローズその３無線デモ１＿１ 
