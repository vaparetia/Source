		//先を越されたな。
		//俺の方はまだ１つ残っている。
	}
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		[P023_01_R01_爆弾解体最後の一つ１無線デモ１＿１__e:ライデン_003]
		//ピーターの方は？
