//resource P040_02_R02_エイムズ発見２無線デモ１＿１ 
proc vc114001:01  {
vox t:vc114001 {
	talk エイムズ 標準 -m {
		[P040_02_R02_エイムズ発見２無線デモ１＿１__e:エイムズ_000]
		//聞こえるか？
	}
	talk ライデン 標準 -m {
		[P040_02_R02_エイムズ発見２無線デモ１＿１__e:ライデン_001]
		//大丈夫だ。
	}
	talk ライデン 標準 -m {
		[P040_02_R02_エイムズ発見２無線デモ１＿１__e:ライデン_002]
		//あんた、本当に大統領の居場所を？
	}
@rp_うなづきデフォルト
	talk エイムズ 標準 -m {
		[P040_02_R02_エイムズ発見２無線デモ１＿１__e:エイムズ_003]
		//ああ。シェル２中央棟の１Ｆに
		//移されたらしい。
	}
	talk ライデン 標準 -m {
		[P040_02_R02_エイムズ発見２無線デモ１＿１__e:ライデン_004]
		//シェル２中央棟の１Ｆ……。
	}
	talk ライデン 標準 -m {
		[P040_02_R02_エイムズ発見２無線デモ１＿１__e:ライデン_005]
		//今もそこにいるのか？
	}
	talk エイムズ 標準 -m {
		[P040_02_R02_エイムズ発見２無線デモ１＿１__e:エイムズ_006]
		//いや、今は反応がない。	
	}		
	talk ライデン 標準 -m {
		[P040_02_R02_エイムズ発見２無線デモ１＿１__e:ライデン_007]
		//まさか、他の人質のように……？
	}
@rp_かみあわない＿否１＿話聞けよ系デフォルト 100
	talk エイムズ 標準 -m {
		[P040_02_R02_エイムズ発見２無線デモ１＿１__e:エイムズ_008]
		//？
	}
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		[P040_02_R02_エイムズ発見２無線デモ１＿１__e:ライデン_009]
		//ＳＥＡＬ１０が突入した報復に人質が
		//殺されただろう？
	}
	talk エイムズ 標準 -m {
		[P040_02_R02_エイムズ発見２無線デモ１＿１__e:エイムズ_010]
		//何のことだ？
	}
	talk ライデン 標準 -m {
		[P040_02_R02_エイムズ発見２無線デモ１＿１__e:ライデン_011]
		//……？
	}
	talk エイムズ 標準 -m {
		[P040_02_R02_エイムズ発見２無線デモ１＿１__e:エイムズ_012]
		//他の人質はともかく、
		//奴等は大統領を殺さない。
	}
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		[P040_02_R02_エイムズ発見２無線デモ１＿１__e:ライデン_013]
		//なぜそう言い切れる？
	}
	talk エイムズ 標準 -m {
		[P040_02_R02_エイムズ発見２無線デモ１＿１__e:エイムズ_014]
		//ブラックケースだよ。
	}
	talk ライデン 標準 -m {
		[P040_02_R02_エイムズ発見２無線デモ１＿１__e:ライデン_015]
		//奴等が奪っていった、
		//核兵器を解除するケースのことか？
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk エイムズ 標準 -m {
		[P040_02_R02_エイムズ発見２無線デモ１＿１__e:エイムズ_016]
		//そうだ。奴等はブラックケースを奪った。
		//だがそれだけでは意味を成さない。
	}
	talk エイムズ 標準 -m {
		[P040_02_R02_エイムズ発見２無線デモ１＿１__e:エイムズ_017]
		//あのケースは最新ハイテク技術の粋を
		//集めたものだ。
	}
	talk エイムズ 標準 -m {
		[P040_02_R02_エイムズ発見２無線デモ１＿１__e:エイムズ_018]
		//合衆国大統領の生体データを用いる
		//暗号システムを採用している。
	}
	talk ライデン 標準 -m {
