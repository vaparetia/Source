//resource P050_01_R01_タンカー編整理１無線機デモ１＿１ 
proc vc115001:01  {
vox t:vc115001 {
	talk プリスキン 標準 -m {
		[P050_01_R01_タンカー編整理１無線機デモ１＿１__e:プリスキン_000]
		//ライデン、そっちはどうだっ！
	}
	talk ライデン 標準 -m {
		[P050_01_R01_タンカー編整理１無線機デモ１＿１__e:ライデン_001]
		//スネーク？
		//……大統領が殺された！
	}
	talk プリスキン 標準 -m {
		[P050_01_R01_タンカー編整理１無線機デモ１＿１__e:プリスキン_002]
		//なんだって？
	}
	talk ライデン 標準 -m {
		[P050_01_R01_タンカー編整理１無線機デモ１＿１__e:ライデン_003]
		//すまない。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		[P050_01_R01_タンカー編整理１無線機デモ１＿１__e:プリスキン_004]
		//核発射コードの再確認はすんでいたのか？
	}
	talk ライデン 標準 -m {
		[P050_01_R01_タンカー編整理１無線機デモ１＿１__e:ライデン_005]
		//いや、最終のヴァイタルＩＤチェックの
		//前だった。
	}
	talk プリスキン 標準 -m {
		[P050_01_R01_タンカー編整理１無線機デモ１＿１__e:プリスキン_006]
		//ということは、奴らは核を撃てなく
		//なったわけだな。
	}
	talk ライデン 標準 -m {
		[P050_01_R01_タンカー編整理１無線機デモ１＿１__e:ライデン_007]
		//だが、あの男、オセロットは明らかに		//
		//わざと大統領を殺した。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		[P050_01_R01_タンカー編整理１無線機デモ１＿１__e:プリスキン_008]
		//どういうことだ？
	}
	talk ライデン 標準 -m {
		[P050_01_R01_タンカー編整理１無線機デモ１＿１__e:ライデン_009]
		//わからない。大統領が死ねば核が
		//撃てなくなることは奴等も知っていた
		//はずだ。
	}
	talk ライデン 標準 -m {
		[P050_01_R01_タンカー編整理１無線機デモ１＿１__e:ライデン_009_1]
		//わからない。大統領が死ねば核が
		//撃てなくなることは奴等も知っていた
		//はずだ。
	}
	@rpd_オタコン顔表示
	talk オタコン 標準 -m {
		[P050_01_R01_タンカー編整理１無線機デモ１＿１__e:オタコン_010]
		//ヴァイタルＩＤチェックを回避して
		//核を撃つ方法がある？。
	}
	@rpd_プリスキン顔表示
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		[P050_01_R01_タンカー編整理１無線機デモ１＿１__e:プリスキン_011]
		//あるいは核以上の何かがあるということ
		//だろうな……アーセナルギアには。
	}
	talk ライデン 標準 -m {
		[P050_01_R01_タンカー編整理１無線機デモ１＿１__e:ライデン_012]
		//知っていたのか？アーセナルギアのこと？
	}
@rp_うなづきデフォルト＿是
@rp_邪道外道＿否２＿ひどい系デフォルト 100
	talk プリスキン 標準 -m {
		[P050_01_R01_タンカー編整理１無線機デモ１＿１__e:プリスキン_013]
		//ああ。
	}
	talk ライデン 標準 -m {
		[P050_01_R01_タンカー編整理１無線機デモ１＿１__e:ライデン_014]
		//……なぜ教えてくれなかった？
	}
	talk プリスキン 標準 -m {
		[P050_01_R01_タンカー編整理１無線機デモ１＿１__e:プリスキン_015]
		//聞かれなかったからな。
	}
	talk ライデン 標準 -m {
		[P050_01_R01_タンカー編整理１無線機デモ１＿１__e:ライデン_016]
		//……『ビッグ・シェル』が偽装だという
		//ことも？
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		[P050_01_R01_タンカー編整理１無線機デモ１＿１__e:プリスキン_017]
		//ああ。この『ビッグ・シェル』は一応、
		//海洋除染施設の体裁を整えてはいる。
	}
	talk プリスキン 標準 -m {
		[P050_01_R01_タンカー編整理１無線機デモ１＿１__e:プリスキン_017_1]
		//ああ。この『ビッグ・シェル』は一応、
		//海洋除染施設の体裁を整えてはいる。
	}
	talk プリスキン 標準 -m {
		[P050_01_R01_タンカー編整理１無線機デモ１＿１__e:プリスキン_018]
		//だがエイムズや大統領の言った通り、
		//それは偽装だった。
	}
	talk プリスキン 標準 -m {
		[P050_01_R01_タンカー編整理１無線機デモ１＿１__e:プリスキン_018_1]
		//だがエイムズや大統領の言った通り、
		//それは偽装だった。
	}
	talk プリスキン 標準 -m {
		[P050_01_R01_タンカー編整理１無線機デモ１＿１__e:プリスキン_019]
		//海水除染は申し訳程度にしか行われて
		//いないし、破壊されても有毒化学物質
		//など発生しないだろう……。
	}
	talk プリスキン 標準 -m {
		[P050_01_R01_タンカー編整理１無線機デモ１＿１__e:プリスキン_019_1]
		//海水除染は申し訳程度にしか行われて
		//いないし、破壊されても有毒化学物質
		//など発生しないだろう……。
	}
	talk ライデン 標準 -m {
		[P050_01_R01_タンカー編整理１無線機デモ１＿１__e:ライデン_020]
		//……いつからそれを？
	}
@rp_うなづきデフォルト＿是
@rp_邪道外道＿否２＿ひどい系デフォルト 100
	talk プリスキン 標準 -m {
		[P050_01_R01_タンカー編整理１無線機デモ１＿１__e:プリスキン_021]
		//確かめるには時間がかかった。
