	talk ライデン 標準 -m {
		[P073_01_R01_通路Ａ１無線機デモ１＿１__e:ライデン_045]
		//それを信じろというのか。
	}
	talk ローズ 標準 -m {
		[P073_01_R01_通路Ａ１無線機デモ１＿１__e:ローズ_046]
		//……。
	}
	talk ライデン 標準 -m {
		[P073_01_R01_通路Ａ１無線機デモ１＿１__e:ライデン_047]
		//いいさ。
		//君にもいろいろ事情があったんだろう？
		//それは分かるよ。でもこれで……。
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 30
	talk ローズ 標準 -m {
		[P073_01_R01_通路Ａ１無線機デモ１＿１__e:ローズ_048]
		//ジャック！！
