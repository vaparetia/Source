		//無論だ。しかしお前は信じざるを得ない。
		//そうだろう？
	}
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		[P036_03_R01_忍者登場３無線デモ１＿１__e:ライデン_025]
		//……。
	}
	talk ミスターＸ 標準 -m {
		[P036_03_R01_忍者登場３無線デモ１＿１__e:オルガ_026]
		//他に手がかりがあるのか？
	}
	talk ライデン 標準 -m {
		[P036_03_R01_忍者登場３無線デモ１＿１__e:ライデン_027]
		//……人質はどこにいる？
	}
	talk ミスターＸ 標準 -m {
		[P036_03_R01_忍者登場３無線デモ１＿１__e:オルガ_028]
		//ふふん。
	}
}//v
}//d





//resource P036_08_R02_忍者登場８無線デモ２＿１ 
proc vc113611:01  {
vox t:vc113611 {
	talk ミスターＸ 標準 -m {
		[P036_08_R02_忍者登場８無線デモ２＿１__e:オルガ_000]
		//急いだ方が良いぞ。奴等には核がある。
	}
	talk ライデン 標準 -m {
		[P036_08_R02_忍者登場８無線デモ２＿１__e:ライデン_001]
		//核！？
		//奴等、核兵器を持ち込んでいるのか！？
	}
@rp_うなづきデフォルト
	talk ミスターＸ 標準 -m {
		[P036_08_R02_忍者登場８無線デモ２＿１__e:オルガ_002]
		//お前はおかしいと思わなかったのか？
	}
	talk ミスターＸ 標準 -m {
		[P036_08_R02_忍者登場８無線デモ２＿１__e:オルガ_003]
		//大統領を人質にとっているとはいえ、
		//なぜ奴等はここにとどまっているのか？
	}
// ↓海外版では不要
/*	talk ミスターＸ 標準 -m {
		[P036_08_R02_忍者登場８無線デモ２＿１__e:オルガ_004]
		//逃げ場のないこの孤島に……
		//脱出手段も用意せず。
	}
*/
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		[P036_08_R02_忍者登場８無線デモ２＿１__e:ライデン_005]
		//例え奴等が核兵器を持ち込んだとしても、
		//核弾頭には安全装置が組み込まれている
		//はずだ。起爆コード入力式の……。
	}
	talk ライデン 標準 -m {
		[P036_08_R02_忍者登場８無線デモ２＿１__e:ライデン_005_1]
		//例え奴等が核兵器を持ち込んだとしても、
		//核弾頭には安全装置が組み込まれている
		//はずだ。起爆コード入力式の……。
	}
	talk ミスターＸ 標準 -m {
		[P036_08_R02_忍者登場８無線デモ２＿１__e:オルガ_006]
		//それも奴等は手に入れている。
	}
}//v
}//d





//resource P036_10_R03_忍者登場１０無線デモ３＿１ 
proc vc113621:01  {
vox t:vc113621 {
	talk ライデン 標準 -m {
		[P036_10_R03_忍者登場１０無線デモ３＿１__e:ライデン_000]
		//なぜここにブラックケースを
		//持ち込んだんだ？
		//ただの除染プラントに……。
	}
	talk ライデン 標準 -m {
		[P036_10_R03_忍者登場１０無線デモ３＿１__e:ライデン_000_1]
		//なぜここにブラックケースを
		//持ち込んだんだ？
		//ただの除染プラントに……。
	}
	talk ミスターＸ 標準 -m {
		[P036_10_R03_忍者登場１０無線デモ３＿１__e:オルガ_001]
		//答えは簡単だ。『ビッグ・シェル』は
		//除染プラントなどではないからだよ。	
	}
	talk ミスターＸ 標準 -m {
		[P036_10_R03_忍者登場１０無線デモ３＿１__e:オルガ_001_1]
		//答えは簡単だ。『ビッグ・シェル』は
		//除染プラントなどではないからだよ。	
	}
	talk ライデン 標準 -m {
		[P036_10_R03_忍者登場１０無線デモ３＿１__e:ライデン_002]
		//なに！？
	}
@rp_うなづきデフォルト
	talk ミスターＸ 標準 -m {
		[P036_10_R03_忍者登場１０無線デモ３＿１__e:オルガ_003]
		//核も奴等が持ち込んだのではない。
		//初めからここにあるものだ。
		//そう、全ては偽装……。
	}
	talk ミスターＸ 標準 -m {
		[P036_10_R03_忍者登場１０無線デモ３＿１__e:オルガ_003_1]
		//核も奴等が持ち込んだのではない。
		//初めからここにあるものだ。
		//そう、全ては偽装……。
	}
	talk ライデン 標準 -m {
		[P036_10_R03_忍者登場１０無線デモ３＿１__e:ライデン_004]
		//偽装！？いったい何の？
	}
	talk ミスターＸ 標準 -m {
		[P036_10_R03_忍者登場１０無線デモ３＿１__e:オルガ_005]
		//ここには……メタルギアがある……。
	}
}//v
}//d



//resource P036_13_R04_忍者登場１３無線デモ４＿１ 
proc vc113631:01  {
vox t:vc113631 {
	talk ライデン 標準 -m {
		[P036_13_R04_忍者登場１３無線デモ４＿１__e:ライデン_000]
		//大佐、今の男は何者だ？
	}
	talk 大佐 標準 -m {
		[P036_13_R04_忍者登場１３無線デモ４＿１__e:大佐_001]
		//我々の仲間ではない。
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P036_13_R04_忍者登場１３無線デモ４＿１__e:大佐_002]
		//違う……うちにあんな隊員はいない。
	}
	talk ライデン 標準 -m {
		[P036_13_R04_忍者登場１３無線デモ４＿１__e:ライデン_003]
		//この『ビッグ・シェル』に
		//新型メタルギアがあると言っていたが？
	}
	talk 大佐 標準 -m {
		[P036_13_R04_忍者登場１３無線デモ４＿１__e:大佐_004]
		//初耳だ……。
	}
	talk ライデン 標準 -m {
		[P036_13_R04_忍者登場１３無線デモ４＿１__e:ライデン_005]
		//大佐、俺に何を隠している？
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P036_13_R04_忍者登場１３無線デモ４＿１__e:大佐_006]
		//いや。隠し事などしていない。
		//全て話している。
	}
	talk ライデン 標準 -m {
		[P036_13_R04_忍者登場１３無線デモ４＿１__e:ライデン_007]
		//……それは大佐の知っている全てか？
		//それとも俺に話していいと許可された
		//ことの全てか？
	}
	talk 大佐 標準 -m {
		[P036_13_R04_忍者登場１３無線デモ４＿１__e:大佐_008]
		//馬鹿なことを言うな、ライデン！
	}
	talk ライデン 標準 -m {
		[P036_13_R04_忍者登場１３無線デモ４＿１__e:ライデン_009]
		//……。
	}
@rp_無茶指令＿否１＿お前がやれ系デフォルト 100
@rp_うなづきデフォルト＿是
	talk 大佐 標準 -m {
		[P036_13_R04_忍者登場１３無線デモ４＿１__e:大佐_010]
		//メタルギアについてはこちらでも調べて
		//みる。君はエイムズに接触してくれ。
	}
	talk ライデン 標準 -m {
		[P036_13_R04_忍者登場１３無線デモ４＿１__e:ライデン_011]
		//あの男の言うことを信じろと？	
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P036_13_R04_忍者登場１３無線デモ４＿１__e:大佐_012]
		//他に大統領につながる手がかりがない
		//以上、今は他に方法がない。
	}
@rp_無茶指令＿否１＿お前がやれ系デフォルト 100
@rp_うなづきデフォルト＿是
	talk 大佐 標準 -m {
		[P036_13_R04_忍者登場１３無線デモ４＿１__e:大佐_013]
		//メタルギアのことも含めて情報を
		//得るんだ。
	}
	talk ライデン 標準 -m {
		[P036_13_R04_忍者登場１３無線デモ４＿１__e:ライデン_014]
		//それが指令か？
	}
	talk 大佐 標準 -m {
		[P036_13_R04_忍者登場１３無線デモ４＿１__e:大佐_015]
		//そうだ。敵兵士に変装して
		//シェル１中央棟に潜入しろ。
	}
	talk ライデン 標準 -m {
		[P036_13_R04_忍者登場１３無線デモ４＿１__e:ライデン_016]
		//……了解。
	}
}//v
}//d



//resource P037_01_R01_スネークの遺体１無線デモ１＿１ 
