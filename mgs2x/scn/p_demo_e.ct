//resource P061_01_R01_エマとオタコン１無線機デモ１＿１ 
proc vc116101:01  {
vox t:vc116101 {
	talk プリスキン 標準 -m {
		[P061_01_R01_エマとオタコン１無線機デモ１＿１__e:プリスキン_000]
		//ライデン、電算室に侵入した。
		//どうだ？
	}
	talk ライデン 標準 -m {
		[P061_01_R01_エマとオタコン１無線機デモ１＿１__e:ライデン_001]
		//エマは無事だ。
		//これからそっちへ向かう。
	}
@rp_うなづきデフォルト
	@rpd_オタコン顔表示
	talk オタコン 標準 -m {
		[P061_01_R01_エマとオタコン１無線機デモ１＿１__e:オタコン_002]
		//よかった……。
	}
	@rpd_プリスキン顔表示
	talk プリスキン 標準 -m {
		[P061_01_R01_エマとオタコン１無線機デモ１＿１__e:プリスキン_003]
		//シェル１には誰もいない。
		//皆アーセナルに乗り込んだようだ。
	}
	@rpd_オタコン顔表示
	talk オタコン 標準 -m {
		[P061_01_R01_エマとオタコン１無線機デモ１＿１__e:オタコン_004]
		//いろいろやってみたけどやっぱり
		//僕じゃ手が出せない。ＥＥでなきゃ……。
	}
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		[P061_01_R01_エマとオタコン１無線機デモ１＿１__e:ライデン_005]
		//それじゃ、エマに変わる。
	}
	talk オタコン 標準 -m {
		[P061_01_R01_エマとオタコン１無線機デモ１＿１__e:オタコン_006]
		//えっ、ＥＥに……。
	}
	talk ライデン 標準 -m {
		[P061_01_R01_エマとオタコン１無線機デモ１＿１__e:ライデン_007]
		//俺の体内通信を中継する。	
	}
	talk オタコン 標準 -m {
		[P061_01_R01_エマとオタコン１無線機デモ１＿１__e:オタコン_008]
		//あ、あ……。
	}
	talk ライデン 標準 -m {
		[P061_01_R01_エマとオタコン１無線機デモ１＿１__e:ライデン_009]
		//代わるぞ？。
	}
	//うなづき禁止ＸＸＸＸＸＸＸＸＸＸ
	mindds
	@rpd_エマ顔表示プレイヤー側
	talk エマ 標準 -m {
		[P061_01_R01_エマとオタコン１無線機デモ１＿１__e:エマ_010]
		//……お兄ちゃん？
	}
//無線機画面、ライデンの変わりにオタコンが表示される。オタコンを動かすことはできるが、相づちはうてないようにする。
}//v
}//d

//resource P061_01_R01_エマとオタコン１無線機デモ１＿２ 
proc vc116102:01  {
vox t:vc116102 {

