//resource P047_05_R01_電撃床前オルガ５無線デモ１＿１ 
proc vc114701:01  {
vox t:vc114701 {
	talk ライデン 標準 -m {
		[P047_05_R01_電撃床前オルガ５無線デモ１＿１__e:ライデン_000]
		//大統領が軟禁されている部屋に到着した。
	}
	talk 大佐 標準 -m {
		[P047_05_R01_電撃床前オルガ５無線デモ１＿１__e:大佐_001]
		//そこは大丈夫か？
	}
	talk ライデン 標準 -m {
		[P047_05_R01_電撃床前オルガ５無線デモ１＿１__e:ライデン_002]
		//浸水はしていないが、扉には近づけない。
		//高圧電流が流されている。
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P047_05_R01_電撃床前オルガ５無線デモ１＿１__e:大佐_003]
		//なるほど。上は歩くな。黒焦げになるぞ。
	}
	talk ライデン 標準 -m {
		[P047_05_R01_電撃床前オルガ５無線デモ１＿１__e:ライデン_004]
		//どうすればいい？。
	}
	talk 大佐 標準 -m {
		[P047_05_R01_電撃床前オルガ５無線デモ１＿１__e:大佐_005]
		//シャドーモセス事件を思い出せ。
		//あの事件のＶＲ訓練をな。
	}
	talk ライデン 標準 -m {
		[P047_05_R01_電撃床前オルガ５無線デモ１＿１__e:ライデン_006]
		//電源パネルを破壊する？
	}
@rp_うなづきデフォルト＿是
@rp_無茶指令＿否１＿お前がやれ系デフォルト 100
	talk 大佐 標準 -m {
		[P047_05_R01_電撃床前オルガ５無線デモ１＿１__e:大佐_007]
		//そうだ。
	}
	talk ライデン 標準 -m {
		[P047_05_R01_電撃床前オルガ５無線デモ１＿１__e:ライデン_008]
		//しかし、中には入れそうもない。
	}
}//v
}//d

proc vc114702:01  {
//vox t:vc114702 
movie t:vc114702 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P047_05_R01_電撃床前オルガ５無線デモ１＿１__e:大佐_009]
		//通気ダクトがあるだろう？。
	}
	talk ライデン 標準 -m {
		[P047_05_R01_電撃床前オルガ５無線デモ１＿１__e:ライデン_010]
		//ああ……ダクトの穴なら……。
	}
@rp_うなづきデフォルト＿是
@rp_無茶指令＿否１＿お前がやれ系デフォルト 100
	talk 大佐 標準 -m {
		[P047_05_R01_電撃床前オルガ５無線デモ１＿１__e:大佐_011]
		//リモコン・ミサイルを探すんだ。
		//リモコン・ミサイルなら、
		//ダクトを通過する事ができる。
	}
	talk ライデン 標準 -m {
		[P047_05_R01_電撃床前オルガ５無線デモ１＿１__e:ライデン_012]
		//それで、室内の電源パネルを破壊すれば
		//いいんだな。
	}
	talk 大佐 標準 -m {
		[P047_05_R01_電撃床前オルガ５無線デモ１＿２__e:大佐_000]
		//そうだ。ただし大統領には当てるなよ。
	}
}//v
}//d

//スクリーン内に子画面。リモコンミサイルでクリアする映像を出す。一番難しいコース。

//resource P047_05_R01_電撃床前オルガ５無線デモ１＿２ 
proc vc114703:01  {
vox t:vc114703 {
	talk ライデン 標準 -m {
		[P047_05_R01_電撃床前オルガ５無線デモ１＿２__e:ライデン_001]
		//大統領にもナノマシンが注入されて
		//いるんだろう？周波数がわかれば
		//呼びかけるが……。
	}
	talk ライデン 標準 -m {
		[P047_05_R01_電撃床前オルガ５無線デモ１＿２__e:ライデン_001_1]
		//大統領にもナノマシンが注入されて
		//いるんだろう？周波数がわかれば
		//呼びかけるが……。
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P047_05_R01_電撃床前オルガ５無線デモ１＿２__e:大佐_002]
		//いや、こちらからも何度かＣＡＬＬして
		//いるが通じない。そこの壁は通信を
		//妨害する素材で出来ているようだ。
	}
	talk 大佐 標準 -m {
		[P047_05_R01_電撃床前オルガ５無線デモ１＿２__e:大佐_002_1]
		//いや、こちらからも何度かＣＡＬＬして
		//いるが通じない。そこの壁は通信を
		//妨害する素材で出来ているようだ。
	}
	talk ライデン 標準 -m {
		[P047_05_R01_電撃床前オルガ５無線デモ１＿２__e:ライデン_003]
		//なるほど。
		//エイムズが反応を見失ったのは
		//そのためか……。
	}
	talk 大佐 標準 -m {
		[P047_05_R01_電撃床前オルガ５無線デモ１＿２__e:大佐_004]
		//だがノードに接続すれば彼の位置は
		//確認出来るはずだ。
	}
	talk ライデン 標準 -m {
		[P047_05_R01_電撃床前オルガ５無線デモ１＿２__e:ライデン_005]
		//わかった。
	}
@rp_うなづきデフォルト＿是
@rp_無茶指令＿否１＿お前がやれ系デフォルト 100
	talk 大佐 標準 -m {
		[P047_05_R01_電撃床前オルガ５無線デモ１＿２__e:大佐_006]
		//まずはリモコン・ミサイルを探せ。
	}
}//v
}//d



//resource P049_02_R01_大統領２無線機デモ１＿１
proc vc114901:01  {
vox t:vc114901 {
	talk ライデン 標準 -m {
		[P049_02_R01_大統領２無線機デモ１＿１__e:ライデン_000]
		//聞こえますか？
	}
	talk 大統領 標準 -m {
		[P049_02_R01_大統領２無線機デモ１＿１__e:大統領_001]
		//ああ。
	}
	talk ライデン 標準 -m {
		[P049_02_R01_大統領２無線機デモ１＿１__e:ライデン_002]
		//大統領、テロリスト達は核発射の
		//コード入力を終了したと……。
	}
	talk ライデン 標準 -m {
		[P049_02_R01_大統領２無線機デモ１＿１__e:ライデン_002_1]
		//大統領、テロリスト達は核発射の
		//コード入力を終了したと……。
	}
@rp_邪道外道＿否１＿サイテー系デフォルト 100
@rp_うなづきデフォルト＿是
	talk 大統領 標準 -m {
		[P049_02_R01_大統領２無線機デモ１＿１__e:大統領_003]
		//……そうだ。私が自分で入力した。	
	}
	talk ライデン 標準 -m {
		[P049_02_R01_大統領２無線機デモ１＿１__e:ライデン_004]
		//……やはりあなたは奴等と……？
	}
	talk 大統領 標準 -m {
		[P049_02_R01_大統領２無線機デモ１＿１__e:大統領_005]
		//２時間前まではな。
		//今はヴァイタルＩＤの再確認が
		//終わるまで生かされているだけの身だ。
	}
	talk 大統領 標準 -m {
		[P049_02_R01_大統領２無線機デモ１＿１__e:大統領_005_1]
		//２時間前まではな。
		//今はヴァイタルＩＤの再確認が
		//終わるまで生かされているだけの身だ。
	}
	talk ライデン 標準 -m {
		[P049_02_R01_大統領２無線機デモ１＿１__e:ライデン_006]
		//裏切られた？
	}
@rp_うなづきデフォルト
	talk 大統領 標準 -m {
		[P049_02_R01_大統領２無線機デモ１＿１__e:大統領_007]
		//いや。私は継承を望み、彼らは破壊を
		//欲した。思想の違い、といったところ
		//かな。
	}
	talk 大統領 標準 -m {
		[P049_02_R01_大統領２無線機デモ１＿１__e:大統領_007_1]
		//いや。私は継承を望み、彼らは破壊を
		//欲した。思想の違い、といったところ
		//かな。
	}
/*
	talk ライデン 標準 -m {
		[P049_02_R01_大統領２無線機デモ１＿１__e:ライデン_008]
		//思想？
		//テロになんの思想があると？
	}
	talk 大統領 標準 -m {
		[P049_02_R01_大統領２無線機デモ１＿１__e:大統領_009]
		//どんなものにも思想はある。
	}
*/
	talk ライデン 標準 -m {
		[P049_02_R01_大統領２無線機デモ１＿１__e:ライデン_010]
		//……なぜテロを？
	}
@rp_うなづきデフォルト
	talk 大統領 標準 -m {
		[P049_02_R01_大統領２無線機デモ１＿１__e:大統領_011]
		//権力に加わるためだ。
	}
	talk ライデン 標準 -m {
		[P049_02_R01_大統領２無線機デモ１＿１__e:ライデン_012]
		//＃｛大統領、あなた｝＃が権力でしょう？
	}
	talk 大統領 標準 -m {
		[P049_02_R01_大統領２無線機デモ１＿１__e:大統領_013]
		//いや、私は外様だよ。
	}
	talk ライデン 標準 -m {
		[P049_02_R01_大統領２無線機デモ１＿１__e:ライデン_014]
		//？
	}
@rp_うなづきデフォルト
	talk 大統領 標準 -m {
		[P049_02_R01_大統領２無線機デモ１＿１__e:大統領_015]
		//私に実権はないのだ。
		//本当の『権力』は『愛国者達』の
		//元にある……。
	}
	talk ライデン 標準 -m {
		[P049_02_R01_大統領２無線機デモ１＿１__e:ライデン_016]
		//『愛国者達』？
	}
	talk 大統領 標準 -m {
		[P049_02_R01_大統領２無線機デモ１＿１__e:大統領_017]
		//この国の真実だよ。
	}
}//v
}//d




//resource P049_05_R02_大統領５無線機デモ２＿１ 
proc vc114911:01  {
vox t:vc114911 {
	talk 大統領 標準 -m {
		[P049_05_R02_大統領５無線機デモ２＿１__e:大統領_000]
		//私の望みは『愛国者達』の一員となる
		//こと……彼等の支配構造に加わること
		//だった。
	}
	talk 大統領 標準 -m {
		[P049_05_R02_大統領５無線機デモ２＿１__e:大統領_001]
		//使い捨てのポーン駒としてではなく。
	}
	talk ライデン 標準 -m {
		[P049_05_R02_大統領５無線機デモ２＿１__e:ライデン_002]
		//それがテロを起こした理由？
	}
@rp_うなづきデフォルト
	talk 大統領 標準 -m {
		[P049_05_R02_大統領５無線機デモ２＿１__e:大統領_003]
		//そうだ。新型メタルギアも、
		//あくまで取り引き材料として使う
		//つもりだった……。
	}
	talk ライデン 標準 -m {
		[P049_05_R02_大統領５無線機デモ２＿１__e:ライデン_004]
		//……だった、とは？
	}
	talk 大統領 標準 -m {
		[P049_05_R02_大統領５無線機デモ２＿１__e:大統領_005]
		//私は見くびっていた。ソリダスは……
		//本気で彼等に闘いを挑もうとしている。
		//奴は世界を壊すつもりだ。
	}
	talk 大統領 標準 -m {
		[P049_05_R02_大統領５無線機デモ２＿１__e:大統領_005_1]
		//私は見くびっていた。ソリダスは……
		//本気で彼等に闘いを挑もうとしている。
		//奴は世界を壊すつもりだ。
	}
	talk ライデン 標準 -m {
		[P049_05_R02_大統領５無線機デモ２＿１__e:ライデン_006]
		//どういうことです？
	}
@rp_うなづきデフォルト
	talk 大統領 標準 -m {
		[P049_05_R02_大統領５無線機デモ２＿１__e:大統領_007]
		//君が信じようと信じまいと、
		//世界の均衡を保っているのは
		//『愛国者達』なのだよ。
	}
	talk 大統領 標準 -m {
		[P049_05_R02_大統領５無線機デモ２＿１__e:大統領_008]
		//この国に渦巻く利害を調整し、
		//結果を分かりやすい『物語』にして
		//大衆に提供する。
	}
	talk 大統領 標準 -m {
		[P049_05_R02_大統領５無線機デモ２＿１__e:大統領_008_1]
		//この国に渦巻く利害を調整し、
		//結果を分かりやすい『物語』にして
		//大衆に提供する。
	}
	talk 大統領 標準 -m {
		[P049_05_R02_大統領５無線機デモ２＿１__e:大統領_009]
		//その機能が停止すれば、いや、
		//その存在が公になっただけでどうなる？	
	}
	talk ライデン 標準 -m {
		[P049_05_R02_大統領５無線機デモ２＿１__e:ライデン_010]
		//？
	}
@rp_うなづきデフォルト
	talk 大統領 標準 -m {
		[P049_05_R02_大統領５無線機デモ２＿１__e:大統領_011]
		//巨大な政治的真空が生まれる。
		//その空位を貪欲なブタどもが見逃す
		//はずがない。
	}
	talk 大統領 標準 -m {
		[P049_05_R02_大統領５無線機デモ２＿１__e:大統領_012]
		//すぐさま共食いが始まるだろう。
		//世界中であらゆるタガが外れる。
	}
	talk 大統領 標準 -m {
		[P049_05_R02_大統領５無線機デモ２＿１__e:大統領_013]
		//紛争、内戦、恐慌……
		//誰も制御することはできない……。
	}
	talk 大統領 標準 -m {
		[P049_05_R02_大統領５無線機デモ２＿１__e:大統領_014]
		//彼等は闘ってはいけない相手なのだ。
	}
	talk ライデン 標準 -m {
		[P049_05_R02_大統領５無線機デモ２＿１__e:ライデン_015]
		//……世界を混乱させるのはあなたの
		//本意ではないと？	
	}
@rp_うなづきデフォルト
	talk 大統領 標準 -m {
		[P049_05_R02_大統領５無線機デモ２＿１__e:大統領_016]
		//……そうだ。
		//私には破滅を望むことが出来なかった。
		//だが奴は言ったよ。	
	}
	talk 大統領 標準 -m {
		[P049_05_R02_大統領５無線機デモ２＿１__e:大統領_016_1]
		//……そうだ。
		//私には破滅を望むことが出来なかった。
		//だが奴は言ったよ。	
	}
	talk 大統領 標準 -m {
		[P049_05_R02_大統領５無線機デモ２＿１__e:大統領_017]
		//それが私の限界だ、とな。
	}
	talk ライデン 標準 -m {
		[P049_05_R02_大統領５無線機デモ２＿１__e:ライデン_018]
		//……ソリダスとは、一体何者なんです？
	}
}//v
}//d


