	talk ライデン 標準 -m {
		[P058_07_R03_エマ救出７無線機デモ３＿１__e:ライデン_005]
		//できる限り、急いでむこうまで行く。
	}
}//v
}//d



//resource P059_03_R01_エマ休憩３無線機デモ１＿１ 
proc vc115901:01  {
vox t:vc115901 {
	talk 大佐 標準 -m {
