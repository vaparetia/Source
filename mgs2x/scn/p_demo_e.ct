	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
	talk ローズ 標準 -m {
		[P041_02_R01_エイムズ死亡後２無線デモ１＿１__e:ローズ_020]
		//ジャック……
		//私も大佐の言う通りだと思う。
		//今は大統領を……。
	}
	talk ライデン 標準 -m {
		[P041_02_R01_エイムズ死亡後２無線デモ１＿１__e:ライデン_021]
		//わかった……。
	}
}//v
}//d





//resource P042_01_R01_シェル１シェル２連絡橋１無線デモ１＿１ 
proc vc114201:01  {
vox t:vc114201 {
	talk プリスキン 標準 -m {
		[P042_01_R01_シェル１シェル２連絡橋１無線デモ１＿１__e:プリスキン_000]
		//ライデン、聞こえるか！
	}
	talk ライデン 標準 -m {
		[P042_01_R01_シェル１シェル２連絡橋１無線デモ１＿１__e:ライデン_001]
		//プリスキンか？
		//今までどこに？
	}
@rp_かみあわない＿否１＿話聞けよ系デフォルト 100
	talk プリスキン 標準 -m {
		[P042_01_R01_シェル１シェル２連絡橋１無線デモ１＿１__e:プリスキン_002]
		//ちょっとした調べものだ。今Ｈ脚にいる。
		//そっちの状況は？。
	}
	talk ライデン 標準 -m {
		[P042_01_R01_シェル１シェル２連絡橋１無線デモ１＿１__e:ライデン_003]
		//大統領の手がかりを得た。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		[P042_01_R01_シェル１シェル２連絡橋１無線デモ１＿１__e:プリスキン_004]
		//何処だ？
	}
	talk ライデン 標準 -m {
		[P042_01_R01_シェル１シェル２連絡橋１無線デモ１＿１__e:ライデン_005]
		//シェル２の中央棟の１Ｆにいるらしい。
	}
	talk プリスキン 標準 -m {
		[P042_01_R01_シェル１シェル２連絡橋１無線デモ１＿１__e:プリスキン_006]
		//そうか、こっちはひどい有様だ。
		//ここからでは中央棟へは回れない。
	}
	talk ライデン 標準 -m {
		[P042_01_R01_シェル１シェル２連絡橋１無線デモ１＿１__e:ライデン_007]
		//わかった。これからシェル２へ向かう。
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うなづきデフォルト＿否
	talk プリスキン 標準 -m {
		[P042_01_R01_シェル１シェル２連絡橋１無線デモ１＿１__e:プリスキン_008]
		//シェル１シェル２連絡橋には
		//赤外線センサーのトラップが
		//仕掛けられている。
	}
	talk プリスキン 標準 -m {
		[P042_01_R01_シェル１シェル２連絡橋１無線デモ１＿１__e:プリスキン_009]
		//赤外線に触れるとセムテックスが
		//爆発するぞ。
	}
	talk ライデン 標準 -m {
		[P042_01_R01_シェル１シェル２連絡橋１無線デモ１＿１__e:ライデン_010]
		//ああ、奴らが話しているのを聞いた。
	}
@rp_無茶指令＿否１＿お前がやれ系デフォルト 100
	talk プリスキン 標準 -m {
		[P042_01_R01_シェル１シェル２連絡橋１無線デモ１＿１__e:プリスキン_011]
		//制御装置を狙撃して破壊するんだ。
		//くれぐれも、セムテックス本体を
		//撃つんじゃないぞ。
	}
/*	
	talk ライデン 標準 -m {
		[P042_01_R01_シェル１シェル２連絡橋１無線デモ１＿１__e:ライデン_012]
		//爆弾解体に使った冷却スプレーは？	
	}
	talk プリスキン 標準 -m {
		[P042_01_R01_シェル１シェル２連絡橋１無線デモ１＿１__e:プリスキン_013]
		//奴らも馬鹿じゃない。
		//セムテックスは橋の裏に仕掛けてある。
	}
*/
	talk ライデン 標準 -m {
		[P042_01_R01_シェル１シェル２連絡橋１無線デモ１＿１__e:ライデン_014]
		//破壊しなければならない装置は？
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		[P042_01_R01_シェル１シェル２連絡橋１無線デモ１＿１__e:プリスキン_015]
		//双眼鏡で見てみるといい。
	}
}//v
}//d




//resource P044_01_R01_赤外線センサークリア１無線デモ１＿１ 
proc vc114401:01  {
vox t:vc114401 {
	talk プリスキン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿１__e:プリスキン_000]
		//ライデン、いいものを手に入れたぞ。
	}
	talk ライデン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿１__e:ライデン_001]
		//いいもの？
	}
	talk プリスキン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿１__e:プリスキン_002]
		//敵のカサッカだ。
	}
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿１__e:ライデン_003]
		//飛べるのか？
	}
	talk プリスキン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿１__e:プリスキン_004]
		//燃料もＯＫだ。今からシェル１へ向かう。
		//ハリアーはどうした？
	}
	talk ライデン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿１__e:ライデン_005]
		//いや、こっちのヘリポートにはいない。	
	}
	talk プリスキン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿１__e:プリスキン_006]
		//よし、今のうちだ。そっちへ降りる。
	}
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿１__e:ライデン_007]
		//人質を頼む。
		//中央棟の１Ｆに軟禁されている。
	}
	talk ライデン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿１__e:ライデン_008]
		//プリスキン、他に人質が捕らわれている
		//場所を見つけたか？
	}
	talk プリスキン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿１__e:プリスキン_009]
		//いや。そんな気配はなかった。
	}
	talk ライデン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿１__e:ライデン_010]
		//そうか……。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿１__e:プリスキン_011]
		//人質は何人いた？
	}
	talk ライデン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿１__e:ライデン_012]
		//３０名弱……うち、１名死亡した。
		//何人か怪我もしている。
	}
	talk プリスキン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿１__e:プリスキン_013]
		//カサッカの貨物はどうがんばっても
		//１３人が限界だ。
	}
	talk ライデン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿１__e:ライデン_014]
		//もう一機のカサッカは？
	}
	talk プリスキン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿１__e:プリスキン_015]
		//飛べない様に細工をしておいた。
		//追跡されては困るからな。
	}
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿１__e:ライデン_016]
		//そうか。
	}
	talk プリスキン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿１__e:プリスキン_017]
		//往復するしかない。
	}
	talk ライデン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿１__e:ライデン_018]
		//カサッカを操縦できるのか？
	}
	talk プリスキン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿１__e:プリスキン_019]
		//民間用のＫＡ−６２の経験パイロットが
		//いる。と言ってもＶＲ訓練だがな。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿１__e:プリスキン_020]
		//機体は軍用型のＫＡ−６０とほとんど
		//同じだから問題なく操縦できるだろう。
	}
//（ＯＦＦ）
	talk オタコン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿１__e:オタコン_021]
		//準備完了だ……。
	}
	talk プリスキン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿１__e:プリスキン_022]
		//ライデン、俺の相棒を紹介する。
		//オタコンだ。
	}		
	talk ライデン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿１__e:ライデン_023]
		//オタコン？
	}
	@rpd_オタコン顔表示
@rp_キテレツさん＿否１＿なんだこいつ系デフォルト 100
@rp_うなづきデフォルト＿是
	talk オタコン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿１__e:オタコン_024]
		//やあ、ライデン。始めまして。よろしく頼むよ。
	}
@rp_うなづきデフォルト
	@rpd_プリスキン顔表示
	talk プリスキン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿１__e:プリスキン_025]
		//まずいっ！
	}
	talk プリスキン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿１__e:プリスキン_026]
		//ライデン、後で話す。
	}
}//v
}//d




//resource P044_01_R01_赤外線センサークリア１無線デモ１＿２ 
proc vc114402:01  {
vox t:vc114402 {
	talk ライデン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿２__e:ライデン_000]
		//大佐、答えてくれ！
		//プリスキン達は何者なんだ？
	}
	talk 大佐 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿２__e:大佐_001]
		//君の考えている事ならわかる。
	}
	talk ライデン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿２__e:ライデン_002]
		//シャドーモセスにオタコンと言えば……。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿２__e:ローズ_003]
		//ハル・エメリッヒ博士。
		//シャドーモセス事件での生存者。
	}
	talk ライデン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿２__e:ライデン_004]
		//ローズ？
	}
	talk ローズ 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿２__e:ローズ_005]
		//あの事件の後、スネークとオタコンは
		//テロリストとして指名手配された。
	}
	talk ライデン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿２__e:ライデン_006]
			//反メタルギア団体……。
	}
	@rpd_大佐顔表示

@rp_うなづきデフォルト

	talk 大佐 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿２__e:大佐_007]
		//彼らは世界中のメタルギアを
		//破壊して回った。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿２__e:ローズ_008]
		//そして２年前その『ビッグ・シェル』が
		//建造される理由を作った。
	}
	talk ローズ 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿２__e:ローズ_008_1]
		//そして２年前その『ビッグ・シェル』が
		//建造される理由を作った。
	}
	talk ライデン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿２__e:ライデン_009]
		//スネーク達はテロリストではない。
	}
	talk ローズ 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿２__e:ローズ_010]
		//ジャック、どうして彼らをかばうの？
	}
	talk ライデン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿２__e:ライデン_011]
		//これまで任務を遂行して感じる……
		//		//使命感だけでは＃｛潜入任務、スニーキング・ミッション｝＃は達成できない。
		//単にタフなだけでは。
	}
	talk ライデン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿２__e:ライデン_011_1]
		//これまで任務を遂行して感じる……
		//		//使命感だけでは＃｛潜入任務、スニーキング・ミッション｝＃は達成できない。
		//単にタフなだけでは。
	}
	talk ローズ 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿２__e:ローズ_012]
		//ジャック、大丈夫？
	}
	talk ライデン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿２__e:ライデン_013]
		//それ以上に崇高な何か？
		//	そう、的確な言葉が見あたらないが。
	}
	talk ライデン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿２__e:ライデン_014]
		//たとえば、『勇気』や『理想』に
		//裏付けされた強い『意志』が必要だ。
	}
	talk ライデン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿２__e:ライデン_015]
		//俺にも感じるんだ。シャドーモセスを
		//救ったスネークはテロリストに豹変は
		//しない。
	}
	talk ライデン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿２__e:ライデン_015_1]
		//俺にも感じるんだ。シャドーモセスを
		//救ったスネークはテロリストに豹変は
		//しない。
	}
@rp_うなづきデフォルト＿是
@rp_かみあわない＿否１＿話聞けよ系デフォルト 100
	@rpd_大佐顔表示
	talk 大佐 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿２__e:大佐_016]
		//それは定かではないが、
		//彼らは２年前、タンカーと共に沈んだ。
		//そしてスネークの遺体も回収されている。
	}
	talk ライデン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿２__e:ライデン_017]
		//遺体のＤＮＡ検査も一致。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿２__e:ローズ_018]
		//ジャック、あなたの気持ちもわかる。
		//でもスネークは死んでるの。
	}
	talk ローズ 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿２__e:ローズ_019]
		//だから彼がハル・エメリッヒ博士である
		//はずはないわ。
	}
	talk ライデン 標準 -m {
		[P044_01_R01_赤外線センサークリア１無線デモ１＿２__e:ライデン_020]
		//もうひとつ確かな事がある……
		//テロリストのリーダーもスネークでは
		//ありえない。
	}
}//v
}//d




//resource P046_02_R01_ハリアー戦勝利２無線デモ１＿１ 
proc vc114601:01  {
vox t:vc114601 {
	talk プリスキン 標準 -m {
		[P046_02_R01_ハリアー戦勝利２無線デモ１＿１__e:プリスキン_000]
		//ライデン、大丈夫か？
	}
	talk ライデン 標準 -m {
		[P046_02_R01_ハリアー戦勝利２無線デモ１＿１__e:ライデン_001]
