	talk ライデン 標準 -m {
		[P073_01_R01_通路Ａ１無線機デモ１＿１__e:ライデン_049]
		//え？
	}
/*
bugface 0 ローズ \
		-span 150 50 \
		-face ros_radio_mh_mt ros_radio_mh_mt 
*/
	talk ローズ 標準 -m {
		[P073_01_R01_通路Ａ１無線機デモ１＿１__e:ローズ_050]
		//私……お腹に……お腹に……。
	}
	talk ローズ 標準 -m {
		[P073_01_R01_通路Ａ１無線機デモ１＿１__e:ローズ_050_1]
		//私……お腹に……お腹に……。
	}
bugeyes 0 1
@rp_キテレツさん＿否２＿意味不明系デフォルト 100
	talk ローズ 標準 -m {
		[P073_01_R01_通路Ａ１無線機デモ１＿１__e:ローズ_051]
