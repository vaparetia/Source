		//ＥＥかい？
	}
	talk エマ 標準 -m {
		[P061_01_R01_エマとオタコン１無線機デモ１＿２__e:エマ_001]
		//お兄ちゃん……。
	}
	talk オタコン 標準 -m {
		[P061_01_R01_エマとオタコン１無線機デモ１＿２__e:オタコン_002]
		//ＥＥ……。
	}
	talk オタコン 標準 -m {
		[P061_01_R01_エマとオタコン１無線機デモ１＿２__e:オタコン_003]
		//ＥＥ、なぜメタルギアなんかに手を？
