	talk ライデン 標準 -m {
		[P073_01_R01_通路Ａ１無線機デモ１＿１__e:ライデン_037]
		//それを聞いて、少しは気がおさまった。
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 50
	talk ローズ 標準 -m {
		[P073_01_R01_通路Ａ１無線機デモ１＿１__e:ローズ_038]
		//えっ？
	}
	talk ライデン 標準 -m {
		[P073_01_R01_通路Ａ１無線機デモ１＿１__e:ライデン_039]
		//嘘の人格を愛していたんだ。
		//いや、愛していたつもりになっていた。
