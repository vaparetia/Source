//resource P008_01_R01_ＡＢ連絡橋１無線デモ１＿１ 
proc vc110801:01  {
vox t:vc110801 {
	talk 大佐 標準 -m {
		[P008_01_R01_ＡＢ連絡橋１無線デモ１＿１__e:大佐_000]
		//ライデン、気をつけろ。
		//連絡橋の中央に見張りがいる。
		//そのまま進めば発見されるぞ。
	}
	talk 大佐 標準 -m {
		[P008_01_R01_ＡＢ連絡橋１無線デモ１＿１__e:大佐_000_1]
		//ライデン、気をつけろ。
		//連絡橋の中央に見張りがいる。
		//そのまま進めば発見されるぞ。
	}
	talk ライデン 標準 -m {
		[P008_01_R01_ＡＢ連絡橋１無線デモ１＿１__e:ライデン_001]
		//どうすれば？
	}

@rp_うなづきデフォルト

	talk 大佐 標準 -m {
		[P008_01_R01_ＡＢ連絡橋１無線デモ１＿１__e:大佐_002]
		//＃｛ぶら下がり、エルード｝＃を使うんだ。
	}
	talk ライデン 標準 -m {
		[P008_01_R01_ＡＢ連絡橋１無線デモ１＿１__e:ライデン_003]
		//エルード？
	}
}//v
}//d

//resource P008_01_R01_ＡＢ連絡橋１無線デモ１＿２ 
proc vc110802:01  {
//vox t:vc110802 
movie t:vc110802 {

@rp_無茶指令＿否１＿お前がやれ系デフォルト 100
@rp_うなづきデフォルト＿是

	talk 大佐 標準 -m {
		[P008_01_R01_ＡＢ連絡橋１無線デモ１＿２__e:大佐_000]
		//腰くらいの高さの手すりに向かって
		//＃｛△、アクション｝＃ボタンを押すと、
		//手すりを乗り越えて向こう側に
		//ぶら下がることが出来る。
	}
	talk 大佐 標準 -m {
		[P008_01_R01_ＡＢ連絡橋１無線デモ１＿２__e:大佐_001]
		//そのまま移動すれば敵に見つからずに
		//進めるはずだ。
	}
	talk ライデン 標準 -m {
		[P008_01_R01_ＡＢ連絡橋１無線デモ１＿２__e:ライデン_002]
		//わかった、やってみる。
	}

@rp_うなづきデフォルト＿是

	talk 大佐 標準 -m {
		[P008_01_R01_ＡＢ連絡橋１無線デモ１＿２__e:大佐_003]
		//｛＃握力、ＧＲＩＰ｝＃ゲージを忘れるな。
		//エルードしている間、時間と共に
		//減っていく。
	}
	talk 大佐 標準 -m {
		[P008_01_R01_ＡＢ連絡橋１無線デモ１＿２__e:大佐_004]
		//ゲージがなくなると落下してしまうぞ。
	}
}//v
}//d

//resource P008_01_R01_ＡＢ連絡橋１無線デモ１＿３ 
proc vc110803:01  {
vox t:vc110803 {
	talk ライデン 標準 -m {
		[P008_01_R01_ＡＢ連絡橋１無線デモ１＿３__e:ライデン_000]
	//了解。
	}

@rp_うなづきデフォルト

	talk 大佐 標準 -m {
		[P008_01_R01_ＡＢ連絡橋１無線デモ１＿ＳＥＡＬＳ無線傍受__e:大佐_000]
		//まて、ライデン。
		//今、ＳＥＡＬ１０突入部隊の無線を
		//傍受した。
	}
	talk ライデン 標準 -m {
		[P008_01_R01_ＡＢ連絡橋１無線デモ１＿ＳＥＡＬＳ無線傍受__e:ライデン_001]
		//傍受？
	}
	talk 大佐 標準 -m {
		[P008_01_R01_ＡＢ連絡橋１無線デモ１＿ＳＥＡＬＳ無線傍受__e:大佐_002]
		//もう一度言うが、彼らは我々の存在を
		//知らない。
	}

@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		[P008_01_R01_ＡＢ連絡橋１無線デモ１＿ＳＥＡＬＳ無線傍受__e:ライデン_003]
		//盗み聞きってわけか。
	}
	talk 大佐 標準 -m {
		[P008_01_R01_ＡＢ連絡橋１無線デモ１＿ＳＥＡＬＳ無線傍受__e:大佐_004]
		//そっちへ繋ぐ……。
	}
//画面にはＳＥＡＬＳの顔は表示されない。画面はライデンと大佐。

@rp_うなづきデフォルト

	talk シールズ 標準 -m {
		[P008_01_R01_ＡＢ連絡橋１無線デモ１＿ＳＥＡＬＳ無線傍受__e:シールズ_005]
		//こちらアルファー・ゼロ。
		//大統領を確保……。
	}
	talk シールズ隊長 標準 -m {
		[P008_01_R01_ＡＢ連絡橋１無線デモ１＿ＳＥＡＬＳ無線傍受__e:シールズ隊長_006]
		//無事か！
	}
	talk シールズ 標準 -m {
		[P008_01_R01_ＡＢ連絡橋１無線デモ１＿ＳＥＡＬＳ無線傍受__e:シールズ_007]
		//無事です。
	}

@rp_うなづきデフォルト

	talk シールズ隊長 標準 -m {
		[P008_01_R01_ＡＢ連絡橋１無線デモ１＿ＳＥＡＬＳ無線傍受__e:シールズ隊長_008]
		//パッケージは？
	}
	talk シールズ 標準 -m {
		[P008_01_R01_ＡＢ連絡橋１無線デモ１＿ＳＥＡＬＳ無線傍受__e:シールズ_009]
		//海軍大佐共々、保護しました。
		//楽勝でしたよ……。
	}

@rp_うなづきデフォルト

	talk シールズ隊長 標準 -m {
		[P008_01_R01_ＡＢ連絡橋１無線デモ１＿ＳＥＡＬＳ無線傍受__e:シールズ隊長_010]
		//よし、ヘリを回す。脱出してくれ……。
	}
	talk シールズ 標準 -m {
		[P008_01_R01_ＡＢ連絡橋１無線デモ１＿ＳＥＡＬＳ無線傍受__e:シールズ_011]
		//了解……な、なんだ！？
	}
