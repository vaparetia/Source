//resource P023_01_R01_爆弾解体最後の一つ１無線デモ１＿２ 
proc vc112303:01  {
vox t:vc112303 {
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		[P023_01_R01_爆弾解体最後の一つ１無線デモ１＿２__e:ライデン_000]
		//使えるのか？
	}
	talk ピーター 標準 -m {
		[P023_01_R01_爆弾解体最後の一つ１無線デモ１＿２__e:ピーター_001]
		//ここで試した。確かに反応する。
		//ただし、レーダー・スクリーンではなく、
		//音で知らせる仕組みだ。
	}
	talk ピーター 標準 -m {
		[P023_01_R01_爆弾解体最後の一つ１無線デモ１＿２__e:ピーター_001_1]
		//ここで試した。確かに反応する。
		//ただし、レーダー・スクリーンではなく、
		//音で知らせる仕組みだ。
	}
	talk ライデン 標準 -m {
		[P023_01_R01_爆弾解体最後の一つ１無線デモ１＿２__e:ライデン_002]
		//音？
	}
	talk ピーター 標準 -m {
		[P023_01_R01_爆弾解体最後の一つ１無線デモ１＿２__e:ピーター_003]
		//音の間隔だ。
		//短くなる程接近していることを意味する。
	}
	talk ライデン 標準 -m {
		[P023_01_R01_爆弾解体最後の一つ１無線デモ１＿２__e:ライデン_004]
		//わかった。
	}
}//v
}//d

