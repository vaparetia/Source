	talk ライデン 標準 -m {
		[P050_06_R03_タンカー編整理６無線機デモ３＿１__e:ライデン_009]
		//……。
	}
	@rpd_プリスキン顔表示
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
