	talk ライデン 標準 -m {
		[P046_02_R01_ハリアー戦勝利２無線デモ１＿３__e:ライデン_008]
		//かもしれん？
	}
	talk 大佐 標準 -m {
		[P046_02_R01_ハリアー戦勝利２無線デモ１＿３__e:大佐_009]
		//決して気を許すな。
	}
	talk ライデン 標準 -m {
		[P046_02_R01_ハリアー戦勝利２無線デモ１＿３__e:ライデン_010]
		//なぜ？
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P046_02_R01_ハリアー戦勝利２無線デモ１＿３__e:大佐_011]
		//彼らとの協力はシミュレーションには
