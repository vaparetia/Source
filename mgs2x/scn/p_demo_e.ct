@rp_セクハラ＿是１＿かわいい系デフォルト 70
@rp_邪道外道＿否１＿サイテー系デフォルト 100
	talk ローズ 標準 -m {
		[P073_01_R01_通路Ａ１無線機デモ１＿１__e:ローズ_015]
		//あなたと恋に落ちたのは……。
	}
	talk ライデン 標準 -m {
		[P073_01_R01_通路Ａ１無線機デモ１＿１__e:ライデン_016]
		//卑劣な……。
	}
	talk ローズ 標準 -m {
		[P073_01_R01_通路Ａ１無線機デモ１＿１__e:ローズ_017]
		//言い訳はできない。この２年間、
		//あなたの私生活を＃｛報告、レポート｝＃していた……
		//あなたの行動、言動……細かな事まで。
	}
	talk ローズ 標準 -m {
		[P073_01_R01_通路Ａ１無線機デモ１＿１__e:ローズ_017_1]
		//言い訳はできない。この２年間、
		//あなたの私生活を＃｛報告、レポート｝＃していた……
		//あなたの行動、言動……細かな事まで。
	}
	talk ローズ 標準 -m {
		[P073_01_R01_通路Ａ１無線機デモ１＿１__e:ローズ_017_2]
		//言い訳はできない。この２年間、
		//あなたの私生活を＃｛報告、レポート｝＃していた……
		//あなたの行動、言動……細かな事まで。
