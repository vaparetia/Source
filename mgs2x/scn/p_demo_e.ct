//resource P030_01_R01_フォーチュン戦中無線無線デモ１＿カウント後 
proc vc113006:01  {
vox t:vc113006 {
	talk ライデン 標準 -m {
		[P030_01_R01_フォーチュン戦中無線無線デモ１＿カウント後__e:ライデン_000]
		//ここを破壊する気だな。
	}
	talk 大佐 標準 -m {
		[P030_01_R01_フォーチュン戦中無線無線デモ１＿カウント後__e:大佐_001]
		//デッドセルの目的と奴の目的は
		//既に違うようだ。	
	}
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		[P030_01_R01_フォーチュン戦中無線無線デモ１＿カウント後__e:ライデン_002]
		//応援は？
	}
	talk 大佐 標準 -m {
		[P030_01_R01_フォーチュン戦中無線無線デモ１＿カウント後__e:大佐_003]
		//ダメだ。
		//今からでは時間がない。
	}
	talk ライデン 標準 -m {
		[P030_01_R01_フォーチュン戦中無線無線デモ１＿カウント後__e:ライデン_004]
		//爆弾はどっちのタイプだ？
	}
	talk 大佐 標準 -m {
		[P030_01_R01_フォーチュン戦中無線無線デモ１＿カウント後__e:大佐_005]
		//そこまでのヒントはもらえなかった。
	}
}//v
}//d




//resource P035_01_R01_ファットマン爆弾解体終了１無線デモ１＿１ 
proc vc113501:01  {
vox t:vc113501 {
	talk 大佐 標準 -m {
