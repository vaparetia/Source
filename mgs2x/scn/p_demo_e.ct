/*
	talk ライデン 標準 -m {
		[P019_01_R01_爆弾解体中ローズその３無線デモ１＿１__e:ライデン_008]
		//叔母さんはモノクロのキングコングの
		//方を観ていたんだ。
	}
*/
	talk ローズ 標準 -m {
		[P019_01_R01_爆弾解体中ローズその３無線デモ１＿１__e:ローズ_009]
		//私はおそらく、クライスラービルだと
		//言った。
	}
/*
	talk ライデン 標準 -m {
		[P019_01_R01_爆弾解体中ローズその３無線デモ１＿１__e:ライデン_010]
		//そう、君はモノクロ版を観ていなかった。
	}
*/
@rp_うなづきデフォルト＿否
@rp_セクハラ＿是＿やりたがり系デフォルト 100

	talk ローズ 標準 -m {
		[P019_01_R01_爆弾解体中ローズその３無線デモ１＿１__e:ローズ_011]
		//ええ、うろ憶えだった。
		//そこへあなたが現れて割り込んできた。
	}
	talk ローズ 標準 -m {
		[P019_01_R01_爆弾解体中ローズその３無線デモ１＿１__e:ローズ_012]
		//違う。エンパイアステートビルだ。
	}
	talk ライデン 標準 -m {
		[P019_01_R01_爆弾解体中ローズその３無線デモ１＿１__e:ライデン_013]
		//クライスラービルが壊れたのはゴジラだ。
		//といった。
	}
// ↓海外版では不要（英語では字幕を付けにくい笑い方）
	talk ローズ 標準 -m {
		[P019_01_R01_爆弾解体中ローズその３無線デモ１＿１__e:ローズ_014]
		//ふふ……。
	}

@rp_セクハラ＿否１＿ワガママ系デフォルト 100
@rp_セクハラ＿是１＿かわいい系デフォルト 100

	talk ローズ 標準 -m {
		[P019_01_R01_爆弾解体中ローズその３無線デモ１＿１__e:ローズ_015]
		//私たちは叔母さん達、そっちのけで
		//討論を始めた。
	}
	talk ローズ 標準 -m {
		[P019_01_R01_爆弾解体中ローズその３無線デモ１＿１__e:ローズ_016]
		//自分こそが正しいと主張して……。
	}
	talk ライデン 標準 -m {
		[P019_01_R01_爆弾解体中ローズその３無線デモ１＿１__e:ライデン_017]
		//気が付くと、観光客はいなくなっていた。
	}
	talk ローズ 標準 -m {
		[P019_01_R01_爆弾解体中ローズその３無線デモ１＿１__e:ローズ_018]
		//そこで、お互いの言い分を
		//立証するために、摩天楼博物館に
		//向かう事になった。
	}
	talk ライデン 標準 -m {
		[P019_01_R01_爆弾解体中ローズその３無線デモ１＿１__e:ライデン_019]
		//そうだ。バッテリーパークまで口論を
		//続けながら歩いた。
	}

@rp_うなづきデフォルト＿否
@rp_セクハラ＿是＿やりたがり系デフォルト 100

	talk ローズ 標準 -m {
		[P019_01_R01_爆弾解体中ローズその３無線デモ１＿１__e:ローズ_020]
		//でも、結論はでなかった。
	}
	talk ライデン 標準 -m {
		[P019_01_R01_爆弾解体中ローズその３無線デモ１＿１__e:ライデン_021]
		//博物館は休館だったんだ。
	}
	talk ライデン 標準 -m {
		[P019_01_R01_爆弾解体中ローズその３無線デモ１＿１__e:ライデン_022]
		//博物館の前で俺達は別れた。
	}
	talk ライデン 標準 -m {
		[P019_01_R01_爆弾解体中ローズその３無線デモ１＿１__e:ライデン_023]
		//１週間後、偶然君を基地の廊下で
		//見つけた。
	}
@rp_うなづきデフォルト＿否
@rp_セクハラ＿是１＿かわいい系デフォルト 80

	talk ローズ 標準 -m {
		[P019_01_R01_爆弾解体中ローズその３無線デモ１＿１__e:ローズ_024]
		//ええ、偶然だった。
		//同じところで働いたなんてね。
	}
	talk ライデン 標準 -m {
		[P019_01_R01_爆弾解体中ローズその３無線デモ１＿１__e:ライデン_025]
		//俺達はその夜、
		//エンパイアステートビルの屋上へ行った。
	}
	talk ローズ 標準 -m {
		[P019_01_R01_爆弾解体中ローズその３無線デモ１＿１__e:ローズ_026]
		//綺麗だった。地上１２０階から観る
		//クライスラービル……。	
	}
	talk ローズ 標準 -m {
		[P019_01_R01_爆弾解体中ローズその３無線デモ１＿１__e:ローズ_026_1]
		//綺麗だった。地上１２０階から観る
		//クライスラービル……。	
	}
	talk ライデン 標準 -m {
		[P019_01_R01_爆弾解体中ローズその３無線デモ１＿１__e:ライデン_027]
		//圧倒された……。
	}

@rp_セクハラ＿是＿やりたがり系デフォルト 80
@rp_うなづきデフォルト＿否

	talk ライデン 標準 -m {
		[P019_01_R01_爆弾解体中ローズその３無線デモ１＿１__e:ライデン_028]
		//どちらが正しいなんて、もうどうでも
		//良くなってた。
	}
	talk ローズ 標準 -m {
		[P019_01_R01_爆弾解体中ローズその３無線デモ１＿１__e:ローズ_029]
		//あれが私たちの最初のデート。
	}
	talk ライデン 標準 -m {
		[P019_01_R01_爆弾解体中ローズその３無線デモ１＿１__e:ライデン_030]
		//その晩、君の部屋でキングコングの
		//ビデオを何度も見た。
	}
	talk ライデン 標準 -m {
		[P019_01_R01_爆弾解体中ローズその３無線デモ１＿１__e:ライデン_031]
		//朝まで……。
	}

@rp_うなづきデフォルト＿否
@rp_セクハラ＿是＿やりたがり系デフォルト 100

	talk ローズ 標準 -m {
		[P019_01_R01_爆弾解体中ローズその３無線デモ１＿１__e:ローズ_032]
		//……。
	}
	talk ライデン 標準 -m {
		[P019_01_R01_爆弾解体中ローズその３無線デモ１＿１__e:ライデン_033]
		//あの偶然がなければ俺達は出会って
		//いなかった。
	}
	talk ローズ 標準 -m {
		[P019_01_R01_爆弾解体中ローズその３無線デモ１＿１__e:ローズ_034]
		//そうね……。
	}
	talk ローズ 標準 -m {
		[P019_01_R01_爆弾解体中ローズその３無線デモ１＿１__e:ローズ_035]
		//ジャック、ごめんなさい。
		//時間を無駄にしたわね。
	}
	talk ライデン 標準 -m {
		[P019_01_R01_爆弾解体中ローズその３無線デモ１＿１__e:ライデン_036]
		//え？
	}
	talk ローズ 標準 -m {
		[P019_01_R01_爆弾解体中ローズその３無線デモ１＿１__e:ローズ_037]
		//それじゃ、がんばって。
	}
	command セットサウンドコード -c  d:SNG_FIN_S

}//v
}//d



//resource P020_01_R01_地雷原１無線デモ１＿１ 
proc vc112001:01  {
vox t:vc112001 {
	talk オルガ 標準 -m {
		[P020_01_R01_地雷原１無線デモ１＿１__e:オルガ_000]
		//気をつけろ！！
	}
// ↓海外版では不要
/*
	talk オルガ 標準 -m {
		[P020_01_R01_地雷原１無線デモ１＿１__e:オルガ_001]
		//そこにはクレイモア地雷が
		//セットされている。
	}
*/
	talk ライデン 標準 -m {
		[P020_01_R01_地雷原１無線デモ１＿１__e:ライデン_002]
		//なんだっ！
	}
}//v
}//d


//無線機のスクリーンにＥＦ連絡橋の映像が映る
//resource P020_01_R01_地雷原１無線デモ１＿２ 
proc vc112002:01  {
vox t:vc112002 {

@rp_うなづきデフォルト

	talk オルガ 標準 -m {
		[P020_01_R01_地雷原１無線デモ１＿２__e:オルガ_000]
		//ステルス装備のクレイモアだ。
		//肉眼では見えない。
	}
	talk オルガ 標準 -m {
		[P020_01_R01_地雷原１無線デモ１＿２__e:オルガ_001]
		//地雷探知機を使え！
	}
	talk ライデン 標準 -m {
		[P020_01_R01_地雷原１無線デモ１＿２__e:ライデン_002]
		//誰だ、おまえは？
	}
	talk オルガ 標準 -m {
		[P020_01_R01_地雷原１無線デモ１＿２__e:オルガ_003]
		//ディープ・スロートとでも言っておこう。
	}
	talk ライデン 標準 -m {
		[P020_01_R01_地雷原１無線デモ１＿２__e:ライデン_004]
		//ディープ・スロート？
		//シャドー・モセス事件の？
	}	

@rp_かみあわない＿否１＿話聞けよ系デフォルト 100
@rp_うなづきデフォルト＿是

	talk オルガ 標準 -m {
		[P020_01_R01_地雷原１無線デモ１＿２__e:オルガ_005]
		//いや、ミスターＸとでも言っておこう。
	}
	talk ライデン 標準 -m {
		[P020_01_R01_地雷原１無線デモ１＿２__e:ライデン_006]
		//ミスターＸ？
		//どうした？
		//なぜ言い直す？
	}
	talk オルガ 標準 -m {
		[P020_01_R01_地雷原１無線デモ１＿２__e:オルガ_007]
		//そんな事はどうでもいい。	
	}

@rp_うなづきデフォルト＿是

	talk ライデン 標準 -m {
		[P020_01_R01_地雷原１無線デモ１＿２__e:ライデン_008]
		//何者だ、なぜ俺に忠告を？
	}
	talk オルガ 標準 -m {
		[P020_01_R01_地雷原１無線デモ１＿２__e:オルガ_009]
		//ファンの一人だよ。
	}
}//v
}//d

//激ヤバＸＸＸＸＸＸＸＸＸＸＸＸ
//resource P020_01_R01_地雷原１無線デモ１＿３ 
proc vc112003:01  {
vox t:vc112003 {
	talk ライデン 標準 -m {
		[P020_01_R01_地雷原１無線デモ１＿３__e:ライデン_000]
		//大佐、ミスターＸという人物から
		//無線連絡が入った。何者だ？
	}
	talk 大佐 標準 -m {
		[P020_01_R01_地雷原１無線デモ１＿３__e:大佐_001]
		//わからない。バースト通信では
		//なかったようだ。『ビッグ・シェル』		//
		//内部から発信されている。
	}
	talk 大佐 標準 -m {
		[P020_01_R01_地雷原１無線デモ１＿３__e:大佐_001_1]
		//わからない。バースト通信では
		//なかったようだ。『ビッグ・シェル』		//
		//内部から発信されている。
	}
	talk ライデン 標準 -m {
		[P020_01_R01_地雷原１無線デモ１＿３__e:ライデン_002]
		//やつは最初、ディープ・スロートと
		//名乗った。まさか……？
	}

@rp_うなづきデフォルト

	talk 大佐 標準 -m {
		[P020_01_R01_地雷原１無線デモ１＿３__e:大佐_003]
		//ああ、私も聞いた。
		//しかし、それはありえん事だ。
	}
	talk 大佐 標準 -m {
		[P020_01_R01_地雷原１無線デモ１＿３__e:大佐_004]
		//シャドーモセス事件でその名を語った
		//グレイ・フォックスは既に死んでいる。
	}
	talk ライデン 標準 -m {
		[P020_01_R01_地雷原１無線デモ１＿３__e:ライデン_005]
		//敵だと思うか？
	}

@rp_うなづきデフォルト

	talk 大佐 標準 -m {
		[P020_01_R01_地雷原１無線デモ１＿３__e:大佐_006]
		//わからん……注意しろ。
	}
}//v
}//d



//resource P021_02_R01_爆弾解体オルガ登場２無線デモ１＿１
proc vc112101:01  {
vox t:vc112101 {
	talk ライデン 標準 -m {
		[P021_02_R01_爆弾解体オルガ登場２無線デモ１＿１__e:ライデン_000]
		//ロシア人の女兵士を見かけた。
	}
	talk プリスキン 標準 -m {
		[P021_02_R01_爆弾解体オルガ登場２無線デモ１＿１__e:プリスキン_001]
		//ああ、
		//彼女はオルガ・ゴルルコビッチ……。
	}
	talk ライデン 標準 -m {
		[P021_02_R01_爆弾解体オルガ登場２無線デモ１＿１__e:ライデン_002]
		//何故、知ってる？
	}

@rp_うなづきデフォルト

	talk プリスキン 標準 -m {
		[P021_02_R01_爆弾解体オルガ登場２無線デモ１＿１__e:プリスキン_003]
		//お前と違って、ブリーフィングを
		//受けたからな。
	}

@rp_うんちく＿否３＿わかってんのか系デフォルト 100
@rp_うんちく＿是１＿詳しいな系デフォルト 100

	talk ライデン 標準 -m {
		[P021_02_R01_爆弾解体オルガ登場２無線デモ１＿１__e:ライデン_004]
		//デッドセルではないのか？
	}
	talk プリスキン 標準 -m {
		[P021_02_R01_爆弾解体オルガ登場２無線デモ１＿１__e:プリスキン_005]
		//ロシア私兵部隊のリーダーだ。
	}
	talk ライデン 標準 -m {
		[P021_02_R01_爆弾解体オルガ登場２無線デモ１＿１__e:ライデン_006]
		//『ビッグ・シェル』内を巡回している
		//奴等だな。
	}
	talk プリスキン 標準 -m {
		[P021_02_R01_爆弾解体オルガ登場２無線デモ１＿１__e:プリスキン_007]
		//ああ。親父のゴルルコビッチ大佐が
		//死んで以来、彼女が部隊を統率している。
	}
	talk プリスキン 標準 -m {
		[P021_02_R01_爆弾解体オルガ登場２無線デモ１＿１__e:プリスキン_008]
		//あの女には注意するんだ。
		//かなりできるぞ。
	}
}//v
}//d



//resource P022_01_R01_爆弾解体最後から二つ目１無線デモ１＿１ 
proc vc112201:01  {
vox  t:vc112201 {
	talk ピーター 標準 -m {
		[P022_01_R01_爆弾解体最後から二つ目１無線デモ１＿１__e:ピーター_000]
		//よくやった。残りは後、一つ……。
	}
}//v
}//d

//resource P022_01_R01_爆弾解体最後から二つ目１無線デモ１＿２ 
proc vc112202:01  {
vox t:vc112202 {
	talk プリスキン 標準 -m {
		[P022_01_R01_爆弾解体最後から二つ目１無線デモ１＿２__e:プリスキン_001]
		//こちらプリスキン、親父さん、
		//聞こえるか？
	}
	@rpd_ピーター顔表示
	talk ピーター 標準 -m {
		[P022_01_R01_爆弾解体最後から二つ目１無線デモ１＿２__e:ピーター_002]
		//こちら、スティルマン。
		//どうした？
	}

@rp_うなづきデフォルト
	@rpd_プリスキン顔表示
	talk プリスキン 標準 -m {
		[P022_01_R01_爆弾解体最後から二つ目１無線デモ１＿２__e:プリスキン_003]
		//ライデンも聞いてくれ。
	}
	talk ライデン 標準 -m {
		[P022_01_R01_爆弾解体最後から二つ目１無線デモ１＿２__e:ライデン_004]
		//聞いてる。
	}
	talk プリスキン 標準 -m {
		[P022_01_R01_爆弾解体最後から二つ目１無線デモ１＿２__e:プリスキン_005]
		//親父さんに言われて、
		//Ｈ脚の脚底部を調べてみた。
	}
	talk ライデン 標準 -m {
		[P022_01_R01_爆弾解体最後から二つ目１無線デモ１＿２__e:ライデン_006]
		//何を？
	}
	@rpd_ピーター顔表示
	talk ピーター 標準 -m {
		[P022_01_R01_爆弾解体最後から二つ目１無線デモ１＿２__e:ピーター_007]
		//私がプリスキンに頼んだのだ。
		//爆薬をセットする位置の選択が、
		//ファットマンらしくない……。
	}
	talk ピーター 標準 -m {
		[P022_01_R01_爆弾解体最後から二つ目１無線デモ１＿２__e:ピーター_007_1]
		//私がプリスキンに頼んだのだ。
		//爆薬をセットする位置の選択が、
		//ファットマンらしくない……。
	}

@rp_うなづきデフォルト

	talk ライデン 標準 -m {
		[P022_01_R01_爆弾解体最後から二つ目１無線デモ１＿２__e:ライデン_008]
		//それで？
	}
	@rpd_プリスキン顔表示
	talk プリスキン 標準 -m {
		[P022_01_R01_爆弾解体最後から二つ目１無線デモ１＿２__e:プリスキン_009]
		//あんたの言う通り、脚底部にＣ４が
		//大量にセットされていた。
	}
	@rpd_ピーター顔表示
	talk ピーター 標準 -m {
