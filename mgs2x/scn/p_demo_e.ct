	}
@rp_かみあわない＿否１＿話聞けよ系デフォルト 100
	talk エマ 標準 -m {
		[P062_03_R01_エマとＡＩ３無線機デモ１＿１__e:エマ_048]
		//……。
	}
	talk ライデン 標準 -m {
		[P062_03_R01_エマとＡＩ３無線機デモ１＿１__e:ライデン_049]
		//……まぁ、きっと事情があるんだろうな。
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk エマ 標準 -m {
		[P062_03_R01_エマとＡＩ３無線機デモ１＿１__e:エマ_050]
		//うん……。
	}
	talk ライデン 標準 -m {
		[P062_03_R01_エマとＡＩ３無線機デモ１＿１__e:ライデン_051]
		//わかるよ。
	}
	talk エマ 標準 -m {
		[P062_03_R01_エマとＡＩ３無線機デモ１＿１__e:エマ_052]
		//……そう……？
	}
	talk ライデン 標準 -m {
		[P062_03_R01_エマとＡＩ３無線機デモ１＿１__e:ライデン_053]
		//ではアーセナルギアは『Ｇ．Ｗ』を
		//守るために建造された？
	}
@rp_うなづきデフォルト＿否
	talk エマ 標準 -m {
		[P062_03_R01_エマとＡＩ３無線機デモ１＿１__e:エマ_054]
		//……ええ。核兵器を含めた最高の武装を持ち、サイバーテロ対策も完璧。
		//物理的にも論理的にも史上最強の要塞。
	}
	talk エマ 標準 -m {
		[P062_03_R01_エマとＡＩ３無線機デモ１＿１__e:エマ_054_1]
		//……ええ。核兵器を含めた最高の武装を持ち、サイバーテロ対策も完璧。
		//物理的にも論理的にも史上最強の要塞。
	}
	talk エマ 標準 -m {
		[P062_03_R01_エマとＡＩ３無線機デモ１＿１__e:エマ_056]
		//『Ｇ．Ｗ』のうつわ器。
	}
	talk ライデン 標準 -m {
		[P062_03_R01_エマとＡＩ３無線機デモ１＿１__e:ライデン_057]
		//だが、そのＡＩだけで全てを制御出来る
		//とは思えないが。
	}
	talk エマ 標準 -m {
		[P062_03_R01_エマとＡＩ３無線機デモ１＿１__e:エマ_058]
		//ええ。『Ｇ．Ｗ』はあくまでも
		//システムの中枢。何を残すか、
		//何を削除するかを判断するためのね。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk エマ 標準 -m {
		[P062_03_R01_エマとＡＩ３無線機デモ１＿１__e:エマ_059]
		//それを実行するサブシステムは
		//既に社会に埋め込まれている……。
	}
	talk ライデン 標準 -m {
		[P062_03_R01_エマとＡＩ３無線機デモ１＿１__e:ライデン_060]
		//どういうことだ？
	}
}//v
}//d


//resource P062_05_R02_エマとＡＩ５無線機デモ２＿１ 
proc vc116211:01  {
vox t:vc116211 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk ライデン 標準 -m {
		[P062_05_R02_エマとＡＩ５無線機デモ２＿１__e:ライデン_000]
		//その中に『愛国者達』のプログラムが
		//仕込まれていたと？
	}
	talk エマ 標準 -m {
		[P062_05_R02_エマとＡＩ５無線機デモ２＿１__e:エマ_001]
		//ええ。
		//勿論、それ以降に作られたものには
		//初めからそのシステムが組み込んである。
	}	
	talk ライデン 標準 -m {
		[P062_05_R02_エマとＡＩ５無線機デモ２＿１__e:ライデン_002]
		//そんな馬鹿な……。
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk エマ 標準 -m {
		[P062_05_R02_エマとＡＩ５無線機デモ２＿１__e:エマ_003]
		//どうしてそう言えるの？コンピュータが
		//どうやって動作しているのか、あなたは
		//知ってるの？
	}
	talk エマ 標準 -m {
		[P062_05_R02_エマとＡＩ５無線機デモ２＿１__e:エマ_004]
		//この通信がどういう原理なのかだって
		//本当は分かってないでしょ？
	}
	talk ライデン 標準 -m {
		[P062_05_R02_エマとＡＩ５無線機デモ２＿１__e:ライデン_005]
		//……。
	}
	talk エマ 標準 -m {
		[P062_05_R02_エマとＡＩ５無線機デモ２＿１__e:エマ_006]
		//誰も知らないけど、そのシステムは
		//実在する。そしてそれらはもうすぐ
		//一斉に動き出す……。
	}
	talk ライデン 標準 -m {
		[P062_05_R02_エマとＡＩ５無線機デモ２＿１__e:ライデン_007]
		//ソリダスが核爆発でマンハッタン全ての
		//電子回路を焼き切ろうとしているのは
		//そのため……？
	}
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk エマ 標準 -m {
		[P062_05_R02_エマとＡＩ５無線機デモ２＿１__e:エマ_008]
		//そうかもね。
		//でもシステムはまだ完成してるわけ
		//じゃない。
	}
	talk ライデン 標準 -m {
		[P062_05_R02_エマとＡＩ５無線機デモ２＿１__e:ライデン_009]
		//え？。	
	}
	talk エマ 標準 -m {
		[P062_05_R02_エマとＡＩ５無線機デモ２＿１__e:エマ_010]
		//状況を判断するための＃｛因子、ファクター｝＃が
		//不足してるの。
	}
	talk エマ 標準 -m {
		[P062_05_R02_エマとＡＩ５無線機デモ２＿１__e:エマ_011]
		//その複雑さを『Ｇ．Ｗ』に学習させる
		//ために大規模な実験を近日中に
		//行うって話は聞いていたんだけど……。
	}
	talk エマ 標準 -m {
		[P062_05_R02_エマとＡＩ５無線機デモ２＿１__e:エマ_011_1]
		//その複雑さを『Ｇ．Ｗ』に学習させる
		//ために大規模な実験を近日中に
		//行うって話は聞いていたんだけど……。
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk エマ 標準 -m {
		[P062_05_R02_エマとＡＩ５無線機デモ２＿１__e:エマ_012]
		//突然、こんなことが起こって……。	
	}
	talk ライデン 標準 -m {
		[P062_05_R02_エマとＡＩ５無線機デモ２＿１__e:ライデン_013]
		//……エマ、これはテロだ。
		//君が悪いんじゃない……。
	}
	talk エマ 標準 -m {
		[P062_05_R02_エマとＡＩ５無線機デモ２＿１__e:エマ_014]
		//……うん……そうね……。
	}
@rp_うなづきデフォルト＿否
	talk エマ 標準 -m {
		[P062_05_R02_エマとＡＩ５無線機デモ２＿１__e:エマ_015]
		//うん。
		//……とりあえず私が知ってるのは
		//これくらい、かな。
	}
	talk ライデン 標準 -m {
		[P062_05_R02_エマとＡＩ５無線機デモ２＿１__e:ライデン_016]
		//そうか……ありがとう。
		//じゃあ電算室へ急ごうか？
	}
	talk エマ 標準 -m {
		[P062_05_R02_エマとＡＩ５無線機デモ２＿１__e:エマ_017]
		//鳥は無事？電算室にいた？
	}
}//v
}//d





//resource P064_01_R01_エマライデンローズ無線１無線機デモ１＿１ 
proc vc116401:01  {
vox t:vc116401 {
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		[P064_01_R01_エマライデンローズ無線１無線機デモ１＿１__e:ローズ_000]
		//ジャック、エマさんと仲がいいようね。
	}
	talk ライデン 標準 -m {
		[P064_01_R01_エマライデンローズ無線１無線機デモ１＿１__e:ライデン_001]
		//ローズ、何を言っている？
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_セクハラ＿否２＿うっとおしい系デフォルト 100
	talk ローズ 標準 -m {
		[P064_01_R01_エマライデンローズ無線１無線機デモ１＿１__e:ローズ_002]
		//私、あなたの行動や会話を全部モニター
		//してるのよ。あまりいい気はしないわ。
	}
	talk ライデン 標準 -m {
		[P064_01_R01_エマライデンローズ無線１無線機デモ１＿１__e:ライデン_003]
		//誤解するな。俺はエマを勇気づけてる
		//だけだ。
	}
	talk ローズ 標準 -m {
		[P064_01_R01_エマライデンローズ無線１無線機デモ１＿１__e:ローズ_004]
		//そうなの、ジャック？
	}
	talk ライデン 標準 -m {
		[P064_01_R01_エマライデンローズ無線１無線機デモ１＿１__e:ライデン_005]
		//ああ、彼女を電算室まで連れて行くのが
		//任務だ。
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
	talk ローズ 標準 -m {
		[P064_01_R01_エマライデンローズ無線１無線機デモ１＿１__e:ローズ_006]
		//それだけ？	
	}
	talk ライデン 標準 -m {
		[P064_01_R01_エマライデンローズ無線１無線機デモ１＿１__e:ライデン_007]
		//……ああ。
	}
	talk ローズ 標準 -m {
		[P064_01_R01_エマライデンローズ無線１無線機デモ１＿１__e:ローズ_008]
		//嘘っ、ちょっとはいいと思ってる？
	}
	talk ライデン 標準 -m {
		[P064_01_R01_エマライデンローズ無線１無線機デモ１＿１__e:ライデン_009]
		//ああ、エマはかわいい娘だ。
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
	talk ローズ 標準 -m {
		[P064_01_R01_エマライデンローズ無線１無線機デモ１＿１__e:ローズ_010]
		//私より？
	}
	talk ライデン 標準 -m {
		[P064_01_R01_エマライデンローズ無線１無線機デモ１＿１__e:ライデン_011]
		//ローズ、君は素敵だ。
		//俺の気持ちに代わりはない。	
	}	
	talk ローズ 標準 -m {
		[P064_01_R01_エマライデンローズ無線１無線機デモ１＿１__e:ローズ_012]
		//じゃあ、思い出した？
	}
	talk ライデン 標準 -m {
		[P064_01_R01_エマライデンローズ無線１無線機デモ１＿１__e:ライデン_013]
		//４月３０日のこと？
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
	talk ローズ 標準 -m {
		[P064_01_R01_エマライデンローズ無線１無線機デモ１＿１__e:ローズ_014]
		//そう。
	}
	talk ライデン 標準 -m {
		[P064_01_R01_エマライデンローズ無線１無線機デモ１＿１__e:ライデン_015]
		//君の誕生日？
	}
	talk ローズ 標準 -m {
		[P064_01_R01_エマライデンローズ無線１無線機デモ１＿１__e:ローズ_016]
		//ブブー！
		//外れ！		//
		//大外れ！
	}
	talk ライデン 標準 -m {
		[P064_01_R01_エマライデンローズ無線１無線機デモ１＿１__e:ライデン_017]
		//意地悪だな。
	}
	talk ローズ 標準 -m {
		[P064_01_R01_エマライデンローズ無線１無線機デモ１＿１__e:ローズ_018]
		//……ごめんなさい。ちょっとした冗談、
		//なんだか、いいムードだったから……
		//ちょっとやけちゃったかな……。	
	}
	talk ライデン 標準 -m {
		[P064_01_R01_エマライデンローズ無線１無線機デモ１＿１__e:ライデン_019]
		//ローズ？
	}
	talk ローズ 標準 -m {
		[P064_01_R01_エマライデンローズ無線１無線機デモ１＿１__e:ローズ_020]
		//じゃあね、がんばって。
	}
}//v
}//d




//resource P065_02_R01_エマＬ脚２無線機デモ１＿１ 
proc vc116501:01  {
vox t:vc116501 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ライデン 標準 -m {
		[P065_02_R01_エマＬ脚２無線機デモ１＿１__e:ライデン_000]
		//……聞いていいか？
	}
	talk エマ 標準 -m {
		[P065_02_R01_エマＬ脚２無線機デモ１＿１__e:エマ_001]
		//なに？
	}
	talk ライデン 標準 -m {
		[P065_02_R01_エマＬ脚２無線機デモ１＿１__e:ライデン_002]
		//高いところは苦手か？
	}
@rp_セクハラ＿否１＿ワガママ系デフォルト 100
	talk エマ 標準 -m {
		[P065_02_R01_エマＬ脚２無線機デモ１＿１__e:エマ_003]
		//嫌い。
		//水の中よりはマシだけど……
		//どうしてそんなこと聞くの？
	}
	talk ライデン 標準 -m {
		[P065_02_R01_エマＬ脚２無線機デモ１＿１__e:ライデン_004]
		//これからハシゴで下に降りる。
	}
@rp_うなづきデフォルト＿否
	talk エマ 標準 -m {
		[P065_02_R01_エマＬ脚２無線機デモ１＿１__e:エマ_005]
		//どれくらい？
	}
	talk ライデン 標準 -m {
		[P065_02_R01_エマＬ脚２無線機デモ１＿１__e:ライデン_006]
		//ほんの少しだ。
	}
	talk エマ 標準 -m {
		[P065_02_R01_エマＬ脚２無線機デモ１＿１__e:エマ_007]
		//さっきも『ほんの少し』って聞いたけど？
	}
	talk ライデン 標準 -m {
		[P065_02_R01_エマＬ脚２無線機デモ１＿１__e:ライデン_008]
		//……４０メートル……くらいかな。
	}
	talk エマ 標準 -m {
		[P065_02_R01_エマＬ脚２無線機デモ１＿１__e:エマ_009]
		//……。
	}
	talk ライデン 標準 -m {
		[P065_02_R01_エマＬ脚２無線機デモ１＿１__e:ライデン_010]
		//いけるか？
	}
@rp_うなづきデフォルト＿否
	talk エマ 標準 -m {
		[P065_02_R01_エマＬ脚２無線機デモ１＿１__e:エマ_011]
		//ダメって言っても連れてくんでしょ。
	}
	talk ライデン 標準 -m {
		[P065_02_R01_エマＬ脚２無線機デモ１＿１__e:ライデン_012]
		//足の具合は？
	}
	talk エマ 標準 -m {
		[P065_02_R01_エマＬ脚２無線機デモ１＿１__e:エマ_013]
		//大丈夫。だいぶシビレがとれてきた。
	}
@rp_うなづきデフォルト＿否
	talk エマ 標準 -m {
		[P065_02_R01_エマＬ脚２無線機デモ１＿１__e:エマ_014]
		//一人で歩けるわ。
	}
	talk ライデン 標準 -m {
		[P065_02_R01_エマＬ脚２無線機デモ１＿１__e:ライデン_015]
		//よし、俺の後についてくるんだ。
	}
}//v
}//d




//resource P065_06_R02_Ｌ脚エマ６無線機デモ２＿１ 
proc vc116511:01  {
vox t:vc116511 {
	talk ライデン 標準 -m {
		[P065_06_R02_Ｌ脚エマ６無線機デモ２＿１__e:ライデン_000]
		//こちらライデン、聞こえるか？
	}
	talk プリスキン 標準 -m {
		[P065_06_R02_Ｌ脚エマ６無線機デモ２＿１__e:プリスキン_001]
		//ああ、どうした？
	}
	talk ライデン 標準 -m {
		[P065_06_R02_Ｌ脚エマ６無線機デモ２＿１__e:ライデン_002]
		//Ｌ脚下部に到着した。
		//今から海面を渡るところだ。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		[P065_06_R02_Ｌ脚エマ６無線機デモ２＿１__e:プリスキン_003]
		//エマは歩けそうか？
	}
	talk ライデン 標準 -m {
		[P065_06_R02_Ｌ脚エマ６無線機デモ２＿１__e:ライデン_004]
		//彼女なら大丈夫だが。
		//浮き橋はかなり脆そうだ。
		//エマひとりしか渡れそうもない。
	}
	talk プリスキン 標準 -m {
		[P065_06_R02_Ｌ脚エマ６無線機デモ２＿１__e:プリスキン_005]
		//オイルフェンスだからな。
	}
}//v
}//d

//小画面に双眼鏡モードの映像がでる。浮き橋をパンすると、敵兵、サイファーが見える
//resource P065_06_R02_Ｌ脚エマ６無線機デモ２＿２ 
proc vc116512:01  {
vox t:vc116512 {
	talk ライデン 標準 -m {
		[P065_06_R02_Ｌ脚エマ６無線機デモ２＿２__e:ライデン_000]
		//サイファーと見張りが数人いる。
	}
	talk プリスキン 標準 -m {
		[P065_06_R02_Ｌ脚エマ６無線機デモ２＿２__e:プリスキン_001]
		//ライデン、ＰＳＧ１を持ってるだろう？
