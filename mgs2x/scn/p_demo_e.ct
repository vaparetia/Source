//resource P014_05_R01_ピーター遭遇５無線デモ１＿１ 
proc vc111401:01  {
vox t:vc111401 {
	talk 大佐 標準 -m {
		[P014_05_R01_ピーター遭遇５無線デモ１＿１__e:大佐_000]
		//ライデン、スティルマンが
		//無事だったのは何よりだ。
	}

@rp_うなづきデフォルト＿是
@rp_無茶指令＿否１＿お前がやれ系デフォルト 100

	talk 大佐 標準 -m {
		[P014_05_R01_ピーター遭遇５無線デモ１＿１__e:大佐_001]
		//彼と協力して『ビッグ・シェル』内の
		//Ｃ４を解除してくれ。
	}
	talk ライデン 標準 -m {
		[P014_05_R01_ピーター遭遇５無線デモ１＿１__e:ライデン_002]
		//大佐、俺は爆弾解体の訓練なんて、
		//受けたことがない。
	}
	talk 大佐 標準 -m {
		[P014_05_R01_ピーター遭遇５無線デモ１＿１__e:大佐_003]
		//大丈夫だ。そこにいる男は爆弾処理の
		//専門家だ。超一流のな。彼の指示に
		//従ってくれ。
	}
	talk 大佐 標準 -m {
		[P014_05_R01_ピーター遭遇５無線デモ１＿１__e:大佐_003_1]
		//大丈夫だ。そこにいる男は爆弾処理の
		//専門家だ。超一流のな。彼の指示に
		//従ってくれ。
	}

@rp_うなづきデフォルト＿是

	talk 大佐 標準 -m {
		[P014_05_R01_ピーター遭遇５無線デモ１＿１__e:大佐_004]
		//ただし、ライデン。こちら側の素性や
		//ミッションについてはいっさい話すな。
	}
	talk ライデン 標準 -m {
		[P014_05_R01_ピーター遭遇５無線デモ１＿１__e:ライデン_005]
		//スティルマンと一緒に技術者が降下した
		//という話は本当なのか？
	}
	talk 大佐 標準 -m {
		[P014_05_R01_ピーター遭遇５無線デモ１＿１__e:大佐_006]
		//いや、我々も聞いていない。
		//ＳＥＡＬ１０の独自行動だろう。
	}
	talk ライデン 標準 -m {
		[P014_05_R01_ピーター遭遇５無線デモ１＿１__e:ライデン_006]
		//……。
	}

@rp_うなづきデフォルト＿是

	talk 大佐 標準 -m {
		[P014_05_R01_ピーター遭遇５無線デモ１＿１__e:大佐_007]
		//そんなことより、先ほどの突入に対する、
		//報復が考えられる。爆弾の除去を急いで
		//くれ。
	}
	talk 大佐 標準 -m {
		[P014_05_R01_ピーター遭遇５無線デモ１＿１__e:大佐_007_1]
		//そんなことより、先ほどの突入に対する、
		//報復が考えられる。爆弾の除去を急いで
		//くれ。
	}
	talk ライデン 標準 -m {
