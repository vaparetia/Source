	talk プリスキン 標準 -m {
		[P050_06_R03_タンカー編整理６無線機デモ３＿１__e:プリスキン_001]
		//核が使えなくとも、アーセナルには
		//莫大な量のミサイル兵器がある。
	}
	talk プリスキン 標準 -m {
		[P050_06_R03_タンカー編整理６無線機デモ３＿１__e:プリスキン_001_1]
		//核が使えなくとも、アーセナルには
		//莫大な量のミサイル兵器がある。
	}
	@rpd_オタコン顔表示
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		[P050_06_R03_タンカー編整理６無線機デモ３＿１__e:オタコン_002]
		//そうだね。
		//奴等がそれを手に入れたら……。
	}
	@rpd_プリスキン顔表示
	talk プリスキン 標準 -m {
		[P050_06_R03_タンカー編整理６無線機デモ３＿１__e:プリスキン_003]
		//ライデン、エマのところに急いでくれ。
	}
	talk ライデン 標準 -m {
