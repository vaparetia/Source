}//d



//resource P006_01_R01_Ａ脚金網１無線デモ１ 
proc vc110601:01  {
vox t:vc110601 {
	talk 大佐 標準 -m {
		[P006_01_R01_Ａ脚金網１無線デモ１__e:大佐_000]
		//ライデン、ＳＥＡＬ・チーム１０が
		//突入を開始した。
	}
	talk ライデン 標準 -m {
		[P006_01_R01_Ａ脚金網１無線デモ１__e:ライデン_001]
		//ＦＯＸＨＯＵＮＤとＳＥＡＬの
		//コンセサンスは本当にないのか？
	}
	talk 大佐 標準 -m {
		[P006_01_R01_Ａ脚金網１無線デモ１__e:大佐_002]
		//先方は我々の事を何も知らない。
		//我々は隠密組織だ。任務も機密事項。
		//君の潜入を知る者は極少数だ。
	}
	talk 大佐 標準 -m {
		[P006_01_R01_Ａ脚金網１無線デモ１__e:大佐_002_1]
		//先方は我々の事を何も知らない。
		//我々は隠密組織だ。任務も機密事項。
		//君の潜入を知る者は極少数だ。
	}

@rp_うなづきデフォルト＿是
@rp_うんちく＿否３＿わかってんのか系デフォルト 80

	talk ライデン 標準 -m {
		[P006_01_R01_Ａ脚金網１無線デモ１__e:ライデン_003]
		//……。
	}
	talk 大佐 標準 -m {
		[P006_01_R01_Ａ脚金網１無線デモ１__e:大佐_004]
		//今回の作戦は＃｛国防総省、ペンタゴン｝＃が直接指揮を
		//取っている。＃｛国家安全保障決定命令、ＮＳＤＤ｝＃も
		//副大統領と国防省長官によって行われた。
	}
	talk 大佐 標準 -m {
		[P006_01_R01_Ａ脚金網１無線デモ１__e:大佐_004_1]
		//今回の作戦は＃｛国防総省、ペンタゴン｝＃が直接指揮を
		//取っている。＃｛国家安全保障決定命令、ＮＳＤＤ｝＃も
		//副大統領と国防省長官によって行われた。
	}
	talk 大佐 標準 -m {
		[P006_01_R01_Ａ脚金網１無線デモ１__e:大佐_004_2]
		//今回の作戦は＃｛国防総省、ペンタゴン｝＃が直接指揮を
		//取っている。＃｛国家安全保障決定命令、ＮＳＤＤ｝＃も
		//副大統領と国防省長官によって行われた。
	}
	talk 大佐 標準 -m {
		[P006_01_R01_Ａ脚金網１無線デモ１__e:大佐_005]
		//君の任務は極秘だが正規の手続きに
		//基づいているんだ。心配するな。
	}
}//v
}//d


//resource P007_01_R01_Ａ脚ノード前１無線デモ１＿１ 
proc vc110701:01  {
