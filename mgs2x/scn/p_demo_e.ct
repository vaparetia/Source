//resource P051_01_R01_エマとオタコン１無線機デモ１＿１ 
proc vc115101:01  {
vox t:vc115101 {
	talk ライデン 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:ライデン_000]
		//大佐、
		//エマ・エメリッヒの情報を知りたい。
	}

command セットサウンドコード -c d:SNG_FOUTP_M

	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_001]
		//ああ。調べさせておいた。
		//＃｛国家安全保障局、ＮＳＡ｝＃の局員ファイルに
		//彼女の名前があった。
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_002]
		//何らかの極秘プロジェクトに関わって
		//いたようだが、それについての記載は
		//ない。
	}


	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_003]
		//記録では二年前に職を辞したことに
		//なっている……。
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_004]
		//エマ・エメリッヒ。
		//本名、エマ・エメリッヒ・ダンジガー。
		//家族からはＥＥと呼ばれていたらしい。
	}
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_004_1]
		//エマ・エメリッヒ。
		//本名、エマ・エメリッヒ・ダンジガー。
		//家族からはＥＥと呼ばれていたらしい。
	}
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_005]
		//彼女はハル・エメリッヒの父親と離婚後、
		//母に連れられてイギリスに戻った。
	}
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_006]
		//まだ６歳の子供だった。ダンジガーは
		//母親の姓だが、彼女は好んでエメリッヒ
		//という姓を使っている。
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_007]
		//故郷イギリスに帰った後、
		//彼女の母親は再婚している。
		//ロビンソンという実業家だ。
	}
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_008]
		//以下はＮＳＡに入る際、取られた調書だ。
	}
@rp_うなづきデフォルト＿是
@rp_邪道外道＿否２＿ひどい系デフォルト 100
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_009]
		//……エマがハイスクールを卒業しようと
		//していた頃、義理の父親から暴行を受け
		//そうになり、父親を傷つけてしまう。
	}
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_009_1]
		//……エマがハイスクールを卒業しようと
		//していた頃、義理の父親から暴行を受け
		//そうになり、父親を傷つけてしまう。
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_010]
		//この事が原因でエマは義理の兄、ハル・
		//エメリッヒが歩んだのと同じように一人
		//家を出てオックスフォードへ入学する。
	}
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_010_1]
		//この事が原因でエマは義理の兄、ハル・
		//エメリッヒが歩んだのと同じように一人
		//家を出てオックスフォードへ入学する。
	}
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_011]
		//この時もエマは自分を守ってくれない兄、
		//ハルに対して非常な怒りを憶えている。
	}
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_011_1]
		//この時もエマは自分を守ってくれない兄、
		//ハルに対して非常な怒りを憶えている。
	}
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_012]
		//エマもハルと同じく、この時に事実上、
		//家族を失っている。『自分の不幸は全て
		//兄のせいだ』とも思いこんでいるようだ。
	}
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_012_1]
		//エマもハルと同じく、この時に事実上、
		//家族を失っている。『自分の不幸は全て
		//兄のせいだ』とも思いこんでいるようだ。
	}
@rp_うなづきデフォルト＿是
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_013]
		//オックスフォード在学中に、彼女は英国
		//政府中央情報部が主催する暗号解読
		//イベントで解読に成功している……。
	}
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_013_1]
		//オックスフォード在学中に、彼女は英国
		//政府中央情報部が主催する暗号解読
		//イベントで解読に成功している……。
	}
	talk ライデン 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:ライデン_014]
		//なるほど、血は繋がってはいないが、
		//オタコンの妹だ。
	}
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_015]
		//いやそれで終わりではない。
	}
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_016]
		//ライデン、ハッキング史上類をみない、
		//ある出来事を覚えているか？
	}
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_017]
		//当時の、わが国のあらゆる通信情報は
		//フォート・ミードにあるＮＳＡに
		//集中していた。
	}
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_017_1]
		//当時の、わが国のあらゆる通信情報は
		//フォート・ミードにあるＮＳＡに
		//集中していた。
	}
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_017_2]
		//当時の、わが国のあらゆる通信情報は
		//フォート・ミードにあるＮＳＡに
		//集中していた。
	}
@rp_うなづきデフォルト＿是
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_018]
		//衛星や盗聴などで得られた一般を含む
		//あらゆる通信情報が、２４時間体勢で
		//ＮＳＡの地下に集められていたのだ。
