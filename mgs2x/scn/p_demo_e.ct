		//……大佐、爆弾解体など、
		//俺にはできない。
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 80
	@rpd_ローズ顔表示
	talk ローズ 標準 -m {
		[P014_05_R01_ピーター遭遇５無線デモ１＿１__e:ローズ_009]
		//ジャック、私……。
	}
	talk ライデン 標準 -m {
		[P014_05_R01_ピーター遭遇５無線デモ１＿１__e:ライデン_010]
		//ローズ？。
	}
	talk ローズ 標準 -m {
		[P014_05_R01_ピーター遭遇５無線デモ１＿１__e:ローズ_011]
		//大丈夫、あなたならできる。
