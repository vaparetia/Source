#include "vcvx.h"



//resource P001_02_R01_オープニング潜入２無線デモ１＿１ 
proc vc110101:01  {
vox t:vc110101 {
	talk ライデン 標準 -m {
		[P001_02_R01_オープニング潜入２無線デモ１＿１__e:ライデン_000]
		//こちらスネーク、
		//シェルワン１のＡ脚内に潜入した。
	}
	talk 大佐 標準 -m {
		[P001_02_R01_オープニング潜入２無線デモ１＿１__e:大佐_001]
		//状況はどうだ？
	}
	talk ライデン 標準 -m {
		[P001_02_R01_オープニング潜入２無線デモ１＿１__e:ライデン_002]
		//幸い、ここには見張りはいないようだ。
	}
	talk 大佐 標準 -m {
		[P001_02_R01_オープニング潜入２無線デモ１＿１__e:大佐_003]
		//視界はどうだ？
	}
	talk ライデン 標準 -m {
		[P001_02_R01_オープニング潜入２無線デモ１＿１__e:ライデン_004]
		//プラント脚部のライトが起動している。
		//おかげで赤外線ゴーグルは使わずに済む。
	}

@rp_うなづきデフォルト

	talk 大佐 標準 -m {
		[P001_02_R01_オープニング潜入２無線デモ１＿１__e:大佐_005]
		//何か問題は？
	}
	talk ライデン 標準 -m {
		[P001_02_R01_オープニング潜入２無線デモ１＿１__e:ライデン_006]
		//オイルフェンスの切断面が真新しかった。
		//俺の他にも潜入を試みた奴がいる。
	}
	talk ライデン 標準 -m {
		[P001_02_R01_オープニング潜入２無線デモ１＿１__e:ライデン_006_1]
		//オイルフェンスの切断面が真新しかった。
		//俺の他にも潜入を試みた奴がいる。
	}
	talk 大佐 標準 -m {
		[P001_02_R01_オープニング潜入２無線デモ１＿１__e:大佐_007]
		//それは考えられん。
	}

@rp_うなづきデフォルト

	talk ライデン 標準 -m {
		[P001_02_R01_オープニング潜入２無線デモ１＿１__e:ライデン_008]
		//シールＳＥＡＬテン１０の突入班は？
	}
	talk 大佐 標準 -m {
		[P001_02_R01_オープニング潜入２無線デモ１＿１__e:大佐_009]
		//既に『ビッグ・シェル』上部に降下した。
		//それとスネーク、今後の無線はコード
		//ネームを変更して行う。
	}
	talk 大佐 標準 -m {
		[P001_02_R01_オープニング潜入２無線デモ１＿１__e:大佐_009_1]
		//既に『ビッグ・シェル』上部に降下した。
		//それとスネーク、今後の無線はコード
		//ネームを変更して行う。
	}
	talk ライデン 標準 -m {
		[P001_02_R01_オープニング潜入２無線デモ１＿１__e:ライデン_010]
		//スネークでは何か問題が？
	}

@rp_うなづきデフォルト

	talk 大佐 標準 -m {
		[P001_02_R01_オープニング潜入２無線デモ１＿１__e:大佐_011]
		//まあな……。
		//君をこれから、ライデンと呼ぶ
	}
}//v
}//d

//★　タンカー編をクリアしたユーザーの場合
//resource P001_02_R01_オープニング潜入２無線デモ１＿タンカーした１ 
proc vc110102:01  {
vox t:vc110102 {
	talk 大佐 標準 -m {
		[P001_02_R01_オープニング潜入２無線デモ１＿タンカーした１__e:大佐_000]
		//では、ライデン。
		//潜入ミッションは既にＶＲ訓練で
		//訓練済みだな。
	}
	talk ライデン 標準 -m {
		[P001_02_R01_オープニング潜入２無線デモ１＿タンカーした１__e:ライデン_001]
		//ＶＲなら３００ミッションはこなした。
	}
	talk ライデン 標準 -m {
		[P001_02_R01_オープニング潜入２無線デモ１＿タンカーした１__e:ライデン_002]
		//伝説の傭兵になった気分だ……。
	}
}//v
}

//resource P001_02_R01_オープニング潜入２無線デモ１＿タンカーした２
proc vc110103:01  {
vox t:vc110103 {
	talk 大佐 標準 -m {
		[P001_02_R01_オープニング潜入２無線デモ１＿タンカーした２__e:大佐_000]
		//それじゃ、その部分は簡略化するぞ
	}
}//v
}//d


//★　タンカー編をクリアしていないユーザーの場合

//resource P001_02_R01_オープニング潜入２無線デモ１＿タンカーしてない 

proc vc110104:01  {
vox t:vc110104 {
	talk 大佐 標準 -m {
		[P001_02_R01_オープニング潜入２無線デモ１＿タンカーしてない__e:大佐_000]
		//今回、君にとって初めての＃｛潜入任務、スニーキング・ミッション｝＃に
		//なる。
	}

@rp_無茶指令＿否１＿お前がやれ系デフォルト 100

	talk 大佐 標準 -m {
		[P001_02_R01_オープニング潜入２無線デモ１＿タンカーしてない__e:大佐_001]
		//当然、武器は現地調達だ。
	}
}//v
}//d

//resource P001_02_R01_オープニング潜入２無線デモ１＿２ {
proc vc110105:01  {
vox d:_vc110105 {
	talk 大佐 標準 -m {
		[P001_02_R01_オープニング潜入２無線デモ１＿２__e:大佐_000]
		//くれぐれも見つからんようにな
	}

@rp_うなづきデフォルト＿是
@rp_無茶指令＿否１＿お前がやれ系デフォルト 80

	talk 大佐 標準 -m {
		[P001_02_R01_オープニング潜入２無線デモ１＿２__e:大佐_001]
		//何かあれば無線連絡をくれ。
		//周波数は１４０．８５だ
		}
	talk 大佐 標準 -m {
		[P001_02_R01_オープニング潜入２無線デモ１＿２__e:大佐_002]
		//無線機を使いたい時は
		//ＳＥＬＥＣＴボタンを押すんだ。
		}
	talk 大佐 標準 -m {
		[P001_02_R01_オープニング潜入２無線デモ１＿２__e:大佐_003]
		//こちらから呼び出す場合、
		//いや連絡する場合はＣＡＬＬする。
		}
	talk 大佐 標準 -m {
		[P001_02_R01_オープニング潜入２無線デモ１＿２__e:大佐_004]
		//コールＣＡＬＬ音がなったら、
		//ＳＥＬＥＣＴボタンを押してくれ。
		}

@rp_うなづきデフォルト＿是

	talk 大佐 標準 -m {
		[P001_02_R01_オープニング潜入２無線デモ１＿２__e:大佐_005]
		//耳小骨を直接振動させるものだ。
		//敵には聞こえない。
		}
	talk 大佐 標準 -m {
		[P001_02_R01_オープニング潜入２無線デモ１＿２__e:大佐_005_1]
		//耳小骨を直接振動させるものだ。
		//敵には聞こえない。
		}
	talk ライデン 標準 -m {
		[P001_02_R01_オープニング潜入２無線デモ１＿２__e:ライデン_006]
		//わかった。
		//なにかあれば＃｛送信、ＳＥＮＤ｝＃する。
		}
}//v
}

