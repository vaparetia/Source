		//僕たちの呪われた家系を知っているだろ？
		//どうしてなんだ？
	}
	talk エマ 標準 -m {
		[P061_01_R01_エマとオタコン１無線機デモ１＿２__e:エマ_006]
		//……やっぱり。
	}
	talk オタコン 標準 -m {
		[P061_01_R01_エマとオタコン１無線機デモ１＿２__e:オタコン_007]
		//どうしてだ？
		//どうして同じ過ちを繰り返す？
	}
	talk エマ 標準 -m {
		[P061_01_R01_エマとオタコン１無線機デモ１＿２__e:エマ_008]
		//……。
	}
	talk エマ 標準 -m {
		[P061_01_R01_エマとオタコン１無線機デモ１＿２__e:エマ_009]
		//あなたに会って、
		//あなたを苦しめたかったから……。	
	}
	talk オタコン 標準 -m {
		[P061_01_R01_エマとオタコン１無線機デモ１＿２__e:オタコン_010]
		//ＥＥ？
	}
	talk エマ 標準 -m {
		[P061_01_R01_エマとオタコン１無線機デモ１＿２__e:エマ_011]
		//あなたは私を捨てた……。
	}
	talk オタコン 標準 -m {
		[P061_01_R01_エマとオタコン１無線機デモ１＿２__e:オタコン_012]
		//違う。そうじゃない。
	}
	@rpd_プリスキン顔表示
	talk プリスキン 標準 -m {
		[P061_01_R01_エマとオタコン１無線機デモ１＿２__e:プリスキン_013]
