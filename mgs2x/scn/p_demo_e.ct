//resource P073_03_R02_通路Ａ３無線機デモ２＿１ 
proc vc117311:01  {
vox t:vc117311 {
	talk プリスキン 標準 -m {
		[P073_03_R02_通路Ａ３無線機デモ２＿１__e:スネーク_000]
		//悪かったな。アーセナルに潜入する
		//ためにお前をだしに使わせてもらった。		//
		//お陰でうまくいった。
	}
	talk ライデン 標準 -m {
		[P073_03_R02_通路Ａ３無線機デモ２＿１__e:ライデン_001]
		//オルガのこと、なぜ黙っていた？
	}
@rp_うなづきデフォルト＿是
@rp_邪道外道＿否２＿ひどい系デフォルト 100
	talk プリスキン 標準 -m {
		[P073_03_R02_通路Ａ３無線機デモ２＿１__e:スネーク_002]
		//聞かなかっただろう？
	}
	talk ライデン 標準 -m {
		[P073_03_R02_通路Ａ３無線機デモ２＿１__e:ライデン_003]
		//くっ！
	}
	talk プリスキン 標準 -m {
		[P073_03_R02_通路Ａ３無線機デモ２＿１__e:スネーク_004]
		//気にいらんか？
		//ま、過ぎたことだ。
		//気にするな。
	}
	talk ライデン 標準 -m {
		[P073_03_R02_通路Ａ３無線機デモ２＿１__e:ライデン_005]
		//……ウイルスの効果は？
	}	
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		[P073_03_R02_通路Ａ３無線機デモ２＿１__e:スネーク_006]
		//まだ出ていない。
	}
	talk ライデン 標準 -m {
		[P073_03_R02_通路Ａ３無線機デモ２＿１__e:ライデン_007]
		//やはり『愛国者達』の仕掛けが？
	}
	talk プリスキン 標準 -m {
		[P073_03_R02_通路Ａ３無線機デモ２＿１__e:スネーク_008]
		//らしいな。アーセナルはマンハッタンに
		//向かっているようだ。
	}
	talk プリスキン 標準 -m {
		[P073_03_R02_通路Ａ３無線機デモ２＿１__e:スネーク_009]
		//ソリダスが何をする気かは分からんが……
		//俺達でなんとかするしかない。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		[P073_03_R02_通路Ａ３無線機デモ２＿１__e:スネーク_010]
		//この先に量産型ＲＡＹが待ち構えている。
	}
	talk ライデン 標準 -m {
		[P073_03_R02_通路Ａ３無線機デモ２＿１__e:ライデン_011]
		//何機？
	}
	talk プリスキン 標準 -m {
		[P073_03_R02_通路Ａ３無線機デモ２＿１__e:スネーク_012]
		//オルガが言うには２５機。
	}
	talk ライデン 標準 -m {
		[P073_03_R02_通路Ａ３無線機デモ２＿１__e:ライデン_013]
		//２５機！？
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		[P073_03_R02_通路Ａ３無線機デモ２＿１__e:スネーク_014]
		//ああ。俺もそれだけのメタルギアを
		//相手にしたことはないが……
		//いけるだろう？
	}
	talk ライデン 標準 -m {
		[P073_03_R02_通路Ａ３無線機デモ２＿１__e:ライデン_015]
		//とても相手に出来ない……。
	}
	talk プリスキン 標準 -m {
		[P073_03_R02_通路Ａ３無線機デモ２＿１__e:スネーク_016]
		//だがやるしかない。
	}
	talk ライデン 標準 -m {
		[P073_03_R02_通路Ａ３無線機デモ２＿１__e:ライデン_017]
		//どうやって？
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		[P073_03_R02_通路Ａ３無線機デモ２＿１__e:スネーク_018]
		//スティンガー・ミサイルを
		//補給しておいた。
	}
	talk プリスキン 標準 -m {
		[P073_03_R02_通路Ａ３無線機デモ２＿１__e:スネーク_019]
		//そうだ、オルガからこれを預かった。
	}
}//v
}//d



//resource P074_02_R01_通路Ａ刀後２無線機デモ１＿１ 
proc vc117401:01  {
vox t:vc117401 {
	talk ライデン 標準 -m {
		[P074_02_R01_通路Ａ刀後２無線機デモ１＿１__e:ライデン_000]
		//スネーク、
		//人を殺す度に喜びを感じたことは？
	}
	talk プリスキン 標準 -m {
		[P074_02_R01_通路Ａ刀後２無線機デモ１＿１__e:スネーク_001]
		//どういう意味だ。
	}
	talk ライデン 標準 -m {
		[P074_02_R01_通路Ａ刀後２無線機デモ１＿１__e:ライデン_002]
		//わからない。
		//これが現実なのか？
		//ゲームなのか？
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		[P074_02_R01_通路Ａ刀後２無線機デモ１＿１__e:スネーク_003]
		//現実感の欠如。
		//ＶＲ訓練の影響だ。
	}
	talk ライデン 標準 -m {
		[P074_02_R01_通路Ａ刀後２無線機デモ１＿１__e:ライデン_004]
		//いや、現実に訓練されたんだ。
		//子供の頃に。
	}
	talk ライデン 標準 -m {
		[P074_02_R01_通路Ａ刀後２無線機デモ１＿１__e:ライデン_005]
		//スネーク、俺は嘘をついた。
		//実戦の経験をしている。		//
		//ＶＲの影響じゃない。
	}
	talk プリスキン 標準 -m {
		[P074_02_R01_通路Ａ刀後２無線機デモ１＿１__e:スネーク_006]
		//ライデン、俺達は人を傷つけるために
		//銃を握っているわけじゃない。
		//ましてや、どこかの政治家の為でもない。
	}
	talk ライデン 標準 -m {
		[P074_02_R01_通路Ａ刀後２無線機デモ１＿１__e:ライデン_007]
		//あんたは伝説の＃｛戦士、ヒーロー｝＃だ。
		//俺は＃｛切り裂きジャック、ジャック・ザ・リッパー｝＃。
		//封印された歴史のおわい汚穢。
	}
	talk ライデン 標準 -m {
		[P074_02_R01_通路Ａ刀後２無線機デモ１＿１__e:ライデン_007_1]
		//あんたは伝説の＃｛戦士、ヒーロー｝＃だ。
		//俺は＃｛切り裂きジャック、ジャック・ザ・リッパー｝＃。
		//封印された歴史のおわい汚穢。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		[P074_02_R01_通路Ａ刀後２無線機デモ１＿１__e:スネーク_008]
		//伝説でもなんでもない、
		//俺も利用されただけだ。
	}
	talk プリスキン 標準 -m {
		[P074_02_R01_通路Ａ刀後２無線機デモ１＿１__e:スネーク_009]
		//俺もお前と同じだ。
	}
	talk ライデン 標準 -m {
		[P074_02_R01_通路Ａ刀後２無線機デモ１＿１__e:ライデン_010]
		//あんたの行動は語り継がれる。
		//正当化される。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		[P074_02_R01_通路Ａ刀後２無線機デモ１＿１__e:スネーク_011]
		//人殺しが正当化される事などない。
		//正当化される時代もない。
	}
	talk プリスキン 標準 -m {
		[P074_02_R01_通路Ａ刀後２無線機デモ１＿１__e:スネーク_012]
		//俺達は自分の功績を残そうとして
		//いるんじゃない。
	}
	talk ライデン 標準 -m {
		[P074_02_R01_通路Ａ刀後２無線機デモ１＿１__e:ライデン_013]
		//なら、あんたやオタコンは何のために
		//戦ってる？
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		[P074_02_R01_通路Ａ刀後２無線機デモ１＿１__e:スネーク_014]
		//俺は未来のために銃を握っている。
	}
	talk プリスキン 標準 -m {
		[P074_02_R01_通路Ａ刀後２無線機デモ１＿１__e:スネーク_015]
		//いいか、つまらん殺戮に手を貸すのは、
		//これで終わりにしろ。	
	}
	talk ライデン 標準 -m {
		[P074_02_R01_通路Ａ刀後２無線機デモ１＿１__e:ライデン_016]
		//俺は……どうすればいいんだ？
	}
}//v
}//d


//resource P075_01_R01_オタコン無事１無線機デモ１＿１ 
proc vc117501:01  {
vox t:vc117501 {
	talk オタコン 標準 -m {
		[P075_01_R01_オタコン無事１無線機デモ１＿１__e:オタコン_000]
		//スネーク、ライデン！
	}
	@rpd_スネーク顔表示
	talk プリスキン 標準 -m {
		[P075_01_R01_オタコン無事１無線機デモ１＿１__e:スネーク_001]
		//オタコン！
		//無事だったか？
	}
	@rpd_オタコン顔表示
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		[P075_01_R01_オタコン無事１無線機デモ１＿１__e:オタコン_002]
		//うん。人質もみんなね。
	}
	talk ライデン 標準 -m {
		[P075_01_R01_オタコン無事１無線機デモ１＿１__e:ライデン_003]
		//それはよかった。
	}
	talk オタコン 標準 -m {
		[P075_01_R01_オタコン無事１無線機デモ１＿１__e:オタコン_004]
		//君達の方は大丈夫かい？
	}
	talk ライデン 標準 -m {
		[P075_01_R01_オタコン無事１無線機デモ１＿１__e:ライデン_005]
		//今のところは……ただ……。
	}	
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		[P075_01_R01_オタコン無事１無線機デモ１＿１__e:オタコン_006]
		//ただ？
	}
	talk ライデン 標準 -m {
		[P075_01_R01_オタコン無事１無線機デモ１＿１__e:ライデン_007]
		//大佐の様子がおかしいんだ。
	}
	talk オタコン 標準 -m {
		[P075_01_R01_オタコン無事１無線機デモ１＿１__e:オタコン_008]
		//おかしい？
	}
	talk ライデン 標準 -m {
		[P075_01_R01_オタコン無事１無線機デモ１＿１__e:ライデン_009]
		//ああ……一体どうしたのか……？
	}	
	talk オタコン 標準 -m {
		[P075_01_R01_オタコン無事１無線機デモ１＿１__e:オタコン_010]
		//妨害電波？
	}
	talk ライデン 標準 -m {
		[P075_01_R01_オタコン無事１無線機デモ１＿１__e:ライデン_011]
		//わからない。
	}
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		[P075_01_R01_オタコン無事１無線機デモ１＿１__e:オタコン_012]
		//……大佐はどこから指令を？
	}
	talk ライデン 標準 -m {
		[P075_01_R01_オタコン無事１無線機デモ１＿１__e:ライデン_013]
		//……わからないんだ。
		//俺は大佐に会ったことがない……。
	}
	talk オタコン 標準 -m {
		[P075_01_R01_オタコン無事１無線機デモ１＿１__e:オタコン_014]
		//……調べてみるよ。
	}
	talk ライデン 標準 -m {
		[P075_01_R01_オタコン無事１無線機デモ１＿１__e:ライデン_015]
		//頼む。
	}
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		[P075_01_R01_オタコン無事１無線機デモ１＿１__e:オタコン_016]
		//他にも何かあったら無線連絡をくれ。
		//サポートできると思う。
		//周波数は１４１．１２だ。
	}
	talk オタコン 標準 -m {
		[P075_01_R01_オタコン無事１無線機デモ１＿１__e:オタコン_016_1]
		//他にも何かあったら無線連絡をくれ。
		//サポートできると思う。
		//周波数は１４１．１２だ。
	}
}//v
}//d



//resource P076_01_R01_大佐ＡＩ１無線機デモ１＿１ 
proc vc117601:01  {
vox t:vc117601 {
	talk オタコン 標準 -m {
		[P076_01_R01_大佐ＡＩ１無線機デモ１＿１__e:オタコン_000]
		//ライデン？
		//『大佐』のことだけど……わかったんだ。
		//君の『大佐』がどこにいるのか。
	}
	talk ライデン 標準 -m {
		[P076_01_R01_大佐ＡＩ１無線機デモ１＿１__e:ライデン_001]
		//どこだ？
	}
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		[P076_01_R01_大佐ＡＩ１無線機デモ１＿１__e:オタコン_002]
		//そのアーセナルの中。
	}
	talk ライデン 標準 -m {
		[P076_01_R01_大佐ＡＩ１無線機デモ１＿１__e:ライデン_003]
		//なに！？。
	}
	talk オタコン 標準 -m {
		[P076_01_R01_大佐ＡＩ１無線機デモ１＿１__e:オタコン_004]
		//いろいろな要素を検討したんだけど……
		//中継ではなく、アーセナル内部から
		//発信されているとしか考えられない。
	}
	talk オタコン 標準 -m {
		[P076_01_R01_大佐ＡＩ１無線機デモ１＿１__e:オタコン_004_1]
		//いろいろな要素を検討したんだけど……
		//中継ではなく、アーセナル内部から
		//発信されているとしか考えられない。
	}
	talk ライデン 標準 -m {
		[P076_01_R01_大佐ＡＩ１無線機デモ１＿１__e:ライデン_005]
		//……。
	}
//command セットサウンドコード -c d:SNG_FOUTP_M
command セットサウンドコード -c d:SNG_FOUTS_M
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		[P076_01_R01_大佐ＡＩ１無線機デモ１＿１__e:オタコン_006]
		//それに……暗号化コードが同じなんだ……
		//『Ｇ．Ｗ』……アーセナルのＡＩと。
	}
	talk ライデン 標準 -m {
		[P076_01_R01_大佐ＡＩ１無線機デモ１＿１__e:ライデン_007]
		//……どういうことなんだ？
	}
	talk オタコン 標準 -m {
		[P076_01_R01_大佐ＡＩ１無線機デモ１＿１__e:オタコン_008]
		//つまり……君が喋っていた相手は、
		//ＡＩなんだよ。
	}
	talk ライデン 標準 -m {
		[P076_01_R01_大佐ＡＩ１無線機デモ１＿１__e:ライデン_009]
		//嘘だ！！
	}
@rp_うなづきデフォルト＿是
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk オタコン 標準 -m {
		[P076_01_R01_大佐ＡＩ１無線機デモ１＿１__e:オタコン_010]
		//本当だ。正確には『Ｇ．Ｗ』そのもの
		//じゃない。おそらく『Ｇ．Ｗ』からの
		//信号が君の脳内ナノマシンを動かし、
	}
	talk オタコン 標準 -m {
		[P076_01_R01_大佐ＡＩ１無線機デモ１＿１__e:オタコン_010_1]
		//本当だ。正確には『Ｇ．Ｗ』そのもの
		//じゃない。おそらく『Ｇ．Ｗ』からの
		//信号が君の脳内ナノマシンを動かし、
	}
	talk オタコン 標準 -m {
		[P076_01_R01_大佐ＡＩ１無線機デモ１＿１__e:オタコン_011]
		//脳の使用されていない冗長部分の
		//神経配置を器質操作して『大佐』を
		//発生させるっていう仕組みだ……
	}
	talk オタコン 標準 -m {
		[P076_01_R01_大佐ＡＩ１無線機デモ１＿１__e:オタコン_012]
		//つまり『大佐』は君の脳の中に
		//存在する……。
	}
	talk ライデン 標準 -m {
		[P076_01_R01_大佐ＡＩ１無線機デモ１＿１__e:ライデン_013]
		//馬鹿な……。
	}
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		[P076_01_R01_大佐ＡＩ１無線機デモ１＿１__e:オタコン_014]
		//でも、事実なんだ。
	}
	talk オタコン 標準 -m {
		[P076_01_R01_大佐ＡＩ１無線機デモ１＿１__e:オタコン_015]
		//『大佐』の様子がおかしくなってるのは、
		//多分あのウィルスが『Ｇ．Ｗ』に効き
		//始めたせいだと思う。
	}
	talk ライデン 標準 -m {
		[P076_01_R01_大佐ＡＩ１無線機デモ１＿１__e:ライデン_016]
		//全て……幻……？
		//では……俺が今までしてきたことは……？
	}
	@rpd_スネーク顔表示
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		[P076_01_R01_大佐ＡＩ１無線機デモ１＿１__e:スネーク_017]
		//ライデン！
	}
	talk ライデン 標準 -m {
		[P076_01_R01_大佐ＡＩ１無線機デモ１＿１__e:ライデン_018]
		//スネーク……
		//どういうことなんだろう？
	}
	talk プリスキン 標準 -m {
		[P076_01_R01_大佐ＡＩ１無線機デモ１＿１__e:スネーク_019]
		//わからん。
		//……俺に言えるのは、俺の目の前にいる
		//お前は幻じゃないということだけだ。
	}
	talk プリスキン 標準 -m {
		[P076_01_R01_大佐ＡＩ１無線機デモ１＿１__e:スネーク_020]
		//お前は確かにここにいる。
	}
	talk ライデン 標準 -m {
		[P076_01_R01_大佐ＡＩ１無線機デモ１＿１__e:ライデン_021]
		//……。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		[P076_01_R01_大佐ＡＩ１無線機デモ１＿１__e:スネーク_022]
		//どうする？
		//やめたければやめてもいい。
	}
	talk ライデン 標準 -m {
		[P076_01_R01_大佐ＡＩ１無線機デモ１＿１__e:ライデン_023]
		//いや。辞めるわけにはいかない。
		//行こう……。
	}
}//v
command セットサウンドコード -c d:SNG_FIN_S
}//d





//resource P077_01_R01_ローズ拉致１無線機デモ１＿１ 
proc vc117701:01  {
vox t:vc117701 {
/*
bugface	0 大佐 \
		-span 60 80 \
		-face cam_radio_mh_mt cam_skull_mh_mt
*/
	talk 大佐 標準 -m {
		[P077_01_R01_ローズ拉致１無線機デモ１＿１__e:大佐_000]
		//ライデン！
		//ローズ君が奴等に拉致された！！
	}
/*
bugface	0 大佐 \
		-span 400 100 \
		-face cam_radio_mh_mt cam_skull_mh_mt
*/
	talk ライデン 標準 -m {
		[P077_01_R01_ローズ拉致１無線機デモ１＿１__e:ライデン_001]
		//何だって！
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P077_01_R01_ローズ拉致１無線機デモ１＿１__e:大佐_002]
		//ローズ君は船倉に捕らえられている！
	}
//（ＯＦＦ） くちぱくいりません
	talk プリスキン 標準 -m {
		[P077_01_R01_ローズ拉致１無線機デモ１＿１__e:スネーク_003]
		//罠だぞ！
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	@rpd_ローズ顔表示	//ノイズの方がいーかなー？ＸＸＸＸｘ
	talk ローズ 標準 -m {
		[P077_01_R01_ローズ拉致１無線機デモ１＿１__e:ローズ_004]
		//タスケテ！
	}
noise 0 1
	//vox t:vc117702 
	talk ライデン 標準 -m {
		[P077_01_R01_ローズ拉致１無線機デモ１＿１__e:ライデン_005]
		//ローズ！！
	}
	@rpd_スネーク顔表示
noise 0 0
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		[P077_01_R01_ローズ拉致１無線機デモ１＿１__e:スネーク_006]
		//落ち着け、ライデン。
	}
	talk ライデン 標準 -m {
		[P077_01_R01_ローズ拉致１無線機デモ１＿１__e:ライデン_007]
		//しかし！！
	}
	talk プリスキン 標準 -m {
		[P077_01_R01_ローズ拉致１無線機デモ１＿１__e:スネーク_008]
		//奴等の罠だ。
		//『大佐』は存在しない。
		//ローズを拉致出来るはずもないだろう。
	}
	talk ライデン 標準 -m {
		[P077_01_R01_ローズ拉致１無線機デモ１＿１__e:ライデン_009]
		//……そうか……
		//……そうだな……。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		[P077_01_R01_ローズ拉致１無線機デモ１＿１__e:スネーク_010]
		//そうだ。
	}
	talk ライデン 標準 -m {
		[P077_01_R01_ローズ拉致１無線機デモ１＿１__e:ライデン_011]
		//……そう……。
	}
	talk ライデン 標準 -m {
		[P077_01_R01_ローズ拉致１無線機デモ１＿１__e:ライデン_012]
		//……。
	}
	talk ライデン 標準 -m {
		[P077_01_R01_ローズ拉致１無線機デモ１＿１__e:ライデン_013]
		//……ローズも……存在しない……？。
	}
	talk プリスキン 標準 -m {
		[P077_01_R01_ローズ拉致１無線機デモ１＿１__e:スネーク_014]
		//何を言ってるんだ？
		//彼女は……。
	}
	talk ライデン 標準 -m {
		[P077_01_R01_ローズ拉致１無線機デモ１＿１__e:ライデン_015]
		//いや、ひょっとしたら俺は
		//彼女と会ったことすらないのかも
		//しれない……。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		[P077_01_R01_ローズ拉致１無線機デモ１＿１__e:スネーク_016]
		//何を？
	}
	talk ライデン 標準 -m {
		[P077_01_R01_ローズ拉致１無線機デモ１＿１__e:ライデン_017]
		//『大佐』が俺の脳の中にしか存在しない
		//幻だったように……
		//彼女も、彼女との思い出も……。
	}
	talk ライデン 標準 -m {
		[P077_01_R01_ローズ拉致１無線機デモ１＿１__e:ライデン_017_1]
		//『大佐』が俺の脳の中にしか存在しない
		//幻だったように……
		//彼女も、彼女との思い出も……。
	}
	talk プリスキン 標準 -m {
		[P077_01_R01_ローズ拉致１無線機デモ１＿１__e:スネーク_018]
		//結論を急ぐんじゃない！！
	}
	talk ライデン 標準 -m {
		[P077_01_R01_ローズ拉致１無線機デモ１＿１__e:ライデン_019]
		//『大佐』が存在しないという結論を
		//出したのはあんた達だぞ。
	}
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		[P077_01_R01_ローズ拉致１無線機デモ１＿１__e:スネーク_020]
		//ライデン！
	}
	talk ライデン 標準 -m {
		[P077_01_R01_ローズ拉致１無線機デモ１＿１__e:ライデン_021]
		//オルガが言っていたのは……
		//このことだった？
	}
}//v
}//d




//resource P080_19_R01_ＡＧ浮上１９無線機デモ１＿１ 
proc vc118001:01  {
vox t:vc118001 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P080_19_R01_ＡＧ浮上１９無線機デモ１＿１__e:大佐_000]
		//ライデン、聞こえるか？
		//我々だ。
	}
	talk ライデン 標準 -m {
		[P080_19_R01_ＡＧ浮上１９無線機デモ１＿１__e:ライデン_001]
		//なぜだ！？
		//ＡＩは崩壊したはず！？
	}
	talk 大佐 標準 -m {
		[P080_19_R01_ＡＧ浮上１９無線機デモ１＿１__e:大佐_002]
		//『Ｇ．Ｗ』は、な……。
	}
	talk ライデン 標準 -m {
		[P080_19_R01_ＡＧ浮上１９無線機デモ１＿１__e:ライデン_003]
		//お前達は一体！？
	}
@rp_うなづきデフォルト＿是
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	@rpd_バグ大佐顔表示
	talk 大佐 標準 -m {
		[P080_19_R01_ＡＧ浮上１９無線機デモ１＿１__e:大佐_004]
		//そもそも我々は正確には……
		//	人ではない。
	}
}//v
}//d





//resource P080_21_R02_ＡＧ浮上２１無線機デモ２＿２ 
proc vc118011:01  {
vox t:vc118011 {
@rp_うなづきデフォルト

	talk 大佐 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:大佐_000]
		//我々に実体はない。我々は君達が頼る
		//『秩序』や『規範』そのものなのだ。
	}
	talk 大佐 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:大佐_001]
		//誰も我々を抹殺する事はできない。
		//この国が消滅しない限り、
		//我々は存在し続ける……。
	}
	talk ライデン 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:ライデン_000]
		//ふざけるな！お前達が不滅なら、
		//vなぜ支配を続けるために個人の自由を
		//奪い、デジタル情報を検閲する？
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_邪道外道＿否１＿サイテー系デフォルト 100
	@rpd_ローズ顔表示
	talk ローズ 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:ローズ_001]
		//ははは、ジャックって、ほんと馬鹿ね。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:大佐_002]
		//いいか、我々の計画は我々のために
		//あるのではない。
		//君達のためにあるのだよ。
	}
	talk ライデン 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:ライデン_003]
		//なに？
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_邪道外道＿否１＿サイテー系デフォルト 100
	talk ローズ 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:ローズ_004]
		//ジャック、耳をかっぽじって、
		//よく聞きなさい！
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:大佐_005]
		//今世紀初頭にヒトゲノム情報の
		//読みとりが完了した。
	}
	talk 大佐 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:大佐_006]
		//その結果、地球生命の４８億年に渡る、
		//我々人類の進化過程が明らかになった。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_邪道外道＿否１＿サイテー系デフォルト 100
	talk ローズ 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:ローズ_007]
		//遺伝子操作を始めとして、
		//生命のデジタル化に成功したのよ。
	}
@rp_うなづきデフォルト
	@rpd_大佐顔表示
	talk 大佐 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:大佐_008]
		//しかし、一方で遺伝子上に乗っていない
		//ものがある。
	}
	talk ライデン 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:ライデン_009]
		//遺伝情報に載っていないもの？
	}
	talk 大佐 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:大佐_010]
		//そう、人の記憶や思想、文化や歴史だ。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
	talk ローズ 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:ローズ_011]
		//遺伝子には人類の歴史は刻まれてない。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:大佐_012]
		//果たして、それは伝えるべきなのか？
		//これまで同様、自然界で淘汰される
		//べきなのか？。
	}
	talk 大佐 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:大佐_012_1]
		//果たして、それは伝えるべきなのか？
		//これまで同様、自然界で淘汰される
		//べきなのか？。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うんちく＿否＿話分からん系デフォルト 70
	talk ローズ 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:ローズ_013]
		//私達の先祖はそれらを語り伝えてきた。
		//言葉や絵、文字を使って……
		//石版や書物に記録しながら……。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト＿是
@rp_うんちく＿否＿話分からん系デフォルト 70
	talk 大佐 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:大佐_014]
		//しかし、全ての情報が後世に
		//伝えられてきた訳でない。
	}
	talk 大佐 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:大佐_015]
		//選択され、加工されて継承されて
		//きたのだ……。
		//まるで遺伝子のように。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
	talk ローズ 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:ローズ_016]
		//それが人の歴史よ、ジャック。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト＿是
@rp_うんちく＿否＿話分からん系デフォルト 70
	talk 大佐 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:大佐_017]
		//しかし、現代のデジタル社会では、
		//日々のあらゆる情報が蓄積され、些細な
		//情報がそのままの形で保存されている。
	}
	talk 大佐 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:大佐_017_1]
		//しかし、現代のデジタル社会では、
		//日々のあらゆる情報が蓄積され、些細な
		//情報がそのままの形で保存されている。
	}
	talk 大佐 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:大佐_018]
		//永久に、劣化する事はない。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
	talk ローズ 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:ローズ_019]
		//誰が言ったかも分からない、
		//ゴミのような噂、間違った解釈、
		//他人の中傷……。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト＿是
@rp_うんちく＿否＿話分からん系デフォルト 70
	talk 大佐 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:大佐_020]
		//あらゆる情報が濾過されず、保存されて、
		//後世に伝えられる。
	}
@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
	talk ローズ 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:ローズ_021]
		//それは進化を止める。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト＿是
@rp_うんちく＿否＿話分からん系デフォルト 70
	talk 大佐 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:大佐_022]
		//ライデン、君は我々が行おうとしている
		//ことを単なる検閲だと思っていないか？
	}
	talk ライデン 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:ライデン_023]
		//違うとでも言うのか！？
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
	talk ローズ 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:ローズ_024]
		//ええ、勿論。私達がしようと
		//してるのはコンテンツの制御ではなく、
		//コンテクストの生成。
	}
	talk ライデン 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:ライデン_025]
		//コンテクストの生成？
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト＿是
@rp_うんちく＿否＿話分からん系デフォルト 70
	talk 大佐 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:大佐_026]
		//世界のデジタル化は、人の弱さを助長し、
		//それぞれだけに都合のいい『真実』の
		//生成を加速している。
	}
	talk 大佐 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:大佐_026_1]
		//世界のデジタル化は、人の弱さを助長し、
		//それぞれだけに都合のいい『真実』の
		//生成を加速している。
	}
	talk 大佐 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:大佐_027]
		//社会に満ちる『真実』の山を
		//見てみるがいい……。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
	talk ローズ 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:ローズ_028]
		//高価な兵器が人道的に人を殺し……
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト＿是
@rp_うんちく＿否＿話分からん系デフォルト 50
	talk 大佐 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:大佐_029]
		//犯罪者の人権は被害者のプライバシー
		//より丁重に扱われ……
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
	talk ローズ 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:ローズ_030]
		//稀少動物保護の寄付金が集まる傍らで、
		//貧困に苦しむ人達がいる……。
	}
	talk ローズ 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:ローズ_031]
		//誰もがこう言われて育つわ。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:大佐_032]
		//他人には優しくしよう。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:ローズ_033]
		//でも競争相手は叩きのめせ！
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:大佐_034]
		//『お前は特別だ』
		//『信じていれば夢はかなう』	
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:ローズ_035]
		//だけど成功できる人間が一部だけなのは、
		//初めから明らかよね……。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:大佐_036]
		//君達が『自由』を『行使』した、
		//これが結果だ。
	}
	talk 大佐 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:大佐_037]
		//争いを避け、傷つかないようにお互いを
		//かばいあうための詭弁……
	}
	talk 大佐 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:大佐_038]
		//『政治的正しさ』や『価値相対化』と
		//いうキレイゴトの名の下に、それぞれの
		//『真実』がただ蓄積されていく。
