	}
	talk ローズ 標準 -m {
		[P037_01_R01_スネークの遺体１無線デモ１＿１__e:ローズ_014]
		//そうね。でも彼は今回の主犯ではない。
	}
	@rpd_大佐顔表示
@rp_無茶指令＿否１＿お前がやれ系デフォルト 100
@rp_うなづきデフォルト＿是
	talk 大佐 標準 -m {
		[P037_01_R01_スネークの遺体１無線デモ１＿１__e:大佐_015]
