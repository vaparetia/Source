		[P012_02_R01_フォーチュン遭遇２無線デモ１＿１__e:大佐_013]
		//それもある。だが同様に警戒すべき
		//なのは『ビッグ・シェル』が爆破される
		//可能性だ。
	}

@rp_うなづきデフォルト＿是
@rp_うんちく＿否３＿わかってんのか系デフォルト 80

	talk 大佐 標準 -m {
		[P012_02_R01_フォーチュン遭遇２無線デモ１＿１__e:大佐_014]
		//爆破によって発生する有毒物質が
		//周辺海域一帯に拡散すれば、湾内だけで
		//なく沿岸部への影響も計り知れない。
	}
	talk 大佐 標準 -m {
		[P012_02_R01_フォーチュン遭遇２無線デモ１＿１__e:大佐_015]
		//環境回復には何世代もかかる。
	}
	talk ライデン 標準 -m {
		[P012_02_R01_フォーチュン遭遇２無線デモ１＿１__e:ライデン_016]
		//……。
	}
	talk 大佐 標準 -m {
		[P012_02_R01_フォーチュン遭遇２無線デモ１＿１__e:大佐_017]
		//ライデン、作戦を変更する。
		//大統領の救出は後回しだ。	
	}
	talk 大佐 標準 -m {
		[P012_02_R01_フォーチュン遭遇２無線デモ１＿１__e:大佐_018]
		//彼らが『ビッグ・シェル』に仕掛けた
		//Ｃ４を除去してくれ。一刻も早くな。	
	}

	talk 大佐 標準 -m {
		[P012_02_R01_フォーチュン遭遇２無線デモ１＿１__e:大佐_018_1]
		//彼らが『ビッグ・シェル』に仕掛けた
		//Ｃ４を除去してくれ。一刻も早くな。	
	}

@rp_うなづきデフォルト＿是
@rp_無茶指令＿否１＿お前がやれ系デフォルト 100

	talk ライデン 標準 -m {
		[P012_02_R01_フォーチュン遭遇２無線デモ１＿１__e:ライデン_019]
		//……大佐、俺には爆弾処理の経験はない。
	}
	talk 大佐 標準 -m {
		[P012_02_R01_フォーチュン遭遇２無線デモ１＿１__e:大佐_020]
		//ブラボー・チームと共に爆弾処理の
		//教官が降下している。ＳＥＡＬ１０の
		//作戦ではＣ脚に残ることになっていた。	
	}
	talk 大佐 標準 -m {
		[P012_02_R01_フォーチュン遭遇２無線デモ１＿１__e:大佐_021]
		//まだそこにいるだろう。
	}
	talk ライデン 標準 -m {
		[P012_02_R01_フォーチュン遭遇２無線デモ１＿１__e:ライデン_022]
		//……これもシミュレーション通りなのか？	
	}

@rp_うなづきデフォルト＿是

	talk 大佐 標準 -m {
		[P012_02_R01_フォーチュン遭遇２無線デモ１＿１__e:大佐_023]
		//何を言っている？Ｃ脚に向かうんだ。
		//彼を探せ。
	}
	talk ライデン 標準 -m {
		[P012_02_R01_フォーチュン遭遇２無線デモ１＿１__e:ライデン_024]
		//……了解。だがその前に、ひとついいか？
	}

@rp_うなづきデフォルト

	talk 大佐 標準 -m {
		[P012_02_R01_フォーチュン遭遇２無線デモ１＿１__e:大佐_025]
		//なんだ？
	}
	talk ライデン 標準 -m {
		[P012_02_R01_フォーチュン遭遇２無線デモ１＿１__e:ライデン_026]
		//奴等は、デッドセルは何者なんだ？
	}
	talk ライデン 標準 -m {
		[P012_02_R01_フォーチュン遭遇２無線デモ１＿１__e:ライデン_027]
		//あの女、弾が当たらなかった……。
	}
	talk ライデン 標準 -m {
		[P012_02_R01_フォーチュン遭遇２無線デモ１＿１__e:ライデン_028]
		//さっきの吸血鬼といい……。
	}
	talk ライデン 標準 -m {
		[P012_02_R01_フォーチュン遭遇２無線デモ１＿１__e:ライデン_029]
		//そう、悪夢をみているようだ。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
	talk ローズ 標準 -m {
		[P012_02_R01_フォーチュン遭遇２無線デモ１＿１__e:ローズ_030]
		//ジャック、しっかりして！
	}

@rp_うなづきデフォルト

	talk ライデン 標準 -m {
		[P012_02_R01_フォーチュン遭遇２無線デモ１＿１__e:ライデン_031]
		//ああローズ。君がこのミッションに
		//参加している事も信じられない。
		//いつ目が醒めるかと……。
	}
	@rpd_大佐顔表示
	talk 大佐 標準 -m {
		[P012_02_R01_フォーチュン遭遇２無線デモ１＿１__e:大佐_032]
		//ライデン、これは現実だ。
		//目が覚める事はない。
	}
	talk ライデン 標準 -m {
		[P012_02_R01_フォーチュン遭遇２無線デモ１＿１__e:ライデン_033]
		//あまりにも全てが現実離れしている。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
	talk ローズ 標準 -m {
		[P012_02_R01_フォーチュン遭遇２無線デモ１＿１__e:ローズ_034]
		//私は……私は覚悟を決めた。
		//悪夢でも現実でも、私はあなたを見てる。
		//最後まで。
	}
	talk ローズ 標準 -m {
		[P012_02_R01_フォーチュン遭遇２無線デモ１＿１__e:ローズ_034_1]
		//私は……私は覚悟を決めた。
		//悪夢でも現実でも、私はあなたを見てる。
		//最後まで。
	}
	talk ライデン 標準 -m {
		[P012_02_R01_フォーチュン遭遇２無線デモ１＿１__e:ライデン_035]
		//わかったよ。
		//君だけは、ローズだけは夢であって
		//欲しくないものだ。
	}
	@rpd_大佐顔表示

@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P012_02_R01_フォーチュン遭遇２無線デモ１＿１__e:大佐_036]
		//話はすんだか？
		//ならばＣ脚へ向かってくれ。
	}
}//v
}//d





