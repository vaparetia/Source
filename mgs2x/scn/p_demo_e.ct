	}
	talk ローズ 標準 -m {
		[P073_01_R01_通路Ａ１無線機デモ１＿１__e:ローズ_032]
		//私には、それが辛かった。
		//それが悲しかった。
		//私は疑似恋愛を強いられたの。
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 50
	talk ローズ 標準 -m {
		[P073_01_R01_通路Ａ１無線機デモ１＿１__e:ローズ_033]
		//あなたを騙し続ける事よりも……
