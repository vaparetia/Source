		//それは私のクリアランスでは
		//近づくことはできない。
		//そのメンバーの中心人物がエマだった。
	}
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_026_1]
		//それは私のクリアランスでは
		//近づくことはできない。
		//そのメンバーの中心人物がエマだった。
	}
@rp_うなづきデフォルト＿是
@rp_うんちく＿否＿話分からん系デフォルト 100
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_027]
		//彼女の専門はあくまで人工知能と複雑性
		//理論だったが、既にコンピュータの天才
		//として一目を置かれる存在になっていた。
	}
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_027_1]
		//彼女の専門はあくまで人工知能と複雑性
		//理論だったが、既にコンピュータの天才
		//として一目を置かれる存在になっていた。
	}
	talk ライデン 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:ライデン_028]
		//で、世界中の諜報機関が彼女をスカウト
		//した。いつもの汚いやり方で？
	}
	talk ライデン 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:ライデン_028_1]
		//で、世界中の諜報機関が彼女をスカウト
		//した。いつもの汚いやり方で？
	}
	talk ライデン 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:ライデン_028_2]
		//で、世界中の諜報機関が彼女をスカウト
		//した。いつもの汚いやり方で？
	}
	talk ライデン 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:ライデン_028_3]
		//で、世界中の諜報機関が彼女をスカウト
		//した。いつもの汚いやり方で？
	}
@rp_うなづきデフォルト＿是
@rp_邪道外道＿否２＿ひどい系デフォルト 100
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_029]
		//あまり違いはない。政府は彼女の弱みを
		//探した。
	}
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_030]
		//彼女の弱みは……６歳の時に別れた兄、
		//ハル・エメリッヒへの想いだった。
	}
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_031]
		//それも強烈な恨みだ。
	}

// 0817追加。このファイルが長くなった。
	talk ライデン 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:ライデン_032]
		//恨み？
	}
@rp_うなづきデフォルト＿是
@rp_邪道外道＿否２＿ひどい系デフォルト 100
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_033]
		//彼女が６歳の時に事故があった。エマと父親がプールで溺れた。父親は助からず、溺死した。
	}
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_033_1]
		//彼女が６歳の時に事故があった。エマと父親がプールで溺れた。父親は助からず、溺死した。
	}
	talk ライデン 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:ライデン_034]
		//警察は？
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_035]
		//当時の警察は事故として処理している。
	}
	talk ライデン 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:ライデン_036]
		//オタコンが家を出たのはその直後なのか？
	}
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿１__e:大佐_037]
		//そうだ。何があったかはわからんが……。
	}
	talk ライデン 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿２__e:ライデン_000]
		//エマは事故の原因を？
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿２__e:大佐_001]
		//いや、エマは兄に見捨てられたと
		//思っているようだ。
	}
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿２__e:大佐_002]
		//それまでは連れ子同士にもかかわらず、
		//非常に仲のいいきょうだい兄妹だった
		//らしい。
	}
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿２__e:大佐_003]
		//彼女がクラッカーまがいの行為を
		//行なっていたのも、兄への対抗意識
		//だったのだろう……。
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿２__e:大佐_004]
		//そして４年前、政府はシャドーモセスの
		//事件の真実を彼女にリークし、ＮＳＡへ
		//入ることに同意させた。
	}
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿２__e:大佐_004_1]
		//そして４年前、政府はシャドーモセスの
		//事件の真実を彼女にリークし、ＮＳＡへ
		//入ることに同意させた。
	}
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿２__e:大佐_005]
		//例のハッキングの件も保険として、
		//脅迫材料に入っていたに違いない。
	}
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿２__e:大佐_005_1]
		//例のハッキングの件も保険として、
		//脅迫材料に入っていたに違いない。
	}
	talk ライデン 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿２__e:ライデン_006]
		//オタコン達に濡れ衣をかぶせたのも、
		//そういう理由か？	
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P051_01_R01_エマとオタコン１無線機デモ１＿２__e:大佐_007]
		//それはわからん。
	}
	command セットサウンドコード -c d:SNG_FIN_S

}//v
}//d





