//resource P052_01_R01_ローズ無線１無線機デモ１＿１ 
proc vc115201:01  {
vox t:vc115201 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ローズ_000]
		//ジャック、聞いて？
	}
	talk ライデン 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ライデン_001]
		//どうした？
	}

	command セットサウンドコード -c d:SNG_FOUTP_M

@rp_キテレツさん＿否１＿なんだこいつ系デフォルト 100
	talk ローズ 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ローズ_002]
		//私いつも独りだった……。
	}
	talk ライデン 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ライデン_003]
		//？
	}
	talk ローズ 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ローズ_004]
		//私、寂しかった……。
	}
	talk ライデン 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ライデン_005]
		//ローズ？
		//俺はいつも君と？
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
	talk ローズ 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ローズ_006]
		//違うわ……。
	}
	talk ライデン 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ライデン_007]
		//違うって？
	}
	talk ローズ 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ローズ_008]
		//あなたは私と眠った事はなかった……。
	}
	talk ライデン 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ライデン_009]
		//何の話だ？
	}
	talk ローズ 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ローズ_010]
		//私の部屋で愛し合った後……
		//あなたはいつも朝まで起きているか、
		//帰っていくかのどちらかだった。
	}	
	talk ライデン 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ライデン_011]
		//こんな時に何を？
	}
	talk ローズ 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ローズ_012]
		//なぜなの？
		//ジャック？
	}
	talk ライデン 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ライデン_013]
		//ローズ？
		//任務中だ……。
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_セクハラ＿否２＿うっとおしい系デフォルト 100
	talk ローズ 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ローズ_014]
		//なぜなの？
		//私といると安らげないの？
	}
	talk ライデン 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ライデン_015]
		//任務中……。
	}
	talk ローズ 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ローズ_016]
		//どうして心をひら開いてくれないの？
	}
	talk ライデン 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ライデン_017]
		//違う。
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_セクハラ＿否１＿ワガママ系デフォルト 100
	talk ローズ 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ローズ_018]
		//夢を共有したい、
		//あなたと夜を過ごしたい。
	}
	talk ローズ 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ローズ_019]
		//そして朝を向かえたい。
		//ダメなの？
	}
	talk ライデン 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ライデン_020]
		//夜が……夜が怖いんだ。
		//君は関係ない。
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ローズ_021]
		//夜が怖いって……そんなの……。
	}
	talk ライデン 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ライデン_022]
		//人前で熟睡はできないんだ。
	}
	talk ローズ 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ローズ_023]
		//ジャック？
		//私があなたの部屋に入ることも嫌がった。
	}
	talk ライデン 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ライデン_024]
		//自分の生活を、邪魔されたくないんだ。
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_セクハラ＿否２＿うっとおしい系デフォルト 80
	talk ローズ 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ローズ_025]
		//邪魔だなんて？
	}
	talk ライデン 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ライデン_026]
		//いや、覗かれたくない。
	}
	talk ローズ 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ローズ_027]
		//憶えてる？
		//無理矢理あなたの部屋に押し入ったの？
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
	talk ローズ 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ローズ_028]
		//つきあい始めてもう１年も経っていた。あなたはもの凄く怒ったわ。
		//私に初めて手を挙げた。
	}
	talk ローズ 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ローズ_028_1]
		//つきあい始めてもう１年も経っていた。あなたはもの凄く怒ったわ。
		//私に初めて手を挙げた。
	}
	talk ライデン 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ライデン_029]
		//……。
	}
	talk ローズ 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ローズ_030]
		//あなたが心配だったの。
	}
	talk ライデン 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ライデン_031]
		//わるかった……。
	}
	talk ローズ 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ローズ_032]
		//いいえ、
		//私が怯えたのはあなたの暴力じゃない。
		//あなたの部屋……あなたの心の中……。
	}
	talk ライデン 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ライデン_033]
		//やめてくれ……。
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
	talk ローズ 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ローズ_034]
		//何もない部屋だった。
		//ベッドと小さな机が一つ。
		//まるで、刑務所の独房のようだった。
	}
	talk ライデン 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ライデン_035]
		//ローズ？
	}
	talk ローズ 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ローズ_036]
		//家族の写真もポスターも、
		//テレビさえもなかった。
	}
	talk ライデン 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ライデン_037]
		//ただ寝るだけの部屋だ……。
	}
	talk ローズ 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ローズ_038]
		//生活感のない部屋、
		//実体のないあなた……。
	}
	talk ライデン 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ライデン_039]
		//だから、君には来て欲しくなかったんだ。
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
	talk ローズ 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ローズ_040]
		//あなたの部屋を見て……
		//あなたがわからなくなった。
	}
	talk ライデン 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ライデン_041]
		//君の写真が飾ってあればよかったのか？
	}
	talk ローズ 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ローズ_042]
		//いいえ、そんな意味じゃない。
	}
	talk ライデン 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ライデン_043]
		//ローズ、後で話し合おう……。
		//この任務が終わったら。
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
	talk ローズ 標準 -m {
		[P052_01_R01_ローズ無線１無線機デモ１＿１__e:ローズ_044]
		//……ええ……そうね。わかったわ。
	}
	command セットサウンドコード -c d:SNG_FIN_S

}//v
}//d



//resource P053_01_R01_息継ぎ１無線機デモ１＿１ 
proc vc115301:01  {
vox t:vc115301 {
	talk オタコン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿１__e:オタコン_000]
		//ライデン、聞こえる？
		//僕だよ。そっちの状況はどうだい？
	}
	talk ライデン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿１__e:ライデン_001]
		//浸水がひどい。
		//汲み上げた海水が流れ込んで来ている。
	}
	talk ライデン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿１__e:ライデン_001_1]
		//浸水がひどい。
		//汲み上げた海水が流れ込んで来ている。
	}
	talk オタコン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿１__e:オタコン_002]
		//そうか、やっぱり……ＥＥの事だけど、
		//どうしても言っておきたい事がある。	
	}
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿１__e:ライデン_003]
		//心配するな、彼女は助ける。
	}
	talk オタコン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿１__e:オタコン_004]
		//彼女、水が苦手なんだ。
	}
	talk ライデン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿１__e:ライデン_005]
		//水が？
	}
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿１__e:オタコン_006]
		//ああ……６歳の時に、家のプールで
		//溺れたんだ。僕の親父と一緒に。
	}
	talk ライデン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿１__e:ライデン_007]
		//泳げなかったのか？
	}
	talk オタコン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿１__e:オタコン_008]
		//そうじゃない。泳ぎは得意だった。
		//よく二人で泳ぎに行った……。
		//あの事故が起こるまではね。
	}
	talk オタコン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿１__e:オタコン_008_1]
		//そうじゃない。泳ぎは得意だった。
		//よく二人で泳ぎに行った……。
		//あの事故が起こるまではね。
	}
}//v
}//d


//大佐の説明を聞いている人のみ
//resource P053_01_R01_息継ぎ１無線機デモ１＿２ 
proc vc115302:01  {
vox t:vc115302 {
	talk ライデン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿２__e:ライデン_000]
		//……やはり、大佐の話は本当だったのか。
	}
}//v
}//d

//resource P053_01_R01_息継ぎ１無線機デモ１＿３ 
proc vc115303:01  {
vox t:vc115303 {

@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿３__e:オタコン_000]
		//僕はあの時、自分の部屋にいた。
		//……ＥＥはずっと僕に助けを……
		//呼んでたらしい。
	}
	talk オタコン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿３__e:オタコン_001]
		//お兄ちゃんが助けてくれる、
		//お兄ちゃんなら……。
	}
@rp_うなづきデフォルト＿是
@rp_邪道外道＿否２＿ひどい系デフォルト 100
	talk オタコン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿３__e:オタコン_002]
		//僕の部屋からはプールがよく見えたんだ。
		//……でも僕は気づかなかった。
	}
	talk ライデン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿３__e:ライデン_003]
		//何してたんだ？
	}
	talk オタコン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿３__e:オタコン_004]
		//その時、僕は……。
	}
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿３__e:ライデン_005]
		//エマは助かったんだろう？
	}
	talk オタコン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿３__e:オタコン_006]
		//ああ、幸いね。
		//親父は助からなかったけど……。
	}
	talk ライデン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿３__e:ライデン_007]
		//あんたはその事で、自分を責め……
		//家を出た？
	}
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿３__e:オタコン_008]
		//いや、そうじゃないが、
		//彼女はそう思っているかもしれない。
		//僕はＥＥを裏切ったんだ。
	}
	talk ライデン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿３__e:ライデン_009]
		//それがトラウマになって、泳げないと？
	}
	talk オタコン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿３__e:オタコン_010]
		//ああ。
		//……あれから直接は会ってないけど……。
	}
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿３__e:オタコン_011]
		//彼女たちがイギリスに帰って、しばらく
		//してから手紙が来たんだ。母親のジュリー
		//から。
	}
	talk オタコン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿３__e:オタコン_012]
		//あれ以来、ＥＥが泳ぐ事がなくなった、
		//水着を着ることもなくなったって。	
	}
	talk オタコン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿３__e:オタコン_012_1]
		//あれ以来、ＥＥが泳ぐ事がなくなった、
		//水着を着ることもなくなったって。	
	}
	talk ライデン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿３__e:ライデン_013]
		//そのトラウマが生きているとすると、
		//まずいな。中央棟のＢ１はほとんど
		//浸水している。
	}
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿３__e:オタコン_014]
		//なんとか彼女を勇気づけてやってくれ。
	}
	talk ライデン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿３__e:ライデン_015]
		//こっちが勇気づけて欲しい
		//状況なんだが……。
	}
	talk オタコン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿３__e:オタコン_016]
		//カモフの修理にまだ時間がかかる。
	}
	@rpd_プリスキン顔表示
@rp_うなづきデフォルト＿是
@rp_無茶指令＿否１＿お前がやれ系デフォルト 100
	talk プリスキン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿３__e:プリスキン_017]
		//悪いが手が離せない。エマの事は頼む。
	}
	talk ライデン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿３__e:ライデン_018]
		//水中でのミッションは初めてなんだが。なんとかやってみる。
	}
	talk プリスキン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿３__e:プリスキン_019]
		//今のうちにマップを頭にたたき込んで
		//おくことだ。エマを連れて進む事になる。
	}
	talk プリスキン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿３__e:プリスキン_019_1]
		//今のうちにマップを頭にたたき込んで
		//おくことだ。エマを連れて進む事になる。
	}
	@rpd_オタコン顔表示
	talk オタコン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿３__e:オタコン_020]
		//頼むよ。
	}
@rp_うなづきデフォルト
	@rpd_プリスキン顔表示
	talk プリスキン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿３__e:プリスキン_021]
		//中央棟は俺の方が詳しい。Ｃ４解除で
		//一通り、回ったからな。何か聞きたい
		//ことがあれば無線連絡をくれ。
	}
	talk プリスキン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿３__e:プリスキン_021_1]
		//中央棟は俺の方が詳しい。Ｃ４解除で
		//一通り、回ったからな。何か聞きたい
		//ことがあれば無線連絡をくれ。
	}
	talk ライデン 標準 -m {
		[P053_01_R01_息継ぎ１無線機デモ１＿３__e:ライデン_022]
		//わかった。
	}
}//v
}//d



//resource P057_02_R01_ヴァンプ戦終了２無線機デモ１＿１ 
proc  vc115701:01  {
vox t:vc115701 {
	talk ライデン 標準 -m {
		[P057_02_R01_ヴァンプ戦終了２無線機デモ１＿１__e:ライデン_000]
		//大佐、アーセナルギアの最終チェックが
		//終わったらしい！
	}
@rp_うなづきデフォルト＿是
@rp_無茶指令＿否１＿お前がやれ系デフォルト 100
	talk 大佐 標準 -m {
		[P057_02_R01_ヴァンプ戦終了２無線機デモ１＿１__e:大佐_001]
		//早くエマを助け出せ。
		//彼女に大統領からもらったウィルスを
		//入力させるんだ。
	}
	talk 大佐 標準 -m {
		[P057_02_R01_ヴァンプ戦終了２無線機デモ１＿１__e:大佐_001_1]
		//早くエマを助け出せ。
		//彼女に大統領からもらったウィルスを
		//入力させるんだ。
	}
	talk 大佐 標準 -m {
		[P057_02_R01_ヴァンプ戦終了２無線機デモ１＿１__e:大佐_002]
		//彼女を救出してシェル１中央棟Ｂ２の
		//電算室へ連れて行け。	
	}
}//v
}//d

//スネークに無線機ＳＥＮＤ（周波数変更）
//resource P057_02_R01_ヴァンプ戦終了２無線機デモ１＿２ 
proc vc115702:01  {
vox t:vc115702 {
	talk ライデン 標準 -m {
		[P057_02_R01_ヴァンプ戦終了２無線機デモ１＿２__e:ライデン_000]
		//スネーク、聞こえたか？
		//間に合わなかった。
		//アーセナルが動き出す！
	}
@rp_うなづきデフォルト＿是
@rp_邪道外道＿否２＿ひどい系デフォルト 100
	talk プリスキン 標準 -m {
		[P057_02_R01_ヴァンプ戦終了２無線機デモ１＿２__e:プリスキン_001]
		//ああ、聞こえた。
		//人質の救出は後回しだ。
	}
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		[P057_02_R01_ヴァンプ戦終了２無線機デモ１＿２__e:ライデン_002]
		//俺はエマを助け出す。
	}
	talk プリスキン 標準 -m {
		[P057_02_R01_ヴァンプ戦終了２無線機デモ１＿２__e:プリスキン_003]
		//わかった。
		//俺達は電算室を確保する。
	}
}//v
}//d

//無線機の小画面に大統領がＭＯを渡す映像が映る
//resource P057_02_R01_ヴァンプ戦終了２無線機デモ１＿３ 
proc vc115703:01  {
vox t:vc115703 {
	talk プリスキン 標準 -m {
		[P057_02_R01_ヴァンプ戦終了２無線機デモ１＿３__e:プリスキン_000]
		//やはりエマでなければウィルスを
		//侵入させることは出来ないらしい。
	}
	talk ライデン 標準 -m {
		[P057_02_R01_ヴァンプ戦終了２無線機デモ１＿３__e:ライデン_001]
		//あんたの相棒でも駄目なのか？
	}
	@rpd_オタコン顔表示
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		[P057_02_R01_ヴァンプ戦終了２無線機デモ１＿３__e:オタコン_002]
		//出来ればやってる。
		//ここのセキュリティはよく出来てるよ。
		//短時間じゃちょっと手が出せない……。
	}
	@rpd_プリスキン顔表示
	talk プリスキン 標準 -m {
		[P057_02_R01_ヴァンプ戦終了２無線機デモ１＿３__e:プリスキン_003]
		//そういうことだ。
		//エマを連れてきてくれ。
	}
	talk ライデン 標準 -m {
		[P057_02_R01_ヴァンプ戦終了２無線機デモ１＿３__e:ライデン_004]
		//わかった。安心してくれ。
		//ちゃんと兄妹を対面させてみせるさ。
	}
@rp_かみあわない＿否１＿話聞けよ系デフォルト 100
	@rpd_オタコン顔表示
	talk オタコン 標準 -m {
		[P057_02_R01_ヴァンプ戦終了２無線機デモ１＿３__e:オタコン_005]
		//……。
	}
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		[P057_02_R01_ヴァンプ戦終了２無線機デモ１＿３__e:ライデン_006]
		//どうした？
	}
	talk オタコン 標準 -m {
		[P057_02_R01_ヴァンプ戦終了２無線機デモ１＿３__e:オタコン_007]
		//……ＥＥとは長い間、会ってないんだ。
	}
	talk ライデン 標準 -m {
		[P057_02_R01_ヴァンプ戦終了２無線機デモ１＿３__e:ライデン_008]
		//だからすぐ会えるじゃないか。
	}
	talk オタコン 標準 -m {
		[P057_02_R01_ヴァンプ戦終了２無線機デモ１＿３__e:オタコン_009]
		//いや、僕には彼女に逢う資格はないんだ。
	}
	@rpd_プリスキン顔表示
@rp_うなづきデフォルト
	talk プリスキン 標準 -m {
		[P057_02_R01_ヴァンプ戦終了２無線機デモ１＿３__e:プリスキン_010]
		//事情があるようだが、時間がない。
		//エマはその部屋の北にある
		//ロッカールームだろう？
	}
	talk プリスキン 標準 -m {
		[P057_02_R01_ヴァンプ戦終了２無線機デモ１＿３__e:プリスキン_011]
		//ライデン、頼むぞ。
	}
	talk ライデン 標準 -m {
		[P057_02_R01_ヴァンプ戦終了２無線機デモ１＿３__e:ライデン_012]
		//わかった。
	}
}//v
}//d



//resource P058_02_R01_エマ救出２無線機デモ１＿１ 
proc vc115801:01  {
vox t:vc115801 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ライデン 標準 -m {
		[P058_02_R01_エマ救出２無線機デモ１＿１__e:ライデン_000]
		//聞こえるか？
	}
	talk エマ 標準 -m {
		[P058_02_R01_エマ救出２無線機デモ１＿１__e:エマ_001]
		//体内通信？
	}
	talk ライデン 標準 -m {
		[P058_02_R01_エマ救出２無線機デモ１＿１__e:ライデン_002]
		//そうだ、俺の体内にもナノマシンが
		//注入されている。
	}
@rp_うなづきデフォルト＿否
	talk エマ 標準 -m {
		[P058_02_R01_エマ救出２無線機デモ１＿１__e:エマ_003]
		//あいつらとは違う……？
	}
	talk ライデン 標準 -m {
		[P058_02_R01_エマ救出２無線機デモ１＿１__e:ライデン_004]
		//そういう事だ。
	}
	talk エマ 標準 -m {
		[P058_02_R01_エマ救出２無線機デモ１＿１__e:エマ_005]
		//で、私を助けるのが任務？
	}
	talk ライデン 標準 -m {
		[P058_02_R01_エマ救出２無線機デモ１＿１__e:ライデン_006]
		//俺はアーセナルを止めに来たんだ。
		//協力してほしい。あれを止められるのは
		//君しかいないと聞いた。
	}
	talk ライデン 標準 -m {
		[P058_02_R01_エマ救出２無線機デモ１＿１__e:ライデン_006_1]
		//俺はアーセナルを止めに来たんだ。
		//協力してほしい。あれを止められるのは
		//君しかいないと聞いた。
	}
	talk エマ 標準 -m {
		[P058_02_R01_エマ救出２無線機デモ１＿１__e:エマ_007]
		//……誰からそんなことを？
	}
@rp_うなづきデフォルト＿否
	talk ライデン 標準 -m {
		[P058_02_R01_エマ救出２無線機デモ１＿１__e:ライデン_008]
		//大統領。
	}
	talk エマ 標準 -m {
		[P058_02_R01_エマ救出２無線機デモ１＿１__e:エマ_009]
		//……ホントに？
	}
	talk ライデン 標準 -m {
		[P058_02_R01_エマ救出２無線機デモ１＿１__e:ライデン_010]
		//一緒にシェル１に来てくれ。
		//君のお兄さんが待ってる。
	}
//振動ちょーちょうせい
vibplay ema_rescue
	talk エマ 標準 -m {
		[P058_02_R01_エマ救出２無線機デモ１＿１__e:エマ_011]
		//お兄ちゃん？
	}
	talk ライデン 標準 -m {
		[P058_02_R01_エマ救出２無線機デモ１＿１__e:ライデン_012]
		//とにかく、ここを出よう！
	}
	talk ライデン 標準 -m {
		[P058_02_R01_エマ救出２無線機デモ１＿１__e:ライデン_013]
		//いつ浸水するかわからない。
	}
}//v
}//d



//resource P058_04_R02_エマ救出４無線機デモ２＿１ 
proc vc115811:01  {
vox t:vc115811 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk エマ 標準 -m {
		[P058_04_R02_エマ救出４無線機デモ２＿１__e:エマ_000]
		//だから、ここに……。
	}
	talk ライデン 標準 -m {
		[P058_04_R02_エマ救出４無線機デモ２＿１__e:ライデン_001]
		//	泳げないんじゃない！
		//エマ、君は泳げたんだ！
	}
	talk エマ 標準 -m {
		[P058_04_R02_エマ救出４無線機デモ２＿１__e:エマ_002]
		//どうして、そのことを？
	}
	talk ライデン 標準 -m {
		[P058_04_R02_エマ救出４無線機デモ２＿１__e:ライデン_003]
		//君のお兄さんに聞いた。
	}
@rp_うなづきデフォルト＿否
	talk エマ 標準 -m {
		[P058_04_R02_エマ救出４無線機デモ２＿１__e:エマ_004]
		//本当に、ここに？
	}
	talk ライデン 標準 -m {
		[P058_04_R02_エマ救出４無線機デモ２＿１__e:ライデン_005]
		//ああ。君を助ける為に。
	}
@rp_セクハラ＿否１＿ワガママ系デフォルト 100
	talk エマ 標準 -m {
		[P058_04_R02_エマ救出４無線機デモ２＿１__e:エマ_006]
		//ウソよ。
		//あの男がそんな事をするはずない！
	}	
	talk ライデン 標準 -m {
		[P058_04_R02_エマ救出４無線機デモ２＿１__e:ライデン_007]
		//ウソじゃない。
		//シェル１で君が来るのを待っている。
	}
	talk エマ 標準 -m {
		[P058_04_R02_エマ救出４無線機デモ２＿１__e:エマ_008]
		//信じられない！
		//あの男は私を捨てたの。
		//私達親子をね。
	}
	talk エマ 標準 -m {
		[P058_04_R02_エマ救出４無線機デモ２＿１__e:エマ_009]
		//父が死んだ、一番辛い時に。
		//あいつは自分だけ……。
	}
	talk ライデン 標準 -m {
		[P058_04_R02_エマ救出４無線機デモ２＿１__e:ライデン_010]
		//エマ、恨み言は後でいくらでも聞く。
		//ここから離れよう！
	}
	talk エマ 標準 -m {
		[P058_04_R02_エマ救出４無線機デモ２＿１__e:エマ_011]
		//嫌っ！
		//水は嫌い！
	}
	talk エマ 標準 -m {
		[P058_04_R02_エマ救出４無線機デモ２＿１__e:エマ_012]
		//無理よ！泳げないっ！
	}
}//v
}//d



