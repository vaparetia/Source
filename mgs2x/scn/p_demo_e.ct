//resource P070_18_R02_ＡＧ起動１８無線機デモ２＿１ 
proc vc117011:01  {
vox t:vc117011 {

@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否

	talk ライデン 標準 -m {
		[P070_18_R02_ＡＧ起動１８無線機デモ２＿１__e:ライデン_000]
		//ミスターＸも忍者も……。
	}
	talk オルガ 標準 -m {
		[P070_18_R02_ＡＧ起動１８無線機デモ２＿１__e:オルガ_001]
		//そう、私。
	}
	talk ライデン 標準 -m {
		[P070_18_R02_ＡＧ起動１８無線機デモ２＿１__e:ライデン_002]
		//君はロシア兵のリーダー
		//じゃなかったのか？
	}
@rp_うなづきデフォルト＿否
	talk オルガ 標準 -m {
		[P070_18_R02_ＡＧ起動１８無線機デモ２＿１__e:オルガ_003]
		//……いいえ。
		//それは表向きの役割……。
	}
	talk ライデン 標準 -m {
		[P070_18_R02_ＡＧ起動１８無線機デモ２＿１__e:ライデン_004]
		//表向き？
	}	
	talk オルガ 標準 -m {
		[P070_18_R02_ＡＧ起動１８無線機デモ２＿１__e:オルガ_005]
		//ええ……
		//本当の役割はあなたのサポート……。	
	}
	talk ライデン 標準 -m {
		[P070_18_R02_ＡＧ起動１８無線機デモ２＿１__e:ライデン_006]
		//俺のサポート？
		//誰の命令で？
		//	大佐か？
	}
@rp_うなづきデフォルト＿否
	talk オルガ 標準 -m {
		[P070_18_R02_ＡＧ起動１８無線機デモ２＿１__e:オルガ_007]
		//いいえ……『愛国者達』。
	}
	talk ライデン 標準 -m {
		[P070_18_R02_ＡＧ起動１８無線機デモ２＿１__e:ライデン_008]
		//なんだって！？
	}
	talk オルガ 標準 -m {
		[P070_18_R02_ＡＧ起動１８無線機デモ２＿１__e:オルガ_009]
		//私は……部隊の皆を騙し、裏切っている。
	}
	talk ライデン 標準 -m {
		[P070_18_R02_ＡＧ起動１８無線機デモ２＿１__e:ライデン_010]
		//どういうことなんだ……？
	}
	talk オルガ 標準 -m {
		[P070_18_R02_ＡＧ起動１８無線機デモ２＿１__e:オルガ_011]
		//……子供が……
		//『愛国者達』に捕らわれているの……。
	}
@rp_うなづきデフォルト＿否
	talk オルガ 標準 -m {
		[P070_18_R02_ＡＧ起動１８無線機デモ２＿１__e:オルガ_012]
		//二年前、あのタンカーと一緒に父を
		//失った後……。
	}
	talk オルガ 標準 -m {
		[P070_18_R02_ＡＧ起動１８無線機デモ２＿１__e:オルガ_013]
		//行くところのない私達はロシアと
		//つながりのある非合法組織に拾われた。
	}
	talk ライデン 標準 -m {
		[P070_18_R02_ＡＧ起動１８無線機デモ２＿１__e:ライデン_014]
		//マフィア？
	}
	talk オルガ 標準 -m {
		[P070_18_R02_ＡＧ起動１８無線機デモ２＿１__e:オルガ_015]
		//そう呼んでも良い。
		//だけどそこが『愛国者達』の下部組織
		//だと知ったのはずっと後のことだった。
	}
	talk オルガ 標準 -m {
		[P070_18_R02_ＡＧ起動１８無線機デモ２＿１__e:オルガ_015_1]
		//そう呼んでも良い。
		//だけどそこが『愛国者達』の下部組織
		//だと知ったのはずっと後のことだった。
	}
@rp_うなづきデフォルト＿否
	talk オルガ 標準 -m {
		[P070_18_R02_ＡＧ起動１８無線機デモ２＿１__e:オルガ_016]
		//身重だった私は、何も知らずに奴等の
		//病院で子供を生んだ。
	}
	talk オルガ 標準 -m {
		[P070_18_R02_ＡＧ起動１８無線機デモ２＿１__e:オルガ_016_1]
		//身重だった私は、何も知らずに奴等の
		//病院で子供を生んだ。
	}
@rp_邪道外道＿否２＿ひどい系デフォルト 100
	talk オルガ 標準 -m {
		[P070_18_R02_ＡＧ起動１８無線機デモ２＿１__e:オルガ_017]
		//目が覚めた時はもう……あの子は奴等に
		//奪われていた。今もこの国の何処かで
		//暮らしている。
	}
	talk ライデン 標準 -m {
		[P070_18_R02_ＡＧ起動１８無線機デモ２＿１__e:ライデン_018]
		//会った事は？
	}
	talk オルガ 標準 -m {
		[P070_18_R02_ＡＧ起動１８無線機デモ２＿１__e:オルガ_019]
		//ないわ。月に一度、ネッワーク経由で
		//映像が送られてくる。私はまだあの子を
		//この手に抱いたことはない。
	}
	talk オルガ 標準 -m {
		[P070_18_R02_ＡＧ起動１８無線機デモ２＿１__e:オルガ_019_1]
		//ないわ。月に一度、ネッワーク経由で
		//映像が送られてくる。私はまだあの子を
		//この手に抱いたことはない。
	}
	talk ライデン 標準 -m {
		[P070_18_R02_ＡＧ起動１８無線機デモ２＿１__e:ライデン_020]
		//……そうか……。
	}
@rp_うなづきデフォルト＿否
	talk ライデン 標準 -m {
		[P070_18_R02_ＡＧ起動１８無線機デモ２＿１__e:ライデン_021]
		//そういう事情なら……仕方ないさ。
		//誰も君を責められない……。
	}
	talk オルガ 標準 -m {
		[P070_18_R02_ＡＧ起動１８無線機デモ２＿１__e:オルガ_022]
		//……そうかしら……。
	}
	talk ライデン 標準 -m {
		[P070_18_R02_ＡＧ起動１８無線機デモ２＿１__e:ライデン_023]
		//……スネークとは？
		//彼とは敵対していたんじゃ？
	}
	talk オルガ 標準 -m {
		[P070_18_R02_ＡＧ起動１８無線機デモ２＿１__e:オルガ_024]
		//彼等は父の仇じゃなかった……
		//命の恩人だったのよ。
	}
}//v
}//d



//resource P070_20_R03_ＡＧ起動２０無線機デモ３＿１ 
proc vc117021:01  {
vox t:vc117021 {

@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否

	talk ライデン 標準 -m {
		[P070_20_R03_ＡＧ起動２０無線機デモ３＿１__e:ライデン_000]
		//手を組んだのは恩返しってわけか？
	}
	talk オルガ 標準 -m {
		[P070_20_R03_ＡＧ起動２０無線機デモ３＿１__e:オルガ_001]
		//いいえ。
		//相互利益のための協力ってところね。
	}
	talk ライデン 標準 -m {
		[P070_20_R03_ＡＧ起動２０無線機デモ３＿１__e:ライデン_002]
		//利益？
	}
@rp_うなづきデフォルト＿否
	talk オルガ 標準 -m {
		[P070_20_R03_ＡＧ起動２０無線機デモ３＿１__e:オルガ_003]
		//あなたをサポートすること。
		//それが私に課せられた役割。
	}
	talk オルガ 標準 -m {
		[P070_20_R03_ＡＧ起動２０無線機デモ３＿１__e:オルガ_004]
		//ソリダスがアーセナルを手に入れれば
		//あなたの任務も失敗。私も役割を果たせ
		//なかったと見なされる。
	}
	talk オルガ 標準 -m {
		[P070_20_R03_ＡＧ起動２０無線機デモ３＿１__e:オルガ_005]
		//……『愛国者達』はあの子を殺すわ。
		//だからあなた達を助けることがあの子を
		//助けることになる……。
	}
	talk オルガ 標準 -m {
		[P070_20_R03_ＡＧ起動２０無線機デモ３＿１__e:オルガ_005_1]
		//……『愛国者達』はあの子を殺すわ。
		//だからあなた達を助けることがあの子を
		//助けることになる……。
	}
	talk ライデン 標準 -m {
		[P070_20_R03_ＡＧ起動２０無線機デモ３＿１__e:ライデン_006]
		//全ては子供のため、か……
		//だがなぜ『愛国者達』が俺を助けようと
		//する？ソリダスを倒すためか？
	}
	talk ライデン 標準 -m {
		[P070_20_R03_ＡＧ起動２０無線機デモ３＿１__e:ライデン_006_1]
		//全ては子供のため、か……
		//だがなぜ『愛国者達』が俺を助けようと
		//する？ソリダスを倒すためか？
	}
@rp_うなづきデフォルト＿否
	talk オルガ 標準 -m {
		[P070_20_R03_ＡＧ起動２０無線機デモ３＿１__e:オルガ_007]
		//いいえ……あなたも私と同じ。
		//骨の髄まで利用されている……。
	}
	talk ライデン 標準 -m {
		[P070_20_R03_ＡＧ起動２０無線機デモ３＿１__e:ライデン_008]
		//何を言ってる？
	}
	talk オルガ 標準 -m {
		[P070_20_R03_ＡＧ起動２０無線機デモ３＿１__e:オルガ_009]
		//Ｓ３計画……。
	}
	talk ライデン 標準 -m {
		[P070_20_R03_ＡＧ起動２０無線機デモ３＿１__e:ライデン_010]
		//？
	}
@rp_かみあわない＿否１＿話聞けよ系デフォルト 100
	talk オルガ 標準 -m {
		[P070_20_R03_ＡＧ起動２０無線機デモ３＿１__e:オルガ_011]
		//いずれわかる……
		//その辛さを克服できるかどうか……。
	}
	talk ライデン 標準 -m {
		[P070_20_R03_ＡＧ起動２０無線機デモ３＿１__e:ライデン_012]
		//どういうことだ？
	}
	talk オルガ 標準 -m {
		[P070_20_R03_ＡＧ起動２０無線機デモ３＿１__e:オルガ_013]
		//時間がない。
		//ソリダスは今にも攻撃を開始する。
		//奴を止めなければ……。
	}
	talk オルガ 標準 -m {
		[P070_20_R03_ＡＧ起動２０無線機デモ３＿１__e:オルガ_013_1]
		//時間がない。
		//ソリダスは今にも攻撃を開始する。
		//奴を止めなければ……。
	}
	talk ライデン 標準 -m {
		[P070_20_R03_ＡＧ起動２０無線機デモ３＿１__e:ライデン_014]
		//ウィルスは？
	}
@rp_うなづきデフォルト＿否
	talk オルガ 標準 -m {
		[P070_20_R03_ＡＧ起動２０無線機デモ３＿１__e:オルガ_015]
		//まだ効果は現れてない。
		//やはり『愛国者達』が手を加えていた
		//ようね。
	}
	talk ライデン 標準 -m {
		[P070_20_R03_ＡＧ起動２０無線機デモ３＿１__e:ライデン_016]
		//効くのか？
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk オルガ 標準 -m {
		[P070_20_R03_ＡＧ起動２０無線機デモ３＿１__e:オルガ_017]
		//わからない……。
	}
	talk ライデン 標準 -m {
		[P070_20_R03_ＡＧ起動２０無線機デモ３＿１__e:ライデン_018]
		//これをはずしてくれ。
	}
@rp_邪道外道＿否２＿ひどい系デフォルト 100
	talk オルガ 標準 -m {
		[P070_20_R03_ＡＧ起動２０無線機デモ３＿１__e:オルガ_019]
		//今はできない。
		//私がここを出てから拘束を解除する。
	}
	talk ライデン 標準 -m {
		[P070_20_R03_ＡＧ起動２０無線機デモ３＿１__e:ライデン_020]
		//俺の装備は？
	}
@rp_うなづきデフォルト＿否
	talk オルガ 標準 -m {
		[P070_20_R03_ＡＧ起動２０無線機デモ３＿１__e:オルガ_021]
		//スネークに預けた。
		//ここでは渡せない。
	}
	talk ライデン 標準 -m {
		[P070_20_R03_ＡＧ起動２０無線機デモ３＿１__e:ライデン_022]
		//彼は何処に？
	}
}//v
}//d



//resource P070_23_R04_ＡＧ起動２３無線機デモ４＿１ 
proc vc117031:01  {
vox t:vc117031 {
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ローズ_000]
		//ジャック、大丈夫？
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_001]
		//あ、ああ……。
	}
	talk ローズ 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ローズ_002]
		//ジャック、ソリダスの話。
		//本当なの？
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_003]
		//……本当だ。
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ローズ_004]
		//信じられない。そんな事が……
		//子供を徴兵したり、戦闘グループに
		//参加させたりする事は禁られているはず。
	}
	talk ローズ 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ローズ_004_1]
		//信じられない。そんな事が……
		//子供を徴兵したり、戦闘グループに
		//参加させたりする事は禁られているはず。
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_005]
		//法律なんて、戦場での歯止めには
		//ならない。
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_006]
		//今現在も、戦闘に参加している子供は
		//３０万人以上もいる。
		//俺もそのうちの一人だった……。
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_006_1]
		//今現在も、戦闘に参加している子供は
		//３０万人以上もいる。
		//俺もそのうちの一人だった……。
	}
	talk ローズ 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ローズ_007]
		//憶えてたの？
		//記憶を操作されていたんじゃ？
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_008]
		//……いや。毎晩、うなされていた……
		//過去の断片に……。	
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_セクハラ＿否１＿ワガママ系デフォルト 100
	talk ローズ 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ローズ_009]
		//なぜ、今まで言ってくれなかったの？
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_010]
		//君に理解できるはずがない。
	}
	talk ローズ 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ローズ_011]
		//そんなの、言ってくれなきゃ、
		//分からないじゃない？
	}
	command セットサウンドコード -c d:SNG_FOUTP_M
	
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_012]
		//君を苦しめたくなかったんだ。
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ローズ_013]
		//……。
	}	
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_014]
		//俺には戦う理由などなかった。
		//物心ついた頃から、銃を握らされていた。
		//あいつだ、あの男（ソリダス）に……。
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_014_1]
		//俺には戦う理由などなかった。
		//物心ついた頃から、銃を握らされていた。
		//あいつだ、あの男（ソリダス）に……。
	}
	talk ローズ 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ローズ_015]
		//でも、それは罪じゃない。
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_016]
		//１日を戦えば、ほめられた。
		//食事にありつけた。
		//屋根のある寝床で安眠する事ができた。
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_017]
		//最初に＃｛銃、ＡＫ｝＃を握らされた時は
		//まだ６歳だった。
		//いや、年齢も定かではない。
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ローズ_018]
		//ジャック？
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_019]
		//俺はスネークとは違う。
		//戦いに疑問など感じた事などなかった。
		//目的があったわけでもない。
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_020]
		//出口のないトンネルをただ、
		//銃を突きつけられて歩く事を
		//強いられていただけだ。
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_021]
		//銃を取らない奴は、みんな殺された。
	}
	talk ローズ 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ローズ_022]
		//あなたを責めるつもりはない……。
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_023]
		//毎日、ハリウッドのアクション映画を
		//見せられた。マッチョな男が銃を持って
		//戦う映画だ。
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_024]
		//イメージトレーニングと言ってな。
		//かっとんＸＸＸ
		//ゲームもやらされた。
		//勿論、遊びじゃない。
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ローズ_025]
		//……。
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_026]
		//俺達は……造られた。
		//＃｛殺人、キリング｝＃マシーンとして。
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_027]
		//日に一度の食事にはガンパウダーが
		//混入されていた。
	}
	talk ローズ 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ローズ_028]
		//ガンパウダー？
		//火薬の事？
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_029]
		//そうだ、ガンパウダーには幻覚作用を
		//もたらすトルエン成分が含まれている。
		//麻薬漬けにされたんだ。
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_029_1]
		//そうだ、ガンパウダーには幻覚作用を
		//もたらすトルエン成分が含まれている。
		//麻薬漬けにされたんだ。
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ローズ_030]
		//そんな……。
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_031]
		//内戦が終わって、生き残った俺達は、
		//保護された。それからはこの国で……
		//さすがに衣食住に困ることはなかった。
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_031_1]
		//内戦が終わって、生き残った俺達は、
		//保護された。それからはこの国で……
		//さすがに衣食住に困ることはなかった。
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_032]
		//しかし、今も、何も変わっていない。
		//俺達の過去を黙認してくれるのは、
		//やはり闇の世界しかなかった。
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_032_1]
		//しかし、今も、何も変わっていない。
		//俺達の過去を黙認してくれるのは、
		//やはり闇の世界しかなかった。
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_033]
		//毎晩、うなされる。
		//忘れることはできない。
	}
	talk ローズ 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ローズ_034]
		//ジャック……。
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_035]
		//夜が怖い。
		//だから、君の隣りでは眠れない。
	}
	talk ローズ 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ローズ_036]
		//言って欲しかった……。
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_037]
		//何を？
		//俺が根っからの殺し屋だったって事か？
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ローズ_038]
		//そうじゃないわ。
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_039]
		//この世で一番憎むべきもの、
		//それは自分の過去だ。
		//誰にも知られたくはなかった。君にも。
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_039_1]
		//この世で一番憎むべきもの、
		//それは自分の過去だ。
		//誰にも知られたくはなかった。君にも。
	}
	talk ローズ 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ローズ_040]
		//……。
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_041]
		//だが、俺がこのミッションに選ばれた
		//理由がようやくわかったよ。
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_042]
		//あの男を倒すために……あの男を
		//倒すにはこの俺でなければならない。
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_043]
		//この日のために俺は奴らに生かされて
		//いたんだ。ソリダスに会って分かった。
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ローズ_044]
		//ジャック、信じて。
		//私、今のあなたが好き。
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_045]
		//……。
	}
@rp_セクハラ＿否２＿うっとおしい系デフォルト 100
	talk ローズ 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ローズ_046]
		//私、確かに……
		//あなたの事、何も知らなかった。
	}
	talk ローズ 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ローズ_047]
		//どこで生まれて、どう育ったか？
		//今日までね。
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
	talk ローズ 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ローズ_048]
		//でも、これから……もっとあなたを
		//好きになる。あなたの過去も受け止める。
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_049]
		//無理だ。他人が俺の過去を背負うこと
		//なんかできっこない。俺には恋人達が
		//語り合うような、楽しい過去はない。
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_049_1]
		//無理だ。他人が俺の過去を背負うこと
		//なんかできっこない。俺には恋人達が
		//語り合うような、楽しい過去はない。
	}
	talk ローズ 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ローズ_050]
		//みんなそうなのよ。楽しい事ばかりじゃ
		//ない。辛いことや悲しい事を共有する
		//から……ジャック、信じて。
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_051]
		//俺は、俺の過去を誰とも共有したくは
		//ない。ただ忘れたいんだ。	
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ローズ_052]
		//ジャック？
		//私もあなたに、自分の過去を……。	
	}
	talk ローズ 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ローズ_053]
		//……。
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_054]
		//ローズ、君と過ごした２年間は……
		//本当に楽しかった。
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ローズ_055]
		//ジャック？
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_056]
		//でも、そこまでだ。
		//それ以上は踏み込めない。	
	}	
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_057]
		//君が俺のプロポーズを心待ちにしていた
		//ことは知っている。
	}
	talk ローズ 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ローズ_058]
		//それは。
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_059]
		//でも……。
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_060]
		//俺には……できない。
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_061]
		//俺には家族を創ることはできない。
	}
	talk ライデン 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ライデン_062]
		//あの体験を白紙に戻すことはできない。
	}
	talk ローズ 標準 -m {
		[P070_23_R04_ＡＧ起動２３無線機デモ４＿１__e:ローズ_063]
		//ジャック、わかった。
		//それ以上、言わないで……。
	}
	command セットサウンドコード -c d:SNG_FIN_S

}//v
}//d


//resource P071_01_R01_拷問部屋脱出１無線機デモ１＿１ 
proc vc117102:01  {
//vox t:vc117101 
movie t:vc117102 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P071_01_R01_拷問部屋脱出１無線機デモ１＿１__e:大佐_000]
		//ライデン、いいか。
	}
@rp_キテレツさん＿否２＿意味不明系デフォルト 100
	talk 大佐 標準 -m {
		[P071_01_R01_拷問部屋脱出１無線機デモ１＿１__e:大佐_001]
		//に、任務、任務を続行しろ。
	}
	talk ライデン 標準 -m {
		[P071_01_R01_拷問部屋脱出１無線機デモ１＿１__e:ライデン_002]
		//装備がない。
		//スネークを探さなければ……。
	}
	talk 大佐 標準 -m {
		[P071_01_R01_拷問部屋脱出１無線機デモ１＿１__e:大佐_003]
		//あの男はシミュレーション要素には
		//入っていない。あの男にかまうな。
	}
	talk ライデン 標準 -m {
		[P071_01_R01_拷問部屋脱出１無線機デモ１＿１__e:ライデン_004]
		//裸ではどうしようもない。
		//ここはかなり室温が低い。
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P071_01_R01_拷問部屋脱出１無線機デモ１＿１__e:大佐_005]
		//そうだな。
		//その格好では攻撃もエルードもできない。
	}
	talk ライデン 標準 -m {
		[P071_01_R01_拷問部屋脱出１無線機デモ１＿１__e:ライデン_006]
		//装備はスネークが持っているらしい。
	}
	talk 大佐 標準 -m {
		[P071_01_R01_拷問部屋脱出１無線機デモ１＿１__e:大佐_007]
		//ライデン、ソリダス達を倒せ。
		//アーセナルを無傷で奪い返すんだ。
	}
}//v
}//d

proc vc117103:01  {
vox t:vc117103 {
	talk ライデン 標準 -m {
		[P071_01_R01_拷問部屋脱出１無線機デモ１＿１__e:ライデン_008]
		//大佐、あんたは『愛国者達』の命令で？
	}
@rp_うなづきデフォルト＿是
@rp_かみあわない＿否１＿話聞けよ系デフォルト 100
	talk 大佐 標準 -m {
		[P071_01_R01_拷問部屋脱出１無線機デモ１＿１__e:大佐_009]
		//君の今回の役割……
		//いや、任務は単独潜入して、
		//テロリストを武装解除し……。
	}
	talk ライデン 標準 -m {
		[P071_01_R01_拷問部屋脱出１無線機デモ１＿１__e:ライデン_010]
		//また役割か？
	}
	talk 大佐 標準 -m {
		[P071_01_R01_拷問部屋脱出１無線機デモ１＿１__e:大佐_011]
		//これは一種のロール・プレイングなのだ。
		//役割を果たせ！役割を演じきるのだ。
	}
	talk 大佐 標準 -m {
		[P071_01_R01_拷問部屋脱出１無線機デモ１＿１__e:大佐_011_1]
		//これは一種のロール・プレイングなのだ。
		//役割を果たせ！役割を演じきるのだ。
	}
	talk ライデン 標準 -m {
		[P071_01_R01_拷問部屋脱出１無線機デモ１＿１__e:ライデン_012]
		//大佐、思い出したんだ。
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P071_01_R01_拷問部屋脱出１無線機デモ１＿１__e:大佐_013]
		//なんだ？
	}
	talk ライデン 標準 -m {
		[P071_01_R01_拷問部屋脱出１無線機デモ１＿１__e:ライデン_014]
		//俺はあんたに直接あったことがない。
		//一度もな。
	}
@rp_うなづきデフォルト＿是
@rp_かみあわない＿否１＿話聞けよ系デフォルト 100
	talk 大佐 標準 -m {
		[P071_01_R01_拷問部屋脱出１無線機デモ１＿１__e:大佐_015]
		//……。
	}
@rp_キテレツさん＿否２＿意味不明系デフォルト 100
	talk 大佐 標準 -m {
		[P071_01_R01_拷問部屋脱出１無線機デモ１＿１__e:大佐_016]
		//任務をシミュレーション通りに
		//完遂するんだ！
	}
	talk ライデン 標準 -m {
		[P071_01_R01_拷問部屋脱出１無線機デモ１＿１__e:ライデン_017]
		//大佐、あんたは誰なんだ！？
	}
@rp_うなづきデフォルト＿是
	talk 大佐 標準 -m {
		[P071_01_R01_拷問部屋脱出１無線機デモ１＿１__e:大佐_018]
		//それ以上の詮索は無用だ。
		//ローズマリーはこちらが預かっている。
	}
	talk ライデン 標準 -m {
		[P071_01_R01_拷問部屋脱出１無線機デモ１＿１__e:ライデン_019]
		//それはどういう意味だ？
	}
	talk 大佐 標準 -m {
		[P071_01_R01_拷問部屋脱出１無線機デモ１＿１__e:大佐_020]
		//いいな、ライデン。
	}
}//v
}//d



//resource P072_01_R01_大佐混乱１無線機デモ１＿１ 
proc vc117201:01  {
vox t:vc117201 {
	//バグらせる？ＸＸＸＸＸＸＸＸＸＸＸｘ

@rp_キテレツさん＿否２＿意味不明系デフォルト 100
	talk 大佐 標準 -m {
		[P072_01_R01_大佐混乱１無線機デモ１＿１__e:大佐_000]
		//ライデン、今すぐにゲーム機の電源を
		//切るんだ！
	}
	//ばぐやめ
//	@rpd_大佐顔表示

//大佐エフェクトをかける。（ウイルスが効き始めている）
	talk ライデン 標準 -m {
		[P072_01_R01_大佐混乱１無線機デモ１＿１__e:ライデン_001]
		//何て言った？
	}
	talk 大佐 標準 -m {
		[P072_01_R01_大佐混乱１無線機デモ１＿１__e:大佐_002]
		//任務は失敗に終わった！
		//今すぐ電源を切れっ！
	}
	talk ライデン 標準 -m {
		[P072_01_R01_大佐混乱１無線機デモ１＿１__e:ライデン_003]
		//一体、どうしたんだ？
	}	
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P072_01_R01_大佐混乱１無線機デモ１＿１__e:大佐_004]
		//うろたえるな、これはゲームだ！
		//いつものゲームなんだ。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		[P072_01_R01_大佐混乱１無線機デモ１＿１__e:ローズ_005]
		//長時間プレイすると目が悪くなるわよ。
	}
	talk ライデン 標準 -m {
		[P072_01_R01_大佐混乱１無線機デモ１＿１__e:ライデン_006]
		//何を言ってるんだ！？
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト＿是
@rp_キテレツさん＿否２＿意味不明系デフォルト 100
	talk 大佐 標準 -m {
		[P072_01_R01_大佐混乱１無線機デモ１＿１__e:大佐_007]
		//ライデン、聞いてくれ。先週の木曜の
		//ことだ。私は車で家に帰る途中だった。
	}
	talk 大佐 標準 -m {
		[P072_01_R01_大佐混乱１無線機デモ１＿１__e:大佐_008]
		//家まであと２マイルほどの所……
		//ふと目を上げると東の空にオレンジ色の
		//光る物体が見えたんだ！
	}
@rp_うなづきデフォルト＿是
	talk 大佐 標準 -m {
		[P072_01_R01_大佐混乱１無線機デモ１＿１__e:大佐_009]
		//とても不規則に動いていた……
		//そして次の瞬間、あたり一面が
		//強烈な光に包まれ……
	}
	talk 大佐 標準 -m {
		[P072_01_R01_大佐混乱１無線機デモ１＿１__e:大佐_010]
		//気がつくと私は家に着いていた……。
	}
	talk 大佐 標準 -m {
		[P072_01_R01_大佐混乱１無線機デモ１＿１__e:大佐_011]
		//どう思う？
	}
	talk ライデン 標準 -m {
		[P072_01_R01_大佐混乱１無線機デモ１＿１__e:ライデン_012]
		//どうって……。
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P072_01_R01_大佐混乱１無線機デモ１＿１__e:大佐_013]
		//わかった……もういい……。
	}
}//v
}//d


//resource P073_01_R01_通路Ａ１無線機デモ１＿１ 
