	}
	@rpd_オタコン顔表示
	talk オタコン 標準 -m {
		[P050_06_R03_タンカー編整理６無線機デモ３＿１__e:オタコン_005]
		//そう。僕の妹だ。
	}
	talk ライデン 標準 -m {
		[P050_06_R03_タンカー編整理６無線機デモ３＿１__e:ライデン_006]
		//彼女はここで何を？
	}
@rp_うなづきデフォルト
	talk オタコン 標準 -m {
		[P050_06_R03_タンカー編整理６無線機デモ３＿１__e:オタコン_007]
		//……わからない。
		//彼女は確かにコンピュータの天才だ。
	}
	talk オタコン 標準 -m {
		[P050_06_R03_タンカー編整理６無線機デモ３＿１__e:オタコン_007_1]
		//……わからない。
		//彼女は確かにコンピュータの天才だ。
