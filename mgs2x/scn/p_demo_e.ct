		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:ローズ_084]
		//この国を支配する私達にとって、
		//どんなに優秀でも一人の兵士なんて
		//問題にはならない。
	}
	@rpd_バグ大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:大佐_085]
		//Ｓ３計画とはＳｏｌｉｄ　Ｓｎａｋｅ　
		//Ｓｉｍｕｌａｔｉｏｎの略ではないのだ。
	}
	talk 大佐 標準 -m {
		[P080_21_R02_ＡＧ浮上２１無線機デモ２＿２__e:大佐_086]
		//正しくは
		//＃｛社会の（思想的）健全化のための淘汰、Ｓｅｌｅｃｔｉｏｎ　ｆｏｒ　Ｓｏｃｉｅｔａｌ　Ｓａｎｉｔｙ｝＃。
	}
}//v
}//d



//resource P080_23_R03_ＡＧ浮上２３無線機デモ３＿１ 
proc vc118021:01  {
vox t:vc118021 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P080_23_R03_ＡＧ浮上２３無線機デモ３＿１__e:大佐_000]
		//君が経験したのはその有効性を
		//実証するための最終試験だった。
	}
	talk ライデン 標準 -m {
		[P080_23_R03_ＡＧ浮上２３無線機デモ３＿１__e:ライデン_001]
		//そんな馬鹿な？
	}
	talk 大佐 標準 -m {
		[P080_23_R03_ＡＧ浮上２３無線機デモ３＿１__e:大佐_002]
		//ジョンソン大統領が言っていただろう。
	}
	//ＸＸＸ顔はどくろっすか？のいずっすかね？ＸＸＸ
	@rpd_バグ大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P080_23_R03_ＡＧ浮上２３無線機デモ３＿１__e:大統領_003]
		//『Ｇ．Ｗ』とアーセナルの完成は
		//すなわち新しい支配の完成を意味する。
	}	
	@rpd_大佐顔表示
	talk 大佐 標準 -m {
		[P080_23_R03_ＡＧ浮上２３無線機デモ３＿１__e:大佐_004]
		//この演習の目的はそのメソッドの確立だ。
	}
}//v
}//d




//resource P080_25_R04_ＡＧ浮上２５無線機デモ４＿１ 
proc vc118031:01  {
vox t:vc118031 {
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:大佐_000]
		//ライデン、君を選んだのにも理由がある。
	}
	talk 大佐 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:大佐_001]
		//ソリダスの育てたチャイルド・ソルジャー
		//なら他にもいる。だが我々はあえて君を
		//選んだ。なぜだか分かるか？
	}
	talk ライデン 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:ライデン_002]
		//？
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:大佐_003]
		//君だけが自分の過去から目をそらして
		//いたからだ。
	}
	talk 大佐 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:大佐_004]
		//他の者は皆、それぞれ自分の過去に
		//苦しんでいるというのに……。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:ローズ_005]
		//そう。あなたは見たくないもの全てに
		//背を向けていた。
	}
	talk ローズ 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:ローズ_006]
		//自分のためだけに自分の見たいもの
		//だけを見て、したいことだけをしていた。
	}
@rp_うなづきデフォルト
	@rpd_大佐顔表示
	talk 大佐 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:大佐_007]
		//そのあたりはローズ君が詳しいな。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_セクハラ＿否１＿ワガママ系デフォルト 100
	talk ローズ 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:ローズ_008]
		//あなたは本当の私を見ようとしなかった。
		//確かに私は嘘をついてたわ。
		//でも本当は気づいて欲しかった。
	}
	talk ローズ 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:ローズ_009]
		//……だけどあなたは理解のある振りを
		//して、物分かりがいい風を装って……
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:ローズ_010]
		//自分から私に踏み込もうとしては
		//くれなかった……
	}
	talk ローズ 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:ローズ_011]
		//私に踏み込むのは、私に追いつめられて、
		//やむを得ずそうする時だけ……。
	}
	talk ライデン 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:ライデン_012]
		//それは君を……。
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:ローズ_013]
		//傷つけたくなかったから？嘘！！
		//あなたは自分が傷つきたくなかったのよ。
	}
	talk ローズ 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:ローズ_014]
		//『優しさ』をアリバイにして逃げて
		//ただけ……！。
	}
	talk ローズ 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:ローズ_015]
		//……あなたはいつも自分を守ることしか頭になかった……
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_セクハラ＿否１＿ワガママ系デフォルト 100
	talk ローズ 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:ローズ_016]
		//私のためとか言ってみても、
		//本当に何かをしてくれるわけじゃない。
	}
	talk ローズ 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:ローズ_017]
		//結局、全部自分のため……
		//私のことなんか……考えもしない……！
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:大佐_018]
		//はっはっは……そういうことだ。
	}
	talk 大佐 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:大佐_019]
		//つまり君は、我々が保護すべき大衆の
		//モデルケースとして、うってつけ
		//だったのだよ。だから君を選んだ。
	}
	talk 大佐 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:大佐_019_1]
		//つまり君は、我々が保護すべき大衆の
		//モデルケースとして、うってつけ
		//だったのだよ。だから君を選んだ。
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:大佐_020]
		//事実、これまで君は我々の提供する
		//フィクションを進んで受け入れ､指示を
		//乞い、言われた通りに動いてくれた。
	}
	talk 大佐 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:大佐_021]
		//演習は成功だ。
	}

	//ＸＸＸＸどくろかなぁ？えま？？
	@rpd_バグ大佐顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk 大佐 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:エマ_022]
		//私、言ったでしょ？『Ｇ．Ｗ』はまだ
		//未完成だったって。それもこれで完成。
		//全部あなたのおかげ。ありがとう！
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:大佐_023]
		//君自身も君の経験も、君の喜怒哀楽も
		//只の副産物だ……それを作り出し、制御
		//しうることを確かめるのが目的だった。
	}
	talk 大佐 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:大佐_023_1]
		//君自身も君の経験も、君の喜怒哀楽も
		//只の副産物だ……それを作り出し、制御
		//しうることを確かめるのが目的だった。
	}
	talk 大佐 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:大佐_024]
		//金と時間はかかったが、この成功に
		//比べれば、極めてささいなものだ……。
	}
	talk ライデン 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:ライデン_025]
		//……。
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:大佐_026]
		//さあ、話は終わりだ。
		//そろそろ最後の演習を行なって
		//もらおうか。
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:大佐_027]
		//ライデン、ソリダスを倒せ。
	}
	talk ライデン 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:ライデン_028]
		//もう貴様らの言いなりにはならない！！
	}
	talk 大佐 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:大佐_029]
		//それはどうかな？
		//思い出せ。
	}	
	//ＸＸＸＸＸＸｘどくろかなあ？ノイズ？
	@rpd_バグ大佐顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk オルガ 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:オルガ_030]
		//あなたが死ぬと、私の子供も死ぬように
		//プログラムされている。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:大佐_031]
		//ナノマシンから発信されている＃｛ＶＳ、ヴァイタル・サイン｝＃が
		//途絶える事は、オルガの子供が死ぬ
		//ことを意味する。
	}
	talk 大佐 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:大佐_032]
		//それだけではないぞ。君の大事な
		//ローズ君にも同じ仕掛けがしてある。
	}
	talk ライデン 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:ライデン_033]
		//ローズは実在するのか！？
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_邪道外道＿否１＿サイテー系デフォルト 100
@rpd_バグ大佐顔表示

//	@rpd_ローズ顔表示

talk 大佐 標準 -m { //talk ローズ 標準 -m ＸＸＸＸ
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:ローズ_034]
		//もちろんよ、ジャック！
		//信じて！	
	}
@rpd_大佐顔表示
	talk ライデン 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:ライデン_035]
		//くそ……。
	}

@rp_うなづきデフォルト＿是
@rpd_バグ大佐顔設定＿右
@rpd_顔表示
	talk 大佐 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:大佐_036]
		//君達は殺し合う事になる。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
	talk ローズ 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:ローズ_037]
		//少なくともソリダスはあなたを
		//殺したがっているわよ？
	}
@rpd_大佐顔設定＿後ろ
@rpd_顔表示
@rp_うなづきデフォルト＿是
	talk 大佐 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:大佐_038]
		//君達の最後の戦いをデータとして
		//収集し……今回の演習は幕を閉じる。
	}
@rpd_バグ大佐顔表示
	talk 大佐 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:大佐_039]
		//それでは、＃｛切り裂きジャック、ジャック・ザ・リッパー｝＃！
	}
@rpd_バグ大佐顔設定＿右
@rpd_顔表示
	talk 大佐 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:大佐_040]
		//『＃｛愛国者達、われわれ｝＃』が作ったソリダスか？
	}
@rp_うなづきデフォルト＿是
@rpd_バグ大佐顔設定＿左
@rpd_顔表示
	talk 大佐 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:大佐_041]
		//ソリダスが作った貴様か？
	}	
@rpd_バグ大佐顔設定＿正面
@rpd_顔表示
	talk 大佐 標準 -m {
		[P080_25_R04_ＡＧ浮上２５無線機デモ４＿１__e:大佐_042]
		//我々の愛しい怪物達よ……
		//せいぜい楽しむがいい。
	}
}//v
}//d




































