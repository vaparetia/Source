		//スネークの墓を見つけた。
	}
	talk ライデン 標準 -m {
		[P037_01_R01_スネークの遺体１無線デモ１＿１__e:ライデン_005]
		//それで遺体は？
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		[P037_01_R01_スネークの遺体１無線デモ１＿１__e:ローズ_006]
		//スネークの墓を掘り起こして、
		//ＤＮＡ鑑定をしたわ。
	}
	talk ライデン 標準 -m {
		[P037_01_R01_スネークの遺体１無線デモ１＿１__e:ライデン_007]
		//結果は？
	}

@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk ローズ 標準 -m {
		[P037_01_R01_スネークの遺体１無線デモ１＿１__e:ローズ_008]
		//右腕が欠損していたものの、ソリッド・
		//スネークに間違いない。彼はすでに
		//死んでいる。
	}
	talk ライデン 標準 -m {
		[P037_01_R01_スネークの遺体１無線デモ１＿１__e:ライデン_009]
		//ううん……となると、
		//今回のテロリストは？
	}
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		[P037_01_R01_スネークの遺体１無線デモ１＿１__e:ローズ_010]
		//スネークを語る偽物。
	}
	talk ライデン 標準 -m {
		[P037_01_R01_スネークの遺体１無線デモ１＿１__e:ライデン_011]
		//そうか……。
	}
	talk ローズ 標準 -m {
		[P037_01_R01_スネークの遺体１無線デモ１＿１__e:ローズ_012]
		//どうしたの？
		//がっかりしたようだけど。
	}
	talk ライデン 標準 -m {
		[P037_01_R01_スネークの遺体１無線デモ１＿１__e:ライデン_013]
		//いや、伝説の男に逢えるかもしれないと、
