//resource P002_02_R01_Ａ脚底部連結ハッチ２無線デモ１＿１ 
//vc110201
proc vc110201:01  {
vox t:vc110201 {
	talk ライデン 標準 -m {
		[P002_02_R01_Ａ脚底部連結ハッチ２無線デモ１＿１__e:ライデン_000]
		//大佐、敵兵を１名確認。
	}

	talk ライデン 標準 -m {
		[P002_02_R01_Ａ脚底部連結ハッチ２無線デモ１＿２__e:ライデン_000]
		//ＡＮ９４にマカロフ……。
	}
	talk ライデン 標準 -m {
		[P002_02_R01_Ａ脚底部連結ハッチ２無線デモ１＿２__e:ライデン_001]
		//グレネード……ロシア製の装備だ。
	}

@rp_うなづきデフォルト

	talk 大佐 標準 -m {
		[P002_02_R01_Ａ脚底部連結ハッチ２無線デモ１＿２__e:大佐_002]
		//ゴルルコビッチ大佐の部隊だろう
	}
	talk ライデン 標準 -m {
		[P002_02_R01_Ａ脚底部連結ハッチ２無線デモ１＿２__e:ライデン_003]
		//ゴルルコビッチ？
	}

@rp_うんちく＿是１＿詳しいな系デフォルト 80
@rp_うんちく＿否３＿わかってんのか系デフォルト 80

	talk 大佐 標準 -m {
		[P002_02_R01_Ａ脚底部連結ハッチ２無線デモ１＿２__e:大佐_004]
		//４年前のシャドーモセス事件の際、
		//テロリストと合流しようとしたロシアの
		//私兵部隊だ。
	}
	talk ライデン 標準 -m {
		[P002_02_R01_Ａ脚底部連結ハッチ２無線デモ１＿２__e:ライデン_005]
		//なぜ彼らがこのテロに加わっている？
	}
	talk 大佐 標準 -m {
		[P002_02_R01_Ａ脚底部連結ハッチ２無線デモ１＿２__e:大佐_006]
		//テロリスト達とのなんらかの取引が
		//あったに違いない。
	}
	talk 大佐 標準 -m {
		[P002_02_R01_Ａ脚底部連結ハッチ２無線デモ１＿２__e:大佐_007]
		//もはや彼らは国亡き傭兵部隊と
		//化している。
	}
/*
	talk 大佐 標準 -m {
		[P002_02_R01_Ａ脚底部連結ハッチ２無線デモ１＿２__e:大佐_008]
		//通常、敵は君を見つけると仲間を呼ぶが、
		//そのエリアに限って言えば、その心配は
		//ない。
	}
	talk 大佐 標準 -m {
		[P002_02_R01_Ａ脚底部連結ハッチ２無線デモ１＿２__e:大佐_009]
		//壁面に埋め込まれた無線通信補助
		//アンテナが錆び付いているんだ。
		//そのエリアで敵は無線を使えない。
	}
	talk ライデン 標準 -m {
		[P002_02_R01_Ａ脚底部連結ハッチ２無線デモ１＿２__e:ライデン_010]
		//俺達の通信システムには影響ないのか？
	}
	talk 大佐 標準 -m {
		[P002_02_R01_Ａ脚底部連結ハッチ２無線デモ１＿２__e:大佐_011]
		//ナノマシンには問題ない。
		//通常無線のみだ。
	}
	talk 大佐 標準 -m {
		[P002_02_R01_Ａ脚底部連結ハッチ２無線デモ１＿２__e:大佐_012]
		//たとえ仲間を呼べなくても、
		//敵は武装している。
		//慎重にな、ライデン。
	}
*/
}//v
}//d


//resource P003_02_R02_スネーク昇降機上昇２無線デモ１＿１ 
proc vc110301:01  {
vox t:vc110301 {
	talk ライデン 標準 -m {
		[P003_02_R02_スネーク昇降機上昇２無線デモ１＿１__e:ライデン_000]
		//大佐、やはり俺の他に誰か侵入者がいる。
		}
	talk 大佐 標準 -m {
		[P003_02_R02_スネーク昇降機上昇２無線デモ１＿１__e:大佐_001]
		//ありえない事だ。
	}
	talk ライデン 標準 -m {
		[P003_02_R02_スネーク昇降機上昇２無線デモ１＿１__e:ライデン_002]
		//チームではない。単独のようだ。
	}

@rp_うなづきデフォルト

	talk 大佐 標準 -m {
		[P003_02_R02_スネーク昇降機上昇２無線デモ１＿１__e:大佐_003]
		//単独だと……？
	}
	talk ライデン 標準 -m {
		[P003_02_R02_スネーク昇降機上昇２無線デモ１＿１__e:ライデン_004]
		//素性はわからんが、ここの見張りを
		//全て片づけてくれたようだ。
		//みんな気を失っている。
	}
	talk ライデン 標準 -m {
		[P003_02_R02_スネーク昇降機上昇２無線デモ１＿１__e:ライデン_005]
		//かなりのタフガイだ。
	}
	talk 大佐 標準 -m {
		[P003_02_R02_スネーク昇降機上昇２無線デモ１＿１__e:大佐_006]
		//調査が必要だな……
		//しかし敵が無力化されているのは
		//とりあえず好都合だ。
	}

@rp_うなづきデフォルト

// ↓海外版では不要
/*	talk 大佐 標準 -m {
		[P003_02_R02_スネーク昇降機上昇２無線デモ１＿１__e:大佐_007]
		//今のうちにことを進めるとしよう。
	}
*/
	talk 大佐 標準 -m {
		[P003_02_R02_スネーク昇降機上昇２無線デモ１＿１__e:大佐_008]
		//昇降機の前に端末がある。
		//『ノード』と呼ばれるものだ。
	}

@rp_うなづきデフォルト

	talk ライデン 標準 -m {
		[P003_02_R02_スネーク昇降機上昇２無線デモ１＿１__e:ライデン_009]
		//＃｛まぬけ、nerd｝＃だって？
	}
	talk 大佐 標準 -m {
		[P003_02_R02_スネーク昇降機上昇２無線デモ１＿１__e:大佐_010]
		//ノードだ。
	}
	talk ライデン 標準 -m {
		[P003_02_R02_スネーク昇降機上昇２無線デモ１＿１__e:ライデン_011]
		//なるほど、ノード端末か。
	}
	talk 大佐 標準 -m {
		[P003_02_R02_スネーク昇降機上昇２無線デモ１＿１__e:大佐_012]
		//ノードを使えば『ビッグ・シェル』内の
		//作業支援コンピュータ・ネットワークに
		//接続できる。
	}

@rp_うなづきデフォルト

	talk ライデン 標準 -m {
		[P003_02_R02_スネーク昇降機上昇２無線デモ１＿１__e:ライデン_013]
		//何が出来るんだ。
	}

@rp_うんちく＿否３＿わかってんのか系デフォルト 80
@rp_うんちく＿是１＿詳しいな系デフォルト 80

	talk 大佐 標準 -m {
		[P003_02_R02_スネーク昇降機上昇２無線デモ１＿１__e:大佐_014]
		//『ビッグ・シェル』のマップが参照
		//出来る。そしてそのデータによって
		//ソリトン・レーダーが使用可能になる。
	}
	talk ライデン 標準 -m {
		[P003_02_R02_スネーク昇降機上昇２無線デモ１＿１__e:ライデン_015]
		//ソリトン・レーダー？
	}
}//v
}//d

//resource P003_02_R02_スネーク昇降機上昇２無線デモ１＿２ 
proc vc110302:01  {
vox t:vc110302 {
//（タンカー編をやってる人）
	talk ライデン 標準 -m {
		[P003_02_R02_スネーク昇降機上昇２無線デモ１＿２__e:ライデン_000]
		//ＶＲ訓練で重宝したレーダーだな。
	}
}//v
}//d

//resource P003_02_R02_スネーク昇降機上昇２無線デモ１＿３ 
proc vc110303:01  {
vox t:vc110303 {
//（タンカー編をやってないひと。全員聞く音声）

@rp_うんちく＿否３＿わかってんのか系デフォルト 100
@rp_うんちく＿是１＿詳しいな系デフォルト 80

	talk 大佐 標準 -m {
		[P003_02_R02_スネーク昇降機上昇２無線デモ１＿３__e:大佐_000]
		//人間の生体反応に起因する電磁場を
		//活用して判定を行うシステムだ。
	}
	talk 大佐 標準 -m {
		[P003_02_R02_スネーク昇降機上昇２無線デモ１＿３__e:大佐_001]
		//それらをジーピーエスＧＰＳや各隊員
		//から収集されるエリア測定値により、
		//誤差を修正したマップ上に投影する。
	}
	talk 大佐 標準 -m {
		[P003_02_R02_スネーク昇降機上昇２無線デモ１＿３__e:大佐_001_1]
		//それらをジーピーエスＧＰＳや各隊員
		//から収集されるエリア測定値により、
		//誤差を修正したマップ上に投影する。
	}
	talk 大佐 標準 -m {
		[P003_02_R02_スネーク昇降機上昇２無線デモ１＿３__e:大佐_002]
		//この膨大なデジタル処理を
		//行う為にもノードによるマップ情報の
		//ダウンロードが必要なのだ。
	}
	talk 大佐 標準 -m {
		[P003_02_R02_スネーク昇降機上昇２無線デモ１＿３__e:大佐_003]
		//ノードは１メートルくらいの高さの
		//青い端末だ。各エリアに最低１台はある。
		//壁に埋め込まれているはずだ。
	}
	talk 大佐 標準 -m {
		[P003_02_R02_スネーク昇降機上昇２無線デモ１＿３__e:大佐_003_1]
		//ノードは１メートルくらいの高さの
		//青い端末だ。各エリアに最低１台はある。
		//壁に埋め込まれているはずだ。
	}
}//v
}//d

//resource P003_02_R02_スネーク昇降機上昇２無線デモ１＿４ 
proc vc110304:01  {
//vox t:vc110304 
movie t:vc110304 {

@rp_うなづきデフォルト

	talk ライデン 標準 -m {
		[P003_02_R02_スネーク昇降機上昇２無線デモ１＿４__e:ライデン_000]
		//接続するにはどうすればいい？
	}
	talk 大佐 標準 -m {
		[P003_02_R02_スネーク昇降機上昇２無線デモ１＿４__e:大佐_001]
		//ノードの前でアクションボタンを
		//押すだけだ。
	}
}//v
}//d


proc vc110305:01  {
vox t:vc110305 {

@rp_うんちく＿否＿話分からん系デフォルト 100
@rp_うんちく＿是１＿詳しいな系デフォルト 50

	talk 大佐 標準 -m {
		[P003_02_R02_スネーク昇降機上昇２無線デモ１＿４__e:大佐_002]
		//あとは君の体内のナノマシンが自動で
		//セキュリティを破りノードを使用可能に
		//してくれる。
	}
	talk 大佐 標準 -m {
		[P003_02_R02_スネーク昇降機上昇２無線デモ１＿４__e:大佐_003]
		//敵兵達が目覚める前にアクセスを		//
		//完了しろ。
	}
	talk 大佐 標準 -m {
		[P003_02_R02_スネーク昇降機上昇２無線デモ１＿４__e:大佐_004]
		//敵に発見されるとアクセスは一時的に
		//できなくなる。
	}
	talk 大佐 標準 -m {
		[P003_02_R02_スネーク昇降機上昇２無線デモ１＿４__e:大佐_005]
		//注意するんだ。
	}
	talk ライデン 標準 -m {
		[P003_02_R02_スネーク昇降機上昇２無線デモ１＿４__e:ライデン_006]
		//了解。
	}
}//v
}//d

//resource P004_02_R01_ノード初接続２無線デモ１＿１ 
proc vc110401:01  {
vox t:vc110401 {
	talk 大佐 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿１__e:大佐_000]
		//ライデン、ノードにアクセスできた
		//ようだな。
	}
	talk ライデン 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿１__e:ライデン_001]
		//これでレーダーが使える？
	}
}//v
}//d

//resource P004_02_R01_ノード初接続２無線デモ１＿２ 
proc vc110402:01  {
vox t:vc110402 {
//タンカー編をやっている人

@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿２__e:大佐_000]
		//ＶＲ訓練を思い出せ。
	}
	talk 大佐 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿２__e:大佐_001]
		//ものは同じだ。
		//地形と敵兵の位置が表示される。
	}
}//v
}//d

//resource P004_02_R01_ノード初接続２無線デモ１＿３ 
proc vc110403:01  {
vox t:vc110403 {
//タンカー編をやっていない人

@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿３__e:大佐_000]
		//それではソリトン・レーダーの説明を
		//しよう。
	}
}//v
}//d

proc vc110407:01  {
//vox t:vc110407 
movie t:vc110407 {

@rp_うんちく＿是１＿詳しいな系デフォルト 80
@rp_うんちく＿否＿話分からん系デフォルト 80
	talk 大佐 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿３__e:大佐_001]
		//中心の光点が……ライデン、君の位置だ。
	}
	talk 大佐 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿３__e:大佐_002]
		//赤い光点が敵の位置。
	}
	talk 大佐 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿３__e:大佐_003]
		//蒼い円錐が敵の視界……。
	}
	talk 大佐 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿３__e:大佐_004]
		//ソリトン・レーダーは気象には
		//影響されないが、敵に発見されると
		//使えなくなる。
	}

@rp_うんちく＿否３＿わかってんのか系デフォルト 80

	talk 大佐 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿３__e:大佐_005]
		//うむ、簡単に妨害されてしまうのだ。
	}
	talk 大佐 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿３__e:大佐_006]
		//ソリトン・レーダーはもはや既存技術だ。
	}
	talk 大佐 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿３__e:大佐_007]
		//それと音響共鳴の強い空間でも
		//使えないから注意しろ。
	}
}//v
}//d

//resource P004_02_R01_ノード初接続２無線デモ１＿４ 
proc vc110404:01  {
vox d:_vc110404 {
@rp_うなづきデフォルト
@rp_うんちく＿否３＿わかってんのか系デフォルト 50

	talk 大佐 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿４__e:大佐_000]
		//『ビッグ・シェル』全体の構造マップは
		//ＳＴＡＲＴボタンでいつでも閲覧が
		//可能だ。
	}
	talk ライデン 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿４__e:ライデン_001]
		//潜入データの記録は？
	}
	talk 大佐 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿４__e:大佐_002]
		//セーブには専用回線を設けてある。
		//専用のアナリストもな。
	}
}//v
}//d

//resource P004_02_R01_ノード初接続２無線デモ１＿５ 
proc vc110405:01  {
vox t:vc110405 {
@rp_うなづきデフォルト
	@rpd_ローズ顔表示
	talk ローズ 標準 -m {
			[P004_02_R01_ノード初接続２無線デモ１＿５__e:ローズ_001]
		//ジャック……大丈夫？
	}
	talk ライデン 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:ライデン_002]
		//まさか！
	}

@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否

	talk ローズ 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:ローズ_003]
		//ジャック、聞こえる？
	}
	talk ライデン 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:ライデン_004]
		//ローズ！
		//どうして君が！！
	}
	talk ライデン 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:ライデン_005]
		//なぜ君がそこにいる！？
	}
	talk ローズ 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:ローズ_006]
		//ああ、
		//ジャック……私も作戦に参加するの。
	}
	talk ライデン 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:ライデン_007]
		//どういう事だ？大佐！！
	}

@rp_うなづきデフォルト

	@rpd_大佐顔表示
	talk 大佐 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:大佐_008]
		//ライデン、彼女には今回のデータ記録と
		//サポートを担当して貰う。	
	}
	talk ライデン 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:ライデン_009]
		//なぜ彼女が？
		}
	talk 大佐 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:大佐_010]
		//本作戦に従事する予定だったＦＯＸ
		//ＨＯＵＮＤ部隊のオペレーターが
		//事故にあい、参加できなくなった。
	}
	talk 大佐 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:大佐_011]
		//それで急遽、
		//ローズマリー君が選ばれた……。
	}

@rp_うなづきデフォルト

	talk ライデン 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:ライデン_012]
		//事故……？
	}
	talk 大佐 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:大佐_013]
		//それにレポート報告によると……
		//彼女は君を誰よりも知っている。	
	}

	talk ライデン 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:ライデン_014]
		//彼女は確かに軍人だが……
		//内勤のデータ・アナリストに過ぎない。
	}

@rp_かみあわない＿否１＿話聞けよ系デフォルト 100

	talk 大佐 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:大佐_015]
		//大丈夫だ。うちの専門スタッフが
		//オペレートする。
	}
	talk ライデン 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:ライデン_016]
		//実戦サポートなんて無理だ。
		//できっこない。
	}

@rp_うなづきデフォルト

	talk 大佐 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:大佐_017]
		//彼女をこの作戦に参加させたのには、
		//それなりの理由がある。
	}
	talk ライデン 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:ライデン_018]
		//大佐、俺には理解できない。
	}
	talk 大佐 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:大佐_019]
		//私は君のＶＲ訓練の成績なら
		//よく知っている。
		//しかし、それ以上の事はわからない。
	}		

@rp_うなづきデフォルト

	talk 大佐 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:大佐_020]
		//シャドーモセスの事は知っているな？
	}
	talk ライデン 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:ライデン_021]
		//ああ、事件のＶＲも体験した。
	}
	talk 大佐 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:大佐_022]
		//あの事件で立証された。
		//兵士の士気を持続させる要素……。
	}
	talk 大佐 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:大佐_022_1]
		//あの事件で立証された。
		//兵士の士気を持続させる要素……。
	}

@rp_うなづきデフォルト

	talk ライデン 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:ライデン_023]
		//俺は軍人として訓練されて来た。
		//己の感情には左右されない。
	}
	talk 大佐 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:大佐_024]
		//そうはいかない。
		//本作戦に失敗は許されんのだ。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是１＿かわいい系デフォルト 100
	talk ローズ 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:ローズ_025]
		//ジャック？
		//いい、私は最後まであなたにつき合う。
	}
	talk ライデン 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:ライデン_026]
		//ローズ？
	}
	talk ローズ 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:ローズ_027]
		//あなたが心配だから……ただし。
	}
	talk ローズ 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:ローズ_028]
		//条件がある、大佐。
	}


@rp_うなづきデフォルト

	@rpd_大佐顔表示
	talk 大佐 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:大佐_029]
		//なんだ？
	}
	@rpd_ローズ顔表示

@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_セクハラ＿否１＿ワガママ系デフォルト 80

	talk ローズ 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:ローズ_030]
		//私はこの作戦の＃｛記録、セーブ｝＃を行う。
		//	でも、私は作戦の一部じゃない。
	}
	talk ローズ 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:ローズ_030_1]
		//私はこの作戦の＃｛記録、セーブ｝＃を行う。
		//	でも、私は作戦の一部じゃない。
	}
	talk ローズ 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:ローズ_031]
		//ジャックを案じる普通の女……だから、
		//それ以外は大佐達の強制は受けない。
	}
	talk ローズ 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:ローズ_031_1]
		//ジャックを案じる普通の女……だから、
		//それ以外は大佐達の強制は受けない。
	}
	talk ローズ 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:ローズ_032]
		//私にとって、彼は恋人、
		//ジャックでしかない。
		//彼の安否が最優先……。
	}
	talk ローズ 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:ローズ_032_1]
		//私にとって、彼は恋人、
		//ジャックでしかない。
		//彼の安否が最優先……。
	}
	talk ローズ 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:ローズ_033]
		//だから、大佐との交信内容も傍聴する。
		//いえ、記録する。
	}
	talk ローズ 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:ローズ_033_1]
		//だから、大佐との交信内容も傍聴する。
		//いえ、記録する。
	}


@rp_うなづきデフォルト

	@rpd_大佐顔表示
	talk 大佐 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:大佐_034]
		//……わかった。好きにするがいい。
	}

@rp_セクハラ＿是１＿かわいい系デフォルト 100

	@rpd_ローズ顔表示
	talk ローズ 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:ローズ_035]
		//考えようによっては……
		//この方がいいかも。何も知らされず、
		//待つだけなんて辛いだけだもの。
	}

@rp_うなづきデフォルト
	@rpd_大佐顔表示
	talk 大佐 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:大佐_036]
		//一つだけいいか？
	}
	@rpd_ローズ顔表示
	talk ローズ 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:ローズ_037]
		//何？
	}
	@rpd_大佐顔表示
	talk 大佐 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:大佐_038]
		//彼の名はライデンだ。
		//作戦遂行中はコードネームで呼んでくれ。
	}
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否

	@rpd_ローズ顔表示
	talk ローズ 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:ローズ_039]
		//わかったわ。
	}
	talk ローズ 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:ローズ_040]
		//じゃあ、ライデン？
	}
	talk ローズ 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:ローズ_041]
		//潜入データを記録したい時は
		//私に連絡して。
	}
	talk ローズ 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿５__e:ローズ_042]
		//周波数は１４０．９６……
		//＃｛記録、セーブ｝＃用の専用回線よ。
	}
}//v
}//d

//resource P004_02_R01_ノード初接続２無線デモ１＿６ 
proc vc110406:01  {
vox t:vc110406 {
@rp_セクハラ＿是１＿かわいい系デフォルト 100
@rp_うなづきデフォルト＿否

	talk ローズ 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿６__e:ローズ_000]
		//今、周波数を変えたわ。
	}
	talk ローズ 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿６__e:ローズ_001]
		//ジャック？
	}
	talk ライデン 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿６__e:ライデン_002]
		//なんだ？。
	}
	talk ローズ 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿６__e:ローズ_003]
		//明日、何の日か知ってる？
	}
	talk ライデン 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿６__e:ライデン_004]
		//４月３０日……いや、わからない。
	}

@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_キテレツさん＿否１＿なんだこいつ系デフォルト 100

	talk ローズ 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿６__e:ローズ_005]
		//ほんとに？
	}
	talk ライデン 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿６__e:ライデン_006]
		//いや、悪いが思い出せない。
	}
	talk ローズ 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿６__e:ローズ_007]
		//その答えを聞くまではがんばるわ。
	}
	talk ローズ 標準 -m {
		[P004_02_R01_ノード初接続２無線デモ１＿６__e:ローズ_008]
		//それじゃ、ジャック。がんばってね。
	}
}//v
}//d



//resource P005_03_R01ライデン昇降機上昇３無線デモ１＿１ 
proc vc110501:01  {
vox t:vc110501 {
	talk ライデン 標準 -m {
		[P005_03_R01ライデン昇降機上昇３無線デモ１＿１__e:ライデン_000]
		//大佐、『ビッグ・シェル』の屋上に出た。
		//敵兵は見あたらないが見通しが良すぎる。
	}
	talk 大佐 標準 -m {
		[P005_03_R01ライデン昇降機上昇３無線デモ１＿１__e:大佐_001]
		//夜間潜入の訓練しかしていなかったな。
	}
	talk 大佐 標準 -m {
		[P005_03_R01ライデン昇降機上昇３無線デモ１＿１__e:大佐_002]
		//ノードにアクセスするまでは、
		//警戒していくしかない。
	}
	talk ライデン 標準 -m {
		[P005_03_R01ライデン昇降機上昇３無線デモ１＿１__e:ライデン_003]
		//突入部隊はどうなった？
	}

@rp_うなづきデフォルト

	talk 大佐 標準 -m {
		[P005_03_R01ライデン昇降機上昇３無線デモ１＿１__e:大佐_004]
		//ＳＥＡＬ１０はＢ脚、Ｃ脚に降下した。
	}
	talk ライデン 標準 -m {
		[P005_03_R01ライデン昇降機上昇３無線デモ１＿１__e:ライデン_005]
		//大統領は？
	}
	talk 大佐 標準 -m {
		[P005_03_R01ライデン昇降機上昇３無線デモ１＿１__e:大佐_006]
		//Ｂ脚で発見されたらしい。
	}
	talk ライデン 標準 -m {
		[P005_03_R01ライデン昇降機上昇３無線デモ１＿１__e:ライデン_007]
		//Ｂ脚？
	}
}//v
}//d


//resource P005_05_R02_ライデン昇降機上昇５無線デモ２ 
