//resource P025_01_R01_爆弾解体昇降機下１無線デモ１＿１ 
proc vc112501:01  {
vox t:vc112501 {
	talk ピーター 標準 -m {
		[P025_01_R01_爆弾解体昇降機下１無線デモ１＿１__e:ピーター_000]
		//ライデン、プリスキン……
		//いいか、よく聞いてくれ！
	}
	talk ライデン 標準 -m {
		[P025_01_R01_爆弾解体昇降機下１無線デモ１＿１__e:ライデン_001]
		//どうした？
	}

command セットサウンドコード -c d:SNG_FOUTP_M

	talk ピーター 標準 -m {
		[P025_01_R01_爆弾解体昇降機下１無線デモ１＿１__e:ピーター_002]
		//まずった……。
	}
	
@rp_うなづきデフォルト

	@rpd_プリスキン顔表示
	talk プリスキン 標準 -m {
		[P025_01_R01_爆弾解体昇降機下１無線デモ１＿１__e:プリスキン_003]
		//何があった？
	}
	@rpd_ピーター顔表示
	talk ピーター 標準 -m {
		[P025_01_R01_爆弾解体昇降機下１無線デモ１＿１__e:ピーター_004]
		//ファットマンにやられた。
	}
	talk ピーター 標準 -m {
		[P025_01_R01_爆弾解体昇降機下１無線デモ１＿１__e:ピーター_005]
		//距離だ。マイクロ波だ。
	}
	talk ライデン 標準 -m {
		[P025_01_R01_爆弾解体昇降機下１無線デモ１＿１__e:ライデン_006]
		//マイクロ波？
	}
	
@rp_うなづきデフォルト

	talk ピーター 標準 -m {
		[P025_01_R01_爆弾解体昇降機下１無線デモ１＿１__e:ピーター_007]
		//２メートル以内に近づくと感知する。
	}
	talk ピーター 標準 -m {
		[P025_01_R01_爆弾解体昇降機下１無線デモ１＿１__e:ピーター_008]
		//私の教えていないトラップだ。
	}	
	talk ピーター 標準 -m {
		[P025_01_R01_爆弾解体昇降機下１無線デモ１＿１__e:ピーター_009]
		//さっきの仕掛けといい、このトラップと
		//いい……爆弾の技術に関する限り、
		//奴は私を越えたな……。だが……。
	}
	talk ピーター 標準 -m {
		[P025_01_R01_爆弾解体昇降機下１無線デモ１＿１__e:ピーター_009_1]
		//さっきの仕掛けといい、このトラップと
		//いい……爆弾の技術に関する限り、
		//奴は私を越えたな……。だが……。
	}
	
@rp_うなづきデフォルト

	@rpd_プリスキン顔表示
	talk プリスキン 標準 -m {
		[P025_01_R01_爆弾解体昇降機下１無線デモ１＿１__e:プリスキン_010]
		//親父さん、逃げろっ！	
	}
	@rpd_ピーター顔表示
	talk ピーター 標準 -m {
		[P025_01_R01_爆弾解体昇降機下１無線デモ１＿１__e:ピーター_011]
		//いや、後３０秒もない……。
	}
	talk ライデン 標準 -m {
		[P025_01_R01_爆弾解体昇降機下１無線デモ１＿１__e:ライデン_012]
		//そんな馬鹿なっ……。
	}
	
@rp_うなづきデフォルト

	talk ピーター 標準 -m {
		[P025_01_R01_爆弾解体昇降機下１無線デモ１＿１__e:ピーター_013]
		//プリスキン、Ｈ脚からなるべく離れろ！
	}
	@rpd_プリスキン顔表示
	talk プリスキン 標準 -m {
		[P025_01_R01_爆弾解体昇降機下１無線デモ１＿１__e:プリスキン_014]
		//親父さん……。
	}	
	@rpd_ピーター顔表示
	talk ピーター 標準 -m {
		[P025_01_R01_爆弾解体昇降機下１無線デモ１＿１__e:ピーター_015]
		//ライデン、近づいてはダメだ。
	}
	
@rp_うなづきデフォルト

	talk ピーター 標準 -m {
		[P025_01_R01_爆弾解体昇降機下１無線デモ１＿１__e:ピーター_016]
		//冷却スプレーは離れた位置から
		//噴射するんだ。
	}
	talk ライデン 標準 -m {
		[P025_01_R01_爆弾解体昇降機下１無線デモ１＿１__e:ライデン_017]
		//俺にできるのか？
	}

@rp_無茶指令＿否１＿お前がやれ系デフォルト 100

	talk ピーター 標準 -m {
		[P025_01_R01_爆弾解体昇降機下１無線デモ１＿１__e:ピーター_018]
		//おまえならできる、いいな。
	}
	talk ライデン 標準 -m {
		[P025_01_R01_爆弾解体昇降機下１無線デモ１＿１__e:ライデン_019]
		//無理だ……。
	}
	talk ピーター 標準 -m {
		[P025_01_R01_爆弾解体昇降機下１無線デモ１＿１__e:ピーター_020]
		//大丈夫、やるんだ。おまえならできる。
	}
}//v
}//d

//resource P025_01_R01_爆弾解体昇降機下１無線デモ１＿２ 
proc vc112502:01  {
vox t:vc112502 {

//爆発ＳＥ入るＸＸＸＸＸＸＸＸＸＸＸ
@rp_うなづきデフォルト
	noise 0 1 
	wait 25
	vibplay ptr_dead
	wait 10
	earthq 1 -time 1175

	talk ピーター 標準 -m {
		[P025_01_R01_爆弾解体昇降機下１無線デモ１＿２__e:ピーター_021]
		//！！
	}
}//v
}//d



//resource P026_01_R01_爆弾解体終了１無線デモ１＿１ 
proc vc112601:01  {
vox t:vc112601 {
	talk ライデン 標準 -m {
		[P026_01_R01_爆弾解体終了１無線デモ１＿１__e:ライデン_000]
		//大佐、爆弾を解体した……。
	}
	talk 大佐 標準 -m {
		[P026_01_R01_爆弾解体終了１無線デモ１＿１__e:大佐_001]
		//よくやった、ライデン。
	}
	talk ライデン 標準 -m {
		[P026_01_R01_爆弾解体終了１無線デモ１＿１__e:ライデン_002]
		//大きな犠牲を払った……。
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P026_01_R01_爆弾解体終了１無線デモ１＿１__e:大佐_003]
		//ああ……。
	}
	talk ライデン 標準 -m {
		[P026_01_R01_爆弾解体終了１無線デモ１＿１__e:ライデン_004]
		//大佐、外の状況はどうなってる？
	}
	talk 大佐 標準 -m {
		[P026_01_R01_爆弾解体終了１無線デモ１＿１__e:大佐_005]
		//シェル２の爆発で中心部が浸水している
		//ようだ。
	}
	talk 大佐 標準 -m {
		[P026_01_R01_爆弾解体終了１無線デモ１＿１__e:大佐_005_1]
		//シェル２の爆発で中心部が浸水している
		//ようだ。
	}
	talk 大佐 標準 -m {
		[P026_01_R01_爆弾解体終了１無線デモ１＿１__e:大佐_006]
		//それと、油膜に引火して、
		//海面が炎上している。
	}
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		[P026_01_R01_爆弾解体終了１無線デモ１＿１__e:ライデン_007]
		//有毒物質の発生は？
	}
	talk 大佐 標準 -m {
		[P026_01_R01_爆弾解体終了１無線デモ１＿１__e:大佐_008]
		//今の所は心配ないようだ。
	}
	talk ライデン 標準 -m {
		[P026_01_R01_爆弾解体終了１無線デモ１＿１__e:ライデン_009]
		//『ビッグ・シェル』は
		//姿勢維持できるのか？。
	}
	talk 大佐 標準 -m {
		[P026_01_R01_爆弾解体終了１無線デモ１＿１__e:大佐_010]
		//大丈夫だ。シェル１には影響はない。
		//とにかく爆弾の脅威は去った。
	}
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		[P026_01_R01_爆弾解体終了１無線デモ１＿１__e:ライデン_011]
		//次の指示は？
	}
	talk 大佐 標準 -m {
		[P026_01_R01_爆弾解体終了１無線デモ１＿１__e:大佐_012]
		//大統領の救出に向かってくれ。
		//とりあえずそこから上に戻るんだ。
	}
	talk ライデン 標準 -m {
		[P026_01_R01_爆弾解体終了１無線デモ１＿１__e:ライデン_013]
		//了解。
	}
}//v
}//d




//resource P027_01_R01_爆弾解体後昇降機ホール１無線デモ１＿１ 
proc vc112701:01  {
vox t:vc112701 {
	talk 大佐 標準 -m {
		[P027_01_R01_爆弾解体後昇降機ホール１無線デモ１＿１__e:大佐_000]
		//ライデン、
		//爆弾の強制除去に対する報復があった。
	}
	talk ライデン 標準 -m {
		[P027_01_R01_爆弾解体後昇降機ホール１無線デモ１＿１__e:ライデン_001]
		//何？
	}
@rp_うなづきデフォルト＿是
@rp_邪道外道＿否２＿ひどい系デフォルト 100
	talk 大佐 標準 -m {
		[P027_01_R01_爆弾解体後昇降機ホール１無線デモ１＿１__e:大佐_002]
		//人質が１名殺害された。
	}
	talk 大佐 標準 -m {
		[P027_01_R01_爆弾解体後昇降機ホール１無線デモ１＿１__e:大佐_003]
		//奴等、屋上でこれみよがしに
		//頭を撃ち抜いてみせたよ。
		//衛星がはっきり捉えた。
	}
	talk 大佐 標準 -m {
		[P027_01_R01_爆弾解体後昇降機ホール１無線デモ１＿１__e:大佐_003_1]
		//奴等、屋上でこれみよがしに
		//頭を撃ち抜いてみせたよ。
		//衛星がはっきり捉えた。
	}
	talk ライデン 標準 -m {
		[P027_01_R01_爆弾解体後昇降機ホール１無線デモ１＿１__e:ライデン_004]
		//くそっ！
	}
	talk 大佐 標準 -m {
		[P027_01_R01_爆弾解体後昇降機ホール１無線デモ１＿１__e:大佐_005]
		//今後、１時間毎に１名ずつ……だそうだ。
	}
	talk ライデン 標準 -m {
		[P027_01_R01_爆弾解体後昇降機ホール１無線デモ１＿１__e:ライデン_006]
		//どうすればいい？
		//俺は？
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P027_01_R01_爆弾解体後昇降機ホール１無線デモ１＿１__e:大佐_007]
		//そのまま任務を続行しろ。
		//大統領救出が優先だ。
	}
	talk ライデン 標準 -m {
		[P027_01_R01_爆弾解体後昇降機ホール１無線デモ１＿１__e:ライデン_008]
		//他の人質は？
	}
	talk 大佐 標準 -m {
		[P027_01_R01_爆弾解体後昇降機ホール１無線デモ１＿１__e:大佐_009]
		//最優先はジョンソン大統領だ。
	}
	talk ライデン 標準 -m {
		[P027_01_R01_爆弾解体後昇降機ホール１無線デモ１＿１__e:ライデン_010]
		//人質に優先もくそもない。
	}
	@rpd_ローズ顔表示
@rp_セクハラ＿是＿やりたがり系デフォルト 100
@rp_うなづきデフォルト＿否
	talk ローズ 標準 -m {
		[P027_01_R01_爆弾解体後昇降機ホール１無線デモ１＿１__e:ローズ_011]
		//ジャック、冷静になって。
		//あなたの気持ちはわかるわ。
	}
	talk ローズ 標準 -m {
		[P027_01_R01_爆弾解体後昇降機ホール１無線デモ１＿１__e:ローズ_012]
		//でも、あなた一人では人質全員を
		//救出なんてできない。
	}
	talk ライデン 標準 -m {
		[P027_01_R01_爆弾解体後昇降機ホール１無線デモ１＿１__e:ライデン_013]
		//俺一人ではな。
	}
	@rpd_大佐顔表示
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P027_01_R01_爆弾解体後昇降機ホール１無線デモ１＿１__e:大佐_014]
		//あの男に期待しているのか？
	}
	talk ライデン 標準 -m {
		[P027_01_R01_爆弾解体後昇降機ホール１無線デモ１＿１__e:ライデン_015]
		//……。
	}
	talk 大佐 標準 -m {
		[P027_01_R01_爆弾解体後昇降機ホール１無線デモ１＿１__e:大佐_016]
		//無線は通じないようだが？
	}
	talk ライデン 標準 -m {
		[P027_01_R01_爆弾解体後昇降機ホール１無線デモ１＿１__e:ライデン_017]
		//俺一人では、任務遂行は無理だ。
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P027_01_R01_爆弾解体後昇降機ホール１無線デモ１＿１__e:大佐_018]
		//あの男はシミュレーションには
		//入っていない。
	}
	talk 大佐 標準 -m {
		[P027_01_R01_爆弾解体後昇降機ホール１無線デモ１＿１__e:大佐_019]
		//あの男は＃｛要素、ファクター｝＃には入っていないのだ。
	}
	talk ライデン 標準 -m {
		[P027_01_R01_爆弾解体後昇降機ホール１無線デモ１＿１__e:ライデン_020]
		//大佐、何だって？
	}
@rp_うなづきデフォルト＿是
@rp_かみあわない＿否１＿話聞けよ系デフォルト 100
	talk 大佐 標準 -m {
		[P027_01_R01_爆弾解体後昇降機ホール１無線デモ１＿１__e:大佐_021]
		//君の任務はあくまでも単独作戦行動……。
	}
	talk ライデン 標準 -m {
		[P027_01_R01_爆弾解体後昇降機ホール１無線デモ１＿１__e:ライデン_022]
		//ＳＥＡＬＳの再突入はないのか？
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P027_01_R01_爆弾解体後昇降機ホール１無線デモ１＿１__e:大佐_023]
		//まだ目処も立ってない。
	}
@rp_無茶指令＿否１＿お前がやれ系デフォルト 100
	talk 大佐 標準 -m {
		[P027_01_R01_爆弾解体後昇降機ホール１無線デモ１＿１__e:大佐_024]
		//我々は待つしかできない。
		//君だけが頼りなんだ。
	}
	talk ライデン 標準 -m {
		[P027_01_R01_爆弾解体後昇降機ホール１無線デモ１＿１__e:ライデン_025]
		//……わかった。
	}
	talk 大佐 標準 -m {
		[P027_01_R01_爆弾解体後昇降機ホール１無線デモ１＿１__e:大佐_026]
		//ライデン、大統領の救出に向かってくれ。
		//まずＡ脚上部に上がるんだ。
	}
}//v
}//d




//resource P030_01_R01_フォーチュン戦中無線無線デモ１＿１ 
proc vc113001:01  {
vox t:vc113001 {
	talk 大佐 標準 -m {
		[P030_01_R01_フォーチュン戦中無線無線デモ１＿１__e:大佐_000]
		//ライデン、ファットマンから
		//こちらに直接連絡があった。
	}
	talk ライデン 標準 -m {
		[P030_01_R01_フォーチュン戦中無線無線デモ１＿１__e:ライデン_001]
		//ファットマンから？
	}
@rp_うなづきデフォルト
	talk 大佐 標準 -m {
		[P030_01_R01_フォーチュン戦中無線無線デモ１＿１__e:大佐_002]
		//ああ。ヘリポートにまた仕掛けたらしい。
		//ライデン、君を指定してきている。
	}
	talk ライデン 標準 -m {
		[P030_01_R01_フォーチュン戦中無線無線デモ１＿１__e:ライデン_003]
		//なに！？
	}
	talk 大佐 標準 -m {
		[P030_01_R01_フォーチュン戦中無線無線デモ１＿１__e:大佐_004]
		//スティルマンが亡くなって、
		//次のターゲットは君らしい。
	}
	talk ライデン 標準 -m {
		[P030_01_R01_フォーチュン戦中無線無線デモ１＿１__e:ライデン_005]
		//なぜ俺なんだ？
	}
	talk 大佐 標準 -m {
		[P030_01_R01_フォーチュン戦中無線無線デモ１＿１__e:大佐_006]
		//わからん。
	}
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		[P030_01_R01_フォーチュン戦中無線無線デモ１＿１__e:ライデン_007]
		//こっちはそれどころじゃないぞ！
	}
	talk 大佐 標準 -m {
		[P030_01_R01_フォーチュン戦中無線無線デモ１＿１__e:大佐_008]
		//すでにタイマーが起動している。
	}
	talk ライデン 標準 -m {
		[P030_01_R01_フォーチュン戦中無線無線デモ１＿１__e:ライデン_009]
		//なんてこった、後いくらだ？
	}
	talk 大佐 標準 -m {
		[P030_01_R01_フォーチュン戦中無線無線デモ１＿１__e:大佐_010]
		//カウントを表示する。
	}
}//v
}//d

