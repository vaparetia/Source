@rp_邪道外道＿否２＿ひどい系デフォルト 100
@rp_うなづきデフォルト＿是
	talk 大統領 標準 -m {
		[P049_10_R04_大統領１０無線機デモ４＿１__e:大統領_017]
		//もう時間がない。アーセナルギア起動の
		//鍵はブラックケースが兼ねていたが……
		//私が入力してしまった。
	}
	talk 大統領 標準 -m {
		[P049_10_R04_大統領１０無線機デモ４＿１__e:大統領_017_1]
		//もう時間がない。アーセナルギア起動の
		//鍵はブラックケースが兼ねていたが……
		//私が入力してしまった。
	}
	talk 大統領 標準 -m {
		[P049_10_R04_大統領１０無線機デモ４＿１__e:大統領_018]
		//じきに『Ｇ．Ｗ』は外部と接続を開始し、
		//アーセナルギアの機関部も始動する。
	}
	talk 大統領 標準 -m {
		[P049_10_R04_大統領１０無線機デモ４＿１__e:大統領_018_1]
		//じきに『Ｇ．Ｗ』は外部と接続を開始し、
		//アーセナルギアの機関部も始動する。
	}
@rp_うなづきデフォルト＿是
@rp_無茶指令＿否１＿お前がやれ系デフォルト 100
	talk 大統領 標準 -m {
		[P049_10_R04_大統領１０無線機デモ４＿１__e:大統領_019]
		//そうなる前に奴を止めろ。
		//【】それが君の役割だ。
	}
	talk ライデン 標準 -m {
		[P049_10_R04_大統領１０無線機デモ４＿１__e:ライデン_020]
		//役割……？
	}

command セットサウンドコード -c d:SNG_FIN_M

	talk 大統領 標準 -m {
		[P049_10_R04_大統領１０無線機デモ４＿１__e:大統領_021]
		//動き出したあれを止められるのは
		//エマ・エメリッヒしかいない。
		//【】彼女を探せ。
	}
	talk ライデン 標準 -m {
		[P049_10_R04_大統領１０無線機デモ４＿１__e:ライデン_022]
		//エマ……エメリッヒ？
	}
@rp_うんちく＿是１＿詳しいな系デフォルト 100
@rp_うなづきデフォルト＿是
	talk 大統領 標準 -m {
		[P049_10_R04_大統領１０無線機デモ４＿１__e:大統領_023]
		//アーセナルギアのシステム・
		//プログラマだ。この中央棟のＢ１で
		//監禁されているはず。
	}
	talk 大統領 標準 -m {
		[P049_10_R04_大統領１０無線機デモ４＿１__e:大統領_023_1]
		//アーセナルギアのシステム・
		//プログラマだ。この中央棟のＢ１で
		//監禁されているはず。
	}
	talk ライデン 標準 -m {
		[P049_10_R04_大統領１０無線機デモ４＿１__e:ライデン_024]
		//この下は浸水しているのでは？
	}
	talk 大統領 標準 -m {
		[P049_10_R04_大統領１０無線機デモ４＿１__e:大統領_025]
		//いや、彼女はまだ生かされている。
		//残っているプログラマは彼女だけだ。
	}
	talk 大統領 標準 -m {
		[P049_10_R04_大統領１０無線機デモ４＿１__e:大統領_026]
		//オセロットが言っていた……
		//Ｂ１の北西にあるロッカールームだ。
	}
	talk 大統領 標準 -m {
		[P049_10_R04_大統領１０無線機デモ４＿１__e:大統領_027]
		//急げ！
		//通信をとくぞ。
	}
	command セットサウンドコード -c d:SNG_FIN_S

}//v
}//d




//resource P049_12_R05_大統領１２無線機デモ５＿１ 
