}//d



//resource P040_06_R02_エイムズ発見６無線デモ２＿１ 
proc vc114011:01  {
vox t:vc114011 {
	talk エイムズ 標準 -m {
		[P040_06_R02_エイムズ発見６無線デモ２＿１__e:エイムズ_000]
		//それより、奴等は何を？
	}
	talk ライデン 標準 -m {
		[P040_06_R02_エイムズ発見６無線デモ２＿１__e:ライデン_001]
		//コード入力は終わったと言っていた……。
	}
	talk エイムズ 標準 -m {
		[P040_06_R02_エイムズ発見６無線デモ２＿１__e:エイムズ_002]
		//やはり……。
	}
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		[P040_06_R02_エイムズ発見６無線デモ２＿１__e:ライデン_003]
		//あんた、ブラックケースは大統領が
		//自分の意志で入力しなければならない、
		//と言ったな。
	}
	talk エイムズ 標準 -m {
		[P040_06_R02_エイムズ発見６無線デモ２＿１__e:エイムズ_004]
		//ああ。
	}
	talk ライデン 標準 -m {
		[P040_06_R02_エイムズ発見６無線デモ２＿１__e:ライデン_005]
		//では大統領自身が奴等に手を貸している
		//と言うことか？	
	}
	talk エイムズ 標準 -m {
		[P040_06_R02_エイムズ発見６無線デモ２＿１__e:エイムズ_006]
		//そうなるな。
	}
	talk ライデン 標準 -m {
		[P040_06_R02_エイムズ発見６無線デモ２＿１__e:ライデン_007]
		//一体なぜ？
	}
@rp_うなづきデフォルト
	talk エイムズ 標準 -m {
		[P040_06_R02_エイムズ発見６無線デモ２＿１__e:エイムズ_008]
		//人形でいることに飽きたんだろうよ。
		//我々を裏切るとは……愚かな。	
	}
	talk ライデン 標準 -m {
		[P040_06_R02_エイムズ発見６無線デモ２＿１__e:ライデン_009]
		//……人形？
	}
@rp_かみあわない＿否１＿話聞けよ系デフォルト 100
	talk エイムズ 標準 -m {
		[P040_06_R02_エイムズ発見６無線デモ２＿１__e:エイムズ_010]
		//もう時間がないぞ。奴等は必ず核を撃つ。
		//その前に大統領を……。
	}
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		[P040_06_R02_エイムズ発見６無線デモ２＿１__e:ライデン_011]
		//核を撃つ？
		//要求のタイムリミットまでは
		//まだ時間があるぞ。
	}
	talk エイムズ 標準 -m {
		[P040_06_R02_エイムズ発見６無線デモ２＿１__e:エイムズ_012]
		//要求？。
	}
	talk ライデン 標準 -m {
		[P040_06_R02_エイムズ発見６無線デモ２＿１__e:ライデン_013]
		//現金３００億ドル……。
	}
	talk エイムズ 標準 -m {
		[P040_06_R02_エイムズ発見６無線デモ２＿１__e:エイムズ_014]
		//何を言っている？
		//核攻撃は脅迫の手段などではない。
		//それこそが奴等の目的だ。
	}
	talk ライデン 標準 -m {
		[P040_06_R02_エイムズ発見６無線デモ２＿１__e:ライデン_015]
		//大量虐殺が！？
	}
@rp_うなづきデフォルト
	talk エイムズ 標準 -m {
		[P040_06_R02_エイムズ発見６無線デモ２＿１__e:エイムズ_016]
		//いや。奴等は高空で核を使うつもりだ。
		//聞いたことがあるだろう？
		//コンプトン効果やスカラー電磁波……。
	}
	talk ライデン 標準 -m {
		[P040_06_R02_エイムズ発見６無線デモ２＿１__e:ライデン_017]
		//核爆発による電子機器の破壊か？
	}
@rp_うんちく＿否３＿わかってんのか系デフォルト 100
	talk エイムズ 標準 -m {
		[P040_06_R02_エイムズ発見６無線デモ２＿１__e:エイムズ_018]
		//そうだ。大気中で核爆発が起こると
		//５兆メガワットを越える強烈な
		//電磁パルスが発生する。
	}
	talk エイムズ 標準 -m {
		[P040_06_R02_エイムズ発見６無線デモ２＿１__e:エイムズ_018_1]
		//そうだ。大気中で核爆発が起こると
		//５兆メガワットを越える強烈な
		//電磁パルスが発生する。
	}
	talk エイムズ 標準 -m {
		[P040_06_R02_エイムズ発見６無線デモ２＿１__e:エイムズ_019]
		//電磁場の強さは数万ボルト／メートル
		//にもなり、一般の電子機器は全て
		//破壊される。
	}
	talk エイムズ 標準 -m {
		[P040_06_R02_エイムズ発見６無線デモ２＿１__e:エイムズ_019_1]
		//電磁場の強さは数万ボルト／メートル
		//にもなり、一般の電子機器は全て
		//破壊される。
	}
}//v
}//d





