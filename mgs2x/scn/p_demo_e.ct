	talk ライデン 標準 -m {
		[P023_01_R01_爆弾解体最後の一つ１無線デモ１＿１__e:ライデン_005]
		//シェル１にもあると思うか？	
	}
	talk ピーター 標準 -m {
		[P023_01_R01_爆弾解体最後の一つ１無線デモ１＿１__e:ピーター_006]
		//ある。
		//おそらく、Ａ脚底部の何処か。
	}
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		[P023_01_R01_爆弾解体最後の一つ１無線デモ１＿１__e:ライデン_007]
		//確かか？
	}
	talk ピーター 標準 -m {
		[P023_01_R01_爆弾解体最後の一つ１無線デモ１＿１__e:ピーター_008]
		//この脚底部を破壊すると、シェル２は
		//ほぼ壊滅する。
	}
	@rpd_プリスキン顔表示
	talk プリスキン 標準 -m {
		[P023_01_R01_爆弾解体最後の一つ１無線デモ１＿１__e:プリスキン_009]
		//シェル２が沈むという事か？
	}
	@rpd_ピーター顔表示
	talk ピーター 標準 -m {
		[P023_01_R01_爆弾解体最後の一つ１無線デモ１＿１__e:ピーター_010]
		//いや、すぐには沈まん。この脚が
		//破壊されてもまだ５脚残っている。
	}
@rp_うなづきデフォルト
	talk ピーター 標準 -m {
		[P023_01_R01_爆弾解体最後の一つ１無線デモ１＿１__e:ピーター_013]
		//ただし、シェル１も同時に爆発すれば
		//そうはいかない。
	}
	talk ピーター 標準 -m {
		[P023_01_R01_爆弾解体最後の一つ１無線デモ１＿１__e:ピーター_014]
		//『ビッグ・シェル』は微妙な均衡で
		//姿勢を保っている。
	}
	talk ピーター 標準 -m {
		[P023_01_R01_爆弾解体最後の一つ１無線デモ１＿１__e:ピーター_015]
		//シェル１も爆破されれば自重を
		//支え切れなくなり……自壊する。
	}
@rp_うなづきデフォルト
	talk ライデン 標準 -m {
		[P023_01_R01_爆弾解体最後の一つ１無線デモ１＿１__e:ライデン_016]
		//どうすればいい？
	}
	talk ピーター 標準 -m {
		[P023_01_R01_爆弾解体最後の一つ１無線デモ１＿１__e:ピーター_017]
		//無臭のＣ４も探知できるセンサーがある。
		//中性子後方散乱装置と水素爆発物探知機
		//を併用したものだ。
	}
	talk ピーター 標準 -m {
		[P023_01_R01_爆弾解体最後の一つ１無線デモ１＿１__e:ピーター_017_1]
		//無臭のＣ４も探知できるセンサーがある。
		//中性子後方散乱装置と水素爆発物探知機
		//を併用したものだ。
	}
}//v
}//d

