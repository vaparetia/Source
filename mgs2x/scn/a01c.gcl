//	define
/**************************************************************************************/
// デバッグ設定
#ifdef d:FIX_MODE
	#define MY_DEBUG		0		// デバッグ
	#define ASSERT			0
#else
	#define MY_DEBUG		0		// デバッグ
	#define ASSERT			1
#endif

#define VAR_SAVE			1	// フラグのセーブ

#define STAGE_TANKER		1	// モード共通 プロック切り分け用
#define STAGE_W01C			1	// ステージ名 共通プロック切り分け用
#define STAGE_ALT			1	// オールタナティブステージ切り分け用

#define PLAYER				スネーク

// 薬莢
#define ENE_T_GOL			1	// タンカー編ゴル兵
#define	ENE_SHOT			1	// ショットガン兵
#define	ENE_SHIELD 			1	// 盾兵

// プラグイン
#define STAGE_END			1
#define PAN_CAMERA			1


/**************************************************************************************/
// リソース
/**************************************************************************************/
// コマンダー危険時音声
resource ghq_area_alert_voice {
	w01c:
		$t{
			t:vc040017, //「了解。応援部隊、船橋三階居住区へ向かえ、左舷を固めろ」
			t:vc040018, //「了解。応援を船橋三階左舷に派遣する。敵を包囲せよ。」
			-2,
			t:vc040019, //「了解。応援部隊、船橋三階の居住区に向かえ。階段を守れ。」
			t:vc04001a, //「了解。バックアップ、船橋三階の階段へ向かえ。敵の前進を阻止せよ！」
			-2,
			t:vc04001b, //「了解。応援部隊、船橋三階へ急行。右舷を固めろ。」
			t:vc04001c, //「了解。増援部隊、船橋三階右舷に向かえ。敵を包囲せよ。」
			-1
		}
	}
// コマンダー警戒時音声
resource ghq_caution_voice {
	w01c:
		$t{
			t:vc040043,	// 「了解。船橋三階居住区に増員。階段を固めろ」
			-2,
			// 連絡が途絶えた時の音声
			t:vc04006c, // 「船橋三階居住区との連絡が途絶えた。」
			-3,
			t:vc040603,
			-1	// 全ての登録終了
		}
	a01c:
		$t{
			t:vc046601, //「了解、総員警戒を強化せよ」
			-2,
			// 連絡が途絶えた時の音声
			t:vc04006c, // 「船橋三階居住区との連絡が途絶えた。」
			-3,
			t:vc040603,
			-1	// 全ての登録終了
		}
	}

/***************************************************************************************/
// Include (enumの後に設定)
/***************************************************************************************/
#include "sna_w01c.mh"		// 強制モーションリスト
#include "stdch.h"
