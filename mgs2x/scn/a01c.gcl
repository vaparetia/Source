/***************************************************************************************/
// マップ宣言
/***************************************************************************************/
	// アナザー用プロック マップ設定前に設定する
	@アナザー用マップ定義前設定					// a_mode.h

	// マップ
	chara マップ 三階 -k w01c -h a01c -l w01c
	chara 天井君 天井 -m w01cr -h 8750 -p 0,0,0  -l w01c

/****************************************************************************************/
// 各マップのキャラ設定
/****************************************************************************************/
	command マップ設定 三階 -set {
		@ローカル変数初期化
		@常駐キャラ設定							// stdch.h
		@A_プレイヤー設定 sna_w01c rai_w01c		// a_stdproc.h
	}

	// アナザー用プロック マップ設定後に設定する
	@アナザー用マップ定義後設定					// a_mode.h

	// マップ設定
	command マップ設定 三階 -s {
		//@サウンドマネージャーセット		// サウンドマネージャー＞敵兵コマンダー＞ＢＧＭマネージャー
		@跳弾設定
		//@ポーズ時ステージ名表示設定 d:wn_船橋三階居住区

		@各種カメラ作成
		@子画面設定

		@デフォルトカメラセット
		@三階カメラ１
		@三階カメラ２
		@三階カメラ３
		@三階カメラ４
		@三階カメラ５
		@三階カメラ６_二階へ（左）
		@三階カメラ７_二階へ（右）
		@三階カメラ８_南端カメラ下張り付き

		@床面映り込みセット

		@ロード_四階へ移動
		@ロード_左舷二階へ移動
		//@ロード_右舷二階へ移動

		@壊れライトセット
		@四階への階段前踊り場の壁消去セット

		//@監視カメラセット

		@消火器セット
		@ロッカーセット
		@５０ｃｍ隙間用透明壁
		@イントルード主観カメラ補正設置

		#if d:MY_DEBUG
			@ＵＳＢキーボード
			//@スクリーンショット使用
		#endif

	} // <command マップ設定 三階>の閉じカッコ

	// 最後で行う処理
	command マップ設定 三階 \
	-set {
		//@タンカーデジカメ写真判定
		@キャラクタ専用ライトセット
	}

/***************************************************************************************/
// マップの起動
/***************************************************************************************/
	command マップ表示 -show 三階

	if( $s:登場ポイント == a01bから来た三階左舷 ) {
		@ステージ開始時処理（ステージ名表示） \
			d:LOAD_TYPE:NO_DOOR_TYPE \
			左舷三階 \
			1000 \
			d:DEFAULT_M_TYPE \
			d:wn_船橋三階居住区左舷

	} else {
		@ステージ開始時処理（ステージ名表示） \
			d:LOAD_TYPE:NO_DOOR_TYPE \
			四階から来た \
			1400 \
			d:DEFAULT_M_TYPE \
			d:wn_船橋三階居住区
	}

/***************************************************************************************/
// 各プロックの設定
/***************************************************************************************/
	proc ローカル変数初期化 {
	}

	proc 跳弾設定 {

		command 弾痕ノーマル -n 0
		command 弾痕ノーマル -n 1
		command 弾痕ノーマル -n 2
		command 弾痕ノーマル -n 3
		command 弾痕ノーマル -n 4

		command 跳弾ノーマル -n 0
		command 跳弾ノーマル -n 1
		command 跳弾ノーマル -n 2
		command 跳弾ノーマル -n 3
		command 跳弾ノーマル -n 4

		// 水蒸気の番号設定
		command 弾痕ノーマル -n 5
		command 弾痕ノーマル -n 6
		command 弾痕ノーマル -n 7
		command 跳弾水蒸気小 -n 5
		command 跳弾水蒸気中 -n 6
		command 跳弾水蒸気大 -n 7

	}

	proc ５０ｃｍ隙間用透明壁 {
		@東西５０ｃｍ幅透明壁設置 ５０ｃｍ隙間壁 11375 6000 -15000 2000
	}

	// キャラクタ専用ライト関係
	proc キャラクタ専用ライトセット {
		chara 環境光 環境光 \
			 -c 60,60,60

		chara 平行光 平行光 \
			 -c 100,100,80 \
			 -d 959,2048,0

		chara フォグ フォグ \
			 -c 40,35,20 \
			 -n 0 \
			 -f 25000
	}

	// カメラ設定
	// ------------------------------------
	proc 各種カメラ作成 {
		chara カメラ ステージカメラ	-c 0 -l 3 -p 0
		chara カメラ カットインカメラ -c 0 -l 0 -p 40
		chara カメラ サブカメラ１	-c 0 -l 2 -p 30
		chara カメラ サブカメラ２	-c 0 -l 2 -p 20
		chara カメラ サブカメラ３	-c 0 -l 2 -p 10
	}

	// 子画面設定
	proc 子画面設定 {
		chara サブ画面 子画面
	}

	// デフォルトカメラ
	proc デフォルトカメラセット {
		chara カメラ設定 ステージカメラ \
			-c 0 \
			-b -32000,-32000,-32000 32000,32000,32000 \
			-l -32000,-32000,-32000 32000,32000,32000 \
			-r 640,2048,0 \
			-f 6000 \
			-a 200 \
			-i 1 -1 0 0 \
			-s 1
	}

/***************************************************************************************/
// 各カメラ
/***************************************************************************************/

	proc 三階カメラ１ {
		trap ca000 スネーク \
			-mask ＊ \
			-camera \
			-exec {
				@全部補完カメラ $6	-15250 -14500 \
									-772 -293 \
									8609 10486 \
									-10304 -12773 \
									-354 -293 \
									7425 7425 \
									-13913 -13847

				chara カメラ設定 サブカメラ１ \
					-c 1 \
					-p $i:補完ＰＸ $i:補完ＰＹ $i:補完ＰＺ \
					-t $i:補完ＴＸ $i:補完ＴＹ $i:補完ＴＺ \
					-r 205,2048,0 -f 3845 \
					-a 200 \
					-i 2 2 0 0 \
					-s $3
			}
	}

	// 中央廊下（左右）
	proc 三階カメラ２ {
		trap ca001 スネーク \
			-mask ＊ \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ１ \
					-c 0 \
					-b -7700,10486,-12773 7700,10486,-12773 \
					-l -7700,-32000,-13847 7700,32000,-13847 \
					-r 240,2048,0 \
					-f 6000 \
					-a 170 \
					-i 0 -1 0 0 \
					-s $3 \
					-slide 0 30 1000 1000 45 1
			}
	}

	// 左端の小部屋
	proc 三階カメラ３ {
		trap ca004 スネーク \
			-mask ＊ \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ１ \
					-c 1 \
					-p -10361,10417,-12600 -t -10382,7643,-13825 \
					-r 753,2059,0 -f 3032 \
					-a 160 \
					-i 0 -1 0 0 \
					-s $3
		}
	}

	// 右端の小部屋
	proc 三階カメラ４ {
		trap ca005 スネーク \
			-mask ＊ \
			-camera \
			-exec {
				chara カメラ設定 サブカメラ１ \
					-c 1 \
					-p 10361,10417,-12600 -t 10382,7643,-13825 \
					-r 753,2037,0 -f 3032 \
					-a 160 \
					-i 0 -1 0 0 \
					-s $3
			}
	}

	// 中央の小部屋
	proc 三階カメラ５ {
		trap ca006 スネーク \
			-mask ＊ \
			-camera \
			-exec {
				@全部補完カメラ $6	-15250 -14500 \
									-772 -293 \
									8609 10486 \
									-10304 -12773 \
									-354 -293 \
									7425 7425 \
									-13913 -13847

				chara カメラ設定 サブカメラ１ \
					-c 1 \
					-p $i:補完ＰＸ $i:補完ＰＹ $i:補完ＰＺ \
					-t $i:補完ＴＸ $i:補完ＴＹ $i:補完ＴＺ \
					-r 205,2048,0 -f 3845 \
					-a 200 \
					-i 2 2 0 0 \
					-s $3
			}
	}

	// 二階への階段（左）
	proc 三階カメラ６_二階へ（左） {
		trap ca002 スネーク \
			-mask ＊ \
			-camera \
			-exec {
				#if 1
					@CS_スムーズカメラ昇順 $6 -14824 -13545 10450 10511

					eval($i:補完ＰＹ = $i:CS_結果１)

					chara カメラ設定 サブカメラ１ \
						-c 0 \
						-b -10396,$i:補完ＰＹ,-13530 -10396,$i:補完ＰＹ,-13530 \
						-l -10396,7553,-14824 -10396,7553,-13545 \
						-a 170 \
						-i 0 -1 0 0 \
						-s $3
				#else
						chara カメラ設定 サブカメラ１ \
							-c 1 \
							-p -11338,9000,-14492 \
							-t -11200,6950,-13243 \
							-a 170 \
							-i 0 -1 0 0 \
							-s $3
				#endif
			}
	}

	// 二階への階段（右）
	proc 三階カメラ７_二階へ（右） {
		trap ca003 スネーク \
			-mask ＊ \
			-camera \
			-exec {
						chara カメラ設定 サブカメラ１ \
							-c 1 \
							-p 11338,9000,-14492 \
							-t 11200,6950,-13243 \
							-a 170 \
							-i 0 -1 0 0 \
							-s $3
			}
	}

	// 南端壁設置カメラすり抜け用に
	proc 三階カメラ８_南端カメラ下張り付き {
		trap ca008 スネーク \
			-mask ＊ \
			-camera \
			-state d:TRP_STATE_BEHINDCAMERA_ENABLE \
			-exec {
				chara カメラ設定 サブカメラ２ \
					-c 0 \
					-b -10000,10814,-12697 10000,10814,-12697 \
					-l -10000,7855,-13715 10000,7855,-13715 \
					-a 180 \
					-i 2 2 0 0 \
					-s $3 \
					//-r 239,2048,0 -f 5999 \
					-r 644,2048,0 -f 2474 \
					-z d:CAMERA_NO_CUSHION
			}
	}

	proc 床面映り込みセット {
		chara 鏡面モデル管理 床面映り込み \
			-pos 0,6000,0 \
			-axis 1 // Y軸反転

		trap ev100 ？ \
			-mask ？ \
			-exec {
				if($3 == 入る) {
					mesg 鏡面モデル管理 床面映り込み add $2
				} else {
					mesg 鏡面モデル管理 床面映り込み del $2
				}
			}
	}


/***************************************************************************************/
// 入出ロードのproc化
/***************************************************************************************/
	proc ロードプロック {
		if ($s:呼び出しプロック == mv_a01c_a01d_0) {
			@mv_a01c_a01d_0
		} else if ($s:呼び出しプロック == mv_a01c_a01b_0) {
			@mv_a01c_a01b_0
		} else if ($s:呼び出しプロック == mv_a01c_a01b_1) {
			@mv_a01c_a01b_1
		}
	}



	// 四階へ
	proc ロード_四階へ移動 {
		trap ld000 d:PLAYER \
			-mask 入る \
			-exec {
				preseek 'a01d'
				@ステージ終了時処理（ステージ名表示） \
					900 9000 -19000 \
					d:NORTH \
					mv_a01c_a01d_0 \
					d:DEFAULT_M_TYPE \
					d:wn_船橋四階居住区
				eval($i:w01d_直前のマップ = 3)
		}
	}

	proc ロード_左舷二階へ移動 {
		trap ld001 d:PLAYER \
			-mask 入る \
			-exec {
				if( $f:ロードチェックＯＮフラグ == 1 ) {
					chara カメラ設定 サブカメラ３ \
						-c 1 \
						-p -10361,10417,-12600 -t -10382,7643,-13825 \
						-r 752,2060,0 -f 3032 \
						-a 160 \
						-i 3 0 0 0 \
						-s 1
					preseek 'a01b'
					@ステージ終了時処理（ステージ名表示） \
						-11250 3000 -9750 \
						d:SOUTH \
						mv_a01c_a01b_0 \
						d:DEFAULT_M_TYPE \
						d:wn_船橋二階居住区左舷
				}

		}
	}

	proc 壊れライトセット {
		chara プットスポットライトオブジェ 蛍光灯モデル１ \
			-m w01c_lit1a w01c_lit1b \
			-t 11260,8650,-16050 60 2200 \
			-l w01c \
			-p 11260,8650,-16050
	//		-f d:BRK_LGT_SHOWTRGT
		chara プットスポットライトオブジェ 蛍光灯モデル２ \
			-m w01c_lit1a w01c_lit1b \
			-t -11260,8650,-16050 60 2200 \
			-l w01c \
			-p -11260,8650,-16050
	//		-f d:BRK_LGT_SHOWTRGT
	}

	proc 四階への階段前踊り場の壁消去セット {
		chara プットオブジェ 階段前壁 \
			-m w01c_wall \
			-r 0 0 0 \
			-p 0 0 0 \
			-l w01c

		trap ev002 スネーク \
			-mask ＊ \
			-exec {
				if($i:カメラＺ位置 > -12500) {
					if(/*$f:w01d_南端壁存在*/0){
						eval($f:w01c_階段前壁存在 = 0)
						mesg プットオブジェ 階段前壁 off
					}
				} else {
					if(/*!$f:w01d_南端壁存在*/1){
						eval($f:w01c_階段前壁存在 = 1)
						mesg プットオブジェ 階段前壁 on
					}
				}
			}
	}

	proc 監視カメラセット {
		// 難易度毎に縦視野角と振りを変える
		if ($w:ゲーム設定 == d:LEVEL_VERYEASY) {
			eval($i:振り幅   =   0)
			eval($i:横視野角 = 256)
		} else if ($w:ゲーム設定 == d:LEVEL_EASY) {
			eval($i:振り幅   =   0)
			eval($i:横視野角 = 256)
		} else if ($w:ゲーム設定 == d:LEVEL_NORMAL) {
			eval($i:振り幅   =   0)
			eval($i:横視野角 = 256)
		} else if ($w:ゲーム設定 == d:LEVEL_HARD) {
			eval($i:振り幅   = 256)
			eval($i:横視野角 = 480)
		//} else if ($w:ゲーム設定 == d:LEVEL_EXTREME) {
		} else {
			eval($i:振り幅   = 256)
			eval($i:横視野角 = 480)
		}

		@カメラ再セットチェック $b:w01c_カメラ破壊ロード回数[0]
		if ( $f:再セットフラグ == d:TRUE ) {
			eval( $b:w01c_カメラ破壊フラグ[0] = 0 );
		}

		chara 監視カメラ 監視カメラ中央 \
			-pos -5500 8500 -14500 \
			-rot 400 0 0 \ 				/*ＸＹ値のみ有効*/
			-center 350 0 \
			-dir $i:振り幅 \
			-xran 512 \ 				/*省略可*/
			-yran $i:横視野角 \ 		/*省略可*/
			-i 4000 \					/*省略可*/
			//-status $f:w01c_監視カメラ破壊フラグ \
			-status $b:w01c_カメラ破壊フラグ[0] \
			-exec {
				//eval($f:w01c_監視カメラ破壊フラグ = 1)
				eval( $b:w01c_カメラ破壊ロード回数[0] = $w:グローバルロード回数);
				eval( $b:w01c_カメラ破壊フラグ[0] = $2 );
			}

		chara 鏡面モデル管理 壁面映り込み \
			-pos 0,0,-14500 \
			-axis 2 // Z軸反転
		mesg 鏡面モデル管理 壁面映り込み add 監視カメラ中央

	}

	proc 消火器セット {
		chara 消火器 消火器１ \
			-r 0 1024 0 \
			-p -9500 6000 -12650 \
			-l w01c \
			-b -10625 6000 -16000 \
			   -9000 9000 -12625

		chara 消火器 消火器２ \
			-r 0 1024 0 \
			-p 9500 6000 -12650 \
			-l w01c \
			-b 9000 6000 -16000 \
			   11875 9000 -12500
	}

/***************************************************************************************************/
// ロッカー設置
/***************************************************************************************************/
	proc ロッカーチェック $:番号 {
		@壊れ物再セットチェック $b:w01c_破壊ロード回数[$:番号]
		if($f:再セットフラグ) {
			eval($i:w01c_ロッカーロード回数[$:番号] = 0)
		}
	}

	proc ロッカー状態保存 $:番号 $:行動 $:ロッカー名 {
		if(($:行動 != 6) && ($:行動 != 8)) {
			// 状態変化時
			eval($b:w01c_破壊ロード回数[$:番号] = $w:グローバルロード回数);
		} else if($:行動 == 8) {
			// ステージ終了時
			command ロッカー状態 -n $:ロッカー名
			eval($i:w01c_ロッカーロード回数[$:番号] = $status)
		}
	}

	proc ロッカーセット {
		chara ロッカー管理 管理人さん -n 1
		command ロッカーモーション -motion locker
		command プレイヤーロッカーモーション -motion sna_locker

		// ロッカー１設置
		@ロッカーチェック 0
		chara ロッカー ロッカー１ \
			-kms w01c_locker_dr \
			-p -1050,6000,-17900 \
			-seno 4 \
			-sefloor 4 \
			-r 0,0,0 \
			-down_rot 0 180 0 \
			//-s d:LOCKER_STATE_OPEN \
			//-flag 0x0001 \			// 影が投影される
			-load_state $i:w01c_ロッカーロード回数[0] \
			-exec {
				@ロッカー状態保存 0 $3 $4
			}
		// 開け閉め用トラップ
		trap lk000 d:PLAYER \
			-and \
			-mask いる \
			-state 0,4 \
			-dir 2048,512 0,512 \
			-button d:ACTION_BUTTON,-1 \
			-exec {
				print 'ロッカー ロッカー'
				command ロッカー状態 -n ロッカー１
				mesg プレイヤー d:PLAYER locker ロッカー１ $status 2048,512 -1050,(6000+50)
			}
		// 扉を開け閉めする時のカメラ
		trap lk000 d:PLAYER \
			-mask ？ \
			-state 6 \
			-exec {
				chara カメラ設定 サブカメラ２ \
					-c 1 \
					-p -1572,8492,-15561 -t -1545,7937,-16715 \
					-r 292,2033,0 -f 1280 \
					-a 200 \
					-i 2 2 0 0 \
					-s $3
			}
	}

	proc イントルード主観カメラ補正設置 {
		trap int_fence d:PLAYER \
			-mask ＊ \
			-dir 2048 256 \	//方向指定
			-exec {
				command イントルード主観カメラ補正 \
					//-se d:SD_A_LOCKHIT1 \
					-se d:se_code:SD_P_HEADNET1 \
					-len 1000 \
					-inout $3
			}
	}
/***************************************************************************************/
// 入出ロードのproc化
/***************************************************************************************/
#if d:MY_DEBUG
	proc ＵＳＢキーボード {
		chara USBキーボード実行 kao \
			-e d:KBD_R { command メニュー設定 -menu on -gage on -radar on -subwin on } \
			-e d:KBD_T { command メニュー設定 -menu off -gage off -radar off -subwin off }
	}

	proc スクリーンショット使用 {
		chara スクリーンショット スクリーンショット
	}
#endif
	

