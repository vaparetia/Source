*/

resource PHONE_地雷__e {
000: {
Be careful!
Claymore
mines are
set there.
}
}//d
/*気をつけろ！
そこにはクレイ
モア地雷がセット
されている。
*/

resource PHONE_リモコン近道__e {
000: {
Fire remote-
controlled
missile from...
}
001: {
a dark small
room on the
south-west
section...
}
002: {
to destroy the 
electric distri-
bution panel
with ease.
}
}//d
/*
