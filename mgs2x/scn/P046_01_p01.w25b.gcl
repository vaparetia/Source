	chara プットオブジェ w25ab_other02	-m w25ab_other02	-p 0,0,0  -l d:LT2_NAME -r 0,0,0 
}

// ステージ切り替えプロック
// --------------------------------------
proc w25a_w25bステージ切替 {
	@w25a_ステージ削除
	@w25b_ステージオン
}

proc w25a_ステージ削除 {
	mesg プットオブジェ w25a0       kill
	mesg プットオブジェ w25a0_obj01 kill
	mesg プットオブジェ w25a1       kill
	mesg プットオブジェ w25a1_obj01 kill
	mesg プットオブジェ w25a_brk00b kill
	mesg プットオブジェ w25a_brk01b kill
	mesg プットオブジェ w25a_brk02b kill
	mesg プットオブジェ w25a_gl     kill
	mesg プットオブジェ w25a_g      kill
}

proc w25b_ステージオン {
	mesg  プットオブジェ w25b_step00	on
	mesg  プットオブジェ w25b0		on
	mesg  プットオブジェ w25b1		on
	mesg  プットオブジェ w25b_g		on
	mesg  プットオブジェ w25b0_wall		on

	mesg  プットオブジェ w25demo_14a	on
	mesg  プットオブジェ w25demo_16a	on
	mesg  プットオブジェ w25demo_18a		on
	mesg  プットオブジェ w25demo_20a		on
	mesg  プットオブジェ w25demo_21a		on
	mesg  プットオブジェ w25demo_24a		on
	mesg  プットオブジェ w25demo_31a	on
	mesg  プットオブジェ w25demo_h		on
	mesg  プットオブジェ w25demo_hi		on
	mesg  プットオブジェ w25demo_i		on
	mesg  プットオブジェ w25demo_ij		on
	mesg  プットオブジェ w25demo_kl		on
	mesg  プットオブジェ w25demo_l		on
	mesg  プットオブジェ w25demo_g		on
}

// その他プロック
// --------------------------------------
proc 水中ゆらぎ {
	chara 水中カメラ ゆらぎマン \
		-col 90 128 130 \ // RGB
		-warp 1 // ゆらぎの大きさ
	command 水位設定 -lv -40000
}

// [追加] 2001/08/30 Uehara Masatoshi
proc リアル影セット {
	chara 影投影モデル 影もでる \
		-m w25demo_sdw01 \
		-p -1 1 -1

	chara 影管理 影かんり \
		-t 0 \
		-p -200 -1000 -400
//		-p -100 -300 -200

	mesg 影管理 影かんり add vmp_coat_mh_demo02 影もでる	// ヴァンプ
}

proc 拡張海面設定 {
    chara 拡張海表示 sea_serface_ex		\
	-t	entyou_oil_sea			\
	-pos	0,-40000,-150000		\
	-color  145 185 120			\
	-lines  5
}

