	command 弾痕ノーマル -n 1
	command 弾痕ノーマル -n 2
	command 弾痕ノーマル -n 3
	command 弾痕ノーマル -n 4

	command 跳弾ノーマル -n 0
	command 跳弾ノーマル -n 1
	command 跳弾ノーマル -n 2
	command 跳弾ノーマル -n 3
	command 跳弾ノーマル -n 4

	// 水蒸気の番号設定
	command 弾痕ノーマル -n 5
	command 弾痕ノーマル -n 6
	command 弾痕ノーマル -n 7
