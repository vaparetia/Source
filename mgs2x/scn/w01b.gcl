/***************************************************************************************************/
// プレイヤーの１フレーム前の座標を覚える
/***************************************************************************************************/
proc 座標チェック {
	chara プロック連続実行 毎フレーム処理 \
		-time -1 \
		-exec {
			eval( $i:前フレーム位置Ｘ = $i:プレイヤー位置Ｘ )
			eval( $i:前フレーム位置Ｚ = $i:プレイヤー位置Ｚ )
			command ゲットゲームステータス $i:ゲームステータス
		}
}

/***************************************************************************************************/
// エフェクト
/***************************************************************************************************/
	proc 羽虫チェック {

		if( $b:w01f_羽虫レーションゲッ虫回数 ) {
			eval( $b:w01f_羽虫レーションゲッ虫回数 = 0 )

			chara 電灯虫 たかり虫 \
				-n	1 \
				-p	4989 4027 -8451 \	// ライト位置 ->> プレイヤー誘導時は無視
				-b	0 \	// 下のバウンディングボックスで壁との当たり見るか  1 : 判定あり, 0 : 判定なし
				-s	200 200 200 \	// 最小ボックス座標
				-l	500 500 500	// 最大ボックス座標

			mesg 電灯虫 たかり虫 人誘導 d:PLAYER
		}
	}


proc 船首と雨のＯＮ／ＯＦＦ {
	trap ev004 d:PLAYER -mask 出る \
		-exec {
			if( $6 < -7000 ){
				#if d:SHIP_HEAD
					mesg  プットオブジェ 船首１ on
					mesg  プットオブジェ 船首２ on
					mesg  プットオブジェ 船首３ on
					mesg  プットオブジェ 船尾 off
				#endif
				#if d:RAIN_SET
					mesg 位置指定雨 常時北雨 オン
					mesg 位置指定雨 常時西雨 オフ
					mesg 位置指定雨 常時東雨 オフ
				#endif
			}else{
				#if d:SHIP_HEAD
					mesg  プットオブジェ 船首１ off
					mesg  プットオブジェ 船首２ off
					mesg  プットオブジェ 船首３ off
					mesg  プットオブジェ 船尾 on
				#endif
				#if d:RAIN_SET
					mesg 位置指定雨 常時北雨 オフ
					mesg 位置指定雨 常時西雨 オン
					mesg 位置指定雨 常時東雨 オン
				#endif
		}
	}
}


proc 消火器セット {
#if	d:FIRE_HOSE
	chara 消火器 消火器１ \
			-r 0 0 0 \
			-p -11650 3000 -13545 \
			-l w01b \
			-b -11750 3000 -16000 \
			   -9000 6000 -9000

	chara 消火器 消火器２ \
			-r 0 2048 0 \
			-p 11650 3000 -13545 \
			-l w01b \
			-b 9000 3000 -16000 \
			   11750 6000 -9000


	chara 消火器 消火器３ \
			-r 0 3072 0 \
			-p -7175 3000 -6850 \
			-l w01b \
			-b -7750 3000 -7000 \
			   -4000 6000 -2000

	chara 消火器 消火器４ \
			-r 0 3072 0 \
			-p 7175 3000 -6850 \
			-l w01b \
			-b 4000 3000 -7000 \
			   7750 6000 -2000
#endif
}

