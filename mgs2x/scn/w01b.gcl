			-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
			-l $w:敵標準体力 -f $w:敵標準気絶 -h $w:敵標準聴力 \
			-w 気付きプロック \
			-e 死亡プロック \
			-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
			-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
			-j ドッグタグ_敵兵	[ dogtag:tnk_w01b_guard_ve_01 ] \
								[ dogtag:tnk_w01b_guard_ea_01 ] \
								[ dogtag:tnk_w01b_guard_no_01 ] \
								[ dogtag:tnk_w01b_guard_ha_01 ] \
								[ dogtag:tnk_w01b_guard_vh_01 ]
	}

	proc 影見せ後兵 $:名前 {
		chara 警備兵 $:名前 \
			-r 7 -n 0 \
			-d d:ENE_DEF_X_1 d:ENE_DEF_Y_1 d:ENE_DEF_Z_1 ２Ｆ廻廊部 \	// 左舷北
			-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
			-l $w:敵標準体力 -f $w:敵標準気絶 -h $w:敵標準聴力 \
			-w 気付きプロック \
			-e 死亡プロック \
			-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
			-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
			-j ドッグタグ_敵兵	[ dogtag:tnk_w01b_guard_ve_01 ] \
								[ dogtag:tnk_w01b_guard_ea_01 ] \
								[ dogtag:tnk_w01b_guard_no_01 ] \
								[ dogtag:tnk_w01b_guard_ha_01 ] \
								[ dogtag:tnk_w01b_guard_vh_01 ]
	}

	proc 警備兵Ａ $:名前 {
		chara 警備兵 警備兵:02 \
			-r 13 -n 0 \
			-d d:ENE_DEF_X_3 d:ENE_DEF_Y_3 d:ENE_DEF_Z_3 ２Ｆ廻廊部 \	// 右舷クランク部
			-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
			-l $w:敵標準体力 -f $w:敵標準気絶 -h $w:敵標準聴力 \
			-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
			-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
			-j ドッグタグ_敵兵	[ dogtag:dummy ] \
								[ dogtag:dummy ] \
								[ dogtag:tnk_w01b_guard_no_02 ] \
								[ dogtag:tnk_w01b_guard_ha_02 ] \
								[ dogtag:tnk_w01b_guard_vh_02 ]
	}

	proc 警備兵セット {
		/*******************************************************************************************/
		// VERYEASY
		/*******************************************************************************************/
		if($w:ゲーム設定 <= d:LEVEL_VERYEASY) {

			if( $s:登場ポイント == 居住区三階左舷からロード ) {
				if( $f:w01b_影発見フラグ == 0 ){
					@影見せ兵Ａ 警備兵:01
				}else{
					@影見せ後兵 警備兵:01
				}
			}else{		// 一階、二階から進入
				if( $f:w01b_影発見フラグ == 0 ){
					@影見せ兵Ｂ 警備兵:01
				}else{
					@影見せ後兵 警備兵:01
				}
			}

		/*******************************************************************************************/
		// VERYEASY
		/*******************************************************************************************/
		} else if($w:ゲーム設定 <= d:LEVEL_EASY) {

			if( $s:登場ポイント == 居住区三階左舷からロード ) {
				if( $f:w01b_影発見フラグ == 0 ){
					@影見せ兵Ａ 警備兵:01
				}else{
					@影見せ後兵 警備兵:01
				}
			}else{		// 一階、二階から進入
				if( $f:w01b_影発見フラグ == 0 ){
					@影見せ兵Ｂ 警備兵:01
				}else{
					@影見せ後兵 警備兵:01
				}
			}

		/*******************************************************************************************/
		// NORMAL
		/*******************************************************************************************/
		} else if($w:ゲーム設定 <= d:LEVEL_NORMAL) {

			@警備兵Ａ 警備兵:02

			if( $s:登場ポイント == 居住区三階左舷からロード ) {
				if( $f:w01b_影発見フラグ == 0 ){
					@影見せ兵Ａ 警備兵:01
				}else{
					@影見せ後兵 警備兵:01
				}
			}else{
				if( $f:w01b_影発見フラグ == 0 ){
					@影見せ兵Ｂ 警備兵:01
				}else{
					@影見せ後兵 警備兵:01
				}
			}

		/*******************************************************************************************/
		// HARD or EXTREME or EUROPEAN_EXTREME
		/*******************************************************************************************/

		} else {

			@警備兵Ａ 警備兵:02

			if( $s:登場ポイント == 居住区三階左舷からロード ) {
				if( $f:w01b_影発見フラグ == 0 ){
					@影見せ兵Ａ 警備兵:01
				}else{
					@影見せ後兵 警備兵:01
				}
			}else{
				if( $f:w01b_影発見フラグ == 0 ){
					@影見せ兵Ｂ 警備兵:01
				}else{
					@影見せ後兵 警備兵:01
				}
			}
		}
	}

/***************************************************************************************************/
// コマンダーセット
/***************************************************************************************************/
	proc 警備兵コマンダーセット {
		chara 警備コマンダー wccomm -e 警備兵セット
	}

	proc 攻撃兵コマンダーセット {
		chara 攻撃コマンダー atcomm \
			//-status 0x01 \		// 危険モード時にワープ
			-e { 攻撃兵セット }
	}

	// リソース
	resource ghq_area_alert_voice {
		w01b:
			$t{
				// PLAREA0
				t:vc040014,	//「了解。応援部隊、船橋二階左舷階段へ急行。敵を包囲せよ！」（オルガ戦前）
				t:vc040015,	//「了解。応援部隊に出動要請。船橋二階居住区へ向かえ。左舷階段を死守せよ」（オルガ戦前）
				-2,
				t:vc040016, //「了解。応援部隊、船橋二階右舷階段へ急行。敵を包囲せよ！」（オルガ戦前）
				-1	// 全ての登録終了
			}
	}

	// リソース
	resource ghq_caution_voice {
		w01b:
			$t{
				t:vc04003d,	//「了解。船橋二階左舷階段に増員。警戒強化せよ！」（オルガ戦前）
				t:vc04003e,	//「了解。船橋二階居住区を増員する。左舷階段を固めろ」（オルガ戦前）
				//t:vc04003f, //「了解。船橋二階,一階への入り口を増員する。油断するな」（オルガ戦後）
				//t:vc040040, //「了解。船橋二階に増員。一階への入り口を固めろ」（オルガ戦後）
				-2,
				t:vc04006b,	// 「船橋居住区二階との連絡が途絶えた。」
				-1
			}
	}


	proc 居住区２Ｆ敵兵設定 {
		chara コマンダー 敵兵セット \
			-w 警備兵コマンダーセット \
			-a 攻撃兵コマンダーセット \
			-m $w:スタートアラートモード \
			-r 0,0,-13000 ２Ｆ廻廊部 \
			-c 0,0,-13000 ２Ｆ廻廊部 \
			-g 0 \
			-b $w:敵標準再発生数 \ // 生き返る敵兵数
			-z $i:敵標準麻酔持続 \
			-h $i:標準警戒時間 \
			-o $i:敵標準気絶持続 \
			-x [ghq_area_alert_voice:w01b] \
			-y [ghq_caution_voice:w01b] \
			-v [ene_tank_voice:01]
	}

/***************************************************************************************************/
// ルート変更
/***************************************************************************************************/
	proc 気付きプロック{
		print '何かに気づいた'
		eval( $f:警備兵なにかに気づいたフラグ = 1 )
		mesg 警備兵 警備兵:01 ルート変更 (8-1) -10000,3000,-10000 ２Ｆ廻廊部 0
	}

	proc 死亡プロック {
		eval( $f:警備兵なにかに気づいたフラグ = 1 )
	}

	proc 敵兵ルート変更 {
		// 影発見兵のルート変更
		trap en003 d:PLAYER \
			-mask 出る \
			-exec {
				if( $f:w01b_影発見フラグ == 0 && $f:警備兵なにかに気づいたフラグ == 0 ){
					if( $4 > 0 )  {
						mesg 警備兵 警備兵:01 ルート変更 12 -10000,3000,-10000 ２Ｆ廻廊部 0
					}else{
						mesg 警備兵 警備兵:01 ルート変更 14 -10000,3000,-10000 ２Ｆ廻廊部 0
					}
				}
			}

		// 三階から進入した際の潜入モード以外でのルート変更
		trap en004 d:PLAYER \
			-mask 入る \
			-exec {
				if( $s:登場ポイント == 居住区三階左舷からロード ) {
					if( $w:アラートモード != 0 ){
						mesg 警備兵 警備兵:01 ルート変更 (10-1) 6500,3000,-15000 ２Ｆ廻廊部 0
					}
				}
			}
	}
#endif


/***************************************************************************************************/
// ガラス弾痕 設定
/***************************************************************************************************/
proc ガラス弾痕 {
	chara ガラス弾痕  船首側窓ガラス \
		-flag    0 \  /* 1にするとターゲットが出る */
		-thick  200 \  /* 窓ガラスの厚さ（ｍｍ）    */
		-number  5 \  /* 窓の個数                  */
		-point -5300,5000,-19900  -4650,4100,-19900 \ /* 最大点,最小点を指定 */
		-point -2850,5000,-19900  -2150,4100,-19900 \
		-point  -350,5000,-19900    350,4100,-19900 \
		-point  2150,5000,-19900   2850,4100,-19900 \
		-point  4650,5000,-19900   5350,4100,-19900
}
