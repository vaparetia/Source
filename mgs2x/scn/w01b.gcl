/***************************************************************************************************/
// USBキーボード
/***************************************************************************************************/
proc ＵＳＢキーボードセット {
#if d:MY_DEBUG
	chara USBキーボード実行 ＵＳＢキーボード \
			-e d:KBD_R	{ 	command メニュー設定 -menu on -gage on -radar on -subwin on	} \
			-e d:KBD_T	{	command メニュー設定 -menu off -gage off -radar off -subwin off	} \
			-e d:KBD_F9 {
			} \

			-e d:KPD_PLUS		{ mesg  プットオブジェ これも天井 on } \
			-e d:KPD_MINUS		{ mesg  プットオブジェ これも天井 off } \
			-e d:KPD_ENTER		{ mesg Ｃ４ Ｃ４ bomb } \
			-e d:KBD_ESC {	mesg 臨時顔アニメキャラ アニメキャラ モーション再生 normal 30
							mesg delay カメラディレイ kill
							mesg 臨時顔アニメキャラ アニメキャラ 視線変更 -1
							mesg 遠景ぼかし 遠景ぼかし１ off
							mesg 遠景ぼかし 遠景ぼかし２ off
							mesg 遠景ぼかし 遠景ぼかし３ off
							mesg 近景ぼかし 近景ぼかし１ off
							mesg 近景ぼかし 近景ぼかし２ off
							mesg 近景ぼかし 近景ぼかし３ off
						} \
			-e d:KBD_F1	{ mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_speech_a 30 } \
			-e d:KBD_F2 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_speech_i 30 } \
			-e d:KBD_F3 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_speech_u 30 } \
			-e d:KBD_F4 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_speech_e 30 } \
			-e d:KBD_F5 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_speech_o 30 } \
			-e d:KBD_F6 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_speech_n 30 } \
			-e d:KBD_F7 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_teeth 30 } \
			-e d:KBD_F8 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_scream 0 } \
			-e d:KBD_F9 { mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_relax 30 } \
			-e d:KBD_F10{ mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_surprise 30 } \
			-e d:KBD_F11{ mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_sigh 30 } \
			-e d:KBD_F12{ mesg 臨時顔アニメキャラ アニメキャラ 視線変更 2 } \
			-e d:KBD_Q	{ mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_tension 30 } \
			-e d:KBD_W	{
						  chara delay カメラディレイ \
							-time 1 \
							-exec {
								mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_exciting 30
								return 60
							}
						} \
			-e d:KBD_E	{ mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_pain 30 } \
			-e d:KBD_R	{ mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_T12a1D71 30 } \
			-e d:KBD_T	{
							mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 120 -7707,-3929,-14119
							chara delay カメラディレイ \
								-time 90 \
								-exec {
									mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 60 6710,-3960,-18261
								}
						} \
			-e d:KBD_Y	{
						mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_sneeze 0
						//mesg プレイヤー d:PLAYER motion d:モーションリスト:sna_m9_behind_squat_r_sneez_e3 \
						//	 -1 -1 -1 0x00000004
						} \
			-e d:KBD_U	{ mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_teeth 30
						  chara delay カメラディレイ \
							-time 20 \
							-exec {
									mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_surprise 20
							}
						  chara delay カメラディレイ \
							-time 40 \
							-exec {
									mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_teeth 20
							}
						} \
			-e d:KBD_I	{ mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_teeth 20
						  chara delay カメラディレイ \
							-time 30 \
							-exec {
									mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_relax 20
							}
						  chara delay カメラディレイ \
							-time 60 \
							-exec {
									mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_surprise 20
							}
						  chara delay カメラディレイ \
							-time 90 \
							-exec {
									mesg 臨時顔アニメキャラ アニメキャラ モーション再生  normal 20
							}
						} \
			-e d:KBD_O	{
							mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 90 \
									($i:プレイヤー位置Ｘ-1000),($i:プレイヤー位置Ｙ-200),($i:プレイヤー位置Ｚ+3000)
							chara delay カメラディレイ \
								-time 90 \
								-exec {
									mesg 臨時顔アニメキャラ アニメキャラ 視線変更 0 90 \
									($i:プレイヤー位置Ｘ+1000),($i:プレイヤー位置Ｙ-200),($i:プレイヤー位置Ｚ+3000)
								}
							chara delay カメラディレイ \
								-time 180 \
								-exec {
									mesg 臨時顔アニメキャラ アニメキャラ 視線変更 -1
								}
						} \
			-e d:KBD_P	{
						  chara delay カメラディレイ \
							-time 1 \
							-exec {
							}
						} \
			-e d:KBD_1 { mesg 遠景ぼかし 遠景ぼかし１ on } \
			-e d:KBD_2 { mesg 遠景ぼかし 遠景ぼかし２ on } \
			-e d:KBD_3 { mesg 遠景ぼかし 遠景ぼかし３ on } \
			-e d:KBD_4 { mesg 近景ぼかし 近景ぼかし１ on } \
			-e d:KBD_5 { mesg 近景ぼかし 近景ぼかし２ on } \
			-e d:KBD_6 { mesg 近景ぼかし 近景ぼかし３ on } \
			-e d:KPD_MINUS {
							mesg プレイヤー スネーク position \
							2966 2000 -15180
						} \
			-e d:KPD_NUMLOCK {
					mesg プット大ガラスオブジェ でかガラス 割れる
			} \
			-e d:KPD_7 {
				mesg プレイヤー スネーク shadow 1
			} \
			-e d:KPD_8 {
				mesg プレイヤー スネーク shadow 0
			} \
			-e d:KBD_L {
								mesg 臨時顔アニメキャラ アニメキャラ モーション再生  sna_face_teeth 40
								chara delay カメラディレイ \
									-time 20 \
									-exec {
											mesg 臨時顔アニメキャラ アニメキャラ モーション再生 sna_face_tension 30
									}
			} \
			-e d:KPD_1 { print $f:w01b_影発見フラグ } \
			-e d:KPD_0 { eval( $f:w01b_影発見フラグ = 0 ) } \
			-e d:KBD_0 { restart }
#endif
}

/***************************************************************************************************/
// ロッカー設置
/***************************************************************************************************/
	proc ロッカーチェック $:番号 {
		@壊れ物再セットチェック $b:w01b_破壊ロード回数[$:番号]
		if($f:再セットフラグ) {
			eval($i:w01b_ロッカーロード回数[$:番号] = 0)
		}
	}

	proc ロッカー状態保存 $:番号 $:行動 $:ロッカー名 {
		if(($:行動 != 6) && ($:行動 != 8)) {
			// 状態変化時
			eval($b:w01b_破壊ロード回数[$:番号] = $w:グローバルロード回数);
		} else if($:行動 == 8) {
			// ステージ終了時
			command ロッカー状態 -n $:ロッカー名
			eval($i:w01b_ロッカーロード回数[$:番号] = $status)
		}
	}

	proc ロッカー設置{
	#if d:LOCKER_SET
		chara ロッカー管理 管理人さん -n 1
		command ロッカーモーション -motion locker
		command プレイヤーロッカーモーション -motion sna_locker

		// ロッカー１設置
		@ロッカーチェック 0
		chara ロッカー ロッカー１ \
			-kms w01b1_locker_dr \
			-p 1350,3000,5050 \
			-seno 4 \
			-sefloor 4 \
			-r 0,1024,0 \
			-down_rot 0 400 0 \
			-s d:LOCKER_STATE_NO_OPEN_SEG \
			//-s d:LOCKER_STATE_OPEN \
			//-flag 0x0001 \			// 影が投影される
			-load_state $i:w01b_ロッカーロード回数[0] \
			-exec {
				@ロッカー状態保存 0 $3 $4
			}

		// 開け閉め用トラップ
		trap lk000 d:PLAYER \
			-and \
			-mask いる \
			-state 0,4 \
			-dir 3072,512 1024,512 \
			-button d:ACTION_BUTTON,-1 \
			-exec {
				command ロッカー状態 -n ロッカー１
				mesg プレイヤー d:PLAYER locker ロッカー１ $status 3072,512 -4250,(2000+50)
			}

		// 扉を開け閉めする時のカメラ
		trap lk000 d:PLAYER \
			-mask ？ \
			-state 6 \
			-exec {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 2650,6362,6692 -t 1805,4547,5489 \
					-r 580,2447,0 -f 2335 \
					-a 200 \
					-i 2 2 0 0 \
					-s $3
			}
	#endif
	}

/***************************************************************************************************/
// アイテム設定
/***************************************************************************************************/
proc アイテム初期設定 {
	#if d:ITEM
		// Ｍ９弾
		@アイテム再セットチェック $b:w01b_取得ロード回数[0]
		if ($f:再セットフラグ) {
			@弾薬_Ｍ９_初期設置 弾薬Ｍ９ 11000 3000 -14750 0 		// 右舷階段下
		}

		// レーション
		@アイテム再セットチェック $b:w01b_取得ロード回数[1]
		if ($f:再セットフラグ) {
			@レーション_初期設置 レーション:01 3500 3000 2250 0 	// 右窪み
		}

		// ＵＳＰ弾
		@アイテム再セットチェック $b:w01b_取得ロード回数[3]
		if ($f:再セットフラグ) {
			@弾薬_ＵＳＰ_初期設置 弾薬ＵＳＰ:02 1000 3000 5500 0 	// ロッカー内部
		}
	#endif
}

proc アイテム取得時番号設定 $:ボックス名 {
#if d:DEBUG_PRINT
	print 'item_no_set'
#endif

	if($:ボックス名 == 弾薬Ｍ９) {
		eval($b:w01b_取得ロード回数[0] = $w:グローバルロード回数);
	} else if ($:ボックス名 == 弾薬ＵＳＰ:01) {
		eval($b:w01b_取得ロード回数[1] = $w:グローバルロード回数);
	} else if ($:ボックス名 == ＵＳＰ本体) {
		eval($b:w01b_取得ロード回数[2] = $w:グローバルロード回数);
	} else if ($:ボックス名 == 弾薬ＵＳＰ:02) {
		eval($b:w01b_取得ロード回数[3] = $w:グローバルロード回数);
	}

#if d:DEBUG_PRINT
	print $:ボックス名
	print $w:グローバルロード回数
#endif
}

/***************************************************************************************************/
// 子画面設定
/***************************************************************************************************/
proc 子画面設定 {
	chara サブ画面 子画面
}

/***************************************************************************************************/
// トラップカメラのproc化
/***************************************************************************************************/
// カメラ設定とデフォルトカメラ（通常は通路カメラ１を使用）
proc 居住区２Ｆカメラ設定 {
	chara カメラ ステージカメラ		-c 0 -l 3 -p 0
	chara カメラ モーションカメラ	-c 0 -l 2 -p 1
	chara カメラ 通路カメラ０		-c 0 -l 2 -p 1
	chara カメラ 通路カメラ１		-c 0 -l 2 -p 2
	chara カメラ 通路カメラ２		-c 0 -l 2 -p 3
	chara カメラ ロードカメラ		-c 0 -l 2 -p 0

	// デフォルトカメラ
	chara カメラ設定 ステージカメラ \
		-c 0 \
		-b -32000,-32000,-32000 32000,32000,32000 \
		-l -32000,-32000,-32000 32000,32000,32000 \
		-r 640,2048,0 \
		-f 6000 \
		-a 200 \
		-i 1 -1 0 0 \
		-s 1
}


proc 左舷窪みカメラ {
	trap ca029 d:PLAYER \
		-mask ＊ \
		-camera \
		-exec {
/*
-p -4359,5192,7432 -t -6104,2733,1863 \
-r 260,2246,0 -f 6333 \
-a 200 \
*/
			chara カメラ設定 通路カメラ１ \
				-c 1 \
				//-p -4214,5092,6642 -t -4810,4442,5145 \
				//-r 250,2295,0 -f 1738 \
				//-a 200 \
				-p -4359,5192,7432 -t -6104,2733,1863 \
				-r 260,2246,0 -f 6333 \
				-a 200 \
				-i $f:窪みカメラ補完方式 -1 0 0 \
				-s $3
		}
}

proc 右舷窪みカメラ {
	trap ca030 d:PLAYER \
		-mask ＊ \
		-camera \
		-exec {
			chara カメラ設定 通路カメラ１ \
				-c 1 \
				//-p 4761,7055,3446 -t 4761,4471,2953 \
				//-r 901,2048,0 -f 2631 \
				-p 4932,7778,3528 -t 4952,5311,2667 \
				-r 805,2033,0 -f 2613 \
				-a 200 \
				-i $f:窪みカメラ補完方式 1 0 0 \
				-s $3
		}
}

proc 左舷３Ｆへの階段と脇通路カメラ {
	trap ca006 d:PLAYER \
		-mask ＊ \
		-camera \
		-exec {
			if( $3 == 入る ) {
				if( $6 > -14000 ) {
					eval( $w:カメラ補完方式 = 2 )
				} else {
					eval( $w:カメラ補完方式 = 0 )
				}
			}
			// 階段カメラ
			if( $4 < -10750 && $6 > -14000 ) {
				if( $6 > -12500 ) {
					/*
					@CS_スムーズカメラ３ $6 -11000 -12500 -11250 -9250 6500 3750 4250 5500
					eval( $i:補完ＰＸ = $i:CS_結果１ )
					eval( $i:補完ＰＹ = $i:CS_結果２ )
					eval( $i:補完ＴＹ = $i:CS_結果３ )
					eval( $i:補完ＴＺ = $6 )
					*/
					/*
					-p -10649,4963,-7498 -t -10936,4665,-10281 \
					-r 69,2115,0 -f 2814 \
					-a 200 \
					*/
					eval( $i:補完ＰＸ = -10649 )
					eval( $i:補完ＰＹ = 4963 )
					eval( $i:補完ＰＺ = -7498 )
					eval( $i:補完ＴＸ = -10936 )
					eval( $i:補完ＴＹ = 4665 )
					eval( $i:補完ＴＺ = -10281 )
				} else {
					eval( $i:補完ＰＸ = -9250 )
					eval( $i:補完ＰＹ = 3750 )
					eval( $i:補完ＴＹ = 5500 )
					eval( $i:補完ＴＺ = -12500 )
					eval( $i:補完ＴＸ = -11250 )
					eval( $i:補完ＰＺ = -9600 )
				}

			// 通路カメラ
			} else {
				// ３Ｆ階段下吹き抜けまで仮設定
				eval( $i:補完ＰＸ = -10375 )
				eval( $i:補完ＰＹ = 5501 )
				eval( $i:補完ＰＺ = -7163 )
				eval( $i:補完ＴＸ = -10375 )
				eval( $i:補完ＴＹ = 3958 )
				eval( $i:補完ＴＺ = -10779 )
			}
			chara カメラ設定 通路カメラ１ \
				-c 1 \
				-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ \
				-t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ \
				-a 200 \
				-i $w:カメラ補完方式 -1 0 0 \
				-s $3
		}
}

proc 左舷甲板扉前カメラ {
	trap ca007 d:PLAYER \
		-mask ＊ \
		-camera \
		-exec {
			chara カメラ設定 通路カメラ１ \
				-c 1 \
				-p -10400,8350,-9600 \
				-t -10400,4000,-10250 \
				-a 200 \
				-i 2 -1 0 0 \
				-s $3
		}
}

proc 右舷３Ｆへの階段と脇通路カメラ {

	// 階段の最上階のカメラ
	trap ca031 d:PLAYER \
		-mask ＊ \
		-camera \
		-exec {
			if( $6 < -13276 ){
				if( `command PlayerStatus -f d:CAUTION ` ){
					if( `command PlayerStatus -f d:TRP_STATE_SQUAT ` ){
						chara カメラ設定 通路カメラ０ \
							-c 1 \
							-p 11235,6948,-11377 -t 10865,6936,-13332 \
							-r 4,2170,0 -f 1990 \
							-a 200 \

							-i 0 0 0 0 \
							-s $3
					}else{
						chara カメラ設定 通路カメラ０ \
							-c 1 \
							-p 11437,7078,-11841 -t 11056,7127,-13791 \
							-r -16,2174,0 -f 1987 \
							-a 200 \
							-i 0 0 0 0 \
							-s $3
					}
				}
			}else{
