proc 北部南北通路右側カメラ {
	trap ca023 d:PLAYER \
		-mask ＊ \
		-camera \
		-exec {
			if( $3 == 入る)	{
				if( $i:前フレーム位置Ｘ > 6000 ){
					eval( $w:補完方式 = 0 )		// 東から進入
				}else{
					if( $i:前フレーム位置Ｚ > -7000 ){
						eval( $w:補完方式 = 1 )	// 南から進入
					}else{
						// 北から進入した場合の補完方式はca024で代入済み
						//eval( $w:補完方式 = 0 )	// 北から進入
					}
				}
			}

			@CS_スムーズカメラ昇順 $6 -5041 -4836  114 428
				eval( $i:補完ＲＸ = $i:CS_結果１ )
			chara カメラ設定 通路カメラ１ \
				-c 0 \
				-b 5000 -10000 -17750   5000 5372 -5200 \
				-l 5000 -20000 -20000   5000 4328 20000 \
				-r $i:補完ＲＸ,2048,0 -f 6000 \
				-a 200 \
				-i $w:補完方式 -1 0 0 \
				-slide 1 5 6000 3000 50 0 \
				-s $3
		}
}

proc クランク部北東左側カメラ {
	trap ca022 d:PLAYER \
		-mask ＊ \
		-camera \
		-exec {
			if( $3 == 入る ){
				// 北から進入した場合補完方式の値を入れる。
				// 西から進入した場合は補完方式の値は代入済み
				if( $i:前フレーム位置Ｘ < 6000 ){
					eval( $w:補完方式 = 1 )
				}
			}
			@CS_スムーズカメラ昇順 $6 -7000 -6500  5372 7182
				eval( $i:補完ＰＹ = $i:CS_結果１ )
			@CS_スムーズカメラ昇順 $6 -7000 -6500  -5110 -5500
				eval( $i:補完ＰＺ = $i:CS_結果１ )
			@CS_スムーズカメラ昇順 $6 -7000 -6500  -7015 -6157
				eval( $i:補完ＴＺ = $i:CS_結果１ )
			if( $4 < 5000 ){
				eval( $i:補完ＰＸ = 5000 )
			}else{
				eval( $i:補完ＰＸ = $4 )
			}
			chara カメラ設定 通路カメラ１ \
				-c 1 \
				-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ -t $i:補完ＰＸ,4328,$i:補完ＴＺ \
				-r 889,2048,0 -f 3174 \
				-a 200 \
				-i $w:補完方式 -1 0 0 \
				-s $3
		}
}

proc クランク部北東右側カメラ {
	trap ca021 d:PLAYER \
		-mask ＊ \
		-camera \
		-exec {

			if( $3 == 入る)	{ eval( $i:進入位置Ｘ = $i:前フレーム位置Ｘ ) }

			if( $i:進入位置Ｘ > 6000){	// 南から進入
				if( $4 > 6800 ){
					eval( $i:補完ＰＸ = 6800 )
				}else{
					eval( $i:補完ＰＸ = $4 )
				}
				chara カメラ設定 通路カメラ１ \
					-c 1 \
					-p $i:補完ＰＸ,7182,-5500 -t $i:補完ＰＸ,4328,-6157 \
					-r 889,2048,0 -f 3174 \
					-a 200 \
					-i 0 -1 0 0 \
					-s $3
				eval( $w:補完方式 = 1 )
			}else{						// 西から進入
				if( $4 > 6688 ){
					eval( $i:補完ＰＸ = 6688 )
					eval( $i:補完ＴＸ = 6688 )
				}else if( $4 < 6321 ){
					eval( $i:補完ＰＸ = 6321 )
					eval( $i:補完ＴＸ = 6321 )
				}else{
					eval( $i:補完ＰＸ = $4 )
					eval( $i:補完ＴＸ = $4 )
				}

				chara カメラ設定 通路カメラ１ \
					-c 1 \
					-p $i:補完ＰＸ,5499,4099 -t $i:補完ＴＸ,4790,2270 \
					-r 55,2048,0 -f 6000 \
					-a 200 \
					-i 0 -1 0 0 \
					-slide 1 5 6000 3000 50 0 \
					-s $3
				eval( $w:補完方式 = 0 )
			}
		}
}

proc 南側南北通路右側カメラ {
	trap ca020 d:PLAYER \
		-mask ＊ \
		-camera \
		-exec {
			if( $3 == 入る ){
				if( $6 < 0 ){
					// 北から進入
					eval( $w:補完方式 = 0 )
				}else{
					eval( $w:補完方式 = 1 )
				}
			}
			@CS_スムーズカメラ昇順 $6 -5000 1250 500 0
				eval( $i:補完ＰＹ = $i:CS_結果１ + 4999 )
				eval( $i:補完ＴＹ = $i:CS_結果１ + 4290 )

			if( $4 > 6688 ){
				eval( $i:補完ＰＸ = 6688 )
				eval( $i:補完ＴＸ = 6688 )
			}else{
				eval( $i:補完ＰＸ = $4 )
				eval( $i:補完ＴＸ = $4 )
			}

			chara カメラ設定 通路カメラ１ \
				-c 1 \
				-p $i:補完ＰＸ,$i:補完ＰＹ,4099 -t $i:補完ＴＸ,$i:補完ＴＹ,2270 \
				-r 184,2003,0 -f 5981 \
				-a 200 \
				-i $w:補完方式 -1 0 0 \
				-s $3
		}
}

proc クランク部南東右側カメラ {
	trap ca019 d:PLAYER \
		-mask ＊ \
		-camera \
		-exec {
			if( $3 == 入る ){
				if( $i:前フレーム位置Ｘ > 6000 ){	// 北から進入
					eval( $w:補完方式 = 1 )
				}
			}
			// 東(ca018)から進入した場合の補完方式の値はすでに入っている
			//-p 6688,4999,4099 -t 6688,4290,2270 \
			//-p 6688,7496,3246 -t 6688,6289,3026 \
			@完全補完カメラ $6	1250 2250  \
								6688 6688 \
								4999 7496 \
								4099 3246 \
								6688 6688 \
								4290 6289 \
								2270 3026

			if( $4 > 6688 ){
				eval( $i:補完ＰＸ = 6688 )
				eval( $i:補完ＴＸ = 6688 )
			}else{
				eval( $i:補完ＰＸ = $4 )
				eval( $i:補完ＴＸ = $4 )
			}

			chara カメラ設定 通路カメラ１ \
				-c 1 \
				-p $i:補完ＰＸ $i:補完ＰＹ $i:補完ＰＺ \
				-t $i:補完ＴＸ $i:補完ＴＹ $i:補完ＴＺ \
				-r 184,2003,0 -f 5981 \
				-a 200 \
				-i $w:補完方式 -1 0 0 \
				-s $3
		}
}

proc クランク部南東左側カメラ {
	trap ca018 d:PLAYER \
		-mask ＊ \
		-camera \
		-exec {
			if( $3 == 入る)	{	eval( $i:進入位置Ｘ = $i:前フレーム位置Ｘ )	}
			if( $i:進入位置Ｘ > 6000 ){ // 東から進入
				chara カメラ設定 通路カメラ１ \
					-c 1 \
					-p 4911,5218,7225 -t 4911,3300,2792 \
					-r 266,2048,0 -f 4830 \
					-a 200 \
					-i 0 -1 0 0 \
					-s $3

				eval( $w:補完方式 = 0 ) 			// ca019で使用する
				eval( $w:補完方式２ = 1 ) 			// ca010で使用する
				eval( $f:窪みカメラ補完方式 = 0 )	// ca030で使用する
			}else{	// 南から進入
				if( $4 < 5136 ){
					eval( $i:補完ＰＸ = 5136 )
				}else{
					eval( $i:補完ＰＸ = $4 )
				}
				chara カメラ設定 通路カメラ１ \
					-c 1 \
					-p $i:補完ＰＸ,7496,3246 \
					-t $i:補完ＰＸ,6289,3026 \
					-r 767,2043,0 -f 5855 \
					-a 200 \
					-i 0 -1 0 0 \
					-s $3

				eval( $w:補完方式 = 1 )				// ca005で使用する
				eval( $w:補完方式２ = 0 )			// ca010で使用する
				eval( $f:窪みカメラ補完方式 = 1 )	// ca030で使用する
			}
		}
}

proc クランク部南東左下カメラ {
