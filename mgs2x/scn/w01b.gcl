#if d:ENEMY

	/////////////////////////////////////////////////////////////////////////////////////////////////
	// 攻撃兵

	proc 攻撃兵Ａ {
		chara アタッカー 攻撃兵:01 \
				-r (1-1) \
				-s d:ENE_STATUS_TRAPSHADOW \
				-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
				-l $w:敵標準体力 \
				-h $w:敵標準聴力 \
				-f $w:敵標準気絶 \
				-e 0 \
				-c (11-1) \		// 探索ルート
				-q レーション_敵兵 15
	}

	proc 攻撃兵Ｂ {
		chara アタッカー 攻撃兵:02 \
				-r (2-1) \
				-s d:ENE_STATUS_TRAPSHADOW \
				-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
				-l $w:敵標準体力 \
				-h $w:敵標準聴力 \
				-f $w:敵標準気絶 \
				-e 1 \
				-c (12-1) \		// 探索ルート
				-q レーション_敵兵 15
	}

	proc 攻撃兵セット {
		@攻撃兵Ａ
		@攻撃兵Ｂ
	}

