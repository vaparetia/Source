/***************************************************************************************************/
// マップ宣言
/***************************************************************************************************/
chara マップ ２Ｆ廻廊部 -k w01b0 0 0 0 -k w01b1 0 0 0 -h w01b,0 -l w01b

#if	d:シナリオデモカメラアングル作成
	#include "scn_demo_prvw.h"
#endif

/***************************************************************************************************/
// ロード用オブジェクト
/***************************************************************************************************/
chara プットオブジェ ロード用Ｗ０１ｆ -m w01b_w01f -r 0 0 0 -p 0 0 0 -l w01b -s 100 100 100
chara プットオブジェ ロード用Ｗ０１ｃ -m w01b_w01c -r 0 0 0 -p 0 0 0 -l w01b -s 100 100 100

/***************************************************************************************************/
// 各マップのキャラ設定
/***************************************************************************************************/
command マップ設定 ２Ｆ廻廊部 \
-set{
	@初期化１
	@居住区２Ｆサウンド設定
	@常駐キャラ設定
	@プレイヤー設定
	@ポーズ時ステージ名表示設定 d:wn_船橋二階居住区
#if d:ENEMY
	@居住区２Ｆ敵兵設定
#endif

	@居住区２ＦＢＧＭマネージャー設定
	@敵兵ルート変更
	@天井
	@フォグ
	@影表示
	@壊れライトセット
	@シナリオデモキャラセット
	@消火器セット

	@鏡面モデルセット
	@遠近ぼかしセット
	@アイテム初期設定

	@船首オブジェクト

	@船外景色エフェクト
	@船首と雨のＯＮ／ＯＦＦ
	@タンカーぼんぼりエフェクト

	//@ガラス弾痕

	// 雨関連
	@窓際の雨音
	@窓の雨粒
	@位置指定雨セット
	@暴風エフェクト
	@水溜まり

	// ロードトラップ
	@１Ｆリフレッシュルーム中央階段左側へロード
	@１Ｆリフレッシュルーム中央階段右側へロード
	//@左舷甲板２Ｆへロード	// 水密ドアで呼び出し
	//@右舷甲板２Ｆへロード	// 水密ドアで呼び出し
	@居住区３Ｆ左側へロード
	@居住区３Ｆ右側へロード

	// ドアトラップ
	@左舷廻廊１Ｆから２Ｆへのドア
	@右舷廻廊１Ｆから２Ｆへのドア
	@甲板への水密ドア二つ

	// ロッカー
	@ロッカー設置

	// カメラ設定
	@子画面設定
	@居住区２Ｆカメラ設定
	@左舷３Ｆへの階段と脇通路カメラ
	@左舷甲板扉前カメラ
	@左舷への通路カメラ

	@右舷３Ｆへの階段と脇通路カメラ
	@右舷甲板扉前カメラ
	@右舷への通路カメラ

	@北部北東角カメラ
	@北部北西角カメラ
	@北部東西通路カメラ
	@北部南北通路左側カメラ
	@北部南北通路右側カメラ

	// クランク部カメラ
	@クランク部北西カメラ右カメラ
	@クランク部北西カメラ左カメラ
	@南部南北通路左側カメラ
	@クランク部南西左側カメラ
	@クランク部南西右側カメラ
	@クランク部南西右下カメラ

	@南側東西通路カメラ
	@南側東西通路張り付きカメラ
	@南側東西通路西カメラ
	@南側東西通路東カメラ

	@クランク部北東左側カメラ
	@クランク部北東右側カメラ
	@南側南北通路右側カメラ
	@クランク部南東右側カメラ
	@クランク部南東左側カメラ
	@クランク部南東左下カメラ

	@ロッカー置き場カメラ

	@左舷窪みカメラ
	@右舷窪みカメラ
	@プレイヤー影発見カメラデモ
	@羽虫チェック

	@タンカーデジカメ写真判定

	// デバッグ設定
#if d:MY_DEBUG
	//@写真撮影用スクリーンショット
	@ＵＳＢキーボードセット
#endif

	@初期化２
	@座標チェック
}

/***************************************************************************************************/
// 無線関係のインクルード 位置変更不可
/***************************************************************************************************/
#include "w01b_cdc.ch"

/***************************************************************************************************/
// マップの起動
/***************************************************************************************************/
command マップ表示 -show ２Ｆ廻廊部


// とりあえず最後にキャラ環境光設定
@キャラ専用環境光設定
// 全てのセットが終わったところでフェードイン
if( $s:登場ポイント == 居住区三階左舷からロード ) {
	@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:NO_DOOR_TYPE 階段ダミー 1700 d:DEFAULT_M_TYPE d:wn_船橋二階居住区左舷
} else if( $s:登場ポイント == 右舷甲板からロード ) {
	@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:WT_DOOR_TYPE 右舷水密ドア 1700 d:DEFAULT_M_TYPE d:wn_船橋二階居住区右舷
	@カメラ曇り
	@水飛沫
} else if( $s:登場ポイント == 居住区一階中央階段右からロード ) {
	@ステージ開始時処理（ステージ名表示） d:LOAD_TYPE:SL_DOOR_TYPE 右舷回廊１Ｆから２Ｆへのドア 1500 d:DEFAULT_M_TYPE d:wn_船橋二階居住区右舷
}

/***************************************************************************************************/
// 初期化
/***************************************************************************************************/
proc 初期化１ {
	eval( $f:警備兵なにかに気づいたフラグ = 0 )
}

proc 初期化２ {
#if d:SHIP_HEAD
//	mesg ローカル風 室内風 オン
//	mesg 風制御 室外暴風 オン
//	mesg プットオブジェ 船首１ on
//	mesg プットオブジェ 船首２ on
//	mesg プットオブジェ 船首３ on
	mesg プットオブジェ 船尾 off
#endif

#if d:RAIN_SET
	mesg 位置指定雨 常時北雨 オン
	mesg 位置指定雨 常時西雨 オフ
	mesg 位置指定雨 常時東雨 オフ
#endif
}

/***************************************************************************************************/
// 影発見イベントの設定
/***************************************************************************************************/
proc 影発見イベント開始処理 {
	/*
	command 無線設定 -reset

	command メニュー設定 -menu off -gage off -radar off -subwin off
	mesg シネマスクリーン シネマ フェードアウト 0
	command パッド操作 -release

	//@デモ発動時デジカメはずし
	@特殊装備解除
	*/
	@シナリオデモ開始処理
}

proc 影発見イベント終了処理 {
	#if d:DEMO_CANCEL
		mesg デモキャンセルチェック Ch_影イベントキャンセル kill
	#endif
	/*
	command メニュー設定 -menu on -gage on -radar on -subwin on
	mesg シネマスクリーン シネマ フェードイン 0
	command パッド操作 -cancel
	command プレイヤー無敵解除

	//@デモ終了時デジカメ復帰
	*/
	@シナリオデモ終了処理
}

////////////////////
// 影発見イベント右
	proc 影発見イベント右 {

		command パッド操作 -release

		chara demo 影発見カメラデモ \
			-i t:scndemo_w01b_01 \
			-begin 影発見イベント右スタート \
			-next 影発見イベント右終了 \
			-undraw 0

		chara デモキャンセルチェック 影発見カメラデモ右 -p 影デモキャンセル右
	}

	proc 影発見イベント右スタート {

		@影発見イベント開始処理

		mesg プレイヤー d:PLAYER position 7750 4000 -14750
		chara delay ディレイ -time 1 -exec {
			mesg プレイヤー d:PLAYER run \
				6250 4000 -15000 \
				0 \ // 立ち歩き
				2560 \
				0  // フラグ(FA_NO_WEAPON)
		}
	}

	proc 影発見イベント右終了 {
		if ( `command ゲームオーバーチェック` == 0 ) {
			@影発見イベント終了処理
			mesg デモキャンセルチェック 影発見カメラデモ右 kill
			mesg 警備兵 警備兵:01 ルート変更 (8-1) -10000,3000,-10000 ２Ｆ廻廊部 1
		}
	}

	proc 影デモキャンセル右 {
		command StreamStopAll
		mesg プレイヤー d:PLAYER position 6250 4000 -15000
	}

/////////////////////
// 影発見イベント右下
	proc 影発見イベント右下 {

		command パッド操作 -release

		chara demo 影発見カメラデモ \
			-i t:scndemo_w01b_00 \
			-begin 影発見イベント右下スタート \
			-next 影発見イベント右下終了 \
			-undraw 0

		chara デモキャンセルチェック 影発見カメラデモ右下 -p 影デモキャンセル右下
	}

	proc 影発見イベント右下スタート {

		@影発見イベント開始処理

		mesg プレイヤー d:PLAYER position 5000 4000 -12750
		chara delay ディレイ -time 1 -exec {
			mesg プレイヤー d:PLAYER run \
				5000 4000 -14250 \
				0 \ 	// 立ち歩き
				2048 \	// 終了時姿勢
				0  		// フラグ(FA_NO_WEAPON)
		}
	}

	proc 影発見イベント右下終了 {
		if ( `command ゲームオーバーチェック` == 0 ) {
			@影発見イベント終了処理
			mesg デモキャンセルチェック 影発見カメラデモ右下 kill
			mesg 警備兵 警備兵:01 ルート変更 (8-1) -10000,3000,-10000 ２Ｆ廻廊部 1
		}
	}

	proc 影デモキャンセル右下 {
		command StreamStopAll
		mesg プレイヤー d:PLAYER position 5000 4000 -14250
	}

/////////////////////
// 影発見イベント左下
	proc 影発見イベント左下 {

		command パッド操作 -release

		chara demo 影発見カメラデモ \
			-i t:scndemo_w01b_02 \
			-begin 影発見イベント左下スタート \
			-next 影発見イベント左下終了 \
			-undraw 0

		chara デモキャンセルチェック 影発見カメラデモ左下 -p 影デモキャンセル左下
	}

	proc 影発見イベント左下スタート {

		@影発見イベント開始処理

		mesg プレイヤー d:PLAYER position -5000 4000 -12750

		chara delay ディレイ -time 1 -exec {
			mesg プレイヤー d:PLAYER run \
				-5000 4000 -14250 \
				0 \ 	// 立ち歩き
				2048 \	// 終了時姿勢
				0  		// フラグ(FA_NO_WEAPON)
		}
	}

	proc 影発見イベント左下終了 {
		if ( `command ゲームオーバーチェック` == 0 ) {
			@影発見イベント終了処理
			mesg デモキャンセルチェック 影発見カメラデモ左下 kill
			mesg 警備兵 警備兵:01 ルート変更 (8-1) -10000,3000,-10000 ２Ｆ廻廊部 1
		}
	}

	proc 影デモキャンセル左下 {
		command StreamStopAll
		mesg プレイヤー d:PLAYER position -5000 4000 -14250
	}

///////////////////
// 影発見イベント左
	proc 影発見イベント左 {

		command パッド操作 -release

		chara demo 影発見カメラデモ \
			-i t:scndemo_w01b_03 \
			-no_state_demo \
			-begin 影発見イベント左スタート \
			-next 影発見イベント左終了 \
			-undraw 0

		chara デモキャンセルチェック 影発見カメラデモ左 -p 影デモキャンセル左
	}

	proc 影発見イベント左スタート {

		@影発見イベント開始処理

		mesg プレイヤー d:PLAYER position -7750 4000 -14750

		chara delay ディレイ -time 1 -exec {
			mesg プレイヤー d:PLAYER run \
				-6250 4000 -15000 \
				0 \ 	// 立ち歩き
				1536 \	// 終了時姿勢
				0  		// フラグ(FA_NO_WEAPON)
		}
	}

	proc 影発見イベント左終了 {
		if ( `command ゲームオーバーチェック` == 0 ) {
			@影発見イベント終了処理
			mesg デモキャンセルチェック 影発見カメラデモ左 kill
			mesg 警備兵 警備兵:01 ルート変更 (8-1) -10000,3000,-10000 ２Ｆ廻廊部 1
		}
	}

	proc 影デモキャンセル左 {
		command StreamStopAll
		mesg プレイヤー d:PLAYER position -6250 4000 -15000
	}

proc プレイヤー影発見カメラデモ {
#if d:SHADOW_DEMO

	////////////////////
	// 影発見イベント右
	trap ev008 d:PLAYER \
		-mask 入る \
		-camera \
		-exec {
			if( $4 > 7000 ){
				if( $f:w01b_影発見フラグ == 0 && $f:警備兵なにかに気づいたフラグ == 0 && `@シナリオデモ用安全チェック` ){
					// 攻撃兵:01が天井より上なら
					command ゲット敵兵座標 攻撃兵:01 $i:敵兵Ｘ $i:敵兵Ｙ $i:敵兵Ｚ
					if( $i:敵兵Ｙ > 6000 ){
						// 攻撃兵:02が天井より上なら
						command ゲット敵兵座標 攻撃兵:02 $i:敵兵Ｘ $i:敵兵Ｙ $i:敵兵Ｚ
						if( $i:敵兵Ｙ > 6000 ){
							command ゲット敵兵座標 警備兵:01 $i:敵兵Ｘ $i:敵兵Ｙ $i:敵兵Ｚ
							// 警備兵:01の座標をチェック
							if( $i:敵兵Ｘ >= 2500 ){
								// 警備兵:01が通常の状態なら
								command ゲット敵兵状態 警備兵:01 $i:敵兵状態
								if( ( $i:敵兵状態 & 0x80106004 ) == 0 ){
									if( `command StreamIsPlay` != 2 ) {
										@影発見イベント右
										eval( $f:w01b_影発見フラグ = 1 )
										#if d:VAR_SAVE
											command varsave $f:w01b_影発見フラグ
										#endif
									}
								}
							}
						}
					}
				}
			}
		}

	//////////////////////
	// 影発見イベント右下
	trap ev009 d:PLAYER \
		-mask 入る \
		-camera \
		-exec {
			if( $6 > -13500 ){
				if( $f:w01b_影発見フラグ == 0 && $f:警備兵なにかに気づいたフラグ == 0 && `@シナリオデモ用安全チェック` ){
					// 攻撃兵:01が天井より上なら
					command ゲット敵兵座標 攻撃兵:01 $i:敵兵Ｘ $i:敵兵Ｙ $i:敵兵Ｚ
					if( $i:敵兵Ｙ > 6000 ){
						// 攻撃兵:02が天井より上なら
						command ゲット敵兵座標 攻撃兵:02 $i:敵兵Ｘ $i:敵兵Ｙ $i:敵兵Ｚ
						if( $i:敵兵Ｙ > 6000 ){
							// 警備兵:01の座標をチェック
							command ゲット敵兵座標 警備兵:01 $i:敵兵Ｘ $i:敵兵Ｙ $i:敵兵Ｚ
							if( $i:敵兵Ｘ >= 2500 ){
								// 警備兵:01が通常の状態なら
								command ゲット敵兵状態 警備兵:01 $i:敵兵状態
								if( ( $i:敵兵状態 & 0x80106004 ) == 0 ){
									if( `command StreamIsPlay` != 2 ) {
										@影発見イベント右下
										eval( $f:w01b_影発見フラグ = 1 )
										#if d:VAR_SAVE
											command varsave $f:w01b_影発見フラグ
										#endif
									}
								}
							}
						}
					}
				}
			}
		}

	/////////////////////
	// 影発見イベント左下
	trap ev010 d:PLAYER \
		-mask 入る \
		-camera \
		-exec {
			if( $6 > -13500 ){
				if( $f:w01b_影発見フラグ == 0 && $f:警備兵なにかに気づいたフラグ == 0 && `@シナリオデモ用安全チェック` ){
					// 攻撃兵:01が天井より上なら
					command ゲット敵兵座標 攻撃兵:01 $i:敵兵Ｘ $i:敵兵Ｙ $i:敵兵Ｚ
					if( $i:敵兵Ｙ > 6000 ){
						// 攻撃兵:02が天井より上なら
						command ゲット敵兵座標 攻撃兵:02 $i:敵兵Ｘ $i:敵兵Ｙ $i:敵兵Ｚ
						if( $i:敵兵Ｙ > 6000 ){
							// 警備兵:01の座標をチェック
							command ゲット敵兵座標 警備兵:01 $i:敵兵Ｘ $i:敵兵Ｙ $i:敵兵Ｚ
							if( $i:敵兵Ｘ <= -2700 && $i:敵兵Ｘ >= -2800 ) {
								// 警備兵:01が通常の状態なら
								command ゲット敵兵状態 警備兵:01 $i:敵兵状態
								if( ( $i:敵兵状態 & 0x80106004 ) == 0 ){
									if( `command StreamIsPlay` != 2 ) {
										@影発見イベント左下
										eval( $f:w01b_影発見フラグ = 1 )
										#if d:VAR_SAVE
											command varsave $f:w01b_影発見フラグ
										#endif
									}
								}
							}
						}
					}
				}
			}
		}


	///////////////////
	// 影発見イベント左
	trap ev011 d:PLAYER \
		-mask 入る \
		-camera \
		-exec {
			if( $4 < -7000 ){
				if( $f:w01b_影発見フラグ == 0 && $f:警備兵なにかに気づいたフラグ == 0 && `@シナリオデモ用安全チェック` ){
					// 攻撃兵:01が天井より上なら
					command ゲット敵兵座標 攻撃兵:01 $i:敵兵Ｘ $i:敵兵Ｙ $i:敵兵Ｚ
					if( $i:敵兵Ｙ > 6000 ){
						// 攻撃兵:02が天井より上なら
						command ゲット敵兵座標 攻撃兵:02 $i:敵兵Ｘ $i:敵兵Ｙ $i:敵兵Ｚ
						if( $i:敵兵Ｙ > 6000 ){
							// 警備兵:01の座標をチェック
							command ゲット敵兵座標 警備兵:01 $i:敵兵Ｘ $i:敵兵Ｙ $i:敵兵Ｚ
							if( $i:敵兵Ｘ <= -2700 && $i:敵兵Ｘ >= -2800 ) {
								// 警備兵:01が通常の状態なら
								command ゲット敵兵状態 警備兵:01 $i:敵兵状態
								if( ( $i:敵兵状態 & 0x80106004 ) == 0 ){
									if( `command StreamIsPlay` != 2 ) {
										@影発見イベント左
										eval( $f:w01b_影発見フラグ = 1 )
										#if d:VAR_SAVE
											command varsave $f:w01b_影発見フラグ
										#endif
									}
								}
							}
						}
					}
				}
			}
		}
#endif
}

/***************************************************************************************************/
// エフェクト
/***************************************************************************************************/

proc カメラ曇り {
	chara カメラ前曇り カメラ曇り -t 250
}

proc 窓際の雨音 {
	trap sd d:PLAYER -mask ？ \
		-exec {
			if( $3 == 入る ){
				command ＳＥセットモード -s d:se_code:SD_A_W_RAIN01 -p 0 0 0 -m 1
			}else{
				command セットサウンドコード -c d:SE_JOUCHUU_OFF
			}
		}
}

proc 水溜まり {
	chara 水溜り管理 水溜り管理人 \
		-n_obj	5 \
		-obj	d:PLAYER \
			警備兵:01 \
			警備兵:02 \
			攻撃兵:01 \
			攻撃兵:02

	// 完全版から 右舷側の水溜まりトラップだけＯＮにする
	command トラップ切り替え \
			-trap puddle:01 \
			-switch 1

	trap puddle ？ \
	-mask ？ \
	-exec {
		if($3 == 入る){
			mesg 水溜り管理 水溜り管理人 入る $2
		}else{
			mesg 水溜り管理 水溜り管理人 出る $2
		}
	}
}

/***************************************************************************************************/
// トラップドアのproc化
/***************************************************************************************************/
proc 左舷廻廊１Ｆから２Ｆへのドア {
	chara ドア 左舷回廊１Ｆから２Ｆへのドア \
		-m w01f_dr -d 0 3072 0 -p -3900 3000 -9650 -slide 2000 -time d:SD_OPEN_TIME \
		-between ２Ｆ廻廊部 ２Ｆ廻廊部 \
		-card_level 9999 \
		-exec{
/*
			if( !($:開閉フラグ) ){
				eval( $f:左扉フラグ = 0 )
				if( $f:右扉フラグ == 0 ){
					mesg プットオブジェ ロード用Ｗ０１ｆ off
				}
			}else{
				eval( $f:左扉フラグ = 1 )
				mesg プットオブジェ ロード用Ｗ０１ｆ on
			}
*/
		}
#if 0
	trap dr000 ？ \
		-mask ？ \
		-exec {
			if ( $3 == 入る ) {
				mesg ドア 左舷回廊１Ｆから２Ｆへのドア open
			} else{
				mesg ドア 左舷回廊１Ｆから２Ｆへのドア close
			}
		}
#else
	trap dr000 d:PLAYER -mask 入る \
		-exec {
			// ブザー
			command ＳＥセットモード -s d:SD_S_BUZZER01 -p -4000 3000 -9000 -m 0
		}
#endif
}


proc 右舷廻廊１Ｆから２Ｆへのドア {
	chara ドア 右舷回廊１Ｆから２Ｆへのドア \
		-m w01f_dr -d 0 3072 0 -p 3900 3000 -9650 -slide 2000 -time d:SD_OPEN_TIME \
		-exec{
			if( !($:開閉フラグ) ){
				//eval( $f:右扉フラグ = 0 )
				//if( $f:左扉フラグ == 0 ){
				if( 1 ) {
					mesg プットオブジェ ロード用Ｗ０１ｆ off
				}
			}else{
				//eval( $f:右扉フラグ = 1 )
				mesg プットオブジェ ロード用Ｗ０１ｆ on
			}
		}
	trap dr001 ？ \
		-mask ？ \
		-exec {
			if ( $3 == 入る ) {
				mesg ドア 右舷回廊１Ｆから２Ｆへのドア open
			} else {
				mesg ドア 右舷回廊１Ｆから２Ｆへのドア close
			}
		}
}

/***************************************************************************************************/
// 水密ドアの設定
/***************************************************************************************************/
proc 甲板への水密ドア二つ{
	chara 水密ドア管理 水密ドア管理人 -n 2 \
		-seno 1 \
		-motions sna_hatch hatch_door_sna hatch_handle_sna

	@左舷甲板への水密ドア
	@右舷甲板への水密ドア
}

proc 左舷甲板への水密ドア {
	chara 水密ドア 左舷水密ドア \
		-kms w01asdr_body_r w01asdr_handle \
		-flag d:WT_DOOR_FLAG_NOT_OPEN \
		-position -11950,3000,-10325 \
		-rotate 0,3072,0 \
		-hazard -11750,3000,-10225 -11750,3000,-9225 \
		-proc 左舷甲板２Ｆへロード

	trap dr002 d:PLAYER \
		-mask いる \
		-button d:ACTION_BUTTON \
		-state 0 \
		-exec {
			eval($f:rft_w01b取れる水密扉取れた = 1)	//fukushima
			command 水密ドア状態 -n 左舷水密ドア
			mesg プレイヤー d:PLAYER wt_door 左舷水密ドア $status 3072,1024 -11950,-10325
	}
	// モーション中のカメラ
	trap dr002 d:PLAYER -mask ？ -state 6 \
	-exec {
		chara カメラ設定 モーションカメラ \
			-c 1 \
			-p -10959,6313,-9216 -t -11064,4860,-9594 \
			-r 852,1872,0 -f 1505 \
			-a 200 \
			-i 3 2 0 0 \
			-s $3
	}
}

proc 右舷甲板への水密ドア {
	if( $s:登場ポイント == 右舷甲板からロード ) {
		chara 水密ドア 右舷水密ドア \
			-kms w01asdr_body_l w01asdr_handle \
			-position 11950,3000,-10325 \
			-rotate 0,3072,0 \
			-type 1 \
			-flag d:WT_DOOR_FLAG_OPEN_START \
			-hazard	11750,3000,-10225 11750,3000,-9225 \
			-proc 右舷甲板２Ｆへロード
	}else{
		//if( $w:ゲーム設定 == d:LEVEL_HARD || $w:ゲーム設定 == d:LEVEL_EXTREME ){
		if( $w:ゲーム設定 >= d:LEVEL_HARD ){
			chara 水密ドア 右舷水密ドア \
				-kms w01asdr_body_l w01asdr_handle \
				-position 11950,3000,-10325 \
				-rotate 0,3072,0 \
				-type 1 \
				-flag d:WT_DOOR_FLAG_NOT_OPEN \
				-hazard	11750,3000,-10225 11750,3000,-9225 \
				-proc 右舷甲板２Ｆへロード
		}else{
			chara 水密ドア 右舷水密ドア \
				-kms w01asdr_body_l w01asdr_handle \
				-position 11950,3000,-10325 \
				-rotate 0,3072,0 \
				-type 1 \
				-hazard	11750,3000,-10225 11750,3000,-9225 \
				-proc 右舷甲板２Ｆへロード
		}
	}

	trap dr003 d:PLAYER \
		-mask いる \
		-button d:ACTION_BUTTON \
		-state 0 \
		-exec {
			command 水密ドア状態 -n 右舷水密ドア
			mesg プレイヤー d:PLAYER wt_door 右舷水密ドア $status 1024,1024 11950,-10325
	}

	// モーション中のカメラ
	trap dr003 d:PLAYER -mask ？ -state 6 \
		-exec {
			if( $f:ロードチェックＯＮフラグ == 1 ) {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 10959,6313,-9216 -t 11064,4860,-9594 \
					-r 852,1872,0 -f 1505 \
					-a 200 \
					-i 3 2 0 0 \
					-s $3
			}
	}

	// ステージスタート時のロードカメラ
	trap dr003 d:PLAYER -mask ？ \
		-exec {
			if( $f:ロードチェックＯＮフラグ == 0 ) {
				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 10959,6313,-9216 -t 11064,4860,-9594 \
					-r 852,1872,0 -f 1505 \
					-a 200 \
					-i 0 2 0 0 \
					-s $3

				mesg ローカル風 室内風 オン

				chara delay ディレイ -time 1 -exec {
					command ＳＥセットモード -s d:se_code:SD_A_DRCRAIN1 -p 11750 4000 -10000 -m 0
				}

				chara delay ディレイ -time 100 -exec {
					mesg ローカル風 室内風 オフ
				}
			}
	}
}

/***************************************************************************************************/
// 入出ロードのproc化
/***************************************************************************************************/
proc ロードプロック {
	if ($s:呼び出しプロック == mv_w01b_w01f_0x) {
		@mv_w01b_w01f_0x
	} else if ($s:呼び出しプロック == mv_w01b_w01f_1) {
		@mv_w01b_w01f_1
	} else if ($s:呼び出しプロック == mv_w01b_w00a_0) {
		@mv_w01b_w00a_0
	} else if ($s:呼び出しプロック == mv_w01b_w00a_1) {
		@mv_w01b_w00a_1
	} else if ($s:呼び出しプロック == mv_w01b_w01c_0) {
		@mv_w01b_w01c_0
	} else if ($s:呼び出しプロック == mv_w01b_w01c_1) {
		@mv_w01b_w01c_1
	}
}

proc １Ｆリフレッシュルーム中央階段左側へロード {
#if d:LOAD_W01F_L
	trap ld000 d:PLAYER \
		-mask 入る \
		-exec {
			if( $f:ロードチェックＯＮフラグ == 1 ) {
				chara カメラ設定 ロードカメラ \
					-c 1 \
					-p -5000,5372,-5200 -t -5000,4328,-8694 \
					-r 115,2048,0 -f 5942 \
					-a 200 \
					-i 3 0 0 0 \
					-s 1
				preseek 'w01f'
				@ステージ終了時処理（ステージ名表示） -2800 3000 -9000 1024 mv_w01b_w01f_0x d:DEFAULT_M_TYPE
			}
		}
#endif
}

proc １Ｆリフレッシュルーム中央階段右側へロード {
#if d:LOAD_W01F_R
	trap ld001 d:PLAYER \
		-mask 入る \
		-exec {
			if( $f:ロードチェックＯＮフラグ == 1 ) {
				chara カメラ設定 ロードカメラ \
					-c 1 \
					-p 5000,5372,-5200 -t 5000,4328,-8694 \
					-r 115,2048,0 -f 5942 \
					-a 200 \
					-i 3 0 0 0 \
					-s 1

				preseek 'w01f'
				@ステージ終了時処理（ステージ名表示） 2800 3000 -9000 1024 mv_w01b_w01f_1 d:DEFAULT_M_TYPE d:wn_船橋一階リフレッシュルーム
			}
		}
#endif
}

proc 左舷甲板２Ｆへロード $:トリガ {
#if d:LOAD_W00A_L
//	if( $f:ロードチェックＯＮフラグ == 1 ) {
		if ($:トリガ == 0) {
			chara カメラ設定 ロードカメラ \
				-c 1 \
				-p -10400,8350,-9600 -t -10400,4000,-10250 \
				-r 927,2048,0 -f 4398 \
				-a 200 \
				-i 3 0 0 0 \
				-s 1

			preseek 'w00a'
			@ステージ終了時処理（ステージ名表示） -14000 3000 -9750 3072 mv_w01b_w00a_0 d:DEFAULT_M_TYPE d:wn_船尾甲板左舷
		}else if ( $:トリガ == 3 ) {

			// 水密ドアが開き始めたら隙間風を吹かしＳＥをコールする
			chara delay ディレイ -time 45 -exec {
				command ＳＥセットモード -s d:se_code:SD_A_DRORAIN1 -p 11750 4000 -10000 -m 0
				mesg ローカル風 室内風 オン
			}
		}
//	}
#endif
}

proc 右舷甲板２Ｆへロード $:トリガ {
#if d:LOAD_W00A_R
//	if( $f:ロードチェックＯＮフラグ == 1 ) {
		if ($:トリガ == 0) {
			chara カメラ設定 ロードカメラ \
				-c 1 \
				-p 10959,6313,-9216 -t 11064,4860,-9594 \
				-r 852,1872,0 -f 1505 \
				-a 200 \
				-i 3 0 0 0 \
				-s 1

			preseek 'w00a'
			@ステージ終了時処理（ステージ名表示） 14000 3000 -9750 1024 mv_w01b_w00a_1 d:DEFAULT_M_TYPE d:wn_船尾甲板右舷
		}else if ( $:トリガ == 3 ) {

			// 水密ドアが開き始めたら隙間風を吹かす
			chara delay ディレイ -time 45 -exec {
				command ＳＥセットモード -s d:se_code:SD_A_DRORAIN1 -p 11750 4000 -10000 -m 0
				mesg ローカル風 室内風 オン
			}
		}
//	}
#endif
}

proc 居住区３Ｆ左側へロード {
#if d:LOAD_W01C_L
	trap ld004 d:PLAYER -mask 入る \
		-exec {
			if( $f:ロードチェックＯＮフラグ == 1 ) {
			// 階段カメラ
/*
				@CS_スムーズカメラ３ $6 -11000 -12500 -11250 -9250 6500 3750 4250 5500
				eval( $i:補完ＰＸ = $i:CS_結果１ )
				eval( $i:補完ＰＹ = $i:CS_結果２ )
				eval( $i:補完ＴＹ = $i:CS_結果３ )
				eval( $i:補完ＴＺ = $6 )

				eval( $i:補完ＴＸ = -11250 )
				chara カメラ設定 ロードカメラ \
					-c 1 \
					-p $i:補完ＰＸ,$i:補完ＰＹ,-9600 \
					-t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ \
					-a 200 \
					-i 1 -1 0 0 \
					-s $3
*/

/*
					-p -10649,4963,-7498 -t -10936,4665,-10281 \
					-r 69,2115,0 -f 2814 \
					-a 200 \
*/
				chara カメラ設定 ロードカメラ \
					-c 1 \
					-p -10649,4963,-7498 \
					-t -10936,4665,-10281 \
					-r 69,2115,0 -f 2814 \
					-a 200 \
					-i 1 -1 0 0 \
					-s $3

				preseek 'w01c'
				@ステージ終了時処理（ステージ名表示） -11250 6000 -15000 2048 mv_w01b_w01c_0 d:DEFAULT_M_TYPE d:wn_船橋三階居住区左舷
			}
		}
#endif
}

proc 居住区３Ｆ右側へロード {
#if d:LOAD_W01C_R
	trap ld005 d:PLAYER -mask 入る \
		-exec {
			if( $f:ロードチェックＯＮフラグ == 1 ) {
			// 階段カメラ
				@CS_スムーズカメラ３ $6 -11000 -12500 11250 9250 6500 3750 4250 5500
				eval( $i:補完ＰＸ = $i:CS_結果１ )
				eval( $i:補完ＰＹ = $i:CS_結果２ )
				eval( $i:補完ＴＹ = $i:CS_結果３ )
				eval( $i:補完ＴＺ = $6 )

				eval( $i:補完ＴＸ = 11250 )
				chara カメラ設定 ロードカメラ \
					-c 1 \
					-p $i:補完ＰＸ,$i:補完ＰＹ,-9600 \
					-t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ \
					-a 200 \
					-i 1 -1 0 0 \
					-s $3

				eval($i:w01c_直前のマップ = 2)

				preseek 'w01c'
				@ステージ終了時処理（ステージ名表示） 11250 6000 -15000 2048 mv_w01b_w01c_1 d:DEFAULT_M_TYPE
			}
		}
#endif
}

