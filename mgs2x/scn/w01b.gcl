/***************************************************************************************************/
// プレイヤーのproc化
/***************************************************************************************************/
proc プレイヤー設定 {
#if d:SNAKE
	chara プレイヤー スネーク \
		-m sna_def \
		-a snake \
		-p $i:プレイヤー初期Ｘ位置 $i:プレイヤー初期Ｙ位置 $i:プレイヤー初期Ｚ位置 \
		-d 0,$i:プレイヤー初期方向,0 \
		-l 2800 \
		//-homing 6000 128 \
		//-f d:PLY_NO_FOOT_SHADOW \
		-i 0 \	//足音の設定
		-s 0

	chara ロープモデル３ バンダナ１ \
		-n sna_bdn1 \
		-d 1 \
		-y スネーク \
		-z 12 \
		-x 0,60,-90 \
		-m 12 \
		-p 250 \
		-k 350 \
		-o 110 \
		-f 1

	chara ロープモデル３ バンダナ２ \
		-n sna_bdn2 \
		-d 1 \
		-y スネーク \
		-z 12 \
		-x 0,50,-90 \
		-m 20 \
		-p 250 \
		-k 350 \
		-o 110 \
		-f 1
#else if d:RAIDEN
	chara プレイヤー d:PLAYER \
		-p $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,$i:プレイヤー初期Ｚ位置 \
		-d 0,$i:プレイヤー初期方向,0 \
		-s 0 \
		-o rai_m00
#endif

	@プレイヤーＬＯＤ設定 d:C_DISTANCE_TYPE 6000
}

proc 水飛沫 {
	chara キャラ付随水飛抹 スネーク水飛沫 \
			-nconcname d:PLAYER \
			-addone 32 \
			-time d:CHARA_SPLASH_TIME \
			-rgbadd 0x40404030 \
			-gbsub 0x40404030
}

proc 影表示 {
#if d:SHADOW
	chara 影投影モデル 二階影モデル中央 -model w01bk_center -pos 0 0 0
	chara 影投影モデル 二階影モデル左   -model w01bk_left 	-pos 0 0 0
	chara 影投影モデル 二階影モデル右   -model w01bk_right 	-pos 0 0 0

	command 影投影ハザード \
		-name ２Ｆ廻廊部 \
		-group 1

	chara 影管理 影管理 \
		-type 1 \
		-length 8000

	// 影のＯＮ／ＯＦＦを行う
	trap ev005 ？ -mask ？ \
	-exec {
		if( $3 == 入る ){
			mesg 影管理 影管理 add $2 二階影モデル中央
		}else{
			mesg 影管理 影管理 del $2
		}
	}
	trap ev006 ？ -mask ？ \
	-exec {
		if( $3 == 入る ){
			mesg 影管理 影管理 add $2 二階影モデル左
		}else{
			mesg 影管理 影管理 del $2
		}
	}
	trap ev007 ？ -mask ？ \
	-exec {
		if( $3 == 入る ){
			mesg 影管理 影管理 add $2 二階影モデル右
		}else{
			mesg 影管理 影管理 del $2
		}
	}
#endif
}

