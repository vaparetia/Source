// デバッグ設定
#ifdef d:FIX_MODE
	#define MY_DEBUG	0		// デバッグ
#else
	#define MY_DEBUG	0		// デバッグ
#endif

#define	VAR_SAVE			1	// フラグのセーブ

// レーダー用
#define STAGE_TANKER		1	// タンカーレーダー
// 薬莢
#define ENE_T_GOL			1	// タンカー編ゴル兵
#define ENE_SHIELD			1	// 盾兵

// サウンド
#define STAGE_W01B			1		// サウンド用ディファイン

// プラグイン
#define LD_FADEOUT 			1
#define STAGE_END			1
#define PAN_CAMERA			1

#define DEMO_CANCEL			1	// デモキャンセル

// 敵兵の設置
#define ENEMY				1  	// 全体

// オブジェクト
#define SHIP_HEAD			1	// 窓から見える船首方向の構造物

// エフェクト
#define FOG					1	// フォグの設定
#define W01B_NEWYORK		0	// 船外景色一式
#define BONBON				0	// タンカーぼんぼり
#define RAIN_WINDOW			1	// 窓の雨粒
#define RAIN_SET			0	// 船外の雨
#define WIND				1	// 船外の暴風
#define	BREAK_LIGHT			1	// 壊れライトの設定
#define	MIRROR				1	// 鏡面モデルの設定
#define	ITEM				1	// アイテム設定
#define SHADOW				1	// 影の設定
#define	BOKASHI				0	// 近景ぼかし 遠景ぼかし
#define FIRE_HOSE			1
#define	LOCKER_SET			1	// ロッカーセット
#define SHADOW_DEMO			1

// 光源
#define CHARA_AMBIENT		1	// キャラ専用の環境光

// ステージ間ロード
#define LOAD_W01F_L		0	// 居住区１Ｆリフレッシュルーム中央階段左側（w01f）へ
#define LOAD_W01F_R		1	// 居住区１Ｆリフレッシュルーム中央階段右側（w01f）
#define LOAD_W00A_L		0	// 左舷甲板２Ｆ（w00a）へ
#define LOAD_W00A_R		1	// 右舷甲板２Ｆ（w00a）へ
#define LOAD_W01C_L		1	// 居住区３Ｆ左側（w01c）へ
#define LOAD_W01C_R		0	// 居住区３Ｆ右側（w01c）へ

// プレイヤー状態
#define		STAND		0		// 立ち
#define		SQUAT		1		// しゃがみ
#define		GROUND		2		// 匍匐
#define		SUBJECT		3		// 主観
#define		CAUTION		4		// 張り付き
#define		ELUDE		5		// エルード
#define		FORCE		6		// 強制モーション
#define		LOCKER		7		// ロッカーモード
#define		BEHIND		8		// ビハインド
#define		LADDER		9		// はしご

// キャラクター関係
#define		SNAKE			1
#define		RAIDEN			0
#if d:SNAKE
	#define		PLAYER		スネーク
#else
	#define		PLAYER		ライデン
#endif


