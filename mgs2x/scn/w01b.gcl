proc 北部南北通路左側カメラ {
	trap ca001 d:PLAYER \
		-mask ＊ \
		-camera \
		-exec {
			if( $3 == 入る)	{
				if( $i:前フレーム位置Ｘ < -6000 ){
					eval( $w:補完方式 = 0 )		// 西から進入
				}else{
					if( $i:前フレーム位置Ｚ > -7000 ){
						eval( $w:補完方式 = 1 )	// 南から進入
					}else{
						// 北から進入した場合の補完方式の値はca026で代入済み
						//eval( $w:補完方式 = 0 )	// 北から進入
					}
				}
			}

			@CS_スムーズカメラ昇順 $6 -5041 -4836  114 428
				eval( $i:補完ＲＸ = $i:CS_結果１ )
			chara カメラ設定 通路カメラ１ \
				-c 0 \
				-b -5000 5000 -17750   -5000 5372 -5200 \
				-l -5000 -20000 -20000   -5000 4328 20000 \
				-r $i:補完ＲＸ,2048,0 -f 6000 \
				-a 200 \
				-i $w:補完方式 -1 0 0 \
				-slide 1 5 6000 3000 50 0 \
				-s $3
		}
}

proc クランク部北西カメラ右カメラ {
	trap ca002 d:PLAYER \
		-mask ＊ \
		-camera \
		-exec {
			if( $3 == 入る ){
				// 北から進入した場合補完方式の値を入れる。
				// 南から進入した場合は補完方式の値は代入済み
				if( $i:前フレーム位置Ｘ > -6000 ){
					eval( $w:補完方式 = 1 )
				}
			}
			@CS_スムーズカメラ昇順 $6 -7000 -6500  5372 7182
				eval( $i:補完ＰＹ = $i:CS_結果１ )
			@CS_スムーズカメラ昇順 $6 -7000 -6500  -5110 -5500
				eval( $i:補完ＰＺ = $i:CS_結果１ )
			@CS_スムーズカメラ昇順 $6 -7000 -6500  -7015 -6157
				eval( $i:補完ＴＺ = $i:CS_結果１ )
			if( $4 > -5000 ){
				eval( $i:補完ＰＸ = -5000 )
			}else{
				eval( $i:補完ＰＸ = $4 )
			}
			chara カメラ設定 通路カメラ１ \
				-c 1 \
				-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ -t $i:補完ＰＸ,4328,$i:補完ＴＺ \
				-r 889,2048,0 -f 3174 \
				-a 200 \
				-i $w:補完方式 -1 0 0 \
				-s $3
		}
}

proc クランク部北西カメラ左カメラ {
	trap ca003 d:PLAYER \
		-mask ＊ \
		-camera \
		-exec {

			if( $3 == 入る)	{ eval( $i:進入位置Ｘ = $i:前フレーム位置Ｘ ) }

			if( $i:進入位置Ｘ < -6000){	// 南から進入
				if( $4 < -6800 ){
					eval( $i:補完ＰＸ = -6800 )
				}else{
					eval( $i:補完ＰＸ = $4 )
				}
				chara カメラ設定 通路カメラ１ \
					-c 1 \
					-p $i:補完ＰＸ,7182,-5500 -t $i:補完ＰＸ,4328,-6157 \
					-r 889,2048,0 -f 3174 \
					-a 200 \
					-i 0 -1 0 0 \
					-s $3
				eval( $w:補完方式 = 1 )	// ca002で使用
			}else{						// 東から進入
				if( $4 < -6688 ){
					eval( $i:補完ＰＸ = -6688 )
					eval( $i:補完ＴＸ = -6688 )
				}else if( $4 > -6321 ){
					eval( $i:補完ＰＸ = -6321 )
					eval( $i:補完ＴＸ = -6321 )
				}else{
					eval( $i:補完ＰＸ = $4 )
					eval( $i:補完ＴＸ = $4 )
				}

				chara カメラ設定 通路カメラ１ \
					-c 1 \
					-p $i:補完ＰＸ,5499,4099 -t $i:補完ＴＸ,4790,2270 \
					-r 55,2048,0 -f 6000 \
					-a 200 \
					-i 0 -1 0 0 \
					-slide 1 5 6000 3000 50 0 \
					-s $3
				eval( $w:補完方式 = 0 )	// ca002で使用
			}
		}
}

