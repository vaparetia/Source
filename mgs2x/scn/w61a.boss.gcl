// 各gclで必要なdefine
// ------------------------------------
// モード
#define		BOSS_MODE		1		// 共通プロック切り分け用

// include
// ------------------------------------
#include "w61a.gcl"

// マップ設定
// ------------------------------------
chara マップ フェデラルホール -k d:KMS_NAME0 -k d:GW_NAME -h d:HZX_NAME,0 -l d:LT2_NAME

command マップ設定 フェデラルホール -set {
	@常駐キャラ設定
	@ローカル変数初期化
	@設定値変更
	@プラグイン設定
	@シナリオデモキャラセット
	@アイテム状態制御
	@ボスラッシュプレイヤー設定 4605 18000 8288 0 d:FA_END_STAND sna_w61a rai_w61a
	@ソリダスセット
	@遠景設定
	@フェデラルホール旗設置
	@ビル窓設置
	@ボスラッシュ用アイテム設定
	@フォグ設定
	@フェデラルホールビヨンド設定
	@カメラセット
	@体力０で落下死設定
	@落下死カメラ設定
	@キャラ用ライト設置
	@ボスラッシュ開始時キャラ設定
	#if d:DEBUG_CHARA
//		@デバッグキャラセット
	#endif
}

//初期マップの表示
command マップ表示 -show フェデラルホール
// 全てのセットが終わったところでフェードイン
// フェードインが終わるまではパッドリリース


