}
/*ライデン、エルード中は完全に無防備だ。そこから叩き落とされたら、とても
助からないぞ。気をつけろ。
*/
//dv}//v
}//d


//銃で攻撃 h //e
resource PC_ファットマン戦＿銃撃戦__e {
//vox t:vc263141 {
大佐_000: {
Bombs are not the only
weapons Fatman has.
}
/*ファットマンの武器は爆弾だけではない。
