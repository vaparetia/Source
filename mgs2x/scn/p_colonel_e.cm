I'll try.
}
/*わかってる。*/
//dv}//v
}//d
resource PC_エマ手つなぎ＿座り込み２__e {
//vox t:vc264231 {
大佐_000: {
She can't even walk by herself
because of the drugs in her system.
}//<ページ数変更>
