//★P028_01_P01爆弾解体後フォーチュン再登場１ポリゴンデモ１終了＜フラグ＜P031_01_P01フォーチュン戦終了１ポリゴンデモ１開始 d //e
//フォーチュン戦中 h //e
//倒せない h //e
//一回目のみ t //e
resource PC_フォーチュン戦＿倒せない１__e {
//vox t:vc262901 {
ライデン_000: {
What is she, a witch!?
For some reason, I can't
hit her!
}
/*あの女は魔女か！！
なぜ弾が当たらない！？
*/
大佐_001: {
I don't understand. She's
obviously impervious to
attack...
}
/*わからん。
だが彼女に攻撃が無効なのは確かだ。
*/
ライデン_002: {
What are my options?
}
/*何か方法はないのか？*/
大佐_003: {
Disengage her and get out.
}
/*逃げるしかないな。*/
ライデン_004: {
The elevator is still upstairs.
My retreat's been cut off.
}
/*昇降機は上がったままだ。
退路も断たれている……。
*/
//dv}//v
}//d
resource PC_フォーチュン戦＿倒せない２__e {
//vox t:vc262911 {
大佐_000: {
Hang on until the elevator
comes down again.
}//<ページ数変更>
大佐_000_1: {
Your weapons can't hurt her,
and you need to stay alive.
}//<ページ数変更>
大佐_000_2: {
Use whatever cover you
can find and evade her.
}
/*昇降機が降りてくるまで耐えるんだ。
こちらの攻撃が当たらない以上、逃げる
しかない。遮蔽物を利用しろ。
*/
//dv}//v
}//d


//コンテナに隠れろ h //e
