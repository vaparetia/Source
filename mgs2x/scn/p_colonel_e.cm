}
/*しばらく待てばエレベータが来るはずだ。
*/
//dv}//v
}//d
//危険モード中はだめ h //e
resource PC_シェル１中央棟１Ｆ＿エレベータ＿危険__e {
//vox t:vc261631 {
大佐_000: {
The enemies will stop all elevators
during an Alert mode to prevent
intruders,
}//<ページ数変更>
大佐_000_1: {
-- in other words you --
from moving out of the area.
}
/*敵は危険モード中、エレベータの運行を
停止するはずだ。侵入者、つまり君を
