//シェル１中央棟Ｂ２電算室 d //e
//オウム h //e
resource PC_シェル１中央棟Ｂ２＿オウム__e {
//vox t:vc265431 {
ライデン_000: {
What's that bird...?
}
/*なんだこの鳥は……？*/
大佐_001: {
Parrot, isn't it?
}
/*オウムだろう。*/
ローズ_002: {
Probably a large budgie.
}
/*多分、オオホンセイインコか何かね。*/
ローズ_003: {
Parakeets get used to humans
easily, and are talkative, so
they are real playful and fun.
}
/*インコは人に馴れやすいし、よく
しゃべってくれるからにぎやかで
楽しいの。
*/
ローズ_004: {
Hurts when they bite, though,
and keeping their cage clean
is quite a task.
}//<ページ数変更>
ローズ_004_1: {
Having one isn't
all fun and games.
}
/*噛まれるとちょっと痛いしお掃除も
結構大変だから世話は割と面倒なんだ
けどね。
*/
ライデン_005: {
You sure know a lot
about parakeets.
}
/*ずいぶん詳しいな。
*/
ローズ_006: {
I had my own once.
}
/*飼ってたことあるから。*/
ライデン_007: {
I didn't know that.
}
/*そうだったんだ。*/
ローズ_008: {
I never mentioned it?
}
/*話したことなかった？*/
ライデン_009: {
No, this is the first time.
}
/*ああ。初めて聞いたよ。*/
ローズ_010: {
Really?
}
/*そうだった？*/
ライデン_011: {
Yeah. There's probably a lot of
other things that I don't know
about you yet.
}
/*ああ。まだ聞いてないことって
いっぱいあるのかもしれないな。
*/
ローズ_012: {
...Yeah... actually, well...
there's a lot more.
}
/*……そう……あるわね……
……いっぱい……。
*/
ライデン_013: {
...Rose?
}
/*……ローズ？*/
ローズ_014: {
Jack.
}
/*ジャック。*/
ライデン_015: {
What?
}
/*なんだ？*/
ローズ_016: {
After this mission is over
let's talk, about lots of things.
}
/*この任務が終わったら。
話しあいましょう。いっぱい。
*/
ライデン_017: {
Yeah, lets.
}
/*ああ。そうしよう。*/
ローズ_018: {
Good luck.
}
/*がんばって。*/
//dv}//v
}//d

