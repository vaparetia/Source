*/
//dv}//v
}//d

//オルガについて h //e
resource PC_Ｅ脚オルガ__e {
//vox t:vc265391 {
ライデン_000: {
Colonel, what do you know about
that female soldier Olga?
}
/*大佐、あのオルガという女兵士は
