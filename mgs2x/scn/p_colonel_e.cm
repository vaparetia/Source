*/
大佐_002: {
Look at the lights, and defuse
the bombs according to the
degree of urgency.
}
/*ランプを見て緊急度の高い順から
処理していくんだ。
*/
//dv}//v
}//d
//爆発するまでの時間 h //e
resource PC_ファットマン戦＿Ｃ４カウントダウン__e {
//vox t:vc263041 {
大佐_000: {
The countdown timer will tell
you how long you have until
the C4's detonate.
}
/*あとどれくらいでＣ４が爆発するかは
