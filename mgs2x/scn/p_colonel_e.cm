//dv}//v
}//d

//★P034_01_P01ファットマン死亡１ポリゴンデモ１終了＜フラグ＜P035_01_R01ファットマン爆弾解体終了１無線デモ１開始 d //e
//ファットマン最後の爆弾 h //e
//一回目のみ t //e
resource PC_ファットマン戦後＿最終爆弾１__e {
//vox t:vc263161 {
ライデン_000: {
Colonel, where's that bomb?
}
/*大佐、爆弾はどこにある？*/
大佐_001: {
We have no information on that.
Sweep the area.
}
/*わからん、とにかく探すしかない。
*/
ローズ_002: {
Hurry, Jack!
}
/*急いで、ジャック！*/
//dv}//v
}//d
resource PC_ファットマン戦後＿最終爆弾２__e {
//vox t:vc263171 {
大佐_000: {
The bomb has to be somewhere
on the heliport. Use whatever
means necessary to locate it.
}
/*爆弾は必ずヘリポートのどこかに
あるはずだ。なんとかして探し出すんだ。
*/
//dv}//v
}//d
//最終爆弾ヒント h //e
resource PC_ファットマン戦後＿最終爆弾ヒント１__e {
//vox t:vc263181 {
大佐_000: {
Raiden, have you located
the bomb yet?
}
/*ライデン、爆弾は見つかったか？
*/
ライデン_001: {
No, not yet...
}
/*いや、まだだ……。*/
ローズ_002: {
Hurry, Jack! We don't
have a lot of time left!
}
/*急いで、ジャック！時間がないわ！
*/
//dv}//v
}//d
//最終爆弾ヒント h //e
resource PC_ファットマン戦後＿最終爆弾ヒント２__e {
//vox t:vc263191 {
大佐_000: {
He wouldn't have had the time to
find a good hiding place; it must
be somewhere near him.
}//<ページ数変更>
大佐_000_1: {
Take a closer look.
}
/*凝った場所にしかける時間があったとは
思えん。おそらく奴の近くだ。
よく探してみるんだ。
*/
//dv}//v
}//d

//最終爆弾ズバリ h //e
resource PC_ファットマン戦後＿最終爆弾ズバリ__e {
//vox t:vc263201 {
大佐_000: {
Raiden, the bomb?
}
/*ライデン、爆弾は？*/
ライデン_001: {
Nothing yet...
}
/*まだだ……。*/
大佐_002: {
Where is that damned thing...
we're running out of time.
}
/*一体どこに……もう時間がないぞ。
*/
ローズ_003: {
Have you checked under
Fatman's body?
}
/*ファットマンの体の下は？
*/
ライデン_004: {
What? Of course not.
It can't be there.
}
/*なんだって？
そんなわけないだろ。
*/
ローズ_005: {
You don't know that.
}
/*わからないじゃない。*/
ライデン_006: {
OK, what evidence do you
have that it's there?
}
/*根拠は？
*/
ローズ_007: {
Just a hunch, all right?
}
/*ないけど。*/
ライデン_008: {
Look Rose -- I know what
I'm doing, and this is my
life on the line.
}//<ページ数変更>
ライデン_008_1: {
You don't have any experience
in this type of work, so ju...
}
/*……ふぅ……ローズ……。
素人は黙っててくれ。
こっちは命がかかってるんだ。
*/
ローズ_009: {
...
}
/*……。*/
大佐_010: {
Raiden, don't turn down a good
suggestion when you hear one.
Check it out.
}
/*ライデン、そう言わずに
とりあえず調べてみたらどうだ。
*/
//dv}//v
}//d


//★P035_01_R01ファットマン爆弾解体終了１無線デモ１終了＜フラグ＜P036_01_P01忍者登場１ポリゴンデモ１開始 d //e
//ヘリポートから下りろ h //e
resource PC_忍者登場前＿ヘリポート__e {
//vox t:vc263211 {
大佐_000: {
Raiden, let's get back to the
task of rescuing the President.
}//<ページ数変更>
大佐_000_1: {
Head to the core of Shell 1
and investigate the area.
}
/*ライデン、大統領救出任務に戻れ。
まだ調べていないシェル１中央棟に
向かうんだ。
*/
//dv}//v
}//d

//ローズに爆弾位置を教えてもらった場合 h //e
resource PC_忍者登場前＿ローズ助けられ__e {
//vox t:vc263221 {
ローズ_000: {
Jack?
}
/*ジャック？*/
ライデン_001: {
-- what?
}
/*……なんだ？*/
ローズ_002: {
You know what I'm talking about.
}
/*またとぼけて。*/
ライデン_003: {
All right, all right. The bomb was
where you guessed it would be. You
were right, and you saved my butt!
}
/*……わかったよ。確かに爆弾は君の
言った場所に仕掛けてあった。君が
正しかった。君のおかげで助かった！
*/
ローズ_004: {
As long as you realize that.
}
/*わかればよろしい。*/
ライデン_005: {
I was pretty surprised though.
I never expected to find it
where I did...
}
/*しかし意外だったよ。
本当に君の言った通りだったとは……。
*/
ローズ_006: {
Hm, you must think I'm
pretty clueless, huh?
}
/*ふーん。
それ、私は役に立たないって思って
たってこと？
*/
ライデン_007: {
Of course not! And I have
a pretty healthy respect for
the woman's intuition thing now.
}
/*いや、そういうわけじゃないが。
女の勘って奴はあなどれないな、と。
*/
ローズ_008: {
That is such a sexist thing
to say, you know that?
}
/*その言い方、何か女性差別的。
*/
ライデン_009: {
Come on, don't be mad.
I apologized already.
}
/*いちいち突っかからないでくれ。
あやまったじゃないか……。
*/
ローズ_010: {
Don't sweat it -- I'm
just messing with ya.
}
/*ふふ。うそ。冗談よ。
気にしないで。
*/
ローズ_011: {
I want you to recognize that I can
help you through this thing -- and
that I care about you.
}
/*……私もあなたの役に立つって……
あなたのこと本当に心配してるって
認めてもらいたかっただけ……。
*/
ライデン_012: {
Rose...
}
/*ローズ……。*/
ローズ_013: {
Hang in there, okay?
}
/*がんばってね。*/
//dv}//v
}//d

//★P036_13_R04忍者登場１３無線デモ４終了＜フラグ＜P037_01_R01スネークの遺体１無線デモ１開始 d //e
//中央棟に人質 h //e
resource PC_人質＿中央棟行け__e {
//vox t:vc263231 {
大佐_000: {
Raiden, make contact with
Ames and find out where
the President is.
}
/*ライデン、エイムズに接触して大統領の
居所を聞き出すんだ。
*/
大佐_001: {
Our information indicates that
Ames is being held in the B1
level of Shell 1's core.
}//<ページ数変更>
大佐_001_1: {
Head for the core of Shell 1.
}
/*エイムズはシェル１中央棟のＢ１に
人質として捕えられているらしい。
シェル１中央棟に向かえ。
*/
//dv}//v
}//d

//指向性マイク h //e
//一回目のみ t //e
resource PC_人質＿指向性マイク１__e {
//vox t:vc263241 {
大佐_000: {
Ames is most likely being
held with other hostages.
}
/*エイムズは他の人質と一緒に
捕らえられているらしい。
*/
ライデン_001: {
Sure -- but I don't even
know what Ames looks like.
}
/*ああ。だが俺はエイムズの顔を知らない。
*/
//dv}//v
}//d

resource PC_人質＿指向性マイク２__e {
//vox t:vc263251 {
大佐_000: {
Use the directional microphone to
distinguish Ames from the other
hostages. It's the only way.
}
/*エイムズを他の人質から見分けるには
指向性マイクを使うしかないようだ。
*/
大佐_001: {
According to our information,
Ames has a pacemaker.
}//<ページ数変更>
大佐_001_1: {
This should make his cardiac
pattern fairly distinct.
}//<ページ数変更>
大佐_001_2: {
Use the directional microphone
to locate it.
}
/*エイムズは心臓にペースメイカーを埋め
込んでいるらしい。心音が違うはずだ。
それを指向性マイクで聞き分けるんだ。
*/
//dv}//v
}//d
//マイク持ってない場合 t //e
resource PC_人質＿指向性マイク３__e {
//vox t:vc263261 {
大佐_000: {
Isn't the directional microphone
supposed to be somewhere in
the core of Shell 1?
}
/*指向性マイクはシェル１中央棟の
どこかにあるんだろう？
*/
//dv}//v
}//d


//変装方法 h //e
resource PC_変装＿変装方法１__e {
//vox t:vc263271 {
大佐_000: {
Shell 1's core has extremely
tight security.
}//<ページ数変更>
大佐_000_1: {
Impersonate an enemy personnel
to infiltrate the section.
}
/*シェル１中央棟の警備は厳重だ。
敵に変装して潜入するんだ。
*/
大佐_001: {
For a proper disguise, select the
enemy field uniform you received
from the Ninja.
}//<ページ数変更>
大佐_001_1: {
This will allow you to blend in.
}
/*変装するには、まずあの忍者から
渡された敵兵士の野戦服を装備するんだ。
それで敵の服装を真似ることが出来る。
*/
//dv}//v
}//d
resource PC_変装＿変装方法２__e {
//vox t:vc263281 {
大佐_000: {
But you still need one more thing.
}
/*だがそれだけでは不十分だ。*/
//dv}//v
}//d
resource PC_変装＿ＡＫ装備__e {
//vox t:vc263291 {
大佐_000: {
It will look suspicious
if you're not carrying
the standard equipment.
}
/*敵兵士と同じ武器を装備していなければ
怪しまれるぞ。
*/
大佐_001: {
All personnel in the core are
equipped with AK-74U's.
}//<ページ数変更>
大佐_001_1: {
Select your own AK when
you're in disguise.
}
/*中央棟の敵兵士は武器として
ＡＫＳ７４Ｕを装備している。
変装する時はＡＫを装備しろ。
*/
//dv}//v
}//d
//ＡＫ持っていない場合 t //e
resource PC_変装＿ＡＫ探せ__e {
//vox t:vc263301 {
大佐_000: {
Find yourself an AK.
}//<ページ数変更>
大佐_000_1: {
You have a Level 2 card in your
possession; go and search the
warehouse in Strut F.
}
/*ＡＫを探すんだ。カード２を手に入れた
だろう。Ｆ脚の倉庫を探してみては
どうだ？
*/
//dv}//v
}//d
//変装中攻撃すると見つかる h //e
resource PC_変装＿攻撃するな__e {
//vox t:vc263311 {
大佐_000: {
Even the most successful
disguise can't protect you＃−
}//<ページ数変更>
大佐_000_1: {
if you decide to blow your own
cover by attacking the enemy.
}
/*変装に成功していても敵に攻撃を
しかけたりしてはたちまち正体が
ばれるぞ。
*/
大佐_001: {
Do not engage the enemy
while you are in disguise.
}
/*変装中は敵に手を出してはいけない。
いいな。
*/
//dv}//v
}//d
//変装中も怪しい行動はするな h //e
resource PC_変装＿怪しい行動__e {
//vox t:vc263321 {
大佐_000: {
Raiden, don't act in any way that
will excite the enemy's suspicion.
}
/*ライデン、敵に怪しまれるような
行動はするなよ。
*/
大佐_001: {
A perfect disguise can be ruined
by a single odd behavior.
Be careful.
}
/*いくら変装が完璧でもおかしな行動を
とれば正体を見破られてしまうぞ。
注意するんだ。
*/
