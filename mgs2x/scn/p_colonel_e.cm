*/
//dv}//v
}//d

//トイレの個室でエロ本装備 h //e
resource PC_Ｃ脚＿トイレ＿エロ本__e {
//vox t:vc265361 {
大佐_000: {
Raiden, what are you
doing there, with that?
}
/*ライデン、そんなところで……
そんなものを持って……。
*/
ローズ_001: {
I don't believe it! What are
you thinking? And during
your duties!?
}
/*ホントに信じられない！
何考えてるの！？
