Exactly...
}
/*その通り……。*/
ローズ_006: {
At least use a picture
of me instead!
}
/*せめて私の写真にして！
*/
ライデン_007: {
Wha...?
}
/*え？*/
ローズ_008: {
I mean...
}
/*あ……。*/
大佐_009: {
...I completely disapprove...
}
/*……全く度し難い……。*/
//dv}//v
}//d


//食堂について h //e
resource PC_ものは散らかさない１__e {
