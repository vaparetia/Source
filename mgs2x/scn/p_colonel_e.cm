/*……ジャック……？*/
ライデン_008: {
No, it's not like that.
}
/*いや、そういう意味じゃ……。*/
ローズ_009: {
Ha ha. I'm joking. I'll look
into her for you. Good luck.
}
/*ふふ。冗談よ。ちゃんと調べておくから。
がんばってね。
*/
//dv}//v
}//d

//しばらくしてから h //e
resource PC_オルガうんちく１__e {
//vox t:vc265401 {
大佐_000: {
Raiden, Rosemary did a bit of
research on that female soldier.
}
/*ライデン、ローズ君が例の女兵士の
ことを調べてくれた。
*/
//dv}//v
}//d
resource PC_オルガうんちく２__e {
//vox t:vc265411 {
ローズ_000: {
Jack, I found some information
on Olga Gurlukovich.
}
/*ジャック、オルガ・ゴルルコビッチに
