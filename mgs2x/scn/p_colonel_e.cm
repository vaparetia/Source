//女子便所 h //e
//ピーター遭遇前 h //e
resource PC_Ｃ脚女子トイレピーター前__e {
//vox t:vc265321 {
ローズ_000: {
I can't believe you, Jack.
Do you know what that
place is?
}
/*信じられない。
ジャック、そこがどこだかわかってるの？
*/
ライデン_001: {
Err, I just thought maybe
the bomb disposal instructor
might be in there...
}
/*いや、爆弾処理の教官がいるかと……。
*/
ローズ_002: {
Why would he be in there?
}
/*いるわけないでしょ。*/
ライデン_003: {
You never know.
He's AWOL, and...
}
/*わからないじゃないか。
異常事態なんだし……。
*/
ローズ_004: {
Even AWOL, a normal guy
wouldn't go into a woman's
bathroom!
}//<ページ数変更>
ローズ_004_1: {
You're the only one
I know who would!
}
/*異常事態でも普通の男の人は
女性用トイレになんか入りません！
そんなのあなただけ！
*/
ローズ_005: {
You're, like, really strange!
}
/*っていうか、あなたが異常！！*/
大佐_006: {
Rosemary, settle down.
}
/*ローズ君、落ち着いてくれ。*/
ローズ_007: {
But...
}
/*ですが……。*/
大佐_008: {
It's all right. Raiden, Rosemary
is right. You should probably
look someplace else.
}
/*まあまあ。
ライデン、ローズ君の言う通りだぞ。
別のところを探した方がいいだろう。
*/
大佐_009: {
...I can really sympathize
with you there, though...
}
/*……君の気持ちもよくわかるがな……。
*/
ローズ_010: {
What, sir?
}
/*はい！？*/
大佐_011: {
Err, nothing. Raiden, that's
that. Return to your duties.
}
/*あ、いや。ライデン、
とにかくそういうことだ。任務に戻れ。
*/
ライデン_012: {
...
}
/*……。*/
ローズ_013: {
...You guys are unbelievable...
}
/*……信じられない……。*/
//dv}//v
}//d

//便器主観 h //e
resource PC_Ｃ脚女子トイレ便器主観__e {
//vox t:vc265331 {
大佐_000: {
Uh, Raiden...
}
