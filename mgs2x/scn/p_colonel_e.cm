//潜入プール d//e

//フナムシの捨て方 h //e
resource PC_フナムシ＿捨て方１__e {
//vox t:vc260011 {
大佐_000: {
Shake your equipment to protect
the items from sea lice.
}
/*装備品をフナムシから守るには、
装備品をゆすってみればいい。
*/
//dv}//v
}//d

//フナムシがレーションを食っている状態での会話 h //e
resource PC_フナムシ＿捨て方ズバリ__e {
//vox t:vc260021 {
大佐_000: {
Raiden, the sea lice are getting
fat on your rations.
}//<ページ数変更>
大佐_000_1: {
Shake the equipment window
to get rid of the bugs.
}
/*ライデン、レーションがフナムシに
食われているぞ。装備品ウィンドウを
揺すってフナムシを払い落とすんだ。
*/
//dv}//v
}//d


//開かない金網ドア h //e
resource PC_開かない金網ドア__e {
//vox t:vc260031 {
大佐_000: {
Raiden, I don't think that door
will open. Find another route
to the other side.
}
/*ライデン、そこの扉は開きそうにない。
向こう側に行くには別の道を探す
しかないぞ。
*/
//dv}//v
}//d

//ダクト近く h //e
resource PC_ダクト__e {
//vox t:vc260041 {
大佐_000: {
Look down near your feet.
See that duct? Ducts can
be crawled into.
}
/*ライデン、足元を良く見ろ。
ダクトがあるぞ。ダクトには
ホフクすれば入り込むことが出来る。
*/
//dv}//v
}//d
//イントルード説明へ t //e

//ホフクでくぐれるもの近く h //e
resource PC_ホフクポイント__e {
//vox t:vc260051 {
大佐_000: {
You could probably get in
down there if you crawl.
}
/*ライデン、その下はホフクすれば
潜り込むことができそうだ。
*/
大佐_001: {
If you hide well, you can probably
escape when being pursued by
the enemy.
}
/*敵に追われた時にうまく隠れれば、
敵から逃げることも出来るかも
しれないな。
*/
//イントルード説明へ t//e
}//d

//イントルード説明 h //e
resource PC_イントルード１__e {
//vox t:vc260061{
大佐_000: {
Whenever you crawl into a narrow
space, the camera will automati-
cally switch to Intrusion View.
}
/*狭い所に入り込んだ時は、自動的に
イントルードカメラになる。
*/
//dv}//v
}//d

resource PC_イントルード２__e {
//vox t:vc260071 {
#ifdef d:XBOX
大佐_000: {
Move the left thumbstick
up to move forward, down
to move back.
}//<ページ数変更>
#else
大佐_000: {
Push the left analog stick
up to move forward, down
to move back.
}//<ページ数変更>
#endif

大佐_000_1: {
Push left and right to turn
in those directions.
}
/*左スティックの上で前進、下で後退、
左右はそれぞれの方向を向く。
*/
//dv}//v
}//d

resource PC_イントルード３__e {
//vox t:vc260081 {
大佐_000: {
Keep an eye on the enemy
and proceed under cover
at all times.
}//<ページ数変更>
大佐_000_1: {
You absolutely cannot afford
to be spotted.
}
/*敵の様子を伺いつつ、身を隠しながら
進むんだ。絶対に見つかるんじゃないぞ。
*/
//dv}//v
}//d

resource PC_イントルード＿銃撃てる__e {
//vox t:vc260091 {
大佐_000: {
Unlike in VR training, you can use
your gun from Intrusion View in
the field. Keep that in mind.
}
/*ＶＲ訓練の時とは違いイントルード
カメラの時でも銃を撃つことが出来る。
忘れるなよ。
*/
//dv}//v
}//d
resource PC_イントルード＿危険性__e {
//vox t:vc260101 {
大佐_000: {
Intrusion View does not guarantee
your safety. If you're spotted, you
will be attacked.
}
/*イントルードは決して安全と言うわけ
ではない。敵に発見されれば当然
攻撃を受ける。
*/
大佐_001: {
Make sure you're not spotted
sliding into Intrusion position.
}
/*潜り込むところを敵に見られないように
気をつけろ。
*/
大佐_002: {
A patrol could also start checking
the spot where you're likely to be
hiding in Intrusion View.
}
/*イントルードで隠れていても敵が
覗き込んでくる時もあるだろう。
*/
大佐_003: {
In that case, remain in Intrusion
and keep moving to stay out of
the enemy's sight.
}
/*その時はイントルードで移動しながら
敵の視線をかわさなければならない。
*/
大佐_004: {
The Intrusion View is
no free lunch. Got that?
}
/*イントルードでも油断するんじゃないぞ。
いいな。
*/
//dv}//v
}//d


//泳ぎ、落ちたらＣＡＬＬ h //e
resource PC_水中＿操作説明__e {
//vox t:vc260111 {
大佐_000: {
Got your feet wet? These are
the basic controls for swimming.
}
/*水に入ったようだな。
泳ぎの基本操作はこうだ。
*/
//dv}//v
}//d
//水面にいる h //e
//移動 t //e
resource PC_水中＿水面＿移動__e {
//vox t:vc260121 {
大佐_000: {
When you're on the surface, you can
swim in corresponding directions
using the up, down,
}//<ページ数変更>
#ifdef d:XBOX
大佐_000_1: {
left and right movement of
the left thumbstick.
}
#else
大佐_000_1: {
left and right movement of
the left analog stick.
}
#endif

/*水面を泳いでいる時は左スティックの
上下左右でそれぞれの方向に泳ぐことが
出来る。
*/
//dv}//v
}//d
//潜航 t //e
//没？ＸＸＸＸＸＸＸＸＸＸＸｘｘ
resource PC_水中＿水面＿潜航１__e {
//vox t:vc260131 {
大佐_000: {
Push the Punch or Crawl button
to dive down from the surface.
}
/*水面から水中に潜る時は
○ボタンか×ボタンを押せばいい。
*/
//dv}//v
}//d
resource PC_水中＿水面＿潜航２__e {
//vox t:vc260141 {
大佐_000: {
Push the Punch button to dive
down from the surface.
}
/*水面から水中に潜る時は○ボタンを
押せばいい。
*/
//dv}//v
}//d
//水中 h //e
resource PC_水中＿前進__e {
//vox t:vc260151 {
大佐_000: {
Stroke the water and move forward
by pushing the Punch button.
}//<ページ数変更>
大佐_000_1: {
Push it in rapid succession
to swim faster.
}
/*○ボタンを押すと水をかいて前進する。
連打すれば早く泳ぐことが出来るぞ。
*/
//dv}//v
}//d
resource PC_水中＿左スティック＿正__e {
//vox t:vc260161 {
#ifdef d:XBOX
大佐_000: {
Change your heading by moving
the left thumbstick.
}//<ページ数変更>
#else
大佐_000: {
Change your heading by moving
the left analog stick.
}//<ページ数変更>
#endif
大佐_000_1: {
Up will take you up, down takes
you lower, left and right to face
those directions.
}
/*泳ぐ方向は左スティックで変えられる。
上で上の方、下で下の方、左右で
それぞれの方向を向く。
*/
//dv}//v
}//d
resource PC_水中＿左スティック＿逆__e {
//vox t:vc260171 {
大佐_000: {
Change your heading with
the left analog stick.
}//<ページ数変更>
大佐_000_1: {
Up will take you down, down takes
you up, left and right to face those
directions.
}
/*泳ぐ方向は左スティックで変えられる。
上で下の方、下で上の方、左右で
それぞれの方向を向く。
*/
//dv}//v
}//d
//Ｏ２について h //e
resource PC_水中＿Ｏ２__e {
//vox t:vc260181 {
大佐_000: {
The O2 Gauge will appear under your
Life Gauge while you're underwater.
}//<ページ数変更>
大佐_000_1: {
The gauge corresponds to the
amount of air you can hold
from a single deep breath.
}
/*水中にいる間、ＬＩＦＥゲージの下に
Ｏ２ゲージが表示される。
Ｏ２ゲージが一回の息継ぎに相当する。
*/
大佐_001: {
Once the O2 Gauge falls to zero,
the Life Gauge will start to drop.
You need to be aware of that.
}
/*Ｏ２ゲージがゼロになると続いて、
ＬＩＦＥが減るぞ。注意するんだ。
*/
//dv}//v
}//d
//一回目のみ t //e
resource PC_海底ドッグ水中__e {
//vox t:vc260191 {
大佐_000: {
You never covered underwater
training in your VR missions.
}//<ページ数変更>
大佐_000_1: {
There may, however, arise the need
for you to engage in underwater
activity during this mission.
}
/*ＶＲミッションに水中訓練は無かった
だろう。いずれ水中でミッションを
行う必要が出てくるかも知れん。
*/
大佐_001: {
You may as well get the basics
down right now.
}
/*今のうちに身につけておくのも
いいだろう。
*/
//dv}//v
}//d


//急速回転 h //e
resource PC_水中＿右スティック__e {
//vox t:vc260201 {
#ifdef d:XBOX
大佐_000: {
Move the right thumbstick
to make high-speed turns.
}//<ページ数変更>
#else
大佐_000: {
Use the right analog stick
to make high-speed turns.
}//<ページ数変更>
#endif
大佐_000_1: {
Move it to the left or right to make
90-degree turns in those directions,
and down to make a 180-degree spin.
}
/*右スティックを使えば素早く方向を
変えることが出来る。左右でそれぞれの
方向に９０度、下で真後ろを向く。
*/
//dv}//v
}//d
//急速浮上 h //e
//没？ＸＸＸＸＸＸＸＸＸＸｘ
resource PC_水中＿急速浮上__e {
//vox t:vc260211 {
大佐_000: {
Use the Weapon button to start a
rapid ascent. It comes in useful
when you're running low on air.
}
/*□ボタンを押せば急速に浮上することが
出来る。息が苦しくなった時などに
使うといい。
*/
//dv}//v
}//d
//武器なし h //e
resource PC_水中＿武器ナシ__e {
//vox t:vc260221 {
大佐_000: {
A word of warning: weapons become
useless when you're in water.
}//<ページ数変更>
大佐_000_1: {
Though I doubt you'll be
encountering any enemies
underwater...
}
/*水中で武器は一切使えなくなるから
注意しろ。水中に敵が潜んでいるとは
思えんがな……。
*/
//dv}//v
}//d
//息ガマン h //e
resource PC_水中＿息ガマン__e {
//vox t:vc260231 {
大佐_000: {
When you start to feel the lack
of air, hit the Action button
repeatedly.
}//<ページ数変更>
大佐_000_1: {
This will let you ration your
air supply better and slow
the decline of your O2 Gauge.
}
/*水中で息が苦しくなったら△ボタンを
連打するんだ。そうすれば息を詰めて
Ｏ２ゲージの減り具合を少なく出来る。
*/
//dv}//v
}//d

//スカルスーツの秘密 h //e
resource PC_水中＿スカルスーツ__e {
//vox t:vc260241 {
大佐_000: {
Raiden, that Skull Suit of yours
is designed to minimize drag
when you're underwater.
}//<ページ数変更>
大佐_000_1: {
Try feeling the suit's skin.
}
/*ライデン、君のそのスカルスーツは
水の抵抗を最小減に抑える仕組みに
なっている。スーツの表面を撫でてみろ。
*/
ライデン_001: {
Sort of sandpapery...
}
/*……ザラザラしている。*/
大佐_002: {
What you're feeling is a series
of microscopic grooves.
}//<ページ数変更>
大佐_002_1: {
This water-repelling scale
structure cancels out the
force of the currents.
}
/*目には見えないが、表面に微少の溝が
並んでいるんだ。その溌水加工された
ウロコ状の凹凸が、水流をうち消す。
*/
大佐_003: {
The suit cuts drag by a full 10%.
}//<ページ数変更>
大佐_003_1: {
You'll be swimming like a fish --
the technology is extrapolated
from the structure of sharkskin.
}
/*通常よりも１０％の抵抗削減に
成功している。鮫の肌にヒントを
創られた、いわば鮫肌スーツだ。
*/
大佐_004: {
The concavity of the skin surface
is designed to cut down on air drag
on dry land as well.
}//<ページ数変更>
大佐_004_1: {
Same idea as the surface of golf
balls, but improved upon.
}
/*陸上でも空気抵抗を削減するように
凹凸を利用している。ゴルフボールで
使われている整流効果を改良したものだ。
*/
ライデン_005: {
Sounds good. I think I'm ready
for the Olympics.
}
/*なるほど、オリンピックにも
出場できそうだな。
*/
//dv}//v
}//d


//ハシゴ近く h //e
resource PC_ハシゴ__e {
//vox t:vc260251 {
大佐_000: {
Raiden, do you see the ladder?
Walk up to the ladder and push the
Action button to start climbing.
}
/*ライデン、ハシゴがあるな。ハシゴを
使うには、ハシゴに近寄って△ボタンを
押せばいい。
*/
//dv}//v
}//d


//ロッカー近く h //e
resource PC_ロッカー近く１__e {
//vox t:vc260261 {
大佐_000: {
Raiden, there's a locker over
there. It's a good place to conceal
yourself from enemy patrols.
}
/*ライデン、見ろ。ロッカーがあるぞ。
うまくその中に隠れれば敵を
やりすごすことも出来るだろう。
*/
//dv}//v
}//d
resource PC_ロッカー近く２外__e {
//vox t:vc260271 {
大佐_000: {
Face the locker and press the
Action button to open the door.
}//<ページ数変更>
大佐_000_1: {
Walk into the open locker and
close the door to hide.
}
/*ロッカーに向かって△ボタンを押すと
扉を開ける。扉を開けたロッカーの中に
入れば、扉を閉めて隠れることが出来る。
*/
//dv}//v
}//d
resource PC_ロッカー近く２中__e {
//vox t:vc260281 {
大佐_000: {
Push the Action button again
to get out of the locker.
}
/*ロッカーから出るには、
もう一度△ボタンを押せばいい。
*/
大佐_001: {
You can see what's going on
outside through the slit.
}//<ページ数変更>
大佐_001_1: {
Go into First Person View and make
sure the coast is clear before you
walk out.
}
/*中に入ってもスリットから外が見える。
外へ出る時は、敵がいないかどうか
よく主観で確かめるようにしろ。
*/
//dv}//v
}//d
resource PC_ロッカー近く３__e {
//vox t:vc260291 {
大佐_000: {
You can also knock out and drag
enemy personnel over to an open
locker and hide their bodies inside.
}
/*扉を開けたロッカーまで倒した敵を
引きずっていけば、ロッカーの中に
敵の体を隠すことも出来る。
*/
//dv}//v
}//d
resource PC_ロッカードア盾__e {
//vox t:vc260301 {
大佐_000: {
Open a locker and in an exchange
of gunfire, the door can serve as
a shield.
}
/*ロッカーを開ければ、その扉を
盾にして敵の銃撃を防ぐことも出来る。
*/
大佐_001: {
This can be helpful when there's
no other cover in sight.
}
/*遮蔽物が全く見当たらない時などに
試してみるといい。
*/
//dv}//v
}//d
resource PC_ロッカー扉破壊__e {
//vox t:vc260311 {
大佐_000: {
You can also destroy locker doors.
If you absolutely need to open a
locked one, just break in.
}
/*ロッカーの扉は破壊することも出来る。
どうしても鍵のかかったロッカーを
開けたいのならば、壊してみろ。
*/
//dv}//v
}//d
resource PC_ロッカー開かない__e {
//vox t:vc260321 {
大佐_000: {
Raiden, it looks as though
that locker is secured.
}//<ページ数変更>
大佐_000_1: {
If you need to use a locker,
find an unlocked one.
}
/*ライデン、そのロッカーは鍵が
かかっているようだ。ロッカーを
使いたいなら別のを探せ。
*/
//dv}//v
}//d

//登れる台 h //e
resource PC_段差上り１__e {
//vox t:vc260331 {
大佐_000: {
Raiden, you can climb onto anything
up to about waist-high with the
Action button.
}//<ページ数変更>
大佐_000_1: {
It should come in useful.
}
/*ライデン、腰くらいの高さのものは
△ボタンを押せば上に登ることが
出来る。うまく使うんだ。
*/
//dv}//v
}//d

//エルード h //e
//＊ムービー t //e
resource PC_エルード１の１__e {
//vox t:vc260341 {
大佐_000: {
If you see an approximately
waist-high railing, push the
Action button near it.
}//<ページ数変更>
大佐_000_1: {
You will be able to climb over
the railing and Hang down from
the other side.
}
/*腰くらいの高さの手すりは、近くで
△ボタンを押せば、手すりを乗り越えて
向こう側にぶらさがることが出来る。
*/
//dv}//v
}//d
//＊ムービー t //e
resource PC_エルード１の２__e {
//vox t:vc260351 {
大佐_000: {
This is referred to as Hanging.
Not only does it allow you to stay
out of the enemy's sight,
}//<ページ数変更>
大佐_000_1: {
you will be able to reach locations
that are otherwise inaccessible.
}
/*これがエルードだ。敵の視界を避ける
だけでなく、歩いては行けない場所に
辿り着くことも出来るかもしれない。
*/
//dv}//v
}//d
//＊ムービー t //e
resource PC_エルード２の１__e {
//vox t:vc260361 {
大佐_000: {
You will be able to move left and
right while Hanging. You can use
the capability to move undetected.
}
/*エルード中も手すりにぶらさがりながら
左右に移動出来る。敵の死角に入った
まま移動することも可能だ。
*/
//dv}//v
}//d
//＊ムービー t //e
resource PC_エルード２の２__e {
//vox t:vc260371 {
大佐_000: {
Press the Action button again
to climb up from Hanging.
}
/*エルードから這い上がる時は
もう一度△ボタンを押せばいい。
*/
//dv}//v
}//d
//＊ムービー t //e
resource PC_エルード３の１__e {
//vox t:vc260381 {
大佐_000: {
A Grip Gauge is displayed under
the Life Gauge while Hanging.
}
/*エルード中、ＬＩＦＥゲージの
下に握力ゲージが表示される。
*/
大佐_001: {
The Grip Gauge indicates how firm
a grip you have.
}//<ページ数変更>
大佐_001_1: {
It will decrease over time as long
as you're Hanging.
}
/*握力ゲージは君の握力を表している。
エルードしている間、時間と共に
少しずつ減っていく。
*/
//dv}//v
}//d
//＊ムービー t //e
resource PC_エルード３の２__e {
//vox t:vc260391 {
大佐_000: {
When the Grip Gauge runs out,
you will fall. Climb up before
that happens.
}
/*握力ゲージが無くなると、落下して
しまうぞ。そうなる前に這い上がるんだ。
*/
//dv}//v
}//d
//エルード飛び降り h //e
//＊ムービー t //e
resource PC_エルード＿飛び降り１__e {
//vox t:vc260401 {
大佐_000: {
Push the Crawl button while
Hanging to jump straight down.
}
/*エルード中に×ボタンを押すと、
その場から真下に飛び降りる。
*/
//dv}//v
}//d
//＊ムービー t //e
resource PC_エルード＿飛び降り２__e {
//vox t:vc260411 {
大佐_000: {
But a jump from too high a location
will take a toll on your Life Gauge.
}//<ページ数変更>
大佐_000_1: {
Check the ground below in First
Person View before jumping down.
}
/*だが高過ぎる所から落ちるとＬＩＦＥが
減るぞ。飛び降りる時は主観で真下を
確認してからにするんだ。
*/
//dv}//v
}//d

//プレイヤーの催促 h //e
//長時間いると催促される t //e
resource PC_海底ドック催促__e {
//vox t:vc260421 {
大佐_000: {
Raiden, you should be used to
the controls by now.
}//<ページ数変更>
大佐_000_1: {
Proceed with your mission --
the clock is ticking.
}
/*ライデン、もう操作には充分慣れた
だろう？任務を進めてくれ。時間がない。
*/
大佐_001: {
Get on the elevator on the far side
of this area and get to the upper
section of the Big Shell.
}
/*そのエリアの奥にある昇降機に乗って、
『ビッグ・シェル』上部に上がるんだ。
*/
//dv}//v
}//d


//水密扉。近くでＣＡＬＬ h //e
resource PC_水密扉１__e {
//vox t:vc260431 {
大佐_000: {
Raiden, that door is watertight.
}
/*ライデン、その扉は水密扉だ。*/
//dv}//v
}//d
//タンカー編をプレイしているユーザーの場合 t //e
resource PC_水密扉２__e {
//vox t:vc260441 {
ライデン_000: {
Yeah, I know how to open it.
We covered it in VR training.
}
/*ああ。開け方はわかっている。
ＶＲ訓練で経験済みだ。
*/
大佐_001: {
True. Proceed with caution.
}
/*そうだったな。
慎重に行けよ。*/
//dv}//v
}//d
//タンカー編をプレイしていないユーザーの場合 t //e
resource PC_水密扉３__e {
//vox t:vc260451 {
大佐_000: {
Turn the handle to open the door.
}
/*その扉を開けるには、
ハンドルを回さなければならない。*/
大佐_001: {
Face the door and press down on
the Action button and the handle
will turn.
}
/*ハンドルを回すには扉に向かって
△ボタンを押したままにすればいい。
*/
大佐_002: {
Punch the Action button repeatedly
if you need to turn it faster.
}
/*早く回したければ△ボタンを連打する
ことだ。
*/
//dv}//v
}//d

//昇降機ホール h //e
//放置武器使用不可の説明 h //e
//敵兵を倒した際、敵兵の近くにいるとＣＡＬＬ。 t//e
resource PC_敵武器使用不可１__e {
//vox t:vc260461 {
大佐_000: {
Raiden, you won't be able to use
any of the enemy's equipment.
}
/*ライデン、敵の装備品は使用できないぞ。
*/
ライデン_001: {
Why not?
}
/*なぜだ？*/
大佐_002: {
You should know that all active
weapons are equipped with a
personal identification system.
}
/*わかっているだろうが、装備済みの
銃火器には全て個人認識装置が
埋め込まれている。
*/
大佐_003: {
The owner enters the required user
ID information during the weapon
registration＃−
}//<ページ数変更>
大佐_003_1: {
or at the start of a mission.
}
/*銃火器登録時、あるいは作戦開始時に
認識データを入力する仕組みになって
いるのだ。
*/
大佐_004: {
If anyone other than the registered
user tries to fire the weapon,
}//<ページ数変更>
大佐_004_1: {
the ID system will not authorize
the action.
}
/*その登録者以外がトリガーを引いても、
反応しないシステムが導入されている。
*/
ライデン_005: {
But these are black-market Russian
weapons. How can they be equipped
with identification functionality?
}
/*ロシアなどから密輸される闇銃火器には
これらの登録システムは採用されて
いないはずだが？
*/
大佐_006: {
They must have been customized by
the terrorists themselves.
}//<ページ数変更>
大佐_006_1: {
These are professionals
we're dealing with,
}//<ページ数変更>
大佐_006_2: {
and they certainly won't let their
own equipment be used against them.
}
/*自前で組み込んだのだろう。
彼らはプロだ。自分たちの装備が
我々の手に落ちないようにしている。
*/
ライデン_007: {
I'm guessing it's the same for
the Navy SEALs' gear.
}
/*ＳＥＡＬＳの装備も同じか？
*/
大佐_008: {
Right.
}
/*そうだ。*/
ライデン_009: {
How am I supposed to procure
weapons then?
}
/*では武器はどうやって
調達すればいいんだ？
*/
大佐_010: {
Find the ones that haven't
yet been individualized.
}
/*まだＩＤ登録されていないものを
探すんだ。
*/
大佐_011: {
Everything you find in the Item Box
is clean. You should know this from
your VR training.
}
/*登録前のものはアイテムボックスに
入っている。既にＶＲ訓練で学習済み
だろう。
*/
//dv}//v
}//d
//無線機画面のスクリーン内にアイテムＢＯＸの映像。 t //e
resource PC_敵武器使用不可２__e {
//vox t:vc260471 {
ライデン_000: {
OK, I know those.
}
/*ああ、あれならわかる。*/
//dv}//v
}//d
resource PC_敵武器使用不可３__e {
//vox t:vc260481 {
大佐_000: {
Items in the Item Box are
yours to use at will.
}
/*アイテムボックスの中に入っている
アイテムは自由に使用できる。
*/
大佐_001: {
They will be your supply source
with regards to weaponry and gear.
}
/*武器と装備品はアイテムボックスから
調達するんだ。
*/
//dv}//v
}//d

//倒れた敵兵について h //e
//・死体引きずり方法 h //e
resource PC_死体隠せ__e {
//vox t:vc260491 {
大佐_000: {
The risk of leaving an enemy's
body lying around is too great.
}//<ページ数変更>
大佐_000_1: {
If his comrades discover it,
they'll be on the lookout for you.
}
/*倒した敵をそのままにしておくのは
危険だ。仲間が倒されたのを知れば
敵は当然警戒を強化してくるだろう。
*/
大佐_001: {
Whenever you take an enemy out,
conceal the body to the best of
your abilities.
}
/*敵を倒したら、すぐにその体を
人目につかない場所に隠すんだ。
*/
//dv}//v
}//d
resource PC_死体引きずり方法１__e {
//vox t:vc260501 {
大佐_000: {
You can drag an enemy personnel's
body.
}
/*倒れた敵の体は引きずって移動させる
ことが出来る。
*/
//dv}//v
}//d
//＊ムービー t //e
resource PC_死体引きずり方法２__e {
//vox t:vc260511 {
大佐_000: {
This is how to do it:
}//<ページ数変更>
大佐_000_1: {
first, walk up to the body, and
with all weapons deselected, press
the Weapon button to pick it up.
}
/*やり方は、こうだ。まず倒れた敵の近く
で、武器を装備せずに□ボタンを押して、
敵の体を抱える。
*/
大佐_001: {
As long as you have the Weapon
button held down, you can move
around with the body in your grasp.
}//<ページ数変更>
大佐_001_1: {
Release the Weapon button
to let go of the body.
}
/*
□ボタンを押している間、敵を引きずり
ながら移動することが出来る。
体を下ろすには□ボタンを離せばいい。
*/
//dv}//v
}//d


//・死体硬直 h //e
resource PC_死体硬直１__e {
//vox t:vc260521 {
大佐_000: {
Raiden, if you do plan to hide
someone's body, you'll need to
be quick about it.
}
/*ライデン、倒した敵の体を
隠すつもりなら、すぐに移動させる
必要があるぞ。
*/
//dv}//v
}//d
resource PC_死体硬直２__e {
//vox t:vc260531 {
大佐_000: {
For enemies you've knocked out,
you need to move before they regain
consciousness.
}//<ページ数変更>
大佐_000_1: {
The ones you've had to terminate
will start to undergo rigor mortis
fairly quickly as well.
}//<ページ数変更>
大佐_000_2: {
They'll be too stiff to move.
}
/*意識を失った敵はしばらくすれば目を
覚ます。そうでない敵も時間が経つと
硬直して動かせなくなる。注意しろ。
*/
//dv}//v
}//d




//ＶＲ１面のマップ（伏線） h //e
//入り口付近。前作をプレイしている人のみ。 t //e
resource PC_海底ドックＶＲ１__e {
//vox t:vc260541 {
ライデン_000: {
Colonel, I remember this place...
}
/*大佐、ここに来た記憶がある……。*/
大佐_001: {
Of course you do. This is Level One
from the VR missions.
}
/*そうだろう、ＶＲミッションの１面だ。
*/
//dv}//v
}//d
//小画面にＶＲ画面が出る。t //e
resource PC_海底ドックＶＲ２__e {
//vox t:vc260551 {
ライデン_000: {
You're right -- I see it now.
}
/*なるほど、そういえばそうだ。*/
大佐_001: {
You may not have field experience,
but you've been trained in the
hyperreality of simulated combat.
}
/*君には実戦経験こそないが、
それ以上にリアルなシミュレーション
での疑似体験がある。*/
大佐_002: {
Don't give into fear. Just do as
you were trained, and everything
will be all right.
}
/*恐れるな。
訓練通りに進めれば問題はない。*/
//dv}//v
}//d

//危険モードになったら逃げろＣＡＬＬ h //e
resource PC_海底ドック危険モード回避のススメ１__e {
//vox t:vc260561 {
大佐_000: {
Raiden, you have no weapons and not
a chance in hell against them in a
confrontation.
}//<ページ数変更>
大佐_000_1: {
Get out of there and head south!
Retreat down the corridor!
}
/*ライデン、君は武器をもっていない。
まともにやり合っても勝ち目はないぞ！
南に逃げろ！通路を戻るんだ！
*/
//dv}//v
}//d
//一回目のみ t //e
resource PC_海底ドック危険モード回避のススメ２__e {
//vox t:vc260571 {
ローズ_000: {
Jack, get out of there!
Please!!
}
/*ジャック！逃げて！お願い！！
*/
大佐_001: {
There's some cover back in the
south area. Get yourself over
there right now.
}
/*南のエリアに戻れば隠れる場所がある。
そっちに逃げ込むんだ。
*/
//dv}//v
}//d


//クリアリングの説明（ＣＡＬＬ）h //e
resource PC_海底ドッククリアリング中ＣＡＬＬ__e {
//vox t:vc260581 {
大佐_000: {
Raiden, stay still. The enemy
is engaged in Clearing.
}
/*ライデン、じっとしているんだ！
奴等はクリアリングをしている。
*/
ローズ_001: {
What's Clearing?
}
/*クリアリングって？*/
大佐_002: {
A systematic sweep of high-risk
zones where intruder presence is
either suspected or confirmed.
}
/*クリアリングとは敵が存在する、または
その存在が予想される部屋、家屋などの
危険エリアを掃討することだ。
*/
大佐_003: {
It makes use of a variety of CQB
techniques, but can be divided
roughly into two types.
}
/*種々のＣＱＢテクニックを駆使してな。
クリアリングには大きくわけて二種類の
突入方法がある。
*/
大佐_004: {
One is the so-called "dynamic
entry" method,
}//<ページ数変更>
大佐_004_1: {
which relies on speed and the
element of surprise to storm the
area and take control of the enemy.
}
/*一つがスピードと奇襲にものを言わせて
突入し一気に敵を制圧するダイナミック
エントリー。
*/
大佐_005: {
The other is "stealth entry," which
involves infiltrating the area,
}//<ページ数変更>
大佐_005_1: {
covertly acquiring the targets
and seizing control.
}
/*そしてもう一つがその反対に隠密裏に
エリアに進入、接敵し、主導権を奪う
ステルスエントリーだ。
*/
ローズ_006: {
In either case, he'll be discovered
unless he stays out of sight. Am I
correct?
}
/*つまり、じっと隠れていないと
見つかるってこと？*/
大佐_007: {
Absolutely. They're
trained professionals.
}//<ページ数変更>
大佐_007_1: {
Keep that in mind when you look
for a good hiding place, Raiden.
}
/*そういうことだな。
彼らは訓練されたプロだ。
適切な隠れ場所を見つけるんだ。
*/
//dv}//v
}//d


//ＬＩＦＥゼロ寸前（ＣＡＬＬ／ＥＡＳＹのみ） h //e
resource PC_ＬＩＦＥゼロ寸前ＣＡＬＬ１__e  {
//vox t:vc260591 {
大佐_000: {
Raiden, your Life Gauge is
about to run out!
}
/*ライデン、ＬＩＦＥがゼロになるぞ！
*/
//dv}//v
}//d
//レーション持ってない場合 t //e
resource PC_ＬＩＦＥゼロ寸前ＣＡＬＬ＿レーション探せ__e  {
//vox t:vc260601 {
大佐_000: {
Locate some ration. You'll be able
to recover some LIFE with it,
}//<ページ数変更>
大佐_000_1: {
and there should be some in the
eastern section of the South area.
}
/*レーションを探すんだ。レーションを
使えばＬＩＦＥを回復出来る。
南のエリアの東にあったはずだ。
*/
//dv}//v
}//d

//レーション持っている場合 t //e
resource PC_ＬＩＦＥゼロ寸前ＣＡＬＬ＿レーション使え__e  {
//vox t:vc260611 {
大佐_000: {
Use your ration!
}
/*レーションを使うんだ！*/
//dv}//v
}//d

//レーションの説明 h //e
//レーション入手時にＣＡＬＬ t //e
resource PC_レーションＣＡＬＬ１__e {
//vox t:vc260621 {
大佐_000: {
You've acquired some ration.
}//<ページ数変更>
大佐_000_1: {
Good -- this is a portable field
food source that can be consumed
to recover LIFE.
}
/*レーションを手に入れたな。
ＬＩＦＥを回復出来る軍用携帯糧食だ。
*/
//dv}//v
}//d

//操作説明 t //e
resource PC_レーション操作説明__e {
//vox t:vc260631 {
大佐_000: {
Select the ration in your window
and push the Enter button.
}//<ページ数変更>
大佐_000_1: {
You can use it on the spot
and regain some LIFE.
}
/*レーションをウィンドウで選択して
○ボタンを押せば、その場で使用して
ＬＩＦＥを一定量回復する。
*/
大佐_001: {
If you have it selected, you can
automatically consume the ration＃−
}//<ページ数変更>
大佐_001_1: {
the moment your LIFE
runs out and avoid death.
}
/*装備していればＬＩＦＥがなくなった
瞬間、自動的に使用してＬＩＦＥを
回復することが出来る。
*/
大佐_002: {
Rations not only provide
nutrition,
}//<ページ数変更>
大佐_002_1: {
they also stimulate the immune
system and lessen psychological
stress.
}
/*栄養補給だけではなく免疫システムを
活性化させ、ストレスを緩和させる
効果も合わせ持っている。
*/
ライデン_003: {
Not exactly gourmet, though,
is it...
}
/*結構、味気無さそうに見えるんだが。
*/
大佐_004: {
Stop complaining, Raiden...
}
/*文句を言うな、ライデン……。
戦場なんだぞ……。*/
//dv}//v
}//d
//ローズがいる場合 t //e
resource PC_レーション操作説明＿ローズ__e {
//vox t:vc260641 {
ローズ_000: {
Hang in there, Jack. When the
mission is over, I'll make you
my specialty.
}
/*がまんして、ジャック。
任務が終わったら、私の得意料理を
ごちそうするから。
*/
ライデン_001: {
Yeah, right.
}
/*え！？*/
ローズ_002: {
Hm?
}
/*ん？*/
ライデン_003: {
Oh, nothing. I can't wait!
}
/*あ、いや、何でもない。
楽しみだよ。ははは……。*/
//dv}//v
}//d

//ノード前 h //e
//接続前 t //e
resource PC_ノード前接続前１__e {
//vox t:vc260651 {
大佐_000: {
Raiden, the computer terminal you
see over there is what's called a
node.
}
/*ライデン、そこにあるコンピュータ
端末がノードだ。
*/
ライデン_001: {
This...?
}
/*これが……。*/
大佐_002: {
Right. Log into it right now.
Stand in front of the node and
push the Action button.
}
/*そうだ。早くノードにアクセスしろ。
やり方は、ノードの前に立って
△ボタンを押すだけだ。
*/
//dv}//v
}//d
resource PC_ノード前接続前２__e {
//vox t:vc260661 {
大佐_000: {
You won't be permitted to log into
a node during the Alert Mode.
}//<ページ数変更>
大佐_000_1: {
Make sure you're not under pursuit
when you need to log in.
}
/*危険モードの状態ではノードにアクセス
することは出来ない。アクセスする前に
必ず敵を振り切るんだ。
*/
//dv}//v
}//d
resource PC_ノード前接続前３__e {
//vox t:vc260662 {
大佐_000: {
You can only access the node
in Normal Mode.
}
