#define	E_TALES			1	//	スネークテイルズＥ明示

#define	GAMEOVER_ADD	1	//	追加ゲームオーバー処理を可能にする。a_gameover.h内で呼ばれる
#define	CONTINUE_ADD	1	//	追加コンティニュー処理を可能にする。a_gameover.h内で呼ばれる



//	スネークテイルズＥで使用している変数をいったんローカルへ退避
	@スネークテイルズＥ用変数退避

//	ＶＲに必要な変数を代入
#include	"a_vardef.h"
	$b:ミッション番号 = d:MISSION:武装解除;
	$b:モード番号 = 0;						//	オルタナティブミッションはモード番号関係なし
	$s:選択プレイヤー = ライデン;			//	雷電テイルズなのでライデン

//------------------------------------------------------------
//ゲームオーバー／コンティニューに関する設定
//------------------------------------------------------------
//	a_gameover.h内で呼ばれる
proc 追加ゲームオーバー処理 {
	@テイルズＥ用ゲームオーバー処理		//	a_stdproc.hで定義
}

//	a_gameover.h内で呼ばれる
proc 追加コンティニュー処理 {
	@テイルズＥ用コンティニュー処理		//	a_stdproc.hで定義
}

#include	"a12a.gcl"


