proc rp_ＳＡＶＥデフォルトセット:02 {
	selectmenu  2 -m  { 
		[ＳＡＶＥ联买昏__f:セ〖ブする] 
		[ＳＡＶＥ联买昏__f:セ〖ブしない] 
	}
	eval($w:rfp_ＳＡＶＥ联买昏手り猛 = $status)
	print 'ぐあだららじょぶ$w:rfp_ＳＡＶＥ联买昏手り猛:' $w:rfp_ＳＡＶＥ联买昏手り猛
}

proc rt_ＳＡＶＥデフォルトセット:02 {
print 'ほげほほほ'
	#ifdef d:EU_TRIAL
	selectmenu  1 -m  { 
		[ＳＡＶＥ联买昏__f:セ〖ブしない] 
	}
	eval($w:rft_ＳＡＶＥ联买昏手り猛 = 1)
	#else
	selectmenu  2 -m  { 
		[ＳＡＶＥ联买昏__f:セ〖ブする] 
		[ＳＡＶＥ联买昏__f:セ〖ブしない] 
	}
	#endif
	eval($w:rft_ＳＡＶＥ联买昏手り猛 = $status)
print 'ぷにょあよあああ'
}

proc rp_ＳＡＶＥさせないセット:02 {
	selectmenu  2 -m  { 
		[ＳＡＶＥ联买昏__f:セ〖ブさせない] 
		[ＳＡＶＥ联买昏__f:セ〖ブしない] 
	}
	eval($w:rfp_ＳＡＶＥ联买昏手り猛 = $status)
	print 'ぐあだららじょぶ$w:rfp_ＳＡＶＥ联买昏手り猛:' $w:rfp_ＳＡＶＥ联买昏手り猛
}

