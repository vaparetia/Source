//###################################################################################
//								人質コマンダー設定
//###################################################################################


enum ゲームオーバー種類 {
	人質死亡した = 0,
	発見された,
	敵兵死亡した,
	無線破壊した,
	ホールドアップした,
	敵兵気絶した,
	チャフ使用した,
	警戒モードになった,
}





	proc 人質コマンダー設定 {
		#if d:DEBUG_PRINT
			print 'hos_commander'
			print '人質コマンダー設定'
		#endif


		eval($f:w24c_ゲームオーバー処理中 = 0)
		eval($b:ゲームオーバー種類 = d:ゲームオーバー種類:敵兵死亡した)


		if($s:登場ポイント == 盗聴イベント || $s:登場ポイント == オセロット接近イベント || $s:登場ポイント == ゲームオーバーデモ){

			chara 人質コマンダー 人質コマンダー

		}else{

			chara 人質コマンダー 人質コマンダー \
				-e	人質死亡時トラップ \
					発見されたときプロック \
					人質呼びかけ反応プロック \
					敵兵死亡時プロック１ \
					敵兵死亡時プロック１ \	//敵兵の無線が破壊された時に呼ばれる
					敵兵死亡時プロック１ \	//敵兵がホールドアップしたとき呼ばれる
					敵兵死亡時プロック１ \	//敵兵が気絶すると呼ばれる
					チャフ使用時プロック \	//チャフ使用した
					警戒時プロック \	//警戒モードになった
					rp_w24c_人質殴った \	//人質を殴った
				-v	t:vc121020 \//人質男性Ａ「（悲鳴、パニックになっている）」
					t:vc121021 \//人質男性Ｂ「（悲鳴、パニックになっている）」
					t:vc121024 \//人質男性Ａ「私はエイムズではない！」
					t:vc121025 \//人質男性Ｂ「私はエイムズではない！」
					t:vc121028 \//人質男性Ａ「違う！」
					t:vc121029 \//人質男性Ｂ「違う！」
					t:vc121032 \//人質男性Ａ「違うと言っただろう！」
					t:vc121033 \//人質男性Ｂ「違うと言っただろう！」
					t:vc121036 \//人質女性Ａ「（悲鳴、パニックになっている）」
					t:vc121037 \//人質女性Ｂ「（悲鳴、パニックになっている）」
					t:vc121038 \//人質女性Ａ「違う！」
					t:vc121039 \//人質女性Ｂ「違う！」
					t:vc121040 \//人質女性Ａ「近寄らないで！」
					t:vc121041 \//人質女性Ｂ「近寄らないで！」
					t:vc121042 \//人質女性Ａ「私じゃゃなくて他の人にして！」
					t:vc121043 \//人質女性Ｂ「私じゃなくて他の人にして！」
					t:vc121044 \//人質女性Ａ「やめて！触らないで！！」
					t:vc121045 \//人質女性Ｂ「やめて！触らないで！！」
					t:vc121046 \//人質女性Ｂ「私はジェニファーよ」
					t:vc121047 \//人質女性Ｂ「私はリンダ」
					t:vc121048 \//人質女性Ｂ「私はシンディーよ」
					t:vc121074 \//機械音「メールを送信しました」
				-m	1		//コマンダーがいないときの人質イベントの記述




			chara ルートデモ人形 指揮官兵 \
				-route 0 0 \
				-kms gbs_def \ /*EVMを表示する場合はダミーKMSが必要*/
				-mar gbs_w24c_call \
				-weapon 3 \
				-a ＡＫＳ \
				-number 0

			chara delay ディレイ -time 1 -exec{
				mesg 敵兵装備品 ＡＫＳ 銃をもつ
			}

			chara 装備品Ｃ 無線機 \
				-n rad \
				-y 指揮官兵 \
				-z 10 \			//$i:つける場所のOBJ番号 \
				-x -50,-78,-67 \		//$v:ローカル座標上でのつける位置 \
				-r 993,193,-1038 \
				-f 1			//$i:遅れフレーム数




		}

	}






	proc ゲームオーバー背景設定 {
		if($b:w24c_人質種類 == d:全員ジェニファー && $s:登場ポイント != 盗聴イベント && $s:登場ポイント != オセロット接近イベント){
			command ゲームオーバー背景設定 \
				-t w24c_game_over_sp \
				-s w24c_over_mrs_alp_ovl \
				-m 2
		}else if($b:w24c_人質種類 == d:全員キャシー && $s:登場ポイント != 盗聴イベント && $s:登場ポイント != オセロット接近イベント){
			command ゲームオーバー背景設定 \
				-t w24c_game_over_sp \
				-s w24c_over_oba_alp_ovl \
				-m 2

		}else if($b:w24c_人質種類 == d:全員カトチャン && $s:登場ポイント != 盗聴イベント && $s:登場ポイント != オセロット接近イベント){
			command ゲームオーバー背景設定 \
				-t w24c_game_over_sp \
				-s w24c_overguy_alp_ovl \
				-m 2

		}else{
			command ゲームオーバー背景設定 \
				-t w24c_game_over \
				-s 24c_over_alp_ovl \
				-m 2
		}
	}









//###################################################################################
//									人質殺した
//###################################################################################

	proc 人質死亡時トラップ {
		//$1：人質の名前
		print '人質やっちまったぜbaby!!!!!!'

		if(`%ゲームオーバーチェック` == 0 && $f:ロードチェックＯＮフラグ && $s:登場ポイント != ゲームオーバーデモ){
			@ゲームオーバー背景設定
			command ゲームオーバー処理開始 -exec {

				chara デモキャンセルチェック デモキャンセル \
					-p ゲームオーバーキャンセル処理

				@シナリオデモ開始処理

				command コントロール座標取得 \
					$1 $i:人質Ｘ座標 $i:人質Ｙ座標 $i:人質Ｚ座標



				eval($b:順位 = 0)

				command	配列セット $w:最短ルートナンバー[0] {
					2000,2000,2000,2000,2000, \
					2000,2000,2000,2000,2000, \
					2000,2000,2000
				}

				chara delay ポイント検索ディレイ -time 1 -exec{

					eval($i:現在の最短距離 = 200000)

					//$1：ポイント番号
					//$2：Ｘ座標
					//$3：Ｙ座標
					//$4：Ｚ座標
					command foreach -argc 4 -repeat 130 \
						-data { \
							#include "w24c_routes.h"
						} \
						-exec { \

							//一番近いポイントの番号を書き込む。高さによるボーナスアリ
							eval($i:調査対象ポイントの距離 = `%VecLen $i:人質Ｘ座標 $i:人質Ｙ座標 $i:人質Ｚ座標 $2 $3 $4`)

							if($i:調査対象ポイントの距離 <= $i:現在の最短距離){
								if($1 != $w:最短ルートナンバー[0]){

									//注意！！！$w:法線Ｘ変位　は、Ｚ軸が逆のため、-1をかけてあります！！
									if($i:調査対象ポイントの距離 > 0){
										eval($w:Ｘ変位 = ($i:人質Ｘ座標 - $2) * 1000 / $i:調査対象ポイントの距離)
										eval($w:Ｚ変位 = ($3 - $i:人質Ｚ座標) * 1000 / $i:調査対象ポイントの距離)
										eval($w:角度 = `%atan $w:Ｘ変位 $w:Ｚ変位` )
									}else{
										eval($w:角度 = 0 )
									}

									eval($w:最短ルートナンバー[$b:順位] = $1 * 10)
									eval($i:現在の最短距離 = $i:調査対象ポイントの距離)

									if($b:順位 == 0){
										//角度でルートを変更
										if($w:角度 >= (512-256) && $w:角度 < (512+256)){
											eval($w:最短ルートナンバー[$b:順位] = $w:最短ルートナンバー[$b:順位] + 1)
										}else if($w:角度 >= (1024-256) && $w:角度 < (1024+256)){
											eval($w:最短ルートナンバー[$b:順位] = $w:最短ルートナンバー[$b:順位] + 2)
										}else if($w:角度 >= (1536-256) && $w:角度 < (1536+256)){
											eval($w:最短ルートナンバー[$b:順位] = $w:最短ルートナンバー[$b:順位] + 3)
										}else if($w:角度 >= (2048-256) && $w:角度 < (2048+256)){
											eval($w:最短ルートナンバー[$b:順位] = $w:最短ルートナンバー[$b:順位] + 4)
										}else if($w:角度 >= (2560-256) && $w:角度 < (2560+256)){
											eval($w:最短ルートナンバー[$b:順位] = $w:最短ルートナンバー[$b:順位] + 5)
										}else if($w:角度 >= (3072-256) && $w:角度 < (3072+256)){
											eval($w:最短ルートナンバー[$b:順位] = $w:最短ルートナンバー[$b:順位] + 6)
										}else if($w:角度 >= (3584-256) && $w:角度 < (3584+256)){
											eval($w:最短ルートナンバー[$b:順位] = $w:最短ルートナンバー[$b:順位] + 7)
										}
									}

								}

							}

							if($1 == 129){
								print '$w:最短ルートナンバー'$b:順位'は'$w:最短ルートナンバー[$b:順位]
							}

						}

					if($b:順位 == 1){
						@人質殺害通信兵呼び出し
						return 0
					}else{
						eval($b:順位 = $b:順位 + 1)
						return 1
					}


				}

			}


		}

	}


	proc 人質殺害通信兵呼び出し {

		print '通信兵登場！！！！'

		mesg 敵兵共通 敵兵 永久アンリアルＯＮ

		if((`%プレイヤー状態取得`& d:PFLAG_INTRUDE) == 0){
			mesg ルートデモ人形 指揮官兵 ルートノードワープ \
				($w:最短ルートナンバー[0]/10 + 1000) \
				($w:最短ルートナンバー[0]%10)
		}

		if($i:人質Ｚ座標 < -63000){
			eval($i:補完ＰＸ = -755)
			eval($i:補完ＰＹ = -1000)
			eval($i:補完ＰＺ = -63637)
		}else if($i:人質Ｘ座標 >= && $i:人質Ｚ座標 >= -54500){
			eval($i:補完ＰＸ = 1000)
			eval($i:補完ＰＹ = -1000)
			eval($i:補完ＰＺ = -51500)
		}else if($i:人質Ｘ座標 >= && $i:人質Ｚ座標 < -54500){
			eval($i:補完ＰＸ = 1000)
			eval($i:補完ＰＹ = -1000)
			eval($i:補完ＰＺ = -57500)
		}else if($i:人質Ｘ座標 < && $i:人質Ｚ座標 >= -54500){
			eval($i:補完ＰＸ = -2500)
			eval($i:補完ＰＹ = -1000)
			eval($i:補完ＰＺ = -51500)
		}else{
			eval($i:補完ＰＸ = -2500)
			eval($i:補完ＰＹ = -1000)
			eval($i:補完ＰＺ = -57500)
		}

		chara カメラ設定 モーションカメラ \
			-c 1 \
			-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ \
			-t $i:人質Ｘ座標 $i:人質Ｙ座標 $i:人質Ｚ座標 \
			-a 1000 \
			-i 0 0 0 0 \
			-s 1

		chara カメラ設定 モーションカメラ \
			-c 1 \
			-p $i:補完ＰＸ,$i:補完ＰＹ,($i:補完ＰＺ - 500) \
			-t $i:人質Ｘ座標 $i:人質Ｙ座標 $i:人質Ｚ座標 \
			-a 300 \
			-i 3 -1 0 0 \
			-z d:CAMERA_INTERP_CAMERA \ //補完カメラフラグを指定。
			-interp_time 180 \ //補完時間を指定
			-s 1

		if(!$f:w24c_ゲームオーバー終了処理呼ばれてます){
			command StreamStopAll

			chara delay ディレイ -time 1 -exec{
				if(`%StreamIsPlay` < 2){
					if(`%VecLen $i:人質Ｘ座標 $i:人質Ｙ座標 $i:人質Ｚ座標 $i:プレイヤー位置Ｘ $i:プレイヤー位置Ｙ $i:プレイヤー位置Ｚ` > 4000){
						%Stream t:vc043015 -p 最寄ポイント検索処理
						print '兵士Ｃ「敵襲を受けている！現在敵位置は不明。探し出せ！」'
					}else{
						%Stream t:vc041006 -p 最寄ポイント検索処理
						print '兵士Ａ「敵だ！至急増援を送れ！」（人質殺害で使用）'
					}
					return 0
				}else{
					return 1
				}
			}
		}


	}











//###################################################################################
//									敵に発見された
//###################################################################################


	proc 発見されたときプロック {
		print '発見されちまったぜbaby!!!!!!'

		//$1：敵兵の名前	０のときは特定不能

/*
		chara デモキャンセルチェック デモキャンセル \
			-p ゲームオーバーキャンセル処理
*/

		if(`%ゲームオーバーチェック` == 0 && $f:ロードチェックＯＮフラグ && $s:登場ポイント != ゲームオーバーデモ){
			@ゲームオーバー背景設定
			command ゲームオーバー処理開始 -exec {
				command メニュー設定 -menu off -gage off  -radar off -subwin off

				if($1 == 0){
					print '発見した人はいませんでした！！！！'

					if(!$f:w24c_ゲームオーバーキャンセルした){
						@最寄ポイント検索処理
					}

				}else{

					chara delay 敵兵発見ディレイ -time 60 -p ラジオドラマゲームオーバー

					@シナリオデモ開始処理

					command ゲット敵兵座標 \
						$1 $i:敵兵Ｘ座標 $i:敵兵Ｙ座標 $i:敵兵Ｚ座標

					eval($i:w24c_敵兵発見法線大きさ = `%VecLen $i:プレイヤー位置Ｘ $i:プレイヤー位置Ｙ $i:プレイヤー位置Ｚ $i:敵兵Ｘ座標 $i:敵兵Ｙ座標 $i:敵兵Ｚ座標` / 1000)

					if($i:w24c_敵兵発見法線大きさ == 0){
						eval($w:角度 = 0 )

					}else{
						//ベクトル(x,z)の法線は(-z,x)
						//注意！！！$w:法線Ｘ変位　は、Ｚ軸が逆のため、-1をかけてあります！！
						eval($w:Ｘ変位 = ($i:プレイヤー位置Ｘ - $i:敵兵Ｘ座標) / $i:w24c_敵兵発見法線大きさ)
						eval($w:Ｚ変位 = (-$i:プレイヤー位置Ｚ + $i:敵兵Ｚ座標) / $i:w24c_敵兵発見法線大きさ)

						eval($w:角度 = `%atan $w:Ｘ変位 $w:Ｚ変位` )
					}

					eval($i:カメラポジションＸ = $i:敵兵Ｘ座標 - (`%cos $w:角度` * 500 / 4096) )
					eval($i:カメラポジションＺ = $i:敵兵Ｚ座標 - (`%sin $w:角度` * 500 / 4096) )

					if(`%VecLen $i:プレイヤー位置Ｘ $i:プレイヤー位置Ｙ $i:プレイヤー位置Ｚ $i:敵兵Ｘ座標 $i:敵兵Ｙ座標 $i:敵兵Ｚ座標` > 3000 && `@人質部屋発見カメラ壁判定` == 1){


						chara カメラ設定 モーションカメラ \
							-c 1 \
							-p $i:カメラポジションＸ,($i:敵兵Ｙ座標 + 200),$i:カメラポジションＺ \
							-t $i:プレイヤー位置Ｘ,$i:プレイヤー位置Ｙ,$i:プレイヤー位置Ｚ \
							-a 170 \
							-i 0 -1 0 0 \
							-s 1


			//ぼかし変化
						mesg 近景ぼかし near_deforcus off
						mesg 遠景ぼかし far_deforcus off
						mesg 遠景ぼかし 敵兵発見遠景ぼかし on

						chara delay 敵兵発見ディレイ -time 30 -exec {

							chara カメラ設定 モーションカメラ \
								-c 1 \
								-p $i:カメラポジションＸ,($i:敵兵Ｙ座標 + 1000),$i:カメラポジションＺ \
								-t $i:プレイヤー位置Ｘ,$i:プレイヤー位置Ｙ,$i:プレイヤー位置Ｚ \
								-a 400 \
								-i 3 0 30 0 \
								-z d:CAMERA_INTERP_CAMERA \ //補完カメラフラグを指定。
								-interp_time 30 \ //補完時間を指定
								-s 1

							mesg 遠景ぼかし 敵兵発見遠景ぼかし set (19 * 50) 0 40000 80000

							chara delay 敵兵発見ディレイ \
								-time 20 \
								-exec {
									mesg 遠景ぼかし 敵兵発見遠景ぼかし off
								}

							mesg 近景ぼかし 敵兵発見近景ぼかし on

							chara delay 敵兵発見ディレイ \
								-time 1 \
								-exec {
									mesg 近景ぼかし 敵兵発見近景ぼかし set (149 * 50) 0 1000 5000
								}

							chara delay 敵兵発見ディレイ -time 150 -exec {
								chara カメラ設定 モーションカメラ \
									-s -1

								mesg 近景ぼかし 敵兵発見近景ぼかし off
								mesg 遠景ぼかし far_deforcus on

								if(!$f:w24c_ゲームオーバーキャンセルした){
									//@最寄ポイント検索処理
								}

							}

						}

					}

				}

			}

		}





	}



	proc 人質部屋発見カメラ壁判定 {

		//ステージ外
		if($i:カメラポジションＺ < -63000 || $i:カメラポジションＺ > -46000 || $i:カメラポジションＸ < -11000 || $i:カメラポジションＺ > 7000){
			return 0

		//左下机の上箱の判定
		}else if($i:カメラポジションＸ > -3500 && $i:カメラポジションＸ < -1500 && $i:カメラポジションＺ < -49500 && $i:カメラポジションＺ > -51500){
			return 0

		//右側ついたて
		}else if($i:カメラポジションＸ > 4500 && $i:カメラポジションＸ < 4750 && $i:カメラポジションＺ < -49500 && $i:カメラポジションＺ > -59500){
			return 0

		//演説台
		}else if($i:カメラポジションＸ > -10000 && $i:カメラポジションＸ < -9000 && $i:カメラポジションＺ < -42750 && $i:カメラポジションＺ > -56250){
			return 0


		}else{
			return 1
		}

	}




	proc ラジオドラマゲームオーバー {
		if(!$f:w24c_ゲームオーバー終了処理呼ばれてます){
			print 'ラジオゲームオーバー！！！'

			command セットサウンドコード -c d:SNG_FOUTS_S

			chara フェードインアウト フェードアウト \
				-i 0 0 0 0 \		//設定するとこのＲＧＢαから始まる
				-c 0 0 0 128 \		//目標のＲＧＢα
				-s 143 \			//プライオリティ
				-t 30

			command メニュー設定 -menu off -gage off  -radar off -subwin off
			command 字幕制御 -hide
			command セットタイマーステータス -s d:TMR_WAIT
			mesg タイマー タイマー 表示切り替え 0


			command StreamStopAll
			chara delay ディレイ -time 1 -exec{
				if(`%StreamIsPlay` == 0){
					%Stream t:vc120001 -p ゲームオーバーキャンセル処理 -action ラジオドラマ振動呼び出し
					print 'ゴル吉「いたぞー！！」'
					return 0
				}else{
					return 1
				}
			}

			//これがおいらの逃げる道ー♪
			chara delay 逃げ道キャンセルディレイ -time (60*30) -proc ゲームオーバーキャンセル処理

		}

	}


	proc ラジオドラマ振動呼び出し $:ストリームＩＤ $:話者名 $:アクションコード {
		print '死んで振動！！'
		chara パッド振動 振動君 \
			-vibfile w24c_missionfailed
	}






	proc 人質呼びかけ反応プロック {

		if($f:ロードチェックＯＮフラグ && $1 == エイムズ){
			eval($f:ロードチェックＯＮフラグ = 0);
			eval($f:エイムズペースメーカー判定ＯＫ = 1)

			command 無線設定 -reset
			mesg コマンダー 敵兵セット 視界オフ
			command プレイヤー無敵セット
			command メニュー設定 -menu off -gage off  -radar off

			command パッド操作 \
				-release

			//これがおいらの逃げる道ー♪
			chara delay ディレイ -time (60 * 15) -p あんたがエイムズ言い終わった


		}else if($1 == ジェニファー && ($b:w24c_人質種類 == d:ノーマル || $b:w24c_人質種類 == d:全員ジェニファー)){
			if(! $f:ジェニファー名前聞いた){
				chara delay ディレイ -time 300 -exec{
					eval($f:ジェニファー名前聞いた = 1)
				}
			}

		}else if($b:w24c_人質種類 == d:全員キャシー && $1 != ジョニー){
			if($b:臭いトラップ発動回数 < 10){
				print '全員がおしっこじゃー'
				eval($b:臭いトラップ発動回数 = $b:臭いトラップ発動回数 + 1);
				@おもらしにおい処理 おもらし０ ca001
			}

		}else if($1 == キャシー１ && $b:w24c_人質種類 == d:ノーマル){
			if(!$f:w24c_キャシーおしっこした){
				print 'おしっこじゃー'
				eval($f:w24c_キャシーおしっこした = 1)
				@おもらしにおい処理 おもらし１ ev_pee_01
			}
		}else if($1 == 人質１１ && $b:w24c_人質種類 == d:ノーマル){
			if(!$f:w24c_人質１１おしっこした){
				print 'おしっこじゃー'
				eval($f:w24c_人質１１おしっこした = 1)
				@おもらしにおい処理 おもらし２ ev_pee_02
			}
		}else if($1 == 人質２５ && $b:w24c_人質種類 == d:ノーマル){
			if(!$f:w24c_人質２５おしっこした){
				print 'おしっこじゃー'
				eval($f:w24c_人質２５おしっこした = 1)
				@おもらしにおい処理 おもらし３ ev_pee_03
			}
		}



		if($1 != 人質１ && $1 != 人質２ && $1 != 人質３ && $1 != 人質４ && $1 != 人質６ && $1 != 人質７ && $1 != キャシー１ && !$f:w24c_警備兵増員中 ){
			@声かけ回数加算処理
		}


	}


	proc おもらしにおい処理 $:名前 $:トラップ名 {

		chara delay ディレイ -arg $1 $2 -time 180 -exec{
			chara 爆弾検知領域 $1 \
				-trap $2 \
				//-rgb 60 0 40 \
				-mode 0
/*
			chara delay ディレイ -arg $1 $2 -time 1200 -exec{
				mesg 爆弾検知領域 $1 消去 240
			}
*/
		}


	}



//###################################################################################
//							ジョニーの便所におい設定
//###################################################################################


	proc ジョニーの便所におい設定 {

		chara 爆弾検知領域 ジョニー臭気 \
			-trap ev_pee_00 \
			-rgb 60 0 10 \
			-mode 0
/*
			chara delay ディレイ -arg $1 $2 -time 1200 -exec{
				mesg 爆弾検知領域 ジョニー臭気 消去 240
			}
*/


	}








//###################################################################################
//										敵兵殺した
//###################################################################################



	proc 敵兵死亡時プロック１ {

		if(`%ゲームオーバーチェック` == 0 && $f:ロードチェックＯＮフラグ){
			@ゲームオーバー背景設定
			command ゲームオーバー処理開始 -exec {

				@シナリオデモ開始処理

				//これがおいらの逃げる道ー♪
				chara delay 逃げ道キャンセルディレイ -time (60*30) -proc ゲームオーバーキャンセル処理

				chara デモキャンセルチェック デモキャンセル \
					-p ゲームオーバーキャンセル処理

				@敵兵死亡時カメラ $1

				@司令官警戒音声

			}

		}

	}


	proc 敵兵死亡時カメラ $:対象兵士名 {
		command ゲット敵兵座標 \
			$1 $i:Ｘ座標変数 $i:Ｙ座標変数 $i:Ｚ座標変数


		chara delay 敵兵死亡カメラディレイ -time 90 -exec{

			if($i:Ｚ座標変数 < -63000){
				eval($i:補完ＰＸ = -755)
				eval($i:補完ＰＹ = -1000)
				eval($i:補完ＰＺ = -63637)
			}else if($i:Ｘ座標変数 >= && $i:Ｚ座標変数 >= -54500){
				eval($i:補完ＰＸ = 1000)
				eval($i:補完ＰＹ = -1000)
				eval($i:補完ＰＺ = -51500)
			}else if($i:Ｘ座標変数 >= && $i:Ｚ座標変数 < -54500){
				eval($i:補完ＰＸ = 1000)
				eval($i:補完ＰＹ = -1000)
				eval($i:補完ＰＺ = -57500)
			}else if($i:Ｘ座標変数 < && $i:Ｚ座標変数 >= -54500){
				eval($i:補完ＰＸ = -2500)
				eval($i:補完ＰＹ = -1000)
				eval($i:補完ＰＺ = -51500)
			}else{
				eval($i:補完ＰＸ = -2500)
				eval($i:補完ＰＹ = -1000)
				eval($i:補完ＰＺ = -57500)
			}

			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ \
				-t $i:Ｘ座標変数,$i:Ｙ座標変数,$i:Ｚ座標変数 \
				-a 400 \
				-i 0 0 0 0 \
				-s 1

			chara カメラ設定 モーションカメラ \
				-c 1 \
				-p $i:補完ＰＸ,$i:補完ＰＹ,($i:補完ＰＺ - 500) \
				-t $i:Ｘ座標変数,$i:Ｙ座標変数,$i:Ｚ座標変数 \
				-a 500 \
				-i 3 -1 0 0 \
				-z d:CAMERA_INTERP_CAMERA \ //補完カメラフラグを指定。
				-interp_time 600 \ //補完時間を指定
				-s 1

		}

	}





	proc 司令官警戒音声 {

		if(!$f:w24c_ゲームオーバー終了処理呼ばれてます){
			command StreamStopAll

			chara delay ディレイ -time 1 -exec{
				if(`command StreamIsPlay` < 2 ){
					if(!$f:w24c_敵兵死亡デモ見た){
						eval($f:w24c_敵兵死亡デモ見た = 1)
						command varsave $f:w24c_敵兵死亡デモ見た

						%rand 3
						if($status == 0){
							%Stream t:vc040061 -p 敵兵死亡時プロック２
							print '指揮官「定時連絡がないぞ」'
						}else if($status == 1){
							%Stream t:vc040062 -p 敵兵死亡時プロック２
							print '指揮官「定時連絡はどうした？」'
						}else{
							%Stream t:vc040063 -p 敵兵死亡時プロック２
							print '指揮官「状況を報告せよ」'
						}
					}else{
						@敵兵死亡時プロック４
					}
					return 0
				}else{
					return 1
				}
			}
		}

	}


	proc 敵兵死亡時プロック２ {

		if($1 == 0){

			%rand 4
			if($status == 0){
				%Stream t:vc040064 -p 敵兵死亡時プロック３
				print '指揮官「応答せよ、応答せよ！」'
			}else if($status == 1){
				%Stream t:vc040065 -p 敵兵死亡時プロック３
				print '指揮官「どうした、応答しろ！」'
			}else if($status == 2){
				%Stream t:vc040066 -p 敵兵死亡時プロック３
				print '指揮官「どうしたんだ!?」'
			}else{
				%Stream t:vc040067 -p 敵兵死亡時プロック３
				print '指揮官「何があった!?」'
			}

		}

	}




	proc 敵兵死亡時プロック３ {

		if($1 == 0){
			chara delay 敵兵死亡カメラディレイ -time 60 -proc 敵兵死亡時プロック４
		}

	}


	proc 敵兵死亡時プロック４ {

		%rand 4

 		if(`command StreamIsPlay` < 2){
	 		if(! $f:w24c_ゲームオーバーキャンセルした){

				if($status == 0){
					%Stream t:vc040504 -p 最寄ポイント検索処理
					print '指揮官「シェルワン１中央棟ビーワンＢ１ホール集会場で異状発生。至急確認に向かえ」'
				}else if($status == 1){
					%Stream t:vc040505 -p 最寄ポイント検索処理
					print '指揮官「シェルワン１中央棟ビーワンＢ１で異状発生。至急確認に向かえ」'
				}else if($status == 2){
					%Stream t:vc040506 -p 最寄ポイント検索処理
					print '指揮官「シェルワン１中央棟ビーワンＢ１ホール集会場で連絡が途絶えた。至急確認に向かえ」'
				}else{
					%Stream t:vc040507 -p 最寄ポイント検索処理
					print '指揮官「「シェルワン１中央棟ビーワンＢ１で連絡が途絶えた。至急確認に向かえ」'
				}

			}else{

				if($status == 0){
					%Stream t:vc040504 -p ラジオドラマゲームオーバー
					print '指揮官「シェルワン１中央棟ビーワンＢ１ホール集会場で異状発生。至急確認に向かえ」'
				}else if($status == 1){
					%Stream t:vc040505 -p ラジオドラマゲームオーバー
					print '指揮官「シェルワン１中央棟ビーワンＢ１で異状発生。至急確認に向かえ」'
				}else if($status == 2){
					%Stream t:vc040506 -p ラジオドラマゲームオーバー
					print '指揮官「シェルワン１中央棟ビーワンＢ１ホール集会場で連絡が途絶えた。至急確認に向かえ」'
				}else{
					%Stream t:vc040507 -p ラジオドラマゲームオーバー
					print '指揮官「「シェルワン１中央棟ビーワンＢ１で連絡が途絶えた。至急確認に向かえ」'
				}

			}
		}else{
			@ラジオドラマゲームオーバー
		}

	}


















//###################################################################################
//									チャフ使用した
//###################################################################################

	proc チャフ使用時プロック {

		if(`%ゲームオーバーチェック` == 0 && $f:ロードチェックＯＮフラグ){
			@ゲームオーバー背景設定
			command ゲームオーバー処理開始 -exec {
				eval($b:ゲームオーバー種類 = d:ゲームオーバー種類:チャフ使用した)

				chara デモキャンセルチェック デモキャンセル \
					-p ゲームオーバーキャンセル処理

				//これがおいらの逃げる道ー♪
				chara delay 逃げ道キャンセルディレイ -time (60*30) -proc ゲームオーバーキャンセル処理

				@シナリオデモ開始処理

				chara delay 敵兵死亡カメラディレイ -time 90 -exec{
					@人質部屋全体なめカメラ
					@司令官警戒音声
				}

			}

		}

	}



	proc 人質部屋全体なめカメラ {
		chara カメラ設定 モーションカメラ \
			-c 1 \
			-p -749,-2652,-49608 \
			-t 1528,-5276,-54080 \
			-a 157 \
			-i 0 0 0 0 \
			-s 1

		chara カメラ設定 モーションカメラ \
			-c 1 \
			-p -2354,-2740,-49720 \
			-t -4573,-5687,-54013 \
			-a 157 \
			-i 3 -1 0 0 \
			-z d:CAMERA_INTERP_CAMERA \ //補完カメラフラグを指定。
			-interp_time 600 \ //補完時間を指定
			-s 1
	}




//###################################################################################
//								警戒モードになった
//###################################################################################

	proc 警戒時プロック {

		if(`%ゲームオーバーチェック` == 0 && $f:ロードチェックＯＮフラグ && !$f:w24c_ゲームオーバー終了処理呼ばれてます){
			print '警戒連絡された！！'
			@ゲームオーバー背景設定
			command ゲームオーバー処理開始 -exec {
				@人質部屋全体なめカメラ
				command StreamStopAll
				chara delay ディレイ -time 1 -exec{
					if(`command StreamIsPlay` == 0 ){
#ifdef JAPANESE
						@ラジオドラマゲームオーバー
#else
						@敵兵死亡時プロック４
#endif
						return 0
					}else{
						return 1
					}
				}
			}
		}

	}







































//###################################################################################
//								ゲームオーバー処理設定
//###################################################################################






	proc ゲームオーバーフェードアウト終了 {

		if(`%ゲームオーバーチェック` == 0 && $f:ロードチェックＯＮフラグ){
			eval( $f:ロードチェックＯＮフラグ = 0);
			eval($s:登場ポイント = ゲームオーバーデモ)

			print 'リスタートしまーす！！'
			restart
		}
	}








//###################################################################################
//						ゲームオーバー処理設定（敵兵設定）
//###################################################################################



#define		ゴーゴーコマンダー上		62
#define		ゴーゴーコマンダー下		5



	proc 攻撃兵ゲームオーバー１ {

		#if d:DEBUG_PRINT
			print 'attacker_gover_set'
		#endif

		//取り囲み攻撃兵
		command foreach -argc 3 -repeat 4 \
			-data { \
				{敵兵:01,2,1} \
				{敵兵:62,3,1} \
				{敵兵:63,4,3} \
				{敵兵:64,5,3} \
			} \
			-exec {

				chara アタッカー $1 -r ($w:最短ルートナンバー[$2]/10 + 1000) -s 0 -e $3 \
					-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
					-l 30000 \
					-f 30000

			}



		//突入攻撃兵
		if($i:プレイヤー位置Ｚ > -63000){

			command foreach -argc 2 -repeat 4 \
				-data { \
					{敵兵:69,d:攻撃兵階段上待機１} \
					{敵兵:70,d:攻撃兵階段上待機２} \
					{敵兵:71,d:攻撃兵階段上待機３} \
					{敵兵:72,d:攻撃兵階段上待機４} \
				} \
				-exec {

					chara アタッカー $1 -r $2 -s 0 -e 1 \
						-i 2000,2000,2000 \
						-l 30000 \
						-f 30000

				}

		}else{

			command foreach -argc 2 -repeat 4 \
				-data { \
					{敵兵:69,d:攻撃兵スタジオ待機１} \
					{敵兵:70,d:攻撃兵スタジオ待機２} \
					{敵兵:71,d:攻撃兵スタジオ待機３} \
					{敵兵:72,d:攻撃兵スタジオ待機４} \
				} \
				-exec {

					chara アタッカー $1 -r $2 -s 0 -e 1 \
						-i 2000,2000,2000 \
						-l 30000 \
						-f 30000

				}

		}


	}


	proc ゲームオーバー時警備兵 {
/*
		command foreach -argc 2 -repeat 2 \
			-data { \
				{敵兵:01,0} \
				{敵兵:02,1} \
			} \
			-exec {

				chara 警備兵 $1 \
					-r ($w:最短ルートナンバー[$2]/10 + 1000) -n ($w:最短ルートナンバー[$2]%10) -d 9000,-8500,-62000 0 \
					-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
					-l 30000 \
					-f 30000 \
					-s 0b0010

			}
*/

	}

	proc ゲームオーバー時攻撃兵コマンダー {
		#if d:DEBUG_PRINT
			print 'atcomm_gover_set'
		#endif

		chara 攻撃コマンダー atcomm -e 攻撃兵ゲームオーバー１
	}

	proc ゲームオーバー時警備兵コマンダー{
			chara 警備コマンダー wccomm -e {ゲームオーバー時警備兵}
	}




	proc ゲームオーバー用敵兵設定 {
		#if d:DEBUG_PRINT
			print 'gover_commander_set'
		#endif

		#if d:ATTACKER
			chara コマンダー 敵兵セット \
				-m d:ALERT_MODE_KIKEN \
				-w ゲームオーバー時警備兵コマンダー \
				-a ゲームオーバー時攻撃兵コマンダー \
				-r -7250,-8500,-59500 人質部屋 -7250,-8500,-49500 人質部屋 6000,-8500,-59500 人質部屋 6000,-8500,-49500 人質部屋 \
				-c 4750,-8500,-70000 人質部屋 \
				-v [ene_plant_voice:01] \
				-x [ghq_area_alert_voice:w24c] \
				-y [ghq_caution_voice:w24c] \
				-z 60 \
				-b 60000


			mesg コマンダー 敵兵セット 危険レベル減らない

		#endif


		//突入兵整列用透明壁

		if($i:プレイヤー位置Ｚ > -63000){
			command foreach -argc 1 -repeat 5 \
				-data { \
					{-1250} \
					{-2250} \
					{-3250} \
					{-4250} \
					{-5250} \
				} \
				-exec{

					chara 透明壁 敵兵しきり壁 \
						-position $1 -4500 -67000 2000 \
						$1 -4500 -65500 2000 \
						-attribute (d:HZX_SEG_NO_BULLET|d:HZX_SEG_NO_MISSILE|d:HZX_SEG_NO_C4|d:HZX_SEG_NO_RECOIL|d:HZX_SEG_NO_HARITSUKI|d:HZX_SEG_NO_DISP_RADAR|d:HZX_SEG_NO_BULLETHOLE|d:HZX_SEG_NO_SPRAY|d:HZX_SEG_NO_ENEMY_EYES)

				}



			chara ルートデモ人形 指揮官兵 \
				-route d:ゴーゴーコマンダー上 0 \
				-kms gbs_def \ /*EVMを表示する場合はダミーKMSが必要*/
				-mar gbs_w24c_gover \
				-weapon 3 \
				-number d:ゲームオーバー敵兵モーションリスト:gbs_walk

		}else{

			command foreach -argc 1 -repeat 5 \
				-data { \
					{-63000} \
					{-64000} \
					{-65000} \
					{-66000} \
					{-67000} \
				} \
				-exec{

					chara 透明壁 敵兵しきり壁 \
						-position -11000 -4500 $1 2000 \
								-9500 -4500 $1 2000 \
						-attribute (d:HZX_SEG_NO_BULLET|d:HZX_SEG_NO_MISSILE|d:HZX_SEG_NO_C4|d:HZX_SEG_NO_RECOIL|d:HZX_SEG_NO_HARITSUKI|d:HZX_SEG_NO_DISP_RADAR|d:HZX_SEG_NO_BULLETHOLE|d:HZX_SEG_NO_SPRAY|d:HZX_SEG_NO_ENEMY_EYES)

				}



			chara ルートデモ人形 指揮官兵 \
				-route d:ゴーゴーコマンダー下 0 \
				-kms gbs_def \ /*EVMを表示する場合はダミーKMSが必要*/
				-mar gbs_w24c_gover \
				-weapon 3 \
				-number d:ゲームオーバー敵兵モーションリスト:gbs_walk



		}




	}





//###################################################################################
//							ゲームオーバー処理設定（実行時）
//###################################################################################


	proc ゲームオーバーキャンセル処理 {
		print 'キャンセルされましたー！！！'

		eval($f:w24c_ゲームオーバーキャンセルした = 1)
		command varsave $f:w24c_ゲームオーバーキャンセルした
/*
		if(`%ゲームオーバーチェック` == 0 && $f:ロードチェックＯＮフラグ){
			command ゲームオーバー処理開始 \
				-exec {
*/
					eval($f:w24c_ゲームオーバー終了処理呼ばれてます = 1)
					command ゲームオーバー処理終了
//				}
//		}
	}


	proc ゲームオーバー進入時処理 {
		print 'フェードイン！！！'

		command パッド操作 -release
		command 無線設定 -reset
		command プレイヤー無敵セット
		mesg シネマスクリーン シネマ フェードアウト 0
		command メニュー設定 -menu off -gage off  -radar off -subwin off

		chara デモキャンセルチェック デモキャンセル \
			-p ゲームオーバーキャンセル処理


		if($w:武器 == d:武器:スタン || $w:武器 == d:武器:ＰＳＧ１ || $w:武器 == d:武器:スティンガー){
			eval( $w:武器 = d:武器:素手 )
		}

		if($w:アイテム == d:アイテム:レーション || $w:アイテム == d:アイテム:防弾チョッキ || $w:アイテム == d:アイテム:ステルス || $w:アイテム == d:アイテム:ゴル兵制服 || $w:アイテム == d:アイテム:双眼鏡 || $w:アイテム == d:アイテム:デジカメ){
			eval( $w:アイテム = d:アイテム:素手 )
		}

		if($i:プレイヤー位置Ｚ > -63000){

			chara カメラ設定 カットインカメラ \
				-c 1 \
				-p 3700,-3593,-62332 \
				-t -3370,-4467,-66994 \
				-a 188 \
				-i 0 -1 0 0 \
				-s 1

		}else{
			chara カメラ設定 カットインカメラ \
				-c 1 \
				-p -1760,-8205,-62577 \
				-t -6710,-7536,-61347 \
				-a 200 \
				-i 0 -1 0 0 \
				-s 1

		}

		if($i:プレイヤー位置Ｚ > -63000){
			mesg ドア 人質部屋ドア open
		}else{
			print 'ドアオープン！！！！（ゲームオーバー）'
/*
			if($f:w24c_スタジオドア状態オープン == 0){
				eval($f:w24c_スタジオドア状態オープン = 1)
				mesg ドア スタジオドア open
			}
*/
		}
		mesg 透明壁 敵兵しきり壁 off

		chara フェードインアウト フェードイン \
			-i 0,0,0 128 \
			-c 0,0,0 0 \
			-t d:FADEIN_TIME \
			-p ゲームオーバー処理開始

	}



	proc ゲームオーバー処理開始 {
/*
		//敵兵が全員入ったらドア閉める
		if($i:プレイヤー位置Ｚ > -63000){
			trap dr001 敵兵:72 \
				-mask 出る \
				-exec {
					print 'ドアクローズ！！！！（ゲームオーバー）'
					mesg ドア 人質部屋ドア close
				}
		}else{
			trap dr002 敵兵:72 \
				-mask 出る \
				-exec {
					if($f:w24c_スタジオドア状態オープン == 1){
						eval($f:w24c_スタジオドア状態オープン = 0)
						print 'ドアクローズ！！！！（ゲームオーバー）'
						mesg ドア スタジオドア close
					}
				}
		}
*/

		print '体力は？'$w:体力

		chara delay ディレイ -time 240 -exec{

			if($i:プレイヤー位置Ｚ > -63000){

				chara カメラ設定 カットインカメラ \
					-c 1 \
					-p 100,-1327,-51061 \
					-t 2000,-3697,-55233 \
					-a 167 \
					-i 3 -1 0 0 \
					-z d:CAMERA_INTERP_CAMERA \ //補完カメラフラグを指定。
					-interp_time 60 \ //補完時間を指定
					-s 1

			}else{

				chara カメラ設定 カットインカメラ \
					-c 1 \
					-p -10172,-4045,-54137 \
					-t -8154,-5148,-57109 \
					-a 200 \
					-i 3 -1 0 0 \
					-z d:CAMERA_INTERP_CAMERA \ //補完カメラフラグを指定。
					-interp_time 60 \ //補完時間を指定
					-s 1

			}

			chara delay ディレイ -time 120 -exec{
				chara カメラ設定 カットインカメラ \
					-s -1

				mesg ルートデモ人形 指揮官兵 kill

				mesg デモキャンセルチェック デモキャンセル kill
				command プレイヤー無敵解除
				command パッド操作 -cancel
				//command パッド操作 -mask (d:PAD_L2 | d:PAD_R2 | d:PAD_STA | d:PAD_SEL)

				chara delay ディレイ -time (2 * 60 * 60) -exec{
					command プレイヤー瞬殺 -name d:PLAYER
				}

			}

		}

	}




	//1位から12位までを決定
	proc 最寄ポイント検索処理 {


#if d:ボス寂しげ指示
		@ラジオドラマゲームオーバー
#else
		print '最寄ポイント検索開始ー！！！！'



		//ライデン初期位置補正
		if(`%プレイヤー状態取得` & d:PFLAG_INTRUDE){
			if($i:プレイヤー位置Ｘ < -7000 ){
				eval( $i:プレイヤー初期Ｘ位置 = -7500 ) ;
				eval( $i:プレイヤー初期Ｙ位置 = $i:プレイヤー位置Ｙ ) ;
				eval( $i:プレイヤー初期Ｚ位置 = $i:プレイヤー位置Ｚ ) ;

			}else if($i:プレイヤー位置Ｘ < -2000 ){
				eval( $i:プレイヤー初期Ｘ位置 = -3000 ) ;
				eval( $i:プレイヤー初期Ｙ位置 = $i:プレイヤー位置Ｙ ) ;
				eval( $i:プレイヤー初期Ｚ位置 = $i:プレイヤー位置Ｚ ) ;

			}else{
				eval( $i:プレイヤー初期Ｘ位置 = $i:プレイヤー位置Ｘ ) ;
				eval( $i:プレイヤー初期Ｙ位置 = $i:プレイヤー位置Ｙ ) ;

				if($i:プレイヤー位置Ｚ > -54500){
					eval( $i:プレイヤー初期Ｚ位置 = -52500 ) ;

				}else{
					eval( $i:プレイヤー初期Ｚ位置 = -56500 ) ;

				}

			}

		}else if( $i:プレイヤー位置Ｘ > -750 && $i:プレイヤー位置Ｘ < 3500 && $i:プレイヤー位置Ｚ > -63000 && $i:プレイヤー位置Ｚ < -61750){
			eval( $i:プレイヤー初期Ｘ位置 = $i:プレイヤー位置Ｘ ) ;
			eval( $i:プレイヤー初期Ｙ位置 = -8500 ) ;
			eval( $i:プレイヤー初期Ｚ位置 = -61500 ) ;

		}else{
			eval( $i:プレイヤー初期Ｘ位置 = $i:プレイヤー位置Ｘ ) ;
			eval( $i:プレイヤー初期Ｙ位置 = $i:プレイヤー位置Ｙ ) ;
			eval( $i:プレイヤー初期Ｚ位置 = $i:プレイヤー位置Ｚ ) ;
		}

		eval( $i:プレイヤー初期方向 = $w:プレイヤー方向 ) ;






		eval($b:順位 = 0)

		command	配列セット $w:最短ルートナンバー[0] {
			2000,2000,2000,2000,2000, \
			2000,2000,2000,2000,2000, \
			2000,2000,2000
		}

		chara delay ポイント検索ディレイ -time 1 -exec{

			eval($i:現在の最短距離 = 200000)

			//$1：ポイント番号
			//$2：Ｘ座標
			//$3：Ｙ座標
			//$4：Ｚ座標
			command foreach -argc 4 -repeat 130 \
				-data { \
					#include "w24c_routes.h"
				} \
				-exec { \

					//一番近いポイントの番号を書き込む。高さによるボーナスアリ
					eval($i:調査対象ポイントの距離 = `%VecLen $i:プレイヤー初期Ｘ位置 0 $i:プレイヤー初期Ｚ位置 $2 0 $4` + (`%abs ($3 - $i:プレイヤー初期Ｙ位置)` * 5) )

					if($i:調査対象ポイントの距離 <= $i:現在の最短距離){
						if($1 != $w:最短ルートナンバー[0]/10 \
						&& $1 != $w:最短ルートナンバー[1]/10 \
						&& $1 != $w:最短ルートナンバー[2]/10 \
						&& $1 != $w:最短ルートナンバー[3]/10){
							if($1 != $w:最短ルートナンバー[4]/10 \
							&& $1 != $w:最短ルートナンバー[5]/10 \
							&& $1 != $w:最短ルートナンバー[6]/10 \
							&& $1 != $w:最短ルートナンバー[7]/10){
								if($1 != $w:最短ルートナンバー[8]/10 \
								&& $1 != $w:最短ルートナンバー[9]/10 \
								&& $1 != $w:最短ルートナンバー[10]/10 \
								&& $1 != $w:最短ルートナンバー[11]/10){

									//注意！！！$w:法線Ｘ変位　は、Ｚ軸が逆のため、-1をかけてあります！！
									if($i:調査対象ポイントの距離 > 0){
										eval($w:Ｘ変位 = ($i:プレイヤー初期Ｘ位置 - $2) * 1000 / $i:調査対象ポイントの距離)
										eval($w:Ｚ変位 = ($3 - $i:プレイヤー初期Ｚ位置) * 1000 / $i:調査対象ポイントの距離)
										eval($w:角度 = `%atan $w:Ｘ変位 $w:Ｚ変位` )
									}else{
										eval($w:角度 = 0 )
									}

									eval($w:最短ルートナンバー[$b:順位] = $1 * 10)
									eval($i:現在の最短距離 = $i:調査対象ポイントの距離)

									//角度でルートを変更
									if($w:角度 >= (512-256) && $w:角度 < (512+256)){
										eval($w:最短ルートナンバー[$b:順位] = $w:最短ルートナンバー[$b:順位] + 1)
									}else if($w:角度 >= (1024-256) && $w:角度 < (1024+256)){
										eval($w:最短ルートナンバー[$b:順位] = $w:最短ルートナンバー[$b:順位] + 2)
									}else if($w:角度 >= (1536-256) && $w:角度 < (1536+256)){
										eval($w:最短ルートナンバー[$b:順位] = $w:最短ルートナンバー[$b:順位] + 3)
									}else if($w:角度 >= (2048-256) && $w:角度 < (2048+256)){
										eval($w:最短ルートナンバー[$b:順位] = $w:最短ルートナンバー[$b:順位] + 4)
									}else if($w:角度 >= (2560-256) && $w:角度 < (2560+256)){
										eval($w:最短ルートナンバー[$b:順位] = $w:最短ルートナンバー[$b:順位] + 5)
									}else if($w:角度 >= (3072-256) && $w:角度 < (3072+256)){
										eval($w:最短ルートナンバー[$b:順位] = $w:最短ルートナンバー[$b:順位] + 6)
									}else if($w:角度 >= (3584-256) && $w:角度 < (3584+256)){
										eval($w:最短ルートナンバー[$b:順位] = $w:最短ルートナンバー[$b:順位] + 7)
									}

								}
							}
						}


					}

					if($1 == 129){
						print '$w:最短ルートナンバー'$b:順位'は'$w:最短ルートナンバー[$b:順位]
					}


				}


			if($b:順位 == 12){

				chara フェードインアウト フェードアウト \
					-i 0 0 0 0 \		//設定するとこのＲＧＢαから始まる
					-c 0 0 0 128 \		//目標のＲＧＢα
					-t 30 \
					-p ゲームオーバーフェードアウト終了

				return 0
			}else{
				eval($b:順位 = $b:順位 + 1)
				return 1
			}


		}


#endif

	}











//###################################################################################
//							エイムズペースメーカー判定
//###################################################################################



	proc エイムズ発見１ポリゴンデモ１ロード {
		eval( $f:ロードチェックＯＮフラグ = 1);
		eval($w:p_story = d:ST:P040_01_P01エイムズ発見１ポリゴンデモ１開始)

		command セットサウンドコード -c d:SNG_FOUTS_S

		if ( $w:アイテム == d:アイテム:ゴル兵制服 ) {
			load "d036p03" -r 'r_plt4'
		}else{
			load "d036p03"
		}

	}




	proc エイムズペースメーカー判定 {
		#if d:DEBUG_PRINT
			print 'pacemaker_judgement'
			print 'エイムズペースメーカー判定'
		#endif

		eval($f:w24c_エイムズに声かけ中 = 0)
		eval($b:w24c_声かけ回数 = 0)
		print '$b:w24c_声かけ回数はいくつなの？'$b:w24c_声かけ回数
		eval($f:w24c_警備兵増員中 = 0)
		eval($f:w24c_スタジオドア前誰かいる = 0)

		if($w:ゲーム設定 <= d:LEVEL_NORMAL){
			eval($b:増員敵兵ナンバー = 0)
		}else if($w:ゲーム設定 == d:LEVEL_HARD){
			eval($b:増員敵兵ナンバー = 1)
		}else{
			eval($b:増員敵兵ナンバー = 4)
		}

		trap ca001 d:PLAYER \
			-mask 入る \
			-state d:TRP_STATE_SUBJECT \
			-button d:ACTION_BUTTON \
			-exec {

				if( $w:武器 == d:武器:マイク && !$f:w24c_エイムズに声かけ中){
					eval($f:w24c_エイムズに声かけ中 = 1)
					chara delay あんたがエイムズ声かけディレイ -time (60*15) -exec{
						if($f:w24c_エイムズに声かけ中){
							@あんたがエイムズ言い終わった
						}
					}

					command ゲット人質ターゲット $s:人質名

					if(`command StreamIsPlay` < 2){

						if($s:人質名 == ジェニファー && $f:ジェニファー名前聞いた){
							%Stream t:vc121006 -p あんたがエイムズ言い終わった -menustop
							print 'ライデン「あんたはジェニファー」'
						}else if($b:w24c_ライデンボヤキ回数 < 5){
							%Stream t:vc121001 -p あんたがエイムズ言い終わった -menustop
							print 'ライデン「あんたがエイムズだな？」'
						}else if($b:w24c_ライデンボヤキ回数 < 7){
							%Stream t:vc121002 -p あんたがエイムズ言い終わった -menustop
							print 'ライデン「あんたがエイムズ……なのか？」'
						}else if($b:w24c_ライデンボヤキ回数 < 12){
							%Stream t:vc121003 -p あんたがエイムズ言い終わった -menustop
							print 'ライデン「あんたがエイムズであってくれ」'
						}else if($b:w24c_ライデンボヤキ回数 < 15){
							%Stream t:vc121004 -p あんたがエイムズ言い終わった -menustop
							print 'ライデン「多分あんたもエイムズじゃないんだろうな」'
						}else if($b:w24c_ライデンボヤキ回数 == 15){
							%Stream t:vc121005 -p あんたがエイムズ言い終わった -menustop
							print 'ライデン「……もうあんたがエイムズでなくてもいい」'
						}else{
							%Stream t:vc121001 -p あんたがエイムズ言い終わった -menustop
							print 'ライデン「あんたがエイムズだな？」'
						}
					}

					chara delay ディレイ -time 30 -exec{
						print '誰何ノイズ発生'
						%セットノイズ -n d:NOISE_MIC_QUEST \
							-p $i:プレイヤー位置Ｘ,$i:プレイヤー位置Ｙ,$i:プレイヤー位置Ｚ -m 人質部屋
						chara delay ディレイ -time 1 -exec{
							%セットノイズ -n d:NOISE_SS \
								-p $i:プレイヤー位置Ｘ,$i:プレイヤー位置Ｙ,$i:プレイヤー位置Ｚ -m 人質部屋
						}
					}


				}

			}


		trap ev008 ？ \
			-mask ＊ \
			-exec {
				if($3 == いる){
					print 'スタジオドア前誰かいまっせ！！！！'
					eval($f:w24c_スタジオドア前誰かいる = 1)
				}else if($3 == 出る){
					print 'スタジオドア前からいなくなりました。'
					eval($f:w24c_スタジオドア前誰かいる = 0)
				}
			}



		trap dr002 ？ \
			-mask ？ \
			-exec {
				if($3 == 入る){
					print 'スタジオドアオープン！！！'
					mesg ドア スタジオドア open
				}else{
					print 'スタジオドアクローズ！！！'
					mesg ドア スタジオドア close

					if($6 > -63000 && $f:w24c_警備兵増員中){
						if($2 == 敵兵:02){
							mesg 警備兵 敵兵:02 ルート変更 d:警備兵巡回ルート２ 9000 -8500 -62000 人質部屋
							@増員デモ終了

						}else if($2 == 敵兵:03){
							mesg 警備兵 敵兵:03 ルート変更 d:警備兵巡回ルート３ 9000 -8500 -62000 人質部屋
							@増員デモ終了

						}else if($2 == 敵兵:04){
							mesg 警備兵 敵兵:04 ルート変更 d:警備兵巡回ルート４ 9000 -8500 -62000 人質部屋
							@増員デモ終了

						}else if($2 == 敵兵:05){
							mesg 警備兵 敵兵:05 ルート変更 d:警備兵巡回ルート５ 9000 -8500 -62000 人質部屋
							@増員デモ終了
						}
					}
				}
			}



		print 'ダークゾーン消滅！！！'
		command トラップ切り替え \
			-trap dark \
			-switch 0



	}





	proc 声かけ回数加算処理 {

		if($b:w24c_声かけ回数 == 0){
			chara delay ディレイ -time 1 -exec{
				if($f:w24c_警備兵増員中){
					print '$f:w24c_警備兵増員中'$f:w24c_警備兵増員中
				}
				return 1
			}
		}

		print 'ぷりぷり'
		if(!$f:w24c_警備兵増員中 && !$f:エイムズペースメーカー判定ＯＫ){
			print 'ぷりぷり２'$b:w24c_声かけ回数
			if($b:w24c_声かけ回数 < 100){
				print '声かけ回数加算'
				eval($b:w24c_声かけ回数 = $b:w24c_声かけ回数 + 1)
			}

			if($b:w24c_ライデンボヤキ回数 < 100){
				eval($b:w24c_ライデンボヤキ回数 = $b:w24c_ライデンボヤキ回数 + 1)	//ライデンの台詞を変化させるのにのみ使用
				command varsave $b:w24c_ライデンボヤキ回数
			}

			if($b:増員敵兵ナンバー < 4){
				if($b:w24c_声かけ回数 == 4 \
				|| $b:w24c_声かけ回数 == 10 \
				|| $b:w24c_声かけ回数 == 15 \
				|| $b:w24c_声かけ回数 == 20 \
				|| ($b:w24c_声かけ回数 > 20 && $b:w24c_声かけ回数%5 == 0) \
				){
					@人質部屋増員連絡
				}
			}
		}
	}










//###################################################################################
//								人質部屋増員連絡
//###################################################################################

	proc 人質部屋増員連絡 {

		eval($f:w24c_警備兵増員中 = 1)

		command ゲット敵兵座標 \
			敵兵:01 $i:敵兵Ｘ座標 $i:敵兵Ｙ座標 $i:敵兵Ｚ座標

		if($i:敵兵Ｘ座標 > 0 && $i:敵兵Ｚ座標 > -54500){
			mesg 警備兵 敵兵:01 ルート変更 d:警備兵増員連絡１ 9000 -8500 -62000 人質部屋

		}else if($i:敵兵Ｘ座標 > 0 && $i:敵兵Ｚ座標 <= -54500){
			mesg 警備兵 敵兵:01 ルート変更 d:警備兵増員連絡２ 9000 -8500 -62000 人質部屋

		}else if($i:敵兵Ｘ座標 <= 0 && $i:敵兵Ｚ座標 > -54500){
			mesg 警備兵 敵兵:01 ルート変更 d:警備兵増員連絡３ 9000 -8500 -62000 人質部屋

		}else{
			mesg 警備兵 敵兵:01 ルート変更 d:警備兵増員連絡４ 9000 -8500 -62000 人質部屋

		}


	}



	proc 増員兵スタート前チェック {
		print '増員兵スタート前チェック'
		//if($i:プレイヤー位置Ｚ < -62000 && $i:プレイヤー位置Ｘ > -11000 && $i:プレイヤー位置Ｘ < -9500){
		if($f:w24c_スタジオドア前誰かいる){
			print 'おいおいライデン、なんだって扉の前にいたりするんだよー！！！！'
			eval( $f:ローカルフラグ２ = 1 );
			eval($f:w24c_警備兵増員中 = 0)
			mesg 警備兵 敵兵:01 ルート変更 d:警備兵巡回ルート１＿２ 9000 -8500 -62000 人質部屋
		}else{
			eval( $f:ローカルフラグ２ = 0 );
			if( $w:武器 == d:武器:マイク){
				eval( $w:武器 = d:武器:素手 )	//増員音声が聞こえるように
			}
		}
	}

	proc 増員兵スタート {


		if(!$f:ローカルフラグ２ && `%ゲームオーバーチェック` == 0){

			chara delay 増員ゲームオーバーチェックディレイ -time 1 -exec{
				if(`%ゲームオーバーチェック` == 0){
					return 1
				}else{
					chara カメラ設定 モーションカメラ -s -1
					mesg シネマスクリーン シネマ フェードイン 0
					mesg delay 増員ディレイ kill
					return 0
				}
			}


			mesg 警備兵 敵兵:01 ルート変更 d:警備兵巡回ルート１＿２ 9000 -8500 -62000 人質部屋

#if d:ダークゾーン出し入れ
			print 'ダークゾーン発生！！！'
			command トラップ切り替え \
				-trap dark \
				-switch 1
#endif

			//敵兵視界さえぎり
			command 追加ＨＺＸグループ登録 \
				-hzx_id 0 \
				-add_id 1

			if($b:増員敵兵ナンバー == 0){
				print '敵兵:02スタート！！！！'
				@増員実行 敵兵:02
				eval($b:増員敵兵ナンバー = 1)

			}else if($b:増員敵兵ナンバー == 1){
				print '敵兵:03スタート！！！！'
				@増員実行 敵兵:03
				eval($b:増員敵兵ナンバー = 2)

			}else if($b:増員敵兵ナンバー == 2){
				print '敵兵:04スタート！！！！'
				@増員実行 敵兵:04
				eval($b:増員敵兵ナンバー = 3)

			}else if($b:増員敵兵ナンバー == 3){
				print '敵兵:05スタート！！！！'
				@増員実行 敵兵:05
				eval($b:増員敵兵ナンバー = 4)
			}
		}

	}



	proc 増員実行 $:敵兵名前{

		@シナリオデモ開始処理

		chara delay 増員ディレイ -time 120 -arg $1 -exec{

			command ゲット敵兵座標 \
				敵兵:01 $i:敵兵Ｘ座標 $i:敵兵Ｙ座標 $i:敵兵Ｚ座標

			if($1 == 敵兵:02){

				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p -7004,-500,-56868 \
					-t $i:敵兵Ｘ座標,$i:敵兵Ｙ座標,$i:敵兵Ｚ座標 \
					-a 1000 \
					-i 0 -1 0 0 \
					-s 1

				chara delay 増員ディレイ -time 60 -exec{
					chara カメラ設定 モーションカメラ \
						-c 1 \
						-p -7004,-500,-56868 \
						-t -8120,-8500,-64378 \
						-a 200 \
						-i 3 -1 0 0  \
//						-i 4 -1 59 0  \
						-s 1
				}


				chara delay 増員ディレイ -time 120 -arg $1 -exec{
					print 'ドアオープン！！！！'
/*
					if($f:w24c_スタジオドア状態オープン == 0){
						eval($f:w24c_スタジオドア状態オープン = 1)
						mesg ドア スタジオドア open
					}
*/
					mesg 敵兵共通 $1 永久アンリアルＯＦＦ
					mesg 警備兵 $1 ルート変更 d:警備兵スタジオ脱出 9000 -8500 -62000 人質部屋
				}

			}else{

				chara delay 増員ディレイ -time 60 -exec{
					chara カメラ設定 モーションカメラ \
						-c 1 \
						-p -7004,-500,-56868 \
						-t -8120,-7000,-63000 \
						-a 200 \
						-i 2 -1 0 0  \
						-s 1
				}


				chara delay 増員ディレイ -time 60 -arg $1 -exec{
/*
					if($f:w24c_スタジオドア状態オープン == 0){
						eval($f:w24c_スタジオドア状態オープン = 1)
						print 'ドアオープン！！！！'
						mesg ドア スタジオドア open
					}
*/
					mesg 敵兵共通 $1 永久アンリアルＯＦＦ
					mesg 警備兵 $1 ルート変更 d:警備兵スタジオ脱出 9000 -8500 -62000 人質部屋
				}

			}

		}

	}


	proc あんたがエイムズ言い終わった {

		eval($f:w24c_エイムズに声かけ中 = 0)
		mesg delay あんたがエイムズ声かけディレイ kill

		if($f:エイムズペースメーカー判定ＯＫ){
			// 黒フェード
			if ( $w:アイテム == d:アイテム:ゴル兵制服 ) {
				preseek "r_plt4"
			} else {
				preseek "d036p03"
			}
			chara フェードインアウト 黒フェード \
				-c 0 0 0 255 \		//目標のＲＧＢα
				-t d:FADEOUT_TIME \		//変化完了までのフレーム数
				-p エイムズ発見１ポリゴンデモ１ロード
		}

	}







	proc 増員デモ終了 {
/*
		if($f:w24c_スタジオドア状態オープン == 1){
			eval($f:w24c_スタジオドア状態オープン = 0)
			print 'ドアクローズ！！！！'
			mesg ドア スタジオドア close
		}
*/
		chara delay 増員ディレイ -time 90 -exec{

			if(`%ゲームオーバーチェック` == 0){
				//敵兵視界さえぎり解除
				command 追加ＨＺＸグループ削除 \
					-hzx_id 0 \
					-add_id 1

				chara カメラ設定 モーションカメラ \
					-s -1

				@シナリオデモ終了処理

#if d:ダークゾーン出し入れ
				chara delay ディレイ -time 240 -exec{
					print 'ダークゾーン消滅！！！'
					command トラップ切り替え \
						-trap dark \
						-switch 0
				}
#endif
				mesg delay 増員ゲームオーバーチェックディレイ kill

				//eval($b:w24c_声かけ回数 = $b:w24c_声かけ回数 + 1)
				chara delay ディレイ -time 300 -exec{
					eval($f:w24c_警備兵増員中 = 0)
				}
			}
		}



	}
























//###################################################################################
//									セクハラ発言設定
//###################################################################################



	proc セクハラ発言設定 {

		//ＣＥＳＡ倫対策プレート！！！！！！

		command foreach -argc 7 -repeat 9 \
			-data { \
				{35_25_37_number,86_58_88_number,0,		100,1100,-8350,-57540} \		//ジェニファー
				{88_88_88_number,37_37_37_number,0,		100,-2100,-8350,-57540} \
				{86_58_88_number,35_25_37_number,1024,	100,-3500,-8350,-54000} \
				{23_42_84_number,23_42_84_number,0,		100,1100,-8350,-49540} \
				{35_25_37_number,35_25_37_number,0,		100,-2100,-8350,-49540} \

				{37_37_37_number,88_88_88_number,1024,	50,-8130,-7980,-56500} \		//演説台キャシー
				{37_37_37_number,88_88_88_number,2048,	50,-4650,-8290,-49155} \		//鉄骨キャシー
				{37_37_37_number,88_88_88_number,3072,	100,4490,-8500,-52750} \
				{37_37_37_number,88_88_88_number,3072,	100,4490,-8500,-58800} \
			} \
			-exec { \
				chara プットオブジェ ナンバープレート \
#ifndef JAPANESE
					-m $1 \
#else
					-m $2 \
#endif
					-r 0 $3 0 \
					-s 100,$4,100 \
					-p $5 $6 $7 \
					-l d:LT2_NAME
			}



		//セクハラ発言
		trap ca001 d:PLAYER \
			-mask 入る \
			-state d:TRP_STATE_SUBJECT \
			-key d:PAD_AL \
			-exec {

				if(!$f:w24c_エイムズに声かけ中){
					if( $w:武器 == d:武器:マイク){
						command ゲット人質ターゲット $s:人質名

						if($s:人質名 == ジェニファー){
							eval($f:w24c_エイムズに声かけ中 = 1)
							chara delay ジェニファー声かけディレイ -time (60*15) -exec{
								if($f:w24c_エイムズに声かけ中){
									@計測終わり
								}
							}

							if(`command StreamIsPlay` < 2){
								eval( $i:STREAM_ID = `%Stream t:vc121011 -p ジェニファーウエスト計測 -menustop`);
								print 'ライデン「８６」'
							}

						}else if($s:人質名 == キャシー１ || $s:人質名 == キャシー２ || $s:人質名 == キャシー３ || $s:人質名 == キャシー４ ){
							eval($f:w24c_エイムズに声かけ中 = 1)
							chara delay ジェニファー声かけディレイ -time (60*15) -exec{
								if($f:w24c_エイムズに声かけ中){
									@計測終わり
								}
							}

							if(`command StreamIsPlay` < 2){
								eval( $i:STREAM_ID = `%Stream t:vc121009 -p キャシーウエスト計測 -menustop`);
								print 'ライデン「８８」'
							}

						}


					}

				}

			}


	}



	proc ジェニファーウエスト計測 {
		if($1 == 0){
			%Stream t:vc121016 -p ジェニファーヒップ計測 -menustop
			print 'ライデン「５８」'
		}
	}


	proc ジェニファーヒップ計測 {
		if($1 == 0){
			eval( $i:STREAM_ID = `%Stream t:vc121009 -p 計測終わり -menustop`);
			print 'ライデン「８８」'
		}
	}





	proc キャシーウエスト計測 {
		if($1 == 0){
			eval( $i:STREAM_ID = `%Stream t:vc121009 -p キャシーヒップ計測 -menustop`);
			print 'ライデン「８８」'
		}
	}


	proc キャシーヒップ計測 {
		if($1 == 0){
			eval( $i:STREAM_ID = `%Stream t:vc121009 -p 計測終わり -menustop`);
			print 'ライデン「８８」'
		}
	}



	proc 計測終わり {
		mesg delay ジェニファー声かけディレイ kill
		eval($f:w24c_エイムズに声かけ中 = 0)
	}









//###################################################################################
//							人質パンツ見え判定（ＣＥＳＡ倫どうなの？）
//###################################################################################

	proc パンツ見え判定 {

		print 'panty_judgement'
		print '人質パンツ見え判定'

		eval($f:w24c_ギャルパンツ撮影した = 0)
		eval($f:w24c_ギャルパンツ見えた = 0)
		eval($b:デジカメ装備カウンター = 0)


		trap ev007 d:PLAYER \
			-mask いる \
			-exec {
				if($w:アイテム == d:アイテム:デジカメ){
					if($b:デジカメ装備カウンター < 120){
						eval($b:デジカメ装備カウンター = $b:デジカメ装備カウンター + 1)
					}
				}else{
					eval($b:デジカメ装備カウンター = 0)
				}
			}

		trap ev007 d:PLAYER \
			-mask いる \
			-dir 2048,256 \
			-exec {

				command ゲット人質状態 ジェニファー $i:人質状態
				if($i:人質状態 & d:NPC_ACT_STATUS_OPEN_SKIRT){
					print '御開帳！！！！！！'
				}

				if(`%カメラ視界チェック -camera 0x03 -pos 1000,-8500,-57500` \
				&& ($i:人質状態 & d:NPC_ACT_STATUS_OPEN_SKIRT) ){
					print 'パンツ見えてまっせ！！！'

					eval($f:w24c_ギャルパンツ見えた = 1)
					eval($f:w24c_ギャルパンツ見えてる = 1)

					if(! $f:w24c_ギャルパンツ撮影した && $b:デジカメ装備カウンター > 30){
						command パッドチェック -which 0 -direct -press
						if( $status & (d:PAD_X | d:PAD_Y)){

							print 'パンチラゲッチュー！！！'
							eval($f:w24c_ギャルパンツ撮影した = 1)
						}
					}

				}else{
					print 'パンツ見えない！！！！！'
					eval($f:w24c_ギャルパンツ見えてる = 0)
				}

			}



	}



















