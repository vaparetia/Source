			print 'w24c_wall_set'
		#endif


		chara 天井君 人質部屋南壁 -m d:WALL_NAME -c 0,0,-46250 -a 5 -p 0,0,0 -l d:LT2_NAME
	}














//###################################################################################
//									カメラ設定
//###################################################################################



	proc カメラセット {
		#if d:DEBUG_PRINT
			print 'stage_camera_set'
		#endif

		chara カメラ ステージカメラ		-c 0 -l 3 -p 0
		chara カメラ サブカメラ１		-c 0 -l 2 -p 50
		chara カメラ サブカメラ２		-c 0 -l 2 -p 40
		chara カメラ モーションカメラ	-c 0 -l 2 -p 30
		chara カメラ カットインカメラ	-c 0 -l 0 -p 40

		// デフォルトカメラ
		chara カメラ設定 ステージカメラ \
			-c 0 \
			-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
			-r 750,2048,0 \
			-f 6500 \
			-a 200 \
			-i 2 2 0 0 \
			-s 1
	}




	proc 人質部屋カメラ設定 {
		#if d:DEBUG_PRINT
			print 'w24c_camera_set'
		#endif

#if 1
		eval($w:人質部屋カメラ制御率 = 30)
		eval($w:パッド操作カウンタ = 0)





//１Ｆ全体
		trap ca001 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {


				//if(($w:アイテム != d:アイテム:ゴル兵制服 && $s:登場ポイント != ゲームオーバーデモ) || $w:体力 <= 0 ){
				if($w:体力 <= 0 ){

					chara カメラ設定 サブカメラ１ \
						-c 0 \
						-b d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,-2000,-41407 \
						-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,-47500 \
						-r 480,2048,0 \
						-f 8000 \
						-a 350 \
						-i 3 -1 0 0 \
						-s $3 \

				}else{

					command ゲット敵兵状態 \
						敵兵:01 $i:敵兵状態
/*
					($i:敵兵状態 & 0x80000000) == 0
					0x80000000	//死亡
					でない。
*/


					if(($i:敵兵状態 & 0x80000000) == 0){

//比率目標値の設定（ライデンと敵兵の中間ポイントどの辺を注視するかを決定）

						//ライデンが画面に映ってない場合は敵兵影響比率を小さく
						if(`%カメラ視界チェック -camera 0x03 -pos ($i:プレイヤー位置Ｘ - 1000),$i:プレイヤー位置Ｙ,$i:プレイヤー位置Ｚ` == 0 \
							|| `%カメラ視界チェック -camera 0x03 -pos ($i:プレイヤー位置Ｘ + 1000),$i:プレイヤー位置Ｙ,$i:プレイヤー位置Ｚ` == 0){

							eval($w:比率目標値 = 200)

						}

						if(`%カメラ視界チェック -camera 0x03 -pos $i:プレイヤー位置Ｘ,($i:プレイヤー位置Ｙ + 1000),$i:プレイヤー位置Ｚ` == 0 \
						){
							eval($w:比率目標値 = 200)
						}




						//ライデンが画面に結構映っている場合は敵兵影響比率を大きく
						if(`%カメラ視界チェック -camera 0x03 -pos ($i:プレイヤー位置Ｘ - 3000),$i:プレイヤー位置Ｙ,$i:プレイヤー位置Ｚ` == 1 \
							&& `%カメラ視界チェック -camera 0x03 -pos ($i:プレイヤー位置Ｘ + 3000),$i:プレイヤー位置Ｙ,$i:プレイヤー位置Ｚ` == 1){
							if(`%カメラ視界チェック -camera 0x03 -pos $i:プレイヤー位置Ｘ,($i:プレイヤー位置Ｙ + 500),$i:プレイヤー位置Ｚ` == 1){

								eval($w:比率目標値 = 300)

							}
						}


						//ライデンが左右端にいるときは影響率を０に
						if($4 > 4500){
							@CS_スムーズカメラ昇順 $4 4500 7000 200 0
							eval($w:比率目標値 = $i:CS_結果１);
						}else if($4 < -9000){
							@CS_スムーズカメラ昇順 $4 -11000 -9000 0 200
							eval($w:比率目標値 = $i:CS_結果１);
						}


						//一定時間パッド操作がされてなかったらカメラをライデンに戻す。
						command パッドチェック -which 0 -status
						if($status & (d:PAD_U | d:PAD_D | d:PAD_L | d:PAD_R)){
							eval($w:パッド操作カウンタ = 0)

						}else if($w:パッド操作カウンタ < 300 ){
							eval($w:パッド操作カウンタ = $w:パッド操作カウンタ + 1)

						}else{
							eval($w:比率目標値 = 0)

						}

//比率目標値の設定ここまで（ライデンと敵兵の中間ポイントどの辺を注視するかを決定）


						//print '$w:比率目標値'$w:比率目標値



						//カメラ制御率の変化
						if($w:人質部屋カメラ制御率 < $w:比率目標値){
							eval($w:人質部屋カメラ制御率 = $w:人質部屋カメラ制御率 + 1)

						}else if($w:人質部屋カメラ制御率 > $w:比率目標値){
							eval($w:人質部屋カメラ制御率 = $w:人質部屋カメラ制御率 - 1)

						}



						//print '$w:人質部屋カメラ制御率='$w:人質部屋カメラ制御率

						command ゲット敵兵座標 \
							敵兵:01 $i:敵兵１位置Ｘ $i:敵兵１位置Ｙ $i:敵兵１位置Ｚ

						//敵兵とライデンからカメラのターゲットを決定
						eval($i:補完ＴＸ = (($i:敵兵１位置Ｘ * $w:人質部屋カメラ制御率) + ($i:プレイヤー位置Ｘ * (1000 - $w:人質部屋カメラ制御率) ))/1000 )
						eval($i:補完ＴＺ = (($i:敵兵１位置Ｚ * $w:人質部屋カメラ制御率 / 5) + ($i:プレイヤー位置Ｚ * (1000 - ($w:人質部屋カメラ制御率 / 5)) ))/1000 )

					}else{
						eval( $i:補完ＴＸ = $i:プレイヤー位置Ｘ )
						eval( $i:補完ＴＺ = $i:プレイヤー位置Ｚ )

					}

					eval( $i:補完ＰＹ = -2000 );

					//バウンド切り
					if($i:補完ＴＸ > 5500){
						eval( $i:補完ＴＸ = 5500 )

					}else if($i:補完ＴＸ < -8900){
						eval( $i:補完ＴＸ = -8900 )
					}


					//右側
					if($i:補完ＴＸ > 4000 && $i:補完ＴＺ < -51500){
						@CS_スムーズカメラ昇順 $i:補完ＴＸ 4000 5000 -2000 -4500
						eval( $i:補完ＰＹ = $i:CS_結果１ );

						if($i:補完ＴＺ > -52500){
							@CS_スムーズカメラ昇順 $i:補完ＴＺ -52500 -51500 $i:補完ＰＹ -2000
							eval( $i:補完ＰＹ = $i:CS_結果１ );

						}


					}else if($4 < -6000){
						@CS_スムーズカメラ昇順 $4 -7000 -6000 1000 -2000
						eval( $i:補完ＰＹ = $i:CS_結果１ );
					}



					@CS_スムーズカメラ昇順 $4 -6000 -5000 -50000 -49000
					eval( $i:補完ＰＹ限界値 = $i:CS_結果１ );

					if($i:補完ＴＺ > $i:補完ＰＹ限界値){
						eval( $i:補完ＴＺ = $i:補完ＰＹ限界値 )
					}



					eval($i:補完ＰＺ = $i:プレイヤー位置Ｚ + 6000)
					if($i:補完ＰＺ > -43000){
						eval($i:補完ＰＺ = -43000)
					}


					chara カメラ設定 サブカメラ１ \
						-c 1 \
						-p $i:補完ＴＸ,$i:補完ＰＹ,$i:補完ＰＺ \
//						-t $i:補完ＴＸ,-7500,$i:補完ＴＺ \
						-t $i:補完ＴＸ,$5,$i:補完ＴＺ \
						-a 250 \
						-i 1 -1 0 0 \
						-s $3 \

				}

			}

#else
		// 全体
		trap ca001 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {
				@CS_スムーズカメラ昇順 $5 -6000 -5000 -10250 1000
				eval( $i:補完ＢＸ = $i:CS_結果１ );
				eval( $i:補完ＬＸ = $i:CS_結果１ );

				@CS_スムーズカメラ昇順 $5 -7000 -6000 470 150
				eval( $i:補完ＲＸ = $i:CS_結果１ );

				chara カメラ設定 サブカメラ１ \
					-c 0 \
					-b $i:補完ＢＸ,-1500 -62000 4500,d:CAM_MAX,-43000 \
					-l $i:補完ＬＸ,d:CAM_MIN,-66000 4500,d:CAM_MAX,-48000 \
					-r $i:補完ＲＸ,2048,0 \
					-f 8000 \
					-a 200 \
					-i 1 -1 0 0 \
					-z d:CAMERA_NO_CUSHION \
					-s $3 \
			}
#endif

		//右側隅
		trap ca004 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {

				chara カメラ設定 サブカメラ２ \
					-c 1 \
					-p 5366,-4620,-46930 \
					-t $4,$5,$6 \
					-a 264 \
					-i 3 3 0 0 \
					-s $3 \

			}


/*


		//やぐらの陰になるところ。
		trap ca005 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {

				chara カメラ設定 サブカメラ２ \
					-c 0 \
					-b d:CAM_MIN,-4500,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,d:CAM_MAX \
					-l d:CAM_MIN,d:CAM_MIN,d:CAM_MIN d:CAM_MAX,d:CAM_MAX,-45000 \
					-r 240,2048,0 \
					-f 9500 \
					-a 200 \
					-i 3 -1 0 0 \
					-s $3

			}
*/


		//南側壁はりつき
		trap ca008 d:PLAYER \
			-mask ？ \
			-camera \
			-state d:TRP_STATE_BEHINDCAMERA_ENABLE \
			-dir 2048,256 \
			-exec {

				chara カメラ設定 サブカメラ２ \
					-c 1 \
					-p $4,1540,-46470 \
					-t $4,-8460,-49270 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3

			}

		//階段東側
		trap ca009 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {

				chara カメラ設定 サブカメラ２ \
					-c 1 \
					-p 4428,-856,-57174 \
					-t 4472,-5215,-60796 \
					-a 179 \
					-i 3 3 0 0 \
					-s $3

			}


		//ステージ上
		trap ca006 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {

				@CS_スムーズカメラ昇順 $6 -58500 -50500 -8997 -8414
				eval( $i:補完ＰＸ = $i:CS_結果１ );

				@CS_スムーズカメラ昇順 $6 -58500 -50500 -263 -2820
				eval( $i:補完ＰＹ = $i:CS_結果１ );

				@CS_スムーズカメラ昇順 $6 -58500 -50500 -47736 -45014
				eval( $i:補完ＰＺ = $i:CS_結果１ );

				@CS_スムーズカメラ昇順 $6 -58500 -50500 -10337 -9772
				eval( $i:補完ＴＸ = $i:CS_結果１ );

				@CS_スムーズカメラ昇順 $6 -58500 -50500 -5986 -8680
				eval( $i:補完ＴＹ = $i:CS_結果１ );

				@CS_スムーズカメラ昇順 $6 -58500 -50500 -54581 -51734
				eval( $i:補完ＴＺ = $i:CS_結果１ );

				@CS_スムーズカメラ昇順 $6 -58500 -50500 245 200
				eval( $w:補完画角 = $i:CS_結果１ );


				chara カメラ設定 サブカメラ２ \
					-c 1 \
					-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ \
					-t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ \
					-a $w:補完画角 \
					-i 3 3 0 0 \
					-s $3 \

			}


		//北側便所そば
		trap ca007 d:PLAYER \
			-mask ？ \
			-camera \
			-exec {

				chara カメラ設定 サブカメラ２ \
					-c 1 \
					-p -11682,-3885,-60783 \
					-t -11569,-13399,-64654 \
					-a 175 \
					-i 0 0 0 0 \
					-s $3 \

			}





		//階段付近
		trap ca003 d:PLAYER \
			-mask ＊ \
			-camera \
			-exec {

				//階段以北
				if($4 < 1000){


					@CS_スムーズカメラ昇順 $6 -66250 -64500 -56 558
					eval( $i:補完ＰＸ = $i:CS_結果１ );

					@CS_スムーズカメラ昇順 $6 -66250 -64500 -1994 597
					eval( $i:補完ＰＹ = $i:CS_結果１ );

					@CS_スムーズカメラ昇順 $6 -66250 -64500 -60546 -61783
					eval( $i:補完ＰＺ = $i:CS_結果１ );

					@CS_スムーズカメラ昇順 $6 -66250 -64500 1 303
					eval( $i:補完ＴＸ = $i:CS_結果１ );

					@CS_スムーズカメラ昇順 $6 -66250 -64500 -3910 -4605
					eval( $i:補完ＴＹ = $i:CS_結果１ );

					@CS_スムーズカメラ昇順 $6 -66250 -64500 -65877 -64047
					eval( $i:補完ＴＺ = $i:CS_結果１ );

					@CS_スムーズカメラ昇順 $6 -66250 -64500 188 130
					eval( $w:補完画角 = $i:CS_結果１ );


				//階段
				}else if($4 <= 5000){

					@CS_スムーズカメラ昇順 $4 1000 5000 558 2549
					eval( $i:補完ＰＸ = $i:CS_結果１ );

					@CS_スムーズカメラ昇順 $4 1000 5000 597 627
					eval( $i:補完ＰＹ = $i:CS_結果１ );

					@CS_スムーズカメラ昇順 $4 1000 5000 -61783 -60938
					eval( $i:補完ＰＺ = $i:CS_結果１ );

					@CS_スムーズカメラ昇順 $4 1000 5000 303 2339
					eval( $i:補完ＴＸ = $i:CS_結果１ );

					@CS_スムーズカメラ昇順 $4 1000 5000 -4605 -4562
					eval( $i:補完ＴＹ = $i:CS_結果１ );

					@CS_スムーズカメラ昇順 $4 1000 5000 -64047 -63210
					eval( $i:補完ＴＺ = $i:CS_結果１ );

					@CS_スムーズカメラ昇順 $4 1000 5000 130 200
					eval( $w:補完画角 = $i:CS_結果１ );

				}

				chara カメラ設定 サブカメラ２ \
					-c 1 \
					-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ \
					-t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ \
					-a $w:補完画角 \
					-i 2 -1 0 0 \
					-s $3 \

			}



		//階段南側張り付き
		trap ca003 d:PLAYER \
			-mask ？ \
			-dir 2048,256 \
			-state d:TRP_STATE_BEHINDCAMERA_ENABLE \
			-camera \
			-exec {

				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p 1559,2986,-61792 \
					-t 1557,-2673,-62105 \
					-a 197 \
					-i 1 -1 0 0 \
					-s $3 \

			}


	}







//###################################################################################
//									１ｍジャンプ設定
//###################################################################################

	proc １ｍジャンプ設定 {
		print '１ｍジャンプ設定'


		command プラグイン自動ジャンプ


		trap ky000 d:PLAYER \
			-mask 入る \
			-exec {
				@ジャンプ発動 ky000 1000 50
			}

		if($s:登場ポイント != ゲームオーバーデモ){
			trap ky001 d:PLAYER \
				-mask 入る \
				-exec {
					@ジャンプ発動 ky001 1000 50
				}
		}

		//ジャンプ中カメラ
		trap ky000 d:PLAYER \
			-mask ？ \
			-state d:TRP_STATE_FORCE \
			-camera \
			-exec {

				@CS_スムーズカメラ昇順 $6 -57500 -51500 -7503 -7657
				eval( $i:補完ＰＸ = $i:CS_結果１ );

				@CS_スムーズカメラ昇順 $6 -57500 -51500 -4527 -4277
				eval( $i:補完ＰＹ = $i:CS_結果１ );

				@CS_スムーズカメラ昇順 $6 -57500 -51500 -53063 -48584
				eval( $i:補完ＰＺ = $i:CS_結果１ );

				@CS_スムーズカメラ昇順 $6 -57500 -51500 -8413 -8551
				eval( $i:補完ＴＸ = $i:CS_結果１ );

				@CS_スムーズカメラ昇順 $6 -57500 -51500 -7557 -7313
				eval( $i:補完ＴＹ = $i:CS_結果１ );

				@CS_スムーズカメラ昇順 $6 -57500 -51500 -56775 -52295
				eval( $i:補完ＴＺ = $i:CS_結果１ );


				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ \
					-t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ \
					-a 200 \
					-i 0 -1 0 0 \
					-s $3 \

			}

	}















