// マップ設定
// ------------------------------------

	//オセロット用モニター画面(w24c1_disp_on),スタジオ窓ガラス（win_01）ＯＮ／ＯＦＦ
	if($s:登場ポイント == 盗聴イベント || $s:登場ポイント == オセロット接近イベント){
		chara マップ 人質部屋 -k d:KMS_NAME0 -k d:KMS_NAME1 -k w24c1_roof -k w24c1_disp_on -k win_02 -h d:HZX_NAME,0 -l d:LT2_NAME
	}else{
		chara マップ 人質部屋 -k d:KMS_NAME0 -k d:KMS_NAME1 -k w24c1_roof -k w24c1_disp_off -k win_01 -h d:HZX_NAME,0 -l d:LT2_NAME
	}



	command マップ設定 人質部屋 -set {

	#if d:SOUND
		@サウンド設定	// データは最初に呼ぶ
	#endif
		@レーダーオンオフチェック $f:w24b_ノードフラグ		//常駐キャラより先に呼ぶ
		@常駐キャラ設定
		@ローカル変数初期化
		@設定値変更
		@プレイヤー設定
	#if d:ENEMY
		if($s:登場ポイント == ゲームオーバーデモ){
			@ゲームオーバー用敵兵設定

		}else if($s:登場ポイント == 盗聴イベント){
		}else if($s:登場ポイント == オセロット接近イベント){
			@コマンダー設定
		}else{
			@コマンダー設定
		}
	#endif
	#if d:DOLL
		@人質コマンダー設定
		@人質設定
		@デッドセル設定
	#endif
		if($s:登場ポイント == 盗聴イベント){
			@盗聴イベント用トラップ配置
		}else if($s:登場ポイント == オセロット接近イベント){
			@オセロット接近イベントトラップ設置
			#if d:TIMER
				@オセロット接近タイマー設定
			#endif
		}
	#if d:BGM
		@ＢＧＭ設定			// プレイヤー→敵兵→BGMの順で呼ぶ
	#endif
	#if d:SLIDE_DOOR
		@ドア設置
	#endif
	#if d:LOAD_TRAP
		@ロード設定
	#endif
	#if d:FOG
		@フォグ設定
	#endif
	#if d:EFFECT
		@エフェクト設定
	#endif
	#if d:XFADE
		@照明きらめき設定		//w24c_common.hにある
	#endif
	#if d:SHADOW
		@影設定					//w24c_common.hにある
	#endif
	#if d:DEFORCUS
		@ぼかし設定
	#endif
		@カメラセット

		if($s:登場ポイント != 盗聴イベント && $s:登場ポイント != オセロット接近イベント){
			#if d:ITEM
				@アイテム設置
			#endif
			#if d:LOAD_MODEL
				@ロードモデル設置
			#endif
			@人質部屋カメラ設定
			#if d:JP_MOTION
				@１ｍジャンプ設定
			#endif
			#if d:PMAKER_JUDGE
				@エイムズペースメーカー判定
			#endif
			#if d:GLASS_BULLETHOLE
				@ガラス弾痕設定
			#endif
			#if d:セクハラ発言
				@セクハラ発言設定
				@パンツ見え判定
				@ジョニーの便所におい設定
			#endif
		}
	#if d:CHARA_CEIL
		@人質部屋天井設置
		@人質部屋南壁設置
	#endif
	#if d:FLAG
		@米国旗設定		//w24c_common.hにある
	#endif
	#if d:BREAKABLE
		//@壊れ物設置		//w24c_common.hにある
		if($s:登場ポイント != 盗聴イベント){
			@壊れ物パーティー台		//w24c_common.hにある
		}
		@壊れ物演説台		//w24c_common.hにある
	#endif
	#if d:CHARA_LIGHT
		@キャラ用ライト設置		// マップ設定の最後に呼ぶ
	#endif
	#if d:DEBUG_CHARA
		@デバッグキャラセット
	#endif
		@プラント編全体マップ設定 d:シェル１中央棟マップ	// stdproc.hで定義
		//@ポーズ時ステージ名表示設定 d:wn_シェル１中央棟Ｂ１集会場

	}


// 無線用include ※位置は動かさないこと
#include "w24c_cdc.ch"


	// 全てのセットが終わったところでフェードイン
		// シェル１中央棟Ｂ１から
		//初期マップの表示
		command マップ表示 -show 人質部屋

	// 全てのセットが終わったところでフェードイン
	@人質部屋進入時処理





















// 各proc設定
//-------------------------------------------------------------------------------------
// 全マップ共通






//###################################################################################
//									変数初期化設定
//###################################################################################

	// ローカル変数初期化
	// ------------------------------------
	proc ローカル変数初期化 {
		#if d:DEBUG_PRINT
			print 'localvar_init'
		#endif

	}

	// 設定値を変更
	// ------------------------------------
	proc 設定値変更 {
		#if d:DEBUG_PRINT
			print 'status_set'
		#endif

		eval($f:w24c_スタジオドア状態オープン = 0)
		eval($f:w24c_ゲームオーバー終了処理呼ばれてます = 0)
		eval($f:w24c_キャシーおしっこした = 0)
		eval($f:w24c_人質１１おしっこした = 0)
		eval($f:w24c_人質２５おしっこした = 0)
		eval($b:臭いトラップ発動回数 = 0);

		if($s:登場ポイント == 人質部屋侵入デモ後スタート){
			command 装備メニュー制御 \
				-mic_mode 1		//$b:マイク説明状態（１で拡張説明を有効に）
			eval($w:武器 = d:武器:ＡＫＳ)

		}else if($s:登場ポイント == 盗聴イベント){
			eval($w:武器弾数Ｒ[d:武器:マイク] = 0)
			eval($w:武器弾数Ｒ[d:武器:特殊マイク] = 1)
			eval($w:武器 = d:武器:特殊マイク)
			//eval($w:アイテム = d:アイテム:素手)

		}else if($s:登場ポイント == オセロット接近イベント){
			eval($w:武器弾数Ｒ[d:武器:マイク] = 1)
			eval($w:武器弾数Ｒ[d:武器:特殊マイク] = 0)
			eval( $w:武器 = d:武器:素手 )

			eval($w:体力 = 1)

			command 装備メニュー制御 \
				-mic_mode 0		//$b:マイク説明状態（１で拡張説明を有効に）


		}else if($s:登場ポイント == ゲームオーバーデモ && $w:体力 > 7){
			eval($w:体力 = 7)
		}else{
			command 装備メニュー制御 \
				-mic_mode 1		//$b:マイク説明状態（１で拡張説明を有効に）

		}


	}
























//###################################################################################
//									ロード入場
//###################################################################################

	proc 人質部屋進入時処理 {

		if($s:登場ポイント == 人質部屋侵入デモ後スタート){

			if( ($w:武器弾数Ｒ[d:武器:マイク] >= 0  && !$f:rfp_w24c_人質イベント説明＿マイクありＣＡＬＬした) \
			|| ( $w:武器弾数Ｒ[d:武器:マイク] < 0  && !$f:rfp_w24c_人質イベント説明＿マイクなしＣＡＬＬした) ){
				eval($f:ロードチェックＯＮフラグ = 1);
				command パッド操作 -release

				chara フェードインアウト フェードイン \
					-i 0,0,0 128 \
					-c 0,0,0 0 \
					-t d:FADEIN_TIME \
					-p rp_人質部屋入った時のＣＡＬＬ

			}else{

				eval($f:ロードチェックＯＮフラグ = 1);
				@ロード時フェードイン

			}

		}else if($s:登場ポイント == ゲームオーバーデモ){
			@ゲームオーバー進入時処理

		}else if($s:登場ポイント == 盗聴イベント){
			chara フェードインアウト フェードイン \
				-i 0,0,0 128 \
				-c 0,0,0 0 \
				-t d:FADEIN_TIME

			eval($w:p_story = d:ST:P040_04_I04エイムズ発見４インタラクティブ主観デモ１開始)
			print '$w:p_story = d:ST:P040_04_I04エイムズ発見４インタラクティブ主観デモ１開始'

			@盗聴イベント処理開始

		}else if($s:登場ポイント == オセロット接近イベント){
			@ロード時フェードイン

			eval($w:p_story = d:ST:P040_08_G01エイムズ発見８ゲーム１開始)
			print '$w:p_story = d:ST:P040_08_G01エイムズ発見８ゲーム１開始'

			command メニュー設定 -gage off  -radar off

			@オセロット接近イベント開始

		}else{
			@ステージ開始時処理（ステージ名表示） \
				d:LOAD_TYPE:SL_DOOR_TYPE 人質部屋ドア 2000 d:DEFAULT_M_TYPE \
				d:wn_シェル１中央棟Ｂ１集会場

		}

	}






//###################################################################################
//									ロード退場
//###################################################################################


	proc ロードプロック {
		#if d:DEBUG_PRINT
			print 'load_proc'
		#endif

		if ($s:呼び出しプロック == mv_w24c_w24b_1) {
			// １Ｆへ
			command セットサウンドコード -c d:SNG_FOUTS_S
			@mv_w24c_w24b_1
		}
	}

	proc ロード設定 {
		#if d:DEBUG_PRINT
			print 'load_set'
		#endif

		trap ld001 d:PLAYER \
			-mask 入る \
			-exec {
				if(`%ゲームオーバーチェック` == 0 && $f:ロードチェックＯＮフラグ){
					// ｗ２４ｂへ
					preseek 'w24b'
					@ステージ終了時処理（ステージ名表示） -2250 -4500 -66250 3072 mv_w24c_w24b_1 d:DEFAULT_M_TYPE d:wn_シェル１中央棟Ｂ１
				}
			}
	}






//###################################################################################
//									プレイヤー設定
//###################################################################################


	proc プレイヤー設定 {
		#if d:DEBUG_PRINT
			print 'player_set'
		#endif


		if( $s:登場ポイント == オセロット接近イベント ){
			eval( $b:プレイヤー初期状態 = 1 )
		}else{
			eval( $b:プレイヤー初期状態 = 0 )
		}

		command	ゴルキャップあり

		chara プレイヤー d:PLAYER \
			-p $i:プレイヤー初期Ｘ位置,$i:プレイヤー初期Ｙ位置,$i:プレイヤー初期Ｚ位置 \
			-d 0,$i:プレイヤー初期方向,0 \
			-s 0 \
			-m rai_def -a raiden -o rai_w24c

		@ライデン髪の毛設定 d:NORMAL_HAIR



		if($s:登場ポイント == オセロット接近イベント){
			@プレイヤーＬＯＤ設定 d:C_DISTANCE_TYPE 10000
		}else{
			@プレイヤーＬＯＤ設定 d:C_DISTANCE_TYPE 6000
			//@プレイヤーＬＯＤ設定 d:P_STATE_TYPE d:TRP_STATE_BEHIND
		}


	}












//###################################################################################
//										敵兵設定
//###################################################################################


#define		警備兵巡回ルート１		1
#define		警備兵巡回ルート１＿２	110
#define		警備兵巡回ルート２		83
#define		警備兵巡回ルート３		82
#define		警備兵巡回ルート４		81
#define		警備兵巡回ルート５		84
#define		警備兵巡回ルート６		85
#define		警備兵スタジオ待機		75
#define		警備兵スタジオ脱出		76
#define		警備兵増員連絡１		77
#define		警備兵増員連絡２		78
#define		警備兵増員連絡３		79
#define		警備兵増員連絡４		80
#define		攻撃兵階段上待機１		58
#define		攻撃兵階段上待機２		59
#define		攻撃兵階段上待機３		60
#define		攻撃兵階段上待機４		61
#define		攻撃兵スタジオ待機１	6
#define		攻撃兵スタジオ待機２	7
#define		攻撃兵スタジオ待機３	8
#define		攻撃兵スタジオ待機４	9
#define		ライデン取り囲み１		86
#define		ライデン取り囲み２		87
#define		ライデン取り囲み３		88
#define		ライデン取り囲み４		89

#define		ライデ	0x03000000

	proc 警備兵０ {
		#if d:DEBUG_PRINT
			print 'watcher_set'
		#endif

		if($s:登場ポイント == オセロット接近イベント){
			command foreach -argc 2 -repeat 4 \
				-data { \
					{敵兵:11,d:攻撃兵スタジオ待機１}\
					{敵兵:12,d:攻撃兵スタジオ待機２}\
					{敵兵:13,d:攻撃兵スタジオ待機３}\
					{敵兵:14,d:攻撃兵スタジオ待機４}\
				} \
				-exec { \

					chara 警備兵 $1 \
						-r $2 -n 0 -d 10250,-8500,-65000 人質部屋 \
						-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力 \
						-l $w:敵標準体力 -h $w:敵標準聴力 -f $w:敵標準気絶 -v 1 \
						-s d:ENE_STATUS_ENDLES_CHASE

				}

		}else{

			eval($i:ローカル変数Ｉ１ = 0);

#ifdef JAPANESE
			if($w:ゲーム設定 <= d:LEVEL_EASY){
				eval( $i:ローカル変数Ｉ１ = (d:ENE_STATUS_ENDLES_CHASE | d:ENE_STATUS_REPORT | d:ENE_STATUS_TALK_SLEEP) );
			}else{
				eval( $i:ローカル変数Ｉ１ = (d:ENE_STATUS_ENDLES_CHASE | d:ENE_STATUS_BIG_SNORE | d:ENE_STATUS_REPORT|d:ENE_STATUS_TALK_SLEEP) );
			}
#else
			eval( $i:ローカル変数Ｉ１ = (d:ENE_STATUS_ENDLES_CHASE | d:ENE_STATUS_BIG_SNORE | d:ENE_STATUS_REPORT|d:ENE_STATUS_TALK_SLEEP) );
#endif

			command foreach -argc 3 -repeat 5 \
				-data { \
					{敵兵:01,d:警備兵巡回ルート１＿２,d:警備兵巡回ルート１＿２}\
					{敵兵:02,d:警備兵スタジオ待機,d:警備兵巡回ルート２}\
					{敵兵:03,d:警備兵スタジオ待機,d:警備兵巡回ルート３}\
					{敵兵:04,d:警備兵スタジオ待機,d:警備兵巡回ルート４}\
					{敵兵:05,d:警備兵スタジオ待機,d:警備兵巡回ルート５}\
				} \
				-exec { \

					if($w:ゲーム設定 <= d:LEVEL_NORMAL || ($w:ゲーム設定 == d:LEVEL_HARD && $1 != 敵兵:02)){
						eval( $b:警備兵初期ルート = $2 );
					}else{
						eval( $b:警備兵初期ルート = $3 );
					}

					chara 警備兵 $1 \
						-r $b:警備兵初期ルート -n 0 -d 10250,-8500,-65000 人質部屋 \
						-i $w:敵潜入視力,$w:敵危険視力,$w:敵回避視力  -v 1 \
						-l $w:敵標準体力 -h $w:敵標準聴力 -f $w:敵標準気絶 \
						-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
						-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
						-s $i:ローカル変数Ｉ１

					if(($w:ゲーム設定 <= d:LEVEL_NORMAL && $1 != 敵兵:01) \
					|| ($w:ゲーム設定 == d:LEVEL_HARD && $1 != 敵兵:01 && $1 != 敵兵:02)){
						mesg 敵兵共通 $1 永久アンリアルＯＮ
					}

				}

		}


	}


	proc 攻撃兵０ {
		#if d:DEBUG_PRINT
			print 'attacker_set'
		#endif
	}




	proc 警備兵コマンダー {
		#if d:DEBUG_PRINT
			print 'wccomm_set'
		#endif

		chara 警備コマンダー wccomm -e {警備兵０}
	}

	proc 攻撃兵コマンダー {
		#if d:DEBUG_PRINT
			print 'atcomm_set'
		#endif

		chara 攻撃コマンダー atcomm -e 攻撃兵０
	}





	resource ghq_area_alert_voice {
	w24c:
		$t{
			// PLAREA0 人質部屋全体
			t:vc040248,	//指揮官「了解。増援部隊をシェル１中央棟Ｂ１に派遣する！侵入者を逃がすな！」
			t:vc040249,	//指揮官「了解。応援部隊、シェル１中央棟Ｂ１に向かえ！敵を逃がすな！」
			-1 // PLAREA0の登録終了
		}
	}

	resource ghq_caution_voice {
	w24c:
		$t{
			// PLAREA0 人質部屋全体
			t:vc040403,	//指揮官「了解。シェル１中央棟Ｂ１を増員する。警戒を強化せよ」
			t:vc040404,	//指揮官「了解。シェル１中央棟Ｂ１に増員を送る。警備を強化せよ」
			-1 // PLAREA0の登録終了
		}
	}




	proc コマンダー設定 {
		#if d:DEBUG_PRINT
			print 'commander_set'
		#endif

		command 敵兵メモリーオールリセット

		chara コマンダー 敵兵セット \
			-w 警備兵コマンダー \
			//-a 攻撃兵コマンダー \
			-m d:ALERT_MODE_SENNYU \
			-r 4750,-8500,-70000 人質部屋 \
			-c 4750,-8500,-70000 人質部屋 \
			-s (d:ENE_STAGE_CROWD_PEOPLE | d:ENE_STAGE_NO_WC_GOVER) \
			-e	d:警備兵増員連絡１ 0 増員兵スタート前チェック \
				d:警備兵増員連絡２ 0 増員兵スタート前チェック \
				d:警備兵増員連絡３ 0 増員兵スタート前チェック \
				d:警備兵増員連絡４ 0 増員兵スタート前チェック \
				d:警備兵増員連絡１ 2 増員兵スタート \
				d:警備兵増員連絡２ 2 増員兵スタート \
				d:警備兵増員連絡３ 2 増員兵スタート \
				d:警備兵増員連絡４ 2 増員兵スタート \
			-v [ene_tank_voice:01] \
			-x [ghq_area_alert_voice:w24c] \
			-y [ghq_caution_voice:w24c] \
			-z $i:敵標準麻酔持続 \
			-o $i:敵標準気絶持続 \
			-b $w:敵標準再発生数 \
			-f	d:警備兵増員連絡１			2 t:vc041000 t:vc041000_len \
				d:警備兵増員連絡２			2 t:vc041000 t:vc041000_len \
				d:警備兵増員連絡３			2 t:vc041000 t:vc041000_len \
				d:警備兵増員連絡４			2 t:vc041000 t:vc041000_len \
				d:警備兵巡回ルート１		1 t:vc043201 t:vc043201_len \
				d:警備兵巡回ルート１		4 t:vc043201 t:vc043201_len \
				d:警備兵巡回ルート１		8 t:vc043201 t:vc043201_len \
				d:警備兵巡回ルート１		10 t:vc043201 t:vc043201_len \
				d:警備兵巡回ルート１		13 t:vc043201 t:vc043201_len \
				d:警備兵巡回ルート１		18 t:vc043201 t:vc043201_len \
				d:警備兵巡回ルート１＿２	4 t:vc043201 t:vc043201_len \
				d:警備兵巡回ルート１＿２	12 t:vc043201 t:vc043201_len \
				d:警備兵巡回ルート１＿２	28 t:vc043201 t:vc043201_len \
				d:警備兵巡回ルート１＿２	38 t:vc043201 t:vc043201_len \
				d:警備兵巡回ルート１＿２	55 t:vc043201 t:vc043201_len



	}































//###################################################################################
//									サウンド設定
//###################################################################################



	proc サウンド設定 {
		#if d:DEBUG_PRINT
			print 'sound_set'
		#endif

		chara サウンドマネージャー ＳＤマネ -pak 0
	}


	// ＢＧＭ
	// ------------------------------------
	proc ＢＧＭ設定 {
		#if d:DEBUG_PRINT
			print 'bgm_set'
		#endif

		//ここはゲームオーバーデモのために特殊
		if($s:登場ポイント == 盗聴イベント){
		}else if($s:登場ポイント == オセロット接近イベント){
			chara ＢＧＭマネージャー ＢＧＭマネ
		}else{
			command セットサウンドコード -c d:SNG_PLAY_05
		}


		//服装によってＢＧＭ変化
		trap ca001 d:PLAYER \
			-mask ？ \
			-item d:アイテム:ゴル兵制服 \
			-exec {
				if($3 == 入る){
					print 'ゴル兵ＢＧＭにチェンジ！！！'
					command セットサウンドコード -c d:SD_AUTO_FADER2
				}else{
					print '普通ＢＧＭにチェンジ！！！'
					command セットサウンドコード -c d:SD_AUTO_FADER1
				}
			}


		@サウンド効果音設定

	}











//###################################################################################
//										ドア設置
//###################################################################################


	proc ドア設置 {
		#if d:DEBUG_PRINT
			print 'ドア設置'
			print 'slide_door_set'
		#endif

		chara ドア 人質部屋ドア \
			-m d:DOOR_NAME_LOAD \
			-d 0,3072,0 \
			-p -1325,-4500,-67000 \
			-slide d:SD_SLIDE_INSIDE \
			-time d:SD_OPEN_TIME \
			-between 人質部屋 人質部屋 \
			-exec {
				if( $:開閉フラグ == 0 ){
					mesg プットオブジェ ロードマップ off
				} else {
					mesg プットオブジェ ロードマップ on
				}
			}


		@主観禁止壁 主観禁止壁君 -1325 -4500 -67000 3072 d:SD_SLIDE_INSIDE		//stdproc.h

		if($s:登場ポイント != ゲームオーバーデモ){
			trap dr001 ？ \
				-mask ？ \
				-exec {
					if($3==入る){
						mesg ドア 人質部屋ドア open
					}else{
						mesg ドア 人質部屋ドア close
					}
				}


			trap dr001 d:PLAYER \
				-mask ？ \
				-state d:TRP_STATE_SUBJECT \
				-exec {
					if($3==入る){
						mesg 透明壁 主観禁止壁君 on
					}else{
						mesg 透明壁 主観禁止壁君 off
					}
				}

		}



		//ここのドアの開閉については proc エイムズペースメーカー判定 の中にあります！！
		chara ドア スタジオドア \
			-m d:DOOR_NAME \
			-d 0,2048,0 \
			-p -9500,-8500,-63125 \
			-slide d:SD_SLIDE_INSIDE \
			-time d:SD_OPEN_TIME \
			-between 人質部屋 人質部屋 \
			-exec {
			}


		chara ドア スタジオ奥ドア \
			-m d:DOOR_NAME \
			-d 0,3072,0 \
			-p -1625,-8500,-66500 \
			-slide d:SD_SLIDE_INSIDE \
			-time d:SD_OPEN_TIME \
			-between 人質部屋 人質部屋 \
			-exec {
			}


		trap dr003 ？ \
			-mask ？ \
			-exec {
				if($3==入る){
					mesg ドア スタジオ奥ドア open
				}else{
					mesg ドア スタジオ奥ドア close
				}
			}




	}




//###################################################################################
//									アイテム設置
//###################################################################################

	proc アイテム設置 {

		#if d:DEBUG_PRINT
			print 'アイテム設置'
			print 'item_set'
		#endif

		if($w:アイテム数Ｒ[d:アイテム:サーマルゴーグル] == 0){
			@サーマルゴーグル_初期設置 サーマルゴーグル -10000 -7500 -54500 0
			//@サーマルゴーグル_初期設置 サーマルゴーグル -8750 -8500 -54500 0
		}


		@アイテム再セットチェック $b:w24c_取得ロード回数[0]
		if ($f:再セットフラグ) {
			@レーション_初期設置 レーション１ 7750 -8500 -51000 0
		}


		@アイテム再セットチェック $b:w24c_取得ロード回数[1]
		if ($f:再セットフラグ) {
			@止血剤_初期設置 止血剤１ -11000 -8500 -48500 0
		}


	}


	proc アイテム取得時番号設定 $:ボックス名 {
	#if d:DEBUG_PRINT
		print 'item_no_set'
	#endif

		if($:ボックス名 == レーション１) {
			eval($b:w24c_取得ロード回数[0] = $w:グローバルロード回数);

		} else if ($:ボックス名 == 止血剤１) {
			eval($b:w24c_取得ロード回数[1] = $w:グローバルロード回数);

		}

		#if d:DEBUG_PRINT
			print $:ボックス名
			print $w:グローバルロード回数
		#endif



	}







//###################################################################################
//									ロードモデル設置
//###################################################################################

	proc ロードモデル設置 {
		#if d:DEBUG_PRINT
			print 'load_model_set'
			print 'ロードモデル設置'
		#endif

		chara プットオブジェ ロードマップ -m w24c_w24b -r 0 0 0 \
			-s 100,100,100 \
			-p 0 0 0 -l w24c


		mesg プットオブジェ ロードマップ off

	}





//###################################################################################
//									ガラス弾痕設定
//###################################################################################

	proc ガラス弾痕設定 {
		#if d:DEBUG_PRINT
			print 'glass_bullethole'
			print 'ガラス弾痕設定'
		#endif


		chara ガラス弾痕  スタジオガラス \
			-flag	1 \  /* 1にするとターゲットが出る */
			-thick	10 \  /* 窓ガラスの厚さ（ｍｍ）    */
			-size	100 \
			-number	1 \  /* 窓の個数                  */
			-point	-8500,-7500,-63024   -2250,-5500,-63024
	}

























//###################################################################################
//									エフェクト設定
//###################################################################################

	// フォグ
	// ------------------------------------
	proc フォグ設定 {
		#if d:DEBUG_PRINT
			print 'fog_set'
		#endif

		chara フォグ 霧\
			-c 40, 35, 20 \
			-n -5000 \
			-f 30000
	}

	// キャラ用光源(マップの設置が終わってから設定することで、キャラだけに光を当てる)
	// ------------------------------------
	proc キャラ用ライト設置 {
		#if d:DEBUG_PRINT
			print 'chara_light_set'
		#endif

		chara 環境光 環境光源 \
			 -c 33 54 60

		chara 平行光 平行光源 \
			 -c 87 119 114 \
			 -p -3285 -3765 156
	}

	// エフェクト関係
	// -----------------------------------
	proc エフェクト設定 {
		#if d:DEBUG_PRINT
			print 'effect_set'
		#endif

		#if d:BLUR
			chara ブラー ブラー
		#endif

		#if d:Z_MANAGER
			chara Ｚフォーカス管理 Z_manager
			mesg Ｚフォーカス管理 Z_manager パラメータ 5000 30
		#endif

		#if d:BODY_SHADOW
			chara ＯＦＦ制御 off_man
			mesg ＯＦＦ制御 off_man ボディシャドウＯＦＦ
		#endif


	// 跳弾番号設定
	// ------------------------------------
		command 跳弾ノーマル -n 0
		command 跳弾ノーマル -n 1
		command 跳弾ノーマル -n 2
		command 跳弾ノーマル -n 3
		command 跳弾ノーマル -n 4
		command 跳弾ＳＥのみ -n 5
		command 弾痕ノーマル -n 6
		command 跳弾ＳＥのみ -n 7


		command 弾痕ノーマル -n 0
		command 弾痕ノーマル -n 1
		command 弾痕ノーマル -n 2
		command 弾痕ノーマル -n 3
		command 弾痕ノーマル -n 4
		command 弾痕ノーマル -n 5
		command 跳弾水蒸気中 -n 6
		command 弾痕ノーマル -n 7


		chara シネマスクリーン シネマ \
			-top d:CINEMA_BELT_UPPER \
			-bottom d:CINEMA_BELT_LOWER \
			-ftime 30

	}







//###################################################################################
//									ぼかし設定
//###################################################################################


	proc ぼかし設定{

		#if d:DEBUG_PRINT
			print 'deforcus_set'
		#endif

		print 'ぼかしセット！！！！'

		chara 遠景ぼかし far_deforcus \
			-plane	4 \
			-near	6000 \
			-far	9000

		chara 近景ぼかし near_deforcus \
			-plane	3 \
			-near	0 \
			-far	3000


		chara 近景ぼかし 敵兵発見近景ぼかし \
			-plane	20 \
			-near	0 \
			-far	1000

		chara 遠景ぼかし 敵兵発見遠景ぼかし \
			-plane 10 \
			-near 1000 \
			-far 2000
	//		-near 5000 \
	//		-far 10000

	}










//###################################################################################
//									天井君設定
//###################################################################################

// 各マップ別設定
// ------------------------------------
// 人質部屋
	// 天井設置
	// ------------------------------------
	proc 人質部屋天井設置 {
		#if d:DEBUG_PRINT
			print 'w24c_cail_set'
		#endif

//		chara 天井君 人質部屋天井 -m d:CEIL_NAME -h -500 -p 0,0,0 -l d:LT2_NAME
		chara 天井君 人質部屋天井 -m d:CEIL_NAME -h -2100 -p 0,0,0 -l d:LT2_NAME

	}
	proc 人質部屋南壁設置 {
