//###################################################################################

#define		オセロット東向き					2
#define		オセロットキング					121
#define		オセロット何故我々を裏切った		114
#define		オセロット背後を調べさせます		122
#define		オセロット念のためです				123
#define		オセロットあのスーツについては		115
#define		オセロット浸水しています			126
#define		オセロット設置させました			127
#define		オセロットありません				128
#define		オセロットそれが終われば用済み		116
#define		オセロットわかっています			117
#define		オセロットもうすぐです				129
#define		オセロット薬物で何もかも			118
#define		オセロット私は知らん				119
#define		オセロット仲間疑うな				99
#define		オセロットまだ言うか				106
#define		オセロットこの私を疑うのか			65
#define		オセロット意味深だな				132
#define		オセロット私の親友だった			107
#define		オセロット銃つきつけ				100
#define		オセロットガンプレイ				101
#define		オセロットオルガ見送り				104
#define		オセロット腕痛い					102
#define		オセロット注射でセーフ				103
#define		ソリダス西向き						3
#define		ソリダス構わん						111
#define		ソリダス何をしでかしても			112
#define		ソリダス奴の兵装					113
#define		ソリダス解体されている				124
#define		ソリダスシェル２の被害は			125
#define		ソリダスそれまでは生かしておけよ	105
#define		ソリダス東向き						66
#define		ソリダス今調べている				94
#define		ソリダスちょい歩いて東向き			71
#define		ソリダス仲裁						95
#define		ソリダス活動できる時勢ではない		130
#define		ソリダス脅し						96
#define		ソリダス腕組み						97
#define		ソリダスその腕にいくら				131
#define		スタジオ退場前ターン				98
#define		ソリダス退場						74
#define		オルガ登場前待機					0
#define		オルガ登場							4
#define		オルガ北向き						67
#define		オルガ東向き						68
#define		オルガ信じろって言うの				91
#define		オルガ南向き						70
#define		オルガちょい歩いて東向き			72
#define		オルガあの忍者が部下でない			120
#define		オルガ銃突きつけ					92
#define		オルガ銃しまい						93
#define		オルガ退場							69

#define		オセロット待機						63
#define		オセロット接近						64
#define		オセロット離脱						85


	proc デッドセル設定 {

		#if d:DEBUG_PRINT
			print 'deadcell_set'
		#endif


		if($s:登場ポイント == 盗聴イベント){

			@オセロットルートデモ人形呼び出し d:オセロット東向き

			chara ルートデモ人形 ソリダス \
				-route d:ソリダス西向き 0 \
				-kms sol_def_sh_mt \
				-mar w24e_sol \
				-number d:ソリダスモーションリスト:sol_walk

			chara マルチウェイト髪の毛モデル ソリダスのマント \
				-n sol_def_mant_mh_mt \
				-d 19 \
				-y ソリダス \
				-z 0 1 2 3 4 7 8 11 13 14 17 18 \
				-b sol_bounding \
				-o 100 \
				-q 0 \
				-f 1

			print 'オルガ登場'
			chara ルートデモ人形 オルガ \
				-route d:オルガ登場前待機 0 \
				-kms org_plant_sh_mt \
				-mar w24e_orga \
				//-item demo_makarov_org 6 \ //$s:装備モデル名 $i:関節番号 \
				-number d:オルガモーションリスト:org_walk_fast
/*
			chara マルチウェイト髪の毛モデル プラントオルガの髪 \
				-n org_plant_hair_mh \
				-d 20 \
				-y オルガ \
				-b org_plant_dummy \
				-z 11 12 \
				-o 100 \
				-f 1 \
				-c 2 { 11 12 }
*/

			chara 装備品Ｃ マカロフ \
				-n demo_makarov_org \
				-y オルガ \
				-z 6 \			//$i:つける場所のOBJ番号 \
				-x 0,0,0 \		//$v:ローカル座標上でのつける位置 \
				-r 0,0,0 \
				-f 1			//$i:遅れフレーム数

			mesg 装備品Ｃ マカロフ visible 0


			chara ガンスピン ピースメーカー \
				-pos	(-5379 - 398) \
						-8500, \
						(-66568 + 320) \
				-dir 683 \
				-kms saa_lefthand \ /*evmを表示する場合はダミーKMSが必要*/
				-mar w24e_rev \
				-number d:オセロットモーションリスト:rev_gun_end_lgun \ /*省略時０*/
				-C ピースメーカー消滅 \ /*終了判定モードでの再生時のみ有効*/
				-status	(d:PUT_MOT_INVISIBLE | d:PUT_MOT_WAIT | d:PUT_MOT_NO_INTERP)

			chara 装備品Ｃ 装備品ピースメーカー \
				-n saa_lefthand \
				-y オセロット \
				-z 10 \			//$i:つける場所のOBJ番号 \
				-x 0,0,0 \		//$v:ローカル座標上でのつける位置 \
				-r 0,0,0 \
				-f 1			//$i:遅れフレーム数


			mesg 装備品Ｃ 装備品ピースメーカー visible 0


		}else if($s:登場ポイント == オセロット接近イベント){

			@オセロットルートデモ人形呼び出し d:オセロット待機


		}else if($s:登場ポイント == ゲームオーバーデモ && $w:p_story >= d:ST:P040_08_G01エイムズ発見８ゲーム１開始){

			@オセロットルートデモ人形呼び出し d:オセロット離脱



		}

	}


	proc ピースメーカー消滅 {
		mesg ガンスピン ピースメーカー 非表示
	}



	proc オセロットルートデモ人形呼び出し $:ルート {

#if 0

		chara ルートデモ人形 オセロット \
			-route $:ルート 0 \
			-kms null \
			-evm rev_plant_hos_mh_mt \
			-mar w24e_rev \
			-number d:オセロットモーションリスト:rev_non_walk_p040

		chara ロープモデル３ オセロットの髪の毛 \
			-n rev_hair_fix \
			-d 4 \
			-y オセロット \
			-z 2 \
			-o 100 \
			-b rev_coat_bounding \
			-f 1 \
			-h 1

#else
		chara ルートデモ人形 オセロット \
			-route $:ルート 0 \
			-kms rev_plant_sh_mt \
			-mar w24e_rev \
			-number d:オセロットモーションリスト:rev_non_walk_p040

#endif

	}





























//###################################################################################
//								盗聴イベント処理開始
//###################################################################################

	proc 盗聴イベント用トラップ配置 {
		#if d:DEBUG_PRINT
			print 'mic_event_trap'
			print '盗聴マイクイベント用トラップ配置'
		#endif

		eval($f:盗聴イベントフェード中 = 0)


		eval($f:ローカルフラグ１ = 0)
		eval($f:ローカルフラグ２ = 0)

		trap ev001 オルガ \
			-mask 入る \
			-exec {
				if($4 > -6250 && !$f:ローカルフラグ１){
					eval($f:ローカルフラグ１ = 1)
					//mesg ルートデモ人形 ソリダス ルート変更 d:ソリダス西向き
					mesg ルートデモ人形 オルガ ルート変更 d:オルガ北向き

					print 'オルガ「あのサイボーグ忍者は何者なの？」'
					eval( $i:STREAM_ID = `%Stream t:vc104008 -p 盗聴イベント３ -action 盗聴時プロック -menustop -c 0` );

					chara delay ディレイ -time 1 -exec{
						if($i:STREAM_ID < 0){
							eval( $i:STREAM_ID = `%Stream t:vc104008 -p 盗聴イベント３ -action 盗聴時プロック -menustop -c 0` );
							return 1
						}else{
							return 0
						}
					}


				}

			}


		trap ev002 オルガ \
			-mask ？ \
			-exec {

				if($3 == 入る){
					if($6 > -68500){
						chara delay ディレイ -time 60 -exec{
							mesg 装備品Ｃ マカロフ kill
							mesg ルートデモ人形 オルガ kill
						}
						print 'オセロット「う、うグっ」'
						eval( $i:STREAM_ID = `%Stream t:vc104009 -p 盗聴イベント終了処理 -action 盗聴時プロック -menustop -c 0` );
						chara delay ディレイ -time 1 -exec{
							if($i:STREAM_ID < 0){
								eval( $i:STREAM_ID = `%Stream t:vc104009 -p 盗聴イベント終了処理 -action 盗聴時プロック -menustop -c 0` );
								return 1
							}else{
								return 0
							}
						}

					}

				}else{
					eval($f:ローカルフラグ２ = 1)
				}

			}






//ジョニー用
		eval($f:w24c_盗聴イベントストップ中 = 0)


		trap ev000 d:PLAYER \
			-mask ？ \
			-dir ((2500 + 2300)/2),((2500-2300)/2) \
			-exec {
				if($3 == 入る){
					print 'johnny_voice_restart'

					command StreamPauseControl -channel 1 -off
						// -on, -off のどちらかを指定。onでPAUSE_ON

				}else{
					print 'johnny_voice_paused'
					command StreamPauseControl -channel 1 -on
						// -on, -off のどちらかを指定。onでPAUSE_ON
				}
			}

		//イベントの再開
		trap ev000 d:PLAYER \
			-mask いる \
			-dir ((2250 + 1600)/2),((2250-1600)/2) \
			-exec {
				if($f:w24c_盗聴イベントストップ中){
					eval($f:w24c_盗聴イベントストップ中 = 0)
					command StreamPauseControl -channel 0 -F
						// -on, -off のどちらかを指定。onでPAUSE_ON
				}
			}




		chara 台詞発生源君 発生源君 -n オセロット ソリダス オルガ

		command foreach -argc 1 -repeat 2 \
			-data { \
				{0}\		//bomb系
				{1}\		//ノーマルの音
			} \
			-exec { \

				command セットマイクパラメータ \
					$1 \			//$i:モード
					0 \			//$i:有効角度
					1000 \		//$i:内側計算最小距離
					10000 \		//$i:内側計算最大距離
					0x3F \		//$i:内側最小距離時音量
					0x3D \		//$i:内側最大距離時音量
					100 \		//$i:減衰最大角
					1000 \		//$i:外側計算最小距離
					10000 \		//$i:外側計算最大距離
					0x0a \		//$i:外側最小距離時音量
					0x04 \		//$i:外側最大距離時音量
					600			//$i:パン係数

			}


		chara プレイヤー主観範囲設定 主観範囲君 \
			-range 1863 2700


	}


	proc 盗聴イベント処理開始 {


		command 無線設定 -reset
		command プレイヤー無敵セット
		command メニュー設定 -menu off -gage off -radar off -A off
		mesg コマンダー 敵兵セット 視界オフ

		//ついでにしゃがめなくするよー
		command パッド操作 -mask (d:PAD_STA | d:PAD_B)

		eval($s:音源対象キャラ名 = ジョニー)
		@盗聴イベントストリームボリューム制御


		print 'オセロット「ファットマンが死にました」'
		eval( $i:STREAM_ID = `%Stream t:vc104007 -p 盗聴イベント２ -action 盗聴時プロック -menustop -c 0` );


//ジョニーボヤキ
		eval( $i:JOHN_STREAM_ID = `%Stream t:vc121101 -menustop -c 1` );

		command StreamPauseControl -channel 1 -on
			// -on, -off のどちらかを指定。onでPAUSE_ON

		chara デモキャンセルチェック デモキャンセル \
			-p 盗聴イベント終了フェードアウト

	}


	proc 盗聴イベント２ {
		print 'オルガ登場！'
		mesg ルートデモ人形 オルガ ルート変更 d:オルガ登場

		//これがおいらの逃げる道ー♪
		chara delay オルガスタートチェックディレイ -time (60*5) -exec{
			if(!$f:ローカルフラグ２){
				mesg ルートデモ人形 オルガ ルート変更 d:オルガ登場
				return (60*10)
			}else{
				print 'なーんだちゃんと動いてんじゃ−ン！！！！'
				return 0
			}
		}

	}



	proc 盗聴イベント３ {
/*
		print 'オルガ退場！'
		mesg ルートデモ人形 オルガ 移動モーション変更 d:オルガモーションリスト:org_walk_fast
		mesg ルートデモ人形 オルガ ルート変更 d:オルガ退場

		chara delay 盗聴デモディレイ -time 60 -exec{
			mesg ルートデモ人形 オルガ ルート変更 d:オセロットオルガ見送り
		}
*/
	}


	proc 盗聴時プロック $:ストリームＩＤ $:話者名 $:アクションコード {

		print 'VOICE_PROC_CALLED'
		print '盗聴時プロックかまーん！！！！！'
		print $:話者名

		if($:アクションコード == 0){
			@盗聴イベント継続判定

			if($:話者名 == オセロット){
				print 'オセロット喋ってまーす！！！！'

//				eval($s:音源対象キャラ名 = オセロット)

			}else if($:話者名 == ソリダス){
				print 'ソリダス喋ってまーす！！！！'

//				eval($s:音源対象キャラ名 = ソリダス)

			}else if($:話者名 == オルガ){
				print 'オルガ喋ってまーす！！！！'

//				eval($s:音源対象キャラ名 = オルガ)

			}else if($:話者名 == ジョニー){
				print 'ジョニー喋ってまーす！！！！'

//				eval($s:音源対象キャラ名 = ジョニー)

			}


		}

		if($:アクションコード == 300){
			@盗聴イベント継続判定

		}else if($:アクションコード == 1){
			print 'オセロット「キング…ファットマンが死にました」'
			mesg ルートデモ人形 オセロット ルート変更 d:オセロットキング

		}else if($:アクションコード == 2){
			print 'ソリダス「構わん。始末する手間が省けただけだ」'
			mesg ルートデモ人形 ソリダス ルート変更 d:ソリダス構わん

		}else if($:アクションコード == 4){
			print 'オセロット「何故我々を裏切った」'
			mesg ルートデモ人形 オセロット ルート変更 d:オセロット何故我々を裏切った

		}else if($:アクションコード == 6){
			print 'ソリダス「何をしでかしても不思議ではない」'
			mesg ルートデモ人形 ソリダス ルート変更 d:ソリダス何をしでかしても

		}else if($:アクションコード == 7){
			print 'オセロット「背後を調べさせます」'
			mesg ルートデモ人形 オセロット ルート変更 d:オセロット背後を調べさせます

		}else if($:アクションコード == 8){
			print 'オセロット「念のためです」'
			mesg ルートデモ人形 オセロット ルート変更 d:オセロット念のためです

		}else if($:アクションコード == 10){
			print 'ソリダス「奴の兵装…スニーキングスーツだった」'
			mesg ルートデモ人形 ソリダス ルート変更 d:ソリダス奴の兵装

		}else if($:アクションコード == 12){
			print 'オセロット「あなたのほうが詳しいはず」'
			mesg ルートデモ人形 オセロット ルート変更 d:オセロットあのスーツについては

		}else if($:アクションコード == 13){
			print 'ソリダス「だが、ＦＯＸＨＯＵＮＤは４年前に解体されている」'
			mesg ルートデモ人形 ソリダス ルート変更 d:ソリダス解体されている

		}else if($:アクションコード == 14){
			print 'ソリダス「シェル２の被害は？」'
			mesg ルートデモ人形 ソリダス ルート変更 d:ソリダスシェル２の被害は

		}else if($:アクションコード == 241){
			print 'オセロット「中央棟の下層ブロックが浸水しています」'
			mesg ルートデモ人形 オセロット ルート変更 d:オセロット浸水しています

		}else if($:アクションコード == 242){
			print 'オセロット「既に通路にセムテックスと赤外線センサーを設置させました」'
			mesg ルートデモ人形 オセロット ルート変更 d:オセロット設置させました

		}else if($:アクションコード == 243){
			print 'オセロット「ありません」'
			mesg ルートデモ人形 オセロット ルート変更 d:オセロットありません

		}else if($:アクションコード == 15){
			print 'オセロット「それが終われば用済みです」'
			mesg ルートデモ人形 オセロット ルート変更 d:オセロットそれが終われば用済み

		}else if($:アクションコード == 20){
			print 'ソリダス「それまでは生かして置けよ」'
			mesg ルートデモ人形 ソリダス ルート変更 d:ソリダスそれまでは生かしておけよ

		}else if($:アクションコード == 22){
			print 'オセロット「わかっています」'
			mesg ルートデモ人形 オセロット ルート変更 d:オセロットわかっています

		}else if($:アクションコード == 244){
			print 'オセロット「もうすぐです」'
			mesg ルートデモ人形 オセロット ルート変更 d:オセロットもうすぐです

		}else if($:アクションコード == 25){
			print 'オセロット「いいえ、薬物で何もかも…」'
			mesg ルートデモ人形 オセロット ルート変更 d:オセロット薬物で何もかも

		}else if($:アクションコード == 30){
			mesg ルートデモ人形 ソリダス ルート変更 d:ソリダス東向き

		}else if($:アクションコード == 35){
			print 'オセロット「私は知らん」'
			mesg ルートデモ人形 オセロット ルート変更 d:オセロット私は知らん

		}else if($:アクションコード == 40){
			print 'あなたも？'
			mesg ルートデモ人形 オルガ ルート変更 d:オルガ東向き

		}else if($:アクションコード == 45){
			print '今調べている'
			mesg ルートデモ人形 ソリダス ルート変更 d:ソリダス今調べている

		}else if($:アクションコード == 50){
			print '仲間を疑うなオルガ'
			mesg ルートデモ人形 オセロット ルート変更 d:オセロット仲間疑うな

		}else if($:アクションコード == 60){
			print '信じろって言うの'
			mesg ルートデモ人形 オルガ ルート変更 d:オルガ信じろって言うの

		}else if($:アクションコード == 65){
			print '２年前のことをまだ言うか'
			mesg ルートデモ人形 オセロット ルート変更 d:オセロットまだ言うか

		}else if($:アクションコード == 70){
			print 'シャドーモセス事件のファイル、読んだわ'
			mesg ルートデモ人形 オルガ 移動モーション変更 d:オルガモーションリスト:org_walk_slow
			mesg ルートデモ人形 オルガ ルート変更 d:オルガ南向き

		}else if($:アクションコード == 80){
			mesg ルートデモ人形 オセロット ルート変更 d:オセロットこの私を疑うのか

		}else if($:アクションコード == 82){
			print 'オルガ「あの忍者が私の部下でないことは確かよ」'
			mesg ルートデモ人形 オルガ ルート変更 d:オルガあの忍者が部下でない

		}else if($:アクションコード == 83){
			mesg ルートデモ人形 オセロット ルート変更 d:オセロット意味深だな

		}else if($:アクションコード == 85){
			mesg ルートデモ人形 オルガ ルート変更 d:オルガちょい歩いて東向き

		}else if($:アクションコード == 87){
			mesg ルートデモ人形 オセロット ルート変更 d:オセロット私の親友だった

		}else if($:アクションコード == 90){
			mesg 装備品Ｃ マカロフ visible 1
			mesg ルートデモ人形 オルガ ルート変更 d:オルガ銃突きつけ

			mesg ルートデモ人形 オセロット ルート変更 d:オセロット銃つきつけ
			mesg 装備品Ｃ 装備品ピースメーカー visible 1

		}else if($:アクションコード == 95){
/*
			mesg ルートデモ人形 オセロット ルート変更 d:オセロット銃つきつけ
			mesg 装備品Ｃ 装備品ピースメーカー visible 1
*/

		}else if($:アクションコード == 100){
			mesg ルートデモ人形 オルガ ルート変更 d:オルガ銃しまい

		}else if($:アクションコード == 105){
			chara delay 盗聴デモディレイ -time 1 -exec{
				mesg ルートデモ人形 オセロット ルート変更 d:オセロットガンプレイ
			}
			mesg 装備品Ｃ 装備品ピースメーカー visible 0
			mesg ガンスピン ピースメーカー 表示
			mesg ガンスピン ピースメーカー 終了判定  d:オセロットモーションリスト:rev_gun_end_lgun

		}else if($:アクションコード == 110){
			print 'いいか、仲間割れはよせ！'
			mesg ルートデモ人形 ソリダス ルート変更 d:ソリダス仲裁
			mesg 装備品Ｃ マカロフ visible 0

		}else if($:アクションコード == 120){
			mesg ルートデモ人形 ソリダス ルート変更 d:ソリダス活動できる時勢ではない

		}else if($:アクションコード == 130){
			print '決して裏切るな！'
			mesg ルートデモ人形 ソリダス ルート変更 d:ソリダス脅し

		}else if($:アクションコード == 132){
			print 'オルガ退場！'
			mesg ルートデモ人形 オルガ 移動モーション変更 d:オルガモーションリスト:org_walk_fast
			mesg ルートデモ人形 オルガ ルート変更 d:オルガ退場

			chara delay 盗聴デモディレイ -time 120 -exec{
				mesg ルートデモ人形 オセロット ルート変更 d:オセロットオルガ見送り
			}

		}else if($:アクションコード == 135){
			mesg ルートデモ人形 オセロット ルート変更 d:オセロット腕痛い

		}else if($:アクションコード == 140){
			//mesg ルートデモ人形 ソリダス ルート変更 d:ソリダス腕組み

		}else if($:アクションコード == 145){
			print 'ソリダス「その腕にいくらかかったと思っている」'
			mesg ルートデモ人形 ソリダス ルート変更 d:ソリダスその腕にいくら

		}else if($:アクションコード == 150){
			mesg ルートデモ人形 オセロット ルート変更 d:オセロット注射でセーフ

		}else if($:アクションコード == 160){
			//mesg ルートデモ人形 ソリダス ルート変更 d:スタジオ退場前ターン


		}

	}




	proc 盗聴イベント終了処理 {
		if($1 == 0){
			//mesg ルートデモ人形 ソリダス ルート変更 d:ソリダス退場

			chara delay 盗聴デモディレイ -time 30 -exec{
				// 黒フェード
				@盗聴イベント終了フェードアウト
			}
		}
	}

	proc 盗聴イベント終了フェードアウト {

		command セットサウンドコード -c d:SNG_FOUTS_S

		mesg デモキャンセルチェック デモキャンセル kill

		if(!$f:盗聴イベントフェード中){
			eval($f:盗聴イベントフェード中 = 1)

			if ( $w:アイテム == d:アイテム:ゴル兵制服 ) {
				preseek "r_plt4"
			} else {
				preseek "d036p03"
			}
			chara フェードインアウト 黒フェード \
				-c 0 0 0 255 \		//目標のＲＧＢα
				-t d:FADEOUT_TIME \		//変化完了までのフレーム数
				-p オセロットスタジオから出てくるポリデモロード
		}
	}

	proc オセロットスタジオから出てくるポリデモロード {

		eval($w:p_story = d:ST:P040_04_I04エイムズ発見４インタラクティブ主観デモ１終了)
		print '$w:p_story = d:ST:P040_04_I04エイムズ発見４インタラクティブ主観デモ１終了'

		eval($w:p_story = d:ST:P040_05_P03エイムズ発見５ポリゴンデモ３開始)
		print '$w:p_story = d:ST:P040_05_P03エイムズ発見５ポリゴンデモ３開始'

		if ( $w:アイテム == d:アイテム:ゴル兵制服 ) {
			load "d036p03" -r 'r_plt4'
		} else {
			load "d036p03" -r 'r_plt0'
		}

	}




	proc 盗聴イベント継続判定 {

		if($i:カメラ角度Ｙ > 1600 && $i:カメラ角度Ｙ < 2300 && $i:カメラ角度Ｘ > -190 && $i:カメラ角度Ｘ < 190){
			print '継続ＯＫ！'
			print 'talk_continue'
		}else{
			print '台詞ストップ！'
			print 'talk_pause'
			command 字幕制御 -hide
#if 1
			command StreamPauseControl -channel 0 -on
				// -on, -off のどちらかを指定。onでPAUSE_ON
#else
			command セットサウンドコード -c 0xFF00001B	//ストリーミング(CH1)、ポーズ ON
#endif
			eval($f:w24c_盗聴イベントストップ中 = 1)
		}


	}











//###################################################################################
//						盗聴イベントストリームボリューム制御
//###################################################################################

#define		盗聴ボリューム制御用プリント	0
#define		指向性マイクパン限界	100


	//ジョニーの音量制御のみ行ってます。
	proc 盗聴イベントストリームボリューム制御 {

		chara delay 盗聴ボリューム制御ディレイ -time 2 -exec{

			%コントロール座標取得 \
				$s:音源対象キャラ名 $i:音源Ｘ位置 $i:音源Ｙ位置 $i:音源Ｚ位置


			//カメラの位置から対象の位置までのベクトルの法線ベクトル（向き0からの角度を調べたいため）を作り、それとカメラの向きとの角度差を調べる。cosの値で左右にパン。

			eval($i:法線大きさ = `%VecLen $i:音源Ｘ位置 $i:音源Ｙ位置 $i:音源Ｚ位置 $i:カメラＸ位置 $i:カメラＹ位置 $i:カメラＺ位置`)



			eval($i:盗聴法線大きさ２ = $i:法線大きさ / 1000)

			//ベクトル(x,z)の法線は(-z,x)
			//注意！！！$w:法線Ｘ変位　は、Ｚ軸が逆のため、-1をかけてあります！！
			eval($w:法線Ｘ変位 = ($i:音源Ｚ位置 - $i:カメラＺ位置) / $i:盗聴法線大きさ２)
			eval($w:法線Ｚ変位 = ($i:音源Ｘ位置 - $i:カメラＸ位置) / $i:盗聴法線大きさ２)

			eval($w:角度 = `%atan $w:法線Ｘ変位 $w:法線Ｚ変位` )

			#if d:盗聴ボリューム制御用プリント
				print '音源との角度は'$w:角度
			#endif


			eval($w:カメラの角度 = $i:カメラ角度Ｙ)

			eval($w:音の方向 = ($w:角度 - $w:カメラの角度) & 4095)

			#if d:盗聴ボリューム制御用プリント
				print '$w:音の方向は'$w:音の方向
			#endif



			if($w:音の方向 < 1024 ){
				@CS_スムーズカメラ昇順 $w:音の方向 0 d:指向性マイクパン限界 0x20 0x00

			}else if( $w:音の方向 >= 1024 && $w:音の方向 < 3072 ){
				@CS_スムーズカメラ昇順 $w:音の方向 (2048 - d:指向性マイクパン限界) (2048 + d:指向性マイクパン限界) 0x00 0x3F

			}else{
				@CS_スムーズカメラ昇順 $w:音の方向 (4096 - d:指向性マイクパン限界) 4095 0x3F 0x20

			}


			eval($b:盗聴パン角度 = $i:CS_結果１)

			#if d:盗聴ボリューム制御用プリント
				print '$b:盗聴パン角度は'$b:盗聴パン角度
			#endif

#if 1
			eval($i:分子 = ( (($i:注視点Ｘ位置 - $i:カメラＸ位置) * ($i:音源Ｘ位置 - $i:カメラＸ位置)) \
			+ (($i:注視点Ｙ位置 - $i:カメラＹ位置) * ($i:音源Ｙ位置 - $i:カメラＹ位置)) \
			+ (($i:注視点Ｚ位置 - $i:カメラＺ位置) * ($i:音源Ｚ位置 - $i:カメラＺ位置)) ) / 10000 )


			eval($i:分母 = (`%VecLen $i:注視点Ｘ位置 $i:注視点Ｙ位置 $i:注視点Ｚ位置 $i:カメラＸ位置 $i:カメラＹ位置 $i:カメラＺ位置` * `%VecLen $i:音源Ｘ位置 $i:音源Ｙ位置 $i:音源Ｚ位置 $i:カメラＸ位置 $i:カメラＹ位置 $i:カメラＺ位置`) / 10000 )


			eval($i:コサイン = ($i:分子 * 4096) / $i:分母)

#if d:盗聴ボリューム制御用プリント
			print '分子は'$i:分子
			print '分母は'$i:分母
			print 'コサインは'$i:コサイン
#endif

#else
			eval($i:コサイン = ( (($i:注視点Ｘ位置 - $i:カメラＸ位置) * ($i:音源Ｘ位置 - $i:カメラＸ位置)) + (($i:注視点Ｙ位置 - $i:カメラＹ位置) * ($i:音源Ｙ位置 - $i:カメラＹ位置)) + (($i:注視点Ｚ位置 - $i:カメラＺ位置) * ($i:音源Ｚ位置 - $i:カメラＺ位置)) ) * 4096 \
			/ (`%VecLen $i:注視点Ｘ位置 $i:注視点Ｙ位置 $i:注視点Ｚ位置 $i:カメラＸ位置 $i:カメラＹ位置 $i:カメラＺ位置` * `%VecLen $i:音源Ｘ位置 $i:音源Ｙ位置 $i:音源Ｚ位置 $i:カメラＸ位置 $i:カメラＹ位置 $i:カメラＺ位置`) )
#endif

			@CS_スムーズカメラ昇順 $i:コサイン 4060 4096 0x03 0x3F
			eval($b:盗聴ボリューム = $i:CS_結果１)




			%StreamSetPan $i:JOHN_STREAM_ID -p $b:盗聴パン角度 -v $b:盗聴ボリューム
				// ストリームにパンとボリュームを設定する。
				// pan 0(左)-0x20(中)-0x3F(右), vol 0-0x3F

			return 1

		}


	}






//###################################################################################
//							オセロット接近イベント処理開始
//###################################################################################


#define		ライデン逃げた		0
#define		ライデン撃った		1
#define		ライデン服違う		2
#define		ライデン武器違う	3
#define		タイムオーバー		4


	proc オセロット接近イベントトラップ設置 {
		#if d:DEBUG_PRINT
			print 'ocelot_approach_trap'
			print 'オセロット接近イベントトラップ配置'
		#endif


		eval($f:オセロット接近デモゲームオーバー中 = 0)


		trap ev004 オセロット \
			-mask いる \
			-exec {

				if(!$f:オセロット接近デモゲームオーバー中){

					if($w:武器 == d:武器:ＡＫＳ && $w:アイテム == d:アイテム:ゴル兵制服){
						command セットタイマーステータス -s d:TMR_WAIT
						@オセロット接近ゲームオーバー

					}else if($w:武器 == d:武器:スティンガー || $w:武器 == d:武器:ＰＳＧ１ || $w:武器 == d:武器:ＲＧＢ６ || $w:武器 == d:武器:ニキータ || $w:武器 == d:武器:ＡＫＳ || $w:武器 == d:武器:Ｍ４ || $w:武器 == d:武器:凍結スプレー || $w:武器 == d:武器:ＰＳＧ１−Ｔ){

						command パッド操作 -mask d:PAD_Y
						command パッドチェック -which 0 -press -direct

						if( $status & d:PAD_Y ){
							command パッド操作 -release
							@オセロット接近デモゲームオーバー d:ライデン撃った
						}

					}else if($w:武器 == d:武器:素手 || $w:アイテム == d:アイテム:デジカメ){

					}else{
						command パッド操作 -cancel

						command パッドチェック -which 0 -press
						if( $status & d:PAD_Y ){
							command メニュー設定 \
								-A off 		//無線の許可／不許可

							command パッド操作 -mask (d:PAD_U | d:PAD_D | d:PAD_L | d:PAD_R | d:PAD_A | d:PAD_B | d:PAD_X | d:PAD_Y | d:PAD_R1 | d:PAD_L1 | d:PAD_L2 | d:PAD_R2 | d:PAD_STA | d:PAD_SEL | d:PAD_AL | d:PAD_AR)
							command シナリオデモ開始

							chara delay オセロット接近イベントディレイ -time 1 -exec{
								command パッド操作 -press d:PAD_Y
								return 1
							}
							@オセロット接近デモゲームオーバー d:ライデン撃った
						}

					}

				}

			}



		//エイムズ音声
		trap ev005 オセロット \
			-mask ？ \
			-exec {
				if(!$f:オセロット接近デモゲームオーバー中){
					if($3 == 入る){
						if($w:武器 != d:武器:ＡＫＳ || $w:アイテム != d:アイテム:ゴル兵制服){
							print 'エイムズ「おい！奴が来る！」'
							eval( $i:STREAM_ID = `%Stream t:vc104055 -menustop`);
						}

					}else if($3 == 出る){
						if($w:武器 != d:武器:ＡＫＳ){
							print 'オセロット「ん？」'
							eval( $i:STREAM_ID = `%Stream t:vc104057 -menustop`);
//							eval( $i:STREAM_ID = `%Stream t:vc104069 -menustop`);
							chara delay ディレイ -time 30 -exec {
								print 'エイムズ「AKに持ちかえろ！」'
								eval( $i:STREAM_ID = `%Stream t:vc104056 -menustop`);
							}

						}else if($w:アイテム != d:アイテム:ゴル兵制服){
							print 'オセロット「ん？」'
							eval( $i:STREAM_ID = `%Stream t:vc104069 -menustop`);
							chara delay ディレイ -time 30 -exec {
								print 'エイムズ「おい！奴が来る！」'
								eval( $i:STREAM_ID = `%Stream t:vc104055 -menustop`);
							}
						}
					}
				}
			}

		trap ev000 d:PLAYER \
			-mask 出る \
			-exec {

				command メニュー設定 \
					-A off 		//無線の許可／不許可

				command パッド操作 -mask (d:PAD_U | d:PAD_D | d:PAD_L | d:PAD_R | d:PAD_A | d:PAD_B | d:PAD_X | d:PAD_Y | d:PAD_R1 | d:PAD_L1 | d:PAD_L2 | d:PAD_R2 | d:PAD_STA | d:PAD_SEL | d:PAD_AL | d:PAD_AR)

//				command パッド操作 -release
//				@最寄ポイント検索処理
				@オセロット接近デモゲームオーバー d:ライデン逃げた

			}




		trap ca001 オセロット \
			-mask いる \
			-exec {

				@CS_スムーズカメラ昇順 $6 -60000 -53000 -1942 -2083
				eval( $i:補完ＰＸ = $i:CS_結果１ );

				@CS_スムーズカメラ昇順 $6 -60000 -53000 -4944 -6340
				eval( $i:補完ＰＹ = $i:CS_結果１ );

				@CS_スムーズカメラ昇順 $6 -60000 -53000 -45695 -45690
				eval( $i:補完ＰＺ = $i:CS_結果１ );

				@CS_スムーズカメラ昇順 $6 -60000 -53000 -4428 -4836
				eval( $i:補完ＴＸ = $i:CS_結果１ );

				@CS_スムーズカメラ昇順 $6 -60000 -53000 -7011 -7374
				eval( $i:補完ＴＹ = $i:CS_結果１ );

				@CS_スムーズカメラ昇順 $6 -60000 -53000 -50331 -50567
				eval( $i:補完ＴＺ = $i:CS_結果１ );

				@CS_スムーズカメラ昇順 $6 -56000 -51000 227 300
				//@CS_スムーズカメラ昇順 $6 -60000 -53000 350 280
				eval( $w:補完画角 = $i:CS_結果１ );

				chara カメラ設定 モーションカメラ \
					-c 1 \
					-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ \
					-t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ \
					-a $w:補完画角 \
					-i 0 0 0 0 \
					-d 1 \
					-s 1 \

			}

	}





	proc オセロット接近イベント開始 {
		@ゲームオーバー背景設定

		chara delay オセロット接近イベントディレイ -time 1 -exec{
			mesg ルートデモ人形 オセロット ルート変更 d:オセロット接近
			mesg タイマー タイマー 開始
		}




	}



	proc エイムズ発見９ポリゴンデモ５へ {

		eval($w:体力 = $w:体力最大)

		eval($w:p_story = d:ST:P040_08_G01エイムズ発見８ゲーム１終了)
		print '$w:p_story = d:ST:P040_08_G01エイムズ発見８ゲーム１終了'

		eval($w:p_story = d:ST:P040_09_P05エイムズ発見９ポリゴンデモ５開始)
		print '$w:p_story = d:ST:P040_09_P05エイムズ発見９ポリゴンデモ５開始'

		command セットサウンドコード -c d:SNG_FOUTS_S

		load "d036p03"

	}




	proc オセロット接近デモゲームオーバー $:ゲームオーバー種類 {
		eval($b:ゲームオーバー種類 = $:ゲームオーバー種類)
		//if(`%ゲームオーバーチェック` == 0 && $f:ロードチェックＯＮフラグ){
			//command ゲームオーバー処理開始 -exec {

			if(!$f:オセロット接近デモゲームオーバー中){
				eval($f:オセロット接近デモゲームオーバー中 = 1)

				command セットタイマーステータス -s d:TMR_WAIT

				command StreamStopAll

				mesg ルートデモ人形 オセロット 赤ビックリ
				mesg ルートデモ人形 オセロット 割り込みモーション d:オセロットモーションリスト:rev_non_pose_p040 200

				chara delay オセロット接近イベントディレイ  -time 1 -arg $b:ゲームオーバー種類 -exec{
					if(`%StreamIsPlay` == 0){

						if($1 == d:ライデン逃げた){
							chara delay オセロット接近イベントディレイ -time 1 -exec{
								print 'オセロット「どこへ行く、貴様！！」'
								eval( $i:STREAM_ID = `%Stream t:vc104063 -p オセロット接近デモゲームオーバー終了`);
							}
						}else if($1 == d:ライデン撃った){
							chara delay オセロット接近イベントディレイ -time 1 -exec{
								print 'オセロット「何をしている？」'
								eval( $i:STREAM_ID = `%Stream t:vc104075 -p オセロット接近デモゲームオーバー終了`);
							}
						}else if($1 == d:ライデン服違う){
							chara delay オセロット接近イベントディレイ -time 1 -exec{
								print 'オセロット「何者だ！！」'
								eval( $i:STREAM_ID = `%Stream t:vc104074 -p オセロット接近デモゲームオーバー終了`);
							}
						}else if($1 == d:ライデン武器違う){
							chara delay オセロット接近イベントディレイ -time 1 -exec{
								if($w:武器 == d:武器:Ｍ９ || $w:武器 == d:武器:ＵＳＰ || $w:武器 == d:武器:ソコム || $w:武器 == d:武器:ＰＳＧ１ || $w:武器 == d:武器:Ｍ４ || $w:武器 == d:武器:ＰＳＧ１−Ｔ  ){
									%rand 2
									if($status == 0){
										print 'オセロット「なんだその銃は！！」'
										eval( $i:STREAM_ID = `%Stream t:vc104077 -p オセロット接近デモゲームオーバー終了`);
									}else{
										print 'オセロット「装備が違うぞ！！」'
										eval( $i:STREAM_ID = `%Stream t:vc104078 -p オセロット接近デモゲームオーバー終了`);
									}
								}else{
									print 'オセロット「貴様、銃はどうした！！」'
									eval( $i:STREAM_ID = `%Stream t:vc104076 -p オセロット接近デモゲームオーバー終了`);
								}
							}
						}else{
							chara delay オセロット接近イベントディレイ -time 1 -exec{
								%rand 2
								if($status == 0){
									print 'オセロット「誰だ、貴様！！」'
									eval( $i:STREAM_ID = `%Stream t:vc104073 -p オセロット接近デモゲームオーバー終了`);
								}else{
									print 'オセロット「何者だ！！」'
									eval( $i:STREAM_ID = `%Stream t:vc104074 -p オセロット接近デモゲームオーバー終了`);
								}
							}
						}

						//これがおいらの逃げる道ー♪
						chara delay 逃げ道キャンセルディレイ -time (60*30) -proc ゲームオーバーキャンセル処理

						return 0
					}else{
						return 1
					}

				}

				mesg コマンダー 敵兵セット 視界オフ

				chara delay ディレイ -time 60 -exec{
					print 'ドアオープン！！！！'
					mesg ドア スタジオドア open
					mesg 警備兵 敵兵:11 ルート変更 d:ライデン取り囲み１ -7250 -8500 -50250 人質部屋
					mesg 警備兵 敵兵:12 ルート変更 d:ライデン取り囲み２ -6250 -8500 -51500 人質部屋
					mesg 警備兵 敵兵:13 ルート変更 d:ライデン取り囲み３ -5250 -8500 -52250 人質部屋
					mesg 警備兵 敵兵:14 ルート変更 d:ライデン取り囲み４ -4000 -8500 -52250 人質部屋
				}

				chara delay オセロット接近イベントディレイ -time (60 * 90) -exec{
					mesg コマンダー 敵兵セット 視界オン
				}


//				@最寄ポイント検索処理

			}

		//}

	}




	proc オセロット接近デモゲームオーバー終了 {
		if(`%ゲームオーバーチェック` == 0 && $f:ロードチェックＯＮフラグ){
			command ゲームオーバー処理開始 -exec {
				@ラジオドラマゲームオーバー
			}
		}
	}




//###################################################################################
//							オセロット接近タイマー設定
//###################################################################################


	proc オセロット接近タイマー設定 {

		#if d:DEBUG_PRINT
			print 'ocelot_approach_timer'
			print 'オセロット接近タイマー設定'
		#endif

		chara タイマー タイマー \
			-time (60 * 10) \						/*NTSCフレーム数で指定(1分の場合3600)*/
			-proc オセロット接近ゲームオーバー \	/*タイム０の時に実行*/
			-status	(d:TMR_WAIT | d:TMR_DISP_ZERO)


	}


	proc オセロット接近ゲームオーバー {
		if(`%ゲームオーバーチェック` == 0 && !$f:オセロット接近デモゲームオーバー中){

			print 'オセロットタイムオーバー'
			command パッド操作 -release

			if($w:アイテム == d:アイテム:ゴル兵制服 && $w:武器 == d:武器:ＡＫＳ){
				eval($f:オセロット接近デモゲームオーバー中 = 1)
				chara delay ディレイ -time 2 -exec{
					eval($w:アイテム = d:アイテム:ゴル兵制服)
					eval($w:武器 = d:武器:ＡＫＳ)
				}
				preseek "d036p03"

				chara フェードインアウト 黒フェード \
					-c 0 0 0 255 \		//目標のＲＧＢα
					-t d:FADEOUT_TIME \		//変化完了までのフレーム数
					-p エイムズ発見９ポリゴンデモ５へ

			}else if($w:アイテム == d:アイテム:ゴル兵制服){
			    @オセロット接近デモゲームオーバー d:ライデン武器違う

			}else if($w:武器 == d:武器:ＡＫＳ){
				@オセロット接近デモゲームオーバー d:ライデン服違う

			}else{
				@オセロット接近デモゲームオーバー d:タイムオーバー

			}

		}

	}

















