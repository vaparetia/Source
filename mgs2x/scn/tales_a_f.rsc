「中央棟のどこかにマイクがあるはずだ。まずは集音マイクを探すんだ」#C0
EOF
//}

//マイクある場合
//★ＡＭ−１Ｂ {
AM_1B: << EOF
FRENCH!!
「スネーク、集音マイクを使うんだ」
#C0
EOF
