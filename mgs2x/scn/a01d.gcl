// マップ接合
// ------------------------------------
// 食堂＆廊下
proc マップ接合_食堂／廊下_北 {
	chara マップ接合 食堂／廊下_北 四階食堂 四階廊下_北半分
}

proc マップ接合_食堂／廊下_南 {
	chara マップ接合 食堂／廊下_南 四階食堂 四階廊下_南半分
}

// 廊下同士（廊下の絡むマップ接合が on 時には、自動的に on。逆もまた真）
proc マップ接合_廊下同士 {
	chara マップ接合 廊下同士 四階廊下_北半分 四階廊下_南半分
	// ここは常に接合状態を保つこと。

	mesg マップ接合 廊下同士 on

	chara マップ接合 階上管理 四階廊下_南半分 階上

	trap ca003_b d:PLAYER \
		-mask ？ \
		-exec {
			if($3 == 入る){
				mesg マップ接合 階上管理 on
			}else{
				mesg マップ接合 階上管理 off
			}
		}

	trap ca008 d:PLAYER \
		-mask ？ \
		-exec {
			if($3 == 入る){
				mesg マップ接合 階上管理 on
			}else{
				mesg マップ接合 階上管理 off
			}
		}

}

// 廊下＆倉庫
proc マップ接合_廊下／倉庫 {
	chara マップ接合 廊下／倉庫 四階廊下_北半分 四階倉庫
}

// ドア兼マップ切り替えトラップ
// ------------------------------------
proc マップ切り替え_食堂／廊下ドア_北 {
	chara ドア 食堂／廊下ドア_北 -m w01d_dr01 -d 0 3072 0 \
		-p -1100 9000 -15500 -slide 2000 -time d:SD_OPEN_TIME \
		-between 四階食堂 四階廊下_北半分 \
		-exec {
			if($:開閉フラグ == 0){
print '食堂／廊下_北　と　廊下同士　オフ'
				mesg マップ接合 食堂／廊下_北 off
//				mesg マップ接合 廊下同士 off
			} else {
print '食堂／廊下_北　と　廊下同士　オン'
				mesg マップ接合 食堂／廊下_北 on
//				mesg マップ接合 廊下同士 on
			}
		}

	trap dr000 ？ \
		-mask ？ \
		-exec {
			if ( $3 == 入る ) {
				mesg ドア 食堂／廊下ドア_北 open $2
			} else {
				mesg ドア 食堂／廊下ドア_北 close $2

			}
		}

}

proc マップ切り替え_食堂／廊下ドア_南 {
	chara ドア 食堂／廊下ドア_南 -m w01d_dr00 -d 0 1024 0 \
		-p -1100 9000 -8700 -slide 2000 -time d:SD_OPEN_TIME \
		-between 四階廊下_南半分 四階食堂 \
		-exec {
			if($:開閉フラグ == 0){
print '食堂／廊下_南　と　廊下同士　オフ'
				mesg マップ接合 食堂／廊下_南 off
//				mesg マップ接合 廊下同士 off
			} else {
print '食堂／廊下_南　と　廊下同士　オン'
				mesg マップ接合 食堂／廊下_南 on
//				mesg マップ接合 廊下同士 on
			}
		}
	trap dr001 ？ \
		-mask ？ \
		-exec {
			if ( $3 == 入る ) {
				mesg ドア 食堂／廊下ドア_南 open $2
			} else{
				mesg ドア 食堂／廊下ドア_南 close $2
			}
		}
}

proc マップ切り替え_廊下／倉庫ドア {
	chara ドア 廊下／倉庫ドア -m w01d_dr02 -d 0 3072 0 \
		-p 7100 9000 -19800 -slide 2000 -time d:SD_OPEN_TIME \
		-between 四階廊下_北半分 四階倉庫 \
		-exec {
			if($:開閉フラグ == 0){
				mesg マップ接合 廊下／倉庫 off
