// 天井君は、各小部屋ごとにセットする。
// ------------------------------------
proc 食堂_天井セット {
	chara 天井君 食堂_天井 -m w01d0r -h 11400 -p 0,0,0  -l w01d -v 揺れライト表示制御

//注意！！天井君の高さを変えるときは、ビハインドカメラの位置を全てチェックすること！！
}


proc 廊下_天井セット {
	chara 天井君 廊下_天井 -m w01d1r -h 11700 -p 0,0,0  -l w01d
}


proc 倉庫_天井セット {
	chara 天井君 倉庫_天井 -m w01d2r -h 11600 -p 0,0,0  -l w01d
}


