	@北廊下ビヨンド設定
//#endif
} // <command マップ設定 四階廊下>の閉じカッコ

command マップ設定 四階廊下_南半分 -s {
	print 'マップ設定の四階南半分！！！！！！！！！！！'
	@危険モード時五階へ移動禁止セット
	@五階への階段敵兵吹っ飛ばしすぎ防止透明壁セット
	print 'マップ設定の四階南半分！！！！！！！！！！！'
} // <command マップ設定 四階廊下>の閉じカッコ


// マップ設定　倉庫
// ------------------------------------
command マップ設定 四階倉庫 -s {
	@倉庫_天井セット
	@倉庫カメラセット
	@食糧倉庫での戦闘時俯瞰カメラセット
	@倉庫南壁セット
	@倉庫_壊れ瓶セット１
	@倉庫_壊れポテトセット１ // コンテナの上のイモ箱とカボチャ箱
	@倉庫_壊れポテトセット２
//	@イモを蹴るスネーク足セット
	@倉庫_メリケン粉袋セット１
	@倉庫_メリケン粉袋セット２ // 棚上段南端
	@倉庫_メリケン粉袋セット３ // 棚下段北端
	@倉庫_キャベツ箱セット１
	@倉庫_キャベツ箱セット２
	@倉庫_カボチャ箱セット１
	@子画面設定
	@倉庫_消火器セット
	@倉庫_同じ柄のダンボールでやりすごすセット
	//@棚の下敵兵視線阻止透明壁セット		// 他のステージと仕様を同じくするためマスク(2001.9.6 Y.Matsuhana)
	@倉庫の窓雨セット
	@居住区４Ｆ透明壁設定
} // <command マップ設定 四階倉庫>の閉じカッコ

