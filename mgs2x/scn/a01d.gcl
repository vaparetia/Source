// リソース
/**************************************************************************************/
// コマンダー危険時音声
	resource ghq_area_alert_voice {
	w01d:
		$t{
			// PLAREA0 四階食堂
			t:vc04001d, //「了解。応援部隊、船橋四階居住区へ向かえ。食堂を固めろ」
			t:vc04001e, //「了解。増援部隊を船橋四階食堂に送る。敵を包囲せよ」
			t:vc040021, //「了解。応援部隊出動。船橋四階へ向かえ。左舷を固めろ」
			-2,// PLAREA0 の登録終了
			// PLAREA1 四階廊下_北半分
			t:vc04001f, //「了解。応援部隊、船橋四階に向かえ。階段を死守せよ」
			//t:vc040020, //「了解。バックアップ、船橋四階階段へ向かえ。敵を操舵室に入れるな！」
			-2,// PLAREA1 の登録終了
			// PLAREA2 四階倉庫
			t:vc040022, //「了解。船橋四階右舷を強化。敵を包囲せよ」
			-2,// PLAREA2 の登録終了
			// PLAREA3 四階廊下_南半分
			t:vc04001f, //「了解。応援部隊、船橋四階に向かえ。階段を死守せよ」
//			-2,// PLAREA3 の登録終了
			-1// 全ての登録終了
		}
	}
// コマンダー警戒時音声
	resource ghq_caution_voice {
	w01d:
		$t{
			t:vc040047, //「了解。船橋四階居住区を増員。食堂を警戒せよ」
			t:vc040048, //「了解。船橋四階食堂を増員する。警戒を強化しろ」
			t:vc040049, //「了解。船橋四階に増員。階段の警備を強化」
			t:vc04004a, //「了解。船橋四階階段の警備を増員する。敵を操舵室に入れるな！」
			t:vc04004b, //「了解。船橋四階居住区を増員する。左舷警備を固めろ」
			-2, // 警戒モード時の音声登録終了

			t:vc04006d, // 「船橋四階居住区との連絡が途絶えた。応援部隊、現場に向かえ」
			-3,
			t:vc040604, // 「船橋四階居住区で異状発生。至急確認に向かえ」
			-1 // 登録終了
		}
	a01d:
		$t{
			t:vc046601, //「了解、総員警戒を強化せよ」
			t:vc046601, //「了解、総員警戒を強化せよ」
			t:vc046601, //「了解、総員警戒を強化せよ」
			t:vc046601, //「了解、総員警戒を強化せよ」
			t:vc046601, //「了解、総員警戒を強化せよ」
			-2, // 警戒モード時の音声登録終了

			t:vc04006d, // 「船橋四階居住区との連絡が途絶えた。応援部隊、現場に向かえ」
			-3,
			t:vc040604, // 「船橋四階居住区で異状発生。至急確認に向かえ」
			-1 // 登録終了
		}
	}

