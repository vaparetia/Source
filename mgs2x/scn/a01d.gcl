		-end \

		-model flypan_bk \
		-name 黒フライパン \
		-scale 81 81 81 \
		-rot   (8*4096/360) (20*4096/360) (0*4096/360) \
		-pos   -10350 11100 -16665 \
		-sound d:se_code:SD_A_FLYPAN_B \
		-end \

		-model flypan_si \
		-scale 90 90 90 \
		-rot   (8*4096/360) (30*4096/360) (0*4096/360) \
		-pos   -10650 11100 -16665 \
		-sound d:se_code:SD_A_FLYPAN_A \
		-end \

		-model flypan_co \
		-scale 100 100 100 \
		-rot   (8*4096/360) (24*4096/360) (0*4096/360) \
		-pos   -10950 11100 -16665 \
		-sound d:se_code:SD_A_FLYPAN_G \
		-end \

		-model flypan_bk \
		-scale 100 100 100 \
		-rot   (8*4096/360) (33*4096/360) (0*4096/360) \
		-pos   -11300 11100 -16665 \
		-sound d:se_code:SD_A_FLYPAN_F \
		-end
#else
// 右端より左方向へ
	chara プットオタマオブジェ 揺れオタマ１ \
		-m w01d0Otama \
		-r (5*4096/360) (185*4096/360) (0*4096/360) \
		-p -9570 11100 -16670 \
