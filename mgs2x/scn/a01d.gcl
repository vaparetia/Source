}





//###################################################################################
//									ロード設定
//###################################################################################

// 入出トラップ
// ------------------------------------
// このプロック名は予約。
proc ロードプロック {
	if(`%ゲームオーバーチェック` == 0){
		if ( $s:呼び出しプロック == d00a4発動 ) {
			#if d:ASSERT
				command assert ( d:FALSE ) 'unexpected load point  (scenario err)'
			#else
				@ロード時フェードイン
			#endif
		}else if ($s:呼び出しプロック == mv_a01d_a01e_0) {
			command セットサウンドコード -c d:SNG_FOUTS_S		//ＢＧＭフェードアウト
			@mv_a01d_a01e_0

		} else if ($s:呼び出しプロック == mv_a01d_a01c_0) {
			@mv_a01d_a01c_0

		} else if ( $s:呼び出しプロック == load_tal_a01e_mrl_demo ) {
			@load_tal_a01e_mrl_demo
		} else if ( $s:呼び出しプロック == load_tales_book ) {
			@load_tales_book
		} else {
			command assert ( d:FALSE ) 'Not found end_proc ! call me.'
		}
	}
}

// 五階へ
proc ロード_五階へ移動 {
	trap ld000 d:PLAYER \
		-mask 入る \
		-exec {

			if(`%ゲームオーバーチェック` == 0 && $f:ロードチェックＯＮフラグ){
/*
				if(!$f:w01eへ２回目以降){

					preseek 'd04t'
					@ステージ終了時処理 \
						1500 13451 -14000 2048 \
						//d00a4発動 \
						mv_a01d_a01e_0 \
						d:M_TYPE:NO_CHANGE
					eval($i:w01e_直前のマップ = 4)
					// 次の起動時チラリのために 0 を代入しておく。
					eval($f:w01d_食堂兵チラリルート起動時 = 0)

					eval($w:スタートアラートモード = d:ALERT_MODE_SENNYU)

				}else{

					print '５階へ普通のロード'
					preseek 'w01e'
					@ステージ終了時処理（ステージ名表示） \
						1500 13451 -14000 2048 \
						mv_a01d_a01e_0 \
						d:M_TYPE:NO_CHANGE \
						d:wn_船橋五階操舵室
					eval($i:w01e_直前のマップ = 4)
					// 次の起動時チラリのために 0 を代入しておく。
					eval($f:w01d_食堂兵チラリルート起動時 = 0)

				}
*/
				if( ( $b:ミッション番号 == d:MISSION:スネークテイルズ ) && \
					( $b:tales_story_no == d:TALES_NO:C ) && \
					( $b:tales_story_c < d:TALES_C:メリル遭遇終了 ) ) {
					// メリル遭遇デモ
					eval($w:スタートアラートモード = d:ALERT_MODE_SENNYU)
					preseek 'a01e'
					
					@ステージ終了時処理 \
						1500 13451 -14000 2048 \
						load_tal_a01e_mrl_demo \
						d:M_TYPE:NO_CHANGE
				} else if( ( $b:ミッション番号 == d:MISSION:スネークテイルズ ) && \
					( $b:tales_story_no == d:TALES_NO:C ) && \
					( $b:tales_story_c == d:TALES_C:大佐デモ終了 ) ) {
					// メリル戦前デモ
					$b:tales_story_c = d:TALES_C:メリル戦前デモ開始
					@ステージ終了時処理 \
						//1500 13451 -14000 2048 \		// ライデン時にバグるので
						1474,12500,-12400 2048 \
						load_tales_book \
						d:M_TYPE:NO_CHANGE
				} else {
					print '普通に艦橋へ'
					eval($w:スタートアラートモード = d:ALERT_MODE_SENNYU)
					preseek 'a01e'
					@ステージ終了時処理（ステージ名表示） \
						1500 13451 -14000 2048 \
						mv_a01d_a01e_0 \
						d:M_TYPE:NO_CHANGE \
						d:wn_船橋五階操舵室
					eval($i:w01e_直前のマップ = 4)
					// 次の起動時チラリのために 0 を代入しておく。
					eval($f:w01d_食堂兵チラリルート起動時 = 0)
				}
			}

		}

}

// 三階へ
proc ロード_三階へ移動 {
	trap ld001 d:PLAYER \
		-mask 入る \
		-exec {
			if(`%ゲームオーバーチェック` == 0 && $f:ロードチェックＯＮフラグ){
				preseek 'a01c'
				@ステージ終了時処理（ステージ名表示） \
					450 6000 -14000 0 \
					mv_a01d_a01c_0 \
					d:M_TYPE:NO_CHANGE \
					d:wn_船橋三階居住区
				eval($i:w01c_直前のマップ = 4)
			}
		}
}



// デバッグキャラ
// ------------------------------------

// 各カメラ
//---------------------------------------------------------------
// 食堂フロア
//---------------------------------------------------------------
proc 食堂南壁セット {
print '食堂壁２枚セット000'
	chara 天井君 食堂南壁Ｌ \
		-m w01d0_wall_L -p 0 0 0  -l w01d \
		-c 0 0 -8900 -a 5

	chara 天井君 食堂南壁Ｒ \
		-m w01d0_wall_R -p 0 0 0  -l w01d \
		-c 0 0 -8500 -a 5

	// 廊下から見た場合
	chara プットオブジェ 食堂南壁 \
		-m w01d0_wall_L \
		-r 0 0 0 \
		-p 0 0 0 \
		-l w01d

	trap shokudo d:PLAYER \
		-mask ？ \
		-camera \
		-exec {
			if($3 == 入る) {
				mesg プットオブジェ 食堂南壁 off
			} else {
				mesg プットオブジェ 食堂南壁 on
			}
		}

print '食堂壁２枚セット001'
}


























//###################################################################################
//								カメラ設定
//###################################################################################

// カメラ設定
// ------------------------------------
proc 各種カメラ作成 {
	chara カメラ ステージカメラ	-c 0 -l 3 -p 0
	chara カメラ サブカメラ１	-c 0 -l 2 -p 50
	chara カメラ サブカメラ２	-c 0 -l 2 -p 40
	chara カメラ サブカメラ３	-c 0 -l 2 -p 30
	chara カメラ サブカメラ４	-c 0 -l 2 -p 20 // 倉庫危険時俯瞰用に新設(00.10.09)
	chara カメラ ビヨンドカメラ	-c 0 -l 2 -p 10
	chara カメラ カットインカメラ -c 0 -l 0 -p 40
	chara カメラ クリアリングカメラ		-c 1 -l 2 -p 0


}

// デフォルトカメラ
proc デフォルトカメラセット {
	chara カメラ設定 ステージカメラ \
		-c 0 \
		-b -32000,-32000,-32000 32000,32000,32000 \
		-l -32000,-32000,-32000 32000,32000,32000 \
		-r 640,2048,0 \
		-f 6000 \
		-a 200 \
		-i 1 -1 0 0 \
		-s 1
}




proc 食堂カメラセット{

	trap ca000 d:PLAYER \
		-mask ＊ \
		-camera \
		-exec {

			// 危険モード時上俯瞰カメラ
			if($w:アラートモード == d:ALERT_MODE_KIKEN){
				if($3 == 入る){
					if($4 > -1250) {
						eval($w:カメラ補完方式 = 0)
					} else {
						eval($w:カメラ補完方式 = 1)
					}
				}

			// それほど上には引かない。旧メタルくらい。
				@CS_スムーズカメラ降順 $6 -16500 -19800 -12900 -16500
				eval($i:補完ＬＺ = $i:CS_結果１)

				// 部屋の手前半分にいるときの、Ｘ軸のリミットとバウンド
				@CS_スムーズカメラ降順 $6 -9000 -15500 -9000 -7800
				eval($i:補完ＢＸ = $i:CS_結果１)
				@CS_スムーズカメラ降順 $6 -9000 -15500 -4000 -5000
				eval($i:補完ＢＸ２ = $i:CS_結果１)


				chara カメラ設定 サブカメラ１ \
					-c 0 \
					-b $i:補完ＢＸ,15140,-12600      $i:補完ＢＸ２,15140,-8800 \
					-l $i:補完ＢＸ,10000,$i:補完ＬＺ $i:補完ＢＸ２,10000,-11500 \
					-r 600,2048,0 \
					-a 175 \
					-f 6500 \
					-i $w:カメラ補完方式 -1 0 0 \
					-s $3
			} else {


#if 1
				//左端
				if($4 < -10000){


					chara カメラ設定 サブカメラ１ \
						-c 1 \
						-p -9479,12159,-7005 \
						-t -9743,8851,-12557 \
						-a 175 \
						-i 3 -1 0 0 \
						-s $3


				//中央
				}else if($4 > -10000 && $4 < -6895){
					if($6 > -11977){
						eval($i:補完ＴＺ = -11977)

					}else if($6 < -15696){
						eval($i:補完ＴＺ = -15696)

					}else{
						eval($i:補完ＴＺ = $6)
					}


					@CS_スムーズカメラ昇順 $4 -10000 -6895 -9479 -6895
					eval($i:補完ＰＸ = $i:CS_結果１)

					@CS_スムーズカメラ昇順 $4 -10000 -6895 -9743 -6895
					eval($i:補完ＴＸ = $i:CS_結果１)

					@CS_スムーズカメラ昇順 $4 -10000 -6895 12159 12165
					eval($i:補完ＰＹ = $i:CS_結果１)

					@CS_スムーズカメラ昇順 $4 -10000 -6895 8851 9362
					eval($i:補完ＴＹ = $i:CS_結果１)

					@CS_スムーズカメラ昇順 $4 -10000 -6895 -7005 ($i:補完ＴＺ+ 5849)
					eval($i:補完ＰＺ = $i:CS_結果１)

					@CS_スムーズカメラ昇順 $4 -10000 -6895 -12557 $i:補完ＴＺ
					eval($i:補完ＴＺ = $i:CS_結果１)

					chara カメラ設定 サブカメラ１ \
						-c 1 \
						-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ \
						-t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ \
						-a 175 \
						-i 3 -1 0 0 \
						-s $3

				//右下
				}else if($4 > -6000 && $6 > -14000){


					//右下手前
					if($4 > -4000 && $6 > -10500){

						chara カメラ設定 サブカメラ１ \
							-c 1 \
							-p -3307,12367,-6313 \
							-t -3321,10612,-9347 \
							-a 175 \
							-i 1 -1 0 0 \
							-s $3

					//右下上
					}else if($4 > -4000){

						if($4 > -4926){
							eval($i:補完ＰＸ１ = -4926)

						}else{
							eval($i:補完ＰＸ１ = $4)
						}

						if($6 > -11977){
							eval($i:補完ＴＺ１ = -11977)

						}else{
							eval($i:補完ＴＺ１ = $6)

						}

						@CS_スムーズカメラ昇順 $6 -14000 -10500 $i:補完ＰＸ１ -3307
						eval($i:補完ＰＸ２ = $i:CS_結果１)

						@CS_スムーズカメラ昇順 $6 -14000 -10500 $i:補完ＰＸ１ -3321
						eval($i:補完ＴＸ = $i:CS_結果１)

						@CS_スムーズカメラ昇順 $6 -14000 -10500 12165 12367
						eval($i:補完ＰＹ = $i:CS_結果１)

						@CS_スムーズカメラ昇順 $6 -14000 -10500 9362 10612
						eval($i:補完ＴＹ = $i:CS_結果１)

						@CS_スムーズカメラ昇順 $6 -14000 -10500 ($i:補完ＴＺ１ + 5849) -6313
						eval($i:補完ＰＺ = $i:CS_結果１)

						@CS_スムーズカメラ昇順 $6 -14000 -10500 $i:補完ＴＺ１ -9347
						eval($i:補完ＴＺ２ = $i:CS_結果１)

						chara カメラ設定 サブカメラ１ \
							-c 1 \
							-p $i:補完ＰＸ２,$i:補完ＰＹ,$i:補完ＰＺ \
							-t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ２ \
							-a 175 \
							-i 3 -1 0 0 \
							-s $3

					//右下左
					}else{

						if($4 > -4926){
							eval($i:補完ＰＸ１ = -4926)

						}else{
							eval($i:補完ＰＸ１ = $4)
						}

						if($6 > -11977){
							eval($i:補完ＴＺ１ = -11977)

						}else{
							eval($i:補完ＴＺ１ = $6)

						}

						@CS_スムーズカメラ昇順 $4 -6000 -4000 $i:補完ＰＸ１ -3307
						eval($i:補完ＰＸ２ = $i:CS_結果１)

						@CS_スムーズカメラ昇順 $4 -6000 -4000 $i:補完ＰＸ１ -3321
						eval($i:補完ＴＸ = $i:CS_結果１)

						@CS_スムーズカメラ昇順 $4 -6000 -4000 12165 12367
						eval($i:補完ＰＹ = $i:CS_結果１)

						@CS_スムーズカメラ昇順 $4 -6000 -4000 9362 10612
						eval($i:補完ＴＹ = $i:CS_結果１)

						@CS_スムーズカメラ昇順 $4 -6000 -4000 ($i:補完ＴＺ１ + 5849) -6313
						eval($i:補完ＰＺ = $i:CS_結果１)

						@CS_スムーズカメラ昇順 $4 -6000 -4000 $i:補完ＴＺ１ -9347
						eval($i:補完ＴＺ２ = $i:CS_結果１)

						chara カメラ設定 サブカメラ１ \
							-c 1 \
							-p $i:補完ＰＸ２,$i:補完ＰＹ,$i:補完ＰＺ \
							-t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ２ \
							-a 175 \
							-i 3 -1 0 0 \
							-s $3

					}


				}else{

					if($4 > -4926){
						eval($i:補完ＰＸ = -4926)

					}else{
						eval($i:補完ＰＸ = $4)
					}

					if($6 > -11977){
						eval($i:補完ＴＺ = -11977)

					}else if($6 < -15696){
						eval($i:補完ＴＺ = -15696)

					}else{
						eval($i:補完ＴＺ = $6)
					}

					chara カメラ設定 サブカメラ１ \
						-c 1 \
						-p $i:補完ＰＸ,12165,($i:補完ＴＺ+ 5849) \
						-t $i:補完ＰＸ,9362,$i:補完ＴＺ \
						-a 175 \
						-i 1 -1 0 0 \
						-s $3
				}

#else
				chara カメラ設定 サブカメラ１ \
					-c 0 \
					-b -9465,12250,-14500 -3023,12250,-7450 \
					-l -9465,9500,-32000 -3023,9500,-12000 \
					-r 480,2048,0 \
					-a 175 \
					-f 6500 \
					-i 1 -1 0 0 \
					-s $3
#endif

			}


		}


//南ドアそば
	trap ev001 d:PLAYER \
		-mask ？ \
		-camera \
		-exec {
			print '食堂南側ドアそばカメラ'
			chara カメラ設定 サブカメラ２ \
				-c 1 \
				-p -1999,13064,-8389 \
				-t -2056,9955,-9935 \
				-a 200 \
				-i 0 -1 0 0 \
				-s $3

		}


//---------------------------------------------------------------
// テーブル向こう、ホフク１
//---------------------------------------------------------------
//---------------------------------------------------------------
// テーブル向こう、ホフク２
//---------------------------------------------------------------

//---------------------------------------------------------------
// 食堂ちゅう房内
//---------------------------------------------------------------
	trap ca002 d:PLAYER \
		-mask ？ \
		-camera \
		-exec {
			chara カメラ設定 サブカメラ１ \
				-c 0 \
				-b -32000,11586,-13715 32000,11586,-13715 \
				-l -32000,9474,-17039 32000,9474,-17039 \
				-r 390,2086,0 \
				-f 9636 \
				-a 166 \
				-i 1 -1 0 0 \
				-s $3
		}


//---------------------------------------------------------------
// 食堂ちゅう房内イントルード
//---------------------------------------------------------------
	trap ca002a d:PLAYER \
		-mask ？ \
		-camera \
		-state d:TRP_STATE_GROUND \
		-exec {
			if($w:アラートモード != d:ALERT_MODE_KIKEN) {
				chara カメラ設定 サブカメラ２ \
					-c 1 \
					-p -8426,13755,-17580 \
					-t -8423, 8542,-18150 \
					-a 170 \
					-i 1 -1 0 0 \
					-s $3
			} else {
				chara カメラ設定 サブカメラ２ \
					-c 1 \
					-p -7752,16291,-16446 -t -7749,11081,-16999 \
					-r 955,2045,0 -f 5239 \
					-a 166 \
					-i 1 -1 0 0 \
					-s $3
			}
		}



//---------------------------------------------------------------
// 食堂北側入り口向こうのカメラアングル
//---------------------------------------------------------------

	trap ca002b d:PLAYER \
		-mask ＊ \
		-camera \
		-exec {
			if($w:アラートモード != d:ALERT_MODE_KIKEN) {
				if($3 == 入る){
					if($4 > -1250) {
						eval($w:カメラ補完方式 = 0)
					} else {
						eval($w:カメラ補完方式 = 1)
					}
				}

				chara カメラ設定 サブカメラ２ \
					-c 1 \
					-p -2275,13078,-12807 -t -2402,9370,-14212 \
					-r 787,2107,0 -f 3968 \
					-a 147 \
					-i $w:カメラ補完方式 -1 0 0 \
					-s $3
			} else {
				chara カメラ設定 サブカメラ２ -s -1
			}
		}



//---------------------------------------------------------------
// 食堂ちゅう房内移動ビハインド
//---------------------------------------------------------------

	trap bh_ca000 d:PLAYER \
		-mask ＊ \
		-dir 0,256 \
		-state d:TRP_STATE_BEHINDCAMERA_ENABLE \ // 張り付き状態の時
		-camera \
		-exec {
			chara カメラ設定 サブカメラ２ \
				-c 0 \
				-b -8101,10920,-15590 -4992,10920,-15590 \
				-l -9809,10655,-18750 -6700,10655,-18750 \
				-r 390,2086,0 \
				-f 4636 \
				-a 180 \
				-i 1 -1 0 0 \
				-z d:CAMERA_NO_CUSHION \ // 遊び無しカメラ
				-s $3
		}



//---------------------------------------------------------------
// 監視カメラの下張り付き時カメラ
//---------------------------------------------------------------

	trap ev600 d:PLAYER \
		-mask ＊ \
		-dir 3072,256 \
		-camera \
		-state d:TRP_STATE_BEHINDCAMERA_ENABLE \ // 張り付き状態の時
		-exec {
			chara カメラ設定 サブカメラ１ \
				-c 0 \
				-b -5698,11110,-32000 -5968,11110,32000 \
				-l -1874,10580,-32000 -1874,10580,32000 \
				-r 1000,2086,0 \
				-f 4636 \
				-a 170 \
				-i 1 1 0 0 \
				-s $3 \
				-z d:CAMERA_NO_CUSHION
		}




//食堂南壁はりつきカメラ

	trap ca003 d:PLAYER \
		-mask ＊ \
		-camera \
		-state d:TRP_STATE_BEHINDCAMERA_ENABLE \ // 張り付き状態の時
		-dir 2048,512 \
		-exec {

			if( $4 > -4000 ){
				eval($i:補完ＰＸ = -4000)

			}else if( $4 < -8900 ){
				eval($i:補完ＰＸ = -8900 )

			}else{
				eval($i:補完ＰＸ = $4 )

			}

			chara カメラ設定 ビヨンドカメラ \
				-c 1 \
				-p $i:補完ＰＸ,16791,-10189 \
				-t $i:補完ＰＸ,10982,-11045 \
				-a 200 \
				-i 1 1 0 0 \
				-s $3
		}


}





//###################################################################################
//								廊下カメラ
//###################################################################################


// 各カメラ
//---------------------------------------------------------------
// 廊下フロア
//---------------------------------------------------------------
//---------------------------------------------------------------
// 南端の通路（左右）
//---------------------------------------------------------------
proc 廊下カメラセット{
	trap ca003_b d:PLAYER \
		-mask ＊ \
		-camera \
		-exec{

			if($3 == 入る) {
				if($4 < 0) {
					eval($w:カメラ補完方式 = 0)
				} else {
					eval($w:カメラ補完方式 = 3)
				}
			}


			if($4 < 0){

				if($4 < -500) {
					eval($w:カメラ補完方式 = 0)
				} else {
					eval($w:カメラ補完方式 = 3)
				}


				chara カメラ設定 サブカメラ１ \
					-c 1 \
					-p 327,11074,-6577 \
					-t 237,10432,-9026 \
					-a 170 \
					-i $w:カメラ補完方式 -1 0 0 \
					-s $3


			}else{

				chara カメラ設定 サブカメラ１ \
					-c 0 \
					-b 790,12040,-6590 5300,12040,-6590 \
					-l 850,10289,-9500 5300,10289,32000 \
					-r 398,2048,0 \
					-f 2544 \
					-a 170 \
					-i 3 -1 0 0 \
//					-i $w:カメラ補完方式 -1 0 0 \
					-slide 0 5 500 500 50 0 \
					-s $3

			}

		}




	//南側廊下はりつきカメラ
	trap ca003_b d:PLAYER \
		-mask ＊ \
		-camera \
		-state d:TRP_STATE_CAUTION \
		-dir 2048,256 \
		-exec{

			if( $4 > 5500 ){
				eval($i:補完ＰＸ = 5500)

			}else if( $4 < 450 ){
				eval($i:補完ＰＸ = 790 )

			}else{
				eval($i:補完ＰＸ = $4 )

			}

			chara カメラ設定 サブカメラ２ \
				-c 1 \
				-p $i:補完ＰＸ,13563,-8629 \
				-t $i:補完ＰＸ,11102,-9257 \
				-a 170 \
				-i 1 2 0 0 \
				-s $3

		}

	trap ca006 d:PLAYER \
		-mask ＊ \
		-camera \
		-exec{


				// 現在のカメラ番号を、かならず代入すること。
				// 倉庫での、戦時と平時のカメラ補完モード切替の判定に必要。
				eval($w:w01d_直前のカメラ番号 = d:廊下カメラ)

				// 下の通路から来たら、やや速いカメラ切り替え
				if($6 > -12000) {
					eval($w:カメラ補完方式 = 2)

				// 倉庫か左通路から来たら、瞬時カメラ切り替え
				} else {
					eval($w:カメラ補完方式 = 0)
				}


			if($3 == 入る && $6 > -17000){

				chara カメラ設定 サブカメラ２ \		//サブカメラ２なのは下のカメラに勝たせるため。
					-c 0 \
					-b 6000,11600,-19750 6000,11600,-8250 \
					-l 6000,-32000,-19750 6000,32000,-8350 \
					-r 390,2086,0 \
//					-f 4500 \
					-a 170 \
					-i $w:カメラ補完方式 -1 0 0 \
					-s $3 \
					-E 1 15 6000 4500 30 1

			}else{

				@CS_スムーズカメラ昇順 $6 -17250 -11250 11472 11246
				eval($i:補完ＰＹ = $i:CS_結果１)

				@CS_スムーズカメラ昇順 $6 -18250 -11250 -10907 -6336
				eval($i:補完ＰＺ = $i:CS_結果１)

				@CS_スムーズカメラ昇順 $6 -18250 -11250 5641 4189
				eval($i:補完ＴＸ = $i:CS_結果１)

				@CS_スムーズカメラ昇順 $6 -18250 -11250 9059 7349
				eval($i:補完ＴＹ = $i:CS_結果１)

				@CS_スムーズカメラ昇順 $6 -18250 -11250 -21886 -17201
				eval($i:補完ＴＺ = $i:CS_結果１)

				chara カメラ設定 サブカメラ１ \
					-c 1 \
					-p 6270,$i:補完ＰＹ,$i:補完ＰＺ \
					-t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ \
					-a 200 \
					-i 0 -1 0 0 \
					-s $3


			}

			if($3 == 出る){
				chara カメラ設定 サブカメラ２ \
					-s -1

			}
		}

//---------------------------------------------------------------
// フロア中央の通路（左右）
//---------------------------------------------------------------

	trap ca007 d:PLAYER \
		-mask ＊ \
		-camera \
		-exec{

			if($3 == 入る){
				if($4 < 3000 && $4 > 1000) {
					eval($w:カメラ補完方式 = 1)
				} else {
					eval($w:カメラ補完方式 = 0)
				}
			}

			chara カメラ設定 サブカメラ１ \
				-c 0 \
				-b 450, 14000,-13780 5000,14000,-13780 \
				-l 450,-32000,-14671 5000,32000,-14671 \
				-r 240,2048,0 \
				-f 6000 \
				-a 175 \
				-i $w:カメラ補完方式 -1 0 0 \
				-s $3 \
				-slide 0 10 800 800 30

		}


//---------------------------------------------------------------
// 上への階段。
//---------------------------------------------------------------

	trap ca008 d:PLAYER \
		-mask ＊ \
		-camera \
		-exec{
				@CS_スムーズカメラ降順 $6 -10250 -13250 11630 10700
				eval($i:補完ＰＹ = $i:CS_結果１)

				chara カメラ設定 サブカメラ１ \
					-c 1 \
					-p 1341,$i:補完ＰＹ,-8295 \
					-t 1430,$5,$6 \
					-a 170 \
					-i 3 2 0 0 \
					-s $3

		}


//---------------------------------------------------------------
// 下への階段に接する廊下（上下）
//---------------------------------------------------------------

	trap ca009 d:PLAYER \
		-mask ＊ \
		-camera \
		-exec{

			@CS_スムーズカメラ昇順 $6 -18000 -16000 4500 7000
			eval($w:補完距離 = $i:CS_結果１)


			chara カメラ設定 サブカメラ１ \
				-c 0 \
				-b 0, 11600,-19750 0,11600,-13220 \
				-l 0,-32000,-19750 0,32000,-13250 \
				-r 390,2086,0 \
				-f $w:補完距離 \
				-a 170 \
				-i 1 -1 0 0 \
				-s $3


		}










}





//###################################################################################
//								食糧倉庫カメラ設定
//###################################################################################

proc 倉庫カメラセット {


//---------------------------------------------------------------
// 食料倉庫手前半分
//---------------------------------------------------------------

	trap ca010 d:PLAYER \
		-mask ＊ \
		-camera \
		-exec {

			if($w:アラートモード != d:ALERT_MODE_KIKEN){

				if($3 != 出る) {
					eval($w:w01d_直前のカメラ番号 = d:平時倉庫カメラ)
				}


				//ca011でも使用しているので変更時注意！！

				@CS_スムーズカメラ昇順 $4 8750 11250 8893 10384
				eval($i:補完ＰＸ = $i:CS_結果１)

				@CS_スムーズカメラ昇順 $4 8750 11250 12133 12260
				eval($i:補完ＰＹ = $i:CS_結果１)

				@CS_スムーズカメラ昇順 $4 8750 11250 -8211 -7859
				eval($i:補完ＰＺ = $i:CS_結果１)

				@CS_スムーズカメラ昇順 $4 8750 11250 9282 10160
				eval($i:補完ＴＸ = $i:CS_結果１)

				@CS_スムーズカメラ昇順 $4 8750 11250 10328 10485
				eval($i:補完ＴＹ = $i:CS_結果１)

				@CS_スムーズカメラ昇順 $4 8750 11250 -10858 -10558
				eval($i:補完ＴＺ = $i:CS_結果１)

				//ca011でも使用しているので変更時注意！！


				chara カメラ設定 サブカメラ１ \
					-c 1 \
					-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ \
					-t $i:補完ＰＸ,$i:補完ＴＹ,$i:補完ＴＺ \
					-a 188 \
					-i 2 -1 0 0 \
					-s $3

			} else {
				chara カメラ設定 サブカメラ１ -s -1

			}

		}



//---------------------------------------------------------------
// 食料倉庫/棚の向こう側
//---------------------------------------------------------------
	trap ca011 d:PLAYER \
		-mask ＊ \
		-camera \
		-exec {

			if($w:アラートモード != d:ALERT_MODE_KIKEN){

				if(!$f:w01d_倉庫カメラセット２_切り替え通過フラグ) {
					// カメラの補完を廊下から来たときと、戦時および手前カメラからの移行で変える。
					print '$w:w01d_直前のカメラ番号'$w:w01d_直前のカメラ番号
					print d:廊下カメラ

					if($w:w01d_直前のカメラ番号 == d:廊下カメラ) {
						eval($w:カメラ補完方式 = 0) // 瞬時切り替え
						print '廊下から倉庫＿補完０'
					} else {
						eval($w:カメラ補完方式 = 2) // ゆっくり切り替え
						print '廊下から倉庫＿補完２'
					}
					eval($f:w01d_倉庫カメラセット２_切り替え通過フラグ = 1)
				}

				// ↓出るときにも代入してしまって、廊下の値を上書きしない様に。
				if($3 != 出る) {
					// 現在のカメラ番号を、かならず代入すること。
					eval($w:w01d_直前のカメラ番号 = d:平時倉庫カメラ)
				}



//食料倉庫手前半分のカメラを計算
				@CS_スムーズカメラ昇順 $4 8750 11250 8893 10384
				eval($i:補完ＰＸ１ = $i:CS_結果１)

				@CS_スムーズカメラ昇順 $4 8750 11250 12133 12260
				eval($i:補完ＰＹ１ = $i:CS_結果１)

				@CS_スムーズカメラ昇順 $4 8750 11250 -8211 -7859
				eval($i:補完ＰＺ１ = $i:CS_結果１)

				@CS_スムーズカメラ昇順 $4 8750 11250 9282 10160
				eval($i:補完ＴＸ１ = $i:CS_結果１)

				@CS_スムーズカメラ昇順 $4 8750 11250 10328 10485
				eval($i:補完ＴＹ１ = $i:CS_結果１)

				@CS_スムーズカメラ昇順 $4 8750 11250 -10858 -10558
				eval($i:補完ＴＺ１ = $i:CS_結果１)

//食料倉庫手前半分のカメラを計算



				@CS_スムーズカメラ昇順 $6 -18250 -15000 11135 $i:補完ＰＸ１
				eval($i:補完ＰＸ = $i:CS_結果１)

				@CS_スムーズカメラ昇順 $6 -18250 -15000 12791 $i:補完ＰＹ１
				eval($i:補完ＰＹ = $i:CS_結果１)

				@CS_スムーズカメラ昇順 $6 -18250 -15000 -12307 $i:補完ＰＺ１
				eval($i:補完ＰＺ = $i:CS_結果１)

				@CS_スムーズカメラ昇順 $6 -18250 -15000 10613 $i:補完ＴＸ１

//				@CS_スムーズカメラ昇順 $6 -18250 -15000 10713 $i:補完ＴＸ１
				eval($i:補完ＴＸ = $i:CS_結果１)

				@CS_スムーズカメラ昇順 $6 -18250 -15000 11889 $i:補完ＴＹ１
				eval($i:補完ＴＹ = $i:CS_結果１)

				@CS_スムーズカメラ昇順 $6 -18250 -15000 -13447 $i:補完ＴＺ１
				eval($i:補完ＴＺ = $i:CS_結果１)


				chara カメラ設定 サブカメラ２ \
					-c 1 \
					-p $i:補完ＰＸ,$i:補完ＰＹ,$i:補完ＰＺ \
					-t $i:補完ＴＸ,$i:補完ＴＹ,$i:補完ＴＺ \
					-a 188 \
					-i $w:カメラ補完方式 -1 0 0 \
					-s $3


			} else {
				eval($f:w01d_倉庫カメラセット２_切り替え通過フラグ = 0)
				chara カメラ設定 サブカメラ２ -s -1
			}

			if($3 == 出る) {
				eval($f:w01d_倉庫カメラセット２_切り替え通過フラグ = 0)
			}
		}


//---------------------------------------------------------------
// 同じく食料倉庫/棚の向こう側でホフク
//---------------------------------------------------------------
	trap ca012 d:PLAYER \
		-mask ＊ \
		-camera \
		-exec {
			if($w:アラートモード != d:ALERT_MODE_KIKEN){

				if($3 != 出る) {
					eval($w:w01d_直前のカメラ番号 = d:平時倉庫カメラ)
				}

				chara カメラ設定 サブカメラ３ \
					-c 1 \
					-p 9982,13454,-14148 \
					-t 10019,9308,-15426 \
					-a 200 \
					-i 3 -1 0 0 \
					-s $3

			} else {
				chara カメラ設定 サブカメラ３ -s -1
			}
		}


//---------------------------------------------------------------
// 食糧倉庫南端壁に張り付き
//---------------------------------------------------------------
	trap ca010 d:PLAYER \
		-mask ＊ \
		-camera \
		-state d:TRP_STATE_BEHINDCAMERA_ENABLE \ // 張り付き状態の時
		-dir 2048,256 \
		-exec {

			if($w:アラートモード != d:ALERT_MODE_KIKEN && $6 > -11250 ){

				if($3 != 出る) {
					eval($w:w01d_直前のカメラ番号 = d:平時倉庫カメラ)
				}

				chara カメラ設定 サブカメラ３ \
					-c 1 \
					-p 9902,14150,-9820 \
					-t 9883,10986,-10434 \
					-a 200 \
					-i 2 -1 0 0 \
					-s $3


			} else {
				chara カメラ設定 サブカメラ３ -s -1
			}

		}

}


//---------------------------------------------------------------
// 食料倉庫/戦闘時俯瞰カメラ
//---------------------------------------------------------------
proc 食糧倉庫での戦闘時俯瞰カメラセット {
	// 食堂と異なり、通常カメラのトラップが複雑に配置されているので、
	// 強いカメラで強制的に俯瞰に移行させる。
	trap ca013 d:PLAYER \
		-mask ＊ \
		-camera \
		-exec {
			// 危険モード時上俯瞰カメラ
			if($w:アラートモード == d:ALERT_MODE_KIKEN){
#if 1
				// rot_y を2048にしてスクロール（棚の側面はほとんど見えない）

				// 棚をはさんだ敵兵とスネーク両方が見えるように調整…
				@CS_スムーズカメラ昇順 $6 -19800 -16500 -17080 -13000
				eval($i:補完ＬＺ = $i:CS_結果１)


				// カメラの補完を廊下から来たときと倉庫内でのカメラ移行で変える。
				if($w:w01d_直前のカメラ番号 == d:廊下カメラ) {
					eval($w:カメラ補完方式 = 0) // 瞬時切り替え
				} else if ($w:w01d_直前のカメラ番号 == d:平時倉庫カメラ) {
					eval($w:カメラ補完方式 = 2) // ゆっくり切り替え
				}
				// 現在のカメラ番号を、かならず代入すること。
				eval($w:w01d_直前のカメラ番号 = d:戦時倉庫カメラ)

				chara カメラ設定 サブカメラ４ \
					-c 0 \
					-b 9600,12844,-12711       9600,12844,-8331 \
					-l 9600, 9346,$i:補完ＬＺ  9600,9346,-12376 \
					-r 590,2048,0 \
					-a 170 \
					-f 6500 \
					-i $w:カメラ補完方式 -1 0 0 \ // 2
					-s $3

#else
// スネークの位置によって、左右にカメラを振る（棚の側面が少し見える）

#endif

			// 危険モードを脱したら、俯瞰から出る。
			} else {
				chara カメラ設定 サブカメラ４ -s -1
			}
		}
}













//###################################################################################
//								食堂初めて入った時の処理
//###################################################################################




proc 共通シネマスクリーンセット {
	chara シネマスクリーン シネマ \
		-top d:CINEMA_BELT_UPPER \
		-bottom d:CINEMA_BELT_LOWER \
		-ftime 30	//デフォルト値（ゼロは駄目）
}



proc 北側寄りカメラ {
	chara カメラ設定 カットインカメラ \
		-c 1 \
		-p -6875,10524,-12089 -t -1472,10747,-14809 \
		-r -24,1328,0 -f 6053 \
		-a 200 \
		-i 0 -1 0 0 \
		-s 1

	chara delay ディレイい -time 15 -exec {
		chara カメラ設定 カットインカメラ \
			-c 1 \
			-p -6875,10524,-12089 -t -1023,11164,-13498 \
			-r 4027,1178,0 -f 6053 \
			-a 352 \
			-i 4 0 75 0 \
			-s 1
	}
}

proc 南側寄りカメラ {
	chara カメラ設定 カットインカメラ \
		-c 1 \
		-p -6100,10560,-13040 -t -987,10579,-9380 \
		-r 4094,619,0 -f 6288 \
		-a 200 \
		-i 0 -1 0 0 \
		-s 1

	chara delay ディレイい -time 15 -exec {
		chara カメラ設定 カットインカメラ \
			-c 1 \
			-p -6100,10568,-13040 -t 142,11309,-12896 \
			-r 4019,1009,0 -f 6288 \
			-a 323 \
			-i 4 0 75 0 \
			-s 1
	}
}




proc 初進入諸処理_北ドア {
	// 北回りの廊下兵がいるときは、とりあえずあっちへやる。
	if ($w:ゲーム設定 >= d:LEVEL_EXTREME) {
		mesg 警備兵 廊下巡回兵 ルート変更 8 \
			6000,9000,-9250 四階廊下_南半分
	}

	// スネークを、ちゃんと見える位置まで強制移動
	mesg プレイヤー d:PLAYER position \
		-1200 10030 -15000

	// スネーク、食堂巡回兵の方を見て…
	mesg プレイヤー d:PLAYER stance 0 \
		(3072+128) (3072+128) \
		d:FA_NO_WEAPON

	@北側寄りカメラ
}

proc 初進入諸処理_南ドア {
	// こちらの処理に入るということは、南回り兵は眠るなり何なり処理されている
	// はずなので本来は不要だが、念のために入れておく
	// 南回りの廊下兵がいるときは、とりあえずあっちへやる。
	if ($w:ゲーム設定 < d:LEVEL_EXTREME) {
		mesg 警備兵 廊下巡回兵 ルート変更 16 \
			6000,9000,-11000 四階廊下_南半分
	}

	// スネークを、ちゃんと見える位置まで強制移動
	mesg プレイヤー d:PLAYER position \
		-1200 10030 -9500

	// スネーク、食堂巡回兵の方を見て…
	mesg プレイヤー d:PLAYER stance 0 \
		(3072-128) (3072-128) \
		d:FA_NO_WEAPON

	@南側寄りカメラ
}






proc 食堂に入ってのスタートと終了処理{

	// 敵兵の視界カット。
//	mesg コマンダー 敵兵セット 視界オフ
	mesg 警備兵 食堂巡回兵 ルート変更 7 \
		-11250,9000,-10750 四階食堂 0 // ノード番号０の指定で、左舷方向を見させる


	command varsave $f:w01d_監視カメラ位置確認済み


	@シナリオデモ開始処理

	mesg プットオブジェ 食堂南壁 on

	// シナリオデモキャンセル
	chara デモキャンセルチェック デモキャンセル \
		-p 食堂に入ってカメラ位置確認キャンセル発動

	@カメラ位置確認デモ中発見されたキャンセル


	chara delay ディレイろ -time 135 -exec { // time はタメの45フレームを足した値。(*1)
		eval($f:w01d_監視カメラ視認カット済み = 1)


		print 'パッド操作キャンセル'
		@シナリオデモ終了処理

		chara カメラ設定 カットインカメラ -s -1

		if ($w:ゲーム設定 >= d:LEVEL_EXTREME) {
			// 北回り兵、巡回に復帰
			mesg 警備兵 廊下巡回兵 ルート変更 9 \
				6000,9000,-12500 四階廊下_北半分 4 // ノード番号４へ向けて移動。
		} else if ($w:ゲーム設定 == d:LEVEL_HARD) {
			// ハードの南回り兵、巡回に復帰
			mesg 警備兵 廊下巡回兵 ルート変更 15 \
				6000,9000,-11000 四階廊下_南半分 3 // ノード番号３へ向けて移動。
		} else {
			// ノーマルまでの南回り兵、巡回に復帰
			// ただし、スネークが室内に入れる隙を与える
			chara delay ディレイ -time 60 -exec {
				mesg 警備兵 廊下巡回兵 ルート変更 12 \
					6000,9000,-11000 四階廊下_南半分
			}
		}

		mesg プットオブジェ 食堂南壁 off


		mesg delay 発見キャンセルディレイ kill

		// 更に安全策として、視界復活まで少しタイムラグ
	}



}




proc カメラ位置確認デモ中発見されたキャンセル{


	chara delay 発見キャンセルディレイ \
		-time 1 \
		-exec {

			command ゲットゲームステータス \
				$i:ゲームステータス

			if($i:ゲームステータス & 0x00000001){		// 発見〜危険モードの間
				print 'キャンセル発動'
				@食堂に入ってカメラ位置確認キャンセル発動

				return 0
			}else{
				print 'キャンセルチェック'
				return 1

			}


		}

}











proc 食堂に入ってカメラ位置確認キャンセル発動 {

print 'キャンセル000'


	mesg デモキャンセルチェック デモキャンセル kill

	// 使用中のディレイをキル
	mesg delay ディレイい kill
	mesg delay ディレイろ kill
	mesg delay ディレイは kill

	mesg delay 発見キャンセルディレイ kill



print 'キャンセル001'
	// 各種終了
	eval($f:w01d_監視カメラ視認カット済み = 1)
print 'キャンセル002'
	print 'キャンセル'

print 'キャンセル003'
	chara delay キャンセルディレイ -time 2 -exec {
		chara カメラ設定 カットインカメラ -s -1
	}
print 'キャンセル004'
	chara delay ディレイ２ -time 31 -exec {
		@シナリオデモ終了処理

//		mesg レーダー レーダー on
	}
print 'キャンセル005'

	// 敵兵ルートを戻す
	if ($w:ゲーム設定 >= d:LEVEL_EXTREME) {
		// 北回り兵、巡回に復帰
		mesg 警備兵 廊下巡回兵 ルート変更 9 \
			6000,9000,-12500 四階廊下_北半分 4 // ノード番号４へ向けて移動。
	} else if ($w:ゲーム設定 == d:LEVEL_HARD) {
		// ハードの南回り兵、巡回に復帰
		mesg 警備兵 廊下巡回兵 ルート変更 15 \
			6000,9000,-11000 四階廊下_南半分 3 // ノード番号３へ向けて移動。
	} else {
		// ノーマルまでの南回り兵、巡回に復帰
		// ただし、スネークが室内に入れる隙を与える
		chara delay ディレイ -time 60 -exec {
			mesg 警備兵 廊下巡回兵 ルート変更 12 \
				6000,9000,-11000 四階廊下_南半分
		}
	}
print 'キャンセル006'

		// 壁の表示を消す
		mesg プットオブジェ 食堂南壁 off

print 'キャンセル007'
	// 安全策として、視界復活まで少しタイムラグ（これは残す）
	// 定点警備兵の位置によって、ディレイの時間を変える。ドア脇ならディレイ無しに。
	chara delay ディレイ３ -time 60 -exec {
		mesg コマンダー 敵兵セット 視界オン
	}
}





proc 監視カメラシナリオデモ中に発見された時処理 {
#if 0
	// 赤ビックリで発見されたとき
	if($4 == 5) {
		if(!$f:w01d_監視カメラシナリオデモ中に発見された) {
			@食堂に入ってカメラ位置確認キャンセル発動
			eval($f:w01d_監視カメラシナリオデモ中に発見された = 1)
		}
	}
#endif
}








