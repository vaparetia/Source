	}
}






//---------------------------------------------------------------
// 階段オブジェの表示切り替え
//---------------------------------------------------------------
// ３Ｆへの階段
proc ３Ｆへの階段オブジェの表示切り替えセット {
	chara プットオブジェ 客観時用_３Ｆへの階段オブジェ \
		-m w01d1_obj00 \
		-r 0 0 0 \
		-p 0 0 0 \
		-l w01d

#if 1
	chara プットオブジェ 主観時用_３Ｆへの階段オブジェ \
		-m w01d1_obj01 \
		-r 0 0 0 \
		-p 0 0 0 \
		-l w01d
#endif

	trap ev000 d:PLAYER \
		-state d:TRP_STATE_SUBJECT,d:TRP_STATE_BEHINDCAMERA_ENABLE \
		-mask ？ \
		-exec {
			if($3 == 入る){
				mesg プットオブジェ 主観時用_３Ｆへの階段オブジェ on
				mesg プットオブジェ 客観時用_３Ｆへの階段オブジェ off
			}else{
				mesg プットオブジェ 客観時用_３Ｆへの階段オブジェ on
				mesg プットオブジェ 主観時用_３Ｆへの階段オブジェ off
			}
		}
}

// ５Ｆへの階段
proc ５Ｆへの階段オブジェの表示切り替えセット {
#if 1
	chara プットオブジェ ５Ｆへの階段が見える時オブジェ \
		-m w01d1_obj02 \
		-r 0 0 0 \
		-p 0 0 0 \
		-l w01d
#endif

#if 1
	chara プットオブジェ ５Ｆへの階段が見えない時オブジェ \
		-m w01d1_obj03 \
		-r 0 0 0 \
		-p 0 0 0 \
		-l w01d
#endif

	trap ev001 d:PLAYER \
		-mask ？ \
		-exec {
			if($3 == 入る) {
				mesg プットオブジェ ５Ｆへの階段が見える時オブジェ on
				mesg プットオブジェ ５Ｆへの階段が見えない時オブジェ off
			} else {
				mesg プットオブジェ ５Ｆへの階段が見えない時オブジェ on
				mesg プットオブジェ ５Ｆへの階段が見える時オブジェ off
			}
		}

/* 改善の結果、以下のコメントアウト部分は必要なくなった
#if 1
	// 階段上にいる。
	trap ev002 d:PLAYER \
		-mask ？ \
		-exec {
			if($3 == 入る){
				eval($f:w01d_ev002_in = 1)
			} else {
				eval($f:w01d_ev002_in = 0)
			}
		}
#endif

	trap ev001 d:PLAYER \
		-mask ＊ \
		-exec {
				// 階段が画面内にある。
				if(`%カメラ視界チェック -camera 0x03 \
					-bound 1000 11800 -10250 2000 9000 -10200`) {
					mesg プットオブジェ ５Ｆへの階段が見える時オブジェ on
					mesg プットオブジェ ５Ｆへの階段が見えない時オブジェ off

				// 階段が画面内に無い。
				} else if(!`%カメラ視界チェック -camera 0x03 \
					-bound 1000 11800 -10250 2000 9000 -10200`) {

					// かつ、階段上にいない。
					if(!$f:w01d_ev002_in){
						mesg プットオブジェ ５Ｆへの階段が見えない時オブジェ on
						mesg プットオブジェ ５Ｆへの階段が見える時オブジェ off
					}
				} else if($3 == 出る) {
					mesg プットオブジェ ５Ｆへの階段が見えない時オブジェ on
					mesg プットオブジェ ５Ｆへの階段が見える時オブジェ off
				}
		}
*/

}

proc 階段オブジェの表示切り替えセット初期設定 {
// 前のステージが３Ｆの時これ。

	if($s:登場ポイント == a01cから来た) {
//	if($i:w01d_直前のマップ == 3) {
		mesg プットオブジェ ５Ｆへの階段が見える時オブジェ off
		mesg プットオブジェ 主観時用_３Ｆへの階段オブジェ off

// 前のステージが５Ｆの時はこっち。
	}else if($s:登場ポイント == a01eから来た) {
//	} else if($i:w01d_直前のマップ == 5) {
		mesg プットオブジェ ５Ｆへの階段が見えない時オブジェ off
		mesg プットオブジェ 客観時用_３Ｆへの階段オブジェ off
	}
}

// 南端の壁、ビハインド時消去
proc 南端の壁セット {
	chara 天井君 廊下南端壁消去制御 \
		-m w01d1_wall -p 0 0 0  -l w01d \
		-c 0 0 -8250 -a 5
//		-c 0 0 -8200 -a 5
	// -h と -c,-a,-n 及び -a と -n は共に排他オプションです
	// -h を使う場合はそれだけで完結（従来と同様）
	// -c を使う場合は -a もしくは -n でチェック軸の方向を指定（指定しないとY-になる）
	// -c で指定する座標は判定を行なう平面上の任意の座標です
	// （意味的にはその座標をチェック方向に越えると表示ONになる）
	// -a に指定する値
	// 0 ... X軸方向+でチェック
	// 1 ... X軸方向-でチェック
	// 2 ... Y軸方向+でチェック
	// 3 ... Y軸方向-でチェック （デフォルト）
	// 4 ... Z軸方向+でチェック
	// 5 ... Z軸方向-でチェック
	// -n はチェック方向直接指定。チェック方向のベクトルを指定。これを使うと斜めなども指定できる
	// -a 3 は -n 0,-100,0 と同義である

}













