#define	食堂巡回				0
#define	食堂中央待機			7
#define	北側ドア前待機			1
#define	北側ドア前巡回			11
#define	３Ｆ透明待機			28
#define	食堂西側巡回			17

#define	攻撃兵階下待機			2
#define	攻撃兵階上待機			14
#define	サポート兵階下待機		3
#define	廊下北側待機			8
#define	北廊下通常巡回短		18
#define	北廊下通常巡回長		19
#define	北廊下複雑巡回			9
#define	倉庫入口前巡回			23
#define	ＩＲ前巡回				24
#define	ＩＲ前巡回２			13

#define	南廊下通常巡回			12
#define	南廊下ＩＲチェック巡回	15

#define	東廊下突き当たり巡回	20



// ------------------------------------
proc 攻撃兵４ {
#if d:ATTACKER

	/* as of 00.10.20 */
	// ------------------------------------------------------------------
	// 警戒モード中のルート設定はかなり仮。
	// 実際は難易度、スネークの来た方向によってセットするルートを変える。
	// また、警戒態勢中に巡回兵のルートも変更してみる（←すこしやっかい
	// なので、ソニー後にじっくりやる）。
	// ------------------------------------------------------------------
	if($w:ゲーム設定 < d:LEVEL_EXTREME && $s:登場ポイント == a01cから来た) {
		print '３Ｆから来たときのアタッカー'
		eval( $b:ローカル変数Ｂ１ = d:攻撃兵階上待機 );
	}else{
		print '５Ｆから来たときのアタッカー'
		eval( $b:ローカル変数Ｂ１ = d:攻撃兵階下待機 );
	}

	chara アタッカー 敵兵４Ａ \
		-r $b:ローカル変数Ｂ１ \
		//-s d:ENE_STATUS_MODEL21 \
		-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
		-l $w:敵標準体力 \
		-f $w:敵標準気絶 \
		-e 0 \
		-q レーション_敵兵 25 \
		-c (22-1)

	chara アタッカー 敵兵４Ｂ \
		-r $b:ローカル変数Ｂ１ \
		//-s d:ENE_STATUS_MODEL21 \
		-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
		-l $w:敵標準体力 \
		-f $w:敵標準気絶 \
		-e 0 \
		-q レーション_敵兵 25 \
		-c (23-1)


#endif
}







proc 警備兵４ {
#if d:WATCHER

	chara 警備兵 休憩兵 -r (29-1) -n 0 \
		-d -3650,6000,-13900 四階廊下_北半分 \
		//-s 0b0011 \
		-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
		-l $w:敵標準体力 \
		-f $w:敵標準気絶 \
		-h $w:敵標準聴力 \
		-j ドッグタグ_敵兵 [dogtag:tnk_w01d_guard_ve_04] \
			[dogtag:tnk_w01d_guard_ea_04] [dogtag:tnk_w01d_guard_no_04] \
			[dogtag:tnk_w01d_guard_ha_04] [dogtag:tnk_w01d_guard_vh_04] \
		-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
		-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
		-w 倉庫休憩兵カメラ終了処理


/* 廊下巡回兵
＊三階から上がってきたとき
	<LEVEL_NORMALまで> :	南回り。角を回ってこない
	<LEVEL_HARD> :			南回り。角を回ってくる
	<LEVEL_EXTREME> :		北回り。チラ、を見せる
*/

	if($s:登場ポイント == a01cから来た) {
		if($w:ゲーム設定 <= d:LEVEL_NORMAL) {
			// 南回り
			chara 警備兵 廊下巡回兵 -r d:南廊下通常巡回 -n 0 \
				-d 6000,9000,-10000 四階廊下_南半分 \
				//-s 0b0011 \
				-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
				-l $w:敵標準体力 \
				-f $w:敵標準気絶 \
				-h $w:敵標準聴力 \
				-j ドッグタグ_敵兵 [dogtag:tnk_w01d_guard_ve_01] \
					[dogtag:tnk_w01d_guard_ea_01] [dogtag:tnk_w01d_guard_no_01] \
					[dogtag:tnk_w01d_guard_ha_01] [dogtag:tnk_w01d_guard_vh_01] \
				-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
				-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
				-w 監視カメラシナリオデモ中に発見された時処理

		} else if ($w:ゲーム設定 == d:LEVEL_HARD) {
			chara 警備兵 廊下巡回兵 -r d:南廊下ＩＲチェック巡回 -n 0 \
				-d 6000,9000,-10000 四階廊下_南半分 \
				//-s 0b0011 \
				-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
				-l $w:敵標準体力 \
				-f $w:敵標準気絶 \
				-h $w:敵標準聴力 \
				-j ドッグタグ_敵兵 [dogtag:tnk_w01d_guard_ve_01] \
					[dogtag:tnk_w01d_guard_ea_01] [dogtag:tnk_w01d_guard_no_01] \
					[dogtag:tnk_w01d_guard_ha_01] [dogtag:tnk_w01d_guard_vh_01] \
				-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
				-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
				-w 監視カメラシナリオデモ中に発見された時処理

		} else {
			// 北回りルート
			// チラ、を見せるために、ドア脇の一点に出現
			chara 警備兵 廊下巡回兵 -r d:北側ドア前待機 -n 0 \
				-d 6000,9000,-13000 四階廊下_北半分 \
				//-s 0b0011 \
				-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
				-l $w:敵標準体力 \
				-f $w:敵標準気絶 \
				-h $w:敵標準聴力 \
				-j ドッグタグ_敵兵 [dogtag:tnk_w01d_guard_ve_01] \
					[dogtag:tnk_w01d_guard_ea_01] [dogtag:tnk_w01d_guard_no_01] \
					[dogtag:tnk_w01d_guard_ha_01] [dogtag:tnk_w01d_guard_vh_01] \
				-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
				-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
				-w 監視カメラシナリオデモ中に発見された時処理

			/* この後すぐにルートチェンジが入って、北回り巡回ルートに
			移動する */
			// #エクストリーム北回り　で実施
		}

	} else {

		/* 廊下巡回兵
		＊五階から降りてきたとき
			<LEVEL_NORMALまで> :	北回り。
			<LEVEL_HARD以上> :			北回り。角を回ってくる
		*/
		if ($w:ゲーム設定 <= d:LEVEL_NORMAL) {
			// 北回り
			chara 警備兵 廊下巡回兵 -r d:北廊下通常巡回短 -n 0 \
				-d 6000,9000,-12750 四階廊下_北半分 \
				//-s 0b0011 \
				-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
				-l $w:敵標準体力 \
				-f $w:敵標準気絶 \
				-h $w:敵標準聴力 \
				-j ドッグタグ_敵兵 [dogtag:tnk_w01d_guard_ve_01] \
					[dogtag:tnk_w01d_guard_ea_01] [dogtag:tnk_w01d_guard_no_01] \
					[dogtag:tnk_w01d_guard_ha_01] [dogtag:tnk_w01d_guard_vh_01] \
				-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
				-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
				-w 監視カメラシナリオデモ中に発見された時処理

		} else if ($w:ゲーム設定 >= d:LEVEL_HARD) {
			chara 警備兵 廊下巡回兵 -r d:北廊下通常巡回長 -n 0 \
				-d 6000,9000,-14500 四階廊下_北半分 \
				//-s 0b0011 \
				-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
				-l $w:敵標準体力 \
				-f $w:敵標準気絶 \
				-h $w:敵標準聴力 \
				-j ドッグタグ_敵兵 [dogtag:tnk_w01d_guard_ve_01] \
					[dogtag:tnk_w01d_guard_ea_01] [dogtag:tnk_w01d_guard_no_01] \
					[dogtag:tnk_w01d_guard_ha_01] [dogtag:tnk_w01d_guard_vh_01] \
				-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
				-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
				-w 監視カメラシナリオデモ中に発見された時処理

		}

	}



/* 廊下巡回兵２
<LEVEL_HARD>：		倉庫の前に置く。定点警備。
<LEVEL_EXTREME>：	赤外線の南側を、短いトラックで巡回警備。
*/

	if($w:ゲーム設定 == d:LEVEL_HARD) {
		chara 警備兵 廊下巡回兵２ -r d:倉庫入口前巡回 -n 0 \
			-d 6500,9000,-17750 四階廊下_北半分 \
			//-s 0b0011 \
			-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
			-l $w:敵標準体力 \
			-f $w:敵標準気絶 \
			-h $w:敵標準聴力 \
			-j ドッグタグ_敵兵 [dogtag:dummy] \
				[dogtag:dummy] [dogtag:dummy] \
				[dogtag:tnk_w01d_guard_ha_02] [dogtag:tnk_w01d_guard_vh_02] \
			-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
			-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
			-w 監視カメラシナリオデモ中に発見された時処理

	} else if($w:ゲーム設定 >= d:LEVEL_EXTREME) {
		chara 警備兵 廊下巡回兵２ -r d:ＩＲ前巡回 -n 0 \
			-d 6000,9000,-9750 四階廊下_南半分 \ // 守備位置指定は意味がない
			//-s 0b0011 \
			-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
			-l $w:敵標準体力 \
			-f $w:敵標準気絶 \
			-h $w:敵標準聴力 \
			-j ドッグタグ_敵兵 [dogtag:dummy] \
				[dogtag:dummy] [dogtag:dummy] \
				[dogtag:tnk_w01d_guard_ha_02] [dogtag:tnk_w01d_guard_vh_02] \
			-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
			-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
			-w 監視カメラシナリオデモ中に発見された時処理

	}

	/* 食堂巡回兵
	<LEVEL_EASYまで>：		出現しない
	<LEVEL_HARDまで> :		チラ、を見せてから、食堂へ入って定点警備
	<LEVEL_EXTREME> :		最初から食堂で定点警備（チラ、は廊下兵がやるので）
	*/

	if (($w:ゲーム設定 == d:LEVEL_NORMAL) || \
		($w:ゲーム設定 == d:LEVEL_HARD)) {

			// 入ったとき潜入モードならば、チラ、を見せる
			if($w:アラートモード == d:ALERT_MODE_SENNYU){
print '食堂兵潜入モード'

				chara 警備兵 食堂巡回兵 -r d:北側ドア前巡回 -n 0 \
					//-d -7000,9000,-9500 0 \
					-d -7000,9000,-14000 四階食堂 \
					//-s 0b0011 \
					-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
					-l $w:敵標準体力 \
					-f $w:敵標準気絶 \
					-h $w:敵標準聴力 \
					-j ドッグタグ_敵兵 [dogtag:dummy] \
						[dogtag:dummy] [dogtag:tnk_w01d_guard_no_03] \
						[dogtag:tnk_w01d_guard_ha_03] [dogtag:tnk_w01d_guard_vh_03] \
					-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
					-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
					-w 監視カメラシナリオデモ中に発見された時処理

			} else {
print '食堂兵非潜入モード'
				// 入ったとき潜入モード以外ならば、最初から定点警備状態
				chara 警備兵 食堂巡回兵 -r d:食堂中央待機 -n 0 \
					-d -7250,9000,-10500 四階食堂 \
					//-s 0b0011 \
					-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
					-l $w:敵標準体力 \
					-f $w:敵標準気絶 \
					-h $w:敵標準聴力 \
					-j ドッグタグ_敵兵 [dogtag:dummy] \
						[dogtag:dummy] [dogtag:tnk_w01d_guard_no_03] \
						[dogtag:tnk_w01d_guard_ha_03] [dogtag:tnk_w01d_guard_vh_03] \
					-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
					-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
					-w 監視カメラシナリオデモ中に発見された時処理
			}

		} else if ($w:ゲーム設定 >= d:LEVEL_EXTREME) {
print '食堂兵エクストリーム'
			// エクストリームのみ、視界が大きいためルート１７で警備
			chara 警備兵 食堂巡回兵 -r d:食堂西側巡回 -n 0 \
				-d -7000,9000,-18150 四階食堂 \
				//-s 0b0011 \
				-i $w:敵潜入視力 $w:敵危険視力 $w:敵回避視力 \
				-l $w:敵標準体力 \
				-f $w:敵標準気絶 \
				-h $w:敵標準聴力 \
					-j ドッグタグ_敵兵 [dogtag:dummy] \
						[dogtag:dummy] [dogtag:tnk_w01d_guard_no_03] \
						[dogtag:tnk_w01d_guard_ha_03] [dogtag:tnk_w01d_guard_vh_03] \
				-q 引きずり１ $b:アイテム率１ 引きずり２ $b:アイテム率２ 引きずり３ $b:アイテム率３ \
				-a ホールドアップ１ $b:アイテム率１ ホールドアップ２ $b:アイテム率２ ホールドアップ３ $b:アイテム率３ \
				-w 監視カメラシナリオデモ中に発見された時処理
		}


#endif
}

proc 警備兵コマンダー４ {
print 'keibi_sol_000'
	chara 警備コマンダー wccomm -e {警備兵４}
print 'keibi_sol_001'
}

proc 攻撃兵コマンダー４ {
	chara 攻撃コマンダー atcomm -e {攻撃兵４} \
		-wait	(60*3) \	//危険開始時の出動遅らせ時間
		-avoidwait (60*5) \	//回避モードで始まる場合のみ有効
		-cover 3 \
			  -7000,9000,-16500 -2500,11000,-9000 \		// 食堂のテーブル
			  -11500,9000,-16500 -7000,11000,-9000 \	// 食堂のテーブル
			   8250,9000,-16000 11750,11000,-9500		// 倉庫の棚
print 'enemy_008'
}

proc 四階敵兵セット {
#if d:SOLDIERS
		chara コマンダー 敵兵セット \
			-w 警備兵コマンダー４ \
	#if d:ATTACKER
			-a 攻撃兵コマンダー４ \
	#endif
			-r -3650,6000,-13900 四階廊下_北半分 \
			-c -3650,6000,-13900 四階廊下_北半分 \
			-m $w:スタートアラートモード \
			-p 0,-1,-1 倉庫クリアリングエリア１初期設定 \
			  -2,-2,-2 クリアリングカメラＯＦＦ \
			-x [ghq_area_alert_voice:w01d] \
			-y [ghq_caution_voice:w01d] \
			-v [ene_tank_voice:01] \
			-g 0 \
			-z $i:敵標準麻酔持続 \
			-o $i:敵標準気絶持続 \
			-b $w:敵標準再発生数 \
			-h $i:標準警戒時間
#endif
}





// 敵兵ルートチェンジ
// ------------------------------------
// 潜入モード時


proc 巡回兵ルートチェンジ_潜入モード時セット {

// ---------------------------------------------------------------------
// スネークが食堂にはいると、厨房内の敵が巡回開始
// これは各難易度レベル共通
// ---------------------------------------------------------------------
	trap ev500 d:PLAYER \
		-mask ？ \
		-exec {
			if($3 == 入る) {
				if($w:アラートモード == d:ALERT_MODE_SENNYU){
					// 監視カメラ視認カット時には、視認カット時間分遅らせる。
					if(!$f:w01d_監視カメラ視認カット済み) {
						// 巡回開始
						chara delay ディレイ -time (135+60) -exec { // time(*1)プラスα
							mesg 警備兵 食堂巡回兵 ルート変更 d:食堂巡回 \
								-11250,9000,-10750 四階食堂 0 // 潜入モード時では、ポイント０を目指す
						}
					} else {
						// 巡回開始
						mesg 警備兵 食堂巡回兵 ルート変更 d:食堂巡回 \
							-11250,9000,-10750 四階食堂 0 // 潜入モード時では、ポイント０を目指す
					}
				}
			} else {
				if($w:アラートモード == d:ALERT_MODE_SENNYU){
					// 食堂奥、ルート１７での警備に復帰
					mesg 警備兵 食堂巡回兵 ルート変更 d:食堂西側巡回 \
						-7000,9000,-18150 四階食堂
				}
			}
		}




// ---------------------------------------------------------------------
// 始まってすぐ、巡回兵は恒常巡回（警備）ルートへ移動＞チラリ見え演出のため
// ---------------------------------------------------------------------
	// #エクストリーム北回り　'廊下巡回兵'（↓食堂兵は最初から定点警備している）
	// 三階からスネークが上がってきた場合のみ発動
	if ($w:ゲーム設定 >= d:LEVEL_EXTREME) {
		if($s:登場ポイント == a01cから来た) {
			if($w:アラートモード == d:ALERT_MODE_SENNYU){
			// 廊下巡回兵は、いったんちらっと映ってから、赤外線より北を巡回する。
				mesg 警備兵 廊下巡回兵 ルート変更 d:北廊下複雑巡回 \
					6000,9000,-13000 四階廊下_北半分 0
			}
		}
	// ハードまでの　'食堂巡回兵'（エクストリーム兵は、最初から食堂内にて警備開始）
	} else {
		if($w:アラートモード == d:ALERT_MODE_SENNYU){
			// 食堂巡回兵が、いったんチラっと映ってから、食堂で定点警備開始。
			mesg 警備兵 食堂巡回兵 ルート変更 d:食堂中央待機 \
				-11250,9000,-10750 四階食堂 0
		}
	}

// ---------------------------------------------------------------------
// スネークが食堂南ドアに近づくと、廊下の東の方へ（南ドアを出ていきなりのはち合わせ防止）
// ---------------------------------------------------------------------
	// 南回りはエクストリーム以外で、かつ三階から上がってきたとき
	if ($w:ゲーム設定 < d:LEVEL_EXTREME) {
		trap ev501 d:PLAYER \
			-mask ＊ \
			-exec {
				if(($3 == いる) || ($3 == 入る)) {
					if($w:アラートモード == d:ALERT_MODE_SENNYU){
//print '$f:w01d_はち合わせ防止ＯＮ'
//print $f:w01d_はち合わせ防止ＯＮ
						if(!$f:w01d_はち合わせ防止ＯＮ) {
							if($s:登場ポイント == a01cから来た) {
//print '警備兵 廊下巡回兵 ルート変更 はち合わせ防止'
								mesg 警備兵 廊下巡回兵 ルート変更 d:ＩＲ前巡回２ \
									6000,9000,-10000 四階廊下_南半分
							} else {
print '警備兵 廊下巡回兵 ルート変更 はち合わせ防止'
								mesg 警備兵 廊下巡回兵 ルート変更 d:東廊下突き当たり巡回 \
									6000,9000,-13000 四階廊下_北半分
							}
						}
						eval($f:w01d_はち合わせ防止ＯＮ = 1)
					} else {
						eval($f:w01d_はち合わせ防止ＯＮ = 0)
					}
				} else {
					if ($w:ゲーム設定 == d:LEVEL_HARD) {
//print '警備兵 廊下巡回兵 ルート変更 はち合わせ防止おわり'
						// いきなり戻ってきて結局はち合わせる事態の防止としてディレイ
//print '$f:w01d_はち合わせ防止ＯＦＦ'
//print $f:w01d_はち合わせ防止ＯＮ
						chara delay ディレイ -time 60 -exec {
							if($s:登場ポイント == a01cから来た) {
								mesg 警備兵 廊下巡回兵 ルート変更 d:南廊下ＩＲチェック巡回 \
									6000,9000,-10000 四階廊下_南半分 0
							} else {
print '$f:w01d_はち合わせ防止ＯＦＦ'
print $f:w01d_はち合わせ防止ＯＮ
								mesg 警備兵 廊下巡回兵 ルート変更 d:北廊下通常巡回長 \
									6000,9000,-13000 四階廊下_北半分 0
							}
						}
						eval($f:w01d_はち合わせ防止ＯＮ = 0)
					} else {
//print '警備兵 廊下巡回兵 ルート変更 はち合わせ防止おわり'
						// いきなり戻ってきて結局はち合わせる事態の防止としてディレイ
//print '$f:w01d_はち合わせ防止ＯＦＦ'
//print $f:w01d_はち合わせ防止ＯＮ
						chara delay ディレイ -time 120 -exec {
							if($s:登場ポイント == a01cから来た) {
								mesg 警備兵 廊下巡回兵 ルート変更 d:南廊下通常巡回 \
									6000,9000,-10000 四階廊下_南半分 0
							} else {
print '$f:w01d_はち合わせ防止ＯＦＦ'
print $f:w01d_はち合わせ防止ＯＮ
								mesg 警備兵 廊下巡回兵 ルート変更 d:北廊下通常巡回短 \
									6000,9000,-13000 四階廊下_北半分 0
							}
						}
						eval($f:w01d_はち合わせ防止ＯＮ = 0)
					}
				}
		}
	}


}

proc 巡回兵ルートチェンジ_戦闘中セット {
	/* 主に、戦闘で３（４）対１のタコ殴りにあい不条理感を感じないように
	また、倉庫へ追い込んでクリアリングを発生させやすくする為の守備位置変更
	実際には、警備兵のルートチェンジを行っている
	*/

	/* 基本原則
	＜食堂＞
		スネークが一度に相手にする敵兵の数は、最大２名とする
	＜廊下＞
		ノーマルまでは、通路に出た瞬間に廊下の端から撃たれないように
		IRのすぐ際に配置
	＜倉庫＞
		なし
	*/

	// ------------------------------------------------------------ //
	// 							注意！								//
	// 危険モードに入った直後は、食堂兵はデフォルトの守備位置で戦う //
	// ------------------------------------------------------------ //

	// 食堂にスネークはいるかチェック、および
	// 食堂に敵兵の数が何人いるかチェック
	trap shokudo ？ \
		-mask ？ \
		-exec {
				if($2 == d:PLAYER) {
					if($3 == 入る) {

print '$b:w01d_食堂在中攻撃兵数'
print $b:w01d_食堂在中攻撃兵数


						eval($f:w01d_スネーク食堂にいる = 1)
					} else {
						eval($f:w01d_スネーク食堂にいる = 0)
						// ↓「#スネーク食堂にいないので、食堂兵は食堂を守備」に対応
						// その下の代入文も、同じ代入文と対応
						@食堂巡回兵_守備位置変更 -7000 -12000
						eval($f:w01d_食堂兵_食堂での追跡モードに入る = 0)
print 'スネーク食堂から出る。食堂兵、食堂の守備へ'
					}
				}

				// 敵兵
				if($2 == 敵兵４Ａ) {
					if($3 == 入る) {
print '敵兵４Ａ入る'
						eval($b:w01d_食堂在中攻撃兵数 = $b:w01d_食堂在中攻撃兵数 + 1)
					} else {
print '敵兵４Ａ出る'
						eval($b:w01d_食堂在中攻撃兵数 = $b:w01d_食堂在中攻撃兵数 - 1)
					}
				}
				if($2 == 敵兵４Ｂ) {
					if($3 == 入る) {
print '敵兵４B入る'
						eval($b:w01d_食堂在中攻撃兵数 = $b:w01d_食堂在中攻撃兵数 + 1)
					} else {
print '敵兵４B出る'
						eval($b:w01d_食堂在中攻撃兵数 = $b:w01d_食堂在中攻撃兵数 - 1)
					}
				}
#if 0
				if($2 == 食堂巡回兵) {
					if($3 == 入る) {
						eval($b:w01d_食堂在中敵兵数 = $b:w01d_食堂在中敵兵数 + 1)
					} else {
						eval($b:w01d_食堂在中敵兵数 = $b:w01d_食堂在中敵兵数 - 1)
					}
				}
				/* 廊下巡回兵は勘定に入れない */
#endif
			}

	// 食堂での動的な敵兵守備セット
	// 食堂にいる敵兵の数に応じ、食堂巡回兵を参戦させる
	trap shokudo d:PLAYER \
		-mask ＊ \
		-exec {
			if($3 == いる) {

				// 攻撃兵が二名食堂にいたら
				// 廊下に待避する場合の守備位置をセット
				if($b:w01d_食堂在中攻撃兵数 == 2) {
//				if($b:w01d_食堂在中敵兵数 > 2) {

//print '$b:w01d_食堂在中敵兵数二人以上'
//print $b:w01d_食堂在中敵兵数

					// エクストリーム以外では北廊下へ
					// かつ、スネークのＸ座標によって、守備位置も変える
					// （参戦する速度調整と、IR脇の守備のため）
					if ($w:ゲーム設定 < d:LEVEL_EXTREME) {

						// スネークがドアに近づいたら、IRの脇へ下がる
						if($4 > -6250) {
							if(!$f:w01d_スネーク戦闘中に食堂のドアに近づく) {
//								@食堂巡回兵_守備位置変更 6000 -12500
								@食堂巡回兵_守備位置変更 1500 -14500
								eval($f:w01d_スネーク戦闘中に食堂のドアに近づく = 1)
print '食堂兵、ＩＲまで下がる'
							}
						// スネークがドアから離れたら、ドアの近くで待機
						} else {
							if($f:w01d_スネーク戦闘中に食堂のドアに近づく) {
//								@食堂巡回兵_守備位置変更 1500 -14500
								@食堂巡回兵_守備位置変更 6000 -12500
								eval($f:w01d_スネーク戦闘中に食堂のドアに近づく = 0)
print '食堂兵、食堂ドアのそばへ'
							}
						}

					// エクストリームの場合は、南廊下へ
					} else {
					}

				// 敵攻撃兵数が一名以下になり、なおかつスネークが食堂にいるならば食堂兵も参戦
				// スネークが食堂にいない場合は、食堂を守備する
				// 各難易度で共通
				} else if($b:w01d_食堂在中攻撃兵数 <= 1) {
//				} else if($b:w01d_食堂在中敵兵数 < 2) {
					if($f:w01d_スネーク食堂にいる) {
						if(!$f:w01d_食堂兵_食堂での追跡モードに入る) {
							print '食堂巡回兵追跡モードに入りました！！'
//							@食堂巡回兵_守備位置変更_追跡モード
//							eval($f:w01d_食堂兵_食堂での追跡モードに入る = 1)
/*
print '$b:w01d_食堂在中敵兵数二人いない'
print $b:w01d_食堂在中敵兵数
print '食堂兵、食堂での戦闘に参加'
*/
						}

					/* 後々の混乱防止のため、何を意図したか残す。消すな！
					この処理は、↑スネークが食堂を出るところで発動
					#スネーク食堂にいないので、食堂兵は食堂を守備
					} else {
						@食堂巡回兵_守備位置変更 -7000 -12000
					*/

					}
				}
			}
		}

	// 廊下巡回兵の、守備位置変更セット
	// 廊下兵はそもそものデフォルト守備位置として、IR脇を指定してある
	// 以下はそれ以後、どのように機動するかの記述
	trap ？ d:PLAYER \
		-mask ＊ \
		-exec {

			// エクストリーム以外で、
			if ($w:ゲーム設定 < d:LEVEL_EXTREME) {

				// 北廊下にスネーク入ったら
				if($1 == roka_kita) {
					if($3 == 入る) {

						// ハードでは、IRの脇に待機してスネークに射弾を浴びせる（＝位置変更させず）
						// それ以外では廊下の角の少し内側へ下がって、対スネーク射撃チャンスを減らす
						if ($w:ゲーム設定 != d:LEVEL_HARD) {
							// スネーク三階から来たとき（南廊下巡回パターン）
							if($s:登場ポイント == a01cから来た) {
								@廊下巡回兵_守備位置変更 4875 -9250
print 'スネーク北廊下へ。廊下兵、ＩＲから少しはずれ、廊下の陰へ'

							// スネーク五階から来たとき（北廊下巡回パターン）
							} else {
								@廊下巡回兵_守備位置変更 6000 -12750
print 'スネーク北廊下へ。廊下兵、ＩＲから少しはずれ、廊下の陰へ'
							}
						}
					}

				// 南廊下にスネーク入ったら
				} else if($1 == roka_minami) {
					if($3 == 入る) {

						// ハードではスネークの正面に出て、スネークに射弾を浴びせる
						if ($w:ゲーム設定 == d:LEVEL_HARD) {
							// スネーク三階から来たとき（南廊下巡回パターン）
							if($s:登場ポイント == a01cから来た) {
								@廊下巡回兵_守備位置変更 4875 -9250
print 'スネーク南廊下へ。廊下兵、スネークの正面へ'

							// スネーク五階から来たとき（北廊下巡回パターン）
							// なるべく南廊下がよく見えるように移動
							} else {
								@廊下巡回兵_守備位置変更 6500 -12750
							}

						// それ以外では、IRの脇に待機して対スネーク射撃チャンスを減らす
						} else {
							// スネーク三階から来たとき（南廊下巡回パターン）
							if($s:登場ポイント == a01cから来た) {
								@廊下巡回兵_守備位置変更 6000 -11000
print 'スネーク南廊下へ。廊下兵、ＩＲの脇へ下がる'

							// スネーク五階から来たとき（北廊下巡回パターン）
							// なるべく南廊下がよく見えるように移動（ハード時と同じ位置）
							} else {
								@廊下巡回兵_守備位置変更 6500 -12750
							}
						}
					}
				}
			// エクストリーム（北巡回パターン）
			} else {
			}
		}

}


// 攻撃兵待機ルートチェンジ（＝攻撃兵の再出現ポイント調節）
proc 攻撃兵待機ルートチェンジセット {

	/* 基本原則
	＜ハードモードまで＞
		ステージロード時には、スネークが入ってきた側とは反対側の
		待機ポイントから出現。
	＜エクストリーム＞
		常に三階から出現（三階からは、必ず潜入モードで入らないと厳しい）
	*/

	/* その後、
	＜ハードモードまで＞
		スネークが廊下_北半分、食堂にいるときは五階から、
		廊下_南半分にいるときは三階から、敵は上がってくる。
		倉庫にいるときは特に変化させる必要なし
	＜エクストリーム＞
		常に三階から上がってくる
	*/

	trap roka_kita d:PLAYER \
		-mask ？ \
		-exec {
			if($3 == 入る) {
				// roka_kita は「廊下_北半分」
				print 'スネークは廊下_北半分に入った'
				mesg アタッカー 敵兵４Ａ ルート変更 d:攻撃兵階上待機
				mesg アタッカー 敵兵４Ｂ ルート変更 d:攻撃兵階上待機
			}
		}
	trap roka_minami d:PLAYER \
		-mask ？ \
		-exec {
			if($3 == 入る) {
				// roka_minami は「廊下_南半分」
				print 'スネークは廊下_南半分に入った'
				mesg アタッカー 敵兵４Ａ ルート変更 d:攻撃兵階下待機
				mesg アタッカー 敵兵４Ｂ ルート変更 d:攻撃兵階下待機
			}
		}

}

// ルートチェンジ指令プロック
proc 食堂巡回兵_守備位置変更 $:w01d_食堂巡回兵Ｘ座標 \
							 $:w01d_食堂巡回兵Ｚ座標
{

// グループ名自動判別
	if($:w01d_食堂巡回兵Ｘ座標 < -1100) {
	print 'proc側_四階食堂'
		eval($s:w01d_食堂巡回兵の居るグループ名 = 四階食堂)
	} else if ($:w01d_食堂巡回兵Ｘ座標 > 7125) {
	print 'proc側_四階倉庫'
		eval($s:w01d_食堂巡回兵の居るグループ名 = 四階倉庫)
	} else {
		if($:w01d_食堂巡回兵Ｚ座標 < -11750) {
	print 'proc側_四階廊下_北半分'
			eval($s:w01d_食堂巡回兵の居るグループ名 = 四階廊下_北半分)
		} else {
	print 'proc側_四階廊下_南半分'
			eval($s:w01d_食堂巡回兵の居るグループ名 = 四階廊下_南半分)
		}
	}

	// エクストリーム以外の食堂兵は、常にここに戻る
	if ($w:ゲーム設定 < d:LEVEL_EXTREME) {
		mesg 警備兵 食堂巡回兵 ルート変更 7 \ // ルート番号は不可触！
			$:w01d_食堂巡回兵Ｘ座標 9000 $:w01d_食堂巡回兵Ｚ座標 $s:w01d_食堂巡回兵の居るグループ名
	} else {
	// エクストリームでは以下の二つのどちらかに戻る
		// 食堂奥
		mesg 警備兵 食堂巡回兵 ルート変更 17 \ // ルート番号は不可触！
			$:w01d_食堂巡回兵Ｘ座標 9000 $:w01d_食堂巡回兵Ｚ座標 $s:w01d_食堂巡回兵の居るグループ名
	}
}

proc 食堂巡回兵_守備位置変更_追跡モード {
	// エクストリーム以外の食堂兵
	if ($w:ゲーム設定 < d:LEVEL_EXTREME) {
		mesg 警備兵 食堂巡回兵 ルート変更 7 \ // ルート番号は不可触！
			-7250,9000,-10500 0 // < グループ名が０で、追跡モード
	} else {
	// エクストリームでは以下の二つのどちらか
		// 食堂奥
		mesg 警備兵 食堂巡回兵 ルート変更 17 \ // ルート番号は不可触！
			-7000,9000,-18150 0 // < グループ名が０で、追跡モード
	}
}

proc 廊下巡回兵_守備位置変更 $:w01d_廊下巡回兵Ｘ座標 \
							 $:w01d_廊下巡回兵Ｚ座標
{

// グループ名自動判別
	if($:w01d_廊下巡回兵Ｘ座標 < -1100) {
	print 'proc側_四階食堂'
		eval($s:w01d_廊下巡回兵の居るグループ名 = 四階食堂)
	} else if ($:w01d_廊下巡回兵Ｘ座標 > 7125) {
	print 'proc側_四階倉庫'
		eval($s:w01d_廊下巡回兵の居るグループ名 = 四階倉庫)
	} else {
		if($:w01d_廊下巡回兵Ｚ座標 < -11750) {
	print 'proc側_四階廊下_北半分'
			eval($s:w01d_廊下巡回兵の居るグループ名 = 四階廊下_北半分)
		} else {
	print 'proc側_四階廊下_南半分'
			eval($s:w01d_廊下巡回兵の居るグループ名 = 四階廊下_南半分)
		}
	}

	// 廊下巡回兵は難易度によって、以下の三つのルートのどちらかに戻る
	if ($w:ゲーム設定 >= d:LEVEL_EXTREME) {
		mesg 警備兵 廊下巡回兵 ルート変更 9 \ // ルート番号は不可触！
			$:w01d_廊下巡回兵Ｘ座標 9000 $:w01d_廊下巡回兵Ｚ座標 $s:w01d_廊下巡回兵の居るグループ名
	} else if ($w:ゲーム設定 == d:LEVEL_HARD) {
		mesg 警備兵 廊下巡回兵 ルート変更 15 \ // ルート番号は不可触！
			$:w01d_廊下巡回兵Ｘ座標 9000 $:w01d_廊下巡回兵Ｚ座標 $s:w01d_廊下巡回兵の居るグループ名
	} else {
		mesg 警備兵 廊下巡回兵 ルート変更 12 \ // ルート番号は不可触！
			$:w01d_廊下巡回兵Ｘ座標 9000 $:w01d_廊下巡回兵Ｚ座標 $s:w01d_廊下巡回兵の居るグループ名
	}
}

proc 廊下巡回兵_守備位置変更_追跡モード {

	// 廊下巡回兵は難易度によって、以下の三つのルートのどれか
	if ($w:ゲーム設定 >= d:LEVEL_EXTREME) {
		mesg 警備兵 廊下巡回兵 ルート変更 9 \ // ルート番号は不可触！
			6000,9000,-9250 0 // < グループ名が０で、追跡モード
	} else if ($w:ゲーム設定 == d:LEVEL_HARD) {
		mesg 警備兵 廊下巡回兵 ルート変更 15 \ // ルート番号は不可触！
			6000,9000,-9250 0 // < グループ名が０で、追跡モード
	} else {
		mesg 警備兵 廊下巡回兵 ルート変更 12 \ // ルート番号は不可触！
			6000,9000,-9250 0 // < グループ名が０で、追跡モード
	}
}

// 潜入モードに戻ったことをシナリオ側で知る術が今はないので（あるが
// トラップを使う必要があって不細工）、このプロックは現状未使用。
proc 食堂巡回兵_デフォルト守備位置へ戻る {
	// エクストリーム以外の食堂兵は、常にここに戻る
	if ($w:ゲーム設定 < d:LEVEL_EXTREME) {
		mesg 警備兵 食堂巡回兵 ルート変更 7 \ // ルート番号は不可触！
			0 9000 0 四階食堂
	} else {
	// エクストリームでは以下の二つのどちらかに戻る
		// 食堂奥
		mesg 警備兵 食堂巡回兵 ルート変更 17 \ // ルート番号は不可触！
			0 9000 0 四階食堂
	}
}

// 潜入モードに戻ったことをシナリオ側で知る術が今はないので（あるが
// トラップを使う必要があって不細工）、このプロックは現状未使用。
proc 廊下巡回兵_デフォルト守備位置へ戻る {
	// 廊下巡回兵は難易度によって、以下の三つのルートのどちらかに戻る
	if ($w:ゲーム設定 >= d:LEVEL_EXTREME) {
		mesg 警備兵 廊下巡回兵 ルート変更 9 \ // ルート番号は不可触！
			0 9000 0 四階廊下_北半分
	} else if ($w:ゲーム設定 == d:LEVEL_HARD) {
		mesg 警備兵 廊下巡回兵 ルート変更 15 \ // ルート番号は不可触！
			0 9000 0 四階廊下_南半分
	} else {
		mesg 警備兵 廊下巡回兵 ルート変更 12 \ // ルート番号は不可触！
			0 9000 0 四階廊下_南半分
	}
}










