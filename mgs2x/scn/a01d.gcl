proc ローカル変数初期化 {
}

//###################################################################################
//									エフェクト設定
//###################################################################################


proc エフェクト設定{




//窓そばの雨音
	trap soko_mado_ameoto d:PLAYER \
		-mask ？ \
		-exec {
			if($3 == 入る){
				print '雨音鳴らす'
				command ＳＥセットモード -s d:se_code:SD_A_W_RAIN01 -p 10000 1000 -9000 -m 1
			}else{
				command セットサウンドコード -c d:SE_JOUCHUU_OFF
			}
		}

	trap shokudo_mado_ameoto d:PLAYER \
		-mask ？ \
		-exec {
			if($3 == 入る){
				print '雨音鳴らす'
				command ＳＥセットモード -s d:se_code:SD_A_W_RAIN01 -p -11750 1000 -10000 -m 1
			}else{
				command セットサウンドコード -c d:SE_JOUCHUU_OFF
			}
		}



	chara フォグ fog \
		 -c 30 22 35 \
		 -n 1000 \
		 -f 30000 \
		 -z




// 跳弾番号設定
// ------------------------------------
	command 跳弾ノーマル -n 0		//ノーマル
	command 跳弾ノーマル -n 1		//鉄筋
	command 跳弾ノーマル -n 2		//鉄板
	command 跳弾ノーマル -n 3		//警報ベル
	command 跳弾ノーマル -n 6		//警報ベル
	command 跳弾ＳＥのみ -n 4		//木
	command 跳弾ＳＥのみ -n 7		//ダンボール

	command 弾痕ノーマル -n 0
	command 弾痕ノーマル -n 1
	command 弾痕ノーマル -n 2
	command 弾痕ノーマル -n 4
	command 弾痕ノーマル -n 7


	// 蒸気番号設定
	// ------------------------------------
	command 弾痕ノーマル -n 5
	command 弾痕ノーマル -n 6
	command 跳弾水蒸気中 -n 5
	//command 跳弾水蒸気小 -n 6

	mesg 弾痕 痕 off


//弾痕消し処理
	trap shokudo d:PLAYER \
		-mask ？ \
		-state d:TRP_STATE_SUBJECT,d:TRP_STATE_INTRUDE \
		-exec {
			if($3 == 入る){
				mesg 弾痕 痕 on

			}else{
				mesg 弾痕 痕 off

			}

		}


	trap roka_kita d:PLAYER \
		-mask ？ \
		-state d:TRP_STATE_SUBJECT,d:TRP_STATE_INTRUDE \
		-exec {
			if($3 == 入る){
				mesg 弾痕 痕 on

			}else{
				mesg 弾痕 痕 off

			}

		}



	trap soko d:PLAYER \
		-mask ？ \
		-state d:TRP_STATE_SUBJECT,d:TRP_STATE_INTRUDE \
		-exec {
			if($3 == 入る){
				mesg 弾痕 痕 on

			}else{
				mesg 弾痕 痕 off

			}

		}


	trap roka_minami d:PLAYER \
		-mask ？ \
		-state d:TRP_STATE_SUBJECT,d:TRP_STATE_INTRUDE \
		-exec {
			if($3 == 入る){
				mesg 弾痕 痕 on

			}else{
				mesg 弾痕 痕 off

			}

		}






