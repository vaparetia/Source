proc 下覗き込み初期化 {
	// 下覗き込みは、最初は無し。
	eval($f:下覗き込み有り = d:FALSE)

}

proc クリアリング終了インクリメント{
// E3用に常にこちら。
//	eval($f:下覗き込み有り = d:TRUE)

	if($f:下覗き込み有り == d:TRUE){
		eval($f:下覗き込み有り = d:FALSE)
	} else {
		eval($f:下覗き込み有り = d:TRUE)
	}

}

proc 倉庫クリアリングエリア１初期設定 {

	if($w:ゲーム設定 == d:LEVEL_VERYEASY) {
		// 下のぞき込み無し
		if($f:下覗き込み有り == d:FALSE){
		command セットクリアリング \
			-p 0,0,2 クリアリングカメラ１ \
			   0,0,11 クリアリングカメラ２ \
			   0,1,5 クリアリングカメラ３ \
			   0,1,6 クリアリングカメラ４ \
			   0,1,9 クリアリング終了インクリメント \
			-i 0,1

		// 下のぞき込み有り
		} else {

		command セットクリアリング \
			-p 0,2,2 クリアリングカメラ１ \
			   0,2,11 クリアリングカメラ５ \
			   0,3,5 クリアリングカメラ６ \
			   0,3,7 クリアリングカメラ４Ｂ \
			   0,3,9 クリアリングカメラ７ \
			   0,3,12 クリアリングカメラ８ \
			   0,2,17 クリアリング終了インクリメント \
//			   0,2,19 クリアリング終了インクリメント \
			-i 2,3
		}

	} else {

		// 下のぞき込み無し
		if($f:下覗き込み有り == d:FALSE){
		command セットクリアリング \
			-p 0,0,2 クリアリングカメラ１ \
			   0,0,11 クリアリングカメラ２ \
			   0,1,5 クリアリングカメラ３ \
			   0,1,6 クリアリングカメラ４ \
			   0,1,9 クリアリング終了インクリメント \
			-i 0,1

		// 下のぞき込み有り
		} else {

			command セットクリアリング \
				-p 0,2,2 クリアリングカメラ１ \
				   0,2,11 クリアリングカメラ５ \
				   0,3,5 クリアリングカメラ６ \
				   0,3,7 クリアリングカメラ４Ｂ \
				   0,3,9 クリアリングカメラ７ \
				   0,3,12 クリアリングカメラ８ \
				   0,2,17 クリアリング終了インクリメント \
	//			   0,2,19 クリアリング終了インクリメント \
				-i 2,3
		}
	}
}

proc 棚の下敵兵視線阻止透明壁セット {
	// 通常時には貼っておき、敵兵が覗き込むときには外して見つかるように
	chara 透明壁 覗き込み防止透明壁 \
		-p 10750 9000 -14000 550 \
		    9250 9000 -14000 550 \
		-a (d:HZX_SEG_NO_PLAYER | d:HZX_SEG_NO_ENEMY | \
			d:HZX_SEG_NO_BULLET | d:HZX_SEG_NO_MISSILE | \
			d:HZX_SEG_NO_C4 | d:HZX_SEG_NO_RECOIL | \
			d:HZX_SEG_NO_HARITSUKI | d:HZX_SEG_NO_DISP_RADAR | \
			d:HZX_SEG_NO_BULLETHOLE | d:HZX_SEG_NO_SPRAY)

	/* オフのメッセージは、クリアリングカメラ８（覗き込むときの
	カメラ）で発行している
	*/

	// 危険モード時には常にオフ
	trap ca013 d:PLAYER \
		-mask ＊ \
		-exec {
			if($3 == いる) {
				if($w:アラートモード == d:ALERT_MODE_KIKEN) {
					if(!$f:w01d_倉庫危険モード時覗き込み防止壁オフした) {
						mesg 透明壁 覗き込み防止透明壁 off
						eval($f:w01d_倉庫危険モード時覗き込み防止壁オフした = 1)
					}
				} else {
					mesg 透明壁 覗き込み防止透明壁 on
					eval($f:w01d_倉庫危険モード時覗き込み防止壁オフした = 0)
				}
			}
		}

}

//---------------------------------------------------------------
// 食料倉庫/同じ柄のダンボールだと見つからない
//---------------------------------------------------------------
proc 倉庫_同じ柄のダンボールでやりすごすセット {
	chara ダンボール柄トラップ設定  シンキストダンボール \
		-name スネーク \
		-traps d:アイテム:ダンボール,box000

	trap box000 d:PLAYER \
		-mask ？ \
		-exec {
			if($3 == 入る) {
				print 'box000入る'
			} else {
				print 'box000出る'
			}
		}
}

