//###################################################################################
//									鏡面モデル設定
//###################################################################################

proc キャラクタ映り込みセット {
// スネーク用
	chara 鏡面モデル管理 ｗ０１ｄ床面映り込み \
		-pos 0,9000,0 \
		-axis 1 // Y軸反転

	trap mr000 ？ \
		-mask ？ \
		-exec {
			if($3 == 入る){
				mesg 鏡面モデル管理 ｗ０１ｄ床面映り込み add $2
			}else{
				mesg 鏡面モデル管理 ｗ０１ｄ床面映り込み del $2
			}
		}






// スネークが三階への階段脇にいるときに、敵兵の映り込みを消す
	trap mr001 d:PLAYER \
		-state d:TRP_STATE_SUBJECT d:TRP_STATE_BEHIND \
		-mask ？ \
		-exec {
			if($3 == 入る) {
				command トラップ切り替え \
					-trap mr000 \
					-switch 0

			} else {
				command トラップ切り替え \
					-trap mr000 \
					-switch 1

			}

		}




}















