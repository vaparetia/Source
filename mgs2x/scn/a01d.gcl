//###################################################################################
//								北廊下ビヨンド設定
//###################################################################################


	proc 北廊下ビヨンド設定 {
//ｗ０１ｃへの階段（このエルードはロード確定）
		print 'beyond_set'
		print '北廊下ビヨンド設定'

		trap by000 d:PLAYER \
			-mask 入る \
			-and \
			-dir 2048,256 0,256 \
			-button d:ACTION_BUTTON,d:ACTION_BUTTON \		//ビヨンドボタン
			-state d:TRP_STATE_STAND,d:TRP_STATE_CAUTION \	//立ち状態or張り付き
			-exec {
				@北向きビヨンド発動 by000 -15300 500 250 750 (d:BY_FALL_IMMEDIATELY | d:BY_NOFOOTSHADOW | d:BY_NO_MOVE_LR)
			}



		trap by000 d:PLAYER \
			-mask ？ \
			-dir 0,256 2048,256 \
			-state d:TRP_STATE_FORCE \
			-exec {
				chara カメラ設定 ビヨンドカメラ \
					-c 1 \
					-p 162,11946,-13674 \
					-t 1784,1175,-24491 \
					-a 200 \
					-i 0 0 0 0 \
					-s $3
			}

	}




//###################################################################################
//								休憩兵設定
//###################################################################################


proc 休憩兵発動判定{	//※廊下と倉庫両方のマップ設定に組み込むこと！！

	eval($w:w01d食糧倉庫に敵兵誰かいる = 0)
	eval($w:w01d食糧倉庫前にも敵兵誰かいる = 0)


//休憩兵イベント条件チェック

	//食糧倉庫に誰かいるかしら？
	trap ca013 ？ \
		-mask ？ \
		-exec {

			if($2 != d:PLAYER && $2 != 休憩兵){

				if($3 == 入る){
					eval($w:w01d食糧倉庫に敵兵誰かいる = $w:w01d食糧倉庫に敵兵誰かいる + 1)

				}else{
					eval($w:w01d食糧倉庫に敵兵誰かいる = $w:w01d食糧倉庫に敵兵誰かいる - 1)

				}

			}

		}


	//倉庫の前に誰かいないかチェック
	trap ev803 ？ \
		-mask ？ \
		-exec {

			if($2 != d:PLAYER && $2 != 休憩兵){

				if($3 == 入る){
					eval($w:w01d食糧倉庫前にも敵兵誰かいる = $w:w01d食糧倉庫前にも敵兵誰かいる + 1)
				}else{
					eval($w:w01d食糧倉庫前にも敵兵誰かいる = $w:w01d食糧倉庫前にも敵兵誰かいる - 1)

				}

			}

		}


}


proc 休憩兵設定{


//休憩兵移動
	trap ca013 d:PLAYER \
		-mask ＊ \
		-exec {

			if($3 == 入る){

				if(!$f:休憩兵イベント発生 && $w:アラートモード == d:ALERT_MODE_SENNYU && $w:w01d食糧倉庫に敵兵誰かいる == 0 ){
					print '休憩兵かまーん１'

					mesg 警備兵 休憩兵 ルート変更 (27-1) \
						-3650,6000,-13900 四階廊下_北半分

				}

			}else if($3 == いる){
				if($w:アラートモード != d:ALERT_MODE_SENNYU || $w:w01d食糧倉庫に敵兵誰かいる > 0){
					mesg 警備兵 休憩兵 ルート変更 (29-1) \
						-3650,6000,-13900 四階廊下_北半分
				}

			}else if($3 == 出る){
				mesg 警備兵 休憩兵 ルート変更 (29-1) \
					-3650,6000,-13900 四階廊下_北半分

			}

		}



	trap ca010 d:PLAYER \
		-mask ？ \
		-exec {

			if($3 == 入る){

				if(!$f:休憩兵イベント発生 && $w:アラートモード == d:ALERT_MODE_SENNYU && $w:w01d食糧倉庫に敵兵誰かいる == 0){
					print '休憩兵かまーん２'

					mesg 警備兵 休憩兵 ルート変更 (28-1) \
						-3650,6000,-13900 四階廊下_北半分
				}

			}else if($3 == 出る && !$f:休憩兵イベント発生){
				mesg 警備兵 休憩兵 ルート変更 (27-1) \
					-3650,6000,-13900 四階廊下_北半分

			}

		}





//敵兵休憩イベントスタート

	trap ev802 d:PLAYER \
		-mask いる \
		-exec {

			if(!$f:休憩兵イベント発生){
				command ゲット敵兵座標 \
					休憩兵 $i:休憩兵Ｘ座標変数 $i:休憩兵Ｙ座標変数 $i:休憩兵Ｚ座標変数

				command ゲット敵兵状態 \
					休憩兵 $i:敵兵状態
/*
				($i:敵兵状態 & 0x80106004) == 0

				0x00000004	//倒れ状態
				0x00002000	//捕まえられている
				0x00004000	//気絶中
				0x00100000	//起き上がり中
				0x80000000	//死亡

				のどれでもない。
*/


			}

			if(!$f:休憩兵イベント発生 && $w:アラートモード == d:ALERT_MODE_SENNYU && $w:w01d食糧倉庫に敵兵誰かいる == 0 && $w:w01d食糧倉庫前にも敵兵誰かいる == 0 && $i:休憩兵Ｘ座標変数 > 5000 && $i:休憩兵Ｚ座標変数 < -17000 && (($i:敵兵状態 & 0x80106004) == 0) ){

				eval($f:休憩兵イベント発生 = 1)


				@シナリオデモ開始処理

				chara デモキャンセルチェック デモキャンセル \
					-p 倉庫休憩兵カメラ終了処理

				@休憩兵デモ中発見されたキャンセル


				mesg 警備兵 休憩兵 ルート変更 (26-1) \
					-3650,6000,-13900 四階廊下_北半分

				chara delay 休憩兵発見キャンセルディレイ \
					-time 60 \
					-exec{

						chara カメラ設定 カットインカメラ \
							-c 1 \
							-p 8851,12185,-17332 \
							-t 7926,11047,-18331 \
							-a 188 \
							-i 3 -1 0 0 \
							-s 1


						chara delay 休憩兵発見キャンセルディレイ \
							-time 480 \
							-exec{
								@倉庫休憩兵カメラ終了処理
							}

					}

			}

		}




//部屋を出た休憩兵はさようなら。

	trap ca013 休憩兵 \
		-mask 出る \
		-exec {

			mesg 警備兵 休憩兵 ルート変更 (29-1) \
				-3650,6000,-13900 四階廊下_北半分


		}




//インチキ透明壁出し入れ
	trap ca013 d:PLAYER \
		-mask ＊ \
		-exec {

			if($3 == 入る && !$f:休憩兵イベント発生 && $w:アラートモード == d:ALERT_MODE_SENNYU && $w:w01d食糧倉庫に敵兵誰かいる == 0){
				print 'インチキ壁オーン！'
				mesg 透明壁 休憩兵用インチキ壁 on

			}else if($3 == いる && $w:アラートモード == d:ALERT_MODE_KIKEN ){
				mesg 透明壁 休憩兵用インチキ壁 off

			}else if($3 == 出る){
				print 'インチキ壁オーフ！'
				mesg 透明壁 休憩兵用インチキ壁 off

			}

		}




}


proc 休憩兵デモ中発見されたキャンセル{


	chara delay 休憩兵発見キャンセルディレイ \
		-time 1 \
		-exec {

			command ゲットゲームステータス \
				$i:ゲームステータス

			if($i:ゲームステータス & 0x00000001){		// 発見〜危険モードの間
				print 'キャンセル発動'
				@倉庫休憩兵カメラ終了処理

				return 0
			}else{
				print 'キャンセルチェック'
				return 1

			}


		}

}


proc 倉庫休憩兵カメラ終了処理{

	mesg delay 休憩兵発見キャンセルディレイ kill

	@カメラＯＦＦ カットインカメラ


	@シナリオデモ終了処理

	mesg デモキャンセルチェック デモキャンセル kill



}









//###################################################################################
//								居住区４Ｆ透明壁設定
//###################################################################################



proc 居住区４Ｆ透明壁設定{


//インチキ透明壁用意

	chara 透明壁 休憩兵用インチキ壁 \	//※注意！敵兵の視線通過しません。
		-position 9250 9000 -14000 2000 \
		9250 9000 -11250 2000 \
		-attribute (d:HZX_SEG_NO_BULLET|d:HZX_SEG_NO_MISSILE|d:HZX_SEG_NO_C4|d:HZX_SEG_NO_RECOIL|d:HZX_SEG_NO_HARITSUKI|d:HZX_SEG_NO_DISP_RADAR|d:HZX_SEG_NO_BULLETHOLE|d:HZX_SEG_NO_SPRAY|d:HZX_SEG_NO_PLAYER|d:HZX_SEG_NO_ENEMY)

	chara 透明壁 休憩兵用インチキ壁 \	//※注意！敵兵の視線通過しません。
		-position 10750 9000 -14000 2000 \
		10750 9000 -11250 2000 \
		-attribute (d:HZX_SEG_NO_BULLET|d:HZX_SEG_NO_MISSILE|d:HZX_SEG_NO_C4|d:HZX_SEG_NO_RECOIL|d:HZX_SEG_NO_HARITSUKI|d:HZX_SEG_NO_DISP_RADAR|d:HZX_SEG_NO_BULLETHOLE|d:HZX_SEG_NO_SPRAY|d:HZX_SEG_NO_PLAYER|d:HZX_SEG_NO_ENEMY)

	chara 透明壁 休憩兵用インチキ壁 \	//※注意！敵兵の視線通過しません。
		-position 9250 9000 -14000 2000 \
		10750 9000 -14000 2000 \
		-attribute (d:HZX_SEG_NO_BULLET|d:HZX_SEG_NO_MISSILE|d:HZX_SEG_NO_C4|d:HZX_SEG_NO_RECOIL|d:HZX_SEG_NO_HARITSUKI|d:HZX_SEG_NO_DISP_RADAR|d:HZX_SEG_NO_BULLETHOLE|d:HZX_SEG_NO_SPRAY|d:HZX_SEG_NO_PLAYER|d:HZX_SEG_NO_ENEMY)

	chara 透明壁 休憩兵用インチキ壁 \	//※注意！敵兵の視線通過しません。
		-position 9250 9000 -11250 2000 \
		10750 9000 -11250 2000 \
		-attribute (d:HZX_SEG_NO_BULLET|d:HZX_SEG_NO_MISSILE|d:HZX_SEG_NO_C4|d:HZX_SEG_NO_RECOIL|d:HZX_SEG_NO_HARITSUKI|d:HZX_SEG_NO_DISP_RADAR|d:HZX_SEG_NO_BULLETHOLE|d:HZX_SEG_NO_SPRAY|d:HZX_SEG_NO_PLAYER|d:HZX_SEG_NO_ENEMY)


	mesg 透明壁 休憩兵用インチキ壁 off



}












//###################################################################################
//								マップ初期表示設定
//###################################################################################



// ====================================
// マップ初期表示
// ====================================

	command マップ表示 -show 四階廊下_北半分
	command マップ表示 -show 四階廊下_南半分

// スタート時処理
//	@ロード時フェードイン
if( $s:登場ポイント == a01cから来た ) {
	@ステージ開始時処理（ステージ名表示）\
		d:LOAD_TYPE:NO_DOOR_TYPE \
		三階から来た \
		1000 \
		d:DEFAULT_M_TYPE \
		d:wn_船橋四階居住区
} else {
	@ステージ開始時処理（ステージ名表示）\
		d:LOAD_TYPE:NO_DOOR_TYPE \
		a01eから来た \
		1000 \
		d:DEFAULT_M_TYPE \
		d:wn_船橋四階居住区
}


// キャラクタ用ライトセット（必ず、マップshowの後におく）
	@キャラクタ用ライトセット

// シンキストダンボールにキャラのライトを反映させるために、一番後ろに。
command マップ設定 \
	四階倉庫 -s {
	@シンキストダンボールセット
} // <command マップ設定 四階倉庫>の閉じカッコ


