/***************************************************************************************/
// マップ宣言
/***************************************************************************************/
	// アナザー用プロック マップ設定前に設定する
	@アナザー用マップ定義前設定					// a_mode.h

	chara マップ 四階食堂			-k w01d0 -h a01d,0 -l w01d
	chara マップ 四階廊下_北半分	-k w01d1 -h a01d,1 -l w01d
	chara マップ 四階廊下_南半分			 -h a01d,3 -l w01d
	chara マップ 四階倉庫			-k w01d2 -h a01d,2 -l w01d
	chara マップ 階上				-k null -h a01d,5 -l w01d

/****************************************************************************************/
// 各マップのキャラ設定
/****************************************************************************************/
	command マップ設定	四階食堂 \
						四階廊下_北半分 \
						四階廊下_南半分 \
						四階倉庫 \
						階上 \
	-s {
		@ローカル変数初期化
		@常駐キャラ設定							// stdch.h
		@A_プレイヤー設定 sna_w01d rai_w01d		// a_stdproc.h
	}

	// アナザー用プロック マップ設定後に設定する
	@アナザー用マップ定義後設定					// a_mode.h

	command マップ設定	四階食堂 \
						四階廊下_北半分 \
						四階廊下_南半分 \
						四階倉庫 \
						階上 \
	-s {
		@エフェクト設定
		@下覗き込み初期化
		/* サウンドマネージャー＞敵兵コマンダー＞ＢＧＭマネージャー
		   の順番は、遵守すること */
		//@四階敵兵セット
		//@巡回兵ルートチェンジ_潜入モード時セット
		//@巡回兵ルートチェンジ_戦闘中セット
		//@攻撃兵待機ルートチェンジセット

		@各種カメラ作成

		@デフォルトカメラセット

		@マップ接合_食堂／廊下_北
		@マップ接合_食堂／廊下_南
		@マップ接合_廊下同士
		@マップ接合_廊下／倉庫
		@マップ切り替え_食堂／廊下ドア_北
		@マップ切り替え_食堂／廊下ドア_南
		@マップ切り替え_廊下／倉庫ドア
		@ロード_五階へ移動
		@ロード_三階へ移動

		// 食堂のドアが開いたところでも見えるので。
		@３Ｆへの階段オブジェの表示切り替えセット
		@５Ｆへの階段オブジェの表示切り替えセット
		@階段オブジェの表示切り替えセット初期設定
		@南端の壁セット

		// 監視カメラと即死ゲームオーバーで共用するので。
		@共通シネマスクリーンセット


		@キャラクタ映り込みセット


		#if d:MY_DEBUG
			//@スクリーンショット使用
		#endif
	} // <command マップ設定 ステージ共通>の閉じカッコ


// マップ設定　食堂
// ------------------------------------
command マップ設定 \
	四階食堂 -s {
	@食堂_天井セット
	@食堂カメラセット
	@食堂南壁セット
	@食堂オタマセット
	@食堂揺れライトセット
	@食堂割れ皿セット
	@食堂テーブルの調味料と紙セット_左上
	@食堂テーブルの調味料と紙セット_左下
	@食堂テーブルの調味料と紙セット_右上
	@食堂テーブルの調味料と紙セット_右下
	@食堂ゴキブリセット
	@食堂_船員死体セット
	@厨房両開きドアセット
//	@監視カメラセット
	@食堂の窓雨セット
} // <command マップ設定 四階食堂>の閉じカッコ







// マップ設定　廊下
// ------------------------------------
