proc Ｃ４誘爆 {
	command 無線設定 -reset
	command メニュー設定 -menu off -gage off -radar off -subwin off
	command パッド操作 -release
	mesg コマンダー 敵兵セット 視界オフ
	mesg コマンダー 敵兵セット 聴力オフ
	@特殊装備解除

	command StreamStopAll

	if($w:アラートモード != d:ALERT_MODE_SENNYU){
		command セットサウンドコード -c d:SNG_FOUTS_S		//ＢＧＭフェードアウト
	}

	eval($w:Ｃ４爆発用ディレイ = 0)

	mesg 複数赤外線 赤外線センサー on
	@爆発ゲームオーバー処理 d:BOMB_EFFECT_ON

	mesg トラップ専用C4 誘爆用Ｃ４_１ on
	chara delay ディレイ -time 10 -exec {

		if($w:Ｃ４爆発用ディレイ == 0){
			mesg トラップ専用C4 誘爆用Ｃ４_２ on
			eval($w:Ｃ４爆発用ディレイ = 1)
			return 15

		}else if($w:Ｃ４爆発用ディレイ == 1){
			mesg トラップ専用C4 誘爆用Ｃ４_３ on
			eval($w:Ｃ４爆発用ディレイ = 2)
			return 16

		}else if($w:Ｃ４爆発用ディレイ == 2){
			mesg トラップ専用C4 誘爆用Ｃ４_４ on
			eval($w:Ｃ４爆発用ディレイ = 3)
			return 10

		}else if($w:Ｃ４爆発用ディレイ == 3){
			mesg トラップ専用C4 誘爆用Ｃ４_５ on
			eval($w:Ｃ４爆発用ディレイ = 4)
			return 22

		}else if($w:Ｃ４爆発用ディレイ == 4){
			mesg トラップ専用C4 誘爆用Ｃ４_６ on
			eval($w:Ｃ４爆発用ディレイ = 5)
			return 31

#if d:BOMB_EFFECT_ON
		}else if($w:Ｃ４爆発用ディレイ == 5){
			//mesg 複数赤外線 赤外線センサー on
			//@爆発ゲームオーバー処理 d:BOMB_EFFECT_ON

			return 0
#endif

		}else if($w:Ｃ４爆発用ディレイ == 5){
			mesg トラップ専用C4 誘爆用Ｃ４_７ on
			eval($w:Ｃ４爆発用ディレイ = 6)
			return 25

		}else if($w:Ｃ４爆発用ディレイ == 6){
			mesg トラップ専用C4 誘爆用Ｃ４_８ on
			eval($w:Ｃ４爆発用ディレイ = 7)
			return 22

		}else if($w:Ｃ４爆発用ディレイ == 7){
			mesg トラップ専用C4 誘爆用Ｃ４_９ on
			eval($w:Ｃ４爆発用ディレイ = 8)
			return 16

		}else if($w:Ｃ４爆発用ディレイ == 8){
			mesg トラップ専用C4 誘爆用Ｃ４_１０ on
			eval($w:Ｃ４爆発用ディレイ = 9)
			return 20

		}else if($w:Ｃ４爆発用ディレイ == 9){
			mesg トラップ専用C4 誘爆用Ｃ４_１１ on
			eval($w:Ｃ４爆発用ディレイ = 10)
			return 10

		}else if($w:Ｃ４爆発用ディレイ == 10){
			mesg トラップ専用C4 誘爆用Ｃ４_１２ on
			eval($w:Ｃ４爆発用ディレイ = 11)
			return 25

		}else if($w:Ｃ４爆発用ディレイ == 11){
			mesg トラップ専用C4 誘爆用Ｃ４_１３ on
			eval($w:Ｃ４爆発用ディレイ = 12)
			return 32

		}else if($w:Ｃ４爆発用ディレイ == 12){
			mesg トラップ専用C4 誘爆用Ｃ４_１４ on
			eval($w:Ｃ４爆発用ディレイ = 13)
			return 121

		}else if($w:Ｃ４爆発用ディレイ == 13){
			print '最後のｃ４爆発'
			mesg トラップ専用C4 誘爆用Ｃ４_１５ on
			eval($w:Ｃ４爆発用ディレイ = 14)
			return 0

		}

	}



/*
	mesg トラップ専用C4 誘爆用Ｃ４_１ on
	chara delay ディレイ -time 10 -exec {
		mesg トラップ専用C4 誘爆用Ｃ４_２ on
		chara delay ディレイ -time 15 -exec {
			mesg トラップ専用C4 誘爆用Ｃ４_３ on
			chara delay ディレイ -time 16 -exec {
				mesg トラップ専用C4 誘爆用Ｃ４_４ on
				chara delay ディレイ -time 10 -exec {
					mesg トラップ専用C4 誘爆用Ｃ４_５ on
					chara delay ディレイ -time 22 -exec {
						mesg トラップ専用C4 誘爆用Ｃ４_６ on
						chara delay ディレイ -time 13 -exec {
							mesg トラップ専用C4 誘爆用Ｃ４_７ on
							chara delay ディレイ -time 16 -exec {
								mesg トラップ専用C4 誘爆用Ｃ４_８ on
								chara delay ディレイ -time 20 -exec {
									mesg トラップ専用C4 誘爆用Ｃ４_９ on
									chara delay ディレイ -time 15 -exec {
										mesg トラップ専用C4 誘爆用Ｃ４_１０ on
										// コンティニュー時の再誤爆用に０に初期化
										eval($f:w01d_Ｃ４誤爆でゲームオーバー = 0)
									}
								}
							}
						}
					}
				}
			}
		}
	}
*/
}

proc スネーク即死ゲームオーバー {
	command 無線設定 -reset

	@Ｃ４誘爆
	mesg トラップ専用C4 ＢＩＧＣ４ on

	command プレイヤー瞬殺 -name スネーク
//	mesg シネマスクリーン シネマ フェードアウト 0		//ゼロでデフォルト値

print 'C4_EXPLODE!!!_001'

	chara フェードインアウト フェードイン \
		-c 255,255,255 128 \
		-t 60
}

proc Ｃ４誤射時スネーク即死ゲームオーバー {
	command 無線設定 -reset

	if(!$f:w01d_Ｃ４誤爆でゲームオーバー) {
		@Ｃ４誘爆

		command プレイヤー瞬殺 -name スネーク
print 'C4_EXPLODE!!!_000'
		chara フェードインアウト フェードイン \
			-c 255,255,255 128 \
			-t 60
		eval($f:w01d_Ｃ４誤爆でゲームオーバー = 1)
	}
}

proc 敵兵もセンサーに引っかかる処理暫定 {
	trap ev1000 ？ \
		-mask 入る \
		-exec {
			if($2 != d:PLAYER){
				@スネーク即死ゲームオーバー
			}
		}
}

proc 赤外線スイッチ破壊 {
	eval( $f:w01d_赤外線１スイッチ破壊フラグ = 1 )
	mesg トラップ専用C4 ＢＩＧＣ４ lamp_off
}


proc 赤外線センサーセット $:Ｚ偏差 {

	print '赤外線センサー設置'

	if( !$f:w01d_赤外線１スイッチ破壊フラグ ){

		chara 複数赤外線 赤外線センサー \
			-p 5150,9000,-11250 0,1024,0 スイッチ君 \		//$v:スイッチ座標 $v:スイッチ方向 $s:スイッチ名前 ...7
			-n 1 \											//$i:スイッチの数 \
			-a	5150,9000,(-11750 + $:Ｚ偏差) 0,2048,0 \
				6850,9000,-11750 0,2048,0 \		//$v:センサー座標 $v:センサー方向 ...6
			-e スネーク即死ゲームオーバー \
			-s 赤外線スイッチ破壊 \
			-m irs_box irs_box2 irs \
			-b 1 \
			-d 1						//$i:１を指定すると下部のセンサー無し（50cmの隙間ができる）\

		chara プットオブジェ 赤外線スイッチ１ -m irs_box -r 2048 1024 0 -p 5150,9000,-11250 -l w01d -s 100 100 100

	}else{
		chara プットオブジェ 赤外線スイッチ１ -m irs_box2 -r 0 1024 0 -p 5150,9000,-11250 -l w01d -s 100 100 100
		chara プットオブジェ 赤外線センサーＬ１ -m irs -r 0 2048 0 -p 5150,9000,(-11750 + $:Ｚ偏差) -l w01d -s 100 100 100
		chara プットオブジェ 赤外線センサーＲ１ -m irs -r 0 2048 0 -p 6850,9000,-11750 -l w01d -s 100 100 100
		chara プットオブジェ 赤外線スイッチ１ -m irs_box2 -r 2048 1024 0 -p 5150,9000,-11250 -l w01d -s 100 100 100

	}





	command foreach -argc 6 -repeat 4 \
		-data { \
				{5150,9030,(-12050+$:Ｚ偏差), 0,0,0} \
				{6850,9030,(-11450+$:Ｚ偏差), 0,2048,0} \
				{6850,9380,(-11470+$:Ｚ偏差), 0,2048,0} \
				{6850,9030,(-12050+$:Ｚ偏差), 0,0,0} \
		} \
		-exec { \
			chara トラップ専用C4 ＢＩＧＣ４ -p $1,$2,$3 -r $4,$5,$6 \
				-e Ｃ４誤射時スネーク即死ゲームオーバー \
				-n 1	//音しない
		}

	// 映り込み用Ｃ４
	command foreach -argc 6 -repeat 4 \
		-data { \
				{5150,8970,(-12050+$:Ｚ偏差), 0,0,2048} \
				{6850,8970,(-11450+$:Ｚ偏差), 0,2048,2048} \
				{6850,8620,(-11470+$:Ｚ偏差), 0,2048,2048} \
				{6850,8970,(-12050+$:Ｚ偏差), 0,0,2048} \
		} \
		-exec { \
			chara プットオブジェ 映り込み用Ｃ４セット \
				-m cfr_trp \
				-p $1,$2,$3 \
				-r $4,$5,$6 \
				-l w01d
		}

	// 誘爆用（音だけちょうだい）Ｃ４

#if 1
	command foreach -argc 4 -repeat 15 \
		-data { \
				{誘爆用Ｃ４_１,7500,7500,-12000} \
				{誘爆用Ｃ４_２,4500,7500,-12000} \
				{誘爆用Ｃ４_３,7500,7500,-12000} \
				{誘爆用Ｃ４_４,4500,7500,-12000} \
				{誘爆用Ｃ４_５,7500,7500,-12000} \
				{誘爆用Ｃ４_６,4500,7500,-12000} \
				{誘爆用Ｃ４_７,7500,7500,-12000} \
				{誘爆用Ｃ４_８,4500,7500,-12000} \
				{誘爆用Ｃ４_９,7500,7500,-12000} \
				{誘爆用Ｃ４_１０,4500,7500,-12000} \
				{誘爆用Ｃ４_１１,7500,7500,-12000} \
				{誘爆用Ｃ４_１２,4500,7500,-12000} \
				{誘爆用Ｃ４_１３,7500,7500,-12000} \
				{誘爆用Ｃ４_１４,4500,7500,-12000} \
				{誘爆用Ｃ４_１５,7500,7500,-12000} \
		} \
		-exec { \
			chara トラップ専用C4 $1 -p $2,$3,$4 -r 0,0,0 -n 1	//音しない
		}


#else
	chara トラップ専用C4 誘爆用Ｃ４_１ -p 7500,7500,-12000 -r 0,0,0 -n 1	//noiseはなし
	chara トラップ専用C4 誘爆用Ｃ４_２ -p 4500,7500,-12000 -r 0,0,0 -n 1	//noiseはなし
	chara トラップ専用C4 誘爆用Ｃ４_３ -p 7500,7500,-16000 -r 0,0,0 -n 1	//noiseはなし
	chara トラップ専用C4 誘爆用Ｃ４_４ -p 4500,7500,-16000 -r 0,0,0 -n 1	//noiseはなし
	chara トラップ専用C4 誘爆用Ｃ４_５ -p 7500,7500, -8000 -r 0,0,0 -n 1	//noiseはなし
	chara トラップ専用C4 誘爆用Ｃ４_６ -p 4500,7500, -8000 -r 0,0,0 -n 1	//noiseはなし

	chara トラップ専用C4 誘爆用Ｃ４_７ -p 4500,7500, -8000 -r 0,0,0 -n 1	//noiseはなし
	chara トラップ専用C4 誘爆用Ｃ４_８ -p 4500,7500, -8000 -r 0,0,0 -n 1	//noiseはなし
	chara トラップ専用C4 誘爆用Ｃ４_９ -p 4500,7500, -8000 -r 0,0,0 -n 1	//noiseはなし
	chara トラップ専用C4 誘爆用Ｃ４_１０ -p 4500,7500, -8000 -r 0,0,0 -n 1	//noiseはなし
	chara トラップ専用C4 誘爆用Ｃ４_１１ -p 4500,7500, -8000 -r 0,0,0 -n 1	//noiseはなし
	chara トラップ専用C4 誘爆用Ｃ４_１２ -p 4500,7500, -8000 -r 0,0,0 -n 1	//noiseはなし
	chara トラップ専用C4 誘爆用Ｃ４_１３ -p 4500,7500, -8000 -r 0,0,0 -n 1	//noiseはなし
	chara トラップ専用C4 誘爆用Ｃ４_１４ -p 4500,7500, -8000 -r 0,0,0 -n 1	//noiseはなし
	chara トラップ専用C4 誘爆用Ｃ４_１５ -p 4500,7500, -8000 -r 0,0,0 -n 1	//noiseはなし
#endif

}

proc 廊下消火器破壊 {
	mesg 複数赤外線 赤外線センサー on
}


proc 廊下_壁の小型消火器セット {
	chara 消火器 消火器２ \
		-r 0 0 0 \
		-p 5150 9000 -10500 \
		-l w01d \
		-b 5000  9000 -15625 \
		   7000 12000  -8250 \
		-e 廊下消火器破壊 \
		-i 1	//赤外線センサーに作用
}

proc 監視カメラセット {

	@カメラ再セットチェック $b:w01d_破壊ロード回数[0]
	if($f:再セットフラグ) {
		eval($f:w01d_監視カメラ１破壊フラグ = 0)
	}

	if($w:ゲーム設定 <= d:LEVEL_EASY){
		eval($i:振り幅   =   0)
		eval($i:横視野角 = 256)
	}else{
		eval($i:振り幅   = 480)
		eval($i:横視野角 = 256)
	}

	chara 監視カメラ 監視カメラ１ \
		-pos -2000 11000 -13700 \
		-rot 400 0 0 \ /*ＸＹ値のみ有効*/
		-dir $i:振り幅 \
		-center 0 0 \
		-xran 360 \
		-yran $i:横視野角 \
		-i 4000 \
		-vc_radar 12000 9000 \
		-status $f:w01d_監視カメラ１破壊フラグ \
		-exec {
			eval($f:w01d_監視カメラ１破壊フラグ = 1)
			eval($b:w01d_破壊ロード回数[0] = $w:グローバルロード回数);
		}
}











//###################################################################################
//							危険モード時五階へ移動禁止セット
//###################################################################################

proc 危険モード時五階へ移動禁止セット {
	if($w:ゲーム設定 >= d:LEVEL_HARD){
		chara 透明壁 危険モード時五階へ移動禁止 \
		-position 1000,9000,-11400 2000 \
			      2000,9000,-11400 2000 \
		-attribute (d:HZX_SEG_NO_ENEMY | d:HZX_SEG_NO_BULLET | d:HZX_SEG_NO_MISSILE | \
					d:HZX_SEG_NO_C4 | d:HZX_SEG_NO_RECOIL | d:HZX_SEG_NO_HARITSUKI | \
					d:HZX_SEG_NO_DISP_RADAR | d:HZX_SEG_NO_BULLETHOLE | d:HZX_SEG_NO_SPRAY | \
					d:HZX_SEG_NO_ENEMY_EYES)
		mesg 透明壁 危険モード時五階へ移動禁止 off

#ifndef JAPANESE
		chara ブレットバリア 吹っ飛ばし \
			-mode 0 \
			-pos  1500,12000,-12550
#endif

		trap ev202 d:PLAYER \
			-mask ？ \
			-alert d:ALERT_MODE_ALERT \	//アラートモードになったら
			-exec {
				if ( $3 == 入る ){
							mesg ブレットバリア 吹っ飛ばし 領域に入る
							mesg 透明壁 危険モード時五階へ移動禁止 on
					} else {
							mesg ブレットバリア 吹っ飛ばし 領域を出る
							mesg 透明壁 危険モード時五階へ移動禁止 off
					}
				}

	}
}

proc 五階への階段敵兵吹っ飛ばしすぎ防止透明壁セット {
	chara 透明壁 敵兵過剰な吹っ飛ばし防止 \
	-position 1000,12000,-13200 2000 \
		      2000,12000,-13200 2000 \
	-attribute (d:HZX_SEG_NO_BULLET | d:HZX_SEG_NO_MISSILE | \
				d:HZX_SEG_NO_C4 | d:HZX_SEG_NO_RECOIL | d:HZX_SEG_NO_HARITSUKI | \
				d:HZX_SEG_NO_DISP_RADAR | d:HZX_SEG_NO_BULLETHOLE | d:HZX_SEG_NO_SPRAY | \
				d:HZX_SEG_NO_ENEMY_EYES)
	mesg 透明壁 敵兵過剰な吹っ飛ばし防止 off

	trap roka_minami d:PLAYER \
		-mask ？ \
		-exec {
			if($3 == 入る) {
				mesg 透明壁 敵兵過剰な吹っ飛ばし防止 on
			} else {
				mesg 透明壁 敵兵過剰な吹っ飛ばし防止 off
			}
		}
}
















