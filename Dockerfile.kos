# Dockerfile.kos — KallistiOS SH4 toolchain image for MGS2 Dreamcast port
#
# Build once (takes 30-60 min — downloads and compiles GCC 13.x for SH4):
#   docker build -f Dockerfile.kos -t mgs2-dreamcast-sdk .
#
# Then use via Makefile.dc:
#   make -f Makefile.dc docker-shell    # interactive shell with KOS env
#   make -f Makefile.dc docker-build    # compile all engine sources for SH4
#
# Why Ubuntu 22.04: host GCC 11 avoids the GCC 16 safe-ctype.h conflict
# that blocks building older cross-compilers on Fedora 44.

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Host tools needed to build the cross-compiler
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    texinfo \
    libgmp-dev \
    libmpfr-dev \
    libmpc-dev \
    wget \
    git \
    python3 \
    bison \
    flex \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# --- 1. Clone KallistiOS ---
# Pin to a specific commit for reproducibility; update intentionally.
ARG KOS_REF=master
RUN git clone --depth=1 --branch=${KOS_REF} \
    https://github.com/KallistiOS/KallistiOS.git /opt/kos

# --- 2. Build the SH4 cross-compiler via dc-chain ---
# dc-chain downloads GCC/binutils/newlib and installs to /opt/toolchains/dc.
# BUILD_ARM_TOOLCHAIN=0 skips the ARM7 (AICA sound chip) compiler — not
# needed until we tackle audio in a later phase.
WORKDIR /opt/kos/utils/dc-chain
ENV BUILD_ARM_TOOLCHAIN=0
RUN make -j$(nproc)

# --- 3. Set up environ.sh from the KOS-provided sample ---
# The sample has placeholder paths; patch them to match our install locations.
RUN cp /opt/kos/doc/environ.sh.sample /opt/kos/environ.sh && \
    python3 - <<'PYEOF'
import re

with open('/opt/kos/environ.sh') as f:
    txt = f.read()

replacements = {
    r'^export KOS_BASE=.*':  'export KOS_BASE=/opt/kos',
    r'^export KOS_PORTS=.*': 'export KOS_PORTS=/opt/kos-ports',
}
for pattern, repl in replacements.items():
    txt = re.sub(pattern, repl, txt, flags=re.MULTILINE)

with open('/opt/kos/environ.sh', 'w') as f:
    f.write(txt)
PYEOF

# --- 4. Build KallistiOS ---
WORKDIR /opt/kos
RUN bash -c "source /opt/kos/environ.sh && make -j$(nproc)"

# Make the cross-compiler available without sourcing environ.sh
ENV PATH=/opt/toolchains/dc/sh-elf/bin:${PATH}

WORKDIR /work
CMD ["bash"]
