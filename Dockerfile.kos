# Dockerfile.kos — KallistiOS SH4 toolchain image for MGS2 Dreamcast port
#
# Build once (takes 30-60 min — downloads and compiles GCC 13.x for SH4):
#   docker build -f Dockerfile.kos -t mgs2-dreamcast-sdk .
#
# Then use via Makefile.dc:
#   make -f Makefile.dc docker-shell    # interactive shell with KOS env
#   make -f Makefile.dc docker-build    # compile all engine sources for SH4
#
# Why Ubuntu 22.04: host GCC 11 avoids the GCC 16 safe-ctype.h conflict
# that blocks building cross-compilers on Fedora 44.

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Host tools needed to build the cross-compiler
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    texinfo \
    libgmp-dev \
    libmpfr-dev \
    libmpc-dev \
    libelf-dev \
    libjpeg-dev \
    libpng-dev \
    wget \
    curl \
    git \
    subversion \
    python3 \
    bison \
    flex \
    patch \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# --- 1. Clone KallistiOS to its standard install location ---
# kos-chain expects KOS at KOS_BASE; the sample environ.sh defaults to
# /opt/toolchains/dc/kos, so we clone there to avoid any path patching.
RUN mkdir -p /opt/toolchains/dc && \
    git clone --depth=1 \
        https://github.com/KallistiOS/KallistiOS.git \
        /opt/toolchains/dc/kos

# --- 2. Build the SH4 cross-compiler via kos-chain ---
# toolchain_profile=legacy = GCC 13.2.0 (previously "stable"; battle-tested).
# platform=dreamcast builds only the SH4 toolchain, not the ARM/AICA chain.
# Installs to /opt/toolchains/dc/sh-elf/ by default.
WORKDIR /opt/toolchains/dc/kos/utils/kos-chain
RUN make build platform=dreamcast toolchain_profile=legacy

# --- 3. Configure the KOS environment ---
# The sample already uses the correct paths for our layout, so copy as-is.
WORKDIR /opt/toolchains/dc/kos
RUN cp doc/environ.sh.sample environ.sh

# --- 4. Build KallistiOS library ---
RUN bash -c "source /opt/toolchains/dc/kos/environ.sh && make -j$(nproc)"

# --- 5. Build host disc-creation utilities (scramble, makeip) ---
# These are pure host-side C tools; no KOS env needed to compile them.
RUN apt-get update && apt-get install -y --no-install-recommends \
    genisoimage \
    && rm -rf /var/lib/apt/lists/*

RUN make -C /opt/toolchains/dc/kos/utils/scramble \
    && cp /opt/toolchains/dc/kos/utils/scramble/scramble /usr/local/bin/

RUN make -C /opt/toolchains/dc/kos/utils/makeip \
    && cp /opt/toolchains/dc/kos/utils/makeip/makeip /usr/local/bin/

# Make the cross-compiler available without sourcing environ.sh
ENV PATH=/opt/toolchains/dc/sh-elf/bin:${PATH}

WORKDIR /work
CMD ["bash"]
