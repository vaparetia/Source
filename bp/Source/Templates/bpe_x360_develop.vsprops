<?xml version="1.0" encoding="Windows-1252"?>
<VisualStudioPropertySheet
	ProjectType="Visual C++"
	Version="8.00"
	Name="BPE X360 Develop"
	InheritedPropertySheets=".\bpe_x360.vsprops"
	>
   <Tool
		Name="VCCLCompilerTool"
		Optimization="3"
		InlineFunctionExpansion="1"
		PreprocessorDefinitions="PROFILE;NDEBUG"
		RuntimeLibrary="0"
		DebugInformationFormat="4"
	/>
   <Tool
		Name="VCCLX360CompilerTool"
		Optimization="3"
		InlineFunctionExpansion="1"
		PreprocessorDefinitions="PROFILE;NDEBUG"
		RuntimeLibrary="0"
		DebugInformationFormat="4"
	/>
   <Tool
		Name="VCLinkerTool"
		AdditionalDependencies="d3d9i.lib d3dx9i.lib xapilibi.lib xgraphics.lib tracerecording.lib xonline.lib xparty.lib xnet.lib xmp.lib xhv2.lib x3daudio.lib xact3i.lib xaudio2.lib Xmcorei.lib xmedia2.lib xmahal.lib xboxkrnl.lib xbdm.lib"
		IgnoreDefaultLibraryNames="xapilib.lib"
      GenerateDebugInformation="true"
	/>
   <Tool
		Name="VCX360LinkerTool"
		AdditionalDependencies="d3d9i.lib d3dx9i.lib xapilibi.lib xgraphics.lib tracerecording.lib xonline.lib xparty.lib xnet.lib xmp.lib xhv2.lib x3daudio.lib xact3i.lib xaudio2.lib Xmcorei.lib xmedia2.lib xmahal.lib xboxkrnl.lib xbdm.lib"
		IgnoreDefaultLibraryNames="xapilib.lib"
      GenerateDebugInformation="true"
	/>
</VisualStudioPropertySheet>
