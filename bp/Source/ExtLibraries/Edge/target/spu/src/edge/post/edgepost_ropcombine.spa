//--------------------------------------------------------------------------------------------------
//  FUNCTION DEFINITION
//--------------------------------------------------------------------------------------------------

//--------------------------------------------------------------------------------------------------
/**

	void edgePostCombine( void* output, void* input0, void* input1, qword shuffle0, qword shuffle1, uint32_t count );
	
**/
//--------------------------------------------------------------------------------------------------


.include "edgepost_helpers.inc"


.cfunc void edgePostCombine( qword output, qword input0, qword input1, qword shuffleMask, qword count )
	
loop:
	ai		output, output, 0x10
	ai		input0, input0, 0x10
	ai		input1, input1, 0x10
	ai		count, count, -4
	
	// Load pixels
	.reg	s0, s1
	lqd		s0, -0x10( input0 )
	lqd		s1, -0x10( input1 )
	
	// Shuffle
	.reg	r
	shufb	r, s0, s1, shuffleMask
	
	// Store
	stqd	r, -0x10( output )
	brnz	count, loop
.endfunc

