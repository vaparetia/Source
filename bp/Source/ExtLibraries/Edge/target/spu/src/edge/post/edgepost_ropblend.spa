//--------------------------------------------------------------------------------------------------
//  FUNCTION DEFINITION
//--------------------------------------------------------------------------------------------------

//--------------------------------------------------------------------------------------------------
/**
	// output = input0 * input1
	void edgePostBlend8( void* output, void* input0, void* input1, vec_uint4 multiplier, uint32_t count );
**/
//--------------------------------------------------------------------------------------------------


.include "edgepost_helpers.inc"

//	r = p0 * ( 1 - p1.a ) + p1
.macro EDGEPOST_BLEND( r, p0, p1 )
	
	// Expand b's alpha and take the complement
	.localreg	a0
	shufb		a0, p1, p1, kReplicateAlpha
	sf			a0, a0, kEdgePostMaxPixel
	
	// Multiply p0 by 1-alpha and normalise
	// Hacky. Add one so that multiplying by full (255) alpha shifts left eight bits
	ai			a0, a0, 1
	mpyu		r, p0, a0
	rotmi		r, r, -8
	
	// Then add p1 and saturate
	a			r, r, p1
	EDGEPOST_CLAMP_PIXEL8( r )
.endmacro

//	r = p0 * ( 1 - p1.a ) + p1
.macro EDGEPOST_BLENDF( r, p0, p1 )
	
	// Expand b's alpha and take the complement
	.localreg	a0
	shufb		a0, p1, p1, kReplicateAlpha
	EDGEPOST_CLAMP_FLOAT( a0 )
	fs			a0, kEdgePostFloatOne, a0
	
	// blend
	fma			r, p0, a0, p1
.endmacro

.cfunc void edgePostBlend8( qword output, qword input0, qword input1, qword count )
	EDGEPOST_DECLARE_HELPER_CONSTANTS
	
	.reg		kReplicateAlpha
	il128		kReplicateAlpha, "AAAA"
	
loop:
	ai			output, output, 0x10
	ai			input0, input0, 0x10
	ai			input1, input1, 0x10
	ai			count, count, -4
	
	// Load pixels
	.reg		s0, s1
	lqd			s0, -0x10( input0 )
	lqd			s1, -0x10( input1 )
	
	// Unpack
	.reg		p00, p01, p02, p03
	.reg		p10, p11, p12, p13
	EDGEPOST_UNPACK_PIXELS8( p00, p01, p02, p03, s0 )
	EDGEPOST_UNPACK_PIXELS8( p10, p11, p12, p13, s1 )
	
	.reg		r0, r1, r2, r3
	EDGEPOST_BLEND( r0, p00, p10 )
	EDGEPOST_BLEND( r1, p01, p11 )
	EDGEPOST_BLEND( r2, p02, p12 )
	EDGEPOST_BLEND( r3, p03, p13 )
	
	.reg		r
	EDGEPOST_PACK_PIXELS8( r, r0, r1, r2, r3)
	
	stqd		r, -0x10( output )
	brnz		count, loop
.endfunc


.cfunc void edgePostBlendFX16( qword output, qword input0, qword input1, qword count )
	EDGEPOST_DECLARE_HELPER_CONSTANTS
	
	.reg		kReplicateAlpha
	il128		kReplicateAlpha, "AAAA"
	
loop:
	ai			output, output, 0x20
	ai			input0, input0, 0x20
	ai			input1, input1, 0x20
	ai			count, count, -4
	
	// Load pixels
	.reg		s0, s1, s2, s3
	lqd			s0, -0x20( input0 )
	lqd			s1, -0x10( input0 )
	lqd			s2, -0x20( input1 )
	lqd			s3, -0x10( input1 )
	
	// Unpack
	.reg		p00, p01, p02, p03
	.reg		p10, p11, p12, p13
	EDGEPOST_UNPACK_PIXELS16( p00, p01, s0 )
	EDGEPOST_UNPACK_PIXELS16( p02, p03, s1 )
	EDGEPOST_UNPACK_PIXELS16( p10, p11, s2 )
	EDGEPOST_UNPACK_PIXELS16( p12, p13, s3 )

	// convert to float
	cuflt		p00, p00, 11
	cuflt		p01, p01, 11
	cuflt		p02, p02, 11
	cuflt		p03, p03, 11
	cuflt		p10, p10, 11
	cuflt		p11, p11, 11
	cuflt		p12, p12, 11
	cuflt		p13, p13, 11
	
	.reg		r0, r1, r2, r3
	EDGEPOST_BLENDF( r0, p00, p10 )
	EDGEPOST_BLENDF( r1, p01, p11 )
	EDGEPOST_BLENDF( r2, p02, p12 )
	EDGEPOST_BLENDF( r3, p03, p13 )
	
	// back to fixed
	cfltu		r0, r0, 11
	cfltu		r1, r1, 11
	cfltu		r2, r2, 11
	cfltu		r3, r3, 11
	
	.reg		p0, p1
	EDGEPOST_PACK_PIXELS16( p0, r0, r1)
	EDGEPOST_PACK_PIXELS16( p1, r2, r3)
	
	stqd		p0, -0x20( output )
	stqd		p1, -0x10( output )
	brnz		count, loop
.endfunc

.cfunc void edgePostPremultiplyFX16( qword output, qword input0, qword count )
	EDGEPOST_DECLARE_HELPER_CONSTANTS
	
	.reg		kReplicateAlpha, kInsertAlpha
	il128		kReplicateAlpha, "AAAA"
	il128		kInsertAlpha, "aBCD"
	
loop:
	ai			output, output, 0x20
	ai			input0, input0, 0x20
	ai			count, count, -4
	
	// Load pixels
	.reg		s0, s1
	lqd			s0, -0x20( input0 )
	lqd			s1, -0x10( input0 )
	
	// Unpack
	.reg		p00, p01, p02, p03
	EDGEPOST_UNPACK_PIXELS16( p00, p01, s0 )
	EDGEPOST_UNPACK_PIXELS16( p02, p03, s1 )

	// convert to float
	cuflt		p00, p00, 11
	cuflt		p01, p01, 11
	cuflt		p02, p02, 11
	cuflt		p03, p03, 11
	
	.reg		r0, r1, r2, r3
	shufb		r0, p00, p00, kReplicateAlpha
	shufb		r1, p01, p01, kReplicateAlpha
	shufb		r2, p02, p02, kReplicateAlpha
	shufb		r3, p03, p03, kReplicateAlpha
	fm			r0, r0, p00
	fm			r1, r1, p01
	fm			r2, r2, p02
	fm			r3, r3, p03
	shufb		r0, r0, p00, kInsertAlpha
	shufb		r1, r1, p01, kInsertAlpha
	shufb		r2, r2, p02, kInsertAlpha
	shufb		r3, r3, p03, kInsertAlpha
	
	// back to fixed
	cfltu		r0, r0, 11
	cfltu		r1, r1, 11
	cfltu		r2, r2, 11
	cfltu		r3, r3, 11
	
	.reg		p0, p1
	EDGEPOST_PACK_PIXELS16( p0, r0, r1)
	EDGEPOST_PACK_PIXELS16( p1, r2, r3)
	
	stqd		p0, -0x20( output )
	stqd		p1, -0x10( output )
	brnz		count, loop
.endfunc
