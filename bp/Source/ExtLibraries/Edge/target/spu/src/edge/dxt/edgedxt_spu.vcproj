			/>
			<Tool
				Name="VCCLCompilerTool"
				AdditionalOptions="-g -Wall -fno-exceptions -fno-rtti -fpic -ffunction-sections -fdata-sections -fstack-check"
				AdditionalIncludeDirectories="&quot;$(SN_PS3_PATH)\spu\include\sn&quot;;&quot;$(SCE_PS3_ROOT)\target\spu\include&quot;;&quot;$(SCE_PS3_ROOT)\target\common\include&quot;"
				PreprocessorDefinitions="SN_TARGET_PS3_SPU;_DEBUG;__GCC__;SPU;__CELL_ASSERT__"
